 4569:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4570: 
 4571:       SIDE(side);
 4572: 
 4573: 
 4574:       side->U = {0.0, 0.0}; 
 4575:          
 4576:       if(side->isDry) return;
 4577: 
 4578:       const Node *node1 = side->n1;
 4579:       const Node *node2 = side->n2;
 4580: 
 4581:       // Vertically integrated velocity U (in ll if ics=2)
 4582:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4583:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4584:       }
 4585: 
 4586:    }
 4587: 
 4588:    __global__ void computeBottomDragVegetation(void) {
 4589:       // UNFINISHED. CHECK THIS:
 4590:       // How many kernels are needed? Why so many for loops?
 4591:       // Is the loop on sides needed?
 4592: 
 4593:       NODE(node);
 4594: 
 4595: 
 4596:       const int    kb      = node->kb;
 4597:       const double htot    = node->htot2(); 
 4598:       const double rough   = node->rough;
 4599: 
 4600:       
 4601:       if (node->isDry) {
 4602:          // Default values for dry nodes
 4603:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4604:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4605: 
 4606:          return;
 4607:        
 4608:       }
 4609: 
 4610:       // Compute bottom drag Cd
 4611:       //--------------------------------
 4612: 
 4613:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4614:       if constexpr(nchi == 1) {
 4615: 
 4616:          bool ltmp = false; // for WBL iteration
 4617: 
 4618:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4619:          // Drag at nodes
 4620:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4621:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4622:         
 4623:          const double rough = node->rough;
 4624:         
 4625:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4626:          if (node->rough == 0.0) {
 4627:             node->Cd = 0.0;
 4628: 
 4629:          } else { //roughness >0 
 4630:           
 4631:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4632:             const double bthick = max(dzb_min, bthick_ori);
 4633: 
 4634:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4635: 
 4636:             double tmp = 1.0/(2.5*log(bthick/rough));
 4637:             node->Cd = tmp*tmp;
 4638: 
 4639:          } // if rough
 4640: 
 4641: 
 4642:          // RECOVER THIS: XXX
 4643:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4644:          // Output warning for WBL if iteration didn't converge
 4645: 
 4646: 
 4647:       } // nchi==1
 4648: 
 4649: 
 4650:       //   Bottom stress in m^2/s^2
 4651:       if (node->rho[kb + 1] >= -98.0)
 4652:       {
 4653:          const double mag_u = length(node->u2[kb + 1]);
 4654:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4655: 
 4656:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4657:          // !sediment erosion: this part needs more documentation
 4658:       }
 4659:     
 4660: 
 4661: 
 4662:       // Compute vegetation parameters
 4663:       //--------------------------------
 4664: 
 4665:       // SAV constants
 4666:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4667:       constexpr double veg_cfpsi = 0.16;
 4668: 
 4669:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4670:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4671: 
 4672:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4673:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4674:          int kbin = 0; // bin index
 4675:          for (int k = kb; k < nvrt; k++) {
 4676:             // Computes node height above the bottom level
 4677:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4678:             assert(false && "Vertical variation of vegetation not implemented");
 4679: 
 4680:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4681:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4682:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4683:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4684:             // } else {
 4685:             //    // Find the bin at which the current vertical level is
 4686:             //    while (kbin<nbins_veg_vert) {
 4687:             //       const double zn = node->z[kbin];
 4688:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4689:             //          break;
 4690:             //       } // if
 4691:             //       kbin++;
 4692:             //    } // while
 4693:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4694: 
 4695:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4696:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4697:                
 4698:             //    // Linear interpolation of the vegetation parameters
 4699:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4700:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4701:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4702:             // } // if rl10
 4703: 
 4704:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4705: 
 4706:          } // for k
 4707: 
 4708: 
 4709:       } else { // Ganthy (iveg==2)
 4710:       //  Modify canopy height, diameter, and density
 4711: 
 4712:          // Make sure there is vegetation on this node
 4713:          if (node->veg_h_unbent > 0.0) {
 4714:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4715: 
 4716:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4717:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4718:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4719: 
 4720:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4721:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4722:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4723:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4724:          } // if veg_h_unbent
 4725: 
 4726:          for (int k = 0; k < nvrt; k++) {
 4727:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4728:          } // for k
 4729:       
 4730: 
 4731:       } // if iveg
 4732:      
 4733: 
 4734:       // Compute vertical mean of veg_alpha3D
 4735:       if (iveg != 0) {
 4736:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4737:          double sum1=0.0;
 4738:          double sum2=0.0;
 4739:          // Integrate over each level under the canopy...
 4740:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4741:             const double Dz = node->Dz(k);
 4742: 
 4743:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4744:             sum2 += Dz;
 4745: 
 4746:          } // for k
 4747:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4748:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4749: 
 4750:       } // if iveg
 4751: 
 4752:    }
 4753: 
 4754:    __global__ void computeVegetationAndDragParameters(void) {
 4755:       // Computes the vegetation and drag model parameters:
 4756:       // chi, \tilde\chi, beta, \breve{H}
 4757:       
 4758:       SIDE(side);
 4759: 
 4760:       if (side->isDry) return;
 4761: 
 4762:       const double htot = side->htot2();
 4763:       const int    kb   = side->kb;
 4764: 
 4765:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4766: 
 4767:       const double veg_h     = side->veg_h();
 4768:       const double veg_nv    = side->veg_nv();
 4769:       const double veg_c     = side->veg_c();
 4770:       const double veg_beta  = side->veg_beta;
 4771:       const double veg_alpha = side->veg_alpha_vert_mean();
 4772: 
 4773:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4774:       // Velocity magnitude at the bottom level
 4775:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4776:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4777:       side->chi2 = side->Cd()*vmag1;
 4778:       side->chi  = side->chi2;
 4779:       if constexpr(iveg != 0) {
 4780:          const Node *n1 = side->n1;
 4781:          const Node *n2 = side->n2;
 4782:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4783:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4784:       }
 4785: 
 4786:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4787: 
 4788:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4789:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4790:       double magUa = 0.0;
 4791:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4792:          // 3D wet side with veg...
 4793: 
 4794:          double magUa = 0.0;
 4795:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4796:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4797: 
 4798:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4799:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4800:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4801: 
 4802:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4803:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4804: 
 4805:                // Velocity magnitude at the bottom (l) of the level
 4806:                const double ul = length(side->u2[k]);
 4807: 
 4808:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4809:                magUa += Dz*0.5*(uh + ul);
 4810: 
 4811:             } // if HasVegetation
 4812:          } // for k
 4813:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4814: 
 4815:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4816:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4817:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4818:             const double zCpy = side->zTopCanopy();
 4819:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4820:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4821:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4822:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4823:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4824:          } // if isSubmerged
 4825:       } // if iveg   
 4826: 
 4827:       // Computes the friction modified depth, \breve{H} in notes
 4828:       if (side->is2D()) { // 2D
 4829: 
 4830:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4831:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4832: 
 4833:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4834: 
 4835:          side->hhat = htot*htot/fricH; 
 4836: 
 4837:       } else { // 3D
 4838:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4839: 
 4840:          if constexpr(iveg != 0) {
 4841:             
 4842:             if (side->isSubmerged()) { 
 4843:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4844:                side->hhat -= veg_c*Hhat_alpha;
 4845: 
 4846:             } else { // Emergent
 4847:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4848:             }
 4849:          } // if iveg
 4850: 
 4851:          // Enforce positivity for 3D model
 4852:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4853:       } // if 3D
 4854: 
 4855:    }
 4856: 
 4857: 
 4858: 
 4859:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4860:    // Computes the density gradient between two elements, e1 and e2.
 4861:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4862:    // zero in the direction normal to the side. 
 4863:    // 
 4864:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4865:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4866:    //
 4867:    // Input:
 4868:    //    e1: Element
 4869:    //    e2: Neighbor element (or nullptr if boundary)
 4870:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4871:    //    k: Index of the half-level at which the density is interpolated
 4872:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4873:    // 
 4874:    // Output:
 4875:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4876:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4877: 
 4878:       if (e2 == nullptr || e2->isDry) {
 4879:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4880: 
 4881:          Side *side = e1->sides[j];
 4882:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4883:                  
 4884:          if constexpr(ics == 1) {
 4885:             vec = side->n; // Normal vector to the side
 4886:          } else {
 4887:             // IMPLEMENT THIS XXXXXX
 4888:             // !replace with xel, yel?
 4889:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4890:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4891:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4892:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4893:          } //ics
 4894:                    
 4895:          diffRho = 0.0;
 4896: 
 4897:       } else { //internal and wet
 4898:          if constexpr(ics==1) {
 4899:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4900: 
 4901:             // Vector from e1 to e2
 4902:             vec = e2->center - e1->center;
 4903: 
 4904:          } else { 
 4905:             // IMPLEMENT THIS XXXXXX
 4906:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4907:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4908:             //                   alow(j)=xctr2
 4909:             //                   bdia(j)=yctr2
 4910:          } // ics
 4911: 
 4912:          diffRho = rho2 - e1->demeanedDensity(k);
 4913:       }
 4914: 
 4915:    }
 4916: 
 4917:    __global__ void computeDensityCubicSplines(void) {
 4918:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4919: 
 4920:       ELEM(elem);
 4921: 
 4922:       if (elem->isDry) return;
 4923: 
 4924:       const int kb = elem->kb;
 4925: 
 4926:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4927:       if (elem->is2D()) {
 4928:          // In the 2D case, the density is constant at the prism level. 
 4929:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4930:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4931:       } else { //3D
 4932: 
 4933:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4934:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4935:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4936:          ///// XXXX CHECK INDICES!!!!!
 4937:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4938:       } // 2D/3D
 4939: 
 4940:    }
 4941: } // extern "C"
 4942: 
 4943: 
 4944: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4945: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4946: 
 4947:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4948: 
 4949:    const int kb  = elem->kb;
 4950:    const int kb2 = elem2->kb;
 4951: 
 4952:    // z-coordinate of prism of elem
 4953:    const double zp = elem->z_prism(k);
 4954: 
 4955:    double rho = 0.0;
 4956: 
 4957:    if (elem2->is2D()) {
 4958:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4959: 
 4960:    } else {  // 3D
 4961: 
 4962:       // eta_min may be < zmax
 4963:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4964:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4965: 
 4966:       // (Extrapolate density below bottom, we will fix it later)
 4967:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4968:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4969:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4970:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4971:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4972:    } // 2D/3D
 4973:      
 4974: 
 4975:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4976:    // Now we need to fix it.
 4977:    if (elem->z[k] < elem2->z[kb2]) {
 4978:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4979: 
 4980:       // There are two methods to adjust the density at the bottom of the element.
 4981:       // iunder_deep=0: 
 4982:       const double depth1 = abs(elem->z[kb]); // larger depth
 4983: 
 4984:       if (iunder_deep==0) {
 4985: 
 4986:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4987: 
 4988:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4989: 
 4990:       } else { // iunder_deep != 0
 4991: 
 4992:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4993: 
 4994:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4995: 
 4996:          //   Demeaned density at the same z coordinate as
 4997:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4998:          }
 4999: 
 5000:       } // if iunder_deep
 5001:    } // if elem->z[kb] < elem2->z[kb]
 5002: 
 5003:    return rho;
 5004: }
 5005: 
 5006: 
 5007: extern "C" {
 5008:    __global__ void computeDensityGradient(void) {
 5009: 
 5010:       if constexpr(ibc != 0) return;
 5011: 
 5012:          // Compute the horizontal density gradient at each element.
 5013:       // It works in two steps:
 5014:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5015:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5016:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5017:       //             gradRho.r1 = rho1 - rho0
 5018:       //             gradRho.r2 = rho2 - rho0
 5019:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5020:       // 
 5021:       //  NOTE: We use de-meaned densities.
 5022: 
 5023:       ELEM(elem);
 5024: 
 5025:       if (elem->isDry) return;
 5026: 
 5027:       const int kb  = elem->kb;
 5028:       const int i34 = elem->i34;
 5029: 
 5030:       for (int k = kb + 1; k < nvrt; k++) {
 5031:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5032:          //             gradRho.r1 = rho1 - rho0
 5033:          //             gradRho.r2 = rho2 - rho0
 5034:          int icount = 0;
 5035:          double sumRx = 0.0;
 5036:          double sumRy = 0.0;
 5037:          for (int j1=0; j1<i34; j1++) { 
 5038: 
 5039:             const int j2 = elem->nxq(j1 + 1);
 5040: 
 5041:             // Pairs of consecutive neighbor elements of elem
 5042:             const Element *e1 = elem->nghbElems[j1];
 5043:             const Element *e2 = elem->nghbElems[j2];
 5044: 
 5045:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5046:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5047:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5048: 
 5049:             // Compute the density difference and the vector from elem to e1 and e2
 5050:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5051:             double diffRho1, diffRho2;
 5052:             Vector2 vec1, vec2;
 5053:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5054:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5055: 
 5056:             const double rl1 = length(vec1);
 5057:             const double rl2 = length(vec2);
 5058:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5059: 
 5060:             const double delta = cross(vec1, vec2);
 5061:             const double sintheta = abs(delta)/(rl1*rl2);
 5062: 
 5063:             // To avoid problems, avoid elements with small angle between vectors
 5064:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5065:             const bool validEq = (sintheta > sin_one_deg);
 5066: 
 5067:             if (validEq) {
 5068:                // Solve the system of equations to get the density gradient at elem
 5069:                icount++;
 5070:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5071:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5072:                sumRx += Rx;
 5073:                sumRy += Ry;
 5074:             }
 5075:          } // for j1
 5076: 
 5077:          // Compute the average density gradient at elem
 5078:          if (icount==0) {
 5079:            // Bad mesh quality; bail out with 0 b-cc
 5080:            elem->gradRho[k] = {0.0, 0.0};
 5081:          } else {
 5082:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5083:          }
 5084: 
 5085:       } // for k
 5086: 
 5087:    }
 5088: 
 5089:    __global__ void computeBaroclinicTerm(void) {
 5090:    // Computes the baroclinic term at sides (at half levels).
 5091:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5092:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5093: 
 5094:       if (ibc == 1) return;
 5095: 
 5096:       SIDE(side);
 5097: 
 5098:       if (side->isDry) return;
 5099: 
 5100:       const Element *e1 = side->elems[0];
 5101:       const Element *e2 = side->elems[1];      
 5102:       const int kb = side->kb;
 5103:       
 5104:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5105: 
 5106:       // interpolates vertically the density gradient of the two elements at the half level/
 5107: 
 5108:       int k1 = max(kb, nvrt / 2);
 5109:       int k2 = max(kb, nvrt / 2);
 5110: 
 5111:       // Starts the integration at the surface and goes down to the bottom
 5112:       side->bcc[nvrt-1] = {0.0, 0.0};
 5113:       for (int k = nvrt - 2; k >= kb; k--) {
 5114:       // For each prism level (from surface to bottom)...
 5115: 
 5116:          // For both elements, interpolate density gradient at the side's half level.
 5117:          // The gradient at the side is the average of the gradients at the elements.
 5118:          // w1, w2 are used to take into account boundary sides, with just one element.
 5119:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5120:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5121:          const double wsum = w1 + w2;
 5122:          w1 = w1/wsum;
 5123:          w2 = w2/wsum;
 5124:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5125: 
 5126:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5127:          Vector2 gradRho = {0.0, 0.0};
 5128:          if (e1 != nullptr && k > kb) {
 5129:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5130:             
 5131:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5132:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5133:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5134: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5135:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5136:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5137:          }      
 5138:          if (e2 != nullptr && k > kb) {
 5139:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5140:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5141:             
 5142:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5143:          }
 5144: 
 5145:          if constexpr(ics==2) {
 5146:             assert(false && "Not implemented: ics == 2");
 5147:             // IMPLEMENT THIS XXXXXX
 5148:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5149:             // swild(1)=tmp1
 5150:             // swild(2)=tmp2
 5151:          }
 5152:          
 5153:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5154:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5155:          // CHECK INDICES!!! XXX
 5156:          const double grav3 = side->grav3();
 5157:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5158: 
 5159:       } // for
 5160: 
 5161:    }
 5162: 
 5163: 
 5164: 
 5165:    __global__ void computeHorGradientAtSide(void) {
 5166: 
 5167:       // Compute the horizontal density gradient at each element.
 5168:       // It works in two steps:
 5169:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5170:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5171:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5172:       //             gradRho.r1 = rho1 - rho0
 5173:       //             gradRho.r2 = rho2 - rho0
 5174:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5175:       // 
 5176:       //  NOTE: We use de-meaned densities.
 5177: 
 5178:       SIDE(side);
 5179: 
 5180: // printf("side->isDry: %d\n", side->isDry);
 5181:       if (side->isDry) return;
 5182: 
 5183:       // Computes the gradient of the variables at the side center.
 5184:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5185:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5186:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5187: 
 5188:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5189:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5190:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5191:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5192: 
 5193: 
 5194:    }
 5195: 
 5196: 
 5197:    __global__ void solveMomentumEquations(double time) {
 5198: 
 5199:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5200:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5201: 
 5202:       SIDE(side);
 5203: 
 5204:       if (side->isDry) 
 5205:       {
 5206:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5207: 
 5208:          return;
 5209:       }
 5210: 
 5211:       const Node *n1 = side->n1;
 5212:       const Node *n2 = side->n2;
 5213: 
 5214:       const int kb = side->kb;
 5215: 
 5216:       const double veg_h = side->veg_h();
 5217:       const double grav3 = side->grav3();
 5218: 
 5219:       if (side->is2D()) {
 5220:          // Warning: Do not use htot2, which is updated.
 5221:          const double htot = side->htot1();
 5222:          const double hhat = side->hhat;
 5223: 
 5224:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5225: 
 5226:          Vector2 tau2 = {0.0, 0.0};
 5227:           
 5228:          if constexpr(ics==1) {
 5229:             tau2 = side->tau();
 5230: 
 5231:          } else {
 5232:             assert(false && "Not implemented: ics == 2");
 5233:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5234:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5235:             // taux2=(vn1+tt1)*0.5d0
 5236:             // tauy2=(vn2+ss1)*0.5d0
 5237:          } // if ics         
 5238: 
 5239:          // hat_gam has units of m/s
 5240: 
 5241:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5242: 
 5243:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5244:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5245: 
 5246:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5247: 
 5248: 
 5249:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5250:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5251: 
 5252:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5253: 
 5254:       }
 5255:       else { // 3D
 5256: 
 5257:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5258:          // 
 5259:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5260:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5261:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5262:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5263:          // k+1 and k.
 5264: 
 5265: 
 5266:          const int ndim = nvrt - kb;
 5267:          const double zTopCanopy = side->zTopCanopy();
 5268: 
 5269:          // Initialize the tridiagonal system
 5270:          for (int k = kb + 1; k < nvrt; k++) {
 5271:             
 5272:             const int kin = k - (kb + 1);
 5273: 
 5274:             // Vertical viscosity at the face center
 5275:             const double dfz = 1e-2; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5276:  
 5277:             alow[kin] = 0.0;
 5278:             cupp[kin] = 0.0;
 5279:             bdia[kin] = 0.0;
 5280: 
 5281:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5282:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5283: 
 5284:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5285:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5286:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5287: 
 5288:             // First part: layers k, k+1
 5289:             if (k < nvrt - 1) {
 5290:                              
 5291:                if constexpr(iveg != 0) {
 5292: 
 5293:                   // If there is vegetation at this level...
 5294:                   if (zTopCanopy > side->zc[k]) {
 5295:                      // If the canopy is above the k layer...
 5296:                      
 5297:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5298:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5299:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5300:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5301: 
 5302:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5303:                      const double vmag2 = length(ut2);
 5304:                      const double vmag1 = length(side->u2[k]);
 5305:                      const double vmag = 0.5*(vmag1 + vmag2);
 5306:                      
 5307:                      // Computes the vegetation alpha at the face center
 5308:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5309: 
 5310:                      cff1 += veg_alpha_sd*dt*vmag;
 5311: 
 5312:                   } // if (zTopCanopy
 5313:                } // if iveg
 5314: 
 5315:                const double dzz = side->Dz(k + 1);
 5316:                const double tmp = dt*dfz/dzz;
 5317:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5318: 
 5319:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5320:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5321:             }
 5322: 
 5323: 
 5324:             // Second part: layers k-1, k
 5325:             if (k > kb + 1) {
 5326: 
 5327:                double cff1 = 1.0; //init \bar{c^k}
 5328: 
 5329:                if constexpr(iveg != 0) {
 5330:                   // If there is vegetation at this level...
 5331:                   if (zTopCanopy > side->zc[k-1]) {
 5332:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5333:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5334: 
 5335:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5336: 
 5337:                      const double vmag2 = length(ut2);
 5338:                      const double vmag1 = length(side->u2[k-1]);
 5339:                      const double vmag = 0.5*(vmag1 + vmag2);
 5340: 
 5341:                      // Computes the vegetation alpha at the face center
 5342:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5343:                      cff1 += veg_alpha_sd*dt*vmag;
 5344:                   } // if zTopCanopy
 5345: 
 5346:                } // if iveg
 5347: 
 5348:                const double dzz = side->Dz(k);
 5349:                const double tmp = dt*dfz/dzz;
 5350:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5351: 
 5352:                alow[kin] += cff1*dzz/6.0 - tmp;
 5353:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5354: 
 5355:             } else { // Bottom boundary
 5356:                // This occurs at the bottom, where the bottom drag is applied.
 5357: 
 5358:                bdia[kin] += dt*side->chi2; // XXXX
 5359: 
 5360:             } // if (k > kb + 1)
 5361: 
 5362: 
 5363:          } // for (int k
 5364: 
 5365: 
 5366: 
 5367:          // Computes the RHS.
 5368:          // -----------------
 5369: 
 5370:          //	BC to be imposed at the end.
 5371: 
 5372:          const Vector2 gradETP  = side->gradETP;
 5373:          const Vector2 gradPr   = side->gradPr;
 5374:          const Vector2 gradEta1 = side->gradEta1;
 5375:          const Vector2 gradEta2 = side->gradEta2;
 5376: 
 5377:          const Vector2 *btu = side->btu;
 5378:          const Vector2 *u2  = side->u2;
 5379:          const double coriolis = side->coriolis;
 5380:          const Vector2 *nuGradU = side->nuGradU;
 5381: 
 5382: 
 5383:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5384: 
 5385:          for (int k = kb + 1; k < nvrt; k++) {
 5386:             const int kin = k - kb - 1;
 5387: 
 5388:             const double dz_0 = side->Dz(k);
 5389:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5390: 
 5391:             rrhs[kin] = {0.0, 0.0};
 5392:             double dz = 0.0;
 5393: 
 5394:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5395:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5396:             if (k < nvrt  ) dz += dz_1;
 5397:             if (k > kb + 1) dz += dz_0;
 5398: 
 5399:             // Elevation gradient, atmospheric pressure and tidal potential
 5400:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5401: 
 5402:             // Coriolis, advection, wind stress, and horizontal viscosity
 5403:             if (k < nvrt - 1) {
 5404: 
 5405: 
 5406:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5407:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5408:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5409:                                                 
 5410: 
 5411:                //diff stress tensors 1006
 5412:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5413:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5414:                   assert(false && "Not implemented: itur == 5");
 5415:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5416:                }
 5417: 
 5418:             } else { // k == nvrt - 1 SURFACE
 5419:                Vector2 tau2 = {0.0, 0.0};
 5420:                if constexpr(ics==1) {
 5421:                   tau2 = side->tau();
 5422:       
 5423:                } else {
 5424:                   assert(false && "Not implemented: ics == 2");
 5425:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5426:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5427:                   // taux2=(vn1+tt1)*0.5d0
 5428:                   // tauy2=(vn2+ss1)*0.5d0
 5429:                } // if ics
 5430: 
 5431:                rrhs[kin] += dt*tau2;
 5432: 
 5433:             } // if k<nvrt
 5434: 
 5435:             if (k > kb + 1) {
 5436:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5437:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5438:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5439: 
 5440:                // diff stress tensors 1006
 5441:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5442:                   assert(false && "Not implemented: itur == 5");
 5443:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5444:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5445:                }
 5446: 
 5447:             } // if k>kbs + 1
 5448: 
 5449:             // Baroclinic
 5450:             Vector2 *bcc = side->bcc;
 5451:             if constexpr(ibc == 0) {
 5452:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5453:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5454: 
 5455:             } // if ibc==0
 5456: 
 5457:          } // k=kb + 1,nvrt
 5458: 
 5459: 
 5460:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5461: 
 5462:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5463:             const int kin = k - kb - 1;
 5464: 
 5465:             // Velocity is always clamped to maximum values
 5466:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5467:          } // k
 5468: 
 5469:       } // if side->is2D()
 5470:       
 5471: 
 5472:       // Impose velocity boundary condition at the bottom
 5473:       if constexpr(imm == 2) { // 3D bed deformation model
 5474:          double dep;
 5475:          Vector2 vel;
 5476: 
 5477:          assert(false && "Not implemented: imm == 2");
 5478:          //update_bdef(time, x0, y0, dep, vel);
 5479:          // side->u2[kb] = vel;
 5480: 
 5481:       } else { // imm = 0 or 1
 5482:          if (side->Cd() == 0.0) {
 5483:             side->u2[kb] = side->u2[kb + 1];
 5484: 
 5485:          } else if (side->is3D()) { // 3D no slip bottom   
 5486:             side->u2[kb] = {0.0, 0.0};
 5487:          }
 5488:           
 5489:       } // if imm
 5490: 
 5491:       // The velocities below the bottom level are set to zero
 5492:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5493: 
 5494: 
 5495:    }
 5496: 
 5497: 
 5498:    __global__ void applyMomentumBC(void) {
 5499: 
 5500:       SIDE_BND(sideBnd);
 5501: 
 5502:       Side *side = sideBnd->side;
 5503:       const BoundarySegment *segment = sideBnd->segment;
 5504:       const Node *n1 = side->n1;
 5505:       const Node *n2 = side->n2;
 5506: 
 5507:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5508: 
 5509:       const bool isLand = segment->isLand;
 5510:       const int ifltype = segment->ifltype;
 5511: 
 5512:       const int kb = side->kb;
 5513: 
 5514:       if (!isLand && ifltype != 0) {
 5515:          const Vector2 *ubc = sideBnd->ubc;
 5516:   
 5517:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5518:             
 5519:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5520:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5521: 
 5522:             if (ifltype == -1) {
 5523:                // Flather 1
 5524: 
 5525:                const double depth = side->depth();
 5526: 
 5527:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5528: 
 5529:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5530: 
 5531:                side->u2[k] = vnorm*side->n;
 5532: 
 5533:             } else if (ifltype == -2) { // Discharge
 5534: 
 5535:                const double eta1 = side->eta1();
 5536:                const double eta2 = side->eta2();
 5537:                const double htot = side->htot2();
 5538: 
 5539:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5540:                assert(false && "Not implemented: Discharge bc");
 5541:                // const double dischrg = discharge(eta1);
 5542:                const double dischrg = 0.0; // XXX REMOVE
 5543:                
 5544: 
 5545:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5546: 
 5547:                const double vnorm = dischrg*eta2/htot;
 5548: 
 5549:                side->u2[k] = vnorm*side->n;
 5550: 
 5551:             }
 5552:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5553:                const double vnorm = dot(side->u2[k], side->n);
 5554: 
 5555:                double rat;
 5556:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5557:                else              rat = segment->vobc2; // outgoing
 5558: 
 5559:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5560: 
 5561:             }
 5562:             else { // not Flather or 3D radiation
 5563:                side->u2[k] = ubc[k];
 5564: 
 5565:             } // if (segment->ifltype...
 5566: 
 5567:          }
 5568: 
 5569:       }
 5570:       else if (isLand) { // if it is land boundary side
 5571: 
 5572:          if constexpr(islip == 0) { // free slip
 5573: 
 5574:             for (int k = kb; k < nvrt; k++) {
 5575: 
 5576:                const Vector2 t = side->t();
 5577:                const Vector2 n = side->n;
 5578: 
 5579:                double vnorm = 0.0; // for most cases
 5580:                const double vtan = dot(side->u2[k], t);
 5581:                
 5582:                side->u2[k] = vtan*t - vnorm*n;
 5583: 
 5584:             }
 5585: 
 5586:          } else { // no slip
 5587:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5588: 
 5589:          }
 5590:       } // if (side segment type...
 5591: 
 5592:    
 5593: 
 5594:    }
 5595: 
 5596: 
 5597:    __global__ void shapiroFilter1(void) {
 5598:       // First step of the Shapiro filter (normally used if indvel<=0)
 5599:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5600: 
 5601:       SIDE(side);
 5602: 
 5603:       // Only internal wet sides are processed
 5604:       if (side->isDry || !(side->isInternal())) return;
 5605: 
 5606:       const int kb = side->kb;
 5607: 
 5608:       for (int mm = 0; mm < niter_shap; mm++) {
 5609: 
 5610:          for (int k = kb + 1; k < nvrt; k++) {
 5611:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5612:             Vector2 suru = {0.0, 0.0};
 5613: 
 5614:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5615: 
 5616:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5617: 
 5618:                int kin = k;
 5619:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5620:                
 5621:                if constexpr(ics==1) {
 5622:                   suru += nSide->u2[kin];
 5623: 
 5624:                } else {
 5625:                   assert(false && "Not implemented: ics == 2");
 5626:                   // Vector2 vn1, vn2;
 5627:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5628:                   // suru=suru+vn1;
 5629:                   // surv=surv+vn2;
 5630:                }
 5631:             }
 5632: 
 5633: 
 5634:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5635: 
 5636:          }
 5637:       }
 5638:    }
 5639: 
 5640:    __global__ void shapiroFilter2(void) {
 5641:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5642: 
 5643:       SIDE(side);
 5644: 
 5645:       if (side->isDry || !(side->isInternal())) return;
 5646: 
 5647:       const int kb = side->kb;
 5648: 
 5649:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5650: 
 5651:       if (side->is2D()) {
 5652:          side->u2[kb + 1] = side->bcc[kb + 1];
 5653:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5654: 
 5655:       } else {
 5656:          // 3D
 5657:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5658:          
 5659:       }
 5660: 
 5661:    }
 5662: 
 5663: 
 5664:    __global__ void ul0UpdateZCoords(void) {
 5665:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5666:       
 5667:       NODE(node);      
 5668: 
 5669: 
 5670:       if (node->isDry2()) { 
 5671: 
 5672:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5673: 
 5674:          if constexpr(ivcor != 1) node->kb = 0;
 5675: 
 5676:       } else {
 5677: 
 5678:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5679:          node->updateKb();
 5680: 
 5681:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5682: 
 5683:       }
 5684: 
 5685:       // We use the temp.b field to store the previous state of isDry.
 5686:       node->tmp.b = node->isDry;
 5687: 
 5688:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5689:       node->isDry = true;
 5690: 
 5691:    }
 5692: 
 5693:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5694:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5695:    {
 5696:       ELEM(elem);
 5697: 
 5698:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5699: 
 5700:       // All the nodes of a wet element are wet.
 5701:       if (!elem->isDry) {
 5702:          elem->nodes[0]->isDry = false;
 5703:          elem->nodes[1]->isDry = false;
 5704:          elem->nodes[2]->isDry = false;
 5705:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5706: 
 5707:       }
 5708: 
 5709: 
 5710:       elem->kb = 0;
 5711: 
 5712:       if (elem->isDry) return;
 5713: 
 5714:       // Wet
 5715:       const Node *n1 = elem->nodes[0];
 5716:       const Node *n2 = elem->nodes[1];
 5717:       const Node *n3 = elem->nodes[2];  
 5718:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5719: 
 5720:    //    if(elem->isDry2()) { // XXXX
 5721:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5722:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5723:    //        call parallel_abort(errmsg)
 5724:    //    }
 5725: 
 5726: 
 5727:       // Computes element's kb as the minimum of the nodes' kb.
 5728:       const int kb1 = n1->kb;
 5729:       const int kb2 = n2->kb;
 5730:       const int kb3 = n3->kb;
 5731:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5732: 
 5733: 
 5734:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5735: 
 5736: 
 5737:       // Computes the element z as the mean of the nodes z.
 5738:       for (int k = elem->kb; k < nvrt; k++) {
 5739: 
 5740:          // Compute the element z as the mean of the nodes z.
 5741:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5742:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5743:          elem->z[k] /= elem->i34;
 5744: 
 5745:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5746:       }
 5747:                   
 5748:    }
 5749: 
 5750:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5751:    {
 5752:       NODE(node);
 5753:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5754: 
 5755:       if (it == iths) return;
 5756: 
 5757: 
 5758:       if(!node->isDry && node->tmp.b) { // rewetted
 5759:          for (int k=0; k < nvrt; k++) {
 5760: 
 5761:             Vector3 utmp={0.0, 0.0, 0.0};
 5762: 
 5763:             double ttmp=0.0;
 5764:             double stmp=0.0;
 5765:             int icount=0;
 5766:             for (int j = 0; j < node->numNodes; j++) {
 5767: 
 5768: 
 5769:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5770:                if (!node->isDry) { // all indices extended
 5771:                   icount++;
 5772: 
 5773:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5774:                   utmp += node->uvw2(k);
 5775:                   
 5776:                   ttmp += node->tracers[k].tracer[0]; 
 5777:                   stmp += node->tracers[k].tracer[1]; 
 5778:                }
 5779:             }
 5780: 
 5781:             if(icount > 0) {
 5782:                const double inv_icount = 1.0/icount;
 5783:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5784:                node->w2[k]     = inv_icount*utmp.z;
 5785:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5786:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5787:             }
 5788:          }
 5789:       }
 5790:    }
 5791: 
 5792: 
 5793:    __global__ void ul0UpdateSides(int it, int iths) {
 5794: 
 5795:       SIDE(side);
 5796: 
 5797:       // A side is wet if and only if at least one of its elements is wet.
 5798:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5799: 
 5800:       const Node *n1 = side->n1;
 5801:       const Node *n2 = side->n2;
 5802:       const int kb1 = n1->kb;
 5803:       const int kb2 = n2->kb;
 5804: 
 5805:       side->kb = 0; // dry
 5806: 
 5807:       if (isWet) {
 5808: 
 5809:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5810: 
 5811:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5812: 
 5813:          side->kb = min(kb1, kb2);
 5814: 
 5815:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5816: 
 5817:          for (int k = side->kb; k < nvrt; k++) {
 5818:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5819: 
 5820:          
 5821:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5822: 
 5823:             // Compute velocity for re-wetted sides 
 5824:             if ((it != iths) && (side->isDry && isWet)) {
 5825:             
 5826:                Vector2 utmp={0.0, 0.0};
 5827: 
 5828:                int icount=0;
 5829: 
 5830:                // For all the sides on the two elements that share this side
 5831:                for (int j=0; j < 2; j++) {
 5832:                   const Element *elem = side->elems[j];
 5833:                   if (elem == nullptr) continue;
 5834: 
 5835:                   for (int jj=0; jj < elem->i34; jj++) {
 5836:                      const Side *nSide = elem->sides[jj];
 5837:                      if (nSide->isDry) continue;
 5838: 
 5839:                      icount++;
 5840:                      utmp += nSide->u2[k];                     
 5841:                   }
 5842:                }
 5843:                   
 5844:                assert(icount > 0 && "No wet sides around this side");
 5845:                if (icount > 0)  side->u2[k] = utmp/icount;
 5846:                   
 5847:             } // if ((it != iths) && (side->isDry && isWet))
 5848: 
 5849:          } // for k
 5850: 
 5851:       } // if isWet
 5852:    
 5853:       side->isDry = !isWet;
 5854: 
 5855:    }
 5856: 
 5857: 
 5858:    __global__ void zeroNodalVelocities(void) {
 5859:       NODE(node);
 5860: 
 5861:       for (int k = 0; k < nvrt; k++) {
 5862:          node->u2[k]   = {0.0, 0.0};
 5863:          node->w2[k]   = 0.0;
 5864:          node->utmp[k] = {0.0, 0.0};
 5865:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5866:       }
 5867:    }
 5868: 
 5869:  
 5870: 
 5871:    __global__ void computeNodalVerticalVelocities1(void) {
 5872:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5873:    // Adds the element's vertical velocity times the element's area.
 5874:       ELEM(elem);
 5875: 
 5876:       for (int j = 0; j < elem->i34; j++) {
 5877:          Node *node = elem->nodes[j];
 5878: 
 5879:          for (int k = node->kb; k < nvrt; k++) {
 5880:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5881:          }
 5882:          atomicAdd(&(node->tmp.d), elem->area);
 5883:       }
 5884:    }
 5885: 
 5886:    __global__ void computeNodalVerticalVelocities2(void) {
 5887:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5888:    // Divides by the total area of the elements sharing the    node.
 5889:       NODE(node);
 5890: 
 5891:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5892:    }
 5893: 
 5894: 
 5895:    __global__ void computeNodalHorizontalVelocities1(void) {
 5896:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5897:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5898: 
 5899:       ELEM(elem);
 5900: 
 5901:       const int kb = elem->kb;
 5902:       const bool isTri = elem->isTri();
 5903: 
 5904:       if constexpr(indvel <= 0) {
 5905:          // Assuming discontinoius hvel.
 5906: 
 5907: 
 5908:          if (isTri) { // For triangles
 5909:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5910:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5911: 
 5912:             for (int j = 0; j < 3; j++) {
 5913:                // For every node of the triangle...
 5914:                Node *node = elem->nodes[j];
 5915: 
 5916:                const Side *s1 = elem->sides[j];
 5917:                const Side *s2 = elem->sides[(j + 1) % 3];
 5918:                const Side *s3 = elem->sides[(j + 2) % 3];
 5919: 
 5920:                const int numElements = node->numElements;
 5921:                const double inv_numElements = 1.0/numElements;
 5922: 
 5923:                for (int k = kb; k < nvrt; k++)  {
 5924:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 5925:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5926:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5927:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5928:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 5929:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 5930: 
 5931:                }
 5932: 
 5933:             }
 5934:          }
 5935:          else { // For quads
 5936:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 5937: 
 5938:          }
 5939: 
 5940:       }
 5941:       
 5942:    }
 5943: 
 5944: 
 5945:    __global__ void computeNodalHorizontalVelocities2(void) {
 5946:       NODE(node);
 5947: 
 5948:       for (int k = 0; k < nvrt; k++) {
 5949:          node->u2[k] = node->utmp[k];
 5950:          node->w2[k] = node->w2[k];
 5951:       }
 5952:       
 5953:    }   
 5954: 
 5955:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5956:    // XXXX I'm not sure where I got this function from. 
 5957:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5958:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5959:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5960:    // It uses the utmp array as a temporary array to store the velocities.
 5961: 
 5962:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5963: 
 5964:       SIDE(side);
 5965: 
 5966:       const int kb = side->kb;
 5967: 
 5968:       Node *n1 = side->n1;
 5969:       Node *n2 = side->n2;
 5970: 
 5971:       for (int k = kb; k < nvrt; k++) {
 5972: 
 5973:          // Cast the u2 vector into a Vector2 
 5974:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5975:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5976: 
 5977:          n1_u2 = side->u2[k]/n1->numSides;
 5978:          n2_u2 = side->u2[k]/n2->numSides;
 5979: 
 5980:       }
 5981: 
 5982: 
 5983:    }
 5984: 
 5985:    __global__ void resetVelocityOpenBndNodes(void) {
 5986:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5987: 
 5988:       NODE_BND(nodebnd);
 5989: 
 5990:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5991:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 5992:       }
 5993: 
 5994:    }
 5995: 
 5996: 
 5997:    __global__ void setVelocityOpenBndNodes(void) {
 5998:    // For open boundary nodes sets their velocity to the imposed values.
 5999: 
 6000:       SIDE_BND(sidebnd);
 6001: 
 6002:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6003:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6004:          // to its segment to the average of the side velocity.
 6005: 
 6006:          for (int k = 0; k < nvrt; k++) {
 6007:             Node *n1 = sidebnd->side->n1;
 6008:             Node *n2 = sidebnd->side->n2;
 6009: 
 6010: 
 6011:             Vector2 n1_u2(n1->u2[k]);
 6012:             Vector2 n2_u2(n2->u2[k]);
 6013: 
 6014:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6015:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6016:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6017:             }
 6018:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6019:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6020:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6021:             }
 6022: 
 6023:          }
 6024: 
 6025:       }
 6026: 
 6027:    }
 6028: 
 6029: 
 6030:    __global__ void computeVerticalVelocity(void) {
 6031:       // Computes the vertical velocity at the (2D) element's centroid.
 6032:       // In this function we will be considering volumetric elements, with side faces and a 
 6033:       // bottom and a top face. We will call them SFs, BF and TF.
 6034:       // It computes the flux coming from BF and the SFs.
 6035:       // If the bed is moving, it takes that into account.
 6036:       // Since water is incompressible, the integral of the velocity times the normal vector
 6037:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6038:       // and the BF is equal to the flux going out from the TF.
 6039:       // TF = - BF - sum(SFs).
 6040:       // It then computes the horizontal velocity at the center of TF.
 6041:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6042:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6043:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6044: 
 6045:       ELEM(elem);
 6046: 
 6047:       if (elem->isDry) return;
 6048: 
 6049:       const int kb = elem->kb;
 6050:       const bool isTri = elem->isTri();
 6051: 
 6052:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6053: 
 6054:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6055:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6056:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6057: 
 6058:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6059: 
 6060:       double area3D;
 6061: 
 6062:       // Bottom face flux
 6063:       double bottomFlux = 0.0;
 6064:       Vector2 u2meanBottom = {0.0, 0.0};
 6065:       const Vector2 gradh = elem->grad2(&Node::depth);
 6066:       if constexpr(imm==2) {
 6067:          Vector3 ubed;
 6068: 
 6069:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6070:          // updateBDEF(ubed);
 6071:      
 6072:          // const double bflux0 = dot(ubed, elem_n1);
 6073: 
 6074:          // elem->w[kb] += ubed.z;
 6075:       }
 6076:       else {
 6077:          Vector2 umean;
 6078:          if constexpr(ics == 1) {
 6079:             u2meanBottom = elem->mean(kb, &Side::u2);
 6080:          }
 6081:          else {
 6082:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6083:          }
 6084: 
 6085:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6086:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6087: 
 6088:          bottomFlux = - dot(gradh, u2meanBottom);
 6089:       } // if imm
 6090: 
 6091:       // Compute w for kb+1 to nvrt-1
 6092:       for (int l = kb; l < nvrt - 1; l++) {
 6093: 
 6094:          // normal vector to the top face of the "volumetric" element (3D)
 6095:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6096: 
 6097:          // Compute the total flux at the sides
 6098:          double sideFlux = 0.0;
 6099:          Vector2 u2top = {0.0, 0.0};
 6100:          for (int j = 0; j < elem->i34; j++) {
 6101:             const Side *side = elem->sides[j];
 6102: 
 6103:             const double sideArea = side->area(l);
 6104:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6105:             const double sign = elem->ssign[j]; 
 6106: 
 6107:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6108:          }
 6109:          
 6110:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6111:          //velocities at the centers of the sides
 6112:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6113: 
 6114:          // The flx at the top ace can be computed from the other flows.
 6115:          const double topFlux = - sideFlux - bottomFlux;
 6116:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6117: 
 6118:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6119: 
 6120:          elem_n1 = elem_n2;
 6121: 
 6122:          bottomFlux = - topFlux;
 6123:       }
 6124:    }  
 6125: 
 6126: 
 6127: 
 6128: 
 6129: 
