 4668:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4669: 
 4670:       SIDE(side);
 4671: 
 4672: 
 4673:       side->U = {0.0, 0.0}; 
 4674:          
 4675:       if(side->isDry) return;
 4676: 
 4677:       const Node *node1 = side->n1;
 4678:       const Node *node2 = side->n2;
 4679: 
 4680:       // Vertically integrated velocity U (in ll if ics=2)
 4681:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4682:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4683:       }
 4684: 
 4685:    }
 4686: 
 4687:    __global__ void computeBottomDragVegetation(void) {
 4688:       // UNFINISHED. CHECK THIS:
 4689:       // How many kernels are needed? Why so many for loops?
 4690:       // Is the loop on sides needed?
 4691: 
 4692:       NODE(node);
 4693: 
 4694: 
 4695:       const int    kb      = node->kb;
 4696:       const double htot    = node->htot2(); 
 4697:       
 4698:       if (node->isDry) {
 4699:          // Default values for dry nodes
 4700:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4701:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4702: 
 4703:          return;
 4704:        
 4705:       }
 4706: 
 4707:       // Computes bottom drag Cd based on the selected nchi
 4708:       node->computeBottomDragCd();
 4709:       
 4710: 
 4711: 
 4712:       //   Bottom stress in m^2/s^2
 4713:       if (node->rho[kb + 1] >= -98.0)
 4714:       {
 4715:          const double mag_u = length(node->u2[kb + 1]);
 4716:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4717: 
 4718:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4719:          // !sediment erosion: this part needs more documentation
 4720:       }
 4721:     
 4722: 
 4723: 
 4724:       // Compute vegetation parameters
 4725:       //--------------------------------
 4726: 
 4727:       // SAV constants
 4728:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4729:       constexpr double veg_cfpsi = 0.16;
 4730: 
 4731:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4732:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4733: 
 4734:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4735:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4736:          int kbin = 0; // bin index
 4737:          for (int k = kb; k < nvrt; k++) {
 4738:             // Computes node height above the bottom level
 4739:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4740:             assert(false && "Vertical variation of vegetation not implemented");
 4741: 
 4742:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4743:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4744:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4745:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4746:             // } else {
 4747:             //    // Find the bin at which the current vertical level is
 4748:             //    while (kbin<nbins_veg_vert) {
 4749:             //       const double zn = node->z[kbin];
 4750:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4751:             //          break;
 4752:             //       } // if
 4753:             //       kbin++;
 4754:             //    } // while
 4755:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4756: 
 4757:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4758:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4759:                
 4760:             //    // Linear interpolation of the vegetation parameters
 4761:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4762:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4763:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4764:             // } // if rl10
 4765: 
 4766:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4767: 
 4768:          } // for k
 4769: 
 4770: 
 4771:       } else { // Ganthy (iveg==2)
 4772:       //  Modify canopy height, diameter, and density
 4773: 
 4774:          // Make sure there is vegetation on this node
 4775:          if (node->veg_h_unbent > 0.0) {
 4776:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4777: 
 4778:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4779:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4780:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4781: 
 4782:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4783:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4784:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4785:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4786:          } // if veg_h_unbent
 4787: 
 4788:          for (int k = 0; k < nvrt; k++) {
 4789:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4790:          } // for k
 4791:       
 4792: 
 4793:       } // if iveg
 4794:      
 4795: 
 4796:       // Compute vertical mean of veg_alpha3D
 4797:       if (iveg != 0) {
 4798:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4799:          double sum1=0.0;
 4800:          double sum2=0.0;
 4801:          // Integrate over each level under the canopy...
 4802:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4803:             const double Dz = node->Dz(k);
 4804: 
 4805:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4806:             sum2 += Dz;
 4807: 
 4808:          } // for k
 4809:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4810:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4811: 
 4812:       } // if iveg
 4813: 
 4814:    }
 4815: 
 4816:    __global__ void computeVegetationAndDragParameters(void) {
 4817:       // Computes the vegetation and drag model parameters:
 4818:       // chi, \tilde\chi, beta, \breve{H}
 4819:       
 4820:       SIDE(side);
 4821: 
 4822:       if (side->isDry) return;
 4823: 
 4824:       const double htot = side->htot2();
 4825:       const int    kb   = side->kb;
 4826: 
 4827:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4828: 
 4829:       const double veg_h     = side->veg_h();
 4830:       const double veg_nv    = side->veg_nv();
 4831:       const double veg_c     = side->veg_c();
 4832:       const double veg_beta  = side->veg_beta;
 4833:       const double veg_alpha = side->veg_alpha_vert_mean();
 4834: 
 4835:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4836:       // Velocity magnitude at the bottom level
 4837:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4838:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4839:       side->chi2 = side->Cd()*vmag1;
 4840:       side->chi  = side->chi2;
 4841:       if constexpr(iveg != 0) {
 4842:          const Node *n1 = side->n1;
 4843:          const Node *n2 = side->n2;
 4844:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4845:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4846:       }
 4847: 
 4848:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4849: 
 4850:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4851:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4852:       double magUa = 0.0;
 4853:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4854:          // 3D wet side with veg...
 4855: 
 4856:          double magUa = 0.0;
 4857:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4858:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4859: 
 4860:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4861:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4862:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4863: 
 4864:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4865:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4866: 
 4867:                // Velocity magnitude at the bottom (l) of the level
 4868:                const double ul = length(side->u2[k]);
 4869: 
 4870:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4871:                magUa += Dz*0.5*(uh + ul);
 4872: 
 4873:             } // if HasVegetation
 4874:          } // for k
 4875:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4876: 
 4877:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4878:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4879:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4880:             const double zCpy = side->zTopCanopy();
 4881:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4882:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4883:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4884:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4885:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4886:          } // if isSubmerged
 4887:       } // if iveg   
 4888: 
 4889:       // Computes the friction modified depth, \breve{H} in notes
 4890:       if (side->is2D()) { // 2D
 4891: 
 4892:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4893:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4894: 
 4895:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4896: 
 4897:          side->hhat = htot*htot/fricH; 
 4898: 
 4899:       } else { // 3D
 4900:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4901: 
 4902:          if constexpr(iveg != 0) {
 4903:             
 4904:             if (side->isSubmerged()) { 
 4905:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4906:                side->hhat -= veg_c*Hhat_alpha;
 4907: 
 4908:             } else { // Emergent
 4909:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4910:             }
 4911:          } // if iveg
 4912: 
 4913:          // Enforce positivity for 3D model
 4914:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4915:       } // if 3D
 4916: 
 4917:    }
 4918: 
 4919: 
 4920: 
 4921:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4922:    // Computes the density gradient between two elements, e1 and e2.
 4923:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4924:    // zero in the direction normal to the side. 
 4925:    // 
 4926:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4927:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4928:    //
 4929:    // Input:
 4930:    //    e1: Element
 4931:    //    e2: Neighbor element (or nullptr if boundary)
 4932:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4933:    //    k: Index of the half-level at which the density is interpolated
 4934:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4935:    // 
 4936:    // Output:
 4937:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4938:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4939: 
 4940:       if (e2 == nullptr || e2->isDry) {
 4941:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4942: 
 4943:          Side *side = e1->sides[j];
 4944:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4945:                  
 4946:          if constexpr(ics == 1) {
 4947:             vec = side->n; // Normal vector to the side
 4948:          } else {
 4949:             // IMPLEMENT THIS XXXXXX
 4950:             // !replace with xel, yel?
 4951:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4952:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4953:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4954:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4955:          } //ics
 4956:                    
 4957:          diffRho = 0.0;
 4958: 
 4959:       } else { //internal and wet
 4960:          if constexpr(ics==1) {
 4961:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4962: 
 4963:             // Vector from e1 to e2
 4964:             vec = e2->center - e1->center;
 4965: 
 4966:          } else { 
 4967:             // IMPLEMENT THIS XXXXXX
 4968:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4969:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4970:             //                   alow(j)=xctr2
 4971:             //                   bdia(j)=yctr2
 4972:          } // ics
 4973: 
 4974:          diffRho = rho2 - e1->demeanedDensity(k);
 4975:       }
 4976: 
 4977:    }
 4978: 
 4979:    __global__ void computeDensityCubicSplines(void) {
 4980:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4981: 
 4982:       ELEM(elem);
 4983: 
 4984:       if (elem->isDry) return;
 4985: 
 4986:       const int kb = elem->kb;
 4987: 
 4988:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4989:       if (elem->is2D()) {
 4990:          // In the 2D case, the density is constant at the prism level. 
 4991:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4992:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4993:       } else { //3D
 4994: 
 4995:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4996:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4997:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4998:          ///// XXXX CHECK INDICES!!!!!
 4999:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5000:       } // 2D/3D
 5001: 
 5002:    }
 5003: } // extern "C"
 5004: 
 5005: 
 5006: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5007: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5008: 
 5009:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5010: 
 5011:    const int kb  = elem->kb;
 5012:    const int kb2 = elem2->kb;
 5013: 
 5014:    // z-coordinate of prism of elem
 5015:    const double zp = elem->z_prism(k);
 5016: 
 5017:    double rho = 0.0;
 5018: 
 5019:    if (elem2->is2D()) {
 5020:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5021: 
 5022:    } else {  // 3D
 5023: 
 5024:       // eta_min may be < zmax
 5025:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5026:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5027: 
 5028:       // (Extrapolate density below bottom, we will fix it later)
 5029:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5030:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5031:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5032:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5033:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5034:    } // 2D/3D
 5035:      
 5036: 
 5037:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5038:    // Now we need to fix it.
 5039:    if (elem->z[k] < elem2->z[kb2]) {
 5040:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5041: 
 5042:       // There are two methods to adjust the density at the bottom of the element.
 5043:       // iunder_deep=0: 
 5044:       const double depth1 = abs(elem->z[kb]); // larger depth
 5045: 
 5046:       if (iunder_deep==0) {
 5047: 
 5048:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5049: 
 5050:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5051: 
 5052:       } else { // iunder_deep != 0
 5053: 
 5054:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5055: 
 5056:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5057: 
 5058:          //   Demeaned density at the same z coordinate as
 5059:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5060:          }
 5061: 
 5062:       } // if iunder_deep
 5063:    } // if elem->z[kb] < elem2->z[kb]
 5064: 
 5065:    return rho;
 5066: }
 5067: 
 5068: 
 5069: extern "C" {
 5070:    __global__ void computeDensityGradient(void) {
 5071: 
 5072:       if constexpr(ibc != 0) return;
 5073: 
 5074:          // Compute the horizontal density gradient at each element.
 5075:       // It works in two steps:
 5076:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5077:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5078:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5079:       //             gradRho.r1 = rho1 - rho0
 5080:       //             gradRho.r2 = rho2 - rho0
 5081:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5082:       // 
 5083:       //  NOTE: We use de-meaned densities.
 5084: 
 5085:       ELEM(elem);
 5086: 
 5087:       if (elem->isDry) return;
 5088: 
 5089:       const int kb  = elem->kb;
 5090:       const int i34 = elem->i34;
 5091: 
 5092:       for (int k = kb + 1; k < nvrt; k++) {
 5093:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5094:          //             gradRho.r1 = rho1 - rho0
 5095:          //             gradRho.r2 = rho2 - rho0
 5096:          int icount = 0;
 5097:          double sumRx = 0.0;
 5098:          double sumRy = 0.0;
 5099:          for (int j1=0; j1<i34; j1++) { 
 5100: 
 5101:             const int j2 = elem->nxq(j1 + 1);
 5102: 
 5103:             // Pairs of consecutive neighbor elements of elem
 5104:             const Element *e1 = elem->nghbElems[j1];
 5105:             const Element *e2 = elem->nghbElems[j2];
 5106: 
 5107:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5108:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5109:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5110: 
 5111:             // Compute the density difference and the vector from elem to e1 and e2
 5112:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5113:             double diffRho1, diffRho2;
 5114:             Vector2 vec1, vec2;
 5115:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5116:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5117: 
 5118:             const double rl1 = length(vec1);
 5119:             const double rl2 = length(vec2);
 5120:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5121: 
 5122:             const double delta = cross(vec1, vec2);
 5123:             const double sintheta = abs(delta)/(rl1*rl2);
 5124: 
 5125:             // To avoid problems, avoid elements with small angle between vectors
 5126:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5127:             const bool validEq = (sintheta > sin_one_deg);
 5128: 
 5129:             if (validEq) {
 5130:                // Solve the system of equations to get the density gradient at elem
 5131:                icount++;
 5132:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5133:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5134:                sumRx += Rx;
 5135:                sumRy += Ry;
 5136:             }
 5137:          } // for j1
 5138: 
 5139:          // Compute the average density gradient at elem
 5140:          if (icount==0) {
 5141:            // Bad mesh quality; bail out with 0 b-cc
 5142:            elem->gradRho[k] = {0.0, 0.0};
 5143:          } else {
 5144:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5145:          }
 5146: 
 5147:       } // for k
 5148: 
 5149:    }
 5150: 
 5151:    __global__ void computeBaroclinicTerm(void) {
 5152:    // Computes the baroclinic term at sides (at half levels).
 5153:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5154:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5155: 
 5156:       if (ibc == 1) return;
 5157: 
 5158:       SIDE(side);
 5159: 
 5160:       if (side->isDry) return;
 5161: 
 5162:       const Element *e1 = side->elems[0];
 5163:       const Element *e2 = side->elems[1];      
 5164:       const int kb = side->kb;
 5165:       
 5166:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5167: 
 5168:       // interpolates vertically the density gradient of the two elements at the half level/
 5169: 
 5170:       int k1 = max(kb, nvrt / 2);
 5171:       int k2 = max(kb, nvrt / 2);
 5172: 
 5173:       // Starts the integration at the surface and goes down to the bottom
 5174:       side->bcc[nvrt-1] = {0.0, 0.0};
 5175:       for (int k = nvrt - 2; k >= kb; k--) {
 5176:       // For each prism level (from surface to bottom)...
 5177: 
 5178:          // For both elements, interpolate density gradient at the side's half level.
 5179:          // The gradient at the side is the average of the gradients at the elements.
 5180:          // w1, w2 are used to take into account boundary sides, with just one element.
 5181:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5182:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5183:          const double wsum = w1 + w2;
 5184:          w1 = w1/wsum;
 5185:          w2 = w2/wsum;
 5186:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5187: 
 5188:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5189:          Vector2 gradRho = {0.0, 0.0};
 5190:          if (e1 != nullptr && k > kb) {
 5191:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5192:             
 5193:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5194:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5195:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5196: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5197:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5198:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5199:          }      
 5200:          if (e2 != nullptr && k > kb) {
 5201:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5202:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5203:             
 5204:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5205:          }
 5206: 
 5207:          if constexpr(ics==2) {
 5208:             assert(false && "Not implemented: ics == 2");
 5209:             // IMPLEMENT THIS XXXXXX
 5210:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5211:             // swild(1)=tmp1
 5212:             // swild(2)=tmp2
 5213:          }
 5214:          
 5215:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5216:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5217:          // CHECK INDICES!!! XXX
 5218:          const double grav3 = side->grav3();
 5219:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5220: 
 5221:       } // for
 5222: 
 5223:    }
 5224: 
 5225: 
 5226: 
 5227:    __global__ void computeHorGradientAtSide(void) {
 5228: 
 5229:       // Compute the horizontal density gradient at each element.
 5230:       // It works in two steps:
 5231:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5232:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5233:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5234:       //             gradRho.r1 = rho1 - rho0
 5235:       //             gradRho.r2 = rho2 - rho0
 5236:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5237:       // 
 5238:       //  NOTE: We use de-meaned densities.
 5239: 
 5240:       SIDE(side);
 5241: 
 5242: // printf("side->isDry: %d\n", side->isDry);
 5243:       if (side->isDry) return;
 5244: 
 5245:       // Computes the gradient of the variables at the side center.
 5246:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5247:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5248:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5249: 
 5250:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5251:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5252:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5253:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5254: 
 5255: 
 5256:    }
 5257: 
 5258: 
 5259:    __global__ void solveMomentumEquations(double time) {
 5260: 
 5261:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5262:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5263: 
 5264:       SIDE(side);
 5265: 
 5266:       if (side->isDry) 
 5267:       {
 5268:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5269: 
 5270:          return;
 5271:       }
 5272: 
 5273:       const Node *n1 = side->n1;
 5274:       const Node *n2 = side->n2;
 5275: 
 5276:       const int kb = side->kb;
 5277: 
 5278:       const double veg_h = side->veg_h();
 5279:       const double grav3 = side->grav3();
 5280: 
 5281:       if (side->is2D()) {
 5282:          // Warning: Do not use htot2, which is updated.
 5283:          const double htot = side->htot1();
 5284:          const double hhat = side->hhat;
 5285: 
 5286:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5287: 
 5288:          Vector2 tau2 = {0.0, 0.0};
 5289:           
 5290:          if constexpr(ics==1) {
 5291:             tau2 = side->tau();
 5292: 
 5293:          } else {
 5294:             assert(false && "Not implemented: ics == 2");
 5295:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5296:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5297:             // taux2=(vn1+tt1)*0.5d0
 5298:             // tauy2=(vn2+ss1)*0.5d0
 5299:          } // if ics         
 5300: 
 5301:          // hat_gam has units of m/s
 5302: 
 5303:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5304: 
 5305:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5306:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5307: 
 5308:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5309: 
 5310: 
 5311:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5312:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5313: 
 5314:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5315: 
 5316:       }
 5317:       else { // 3D
 5318: 
 5319:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5320:          // 
 5321:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5322:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5323:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5324:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5325:          // k+1 and k.
 5326: 
 5327: 
 5328:          const int ndim = nvrt - kb;
 5329:          const double zTopCanopy = side->zTopCanopy();
 5330: 
 5331:          // Initialize the tridiagonal system
 5332:          for (int k = kb + 1; k < nvrt; k++) {
 5333:             
 5334:             const int kin = k - (kb + 1);
 5335: 
 5336:             // Vertical viscosity at the face center
 5337:             const double dfz =  0.01; //0.5*(side->dfv(k - 1) + side->dfv(k)); ///XXXXX KKKKK
 5338:  
 5339:             alow[kin] = 0.0;
 5340:             cupp[kin] = 0.0;
 5341:             bdia[kin] = 0.0;
 5342: 
 5343:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5344:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5345: 
 5346:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5347:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5348:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5349: 
 5350:             // First part: layers k, k+1
 5351:             if (k < nvrt - 1) {
 5352:                              
 5353:                if constexpr(iveg != 0) {
 5354: 
 5355:                   // If there is vegetation at this level...
 5356:                   if (zTopCanopy > side->zc[k]) {
 5357:                      // If the canopy is above the k layer...
 5358:                      
 5359:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5360:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5361:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5362:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5363: 
 5364:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5365:                      const double vmag2 = length(ut2);
 5366:                      const double vmag1 = length(side->u2[k]);
 5367:                      const double vmag = 0.5*(vmag1 + vmag2);
 5368:                      
 5369:                      // Computes the vegetation alpha at the face center
 5370:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5371: 
 5372:                      cff1 += veg_alpha_sd*dt*vmag;
 5373: 
 5374:                   } // if (zTopCanopy
 5375:                } // if iveg
 5376: 
 5377:                const double dzz = side->Dz(k + 1);
 5378:                const double tmp = dt*dfz/dzz;
 5379:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5380: 
 5381:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5382:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5383:             }
 5384: 
 5385: 
 5386:             // Second part: layers k-1, k
 5387:             if (k > kb + 1) {
 5388: 
 5389:                double cff1 = 1.0; //init \bar{c^k}
 5390: 
 5391:                if constexpr(iveg != 0) {
 5392:                   // If there is vegetation at this level...
 5393:                   if (zTopCanopy > side->zc[k-1]) {
 5394:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5395:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5396: 
 5397:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5398: 
 5399:                      const double vmag2 = length(ut2);
 5400:                      const double vmag1 = length(side->u2[k-1]);
 5401:                      const double vmag = 0.5*(vmag1 + vmag2);
 5402: 
 5403:                      // Computes the vegetation alpha at the face center
 5404:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5405:                      cff1 += veg_alpha_sd*dt*vmag;
 5406:                   } // if zTopCanopy
 5407: 
 5408:                } // if iveg
 5409: 
 5410:                const double dzz = side->Dz(k);
 5411:                const double tmp = dt*dfz/dzz;
 5412:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5413: 
 5414:                alow[kin] += cff1*dzz/6.0 - tmp;
 5415:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5416: 
 5417:             } else { // Bottom boundary
 5418:                // This occurs at the bottom, where the bottom drag is applied.
 5419: 
 5420:                bdia[kin] += dt*side->chi2; // XXXX
 5421: 
 5422:             } // if (k > kb + 1)
 5423: 
 5424: 
 5425:          } // for (int k
 5426: 
 5427: 
 5428: 
 5429:          // Computes the RHS.
 5430:          // -----------------
 5431: 
 5432:          //	BC to be imposed at the end.
 5433: 
 5434:          const Vector2 gradETP  = side->gradETP;
 5435:          const Vector2 gradPr   = side->gradPr;
 5436:          const Vector2 gradEta1 = side->gradEta1;
 5437:          const Vector2 gradEta2 = side->gradEta2;
 5438: 
 5439:          const Vector2 *btu = side->btu;
 5440:          const Vector2 *u2  = side->u2;
 5441:          const double coriolis = side->coriolis;
 5442:          const Vector2 *nuGradU = side->nuGradU;
 5443: 
 5444: 
 5445:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5446: 
 5447:          for (int k = kb + 1; k < nvrt; k++) {
 5448:             const int kin = k - kb - 1;
 5449: 
 5450:             const double dz_0 = side->Dz(k);
 5451:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5452: 
 5453:             rrhs[kin] = {0.0, 0.0};
 5454:             double dz = 0.0;
 5455: 
 5456:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5457:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5458:             if (k < nvrt  ) dz += dz_1;
 5459:             if (k > kb + 1) dz += dz_0;
 5460: 
 5461:             // Elevation gradient, atmospheric pressure and tidal potential
 5462:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5463: 
 5464:             // Coriolis, advection, wind stress, and horizontal viscosity
 5465:             if (k < nvrt - 1) {
 5466: 
 5467: 
 5468:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5469:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5470:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5471:                                                 
 5472: 
 5473:                //diff stress tensors 1006
 5474:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5475:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5476:                   assert(false && "Not implemented: itur == 5");
 5477:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5478:                }
 5479:                // else assert(false && "itur # Not implemented");
 5480: 
 5481:             } else { // k == nvrt - 1 SURFACE
 5482:                Vector2 tau2 = {0.0, 0.0};
 5483:                if constexpr(ics==1) {
 5484:                   tau2 = side->tau();
 5485:       
 5486:                } else {
 5487:                   assert(false && "Not implemented: ics == 2");
 5488:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5489:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5490:                   // taux2=(vn1+tt1)*0.5d0
 5491:                   // tauy2=(vn2+ss1)*0.5d0
 5492:                } // if ics
 5493: 
 5494:                rrhs[kin] += dt*tau2;
 5495: 
 5496:             } // if k<nvrt
 5497: 
 5498:             if (k > kb + 1) {
 5499:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5500:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5501:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5502: 
 5503:                // diff stress tensors 1006
 5504:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5505:                   assert(false && "Not implemented: itur == 5");
 5506:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5507:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5508:                }
 5509:                // else assert(false && "itur # Not implemented");
 5510: 
 5511: 
 5512:             } // if k>kbs + 1
 5513: 
 5514:             // Baroclinic
 5515:             Vector2 *bcc = side->bcc;
 5516:             if constexpr(ibc == 0) {
 5517:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5518:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5519: 
 5520:             } // if ibc==0
 5521: 
 5522:          } // k=kb + 1,nvrt
 5523: 
 5524: 
 5525:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5526: 
 5527:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5528:             const int kin = k - kb - 1;
 5529:    
 5530:             // Velocity is always clamped to maximum values
 5531:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5532:          } // k
 5533: 
 5534:       } // if side->is2D()
 5535:       
 5536: 
 5537:       // Impose velocity boundary condition at the bottom
 5538:       if constexpr(imm == 2) { // 3D bed deformation model
 5539:          double dep;
 5540:          Vector2 vel;
 5541: 
 5542:          assert(false && "Not implemented: imm == 2");
 5543:          //update_bdef(time, x0, y0, dep, vel);
 5544:          // side->u2[kb] = vel;
 5545: 
 5546:       } else { // imm = 0 or 1
 5547:          if (side->Cd() == 0.0) {
 5548:             side->u2[kb] = side->u2[kb + 1];
 5549: 
 5550:          } else if (side->is3D()) { // 3D no slip bottom   
 5551:             side->u2[kb] = {0.0, 0.0};
 5552:          }
 5553:           
 5554:       } // if imm
 5555: 
 5556:       // The velocities below the bottom level are set to zero
 5557:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5558: 
 5559: 
 5560:    }
 5561: 
 5562: 
 5563:    __global__ void applyMomentumBC(void) {
 5564: 
 5565:       SIDE_BND(sideBnd);
 5566: 
 5567:       Side *side = sideBnd->side;
 5568:       const BoundarySegment *segment = sideBnd->segment;
 5569:       const Node *n1 = side->n1;
 5570:       const Node *n2 = side->n2;
 5571: 
 5572:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5573: 
 5574:       const bool isLand = segment->isLand;
 5575:       const int ifltype = segment->ifltype;
 5576: 
 5577:       const int kb = side->kb;
 5578: 
 5579:       if (!isLand && ifltype != 0) {
 5580:          const Vector2 *ubc = sideBnd->ubc;
 5581:   
 5582:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5583:             
 5584:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5585:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5586: 
 5587:             if (ifltype == -1) {
 5588:                // Flather 1
 5589: 
 5590:                const double depth = side->depth();
 5591: 
 5592:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5593: 
 5594:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5595: 
 5596:                side->u2[k] = vnorm*side->n;
 5597: 
 5598:             } else if (ifltype == -2) { // Discharge
 5599: 
 5600:                const double eta1 = side->eta1();
 5601:                const double eta2 = side->eta2();
 5602:                const double htot = side->htot2();
 5603: 
 5604:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5605:                assert(false && "Not implemented: Discharge bc");
 5606:                // const double dischrg = discharge(eta1);
 5607:                const double dischrg = 0.0; // XXX REMOVE
 5608:                
 5609: 
 5610:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5611: 
 5612:                const double vnorm = dischrg*eta2/htot;
 5613: 
 5614:                side->u2[k] = vnorm*side->n;
 5615: 
 5616:             }
 5617:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5618:                const double vnorm = dot(side->u2[k], side->n);
 5619: 
 5620:                double rat;
 5621:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5622:                else              rat = segment->vobc2; // outgoing
 5623: 
 5624:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5625: 
 5626:             }
 5627:             else { // not Flather or 3D radiation
 5628: printf("ifltype = %d\n", ifltype);
 5629:                side->u2[k] = ubc[k];
 5630: 
 5631:             } // if (segment->ifltype...
 5632: 
 5633:          }
 5634: 
 5635:       }
 5636:       else if (isLand) { // if it is land boundary side
 5637: 
 5638:          if constexpr(islip == 0) { // free slip
 5639: 
 5640:             for (int k = kb; k < nvrt; k++) {
 5641: 
 5642:                const Vector2 t = side->t();
 5643:                const Vector2 n = side->n;
 5644: 
 5645:                double vnorm = 0.0; // for most cases
 5646:                const double vtan = dot(side->u2[k], t);
 5647:                
 5648:                side->u2[k] = vtan*t - vnorm*n;
 5649: 
 5650:             }
 5651: 
 5652:          } else { // no slip
 5653:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5654: 
 5655:          }
 5656:       } // if (side segment type...
 5657: 
 5658:    
 5659: 
 5660:    }
 5661: 
 5662: 
 5663:    __global__ void shapiroFilter1(void) {
 5664:       // First step of the Shapiro filter (normally used if indvel<=0)
 5665:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5666: 
 5667:       SIDE(side);
 5668: 
 5669:       // Only internal wet sides are processed
 5670:       if (side->isDry || !(side->isInternal())) return;
 5671: 
 5672:       const int kb = side->kb;
 5673: 
 5674:       for (int mm = 0; mm < niter_shap; mm++) {
 5675: 
 5676:          for (int k = kb + 1; k < nvrt; k++) {
 5677:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5678:             Vector2 suru = {0.0, 0.0};
 5679: 
 5680:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5681: 
 5682:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5683: 
 5684:                int kin = k;
 5685:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5686:                
 5687:                if constexpr(ics==1) {
 5688:                   suru += nSide->u2[kin];
 5689: 
 5690:                } else {
 5691:                   assert(false && "Not implemented: ics == 2");
 5692:                   // Vector2 vn1, vn2;
 5693:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5694:                   // suru=suru+vn1;
 5695:                   // surv=surv+vn2;
 5696:                }
 5697:             }
 5698: 
 5699:             // Reusing bcc as a temporary array to store the suru values.
 5700:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5701: 
 5702:          }
 5703:       }
 5704:    }
 5705: 
 5706:    __global__ void shapiroFilter2(void) {
 5707:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5708: 
 5709:       SIDE(side);
 5710: 
 5711:       if (side->isDry || !(side->isInternal())) return;
 5712: 
 5713:       const int kb = side->kb;
 5714: 
 5715:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5716: 
 5717:       if (side->is2D()) {
 5718:          side->u2[kb + 1] = side->bcc[kb + 1];
 5719:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5720: 
 5721:       } else {
 5722:          // 3D
 5723:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5724:          
 5725:       }
 5726: 
 5727:    }
 5728: 
 5729: 
 5730:    __global__ void ul0UpdateZCoords(void) {
 5731:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5732:       
 5733:       NODE(node);      
 5734: 
 5735: 
 5736:       if (node->isDry2()) { 
 5737: 
 5738:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5739: 
 5740:          if constexpr(ivcor != 1) node->kb = 0;
 5741: 
 5742:       } else {
 5743: 
 5744:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5745:          node->updateKb();
 5746: 
 5747:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5748: 
 5749:       }
 5750: 
 5751:       // We use the temp.b field to store the previous state of isDry.
 5752:       node->tmp.b = node->isDry;
 5753: 
 5754:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5755:       node->isDry = true;
 5756: 
 5757:    }
 5758: 
 5759:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5760:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5761:    {
 5762:       ELEM(elem);
 5763: 
 5764:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5765: 
 5766:       Node *n1 = elem->nodes[0];
 5767:       Node *n2 = elem->nodes[1];
 5768:       Node *n3 = elem->nodes[2];  
 5769:       Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5770: 
 5771:       // All the nodes of a dry element are wet.
 5772:       if (!elem->isDry) {
 5773:          n1->isDry = false;
 5774:          n2->isDry = false;
 5775:          n3->isDry = false;
 5776:          if (elem->isQuad()) n4->isDry = false;
 5777: 
 5778: 
 5779:       }
 5780: 
 5781:       elem->kb = 0;
 5782: 
 5783:       if (elem->isDry) return;
 5784: 
 5785: 
 5786: 
 5787:    //    if(elem->isDry2()) { // XXXX
 5788:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5789:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5790:    //        call parallel_abort(errmsg)
 5791:    //    }
 5792: 
 5793: 
 5794:       // Computes element's kb as the minimum of the nodes' kb.
 5795:       const int kb1 = n1->kb;
 5796:       const int kb2 = n2->kb;
 5797:       const int kb3 = n3->kb;
 5798:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5799: 
 5800: 
 5801:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5802: 
 5803: 
 5804:       // Computes the element z as the mean of the nodes z.
 5805:       for (int k = elem->kb; k < nvrt; k++) {
 5806: 
 5807:          // Compute the element z as the mean of the nodes z.
 5808:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5809:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5810:          elem->z[k] /= elem->i34;
 5811: 
 5812:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5813:       }
 5814:                   
 5815:    }
 5816: 
 5817:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5818:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5819:    // node->tmp.b is true if the node was previously dry.
 5820:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5821:    {
 5822:       NODE(node);
 5823:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5824: 
 5825:       // Avoid this the first time step.
 5826:       if (it == iths) return;  
 5827: 
 5828:       
 5829:       // assert(node->isDry == node->isDry2() && "These two must be identical at this point"); XXXXX 
 5830:       if ((!node->isDry) && node->tmp.b) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5831: 
 5832:          for (int k=0; k < nvrt; k++) {
 5833: 
 5834:             Vector3 utmp={0.0, 0.0, 0.0};
 5835: 
 5836:             double ttmp=0.0;
 5837:             double stmp=0.0;
 5838:             int icount=0;
 5839:             for (int j = 0; j < node->numNodes; j++) {
 5840: 
 5841:                const Node *nbrNode = node->nodes[j];
 5842: 
 5843:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5844:                if (!nbrNode->tmp.b) { // Previously wet surrounding nodes
 5845: 
 5846:                   icount++;
 5847: 
 5848:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5849:                   utmp += nbrNode->uvw2(k);
 5850:                   
 5851:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5852:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5853:                }
 5854:             }
 5855: 
 5856:             if (icount > 0) {
 5857:                const double inv_icount = 1.0/icount;
 5858:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5859:                node->w2[k]     = inv_icount*utmp.z;
 5860:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5861:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5862:             }
 5863:             else {
 5864:                node->u2[k] = {0.0, 0.0};
 5865:                node->w2[k] = 0.0;
 5866:             }
 5867:          }
 5868:       }
 5869:    }
 5870: 
 5871:   
 5872:    
 5873: 
 5874: 
 5875:    __global__ void ul0UpdateSides(int it, int iths) {
 5876:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5877: 
 5878:       SIDE(side);
 5879: 
 5880:       // A side is wet if and only if at least one of its elements is wet.
 5881:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5882:  
 5883:       const Node *n1 = side->n1;
 5884:       const Node *n2 = side->n2;
 5885:      
 5886:       const int kb1 = n1->kb;
 5887:       const int kb2 = n2->kb;
 5888: 
 5889:       side->kb = 0; // dry
 5890: 
 5891:       if (isWet) {
 5892: 
 5893:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5894: 
 5895:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5896: 
 5897:          side->kb = min(kb1, kb2);
 5898: 
 5899:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5900: 
 5901:          for (int k = side->kb; k < nvrt; k++) {
 5902:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5903: 
 5904:          
 5905:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5906: 
 5907:             // Compute velocity for re-wetted sides 
 5908:             if ((it != iths) && (side->isDry && isWet)) {
 5909: 
 5910:                Vector2 utmp={0.0, 0.0};
 5911: 
 5912:                int icount=0;
 5913: 
 5914:                // For all the sides on the two elements that share this side
 5915:                for (int j = 0; j < 2; j++) {
 5916:                   const Element *elem = side->elems[j];
 5917:                   if (elem == nullptr) continue;
 5918: 
 5919:                   for (int jj=0; jj < elem->i34; jj++) {
 5920:                      const Side *nSide = elem->sides[jj];
 5921:                      if (nSide->isDry) continue;
 5922: 
 5923:                      icount++;
 5924:                      utmp += nSide->u2[k];  
 5925:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5926:                   }
 5927:                }
 5928:                   
 5929:                // assert(icount > 0 && "No wet sides around this side");  XXXXX RECOVER??? 
 5930:                if (icount > 0)  side->u2[k] = utmp/icount;
 5931:                else             side->u2[k] = {0.0, 0.0};
 5932:                   
 5933:             } // if ((it != iths) && (side->isDry && isWet))
 5934: 
 5935:          } // for k
 5936: 
 5937:       } // if isWet
 5938:    
 5939: 
 5940: 
 5941:    }
 5942: 
 5943:    __global__ void ul0UpdateSides2(void) {
 5944:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5945:    
 5946:          SIDE(side);
 5947:    
 5948:          // A side is wet if and only if at least one of its elements is wet.
 5949:          const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5950: 
 5951:          // Update the side's dryness
 5952:          side->isDry = !isWet;
 5953: 
 5954:    }
 5955: 
 5956: 
 5957:    __global__ void zeroNodalVelocities(void) {
 5958:       NODE(node);
 5959: 
 5960:       for (int k = 0; k < nvrt; k++) {
 5961:          node->u2[k]   = {0.0, 0.0};
 5962:          node->w2[k]   = 0.0;
 5963:          node->utmp[k] = {0.0, 0.0};
 5964:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5965:       }
 5966:    }
 5967: 
 5968:  
 5969: 
 5970:    __global__ void computeNodalVerticalVelocities1(void) {
 5971:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5972:    // Adds the element's vertical velocity times the element's area.
 5973:       ELEM(elem);
 5974: 
 5975:       for (int j = 0; j < elem->i34; j++) {
 5976:          Node *node = elem->nodes[j];
 5977: 
 5978:          for (int k = node->kb; k < nvrt; k++) {
 5979:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5980:          }
 5981:          atomicAdd(&(node->tmp.d), elem->area);
 5982:       }
 5983:    }
 5984: 
 5985:    __global__ void computeNodalVerticalVelocities2(void) {
 5986:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5987:    // Divides by the total area of the elements sharing the    node.
 5988:       NODE(node);
 5989: 
 5990:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5991: 
 5992:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 5993:    }
 5994: 
 5995: 
 5996:    __global__ void computeNodalHorizontalVelocities1(void) {
 5997:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5998:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5999: 
 6000:       ELEM(elem);
 6001: 
 6002:       if (elem->isDry) return;
 6003: 
 6004:       const int kb = elem->kb;
 6005:       const bool isTri = elem->isTri();
 6006: 
 6007:       if constexpr(indvel <= 0) {
 6008:          // Assuming discontinous hvel.
 6009: 
 6010:          if (isTri) { // For triangles
 6011:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6012:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6013: 
 6014:             for (int j = 0; j < 3; j++) {
 6015:                // For every node of the triangle...
 6016:                Node *node = elem->nodes[j];
 6017: 
 6018:                if (node->isDry) continue;
 6019: 
 6020:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6021:                const Side *s2 = elem->sides[(j + 1) % 3];
 6022:                const Side *s3 = elem->sides[(j + 2) % 3];
 6023: 
 6024: 
 6025:                atomicAdd(&(node->tmp.i), 1);
 6026: 
 6027:                for (int k = kb; k < nvrt; k++)  {
 6028:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at node j.   XXXX Function for clamping velocities. const vector2 u
 6029:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6030:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6031:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6032:                   atomicAdd(&(node->utmp[k].x), u.x);
 6033:                   atomicAdd(&(node->utmp[k].y), u.y);
 6034: 
 6035:                }
 6036: 
 6037:             }
 6038:          }
 6039:          else { // For quads
 6040:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6041: 
 6042:          }
 6043: 
 6044:       }
 6045:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6046:       
 6047:    }
 6048: 
 6049: 
 6050:    __global__ void computeNodalHorizontalVelocities2(void) {
 6051:       NODE(node);
 6052: 
 6053:       const int nodeCount = node->tmp.i;
 6054: 
 6055:       if (nodeCount == 0) 
 6056:       {
 6057:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6058:          return;
 6059:       }
 6060: 
 6061:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6062:       
 6063:       const int kb = node->kb;
 6064: 
 6065:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6066:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6067:       
 6068:       
 6069:    }   
 6070: 
 6071:  
 6072: 
 6073:    __global__ void resetVelocityOpenBndNodes(void) {
 6074:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6075: 
 6076:       NODE_BND(nodebnd);
 6077: 
 6078:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6079:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6080:       }
 6081: 
 6082:    }
 6083: 
 6084: 
 6085:    __global__ void setVelocityOpenBndNodes(void) {
 6086:    // For open boundary nodes sets their velocity to the imposed values.
 6087: 
 6088:       SIDE_BND(sidebnd);
 6089: 
 6090:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6091:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6092:          // to its segment to the average of the side velocity.
 6093: 
 6094:          for (int k = 0; k < nvrt; k++) {
 6095:             Node *n1 = sidebnd->side->n1;
 6096:             Node *n2 = sidebnd->side->n2;
 6097: 
 6098: 
 6099:             Vector2 n1_u2(n1->u2[k]);
 6100:             Vector2 n2_u2(n2->u2[k]);
 6101: 
 6102:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6103:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6104:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6105:             }
 6106:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6107:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6108:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6109:             }
 6110: 
 6111:          }
 6112: 
 6113:       }
 6114: 
 6115:    }
 6116: 
 6117: 
 6118:    __global__ void computeVerticalVelocity(void) {
 6119:       // Computes the vertical velocity at the (2D) element's centroid.
 6120:       // In this function we will be considering volumetric elements, with side faces and a 
 6121:       // bottom and a top face. We will call them SFs, BF and TF.
 6122:       // It computes the flux coming from BF and the SFs.
 6123:       // If the bed is moving, it takes that into account.
 6124:       // Since water is incompressible, the integral of the velocity times the normal vector
 6125:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6126:       // and the BF is equal to the flux going out from the TF.
 6127:       // TF = - BF - sum(SFs).
 6128:       // It then computes the horizontal velocity at the center of TF.
 6129:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6130:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6131:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6132: 
 6133:       ELEM(elem);
 6134: 
 6135:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6136: 
 6137:       if (elem->isDry) return;
 6138: 
 6139:       const int kb = elem->kb;
 6140:       const bool isTri = elem->isTri();
 6141: 
 6142:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6143: 
 6144:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6145:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6146:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6147: 
 6148:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6149: 
 6150:       double area3D;
 6151: 
 6152:       // Bottom face flux
 6153:       double bottomFlux = 0.0;
 6154:       Vector2 u2meanBottom = {0.0, 0.0};
 6155:       const Vector2 gradh = elem->grad2(&Node::depth);
 6156:       if constexpr(imm==2) {
 6157:          Vector3 ubed;
 6158: 
 6159:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6160:          // updateBDEF(ubed);
 6161:      
 6162:          // const double bflux0 = dot(ubed, elem_n1);
 6163: 
 6164:          // elem->w[kb] += ubed.z;
 6165:       }
 6166:       else {
 6167:          Vector2 umean;
 6168:          if constexpr(ics == 1) {
 6169:             u2meanBottom = elem->mean(kb, &Side::u2);
 6170:          }
 6171:          else {
 6172:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6173:          }
 6174: 
 6175:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6176:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6177: 
 6178:          bottomFlux = - dot(gradh, u2meanBottom);
 6179:       } // if imm
 6180: 
 6181:       // Compute w for kb+1 to nvrt-1
 6182:       for (int l = kb; l < nvrt - 1; l++) {
 6183: 
 6184:          // normal vector to the top face of the "volumetric" element (3D)
 6185:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6186: 
 6187:          // Compute the total flux at the sides
 6188:          double sideFlux = 0.0;
 6189: 
 6190:          for (int j = 0; j < elem->i34; j++) {
 6191:             const Side *side = elem->sides[j];
 6192: 
 6193:             const double sideArea = side->area(l);
 6194:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6195:             const double sign = elem->ssign[j]; 
 6196: 
 6197:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6198:          }
 6199:          
 6200:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6201:          //velocities at the centers of the sides
 6202:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6203: 
 6204:          // The flx at the top ace can be computed from the other flows.
 6205:          const double topFlux = - sideFlux - bottomFlux;
 6206:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6207: 
 6208:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6209: 
 6210:          elem_n1 = elem_n2;
 6211: 
 6212:          bottomFlux = - topFlux;
 6213:       }
 6214:    }  
 6215: 
 6216: 
 6217: 
 6218: 
 6219: 
