 1409:    // Pointers to each GPU's local memory (size is the number of partitions).
 1410:    Node**    nodes;  
 1411:    Element** elems;  
 1412:    Side**    sides;  
 1413:    
 1414:    // Local memory
 1415:    Node*    localNodeData; 
