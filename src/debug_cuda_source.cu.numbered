 2328: 
 2329: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2330: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2331: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2332: // Only when ics == 2, the origin is at the element center.
 2333: 
 2334:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2335: 
 2336:    const Node *node = nodes[idxNode];
 2337: 
 2338:    if constexpr(ics==1) {
 2339:       return node->p;
 2340: 
 2341:    } else {
 2342:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2343: 
 2344:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2345: 
 2346:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2347:    }
 2348: 
 2349: }
 2350: 
 2351: 
 2352: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2353: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2354: 
 2355:    const int id1 = idx;
 2356:    const int id2 = nxq(1 + id1);
 2357:    const int id3 = nxq(2 + id1);
 2358: 
 2359:    if constexpr(ics==1) {
 2360:       x0 = nodes[id1]->p;
 2361:       x1 = nodes[id2]->p;
 2362:       x2 = nodes[id3]->p;
 2363: 
 2364:    } else {
 2365:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2366: 
 2367:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2368:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2369:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2370: 
 2371:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2372:       x1 = toVector2(frame.G2L(p1 - c));
 2373:       x2 = toVector2(frame.G2L(p2 - c));
 2374: 
 2375:    }
 2376: 
 2377: }
 2378: 
 2379: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2380: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2381: 
 2382:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2383: 
 2384: 
 2385: 
 2386:    if constexpr(ics==1) {
 2387:       x0 = nodes[0]->p;
 2388:       x1 = nodes[1]->p;
 2389:       x2 = nodes[2]->p;  
 2390:       x3 = nodes[3]->p;
 2391: 
 2392:    } else {
 2393:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2394: 
 2395:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2396:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2397:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2398:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2399: 
 2400:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2401:       x1 = toVector2(frame.G2L(p1 - c));
 2402:       x2 = toVector2(frame.G2L(p2 - c));
 2403:       x3 = toVector2(frame.G2L(p3 - c));
 2404:    }
 2405: 
 2406: }
 2407: 
 2408: 
 2409: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2410: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2411: // Returns the normal vector and the area of the element at this level
 2412:    
 2413:    double nx, ny, nz;
 2414: 
 2415:    if (isTri()) {
 2416:       // For triangles...
 2417: 
 2418:       // Indices of the nodes at level k, taking care of not going below the bed
 2419:       const int k0 = max(k, nodes[0]->kb);
 2420:       const int k1 = max(k, nodes[1]->kb);
 2421:       const int k2 = max(k, nodes[2]->kb);
 2422: 
 2423:       // Gets the element frame coordinates of the nodes at level k
 2424:       Point3 x0, x1, x2;
 2425:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2426:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2427:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2428:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2429: 
 2430:       } else {  // ics == 2
 2431:          Point2 h0, h1, h2;
 2432: 
 2433:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2434: 
 2435:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2436:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2437:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2438:       }
 2439: 
 2440:       const Vector3 n20 = x2 - x0;
 2441:       const Vector3 n10 = x1 - x0; 
 2442: 
 2443:       // Computes the cross product of vectors n20 and n10. 
 2444:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2445:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2446:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2447: 
 2448:   
 2449:    }
 2450:    else {
 2451:       // For quads...
 2452:       Point2 h0, h1, h2, h3;
 2453: 
 2454:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2455: 
 2456:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2457:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2458:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2459:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2460: 
 2461:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2462:       nx = n20.y*n31.z - n20.z*n31.y;
 2463:       ny = n20.z*n31.x - n20.x*n31.z;
 2464:       nz = n20.x*n31.y - n20.y*n31.x;
 2465: 
 2466:    }
 2467: 
 2468:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2469:    area3D = 0.5*len;
 2470: 
 2471:    const double inv_len = 1.0/len;
 2472: 
 2473:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2474: 
 2475: }
 2476: 
 2477: 
 2478: // Helper functions to get the 2D local node position for the Celestial walk
 2479: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2480:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2481:    const Node *node = getNodeInOrder(idx2);
 2482: 
 2483:    double z = 0.0;
 2484:    if constexpr(ics == 2) z = node->gz;
 2485:    
 2486:    Point3 p = toPoint3(node->p, z);
 2487: 
 2488:    return toPoint2(origSide->toLocalFrame(p));
 2489: }
 2490: 
 2491: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2492:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2493: }
 2494: 
 2495: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2496:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2497: // Computes the three per-side predicates needed for the celestial walk
 2498: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2499: //
 2500: // xt is in local frame coordinates for origSide if ics == 2.
 2501: //
 2502: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2503: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2504: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2505: // meaningless on triangles are masked to a safe value (see comments below).
 2506: {
 2507:    // Project all 4 corner positions once into the local 2D frame.
 2508:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2509:    // getLocalNodePosition only transforms/projects if ics == 2.
 2510:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2511:                         getLocalNodePosition(1, origSide), 
 2512:                         getLocalNodePosition(2, origSide), 
 2513:                         getLocalNodePosition(3, origSide)};
 2514: 
 2515:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2516:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2517:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2518:    // But still farther towards the target point from the current point.
 2519:    const Vector2 vt0 = xt - x0;
 2520:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2521:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2522:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2523: 
 2524:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2525:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2526: 
 2527: 
 2528: // if (origSide->idx == 2860848 && jlev == 46) {
 2529: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2530: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2531: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2532: // }
 2533:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2534:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2535:    //  here the orientation is baked into the corners array.)
 2536:    const int i3 = nxq(3);
 2537:    const Vector2 s0 = C[ 1] - C[ 0];
 2538:    const Vector2 s1 = C[ 2] - C[ 1];
 2539:    const Vector2 s2 = C[i3] - C[ 2];
 2540:    const Vector2 s3 = C[ 0] - C[i3];
 2541:    
 2542:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2543:    // The corners array is built from getNode in CCW order, so the orientation
 2544:    // is already correct and no ssign factor is needed in the formulas below.
 2545:    //
 2546:    // i3 = nxq(3): the index of the corner after side 2.
 2547:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2548:    //   Quad:     i3 == 3.
 2549:    //
 2550:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2551:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2552:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2553:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2554:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2555:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2556: 
 2557: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2558: 
 2559:    // For triangles, the corner after side 2 is the closing corner where
 2560:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2561:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2562:    // s0 for triangles, s3 for quads.
 2563:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2564: 
 2565:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2566:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2567:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2568:    //
 2569:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2570:    // result is false naturally. No sentinel needed.
 2571:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2572:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2573:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2574:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2575: 
 2576:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2577:    // on the "exit through side I" half of the corner cone, separated by the
 2578:    // approximate angular bisector of the celestial walk. The bisector is
 2579:    // perpendicular to the chord across the corner; the test is the sign of
 2580:    // (xt - corner_vertex) projected onto that chord.
 2581:    //
 2582:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2583:    // (the validity rule sets valid_3 = false), so its computed value for
 2584:    // triangles doesn't matter. No sentinel needed.
 2585:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2586:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2587:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2588:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2589: 
 2590: }
 2591: 
 2592: 
 2593: __inline__ __device__ double Element::computeSignedArea(void) const {
 2594:    // Compute the area of the element
 2595: 
 2596:    Point2 x0, x1, x2, x3;
 2597:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2598: 
 2599:    double res = signedArea(x0, x1, x2);
 2600: 
 2601:    // In the quad case we need to add the area of the other triangle.
 2602:    if (isQuad()) {
 2603:       x3 = getLocalHorizontalNodePosition(3);
 2604:       double ar1 = signedArea(x0, x2, x3);
 2605:       double ar2 = signedArea(x0, x1, x3);
 2606:       double ar3 = signedArea(x1, x2, x3);
 2607:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2608: 
 2609:       res += ar1;
 2610: 
 2611:    }
 2612: 
 2613:    return res;
 2614: }
 2615: 
 2616: 
 2617: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2618:                                                                 (nodes[1]->isDry2()) ||
 2619:                                                                 (nodes[2]->isDry2()) ||
 2620:                                                                 (isQuad() && nodes[3]->isDry2());
 2621: }
 2622: 
 2623: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2624:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2625: }
 2626: 
 2627: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2628:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2629: }
 2630: 
 2631: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2632:    // In boundary sides, the element 1 is nullptr
 2633:    return side->elems[1] == nullptr; 
 2634: }
 2635: 
 2636: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2637:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2638:    // For ics == 2, this function uses local frame coordinates.
 2639: 
 2640:    assert(isQuad());
 2641: 
 2642:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2643:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2644:    // where vxi, veta, vb are vectors and c is the center of the element.
 2645: 
 2646:    Point2 p0, p1, p2, p3;
 2647: 
 2648:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2649: 
 2650:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2651:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2652:    // vectors vxi and veta connect the centers of opposite sides
 2653:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2654:    // vb is zero for parallelogram elements.
 2655:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2656: 
 2657:    //  The bilinear mapping is:
 2658:    //      P(s,t) = C + s*U + t*V + s*t*W
 2659:    //
 2660:    //  where:
 2661:    //    C = centroid (average of four vertices)
 2662:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2663:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2664:    //    W = bilinear correction; measures deviation from parallelogram
 2665:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2666:    //        W = 0 for parallelogram elements.
 2667:    //
 2668:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2669:    //
 2670:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2671:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2672:    //
 2673:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2674:    //
 2675:    //  Geometrically, (L) projects everything onto the direction
 2676:    //  perpendicular to W, where the mapping is purely affine.
 2677:    //
 2678:    //  The dot product with nb retains the nonlinear term:
 2679:    //
 2680:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2681:    //
 2682:    //  Geometrically, (Q) projects onto the W direction, where
 2683:    //  the nonlinearity lives.
 2684:    //
 2685:    //  We solve (L) for whichever variable has the larger coefficient
 2686:    //  (better conditioned back-substitution), substitute into (Q),
 2687:    //  and get a scalar quadratic in the other variable.
 2688:    // ================================================================
 2689: 
 2690:    // ---- Basis vectors ----
 2691:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2692:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2693:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2694:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2695:    // W: nonlinear correction. Difference between quad and parallelogram.
 2696:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2697:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2698: 
 2699:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2700:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2701:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2702:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2703:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2704: 
 2705:    // ---- nb: direction parallel to W, L1-normalized ----
 2706:    // We don't need a unit vector -- just a well-scaled direction parallel
 2707:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2708:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2709:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2710:    //
 2711:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2712:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2713:    // and the quadratic solver takes its linear path (a ~ 0).
 2714:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2715:    const double inv_wlen = 1.0 / wlen1;
 2716:    const Vector2 nb = vb * inv_wlen;
 2717: 
 2718:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2719:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2720:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2721:    // What remains is a pure affine relationship between xi and eta.
 2722:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2723:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2724:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2725: 
 2726:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2727:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2728:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2729:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2730:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2731:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2732:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2733: 
 2734:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2735:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2736:    // minimizing round-off amplification.
 2737:    //
 2738:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2739:    // that uses predicated moves.
 2740:    //
 2741:    // if (fabs(Ls) > fabs(Lt)) {
 2742:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2743:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2744:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2745:    //    const double A = -Qw * Lt;
 2746:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2747:    //    const double C =  Qs * Lp - Qp * Ls;
 2748: 
 2749:    //    double eta1, eta2;
 2750:    //    solveQuadratic(A, B, C, eta1, eta2);
 2751: 
 2752:    //    // Pick root with smaller |eta| (domain centered at 0).
 2753:    //    // Ternary-> predicated move, no branch divergence.
 2754:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2755: 
 2756:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2757:    //    xi = (Lp - Lt * eta) / Ls;
 2758: 
 2759:    // } else {
 2760:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2761:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2762:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2763:    //    const double A = -Qw * Ls;
 2764:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2765:    //    const double C =  Qt * Lp - Qp * Lt;
 2766: 
 2767:    //    double xi1, xi2;
 2768:    //    solveQuadratic(A, B, C, xi1, xi2);
 2769: 
 2770:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2771: 
 2772:    //    eta = (Lp - Ls * xi) / Lt;
 2773:    // }
 2774:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2775:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2776:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2777:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2778:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2779: 
 2780:    // Quadratic:  A*r^2 + B*r + C = 0
 2781:    // (same formula for both cases, just with swapped coefficients)
 2782:    const double A = -Qw * Lb;
 2783:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2784:    const double C =  Qa * Lp - Qp * La;
 2785: 
 2786:    double r1, r2;
 2787:    solveQuadratic(A, B, C, r1, r2);
 2788: 
 2789:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2790:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2791: 
 2792:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2793:    const double other = (Lp - Lb * r) / La;
 2794: 
 2795:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2796:    xi  = solve_s ? r     : other;
 2797:    eta = solve_s ? other : r;
 2798: 
 2799: 
 2800:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2801:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2802:    eta = fmin(1.0, fmax(eta, -1.0));
 2803: 
 2804:    // ---- Shape functions ----
 2805:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2806:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2807:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2808:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2809:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2810:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2811:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2812:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2813: 
 2814:    return true;
 2815: }
 2816: 
 2817: /**
 2818:    Compute the shape coordinates of the point (xt,yt) in the element.
 2819:    @param xt (input): x-coordinate of the point
 2820:    @param shpCoords (output): shape coordinates of the point
 2821:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2822:    @return true if the point is inside the element, false otherwise
 2823: **/
 2824: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2825: 
 2826:    // Compute the shape coordinates of the point xt in the element.
 2827:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2828:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2829:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2830:    // from the local frame, so use additional check.
 2831: 
 2832: 
 2833: 
 2834:    if (isTri()) { // Triangular element
 2835: 
 2836:       // Horizontal local node coordinates. 
 2837:       Point2 x0, x1, x2;
 2838:       getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2839: 
 2840: 
 2841:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2842:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2843:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2844:       shpCoords[3] = 0.0;
 2845: 
 2846: 
 2847:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2848:       const bool res = (tmpmin >= -small);  
 2849:       
 2850:       // When to fix the negative shape coordinates?
 2851:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2852: 
 2853:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2854:       // then we fix the negative shape coordinates.
 2855:       if ((tmpmin < 0) && fix) {
 2856: 
 2857:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2858:          // keeping the sum of the shape coordinates equal to 1.
 2859:          // I have tested and compared the new algorithm with the old one, and they give
 2860:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2861:          // The new algorithm should be faster since it is branchless.
 2862:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2863:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2864: 
 2865:          shpCoords[0] = (shpCoords[0] + a)*b;
 2866:          shpCoords[1] = (shpCoords[1] + a)*b;
 2867:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2868: 
 2869:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2870:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2871:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2872: 
 2873:          // Update the point coordinates for the new shape coordinates
 2874:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2875:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2876: 
 2877:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2878: 
 2879:       }
 2880: 
 2881:       // Return true if the point is inside the element
 2882:       return res;      
 2883:    }
 2884:    else {
 2885:       assert(isQuad() && "computeShapeCoords");
 2886: 
 2887:       // Horizontal local node coordinates. 
 2888:       Point2 x0, x1, x2, x3;
 2889:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 2890: 
 2891:       const double a0 = signedArea(x0, x1, xt);
 2892:       const double a1 = signedArea(x1, x2, xt);
 2893:       const double a2 = signedArea(x2, x3, xt);
 2894:       const double a3 = signedArea(x3, x0, xt);
 2895: 
 2896:       const double minArea = min4(a0, a1, a2, a3);
 2897:       
 2898:       const bool res = (minArea > -small*area);
 2899: 
 2900:       // When to fix the negative shape coordinates?
 2901:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2902: 
 2903:       double xi, eta;      
 2904:       inverseBilinearQuad(xt, xi, eta, shpCoords);
 2905: 
 2906:       if (fix) {
 2907:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2908:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2909:          xt.x = interpolate(shpCoords, xn);
 2910:          xt.y = interpolate(shpCoords, yn);
 2911:       }
 2912: 
 2913:       return res;
 2914:    }
 2915: 
 2916: 
 2917:    assert(false && "computeShapeCoords: should never reach this point");
 2918:    return false;  // Never reached
 2919: 
 2920: }
 2921: 
 2922: 
 2923: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2924: // Convert shape coordinates to cartesian coordinates
 2925: 
 2926:    if (isTri()) {
 2927:       // Triangular element
 2928: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 2929:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2930:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2931:    }
 2932:    else {
 2933:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2934:    }
 2935: 
 2936: }
 2937: 
 2938: 
 2939: 
 2940: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 2941:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 2942:    
 2943:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 2944: }
 2945: 
 2946: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 2947:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 2948:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 2949:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 2950:    return area * dot(gradPhi[i], gradPhi[j]);
 2951: }
 2952: 
 2953: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2954:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 2955:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2956:    // The formula for the integral is:
 2957:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2958:    
 2959:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 2960:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 2961:    const double eta_sum  = eta_n(i) + eta_n(j);
 2962:    const double xi_sum   = xi_n(i)  + xi_n(j);
 2963: 
 2964:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 2965:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 2966: 
 2967: 
 2968:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 2969: }
 2970:    
 2971: 
 2972: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2973:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2974:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2975:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2976:    // The formula is also based on the identity:
 2977:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2978:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2979: 
 2980:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 2981: 
 2982: 
 2983: 
 2984:    double res = 0.0;
 2985:    
 2986:    // Quadrature points in xi and eta coordinates
 2987:    #pragma unroll
 2988:    for (int i = 0; i < 4; i++) {
 2989:       // For each quadrature point...
 2990: 
 2991:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 2992:       const double eta = p.x;
 2993:       const double xi  = p.y;
 2994: 
 2995:       // Jacobian entries at the Gauss point p
 2996:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 2997:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 2998:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 2999:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3000: 
 3001:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3002:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3003: 
 3004:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3005:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3006:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3007:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3008:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3009: 
 3010:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3011:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3012:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3013:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3014:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3015: 
 3016:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3017:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3018:    }
 3019: 
 3020:    return res;
 3021: }
 3022: 
 3023: 
 3024: /**  Interpolate velocities at a given point (xt,yt,zt)
 3025: 
 3026:    @param xt, yt, zt: coordinates of the point to interpolate
 3027:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3028: 
 3029:    This is done in four steps:
 3030: 
 3031:    1. Find the shape coordinates for the final position in the element.
 3032:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3033:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3034:       z levels at xt, yt at each step.   
 3035:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3036:       horizontally and vertically.
 3037: **/
 3038: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3039:    // Interpolate the velocities at the point xt. 
 3040:    // This function works the same for triangular and quadrilateral elements.
 3041:    double shpCoord[4];
 3042:    Vector3 u_int;
 3043: 
 3044: 
 3045:    // First step is to compute the shape coordinates of (xt,yt)
 3046: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3047:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3048: 
 3049:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3050: 
 3051:    // Second step is to find the level that contains zt
 3052:    // Uses a binary search to find the level
 3053:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3054:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3055:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3056:    int R = nvrt - 1;
 3057: 
 3058:    // Get the z coordinates at the nodes of the element at the levels L and R
 3059:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3060:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3061:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3062: 
 3063: 
 3064:    double zL = interpolate(shpCoord, zLAtNodes);
 3065:    double zR = interpolate(shpCoord, zRAtNodes);
 3066: 
 3067:    // Interpolates vertically the velocities
 3068:    double wght1, wght2;
 3069:    if (xt.z <= zL) {
 3070:       wght1 = 1.0;
 3071:       wght2 = 0.0;
 3072:       xt.z = zL;
 3073:    }
 3074:    else if (xt.z >= zR) {
 3075:       wght1 = 0.0;
 3076:       wght2 = 1.0;
 3077:       xt.z = zR;
 3078:    }
 3079:    else {
 3080:       // Perform a binary search to find the levels between L and R that contain xt.z
 3081:       while (R - L > 1) {
 3082:          int M = (L + R) / 2.0;
 3083: 
 3084:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3085:          double zM = interpolate(shpCoord, zMAtNodes);
 3086:          if (zM < xt.z) 
 3087:          {
 3088:             L = M;
 3089:             zL = zM;
 3090:          }
 3091:          else 
 3092:          {
 3093:             R = M;
 3094:             zR = zM;
 3095:          }
 3096:       }
 3097:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3098:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3099: 
 3100:       wght2 = (xt.z - zL)/(zR - zL);
 3101:       wght1 = 1.0 - wght2;
 3102: 
 3103:    }
 3104: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3105: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3106:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3107:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3108:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3109:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3110: 
 3111:    // Project the velocity from the local frame to the origSide frame
 3112:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3113:    u_int = {uv.x, uv.y, w};
 3114: 
 3115:    // Neither of the interpolated velocities should be NaN
 3116:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3117: 
 3118:    return u_int;
 3119: 
 3120: }
 3121: 
 3122: 
 3123: 
 3124: 
 3125: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3126: 
 3127:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3128:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3129:    const Node *n1 = side->n1;
 3130:    const Node *n2 = side->n2;
 3131: 
 3132:    bool n1_match = (n1->nodeBnd->segment == segment);
 3133:    bool n2_match = (n2->nodeBnd->segment == segment);
 3134: 
 3135:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3136:    if (n1_match && n2_match) {
 3137:       return 0.5;
 3138:    } else if (n1_match) {
 3139:       return 1.0;
 3140:    } else if (n2_match) {
 3141:       return 0.0;
 3142:    }
 3143: 
 3144:    return 0.0;
 3145: }
 3146: 
 3147: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3148: 
 3149: 
 3150: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3151: 
 3152:    const double w1 = getBoundaryArrayValueWeight();
 3153:    const double w2 = 1.0 - w1;
 3154:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3155:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3156: 
 3157:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3158: }
 3159: 
 3160: 
 3161: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3162:    const double w1 = getBoundaryArrayValueWeight();
 3163:    const double w2 = 1.0 - w1;
 3164:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3165:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3166: 
 3167:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3168: 
 3169: }
 3170: 
 3171: 
 3172: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3173:    // Returns the value of the velocity at the side center
 3174:    const double w1 = getBoundaryArrayValueWeight();
 3175:    const double w2 = 1.0 - w1;
 3176:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3177:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3178: 
 3179:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3180: }
 3181: 
 3182: 
 3183: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3184:    // Returns the value of the normal component of the velocity at the side center
 3185:    const double w1 = getBoundaryArrayValueWeight();
 3186:    const double w2 = 1.0 - w1;
 3187:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3188:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3189: 
 3190:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3191: }
