 6860: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 6861: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
