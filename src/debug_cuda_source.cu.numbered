 8040: 
 8041:    __global__ void computeVerticalVelocity(void) {
 8042:       // Computes the vertical velocity at the (2D) element's centroid.
 8043:       // In this function we will be considering volumetric elements, with side faces and a 
 8044:       // bottom and a top face. We will call them SFs, BF and TF.
 8045:       // It computes the flux coming from BF and the SFs.
 8046:       // If the bed is moving, it takes that into account.
 8047:       // Since water is incompressible, the integral of the velocity times the normal vector
 8048:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8049:       // and the BF is equal to the flux going out from the TF.
 8050:       // TF = - BF - sum(SFs).
 8051:       // It then computes the horizontal velocity at the center of TF.
 8052:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8053:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8054:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8055: 
 8056:       ELEM(elem);
 8057: 
 8058:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8059: 
 8060:       if (elem->isDry) return;
 8061: 
 8062:       const int kb = elem->kb;
 8063:       const bool isTri = elem->isTri();
 8064: 
 8065:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8066: 
 8067:       // Compute the bottom velocity
 8068:       if constexpr(imm != 0) {
 8069:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8070:       }
 8071: 
 8072: 
 8073:       double bottomArea3D;
 8074:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8075: 
 8076:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8077: 
 8078:       double topArea3D;
 8079: 
 8080:       // Bottom face flux
 8081:       double bottomFlux = 0.0;
 8082:       Vector2 u2meanBottom = {0.0, 0.0};
 8083:       const Vector2 gradh = elem->grad2(&Node::depth);
 8084:       if constexpr(imm==2) {
 8085:          Vector3 ubed;
 8086: 
 8087:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8088:          // updateBDEF(ubed);
 8089:      
 8090:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8091: 
 8092:          // elem->w[kb] += ubed.z;
 8093:       }
 8094:       else {
 8095: 
 8096:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8097:   
 8098:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8099:          // in the direction of motion.
 8100:          const double bottomW = - dot(gradh, u2meanBottom);  
 8101:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8102: 
 8103:          // VElocity associated to the bed deformation
 8104:          double bedVelocity = 0.0;
 8105:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8106: 
 8107:          elem->w[kb] = bedVelocity + bottomW; 
 8108: 
 8109:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8110:          
 8111:       } // if imm
 8112: 
 8113:       // Compute w for kb+1 to nvrt-1
 8114:       for (int l = kb; l < nvrt - 1; l++) {
 8115: 
 8116:          // normal vector to the top face of the "volumetric" element (3D)
 8117:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8118: 
 8119:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8120:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8121: 
 8122:          // Compute the total flux at the sides
 8123:          double sideFlux = 0.0;
 8124: 
 8125:          for (int j = 0; j < elem->i34; j++) {
 8126:             const Side *side = elem->sides[j];
 8127:             const int kbs = side->kb;
 8128:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8129:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8130:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8131: 
 8132:             // The area is "clamped" meaning that it takes kb into account.
 8133:             const double sideArea = side->areaClamped(l);
 8134: 
 8135:             const double sign = elem->ssign[j]; 
 8136: 
 8137:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8138:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8139:          }
 8140:          
 8141:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8142:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8143:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8144: 
 8145:          // The flux at the top ace can be computed from the other flows.
 8146:          // All fluxes are in directions into the prism.
 8147:          const double topFlux = - sideFlux - bottomFlux;
 8148: 
 8149:          // Flux at the top face due to the horizontal velocities only
 8150:          // topFlux = topHorizontalFlux + topVerticalFlux
 8151:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8152: 
 8153:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8154:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8155: 
 8156:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8157: 
 8158:          bottomFlux = -topFlux;
 8159:          
 8160:       }
 8161: 
 8162:    }  
 8163: 
 8164: 
 8165: 
 8166: 
 8167: 
 8168: 
 8169: 
