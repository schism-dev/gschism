 2210: /**
 2211:  * This method performs backtracking from the side center until a time -dt back in time 
 2212:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2213:  * intermediate point.
 2214:  *
 2215:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2216:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2217:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2218:  * remaining time.
 2219:  * 
 2220:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2221:  * 
 2222:  * @param uuint, vvint, wwint: Velocities at the final point
 2223:  * @param jlev: Level at which the backtracking is performed
 2224:  * @param dt, dtbk: Tracking timesteps
 2225:  * @return: True if the backtracking was successful, false otherwise
 2226:  */
 2227: __inline__ __device__ bool Side::btrack(
 2228:       int jlev,
 2229:       double dt,            // Tracking time
 2230:       double dtbk,          // Tracking timestep
 2231:       Vector3 &u_int        // Velocities at the initial point
 2232: ) const {
 2233: 
 2234:    // Start from side center
 2235:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2236:  
 2237: 
 2238:    double time_rm = dt; // Remaining time
 2239: 
 2240: 
 2241:    // // Initialize outputs XXX
 2242:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2243:    //    sclr[i] = 0.0;
 2244:    // }
 2245: 
 2246: 
 2247:    // Initial velocities
 2248:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2249: 
 2250:    // Find the element that is in the direction opposite to the velocity
 2251:    Element* curElem = findElementTowards(toVector2(u_int));
 2252: 
 2253:    // If it starts at a boundary side, we should start with a velocity parallel to the side.
 2254:    if (curElem == nullptr) {
 2255:       // Make velocity parallel to the side
 2256:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2257:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2258:       curElem = otherElem(curElem);
 2259:       
 2260:    }
 2261: 
 2262: 
 2263: 
 2264:    const int MAX_ITERATIONS = 1000; 
 2265:    Element* nextElem = curElem;
 2266:    int iter = 0;
 2267:    while(true) {
 2268: 
 2269:       // Calculate timestep
 2270:       double dtb = min(dtbk, time_rm);
 2271: 
 2272:       // Next point in the backtracking curve
 2273:       Point3 xt = x0 - dtb*u_int;
 2274: 
 2275: 
 2276:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2277:       assert(found && "Backtracking failed in btrack");
 2278: 
 2279:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2280:                       // then time_rm needs to be increased by the unused time.
 2281:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2282: 
 2283:       // The current point becomes the next segment's starting point.
 2284:       x0 = xt;
 2285:  
 2286:       curElem = nextElem;
 2287: 
 2288:       iter++;
 2289:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2290:    }
 2291: 
 2292: 
 2293: }
 2294: 
 2295: 
