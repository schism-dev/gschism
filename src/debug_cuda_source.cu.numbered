 3847: __device__ __inline__ void Node::updateZCoordData(void) {
 3848: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3849: 
 3850:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3851:    // if (isDry2()) {
 3852:    //    kb = -1;  // XXXXXXXX KKKKK
 3853:    //    return;
 3854:    // }
 3855: 
 3856: 
 3857:    if constexpr(ivcor == 2) {  // SZ coordinates
 3858:       
 3859:       // Compute bottom level index
 3860:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3861:    } 
 3862:    else {  // if (ivcor == 1) Localized sigma
 3863:       // Do nothing
 3864:    }
 3865: 
 3866: 
 3867: }
