 4267:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4268: 
 4269:       NODE_BND(nodeBnd);
 4270: 
 4271:       Node *node = nodeBnd->node;
 4272: 
 4273:       node->ETP = 0.0;
 4274: 
 4275:       for (int j=0; j<ntip; j++) {
 4276: 
 4277:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4278:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4279:    
 4280:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4281: 
 4282:          if constexpr(iloadtide==1) { // loading tide
 4283:             assert(false && "Loading tide not implemented");
 4284:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4285:          }
 4286:          
 4287:       }
 4288:       
 4289:    }
