 3837:       // Computes the index in the nzz array
 3838: 
 3839:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3840: 
 3841:       indptr[idx] = nzzIdx;
 3842:       data[nzzIdx]    = (float)node->coeffDiag;
 3843:       indices[nzzIdx] = idx;
 3844: 
 3845:       for (int k = 0; k < node->numNodes; ++k) {
 3846:          const Node* nb = node->nodes[k];
 3847: 
 3848:          int j = nb->idx;
 3849:          // (optionally: if (j == i) data[diag_off] += nd.coeffMatrix[k]; else ...)
 3850:          data[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3851:          indices[nzzIdx + k + 1] = j;
 3852:       }
 3853: 
 3854:       diag[idx] = (float)(1.0/node->coeffDiag);
 3855:       b[idx] = (float)node->qel;
 3856:    }
 3857: }
