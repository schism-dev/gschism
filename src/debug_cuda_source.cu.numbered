 4585:       const int idx = node->idx;
 4586:       Vector2 wind = {xWind[idx], yWind[idx]};
 4587: 
 4588:       if constexpr(nws != 0 && iwindoff != 0) {
 4589:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 4590:       }
 4591: 
 4592:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 4593:       node->setWind(wind);
 4594: 
 4595:       node->pr = pressAir[idx];
 4596:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 4597: 
 4598:    }
