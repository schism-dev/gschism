 2094: /**
 2095:    Compute the shape coordinates of the point (xt,yt) in the element.
 2096:    @param xt (input): x-coordinate of the point
 2097:    @param shpCoords (output): shape coordinates of the point
 2098: **/
 2099: __device__ void Element::computeShapeCoords(Point2 &xt, ShapeCoords &shpCoords) const {
 2100: 
 2101:    // Compute the shape coordinates of the point xt in the element.
 2102:    if (i34==3) {
 2103:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2104:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2105:       // and in this case, the pt will be nudged into the element
 2106:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2107:       // from the local frame, so use additional check.
 2108: 
 2109:       Point2 x0, x1, x2;
 2110: 
 2111:       if constexpr(ics==1) {
 2112:          x0 = nodes[0]->p;
 2113:          x1 = nodes[1]->p;
 2114:          x2 = nodes[2]->p;
 2115:       }
 2116:       else // lat/lon
 2117:       {
 2118:          Error("Not implemented yet");
 2119:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2120:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2121:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2122:       }
 2123: 
 2124:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2125:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2126:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2127:       shpCoords[3] = 0.0;
 2128: 
 2129:    }
 2130:    else {
 2131:       Error("Not implemented yet");
 2132: #ifdef QUADS
 2133:       // Reproject pt in eframe of nel for ics=2
 2134:       if constexpr(ics==1) {
 2135:          xn2 = xt; 
 2136:          yn2 = yt;
 2137:       }
 2138:       else {
 2139:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2140:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2141:       }
 2142: 
 2143:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2144: #endif
 2145:    }
 2146: 
 2147: 
 2148: }
 2149: 
 2150: 
 2151: __device__ void Element::shapeCoordsToXY(ShapeCoords const &shpCoords, Vector2 &xt) const {
 2152: // Convert shape coordinates to cartesian coordinates
 2153: 
 2154:    assert(false && "shapeCoordsToXY: Not implemented, xt is not modified"); 
 2155:    if (i34 == 3) {
 2156:       // Triangular element
 2157:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2158:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2159:    }
 2160:    else {
 2161:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2162:    }
 2163: 
 2164: }
 2165: 
 2166: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2167:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2168:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2169:    // The formula for the integral is:
 2170:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2171: 
 2172:    printf("intPhiPhi: TEST\n");
 2173: 
 2174:    const Node *n0 = nodes[0];
 2175:    const Node *n1 = nodes[1];
 2176:    const Node *n2 = nodes[2];
 2177:    const Node *n3 = nodes[3];
 2178: 
 2179:    const Vector2 p0 = n0->p;
 2180:    const Vector2 p1 = n1->p;
 2181:    const Vector2 p2 = n2->p;
 2182:    const Vector2 p3 = n3->p;
 2183: 
 2184:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2185:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2186:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2187:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2188: 
 2189:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2190: }
 2191:    
 2192: 
 2193: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2194:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2195:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2196:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2197:    // The formula is also based on the identity:
 2198:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2199:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2200: 
 2201:    printf("intGradPhiGradPhi: TEST\n");   
 2202: 
 2203:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2204: 
 2205:    const double x0 = nodes[0]->p.x;
 2206:    const double y0 = nodes[0]->p.y;
 2207:    const double x1 = nodes[1]->p.x;
 2208:    const double y1 = nodes[1]->p.y;
 2209:    const double x2 = nodes[2]->p.x;
 2210:    const double y2 = nodes[2]->p.y;
 2211:    const double x3 = nodes[3]->p.x;
 2212:    const double y3 = nodes[3]->p.y;
 2213: 
 2214:    double res = 0.0;
 2215:    
 2216:    // Quadrature points in xi and eta coordinates
 2217:    #pragma unroll
 2218:    for (int i = 0; i < 4; i++) {
 2219:       // For each quadrature point...
 2220: 
 2221:       const Point2 p = GaussPoint(i);
 2222:       const double eta = p.x;
 2223:       const double xi  = p.y;
 2224: 
 2225:       // Jacobian entries at the Gauss point p
 2226:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2227:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2228:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2229:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2230: 
 2231:       const double detJ = jacobianDet(p);
 2232:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2233: 
 2234:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2235:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2236:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2237:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2238:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2239: 
 2240:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2241:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2242:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2243:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2244:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2245: 
 2246:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2247:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2248:    }
 2249: 
 2250:    return res;
 2251: }
 2252: 
 2253: 
 2254: /**  Interpolate velocities at a given point (xt,yt,zt)
 2255: 
 2256:    @param xt, yt, zt: coordinates of the point to interpolate
 2257:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2258: 
 2259:    This is done in four steps:
 2260: 
 2261:    1. Find the shape coordinates for the final position in the element.
 2262:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2263:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2264:       z levels at xt, yt at each step.   
 2265:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2266:       horizontally and vertically.
 2267: **/
 2268: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2269:    // Interpolate the velocities at the point xt. 
 2270:    // This function works the same for triangular and quadrilateral elements.
 2271:    ShapeCoords shpCoord;
 2272: 
 2273:    // First step is to compute the shape coordinates of (xt,yt)
 2274:    computeShapeCoords(toVector2(xt), shpCoord);
 2275: 
 2276: if ((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) < -small))   {
 2277:    printf("Invalid shape coordinates: shpCoord[0] = %f, shpCoord[1] = %f, shpCoord[2] = %f, shpCoord[3] = %f, xt = %f, yt = %f, zt = %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3], xt.x, xt.y, xt.z);
 2278:    return;
 2279: }
 2280:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2281: 
 2282:    // Second step is to find the level that contains zt
 2283:    // Uses a binary search to find the level
 2284:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2285:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2286:    int R = nvrt - 1;
 2287: 
 2288:    // Get the z coordinates at the nodes of the element at the levels L and R
 2289:    ShapeCoords zLAtNodes, zRAtNodes, zMAtNodes;
 2290:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2291:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2292: 
 2293:    double zL = interpolate(shpCoord, zLAtNodes);
 2294:    double zR = interpolate(shpCoord, zRAtNodes);
 2295:    
 2296:    // Interpolates vertically the velocities
 2297:    double wght1, wght2;
 2298:    if (xt.z<=zL) {
 2299:       wght1 = 1.0;
 2300:       wght2 = 0.0;
 2301:       xt.z = zL;
 2302:    }
 2303:    else if (xt.z>=zR) {
 2304:       wght1 = 0.0;
 2305:       wght2 = 1.0;
 2306:       xt.z = zR;
 2307:    }
 2308:    else {
 2309:       // Perform a binary search to find the levels between L and R that contain xt.z
 2310:       while (R - L > 1) {
 2311:          int M = (L + R) / 2.0;
 2312: 
 2313:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2314:          double zM = interpolate(shpCoord, zMAtNodes);
 2315:          if (zM < xt.z) 
 2316:          {
 2317:             L = M;
 2318:             zL = zM;
 2319:          }
 2320:          else 
 2321:          {
 2322:             R = M;
 2323:             zR = zM;
 2324:          }
 2325:       }
 2326:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2327:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2328: 
 2329:       wght2 = (xt.z - zL)/(zR - zL);
 2330:       wght1 = 1.0 - wght2;
 2331: 
 2332:    }
 2333: 
 2334: 
 2335:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2336:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2337: 
 2338: if (isnan(u_int.x) || isnan(u_int.y) || isnan(u_int.z))  {
 2339: printf("NaN velocities in interpolateVelocities: xt.z = %f, zL = %f, zR = %f, wght1 = %f, wght2 = %f, u_int = %f, %f, %f\n", xt.z, zL, zR, wght1, wght2, u_int.x, u_int.y, u_int.z);
 2340: u_int = {0.0, 0.0, 0.0};
 2341: return;
 2342: }
 2343:    // Neither of the interpolated velocities should be NaN
 2344:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2345: 
 2346: }
 2347: 
 2348: 
 2349: 
 2350: 
 2351: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2352: 
 2353:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2354:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2355:    const Node *n1 = side->n1;
 2356:    const Node *n2 = side->n2;
 2357: 
 2358:    bool n1_match = (n1->nodeBnd->segment == segment);
 2359:    bool n2_match = (n2->nodeBnd->segment == segment);
 2360: 
 2361:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2362:    if (n1_match && n2_match) {
 2363:       return 0.5;
 2364:    } else if (n1_match) {
 2365:       return 1.0;
 2366:    } else if (n2_match) {
 2367:       return 0.0;
 2368:    }
 2369: 
 2370:    return 0.0;
 2371: }
 2372: 
 2373: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2374: 
 2375: 
 2376: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2377: 
 2378:    const double w1 = getBoundaryArrayValueWeight();
 2379:    const double w2 = 1.0 - w1;
 2380:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2381:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2382: 
 2383:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2384: }
 2385: 
 2386: 
 2387: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2388:    const double w1 = getBoundaryArrayValueWeight();
 2389:    const double w2 = 1.0 - w1;
 2390:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2391:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2392: 
 2393:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2394: 
 2395: }
 2396: 
 2397: 
 2398: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2399:    // Returns the value of the velocity at the side center
 2400:    const double w1 = getBoundaryArrayValueWeight();
 2401:    const double w2 = 1.0 - w1;
 2402:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2403:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2404: 
 2405:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2406: }
 2407: 
 2408: 
 2409: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2410:    // Returns the value of the normal component of the velocity at the side center
 2411:    const double w1 = getBoundaryArrayValueWeight();
 2412:    const double w2 = 1.0 - w1;
 2413:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2414:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2415: 
 2416:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2417: }
 2418: 
 2419: 
 2420: 
 2421: __inline__ __device__ double  Side::x(double t, bool checkInterval)   const { assert(!checkInterval || (t >= 0.0 && t <= 1.0)); return (1-t)*n1->p.x + t*n2->p.x; }
 2422: __inline__ __device__ double  Side::y(double t, bool checkInterval)   const { assert(!checkInterval || (t >= 0.0 && t <= 1.0)); return (1-t)*n1->p.y + t*n2->p.y; }
 2423: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2424: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2425: __inline__ __device__ Point2  Side::p_t(double t, bool checkInterval) const { return {x(t, checkInterval), y(t, checkInterval)}; }
 2426: __inline__ __device__ Vector3 Side::interpolateCenterVelocityVertically(Point3 xt) const { 
 2427: // Interpolates the side's center vertically at point xt.
 2428: // 
 2429: // The horizontal velocity (u2) is stored at the side center, but the vertical velocity (w) 
 2430: // is stored at the nodes. Since vertical levels vary in space along the side, we use the 
 2431: // parametric position t of xt along the side to determine which vertical levels bracket 
 2432: // xt.z, then interpolate the center velocity between those levels.
 2433: //
 2434: // This is an approximation used only when backtracking slides along a side.
 2435: //
 2436: // @param xt: A point on the side (not necessarily at the center) whose z-coordinate 
 2437: //            determines the vertical interpolation level
 2438: // @return: Interpolated 3D velocity vector (u, v, w) at the side center at the vertical 
 2439: //          level corresponding to xt.z
 2440: 
 2441: 
 2442:    // Convert 2d coordinates to parametric coordinates on the side
 2443:    const double t = dot(toPoint2(xt) - n1->p, t12())/len;
 2444: 
 2445:    // Searches using binary search the vertical level that contains the z-coordinate of the point
 2446:    int L = kb;
 2447:    int R = nvrt - 1;
 2448:    while (R - L > 1) {
 2449:       int M = (L + R) / 2;
 2450:       const double z = (1 - t)*n1->z[M] + t*n2->z[M];
 2451:       if (z < xt.z) L = M;
 2452:       else R = M;
 2453:    }
 2454:    assert(L == R - 1 && "Binary search failed to find the vertical level containing zt");
 2455: 
 2456:    // Interpolates the center velocity at the relative distance of xt.z between the two levels L and R
 2457:    const double z1 = (1 - t)*n1->z[L] + t*n2->z[L];
 2458:    const double z2 = (1 - t)*n1->z[R] + t*n2->z[R];
 2459:    const double weight2 = (xt.z - z1)/(z2 - z1);
 2460:    const double weight1 = 1.0 - weight2;
 2461: 
 2462:    // Interpolate the horizontal velocity
 2463:    const Vector2 u = weight1*u2[L] + weight2*u2[R];
 2464: 
 2465:    // Interpolate the vertical velocity
 2466:    const double w1 = (1 - t)*n1->w2[L] + t*n2->w2[L];
 2467:    const double w2 = (1 - t)*n1->w2[R] + t*n2->w2[R];
 2468:    const double w = weight1*w1 + weight2*w2;
 2469: 
 2470:    return {u.x, u.y, w};
 2471: 
 2472: }
 2473: 
 2474: __forceinline__ __device__ bool Side::containsPoint(Vector2 x) const { 
 2475:    // Check if the point (x,y) is in the side, meaning that it includes points that are close to the side (within geometricEpsilon).
 2476: 
 2477:    const double t = length(x - n1->p)/len; // Parameterization of the point on the side (0 at n1, 1 at n2)
 2478:    return (t >= -2*geometricEpsilon) && (t <= 1.0 + 2*geometricEpsilon) && (abs(relativeSignedDistanceToPoint(x)) <= geometricEpsilon); 
 2479: }
 2480: 
 2481: 
 2482: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2483:    Vector2 grad = {0.0, 0.0};
 2484:    int count = 0;
 2485: 
 2486:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2487: 
 2488:    // First element
 2489:    if (elems[0] != nullptr && condition(elems[0])) {
 2490:       grad += elems[0]->grad2(field);
 2491:       count++;
 2492:    }
 2493: 
 2494:    // Second element
 2495:    if (elems[1] != nullptr && condition(elems[1])) {
 2496:       grad += elems[1]->grad2(field);
 2497:       count++;
 2498:    }
 2499: 
 2500:    if (count > 0) {
 2501:       grad = grad*(1.0/count);
 2502:    }
 2503:    
 2504:    return grad;
 2505: }
 2506: 
 2507: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2508: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2509: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2510: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2511: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2512: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2513: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2514: 
 2515: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2516: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2517: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2518: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2519: 
 2520: 
 2521: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2522: 
 2523: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2524: 
 2525: 
 2526: 
 2527: __inline__ __device__ void backtrackFromPoint(BTPoint &bkPoint, double dt, double dtbk);
 2528: 
 2529: 
 2530: /**
 2531:  * This method performs backtracking from the side center until a time -dt back in time 
 2532:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2533:  * intermediate point.
 2534:  *
 2535:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2536:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2537:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2538:  * remaining time.
 2539:  * 
 2540:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2541:  * 
 2542:  * @param uuint, vvint, wwint: Velocities at the final point
 2543:  * @param jlev: Level at which the backtracking is performed
 2544:  * @param dt, dtbk: Tracking timesteps
 2545:  * @return: backtracked velocity at the final point
 2546:  */
 2547: __inline__ __device__ Vector2 Side::btrack(
 2548:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2549:       double dt,            // Tracking time
 2550:       double dtbk           // Tracking timestep
 2551: ) const {
 2552: 
 2553:    // Start from side center
 2554:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2555: 
 2556:  
 2557:    double time_rm = dt; // Remaining time
 2558: 
 2559:    BTPoint btPoint(x0, BTPoint::BTPointType::btSide, this->elems[0], const_cast<Side*>(this));
 2560: 
 2561:    btPoint.u = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2562: 
 2563: if (btPoint.elem->idx == 56898) printf("6222 btPoint.elem = %p, btPoint.type = %d\n", btPoint.elem, btPoint.type);
 2564:    backtrackFromPoint(btPoint, dt, dtbk);
 2565: if (btPoint.elem->idx == 56898) printf("6333 btPoint.elem = %p, btPoint.type = %d\n", btPoint.elem, btPoint.type);
 2566: 
 2567:    return toVector2(btPoint.u);
 2568: 
 2569: }
 2570: 
 2571: 
 2572: __device__ void findNextPoint(BTPoint &curPoint, double dtbk);
 2573: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2); 
 2574: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(BTPoint &curPoint, Point3 &xt);
 2575: __device__ void DEAL_WITH_POINT_MOVING_ALONG_SIDE(BTPoint &curPoint, Point3 &xt);
 2576: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(BTPoint &curPoint, Point3 &xt);
 2577: 
 2578: extern "C" {
 2579:    __global__ void getLastBTPointState(
 2580:       int *elemIdx_out, int *sideIdx_out, int *nodeIdx_out, 
 2581:       int *type_out, int *iter_out) {
 2582:          
 2583:       *elemIdx_out = lastBTPoint_elemIdx;
 2584:       *sideIdx_out = lastBTPoint_sideIdx;
 2585:       *nodeIdx_out = lastBTPoint_nodeIdx;
 2586:       *type_out = lastBTPoint_type;
 2587:       *iter_out = crashIter;
 2588:    }
 2589: }
 2590: 
 2591: 
 2592: /**
 2593:  * This function performs backtracking from startPoint until a time -dt back in time from the current time. 
 2594:  * The backtracking is performed using the velocities (u,v,w) at each intermediate point (except at open and land boundaries)
 2595:  *
 2596:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2597:  * a maximum length of dtbk*vel_step, where vel_step is the module of the velocity at that step and dtbk is 
 2598:  * the timestep (of the backtracking). The actual length of the segment can be shorter if the backtracking intersects a side or a node.
 2599:  * 
 2600:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2601:  * 
 2602:  * @param startPoint: Starting point of the backtracking
 2603:  * @param klev: Level at which the backtracking is performed
 2604:  * @param dt: Tracking time
 2605:  * @param dtbk: Tracking timestep
 2606:  
 2607:  */
 2608:  __inline__ __device__ void backtrackFromPoint(BTPoint &bkPoint, double dt, double dtbk) {
 2609: 
 2610:    const int MAX_ITERATIONS = 1000; 
 2611: 
 2612:    double remainingTime = dt; 
 2613: 
 2614:    int iter = 0;
 2615: 
 2616:    while (remainingTime > 0.0) {
 2617:     
 2618:       
 2619:       iter++;
 2620: 
 2621:       // If the velocity is too small, we stop the backtracking
 2622:       if (length(bkPoint.u) <= velmin_btrack) break;
 2623:       
 2624:       assert(iter < MAX_ITERATIONS && "Max iterations reached in backtrackFromPoint");
 2625: 
 2626:       lastBTPoint_elemIdx = (bkPoint.elem != nullptr) ? bkPoint.elem->idx : -1;
 2627:       lastBTPoint_sideIdx = (bkPoint.side != nullptr) ? bkPoint.side->idx : -1;
 2628:       lastBTPoint_nodeIdx = (bkPoint.node != nullptr) ? bkPoint.node->idx : -1;
 2629:       lastBTPoint_type = (int)bkPoint.type;
 2630:       crashIter = iter;
 2631: 
 2632:       // Finds the next point in the backtracking curve. updates bkPoint.
 2633:       findNextPoint(bkPoint, min(dtbk, remainingTime));
 2634: 
 2635: 
 2636: 
 2637:       remainingTime -= bkPoint.dt;
 2638:    } 
 2639: 
 2640: }
 2641: 
 2642: /**
 2643:  * Finds the next point in the backtracking curve from the current point.
 2644:  * 
 2645:  * @param curPoint      Current backtracking point (input/output - will be updated to next point)
 2646:  * @param dtbk          Maximum timestep for this segment
 2647:  * 
 2648:  * The function handles three cases based on curPoint.type:
 2649:  * - btElement: Point is in element interior
 2650:  * - btSide: Point is on a side
 2651:  * - btNode: Point is at a node
 2652:  * 
 2653:  * The actual timestep may be less than dtbk if an intersection is found.
 2654:  *
 2655:  * For this algorithms, the interior of an element is defined as the 'skinny' element whose shape coordinates are larger than small. A point that is not in the interior
 2656:  * of an element is either outside the mesh, or on a side or node.
 2657:  */
 2658:  __device__ void findNextPoint(BTPoint &curPoint, double dtbk) {
 2659: 
 2660:    const Point3 x0 = curPoint.x;
 2661:    const Vector3 u = curPoint.u;
 2662:    
 2663:    // Calculate target point (backward in time)
 2664:    Point3 xt = x0 - dtbk*u;
 2665: // printf("ZZZZ curPoint.side = %p, curPoint.elem = %p, curPoint.node = %p, curPoint.type = %d\n", curPoint.side, curPoint.elem, curPoint.node, curPoint.type);
 2666:    // The current point always 'belongs' to an element (even if it is a node or a side, in which case it is one of the elements sharing the node or the side).
 2667:    // This element is used to interpolate the velocity.
 2668:    const Element *elem = curPoint.elem;  
 2669:    assert(elem != nullptr && "elem is nullptr in findNextPoint");
 2670: 
 2671:    curPoint.dt = dtbk;
 2672: 
 2673: // printf("BBBBB curPoint.type = %d, elem->idx = %d\n", curPoint.type, elem->idx);   
 2674:  
 2675:    // How the next point is found depends on the type of the current point:
 2676:    switch (curPoint.type) {
 2677:       
 2678:       case BTPoint::BTPointType::btElement: {  // Starting from element interior...
 2679:          
 2680: 
 2681:          // When starting from the interior of an element, the next point is either in the interior of the same element, or it will intersect a side or a node.
 2682: // printf("4 elem = %p\n", elem);      
 2683: ShapeCoords shpCoord;   
 2684: elem->computeShapeCoords(toVector2(xt), shpCoord); // XXXX
 2685: 
 2686:          // If the target point is still inside the 'skinny' element, the next point is in the element interior
 2687:          if (elem->containsPoint2(toPoint2(xt))) {
 2688:             // Still inside element -> next point is in element interior
 2689:             // In this case, the next point is in the interior of the same element.
 2690:             curPoint.x = xt;
 2691:             curPoint.dt = dtbk;
 2692:             // The rest of fields of curPoint do not change in this case (except for u, which is computed at the end)
 2693:             addDebugPlot(x0, xt, 0xDF401F, '+');            
 2694: 
 2695:          } else {
 2696:             // Target point is outside -> An intersection with element boundary is *guaranteed*.
 2697:             // In this case, the next point is on a side or a node.
 2698: printf("AAxxA3\n");            
 2699:             DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, nullptr, nullptr);
 2700: printf("AAxxA4  elem->idx = %d\n", curPoint.elem->idx);            
 2701:             addDebugPlot(x0, xt, 0x1FF01F, 'o');            
 2702:  
 2703:          }
 2704: 
 2705: 
 2706:       }
 2707: 
 2708:       break;
 2709:       
 2710: 
 2711:       case BTPoint::BTPointType::btSide: {  // Starting from a side...
 2712:       
 2713:   
 2714:          // In this case there are four main possibilities:
 2715:          // - xt is in the interior of one of the elements sharing the side.
 2716:          // - x0xt intersects the sides of one of the elements sharing the side (not including the shared side).
 2717:          // - x0xt is collinear with the shared side.
 2718:          // - xt is outside the mesh.
 2719: 
 2720:          const Side *side = curPoint.side;
 2721: 
 2722:          assert(!(side->isDry) && "Side is dry");
 2723: 
 2724:          Element *e1 = side->elems[0];
 2725:          Element *e2 = side->elems[1];
 2726: 
 2727:          assert((e1 != nullptr && !e1->isDry) || (e2 != nullptr && !e2->isDry) && "Side has no wet elements");
 2728: 
 2729:          // e2 can be nullptr if the side is a boundary side.
 2730:          const bool isInsideE1 =  e1 != nullptr && !e1->isDry && e1->containsPoint2(toPoint2(xt));
 2731:          const bool isInsideE2 = (e2 != nullptr && !e2->isDry && !isInsideE1) ? e2->containsPoint2(toPoint2(xt)) : false;
 2732:               
 2733:          
 2734: 
 2735:          // Check if it is inside one of the elements
 2736:          if (isInsideE1 || isInsideE2) {
 2737:             // If it is inside one of the elements, the next point is in the interior of an element.
 2738:             
 2739:             Element *nextElem = isInsideE1?e1:e2;
 2740: 
 2741:             assert(!(nextElem->isDry) && "Element is dry"); // XXXX 
 2742:             // The new current point will be the target point
 2743:             curPoint.x = xt;
 2744:             curPoint.type = BTPoint::BTPointType::btElement;
 2745:             curPoint.elem = nextElem;
 2746: assert(nextElem!=nullptr && !nextElem->isDry && "EEEE3");
 2747:             curPoint.side = nullptr;
 2748:             curPoint.node = nullptr;
 2749:             curPoint.t = 0.0; 
 2750:             curPoint.dt = dtbk;
 2751: 
 2752:          } else {  // Point xt is not inside one of the elements sharing the side...
 2753: 
 2754:             // The element is either along the current side or intersects the sides of one of the elements sharing the side.
 2755: 
 2756:             // Checks if x0xt is collinear with the side in a consistent way.
 2757:             const double lenSide = side->len;
 2758:             const Vector2 v2 = toPoint2(xt) - toPoint2(x0);
 2759:             const double lenX0Xt = length(v2);
 2760:             bool isAlongSide = false;
 2761: 
 2762:             if (lenSide > lenX0Xt) { // if x0xt is shorter than the side...
 2763:                isAlongSide = side->containsPoint(toPoint2(xt));
 2764:             }
 2765:             else { // if x0xt is longer than the side...
 2766:                // Computes a smaller collinear segment that starts at x0 and has length lenSide. The end point of this segment must be on the side.
 2767:                const Point2 xtmp = toPoint2(x0) + v2*lenSide/lenX0Xt;
 2768:                isAlongSide = side->containsPoint(xtmp);
 2769: 
 2770:             }
 2771: 
 2772:             if (isAlongSide) {
 2773:                // x0xt is contained in the same side x0 is on.
 2774:                DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 2775: 
 2776: addDebugPlot(x0, curPoint.x, 0x1FF01F, '+');
 2777:             } else {
 2778: 
 2779:                // Gets the element that is in the direction opposite to the velocity vector (remember that we are backtracking)
 2780:                Element *nextElem = side->findElementTowards(toVector2(u));
 2781:              
 2782:                
 2783: 
 2784:                if (nextElem == nullptr || nextElem->isDry) {
 2785:                   // The segment goes out of water.
 2786:                   DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(curPoint, xt);
 2787:                   
 2788:                } else {
 2789:                   // x0xt intersects another side of the element.
 2790:                   
 2791:                   curPoint.elem = nextElem;
 2792:                   assert(curPoint.elem != nullptr && "curPoint.elem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2793: 
 2794:                   // This is a situation we know how to handle. 
 2795:                   printf("DDD2, nextElem = %p, nextElem->isDry = %d\n", nextElem, nextElem->isDry);                              
 2796:                   DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, side, nullptr);
 2797:                   printf("DDD3\n");
 2798:                }
 2799: 
 2800:             }
 2801:          
 2802:          }
 2803: 
 2804:       }
 2805: 
 2806: addDebugPlot(x0, xt, 0x4FD01F, '+');        
 2807: 
 2808:       break;
 2809:       
 2810:       case BTPoint::BTPointType::btNode: {  // Starting from a node...
 2811: 
 2812:          const Node *node = curPoint.node;
 2813: 
 2814:          printf("btNode, node = %p\n", node);         
 2815:          
 2816:          // Check if the xt is inside one of the elements sharing the node
 2817:          for (int i = 0; i < node->numElements; i++) {
 2818:             Element *e = node->elements[i];
 2819: 
 2820:             
 2821:             if (e->containsSegment(node, toPoint2(xt))) {
 2822:                // This means that x0xt is contained in the element (in the sense that the wedge formed by the node and its adjacent sides includes the segment x0xt). 
 2823:                // This is in a 'fat' sense, meaning that it covers the cases where x0xt is actually along one of these sides.
 2824: 
 2825:                
 2826:                if (e->isDry) {
 2827: printf("AAA1, curPoint.elem = %p, e = %p, curPoint.elem->isDry = %d\n", curPoint.elem, e, curPoint.elem->isDry);                  
 2828:                   DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(curPoint, xt);
 2829:                   return;
 2830: 
 2831:                }
 2832: 
 2833:                if (e->containsPoint2(toPoint2(xt))) {
 2834:                   // xt is contained in the element
 2835:                   curPoint.x = xt;
 2836:                   curPoint.dt = dtbk;
 2837:                   curPoint.type = BTPoint::BTPointType::btElement;
 2838:                   curPoint.elem = e;
 2839: assert(e !=nullptr && !e->isDry && "EEEE1");                  
 2840:                   curPoint.side = nullptr;
 2841:                   curPoint.node = nullptr;
 2842:                   return;
 2843: 
 2844:                } else {
 2845:                   // xt must intersect one of the opposite sides of the element
 2846:                   int idxSide1, idxSide2;
 2847:                   e->getSidesContainingNode(node, idxSide1, idxSide2);
 2848:                   const Side *side1 = e->sides[idxSide1];
 2849:                   const Side *side2 = e->sides[idxSide2];
 2850:                   curPoint.elem = e;
 2851: assert(e !=nullptr && !e->isDry && "EEEE2");
 2852:                   printf("DDD3a\n");                              
 2853:                   DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, side1, side2);
 2854:                   printf("DDD3b\n");                              
 2855:                   return;
 2856:                }
 2857:                   
 2858:             } 
 2859:             
 2860: 
 2861:          } 
 2862: printf("AAA2aaaa\n");         
 2863: if (curPoint.node != nullptr) printf("AAA2 curPoint.node.idx = %d, node.p = %.17f, %.17f\n", curPoint.node->idx, curPoint.node->p.x, curPoint.node->p.y);                  
 2864: else printf("AAA2 curPoint.node = nullptr\n");                  
 2865:          // computes the maximal contiguous block of wet elements containing curPoint.elem.
 2866:          DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(curPoint, xt);    
 2867:          
 2868:       }
 2869: 
 2870:    } // switch
 2871: // if (curPoint.elem == 0) curPoint.elem = curPoint.side->elems[0];
 2872: // if (curPoint.side != nullptr && curPoint.side->idx == 5) printf("6 curPoint.type = %d, curPoint.elem = %p\n", curPoint.type, curPoint.elem);
 2873: if (curPoint.elem->idx == 16191) printf("6 curPoint.elem = %p, type = %d, dtbk = %.17f, curPoint.elem = %p, curPoint.side = %p\n", curPoint.elem, curPoint.type, curPoint.dt, curPoint.elem, curPoint.side);
 2874: if (curPoint.elem == nullptr) printf("XXXXXXXXXXXXX curPoint.side = %p\n", curPoint.side);
 2875:    // Interpolates the velocities at the next point
 2876:    assert(curPoint.elem != nullptr && "curPoint.elem is nullptr");
 2877:    curPoint.elem->interpolateVelocities(curPoint.x, curPoint.u);
 2878: if (curPoint.elem->idx == 16191) printf("6222 curPoint.elem = %p, type = %d\n", curPoint.elem, curPoint.type);
 2879: }
 2880: 
 2881: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2) {
 2882:    // This function deals with the case where the segment x0xt intersects a side of the element that is not one of the two sides to exclude.
 2883: 
 2884:    Side *intersectSide = nullptr;
 2885:    Element *nextElem = nullptr;
 2886:    double t, tIntersect;
 2887: 
 2888:    const Point2 x1 = toPoint2(curPoint.x);
 2889:    const Point2 x2 = toPoint2(xt);
 2890:    const Element *elem = curPoint.elem;
 2891: 
 2892:    assert(elem != nullptr && "elem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2893: 
 2894:    // assert( elem->containsPoint2(x1) && "Starting point is not inside the element");                                    
 2895:    assert(!elem->containsPoint2(x2) && "Ending point is not outside the element");
 2896: 
 2897:    double closest_intersect_t = 1e10;
 2898:    bool found_intersection = false;
 2899:    double tt1, tt2, last_tt2 = 77777777.0;
 2900:    for (int i = 0; i < elem->i34; i++) {
 2901: 
 2902:       Side *side = elem->sides[i];
 2903: 
 2904:       if (excludeSide1 == side || excludeSide2 == side) continue;
 2905: 
 2906:       // (x3,y3)-(x4,y4) is the element side line
 2907:       const Point2 x3 = side->n1->p;
 2908:       const Point2 x4 = side->n2->p;
 2909: 
 2910:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2911:       const double delta = cross(x2 - x1, x3 - x4);
 2912: 
 2913:       if (abs(delta) > 0) {
 2914: 
 2915:          const double delta1 = cross(x3 - x1, x3 - x4);
 2916:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2917: 
 2918:          // Solves the two linear equations for tt1 and tt2
 2919:          tt1 = delta1/delta; // delta is not zero, so we can divide
 2920:          tt2 = delta2/delta;
 2921: 
 2922:          // Computes a distance to interval [0,1]
 2923:          const double distTo01 = max3(0.0, -tt1, tt1 - 1.0);
 2924: 
 2925:          if (closest_intersect_t > distTo01) {
 2926:             intersectSide = side;
 2927:             closest_intersect_t = distTo01;
 2928:             nextElem = side->otherElem(elem);
 2929:             found_intersection = true;
 2930:             last_tt2 = tt2;
 2931:          }
 2932: 
 2933:       }
 2934: 
 2935:    } // for
 2936: 
 2937:    assert(found_intersection && "No intersection found");
 2938: 
 2939:    if (nextElem == nullptr) printf("LLLL intersectSide->elems[0]->isDry = %d\n", intersectSide->elems[0]->isDry);
 2940:    if (nextElem == nullptr && intersectSide->elems[1] != nullptr) printf("LLLL intersectSide->elems[1]->isDry = %d\n", intersectSide->elems[1]->isDry);
 2941:    if (nextElem == nullptr) nextElem = intersectSide->elems[0];  // elems[0] is never nullptr. This is done in case the element is not set yet.
 2942:    printf("LLLL nextElem = %p, intersectSide = %p\n", nextElem, intersectSide);
 2943:    
 2944: 
 2945:    if (last_tt2 < geometricEpsilon) {
 2946:       curPoint.type = BTPoint::BTPointType::btNode;
 2947:       curPoint.node = intersectSide->n1;
 2948:       curPoint.side = intersectSide;
 2949:       curPoint.t = 0.0; 
 2950: 
 2951:    }
 2952:    else if (last_tt2 > 1.0 - geometricEpsilon) {
 2953:       curPoint.type = BTPoint::BTPointType::btNode;
 2954:       curPoint.node = intersectSide->n2;
 2955:       curPoint.side = intersectSide;
 2956:       curPoint.t = 1.0; 
 2957:       
 2958:    }
 2959:    else {
 2960:       curPoint.type = BTPoint::BTPointType::btSide;
 2961:       curPoint.side = intersectSide;
 2962:       curPoint.node = nullptr;
 2963:       curPoint.t = last_tt2;
 2964:    }
 2965: 
 2966:    curPoint.elem = nextElem;
 2967:    curPoint.dt = curPoint.dt*closest_intersect_t;
 2968:    toPoint2(curPoint.x) = intersectSide->p_t(curPoint.t);
 2969:    curPoint.x.z = (1.0 - closest_intersect_t)*curPoint.x.z + closest_intersect_t*xt.z;
 2970: printf("YYY t=%.17f\n", curPoint.t);
 2971: 
 2972: }
 2973:  
 2974: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(BTPoint &curPoint, Point3 &xt) {
 2975: // This function deals with the case where the point is moving outside the side. In other words, the point is in a side and it is moving out of the mesh or into a dry element.
 2976: // This is one of the cases where sliding along a side happens.
 2977: 
 2978:    // Instead of the interpolated velocity, we use the tangent of the velocity *at the side center* as the velocity of the point. 
 2979: 
 2980:    const Side *side = curPoint.side;
 2981: // // Debug: Check assertion conditions
 2982: // const bool isBnd = side->isBnd();
 2983: // Element *otherElem = side->otherElem(curPoint.elem);
 2984: // const bool otherIsDry = (otherElem != nullptr) ? otherElem->isDry : false;
 2985: // const bool curElemIsDry = (curPoint.elem != nullptr) ? curPoint.elem->isDry : true;
 2986:   
 2987: //   printf("DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE: side->idx = %d, side->isBnd() = %d, curPoint.elem = %p, curPoint.elem->isDry = %d, otherElem = %p, otherElem->isDry = %d, assertion = %d\n",
 2988: //          side->idx, isBnd, curPoint.elem, curElemIsDry, otherElem, otherIsDry, (isBnd || otherIsDry));
 2989: 
 2990: //    // We start with a point on the side and it is moving along it. First we check that it is a side in a boundary.
 2991: //    assert(side->isBnd() || side->otherElem(curPoint.elem)->isDry && "Side is not a boundary between wet and dry elements (or boundary side)");
 2992: 
 2993:    const Vector2 tangent = side->t12();
 2994: 
 2995:    // In this case, the particle slides along the side. The next point is calculated using the tangent component of the side velocity.
 2996:    const Vector3 uSide = side->interpolateCenterVelocityVertically(xt);
 2997:    toVector2(curPoint.u) = dot(toVector2(uSide), tangent)*tangent;
 2998:    curPoint.u.z = uSide.z;
 2999: 
 3000:    // Computes the new location of the point sliding along the side. The z-coordinate is not changed because curPoint.u.z is also unchanged.
 3001:    xt = curPoint.x - curPoint.dt*curPoint.u;   
 3002: 
 3003:    // This is a situation we know how to handle. A point that is moving along a side.
 3004:    DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3005: 
 3006: }
 3007: 
 3008: __device__ void DEAL_WITH_POINT_MOVING_ALONG_SIDE(BTPoint &curPoint, Point3 &xt) {
 3009:    // This function deals with the case where the point is moving along a side.
 3010: 
 3011:    Side *side = curPoint.side;
 3012:    const Point3 x0 = curPoint.x;
 3013:    const Vector2 tangent = side->t12();
 3014:    const double len = length(toPoint2(xt) - toPoint2(x0));
 3015: 
 3016:    const double t = dot(toPoint2(xt) - side->n1->p, tangent)/side->len;  // Parameterization of the location of the point on the side (0 at n1, 1 at n2)
 3017: 
 3018:    if (curPoint.elem == nullptr) curPoint.elem = side->elems[0];  // elems[0] is never nullptr. This is done in case the element is not set yet.
 3019: assert(side->elems[0] != nullptr && "side->elems[0] is nullptr");
 3020: // if (side->elems[0] != nullptr) printf("PPPP side->elems[0]->isDry = %d\n", side->elems[0]->isDry);
 3021: // if (side->elems[1] != nullptr) printf("PPPP2 side->elems[1]->isDry = %d\n", side->elems[1]->isDry);
 3022: 
 3023:    if (t < geometricEpsilon) {
 3024:       // The point is at a node.
 3025:       curPoint.type = BTPoint::BTPointType::btNode;
 3026:       curPoint.node = side->n1;
 3027:       curPoint.side = side;
 3028:       curPoint.t = 0.0; // Not really needed.
 3029: 
 3030:       
 3031:    }
 3032:    else if (t > 1.0 - geometricEpsilon) {
 3033:       // The point is at a node.
 3034:       curPoint.type = BTPoint::BTPointType::btNode;
 3035:       curPoint.node = side->n2;
 3036:       curPoint.side = side;
 3037:       curPoint.t = 1.0; 
 3038: 
 3039:    }
 3040:    else {
 3041:       // The point is along the side.
 3042:       curPoint.type = BTPoint::BTPointType::btSide;
 3043:       curPoint.node = nullptr;
 3044:       curPoint.side = side;
 3045:       curPoint.t = t;
 3046:       
 3047:    }
 3048: if (curPoint.t != t) printf("YYY2 curPoint.t=%.17f, t=%.17f\n", curPoint.t, t);
 3049:    toPoint2(curPoint.x) = side->p_t(curPoint.t);
 3050: 
 3051:    // Computes the fraction between the lenth it should have traveled if the side was infinite and
 3052:    // the actual length it has traveled.
 3053:    const double lenOrig  = length(side->p_t(t, false) - toPoint2(x0));
 3054:    const double lenFinal = length(toPoint2(curPoint.x) - toPoint2(x0));
 3055:    const double fractionOfLength = lenFinal/lenOrig;
 3056:   
 3057:    curPoint.x.z = (1.0 - fractionOfLength)*x0.z + fractionOfLength*xt.z;   
 3058:    curPoint.dt = curPoint.dt*fractionOfLength; 
 3059: 
 3060: addDebugPlot(x0, curPoint.x, 0xFF010F, 'x');
 3061: }
 3062: 
 3063: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(BTPoint &curPoint, Point3 &xt) {
 3064: // This function deals with the case where the point is moving outside from a node. In other words, the point is in a node and it is moving out of the mesh or into a dry element.
 3065: 
 3066:    const Element *elem = curPoint.elem;
 3067:    const Node *node    = curPoint.node;
 3068:    const Point3 x0     = curPoint.x;
 3069: 
 3070:    // computes the sides that delimit the contiguous block of wet elements containing elem
 3071: 
 3072:    assert(elem != nullptr && "elem is nullptr");
 3073:    assert(!elem->isDry && "elem is dry");
 3074:    assert(node != nullptr && "node cannot be nullptr");
 3075: 
 3076:    const int numSides = node->numSides;
 3077: 
 3078:    int idxStartWet = 0;      // First wet side index
 3079:    int idxEndWet = numSides; // Last wet side index
 3080: 
 3081:    // Finds the first wet side index
 3082:    for (int i = 0; i < numSides; i++) {
 3083:       const int prevIdx = (i + numSides - 1) % numSides;
 3084: 
 3085:       if (node->sides[prevIdx]->isDry && !node->sides[i]->isDry) idxStartWet = i;
 3086: 
 3087:       if (elem->containsSide(node->sides[i])) break;
 3088:    }
 3089: 
 3090:    // Finds the last wet side index
 3091:    for (int i = numSides - 1; i >= 0; i--) {
 3092:       const int nextIdx = (i + 1) % numSides;
 3093: 
 3094:       if (node->sides[nextIdx]->isDry && !node->sides[i]->isDry) idxEndWet = i;
 3095: 
 3096:       if (elem->containsSide(node->sides[i])) break;
 3097:    }
 3098: 
 3099:    // At this point idxStartWet and idxEndWet are the indices of the first and last wet sides in the contiguous block of wet sides containing elem.
 3100:    // If idxStartWet == 0 and idxEndWet == numSides - 1, all the sides are wet. This is only possible if the node is a boundary node.
 3101: 
 3102:    // These two sides are the ones that delimit the contiguous block of wet sides containing elem.
 3103:    Side *s1 = node->sides[idxStartWet];
 3104:    Side *s2 = node->sides[idxEndWet];
 3105: 
 3106:    assert(idxStartWet != 0 || idxEndWet != numSides - 1 || s1->sideBnd != nullptr || s2->sideBnd != nullptr && "Node is not a boundary node");
 3107: 
 3108:    // Now, there are two possibilities: 
 3109:    // - If any (or both) side velocities point away from the node, the point will slide along the side with the highest velocity component pointing away from the node.
 3110:    // - If both side velocities point towards the node, This is considered a death trap and the algorithm will stop here.
 3111:    const Vector3 uSide1 = s1->interpolateCenterVelocityVertically(xt);
 3112:    const Vector3 uSide2 = s2->interpolateCenterVelocityVertically(xt);
 3113:    const double u1tan = dot(toVector2(uSide1), s1->t(node));  // s1->t(node) is the unitary tangent vector to the side s1 pointing towards 'node'.
 3114:    const double u2tan = dot(toVector2(uSide2), s2->t(node));  // s2->t(node) is the unitary tangent vector to the side s2 pointing towards 'node'.
 3115: 
 3116:    if (u1tan < 0.0 || u2tan < 0.0) {
 3117:       // The point will slide along the side with the highest velocity component pointing away from the node.
 3118:       if (u1tan < u2tan) {
 3119:          // sliding along s1
 3120:          toVector2(curPoint.u) = u1tan * s1->t(node);
 3121:          curPoint.u.z = uSide1.z;
 3122:          xt = x0 - curPoint.dt*curPoint.u;
 3123:          curPoint.side = s1;
 3124: 
 3125:          // Once xt and curPoint.u are updated to slide along s1, we can call the function to deal with the case where the point is moving along a side.
 3126:          DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3127:       }
 3128:       else {
 3129:          // sliding along s2
 3130:          toVector2(curPoint.u) = u2tan * s2->t(node);
 3131:          curPoint.u.z = uSide2.z;
 3132:          xt = x0 - curPoint.dt*curPoint.u;
 3133:          curPoint.side = s2;
 3134: 
 3135:          // Once xt and curPoint.u are updated to slide along s2, we can call the function to deal with the case where the point is moving along a side.
 3136:          DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3137:       }
 3138: 
 3139: 
 3140:       return;
 3141:    }
 3142:    else
 3143:    {
 3144:       // DEATH TRAP: Both side velocities point towards the node. This is considered a death trap and the algorithm will stop here.
 3145:       assert(false && "DEATH TRAP: Both side velocities point towards the node. IMPLEMENT THIS CASE");
 3146:    }
 3147: 
 3148: 
 3149: 
 3150: }
 3151: 
 3152: 
 3153: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3154: 
 3155: 
 3156: __device__ void Node::updateKb(void) {
 3157: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3158: 
 3159:    if constexpr(ivcor == 1) return;
 3160: 
 3161: 
 3162:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3163: 
 3164:    if constexpr(ivcor == 2) {  // SZ coordinates
 3165:       
 3166:       // Compute bottom level index
 3167:       if (depth <= mesh->h_s) {
 3168:          kb = izlev;   
 3169:          
 3170:       } else {
 3171:          kb = -1;
 3172:          int L = 0;
 3173:          int R = nzlev; 
 3174:          
 3175:          while (L <= R) {
 3176:             int M = (R + L) / 2;
 3177: 
 3178: 
 3179:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3180:             
 3181:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3182:                R = M;
 3183:             } else {
 3184:                L = M;
 3185:             }
 3186: 
 3187:             if (R - L == 1) {
 3188:                kb = L;
 3189:                break;
 3190:             }
 3191:          }
 3192: 
 3193:          // Checks that the binary search was successful
 3194:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3195:        
 3196:       }
 3197:    } 
 3198: }
 3199: 
 3200: 
 3201: __device__ __inline__ void Node::updateZCoordData(void) {
 3202: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3203: 
 3204:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3205:    // if (isDry2()) {
 3206:    //    kb = -1;  // XXXXXXXX KKKKK
 3207:    //    return;
 3208:    // }
 3209: 
 3210: 
 3211:    if constexpr(ivcor == 2) {  // SZ coordinates
 3212:       
 3213:       // Compute bottom level index
 3214:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3215:    } 
 3216:    else if (ivcor == 1) {  // Localized sigma
 3217:       // Do nothing
 3218:    }
 3219: 
 3220: 
 3221: }
 3222: 
 3223: 
 3224: __device__ double Node::compZCoord(int k) const {
 3225:    // Computes the z coordinate at level k.
 3226:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3227:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3228:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3229:    // used 
 3230: 
 3231:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 3232:    
 3233:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3234: 
 3235:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 3236: 
 3237:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 3238: 
 3239:    if constexpr(ivcor == 2) {
 3240: 
 3241:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3242:       const double h_c = mesh->h_c;
 3243:       const double theta_f = mesh->theta_f;
 3244:       const double sinh_theta_f = mesh->sinh_theta_f;
 3245: 
 3246: 
 3247:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3248:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3249:       // once per time step/node.
 3250:       // CHECK: updateZCoordData
 3251: 
 3252:       //  To simplify comparisons, I define index versions of count variables.
 3253:       if      (k == ivrt)     return eta2; 
 3254:       else if (k == izlev)    return -hmod2;
 3255:       else if (k == kb)       return -depth;
 3256:       else if (k < izlev)     return mesh->ztot[k];
 3257:       else if (k > izlev) {
 3258:          const int ksig = k - izlev;
 3259: 
 3260:          if (hmod2 <= h_c) {
 3261:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3262: 
 3263:          } 
 3264:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3265:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3266:             assert(false && "ZCOOR: invalid h_c\n");
 3267:          } 
 3268:          else {
 3269:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3270:                    h_c * mesh->sigma[ksig] + 
 3271:                    (hmod2 - h_c) * mesh->cs[ksig];
 3272:          }
 3273:       } else { 
 3274:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 3275:       }
 3276: 
 3277:    }
 3278:    else if constexpr(ivcor == 1) {
 3279:       if (k == kb) return -depth;
 3280:       else if (k == nvrt-1) return eta2;
 3281:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 3282:    }
 3283:    
 3284:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 3285:    return 0.0;
 3286: }
 3287: 
 3288: 
 3289: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3290:    // Computes the bottom drag Cd based on the selected nchi
 3291: 
 3292:    if constexpr(nchi == 0) {
 3293:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3294:       Cd = drag;  // Read from drag file
 3295: 
 3296:    } else if constexpr(nchi == 1) {
 3297:       // 
 3298: 
 3299:       bool ltmp = false; // for WBL iteration
 3300: 
 3301:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3302:       if (isDry || (rough == 0.0)) {
 3303:          Cd = 0.0;
 3304: 
 3305:       } else { //roughness >0 
 3306:          
 3307:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3308: 
 3309:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3310: 
 3311:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3312: 
 3313:       } // if rough
 3314: 
 3315:    } else if constexpr(nchi == -1) {
 3316:    // Manning 
 3317:  
 3318:       const double htot = max(hmin_man, htot2()); 
 3319:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3320: 
 3321:    } else {
 3322:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3323:       
 3324:    } // if nchi
 3325: 
 3326: }
 3327: 
 3328: 
 3329: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3330:    // Checks if a side in on the boundary
 3331:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3332: 
 3333:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3334:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3335: 
 3336:    // Indices of the nodes that form the side
 3337:    const int n1 = side.n1->idx;
 3338:    const int n2 = side.n2->idx;
 3339:    isLand = false;
 3340:    
 3341: 
 3342:    // Check if the side is on a land boundary
 3343:    for (int i = 0; i < nland; i++) {
 3344:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3345:          // Consecutive nodes in the land boundary segment
 3346:          const int b1 = ilnd[i + j*nland];
 3347:          const int b2 = ilnd[i + (j + 1)*nland];
 3348: 
 3349:          assert(b1 != -1 && b2 != -1);
 3350: 
 3351:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3352:             
 3353:             isLand = true;
 3354:             return i;
 3355:          }
 3356:       }
 3357:    }
 3358: 
 3359:    // Check if the side is on an open boundary
 3360:    for (int i = 0; i < nope; i++) {
 3361:       for (int j = 0; j < nond[i] - 1; j++) {
 3362:          // Consecutive nodes in the open boundary segment
 3363:          const int b1 = iond[i + j*nope];
 3364:          const int b2 = iond[i + (j + 1)*nope];
 3365: 
 3366:          assert(b1 != -1 && b2 != -1);
 3367: 
 3368:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3369:             isLand = false;
 3370:             return i;
 3371:          }
 3372:       }
 3373:    }
 3374: 
 3375:    return -1;
 3376: }
 3377: 
 3378: 
 3379: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3380:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3381:                                     double *wind_rotate_angle, 
 3382:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3383:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3384:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3385:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3386:                                     double *drag, double *roughness, double *rmanning) {
 3387: 
 3388:    NODE(pnode);  
 3389:    const int i = idx_node;
 3390:    Node &node(*pnode);
 3391: 
 3392:    node.idx = i;
 3393: 
 3394:    const int idxNodeStart = nodeNeighNodesStart[i];
 3395:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3396:    node.numNodes = idxNodeEnd - idxNodeStart;
 3397:    node.nodes = nodeNeighNodes + idxNodeStart;
 3398:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3399: 
 3400: 
 3401: 
 3402:    const int idxElemStart = nodeNeighElemsStart[i];
 3403:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3404:    node.numElements = idxElemEnd - idxElemStart;
 3405:    node.elements = nodeNeighElems + idxElemStart;
 3406: 
 3407: 
 3408:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3409:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3410:       const int partNode = localNodePart[idxNodeGlobal]; 
 3411:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3412: 
 3413:       Node *node_ptr = nodes[partNode] + idxNode;
 3414:       
 3415:       nodeNeighNodes[idx] = node_ptr;
 3416:    }
 3417: 
 3418: 
 3419:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3420:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3421:       const int partElem = localElemPart[idxElemGlobal];
 3422:       const int idxElem  = localElemIndices[idxElemGlobal];
 3423: 
 3424:       Element *elem_ptr = elems[partElem] + idxElem;
 3425: 
 3426:       nodeNeighElems[idx] = elem_ptr;
 3427:    }      
 3428: 
 3429:    node.wind_angle = wind_rotate_angle[i];
 3430: 
 3431: 
 3432:    node.p.x   = node_coords[i * 3];
 3433:    node.p.y   = node_coords[i * 3 + 1];
 3434:    node.depth = node_coords[i * 3 + 2];
 3435: 
 3436:    if (use_ll) {
 3437:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3438:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3439:    }
 3440: 
 3441: 
 3442:    node.numSides = 0;
 3443: 
 3444:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3445:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3446:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3447:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3448:    else assert(false && "populateNodes: selected nchi not implemented.");
 3449:    
 3450:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3451:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3452:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3453: 
 3454:    
 3455:    // Links the node to the boundary information
 3456:    if (isbnd[i] >= 0) {
 3457:      
 3458:       // Get the index of the node boundary
 3459:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3460: 
 3461:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3462:       node.nodeBnd->node = &node;
 3463: 
 3464:       node.nodeBnd->sideBnd1 = nullptr;
 3465:       node.nodeBnd->sideBnd2 = nullptr;
 3466: 
 3467:       if (isbnd[i]>=0) {
 3468: 
 3469:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3470:          
 3471:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3472:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3473: 
 3474:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3475:          node.nodeBnd->segment->clen  = nan("1");
 3476:          node.nodeBnd->segment->carea = nan("1");
 3477: 
 3478:       }
 3479:    } else {
 3480: 
 3481:       node.nodeBnd = nullptr; // For internal nodes
 3482: 
 3483:       if (isbnd[i] == landSegment) {
 3484:          node.nodeBnd = &landBoundaryNode;
 3485:          node.nodeBnd->segment = &landBoundarySegment;
 3486:       }
 3487:       
 3488:    }
 3489:    
 3490:    // XXXX GAUSSIAN HILL VELOCITIES
 3491: #ifdef GAUSSIAN_HILL_VELOCITIES
 3492:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3493:       constexpr double rot_per = 3000.0;
 3494:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3495:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3496:    // XXXXX
 3497: #endif
 3498: 
 3499: }
 3500: 
 3501: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3502:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3503:                                     double *wind_rotate_angle,   
 3504:                                     int *isdel, int *isidenode, int *isbnd,
 3505:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3506:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3507:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3508:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3509:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3510:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3511:                                     double *drag, double *roughness) {
 3512: 
 3513: 
 3514:    SIDE(pside);
 3515:    Side &side(*pside);
 3516:    const int i = idx_side;
 3517: 
 3518:    side.idx = i;  
 3519:    
 3520:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3521:    const double fc   = 2.0*omega_e*sin(sfea0);
 3522:    const double beta = 2.0*omega_e*cos(sfea0);
 3523: 
 3524:    // finding the pointer to the nodes that form the side
 3525:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3526:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3527: 
 3528:    const int locidx_n1 = localNodeIndices[idx_n1];
 3529:    const int locidx_n2 = localNodeIndices[idx_n2];
 3530:    const int part_n1 =   localNodePart[idx_n1];
 3531:    const int part_n2 =   localNodePart[idx_n2];
 3532: 
 3533:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3534:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3535: 
 3536:    // Counts the number of sides connected to each node
 3537:    side.n1->numSides++;
 3538:    side.n2->numSides++;
 3539: 
 3540:    // Normal, unitary vector to the side
 3541:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3542:    side.n = normalize(side.n);
 3543: 
 3544:    // Side boundary type
 3545:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3546:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3547: 
 3548:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3549:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3550:    {
 3551:       bool isLand = false;
 3552:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3553:       
 3554:       if (isbs > -1) {
 3555:          // assert(isLand || isbs>=0);
 3556:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3557: 
 3558:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3559: 
 3560:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3561:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3562: 
 3563:          assert (isLand == side.sideBnd->segment->isLand);
 3564: 
 3565:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3566:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3567:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3568: 
 3569:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3570:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3571:          
 3572:          side.sideBnd->side = &side;
 3573: 
 3574:       }
 3575:       else {
 3576:          side.sideBnd = nullptr;
 3577:       }
 3578:    }
 3579:    else 
 3580:    {
 3581:       side.sideBnd = nullptr;
 3582:    }
 3583: 
 3584: 
 3585:    // finding the pointer to the elements that share the side
 3586:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3587:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3588: 
 3589:    if (idx_e1 > -1) {
 3590:       const int locidx_e1 = localElemIndices[idx_e1];
 3591:       const int part_e1 =  localElemPart[idx_e1];
 3592:       side.elems[0] = elems[part_e1] + locidx_e1;
 3593: 
 3594:    }
 3595:    else {
 3596:       side.elems[0] = nullptr;
 3597:    }
 3598: 
 3599:    if (idx_e2 > -1) {
 3600:       const int locidx_e2 = localElemIndices[idx_e2];
 3601:       const int part_e2 =  localElemPart[idx_e2];
 3602:       side.elems[1] = elems[part_e2] + locidx_e2;
 3603:    }
 3604:    else {
 3605:       side.elems[1] = nullptr;
 3606:    }
 3607: 
 3608:    // Compute the center of the side
 3609:    side.center = 0.5*(side.n1->p + side.n2->p);
 3610: 
 3611:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3612:    side.shapiro = shapiro0;
 3613: 
 3614: #ifdef GAUSSIAN_HILL_VELOCITIES
 3615: // XXXX
 3616: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3617: constexpr double rot_per=3000.0;
 3618: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3619: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3620: // XXXXX      
 3621: #endif
 3622:    // Compute the z level at the center of the side
 3623:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3624:    
 3625:    // Compute the length of the side
 3626:    const Vector2 vLen = side.n2->p - side.n1->p;
 3627:    side.len = sqrt(dot(vLen, vLen));
 3628: 
 3629: 
 3630:    // Compute the Coriolis coefficient
 3631: 
 3632:    if constexpr(ncor == -1 || ncor == 0) {
 3633:       side.coriolis = coricoef;
 3634:    }
 3635:    else {
 3636:       const double sphi = side.lat();  // Latitude at the center of the side
 3637: 
 3638: // XXXXXX ERROR WHEN use_ll is false??????
 3639:       if constexpr(ics == 1) {
 3640:          // XXXXXXX
 3641:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3642:       }
 3643:       else {
 3644:          side.coriolis = 2.0*omega_e*sin(sphi);
 3645:       }
 3646: 
 3647:    }
 3648: }
 3649: 
 3650: 
 3651: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3652:    double *node_coords, double *node_coords_ll, bool use_ll,
 3653:    double *wind_rotate_angle,   
 3654:    int *isdel, int *isidenode, int *isbnd,
 3655:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3656:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3657:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3658:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3659:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3660:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3661:    double *drag, double *roughness) {
 3662: 
 3663:    ELEM(pelem);
 3664:    Element &elem(*pelem);
 3665:    const int i = idx_elem;
 3666: 
 3667:    elem.idx = i;
 3668: 
 3669:    for (int j = 0; j < i34[i]; j++) {
 3670:       const int idxNode = elnode[i*4 + j];  
 3671:       const int idxSide = elside[i*4 + j];
 3672:       
 3673:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3674:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3675: 
 3676:       // Find the neighboring element  
 3677:       if (elem.sides[j]->elems[0] == &elem) {
 3678:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3679:       }
 3680:       else {
 3681:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3682:       }
 3683:       
 3684:    }
 3685: 
 3686:    elem.i34 = i34[i];
 3687: 
 3688:    // Compute the barycenter of the element and its depth
 3689:    elem.center = {0.0, 0.0};
 3690:    elem.depth = 0.0;
 3691:    for (int j = 0; j < i34[i]; j++) {
 3692: 
 3693:       elem.center += elem.nodes[j]->p/i34[i];
 3694:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3695:    }
 3696: 
 3697: 
 3698:    
 3699:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3700:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3701: 
 3702:    elem.area = elem.computeSignedArea(); 
 3703:    elem.radius = sqrt(elem.area)/pi; 
 3704:    
 3705:    // Determines which way the normal vector to each side is oriented.
 3706:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3707:    for (int j = 0; j < i34[i]; j++)  
 3708:    {
 3709:       elem.ssign[j] = (elem.sides[j]->elems[0] == &elem) ? 1.0 : -1.0;
 3710:        
 3711:    }
 3712: 
 3713:    // Derivatives of shape functions
 3714:    //  For ics=2, this is done inside element/ll frame XXX
 3715:    //  For quads, the derivative is evaluated at centroid
 3716:    for (int j = 0; j < elem.i34; j++) {
 3717:       const double area = elem.area;
 3718:       const int id2 = elem.nxq(1 + j);
 3719:       const int id3 = elem.nxq(2 + j);
 3720:       const int id4 = elem.nxq(3 + j);
 3721:       if (elem.isTri()) {
 3722:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3723:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3724:          // da1/dx = (y1 - y2)/(2*area)
 3725:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3726:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3727:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3728:       }
 3729:       else  { // Quad; evaluate at centroid
 3730:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3731:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3732:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3733:       } // if Tri
 3734: 
 3735:    } // for j   
 3736:    
 3737:    
 3738: 
 3739: }
