  889: struct Side {
  890: 
  891:    // Geometry information
  892:    int idx;               // Index of the side
  893:    Node *n1, *n2;
  894:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  895: 
  896:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  897:    Vector2 center;        // Location of side center. 
  898:    double zc[nvrt];       // Side center z-coord at each vertical level
  899: 
  900:    Frame frame;
  901: 
  902:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  903:                           // this is nullptr
  904:    
  905:    int kb;                // Bottom index of the side
  906:    bool isDry;            // True if the side is dry
  907:  
  908:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  909: 
  910:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  911: 
  912:    // Physical information
  913:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  914:    double  w2[nvrt];            // Vertical velocity at each vertical level
  915:    Vector2 btu[nvrt];           // Back-tracked velocity
  916:    Vector2 U;                   // Vertically averaged velocity vector  
  917: 
  918:    Vector2 nuGradU[nvrt];          // nu*grad u
  919: 
  920:    Vector2 bcc[nvrt];           // Baroclinic term
  921:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  922: 
  923:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  924:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  925:    Vector2 gradPr;               // Gradient of pressure
  926:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  927: 
  928: 
  929:    double hhat;                 // \breve{H} in notes
  930: 
  931:    double shapiro;
  932: 
  933:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  934: 
  935:    double coriolis;             // Coriolis parameter
  936: 
  937:    // Vegetation parameters
  938:    double veg_c2;
  939:    double veg_beta;
  940: 
  941:    // Bottom drag parameters.
  942:    double chi;
  943:    double chi2;
  944: 
  945:    __inline__ __device__ double x(double t) const;
  946:    __inline__ __device__ double y(double t) const;
  947:    __inline__ __device__ double lon(void) const;
  948:    __inline__ __device__ double lat(void) const;
  949:    __inline__ __device__ Point2 p_t(double t) const;
  950: 
  951:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  952:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  953:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  954:    __inline__ __device__ double area(int k)     const { return len*Dz(k + 1); }
  955: 
  956:    __inline__ __device__ Side* neigh(int index) const { 
  957:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  958:       assert(index >= 0 && index < 4); 
  959:       assert(elems[0] != nullptr && elems[1] != nullptr);
  960: 
  961:       const int ielem = index & 1;           // 0 or 1
  962:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  963: 
  964:       const Element* elem = elems[ielem];
  965: 
  966:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  967: 
  968:       return elem->sides[elem->nxq(locSideIdx + iside)];
  969: 
  970:    }
  971: 
  972:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  973: 
  974:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  975: 
  976:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  977:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
  978:    __inline__ __device__ int iadv(void) const;
  979: 
  980:    __inline__ __device__ double grav3(void) const;
  981:    
  982:    __inline__ __device__ double eta2(void) const;
  983:    __inline__ __device__ double eta1(void) const;
  984:    __inline__ __device__ double depth(void) const;
  985:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  986:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  987: 
  988:    __inline__ __device__ double dfv(int k) const;
  989: 
  990:    __inline__ __device__ double veg_h(void)  const;
  991:    __inline__ __device__ double veg_nv(void) const;
  992:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  993:    __inline__ __device__ double veg_alpha3D(int k) const;
  994:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  995: 
  996:    __inline__ __device__ double Cd(void) const;
  997: 
  998:    __inline__ __device__ Vector2 tau(void) const;
  999: 
 1000:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1001:    
 1002: 
 1003:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1004:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1005:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1006:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1007:    } 
 1008:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1009:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1010:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1011:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1012: 
 1013:    // Get valid starting element (for backtracking)
 1014:    __inline__ __device__ Element* getStartElement() {
 1015:       return elems[0] ? elems[0] : elems[1];
 1016:    }
 1017: 
 1018:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1019:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1020: 
 1021:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1022: 
 1023:       // Dot product of the negative velocity vector with the side normal vector
 1024:       const double dot_prod1 = -dot(u, n);
 1025: 
 1026:       // Vector from side center to element 0 centroid
 1027:       const Vector2 v2 = toVector2(elems[0]->center) - center;
 1028: 
 1029:       // Dot product of the vector with the side normal vector
 1030:       const double dot_prod2 = dot(v2, n);
 1031: 
 1032:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1033:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1034: 
 1035:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1036:       else                           return elems[1];
 1037: 
 1038:  
 1039:    }
 1040: 
 1041:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1042:       // Given an element, returns the other element that shares this side
 1043:       return (elems[0] == elem) ? elems[1] : elems[0];
 1044:    }
 1045: 
 1046:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1047:       // Given a node, returns the other node that shares this side
 1048:       return (n1 == node) ? n2 : n1;
 1049:    }
 1050:  
 1051:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1052: 
 1053: 
 1054: 
 1055: 
 1056: };
