 2845: __device__ __inline__ void Node::updateZCoordData(void) {
 2846: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2847: 
 2848:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2849:    // if (isDry2()) {
 2850:    //    kb = -1;  // XXXXXXXX KKKKK
 2851:    //    return;
 2852:    // }
 2853: 
 2854: 
 2855:    if constexpr(ivcor == 2) {  // SZ coordinates
 2856:       
 2857:       // Compute bottom level index
 2858:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2859:    } 
 2860:    else if (ivcor == 1) {  // Localized sigma
 2861:       // Do nothing
 2862:    }
 2863: 
 2864: 
 2865: }
