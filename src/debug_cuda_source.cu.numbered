 2780: __device__ __inline__ void Node::updateZCoordData(void) {
 2781: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2782: 
 2783:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2784:    // if (isDry2()) {
 2785:    //    kb = -1;  // XXXXXXXX KKKKK
 2786:    //    return;
 2787:    // }
 2788: 
 2789: 
 2790:    if constexpr(ivcor == 2) {  // SZ coordinates
 2791:       
 2792:       // Compute bottom level index
 2793:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2794:    } 
 2795:    else if (ivcor == 1) {  // Localized sigma
 2796:       // Do nothing
 2797:    }
 2798: 
 2799: 
 2800: }
