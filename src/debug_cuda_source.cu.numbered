 2500: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2501: 
 2502:    const double w1 = getBoundaryArrayValueWeight();
 2503:    const double w2 = 1.0 - w1;
 2504:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2505:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2506: 
 2507:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2508: }
