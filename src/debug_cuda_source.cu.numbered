 2088: // Helper functions for computing the local node index at a given offset from another.
 2089: __device__ __inline__ int nxq(int offset, int index, int size) {
 2090:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2091:    // to the index to make it positive
 2092:    assert(index + offset + 16*size >= 0);
 2093:    return (index + offset + 16*size) % size;  
 2094: }
 2095: 
 2096: __device__ __inline__ int nxq(int index, int size) {
 2097:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2098:    // to the index to make it positive
 2099:    assert(index + 16*size >= 0);
 2100:    return (index + 16*size) % size; 
 2101: }
