 9453: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 9454:    Element *elems = mesh->localElemData;
 9455: 
 9456:    *addr = elems;
 9457:    *sizeElement = sizeof(Element);
 9458:    switch (varCode) {
 9459:       case (int)VarCode::z:
 9460:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 9461:          *sizeType = sizeof(double);
 9462:          break;
 9463:       case (int)VarCode::x:
 9464:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 9465:          *sizeType = sizeof(Vector2);
 9466:          break;
 9467:       case (int)VarCode::gradETP:
 9468:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 9469:          *sizeType = sizeof(Vector2);
 9470:          break;
 9471:       case (int)VarCode::area:
 9472:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 9473:          *sizeType = sizeof(double);
 9474:          break;
 9475:       case (int)VarCode::depth:
 9476:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 9477:          *sizeType = sizeof(double);
 9478:          break;
 9479:       case (int)VarCode::radius:
 9480:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 9481:          *sizeType = sizeof(double);
 9482:          break;
 9483:       case (int)VarCode::ghat:
 9484:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 9485:          *sizeType = sizeof(Vector2);
 9486:          break;
 9487:       case (int)VarCode::kb:
 9488:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 9489:          *sizeType = sizeof(int);
 9490:          break;
 9491:       case (int)VarCode::isdry:
 9492:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 9493:          *sizeType = sizeof(int);
 9494:          break;            
 9495:       case (int)VarCode::w:
 9496:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 9497:          *sizeType = sizeof(double);
 9498:          break;
 9499:       case (int)VarCode::FaceIndices:
 9500:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 9501:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 9502:          *sizeType = sizeof(Node);
 9503:          break;
 9504:       default:
 9505:          *offset = -1;
 9506:    }
 9507: }
