 8064: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8065:    // Get the value of a variable from an element
 8066:    // varName is the name of the variable to get
 8067:    // var is the array to store the value
 8068:    // k is the vertical level index of the variable to get
 8069: 
 8070:    ELEM(elem);
 8071:    
 8072:    int idx = elem->idx;
 8073:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8074: 
 8075:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8076:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8077:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8078:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8079:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8080:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8081:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8082:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8083:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8084:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8085:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8086:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8087:       
 8088:    
 8089: }
 8090: 
 8091: 
 8092: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8093:    // Get the value of a variable from an node
 8094:    // varName is the name of the variable to get
 8095:    // var is the array to store the value
 8096:    // k is the vertical level index of the variable to get
 8097: 
 8098:    NODE(node);
 8099:    
 8100:    int idx = node->idx;
 8101:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8102: 
 8103:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8104:    
 8105:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8106:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8107:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8108:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8109:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8110:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8111:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8112:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8113:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8114:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8115:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8116:    
 8117:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8118:       
 8119:    
 8120: }
 8121: 
 8122: 
 8123: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8124:    // Get the value of a variable from an side
 8125:    // varName is the name of the variable to get
 8126:    // var is the array to store the value
 8127:    // k is the vertical level index of the variable to get
 8128:    SIDE(side);
 8129:    
 8130:    int idx = side->idx;
 8131:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8132: 
 8133:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8134:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8135:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8136:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8137:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8138:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8139:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8140:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8141:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8142:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8143:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8144:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8145:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8146:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8147:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8148:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8149:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8150:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 8151:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8152:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8153:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8154:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8155:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8156:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8157:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8158:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8159:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8160:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 8161:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8162:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8163:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8164:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8165:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8166:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8167:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8168:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8169:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8170: }
 8171: 
 8172: 
 8173: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8174:    // Get the value of a variable from an side
 8175:    // varName is the name of the variable to get
 8176:    // var is the array to store the value
 8177:    // k is the vertical level index of the variable to get
 8178:    SIDE_BND(sideBnd);   
 8179: 
 8180:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8181:    if (sideBnd->segment->isLand) idx = -7;
 8182: 
 8183:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8184:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8185: 
 8186: }
