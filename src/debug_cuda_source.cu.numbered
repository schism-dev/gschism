 4687:    __global__ void computeFlowBcVelocities(double time) {
 4688: 
 4689:       SIDE_BND(sideBnd);
 4690: 
 4691:       const Side *side = sideBnd->side;
 4692:  
 4693:       const bool isDry = side->isDry;
 4694:       const bool isLand = sideBnd->segment->isLand;
 4695: 
 4696:    
 4697:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4698: 
 4699:       if (isDry || isLand) return;
 4700: 
 4701:       // For wet sides in open boundaries...
 4702:       const Vector2 n = side->n;
 4703:       const BoundarySegment *segment = sideBnd->segment;
 4704: 
 4705:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4706: 
 4707:       const int ifltype = segment->ifltype;
 4708: 
 4709:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4710:       const Vector2 r_nuth0 = r_uth0*n;
 4711: 
 4712: 
 4713:       if (ifltype == 1 || ifltype == 2) {
 4714:       
 4715:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4716: 
 4717:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4718:          
 4719:          // for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4720:          
 4721:       } else if (ifltype == -1) { // Flather 1
 4722: 
 4723:          for (int k = 0; k < nvrt; k++) {
 4724: 
 4725:             // uth is the normal vel.; no ramp up
 4726:             const double uth = sideBnd->nuth(k);
 4727:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4728: 
 4729:             // sideBnd->ubc[k] += uth*n;
 4730:          }
 4731: 
 4732:       } else if (ifltype == 3 || ifltype == 5) {
 4733:          // vnth0=0 !normal vel.
 4734: 
 4735:          Vector2 r_u1_bar = {0.0, 0.0};
 4736:          // Computes the contribution to the velocity from all tide frequencies
 4737:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4738: 
 4739:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4740:             const Vector2 umo  = sideBnd->umo(jfr); 
 4741: 
 4742:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4743:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4744:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4745:             r_u1_bar += {1.0, 1.0}; //ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4746:             if (sideBnd->side->idx == 159434) {
 4747:                printf("idx = %d, n1 = %d, n2 = %d, r_u1_bar = %f, %f, ufa = %f, %f, umo = %f, %f, arg = %f, %f, ncyc = %d, face[jfr] = %f\n", sideBnd->side->idx, sideBnd->side->n1->idx, sideBnd->side->n2->idx, r_u1_bar.x, r_u1_bar.y, sideBnd->ufa(0).x, sideBnd->ufa(0).y, sideBnd->umo(0).x, sideBnd->umo(0).y, argx, argy, ncyc, face[jfr]);
 4748:             }
 4749:          }
 4750: 
 4751: 
 4752:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4753: 
 4754:       } // if (ifltype = 3 || ifltype == 5
 4755: 
 4756: 
 4757: 
 4758:    }
 4759: 
 4760:    __global__ void computeElevationBoundaryConditions(double time) {
 4761:       // Compute elevation essential boundary conditions 
 4762: 
 4763:       NODE_BND(nodeBnd); // Each boundary node.
 4764: 
 4765:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4766: 
 4767:       const Node *node = nodeBnd->node;
 4768:       const BoundarySegment *segment = nodeBnd->segment;
 4769:       const int iettype = segment->iettype;
 4770:       
 4771: 
 4772:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4773:       double eic = 0.0;
 4774:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4775:       else                 eic = 0.0;
 4776: 
 4777:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4778:       const double r_eth = ramp*nodeBnd->eth;
 4779:       double r_eta1_bar = 0.0;
 4780: 
 4781: 
 4782:       // Compute tide elevation
 4783:       if (iettype == 3 || iettype == 5) {   
 4784: 
 4785:          if constexpr(iloadtide==1) { // loading tide
 4786:             assert(false && "Loading tide not implemented");
 4787:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4788:          }
 4789:          
 4790:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4791: 
 4792:             const double efa  = nodeBnd->efa[jfr]; 
 4793:             const double emo  = nodeBnd->emo[jfr]; 
 4794: 
 4795:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4796:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4797:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4798: 
 4799:          } // for jfr
 4800: 
 4801:       } // if iettype
 4802: 
 4803:       switch (iettype) {
 4804:          case 1:
 4805:          case 2:
 4806:          case 4:
 4807:             nodeBnd->elbc = r_eic + r_eth;
 4808:             break;
 4809:          case 3:
 4810:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4811:             break;
 4812:          case 5:
 4813:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4814:             break;
 4815:       } // switch
 4816: 
 4817: 
 4818:       //Add inverse barometric effects
 4819:       if (iettype != 0 && inv_atm_bnd == 1) {
 4820:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4821:       }
 4822: 
 4823:    }
 4824: 
 4825: 
 4826:    __global__ void computeHorizontalViscosity(void) { 
 4827: 
 4828:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4829: 
 4830:       SIDE(side);
 4831: 
 4832:       if (side->isDry) return;
 4833: 
 4834:       for (int k = 0; k < nvrt; k++) {
 4835:          side->nuGradU[k] = {0.0, 0.0};
 4836:       }
 4837: 
 4838:       if constexpr(ihorcon == 1) {
 4839:          for (int k = side->kb; k < nvrt - 1; k++) {
 4840:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4841:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4842:             // By Zhang and Baptista.
 4843: 
 4844:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4845:             // This is a standard discretization of the Laplacian operator.
 4846:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4847:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4848:             // Gamma is hvis_coef0 in the code.
 4849:             // The value of gamma needs to be < 0.5.
 4850: 
 4851:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4852:             // side under consideration in each of the two possible elements that share the side.
 4853:             Vector2 sumU = {0.0, 0.0};
 4854:             for (int l = 0; l < 2; l++) {
 4855:                const Element *elem = side->elems[l];
 4856: 
 4857:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4858: 
 4859:                // Find the local index of the side in the element
 4860:                const int idxSide = elem->sideLocalIdx(side);
 4861:                // Find the two sides that are connected to the side under consideration
 4862:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4863:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4864: 
 4865:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4866: 
 4867:             }
 4868: 
 4869:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4870:    
 4871:          }
 4872:       }
 4873:       else if constexpr(ihorcon == 2) {
 4874:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4875:       }
 4876: 
 4877: 
 4878:    }
 4879: 
 4880: 
 4881:    __global__ void setEssentialBC(void) {
 4882:       // Set essential boundary conditions 
 4883:       NODE(node); // Each boundary node
 4884:       NodeBoundary *nodeBnd = node->nodeBnd;
 4885:       
 4886: // nodeBnd->isEssentialBC = true;      
 4887:       // Check if this node has essential BC
 4888:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4889:          // Verify BC value is valid
 4890:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4891: 
 4892:        
 4893:          // Set diagonal to 1 and zero off-diagonals
 4894:          node->coeffDiag = 1.0;
 4895: 
 4896:          for (int j = 0; j < node->numNodes; j++) {
 4897:                node->coeffMatrix[j] = 0.0;
 4898:          }
 4899:          
 4900:          // Set solution and RHS to BC value
 4901:          node->mX  = nodeBnd->elbc;
 4902:          node->qel = nodeBnd->elbc;
 4903: // printf("bbbbb\n");
 4904:       } else {
 4905:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4906: // printf("aaaaaa\n");
 4907:          for (int j = 0; j < node->numNodes; j++) {
 4908:                Node* nbNode = node->nodes[j];
 4909:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4910:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4911:                   // Verify neighbor's BC value
 4912:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4913: 
 4914:                   // Subtract contribution to RHS
 4915:                   // node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4916:                   node->coeffMatrix[j] = 0.0;  
 4917:                }
 4918:          }
 4919:       }
 4920:    }
 4921: 
 4922: 
 4923:    __global__ void updateElevation(void) {
 4924:       NODE(node);
 4925: 
 4926:       node->eta2 = node->mX;
 4927: 
 4928:       node->updateZCoordData();
 4929:    }
 4930: 
 4931: 
 4932:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4933: 
 4934:       SIDE(side);
 4935: 
 4936: 
 4937:       side->U = {0.0, 0.0}; 
 4938:          
 4939:       if(side->isDry) return;
 4940: 
 4941:       const Node *node1 = side->n1;
 4942:       const Node *node2 = side->n2;
 4943: 
 4944:       // Vertically integrated velocity U (in ll if ics=2)
 4945:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4946:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4947:       }
 4948: 
 4949:    }
 4950: 
 4951:    __global__ void computeBottomDragVegetation(void) {
 4952:       // UNFINISHED. CHECK THIS:
 4953:       // How many kernels are needed? Why so many for loops?
 4954:       // Is the loop on sides needed?
 4955: 
 4956:       NODE(node);
 4957: 
 4958: 
 4959:       const int    kb      = node->kb;
 4960:       const double htot    = node->htot2(); 
 4961:       const double rough   = node->rough;
 4962: 
 4963:       
 4964:       if (node->isDry) {
 4965:          // Default values for dry nodes
 4966:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4967:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4968: 
 4969:          return;
 4970:        
 4971:       }
 4972: 
 4973:       // Compute bottom drag Cd
 4974:       //--------------------------------
 4975: 
 4976:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4977:       if constexpr(nchi == 1) {
 4978: 
 4979:          bool ltmp = false; // for WBL iteration
 4980: 
 4981:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4982:          // Drag at nodes
 4983:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4984:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4985:         
 4986:          const double rough = node->rough;
 4987:         
 4988:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4989:          if (node->rough == 0.0) {
 4990:             node->Cd = 0.0;
 4991: 
 4992:          } else { //roughness >0 
 4993:           
 4994:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4995:             const double bthick = max(dzb_min, bthick_ori);
 4996: 
 4997:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4998: 
 4999:             double tmp = 1.0/(2.5*log(bthick/rough));
 5000:             node->Cd = tmp*tmp;
 5001: 
 5002:          } // if rough
 5003: 
 5004: 
 5005:          // RECOVER THIS: XXX
 5006:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 5007:          // Output warning for WBL if iteration didn't converge
 5008: 
 5009: 
 5010:       } // nchi==1
 5011: 
 5012: 
 5013:       //   Bottom stress in m^2/s^2
 5014:       if (node->rho[kb + 1] >= -98.0)
 5015:       {
 5016:          const double mag_u = length(node->u2[kb + 1]);
 5017:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5018: 
 5019:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5020:          // !sediment erosion: this part needs more documentation
 5021:       }
 5022:     
 5023: 
 5024: 
 5025:       // Compute vegetation parameters
 5026:       //--------------------------------
 5027: 
 5028:       // SAV constants
 5029:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5030:       constexpr double veg_cfpsi = 0.16;
 5031: 
 5032:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5033:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5034: 
 5035:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5036:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5037:          int kbin = 0; // bin index
 5038:          for (int k = kb; k < nvrt; k++) {
 5039:             // Computes node height above the bottom level
 5040:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5041:             assert(false && "Vertical variation of vegetation not implemented");
 5042: 
 5043:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5044:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5045:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5046:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5047:             // } else {
 5048:             //    // Find the bin at which the current vertical level is
 5049:             //    while (kbin<nbins_veg_vert) {
 5050:             //       const double zn = node->z[kbin];
 5051:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5052:             //          break;
 5053:             //       } // if
 5054:             //       kbin++;
 5055:             //    } // while
 5056:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5057: 
 5058:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5059:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5060:                
 5061:             //    // Linear interpolation of the vegetation parameters
 5062:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5063:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5064:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5065:             // } // if rl10
 5066: 
 5067:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5068: 
 5069:          } // for k
 5070: 
 5071: 
 5072:       } else { // Ganthy (iveg==2)
 5073:       //  Modify canopy height, diameter, and density
 5074: 
 5075:          // Make sure there is vegetation on this node
 5076:          if (node->veg_h_unbent > 0.0) {
 5077:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5078: 
 5079:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5080:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5081:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5082: 
 5083:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5084:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5085:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5086:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5087:          } // if veg_h_unbent
 5088: 
 5089:          for (int k = 0; k < nvrt; k++) {
 5090:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5091:          } // for k
 5092:       
 5093: 
 5094:       } // if iveg
 5095:      
 5096: 
 5097:       // Compute vertical mean of veg_alpha3D
 5098:       if (iveg != 0) {
 5099:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5100:          double sum1=0.0;
 5101:          double sum2=0.0;
 5102:          // Integrate over each level under the canopy...
 5103:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5104:             const double Dz = node->Dz(k);
 5105: 
 5106:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5107:             sum2 += Dz;
 5108: 
 5109:          } // for k
 5110:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5111:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5112: 
 5113:       } // if iveg
 5114: 
 5115:    }
 5116: 
 5117:    __global__ void computeVegetationAndDragParameters(void) {
 5118:       // Computes the vegetation and drag model parameters:
 5119:       // chi, \tilde\chi, beta, \breve{H}
 5120:       
 5121:       SIDE(side);
 5122: 
 5123:       if (side->isDry) return;
 5124: 
 5125:       const double htot = side->htot2();
 5126:       const int    kb   = side->kb;
 5127: 
 5128:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5129: 
 5130:       const double veg_h     = side->veg_h();
 5131:       const double veg_nv    = side->veg_nv();
 5132:       const double veg_c     = side->veg_c();
 5133:       const double veg_beta  = side->veg_beta;
 5134:       const double veg_alpha = side->veg_alpha_vert_mean();
 5135: 
 5136:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5137:       // Velocity magnitude at the bottom level
 5138:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5139:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 5140:       side->chi2 = side->Cd()*vmag1;
 5141:       side->chi  = side->chi2;
 5142:       if constexpr(iveg != 0) {
 5143:          const Node *n1 = side->n1;
 5144:          const Node *n2 = side->n2;
 5145:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5146:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5147:       }
 5148: 
 5149:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5150: 
 5151:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5152:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5153:       double magUa = 0.0;
 5154:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5155:          // 3D wet side with veg...
 5156: 
 5157:          double magUa = 0.0;
 5158:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5159:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5160: 
 5161:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5162:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5163:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5164: 
 5165:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5166:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5167: 
 5168:                // Velocity magnitude at the bottom (l) of the level
 5169:                const double ul = length(side->u2[k]);
 5170: 
 5171:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5172:                magUa += Dz*0.5*(uh + ul);
 5173: 
 5174:             } // if HasVegetation
 5175:          } // for k
 5176:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5177: 
 5178:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5179:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5180:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5181:             const double zCpy = side->zTopCanopy();
 5182:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5183:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5184:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5185:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5186:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5187:          } // if isSubmerged
 5188:       } // if iveg   
 5189: 
 5190:       // Computes the friction modified depth, \breve{H} in notes
 5191:       if (side->is2D()) { // 2D
 5192: 
 5193:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5194:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5195: 
 5196:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5197: 
 5198:          side->hhat = htot*htot/fricH; 
 5199: 
 5200:       } else { // 3D
 5201:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 5202: 
 5203:          if constexpr(iveg != 0) {
 5204:             
 5205:             if (side->isSubmerged()) { 
 5206:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5207:                side->hhat -= veg_c*Hhat_alpha;
 5208: 
 5209:             } else { // Emergent
 5210:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5211:             }
 5212:          } // if iveg
 5213: 
 5214:          // Enforce positivity for 3D model
 5215:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 5216:       } // if 3D
 5217: 
 5218:    }
 5219: 
 5220: 
 5221: 
 5222:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5223:    // Computes the density gradient between two elements, e1 and e2.
 5224:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5225:    // zero in the direction normal to the side. 
 5226:    // 
 5227:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5228:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5229:    //
 5230:    // Input:
 5231:    //    e1: Element
 5232:    //    e2: Neighbor element (or nullptr if boundary)
 5233:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5234:    //    k: Index of the half-level at which the density is interpolated
 5235:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5236:    // 
 5237:    // Output:
 5238:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5239:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5240: 
 5241:       if (e2 == nullptr || e2->isDry) {
 5242:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5243: 
 5244:          Side *side = e1->sides[j];
 5245:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5246:                  
 5247:          if constexpr(ics == 1) {
 5248:             vec = side->n; // Normal vector to the side
 5249:          } else {
 5250:             // IMPLEMENT THIS XXXXXX
 5251:             // !replace with xel, yel?
 5252:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5253:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5254:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5255:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5256:          } //ics
 5257:                    
 5258:          diffRho = 0.0;
 5259: 
 5260:       } else { //internal and wet
 5261:          if constexpr(ics==1) {
 5262:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5263: 
 5264:             // Vector from e1 to e2
 5265:             vec = e2->center - e1->center;
 5266: 
 5267:          } else { 
 5268:             // IMPLEMENT THIS XXXXXX
 5269:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5270:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5271:             //                   alow(j)=xctr2
 5272:             //                   bdia(j)=yctr2
 5273:          } // ics
 5274: 
 5275:          diffRho = rho2 - e1->demeanedDensity(k);
 5276:       }
 5277: 
 5278:    }
 5279: 
 5280:    __global__ void computeDensityCubicSplines(void) {
 5281:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5282: 
 5283:       ELEM(elem);
 5284: 
 5285:       if (elem->isDry) return;
 5286: 
 5287:       const int kb = elem->kb;
 5288: 
 5289:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5290:       if (elem->is2D()) {
 5291:          // In the 2D case, the density is constant at the prism level. 
 5292:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5293:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5294:       } else { //3D
 5295: 
 5296:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5297:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5298:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5299:          ///// XXXX CHECK INDICES!!!!!
 5300:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5301:       } // 2D/3D
 5302: 
 5303:    }
 5304: } // extern "C"
 5305: 
 5306: 
 5307: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5308: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5309: 
 5310:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5311: 
 5312:    const int kb  = elem->kb;
 5313:    const int kb2 = elem2->kb;
 5314: 
 5315:    // z-coordinate of prism of elem
 5316:    const double zp = elem->z_prism(k);
 5317: 
 5318:    double rho = 0.0;
 5319: 
 5320:    if (elem2->is2D()) {
 5321:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5322: 
 5323:    } else {  // 3D
 5324: 
 5325:       // eta_min may be < zmax
 5326:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5327:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5328: 
 5329:       // (Extrapolate density below bottom, we will fix it later)
 5330:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5331:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5332:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5333:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5334:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5335:    } // 2D/3D
 5336:      
 5337: 
 5338:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5339:    // Now we need to fix it.
 5340:    if (elem->z[k] < elem2->z[kb2]) {
 5341:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5342: 
 5343:       // There are two methods to adjust the density at the bottom of the element.
 5344:       // iunder_deep=0: 
 5345:       const double depth1 = abs(elem->z[kb]); // larger depth
 5346: 
 5347:       if (iunder_deep==0) {
 5348: 
 5349:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5350: 
 5351:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5352: 
 5353:       } else { // iunder_deep != 0
 5354: 
 5355:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5356: 
 5357:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5358: 
 5359:          //   Demeaned density at the same z coordinate as
 5360:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5361:          }
 5362: 
 5363:       } // if iunder_deep
 5364:    } // if elem->z[kb] < elem2->z[kb]
 5365: 
 5366:    return rho;
 5367: }
 5368: 
 5369: 
 5370: extern "C" {
 5371:    __global__ void computeDensityGradient(void) {
 5372: 
 5373:       if constexpr(ibc != 0) return;
 5374: 
 5375:          // Compute the horizontal density gradient at each element.
 5376:       // It works in two steps:
 5377:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5378:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5379:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5380:       //             gradRho.r1 = rho1 - rho0
 5381:       //             gradRho.r2 = rho2 - rho0
 5382:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5383:       // 
 5384:       //  NOTE: We use de-meaned densities.
 5385: 
 5386:       ELEM(elem);
 5387: 
 5388:       if (elem->isDry) return;
 5389: 
 5390:       const int kb  = elem->kb;
 5391:       const int i34 = elem->i34;
 5392: 
 5393:       for (int k = kb + 1; k < nvrt; k++) {
 5394:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5395:          //             gradRho.r1 = rho1 - rho0
 5396:          //             gradRho.r2 = rho2 - rho0
 5397:          int icount = 0;
 5398:          double sumRx = 0.0;
 5399:          double sumRy = 0.0;
 5400:          for (int j1=0; j1<i34; j1++) { 
 5401: 
 5402:             const int j2 = elem->nxq(j1 + 1);
 5403: 
 5404:             // Pairs of consecutive neighbor elements of elem
 5405:             const Element *e1 = elem->nghbElems[j1];
 5406:             const Element *e2 = elem->nghbElems[j2];
 5407: 
 5408:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5409:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5410:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5411: if (elem->idx == 21) printf("$$AAAXXXXXXXA$$$ rho1 = %.16f, rho2 = %.16f\n", rho1, rho2);            
 5412: 
 5413:             // Compute the density difference and the vector from elem to e1 and e2
 5414:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5415:             double diffRho1, diffRho2;
 5416:             Vector2 vec1, vec2;
 5417:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5418:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5419: 
 5420:             const double rl1 = length(vec1);
 5421:             const double rl2 = length(vec2);
 5422:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5423: 
 5424:             const double delta = cross(vec1, vec2);
 5425:             const double sintheta = abs(delta)/(rl1*rl2);
 5426: 
 5427:             // To avoid problems, avoid elements with small angle between vectors
 5428:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5429:             const bool validEq = (sintheta > sin_one_deg);
 5430: 
 5431:             if (validEq) {
 5432:                // Solve the system of equations to get the density gradient at elem
 5433:                icount++;
 5434:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5435:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5436:                sumRx += Rx;
 5437:                sumRy += Ry;
 5438:             }
 5439:          } // for j1
 5440: 
 5441:          // Compute the average density gradient at elem
 5442:          if (icount==0) {
 5443:            // Bad mesh quality; bail out with 0 b-cc
 5444:            elem->gradRho[k] = {0.0, 0.0};
 5445:          } else {
 5446:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5447:          }
 5448: 
 5449:       } // for k
 5450: 
 5451:    }
 5452: 
 5453:    __global__ void computeBaroclinicTerm(void) {
 5454:    // Computes the baroclinic term at sides (at half levels).
 5455:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5456:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5457: 
 5458:       if (ibc == 1) return;
 5459: 
 5460:       SIDE(side);
 5461: 
 5462:       if (side->isDry) return;
 5463: 
 5464:       const Element *e1 = side->elems[0];
 5465:       const Element *e2 = side->elems[1];      
 5466:       const int kb = side->kb;
 5467:       
 5468:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5469: 
 5470:       // interpolates vertically the density gradient of the two elements at the half level/
 5471: 
 5472:       int k1 = max(kb, nvrt / 2);
 5473:       int k2 = max(kb, nvrt / 2);
 5474: 
 5475:       // Starts the integration at the surface and goes down to the bottom
 5476:       side->bcc[nvrt-1] = {0.0, 0.0};
 5477:       for (int k = nvrt - 2; k >= kb; k--) {
 5478:       // For each prism level (from surface to bottom)...
 5479: 
 5480:          // For both elements, interpolate density gradient at the side's half level.
 5481:          // The gradient at the side is the average of the gradients at the elements.
 5482:          // w1, w2 are used to take into account boundary sides, with just one element.
 5483:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5484:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5485:          const double wsum = w1 + w2;
 5486:          w1 = w1/wsum;
 5487:          w2 = w2/wsum;
 5488:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5489: 
 5490:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5491:          Vector2 gradRho = {0.0, 0.0};
 5492:          if (e1 != nullptr && k > kb) {
 5493:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5494:             
 5495:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5496:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5497:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5498: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5499:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5500:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5501:          }      
 5502:          if (e2 != nullptr && k > kb) {
 5503:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5504:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5505:             
 5506:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5507:          }
 5508: 
 5509:          if constexpr(ics==2) {
 5510:             assert(false && "Not implemented: ics == 2");
 5511:             // IMPLEMENT THIS XXXXXX
 5512:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5513:             // swild(1)=tmp1
 5514:             // swild(2)=tmp2
 5515:          }
 5516:          
 5517:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5518:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5519:          // CHECK INDICES!!! XXX
 5520:          const double grav3 = side->grav3();
 5521:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5522: 
 5523:       } // for
 5524: 
 5525:    }
 5526: 
 5527: 
 5528: 
 5529:    __global__ void computeHorGradientAtSide(void) {
 5530: 
 5531:       // Compute the horizontal density gradient at each element.
 5532:       // It works in two steps:
 5533:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5534:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5535:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5536:       //             gradRho.r1 = rho1 - rho0
 5537:       //             gradRho.r2 = rho2 - rho0
 5538:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5539:       // 
 5540:       //  NOTE: We use de-meaned densities.
 5541: 
 5542:       SIDE(side);
 5543: 
 5544: // printf("side->isDry: %d\n", side->isDry);
 5545:       if (side->isDry) return;
 5546: 
 5547:       // Computes the gradient of the variables at the side center.
 5548:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5549:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5550:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5551: 
 5552:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5553:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5554:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5555:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5556: 
 5557: 
 5558:    }
 5559: 
 5560: 
 5561:    __global__ void solveMomentumEquations(double time) {
 5562: 
 5563:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5564:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5565: 
 5566:       SIDE(side);
 5567: 
 5568:       if (side->isDry) 
 5569:       {
 5570:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5571: 
 5572:          return;
 5573:       }
 5574: 
 5575:       const Node *n1 = side->n1;
 5576:       const Node *n2 = side->n2;
 5577: 
 5578:       const int kb = side->kb;
 5579: 
 5580:       const double veg_h = side->veg_h();
 5581:       const double grav3 = side->grav3();
 5582: 
 5583:       if (side->is2D()) {
 5584:          // Warning: Do not use htot2, which is updated.
 5585:          const double htot = side->htot1();
 5586:          const double hhat = side->hhat;
 5587: 
 5588:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5589: 
 5590:          Vector2 tau2 = {0.0, 0.0};
 5591:           
 5592:          if constexpr(ics==1) {
 5593:             tau2 = side->tau();
 5594: 
 5595:          } else {
 5596:             assert(false && "Not implemented: ics == 2");
 5597:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5598:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5599:             // taux2=(vn1+tt1)*0.5d0
 5600:             // tauy2=(vn2+ss1)*0.5d0
 5601:          } // if ics         
 5602: 
 5603:          // hat_gam has units of m/s
 5604: 
 5605:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5606: 
 5607:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5608:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5609: 
 5610:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5611: 
 5612: 
 5613:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5614:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5615: 
 5616:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5617: 
 5618: 
 5619:       }
 5620:       else { // 3D
 5621: 
 5622:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5623:          // 
 5624:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5625:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5626:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5627:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5628:          // k+1 and k.
 5629: 
 5630: 
 5631:    
 5632: 
 5633: 
 5634:          const int ndim = nvrt - kb;
 5635:          const double zTopCanopy = side->zTopCanopy();
 5636: 
 5637:          // Initialize the tridiagonal system
 5638:          for (int k = kb + 1; k < nvrt; k++) {
 5639:             
 5640:             const int kin = k - (kb + 1);
 5641: 
 5642:             // Vertical viscosity at the face center
 5643:             const double dfz = 1e-6; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5644:            
 5645: 
 5646:             alow[kin] = 0.0;
 5647:             cupp[kin] = 0.0;
 5648:             bdia[kin] = 0.0;
 5649: 
 5650:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5651:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5652: 
 5653:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5654:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5655:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5656: 
 5657:             // First part: layers k, k+1
 5658:             if (k < nvrt - 1) {
 5659:                              
 5660:                if constexpr(iveg != 0) {
 5661: 
 5662:                   // If there is vegetation at this level...
 5663:                   if (zTopCanopy > side->zc[k]) {
 5664:                      // If the canopy is above the k layer...
 5665:                      
 5666:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5667:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5668:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5669:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5670: 
 5671:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5672:                      const double vmag2 = length(ut2);
 5673:                      const double vmag1 = length(side->u2[k]);
 5674:                      const double vmag = 0.5*(vmag1 + vmag2);
 5675:                      
 5676:                      // Computes the vegetation alpha at the face center
 5677:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5678: 
 5679:                      cff1 += veg_alpha_sd*dt*vmag;
 5680: 
 5681:                   } // if (zTopCanopy
 5682:                } // if iveg
 5683: 
 5684:                const double dzz = side->Dz(k + 1);
 5685:                const double tmp = dt*dfz/dzz;
 5686:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5687: 
 5688:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5689:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5690:             }
 5691: 
 5692: 
 5693:             // Second part: layers k-1, k
 5694:             if (k > kb + 1) {
 5695: 
 5696:                double cff1 = 1.0; //init \bar{c^k}
 5697: 
 5698:                if constexpr(iveg != 0) {
 5699:                   // If there is vegetation at this level...
 5700:                   if (zTopCanopy > side->zc[k-1]) {
 5701:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5702:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5703: 
 5704:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5705: 
 5706:                      const double vmag2 = length(ut2);
 5707:                      const double vmag1 = length(side->u2[k-1]);
 5708:                      const double vmag = 0.5*(vmag1 + vmag2);
 5709: 
 5710:                      // Computes the vegetation alpha at the face center
 5711:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5712:                      cff1 += veg_alpha_sd*dt*vmag;
 5713:                   } // if zTopCanopy
 5714: 
 5715:                } // if iveg
 5716: 
 5717:                const double dzz = side->Dz(k);
 5718:                const double tmp = dt*dfz/dzz;
 5719:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5720: 
 5721:                alow[kin] += cff1*dzz/6.0 - tmp;
 5722:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5723: 
 5724:             } else { // Bottom boundary
 5725:                // This occurs at the bottom, where the bottom drag is applied.
 5726: 
 5727:                bdia[kin] += dt*side->chi2; // XXXX
 5728: 
 5729: 
 5730:             } // if (k > kb + 1)
 5731: 
 5732: 
 5733: 
 5734:          } // for (int k
 5735: 
 5736: 
 5737: 
 5738:          // Computes the RHS.
 5739:          // -----------------
 5740: 
 5741:          //	BC to be imposed at the end.
 5742: 
 5743:          const Vector2 gradETP  = side->gradETP;
 5744:          const Vector2 gradPr   = side->gradPr;
 5745:          const Vector2 gradEta1 = side->gradEta1;
 5746:          const Vector2 gradEta2 = side->gradEta2;
 5747: 
 5748:          const Vector2 *btu = side->btu;
 5749:          const Vector2 *u2  = side->u2;
 5750:          const double coriolis = side->coriolis;
 5751:          const Vector2 *nuGradU = side->nuGradU;
 5752: 
 5753: 
 5754:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5755: 
 5756:          for (int k = kb + 1; k < nvrt; k++) {
 5757:             const int kin = k - kb - 1;
 5758: 
 5759:             const double dz_0 = side->Dz(k);
 5760:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5761: 
 5762:             rrhs[kin] = {0.0, 0.0};
 5763:             double dz = 0.0;
 5764: 
 5765:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5766:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5767:             if (k < nvrt  ) dz += dz_1;
 5768:             if (k > kb + 1) dz += dz_0;
 5769: 
 5770:             // Elevation gradient, atmospheric pressure and tidal potential
 5771:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5772: 
 5773:             // Coriolis, advection, wind stress, and horizontal viscosity
 5774:             if (k < nvrt - 1) {
 5775: 
 5776: 
 5777:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5778:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5779:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5780:                                                 
 5781: // if (side->idx == 21) printf("$$BBBB$$$ dz_1 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_1, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5782:                //diff stress tensors 1006
 5783:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5784:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5785:                   assert(false && "Not implemented: itur == 5");
 5786:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5787:                }
 5788: 
 5789:             } else { // k == nvrt - 1 SURFACE
 5790:                Vector2 tau2 = {0.0, 0.0};
 5791:                if constexpr(ics==1) {
 5792:                   tau2 = side->tau();
 5793:       
 5794:                } else {
 5795:                   assert(false && "Not implemented: ics == 2");
 5796:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5797:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5798:                   // taux2=(vn1+tt1)*0.5d0
 5799:                   // tauy2=(vn2+ss1)*0.5d0
 5800:                } // if ics
 5801: 
 5802:                rrhs[kin] += dt*tau2;
 5803: 
 5804:             } // if k<nvrt
 5805: 
 5806:             if (k > kb + 1) {
 5807:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5808:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5809:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5810: 
 5811:                // diff stress tensors 1006
 5812:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5813:                   assert(false && "Not implemented: itur == 5");
 5814:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5815:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5816:                }
 5817: 
 5818:             } // if k>kbs + 1
 5819: 
 5820:             // Baroclinic
 5821:             Vector2 *bcc = side->bcc;
 5822:             if constexpr(ibc == 0) {
 5823:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5824:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5825: 
 5826:             } // if ibc==0
 5827: 
 5828:          } // k=kb + 1,nvrt
 5829: 
 5830: 
 5831:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5832: 
 5833:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5834:             const int kin = k - kb - 1;
 5835: 
 5836:             // Velocity is always clamped to maximum values
 5837:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5838:          } // k
 5839: 
 5840:       } // if side->is2D()
 5841:       
 5842: 
 5843:       // Impose velocity boundary condition at the bottom
 5844:       if constexpr(imm == 2) { // 3D bed deformation model
 5845:          double dep;
 5846:          Vector2 vel;
 5847: 
 5848:          assert(false && "Not implemented: imm == 2");
 5849:          //update_bdef(time, x0, y0, dep, vel);
 5850:          // side->u2[kb] = vel;
 5851: 
 5852:       } else { // imm = 0 or 1
 5853:          if (side->Cd() == 0.0) {
 5854:             side->u2[kb] = side->u2[kb + 1];
 5855: 
 5856:          } else if (side->is3D()) { // 3D no slip bottom   
 5857:             side->u2[kb] = {0.0, 0.0};
 5858:          }
 5859:           
 5860:       } // if imm
 5861: 
 5862:       // The velocities below the bottom level are set to zero
 5863:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5864: 
 5865: 
 5866:    }
 5867: 
 5868: 
 5869:    __global__ void applyMomentumBC(void) {
 5870: 
 5871:       SIDE_BND(sideBnd);
 5872: 
 5873:       Side *side = sideBnd->side;
 5874:       const BoundarySegment *segment = sideBnd->segment;
 5875:       const Node *n1 = side->n1;
 5876:       const Node *n2 = side->n2;
 5877: 
 5878:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5879: 
 5880:       const bool isLand = segment->isLand;
 5881:       const int ifltype = segment->ifltype;
 5882: 
 5883:       const int kb = side->kb;
 5884: 
 5885:       if (!isLand && ifltype != 0) {
 5886:          const Vector2 *ubc = sideBnd->ubc;
 5887:   
 5888:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5889:             
 5890:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5891:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5892: 
 5893:             if (ifltype == -1) {
 5894:                // Flather 1
 5895: 
 5896:                const double depth = side->depth();
 5897: 
 5898:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5899: 
 5900:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5901: 
 5902:                side->u2[k] = vnorm*side->n;
 5903: 
 5904:             } else if (ifltype == -2) { // Discharge
 5905: 
 5906:                const double eta1 = side->eta1();
 5907:                const double eta2 = side->eta2();
 5908:                const double htot = side->htot2();
 5909: 
 5910:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5911:                assert(false && "Not implemented: Discharge bc");
 5912:                // const double dischrg = discharge(eta1);
 5913:                const double dischrg = 0.0; // XXX REMOVE
 5914:                
 5915: 
 5916:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5917: 
 5918:                const double vnorm = dischrg*eta2/htot;
 5919: 
 5920:                side->u2[k] = vnorm*side->n;
 5921: 
 5922:             }
 5923:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5924:                const double vnorm = dot(side->u2[k], side->n);
 5925: 
 5926:                double rat;
 5927:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5928:                else              rat = segment->vobc2; // outgoing
 5929: 
 5930:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5931: 
 5932:             }
 5933:             else { // not Flather or 3D radiation
 5934:                side->u2[k] = ubc[k];
 5935: 
 5936:             } // if (segment->ifltype...
 5937: 
 5938:          }
 5939: 
 5940:       }
 5941:       else if (isLand) { // if it is land boundary side
 5942: 
 5943:          if constexpr(islip == 0) { // free slip
 5944: 
 5945:             for (int k = kb; k < nvrt; k++) {
 5946: 
 5947:                const Vector2 t = side->t();
 5948:                const Vector2 n = side->n;
 5949: 
 5950:                double vnorm = 0.0; // for most cases
 5951:                const double vtan = dot(side->u2[k], t);
 5952:                
 5953:                side->u2[k] = vtan*t - vnorm*n;
 5954: 
 5955:             }
 5956: 
 5957:          } else { // no slip
 5958:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5959: 
 5960:          }
 5961:       } // if (side segment type...
 5962: 
 5963:    
 5964: 
 5965:    }
 5966: 
 5967: 
 5968:    __global__ void shapiroFilter1(void) {
 5969:       // First step of the Shapiro filter (normally used if indvel<=0)
 5970:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5971: 
 5972:       SIDE(side);
 5973: 
 5974:       // Only internal wet sides are processed
 5975:       if (side->isDry || !(side->isInternal())) return;
 5976: 
 5977:       const int kb = side->kb;
 5978: 
 5979:       for (int mm = 0; mm < niter_shap; mm++) {
 5980: 
 5981:          for (int k = kb + 1; k < nvrt; k++) {
 5982:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5983:             Vector2 suru = {0.0, 0.0};
 5984: 
 5985:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5986: 
 5987:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5988: 
 5989:                int kin = k;
 5990:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5991:                
 5992:                if constexpr(ics==1) {
 5993:                   suru += nSide->u2[kin];
 5994: 
 5995:                } else {
 5996:                   assert(false && "Not implemented: ics == 2");
 5997:                   // Vector2 vn1, vn2;
 5998:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5999:                   // suru=suru+vn1;
 6000:                   // surv=surv+vn2;
 6001:                }
 6002:             }
 6003: 
 6004: 
 6005:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 6006: 
 6007:          }
 6008:       }
 6009:    }
 6010: 
 6011:    __global__ void shapiroFilter2(void) {
 6012:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6013: 
 6014:       SIDE(side);
 6015: 
 6016:       if (side->isDry || !(side->isInternal())) return;
 6017: 
 6018:       const int kb = side->kb;
 6019: 
 6020:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6021: 
 6022:       if (side->is2D()) {
 6023:          side->u2[kb + 1] = side->bcc[kb + 1];
 6024:          side->u2[kb    ] = side->u2 [nvrt - 1];
 6025: 
 6026:       } else {
 6027:          // 3D
 6028:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6029:          
 6030:       }
 6031: 
 6032:    }
 6033: 
 6034: 
 6035:    __global__ void ul0UpdateZCoords(void) {
 6036:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6037:       
 6038:       NODE(node);      
 6039: 
 6040: 
 6041:       if (node->isDry2()) { 
 6042: 
 6043:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6044: 
 6045:          if constexpr(ivcor != 1) node->kb = 0;
 6046: 
 6047:       } else {
 6048: 
 6049:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6050:          node->updateKb();
 6051: 
 6052:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6053: 
 6054:       }
 6055: 
 6056:       // We use the temp.b field to store the previous state of isDry.
 6057:       node->tmp.b = node->isDry;
 6058: 
 6059:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6060:       node->isDry = true;
 6061: 
 6062:    }
 6063: 
 6064:    __global__ void ul0ComputeDryElementsAndNodes(void)
 6065:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 6066:    {
 6067:       ELEM(elem);
 6068: 
 6069:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 6070: 
 6071:       // All the nodes of a wet element are wet.
 6072:       if (!elem->isDry) {
 6073:          elem->nodes[0]->isDry = false;
 6074:          elem->nodes[1]->isDry = false;
 6075:          elem->nodes[2]->isDry = false;
 6076:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 6077: 
 6078:       }
 6079: 
 6080: 
 6081:       elem->kb = 0;
 6082: 
 6083:       if (elem->isDry) return;
 6084: 
 6085:       // Wet
 6086:       const Node *n1 = elem->nodes[0];
 6087:       const Node *n2 = elem->nodes[1];
 6088:       const Node *n3 = elem->nodes[2];  
 6089:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 6090: 
 6091:    //    if(elem->isDry2()) {
 6092:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6093:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6094:    //        call parallel_abort(errmsg)
 6095:    //    }
 6096: 
 6097: 
 6098:       // Computes element's kb as the minimum of the nodes' kb.
 6099:       const int kb1 = n1->kb;
 6100:       const int kb2 = n2->kb;
 6101:       const int kb3 = n3->kb;
 6102:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6103: 
 6104: 
 6105:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6106: 
 6107: 
 6108:       // Computes the element z as the mean of the nodes z.
 6109:       for (int k = elem->kb; k < nvrt; k++) {
 6110: 
 6111:          // Compute the element z as the mean of the nodes z.
 6112:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 6113:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6114:          elem->z[k] /= elem->i34;
 6115: 
 6116:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6117:       }
 6118:                   
 6119:    }
 6120: 
 6121:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6122:    {
 6123:       NODE(node);
 6124:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6125: 
 6126:       if (it == iths) return;
 6127: 
 6128: 
 6129:       if(!node->isDry && node->tmp.b) { // rewetted
 6130:          for (int k=0; k < nvrt; k++) {
 6131: 
 6132:             Vector3 utmp={0.0, 0.0, 0.0};
 6133: 
 6134:             double ttmp=0.0;
 6135:             double stmp=0.0;
 6136:             int icount=0;
 6137:             for (int j = 0; j < node->numNodes; j++) {
 6138: 
 6139: 
 6140:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 6141:                if (!node->isDry) { // all indices extended
 6142:                   icount++;
 6143: 
 6144:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6145:                   utmp += node->uvw2(k);
 6146:                   
 6147:                   ttmp += node->tracers[k].tracer[0]; 
 6148:                   stmp += node->tracers[k].tracer[1]; 
 6149:                }
 6150:             }
 6151: 
 6152:             if(icount > 0) {
 6153:                const double inv_icount = 1.0/icount;
 6154:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 6155:                node->w2[k]     = inv_icount*utmp.z;
 6156:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6157:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6158:             }
 6159:          }
 6160:       }
 6161:    }
 6162: 
 6163: 
 6164:    __global__ void ul0UpdateSides(int it, int iths) {
 6165: 
 6166:       SIDE(side);
 6167: 
 6168:       // A side is wet if and only if at least one of its elements is wet.
 6169:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6170: 
 6171:       const Node *n1 = side->n1;
 6172:       const Node *n2 = side->n2;
 6173:       const int kb1 = n1->kb;
 6174:       const int kb2 = n2->kb;
 6175: 
 6176:       side->kb = 0; // dry
 6177: 
 6178:       if (isWet) {
 6179: 
 6180:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6181: 
 6182:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6183: 
 6184:          side->kb = min(kb1, kb2);
 6185: 
 6186:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6187: 
 6188:          for (int k = side->kb; k < nvrt; k++) {
 6189:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6190: 
 6191:          
 6192:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 6193: 
 6194:             // Compute velocity for re-wetted sides 
 6195:             if ((it != iths) && (side->isDry && isWet)) {
 6196:             
 6197:                Vector2 utmp={0.0, 0.0};
 6198: 
 6199:                int icount=0;
 6200: 
 6201:                // For all the sides on the two elements that share this side
 6202:                for (int j=0; j < 2; j++) {
 6203:                   const Element *elem = side->elems[j];
 6204:                   if (elem == nullptr) continue;
 6205: 
 6206:                   for (int jj=0; jj < elem->i34; jj++) {
 6207:                      const Side *nSide = elem->sides[jj];
 6208:                      if (nSide->isDry) continue;
 6209: 
 6210:                      icount++;
 6211:                      utmp += nSide->u2[k];                     
 6212:                   }
 6213:                }
 6214:                   
 6215:                assert(icount > 0 && "No wet sides around this side");
 6216:                if (icount > 0)  side->u2[k] = utmp/icount;
 6217:                   
 6218:             } // if ((it != iths) && (side->isDry && isWet))
 6219: 
 6220:          } // for k
 6221: 
 6222:       } // if isWet
 6223:    
 6224:       side->isDry = !isWet;
 6225: 
 6226:    }
 6227: 
 6228: 
 6229:    __global__ void zeroNodalVelocities(void) {
 6230:       NODE(node);
 6231: 
 6232:       for (int k = 0; k < nvrt; k++) {
 6233:          node->u2[k]   = {0.0, 0.0};
 6234:          node->w2[k]   = 0.0;
 6235:          node->utmp[k] = {0.0, 0.0};
 6236:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6237:       }
 6238:    }
 6239: 
 6240:  
 6241: 
 6242:    __global__ void computeNodalVerticalVelocities1(void) {
 6243:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6244:    // Adds the element's vertical velocity times the element's area.
 6245:       ELEM(elem);
 6246: 
 6247:       for (int j = 0; j < elem->i34; j++) {
 6248:          Node *node = elem->nodes[j];
 6249: 
 6250:          for (int k = node->kb; k < nvrt; k++) {
 6251:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6252:          }
 6253:          atomicAdd(&(node->tmp.d), elem->area);
 6254:       }
 6255:    }
 6256: 
 6257:    __global__ void computeNodalVerticalVelocities2(void) {
 6258:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6259:    // Divides by the total area of the elements sharing the    node.
 6260:       NODE(node);
 6261: 
 6262:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6263:    }
 6264: 
 6265: 
 6266:    __global__ void computeNodalHorizontalVelocities1(void) {
 6267:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6268:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6269: 
 6270:       ELEM(elem);
 6271: 
 6272:       const int kb = elem->kb;
 6273:       const bool isTri = elem->isTri();
 6274: 
 6275:       if constexpr(indvel <= 0) {
 6276:          // Assuming discontinoius hvel.
 6277: 
 6278: 
 6279:          if (isTri) { // For triangles
 6280:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6281:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6282: 
 6283:             for (int j = 0; j < 3; j++) {
 6284:                // For every node of the triangle...
 6285:                Node *node = elem->nodes[j];
 6286: 
 6287:                const Side *s1 = elem->sides[j];
 6288:                const Side *s2 = elem->sides[(j + 1) % 3];
 6289:                const Side *s3 = elem->sides[(j + 2) % 3];
 6290: 
 6291:                const int numElements = node->numElements;
 6292:                const double inv_numElements = 1.0/numElements;
 6293: 
 6294:                for (int k = kb; k < nvrt; k++)  {
 6295:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6296:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6297:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6298:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6299:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6300:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6301: 
 6302:                }
 6303: 
 6304:             }
 6305:          }
 6306:          else { // For quads
 6307:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6308: 
 6309:          }
 6310: 
 6311:       }
 6312:       
 6313:    }
 6314: 
 6315: 
 6316:    __global__ void computeNodalHorizontalVelocities2(void) {
 6317:       NODE(node);
 6318: 
 6319:       for (int k = 0; k < nvrt; k++) {
 6320:          node->u2[k] = node->utmp[k];
 6321:          node->w2[k] = node->w2[k];
 6322:       }
 6323:       
 6324:    }   
 6325: 
 6326:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6327:    // XXXX I'm not sure where I got this function from. 
 6328:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6329:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6330:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6331:    // It uses the utmp array as a temporary array to store the velocities.
 6332: 
 6333:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6334: 
 6335:       SIDE(side);
 6336: 
 6337:       const int kb = side->kb;
 6338: 
 6339:       Node *n1 = side->n1;
 6340:       Node *n2 = side->n2;
 6341: 
 6342:       for (int k = kb; k < nvrt; k++) {
 6343: 
 6344:          // Cast the u2 vector into a Vector2 
 6345:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6346:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6347: 
 6348:          n1_u2 = side->u2[k]/n1->numSides;
 6349:          n2_u2 = side->u2[k]/n2->numSides;
 6350: 
 6351:       }
 6352: 
 6353: 
 6354:    }
 6355: 
 6356:    __global__ void resetVelocityOpenBndNodes(void) {
 6357:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6358: 
 6359:       NODE_BND(nodebnd);
 6360: 
 6361:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6362:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6363:       }
 6364: 
 6365:    }
 6366: 
 6367: 
 6368:    __global__ void setVelocityOpenBndNodes(void) {
 6369:    // For open boundary nodes sets their velocity to the imposed values.
 6370: 
 6371:       SIDE_BND(sidebnd);
 6372: 
 6373:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6374:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6375:          // to its segment to the average of the side velocity.
 6376: 
 6377:          for (int k = 0; k < nvrt; k++) {
 6378:             Node *n1 = sidebnd->side->n1;
 6379:             Node *n2 = sidebnd->side->n2;
 6380: 
 6381: 
 6382:             Vector2 n1_u2(n1->u2[k]);
 6383:             Vector2 n2_u2(n2->u2[k]);
 6384: 
 6385:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6386:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6387:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6388:             }
 6389:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6390:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6391:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6392:             }
 6393: 
 6394:          }
 6395: 
 6396:       }
 6397: 
 6398:    }
 6399: 
 6400: 
 6401:    __global__ void computeVerticalVelocity(void) {
 6402:       // Computes the vertical velocity at the (2D) element's centroid.
 6403:       // In this function we will be considering volumetric elements, with side faces and a 
 6404:       // bottom and a top face. We will call them SFs, BF and TF.
 6405:       // It computes the flux coming from BF and the SFs.
 6406:       // If the bed is moving, it takes that into account.
 6407:       // Since water is incompressible, the integral of the velocity times the normal vector
 6408:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6409:       // and the BF is equal to the flux going out from the TF.
 6410:       // TF = - BF - sum(SFs).
 6411:       // It then computes the horizontal velocity at the center of TF.
 6412:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6413:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6414:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6415: 
 6416:       ELEM(elem);
 6417: 
 6418:       if (elem->isDry) return;
 6419: 
 6420:       const int kb = elem->kb;
 6421:       const bool isTri = elem->isTri();
 6422: 
 6423:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6424: 
 6425:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6426:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6427:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6428: 
 6429:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6430: 
 6431:       double area3D;
 6432: 
 6433:       // Bottom face flux
 6434:       double bottomFlux = 0.0;
 6435:       Vector2 u2meanBottom = {0.0, 0.0};
 6436:       const Vector2 gradh = elem->grad2(&Node::depth);
 6437:       if constexpr(imm==2) {
 6438:          Vector3 ubed;
 6439: 
 6440:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6441:          // updateBDEF(ubed);
 6442:      
 6443:          // const double bflux0 = dot(ubed, elem_n1);
 6444: 
 6445:          // elem->w[kb] += ubed.z;
 6446:       }
 6447:       else {
 6448:          Vector2 umean;
 6449:          if constexpr(ics == 1) {
 6450:             u2meanBottom = elem->mean(kb, &Side::u2);
 6451:          }
 6452:          else {
 6453:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6454:          }
 6455: 
 6456:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6457:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6458: 
 6459:          bottomFlux = - dot(gradh, u2meanBottom);
 6460:       } // if imm
 6461: 
 6462:       // Compute w for kb+1 to nvrt-1
 6463:       for (int l = kb; l < nvrt - 1; l++) {
 6464: 
 6465:          // normal vector to the top face of the "volumetric" element (3D)
 6466:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6467: 
 6468:          // Compute the total flux at the sides
 6469:          double sideFlux = 0.0;
 6470:          Vector2 u2top = {0.0, 0.0};
 6471:          for (int j = 0; j < elem->i34; j++) {
 6472:             const Side *side = elem->sides[j];
 6473: 
 6474:             const double sideArea = side->area(l);
 6475:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6476:             const double sign = elem->ssign[j]; 
 6477: 
 6478:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6479:          }
 6480:          
 6481:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6482:          //velocities at the centers of the sides
 6483:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6484: 
 6485:          // The flx at the top ace can be computed from the other flows.
 6486:          const double topFlux = - sideFlux - bottomFlux;
 6487:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6488: 
 6489:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6490: 
 6491:          elem_n1 = elem_n2;
 6492: 
 6493:          bottomFlux = - topFlux;
 6494:       }
 6495:    }  
 6496: 
 6497: 
 6498: 
 6499: 
