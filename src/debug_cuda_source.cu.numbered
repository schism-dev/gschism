 1015: // This struct is used to store the boundary information for a node.
 1016: struct NodeBoundary {   
 1017:    BoundarySegment *segment;
 1018:    Node *node;
 1019:    
 1020:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1021:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1022: 
 1023:    double etaic;  // Elevation at nodes used for essential boundary conditions
 1024:    double elbc;   // Elevation boundary condition
 1025:    int iettype;   // Type of elevation boundary condition
 1026:    double eth;    // Elevation time history
 1027: 
 1028:    double eta_mean; // Mean elevation at nodes
 1029: 
 1030:    bool isEssentialBC;
 1031: 
 1032: 
 1033:    // Arrays for harmonic constituents (if needed)
 1034:    double emo[nbfr];  // Elevation amplitude
 1035:    double efa[nbfr];  // Elevation phase
 1036:    double umo[nbfr];  // U-velocity amplitude
 1037:    double ufa[nbfr];  // U-velocity phase
 1038:    double vmo[nbfr];  // V-velocity amplitude
 1039:    double vfa[nbfr];  // V-velocity phase 
 1040: 
 1041:    
 1042:    __forceinline__ __device__ int numSidesForAverage() const {
 1043:    // Returns the number of sides that are connected to the node and have the same segment.
 1044:    // This is used to compute the average velocity at the node for open boundary nodes.
 1045:       int res = 0;
 1046:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1047:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1048:       return res;
 1049:    }
 1050: 
 1051: 
 1052:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1053:       assert(index == 0 || index == 1); 
 1054:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1055:    }
 1056: 
 1057: 
 1058: };
