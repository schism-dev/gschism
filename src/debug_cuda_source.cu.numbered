 5025:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5026: 
 5027:       SIDE(side);
 5028: 
 5029:       side->U = {0.0, 0.0}; 
 5030:          
 5031:       if(side->isDry) return;
 5032: 
 5033:       // Vertically integrated velocity U (in ll if ics=2)
 5034:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5035:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5036:          side->U += side->Dz(k + 1)*uc;  
 5037:       }
 5038: 
 5039:    }
