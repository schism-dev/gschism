 2249:    template<typename T>
 2250:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2251:       T values[4];
 2252:       getNodalValues(field, values);
 2253: 
 2254:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2255:       if constexpr (IsVector2<T>::value && ics == 2) {
 2256: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2257:          projectNodeVectorsToElementFrame(values);
 2258: printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2259:       }
 2260: 
 2261:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2262:    }
 2263: 
 2264:    template<typename T>
 2265:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2266:       T values[4];
 2267:       getSideValues(field, values);
 2268:       
 2269:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2270:       if constexpr (IsVector2<T>::value && ics == 2) {
 2271: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2272:          projectSideVectorsToElementFrame(values);
 2273: printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2274:       }
 2275: 
 2276:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2277:    }   
 2278: 
 2279:    template<typename T>
 2280:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2281: 
 2282:       T values[4];
 2283: 
 2284: 
 2285:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2286:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2287:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2288:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2289:       else          values[3] = T();
 2290: 
 2291:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2292: 
 2293:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2294:    }
