 7923:          break;
 7924:       // case (int)VarCode::depth:
 7925:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 7926:       //    *sizeType = sizeof(double);
 7927:       //    break;         
 7928:       case (int)VarCode::x:
 7929:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 7930:          *sizeType = sizeof(Vector2);
 7931:          break;
 7932:       case (int)VarCode::len:
 7933:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 7934:          *sizeType = sizeof(double);
 7935:          break;
 7936:       case (int)VarCode::kb:
 7937:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7938:          *sizeType = sizeof(int);
 7939:          break;
 7940:       case (int)VarCode::isdry:
 7941:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7942:          *sizeType = sizeof(int);
 7943:          break;            
 7944:       case (int)VarCode::w:
 7945:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7946:          *sizeType = sizeof(double);
 7947:          break;
 7948:       case (int)VarCode::u:
 7949:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7950:          *sizeType = sizeof(Vector2);
 7951:          break;   
 7952:       case (int)VarCode::n1:
 7953:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7954:          *sizeType = sizeof(Node);
 7955:          break;
 7956:       case (int)VarCode::n2:
 7957:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7958:          *sizeType = sizeof(Node);
 7959:          break;                   
 7960:       default:
 7961:          *offset = -1;
 7962:    }
 7963: }
