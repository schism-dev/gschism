 8116: __global__ void printMatrix(bool full) {
 8117:    // Debugging: print the matrix
 8118: 
 8119:    const int size = mesh->np;
 8120:    double sum = 0.0;
 8121:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8122:       const Node *node = mesh->localNodeData + idx_node;
 8123:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8124:       for (int j = 0; j < node->numNodes; j++) {
 8125:          Node* nbNode = node->nodes[j];
 8126:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8127:          sum += node->coeffMatrix[j];
 8128:       }
 8129:       if (full) printf("]\n");
 8130: 
 8131: 
 8132:    }
 8133:    if (!full) printf("sum=%lf\n", sum);
 8134: }
