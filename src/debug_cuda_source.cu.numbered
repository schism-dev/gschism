 1057: struct Element {
 1058: 
 1059:    // Geometry information
 1060:    int idx;                   // Index of the element
 1061:    int16_t i34;               // Number of sides for the element 
 1062:    Side *sides[4];            // Sides of the element
 1063:    Node *nodes[4];            // Nodes of the element
 1064:    Element *nghbElems[4];     // Neighbors of the element
 1065: 
 1066:    int16_t kb;                // Bottom index of the element
 1067:    double area;               // Area of the element
 1068:    double ssign[4];           // Sign associated with each side of an element
 1069:    double radius;             // Element equivalent radii
 1070: 
 1071:    Frame<ics> frame;
 1072: 
 1073:    Vector2 gradPhi[4];        // Derivatives of shape functions
 1074:    Vector2 gradEta;           // Gradient of free surface elevation
 1075:    Vector2 gradPr;            // Gradient of pressure    
 1076:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
 1077: 
 1078:    bool isDry;                // True if the element is dry
 1079: 
 1080:    Point2 center;            // Element center coordinates (global coordinates)
 1081: 
 1082:    double depth;              // Depth at element (min of all nodes)
 1083:    double z[nvrt];            // z-coord  (local frame - vertical up)
 1084: 
 1085:    // Physical information
 1086:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
 1087:    TransportElem<transportModel> transport; // Transport model 
 1088: 
 1089:    static const bool isblock = false;              // Always false
 1090: 
 1091:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
 1092:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
 1093: 
 1094:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
 1095:    
 1096: 
 1097:    double vsource;            // Volumetric source/sink term [m^3/s]
 1098: 
 1099:    double rho[nvrt];          // Density at each prism center
 1100:    double rho_mean[nvrt];     // Mean density at each prism center
 1101:    CubicSpline rho_spl;
 1102:    double rho_zz[nvrt];       // Second derivative of density at each prism center
 1103:    double rho_z[nvrt];        // First derivative of density at each prism center
 1104:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
 1105:    
 1106: 
 1107:    __inline__ __device__ Point2 outputCoords(void) const;
 1108: 
 1109:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
 1110: 
 1111:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1112:    // If ics == 2, convert the global point to the local frame of the element
 1113:       
 1114:       if constexpr (ics == 1) {
 1115:          return p;
 1116:       } else {
 1117:          const Point3 c = {center.x, center.y, centerZ()};
 1118:          return frame.G2L(p - c);
 1119:       }
 1120:    }
 1121: 
 1122:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1123:    // If ics == 2, convert the local point to a global point
 1124:       
 1125:       if constexpr (ics == 1) {
 1126:          return p;
 1127:       } else {
 1128:          const Point3 c = {center.x, center.y, centerZ()};
 1129:          return c + frame.L2G(p);
 1130:       }
 1131:    }
 1132: 
 1133:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
 1134:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
 1135: 
 1136:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1137:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1138: 
 1139:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
 1140:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
 1141:       // Find the local index of the node in the element (0,1,2,3)
 1142:       int res = __ffs((nodes[0] == node) | 
 1143:                      ((nodes[1] == node) << 1) | 
 1144:                      ((nodes[2] == node) << 2) | 
 1145:                      ((nodes[3] == node) << 3)) - 1;
 1146:       
 1147:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
 1148:       return res;  
 1149:    }
 1150: 
 1151:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
 1152:       // Find the local index of the side in the element (0,1,2,3)
 1153:       int res = __ffs((sides[0] == side) | 
 1154:                      ((sides[1] == side) << 1) | 
 1155:                      ((sides[2] == side) << 2) | 
 1156:                      ((sides[3] == side) << 3)) - 1;
 1157:       
 1158:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
 1159:       return res;
 1160:    }
 1161: 
 1162:    __inline__ __device__ int findLevel(double z1, int k) const {
 1163:       // Starting at index k, find sequentially the level that contains z
 1164: 
 1165:       // For testing purposes, forgets k and performs a full search.
 1166:       for (k = kb; k < nvrt - 1; k++) {
 1167:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1168:       }
 1169:       return nvrt - 2;
 1170: 
 1171: 
 1172:       // if z is already betweeen z[k] and z[k+1], return k
 1173:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1174:       else if (z1 <  z[k]) { 
 1175:          // Search for increasing levels
 1176:          for (int kk = k; kk < nvrt - 1; kk++) {
 1177:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1178:          }
 1179:          return nvrt - 1;
 1180:       }
 1181:       else {
 1182:          // Search for decreasing levels
 1183:          for (int kk = k; kk >= kb; kk--) {
 1184:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1185:          }
 1186:          return 0;
 1187:       }
 1188:    }
 1189: 
 1190:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
 1191:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
 1192:    __inline__ __device__ double volume(int k)  const { assert(k < nvrt - 1); return area * Dz(k); }
 1193: 
 1194: 
 1195:    __device__ __forceinline__ double centerZ(void) const;
 1196: 
 1197:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
 1198:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
 1199:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
 1200:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
 1201:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
 1202:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
 1203:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 1204:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
 1205:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
 1206: 
 1207: 
 1208:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
 1209:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
 1210:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
 1211:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
 1212:        const double eta = (idxNode & 1) ? +g : -g;
 1213:        const double xi  = (idxNode & 2) ? +g : -g;
 1214:        return {eta, xi};
 1215:    }  
 1216: 
 1217: 
 1218: 
 1219:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
 1220:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
 1221:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
 1222:    }
 1223: 
 1224:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
 1225:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
 1226:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
 1227:    }   
 1228: 
 1229:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
 1230:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
 1231:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
 1232:    }      
 1233:    
 1234:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1235: 
 1236:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1237: 
 1238:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
 1239:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
 1240: 
