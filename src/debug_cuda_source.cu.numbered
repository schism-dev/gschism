 1516: struct Mesh {
 1517:    public:  
 1518: 
 1519:    int partNum; // Partition number for this mesh.
 1520: 
 1521:    // Pointers to each GPU's local memory (size is the number of partitions).
 1522:    Node**    nodes;  
 1523:    Element** elems;  
 1524:    Side**    sides;  
 1525:    
 1526:    // Local memory
 1527:    Node*    localNodeData; 
 1528:    Element* localElemData;
 1529:    Side*    localSideData; 
 1530: 
 1531:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1532:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1533:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1534:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1535:    
 1536:    const int npgb;  // Global number of horizontal nodes
 1537:    const int negb;  // Global number of elements
 1538:    const int nsgb;  // Global number of sides
 1539: 
 1540:    const int np;   // Local number of horizontal nodes 
 1541:    const int ne;   // Local number of elements
