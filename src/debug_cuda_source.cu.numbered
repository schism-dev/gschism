 9458: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 9459:    Node *nodes = mesh->localNodeData;
 9460: 
 9461:    *addr = nodes;
 9462:    *sizeNode = sizeof(Node);
 9463: 
 9464:    switch (varCode) {
 9465:       case (int)VarCode::depth:
 9466:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 9467:          *sizeType = sizeof(double);
 9468:          break;
 9469:       case (int)VarCode::eta:
 9470:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 9471:          *sizeType = sizeof(double);
 9472:          break;
 9473:       case (int)VarCode::x:
 9474:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 9475:          *sizeType = sizeof(Vector2);
 9476:          break;
 9477:       case (int)VarCode::z:
 9478:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 9479:          *sizeType = sizeof(double);
 9480:          break;
 9481:       case (int)VarCode::kb:
 9482:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 9483:          *sizeType = sizeof(int);
 9484:          break;
 9485:       case (int)VarCode::isdry:
 9486:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 9487:          *sizeType = sizeof(int);
 9488:          break;         
 9489:       case (int)VarCode::w:
 9490:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 9491:          *sizeType = sizeof(double);
 9492:          break;
 9493:       case (int)VarCode::u:
 9494:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 9495:          *sizeType = sizeof(Vector2);
 9496:          break;  
 9497:       case (int)VarCode::u_air:
 9498:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 9499:          *sizeType = sizeof(Vector2);
 9500:          break;
 9501:       default:
 9502:          *offset = -1;    
 9503:    }  
 9504:    
 9505: }
