 6802: //                     call parallel_abort(errmsg)
 6803: //                   endif
 6804: // #endif
 6805: 
 6806: //                 enddo !i
 6807: //                 wm=wm/sum1 !final weight
 6808: 
 6809:                 for (int j=0; j<elem->i34; j++) { // side
 6810:                   const Side *side = elem->sides[j];
 6811:                   const Node *node1 = side->n1;
 6812:                   const Node *node2 = side->n2;
 6813: 
 6814:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6815:                     trsd=0.d0
 6816:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6817:                       for (int i=0; i<elem->nweno1; i++) {
 6818:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6819:                       }
 6820:                     enddo //kk
 6821:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6822:                   } // outward flux
 6823:                 } // end for j=1,i34(ie) ! side
 6824:               } // end for k; ntr 
 6825: 
 6826:             else !simple upwind method
 6827:               do j=1,i34(ie)
 6828:                 jsj=elside(j,ie)
 6829:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6830:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6831:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6832:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6833:                   endif
 6834:                 enddo  !vertical layers
 6835:               enddo !j=1,i34(ie) ! side
 6836:             endif !order of accuracy
