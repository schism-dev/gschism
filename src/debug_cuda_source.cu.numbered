  312: // ------------------------------------------------------------------------------------------------
  313: 
  314: 
  315: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  316:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  317:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  318: }
  319: 
  320: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  321:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  322:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  323: }
  324: 
  325: 
  326: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  327:    x3 = y1*z2 - y2*z1;
  328:    y3 = x2*z1 - x1*z2;
  329:    z3 = x1*y2 - x2*y1;
  330: }
  331: 
  332: 
  333: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  334: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  335: 
  336:    const double radius2 = dot(p, p);
  337:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  338:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  339: 
  340:    rlon = atan2(p.y, p.x); // (-pi,pi]
  341: 
  342:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  343:       rlat = asin(p.z/sqrt(radius2));
  344:    } else {
  345:       rlat = asin(p.z/rearth_pole);
  346:    }
  347:   
  348: }
  349: 
  350: __inline__ __device__ void Error(const char* msg) {
  351:    printf("Error: %s\n", msg);
  352:    assert(false);
  353: }
  354: 
  355: struct Tracers {
  356:     double tracer[N_TRACERS];
  357: };
  358: 
  359: 
  360: 
  361: struct Frame {
  362:    double _t[9]; // t stands for tensor.
  363: 
  364:    // Access the tensor in Fortran order
  365:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  366: 
  367:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  368: 
  369:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  370: 
  371:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  372:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  373:       sincos(ar2, &sin_ar2, &cos_ar2);
  374: 
  375:       t(0,0) = -sin_ar1;
  376:       t(1,0) =  cos_ar1;
  377:       t(2,0) =  0.0;
  378:       t(0,1) = -cos_ar1*sin_ar2;
  379:       t(1,1) = -sin_ar1*sin_ar2;
  380: 
  381:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  382: 
  383:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  384:       assert (ar4!=0.0 && "GRID: ar4=0");
  385: 
  386:       const double ar4_inv = 1.0/ar4;
  387:       t(0,1) = t(0,1)*ar4_inv;
  388:       t(1,1) = t(1,1)*ar4_inv;
  389:       t(2,1) = t(2,1)*ar4_inv;
  390: 
  391:       // The third vector is the cross product of the first two
  392:       crossProduct(t(0,0), t(1,0), t(2,0), 
  393:                    t(0,1), t(1,1), t(2,1), 
  394:                    t(0,2), t(1,2), t(2,2));
  395:    }
  396: 
  397: 
  398:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  399:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  400:    // Inputs:
  401:    //        vec0: vel. in this frame;
  402:    //        frameout: Output frame;
  403:    // Output: 
  404:    //        vec1: vel. in new frame  
  405: 
  406:       auto const fo = frameout;
  407:       Vector2 vec1;
  408: 
  409:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  410:       // of t and fo.t are the same.
  411:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  412:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  413: 
  414:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  415:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  416: 
  417:       return vec1;
  418:    }
  419: 
  420:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  421:       // Transform a vector from global to local frame
  422:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  423:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  424:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  425:    }
  426: 
  427:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  428:       // Transform a vector from local to global frame
  429:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  430:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  431:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  432:    }   
  433: 
  434:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  435:    // Tranforms a point from global to local frame     
  436:       G2L(pi - origin0, po);
  437:    }
  438: 
  439:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  440:    // Transforms a point from local to global frame      
  441:       L2G(pi, po);
  442:       po = po + origin0;
  443:    }
  444: 
  445: };
