  329: 
  330: 
  331: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  332:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  333:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  334: }
  335: 
  336: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  337:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  338:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  339: }
  340: 
  341: 
  342: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  343:    x3 = y1*z2 - y2*z1;
  344:    y3 = x2*z1 - x1*z2;
  345:    z3 = x1*y2 - x2*y1;
  346: }
  347: 
  348: 
  349: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  350: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  351: 
  352:    const double radius2 = dot(p, p);
  353:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  354:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  355: 
  356:    rlon = atan2(p.y, p.x); // (-pi,pi]
  357: 
  358:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  359:       rlat = asin(p.z/sqrt(radius2));
  360:    } else {
  361:       rlat = asin(p.z/rearth_pole);
  362:    }
  363:   
  364: }
  365: 
  366: __inline__ __device__ void Error(const char* msg) {
  367:    printf("Error: %s\n", msg);
  368:    assert(false);
  369: }
