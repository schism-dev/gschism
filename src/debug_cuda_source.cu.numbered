 8347: 
 8348: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8349:    // Get the value of a variable from an side
 8350:    // varName is the name of the variable to get
 8351:    // var is the array to store the value
 8352:    // k is the vertical level index of the variable to get
 8353:    SIDE_BND(sideBnd);   
 8354: 
 8355:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8356:    if (sideBnd->segment->isLand) idx = -7;
 8357: 
 8358:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8359:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8360: 
 8361: }
