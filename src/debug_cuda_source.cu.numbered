 6187:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6188: 
 6189:       NODE(node);
 6190: 
 6191:       node->ETP = 0.0;
 6192: 
 6193:       if constexpr(ntip == 0) return;
 6194: 
 6195:       // For all tidal potential components
 6196:       for (int j=0; j<ntip; j++) {
 6197: 
 6198:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6199: 
 6200:          node->ETP += nodeETP;
 6201: 
 6202:          if constexpr(iloadtide==1) { // loading tide
 6203:             assert(false && "Loading tide not implemented");
 6204:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6205:          }
 6206:          
 6207:       }
 6208: 
 6209:      
 6210:    }
