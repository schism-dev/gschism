 7206: 
 7207: __global__ void computeMatrixProductAndDotProducts() {
 7208:    // Computes A*p, r'Mr and p'Ap
 7209: 
 7210:    // 1) shared buffer: first half for rMr, second for pAp
 7211:    __shared__ double sdata[2*BLOCK_SIZE];
 7212:    double* s_rMr = sdata;
 7213:    double* s_pAp = sdata + BLOCK_SIZE;
 7214: 
 7215:    const int tid = threadIdx.x;
 7216: 
 7217:    double l_pAp = 0.0;
 7218: 
 7219:    s_rMr[tid] = 0.0;
 7220:    s_pAp[tid] = 0.0;
 7221: 
 7222:    // 2) get your node pointer
 7223:    // NODE(node);   
 7224:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7225:    Node *node = &(mesh->localNodeData[idx_node]); 
 7226:       if (idx_node < mesh->np) {
 7227: 
 7228:       const double diag = node->coeffDiag;
 7229:       const double r    = node->mR;
 7230:       const double p    = node->mP;  
 7231: 
 7232:       // apply preconditioner on the fly:
 7233:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7234: 
 7235:       // 4) compute Ap = A.p
 7236:       double Ap = node->coeffDiag * node->mP;
 7237:       for (int j = 0; j < node->numNodes; ++j) {
 7238:          const Node *nbNode = node->nodes[j];
 7239:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7240: 
 7241:       }
 7242: 
 7243:       node->mAp = Ap;
 7244:       
 7245: 
 7246:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7247:       // const double l_rMr = r*Mr;  // r'Mr
 7248:       l_pAp = p*Ap;  // p'Ap
 7249: 
 7250: 
 7251:    }
 7252: 
 7253:    // 6) write into shared mem
 7254:    // s_rMr[tid] = l_rMr;
 7255:    s_pAp[tid] = l_pAp;
 7256: 
 7257:    __syncthreads();
 7258: 
 7259:    // 7) block-wide tree reduction
 7260:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7261:       if (tid < stride)  {
 7262:          s_pAp[tid] += s_pAp[tid + stride];
 7263:       }
 7264:       __syncthreads();
 7265:    }
 7266: 
 7267:    // 8) thread 0 atomically accumulates into the globals
 7268:    // XXX: This is slower than it needs to be, but it is simple and works
 7269:    if (tid == 0) {
 7270:       atomicAdd(pAp, s_pAp[0]);
 7271:    }
 7272: 
 7273: 
 7274: }
 7275: 
 7276: 
 7277: __global__ void updateSolutionAndDotProducts(void) {
 7278:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7279: 
 7280:    const int tid = threadIdx.x;
 7281: 
 7282:    s_rMr[tid] = 0.0;
 7283: 
 7284:    // get node & bounds-check:
 7285:    NODE(node);
 7286: 
 7287:    
 7288:    // Compute alpha
 7289:    const double alpha = (*rMr_old)/(*pAp); 
 7290: 
 7291: 
 7292:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7293: 
 7294: 
 7295:    // load scalars
 7296:    const double diag = node->coeffDiag;
 7297:    const double p    = node->mP;
 7298:    const double Ap   = node->mAp;
 7299:    const double x    = node->mX;
 7300:    const double r    = node->mR;
 7301:    
 7302:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7303: 
 7304:    // 1) update solution & residual
 7305:    const double x_new = x + alpha*p;
 7306:    const double r_new = r - alpha*Ap;
 7307:    node->mX = x_new;
 7308:    node->mR = r_new;
 7309: 
 7310:    // 2) apply Jacobi preconditioner on the fly
 7311:    const double Mr_new = r_new/diag;
 7312: 
 7313: 
 7314:    // 3) local contributions for the two dot-products
 7315:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7316: 
 7317:    // 4) write into shared-mem
 7318:    s_rMr[tid] = l_rMr;
 7319: 
 7320:    __syncthreads();
 7321: 
 7322: 
 7323:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7324:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7325:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7326:       __syncthreads();
 7327:    }
 7328: 
 7329:    // 6) thread 0 atomically folds into the global accumulators
 7330:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7331: 
 7332: 
 7333: }
 7334: 
 7335: 
 7336: __global__ void updateSearchDirection() {
 7337: 
 7338:     NODE(node);
 7339: 
 7340:     // recompute z on-the-fly
 7341:     const double z = node->mR / node->coeffDiag;
 7342:     const double p = node->mP;
 7343: 
 7344:     const double beta = (*rMr_new)/(*rMr_old);
 7345: 
 7346: 
 7347:     // p =z + beta*p
 7348:     node->mP = z + beta*p;
 7349: 
 7350: }
 7351: 
 7352: __global__ void initializeScalars(double *scalars) {
 7353: 
 7354:    // These point to a cupy array in the host code
 7355:    rMr_old = scalars + 0;
 7356:    rMr_new = scalars + 1;
 7357:    pAp     = scalars + 2;
 7358: }
 7359: 
 7360: __global__ void initializePreconditionedResidual(void) {
 7361: 
 7362:     __shared__ double s_rMr[BLOCK_SIZE];  
 7363: 
 7364:     s_rMr[threadIdx.x] = 0.0;
 7365: 
 7366:     NODE_ALL(node, valid);
 7367:     const int tid = threadIdx.x;
 7368:     // For the first iteration:
 7369:     // 1. Initial solution x = 0 (already set)
 7370:     // 2. Initial residual r = b (stored in qel)
 7371:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7372: 
 7373: // XXX we should use the guess solution here    
 7374: 
 7375:     double l_rMr = 0.0;
 7376:     if (valid) {
 7377:       // Set initial residual r = b (from qel)
 7378:       node->mR = node->qel;
 7379: 
 7380:       // Compute z = M^-1 * r (preconditioned residual)
 7381:       const double z = node->mR / node->coeffDiag;
 7382: 
 7383:       // Set initial search direction p = z
 7384:       node->mP = z;
 7385: 
 7386:       // Initialize other variables needed for CG
 7387:       node->mX = 0.0;  // Initial solution
 7388:       node->mAp = 0.0; // Will be computed in first iteration
 7389: 
 7390: 
 7391:       // Computes the first r'Mr (reduction)
 7392:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7393:     }
 7394:     // 4) write into shared-mem
 7395:     s_rMr[tid] = l_rMr;
 7396: 
 7397:     __syncthreads();
 7398: 
 7399: 
 7400:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7401:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7402:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7403:         __syncthreads();
 7404:     }
 7405: 
 7406:     // 6) thread 0 atomically folds into the global accumulators
 7407:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7408: 
 7409:     *rMr_old = 0.0;
 7410:     *pAp = 0.0;
 7411: }
 7412: 
 7413: 
 7414: 
 7415: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7416:    Element *elems = mesh->localElemData;
 7417: 
 7418:    *addr = elems;
 7419:    *sizeElement = sizeof(Element);
 7420:    switch (varCode) {
 7421:       case (int)VarCode::z:
 7422:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7423:          *sizeType = sizeof(double);
 7424:          break;
 7425:       case (int)VarCode::x:
 7426:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7427:          *sizeType = sizeof(Vector2);
 7428:          break;
 7429:       case (int)VarCode::area:
 7430:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7431:          *sizeType = sizeof(double);
 7432:          break;
 7433:       case (int)VarCode::depth:
 7434:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7435:          *sizeType = sizeof(double);
 7436:          break;
 7437:       case (int)VarCode::radius:
 7438:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7439:          *sizeType = sizeof(double);
 7440:          break;
 7441:       case (int)VarCode::lonlat:
 7442:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7443:          *sizeType = sizeof(double);
 7444:          break;
 7445:       case (int)VarCode::ghat:
 7446:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7447:          *sizeType = sizeof(Vector2);
 7448:          break;
 7449:       case (int)VarCode::kb:
 7450:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7451:          *sizeType = sizeof(int);
 7452:          break;
 7453:       case (int)VarCode::isdry:
 7454:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7455:          *sizeType = sizeof(int);
 7456:          break;            
 7457:       case (int)VarCode::w:
 7458:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7459:          *sizeType = sizeof(double);
 7460:          break;
 7461:       case (int)VarCode::FaceIndices:
 7462:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7463:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7464:          *sizeType = sizeof(Node);
 7465:          break;
 7466:       default:
 7467:          *offset = -1;
 7468:    }
 7469: }
