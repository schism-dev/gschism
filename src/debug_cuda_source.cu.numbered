 7174: 
 7175: __global__ void computeMatrixProductAndDotProducts() {
 7176:    // Computes A*p, r'Mr and p'Ap
 7177: 
 7178:    // 1) shared buffer: first half for rMr, second for pAp
 7179:    __shared__ double sdata[2*BLOCK_SIZE];
 7180:    double* s_rMr = sdata;
 7181:    double* s_pAp = sdata + BLOCK_SIZE;
 7182: 
 7183:    const int tid = threadIdx.x;
 7184: 
 7185:    double l_pAp = 0.0;
 7186: 
 7187:    s_rMr[tid] = 0.0;
 7188:    s_pAp[tid] = 0.0;
 7189: 
 7190:    // 2) get your node pointer
 7191:    // NODE(node);   
 7192:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7193:    Node *node = &(mesh->localNodeData[idx_node]); 
 7194:       if (idx_node < mesh->np) {
 7195: 
 7196:       const double diag = node->coeffDiag;
 7197:       const double r    = node->mR;
 7198:       const double p    = node->mP;  
 7199: 
 7200:       // apply preconditioner on the fly:
 7201:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7202: 
 7203:       // 4) compute Ap = A.p
 7204:       double Ap = node->coeffDiag * node->mP;
 7205:       for (int j = 0; j < node->numNodes; ++j) {
 7206:          const Node *nbNode = node->nodes[j];
 7207:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7208: 
 7209:       }
 7210: 
 7211:       node->mAp = Ap;
 7212:       
 7213: 
 7214:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7215:       // const double l_rMr = r*Mr;  // r'Mr
 7216:       l_pAp = p*Ap;  // p'Ap
 7217: 
 7218: 
 7219:    }
 7220: 
 7221:    // 6) write into shared mem
 7222:    // s_rMr[tid] = l_rMr;
 7223:    s_pAp[tid] = l_pAp;
 7224: 
 7225:    __syncthreads();
 7226: 
 7227:    // 7) block-wide tree reduction
 7228:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7229:       if (tid < stride)  {
 7230:          s_pAp[tid] += s_pAp[tid + stride];
 7231:       }
 7232:       __syncthreads();
 7233:    }
 7234: 
 7235:    // 8) thread 0 atomically accumulates into the globals
 7236:    // XXX: This is slower than it needs to be, but it is simple and works
 7237:    if (tid == 0) {
 7238:       atomicAdd(pAp, s_pAp[0]);
 7239:    }
 7240: 
 7241: 
 7242: }
 7243: 
 7244: 
 7245: __global__ void updateSolutionAndDotProducts(void) {
 7246:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7247: 
 7248:    const int tid = threadIdx.x;
 7249: 
 7250:    s_rMr[tid] = 0.0;
 7251: 
 7252:    // get node & bounds-check:
 7253:    NODE(node);
 7254: 
 7255:    
 7256:    // Compute alpha
 7257:    const double alpha = (*rMr_old)/(*pAp); 
 7258: 
 7259: 
 7260:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7261: 
 7262: 
 7263:    // load scalars
 7264:    const double diag = node->coeffDiag;
 7265:    const double p    = node->mP;
 7266:    const double Ap   = node->mAp;
 7267:    const double x    = node->mX;
 7268:    const double r    = node->mR;
 7269:    
 7270:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7271: 
 7272:    // 1) update solution & residual
 7273:    const double x_new = x + alpha*p;
 7274:    const double r_new = r - alpha*Ap;
 7275:    node->mX = x_new;
 7276:    node->mR = r_new;
 7277: 
 7278:    // 2) apply Jacobi preconditioner on the fly
 7279:    const double Mr_new = r_new/diag;
 7280: 
 7281: 
 7282:    // 3) local contributions for the two dot-products
 7283:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7284: 
 7285:    // 4) write into shared-mem
 7286:    s_rMr[tid] = l_rMr;
 7287: 
 7288:    __syncthreads();
 7289: 
 7290: 
 7291:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7292:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7293:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7294:       __syncthreads();
 7295:    }
 7296: 
 7297:    // 6) thread 0 atomically folds into the global accumulators
 7298:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7299: 
 7300: 
 7301: }
 7302: 
 7303: 
 7304: __global__ void updateSearchDirection() {
 7305: 
 7306:     NODE(node);
 7307: 
 7308:     // recompute z on-the-fly
 7309:     const double z = node->mR / node->coeffDiag;
 7310:     const double p = node->mP;
 7311: 
 7312:     const double beta = (*rMr_new)/(*rMr_old);
 7313: 
 7314: 
 7315:     // p =z + beta*p
 7316:     node->mP = z + beta*p;
 7317: 
 7318: }
 7319: 
 7320: __global__ void initializeScalars(double *scalars) {
 7321: 
 7322:    // These point to a cupy array in the host code
 7323:    rMr_old = scalars + 0;
 7324:    rMr_new = scalars + 1;
 7325:    pAp     = scalars + 2;
 7326: }
 7327: 
 7328: __global__ void initializePreconditionedResidual(void) {
 7329: 
 7330:     __shared__ double s_rMr[BLOCK_SIZE];  
 7331: 
 7332:     s_rMr[threadIdx.x] = 0.0;
 7333: 
 7334:     NODE_ALL(node, valid);
 7335:     const int tid = threadIdx.x;
 7336:     // For the first iteration:
 7337:     // 1. Initial solution x = 0 (already set)
 7338:     // 2. Initial residual r = b (stored in qel)
 7339:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7340: 
 7341: // XXX we should use the guess solution here    
 7342: 
 7343:     double l_rMr = 0.0;
 7344:     if (valid) {
 7345:       // Set initial residual r = b (from qel)
 7346:       node->mR = node->qel;
 7347: 
 7348:       // Compute z = M^-1 * r (preconditioned residual)
 7349:       const double z = node->mR / node->coeffDiag;
 7350: 
 7351:       // Set initial search direction p = z
 7352:       node->mP = z;
 7353: 
 7354:       // Initialize other variables needed for CG
 7355:       node->mX = 0.0;  // Initial solution
 7356:       node->mAp = 0.0; // Will be computed in first iteration
 7357: 
 7358: 
 7359:       // Computes the first r'Mr (reduction)
 7360:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7361:     }
 7362:     // 4) write into shared-mem
 7363:     s_rMr[tid] = l_rMr;
 7364: 
 7365:     __syncthreads();
 7366: 
 7367: 
 7368:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7369:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7370:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7371:         __syncthreads();
 7372:     }
 7373: 
 7374:     // 6) thread 0 atomically folds into the global accumulators
 7375:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7376: 
 7377:     *rMr_old = 0.0;
 7378:     *pAp = 0.0;
 7379: }
 7380: 
 7381: 
