 2179: 
 2180: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2181: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2182: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2183: // Only when ics == 2, the origin is at the element center.
 2184: 
 2185:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2186: 
 2187:    const Node *node = nodes[idxNode];
 2188: 
 2189:    if constexpr(ics==1) {
 2190:       return node->p;
 2191: 
 2192:    } else {
 2193:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2194: 
 2195:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2196: 
 2197:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2198:    }
 2199: 
 2200: }
 2201: 
 2202: 
 2203: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2204: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2205: 
 2206:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2207: 
 2208:    const int id1 = idx;
 2209:    const int id2 = nxq(1 + id1);
 2210:    const int id3 = nxq(2 + id1);
 2211: 
 2212:    if constexpr(ics==1) {
 2213:       x0 = nodes[id1]->p;
 2214:       x1 = nodes[id2]->p;
 2215:       x2 = nodes[id3]->p;
 2216: 
 2217:    } else {
 2218:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2219: 
 2220:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2221:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2222:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2223: 
 2224:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2225:       x1 = toVector2(frame.G2L(p1 - c));
 2226:       x2 = toVector2(frame.G2L(p2 - c));
 2227: 
 2228:    }
 2229: 
 2230: }
 2231: 
 2232: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2233: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2234: 
 2235:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2236: 
 2237:    if constexpr(ics==1) {
 2238:       x0 = nodes[0]->p;
 2239:       x1 = nodes[1]->p;
 2240:       x2 = nodes[2]->p;  
 2241:       x3 = nodes[3]->p;
 2242: 
 2243:    } else {
 2244:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2245: 
 2246:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2247:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2248:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2249:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2250: 
 2251:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2252:       x1 = toVector2(frame.G2L(p1 - c));
 2253:       x2 = toVector2(frame.G2L(p2 - c));
 2254:       x3 = toVector2(frame.G2L(p3 - c));
 2255:    }
 2256: 
 2257: }
 2258: 
 2259: 
 2260: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2261: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2262: // Returns the normal vector and the area of the element at this level
 2263: 
 2264:    double nx, ny, nz;
 2265: 
 2266:    if (isTri()) {
 2267:       // For triangles...
 2268: 
 2269:       // Indices of the nodes at level k, taking care of not going below the bed
 2270:       const int k0 = max(k, nodes[0]->kb);
 2271:       const int k1 = max(k, nodes[1]->kb);
 2272:       const int k2 = max(k, nodes[2]->kb);
 2273: 
 2274:       // Gets the element frame coordinates of the nodes at level k
 2275:       Point3 x0, x1, x2;
 2276:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2277:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2278:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2279:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2280: 
 2281:       } else {  // ics == 2
 2282:          Point2 h0, h1, h2;
 2283: 
 2284:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2285: 
 2286:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2287:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2288:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2289:       }
 2290: 
 2291:       const Vector3 n20 = x2 - x0;
 2292:       const Vector3 n10 = x1 - x0; 
 2293: 
 2294:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2295:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2296:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2297:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2298:   
 2299:    }
 2300:    else {
 2301:       // For quads...
 2302:       Point2 h0, h1, h2, h3;
 2303: 
 2304:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2305: 
 2306:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2307:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2308:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2309:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2310: 
 2311:       nx = n20.y*n31.z - n20.z*n31.y;
 2312:       ny = n20.z*n31.x - n20.x*n31.z;
 2313:       nz = n20.x*n31.y - n20.y*n31.x;
 2314: 
 2315:    }
 2316: 
 2317:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2318:    area3D = 0.5*len;
 2319: 
 2320:    const double inv_len = 1.0/len;
 2321: 
 2322:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2323: 
 2324: }
 2325: 
 2326: /**
 2327:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2328:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2329:    If the segment is completely inside the element, then it returns true.
 2330: 
 2331:    This function assumes:
 2332:    - The initial point is on a side of the element. 
 2333:    - Its position is given by parameter t in the range [0,1].
 2334:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2335:       intersects the element (elements are convex).
 2336: 
 2337:    To find the intersection point, this function does the following:
 2338:    - it finds the intersection of the line segment with all the element side lines,
 2339:       except for the one that contains the initial point.
 2340:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2341:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2342:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2343:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2344:       track segment is almost parallel to the element side line.
 2345: 
 2346:    Inputs:
 2347:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2348:    @param x2, y2: other end of the line segment
 2349: 
 2350:    Outputs:
 2351:    @param side:  side that intersects the line segment (input and output)
 2352:    @param nextElement (output): element that contains the intersection point
 2353:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2354:    @param zint (input/output): Vertical coordinate of the intersection point
 2355: 
 2356:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2357:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2358:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2359: 
 2360:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2361:    (Delta) being zero.
 2362: 
 2363:    The intersection2 point happens when:
 2364:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2365:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2366:    
 2367:    Assumption: the 4 points (including those of the side segment) are different.
 2368:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2369:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2370:    If true, (xIntersect,yIntersect) is the intersection.				
 2371:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2372: **/
 2373: 
 2374: 
 2375: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2376:                                               double &t, double& tIntersect, const Side *origSide) {
 2377:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2378: if (!containsPoint(x1, origSide)) printf("111: x1 = (%f, %f), origSide.center = (%f, %f)\n", x1.x, x1.y, origSide->center.x, origSide->center.y); 
 2379:    assert( containsPoint(x1, origSide) && "Starting point is not inside the element");                                    
 2380:    assert(!containsPoint(x2, origSide) && "Ending point is not outside the element");
 2381: 
 2382:    double closest_intersect_t = 1e10;
 2383:    bool found_intersection = false;
 2384: 
 2385:    for (int i = 0; i < i34; i++) {
 2386: 
 2387:       Side *side2 = sides[i];
 2388: 
 2389:       // (x3,y3)-(x4,y4) is the element side line
 2390:       const Point2 x3 = side2->n1->p;
 2391:       const Point2 x4 = side2->n2->p;
 2392: 
 2393:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2394:       const double delta = cross(x2 - x1, x3 - x4);
 2395: 
 2396:       if (abs(delta) > 0) {
 2397: 
 2398:          const double delta1 = cross(x3 - x1, x3 - x4);
 2399:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2400: 
 2401:          // Solves the two linear equations for tt1 and tt2
 2402:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2403:          const double tt2 = delta2/delta;
 2404: 
 2405:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2406:             closest_intersect_t = min(closest_intersect_t, tt1);
 2407:             side = side2;
 2408:             nextElement = side->otherElem(this);
 2409:             t =          clamp(tt2, small, 1.0-small);
 2410:             tIntersect = clamp(tt1, small, 1.0-small);
 2411:             found_intersection = true;
 2412:          }
 2413: 
 2414:       
 2415:       }
 2416:       else {  // parallel segments
 2417: 
 2418:          continue; 
 2419:          assert(false && "Parallel segments should not happen under the new code");
 2420:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 2421:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 2422: 
 2423:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2424:          const double dist = dot(x1 - x3, side2->n);
 2425:          if (abs(dist) < small*length(x3 - x4)) {
 2426:             const double2 unitarySide = normalize(x4 - x3);
 2427:             const double len = dot(x2 - x1, unitarySide);
 2428:             t = t + len;
 2429:             t = max(0.0, min(t, 1.0));
 2430:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 2431: 
 2432: 
 2433:             // tIntersect = max(small, min(tt1, 1.0-small));
 2434:             // t = tt2;
 2435:             found_intersection = true;
 2436:          }
 2437:       }
 2438: 
 2439: 
 2440:    }
 2441: 
 2442:    if (!found_intersection) {if (idx == 15876) printf("11111: No intersection found\n"); return false;}
 2443:    assert(found_intersection && "No intersection found");
 2444: 
 2445:    // found_intersection should always be true, since we checked all the sides.  
 2446:    return found_intersection;
 2447: }
 2448: 
 2449: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2450:    // Check if the point (xt,yt) is inside the element.
 2451:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2452:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2453: 
 2454:    double shpCoords[4];
 2455:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2456: 
 2457:    return res;
 2458: }
 2459: 
 2460: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2461:    // Check if the point (xt,yt) is inside the element.
 2462:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2463:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2464:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2465: 
 2466:    double shpCoords[4];
 2467:    Vector2 tmp_xt = xt;
 2468:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2469:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2470: 
 2471:    if (fixCoords && res) xt = tmp_xt;
 2472: 
 2473:    return res;
 2474: }
 2475: 
 2476: 
 2477: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2478:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2479: 
 2480:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2481:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2482:    // curElement.
 2483: 
 2484:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2485:    // And uses this velocity instead to continue the tracking.
 2486: 
 2487:    // computes the intersection point in cartesian coordinates
 2488:    Point2 intersection = nextSide->p2_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2489: 
 2490:    // Nudges the point to the barycenter of the element. 
 2491:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2492:    // next segment intersects the element sides. 
 2493:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2494: 
 2495: 
 2496:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2497:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2498:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2499:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2500: 
 2501:    // If the side is an open boundary, the tangential velocity is set to zero.
 2502:    if (nextSide->isBnd()) vtan = 0.0;
 2503: 
 2504:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2505:    const double us = vtan*nextSide->t().x;
 2506:    const double vs = vtan*nextSide->t().y;
 2507:    const double ws = nextSide->w2(jlev); 
 2508: 
 2509:    u_int = {us, vs, ws};
 2510: 
 2511:    // The end of this tracking segment is now the intersection point.
 2512:    xt = {intersection.x, intersection.y, zint};
 2513:    
 2514: }
 2515: 
 2516: /**
 2517:  * Tracks a particle through elements and vertical levels in the mesh.
 2518:  * 
 2519:  * @param x0,y0,z0     Starting position coordinates
 2520:  * @param xt,yt,zt     Target position coordinates
 2521:  * @param dtb          Time step for tracking
 2522:  * @param u_int        Initial velocity components
 2523:  * @param nextElem     Starting/resulting element index
 2524:  * 
 2525:  * @return Status code of type trackExitCodes
 2526:  * 
 2527:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2528:  * of the details are different. The idea is that the code requires less branches and is better fit
 2529:  * for GPU execution.
 2530:  * 
 2531:  * The main ideas here are:
 2532:  * - The starting point is expected to be in the starting element.
 2533:  * - since the starting point is inside the element, there are only two cases: 
 2534:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2535:  *     (b) it does not and (xt,yt) is already in the starting element.
 2536:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2537:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2538:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2539:  * - tt1 can be positive or negative. We only consider the positive values.
 2540:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2541:  * - The next intersection will occur at the smallest positive tt1.
 2542:  * - This intersection will be the next (x0,y0) position.
 2543:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2544:  *   of getting stuck in a loop.
 2545:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2546:  *   was found.
 2547:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2548:  */
 2549: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2550:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2551:                                                        const Side *origSide) {
 2552:                                                             
 2553:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2554:    // else to do. This means that the full step occurred within the current element.
 2555:    assert(!isDry && "Starting element is dry");
 2556:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2557: Vector2 x0_tmp = toVector2(x0);
 2558: if (!containsPoint(toPoint2(x0), origSide)) {if (idx == 15876) printf("1111: elem->idx = %d, origSide->idx = %d, x0_tmp = (%f, %f), x0 = (%f, %f), origSide.center = (%f, %f)\n", idx, origSide->idx, x0_tmp.x, x0_tmp.y, x0.x, x0.y, origSide->center.x, origSide->center.y); return false;}
 2559: 
 2560:    assert(containsPoint(toPoint2(x0), origSide) && "Starting point is not inside the element");
 2561: 
 2562:    if (containsPoint(toPoint2(xt), true, origSide)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2563: 
 2564:       assert(containsPoint(toPoint2(xt), origSide) && "Target point is not inside the element");
 2565:       assert(!isDry && "Target point is inside a dry element");
 2566: 
 2567:       u_int = interpolateVelocities(xt, origSide);
 2568: 
 2569:       nextElem = this;
 2570: 
 2571:       return true;
 2572:    }
 2573: 
 2574: 
 2575:    
 2576: 
 2577:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2578:    
 2579:    double t;
 2580:    Side *nextSide = nullptr;
 2581:    double tIntersect = 1e10;
 2582: 
 2583: 
 2584:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2585:    // (x0,y0) is inside the element but the target point is not.
 2586:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect, origSide);
 2587: if (!found_intersection) {if (idx == 15876) printf("111112: No intersection found\n"); return false;}
 2588:    assert(found_intersection && "No intersection found at %d");
 2589: 
 2590:    Point2 xtmp = toPoint2(toLocalFrame(nextSide->p3_t(t), origSide)); // If needed, moves the target point to the intersection point
 2591: 
 2592:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2593:    if (nextElem != nullptr && !nextElem->isDry) {
 2594:       assert(nextElem->containsPoint(xtmp, origSide) && "Intersection point is not inside the next element");
 2595:       nextElem->nudgeToBarycenter(xtmp, origSide);
 2596:    }
 2597: 
 2598:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2599:    xt = {xtmp.x, xtmp.y, zint};
 2600: 
 2601:    // if the tracking segment goes out of water (either dry or edge boundary)
 2602:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2603: 
 2604: 
 2605:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2606: 
 2607:       assert(this->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the current element");
 2608:       // When this happens, the backtracking stops.
 2609: 
 2610:       dt *= tIntersect;
 2611: 
 2612:       // In this case, the next element is again the current element.
 2613:       nextElem = this;
 2614: 
 2615: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2616: 
 2617:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2618:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2619:       return true;    
 2620:    }
 2621: 
 2622: 
 2623:    assert(nextElem->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the next element");
 2624:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2625:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2626: 
 2627:    
 2628:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2629: 
 2630:    u_int = nextElem->interpolateVelocities(xt, origSide); 
 2631: 
 2632:    assert(nextElem != this && "Next element is the same as the current element");
 2633: 
 2634:    return true;
 2635: }
 2636: 
 2637: 
 2638: __inline__ __device__ double Element::computeSignedArea(void) const {
 2639:    // Compute the area of the element
 2640: 
 2641:    Point2 x0, x1, x2, x3;
 2642:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2643: 
 2644:    double res = signedArea(x0, x1, x2);
 2645: 
 2646:    // In the quad case we need to add the area of the other triangle.
 2647:    if (isQuad()) {
 2648:       x3 = getLocalHorizontalNodePosition(3);
 2649:       double ar1 = signedArea(x0, x2, x3);
 2650:       double ar2 = signedArea(x0, x1, x3);
 2651:       double ar3 = signedArea(x1, x2, x3);
 2652:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2653: 
 2654:       res += ar1 + ar2 + ar3;
 2655:    }
 2656: 
 2657:    return res;
 2658: }
 2659: 
 2660: 
 2661: __inline__ __device__ void Element::nudgeToBarycenter(Point2 &p, const Side *origSide) const {
 2662: // Nudges the point (x,y) to the barycenter of the element
 2663: 
 2664:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2665: 
 2666:    Point3 c = toLocalFrame(toPoint3(center, centerZ()), origSide); // In local frame coordinates if ics == 2
 2667: 
 2668:    p = (1.0 - btrack_nudge)*p + btrack_nudge*toPoint2(c);
 2669: }
 2670: 
 2671: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2672:                                                                 (nodes[1]->isDry2()) ||
 2673:                                                                 (nodes[2]->isDry2()) ||
 2674:                                                                 (i34==4 && nodes[3]->isDry2());
 2675: }
 2676: 
 2677: __inline__ __device__ double Element::detJ_eta(void) const {
 2678:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2679:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2680: }
 2681: 
 2682: __inline__ __device__ double Element::detJ_xi(void) const {
 2683:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2684:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2685: }
 2686: 
 2687: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2688:    // In boundary sides, the element 1 is nullptr
 2689:    return side->elems[1] == nullptr; 
 2690: }
 2691: 
 2692: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2693:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2694:    // For ics == 2, this function uses local frame coordinates.
 2695: 
 2696:    assert(isQuad());
 2697: 
 2698:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2699:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2700:    // where vxi, veta, vb are vectors and c is the center of the element.
 2701: 
 2702:    Point2 p0, p1, p2, p3;
 2703: 
 2704:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2705: 
 2706:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2707:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2708:    // vectors vxi and veta connect the centers of opposite sides
 2709:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2710:    // vb is zero for parallelogram elements.
 2711:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2712:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);
 2713:    const Vector2 veta = (p2 + p3) - (p0 + p1);
 2714:    const Vector2 vb   = (p0 + p2) - (p1 + p3);
 2715: 
 2716:    // We need to solve the expression p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb) for (xi,eta),
 2717:    // For this we first rewrite it as:
 2718:    //    4*dp = xi*vxi + eta*veta + xi*eta*vb,  where dp = p - c.
 2719:    // Then we use the 2D "cross product" cross(a,b) = a.x*b.y - a.y*b.x, multiplying both sides by 
 2720:    // vb to remove the xi*eta term (cross(vb, vb) == 0). This results in a scalar equation:
 2721:    //    cross(vb, 4*dp) = xi*cross(vb, vxi) + eta*cross(vb, veta)
 2722:    //
 2723:    // However, if vb is very small, the whole equation is numerically unstable. Instead of
 2724:    // vb, we can take the cross product of both sides by the unit vector nb in the direction of vb to get a more stable equation:
 2725:    //    cross(nb, 4*dp) = xi*cross(nb, vxi) + eta*cross(nb, veta)
 2726:    //
 2727:    // To get a second equation, we compute the dot product of both sides by nb (any other vector would do, 
 2728:    // this just makes the equations more symmetric).
 2729:    //    dot(nb, 4*dp) = xi*dot(nb, vxi) + eta*dot(nb, veta) + xi*eta*dot(nb, vb)
 2730:    //
 2731:    // This results in two equations:
 2732:    //    Cbp = Cbx*xi + Cbe*eta
 2733:    //    Dbp = Dbx*xi + Dbe*eta + Dbb*xi*eta
 2734:    //
 2735:    // With definitions: Cbp = cross(nb, 4*dp), Cbx = cross(nb, vxi), Cbe = cross(nb, veta), Dbp = dot(nb, 4*dp), Dbx = dot(nb, vxi), Dbe = dot(nb, veta), Dbb = dot(nb, vb)
 2736:    //
 2737:    // xi or eta can be solved from the first equation (depending on what coefficient is larger), and
 2738:    // then substitute in the second equation to get the other coordinate. Let's assume that |Cbx| > |Cbe|:
 2739:    //    xi = (Cbp - Cbe*eta) / Cbx
 2740:    //
 2741:    // Multiply by Cbx:
 2742:    //
 2743:    //    Dbp*Cbx = Dbx*(Cbp - Cbe*eta) + Dbe*Cbx*eta + Dbb*(Cbp - Cbe*eta)*eta
 2744:    //
 2745:    // Expand and group by powers of eta:
 2746:    //    (-Dbb*Cbe)*eta^2 + (-Dbx*Cbe + Dbe*Cbx + Dbb*Cbp)*eta + (Dbx*Cbp - Dbp*Cbx) = 0
 2747:    //
 2748:    // So we have a quadratic in eta:
 2749:    //    A*eta^2 + B*eta + C = 0
 2750:    // with:
 2751:    //    A = -Dbb*Cbe
 2752:    //    B = -Dbx*Cbe + Dbe*Cbx + Dbb*Cbp
 2753:    //    C = Dbx*Cbp - Dbp*Cbx
 2754:    
 2755:    // Let's build the quadratic equation.
 2756:    Vector2 nb = {1.0, 0.0};
 2757:    if (fabs(vb.x) + fabs(vb.y) > 1e-12) nb = normalize(vb);  // XXXX magic number
 2758: 
 2759:    const Point2 dp = p - c;
 2760: 
 2761:    const double Cbp = cross(nb, 4*dp);
 2762:    const double Cbx = cross(nb, vxi);
 2763:    const double Cbe = cross(nb, veta);
 2764:    const double Dbp = dot(nb, 4*dp);
 2765:    const double Dbx = dot(nb, vxi);
 2766:    const double Dbe = dot(nb, veta);
 2767:    const double Dbb = dot(nb, vb);
 2768:    
 2769:    if (fabs(Cbx) > fabs(Cbe)) {
 2770:       const double A = -Dbb*Cbe;
 2771:       const double B = -Dbx*Cbe + Dbe*Cbx + Dbb*Cbp;
 2772:       const double C =  Dbx*Cbp - Dbp*Cbx;
 2773: 
 2774:       double x1, x2;
 2775:       solveQuadratic(A, B, C, x1, x2);
 2776:       if      (fabs(x1) <= fabs(x2)) eta = x1;
 2777:       else                      eta = x2;
 2778: 
 2779:       xi = (Cbp - Cbe*eta) / Cbx;
 2780: 
 2781:    } else {
 2782:       const double A = -Dbb*Cbx;
 2783:       const double B =  Dbx*Cbe - Dbe*Cbx + Dbb*Cbp;
 2784:       const double C =  Dbe*Cbp - Dbp*Cbe;
 2785: 
 2786:       double x1, x2;
 2787:       solveQuadratic(A, B, C, x1, x2);
 2788:       if (fabs(x1) <= fabs(x2)) xi = x1;
 2789:       else                      xi = x2;
 2790: 
 2791:       eta = (Cbp - Cbx*xi) / Cbe;
 2792:    }
 2793: 
 2794:   
 2795: 
 2796:    assert(fabs(xi) <= 1.0 && fabs(eta) <= 1.0 && "inverseBilinearQuad: out-of-bound local coords");  // XXXX magic number
 2797: 
 2798:    xi  = clamp(xi,  -1.0, 1.0);
 2799:    eta = clamp(eta, -1.0, 1.0);
 2800: 
 2801:    shp[0] = 0.25*(1.0 - xi)*(1.0 - eta);
 2802:    shp[1] = 0.25*(1.0 + xi)*(1.0 - eta);
 2803:    shp[2] = 0.25*(1.0 + xi)*(1.0 + eta);
 2804:    shp[3] = 0.25*(1.0 - xi)*(1.0 + eta);
 2805: 
 2806:    return true;
 2807: }
 2808: 
 2809: /**
 2810:    Compute the shape coordinates of the point (xt,yt) in the element.
 2811:    @param xt (input): x-coordinate of the point
 2812:    @param shpCoords (output): shape coordinates of the point
 2813:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2814:    @return true if the point is inside the element, false otherwise
 2815: **/
 2816: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2817: 
 2818:    // Compute the shape coordinates of the point xt in the element.
 2819:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2820:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2821:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2822:    // from the local frame, so use additional check.
 2823: 
 2824:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2825: 
 2826:    if (isTri()) { // Triangular element
 2827: 
 2828:       // Horizontal local node coordinates. 
 2829:       Point2 x0 = nodes[0]->p;
 2830:       Point2 x1 = nodes[1]->p;
 2831:       Point2 x2 = nodes[2]->p;
 2832: 
 2833:       // If ics == 2, the node coordinates are transformed to local frame.
 2834:       if constexpr(ics==2) {
 2835:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2836:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2837:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2838: 
 2839:          // Coordinates of the center of the original side
 2840:          const Point3 c = {origSide->center.x, origSide->center.y, origSide->centerZ()}; 
 2841: 
 2842:          // Convert the node coordinates to the local frame centered at the element center
 2843:          x0 = toVector2(origSide->frame.G2L(p0 - c));
 2844:          x1 = toVector2(origSide->frame.G2L(p1 - c));
 2845:          x2 = toVector2(origSide->frame.G2L(p2 - c));
 2846:       }
 2847: 
 2848:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2849:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2850:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2851:       shpCoords[3] = 0.0;
 2852: 
 2853: 
 2854:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2855:       const bool res = (tmpmin >= -small);  
 2856:       
 2857:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2858:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2859: 
 2860:       
 2861:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2862:       // then we fix the negative shape coordinates.
 2863:       if ((tmpmin < 0) && fix) {
 2864: 
 2865:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2866:          // keeping the sum of the shape coordinates equal to 1.
 2867:          // I have tested and compared the new algorithm with the old one, and they give
 2868:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2869:          // The new algorithm should be faster since it is branchless.
 2870:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2871:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2872:          
 2873:          shpCoords[0] = (shpCoords[0] + a)*b;
 2874:          shpCoords[1] = (shpCoords[1] + a)*b;
 2875:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2876: 
 2877:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2878:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2879:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2880: 
 2881:          // Update the point coordinates for the new shape coordinates
 2882:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2883:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2884:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2885: 
 2886:       }
 2887: 
 2888:       // Check if the point is inside the element
 2889:       return res;      
 2890:    }
 2891:    else {
 2892:       assert(isQuad() && "computeShapeCoords");
 2893: 
 2894:    //    Point2 p = xt;
 2895: 
 2896:    //    // Reproject p the original side frame for ics=2
 2897:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 2898: 
 2899:    //    bool inside = false;
