 4238: extern "C" {
 4239: 
 4240:    __global__ void scaleGravity(double loadtide_coef) {
 4241: 
 4242: 
 4243:       NODE(node);
 4244: 
 4245:       // SAL option: scale gravity
 4246:       if constexpr(iloadtide==2) {  // simple const
 4247:          node->grav2 = grav*(1.0 - loadtide_coef);
 4248: 
 4249:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4250:         
 4251:           const double depth = max(node->depth, 0.0);
 4252:           const double tmp1 = sqrt(depth);
 4253:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4254:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4255:                              2.6969e-13*depth*depth*depth*tmp1;
 4256:           
 4257:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4258:           
 4259: 
 4260: 
 4261:           node->grav2 = grav*(1.0 - beta_bar);
 4262: 
 4263:       } else {  // iloadtide=0,1
 4264:         node->grav2=grav;
 4265: 
 4266:       }
 4267: 
 4268:    }
 4269: 
