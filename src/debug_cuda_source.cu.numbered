 4451: 
 4452: 
 4453:    __global__ void computeFlowBcVelocities(double time) {
 4454: 
 4455:       SIDE_BND(sideBnd);
 4456: 
 4457:       const Side *side = sideBnd->side;
 4458:  
 4459:       const bool isDry = side->isDry;
 4460:       const bool isLand = sideBnd->segment->isLand;
 4461: 
 4462:    
 4463:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4464: 
 4465:       if (isDry || isLand) return;
 4466: 
 4467:       // For wet sides in open boundaries...
 4468:       const Vector2 n = side->n;
 4469:       const BoundarySegment *segment = sideBnd->segment;
 4470: 
 4471:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4472: 
 4473:       const int ifltype = segment->ifltype;
 4474: 
 4475:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4476:       const Vector2 r_nuth0 = r_uth0*n;
 4477: 
 4478: 
 4479:       if (ifltype == 1 || ifltype == 2) {
 4480:       
 4481:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4482: 
 4483:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4484:          
 4485:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4486:          
 4487:       } else if (ifltype == -1) { // Flather 1
 4488: 
 4489:          for (int k = 0; k < nvrt; k++) {
 4490: 
 4491:             // uth is the normal vel.; no ramp up
 4492:             const double uth = sideBnd->nuth(k);
 4493:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4494: 
 4495:             sideBnd->ubc[k] += uth*n;
 4496:          }
 4497: 
 4498:       } else if (ifltype == 3 || ifltype == 5) {
 4499:          // vnth0=0 !normal vel.
 4500: 
 4501:          Vector2 r_u1_bar = {0.0, 0.0};
 4502:          // Computes the contribution to the velocity from all tide frequencies
 4503:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4504: 
 4505:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4506:             const Vector2 umo  = sideBnd->umo(jfr); 
 4507: 
 4508:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4509:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4510:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4511:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4512: 
 4513:          }
 4514: 
 4515: 
 4516:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4517: 
 4518:       } // if (ifltype = 3 || ifltype == 5
 4519: 
 4520: 
 4521: 
 4522:    }
 4523: 
 4524:    __global__ void computeElevationBoundaryConditions(double time) {
 4525:       // Compute elevation essential boundary conditions 
 4526: 
 4527:       NODE_BND(nodeBnd); // Each boundary node.
 4528: 
 4529:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4530: 
 4531:       const Node *node = nodeBnd->node;
 4532:       const BoundarySegment *segment = nodeBnd->segment;
 4533:       const int iettype = segment->iettype;
 4534:       
 4535: 
 4536:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4537:       double eic = 0.0;
 4538:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4539:       else                 eic = 0.0;
 4540: 
 4541:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4542:       const double r_eth = ramp*nodeBnd->eth;
 4543:       double r_eta1_bar = 0.0;
 4544: 
 4545: 
 4546:       // Compute tide elevation
 4547:       if (iettype == 3 || iettype == 5) {   
 4548: 
 4549:          if constexpr(iloadtide==1) { // loading tide
 4550:             assert(false && "Loading tide not implemented");
 4551:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4552:          }
 4553:          
 4554:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4555: 
 4556:             const double efa  = nodeBnd->efa[jfr]; 
 4557:             const double emo  = nodeBnd->emo[jfr]; 
 4558: 
 4559:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4560:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4561:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4562: 
 4563:          } // for jfr
 4564: 
 4565:       } // if iettype
 4566: 
 4567:       switch (iettype) {
 4568:          case 1:
 4569:          case 2:
 4570:          case 4:
 4571:             nodeBnd->elbc = r_eic + r_eth;
 4572:             break;
 4573:          case 3:
 4574:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4575:             break;
 4576:          case 5:
 4577:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4578:             break;
 4579:       } // switch
 4580: 
 4581: 
 4582:       //Add inverse barometric effects
 4583:       if (iettype != 0 && inv_atm_bnd == 1) {
 4584:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4585:       }
 4586: 
 4587:    }
 4588: 
 4589: 
 4590:    __global__ void computeHorizontalViscosity(void) { 
 4591: 
 4592:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4593: 
 4594:       SIDE(side);
 4595: 
 4596:       if (side->isDry) return;
 4597: 
 4598:       for (int k = 0; k < nvrt; k++) {
 4599:          side->nuGradU[k] = {0.0, 0.0};
 4600:       }
 4601: 
 4602:       if constexpr(ihorcon == 1) {
 4603:          for (int k = side->kb; k < nvrt - 1; k++) {
 4604:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4605:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4606:             // By Zhang and Baptista.
 4607: 
 4608:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4609:             // This is a standard discretization of the Laplacian operator.
 4610:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4611:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4612:             // Gamma is hvis_coef0 in the code.
 4613:             // The value of gamma needs to be < 0.5.
 4614: 
 4615:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4616:             // side under consideration in each of the two possible elements that share the side.
 4617:             Vector2 sumU = {0.0, 0.0};
 4618:             for (int l = 0; l < 2; l++) {
 4619:                const Element *elem = side->elems[l];
 4620: 
 4621:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4622: 
 4623:                // Find the local index of the side in the element
 4624:                const int idxSide = elem->sideLocalIdx(side);
 4625: 
 4626:                // Find the two sides that are connected to the side under consideration
 4627:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4628:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4629: 
 4630:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4631: 
 4632:             }
 4633: 
 4634:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4635: 
 4636:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4637:    
 4638:          }
 4639:       }
 4640:       else if constexpr(ihorcon == 2) {
 4641:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4642:       }
 4643: 
 4644: 
 4645:    }
 4646: 
 4647: 
 4648:    __global__ void setEssentialBC(void) {
 4649:       // Set essential boundary conditions 
 4650:       NODE(node); // Each boundary node
 4651:       NodeBoundary *nodeBnd = node->nodeBnd;
 4652:       
 4653:  
 4654:       // Check if this node has essential BC
 4655:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4656:          // Verify BC value is valid
 4657:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4658: 
 4659:        
 4660:          // Set diagonal to 1 and zero off-diagonals
 4661:          node->coeffDiag = 1.0;
 4662: 
 4663:          for (int j = 0; j < node->numNodes; j++) {
 4664:                node->coeffMatrix[j] = 0.0;
 4665:          }
 4666:          
 4667:          // Set solution and RHS to BC value
 4668:          node->mX  = nodeBnd->elbc;
 4669:          node->qel = nodeBnd->elbc;
 4670: 
 4671:       } else {
 4672:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4673: 
 4674:          for (int j = 0; j < node->numNodes; j++) {
 4675:                Node* nbNode = node->nodes[j];
 4676:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4677:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4678:                   // Verify neighbor's BC value
 4679:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4680: 
 4681:                   // Subtract contribution to RHS
 4682:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4683:                   node->coeffMatrix[j] = 0.0;  
 4684:                }
 4685:          }
 4686:       }
 4687:    }
 4688: 
 4689: 
 4690:    __global__ void updateElevation(void) {
 4691:       NODE(node);
 4692: 
 4693: 
 4694:       node->eta2 = node->mX;
 4695: 
 4696:       node->updateZCoordData();
 4697:    }
 4698: 
 4699: 
 4700:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4701: 
 4702:       SIDE(side);
 4703: 
 4704:       side->U = {0.0, 0.0}; 
 4705:          
 4706:       if(side->isDry) return;
 4707: 
 4708:       // Vertically integrated velocity U (in ll if ics=2)
 4709:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4710:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4711:          side->U += side->Dz(k + 1)*uc;  
 4712:       }
 4713: 
 4714:    }
 4715: 
 4716:    __global__ void computeBottomDragVegetation(void) {
 4717:       // UNFINISHED. CHECK THIS:
 4718:       // How many kernels are needed? Why so many for loops?
 4719:       // Is the loop on sides needed?
 4720: 
 4721:       NODE(node);
 4722: 
 4723: 
 4724:       const int    kb      = node->kb;
 4725:       const double htot    = node->htot2(); 
 4726:       
 4727:       if (node->isDry) {
 4728:          // Default values for dry nodes
 4729:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4730:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4731: 
 4732:          return;
 4733:        
 4734:       }
 4735: 
 4736:       // Computes bottom drag Cd based on the selected nchi
 4737:       node->computeBottomDragCd();
 4738:       
 4739: 
 4740: 
 4741:       //   Bottom stress in m^2/s^2
 4742:       if (node->rho[kb + 1] >= -98.0)
 4743:       {
 4744:          const double mag_u = length(node->u2[kb + 1]);
 4745:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4746: 
 4747:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4748:          // !sediment erosion: this part needs more documentation
 4749:       }
 4750:     
 4751: 
 4752: 
 4753:       // Compute vegetation parameters
 4754:       //--------------------------------
 4755: 
 4756:       // SAV constants
 4757:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4758:       constexpr double veg_cfpsi = 0.16;
 4759: 
 4760:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4761:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4762: 
 4763:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4764:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4765:          int kbin = 0; // bin index
 4766:          for (int k = kb; k < nvrt; k++) {
 4767:             // Computes node height above the bottom level
 4768:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4769:             assert(false && "Vertical variation of vegetation not implemented");
 4770: 
 4771:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4772:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4773:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4774:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4775:             // } else {
 4776:             //    // Find the bin at which the current vertical level is
 4777:             //    while (kbin<nbins_veg_vert) {
 4778:             //       const double zn = node->z[kbin];
 4779:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4780:             //          break;
 4781:             //       } // if
 4782:             //       kbin++;
 4783:             //    } // while
 4784:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4785: 
 4786:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4787:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4788:                
 4789:             //    // Linear interpolation of the vegetation parameters
 4790:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4791:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4792:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4793:             // } // if rl10
 4794: 
 4795:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4796: 
 4797:          } // for k
 4798: 
 4799: 
 4800:       } else { // Ganthy (iveg==2)
 4801:       //  Modify canopy height, diameter, and density
 4802: 
 4803:          // Make sure there is vegetation on this node
 4804:          if (node->veg_h_unbent > 0.0) {
 4805:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4806: 
 4807:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4808:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4809:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4810: 
 4811:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4812:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4813:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4814:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4815:          } // if veg_h_unbent
 4816: 
 4817:          for (int k = 0; k < nvrt; k++) {
 4818:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4819:          } // for k
 4820:       
 4821: 
 4822:       } // if iveg
 4823:      
 4824: 
 4825:       // Compute vertical mean of veg_alpha3D
 4826:       if (iveg != 0) {
 4827:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4828:          double sum1=0.0;
 4829:          double sum2=0.0;
 4830:          // Integrate over each level under the canopy...
 4831:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4832:             const double Dz = node->Dz(k);
 4833: 
 4834:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4835:             sum2 += Dz;
 4836: 
 4837:          } // for k
 4838:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4839:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4840: 
 4841:       } // if iveg
 4842: 
 4843:    }
 4844: 
 4845:    __global__ void computeVegetationAndDragParameters(void) {
 4846:       // Computes the vegetation and drag model parameters:
 4847:       // chi, \tilde\chi, beta, \breve{H}
 4848:       
 4849:       SIDE(side);
 4850: 
 4851:       side->hhat = 0.0;
 4852:       side->chi2 = 0.0;
 4853:       side->chi = 0.0;
 4854:       side->veg_c2 = 0.0;
 4855:       side->veg_beta = 0.0;
 4856: 
 4857:       if (side->isDry) return;
 4858: 
 4859:       const double htot = side->htot2();
 4860:       const int    kb   = side->kb;
 4861: 
 4862:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4863: 
 4864:       const double veg_h     = side->veg_h();
 4865:       const double veg_nv    = side->veg_nv();
 4866:       const double veg_c     = side->veg_c();
 4867:       const double veg_beta  = side->veg_beta;
 4868:       const double veg_alpha = side->veg_alpha_vert_mean();
 4869: 
 4870:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4871:       // Velocity magnitude at the bottom level
 4872:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4873:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4874:       side->chi2 = side->Cd()*vmag1;
 4875:       side->chi  = side->chi2;
 4876:       if constexpr(iveg != 0) {
 4877:          const Node *n1 = side->n1;
 4878:          const Node *n2 = side->n2;
 4879:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4880:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4881:       }
 4882: 
 4883:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4884: 
 4885:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4886:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4887:       double magUa = 0.0;
 4888:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4889:          // 3D wet side with veg...
 4890: 
 4891:          double magUa = 0.0;
 4892:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4893:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4894: 
 4895:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4896:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4897:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4898: 
 4899:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4900:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4901: 
 4902:                // Velocity magnitude at the bottom (l) of the level
 4903:                const double ul = length(side->u2[k]);
 4904: 
 4905:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4906:                magUa += Dz*0.5*(uh + ul);
 4907: 
 4908:             } // if HasVegetation
 4909:          } // for k
 4910:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4911: 
 4912:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4913:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4914:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4915:             const double zCpy = side->zTopCanopy();
 4916:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4917:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4918:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4919:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4920:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4921:          } // if isSubmerged
 4922:       } // if iveg   
 4923: 
 4924:       // Computes the friction modified depth, \breve{H} in notes
 4925:       if (side->is2D()) { // 2D
 4926: 
 4927:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4928:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4929: 
 4930:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4931: 
 4932:          side->hhat = htot*htot/fricH; 
 4933: 
 4934:       } else { // 3D
 4935:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 4936: 
 4937:          if constexpr(iveg != 0) {
 4938:             
 4939:             if (side->isSubmerged()) { 
 4940:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4941:                side->hhat -= veg_c*Hhat_alpha;
 4942: 
 4943:             } else { // Emergent
 4944:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4945:             }
 4946:          } // if iveg
 4947: 
 4948:          // Enforce positivity for 3D model
 4949:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4950:       } // if 3D
 4951: 
 4952:    }
 4953: 
 4954: 
 4955: 
 4956:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4957:    // Computes the density gradient between two elements, e1 and e2.
 4958:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4959:    // zero in the direction normal to the side. 
 4960:    // 
 4961:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4962:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4963:    //
 4964:    // Input:
 4965:    //    e1: Element
 4966:    //    e2: Neighbor element (or nullptr if boundary)
 4967:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4968:    //    k: Index of the half-level at which the density is interpolated
 4969:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4970:    // 
 4971:    // Output:
 4972:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4973:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4974: 
 4975:       if (e2 == nullptr || e2->isDry) {
 4976:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4977: 
 4978:          Side *side = e1->sides[j];
 4979:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4980:                  
 4981:          if constexpr(ics == 1) {
 4982:             vec = side->n; // Normal vector to the side
 4983:          } else {
 4984:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4985:             // IMPLEMENT THIS XXXXXX
 4986:             // !replace with xel, yel?
 4987:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4988:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4989:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4990:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4991:          } //ics
 4992:                    
 4993:          diffRho = 0.0;
 4994: 
 4995:       } else { //internal and wet
 4996:          if constexpr(ics==1) {
 4997:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4998: 
 4999:             // Vector from e1 to e2
 5000:             vec = e2->center - e1->center;
 5001: 
 5002:          } else { 
 5003:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5004:             // IMPLEMENT THIS XXXXXX
 5005:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5006:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5007:             //                   alow(j)=xctr2
 5008:             //                   bdia(j)=yctr2
 5009:          } // ics
 5010: 
 5011:          diffRho = rho2 - e1->demeanedDensity(k);
 5012:       }
 5013: 
 5014:    }
 5015: 
 5016:    __global__ void computeDensityCubicSplines(void) {
 5017:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5018: 
 5019:       ELEM(elem);
 5020: 
 5021:       if (elem->isDry) return;
 5022: 
 5023:       const int kb = elem->kb;
 5024: 
 5025:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5026:       if (elem->is2D()) {
 5027:          // In the 2D case, the density is constant at the prism level. 
 5028:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5029:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5030:       } else { //3D
 5031: 
 5032:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5033:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5034:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5035:          ///// XXXX CHECK INDICES!!!!!
 5036:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5037:       } // 2D/3D
 5038: 
 5039:    }
 5040: } // extern "C"
 5041: 
 5042: 
 5043: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5044: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5045: 
 5046:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5047: 
 5048:    const int kb  = elem->kb;
 5049:    const int kb2 = elem2->kb;
 5050: 
 5051:    // z-coordinate of prism of elem
 5052:    const double zp = elem->z_prism(k);
 5053: 
 5054:    double rho = 0.0;
 5055: 
 5056:    if (elem2->is2D()) {
 5057:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5058: 
 5059:    } else {  // 3D
 5060: 
 5061:       // eta_min may be < zmax
 5062:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5063:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5064: 
 5065:       // (Extrapolate density below bottom, we will fix it later)
 5066:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5067:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5068:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5069:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5070:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5071:    } // 2D/3D
 5072:      
 5073: 
 5074:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5075:    // Now we need to fix it.
 5076:    if (elem->z[k] < elem2->z[kb2]) {
 5077:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5078: 
 5079:       // There are two methods to adjust the density at the bottom of the element.
 5080:       // iunder_deep=0: 
 5081:       const double depth1 = abs(elem->z[kb]); // larger depth
 5082: 
 5083:       if (iunder_deep==0) {
 5084: 
 5085:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5086: 
 5087:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5088: 
 5089:       } else { // iunder_deep != 0
 5090: 
 5091:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5092: 
 5093:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5094: 
 5095:          //   Demeaned density at the same z coordinate as
 5096:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5097:          }
 5098: 
 5099:       } // if iunder_deep
 5100:    } // if elem->z[kb] < elem2->z[kb]
 5101: 
 5102:    return rho;
 5103: }
 5104: 
 5105: 
 5106: extern "C" {
 5107:    __global__ void computeDensityGradient(void) {
 5108: 
 5109:       if constexpr(ibc != 0) return;
 5110: 
 5111:          // Compute the horizontal density gradient at each element.
 5112:       // It works in two steps:
 5113:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5114:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5115:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5116:       //             gradRho.r1 = rho1 - rho0
 5117:       //             gradRho.r2 = rho2 - rho0
 5118:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5119:       // 
 5120:       //  NOTE: We use de-meaned densities.
 5121: 
 5122:       ELEM(elem);
 5123: 
 5124:       if (elem->isDry) return;
 5125: 
 5126:       const int kb  = elem->kb;
 5127:       const int i34 = elem->i34;
 5128: 
 5129:       for (int k = kb + 1; k < nvrt; k++) {
 5130:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5131:          //             gradRho.r1 = rho1 - rho0
 5132:          //             gradRho.r2 = rho2 - rho0
 5133:          int icount = 0;
 5134:          double sumRx = 0.0;
 5135:          double sumRy = 0.0;
 5136:          for (int j1=0; j1<i34; j1++) { 
 5137: 
 5138:             const int j2 = elem->nxq(j1 + 1);
 5139: 
 5140:             // Pairs of consecutive neighbor elements of elem
 5141:             const Element *e1 = elem->nghbElems[j1];
 5142:             const Element *e2 = elem->nghbElems[j2];
 5143: 
 5144:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5145:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5146:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5147: 
 5148:             // Compute the density difference and the vector from elem to e1 and e2
 5149:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5150:             double diffRho1, diffRho2;
 5151:             Vector2 vec1, vec2;
 5152:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5153:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5154: 
 5155:             const double rl1 = length(vec1);
 5156:             const double rl2 = length(vec2);
 5157:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5158: 
 5159:             const double delta = cross(vec1, vec2);
 5160:             const double sintheta = abs(delta)/(rl1*rl2);
 5161: 
 5162:             // To avoid problems, avoid elements with small angle between vectors
 5163:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5164:             const bool validEq = (sintheta > sin_one_deg);
 5165: 
 5166:             if (validEq) {
 5167:                // Solve the system of equations to get the density gradient at elem
 5168:                icount++;
 5169:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5170:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5171:                sumRx += Rx;
 5172:                sumRy += Ry;
 5173:             }
 5174:          } // for j1
 5175: 
 5176:          // Compute the average density gradient at elem
 5177:          if (icount==0) {
 5178:            // Bad mesh quality; bail out with 0 b-cc
 5179:            elem->gradRho[k] = {0.0, 0.0};
 5180:          } else {
 5181:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5182:          }
 5183: 
 5184:       } // for k
 5185: 
 5186:    }
 5187: 
 5188:    __global__ void computeBaroclinicTerm(void) {
 5189:    // Computes the baroclinic term at sides (at half levels).
 5190:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5191:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5192: 
 5193:       if (ibc == 1) return;
 5194: 
 5195:       SIDE(side);
 5196: 
 5197:       if (side->isDry) return;
 5198: 
 5199:       const Element *e1 = side->elems[0];
 5200:       const Element *e2 = side->elems[1];      
 5201:       const int kb = side->kb;
 5202:       
 5203:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5204: 
 5205:       // interpolates vertically the density gradient of the two elements at the half level/
 5206: 
 5207:       int k1 = max(kb, nvrt / 2);
 5208:       int k2 = max(kb, nvrt / 2);
 5209: 
 5210:       // Starts the integration at the surface and goes down to the bottom
 5211:       side->bcc[nvrt-1] = {0.0, 0.0};
 5212:       for (int k = nvrt - 2; k >= kb; k--) {
 5213:       // For each prism level (from surface to bottom)...
 5214: 
 5215:          // For both elements, interpolate density gradient at the side's half level.
 5216:          // The gradient at the side is the average of the gradients at the elements.
 5217:          // w1, w2 are used to take into account boundary sides, with just one element.
 5218:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5219:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5220:          const double wsum = w1 + w2;
 5221:          w1 = w1/wsum;
 5222:          w2 = w2/wsum;
 5223:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5224: 
 5225:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5226:          Vector2 gradRho = {0.0, 0.0};
 5227:          if (e1 != nullptr && k > kb) {
 5228:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5229:             
 5230:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5231:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5232:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5233: 
 5234:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5235:          }      
 5236:          if (e2 != nullptr && k > kb) {
 5237:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5238:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5239:             
 5240:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5241:          }
 5242: 
 5243:          if constexpr(ics==2) {
 5244:             assert(false && "Not implemented: ics == 2");
 5245:             // IMPLEMENT THIS XXXXXX
 5246:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5247:             // swild(1)=tmp1
 5248:             // swild(2)=tmp2
 5249:          }
 5250:          
 5251:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5252:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5253:          // CHECK INDICES!!! XXX
 5254:          const double grav3 = side->grav3();
 5255:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5256: 
 5257:       } // for
 5258: 
 5259:    }
 5260: 
 5261: 
 5262: 
 5263:    __global__ void computeHorGradientAtSide(void) {
 5264: 
 5265:       // Compute the horizontal density gradient at each element.
 5266:       // It works in two steps:
 5267:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5268:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5269:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5270:       //             gradRho.r1 = rho1 - rho0
 5271:       //             gradRho.r2 = rho2 - rho0
 5272:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5273:       // 
 5274:       //  NOTE: We use de-meaned densities.
 5275: 
 5276:       SIDE(side);
 5277: 
 5278: 
 5279:       if (side->isDry) return;
 5280: 
 5281:       // Computes the gradient of the variables at the side center.
 5282:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5283:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5284:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5285: 
 5286:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5287:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5288:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5289:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5290: 
 5291:    }
 5292: 
 5293: 
 5294:    __global__ void solveMomentumEquations(double time) {
 5295: 
 5296:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5297:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5298: 
 5299:       SIDE(side);
 5300: 
 5301:       if (side->isDry) 
 5302:       {
 5303:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5304: 
 5305:          return;
 5306:       }
 5307: 
 5308:       const Node *n1 = side->n1;
 5309:       const Node *n2 = side->n2;
 5310: 
 5311:       const int kb = side->kb;
 5312: 
 5313:       const double veg_h = side->veg_h();
 5314:       const double grav3 = side->grav3();
 5315: 
 5316:       if (side->is2D()) {
 5317:          // Remember: Do not use htot2, which is updated.
 5318:          const double htot = side->htot1();
 5319:          const double hhat = side->hhat;
 5320: 
 5321:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5322: 
 5323:          Vector2 tau2 = {0.0, 0.0};
 5324:           
 5325:          if constexpr(ics==1) {
 5326:             tau2 = side->tau();
 5327: 
 5328:          } else {
 5329:             assert(false && "Not implemented: ics == 2");
 5330:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5331:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5332:             // taux2=(vn1+tt1)*0.5d0
 5333:             // tauy2=(vn2+ss1)*0.5d0
 5334:          } // if ics         
 5335: 
 5336:          // hat_gam has units of m/s
 5337: 
 5338:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5339:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5340:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5341: 
 5342:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5343: 
 5344: 
 5345:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5346: 
 5347:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5348: 
 5349:       }
 5350:       else { // 3D
 5351: 
 5352:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5353:          // 
 5354:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5355:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5356:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5357:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5358:          // k+1 and k.
 5359: 
 5360: 
 5361:          const int ndim = nvrt - kb;
 5362:          const double zTopCanopy = side->zTopCanopy();
 5363: 
 5364:          // Initialize the tridiagonal system
 5365:          for (int k = kb + 1; k < nvrt; k++) {
 5366:             
 5367:             const int kin = k - (kb + 1);
 5368: 
 5369:             // Vertical viscosity at the face center
 5370:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5371: 
 5372:  
 5373:             alow[kin] = 0.0;
 5374:             cupp[kin] = 0.0;
 5375:             bdia[kin] = 0.0;
 5376: 
 5377:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5378:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5379: 
 5380:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5381:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5382:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5383: 
 5384:             // First part: layers k, k+1
 5385:             if (k < nvrt - 1) {
 5386:                              
 5387:                if constexpr(iveg != 0) {
 5388: 
 5389:                   // If there is vegetation at this level...
 5390:                   if (zTopCanopy > side->zc[k]) {
 5391:                      // If the canopy is above the k layer...
 5392:                      
 5393:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5394:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5395:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5396:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5397: 
 5398:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5399:                      const double vmag2 = length(ut2);
 5400:                      const double vmag1 = length(side->u2[k]);
 5401:                      const double vmag = 0.5*(vmag1 + vmag2);
 5402:                      
 5403:                      // Computes the vegetation alpha at the face center
 5404:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5405: 
 5406:                      cff1 += veg_alpha_sd*dt*vmag;
 5407: 
 5408:                   } // if (zTopCanopy
 5409:                } // if iveg
 5410: 
 5411:                const double dzz = side->Dz(k + 1);
 5412:                const double tmp = dt*dfz/dzz;
 5413:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5414: 
 5415:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5416:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5417:             }
 5418: 
 5419: 
 5420:             // Second part: layers k-1, k
 5421:             if (k > kb + 1) {
 5422: 
 5423:                double cff1 = 1.0; //init \bar{c^k}
 5424: 
 5425:                if constexpr(iveg != 0) {
 5426:                   // If there is vegetation at this level...
 5427:                   if (zTopCanopy > side->zc[k-1]) {
 5428:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5429:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5430: 
 5431:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5432: 
 5433:                      const double vmag2 = length(ut2);
 5434:                      const double vmag1 = length(side->u2[k-1]);
 5435:                      const double vmag = 0.5*(vmag1 + vmag2);
 5436: 
 5437:                      // Computes the vegetation alpha at the face center
 5438:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5439:                      cff1 += veg_alpha_sd*dt*vmag;
 5440:                   } // if zTopCanopy
 5441: 
 5442:                } // if iveg
 5443: 
 5444:                const double dzz = side->Dz(k);
 5445:                const double tmp = dt*dfz/dzz;
 5446:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5447: 
 5448:                alow[kin] += cff1*dzz/6.0 - tmp;
 5449:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5450: 
 5451:             } else { // Bottom boundary
 5452:                // This occurs at the bottom, where the bottom drag is applied.
 5453: 
 5454:                bdia[kin] += dt*side->chi2; // XXXX
 5455: 
 5456:             } // if (k > kb + 1)
 5457: 
 5458: 
 5459:          } // for (int k
 5460: 
 5461: 
 5462: 
 5463:          // Computes the RHS.
 5464:          // -----------------
 5465: 
 5466:          //	BC to be imposed at the end.
 5467: 
 5468:          const Vector2 gradETP  = side->gradETP;
 5469:          const Vector2 gradPr   = side->gradPr;
 5470:          const Vector2 gradEta1 = side->gradEta1;
 5471:          const Vector2 gradEta2 = side->gradEta2;
 5472: 
 5473:          const Vector2 *btu = side->btu;
 5474:          const Vector2 *u2  = side->u2;
 5475:          const double coriolis = side->coriolis;
 5476:          const Vector2 *nuGradU = side->nuGradU;
 5477: 
 5478: 
 5479:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5480:          for (int k = kb + 1; k < nvrt; k++) {
 5481:             const int kin = k - kb - 1;
 5482: 
 5483:             const double dz_0 = side->Dz(k);
 5484:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5485: 
 5486:             rrhs[kin] = {0.0, 0.0};
 5487:             double dz = 0.0;
 5488: 
 5489:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5490:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5491:             if (k < nvrt  ) dz += dz_1;
 5492:             if (k > kb + 1) dz += dz_0;
 5493: 
 5494:             // Elevation gradient, atmospheric pressure and tidal potential
 5495:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5496: 
 5497:             // Coriolis, advection, wind stress, and horizontal viscosity
 5498:             if (k < nvrt - 1) {
 5499: 
 5500: 
 5501:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5502:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5503:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5504:                                                 
 5505: 
 5506:                //diff stress tensors 1006
 5507:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5508:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5509:                   assert(false && "Not implemented: itur == 5");
 5510:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5511:                }
 5512:                // else assert(false && "itur # Not implemented");
 5513: 
 5514:             } else { // k == nvrt - 1 SURFACE
 5515:                Vector2 tau2 = {0.0, 0.0};
 5516:                if constexpr(ics==1) {
 5517:                   tau2 = side->tau();
 5518:       
 5519:                } else {
 5520:                   assert(false && "Not implemented: ics == 2");
 5521:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5522:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5523:                   // taux2=(vn1+tt1)*0.5d0
 5524:                   // tauy2=(vn2+ss1)*0.5d0
 5525:                } // if ics
 5526: 
 5527:                rrhs[kin] += dt*tau2;
 5528:           
 5529: 
 5530:             } // if k<nvrt
 5531: 
 5532: 
 5533:             if (k > kb + 1) {
 5534:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5535:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5536:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5537: 
 5538:                // diff stress tensors 1006
 5539:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5540:                   assert(false && "Not implemented: itur == 5");
 5541:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5542:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5543:                }
 5544:                // else assert(false && "itur # Not implemented");
 5545: 
 5546: 
 5547:             } // if k>kbs + 1
 5548: 
 5549:             // Baroclinic
 5550:             Vector2 *bcc = side->bcc;
 5551:             if constexpr(ibc == 0) {
 5552:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5553:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5554: 
 5555:             } // if ibc==0
 5556: 
 5557:          } // k=kb + 1,nvrt
 5558: 
 5559: 
 5560:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5561: 
 5562:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5563:             const int kin = k - kb - 1;
 5564:    
 5565:             // Velocity is always clamped to maximum values
 5566:             side->u2[k] = clampVelocity(soln[kin]);
 5567:          } // k
 5568: 
 5569:       } // if side->is2D()
 5570:       
 5571: 
 5572:       // Impose velocity boundary condition at the bottom
 5573:       if constexpr(imm == 2) { // 3D bed deformation model
 5574:          double dep;
 5575:          Vector2 vel;
 5576: 
 5577:          assert(false && "Not implemented: imm == 2");
 5578:          //update_bdef(time, x0, y0, dep, vel);
 5579:          // side->u2[kb] = vel;
 5580: 
 5581:       } else { // imm = 0 or 1
 5582:          if (side->Cd() == 0.0) {
 5583:             side->u2[kb] = side->u2[kb + 1];
 5584: 
 5585:          } else if (side->is3D()) { // 3D no slip bottom   
 5586:             side->u2[kb] = {0.0, 0.0};
 5587: 
 5588:          }
 5589:           
 5590:       } // if imm
 5591: 
 5592:       // The velocities below the bottom level are set to zero
 5593:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5594: 
 5595: 
 5596:    }
 5597: 
 5598: 
 5599:    __global__ void applyMomentumBC(void) {
 5600: 
 5601:       SIDE_BND(sideBnd);
 5602: 
 5603:       Side *side = sideBnd->side;
 5604:       const BoundarySegment *segment = sideBnd->segment;
 5605:       const Node *n1 = side->n1;
 5606:       const Node *n2 = side->n2;
 5607: 
 5608:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5609: 
 5610:       const bool isLand = segment->isLand;
 5611:       const int ifltype = segment->ifltype;
 5612: 
 5613:       const int kb = side->kb;
 5614: 
 5615: 
 5616:       if (!isLand && ifltype != 0) {
 5617:          const Vector2 *ubc = sideBnd->ubc;
 5618:   
 5619:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5620:             
 5621:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5622:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5623: 
 5624:             if (ifltype == -1) {
 5625:                // Flather 1
 5626: 
 5627:                const double depth = side->depth();
 5628: 
 5629:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5630: 
 5631:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5632: 
 5633:                side->u2[k] = vnorm*side->n;
 5634: 
 5635:             } else if (ifltype == -2) { // Discharge
 5636: 
 5637:                const double eta1 = side->eta1();
 5638:                const double eta2 = side->eta2();
 5639:                const double htot = side->htot2();
 5640: 
 5641:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5642:                assert(false && "Not implemented: Discharge bc");
 5643:                // const double dischrg = discharge(eta1);
 5644:                const double dischrg = 0.0; // XXX REMOVE
 5645:                
 5646: 
 5647:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5648: 
 5649:                const double vnorm = dischrg*eta2/htot;
 5650: 
 5651:                side->u2[k] = vnorm*side->n;
 5652: 
 5653:             }
 5654:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5655:                const double vnorm = dot(side->u2[k], side->n);
 5656: 
 5657:                double rat;
 5658:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5659:                else              rat = segment->vobc2; // outgoing
 5660: 
 5661:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5662: 
 5663:             }
 5664:             else { // not Flather or 3D radiation
 5665:                side->u2[k] = ubc[k];
 5666: 
 5667:             } // if (segment->ifltype...
 5668: 
 5669:          }
 5670: 
 5671:       }
 5672:       else if (isLand) { // if it is land boundary side
 5673: 
 5674:          if constexpr(islip == 0) { // free slip
 5675: 
 5676:             for (int k = kb; k < nvrt; k++) {
 5677: 
 5678:                const Vector2 t = side->t();
 5679:                const Vector2 n = side->n;
 5680: 
 5681:                double vnorm = 0.0; // for most cases
 5682:                const double vtan = dot(side->u2[k], t);
 5683:                
 5684:                side->u2[k] = vtan*t - vnorm*n;
 5685: 
 5686:             }
 5687: 
 5688:          } else { // no slip
 5689:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5690: 
 5691:          }
 5692:       } // if (side segment type...
 5693: 
 5694:    
 5695: 
 5696:    }
 5697: 
 5698: 
 5699:    __global__ void shapiroFilter1(void) {
 5700:       // First step of the Shapiro filter (normally used if indvel<=0)
 5701:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5702: 
 5703:       SIDE(side);
 5704: 
 5705:       // Only internal wet sides are processed
 5706:       if (side->isDry || !(side->isInternal())) return;
 5707: 
 5708:       const int kb = side->kb;
 5709: 
 5710:       for (int mm = 0; mm < niter_shap; mm++) {
 5711: 
 5712:          for (int k = kb + 1; k < nvrt; k++) {
 5713:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5714:             Vector2 suru = {0.0, 0.0};
 5715: 
 5716:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5717: 
 5718:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5719: 
 5720:                int kin = k;
 5721:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5722:                
 5723:                if constexpr(ics==1) {
 5724:                   suru += nSide->u2[kin];
 5725: 
 5726:                } else {
 5727:                   assert(false && "Not implemented: ics == 2");
 5728:                   // Vector2 vn1, vn2;
 5729:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5730:                   // suru=suru+vn1;
 5731:                   // surv=surv+vn2;
 5732:                }
 5733:             }
 5734: 
 5735:             // Reusing bcc as a temporary array to store the suru values.
 5736:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5737: 
 5738:          }
 5739:       }
 5740:    }
 5741: 
 5742:    __global__ void shapiroFilter2(void) {
 5743:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5744: 
 5745:       SIDE(side);
 5746: 
 5747: 
 5748:       if (side->isDry || !(side->isInternal())) return;
 5749: 
 5750:       const int kb = side->kb;
 5751: 
 5752:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5753: 
 5754:       if (side->is2D()) {
 5755:          side->u2[kb + 1] = side->bcc[kb + 1];
 5756:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5757: 
 5758:       } else {
 5759:          // 3D
 5760:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5761:          
 5762:       }
 5763: 
 5764:    }
 5765: 
 5766: 
 5767:    __global__ void ul0UpdateZCoords(void) {
 5768:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5769:       
 5770:       NODE(node);      
 5771: 
 5772: 
 5773:       if (false) { //node->isDry) { XXXXXXX
 5774: 
 5775:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5776: 
 5777:          if constexpr(ivcor != 1) node->kb = 0;
 5778: 
 5779:       } else {
 5780: 
 5781:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5782:          node->updateKb();
 5783: 
 5784:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5785: 
 5786:       }
 5787: 
 5788:       // We use the temp.b field to store the previous state of isDry.
 5789:       node->tmp.b = node->isDry;
 5790: 
 5791:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5792:       node->isDry = true;
 5793: 
 5794:    }
 5795: 
 5796:    __global__ void ul0ComputeDryElements(void)
 5797:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5798:    {
 5799:       ELEM(elem);
 5800: 
 5801:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5802: 
 5803:       elem->kb = 0;
 5804: 
 5805:       if (elem->isDry) return;
 5806: 
 5807: 
 5808:    //    if(elem->isDry2()) { // XXXX
 5809:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5810:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5811:    //        call parallel_abort(errmsg)
 5812:    //    }
 5813: 
 5814:       const Node *n1 = elem->nodes[0];
 5815:       const Node *n2 = elem->nodes[1];
 5816:       const Node *n3 = elem->nodes[2];  
 5817:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5818: 
 5819:       // Computes element's kb as the minimum of the nodes' kb.
 5820:       const int kb1 = n1->kb;
 5821:       const int kb2 = n2->kb;
 5822:       const int kb3 = n3->kb;
 5823:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5824: 
 5825: 
 5826:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5827: 
 5828: 
 5829:       // Computes the element z as the mean of the nodes z.
 5830:       for (int k = elem->kb; k < nvrt; k++) {
 5831: 
 5832:          // Compute the element z as the mean of the nodes z.
 5833:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5834:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5835:          elem->z[k] /= elem->i34;
 5836: if (((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0))) printf("EEEE k = %d, kb = %d, z = %f\n", k, elem->kb, elem->z[k]);
 5837:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5838:       }
 5839:                   
 5840:    }
 5841: 
 5842:    __global__ void ul0ComputeDryNodes(void)
 5843:    // Updates node's isDry based on the elements' isDry. 
 5844:    {
 5845:       NODE(node);
 5846: 
 5847:       node->isDry = true;
 5848: 
 5849:       // A node is wet if at least one of the elements sharing it is wet.
 5850:       for (int j = 0; j < node->numElements; j++) {
 5851:          const Element *elem = node->elements[j];
 5852:          if (!elem->isDry) {
 5853:             node->isDry = false;
 5854:             break;
 5855:          }
 5856:       }
 5857: 
 5858:        
 5859:    }
 5860: 
 5861: 
 5862:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5863:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5864:    // node->tmp.b is true if the node was previously dry.
 5865:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5866:    {
 5867:       NODE(node);
 5868:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5869: 
 5870:       // Avoid this the first time step.
 5871:       if (it == iths) return;  
 5872: 
 5873:       const bool wasDry = node->tmp.b;
 5874: 
 5875: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5876: 
 5877:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5878: 
 5879:          for (int k=0; k < nvrt; k++) {
 5880: 
 5881:             Vector3 utmp={0.0, 0.0, 0.0};
 5882: 
 5883:             double ttmp=0.0;
 5884:             double stmp=0.0;
 5885:             int icount=0;
 5886:             for (int j = 0; j < node->numNodes; j++) {
 5887: 
 5888:                const Node *nbrNode = node->nodes[j];
 5889:                
 5890:                const bool wasNbrDry = nbrNode->tmp.b;
 5891: 
 5892:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5893:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5894: 
 5895:                   icount++;
 5896: 
 5897:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5898:                   utmp += nbrNode->uvw2(k);
 5899:                   
 5900:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5901:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5902:                }
 5903:             }
 5904: 
 5905:             if (icount > 0) {
 5906:                const double inv_icount = 1.0/icount;
 5907:                utmp = inv_icount*utmp;
 5908:                node->u2[k]     = toVector2(utmp);
 5909:                node->w2[k]     = utmp.z;
 5910:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5911:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5912:             } else {
 5913:                node->u2[k] = {0.0, 0.0};
 5914:                node->w2[k] = 0.0;
 5915:                // Initialize tracers to 0.0??? XXXXX
 5916:             }
 5917:          }
 5918:       }
 5919:    }
 5920: 
 5921:   
 5922:    
 5923: 
 5924: 
 5925:    __global__ void ul0UpdateSides(int it, int iths) {
 5926:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5927:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5928:    // The dryness of the sides is updated in ul0UpdateSides2.
 5929: 
 5930:       SIDE(side);
 5931: 
 5932:       // A side is wet if and only if at least one of its elements is wet.
 5933:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5934:  
 5935:       const Node *n1 = side->n1;
 5936:       const Node *n2 = side->n2;
 5937:      
 5938:       const int kb1 = n1->kb;
 5939:       const int kb2 = n2->kb;
 5940: 
 5941:       side->kb = 0; // default when dry
 5942: 
 5943:       if (isWet) {
 5944: 
 5945:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5946: 
 5947:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5948: 
 5949:          side->kb = min(kb1, kb2);
 5950: 
 5951:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5952: 
 5953:          for (int k = side->kb; k < nvrt; k++) {
 5954:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5955: 
 5956:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5957: 
 5958:             // Compute velocity for re-wetted sides 
 5959:             if ((it != iths) && (side->isDry && isWet)) {
 5960: 
 5961:                Vector2 utmp={0.0, 0.0};
 5962: 
 5963:                int icount=0;
 5964: 
 5965:                // For all the sides on the two elements that share this side
 5966:                for (int j = 0; j < 2; j++) {
 5967:                   const Element *elem = side->elems[j];
 5968:                   if (elem == nullptr) continue;
 5969: 
 5970:                   for (int jj=0; jj < elem->i34; jj++) {
 5971:                      const Side *nSide = elem->sides[jj];
 5972:                      if (nSide->isDry) continue;
 5973: 
 5974:                      icount++;
 5975:                      utmp += nSide->u2[k];  
 5976:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5977:                   }
 5978:                }
 5979:                   
 5980:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 5981:                if (icount > 0)  side->u2[k] = utmp/icount;
 5982:                else             side->u2[k] = {0.0, 0.0};
 5983:                   
 5984:             } // if ((it != iths) && (side->isDry && isWet))
 5985: 
 5986:          } // for k
 5987: 
 5988:       } // if isWet 
 5989:       
 5990: 
 5991: 
 5992:    }
 5993: 
 5994:    __global__ void ul0UpdateSides2(void) {
 5995:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5996:    
 5997:          SIDE(side);
 5998:    
 5999:          const Element *e1 = side->elems[0];
 6000:          const Element *e2 = side->elems[1];
 6001: 
 6002:          // A side is wet if and only if at least one of its elements is wet.
 6003:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6004: 
 6005:          // Update the side's dryness
 6006:          side->isDry = !isWet;
 6007: 
 6008:    }
