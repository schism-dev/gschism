 2623: 
 2624: 
 2625: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2626: 
 2627: 
 2628: __device__ void Node::updateKb(void) {
 2629: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2630: 
 2631:    if constexpr(ivcor == 1) return;
 2632: 
 2633: 
 2634:    // Check if node is wet
 2635:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2636: 
 2637:    if (isDry) return;
 2638: 
 2639:    if constexpr(ivcor == 2) {  // SZ coordinates
 2640:       
 2641:       // Compute bottom level index
 2642:       if (depth <= mesh->h_s) {
 2643:          kb = mesh->kz - 1;
 2644:       } else {
 2645:          kb = -1;
 2646:          int L = 0;
 2647:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2648:          
 2649:          while (L <= R) {
 2650:             int M = (R + L) / 2;
 2651: 
 2652:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2653:             
 2654:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2655:                R = M;
 2656:             } else {
 2657:                L = M;
 2658:             }
 2659: 
 2660:             if (R - L == 1) {
 2661:                kb = L;
 2662:                break;
 2663:             }
 2664:          }
 2665:       }
 2666:    } 
 2667: }
 2668: 
 2669: 
 2670: __device__ double Node::compZCoord(int k) const {
 2671:    // Computes the z coordinate at level k.
 2672:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2673:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2674:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2675:    // used 
 2676:    
 2677:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2678:       
 2679:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2680: 
 2681:    if constexpr(ivcor == 2) {
 2682: 
 2683:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2684:       const int kz = mesh->kz;
 2685:       const double h_c = mesh->h_c;
 2686:       const double theta_f = mesh->theta_f;
 2687:       const double sinh_theta_f = mesh->sinh_theta_f;
 2688: 
 2689:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2690:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2691:       // once per time step/node.
 2692:       // CHECK: updateZCoordData
 2693: 
 2694:       if      (k == nvrt-1)      { return eta2; }
 2695:       else if (k == kz)          return -hmod2;
 2696:       else if (k == kb)          return -depth;
 2697:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2698:       else if (k > kz) {
 2699:          const int ksig = k - kz + 1;
 2700: 
 2701:          if (hmod2 <= h_c) {
 2702:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2703:          } 
 2704:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2705:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2706:             assert(false && "ZCOOR: invalid h_c\n");
 2707:          } 
 2708:          else {
 2709:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2710:                          h_c * mesh->sigma[ksig] + 
 2711:                          (hmod2 - h_c) * mesh->cs[ksig];
 2712:          }
 2713:       } else { 
 2714:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2715:       }
 2716: 
 2717:    }
 2718:    else if constexpr(ivcor == 1) {
 2719:       if (k == kb) return -depth;
 2720:       else if (k == nvrt-1) return eta2;
 2721:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2722:    }
 2723:    
 2724:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2725:    return 0.0;
 2726: }
 2727: 
 2728: 
 2729: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2730:    // Checks if a side in on the boundary
 2731:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2732: 
 2733:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2734:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2735: 
 2736:    // Indices of the nodes that form the side
 2737:    const int n1 = side.n1->idx;
 2738:    const int n2 = side.n2->idx;
 2739: 
 2740:    // Check if the side is on a land boundary
 2741:    for (int i = 0; i < nland; i++) {
 2742:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2743:          // Consecutive nodes in the land boundary segment
 2744:          const int b1 = ilnd[i*mnlnd + j];
 2745:          const int b2 = ilnd[i*mnlnd + j + 1];
 2746: 
 2747:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2748:             isLand = true;
 2749:             return i;
 2750:          }
 2751:       }
 2752:    }
 2753: 
 2754:    // Check if the side is on an open boundary
 2755:    for (int i = 0; i < nope; i++) {
 2756:       for (int j = 0; j < nond[i] - 1; j++) {
 2757:          // Consecutive nodes in the open boundary segment
 2758:          const int b1 = iond[i*mnond + j];
 2759:          const int b2 = iond[i*mnond + j + 1];
 2760: 
 2761:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2762:             isLand = false;
 2763:             return i;
 2764:          }
 2765:       }
 2766:    }
 2767:    return -1;
 2768: }
