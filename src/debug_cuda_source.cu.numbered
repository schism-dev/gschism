 1585: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1586:    // Lock the mutex
 1587:    lock(&debugPlotMutex);
 1588:  
 1589:    bool ok = true;
 1590:    if (debugPlotIdx == nullptr) ok = false;
 1591:    if (*debugPlotIdx >= 10000) ok = false;
 1592:    if (ok) {
 1593:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1594:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1595:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1596:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1597:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1598:       (*debugPlotIdx)++;
 1599:    }
 1600: 
 1601:    __threadfence();               // ensure all above writes are visible
 1602:    // Unlock the mutex
 1603:    unlock(&debugPlotMutex);
 1604: 
 1605: }
 1606: 
 1607: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1608:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1609: }
