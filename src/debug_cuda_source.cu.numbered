 9298: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9299:    SIDE(side);
 9300: 
 9301:    switch (varCode) {
 9302:       case (int)VarCode::outputCoords: {
 9303:          const Point2 coords = side->outputCoords();
 9304:          double *out = (double *)((char *)res + idx_side * 16);
 9305:          out[0] = coords.x;
 9306:          out[1] = coords.y;
 9307:          break;
 9308:       }
 9309:       case (int)VarCode::n1:
 9310:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9311:          break;
 9312:       case (int)VarCode::n2:
 9313:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9314:          break;
 9315:       case (int)VarCode::isdry:
 9316:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9317:          break;
 9318:    }
 9319: }
