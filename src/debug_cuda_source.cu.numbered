 7078:    __global__ void resetVelocityOpenBndNodes(void) {
 7079:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7080: 
 7081:       NODE_BND(nodebnd);
 7082: printf("DDDDDDDDDD\n");
 7083:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7084:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7085:       }
 7086: 
 7087:    }
