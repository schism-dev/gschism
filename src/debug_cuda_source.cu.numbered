 4344: extern "C" {
 4345: 
 4346:    __global__ void scaleGravity(double loadtide_coef) {
 4347: 
 4348: 
 4349:       NODE(node);
 4350: 
 4351:       // SAL option: scale gravity
 4352:       if constexpr(iloadtide==2) {  // simple const
 4353:          node->grav2 = grav*(1.0 - loadtide_coef);
 4354: 
 4355:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4356:         
 4357:           const double depth = max(node->depth, 0.0);
 4358:           const double tmp1 = sqrt(depth);
 4359:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4360:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4361:                              2.6969e-13*depth*depth*depth*tmp1;
 4362:           
 4363:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4364:           
 4365: 
 4366: 
 4367:           node->grav2 = grav*(1.0 - beta_bar);
 4368: 
 4369:       } else {  // iloadtide=0,1
 4370:         node->grav2=grav;
 4371: 
 4372:       }
 4373: 
 4374:    }
 4375: 
