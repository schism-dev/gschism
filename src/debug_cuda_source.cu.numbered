 7985: __global__ void printMatrix(bool full) {
 7986:    // Debugging: print the matrix
 7987: 
 7988:    const int size = mesh->np;
 7989:    double sum = 0.0;
 7990:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7991:       const Node *node = mesh->localNodeData + idx_node;
 7992:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7993:       for (int j = 0; j < node->numNodes; j++) {
 7994:          Node* nbNode = node->nodes[j];
 7995:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7996:          sum += node->coeffMatrix[j];
 7997:       }
 7998:       if (full) printf("]\n");
 7999: 
 8000: 
 8001:    }
 8002:    if (!full) printf("sum=%lf\n", sum);
 8003: }
