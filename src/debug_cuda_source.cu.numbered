 2518: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2519:    // Returns the value of the velocity at the side center
 2520:    const double w1 = getBoundaryArrayValueWeight();
 2521:    const double w2 = 1.0 - w1;
 2522:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2523:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2524: 
 2525:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2526: }
 2527: 
 2528: 
 2529: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2530:    // Returns the value of the normal component of the velocity at the side center
 2531:    const double w1 = getBoundaryArrayValueWeight();
 2532:    const double w2 = 1.0 - w1;
 2533:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2534:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2535: 
 2536:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2537: }
