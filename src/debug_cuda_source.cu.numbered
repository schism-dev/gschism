 7924:          break;
 7925:       // case (int)VarCode::depth:
 7926:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 7927:       //    *sizeType = sizeof(double);
 7928:       //    break;         
 7929:       case (int)VarCode::x:
 7930:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 7931:          *sizeType = sizeof(Vector2);
 7932:          break;
 7933:       case (int)VarCode::len:
 7934:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 7935:          *sizeType = sizeof(double);
 7936:          break;
 7937:       case (int)VarCode::kb:
 7938:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7939:          *sizeType = sizeof(int);
 7940:          break;
 7941:       case (int)VarCode::isdry:
 7942:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7943:          *sizeType = sizeof(int);
 7944:          break;            
 7945:       case (int)VarCode::w:
 7946:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7947:          *sizeType = sizeof(double);
 7948:          break;
 7949:       case (int)VarCode::u:
 7950:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7951:          *sizeType = sizeof(Vector2);
 7952:          break;   
 7953:       case (int)VarCode::n1:
 7954:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7955:          *sizeType = sizeof(Node);
 7956:          break;
 7957:       case (int)VarCode::n2:
 7958:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7959:          *sizeType = sizeof(Node);
 7960:          break;                   
 7961:       default:
 7962:          *offset = -1;
 7963:    }
 7964: }
