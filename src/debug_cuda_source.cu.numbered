  355: // ------------------------------------------------------------------------------------------------
  356: 
  357: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  358:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  359:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  360: }
  361: 
  362: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  363:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  364:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  365: }
  366: 
  367: 
  368: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  369:    x3 = y1*z2 - y2*z1;
  370:    y3 = x2*z1 - x1*z2;
  371:    z3 = x1*y2 - x2*y1;
  372: }
  373: 
  374: 
  375: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  376: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  377: 
  378:    const double radius2 = dot(p, p);
  379:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  380:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  381: 
  382:    rlon = atan2(p.y, p.x); // (-pi,pi]
  383: 
  384:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  385:       rlat = asin(p.z/sqrt(radius2));
  386:    } else {
  387:       rlat = asin(p.z/rearth_pole);
  388:    }
  389:   
  390: }
  391: 
  392: __inline__ __device__ void Error(const char* msg) {
  393:    printf("Error: %s\n", msg);
  394:    assert(false);
  395: }
