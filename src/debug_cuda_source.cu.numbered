  598: // ----------------------------- Turbulence -----------------------------
  599: 
  600: 
  601: 
  602: constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
  603: constexpr double veg_cfpsi = 0.16;
