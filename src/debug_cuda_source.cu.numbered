 4001:    //          if(icount>nfltype2) call parallel_abort('STEP: wrong counting 6')
 4002:    //          do j=1,nond_global(k)
 4003:    //            icount2=icount2+1
 4004:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 4005: 
 4006:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 4007:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 4008:    //          enddo !j
 4009:    //        endif
 4010:    //      enddo !k
 4011:    //    endif !nfltype2
 4012:    }
