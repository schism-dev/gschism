 2424:    template<typename T>
 2425:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2426:       T values[4];
 2427:       getNodalValues(field, values);
 2428: 
 2429:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2430:       if constexpr (IsVector2<T>::value && ics == 2) {
 2431: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2432:          projectNodeVectorsToElementFrame(values);
 2433: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2434:       }
 2435: 
 2436:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2437:    }
