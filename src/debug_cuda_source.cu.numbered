 1427: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1428:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1429: }
 1430: 
 1431: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1432:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1433: }   
 1434: 
 1435: __device__ __inline__ double min3(double a, double b, double c) {
 1436:    return min(a, min(b, c));
 1437: }
 1438: 
 1439: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1440:    return min(a, min(b, min(c, d)));
 1441: }
