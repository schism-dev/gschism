 8098: extern "C" __global__ void populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 8099:    double *node_coords, double *node_coords_ll, bool use_ll, double *wind_rotate_angle, 
 8100:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8101:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8102:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 8103:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 8104:    double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 8105: 
 8106:    mesh->populateNodes(i34, isbnd, sharedIdxNodeBoundary, 
 8107:                        node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8108:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8109:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8110:                        localNodeIndices, localElemIndices, localSideIndices,
 8111:                        localNodePart, localElemPart, localSidePart,
 8112:                        drag, roughness, rmanning, kb, localSigma);
 8113: }  
