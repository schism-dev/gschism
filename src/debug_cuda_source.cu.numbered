 1559: __device__ __inline__ double min3(double a, double b, double c) {
 1560:    return min(a, min(b, c));
 1561: }
 1562: 
 1563: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1564:    return min(a, min(b, min(c, d)));
 1565: }
