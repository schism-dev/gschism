 9945: 
 9946: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9947:    ELEM(elem);
 9948: 
 9949:    switch (varCode) {
 9950:       case (int)VarCode::outputCoords: {
 9951:          const Point2 coords = elem->outputCoords();
 9952:          double *out = (double *)((char *)res + idx_elem * 16);
 9953:          out[0] = coords.x;
 9954:          out[1] = coords.y;
 9955:          break;
 9956:       }
 9957:       case (int)VarCode::FaceIndices: {
 9958:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9959:          for (int j = 0; j < 4; j++)
 9960:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9961:          break;
 9962:       }
 9963:       case (int)VarCode::isdry:
 9964:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9965:          break;
 9966:       case (int)VarCode::w: {
 9967:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9968:          if (k >= 0)
 9969:             out[0] = elem->w[k];
 9970:          else
 9971:             for (int lev = 0; lev < nvrt; lev++)
 9972:                out[lev] = elem->w[lev];
 9973:          break;
 9974:       }
 9975:    }
 9976: }
