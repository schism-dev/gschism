  515: 
  516: struct Frame {
  517:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  518:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  519:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  520:     double t00, t10;        // col0 (t20=0 implicit)
  521:     double t01, t11, t21;   // col1
  522: 
  523:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  524: 
  525:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  526:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  527: 
  528:       double sin_lon, cos_lon, sin_lat, cos_lat;
  529:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  530:       sincos(lat, &sin_lat, &cos_lat);
  531: 
  532:       t00 = -sin_lon;
  533:       t10 =  cos_lon;
  534:       t01 = -cos_lon*sin_lat;
  535:       t11 = -sin_lon*sin_lat;
  536:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  537: 
  538:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  539:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  540: 
  541:       const double col1_norm_inv = 1.0/col1_norm;
  542:       t01 = t01*col1_norm_inv;
  543:       t11 = t11*col1_norm_inv;
  544:       t21 = t21*col1_norm_inv;
  545: 
  546:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  547: 
  548: 
  549:    }
  550: 
  551:    __forceinline__ __device__ void print(void) const {
  552:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  553:    }
  554: 
  555:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  556:       // cross(col0, col1), with t20=0 implicitly:
  557:       // |  i       j       k   |
  558:       // | t00     t10      0   |
  559:       // | t01     t11     t21  |
  560:       t02 =  t10*t21;
  561:       t12 = -t00*t21;
  562:       t22 =  t00*t11 - t10*t01;
  563:    }
  564: 
  565: 
  566:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  567:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  568:    // Inputs:
  569:    //        vec0: vel. in this frame;
  570:    //        frameout: Output frame;
  571:    // Output: 
  572:    //        vel. in new frame  
  573:    //
  574:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  575:    // discarding the z-component of the result to keep only the local horizontal
  576:    // plane of frame 2.
  577:    //
  578:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  579:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  580:    // are orthogonal. This product is computed as dot products between columns of
  581:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  582:    // columns of F2.// 
  583: 
  584:       auto const fo = frameout; // Just an alias for the output frame.
  585:       Vector2 res;
  586: 
  587:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  588:       // of t and fo.t are the same.
  589:       const double d00 = t00*fo.t00 + t10*fo.t10;
  590:       const double d10 = t01*fo.t00 + t11*fo.t10;
  591: 
  592:       const double d01 = t00*fo.t01 + t10*fo.t11;
  593:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  594: 
  595:       res.x = vec0.x * d00 + vec0.y * d10;
  596:       res.y = vec0.x * d01 + vec0.y * d11;
  597: 
  598:       return res;
  599:    }
  600: 
  601:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  602:       Vector3 vo;
  603:       double t02, t12, t22;
  604: 
  605:       // Compute the 3rd column of the frame tensor
  606:       getCol2(t02, t12, t22);
  607: 
  608:       vo.x = vi.x*t00 + vi.y*t10;
  609:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  610:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  611: 
  612:       return vo;
  613:    
  614:    }
  615: 
  616:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  617:       Vector3 vo;
  618:       double t02, t12, t22;
  619: 
  620:    // Compute the 3rd column of the frame tensor
  621:       getCol2(t02, t12, t22);
  622: 
  623:       // F * vi (non-transposed, so we use rows of F)
  624:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  625:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  626:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  627: 
  628:       return vo;
  629:    }
  630: 
  631:    // Unit vectors that define the local frame
  632:    __forceinline__ __device__ Vector3 nUp(void) const {
  633:       // Column 2 = cross(column0, column1)
  634:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  635:    }
  636: 
  637:    __forceinline__ __device__ Vector3 nZonal(void) const {
  638:       // Column 0
  639:       return { t00, t10, 0.0 };
  640:    }
  641: 
  642:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  643:       // Column 1
  644:       return { t01, t11, t21 };
  645:    }
  646: 
  647: };
