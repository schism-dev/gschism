 2217: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2218: {
 2219:     uintptr_t p = (uintptr_t)address;
 2220:     assert((p & 1) == 0);
 2221: 
 2222:     unsigned int* base = (unsigned int*)(p & ~3);
 2223:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2224:                                   :  (unsigned int)val;
 2225: 
 2226:     atomicAdd(base, addend);
 2227: }
