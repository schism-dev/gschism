  438: 
  439: struct Element {
  440: 
  441:    // Geometry information
  442:    int idx;               // Index of the element
  443:    int i34;               // Number of sides for the element 
  444:    Side *sides[4];        // Sides of the element
  445:    Node *nodes[4];        // Nodes of the element
  446:    Element *nghbElems[4]; // Neighbors of the element
  447: 
  448:    int kb;                    // Bottom index of the element
  449:    double area;               // Area of the element
  450:    double ssign[4];           // Sign associated with each side of an element
  451:    double radius;             // Element equivalent radii
  452: 
  453:    Frame frame;
  454: 
  455:    Vector2 gradPhi[4];       // Derivatives of shape functions
  456:    Vector2 gradEta;          // Gradient of free surface elevation
  457:    Vector2 gradPr;           // Gradient of pressure    
  458:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  459: 
  460:    bool isDry;                  // True if the element is dry
  461:    int kbe;                   // Bottom index of the element
  462: 
  463:    Vector3 center;            // Element center coordinates
  464:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  465:    double depth;              // Depth at element (min of all nodes)
  466:    double z[nvrt];            // z-coord  (local frame - vertical up)
  467: 
  468:    // Physical information
  469:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  470: 
  471:    static const bool isblock = false;              // Always false
  472: 
  473:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  474:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  475: 
  476:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  477: 
  478:    
  479: 
  480:    double vsource;            // Volumetric source/sink term [m^3/s]
  481: 
  482:    double rho[nvrt];          // Density at each prism center
  483:    double rho_mean[nvrt];     // Mean density at each prism center
  484:    CubicSpline rho_spl;
  485:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  486:    double rho_z[nvrt];        // First derivative of density at each prism center
  487:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  488: 
  489:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  490: 
  491:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  492:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  493: 
  494:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  495:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  496: 
  497:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  498:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  499:       // Find the local index of the node in the element (0,1,2,3)
  500:       int res = __ffs((nodes[0] == node) | 
  501:                      ((nodes[1] == node) << 1) | 
  502:                      ((nodes[2] == node) << 2) | 
  503:                      ((nodes[3] == node) << 3)) - 1;
  504:       
  505:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  506:       return res;
  507:    }
  508: 
  509:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  510:       // Find the local index of the side in the element (0,1,2,3)
  511:       int res = __ffs((sides[0] == side) | 
  512:                      ((sides[1] == side) << 1) | 
  513:                      ((sides[2] == side) << 2) | 
  514:                      ((sides[3] == side) << 3)) - 1;
  515:       
  516:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  517:       return res;
  518:    }
  519: 
  520: 
  521:    __inline__ __device__ int findLevel(double z1, int k) const {
  522:       // Starting at index k, find sequentially the level that contains z
  523: 
  524:       // if z is already betweeen z[k] and z[k+1], return k
  525:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  526:       else if (z1 < z[k]) { 
  527:          // Search for increasing levels
  528:          for (int kk = k; kk < nvrt - 1; kk++) {
  529:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  530:          }
  531:          return nvrt - 1;
  532:       }
  533:       else {
  534:          // Search for decreasing levels
  535:          for (int kk = k; kk > 0; kk--) {
  536:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  537:          }
  538:          return 0;
  539:       }
  540:    }
  541: 
  542:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  543:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  544: 
  545:    // Check if the element is dry using the more up-to-date elevation.
  546:    __inline__ __device__ bool isDry2(void) const;
  547: 
  548:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  549: 
  550:    __inline__ __device__ double computeSignedArea(void) const;
  551: 
  552:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  553:       // Nudges the point (x,y) to the barycenter of the element
  554:       p = (1-eps)*p + eps*toVector2(center);
  555:    }
  556: 
  557:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  558: 
  559:    __device__ Vector2 grad2(double *a) const
  560:    {
  561:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  562:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  563:       if (isQuad()) {
  564:          gx += a[3]*gradPhi[3].x;
  565:          gy += a[3]*gradPhi[3].y;
  566:       }
  567:       return {gx, gy};
  568:    }
  569: 
  570:    __device__ Vector2 grad2(double Node::* field) const
  571:    {
  572:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  573:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  574:       if (isQuad()) {
  575:          gx += (nodes[3]->*field)*gradPhi[3].x;
  576:          gy += (nodes[3]->*field)*gradPhi[3].y;
  577:       }
  578:       return {gx, gy};
  579:    }
  580: 
  581:    __device__ void setFrame(void) {
  582: 
  583:       double ar1, ar2;
  584:       computeLonLat(center, ar1, ar2);
  585: 
  586:       frame.update(ar1, ar2);        
  587:     }
  588: 
  589:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  590:                                         double& tIntersect);
  591:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  592:                                         double& tIntersect);
  593: 
  594:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  595:       // Check if the point (xt,yt) is inside the element
  596:       double shpCoords[4];
  597:       bool res = computeShapeCoords(xt, shpCoords, false);
  598:       return res;
  599:    }
  600: 
  601:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  602:    {
  603:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  604:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  605:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  606:       
  607:    }
  608: 
  609:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  610: 
  611:    // ------------------------------------------------------------------------------------------------
  612:    // These are functions that work on all nodes of the element.
  613:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  614:    //
  615:    // An example of how to use these functions is:
  616:    //   
  617:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  618:    // 
  619:    // Where L is the level at which the field is to be interpolated. The field can be either
  620:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  621:    // There are different versions of getNodalValues for each of these cases.
  622: 
  623:    template<typename T>
  624:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  625:       // Get the values of the field at the nodes of the element
  626:       res[0] = nodes[0]->*field;
  627:       res[1] = nodes[1]->*field;
  628:       res[2] = nodes[2]->*field;
  629:       if (isQuad()) res[3] = nodes[3]->*field;
  630:       else          res[3] = T();
  631:    }
  632: 
  633:    template<typename T>
  634:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  635:       // Get the values of the field at the nodes of the element
  636:       res[0] = (nodes[0]->*field)[level];
  637:       res[1] = (nodes[1]->*field)[level];
  638:       res[2] = (nodes[2]->*field)[level];
  639:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  640:       else          res[3] = T();
  641:    }    
  642: 
  643:    template<typename T>
  644:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  645:       // Get the values of the func at the nodes of the element
  646:       res[0] = (nodes[0]->*func)(level);
  647:       res[1] = (nodes[1]->*func)(level);
  648:       res[2] = (nodes[2]->*func)(level);
  649:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  650:       else          res[3] = T();  // This is 0.0 or a zero vector
  651: 
  652:    }      
  653: 
  654:    template<typename T>
  655:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  656:       // Get the values of the field at the nodes of the element
  657:       res[0] = sides[0]->*field;
  658:       res[1] = sides[1]->*field;
  659:       res[2] = sides[2]->*field;
  660:       if (isQuad()) res[3] = sides[3]->*field;
  661:       else          res[3] = T();
  662:    }
  663: 
  664:    template<typename T>
  665:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  666:       // Get the values of the field at the nodes of the element
  667:       res[0] = (sides[0]->*field)[level];
  668:       res[1] = (sides[1]->*field)[level];
  669:       res[2] = (sides[2]->*field)[level];
  670:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  671:       else          res[3] = T();
  672:    }    
  673: 
  674:    template<typename T>
  675:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  676:       // Get the values of the func at the nodes of the element
  677:       res[0] = (sides[0]->*func)(level);
  678:       res[1] = (sides[1]->*func)(level);
  679:       res[2] = (sides[2]->*func)(level);
  680:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  681:       else          res[3] = T();  // This is 0.0 or a zero vector
  682: 
  683:    }      
  684: 
  685: 
  686:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  687:       double values[4];
  688:       getNodalValues(level, func, values);
  689: 
  690:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  691:    }
  692: 
  693:    template<typename T>
  694:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  695:       T values[4];
  696:       getNodalValues(field, values);
  697:       
  698:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  699:    }
  700: 
  701: 
  702:    template<typename T>
  703:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  704:       T values[4];
  705:       getNodalValues(level, field, values);
  706: 
  707:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  708:    }
  709: 
  710:    template<typename T>
  711:    __device__ T mean(T Node::* field) const {
  712:       T values[4];
  713:       getNodalValues(field, values);
  714: 
  715:       return (values[0] + values[1] + values[2] + values[3])/i34;
  716:    }
  717: 
  718:    template<typename T>
  719:    __device__ T mean(T Side::* field) const {
  720:       T values[4];
  721:       getSideValues(field, values);
  722:       
  723:       return (values[0] + values[1] + values[2] + values[3])/i34;
  724:    }   
  725: 
  726:    // __device__ double mean(double (Node::*func)(int) const) const {
  727:    //    double values[4];
  728:    //    getNodalValues(level, func, values);
  729:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  730:    // }
  731:    // ------------------------------------------------------------------------------------------------
  732: 
  733:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  734:       // Convert global coordinates to local coordinates
  735:       printf("NOT IMPLEMENTED: globalToLocal\n");
  736:       return true;
  737:    }
  738: 
  739:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  740:       // Convert local coordinates to global coordinates
  741:       printf("NOT IMPLEMENTED: localToGlobal\n");
  742:       return true;
  743:    }
  744: 
  745:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  746:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  747:     
  748:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  749:                                                  Element *&nextElem, int &jlev, double &dt);
  750: 
  751: };
