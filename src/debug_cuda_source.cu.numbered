 3965: 
 3966: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3967:    // Computes the z coordinate at level k.
 3968:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3969:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3970:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3971:    // used 
 3972: 
 3973:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3974:    
 3975:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3976: 
 3977:    if (isDry2()) return 0.0;  
 3978: 
 3979:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3980: 
 3981:    if constexpr(ivcor == 2) {
 3982: 
 3983:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3984:       const double h_c = mesh->h_c;
 3985:       const double theta_f = mesh->theta_f;
 3986:       const double sinh_theta_f = mesh->sinh_theta_f;
 3987: 
 3988: 
 3989:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3990:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3991:       // once per time step/node. XXXX
 3992:       // CHECK: updateZCoordData
 3993: 
 3994:       //  To simplify comparisons, I define index versions of count variables.
 3995:       if      (k == ivrt)     return eta2; 
 3996:       else if (k == izlev)    return -hmod2;
 3997:       else if (k == kb)       return -depth;
 3998:       else if (k < izlev)     return mesh->ztot[k];
 3999:       else if (k > izlev) {
 4000:          const int ksig = k - izlev;
 4001: 
 4002:          if (hmod2 <= h_c) {
 4003:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 4004: 
 4005:          } 
 4006:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 4007:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 4008:             assert(false && "compZCoord: invalid h_c\n");
 4009:          } 
 4010:          else {
 4011:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 4012:                    h_c * mesh->sigma[ksig] + 
 4013:                    (hmod2 - h_c) * mesh->cs[ksig];
 4014:          }
 4015:       } else { 
 4016:          assert(false && "compZCoord: invalid level or coordinate system\n");
 4017:       }
 4018: 
 4019:    }
 4020:    else {  // if constexpr(ivcor == 1)
 4021:       if (k <= kb)        return -depth; 
 4022:       else if (k == ivrt) return eta2;
 4023:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 4024: 
 4025:    }
 4026:    
 4027:    assert(false && "compZCoord: invalid level or coordinate system\n");
 4028:    return 0.0;
 4029: }
 4030: 
 4031: 
 4032: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 4033:    // Computes the bottom drag Cd based on the selected nchi
 4034: 
 4035:    if constexpr(nchi == 0) {
 4036:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 4037:       Cd = drag;  // Read from drag file
 4038: 
 4039:    } else if constexpr(nchi == 1) {
 4040:       // 
 4041: 
 4042:       bool ltmp = false; // for WBL iteration
 4043: 
 4044:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4045:       if (isDry || (rough == 0.0)) {
 4046:          Cd = 0.0;
 4047: 
 4048:       } else { //roughness >0 
 4049:          
 4050:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4051: 
 4052:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4053: 
 4054:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4055: 
 4056:       } // if rough
 4057: 
 4058:    } else if constexpr(nchi == -1) {
 4059:    // Manning 
 4060:  
 4061:       const double htot = max(hmin_man, htot2()); 
 4062:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4063: 
 4064:    } else {
 4065:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4066:       
 4067:    } // if nchi
 4068: 
 4069: }
 4070: 
 4071: 
 4072: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4073:    // Checks if a side in on the boundary
 4074:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4075: 
 4076:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4077:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4078: 
 4079:    // Indices of the nodes that form the side
 4080:    //
 4081:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4082:    const int n1 = side.n1->idx;
 4083:    const int n2 = side.n2->idx;
 4084:    isLand = false;
 4085:    
 4086: 
 4087:    // Check if the side is on a land boundary
 4088:    for (int i = 0; i < nland; i++) {
 4089:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4090:          // Consecutive nodes in the land boundary segment
 4091:          const int b1 = ilnd[i + j*nland];
 4092:          const int b2 = ilnd[i + (j + 1)*nland];
 4093: 
 4094:          assert(b1 != -1 && b2 != -1);
 4095: 
 4096:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4097:             
 4098:             isLand = true;
 4099:             return i;
 4100:          }
 4101:       }
 4102:    }
 4103: 
 4104:    // Check if the side is on an open boundary
 4105:    for (int i = 0; i < nope; i++) {
 4106:       for (int j = 0; j < nond[i] - 1; j++) {
 4107:          // Consecutive nodes in the open boundary segment
 4108:          const int b1 = iond[i + j*nope];
 4109:          const int b2 = iond[i + (j + 1)*nope];
 4110: 
 4111:          assert(b1 != -1 && b2 != -1);
 4112: 
 4113:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4114:             isLand = false;
 4115:             return i;
 4116:          }
 4117:       }
 4118:    }
 4119: 
 4120:    // Check that the nodes are not both on the boundary
 4121:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 4122:         && "side not in ilnd/iond but both nodes are boundary" );
 4123: 
 4124:    return -1;
 4125: }
 4126: 
 4127: 
 4128: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4129:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4130:                                     double *wind_rotate_angle, 
 4131:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4132:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4133:                                     int16_t *nodePermutationSort, double *crs_data,
 4134:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4135:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4136:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4137:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4138:                                     double *drag, double *roughness, double *rmanning, 
 4139:                                     double *diffmin, double *diffmax,
 4140:                                     int *kb, double *localSigma) {
 4141: 
 4142:    NODE(pnode);  
 4143:    const int i = idx_node;
 4144:    const int iglobal = globalNodeIndices[i];
 4145:    Node &node(*pnode);
 4146: 
 4147:    node.idx = iglobal;
 4148:    node.part = localNodePart[iglobal];
 4149: 
 4150:    // It is important to differentiate between the global and local "start" indices because they
 4151:    // play different, but related, roles in this code. The global "start" indices are used
 4152:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4153:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4154:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4155:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4156:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4157:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4158:    node.numNodes = idxNodeEnd - idxNodeStart;
 4159:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4160: 
 4161:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4162:    node.coeffRow = crs_data + rowStart; 
 4163: 
 4164:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4165: 
 4166: 
 4167: 
 4168:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4169:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4170:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4171:    node.numElements = idxElemEnd - idxElemStart;
 4172:    node.elements = nodeNeighElems + idxElemLocalStart;
 4173: 
 4174: 
 4175:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4176:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4177:       const int partNode = localNodePart[idxNodeGlobal]; 
 4178:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4179: 
 4180:       Node *node_ptr = nodes[partNode] + idxNode;
 4181:       
 4182:       nodeNeighNodes[idxLocal] = node_ptr;
 4183:    }
 4184: 
 4185: 
 4186:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4187:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4188:       const int partElem = localElemPart[idxElemGlobal];
 4189:       const int idxElem  = localElemIndices[idxElemGlobal];
 4190: 
 4191:       Element *elem_ptr = elems[partElem] + idxElem;
 4192: 
 4193:       nodeNeighElems[idxLocal] = elem_ptr;
 4194:    }      
 4195: 
 4196:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4197:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4198: 
 4199:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4200: 
 4201:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4202:    if constexpr(ics == 1) {
 4203:       node.p.x   = node_coords[i * 3];
 4204:       node.p.y   = node_coords[i * 3 + 1];
 4205:       node.gz = 0.0;
 4206: 
 4207:       if (use_ll) {                                    // <-- add
 4208:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4209:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4210:       }  
 4211: 
 4212:    } else {
 4213:       const double lon = deg2rad*node_coords[i * 3];
 4214:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4215: 
 4216:       Point3 p = computeXYZfromLatLon(lat, lon);
 4217:       node.p = toVector2(p);
 4218:       node.gz = p.z;
 4219:       node.lon = lon;
 4220:       node.lat = lat;
 4221: 
 4222:       #ifdef USE_FRAMES
 4223:       node.setFrame(lat, lon);
 4224:       #endif
 4225: 
 4226: 
 4227:    }
 4228: 
 4229:    node.depth = node_coords[i * 3 + 2];
 4230: 
 4231:    node.numSides = 0;
 4232: 
 4233:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4234:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4235:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4236:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4237:    else assert(false && "populateNodes: selected nchi not implemented.");
 4238: 
 4239:    // Populate the diffmin and diffmax values read from the files.
 4240:    // (Only used for GLS, GOTM, and SedimentMix.)
 4241:    node.turb.setDiffLimits(diffmin[iglobal], diffmax[iglobal]);
 4242: 
 4243:    if constexpr(ivcor == 1) 
 4244:    {  
 4245:       node.kb = kb[iglobal];
 4246: 
 4247:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4248:    }
 4249: 
 4250:    for (int k = 0; k < nvrt; k++) {
 4251:       node.rho[k] = rho0;
 4252:       node.z[k] = -1e20;
 4253:    }
 4254: 
 4255:    // Initialize the turbulence model including the vertical viscosity/diffusivity
 4256:    node.turb.init(&node);
 4257: 
 4258:    
 4259:    // Links the node to the boundary information
 4260:    if (isbnd[iglobal] >= 0) {
 4261:      
 4262:       // Get the index of the node boundary
 4263:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4264: 
 4265:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4266:       node.nodeBnd->node = &node;
 4267: 
 4268:       node.nodeBnd->sideBnd1 = nullptr;
 4269:       node.nodeBnd->sideBnd2 = nullptr;
 4270: 
 4271:       if (isbnd[iglobal]>=0) {
 4272: 
 4273:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4274:          
 4275:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4276:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4277: 
 4278:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4279:          node.nodeBnd->segment->clen  = nan("1");
 4280:          node.nodeBnd->segment->carea = nan("1");
 4281: 
 4282:       }
 4283:    } else {
 4284: 
 4285:       node.nodeBnd = nullptr; // For internal nodes
 4286: 
 4287:       if (isbnd[iglobal] == landSegment) {
 4288:          node.nodeBnd = landBoundaryNode;
 4289:          node.nodeBnd->segment = landBoundarySegment;
 4290:       }
 4291:       
 4292:    }
 4293:    
 4294:    // XXXX GAUSSIAN HILL VELOCITIES
 4295:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4296:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4297:          constexpr double rot_per = 3000.0;
 4298:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4299:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4300:       // XXXXX
 4301:    #endif
 4302: 
 4303: }
 4304: 
 4305: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4306:    
 4307:    NODE(node);
 4308:    const int localIdx = idx_node;
 4309: 
 4310: 
 4311:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4312:    int16_t *csrSlot = node->csrSlot;  
 4313: 
 4314:    // Simply count the number of nodes with a smaller global index than the current node.
 4315:    // It accounts for the diagonal element.
 4316:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4317:    // local index, but taking into account all the partitions (in order).
 4318:    for (int i = 0; i < node->numNodes; ++i) {
 4319:       const int col = node->nodes[i]->packedIndex();
 4320:       int16_t idx = 0;
 4321: 
 4322:       //Takes care of the diagonal element.
 4323:       if (node->packedIndex() < col) ++idx;          
 4324: 
 4325:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4326:       csrSlot[i] = idx;
 4327:    }
 4328: 
 4329:    // Find the diagonal element in the CRS matrix.
 4330:    int16_t idxDiag = 0;
 4331:    for (int j = 0; j < node->numNodes; ++j)
 4332:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4333: 
 4334:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4335: 
 4336:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4337:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4338: 
 4339:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4340:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4341:    crs_indptr[localIdx] = rowStart;
 4342: 
 4343:    // Fills crs_indices array using the per-partition indexing.
 4344:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4345:    crs_indices[rowStart + d] = node->packedIndex();  
 4346:    for (int j = 0; j < node->numNodes; ++j) {
 4347:       Node *nb = node->nodes[j];
 4348:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4349:    }
 4350: 
 4351: 
 4352: }
 4353: 
 4354: 
 4355: 
 4356: 
 4357: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4358:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4359:                                     double *wind_rotate_angle,   
 4360:                                     int *isdel, int *isidenode, int *isbnd,
 4361:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4362:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4363:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4364:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4365:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4366:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4367:                                     double *drag, double *roughness) {
 4368: 
 4369: 
 4370:    SIDE(pside);
 4371:    Side &side(*pside);
 4372:    const int i = idx_side;
 4373:    const int iglobal = globalSideIndices[i];
 4374:    side.idx = iglobal;  
 4375:    
 4376:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4377:    const double fc   = 2.0*omega_e*sin(sfea0);
 4378:    const double beta = 2.0*omega_e*cos(sfea0);
 4379: 
 4380:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4381: 
 4382:    // finding the pointer to the nodes that form the side
 4383:    const int idx_n1 = isidenode[iglobal*2];
 4384:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4385: 
 4386: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4387: 
 4388:    const int locidx_n1 = localNodeIndices[idx_n1];
 4389:    const int locidx_n2 = localNodeIndices[idx_n2];
 4390:    const int part_n1 =   localNodePart[idx_n1];
 4391:    const int part_n2 =   localNodePart[idx_n2];
 4392: 
 4393: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4394: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4395: 
 4396:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4397:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4398: 
 4399: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4400: 
 4401:    // Counts the number of sides connected to each node
 4402:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4403:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4404: 
 4405:    // Side boundary type
 4406:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4407:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4408: // if (i == 0) printf("populateSides: 2\n");
 4409: 
 4410:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4411:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4412:    {
 4413:       bool isLand = false;
 4414:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4415:       
 4416:       if (isbs > -1) {
 4417:          // assert(isLand || isbs>=0);
 4418:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4419: 
 4420:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4421: 
 4422:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4423:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4424: 
 4425:          assert (isLand == side.sideBnd->segment->isLand);
 4426:          
 4427:          side.sideBnd->side = &side;
 4428: 
 4429:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4430:          n1bnd->linkSideBoundary(side.sideBnd);
 4431:          n2bnd->linkSideBoundary(side.sideBnd);
 4432: 
 4433:       }
 4434:       else {
 4435:          side.sideBnd = nullptr;
 4436:       }
 4437:    }
 4438:    else 
 4439:    {
 4440:       side.sideBnd = nullptr;
 4441:    }
 4442: 
 4443: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4444: 
 4445:    // finding the pointer to the elements that share the side
 4446:    const int idx_e1 = isdel[iglobal*2];
 4447:    const int idx_e2 = isdel[iglobal*2 + 1];
 4448: 
 4449:    if (idx_e1 > -1) {
 4450:       const int locidx_e1 = localElemIndices[idx_e1];
 4451:       const int part_e1 =  localElemPart[idx_e1];
 4452:       side.elems[0] = elems[part_e1] + locidx_e1;
 4453: 
 4454:    }
 4455:    else {
 4456:       side.elems[0] = nullptr;
 4457:    }
 4458: 
 4459: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4460: 
 4461:    if (idx_e2 > -1) {
 4462:       const int locidx_e2 = localElemIndices[idx_e2];
 4463:       const int part_e2 =  localElemPart[idx_e2];
 4464:       side.elems[1] = elems[part_e2] + locidx_e2;
 4465:    }
 4466:    else {
 4467:       side.elems[1] = nullptr;
 4468:    }
 4469: 
 4470: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4471: 
 4472:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4473:       
 4474:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4475:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4476:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4477:          
 4478:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4479:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4480:       // printf("sideBnd: %p\n", side.sideBnd);
 4481:       // assert(false && "Side has no elements and no boundary");
 4482:    }
 4483:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4484: 
 4485:    // Compute the center of the side
 4486:    side.center = 0.5*(side.n1->p + side.n2->p);
 4487: 
 4488:    #ifdef USE_FRAMES
 4489:    side.setFrame();
 4490:    #endif
 4491: 
 4492: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4493: 
 4494:    // Normal, unitary vector to the side
 4495:    if constexpr(ics == 1) {
 4496:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4497:       side.n = normalize(side.n);
 4498:    }
 4499:    else {
 4500:       // Unit side vector in 3D cartesian coordinates
 4501:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4502: 
 4503:       nSide = normalize(nSide);
 4504: 
 4505:       // Its cross product with the unit local z-axis vector (nUp) is the
 4506:       // normal vector we are looking for.
 4507:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4508: 
 4509:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4510:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4511:       side.n = -normalize(n2D); 
 4512: 
 4513:    }
 4514: 
 4515: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4516: 
 4517:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4518:    side.shapiro = shapiro0;
 4519: 
 4520:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4521:    // XXXX
 4522:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4523:    constexpr double rot_per=3000.0;
 4524:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4525:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4526:    // XXXXX      
 4527:    #endif
 4528:    // Compute the z level at the center of the side
 4529:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4530:    
 4531:    // Compute the length of the side
 4532:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4533: 
 4534: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4535: 
 4536:    // Compute the Coriolis coefficient
 4537: 
 4538:    if constexpr(ncor == -1 || ncor == 0) {
 4539:       side.coriolis = coricoef;
 4540:    }
 4541:    else {
 4542:       const double sphi = side.lat();  // Latitude at the center of the side
 4543: 
 4544:       assert(use_ll && "use_ll must be true when ncor > 0");
 4545: 
 4546:       if constexpr(ics == 1) {
 4547:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4548:       }
 4549:       else { // ics == 2
 4550:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4551:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4552:       }
 4553: 
 4554:    }
 4555: 
 4556: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4557: 
 4558: }
 4559: 
 4560: 
 4561: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4562:    double *node_coords, double *node_coords_ll, bool use_ll,
 4563:    double *wind_rotate_angle,   
 4564:    int *isdel, int *isidenode, int *isbnd,
 4565:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4566:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4567:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4568:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4569:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4570:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4571:    double *drag, double *roughness) {
 4572: 
 4573:    ELEM(pelem);
 4574:    Element &elem(*pelem);
 4575:    const int i = idx_elem;
 4576: 
 4577:    elem.idx = i;
 4578: 
 4579:    for (int j = 0; j < i34[i]; j++) {
 4580:       const int idxNode = elnode[i*4 + j];  
 4581:       const int idxSide = elside[i*4 + j];
 4582:       
 4583:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4584:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4585: 
 4586:       // Find the neighboring element  
 4587:       if (elem.sides[j]->elems[0] == &elem) {
 4588:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4589:       }
 4590:       else {
 4591:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4592:       }
 4593:       
 4594:    }
 4595: 
 4596:    elem.i34 = i34[i];
 4597: 
 4598:    // Compute the barycenter of the element and its depth
 4599:    elem.center = {0.0, 0.0};
 4600:    elem.depth = 1e10;
 4601:    for (int j = 0; j < i34[i]; j++) {
 4602: 
 4603:       elem.center += elem.nodes[j]->p/i34[i];
 4604:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4605:    }
 4606: 
 4607:    #ifdef USE_FRAMES
 4608:    elem.setFrame();
 4609:    #endif
 4610: 
 4611:    elem.area = elem.computeSignedArea(); 
 4612:    elem.radius = sqrt(elem.area)/pi; 
 4613:    
 4614:    // Determines which way the normal vector to each side is oriented.
 4615:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4616:    for (int j = 0; j < i34[i]; j++)  
 4617:    {
 4618:       if (elem.sides[j]->elems[0] == &elem) {
 4619:          elem.ssign[j] =  1.0;
 4620:       }
 4621:       else {
 4622:          elem.ssign[j] = -1.0;
 4623:       }
 4624: 
 4625:    }
 4626: 
 4627:   
 4628: 
 4629:    // Derivatives of shape functions
 4630:    //  For ics=2, this is done in the element frame
 4631:    //  For quads, the derivative is evaluated at centroid
 4632:    for (int j = 0; j < elem.i34; j++) {
 4633:       const double area = elem.area;
 4634:       const int id2 = elem.nxq(1 + j);
 4635:       const int id3 = elem.nxq(2 + j);
 4636:       const int id4 = elem.nxq(3 + j);
 4637:       if (elem.isTri()) {
 4638:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4639:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4640:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4641:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4642:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4643:          // And so on for the other shape functions.
 4644: 
 4645:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4646:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4647:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4648: 
 4649:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4650:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4651: 
 4652:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4653: 
 4654:       }
 4655:       else  { // Quad, the derivatives are evaluated at the centroid
 4656: 
 4657:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4658:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4659:          // ...
 4660:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4661: 
 4662:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4663:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4664:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4665: 
 4666:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4667:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4668: 
 4669:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4670: 
 4671:       } // if Tri/Quad
 4672: 
 4673:    } // for j   
 4674:    
 4675:    
 4676: 
 4677: }
 4678: 
 4679: 
 4680: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4681:                                             double *emo, double *efa, 
 4682:                                             double *umo, double *ufa, 
 4683:                                             double *vmo, double *vfa,
 4684:                                             int *ifltype, int *iettype, double *qthcon) {
 4685: 
 4686:    NODE_BND(nodeBnd);
 4687:    const int idx = idx_node_bnd;    
 4688: 
 4689:    nodeBnd->idx = idx;
 4690: 
 4691:    // Need to find the segment index and the index of the node on the segment
 4692:    int idxNode = -1;
 4693:    int iseg, i;
 4694:    for (iseg = 0; iseg < nope; iseg++) {
 4695:       // for each segment...
 4696:       for (i = 0; i < nond[iseg]; i++) {
 4697:          idxNode = iond[iseg + i*nope];
 4698:          if (idxNode == nodeBnd->node->idx) 
 4699:          {
 4700:             // This is done for every segment that the node is part of, overwriting the previous values.
 4701:             // The result is that the segment with the highest index is the one that is used.
 4702:             nodeBnd->isEssentialBC = (iettype[iseg] != 0);
 4703:             nodeBnd->elbc = 0.0;
 4704: 
 4705:             // XXXXXX This may make more sense in populateBoundarySides.
 4706:             nodeBnd->segment->ifltype = ifltype[iseg];
 4707:             nodeBnd->segment->iettype = iettype[iseg];
 4708:             nodeBnd->segment->qthcon  = qthcon[iseg];
 4709:             nodeBnd->segment->idx = iseg;
 4710: 
 4711:             for (int jfr = 0; jfr < nbfr; jfr++) {
 4712: 
 4713:                const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4714: 
 4715:                nodeBnd->efa[jfr] = efa[idx2];
 4716:                nodeBnd->emo[jfr] = emo[idx2];
 4717: 
 4718:             }
 4719:          }         
 4720:       }
 4721:    }
 4722: 
 4723:    assert(iseg < nope && "iseg is out of bounds");
 4724: 
 4725: 
 4726: 
 4727: 
 4728:         
 4729: 
 4730: }
 4731: 
 4732: __device__ void Mesh::populateBoundarySides(int *nond, int *iond,
 4733:                                             double *emo, double *efa, 
 4734:                                             double *umo, double *ufa, 
 4735:                                             double *vmo, double *vfa,
 4736:                                             int *ifltype, int *iettype, double *qthcon) {
 4737: 
 4738:    SIDE_BND(sideBnd);
 4739: 
 4740:    const Side *side = sideBnd->side;
 4741: 
 4742: 
 4743:    // Indices of the nodes on the side 
 4744:    const int n1 = side->n1->idx;
 4745:    const int n2 = side->n2->idx;
 4746: 
 4747:    const int iseg = sideBnd->segment->idx;
 4748: 
 4749:    // Find the index of the side in the segment data array.
 4750:    for (int i = 0; i < nond[iseg] - 1; i++) {
 4751: 
 4752:       // Indices of the nodes at both ends of the side (obtained from the boundary node list)
 4753:       const int b1 = iond[iseg + i*nope];
 4754:       const int b2 = iond[iseg + (i + 1)*nope];
 4755: 
 4756:       // Find the side that connects the two nodes by comparing the indices of the nodes at both ends of the side (computed from 
 4757:       // the boundary node list) with the indices of the nodes at the ends of the side (obtained from the side structure).
 4758:       if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4759: 
 4760:          for (int jfr = 0; jfr < nbfr; jfr++) {
 4761:          // For each tidal component...
 4762: 
 4763:             const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4764: 
 4765:             // velocity magnitude at both ends of the side (1,2)            
 4766:             const double umo1 = umo[idx2];
 4767:             const double vmo1 = vmo[idx2];
 4768:             const double umo2 = umo[idx2 + nope];
 4769:             const double vmo2 = vmo[idx2 + nope];
 4770: 
 4771:             // velocity phases at both ends of the side (1,2)
 4772:             const double ufa1 = ufa[idx2];
 4773:             const double vfa1 = vfa[idx2];
 4774:             const double ufa2 = ufa[idx2 + nope];
 4775:             const double vfa2 = vfa[idx2 + nope];
 4776: 
 4777:             // These expressions compute the amplitude and phase of the velocity components at the center of the side.
 4778:             // The expressions replicate SCHISM by computing equivalent amplitude and phase for the velocity components at the center of the side.
 4779:             // Equivalent to SCHISM: average of the two reconstructed node tides
 4780:             //   0.5 * (a1*cos(theta - phi1) + a2*cos(theta - phi2))
 4781:             // with theta = amig*t + face. Folded here into one (umo, ufa) per
 4782:             // frequency so the step only does ramp*ff*umo*cos(theta - ufa).
 4783:             // Fortran keeps both (a, phi) on the nodes and averages after the
 4784:             // cosines; the result is the same.
 4785:             sideBnd->umo[jfr] = {0.5*sqrt(pow<2>(umo1) + pow<2>(umo2) + 2*umo1*umo2*cos(ufa1 - ufa2)), 0.5*sqrt(pow<2>(vmo1) + pow<2>(vmo2) + 2*vmo1*vmo2*cos(vfa1 - vfa2))};
 4786:             sideBnd->ufa[jfr] = {atan2(umo1*sin(ufa1) + umo2*sin(ufa2), umo1*cos(ufa1) + umo2*cos(ufa2)), atan2(vmo1*sin(vfa1) + vmo2*sin(vfa2), vmo1*cos(vfa1) + vmo2*cos(vfa2))};
 4787: 
 4788:          } // for jfr
 4789: 
 4790:       }
 4791:    }
 4792: 
 4793: 
 4794: }
 4795: 
 4796: __device__ void Mesh::populateBoundarySideLinks(void) {
 4797: 
 4798:    SIDE_BND(sideBnd);
 4799: 
 4800:    const Side *side = sideBnd->side;
 4801: 
 4802:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4803:    // and the rightSide is the side s that has s->n1 == side->n2
 4804:    for (int i = 0; i < mesh->nbs; i++) {
 4805: 
 4806:       Side *s = &mesh->localSideData[i];
 4807: 
 4808:       if (s == side) continue;  // Do not link the side to itself
 4809:    
 4810:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4811:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4812:    }
 4813: 
 4814:   
 4815: }
 4816: 
