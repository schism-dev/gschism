  378: 
  379: struct Frame {
  380:    double _t[9]; // t stands for tensor.
  381: 
  382:    // Access the tensor in Fortran order
  383:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  384: 
  385:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  386: 
  387:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  388: 
  389:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  390:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  391:       sincos(ar2, &sin_ar2, &cos_ar2);
  392: 
  393:       t(0,0) = -sin_ar1;
  394:       t(1,0) =  cos_ar1;
  395:       t(2,0) =  0.0;
  396:       t(0,1) = -cos_ar1*sin_ar2;
  397:       t(1,1) = -sin_ar1*sin_ar2;
  398: 
  399:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  400: 
  401:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  402:       assert (ar4!=0.0 && "GRID: ar4=0");
  403: 
  404:       const double ar4_inv = 1.0/ar4;
  405:       t(0,1) = t(0,1)*ar4_inv;
  406:       t(1,1) = t(1,1)*ar4_inv;
  407:       t(2,1) = t(2,1)*ar4_inv;
  408: 
  409:       // The third vector is the cross product of the first two
  410:       crossProduct(t(0,0), t(1,0), t(2,0), 
  411:                    t(0,1), t(1,1), t(2,1), 
  412:                    t(0,2), t(1,2), t(2,2));
  413:    }
  414: 
  415: 
  416:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  417:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  418:    // Inputs:
  419:    //        vec0: vel. in this frame;
  420:    //        frameout: Output frame;
  421:    // Output: 
  422:    //        vec1: vel. in new frame  
  423: 
  424:       auto const fo = frameout;
  425:       Vector2 vec1;
  426: 
  427:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  428:       // of t and fo.t are the same.
  429:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  430:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  431: 
  432:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  433:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  434: 
  435:       return vec1;
  436:    }
  437: 
  438:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  439:       // Transform a vector from global to local frame
  440:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  441:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  442:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  443:    }
  444: 
  445:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  446:       // Transform a vector from local to global frame
  447:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  448:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  449:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  450:    }   
  451: 
  452:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  453:    // Tranforms a point from global to local frame     
  454:       G2L(pi - origin0, po);
  455:    }
  456: 
  457:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  458:    // Transforms a point from local to global frame      
  459:       L2G(pi, po);
  460:       po = po + origin0;
  461:    }
  462: 
  463: };
