 7855: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7856:    // Get the value of a variable from an element
 7857:    // varName is the name of the variable to get
 7858:    // var is the array to store the value
 7859:    // k is the vertical level index of the variable to get
 7860: 
 7861:    ELEM(elem);
 7862:    
 7863:    int idx = elem->idx;
 7864:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7865: 
 7866:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7867:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7868:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7869:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7870:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7871:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7872:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7873:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7874:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7875:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7876:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7877:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7878:       
 7879:    
 7880: }
 7881: 
 7882: 
 7883: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7884:    // Get the value of a variable from an node
 7885:    // varName is the name of the variable to get
 7886:    // var is the array to store the value
 7887:    // k is the vertical level index of the variable to get
 7888: 
 7889:    NODE(node);
 7890:    
 7891:    int idx = node->idx;
 7892:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7893: 
 7894:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7895:    
 7896:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7897:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7898:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7899:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7900:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7901:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7902:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7903:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7904:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7905:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7906:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7907:    
 7908:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7909:       
 7910:    
 7911: }
 7912: 
 7913: 
 7914: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7915:    // Get the value of a variable from an side
 7916:    // varName is the name of the variable to get
 7917:    // var is the array to store the value
 7918:    // k is the vertical level index of the variable to get
 7919:    SIDE(side);
 7920:    
 7921:    int idx = side->idx;
 7922:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7923: 
 7924:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7925:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7926:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7927:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7928:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7929:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7930:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7931:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7932:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7933:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7934:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7935:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7936:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7937:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7938:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7939:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7940:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7941:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7942:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7943:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7944:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7945:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7946:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7947:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7948:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7949:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7950:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7951:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7952:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7953:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7954:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7955:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7956:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7957:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7958:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7959:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7960:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7961: }
 7962: 
 7963: 
 7964: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7965:    // Get the value of a variable from an side
 7966:    // varName is the name of the variable to get
 7967:    // var is the array to store the value
 7968:    // k is the vertical level index of the variable to get
 7969:    SIDE_BND(sideBnd);   
 7970: 
 7971:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7972:    if (sideBnd->segment->isLand) idx = -7;
 7973: 
 7974:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7975:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7976: 
 7977: }
