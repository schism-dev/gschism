 7458: __global__ void returnMatrix(double *res) {
 7459:    // Debugging: returns the matrix as a CuPy array
 7460: 
 7461:    const int size = mesh->np;
 7462:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7463:       const Node *node = mesh->localNodeData + idx_node;
 7464:       res[idx_node*size + idx_node] = node->coeffDiag;
 7465:       for (int j = 0; j < node->numNodes; j++) {
 7466:          Node* nbNode = node->nodes[j];
 7467:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7468:       }
 7469: 
 7470:    }
 7471:    
 7472: }
