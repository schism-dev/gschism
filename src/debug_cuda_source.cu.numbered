 1914: __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p, const Side* origSide) {
 1915: // If ics == 2, convert the global point to the local frame of the original side
 1916:    
 1917:    if constexpr (ics == 1) {
 1918:       return p;
 1919:    } else {
 1920:       const Point3 c = {origSide->center.x, origSide->center.y, origSide->centerZ()};
 1921:       const Point3 p2 = origSide->frame.G2L(p - c);
 1922:       return p2; // only the horizontal components
 1923:    }
 1924: }
 1925: 
 1926: __device__ __forceinline__ Point2 toLocalFrame(Point2 const& p, const Side* origSide) {
 1927: // If ics == 2, convert the global vector to the local frame of the original side
 1928:    return toPoint2(toLocalFrame(toPoint3(p, 0.0), origSide));
 1929: }
