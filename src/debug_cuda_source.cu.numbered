 1415: 
 1416:    __device__ Mesh(int partNum,
 1417:                    int npgb, int negb, int nsgb, 
 1418:                    int np, int ne, int ns,
 1419:                    int max_np, int max_ne, int max_ns, int nseg,
 1420:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1421:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1422:                    Node    **localNodeNeighNodesMem,
 1423:                    Element **localNodeNeighElemsMem,
 1424:                    double *partCoeffMatrixMem,
 1425:                    NodeBoundary *localNodeBoundaryMem,
 1426:                    SideBoundary *localSideBoundaryMem,
 1427:                    BoundarySegment *localSegmentMem,
 1428:                    double h_c, double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1429:                    double *cs, double *dcs
 1430:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1431:                        np(np), ne(ne), ns(ns),
 1432:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1433:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1434:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1435:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1436:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1437:                        localSegmentMem(localSegmentMem),
 1438:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1439:                        cs(cs), dcs(dcs),
 1440:                        coeffMatrixMem(partCoeffMatrixMem),
 1441:                        landBoundarySegment(true),
 1442:                        landBoundaryNode(true)
 1443:    {
 1444:       printf("Mesh constructor for partition %d\n", partNum);
 1445: 
 1446:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1447:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1448:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1449:  
 1450:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1451:       
 1452:       sinh_theta_f = sinh(theta_f);
 1453: 
 1454:    }
