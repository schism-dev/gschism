  609: enum class TransportModel : int {
  610:    None   = 0,
  611:    Upwind = 1, // local fallback for elements that are too shallow to use TVD or WENO or explicitly marked as such in tvd.prop
  612:    TVD    = 3,
  613:    WENO   = 4,
  614: };
