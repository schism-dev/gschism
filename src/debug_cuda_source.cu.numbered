 8147: __global__ void returnMatrix(double *res) {
 8148:    // Debugging: returns the matrix as a CuPy array
 8149: 
 8150:    const int size = mesh->np;
 8151:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8152:       const Node *node = mesh->localNodeData + idx_node;
 8153:       res[idx_node*size + idx_node] = node->coeffDiag;
 8154:       for (int j = 0; j < node->numNodes; j++) {
 8155:          Node* nbNode = node->nodes[j];
 8156:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8157:       }
 8158: 
 8159:    }
 8160:    
 8161: }
