 6813: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 6814: //                     !For outflow open bnd side, estimate mass in (open
 6815: //                     !side cannot be interface side)
 6816: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 6817: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 6818: //                     endif
 6819: 
 6820: //                     cycle
 6821: //                   endif
 6822: 
 6823: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 6824: //                   iweno=.false.  !reset to upwind
 6825: //                   ibnd=isbs(jsj) !global bnd #
 6826: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 6827: //                   nwild(1:2)=0
 6828: //                   do ll=1,2 !nodes
