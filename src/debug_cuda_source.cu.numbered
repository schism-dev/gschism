 6125:    __global__ void resetVelocityOpenBndNodes(void) {
 6126:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6127: 
 6128:       NODE_BND(nodebnd);
 6129: 
 6130:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6131:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6132:       }
 6133: 
 6134:    }
 6135: 
 6136: 
 6137:    __global__ void setVelocityOpenBndNodes(void) {
 6138:    // For open boundary nodes sets their velocity to the imposed values.
 6139: 
 6140:       SIDE_BND(sidebnd);
 6141: 
 6142:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6143:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6144:          // to its segment to the average of the side velocity.
 6145: 
 6146:          for (int k = 0; k < nvrt; k++) {
 6147:             Node *n1 = sidebnd->side->n1;
 6148:             Node *n2 = sidebnd->side->n2;
 6149: 
 6150: 
 6151:             Vector2 n1_u2(n1->u2[k]);
 6152:             Vector2 n2_u2(n2->u2[k]);
 6153: 
 6154:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6155:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6156:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6157:             }
 6158:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6159:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6160:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6161:             }
 6162: 
 6163:          }
 6164: 
 6165:       }
 6166: 
 6167:    }
 6168: 
 6169: 
 6170:    __global__ void computeVerticalVelocity(void) {
 6171:       // Computes the vertical velocity at the (2D) element's centroid.
 6172:       // In this function we will be considering volumetric elements, with side faces and a 
 6173:       // bottom and a top face. We will call them SFs, BF and TF.
 6174:       // It computes the flux coming from BF and the SFs.
 6175:       // If the bed is moving, it takes that into account.
 6176:       // Since water is incompressible, the integral of the velocity times the normal vector
 6177:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6178:       // and the BF is equal to the flux going out from the TF.
 6179:       // TF = - BF - sum(SFs).
 6180:       // It then computes the horizontal velocity at the center of TF.
 6181:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6182:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6183:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6184: 
 6185:       ELEM(elem);
 6186: 
 6187:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6188: 
 6189:       if (elem->isDry) return;
 6190: 
 6191:       const int kb = elem->kb;
 6192:       const bool isTri = elem->isTri();
 6193: 
 6194:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6195: 
 6196:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6197:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6198:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6199: 
 6200:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6201: 
 6202:       double area3D;
 6203: 
 6204:       // Bottom face flux
 6205:       double bottomFlux = 0.0;
 6206:       Vector2 u2meanBottom = {0.0, 0.0};
 6207:       const Vector2 gradh = elem->grad2(&Node::depth);
 6208:       if constexpr(imm==2) {
 6209:          Vector3 ubed;
 6210: 
 6211:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6212:          // updateBDEF(ubed);
 6213:      
 6214:          // const double bflux0 = dot(ubed, elem_n1);
 6215: 
 6216:          // elem->w[kb] += ubed.z;
 6217:       }
 6218:       else {
 6219:          Vector2 umean;
 6220:          if constexpr(ics == 1) {
 6221:             u2meanBottom = elem->mean(kb, &Side::u2);
 6222:          }
 6223:          else {
 6224:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6225:          }
 6226: 
 6227:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6228:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6229: 
 6230:          bottomFlux = - dot(gradh, u2meanBottom);
 6231:       } // if imm
 6232: 
 6233:       // Compute w for kb+1 to nvrt-1
 6234:       for (int l = kb; l < nvrt - 1; l++) {
 6235: 
 6236:          // normal vector to the top face of the "volumetric" element (3D)
 6237:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6238: 
 6239:          // Compute the total flux at the sides
 6240:          double sideFlux = 0.0;
 6241: 
 6242:          for (int j = 0; j < elem->i34; j++) {
 6243:             const Side *side = elem->sides[j];
 6244: 
 6245:             const double sideArea = side->area(l);
 6246:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6247:             const double sign = elem->ssign[j]; 
 6248: 
 6249:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6250:          }
 6251:          
 6252:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6253:          //velocities at the centers of the sides
 6254:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6255: 
 6256:          // The flx at the top ace can be computed from the other flows.
 6257:          const double topFlux = - sideFlux - bottomFlux;
 6258:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6259: 
 6260:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6261: 
 6262:          elem_n1 = elem_n2;
 6263: 
 6264:          bottomFlux = - topFlux;
 6265:       }
 6266:    }  
 6267: 
 6268: 
 6269: 
 6270: 
 6271: 
 6272: 
 6273: 
