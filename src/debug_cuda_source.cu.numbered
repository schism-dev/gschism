 7010: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7011: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7012: //                       enddo !ll
 7013: //                     else
 7014: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7015: //   !'
