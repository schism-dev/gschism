 7489: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7490:    Node *nodes = mesh->localNodeData;
 7491: 
 7492:    *addr = nodes;
 7493:    *sizeNode = sizeof(Node);
 7494: 
 7495:    switch (varCode) {
 7496:       case (int)VarCode::depth:
 7497:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7498:          *sizeType = sizeof(double);
 7499:          break;
 7500:       case (int)VarCode::eta:
 7501:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7502:          *sizeType = sizeof(double);
 7503:          break;
 7504:       case (int)VarCode::x:
 7505:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7506:          *sizeType = sizeof(Vector2);
 7507:          break;
 7508:       case (int)VarCode::z:
 7509:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7510:          *sizeType = sizeof(double);
 7511:          break;
 7512:       case (int)VarCode::kb:
 7513:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7514:          *sizeType = sizeof(int);
 7515:          break;
 7516:       case (int)VarCode::isdry:
 7517:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7518:          *sizeType = sizeof(int);
 7519:          break;         
 7520:       case (int)VarCode::w:
 7521:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7522:          *sizeType = sizeof(double);
 7523:          break;
 7524:       case (int)VarCode::u:
 7525:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7526:          *sizeType = sizeof(Vector2);
 7527:          break;         
 7528:       default:
 7529:          *offset = -1;    
 7530:    }  
 7531:    
 7532: }
