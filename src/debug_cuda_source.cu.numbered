 4740: 
 4741: 
 4742: 
 4743: 
 4744: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4745:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4746:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4747:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4748: }
 4749: 
 4750: 
 4751: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4752:    // Brunt-Väisälä frequency at level k.
 4753:    if (k <= node->kb || k >= ivrt) return 0.0;
 4754:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4755: }
 4756: 
 4757: 
 4758: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4759: 
 4760:    
 4761:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4762:    // k is the layer bottom index.
 4763: 
 4764: 
 4765: 
 4766:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4767: 
 4768:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4769:       const double eta2 = node->eta2;
 4770:       const double depth = node->depth;
 4771: 
 4772:       // Distances from the layer midpoint to the surface and bottom
 4773:       const double dist_s = eta2 - z_c;
 4774:       const double dist_b = z_c + depth;
 4775: 
 4776:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4777: 
 4778:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4779: 
 4780: 
 4781:    } else {
 4782:       return 1.0; // Other GLS submodels
 4783: 
 4784:    }
 4785: }
 4786: 
 4787: 
 4788: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4789:    // Minimum mixing length for levels below the surface.
 4790:    // Independent of psimin(); do not invert one to get the other.
 4791:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4792: }
 4793: 
 4794: 
 4795: __device__ void Turbulence<TurbulenceModel::GLS>::init(Node *node) {
 4796:    // Whole column, including levels below kb. Matches the Fortran cold start.
 4797:    for (int k = 0; k < nvrt; k++) {
 4798:       tke[k]    = tkemin();
 4799:       mxl[k]    = mxlmin(node->depth);
 4800:       nu_tke[k] = diffmin;
 4801:       nu_phi[k] = diffmin;
 4802: 
 4803:       node->dfv[k] = 0.0;
 4804:       node->dfh[k] = 0.0;
 4805:    }
 4806: }
 4807: 
 4808: 
 4809: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4810: 
 4811:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4812: 
 4813:    if constexpr(iveg == 1) {
 4814:       
 4815:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4816:       const double zTopCanopy = node->zTopCanopy();
 4817: 
 4818:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4819: 
 4820:          const double ztop = node->z[k];   // Top of the current layer.
 4821: 
 4822:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4823:          // Where 1 means that the current level is fully within the vegetation layer.
 4824:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4825: 
 4826:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4827:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4828: 
 4829:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4830:          // and at the bottom of the layer.
 4831:          const double vmag_top = length(ub2_top);
 4832:          const double vmag_bot = length(node->u2[k-1]);
 4833: 
 4834:          // Volume-averaged velocity cubed.
 4835:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4836: 
 4837:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4838:          // and at the bottom of the layer.
 4839:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4840:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4841: 
 4842:          // Volume-averaged vegetation alpha cubed.
 4843:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4844: 
 4845:          return veg_alpha3D*vmag3;
 4846:       } 
 4847:       else {
 4848:          // The current level is not within the vegetation layer, so the production is 0.
 4849:          return 0.0;
 4850:       }
 4851:    } else {
 4852: 
 4853:       // If no vegetation, the production is 0.
 4854:       return 0.0;
 4855:    }
 4856: 
 4857: }
 4858: 
 4859: 
 4860: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 4861:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 4862:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 4863: 
 4864:    const int kb = node->kb;
 4865: 
 4866:    for (int k = kb; k < nvrt; k++) {
 4867:       const double tke = this->tke[k];
 4868:       const double mxl = this->mxl[k];
 4869:       const double u = sqrt(tke);  // Characteristic velocity
 4870:       const double lu = mxl*u;     // Characteristic diffusivity 
 4871: 
 4872:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 4873:       double drho_dz = 0.0;
 4874:       if (k > kb && k < ivrt) {
 4875:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4876:       }
 4877: 
 4878:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 4879: 
 4880:       // Tsinghua group       
 4881:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 4882: 
 4883:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 4884:       if constexpr (stabilityModel == Galperin) {
 4885:          sh = 0.49393/(1.0-34.676*Gh);
 4886:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 4887:          cmiu  = sqrt(2.0)*sm;
 4888:          cmiup = sqrt(2.0)*sh;
 4889:          cmiu1 = sqrt(2.0)*0.2;
 4890:          cmiu2 = sqrt(2.0)*0.2;
 4891: 
 4892:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 4893:          // Warner's paper has problem
 4894:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 4895:          const double Ghp = Gh;  /// XXXXX needed?
 4896:          sh = 0.4939/(1.0 - 30.19*Ghp);
 4897:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 4898:          cmiu  = sqrt(2.0)*sm;
 4899:          cmiup = sqrt(2.0)*sh;
 4900:          cmiu1 = cmiu/schk();
 4901:          cmiu2 = cmiu/schpsi();
 4902: 
 4903:       } else {
 4904:          assert(false && "Unknown ASM");
 4905: 
 4906:       }
 4907: 
 4908:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 4909:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 4910:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 4911:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 4912:    }
 4913: }
 4914: 
 4915: 
 4916: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 4917: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 4918: 
 4919:    const double z = node->z[k];
 4920:    const double eta2 = node->eta2;
 4921:    const double depth = node->depth;
 4922: 
 4923:    // Distances to the surface and bottom
 4924:    const double dist_s = eta2 - z;
 4925:    const double dist_b = z + depth;
 4926: 
 4927:    // Distance to the closest "wall" (either surface or bottom).  
 4928:    // In the top layer, it is the size of the layer.
 4929:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 4930:    assert(min_dist > 0.0 && "Invalid minimum distance");
 4931: 
 4932:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 4933:    return kappa*min_dist;
 4934: }
 4935: 
 4936: 
 4937: 
 4938: template<TurbulenceModel turbulenceModel>
 4939: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 4940: 
 4941: 
 4942: template<>
 4943: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 4944:    // Constant turbulence model
 4945:    // Does nothing since dfv and dfh are already set  in the initialization.
 4946: }
 4947: 
 4948: template<>
 4949: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 4950:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 4951: 
 4952:    // Solves the following PDEs:
 4953:    //
 4954:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 4955:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 4956:    //
 4957:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 4958:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 4959:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 4960:    //
 4961:    // The equations are solved using a linear *vertical* FEM formulation.
 4962:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 4963:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 4964:    
 4965:    
 4966:    // Get the turbulence model
 4967:    // reinterpret_cast is used to avoid stupid compiler errors.
 4968:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 4969:      
 4970:    const int kb = node->kb;
 4971:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 4972: 
 4973:    double alow_tke[nvrt], alow_phi[nvrt];
 4974:    double bdia_tke[nvrt], bdia_phi[nvrt];
 4975:    double cupp_tke[nvrt], cupp_phi[nvrt];
 4976:    double rhs_tke [nvrt], rhs_phi [nvrt];
 4977:    
 4978:    // Initialize the tridiagonal system
 4979:    for (int kin = 0; kin < nqrows; kin++) {
 4980:       alow_tke[kin]=0.0;
 4981:       bdia_tke[kin]=0.0;
 4982:       cupp_tke[kin]=0.0;
 4983:       rhs_tke [kin]=0.0; 
 4984:       alow_phi[kin]=0.0;
 4985:       bdia_phi[kin]=0.0;
 4986:       cupp_phi[kin]=0.0;
 4987:       rhs_phi [kin]=0.0; 
 4988:    }
 4989: 
 4990: 
 4991: 
 4992:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 4993:    if (node->isDry || node->is2D()) {
 4994: 
 4995:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 4996:       const double diffmin = turb.diffmin;
 4997: 
 4998:       for (int k = 0; k < nvrt; k++) {
 4999:          turb.tke[k]    = turb.tkemin();
 5000:          turb.mxl[k]    = turb.mxlmin(node->depth);
 5001:          node->dfv[k]   = diffmin;
 5002:          node->dfh[k]   = diffmin;
 5003:          turb.nu_tke[k] = diffmin;
 5004:          turb.nu_phi[k] = diffmin;
 5005:       }
 5006: 
 5007:       return;
 5008:    }
 5009: 
 5010:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 5011:    
 5012:    // After here we know that the node is wet and has at least 2 layers.
 5013: 
 5014:    double solution[nvrt], gam[nvrt];
 5015:    
 5016:    const double eta2       = node->eta2;
 5017:    const double depth      = node->depth;
 5018:    const double Cd         = node->Cd; // Drag coefficient
 5019: 
 5020:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 5021:    
 5022:    const double sqU2 = norm2(node->u2[kb + 1]);
 5023:    const double modTau = length(node->tau);
 5024: 
 5025:  
 5026: 
 5027:    const double cpsi1 = turb.cpsi1();
 5028:    const double cpsi2 = turb.cpsi2();
 5029:    // cpsi3 is computed later because it depends on k
 5030: 
 5031: 
 5032:    // Assemble the tridiagonal system
 5033:    // -------------------------------
 5034: 
 5035:    // Loop over each vertical layer (interval between two vertical levels)
 5036:    // Each interval is an element of the vertical FEM formulation.
 5037:    // Two shape functions are defined over each interval. In this function we well call them
 5038:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5039:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5040:    //
 5041:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5042:    // Both systems of equations are assembled in the same loop.
 5043:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5044: 
 5045:       // Indices for the *rows* of the tridiagonal system.
 5046:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5047:       const int k2 = k - kb;     // One at k = kb + 1
 5048: 
 5049:       // Get the properties of the current interval.
 5050:       const double z  = node->z[k]; // bottom level of the interval
 5051:       const double dz = node->Dz(k + 1);
 5052:       
 5053:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5054: 
 5055:       // Turbulence production/dissipation terms (at the center of the interval).
 5056:       
 5057:       const double M2 = norm2(du_dz_c);              // Shear production term
 5058: 
 5059:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5060: 
 5061:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5062: 
 5063:       const double cpsi3 = turb.cpsi3(N2); 
 5064: 
 5065: 
 5066:       // Turbulence quantities at half levels (cell [c]enter)
 5067:       const double tke_1     = turb.tke[k];
 5068:       const double tke_2     = turb.tke[k+1];
 5069:       const double mxl_1     = turb.mxl[k];
 5070:       const double mxl_2     = turb.mxl[k+1];
 5071:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5072:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5073:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5074:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5075:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5076:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5077:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5078: 
 5079:       // Integral of the shape function products:
 5080:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5081:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5082:       const double p1p1 = dz/3.0;
 5083:       const double p1p2 = dz/6.0;
 5084:       const double d1d1 =  1.0/dz;
 5085:       const double d1d2 = -1.0/dz;
 5086: 
 5087:       // Production/dissipation related terms
 5088:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5089:       const double buoy = dfh_c*N2;
 5090:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5091: 
 5092: 
 5093: 
 5094:       // Equation for tke
 5095:       // ---------------
 5096: 
 5097:       // First row (of the two rows that the interval contributes to)
 5098:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5099:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5100:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5101: 
 5102: 
 5103:       if(prod + buoy >= 0.0) { // Net production
 5104:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5105:       } else { // Net dissipation
 5106:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5107:          bdia_tke[k1] -= 2.0*tmp;
 5108:          cupp_tke[k1] -= tmp;
 5109:       }      
 5110:       
 5111:       bdia_tke[k1] += 2.0*dt*diss;
 5112:       cupp_tke[k1] += dt*diss;
 5113:       
 5114:   
 5115:       // Second row (of the two rows that the interval contributes to)
 5116:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5117:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5118:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5119: 
 5120:       if (prod + buoy >= 0.0) { // Net production
 5121:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5122:       } else { // Net dissipation
 5123:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5124:          bdia_tke[k2] -= 2.0*tmp;
 5125:          alow_tke[k2] -= tmp;
 5126:       }
 5127:       
 5128:       bdia_tke[k2] += 2.0*dt*diss;
 5129:       alow_tke[k2] += dt*diss;
 5130: 
 5131: 
 5132:       // Equation for xl
 5133:       // ---------------
 5134: 
 5135:       const double rpub = turb.rpub();
 5136:       const double rmub = turb.rmub();
 5137:       const double rnub = turb.rnub();
 5138:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5139:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5140:       const double psi_c = 0.5*(psi_1 + psi_2);
 5141: 
 5142:       // Production/dissipation related terms
 5143:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5144:       const double buoy_phi = cpsi3*dfh_c*N2;
 5145:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5146: 
 5147:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5148:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5149:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5150: 
 5151:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5152:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5153:       } else { // Net dissipation
 5154:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5155:          bdia_phi[k1] -= 2.0*tmp;
 5156:          cupp_phi[k1] -= tmp;
 5157:       }
 5158: 
 5159:       // Production/dissipation terms
 5160:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5161:       cupp_phi[k1] += dt*diss_phi;
 5162:  
 5163: 
 5164:       // row k2 (upper)
 5165:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5166:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5167:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5168: 
 5169:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5170:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5171:       } else { // Net dissipation
 5172:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5173:          bdia_phi[k2] -= 2.0*tmp;
 5174:          alow_phi[k2] -= tmp;
 5175:       }
 5176: 
 5177:       // Production/dissipation terms
 5178:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5179:       alow_phi[k2] += dt*diss_phi;
 5180: 
 5181:    }
 5182: 
 5183:    // BC
 5184:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5185:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5186: 
 5187: 
 5188:    // Solves for tke.
 5189:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5190: 
 5191: 
 5192:    // B.C. (computed using values from previous time except wind)
 5193:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5194:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5195: 
 5196: 
 5197:    // Update TKE.
 5198:    turb.tke[kb]     = tkebot;
 5199:    turb.tke[kb + 1] = tkebot;
 5200:    turb.tke[ivrt]   = tkesrf;
 5201:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5202:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5203: // printf("tke[%d]: %f, solution[%d]: %f\n", k, turb.tke[k], kin, solution[kin]);   
 5204:    }
 5205: 
 5206: 
 5207: 
 5208:  
 5209:    // Solves for phi.
 5210:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5211: 
 5212: 
 5213:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5214:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5215:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5216: 
 5217:    turb.mxl[kb+1] = mxlbot;
 5218:    turb.mxl[ivrt] = mxlsrf;
 5219:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5220:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5221: 
 5222:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5223: 
 5224:       // Galperin's clipping
 5225:       if (N2 < 0.0) {
 5226:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5227:          turb.mxl[k] = min(turb.mxl[k], upper);
 5228:       }   
 5229: 
 5230: 
 5231: 
 5232:       // Max. mixing length based on dissipation; mxlmin prevails
 5233:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5234: 
 5235:       // Combined max. mixing length including geometric limit
 5236:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5237: 
 5238:       // Clamp the mixing length between the minimum and maximum values
 5239:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5240: 
 5241:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5242: 
 5243: 
 5244:    } // for k
 5245: 
 5246: 
 5247:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5248:    turb.tke[kb] = turb.tke[kb + 1];
 5249:    turb.mxl[kb] = turb.mxl[kb + 1];
 5250: 
 5251: 
 5252:    // Compute vertical diffusivities at new time
 5253:    turb.computeDiffusivities(node);
 5254: 
 5255:    // make all the variables uniform below the bottom level kb
 5256:    for (int k = 0; k < kb; k++) {
 5257:       node->dfv[k] = node->dfv[kb];
 5258:       node->dfh[k] = node->dfh[kb];
 5259:       turb.tke[k] = turb.tke[kb];
 5260:       turb.mxl[k] = turb.mxl[kb];
 5261:       turb.nu_tke[k] = turb.nu_tke[kb];
 5262:       turb.nu_phi[k] = turb.nu_phi[kb];
 5263:    }
 5264: 
 5265:       
 5266: 
 5267: }
 5268: 
 5269: 
 5270: 
 5271: 
 5272: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5273:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5274:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5275: 
 5276: 
 5277:    NODE(node1);
 5278: 
 5279:    node1->clearMatrixRow();
 5280:    node1->qel = 0.0;
 5281: 
 5282:    // THIS IS FOR STRUCTURES XXX
 5283:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5284: 
 5285:    
 5286:    for (int j=0; j<node1->numElements; j++) {
 5287:       // For each element connected to the node...
 5288: 
 5289:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5290: 
 5291:       Element *elem = node1->elements[j];
 5292: 
 5293:       // Compute the average gravity
 5294:       const double grav3 = elem->mean(&Node::grav2);
 5295: 
 5296:       // Look at the documentation for the description of the terms in the following integrals
 5297: 
 5298:       // Integral I_1 
 5299:       // \bar{\breve{H}} 
 5300:       const double hhatb = elem->mean(&Side::hhat);        
 5301: 
 5302:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5303: 
 5304:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5305:       const double area = elem->area;
 5306: 
 5307:       // Integral I_4
 5308:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5309:       // Where
 5310:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5311: 
 5312:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5313:       // of U over the element.
 5314:       const Vector2 U = elem->mean(&Side::U);
 5315: 
 5316:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5317: 
 5318:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5319:       const double I_4_1 = dot(gradPhi_1, U);
 5320: 
 5321: 
 5322:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5323:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5324: 
 5325:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5326: 
 5327: 
 5328:       // Normal component of the bed velocity
 5329:       double ubedNormalComp = 0.0;
 5330:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5331:          Vector3 ubed = {0.0, 0.0, 0.0};
 5332:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5333:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5334: 
 5335:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5336:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5337:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5338: 
 5339:          // Computes the normal component of the bed velocity
 5340:          ubedNormalComp = dot(ubed, N);
 5341:       } // imm==2
 5342: 
 5343:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5344: 
 5345:       if (elem->isTri()) {
 5346: 
 5347:          // To clarify the notation in this section: 
 5348:          //   In formulas, we use the following notation:
 5349:          //       i stands for the node under consideration (node1)
 5350:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5351:          //   However, in the code, we use the following notation:
 5352:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5353:          const int id2 = elem->nxq(1 + id1);
 5354:          const int id3 = elem->nxq(2 + id1);
 5355:          Node *node2 = elem->nodes[id2];
 5356:          Node *node3 = elem->nodes[id3];
 5357: 
 5358:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5359: 
 5360:          // integral of phi_i*phi_j
 5361:          const double ipp_ii = (1.0/6.0 )*area;
 5362:          const double ipp_ij = (1.0/12.0)*area;
 5363:          const double ipp_ik = (1.0/12.0)*area;
 5364: 
 5365:          // integral of [(grad phi_i) * (grad phi_j)]
 5366:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5367:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5368:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5369: 
 5370:          // Computes the different components of integral I_1 of each node with respect to node i.
 5371:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5372:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5373:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5374: 
 5375:          node1->addToSparseMatrix(node1, I1_ii);
 5376:          node1->addToSparseMatrix(node2, I1_ij); 
 5377:          node1->addToSparseMatrix(node3, I1_ik);
 5378: 
 5379:          #pragma unroll
 5380:          for (int l=0; l<3; l++) {
 5381: 
 5382:             Node *node = elem->nodes[l];
 5383: 
 5384:             // Additional variation in eta due to bed deformation or vertical velocity
 5385:             double extraEta = 0.0;
 5386:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5387:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5388: 
 5389: 
 5390:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5391:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5392: 
 5393:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5394: 
 5395:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5396:            
 5397:          }
 5398: 
 5399: 
 5400:       }
 5401:       else { // Quad
 5402:          // To clarify the notation in this section: 
 5403:          //   In formulas, we use the following notation:
 5404:          //       i stands for the node under consideration (node1)
 5405:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5406:          //   However, in the code, we use the following notation:
 5407:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5408:          const int id2 = elem->nxq(1 + id1);
 5409:          const int id3 = elem->nxq(2 + id1);
 5410:          const int id4 = elem->nxq(3 + id1);
 5411:          Node *node2 = elem->nodes[id2];
 5412:          Node *node3 = elem->nodes[id3];
 5413:          Node *node4 = elem->nodes[id4];   
 5414:          
 5415:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5416: 
 5417:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5418:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5419:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5420:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5421:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5422: 
 5423:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5424:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5425:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5426:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5427:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5428: 
 5429: 
 5430:          // Computes the different components of integral I_1 of each node with respect to node i.
 5431:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5432:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5433:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5434:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5435: 
 5436:          node1->addToSparseMatrix(node1, I1_ii);
 5437:          node1->addToSparseMatrix(node2, I1_ij); 
 5438:          node1->addToSparseMatrix(node3, I1_ik);
 5439:          node1->addToSparseMatrix(node4, I1_il);
 5440:   
 5441:          #pragma unroll
 5442:          for (int l=0; l<4; l++) {
 5443: 
 5444:             const Node *node = elem->nodes[l];
 5445: 
 5446:             // Additional variation in eta due to bed deformation or vertical velocity
 5447:             double extraEta = 0.0;
 5448:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5449:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5450: 
 5451:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5452:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5453:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5454: 
 5455:          }         
 5456:       } 
 5457: 
 5458: 
 5459:      node1->qel += (dt/elem->i34)*elem->vsource;
 5460:       
 5461: 
 5462:    } // for all elements connected to the node
 5463:    
 5464: 
 5465:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5466:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5467:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5468:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5469:    // If it is an open boundary node...
 5470: 
 5471:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5472: 
 5473:       // At least one open bnd side, maybe two
 5474:       for (int l=0; l<2; l++) { 
 5475: 
 5476:          // Gets each of the sides sharing the node. 
 5477:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5478: 
 5479:     
 5480: 
 5481:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5482:          if (sideBnd != nullptr) {
 5483:             // If the side is on a boundary...
 5484: 
 5485:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5486: 
 5487:             // Get the boundary segment
 5488:             const BoundarySegment *sideSegment = sideBnd->segment;
 5489:             const Side *side = sideBnd->side;
 5490: 
 5491:             // Integral I_3
 5492:             if (sideSegment->ifltype != 0) {
 5493:             // Natural or Flather b.c.
 5494: 
 5495:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5496:                // especially for Flather b.c.
 5497:                double ri3 = 0.0;
 5498:                if (!side->isDry) {
 5499:                   // If the side is not dry
 5500:                   
 5501:                   // Computes the side flux of (uth, vth)
 5502:                   double Vn = 0.0;
 5503:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5504:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5505:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5506: 
 5507:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5508:                   }
 5509: 
 5510:                   ri3 = 0.5*side->len*Vn;
 5511:                }
 5512: 
 5513:                if (sideSegment->ifltype == -1) { // Flather 1
 5514: 
 5515:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5516:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5517: 
 5518:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5519:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5520:                   
 5521:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5522:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5523: 
 5524:                } 
 5525:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5526:                   // Reset ri3
 5527:                   ri3 = 0.0;
 5528: 
 5529:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5530:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5531: 
 5532:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5533: 
 5534:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5535:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5536: 
 5537:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5538:                   node1->addToSparseMatrix(node1, con0*2.0);
 5539:                   node1->addToSparseMatrix(node2, con0);
 5540: 
 5541:                } // if Flather or Discharge
 5542: 
 5543:                node1->qel -= thetai*dt*ri3;  
 5544: 
 5545: 
 5546:             } // I_3
 5547:           
 5548: 
 5549:             // Integral I_5
 5550:             if(!side->isDry) {
 5551: 
 5552:                const double Unbar = dot(side->U, side->n);
 5553:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5554: 
 5555:             } // I_5
 5556: 
 5557:          } // if is boundary side
 5558: 
 5559:       } // for l
 5560: 
 5561:    } // if isbnd
 5562: 
 5563: 
 5564: }
 5565: 
 5566: 
 5567: 
 5568: extern "C" {
 5569: 
 5570:    __global__ void gatherBFromMesh(double* b) {
 5571:       // b[local] <- qel  (local = idx_node on this device)
 5572:       NODE(node);
 5573:       b[idx_node] = node->qel;
 5574:    }
