 4214:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4215: 
 4216:       NODE_BND(nodeBnd);
 4217: 
 4218:       Node *node = nodeBnd->node;
 4219: 
 4220:       node->ETP = 0.0;
 4221: 
 4222:       for (int j=0; j<ntip; j++) {
 4223: 
 4224:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4225:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4226:    
 4227:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4228: 
 4229:          if constexpr(iloadtide==1) { // loading tide
 4230:             assert(false && "Loading tide not implemented");
 4231:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4232:          }
 4233:          
 4234:       }
 4235:       
 4236:    }
