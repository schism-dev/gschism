  419: // Polynomial class
  420: template<int grade>
  421: struct Polynomial {
  422:     // Static assertion to give a clear error message at compile time
  423:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  424: };
  425: 
  426: 
  427: // Explicit specialization for grade 4
  428: template<>
  429: struct Polynomial<4> {
  430:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  431: 
  432:    // Constructor from coefficients
  433:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  434: 
  435:    __device__ __forceinline__ double eval(double x) const {
  436:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  437:    }
  438: };
