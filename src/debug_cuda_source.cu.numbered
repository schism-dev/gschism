 2534: 
 2535: 
 2536: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2537: 
 2538: 
 2539: __device__ void Node::updateKb(void) {
 2540: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2541: 
 2542:    if constexpr(ivcor == 1) return;
 2543: 
 2544: 
 2545:    // Check if node is wet
 2546:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2547: 
 2548:    if (isDry) return;
 2549: 
 2550:    if constexpr(ivcor == 2) {  // SZ coordinates
 2551:       
 2552:       // Compute bottom level index
 2553:       if (depth <= mesh->h_s) {
 2554:          kb = mesh->kz - 1;
 2555:       } else {
 2556:          kb = -1;
 2557:          int L = 0;
 2558:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2559:          
 2560:          while (L <= R) {
 2561:             int M = (R + L) / 2;
 2562: 
 2563:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2564:             
 2565:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2566:                R = M;
 2567:             } else {
 2568:                L = M;
 2569:             }
 2570: 
 2571:             if (R - L == 1) {
 2572:                kb = L;
 2573:                break;
 2574:             }
 2575:          }
 2576:       }
 2577:    } 
 2578: }
 2579: 
 2580: 
 2581: __device__ __inline__ void Node::updateZCoordData(void) {
 2582: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2583: 
 2584:    if (isDry2()) return;
 2585: 
 2586:    if constexpr(ivcor == 2) {  // SZ coordinates
 2587:       
 2588:       // Compute bottom level index
 2589:       if (depth <= mesh->h_s) {
 2590:             kb = mesh->kz;
 2591:       } else {
 2592:          kb = -1;
 2593:          for (int i = 0; i < mesh->kz; i++) {
 2594:             // XXX Use binary search
 2595:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2596:                kb = i;
 2597:                break;
 2598:             }
 2599:          }
 2600:       }
 2601:    } 
 2602:    else if (ivcor == 1) {  // Localized sigma
 2603:       // Do nothing
 2604:    }
 2605: 
 2606: }
 2607: 
 2608: __device__ double Node::compZCoord(int k) const {
 2609:    // Computes the z coordinate at level k.
 2610:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2611:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2612:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2613:    // used 
 2614:    
 2615:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2616: 
 2617:   
 2618:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2619: 
 2620:    if constexpr(ivcor == 2) {
 2621: 
 2622:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2623:       const int kz = mesh->kz;
 2624:       const double h_c = mesh->h_c;
 2625:       const double theta_f = mesh->theta_f;
 2626:       const double sinh_theta_f = mesh->sinh_theta_f;
 2627: 
 2628:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2629:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2630:       // once per time step/node.
 2631:       // CHECK: updateZCoordData
 2632: 
 2633:       if      (k == nvrt-1)      return eta2; 
 2634:       else if (k == kz)          return -hmod2;
 2635:       else if (k == kb)          return -depth;
 2636:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2637:       else if (k > kz) {
 2638:          const int ksig = k - kz + 1;
 2639: 
 2640:          if (hmod2 <= h_c) {
 2641: printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2642:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2643:          } 
 2644:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2645:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2646:             assert(false && "ZCOOR: invalid h_c\n");
 2647:          } 
 2648:          else {
 2649: printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2650:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2651:                          h_c * mesh->sigma[ksig] + 
 2652:                          (hmod2 - h_c) * mesh->cs[ksig];
 2653:          }
 2654:       } else { 
 2655:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2656:       }
 2657: 
 2658:    }
 2659:    else if constexpr(ivcor == 1) {
 2660:       if (k == kb) return -depth;
 2661:       else if (k == nvrt-1) return eta2;
 2662:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2663:    }
 2664:    
 2665:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2666:    return 0.0;
 2667: }
 2668: 
 2669: 
 2670: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2671:    // Checks if a side in on the boundary
 2672:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2673: 
 2674:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2675:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2676: 
 2677:    // Indices of the nodes that form the side
 2678:    const int n1 = side.n1->idx;
 2679:    const int n2 = side.n2->idx;
 2680: 
 2681:    // Check if the side is on a land boundary
 2682:    for (int i = 0; i < nland; i++) {
 2683:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2684:          // Consecutive nodes in the land boundary segment
 2685:          const int b1 = ilnd[i*mnlnd + j];
 2686:          const int b2 = ilnd[i*mnlnd + j + 1];
 2687: 
 2688:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2689:             isLand = true;
 2690:             return i;
 2691:          }
 2692:       }
 2693:    }
 2694: 
 2695:    // Check if the side is on an open boundary
 2696:    for (int i = 0; i < nope; i++) {
 2697:       for (int j = 0; j < nond[i] - 1; j++) {
 2698:          // Consecutive nodes in the open boundary segment
 2699:          const int b1 = iond[i*mnond + j];
 2700:          const int b2 = iond[i*mnond + j + 1];
 2701: 
 2702:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2703:             isLand = false;
 2704:             return i;
 2705:          }
 2706:       }
 2707:    }
 2708:    return -1;
 2709: }
 2710: 
 2711: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2712:                 double *node_coords, double *wind_rotate_angle, 
 2713:                 int *isdel, int *isidenode, int *isbnd,
 2714:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2715:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2716:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2717:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2718:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2719:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2720:                 double *emo, double *efa, 
 2721:                 double *umo, double *ufa, 
 2722:                 double *vmo, double *vfa) {
 2723: 
 2724:    printf("Populating mesh for partition %d\n", partNum);
 2725: 
 2726:    // Horizontal grid
 2727:    printf("Processing %d nodes\n", np);    
 2728: 
 2729: 
 2730:    int idxNodeBoundary = 0;  
 2731:    for (int i = 0; i < np; i++)
 2732:    {
 2733:       Node &node = localNodeData[i];
 2734: 
 2735:       node.idx = i;
 2736: 
 2737:       const int idxNodeStart = nodeNeighNodesStart[i];
 2738:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2739:       node.numNodes = idxNodeEnd - idxNodeStart;
 2740:       node.nodes = nodeNeighNodes + idxNodeStart;
 2741:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2742: 
 2743: 
 2744: 
 2745:       const int idxElemStart = nodeNeighElemsStart[i];
 2746:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2747:       node.numElements = idxElemEnd - idxElemStart;
 2748:       node.elements = nodeNeighElems + idxElemStart;
 2749: 
 2750: 
 2751:       
 2752:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2753:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2754:          const int partNode = localNodePart[idxNodeGlobal]; 
 2755:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2756: 
 2757: 
 2758:          Node *node_ptr = nodes[partNode] + idxNode;
 2759:          
 2760:          nodeNeighNodes[idx] = node_ptr;
 2761:       }
 2762: 
 2763:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2764:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2765:          const int partElem = localElemPart[idxElemGlobal];
 2766:          const int idxElem  = localElemIndices[idxElemGlobal];
 2767: 
 2768:          Element *elem_ptr = elems[partElem] + idxElem;
 2769: 
 2770:          nodeNeighElems[idx] = elem_ptr;
 2771:       }      
 2772: 
 2773: 
 2774:       node.wind_angle = wind_rotate_angle[i];
 2775: 
 2776:       // Element **elements; // pointer to the elements connected to this node
 2777:       // int numElements;   // number of elements shared by this node
 2778: 
 2779:       node.p.x   = node_coords[i * 3];
 2780:       node.p.y   = node_coords[i * 3 + 1];
 2781:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2782:       node.depth = node_coords[i * 3 + 2];
 2783: 
 2784:       node.numSides = 0;
 2785: 
 2786: 
 2787:       // Links the node to the boundary information
 2788:       if (isbnd[i] >= 0) {
 2789:        
 2790:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2791:          node.nodeBnd->node = &node;
 2792: 
 2793:          node.nodeBnd->sideBnd1 = nullptr;
 2794:          node.nodeBnd->sideBnd2 = nullptr;
 2795: 
 2796:          if (isbnd[i]>=0) {
 2797: 
 2798:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2799:             
 2800:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2801:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2802: 
 2803:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2804:             node.nodeBnd->segment->clen  = nan("1");
 2805:             node.nodeBnd->segment->carea = nan("1");
 2806: 
 2807:          }
 2808: //          else {
 2809: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2810: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2811: //          }
 2812:          
 2813:          idxNodeBoundary++;
 2814:       }
 2815:       else {
 2816:          node.nodeBnd = nullptr; // For internal nodes
 2817: 
 2818:          if (isbnd[i] == landSegment) {
 2819:             node.nodeBnd = &landBoundaryNode;
 2820:             node.nodeBnd->segment = &landBoundarySegment;
 2821:          }
 2822:          // node.nodeBnd->node = &node;
 2823:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2824:          // // node.nodeBnd = nullptr;
 2825:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2826:         
 2827:       }
 2828: 
 2829:       // XXXX GAUSSIAN HILL VELOCITIES
 2830: #ifdef GAUSSIAN_HILL_VELOCITIES
 2831:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2832:          constexpr double rot_per = 3000.0;
 2833:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2834:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2835:       // XXXXX
 2836: #endif
 2837:    }
 2838: 
 2839:    nbp = idxNodeBoundary;
 2840: 
 2841:    printf("Processing %d sides\n", ns);
 2842:    int idxSideBoundary = 0;
 2843:    for (int i = 0; i < ns; i++)
 2844:    {
 2845:       Side &side = localSideData[i];
 2846:       side.idx = i;
 2847:       // finding the pointer to the nodes that form the side
 2848:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2849:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2850: 
 2851:       const int locidx_n1 = localNodeIndices[idx_n1];
 2852:       const int locidx_n2 = localNodeIndices[idx_n2];
 2853:       const int part_n1 =   localNodePart[idx_n1];
 2854:       const int part_n2 =   localNodePart[idx_n2];
 2855: 
 2856:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2857:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2858: 
 2859:       // Counts the number of sides connected to each node
 2860:       side.n1->numSides++;
 2861:       side.n2->numSides++;
 2862: 
 2863:       // Normal, unitary vector to the side
 2864:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2865:       side.n = normalize(side.n);
 2866: 
 2867:       // Side boundary type
 2868:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2869:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2870: 
 2871:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2872:       // If both nodes are on the boundary, then the side may be on the boundary
 2873:       {
 2874:          bool isLand = false;
 2875:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2876: 
 2877:          if (isbs > -1) {
 2878:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2879:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2880:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2881: 
 2882:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2883:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2884:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2885: 
 2886:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2887:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2888:           
 2889:             side.sideBnd->side = &side;
 2890:             idxSideBoundary++;
 2891: 
 2892:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2893:          }
 2894:          
 2895: 
 2896:       // }
 2897:       // 
 2898: 
 2899: 
 2900: 
 2901: 
 2902: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2903: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2904: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2905: //       {
 2906: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2907: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2908: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2909: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2910: // if (side.sideBnd->segment == nullptr) continue;
 2911: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2912: //          else                  side.sideBnd->segment = n2bnd->segment;
 2913: //          side.sideBnd->side = &side;
 2914: //          idxSideBoundary++;
 2915: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2916:       }
 2917:       else side.sideBnd = nullptr;
 2918: 
 2919:       nbs = idxSideBoundary;
 2920: 
 2921:       // finding the pointer to the elements that share the side
 2922:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2923:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2924: 
 2925:       if (idx_e1 > -1) {
 2926:          const int locidx_e1 = localElemIndices[idx_e1];
 2927:          const int part_e1 =  localElemPart[idx_e1];
 2928:          side.elems[0] = elems[part_e1] + locidx_e1;
 2929: 
 2930:       }
 2931:       else {
 2932:          side.elems[0] = nullptr;
 2933:       }
 2934: 
 2935:       if (idx_e2 > -1) {
 2936:          const int locidx_e2 = localElemIndices[idx_e2];
 2937:          const int part_e2 =  localElemPart[idx_e2];
 2938:          side.elems[1] = elems[part_e2] + locidx_e2;
 2939:       }
 2940:       else {
 2941:          side.elems[1] = nullptr;
 2942:       }
 2943: 
 2944:       // Compute the center of the side
 2945:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2946: 
 2947:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 2948:       side.shapiro = shapiro0;
 2949: 
 2950: #ifdef GAUSSIAN_HILL_VELOCITIES
 2951: // XXXX
 2952: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2953: constexpr double rot_per=3000.0;
 2954: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2955: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2956: // XXXXX      
 2957: #endif
 2958:       // Compute the z level at the center of the side
 2959:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2960: 
 2961:       // Compute the length of the side
 2962:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2963:       side.len = sqrt(dot(vLen, vLen));
 2964: 
 2965:    }
 2966: 
 2967:    printf("Processing %d elements\n", ne);
 2968:    for (int i = 0; i < ne; i++)
 2969:    {
 2970:       Element &elem = localElemData[i];
 2971:       elem.idx = i;
 2972:       for (int j = 0; j < i34[i]; j++) {
 2973:          const int idxNode = elnode[i*4 + j];  
 2974:          const int idxSide = elside[i*4 + j];
 2975:          
 2976:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2977:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2978: 
 2979: 
 2980: 
 2981:          // Find the neighboring element  
 2982:          if (elem.sides[j]->elems[0] == &elem) {
 2983:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2984:          }
 2985:          else {
 2986:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2987:          }
 2988:          
 2989:       }
 2990: 
 2991:       elem.i34 = i34[i];
 2992: 
 2993:       // Compute the centroid of the element and its depth
 2994:       Vector2 center = {0.0, 0.0};
 2995:       elem.depth = 0.0;
 2996:       for (int j = 0; j < i34[i]; j++) {
 2997:          center += elem.nodes[j]->p2()/i34[i];
 2998:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2999:       }
 3000:       elem.center.x = center.x;
 3001:       elem.center.y = center.y;
 3002: 
 3003: 
 3004:       
 3005:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3006:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3007: 
 3008:       elem.area = elem.computeSignedArea(); 
 3009:       elem.radius = sqrt(elem.area)/pi; 
 3010:       
 3011:       // Determines which way the normal vector to each side is oriented.
 3012:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3013:       for (int j = 0; j < i34[i]; j++)  
 3014:       {
 3015:          if (elem.sides[j]->elems[0] == &elem) {
 3016:             elem.ssign[j] =  1.0;
 3017:          }
 3018:          else {
 3019:             elem.ssign[j] = -1.0;
 3020:          }
 3021: 
 3022:       }
 3023: 
 3024:       // Derivatives of shape functions
 3025:       //  For ics=2, this is done inside element/ll frame XXX
 3026:       //  For quads, the derivative is evaluated at centroid
 3027:       const int i34 = elem.i34;
 3028:       for (int j = 0; j < i34; j++) {
 3029:          const double area = elem.area;
 3030:          const int id2 = elem.nxq(1 + j);
 3031:          const int id3 = elem.nxq(2 + j);
 3032:          const int id4 = elem.nxq(3 + j);
 3033:          if (elem.isTri()) {
 3034:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3035:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3036:             // da1/dx = (y1 - y2)/(2*area)
 3037:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3038:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3039:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3040:          }
 3041:          else  { // Quad; evaluate at centroid
 3042:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3043:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3044:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3045:          } // if Tri
 3046: 
 3047:       } // for j
 3048: 
 3049:    }
 3050: 
 3051: 
 3052:    // Processing the boundary nodes
 3053:    int idx = 0;
 3054:    for (int iseg = 0; iseg < nope; iseg++) {
 3055:       // for each segment...
 3056:       
 3057:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3058:          // for each node on the segment...
 3059: 
 3060:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3061: 
 3062:          nodeBnd->isEssentialBC = true;
 3063: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3064:          nodeBnd->elbc = 0.0;
 3065: 
 3066:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3067: 
 3068:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3069:             nodeBnd->efa[jfr] = efa[idx];
 3070:             nodeBnd->emo[jfr] = emo[idx];
 3071:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3072:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3073: 
 3074:          }
 3075: 
 3076:          idx++;
 3077:       }
 3078: 
 3079:    }
 3080: 
 3081: }
 3082: 
 3083: 
 3084: 
 3085: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3086:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3087:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3088:    // 
 3089:    // This kernel is called for all nodes.
 3090: 
 3091: 
 3092:    NODE(node1);
 3093: 
 3094: 
 3095:    node1->clearMatrixRow();
 3096:    node1->qel = 0.0;
 3097: 
 3098:    // THIS IS FOR STRUCTURES XXX
 3099:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3100: 
 3101:    
 3102:    for (int j=0; j<node1->numElements; j++) {
 3103:       // For each element connected to the node...
 3104: 
 3105:       Element *elem = node1->elements[j];
 3106: 
 3107:       // Compute the average gravity
 3108:       const double grav3 = elem->mean(&Node::grav2);
 3109: 
 3110:       // Look at the documentation for the description of the terms in the following integrals
 3111: 
 3112:       // Integral I_1 
 3113:       // \bar{\breve{H}} 
 3114:       const double hhatb = elem->mean(&Side::hhat);        
 3115: 
 3116: 
 3117:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3118: 
 3119:       const int id1 = elem->nodeLocalIdx(node1); 
 3120:       const double area = elem->area;
 3121: 
 3122:       if (elem->isTri()) {
 3123: 
 3124:          // To clarify the notation in this section: 
 3125:          //   i stands for the node under consideration (node1)
 3126:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3127:          const int id2 = elem->nxq(1 + id1);
 3128:          const int id3 = elem->nxq(2 + id1);
 3129:          Node *node2 = elem->nodes[id2];
 3130:          Node *node3 = elem->nodes[id3];
 3131: 
 3132:          const Point2 x1 = node1->p2();
 3133:          const Point2 x2 = node2->p2();
 3134:          const Point2 x3 = node3->p2();
 3135: 
 3136:          // integral of phi_i*phi_j
 3137:          const double ipp_ii = (1.0/6.0 )*area;
 3138:          const double ipp_ij = (1.0/12.0)*area;
 3139:          const double ipp_ik = (1.0/12.0)*area;
 3140: 
 3141:          // integral of [(grad phi_i) * (grad phi_j)]
 3142:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3143:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3144:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3145: 
 3146:          // Computes the different components of integral I_1 of each node with respect to node i.
 3147:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3148:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3149:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3150: 
 3151:          node1->addToSparseMatrix(node1, I1_ii);
 3152:          node1->addToSparseMatrix(node2, I1_ij); 
 3153:          node1->addToSparseMatrix(node3, I1_ik);
 3154: 
 3155:       }
 3156:       else { // Quad
 3157:          // XXX IMPLEMENT THIS
 3158:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3159:       } 
 3160: 
 3161:  
 3162:       // Integral I_4
 3163:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3164:       // Where
 3165:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3166: 
 3167:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3168:       // of U over the element.
 3169:       Vector2 Umean = {0.0, 0.0};
 3170:       for (int m=0; m<elem->i34; m++) {      
 3171:          const Side *side = elem->sides[m];
 3172: 
 3173:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3174:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3175:       }
 3176:       Umean = Umean/elem->i34;
 3177: 
 3178:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3179: 
 3180:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3181:       const double I_4_1 = dot(gradPhi_1, Umean);
 3182: 
 3183:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3184:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3185:      
 3186: // printf(">>> k = %d, node idx = %d, elem->idx = %d, Umean = %.15e,%.15e, I_4_1 = %.15e, I_4_2 = %.15e, node1->qel = %.15e\n", j, node1->idx, elem->idx, Umean.x, Umean.y, I_4_1, I_4_2, dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2));
 3187: // printf(">>> k = %d, node idx = %d, elem->idx = %d, ghat1 = %.15e,%.15e, gradPhi = %.15e,%.15e\n", j, node1->idx, elem->idx, elem->ghat1.x, elem->ghat1.y, gradPhi_1.x, gradPhi_1.y);
 3188:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3189: 
 3190:       // Additional terms 
 3191:       double vnorm = 0.0;
 3192:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3193:          Vector3 ubed;
 3194:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3195: 
 3196:          Vector3 gradP = {0.0, 0.0, 1.0};
 3197:          for (int m=0; m < elem->i34; m++) {
 3198:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3199:            gradP += toVector3(gradP_2D, 0.0);
 3200:          }   
 3201:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3202:       } // imm==2
 3203: 
 3204:       if (elem->isTri()) {
 3205:          for (int l=0; l<3; l++) {
 3206:             double fac;
 3207: 
 3208:             Node *node = elem->nodes[l];
 3209: 
 3210:             fac = (node == node1) ? 2.0 : 1.0;
 3211:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3212:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3213: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3214:            
 3215:          }
 3216: 
 3217: 
 3218:          if (!elem->isDry) {
 3219:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3220: 
 3221:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3222: // printf("BBB>>>  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta) = %.15e\n",  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta));
 3223:          }
 3224: 
 3225:       } // isTri
 3226:       else { // isQuad
 3227:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3228:          // for (int l=0; l<4; l++) {
 3229:          //   const Node *node = elem->nodes[l];
 3230: 
 3231:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3232:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3233: 
 3234:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3235:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3236:          // }
 3237: 
 3238:       } // isQuad
 3239: 
 3240: 
 3241:       node1->qel += (dt/elem->i34)*elem->vsource;
 3242:       
 3243: 
 3244:    } // for all elements connected to the node
 3245:    
 3246: 
 3247: 
 3248:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3249:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3250:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3251:    if (nodeBnd != nullptr)  { 
 3252:       // If it is an open boundary node...
 3253: 
 3254:       // At least one open bnd side, maybe two
 3255:       for (int l=0; l<2; l++) { 
 3256: 
 3257:          // Gets each of the sides sharing the node. 
 3258:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3259: 
 3260:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3261: 
 3262:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3263: 
 3264:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3265:          if (sideBnd != nullptr) {
 3266:             // If the side is on a boundary...
 3267: 
 3268:             // Get the boundary segment
 3269:             const BoundarySegment *sideSegment = sideBnd->segment;
 3270:             const Side *side = sideBnd->side;
 3271: 
 3272:             // Integral I_3
 3273:             if (sideSegment->ifltype != 0) {
 3274:             // Natural or Flather b.c.
 3275: 
 3276:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3277:                // especially for Flather b.c.
 3278:                double ri3 = 0.0;
 3279:                if (!side->isDry) {
 3280:                   // If the side is not dry
 3281:                   
 3282:                   // Computes the side flux of (uth, vth)
 3283:                   double Vn = 0.0;
 3284:                   for (int k = side->kb; k<nvrt-1; k++) {
 3285:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3286:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3287: 
 3288:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3289:                   }
 3290: 
 3291:                   ri3 = 0.5*side->len*Vn;
 3292:                }
 3293: 
 3294:                if (sideSegment->ifltype == -1) { // Flather 1
 3295: 
 3296:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3297:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3298: 
 3299:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3300:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3301:                   
 3302:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3303:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3304: 
 3305:                } 
 3306:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3307:                   // Reset ri3
 3308:                   ri3 = 0.0;
 3309: 
 3310:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3311: 
 3312:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3313: 
 3314:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3315:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3316: 
 3317:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3318:                   node1->addToSparseMatrix(node1, con0*2.0);
 3319:                   node1->addToSparseMatrix(node2, con0);
 3320: 
 3321:                } // if Flather or Discharge
 3322: 
 3323:                node1->qel -= thetai*dt*ri3;
 3324: 
 3325:             } // I_3
 3326:           
 3327: 
 3328:             // Integral I_5
 3329:             if(!side->isDry) {
 3330: 
 3331:                const double Unbar = dot(side->U, side->n);
 3332:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3333: 
 3334:             } // I_5
 3335: 
 3336:          } // if is boundary side
 3337: 
 3338:       } // for l
 3339: 
 3340:    } // if isbnd
 3341: 
 3342: 
 3343: }
 3344: 
 3345: 
 3346: 
 3347: extern "C" {
 3348:    __global__ void rollUpElevation(void) {
 3349: 
 3350:       NODE(node);
 3351: 
 3352:       node->eta1 = node->eta2;
 3353: 
 3354:    }
 3355: 
 3356: 
 3357:    __global__ void backtrackAllNodes(void) {
 3358: 
 3359:       // max/min # of sub-divisions
 3360:       const int ndelt_max = max(1.0, dt/dtb_min);
 3361:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3362: 
 3363:       // Removed all references to swild98 XXX
 3364:       // swild98=0.d0 !init
 3365: 
 3366: 
 3367:       SIDE(side);
 3368: 
 3369:       const int kb = side->kb;
 3370: 
 3371: 
 3372: 
 3373:       // Initialize btrack velocities to the actual velocities at the side 
 3374:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3375: 
 3376:       if (side->isDry) return;
 3377: 
 3378: 
 3379:       // Checks that at least one element is not dry
 3380:       const Element *elem1 = side->elems[0];
 3381:       const Element *elem2 = side->elems[1];
 3382: 
 3383: 
 3384:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3385:       
 3386:       // XXXXXX
 3387:       // !swild_tmp to store global coord. of the starting side
 3388:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3389:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3390:       // !Use sframe2 
 3391:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3392: 
 3393: 
 3394:       for (int k = kb; k < nvrt; k++) {
 3395:       //  Initialize (xt,yt,zt), nnel and vel.
 3396:       //  For ics=2, the coordinates are in local frames
 3397:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3398: 
 3399: 
 3400:          const int iadvf = side->iadv();  // Advection flag
 3401: 
 3402:          Point3 xt;
 3403:          if constexpr(ics==1) {
 3404:             xt = side->center3D(k); 
 3405:          }
 3406:          else // lat/lon; in side lat/lon frame
 3407:          {
 3408:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3409:          // XXX IMPLEMENT THIS
 3410:       //          xt=0.d0
 3411:       //          yt=0.d0
 3412:       //          !centroid coord. for nudging
 3413:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3414:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3415:          }  // ics
 3416: 
 3417: 
 3418: 
 3419:          // If on land or open boundary...
 3420:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3421:          
 3422:          const double vmag = length(side->u2[k]);
 3423: 
 3424:          if (vmag <= velmin_btrack) {
 3425:             // No activity 
 3426: 
 3427:             side->btu[k] = side->u2[k];
 3428:             
 3429:          } else {  // do btrack
 3430: 
 3431:             // Compute number of sub-divisions based on local gradients 
 3432:             // XXX IS THIS NECESSARY?
 3433:             double suma = 0.0;
 3434:             int icount = 0;
 3435:             for (int ii=0; ii<2; ii++) {
 3436: 
 3437:                const Element *elem = side->elems[ii];
 3438:                  
 3439:                if (elem == nullptr) continue;
 3440: 
 3441:                icount++;
 3442: 
 3443:                // Not strictly along z; in ll frame for ics=2
 3444: 
 3445:                double utmp[4];
 3446:                double vtmp[4];
 3447:                for (int jj = 0; jj < elem->i34; jj++) {
 3448: 
 3449:                   const Node *node = elem->nodes[jj];
 3450: 
 3451:                   if constexpr(ics==1) {
 3452:                      utmp[jj] = node->u2[k].x;
 3453:                      vtmp[jj] = node->u2[k].y;  
 3454:                   } else {
 3455:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3456:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3457:                   }
 3458:                } // for jj
 3459: 
 3460:                const Vector2 grad_u = elem->grad2(utmp); 
 3461:                const Vector2 grad_v = elem->grad2(vtmp);
 3462: 
 3463:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3464:             } // for ii
 3465: 
 3466:             assert(icount > 0 && "Impossible 77");
 3467: 
 3468:             // '4' is somewhat arbitrary
 3469:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3470: 
 3471:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3472:          
 3473: 
 3474:             Vector3 u_int = {0.0, 0.0, 0.0};
 3475: 
 3476:             side->btrack(k, dt, dtbk, u_int);
 3477:             side->btu[k] = toVector2(u_int);
 3478:                
 3479:          } // if vmag (do backtrack)
 3480: 
 3481:       } // for j=jmin,nvrt-1
 3482: 
 3483:    }
 3484: } // extern "C"
 3485: 
 3486: template<int nc>
 3487: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3488: 
 3489: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3490: //
 3491: // a,b,c,rhs: input vectors and are not modified by this program.
 3492: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3493: // rhs is the r.h.s.
 3494: // n: actual rank of the system.
 3495: // rows in u() and rhs();
 3496: // u: output with nc columns (transposed to rows)
 3497: // gam: a working array.
 3498: //
 3499: // NOTES:
 3500: // This is a template function that allows for different numbers of columns in the rhs vector.
 3501: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3502: 
 3503:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3504:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3505: 
 3506:    double bet = b[0];
 3507:    if constexpr (nc == 1) {
 3508:       u[0] = rhs[0]/bet;
 3509:    } else {
 3510:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3511:    }
 3512: 
 3513:    for (int j = 1; j < n; j++) {
 3514:       gam[j] = c[j-1]/bet;
 3515:       bet = b[j] - a[j]*gam[j];
 3516: 
 3517:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3518: 
 3519:       if constexpr (nc == 1) {
 3520:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3521:       } else {
 3522:          for (int k = 0; k < nc; k++) {
 3523:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3524:          }
 3525:       }
 3526:    }
 3527: 
 3528:    // Back-substitution
 3529:    for (int j=n-1; j>=1; j--) {
 3530:       if constexpr (nc == 1) {
 3531:          u[j] = u[j] - gam[j+1]*u[j-1];
 3532:       } else {
 3533:          for (int k = 0; k < nc; k++) {
 3534:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3535:          }
 3536:       }
 3537:    }
 3538: }
 3539: 
 3540: 
 3541: 
 3542: // Helper function that contains the core algorithm
 3543: template<typename XAccessor, typename YAccessor>
 3544: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3545:                                     double  yp_top, double  yp_bot, 
 3546:                                     CubicSpline &spline) {
 3547:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3548:    // 
 3549:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3550:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3551:    //
 3552:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3553:    // 
 3554:    // Inputs: 
 3555:    //            n: dimension for x etc; # of data pts (>=2);
 3556:    //            getX, getY: functions to access x,y coordinates
 3557:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3558:    //     Output: 
 3559:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3560: 
 3561:    const int n = k2 - k1 + 1;
 3562:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3563: 
 3564:    // Allocate memory for the splines
 3565:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3566:    spline.x   = new double[n];
 3567:    spline.y   = new double[n];
 3568:    spline.yp  = new double[n];
 3569:    spline.ypp = new double[n];
 3570: 
 3571:    for (int k=k1; k<=k2; k++) {
 3572:       spline.x[k] = getX(k);
 3573:       spline.y[k] = getY(k);
 3574:    }
 3575: 
 3576:    // This is to simplify expressions later
 3577:    double *x = spline.x;
 3578:    double *y = spline.y;
 3579: 
 3580:    double *a = nullptr;
 3581:    double *b = nullptr;
 3582:    double *c = nullptr;
 3583:    double *gam = nullptr;
 3584:    double *rhs = nullptr;
 3585:    
 3586: 
 3587:       a = new double[n];   // Lower diagonal
 3588:       b = new double[n];   // Diagonal
 3589:       c = new double[n];   // Upper diagonal
 3590:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3591:       rhs = new double[n]; // Right-hand side
 3592: 
 3593:    for (int k=k1; k<=k2; k++) {
 3594:       if (k == k1) {
 3595:          // Bottom level
 3596:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3597:          b[k] = (x[k+1] - x[k])/3.0;
 3598:          c[k] = b[k]/2.0;
 3599:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3600:       } else if (k == n - 1) {
 3601:          // Top level (surface)
 3602:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3603:          b[k] = (x[k] - x[k-1])/3.0;
 3604:          a[k] = b[k]/2.0;
 3605:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3606:       } else {
 3607:          // Intermediate levels
 3608:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3609:          b[k] = (x[k+1] - x[k-1])/3.0;
 3610:          a[k] = (x[k  ] - x[k-1])/6.0;
 3611:          c[k] = (x[k+1] - x[k  ])/6.0;
 3612:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3613:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3614:       }
 3615:    }
 3616: 
 3617:    // Solve the tridiagonal system
 3618:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3619:    
 3620:    spline.yp[k1] = yp_bot;
 3621:    spline.yp[k2] = yp_top;
 3622: 
 3623:    // Compute rest of 1st derivatives using the splines
 3624:    for (int k=k1+1; k<k2; k++) {
 3625:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3626:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3627:    }
 3628:    
 3629:    delete[] a;
 3630:    delete[] b;
 3631:    delete[] c;
 3632:    delete[] gam;
 3633:    delete[] rhs;
 3634: 
 3635: }
 3636: 
 3637: // Array version
 3638: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3639:                                 double y_top, double y_bot, 
 3640:                                 CubicSpline &spline) {
 3641:    auto getX = [x] (int k) { return x[k]; };
 3642:    auto getY = [y] (int k) { return y[k]; };
 3643:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3644: }
 3645: 
 3646: // Lambda version - allows custom access patterns
 3647: template<typename XFunc, typename YFunc>
 3648: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3649:                                 double y_top, double y_bot,
 3650:                                 CubicSpline &spline) {
 3651:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3652: }
 3653: 
 3654: 
 3655: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3656: {
 3657:    assert("Not implemented");
 3658: 
 3659:    return 0.0;
 3660: }
