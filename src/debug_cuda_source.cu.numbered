  272: 
  273: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  274:     return v.x*w.x + v.y*w.y + v.z*w.z;
  275: }
  276: 
  277: __device__ __forceinline__ double norm2(const double3& v) {
  278:     return v.x*v.x + v.y*v.y + v.z*v.z;
