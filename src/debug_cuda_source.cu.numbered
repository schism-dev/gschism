 1806: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1807:                                               double &t, double& tIntersect) {
 1808: 
 1809:    double closest_intersect_t = 1e10;
 1810:    bool found_intersection = false;
 1811: 
 1812: double minDelta = 1e10; 
 1813: double btt1 = 1e10, btt2;
 1814:    for (int i = 0; i < i34; i++) {
 1815: 
 1816:       Side *side2 = sides[i];
 1817: 
 1818:       // (x3,y3)-(x4,y4) is the element side line
 1819:       const Point2 x3 = side2->n1->p2();
 1820:       const Point2 x4 = side2->n2->p2();
 1821: 
 1822:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1823:       const double delta = cross(x2 - x1, x3 - x4);
 1824: 
 1825:       if (abs(delta) > 0) {
 1826: 
 1827:          const double delta1 = cross(x3 - x1, x3 - x4);
 1828:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1829: 
 1830:          // Solves the two linear equations for tt1 and tt2
 1831:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1832:          const double tt2 = delta2/delta;
 1833: 
 1834: if (abs(tt1) < abs(btt1)) {
 1835:    minDelta = abs(delta);
 1836:    btt1 = tt1;
 1837:    btt2 = tt2;
 1838: }
 1839: 
 1840: if (idx == 0) printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1841:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1842:             closest_intersect_t = min(closest_intersect_t, tt1);
 1843:             side = side2;
 1844:             nextElement = side->otherElem(this);
 1845:             t = tt2;
 1846:             tIntersect = max(small, min(tt1, 1.0-small));
 1847:             found_intersection = true;
 1848:          }
 1849:       
 1850:       }
 1851:       else {  // parallel segments
 1852:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1853:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1854: 
 1855:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1856: 
 1857:          // const double dist = dot(x1 - x3, side2->n);
 1858:          // if (abs(dist) < small*length(x3 - x4)) {
 1859:          //    const double2 unitarySide = normalize(x4 - x3);
 1860:          //    const double len = dot(x2 - x1, unitarySide);
 1861:          //    t = t + len;
 1862:          //    t = max(0.0, min(t, 1.0));
 1863:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1864: 
 1865: 
 1866:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1867:          //    // t = tt2;
 1868:          //    found_intersection = true;
 1869:          // }
 1870:       }
 1871: 
 1872: 
 1873:    }
 1874: 
 1875:    if (!found_intersection) {
 1876:       
 1877: if (idx == 0) printf("ZZ No intersection found:\n"
 1878:            "Element %d\n"
 1879:            "in = %d\n"
 1880:            "minDelta = %e\n"
 1881:            "tt1 = %e, tt2 = %e\n"
 1882:            "segment: (%f, %f)-(%f, %f)\n"
 1883:            "Vertices:\n"
 1884:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1885:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1886:            IDX(nextElement),
 1887:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1888:            minDelta,
 1889:            btt1, btt2,
 1890:            x1.x, x1.y,
 1891:            x2.x, x2.y,
 1892:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1893:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1894:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1895:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1896:            nodes[0]->p.x, nodes[0]->p.y,
 1897:            nodes[1]->p.x, nodes[1]->p.y,
 1898:            nodes[2]->p.x, nodes[2]->p.y,
 1899:            nodes[0]->p.x, nodes[0]->p.y);
 1900: 
 1901:    }
 1902: 
 1903:    // assert(found_intersection && "No intersection found");
 1904: 
 1905:    // found_intersection should always be true, since we checked all the sides.  
 1906:    return found_intersection;
 1907: }
