 1495:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1496:       // Compute the different time ramps used in the code 
 1497:       // This function is performed by just one thread
 1498: 
 1499:       if constexpr(ibc == 0) {
 1500:          if (drampbc > 0.0) {
 1501:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1502:          } else {
 1503:             rampbc = 1.0;
 1504:          }
 1505: 
 1506:          if (nws != 0 && drampwind > 0.0) {
 1507:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1508:          } else {
 1509:             rampwind = 1.0;
 1510:          }
 1511:       }
 1512: 
 1513:       if (drampwafo > 0.0) {
 1514:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1515:       } else {
 1516:          rampwafo = 1.0;
 1517:       }
 1518: 
 1519:       // For source/sinks
 1520:       if (if_source && dramp_ss > 0.0) {
 1521:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1522:       } else {
 1523:          ramp_ss = 1.0;
 1524:       }
 1525: 
 1526:       if (dramp > 0.0) {
 1527:          ramp = tanh(2.0*time/86400.0/dramp);
 1528:       } else {
 1529:          ramp = 1.0;
 1530:       }
 1531: 
 1532:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1533:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1534:    }
 1535:       
 1536: 
 1537:    __global__ void computeBedDeformation(void) {
 1538:       printf("NOT IMPLEMENTED: computeBedDeformation\n");
 1539: 
 1540:    }
