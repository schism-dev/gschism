 4935: 
 4936:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4937: 
 4938:       SIDE(side);
 4939: 
 4940: 
 4941:       side->U = {0.0, 0.0}; 
 4942:          
 4943:       if(side->isDry) return;
 4944: 
 4945:       const Node *node1 = side->n1;
 4946:       const Node *node2 = side->n2;
 4947: 
 4948:       // Vertically integrated velocity U (in ll if ics=2)
 4949:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4950:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4951:       }
 4952: 
 4953:    }
 4954: 
 4955:    __global__ void computeBottomDragVegetation(void) {
 4956:       // UNFINISHED. CHECK THIS:
 4957:       // How many kernels are needed? Why so many for loops?
 4958:       // Is the loop on sides needed?
 4959: 
 4960:       NODE(node);
 4961: 
 4962: 
 4963:       const int    kb      = node->kb;
 4964:       const double htot    = node->htot2(); 
 4965:       const double rough   = node->rough;
 4966: 
 4967:       
 4968:       if (node->isDry) {
 4969:          // Default values for dry nodes
 4970:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4971:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4972: 
 4973:          return;
 4974:        
 4975:       }
 4976: 
 4977:       // Compute bottom drag Cd
 4978:       //--------------------------------
 4979: 
 4980:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4981:       if constexpr(nchi == 1) {
 4982: 
 4983:          bool ltmp = false; // for WBL iteration
 4984: 
 4985:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4986:          // Drag at nodes
 4987:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4988:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4989:         
 4990:          const double rough = node->rough;
 4991:         
 4992:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4993:          if (node->rough == 0.0) {
 4994:             node->Cd = 0.0;
 4995: 
 4996:          } else { //roughness >0 
 4997:           
 4998:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4999:             const double bthick = max(dzb_min, bthick_ori);
 5000: 
 5001:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 5002: 
 5003:             double tmp = 1.0/(2.5*log(bthick/rough));
 5004:             node->Cd = tmp*tmp;
 5005: 
 5006:          } // if rough
 5007: 
 5008: 
 5009:          // RECOVER THIS: XXX
 5010:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 5011:          // Output warning for WBL if iteration didn't converge
 5012: 
 5013: 
 5014:       } // nchi==1
 5015: 
 5016: 
 5017:       //   Bottom stress in m^2/s^2
 5018:       if (node->rho[kb + 1] >= -98.0)
 5019:       {
 5020:          const double mag_u = length(node->u2[kb + 1]);
 5021:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5022: 
 5023:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5024:          // !sediment erosion: this part needs more documentation
 5025:       }
 5026:     
 5027: 
 5028: 
 5029:       // Compute vegetation parameters
 5030:       //--------------------------------
 5031: 
 5032:       // SAV constants
 5033:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5034:       constexpr double veg_cfpsi = 0.16;
 5035: 
 5036:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5037:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5038: 
 5039:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5040:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5041:          int kbin = 0; // bin index
 5042:          for (int k = kb; k < nvrt; k++) {
 5043:             // Computes node height above the bottom level
 5044:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5045:             assert(false && "Vertical variation of vegetation not implemented");
 5046: 
 5047:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5048:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5049:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5050:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5051:             // } else {
 5052:             //    // Find the bin at which the current vertical level is
 5053:             //    while (kbin<nbins_veg_vert) {
 5054:             //       const double zn = node->z[kbin];
 5055:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5056:             //          break;
 5057:             //       } // if
 5058:             //       kbin++;
 5059:             //    } // while
 5060:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5061: 
 5062:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5063:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5064:                
 5065:             //    // Linear interpolation of the vegetation parameters
 5066:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5067:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5068:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5069:             // } // if rl10
 5070: 
 5071:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5072: 
 5073:          } // for k
 5074: 
 5075: 
 5076:       } else { // Ganthy (iveg==2)
 5077:       //  Modify canopy height, diameter, and density
 5078: 
 5079:          // Make sure there is vegetation on this node
 5080:          if (node->veg_h_unbent > 0.0) {
 5081:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5082: 
 5083:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5084:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5085:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5086: 
 5087:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5088:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5089:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5090:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5091:          } // if veg_h_unbent
 5092: 
 5093:          for (int k = 0; k < nvrt; k++) {
 5094:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5095:          } // for k
 5096:       
 5097: 
 5098:       } // if iveg
 5099:      
 5100: 
 5101:       // Compute vertical mean of veg_alpha3D
 5102:       if (iveg != 0) {
 5103:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5104:          double sum1=0.0;
 5105:          double sum2=0.0;
 5106:          // Integrate over each level under the canopy...
 5107:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5108:             const double Dz = node->Dz(k);
 5109: 
 5110:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5111:             sum2 += Dz;
 5112: 
 5113:          } // for k
 5114:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5115:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5116: 
 5117:       } // if iveg
 5118: 
 5119:    }
 5120: 
 5121:    __global__ void computeVegetationAndDragParameters(void) {
 5122:       // Computes the vegetation and drag model parameters:
 5123:       // chi, \tilde\chi, beta, \breve{H}
 5124:       
 5125:       SIDE(side);
 5126: 
 5127:       if (side->isDry) return;
 5128: 
 5129:       const double htot = side->htot2();
 5130:       const int    kb   = side->kb;
 5131: 
 5132:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5133: 
 5134:       const double veg_h     = side->veg_h();
 5135:       const double veg_nv    = side->veg_nv();
 5136:       const double veg_c     = side->veg_c();
 5137:       const double veg_beta  = side->veg_beta;
 5138:       const double veg_alpha = side->veg_alpha_vert_mean();
 5139: 
 5140:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5141:       // Velocity magnitude at the bottom level
 5142:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5143:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 5144:       side->chi2 = side->Cd()*vmag1;
 5145:       side->chi  = side->chi2;
 5146:       if constexpr(iveg != 0) {
 5147:          const Node *n1 = side->n1;
 5148:          const Node *n2 = side->n2;
 5149:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5150:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5151:       }
 5152: 
 5153:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5154: 
 5155:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5156:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5157:       double magUa = 0.0;
 5158:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5159:          // 3D wet side with veg...
 5160: 
 5161:          double magUa = 0.0;
 5162:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5163:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5164: 
 5165:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5166:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5167:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5168: 
 5169:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5170:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5171: 
 5172:                // Velocity magnitude at the bottom (l) of the level
 5173:                const double ul = length(side->u2[k]);
 5174: 
 5175:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5176:                magUa += Dz*0.5*(uh + ul);
 5177: 
 5178:             } // if HasVegetation
 5179:          } // for k
 5180:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5181: 
 5182:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5183:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5184:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5185:             const double zCpy = side->zTopCanopy();
 5186:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5187:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5188:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5189:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5190:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5191:          } // if isSubmerged
 5192:       } // if iveg   
 5193: 
 5194:       // Computes the friction modified depth, \breve{H} in notes
 5195:       if (side->is2D()) { // 2D
 5196: 
 5197:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5198:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5199: 
 5200:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5201: 
 5202:          side->hhat = htot*htot/fricH; 
 5203: 
 5204:       } else { // 3D
 5205:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 5206: 
 5207:          if constexpr(iveg != 0) {
 5208:             
 5209:             if (side->isSubmerged()) { 
 5210:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5211:                side->hhat -= veg_c*Hhat_alpha;
 5212: 
 5213:             } else { // Emergent
 5214:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5215:             }
 5216:          } // if iveg
 5217: 
 5218:          // Enforce positivity for 3D model
 5219:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 5220:       } // if 3D
 5221: 
 5222:    }
 5223: 
 5224: 
 5225: 
 5226:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5227:    // Computes the density gradient between two elements, e1 and e2.
 5228:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5229:    // zero in the direction normal to the side. 
 5230:    // 
 5231:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5232:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5233:    //
 5234:    // Input:
 5235:    //    e1: Element
 5236:    //    e2: Neighbor element (or nullptr if boundary)
 5237:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5238:    //    k: Index of the half-level at which the density is interpolated
 5239:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5240:    // 
 5241:    // Output:
 5242:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5243:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5244: 
 5245:       if (e2 == nullptr || e2->isDry) {
 5246:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5247: 
 5248:          Side *side = e1->sides[j];
 5249:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5250:                  
 5251:          if constexpr(ics == 1) {
 5252:             vec = side->n; // Normal vector to the side
 5253:          } else {
 5254:             // IMPLEMENT THIS XXXXXX
 5255:             // !replace with xel, yel?
 5256:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5257:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5258:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5259:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5260:          } //ics
 5261:                    
 5262:          diffRho = 0.0;
 5263: 
 5264:       } else { //internal and wet
 5265:          if constexpr(ics==1) {
 5266:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5267: 
 5268:             // Vector from e1 to e2
 5269:             vec = e2->center - e1->center;
 5270: 
 5271:          } else { 
 5272:             // IMPLEMENT THIS XXXXXX
 5273:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5274:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5275:             //                   alow(j)=xctr2
 5276:             //                   bdia(j)=yctr2
 5277:          } // ics
 5278: 
 5279:          diffRho = rho2 - e1->demeanedDensity(k);
 5280:       }
 5281: 
 5282:    }
 5283: 
 5284:    __global__ void computeDensityCubicSplines(void) {
 5285:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5286: 
 5287:       ELEM(elem);
 5288: 
 5289:       if (elem->isDry) return;
 5290: 
 5291:       const int kb = elem->kb;
 5292: 
 5293:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5294:       if (elem->is2D()) {
 5295:          // In the 2D case, the density is constant at the prism level. 
 5296:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5297:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5298:       } else { //3D
 5299: 
 5300:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5301:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5302:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5303:          ///// XXXX CHECK INDICES!!!!!
 5304:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5305:       } // 2D/3D
 5306: 
 5307:    }
 5308: } // extern "C"
 5309: 
 5310: 
 5311: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5312: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5313: 
 5314:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5315: 
 5316:    const int kb  = elem->kb;
 5317:    const int kb2 = elem2->kb;
 5318: 
 5319:    // z-coordinate of prism of elem
 5320:    const double zp = elem->z_prism(k);
 5321: 
 5322:    double rho = 0.0;
 5323: 
 5324:    if (elem2->is2D()) {
 5325:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5326: 
 5327:    } else {  // 3D
 5328: 
 5329:       // eta_min may be < zmax
 5330:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5331:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5332: 
 5333:       // (Extrapolate density below bottom, we will fix it later)
 5334:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5335:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5336:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5337:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5338:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5339:    } // 2D/3D
 5340:      
 5341: 
 5342:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5343:    // Now we need to fix it.
 5344:    if (elem->z[k] < elem2->z[kb2]) {
 5345:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5346: 
 5347:       // There are two methods to adjust the density at the bottom of the element.
 5348:       // iunder_deep=0: 
 5349:       const double depth1 = abs(elem->z[kb]); // larger depth
 5350: 
 5351:       if (iunder_deep==0) {
 5352: 
 5353:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5354: 
 5355:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5356: 
 5357:       } else { // iunder_deep != 0
 5358: 
 5359:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5360: 
 5361:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5362: 
 5363:          //   Demeaned density at the same z coordinate as
 5364:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5365:          }
 5366: 
 5367:       } // if iunder_deep
 5368:    } // if elem->z[kb] < elem2->z[kb]
 5369: 
 5370:    return rho;
 5371: }
 5372: 
 5373: 
 5374: extern "C" {
 5375:    __global__ void computeDensityGradient(void) {
 5376: 
 5377:       if constexpr(ibc != 0) return;
 5378: 
 5379:          // Compute the horizontal density gradient at each element.
 5380:       // It works in two steps:
 5381:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5382:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5383:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5384:       //             gradRho.r1 = rho1 - rho0
 5385:       //             gradRho.r2 = rho2 - rho0
 5386:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5387:       // 
 5388:       //  NOTE: We use de-meaned densities.
 5389: 
 5390:       ELEM(elem);
 5391: 
 5392:       if (elem->isDry) return;
 5393: 
 5394:       const int kb  = elem->kb;
 5395:       const int i34 = elem->i34;
 5396: 
 5397:       for (int k = kb + 1; k < nvrt; k++) {
 5398:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5399:          //             gradRho.r1 = rho1 - rho0
 5400:          //             gradRho.r2 = rho2 - rho0
 5401:          int icount = 0;
 5402:          double sumRx = 0.0;
 5403:          double sumRy = 0.0;
 5404:          for (int j1=0; j1<i34; j1++) { 
 5405: 
 5406:             const int j2 = elem->nxq(j1 + 1);
 5407: 
 5408:             // Pairs of consecutive neighbor elements of elem
 5409:             const Element *e1 = elem->nghbElems[j1];
 5410:             const Element *e2 = elem->nghbElems[j2];
 5411: 
 5412:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5413:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5414:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5415: if (elem->idx == 21) printf("$$AAAXXXXXXXA$$$ rho1 = %.16f, rho2 = %.16f\n", rho1, rho2);            
 5416: 
 5417:             // Compute the density difference and the vector from elem to e1 and e2
 5418:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5419:             double diffRho1, diffRho2;
 5420:             Vector2 vec1, vec2;
 5421:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5422:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5423: 
 5424:             const double rl1 = length(vec1);
 5425:             const double rl2 = length(vec2);
 5426:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5427: 
 5428:             const double delta = cross(vec1, vec2);
 5429:             const double sintheta = abs(delta)/(rl1*rl2);
 5430: 
 5431:             // To avoid problems, avoid elements with small angle between vectors
 5432:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5433:             const bool validEq = (sintheta > sin_one_deg);
 5434: 
 5435:             if (validEq) {
 5436:                // Solve the system of equations to get the density gradient at elem
 5437:                icount++;
 5438:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5439:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5440:                sumRx += Rx;
 5441:                sumRy += Ry;
 5442:             }
 5443:          } // for j1
 5444: 
 5445:          // Compute the average density gradient at elem
 5446:          if (icount==0) {
 5447:            // Bad mesh quality; bail out with 0 b-cc
 5448:            elem->gradRho[k] = {0.0, 0.0};
 5449:          } else {
 5450:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5451:          }
 5452: 
 5453:       } // for k
 5454: 
 5455:    }
 5456: 
 5457:    __global__ void computeBaroclinicTerm(void) {
 5458:    // Computes the baroclinic term at sides (at half levels).
 5459:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5460:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5461: 
 5462:       if (ibc == 1) return;
 5463: 
 5464:       SIDE(side);
 5465: 
 5466:       if (side->isDry) return;
 5467: 
 5468:       const Element *e1 = side->elems[0];
 5469:       const Element *e2 = side->elems[1];      
 5470:       const int kb = side->kb;
 5471:       
 5472:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5473: 
 5474:       // interpolates vertically the density gradient of the two elements at the half level/
 5475: 
 5476:       int k1 = max(kb, nvrt / 2);
 5477:       int k2 = max(kb, nvrt / 2);
 5478: 
 5479:       // Starts the integration at the surface and goes down to the bottom
 5480:       side->bcc[nvrt-1] = {0.0, 0.0};
 5481:       for (int k = nvrt - 2; k >= kb; k--) {
 5482:       // For each prism level (from surface to bottom)...
 5483: 
 5484:          // For both elements, interpolate density gradient at the side's half level.
 5485:          // The gradient at the side is the average of the gradients at the elements.
 5486:          // w1, w2 are used to take into account boundary sides, with just one element.
 5487:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5488:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5489:          const double wsum = w1 + w2;
 5490:          w1 = w1/wsum;
 5491:          w2 = w2/wsum;
 5492:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5493: 
 5494:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5495:          Vector2 gradRho = {0.0, 0.0};
 5496:          if (e1 != nullptr && k > kb) {
 5497:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5498:             
 5499:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5500:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5501:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5502: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5503:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5504:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5505:          }      
 5506:          if (e2 != nullptr && k > kb) {
 5507:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5508:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5509:             
 5510:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5511:          }
 5512: 
 5513:          if constexpr(ics==2) {
 5514:             assert(false && "Not implemented: ics == 2");
 5515:             // IMPLEMENT THIS XXXXXX
 5516:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5517:             // swild(1)=tmp1
 5518:             // swild(2)=tmp2
 5519:          }
 5520:          
 5521:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5522:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5523:          // CHECK INDICES!!! XXX
 5524:          const double grav3 = side->grav3();
 5525:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5526: 
 5527:       } // for
 5528: 
 5529:    }
 5530: 
 5531: 
 5532: 
 5533:    __global__ void computeHorGradientAtSide(void) {
 5534: 
 5535:       // Compute the horizontal density gradient at each element.
 5536:       // It works in two steps:
 5537:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5538:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5539:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5540:       //             gradRho.r1 = rho1 - rho0
 5541:       //             gradRho.r2 = rho2 - rho0
 5542:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5543:       // 
 5544:       //  NOTE: We use de-meaned densities.
 5545: 
 5546:       SIDE(side);
 5547: 
 5548: // printf("side->isDry: %d\n", side->isDry);
 5549:       if (side->isDry) return;
 5550: 
 5551:       // Computes the gradient of the variables at the side center.
 5552:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5553:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5554:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5555: 
 5556:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5557:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5558:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5559:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5560: 
 5561: 
 5562:    }
 5563: 
 5564: 
 5565:    __global__ void solveMomentumEquations(double time) {
 5566: 
 5567:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5568:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5569: 
 5570:       SIDE(side);
 5571: 
 5572:       if (side->isDry) 
 5573:       {
 5574:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5575: 
 5576:          return;
 5577:       }
 5578: 
 5579:       const Node *n1 = side->n1;
 5580:       const Node *n2 = side->n2;
 5581: 
 5582:       const int kb = side->kb;
 5583: 
 5584:       const double veg_h = side->veg_h();
 5585:       const double grav3 = side->grav3();
 5586: 
 5587:       if (side->is2D()) {
 5588:          // Warning: Do not use htot2, which is updated.
 5589:          const double htot = side->htot1();
 5590:          const double hhat = side->hhat;
 5591: 
 5592:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5593: 
 5594:          Vector2 tau2 = {0.0, 0.0};
 5595:           
 5596:          if constexpr(ics==1) {
 5597:             tau2 = side->tau();
 5598: 
 5599:          } else {
 5600:             assert(false && "Not implemented: ics == 2");
 5601:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5602:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5603:             // taux2=(vn1+tt1)*0.5d0
 5604:             // tauy2=(vn2+ss1)*0.5d0
 5605:          } // if ics         
 5606: 
 5607:          // hat_gam has units of m/s
 5608: 
 5609:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5610: 
 5611:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5612:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5613: 
 5614:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5615: 
 5616: 
 5617:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5618:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5619: 
 5620:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5621: 
 5622: 
 5623:       }
 5624:       else { // 3D
 5625: 
 5626:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5627:          // 
 5628:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5629:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5630:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5631:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5632:          // k+1 and k.
 5633: 
 5634: 
 5635:    
 5636: 
 5637: 
 5638:          const int ndim = nvrt - kb;
 5639:          const double zTopCanopy = side->zTopCanopy();
 5640: 
 5641:          // Initialize the tridiagonal system
 5642:          for (int k = kb + 1; k < nvrt; k++) {
 5643:             
 5644:             const int kin = k - (kb + 1);
 5645: 
 5646:             // Vertical viscosity at the face center
 5647:             const double dfz = 1e-6; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5648:            
 5649: 
 5650:             alow[kin] = 0.0;
 5651:             cupp[kin] = 0.0;
 5652:             bdia[kin] = 0.0;
 5653: 
 5654:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5655:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5656: 
 5657:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5658:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5659:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5660: 
 5661:             // First part: layers k, k+1
 5662:             if (k < nvrt - 1) {
 5663:                              
 5664:                if constexpr(iveg != 0) {
 5665: 
 5666:                   // If there is vegetation at this level...
 5667:                   if (zTopCanopy > side->zc[k]) {
 5668:                      // If the canopy is above the k layer...
 5669:                      
 5670:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5671:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5672:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5673:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5674: 
 5675:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5676:                      const double vmag2 = length(ut2);
 5677:                      const double vmag1 = length(side->u2[k]);
 5678:                      const double vmag = 0.5*(vmag1 + vmag2);
 5679:                      
 5680:                      // Computes the vegetation alpha at the face center
 5681:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5682: 
 5683:                      cff1 += veg_alpha_sd*dt*vmag;
 5684: 
 5685:                   } // if (zTopCanopy
 5686:                } // if iveg
 5687: 
 5688:                const double dzz = side->Dz(k + 1);
 5689:                const double tmp = dt*dfz/dzz;
 5690:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5691: 
 5692:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5693:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5694:             }
 5695: 
 5696: 
 5697:             // Second part: layers k-1, k
 5698:             if (k > kb + 1) {
 5699: 
 5700:                double cff1 = 1.0; //init \bar{c^k}
 5701: 
 5702:                if constexpr(iveg != 0) {
 5703:                   // If there is vegetation at this level...
 5704:                   if (zTopCanopy > side->zc[k-1]) {
 5705:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5706:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5707: 
 5708:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5709: 
 5710:                      const double vmag2 = length(ut2);
 5711:                      const double vmag1 = length(side->u2[k-1]);
 5712:                      const double vmag = 0.5*(vmag1 + vmag2);
 5713: 
 5714:                      // Computes the vegetation alpha at the face center
 5715:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5716:                      cff1 += veg_alpha_sd*dt*vmag;
 5717:                   } // if zTopCanopy
 5718: 
 5719:                } // if iveg
 5720: 
 5721:                const double dzz = side->Dz(k);
 5722:                const double tmp = dt*dfz/dzz;
 5723:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5724: 
 5725:                alow[kin] += cff1*dzz/6.0 - tmp;
 5726:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5727: 
 5728:             } else { // Bottom boundary
 5729:                // This occurs at the bottom, where the bottom drag is applied.
 5730: 
 5731:                bdia[kin] += dt*side->chi2; // XXXX
 5732: 
 5733: 
 5734:             } // if (k > kb + 1)
 5735: 
 5736: 
 5737: 
 5738:          } // for (int k
 5739: 
 5740: 
 5741: 
 5742:          // Computes the RHS.
 5743:          // -----------------
 5744: 
 5745:          //	BC to be imposed at the end.
 5746: 
 5747:          const Vector2 gradETP  = side->gradETP;
 5748:          const Vector2 gradPr   = side->gradPr;
 5749:          const Vector2 gradEta1 = side->gradEta1;
 5750:          const Vector2 gradEta2 = side->gradEta2;
 5751: 
 5752:          const Vector2 *btu = side->btu;
 5753:          const Vector2 *u2  = side->u2;
 5754:          const double coriolis = side->coriolis;
 5755:          const Vector2 *nuGradU = side->nuGradU;
 5756: 
 5757: 
 5758:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5759: 
 5760:          for (int k = kb + 1; k < nvrt; k++) {
 5761:             const int kin = k - kb - 1;
 5762: 
 5763:             const double dz_0 = side->Dz(k);
 5764:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5765: 
 5766:             rrhs[kin] = {0.0, 0.0};
 5767:             double dz = 0.0;
 5768: 
 5769:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5770:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5771:             if (k < nvrt  ) dz += dz_1;
 5772:             if (k > kb + 1) dz += dz_0;
 5773: 
 5774:             // Elevation gradient, atmospheric pressure and tidal potential
 5775:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5776: 
 5777:             // Coriolis, advection, wind stress, and horizontal viscosity
 5778:             if (k < nvrt - 1) {
 5779: 
 5780: 
 5781:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5782:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5783:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5784:                                                 
 5785: // if (side->idx == 21) printf("$$BBBB$$$ dz_1 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_1, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5786:                //diff stress tensors 1006
 5787:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5788:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5789:                   assert(false && "Not implemented: itur == 5");
 5790:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5791:                }
 5792: 
 5793:             } else { // k == nvrt - 1 SURFACE
 5794:                Vector2 tau2 = {0.0, 0.0};
 5795:                if constexpr(ics==1) {
 5796:                   tau2 = side->tau();
 5797:       
 5798:                } else {
 5799:                   assert(false && "Not implemented: ics == 2");
 5800:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5801:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5802:                   // taux2=(vn1+tt1)*0.5d0
 5803:                   // tauy2=(vn2+ss1)*0.5d0
 5804:                } // if ics
 5805: 
 5806:                rrhs[kin] += dt*tau2;
 5807: 
 5808:             } // if k<nvrt
 5809: 
 5810:             if (k > kb + 1) {
 5811:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5812:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5813:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5814: 
 5815:                // diff stress tensors 1006
 5816:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5817:                   assert(false && "Not implemented: itur == 5");
 5818:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5819:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5820:                }
 5821: 
 5822:             } // if k>kbs + 1
 5823: 
 5824:             // Baroclinic
 5825:             Vector2 *bcc = side->bcc;
 5826:             if constexpr(ibc == 0) {
 5827:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5828:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5829: 
 5830:             } // if ibc==0
 5831: 
 5832:          } // k=kb + 1,nvrt
 5833: 
 5834: 
 5835:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5836: 
 5837:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5838:             const int kin = k - kb - 1;
 5839: 
 5840:             // Velocity is always clamped to maximum values
 5841:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5842:          } // k
 5843: 
 5844:       } // if side->is2D()
 5845:       
 5846: 
 5847:       // Impose velocity boundary condition at the bottom
 5848:       if constexpr(imm == 2) { // 3D bed deformation model
 5849:          double dep;
 5850:          Vector2 vel;
 5851: 
 5852:          assert(false && "Not implemented: imm == 2");
 5853:          //update_bdef(time, x0, y0, dep, vel);
 5854:          // side->u2[kb] = vel;
 5855: 
 5856:       } else { // imm = 0 or 1
 5857:          if (side->Cd() == 0.0) {
 5858:             side->u2[kb] = side->u2[kb + 1];
 5859: 
 5860:          } else if (side->is3D()) { // 3D no slip bottom   
 5861:             side->u2[kb] = {0.0, 0.0};
 5862:          }
 5863:           
 5864:       } // if imm
 5865: 
 5866:       // The velocities below the bottom level are set to zero
 5867:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5868: 
 5869: 
 5870:    }
 5871: 
 5872: 
 5873:    __global__ void applyMomentumBC(void) {
 5874: 
 5875:       SIDE_BND(sideBnd);
 5876: 
 5877:       Side *side = sideBnd->side;
 5878:       const BoundarySegment *segment = sideBnd->segment;
 5879:       const Node *n1 = side->n1;
 5880:       const Node *n2 = side->n2;
 5881: 
 5882:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5883: 
 5884:       const bool isLand = segment->isLand;
 5885:       const int ifltype = segment->ifltype;
 5886: 
 5887:       const int kb = side->kb;
 5888: 
 5889:       if (!isLand && ifltype != 0) {
 5890:          const Vector2 *ubc = sideBnd->ubc;
 5891:   
 5892:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5893:             
 5894:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5895:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5896: 
 5897:             if (ifltype == -1) {
 5898:                // Flather 1
 5899: 
 5900:                const double depth = side->depth();
 5901: 
 5902:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5903: 
 5904:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5905: 
 5906:                side->u2[k] = vnorm*side->n;
 5907: 
 5908:             } else if (ifltype == -2) { // Discharge
 5909: 
 5910:                const double eta1 = side->eta1();
 5911:                const double eta2 = side->eta2();
 5912:                const double htot = side->htot2();
 5913: 
 5914:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5915:                assert(false && "Not implemented: Discharge bc");
 5916:                // const double dischrg = discharge(eta1);
 5917:                const double dischrg = 0.0; // XXX REMOVE
 5918:                
 5919: 
 5920:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5921: 
 5922:                const double vnorm = dischrg*eta2/htot;
 5923: 
 5924:                side->u2[k] = vnorm*side->n;
 5925: 
 5926:             }
 5927:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5928:                const double vnorm = dot(side->u2[k], side->n);
 5929: 
 5930:                double rat;
 5931:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5932:                else              rat = segment->vobc2; // outgoing
 5933: 
 5934:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5935: 
 5936:             }
 5937:             else { // not Flather or 3D radiation
 5938:                side->u2[k] = ubc[k];
 5939: 
 5940:             } // if (segment->ifltype...
 5941: 
 5942:          }
 5943: 
 5944:       }
 5945:       else if (isLand) { // if it is land boundary side
 5946: 
 5947:          if constexpr(islip == 0) { // free slip
 5948: 
 5949:             for (int k = kb; k < nvrt; k++) {
 5950: 
 5951:                const Vector2 t = side->t();
 5952:                const Vector2 n = side->n;
 5953: 
 5954:                double vnorm = 0.0; // for most cases
 5955:                const double vtan = dot(side->u2[k], t);
 5956:                
 5957:                side->u2[k] = vtan*t - vnorm*n;
 5958: 
 5959:             }
 5960: 
 5961:          } else { // no slip
 5962:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5963: 
 5964:          }
 5965:       } // if (side segment type...
 5966: 
 5967:    
 5968: 
 5969:    }
 5970: 
 5971: 
 5972:    __global__ void shapiroFilter1(void) {
 5973:       // First step of the Shapiro filter (normally used if indvel<=0)
 5974:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5975: 
 5976:       SIDE(side);
 5977: 
 5978:       // Only internal wet sides are processed
 5979:       if (side->isDry || !(side->isInternal())) return;
 5980: 
 5981:       const int kb = side->kb;
 5982: 
 5983:       for (int mm = 0; mm < niter_shap; mm++) {
 5984: 
 5985:          for (int k = kb + 1; k < nvrt; k++) {
 5986:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5987:             Vector2 suru = {0.0, 0.0};
 5988: 
 5989:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5990: 
 5991:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5992: 
 5993:                int kin = k;
 5994:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5995:                
 5996:                if constexpr(ics==1) {
 5997:                   suru += nSide->u2[kin];
 5998: 
 5999:                } else {
 6000:                   assert(false && "Not implemented: ics == 2");
 6001:                   // Vector2 vn1, vn2;
 6002:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 6003:                   // suru=suru+vn1;
 6004:                   // surv=surv+vn2;
 6005:                }
 6006:             }
 6007: 
 6008: 
 6009:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 6010: 
 6011:          }
 6012:       }
 6013:    }
 6014: 
 6015:    __global__ void shapiroFilter2(void) {
 6016:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6017: 
 6018:       SIDE(side);
 6019: 
 6020:       if (side->isDry || !(side->isInternal())) return;
 6021: 
 6022:       const int kb = side->kb;
 6023: 
 6024:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6025: 
 6026:       if (side->is2D()) {
 6027:          side->u2[kb + 1] = side->bcc[kb + 1];
 6028:          side->u2[kb    ] = side->u2 [nvrt - 1];
 6029: 
 6030:       } else {
 6031:          // 3D
 6032:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6033:          
 6034:       }
 6035: 
 6036:    }
 6037: 
 6038: 
 6039:    __global__ void ul0UpdateZCoords(void) {
 6040:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6041:       
 6042:       NODE(node);      
 6043: 
 6044: 
 6045:       if (node->isDry2()) { 
 6046: 
 6047:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6048: 
 6049:          if constexpr(ivcor != 1) node->kb = 0;
 6050: 
 6051:       } else {
 6052: 
 6053:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6054:          node->updateKb();
 6055: 
 6056:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6057: 
 6058:       }
 6059: 
 6060:       // We use the temp.b field to store the previous state of isDry.
 6061:       node->tmp.b = node->isDry;
 6062: 
 6063:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6064:       node->isDry = true;
 6065: 
 6066:    }
 6067: 
 6068:    __global__ void ul0ComputeDryElementsAndNodes(void)
 6069:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 6070:    {
 6071:       ELEM(elem);
 6072: 
 6073:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 6074: 
 6075:       // All the nodes of a wet element are wet.
 6076:       if (!elem->isDry) {
 6077:          elem->nodes[0]->isDry = false;
 6078:          elem->nodes[1]->isDry = false;
 6079:          elem->nodes[2]->isDry = false;
 6080:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 6081: 
 6082:       }
 6083: 
 6084: 
 6085:       elem->kb = 0;
 6086: 
 6087:       if (elem->isDry) return;
 6088: 
 6089:       // Wet
 6090:       const Node *n1 = elem->nodes[0];
 6091:       const Node *n2 = elem->nodes[1];
 6092:       const Node *n3 = elem->nodes[2];  
 6093:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 6094: 
 6095:    //    if(elem->isDry2()) { // XXXX
 6096:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6097:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6098:    //        call parallel_abort(errmsg)
 6099:    //    }
 6100: 
 6101: 
 6102:       // Computes element's kb as the minimum of the nodes' kb.
 6103:       const int kb1 = n1->kb;
 6104:       const int kb2 = n2->kb;
 6105:       const int kb3 = n3->kb;
 6106:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6107: 
 6108: 
 6109:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6110: 
 6111: 
 6112:       // Computes the element z as the mean of the nodes z.
 6113:       for (int k = elem->kb; k < nvrt; k++) {
 6114: 
 6115:          // Compute the element z as the mean of the nodes z.
 6116:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 6117:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6118:          elem->z[k] /= elem->i34;
 6119: 
 6120:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6121:       }
 6122:                   
 6123:    }
 6124: 
 6125:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6126:    {
 6127:       NODE(node);
 6128:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6129: 
 6130:       if (it == iths) return;
 6131: 
 6132: 
 6133:       if(!node->isDry && node->tmp.b) { // rewetted
 6134:          for (int k=0; k < nvrt; k++) {
 6135: 
 6136:             Vector3 utmp={0.0, 0.0, 0.0};
 6137: 
 6138:             double ttmp=0.0;
 6139:             double stmp=0.0;
 6140:             int icount=0;
 6141:             for (int j = 0; j < node->numNodes; j++) {
 6142: 
 6143: 
 6144:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 6145:                if (!node->isDry) { // all indices extended
 6146:                   icount++;
 6147: 
 6148:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6149:                   utmp += node->uvw2(k);
 6150:                   
 6151:                   ttmp += node->tracers[k].tracer[0]; 
 6152:                   stmp += node->tracers[k].tracer[1]; 
 6153:                }
 6154:             }
 6155: 
 6156:             if(icount > 0) {
 6157:                const double inv_icount = 1.0/icount;
 6158:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 6159:                node->w2[k]     = inv_icount*utmp.z;
 6160:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6161:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6162:             }
 6163:          }
 6164:       }
 6165:    }
 6166: 
 6167: 
 6168:    __global__ void ul0UpdateSides(int it, int iths) {
 6169: 
 6170:       SIDE(side);
 6171: 
 6172:       // A side is wet if and only if at least one of its elements is wet.
 6173:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6174: 
 6175:       const Node *n1 = side->n1;
 6176:       const Node *n2 = side->n2;
 6177:       const int kb1 = n1->kb;
 6178:       const int kb2 = n2->kb;
 6179: 
 6180:       side->kb = 0; // dry
 6181: 
 6182:       if (isWet) {
 6183: 
 6184:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6185: 
 6186:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6187: 
 6188:          side->kb = min(kb1, kb2);
 6189: 
 6190:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6191: 
 6192:          for (int k = side->kb; k < nvrt; k++) {
 6193:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6194: 
 6195:          
 6196:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 6197: 
 6198:             // Compute velocity for re-wetted sides 
 6199:             if ((it != iths) && (side->isDry && isWet)) {
 6200:             
 6201:                Vector2 utmp={0.0, 0.0};
 6202: 
 6203:                int icount=0;
 6204: 
 6205:                // For all the sides on the two elements that share this side
 6206:                for (int j=0; j < 2; j++) {
 6207:                   const Element *elem = side->elems[j];
 6208:                   if (elem == nullptr) continue;
 6209: 
 6210:                   for (int jj=0; jj < elem->i34; jj++) {
 6211:                      const Side *nSide = elem->sides[jj];
 6212:                      if (nSide->isDry) continue;
 6213: 
 6214:                      icount++;
 6215:                      utmp += nSide->u2[k];                     
 6216:                   }
 6217:                }
 6218:                   
 6219:                assert(icount > 0 && "No wet sides around this side");
 6220:                if (icount > 0)  side->u2[k] = utmp/icount;
 6221:                   
 6222:             } // if ((it != iths) && (side->isDry && isWet))
 6223: 
 6224:          } // for k
 6225: 
 6226:       } // if isWet
 6227:    
 6228:       side->isDry = !isWet;
 6229: 
 6230:    }
 6231: 
 6232: 
 6233:    __global__ void zeroNodalVelocities(void) {
 6234:       NODE(node);
 6235: 
 6236:       for (int k = 0; k < nvrt; k++) {
 6237:          node->u2[k]   = {0.0, 0.0};
 6238:          node->w2[k]   = 0.0;
 6239:          node->utmp[k] = {0.0, 0.0};
 6240:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6241:       }
 6242:    }
 6243: 
 6244:  
 6245: 
 6246:    __global__ void computeNodalVerticalVelocities1(void) {
 6247:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6248:    // Adds the element's vertical velocity times the element's area.
 6249:       ELEM(elem);
 6250: 
 6251:       for (int j = 0; j < elem->i34; j++) {
 6252:          Node *node = elem->nodes[j];
 6253: 
 6254:          for (int k = node->kb; k < nvrt; k++) {
 6255:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6256:          }
 6257:          atomicAdd(&(node->tmp.d), elem->area);
 6258:       }
 6259:    }
 6260: 
 6261:    __global__ void computeNodalVerticalVelocities2(void) {
 6262:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6263:    // Divides by the total area of the elements sharing the    node.
 6264:       NODE(node);
 6265: 
 6266:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6267:    }
 6268: 
 6269: 
 6270:    __global__ void computeNodalHorizontalVelocities1(void) {
 6271:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6272:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6273: 
 6274:       ELEM(elem);
 6275: 
 6276:       const int kb = elem->kb;
 6277:       const bool isTri = elem->isTri();
 6278: 
 6279:       if constexpr(indvel <= 0) {
 6280:          // Assuming discontinoius hvel.
 6281: 
 6282: 
 6283:          if (isTri) { // For triangles
 6284:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6285:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6286: 
 6287:             for (int j = 0; j < 3; j++) {
 6288:                // For every node of the triangle...
 6289:                Node *node = elem->nodes[j];
 6290: 
 6291:                const Side *s1 = elem->sides[j];
 6292:                const Side *s2 = elem->sides[(j + 1) % 3];
 6293:                const Side *s3 = elem->sides[(j + 2) % 3];
 6294: 
 6295:                const int numElements = node->numElements;
 6296:                const double inv_numElements = 1.0/numElements;
 6297: 
 6298:                for (int k = kb; k < nvrt; k++)  {
 6299:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6300:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6301:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6302:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6303:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6304:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6305: 
 6306:                }
 6307: 
 6308:             }
 6309:          }
 6310:          else { // For quads
 6311:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6312: 
 6313:          }
 6314: 
 6315:       }
 6316:       
 6317:    }
 6318: 
 6319: 
 6320:    __global__ void computeNodalHorizontalVelocities2(void) {
 6321:       NODE(node);
 6322: 
 6323:       for (int k = 0; k < nvrt; k++) {
 6324:          node->u2[k] = node->utmp[k];
 6325:          node->w2[k] = node->w2[k];
 6326:       }
 6327:       
 6328:    }   
 6329: 
 6330:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6331:    // XXXX I'm not sure where I got this function from. 
 6332:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6333:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6334:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6335:    // It uses the utmp array as a temporary array to store the velocities.
 6336: 
 6337:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6338: 
 6339:       SIDE(side);
 6340: 
 6341:       const int kb = side->kb;
 6342: 
 6343:       Node *n1 = side->n1;
 6344:       Node *n2 = side->n2;
 6345: 
 6346:       for (int k = kb; k < nvrt; k++) {
 6347: 
 6348:          // Cast the u2 vector into a Vector2 
 6349:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6350:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6351: 
 6352:          n1_u2 = side->u2[k]/n1->numSides;
 6353:          n2_u2 = side->u2[k]/n2->numSides;
 6354: 
 6355:       }
 6356: 
 6357: 
 6358:    }
 6359: 
 6360:    __global__ void resetVelocityOpenBndNodes(void) {
 6361:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6362: 
 6363:       NODE_BND(nodebnd);
 6364: 
 6365:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6366:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6367:       }
 6368: 
 6369:    }
 6370: 
 6371: 
 6372:    __global__ void setVelocityOpenBndNodes(void) {
 6373:    // For open boundary nodes sets their velocity to the imposed values.
 6374: 
 6375:       SIDE_BND(sidebnd);
 6376: 
 6377:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6378:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6379:          // to its segment to the average of the side velocity.
 6380: 
 6381:          for (int k = 0; k < nvrt; k++) {
 6382:             Node *n1 = sidebnd->side->n1;
 6383:             Node *n2 = sidebnd->side->n2;
 6384: 
 6385: 
 6386:             Vector2 n1_u2(n1->u2[k]);
 6387:             Vector2 n2_u2(n2->u2[k]);
 6388: 
 6389:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6390:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6391:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6392:             }
 6393:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6394:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6395:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6396:             }
 6397: 
 6398:          }
 6399: 
 6400:       }
 6401: 
 6402:    }
 6403: 
 6404: 
 6405:    __global__ void computeVerticalVelocity(void) {
 6406:       // Computes the vertical velocity at the (2D) element's centroid.
 6407:       // In this function we will be considering volumetric elements, with side faces and a 
 6408:       // bottom and a top face. We will call them SFs, BF and TF.
 6409:       // It computes the flux coming from BF and the SFs.
 6410:       // If the bed is moving, it takes that into account.
 6411:       // Since water is incompressible, the integral of the velocity times the normal vector
 6412:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6413:       // and the BF is equal to the flux going out from the TF.
 6414:       // TF = - BF - sum(SFs).
 6415:       // It then computes the horizontal velocity at the center of TF.
 6416:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6417:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6418:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6419: 
 6420:       ELEM(elem);
 6421: 
 6422:       if (elem->isDry) return;
 6423: 
 6424:       const int kb = elem->kb;
 6425:       const bool isTri = elem->isTri();
 6426: 
 6427:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6428: 
 6429:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6430:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6431:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6432: 
 6433:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6434: 
 6435:       double area3D;
 6436: 
 6437:       // Bottom face flux
 6438:       double bottomFlux = 0.0;
 6439:       Vector2 u2meanBottom = {0.0, 0.0};
 6440:       const Vector2 gradh = elem->grad2(&Node::depth);
 6441:       if constexpr(imm==2) {
 6442:          Vector3 ubed;
 6443: 
 6444:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6445:          // updateBDEF(ubed);
 6446:      
 6447:          // const double bflux0 = dot(ubed, elem_n1);
 6448: 
 6449:          // elem->w[kb] += ubed.z;
 6450:       }
 6451:       else {
 6452:          Vector2 umean;
 6453:          if constexpr(ics == 1) {
 6454:             u2meanBottom = elem->mean(kb, &Side::u2);
 6455:          }
 6456:          else {
 6457:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6458:          }
 6459: 
 6460:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6461:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6462: 
 6463:          bottomFlux = - dot(gradh, u2meanBottom);
 6464:       } // if imm
 6465: 
 6466:       // Compute w for kb+1 to nvrt-1
 6467:       for (int l = kb; l < nvrt - 1; l++) {
 6468: 
 6469:          // normal vector to the top face of the "volumetric" element (3D)
 6470:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6471: 
 6472:          // Compute the total flux at the sides
 6473:          double sideFlux = 0.0;
 6474:          Vector2 u2top = {0.0, 0.0};
 6475:          for (int j = 0; j < elem->i34; j++) {
 6476:             const Side *side = elem->sides[j];
 6477: 
 6478:             const double sideArea = side->area(l);
 6479:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6480:             const double sign = elem->ssign[j]; 
 6481: 
 6482:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6483:          }
 6484:          
 6485:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6486:          //velocities at the centers of the sides
 6487:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6488: 
 6489:          // The flx at the top ace can be computed from the other flows.
 6490:          const double topFlux = - sideFlux - bottomFlux;
 6491:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6492: 
 6493:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6494: 
 6495:          elem_n1 = elem_n2;
 6496: 
 6497:          bottomFlux = - topFlux;
 6498:       }
 6499:    }  
 6500: 
