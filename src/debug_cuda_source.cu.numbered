 9065: 
 9066: 
 9067: 
 9068: 
 9069:    // // Mark prisms (shallow enough or marked as such in tvd.prop) that will be computed using first-order upwind formulation.
 9070:    // elem->computeUse1stOrderUpwind();
 9071: 
 9072: 
 9073: 
 9074:    // // Init horizontal mass influx (m^3*concentration) for conservation 
 9075:    // h_mass_in(1:ntr)=0 !positive in
 9076: 
