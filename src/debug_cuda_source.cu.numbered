 7342: //               endif
 7343: 
 7344: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7345: //               do j=1,i34(i)
 7346: //                 jsj=elside(j,i) !side
 7347: //                 iweno=.true. !use weno reconstruction as default
 7348: //                 iel=ic3(j,i) !neighboring elem
 7349: 
 7350: //                 if(iel/=0) then
