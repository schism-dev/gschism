 3694:    __global__ void computeElevationBoundaryConditions(double time) {
 3695:       // Compute elevation essential boundary conditions 
 3696: 
 3697:       NODE_BND(nodeBnd); // Each boundary node.
 3698: 
 3699:       const Node *node = nodeBnd->node;
 3700:       const int iettype = nodeBnd->iettype;
 3701: 
 3702:       double eic = 0.0;
 3703:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3704:       else               eic = 0.0;
 3705: 
 3706:       const double r_eic = (1.0 - ramp)*eic; 
 3707:       const double r_eth = ramp*nodeBnd->eth;
 3708:       double eta1_bar = r_eic;
 3709: 
 3710: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3711:       // Compute tide elevation
 3712:       if (iettype == 3 || iettype == 5) {   
 3713: 
 3714:          if constexpr(iloadtide==1) { // loading tide
 3715:             assert(false && "Loading tide not implemented");
 3716:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3717:          }
 3718:          
 3719:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3720: 
 3721:             const double efa  = nodeBnd->efa[jfr]; 
 3722:             const double emo  = nodeBnd->emo[jfr]; 
 3723: 
 3724:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3725:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3726:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3727: 
 3728:  printf("++++>> jfr = %d, time = %f, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, time, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3729:          } // for jfr
 3730: 
 3731:       } // if iettype
 3732: 
 3733:       switch (iettype) {
 3734:          case 1:
 3735:          case 2:
 3736:             nodeBnd->elbc = r_eth + r_eic;
 3737:             break;
 3738:          case 3:
 3739:             nodeBnd->elbc = eta1_bar + r_eic;
 3740:             break;
 3741:          case 4:
 3742:             nodeBnd->elbc = r_eth + r_eic;
 3743:             break;
 3744:          case 5:
 3745:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3746:             break;
 3747:       } // switch
 3748: 
 3749: 
 3750:       //Add inverse barometric effects
 3751:       if (iettype != 0 && inv_atm_bnd == 1) {
 3752:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3753:       }
 3754: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3755:    }
 3756: 
 3757: 
 3758:    __global__ void setEssentialBC(void) {
 3759:       // Set essential boundary conditions 
 3760:       NODE(node); // Each boundary node
 3761:       NodeBoundary *nodeBnd = node->nodeBnd;
 3762: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3763:       
 3764: // nodeBnd->isEssentialBC = true;      
 3765:       // Check if this node has essential BC
 3766:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3767:          // Verify BC value is valid
 3768:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3769: 
 3770:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3771:          
 3772:          // Set diagonal to 1 and zero off-diagonals
 3773:          node->coeffDiag = 1.0;
 3774:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3775: 
 3776:          for (int j = 0; j < node->numNodes; j++) {
 3777:                node->coeffMatrix[j] = 0.0;
 3778:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3779:          }
 3780:          
 3781:          // Set solution and RHS to BC value
 3782:          node->mX  = nodeBnd->elbc;
 3783:          node->qel = nodeBnd->elbc;
 3784: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3785:       } else {
 3786:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3787: 
 3788:          for (int j = 0; j < node->numNodes; j++) {
 3789:                Node* nbNode = node->nodes[j];
 3790:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3791:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3792:                   // Verify neighbor's BC value
 3793:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3794: 
 3795:                   // Subtract contribution to RHS
 3796:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3797:                   node->coeffMatrix[j] = 0.0;  
 3798:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3799:                }
 3800:          }
 3801:       }
 3802:    }
 3803: 
 3804: 
 3805:    __global__ void updateElevation(void) {
 3806:       NODE(node);
 3807: 
 3808:       node->eta2 = node->mX;
 3809: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 3810:    }
