 1103: struct Node {
 1104: 
 1105:    // Geometry information
 1106:    int idx;        // Index of the node
 1107:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1108:    int numNodes;   // Number of nodes neighbors of this node
 1109: 
 1110:    Element **elements; // Array of pointers to the elements that share this node
 1111:    int numElements;    // Number of elements that share this node
 1112: 
 1113:    int numSides;       // Number of sides that are connected to this node
 1114: 
 1115:    Point3 p;
 1116:    Vector3 u2[nvrt];
 1117:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1118:    double z[nvrt];
 1119:    double lon, lat;
 1120:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1121:    double depth;
 1122: 
 1123:    int kb;       // Bottom index of the node
 1124: 
 1125:    bool isDry;     // True if the node is dry
 1126: 
 1127:    int iadv;     // Advection flag
 1128: 
 1129:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1130:                           // this is nullptr
 1131: 
 1132:    TempVar tmp; // Temporary variable to store different types of variables
 1133: 
 1134:    // Physical information
 1135:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1136:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1137: 
 1138:    double rho[nvrt];     // Density
 1139:    double dfv[nvrt];     // Vertical viscosity
 1140: 
 1141:    double eta1; // Elevation at nodes at previous timestep
 1142:    double eta2; // Elevation at nodes at current timestep
 1143: 
 1144:    double ETP;  // Earth Tidal Potential
 1145: 
 1146:    double pr;    // Air pressure
 1147:    double grav2; // Gravity 
 1148:    
 1149:    Vector2 dav;  // Depth averaged velocity
 1150: 
 1151:    Vector2 tau; // Wind stress vector
 1152: 
 1153:    // Vegetation parameters
 1154:    double veg_h;
 1155:    double veg_nv;
 1156:    double veg_di;
 1157:    double veg_Cd;
 1158:    double veg_h_unbent;
 1159:    double veg_di_unbent;
 1160:    double veg_nv_unbent;
 1161:    double veg_alpha_vert_mean;
 1162:    double veg_alpha0;
 1163:    double veg_alpha3D[nvrt];
 1164: 
 1165:    // Bottom drag parameters
 1166:    double Cd;       // Bottom drag coefficient
 1167:    double rough;    // Bottom roughness length
 1168:    Vector2 tau_bot; // Bottom stress vector
 1169: 
 1170:    double bdef1; // Bottom deformation at previous timestep
 1171:    double bdef2; // Bottom deformation at current timestep
 1172: 
 1173:    double qel; // RHS
 1174:    double coeffDiag; // Diagonal coefficient of the matrix
 1175:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1176: 
 1177:    double mP; // Search direction for conjugate gradient method
 1178:    double mR; // Residual for conjugate gradient method
 1179:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1180:    double mX; // Solution for conjugate gradient method
 1181: 
 1182:    // Meteorological forcing
 1183:    Vector2 u_air;
 1184:    double p_air;
 1185:    double t_air;
 1186:    double q_air;
 1187:    double wind_angle;  // Wind rotation angle
 1188: 
 1189:    __device__ void setWind(Vector2 &u) {
 1190:    // Sets the wind vector taking into account the wind rotation angle
 1191:    
 1192:       const double dir = atan2(-u.x,-u.y);
 1193:       const double speed = length(u);
 1194: 
 1195:       // Calculate new u and v components with added rotation angle
 1196:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1197:    }
 1198: 
 1199:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1200:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1201: 
 1202:    __device__ double sigmaTransitionDepth(void) const;
 1203: 
 1204:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1205:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1206:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1207: 
 1208:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1209: 
 1210:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1211:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1212: 
 1213:    __device__ void clearMatrixRow(void) {
 1214:       // Clear the matrix row for this node
 1215:       coeffDiag = 0.0;
 1216:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1217: 
 1218:    }
 1219: 
 1220:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1221:       // Add the value to the sparse matrix for this node
 1222:       
 1223:       if (node == this) {
 1224:          coeffDiag += value;
 1225:      
 1226:       } else {
 1227:          // Search (linearly)the index of the node in the array of nodes
 1228:          // XXX: This is not efficient, see if we can improve this
 1229:          int i;
 1230:          for (i = 0; i < numNodes; i++) {
 1231:             if (nodes[i] == node) {
 1232:                break;
 1233:             }
 1234:          }
 1235:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1236:          coeffMatrix[i] += value;
 1237:       }
 1238:    }
 1239: 
 1240: 
 1241:    __device__ __inline__ void updateZCoordData(void);
 1242: 
 1243:    __device__ double compZCoord(int k) const;
 1244: 
 1245:    __device__ void updateKb(void);
 1246: 
 1247: 
 1248: 
 1249: };
