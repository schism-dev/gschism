 2231: /**
 2232:  * Find the element that contains the target point.
 2233:  * 
 2234:  * @param x0,y0,z0     Starting position coordinates
 2235:  * @param xt,yt,zt     Target position coordinates
 2236:  * @param dtb          Time step for tracking
 2237:  * @param u_int        Initial velocity components
 2238:  * @param nextElem     Starting/resulting element index
 2239:  * 
 2240:  * @return Status code of type trackExitCodes
 2241:  * 
 2242:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2243:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2244:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2245:  * as close the the segment AB as possible, the next point at each iteration is computed
 2246:  * along segment AB, but just after the current element.
 2247:  */
 2248: 
 2249: 
 2250: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2251: 
 2252:    constexpr int MAX_ITERATIONS = 40;
 2253: 
 2254:    int iter = 0;
 2255:    double fac = 0.00001;
 2256:    while (iter < MAX_ITERATIONS) {
 2257:       iter++;
 2258: 
 2259:       Bool4 isLeft, isObtuse, isBisector;
 2260:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2261: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2262:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2263: 
 2264: 
 2265:       if (isValid.none()) 
 2266:       // Inside the element if none of the edges is a valid continuation
 2267:       {
 2268:          // Just returns true and the element (curElem) is unchanged).
 2269:          // This means that the algorithm has found the element that contains the target point.
 2270:          return true;
 2271:       }
 2272:       else { // Outside the element
 2273: 
 2274:          // Outside this element. Pick the first valid exit side and cross.
 2275:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2276:          Element *prevElem = curElem;
 2277:          curElem = lastCrossSide->otherElem(curElem);
 2278: 
 2279:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2280:          // along the boundary.
 2281:          if (curElem == nullptr || curElem->isDry) {
 2282:          
 2283:             curElem = prevElem;
 2284:             return false;
 2285:          }
 2286:          
 2287:       }
 2288: 
 2289:    }
 2290: 
 2291:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2292: }
 2293: 
