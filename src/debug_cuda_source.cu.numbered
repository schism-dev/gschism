 7130: 
 7131: __global__ void computeMatrixProductAndDotProducts() {
 7132:    // Computes A*p, r'Mr and p'Ap
 7133: 
 7134:    // 1) shared buffer: first half for rMr, second for pAp
 7135:    __shared__ double sdata[2*BLOCK_SIZE];
 7136:    double* s_rMr = sdata;
 7137:    double* s_pAp = sdata + BLOCK_SIZE;
 7138: 
 7139:    const int tid = threadIdx.x;
 7140: 
 7141:    double l_pAp = 0.0;
 7142: 
 7143:    s_rMr[tid] = 0.0;
 7144:    s_pAp[tid] = 0.0;
 7145: 
 7146:    // 2) get your node pointer
 7147:    // NODE(node);   
 7148:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7149:    Node *node = &(mesh->localNodeData[idx_node]); 
 7150:       if (idx_node < mesh->np) {
 7151: 
 7152:       const double diag = node->coeffDiag;
 7153:       const double r    = node->mR;
 7154:       const double p    = node->mP;  
 7155: 
 7156:       // apply preconditioner on the fly:
 7157:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7158: 
 7159:       // 4) compute Ap = A.p
 7160:       double Ap = node->coeffDiag * node->mP;
 7161:       for (int j = 0; j < node->numNodes; ++j) {
 7162:          const Node *nbNode = node->nodes[j];
 7163:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7164: 
 7165:       }
 7166: 
 7167:       node->mAp = Ap;
 7168:       
 7169: 
 7170:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7171:       // const double l_rMr = r*Mr;  // r'Mr
 7172:       l_pAp = p*Ap;  // p'Ap
 7173: 
 7174: 
 7175:    }
 7176: 
 7177:    // 6) write into shared mem
 7178:    // s_rMr[tid] = l_rMr;
 7179:    s_pAp[tid] = l_pAp;
 7180: 
 7181:    __syncthreads();
 7182: 
 7183:    // 7) block-wide tree reduction
 7184:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7185:       if (tid < stride)  {
 7186:          s_pAp[tid] += s_pAp[tid + stride];
 7187:       }
 7188:       __syncthreads();
 7189:    }
 7190: 
 7191:    // 8) thread 0 atomically accumulates into the globals
 7192:    // XXX: This is slower than it needs to be, but it is simple and works
 7193:    if (tid == 0) {
 7194:       atomicAdd(pAp, s_pAp[0]);
 7195:    }
 7196: 
 7197: 
 7198: }
 7199: 
 7200: 
 7201: __global__ void updateSolutionAndDotProducts(void) {
 7202:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7203: 
 7204:    const int tid = threadIdx.x;
 7205: 
 7206:    s_rMr[tid] = 0.0;
 7207: 
 7208:    // get node & bounds-check:
 7209:    NODE(node);
 7210: 
 7211:    
 7212:    // Compute alpha
 7213:    const double alpha = (*rMr_old)/(*pAp); 
 7214: 
 7215: 
 7216:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7217: 
 7218: 
 7219:    // load scalars
 7220:    const double diag = node->coeffDiag;
 7221:    const double p    = node->mP;
 7222:    const double Ap   = node->mAp;
 7223:    const double x    = node->mX;
 7224:    const double r    = node->mR;
 7225:    
 7226:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7227: 
 7228:    // 1) update solution & residual
 7229:    const double x_new = x + alpha*p;
 7230:    const double r_new = r - alpha*Ap;
 7231:    node->mX = x_new;
 7232:    node->mR = r_new;
 7233: 
 7234:    // 2) apply Jacobi preconditioner on the fly
 7235:    const double Mr_new = r_new/diag;
 7236: 
 7237: 
 7238:    // 3) local contributions for the two dot-products
 7239:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7240: 
 7241:    // 4) write into shared-mem
 7242:    s_rMr[tid] = l_rMr;
 7243: 
 7244:    __syncthreads();
 7245: 
 7246: 
 7247:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7248:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7249:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7250:       __syncthreads();
 7251:    }
 7252: 
 7253:    // 6) thread 0 atomically folds into the global accumulators
 7254:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7255: 
 7256: 
 7257: }
 7258: 
 7259: 
 7260: __global__ void updateSearchDirection() {
 7261: 
 7262:     NODE(node);
 7263: 
 7264:     // recompute z on-the-fly
 7265:     const double z = node->mR / node->coeffDiag;
 7266:     const double p = node->mP;
 7267: 
 7268:     const double beta = (*rMr_new)/(*rMr_old);
 7269: 
 7270: 
 7271:     // p =z + beta*p
 7272:     node->mP = z + beta*p;
 7273: 
 7274: }
 7275: 
 7276: __global__ void initializeScalars(double *scalars) {
 7277: 
 7278:    // These point to a cupy array in the host code
 7279:    rMr_old = scalars + 0;
 7280:    rMr_new = scalars + 1;
 7281:    pAp     = scalars + 2;
 7282: }
 7283: 
 7284: __global__ void initializePreconditionedResidual(void) {
 7285: 
 7286:     __shared__ double s_rMr[BLOCK_SIZE];  
 7287: 
 7288:     s_rMr[threadIdx.x] = 0.0;
 7289: 
 7290:     NODE_ALL(node, valid);
 7291:     const int tid = threadIdx.x;
 7292:     // For the first iteration:
 7293:     // 1. Initial solution x = 0 (already set)
 7294:     // 2. Initial residual r = b (stored in qel)
 7295:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7296: 
 7297: // XXX we should use the guess solution here    
 7298: 
 7299:     double l_rMr = 0.0;
 7300:     if (valid) {
 7301:       // Set initial residual r = b (from qel)
 7302:       node->mR = node->qel;
 7303: 
 7304:       // Compute z = M^-1 * r (preconditioned residual)
 7305:       const double z = node->mR / node->coeffDiag;
 7306: 
 7307:       // Set initial search direction p = z
 7308:       node->mP = z;
 7309: 
 7310:       // Initialize other variables needed for CG
 7311:       node->mX = 0.0;  // Initial solution
 7312:       node->mAp = 0.0; // Will be computed in first iteration
 7313: 
 7314: 
 7315:       // Computes the first r'Mr (reduction)
 7316:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7317:     }
 7318:     // 4) write into shared-mem
 7319:     s_rMr[tid] = l_rMr;
 7320: 
 7321:     __syncthreads();
 7322: 
 7323: 
 7324:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7325:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7326:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7327:         __syncthreads();
 7328:     }
 7329: 
 7330:     // 6) thread 0 atomically folds into the global accumulators
 7331:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7332: 
 7333:     *rMr_old = 0.0;
 7334:     *pAp = 0.0;
 7335: }
 7336: 
 7337: 
 7338: 
 7339: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7340:    Element *elems = mesh->localElemData;
 7341: 
 7342:    *addr = elems;
 7343:    *sizeElement = sizeof(Element);
 7344:    switch (varCode) {
 7345:       case (int)VarCode::z:
 7346:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7347:          *sizeType = sizeof(double);
 7348:          break;
 7349:       case (int)VarCode::x:
 7350:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7351:          *sizeType = sizeof(Vector2);
 7352:          break;
 7353:       case (int)VarCode::area:
 7354:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7355:          *sizeType = sizeof(double);
 7356:          break;
 7357:       case (int)VarCode::depth:
 7358:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7359:          *sizeType = sizeof(double);
 7360:          break;
 7361:       case (int)VarCode::radius:
 7362:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7363:          *sizeType = sizeof(double);
 7364:          break;
 7365:       case (int)VarCode::lonlat:
 7366:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7367:          *sizeType = sizeof(double);
 7368:          break;
 7369:       case (int)VarCode::ghat:
 7370:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7371:          *sizeType = sizeof(Vector2);
 7372:          break;
 7373:       case (int)VarCode::kb:
 7374:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7375:          *sizeType = sizeof(int);
 7376:          break;
 7377:       case (int)VarCode::isdry:
 7378:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7379:          *sizeType = sizeof(int);
 7380:          break;            
 7381:       case (int)VarCode::w:
 7382:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7383:          *sizeType = sizeof(double);
 7384:          break;
 7385:       case (int)VarCode::FaceIndices:
 7386:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7387:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7388:          *sizeType = sizeof(Node);
 7389:          break;
 7390:       default:
 7391:          *offset = -1;
 7392:    }
 7393: }
