 7191: 
 7192: __global__ void computeMatrixProductAndDotProducts() {
 7193:    // Computes A*p, r'Mr and p'Ap
 7194: 
 7195:    // 1) shared buffer: first half for rMr, second for pAp
 7196:    __shared__ double sdata[2*BLOCK_SIZE];
 7197:    double* s_rMr = sdata;
 7198:    double* s_pAp = sdata + BLOCK_SIZE;
 7199: 
 7200:    const int tid = threadIdx.x;
 7201: 
 7202:    double l_pAp = 0.0;
 7203: 
 7204:    s_rMr[tid] = 0.0;
 7205:    s_pAp[tid] = 0.0;
 7206: 
 7207:    // 2) get your node pointer
 7208:    // NODE(node);   
 7209:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7210:    Node *node = &(mesh->localNodeData[idx_node]); 
 7211:    if (idx_node < mesh->np) {
 7212: 
 7213: 
 7214:    const double diag = node->coeffDiag;
 7215:    const double r    = node->mR;
 7216:    const double p    = node->mP;  
 7217: 
 7218:    // apply preconditioner on the fly:
 7219:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7220: 
 7221:    // 4) compute Ap = A.p
 7222:    double Ap = node->coeffDiag * node->mP;
 7223:    for (int j = 0; j < node->numNodes; ++j) {
 7224:       const Node *nbNode = node->nodes[j];
 7225:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7226: 
 7227:    }
 7228: 
 7229:    node->mAp = Ap;
 7230:     
 7231: 
 7232:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7233:    // const double l_rMr = r*Mr;  // r'Mr
 7234:    l_pAp = p*Ap;  // p'Ap
 7235: 
 7236: 
 7237:    }
 7238: 
 7239:    // 6) write into shared mem
 7240:    // s_rMr[tid] = l_rMr;
 7241:    s_pAp[tid] = l_pAp;
 7242: 
 7243:    __syncthreads();
 7244: 
 7245:    // 7) block-wide tree reduction
 7246:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7247:       if (tid < stride)  {
 7248:          s_pAp[tid] += s_pAp[tid + stride];
 7249:       }
 7250:       __syncthreads();
 7251:    }
 7252: 
 7253:    // 8) thread 0 atomically accumulates into the globals
 7254:    // XXX: This is slower than it needs to be, but it is simple and works
 7255:    if (tid == 0) {
 7256:       atomicAdd(pAp, s_pAp[0]);
 7257:    }
 7258: 
 7259: 
 7260: }
 7261: 
 7262: 
 7263: __global__ void updateSolutionAndDotProducts(void) {
 7264:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7265: 
 7266:    const int tid = threadIdx.x;
 7267: 
 7268:    s_rMr[tid] = 0.0;
 7269: 
 7270:    // get node & bounds-check:
 7271:    NODE(node);
 7272: 
 7273:    
 7274:    // Compute alpha
 7275:    const double alpha = (*rMr_old)/(*pAp);
 7276: 
 7277:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7278: 
 7279: 
 7280:    // load scalars
 7281:    const double diag = node->coeffDiag;
 7282:    const double p    = node->mP;
 7283:    const double Ap   = node->mAp;
 7284:    const double x    = node->mX;
 7285:    const double r    = node->mR;
 7286:    
 7287:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7288: 
 7289:    // 1) update solution & residual
 7290:    const double x_new = x + alpha*p;
 7291:    const double r_new = r - alpha*Ap;
 7292:    node->mX = x_new;
 7293:    node->mR = r_new;
 7294: 
 7295:    // 2) apply Jacobi preconditioner on the fly
 7296:    const double Mr_new = r_new/diag;
 7297: 
 7298: 
 7299:    // 3) local contributions for the two dot-products
 7300:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7301: 
 7302:    // 4) write into shared-mem
 7303:    s_rMr[tid] = l_rMr;
 7304: 
 7305:    __syncthreads();
 7306: 
 7307: 
 7308:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7309:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7310:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7311:       __syncthreads();
 7312:    }
 7313: 
 7314:    // 6) thread 0 atomically folds into the global accumulators
 7315:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7316: 
 7317: 
 7318: }
 7319: 
 7320: 
 7321: __global__ void updateSearchDirection() {
 7322: 
 7323:     NODE(node);
 7324: 
 7325:     // recompute z on-the-fly
 7326:     const double z = node->mR / node->coeffDiag;
 7327:     const double p = node->mP;
 7328: 
 7329:     const double beta = (*rMr_new)/(*rMr_old);
 7330: 
 7331: 
 7332:     // p =z + beta*p
 7333:     node->mP = z + beta*p;
 7334: 
 7335: }
 7336: 
 7337: __global__ void initializePreconditionedResidual(double *scalars) {
 7338: 
 7339:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7340: 
 7341:     s_rMr[threadIdx.x] = 0.0;
 7342: 
 7343:     NODE(node);
 7344:     const int tid = threadIdx.x;
 7345:     // For the first iteration:
 7346:     // 1. Initial solution x = 0 (already set)
 7347:     // 2. Initial residual r = b (stored in qel)
 7348:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7349: 
 7350: // XXX we should use the guess solution here    
 7351: 
 7352:     // Set initial residual r = b (from qel)
 7353:     node->mR = node->qel;
 7354: 
 7355:     // Compute z = M^-1 * r (preconditioned residual)
 7356:     const double z = node->mR / node->coeffDiag;
 7357: 
 7358:     // Set initial search direction p = z
 7359:     node->mP = z;
 7360: 
 7361:     // Initialize other variables needed for CG
 7362:     node->mX = 0.0;  // Initial solution
 7363:     node->mAp = 0.0; // Will be computed in first iteration
 7364: 
 7365:     // These point to a cupy array in the host code
 7366:     rMr_old = scalars + 0;
 7367:     rMr_new = scalars + 1;
 7368:     pAp     = scalars + 2;
 7369: 
 7370:     // Computes the first r'Mr (reduction)
 7371:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7372: 
 7373:     // 4) write into shared-mem
 7374:     s_rMr[tid] = l_rMr;
 7375: 
 7376:     __syncthreads();
 7377: 
 7378: 
 7379:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7380:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7381:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7382:         __syncthreads();
 7383:     }
 7384: 
 7385:     // 6) thread 0 atomically folds into the global accumulators
 7386:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7387: 
 7388:     *rMr_old = 0.0;
 7389:     *pAp = 0.0;
 7390: }
 7391: 
 7392: 
 7393: 
 7394: 
 7395: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7396:    // Get the value of a variable from an element
 7397:    // varName is the name of the variable to get
 7398:    // var is the array to store the value
 7399:    // k is the vertical level index of the variable to get
 7400: 
 7401:    ELEM(elem);
 7402:    
 7403:    int idx = elem->idx;
 7404:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7405: 
 7406:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7407:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7408:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7409:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7410:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7411:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7412:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7413:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7414:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7415:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7416:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7417:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7418:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7419:       
 7420:    
 7421: }
 7422: 
 7423: 
 7424: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7425:    // Get the value of a variable from an node
 7426:    // varName is the name of the variable to get
 7427:    // var is the array to store the value
 7428:    // k is the vertical level index of the variable to get
 7429: 
 7430:    NODE(node);
 7431:    
 7432:    int idx = node->idx;
 7433:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7434: 
 7435:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7436:    
 7437:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7438:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7439:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7440:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7441:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7442:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7443:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7444:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7445:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7446:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7447:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7448:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7449:    
 7450:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7451:       
 7452:    
 7453: }
 7454: 
 7455: 
 7456: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7457:    // Get the value of a variable from an side
 7458:    // varName is the name of the variable to get
 7459:    // var is the array to store the value
 7460:    // k is the vertical level index of the variable to get
 7461:    SIDE(side);
 7462:    
 7463:    int idx = side->idx;
 7464:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7465: 
 7466:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7467:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7468:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7469:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7470:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7471:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7472:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7473:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7474:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7475:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7476:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7477:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7478:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7479:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7480:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7481:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7482:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7483:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7484:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7485:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7486:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7487:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7488:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7489:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7490: }
