 1638: // Helper functions for computing the local node index at a given offset from another.
 1639: __device__ __inline__ int nxq(int offset, int index, int size) {
 1640:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1641:    // to the index to make it positive
 1642:    assert(index + offset + 16*size >= 0);
 1643:    return (index + offset + 16*size) % size;  
 1644: }
 1645: 
 1646: __device__ __inline__ int nxq(int index, int size) {
 1647:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1648:    // to the index to make it positive
 1649:    assert(index + 16*size >= 0);
 1650:    return (index + 16*size) % size; 
 1651: }
