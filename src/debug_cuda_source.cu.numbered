 7059:    __global__ void setVelocityOpenBndNodes(void) {
 7060:    // For open boundary nodes sets their velocity to the imposed values.
 7061: 
 7062:       SIDE_BND(sidebnd);
 7063: 
 7064:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7065:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7066:          // to its segment to the average of the side velocity.
 7067: 
 7068:          for (int k = 0; k < nvrt; k++) {
 7069:             Node *n1 = sidebnd->side->n1;
 7070:             Node *n2 = sidebnd->side->n2;
 7071: 
 7072: 
 7073:             Vector2 n1_u2(n1->u2[k]);
 7074:             Vector2 n2_u2(n2->u2[k]);
 7075: 
 7076:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7077:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7078:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7079:             }
 7080:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7081:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7082:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7083:             }
 7084: 
 7085:          }
 7086: 
 7087:       }
 7088: 
 7089:    }
