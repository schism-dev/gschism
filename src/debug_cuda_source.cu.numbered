 6504: #ifdef DONTCOMPILE
 6505: __device__ void computeVerticalAdvection(void) {
 6506:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6507: 
 6508:    sdbt(1:2,:,:)=0.d0
 6509: 
 6510:    const Side *side = FROM kernel;
 6511: 
 6512:    if(side->isDry) return;
 6513: 
 6514:    // If side is wet...
 6515: 
 6516: 
 6517:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6518:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6519:    double ws[nvrt] = {} // w @ side
 6520:    int icount = 0;
 6521:    for (int j=0; j<2; j++) {
 6522:       const Element *elem = side->elements[j];
 6523:        
 6524:       if(elem != nullptr) {
 6525:          icount++;
 6526:          for (int k=0; k<nvrt; k++) {
 6527:             ws[k] = ws[k] + elem->w[k];
 6528:          }
 6529:       }
 6530:    }  // for j
 6531: 
 6532:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6533:    ws = ws/icount;
 6534: 
 6535:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6536:    // Splines allow for a smooth transition between vertical levels.
 6537:    // Splines have continuity restrictions at the internal knots, but
 6538:    // we have to provide the 1st derivatives at the endpoints.
 6539:    const int kbs = side->kbs; 
 6540:    
 6541:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6542:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6543:    initCubicSpline(kbs, nvrt, side, ws, up)
 6544: 
 6545:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6546:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6547:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6548: 
 6549:    // Total advection (average onto side)
 6550:    const Node *node1 = side->nodes[0];
 6551:    const Node *node2 = side->nodes[1];
 6552:    for (int k=kbs(i); k<nvrt; k++) {
 6553: 
 6554:       if constexpr(ics==1) {
 6555:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6556:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6557:       } else {
 6558:          // XXX IMPLEMENT THIS
 6559:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6560:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6561:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6562:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6563:       }  // if ics
 6564: 
 6565: 
 6566:    }
 6567: }
 6568: #endif
 6569: 
 6570: 
 6571: extern "C" {
 6572:    __global__ void computeElemAverageGhat(void) {
 6573:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6574: 
 6575:       ELEM(elem);
 6576:       
 6577:       elem->ghat1= {0.0, 0.0};  
 6578: 
 6579:       if constexpr(ihydraulics != 0) {
 6580:          if (nhtblocks > 0 && elem->isblock) return;
 6581:       }
 6582: 
 6583:       if (elem->isDry) return;
 6584: 
 6585:       // Wet elements.
 6586:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6587:       // tidal potential, horizontal diffusion, and baroclinic etc
 6588:       // Remember to update both fb and F 
 6589:       // If ics=2, ghat1 are in eframe (ll)
 6590:       // cff1-3: coefficients for 2D/3D
 6591:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6592:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6593:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6594: 
 6595:       double av_cff1 = 0.0;  // av. for cff1
 6596:       double av_cff2 = 0.0;  // av. for cff2
 6597:       double av_cff3 = 0.0;  // av. for cff3
 6598:       double av_df = 0.0;  // av. for H^\alpha / H
 6599:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6600:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6601: 
 6602:       const int i34 = elem->i34;
 6603:       const int kb = elem->kb;
 6604: 
 6605:       for (int j=1; j<i34; j++) {
 6606:          // For each node and side in the element...
 6607: 
 6608:          const Node *node = elem->nodes[j];
 6609:          const Side *side = elem->sides[j];
 6610: 
 6611:          const double chi      = side->chi;
 6612:          const double veg_c2   = side->veg_c2;
 6613:          const double veg_beta = side->veg_beta;
 6614:          const double veg_h    = side->veg_h();
 6615:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6616: 
 6617:          // Node - const in elem
 6618:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6619:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6620: 
 6621:          if (elem->depth >= tip_dp) {
 6622:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6623:          }
 6624: 
 6625:          
 6626:          const double htot  = side->htot2();        // Total depth at the side
 6627:          const double zctr2 = side->zTopCanopy();  
 6628: 
 6629:          double cff1; 
 6630:          double cff2; 
 6631:          double cff3;   
 6632:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6633:          // coefficients applied to 2D/3D case 
 6634:             cff1 = side->hhat/htot;
 6635:             cff2 = 0.0;
 6636:             cff3 = 0.0;
 6637:          } else { //3D
 6638:             //Init for no-veg case
 6639:             cff1 = 1.0;
 6640:             cff2 = 1.0;
 6641:             cff3 = 0.0;
 6642: 
 6643:             if constexpr(iveg != 0) {
 6644:                // Computes coefficients used with vegetation terms G1, G2
 6645:                // cff1, cff3 are used for the first two terms in G1, G2:
 6646:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6647:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6648:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6649:                if(veg_h < 0.99*htot) { // submergent vegetation
 6650:                   cff1=1;
 6651:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6652:                   cff3 = veg_c;
 6653: 
 6654:                } else { // emergent vegetation
 6655:                   cff1 = 1.0/(1.0 + veg_c2);
 6656:                   cff2 = cff1;
 6657:                   cff3 = 0.0;
 6658: 
 6659:                }
 6660:             } // if iveg
 6661:          } //  2D/3D
 6662: 
 6663:          av_cff1 += cff1/i34;
 6664:          av_cff2 += cff2/i34;
 6665:          av_cff3 += cff3/i34;
 6666:          av_cff2_chi += cff2*chi/i34;
 6667:          av_cff3_chi += cff3*chi/i34;
 6668:          av_df += min(htot, veg_h)/(htot*i34);
 6669: 
 6670: 
 6671:          // btrack values: U^\star, U^{\star\alpha}
 6672:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6673:          Vector2 Ustar       = {0.0, 0.0}; 
 6674:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6675: 
 6676:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6677:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6678:          } else { //3D
 6679:             for (int k = side->kb; k < nvrt; k++) {
 6680:             
 6681:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6682:                Ustar += w2;
 6683: 
 6684:                if constexpr(iveg != 0) {
 6685:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6686:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6687:                        Ustar_alpha += zrat*w2; // XXXX
 6688:                    }
 6689:                }  // if iveg
 6690:             }  // for k
 6691:          }  //2D/3D
 6692:          
 6693: 
 6694:          // Add btrack & surface stress terms to \breve{G} first
 6695:          if constexpr(ics==1) {
 6696:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6697:          } else {
 6698:             // XXX IMPLEMENT THIS
 6699:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6700:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6701:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6702:          }  // if ics
 6703: 
 6704:          // Surface and bottom stress terms
 6705:          if constexpr(ics==1) {
 6706:             const Vector2 tau    = side->tau();
 6707:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6708: 
 6709:             // Term for surface and bottom stress
 6710:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6711:          } else {
 6712:             // XXX IMPLEMENT THIS
 6713:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6714:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6715:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6716:             // tau_x=(vn1+tt1)/2.d0
 6717:             // tau_y=(vn2+ss1)/2.d0
 6718:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6719:          }  // if ics
 6720: 
 6721:          
 6722: 
 6723:          // All terms in F,F^\alpha,f_b except baroclinic
 6724:          // F, f_b: all explicit terms excluding vegetation 
 6725:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6726:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6727:          const double coriolis = side->coriolis;
 6728:          Vector2 F  =  coriolis*side->U;  // F_x
 6729:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6730:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6731: 
 6732:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6733:             
 6734:             for (int k = side->kb; k < nvrt; k++) {
 6735:                if (zctr2 > side->zc[k-1]) {
 6736:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6737:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6738:                    Fa +=  coriolis*w2*zrat;
 6739:                } // if zctr2
 6740:             } // k
 6741:          } // iveg
 6742: 
 6743:          // Integrate horizontal viscosity force vertically
 6744:          for (int k=side->kb + 1; k<nvrt; k++) {
 6745:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6746: 
 6747:             F += levelHorVisc;
 6748: 
 6749:             // Vegetation term
 6750:             if constexpr(iveg!=0) {
 6751:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6752:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6753:                   Fa += levelHorVisc*zrat;
 6754:                } 
 6755:             } // if iveg
 6756:          } // for k
 6757: 
 6758:          fb += side->nuGradU[side->kb];
 6759: 
 6760:          // Add to ghat1
 6761:          if constexpr(ics==2) {
 6762:             // XXX IMPLEMENT THIS
 6763:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6764:             // bigf1=vn1; bigf2=vn2
 6765:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6766:             // botf1=vn1; botf2=vn2
 6767:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6768:             // bigfa1=vn1; bigfa2=vn2
 6769:          } // if ics
 6770: 
 6771:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6772:       } // for j (nodes and sides)
 6773: 
 6774:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6775:          
 6776:       // Finish off terms in F, F^\alpha and f_b
 6777:       const double grav3 = elem->mean(&Node::grav2);
 6778:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6779: 
 6780: 
 6781:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6782:       for (int j=1; j<i34; j++) { 
 6783:          // For each side in the element...
 6784:          const Side *side = elem->sides[j];
 6785:          const double chi = side->chi;
 6786: 
 6787:          const double htot = side->htot2();
 6788:          const double veg_h = side->veg_h();
 6789:          const Vector2 F  = htot*fb;
 6790:          const Vector2 Fa = min(htot, veg_h)*fb;
 6791: 
 6792:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6793:       } // for j
 6794: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6795:       //botf1 etc are already in elem frame
 6796:       elem->ghat1 += tmp/i34;
 6797: 
 6798:       // Baroclinic force
 6799:       if constexpr(ibc==0) {
 6800:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6801: 
 6802:          Vector2 Fa = {0.0, 0.0};
 6803:          Vector2 intGradRho = {0.0, 0.0};
 6804:          
 6805:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6806:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6807:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6808: 
 6809:             // \in F [m^2/s/s]
 6810:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6811:          }
 6812: 
 6813:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6814:          const Vector2 F = av_df*Fa; //approx
 6815:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6816: 
 6817:       } // if ibc
 6818: 
 6819: 
 6820: 
 6821:    }
 6822: 
 6823: } // extern "C"
 6824: 
 6825: 
 6826: 
 6827: #ifdef DONTCOMPILE
 6828: __global__ void checkMassConservation(Tracers* sumtr) {
 6829: 
 6830:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6831: 
 6832:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6833: 
 6834:    Element *elem = &(mesh->localElemData[i]);
 6835: 
 6836:    // Skip dry elements
 6837:    if (elem->isDry) return;
 6838: 
 6839:    // Local sum array for this thread
 6840:    double localSum[N_TRACERS] = {0.0};
 6841: 
 6842:    // Sum over vertical levels for this element
 6843:    const int kbe = elem->kbe;
 6844:    const double area = elem->area;
 6845: 
 6846:    for (int k = kbe; k < nvrt; k++) {
 6847:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6848:       
 6849:       // Accumulate tracer mass
 6850:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6851:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6852:       }
 6853:    }
 6854: 
 6855:    
 6856: 
 6857:    //  This function returns per element sums. A reduction must be done on the host side.
 6858: }
 6859: 
 6860: 
 6861: __global__ void transport(void) {
 6862: 
 6863:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6864: 
 6865:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6866: 
 6867:    Element *elem = &(mesh->localElemData[ie]);
 6868: 
 6869:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6870: 
 6871:                for (int m=0; m<ntr; m++) {
 6872:                   for (int k=kbe(ie); k<nvrt; k++) {
 6873:                      // Calculate each polynomial's weight 
 6874:                      wm=0.d0; sum1=0.d0; 
 6875:                      wm1=0.d0; wm2=0.d0; 
 6876:                      for (int i=0; i<elem->nweno2; i++) {
 6877:                   
 6878:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6879:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6880:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6881:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6882:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6883:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6884:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6885:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6886:                      // -----------------Hu and Shu (1999)'s method----------------
 6887:                      b4=b1+b2+b3
 6888: 
 6889: //Error: add PRODUCTION CPP
 6890: #ifdef DEBUG
 6891:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6892:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6893:                     call parallel_abort(errmsg)
 6894:                   }
 6895: #endif
 6896: 
 6897:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6898:                   // !----test-------------- 
 6899:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6900:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6901:                   // !wm(i)=wm1(i)*wm2(i)
 6902:                   // !---------------------- 
 6903:                   sum1=sum1+wm(i)
 6904:                 } // end for i
 6905: 
 6906:                 wm=wm/sum1
 6907: 
 6908:                 for (int j=0; j<elem->i34; j++) {
 6909: 
 6910:                   const Side *side  = elem->sides[j];
 6911:                   const Node *node1 = side->n1;
 6912:                   const Node *node2 = side->n2;
 6913: 
 6914:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6915:                      trsd=0.d0
 6916:                      for (int kk=0; kk<nquad; kk++) {
 6917:                         for (int i=0; i<elem->nweno2; i++) {
 6918:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6919:                         } // end for i   
 6920:                      } // end for kk
 6921:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6922:                   } // outward flux
 6923:                } // end for j=1,i34(ie) ! side
 6924:             }
 6925:          }
 6926:               
 6927: 
 6928: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6929: //             //   calculate each polynomial's weight 
 6930: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6931: //                 wm=0.d0; sum1=0.d0
 6932: //                 do i=1,nweno1(ie) !for each polynomial
 6933: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6934: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6935: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6936: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6937: //                   wm(i)=b2
 6938: //                   sum1=sum1+b2
 6939: //                   !wm(i)=1.d0
 6940: //                   !sum1=sum1+1.d0
 6941: 
 6942: // // Error: PRODUCTION
 6943: // #ifdef DEBUG
 6944: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6945: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6946: //                     call parallel_abort(errmsg)
 6947: //                   endif
 6948: // #endif
 6949: 
 6950: //                 enddo !i
 6951: //                 wm=wm/sum1 !final weight
 6952: 
 6953:                 for (int j=0; j<elem->i34; j++) { // side
 6954:                   const Side *side = elem->sides[j];
 6955:                   const Node *node1 = side->n1;
 6956:                   const Node *node2 = side->n2;
 6957: 
 6958:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6959:                     trsd=0.d0
 6960:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6961:                       for (int i=0; i<elem->nweno1; i++) {
 6962:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6963:                       }
 6964:                     enddo //kk
 6965:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6966:                   } // outward flux
 6967:                 } // end for j=1,i34(ie) ! side
 6968:               } // end for k; ntr 
 6969: 
 6970:             else !simple upwind method
 6971:               do j=1,i34(ie)
 6972:                 jsj=elside(j,ie)
 6973:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6974:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6975:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6976:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6977:                   endif
 6978:                 enddo  !vertical layers
 6979:               enddo !j=1,i34(ie) ! side
 6980:             endif !order of accuracy
 6981: 
 6982:          //  enddo !ie
 6983: // !$OMP     end do
 6984: 
