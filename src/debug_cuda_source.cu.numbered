 7274: 
 7275: __global__ void computeMatrixProductAndDotProducts() {
 7276:    // Computes A*p, r'Mr and p'Ap
 7277: 
 7278:    // 1) shared buffer: first half for rMr, second for pAp
 7279:    __shared__ double sdata[2*BLOCK_SIZE];
 7280:    double* s_rMr = sdata;
 7281:    double* s_pAp = sdata + BLOCK_SIZE;
 7282: 
 7283:    const int tid = threadIdx.x;
 7284: 
 7285:    double l_pAp = 0.0;
 7286: 
 7287:    s_rMr[tid] = 0.0;
 7288:    s_pAp[tid] = 0.0;
 7289: 
 7290:    // 2) get your node pointer
 7291:    // NODE(node);   
 7292:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7293:    Node *node = &(mesh->localNodeData[idx_node]); 
 7294:    if (idx_node < mesh->np) {
 7295: 
 7296: 
 7297:    const double diag = node->coeffDiag;
 7298:    const double r    = node->mR;
 7299:    const double p    = node->mP;  
 7300: 
 7301:    // apply preconditioner on the fly:
 7302:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7303: 
 7304:    // 4) compute Ap = A.p
 7305:    double Ap = node->coeffDiag * node->mP;
 7306:    for (int j = 0; j < node->numNodes; ++j) {
 7307:       const Node *nbNode = node->nodes[j];
 7308:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7309: 
 7310:    }
 7311: 
 7312:    node->mAp = Ap;
 7313:     
 7314: 
 7315:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7316:    // const double l_rMr = r*Mr;  // r'Mr
 7317:    l_pAp = p*Ap;  // p'Ap
 7318: 
 7319: 
 7320:    }
 7321: 
 7322:    // 6) write into shared mem
 7323:    // s_rMr[tid] = l_rMr;
 7324:    s_pAp[tid] = l_pAp;
 7325: 
 7326:    __syncthreads();
 7327: 
 7328:    // 7) block-wide tree reduction
 7329:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7330:       if (tid < stride)  {
 7331:          s_pAp[tid] += s_pAp[tid + stride];
 7332:       }
 7333:       __syncthreads();
 7334:    }
 7335: 
 7336:    // 8) thread 0 atomically accumulates into the globals
 7337:    // XXX: This is slower than it needs to be, but it is simple and works
 7338:    if (tid == 0) {
 7339:       atomicAdd(pAp, s_pAp[0]);
 7340:    }
 7341: 
 7342: 
 7343: }
 7344: 
 7345: 
 7346: __global__ void updateSolutionAndDotProducts(void) {
 7347:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7348: 
 7349:    const int tid = threadIdx.x;
 7350: 
 7351:    s_rMr[tid] = 0.0;
 7352: 
 7353:    // get node & bounds-check:
 7354:    NODE(node);
 7355: 
 7356:    
 7357:    // Compute alpha
 7358:    const double alpha = (*rMr_old)/(*pAp);
 7359: 
 7360:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7361: 
 7362: 
 7363:    // load scalars
 7364:    const double diag = node->coeffDiag;
 7365:    const double p    = node->mP;
 7366:    const double Ap   = node->mAp;
 7367:    const double x    = node->mX;
 7368:    const double r    = node->mR;
 7369:    
 7370:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7371: 
 7372:    // 1) update solution & residual
 7373:    const double x_new = x + alpha*p;
 7374:    const double r_new = r - alpha*Ap;
 7375:    node->mX = x_new;
 7376:    node->mR = r_new;
 7377: 
 7378:    // 2) apply Jacobi preconditioner on the fly
 7379:    const double Mr_new = r_new/diag;
 7380: 
 7381: 
 7382:    // 3) local contributions for the two dot-products
 7383:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7384: 
 7385:    // 4) write into shared-mem
 7386:    s_rMr[tid] = l_rMr;
 7387: 
 7388:    __syncthreads();
 7389: 
 7390: 
 7391:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7392:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7393:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7394:       __syncthreads();
 7395:    }
 7396: 
 7397:    // 6) thread 0 atomically folds into the global accumulators
 7398:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7399: 
 7400: 
 7401: }
 7402: 
 7403: 
 7404: __global__ void updateSearchDirection() {
 7405: 
 7406:     NODE(node);
 7407: 
 7408:     // recompute z on-the-fly
 7409:     const double z = node->mR / node->coeffDiag;
 7410:     const double p = node->mP;
 7411: 
 7412:     const double beta = (*rMr_new)/(*rMr_old);
 7413: 
 7414: 
 7415:     // p =z + beta*p
 7416:     node->mP = z + beta*p;
 7417: 
 7418: }
 7419: 
 7420: __global__ void initializePreconditionedResidual(double *scalars) {
 7421: 
 7422:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7423: 
 7424:     s_rMr[threadIdx.x] = 0.0;
 7425: 
 7426:     NODE(node);
 7427:     const int tid = threadIdx.x;
 7428:     // For the first iteration:
 7429:     // 1. Initial solution x = 0 (already set)
 7430:     // 2. Initial residual r = b (stored in qel)
 7431:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7432: 
 7433: // XXX we should use the guess solution here    
 7434: 
 7435:     // Set initial residual r = b (from qel)
 7436:     node->mR = node->qel;
 7437: 
 7438:     // Compute z = M^-1 * r (preconditioned residual)
 7439:     const double z = node->mR / node->coeffDiag;
 7440: 
 7441:     // Set initial search direction p = z
 7442:     node->mP = z;
 7443: 
 7444:     // Initialize other variables needed for CG
 7445:     node->mX = 0.0;  // Initial solution
 7446:     node->mAp = 0.0; // Will be computed in first iteration
 7447: 
 7448:     // These point to a cupy array in the host code
 7449:     rMr_old = scalars + 0;
 7450:     rMr_new = scalars + 1;
 7451:     pAp     = scalars + 2;
 7452: 
 7453:     // Computes the first r'Mr (reduction)
 7454:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7455: 
 7456:     // 4) write into shared-mem
 7457:     s_rMr[tid] = l_rMr;
 7458: 
 7459:     __syncthreads();
 7460: 
 7461: 
 7462:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7463:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7464:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7465:         __syncthreads();
 7466:     }
 7467: 
 7468:     // 6) thread 0 atomically folds into the global accumulators
 7469:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7470: 
 7471:     *rMr_old = 0.0;
 7472:     *pAp = 0.0;
 7473: }
 7474: 
 7475: 
 7476: 
 7477: 
 7478: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7479:    // Get the value of a variable from an element
 7480:    // varName is the name of the variable to get
 7481:    // var is the array to store the value
 7482:    // k is the vertical level index of the variable to get
 7483: 
 7484:    ELEM(elem);
 7485:    
 7486:    int idx = elem->idx;
 7487:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7488: 
 7489:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7490:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7491:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7492:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7493:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7494:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7495:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7496:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7497:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7498:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7499:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 7500:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 7501:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7502:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7503:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7504:       
 7505:    
 7506: }
 7507: 
 7508: 
 7509: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7510:    // Get the value of a variable from an node
 7511:    // varName is the name of the variable to get
 7512:    // var is the array to store the value
 7513:    // k is the vertical level index of the variable to get
 7514: 
 7515:    NODE(node);
 7516:    
 7517:    int idx = node->idx;
 7518:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7519: 
 7520:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7521:    
 7522:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7523:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7524:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7525:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7526:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7527:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7528:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7529:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7530:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7531:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7532:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7533:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7534:    
 7535:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7536:       
 7537:    
 7538: }
 7539: 
 7540: 
 7541: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7542:    // Get the value of a variable from an side
 7543:    // varName is the name of the variable to get
 7544:    // var is the array to store the value
 7545:    // k is the vertical level index of the variable to get
 7546:    SIDE(side);
 7547:    
 7548:    int idx = side->idx;
 7549:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7550: 
 7551:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7552:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7553:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7554:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7555:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7556:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7557:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7558:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7559:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7560:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7561:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7562:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7563:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7564:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7565:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7566:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7567:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7568:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7569:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7570:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7571:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7572:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7573:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7574:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7575:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7576:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7577:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7578:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7579:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7580:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7581:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7582:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7583:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7584:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7585: }
