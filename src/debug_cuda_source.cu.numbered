 8126: #ifdef OLD_PCG_SOLVER
 8127: __global__ void computeMatrixProductAndDotProducts() {
 8128:    // Computes A*p, r'Mr and p'Ap
 8129: 
 8130:    // 1) shared buffer: first half for rMr, second for pAp
 8131:    __shared__ double sdata[2*BLOCK_SIZE];
 8132:    double* s_rMr = sdata;
 8133:    double* s_pAp = sdata + BLOCK_SIZE;
 8134: 
 8135:    const int tid = threadIdx.x;
 8136: 
 8137:    double l_pAp = 0.0;
 8138: 
 8139:    s_rMr[tid] = 0.0;
 8140:    s_pAp[tid] = 0.0;
 8141: 
 8142:    // 2) get your node pointer
 8143:    // NODE(node);   
 8144:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8145:    Node *node = &(mesh->localNodeData[idx_node]); 
 8146:       if (idx_node < mesh->np) {
 8147: 
 8148:       const double diag = node->coeffDiag;
 8149:       const double r    = node->mR;
 8150:       const double p    = node->mP;  
 8151: 
 8152:       // apply preconditioner on the fly:
 8153:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8154: 
 8155:       // 4) compute Ap = A.p
 8156:       double Ap = node->coeffDiag * node->mP;
 8157:       for (int j = 0; j < node->numNodes; ++j) {
 8158:          const Node *nbNode = node->nodes[j];
 8159:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8160: 
 8161:       }
 8162: 
 8163:       node->mAp = Ap;
 8164:       
 8165: 
 8166:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8167:       // const double l_rMr = r*Mr;  // r'Mr
 8168:       l_pAp = p*Ap;  // p'Ap
 8169: 
 8170: 
 8171:    }
 8172: 
 8173:    // 6) write into shared mem
 8174:    // s_rMr[tid] = l_rMr;
 8175:    s_pAp[tid] = l_pAp;
 8176: 
 8177:    __syncthreads();
 8178: 
 8179:    // 7) block-wide tree reduction
 8180:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8181:       if (tid < stride)  {
 8182:          s_pAp[tid] += s_pAp[tid + stride];
 8183:       }
 8184:       __syncthreads();
 8185:    }
 8186: 
 8187:    // 8) thread 0 atomically accumulates into the globals
 8188:    // XXX: This is slower than it needs to be, but it is simple and works
 8189:    if (tid == 0) {
 8190:       atomicAdd(pAp, s_pAp[0]);
 8191:    }
 8192: 
 8193: 
 8194: }
 8195: 
 8196: 
 8197: __global__ void updateSolutionAndDotProducts(void) {
 8198:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8199: 
 8200:    const int tid = threadIdx.x;
 8201: 
 8202:    s_rMr[tid] = 0.0;
 8203: 
 8204:    // get node & bounds-check:
 8205:    NODE(node);
 8206: 
 8207:    
 8208:    // Compute alpha
 8209:    const double alpha = (*rMr_old)/(*pAp); 
 8210: 
 8211: 
 8212:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8213: 
 8214: 
 8215:    // load scalars
 8216:    const double diag = node->coeffDiag;
 8217:    const double p    = node->mP;
 8218:    const double Ap   = node->mAp;
 8219:    const double x    = node->mX;
 8220:    const double r    = node->mR;
 8221:    
 8222:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8223: 
 8224:    // 1) update solution & residual
 8225:    const double x_new = x + alpha*p;
 8226:    const double r_new = r - alpha*Ap;
 8227:    node->mX = x_new;
 8228:    node->mR = r_new;
 8229: 
 8230:    // 2) apply Jacobi preconditioner on the fly
 8231:    const double Mr_new = r_new/diag;
 8232: 
 8233: 
 8234:    // 3) local contributions for the two dot-products
 8235:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8236: 
 8237:    // 4) write into shared-mem
 8238:    s_rMr[tid] = l_rMr;
 8239: 
 8240:    __syncthreads();
 8241: 
 8242: 
 8243:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8244:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8245:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8246:       __syncthreads();
 8247:    }
 8248: 
 8249:    // 6) thread 0 atomically folds into the global accumulators
 8250:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8251: 
 8252: 
 8253: }
 8254: 
 8255: 
 8256: __global__ void updateSearchDirection() {
 8257: 
 8258:     NODE(node);
 8259: 
 8260:     // recompute z on-the-fly
 8261:     const double z = node->mR / node->coeffDiag;
 8262:     const double p = node->mP;
 8263: 
 8264:     const double beta = (*rMr_new)/(*rMr_old);
 8265: 
 8266: 
 8267:     // p =z + beta*p
 8268:     node->mP = z + beta*p;
 8269: 
 8270: }
 8271: 
 8272: __global__ void initializeScalars(double *scalars) {
 8273: 
 8274:    // These point to a cupy array in the host code
 8275:    rMr_old = scalars + 0;
 8276:    rMr_new = scalars + 1;
 8277:    pAp     = scalars + 2;
 8278: }
 8279: 
 8280: __global__ void initializePreconditionedResidual(void) {
 8281: 
 8282:     __shared__ double s_rMr[BLOCK_SIZE];  
 8283: 
 8284:     s_rMr[threadIdx.x] = 0.0;
 8285: 
 8286:     NODE_ALL(node, valid);
 8287:     const int tid = threadIdx.x;
 8288:     // For the first iteration:
 8289:     // 1. Initial solution x = 0 (already set)
 8290:     // 2. Initial residual r = b (stored in qel)
 8291:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8292: 
 8293: // XXX we should use the guess solution here    
 8294: 
 8295:     double l_rMr = 0.0;
 8296:     if (valid) {
 8297:       // Set initial residual r = b (from qel)
 8298:       node->mR = node->qel;
 8299: 
 8300:       // Compute z = M^-1 * r (preconditioned residual)
 8301:       const double z = node->mR / node->coeffDiag;
 8302: 
 8303:       // Set initial search direction p = z
 8304:       node->mP = z;
 8305: 
 8306:       // Initialize other variables needed for CG
 8307:       node->mX = 0.0;  // Initial solution
 8308:       node->mAp = 0.0; // Will be computed in first iteration
 8309: 
 8310: 
 8311:       // Computes the first r'Mr (reduction)
 8312:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8313:     }
 8314:     // 4) write into shared-mem
 8315:     s_rMr[tid] = l_rMr;
 8316: 
 8317:     __syncthreads();
 8318: 
 8319: 
 8320:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8321:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8322:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8323:         __syncthreads();
 8324:     }
 8325: 
 8326:     // 6) thread 0 atomically folds into the global accumulators
 8327:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8328: 
 8329:     *rMr_old = 0.0;
 8330:     *pAp = 0.0;
 8331: }
 8332: #endif
 8333: 
 8334: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8335: 
 8336:    ELEM(elem);
 8337: 
 8338:    switch (varCode) {
 8339:       case (int)VarCode::outputCoords:
 8340:          const Point2 coords = elem->outputCoords();
 8341:          res[elem->idx*2    ] = coords.x;
 8342:          res[elem->idx*2 + 1] = coords.y;
 8343:          break;
 8344:    }
 8345: }
