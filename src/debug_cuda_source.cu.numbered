 3369: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3370:    // Returns the value of the velocity at the side center
 3371:    const double w1 = getBoundaryArrayValueWeight();
 3372:    const double w2 = 1.0 - w1;
 3373:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3374:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3375: 
 3376:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3377: }
