 1418:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1419:       // Compute the different time ramps used in the code 
 1420:       // This function is performed by just one thread
 1421: 
 1422:       if constexpr(ibc == 0) {
 1423:          if (drampbc > 0.0) {
 1424:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1425:          } else {
 1426:             rampbc = 1.0;
 1427:          }
 1428: 
 1429:          if (nws != 0 && drampwind > 0.0) {
 1430:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1431:          } else {
 1432:             rampwind = 1.0;
 1433:          }
 1434:       }
 1435: 
 1436:       if (drampwafo > 0.0) {
 1437:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1438:       } else {
 1439:          rampwafo = 1.0;
 1440:       }
 1441: 
 1442:       // For source/sinks
 1443:       if (if_source && dramp_ss > 0.0) {
 1444:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1445:       } else {
 1446:          ramp_ss = 1.0;
 1447:       }
 1448: 
 1449:       if (dramp > 0.0) {
 1450:          ramp = tanh(2.0*time/86400.0/dramp);
 1451:       } else {
 1452:          ramp = 1.0;
 1453:       }
 1454: 
 1455:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1456:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1457:    }
 1458:       
 1459: 
 1460:    __global__ void computeBedDeformation(void) {
 1461:       printf("NOT IMPLEMENTED: computeBedDeformation\n");
 1462: 
 1463:    }
