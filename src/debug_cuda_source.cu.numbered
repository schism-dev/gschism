 1093:    double vobc2;   // Velocity coefficient 2
 1094: 
 1095:    // Tracer boundary conditions
 1096:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1097:    // int  itrtype[natrm];    // Tracer boundary condition type
