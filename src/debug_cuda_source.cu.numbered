 1913: __inline__ __device__ void Element::getSidesContainingNode(const Node *node, int &idx1, int &idx2) const {
 1914: // Finds the indices of the two sides that share the node in the element. Assumes that the node is part of the element.
 1915: 
 1916:    idx1 = -1;
 1917:    idx2 = -1;
 1918:    
 1919:    // Check all sides systematically
 1920:    if (sides[0]->n1 == node || sides[0]->n2 == node) {
 1921:       idx1 = 0;
 1922:    }
 1923: 
 1924:    if (sides[1]->n1 == node || sides[1]->n2 == node) {
 1925:       if (idx1 == -1) idx1 = 1;
 1926:       else { idx2 = 1; return; }
 1927:    }
 1928: 
 1929:    if (sides[2]->n1 == node || sides[2]->n2 == node) {
 1930:       if (idx1 == -1) idx1 = 2;
 1931:       else { idx2 = 2; return; }
 1932:    }
 1933: 
 1934:    if (isQuad() && (sides[3]->n1 == node || sides[3]->n2 == node)) {
 1935:       idx2 = 3;
 1936:    }
 1937:    
 1938:    assert(idx1 >= 0 && idx2 >= 0 && "Element should have exactly two sides containing the node");
 1939: }
 1940: 
 1941: 
 1942: __inline__ __device__ bool Element::containsSegment(const Node *node, const Point2 &xt) const {
 1943: // If we call x0 = node->p, this function returns true if the segment x0xt is contained in the element (in the sense that the wedge formed by the node and its
 1944: // adjacent sides (in the element) include the segment x0xt). 
 1945: // This is in a 'closed' sense, meaning that it covers the cases where x0xt is actually along one of these sides.
 1946: 
 1947:    // Find the two sides containing the node
 1948:    int idxSide1, idxSide2;
 1949:    getSidesContainingNode(node, idxSide1, idxSide2);
 1950: 
 1951:    const Vector2 x0 = node->p;
 1952:     
 1953:    // Obtain the normal vector to the two sides containing the node in the direction inward the element
 1954:    // ssign is positive when side->n points outward, so -ssign gives inward direction
 1955:    const Vector2 n1 = -ssign[idxSide1] * sides[idxSide1]->n;
 1956:    const Vector2 n2 = -ssign[idxSide2] * sides[idxSide2]->n;
 1957: 
 1958:    const Vector2 seg = (xt - x0);
 1959:    return (dot(n1, seg) >= -geometricEpsilon && dot(n2, seg) >= -geometricEpsilon);
 1960: 
 1961: }
 1962: 
 1963: 
 1964: 
 1965: 
 1966: /**
 1967:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1968:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1969:    If the segment is completely inside the element, then it returns true.
 1970: 
 1971:    This function assumes:
 1972:    - The initial point is on a side of the element. 
 1973:    - Its position is given by parameter t in the range [0,1].
 1974:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1975:       intersects the element (elements are convex).
 1976: 
 1977:    To find the intersection point, this function does the following:
 1978:    - it finds the intersection of the line segment with all the element side lines,
 1979:       except for the one that contains the initial point.
 1980:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1981:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1982:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1983:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1984:       track segment is almost parallel to the element side line.
 1985: 
 1986:    Inputs:
 1987:    @param x1: starting point of the line segment
 1988:    @param x2: other end of the line segment
 1989: 
 1990:    Outputs:
 1991:    @param side:  side that intersects the line segment 
 1992:    @param nextElement (output):  element at that shares the intersection point with this element
 1993:    @param t (output): Parametric value of the intersection point on the side (0 <= t <= 1)
 1994:    @param tIntersect (output): Parametric value of the intersection point on the track segment x1x2 (0 <= tIntersect <= 1)
 1995: 
 1996:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1997:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1998:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1999: 
 2000:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2001:    (Delta) being zero.
 2002: 
 2003:    The intersection2 point happens when:
 2004:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2005:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2006:    
 2007:    Assumption: the 4 points (including those of the side segment) are different.
 2008:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2009:    
 2010: **/
 2011: __device__ void Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2012:                                               double &t, double &tIntersect) {
 2013:    assert( containsPoint2(x1) && "Starting point is not inside the element");                                    
 2014:    assert(!containsPoint2(x2) && "Ending point is not outside the element");
 2015: 
 2016:    double closest_intersect_t = 1e10;
 2017:    bool found_intersection = false;
 2018: 
 2019:    for (int i = 0; i < i34; i++) {
 2020: 
 2021:       Side *side2 = sides[i];
 2022: 
 2023:       // (x3,y3)-(x4,y4) is the element side line
 2024:       const Point2 x3 = side2->n1->p;
 2025:       const Point2 x4 = side2->n2->p;
 2026: 
 2027:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2028:       const double delta = cross(x2 - x1, x3 - x4);
 2029: 
 2030:       if (abs(delta) > 0) {
 2031: 
 2032:          const double delta1 = cross(x3 - x1, x3 - x4);
 2033:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2034: 
 2035:          // Solves the two linear equations for tt1 and tt2
 2036:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2037:          const double tt2 = delta2/delta;
 2038: 
 2039:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2040:             closest_intersect_t = min(closest_intersect_t, tt1);
 2041:             side = side2;
 2042:             nextElement = side->otherElem(this);
 2043:             t =          clamp(tt2, 0, 1.0);
 2044:             tIntersect = clamp(tt1, 0, 1.0);
 2045:             found_intersection = true;
 2046:          }
 2047: 
 2048:       
 2049:       }
 2050:       
 2051:    } // for
 2052: 
 2053:    assert(found_intersection && "No intersection found");
 2054: 
 2055: }
 2056: 
 2057: 
 2058: __forceinline__ __device__ bool Element::containsPoint2(Point2 x) const {
 2059:    // Check if the point (x,y) is inside the element. It does it by computing all the distances from the point to the sides (positive if inside, negative if outside)
 2060:    // And then checking if the minimum relative distance is larger than epsilon
 2061:    
 2062:    // ssign is positive if side->n is pointing outwards the element, negative if it is pointing inwards.
 2063:    double minDist = min3(-ssign[0]*sides[0]->relativeSignedDistanceToPoint(x),
 2064:                          -ssign[1]*sides[1]->relativeSignedDistanceToPoint(x),
 2065:                          -ssign[2]*sides[2]->relativeSignedDistanceToPoint(x));
 2066:    if (isQuad()) minDist = min(minDist, -ssign[3]*sides[3]->relativeSignedDistanceToPoint(x));
 2067: 
 2068:    return minDist > geometricEpsilon;
 2069: }
 2070: 
 2071: 
 2072: 
 2073: 
 2074: __inline__ __device__ double Element::computeSignedArea(void) const {
 2075:    // Compute the area of the element
 2076: 
 2077:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2078: 
 2079:    // In the quad case we need to add the area of the other triangle.
 2080:    if (isQuad()) {
 2081:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2082:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2083:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2084:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2085: 
 2086:       res += ar1;
 2087:    }
 2088: 
 2089:    return res;
 2090: }
 2091: 
 2092: 
 2093: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2094:                                                                 (nodes[1]->isDry2()) ||
 2095:                                                                 (nodes[2]->isDry2()) ||
 2096:                                                                 (i34==4 && nodes[3]->isDry2());
 2097: }
 2098: 
 2099: __inline__ __device__ double Element::detJ_eta(void) const {
 2100:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2101:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2102: }
 2103: 
 2104: __inline__ __device__ double Element::detJ_xi(void) const {
 2105:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2106:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2107: }
