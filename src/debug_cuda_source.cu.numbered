 4155:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4156: 
 4157:       NODE_BND(nodeBnd);
 4158: 
 4159:       Node *node = nodeBnd->node;
 4160: 
 4161:       node->ETP = 0.0;
 4162: 
 4163:       for (int j=0; j<ntip; j++) {
 4164: 
 4165:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4166:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4167:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4168: 
 4169:          if constexpr(iloadtide==1) { // loading tide
 4170:             assert(false && "Loading tide not implemented");
 4171:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4172:          }
 4173:          
 4174:       }
 4175:       
 4176:    }
