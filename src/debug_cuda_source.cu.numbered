  794: struct Side {
  795: 
  796:    // Geometry information
  797:    int idx;               // Index of the side
  798:    Node *n1, *n2;
  799:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  800: 
  801:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  802:    Vector2 center;        // Location of side center. 
  803:    double zc[nvrt];       // Side center z-coord at each vertical level
  804: 
  805:    Frame frame;
  806: 
  807:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  808:                           // this is nullptr
  809:    
  810:    int kb;                // Bottom index of the side
  811:    bool isDry;             // True if the side is dry
  812:  
  813:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  814: 
  815:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  816: 
  817:    // Physical information
  818:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  819:    double  w2[nvrt];            // Vertical velocity at each vertical level
  820:    Vector2 btu[nvrt];           // Back-tracked velocity
  821:    Vector2 uth[nvrt];           // "Time history" velocity
  822:    Vector2 U;                   // Vertically averaged velocity vector  
  823: 
  824:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  825: 
  826:    Vector2 bcc[nvrt];           // Baroclinic term
  827:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  828: 
  829:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  830:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  831:    Vector2 gradPr;               // Gradient of pressure
  832:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  833: 
  834: 
  835:    double hhat;                 // \breve{H} in notes
  836: 
  837:    double shapiro;
  838: 
  839:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  840: 
  841:    double coriolis;             // Coriolis parameter
  842: 
  843:    // Vegetation parameters
  844:    double veg_c2;
  845:    double veg_beta;
  846: 
  847:    // Bottom drag parameters.
  848:    double chi;
  849:    double chi2;
  850: 
  851:    __inline__ __device__ double x(double t) const;
  852:    __inline__ __device__ double y(double t) const;
  853:    __inline__ __device__ Point2 p_t(double t) const;
  854: 
  855:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  856:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  857:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  858: 
  859:    __inline__ __device__ Side* neigh(int index) const { 
  860:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  861:       assert(index >= 0 && index < 4); 
  862:       assert(elems[0] != nullptr && elems[1] != nullptr);
  863: 
  864:       const int ielem = index & 1;           // 0 or 1
  865:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  866: 
  867:       const Element* elem = elems[ielem];
  868: 
  869:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  870: 
  871:       return elem->sides[elem->nxq(locSideIdx + iside)];
  872: 
  873:    }
  874: 
  875:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  876: 
  877:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  878: 
  879:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  880:    __inline__ __device__ bool isBnd2(void) const { return elems[0] == nullptr; } // This is a different type of being boundary. XXXXX CHECK IF THIS THE SAME
  881:    __inline__ __device__ int iadv(void) const;
  882: 
  883:    __inline__ __device__ double grav3(void) const;
  884:    
  885:    __inline__ __device__ double eta2(void) const;
  886:    __inline__ __device__ double eta1(void) const;
  887:    __inline__ __device__ double depth(void) const;
  888:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  889:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  890: 
  891:    __inline__ __device__ double dfv(int k) const;
  892: 
  893:    __inline__ __device__ double veg_h(void)  const;
  894:    __inline__ __device__ double veg_nv(void) const;
  895:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  896:    __inline__ __device__ double veg_alpha3D(int k) const;
  897:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  898: 
  899:    __inline__ __device__ double etaMeanBnd(void) const;
  900: 
  901:    __inline__ __device__ double Cd(void) const;
  902: 
  903:    __inline__ __device__ Vector2 tau(void) const;
  904: 
  905:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  906:    
  907: 
  908:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  909:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  910:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  911:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  912:    } 
  913:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  914:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  915:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  916:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  917: 
  918:    // Get valid starting element (for backtracking)
  919:    __inline__ __device__ Element* getStartElement() {
  920:       return elems[0] ? elems[0] : elems[1];
  921:    }
  922: 
  923:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  924:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  925: 
  926:       // If one of the elements is null, return the other one
  927:       if      (elems[0] == nullptr) return elems[1];
  928:       else if (elems[1] == nullptr) return elems[0];
  929: 
  930: 
  931:       // Dot product of the negative velocity vector with the side normal vector
  932:       const double dot_prod1 = -dot(u, n);
  933:       
  934:       // Vector from side center to element 0 centroid
  935:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  936: 
  937:       // Dot product of the vector with the side normal vector
  938:       const double dot_prod2 = dot(v2, n);
  939: 
  940:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  941:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  942: 
  943:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  944:       else                           return elems[1];
  945: 
  946:  
  947:    }
  948: 
  949:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  950:       // Given an element, returns the other element that shares this side
  951:       return (elems[0] == elem) ? elems[1] : elems[0];
  952:    }
  953: 
  954:    __forceinline__ __device__ Node* otherNode(Node* node) {
  955:       // Given a node, returns the other node that shares this side
  956:       return (n1 == node) ? n2 : n1;
  957:    }
  958:  
  959:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  960: 
  961: 
  962: 
  963: 
  964: };
  965: 
  966: 
  967: // This struct is used to store the boundary information for a node.
  968: struct NodeBoundary {   
  969:    BoundarySegment *segment;
  970:    Node *node;
  971:    
  972:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  973:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  974: 
  975:    double etaic;  // Elevation at nodes used for essential boundary conditions
  976:    double elbc;   // Elevation boundary condition
  977:    int iettype;   // Type of elevation boundary condition
  978:    double eth;    // Elevation time history
  979: 
  980:    double eta_mean; // Mean elevation at nodes
  981: 
  982:    bool isEssentialBC;
  983: 
  984: 
  985:    // Arrays for harmonic constituents (if needed)
  986:    double emo[nbfr];  // Elevation amplitude
  987:    double efa[nbfr];  // Elevation phase
  988:    double umo[nbfr];  // U-velocity amplitude
  989:    double ufa[nbfr];  // U-velocity phase
  990:    double vmo[nbfr];  // V-velocity amplitude
  991:    double vfa[nbfr];  // V-velocity phase 
  992: 
  993:    
  994:    __forceinline__ __device__ int numSidesForAverage() const {
  995:    // Returns the number of sides that are connected to the node and have the same segment.
  996:    // This is used to compute the average velocity at the node for open boundary nodes.
  997:       int res = 0;
  998:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
  999:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1000:       return res;
 1001:    }
 1002: 
 1003: 
 1004:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1005:       assert(index == 0 || index == 1); 
 1006:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1007:    }
 1008: 
 1009: 
 1010: };
 1011: 
 1012: struct Node {
 1013: 
 1014:    // Geometry information
 1015:    int idx;        // Index of the node
 1016:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1017:    int numNodes;   // Number of nodes neighbors of this node
 1018: 
 1019:    Element **elements; // Array of pointers to the elements that share this node
 1020:    int numElements;    // Number of elements that share this node
 1021: 
 1022:    int numSides;       // Number of sides that are connected to this node
 1023: 
 1024:    Point3 p;
 1025:    Vector3 u2[nvrt];
 1026:    double z[nvrt];
 1027:    double lon, lat;
 1028:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1029:    double depth;
 1030: 
 1031:    int kb;       // Bottom index of the node
 1032: 
 1033:    bool isDry;     // True if the node is dry
 1034: 
 1035:    int iadv;     // Advection flag
 1036: 
 1037:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1038:                           // this is nullptr
 1039: 
 1040:    TempVar tmp; // Temporary variable to store different types of variables
 1041: 
 1042:    // Physical information
 1043:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1044:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1045: 
 1046:    double rho[nvrt];     // Density
 1047:    double dfv[nvrt];     // Vertical viscosity
 1048: 
 1049:    double eta1; // Elevation at nodes at previous timestep
 1050:    double eta2; // Elevation at nodes at current timestep
 1051: 
 1052:    double ETP;  // Earth Tidal Potential
 1053: 
 1054:    double pr;    // Air pressure
 1055:    double grav2; // Gravity 
 1056:    
 1057:    Vector2 dav;  // Depth averaged velocity
 1058: 
 1059:    Vector2 tau; // Wind stress vector
 1060: 
 1061:    // Vegetation parameters
 1062:    double veg_h;
 1063:    double veg_nv;
 1064:    double veg_di;
 1065:    double veg_Cd;
 1066:    double veg_h_unbent;
 1067:    double veg_di_unbent;
 1068:    double veg_nv_unbent;
 1069:    double veg_alpha_vert_mean;
 1070:    double veg_alpha0;
 1071:    double veg_alpha3D[nvrt];
 1072: 
 1073:    // Bottom drag parameters
 1074:    double Cd;       // Bottom drag coefficient
 1075:    double rough;    // Bottom roughness length
 1076:    Vector2 tau_bot; // Bottom stress vector
 1077: 
 1078:    double bdef1; // Bottom deformation at previous timestep
 1079:    double bdef2; // Bottom deformation at current timestep
 1080: 
 1081:    double qel; // RHS
 1082:    double coeffDiag; // Diagonal coefficient of the matrix
 1083:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1084: 
 1085:    double mP; // Search direction for conjugate gradient method
 1086:    double mR; // Residual for conjugate gradient method
 1087:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1088:    double mX; // Solution for conjugate gradient method
 1089: 
 1090:    // Meteorological forcing
 1091:    Vector2 u_air;
 1092:    double p_air;
 1093:    double t_air;
 1094:    double q_air;
 1095:    double wind_angle;  // Wind rotation angle
 1096: 
 1097:    __device__ void setWind(Vector2 &u) {
 1098:    // Sets the wind vector taking into account the wind rotation angle
 1099:    
 1100:       const double dir = atan2(-u.x,-u.y);
 1101:       const double speed = length(u);
 1102: 
 1103:       // Calculate new u and v components with added rotation angle
 1104:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1105:    }
 1106: 
 1107:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1108: 
 1109:    __device__ double sigmaTransitionDepth(void) const;
 1110: 
 1111:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1112:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1113:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1114: 
 1115:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1116: 
 1117:    __device__ void clearMatrixRow(void) {
 1118:       // Clear the matrix row for this node
 1119:       coeffDiag = 0.0;
 1120:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1121: 
 1122:    }
 1123: 
 1124:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1125:       // Add the value to the sparse matrix for this node
 1126:       
 1127:       if (node == this) {
 1128:          coeffDiag += value;
 1129: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1130:       } else {
 1131:          // Search (linearly)the index of the node in the array of nodes
 1132:          // XXX: This is not efficient, see if we can improve this
 1133:          int i;
 1134:          for (i = 0; i < numNodes; i++) {
 1135:             if (nodes[i] == node) {
 1136:                break;
 1137:             }
 1138:          }
 1139:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1140:          coeffMatrix[i] += value;
 1141:       }
 1142:    }
 1143: 
 1144: #ifdef BACKTRACKING
 1145:    __device__ void updateZCoordData() {
 1146:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1147: 
 1148:       // Check if node is wet
 1149:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1150: 
 1151:       if (idry) return;
 1152: 
 1153:       if constexpr(ivcor == 2) {  // SZ coordinates
 1154:          
 1155:          // Compute bottom level index
 1156:          if (depth <= mesh->h_s) {
 1157:                kb = mesh->nzlevels;
 1158:          } else {
 1159:                kb = -1;
 1160:                for (int i = 0; i < mesh->kz-1; i++) {
 1161:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1162:                      kb = i;
 1163:                      break;
 1164:                   }
 1165:                }
 1166:          }
 1167:       } 
 1168:       else if (ivcor == 1) {  // Localized sigma
 1169:          // Do nothing
 1170:       }
 1171: 
 1172:    }
 1173: #endif   
 1174: 
 1175:    __device__ double compZCoord(int k) const;
 1176: 
 1177:    __device__ void updateKb(void);
 1178: 
 1179: 
 1180: 
