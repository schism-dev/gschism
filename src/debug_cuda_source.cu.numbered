 7241: #ifdef DONTCOMPILE
 7242: __device__ void computeVerticalAdvection(void) {
 7243:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7244: 
 7245:    sdbt(1:2,:,:)=0.d0
 7246: 
 7247:    const Side *side = FROM kernel;
 7248: 
 7249:    if(side->isDry) return;
 7250: 
 7251:    // If side is wet...
 7252: 
 7253: 
 7254:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7255:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7256:    double ws[nvrt] = {} // w @ side
 7257:    int icount = 0;
 7258:    for (int j=0; j<2; j++) {
 7259:       const Element *elem = side->elements[j];
 7260:        
 7261:       if(elem != nullptr) {
 7262:          icount++;
 7263:          for (int k=0; k<nvrt; k++) {
 7264:             ws[k] = ws[k] + elem->w[k];
 7265:          }
 7266:       }
 7267:    }  // for j
 7268: 
 7269:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7270:    ws = ws/icount;
 7271: 
 7272:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7273:    // Splines allow for a smooth transition between vertical levels.
 7274:    // Splines have continuity restrictions at the internal knots, but
 7275:    // we have to provide the 1st derivatives at the endpoints.
 7276:    const int kbs = side->kbs; 
 7277:    
 7278:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7279:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7280:    initCubicSpline(kbs, nvrt, side, ws, up)
 7281: 
 7282:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7283:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7284:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7285: 
 7286:    // Total advection (average onto side)
 7287:    const Node *node1 = side->nodes[0];
 7288:    const Node *node2 = side->nodes[1];
 7289:    for (int k=kbs(i); k<nvrt; k++) {
 7290: 
 7291:       Vector2 bcc1 = node1->bcc[k];
 7292:       Vector2 bcc2 = node2->bcc[k];
 7293:       if constexpr(ics == 2) {
 7294:          // Project the velocities from the node frames to the side frame
 7295:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7296:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7297:       }
 7298: 
 7299:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7300:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7301: 
 7302:    }
 7303: }
 7304: #endif
 7305: 
 7306: 
 7307: extern "C" {
 7308:    __global__ void computeElemAverageGhat(void) {
 7309:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7310: 
 7311:       ELEM(elem);
 7312:       
 7313:       elem->ghat1= {0.0, 0.0};  
 7314: 
 7315:       if constexpr(ihydraulics != 0) {
 7316:          if (nhtblocks > 0 && elem->isblock) return;
 7317:       }
 7318: 
 7319:       
 7320:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7321:       // cff1-3: coefficients for 2D/3D
 7322: 
 7323:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7324:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7325:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7326: 
 7327:       if (elem->isDry) return;
 7328: 
 7329:       // Average of the coefficients
 7330:       double av_cff1 = 0.0;  // av. for cff1
 7331:       double av_cff2 = 0.0;  // av. for cff2
 7332:       double av_cff3 = 0.0;  // av. for cff3
 7333:       double av_df = 0.0;  // av. for H^\alpha / H
 7334:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7335:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7336: 
 7337:       const int i34 = elem->i34;
 7338:       const int kb  = elem->kb;
 7339: 
 7340:       for (int j=0; j<i34; j++) {
 7341:          // For each node and side in the element...
 7342: 
 7343:          const Node *node = elem->nodes[j];
 7344:          const Side *side = elem->sides[j];
 7345: 
 7346:          const double chi      = side->chi;
 7347:          const double veg_c2   = side->veg_c2;
 7348:          const double veg_beta = side->veg_beta;
 7349:          const double veg_h    = side->veg_h();
 7350:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7351: 
 7352:          const Vector2 gradPhi = elem->gradPhi[j];
 7353: 
 7354:          // Node - const in elem
 7355:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7356:          elem->gradPr  += node->pr  *gradPhi;
 7357: 
 7358:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7359: 
 7360:         
 7361:          const double htot  = side->htot2();        // Total depth at the side
 7362:          const double zctr2 = side->zTopCanopy();  
 7363: 
 7364:          double cff1; 
 7365:          double cff2; 
 7366:          double cff3;   
 7367:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7368:          // coefficients applied to 2D/3D case 
 7369:             cff1 = side->hhat/htot;
 7370:             cff2 = 0.0;
 7371:             cff3 = 0.0;
 7372:          } else { //3D
 7373:             //Init for no-veg case
 7374:             cff1 = 1.0;
 7375:             cff2 = 1.0;
 7376:             cff3 = 0.0;
 7377: 
 7378:             if constexpr(iveg != 0) {
 7379:                // Computes coefficients used with vegetation terms G1, G2
 7380:                // cff1, cff3 are used for the first two terms in G1, G2:
 7381:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7382:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7383:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7384:                if(veg_h < 0.99*htot) { // submergent vegetation
 7385:                   cff1 = 1.0;
 7386:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7387:                   cff3 = veg_c;
 7388: 
 7389:                } else { // emergent vegetation
 7390:                   cff1 = 1.0/(1.0 + veg_c2);
 7391:                   cff2 = cff1;
 7392:                   cff3 = 0.0;
 7393: 
 7394:                }
 7395:             } // if iveg
 7396:          } //  2D/3D
 7397: 
 7398:          av_cff1 += cff1/i34;
 7399:          av_cff2 += cff2/i34;
 7400:          av_cff3 += cff3/i34;
 7401:          av_cff2_chi += cff2*chi/i34;
 7402:          av_cff3_chi += cff3*chi/i34;
 7403:          av_df += min(htot, veg_h)/(htot*i34);
 7404: 
 7405: 
 7406:          // btrack values: U^\star, U^{\star\alpha}
 7407:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7408:          Vector2 Ustar       = {0.0, 0.0}; 
 7409:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7410: 
 7411:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7412:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7413:          } else { //3D
 7414:             for (int k = side->kb + 1; k < nvrt; k++) {
 7415:             
 7416:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7417:                Ustar += w2;
 7418: 
 7419:                if constexpr(iveg != 0) {
 7420:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7421:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7422:                        Ustar_alpha += zrat*w2; // XXXX
 7423:                    }
 7424:                }  // if iveg
 7425:             }  // for k
 7426:          }  //2D/3D
 7427: 
 7428:          // If needed, project the side velocities to the element frame
 7429:          if constexpr(ics==2) {
 7430:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7431:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7432:          }
 7433:         
 7434: 
 7435:          // Add btrack & surface stress terms to \breve{G} first
 7436:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7437: 
 7438: 
 7439:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7440:          Vector2 tau    = side->tau();  
 7441:          Vector2 ubstar = side->btu[side->kb + 1];  
 7442: 
 7443:          // If needed, project tau and ubstar to the element frame
 7444:          if constexpr(ics==2) {
 7445:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7446:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7447:          }
 7448: 
 7449:          // Term for surface and bottom stress
 7450:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7451: 
 7452: 
 7453:          // All terms in F,F^\alpha,f_b except baroclinic
 7454:          // F, f_b: all explicit terms excluding vegetation 
 7455:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7456:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7457:          const double coriolis = side->coriolis;
 7458:          Vector2 F  =  coriolis*side->U;  // F_x
 7459:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7460:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7461: 
 7462:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7463:             
 7464:             for (int k = side->kb; k < nvrt; k++) {
 7465:                if (zctr2 > side->zc[k-1]) {
 7466:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7467:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7468:                    Fa +=  coriolis*w2*zrat;
 7469:                } // if zctr2
 7470:             } // k
 7471:          } // iveg
 7472: 
 7473:          // Integrate horizontal viscosity force vertically
 7474:          for (int k=side->kb + 1; k<nvrt; k++) {
 7475:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7476: 
 7477:             F += levelHorVisc;
 7478: 
 7479:             // Vegetation term
 7480:             if constexpr(iveg!=0) {
 7481:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7482:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7483:                   Fa += levelHorVisc*zrat;
 7484:                } 
 7485:             } // if iveg
 7486:          } // for k
 7487: 
 7488:          // Get nu*grad(U) at the side's bottom level
 7489:          Vector2 nuGradU = side->nuGradU[side->kb];
 7490: 
 7491:          fb += nuGradU;
 7492: 
 7493:          // If needed, project vectorsF, fb and Fa to the element frame
 7494:          if constexpr(ics==2) {
 7495:             F    = side->frame.projHorVec(F,    elem->frame);
 7496:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7497:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7498:          } // if ics
 7499: 
 7500:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7501:       } // for j (nodes and sides)
 7502: 
 7503:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7504: 
 7505: 
 7506:       // Finish off terms in F, F^\alpha and f_b
 7507:       const double grav3 = elem->mean(&Node::grav2);
 7508:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7509:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7510:       for (int j=0; j<i34; j++) { 
 7511:          // For each side in the element...
 7512:          const Side *side = elem->sides[j];
 7513:          const double chi = side->chi;
 7514: 
 7515:          const double htot = side->htot2();
 7516:          const double veg_h = side->veg_h();
 7517:          const Vector2 F  = htot*fb;
 7518:          const Vector2 Fa = min(htot, veg_h)*fb;
 7519: 
 7520:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7521:       } // for j
 7522: 
 7523:       // tmp is already in elem frame
 7524:       elem->ghat1 += tmp/i34;
 7525: 
 7526:       // Baroclinic force
 7527:       if constexpr(ibc==0) {
 7528:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7529: 
 7530:          Vector2 Fa = {0.0, 0.0};
 7531:          Vector2 intGradRho = {0.0, 0.0};
 7532:          
 7533:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7534:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7535:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7536: 
 7537:             // \in F [m^2/s/s]
 7538:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7539:          }
 7540: 
 7541:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7542:          const Vector2 F = av_df*Fa; //approx
 7543:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7544: 
 7545:       } // if ibc
 7546: 
 7547: 
 7548: 
 7549:    }
 7550: 
 7551: } // extern "C"
 7552: 
 7553: 
 7554: 
 7555: #ifdef DONTCOMPILE
 7556: __global__ void checkMassConservation(Tracers* sumtr) {
 7557: 
 7558:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7559: 
 7560:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7561: 
 7562:    Element *elem = &(mesh->localElemData[i]);
 7563: 
 7564:    // Skip dry elements
 7565:    if (elem->isDry) return;
 7566: 
 7567:    // Local sum array for this thread
 7568:    double localSum[N_TRACERS] = {0.0};
 7569: 
 7570:    // Sum over vertical levels for this element
 7571:    const int kbe = elem->kbe;
 7572:    const double area = elem->area;
 7573: 
 7574:    for (int k = kbe; k < nvrt; k++) {
 7575:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7576:       
 7577:       // Accumulate tracer mass
 7578:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7579:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7580:       }
 7581:    }
 7582: 
 7583:    //  This function returns per element sums. A reduction must be done on the host side.
 7584: }
 7585: 
 7586: 
 7587: __global__ void transport(void) {
 7588: 
 7589:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7590: 
 7591:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7592: 
 7593:    Element *elem = &(mesh->localElemData[ie]);
 7594: 
 7595:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7596: 
 7597:                for (int m=0; m<ntr; m++) {
 7598:                   for (int k=kbe(ie); k<nvrt; k++) {
 7599:                      // Calculate each polynomial's weight 
 7600:                      wm=0.d0; sum1=0.d0; 
 7601:                      wm1=0.d0; wm2=0.d0; 
 7602:                      for (int i=0; i<elem->nweno2; i++) {
 7603:                   
 7604:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7605:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7606:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7607:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7608:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7609:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7610:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7611:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7612:                      // -----------------Hu and Shu (1999)'s method----------------
 7613:                      b4=b1+b2+b3
 7614: 
 7615: //Error: add PRODUCTION CPP
 7616: #ifdef DEBUG
 7617:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7618:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7619:                     call parallel_abort(errmsg)
 7620:                   }
 7621: #endif
 7622: 
 7623:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7624:                   // !----test-------------- 
 7625:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7626:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7627:                   // !wm(i)=wm1(i)*wm2(i)
 7628:                   // !---------------------- 
 7629:                   sum1=sum1+wm(i)
 7630:                 } // end for i
 7631: 
 7632:                 wm=wm/sum1
 7633: 
 7634:                 for (int j=0; j<elem->i34; j++) {
 7635: 
 7636:                   const Side *side  = elem->sides[j];
 7637:                   const Node *node1 = side->n1;
 7638:                   const Node *node2 = side->n2;
 7639: 
 7640:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7641:                      trsd=0.d0
 7642:                      for (int kk=0; kk<nquad; kk++) {
 7643:                         for (int i=0; i<elem->nweno2; i++) {
 7644:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7645:                         } // end for i   
 7646:                      } // end for kk
 7647:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7648:                   } // outward flux
 7649:                } // end for j=1,i34(ie) ! side
 7650:             }
 7651:          }
 7652:               
 7653: 
 7654: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7655: //             //   calculate each polynomial's weight 
 7656: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7657: //                 wm=0.d0; sum1=0.d0
 7658: //                 do i=1,nweno1(ie) !for each polynomial
 7659: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7660: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7661: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7662: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7663: //                   wm(i)=b2
 7664: //                   sum1=sum1+b2
 7665: //                   !wm(i)=1.d0
 7666: //                   !sum1=sum1+1.d0
 7667: 
 7668: // // Error: PRODUCTION
 7669: // #ifdef DEBUG
 7670: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7671: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7672: //                     call parallel_abort(errmsg)
 7673: //                   endif
 7674: // #endif
 7675: 
 7676: //                 enddo !i
 7677: //                 wm=wm/sum1 !final weight
 7678: 
 7679:                 for (int j=0; j<elem->i34; j++) { // side
 7680:                   const Side *side = elem->sides[j];
 7681:                   const Node *node1 = side->n1;
 7682:                   const Node *node2 = side->n2;
 7683: 
 7684:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7685:                     trsd=0.d0
 7686:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7687:                       for (int i=0; i<elem->nweno1; i++) {
 7688:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7689:                       }
 7690:                     enddo //kk
 7691:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7692:                   } // outward flux
 7693:                 } // end for j=1,i34(ie) ! side
 7694:               } // end for k; ntr 
 7695: 
 7696:             else !simple upwind method
 7697:               do j=1,i34(ie)
 7698:                 jsj=elside(j,ie)
 7699:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7700:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7701:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7702:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7703:                   endif
 7704:                 enddo  !vertical layers
 7705:               enddo !j=1,i34(ie) ! side
 7706:             endif !order of accuracy
 7707: 
 7708:          //  enddo !ie
 7709: // !$OMP     end do
 7710: 
 7711: // !$OMP     master
 7712: //           !message passing
 7713: //           if (nproc>1) then
 7714: //             !make a copy of side concentrations
 7715: //             trsd_tmp0=trsd_tmp 
 7716: 
 7717: //             !this exchange routine swaps interface concentration between two partitions
 7718: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7719: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7720: 
 7721: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7722: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7723: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7724: 
 7725: 
 7726: //             !This obtains final values for interface sides
 7727: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7728: //       :    endif !nproc>1
 7729: //           !message passing end
 7730: // !$OMP     end master
 7731: // !$OMP     barrier
 7732: 
 7733: 
 7734: // !         Do advection; conc @ dry elem will not be changed
 7735: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7736: // !$OMP     do reduction(+: h_mass_in)
 7737: //           do i=1,ne
 7738: //             if(idry_e(i)==1) cycle
 7739: 
 7740: 
 7741: // !           Wet elements with 3 wet nodes
 7742: //             do k=kbe(i)+1,nvrt
 7743: 
 7744: 
 7745: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7746: //               dtb_by_bigv = dtb/bigv
 7747:     
 7748: // !             Advective flux
 7749: //               if (ntd_weno==1 .or. itd_weno==1) then
 7750: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7751: //               else
