 3615:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3616:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3617:                 int *isdel, int *isidenode, int *isbnd,
 3618:                 int *nond, int *nlnd, int *iond, int *ilnd, 
