 7251: 
 7252: __global__ void computeMatrixProductAndDotProducts() {
 7253:    // Computes A*p, r'Mr and p'Ap
 7254: 
 7255:    // 1) shared buffer: first half for rMr, second for pAp
 7256:    __shared__ double sdata[2*BLOCK_SIZE];
 7257:    double* s_rMr = sdata;
 7258:    double* s_pAp = sdata + BLOCK_SIZE;
 7259: 
 7260:    s_rMr[threadIdx.x] = 0.0;
 7261:    s_pAp[threadIdx.x] = 0.0;
 7262: 
 7263:    // 2) get your node pointer
 7264:    NODE(node);  
 7265:    const int tid = threadIdx.x;
 7266: 
 7267:    const double diag = node->coeffDiag;
 7268:    const double r    = node->mR;
 7269:    const double p    = node->mP;  
 7270: 
 7271:    // apply preconditioner on the fly:
 7272:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7273: 
 7274:    // 4) compute Ap = A.p
 7275:    double Ap = node->coeffDiag * node->mP;
 7276:    for (int j = 0; j < node->numNodes; ++j) {
 7277:       const Node *nbNode = node->nodes[j];
 7278:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7279: 
 7280:    }
 7281:    node->mAp = Ap;
 7282:     
 7283: 
 7284:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7285:    const double l_rMr = r*Mr;  // r'Mr
 7286:    const double l_pAp = p*Ap;  // p'Ap
 7287: 
 7288:    // 6) write into shared mem
 7289:    s_rMr[tid] = l_rMr;
 7290:    s_pAp[tid] = l_pAp;
 7291: 
 7292:    __syncthreads();
 7293: 
 7294:    // 7) block-wide tree reduction
 7295:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7296:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7297:       __syncthreads();
 7298:    }
 7299: 
 7300:    // 8) thread 0 atomically accumulates into the globals
 7301:    // XXX: This is slower than it needs to be, but it is simple and works
 7302:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7303: 
 7304: 
 7305: }
 7306: 
 7307: 
 7308: __global__ void updateSolutionAndDotProducts(void) {
 7309:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7310: 
 7311:    s_rMr[threadIdx.x] = 0.0;
 7312: 
 7313: 
 7314:    // get node & bounds-check:
 7315:    NODE(node);
 7316:    const int tid = threadIdx.x;
 7317: 
 7318: 
 7319:    // Compute alpha
 7320:    const double alpha = (*rMr_old)/(*pAp);
 7321: 
 7322:    // load scalars
 7323:    const double diag = node->coeffDiag;
 7324:    const double p    = node->mP;
 7325:    const double Ap   = node->mAp;
 7326:    const double x    = node->mX;
 7327:    const double r    = node->mR;
 7328:    
 7329:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7330: 
 7331:    // 1) update solution & residual
 7332:    const double x_new = x + alpha*p;
 7333:    const double r_new = r - alpha*Ap;
 7334:    node->mX = x_new;
 7335:    node->mR = r_new;
 7336: 
 7337:    // 2) apply Jacobi preconditioner on the fly
 7338:    const double Mr_new = r_new/diag;
 7339: 
 7340: 
 7341:    // 3) local contributions for the two dot-products
 7342:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7343: 
 7344:    // 4) write into shared-mem
 7345:    s_rMr[tid] = l_rMr;
 7346: 
 7347:    __syncthreads();
 7348: 
 7349: 
 7350:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7351:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7352:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7353:       __syncthreads();
 7354:    }
 7355: 
 7356:    // 6) thread 0 atomically folds into the global accumulators
 7357:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7358: 
 7359: 
 7360: }
 7361: 
 7362: 
 7363: __global__ void updateSearchDirection() {
 7364:     NODE(node);
 7365: 
 7366:     // recompute z on-the-fly
 7367:     const double z = node->mR / node->coeffDiag;
 7368:     const double p = node->mP;
 7369: 
 7370:     const double beta = (*rMr_new)/(*rMr_old);
 7371: 
 7372: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 7373: 
 7374:     // p =z + beta*p
 7375:     node->mP = z + beta*p;
 7376: 
 7377: }
 7378: 
 7379: __global__ void initializePreconditionedResidual(double *scalars) {
 7380: 
 7381:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7382: 
 7383:     s_rMr[threadIdx.x] = 0.0;
 7384: 
 7385:     NODE(node);
 7386:     const int tid = threadIdx.x;
 7387:     // For the first iteration:
 7388:     // 1. Initial solution x = 0 (already set)
 7389:     // 2. Initial residual r = b (stored in qel)
 7390:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7391: 
 7392: // XXX we should use the guess solution here    
 7393: 
 7394:     // Set initial residual r = b (from qel)
 7395:     node->mR = node->qel;
 7396: 
 7397:     // Compute z = M^-1 * r (preconditioned residual)
 7398:     const double z = node->mR / node->coeffDiag;
 7399: 
 7400:     // Set initial search direction p = z
 7401:     node->mP = z;
 7402: 
 7403:     // Initialize other variables needed for CG
 7404:     node->mX = 0.0;  // Initial solution
 7405:     node->mAp = 0.0; // Will be computed in first iteration
 7406: 
 7407:     // These point to a cupy array in the host code
 7408:     rMr_old = scalars + 0;
 7409:     rMr_new = scalars + 1;
 7410:     pAp     = scalars + 2;
 7411: 
 7412:     // Computes the first r'Mr (reduction)
 7413:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7414: 
 7415:     // 4) write into shared-mem
 7416:     s_rMr[tid] = l_rMr;
 7417: 
 7418:     __syncthreads();
 7419: 
 7420: 
 7421:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7422:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7423:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7424:         __syncthreads();
 7425:     }
 7426: 
 7427:     // 6) thread 0 atomically folds into the global accumulators
 7428:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7429: 
 7430:     *rMr_old = 0.0;
 7431:     *pAp = 0.0;
 7432: }
