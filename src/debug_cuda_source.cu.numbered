 4153:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4154: 
 4155:       NODE_BND(nodeBnd);
 4156: 
 4157:       Node *node = nodeBnd->node;
 4158: 
 4159:       node->ETP = 0.0;
 4160: 
 4161:       for (int j=0; j<ntip; j++) {
 4162: 
 4163:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4164:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4165:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4166: 
 4167:          if constexpr(iloadtide==1) { // loading tide
 4168:             assert(false && "Loading tide not implemented");
 4169:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4170:          }
 4171:          
 4172:       }
 4173:       
 4174:    }
