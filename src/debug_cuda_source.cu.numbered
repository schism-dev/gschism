 1894: 
 1895: /**
 1896:  * Find the element that contains the target point.
 1897:  * 
 1898:  * @param x0,y0,z0     Starting position coordinates
 1899:  * @param xt,yt,zt     Target position coordinates
 1900:  * @param dtb          Time step for tracking
 1901:  * @param u_int        Initial velocity components
 1902:  * @param nextElem     Starting/resulting element index
 1903:  * 
 1904:  * @return Status code of type trackExitCodes
 1905:  * 
 1906:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1907:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1908:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1909:  * as close the the segment AB as possible, the next point at each iteration is computed
 1910:  * along segment AB, but just after the current element.
 1911:  */
 1912: 
 1913: 
 1914: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1915: 
 1916:    constexpr int MAX_ITERATIONS = 40;
 1917: 
 1918:    int iter = 0;
 1919:    double fac = 0.00001;
 1920:    while (iter < MAX_ITERATIONS) {
 1921:       iter++;
 1922: 
 1923:       Bool4 isLeft, isObtuse, isBisector;
 1924:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 1925: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 1926:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 1927: 
 1928: 
 1929:       if (isValid.none()) 
 1930:       // Inside the element if none of the edges is a valid continuation
 1931:       {
 1932:          // Just returns true and the element (curElem) is unchanged).
 1933:          // This means that the algorithm has found the element that contains the target point.
 1934:          return true;
 1935:       }
 1936:       else { // Outside the element
 1937: 
 1938:          // Outside this element. Pick the first valid exit side and cross.
 1939:          lastCrossSide = curElem->sides[isValid.firstOne()];
 1940:          Element *prevElem = curElem;
 1941:          curElem = lastCrossSide->otherElem(curElem);
 1942: 
 1943:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 1944:          // along the boundary.
 1945:          if (curElem == nullptr || curElem->isDry) {
 1946:          
 1947:             curElem = prevElem;
 1948:             return false;
 1949:          }
 1950:          
 1951:       }
 1952: 
 1953:    }
 1954: 
 1955:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 1956: }
 1957: 
