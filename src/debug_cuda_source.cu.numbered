 2553: 
 2554: 
 2555: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2556: 
 2557: 
 2558: __device__ void Node::updateKb(void) {
 2559: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2560: 
 2561:    if constexpr(ivcor == 1) return;
 2562: 
 2563: 
 2564:    // Check if node is wet
 2565:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2566: 
 2567:    if (isDry) return;
 2568: 
 2569:    if constexpr(ivcor == 2) {  // SZ coordinates
 2570:       
 2571:       // Compute bottom level index
 2572:       if (depth <= mesh->h_s) {
 2573:          kb = nzlev;
 2574:       } else {
 2575:          kb = -1;
 2576:          int L = 0;
 2577:          int R = nzlev; 
 2578:          
 2579:          while (L <= R) {
 2580:             int M = (R + L) / 2;
 2581: 
 2582: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2583:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2584:             
 2585:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2586:                R = M;
 2587:             } else {
 2588:                L = M;
 2589:             }
 2590: 
 2591:             if (R - L == 1) {
 2592:                kb = L;
 2593:                break;
 2594:             }
 2595:          }
 2596:       }
 2597:    } 
 2598: }
 2599: 
 2600: 
 2601: __device__ __inline__ void Node::updateZCoordData(void) {
 2602: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2603: 
 2604:    if (isDry2()) return;
 2605: 
 2606:    if constexpr(ivcor == 2) {  // SZ coordinates
 2607:       
 2608:       // Compute bottom level index
 2609:       if (depth <= mesh->h_s) {
 2610:             kb = nzlev - 1;
 2611:       } else {
 2612:          kb = -1;
 2613:          for (int i = 0; i < nzlev; i++) {
 2614:             // XXX Use binary search
 2615:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2616:                kb = i;
 2617:                break;
 2618:             }
 2619:          }
 2620:       }
 2621:    } 
 2622:    else if (ivcor == 1) {  // Localized sigma
 2623:       // Do nothing
 2624:    }
 2625: 
 2626: }
 2627: 
 2628: __device__ double Node::compZCoord(int k) const {
 2629:    // Computes the z coordinate at level k.
 2630:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2631:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2632:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2633:    // used 
 2634:    
 2635:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2636: 
 2637:   
 2638:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2639: 
 2640:    if constexpr(ivcor == 2) {
 2641: 
 2642:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2643:       const double h_c = mesh->h_c;
 2644:       const double theta_f = mesh->theta_f;
 2645:       const double sinh_theta_f = mesh->sinh_theta_f;
 2646: 
 2647:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2648:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2649:       // once per time step/node.
 2650:       // CHECK: updateZCoordData
 2651: 
 2652:       //  To simplify comparisons, I define index versions of count variables.
 2653:       if      (k == ivrt)           return eta2; 
 2654:       else if (k == izlev)          return -hmod2;
 2655:       else if (k == kb)             return -depth;
 2656:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2657:       else if (k > izlev) {
 2658:          const int ksig = k - izlev;
 2659: 
 2660:          if (hmod2 <= h_c) {
 2661: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2662:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2663:          } 
 2664:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2665:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2666:             assert(false && "ZCOOR: invalid h_c\n");
 2667:          } 
 2668:          else {
 2669: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2670:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2671:                          h_c * mesh->sigma[ksig] + 
 2672:                          (hmod2 - h_c) * mesh->cs[ksig];
 2673:          }
 2674:       } else { 
 2675:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2676:       }
 2677: 
 2678:    }
 2679:    else if constexpr(ivcor == 1) {
 2680:       if (k == kb) return -depth;
 2681:       else if (k == nvrt-1) return eta2;
 2682:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2683:    }
 2684:    
 2685:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2686:    return 0.0;
 2687: }
 2688: 
 2689: 
 2690: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2691:    // Checks if a side in on the boundary
 2692:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2693: 
 2694:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2695:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2696: 
 2697:    // Indices of the nodes that form the side
 2698:    const int n1 = side.n1->idx;
 2699:    const int n2 = side.n2->idx;
 2700: 
 2701:    // Check if the side is on a land boundary
 2702:    for (int i = 0; i < nland; i++) {
 2703:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2704:          // Consecutive nodes in the land boundary segment
 2705:          const int b1 = ilnd[i*mnlnd + j];
 2706:          const int b2 = ilnd[i*mnlnd + j + 1];
 2707: 
 2708:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2709:             isLand = true;
 2710:             return i;
 2711:          }
 2712:       }
 2713:    }
 2714: 
 2715:    // Check if the side is on an open boundary
 2716:    for (int i = 0; i < nope; i++) {
 2717:       for (int j = 0; j < nond[i] - 1; j++) {
 2718:          // Consecutive nodes in the open boundary segment
 2719:          const int b1 = iond[i*mnond + j];
 2720:          const int b2 = iond[i*mnond + j + 1];
 2721: 
 2722:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2723:             isLand = false;
 2724:             return i;
 2725:          }
 2726:       }
 2727:    }
 2728:    return -1;
 2729: }
 2730: 
 2731: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2732:                 double *node_coords, double *node_coords_ll, bool use_ll,
 2733:                 double *wind_rotate_angle, 
 2734:                 int *isdel, int *isidenode, int *isbnd,
 2735:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2736:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2737:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2738:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2739:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2740:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2741:                 double *drag, double *roughness,
 2742:                 double *emo, double *efa, 
 2743:                 double *umo, double *ufa, 
 2744:                 double *vmo, double *vfa) {
 2745: 
 2746:    printf("Populating mesh for partition %d\n", partNum);
 2747: 
 2748:    // Horizontal grid
 2749:    printf("Processing %d nodes\n", np);   
 2750: 
 2751:    
 2752:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 2753:    const double fc   = 2.0*omega_e*sin(sfea0);
 2754:    const double beta = 2.0*omega_e*cos(sfea0);
 2755: 
 2756: 
 2757:    int idxNodeBoundary = 0;  
 2758:    for (int i = 0; i < np; i++)
 2759:    {
 2760:       Node &node = localNodeData[i];
 2761: 
 2762:       node.idx = i;
 2763: 
 2764:       const int idxNodeStart = nodeNeighNodesStart[i];
 2765:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2766:       node.numNodes = idxNodeEnd - idxNodeStart;
 2767:       node.nodes = nodeNeighNodes + idxNodeStart;
 2768:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2769: 
 2770: 
 2771: 
 2772:       const int idxElemStart = nodeNeighElemsStart[i];
 2773:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2774:       node.numElements = idxElemEnd - idxElemStart;
 2775:       node.elements = nodeNeighElems + idxElemStart;
 2776: 
 2777: 
 2778:       
 2779:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2780:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2781:          const int partNode = localNodePart[idxNodeGlobal]; 
 2782:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2783: 
 2784: 
 2785:          Node *node_ptr = nodes[partNode] + idxNode;
 2786:          
 2787:          nodeNeighNodes[idx] = node_ptr;
 2788:       }
 2789: 
 2790:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2791:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2792:          const int partElem = localElemPart[idxElemGlobal];
 2793:          const int idxElem  = localElemIndices[idxElemGlobal];
 2794: 
 2795:          Element *elem_ptr = elems[partElem] + idxElem;
 2796: 
 2797:          nodeNeighElems[idx] = elem_ptr;
 2798:       }      
 2799: 
 2800: 
 2801:       node.wind_angle = wind_rotate_angle[i];
 2802: 
 2803:       // Element **elements; // pointer to the elements connected to this node
 2804:       // int numElements;   // number of elements shared by this node
 2805: 
 2806:       node.p.x   = node_coords[i * 3];
 2807:       node.p.y   = node_coords[i * 3 + 1];
 2808:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2809:       node.depth = node_coords[i * 3 + 2];
 2810: 
 2811:       node.numSides = 0;
 2812: 
 2813:       node.Cd = drag[i];
 2814:       node.rough = roughness[i];
 2815:       for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 2816: 
 2817:       // Links the node to the boundary information
 2818:       if (isbnd[i] >= 0) {
 2819:        
 2820:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2821:          node.nodeBnd->node = &node;
 2822: 
 2823:          node.nodeBnd->sideBnd1 = nullptr;
 2824:          node.nodeBnd->sideBnd2 = nullptr;
 2825: 
 2826:          if (isbnd[i]>=0) {
 2827: 
 2828:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2829:             
 2830:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2831:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2832: 
 2833:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2834:             node.nodeBnd->segment->clen  = nan("1");
 2835:             node.nodeBnd->segment->carea = nan("1");
 2836: 
 2837:          }
 2838: //          else {  XXXXXX
 2839: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2840: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2841: //          }
 2842:          
 2843:          idxNodeBoundary++;
 2844:       }
 2845:       else {
 2846:          node.nodeBnd = nullptr; // For internal nodes
 2847: 
 2848:          if (isbnd[i] == landSegment) {
 2849:             node.nodeBnd = &landBoundaryNode;
 2850:             node.nodeBnd->segment = &landBoundarySegment;
 2851:          }
 2852:          // node.nodeBnd->node = &node;
 2853:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2854:          // // node.nodeBnd = nullptr;
 2855:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2856:         
 2857:       }
 2858: 
 2859:       // XXXX GAUSSIAN HILL VELOCITIES
 2860: #ifdef GAUSSIAN_HILL_VELOCITIES
 2861:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2862:          constexpr double rot_per = 3000.0;
 2863:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2864:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2865:       // XXXXX
 2866: #endif
 2867:    }
 2868: 
 2869:    nbp = idxNodeBoundary;
 2870: 
 2871:    printf("Processing %d sides\n", ns);
 2872:    int idxSideBoundary = 0;
 2873:    for (int i = 0; i < ns; i++)
 2874:    {
 2875:       Side &side = localSideData[i];
 2876:       side.idx = i;
 2877:       // finding the pointer to the nodes that form the side
 2878:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2879:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2880: 
 2881:       const int locidx_n1 = localNodeIndices[idx_n1];
 2882:       const int locidx_n2 = localNodeIndices[idx_n2];
 2883:       const int part_n1 =   localNodePart[idx_n1];
 2884:       const int part_n2 =   localNodePart[idx_n2];
 2885: 
 2886:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2887:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2888: 
 2889:       // Counts the number of sides connected to each node
 2890:       side.n1->numSides++;
 2891:       side.n2->numSides++;
 2892: 
 2893:       // Normal, unitary vector to the side
 2894:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2895:       side.n = normalize(side.n);
 2896: 
 2897:       // Side boundary type
 2898:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2899:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2900: 
 2901:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2902:       // If both nodes are on the boundary, then the side may be on the boundary
 2903:       {
 2904:          bool isLand = false;
 2905:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2906: 
 2907:          if (isbs > -1) {
 2908:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2909:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2910:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2911: 
 2912:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2913:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2914:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2915: 
 2916:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2917:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2918:           
 2919:             side.sideBnd->side = &side;
 2920:             idxSideBoundary++;
 2921: 
 2922:          }
 2923:          
 2924: 
 2925:       // }
 2926:       // 
 2927: 
 2928: 
 2929: 
 2930: 
 2931: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2932: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2933: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2934: //       {
 2935: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2936: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2937: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2938: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2939: // if (side.sideBnd->segment == nullptr) continue;
 2940: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2941: //          else                  side.sideBnd->segment = n2bnd->segment;
 2942: //          side.sideBnd->side = &side;
 2943: //          idxSideBoundary++;
 2944: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2945:       }
 2946:       else side.sideBnd = nullptr;
 2947: 
 2948:       nbs = idxSideBoundary;
 2949: 
 2950:       // finding the pointer to the elements that share the side
 2951:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2952:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2953: 
 2954:       if (idx_e1 > -1) {
 2955:          const int locidx_e1 = localElemIndices[idx_e1];
 2956:          const int part_e1 =  localElemPart[idx_e1];
 2957:          side.elems[0] = elems[part_e1] + locidx_e1;
 2958: 
 2959:       }
 2960:       else {
 2961:          side.elems[0] = nullptr;
 2962:       }
 2963: 
 2964:       if (idx_e2 > -1) {
 2965:          const int locidx_e2 = localElemIndices[idx_e2];
 2966:          const int part_e2 =  localElemPart[idx_e2];
 2967:          side.elems[1] = elems[part_e2] + locidx_e2;
 2968:       }
 2969:       else {
 2970:          side.elems[1] = nullptr;
 2971:       }
 2972: 
 2973:       // Compute the center of the side
 2974:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2975: 
 2976:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 2977:       side.shapiro = shapiro0;
 2978: 
 2979: #ifdef GAUSSIAN_HILL_VELOCITIES
 2980: // XXXX
 2981: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2982: constexpr double rot_per=3000.0;
 2983: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2984: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2985: // XXXXX      
 2986: #endif
 2987:       // Compute the z level at the center of the side
 2988:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2989: 
 2990:       // Compute the length of the side
 2991:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2992:       side.len = sqrt(dot(vLen, vLen));
 2993: 
 2994: 
 2995:       // Compute the Coriolis coefficient
 2996: 
 2997:       if constexpr(ncor == -1 || ncor == 0) {
 2998:          side.coriolis = coricoef;
 2999:       }
 3000:       else {
 3001:          const double sphi = side.lat();  // Latitude at the center of the side
 3002: 
 3003:          if constexpr(ics == 1) {
 3004:             side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3005:          }
 3006:          else {
 3007:             side.coriolis = 2.0*omega_e*sin(sphi);
 3008:          }
 3009:       }
 3010: 
 3011: 
 3012:    }
 3013: 
 3014:    printf("Processing %d elements\n", ne);
 3015:    for (int i = 0; i < ne; i++)
 3016:    {
 3017:       Element &elem = localElemData[i];
 3018:       elem.idx = i;
 3019:       for (int j = 0; j < i34[i]; j++) {
 3020:          const int idxNode = elnode[i*4 + j];  
 3021:          const int idxSide = elside[i*4 + j];
 3022:          
 3023:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3024:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3025: 
 3026: 
 3027: 
 3028:          // Find the neighboring element  
 3029:          if (elem.sides[j]->elems[0] == &elem) {
 3030:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3031:          }
 3032:          else {
 3033:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3034:          }
 3035:          
 3036:       }
 3037: 
 3038:       elem.i34 = i34[i];
 3039: 
 3040:       // Compute the centroid of the element and its depth
 3041:       Vector2 center = {0.0, 0.0};
 3042:       elem.depth = 0.0;
 3043:       for (int j = 0; j < i34[i]; j++) {
 3044:          center += elem.nodes[j]->p2()/i34[i];
 3045:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3046:       }
 3047:       elem.center.x = center.x;
 3048:       elem.center.y = center.y;
 3049: 
 3050: 
 3051:       
 3052:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3053:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3054: 
 3055:       elem.area = elem.computeSignedArea(); 
 3056:       elem.radius = sqrt(elem.area)/pi; 
 3057:       
 3058:       // Determines which way the normal vector to each side is oriented.
 3059:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3060:       for (int j = 0; j < i34[i]; j++)  
 3061:       {
 3062:          if (elem.sides[j]->elems[0] == &elem) {
 3063:             elem.ssign[j] =  1.0;
 3064:          }
 3065:          else {
 3066:             elem.ssign[j] = -1.0;
 3067:          }
 3068: 
 3069:       }
 3070: 
 3071:       // Derivatives of shape functions
 3072:       //  For ics=2, this is done inside element/ll frame XXX
 3073:       //  For quads, the derivative is evaluated at centroid
 3074:       const int i34 = elem.i34;
 3075:       for (int j = 0; j < i34; j++) {
 3076:          const double area = elem.area;
 3077:          const int id2 = elem.nxq(1 + j);
 3078:          const int id3 = elem.nxq(2 + j);
 3079:          const int id4 = elem.nxq(3 + j);
 3080:          if (elem.isTri()) {
 3081:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3082:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3083:             // da1/dx = (y1 - y2)/(2*area)
 3084:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3085:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3086:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3087:          }
 3088:          else  { // Quad; evaluate at centroid
 3089:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3090:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3091:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3092:          } // if Tri
 3093: 
 3094:       } // for j
 3095: 
 3096:    }
 3097: 
 3098: 
 3099:    // Processing the boundary nodes
 3100:    int idx = 0;
 3101:    for (int iseg = 0; iseg < nope; iseg++) {
 3102:       // for each segment...
 3103:       
 3104:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3105:          // for each node on the segment...
 3106: 
 3107:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3108: 
 3109:          nodeBnd->isEssentialBC = true;
 3110:          nodeBnd->elbc = 0.0;
 3111: 
 3112:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3113: 
 3114:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3115:             nodeBnd->efa[jfr] = efa[idx];
 3116:             nodeBnd->emo[jfr] = emo[idx];
 3117:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3118:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3119: 
 3120:          }
 3121: 
 3122:          idx++;
 3123:       }
 3124: 
 3125:    }
 3126: 
 3127: }
 3128: 
 3129: 
 3130: 
 3131: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3132:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3133:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3134:    // 
 3135:    // This kernel is called for all nodes.
 3136: 
 3137: 
 3138:    NODE(node1);
 3139: 
 3140: 
 3141:    node1->clearMatrixRow();
 3142:    node1->qel = 0.0;
 3143: 
 3144:    // THIS IS FOR STRUCTURES XXX
 3145:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3146: 
 3147:    
 3148:    for (int j=0; j<node1->numElements; j++) {
 3149:       // For each element connected to the node...
 3150: 
 3151:       Element *elem = node1->elements[j];
 3152: 
 3153:       // Compute the average gravity
 3154:       const double grav3 = elem->mean(&Node::grav2);
 3155: 
 3156:       // Look at the documentation for the description of the terms in the following integrals
 3157: 
 3158:       // Integral I_1 
 3159:       // \bar{\breve{H}} 
 3160:       const double hhatb = elem->mean(&Side::hhat);        
 3161: 
 3162: 
 3163:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3164: 
 3165:       const int id1 = elem->nodeLocalIdx(node1); 
 3166:       const double area = elem->area;
 3167: 
 3168:       if (elem->isTri()) {
 3169: 
 3170:          // To clarify the notation in this section: 
 3171:          //   i stands for the node under consideration (node1)
 3172:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3173:          const int id2 = elem->nxq(1 + id1);
 3174:          const int id3 = elem->nxq(2 + id1);
 3175:          Node *node2 = elem->nodes[id2];
 3176:          Node *node3 = elem->nodes[id3];
 3177: 
 3178:          const Point2 x1 = node1->p2();
 3179:          const Point2 x2 = node2->p2();
 3180:          const Point2 x3 = node3->p2();
 3181: 
 3182:          // integral of phi_i*phi_j
 3183:          const double ipp_ii = (1.0/6.0 )*area;
 3184:          const double ipp_ij = (1.0/12.0)*area;
 3185:          const double ipp_ik = (1.0/12.0)*area;
 3186: 
 3187:          // integral of [(grad phi_i) * (grad phi_j)]
 3188:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3189:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3190:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3191: 
 3192:          // Computes the different components of integral I_1 of each node with respect to node i.
 3193:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3194:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3195:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3196: 
 3197:          node1->addToSparseMatrix(node1, I1_ii);
 3198:          node1->addToSparseMatrix(node2, I1_ij); 
 3199:          node1->addToSparseMatrix(node3, I1_ik);
 3200: 
 3201:       }
 3202:       else { // Quad
 3203:          // XXX IMPLEMENT THIS
 3204:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3205:       } 
 3206: 
 3207:  
 3208:       // Integral I_4
 3209:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3210:       // Where
 3211:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3212: 
 3213:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3214:       // of U over the element.
 3215:       Vector2 Umean = {0.0, 0.0};
 3216:       for (int m=0; m<elem->i34; m++) {      
 3217:          const Side *side = elem->sides[m];
 3218: 
 3219:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3220:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3221:       }
 3222:       Umean = Umean/elem->i34;
 3223: 
 3224:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3225: 
 3226:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3227:       const double I_4_1 = dot(gradPhi_1, Umean);
 3228: 
 3229:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3230:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3231:      
 3232: // printf(">>> k = %d, node idx = %d, elem->idx = %d, Umean = %.15e,%.15e, I_4_1 = %.15e, I_4_2 = %.15e, node1->qel = %.15e\n", j, node1->idx, elem->idx, Umean.x, Umean.y, I_4_1, I_4_2, dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2));
 3233: // printf(">>> k = %d, node idx = %d, elem->idx = %d, ghat1 = %.15e,%.15e, gradPhi = %.15e,%.15e\n", j, node1->idx, elem->idx, elem->ghat1.x, elem->ghat1.y, gradPhi_1.x, gradPhi_1.y);
 3234:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3235: 
 3236:       // Additional terms 
 3237:       double vnorm = 0.0;
 3238:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3239:          Vector3 ubed;
 3240:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3241: 
 3242:          Vector3 gradP = {0.0, 0.0, 1.0};
 3243:          for (int m=0; m < elem->i34; m++) {
 3244:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3245:            gradP += toVector3(gradP_2D, 0.0);
 3246:          }   
 3247:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3248:       } // imm==2
 3249: 
 3250:       if (elem->isTri()) {
 3251:          for (int l=0; l<3; l++) {
 3252:             double fac;
 3253: 
 3254:             Node *node = elem->nodes[l];
 3255: 
 3256:             fac = (node == node1) ? 2.0 : 1.0;
 3257:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3258:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3259: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3260:            
 3261:          }
 3262: 
 3263: 
 3264:          if (!elem->isDry) {
 3265:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3266: 
 3267:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3268: // printf("BBB>>>  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta) = %.15e\n",  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta));
 3269:          }
 3270: 
 3271:       } // isTri
 3272:       else { // isQuad
 3273:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3274:          // for (int l=0; l<4; l++) {
 3275:          //   const Node *node = elem->nodes[l];
 3276: 
 3277:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3278:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3279: 
 3280:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3281:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3282:          // }
 3283: 
 3284:       } // isQuad
 3285: 
 3286: 
 3287:       node1->qel += (dt/elem->i34)*elem->vsource;
 3288:       
 3289: 
 3290:    } // for all elements connected to the node
 3291:    
 3292: 
 3293: 
 3294:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3295:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3296:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3297:    if (nodeBnd != nullptr)  { 
 3298:       // If it is an open boundary node...
 3299: 
 3300:       // At least one open bnd side, maybe two
 3301:       for (int l=0; l<2; l++) { 
 3302: 
 3303:          // Gets each of the sides sharing the node. 
 3304:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3305: 
 3306:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3307: 
 3308:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3309: 
 3310:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3311:          if (sideBnd != nullptr) {
 3312:             // If the side is on a boundary...
 3313: 
 3314:             // Get the boundary segment
 3315:             const BoundarySegment *sideSegment = sideBnd->segment;
 3316:             const Side *side = sideBnd->side;
 3317: 
 3318:             // Integral I_3
 3319:             if (sideSegment->ifltype != 0) {
 3320:             // Natural or Flather b.c.
 3321: 
 3322:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3323:                // especially for Flather b.c.
 3324:                double ri3 = 0.0;
 3325:                if (!side->isDry) {
 3326:                   // If the side is not dry
 3327:                   
 3328:                   // Computes the side flux of (uth, vth)
 3329:                   double Vn = 0.0;
 3330:                   for (int k = side->kb; k<nvrt-1; k++) {
 3331:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3332:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3333: 
 3334:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3335:                   }
 3336: 
 3337:                   ri3 = 0.5*side->len*Vn;
 3338:                }
 3339: 
 3340:                if (sideSegment->ifltype == -1) { // Flather 1
 3341: 
 3342:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3343:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3344: 
 3345:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3346:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3347:                   
 3348:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3349:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3350: 
 3351:                } 
 3352:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3353:                   // Reset ri3
 3354:                   ri3 = 0.0;
 3355: 
 3356:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3357: 
 3358:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3359: 
 3360:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3361:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3362: 
 3363:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3364:                   node1->addToSparseMatrix(node1, con0*2.0);
 3365:                   node1->addToSparseMatrix(node2, con0);
 3366: 
 3367:                } // if Flather or Discharge
 3368: 
 3369:                node1->qel -= thetai*dt*ri3;
 3370: 
 3371:             } // I_3
 3372:           
 3373: 
 3374:             // Integral I_5
 3375:             if(!side->isDry) {
 3376: 
 3377:                const double Unbar = dot(side->U, side->n);
 3378:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3379: 
 3380:             } // I_5
 3381: 
 3382:          } // if is boundary side
 3383: 
 3384:       } // for l
 3385: 
 3386:    } // if isbnd
 3387: 
 3388: 
 3389: }
 3390: 
 3391: 
 3392: 
 3393: extern "C" {
 3394:    __global__ void rollUpElevation(void) {
 3395: 
 3396:       NODE(node);
 3397: 
 3398:       node->eta1 = node->eta2;
 3399: 
 3400:    }
 3401: 
 3402: 
 3403:    __global__ void backtrackAllNodes(void) {
 3404: 
 3405:       // max/min # of sub-divisions
 3406:       const int ndelt_max = max(1.0, dt/dtb_min);
 3407:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3408: 
 3409:       // Removed all references to swild98 XXX
 3410:       // swild98=0.d0 !init
 3411: 
 3412: 
 3413:       SIDE(side);
 3414: 
 3415:       const int kb = side->kb;
 3416: 
 3417: 
 3418: 
 3419:       // Initialize btrack velocities to the actual velocities at the side 
 3420:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3421: 
 3422:       if (side->isDry) return;
 3423: 
 3424: 
 3425:       // Checks that at least one element is not dry
 3426:       const Element *elem1 = side->elems[0];
 3427:       const Element *elem2 = side->elems[1];
 3428: 
 3429: 
 3430:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3431:       
 3432:       // XXXXXX
 3433:       // !swild_tmp to store global coord. of the starting side
 3434:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3435:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3436:       // !Use sframe2 
 3437:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3438: 
 3439: 
 3440:       for (int k = kb; k < nvrt; k++) {
 3441:       //  Initialize (xt,yt,zt), nnel and vel.
 3442:       //  For ics=2, the coordinates are in local frames
 3443:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3444: 
 3445: 
 3446:          const int iadvf = side->iadv();  // Advection flag
 3447: 
 3448:          Point3 xt;
 3449:          if constexpr(ics==1) {
 3450:             xt = side->center3D(k); 
 3451:          }
 3452:          else // lat/lon; in side lat/lon frame
 3453:          {
 3454:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3455:          // XXX IMPLEMENT THIS
 3456:       //          xt=0.d0
 3457:       //          yt=0.d0
 3458:       //          !centroid coord. for nudging
 3459:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3460:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3461:          }  // ics
 3462: 
 3463: 
 3464: 
 3465:          // If on land or open boundary...
 3466:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3467:          
 3468:          const double vmag = length(side->u2[k]);
 3469: 
 3470:          if (vmag <= velmin_btrack) {
 3471:             // No activity 
 3472: 
 3473:             side->btu[k] = side->u2[k];
 3474:             
 3475:          } else {  // do btrack
 3476: 
 3477:             // Compute number of sub-divisions based on local gradients 
 3478:             // XXX IS THIS NECESSARY?
 3479:             double suma = 0.0;
 3480:             int icount = 0;
 3481:             for (int ii=0; ii<2; ii++) {
 3482: 
 3483:                const Element *elem = side->elems[ii];
 3484:                  
 3485:                if (elem == nullptr) continue;
 3486: 
 3487:                icount++;
 3488: 
 3489:                // Not strictly along z; in ll frame for ics=2
 3490: 
 3491:                double utmp[4];
 3492:                double vtmp[4];
 3493:                for (int jj = 0; jj < elem->i34; jj++) {
 3494: 
 3495:                   const Node *node = elem->nodes[jj];
 3496: 
 3497:                   if constexpr(ics==1) {
 3498:                      utmp[jj] = node->u2[k].x;
 3499:                      vtmp[jj] = node->u2[k].y;  
 3500:                   } else {
 3501:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3502:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3503:                   }
 3504:                } // for jj
 3505: 
 3506:                const Vector2 grad_u = elem->grad2(utmp); 
 3507:                const Vector2 grad_v = elem->grad2(vtmp);
 3508: 
 3509:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3510:             } // for ii
 3511: 
 3512:             assert(icount > 0 && "Impossible 77");
 3513: 
 3514:             // '4' is somewhat arbitrary
 3515:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3516: 
 3517:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3518:          
 3519: 
 3520:             Vector3 u_int = {0.0, 0.0, 0.0};
 3521: 
 3522:             side->btrack(k, dt, dtbk, u_int);
 3523:             side->btu[k] = toVector2(u_int);
 3524:                
 3525:          } // if vmag (do backtrack)
 3526: 
 3527:       } // for j=jmin,nvrt-1
 3528: 
 3529:    }
 3530: } // extern "C"
 3531: 
 3532: template<int nc>
 3533: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3534: 
 3535: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3536: //
 3537: // a,b,c,rhs: input vectors and are not modified by this program.
 3538: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3539: // rhs is the r.h.s.
 3540: // n: actual rank of the system.
 3541: // rows in u() and rhs();
 3542: // u: output with nc columns (transposed to rows)
 3543: // gam: a working array.
 3544: //
 3545: // NOTES:
 3546: // This is a template function that allows for different numbers of columns in the rhs vector.
 3547: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3548: 
 3549:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3550:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3551: // printf("AAAAAA a[0] = %f, b[0] = %f, c[0] = %f, rhs[0] = %f\n", a[0], b[0], c[0], rhs[0]);   
 3552: 
 3553:    double bet = b[0];
 3554:    if constexpr (nc == 1) {
 3555:       u[0] = rhs[0]/bet;
 3556:    } else {
 3557:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3558:    }
 3559: 
 3560:    for (int j = 1; j < n; j++) {
 3561:       gam[j] = c[j-1]/bet;
 3562:       bet = b[j] - a[j]*gam[j];
 3563: // printf("RRR bet = %f, b[%d] = %f, a[%d] = %f, gam[%d] = %f\n", bet, j, b[j], j, a[j], j, gam[j]);
 3564:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3565: 
 3566:       if constexpr (nc == 1) {
 3567:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3568:       } else {
 3569:          for (int k = 0; k < nc; k++) {
 3570:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3571:          }
 3572:       }
 3573:    }
 3574: 
 3575:    // Back-substitution
 3576:    for (int j=n-1; j>=1; j--) {
 3577:       if constexpr (nc == 1) {
 3578:          u[j] = u[j] - gam[j+1]*u[j-1];
 3579:       } else {
 3580:          for (int k = 0; k < nc; k++) {
 3581:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3582:          }
 3583:       }
 3584:    }
 3585: }
 3586: 
 3587: 
 3588: 
 3589: // Helper function that contains the core algorithm
 3590: template<typename XAccessor, typename YAccessor>
 3591: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3592:                                     double  yp_top, double  yp_bot, 
 3593:                                     CubicSpline &spline) {
 3594:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3595:    // 
 3596:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3597:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3598:    //
 3599:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3600:    // 
 3601:    // Inputs: 
 3602:    //            n: dimension for x etc; # of data pts (>=2);
 3603:    //            getX, getY: functions to access x,y coordinates
 3604:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3605:    //     Output: 
 3606:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3607: 
 3608:    const int n = k2 - k1 + 1;
 3609:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3610: 
 3611:    // Allocate memory for the splines
 3612:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3613:    spline.x   = new double[n];
 3614:    spline.y   = new double[n];
 3615:    spline.yp  = new double[n];
 3616:    spline.ypp = new double[n];
 3617: 
 3618:    for (int k=k1; k<=k2; k++) {
 3619:       spline.x[k] = getX(k);
 3620:       spline.y[k] = getY(k);
 3621:    }
 3622: 
 3623:    // This is to simplify expressions later
 3624:    double *x = spline.x;
 3625:    double *y = spline.y;
 3626: 
 3627:    double *a = nullptr;
 3628:    double *b = nullptr;
 3629:    double *c = nullptr;
 3630:    double *gam = nullptr;
 3631:    double *rhs = nullptr;
 3632:    
 3633: 
 3634:       a = new double[n];   // Lower diagonal
 3635:       b = new double[n];   // Diagonal
 3636:       c = new double[n];   // Upper diagonal
 3637:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3638:       rhs = new double[n]; // Right-hand side
 3639: 
 3640:    for (int k=k1; k<=k2; k++) {
 3641:       if (k == k1) {
 3642:          // Bottom level
 3643:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3644:          b[k] = (x[k+1] - x[k])/3.0;
 3645:          c[k] = b[k]/2.0;
 3646:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3647:       } else if (k == n - 1) {
 3648:          // Top level (surface)
 3649:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3650:          b[k] = (x[k] - x[k-1])/3.0;
 3651:          a[k] = b[k]/2.0;
 3652:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3653:       } else {
 3654:          // Intermediate levels
 3655:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3656:          b[k] = (x[k+1] - x[k-1])/3.0;
 3657:          a[k] = (x[k  ] - x[k-1])/6.0;
 3658:          c[k] = (x[k+1] - x[k  ])/6.0;
 3659:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3660:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3661:       }
 3662:    }
 3663: 
 3664:    // Solve the tridiagonal system
 3665:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3666:    
 3667:    spline.yp[k1] = yp_bot;
 3668:    spline.yp[k2] = yp_top;
 3669: 
 3670:    // Compute rest of 1st derivatives using the splines
 3671:    for (int k=k1+1; k<k2; k++) {
 3672:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3673:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3674:    }
 3675:    
 3676:    delete[] a;
 3677:    delete[] b;
 3678:    delete[] c;
 3679:    delete[] gam;
 3680:    delete[] rhs;
 3681: 
 3682: }
 3683: 
 3684: // Array version
 3685: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3686:                                 double y_top, double y_bot, 
 3687:                                 CubicSpline &spline) {
 3688:    auto getX = [x] (int k) { return x[k]; };
 3689:    auto getY = [y] (int k) { return y[k]; };
 3690:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3691: }
 3692: 
 3693: // Lambda version - allows custom access patterns
 3694: template<typename XFunc, typename YFunc>
 3695: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3696:                                 double y_top, double y_bot,
 3697:                                 CubicSpline &spline) {
 3698:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3699: }
