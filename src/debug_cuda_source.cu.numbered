 4052:    __global__ void computeFlowBcVelocities(double time) {
 4053: 
 4054:       SIDE_BND(sideBnd);
 4055: 
 4056:       const Side *side = sideBnd->side;
 4057:  
 4058:       const bool isDry = side->isDry;
 4059: 
 4060:       if (isDry) {
 4061:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4062:          return;
 4063:       }
 4064: 
 4065:       // For wet sides in open boundaries...
 4066:       const Vector2 n = side->n;
 4067:       const BoundarySegment *segment = sideBnd->segment;
 4068: 
 4069:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4070: 
 4071:       const int ifltype = segment->ifltype;
 4072:       const int iettype = segment->iettype;
 4073: 
 4074:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4075:       const Vector2 r_nuth0 = r_uth0*n;
 4076: 
 4077: 
 4078: printf("ZZZ4  idx = %d, ifltype = %d, r_nuth0 = %f, %f\n", sideBnd->side->idx, ifltype, r_nuth0.x, r_nuth0.y);
 4079:       for (int k = 0; k < nvrt; k++) {
 4080:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4081:          Vector2 r_u1_bar = {0.0, 0.0};
 4082:       
 4083:          if (ifltype == 1 || ifltype == 2) {
 4084:          
 4085:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4086: 
 4087:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4088:             
 4089:             r_uth = unth0*n;  // This case has no ramp-up
 4090:             
 4091:          } else if (ifltype == -1) { // Flather 1
 4092: 
 4093:             // uth is the normal vel.; no ramp up
 4094:             const double uth = sideBnd->nuth(k);
 4095:             r_uth = uth*n;
 4096:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4097: 
 4098: 
 4099:          } else if (ifltype == 3 || ifltype == 5) {
 4100:             // vnth0=0 !normal vel.
 4101: 
 4102: printf("ZZZ3  idx = %d, jfr = %d, ifltype = %d, r_uth = %f, %f\n", sideBnd->side->idx, nbfr, ifltype, r_uth.x, r_uth.y);
 4103:             // Computes the contribution to the velocity from all tide frequencies
 4104:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4105: 
 4106:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4107:                const Vector2 umo  = sideBnd->umo(jfr); 
 4108: 
 4109:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4110:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4111:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4112:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4113: printf("ZZZ2  idx = %d, jfr = %d, ncyc = %d, face = %f, argx = %f, argy = %f, umo = %f, %f, ufa = %f, %f, ramp = %f, ff = %f, r_u1_bar = %e, %e\n", sideBnd->side->idx, jfr, ncyc, face[jfr], argx, argy, umo.x, umo.y, ufa.x, ufa.y, ramp, ff[jfr], r_u1_bar.x, r_u1_bar.y);               
 4114:             }
 4115: 
 4116:          } // if (ifltype = 3 || ifltype == 5
 4117: 
 4118: 
 4119:          switch (iettype) {
 4120:             case 1:
 4121:             case 2:
 4122:             case 4:
 4123:                sideBnd->ubc[k] = r_uth;
 4124:                break;
 4125:             case 3:
 4126:                sideBnd->ubc[k] = r_u1_bar;
 4127:                break;
 4128:             case 5:
 4129:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4130:                break;
 4131:          } // switch
 4132: 
 4133: printf("ZZZ  idx = %d, iettype = %d, r_u1_bar = %f, %f, sideBnd->ubc[%d] = %f, %f\n", sideBnd->side->idx, iettype, r_u1_bar.x, r_u1_bar.y, k, sideBnd->ubc[k].x, sideBnd->ubc[k].y);
 4134:       } // for k
 4135:    }
 4136: 
 4137:    __global__ void computeElevationBoundaryConditions(double time) {
 4138:       // Compute elevation essential boundary conditions 
 4139: 
 4140:       NODE_BND(nodeBnd); // Each boundary node.
 4141: 
 4142:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4143: 
 4144:       const Node *node = nodeBnd->node;
 4145:       const BoundarySegment *segment = nodeBnd->segment;
 4146:       const int iettype = segment->iettype;
 4147:       
 4148: 
 4149:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4150:       double eic = 0.0;
 4151:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4152:       else                 eic = 0.0;
 4153: 
 4154:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4155:       const double r_eth = ramp*nodeBnd->eth;
 4156:       double r_eta1_bar = 0.0;
 4157: 
 4158: 
 4159:       // Compute tide elevation
 4160:       if (iettype == 3 || iettype == 5) {   
 4161: 
 4162:          if constexpr(iloadtide==1) { // loading tide
 4163:             assert(false && "Loading tide not implemented");
 4164:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4165:          }
 4166:          
 4167:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4168: 
 4169:             const double efa  = nodeBnd->efa[jfr]; 
 4170:             const double emo  = nodeBnd->emo[jfr]; 
 4171: 
 4172:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4173:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4174:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4175: 
 4176:          } // for jfr
 4177: 
 4178:       } // if iettype
 4179: 
 4180:       switch (iettype) {
 4181:          case 1:
 4182:          case 2:
 4183:          case 4:
 4184:             nodeBnd->elbc = r_eic + r_eth;
 4185:             break;
 4186:          case 3:
 4187:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4188:             break;
 4189:          case 5:
 4190:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4191:             break;
 4192:       } // switch
 4193: 
 4194: 
 4195:       //Add inverse barometric effects
 4196:       if (iettype != 0 && inv_atm_bnd == 1) {
 4197:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4198:       }
 4199: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 4200:    }
 4201: 
 4202: 
 4203:    __global__ void computeHorizontalViscosity(void) { 
 4204: 
 4205:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4206: 
 4207:       SIDE(side);
 4208: 
 4209:       if (side->isDry) return;
 4210: 
 4211:       for (int k = 0; k < nvrt; k++) {
 4212:          side->nuGradU[k] = {0.0, 0.0};
 4213:       }
 4214: 
 4215:       if constexpr(ihorcon == 1) {
 4216:          for (int k = side->kb; k < nvrt - 1; k++) {
 4217:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4218:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4219:             // By Zhang and Baptista.
 4220: 
 4221:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4222:             // This is a standard discretization of the Laplacian operator.
 4223:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4224:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4225:             // Gamma is hvis_coef0 in the code.
 4226:             // The value of gamma needs to be < 0.5.
 4227: 
 4228:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4229:             // side under consideration in each of the two possible elements that share the side.
 4230:             Vector2 sumU = {0.0, 0.0};
 4231:             for (int l = 0; l < 2; l++) {
 4232:                const Element *elem = side->elems[l];
 4233: 
 4234:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4235: 
 4236:                // Find the local index of the side in the element
 4237:                const int idxSide = elem->sideLocalIdx(side);
 4238:                // Find the two sides that are connected to the side under consideration
 4239:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4240:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4241: 
 4242:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4243: 
 4244:             }
 4245: 
 4246:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4247:    printf("+++++ side->nuGradU = %f, %f\n", side->nuGradU[k].x, side->nuGradU[k].y);
 4248: 
 4249:    
 4250:          }
 4251:       }
 4252:       else if constexpr(ihorcon == 2) {
 4253:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4254:       }
 4255: 
 4256: 
 4257:    }
 4258: 
 4259: 
 4260:    __global__ void setEssentialBC(void) {
 4261:       // Set essential boundary conditions 
 4262:       NODE(node); // Each boundary node
 4263:       NodeBoundary *nodeBnd = node->nodeBnd;
 4264: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 4265:       
 4266: // nodeBnd->isEssentialBC = true;      
 4267:       // Check if this node has essential BC
 4268:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4269:          // Verify BC value is valid
 4270:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4271: 
 4272:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 4273:          
 4274:          // Set diagonal to 1 and zero off-diagonals
 4275:          node->coeffDiag = 1.0;
 4276:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 4277: 
 4278:          for (int j = 0; j < node->numNodes; j++) {
 4279:                node->coeffMatrix[j] = 0.0;
 4280:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4281:          }
 4282:          
 4283:          // Set solution and RHS to BC value
 4284:          node->mX  = nodeBnd->elbc;
 4285:          node->qel = nodeBnd->elbc;
 4286: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 4287:       } else {
 4288:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4289: 
 4290:          for (int j = 0; j < node->numNodes; j++) {
 4291:                Node* nbNode = node->nodes[j];
 4292:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4293:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4294:                   // Verify neighbor's BC value
 4295:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4296: 
 4297:                   // Subtract contribution to RHS
 4298:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4299:                   node->coeffMatrix[j] = 0.0;  
 4300:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4301:                }
 4302:          }
 4303:       }
 4304:    }
 4305: 
 4306: 
 4307:    __global__ void updateElevation(void) {
 4308:       NODE(node);
 4309: 
 4310:       node->eta2 = node->mX;
 4311: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 4312:    }
