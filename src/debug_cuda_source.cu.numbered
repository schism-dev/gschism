 3816: extern "C" {
 3817: 
 3818:    __global__ void scaleGravity(double loadtide_coef) {
 3819: 
 3820: 
 3821:       NODE(node);
 3822: 
 3823:       // SAL option: scale gravity
 3824:       if constexpr(iloadtide==2) {  // simple const
 3825:          node->grav2 = grav*(1.0 - loadtide_coef);
 3826: 
 3827:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3828:         
 3829:           const double depth = max(node->depth, 0.0);
 3830:           const double tmp1 = sqrt(depth);
 3831:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3832:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3833:                              2.6969e-13*depth*depth*depth*tmp1;
 3834:           
 3835:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3836:           
 3837: 
 3838: 
 3839:           node->grav2 = grav*(1.0 - beta_bar);
 3840: 
 3841:       } else {  // iloadtide=0,1
 3842:         node->grav2=grav;
 3843: 
 3844:       }
 3845: 
 3846:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3847:    }
