 1740: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1741:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1742: }
 1743: 
 1744: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1745:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1746: }   
 1747: 
 1748: __device__ __inline__ double min3(double a, double b, double c) {
 1749:    return min(a, min(b, c));
 1750: }
 1751: 
 1752: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1753:    return min(a, min(b, min(c, d)));
 1754: }
