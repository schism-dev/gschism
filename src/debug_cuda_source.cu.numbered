 3809: extern "C" {
 3810: 
 3811:    __global__ void scaleGravity(double loadtide_coef) {
 3812: 
 3813: 
 3814:       NODE(node);
 3815: 
 3816:       // SAL option: scale gravity
 3817:       if constexpr(iloadtide==2) {  // simple const
 3818:          node->grav2 = grav*(1.0 - loadtide_coef);
 3819: 
 3820:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3821:         
 3822:           const double depth = max(node->depth, 0.0);
 3823:           const double tmp1 = sqrt(depth);
 3824:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3825:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3826:                              2.6969e-13*depth*depth*depth*tmp1;
 3827:           
 3828:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3829:           
 3830: 
 3831: 
 3832:           node->grav2 = grav*(1.0 - beta_bar);
 3833: 
 3834:       } else {  // iloadtide=0,1
 3835:         node->grav2=grav;
 3836: 
 3837:       }
 3838: 
 3839:    }
 3840: 
 3841: 
 3842:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3843: 
 3844:       NODE_BND(nodeBnd);
 3845: 
 3846:       Node *node = nodeBnd->node;
 3847: 
 3848:       node->ETP = 0.0;
 3849: 
 3850:       for (int j=0; j<ntip; j++) {
 3851: 
 3852:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3853:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3854:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3855: 
 3856:          if constexpr(iloadtide==1) { // loading tide
 3857:             assert(false && "Loading tide not implemented");
 3858:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3859:          }
 3860:          
 3861:       }
 3862:       
 3863:    }
