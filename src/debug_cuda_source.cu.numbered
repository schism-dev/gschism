  492: 
  493:    int kb;                    // Bottom index of the element
  494:    double area;               // Area of the element
  495:    double ssign[4];           // Sign associated with each side of an element
  496:    double radius;             // Element equivalent radii
  497: 
  498:    Frame frame;
  499: 
  500:    Vector2 gradPhi[4];       // Derivatives of shape functions
  501:    Vector2 gradEta;          // Gradient of free surface elevation
  502:    Vector2 gradPr;           // Gradient of pressure    
  503:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  504: 
  505:    bool isDry;                // True if the element is dry
  506: 
  507:    Vector2 center;         // Element center coordinates
  508:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  509:    double depth;              // Depth at element (min of all nodes)
  510:    double z[nvrt];            // z-coord  (local frame - vertical up)
  511: 
  512:    // Physical information
  513:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  514: 
  515:    static const bool isblock = false;              // Always false
  516: 
  517:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  518:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  519: 
  520:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  521: 
  522:    
  523: 
  524:    double vsource;            // Volumetric source/sink term [m^3/s]
  525: 
  526:    double rho[nvrt];          // Density at each prism center
  527:    double rho_mean[nvrt];     // Mean density at each prism center
  528:    CubicSpline rho_spl;
  529:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  530:    double rho_z[nvrt];        // First derivative of density at each prism center
  531:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  532: 
  533:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  534: 
  535:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  536:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  537: 
  538:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  539:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  540: 
  541:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  542:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  543:       // Find the local index of the node in the element (0,1,2,3)
  544:       int res = __ffs((nodes[0] == node) | 
  545:                      ((nodes[1] == node) << 1) | 
  546:                      ((nodes[2] == node) << 2) | 
  547:                      ((nodes[3] == node) << 3)) - 1;
  548:       
  549:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  550:       return res;  
  551:    }
  552: 
  553:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  554:       // Find the local index of the side in the element (0,1,2,3)
  555:       int res = __ffs((sides[0] == side) | 
  556:                      ((sides[1] == side) << 1) | 
  557:                      ((sides[2] == side) << 2) | 
  558:                      ((sides[3] == side) << 3)) - 1;
  559:       
  560:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  561:       return res;
  562:    }
  563: 
  564: 
  565:    __inline__ __device__ int findLevel(double z1, int k) const {
  566:       // Starting at index k, find sequentially the level that contains z
  567: 
  568:       // For testing purposes, forgets k and performs a full search.
  569:       for (k = kb; k < nvrt - 1; k++) {
  570:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  571:       }
  572:       return nvrt - 2;
  573: 
  574: 
  575:       // if z is already betweeen z[k] and z[k+1], return k
  576:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  577:       else if (z1 <  z[k]) { 
  578:          // Search for increasing levels
  579:          for (int kk = k; kk < nvrt - 1; kk++) {
  580:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  581:          }
  582:          return nvrt - 1;
  583:       }
  584:       else {
  585:          // Search for decreasing levels
  586:          for (int kk = k; kk >= kb; kk--) {
  587:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  588:          }
  589:          return 0;
  590:       }
  591:    }
  592: 
  593:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  594:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  595: 
  596:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  597:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  598:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  599:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  600:        const double eta = (idx & 1) ? +g : -g;
  601:        const double xi  = (idx & 2) ? +g : -g;
  602:        return {eta, xi};
  603:    }  
  604: 
  605:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  606:    __device__ __forceinline__ double etaSign(int idx) const {
  607:       // bit1: 0 -> -1, 1 -> +1
  608:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  609:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  610:    }
  611: 
  612:    __device__ __forceinline__ double xiSign(int idx) const {
  613:       // +1 if (bit0 XOR bit1), else -1
  614:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  615:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  616: 
  617:    }
  618: 
  619:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  620:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  621:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  622:    }
  623: 
  624:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  625:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  626:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  627:    }   
  628: 
  629:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  630:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  631:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  632:    }      
  633:    
  634:    __inline__ __device__ double detJ_eta(void) const;
  635: 
  636:    __inline__ __device__ double detJ_xi(void) const;
  637: 
  638:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  639: 
  640:    // Check if the element is dry using the more up-to-date elevation.
  641:    __inline__ __device__ bool isDry2(void) const;
  642: 
  643:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  644: 
  645:    __inline__ __device__ double computeSignedArea(void) const;
  646: 
  647:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  648:       // Nudges the point (x,y) to the barycenter of the element
  649:       p = (1-eps)*p + eps*center;
  650:    }
  651: 
  652:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  653:    
  654:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  655: 
  656:    __device__ double intPhiPhi(int i1, int i2) const;
  657: 
  658:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  659: 
  660:    __device__ Vector2 grad2(double *a) const
  661:    {
  662:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  663:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  664:       if (isQuad()) {
  665:          gx += a[3]*gradPhi[3].x;
  666:          gy += a[3]*gradPhi[3].y;
  667:       }
  668:       return {gx, gy};
  669:    }
  670: 
  671:    __device__ Vector2 grad2(double Node::* field) const
  672:    {
  673:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  674:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  675:       if (isQuad()) {
  676:          gx += (nodes[3]->*field)*gradPhi[3].x;
  677:          gy += (nodes[3]->*field)*gradPhi[3].y;
  678:       }
  679:       return {gx, gy};
  680:    }
  681: 
  682:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  683:    __device__ __forceinline__ Vector3 n(int k) const {
  684:       double area3D;
  685:       return n(k, area3D);
  686:     }
