 6821: #ifdef DONTCOMPILE
 6822: __global__ void checkMassConservation(Tracers* sumtr) {
 6823: 
 6824:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6825: 
 6826:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6827: 
 6828:    Element *elem = &(mesh->localElemData[i]);
 6829: 
 6830:    // Skip dry elements
 6831:    if (elem->isDry) return;
 6832: 
 6833:    // Local sum array for this thread
 6834:    double localSum[N_TRACERS] = {0.0};
 6835: 
 6836:    // Sum over vertical levels for this element
 6837:    const int kbe = elem->kbe;
 6838:    const double area = elem->area;
 6839: 
 6840:    for (int k = kbe; k < nvrt; k++) {
 6841:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6842:       
 6843:       // Accumulate tracer mass
 6844:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6845:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6846:       }
 6847:    }
 6848: 
 6849:    
 6850: 
 6851:    //  This function returns per element sums. A reduction must be done on the host side.
 6852: }
 6853: 
 6854: 
 6855: __global__ void transport(void) {
 6856: 
 6857:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6858: 
 6859:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6860: 
 6861:    Element *elem = &(mesh->localElemData[ie]);
 6862: 
 6863:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6864: 
 6865:                for (int m=0; m<ntr; m++) {
 6866:                   for (int k=kbe(ie); k<nvrt; k++) {
 6867:                      // Calculate each polynomial's weight 
 6868:                      wm=0.d0; sum1=0.d0; 
 6869:                      wm1=0.d0; wm2=0.d0; 
 6870:                      for (int i=0; i<elem->nweno2; i++) {
 6871:                   
 6872:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6873:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6874:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6875:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6876:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6877:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6878:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6879:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6880:                      // -----------------Hu and Shu (1999)'s method----------------
 6881:                      b4=b1+b2+b3
 6882: 
 6883: //Error: add PRODUCTION CPP
 6884: #ifdef DEBUG
 6885:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6886:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6887:                     call parallel_abort(errmsg)
 6888:                   }
 6889: #endif
 6890: 
 6891:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6892:                   // !----test-------------- 
 6893:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6894:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6895:                   // !wm(i)=wm1(i)*wm2(i)
 6896:                   // !---------------------- 
 6897:                   sum1=sum1+wm(i)
 6898:                 } // end for i
 6899: 
 6900:                 wm=wm/sum1
 6901: 
 6902:                 for (int j=0; j<elem->i34; j++) {
 6903: 
 6904:                   const Side *side  = elem->sides[j];
 6905:                   const Node *node1 = side->n1;
 6906:                   const Node *node2 = side->n2;
 6907: 
 6908:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6909:                      trsd=0.d0
 6910:                      for (int kk=0; kk<nquad; kk++) {
 6911:                         for (int i=0; i<elem->nweno2; i++) {
 6912:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6913:                         } // end for i   
 6914:                      } // end for kk
 6915:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6916:                   } // outward flux
 6917:                } // end for j=1,i34(ie) ! side
 6918:             }
 6919:          }
 6920:               
 6921: 
 6922: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6923: //             //   calculate each polynomial's weight 
 6924: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6925: //                 wm=0.d0; sum1=0.d0
 6926: //                 do i=1,nweno1(ie) !for each polynomial
 6927: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6928: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6929: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6930: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6931: //                   wm(i)=b2
 6932: //                   sum1=sum1+b2
 6933: //                   !wm(i)=1.d0
 6934: //                   !sum1=sum1+1.d0
 6935: 
 6936: // // Error: PRODUCTION
 6937: // #ifdef DEBUG
 6938: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6939: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6940: //                     call parallel_abort(errmsg)
 6941: //                   endif
 6942: // #endif
 6943: 
 6944: //                 enddo !i
 6945: //                 wm=wm/sum1 !final weight
 6946: 
 6947:                 for (int j=0; j<elem->i34; j++) { // side
 6948:                   const Side *side = elem->sides[j];
 6949:                   const Node *node1 = side->n1;
 6950:                   const Node *node2 = side->n2;
 6951: 
 6952:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6953:                     trsd=0.d0
 6954:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6955:                       for (int i=0; i<elem->nweno1; i++) {
 6956:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6957:                       }
 6958:                     enddo //kk
 6959:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6960:                   } // outward flux
 6961:                 } // end for j=1,i34(ie) ! side
 6962:               } // end for k; ntr 
 6963: 
 6964:             else !simple upwind method
 6965:               do j=1,i34(ie)
 6966:                 jsj=elside(j,ie)
 6967:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6968:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6969:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6970:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6971:                   endif
 6972:                 enddo  !vertical layers
 6973:               enddo !j=1,i34(ie) ! side
 6974:             endif !order of accuracy
 6975: 
 6976:          //  enddo !ie
 6977: // !$OMP     end do
