 3460: /**
 3461:  * This method performs backtracking from the side center until a time -dt back in time 
 3462:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3463:  * intermediate point.
 3464:  *
 3465:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3466:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3467:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3468:  * remaining time.
 3469:  * 
 3470:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3471:  * 
 3472:  * @param uuint, vvint, wwint: Velocities at the final point
 3473:  * @param jlev: Level at which the backtracking is performed
 3474:  * @param dt, dtbk: Tracking timesteps
 3475:  * @return: True if the backtracking was successful, false otherwise
 3476:  */
 3477: __inline__ __device__ bool Side::btrack(
 3478:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3479:       double dt,            // Tracking time
 3480:       double dtbk,          // Tracking timestep
 3481:       Vector3 &u_int        // Velocities at the initial point
 3482: ) const {
 3483: 
 3484:    // Start from side center
 3485:    Point3 x0;
 3486: 
 3487:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3488:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3489: 
 3490:  
 3491:    double time_rm = dt; // Remaining time
 3492: 
 3493: 
 3494:    // Initial velocities
 3495:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3496: 
 3497:    // Find the element that is in the direction opposite to the velocity
 3498:    Element* curElem = findElementTowards(toVector2(u_int));
 3499:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3500: 
 3501:    // // If debugging backtracking, add the starting point to the debug plot and the elements for
 3502:    // // idx == 15876
 3503:    // if (idx == 15876) {
 3504:    //    printf("PPP u_int = (%f, %f, %f)\n", u_int.x, u_int.y, u_int.z);
 3505:    //    const Point3 orig = toPoint3(center, centerZ());
 3506:    //    auto vertexInOriginalFrame = [this, orig, jlev](const Node *node) -> Point3 {
 3507:    //       if constexpr(ics == 1) {
 3508:    //          return toPoint3(node->p, 0.0);
 3509:    //       } else {
 3510:    //          const Point3 p_glob = toPoint3(node->p, node->gz);
 3511:    //          const Vector3 loc = frame.G2L(p_glob - orig);
 3512:    //          return Point3(loc.x, loc.y, 0.0);
 3513:    //       }
 3514:    //    };
 3515:    //    auto elementInOriginalFrame = [this, orig, jlev](const Element *elem) -> Point3 { 
 3516:    //       if constexpr(ics == 1) {
 3517:    //          return toPoint3(elem->center, elem->centerZ());
 3518:    //       } else {
 3519:    //          const Point3 center_glob = toPoint3(elem->center, elem->centerZ());
 3520:    //          const Vector3 loc = frame.G2L(center_glob - orig);
 3521:    //          return Point3(loc.x, loc.y, loc.z);
 3522:    //       }
 3523:    //    };
 3524:    //    auto plotTriangle = [&vertexInOriginalFrame, &elementInOriginalFrame](const Element *elem, unsigned int color) {
 3525:    //       if (elem == nullptr || !elem->isTri()) return;
 3526:    //       const Point3 v0 = vertexInOriginalFrame(elem->nodes[0]);
 3527:    //       const Point3 v1 = vertexInOriginalFrame(elem->nodes[1]);
 3528:    //       const Point3 v2 = vertexInOriginalFrame(elem->nodes[2]);
 3529:    //       const Point3 center = elementInOriginalFrame(elem);
 3530:    //       addDebugPlot(v0, v1, color, 'o', elem->nodes[0]->idx);
 3531:    //       addDebugPlot(v1, v2, color, 'o', elem->nodes[1]->idx);
 3532:    //       addDebugPlot(v2, v0, color, 'o', elem->nodes[2]->idx);
 3533:    //       addDebugPlot(center, center, color, 'o', elem->idx);
 3534:    //    };
 3535:    //    plotTriangle(curElem, 0xFF0000u);  // current element in red
 3536:    //    plotTriangle(curElem->nghbElems[0], 0x00A000u);
 3537:    //    plotTriangle(curElem->nghbElems[1], 0x00A000u);
 3538:    //    plotTriangle(curElem->nghbElems[2], 0x00A000u);
 3539: 
 3540:    //    // Add the initial point (0,0) to the debug plot
 3541:    //    addDebugPlot(Point3(0.0, 0.0, 0.0), Point3(0.0, 0.0, 0.0), 0x0000FFu, '+');
 3542:    // }
 3543: 
 3544:    // Nudges it towards the barycenter
 3545: const Point3 origX0 = x0;
 3546: 
 3547:    curElem->nudgeToBarycenter(toPoint2(x0), this); // XXXX Necessary?
 3548: 
 3549: showPoints(origX0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3550: 
 3551: // if (idx == 15876) addDebugPlot(Point3(0.0, 0.0, 0.0), x0, 0xFF00FFu, 'o');
 3552: 
 3553: 
 3554:    const int MAX_ITERATIONS = 200; 
 3555:    Element* nextElem = nullptr;
 3556:    int iter = 0;
 3557:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3558:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3559:    while(true) {
 3560: 
 3561:       // Calculate timestep
 3562:       double dtb = min(dtbk, time_rm);
 3563: 
 3564: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 3565: 
 3566:       // Next point in the backtracking curve
 3567: // if (iter >= MAX_ITERATIONS - 50)  {
 3568: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 3569: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 3570: // }
 3571:         
 3572:       xt = x0 - dtb*u_int;
 3573: 
 3574: showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3575: 
 3576: // if (curElem->isDry) return true;
 3577:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 3578: // if (nextElem == nullptr) printf("RRRRR found = %d, nextElem = %p\n", found, nextElem);
 3579: // if (idx == 15876) addDebugPlot(x0, xt, 0xFF00FFu, '+');
 3580: // if (!found) printf("1111: found = %d\n", idx);
 3581: 
 3582: if (!found) {
 3583:    atomicAdd(&stopBlock, 1);
 3584:    // printf("idx = %d, curElem->idx = %d, jlev = %d\n", idx, curElem->idx, jlev);
 3585: }
 3586: __syncthreads();
 3587: if (stopBlock > 0) return false;
 3588:       assert(found && "Backtracking failed in btrack");
 3589: 
 3590: 
 3591:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 3592:                       // then time_rm needs to be increased by the unused time.
 3593: 
 3594:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 3595: 
 3596:       // If the velocity is too small, we stop the backtracking
 3597:       const double vmag = length(toVector2(u_int));
 3598:       if (vmag <= velmin_btrack) break;
 3599: 
 3600:       // The current point becomes the next segment's starting point.
 3601:       x0 = xt;
 3602:  
 3603:       curElem = nextElem;
 3604: 
 3605:       iter++;
 3606: 
 3607: 
 3608: // if (iter >= MAX_ITERATIONS - 50) {
 3609: //    addDebugPlot(center, center, 0xFF001F, 'x');  
 3610: //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 3611: //    }
 3612:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3613:    }
 3614: 
 3615:    assert(curElem != nullptr && "Final element is nullptr");
 3616:    assert(!curElem->isDry && "Final element is dry");
 3617: 
 3618: const Point3 p0 = toLocalFrame(toPoint3(curElem->nodes[0]->p, curElem->nodes[0]->gz));
 3619: const Point3 p1 = toLocalFrame(toPoint3(curElem->nodes[1]->p, curElem->nodes[1]->gz));
 3620: const Point3 p2 = toLocalFrame(toPoint3(curElem->nodes[2]->p, curElem->nodes[2]->gz));
 3621: Vector3 xt_Before = xt;
 3622: curElem->nudgeToBarycenter(toPoint2(xt), this);
 3623: Vector3 xt_After = xt;
 3624: showPoints(xt_Before, xt_After, jlev, this, 0x00006Fu, '+', 2, 10, iter);
 3625: // if (!curElem->containsPoint(toPoint2(xt), this)) printf("side->idx = %d, (%.16f,%.16f),(%.16f,%.16f),(%.16f,%.16f)  xt = (%.17f, %.17f, %.17f)\n", idx, p0.x, p0.y, p1.x, p1.y, p2.x, p2.y, xt.x, xt.y, xt.z);
 3626:    assert(curElem->containsPoint(toPoint2(xt), this) && "Target point is not inside the final element 4"); 
 3627: 
 3628: 
 3629:    // Interpolate the velocities at the final point
 3630:    u_int = curElem->interpolateVelocities(xt, this);
 3631: 
 3632:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 3633: 
 3634: 
 3635: }
