  632:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  633:       // Check if the point (xt,yt) is inside the element
  634:       double shpCoords[4];
  635: 
  636:       bool res = computeShapeCoords(xt, shpCoords, false);
  637: 
  638:       return res;
  639:    }
  640: 
  641:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  642:       // Check if the point (xt,yt) is inside the element
  643:       double shpCoords[4];
  644: 
  645:       Vector2 tmp_xt = xt;
  646:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  647: 
  648:       if (fixCoords && res) xt = tmp_xt;
  649: 
  650:       return res;
  651:    }
  652: 
  653:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  654:    {
  655:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  656:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  657:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  658:       
  659:    }
  660: 
  661:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  662: 
  663:    // ------------------------------------------------------------------------------------------------
  664:    // These are functions that work on all nodes of the element.
  665:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  666:    //
  667:    // An example of how to use these functions is:
  668:    //   
  669:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  670:    // 
  671:    // Where L is the level at which the field is to be interpolated. The field can be either
  672:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  673:    // There are different versions of getNodalValues for each of these cases.
  674: 
  675:    template<typename T>
  676:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  677:       // Get the values of the field at the nodes of the element
  678:       res[0] = nodes[0]->*field;
  679:       res[1] = nodes[1]->*field;
  680:       res[2] = nodes[2]->*field;
  681:       if (isQuad()) res[3] = nodes[3]->*field;
  682:       else          res[3] = T();
  683:    }
  684: 
  685:    template<typename T>
  686:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  687:       // Get the values of the field at the nodes of the element
  688:       res[0] = (nodes[0]->*field)[level];
  689:       res[1] = (nodes[1]->*field)[level];
  690:       res[2] = (nodes[2]->*field)[level];
  691:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  692:       else          res[3] = T();
  693:    }    
  694: 
  695:    template<typename T>
  696:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  697:       // Get the values of the func at the nodes of the element
  698:       res[0] = (nodes[0]->*func)(level);
  699:       res[1] = (nodes[1]->*func)(level);
  700:       res[2] = (nodes[2]->*func)(level);
  701:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  702:       else          res[3] = T();  // This is 0.0 or a zero vector
  703: 
  704:    }      
  705: 
  706:    template<typename T>
  707:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  708:       // Get the values of the field at the nodes of the element
  709:       res[0] = sides[0]->*field;
  710:       res[1] = sides[1]->*field;
  711:       res[2] = sides[2]->*field;
  712:       if (isQuad()) res[3] = sides[3]->*field;
  713:       else          res[3] = T();
  714:    }
  715: 
  716:    template<typename T>
  717:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  718:       // Get the values of the field at the nodes of the element
  719:       res[0] = (sides[0]->*field)[level];
  720:       res[1] = (sides[1]->*field)[level];
  721:       res[2] = (sides[2]->*field)[level];
  722:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  723:       else          res[3] = T();
  724:    }    
  725: 
  726:    template<typename T>
  727:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  728:       // Get the values of the func at the nodes of the element
  729:       res[0] = (sides[0]->*func)(level);
  730:       res[1] = (sides[1]->*func)(level);
  731:       res[2] = (sides[2]->*func)(level);
  732:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  733:       else          res[3] = T();  // This is 0.0 or a zero vector
  734: 
  735:    }      
  736: 
  737: 
  738:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  739:       double values[4];
  740:       getNodalValues(level, func, values);
  741: 
  742:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  743:    }
  744: 
  745:    template<typename T>
  746:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  747:       T values[4];
  748:       getNodalValues(field, values);
  749:       
  750:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  751:    }
  752: 
  753: 
  754:    template<typename T>
  755:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  756:       T values[4];
  757:       getNodalValues(level, field, values);
  758: 
  759:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  760:    }
  761: 
  762:    template<typename T>
  763:    __device__ T mean(T Node::* field) const {
  764:       T values[4];
  765:       getNodalValues(field, values);
  766: 
  767:       return (values[0] + values[1] + values[2] + values[3])/i34;
  768:    }
  769: 
  770:    template<typename T>
  771:    __device__ T mean(T Side::* field) const {
  772:       T values[4];
  773:       getSideValues(field, values);
  774:       
  775:       return (values[0] + values[1] + values[2] + values[3])/i34;
  776:    }   
  777: 
  778:    template<typename T>
  779:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  780:       T values[4];
  781:       getNodalValues(level, field, values);
  782: 
  783:       return (values[0] + values[1] + values[2] + values[3])/i34;
  784:    }
  785: 
  786:    template<typename T>
  787:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  788:       T values[4];
  789:       getSideValues(level, field, values);
  790:       
  791:       return (values[0] + values[1] + values[2] + values[3])/i34;
  792:    }   
  793: 
  794:    // __device__ double mean(double (Node::*func)(int) const) const {
  795:    //    double values[4];
  796:    //    getNodalValues(level, func, values);
  797:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  798:    // }
