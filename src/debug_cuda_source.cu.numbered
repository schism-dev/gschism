 1472: struct Side {
 1473: 
 1474:    // Geometry information
 1475:    int idx;               // Index of the side
 1476:    Node *n1, *n2;
 1477:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1478: 
 1479:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1480:    Vector2 center;        // Location of side center. 
 1481:    double zc[nvrt];       // Side center z-coord at each vertical level
 1482: 
 1483:    Frame<ics> frame;
 1484:    
 1485:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1486:                           // this is nullptr
 1487:    
 1488:    int16_t kb;            // Bottom index of the side
 1489:    bool isDry;            // True if the side is dry
 1490:  
 1491:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1492: 
 1493:    // Physical information
 1494:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1495:    Vector2 btu[nvrt];           // Back-tracked velocity
 1496:    Vector2 U;                   // Vertically averaged velocity vector  
 1497: 
 1498:    Vector2 nuGradU[nvrt];       // nu*grad u
 1499: 
 1500:    Vector2 bcc[nvrt];           // Baroclinic term
 1501:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1502: 
 1503:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1504:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1505:    Vector2 gradPr;               // Gradient of pressure
 1506:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1507: 
 1508: 
 1509:    double hhat;                 // \breve{H} in notes
 1510: 
 1511:    double shapiro;
 1512: 
 1513:    double coriolis;             // Coriolis parameter
 1514: 
 1515:    // Vegetation parameters
 1516:    double veg_c2;
 1517:    double veg_beta;
 1518: 
 1519:    // Bottom drag parameters.
 1520:    double chi;
 1521:    double chi2;
 1522: 
 1523:    // Transport model
 1524:    TransportSide<transportModel> transport; // Transport model 
 1525: 
 1526:    __inline__ __device__ Point2 outputCoords(void) const;
 1527: 
 1528:    __inline__ __device__ double x(double t) const;
 1529:    __inline__ __device__ double y(double t) const;
