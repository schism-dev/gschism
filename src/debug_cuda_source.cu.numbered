 4846: 
 4847: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4848:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4849:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4850:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4851: }
 4852: 
 4853: 
 4854: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4855:    // Brunt-Väisälä frequency at level k.
 4856:    if (k <= node->kb || k >= ivrt) return 0.0;
 4857:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4858: }
 4859: 
 4860: 
 4861: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4862: 
 4863:    
 4864:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4865:    // k is the layer bottom index.
 4866: 
 4867: 
 4868: 
 4869:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4870: 
 4871:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4872:       const double eta2 = node->eta2;
 4873:       const double depth = node->depth;
 4874: 
 4875:       // Distances from the layer midpoint to the surface and bottom
 4876:       const double dist_s = eta2 - z_c;
 4877:       const double dist_b = z_c + depth;
 4878: 
 4879:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4880: 
 4881:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4882: 
 4883: 
 4884:    } else {
 4885:       return 1.0; // Other GLS submodels
 4886: 
 4887:    }
 4888: }
 4889: 
 4890: 
 4891: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4892:    // Minimum mixing length for levels below the surface.
 4893:    // Independent of psimin(); do not invert one to get the other.
 4894:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4895: }
 4896: 
 4897: 
 4898: __device__ void Turbulence<TurbulenceModel::GLS>::init(Node *node) {
 4899:    // Whole column, including levels below kb. Matches the Fortran cold start.
 4900:    for (int k = 0; k < nvrt; k++) {
 4901:       tke[k]    = tkemin();
 4902:       mxl[k]    = mxlmin(node->depth);
 4903:       nu_tke[k] = diffmin;
 4904:       nu_phi[k] = diffmin;
 4905: 
 4906:       node->dfv[k] = 0.0;
 4907:       node->dfh[k] = 0.0;
 4908:    }
 4909: }
 4910: 
 4911: 
 4912: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4913: 
 4914:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4915: 
 4916:    if constexpr(iveg == 1) {
 4917:       
 4918:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4919:       const double zTopCanopy = node->zTopCanopy();
 4920: 
 4921:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4922: 
 4923:          const double ztop = node->z[k];   // Top of the current layer.
 4924: 
 4925:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4926:          // Where 1 means that the current level is fully within the vegetation layer.
 4927:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4928: 
 4929:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4930:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4931: 
 4932:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4933:          // and at the bottom of the layer.
 4934:          const double vmag_top = length(ub2_top);
 4935:          const double vmag_bot = length(node->u2[k-1]);
 4936: 
 4937:          // Volume-averaged velocity cubed.
 4938:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4939: 
 4940:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4941:          // and at the bottom of the layer.
 4942:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4943:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4944: 
 4945:          // Volume-averaged vegetation alpha cubed.
 4946:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4947: 
 4948:          return veg_alpha3D*vmag3;
 4949:       } 
 4950:       else {
 4951:          // The current level is not within the vegetation layer, so the production is 0.
 4952:          return 0.0;
 4953:       }
 4954:    } else {
 4955: 
 4956:       // If no vegetation, the production is 0.
 4957:       return 0.0;
 4958:    }
 4959: 
 4960: }
 4961: 
 4962: 
 4963: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 4964:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 4965:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 4966: 
 4967:    const int kb = node->kb;
 4968: 
 4969:    for (int k = kb; k < nvrt; k++) {
 4970:       const double tke = this->tke[k];
 4971:       const double mxl = this->mxl[k];
 4972:       const double u = sqrt(tke);  // Characteristic velocity
 4973:       const double lu = mxl*u;     // Characteristic diffusivity 
 4974: 
 4975:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 4976:       double drho_dz = 0.0;
 4977:       if (k > kb && k < ivrt) {
 4978:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4979:       }
 4980: 
 4981:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 4982: 
 4983:       // Tsinghua group       
 4984:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 4985: 
 4986:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 4987:       if constexpr (stabilityModel == Galperin) {
 4988:          sh = 0.49393/(1.0-34.676*Gh);
 4989:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 4990:          cmiu  = sqrt(2.0)*sm;
 4991:          cmiup = sqrt(2.0)*sh;
 4992:          cmiu1 = sqrt(2.0)*0.2;
 4993:          cmiu2 = sqrt(2.0)*0.2;
 4994: 
 4995:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 4996:          // Warner's paper has problem
 4997:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 4998:          const double Ghp = Gh;  /// XXXXX needed?
 4999:          sh = 0.4939/(1.0 - 30.19*Ghp);
 5000:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 5001:          cmiu  = sqrt(2.0)*sm;
 5002:          cmiup = sqrt(2.0)*sh;
 5003:          cmiu1 = cmiu/schk();
 5004:          cmiu2 = cmiu/schpsi();
 5005: 
 5006:       } else {
 5007:          assert(false && "Unknown ASM");
 5008: 
 5009:       }
 5010: 
 5011:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 5012:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 5013:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 5014:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 5015:    }
 5016: }
 5017: 
 5018: 
 5019: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 5020: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 5021: 
 5022:    const double z = node->z[k];
 5023:    const double eta2 = node->eta2;
 5024:    const double depth = node->depth;
 5025: 
 5026:    // Distances to the surface and bottom
 5027:    const double dist_s = eta2 - z;
 5028:    const double dist_b = z + depth;
 5029: 
 5030:    // Distance to the closest "wall" (either surface or bottom).  
 5031:    // In the top layer, it is the size of the layer.
 5032:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 5033:    assert(min_dist > 0.0 && "Invalid minimum distance");
 5034: 
 5035:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 5036:    return kappa*min_dist;
 5037: }
 5038: 
 5039: 
 5040: 
 5041: template<TurbulenceModel turbulenceModel>
 5042: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 5043: 
 5044: 
 5045: template<>
 5046: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 5047:    // Constant turbulence model
 5048:    // Does nothing since dfv and dfh are already set  in the initialization.
 5049: }
 5050: 
 5051: template<>
 5052: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 5053:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 5054: 
 5055:    // Solves the following PDEs:
 5056:    //
 5057:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 5058:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 5059:    //
 5060:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 5061:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 5062:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 5063:    //
 5064:    // The equations are solved using a linear *vertical* FEM formulation.
 5065:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 5066:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 5067:    
 5068:    
 5069:    // Get the turbulence model
 5070:    // reinterpret_cast is used to avoid stupid compiler errors.
 5071:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 5072:      
 5073:    const int kb = node->kb;
 5074:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 5075: 
 5076:    double alow_tke[nvrt], alow_phi[nvrt];
 5077:    double bdia_tke[nvrt], bdia_phi[nvrt];
 5078:    double cupp_tke[nvrt], cupp_phi[nvrt];
 5079:    double rhs_tke [nvrt], rhs_phi [nvrt];
 5080:    
 5081:    // Initialize the tridiagonal system
 5082:    for (int kin = 0; kin < nqrows; kin++) {
 5083:       alow_tke[kin]=0.0;
 5084:       bdia_tke[kin]=0.0;
 5085:       cupp_tke[kin]=0.0;
 5086:       rhs_tke [kin]=0.0; 
 5087:       alow_phi[kin]=0.0;
 5088:       bdia_phi[kin]=0.0;
 5089:       cupp_phi[kin]=0.0;
 5090:       rhs_phi [kin]=0.0; 
 5091:    }
 5092: 
 5093: 
 5094: 
 5095:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 5096:    if (node->isDry || node->is2D()) {
 5097: 
 5098:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 5099:       const double diffmin = turb.diffmin;
 5100: 
 5101:       for (int k = 0; k < nvrt; k++) {
 5102:          turb.tke[k]    = turb.tkemin();
 5103:          turb.mxl[k]    = turb.mxlmin(node->depth);
 5104:          node->dfv[k]   = diffmin;
 5105:          node->dfh[k]   = diffmin;
 5106:          turb.nu_tke[k] = diffmin;
 5107:          turb.nu_phi[k] = diffmin;
 5108:       }
 5109: 
 5110:       return;
 5111:    }
 5112: 
 5113:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 5114:    
 5115:    // After here we know that the node is wet and has at least 2 layers.
 5116: 
 5117:    double solution[nvrt], gam[nvrt];
 5118:    
 5119:    const double eta2       = node->eta2;
 5120:    const double depth      = node->depth;
 5121:    const double Cd         = node->Cd; // Drag coefficient
 5122: 
 5123:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 5124:    
 5125:    const double sqU2 = norm2(node->u2[kb + 1]);
 5126:    const double modTau = length(node->tau);
 5127: 
 5128:  
 5129: 
 5130:    const double cpsi1 = turb.cpsi1();
 5131:    const double cpsi2 = turb.cpsi2();
 5132:    // cpsi3 is computed later because it depends on k
 5133: 
 5134: 
 5135:    // Assemble the tridiagonal system
 5136:    // -------------------------------
 5137: 
 5138:    // Loop over each vertical layer (interval between two vertical levels)
 5139:    // Each interval is an element of the vertical FEM formulation.
 5140:    // Two shape functions are defined over each interval. In this function we well call them
 5141:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5142:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5143:    //
 5144:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5145:    // Both systems of equations are assembled in the same loop.
 5146:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5147: 
 5148:       // Indices for the *rows* of the tridiagonal system.
 5149:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5150:       const int k2 = k - kb;     // One at k = kb + 1
 5151: 
 5152:       // Get the properties of the current interval.
 5153:       const double z  = node->z[k]; // bottom level of the interval
 5154:       const double dz = node->Dz(k + 1);
 5155:       
 5156:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5157: 
 5158:       // Turbulence production/dissipation terms (at the center of the interval).
 5159:       
 5160:       const double M2 = norm2(du_dz_c);              // Shear production term
 5161: 
 5162:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5163: 
 5164:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5165: 
 5166:       const double cpsi3 = turb.cpsi3(N2); 
 5167: 
 5168: 
 5169:       // Turbulence quantities at half levels (cell [c]enter)
 5170:       const double tke_1     = turb.tke[k];
 5171:       const double tke_2     = turb.tke[k+1];
 5172:       const double mxl_1     = turb.mxl[k];
 5173:       const double mxl_2     = turb.mxl[k+1];
 5174:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5175:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5176:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5177:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5178:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5179:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5180:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5181: 
 5182:       // Integral of the shape function products:
 5183:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5184:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5185:       const double p1p1 = dz/3.0;
 5186:       const double p1p2 = dz/6.0;
 5187:       const double d1d1 =  1.0/dz;
 5188:       const double d1d2 = -1.0/dz;
 5189: 
 5190:       // Production/dissipation related terms
 5191:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5192:       const double buoy = dfh_c*N2;
 5193:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5194: 
 5195: 
 5196: 
 5197:       // Equation for tke
 5198:       // ---------------
 5199: 
 5200:       // First row (of the two rows that the interval contributes to)
 5201:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5202:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5203:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5204: 
 5205: 
 5206:       if(prod + buoy >= 0.0) { // Net production
 5207:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5208:       } else { // Net dissipation
 5209:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5210:          bdia_tke[k1] -= 2.0*tmp;
 5211:          cupp_tke[k1] -= tmp;
 5212:       }      
 5213:       
 5214:       bdia_tke[k1] += 2.0*dt*diss;
 5215:       cupp_tke[k1] += dt*diss;
 5216:       
 5217:   
 5218:       // Second row (of the two rows that the interval contributes to)
 5219:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5220:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5221:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5222: 
 5223:       if (prod + buoy >= 0.0) { // Net production
 5224:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5225:       } else { // Net dissipation
 5226:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5227:          bdia_tke[k2] -= 2.0*tmp;
 5228:          alow_tke[k2] -= tmp;
 5229:       }
 5230:       
 5231:       bdia_tke[k2] += 2.0*dt*diss;
 5232:       alow_tke[k2] += dt*diss;
 5233: 
 5234: 
 5235:       // Equation for xl
 5236:       // ---------------
 5237: 
 5238:       const double rpub = turb.rpub();
 5239:       const double rmub = turb.rmub();
 5240:       const double rnub = turb.rnub();
 5241:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5242:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5243:       const double psi_c = 0.5*(psi_1 + psi_2);
 5244: 
 5245:       // Production/dissipation related terms
 5246:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5247:       const double buoy_phi = cpsi3*dfh_c*N2;
 5248:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5249: 
 5250:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5251:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5252:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5253: 
 5254:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5255:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5256:       } else { // Net dissipation
 5257:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5258:          bdia_phi[k1] -= 2.0*tmp;
 5259:          cupp_phi[k1] -= tmp;
 5260:       }
 5261: 
 5262:       // Production/dissipation terms
 5263:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5264:       cupp_phi[k1] += dt*diss_phi;
 5265:  
 5266: 
 5267:       // row k2 (upper)
 5268:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5269:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5270:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5271: 
 5272:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5273:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5274:       } else { // Net dissipation
 5275:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5276:          bdia_phi[k2] -= 2.0*tmp;
 5277:          alow_phi[k2] -= tmp;
 5278:       }
 5279: 
 5280:       // Production/dissipation terms
 5281:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5282:       alow_phi[k2] += dt*diss_phi;
 5283: 
 5284:    }
 5285: 
 5286:    // BC
 5287:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5288:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5289: 
 5290: 
 5291:    // Solves for tke.
 5292:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5293: 
 5294: 
 5295:    // B.C. (computed using values from previous time except wind)
 5296:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5297:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5298: 
 5299: 
 5300:    // Update TKE.
 5301:    turb.tke[kb]     = tkebot;
 5302:    turb.tke[kb + 1] = tkebot;
 5303:    turb.tke[ivrt]   = tkesrf;
 5304:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5305:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5306: // printf("tke[%d]: %f, solution[%d]: %f\n", k, turb.tke[k], kin, solution[kin]);   
 5307:    }
 5308: 
 5309: 
 5310: 
 5311:  
 5312:    // Solves for phi.
 5313:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5314: 
 5315: 
 5316:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5317:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5318:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5319: 
 5320:    turb.mxl[kb+1] = mxlbot;
 5321:    turb.mxl[ivrt] = mxlsrf;
 5322:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5323:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5324: 
 5325:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5326: 
 5327:       // Galperin's clipping
 5328:       if (N2 < 0.0) {
 5329:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5330:          turb.mxl[k] = min(turb.mxl[k], upper);
 5331:       }   
 5332: 
 5333: 
 5334: 
 5335:       // Max. mixing length based on dissipation; mxlmin prevails
 5336:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5337: 
 5338:       // Combined max. mixing length including geometric limit
 5339:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5340: 
 5341:       // Clamp the mixing length between the minimum and maximum values
 5342:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5343: 
 5344:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5345: 
 5346: 
 5347:    } // for k
 5348: 
 5349: 
 5350:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5351:    turb.tke[kb] = turb.tke[kb + 1];
 5352:    turb.mxl[kb] = turb.mxl[kb + 1];
 5353: 
 5354: 
 5355:    // Compute vertical diffusivities at new time
 5356:    turb.computeDiffusivities(node);
 5357: 
 5358:    // make all the variables uniform below the bottom level kb
 5359:    for (int k = 0; k < kb; k++) {
 5360:       node->dfv[k] = node->dfv[kb];
 5361:       node->dfh[k] = node->dfh[kb];
 5362:       turb.tke[k] = turb.tke[kb];
 5363:       turb.mxl[k] = turb.mxl[kb];
 5364:       turb.nu_tke[k] = turb.nu_tke[kb];
 5365:       turb.nu_phi[k] = turb.nu_phi[kb];
 5366:    }
 5367: 
 5368:       
 5369: 
 5370: }
 5371: 
 5372: 
 5373: 
 5374: 
 5375: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5376:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5377:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5378: 
 5379: 
 5380:    NODE(node1);
 5381: 
 5382:    node1->clearMatrixRow();
 5383:    node1->qel = 0.0;
 5384: 
 5385:    // THIS IS FOR STRUCTURES XXX
 5386:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5387: 
 5388:    
 5389:    for (int j=0; j<node1->numElements; j++) {
 5390:       // For each element connected to the node...
 5391: 
 5392:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5393: 
 5394:       Element *elem = node1->elements[j];
 5395: 
 5396:       // Compute the average gravity
 5397:       const double grav3 = elem->mean(&Node::grav2);
 5398: 
 5399:       // Look at the documentation for the description of the terms in the following integrals
 5400: 
 5401:       // Integral I_1 
 5402:       // \bar{\breve{H}} 
 5403:       const double hhatb = elem->mean(&Side::hhat);        
 5404: 
 5405:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5406: 
 5407:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5408:       const double area = elem->area;
 5409: 
 5410:       // Integral I_4
 5411:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5412:       // Where
 5413:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5414: 
 5415:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5416:       // of U over the element.
 5417:       const Vector2 U = elem->mean(&Side::U);
 5418: 
 5419:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5420: 
 5421:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5422:       const double I_4_1 = dot(gradPhi_1, U);
 5423: 
 5424: 
 5425:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5426:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5427: 
 5428:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5429: 
 5430: 
 5431:       // Normal component of the bed velocity
 5432:       double ubedNormalComp = 0.0;
 5433:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5434:          Vector3 ubed = {0.0, 0.0, 0.0};
 5435:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5436:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5437: 
 5438:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5439:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5440:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5441: 
 5442:          // Computes the normal component of the bed velocity
 5443:          ubedNormalComp = dot(ubed, N);
 5444:       } // imm==2
 5445: 
 5446:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5447: 
 5448:       if (elem->isTri()) {
 5449: 
 5450:          // To clarify the notation in this section: 
 5451:          //   In formulas, we use the following notation:
 5452:          //       i stands for the node under consideration (node1)
 5453:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5454:          //   However, in the code, we use the following notation:
 5455:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5456:          const int id2 = elem->nxq(1 + id1);
 5457:          const int id3 = elem->nxq(2 + id1);
 5458:          Node *node2 = elem->nodes[id2];
 5459:          Node *node3 = elem->nodes[id3];
 5460: 
 5461:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5462: 
 5463:          // integral of phi_i*phi_j
 5464:          const double ipp_ii = (1.0/6.0 )*area;
 5465:          const double ipp_ij = (1.0/12.0)*area;
 5466:          const double ipp_ik = (1.0/12.0)*area;
 5467: 
 5468:          // integral of [(grad phi_i) * (grad phi_j)]
 5469:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5470:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5471:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5472: 
 5473:          // Computes the different components of integral I_1 of each node with respect to node i.
 5474:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5475:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5476:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5477: 
 5478:          node1->addToSparseMatrix(node1, I1_ii);
 5479:          node1->addToSparseMatrix(node2, I1_ij); 
 5480:          node1->addToSparseMatrix(node3, I1_ik);
 5481: 
 5482:          #pragma unroll
 5483:          for (int l=0; l<3; l++) {
 5484: 
 5485:             Node *node = elem->nodes[l];
 5486: 
 5487:             // Additional variation in eta due to bed deformation or vertical velocity
 5488:             double extraEta = 0.0;
 5489:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5490:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5491: 
 5492: 
 5493:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5494:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5495: 
 5496:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5497: 
 5498:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5499:            
 5500:          }
 5501: 
 5502: 
 5503:       }
 5504:       else { // Quad
 5505:          // To clarify the notation in this section: 
 5506:          //   In formulas, we use the following notation:
 5507:          //       i stands for the node under consideration (node1)
 5508:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5509:          //   However, in the code, we use the following notation:
 5510:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5511:          const int id2 = elem->nxq(1 + id1);
 5512:          const int id3 = elem->nxq(2 + id1);
 5513:          const int id4 = elem->nxq(3 + id1);
 5514:          Node *node2 = elem->nodes[id2];
 5515:          Node *node3 = elem->nodes[id3];
 5516:          Node *node4 = elem->nodes[id4];   
 5517:          
 5518:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5519: 
 5520:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5521:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5522:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5523:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5524:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5525: 
 5526:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5527:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5528:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5529:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5530:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5531: 
 5532: 
 5533:          // Computes the different components of integral I_1 of each node with respect to node i.
 5534:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5535:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5536:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5537:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5538: 
 5539:          node1->addToSparseMatrix(node1, I1_ii);
 5540:          node1->addToSparseMatrix(node2, I1_ij); 
 5541:          node1->addToSparseMatrix(node3, I1_ik);
 5542:          node1->addToSparseMatrix(node4, I1_il);
 5543:   
 5544:          #pragma unroll
 5545:          for (int l=0; l<4; l++) {
 5546: 
 5547:             const Node *node = elem->nodes[l];
 5548: 
 5549:             // Additional variation in eta due to bed deformation or vertical velocity
 5550:             double extraEta = 0.0;
 5551:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5552:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5553: 
 5554:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5555:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5556:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5557: 
 5558:          }         
 5559:       } 
 5560: 
 5561: 
 5562:      node1->qel += (dt/elem->i34)*elem->vsource;
 5563:       
 5564: 
 5565:    } // for all elements connected to the node
 5566:    
 5567: 
 5568:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5569:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5570:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5571:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5572:    // If it is an open boundary node...
 5573: 
 5574:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5575: 
 5576:       // At least one open bnd side, maybe two
 5577:       for (int l=0; l<2; l++) { 
 5578: 
 5579:          // Gets each of the sides sharing the node. 
 5580:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5581: 
 5582:     
 5583: 
 5584:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5585:          if (sideBnd != nullptr) {
 5586:             // If the side is on a boundary...
 5587: 
 5588:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5589: 
 5590:             // Get the boundary segment
 5591:             const BoundarySegment *sideSegment = sideBnd->segment;
 5592:             const Side *side = sideBnd->side;
 5593: 
 5594:             // Integral I_3
 5595:             if (sideSegment->ifltype != 0) {
 5596:             // Natural or Flather b.c.
 5597: 
 5598:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5599:                // especially for Flather b.c.
 5600:                double ri3 = 0.0;
 5601:                if (!side->isDry) {
 5602:                   // If the side is not dry
 5603:                   
 5604:                   // Computes the side flux of (uth, vth)
 5605:                   double Vn = 0.0;
 5606:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5607:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5608:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5609: 
 5610:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5611:                   }
 5612: 
 5613:                   ri3 = 0.5*side->len*Vn;
 5614:                }
 5615: 
 5616:                if (sideSegment->ifltype == -1) { // Flather 1
 5617: 
 5618:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5619:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5620: 
 5621:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5622:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5623:                   
 5624:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5625:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5626: 
 5627:                } 
 5628:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5629:                   // Reset ri3
 5630:                   ri3 = 0.0;
 5631: 
 5632:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5633:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5634: 
 5635:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5636: 
 5637:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5638:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5639: 
 5640:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5641:                   node1->addToSparseMatrix(node1, con0*2.0);
 5642:                   node1->addToSparseMatrix(node2, con0);
 5643: 
 5644:                } // if Flather or Discharge
 5645: 
 5646:                node1->qel -= thetai*dt*ri3;  
 5647: 
 5648: 
 5649:             } // I_3
 5650:           
 5651: 
 5652:             // Integral I_5
 5653:             if(!side->isDry) {
 5654: 
 5655:                const double Unbar = dot(side->U, side->n);
 5656:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5657: 
 5658:             } // I_5
 5659: 
 5660:          } // if is boundary side
 5661: 
 5662:       } // for l
 5663: 
 5664:    } // if isbnd
 5665: 
 5666: 
 5667: }
 5668: 
 5669: 
 5670: 
 5671: extern "C" {
 5672: 
 5673:    __global__ void gatherBFromMesh(double* b) {
 5674:       // b[local] <- qel  (local = idx_node on this device)
 5675:       NODE(node);
 5676:       b[idx_node] = node->qel;
 5677:    }
 5678: 
 5679:    
 5680:    __global__ void scatterXToMesh(double* x) {
 5681:       // mX <- x[local]
 5682:       NODE(node);
 5683:       node->mX = x[idx_node];
 5684:    }
 5685: 
 5686:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 5687:                                  int* indices, int* indptr) {
 5688:       // XXXXXXXXXXXX REMOVE!!!
 5689:       assert(false && "setupCGSolver has beed deprecated");
 5690: 
 5691:       // NODE(node);
 5692:       
 5693:       // const int idx = node->idx;
 5694:       
 5695:       // // Computes the index in the nzz array      
 5696:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 5697: 
 5698: 
 5699:       // indptr[idx] = nzzIdx;
 5700:       // indices[nzzIdx] = idx;
 5701: 
 5702:       // data_d[nzzIdx]    = node->coeffDiag;
 5703: 
 5704:       // b_d[idx] = node->qel;
 5705: 
 5706:       // for (int k = 0; k < node->numNodes; ++k) {
 5707:       //    const Node* nb = node->nodes[k];
 5708: 
 5709:       //    const int j = nb->idx;
 5710: 
 5711:       //    data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 5712: 
 5713:       //    indices[nzzIdx + k + 1] = j;
 5714:       // }
 5715: 
 5716:    }
 5717: 
