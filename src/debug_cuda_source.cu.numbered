 1752: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1753: // return;   
 1754:    // Lock the mutex
 1755:    lock(&debugPlotMutex);
 1756:  
 1757:    bool ok = true;
 1758:    if (debugPlotIdx == nullptr) ok = false;
 1759:    if (*debugPlotIdx >= 10000) ok = false;
 1760:    if (ok) {
 1761:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1762:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1763:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1764:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1765:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1766:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1767:       (*debugPlotIdx)++;
 1768:    }
 1769: 
 1770:    __threadfence();               // ensure all above writes are visible
 1771:    // Unlock the mutex
 1772:    unlock(&debugPlotMutex);
 1773: 
 1774: }
