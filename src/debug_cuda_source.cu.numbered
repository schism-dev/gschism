 2522: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2523:    // Returns the value of the velocity at the side center
 2524:    const double w1 = getBoundaryArrayValueWeight();
 2525:    const double w2 = 1.0 - w1;
 2526:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2527:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2528: 
 2529:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2530: }
