 3381: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3382:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3383:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3384:                 int *isdel, int *isidenode, int *isbnd,
 3385:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3386:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3387:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3388:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3389:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3390:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3391:                 double *drag, double *roughness,
 3392:                 double *emo, double *efa, 
 3393:                 double *umo, double *ufa, 
 3394:                 double *vmo, double *vfa) {
 3395: 
 3396:    // printf("Populating mesh for partition %d\n", partNum);
 3397: 
 3398:    // XXXXXX THIS function does almost nothing. 
 3399: 
 3400:    nbs = *sharedIdxSideBoundary + 1;
 3401:    nbp = *sharedIdxNodeBoundary + 1;
 3402: 
 3403:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3404: 
 3405: }
