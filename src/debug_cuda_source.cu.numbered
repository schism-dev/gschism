 7060: 
 7061:    __global__ void setVelocityOpenBndNodes(void) {
 7062:    // For open boundary nodes sets their velocity to the imposed values.
 7063: 
 7064:       SIDE_BND(sidebnd);
 7065: 
 7066:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7067:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7068:          // to its segment to the average of the side velocity.
 7069: 
 7070:          for (int k = 0; k < nvrt; k++) {
 7071:             Node *n1 = sidebnd->side->n1;
 7072:             Node *n2 = sidebnd->side->n2;
 7073: 
 7074: 
 7075:             Vector2 n1_u2(n1->u2[k]);
 7076:             Vector2 n2_u2(n2->u2[k]);
 7077: 
 7078:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7079:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7080:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7081:             }
 7082:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7083:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7084:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7085:             }
 7086: 
 7087:          }
 7088: 
 7089:       }
 7090: 
 7091:    }
