 2101: // Helper functions for computing the local node index at a given offset from another.
 2102: __device__ __inline__ int nxq(int offset, int index, int size) {
 2103:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2104:    // to the index to make it positive
 2105:    assert(index + offset + 16*size >= 0);
 2106:    return (index + offset + 16*size) % size;  
 2107: }
 2108: 
 2109: __device__ __inline__ int nxq(int index, int size) {
 2110:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2111:    // to the index to make it positive
 2112:    assert(index + 16*size >= 0);
 2113:    return (index + 16*size) % size; 
 2114: }
