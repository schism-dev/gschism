 2209:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2210:       // Compute the different time ramps used in the code 
 2211:       // This function is performed by just one thread
 2212: 
 2213:       rampbc = 1.0;
 2214:       if constexpr(ibc == 0) {
 2215:          if (drampbc > 0.0) {
 2216:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2217:          } else {
 2218:             rampbc = 1.0;
 2219:          }
 2220:       }
 2221: 
 2222:       if (nws != 0) {
 2223:          if (drampwind > 0.0) {
 2224:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2225:          } else {
 2226:             rampwind = 1.0;
 2227:          }
 2228:       }
 2229: 
 2230:       if (drampwafo > 0.0) {
 2231:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2232:       } else {
 2233:          rampwafo = 1.0;
 2234:       }
 2235: 
 2236:       // For source/sinks
 2237:       if (if_source && dramp_ss > 0.0) {
 2238:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2239:       } else {
 2240:          ramp_ss = 1.0;
 2241:       }
 2242: 
 2243:       if (dramp > 0.0) {
 2244:          ramp = tanh(2.0*time/86400.0/dramp);
 2245:       } else {
 2246:          ramp = 1.0;
 2247:       }
 2248: 
 2249: 
 2250:    }
