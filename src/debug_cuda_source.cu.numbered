 4734: 
 4735: 
 4736: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4737:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4738:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4739:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4740: }
 4741: 
 4742: 
 4743: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4744:    // Brunt-Väisälä frequency at level k.
 4745:    if (k <= node->kb || k >= ivrt) return 0.0;
 4746:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4747: }
 4748: 
 4749: 
 4750: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4751: 
 4752:    
 4753:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4754:    // k is the layer bottom index.
 4755: 
 4756: 
 4757: 
 4758:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4759: 
 4760:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4761:       const double eta2 = node->eta2;
 4762:       const double depth = node->depth;
 4763: 
 4764:       // Distances from the layer midpoint to the surface and bottom
 4765:       const double dist_s = eta2 - z_c;
 4766:       const double dist_b = z_c + depth;
 4767: 
 4768:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4769: 
 4770:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4771: 
 4772: 
 4773:    } else {
 4774:       return 1.0; // Other GLS submodels
 4775: 
 4776:    }
 4777: }
 4778: 
 4779: 
 4780: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4781:    // Minimum mixing length for levels below the surface.
 4782:    // Independent of psimin(); do not invert one to get the other.
 4783:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4784: }
 4785: 
 4786: 
 4787: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4788: 
 4789:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4790: 
 4791:    if constexpr(iveg == 1) {
 4792:       
 4793:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4794:       const double zTopCanopy = node->zTopCanopy();
 4795: 
 4796:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4797: 
 4798:          const double ztop = node->z[k];   // Top of the current layer.
 4799: 
 4800:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4801:          // Where 1 means that the current level is fully within the vegetation layer.
 4802:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4803: 
 4804:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4805:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4806: 
 4807:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4808:          // and at the bottom of the layer.
 4809:          const double vmag_top = length(ub2_top);
 4810:          const double vmag_bot = length(node->u2[k-1]);
 4811: 
 4812:          // Volume-averaged velocity cubed.
 4813:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4814: 
 4815:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4816:          // and at the bottom of the layer.
 4817:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4818:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4819: 
 4820:          // Volume-averaged vegetation alpha cubed.
 4821:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4822: 
 4823:          return veg_alpha3D*vmag3;
 4824:       } 
 4825:       else {
 4826:          // The current level is not within the vegetation layer, so the production is 0.
 4827:          return 0.0;
 4828:       }
 4829:    } else {
 4830: 
 4831:       // If no vegetation, the production is 0.
 4832:       return 0.0;
 4833:    }
 4834: 
 4835: }
 4836: 
 4837: 
 4838: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 4839:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 4840:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 4841: 
 4842:    const int kb = node->kb;
 4843: 
 4844:    for (int k = kb; k < nvrt; k++) {
 4845:       const double tke = this->tke[k];
 4846:       const double mxl = this->mxl[k];
 4847:       const double u = sqrt(tke);  // Characteristic velocity
 4848:       const double lu = mxl*u;     // Characteristic diffusivity 
 4849: 
 4850:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 4851:       double drho_dz = 0.0;
 4852:       if (k > kb && k < ivrt) {
 4853:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4854:       }
 4855: 
 4856:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 4857: 
 4858:       // Tsinghua group       
 4859:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 4860: 
 4861:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 4862:       if constexpr (stabilityModel == Galperin) {
 4863:          sh = 0.49393/(1.0-34.676*Gh);
 4864:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 4865:          cmiu  = sqrt(2.0)*sm;
 4866:          cmiup = sqrt(2.0)*sh;
 4867:          cmiu1 = sqrt(2.0)*0.2;
 4868:          cmiu2 = sqrt(2.0)*0.2;
 4869: 
 4870:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 4871:          // Warner's paper has problem
 4872:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 4873:          const double Ghp = Gh;  /// XXXXX needed?
 4874:          sh = 0.4939/(1.0 - 30.19*Ghp);
 4875:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 4876:          cmiu  = sqrt(2.0)*sm;
 4877:          cmiup = sqrt(2.0)*sh;
 4878:          cmiu1 = cmiu/schk();
 4879:          cmiu2 = cmiu/schpsi();
 4880: 
 4881:       } else {
 4882:          assert(false && "Unknown ASM");
 4883: 
 4884:       }
 4885: 
 4886:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 4887:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 4888:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 4889:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 4890:    }
 4891: }
 4892: 
 4893: 
 4894: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 4895: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 4896: 
 4897:    const double z = node->z[k];
 4898:    const double eta2 = node->eta2;
 4899:    const double depth = node->depth;
 4900: 
 4901:    // Distances to the surface and bottom
 4902:    const double dist_s = eta2 - z;
 4903:    const double dist_b = z + depth;
 4904: 
 4905:    // Distance to the closest "wall" (either surface or bottom).  
 4906:    // In the top layer, it is the size of the layer.
 4907:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 4908:    assert(min_dist > 0.0 && "Invalid minimum distance");
 4909: 
 4910:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 4911:    return kappa*min_dist;
 4912: }
 4913: 
 4914: 
 4915: 
 4916: template<TurbulenceModel turbulenceModel>
 4917: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 4918: 
 4919: 
 4920: template<>
 4921: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 4922:    // Constant turbulence model
 4923:    // Does nothing since dfv and dfh are already set  in the initialization.
 4924: }
 4925: 
 4926: template<>
 4927: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 4928:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 4929: 
 4930:    // Solves the following PDEs:
 4931:    //
 4932:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 4933:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 4934:    //
 4935:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 4936:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 4937:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 4938:    //
 4939:    // The equations are solved using a linear *vertical* FEM formulation.
 4940:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 4941:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 4942:    
 4943:    
 4944:    // Get the turbulence model
 4945:    // reinterpret_cast is used to avoid stupid compiler errors.
 4946:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 4947:      
 4948:    const int kb = node->kb;
 4949:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 4950: 
 4951:    double alow_tke[nvrt], alow_phi[nvrt];
 4952:    double bdia_tke[nvrt], bdia_phi[nvrt];
 4953:    double cupp_tke[nvrt], cupp_phi[nvrt];
 4954:    double rhs_tke [nvrt], rhs_phi [nvrt];
 4955:    
 4956:    // Initialize the tridiagonal system
 4957:    for (int kin = 0; kin < nqrows; kin++) {
 4958:       alow_tke[kin]=0.0;
 4959:       bdia_tke[kin]=0.0;
 4960:       cupp_tke[kin]=0.0;
 4961:       rhs_tke [kin]=0.0; 
 4962:       alow_phi[kin]=0.0;
 4963:       bdia_phi[kin]=0.0;
 4964:       cupp_phi[kin]=0.0;
 4965:       rhs_phi [kin]=0.0; 
 4966:    }
 4967: 
 4968: 
 4969: 
 4970:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 4971:    if (node->isDry || node->is2D()) {
 4972: 
 4973:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 4974:       const double diffmin = turb.diffmin;
 4975: 
 4976:       for (int k = 0; k < nvrt; k++) {
 4977:          turb.tke[k]    = turb.tkemin();
 4978:          turb.mxl[k]    = turb.mxlmin(node->depth);
 4979:          node->dfv[k]   = diffmin;
 4980:          node->dfh[k]   = diffmin;
 4981:          turb.nu_tke[k] = diffmin;
 4982:          turb.nu_phi[k] = diffmin;
 4983:       }
 4984: 
 4985:       return;
 4986:    }
 4987: 
 4988:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 4989:    
 4990:    // After here we know that the node is wet and has at least 2 layers.
 4991: 
 4992:    double solution[nvrt], gam[nvrt];
 4993:    
 4994:    const double eta2       = node->eta2;
 4995:    const double depth      = node->depth;
 4996:    const double Cd         = node->Cd; // Drag coefficient
 4997: 
 4998:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 4999:    
 5000:    const double sqU2 = norm2(node->u2[kb + 1]);
 5001:    const double modTau = length(node->tau);
 5002: 
 5003:  
 5004: 
 5005:    const double cpsi1 = turb.cpsi1();
 5006:    const double cpsi2 = turb.cpsi2();
 5007:    // cpsi3 is computed later because it depends on k
 5008: 
 5009: 
 5010:    // Assemble the tridiagonal system
 5011:    // -------------------------------
 5012: 
 5013:    // Loop over each vertical layer (interval between two vertical levels)
 5014:    // Each interval is an element of the vertical FEM formulation.
 5015:    // Two shape functions are defined over each interval. In this function we well call them
 5016:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5017:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5018:    //
 5019:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5020:    // Both systems of equations are assembled in the same loop.
 5021:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5022: 
 5023:       // Indices for the *rows* of the tridiagonal system.
 5024:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5025:       const int k2 = k - kb;     // One at k = kb + 1
 5026: 
 5027:       // Get the properties of the current interval.
 5028:       const double z  = node->z[k]; // bottom level of the interval
 5029:       const double dz = node->Dz(k + 1);
 5030:       
 5031:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5032: 
 5033:       // Turbulence production/dissipation terms (at the center of the interval).
 5034:       
 5035:       const double M2 = norm2(du_dz_c);              // Shear production term
 5036: 
 5037:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5038: 
 5039:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5040: 
 5041:       const double cpsi3 = turb.cpsi3(N2); 
 5042: 
 5043: 
 5044:       // Turbulence quantities at half levels (cell [c]enter)
 5045:       const double tke_1     = turb.tke[k];
 5046:       const double tke_2     = turb.tke[k+1];
 5047:       const double mxl_1     = turb.mxl[k];
 5048:       const double mxl_2     = turb.mxl[k+1];
 5049:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5050:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5051:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5052:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5053:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5054:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5055:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5056: 
 5057:       // Integral of the shape function products:
 5058:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5059:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5060:       const double p1p1 = dz/3.0;
 5061:       const double p1p2 = dz/6.0;
 5062:       const double d1d1 =  1.0/dz;
 5063:       const double d1d2 = -1.0/dz;
 5064: 
 5065:       // Production/dissipation related terms
 5066:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5067:       const double buoy = dfh_c*N2;
 5068:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5069: 
 5070: 
 5071: 
 5072:       // Equation for tke
 5073:       // ---------------
 5074: 
 5075:       // First row (of the two rows that the interval contributes to)
 5076:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5077:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5078:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5079: 
 5080: 
 5081:       if(prod + buoy >= 0.0) { // Net production
 5082:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5083:       } else { // Net dissipation
 5084:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5085:          bdia_tke[k1] -= 2.0*tmp;
 5086:          cupp_tke[k1] -= tmp;
 5087:       }      
 5088:       
 5089:       bdia_tke[k1] += 2.0*dt*diss;
 5090:       cupp_tke[k1] += dt*diss;
 5091:       
 5092:   
 5093:       // Second row (of the two rows that the interval contributes to)
 5094:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5095:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5096:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5097: 
 5098:       if (prod + buoy >= 0.0) { // Net production
 5099:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5100:       } else { // Net dissipation
 5101:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5102:          bdia_tke[k2] -= 2.0*tmp;
 5103:          alow_tke[k2] -= tmp;
 5104:       }
 5105:       
 5106:       bdia_tke[k2] += 2.0*dt*diss;
 5107:       alow_tke[k2] += dt*diss;
 5108: 
 5109: 
 5110:       // Equation for xl
 5111:       // ---------------
 5112: 
 5113:       const double rpub = turb.rpub();
 5114:       const double rmub = turb.rmub();
 5115:       const double rnub = turb.rnub();
 5116:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5117:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5118:       const double psi_c = 0.5*(psi_1 + psi_2);
 5119: 
 5120:       // Production/dissipation related terms
 5121:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5122:       const double buoy_phi = cpsi3*dfh_c*N2;
 5123:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5124: 
 5125:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5126:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5127:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5128: 
 5129:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5130:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5131:       } else { // Net dissipation
 5132:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5133:          bdia_phi[k1] -= 2.0*tmp;
 5134:          cupp_phi[k1] -= tmp;
 5135:       }
 5136: 
 5137:       // Production/dissipation terms
 5138:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5139:       cupp_phi[k1] += dt*diss_phi;
 5140:  
 5141: 
 5142:       // row k2 (upper)
 5143:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5144:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5145:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5146: 
 5147:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5148:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5149:       } else { // Net dissipation
 5150:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5151:          bdia_phi[k2] -= 2.0*tmp;
 5152:          alow_phi[k2] -= tmp;
 5153:       }
 5154: 
 5155:       // Production/dissipation terms
 5156:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5157:       alow_phi[k2] += dt*diss_phi;
 5158: 
 5159:    }
 5160: 
 5161:    // BC
 5162:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5163:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5164: 
 5165: 
 5166:    // Solves for tke.
 5167:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5168: 
 5169: 
 5170:    // B.C. (computed using values from previous time except wind)
 5171:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5172:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5173: 
 5174: 
 5175:    // Update TKE.
 5176:    turb.tke[kb]     = tkebot;
 5177:    turb.tke[kb + 1] = tkebot;
 5178:    turb.tke[ivrt]   = tkesrf;
 5179:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5180:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5181: // printf("tke[%d]: %f, solution[%d]: %f\n", k, turb.tke[k], kin, solution[kin]);   
 5182:    }
 5183: 
 5184: 
 5185: 
 5186:  
 5187:    // Solves for phi.
 5188:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5189: 
 5190: 
 5191:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5192:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5193:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5194: 
 5195:    turb.mxl[kb+1] = mxlbot;
 5196:    turb.mxl[ivrt] = mxlsrf;
 5197:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5198:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5199: 
 5200:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5201: 
 5202:       // Galperin's clipping
 5203:       if (N2 < 0.0) {
 5204:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5205:          turb.mxl[k] = min(turb.mxl[k], upper);
 5206:       }   
 5207: 
 5208: 
 5209: 
 5210:       // Max. mixing length based on dissipation; mxlmin prevails
 5211:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5212: 
 5213:       // Combined max. mixing length including geometric limit
 5214:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5215: 
 5216:       // Clamp the mixing length between the minimum and maximum values
 5217:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5218: 
 5219:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5220: 
 5221: 
 5222:    } // for k
 5223: 
 5224: 
 5225:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5226:    turb.tke[kb] = turb.tke[kb + 1];
 5227:    turb.mxl[kb] = turb.mxl[kb + 1];
 5228: 
 5229: 
 5230:    // Compute vertical diffusivities at new time
 5231:    turb.computeDiffusivities(node);
 5232: 
 5233:    // make all the variables uniform below the bottom level kb
 5234:    for (int k = 0; k < kb; k++) {
 5235:       node->dfv[k] = node->dfv[kb];
 5236:       node->dfh[k] = node->dfh[kb];
 5237:       turb.tke[k] = turb.tke[kb];
 5238:       turb.mxl[k] = turb.mxl[kb];
 5239:       turb.nu_tke[k] = turb.nu_tke[kb];
 5240:       turb.nu_phi[k] = turb.nu_phi[kb];
 5241:    }
 5242: 
 5243:       
 5244: 
 5245: }
 5246: 
 5247: 
 5248: 
 5249: 
 5250: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5251:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5252:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5253: 
 5254: 
 5255:    NODE(node1);
 5256: 
 5257:    node1->clearMatrixRow();
 5258:    node1->qel = 0.0;
 5259: 
 5260:    // THIS IS FOR STRUCTURES XXX
 5261:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5262: 
 5263:    
 5264:    for (int j=0; j<node1->numElements; j++) {
 5265:       // For each element connected to the node...
 5266: 
 5267:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5268: 
 5269:       Element *elem = node1->elements[j];
 5270: 
 5271:       // Compute the average gravity
 5272:       const double grav3 = elem->mean(&Node::grav2);
 5273: 
 5274:       // Look at the documentation for the description of the terms in the following integrals
 5275: 
 5276:       // Integral I_1 
 5277:       // \bar{\breve{H}} 
 5278:       const double hhatb = elem->mean(&Side::hhat);        
 5279: 
 5280:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5281: 
 5282:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5283:       const double area = elem->area;
 5284: 
 5285:       // Integral I_4
 5286:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5287:       // Where
 5288:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5289: 
 5290:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5291:       // of U over the element.
 5292:       const Vector2 U = elem->mean(&Side::U);
 5293: 
 5294:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5295: 
 5296:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5297:       const double I_4_1 = dot(gradPhi_1, U);
 5298: 
 5299: 
 5300:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5301:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5302: 
 5303:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5304: 
 5305: 
 5306:       // Normal component of the bed velocity
 5307:       double ubedNormalComp = 0.0;
 5308:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5309:          Vector3 ubed = {0.0, 0.0, 0.0};
 5310:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5311:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5312: 
 5313:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5314:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5315:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5316: 
 5317:          // Computes the normal component of the bed velocity
 5318:          ubedNormalComp = dot(ubed, N);
 5319:       } // imm==2
 5320: 
 5321:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5322: 
 5323:       if (elem->isTri()) {
 5324: 
 5325:          // To clarify the notation in this section: 
 5326:          //   In formulas, we use the following notation:
 5327:          //       i stands for the node under consideration (node1)
 5328:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5329:          //   However, in the code, we use the following notation:
 5330:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5331:          const int id2 = elem->nxq(1 + id1);
 5332:          const int id3 = elem->nxq(2 + id1);
 5333:          Node *node2 = elem->nodes[id2];
 5334:          Node *node3 = elem->nodes[id3];
 5335: 
 5336:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5337: 
 5338:          // integral of phi_i*phi_j
 5339:          const double ipp_ii = (1.0/6.0 )*area;
 5340:          const double ipp_ij = (1.0/12.0)*area;
 5341:          const double ipp_ik = (1.0/12.0)*area;
 5342: 
 5343:          // integral of [(grad phi_i) * (grad phi_j)]
 5344:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5345:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5346:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5347: 
 5348:          // Computes the different components of integral I_1 of each node with respect to node i.
 5349:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5350:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5351:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5352: 
 5353:          node1->addToSparseMatrix(node1, I1_ii);
 5354:          node1->addToSparseMatrix(node2, I1_ij); 
 5355:          node1->addToSparseMatrix(node3, I1_ik);
 5356: 
 5357:          #pragma unroll
 5358:          for (int l=0; l<3; l++) {
 5359: 
 5360:             Node *node = elem->nodes[l];
 5361: 
 5362:             // Additional variation in eta due to bed deformation or vertical velocity
 5363:             double extraEta = 0.0;
 5364:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5365:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5366: 
 5367: 
 5368:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5369:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5370: 
 5371:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5372: 
 5373:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5374:            
 5375:          }
 5376: 
 5377: 
 5378:       }
 5379:       else { // Quad
 5380:          // To clarify the notation in this section: 
 5381:          //   In formulas, we use the following notation:
 5382:          //       i stands for the node under consideration (node1)
 5383:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5384:          //   However, in the code, we use the following notation:
 5385:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5386:          const int id2 = elem->nxq(1 + id1);
 5387:          const int id3 = elem->nxq(2 + id1);
 5388:          const int id4 = elem->nxq(3 + id1);
 5389:          Node *node2 = elem->nodes[id2];
 5390:          Node *node3 = elem->nodes[id3];
 5391:          Node *node4 = elem->nodes[id4];   
 5392:          
 5393:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5394: 
 5395:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5396:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5397:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5398:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5399:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5400: 
 5401:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5402:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5403:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5404:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5405:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5406: 
 5407: 
 5408:          // Computes the different components of integral I_1 of each node with respect to node i.
 5409:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5410:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5411:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5412:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5413: 
 5414:          node1->addToSparseMatrix(node1, I1_ii);
 5415:          node1->addToSparseMatrix(node2, I1_ij); 
 5416:          node1->addToSparseMatrix(node3, I1_ik);
 5417:          node1->addToSparseMatrix(node4, I1_il);
 5418:   
 5419:          #pragma unroll
 5420:          for (int l=0; l<4; l++) {
 5421: 
 5422:             const Node *node = elem->nodes[l];
 5423: 
 5424:             // Additional variation in eta due to bed deformation or vertical velocity
 5425:             double extraEta = 0.0;
 5426:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5427:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5428: 
 5429:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5430:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5431:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5432: 
 5433:          }         
 5434:       } 
 5435: 
 5436: 
 5437:      node1->qel += (dt/elem->i34)*elem->vsource;
 5438:       
 5439: 
 5440:    } // for all elements connected to the node
 5441:    
 5442: 
 5443:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5444:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5445:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5446:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5447:    // If it is an open boundary node...
 5448: 
 5449:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5450: 
 5451:       // At least one open bnd side, maybe two
 5452:       for (int l=0; l<2; l++) { 
 5453: 
 5454:          // Gets each of the sides sharing the node. 
 5455:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5456: 
 5457:     
 5458: 
 5459:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5460:          if (sideBnd != nullptr) {
 5461:             // If the side is on a boundary...
 5462: 
 5463:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5464: 
 5465:             // Get the boundary segment
 5466:             const BoundarySegment *sideSegment = sideBnd->segment;
 5467:             const Side *side = sideBnd->side;
 5468: 
 5469:             // Integral I_3
 5470:             if (sideSegment->ifltype != 0) {
 5471:             // Natural or Flather b.c.
 5472: 
 5473:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5474:                // especially for Flather b.c.
 5475:                double ri3 = 0.0;
 5476:                if (!side->isDry) {
 5477:                   // If the side is not dry
 5478:                   
 5479:                   // Computes the side flux of (uth, vth)
 5480:                   double Vn = 0.0;
 5481:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5482:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5483:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5484: 
 5485:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5486:                   }
 5487: 
 5488:                   ri3 = 0.5*side->len*Vn;
 5489:                }
 5490: 
 5491:                if (sideSegment->ifltype == -1) { // Flather 1
 5492: 
 5493:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5494:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5495: 
 5496:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5497:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5498:                   
 5499:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5500:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5501: 
 5502:                } 
 5503:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5504:                   // Reset ri3
 5505:                   ri3 = 0.0;
 5506: 
 5507:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5508:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5509: 
 5510:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5511: 
 5512:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5513:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5514: 
 5515:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5516:                   node1->addToSparseMatrix(node1, con0*2.0);
 5517:                   node1->addToSparseMatrix(node2, con0);
 5518: 
 5519:                } // if Flather or Discharge
 5520: 
 5521:                node1->qel -= thetai*dt*ri3;  
 5522: 
 5523: 
 5524:             } // I_3
 5525:           
 5526: 
 5527:             // Integral I_5
 5528:             if(!side->isDry) {
 5529: 
 5530:                const double Unbar = dot(side->U, side->n);
 5531:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5532: 
 5533:             } // I_5
 5534: 
 5535:          } // if is boundary side
 5536: 
 5537:       } // for l
 5538: 
 5539:    } // if isbnd
 5540: 
 5541: 
 5542: }
 5543: 
 5544: 
 5545: 
 5546: extern "C" {
 5547: 
 5548:    __global__ void gatherBFromMesh(double* b) {
 5549:       // b[local] <- qel  (local = idx_node on this device)
 5550:       NODE(node);
 5551:       b[idx_node] = node->qel;
 5552:    }
 5553: 
 5554:    
 5555:    __global__ void scatterXToMesh(double* x) {
 5556:       // mX <- x[local]
 5557:       NODE(node);
 5558:       node->mX = x[idx_node];
 5559:    }
 5560: 
 5561:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 5562:                                  int* indices, int* indptr) {
 5563:       // XXXXXXXXXXXX REMOVE!!!
 5564:       assert(false && "setupCGSolver has beed deprecated");
 5565: 
 5566:       // NODE(node);
 5567:       
 5568:       // const int idx = node->idx;
 5569:       
 5570:       // // Computes the index in the nzz array      
 5571:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 5572: 
 5573: 
 5574:       // indptr[idx] = nzzIdx;
 5575:       // indices[nzzIdx] = idx;
 5576: 
 5577:       // data_d[nzzIdx]    = node->coeffDiag;
 5578: 
 5579:       // b_d[idx] = node->qel;
 5580: 
 5581:       // for (int k = 0; k < node->numNodes; ++k) {
 5582:       //    const Node* nb = node->nodes[k];
 5583: 
