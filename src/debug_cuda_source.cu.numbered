 6251:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6252: 
 6253:       NODE(node);
 6254: 
 6255:       node->ETP = 0.0;
 6256: 
 6257:       if constexpr(ntip == 0) return;
 6258: 
 6259:       // For all tidal potential components
 6260:       for (int j=0; j<ntip; j++) {
 6261: 
 6262:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6263: 
 6264:          node->ETP += nodeETP;
 6265: 
 6266:          if constexpr(iloadtide==1) { // loading tide
 6267:             assert(false && "Loading tide not implemented");
 6268:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6269:          }
 6270:          
 6271:       }
 6272: 
 6273:      
 6274:    }
