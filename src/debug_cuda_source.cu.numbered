 2532: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2533:    // Returns the value of the velocity at the side center
 2534:    const double w1 = getBoundaryArrayValueWeight();
 2535:    const double w2 = 1.0 - w1;
 2536:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2537:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2538: 
 2539:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2540: }
