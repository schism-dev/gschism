 8304: __global__ void returnMatrix(double *res) {
 8305:    // Debugging: returns the matrix as a CuPy array
 8306: 
 8307:    const int size = mesh->np;
 8308:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8309:       const Node *node = mesh->localNodeData + idx_node;
 8310:       res[idx_node*size + idx_node] = *(node->coeffDiag);
 8311:       for (int j = 0; j < node->numNodes; j++) {
 8312:          Node* nbNode = node->nodes[j];
 8313:          if (node->coeffRow[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffRow[csrSlot[j]];
 8314:       }
 8315: 
 8316:    }
 8317:    
 8318: }
