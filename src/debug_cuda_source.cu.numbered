 6700:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6701: 
 6702:       SIDE(side);
 6703: 
 6704:       side->U = {0.0, 0.0}; 
 6705:          
 6706:       if(side->isDry) return;
 6707: 
 6708:       // Vertically integrated velocity U
 6709:       #pragma unroll 1
 6710:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6711: 
 6712:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6713: 
 6714:          side->U += side->Dz(k + 1)*uc;  
 6715: 
 6716:       }
 6717:    }
 6718: 
 6719:    __global__ void computeBottomDragVegetation(void) {
 6720:       // UNFINISHED. CHECK THIS: XXXXX
 6721:       // How many kernels are needed? Why so many for loops?
 6722:       // Is the loop on sides needed?
 6723: 
 6724:       NODE(node);
 6725: 
 6726:       const int    kb      = node->kb;
 6727:       const double htot    = node->htot2(); 
 6728:       
 6729:       if (node->isDry) {
 6730:          // Default values for dry nodes
 6731:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6732:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6733: 
 6734:          return;
 6735:        
 6736:       }
 6737: 
 6738:       // Computes bottom drag Cd based on the selected nchi
 6739:       node->computeBottomDragCd();
 6740:       
 6741: 
 6742: 
 6743:       //   Bottom stress in m^2/s^2
 6744:       if (node->rho[kb + 1] >= -98.0)
 6745:       {
 6746:          const double mag_u = length(node->u2[kb + 1]);
 6747:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6748: 
 6749:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6750:          // !sediment erosion: this part needs more documentation
 6751:       }
 6752:     
 6753: 
 6754: 
 6755:       // Compute vegetation parameters
 6756:       //--------------------------------
 6757: 
 6758: 
 6759:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6760:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6761: 
 6762:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6763:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6764:          int kbin = 0; // bin index
 6765:          for (int k = kb; k < nvrt; k++) {
 6766:             // Computes node height above the bottom level
 6767:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6768:             assert(false && "Vertical variation of vegetation not implemented");
 6769: 
 6770:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6771:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6772:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6773:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6774:             // } else {
 6775:             //    // Find the bin at which the current vertical level is
 6776:             //    while (kbin<nbins_veg_vert) {
 6777:             //       const double zn = node->z[kbin];
 6778:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6779:             //          break;
 6780:             //       } // if
 6781:             //       kbin++;
 6782:             //    } // while
 6783:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6784: 
 6785:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6786:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6787:                
 6788:             //    // Linear interpolation of the vegetation parameters
 6789:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6790:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6791:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6792:             // } // if rl10
 6793: 
 6794:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6795: 
 6796:          } // for k
 6797: 
 6798: 
 6799:       } else { // Ganthy (iveg==2)
 6800:       //  Modify canopy height, diameter, and density
 6801: 
 6802:          // Make sure there is vegetation on this node
 6803:          if (node->veg_h_unbent > 0.0) {
 6804:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6805: 
 6806:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6807:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6808:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6809: 
 6810:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6811:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6812:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6813:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6814:          } // if veg_h_unbent
 6815: 
 6816:          for (int k = 0; k < nvrt; k++) {
 6817:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6818:          } // for k
 6819:       
 6820: 
 6821:       } // if iveg
 6822:      
 6823: 
 6824:       // Compute vertical mean of veg_alpha3D
 6825:       if (iveg != 0) {
 6826:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6827:          double sum1=0.0;
 6828:          double sum2=0.0;
 6829:          // Integrate over each level under the canopy...
 6830:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6831:             const double Dz = node->Dz(k);
 6832: 
 6833:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6834:             sum2 += Dz;
 6835: 
 6836:          } // for k
 6837:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6838:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6839: 
 6840:       } // if iveg
 6841: 
 6842:    }
 6843: 
 6844: 
 6845:    __global__ void computeTurbulence(void) {
 6846: 
 6847:       NODE(node);
 6848: 
 6849:       // Calls the templated function to compute the turbulence model parameters.
 6850:       // turbulenceModel is just a class enum version of itur.
 6851:       computeTurbulenceModel<turbulenceModel>(node);
 6852:       
 6853:    }
 6854: 
 6855: 
 6856:    __global__ void computeVegetationAndDragParameters(void) {
 6857:       // Computes the vegetation and drag model parameters:
 6858:       // chi, \tilde\chi, beta, \breve{H}
 6859:       
 6860:       SIDE(side);
 6861: 
 6862:       side->hhat = 0.0;
 6863:       side->chi2 = 0.0;
 6864:       side->chi = 0.0;
 6865:       side->veg_c2 = 0.0;
 6866:       side->veg_beta = 0.0;
 6867: 
 6868:       if (side->isDry) return;
 6869: 
 6870:       const double htot = side->htot2();
 6871:       const int    kb   = side->kb;
 6872: 
 6873:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6874: 
 6875:       const double veg_h     = side->veg_h();
 6876:       const double veg_nv    = side->veg_nv();
 6877:       const double veg_c     = side->veg_c();
 6878:       const double veg_beta  = side->veg_beta;
 6879:       const double veg_alpha = side->veg_alpha_vert_mean();
 6880: 
 6881:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6882:       // Velocity magnitude at the bottom level
 6883:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6884:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6885:       side->chi2 = side->Cd()*vmag1;
 6886:       side->chi  = side->chi2;
 6887: 
 6888:       if constexpr(iveg != 0) {
 6889:          const Node *n1 = side->n1;
 6890:          const Node *n2 = side->n2;
 6891:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6892:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6893:       }
 6894: 
 6895:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6896: 
 6897:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6898:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6899:       double magUa = 0.0;
 6900:       if constexpr(iveg != 0) {
 6901:          if (side->is3D() && veg_h > 0.0) {
 6902:             // 3D wet side with veg...
 6903: 
 6904:             double magUa = 0.0;
 6905:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6906:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6907: 
 6908:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6909:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6910:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6911: 
 6912:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6913:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6914: 
 6915:                   // Velocity magnitude at the bottom (l) of the level
 6916:                   const double ul = length(side->u2[k]);
 6917: 
 6918:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6919:                   magUa += Dz*0.5*(uh + ul);
 6920: 
 6921:                } // if HasVegetation
 6922:             } // for k
 6923:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6924: 
 6925:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6926:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6927:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6928:                const double zCpy = side->zTopCanopy();
 6929:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6930:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6931:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6932:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6933:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6934:             } // if isSubmerged
 6935:          } // if is3D
 6936:       } // if iveg   
 6937: 
 6938:       // Computes the friction modified depth, \breve{H} in notes
 6939:       if (side->is2D()) { // 2D
 6940: 
 6941:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6942:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6943: 
 6944:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6945: 
 6946:          side->hhat = htot*htot/fricH; 
 6947: 
 6948:       } else { // 3D
 6949:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6950: 
 6951:          if constexpr(iveg != 0) {
 6952:             
 6953:             if (side->isSubmerged()) { 
 6954:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6955:                side->hhat -= veg_c*Hhat_alpha;
 6956: 
 6957:             } else { // Emergent
 6958:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6959:             }
 6960:          } // if iveg
 6961: 
 6962:          // Enforce positivity for 3D model
 6963:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6964:       } // if 3D
 6965: 
 6966:    }
 6967: 
 6968: 
 6969: 
 6970:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6971:    // Computes the density gradient between two elements, e1 and e2.
 6972:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6973:    // zero in the direction normal to the side. 
 6974:    // 
 6975:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6976:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6977:    //
 6978:    // Input:
 6979:    //    e1: Element
 6980:    //    e2: Neighbor element (or nullptr if boundary)
 6981:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6982:    //    k: Index of the half-level at which the density is interpolated
 6983:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6984:    // 
 6985:    // Output:
 6986:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6987:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6988: 
 6989:       if (e2 == nullptr || e2->isDry) {
 6990:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6991: 
 6992:          Side *side = e1->sides[j];
 6993:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6994:                  
 6995:          if constexpr(ics == 1) {
 6996:             vec = side->n; // Normal vector to the side
 6997:          } else {
 6998:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6999:             // IMPLEMENT THIS XXXXXX
 7000:             // !replace with xel, yel?
 7001:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 7002:             //      &eframe(:,:,i),xn1,yn1,tmp)
 7003:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 7004:             //      &eframe(:,:,i),xn2,yn2,tmp)
 7005:          } //ics
 7006:                    
 7007:          diffRho = 0.0;
 7008: 
 7009:       } else { //internal and wet
 7010:          if constexpr(ics==1) {
 7011:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 7012: 
 7013:             // Vector from e1 to e2
 7014:             vec = e2->center - e1->center;
 7015: 
 7016:          } else { 
 7017:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 7018:             // Remember that elem->center is in global coordinates
 7019:             // IMPLEMENT THIS XXXXXX
 7020:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 7021:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 7022:             //                   alow(j)=xctr2
 7023:             //                   bdia(j)=yctr2
 7024:          } // ics
 7025: 
 7026:          diffRho = rho2 - e1->demeanedDensity(k);
 7027:       }
 7028: 
 7029:    }
 7030: 
 7031:    __global__ void computeDensityCubicSplines(void) {
 7032:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 7033: 
 7034:       ELEM(elem);
 7035: 
 7036:       if (elem->isDry) return;
 7037: 
 7038:       const int kb = elem->kb;
 7039: 
 7040:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 7041:       if (elem->is2D()) {
 7042:          // In the 2D case, the density is constant at the prism level. 
 7043:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 7044:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 7045:       } else { //3D
 7046: 
 7047:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 7048:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 7049:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 7050:          ///// XXXX CHECK INDICES!!!!!
 7051:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 7052:       } // 2D/3D
 7053: 
 7054:    }
 7055: } // extern "C"
 7056: 
 7057: 
 7058: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 7059: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 7060: 
 7061:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 7062: 
 7063:    const int kb  = elem->kb;
 7064:    const int kb2 = elem2->kb;
 7065: 
 7066:    // z-coordinate of prism of elem
 7067:    const double zp = elem->z_prism(k);
 7068: 
 7069:    double rho = 0.0;
 7070: 
 7071:    if (elem2->is2D()) {
 7072:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 7073: 
 7074:    } else {  // 3D
 7075: 
 7076:       // eta_min may be < zmax
 7077:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 7078:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 7079: 
 7080:       // (Extrapolate density below bottom, we will fix it later)
 7081:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 7082:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 7083:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 7084:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 7085:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 7086:    } // 2D/3D
 7087:      
 7088: 
 7089:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 7090:    // Now we need to fix it.
 7091:    if (elem->z[k] < elem2->z[kb2]) {
 7092:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 7093: 
 7094:       // There are two methods to adjust the density at the bottom of the element.
 7095:       // iunder_deep=0: 
 7096:       const double depth1 = abs(elem->z[kb]); // larger depth
 7097: 
 7098:       if (iunder_deep==0) {
 7099: 
 7100:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 7101: 
 7102:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 7103: 
 7104:       } else { // iunder_deep != 0
 7105: 
 7106:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 7107: 
 7108:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 7109: 
 7110:          //   Demeaned density at the same z coordinate as
 7111:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 7112:          }
 7113: 
 7114:       } // if iunder_deep
 7115:    } // if elem->z[kb] < elem2->z[kb]
 7116: 
 7117:    return rho;
 7118: }
 7119: 
 7120: 
 7121: extern "C" {
 7122:    __global__ void computeDensityGradient(void) {
 7123: 
 7124:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 7125:       if constexpr(ibc != 0) return;
 7126: 
 7127:          // Compute the horizontal density gradient at each element.
 7128:       // It works in two steps:
 7129:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7130:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7131:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7132:       //             gradRho.r1 = rho1 - rho0
 7133:       //             gradRho.r2 = rho2 - rho0
 7134:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7135:       // 
 7136:       //  NOTE: We use de-meaned densities.
 7137: 
 7138:       ELEM(elem);
 7139: 
 7140:       if (elem->isDry) return;
 7141: 
 7142:       const int kb  = elem->kb;
 7143:       const int i34 = elem->i34;
 7144: 
 7145:       for (int k = kb + 1; k < nvrt; k++) {
 7146:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 7147:          //             gradRho.r1 = rho1 - rho0
 7148:          //             gradRho.r2 = rho2 - rho0
 7149:          int icount = 0;
 7150:          double sumRx = 0.0;
 7151:          double sumRy = 0.0;
 7152:          for (int j1=0; j1<i34; j1++) { 
 7153: 
 7154:             const int j2 = elem->nxq(j1 + 1);
 7155: 
 7156:             // Pairs of consecutive neighbor elements of elem
 7157:             const Element *e1 = elem->nghbElems[j1];
 7158:             const Element *e2 = elem->nghbElems[j2];
 7159: 
 7160:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 7161:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 7162:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 7163: 
 7164:             // Compute the density difference and the vector from elem to e1 and e2
 7165:             // getRhoDiffAndVec takes into account boundaries/dry elements
 7166:             double diffRho1, diffRho2;
 7167:             Vector2 vec1, vec2;
 7168:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 7169:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 7170: 
 7171:             const double rl1 = length(vec1);
 7172:             const double rl2 = length(vec2);
 7173:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 7174: 
 7175:             const double delta = cross(vec1, vec2);
 7176:             const double sintheta = abs(delta)/(rl1*rl2);
 7177: 
 7178:             // To avoid problems, avoid elements with small angle between vectors
 7179:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 7180:             const bool validEq = (sintheta > sin_one_deg);
 7181: 
 7182:             if (validEq) {
 7183:                // Solve the system of equations to get the density gradient at elem
 7184:                icount++;
 7185:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7186:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7187:                sumRx += Rx;
 7188:                sumRy += Ry;
 7189:             }
 7190:          } // for j1
 7191: 
 7192:          // Compute the average density gradient at elem
 7193:          if (icount==0) {
 7194:            // Bad mesh quality; bail out with 0 b-cc
 7195:            elem->gradRho[k] = {0.0, 0.0};
 7196:          } else {
 7197:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7198:          }
 7199: 
 7200:       } // for k
 7201: 
 7202:    }
 7203: 
 7204:    __global__ void computeBaroclinicTerm(void) {
 7205:    // Computes the baroclinic term at sides (at half levels).
 7206:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7207:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7208: 
 7209:       if (ibc == 1) return;
 7210: 
 7211:       SIDE(side);
 7212: 
 7213:       if (side->isDry) return;
 7214: 
 7215:       const Element *e1 = side->elems[0];
 7216:       const Element *e2 = side->elems[1]; 
 7217:       const int kb = side->kb;
 7218:       
 7219:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7220: 
 7221:       // interpolates vertically the density gradient of the two elements at the half level/
 7222: 
 7223:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7224:       int k2 = max(kb, nvrt / 2);
 7225: 
 7226:       // Starts the integration at the surface and goes down to the bottom
 7227:       side->bcc[nvrt-1] = {0.0, 0.0};
 7228:       for (int k = nvrt - 2; k >= kb; k--) {
 7229:       // For each prism level (from surface to bottom)...
 7230: 
 7231:          // For both elements, interpolate density gradient at the side's half level.
 7232:          // The gradient at the side is the average of the gradients at the elements.
 7233:          // w1, w2 are used to take into account boundary sides, with just one element.
 7234:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7235:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7236:          const double wsum = w1 + w2;
 7237:          w1 = w1/wsum;
 7238:          w2 = w2/wsum;
 7239:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7240: 
 7241:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7242:          Vector2 gradRho = {0.0, 0.0};
 7243:          if (e1 != nullptr && k > kb) {
 7244:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7245:             
 7246:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7247:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7248:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7249: 
 7250:             // Grad(rho) vertically interpolated at the side's half level
 7251:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7252: 
 7253:             // Projects the element density gradient to the side frame if needed.
 7254:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7255: 
 7256:             // Adds the contribution of the density gradient at the side's half level
 7257:             gradRho += gradRho1*w1;
 7258:          }      
 7259:          if (e2 != nullptr && k > kb) {
 7260:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7261:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7262:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7263:             
 7264:             // Grad(rho) vertically interpolated at the side's half level
 7265:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7266: 
 7267:             // Projects the element density gradient to the side frame if needed.
 7268:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7269: 
 7270:             // Adds the contribution of the density gradient at the side's half level
 7271:             gradRho += gradRho2*w2;
 7272:          }
 7273: 
 7274:          
 7275:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7276:          // multiplied by -rampbc*(g/rho0) 
 7277:          const double grav3 = side->grav3();
 7278:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7279: 
 7280:       } // for
 7281: 
 7282:    }
 7283: 
 7284: 
 7285: 
 7286:    __global__ void computeHorGradientAtSide(void) {
 7287: 
 7288:       // Compute the horizontal density gradient at each element.
 7289:       // It works in two steps:
 7290:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7291:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7292:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7293:       //             gradRho.r1 = rho1 - rho0
 7294:       //             gradRho.r2 = rho2 - rho0
 7295:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7296:       // 
 7297:       //  NOTE: We use de-meaned densities.
 7298: 
 7299:       SIDE(side);
 7300: 
 7301: 
 7302:       if (side->isDry) return;
 7303: 
 7304:       // Computes the gradient of the variables at the side center.
 7305:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7306:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7307:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7308: 
 7309:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7310:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7311:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7312:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7313: 
 7314:    }
 7315: 
 7316: 
 7317:    __global__ void solveMomentumEquations(double time) {
 7318: 
 7319:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7320:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7321: 
 7322:       SIDE(side);
 7323: 
 7324:       if (side->isDry) 
 7325:       {
 7326:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7327: 
 7328:          return;
 7329:       }
 7330: 
 7331:       const Node *n1 = side->n1;
 7332:       const Node *n2 = side->n2;
 7333: 
 7334:       const int kb = side->kb;
 7335: 
 7336:       const double veg_h = side->veg_h();
 7337:       const double grav3 = side->grav3();
 7338: 
 7339:       if (side->is2D()) {
 7340:          // Remember: Do not use htot2, which is updated.
 7341:          const double htot = side->htot1();
 7342:          const double hhat = side->hhat;
 7343: 
 7344:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7345: 
 7346:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7347:          const Vector2 tau2 = side->tau();
 7348: 
 7349:          // hat_gam has units of m/s
 7350: 
 7351:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7352:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7353:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7354: 
 7355:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7356: 
 7357: 
 7358:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7359: 
 7360:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7361: 
 7362:       }
 7363:       else { // 3D
 7364: 
 7365:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7366:          // 
 7367:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7368:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7369:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7370:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7371:          // k+1 and k.
 7372: 
 7373:          const double zTopCanopy = side->zTopCanopy();
 7374: 
 7375:          // Initialize the tridiagonal system
 7376:          for (int k = kb + 1; k < nvrt; k++) {
 7377:             
 7378:             const int kin = k - (kb + 1);
 7379: 
 7380:  
 7381:             alow[kin] = 0.0;
 7382:             cupp[kin] = 0.0;
 7383:             bdia[kin] = 0.0;
 7384: 
 7385:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7386:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7387: 
 7388:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7389:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7390:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7391: 
 7392:             // First part: layers k, k+1
 7393:             if (k < nvrt - 1) {
 7394:                              
 7395:                if constexpr(iveg != 0) {
 7396: 
 7397:                   // If there is vegetation at this level...
 7398:                   if (zTopCanopy > side->zc[k]) {
 7399:                      // If the canopy is above the k layer...
 7400:                      
 7401:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7402:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7403:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7404:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7405: 
 7406:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7407:                      const double vmag2 = length(ut2);
 7408:                      const double vmag1 = length(side->u2[k]);
 7409:                      const double vmag = 0.5*(vmag1 + vmag2);
 7410:                      
 7411:                      // Computes the vegetation alpha at the face center
 7412:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7413: 
 7414:                      cff1 += veg_alpha_sd*dt*vmag;
 7415: 
 7416:                   } // if (zTopCanopy
 7417:                } // if iveg
 7418: 
 7419:                const double dzz = side->Dz(k + 1);
 7420:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k + 1)); // Vertical viscosity at the face center
 7421:                const double tmp = dt*dfz/dzz;
 7422:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7423: 
 7424:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7425:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7426:             }
 7427: 
 7428: 
 7429:             // Second part: layers k-1, k
 7430:             if (k > kb + 1) {
 7431: 
 7432:                double cff1 = 1.0; //init \bar{c^k}
 7433: 
 7434:                if constexpr(iveg != 0) {
 7435:                   // If there is vegetation at this level...
 7436:                   if (zTopCanopy > side->zc[k-1]) {
 7437:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7438:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7439: 
 7440:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7441: 
 7442:                      const double vmag2 = length(ut2);
 7443:                      const double vmag1 = length(side->u2[k-1]);
 7444:                      const double vmag = 0.5*(vmag1 + vmag2);
 7445: 
 7446:                      // Computes the vegetation alpha at the face center
 7447:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7448:                      cff1 += veg_alpha_sd*dt*vmag;
 7449:                   } // if zTopCanopy
 7450: 
 7451:                } // if iveg
 7452: 
 7453:                const double dzz = side->Dz(k);
 7454:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k - 1)); // Vertical viscosity at the face center
 7455:                const double tmp = dt*dfz/dzz;
 7456:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7457: 
 7458:                alow[kin] += cff1*dzz/6.0 - tmp;
 7459:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7460: 
 7461:             } else { // Bottom boundary
 7462:                // This occurs at the bottom, where the bottom drag is applied.
 7463: 
 7464:                bdia[kin] += dt*side->chi2; // XXXX
 7465: 
 7466:             } // if (k > kb + 1)
 7467: 
 7468: 
 7469:          } // for (int k
 7470: 
 7471: 
 7472: 
 7473:          // Computes the RHS.
 7474:          // -----------------
 7475: 
 7476:          //	BC to be imposed at the end.
 7477: 
 7478:          const Vector2 gradETP  = side->gradETP;
 7479:          const Vector2 gradPr   = side->gradPr;
 7480:          const Vector2 gradEta1 = side->gradEta1;
 7481:          const Vector2 gradEta2 = side->gradEta2;
 7482: 
 7483:          const Vector2 *btu = side->btu;
 7484:          const Vector2 *u2  = side->u2;
 7485:          const double coriolis = side->coriolis;
 7486:          const Vector2 *nuGradU = side->nuGradU;
 7487: 
 7488:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7489:          for (int k = kb + 1; k < nvrt; k++) {
 7490:             const int kin = k - kb - 1;
 7491: 
 7492:             const double dz_0 = side->Dz(k);
 7493:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7494: 
 7495:             rrhs[kin] = {0.0, 0.0};
 7496:             double dz = 0.0;
 7497: 
 7498:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7499:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7500:             if (k < nvrt  ) dz += dz_1;
 7501:             if (k > kb + 1) dz += dz_0;
 7502: 
 7503:             // Elevation gradient, atmospheric pressure and tidal potential
 7504:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7505: 
 7506:             // Coriolis, advection, wind stress, and horizontal viscosity
 7507:             if (k < nvrt - 1) {
 7508: 
 7509: 
 7510:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7511:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7512:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7513:                                                 
 7514: 
 7515:                //diff stress tensors 1006
 7516:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7517:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7518:                   assert(false && "Not implemented: itur == 5");
 7519:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7520:                }
 7521:                // else assert(false && "itur # Not implemented");
 7522: 
 7523:             } else { // k == nvrt - 1 SURFACE
 7524:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7525:                const Vector2 tau2 = side->tau();
 7526: 
 7527:                rrhs[kin] += dt*tau2;          
 7528: 
 7529:             } // if k<nvrt
 7530: 
 7531: 
 7532:             if (k > kb + 1) {
 7533:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7534:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7535:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7536: 
 7537:                // diff stress tensors 1006
 7538:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7539:                   assert(false && "Not implemented: itur == 5");
 7540:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7541:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7542:                }
 7543:                // else assert(false && "itur # Not implemented");
 7544: 
 7545: 
 7546:             } // if k>kbs + 1
 7547: 
 7548:             // Baroclinic
 7549:             Vector2 *bcc = side->bcc;
 7550:             if constexpr(ibc == 0) {
 7551:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7552:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7553: 
 7554:             } // if ibc==0
 7555: 
 7556:          } // k=kb + 1,nvrt
 7557: 
 7558: 
 7559:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7560: 
 7561:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7562:             const int kin = k - kb - 1;
 7563:    
 7564:             // Velocity is always clamped to maximum values
 7565:             side->u2[k] = clampVelocity(soln[kin]);
 7566:          } // k
 7567: 
 7568:       } // if side->is2D()
 7569:       
 7570: 
 7571:       // Impose velocity boundary condition at the bottom
 7572:       if constexpr(imm == 2) { // 3D bed deformation model
 7573:          double dep;
 7574:          Vector2 vel;
 7575: 
 7576:          assert(false && "Not implemented: imm == 2");
 7577:          //update_bdef(time, x0, y0, dep, vel);
 7578:          // side->u2[kb] = vel;
 7579: 
 7580:       } else { // imm = 0 or 1
 7581:          if (side->Cd() == 0.0) {
 7582:             side->u2[kb] = side->u2[kb + 1];
 7583: 
 7584:          } else if (side->is3D()) { // 3D no slip bottom   
 7585:             side->u2[kb] = {0.0, 0.0};
 7586: 
 7587:          }
 7588:           
 7589:       } // if imm
 7590: 
 7591:       // The velocities below the bottom level are set to zero
 7592:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7593: 
 7594: 
 7595:    }
 7596: 
 7597: 
 7598:    __global__ void applyMomentumBC(void) {
 7599: 
 7600:       SIDE_BND(sideBnd);
 7601: 
 7602:       Side *side = sideBnd->side;
 7603:       const BoundarySegment *segment = sideBnd->segment;
 7604:       const Node *n1 = side->n1;
 7605:       const Node *n2 = side->n2;
 7606: 
 7607:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7608: 
 7609:       const bool isLand = segment->isLand;
 7610:       const int ifltype = segment->ifltype;
 7611: 
 7612:       const int kb = side->kb;
 7613: 
 7614: 
 7615:       if (!isLand && ifltype != 0) {
 7616:          const Vector2 *ubc = sideBnd->ubc;
 7617:   
 7618:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7619:             
 7620:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7621:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7622: 
 7623:             if (ifltype == -1) {
 7624:                // Flather 1
 7625: 
 7626:                const double depth = side->depth();
 7627: 
 7628:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7629: 
 7630:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7631: 
 7632:                side->u2[k] = vnorm*side->n;
 7633: 
 7634:             } else if (ifltype == -2) { // Discharge
 7635: 
 7636:                const double eta1 = side->eta1();
 7637:                const double eta2 = side->eta2();
 7638:                const double htot = side->htot2();
 7639: 
 7640:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7641:                assert(false && "Not implemented: Discharge bc");
 7642:                // const double dischrg = discharge(eta1);
 7643:                const double dischrg = 0.0; // XXX REMOVE
 7644:                
 7645: 
 7646:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7647: 
 7648:                const double vnorm = dischrg*eta2/htot;
 7649: 
 7650:                side->u2[k] = vnorm*side->n;
 7651: 
 7652:             }
 7653:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7654:                const double vnorm = dot(side->u2[k], side->n);
 7655: 
 7656:                double rat;
 7657:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7658:                else              rat = segment->vobc2; // outgoing
 7659: 
 7660:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7661: 
 7662:             }
 7663:             else { // not Flather or 3D radiation
 7664: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7665:                side->u2[k] = ubc[k];
 7666: 
 7667:             } // if (segment->ifltype...
 7668: 
 7669:          }
 7670: 
 7671:       }
 7672:       else if (isLand) { // if it is land boundary side
 7673: 
 7674:          if constexpr(islip == 0) { // free slip
 7675: 
 7676:             for (int k = kb; k < nvrt; k++) {
 7677: 
 7678:                const Vector2 t = side->t();
 7679:                const Vector2 n = side->n;
 7680: 
 7681:                double vnorm = 0.0; // for most cases
 7682:                const double vtan = dot(side->u2[k], t);
 7683:                
 7684:                side->u2[k] = vtan*t - vnorm*n;
 7685: 
 7686:             }
 7687: 
 7688:          } else { // no slip
 7689:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7690: 
 7691:          }
 7692:       } // if (side segment type...
 7693: 
 7694:    }
 7695: 
 7696: 
 7697:    __global__ void shapiroFilter1(void) {
 7698:       // First step of the Shapiro filter (normally used if indvel<=0)
 7699:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7700: 
 7701:       SIDE(side);
 7702: 
 7703:       // Only internal wet sides are processed
 7704:       if (side->isDry || !(side->isInternal())) return;
 7705: 
 7706:       const int kb = side->kb;
 7707: 
 7708:       for (int mm = 0; mm < niter_shap; mm++) {
 7709: 
 7710:          for (int k = kb + 1; k < nvrt; k++) {
 7711:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7712:             Vector2 suru = {0.0, 0.0};
 7713: 
 7714:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7715: 
 7716:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7717: 
 7718:                int kin = k;
 7719:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7720:                
 7721:                // Get the velocity at the neighbor's side.
 7722:                Vector2 nSideU2 = nSide->u2[kin];
 7723: 
 7724:                // Projects the velocity to the current side frame if needed.
 7725:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7726: 
 7727:                suru += nSideU2;
 7728:             }
 7729: 
 7730:             // Reusing bcc as a temporary array to store the suru values.
 7731:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7732: 
 7733:          }
 7734:       }
 7735:    }
 7736: 
 7737:    __global__ void shapiroFilter2(void) {
 7738:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7739: 
 7740:       SIDE(side);
 7741: 
 7742: 
 7743:       if (side->isDry || !(side->isInternal())) return;
 7744: 
 7745:       const int kb = side->kb;
 7746: 
 7747:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7748: 
 7749:       if (side->is2D()) {
 7750:          side->u2[kb + 1] = side->bcc[kb + 1];
 7751:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7752: 
 7753:       } else {
 7754:          // 3D
 7755:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7756:          
 7757:       }
 7758: 
 7759:    }
 7760: 
 7761: 
 7762:    __global__ void ul0UpdateZCoords(void) {
 7763:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7764:       
 7765:       NODE(node);      
 7766: 
 7767: 
 7768:       if (false) { //node->isDry) { XXXXXXX
 7769: 
 7770:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7771: 
 7772:          if constexpr(ivcor != 1) node->kb = 0;
 7773: 
 7774:       } else {
 7775: 
 7776:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7777:          node->updateKb();
 7778: 
 7779:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7780: 
 7781:       }
 7782: 
 7783:       // We use the temp.b field to store the previous state of isDry.
 7784:       node->tmp.b = node->isDry;
 7785: 
 7786:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7787:       node->isDry = true;
 7788: 
 7789:    }
 7790: 
 7791:    __global__ void ul0ComputeDryElements(void)
 7792:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7793:    {
 7794:       ELEM(elem);
 7795: 
 7796:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7797: 
 7798:       elem->kb = 0;
 7799: 
 7800:       if (elem->isDry) return;
 7801: 
 7802: 
 7803:    //    if(elem->isDry2()) { // XXXX
 7804:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7805:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7806:    //        call parallel_abort(errmsg)
 7807:    //    }
 7808: 
 7809:       const Node *n1 = elem->nodes[0];
 7810:       const Node *n2 = elem->nodes[1];
 7811:       const Node *n3 = elem->nodes[2];  
 7812:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7813: 
 7814:       // Computes element's kb as the minimum of the nodes' kb.
 7815:       const int kb1 = n1->kb;
 7816:       const int kb2 = n2->kb;
 7817:       const int kb3 = n3->kb;
 7818:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7819: 
 7820: 
 7821:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7822: 
 7823: 
 7824:       // Computes the element z as the mean of the nodes z.
 7825:       for (int k = elem->kb; k < nvrt; k++) {
 7826: 
 7827:          // Compute the element z as the mean of the nodes z.
 7828:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7829:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7830:          elem->z[k] /= elem->i34;
 7831: 
 7832:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7833:       }
 7834:                   
 7835:    }
 7836: 
 7837:    __global__ void ul0ComputeDryNodes(void)
 7838:    // Updates node's isDry based on the elements' isDry. 
 7839:    {
 7840:       NODE(node);
 7841: 
 7842:       node->isDry = true;
 7843: 
 7844:       // A node is wet if at least one of the elements sharing it is wet.
 7845:       for (int j = 0; j < node->numElements; j++) {
 7846:          const Element *elem = node->elements[j];
 7847:          if (!elem->isDry) {
 7848:             node->isDry = false;
 7849:             break;
 7850:          }
 7851:       }
 7852: 
 7853:        
 7854:    }
 7855: 
 7856: 
 7857:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7858:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7859:    // node->tmp.b is true if the node was previously dry.
 7860:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7861:    {
 7862:       NODE(node);
 7863:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7864: 
 7865:       // Avoid this the first time step.
 7866:       if (it == iths) return;  
 7867: 
 7868:       const bool wasDry = node->tmp.b;
 7869: 
 7870: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7871: 
 7872:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7873: 
 7874:          for (int k=0; k < nvrt; k++) {
 7875: 
 7876:             Vector3 utmp={0.0, 0.0, 0.0};
 7877: 
 7878:             double ttmp=0.0;
 7879:             double stmp=0.0;
 7880:             int icount=0;
 7881:             for (int j = 0; j < node->numNodes; j++) {
 7882: 
 7883:                const Node *nbrNode = node->nodes[j];
 7884:                
 7885:                const bool wasNbrDry = nbrNode->tmp.b;
 7886: 
 7887:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7888:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7889: 
 7890:                   icount++;
 7891: 
 7892:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7893:                   utmp += nbrNode->uvw2(k);
 7894:                   
 7895:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7896:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7897:                }
 7898:             }
 7899: 
 7900:             if (icount > 0) {
 7901:                const double inv_icount = 1.0/icount;
 7902:                utmp = inv_icount*utmp;
 7903:                node->u2[k]     = {utmp.x, utmp.y};
 7904:                node->w2[k]     = utmp.z;
 7905:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7906:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7907:             } else {
 7908:                node->u2[k] = {0.0, 0.0};
 7909:                node->w2[k] = 0.0;
 7910:                // Initialize tracers to 0.0??? XXXXX
 7911:             }
 7912:          }
 7913:       }
 7914:    }
 7915: 
 7916:   
 7917:    
 7918: 
 7919: 
 7920:    __global__ void ul0UpdateSides(int it, int iths) {
 7921:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7922:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7923:    // The dryness of the sides is updated in ul0UpdateSides2.
 7924: 
 7925:       SIDE(side);
 7926: 
 7927:       // A side is wet if and only if at least one of its elements is wet.
 7928:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7929:  
 7930:       const Node *n1 = side->n1;
 7931:       const Node *n2 = side->n2;
 7932:      
 7933:       const int kb1 = n1->kb;
 7934:       const int kb2 = n2->kb;
 7935: 
 7936:       side->kb = 0; // default when dry
 7937: 
 7938:       if (isWet) {
 7939: 
 7940:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7941: 
 7942:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7943: 
 7944:          side->kb = min(kb1, kb2);
 7945: 
 7946:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7947: 
 7948:          for (int k = side->kb; k < nvrt; k++) {
 7949:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7950: 
 7951:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7952: 
 7953:             // Compute velocity for re-wetted sides 
 7954:             if ((it != iths) && (side->isDry && isWet)) {
 7955: 
 7956:                Vector2 utmp={0.0, 0.0};
 7957: 
 7958:                int icount=0;
 7959: 
 7960:                // For all the sides on the two elements that share this side
 7961:                for (int j = 0; j < 2; j++) {
 7962:                   const Element *elem = side->elems[j];
 7963:                   if (elem == nullptr) continue;
 7964: 
 7965:                   for (int jj=0; jj < elem->i34; jj++) {
 7966:                      const Side *nSide = elem->sides[jj];
 7967:                      if (nSide->isDry) continue;
 7968: 
 7969:                      icount++;
 7970:                      utmp += nSide->u2[k];  
 7971:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7972:                   }
 7973:                }
 7974:                   
 7975:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7976:                if (icount > 0)  side->u2[k] = utmp/icount;
 7977:                else             side->u2[k] = {0.0, 0.0};
 7978:                   
 7979:             } // if ((it != iths) && (side->isDry && isWet))
 7980: 
 7981:          } // for k
 7982: 
 7983:       } // if isWet 
 7984:       
 7985: 
 7986: 
 7987:    }
 7988: 
 7989:    __global__ void ul0UpdateSides2(void) {
 7990:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7991:    
 7992:          SIDE(side);
 7993:    
 7994:          const Element *e1 = side->elems[0];
 7995:          const Element *e2 = side->elems[1];
 7996: 
 7997:          // A side is wet if and only if at least one of its elements is wet.
 7998:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7999: 
 8000:          // Update the side's dryness
 8001:          side->isDry = !isWet;
 8002: 
 8003:    }
 8004: 
 8005: 
 8006:    __global__ void zeroNodalVelocities(void) {
 8007:       NODE(node);
 8008: 
 8009:       for (int k = 0; k < nvrt; k++) {
 8010:          node->u2[k]   = {0.0, 0.0};
 8011:          node->w2[k]   = 0.0;
 8012:          node->utmp[k] = {0.0, 0.0};         
 8013:       }
 8014:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 8015:    }
 8016:  
 8017: 
 8018:    __global__ void computeNodalVerticalVelocities1(void) {
 8019:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 8020:    // Adds the element's vertical velocity times the element's area.
 8021:       ELEM(elem);
 8022: 
 8023:       for (int j = 0; j < elem->i34; j++) {
 8024:          Node *node = elem->nodes[j];
 8025: 
 8026:          for (int k = node->kb; k < nvrt; k++) {
 8027:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 8028:          }
 8029:          atomicAdd(&(node->tmp.d), elem->area);
 8030:       }
 8031:    }
 8032: 
 8033:    __global__ void computeNodalVerticalVelocities2(void) {
 8034:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 8035:    // Divides by the total area of the elements sharing the    node.
 8036:       NODE(node);
 8037: 
 8038: 
 8039:       const double invArea = 1.0 / node->tmp.d;
 8040:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 8041: 
 8042:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 8043:    }
 8044: 
 8045: 
 8046:    __global__ void computeNodalHorizontalVelocities1(void) {
 8047: 
 8048:       assert(indvel <= 0 && "computeNodalHorizontalVelocities1 only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 8049: 
 8050:       ELEM(elem);
 8051: 
 8052:       if (elem->isDry) return;
 8053: 
 8054:       const int kb = elem->kb;
 8055:       const bool isTri = elem->isTri();
 8056: 
 8057:       if constexpr(indvel <= 0) {
 8058:          // Assuming discontinous hvel.
 8059: 
 8060:          if (isTri) { // For triangles
 8061:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 8062:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 8063:             #pragma unroll
 8064:             for (int j = 0; j < 3; j++) {
 8065:                // For every node of the triangle...
 8066:                Node *node = elem->nodes[j];
 8067: 
 8068:                if (node->isDry) continue;
 8069: 
 8070:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 8071:                const Side *s2 = elem->sides[(j + 1) % 3];
 8072:                const Side *s3 = elem->sides[(j + 2) % 3];
 8073: 
 8074:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 8075: 
 8076:                atomicAdd(&(node->tmp.i), 1);
 8077: 
 8078:                for (int k = kb; k < nvrt; k++)  {
 8079:                   Vector2 s1u2 = s1->u2[k];
 8080:                   Vector2 s2u2 = s2->u2[k];
 8081:                   Vector2 s3u2 = s3->u2[k];
 8082: 
 8083:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 8084:                   if constexpr(ics == 2) {
 8085:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 8086:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 8087:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 8088:                   }
 8089: 
 8090:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 8091:                   u = clampVelocity(u);
 8092:                   atomicAdd(&(node->utmp[k].x), u.x);
 8093:                   atomicAdd(&(node->utmp[k].y), u.y);
 8094: 
 8095:                }
 8096: 
 8097:             }
 8098:          }
 8099:          else { // For quads
 8100: 
 8101: 
 8102:             // Compute the bilinear coordinates of the center of each diagonal.
 8103:             double xi, eta;
 8104:             double shp13[4], shp24[4];
 8105:             Point2 x0, x1, x2, x3;
 8106:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 8107:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 8108:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 8109: 
 8110:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 8111:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 8112: 
 8113: 
 8114: 
 8115: 
 8116:             for (int k = kb; k < nvrt; k++) {
 8117: 
 8118:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 8119:                Vector2 sideU[4];
 8120:                #pragma unroll
 8121:                for (int j = 0; j < 4; j++) {
 8122:                   Vector2 u = elem->sides[j]->u2[k];
 8123:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 8124:                   sideU[j] = u;
 8125:                }
 8126: 
 8127:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 8128:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 8129: 
 8130:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 8131:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 8132:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 8133:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 8134:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 8135:                #pragma unroll
 8136:                for (int j = 0; j < 4; j++) {
 8137:                   Node *node = elem->nodes[j];
 8138:                   if (node->isDry) continue;
 8139: 
 8140:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 8141:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 8142:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 8143:                }
 8144:             }
 8145: 
 8146:          }
 8147: 
 8148:       }
 8149:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 8150:       
 8151:    }
 8152: 
 8153: 
 8154:    __global__ void computeNodalHorizontalVelocities2(void) {
 8155:       NODE(node);
 8156: 
 8157:       const int nodeCount = node->tmp.i;
 8158: 
 8159:       if (nodeCount == 0) 
 8160:       {
 8161:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 8162:          return;
 8163:       }
 8164: 
 8165:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 8166:       
 8167:       const int kb = node->kb;
 8168: 
 8169:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 8170:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 8171:   if (fabs(node->p.x) < 1e-6)
 8172:    printf("idx=%d cnt=%d bnd=%d u=%f v=%f\n",
 8173:           node->idx, nodeCount, node->nodeBnd != nullptr,
 8174:           node->u2[ivrt].x, node->u2[ivrt].y);    
 8175:       
 8176:    }   
 8177: 
 8178:  
 8179: 
 8180:    __global__ void resetVelocityOpenBndNodes(void) {
 8181:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8182: 
 8183:       NODE_BND(nodebnd);
 8184:  
 8185:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8186:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8187:       }
 8188: 
 8189:    }
 8190: 
 8191: 
 8192:    __global__ void setVelocityOpenBndNodes(void) {
 8193:    // For open boundary nodes sets their velocity to the imposed values.
 8194: 
 8195:       SIDE_BND(sidebnd);
 8196: 
 8197:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8198:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8199:          // to its segment to the average of the side velocity.
 8200: 
 8201:          for (int k = 0; k < nvrt; k++) {
 8202:             Node *n1 = sidebnd->side->n1;
 8203:             Node *n2 = sidebnd->side->n2;
 8204: 
 8205: 
 8206:             Vector2 &n1_u2 = n1->u2[k];
 8207:             Vector2 &n2_u2 = n2->u2[k];
 8208: 
 8209:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8210:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8211:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8212:             }
 8213:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8214:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8215:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8216:             }
 8217: 
 8218:          }
 8219: 
 8220:       }
 8221: 
 8222:    }
 8223: 
 8224: 
 8225:    __global__ void computeVerticalVelocity(void) {
 8226:       // Computes the vertical velocity at the (2D) element's centroid.
 8227:       // In this function we will be considering volumetric elements, with side faces and a 
 8228:       // bottom and a top face. We will call them SFs, BF and TF.
 8229:       // It computes the flux coming from BF and the SFs.
 8230:       // If the bed is moving, it takes that into account.
 8231:       // Since water is incompressible, the integral of the velocity times the normal vector
 8232:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8233:       // and the BF is equal to the flux going out from the TF.
 8234:       // TF = - BF - sum(SFs).
 8235:       // It then computes the horizontal velocity at the center of TF.
 8236:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8237:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8238:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8239: 
 8240:       ELEM(elem);
 8241: 
 8242:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8243: 
 8244:       if (elem->isDry) return;
 8245: 
 8246:       const int kb = elem->kb;
 8247:       const bool isTri = elem->isTri();
 8248: 
 8249:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8250: 
 8251:       // Compute the bottom velocity
 8252:       if constexpr(imm != 0) {
 8253:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8254:       }
 8255: 
 8256: 
 8257:       double bottomArea3D;
 8258:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8259: 
 8260:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8261: 
 8262:       double topArea3D;
 8263: 
 8264:       // Bottom face flux
 8265:       double bottomFlux = 0.0;
 8266:       Vector2 u2meanBottom = {0.0, 0.0};
 8267:       const Vector2 gradh = elem->grad2(&Node::depth);
 8268:       if constexpr(imm==2) {
 8269:          Vector3 ubed;
 8270: 
 8271:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8272:          // updateBDEF(ubed);
 8273:      
 8274:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8275: 
 8276:          // elem->w[kb] += ubed.z;
 8277:       }
 8278:       else {
 8279: 
 8280:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8281:   
 8282:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8283:          // in the direction of motion.
 8284:          const double bottomW = - dot(gradh, u2meanBottom);  
 8285:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8286: 
 8287:          // VElocity associated to the bed deformation
 8288:          double bedVelocity = 0.0;
 8289:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8290: 
 8291:          elem->w[kb] = bedVelocity + bottomW; 
 8292: 
 8293:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8294: 
 8295:          elem->transport.setVerticalAdvectionFlux(kb, 0.0);
 8296:          
 8297:       } // if imm
 8298: 
 8299:       // Compute w for kb+1 to nvrt-1
 8300:       for (int l = kb; l < nvrt - 1; l++) {
 8301: 
 8302:          // normal vector to the top face of the "volumetric" element (3D)
 8303:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8304: 
 8305:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8306:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8307: 
 8308:          // Compute the total flux at the sides
 8309:          double sideFlux = 0.0;
 8310: 
 8311:          for (int j = 0; j < elem->i34; j++) {
 8312:             const Side *side = elem->sides[j];
 8313:             const int kbs = side->kb;
 8314:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8315:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8316:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8317: 
 8318:             // The area is "clamped" meaning that it takes kb into account.
 8319:             const double sideArea = side->areaClamped(l + 1);
 8320: 
 8321:             const double sign = elem->ssign[j]; 
 8322: 
 8323:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8324:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8325:          }
 8326:          
 8327:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8328:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8329:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8330: 
 8331:          // The flux at the top ace can be computed from the other flows.
 8332:          // All fluxes are in directions into the prism.
 8333:          const double topFlux = - sideFlux - bottomFlux;
 8334: 
 8335:          elem->transport.setVerticalAdvectionFlux(l + 1, topFlux);
 8336: 
 8337:          // Flux at the top face due to the horizontal velocities only
 8338:          // topFlux = topHorizontalFlux + topVerticalFlux
 8339:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8340: 
 8341:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8342:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8343: 
 8344:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8345: 
 8346:          bottomFlux = -topFlux;
 8347:          
 8348:       }
 8349: 
 8350:    }  
 8351: 
 8352: 
 8353: 
 8354: 
 8355: 
 8356: 
 8357: 
 8358: // !===============================================================================
 8359: // !===============================================================================
 8360: 
 8361: } // extern "C"
 8362: 
 8363: #ifdef DONTCOMPILE
 8364: __device__ void computeVerticalAdvection(void) {
 8365:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8366: 
 8367:    sdbt(1:2,:,:)=0.d0
 8368: 
 8369:    const Side *side = FROM kernel;
 8370: 
 8371:    if(side->isDry) return;
 8372: 
 8373:    // If side is wet...
 8374: 
 8375: 
 8376:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8377:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8378:    double ws[nvrt] = {} // w @ side
 8379:    int icount = 0;
 8380:    for (int j=0; j<2; j++) {
 8381:       const Element *elem = side->elements[j];
 8382:        
 8383:       if(elem != nullptr) {
 8384:          icount++;
 8385:          for (int k=0; k<nvrt; k++) {
 8386:             ws[k] = ws[k] + elem->w[k];
 8387:          }
 8388:       }
 8389:    }  // for j
 8390: 
 8391:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8392:    ws = ws/icount;
 8393: 
 8394:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8395:    // Splines allow for a smooth transition between vertical levels.
 8396:    // Splines have continuity restrictions at the internal knots, but
 8397:    // we have to provide the 1st derivatives at the endpoints.
 8398:    const int kbs = side->kbs; 
 8399:    
 8400:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8401:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8402:    initCubicSpline(kbs, nvrt, side, ws, up)
 8403: 
 8404:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8405:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8406:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8407: 
 8408:    // Total advection (average onto side)
 8409:    const Node *node1 = side->nodes[0];
 8410:    const Node *node2 = side->nodes[1];
 8411:    for (int k=kbs(i); k<nvrt; k++) {
 8412: 
 8413:       Vector2 bcc1 = node1->bcc[k];
 8414:       Vector2 bcc2 = node2->bcc[k];
 8415:       if constexpr(ics == 2) {
 8416:          // Project the velocities from the node frames to the side frame
 8417:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8418:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8419:       }
 8420: 
 8421:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8422:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8423: 
 8424:    }
 8425: }
 8426: #endif
 8427: 
 8428: 
 8429: extern "C" {
 8430:    __global__ void computeElemAverageGhat(void) {
 8431:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8432: 
 8433:       ELEM(elem);
 8434:       
 8435:       elem->ghat1= {0.0, 0.0};  
 8436: 
 8437:       if constexpr(ihydraulics != 0) {
 8438:          if (nhtblocks > 0 && elem->isblock) return;
 8439:       }
 8440: 
 8441:       
 8442:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8443:       // cff1-3: coefficients for 2D/3D
 8444: 
 8445:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8446:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8447:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8448: 
 8449:       if (elem->isDry) return;
 8450: 
 8451:       // Average of the coefficients
 8452:       double av_cff1 = 0.0;  // av. for cff1
 8453:       double av_cff2 = 0.0;  // av. for cff2
 8454:       double av_cff3 = 0.0;  // av. for cff3
 8455:       double av_df = 0.0;  // av. for H^\alpha / H
 8456:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8457:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8458: 
 8459:       const int i34 = elem->i34;
 8460:       const int kb  = elem->kb;
 8461: 
 8462:       for (int j=0; j<i34; j++) {
 8463:          // For each node and side in the element...
 8464: 
 8465:          const Node *node = elem->nodes[j];
 8466:          const Side *side = elem->sides[j];
 8467: 
 8468:          const double chi      = side->chi;
 8469:          const double veg_c2   = side->veg_c2;
 8470:          const double veg_beta = side->veg_beta;
 8471:          const double veg_h    = side->veg_h();
 8472:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8473: 
 8474:          const Vector2 gradPhi = elem->gradPhi[j];
 8475: 
 8476:          // Node - const in elem
 8477:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8478:          elem->gradPr  += node->pr  *gradPhi;
 8479: 
 8480:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8481: 
 8482:         
 8483:          const double htot  = side->htot2();        // Total depth at the side
 8484:          const double zctr2 = side->zTopCanopy();  
 8485: 
 8486:          double cff1; 
 8487:          double cff2; 
 8488:          double cff3;   
 8489:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8490:          // coefficients applied to 2D/3D case 
 8491:             cff1 = side->hhat/htot;
 8492:             cff2 = 0.0;
 8493:             cff3 = 0.0;
 8494:          } else { //3D
 8495:             //Init for no-veg case
 8496:             cff1 = 1.0;
 8497:             cff2 = 1.0;
 8498:             cff3 = 0.0;
 8499: 
 8500:             if constexpr(iveg != 0) {
 8501:                // Computes coefficients used with vegetation terms G1, G2
 8502:                // cff1, cff3 are used for the first two terms in G1, G2:
 8503:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8504:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8505:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8506:                if(veg_h < 0.99*htot) { // submergent vegetation
 8507:                   cff1 = 1.0;
 8508:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8509:                   cff3 = veg_c;
 8510: 
 8511:                } else { // emergent vegetation
 8512:                   cff1 = 1.0/(1.0 + veg_c2);
 8513:                   cff2 = cff1;
 8514:                   cff3 = 0.0;
 8515: 
 8516:                }
 8517:             } // if iveg
 8518:          } //  2D/3D
 8519: 
 8520:          av_cff1 += cff1/i34;
 8521:          av_cff2 += cff2/i34;
 8522:          av_cff3 += cff3/i34;
 8523:          av_cff2_chi += cff2*chi/i34;
 8524:          av_cff3_chi += cff3*chi/i34;
 8525:          av_df += min(htot, veg_h)/(htot*i34);
 8526: 
 8527: 
 8528:          // btrack values: U^\star, U^{\star\alpha}
 8529:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8530:          Vector2 Ustar       = {0.0, 0.0}; 
 8531:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8532: 
 8533:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8534:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8535:          } else { //3D
 8536:             for (int k = side->kb + 1; k < nvrt; k++) {
 8537:             
 8538:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8539:                Ustar += w2;
 8540: 
 8541:                if constexpr(iveg != 0) {
 8542:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8543:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8544:                        Ustar_alpha += zrat*w2; // XXXX
 8545:                    }
 8546:                }  // if iveg
 8547:             }  // for k
 8548:          }  //2D/3D
 8549: 
 8550:          // If needed, project the side velocities to the element frame
 8551:          if constexpr(ics==2) {
 8552:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8553:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8554:          }
 8555:         
 8556: 
 8557:          // Add btrack & surface stress terms to \breve{G} first
 8558:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8559: 
 8560: 
 8561:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8562:          Vector2 tau    = side->tau();  
 8563:          Vector2 ubstar = side->btu[side->kb + 1];  
 8564: 
 8565:          // If needed, project tau and ubstar to the element frame
 8566:          if constexpr(ics==2) {
 8567:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8568:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8569:          }
 8570: 
 8571:          // Term for surface and bottom stress
 8572:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8573: 
 8574: 
 8575:          // All terms in F,F^\alpha,f_b except baroclinic
 8576:          // F, f_b: all explicit terms excluding vegetation 
 8577:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8578:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8579:          const double coriolis = side->coriolis;
 8580:          Vector2 F  =  coriolis*side->U;  // F_x
 8581:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8582:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8583: 
 8584:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8585:             
 8586:             for (int k = side->kb; k < nvrt; k++) {
 8587:                if (zctr2 > side->zc[k-1]) {
 8588:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8589:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8590:                    Fa +=  coriolis*w2*zrat;
 8591:                } // if zctr2
 8592:             } // k
 8593:          } // iveg
 8594: 
 8595:          // Integrate horizontal viscosity force vertically
 8596:          for (int k=side->kb + 1; k<nvrt; k++) {
 8597:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8598: 
 8599:             F += levelHorVisc;
 8600: 
 8601:             // Vegetation term
 8602:             if constexpr(iveg!=0) {
 8603:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8604:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8605:                   Fa += levelHorVisc*zrat;
 8606:                } 
 8607:             } // if iveg
 8608:          } // for k
 8609: 
 8610:          // Get nu*grad(U) at the side's bottom level
 8611:          Vector2 nuGradU = side->nuGradU[side->kb];
 8612: 
 8613:          fb += nuGradU;
 8614: 
 8615:          // If needed, project vectorsF, fb and Fa to the element frame
 8616:          if constexpr(ics==2) {
 8617:             F    = side->frame.projHorVec(F,    elem->frame);
 8618:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8619:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8620:          } // if ics
 8621: 
 8622:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8623:       } // for j (nodes and sides)
 8624: 
 8625:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8626: 
 8627: 
 8628:       // Finish off terms in F, F^\alpha and f_b
 8629:       const double grav3 = elem->mean(&Node::grav2);
 8630:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8631:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8632:       for (int j=0; j<i34; j++) { 
 8633:          // For each side in the element...
 8634:          const Side *side = elem->sides[j];
 8635:          const double chi = side->chi;
 8636: 
 8637:          const double htot = side->htot2();
 8638:          const double veg_h = side->veg_h();
 8639:          const Vector2 F  = htot*fb;
 8640:          const Vector2 Fa = min(htot, veg_h)*fb;
 8641: 
 8642:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8643:       } // for j
 8644: 
 8645:       // tmp is already in elem frame
 8646:       elem->ghat1 += tmp/i34;
 8647: 
 8648:       // Baroclinic force
 8649:       if constexpr(ibc==0) {
 8650:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8651: 
 8652:          Vector2 Fa = {0.0, 0.0};
 8653:          Vector2 intGradRho = {0.0, 0.0};
 8654:          
 8655:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8656:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8657:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8658: 
 8659:             // \in F [m^2/s/s]
 8660:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8661:          }
 8662: 
 8663:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8664:          const Vector2 F = av_df*Fa; //approx
 8665:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8666: 
 8667:       } // if ibc 
 8668: 
 8669: 
 8670: 
 8671:    } 
 8672: 
 8673: 
 8674: 
 8675: 
 8676: 
 8677: // ------------------------------------------------------------
 8678: // Transport
 8679: // ------------------------------------------------------------
 8680: 
 8681: __device__ bool TransportElem<TransportModel::Upwind>::use1stOrderUpwind(const Element *elem) const {
 8682:    if (itvd) {
 8683:       // Marked as such in tvd.prop: always 1st order upwind for this element
 8684:       return true;
 8685:    }
 8686: 
 8687:    // If any node of the element is shallow, use 1st order upwind
 8688:    for (int j = 0; j < elem->i34; j++) {
 8689:       if (elem->nodes[j]->htot2() < h_tvd) return true;
 8690:    }
 8691:    return false;
 8692: }
 8693: 
 8694: __device__ void TransportElem<TransportModel::Upwind>::savePrevTraces(const Element *elem) {
 8695:    for (int k = 0; k < nvrt; k++) prevTraces[k] = elem->tracers[k];
 8696: }
 8697: 
 8698: __device__ double TransportElem<TransportModel::Upwind>::maxPrismDt(const Element *elem, int k) const {
 8699:    if (inflow[k] == 0.0) return huge_double;
 8700:    return elem->volume(k - 1) / inflow[k] * (1.0 - 1.0e-6);
 8701: }
 8702: 
 8703: __device__ void TransportElem<TransportModel::Upwind>::setVerticalAdvectionFlux(int k, double flux)
 8704: {
 8705:    Qv[k] = flux;
 8706: }
 8707: 
 8708: __global__ void computeHorizAdvecFluxes(void) {
 8709: 
 8710: 
 8711:    SIDE(side)
 8712: 
 8713:    auto &transport = side->transport;
 8714: 
 8715:    for (int k = 0; k < nvrt; k++) transport.Qh[k] = -1.0e34; // Sentinel value for dry sides.
 8716: 
 8717:    if (side->isDry) return;
 8718: 
 8719:    const bool isLand = (side->sideBnd!=nullptr && side->sideBnd->segment != nullptr && side->sideBnd->segment->isLand);
 8720:    const int kb = side->kb;
 8721: 
 8722:    for (int k = kb + 1; k < nvrt; k++) {
 8723:       if (isLand) {
 8724:          transport.Qh[k] = 0.0;
 8725: 
 8726:       } else {
 8727:          const Vector2 n = side->n; // normal vector to the side
 8728:          const double area = side->area(k); // Area of the side face.
 8729:          const double vnor1 = dot(n, side->u2[k]);
 8730:          const double vnor2 = dot(n, side->u2[k-1]);
 8731:          const double vnor_c = 0.5*(vnor1 + vnor2); // Normal velocity at the face center.
 8732: 
 8733:          transport.Qh[k] = area*vnor_c; 
 8734:       }
 8735: 
 8736:    }
 8737: 
 8738: }
 8739: 
 8740: __global__ void horizontalAdvectionPrepare(void) {
 8741: 
 8742:    // Horizontal advection kernel.
 8743:    // -------------------------------
 8744: 
 8745:    // In this model, equations are written in such a way that concentration at time t+1 are computed from
 8746:    // *differences* of concentrations at the cell underconsideration and concentrations upwind of it. 
 8747:    // (how upwind is determined depends on the scheme)
 8748:    // 
 8749:    // For the 1st order upwind scheme, "upwind concentration" at outflow faces is the concentration at the cell itself.
 8750:    // So only inflow faces contribute to the concentration change at the cell.
 8751: 
 8752:    // In the implementation, we do 1st order independently and then consider TVD as an additional update term computed as 
 8753:    // as a sum over all faces (inflow and outflow).
 8754: 
 8755: 
 8756:    // Compute total inflow and maximum allowed sub-time step
 8757:    ELEM(elem)
 8758: 
 8759:    const int kb = elem->kb;
 8760:    const int i34 = elem->i34;
 8761:    auto &transport = elem->transport;
 8762: 
 8763:    if (elem->isDry) return;
 8764: 
 8765:    // Snapshot current prism tracers for this substep (Update reads prevTraces).
 8766:    transport.savePrevTraces(elem);
 8767: 
 8768:    elem->transport.maxDt = huge_double;
 8769: 
 8770:    for (int k = 0; k < kb + 1; k++) elem->transport.inflow[k] = 0.0;
 8771: 
 8772:    for (int k = kb + 1; k < nvrt; k++) { // For each wet prism in the element...
 8773: 
 8774:       transport.inflow[k] = 0.0;
 8775: 
 8776:       for (int j = 0; j < i34; j++) { // For each side in the element...
 8777:          const Side *side = elem->sides[j];
 8778:          const auto &sideTransport = side->transport;
 8779:          const double ssign = elem->ssign[j];
 8780:          const int kbs = side->kb;
 8781: 
 8782:          if (k <= kbs) continue;
 8783: 
 8784:          // Get the element at the other end of side j.
 8785:          const Element *neighElem = side->otherElem(elem);
 8786:          if (neighElem == nullptr || neighElem->isDry) continue;
 8787: 
 8788:          const double faceQ = sideTransport.Qh[k];
 8789:          const bool inFlux = (ssign*faceQ) < 0.0; // true if the flux points into the element
 8790: 
 8791:          const BoundarySegment *boundarySegment = (side->sideBnd == nullptr) ? nullptr : side->sideBnd->segment;
 8792:          const bool isLand = (boundarySegment != nullptr && boundarySegment->isLand);
 8793: 
 8794:          // Count this side's flux only when water flows into the element, and the water is coming from somewhere 
 8795:          // real: either a wet neighboring element, or an open boundary.         
 8796:          if (isLand || !inFlux) continue;
 8797: 
 8798:          for (int itr = 0; itr < ntracers; itr++) {
 8799:             transport.inflow[k] += fabs(faceQ);  // Sum of all inflow fluxes at level k.
 8800:          }
 8801: 
 8802:       }
 8803:       
 8804:       // computes the minimum allowed sub-time step for the prism
 8805:       elem->transport.maxDt = min(elem->transport.maxDt, elem->transport.maxPrismDt(elem, k));
 8806:    }
 8807: 
 8808: }
 8809: 
 8810: __global__ void horizontalAdvectionUpdate(double dtb) {
 8811:    ELEM(elem);
 8812: 
 8813:    if (elem->isDry) return;
 8814: 
 8815:    const int kb = elem->kb;
 8816:    auto &transport = elem->transport;
 8817: 
 8818:    for (int k = kb + 1; k < nvrt; k++) {
 8819:       const double vol = elem->volume(k - 1);
 8820:       const double dtb_by_vol = dtb / vol;
 8821:       Tracers adv = transport.prevTraces[k];  // start from old C
 8822: 
 8823:       for (int j = 0; j < elem->i34; j++) {
 8824: 
 8825:          const Side *side = elem->sides[j];
 8826: 
 8827:          if (k <= side->kb) continue;
 8828: 
 8829:          const double faceQ = side->transport.Qh[k];
 8830:          const double sQ = elem->ssign[j] * faceQ;
 8831:          if (sQ >= 0.0) continue;  // outflow or zero: skip (upwind)
 8832: 
 8833:          // outside concentration
 8834:          Tracers Cout = adv;  // default: no change (e.g. land / same as interior)
 8835:          const Element *neigh = side->otherElem(elem);
 8836:          if (neigh != nullptr && !neigh->isDry) {
 8837:             Cout = neigh->transport.prevTraces[k];
 8838:          } else if (side->sideBnd != nullptr && !side->sideBnd->segment->isLand) {
 8839:             // XXXXXXXXXXXXX
 8840:             // Cout.tracer[0] = 0.1;
 8841:             // Cout.tracer[1] = 0.1;
 8842:          } else {
 8843:             continue;
 8844:          }
 8845: 
 8846:          const double coef = dtb_by_vol * fabs(faceQ);
 8847:          #pragma unroll 
 8848:          for (int itr = 0; itr < ntracers; itr++)
 8849:             adv.tracer[itr] += coef * (Cout.tracer[itr] - transport.prevTraces[k].tracer[itr]);
 8850:       }
 8851: 
 8852:       elem->tracers[k] = adv;
 8853:    }
 8854: 
 8855:    // extend below bottom
 8856:    for (int k = 0; k <= kb; k++)
 8857:       elem->tracers[k] = elem->tracers[kb + 1];
 8858: }
 8859: 
 8860: __global__ void verticalAdvectionUpdate(double dt) {
 8861: 
 8862:    ELEM(elem);
 8863: 
 8864:    if (elem->isDry) return;
 8865: 
 8866:    const int kb = elem->kb;
 8867:    auto &transport = elem->transport;
 8868: 
 8869:    // Fortran workshare: trel_tmp = tr_el
 8870:    transport.savePrevTraces(elem);
 8871: 
 8872:    const bool upwindElem = transport.use1stOrderUpwind(elem);
 8873: 
 8874:    // For TransportModel::Upwind this is always the path below (phi=0).
 8875:    double alow[nvrt], bdia[nvrt], cupp[nvrt], rrhs[nvrt], soln[nvrt], gam[nvrt];
 8876: 
 8877:    // Outer tracer loop as in Fortran (m=1..ntr). Matrix is scalar in m.
 8878:    for (int itr = 0; itr < ntracers; itr++) {
 8879:       // ---- upwind / iter_back: phi=0, flux_mod_v1=1, denom=1 ----
 8880:       // Full SB-TVD iteration (rrat, phi, flux_mod_v1/v2, psi1) omitted here;
 8881:       // that is the TVD branch when !upwindElem. Structure is in Fortran L1224-1488.
 8882:       const int nEq  = nvrt - (kb + 1);
 8883:       for (int kin = 0; kin < nEq ; kin++) {
 8884:          alow[kin] = 0.0;
 8885:          cupp[kin] = 0.0;
 8886:          bdia[kin] = 0.0;
 8887:       }
 8888:       for (int k = kb + 1; k < nvrt; k++) {
 8889:          const int kin = k - (kb + 1);
 8890:          const double dt_by_bigv = dt / elem->volume(k - 1);
 8891:          // upwind: denom = 1
 8892:          bdia[kin] += 1.0;
 8893:          rrhs[kin]  = transport.prevTraces[k].tracer[itr] * 1.0;
 8894:          // Upper face inflow: Qv[k] < 0
 8895:          if (k != nvrt - 1 && transport.Qv[k] < 0.0) {
 8896:             const double tmp = dt_by_bigv * fabs(transport.Qv[k]); // * flux_mod_v1(=1)
 8897:             cupp[kin] -= tmp;
 8898:             bdia[kin] += tmp;
 8899:          }
 8900:          // Lower face inflow: Qv[k-1] > 0
 8901:          if (k - 1 != kb && transport.Qv[k - 1] > 0.0) {
 8902:             const double tmp = dt_by_bigv * fabs(transport.Qv[k - 1]);
 8903:             alow[kin] -= tmp;
 8904:             bdia[kin] += tmp;
 8905:          }
 8906:       }
 8907:       tridag_sch<1>(nEq , alow, bdia, cupp, rrhs, soln, gam);
 8908:       for (int k = kb + 1; k < nvrt; k++)
 8909:          elem->tracers[k].tracer[itr] = soln[k - (kb + 1)];
 8910:    }
 8911:    // Extend below bottom
 8912:    for (int k = 0; k <= kb; k++)
 8913:       elem->tracers[k] = elem->tracers[kb + 1];
 8914: }
 8915: 
 8916: 
 8917: // Fortran transport_TVD_imp step 3: non-advection (vertical diffusion).
 8918: // Call after verticalAdvectionUpdate(dt), before nodalTracerUpdate.
 8919: // Requires dfh set (itur!=0 path, or dfh0>0 when itur==0).
 8920: __global__ void verticalDiffusionUpdate(double dt) {
 8921: 
 8922:    ELEM(elem);
 8923: 
 8924:    if (elem->isDry) return;
 8925: 
 8926:    const int kb = elem->kb;
 8927:    auto &transport = elem->transport;
 8928: 
 8929:    // Fortran: trel_tmp = tr_el
 8930:    transport.savePrevTraces(elem);
 8931: 
 8932:    double alow[nvrt], bdia[nvrt], cupp[nvrt], rrhs[nvrt], soln[nvrt], gam[nvrt];
 8933: 
 8934:    for (int itr = 0; itr < ntracers; itr++) {
 8935:       const int nEq = nvrt - (kb + 1);
 8936: 
 8937:       for (int kin = 0; kin < nEq; kin++) {
 8938:          alow[kin] = 0.0;
 8939:          cupp[kin] = 0.0;
 8940:          bdia[kin] = 1.0;
 8941:          rrhs[kin] = 0.0;
 8942:       }
 8943: 
 8944:       // Prism k = kb+1 .. nvrt-1  (Fortran kbe+1 .. nvrt)
 8945:       for (int k = kb + 1; k < nvrt; k++) {
 8946:          const int kin = k - (kb + 1);
 8947:          const double dt_by_bigv = dt / elem->volume(k - 1);
 8948: 
 8949:          // Diffusion at upper face k (Fortran k < nvrt)
 8950:          if (k < nvrt - 1) {
 8951:             const double av_df = elem->mean(k, &Node::dfh);
 8952:             const double av_dz = 0.5 * (elem->z[k + 1] - elem->z[k - 1]);
 8953:             const double tmp   = elem->area * dt_by_bigv * av_df / av_dz;
 8954:             cupp[kin] -= tmp;
 8955:             bdia[kin] += tmp;
 8956:             // settling @ face k: if wsett<=0 bdia -= area*dt_by_bigv*wsett;
 8957:             //                     else cupp -= area*dt_by_bigv*wsett;
 8958:          }
 8959: 
 8960:          // Diffusion at lower face k-1 (Fortran k > kbe+1)
 8961:          if (k > kb + 1) {
 8962:             const double av_df = elem->mean(k - 1, &Node::dfh);
 8963:             const double av_dz = 0.5 * (elem->z[k] - elem->z[k - 2]);
 8964:             const double tmp   = elem->area * dt_by_bigv * av_df / av_dz;
 8965:             alow[kin] -= tmp;
 8966:             bdia[kin] += tmp;
 8967:             // settling @ face k-1: if wsett<=0 alow += ...; else bdia += ...;
 8968:          }
 8969: 
 8970:          // Bottom settling BC (iwsett==1, k==kbe+1): bdia += area*dt_by_bigv*wsett(kb)
 8971: 
 8972:          rrhs[kin] = transport.prevTraces[k].tracer[itr];
 8973:          // if (k == nvrt - 1) rrhs += area * dt_by_bigv * flx_sf;
 8974:          // if (k == kb + 1)   rrhs -= area * dt_by_bigv * flx_bt;
 8975:          // rrhs += dt * bdy_frc;
 8976:       }
 8977: 
 8978:       tridag_sch<1>(nEq, alow, bdia, cupp, rrhs, soln, gam);
 8979: 
 8980:       for (int k = kb + 1; k < nvrt; k++)
 8981:          elem->tracers[k].tracer[itr] = soln[k - (kb + 1)];
 8982:    }
 8983: 
 8984:    for (int k = 0; k <= kb; k++)
 8985:       elem->tracers[k] = elem->tracers[kb + 1];
 8986: }
 8987: 
 8988: __global__ void nodalTracerUpdate(void) {
 8989:    NODE(node);
 8990:    if (node->isDry) return;
 8991: 
 8992:    for (int k = 0; k < nvrt; k++) {
 8993:       Tracers sum = {};
 8994:       double sumA = 0.0;
 8995: 
 8996:       for (int j = 0; j < node->numElements; j++) {
 8997:          const Element *elem = node->elements[j];
 8998:          if (elem->isDry || k <= elem->kb) continue;
 8999: 
 9000:          const double A = elem->area;
 9001:          for (int itr = 0; itr < ntracers; itr++)
 9002:             sum.tracer[itr] += A * elem->tracers[k].tracer[itr];
 9003:          sumA += A;
 9004:       }
 9005: 
 9006:       if (sumA == 0.0) continue;
 9007:       const double inv = 1.0 / sumA;
 9008:       for (int itr = 0; itr < ntracers; itr++)
 9009:          node->tracers[k].tracer[itr] = inv * sum.tracer[itr];
 9010:    }
 9011: }
 9012: 
 9013: 
 9014: __device__ __forceinline__ void atomicMinDouble(double *addr, double val) {
 9015:    unsigned long long *p = (unsigned long long *)addr;
 9016:    unsigned long long old = *p, assumed;
 9017:    do {
 9018:       assumed = old;
 9019:       old = atomicCAS(p, assumed,
 9020:          __double_as_longlong(fmin(val, __longlong_as_double(assumed))));
 9021:    } while (assumed != old);
 9022: }
 9023: 
 9024: __device__ __forceinline__ double blockMin(double v) {
 9025:    __shared__ double sh[32];
 9026:    const int lane = threadIdx.x & 31;
 9027:    const int warp = threadIdx.x >> 5;
 9028:    for (int o = 16; o > 0; o >>= 1)
 9029:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9030:    if (lane == 0) sh[warp] = v;
 9031:    __syncthreads();
 9032:    if (warp == 0) {
 9033:       const int nw = blockDim.x >> 5;
 9034:       v = (lane < nw) ? sh[lane] : huge_double;
 9035:       for (int o = 16; o > 0; o >>= 1)
 9036:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9037:    }
 9038:    return v;  // only lane 0 of warp 0 is the block min
 9039: }
 9040: 
 9041: extern "C" __global__ void minTransportDt(double *out) {
 9042:    const int idx = threadIdx.x + blockIdx.x * blockDim.x;
 9043:    double v = huge_double;
 9044:    if (idx < mesh->ne) {
 9045:       Element *elem = &mesh->localElemData[idx];
 9046:       if (!elem->isDry) v = elem->transport.maxDt;
 9047:    }
 9048:    __shared__ double sh[32];
 9049:    const int lane = threadIdx.x & 31;
 9050:    const int warp = threadIdx.x >> 5;
 9051:    for (int o = 16; o > 0; o >>= 1)
 9052:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9053:    if (lane == 0) sh[warp] = v;
 9054:    __syncthreads();
 9055:    if (warp == 0) {
 9056:       const int nw = (blockDim.x + 31) >> 5;
 9057:       v = (lane < nw) ? sh[lane] : huge_double;
 9058:       for (int o = 16; o > 0; o >>= 1)
 9059:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9060:       if (lane == 0) atomicMinDouble(out, v);
 9061:    }
 9062: }
