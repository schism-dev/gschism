  920:    __device__ __forceinline__ double intGradPhiGradPhiTri(int i, int j) const;
  921: 
  922:    __device__ __forceinline__ double intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  923: 
  924:    __device__ __forceinline__ double intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  925: 
  926:    __device__ __forceinline__ Vector2 grad2(double *a) const
  927:    {
  928:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  929:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  930:       if (isQuad()) {
  931:          gx += a[3]*gradPhi[3].x;
  932:          gy += a[3]*gradPhi[3].y;
  933:       }
  934:       return {gx, gy};
  935:    }
  936: 
  937:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
  938:    {
  939:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  940:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  941:       if (isQuad()) {
  942:          gx += (nodes[3]->*field)*gradPhi[3].x;
  943:          gy += (nodes[3]->*field)*gradPhi[3].y;
  944:       }
  945:       return {gx, gy};
  946:    }
  947: 
  948:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  949:    __device__ __forceinline__ Vector3 n(int k) const {
  950:       double area3D;
  951:       return n(k, area3D);
  952:     }
