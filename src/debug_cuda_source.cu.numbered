 6828:    __global__ void computeTurbulence(void) {
 6829: 
 6830:       NODE(node);
 6831: 
 6832:       // Calls the templated function to compute the turbulence model parameters.
 6833:       // turbulenceModel is just a class enum version of itur.
 6834:       computeTurbulenceModel<turbulenceModel>(node);
 6835:       
 6836:    }
