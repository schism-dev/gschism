  186: // eta coordinates of the nodes (idxNode = 0,1,2,3)
  187: __device__ __forceinline__ double eta_n(int idxNode) {
  188:    // bit1: 0 -> -1, 1 -> +1
  189:    assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  190:    return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  191: }
  192: 
  193: // xi coordinates of the nodes (idxNode = 0,1,2,3)
  194: __device__ __forceinline__ double xi_n(int idxNode) {
  195:    // +1 if (bit0 XOR bit1), else -1
  196:    assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  197:    return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  198: 
  199: }
