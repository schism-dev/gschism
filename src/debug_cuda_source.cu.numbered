 1439: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1440:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1441: }
 1442: 
 1443: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1444:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1445: }   
 1446: 
 1447: __device__ __inline__ double min3(double a, double b, double c) {
 1448:    return min(a, min(b, c));
 1449: }
 1450: 
 1451: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1452:    return min(a, min(b, min(c, d)));
 1453: }
