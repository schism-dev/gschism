 9407: __global__ void printMatrix(bool full) {
 9408:    // Debugging: print the FEM matrix row for each local node
 9409: 
 9410:    const int size = mesh->np;
 9411:    double sum = 0.0;
 9412: 
 9413:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9414:       const Node *node = mesh->localNodeData + idx_node;
 9415: 
 9416:       if (full)
 9417:          printf("idx_node = %d [%d] diag=%lf, [",
 9418:                 idx_node, node->numNodes, *(node->coeffDiag));
 9419: 
 9420:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9421:       for (int k = 0; k < node->numNodes + 1; k++)
 9422:          sum += node->coeffRow[k];
 9423: 
 9424:       for (int j = 0; j < node->numNodes; j++) {
 9425:          const Node *nbNode = node->nodes[j];
 9426:          const double aij = node->coeffRow[node->csrSlot[j]];
 9427:          if (full && aij != 0.0)
 9428:             printf("%d:%f,  ", nbNode->idx, aij);
 9429:       }
 9430: 
 9431:       if (full) printf("]\n");
 9432:    }
 9433: 
 9434:    if (!full) printf("sum=%lf\n", sum);
 9435: }
