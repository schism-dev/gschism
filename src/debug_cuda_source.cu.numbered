 1230: struct Node {
 1231: 
 1232:    // Geometry information
 1233:    int idx;        // Index of the node
 1234:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1235:    int numNodes;   // Number of nodes neighbors of this node
 1236: 
 1237:    Element **elements; // Array of pointers to the elements that share this node
 1238:    int numElements;    // Number of elements that share this node
 1239: 
 1240:    int numSides;       // Number of sides that are connected to this node
 1241: 
 1242:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1243:    double gz;          // Global vertical coordinate at the node.
 1244:    Vector2 u2[nvrt];
 1245:    double  w2[nvrt];
 1246:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1247:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1248:    double lon, lat;
 1249:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1250:    double depth;
 1251: 
 1252:    #ifdef USE_FRAMES
 1253:    Frame frame;
 1254:    #endif
 1255: 
 1256:    #ifdef USE_LOCALIZED_SIGMA   
 1257:    double localSigma[nvrt];
 1258:    #endif
 1259: 
 1260:    int kb;       // Bottom index of the node
 1261: 
 1262:    bool isDry;     // True if the node is dry
 1263: 
 1264:    int iadv;     // Advection flag
 1265: 
 1266:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1267:                           // this is nullptr
 1268: 
 1269:    TempVar tmp; // Temporary variable to store different types of variables
 1270: 
 1271:    // Physical information
 1272:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1273:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1274: 
 1275:    double rho[nvrt];     // Density
 1276:    double dfv[nvrt];     // Vertical viscosity
 1277: 
 1278:    double eta1; // Elevation at nodes at previous timestep
 1279:    double eta2; // Elevation at nodes at current timestep
 1280: 
 1281:    double ETP;  // Earth Tidal Potential
 1282: 
 1283:    double pr;    // Air pressure
 1284:    double grav2; // Gravity 
 1285:    
 1286:    Vector2 dav;  // Depth averaged velocity
 1287: 
 1288:    Vector2 tau; // Wind stress vector
 1289: 
 1290:    // Vegetation parameters
 1291:    double veg_h;
 1292:    double veg_nv;
 1293:    double veg_di;
 1294:    double veg_Cd;
 1295:    double veg_h_unbent;
 1296:    double veg_di_unbent;
 1297:    double veg_nv_unbent;
 1298:    double veg_alpha_vert_mean;
 1299:    double veg_alpha0;
 1300:    double veg_alpha3D[nvrt];
 1301: 
 1302:    // Bottom drag parameters
 1303:    double Cd;       // Bottom drag coefficient   
 1304: 
 1305:    // These three are mutually exclusive
 1306:    union {
 1307:       double rmanning; // Bottom Manning's coefficient
 1308:       double rough;    // Bottom roughness length
 1309:       double drag;     // Bottom drag coefficient
 1310:    };
 1311:    Vector2 tau_bot; // Bottom stress vector
 1312: 
 1313:    double bdef1; // Bottom deformation at previous timestep
 1314:    double bdef2; // Bottom deformation at current timestep
 1315: 
 1316:    double qel; // RHS
 1317:    double coeffDiag; // Diagonal coefficient of the matrix
 1318:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1319: 
 1320:    double mP; // Search direction for conjugate gradient method
 1321:    double mR; // Residual for conjugate gradient method
 1322:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1323:    double mX; // Solution for conjugate gradient method
 1324: 
 1325:    // Meteorological forcing
 1326:    Vector2 u_air;
 1327:    double p_air;  // XXXX is this the same as pr?
 1328:    double t_air;
 1329:    double q_air;
 1330:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1331: 
 1332:    __device__ void setWind(Vector2 &u) {
 1333:    // Sets the wind vector taking into account the mesh angle
 1334:    
 1335:       const double speed = length(u);
 1336: 
 1337:       // Rotate wind vector to the node frame
 1338:       const Vector2 u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1339: 
 1340:       // Sets the surface stress vector due to wind.
 1341:       if constexpr(nws == 0) {
 1342:          tau = {0.0, 0.0};
 1343: 
 1344:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1345:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1346: 
 1347:       } else {
 1348: 
 1349:          double dragcoef;
 1350: 
 1351:          if constexpr(iwind_form == -1) {
 1352:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1353:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1354: 
 1355:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1356:             tau = cff*u_air;
 1357:  
 1358:          } else if constexpr(iwind_form == 1) {
 1359:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1360:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1361: 
 1362:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1363:             tau = cff*u_air;
 1364: 
 1365:          } else {
 1366:             tau = {0.0, 0.0};
 1367:          }
 1368:       }
 1369:    }
 1370: 
 1371:    #ifdef USE_FRAMES
 1372:    __device__ void setFrame(double lat, double lon) {
 1373: 
 1374:       frame.update(lat, lon);        
 1375:     }
 1376:    #endif
 1377: 
 1378:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1379: 
 1380:    __device__ double sigmaTransitionDepth(void) const;
 1381: 
 1382:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1383:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1384:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1385:    
 1386:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1387: 
 1388:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1389: 
 1390:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1391:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1392: 
 1393:    __device__ __forceinline__ void clearMatrixRow(void) {
 1394:       // Clear the matrix row for this node
 1395: 
 1396: 
 1397:       coeffDiag = 0.0;
 1398: 
 1399:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1400: 
 1401:    }
 1402: 
 1403:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1404:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1405:       
 1406:       if (node == this) {
 1407:          coeffDiag += value;
 1408:      
 1409:       } else {
 1410:          // Search (linearly)the index of the node in the array of nodes
 1411:          // XXX: This is not efficient, see if we can improve this
 1412:          int i;
 1413:          for (i = 0; i < numNodes; i++) {
 1414:             if (nodes[i] == node) {
 1415:                break;
 1416:             }
 1417:          }
 1418:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1419:          coeffMatrix[i] += value;
 1420:       }
 1421:    }
 1422: 
 1423: 
 1424:    __device__ __inline__ void updateZCoordData(void);
 1425: 
 1426:    __device__ double compZCoord(int k) const;
 1427: 
 1428:    __device__ void updateKb(void);
 1429: 
 1430:    __device__ __forceinline__ void computeBottomDragCd(void);
 1431: 
 1432: 
 1433: 
 1434: };
