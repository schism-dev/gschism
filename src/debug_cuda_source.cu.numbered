 2362:    template<typename T>
 2363:    __device__ __forceinline__ T Element::mean(int level, T (Side::* field)[nvrt]) const {
 2364:       T values[4];
 2365:       getSideValues(level, field, values);
 2366: 
 2367:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2368:       if constexpr (IsVector2<T>::value && ics == 2) {
 2369: // XXXXX printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2370:          projectSideVectorsToElementFrame(values);
 2371: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2372:       }
