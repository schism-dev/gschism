 3391: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3392:    if constexpr(ics == 1) {
 3393:       return center;
 3394: 
 3395:    } else {
 3396:       const Point2 p0 = n1->outputCoords();
 3397:       const Point2 p1 = n2->outputCoords();
 3398:       return (1.0/2.0)*(p0 + p1);
 3399: 
 3400:    }
 3401: }
 3402: 
 3403: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3404: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3405: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3406: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3407: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3408: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3409: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3410: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3411: // Computes the gradient of the field at the side center.
 3412:    Vector2 grad = {0.0, 0.0};
 3413:    int count = 0;
 3414: 
 3415:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3416:    // as the average of the gradients at each element.
 3417:    // First element
 3418:    if (elems[0] != nullptr && condition(elems[0])) {
 3419:       Vector2 elemGrad = elems[0]->grad2(field);
 3420: 
 3421:       // For ics=2, projects the element gradient from its frame to the side frame
 3422:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3423: 
 3424:       grad += elemGrad;
 3425: 
 3426:       count++;
 3427:    }
 3428: 
 3429:    // Second element
 3430:    if (elems[1] != nullptr && condition(elems[1])) {
 3431: 
 3432:       Vector2 elemGrad = elems[1]->grad2(field);
 3433: 
 3434:       // For ics=2, projects the element gradient from its frame to the side frame
 3435:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3436: 
 3437:       grad += elemGrad;
 3438: 
 3439:       count++;
 3440:    }
 3441: 
 3442:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3443:    if (count > 0) {
 3444:       grad = grad*(1.0/count);
 3445:    }
 3446:    
 3447:    return grad;
 3448: }
