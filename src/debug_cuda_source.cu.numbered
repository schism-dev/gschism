 2762: 
 2763: __device__ void Node::updateKb(void) {
 2764: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2765: 
 2766:    if constexpr(ivcor == 1) return;
 2767: 
 2768: 
 2769:    if (isDry2()) return;
 2770: 
 2771:    if constexpr(ivcor == 2) {  // SZ coordinates
 2772:       
 2773:       // Compute bottom level index
 2774:       if (depth <= mesh->h_s) {
 2775:          kb = izlev;
 2776:          
 2777:       } else {
 2778:          kb = -1;
 2779:          int L = 0;
 2780:          int R = nzlev; 
 2781:          
 2782:          while (L <= R) {
 2783:             int M = (R + L) / 2;
 2784: 
 2785: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2786:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2787:             
 2788:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2789:                R = M;
 2790:             } else {
 2791:                L = M;
 2792:             }
 2793: 
 2794:             if (R - L == 1) {
 2795:                kb = L;
 2796:                break;
 2797:             }
 2798:          }
 2799:       }
 2800:    } 
 2801: }
 2802: 
 2803: 
 2804: __device__ __inline__ void Node::updateZCoordData(void) {
 2805: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2806: 
 2807:    if (isDry2()) return;
 2808: 
 2809:    if constexpr(ivcor == 2) {  // SZ coordinates
 2810:       
 2811:       // Compute bottom level index
 2812:       if (depth <= mesh->h_s) {
 2813:             kb = nzlev - 1;
 2814:       } else {
 2815:          kb = -1;
 2816:          for (int i = 0; i < nzlev; i++) {
 2817:             // XXX Use binary search
 2818:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2819:                kb = i;
 2820:                break;
 2821:             }
 2822:          }
 2823:       }
 2824:    } 
 2825:    else if (ivcor == 1) {  // Localized sigma
 2826:       // Do nothing
 2827:    }
 2828: 
 2829: }
 2830: 
 2831: __device__ double Node::compZCoord(int k) const {
 2832:    // Computes the z coordinate at level k.
 2833:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2834:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2835:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2836:    // used 
 2837:    
 2838:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2839: 
 2840:   
 2841:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2842: 
 2843:    if constexpr(ivcor == 2) {
 2844: 
 2845:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2846:       const double h_c = mesh->h_c;
 2847:       const double theta_f = mesh->theta_f;
 2848:       const double sinh_theta_f = mesh->sinh_theta_f;
 2849: 
 2850:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2851:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2852:       // once per time step/node.
 2853:       // CHECK: updateZCoordData
 2854: 
 2855:       //  To simplify comparisons, I define index versions of count variables.
 2856:       if      (k == ivrt)           return eta2; 
 2857:       else if (k == izlev)          return -hmod2;
 2858:       else if (k == kb)             return -depth;
 2859:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2860:       else if (k > izlev) {
 2861:          const int ksig = k - izlev;
 2862: 
 2863:          if (hmod2 <= h_c) {
 2864: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2865:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2866:          } 
 2867:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2868:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2869:             assert(false && "ZCOOR: invalid h_c\n");
 2870:          } 
 2871:          else {
 2872: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2873:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2874:                          h_c * mesh->sigma[ksig] + 
 2875:                          (hmod2 - h_c) * mesh->cs[ksig];
 2876:          }
 2877:       } else { 
 2878:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2879:       }
 2880: 
 2881:    }
 2882:    else if constexpr(ivcor == 1) {
 2883:       if (k == kb) return -depth;
 2884:       else if (k == nvrt-1) return eta2;
 2885:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2886:    }
 2887:    
 2888:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2889:    return 0.0;
 2890: }
 2891: 
 2892: 
 2893: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2894:    // Checks if a side in on the boundary
 2895:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2896: 
 2897:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2898:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2899: 
 2900:    // Indices of the nodes that form the side
 2901:    const int n1 = side.n1->idx;
 2902:    const int n2 = side.n2->idx;
 2903: 
 2904:    // Check if the side is on a land boundary
 2905:    for (int i = 0; i < nland; i++) {
 2906:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2907:          // Consecutive nodes in the land boundary segment
 2908:          const int b1 = ilnd[i*mnlnd + j];
 2909:          const int b2 = ilnd[i*mnlnd + j + 1];
 2910: 
 2911:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2912:             isLand = true;
 2913:             return i;
 2914:          }
 2915:       }
 2916:    }
 2917: 
 2918:    // Check if the side is on an open boundary
 2919:    for (int i = 0; i < nope; i++) {
 2920:       for (int j = 0; j < nond[i] - 1; j++) {
 2921:          // Consecutive nodes in the open boundary segment
 2922:          const int b1 = iond[i*mnond + j];
 2923:          const int b2 = iond[i*mnond + j + 1];
 2924: 
 2925:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2926:             isLand = false;
 2927:             return i;
 2928:          }
 2929:       }
 2930:    }
 2931:    return -1;
 2932: }
 2933: 
 2934: 
 2935: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2936:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2937:                                     double *wind_rotate_angle, 
 2938:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2939:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2940:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2941:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2942:                                     double *drag, double *roughness) {
 2943: 
 2944:    NODE(pnode);  
 2945:    const int i = idx_node;
 2946:    Node &node(*pnode);
 2947: 
 2948:    node.idx = i;
 2949: 
 2950:    const int idxNodeStart = nodeNeighNodesStart[i];
 2951:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2952:    node.numNodes = idxNodeEnd - idxNodeStart;
 2953:    node.nodes = nodeNeighNodes + idxNodeStart;
 2954:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2955: 
 2956: 
 2957: 
 2958:    const int idxElemStart = nodeNeighElemsStart[i];
 2959:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2960:    node.numElements = idxElemEnd - idxElemStart;
 2961:    node.elements = nodeNeighElems + idxElemStart;
 2962: 
 2963:    
 2964:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2965:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2966:       const int partNode = localNodePart[idxNodeGlobal]; 
 2967:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2968: 
 2969:       Node *node_ptr = nodes[partNode] + idxNode;
 2970:       
 2971:       nodeNeighNodes[idx] = node_ptr;
 2972:    }
 2973: 
 2974: 
 2975:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2976:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2977:       const int partElem = localElemPart[idxElemGlobal];
 2978:       const int idxElem  = localElemIndices[idxElemGlobal];
 2979: 
 2980:       Element *elem_ptr = elems[partElem] + idxElem;
 2981: 
 2982:       nodeNeighElems[idx] = elem_ptr;
 2983:    }      
 2984: 
 2985: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 2986: 
 2987:    node.wind_angle = wind_rotate_angle[i];
 2988: 
 2989: 
 2990:    node.p.x   = node_coords[i * 3];
 2991:    node.p.y   = node_coords[i * 3 + 1];
 2992:    node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2993:    node.depth = node_coords[i * 3 + 2];
 2994: 
 2995:    node.numSides = 0;
 2996: 
 2997:    node.Cd = drag[i];
 2998:    node.rough = roughness[i];
 2999:    
 3000:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3001: 
 3002:    // Links the node to the boundary information
 3003:    if (isbnd[i] >= 0) {
 3004: 
 3005:      
 3006:       // Get the index of the node boundary
 3007:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3008: 
 3009:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3010:       node.nodeBnd->node = &node;
 3011: 
 3012:       node.nodeBnd->sideBnd1 = nullptr;
 3013:       node.nodeBnd->sideBnd2 = nullptr;
 3014: 
 3015:       if (isbnd[i]>=0) {
 3016: 
 3017:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3018:          
 3019:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3020:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3021: 
 3022:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3023:          node.nodeBnd->segment->clen  = nan("1");
 3024:          node.nodeBnd->segment->carea = nan("1");
 3025: 
 3026:       }
 3027: //          else {  XXXXXX
 3028: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3029: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3030: //          }
 3031:       
 3032: 
 3033:    }
 3034:    else {
 3035: 
 3036:       node.nodeBnd = nullptr; // For internal nodes
 3037: 
 3038:       if (isbnd[i] == landSegment) {
 3039:          node.nodeBnd = &landBoundaryNode;
 3040:          node.nodeBnd->segment = &landBoundarySegment;
 3041:       }
 3042:       // node.nodeBnd->node = &node;
 3043:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3044:       // // node.nodeBnd = nullptr;
 3045:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3046:       
 3047:    }
 3048: 
 3049:    // XXXX GAUSSIAN HILL VELOCITIES
 3050: #ifdef GAUSSIAN_HILL_VELOCITIES
 3051:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3052:       constexpr double rot_per = 3000.0;
 3053:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3054:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3055:    // XXXXX
 3056: #endif
 3057: 
 3058: }
 3059: 
 3060: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3061:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3062:                                     double *wind_rotate_angle,   
 3063:                                     int *isdel, int *isidenode, int *isbnd,
 3064:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3065:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3066:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3067:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3068:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3069:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3070:                                     double *drag, double *roughness) {
 3071: 
 3072: 
 3073:    SIDE(pside);
 3074:    Side &side(*pside);
 3075:    const int i = idx_side;
 3076: 
 3077:    side.idx = i;  
 3078:    
 3079:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3080:    const double fc   = 2.0*omega_e*sin(sfea0);
 3081:    const double beta = 2.0*omega_e*cos(sfea0);
 3082: 
 3083:    // finding the pointer to the nodes that form the side
 3084:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3085:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3086: 
 3087:    const int locidx_n1 = localNodeIndices[idx_n1];
 3088:    const int locidx_n2 = localNodeIndices[idx_n2];
 3089:    const int part_n1 =   localNodePart[idx_n1];
 3090:    const int part_n2 =   localNodePart[idx_n2];
 3091: 
 3092:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3093:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3094: 
 3095:    // Counts the number of sides connected to each node
 3096:    side.n1->numSides++;
 3097:    side.n2->numSides++;
 3098: 
 3099:    // Normal, unitary vector to the side
 3100:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3101:    side.n = normalize(side.n);
 3102: 
 3103:    // Side boundary type
 3104:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3105:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3106: 
 3107:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3108:    // If both nodes are on the boundary, then the side may be on the boundary
 3109:    {
 3110:       bool isLand = false;
 3111:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3112: 
 3113:       if (isbs > -1) {
 3114: 
 3115:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3116: 
 3117:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3118:          if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 3119:          else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 3120: 
 3121:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3122:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3123:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3124: 
 3125:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3126:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3127:          
 3128:          side.sideBnd->side = &side;
 3129: 
 3130:       }
 3131:       
 3132:    }
 3133:    else side.sideBnd = nullptr;
 3134: 
 3135: 
 3136: 
 3137:    // finding the pointer to the elements that share the side
 3138:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3139:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3140: 
 3141:    if (idx_e1 > -1) {
 3142:       const int locidx_e1 = localElemIndices[idx_e1];
 3143:       const int part_e1 =  localElemPart[idx_e1];
 3144:       side.elems[0] = elems[part_e1] + locidx_e1;
 3145: 
 3146:    }
 3147:    else {
 3148:       side.elems[0] = nullptr;
 3149:    }
 3150: 
 3151:    if (idx_e2 > -1) {
 3152:       const int locidx_e2 = localElemIndices[idx_e2];
 3153:       const int part_e2 =  localElemPart[idx_e2];
 3154:       side.elems[1] = elems[part_e2] + locidx_e2;
 3155:    }
 3156:    else {
 3157:       side.elems[1] = nullptr;
 3158:    }
 3159: 
 3160:    // Compute the center of the side
 3161:    side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3162: 
 3163:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3164:    side.shapiro = shapiro0;
 3165: 
 3166: #ifdef GAUSSIAN_HILL_VELOCITIES
 3167: // XXXX
 3168: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3169: constexpr double rot_per=3000.0;
 3170: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3171: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3172: // XXXXX      
 3173: #endif
 3174:    // Compute the z level at the center of the side
 3175:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3176: 
 3177:    // Compute the length of the side
 3178:    const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3179:    side.len = sqrt(dot(vLen, vLen));
 3180: 
 3181: 
 3182:    // Compute the Coriolis coefficient
 3183: 
 3184:    if constexpr(ncor == -1 || ncor == 0) {
 3185:       side.coriolis = coricoef;
 3186:    }
 3187:    else {
 3188:       const double sphi = side.lat();  // Latitude at the center of the side
 3189: 
 3190:       if constexpr(ics == 1) {
 3191:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3192:       }
 3193:       else {
 3194:          side.coriolis = 2.0*omega_e*sin(sphi);
 3195:       }
 3196:    }
 3197: }
 3198: 
 3199: 
 3200: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3201:    double *node_coords, double *node_coords_ll, bool use_ll,
 3202:    double *wind_rotate_angle,   
 3203:    int *isdel, int *isidenode, int *isbnd,
 3204:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3205:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3206:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3207:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3208:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3209:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3210:    double *drag, double *roughness) {
 3211: 
 3212:    ELEM(pelem);
 3213:    Element &elem(*pelem);
 3214:    const int i = idx_elem;
 3215:    
 3216:    elem.idx = i;
 3217: 
 3218:    for (int j = 0; j < i34[i]; j++) {
 3219:       const int idxNode = elnode[i*4 + j];  
 3220:       const int idxSide = elside[i*4 + j];
 3221:       
 3222:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3223:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3224: 
 3225: 
 3226:       // Find the neighboring element  
 3227:       if (elem.sides[j]->elems[0] == &elem) {
 3228:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3229:       }
 3230:       else {
 3231:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3232:       }
 3233:       
 3234:    }
 3235: 
 3236:    elem.i34 = i34[i];
 3237: 
 3238:    // Compute the centroid of the element and its depth
 3239:    Vector2 center = {0.0, 0.0};
 3240:    elem.depth = 0.0;
 3241:    for (int j = 0; j < i34[i]; j++) {
 3242:       center += elem.nodes[j]->p2()/i34[i];
 3243:       elem.depth  += elem.nodes[j]->p.z/i34[i];
 3244:    }
 3245:    elem.center = center;
 3246: 
 3247:    
 3248:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3249:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3250: 
 3251:    elem.area = elem.computeSignedArea(); 
 3252:    elem.radius = sqrt(elem.area)/pi; 
 3253:    
 3254:    // Determines which way the normal vector to each side is oriented.
 3255:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3256:    for (int j = 0; j < i34[i]; j++)  
 3257:    {
 3258:       if (elem.sides[j]->elems[0] == &elem) {
 3259:          elem.ssign[j] =  1.0;
 3260:       }
 3261:       else {
 3262:          elem.ssign[j] = -1.0;
 3263:       }
 3264: 
 3265:    }
 3266: 
 3267:    // Derivatives of shape functions
 3268:    //  For ics=2, this is done inside element/ll frame XXX
 3269:    //  For quads, the derivative is evaluated at centroid
 3270:    for (int j = 0; j < elem.i34; j++) {
 3271:       const double area = elem.area;
 3272:       const int id2 = elem.nxq(1 + j);
 3273:       const int id3 = elem.nxq(2 + j);
 3274:       const int id4 = elem.nxq(3 + j);
 3275:       if (elem.isTri()) {
 3276:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3277:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3278:          // da1/dx = (y1 - y2)/(2*area)
 3279:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3280:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3281:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3282:       }
 3283:       else  { // Quad; evaluate at centroid
 3284:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3285:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3286:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3287:       } // if Tri
 3288: 
 3289:    } // for j   
 3290:    
 3291:    
 3292: 
 3293: }
 3294: 
 3295: __device__ void Mesh::populateBoundaryNodes(int *nond, 
 3296:                                             double *emo, double *efa, 
 3297:                                             double *umo, double *ufa, 
 3298:                                             double *vmo, double *vfa) {
 3299: 
 3300:    NODE_BND(nodeBnd);
 3301:    const int idx = idx_node_bnd;                                             
 3302: 
 3303:    // Need to compute the segment index and the index of the node on the segment
 3304:    int sumNodes = 0;
 3305:    int iseg;
 3306:    for (iseg = 0; iseg < nope; iseg++) {
 3307:       // for each segment...
 3308:       sumNodes += nond[iseg];
 3309:       if (idx > sumNodes) break;
 3310:    }
 3311:    if (iseg == nope) iseg--;
 3312:    assert(idx <= sumNodes && "idx is out of bounds");
 3313:    sumNodes -= nond[iseg];
 3314: 
 3315:    const int ind  = idx - sumNodes;
 3316: if (idx > 1000) printf("iseg = %d of %d, ind = %d of %d, idx = %d, mesh->nbp = %d\n", iseg, nope, ind, nond[iseg], idx, mesh->nbp);
 3317: 
 3318: 
 3319:    nodeBnd->isEssentialBC = true;
 3320:    nodeBnd->elbc = 0.0;
 3321: 
 3322:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3323: 
 3324:       const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3325:       nodeBnd->efa[jfr] = efa[idx];
 3326:       nodeBnd->emo[jfr] = emo[idx];
 3327:       nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3328:       nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3329: 
 3330:    }
 3331:         
 3332: 
 3333: }
 3334: 
 3335: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3336:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3337:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3338:                 int *isdel, int *isidenode, int *isbnd,
 3339:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3340:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3341:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3342:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3343:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3344:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3345:                 double *drag, double *roughness,
 3346:                 double *emo, double *efa, 
 3347:                 double *umo, double *ufa, 
 3348:                 double *vmo, double *vfa) {
 3349: 
 3350:    // printf("Populating mesh for partition %d\n", partNum);
 3351: 
 3352:    // // Horizontal grid
 3353:    // printf("Processing %d nodes\n", np);   
 3354: 
 3355: 
 3356:    // // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3357:    // const double fc   = 2.0*omega_e*sin(sfea0);
 3358:    // const double beta = 2.0*omega_e*cos(sfea0);
 3359: 
 3360:    nbs = *sharedIdxSideBoundary;
 3361:    nbp = *sharedIdxNodeBoundary;
 3362: 
 3363: return;
 3364: 
 3365:    int idxNodeBoundary = 0;  
 3366: #ifdef popo      
 3367:    for (int i = 0; i < np; i++)
 3368:    {
 3369: printf("NODE i = %d, np = %d\n", i, np);      
 3370:       Node &node = localNodeData[i];
 3371: 
 3372:       node.idx = i;
 3373: 
 3374:       const int idxNodeStart = nodeNeighNodesStart[i];
 3375:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3376:       node.numNodes = idxNodeEnd - idxNodeStart;
 3377:       node.nodes = nodeNeighNodes + idxNodeStart;
 3378:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3379: 
 3380: 
 3381: 
 3382:       const int idxElemStart = nodeNeighElemsStart[i];
 3383:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3384:       node.numElements = idxElemEnd - idxElemStart;
 3385:       node.elements = nodeNeighElems + idxElemStart;
 3386: 
 3387: 
 3388:       
 3389:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3390:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3391:          const int partNode = localNodePart[idxNodeGlobal]; 
 3392:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 3393: 
 3394: 
 3395:          Node *node_ptr = nodes[partNode] + idxNode;
 3396:          
 3397:          nodeNeighNodes[idx] = node_ptr;
 3398:       }
 3399: 
 3400:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3401:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3402:          const int partElem = localElemPart[idxElemGlobal];
 3403:          const int idxElem  = localElemIndices[idxElemGlobal];
 3404: 
 3405:          Element *elem_ptr = elems[partElem] + idxElem;
 3406: 
 3407:          nodeNeighElems[idx] = elem_ptr;
 3408:       }      
 3409: 
 3410: 
 3411:       node.wind_angle = wind_rotate_angle[i];
 3412: 
 3413:       // Element **elements; // pointer to the elements connected to this node
 3414:       // int numElements;   // number of elements shared by this node
 3415: 
 3416:       node.p.x   = node_coords[i * 3];
 3417:       node.p.y   = node_coords[i * 3 + 1];
 3418:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 3419:       node.depth = node_coords[i * 3 + 2];
 3420: 
 3421:       node.numSides = 0;
 3422: 
 3423:       node.Cd = drag[i];
 3424:       node.rough = roughness[i];
 3425: printf("NODE idx = %d, Cd = %.16f, rough = %.16f\n", i, node.Cd, node.rough);
 3426:       for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3427: 
 3428:       // Links the node to the boundary information
 3429:       if (isbnd[i] >= 0) {
 3430:        
 3431:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3432:          node.nodeBnd->node = &node;
 3433: 
 3434:          node.nodeBnd->sideBnd1 = nullptr;
 3435:          node.nodeBnd->sideBnd2 = nullptr;
 3436: 
 3437:          if (isbnd[i]>=0) {
 3438: 
 3439:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3440:             
 3441:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3442:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3443: 
 3444:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3445:             node.nodeBnd->segment->clen  = nan("1");
 3446:             node.nodeBnd->segment->carea = nan("1");
 3447: 
 3448:          }
 3449: //          else {  XXXXXX
 3450: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3451: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3452: //          }
 3453:          
 3454:          idxNodeBoundary++;
 3455:       }
 3456:       else {
 3457:          node.nodeBnd = nullptr; // For internal nodes
 3458: 
 3459:          if (isbnd[i] == landSegment) {
 3460:             node.nodeBnd = &landBoundaryNode;
 3461:             node.nodeBnd->segment = &landBoundarySegment;
 3462:          }
 3463:          // node.nodeBnd->node = &node;
 3464:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3465:          // // node.nodeBnd = nullptr;
 3466:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3467:         
 3468:       }
 3469: 
 3470:       // XXXX GAUSSIAN HILL VELOCITIES
 3471: #ifdef GAUSSIAN_HILL_VELOCITIES
 3472:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3473:          constexpr double rot_per = 3000.0;
 3474:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3475:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3476:       // XXXXX
 3477: #endif
