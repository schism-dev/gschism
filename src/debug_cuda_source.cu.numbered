 8010: __global__ void returnMatrix(double *res) {
 8011:    // Debugging: returns the matrix as a CuPy array
 8012: 
 8013:    const int size = mesh->np;
 8014:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8015:       const Node *node = mesh->localNodeData + idx_node;
 8016:       res[idx_node*size + idx_node] = node->coeffDiag;
 8017:       for (int j = 0; j < node->numNodes; j++) {
 8018:          Node* nbNode = node->nodes[j];
 8019:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8020:       }
 8021: 
 8022:    }
 8023:    
 8024: }
