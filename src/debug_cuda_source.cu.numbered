  382: 
  383: struct Frame {
  384:    double _t[9]; // t stands for tensor.
  385: 
  386:    // Access the tensor in Fortran order
  387:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  388: 
  389:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  390: 
  391:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  392: 
  393:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  394:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  395:       sincos(ar2, &sin_ar2, &cos_ar2);
  396: 
  397:       t(0,0) = -sin_ar1;
  398:       t(1,0) =  cos_ar1;
  399:       t(2,0) =  0.0;
  400:       t(0,1) = -cos_ar1*sin_ar2;
  401:       t(1,1) = -sin_ar1*sin_ar2;
  402: 
  403:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  404: 
  405:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  406:       assert (ar4!=0.0 && "GRID: ar4=0");
  407: 
  408:       const double ar4_inv = 1.0/ar4;
  409:       t(0,1) = t(0,1)*ar4_inv;
  410:       t(1,1) = t(1,1)*ar4_inv;
  411:       t(2,1) = t(2,1)*ar4_inv;
  412: 
  413:       // The third vector is the cross product of the first two
  414:       crossProduct(t(0,0), t(1,0), t(2,0), 
  415:                    t(0,1), t(1,1), t(2,1), 
  416:                    t(0,2), t(1,2), t(2,2));
  417:    }
  418: 
  419: 
  420:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  421:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  422:    // Inputs:
  423:    //        vec0: vel. in this frame;
  424:    //        frameout: Output frame;
  425:    // Output: 
  426:    //        vec1: vel. in new frame  
  427: 
  428:       auto const fo = frameout;
  429:       Vector2 vec1;
  430: 
  431:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  432:       // of t and fo.t are the same.
  433:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  434:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  435: 
  436:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  437:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  438: 
  439:       return vec1;
  440:    }
  441: 
  442:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  443:       // Transform a vector from global to local frame
  444:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  445:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  446:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  447:    }
  448: 
  449:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  450:       // Transform a vector from local to global frame
  451:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  452:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  453:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  454:    }   
  455: 
  456:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  457:    // Tranforms a point from global to local frame     
  458:       G2L(pi - origin0, po);
  459:    }
  460: 
  461:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  462:    // Transforms a point from local to global frame      
  463:       L2G(pi, po);
  464:       po = po + origin0;
  465:    }
  466: 
  467: };
