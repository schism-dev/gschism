 4262: 
 4263:    __global__ void scaleGravity(double loadtide_coef) {
 4264: 
 4265: 
 4266:       NODE(node);
 4267: 
 4268:       // SAL option: scale gravity
 4269:       if constexpr(iloadtide==2) {  // simple const
 4270:          node->grav2 = grav*(1.0 - loadtide_coef);
 4271: 
 4272:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4273:         
 4274:           const double depth = max(node->depth, 0.0);
 4275:           const double tmp1 = sqrt(depth);
 4276:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4277:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4278:                              2.6969e-13*depth*depth*depth*tmp1;
 4279:           
 4280:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4281:           
 4282: 
 4283: 
 4284:           node->grav2 = grav*(1.0 - beta_bar);
 4285: 
 4286:       } else {  // iloadtide=0,1
 4287:         node->grav2=grav;
 4288: 
 4289:       }
 4290: 
 4291:    }
