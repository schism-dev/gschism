  867: 
  868: // ----------------------------- Frames -----------------------------
  869: 
  870: // Frames are used to transform vectors between different coordinate systems.
  871: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  872: template<int ICS>
  873: struct Frame {};
  874: 
  875: template<>
  876: struct Frame<1> {
  877:    __forceinline__ __device__ void update(double, double) {}
  878:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  879:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  880:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  881:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  882:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  883:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  884: };
  885: 
  886: template<>
  887: struct Frame<2> {
  888:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  889:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  890:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  891:     double t00, t10;        // col0 (t20=0 implicit)
  892:     double t01, t11, t21;   // col1
  893: 
  894:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  895: 
  896:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  897:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  898: 
  899:       double sin_lon, cos_lon, sin_lat, cos_lat;
  900:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  901:       sincos(lat, &sin_lat, &cos_lat);
  902: 
  903:       t00 = -sin_lon;
  904:       t10 =  cos_lon;
  905:       t01 = -cos_lon*sin_lat;
  906:       t11 = -sin_lon*sin_lat;
  907:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  908: 
  909:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  910:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  911: 
  912:       const double col1_norm_inv = 1.0/col1_norm;
  913:       t01 = t01*col1_norm_inv;
  914:       t11 = t11*col1_norm_inv;
  915:       t21 = t21*col1_norm_inv;
  916: 
  917:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  918: 
  919: 
  920:    }
  921: 
  922:    __forceinline__ __device__ void print(void) const {
  923:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  924:    }
  925: 
  926:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  927:       // cross(col0, col1), with t20=0 implicitly:
  928:       // |  i       j       k   |
  929:       // | t00     t10      0   |
  930:       // | t01     t11     t21  |
  931:       t02 =  t10*t21;
  932:       t12 = -t00*t21;
  933:       t22 =  t00*t11 - t10*t01;
  934:    }
  935: 
  936: 
  937:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  938:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  939:    // Inputs:
  940:    //        vec0: vel. in this frame;
  941:    //        frameout: Output frame;
  942:    // Output: 
  943:    //        vel. in new frame  
  944:    //
  945:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  946:    // discarding the z-component of the result to keep only the local horizontal
  947:    // plane of frame 2.
  948:    //
  949:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  950:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  951:    // are orthogonal. This product is computed as dot products between columns of
  952:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  953:    // columns of F2.// 
  954: 
  955:       auto const fo = frameout; // Just an alias for the output frame.
  956:       Vector2 res;
  957: 
  958:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  959:       // of t and fo.t are the same.
  960:       const double d00 = t00*fo.t00 + t10*fo.t10;
  961:       const double d10 = t01*fo.t00 + t11*fo.t10;
  962: 
  963:       const double d01 = t00*fo.t01 + t10*fo.t11;
  964:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  965: 
  966:       res.x = vec0.x * d00 + vec0.y * d10;
  967:       res.y = vec0.x * d01 + vec0.y * d11;
  968: 
  969:       return res;
  970:    }
  971: 
  972:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  973:       Vector3 vo;
  974:       double t02, t12, t22;
  975: 
  976:       // Compute the 3rd column of the frame tensor
  977:       getCol2(t02, t12, t22);
  978: 
  979:       vo.x = vi.x*t00 + vi.y*t10;
  980:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  981:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  982: 
  983:       return vo;
  984:    
  985:    }
  986: 
  987:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  988:       Vector3 vo;
  989:       double t02, t12, t22;
  990: 
  991:    // Compute the 3rd column of the frame tensor
  992:       getCol2(t02, t12, t22);
  993: 
  994:       // F * vi (non-transposed, so we use rows of F)
  995:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  996:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  997:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  998: 
  999:       return vo;
 1000:    }
 1001: 
 1002:    // Unit vectors that define the local frame
 1003:    __forceinline__ __device__ Vector3 nUp(void) const {
 1004:       // Column 2 = cross(column0, column1)
 1005:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
 1006:    }
 1007: 
 1008:    __forceinline__ __device__ Vector3 nZonal(void) const {
 1009:       // Column 0
 1010:       return { t00, t10, 0.0 };
 1011:    }
 1012: 
 1013:    __forceinline__ __device__ Vector3 nMeridional(void) const {
 1014:       // Column 1
 1015:       return { t01, t11, t21 };
 1016:    }
 1017: 
 1018: };
 1019: 
