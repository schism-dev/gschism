 1574: // Helper functions for computing the local node index at a given offset from another.
 1575: __device__ __inline__ int nxq(int offset, int index, int size) {
 1576:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1577:    // to the index to make it positive
 1578:    assert(index + offset + 16*size >= 0);
 1579:    return (index + offset + 16*size) % size;  
 1580: }
 1581: 
 1582: __device__ __inline__ int nxq(int index, int size) {
 1583:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1584:    // to the index to make it positive
 1585:    assert(index + 16*size >= 0);
 1586:    return (index + 16*size) % size; 
 1587: }
