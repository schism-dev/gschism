 3890: __device__ __forceinline__ int Node::localIndex() const {
 3891:    // Returns the local index of the node in the partition
 3892:    // Local index is just the offset from the start of the partition's node memory
 3893:    return int(this - mesh->nodes[part]);
 3894: }
