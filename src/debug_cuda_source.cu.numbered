 1488:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1489:       // Compute the different time ramps used in the code 
 1490:       // This function is performed by just one thread
 1491: 
 1492:       if constexpr(ibc == 0) {
 1493:          if (drampbc > 0.0) {
 1494:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1495:          } else {
 1496:             rampbc = 1.0;
 1497:          }
 1498: 
 1499:          if (nws != 0 && drampwind > 0.0) {
 1500:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1501:          } else {
 1502:             rampwind = 1.0;
 1503:          }
 1504:       }
 1505: 
 1506:       if (drampwafo > 0.0) {
 1507:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1508:       } else {
 1509:          rampwafo = 1.0;
 1510:       }
 1511: 
 1512:       // For source/sinks
 1513:       if (if_source && dramp_ss > 0.0) {
 1514:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1515:       } else {
 1516:          ramp_ss = 1.0;
 1517:       }
 1518: 
 1519:       if (dramp > 0.0) {
 1520:          ramp = tanh(2.0*time/86400.0/dramp);
 1521:       } else {
 1522:          ramp = 1.0;
 1523:       }
 1524: 
 1525:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1526:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1527:    }
 1528:       
 1529: 
 1530:    __global__ void computeBedDeformation(void) {
 1531:       printf("NOT IMPLEMENTED: computeBedDeformation\n");
 1532: 
 1533:    }
