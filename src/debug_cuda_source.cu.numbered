 3391: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3392:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3393:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3394: 
 3395: 
 3396:    NODE(node1);
 3397: 
 3398:    node1->clearMatrixRow();
 3399:    node1->qel = 0.0;
 3400: 
 3401:    // THIS IS FOR STRUCTURES XXX
 3402:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3403: 
 3404:    
 3405:    for (int j=0; j<node1->numElements; j++) {
 3406:       // For each element connected to the node...
 3407: 
 3408:       Element *elem = node1->elements[j];
 3409: 
 3410: // if (elem->isDry) continue;  /// XXXX KKKKKK NOT IN THE ORIGINAL CODE
 3411: 
 3412: 
 3413:       // Compute the average gravity
 3414:       const double grav3 = elem->mean(&Node::grav2);
 3415: 
 3416:       // Look at the documentation for the description of the terms in the following integrals
 3417: 
 3418:       // Integral I_1 
 3419:       // \bar{\breve{H}} 
 3420:       const double hhatb = elem->mean(&Side::hhat);        
 3421: 
 3422:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3423: 
 3424:       const int id1 = elem->nodeLocalIdx(node1); 
 3425:       const double area = elem->area;
 3426: 
 3427:       if (elem->isTri()) {
 3428: 
 3429:          // To clarify the notation in this section: 
 3430:          //   i stands for the node under consideration (node1)
 3431:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3432:          const int id2 = elem->nxq(1 + id1);
 3433:          const int id3 = elem->nxq(2 + id1);
 3434:          Node *node2 = elem->nodes[id2];
 3435:          Node *node3 = elem->nodes[id3];
 3436: 
 3437:          const Point2 x1 = node1->p;
 3438:          const Point2 x2 = node2->p;
 3439:          const Point2 x3 = node3->p;
 3440: 
 3441:          // integral of phi_i*phi_j
 3442:          const double ipp_ii = (1.0/6.0 )*area;
 3443:          const double ipp_ij = (1.0/12.0)*area;
 3444:          const double ipp_ik = (1.0/12.0)*area;
 3445: 
 3446:          // integral of [(grad phi_i) * (grad phi_j)]
 3447:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3448:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3449:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3450: 
 3451:          // Computes the different components of integral I_1 of each node with respect to node i.
 3452:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3453:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3454:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3455: 
 3456:          node1->addToSparseMatrix(node1, I1_ii);
 3457:          node1->addToSparseMatrix(node2, I1_ij); 
 3458:          node1->addToSparseMatrix(node3, I1_ik);
 3459: 
 3460:       }
 3461:       else { // Quad
 3462:          // XXX IMPLEMENT THIS
 3463:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3464: 
 3465:          // To clarify the notation in this section: 
 3466:          //   i stands for the node under consideration (node1)
 3467:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3468:          const int id2 = elem->nxq(1 + id1);
 3469:          const int id3 = elem->nxq(2 + id1);
 3470:          const int id4 = elem->nxq(3 + id1);
 3471:          Node *node2 = elem->nodes[id2];
 3472:          Node *node3 = elem->nodes[id3];
 3473:          Node *node4 = elem->nodes[id4];         
 3474: 
 3475:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3476:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3477:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3478:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3479:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3480: 
 3481:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3482:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3483:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3484:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3485:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3486: 
 3487:          // Computes the different components of integral I_1 of each node with respect to node i.
 3488:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3489:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3490:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3491:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3492: 
 3493:          node1->addToSparseMatrix(node1, I1_ii);
 3494:          node1->addToSparseMatrix(node2, I1_ij); 
 3495:          node1->addToSparseMatrix(node3, I1_ik);
 3496:          node1->addToSparseMatrix(node4, I1_il);
 3497:   
 3498:       } 
 3499: 
 3500:  
 3501:       // Integral I_4
 3502:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3503:       // Where
 3504:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3505: 
 3506:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3507:       // of U over the element.
 3508:       Vector2 U = {0.0, 0.0};
 3509:       for (int m=0; m < elem->i34; m++) {      
 3510:          const Side *side = elem->sides[m];
 3511: 
 3512:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3513:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3514:       }
 3515:       U = U/elem->i34;
 3516: 
 3517: 
 3518:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3519: 
 3520: 
 3521:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3522:       const double I_4_1 = dot(gradPhi_1, U);
 3523: 
 3524: 
 3525:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3526:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3527: 
 3528:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3529: 
 3530:       // Additional terms 
 3531:       double vnorm = 0.0;
 3532:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3533:          Vector3 ubed = {0.0, 0.0, 0.0};
 3534:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3535: 
 3536:          Vector3 gradP = {0.0, 0.0, 1.0};
 3537:          for (int m=0; m < elem->i34; m++) {
 3538:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3539:            gradP += toVector3(gradP_2D, 0.0);
 3540:          }   
 3541:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3542:       } // imm==2
 3543: 
 3544:       if (elem->isTri()) {
 3545:          for (int l=0; l<3; l++) {
 3546: 
 3547:             Node *node = elem->nodes[l];
 3548: 
 3549:             double fac = (node == node1) ? 2.0 : 1.0;
 3550:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3551:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3552:            
 3553:          }
 3554: 
 3555: 
 3556:          if (!elem->isDry) {
 3557:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3558: 
 3559:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3560: 
 3561:          }
 3562: 
 3563:       } // isTri
 3564:       else { // isQuad
 3565:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3566:          // for (int l=0; l<4; l++) {
 3567:          //   const Node *node = elem->nodes[l];
 3568: 
 3569:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3570:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3571: 
 3572:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3573:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3574:          // }
 3575: 
 3576:       } // isQuad
 3577: 
 3578: 
 3579:      node1->qel += (dt/elem->i34)*elem->vsource;
 3580:       
 3581: 
 3582:    } // for all elements connected to the node
 3583:    
 3584: 
 3585:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3586:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3587:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3588:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3589:       // If it is an open boundary node...
 3590: 
 3591:       // At least one open bnd side, maybe two
 3592:       for (int l=0; l<2; l++) { 
 3593: 
 3594:          // Gets each of the sides sharing the node. 
 3595:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3596: 
 3597:        
 3598: 
 3599:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3600:          if (sideBnd != nullptr) {
 3601:             // If the side is on a boundary...
 3602: 
 3603:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3604: 
 3605:             // Get the boundary segment
 3606:             const BoundarySegment *sideSegment = sideBnd->segment;
 3607:             const Side *side = sideBnd->side;
 3608: 
 3609:             // Integral I_3
 3610:             if (sideSegment->ifltype != 0) {
 3611:             // Natural or Flather b.c.
 3612: 
 3613:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3614:                // especially for Flather b.c.
 3615:                double ri3 = 0.0;
 3616:                if (!side->isDry) {
 3617:                   // If the side is not dry
 3618:                   
 3619:                   // Computes the side flux of (uth, vth)
 3620:                   double Vn = 0.0;
 3621:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3622:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3623:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3624: 
 3625:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3626:                   }
 3627: 
 3628:                   ri3 = 0.5*side->len*Vn;
 3629:                }
 3630: 
 3631:                if (sideSegment->ifltype == -1) { // Flather 1
 3632: 
 3633:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3634:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3635: 
 3636:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3637:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3638:                   
 3639:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3640:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3641: 
 3642:                } 
 3643:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3644:                   // Reset ri3
 3645:                   ri3 = 0.0;
 3646: 
 3647:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3648: 
 3649:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3650: 
 3651:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3652:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3653: 
 3654:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3655:                   node1->addToSparseMatrix(node1, con0*2.0);
 3656:                   node1->addToSparseMatrix(node2, con0);
 3657: 
 3658:                } // if Flather or Discharge
 3659: 
 3660:                node1->qel -= thetai*dt*ri3;
 3661: 
 3662: 
 3663:             } // I_3
 3664:           
 3665: 
 3666:             // Integral I_5
 3667:             if(!side->isDry) {
 3668: 
 3669:                const double Unbar = dot(side->U, side->n);
 3670:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3671: 
 3672:             } // I_5
 3673: 
 3674:          } // if is boundary side
 3675: 
 3676:       } // for l
 3677: 
 3678:    } // if isbnd
 3679: 
 3680: 
 3681: }
 3682: 
 3683: 
 3684: 
 3685: extern "C" {
 3686:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3687:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3688:                                   int* indices, int* indptr) {
 3689: 
 3690:       NODE(node);
 3691:       
 3692:       const int idx = node->idx;
 3693:       
 3694:       // Computes the index in the nzz array      
 3695:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3696: 
 3697: 
 3698:       indptr[idx] = nzzIdx;
 3699:       indices[nzzIdx] = idx;
 3700: 
 3701:       data_d[nzzIdx]    = node->coeffDiag;
 3702:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3703: 
 3704:       diag_d[idx] = 1.0/node->coeffDiag;
 3705:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3706: 
 3707:       b_d[idx] = node->qel;
 3708:       b_f[idx] = (float)node->qel;
 3709: 
 3710:       for (int k = 0; k < node->numNodes; ++k) {
 3711:          const Node* nb = node->nodes[k];
 3712: 
 3713:          const int j = nb->idx;
 3714: 
 3715:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3716:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3717: 
 3718:          indices[nzzIdx + k + 1] = j;
 3719:       }
 3720: 
 3721: 
 3722:    }
