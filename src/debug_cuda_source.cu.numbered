 8231: #ifdef OLD_PCG_SOLVER
 8232: __global__ void computeMatrixProductAndDotProducts() {
 8233:    // Computes A*p, r'Mr and p'Ap
 8234: 
 8235:    // 1) shared buffer: first half for rMr, second for pAp
 8236:    __shared__ double sdata[2*BLOCK_SIZE];
 8237:    double* s_rMr = sdata;
 8238:    double* s_pAp = sdata + BLOCK_SIZE;
 8239: 
 8240:    const int tid = threadIdx.x;
 8241: 
 8242:    double l_pAp = 0.0;
 8243: 
 8244:    s_rMr[tid] = 0.0;
 8245:    s_pAp[tid] = 0.0;
 8246: 
 8247:    // 2) get your node pointer
 8248:    // NODE(node);   
 8249:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8250:    Node *node = &(mesh->localNodeData[idx_node]); 
 8251:       if (idx_node < mesh->np) {
 8252: 
 8253:       const double diag = node->coeffDiag;
 8254:       const double r    = node->mR;
 8255:       const double p    = node->mP;  
 8256: 
 8257:       // apply preconditioner on the fly:
 8258:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8259: 
 8260:       // 4) compute Ap = A.p
 8261:       double Ap = node->coeffDiag * node->mP;
 8262:       for (int j = 0; j < node->numNodes; ++j) {
 8263:          const Node *nbNode = node->nodes[j];
 8264:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8265: 
 8266:       }
 8267: 
 8268:       node->mAp = Ap;
 8269:       
 8270: 
 8271:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8272:       // const double l_rMr = r*Mr;  // r'Mr
 8273:       l_pAp = p*Ap;  // p'Ap
 8274: 
 8275: 
 8276:    }
 8277: 
 8278:    // 6) write into shared mem
 8279:    // s_rMr[tid] = l_rMr;
 8280:    s_pAp[tid] = l_pAp;
 8281: 
 8282:    __syncthreads();
 8283: 
 8284:    // 7) block-wide tree reduction
 8285:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8286:       if (tid < stride)  {
 8287:          s_pAp[tid] += s_pAp[tid + stride];
 8288:       }
 8289:       __syncthreads();
 8290:    }
 8291: 
 8292:    // 8) thread 0 atomically accumulates into the globals
 8293:    // XXX: This is slower than it needs to be, but it is simple and works
 8294:    if (tid == 0) {
 8295:       atomicAdd(pAp, s_pAp[0]);
 8296:    }
 8297: 
 8298: 
 8299: }
 8300: 
 8301: 
 8302: __global__ void updateSolutionAndDotProducts(void) {
 8303:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8304: 
 8305:    const int tid = threadIdx.x;
 8306: 
 8307:    s_rMr[tid] = 0.0;
 8308: 
 8309:    // get node & bounds-check:
 8310:    NODE(node);
 8311: 
 8312:    
 8313:    // Compute alpha
 8314:    const double alpha = (*rMr_old)/(*pAp); 
 8315: 
 8316: 
 8317:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8318: 
 8319: 
 8320:    // load scalars
 8321:    const double diag = node->coeffDiag;
 8322:    const double p    = node->mP;
 8323:    const double Ap   = node->mAp;
 8324:    const double x    = node->mX;
 8325:    const double r    = node->mR;
 8326:    
 8327:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8328: 
 8329:    // 1) update solution & residual
 8330:    const double x_new = x + alpha*p;
 8331:    const double r_new = r - alpha*Ap;
 8332:    node->mX = x_new;
 8333:    node->mR = r_new;
 8334: 
 8335:    // 2) apply Jacobi preconditioner on the fly
 8336:    const double Mr_new = r_new/diag;
 8337: 
 8338: 
 8339:    // 3) local contributions for the two dot-products
 8340:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8341: 
 8342:    // 4) write into shared-mem
 8343:    s_rMr[tid] = l_rMr;
 8344: 
 8345:    __syncthreads();
 8346: 
 8347: 
 8348:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8349:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8350:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8351:       __syncthreads();
 8352:    }
 8353: 
 8354:    // 6) thread 0 atomically folds into the global accumulators
 8355:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8356: 
 8357: 
 8358: }
 8359: 
 8360: 
 8361: __global__ void updateSearchDirection() {
 8362: 
 8363:     NODE(node);
 8364: 
 8365:     // recompute z on-the-fly
 8366:     const double z = node->mR / node->coeffDiag;
 8367:     const double p = node->mP;
 8368: 
 8369:     const double beta = (*rMr_new)/(*rMr_old);
 8370: 
 8371: 
 8372:     // p =z + beta*p
 8373:     node->mP = z + beta*p;
 8374: 
 8375: }
 8376: 
 8377: __global__ void initializeScalars(double *scalars) {
 8378: 
 8379:    // These point to a cupy array in the host code
 8380:    rMr_old = scalars + 0;
 8381:    rMr_new = scalars + 1;
 8382:    pAp     = scalars + 2;
 8383: }
 8384: 
 8385: __global__ void initializePreconditionedResidual(void) {
 8386: 
 8387:     __shared__ double s_rMr[BLOCK_SIZE];  
 8388: 
 8389:     s_rMr[threadIdx.x] = 0.0;
 8390: 
 8391:     NODE_ALL(node, valid);
 8392:     const int tid = threadIdx.x;
 8393:     // For the first iteration:
 8394:     // 1. Initial solution x = 0 (already set)
 8395:     // 2. Initial residual r = b (stored in qel)
 8396:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8397: 
 8398: // XXX we should use the guess solution here    
 8399: 
 8400:     double l_rMr = 0.0;
 8401:     if (valid) {
 8402:       // Set initial residual r = b (from qel)
 8403:       node->mR = node->qel;
 8404: 
 8405:       // Compute z = M^-1 * r (preconditioned residual)
 8406:       const double z = node->mR / node->coeffDiag;
 8407: 
 8408:       // Set initial search direction p = z
 8409:       node->mP = z;
 8410: 
 8411:       // Initialize other variables needed for CG
 8412:       node->mX = 0.0;  // Initial solution
 8413:       node->mAp = 0.0; // Will be computed in first iteration
 8414: 
 8415: 
 8416:       // Computes the first r'Mr (reduction)
 8417:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8418:     }
 8419:     // 4) write into shared-mem
 8420:     s_rMr[tid] = l_rMr;
 8421: 
 8422:     __syncthreads();
 8423: 
 8424: 
 8425:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8426:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8427:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8428:         __syncthreads();
 8429:     }
 8430: 
 8431:     // 6) thread 0 atomically folds into the global accumulators
 8432:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8433: 
 8434:     *rMr_old = 0.0;
 8435:     *pAp = 0.0;
 8436: }
 8437: #endif
 8438: 
