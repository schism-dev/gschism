 8181: #ifdef OLD_PCG_SOLVER
 8182: __global__ void computeMatrixProductAndDotProducts() {
 8183:    // Computes A*p, r'Mr and p'Ap
 8184: 
 8185:    // 1) shared buffer: first half for rMr, second for pAp
 8186:    __shared__ double sdata[2*BLOCK_SIZE];
 8187:    double* s_rMr = sdata;
 8188:    double* s_pAp = sdata + BLOCK_SIZE;
 8189: 
 8190:    const int tid = threadIdx.x;
 8191: 
 8192:    double l_pAp = 0.0;
 8193: 
 8194:    s_rMr[tid] = 0.0;
 8195:    s_pAp[tid] = 0.0;
 8196: 
 8197:    // 2) get your node pointer
 8198:    // NODE(node);   
 8199:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8200:    Node *node = &(mesh->localNodeData[idx_node]); 
 8201:       if (idx_node < mesh->np) {
 8202: 
 8203:       const double diag = node->coeffDiag;
 8204:       const double r    = node->mR;
 8205:       const double p    = node->mP;  
 8206: 
 8207:       // apply preconditioner on the fly:
 8208:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8209: 
 8210:       // 4) compute Ap = A.p
 8211:       double Ap = node->coeffDiag * node->mP;
 8212:       for (int j = 0; j < node->numNodes; ++j) {
 8213:          const Node *nbNode = node->nodes[j];
 8214:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8215: 
 8216:       }
 8217: 
 8218:       node->mAp = Ap;
 8219:       
 8220: 
 8221:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8222:       // const double l_rMr = r*Mr;  // r'Mr
 8223:       l_pAp = p*Ap;  // p'Ap
 8224: 
 8225: 
 8226:    }
 8227: 
 8228:    // 6) write into shared mem
 8229:    // s_rMr[tid] = l_rMr;
 8230:    s_pAp[tid] = l_pAp;
 8231: 
 8232:    __syncthreads();
 8233: 
 8234:    // 7) block-wide tree reduction
 8235:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8236:       if (tid < stride)  {
 8237:          s_pAp[tid] += s_pAp[tid + stride];
 8238:       }
 8239:       __syncthreads();
 8240:    }
 8241: 
 8242:    // 8) thread 0 atomically accumulates into the globals
 8243:    // XXX: This is slower than it needs to be, but it is simple and works
 8244:    if (tid == 0) {
 8245:       atomicAdd(pAp, s_pAp[0]);
 8246:    }
 8247: 
 8248: 
 8249: }
 8250: 
 8251: 
 8252: __global__ void updateSolutionAndDotProducts(void) {
 8253:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8254: 
 8255:    const int tid = threadIdx.x;
 8256: 
 8257:    s_rMr[tid] = 0.0;
 8258: 
 8259:    // get node & bounds-check:
 8260:    NODE(node);
 8261: 
 8262:    
 8263:    // Compute alpha
 8264:    const double alpha = (*rMr_old)/(*pAp); 
 8265: 
 8266: 
 8267:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8268: 
 8269: 
 8270:    // load scalars
 8271:    const double diag = node->coeffDiag;
 8272:    const double p    = node->mP;
 8273:    const double Ap   = node->mAp;
 8274:    const double x    = node->mX;
 8275:    const double r    = node->mR;
 8276:    
 8277:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8278: 
 8279:    // 1) update solution & residual
 8280:    const double x_new = x + alpha*p;
 8281:    const double r_new = r - alpha*Ap;
 8282:    node->mX = x_new;
 8283:    node->mR = r_new;
 8284: 
 8285:    // 2) apply Jacobi preconditioner on the fly
 8286:    const double Mr_new = r_new/diag;
 8287: 
 8288: 
 8289:    // 3) local contributions for the two dot-products
 8290:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8291: 
 8292:    // 4) write into shared-mem
 8293:    s_rMr[tid] = l_rMr;
 8294: 
 8295:    __syncthreads();
 8296: 
 8297: 
 8298:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8299:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8300:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8301:       __syncthreads();
 8302:    }
 8303: 
 8304:    // 6) thread 0 atomically folds into the global accumulators
 8305:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8306: 
 8307: 
 8308: }
 8309: 
 8310: 
 8311: __global__ void updateSearchDirection() {
 8312: 
 8313:     NODE(node);
 8314: 
 8315:     // recompute z on-the-fly
 8316:     const double z = node->mR / node->coeffDiag;
 8317:     const double p = node->mP;
 8318: 
 8319:     const double beta = (*rMr_new)/(*rMr_old);
 8320: 
 8321: 
 8322:     // p =z + beta*p
 8323:     node->mP = z + beta*p;
 8324: 
 8325: }
 8326: 
 8327: __global__ void initializeScalars(double *scalars) {
 8328: 
 8329:    // These point to a cupy array in the host code
 8330:    rMr_old = scalars + 0;
 8331:    rMr_new = scalars + 1;
 8332:    pAp     = scalars + 2;
 8333: }
 8334: 
 8335: __global__ void initializePreconditionedResidual(void) {
 8336: 
 8337:     __shared__ double s_rMr[BLOCK_SIZE];  
 8338: 
 8339:     s_rMr[threadIdx.x] = 0.0;
 8340: 
 8341:     NODE_ALL(node, valid);
 8342:     const int tid = threadIdx.x;
 8343:     // For the first iteration:
 8344:     // 1. Initial solution x = 0 (already set)
 8345:     // 2. Initial residual r = b (stored in qel)
 8346:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8347: 
 8348: // XXX we should use the guess solution here    
 8349: 
 8350:     double l_rMr = 0.0;
 8351:     if (valid) {
 8352:       // Set initial residual r = b (from qel)
 8353:       node->mR = node->qel;
 8354: 
 8355:       // Compute z = M^-1 * r (preconditioned residual)
 8356:       const double z = node->mR / node->coeffDiag;
 8357: 
 8358:       // Set initial search direction p = z
 8359:       node->mP = z;
 8360: 
 8361:       // Initialize other variables needed for CG
 8362:       node->mX = 0.0;  // Initial solution
 8363:       node->mAp = 0.0; // Will be computed in first iteration
 8364: 
 8365: 
 8366:       // Computes the first r'Mr (reduction)
 8367:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8368:     }
 8369:     // 4) write into shared-mem
 8370:     s_rMr[tid] = l_rMr;
 8371: 
 8372:     __syncthreads();
 8373: 
 8374: 
 8375:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8376:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8377:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8378:         __syncthreads();
 8379:     }
 8380: 
 8381:     // 6) thread 0 atomically folds into the global accumulators
 8382:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8383: 
 8384:     *rMr_old = 0.0;
 8385:     *pAp = 0.0;
 8386: }
 8387: #endif
 8388: 
 8389: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8390: 
 8391:    ELEM(elem);
 8392: 
 8393:    switch (varCode) {
 8394:       case (int)VarCode::outputCoords:
 8395:          const Point2 coords = elem->outputCoords();
 8396:          res[elem->idx*2    ] = coords.x;
 8397:          res[elem->idx*2 + 1] = coords.y;
 8398:          break;
 8399:    }
 8400: }
