 3724:    __global__ void solverCopyResult(double* x) {
 3725:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3726:       NODE(node);
 3727:       const int idx = node->idx;
 3728: 
 3729:       node->mX = x[idx];
 3730:    }
