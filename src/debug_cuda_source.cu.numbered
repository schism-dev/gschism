 4370:    __global__ void computeFlowBcVelocities(double time) {
 4371: 
 4372:       SIDE_BND(sideBnd);
 4373: 
 4374:       const Side *side = sideBnd->side;
 4375:  
 4376:       const bool isDry = side->isDry;
 4377:       const bool isLand = sideBnd->segment->isLand;
 4378: 
 4379:    
 4380:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4381: 
 4382:       if (isDry || isLand) return;
 4383: 
 4384:       // For wet sides in open boundaries...
 4385:       const Vector2 n = side->n;
 4386:       const BoundarySegment *segment = sideBnd->segment;
 4387: 
 4388:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4389: 
 4390:       const int ifltype = segment->ifltype;
 4391: 
 4392:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4393:       const Vector2 r_nuth0 = r_uth0*n;
 4394: 
 4395: 
 4396:       if (ifltype == 1 || ifltype == 2) {
 4397:       
 4398:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4399: 
 4400:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4401:          
 4402:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4403:          
 4404:       } else if (ifltype == -1) { // Flather 1
 4405: 
 4406:          for (int k = 0; k < nvrt; k++) {
 4407: 
 4408:             // uth is the normal vel.; no ramp up
 4409:             const double uth = sideBnd->nuth(k);
 4410:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4411: 
 4412:             sideBnd->ubc[k] += uth*n;
 4413:          }
 4414: 
 4415:       } else if (ifltype == 3 || ifltype == 5) {
 4416:          // vnth0=0 !normal vel.
 4417: 
 4418:          Vector2 r_u1_bar = {0.0, 0.0};
 4419:          // Computes the contribution to the velocity from all tide frequencies
 4420:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4421: 
 4422:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4423:             const Vector2 umo  = sideBnd->umo(jfr); 
 4424: 
 4425:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4426:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4427:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4428:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4429: 
 4430:          }
 4431: 
 4432: 
 4433:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4434: 
 4435:       } // if (ifltype = 3 || ifltype == 5
 4436: 
 4437: 
 4438: 
 4439:    }
 4440: 
 4441:    __global__ void computeElevationBoundaryConditions(double time) {
 4442:       // Compute elevation essential boundary conditions 
 4443: 
 4444:       NODE_BND(nodeBnd); // Each boundary node.
 4445: 
 4446:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4447: 
 4448:       const Node *node = nodeBnd->node;
 4449:       const BoundarySegment *segment = nodeBnd->segment;
 4450:       const int iettype = segment->iettype;
 4451:       
 4452: 
 4453:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4454:       double eic = 0.0;
 4455:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4456:       else                 eic = 0.0;
 4457: 
 4458:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4459:       const double r_eth = ramp*nodeBnd->eth;
 4460:       double r_eta1_bar = 0.0;
 4461: 
 4462: 
 4463:       // Compute tide elevation
 4464:       if (iettype == 3 || iettype == 5) {   
 4465: 
 4466:          if constexpr(iloadtide==1) { // loading tide
 4467:             assert(false && "Loading tide not implemented");
 4468:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4469:          }
 4470:          
 4471:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4472: 
 4473:             const double efa  = nodeBnd->efa[jfr]; 
 4474:             const double emo  = nodeBnd->emo[jfr]; 
 4475: 
 4476:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4477:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4478:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4479: 
 4480:          } // for jfr
 4481: 
 4482:       } // if iettype
 4483: 
 4484:       switch (iettype) {
 4485:          case 1:
 4486:          case 2:
 4487:          case 4:
 4488:             nodeBnd->elbc = r_eic + r_eth;
 4489:             break;
 4490:          case 3:
 4491:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4492:             break;
 4493:          case 5:
 4494:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4495:             break;
 4496:       } // switch
 4497: 
 4498: 
 4499:       //Add inverse barometric effects
 4500:       if (iettype != 0 && inv_atm_bnd == 1) {
 4501:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4502:       }
 4503: 
 4504:    }
 4505: 
 4506: 
 4507:    __global__ void computeHorizontalViscosity(void) { 
 4508: 
 4509:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4510: 
 4511:       SIDE(side);
 4512: 
 4513:       if (side->isDry) return;
 4514: 
 4515:       for (int k = 0; k < nvrt; k++) {
 4516:          side->nuGradU[k] = {0.0, 0.0};
 4517:       }
 4518: 
 4519:       if constexpr(ihorcon == 1) {
 4520:          for (int k = side->kb; k < nvrt - 1; k++) {
 4521:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4522:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4523:             // By Zhang and Baptista.
 4524: 
 4525:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4526:             // This is a standard discretization of the Laplacian operator.
 4527:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4528:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4529:             // Gamma is hvis_coef0 in the code.
 4530:             // The value of gamma needs to be < 0.5.
 4531: 
 4532:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4533:             // side under consideration in each of the two possible elements that share the side.
 4534:             Vector2 sumU = {0.0, 0.0};
 4535:             for (int l = 0; l < 2; l++) {
 4536:                const Element *elem = side->elems[l];
 4537: 
 4538:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4539: 
 4540:                // Find the local index of the side in the element
 4541:                const int idxSide = elem->sideLocalIdx(side);
 4542: 
 4543:                // Find the two sides that are connected to the side under consideration
 4544:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4545:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4546: 
 4547:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4548: 
 4549:             }
 4550: 
 4551:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4552: 
 4553:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4554:    
 4555:          }
 4556:       }
 4557:       else if constexpr(ihorcon == 2) {
 4558:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4559:       }
 4560: 
 4561: 
 4562:    }
 4563: 
 4564: 
 4565:    __global__ void setEssentialBC(void) {
 4566:       // Set essential boundary conditions 
 4567:       NODE(node); // Each boundary node
 4568:       NodeBoundary *nodeBnd = node->nodeBnd;
 4569:       
 4570:  
 4571:       // Check if this node has essential BC
 4572:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4573:          // Verify BC value is valid
 4574:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4575: 
 4576:        
 4577:          // Set diagonal to 1 and zero off-diagonals
 4578:          node->coeffDiag = 1.0;
 4579: 
 4580:          for (int j = 0; j < node->numNodes; j++) {
 4581:                node->coeffMatrix[j] = 0.0;
 4582:          }
 4583:          
 4584:          // Set solution and RHS to BC value
 4585:          node->mX  = nodeBnd->elbc;
 4586:          node->qel = nodeBnd->elbc;
 4587: 
 4588:       } else {
 4589:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4590: 
 4591:          for (int j = 0; j < node->numNodes; j++) {
 4592:                Node* nbNode = node->nodes[j];
 4593:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4594:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4595:                   // Verify neighbor's BC value
 4596:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4597: 
 4598:                   // Subtract contribution to RHS
 4599:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4600:                   node->coeffMatrix[j] = 0.0;  
 4601:                }
 4602:          }
 4603:       }
 4604:    }
 4605: 
 4606: 
 4607:    __global__ void updateElevation(void) {
 4608:       NODE(node);
 4609: 
 4610: 
 4611:       node->eta2 = node->mX;
 4612: 
 4613:       node->updateZCoordData();
 4614:    }
