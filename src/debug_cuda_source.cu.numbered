 3623: __device__ __inline__ void Node::updateZCoordData(void) {
 3624: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3625: 
 3626:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3627:    // if (isDry2()) {
 3628:    //    kb = -1;  // XXXXXXXX KKKKK
 3629:    //    return;
 3630:    // }
 3631: 
 3632: 
 3633:    if constexpr(ivcor == 2) {  // SZ coordinates
 3634:       
 3635:       // Compute bottom level index
 3636:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3637:    } 
 3638:    else {  // if (ivcor == 1) Localized sigma
 3639:       // Do nothing
 3640:    }
 3641: 
 3642: 
 3643: }
