  776:    double qthcon;  // Flow time history constant
  777:    double vobc1;   // Velocity coefficient 1
  778:    double vobc2;   // Velocity coefficient 2
  779: 
  780:    // Tracer boundary conditions
  781:    // double trobc[natrm];    // Tracer boundary condition nudging factor
