 2156:    template<typename T>
 2157:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2158:       // Get the values of the field at the nodes of the element
 2159:       res[0] = nodes[0]->*field;
 2160:       res[1] = nodes[1]->*field;
 2161:       res[2] = nodes[2]->*field;
 2162:       if (isQuad()) res[3] = nodes[3]->*field;
 2163:       else          res[3] = T();
 2164:    }
 2165: 
 2166:    template<typename T>
 2167:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2168: 
 2169:       assert(level < nvrt && "Level is out of range");
 2170:       // Get the values of the field at the nodes of the element
 2171:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2172:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2173:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2174:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2175:       else          res[3] = T();
 2176:    }    
 2177: 
 2178:    template<typename T>
 2179:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2180: 
 2181:       assert(level < nvrt && "Level is out of range");
 2182: 
 2183:       // Get the values of the func at the nodes of the element
 2184:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2185:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2186:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2187:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2188:       else          res[3] = T();  // This is 0.0 or a zero vector
 2189: 
 2190:    }      
