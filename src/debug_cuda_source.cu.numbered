  278: // Polynomial class
  279: template<int grade>
  280: struct Polynomial {
  281:     // Static assertion to give a clear error message at compile time
  282:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  283: };
  284: 
  285: 
  286: // Explicit specialization for grade 4
  287: template<>
  288: struct Polynomial<4> {
  289:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  290: 
  291:    // Constructor from coefficients
  292:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  293: 
  294:    __device__ __host__ __forceinline__ double eval(double x) const {
  295:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  296:    }
  297: };
