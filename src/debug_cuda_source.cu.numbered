  269: 
  270: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  271:     return make_double3(v.x * s, v.y * s, v.z * s);
  272: }
  273: 
  274: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
