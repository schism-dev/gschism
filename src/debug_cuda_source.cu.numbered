 2723: 
 2724: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2725: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2726: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2727: // Only when ics == 2, the origin is at the element center.
 2728: 
 2729:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2730: 
 2731:    const Node *node = nodes[idxNode];
 2732: 
 2733:    if constexpr(ics==1) {
 2734:       return node->p;
 2735: 
 2736:    } else {
 2737:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2738: 
 2739:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2740: 
 2741:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2742:    }
 2743: 
 2744: }
 2745: 
 2746: 
 2747: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2748:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2749: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2750: 
 2751:    const int id1 = idx;
 2752:    const int id2 = nxq(1 + id1);
 2753:    const int id3 = nxq(2 + id1);
 2754: 
 2755:    if constexpr(ics==1) {
 2756:       x0 = nodes[id1]->p;
 2757:       x1 = nodes[id2]->p;
 2758:       x2 = nodes[id3]->p;
 2759: 
 2760:    } else {
 2761: 
 2762:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2763:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2764:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2765: 
 2766:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2767:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2768:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2769: 
 2770:    }
 2771: 
 2772: }
 2773: 
 2774: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2775:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2776: }
 2777: 
 2778: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2779:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2780:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2781: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2782: 
 2783:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2784: 
 2785: 
 2786: 
 2787:    if constexpr(ics==1) {
 2788:       x0 = nodes[0]->p;
 2789:       x1 = nodes[1]->p;
 2790:       x2 = nodes[2]->p;  
 2791:       x3 = nodes[3]->p;
 2792: 
 2793:    } else {
 2794: 
 2795:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2796:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2797:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2798:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2799: 
 2800:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2801:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2802:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2803:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2804:    }
 2805: 
 2806: }
 2807: 
 2808: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2809:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2810: {
 2811:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2812: }
 2813: 
 2814: 
 2815: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2816: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2817: // Returns the normal vector and the area of the element at this level
 2818:    
 2819:    double nx, ny, nz;
 2820: 
 2821:    if (isTri()) {
 2822:       // For triangles...
 2823: 
 2824:       // Indices of the nodes at level k, taking care of not going below the bed
 2825:       const int k0 = max(k, nodes[0]->kb);
 2826:       const int k1 = max(k, nodes[1]->kb);
 2827:       const int k2 = max(k, nodes[2]->kb);
 2828: 
 2829:       // Gets the element frame coordinates of the nodes at level k
 2830:       Point3 x0, x1, x2;
 2831:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2832:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2833:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2834:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2835: 
 2836:       } else {  // ics == 2
 2837:          Point2 h0, h1, h2;
 2838: 
 2839:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2840: 
 2841:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2842:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2843:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2844:       }
 2845: 
 2846:       const Vector3 n20 = x2 - x0;
 2847:       const Vector3 n10 = x1 - x0; 
 2848: 
 2849:       // Computes the cross product of vectors n20 and n10. 
 2850:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2851:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2852:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2853: 
 2854:   
 2855:    }
 2856:    else {
 2857:       // For quads...
 2858:       Point2 h0, h1, h2, h3;
 2859: 
 2860:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2861: 
 2862:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2863:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2864:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2865:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2866: 
 2867:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2868:       nx = n20.y*n31.z - n20.z*n31.y;
 2869:       ny = n20.z*n31.x - n20.x*n31.z;
 2870:       nz = n20.x*n31.y - n20.y*n31.x;
 2871: 
 2872:    }
 2873: 
 2874:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2875:    area3D = 0.5*len;
 2876: 
 2877:    const double inv_len = 1.0/len;
 2878: 
 2879:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2880: 
 2881: }
 2882: 
 2883: 
 2884: // Helper functions to get the 2D local node position for the Celestial walk
 2885: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2886:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2887:    const Node *node = getNodeInOrder(idx2);
 2888: 
 2889:    double z = 0.0;
 2890:    if constexpr(ics == 2) z = node->gz;
 2891:    
 2892:    Point3 p = toPoint3(node->p, z);
 2893: 
 2894:    return toPoint2(origSide->toLocalFrame(p));
 2895: }
 2896: 
 2897: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2898:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2899: }
 2900: 
 2901: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2902:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2903: // Computes the three per-side predicates needed for the celestial walk
 2904: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2905: //
 2906: // xt is in local frame coordinates for origSide if ics == 2.
 2907: //
 2908: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2909: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2910: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2911: // meaningless on triangles are masked to a safe value (see comments below).
 2912: {
 2913:    // Project all 4 corner positions once into the local 2D frame.
 2914:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2915:    // getLocalNodePosition only transforms/projects if ics == 2.
 2916:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2917:                         getLocalNodePosition(1, origSide), 
 2918:                         getLocalNodePosition(2, origSide), 
 2919:                         getLocalNodePosition(3, origSide)};
 2920: 
 2921:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2922:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2923:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2924:    // But still farther towards the target point from the current point.
 2925:    const Vector2 vt0 = xt - x0;
 2926:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2927:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2928:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2929: 
 2930:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2931:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2932: 
 2933: 
 2934: // if (origSide->idx == 2860848 && jlev == 46) {
 2935: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2936: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2937: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2938: // }
 2939:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2940:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2941:    //  here the orientation is baked into the corners array.)
 2942:    const int i3 = nxq(3);
 2943:    const Vector2 s0 = C[ 1] - C[ 0];
 2944:    const Vector2 s1 = C[ 2] - C[ 1];
 2945:    const Vector2 s2 = C[i3] - C[ 2];
 2946:    const Vector2 s3 = C[ 0] - C[i3];
 2947:    
 2948:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2949:    // The corners array is built from getNode in CCW order, so the orientation
 2950:    // is already correct and no ssign factor is needed in the formulas below.
 2951:    //
 2952:    // i3 = nxq(3): the index of the corner after side 2.
 2953:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2954:    //   Quad:     i3 == 3.
 2955:    //
 2956:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2957:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2958:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2959:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2960:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2961:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2962: 
 2963: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2964: 
 2965:    // For triangles, the corner after side 2 is the closing corner where
 2966:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2967:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2968:    // s0 for triangles, s3 for quads.
 2969:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2970: 
 2971:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2972:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2973:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2974:    //
 2975:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2976:    // result is false naturally. No sentinel needed.
 2977:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2978:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2979:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2980:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2981: 
 2982:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2983:    // on the "exit through side I" half of the corner cone, separated by the
 2984:    // approximate angular bisector of the celestial walk. The bisector is
 2985:    // perpendicular to the chord across the corner; the test is the sign of
 2986:    // (xt - corner_vertex) projected onto that chord.
 2987:    //
 2988:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2989:    // (the validity rule sets valid_3 = false), so its computed value for
 2990:    // triangles doesn't matter. No sentinel needed.
 2991:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2992:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2993:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2994:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2995: 
 2996: }
 2997: 
 2998: 
 2999: __inline__ __device__ double Element::computeSignedArea(void) const {
 3000:    // Compute the area of the element
 3001: 
 3002:    Point2 x0, x1, x2, x3;
 3003:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 3004: 
 3005: 
 3006:    double res = signedArea(x0, x1, x2);
 3007: 
 3008:    // In the quad case we need to add the area of the other triangle.
 3009:    if (isQuad()) {
 3010:       x3 = getLocalHorizontalNodePosition(3);
 3011:       double ar1 = signedArea(x0, x2, x3);
 3012:       double ar2 = signedArea(x0, x1, x3);
 3013:       double ar3 = signedArea(x1, x2, x3);
 3014:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 3015: 
 3016:       res += ar1;
 3017: 
 3018:    }
 3019: 
 3020:    return res;
 3021: }
 3022: 
 3023: 
 3024: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 3025:                                                                 (nodes[1]->isDry2()) ||
 3026:                                                                 (nodes[2]->isDry2()) ||
 3027:                                                                 (isQuad() && nodes[3]->isDry2());
 3028: }
 3029: 
 3030: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3031:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 3032: }
 3033: 
 3034: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3035:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 3036: }
