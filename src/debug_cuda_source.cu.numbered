 3745: 
 3746:    __global__ void backtrackAllNodes(void) {
 3747: 
 3748:       // max/min # of sub-divisions
 3749:       const int ndelt_max = max(1.0, dt/dtb_min);
 3750:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3751: 
 3752:       // Removed all references to swild98 XXX
 3753:       // swild98=0.d0 !init
 3754: 
 3755: 
 3756:       SIDE(side);
 3757: 
 3758:       const int kb = side->kb;
 3759: 
 3760: 
 3761:       // Initialize btrack velocities to the actual velocities at the side 
 3762:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3763: 
 3764:   
 3765: 
 3766:       // if (side->isDry) return;
 3767:       
 3768: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3769: 
 3770:       // Checks that at least one element is not dry
 3771:       const Element *elem1 = side->elems[0];
 3772:       const Element *elem2 = side->elems[1];
 3773: 
 3774: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3775: 
 3776:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3777:       
 3778:       // XXXXXX
 3779:       // !swild_tmp to store global coord. of the starting side
 3780:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3781:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3782:       // !Use sframe2 
 3783:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3784: 
 3785: 
 3786:       for (int k = kb; k < nvrt; k++) {
 3787:       //  Initialize (xt,yt,zt), nnel and vel.
 3788:       //  For ics=2, the coordinates are in local frames
 3789:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3790: 
 3791: 
 3792:          const int iadvf = side->iadv();  // Advection flag   
 3793:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3794: 
 3795:          Point3 xt;
 3796:          if constexpr(ics==1) {
 3797:             xt = side->center3D(k); 
 3798:          }
 3799:          else // lat/lon; in side lat/lon frame
 3800:          {
 3801:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3802:          // XXX IMPLEMENT THIS
 3803:       //          xt=0.d0
 3804:       //          yt=0.d0
 3805:       //          !centroid coord. for nudging
 3806:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3807:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3808:          }  // ics
 3809: 
 3810: 
 3811: 
 3812:          // If on land or open boundary...
 3813:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3814:          
 3815:          const double vmag = length(side->u2[k]);
 3816: 
 3817:          if (vmag <= velmin_btrack) {
 3818:             // No activity 
 3819: 
 3820:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3821: // addDebugPlot(side->center, side->center, 0x00000F, '+');            
 3822:             
 3823:          } else {  // do btrack
 3824: 
 3825:             // Compute number of sub-divisions based on local gradients 
 3826:             // XXX IS THIS NECESSARY?
 3827:             double suma = 0.0;
 3828:             int icount = 0;
 3829:             for (int ii=0; ii<2; ii++) {
 3830: 
 3831:                const Element *elem = side->elems[ii];
 3832:                  
 3833:                if (elem == nullptr) continue;
 3834: 
 3835:                icount++;
 3836: 
 3837:                // Not strictly along z; in ll frame for ics=2
 3838: 
 3839:                double utmp[4];
 3840:                double vtmp[4];
 3841:                for (int jj = 0; jj < elem->i34; jj++) {
 3842: 
 3843:                   const Node *node = elem->nodes[jj];
 3844: 
 3845:                   if constexpr(ics==1) {
 3846:                      utmp[jj] = node->u2[k].x;
 3847:                      vtmp[jj] = node->u2[k].y;  
 3848:                   } else {
 3849:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3850:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3851:                   }
 3852:                } // for jj
 3853: 
 3854:                const Vector2 grad_u = elem->grad2(utmp); 
 3855:                const Vector2 grad_v = elem->grad2(vtmp);
 3856: 
 3857:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3858:             } // for ii
 3859: 
 3860:             assert(icount > 0 && "Impossible 77");
 3861: 
 3862:             // '4' is somewhat arbitrary
 3863:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3864: 
 3865:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3866: 
 3867:             Vector3 u_int = {0.0, 0.0, 0.0};
 3868: 
 3869:             side->btrack(k, dt, dtbk, u_int);
 3870: 
 3871:             side->btu[k] = toVector2(u_int);
 3872:                
 3873:          } // if vmag (do backtrack)
 3874: 
 3875:       } // for k=kb,nvrt-1
 3876: 
 3877:    }
 3878: 
 3879: } // extern "C"
 3880: 
 3881: template<int nc>
 3882: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3883: 
 3884: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3885: //
 3886: // a,b,c,rhs: input vectors and are not modified by this program.
 3887: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3888: // rhs is the r.h.s.
 3889: // n: actual rank of the system.
 3890: // rows in u() and rhs();
 3891: // u: output with nc columns (transposed to rows)
 3892: // gam: a working array.
 3893: //
 3894: // NOTES:
 3895: // This is a template function that allows for different numbers of columns in the rhs vector.
 3896: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3897: 
 3898:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3899:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3900: 
 3901:    double bet = b[0];
 3902:    if constexpr (nc == 1) {
 3903:       u[0] = rhs[0]/bet;
 3904:    } else {
 3905:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3906:    }
 3907: 
 3908:    for (int j = 1; j < n; j++) {
 3909:       gam[j] = c[j - 1]/bet;
 3910:       bet = b[j] - a[j]*gam[j];
 3911: 
 3912:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3913: 
 3914:       if constexpr (nc == 1) {
 3915:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3916:       } else {
 3917:          for (int l = 0; l < nc; l++) {
 3918:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3919:          }
 3920:       }
 3921:    }
 3922: 
 3923:    // Back-substitution
 3924:    for (int j = n - 2; j >= 0; j--) {
 3925:       if constexpr (nc == 1) {
 3926:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3927:       } else {
 3928:          for (int l = 0; l < nc; l++) {
 3929:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3930:          }
 3931:       }
 3932:    }
 3933: }
 3934: 
 3935: 
 3936: 
 3937: // Helper function that contains the core algorithm
 3938: template<typename XAccessor, typename YAccessor>
 3939: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3940:                                     double  yp_top, double  yp_bot, 
 3941:                                     CubicSpline &spline) {
 3942:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3943:    // 
 3944:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3945:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3946:    //
 3947:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3948:    // 
 3949:    // Inputs: 
 3950:    //            n: dimension for x etc; # of data pts (>=2);
 3951:    //            getX, getY: functions to access x,y coordinates
 3952:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3953:    //     Output: 
 3954:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3955: 
 3956:    const int n = k2 - k1 + 1;
 3957:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3958: 
 3959:    // Allocate memory for the splines
 3960:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3961:    spline.x   = new double[n];
 3962:    spline.y   = new double[n];
 3963:    spline.yp  = new double[n];
 3964:    spline.ypp = new double[n];
 3965: 
 3966:    for (int k=k1; k<=k2; k++) {
 3967:       spline.x[k] = getX(k);
 3968:       spline.y[k] = getY(k);
 3969:    }
 3970: 
 3971:    // This is to simplify expressions later
 3972:    double *x = spline.x;
 3973:    double *y = spline.y;
 3974: 
 3975:    double *a = nullptr;
 3976:    double *b = nullptr;
 3977:    double *c = nullptr;
 3978:    double *gam = nullptr;
 3979:    double *rhs = nullptr;
 3980:    
 3981: 
 3982:       a = new double[n];   // Lower diagonal
 3983:       b = new double[n];   // Diagonal
 3984:       c = new double[n];   // Upper diagonal
 3985:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3986:       rhs = new double[n]; // Right-hand side
 3987: 
 3988:    for (int k=k1; k<=k2; k++) {
 3989:       if (k == k1) {
 3990:          // Bottom level
 3991:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3992:          b[k] = (x[k+1] - x[k])/3.0;
 3993:          c[k] = b[k]/2.0;
 3994:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3995:       } else if (k == n - 1) {
 3996:          // Top level (surface)
 3997:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3998:          b[k] = (x[k] - x[k-1])/3.0;
 3999:          a[k] = b[k]/2.0;
 4000:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4001:       } else {
 4002:          // Intermediate levels
 4003:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4004:          b[k] = (x[k+1] - x[k-1])/3.0;
 4005:          a[k] = (x[k  ] - x[k-1])/6.0;
 4006:          c[k] = (x[k+1] - x[k  ])/6.0;
 4007:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4008:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4009:       }
 4010:    }
 4011: 
 4012:    // Solve the tridiagonal system
 4013:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4014:    
 4015:    spline.yp[k1] = yp_bot;
 4016:    spline.yp[k2] = yp_top;
 4017: 
 4018:    // Compute rest of 1st derivatives using the splines
 4019:    for (int k=k1+1; k<k2; k++) {
 4020:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4021:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4022:    }
 4023:    
 4024:    delete[] a;
 4025:    delete[] b;
 4026:    delete[] c;
 4027:    delete[] gam;
 4028:    delete[] rhs;
 4029: 
 4030: }
 4031: 
 4032: // Array version
 4033: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4034:                                 double y_top, double y_bot, 
 4035:                                 CubicSpline &spline) {
 4036:    auto getX = [x] (int k) { return x[k]; };
 4037:    auto getY = [y] (int k) { return y[k]; };
 4038:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4039: }
 4040: 
 4041: // Lambda version - allows custom access patterns
 4042: template<typename XFunc, typename YFunc>
 4043: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4044:                                 double y_top, double y_bot,
 4045:                                 CubicSpline &spline) {
 4046:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4047: }
 4048: 
 4049: 
 4050: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4051: {
 4052:    assert("Not implemented");
 4053: 
 4054:    return 0.0;
 4055: }
