 2413:    template<typename T>
 2414:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2415:       // Get the values of the field at the nodes of the element
 2416:       res[0] = nodes[0]->*field;
 2417:       res[1] = nodes[1]->*field;
 2418:       res[2] = nodes[2]->*field;
 2419:       if (isQuad()) res[3] = nodes[3]->*field;
 2420:       else          res[3] = T();
 2421:    }
 2422: 
 2423:    template<typename T>
 2424:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2425: 
 2426:       assert(level < nvrt && "Level is out of range");
 2427:       // Get the values of the field at the nodes of the element
 2428:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2429:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2430:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2431:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2432:       else          res[3] = T();
 2433:    }    
 2434: 
 2435:    template<typename T>
 2436:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2437: 
 2438:       assert(level < nvrt && "Level is out of range");
 2439: 
 2440:       // Get the values of the func at the nodes of the element
 2441:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2442:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2443:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2444:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2445:       else          res[3] = T();  // This is 0.0 or a zero vector
 2446: 
 2447:    }      
 2448: 
 2449:    template<typename T>
 2450:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2451:       // Get the values of the field at the nodes of the element
 2452:       res[0] = sides[0]->*field;
 2453:       res[1] = sides[1]->*field;
 2454:       res[2] = sides[2]->*field;
 2455:       if (isQuad()) res[3] = sides[3]->*field;
 2456:       else          res[3] = T();
 2457:    }
 2458: 
 2459:    template<typename T>
 2460:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2461: 
 2462:       assert(level < nvrt && "Level is out of range");
 2463: 
 2464:       // Get the values of the field at the nodes of the element
 2465:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2466:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2467:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2468:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2469:       else          res[3] = T();
 2470:    }    
 2471: 
 2472:    template<typename T>
 2473:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2474: 
 2475:       assert(level < nvrt && "Level is out of range");
 2476: 
 2477:       // Get the values of the func at the nodes of the element
 2478:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2479:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2480:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2481:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2482:       else          res[3] = T();  // This is 0.0 or a zero vector
