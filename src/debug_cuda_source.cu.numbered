 1243:    __device__ __forceinline__ Vector2 grad2(double *a) const
 1244:    {
 1245:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
 1246:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
 1247:       if (isQuad()) {
 1248:          gx += a[3]*gradPhi[3].x;
 1249:          gy += a[3]*gradPhi[3].y;
 1250:       }
 1251:       return {gx, gy};
 1252:    }
 1253: 
 1254:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
 1255:    {
 1256:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
 1257:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
 1258:       if (isQuad()) {
 1259:          gx += (nodes[3]->*field)*gradPhi[3].x;
 1260:          gy += (nodes[3]->*field)*gradPhi[3].y;
 1261:       }
 1262:       return {gx, gy};
 1263:    }
