 2538: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2539:    // Returns the value of the velocity at the side center
 2540:    const double w1 = getBoundaryArrayValueWeight();
 2541:    const double w2 = 1.0 - w1;
 2542:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2543:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2544: 
 2545:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2546: }
