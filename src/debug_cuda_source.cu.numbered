 7698: __global__ void printMatrix(bool full) {
 7699:    // Debugging: print the matrix
 7700: 
 7701:    const int size = mesh->np;
 7702:    double sum = 0.0;
 7703:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7704:       const Node *node = mesh->localNodeData + idx_node;
 7705:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7706:       for (int j = 0; j < node->numNodes; j++) {
 7707:          Node* nbNode = node->nodes[j];
 7708:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7709:          sum += node->coeffMatrix[j];
 7710:       }
 7711:       if (full) printf("]\n");
 7712: 
 7713: 
 7714:    }
 7715:    if (!full) printf("sum=%lf\n", sum);
 7716: }
