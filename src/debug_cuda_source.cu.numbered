  543: 
  544: // ----------------------------- Frames -----------------------------
  545: 
  546: // Frames are used to transform vectors between different coordinate systems.
  547: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  548: template<int ICS>
  549: struct Frame {};
  550: 
  551: template<>
  552: struct Frame<1> {
  553:    __forceinline__ __device__ void update(double, double) {}
  554:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  555:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  556:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  557:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  558:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  559:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  560: };
  561: 
  562: template<>
  563: struct Frame<2> {
  564:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  565:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  566:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  567:     double t00, t10;        // col0 (t20=0 implicit)
  568:     double t01, t11, t21;   // col1
  569: 
  570:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  571: 
  572:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  573:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  574: 
  575:       double sin_lon, cos_lon, sin_lat, cos_lat;
  576:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  577:       sincos(lat, &sin_lat, &cos_lat);
  578: 
  579:       t00 = -sin_lon;
  580:       t10 =  cos_lon;
  581:       t01 = -cos_lon*sin_lat;
  582:       t11 = -sin_lon*sin_lat;
  583:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  584: 
  585:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  586:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  587: 
  588:       const double col1_norm_inv = 1.0/col1_norm;
  589:       t01 = t01*col1_norm_inv;
  590:       t11 = t11*col1_norm_inv;
  591:       t21 = t21*col1_norm_inv;
  592: 
  593:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  594: 
  595: 
  596:    }
  597: 
  598:    __forceinline__ __device__ void print(void) const {
  599:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  600:    }
  601: 
  602:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  603:       // cross(col0, col1), with t20=0 implicitly:
  604:       // |  i       j       k   |
  605:       // | t00     t10      0   |
  606:       // | t01     t11     t21  |
  607:       t02 =  t10*t21;
  608:       t12 = -t00*t21;
  609:       t22 =  t00*t11 - t10*t01;
  610:    }
  611: 
  612: 
  613:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  614:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  615:    // Inputs:
  616:    //        vec0: vel. in this frame;
  617:    //        frameout: Output frame;
  618:    // Output: 
  619:    //        vel. in new frame  
  620:    //
  621:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  622:    // discarding the z-component of the result to keep only the local horizontal
  623:    // plane of frame 2.
  624:    //
  625:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  626:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  627:    // are orthogonal. This product is computed as dot products between columns of
  628:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  629:    // columns of F2.// 
  630: 
  631:       auto const fo = frameout; // Just an alias for the output frame.
  632:       Vector2 res;
  633: 
  634:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  635:       // of t and fo.t are the same.
  636:       const double d00 = t00*fo.t00 + t10*fo.t10;
  637:       const double d10 = t01*fo.t00 + t11*fo.t10;
  638: 
  639:       const double d01 = t00*fo.t01 + t10*fo.t11;
  640:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  641: 
  642:       res.x = vec0.x * d00 + vec0.y * d10;
  643:       res.y = vec0.x * d01 + vec0.y * d11;
  644: 
  645:       return res;
  646:    }
  647: 
  648:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  649:       Vector3 vo;
  650:       double t02, t12, t22;
  651: 
  652:       // Compute the 3rd column of the frame tensor
  653:       getCol2(t02, t12, t22);
  654: 
  655:       vo.x = vi.x*t00 + vi.y*t10;
  656:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  657:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  658: 
  659:       return vo;
  660:    
  661:    }
  662: 
  663:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  664:       Vector3 vo;
  665:       double t02, t12, t22;
  666: 
  667:    // Compute the 3rd column of the frame tensor
  668:       getCol2(t02, t12, t22);
  669: 
  670:       // F * vi (non-transposed, so we use rows of F)
  671:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  672:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  673:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  674: 
  675:       return vo;
  676:    }
  677: 
  678:    // Unit vectors that define the local frame
  679:    __forceinline__ __device__ Vector3 nUp(void) const {
  680:       // Column 2 = cross(column0, column1)
  681:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  682:    }
  683: 
  684:    __forceinline__ __device__ Vector3 nZonal(void) const {
  685:       // Column 0
  686:       return { t00, t10, 0.0 };
  687:    }
  688: 
  689:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  690:       // Column 1
  691:       return { t01, t11, t21 };
  692:    }
  693: 
  694: };
  695: 
