 6434:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 6435:                    double *node_coords, double *wind_rotate_angle, 
 6436:                    int *isdel, int *isidenode, int *isbnd,
 6437:                    int *nond, int *nlnd, int *iond, int *ilnd,
 6438:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 6439:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 6440:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 6441:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 6442:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 6443:                    double *emo, double *efa, 
 6444:                    double *umo, double *ufa, 
 6445:                    double *vmo, double *vfa) {
 6446: 
 6447:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 6448:                        isdel, isidenode, isbnd,
 6449:                        nond, nlnd, iond, ilnd,
 6450:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 6451:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 6452:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 6453:                        localNodeIndices, localElemIndices, localSideIndices,
 6454:                        localNodePart, localElemPart, localSidePart,
 6455:                        emo, efa, umo, ufa, vmo, vfa);
 6456:   }
