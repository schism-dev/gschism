 4294: template<int nc>
 4295: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4296: 
 4297: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4298: //
 4299: // a,b,c,rhs: input vectors and are not modified by this program.
 4300: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4301: // rhs is the r.h.s.
 4302: // n: actual rank of the system.
 4303: // rows in u() and rhs();
 4304: // u: output with nc columns (transposed to rows)
 4305: // gam: a working array.
 4306: //
 4307: // NOTES:
 4308: // This is a template function that allows for different numbers of columns in the rhs vector.
 4309: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4310: 
 4311:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4312:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4313: 
 4314:    double bet = b[0];
 4315:    if constexpr (nc == 1) {
 4316:       u[0] = rhs[0]/bet;
 4317:    } else {
 4318:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4319:    }
 4320: 
 4321:    for (int j = 1; j < n; j++) {
 4322:       gam[j] = c[j - 1]/bet;
 4323:       bet = b[j] - a[j]*gam[j];
 4324: 
 4325:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4326: 
 4327:       if constexpr (nc == 1) {
 4328:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4329:       } else {
 4330:          for (int l = 0; l < nc; l++) {
 4331:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4332:          }
 4333:       }
 4334:    }
 4335: 
 4336:    // Back-substitution
 4337:    for (int j = n - 2; j >= 0; j--) {
 4338:       if constexpr (nc == 1) {
 4339:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4340:       } else {
 4341:          for (int l = 0; l < nc; l++) {
 4342:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4343:          }
 4344:       }
 4345:    }
 4346: }
 4347: 
 4348: 
 4349: 
 4350: // Helper function that contains the core algorithm
 4351: template<typename XAccessor, typename YAccessor>
 4352: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4353:                                     double  yp_top, double  yp_bot, 
 4354:                                     CubicSpline &spline) {
 4355:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4356:    // 
 4357:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4358:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4359:    //
 4360:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4361:    // 
 4362:    // Inputs: 
 4363:    //            n: dimension for x etc; # of data pts (>=2);
 4364:    //            getX, getY: functions to access x,y coordinates
 4365:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4366:    //     Output: 
 4367:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4368: 
 4369:    const int n = k2 - k1 + 1;
 4370:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4371: 
 4372:    // Allocate memory for the splines
 4373:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4374:    spline.x   = new double[n];
 4375:    spline.y   = new double[n];
 4376:    spline.yp  = new double[n];
 4377:    spline.ypp = new double[n];
 4378: 
 4379:    for (int k=k1; k<=k2; k++) {
 4380:       spline.x[k] = getX(k);
 4381:       spline.y[k] = getY(k);
 4382:    }
 4383: 
 4384:    // This is to simplify expressions later
 4385:    double *x = spline.x;
 4386:    double *y = spline.y;
 4387: 
 4388:    double *a = nullptr;
 4389:    double *b = nullptr;
 4390:    double *c = nullptr;
 4391:    double *gam = nullptr;
 4392:    double *rhs = nullptr;
 4393:    
 4394: 
 4395:       a = new double[n];   // Lower diagonal
 4396:       b = new double[n];   // Diagonal
 4397:       c = new double[n];   // Upper diagonal
 4398:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4399:       rhs = new double[n]; // Right-hand side
 4400: 
 4401:    for (int k=k1; k<=k2; k++) {
 4402:       if (k == k1) {
 4403:          // Bottom level
 4404:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4405:          b[k] = (x[k+1] - x[k])/3.0;
 4406:          c[k] = b[k]/2.0;
 4407:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4408:       } else if (k == n - 1) {
 4409:          // Top level (surface)
 4410:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4411:          b[k] = (x[k] - x[k-1])/3.0;
 4412:          a[k] = b[k]/2.0;
 4413:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4414:       } else {
 4415:          // Intermediate levels
 4416:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4417:          b[k] = (x[k+1] - x[k-1])/3.0;
 4418:          a[k] = (x[k  ] - x[k-1])/6.0;
 4419:          c[k] = (x[k+1] - x[k  ])/6.0;
 4420:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4421:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4422:       }
 4423:    }
 4424: 
 4425:    // Solve the tridiagonal system
 4426:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4427:    
 4428:    spline.yp[k1] = yp_bot;
 4429:    spline.yp[k2] = yp_top;
 4430: 
 4431:    // Compute rest of 1st derivatives using the splines
 4432:    for (int k=k1+1; k<k2; k++) {
 4433:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4434:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4435:    }
 4436:    
 4437:    delete[] a;
 4438:    delete[] b;
 4439:    delete[] c;
 4440:    delete[] gam;
 4441:    delete[] rhs;
 4442: 
 4443: }
 4444: 
 4445: // Array version
 4446: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4447:                                 double y_top, double y_bot, 
 4448:                                 CubicSpline &spline) {
 4449:    auto getX = [x] (int k) { return x[k]; };
 4450:    auto getY = [y] (int k) { return y[k]; };
 4451:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4452: }
 4453: 
 4454: // Lambda version - allows custom access patterns
 4455: template<typename XFunc, typename YFunc>
 4456: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4457:                                 double y_top, double y_bot,
 4458:                                 CubicSpline &spline) {
 4459:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4460: }
 4461: 
 4462: 
 4463: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4464: {
 4465:    assert("Not implemented");
 4466: 
 4467:    return 0.0;
 4468: }
 4469: 
 4470: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 4471: // //     Routine to do vertical linear interpolation in z
