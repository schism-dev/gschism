 1873: __device__ __forceinline__ double Element::centerZ(void) const { 
 1874: // Z coordinate of the element center in the global cartesian coordinates
 1875: 
 1876:    if constexpr(ics==1) { 
 1877:       return 0.0; 
 1878:    } else { 
 1879:       if (isTri()) {
 1880:          return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz); 
 1881:       } else {
 1882:          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz); 
 1883:       }
 1884: 
 1885:    } 
 1886: }
