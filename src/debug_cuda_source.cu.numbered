 1589: // Helper functions for computing the local node index at a given offset from another.
 1590: __device__ __inline__ int nxq(int offset, int index, int size) {
 1591:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1592:    // to the index to make it positive
 1593:    assert(index + offset + 16*size >= 0);
 1594:    return (index + offset + 16*size) % size;  
 1595: }
 1596: 
 1597: __device__ __inline__ int nxq(int index, int size) {
 1598:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1599:    // to the index to make it positive
 1600:    assert(index + 16*size >= 0);
 1601:    return (index + 16*size) % size; 
 1602: }
