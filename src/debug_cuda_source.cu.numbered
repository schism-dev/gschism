 5137: extern "C" {
 5138: 
 5139:    __global__ void scaleGravity(double loadtide_coef) {
 5140: 
 5141: 
 5142:       NODE(node);
 5143: 
 5144:       // SAL option: scale gravity
 5145:       if constexpr(iloadtide==2) {  // simple const
 5146:          node->grav2 = grav*(1.0 - loadtide_coef);
 5147: 
 5148:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5149:         
 5150:           const double depth = max(node->depth, 0.0);
 5151:           const double tmp1 = sqrt(depth);
 5152:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5153:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5154:                              2.6969e-13*depth*depth*depth*tmp1;
 5155:           
 5156:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5157:           
 5158: 
 5159: 
 5160:           node->grav2 = grav*(1.0 - beta_bar);
 5161: 
 5162:       } else {  // iloadtide=0,1
 5163:           node->grav2 = grav;
 5164: 
 5165:       }
 5166: 
 5167:    }
