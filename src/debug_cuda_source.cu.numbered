 3869: 
 3870: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3871:    // Computes the z coordinate at level k.
 3872:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3873:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3874:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3875:    // used 
 3876: 
 3877:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3878:    
 3879:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3880: 
 3881:    if (isDry2()) return 0.0;  
 3882: 
 3883:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3884: 
 3885:    if constexpr(ivcor == 2) {
 3886: 
 3887:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3888:       const double h_c = mesh->h_c;
 3889:       const double theta_f = mesh->theta_f;
 3890:       const double sinh_theta_f = mesh->sinh_theta_f;
 3891: 
 3892: 
 3893:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3894:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3895:       // once per time step/node. XXXX
 3896:       // CHECK: updateZCoordData
 3897: 
 3898:       //  To simplify comparisons, I define index versions of count variables.
 3899:       if      (k == ivrt)     return eta2; 
 3900:       else if (k == izlev)    return -hmod2;
 3901:       else if (k == kb)       return -depth;
 3902:       else if (k < izlev)     return mesh->ztot[k];
 3903:       else if (k > izlev) {
 3904:          const int ksig = k - izlev;
 3905: 
 3906:          if (hmod2 <= h_c) {
 3907:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3908: 
 3909:          } 
 3910:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3911:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3912:             assert(false && "compZCoord: invalid h_c\n");
 3913:          } 
 3914:          else {
 3915:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3916:                    h_c * mesh->sigma[ksig] + 
 3917:                    (hmod2 - h_c) * mesh->cs[ksig];
 3918:          }
 3919:       } else { 
 3920:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3921:       }
 3922: 
 3923:    }
 3924:    else {  // if constexpr(ivcor == 1)
 3925:       if (k <= kb)        return -depth; 
 3926:       else if (k == ivrt) return eta2;
 3927:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3928: 
 3929:    }
 3930:    
 3931:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3932:    return 0.0;
 3933: }
 3934: 
 3935: 
 3936: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3937:    // Computes the bottom drag Cd based on the selected nchi
 3938: 
 3939:    if constexpr(nchi == 0) {
 3940:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3941:       Cd = drag;  // Read from drag file
 3942: 
 3943:    } else if constexpr(nchi == 1) {
 3944:       // 
 3945: 
 3946:       bool ltmp = false; // for WBL iteration
 3947: 
 3948:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3949:       if (isDry || (rough == 0.0)) {
 3950:          Cd = 0.0;
 3951: 
 3952:       } else { //roughness >0 
 3953:          
 3954:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3955: 
 3956:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3957: 
 3958:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3959: 
 3960:       } // if rough
 3961: 
 3962:    } else if constexpr(nchi == -1) {
 3963:    // Manning 
 3964:  
 3965:       const double htot = max(hmin_man, htot2()); 
 3966:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3967: 
 3968:    } else {
 3969:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3970:       
 3971:    } // if nchi
 3972: 
 3973: }
 3974: 
 3975: 
 3976: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3977:    // Checks if a side in on the boundary
 3978:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3979: 
 3980:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3981:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3982: 
 3983:    // Indices of the nodes that form the side
 3984:    const int n1 = side.n1->idx;
 3985:    const int n2 = side.n2->idx;
 3986:    isLand = false;
 3987:    
 3988: 
 3989:    // Check if the side is on a land boundary
 3990:    for (int i = 0; i < nland; i++) {
 3991:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3992:          // Consecutive nodes in the land boundary segment
 3993:          const int b1 = ilnd[i + j*nland];
 3994:          const int b2 = ilnd[i + (j + 1)*nland];
 3995: 
 3996:          assert(b1 != -1 && b2 != -1);
 3997: 
 3998:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3999:             
 4000:             isLand = true;
 4001:             return i;
 4002:          }
 4003:       }
 4004:    }
 4005: 
 4006:    // Check if the side is on an open boundary
 4007:    for (int i = 0; i < nope; i++) {
 4008:       for (int j = 0; j < nond[i] - 1; j++) {
 4009:          // Consecutive nodes in the open boundary segment
 4010:          const int b1 = iond[i + j*nope];
 4011:          const int b2 = iond[i + (j + 1)*nope];
 4012: 
 4013:          assert(b1 != -1 && b2 != -1);
 4014: 
 4015:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4016:             isLand = false;
 4017:             return i;
 4018:          }
 4019:       }
 4020:    }
 4021: 
 4022:    return -1;
 4023: }
 4024: 
 4025: 
 4026: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4027:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4028:                                     double *wind_rotate_angle, 
 4029:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4030:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4031:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4032:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4033:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 4034: 
 4035:    NODE(pnode);  
 4036:    const int i = idx_node;
 4037:    Node &node(*pnode);
 4038: 
 4039:    node.idx = i;
 4040: 
 4041:    const int idxNodeStart = nodeNeighNodesStart[i];
 4042:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 4043:    node.numNodes = idxNodeEnd - idxNodeStart;
 4044:    node.nodes = nodeNeighNodes + idxNodeStart;
 4045:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 4046: 
 4047: 
 4048: 
 4049:    const int idxElemStart = nodeNeighElemsStart[i];
 4050:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 4051:    node.numElements = idxElemEnd - idxElemStart;
 4052:    node.elements = nodeNeighElems + idxElemStart;
 4053: 
 4054: 
 4055:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 4056:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4057:       const int partNode = localNodePart[idxNodeGlobal]; 
 4058:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4059: 
 4060:       Node *node_ptr = nodes[partNode] + idxNode;
 4061:       
 4062:       nodeNeighNodes[idx] = node_ptr;
 4063:    }
 4064: 
 4065: 
 4066:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 4067:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4068:       const int partElem = localElemPart[idxElemGlobal];
 4069:       const int idxElem  = localElemIndices[idxElemGlobal];
 4070: 
 4071:       Element *elem_ptr = elems[partElem] + idxElem;
 4072: 
 4073:       nodeNeighElems[idx] = elem_ptr;
 4074:    }      
 4075: 
 4076:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4077:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4078:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4079: 
 4080:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4081:    if constexpr(ics == 1) {
 4082:       node.p.x   = node_coords[i * 3];
 4083:       node.p.y   = node_coords[i * 3 + 1];
 4084:       node.gz = 0.0;
 4085: 
 4086:    } else {
 4087:       const double lon = deg2rad*node_coords[i * 3];
 4088:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4089: 
 4090:       Point3 p = computeXYZfromLatLon(lat, lon);
 4091:       node.p = toVector2(p);
 4092:       node.gz = p.z;
 4093:       node.lon = lon;
 4094:       node.lat = lat;
 4095: 
 4096:       #ifdef USE_FRAMES
 4097:       node.setFrame(lat, lon);
 4098:       #endif
 4099: 
 4100: 
 4101:    }
 4102: 
 4103:    node.depth = node_coords[i * 3 + 2];
 4104: 
 4105:    node.numSides = 0;
 4106: 
 4107:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4108:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 4109:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 4110:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 4111:    else assert(false && "populateNodes: selected nchi not implemented.");
 4112:    
 4113:    if constexpr(ivcor == 1) 
 4114:    {  
 4115:       node.kb = kb[i];
 4116:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 4117:    }
 4118: 
 4119:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4120:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4121:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4122: 
 4123:    
 4124:    // Links the node to the boundary information
 4125:    if (isbnd[i] >= 0) {
 4126:      
 4127:       // Get the index of the node boundary
 4128:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4129: 
 4130:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4131:       node.nodeBnd->node = &node;
 4132: 
 4133:       node.nodeBnd->sideBnd1 = nullptr;
 4134:       node.nodeBnd->sideBnd2 = nullptr;
 4135: 
 4136:       if (isbnd[i]>=0) {
 4137: 
 4138:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 4139:          
 4140:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4141:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4142: 
 4143:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4144:          node.nodeBnd->segment->clen  = nan("1");
 4145:          node.nodeBnd->segment->carea = nan("1");
 4146: 
 4147:       }
 4148:    } else {
 4149: 
 4150:       node.nodeBnd = nullptr; // For internal nodes
 4151: 
 4152:       if (isbnd[i] == landSegment) {
 4153:          node.nodeBnd = &landBoundaryNode;
 4154:          node.nodeBnd->segment = &landBoundarySegment;
 4155:       }
 4156:       
 4157:    }
 4158:    
 4159:    // XXXX GAUSSIAN HILL VELOCITIES
 4160:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4161:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4162:          constexpr double rot_per = 3000.0;
 4163:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4164:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4165:       // XXXXX
 4166:    #endif
 4167: 
 4168: }
 4169: 
 4170: 
 4171: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4172:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4173:                                     double *wind_rotate_angle,   
 4174:                                     int *isdel, int *isidenode, int *isbnd,
 4175:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4176:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4177:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4178:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4179:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4180:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4181:                                     double *drag, double *roughness) {
 4182: 
 4183: 
 4184:    SIDE(pside);
 4185:    Side &side(*pside);
 4186:    const int i = idx_side;
 4187: 
 4188:    side.idx = i;  
 4189:    
 4190:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4191:    const double fc   = 2.0*omega_e*sin(sfea0);
 4192:    const double beta = 2.0*omega_e*cos(sfea0);
 4193: 
 4194:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4195: 
 4196:    // finding the pointer to the nodes that form the side
 4197:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4198:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4199: 
 4200:    const int locidx_n1 = localNodeIndices[idx_n1];
 4201:    const int locidx_n2 = localNodeIndices[idx_n2];
 4202:    const int part_n1 =   localNodePart[idx_n1];
 4203:    const int part_n2 =   localNodePart[idx_n2];
 4204: 
 4205:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4206:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4207: 
 4208: 
 4209:    // Counts the number of sides connected to each node
 4210:    side.n1->numSides++;
 4211:    side.n2->numSides++;
 4212: 
 4213:    // Side boundary type
 4214:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4215:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4216: 
 4217:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4218:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4219:    {
 4220:       bool isLand = false;
 4221:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4222:       
 4223:       if (isbs > -1) {
 4224:          // assert(isLand || isbs>=0);
 4225:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4226: 
 4227:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4228: 
 4229:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4230:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4231: 
 4232:          assert (isLand == side.sideBnd->segment->isLand);
 4233: 
 4234:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4235:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4236:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4237: 
 4238:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4239:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4240:          
 4241:          side.sideBnd->side = &side;
 4242: 
 4243:       }
 4244:       else {
 4245:          side.sideBnd = nullptr;
 4246:       }
 4247:    }
 4248:    else 
 4249:    {
 4250:       side.sideBnd = nullptr;
 4251:    }
 4252: 
 4253: 
 4254:    // finding the pointer to the elements that share the side
 4255:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4256:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4257: 
 4258:    if (idx_e1 > -1) {
 4259:       const int locidx_e1 = localElemIndices[idx_e1];
 4260:       const int part_e1 =  localElemPart[idx_e1];
 4261:       side.elems[0] = elems[part_e1] + locidx_e1;
 4262: 
 4263:    }
 4264:    else {
 4265:       side.elems[0] = nullptr;
 4266:    }
 4267: 
 4268:    if (idx_e2 > -1) {
 4269:       const int locidx_e2 = localElemIndices[idx_e2];
 4270:       const int part_e2 =  localElemPart[idx_e2];
 4271:       side.elems[1] = elems[part_e2] + locidx_e2;
 4272:    }
 4273:    else {
 4274:       side.elems[1] = nullptr;
 4275:    }
 4276:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4277:       
 4278:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4279:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4280:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4281:          
 4282:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4283:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4284:       // printf("sideBnd: %p\n", side.sideBnd);
 4285:       // assert(false && "Side has no elements and no boundary");
 4286:    }
 4287:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4288: 
 4289:    // Compute the center of the side
 4290:    side.center = 0.5*(side.n1->p + side.n2->p);
 4291: 
 4292:    #ifdef USE_FRAMES
 4293:    side.setFrame();
 4294:    #endif
 4295: 
 4296:    // Normal, unitary vector to the side
 4297:    if constexpr(ics == 1) {
 4298:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4299:       side.n = normalize(side.n);
 4300:    }
 4301:    else {
 4302:       // Unit side vector in 3D cartesian coordinates
 4303:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4304:       nSide = normalize(nSide);
 4305: 
 4306:       // It cross product with the unit local z-axis vector (nUp) is the
 4307:       // normal vector we are looking for.
 4308:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4309: 
 4310:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4311:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4312:       side.n = normalize(n2D);      
 4313: 
 4314:    }
 4315: 
 4316:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4317:    side.shapiro = shapiro0;
 4318: 
 4319:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4320:    // XXXX
 4321:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4322:    constexpr double rot_per=3000.0;
 4323:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4324:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4325:    // XXXXX      
 4326:    #endif
 4327:    // Compute the z level at the center of the side
 4328:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4329:    
 4330:    // Compute the length of the side
 4331:    const Vector2 vLen = side.n2->p - side.n1->p;
 4332:    side.len = sqrt(dot(vLen, vLen));
 4333: 
 4334: 
 4335:    // Compute the Coriolis coefficient
 4336: 
 4337:    if constexpr(ncor == -1 || ncor == 0) {
 4338:       side.coriolis = coricoef;
 4339:    }
 4340:    else {
 4341:       const double sphi = side.lat();  // Latitude at the center of the side
 4342: 
 4343:       assert(use_ll && "use_ll must be true when ncor > 0");
 4344: 
 4345:       if constexpr(ics == 1) {
 4346:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4347:       }
 4348:       else { // ics == 2
 4349:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4350:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4351:       }
 4352: 
 4353:    }
 4354: 
 4355: }
 4356: 
 4357: 
 4358: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4359:    double *node_coords, double *node_coords_ll, bool use_ll,
 4360:    double *wind_rotate_angle,   
 4361:    int *isdel, int *isidenode, int *isbnd,
 4362:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4363:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4364:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4365:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4366:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4367:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4368:    double *drag, double *roughness) {
 4369: 
 4370:    ELEM(pelem);
 4371:    Element &elem(*pelem);
 4372:    const int i = idx_elem;
 4373: 
 4374:    elem.idx = i;
 4375: 
 4376:    for (int j = 0; j < i34[i]; j++) {
 4377:       const int idxNode = elnode[i*4 + j];  
 4378:       const int idxSide = elside[i*4 + j];
 4379:       
 4380:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4381:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4382: 
 4383:       // Find the neighboring element  
 4384:       if (elem.sides[j]->elems[0] == &elem) {
 4385:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4386:       }
 4387:       else {
 4388:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4389:       }
 4390:       
 4391:    }
 4392: 
 4393:    elem.i34 = i34[i];
 4394: 
 4395:    // Compute the barycenter of the element and its depth
 4396:    elem.center = {0.0, 0.0};
 4397:    elem.depth = 1e10;
 4398:    for (int j = 0; j < i34[i]; j++) {
 4399: 
 4400:       elem.center += elem.nodes[j]->p/i34[i];
 4401:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4402:    }
 4403: 
 4404:    #ifdef USE_FRAMES
 4405:    elem.setFrame();
 4406:    #endif
 4407: 
 4408:    elem.area = elem.computeSignedArea(); 
 4409:    elem.radius = sqrt(elem.area)/pi; 
 4410:    
 4411:    // Determines which way the normal vector to each side is oriented.
 4412:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4413:    for (int j = 0; j < i34[i]; j++)  
 4414:    {
 4415:       if (elem.sides[j]->elems[0] == &elem) {
 4416:          elem.ssign[j] =  1.0;
 4417:       }
 4418:       else {
 4419:          elem.ssign[j] = -1.0;
 4420:       }
 4421: 
 4422:    }
 4423: 
 4424:   
 4425: 
 4426:    // Derivatives of shape functions
 4427:    //  For ics=2, this is done in the element frame
 4428:    //  For quads, the derivative is evaluated at centroid
 4429:    for (int j = 0; j < elem.i34; j++) {
 4430:       const double area = elem.area;
 4431:       const int id2 = elem.nxq(1 + j);
 4432:       const int id3 = elem.nxq(2 + j);
 4433:       const int id4 = elem.nxq(3 + j);
 4434:       if (elem.isTri()) {
 4435:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4436:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4437:          // da1/dx = (y1 - y2)/(2*area)
 4438: 
 4439:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4440:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4441:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4442: 
 4443:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4444:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4445: 
 4446:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4447: 
 4448:       }
 4449:       else  { // Quad; evaluate at centroid
 4450: 
 4451:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4452:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4453:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4454: 
 4455:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4456:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4457: 
 4458:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4459:       } // if Tri
 4460: 
 4461:    } // for j   
 4462:    
 4463:    
 4464: 
 4465: }
 4466: 
 4467: 
 4468: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4469:                                             double *emo, double *efa, 
 4470:                                             double *umo, double *ufa, 
 4471:                                             double *vmo, double *vfa,
 4472:                                             int *ifltype, int *iettype) {
 4473: 
 4474:    NODE_BND(nodeBnd);
 4475:    const int idx = idx_node_bnd;    
 4476: 
 4477:    nodeBnd->idx = idx;
 4478: 
 4479:    // Need to find the segment index and the index of the node on the segment
 4480:    int idxNode = -1;
 4481:    int iseg, i;
 4482:    for (iseg = 0; iseg < nope; iseg++) {
 4483:       // for each segment...
 4484:       for (i = 0; i < nond[iseg]; i++) {
 4485:          idxNode = iond[iseg + i*nope];
 4486:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4487:          
 4488:       }
 4489:    }
 4490: 
 4491:    assert(iseg < nope && "iseg is out of bounds");
 4492: 
 4493: found: // Jumped here when the node was found
 4494: 
 4495:    nodeBnd->isEssentialBC = true;
 4496:    nodeBnd->elbc = 0.0;
 4497: 
 4498:    nodeBnd->segment->ifltype = ifltype[iseg];
 4499:    nodeBnd->segment->iettype = iettype[iseg];
 4500: 
 4501:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4502: 
 4503:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 4504:       nodeBnd->efa[jfr] = efa[idx2];
 4505:       nodeBnd->emo[jfr] = emo[idx2];
 4506:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4507:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4508: 
 4509:    }
 4510:         
 4511: 
 4512: }
 4513: 
 4514: __device__ void Mesh::populateBoundarySideLinks(void) {
 4515: 
 4516:    SIDE_BND(sideBnd);
 4517:    const int idx = idx_side_bnd;    
 4518: 
 4519:    Side *side = sideBnd->side;
 4520: 
 4521:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4522:    // and the rightSide is the side s that has s->n1 == side->n2
 4523:    for (int i = 0; i < mesh->nbs; i++) {
 4524: 
 4525:       Side *s = &mesh->localSideData[i];
 4526: 
 4527:       if (s == side) continue;  // Do not link the side to itself
 4528:    
 4529:       if (s->n1 == side->n2) sideBnd->leftSide = s;
 4530:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4531:    }
 4532:    
 4533: }
