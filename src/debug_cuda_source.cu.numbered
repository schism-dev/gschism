  178: // Simple math functions ---------------------------------------------------------------------------
  179: 
  180: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  181: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  182: // Outputs:
  183: //        x1: first solution
  184: //        x2: second solution
  185: 
  186:        // Use float-specific absolute value for speed on GPU
  187:     const double absA = fabs(A);
  188:     const double absB = fabs(B);
  189: 
  190:     // 1. Near-linear case: a is effectively 0.
  191:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  192:     // This branch is almost never taken, so it won't hurt performance.
  193:     if (absA < 1e-14 * (absB + 1e-30)) {
  194:         const double x = -C / B;
  195:         x1 = x;
  196:         x2 = x;
  197:         return;  // Degenerate case: A = 0.
  198:     }
  199: 
  200:    const double delta = max(0.0, B*B - 4.0*A*C);
  201: 
  202:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  203:    const double s = sqrt(delta);
  204: 
  205:    // Numerically stable quadratic roots:
  206:    // q = -0.5*(B + sign(B)*sqrt(delta))
  207:    const double q = -0.5 * (B + copysign(s, B));
  208: 
  209:    x1 = q/A;
  210:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  211: 
  212: }
