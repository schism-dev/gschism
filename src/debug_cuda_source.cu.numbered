 4440:    __global__ void computeFlowBcVelocities(double time) {
 4441: 
 4442:       SIDE_BND(sideBnd);
 4443: 
 4444:       const Side *side = sideBnd->side;
 4445:  
 4446:       const bool isDry = side->isDry;
 4447:       const bool isLand = sideBnd->segment->isLand;
 4448: 
 4449:    
 4450:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4451: 
 4452:       if (isDry || isLand) return;
 4453: 
 4454:       // For wet sides in open boundaries...
 4455:       const Vector2 n = side->n;
 4456:       const BoundarySegment *segment = sideBnd->segment;
 4457: 
 4458:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4459: 
 4460:       const int ifltype = segment->ifltype;
 4461: 
 4462:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4463:       const Vector2 r_nuth0 = r_uth0*n;
 4464: 
 4465: 
 4466:       if (ifltype == 1 || ifltype == 2) {
 4467:       
 4468:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4469: 
 4470:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4471:          
 4472:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4473:          
 4474:       } else if (ifltype == -1) { // Flather 1
 4475: 
 4476:          for (int k = 0; k < nvrt; k++) {
 4477: 
 4478:             // uth is the normal vel.; no ramp up
 4479:             const double uth = sideBnd->nuth(k);
 4480:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4481: 
 4482:             sideBnd->ubc[k] += uth*n;
 4483:          }
 4484: 
 4485:       } else if (ifltype == 3 || ifltype == 5) {
 4486:          // vnth0=0 !normal vel.
 4487: 
 4488:          Vector2 r_u1_bar = {0.0, 0.0};
 4489:          // Computes the contribution to the velocity from all tide frequencies
 4490:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4491: 
 4492:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4493:             const Vector2 umo  = sideBnd->umo(jfr); 
 4494: 
 4495:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4496:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4497:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4498:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4499: 
 4500:          }
 4501: 
 4502: 
 4503:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4504: 
 4505:       } // if (ifltype = 3 || ifltype == 5
 4506: 
 4507: 
 4508: 
 4509:    }
 4510: 
 4511:    __global__ void computeElevationBoundaryConditions(double time) {
 4512:       // Compute elevation essential boundary conditions 
 4513: 
 4514:       NODE_BND(nodeBnd); // Each boundary node.
 4515: 
 4516:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4517: 
 4518:       const Node *node = nodeBnd->node;
 4519:       const BoundarySegment *segment = nodeBnd->segment;
 4520:       const int iettype = segment->iettype;
 4521:       
 4522: 
 4523:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4524:       double eic = 0.0;
 4525:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4526:       else                 eic = 0.0;
 4527: 
 4528:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4529:       const double r_eth = ramp*nodeBnd->eth;
 4530:       double r_eta1_bar = 0.0;
 4531: 
 4532: 
 4533:       // Compute tide elevation
 4534:       if (iettype == 3 || iettype == 5) {   
 4535: 
 4536:          if constexpr(iloadtide==1) { // loading tide
 4537:             assert(false && "Loading tide not implemented");
 4538:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4539:          }
 4540:          
 4541:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4542: 
 4543:             const double efa  = nodeBnd->efa[jfr]; 
 4544:             const double emo  = nodeBnd->emo[jfr]; 
 4545: 
 4546:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4547:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4548:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4549: 
 4550:          } // for jfr
 4551: 
 4552:       } // if iettype
 4553: 
 4554:       switch (iettype) {
 4555:          case 1:
 4556:          case 2:
 4557:          case 4:
 4558:             nodeBnd->elbc = r_eic + r_eth;
 4559:             break;
 4560:          case 3:
 4561:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4562:             break;
 4563:          case 5:
 4564:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4565:             break;
 4566:       } // switch
 4567: 
 4568: 
 4569:       //Add inverse barometric effects
 4570:       if (iettype != 0 && inv_atm_bnd == 1) {
 4571:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4572:       }
 4573: 
 4574:    }
 4575: 
 4576: 
 4577:    __global__ void computeHorizontalViscosity(void) { 
 4578: 
 4579:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4580: 
 4581:       SIDE(side);
 4582: 
 4583:       if (side->isDry) return;
 4584: 
 4585:       for (int k = 0; k < nvrt; k++) {
 4586:          side->nuGradU[k] = {0.0, 0.0};
 4587:       }
 4588: 
 4589:       if constexpr(ihorcon == 1) {
 4590:          for (int k = side->kb; k < nvrt - 1; k++) {
 4591:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4592:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4593:             // By Zhang and Baptista.
 4594: 
 4595:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4596:             // This is a standard discretization of the Laplacian operator.
 4597:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4598:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4599:             // Gamma is hvis_coef0 in the code.
 4600:             // The value of gamma needs to be < 0.5.
 4601: 
 4602:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4603:             // side under consideration in each of the two possible elements that share the side.
 4604:             Vector2 sumU = {0.0, 0.0};
 4605:             for (int l = 0; l < 2; l++) {
 4606:                const Element *elem = side->elems[l];
 4607: 
 4608:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4609: 
 4610:                // Find the local index of the side in the element
 4611:                const int idxSide = elem->sideLocalIdx(side);
 4612: 
 4613:                // Find the two sides that are connected to the side under consideration
 4614:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4615:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4616: 
 4617:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4618: 
 4619:             }
 4620: 
 4621:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4622: 
 4623:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4624:    
 4625:          }
 4626:       }
 4627:       else if constexpr(ihorcon == 2) {
 4628:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4629:       }
 4630: 
 4631: 
 4632:    }
 4633: 
 4634: 
 4635:    __global__ void setEssentialBC(void) {
 4636:       // Set essential boundary conditions 
 4637:       NODE(node); // Each boundary node
 4638:       NodeBoundary *nodeBnd = node->nodeBnd;
 4639:       
 4640:  
 4641:       // Check if this node has essential BC
 4642:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4643:          // Verify BC value is valid
 4644:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4645: 
 4646:        
 4647:          // Set diagonal to 1 and zero off-diagonals
 4648:          node->coeffDiag = 1.0;
 4649: 
 4650:          for (int j = 0; j < node->numNodes; j++) {
 4651:                node->coeffMatrix[j] = 0.0;
 4652:          }
 4653:          
 4654:          // Set solution and RHS to BC value
 4655:          node->mX  = nodeBnd->elbc;
 4656:          node->qel = nodeBnd->elbc;
 4657: 
 4658:       } else {
 4659:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4660: 
 4661:          for (int j = 0; j < node->numNodes; j++) {
 4662:                Node* nbNode = node->nodes[j];
 4663:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4664:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4665:                   // Verify neighbor's BC value
 4666:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4667: 
 4668:                   // Subtract contribution to RHS
 4669:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4670:                   node->coeffMatrix[j] = 0.0;  
 4671:                }
 4672:          }
 4673:       }
 4674:    }
 4675: 
 4676: 
 4677:    __global__ void updateElevation(void) {
 4678:       NODE(node);
 4679: 
 4680: 
 4681:       node->eta2 = node->mX;
 4682: 
 4683:       node->updateZCoordData();
 4684:    }
 4685: 
 4686: 
 4687:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4688: 
 4689:       SIDE(side);
 4690: 
 4691:       side->U = {0.0, 0.0}; 
 4692:          
 4693:       if(side->isDry) return;
 4694: 
 4695:       // Vertically integrated velocity U (in ll if ics=2)
 4696:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4697:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4698:          side->U += side->Dz(k + 1)*uc;  
 4699:       }
 4700: 
 4701:    }
 4702: 
 4703:    __global__ void computeBottomDragVegetation(void) {
 4704:       // UNFINISHED. CHECK THIS:
 4705:       // How many kernels are needed? Why so many for loops?
 4706:       // Is the loop on sides needed?
 4707: 
 4708:       NODE(node);
 4709: 
 4710: 
 4711:       const int    kb      = node->kb;
 4712:       const double htot    = node->htot2(); 
 4713:       
 4714:       if (node->isDry) {
 4715:          // Default values for dry nodes
 4716:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4717:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4718: 
 4719:          return;
 4720:        
 4721:       }
 4722: 
 4723:       // Computes bottom drag Cd based on the selected nchi
 4724:       node->computeBottomDragCd();
 4725:       
 4726: 
 4727: 
 4728:       //   Bottom stress in m^2/s^2
 4729:       if (node->rho[kb + 1] >= -98.0)
 4730:       {
 4731:          const double mag_u = length(node->u2[kb + 1]);
 4732:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4733: 
 4734:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4735:          // !sediment erosion: this part needs more documentation
 4736:       }
 4737:     
 4738: 
 4739: 
 4740:       // Compute vegetation parameters
 4741:       //--------------------------------
 4742: 
 4743:       // SAV constants
 4744:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4745:       constexpr double veg_cfpsi = 0.16;
 4746: 
 4747:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4748:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4749: 
 4750:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4751:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4752:          int kbin = 0; // bin index
 4753:          for (int k = kb; k < nvrt; k++) {
 4754:             // Computes node height above the bottom level
 4755:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4756:             assert(false && "Vertical variation of vegetation not implemented");
 4757: 
 4758:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4759:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4760:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4761:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4762:             // } else {
 4763:             //    // Find the bin at which the current vertical level is
 4764:             //    while (kbin<nbins_veg_vert) {
 4765:             //       const double zn = node->z[kbin];
 4766:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4767:             //          break;
 4768:             //       } // if
 4769:             //       kbin++;
 4770:             //    } // while
 4771:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4772: 
 4773:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4774:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4775:                
 4776:             //    // Linear interpolation of the vegetation parameters
 4777:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4778:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4779:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4780:             // } // if rl10
 4781: 
 4782:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4783: 
 4784:          } // for k
 4785: 
 4786: 
 4787:       } else { // Ganthy (iveg==2)
 4788:       //  Modify canopy height, diameter, and density
 4789: 
 4790:          // Make sure there is vegetation on this node
 4791:          if (node->veg_h_unbent > 0.0) {
 4792:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4793: 
 4794:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4795:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4796:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4797: 
 4798:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4799:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4800:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4801:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4802:          } // if veg_h_unbent
 4803: 
 4804:          for (int k = 0; k < nvrt; k++) {
 4805:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4806:          } // for k
 4807:       
 4808: 
 4809:       } // if iveg
 4810:      
 4811: 
 4812:       // Compute vertical mean of veg_alpha3D
 4813:       if (iveg != 0) {
 4814:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4815:          double sum1=0.0;
 4816:          double sum2=0.0;
 4817:          // Integrate over each level under the canopy...
 4818:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4819:             const double Dz = node->Dz(k);
 4820: 
 4821:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4822:             sum2 += Dz;
 4823: 
 4824:          } // for k
 4825:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4826:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4827: 
 4828:       } // if iveg
 4829: 
 4830:    }
 4831: 
 4832:    __global__ void computeVegetationAndDragParameters(void) {
 4833:       // Computes the vegetation and drag model parameters:
 4834:       // chi, \tilde\chi, beta, \breve{H}
 4835:       
 4836:       SIDE(side);
 4837: 
 4838:       side->hhat = 0.0;
 4839:       side->chi2 = 0.0;
 4840:       side->chi = 0.0;
 4841:       side->veg_c2 = 0.0;
 4842:       side->veg_beta = 0.0;
 4843: 
 4844:       if (side->isDry) return;
 4845: 
 4846:       const double htot = side->htot2();
 4847:       const int    kb   = side->kb;
 4848: 
 4849:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4850: 
 4851:       const double veg_h     = side->veg_h();
 4852:       const double veg_nv    = side->veg_nv();
 4853:       const double veg_c     = side->veg_c();
 4854:       const double veg_beta  = side->veg_beta;
 4855:       const double veg_alpha = side->veg_alpha_vert_mean();
 4856: 
 4857:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4858:       // Velocity magnitude at the bottom level
 4859:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4860:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4861:       side->chi2 = side->Cd()*vmag1;
 4862:       side->chi  = side->chi2;
 4863:       if constexpr(iveg != 0) {
 4864:          const Node *n1 = side->n1;
 4865:          const Node *n2 = side->n2;
 4866:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4867:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4868:       }
 4869: 
 4870:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4871: 
 4872:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4873:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4874:       double magUa = 0.0;
 4875:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4876:          // 3D wet side with veg...
 4877: 
 4878:          double magUa = 0.0;
 4879:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4880:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4881: 
 4882:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4883:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4884:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4885: 
 4886:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4887:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4888: 
 4889:                // Velocity magnitude at the bottom (l) of the level
 4890:                const double ul = length(side->u2[k]);
 4891: 
 4892:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4893:                magUa += Dz*0.5*(uh + ul);
 4894: 
 4895:             } // if HasVegetation
 4896:          } // for k
 4897:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4898: 
 4899:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4900:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4901:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4902:             const double zCpy = side->zTopCanopy();
 4903:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4904:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4905:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4906:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4907:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4908:          } // if isSubmerged
 4909:       } // if iveg   
 4910: 
 4911:       // Computes the friction modified depth, \breve{H} in notes
 4912:       if (side->is2D()) { // 2D
 4913: 
 4914:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4915:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4916: 
 4917:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4918: 
 4919:          side->hhat = htot*htot/fricH; 
 4920: 
 4921:       } else { // 3D
 4922:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 4923: 
 4924:          if constexpr(iveg != 0) {
 4925:             
 4926:             if (side->isSubmerged()) { 
 4927:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4928:                side->hhat -= veg_c*Hhat_alpha;
 4929: 
 4930:             } else { // Emergent
 4931:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4932:             }
 4933:          } // if iveg
 4934: 
 4935:          // Enforce positivity for 3D model
 4936:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4937:       } // if 3D
 4938: 
 4939:    }
 4940: 
 4941: 
 4942: 
 4943:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4944:    // Computes the density gradient between two elements, e1 and e2.
 4945:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4946:    // zero in the direction normal to the side. 
 4947:    // 
 4948:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4949:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4950:    //
 4951:    // Input:
 4952:    //    e1: Element
 4953:    //    e2: Neighbor element (or nullptr if boundary)
 4954:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4955:    //    k: Index of the half-level at which the density is interpolated
 4956:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4957:    // 
 4958:    // Output:
 4959:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4960:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4961: 
 4962:       if (e2 == nullptr || e2->isDry) {
 4963:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4964: 
 4965:          Side *side = e1->sides[j];
 4966:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4967:                  
 4968:          if constexpr(ics == 1) {
 4969:             vec = side->n; // Normal vector to the side
 4970:          } else {
 4971:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4972:             // IMPLEMENT THIS XXXXXX
 4973:             // !replace with xel, yel?
 4974:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4975:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4976:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4977:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4978:          } //ics
 4979:                    
 4980:          diffRho = 0.0;
 4981: 
 4982:       } else { //internal and wet
 4983:          if constexpr(ics==1) {
 4984:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4985: 
 4986:             // Vector from e1 to e2
 4987:             vec = e2->center - e1->center;
 4988: 
 4989:          } else { 
 4990:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4991:             // IMPLEMENT THIS XXXXXX
 4992:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4993:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4994:             //                   alow(j)=xctr2
 4995:             //                   bdia(j)=yctr2
 4996:          } // ics
 4997: 
 4998:          diffRho = rho2 - e1->demeanedDensity(k);
 4999:       }
 5000: 
 5001:    }
 5002: 
 5003:    __global__ void computeDensityCubicSplines(void) {
 5004:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5005: 
 5006:       ELEM(elem);
 5007: 
 5008:       if (elem->isDry) return;
 5009: 
 5010:       const int kb = elem->kb;
 5011: 
 5012:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5013:       if (elem->is2D()) {
 5014:          // In the 2D case, the density is constant at the prism level. 
 5015:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5016:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5017:       } else { //3D
 5018: 
 5019:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5020:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5021:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5022:          ///// XXXX CHECK INDICES!!!!!
 5023:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5024:       } // 2D/3D
 5025: 
 5026:    }
 5027: } // extern "C"
 5028: 
 5029: 
 5030: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5031: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5032: 
 5033:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5034: 
 5035:    const int kb  = elem->kb;
 5036:    const int kb2 = elem2->kb;
 5037: 
 5038:    // z-coordinate of prism of elem
 5039:    const double zp = elem->z_prism(k);
 5040: 
 5041:    double rho = 0.0;
 5042: 
 5043:    if (elem2->is2D()) {
 5044:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5045: 
 5046:    } else {  // 3D
 5047: 
 5048:       // eta_min may be < zmax
 5049:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5050:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5051: 
 5052:       // (Extrapolate density below bottom, we will fix it later)
 5053:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5054:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5055:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5056:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5057:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5058:    } // 2D/3D
 5059:      
 5060: 
 5061:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5062:    // Now we need to fix it.
 5063:    if (elem->z[k] < elem2->z[kb2]) {
 5064:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5065: 
 5066:       // There are two methods to adjust the density at the bottom of the element.
 5067:       // iunder_deep=0: 
 5068:       const double depth1 = abs(elem->z[kb]); // larger depth
 5069: 
 5070:       if (iunder_deep==0) {
 5071: 
 5072:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5073: 
 5074:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5075: 
 5076:       } else { // iunder_deep != 0
 5077: 
 5078:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5079: 
 5080:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5081: 
 5082:          //   Demeaned density at the same z coordinate as
 5083:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5084:          }
 5085: 
 5086:       } // if iunder_deep
 5087:    } // if elem->z[kb] < elem2->z[kb]
 5088: 
 5089:    return rho;
 5090: }
 5091: 
 5092: 
 5093: extern "C" {
 5094:    __global__ void computeDensityGradient(void) {
 5095: 
 5096:       if constexpr(ibc != 0) return;
 5097: 
 5098:          // Compute the horizontal density gradient at each element.
 5099:       // It works in two steps:
 5100:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5101:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5102:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5103:       //             gradRho.r1 = rho1 - rho0
 5104:       //             gradRho.r2 = rho2 - rho0
 5105:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5106:       // 
 5107:       //  NOTE: We use de-meaned densities.
 5108: 
 5109:       ELEM(elem);
 5110: 
 5111:       if (elem->isDry) return;
 5112: 
 5113:       const int kb  = elem->kb;
 5114:       const int i34 = elem->i34;
 5115: 
 5116:       for (int k = kb + 1; k < nvrt; k++) {
 5117:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5118:          //             gradRho.r1 = rho1 - rho0
 5119:          //             gradRho.r2 = rho2 - rho0
 5120:          int icount = 0;
 5121:          double sumRx = 0.0;
 5122:          double sumRy = 0.0;
 5123:          for (int j1=0; j1<i34; j1++) { 
 5124: 
 5125:             const int j2 = elem->nxq(j1 + 1);
 5126: 
 5127:             // Pairs of consecutive neighbor elements of elem
 5128:             const Element *e1 = elem->nghbElems[j1];
 5129:             const Element *e2 = elem->nghbElems[j2];
 5130: 
 5131:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5132:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5133:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5134: 
 5135:             // Compute the density difference and the vector from elem to e1 and e2
 5136:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5137:             double diffRho1, diffRho2;
 5138:             Vector2 vec1, vec2;
 5139:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5140:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5141: 
 5142:             const double rl1 = length(vec1);
 5143:             const double rl2 = length(vec2);
 5144:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5145: 
 5146:             const double delta = cross(vec1, vec2);
 5147:             const double sintheta = abs(delta)/(rl1*rl2);
 5148: 
 5149:             // To avoid problems, avoid elements with small angle between vectors
 5150:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5151:             const bool validEq = (sintheta > sin_one_deg);
 5152: 
 5153:             if (validEq) {
 5154:                // Solve the system of equations to get the density gradient at elem
 5155:                icount++;
 5156:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5157:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5158:                sumRx += Rx;
 5159:                sumRy += Ry;
 5160:             }
 5161:          } // for j1
 5162: 
 5163:          // Compute the average density gradient at elem
 5164:          if (icount==0) {
 5165:            // Bad mesh quality; bail out with 0 b-cc
 5166:            elem->gradRho[k] = {0.0, 0.0};
 5167:          } else {
 5168:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5169:          }
 5170: 
 5171:       } // for k
 5172: 
 5173:    }
 5174: 
 5175:    __global__ void computeBaroclinicTerm(void) {
 5176:    // Computes the baroclinic term at sides (at half levels).
 5177:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5178:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5179: 
 5180:       if (ibc == 1) return;
 5181: 
 5182:       SIDE(side);
 5183: 
 5184:       if (side->isDry) return;
 5185: 
 5186:       const Element *e1 = side->elems[0];
 5187:       const Element *e2 = side->elems[1];      
 5188:       const int kb = side->kb;
 5189:       
 5190:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5191: 
 5192:       // interpolates vertically the density gradient of the two elements at the half level/
 5193: 
 5194:       int k1 = max(kb, nvrt / 2);
 5195:       int k2 = max(kb, nvrt / 2);
 5196: 
 5197:       // Starts the integration at the surface and goes down to the bottom
 5198:       side->bcc[nvrt-1] = {0.0, 0.0};
 5199:       for (int k = nvrt - 2; k >= kb; k--) {
 5200:       // For each prism level (from surface to bottom)...
 5201: 
 5202:          // For both elements, interpolate density gradient at the side's half level.
 5203:          // The gradient at the side is the average of the gradients at the elements.
 5204:          // w1, w2 are used to take into account boundary sides, with just one element.
 5205:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5206:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5207:          const double wsum = w1 + w2;
 5208:          w1 = w1/wsum;
 5209:          w2 = w2/wsum;
 5210:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5211: 
 5212:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5213:          Vector2 gradRho = {0.0, 0.0};
 5214:          if (e1 != nullptr && k > kb) {
 5215:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5216:             
 5217:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5218:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5219:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5220: 
 5221:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5222:          }      
 5223:          if (e2 != nullptr && k > kb) {
 5224:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5225:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5226:             
 5227:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5228:          }
 5229: 
 5230:          if constexpr(ics==2) {
 5231:             assert(false && "Not implemented: ics == 2");
 5232:             // IMPLEMENT THIS XXXXXX
 5233:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5234:             // swild(1)=tmp1
 5235:             // swild(2)=tmp2
 5236:          }
 5237:          
 5238:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5239:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5240:          // CHECK INDICES!!! XXX
 5241:          const double grav3 = side->grav3();
 5242:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5243: 
 5244:       } // for
 5245: 
 5246:    }
 5247: 
 5248: 
 5249: 
 5250:    __global__ void computeHorGradientAtSide(void) {
 5251: 
 5252:       // Compute the horizontal density gradient at each element.
 5253:       // It works in two steps:
 5254:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5255:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5256:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5257:       //             gradRho.r1 = rho1 - rho0
 5258:       //             gradRho.r2 = rho2 - rho0
 5259:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5260:       // 
 5261:       //  NOTE: We use de-meaned densities.
 5262: 
 5263:       SIDE(side);
 5264: 
 5265: 
 5266:       if (side->isDry) return;
 5267: 
 5268:       // Computes the gradient of the variables at the side center.
 5269:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5270:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5271:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5272: 
 5273:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5274:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5275:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5276:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5277: 
 5278:    }
 5279: 
 5280: 
 5281:    __global__ void solveMomentumEquations(double time) {
 5282: 
 5283:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5284:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5285: 
 5286:       SIDE(side);
 5287: 
 5288:       if (side->isDry) 
 5289:       {
 5290:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5291: 
 5292:          return;
 5293:       }
 5294: 
 5295:       const Node *n1 = side->n1;
 5296:       const Node *n2 = side->n2;
 5297: 
 5298:       const int kb = side->kb;
 5299: 
 5300:       const double veg_h = side->veg_h();
 5301:       const double grav3 = side->grav3();
 5302: 
 5303:       if (side->is2D()) {
 5304:          // Remember: Do not use htot2, which is updated.
 5305:          const double htot = side->htot1();
 5306:          const double hhat = side->hhat;
 5307: 
 5308:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5309: 
 5310:          Vector2 tau2 = {0.0, 0.0};
 5311:           
 5312:          if constexpr(ics==1) {
 5313:             tau2 = side->tau();
 5314: 
 5315:          } else {
 5316:             assert(false && "Not implemented: ics == 2");
 5317:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5318:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5319:             // taux2=(vn1+tt1)*0.5d0
 5320:             // tauy2=(vn2+ss1)*0.5d0
 5321:          } // if ics         
 5322: 
 5323:          // hat_gam has units of m/s
 5324: 
 5325:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5326:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5327:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5328: 
 5329:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5330: 
 5331: 
 5332:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5333: 
 5334:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5335: 
 5336:       }
 5337:       else { // 3D
 5338: 
 5339:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5340:          // 
 5341:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5342:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5343:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5344:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5345:          // k+1 and k.
 5346: 
 5347: 
 5348:          const int ndim = nvrt - kb;
 5349:          const double zTopCanopy = side->zTopCanopy();
 5350: 
 5351:          // Initialize the tridiagonal system
 5352:          for (int k = kb + 1; k < nvrt; k++) {
 5353:             
 5354:             const int kin = k - (kb + 1);
 5355: 
 5356:             // Vertical viscosity at the face center
 5357:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5358: 
 5359:  
 5360:             alow[kin] = 0.0;
 5361:             cupp[kin] = 0.0;
 5362:             bdia[kin] = 0.0;
 5363: 
 5364:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5365:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5366: 
 5367:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5368:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5369:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5370: 
 5371:             // First part: layers k, k+1
 5372:             if (k < nvrt - 1) {
 5373:                              
 5374:                if constexpr(iveg != 0) {
 5375: 
 5376:                   // If there is vegetation at this level...
 5377:                   if (zTopCanopy > side->zc[k]) {
 5378:                      // If the canopy is above the k layer...
 5379:                      
 5380:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5381:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5382:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5383:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5384: 
 5385:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5386:                      const double vmag2 = length(ut2);
 5387:                      const double vmag1 = length(side->u2[k]);
 5388:                      const double vmag = 0.5*(vmag1 + vmag2);
 5389:                      
 5390:                      // Computes the vegetation alpha at the face center
 5391:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5392: 
 5393:                      cff1 += veg_alpha_sd*dt*vmag;
 5394: 
 5395:                   } // if (zTopCanopy
 5396:                } // if iveg
 5397: 
 5398:                const double dzz = side->Dz(k + 1);
 5399:                const double tmp = dt*dfz/dzz;
 5400:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5401: 
 5402:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5403:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5404:             }
 5405: 
 5406: 
 5407:             // Second part: layers k-1, k
 5408:             if (k > kb + 1) {
 5409: 
 5410:                double cff1 = 1.0; //init \bar{c^k}
 5411: 
 5412:                if constexpr(iveg != 0) {
 5413:                   // If there is vegetation at this level...
 5414:                   if (zTopCanopy > side->zc[k-1]) {
 5415:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5416:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5417: 
 5418:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5419: 
 5420:                      const double vmag2 = length(ut2);
 5421:                      const double vmag1 = length(side->u2[k-1]);
 5422:                      const double vmag = 0.5*(vmag1 + vmag2);
 5423: 
 5424:                      // Computes the vegetation alpha at the face center
 5425:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5426:                      cff1 += veg_alpha_sd*dt*vmag;
 5427:                   } // if zTopCanopy
 5428: 
 5429:                } // if iveg
 5430: 
 5431:                const double dzz = side->Dz(k);
 5432:                const double tmp = dt*dfz/dzz;
 5433:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5434: 
 5435:                alow[kin] += cff1*dzz/6.0 - tmp;
 5436:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5437: 
 5438:             } else { // Bottom boundary
 5439:                // This occurs at the bottom, where the bottom drag is applied.
 5440: 
 5441:                bdia[kin] += dt*side->chi2; // XXXX
 5442: 
 5443:             } // if (k > kb + 1)
 5444: 
 5445: 
 5446:          } // for (int k
 5447: 
 5448: 
 5449: 
 5450:          // Computes the RHS.
 5451:          // -----------------
 5452: 
 5453:          //	BC to be imposed at the end.
 5454: 
 5455:          const Vector2 gradETP  = side->gradETP;
 5456:          const Vector2 gradPr   = side->gradPr;
 5457:          const Vector2 gradEta1 = side->gradEta1;
 5458:          const Vector2 gradEta2 = side->gradEta2;
 5459: 
 5460:          const Vector2 *btu = side->btu;
 5461:          const Vector2 *u2  = side->u2;
 5462:          const double coriolis = side->coriolis;
 5463:          const Vector2 *nuGradU = side->nuGradU;
 5464: 
 5465: 
 5466:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5467:          for (int k = kb + 1; k < nvrt; k++) {
 5468:             const int kin = k - kb - 1;
 5469: 
 5470:             const double dz_0 = side->Dz(k);
 5471:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5472: 
 5473:             rrhs[kin] = {0.0, 0.0};
 5474:             double dz = 0.0;
 5475: 
 5476:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5477:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5478:             if (k < nvrt  ) dz += dz_1;
 5479:             if (k > kb + 1) dz += dz_0;
 5480: 
 5481:             // Elevation gradient, atmospheric pressure and tidal potential
 5482:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5483: 
 5484:             // Coriolis, advection, wind stress, and horizontal viscosity
 5485:             if (k < nvrt - 1) {
 5486: 
 5487: 
 5488:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5489:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5490:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5491:                                                 
 5492: 
 5493:                //diff stress tensors 1006
 5494:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5495:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5496:                   assert(false && "Not implemented: itur == 5");
 5497:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5498:                }
 5499:                // else assert(false && "itur # Not implemented");
 5500: 
 5501:             } else { // k == nvrt - 1 SURFACE
 5502:                Vector2 tau2 = {0.0, 0.0};
 5503:                if constexpr(ics==1) {
 5504:                   tau2 = side->tau();
 5505:       
 5506:                } else {
 5507:                   assert(false && "Not implemented: ics == 2");
 5508:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5509:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5510:                   // taux2=(vn1+tt1)*0.5d0
 5511:                   // tauy2=(vn2+ss1)*0.5d0
 5512:                } // if ics
 5513: 
 5514:                rrhs[kin] += dt*tau2;
 5515:           
 5516: 
 5517:             } // if k<nvrt
 5518: 
 5519: 
 5520:             if (k > kb + 1) {
 5521:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5522:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5523:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5524: 
 5525:                // diff stress tensors 1006
 5526:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5527:                   assert(false && "Not implemented: itur == 5");
 5528:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5529:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5530:                }
 5531:                // else assert(false && "itur # Not implemented");
 5532: 
 5533: 
 5534:             } // if k>kbs + 1
 5535: 
 5536:             // Baroclinic
 5537:             Vector2 *bcc = side->bcc;
 5538:             if constexpr(ibc == 0) {
 5539:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5540:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5541: 
 5542:             } // if ibc==0
 5543: 
 5544:          } // k=kb + 1,nvrt
 5545: 
 5546: 
 5547:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5548: 
 5549:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5550:             const int kin = k - kb - 1;
 5551:    
 5552:             // Velocity is always clamped to maximum values
 5553:             side->u2[k] = clampVelocity(soln[kin]);
 5554:          } // k
 5555: 
 5556:       } // if side->is2D()
 5557:       
 5558: 
 5559:       // Impose velocity boundary condition at the bottom
 5560:       if constexpr(imm == 2) { // 3D bed deformation model
 5561:          double dep;
 5562:          Vector2 vel;
 5563: 
 5564:          assert(false && "Not implemented: imm == 2");
 5565:          //update_bdef(time, x0, y0, dep, vel);
 5566:          // side->u2[kb] = vel;
 5567: 
 5568:       } else { // imm = 0 or 1
 5569:          if (side->Cd() == 0.0) {
 5570:             side->u2[kb] = side->u2[kb + 1];
 5571: 
 5572:          } else if (side->is3D()) { // 3D no slip bottom   
 5573:             side->u2[kb] = {0.0, 0.0};
 5574: 
 5575:          }
 5576:           
 5577:       } // if imm
 5578: 
 5579:       // The velocities below the bottom level are set to zero
 5580:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5581: 
 5582: 
 5583:    }
 5584: 
 5585: 
 5586:    __global__ void applyMomentumBC(void) {
 5587: 
 5588:       SIDE_BND(sideBnd);
 5589: 
 5590:       Side *side = sideBnd->side;
 5591:       const BoundarySegment *segment = sideBnd->segment;
 5592:       const Node *n1 = side->n1;
 5593:       const Node *n2 = side->n2;
 5594: 
 5595:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5596: 
 5597:       const bool isLand = segment->isLand;
 5598:       const int ifltype = segment->ifltype;
 5599: 
 5600:       const int kb = side->kb;
 5601: 
 5602: 
 5603:       if (!isLand && ifltype != 0) {
 5604:          const Vector2 *ubc = sideBnd->ubc;
 5605:   
 5606:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5607:             
 5608:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5609:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5610: 
 5611:             if (ifltype == -1) {
 5612:                // Flather 1
 5613: 
 5614:                const double depth = side->depth();
 5615: 
 5616:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5617: 
 5618:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5619: 
 5620:                side->u2[k] = vnorm*side->n;
 5621: 
 5622:             } else if (ifltype == -2) { // Discharge
 5623: 
 5624:                const double eta1 = side->eta1();
 5625:                const double eta2 = side->eta2();
 5626:                const double htot = side->htot2();
 5627: 
 5628:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5629:                assert(false && "Not implemented: Discharge bc");
 5630:                // const double dischrg = discharge(eta1);
 5631:                const double dischrg = 0.0; // XXX REMOVE
 5632:                
 5633: 
 5634:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5635: 
 5636:                const double vnorm = dischrg*eta2/htot;
 5637: 
 5638:                side->u2[k] = vnorm*side->n;
 5639: 
 5640:             }
 5641:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5642:                const double vnorm = dot(side->u2[k], side->n);
 5643: 
 5644:                double rat;
 5645:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5646:                else              rat = segment->vobc2; // outgoing
 5647: 
 5648:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5649: 
 5650:             }
 5651:             else { // not Flather or 3D radiation
 5652:                side->u2[k] = ubc[k];
 5653: 
 5654:             } // if (segment->ifltype...
 5655: 
 5656:          }
 5657: 
 5658:       }
 5659:       else if (isLand) { // if it is land boundary side
 5660: 
 5661:          if constexpr(islip == 0) { // free slip
 5662: 
 5663:             for (int k = kb; k < nvrt; k++) {
 5664: 
 5665:                const Vector2 t = side->t();
 5666:                const Vector2 n = side->n;
 5667: 
 5668:                double vnorm = 0.0; // for most cases
 5669:                const double vtan = dot(side->u2[k], t);
 5670:                
 5671:                side->u2[k] = vtan*t - vnorm*n;
 5672: 
 5673:             }
 5674: 
 5675:          } else { // no slip
 5676:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5677: 
 5678:          }
 5679:       } // if (side segment type...
 5680: 
 5681:    
 5682: 
 5683:    }
 5684: 
 5685: 
 5686:    __global__ void shapiroFilter1(void) {
 5687:       // First step of the Shapiro filter (normally used if indvel<=0)
 5688:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5689: 
 5690:       SIDE(side);
 5691: 
 5692:       // Only internal wet sides are processed
 5693:       if (side->isDry || !(side->isInternal())) return;
 5694: 
 5695:       const int kb = side->kb;
 5696: 
 5697:       for (int mm = 0; mm < niter_shap; mm++) {
 5698: 
 5699:          for (int k = kb + 1; k < nvrt; k++) {
 5700:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5701:             Vector2 suru = {0.0, 0.0};
 5702: 
 5703:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5704: 
 5705:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5706: 
 5707:                int kin = k;
 5708:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5709:                
 5710:                if constexpr(ics==1) {
 5711:                   suru += nSide->u2[kin];
 5712: 
 5713:                } else {
 5714:                   assert(false && "Not implemented: ics == 2");
 5715:                   // Vector2 vn1, vn2;
 5716:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5717:                   // suru=suru+vn1;
 5718:                   // surv=surv+vn2;
 5719:                }
 5720:             }
 5721: 
 5722:             // Reusing bcc as a temporary array to store the suru values.
 5723:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5724: 
 5725:          }
 5726:       }
 5727:    }
 5728: 
 5729:    __global__ void shapiroFilter2(void) {
 5730:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5731: 
 5732:       SIDE(side);
 5733: 
 5734: 
 5735:       if (side->isDry || !(side->isInternal())) return;
 5736: 
 5737:       const int kb = side->kb;
 5738: 
 5739:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5740: 
 5741:       if (side->is2D()) {
 5742:          side->u2[kb + 1] = side->bcc[kb + 1];
 5743:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5744: 
 5745:       } else {
 5746:          // 3D
 5747:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5748:          
 5749:       }
 5750: 
 5751:    }
 5752: 
 5753: 
 5754:    __global__ void ul0UpdateZCoords(void) {
 5755:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5756:       
 5757:       NODE(node);      
 5758: 
 5759: 
 5760:       if (false) { //node->isDry) { XXXXXXX
 5761: 
 5762:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5763: 
 5764:          if constexpr(ivcor != 1) node->kb = 0;
 5765: 
 5766:       } else {
 5767: 
 5768:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5769:          node->updateKb();
 5770: 
 5771:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5772: 
 5773:       }
 5774: 
 5775:       // We use the temp.b field to store the previous state of isDry.
 5776:       node->tmp.b = node->isDry;
 5777: 
 5778:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5779:       node->isDry = true;
 5780: 
 5781:    }
 5782: 
 5783:    __global__ void ul0ComputeDryElements(void)
 5784:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5785:    {
 5786:       ELEM(elem);
 5787: 
 5788:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5789: 
 5790:       elem->kb = 0;
 5791: 
 5792:       if (elem->isDry) return;
 5793: 
 5794: 
 5795:    //    if(elem->isDry2()) { // XXXX
 5796:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5797:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5798:    //        call parallel_abort(errmsg)
 5799:    //    }
 5800: 
 5801:       const Node *n1 = elem->nodes[0];
 5802:       const Node *n2 = elem->nodes[1];
 5803:       const Node *n3 = elem->nodes[2];  
 5804:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5805: 
 5806:       // Computes element's kb as the minimum of the nodes' kb.
 5807:       const int kb1 = n1->kb;
 5808:       const int kb2 = n2->kb;
 5809:       const int kb3 = n3->kb;
 5810:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5811: 
 5812: 
 5813:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5814: 
 5815: 
 5816:       // Computes the element z as the mean of the nodes z.
 5817:       for (int k = elem->kb; k < nvrt; k++) {
 5818: 
 5819:          // Compute the element z as the mean of the nodes z.
 5820:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5821:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5822:          elem->z[k] /= elem->i34;
 5823: 
 5824:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5825:       }
 5826:                   
 5827:    }
 5828: 
 5829:    __global__ void ul0ComputeDryNodes(void)
 5830:    // Updates node's isDry based on the elements' isDry. 
 5831:    {
 5832:       NODE(node);
 5833: 
 5834:       node->isDry = true;
 5835: 
 5836:       // A node is wet if at least one of the elements sharing it is wet.
 5837:       for (int j = 0; j < node->numElements; j++) {
 5838:          const Element *elem = node->elements[j];
 5839:          if (!elem->isDry) {
 5840:             node->isDry = false;
 5841:             break;
 5842:          }
 5843:       }
 5844: 
 5845:        
 5846:    }
 5847: 
 5848: 
 5849:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5850:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5851:    // node->tmp.b is true if the node was previously dry.
 5852:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5853:    {
 5854:       NODE(node);
 5855:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5856: 
 5857:       // Avoid this the first time step.
 5858:       if (it == iths) return;  
 5859: 
 5860:       const bool wasDry = node->tmp.b;
 5861: 
 5862: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5863: 
 5864:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5865: 
 5866:          for (int k=0; k < nvrt; k++) {
 5867: 
 5868:             Vector3 utmp={0.0, 0.0, 0.0};
 5869: 
 5870:             double ttmp=0.0;
 5871:             double stmp=0.0;
 5872:             int icount=0;
 5873:             for (int j = 0; j < node->numNodes; j++) {
 5874: 
 5875:                const Node *nbrNode = node->nodes[j];
 5876:                
 5877:                const bool wasNbrDry = nbrNode->tmp.b;
 5878: 
 5879:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5880:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5881: 
 5882:                   icount++;
 5883: 
 5884:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5885:                   utmp += nbrNode->uvw2(k);
 5886:                   
 5887:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5888:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5889:                }
 5890:             }
 5891: 
 5892:             if (icount > 0) {
 5893:                const double inv_icount = 1.0/icount;
 5894:                utmp = inv_icount*utmp;
 5895:                node->u2[k]     = toVector2(utmp);
 5896:                node->w2[k]     = utmp.z;
 5897:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5898:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5899:             } else {
 5900:                node->u2[k] = {0.0, 0.0};
 5901:                node->w2[k] = 0.0;
 5902:                // Initialize tracers to 0.0??? XXXXX
 5903:             }
 5904:          }
 5905:       }
 5906:    }
 5907: 
 5908:   
 5909:    
 5910: 
 5911: 
 5912:    __global__ void ul0UpdateSides(int it, int iths) {
 5913:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5914:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5915:    // The dryness of the sides is updated in ul0UpdateSides2.
 5916: 
 5917:       SIDE(side);
 5918: 
 5919:       // A side is wet if and only if at least one of its elements is wet.
 5920:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5921:  
 5922:       const Node *n1 = side->n1;
 5923:       const Node *n2 = side->n2;
 5924:      
 5925:       const int kb1 = n1->kb;
 5926:       const int kb2 = n2->kb;
 5927: 
 5928:       side->kb = 0; // default when dry
 5929: 
 5930:       if (isWet) {
 5931: 
 5932:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5933: 
 5934:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5935: 
 5936:          side->kb = min(kb1, kb2);
 5937: 
 5938:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5939: 
 5940:          for (int k = side->kb; k < nvrt; k++) {
 5941:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5942: 
 5943:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5944: 
 5945:             // Compute velocity for re-wetted sides 
 5946:             if ((it != iths) && (side->isDry && isWet)) {
 5947: 
 5948:                Vector2 utmp={0.0, 0.0};
 5949: 
 5950:                int icount=0;
 5951: 
 5952:                // For all the sides on the two elements that share this side
 5953:                for (int j = 0; j < 2; j++) {
 5954:                   const Element *elem = side->elems[j];
 5955:                   if (elem == nullptr) continue;
 5956: 
 5957:                   for (int jj=0; jj < elem->i34; jj++) {
 5958:                      const Side *nSide = elem->sides[jj];
 5959:                      if (nSide->isDry) continue;
 5960: 
 5961:                      icount++;
 5962:                      utmp += nSide->u2[k];  
 5963:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5964:                   }
 5965:                }
 5966:                   
 5967:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 5968:                if (icount > 0)  side->u2[k] = utmp/icount;
 5969:                else             side->u2[k] = {0.0, 0.0};
 5970:                   
 5971:             } // if ((it != iths) && (side->isDry && isWet))
 5972: 
 5973:          } // for k
 5974: 
 5975:       } // if isWet 
 5976:       
 5977: 
 5978: 
 5979:    }
 5980: 
 5981:    __global__ void ul0UpdateSides2(void) {
 5982:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5983:    
 5984:          SIDE(side);
 5985:    
 5986:          const Element *e1 = side->elems[0];
 5987:          const Element *e2 = side->elems[1];
 5988: 
 5989:          // A side is wet if and only if at least one of its elements is wet.
 5990:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5991: 
 5992:          // Update the side's dryness
 5993:          side->isDry = !isWet;
 5994: 
 5995:    }
 5996: 
 5997: 
 5998:    __global__ void zeroNodalVelocities(void) {
 5999:       NODE(node);
 6000: 
 6001:       for (int k = 0; k < nvrt; k++) {
 6002:          node->u2[k]   = {0.0, 0.0};
 6003:          node->w2[k]   = 0.0;
 6004:          node->utmp[k] = {0.0, 0.0};
 6005:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6006:       }
 6007:    }
 6008:  
 6009: 
 6010:    __global__ void computeNodalVerticalVelocities1(void) {
 6011:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6012:    // Adds the element's vertical velocity times the element's area.
 6013:       ELEM(elem);
 6014: 
 6015:       for (int j = 0; j < elem->i34; j++) {
 6016:          Node *node = elem->nodes[j];
 6017: 
 6018:          for (int k = node->kb; k < nvrt; k++) {
 6019:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6020:          }
 6021:          atomicAdd(&(node->tmp.d), elem->area);
 6022:       }
 6023:    }
 6024: 
 6025:    __global__ void computeNodalVerticalVelocities2(void) {
 6026:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6027:    // Divides by the total area of the elements sharing the    node.
 6028:       NODE(node);
 6029: 
 6030:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6031: 
 6032:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6033:    }
 6034: 
 6035: 
 6036:    __global__ void computeNodalHorizontalVelocities1(void) {
 6037: 
 6038:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6039:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6040: 
 6041:       ELEM(elem);
 6042: 
 6043:       if (elem->isDry) return;
 6044: 
 6045:       const int kb = elem->kb;
 6046:       const bool isTri = elem->isTri();
 6047: 
 6048:       if constexpr(indvel <= 0) {
 6049:          // Assuming discontinous hvel.
 6050: 
 6051:          if (isTri) { // For triangles
 6052:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6053:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6054: 
 6055:             for (int j = 0; j < 3; j++) {
 6056:                // For every node of the triangle...
 6057:                Node *node = elem->nodes[j];
 6058: 
 6059:                if (node->isDry) continue;
 6060: 
 6061:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6062:                const Side *s2 = elem->sides[(j + 1) % 3];
 6063:                const Side *s3 = elem->sides[(j + 2) % 3];
 6064: 
 6065:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6066: 
 6067:                atomicAdd(&(node->tmp.i), 1);
 6068: 
 6069:                for (int k = kb; k < nvrt; k++)  {
 6070:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6071:                   u = clampVelocity(u);
 6072:                   atomicAdd(&(node->utmp[k].x), u.x);
 6073:                   atomicAdd(&(node->utmp[k].y), u.y);
 6074: 
 6075:                }
 6076: 
 6077:             }
 6078:          }
 6079:          else { // For quads
 6080:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6081: 
 6082:          }
 6083: 
 6084:       }
 6085:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6086:       
 6087:    }
 6088: 
 6089: 
 6090:    __global__ void computeNodalHorizontalVelocities2(void) {
 6091:       NODE(node);
 6092: 
 6093:       const int nodeCount = node->tmp.i;
 6094: 
 6095:       if (nodeCount == 0) 
 6096:       {
 6097:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6098:          return;
 6099:       }
 6100: 
 6101:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6102:       
 6103:       const int kb = node->kb;
 6104: 
 6105:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6106:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6107:       
 6108:       
 6109:    }   
 6110: 
 6111:  
 6112: 
 6113:    __global__ void resetVelocityOpenBndNodes(void) {
 6114:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6115: 
 6116:       NODE_BND(nodebnd);
 6117: 
 6118:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6119:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6120:       }
 6121: 
 6122:    }
 6123: 
 6124: 
 6125:    __global__ void setVelocityOpenBndNodes(void) {
 6126:    // For open boundary nodes sets their velocity to the imposed values.
 6127: 
 6128:       SIDE_BND(sidebnd);
 6129: 
 6130:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6131:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6132:          // to its segment to the average of the side velocity.
 6133: 
 6134:          for (int k = 0; k < nvrt; k++) {
 6135:             Node *n1 = sidebnd->side->n1;
 6136:             Node *n2 = sidebnd->side->n2;
 6137: 
 6138: 
 6139:             Vector2 n1_u2(n1->u2[k]);
 6140:             Vector2 n2_u2(n2->u2[k]);
 6141: 
 6142:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6143:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6144:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6145:             }
 6146:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6147:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6148:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6149:             }
 6150: 
 6151:          }
 6152: 
 6153:       }
 6154: 
 6155:    }
 6156: 
 6157: 
 6158:    __global__ void computeVerticalVelocity(void) {
 6159:       // Computes the vertical velocity at the (2D) element's centroid.
 6160:       // In this function we will be considering volumetric elements, with side faces and a 
 6161:       // bottom and a top face. We will call them SFs, BF and TF.
 6162:       // It computes the flux coming from BF and the SFs.
 6163:       // If the bed is moving, it takes that into account.
 6164:       // Since water is incompressible, the integral of the velocity times the normal vector
 6165:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6166:       // and the BF is equal to the flux going out from the TF.
 6167:       // TF = - BF - sum(SFs).
 6168:       // It then computes the horizontal velocity at the center of TF.
 6169:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6170:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6171:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6172: 
 6173:       ELEM(elem);
 6174: 
 6175:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6176: 
 6177:       if (elem->isDry) return;
 6178: 
 6179:       const int kb = elem->kb;
 6180:       const bool isTri = elem->isTri();
 6181: 
 6182:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6183: 
 6184:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6185:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6186:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6187: 
 6188:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6189: 
 6190:       double area3D;
 6191: 
 6192:       // Bottom face flux
 6193:       double bottomFlux = 0.0;
 6194:       Vector2 u2meanBottom = {0.0, 0.0};
 6195:       const Vector2 gradh = elem->grad2(&Node::depth);
 6196:       if constexpr(imm==2) {
 6197:          Vector3 ubed;
 6198: 
 6199:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6200:          // updateBDEF(ubed);
 6201:      
 6202:          // const double bflux0 = dot(ubed, elem_n1);
 6203: 
 6204:          // elem->w[kb] += ubed.z;
 6205:       }
 6206:       else {
 6207:          Vector2 umean;
 6208:          if constexpr(ics == 1) {
 6209:             u2meanBottom = elem->mean(kb, &Side::u2);
 6210:          }
 6211:          else {
 6212:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6213:          }
 6214: 
 6215:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6216:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6217: 
 6218:          bottomFlux = - dot(gradh, u2meanBottom);
 6219:       } // if imm
 6220: 
 6221:       // Compute w for kb+1 to nvrt-1
 6222:       for (int l = kb; l < nvrt - 1; l++) {
 6223: 
 6224:          // normal vector to the top face of the "volumetric" element (3D)
 6225:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6226: 
 6227:          // Compute the total flux at the sides
 6228:          double sideFlux = 0.0;
 6229: 
 6230:          for (int j = 0; j < elem->i34; j++) {
 6231:             const Side *side = elem->sides[j];
 6232: 
 6233:             const double sideArea = side->area(l);
 6234:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6235:             const double sign = elem->ssign[j]; 
 6236: 
 6237:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6238:          }
 6239:          
 6240:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6241:          //velocities at the centers of the sides
 6242:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6243: 
 6244:          // The flx at the top ace can be computed from the other flows.
 6245:          const double topFlux = - sideFlux - bottomFlux;
 6246:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6247: 
 6248:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6249: 
 6250:          elem_n1 = elem_n2;
 6251: 
 6252:          bottomFlux = - topFlux;
 6253:       }
 6254:    }  
 6255: 
 6256: 
 6257: 
 6258: 
 6259: 
 6260: 
 6261: 
 6262: // !===============================================================================
 6263: // !===============================================================================
 6264: 
 6265: } // extern "C"
 6266: 
 6267: #ifdef DONTCOMPILE
 6268: __device__ void computeVerticalAdvection(void) {
 6269:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6270: 
 6271:    sdbt(1:2,:,:)=0.d0
 6272: 
 6273:    const Side *side = FROM kernel;
 6274: 
 6275:    if(side->isDry) return;
 6276: 
 6277:    // If side is wet...
 6278: 
 6279: 
 6280:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6281:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6282:    double ws[nvrt] = {} // w @ side
 6283:    int icount = 0;
 6284:    for (int j=0; j<2; j++) {
 6285:       const Element *elem = side->elements[j];
 6286:        
 6287:       if(elem != nullptr) {
 6288:          icount++;
 6289:          for (int k=0; k<nvrt; k++) {
 6290:             ws[k] = ws[k] + elem->w[k];
 6291:          }
 6292:       }
 6293:    }  // for j
 6294: 
 6295:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6296:    ws = ws/icount;
 6297: 
 6298:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6299:    // Splines allow for a smooth transition between vertical levels.
 6300:    // Splines have continuity restrictions at the internal knots, but
 6301:    // we have to provide the 1st derivatives at the endpoints.
 6302:    const int kbs = side->kbs; 
 6303:    
 6304:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6305:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6306:    initCubicSpline(kbs, nvrt, side, ws, up)
 6307: 
 6308:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6309:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6310:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6311: 
 6312:    // Total advection (average onto side)
 6313:    const Node *node1 = side->nodes[0];
 6314:    const Node *node2 = side->nodes[1];
 6315:    for (int k=kbs(i); k<nvrt; k++) {
 6316: 
 6317:       if constexpr(ics==1) {
 6318:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6319:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6320:       } else {
 6321:          // XXX IMPLEMENT THIS
 6322:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6323:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6324:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6325:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6326:       }  // if ics
 6327: 
 6328: 
 6329:    }
 6330: }
 6331: #endif
 6332: 
 6333: 
 6334: extern "C" {
 6335:    __global__ void computeElemAverageGhat(void) {
 6336:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6337: 
 6338:       ELEM(elem);
 6339:       
 6340:       elem->ghat1= {0.0, 0.0};  
 6341: 
 6342:       if constexpr(ihydraulics != 0) {
 6343:          if (nhtblocks > 0 && elem->isblock) return;
 6344:       }
 6345: 
 6346: 
 6347: 
 6348:       
 6349:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6350:       // tidal potential, horizontal diffusion, and baroclinic etc
 6351:       // Remember to update both fb and F 
 6352:       // If ics=2, ghat1 are in eframe (ll)
 6353:       // cff1-3: coefficients for 2D/3D
 6354:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6355:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6356:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6357: 
 6358:       if (elem->isDry) return;
 6359: 
 6360:       double av_cff1 = 0.0;  // av. for cff1
 6361:       double av_cff2 = 0.0;  // av. for cff2
 6362:       double av_cff3 = 0.0;  // av. for cff3
 6363:       double av_df = 0.0;  // av. for H^\alpha / H
 6364:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6365:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6366: 
 6367:       const int i34 = elem->i34;
 6368:       const int kb = elem->kb;
 6369: 
 6370:       for (int j=0; j<i34; j++) {
 6371:          // For each node and side in the element...
 6372: 
 6373:          const Node *node = elem->nodes[j];
 6374:          const Side *side = elem->sides[j];
 6375: 
 6376:          const double chi      = side->chi;
 6377:          const double veg_c2   = side->veg_c2;
 6378:          const double veg_beta = side->veg_beta;
 6379:          const double veg_h    = side->veg_h();
 6380:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6381: 
 6382:          // Node - const in elem
 6383:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6384:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6385: 
 6386:          if (elem->depth >= tip_dp) {
 6387:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6388:          }
 6389: 
 6390:          
 6391:          const double htot  = side->htot2();        // Total depth at the side
 6392:          const double zctr2 = side->zTopCanopy();  
 6393: 
 6394:          double cff1; 
 6395:          double cff2; 
 6396:          double cff3;   
 6397:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6398:          // coefficients applied to 2D/3D case 
 6399:             cff1 = side->hhat/htot;
 6400:             cff2 = 0.0;
 6401:             cff3 = 0.0;
 6402:          } else { //3D
 6403:             //Init for no-veg case
 6404:             cff1 = 1.0;
 6405:             cff2 = 1.0;
 6406:             cff3 = 0.0;
 6407: 
 6408:             if constexpr(iveg != 0) {
 6409:                // Computes coefficients used with vegetation terms G1, G2
 6410:                // cff1, cff3 are used for the first two terms in G1, G2:
 6411:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6412:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6413:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6414:                if(veg_h < 0.99*htot) { // submergent vegetation
 6415:                   cff1=1;
 6416:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6417:                   cff3 = veg_c;
 6418: 
 6419:                } else { // emergent vegetation
 6420:                   cff1 = 1.0/(1.0 + veg_c2);
 6421:                   cff2 = cff1;
 6422:                   cff3 = 0.0;
 6423: 
 6424:                }
 6425:             } // if iveg
 6426:          } //  2D/3D
 6427: 
 6428:          av_cff1 += cff1/i34;
 6429:          av_cff2 += cff2/i34;
 6430:          av_cff3 += cff3/i34;
 6431:          av_cff2_chi += cff2*chi/i34;
 6432:          av_cff3_chi += cff3*chi/i34;
 6433:          av_df += min(htot, veg_h)/(htot*i34);
 6434: 
 6435: 
 6436:          // btrack values: U^\star, U^{\star\alpha}
 6437:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6438:          Vector2 Ustar       = {0.0, 0.0}; 
 6439:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6440: 
 6441:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6442:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6443:          } else { //3D
 6444:             for (int k = side->kb + 1; k < nvrt; k++) {
 6445:             
 6446:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6447:                Ustar += w2;
 6448: 
 6449:                if constexpr(iveg != 0) {
 6450:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6451:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6452:                        Ustar_alpha += zrat*w2; // XXXX
 6453:                    }
 6454:                }  // if iveg
 6455:             }  // for k
 6456:          }  //2D/3D
 6457:          
 6458: 
 6459:          // Add btrack & surface stress terms to \breve{G} first
 6460:          if constexpr(ics==1) {
 6461: 
 6462:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6463: 
 6464:          } else {
 6465:             assert(false && "computeElemAverageGhat: Not implemented");
 6466:             // XXX IMPLEMENT THIS
 6467:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6468:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6469:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6470:          }  // if ics
 6471: 
 6472:          // Surface and bottom stress terms
 6473:          if constexpr(ics==1) {
 6474:             const Vector2 tau    = side->tau();
 6475:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6476: 
 6477:             // Term for surface and bottom stress
 6478:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6479: 
 6480:          } else {
 6481:             assert(false && "computeElemAverageGhat: Not implemented");
 6482:             // XXX IMPLEMENT THIS
 6483:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6484:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6485:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6486:             // tau_x=(vn1+tt1)/2.d0
 6487:             // tau_y=(vn2+ss1)/2.d0
 6488:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6489:          }  // if ics
 6490: 
 6491:          
 6492: 
 6493:          // All terms in F,F^\alpha,f_b except baroclinic
 6494:          // F, f_b: all explicit terms excluding vegetation 
 6495:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6496:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6497:          const double coriolis = side->coriolis;
 6498:          Vector2 F  =  coriolis*side->U;  // F_x
 6499:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6500:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6501: 
 6502:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6503:             
 6504:             for (int k = side->kb; k < nvrt; k++) {
 6505:                if (zctr2 > side->zc[k-1]) {
 6506:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6507:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6508:                    Fa +=  coriolis*w2*zrat;
 6509:                } // if zctr2
 6510:             } // k
 6511:          } // iveg
 6512: 
 6513:          // Integrate horizontal viscosity force vertically
 6514:          for (int k=side->kb + 1; k<nvrt; k++) {
 6515:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6516: 
 6517:             F += levelHorVisc;
 6518: 
 6519:             // Vegetation term
 6520:             if constexpr(iveg!=0) {
 6521:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6522:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6523:                   Fa += levelHorVisc*zrat;
 6524:                } 
 6525:             } // if iveg
 6526:          } // for k
 6527: 
 6528:          fb += side->nuGradU[side->kb];
 6529: 
 6530:          // Add to ghat1
 6531:          if constexpr(ics==2) {
 6532:             assert(false && "computeElemAverageGhat: Not implemented");
 6533:             // XXX IMPLEMENT THIS
 6534:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6535:             // bigf1=vn1; bigf2=vn2
 6536:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6537:             // botf1=vn1; botf2=vn2
 6538:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6539:             // bigfa1=vn1; bigfa2=vn2
 6540:          } // if ics
 6541: 
 6542:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6543:       } // for j (nodes and sides)
 6544: 
 6545:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6546:          
 6547:       // Finish off terms in F, F^\alpha and f_b
 6548:       const double grav3 = elem->mean(&Node::grav2);
 6549:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6550: 
 6551: 
 6552:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6553:       for (int j=1; j<i34; j++) { 
 6554:          // For each side in the element...
 6555:          const Side *side = elem->sides[j];
 6556:          const double chi = side->chi;
 6557: 
 6558:          const double htot = side->htot2();
 6559:          const double veg_h = side->veg_h();
 6560:          const Vector2 F  = htot*fb;
 6561:          const Vector2 Fa = min(htot, veg_h)*fb;
 6562: 
 6563:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6564:       } // for j
 6565: 
 6566:       //botf1 etc are already in elem frame
 6567:       elem->ghat1 += tmp/i34;
 6568: 
 6569:       // Baroclinic force
 6570:       if constexpr(ibc==0) {
 6571:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6572: 
 6573:          Vector2 Fa = {0.0, 0.0};
 6574:          Vector2 intGradRho = {0.0, 0.0};
 6575:          
 6576:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6577:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6578:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6579: 
 6580:             // \in F [m^2/s/s]
 6581:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6582:          }
 6583: 
 6584:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6585:          const Vector2 F = av_df*Fa; //approx
 6586:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6587: 
 6588:       } // if ibc
 6589: 
 6590: 
 6591: 
 6592:    }
 6593: 
 6594: } // extern "C"
 6595: 
 6596: 
 6597: 
 6598: #ifdef DONTCOMPILE
 6599: __global__ void checkMassConservation(Tracers* sumtr) {
 6600: 
 6601:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6602: 
 6603:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6604: 
 6605:    Element *elem = &(mesh->localElemData[i]);
 6606: 
 6607:    // Skip dry elements
 6608:    if (elem->isDry) return;
 6609: 
 6610:    // Local sum array for this thread
 6611:    double localSum[N_TRACERS] = {0.0};
 6612: 
 6613:    // Sum over vertical levels for this element
 6614:    const int kbe = elem->kbe;
 6615:    const double area = elem->area;
 6616: 
 6617:    for (int k = kbe; k < nvrt; k++) {
 6618:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6619:       
 6620:       // Accumulate tracer mass
 6621:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6622:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6623:       }
 6624:    }
 6625: 
 6626:    //  This function returns per element sums. A reduction must be done on the host side.
 6627: }
 6628: 
 6629: 
 6630: __global__ void transport(void) {
 6631: 
 6632:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6633: 
 6634:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6635: 
 6636:    Element *elem = &(mesh->localElemData[ie]);
 6637: 
 6638:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6639: 
 6640:                for (int m=0; m<ntr; m++) {
 6641:                   for (int k=kbe(ie); k<nvrt; k++) {
 6642:                      // Calculate each polynomial's weight 
 6643:                      wm=0.d0; sum1=0.d0; 
 6644:                      wm1=0.d0; wm2=0.d0; 
 6645:                      for (int i=0; i<elem->nweno2; i++) {
 6646:                   
 6647:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6648:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6649:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6650:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6651:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6652:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6653:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6654:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6655:                      // -----------------Hu and Shu (1999)'s method----------------
 6656:                      b4=b1+b2+b3
 6657: 
 6658: //Error: add PRODUCTION CPP
 6659: #ifdef DEBUG
 6660:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6661:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6662:                     call parallel_abort(errmsg)
 6663:                   }
 6664: #endif
 6665: 
 6666:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6667:                   // !----test-------------- 
 6668:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6669:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6670:                   // !wm(i)=wm1(i)*wm2(i)
 6671:                   // !---------------------- 
 6672:                   sum1=sum1+wm(i)
 6673:                 } // end for i
 6674: 
 6675:                 wm=wm/sum1
 6676: 
 6677:                 for (int j=0; j<elem->i34; j++) {
 6678: 
 6679:                   const Side *side  = elem->sides[j];
 6680:                   const Node *node1 = side->n1;
 6681:                   const Node *node2 = side->n2;
 6682: 
 6683:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6684:                      trsd=0.d0
 6685:                      for (int kk=0; kk<nquad; kk++) {
 6686:                         for (int i=0; i<elem->nweno2; i++) {
 6687:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6688:                         } // end for i   
 6689:                      } // end for kk
 6690:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6691:                   } // outward flux
 6692:                } // end for j=1,i34(ie) ! side
 6693:             }
 6694:          }
 6695:               
 6696: 
 6697: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6698: //             //   calculate each polynomial's weight 
 6699: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6700: //                 wm=0.d0; sum1=0.d0
 6701: //                 do i=1,nweno1(ie) !for each polynomial
 6702: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6703: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6704: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6705: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6706: //                   wm(i)=b2
 6707: //                   sum1=sum1+b2
 6708: //                   !wm(i)=1.d0
 6709: //                   !sum1=sum1+1.d0
 6710: 
 6711: // // Error: PRODUCTION
 6712: // #ifdef DEBUG
 6713: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6714: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6715: //                     call parallel_abort(errmsg)
 6716: //                   endif
 6717: // #endif
 6718: 
 6719: //                 enddo !i
 6720: //                 wm=wm/sum1 !final weight
 6721: 
 6722:                 for (int j=0; j<elem->i34; j++) { // side
 6723:                   const Side *side = elem->sides[j];
 6724:                   const Node *node1 = side->n1;
 6725:                   const Node *node2 = side->n2;
 6726: 
 6727:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6728:                     trsd=0.d0
 6729:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6730:                       for (int i=0; i<elem->nweno1; i++) {
 6731:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6732:                       }
 6733:                     enddo //kk
 6734:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6735:                   } // outward flux
 6736:                 } // end for j=1,i34(ie) ! side
 6737:               } // end for k; ntr 
 6738: 
 6739:             else !simple upwind method
 6740:               do j=1,i34(ie)
 6741:                 jsj=elside(j,ie)
 6742:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6743:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6744:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6745:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6746:                   endif
 6747:                 enddo  !vertical layers
 6748:               enddo !j=1,i34(ie) ! side
 6749:             endif !order of accuracy
 6750: 
 6751:          //  enddo !ie
 6752: // !$OMP     end do
 6753: 
