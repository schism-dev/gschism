 7682: 
 7683: __global__ void computeMatrixProductAndDotProducts() {
 7684:    // Computes A*p, r'Mr and p'Ap
 7685: 
 7686:    // 1) shared buffer: first half for rMr, second for pAp
 7687:    __shared__ double sdata[2*BLOCK_SIZE];
 7688:    double* s_rMr = sdata;
 7689:    double* s_pAp = sdata + BLOCK_SIZE;
 7690: 
 7691:    const int tid = threadIdx.x;
 7692: 
 7693:    double l_pAp = 0.0;
 7694: 
 7695:    s_rMr[tid] = 0.0;
 7696:    s_pAp[tid] = 0.0;
 7697: 
 7698:    // 2) get your node pointer
 7699:    // NODE(node);   
 7700:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7701:    Node *node = &(mesh->localNodeData[idx_node]); 
 7702:       if (idx_node < mesh->np) {
 7703: 
 7704:       const double diag = node->coeffDiag;
 7705:       const double r    = node->mR;
 7706:       const double p    = node->mP;  
 7707: 
 7708:       // apply preconditioner on the fly:
 7709:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7710: 
 7711:       // 4) compute Ap = A.p
 7712:       double Ap = node->coeffDiag * node->mP;
 7713:       for (int j = 0; j < node->numNodes; ++j) {
 7714:          const Node *nbNode = node->nodes[j];
 7715:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7716: 
 7717:       }
 7718: 
 7719:       node->mAp = Ap;
 7720:       
 7721: 
 7722:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7723:       // const double l_rMr = r*Mr;  // r'Mr
 7724:       l_pAp = p*Ap;  // p'Ap
 7725: 
 7726: 
 7727:    }
 7728: 
 7729:    // 6) write into shared mem
 7730:    // s_rMr[tid] = l_rMr;
 7731:    s_pAp[tid] = l_pAp;
 7732: 
 7733:    __syncthreads();
 7734: 
 7735:    // 7) block-wide tree reduction
 7736:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7737:       if (tid < stride)  {
 7738:          s_pAp[tid] += s_pAp[tid + stride];
 7739:       }
 7740:       __syncthreads();
 7741:    }
 7742: 
 7743:    // 8) thread 0 atomically accumulates into the globals
 7744:    // XXX: This is slower than it needs to be, but it is simple and works
 7745:    if (tid == 0) {
 7746:       atomicAdd(pAp, s_pAp[0]);
 7747:    }
 7748: 
 7749: 
 7750: }
 7751: 
 7752: 
 7753: __global__ void updateSolutionAndDotProducts(void) {
 7754:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7755: 
 7756:    const int tid = threadIdx.x;
 7757: 
 7758:    s_rMr[tid] = 0.0;
 7759: 
 7760:    // get node & bounds-check:
 7761:    NODE(node);
 7762: 
 7763:    
 7764:    // Compute alpha
 7765:    const double alpha = (*rMr_old)/(*pAp); 
 7766: 
 7767: 
 7768:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7769: 
 7770: 
 7771:    // load scalars
 7772:    const double diag = node->coeffDiag;
 7773:    const double p    = node->mP;
 7774:    const double Ap   = node->mAp;
 7775:    const double x    = node->mX;
 7776:    const double r    = node->mR;
 7777:    
 7778:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7779: 
 7780:    // 1) update solution & residual
 7781:    const double x_new = x + alpha*p;
 7782:    const double r_new = r - alpha*Ap;
 7783:    node->mX = x_new;
 7784:    node->mR = r_new;
 7785: 
 7786:    // 2) apply Jacobi preconditioner on the fly
 7787:    const double Mr_new = r_new/diag;
 7788: 
 7789: 
 7790:    // 3) local contributions for the two dot-products
 7791:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7792: 
 7793:    // 4) write into shared-mem
 7794:    s_rMr[tid] = l_rMr;
 7795: 
 7796:    __syncthreads();
 7797: 
 7798: 
 7799:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7800:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7801:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7802:       __syncthreads();
 7803:    }
 7804: 
 7805:    // 6) thread 0 atomically folds into the global accumulators
 7806:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7807: 
 7808: 
 7809: }
 7810: 
 7811: 
 7812: __global__ void updateSearchDirection() {
 7813: 
 7814:     NODE(node);
 7815: 
 7816:     // recompute z on-the-fly
 7817:     const double z = node->mR / node->coeffDiag;
 7818:     const double p = node->mP;
 7819: 
 7820:     const double beta = (*rMr_new)/(*rMr_old);
 7821: 
 7822: 
 7823:     // p =z + beta*p
 7824:     node->mP = z + beta*p;
 7825: 
 7826: }
 7827: 
 7828: __global__ void initializeScalars(double *scalars) {
 7829: 
 7830:    // These point to a cupy array in the host code
 7831:    rMr_old = scalars + 0;
 7832:    rMr_new = scalars + 1;
 7833:    pAp     = scalars + 2;
 7834: }
 7835: 
 7836: __global__ void initializePreconditionedResidual(void) {
 7837: 
 7838:     __shared__ double s_rMr[BLOCK_SIZE];  
 7839: 
 7840:     s_rMr[threadIdx.x] = 0.0;
 7841: 
 7842:     NODE_ALL(node, valid);
 7843:     const int tid = threadIdx.x;
 7844:     // For the first iteration:
 7845:     // 1. Initial solution x = 0 (already set)
 7846:     // 2. Initial residual r = b (stored in qel)
 7847:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7848: 
 7849: // XXX we should use the guess solution here    
 7850: 
 7851:     double l_rMr = 0.0;
 7852:     if (valid) {
 7853:       // Set initial residual r = b (from qel)
 7854:       node->mR = node->qel;
 7855: 
 7856:       // Compute z = M^-1 * r (preconditioned residual)
 7857:       const double z = node->mR / node->coeffDiag;
 7858: 
 7859:       // Set initial search direction p = z
 7860:       node->mP = z;
 7861: 
 7862:       // Initialize other variables needed for CG
 7863:       node->mX = 0.0;  // Initial solution
 7864:       node->mAp = 0.0; // Will be computed in first iteration
 7865: 
 7866: 
 7867:       // Computes the first r'Mr (reduction)
 7868:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7869:     }
 7870:     // 4) write into shared-mem
 7871:     s_rMr[tid] = l_rMr;
 7872: 
 7873:     __syncthreads();
 7874: 
 7875: 
 7876:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7877:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7878:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7879:         __syncthreads();
 7880:     }
 7881: 
 7882:     // 6) thread 0 atomically folds into the global accumulators
 7883:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7884: 
 7885:     *rMr_old = 0.0;
 7886:     *pAp = 0.0;
 7887: }
 7888: 
 7889: 
