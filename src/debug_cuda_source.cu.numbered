  899:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  900:       // Convert local coordinates to global coordinates
  901:       printf("NOT IMPLEMENTED: localToGlobal\n");
  902:       return true;
