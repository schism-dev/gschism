 4902: 
 4903:    __global__ void rollUpElevation(void) {
 4904: 
 4905:       NODE(node);
 4906: 
 4907:       node->eta1 = node->eta2;
 4908: 
 4909:    }
 4910: 
 4911: 
 4912:    __global__ void backtrackAllNodes(void) {
 4913: 
 4914:       // max/min # of sub-divisions
 4915:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4916:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4917: 
 4918: 
 4919:       SIDE(side);
 4920: 
 4921:       const int kb = side->kb;
 4922: 
 4923: 
 4924:       // Initialize btrack velocities to the actual velocities at the side 
 4925:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4926:   
 4927: 
 4928:       if (side->isDry) return;
 4929:      
 4930: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4931: 
 4932:       // Checks that at least one element is not dry
 4933:       const Element *elem1 = side->elems[0];
 4934:       const Element *elem2 = side->elems[1];
 4935: 
 4936: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4937: 
 4938:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4939:       
 4940:       // XXXXXX
 4941:       // !swild_tmp to store global coord. of the starting side
 4942:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4943:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4944:       // !Use sframe2 
 4945:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4946: 
 4947: 
 4948:       for (int k = kb; k < nvrt; k++) {
 4949:       //  Initialize (xt,yt,zt), nnel and vel.
 4950:       //  For ics=2, the coordinates are all in the side's local frame
 4951:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4952: 
 4953:          const int iadvf = side->iadv();  // Advection flag   
 4954:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4955: 
 4956:          // If on land or open boundary...
 4957:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4958:          
 4959:          const double vmag = length(side->u2[k]);
 4960: 
 4961:          if (vmag <= velmin_btrack) {
 4962:             // No activity 
 4963: 
 4964:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4965: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4966: 
 4967:             
 4968:          } else {  // do btrack
 4969: 
 4970:             // Compute number of sub-divisions based on local gradients of the velocity field
 4971: 
 4972:             // XXX IS THIS NECESSARY?
 4973:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4974:             double suma = 0.0;
 4975:             int icount = 0;
 4976:             for (int l=0; l<2; l++) {
 4977:             // For each element sharing the side...
 4978: 
 4979:                const Element *elem = side->elems[l];
 4980:                  
 4981:                if (elem == nullptr) continue;
 4982: 
 4983:                icount++;
 4984: 
 4985:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4986:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4987:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4988: 
 4989:                double utmp[4];
 4990:                double vtmp[4];
 4991:                for (int j = 0; j < elem->i34; j++) {
 4992: 
 4993:                   const Node *node = elem->nodes[j];
 4994: 
 4995:                   if constexpr(ics==1) {
 4996:                      utmp[j] = node->u2[k].x;
 4997:                      vtmp[j] = node->u2[k].y;  
 4998: 
 4999:                   } else {
 5000:                      // 'Project' the velocity from the node frame to the element frame
 5001:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5002:                      utmp[j] = tmp_u2.x;
 5003:                      vtmp[j] = tmp_u2.y;
 5004: 
 5005:                   }
 5006:                } // for j
 5007: 
 5008:                const Vector2 grad_u = elem->grad2(utmp); 
 5009:                const Vector2 grad_v = elem->grad2(vtmp);
 5010:    
 5011:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5012:             } // for ii
 5013: 
 5014:             assert(icount > 0 && "Impossible 77");
 5015: 
 5016:             // '4' is somewhat arbitrary
 5017:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5018:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5019:             Vector3 u_int = {0.0, 0.0, 0.0};
 5020: 
 5021:             bool res =side->btrack(k, dt, dtbk, u_int);
 5022: 
 5023:             side->btu[k] = toVector2(u_int);
 5024:                
 5025:          } // if vmag (do backtrack)
 5026: 
 5027: 
 5028:       } // for k=kb,nvrt-1
 5029: 
 5030:    }
 5031: 
 5032: } // extern "C"
 5033: 
 5034: template<int nc>
 5035: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5036: 
 5037: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 5038: //
 5039: // a,b,c,rhs: input vectors and are not modified by this program.
 5040: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 5041: // rhs is the r.h.s.
 5042: // n: actual rank of the system.
 5043: // rows in u() and rhs();
 5044: // u: output with nc columns (transposed to rows)
 5045: // gam: a working array.
 5046: //
 5047: // NOTES:
 5048: // This is a template function that allows for different numbers of columns in the rhs vector.
 5049: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 5050: 
 5051:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5052:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5053: 
 5054:    double bet = b[0];
 5055:    if constexpr (nc == 1) {
 5056:       u[0] = rhs[0]/bet;
 5057:    } else {
 5058:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5059:    }
 5060: 
 5061:    for (int j = 1; j < n; j++) {
 5062:       gam[j] = c[j - 1]/bet;
 5063:       bet = b[j] - a[j]*gam[j];
 5064: 
 5065:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5066: 
 5067:       if constexpr (nc == 1) {
 5068:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5069:       } else {
 5070:          for (int l = 0; l < nc; l++) {
 5071:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5072:          }
 5073:       }
 5074:    }
 5075: 
 5076:    // Back-substitution
 5077:    for (int j = n - 2; j >= 0; j--) {
 5078:       if constexpr (nc == 1) {
 5079:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5080:       } else {
 5081:          for (int l = 0; l < nc; l++) {
 5082:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5083:          }
 5084:       }
 5085:    }
 5086: }
 5087: 
 5088: 
 5089: 
 5090: // Helper function that contains the core algorithm
 5091: template<typename XAccessor, typename YAccessor>
 5092: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5093:                                     double  yp_top, double  yp_bot, 
 5094:                                     CubicSpline &spline) {
 5095:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5096:    // 
 5097:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5098:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5099:    //
 5100:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5101:    // 
 5102:    // Inputs: 
 5103:    //            n: dimension for x etc; # of data pts (>=2);
 5104:    //            getX, getY: functions to access x,y coordinates
 5105:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5106:    //     Output: 
 5107:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5108: 
 5109:    const int n = k2 - k1 + 1;
 5110:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5111: 
 5112:    // Allocate memory for the splines
 5113:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5114:    spline.x   = new double[n];
 5115:    spline.y   = new double[n];
 5116:    spline.yp  = new double[n];
 5117:    spline.ypp = new double[n];
 5118: 
 5119:    for (int k=k1; k<=k2; k++) {
 5120:       spline.x[k] = getX(k);
 5121:       spline.y[k] = getY(k);
 5122:    }
 5123: 
 5124:    // This is to simplify expressions later
 5125:    double *x = spline.x;
 5126:    double *y = spline.y;
 5127: 
 5128:    double *a = nullptr;
 5129:    double *b = nullptr;
 5130:    double *c = nullptr;
 5131:    double *gam = nullptr;
 5132:    double *rhs = nullptr;
 5133:    
 5134: 
 5135:       a = new double[n];   // Lower diagonal
 5136:       b = new double[n];   // Diagonal
 5137:       c = new double[n];   // Upper diagonal
 5138:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5139:       rhs = new double[n]; // Right-hand side
 5140: 
 5141:    for (int k=k1; k<=k2; k++) {
 5142:       if (k == k1) {
 5143:          // Bottom level
 5144:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5145:          b[k] = (x[k+1] - x[k])/3.0;
 5146:          c[k] = b[k]/2.0;
 5147:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5148:       } else if (k == n - 1) {
 5149:          // Top level (surface)
 5150:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5151:          b[k] = (x[k] - x[k-1])/3.0;
 5152:          a[k] = b[k]/2.0;
 5153:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5154:       } else {
 5155:          // Intermediate levels
 5156:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5157:          b[k] = (x[k+1] - x[k-1])/3.0;
 5158:          a[k] = (x[k  ] - x[k-1])/6.0;
 5159:          c[k] = (x[k+1] - x[k  ])/6.0;
 5160:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5161:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5162:       }
 5163:    }
 5164: 
 5165:    // Solve the tridiagonal system
 5166:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5167:    
 5168:    spline.yp[k1] = yp_bot;
 5169:    spline.yp[k2] = yp_top;
 5170: 
 5171:    // Compute rest of 1st derivatives using the splines
 5172:    for (int k=k1+1; k<k2; k++) {
 5173:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5174:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5175:    }
 5176:    
 5177:    delete[] a;
 5178:    delete[] b;
 5179:    delete[] c;
 5180:    delete[] gam;
 5181:    delete[] rhs;
 5182: 
 5183: }
 5184: 
 5185: // Array version
 5186: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5187:                                 double y_top, double y_bot, 
 5188:                                 CubicSpline &spline) {
 5189:    auto getX = [x] (int k) { return x[k]; };
 5190:    auto getY = [y] (int k) { return y[k]; };
 5191:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5192: }
 5193: 
 5194: // Lambda version - allows custom access patterns
 5195: template<typename XFunc, typename YFunc>
 5196: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5197:                                 double y_top, double y_bot,
 5198:                                 CubicSpline &spline) {
 5199:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5200: }
 5201: 
 5202: 
 5203: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 5204: {
 5205:    assert("Not implemented");
 5206: 
 5207:    return 0.0;
 5208: }
