 7585: extern "C" __global__ void populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 7586:    double *node_coords, double *node_coords_ll, bool use_ll, double *wind_rotate_angle, 
 7587:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7588:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
