 3481: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3482:    if constexpr(ics == 1) {
 3483:       return center;
 3484: 
 3485:    } else {
 3486:       const Point2 p0 = n1->outputCoords();
 3487:       const Point2 p1 = n2->outputCoords();
 3488:       return (1.0/2.0)*(p0 + p1);
 3489: 
 3490:    }
 3491: }
 3492: 
 3493: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3494: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3495: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3496: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3497: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3498: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3499: __inline__ __device__ Point3  Side::p3_t(double t) const { return {x(t), y(t), z(t)}; }
 3500: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3501: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3502: // Computes the gradient of the field at the side center.
 3503:    Vector2 grad = {0.0, 0.0};
 3504:    int count = 0;
 3505: 
 3506:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3507:    // as the average of the gradients at each element.
 3508:    // First element
 3509:    if (elems[0] != nullptr && condition(elems[0])) {
 3510:       Vector2 elemGrad = elems[0]->grad2(field);
 3511: 
 3512:       // For ics=2, projects the element gradient from its frame to the side frame
 3513:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3514: 
 3515:       grad += elemGrad;
 3516: 
 3517:       count++;
 3518:    }
 3519: 
 3520:    // Second element
 3521:    if (elems[1] != nullptr && condition(elems[1])) {
 3522: 
 3523:       Vector2 elemGrad = elems[1]->grad2(field);
 3524: 
 3525:       // For ics=2, projects the element gradient from its frame to the side frame
 3526:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3527: 
 3528:       grad += elemGrad;
 3529: 
 3530:       count++;
 3531:    }
 3532: 
 3533:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3534:    if (count > 0) {
 3535:       grad = grad*(1.0/count);
 3536:    }
 3537:    
 3538:    return grad;
 3539: }
 3540: 
 3541: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3542: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3543: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3544: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3545: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3546: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3547: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3548: 
 3549: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3550: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3551: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3552: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3553: 
 3554: 
 3555: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3556: 
 3557: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3558:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3559:    if constexpr(ics == 1) { 
 3560:       return 0.5*(n1->tau + n2->tau);
 3561: 
 3562:    } else {
 3563:       // Project the tau from the node frames to the side frame
 3564:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3565:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3566: 
 3567:       return 0.5*(stau1 + stau2);
 3568:    }
 3569: }
 3570: 
 3571: /**
 3572:  * This method performs backtracking from the side center until a time -dt back in time 
 3573:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3574:  * intermediate point.
 3575:  *
 3576:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3577:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3578:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3579:  * remaining time.
 3580:  * 
 3581:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3582:  * 
 3583:  * @param uuint, vvint, wwint: Velocities at the final point
 3584:  * @param jlev: Level at which the backtracking is performed
 3585:  * @param dt, dtbk: Tracking timesteps
 3586:  * @return: True if the backtracking was successful, false otherwise
 3587:  */
 3588: __inline__ __device__ bool Side::btrack(
 3589:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3590:       double dt,            // Tracking time
 3591:       double dtbk,          // Tracking timestep
 3592:       Vector3 &u_int        // Velocities at the initial point
 3593: ) const {
 3594: 
 3595:    // Start from side center
 3596:    Point3 x0;
 3597: 
 3598:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3599:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3600: 
 3601:  
 3602:    double time_rm = dt; // Remaining time
 3603: 
 3604: 
 3605:    // Initial velocities
 3606:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3607: 
 3608:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3609:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3610: 
 3611:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3612: 
 3613: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3614: 
 3615: 
 3616:    const int MAX_ITERATIONS = 200; 
 3617:    Element* nextElem = nullptr;
 3618:    int iter = 0;
 3619:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3620:    while(true) {
 3621: 
 3622:       // Calculate timestep
 3623:       double dtb = min(dtbk, time_rm);
 3624: 
 3625:       // Next point in the backtracking curve
 3626:       xt = x0 - dtb*u_int;
 3627: 
 3628: // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3629: 
 3630:       Side *lastCrossSide = nullptr;
 3631:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide);
 3632: 
 3633:       // This means that the walk reached a boundary or a dry element.
 3634:       // This case is addressed at the end of the loop.
 3635:       if (!found) {
 3636: 
 3637:          // FIND CROSSING POINT xtp ON BOUNDARY SEGMENT
 3638:          // COMPUTE DISTANCE dtb = distance(x0, xtp) / length(u_int).
 3639:          // time_rm -= dtb;
 3640:          // MOVE time_rm along the boundary.
 3641:          time_rm = 0.0;
 3642:          u_int = {0.0, 0.0, 0.0};
 3643:          return true;
 3644:       }
 3645: 
 3646:       time_rm -= dtb; // if celestialWalk terminates early (if it intersects a boundary or a dry element),
 3647:                       // then time_rm needs to be increased by the unused time.
 3648: 
 3649:       u_int = nextElem->interpolateVelocities(xt, this);
 3650: 
 3651:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 3652: 
 3653:       // If the velocity is too small, we stop the backtracking
 3654:       const double vmag = length(toVector2(u_int));
 3655:       if (vmag <= velmin_btrack) break;
 3656: 
 3657:       // The current point becomes the next segment's starting point.
 3658:       x0 = xt;
 3659:  
 3660:       curElem = nextElem;
 3661: 
 3662:       iter++;
 3663: 
 3664:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3665:    }
 3666: 
 3667:    assert(curElem != nullptr && "Final element is nullptr");
 3668:    assert(!curElem->isDry && "Final element is dry");
 3669: 
 3670: // const Point3 p0 = toLocalFrame(toPoint3(curElem->nodes[0]->p, curElem->nodes[0]->gz));
 3671: // const Point3 p1 = toLocalFrame(toPoint3(curElem->nodes[1]->p, curElem->nodes[1]->gz));
 3672: // const Point3 p2 = toLocalFrame(toPoint3(curElem->nodes[2]->p, curElem->nodes[2]->gz));
 3673: // Vector3 xt_Before = xt;
 3674: // curElem->nudgeToBarycenter(toPoint2(xt), this);
 3675: // Vector3 xt_After = xt;
 3676: // showPoints(xt_Before, xt_After, jlev, this, 0x00006Fu, '+', 2, 10, iter);
 3677: // if (!curElem->containsPoint(toPoint2(xt), this)) printf("side->idx = %d, (%.16f,%.16f),(%.16f,%.16f),(%.16f,%.16f)  xt = (%.17f, %.17f, %.17f)\n", idx, p0.x, p0.y, p1.x, p1.y, p2.x, p2.y, xt.x, xt.y, xt.z);
 3678: 
 3679: 
 3680: 
 3681:    // Interpolate the velocities at the final point
 3682:    u_int = curElem->interpolateVelocities(xt, this);
 3683: 
 3684:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 3685: 
 3686: 
 3687: }
 3688: 
 3689: 
 3690: 
 3691: // /**
 3692: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 3693: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 3694: 
 3695: //    Inputs:
 3696: //    @param x1, y1: point inside the element
 3697: //    @param x2, y2: other end of the line segment
 3698: 
 3699: //    Outputs:
 3700: //    @param intersectingSide:  side that intersects the line segment
 3701: //    @param nextElement: element that contains the intersection point
 3702: //    @param xIntersect, yIntersect: intersection point  
 3703: 
 3704: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 3705: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 3706: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 3707: 
 3708: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 3709: //    (Delta) being zero.
 3710: 
 3711: //    The intersection point happens when:
 3712: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 3713: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 3714:    
 3715: //    Assumption: the 4 points (including those of the side segment) are different.
 3716: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 3717: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 3718: //    If true, (xIntersect,yIntersect) is the intersection.				
 3719: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 3720: // **/
 3721: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 3722: //                                                          Side& intersectingSide, Element& nextElement,
 3723: //                                                          double& xIntersect, double& yIntersect) {
 3724: //    for (int i = 0; i < i34; i++) {
 3725: //       const double x3 = nodes[i]->x;
 3726: //       const double y3 = nodes[i]->y;
 3727: //       const double x4 = nodes[nxq(i+1)]->x;
 3728: //       const double y4 = nodes[nxq(i+1)]->y;
 3729: 
 3730: //       const Side& side = sides[i];
 3731: 
 3732: //       xIntersect=-1.e25;
 3733: //       yIntersect=-1.e25;
 3734: 
 3735: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 3736: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 3737: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 3738: 
 3739: //       if (delta != 0.0) {
 3740: //          // Solves the two linear equations for tt1 and tt2
 3741: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 3742: //          const double tt2 = delta2/delta;
 3743: 
 3744: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 3745: //          // Similarly, we use tt2 to compute the intersection point.
 3746: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 3747: //             xIntersect = x3 + (x4 - x3)*tt2;
 3748: //             yIntersect = y3 + (y4 - y3)*tt2;
 3749: 
 3750: //             intersectingSide = side;
 3751: //             nextElement = nghbElems[i];
 3752: 
 3753: //             return true;
 3754: //          }
 3755:       
 3756: //       }
 3757: //       else {
 3758: //          // The two segments are parallel
 3759: //          return false;
 3760: //       }
 3761: 
 3762: //    }
 3763: 
 3764: //    return false;
 3765: 
 3766: // }
