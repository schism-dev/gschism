  671: template<TurbulenceModel Model>
  672: struct Turbulence {
  673:    __device__ void setDiffLimits(double, double) { /* The default implementation does nothing */ };
  674: 
  675:    __device__ void init(Node *node) {
  676:       for (int k = 0; k < nvrt; k++) {
  677:          node->dfv[k] = dfv0;
  678:          node->dfh[k] = dfh0;
  679:       }
  680:    }
