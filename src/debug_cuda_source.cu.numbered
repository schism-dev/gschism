 1078: // This struct is used to store the boundary information for a node.
 1079: struct NodeBoundary {   
 1080:    BoundarySegment *segment;
 1081:    Node *node;
 1082:    
 1083:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1084:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1085: 
 1086:    bool isLand;
 1087: 
 1088:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1089:    double elbc;   // Elevation boundary condition
 1090:    double eth;    // Elevation time history
 1091: 
 1092:    double eta_mean; // Mean elevation at nodes
 1093: 
 1094:    bool isEssentialBC;
 1095: 
 1096:    Vector2 uth[nvrt];  // "Time history" velocity
 1097: 
 1098:    // Arrays for harmonic constituents (if needed)
 1099:    double  emo[nbfr];  // Elevation amplitude
 1100:    double  efa[nbfr];  // Elevation phase
 1101:    Vector2 umo[nbfr];  // velocity amplitude
 1102:    Vector2 ufa[nbfr];  // velocity phase
 1103: 
 1104: 
 1105:    NodeBoundary(void) {
 1106:       isLand = false;
 1107:    }
 1108:    NodeBoundary(bool _isLand) {
 1109:       isLand = _isLand;
 1110:    }
 1111: 
 1112:    
 1113:    __forceinline__ __device__ int numSidesForAverage() const {
 1114:    // Returns the number of sides that are connected to the node and have the same segment.
 1115:    // This is used to compute the average velocity at the node for open boundary nodes.
 1116:       int res = 0;
 1117:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1118:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1119: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1120:       return res;
 1121:    }
 1122: 
 1123: 
 1124:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1125:       assert(index == 0 || index == 1); 
 1126:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1127:    }
 1128: 
 1129: 
 1130: };
