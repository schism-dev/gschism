 8010:          break;
 8011:       // case (int)VarCode::depth:
 8012:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 8013:       //    *sizeType = sizeof(double);
 8014:       //    break;         
 8015:       case (int)VarCode::x:
 8016:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 8017:          *sizeType = sizeof(Vector2);
 8018:          break;
 8019:       case (int)VarCode::len:
 8020:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 8021:          *sizeType = sizeof(double);
 8022:          break;
 8023:       case (int)VarCode::kb:
 8024:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 8025:          *sizeType = sizeof(int);
 8026:          break;
 8027:       case (int)VarCode::isdry:
 8028:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8029:          *sizeType = sizeof(int);
 8030:          break;            
 8031:       case (int)VarCode::w:
 8032:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8033:          *sizeType = sizeof(double);
 8034:          break;
 8035:       case (int)VarCode::u:
 8036:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8037:          *sizeType = sizeof(Vector2);
 8038:          break;   
 8039:       case (int)VarCode::n1:
 8040:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8041:          *sizeType = sizeof(Node);
 8042:          break;
 8043:       case (int)VarCode::n2:
 8044:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8045:          *sizeType = sizeof(Node);
 8046:          break;                   
 8047:       default:
 8048:          *offset = -1;
