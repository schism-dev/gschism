 1620: __device__ __forceinline__ void update_bdef(double time, double x0, double y0, double &dep, Vector3 &vel) {
 1621:    // For imm=2, user needs to update bottom depth and velocity
 1622: 
 1623:    dep = min(1.0, 7.0 - (x0 + time));
 1624:    vel = { -1.0, 0.0, 0.0 };
