 5388: 
 5389:       if constexpr(nws != 0 && iwindoff != 0) {
 5390:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5391:       }
 5392: 
 5393:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5394:       node->setWind(wind);
 5395: 
 5396:       node->pr = pressAir[idx];
 5397:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5398: 
 5399:    }
