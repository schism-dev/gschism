 1952: struct Mesh {
 1953:    public:  
 1954: 
 1955:    int partNum; // Partition number for this mesh.
 1956: 
 1957:    // Pointers to each GPU's local memory (size is the number of partitions).
 1958:    Node**    nodes;  
 1959:    Element** elems;  
 1960:    Side**    sides;  
 1961:    
 1962:    // Local memory
 1963:    Node*    localNodeData; 
 1964:    Element* localElemData;
 1965:    Side*    localSideData; 
 1966: 
 1967:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1968:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1969:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1970:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1971:    
 1972:    const int npgb;  // Global number of horizontal nodes
 1973:    const int negb;  // Global number of elements
 1974:    const int nsgb;  // Global number of sides
 1975: 
 1976:    const int np;   // Local number of horizontal nodes 
 1977:    const int ne;   // Local number of elements
 1978:    const int ns;   // Local number of sides
 1979: 
 1980:    int nbp;  // Local number of boundary nodes
 1981:    int nbs;  // Local number of boundary sides
 1982: 
 1983:    int nEntries;  // Total number of matrix elements
 1984: 
 1985:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1986:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1987:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1988: 
 1989:   
 1990:    // Additional topology information
 1991:    Node    **nodeNeighNodes;     // Array of pointers to the nodes neighbors of each node
 1992:    Element **nodeNeighElems;     // Array of pointers to the elements neighbors of each node
 1993:    int16_t *nodePermutationSort; // Array of indices for the array nodes such that neighbors nodes are sorted in increasing order of their global index.
 1994: 
 1995:    BoundarySegment *landBoundarySegment;
 1996:    NodeBoundary *landBoundaryNode;
 1997: 
 1998:    // Vertical coordinate system
 1999:    // Sigma levels
 2000:    double h_s; 
 2001:    double h_c; 
 2002: 
 2003:    double theta_b;
 2004:    double theta_f, sinh_theta_f;
 2005:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 2006:    double *ztot;
 2007:    double *cs;
 2008:    double *dcs;
 2009: 
 2010: 
 2011: 
 2012:    __device__ Mesh(int partNum,
 2013:                    int npgb, int negb, int nsgb, 
 2014:                    int np, int ne, int ns,
 2015:                    int max_np, int max_ne, int max_ns, int nseg,
 2016:                    NodeBoundary *plandNodeBndMem, BoundarySegment *plandSegMem,
 2017:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 2018:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 2019:                    Node    **localNodeNeighNodesMem,
 2020:                    Element **localNodeNeighElemsMem,
 2021:                    int16_t *localNodePermutationSortMem,
 2022:                    double *partCoeffMatrixMem,
 2023:                    NodeBoundary *localNodeBoundaryMem,
 2024:                    SideBoundary *localSideBoundaryMem,
 2025:                    BoundarySegment *localSegmentMem,
 2026:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 2027:                    double *cs, double *dcs
 2028:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 2029:                        np(np), ne(ne), ns(ns),
 2030:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 2031:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 2032:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 2033:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 2034:                        nodePermutationSort(localNodePermutationSortMem), coeffMatrixMem(partCoeffMatrixMem),
 2035:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 2036:                        localSegmentMem(localSegmentMem),
 2037:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 2038:                        cs(cs), dcs(dcs),
 2039:                        landBoundarySegment(plandSegMem),
 2040:                        landBoundaryNode(plandNodeBndMem)
 2041:    {
 2042:       printf("Mesh constructor for partition %d\n", partNum);
 2043: 
 2044:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 2045:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 2046:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 2047:  
 2048:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 2049:       
 2050:       sinh_theta_f = sinh(theta_f);
 2051: 
 2052:       *landBoundaryNode    = NodeBoundary(true);
 2053:       *landBoundarySegment = BoundarySegment(true);   
 2054: 
 2055:    }
 2056: 
 2057:    __device__ void populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2058:                   double *node_coords, double *node_coords_ll, bool use_ll,
 2059:                   double *wind_rotate_angle, 
 2060:                   int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2061:                   int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2062:                   int16_t *nodePermutationSort, double *crs_data,
 2063:                   int *localNodeNeighNodesStart, int *localNodeNeighElemsStart,
 2064:                   int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2065:                   int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2066:                   int *localNodePart,     int *localElemPart,     int *localSidePart,
