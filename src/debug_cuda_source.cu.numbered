  867: 
  868:    
  869:    __forceinline__ __device__ void projectNodeVectorsToElementFrame(Vector2 *v) const;
  870:    __forceinline__ __device__ void projectSideVectorsToElementFrame(Vector2 *v) const;
  871: 
  872: 
  873:    template<typename T>
  874:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const;
  875: 
  876:    template<typename T>
  877:    __device__ __forceinline__ T interpolate(const double shapeCoords[4], T Node::* field) const;
  878: 
  879:    template<typename T>
  880:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const;
  881: 
  882:    template<typename T>
