  778: template<>
  779: struct LocalSigma<2> {
  780:    __device__ double operator[](int k) const { return 0.0; }
  781:    __device__ double& operator[](int k) { assert(false && "LocalSigma<2>: by reference operator[] not implemented"); return (double &)*((double *)nullptr); }
  782: };
