 7346: __global__ void printMatrix(void) {
 7347:    // Debugging: print the matrix
 7348: 
 7349:    const int size = mesh->np;
 7350:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7351:       const Node *node = mesh->localNodeData + idx_node;
 7352:       printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7353:       for (int j = 0; j < node->numNodes; j++) {
 7354:          Node* nbNode = node->nodes[j];
 7355:          if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7356:       }
 7357:       printf("]\n");
 7358: 
 7359:    }
 7360: 
 7361: }
