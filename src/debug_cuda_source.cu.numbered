 1593: 
 1594: 
 1595: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1596:                                               double &t, double& tIntersect) {
 1597: 
 1598:    double closest_intersect_t = 1e10;
 1599:    bool found_intersection = false;
 1600: 
 1601: double minDelta = 1e10; 
 1602: double btt1, btt2;
 1603:    for (int i = 0; i < i34; i++) {
 1604: 
 1605:       Side *side2 = sides[i];
 1606: 
 1607:       // (x3,y3)-(x4,y4) is the element side line
 1608:       const Point2 x3 = side2->n1->p2();
 1609:       const Point2 x4 = side2->n2->p2();
 1610: 
 1611:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1612:       const double delta = cross(x2 - x1, x3 - x4);
 1613: 
 1614:       if (abs(delta) > 0) {
 1615: 
 1616:          const double delta1 = cross(x3 - x1, x3 - x4);
 1617:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1618: 
 1619:          // Solves the two linear equations for tt1 and tt2
 1620:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1621:          const double tt2 = delta2/delta;
 1622: 
 1623: if (abs(delta) < minDelta) {
 1624:    minDelta = abs(delta);
 1625:    btt1 = tt1;
 1626:    btt2 = tt2;
 1627: }
 1628: double small = 1e-7;
 1629:          printf("RRRRRR tt1 = %e, tt2 = %e\n", tt1, tt2);
 1630:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1631:             closest_intersect_t = min(closest_intersect_t, tt1);
 1632:             side = side2;
 1633:             nextElement = side->otherElem(this);
 1634:             t = tt2;
 1635:             tIntersect = max(small, min(tt1, 1.0-small));
 1636:             found_intersection = true;
 1637:          }
 1638:       
 1639:       }
 1640:       else {  // parallel segments
 1641:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1642:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1643: 
 1644:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1645: 
 1646:          // const double dist = dot(x1 - x3, side2->n);
 1647:          // if (abs(dist) < small*length(x3 - x4)) {
 1648:          //    const double2 unitarySide = normalize(x4 - x3);
 1649:          //    const double len = dot(x2 - x1, unitarySide);
 1650:          //    t = t + len;
 1651:          //    t = max(0.0, min(t, 1.0));
 1652:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1653: 
 1654: 
 1655:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1656:          //    // t = tt2;
 1657:          //    found_intersection = true;
 1658:          // }
 1659:       }
 1660: 
 1661: 
 1662:    }
 1663: 
 1664:    if (!found_intersection) {
 1665:       
 1666:       printf("ZZ No intersection found:\n"
 1667:            "Element %d\n"
 1668:            "in = %d\n"
 1669:            "minDelta = %e\n"
 1670:            "tt1 = %e, tt2 = %e\n"
 1671:            "segment: (%f, %f)-(%f, %f)\n"
 1672:            "Vertices:\n"
 1673:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1674:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1675:            IDX(nextElement),
 1676:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1677:            minDelta,
 1678:            btt1, btt2,
 1679:            x1.x, x1.y,
 1680:            x2.x, x2.y,
 1681:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1682:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1683:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1684:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1685:            nodes[0]->p.x, nodes[0]->p.y,
 1686:            nodes[1]->p.x, nodes[1]->p.y,
 1687:            nodes[2]->p.x, nodes[2]->p.y,
 1688:            nodes[0]->p.x, nodes[0]->p.y);
 1689: 
 1690:    }
 1691: 
 1692:    // assert(found_intersection && "No intersection found");
 1693: 
 1694:    // found_intersection should always be true, since we checked all the sides.  
 1695:    return found_intersection;
 1696: }
