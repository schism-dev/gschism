  429: 
  430: 
  431: struct Frame {
  432:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  433:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  434:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  435:     double t00, t10;        // col0 (t20=0 implicit)
  436:     double t01, t11, t21;   // col1
  437: 
  438:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  439: 
  440:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  441:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  442:       sincos(ar2, &sin_ar2, &cos_ar2);
  443: 
  444:       t00 = -sin_ar1;
  445:       t10 =  cos_ar1;
  446:       t01 = -cos_ar1*sin_ar2;
  447:       t11 = -sin_ar1*sin_ar2;
  448:       t21 = (rearth_pole/rearth_eq)*cos_ar2;
  449: 
  450:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  451:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  452: 
  453:       const double col1_norm_inv = 1.0/col1_norm;
  454:       t01 = t01*col1_norm_inv;
  455:       t11 = t11*col1_norm_inv;
  456:       t21 = t21*col1_norm_inv;
  457: 
  458:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  459: 
  460:    }
  461: 
  462:    __forceinline__ __device__ void print(void) const {
  463:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  464:    }
  465: 
  466:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  467:       // cross(col0, col1), with t20=0 implicitly:
  468:       // |  i       j       k   |
  469:       // | t00     t10      0   |
  470:       // | t01     t11     t21  |
  471:       t02 =  t10*t21;
  472:       t12 = -t00*t21;
  473:       t22 =  t00*t11 - t10*t01;
  474:    }
  475: 
  476: 
  477:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  478:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  479:    // Inputs:
  480:    //        vec0: vel. in this frame;
  481:    //        frameout: Output frame;
  482:    // Output: 
  483:    //        vel. in new frame  
  484:    //
  485:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  486:    // discarding the z-component of the result to keep only the local horizontal
  487:    // plane of frame 2.
  488:    //
  489:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  490:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  491:    // are orthogonal. This product is computed as dot products between columns of
  492:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  493:    // columns of F2.// 
  494: 
  495:       auto const fo = frameout; // Just an alias for the output frame.
  496:       Vector2 res;
  497: 
  498:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  499:       // of t and fo.t are the same.
  500:       const double d00 = t00*fo.t00 + t10*fo.t10;
  501:       const double d10 = t01*fo.t00 + t11*fo.t10;
  502: 
  503:       const double d01 = t00*fo.t01 + t10*fo.t11;
  504:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  505: 
  506:       res.x = vec0.x * d00 + vec0.y * d10;
  507:       res.y = vec0.x * d01 + vec0.y * d11;
  508: 
  509:       return res;
  510:    }
  511: 
  512:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  513:       Vector3 vo;
  514:       double t02, t12, t22;
  515: 
  516:       getCol2(t02, t12, t22);
  517: 
  518:       vo.x = vi.x*t00 + vi.y*t10;
  519:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  520:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  521: 
  522:       return vo;
  523:    
  524:    }
  525: 
  526:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  527:       Vector3 vo;
  528:       double t02, t12, t22;
  529: 
  530:       getCol2(t02, t12, t22);
  531: 
  532:       // F * vi (non-transposed, so we use rows of F)
  533:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  534:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  535:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  536: 
  537:       return vo;
  538:    }
  539: 
  540:    // __forceinline__ __device__ Point3 G2L(Point3 const &pi, Point3 const &origin0) const {
  541:    // // Tranforms a point from global to local frame     
  542:    //    return G2L(pi - origin0); // XXXX IS THIS CORRECT?
  543:    // }
  544: 
  545:    // __forceinline__ __device__ Point3 L2G(Point3 const &pi, Point3 const &origin0) const {
  546:    // // Transforms a point from local to global frame      
  547:    //    return L2G(pi) + origin0;  // XXXX IS THIS CORRECT?
  548:    // }
  549: 
  550: };
