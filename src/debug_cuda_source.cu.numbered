 2163: __device__ __inline__ double min3(double a, double b, double c) {
 2164:    return min(a, min(b, c));
 2165: }
 2166: 
 2167: __device__ __inline__ double max3(double a, double b, double c) {
 2168:    return max(a, max(b, c));
 2169: }
 2170: 
 2171: __device__ __inline__ double min4(double a, double b, double c, double d) {
 2172:    return min(a, min(b, min(c, d)));
 2173: }
