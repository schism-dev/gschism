10434: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
10435:    SIDE(side);
10436: 
10437:    switch (varCode) {
10438:       case (int)VarCode::outputCoords: {
10439:          const Point2 coords = side->outputCoords();
10440:          double *out = (double *)((char *)res + idx_side * 16);
10441:          out[0] = coords.x;
10442:          out[1] = coords.y;
10443:          break;
10444:       }
10445:       case (int)VarCode::n1:
10446:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
10447:          break;
10448:       case (int)VarCode::n2:
10449:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
10450:          break;
10451:       case (int)VarCode::isdry:
10452:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
10453:          break;
10454:    }
10455: }
10456: 
10457: 
10458: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
10459:    ELEM(elem);
10460: 
10461:    switch (varCode) {
10462:       case (int)VarCode::outputCoords: {
10463:          const Point2 coords = elem->outputCoords();
10464:          double *out = (double *)((char *)res + idx_elem * 16);
10465:          out[0] = coords.x;
10466:          out[1] = coords.y;
10467:          break;
10468:       }
10469:       case (int)VarCode::FaceIndices: {
10470:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
10471:          for (int j = 0; j < 4; j++)
10472:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
10473:          break;
10474:       }
10475:       case (int)VarCode::isdry:
10476:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
10477:          break;
10478:       case (int)VarCode::w: {
10479:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
10480:          if (k >= 0)
10481:             out[0] = elem->w[k];
10482:          else
10483:             for (int lev = 0; lev < nvrt; lev++)
10484:                out[lev] = elem->w[lev];
10485:          break;
10486:       }
10487:    }
10488: }
