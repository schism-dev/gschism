 7132: __global__ void printMatrix(void) {
 7133: 
 7134: 
 7135:    // Let only one thread per block print at a time 
 7136: 
 7137:    if (threadIdx.x == 0) {
 7138:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7139:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 7140:          if (idx_node >= mesh->np) return;
 7141:          const Node *node = mesh->localNodeData + idx_node;
 7142:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7143:          for (int j = 0; j < node->numNodes; j++) {
 7144:             Node* nbNode = node->nodes[j];
 7145:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7146:          }
 7147:          printf("]\n");
 7148: 
 7149:       }
 7150:    }
 7151: 
 7152: 
 7153: 
 7154: }
 7155: 
 7156: 
 7157: __global__ void computeMatrixProductAndDotProducts() {
 7158:    // Computes A*p, r'Mr and p'Ap
 7159: 
 7160:    // 1) shared buffer: first half for rMr, second for pAp
 7161:    __shared__ double sdata[2*BLOCK_SIZE];
 7162:    double* s_rMr = sdata;
 7163:    double* s_pAp = sdata + BLOCK_SIZE;
 7164: 
 7165:    s_rMr[threadIdx.x] = 0.0;
 7166:    s_pAp[threadIdx.x] = 0.0;
 7167: 
 7168:    // 2) get your node pointer
 7169:    NODE(node);  
 7170:    const int tid = threadIdx.x;
 7171: 
 7172:    const double diag = node->coeffDiag;
 7173:    const double r    = node->mR;
 7174:    const double p    = node->mP;  
 7175: 
 7176:    // apply preconditioner on the fly:
 7177:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7178: 
 7179:    // 4) compute Ap = A.p
 7180:    double Ap = node->coeffDiag * node->mP;
 7181:    for (int j = 0; j < node->numNodes; ++j) {
 7182:       const Node *nbNode = node->nodes[j];
 7183:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7184: 
 7185:    }
 7186:    node->mAp = Ap;
 7187:     
 7188: 
 7189:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7190:    const double l_rMr = r*Mr;  // r'Mr
 7191:    const double l_pAp = p*Ap;  // p'Ap
 7192: 
 7193:    // 6) write into shared mem
 7194:    s_rMr[tid] = l_rMr;
 7195:    s_pAp[tid] = l_pAp;
 7196: 
 7197:    __syncthreads();
 7198: 
 7199:    // 7) block-wide tree reduction
 7200:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7201:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7202:       __syncthreads();
 7203:    }
 7204: 
 7205:    // 8) thread 0 atomically accumulates into the globals
 7206:    // XXX: This is slower than it needs to be, but it is simple and works
 7207:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7208: 
 7209: 
 7210: }
 7211: 
 7212: 
 7213: __global__ void updateSolutionAndDotProducts(void) {
 7214:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7215: 
 7216:    s_rMr[threadIdx.x] = 0.0;
 7217: 
 7218: 
 7219:    // get node & bounds-check:
 7220:    NODE(node);
 7221:    const int tid = threadIdx.x;
 7222: 
 7223: 
 7224:    // Compute alpha
 7225:    const double alpha = (*rMr_old)/(*pAp);
 7226: 
 7227:    // load scalars
 7228:    const double diag = node->coeffDiag;
 7229:    const double p    = node->mP;
 7230:    const double Ap   = node->mAp;
 7231:    const double x    = node->mX;
 7232:    const double r    = node->mR;
 7233:    
 7234:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7235: 
 7236:    // 1) update solution & residual
 7237:    const double x_new = x + alpha*p;
 7238:    const double r_new = r - alpha*Ap;
 7239:    node->mX = x_new;
 7240:    node->mR = r_new;
 7241: 
 7242:    // 2) apply Jacobi preconditioner on the fly
 7243:    const double Mr_new = r_new/diag;
 7244: 
 7245: 
 7246:    // 3) local contributions for the two dot-products
 7247:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7248: 
 7249:    // 4) write into shared-mem
 7250:    s_rMr[tid] = l_rMr;
 7251: 
 7252:    __syncthreads();
 7253: 
 7254: 
 7255:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7256:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7257:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7258:       __syncthreads();
 7259:    }
 7260: 
 7261:    // 6) thread 0 atomically folds into the global accumulators
 7262:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7263: 
 7264: 
 7265: }
 7266: 
 7267: 
 7268: __global__ void updateSearchDirection() {
 7269:     NODE(node);
 7270: 
 7271:     // recompute z on-the-fly
 7272:     const double z = node->mR / node->coeffDiag;
 7273:     const double p = node->mP;
 7274: 
 7275:     const double beta = (*rMr_new)/(*rMr_old);
 7276: 
 7277: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 7278: 
 7279:     // p =z + beta*p
 7280:     node->mP = z + beta*p;
 7281: 
 7282: }
 7283: 
 7284: __global__ void initializePreconditionedResidual(double *scalars) {
 7285: 
 7286:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7287: 
 7288:     s_rMr[threadIdx.x] = 0.0;
 7289: 
 7290:     NODE(node);
 7291:     const int tid = threadIdx.x;
 7292:     // For the first iteration:
 7293:     // 1. Initial solution x = 0 (already set)
 7294:     // 2. Initial residual r = b (stored in qel)
 7295:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7296: 
 7297: // XXX we should use the guess solution here    
 7298: 
 7299:     // Set initial residual r = b (from qel)
 7300:     node->mR = node->qel;
 7301: 
 7302:     // Compute z = M^-1 * r (preconditioned residual)
 7303:     const double z = node->mR / node->coeffDiag;
 7304: 
 7305:     // Set initial search direction p = z
 7306:     node->mP = z;
 7307: 
 7308:     // Initialize other variables needed for CG
 7309:     node->mX = 0.0;  // Initial solution
 7310:     node->mAp = 0.0; // Will be computed in first iteration
 7311: 
 7312:     // These point to a cupy array in the host code
 7313:     rMr_old = scalars + 0;
 7314:     rMr_new = scalars + 1;
 7315:     pAp     = scalars + 2;
 7316: 
 7317:     // Computes the first r'Mr (reduction)
 7318:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7319: 
 7320:     // 4) write into shared-mem
 7321:     s_rMr[tid] = l_rMr;
 7322: 
 7323:     __syncthreads();
 7324: 
 7325: 
 7326:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7327:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7328:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7329:         __syncthreads();
 7330:     }
 7331: 
 7332:     // 6) thread 0 atomically folds into the global accumulators
 7333:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7334: 
 7335:     *rMr_old = 0.0;
 7336:     *pAp = 0.0;
 7337: }
 7338: 
 7339: 
 7340: 
 7341: 
 7342: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1) {
 7343:    // Get the value of a variable from an element
 7344:    // varName is the name of the variable to get
 7345:    // var is the array to store the value
 7346:    // k is the vertical level index of the variable to get
 7347: 
 7348:    ELEM(elem);
 7349:    
 7350:    int idx = elem->idx;
 7351:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7352: 
 7353:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7354:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7355:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7356:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7357:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7358:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7359:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7360:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7361:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7362:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7363:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7364:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7365:       
 7366:    
 7367: }
 7368: 
 7369: 
 7370: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7371:    // Get the value of a variable from an node
 7372:    // varName is the name of the variable to get
 7373:    // var is the array to store the value
 7374:    // k is the vertical level index of the variable to get
 7375: 
 7376:    NODE(node);
 7377:    
 7378:    int idx = node->idx;
 7379:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7380: 
 7381:    printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7382:    
 7383:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7384:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7385:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7386:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7387:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7388:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7389:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7390:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7391:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7392:       
 7393:    
 7394: }
 7395: 
 7396: 
 7397: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7398:    // Get the value of a variable from an side
 7399:    // varName is the name of the variable to get
 7400:    // var is the array to store the value
 7401:    // k is the vertical level index of the variable to get
 7402:    SIDE(side);
 7403:    
 7404:    int idx = side->idx;
 7405:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7406: 
 7407:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7408:    
 7409:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = side->zc[k];
 7410:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = side->center.x;
 7411:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = side->center.y;
 7412:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = side->u2[k].x;
 7413:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = side->u2[k].y;
 7414:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = side->depth();
 7415:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(side->kb);
 7416:    else if (varCode == (int)VarCode::n1 && k == -1)     var[idx] = side->n1->idx;
 7417:    else if (varCode == (int)VarCode::n2 && k == -1)     var[idx] = side->n2->idx;
 7418:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = side->eta2();
 7419:    else if (varCode == (int)VarCode::btu && k >= 0)     var[idx] = side->btu[k].x;
 7420:    else if (varCode == (int)VarCode::btv && k >= 0)     var[idx] = side->btu[k].y;
 7421:    else if (varCode == (int)VarCode::bccx && k >= 0)    var[idx] = side->bcc[k].x;
 7422:    else if (varCode == (int)VarCode::bccy && k >= 0)    var[idx] = side->bcc[k].y;
 7423:    else if (varCode == (int)VarCode::ubc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7424:    else if (varCode == (int)VarCode::vbc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7425:    else if (varCode == (int)VarCode::uth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7426:    else if (varCode == (int)VarCode::vth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7427:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7428: }
