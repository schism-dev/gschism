 7100: #ifdef DONTCOMPILE
 7101: __device__ void computeVerticalAdvection(void) {
 7102:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7103: 
 7104:    sdbt(1:2,:,:)=0.d0
 7105: 
 7106:    const Side *side = FROM kernel;
 7107: 
 7108:    if(side->isDry) return;
 7109: 
 7110:    // If side is wet...
 7111: 
 7112: 
 7113:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7114:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7115:    double ws[nvrt] = {} // w @ side
 7116:    int icount = 0;
 7117:    for (int j=0; j<2; j++) {
 7118:       const Element *elem = side->elements[j];
 7119:        
 7120:       if(elem != nullptr) {
 7121:          icount++;
 7122:          for (int k=0; k<nvrt; k++) {
 7123:             ws[k] = ws[k] + elem->w[k];
 7124:          }
 7125:       }
 7126:    }  // for j
 7127: 
 7128:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7129:    ws = ws/icount;
 7130: 
 7131:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7132:    // Splines allow for a smooth transition between vertical levels.
 7133:    // Splines have continuity restrictions at the internal knots, but
 7134:    // we have to provide the 1st derivatives at the endpoints.
 7135:    const int kbs = side->kbs; 
 7136:    
 7137:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7138:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7139:    initCubicSpline(kbs, nvrt, side, ws, up)
 7140: 
 7141:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7142:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7143:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7144: 
 7145:    // Total advection (average onto side)
 7146:    const Node *node1 = side->nodes[0];
 7147:    const Node *node2 = side->nodes[1];
 7148:    for (int k=kbs(i); k<nvrt; k++) {
 7149: 
 7150:       if constexpr(ics==1) {
 7151:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 7152:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 7153:       } else {
 7154:          // XXX IMPLEMENT THIS
 7155:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 7156:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 7157:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 7158:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 7159:       }  // if ics
 7160: 
 7161: 
 7162:    }
 7163: }
 7164: #endif
 7165: 
 7166: 
 7167: extern "C" {
 7168:    __global__ void computeElemAverageGhat(void) {
 7169:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7170: 
 7171:       ELEM(elem);
 7172:       
 7173:       elem->ghat1= {0.0, 0.0};  
 7174: 
 7175:       if constexpr(ihydraulics != 0) {
 7176:          if (nhtblocks > 0 && elem->isblock) return;
 7177:       }
 7178: 
 7179:       if (elem->isDry) return;
 7180: 
 7181:       // Wet elements.
 7182:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 7183:       // tidal potential, horizontal diffusion, and baroclinic etc
 7184:       // Remember to update both fb and F 
 7185:       // If ics=2, ghat1 are in eframe (ll)
 7186:       // cff1-3: coefficients for 2D/3D
 7187:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7188:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7189:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 7190: 
 7191:       double av_cff1 = 0.0;  // av. for cff1
 7192:       double av_cff2 = 0.0;  // av. for cff2
 7193:       double av_cff3 = 0.0;  // av. for cff3
 7194:       double av_df = 0.0;  // av. for H^\alpha / H
 7195:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7196:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7197: 
 7198:       const int i34 = elem->i34;
 7199:       const int kb = elem->kb;
 7200: 
 7201:       for (int j=0; j<i34; j++) {
 7202:          // For each node and side in the element...
 7203: 
 7204:          const Node *node = elem->nodes[j];
 7205:          const Side *side = elem->sides[j];
 7206: 
 7207:          const double chi      = side->chi;
 7208:          const double veg_c2   = side->veg_c2;
 7209:          const double veg_beta = side->veg_beta;
 7210:          const double veg_h    = side->veg_h();
 7211:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7212: 
 7213:          // Node - const in elem
 7214:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 7215:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 7216: 
 7217:          if (elem->depth >= tip_dp) {
 7218:            elem->gradETP += node->ETP*elem->gradPhi[j];
 7219:          }
 7220: 
 7221:          
 7222:          const double htot  = side->htot2();        // Total depth at the side
 7223:          const double zctr2 = side->zTopCanopy();  
 7224: 
 7225:          double cff1; 
 7226:          double cff2; 
 7227:          double cff3;   
 7228:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7229:          // coefficients applied to 2D/3D case 
 7230:             cff1 = side->hhat/htot;
 7231:             cff2 = 0.0;
 7232:             cff3 = 0.0;
 7233:          } else { //3D
 7234:             //Init for no-veg case
 7235:             cff1 = 1.0;
 7236:             cff2 = 1.0;
 7237:             cff3 = 0.0;
 7238: 
 7239:             if constexpr(iveg != 0) {
 7240:                // Computes coefficients used with vegetation terms G1, G2
 7241:                // cff1, cff3 are used for the first two terms in G1, G2:
 7242:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7243:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7244:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7245:                if(veg_h < 0.99*htot) { // submergent vegetation
 7246:                   cff1=1;
 7247:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7248:                   cff3 = veg_c;
 7249: 
 7250:                } else { // emergent vegetation
 7251:                   cff1 = 1.0/(1.0 + veg_c2);
 7252:                   cff2 = cff1;
 7253:                   cff3 = 0.0;
 7254: 
 7255:                }
 7256:             } // if iveg
 7257:          } //  2D/3D
 7258: 
 7259:          av_cff1 += cff1/i34;
 7260:          av_cff2 += cff2/i34;
 7261:          av_cff3 += cff3/i34;
 7262:          av_cff2_chi += cff2*chi/i34;
 7263:          av_cff3_chi += cff3*chi/i34;
 7264:          av_df += min(htot, veg_h)/(htot*i34);
 7265: 
 7266: 
 7267:          // btrack values: U^\star, U^{\star\alpha}
 7268:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7269:          Vector2 Ustar       = {0.0, 0.0}; 
 7270:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7271: 
 7272:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7273:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7274:          } else { //3D
 7275:             for (int k = side->kb; k < nvrt; k++) {
 7276:             
 7277:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7278:                Ustar += w2;
 7279: 
 7280:                if constexpr(iveg != 0) {
 7281:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7282:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7283:                        Ustar_alpha += zrat*w2; // XXXX
 7284:                    }
 7285:                }  // if iveg
 7286:             }  // for k
 7287:          }  //2D/3D
 7288:          
 7289: 
 7290:          // Add btrack & surface stress terms to \breve{G} first
 7291:          if constexpr(ics==1) {
 7292: 
 7293:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7294: 
 7295:          } else {
 7296:             // XXX IMPLEMENT THIS
 7297:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7298:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7299:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7300:          }  // if ics
 7301: 
 7302:          // Surface and bottom stress terms
 7303:          if constexpr(ics==1) {
 7304:             const Vector2 tau    = side->tau();
 7305:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7306: 
 7307:             // Term for surface and bottom stress
 7308:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7309: 
 7310:          } else {
 7311:             assert(false && "computeElemAverageGhat: Not implemented");
 7312:             // XXX IMPLEMENT THIS
 7313:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7314:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7315:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7316:             // tau_x=(vn1+tt1)/2.d0
 7317:             // tau_y=(vn2+ss1)/2.d0
 7318:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7319:          }  // if ics
 7320: 
 7321:          
 7322: 
 7323:          // All terms in F,F^\alpha,f_b except baroclinic
 7324:          // F, f_b: all explicit terms excluding vegetation 
 7325:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7326:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7327:          const double coriolis = side->coriolis;
 7328:          Vector2 F  =  coriolis*side->U;  // F_x
 7329:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7330:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7331: 
 7332:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7333:             
 7334:             for (int k = side->kb; k < nvrt; k++) {
 7335:                if (zctr2 > side->zc[k-1]) {
 7336:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7337:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7338:                    Fa +=  coriolis*w2*zrat;
 7339:                } // if zctr2
 7340:             } // k
 7341:          } // iveg
 7342: 
 7343:          // Integrate horizontal viscosity force vertically
 7344:          for (int k=side->kb + 1; k<nvrt; k++) {
 7345:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7346: 
 7347:             F += levelHorVisc;
 7348: 
 7349:             // Vegetation term
 7350:             if constexpr(iveg!=0) {
 7351:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7352:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7353:                   Fa += levelHorVisc*zrat;
 7354:                } 
 7355:             } // if iveg
 7356:          } // for k
 7357: 
 7358:          fb += side->nuGradU[side->kb];
 7359: 
 7360:          // Add to ghat1
 7361:          if constexpr(ics==2) {
 7362:             // XXX IMPLEMENT THIS
 7363:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7364:             // bigf1=vn1; bigf2=vn2
 7365:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7366:             // botf1=vn1; botf2=vn2
 7367:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7368:             // bigfa1=vn1; bigfa2=vn2
 7369:          } // if ics
 7370: 
 7371:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7372:       } // for j (nodes and sides)
 7373: 
 7374:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7375:          
 7376:       // Finish off terms in F, F^\alpha and f_b
 7377:       const double grav3 = elem->mean(&Node::grav2);
 7378:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7379: 
 7380: 
 7381:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7382:       for (int j=1; j<i34; j++) { 
 7383:          // For each side in the element...
 7384:          const Side *side = elem->sides[j];
 7385:          const double chi = side->chi;
 7386: 
 7387:          const double htot = side->htot2();
 7388:          const double veg_h = side->veg_h();
 7389:          const Vector2 F  = htot*fb;
 7390:          const Vector2 Fa = min(htot, veg_h)*fb;
 7391: 
 7392:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7393:       } // for j
 7394: 
 7395:       //botf1 etc are already in elem frame
 7396:       elem->ghat1 += tmp/i34;
 7397: 
 7398:       // Baroclinic force
 7399:       if constexpr(ibc==0) {
 7400:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7401: 
 7402:          Vector2 Fa = {0.0, 0.0};
 7403:          Vector2 intGradRho = {0.0, 0.0};
 7404:          
 7405:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7406:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7407:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7408: 
 7409:             // \in F [m^2/s/s]
 7410:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7411:          }
 7412: 
 7413:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7414:          const Vector2 F = av_df*Fa; //approx
 7415:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7416: 
 7417:       } // if ibc
 7418: 
 7419: 
 7420: 
 7421:    }
 7422: 
 7423: } // extern "C"
 7424: 
 7425: 
 7426: 
 7427: #ifdef DONTCOMPILE
 7428: __global__ void checkMassConservation(Tracers* sumtr) {
 7429: 
 7430:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7431: 
 7432:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7433: 
 7434:    Element *elem = &(mesh->localElemData[i]);
 7435: 
 7436:    // Skip dry elements
 7437:    if (elem->isDry) return;
 7438: 
 7439:    // Local sum array for this thread
 7440:    double localSum[N_TRACERS] = {0.0};
 7441: 
 7442:    // Sum over vertical levels for this element
 7443:    const int kbe = elem->kbe;
 7444:    const double area = elem->area;
 7445: 
 7446:    for (int k = kbe; k < nvrt; k++) {
 7447:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7448:       
 7449:       // Accumulate tracer mass
 7450:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7451:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7452:       }
 7453:    }
 7454: 
 7455:    
 7456: 
 7457:    //  This function returns per element sums. A reduction must be done on the host side.
 7458: }
 7459: 
 7460: 
 7461: __global__ void transport(void) {
 7462: 
 7463:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7464: 
 7465:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7466: 
 7467:    Element *elem = &(mesh->localElemData[ie]);
 7468: 
 7469:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7470: 
 7471:                for (int m=0; m<ntr; m++) {
 7472:                   for (int k=kbe(ie); k<nvrt; k++) {
 7473:                      // Calculate each polynomial's weight 
 7474:                      wm=0.d0; sum1=0.d0; 
 7475:                      wm1=0.d0; wm2=0.d0; 
 7476:                      for (int i=0; i<elem->nweno2; i++) {
 7477:                   
 7478:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7479:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7480:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7481:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7482:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7483:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7484:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7485:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7486:                      // -----------------Hu and Shu (1999)'s method----------------
 7487:                      b4=b1+b2+b3
 7488: 
 7489: //Error: add PRODUCTION CPP
 7490: #ifdef DEBUG
 7491:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7492:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7493:                     call parallel_abort(errmsg)
 7494:                   }
 7495: #endif
 7496: 
 7497:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7498:                   // !----test-------------- 
 7499:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7500:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7501:                   // !wm(i)=wm1(i)*wm2(i)
 7502:                   // !---------------------- 
 7503:                   sum1=sum1+wm(i)
 7504:                 } // end for i
 7505: 
 7506:                 wm=wm/sum1
 7507: 
 7508:                 for (int j=0; j<elem->i34; j++) {
 7509: 
 7510:                   const Side *side  = elem->sides[j];
 7511:                   const Node *node1 = side->n1;
 7512:                   const Node *node2 = side->n2;
 7513: 
 7514:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7515:                      trsd=0.d0
 7516:                      for (int kk=0; kk<nquad; kk++) {
 7517:                         for (int i=0; i<elem->nweno2; i++) {
 7518:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7519:                         } // end for i   
 7520:                      } // end for kk
 7521:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7522:                   } // outward flux
 7523:                } // end for j=1,i34(ie) ! side
 7524:             }
 7525:          }
 7526:               
 7527: 
 7528: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7529: //             //   calculate each polynomial's weight 
 7530: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7531: //                 wm=0.d0; sum1=0.d0
 7532: //                 do i=1,nweno1(ie) !for each polynomial
 7533: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7534: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7535: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7536: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7537: //                   wm(i)=b2
 7538: //                   sum1=sum1+b2
 7539: //                   !wm(i)=1.d0
 7540: //                   !sum1=sum1+1.d0
 7541: 
 7542: // // Error: PRODUCTION
 7543: // #ifdef DEBUG
 7544: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7545: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7546: //                     call parallel_abort(errmsg)
 7547: //                   endif
 7548: // #endif
 7549: 
 7550: //                 enddo !i
 7551: //                 wm=wm/sum1 !final weight
 7552: 
 7553:                 for (int j=0; j<elem->i34; j++) { // side
 7554:                   const Side *side = elem->sides[j];
 7555:                   const Node *node1 = side->n1;
 7556:                   const Node *node2 = side->n2;
 7557: 
 7558:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7559:                     trsd=0.d0
 7560:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7561:                       for (int i=0; i<elem->nweno1; i++) {
 7562:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7563:                       }
 7564:                     enddo //kk
 7565:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7566:                   } // outward flux
 7567:                 } // end for j=1,i34(ie) ! side
 7568:               } // end for k; ntr 
 7569: 
 7570:             else !simple upwind method
 7571:               do j=1,i34(ie)
 7572:                 jsj=elside(j,ie)
 7573:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7574:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7575:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7576:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7577:                   endif
 7578:                 enddo  !vertical layers
 7579:               enddo !j=1,i34(ie) ! side
 7580:             endif !order of accuracy
 7581: 
 7582:          //  enddo !ie
 7583: // !$OMP     end do
