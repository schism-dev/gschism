 5581:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5582: 
 5583:       SIDE(side);
 5584: 
 5585:       side->U = {0.0, 0.0}; 
 5586:          
 5587:       if(side->isDry) return;
 5588: 
 5589:       // Vertically integrated velocity U
 5590:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5591:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5592:          side->U += side->Dz(k + 1)*uc;  
 5593:       }
 5594: 
 5595:    }
 5596: 
 5597:    __global__ void computeBottomDragVegetation(void) {
 5598:       // UNFINISHED. CHECK THIS:
 5599:       // How many kernels are needed? Why so many for loops?
 5600:       // Is the loop on sides needed?
 5601: 
 5602:       NODE(node);
 5603: 
 5604: 
 5605:       const int    kb      = node->kb;
 5606:       const double htot    = node->htot2(); 
 5607:       
 5608:       if (node->isDry) {
 5609:          // Default values for dry nodes
 5610:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5611:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5612: 
 5613:          return;
 5614:        
 5615:       }
 5616: 
 5617:       // Computes bottom drag Cd based on the selected nchi
 5618:       node->computeBottomDragCd();
 5619:       
 5620: 
 5621: 
 5622:       //   Bottom stress in m^2/s^2
 5623:       if (node->rho[kb + 1] >= -98.0)
 5624:       {
 5625:          const double mag_u = length(node->u2[kb + 1]);
 5626:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5627: 
 5628:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5629:          // !sediment erosion: this part needs more documentation
 5630:       }
 5631:     
 5632: 
 5633: 
 5634:       // Compute vegetation parameters
 5635:       //--------------------------------
 5636: 
 5637:       // SAV constants
 5638:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5639:       constexpr double veg_cfpsi = 0.16;
 5640: 
 5641:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5642:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5643: 
 5644:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5645:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5646:          int kbin = 0; // bin index
 5647:          for (int k = kb; k < nvrt; k++) {
 5648:             // Computes node height above the bottom level
 5649:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5650:             assert(false && "Vertical variation of vegetation not implemented");
 5651: 
 5652:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5653:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5654:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5655:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5656:             // } else {
 5657:             //    // Find the bin at which the current vertical level is
 5658:             //    while (kbin<nbins_veg_vert) {
 5659:             //       const double zn = node->z[kbin];
 5660:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5661:             //          break;
 5662:             //       } // if
 5663:             //       kbin++;
 5664:             //    } // while
 5665:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5666: 
 5667:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5668:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5669:                
 5670:             //    // Linear interpolation of the vegetation parameters
 5671:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5672:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5673:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5674:             // } // if rl10
 5675: 
 5676:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5677: 
 5678:          } // for k
 5679: 
 5680: 
 5681:       } else { // Ganthy (iveg==2)
 5682:       //  Modify canopy height, diameter, and density
 5683: 
 5684:          // Make sure there is vegetation on this node
 5685:          if (node->veg_h_unbent > 0.0) {
 5686:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5687: 
 5688:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5689:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5690:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5691: 
 5692:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5693:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5694:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5695:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5696:          } // if veg_h_unbent
 5697: 
 5698:          for (int k = 0; k < nvrt; k++) {
 5699:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5700:          } // for k
 5701:       
 5702: 
 5703:       } // if iveg
 5704:      
 5705: 
 5706:       // Compute vertical mean of veg_alpha3D
 5707:       if (iveg != 0) {
 5708:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5709:          double sum1=0.0;
 5710:          double sum2=0.0;
 5711:          // Integrate over each level under the canopy...
 5712:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5713:             const double Dz = node->Dz(k);
 5714: 
 5715:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5716:             sum2 += Dz;
 5717: 
 5718:          } // for k
 5719:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5720:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5721: 
 5722:       } // if iveg
 5723: 
 5724:    }
 5725: 
 5726:    __global__ void computeVegetationAndDragParameters(void) {
 5727:       // Computes the vegetation and drag model parameters:
 5728:       // chi, \tilde\chi, beta, \breve{H}
 5729:       
 5730:       SIDE(side);
 5731: 
 5732:       side->hhat = 0.0;
 5733:       side->chi2 = 0.0;
 5734:       side->chi = 0.0;
 5735:       side->veg_c2 = 0.0;
 5736:       side->veg_beta = 0.0;
 5737: 
 5738:       if (side->isDry) return;
 5739: 
 5740:       const double htot = side->htot2();
 5741:       const int    kb   = side->kb;
 5742: 
 5743:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5744: 
 5745:       const double veg_h     = side->veg_h();
 5746:       const double veg_nv    = side->veg_nv();
 5747:       const double veg_c     = side->veg_c();
 5748:       const double veg_beta  = side->veg_beta;
 5749:       const double veg_alpha = side->veg_alpha_vert_mean();
 5750: 
 5751:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5752:       // Velocity magnitude at the bottom level
 5753:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5754:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5755:       side->chi2 = side->Cd()*vmag1;
 5756:       side->chi  = side->chi2;
 5757: 
 5758:       if constexpr(iveg != 0) {
 5759:          const Node *n1 = side->n1;
 5760:          const Node *n2 = side->n2;
 5761:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5762:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5763:       }
 5764: 
 5765:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5766: 
 5767:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5768:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5769:       double magUa = 0.0;
 5770:       if constexpr(iveg != 0) {
 5771:          if (side->is3D() && veg_h > 0.0) {
 5772:             // 3D wet side with veg...
 5773: 
 5774:             double magUa = 0.0;
 5775:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5776:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5777: 
 5778:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5779:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5780:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5781: 
 5782:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5783:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5784: 
 5785:                   // Velocity magnitude at the bottom (l) of the level
 5786:                   const double ul = length(side->u2[k]);
 5787: 
 5788:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5789:                   magUa += Dz*0.5*(uh + ul);
 5790: 
 5791:                } // if HasVegetation
 5792:             } // for k
 5793:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5794: 
 5795:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5796:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5797:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5798:                const double zCpy = side->zTopCanopy();
 5799:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5800:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5801:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5802:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5803:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5804:             } // if isSubmerged
 5805:          } // if is3D
 5806:       } // if iveg   
 5807: 
 5808:       // Computes the friction modified depth, \breve{H} in notes
 5809:       if (side->is2D()) { // 2D
 5810: 
 5811:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5812:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5813: 
 5814:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5815: 
 5816:          side->hhat = htot*htot/fricH; 
 5817: 
 5818:       } else { // 3D
 5819:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5820: 
 5821:          if constexpr(iveg != 0) {
 5822:             
 5823:             if (side->isSubmerged()) { 
 5824:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5825:                side->hhat -= veg_c*Hhat_alpha;
 5826: 
 5827:             } else { // Emergent
 5828:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5829:             }
 5830:          } // if iveg
 5831: 
 5832:          // Enforce positivity for 3D model
 5833:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5834:       } // if 3D
 5835: 
 5836:    }
 5837: 
 5838: 
 5839: 
 5840:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5841:    // Computes the density gradient between two elements, e1 and e2.
 5842:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5843:    // zero in the direction normal to the side. 
 5844:    // 
 5845:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5846:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5847:    //
 5848:    // Input:
 5849:    //    e1: Element
 5850:    //    e2: Neighbor element (or nullptr if boundary)
 5851:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5852:    //    k: Index of the half-level at which the density is interpolated
 5853:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5854:    // 
 5855:    // Output:
 5856:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5857:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5858: 
 5859:       if (e2 == nullptr || e2->isDry) {
 5860:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5861: 
 5862:          Side *side = e1->sides[j];
 5863:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5864:                  
 5865:          if constexpr(ics == 1) {
 5866:             vec = side->n; // Normal vector to the side
 5867:          } else {
 5868:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5869:             // IMPLEMENT THIS XXXXXX
 5870:             // !replace with xel, yel?
 5871:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5872:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5873:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5874:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5875:          } //ics
 5876:                    
 5877:          diffRho = 0.0;
 5878: 
 5879:       } else { //internal and wet
 5880:          if constexpr(ics==1) {
 5881:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5882: 
 5883:             // Vector from e1 to e2
 5884:             vec = e2->center - e1->center;
 5885: 
 5886:          } else { 
 5887:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5888:             // Remember that elem->center is in global coordinates
 5889:             // IMPLEMENT THIS XXXXXX
 5890:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5891:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5892:             //                   alow(j)=xctr2
 5893:             //                   bdia(j)=yctr2
 5894:          } // ics
 5895: 
 5896:          diffRho = rho2 - e1->demeanedDensity(k);
 5897:       }
 5898: 
 5899:    }
 5900: 
 5901:    __global__ void computeDensityCubicSplines(void) {
 5902:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5903: 
 5904:       ELEM(elem);
 5905: 
 5906:       if (elem->isDry) return;
 5907: 
 5908:       const int kb = elem->kb;
 5909: 
 5910:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5911:       if (elem->is2D()) {
 5912:          // In the 2D case, the density is constant at the prism level. 
 5913:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5914:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5915:       } else { //3D
 5916: 
 5917:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5918:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5919:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5920:          ///// XXXX CHECK INDICES!!!!!
 5921:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5922:       } // 2D/3D
 5923: 
 5924:    }
 5925: } // extern "C"
 5926: 
 5927: 
 5928: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5929: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5930: 
 5931:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5932: 
 5933:    const int kb  = elem->kb;
 5934:    const int kb2 = elem2->kb;
 5935: 
 5936:    // z-coordinate of prism of elem
 5937:    const double zp = elem->z_prism(k);
 5938: 
 5939:    double rho = 0.0;
 5940: 
 5941:    if (elem2->is2D()) {
 5942:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5943: 
 5944:    } else {  // 3D
 5945: 
 5946:       // eta_min may be < zmax
 5947:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5948:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5949: 
 5950:       // (Extrapolate density below bottom, we will fix it later)
 5951:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5952:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5953:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5954:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5955:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5956:    } // 2D/3D
 5957:      
 5958: 
 5959:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5960:    // Now we need to fix it.
 5961:    if (elem->z[k] < elem2->z[kb2]) {
 5962:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5963: 
 5964:       // There are two methods to adjust the density at the bottom of the element.
 5965:       // iunder_deep=0: 
 5966:       const double depth1 = abs(elem->z[kb]); // larger depth
 5967: 
 5968:       if (iunder_deep==0) {
 5969: 
 5970:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5971: 
 5972:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5973: 
 5974:       } else { // iunder_deep != 0
 5975: 
 5976:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5977: 
 5978:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5979: 
 5980:          //   Demeaned density at the same z coordinate as
 5981:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5982:          }
 5983: 
 5984:       } // if iunder_deep
 5985:    } // if elem->z[kb] < elem2->z[kb]
 5986: 
 5987:    return rho;
 5988: }
 5989: 
 5990: 
 5991: extern "C" {
 5992:    __global__ void computeDensityGradient(void) {
 5993: 
 5994:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 5995:       if constexpr(ibc != 0) return;
 5996: 
 5997:          // Compute the horizontal density gradient at each element.
 5998:       // It works in two steps:
 5999:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6000:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6001:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6002:       //             gradRho.r1 = rho1 - rho0
 6003:       //             gradRho.r2 = rho2 - rho0
 6004:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6005:       // 
 6006:       //  NOTE: We use de-meaned densities.
 6007: 
 6008:       ELEM(elem);
 6009: 
 6010:       if (elem->isDry) return;
 6011: 
 6012:       const int kb  = elem->kb;
 6013:       const int i34 = elem->i34;
 6014: 
 6015:       for (int k = kb + 1; k < nvrt; k++) {
 6016:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6017:          //             gradRho.r1 = rho1 - rho0
 6018:          //             gradRho.r2 = rho2 - rho0
 6019:          int icount = 0;
 6020:          double sumRx = 0.0;
 6021:          double sumRy = 0.0;
 6022:          for (int j1=0; j1<i34; j1++) { 
 6023: 
 6024:             const int j2 = elem->nxq(j1 + 1);
 6025: 
 6026:             // Pairs of consecutive neighbor elements of elem
 6027:             const Element *e1 = elem->nghbElems[j1];
 6028:             const Element *e2 = elem->nghbElems[j2];
 6029: 
 6030:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6031:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6032:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6033: 
 6034:             // Compute the density difference and the vector from elem to e1 and e2
 6035:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6036:             double diffRho1, diffRho2;
 6037:             Vector2 vec1, vec2;
 6038:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6039:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6040: 
 6041:             const double rl1 = length(vec1);
 6042:             const double rl2 = length(vec2);
 6043:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6044: 
 6045:             const double delta = cross(vec1, vec2);
 6046:             const double sintheta = abs(delta)/(rl1*rl2);
 6047: 
 6048:             // To avoid problems, avoid elements with small angle between vectors
 6049:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6050:             const bool validEq = (sintheta > sin_one_deg);
 6051: 
 6052:             if (validEq) {
 6053:                // Solve the system of equations to get the density gradient at elem
 6054:                icount++;
 6055:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6056:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6057:                sumRx += Rx;
 6058:                sumRy += Ry;
 6059:             }
 6060:          } // for j1
 6061: 
 6062:          // Compute the average density gradient at elem
 6063:          if (icount==0) {
 6064:            // Bad mesh quality; bail out with 0 b-cc
 6065:            elem->gradRho[k] = {0.0, 0.0};
 6066:          } else {
 6067:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6068:          }
 6069: 
 6070:       } // for k
 6071: 
 6072:    }
 6073: 
 6074:    __global__ void computeBaroclinicTerm(void) {
 6075:    // Computes the baroclinic term at sides (at half levels).
 6076:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6077:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6078: 
 6079:       if (ibc == 1) return;
 6080: 
 6081:       SIDE(side);
 6082: 
 6083:       if (side->isDry) return;
 6084: 
 6085:       const Element *e1 = side->elems[0];
 6086:       const Element *e2 = side->elems[1]; 
 6087:       const int kb = side->kb;
 6088:       
 6089:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6090: 
 6091:       // interpolates vertically the density gradient of the two elements at the half level/
 6092: 
 6093:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6094:       int k2 = max(kb, nvrt / 2);
 6095: 
 6096:       // Starts the integration at the surface and goes down to the bottom
 6097:       side->bcc[nvrt-1] = {0.0, 0.0};
 6098:       for (int k = nvrt - 2; k >= kb; k--) {
 6099:       // For each prism level (from surface to bottom)...
 6100: 
 6101:          // For both elements, interpolate density gradient at the side's half level.
 6102:          // The gradient at the side is the average of the gradients at the elements.
 6103:          // w1, w2 are used to take into account boundary sides, with just one element.
 6104:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6105:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6106:          const double wsum = w1 + w2;
 6107:          w1 = w1/wsum;
 6108:          w2 = w2/wsum;
 6109:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6110: 
 6111:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6112:          Vector2 gradRho = {0.0, 0.0};
 6113:          if (e1 != nullptr && k > kb) {
 6114:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6115:             
 6116:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6117:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6118:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6119: 
 6120:             // Grad(rho) vertically interpolated at the side's half level
 6121:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6122: 
 6123:             // Projects the element density gradient to the side frame if needed.
 6124:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6125: 
 6126:             // Adds the contribution of the density gradient at the side's half level
 6127:             gradRho += gradRho1*w1;
 6128:          }      
 6129:          if (e2 != nullptr && k > kb) {
 6130:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6131:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6132:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6133:             
 6134:             // Grad(rho) vertically interpolated at the side's half level
 6135:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6136: 
 6137:             // Projects the element density gradient to the side frame if needed.
 6138:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6139: 
 6140:             // Adds the contribution of the density gradient at the side's half level
 6141:             gradRho += gradRho2*w2;
 6142:          }
 6143: 
 6144:          
 6145:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6146:          // multiplied by -rampbc*(g/rho0) 
 6147:          const double grav3 = side->grav3();
 6148:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6149: 
 6150:       } // for
 6151: 
 6152:    }
 6153: 
 6154: 
 6155: 
 6156:    __global__ void computeHorGradientAtSide(void) {
 6157: 
 6158:       // Compute the horizontal density gradient at each element.
 6159:       // It works in two steps:
 6160:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6161:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6162:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6163:       //             gradRho.r1 = rho1 - rho0
 6164:       //             gradRho.r2 = rho2 - rho0
 6165:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6166:       // 
 6167:       //  NOTE: We use de-meaned densities.
 6168: 
 6169:       SIDE(side);
 6170: 
 6171: 
 6172:       if (side->isDry) return;
 6173: 
 6174:       // Computes the gradient of the variables at the side center.
 6175:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6176:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6177:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6178: 
 6179:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6180:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6181:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6182:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6183: 
 6184:    }
 6185: 
 6186: 
 6187:    __global__ void solveMomentumEquations(double time) {
 6188: 
 6189:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6190:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6191: 
 6192:       SIDE(side);
 6193: 
 6194:       if (side->isDry) 
 6195:       {
 6196:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6197: 
 6198:          return;
 6199:       }
 6200: 
 6201:       const Node *n1 = side->n1;
 6202:       const Node *n2 = side->n2;
 6203: 
 6204:       const int kb = side->kb;
 6205: 
 6206:       const double veg_h = side->veg_h();
 6207:       const double grav3 = side->grav3();
 6208: 
 6209:       if (side->is2D()) {
 6210:          // Remember: Do not use htot2, which is updated.
 6211:          const double htot = side->htot1();
 6212:          const double hhat = side->hhat;
 6213: 
 6214:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6215: 
 6216:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6217:          const Vector2 tau2 = side->tau();
 6218: 
 6219:          // hat_gam has units of m/s
 6220: 
 6221:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6222:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6223:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6224: 
 6225:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6226: 
 6227: 
 6228:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6229: 
 6230:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6231: 
 6232:       }
 6233:       else { // 3D
 6234: 
 6235:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6236:          // 
 6237:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6238:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6239:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6240:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6241:          // k+1 and k.
 6242: 
 6243: 
 6244:          const int ndim = nvrt - kb;
 6245:          const double zTopCanopy = side->zTopCanopy();
 6246: 
 6247:          // Initialize the tridiagonal system
 6248:          for (int k = kb + 1; k < nvrt; k++) {
 6249:             
 6250:             const int kin = k - (kb + 1);
 6251: 
 6252:             // Vertical viscosity at the face center
 6253:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6254: 
 6255:  
 6256:             alow[kin] = 0.0;
 6257:             cupp[kin] = 0.0;
 6258:             bdia[kin] = 0.0;
 6259: 
 6260:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6261:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6262: 
 6263:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6264:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6265:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6266: 
 6267:             // First part: layers k, k+1
 6268:             if (k < nvrt - 1) {
 6269:                              
 6270:                if constexpr(iveg != 0) {
 6271: 
 6272:                   // If there is vegetation at this level...
 6273:                   if (zTopCanopy > side->zc[k]) {
 6274:                      // If the canopy is above the k layer...
 6275:                      
 6276:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6277:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6278:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6279:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6280: 
 6281:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6282:                      const double vmag2 = length(ut2);
 6283:                      const double vmag1 = length(side->u2[k]);
 6284:                      const double vmag = 0.5*(vmag1 + vmag2);
 6285:                      
 6286:                      // Computes the vegetation alpha at the face center
 6287:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6288: 
 6289:                      cff1 += veg_alpha_sd*dt*vmag;
 6290: 
 6291:                   } // if (zTopCanopy
 6292:                } // if iveg
 6293: 
 6294:                const double dzz = side->Dz(k + 1);
 6295:                const double tmp = dt*dfz/dzz;
 6296:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6297: 
 6298:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6299:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6300:             }
 6301: 
 6302: 
 6303:             // Second part: layers k-1, k
 6304:             if (k > kb + 1) {
 6305: 
 6306:                double cff1 = 1.0; //init \bar{c^k}
 6307: 
 6308:                if constexpr(iveg != 0) {
 6309:                   // If there is vegetation at this level...
 6310:                   if (zTopCanopy > side->zc[k-1]) {
 6311:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6312:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6313: 
 6314:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6315: 
 6316:                      const double vmag2 = length(ut2);
 6317:                      const double vmag1 = length(side->u2[k-1]);
 6318:                      const double vmag = 0.5*(vmag1 + vmag2);
 6319: 
 6320:                      // Computes the vegetation alpha at the face center
 6321:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6322:                      cff1 += veg_alpha_sd*dt*vmag;
 6323:                   } // if zTopCanopy
 6324: 
 6325:                } // if iveg
 6326: 
 6327:                const double dzz = side->Dz(k);
 6328:                const double tmp = dt*dfz/dzz;
 6329:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6330: 
 6331:                alow[kin] += cff1*dzz/6.0 - tmp;
 6332:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6333: 
 6334:             } else { // Bottom boundary
 6335:                // This occurs at the bottom, where the bottom drag is applied.
 6336: 
 6337:                bdia[kin] += dt*side->chi2; // XXXX
 6338: 
 6339:             } // if (k > kb + 1)
 6340: 
 6341: 
 6342:          } // for (int k
 6343: 
 6344: 
 6345: 
 6346:          // Computes the RHS.
 6347:          // -----------------
 6348: 
 6349:          //	BC to be imposed at the end.
 6350: 
 6351:          const Vector2 gradETP  = side->gradETP;
 6352:          const Vector2 gradPr   = side->gradPr;
 6353:          const Vector2 gradEta1 = side->gradEta1;
 6354:          const Vector2 gradEta2 = side->gradEta2;
 6355: 
 6356:          const Vector2 *btu = side->btu;
 6357:          const Vector2 *u2  = side->u2;
 6358:          const double coriolis = side->coriolis;
 6359:          const Vector2 *nuGradU = side->nuGradU;
 6360: 
 6361:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6362:          for (int k = kb + 1; k < nvrt; k++) {
 6363:             const int kin = k - kb - 1;
 6364: 
 6365:             const double dz_0 = side->Dz(k);
 6366:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6367: 
 6368:             rrhs[kin] = {0.0, 0.0};
 6369:             double dz = 0.0;
 6370: 
 6371:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6372:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6373:             if (k < nvrt  ) dz += dz_1;
 6374:             if (k > kb + 1) dz += dz_0;
 6375: 
 6376:             // Elevation gradient, atmospheric pressure and tidal potential
 6377:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6378: 
 6379:             // Coriolis, advection, wind stress, and horizontal viscosity
 6380:             if (k < nvrt - 1) {
 6381: 
 6382: 
 6383:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6384:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6385:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6386:                                                 
 6387: 
 6388:                //diff stress tensors 1006
 6389:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6390:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6391:                   assert(false && "Not implemented: itur == 5");
 6392:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6393:                }
 6394:                // else assert(false && "itur # Not implemented");
 6395: 
 6396:             } else { // k == nvrt - 1 SURFACE
 6397:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6398:                const Vector2 tau2 = side->tau();
 6399: 
 6400:                rrhs[kin] += dt*tau2;          
 6401: 
 6402:             } // if k<nvrt
 6403: 
 6404: 
 6405:             if (k > kb + 1) {
 6406:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6407:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6408:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6409: 
 6410:                // diff stress tensors 1006
 6411:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6412:                   assert(false && "Not implemented: itur == 5");
 6413:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6414:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6415:                }
 6416:                // else assert(false && "itur # Not implemented");
 6417: 
 6418: 
 6419:             } // if k>kbs + 1
 6420: 
 6421:             // Baroclinic
 6422:             Vector2 *bcc = side->bcc;
 6423:             if constexpr(ibc == 0) {
 6424:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6425:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6426: 
 6427:             } // if ibc==0
 6428: 
 6429:          } // k=kb + 1,nvrt
 6430: 
 6431: 
 6432:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6433: 
 6434:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6435:             const int kin = k - kb - 1;
 6436:    
 6437:             // Velocity is always clamped to maximum values
 6438:             side->u2[k] = clampVelocity(soln[kin]);
 6439:          } // k
 6440: 
 6441:       } // if side->is2D()
 6442:       
 6443: 
 6444:       // Impose velocity boundary condition at the bottom
 6445:       if constexpr(imm == 2) { // 3D bed deformation model
 6446:          double dep;
 6447:          Vector2 vel;
 6448: 
 6449:          assert(false && "Not implemented: imm == 2");
 6450:          //update_bdef(time, x0, y0, dep, vel);
 6451:          // side->u2[kb] = vel;
 6452: 
 6453:       } else { // imm = 0 or 1
 6454:          if (side->Cd() == 0.0) {
 6455:             side->u2[kb] = side->u2[kb + 1];
 6456: 
 6457:          } else if (side->is3D()) { // 3D no slip bottom   
 6458:             side->u2[kb] = {0.0, 0.0};
 6459: 
 6460:          }
 6461:           
 6462:       } // if imm
 6463: 
 6464:       // The velocities below the bottom level are set to zero
 6465:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6466: 
 6467: 
 6468:    }
 6469: 
 6470: 
 6471:    __global__ void applyMomentumBC(void) {
 6472: 
 6473:       SIDE_BND(sideBnd);
 6474: 
 6475:       Side *side = sideBnd->side;
 6476:       const BoundarySegment *segment = sideBnd->segment;
 6477:       const Node *n1 = side->n1;
 6478:       const Node *n2 = side->n2;
 6479: 
 6480:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6481: 
 6482:       const bool isLand = segment->isLand;
 6483:       const int ifltype = segment->ifltype;
 6484: 
 6485:       const int kb = side->kb;
 6486: 
 6487: 
 6488:       if (!isLand && ifltype != 0) {
 6489:          const Vector2 *ubc = sideBnd->ubc;
 6490:   
 6491:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6492:             
 6493:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6494:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6495: 
 6496:             if (ifltype == -1) {
 6497:                // Flather 1
 6498: 
 6499:                const double depth = side->depth();
 6500: 
 6501:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6502: 
 6503:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6504: 
 6505:                side->u2[k] = vnorm*side->n;
 6506: 
 6507:             } else if (ifltype == -2) { // Discharge
 6508: 
 6509:                const double eta1 = side->eta1();
 6510:                const double eta2 = side->eta2();
 6511:                const double htot = side->htot2();
 6512: 
 6513:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6514:                assert(false && "Not implemented: Discharge bc");
 6515:                // const double dischrg = discharge(eta1);
 6516:                const double dischrg = 0.0; // XXX REMOVE
 6517:                
 6518: 
 6519:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6520: 
 6521:                const double vnorm = dischrg*eta2/htot;
 6522: 
 6523:                side->u2[k] = vnorm*side->n;
 6524: 
 6525:             }
 6526:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6527:                const double vnorm = dot(side->u2[k], side->n);
 6528: 
 6529:                double rat;
 6530:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6531:                else              rat = segment->vobc2; // outgoing
 6532: 
 6533:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6534: 
 6535:             }
 6536:             else { // not Flather or 3D radiation
 6537:                side->u2[k] = ubc[k];
 6538: 
 6539:             } // if (segment->ifltype...
 6540: 
 6541:          }
 6542: 
 6543:       }
 6544:       else if (isLand) { // if it is land boundary side
 6545: 
 6546:          if constexpr(islip == 0) { // free slip
 6547: 
 6548:             for (int k = kb; k < nvrt; k++) {
 6549: 
 6550:                const Vector2 t = side->t();
 6551:                const Vector2 n = side->n;
 6552: 
 6553:                double vnorm = 0.0; // for most cases
 6554:                const double vtan = dot(side->u2[k], t);
 6555:                
 6556:                side->u2[k] = vtan*t - vnorm*n;
 6557: 
 6558:             }
 6559: 
 6560:          } else { // no slip
 6561:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6562: 
 6563:          }
 6564:       } // if (side segment type...
 6565: 
 6566:    }
 6567: 
 6568: 
 6569:    __global__ void shapiroFilter1(void) {
 6570:       // First step of the Shapiro filter (normally used if indvel<=0)
 6571:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6572: 
 6573:       SIDE(side);
 6574: 
 6575:       // Only internal wet sides are processed
 6576:       if (side->isDry || !(side->isInternal())) return;
 6577: 
 6578:       const int kb = side->kb;
 6579: 
 6580:       for (int mm = 0; mm < niter_shap; mm++) {
 6581: 
 6582:          for (int k = kb + 1; k < nvrt; k++) {
 6583:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6584:             Vector2 suru = {0.0, 0.0};
 6585: 
 6586:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6587: 
 6588:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6589: 
 6590:                int kin = k;
 6591:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6592:                
 6593:                // Get the velocity at the neighbor's side.
 6594:                Vector2 nSideU2 = nSide->u2[kin];
 6595: 
 6596:                // Projects the velocity to the current side frame if needed.
 6597:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6598: 
 6599:                suru += nSideU2;
 6600:             }
 6601: 
 6602:             // Reusing bcc as a temporary array to store the suru values.
 6603:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6604: 
 6605:          }
 6606:       }
 6607:    }
 6608: 
 6609:    __global__ void shapiroFilter2(void) {
 6610:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6611: 
 6612:       SIDE(side);
 6613: 
 6614: 
 6615:       if (side->isDry || !(side->isInternal())) return;
 6616: 
 6617:       const int kb = side->kb;
 6618: 
 6619:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6620: 
 6621:       if (side->is2D()) {
 6622:          side->u2[kb + 1] = side->bcc[kb + 1];
 6623:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6624: 
 6625:       } else {
 6626:          // 3D
 6627:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6628:          
 6629:       }
 6630: 
 6631:    }
 6632: 
 6633: 
 6634:    __global__ void ul0UpdateZCoords(void) {
 6635:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6636:       
 6637:       NODE(node);      
 6638: 
 6639: 
 6640:       if (false) { //node->isDry) { XXXXXXX
 6641: 
 6642:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6643: 
 6644:          if constexpr(ivcor != 1) node->kb = 0;
 6645: 
 6646:       } else {
 6647: 
 6648:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6649:          node->updateKb();
 6650: 
 6651:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6652: 
 6653:       }
 6654: 
 6655:       // We use the temp.b field to store the previous state of isDry.
 6656:       node->tmp.b = node->isDry;
 6657: 
 6658:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6659:       node->isDry = true;
 6660: 
 6661:    }
 6662: 
 6663:    __global__ void ul0ComputeDryElements(void)
 6664:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6665:    {
 6666:       ELEM(elem);
 6667: 
 6668:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6669: 
 6670:       elem->kb = 0;
 6671: 
 6672:       if (elem->isDry) return;
 6673: 
 6674: 
 6675:    //    if(elem->isDry2()) { // XXXX
 6676:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6677:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6678:    //        call parallel_abort(errmsg)
 6679:    //    }
 6680: 
 6681:       const Node *n1 = elem->nodes[0];
 6682:       const Node *n2 = elem->nodes[1];
 6683:       const Node *n3 = elem->nodes[2];  
 6684:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6685: 
 6686:       // Computes element's kb as the minimum of the nodes' kb.
 6687:       const int kb1 = n1->kb;
 6688:       const int kb2 = n2->kb;
 6689:       const int kb3 = n3->kb;
 6690:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6691: 
 6692: 
 6693:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6694: 
 6695: 
 6696:       // Computes the element z as the mean of the nodes z.
 6697:       for (int k = elem->kb; k < nvrt; k++) {
 6698: 
 6699:          // Compute the element z as the mean of the nodes z.
 6700:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6701:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6702:          elem->z[k] /= elem->i34;
 6703: 
 6704:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6705:       }
 6706:                   
 6707:    }
 6708: 
 6709:    __global__ void ul0ComputeDryNodes(void)
 6710:    // Updates node's isDry based on the elements' isDry. 
 6711:    {
 6712:       NODE(node);
 6713: 
 6714:       node->isDry = true;
 6715: 
 6716:       // A node is wet if at least one of the elements sharing it is wet.
 6717:       for (int j = 0; j < node->numElements; j++) {
 6718:          const Element *elem = node->elements[j];
 6719:          if (!elem->isDry) {
 6720:             node->isDry = false;
 6721:             break;
 6722:          }
 6723:       }
 6724: 
 6725:        
 6726:    }
 6727: 
 6728: 
 6729:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6730:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6731:    // node->tmp.b is true if the node was previously dry.
 6732:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6733:    {
 6734:       NODE(node);
 6735:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6736: 
 6737:       // Avoid this the first time step.
 6738:       if (it == iths) return;  
 6739: 
 6740:       const bool wasDry = node->tmp.b;
 6741: 
 6742: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6743: 
 6744:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6745: 
 6746:          for (int k=0; k < nvrt; k++) {
 6747: 
 6748:             Vector3 utmp={0.0, 0.0, 0.0};
 6749: 
 6750:             double ttmp=0.0;
 6751:             double stmp=0.0;
 6752:             int icount=0;
 6753:             for (int j = 0; j < node->numNodes; j++) {
 6754: 
 6755:                const Node *nbrNode = node->nodes[j];
 6756:                
 6757:                const bool wasNbrDry = nbrNode->tmp.b;
 6758: 
 6759:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6760:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6761: 
 6762:                   icount++;
 6763: 
 6764:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6765:                   utmp += nbrNode->uvw2(k);
 6766:                   
 6767:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6768:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6769:                }
 6770:             }
 6771: 
 6772:             if (icount > 0) {
 6773:                const double inv_icount = 1.0/icount;
 6774:                utmp = inv_icount*utmp;
 6775:                node->u2[k]     = {utmp.x, utmp.y};
 6776:                node->w2[k]     = utmp.z;
 6777:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6778:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6779:             } else {
 6780:                node->u2[k] = {0.0, 0.0};
 6781:                node->w2[k] = 0.0;
 6782:                // Initialize tracers to 0.0??? XXXXX
 6783:             }
 6784:          }
 6785:       }
 6786:    }
 6787: 
 6788:   
 6789:    
 6790: 
 6791: 
 6792:    __global__ void ul0UpdateSides(int it, int iths) {
 6793:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6794:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6795:    // The dryness of the sides is updated in ul0UpdateSides2.
 6796: 
 6797:       SIDE(side);
 6798: 
 6799:       // A side is wet if and only if at least one of its elements is wet.
 6800:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6801:  
 6802:       const Node *n1 = side->n1;
 6803:       const Node *n2 = side->n2;
 6804:      
 6805:       const int kb1 = n1->kb;
 6806:       const int kb2 = n2->kb;
 6807: 
 6808:       side->kb = 0; // default when dry
 6809: 
 6810:       if (isWet) {
 6811: 
 6812:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6813: 
 6814:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6815: 
 6816:          side->kb = min(kb1, kb2);
 6817: 
 6818:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6819: 
 6820:          for (int k = side->kb; k < nvrt; k++) {
 6821:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6822: 
 6823:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6824: 
 6825:             // Compute velocity for re-wetted sides 
 6826:             if ((it != iths) && (side->isDry && isWet)) {
 6827: 
 6828:                Vector2 utmp={0.0, 0.0};
 6829: 
 6830:                int icount=0;
 6831: 
 6832:                // For all the sides on the two elements that share this side
 6833:                for (int j = 0; j < 2; j++) {
 6834:                   const Element *elem = side->elems[j];
 6835:                   if (elem == nullptr) continue;
 6836: 
 6837:                   for (int jj=0; jj < elem->i34; jj++) {
 6838:                      const Side *nSide = elem->sides[jj];
 6839:                      if (nSide->isDry) continue;
 6840: 
 6841:                      icount++;
 6842:                      utmp += nSide->u2[k];  
 6843:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6844:                   }
 6845:                }
 6846:                   
 6847:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6848:                if (icount > 0)  side->u2[k] = utmp/icount;
 6849:                else             side->u2[k] = {0.0, 0.0};
 6850:                   
 6851:             } // if ((it != iths) && (side->isDry && isWet))
 6852: 
 6853:          } // for k
 6854: 
 6855:       } // if isWet 
 6856:       
 6857: 
 6858: 
 6859:    }
 6860: 
 6861:    __global__ void ul0UpdateSides2(void) {
 6862:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6863:    
 6864:          SIDE(side);
 6865:    
 6866:          const Element *e1 = side->elems[0];
 6867:          const Element *e2 = side->elems[1];
 6868: 
 6869:          // A side is wet if and only if at least one of its elements is wet.
 6870:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6871: 
 6872:          // Update the side's dryness
 6873:          side->isDry = !isWet;
 6874: 
 6875:    }
 6876: 
 6877: 
 6878:    __global__ void zeroNodalVelocities(void) {
 6879:       NODE(node);
 6880: 
 6881:       for (int k = 0; k < nvrt; k++) {
 6882:          node->u2[k]   = {0.0, 0.0};
 6883:          node->w2[k]   = 0.0;
 6884:          node->utmp[k] = {0.0, 0.0};         
 6885:       }
 6886:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6887:    }
 6888:  
 6889: 
 6890:    __global__ void computeNodalVerticalVelocities1(void) {
 6891:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6892:    // Adds the element's vertical velocity times the element's area.
 6893:       ELEM(elem);
 6894: 
 6895:       for (int j = 0; j < elem->i34; j++) {
 6896:          Node *node = elem->nodes[j];
 6897: 
 6898:          for (int k = node->kb; k < nvrt; k++) {
 6899:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6900:          }
 6901:          atomicAdd(&(node->tmp.d), elem->area);
 6902:       }
 6903:    }
 6904: 
 6905:    __global__ void computeNodalVerticalVelocities2(void) {
 6906:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6907:    // Divides by the total area of the elements sharing the    node.
 6908:       NODE(node);
 6909: 
 6910: 
 6911:       const double invArea = 1.0 / node->tmp.d;
 6912:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6913: 
 6914:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6915:    }
 6916: 
 6917: 
 6918:    __global__ void computeNodalHorizontalVelocities1(void) {
 6919: 
 6920:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6921: 
 6922:       ELEM(elem);
 6923: 
 6924:       if (elem->isDry) return;
 6925: 
 6926:       const int kb = elem->kb;
 6927:       const bool isTri = elem->isTri();
 6928: 
 6929:       if constexpr(indvel <= 0) {
 6930:          // Assuming discontinous hvel.
 6931: 
 6932:          if (isTri) { // For triangles
 6933:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6934:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6935:             #pragma unroll
 6936:             for (int j = 0; j < 3; j++) {
 6937:                // For every node of the triangle...
 6938:                Node *node = elem->nodes[j];
 6939: 
 6940:                if (node->isDry) continue;
 6941: 
 6942:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6943:                const Side *s2 = elem->sides[(j + 1) % 3];
 6944:                const Side *s3 = elem->sides[(j + 2) % 3];
 6945: 
 6946:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6947: 
 6948:                atomicAdd(&(node->tmp.i), 1);
 6949: 
 6950:                for (int k = kb; k < nvrt; k++)  {
 6951:                   Vector2 s1u2 = s1->u2[k];
 6952:                   Vector2 s2u2 = s2->u2[k];
 6953:                   Vector2 s3u2 = s3->u2[k];
 6954: 
 6955:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6956:                   if constexpr(ics == 2) {
 6957:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6958:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6959:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6960:                   }
 6961: 
 6962:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 6963:                   u = clampVelocity(u);
 6964:                   atomicAdd(&(node->utmp[k].x), u.x);
 6965:                   atomicAdd(&(node->utmp[k].y), u.y);
 6966: 
 6967:                }
 6968: 
 6969:             }
 6970:          }
 6971:          else { // For quads
 6972: 
 6973: 
 6974:             // Compute the bilinear coordinates of the center of each diagonal.
 6975:             double xi, eta;
 6976:             double shp13[4], shp24[4];
 6977:             Point2 x0, x1, x2, x3;
 6978:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 6979:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 6980:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 6981: 
 6982:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 6983:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 6984: 
 6985: 
 6986: 
 6987: 
 6988:             for (int k = kb; k < nvrt; k++) {
 6989: 
 6990:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 6991:                Vector2 sideU[4];
 6992:                #pragma unroll
 6993:                for (int j = 0; j < 4; j++) {
 6994:                   Vector2 u = elem->sides[j]->u2[k];
 6995:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 6996:                   sideU[j] = u;
 6997:                }
 6998: 
 6999:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7000:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7001: 
 7002:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7003:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7004:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7005:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7006:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7007:                #pragma unroll
 7008:                for (int j = 0; j < 4; j++) {
 7009:                   Node *node = elem->nodes[j];
 7010:                   if (node->isDry) continue;
 7011: 
 7012:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7013:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7014:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7015:                }
 7016:             }
 7017: 
 7018:          }
 7019: 
 7020:       }
 7021:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7022:       
 7023:    }
 7024: 
 7025: 
 7026:    __global__ void computeNodalHorizontalVelocities2(void) {
 7027:       NODE(node);
 7028: 
 7029:       const int nodeCount = node->tmp.i;
 7030: 
 7031:       if (nodeCount == 0) 
 7032:       {
 7033:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7034:          return;
 7035:       }
 7036: 
 7037:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7038:       
 7039:       const int kb = node->kb;
 7040: 
 7041:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7042:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7043:       
 7044:       
 7045:    }   
 7046: 
 7047:  
