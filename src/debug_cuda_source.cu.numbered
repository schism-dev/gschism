 2802: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2803: 
 2804: 
 2805: __device__ void Node::updateKb(void) {
 2806: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2807: 
 2808:    if constexpr(ivcor == 1) return;
 2809: 
 2810: 
 2811:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2812: 
 2813:    if constexpr(ivcor == 2) {  // SZ coordinates
 2814:       
 2815:       // Compute bottom level index
 2816:       if (depth <= mesh->h_s) {
 2817:          kb = izlev;   
 2818:          
 2819:       } else {
 2820:          kb = -1;
 2821:          int L = 0;
 2822:          int R = nzlev; 
 2823:          
 2824:          while (L <= R) {
 2825:             int M = (R + L) / 2;
 2826: 
 2827: 
 2828:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2829:             
 2830:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2831:                R = M;
 2832:             } else {
 2833:                L = M;
 2834:             }
 2835: 
 2836:             if (R - L == 1) {
 2837:                kb = L;
 2838:                break;
 2839:             }
 2840:          }
 2841: 
 2842:          // Checks that the binary search was successful
 2843:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2844:        
 2845:       }
 2846:    } 
 2847: }
 2848: 
 2849: 
 2850: __device__ __inline__ void Node::updateZCoordData(void) {
 2851: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2852: 
 2853:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2854:    // if (isDry2()) {
 2855:    //    kb = -1;  // XXXXXXXX KKKKK
 2856:    //    return;
 2857:    // }
 2858: 
 2859: 
 2860:    if constexpr(ivcor == 2) {  // SZ coordinates
 2861:       
 2862:       // Compute bottom level index
 2863:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2864:    } 
 2865:    else if (ivcor == 1) {  // Localized sigma
 2866:       // Do nothing
 2867:    }
 2868: 
 2869: 
 2870: }
 2871: 
 2872: 
 2873: __device__ double Node::compZCoord(int k) const {
 2874:    // Computes the z coordinate at level k.
 2875:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2876:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2877:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2878:    // used 
 2879:    
 2880:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2881: 
 2882:    if (isDry2()) return -depth;  // XXXX I used to return 0.0
 2883: 
 2884:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2885: 
 2886:    if constexpr(ivcor == 2) {
 2887: 
 2888:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2889:       const double h_c = mesh->h_c;
 2890:       const double theta_f = mesh->theta_f;
 2891:       const double sinh_theta_f = mesh->sinh_theta_f;
 2892: 
 2893:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2894:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2895:       // once per time step/node.
 2896:       // CHECK: updateZCoordData
 2897: 
 2898:       //  To simplify comparisons, I define index versions of count variables.
 2899:       if      (k == ivrt)           return eta2; 
 2900:       else if (k == izlev)          return -hmod2;
 2901:       else if (k == kb)             return -depth;
 2902:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2903:       else if (k > izlev) {
 2904:          const int ksig = k - izlev;
 2905: 
 2906:          if (hmod2 <= h_c) {
 2907: 
 2908:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2909:          } 
 2910:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2911:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2912:             assert(false && "ZCOOR: invalid h_c\n");
 2913:          } 
 2914:          else {
 2915:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2916:                          h_c * mesh->sigma[ksig] + 
 2917:                          (hmod2 - h_c) * mesh->cs[ksig];
 2918:          }
 2919:       } else { 
 2920:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2921:       }
 2922: 
 2923:    }
 2924:    else if constexpr(ivcor == 1) {
 2925:       if (k == kb) return -depth;
 2926:       else if (k == nvrt-1) return eta2;
 2927:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2928:    }
 2929:    
 2930:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2931:    return 0.0;
 2932: }
 2933: 
 2934: 
 2935: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2936:    // Computes the bottom drag Cd based on the selected nchi
 2937: 
 2938:    if constexpr(nchi == 0) {
 2939:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2940:       Cd = drag;  // Read from drag file
 2941: 
 2942:    } else if constexpr(nchi == 1) {
 2943:       // 
 2944: 
 2945:       bool ltmp = false; // for WBL iteration
 2946: 
 2947:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2948:       if (isDry || (rough == 0.0)) {
 2949:          Cd = 0.0;
 2950: 
 2951:       } else { //roughness >0 
 2952:          
 2953:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2954: 
 2955:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2956: 
 2957:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2958: 
 2959:       } // if rough
 2960: 
 2961:    } else if constexpr(nchi == -1) {
 2962:    // Manning 
 2963:  
 2964:       const double htot = max(hmin_man, htot2()); 
 2965:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2966: 
 2967:    } else {
 2968:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2969:       
 2970:    } // if nchi
 2971: }
 2972: 
 2973: 
 2974: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2975:    // Checks if a side in on the boundary
 2976:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2977: 
 2978:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2979:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2980: 
 2981:    // Indices of the nodes that form the side
 2982:    const int n1 = side.n1->idx;
 2983:    const int n2 = side.n2->idx;
 2984:    isLand = false;
 2985:    
 2986: 
 2987:    // Check if the side is on a land boundary
 2988:    for (int i = 0; i < nland; i++) {
 2989:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2990:          // Consecutive nodes in the land boundary segment
 2991:          const int b1 = ilnd[i + j*nland];
 2992:          const int b2 = ilnd[i + (j + 1)*nland];
 2993: 
 2994:          assert(b1 != -1 && b2 != -1);
 2995: 
 2996:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2997:             
 2998:             isLand = true;
 2999:             return i;
 3000:          }
 3001:       }
 3002:    }
 3003: 
 3004:    // Check if the side is on an open boundary
 3005:    for (int i = 0; i < nope; i++) {
 3006:       for (int j = 0; j < nond[i] - 1; j++) {
 3007:          // Consecutive nodes in the open boundary segment
 3008:          const int b1 = iond[i + j*nope];
 3009:          const int b2 = iond[i + (j + 1)*nope];
 3010: 
 3011:          assert(b1 != -1 && b2 != -1);
 3012: 
 3013:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3014:             isLand = false;
 3015:             return i;
 3016:          }
 3017:       }
 3018:    }
 3019: 
 3020:    return -1;
 3021: }
 3022: 
 3023: 
 3024: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3025:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3026:                                     double *wind_rotate_angle, 
 3027:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3028:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3029:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3030:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3031:                                     double *drag, double *roughness, double *rmanning) {
 3032: 
 3033:    NODE(pnode);  
 3034:    const int i = idx_node;
 3035:    Node &node(*pnode);
 3036: 
 3037:    node.idx = i;
 3038: 
 3039:    const int idxNodeStart = nodeNeighNodesStart[i];
 3040:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3041:    node.numNodes = idxNodeEnd - idxNodeStart;
 3042:    node.nodes = nodeNeighNodes + idxNodeStart;
 3043:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3044: 
 3045: 
 3046: 
 3047:    const int idxElemStart = nodeNeighElemsStart[i];
 3048:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3049:    node.numElements = idxElemEnd - idxElemStart;
 3050:    node.elements = nodeNeighElems + idxElemStart;
 3051: 
 3052: 
 3053:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3054:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3055:       const int partNode = localNodePart[idxNodeGlobal]; 
 3056:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3057: 
 3058:       Node *node_ptr = nodes[partNode] + idxNode;
 3059:       
 3060:       nodeNeighNodes[idx] = node_ptr;
 3061:    }
 3062: 
 3063: 
 3064:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3065:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3066:       const int partElem = localElemPart[idxElemGlobal];
 3067:       const int idxElem  = localElemIndices[idxElemGlobal];
 3068: 
 3069:       Element *elem_ptr = elems[partElem] + idxElem;
 3070: 
 3071:       nodeNeighElems[idx] = elem_ptr;
 3072:    }      
 3073: 
 3074:    node.wind_angle = wind_rotate_angle[i];
 3075: 
 3076: 
 3077:    node.p.x   = node_coords[i * 3];
 3078:    node.p.y   = node_coords[i * 3 + 1];
 3079:    node.depth = node_coords[i * 3 + 2];
 3080: 
 3081:    if (use_ll) {
 3082:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3083:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3084:    }
 3085: 
 3086: 
 3087:    node.numSides = 0;
 3088: 
 3089:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3090:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3091:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3092:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3093:    else assert(false && "populateNodes: selected nchi not implemented.");
 3094:    
 3095:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3096:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3097:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3098: 
 3099:    
 3100:    // Links the node to the boundary information
 3101:    if (isbnd[i] >= 0) {
 3102:      
 3103:       // Get the index of the node boundary
 3104:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3105: 
 3106:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3107:       node.nodeBnd->node = &node;
 3108: 
 3109:       node.nodeBnd->sideBnd1 = nullptr;
 3110:       node.nodeBnd->sideBnd2 = nullptr;
 3111: 
 3112:       if (isbnd[i]>=0) {
 3113: 
 3114:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3115:          
 3116:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3117: // printf("(isbnd[i]==0)?3:0 = %d\n", (isbnd[i]==0)?3:0);         
 3118:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3119: 
 3120:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3121:          node.nodeBnd->segment->clen  = nan("1");
 3122:          node.nodeBnd->segment->carea = nan("1");
 3123: 
 3124:       }
 3125:    } else {
 3126: 
 3127:       node.nodeBnd = nullptr; // For internal nodes
 3128: 
 3129:       if (isbnd[i] == landSegment) {
 3130:          node.nodeBnd = &landBoundaryNode;
 3131:          node.nodeBnd->segment = &landBoundarySegment;
 3132:       }
 3133:       
 3134:    }
 3135:    
 3136:    // XXXX GAUSSIAN HILL VELOCITIES
 3137: #ifdef GAUSSIAN_HILL_VELOCITIES
 3138:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3139:       constexpr double rot_per = 3000.0;
 3140:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3141:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3142:    // XXXXX
 3143: #endif
 3144: 
 3145: }
 3146: 
 3147: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3148:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3149:                                     double *wind_rotate_angle,   
 3150:                                     int *isdel, int *isidenode, int *isbnd,
 3151:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3152:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3153:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3154:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3155:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3156:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3157:                                     double *drag, double *roughness) {
 3158: 
 3159: 
 3160:    SIDE(pside);
 3161:    Side &side(*pside);
 3162:    const int i = idx_side;
 3163: 
 3164:    side.idx = i;  
 3165:    
 3166:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3167:    const double fc   = 2.0*omega_e*sin(sfea0);
 3168:    const double beta = 2.0*omega_e*cos(sfea0);
 3169: 
 3170:    // finding the pointer to the nodes that form the side
 3171:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3172:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3173: 
 3174:    const int locidx_n1 = localNodeIndices[idx_n1];
 3175:    const int locidx_n2 = localNodeIndices[idx_n2];
 3176:    const int part_n1 =   localNodePart[idx_n1];
 3177:    const int part_n2 =   localNodePart[idx_n2];
 3178: 
 3179:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3180:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3181: 
 3182:    // Counts the number of sides connected to each node
 3183:    side.n1->numSides++;
 3184:    side.n2->numSides++;
 3185: 
 3186:    // Normal, unitary vector to the side
 3187:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3188:    side.n = normalize(side.n);
 3189: 
 3190:    // Side boundary type
 3191:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3192:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3193: 
 3194:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3195:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3196:    {
 3197:       bool isLand = false;
 3198:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3199:       
 3200:       if (isbs > -1) {
 3201:          // assert(isLand || isbs>=0);
 3202:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3203: 
 3204:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3205: 
 3206:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3207:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3208: 
 3209:          assert (isLand == side.sideBnd->segment->isLand);
 3210: 
 3211:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3212:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3213:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3214: 
 3215:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3216:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3217:          
 3218:          side.sideBnd->side = &side;
 3219: 
 3220:       }
 3221:       else {
 3222:          side.sideBnd = nullptr;
 3223:       }
 3224:    }
 3225:    else 
 3226:    {
 3227:       side.sideBnd = nullptr;
 3228:    }
 3229: 
 3230: 
 3231:    // finding the pointer to the elements that share the side
 3232:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3233:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3234: 
 3235:    if (idx_e1 > -1) {
 3236:       const int locidx_e1 = localElemIndices[idx_e1];
 3237:       const int part_e1 =  localElemPart[idx_e1];
 3238:       side.elems[0] = elems[part_e1] + locidx_e1;
 3239: 
 3240:    }
 3241:    else {
 3242:       side.elems[0] = nullptr;
 3243:    }
 3244: 
 3245:    if (idx_e2 > -1) {
 3246:       const int locidx_e2 = localElemIndices[idx_e2];
 3247:       const int part_e2 =  localElemPart[idx_e2];
 3248:       side.elems[1] = elems[part_e2] + locidx_e2;
 3249:    }
 3250:    else {
 3251:       side.elems[1] = nullptr;
 3252:    }
 3253: 
 3254:    // Compute the center of the side
 3255:    side.center = 0.5*(side.n1->p + side.n2->p);
 3256: 
 3257:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3258:    side.shapiro = shapiro0;
 3259: 
 3260: #ifdef GAUSSIAN_HILL_VELOCITIES
 3261: // XXXX
 3262: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3263: constexpr double rot_per=3000.0;
 3264: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3265: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3266: // XXXXX      
 3267: #endif
 3268:    // Compute the z level at the center of the side
 3269:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3270:    
 3271:    // Compute the length of the side
 3272:    const Vector2 vLen = side.n2->p - side.n1->p;
 3273:    side.len = sqrt(dot(vLen, vLen));
 3274: 
 3275: 
 3276:    // Compute the Coriolis coefficient
 3277: 
 3278:    if constexpr(ncor == -1 || ncor == 0) {
 3279:       side.coriolis = coricoef;
 3280:    }
 3281:    else {
 3282:       const double sphi = side.lat();  // Latitude at the center of the side
 3283: 
 3284: // XXXXXX ERROR WHEN use_ll is false??????
 3285:       if constexpr(ics == 1) {
 3286:          // XXXXXXX
 3287:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3288:       }
 3289:       else {
 3290:          side.coriolis = 2.0*omega_e*sin(sphi);
 3291:       }
 3292: 
 3293:    }
 3294: }
 3295: 
 3296: 
 3297: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3298:    double *node_coords, double *node_coords_ll, bool use_ll,
 3299:    double *wind_rotate_angle,   
 3300:    int *isdel, int *isidenode, int *isbnd,
 3301:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3302:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3303:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3304:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3305:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3306:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3307:    double *drag, double *roughness) {
 3308: 
 3309:    ELEM(pelem);
 3310:    Element &elem(*pelem);
 3311:    const int i = idx_elem;
 3312: 
 3313:    elem.idx = i;
 3314: 
 3315:    for (int j = 0; j < i34[i]; j++) {
 3316:       const int idxNode = elnode[i*4 + j];  
 3317:       const int idxSide = elside[i*4 + j];
 3318:       
 3319:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3320:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3321: 
 3322:       // Find the neighboring element  
 3323:       if (elem.sides[j]->elems[0] == &elem) {
 3324:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3325:       }
 3326:       else {
 3327:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3328:       }
 3329:       
 3330:    }
 3331: 
 3332:    elem.i34 = i34[i];
 3333: 
 3334:    // Compute the barycenter of the element and its depth
 3335:    elem.center = {0.0, 0.0};
 3336:    elem.depth = 0.0;
 3337:    for (int j = 0; j < i34[i]; j++) {
 3338: 
 3339:       elem.center += elem.nodes[j]->p/i34[i];
 3340:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3341:    }
 3342: 
 3343: 
 3344:    
 3345:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3346:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3347: 
 3348:    elem.area = elem.computeSignedArea(); 
 3349:    elem.radius = sqrt(elem.area)/pi; 
 3350:    
 3351:    // Determines which way the normal vector to each side is oriented.
 3352:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3353:    for (int j = 0; j < i34[i]; j++)  
 3354:    {
 3355:       if (elem.sides[j]->elems[0] == &elem) {
 3356:          elem.ssign[j] =  1.0;
 3357:       }
 3358:       else {
 3359:          elem.ssign[j] = -1.0;
 3360:       }
 3361: 
 3362:    }
 3363: 
 3364:    // Derivatives of shape functions
 3365:    //  For ics=2, this is done inside element/ll frame XXX
 3366:    //  For quads, the derivative is evaluated at centroid
 3367:    for (int j = 0; j < elem.i34; j++) {
 3368:       const double area = elem.area;
 3369:       const int id2 = elem.nxq(1 + j);
 3370:       const int id3 = elem.nxq(2 + j);
 3371:       const int id4 = elem.nxq(3 + j);
 3372:       if (elem.isTri()) {
 3373:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3374:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3375:          // da1/dx = (y1 - y2)/(2*area)
 3376:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3377:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3378:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3379:       }
 3380:       else  { // Quad; evaluate at centroid
 3381:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3382:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3383:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3384:       } // if Tri
 3385: 
 3386:    } // for j   
 3387:    
 3388:    
 3389: 
 3390: }
 3391: 
 3392: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3393:                                             double *emo, double *efa, 
 3394:                                             double *umo, double *ufa, 
 3395:                                             double *vmo, double *vfa) {
 3396: 
 3397: 
 3398:    NODE_BND(nodeBnd);
 3399:    const int idx = idx_node_bnd;    
 3400: 
 3401:    nodeBnd->idx = idx;
 3402: 
 3403:    // Need to find the segment index and the index of the node on the segment
 3404:    int idxNode = -1;
 3405:    int iseg, i;
 3406:    for (iseg = 0; iseg < nope; iseg++) {
 3407:       // for each segment...
 3408:       for (i = 0; i < nond[iseg]; i++) {
 3409:          idxNode = iond[iseg + i*nope];
 3410:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3411:          
 3412:       }
 3413:    }
 3414: 
 3415:    assert(iseg < nope && "iseg is out of bounds");
 3416: 
 3417: found: // Jumped here when the node was found
 3418: 
 3419:    nodeBnd->isEssentialBC = true;
 3420:    nodeBnd->elbc = 0.0;
 3421: 
 3422:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3423: 
 3424:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3425:       nodeBnd->efa[jfr] = efa[idx2];
 3426:       nodeBnd->emo[jfr] = emo[idx2];
 3427:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3428:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3429: 
 3430:    }
 3431:         
 3432: 
 3433: }
 3434: 
 3435: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3436:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3437:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3438:                 int *isdel, int *isidenode, int *isbnd,
 3439:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3440:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3441:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3442:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3443:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3444:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3445:                 double *drag, double *roughness,
 3446:                 double *emo, double *efa, 
 3447:                 double *umo, double *ufa, 
 3448:                 double *vmo, double *vfa) {
 3449: 
 3450:    // printf("Populating mesh for partition %d\n", partNum);
 3451: 
 3452:    // XXXXXX THIS function does almost nothing. 
 3453: 
 3454:    nbs = *sharedIdxSideBoundary + 1;
 3455:    nbp = *sharedIdxNodeBoundary + 1;
 3456: 
 3457:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3458: 
 3459: }
 3460: 
 3461: 
 3462: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3463:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3464:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3465: 
 3466: 
 3467:    NODE(node1);
 3468: 
 3469:    node1->clearMatrixRow();
 3470:    node1->qel = 0.0;
 3471: 
 3472:    // THIS IS FOR STRUCTURES XXX
 3473:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3474: 
 3475:    
 3476:    for (int j=0; j<node1->numElements; j++) {
 3477:       // For each element connected to the node...
 3478: 
 3479:       Element *elem = node1->elements[j];
 3480: 
 3481: // if (elem->isDry) continue;  /// XXXX KKKKKK NOT IN THE ORIGINAL CODE
 3482: 
 3483: 
 3484:       // Compute the average gravity
 3485:       const double grav3 = elem->mean(&Node::grav2);
 3486: 
 3487:       // Look at the documentation for the description of the terms in the following integrals
 3488: 
 3489:       // Integral I_1 
 3490:       // \bar{\breve{H}} 
 3491:       const double hhatb = elem->mean(&Side::hhat);        
 3492: 
 3493:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3494: 
 3495:       const int id1 = elem->nodeLocalIdx(node1); 
 3496:       const double area = elem->area;
 3497: 
 3498:       if (elem->isTri()) {
 3499: 
 3500:          // To clarify the notation in this section: 
 3501:          //   i stands for the node under consideration (node1)
 3502:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3503:          const int id2 = elem->nxq(1 + id1);
 3504:          const int id3 = elem->nxq(2 + id1);
 3505:          Node *node2 = elem->nodes[id2];
 3506:          Node *node3 = elem->nodes[id3];
 3507: 
 3508:          const Point2 x1 = node1->p;
 3509:          const Point2 x2 = node2->p;
 3510:          const Point2 x3 = node3->p;
 3511: 
 3512:          // integral of phi_i*phi_j
 3513:          const double ipp_ii = (1.0/6.0 )*area;
 3514:          const double ipp_ij = (1.0/12.0)*area;
 3515:          const double ipp_ik = (1.0/12.0)*area;
 3516: 
 3517:          // integral of [(grad phi_i) * (grad phi_j)]
 3518:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3519:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3520:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3521: 
 3522:          // Computes the different components of integral I_1 of each node with respect to node i.
 3523:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3524:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3525:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3526: 
 3527:          node1->addToSparseMatrix(node1, I1_ii);
 3528:          node1->addToSparseMatrix(node2, I1_ij); 
 3529:          node1->addToSparseMatrix(node3, I1_ik);
 3530: 
 3531:       }
 3532:       else { // Quad
 3533:          // XXX IMPLEMENT THIS
 3534:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3535: 
 3536:          // To clarify the notation in this section: 
 3537:          //   i stands for the node under consideration (node1)
 3538:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3539:          const int id2 = elem->nxq(1 + id1);
 3540:          const int id3 = elem->nxq(2 + id1);
 3541:          const int id4 = elem->nxq(3 + id1);
 3542:          Node *node2 = elem->nodes[id2];
 3543:          Node *node3 = elem->nodes[id3];
 3544:          Node *node4 = elem->nodes[id4];         
 3545: 
 3546:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3547:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3548:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3549:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3550:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3551: 
 3552:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3553:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3554:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3555:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3556:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3557: 
 3558:          // Computes the different components of integral I_1 of each node with respect to node i.
 3559:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3560:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3561:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3562:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3563: 
 3564:          node1->addToSparseMatrix(node1, I1_ii);
 3565:          node1->addToSparseMatrix(node2, I1_ij); 
 3566:          node1->addToSparseMatrix(node3, I1_ik);
 3567:          node1->addToSparseMatrix(node4, I1_il);
 3568:   
 3569: 
 3570: 
 3571:       
 3572:       } 
 3573: 
 3574:  
 3575:       // Integral I_4
 3576:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3577:       // Where
 3578:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3579: 
 3580:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3581:       // of U over the element.
 3582:       Vector2 U = {0.0, 0.0};
 3583:       for (int m=0; m < elem->i34; m++) {      
 3584:          const Side *side = elem->sides[m];
 3585: 
 3586:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3587:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3588:       }
 3589:       U = U/elem->i34;
 3590: 
 3591: 
 3592:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3593: 
 3594: 
 3595:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3596:       const double I_4_1 = dot(gradPhi_1, U);
 3597: 
 3598: 
 3599:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3600:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3601:      
 3602:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3603: 
 3604:       // Additional terms 
 3605:       double vnorm = 0.0;
 3606:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3607:          Vector3 ubed = {0.0, 0.0, 0.0};
 3608:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3609: 
 3610:          Vector3 gradP = {0.0, 0.0, 1.0};
 3611:          for (int m=0; m < elem->i34; m++) {
 3612:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3613:            gradP += toVector3(gradP_2D, 0.0);
 3614:          }   
 3615:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3616:       } // imm==2
 3617: 
 3618:       if (elem->isTri()) {
 3619:          for (int l=0; l<3; l++) {
 3620: 
 3621:             Node *node = elem->nodes[l];
 3622: 
 3623:             double fac = (node == node1) ? 2.0 : 1.0;
 3624:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3625:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3626:            
 3627:          }
 3628: 
 3629: 
 3630:          if (!elem->isDry) {
 3631:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3632: 
 3633:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3634: 
 3635:          }
 3636: 
 3637:       } // isTri
 3638:       else { // isQuad
 3639:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3640:          // for (int l=0; l<4; l++) {
 3641:          //   const Node *node = elem->nodes[l];
 3642: 
 3643:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3644:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3645: 
 3646:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3647:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3648:          // }
 3649: 
 3650:       } // isQuad
 3651: 
 3652: 
 3653:      node1->qel += (dt/elem->i34)*elem->vsource;
 3654:       
 3655: 
 3656:    } // for all elements connected to the node
 3657:    
 3658: 
 3659:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3660:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3661:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3662:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3663:       // If it is an open boundary node...
 3664: 
 3665:       // At least one open bnd side, maybe two
 3666:       for (int l=0; l<2; l++) { 
 3667: 
 3668:          // Gets each of the sides sharing the node. 
 3669:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3670: 
 3671:        
 3672: 
 3673:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3674:          if (sideBnd != nullptr) {
 3675:             // If the side is on a boundary...
 3676: 
 3677:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3678: 
 3679:             // Get the boundary segment
 3680:             const BoundarySegment *sideSegment = sideBnd->segment;
 3681:             const Side *side = sideBnd->side;
 3682: 
 3683:             // Integral I_3
 3684:             if (sideSegment->ifltype != 0) {
 3685:             // Natural or Flather b.c.
 3686: 
 3687:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3688:                // especially for Flather b.c.
 3689:                double ri3 = 0.0;
 3690:                if (!side->isDry) {
 3691:                   // If the side is not dry
 3692:                   
 3693:                   // Computes the side flux of (uth, vth)
 3694:                   double Vn = 0.0;
 3695:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3696:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3697:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3698: 
 3699:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3700:                   }
 3701: 
 3702:                   ri3 = 0.5*side->len*Vn;
 3703:                }
 3704: 
 3705:                if (sideSegment->ifltype == -1) { // Flather 1
 3706: 
 3707:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3708:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3709: 
 3710:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3711:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3712:                   
 3713:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3714:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3715: 
 3716:                } 
 3717:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3718:                   // Reset ri3
 3719:                   ri3 = 0.0;
 3720: 
 3721:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3722: 
 3723:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3724: 
 3725:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3726:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3727: 
 3728:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3729:                   node1->addToSparseMatrix(node1, con0*2.0);
 3730:                   node1->addToSparseMatrix(node2, con0);
 3731: 
 3732:                } // if Flather or Discharge
 3733: 
 3734:                node1->qel -= thetai*dt*ri3;
 3735: 
 3736: 
 3737:             } // I_3
 3738:           
 3739: 
 3740:             // Integral I_5
 3741:             if(!side->isDry) {
 3742: 
 3743:                const double Unbar = dot(side->U, side->n);
 3744:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3745: 
 3746:             } // I_5
 3747: 
 3748:          } // if is boundary side
 3749: 
 3750:       } // for l
 3751: 
 3752:    } // if isbnd
 3753: 
 3754: 
 3755: }
 3756: 
 3757: 
 3758: 
 3759: extern "C" {
 3760:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3761:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3762:                                   int* indices, int* indptr) {
 3763: 
 3764:       NODE(node);
 3765:       
 3766:       const int idx = node->idx;
 3767:       
 3768:       // Computes the index in the nzz array      
 3769:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3770: 
 3771: 
 3772:       indptr[idx] = nzzIdx;
 3773:       indices[nzzIdx] = idx;
 3774: 
 3775:       data_d[nzzIdx]    = node->coeffDiag;
 3776:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3777: 
 3778:       diag_d[idx] = 1.0/node->coeffDiag;
 3779:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3780: 
 3781:       b_d[idx] = node->qel;
 3782:       b_f[idx] = (float)node->qel;
 3783: 
 3784:       for (int k = 0; k < node->numNodes; ++k) {
 3785:          const Node* nb = node->nodes[k];
 3786: 
 3787:          const int j = nb->idx;
 3788: 
 3789:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3790:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3791: 
 3792:          indices[nzzIdx + k + 1] = j;
 3793:       }
 3794: 
 3795: 
 3796:    }
 3797: 
 3798: 
 3799: 
 3800:    __global__ void solverCopyResult(double* x) {
 3801:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3802:       NODE(node);
 3803:       const int idx = node->idx;
 3804: 
 3805:       node->mX = x[idx];
 3806:    }
 3807: 
 3808: 
 3809:    __global__ void rollUpElevation(void) {
 3810: 
 3811:       NODE(node);
 3812: 
 3813:       node->eta1 = node->eta2;
 3814: 
 3815:    }
 3816: 
 3817: 
 3818:    __global__ void backtrackAllNodes(void) {
 3819: 
 3820:       // max/min # of sub-divisions
 3821:       const int ndelt_max = max(1.0, dt/dtb_min);
 3822:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3823: 
 3824:       // Removed all references to swild98 XXX
 3825:       // swild98=0.d0 !init
 3826: 
 3827: 
 3828:       SIDE(side);
 3829: 
 3830:       const int kb = side->kb;
 3831: 
 3832: 
 3833:       // Initialize btrack velocities to the actual velocities at the side 
 3834:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3835: 
 3836:   
 3837: 
 3838:       // if (side->isDry) return;
 3839:       
 3840: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3841: 
 3842:       // Checks that at least one element is not dry
 3843:       const Element *elem1 = side->elems[0];
 3844:       const Element *elem2 = side->elems[1];
 3845: 
 3846: if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3847: 
 3848:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3849:       
 3850:       // XXXXXX
 3851:       // !swild_tmp to store global coord. of the starting side
 3852:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3853:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3854:       // !Use sframe2 
 3855:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3856: 
 3857: 
 3858:       for (int k = kb; k < nvrt; k++) {
 3859:       //  Initialize (xt,yt,zt), nnel and vel.
 3860:       //  For ics=2, the coordinates are in local frames
 3861:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3862: 
 3863: 
 3864:          const int iadvf = side->iadv();  // Advection flag
 3865: 
 3866:          Point3 xt;
 3867:          if constexpr(ics==1) {
 3868:             xt = side->center3D(k); 
 3869:          }
 3870:          else // lat/lon; in side lat/lon frame
 3871:          {
 3872:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3873:          // XXX IMPLEMENT THIS
 3874:       //          xt=0.d0
 3875:       //          yt=0.d0
 3876:       //          !centroid coord. for nudging
 3877:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3878:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3879:          }  // ics
 3880: 
 3881: 
 3882: 
 3883:          // If on land or open boundary...
 3884:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3885:          
 3886:          const double vmag = length(side->u2[k]);
 3887: 
 3888:          if (vmag <= velmin_btrack) {
 3889:             // No activity 
 3890: 
 3891:             side->btu[k] = side->u2[k];
 3892: // addDebugPlot(side->center, side->center, 0x00000F, '+');            
 3893:             
 3894:          } else {  // do btrack
 3895: 
 3896:             // Compute number of sub-divisions based on local gradients 
 3897:             // XXX IS THIS NECESSARY?
 3898:             double suma = 0.0;
 3899:             int icount = 0;
 3900:             for (int ii=0; ii<2; ii++) {
 3901: 
 3902:                const Element *elem = side->elems[ii];
 3903:                  
 3904:                if (elem == nullptr) continue;
 3905: 
 3906:                icount++;
 3907: 
 3908:                // Not strictly along z; in ll frame for ics=2
 3909: 
 3910:                double utmp[4];
 3911:                double vtmp[4];
 3912:                for (int jj = 0; jj < elem->i34; jj++) {
 3913: 
 3914:                   const Node *node = elem->nodes[jj];
 3915: 
 3916:                   if constexpr(ics==1) {
 3917:                      utmp[jj] = node->u2[k].x;
 3918:                      vtmp[jj] = node->u2[k].y;  
 3919:                   } else {
 3920:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3921:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3922:                   }
 3923:                } // for jj
 3924: 
 3925:                const Vector2 grad_u = elem->grad2(utmp); 
 3926:                const Vector2 grad_v = elem->grad2(vtmp);
 3927: 
 3928:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3929:             } // for ii
 3930: 
 3931:             assert(icount > 0 && "Impossible 77");
 3932: 
 3933:             // '4' is somewhat arbitrary
 3934:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3935: 
 3936:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3937: 
 3938:             if (dtbk < 1e-5 || dt < 1e-5) {
 3939:                printf("^^^^^^^dtbk = %.17f, dt = %.17f, ndelt = %i\n", dtbk, dt, ndelt);
 3940: 
 3941:             }
 3942:          
 3943: 
 3944:             Vector3 u_int = {0.0, 0.0, 0.0};
 3945: 
 3946:             side->btrack(k, dt, dtbk, u_int);
 3947:             side->btu[k] = toVector2(u_int);
 3948:                
 3949:          } // if vmag (do backtrack)
 3950: 
 3951:       } // for k=kb,nvrt-1
 3952: 
 3953:    }
 3954: 
 3955: } // extern "C"
 3956: 
 3957: template<int nc>
 3958: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3959: 
 3960: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3961: //
 3962: // a,b,c,rhs: input vectors and are not modified by this program.
 3963: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3964: // rhs is the r.h.s.
 3965: // n: actual rank of the system.
 3966: // rows in u() and rhs();
 3967: // u: output with nc columns (transposed to rows)
 3968: // gam: a working array.
 3969: //
 3970: // NOTES:
 3971: // This is a template function that allows for different numbers of columns in the rhs vector.
 3972: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3973: 
 3974:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3975:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3976: 
 3977:    double bet = b[0];
 3978:    if constexpr (nc == 1) {
 3979:       u[0] = rhs[0]/bet;
 3980:    } else {
 3981:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3982:    }
 3983: 
 3984:    for (int j = 1; j < n; j++) {
 3985:       gam[j] = c[j - 1]/bet;
 3986:       bet = b[j] - a[j]*gam[j];
 3987: 
 3988:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3989: 
 3990:       if constexpr (nc == 1) {
 3991:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3992:       } else {
 3993:          for (int l = 0; l < nc; l++) {
 3994:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3995:          }
 3996:       }
 3997:    }
 3998: 
 3999:    // Back-substitution
 4000:    for (int j = n - 2; j >= 0; j--) {
 4001:       if constexpr (nc == 1) {
 4002:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4003:       } else {
 4004:          for (int l = 0; l < nc; l++) {
 4005:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4006:          }
 4007:       }
 4008:    }
 4009: }
 4010: 
 4011: 
 4012: 
 4013: // Helper function that contains the core algorithm
 4014: template<typename XAccessor, typename YAccessor>
 4015: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4016:                                     double  yp_top, double  yp_bot, 
 4017:                                     CubicSpline &spline) {
 4018:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4019:    // 
 4020:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4021:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4022:    //
 4023:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4024:    // 
 4025:    // Inputs: 
 4026:    //            n: dimension for x etc; # of data pts (>=2);
 4027:    //            getX, getY: functions to access x,y coordinates
 4028:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4029:    //     Output: 
 4030:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4031: 
 4032:    const int n = k2 - k1 + 1;
 4033:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4034: 
 4035:    // Allocate memory for the splines
 4036:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4037:    spline.x   = new double[n];
 4038:    spline.y   = new double[n];
 4039:    spline.yp  = new double[n];
 4040:    spline.ypp = new double[n];
 4041: 
 4042:    for (int k=k1; k<=k2; k++) {
 4043:       spline.x[k] = getX(k);
 4044:       spline.y[k] = getY(k);
 4045:    }
 4046: 
 4047:    // This is to simplify expressions later
 4048:    double *x = spline.x;
 4049:    double *y = spline.y;
 4050: 
 4051:    double *a = nullptr;
 4052:    double *b = nullptr;
 4053:    double *c = nullptr;
 4054:    double *gam = nullptr;
 4055:    double *rhs = nullptr;
 4056:    
 4057: 
 4058:       a = new double[n];   // Lower diagonal
 4059:       b = new double[n];   // Diagonal
 4060:       c = new double[n];   // Upper diagonal
 4061:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4062:       rhs = new double[n]; // Right-hand side
 4063: 
 4064:    for (int k=k1; k<=k2; k++) {
 4065:       if (k == k1) {
 4066:          // Bottom level
 4067:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4068:          b[k] = (x[k+1] - x[k])/3.0;
 4069:          c[k] = b[k]/2.0;
 4070:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4071:       } else if (k == n - 1) {
 4072:          // Top level (surface)
 4073:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4074:          b[k] = (x[k] - x[k-1])/3.0;
 4075:          a[k] = b[k]/2.0;
 4076:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4077:       } else {
 4078:          // Intermediate levels
 4079:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4080:          b[k] = (x[k+1] - x[k-1])/3.0;
 4081:          a[k] = (x[k  ] - x[k-1])/6.0;
 4082:          c[k] = (x[k+1] - x[k  ])/6.0;
 4083:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4084:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4085:       }
 4086:    }
 4087: 
 4088:    // Solve the tridiagonal system
 4089:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4090:    
 4091:    spline.yp[k1] = yp_bot;
 4092:    spline.yp[k2] = yp_top;
 4093: 
 4094:    // Compute rest of 1st derivatives using the splines
 4095:    for (int k=k1+1; k<k2; k++) {
 4096:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4097:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4098:    }
 4099:    
 4100:    delete[] a;
 4101:    delete[] b;
 4102:    delete[] c;
 4103:    delete[] gam;
 4104:    delete[] rhs;
 4105: 
 4106: }
 4107: 
 4108: // Array version
 4109: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4110:                                 double y_top, double y_bot, 
 4111:                                 CubicSpline &spline) {
 4112:    auto getX = [x] (int k) { return x[k]; };
 4113:    auto getY = [y] (int k) { return y[k]; };
 4114:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4115: }
 4116: 
 4117: // Lambda version - allows custom access patterns
 4118: template<typename XFunc, typename YFunc>
 4119: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4120:                                 double y_top, double y_bot,
 4121:                                 CubicSpline &spline) {
 4122:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4123: }
