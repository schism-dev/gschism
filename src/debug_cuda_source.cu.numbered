 1940: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 1941:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 1942: 
 1943:       if (isValid.none()) 
 1944:       // Inside the element
 1945:       {
 1946:          // Just returns true and the element (curElem) is unchanged).
 1947:          return true;
 1948:       }
 1949:       else { // Outside the element
 1950: 
 1951:          // Outside this element. Pick the first valid exit side and cross.
 1952:          lastCrossSide = curElem->sides[isValid.firstOne()];
 1953:          curElem = lastCrossSide->otherElem(curElem);
 1954: 
 1955:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 1956:          // along the boundary.
 1957:          if (curElem == nullptr || curElem->isDry) return false;
 1958:          
