 2998: __device__ double Element::intPhiPhiQuad(int i1, int i2) const {
 2999:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3000:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3001:    // The formula for the integral is:
 3002:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3003: 
 3004:    printf("intPhiPhi: TEST\n");
 3005: 
 3006:    const Node *n0 = nodes[0];
 3007:    const Node *n1 = nodes[1];
 3008:    const Node *n2 = nodes[2];
 3009:    const Node *n3 = nodes[3];
 3010: 
 3011:    const Vector2 p0 = n0->p;
 3012:    const Vector2 p1 = n1->p;
 3013:    const Vector2 p2 = n2->p;
 3014:    const Vector2 p3 = n3->p;
 3015: assert(false && "intPhiPhiQuad:CHECK?");
 3016: 
 3017:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 3018:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 3019:    double eta_sum  = iet_n[i1] + iet_n[i2];
 3020:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 3021: 
 3022:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 3023: }
 3024:    
 3025: 
 3026: __device__ double Element::intGradPhiGradPhiQuad(int i1, int i2) const {
 3027:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3028:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3029:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3030:    // The formula is also based on the identity:
 3031:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3032:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3033: 
 3034:    printf("intGradPhiGradPhi: TEST\n");   
 3035: assert(false && "intGradPhiGradPhi:Do ICS==2");
 3036:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 3037: 
 3038:    const double x0 = nodes[0]->p.x;
 3039:    const double y0 = nodes[0]->p.y;
 3040:    const double x1 = nodes[1]->p.x;
 3041:    const double y1 = nodes[1]->p.y;
 3042:    const double x2 = nodes[2]->p.x;
 3043:    const double y2 = nodes[2]->p.y;
 3044:    const double x3 = nodes[3]->p.x;
 3045:    const double y3 = nodes[3]->p.y;
 3046: 
 3047:    double res = 0.0;
 3048:    
 3049:    // Quadrature points in xi and eta coordinates
 3050:    #pragma unroll
 3051:    for (int i = 0; i < 4; i++) {
 3052:       // For each quadrature point...
 3053: 
 3054:       const Point2 p = GaussPoint(i);
 3055:       const double eta = p.x;
 3056:       const double xi  = p.y;
 3057: 
 3058:       // Jacobian entries at the Gauss point p
 3059:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 3060:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 3061:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 3062:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 3063: 
 3064:       const double detJ = jacobianDet(p);
 3065:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3066: 
 3067:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3068:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3069:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3070:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3071:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3072: 
 3073:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3074:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3075:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3076:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3077:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3078: 
 3079:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3080:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3081:    }
 3082: 
 3083:    return res;
 3084: }
 3085: 
 3086: 
 3087: /**  Interpolate velocities at a given point (xt,yt,zt)
 3088: 
 3089:    @param xt, yt, zt: coordinates of the point to interpolate
 3090:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3091: 
 3092:    This is done in four steps:
 3093: 
 3094:    1. Find the shape coordinates for the final position in the element.
 3095:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3096:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3097:       z levels at xt, yt at each step.   
 3098:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3099:       horizontally and vertically.
 3100: **/
 3101: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3102:    // Interpolate the velocities at the point xt. 
 3103:    // This function works the same for triangular and quadrilateral elements.
 3104:    double shpCoord[4];
 3105:    Vector3 u_int;
 3106: 
 3107: 
 3108:    // First step is to compute the shape coordinates of (xt,yt)
 3109: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3110:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3111: 
 3112:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3113: 
 3114:    // Second step is to find the level that contains zt
 3115:    // Uses a binary search to find the level
 3116:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3117:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3118:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3119:    int R = nvrt - 1;
 3120: 
 3121:    // Get the z coordinates at the nodes of the element at the levels L and R
 3122:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3123:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3124:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3125: 
 3126: 
 3127:    double zL = interpolate(shpCoord, zLAtNodes);
 3128:    double zR = interpolate(shpCoord, zRAtNodes);
 3129: 
 3130:    // Interpolates vertically the velocities
 3131:    double wght1, wght2;
 3132:    if (xt.z <= zL) {
 3133:       wght1 = 1.0;
 3134:       wght2 = 0.0;
 3135:       xt.z = zL;
 3136:    }
 3137:    else if (xt.z >= zR) {
 3138:       wght1 = 0.0;
 3139:       wght2 = 1.0;
 3140:       xt.z = zR;
 3141:    }
 3142:    else {
 3143:       // Perform a binary search to find the levels between L and R that contain xt.z
 3144:       while (R - L > 1) {
 3145:          int M = (L + R) / 2.0;
 3146: 
 3147:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3148:          double zM = interpolate(shpCoord, zMAtNodes);
 3149:          if (zM < xt.z) 
 3150:          {
 3151:             L = M;
 3152:             zL = zM;
 3153:          }
 3154:          else 
 3155:          {
 3156:             R = M;
 3157:             zR = zM;
 3158:          }
 3159:       }
 3160:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3161:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3162: 
 3163:       wght2 = (xt.z - zL)/(zR - zL);
 3164:       wght1 = 1.0 - wght2;
 3165: 
 3166:    }
 3167: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3168: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3169:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3170:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3171:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3172:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3173: 
 3174:    // Project the velocity from the local frame to the origSide frame
 3175:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3176:    u_int = {uv.x, uv.y, w};
 3177: 
 3178:    // Neither of the interpolated velocities should be NaN
 3179:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3180: 
 3181:    return u_int;
 3182: 
 3183: }
 3184: 
