 2001: 
 2002: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2003:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 2004: 
 2005:    // printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 2006: 
 2007:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2008:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 2009:    // curElement.
 2010: 
 2011:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2012:    // And uses this velocity instead to continue the tracking.
 2013: 
 2014:    // computes the intersection point in cartesian coordinates
 2015:    Point2 intersection = nextSide->p_t(tt);
 2016: 
 2017:    // Nudges the point to the barycenter of the element. 
 2018:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2019:    // next segment intersects the element sides. 
 2020:    curElem->nudgeToBarycenter(intersection);
 2021: 
 2022:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2023:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2024:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2025:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2026: 
 2027:    // If the side is an open boundary, the tangential velocity is set to zero.
 2028:    if (nextSide->isBnd()) vtan = 0.0;
 2029: 
 2030:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2031:    const double us = vtan*nextSide->t().x;
 2032:    const double vs = vtan*nextSide->t().y;
 2033:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);  //  XXXX Why not use the side's velocity?
 2034: 
 2035:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2036:    const double len2 = norm2(intersection - toPoint2(xt));
 2037:    const double vel2 = dot(u_int, u_int);        
 2038:    if (vel2 > 0.0) dt = min(dt, sqrt(len2/vel2)); 
 2039:    else            dt = 0.0;
 2040: // if (dt < 0.0) dt = 0.0; //XXXXXXXXXXXXX    KKKKKK
 2041: // printf("@@@@@@@XXXX@@@@@@@@@ tt = %.17g, dt = %.17g, len = %.17g, vel = %.17g\n", tt, dt, sqrt(len2), sqrt(vel2));
 2042: 
 2043:    // The end of this tracking segment is now the intersection point.
 2044:    xt = {intersection.x, intersection.y, zint};
 2045: 
 2046:    u_int = {us, vs, ws};
 2047: // printf("@@@@@@@XXXX@@@@@@@@@ idx = %d, us = %.17g, vs = %.17g, ws = %.17g, dt = %.17g\n", curElem->idx, us, vs, ws, dt);   
 2048:    
 2049: }
 2050: 
 2051: /**
 2052:  * Tracks a particle through elements and vertical levels in the mesh.
 2053:  * 
 2054:  * @param x0,y0,z0     Starting position coordinates
 2055:  * @param xt,yt,zt     Target position coordinates
 2056:  * @param dtb          Time step for tracking
 2057:  * @param uuint,vvint,wwint Initial velocity components
 2058:  * @param nextElem     Starting/resulting element index
 2059:  * 
 2060:  * @return Status code of type trackExitCodes
 2061:  * 
 2062:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2063:  * of the details are different. The idea is that the code requires less branches and is better fit
 2064:  * for GPU execution.
 2065:  * 
 2066:  * The main ideas here are:
 2067:  * - The starting point is expected to be in the starting element.
 2068:  * - The end point is guaranteed to be inside an element.
 2069:  * - since the starting point is inside the element, there are only two cases: 
 2070:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2071:  *     (b) it does not and (xt,yt) is already in the starting element.
 2072:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2073:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2074:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2075:  * - tt1 can be positive or negative. We only consider the positive values.
 2076:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2077:  * - The next intersection will occur at the smallest positive tt1.
 2078:  * - This intersection will be the next (x0,y0) position.
 2079:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2080:  *   of getting stuck in a loop.
 2081:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2082:  *   was found.
 2083:  */
 2084: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2085:                                                        Element *&nextElem, int &jlev, double &dt,
 2086:                                                        const Side *origSide) {
 2087: 
 2088: 
 2089: 
 2090:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2091:    // else to do.
 2092:    // If it is, nudges the point to be inside the element.
 2093:    const Element *curElem = nextElem;
 2094:    if (containsPoint(toPoint2(xt), true)) {
 2095: 
 2096:       // assert(!curElem->isDry && "Target point is inside a dry element");
 2097:       curElem->interpolateVelocities(xt, u_int);
 2098: 
 2099: addDebugPlot(x0, xt, 0xA00050);
 2100:       return true;
 2101:    }
 2102: 
 2103: if (curElem->isDry) { u_int = {0.0, 0.0, 0.0}; return true;} //XXXXXXXXXXXXX    KKKKKK
 2104:    Side *side = nullptr;
 2105: 
 2106:    // 1. Initial checks
 2107:    // Verify starting element is valid (wet)
 2108:    assert(!curElem->isDry && "Starting element is dry");
 2109: 
 2110:    // Checks if track has a zero length.
 2111:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2112:    // assert(len2 > 0.0 && "Zero length track"); 
 2113:    
 2114:    const int MAX_ITERATIONS = 1000;
 2115:    
 2116:    double t;
 2117:    Side *nextSide = nullptr;
 2118:    double tIntersect = 1e10;
 2119:    double zint = x0.z;
 2120: 
 2121:    // Horizontal tracking loop
 2122:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2123:    // (x0,y0) is inside the element but the target point is not.
 2124: 
 2125:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2126: 
 2127:    assert(found_intersection && "No intersection found at %d");
 2128: 
 2129:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2130: 
 2131:    // if the tracking segment goes out of water (either dry or edge boundary)
 2132:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2133: 
 2134: addDebugPlot(x0, xt, 0x00A0FF);
 2135:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2136: addDebugPlot(x0, xt, 0x00A0FF);      
 2137: 
 2138:       nextElem = this;
 2139:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2140:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2141:       return true;    
 2142:    }
 2143: 
 2144: 
 2145:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2146:    int iterations = 0;
 2147:    while (iterations < MAX_ITERATIONS) {
 2148:       iterations++;
 2149:       
 2150:       Element *curElem = nextElem;
 2151: 
 2152:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2153: addDebugPlot(x0, xt);
 2154:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2155: 
 2156:       // If we are already in the target element, we are done.
 2157:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2158:       if (!found_intersection) break;
 2159: 
 2160: 
 2161: 
 2162:       // if the tracking segment goes out of water (either dry or edge boundary).
 2163:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2164: addDebugPlot(x0, xt, 0x00A0FF);
 2165:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2166: addDebugPlot(x0, xt, 0x00A0FF);   
 2167:          nextElem = curElem;
 2168: 
 2169:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2170:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2171:          return true;
 2172:       }
 2173:       
 2174:       // Update position and element for next iteration
 2175:       side = nextSide;
 2176: 
 2177:    }
 2178: 
 2179:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2180: 
 2181:  
 2182:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2183:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2184: addDebugPlot(x0, xt, 0xA0A0A0);   
 2185:    nextElem->interpolateVelocities(xt, u_int); 
 2186: 
 2187:    return true;
 2188: }
 2189: 
 2190: 
 2191: __inline__ __device__ double Element::computeSignedArea(void) const {
 2192:    // Compute the area of the element
 2193: 
 2194:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2195: 
 2196:    // In the quad case we need to add the area of the other triangle.
 2197:    if (isQuad()) {
 2198:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2199:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2200:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2201:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2202: 
 2203:       res += ar1;
 2204:    }
 2205: 
 2206:    return res;
 2207: }
 2208: 
 2209: 
 2210: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2211:                                                                 (nodes[1]->isDry2()) ||
 2212:                                                                 (nodes[2]->isDry2()) ||
 2213:                                                                 (i34==4 && nodes[3]->isDry2());
 2214: }
 2215: 
 2216: __inline__ __device__ double Element::detJ_eta(void) const {
 2217:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2218:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2219: }
 2220: 
 2221: __inline__ __device__ double Element::detJ_xi(void) const {
 2222:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2223:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2224: }
 2225: 
 2226: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2227:    // In boundary sides, the element 1 is nullptr
 2228:    return side->elems[1] == nullptr; 
 2229: }
 2230: 
 2231: 
 2232: 
 2233: /**
 2234:    Compute the shape coordinates of the point (xt,yt) in the element.
 2235:    @param xt (input): x-coordinate of the point
 2236:    @param shpCoords (output): shape coordinates of the point
 2237:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2238:    @return true if the point is inside the element, false otherwise
 2239: **/
 2240: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2241:                                             bool fixNegshpCoord) const {
 2242: 
 2243:    // Compute the shape coordinates of the point xt in the element.
 2244:    if (i34==3) {
 2245:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2246:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2247:       // and in this case, the pt will be nudged into the element
 2248:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2249:       // from the local frame, so use additional check.
 2250: 
 2251:       Point2 x0, x1, x2;
 2252: 
 2253:       if constexpr(ics==1) {
 2254:          x0 = nodes[0]->p;
 2255:          x1 = nodes[1]->p;
 2256:          x2 = nodes[2]->p;
 2257:       }
 2258:       else // lat/lon
 2259:       {
 2260:          Error("Not implemented yet");
 2261:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2262:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2263:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2264:       }
 2265: 
 2266:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2267:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2268:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2269:       shpCoords[3] = 0.0;
 2270:       const double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2271: 
 2272:       // Check if the point is inside the element.
 2273:       const bool res = tmpmin > -small;  
 2274:      
 2275: 
 2276:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2277:       // then we fix the negative shape coordinates.
 2278:       if ((tmpmin < 0.0) && fixNegshpCoord) {
 2279: 
 2280:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2281:          // keeping the sum of the shape coordinates equal to 1.
 2282:          // I have tested and compared the new algorithm with the old one, and they give
 2283:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2284:          // The new algorithm should be faster since it is branchless.
 2285:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2286:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2287:          
 2288:          shpCoords[0] = (shpCoords[0] + a)*b;
 2289:          shpCoords[1] = (shpCoords[1] + a)*b;
 2290:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2291: 
 2292:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2293:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2294:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2295:          }
 2296: 
 2297:          // Update the point coordinates for the new shape coordinates
 2298:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2299:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2300:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2301: 
 2302:       }
 2303: 
 2304:       // Check if the point is inside the element
 2305:       return res;      
 2306:    }
 2307:    else {
 2308:       Error("Not implemented yet");
 2309: #ifdef QUADS
 2310:       // Reproject pt in eframe of nel for ics=2
 2311:       if constexpr(ics==1) {
 2312:          xn2 = xt; 
 2313:          yn2 = yt;
 2314:       }
 2315:       else {
 2316:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2317:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2318:       }
 2319: 
 2320:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2321: #endif
 2322:    }
 2323: 
 2324:    return false;  // Never reached
 2325: 
 2326: }
 2327: 
 2328: 
 2329: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2330: // Convert shape coordinates to cartesian coordinates
 2331: 
 2332:    if (i34 == 3) {
 2333:       // Triangular element
 2334:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2335:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2336:    }
 2337:    else {
 2338:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2339:    }
 2340: 
 2341: }
 2342: 
 2343: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2344:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2345:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2346:    // The formula for the integral is:
 2347:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2348: 
 2349:    printf("intPhiPhi: TEST\n");
 2350: 
 2351:    const Node *n0 = nodes[0];
 2352:    const Node *n1 = nodes[1];
 2353:    const Node *n2 = nodes[2];
 2354:    const Node *n3 = nodes[3];
 2355: 
 2356:    const Vector2 p0 = n0->p;
 2357:    const Vector2 p1 = n1->p;
 2358:    const Vector2 p2 = n2->p;
 2359:    const Vector2 p3 = n3->p;
 2360: 
 2361:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2362:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2363:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2364:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2365: 
 2366:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2367: }
 2368:    
 2369: 
 2370: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2371:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2372:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2373:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2374:    // The formula is also based on the identity:
 2375:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2376:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2377: 
 2378:    printf("intGradPhiGradPhi: TEST\n");   
 2379: 
 2380:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2381: 
 2382:    const double x0 = nodes[0]->p.x;
 2383:    const double y0 = nodes[0]->p.y;
 2384:    const double x1 = nodes[1]->p.x;
 2385:    const double y1 = nodes[1]->p.y;
 2386:    const double x2 = nodes[2]->p.x;
 2387:    const double y2 = nodes[2]->p.y;
 2388:    const double x3 = nodes[3]->p.x;
 2389:    const double y3 = nodes[3]->p.y;
 2390: 
 2391:    double res = 0.0;
 2392:    
 2393:    // Quadrature points in xi and eta coordinates
 2394:    #pragma unroll
 2395:    for (int i = 0; i < 4; i++) {
 2396:       // For each quadrature point...
 2397: 
 2398:       const Point2 p = GaussPoint(i);
 2399:       const double eta = p.x;
 2400:       const double xi  = p.y;
 2401: 
 2402:       // Jacobian entries at the Gauss point p
 2403:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2404:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2405:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2406:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2407: 
 2408:       const double detJ = jacobianDet(p);
 2409:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2410: 
 2411:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2412:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2413:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2414:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2415:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2416: 
 2417:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2418:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2419:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2420:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2421:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2422: 
 2423:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2424:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2425:    }
 2426: 
 2427:    return res;
 2428: }
 2429: 
 2430: 
 2431: /**  Interpolate velocities at a given point (xt,yt,zt)
 2432: 
 2433:    @param xt, yt, zt: coordinates of the point to interpolate
 2434:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2435: 
 2436:    This is done in four steps:
 2437: 
 2438:    1. Find the shape coordinates for the final position in the element.
 2439:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2440:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2441:       z levels at xt, yt at each step.   
 2442:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2443:       horizontally and vertically.
 2444: **/
 2445: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2446:    // Interpolate the velocities at the point xt. 
 2447:    // This function works the same for triangular and quadrilateral elements.
 2448:    double shpCoord[4];
 2449: 
 2450:    // First step is to compute the shape coordinates of (xt,yt)
 2451:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2452:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2453: 
 2454:    // Second step is to find the level that contains zt
 2455:    // Uses a binary search to find the level
 2456:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2457:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2458:    int R = nvrt - 1;
 2459: 
 2460:    // Get the z coordinates at the nodes of the element at the levels L and R
 2461:    double zLAtNodes[4], zRAtNodes[4];
 2462:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2463:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2464: 
 2465:    double zL = interpolate(shpCoord, zLAtNodes);
 2466:    double zR = interpolate(shpCoord, zRAtNodes);
 2467:    
 2468:    // Interpolates vertically the velocities
 2469:    double wght1, wght2;
 2470:    if (xt.z<=zL) {
 2471:       wght1 = 1.0;
 2472:       wght2 = 0.0;
 2473:    }
 2474:    else if (xt.z>=zR) {
 2475:       wght1 = 0.0;
 2476:       wght2 = 1.0;
 2477:    }
 2478:    else {
 2479:       // Perform a binary search to find the levels between L and R that contain xt.z
 2480:       while (R - L > 1) {
 2481:          int M = (L + R) / 2;
 2482: 
 2483:          double zMAtNodes[4];
 2484:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2485:          double zM = interpolate(shpCoord, zMAtNodes);
 2486:          if (zM < xt.z) 
 2487:          {
 2488:             L = M;
 2489:             zL = zM;
 2490:          }
 2491:          else 
 2492:          {
 2493:             R = M;
 2494:             zR = zM;
 2495:          }
 2496:       }
 2497:       assert(L == R-1);
 2498:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2499: 
 2500:       wght2 = (xt.z - zL)/(zR - zL);
 2501:       wght1 = 1.0 - wght2;
 2502:    }
 2503: 
 2504:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2505:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2506: 
 2507:    // Neither of the interpolated velocities should be NaN
 2508:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2509: 
 2510: }
 2511: 
 2512: 
 2513: 
 2514: 
 2515: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2516: 
 2517:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2518:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2519:    const Node *n1 = side->n1;
 2520:    const Node *n2 = side->n2;
 2521: 
 2522:    bool n1_match = (n1->nodeBnd->segment == segment);
 2523:    bool n2_match = (n2->nodeBnd->segment == segment);
 2524: 
 2525:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2526:    if (n1_match && n2_match) {
 2527:       return 0.5;
 2528:    } else if (n1_match) {
 2529:       return 1.0;
 2530:    } else if (n2_match) {
 2531:       return 0.0;
 2532:    }
 2533: 
 2534:    return 0.0;
 2535: }
 2536: 
 2537: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2538: 
 2539: 
 2540: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2541: 
 2542:    const double w1 = getBoundaryArrayValueWeight();
 2543:    const double w2 = 1.0 - w1;
 2544:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2545:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2546: 
 2547:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2548: }
