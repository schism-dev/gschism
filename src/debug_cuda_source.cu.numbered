 9042: __global__ void getStructSizes(int* sizes)  {
 9043:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 9044:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 9045:       sizes[0] = (int)sizeof(Node);
 9046:       sizes[1] = (int)sizeof(Element);
 9047:       sizes[2] = (int)sizeof(Side);
 9048:       sizes[3] = (int)sizeof(NodeBoundary);
 9049:       sizes[4] = (int)sizeof(SideBoundary);
 9050:       sizes[5] = (int)sizeof(BoundarySegment);
 9051: }
