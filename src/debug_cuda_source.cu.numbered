  505: 
  506: struct Frame {
  507:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  508:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  509:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  510:     double t00, t10;        // col0 (t20=0 implicit)
  511:     double t01, t11, t21;   // col1
  512: 
  513:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  514: 
  515:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  516:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  517: 
  518:       double sin_lon, cos_lon, sin_lat, cos_lat;
  519:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  520:       sincos(lat, &sin_lat, &cos_lat);
  521: 
  522:       t00 = -sin_lon;
  523:       t10 =  cos_lon;
  524:       t01 = -cos_lon*sin_lat;
  525:       t11 = -sin_lon*sin_lat;
  526:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  527: // printf("lat = %f, lon = %f, cos_lat = %f, sin_lat = %f, cos_lon = %f, sin_lon = %f\n", lat, lon, cos_lat, sin_lat, cos_lon, sin_lon);
  528: // printf("t00 = %f, t10 = %f, t01 = %f, t11 = %f, t21 = %f\n", t00, t10, t01, t11, t21);
  529: 
  530:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  531:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  532: 
  533:       const double col1_norm_inv = 1.0/col1_norm;
  534:       t01 = t01*col1_norm_inv;
  535:       t11 = t11*col1_norm_inv;
  536:       t21 = t21*col1_norm_inv;
  537: 
  538:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  539: 
  540: 
  541:    }
  542: 
  543:    __forceinline__ __device__ void print(void) const {
  544:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  545:    }
  546: 
  547:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  548:       // cross(col0, col1), with t20=0 implicitly:
  549:       // |  i       j       k   |
  550:       // | t00     t10      0   |
  551:       // | t01     t11     t21  |
  552:       t02 =  t10*t21;
  553:       t12 = -t00*t21;
  554:       t22 =  t00*t11 - t10*t01;
  555:    }
  556: 
  557: 
  558:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  559:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  560:    // Inputs:
  561:    //        vec0: vel. in this frame;
  562:    //        frameout: Output frame;
  563:    // Output: 
  564:    //        vel. in new frame  
  565:    //
  566:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  567:    // discarding the z-component of the result to keep only the local horizontal
  568:    // plane of frame 2.
  569:    //
  570:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  571:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  572:    // are orthogonal. This product is computed as dot products between columns of
  573:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  574:    // columns of F2.// 
  575: 
  576:       auto const fo = frameout; // Just an alias for the output frame.
  577:       Vector2 res;
  578: 
  579:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  580:       // of t and fo.t are the same.
  581:       const double d00 = t00*fo.t00 + t10*fo.t10;
  582:       const double d10 = t01*fo.t00 + t11*fo.t10;
  583: 
  584:       const double d01 = t00*fo.t01 + t10*fo.t11;
  585:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  586: 
  587:       res.x = vec0.x * d00 + vec0.y * d10;
  588:       res.y = vec0.x * d01 + vec0.y * d11;
  589: 
  590:       return res;
  591:    }
  592: 
  593:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  594:       Vector3 vo;
  595:       double t02, t12, t22;
  596: 
  597:       // Compute the 3rd column of the frame tensor
  598:       getCol2(t02, t12, t22);
  599: 
  600:       vo.x = vi.x*t00 + vi.y*t10;
  601:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  602:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  603: 
  604:       return vo;
  605:    
  606:    }
  607: 
  608:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  609:       Vector3 vo;
  610:       double t02, t12, t22;
  611: 
  612:    // Compute the 3rd column of the frame tensor
  613:       getCol2(t02, t12, t22);
  614: 
  615:       // F * vi (non-transposed, so we use rows of F)
  616:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  617:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  618:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  619: 
  620:       return vo;
  621:    }
  622: 
  623:    // Unit vectors that define the local frame
  624:    __forceinline__ __device__ Vector3 nUp(void) const {
  625:       // Column 2 = cross(column0, column1)
  626:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  627:    }
  628: 
  629:    __forceinline__ __device__ Vector3 nZonal(void) const {
  630:       // Column 0
  631:       return { t00, t10, 0.0 };
  632:    }
  633: 
  634:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  635:       // Column 1
  636:       return { t01, t11, t21 };
  637:    }
  638: 
  639: };
