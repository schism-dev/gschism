 1572: __device__ __inline__ double min3(double a, double b, double c) {
 1573:    return min(a, min(b, c));
 1574: }
 1575: 
 1576: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1577:    return min(a, min(b, min(c, d)));
 1578: }
