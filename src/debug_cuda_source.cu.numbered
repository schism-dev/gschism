 4208:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4209: 
 4210:       SIDE(side);
 4211: 
 4212: 
 4213:       side->U = {0.0, 0.0}; 
 4214:          
 4215:       if(side->isDry) return;
 4216: 
 4217:       const Node *node1 = side->n1;
 4218:       const Node *node2 = side->n2;
 4219: 
 4220:       // Vertically integrated velocity U (in ll if ics=2)
 4221:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4222:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4223:       }
 4224: 
 4225:    }
 4226: 
 4227:    __global__ void computeBottomDragVegetation(void) {
 4228:       // UNFINISHED. CHECK THIS:
 4229:       // How many kernels are needed? Why so many for loops?
 4230:       // Is the loop on sides needed?
 4231: 
 4232:       NODE(node);
 4233: 
 4234:       const int    kb      = node->kb;
 4235:       const double htot    = node->htot2();
 4236:       const double rough   = node->rough;
 4237: 
 4238: 
 4239:       if (node->isDry) {
 4240:          // Default values for dry nodes
 4241:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4242:          /// XXX CHECK INDICES
 4243:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4244:       }
 4245: 
 4246:       // Compute bottom drag Cd
 4247:       //--------------------------------
 4248: 
 4249:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4250:       if (nchi==1) {
 4251: 
 4252:          bool ltmp = false; // for WBL iteration
 4253: 
 4254:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4255:          // Drag at nodes
 4256:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4257:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4258:         
 4259:          const double rough = node->rough;
 4260:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4261:          if (node->rough == 0.0) {
 4262:             node->Cd = 0.0;
 4263: 
 4264:          } else { //roughness >0 
 4265:             
 4266:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4267:             const double bthick = max(dzb_min, bthick_ori);
 4268: 
 4269:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4270: 
 4271:             double tmp = 1.0/(2.5*log(bthick/rough));
 4272:             node->Cd = tmp*tmp;
 4273: 
 4274:          } // if rough
 4275: 
 4276: 
 4277:          // RECOVER THIS: XXX
 4278:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4279:          // Output warning for WBL if iteration didn't converge
 4280: 
 4281: 
 4282:       } // nchi==1
 4283: 
 4284:       //   Bottom stress in m^2/s^2
 4285:       if (node->rho[kb + 1] >= -98.0)
 4286:       {
 4287:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4288:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4289:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4290:          // !sediment erosion: this part needs more documentation
 4291:       }
 4292: 
 4293:     
 4294:       // Compute vegetation parameters
 4295:       //--------------------------------
 4296: 
 4297:       // SAV constants
 4298:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4299:       constexpr double veg_cfpsi = 0.16;
 4300: 
 4301:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4302:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4303: 
 4304:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4305:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4306:          int kbin = 0; // bin index
 4307:          for (int k = kb; k < nvrt; k++) {
 4308:             // Computes node height above the bottom level
 4309:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4310:             assert(false && "Vertical variation of vegetation not implemented");
 4311: 
 4312:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4313:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4314:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4315:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4316:             // } else {
 4317:             //    // Find the bin at which the current vertical level is
 4318:             //    while (kbin<nbins_veg_vert) {
 4319:             //       const double zn = node->z[kbin];
 4320:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4321:             //          break;
 4322:             //       } // if
 4323:             //       kbin++;
 4324:             //    } // while
 4325:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4326: 
 4327:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4328:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4329:                
 4330:             //    // Linear interpolation of the vegetation parameters
 4331:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4332:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4333:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4334:             // } // if rl10
 4335: 
 4336:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4337: 
 4338:          } // for k
 4339: 
 4340: 
 4341:       } else { // Ganthy (iveg=2)
 4342:       //  Modify canopy height, diameter, and density
 4343: 
 4344:          // Make sure there is vegetation on this node
 4345:          if (node->veg_h_unbent > 0.0) {
 4346:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4347: 
 4348:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4349:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4350:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4351: 
 4352:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4353:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4354:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4355:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4356:          } // if veg_h_unbent
 4357: 
 4358:          for (int k = 0; k < nvrt; k++) {
 4359:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4360:          } // for k
 4361:       
 4362: 
 4363:       } // if iveg
 4364:      
 4365:          
 4366: 
 4367:       // Compute vertical mean of veg_alpha3D
 4368:       if (iveg != 0) {
 4369:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4370:          double sum1=0.0;
 4371:          double sum2=0.0;
 4372:          // Integrate over each level under the canopy...
 4373:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4374:             const double Dz = node->Dz(k);
 4375: 
 4376:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4377:             sum2 += Dz;
 4378: 
 4379:          } // for k
 4380: 
 4381:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4382:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4383: 
 4384:       } // if iveg
 4385: 
 4386:    }
 4387: 
 4388:    __global__ void computeVegetationAndDragParameters(void) {
 4389:       // Computes the vegetation and drag model parameters:
 4390:       // chi, \tilde\chi, beta, \breve{H}
 4391:       
 4392:       SIDE(side);
 4393: 
 4394:       const double htot = side->htot2();
 4395:       const int    kb   = side->kb;
 4396: 
 4397:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4398: 
 4399:       const double veg_h     = side->veg_h();
 4400:       const double veg_nv    = side->veg_nv();
 4401:       const double veg_c     = side->veg_c();
 4402:       const double veg_beta  = side->veg_beta;
 4403:       const double veg_alpha = side->veg_alpha_vert_mean();
 4404: 
 4405:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4406:       // Velocity magnitude at the bottom level
 4407:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4408:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4409:       side->chi2 = side->Cd()*vmag1;
 4410:       side->chi  = side->chi2;
 4411:       if constexpr(iveg != 0) {
 4412:          const Node *n1 = side->n1;
 4413:          const Node *n2 = side->n2;
 4414:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4415:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4416:       }
 4417: 
 4418:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4419: 
 4420:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4421:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4422:       double magUa = 0.0;
 4423:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4424:          // 3D wet side with veg...
 4425: 
 4426:          double magUa = 0.0;
 4427:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4428:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4429: 
 4430:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4431:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4432:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4433: 
 4434:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4435:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4436: 
 4437:                // Velocity magnitude at the bottom (l) of the level
 4438:                const double ul = length(side->u2[k]);
 4439: 
 4440:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4441:                magUa += Dz*0.5*(uh + ul);
 4442: 
 4443:             } // if HasVegetation
 4444:          } // for k
 4445:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4446: 
 4447:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4448:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4449:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4450:             const double zCpy = side->zTopCanopy();
 4451:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4452:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4453:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4454:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4455:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4456:          } // if isSubmerged
 4457:       } // if iveg   
 4458: 
 4459:       // Computes the friction modified depth, \breve{H} in notes
 4460:       if (side->is2D()) { // 2D
 4461: 
 4462:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4463:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4464: 
 4465:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4466: 
 4467:          side->hhat = htot*htot/fricH; 
 4468: 
 4469:       } else { // 3D
 4470:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4471: 
 4472:          if constexpr(iveg != 0) {
 4473:             
 4474:             if (side->isSubmerged()) { 
 4475:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4476:                side->hhat -= veg_c*Hhat_alpha;
 4477: 
 4478:             } else { // Emergent
 4479:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4480:             }
 4481:          } // if iveg
 4482: 
 4483:          // Enforce positivity for 3D model
 4484:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4485:       } // if 3D
 4486: 
 4487:    }
 4488: 
 4489: 
 4490: 
 4491:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4492:    // Computes the density gradient between two elements, e1 and e2.
 4493:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4494:    // zero in the direction normal to the side. 
 4495:    // 
 4496:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4497:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4498:    //
 4499:    // Input:
 4500:    //    e1: Element
 4501:    //    e2: Neighbor element (or nullptr if boundary)
 4502:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4503:    //    k: Index of the half-level at which the density is interpolated
 4504:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4505:    // 
 4506:    // Output:
 4507:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4508:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4509: 
 4510:       if (e2 == nullptr || e2->isDry) {
 4511:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4512: 
 4513:          Side *side = e1->sides[j];
 4514:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4515:                  
 4516:          if constexpr(ics == 1) {
 4517:             vec = side->n; // Normal vector to the side
 4518:          } else {
 4519:             // IMPLEMENT THIS XXXXXX
 4520:             // !replace with xel, yel?
 4521:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4522:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4523:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4524:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4525:          } //ics
 4526:                    
 4527:          diffRho = 0.0;
 4528: 
 4529:       } else { //internal and wet
 4530:          if constexpr(ics==1) {
 4531:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4532: 
 4533:             // Vector from e1 to e2
 4534:             vec = toVector2(e2->center - e1->center);
 4535: 
 4536:          } else { 
 4537:             // IMPLEMENT THIS XXXXXX
 4538:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4539:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4540:             //                   alow(j)=xctr2
 4541:             //                   bdia(j)=yctr2
 4542:          } // ics
 4543: 
 4544:          diffRho = rho2 - e1->demeanedDensity(k);
 4545:       }
 4546: 
 4547:    }
 4548: 
 4549:    __global__ void computeDensityCubicSplines(void) {
 4550:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4551: 
 4552:       ELEM(elem);
 4553: 
 4554:       if (elem->isDry) return;
 4555: 
 4556:       const int kb = elem->kb;
 4557: 
 4558:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4559:       if (elem->is2D()) {
 4560:          // In the 2D case, the density is constant at the prism level. 
 4561:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4562:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4563:       } else { //3D
 4564: 
 4565:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4566:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4567:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4568:          ///// XXXX CHECK INDICES!!!!!
 4569:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4570:       } // 2D/3D
 4571: 
 4572:    }
 4573: } // extern "C"
 4574: 
 4575: 
 4576: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4577: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4578: 
 4579:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4580: 
 4581:    const int kb  = elem->kb;
 4582:    const int kb2 = elem2->kb;
 4583: 
 4584:    // z-coordinate of prism of elem
 4585:    const double zp = elem->z_prism(k);
 4586: 
 4587:    double rho = 0.0;
 4588: 
 4589:    if (elem2->is2D()) {
 4590:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4591: 
 4592:    } else {  // 3D
 4593: 
 4594:       // eta_min may be < zmax
 4595:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4596:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4597: 
 4598:       // (Extrapolate density below bottom, we will fix it later)
 4599:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4600:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4601:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4602:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4603:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4604:    } // 2D/3D
 4605:      
 4606: 
 4607:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4608:    // Now we need to fix it.
 4609:    if (elem->z[k] < elem2->z[kb2]) {
 4610:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4611: 
 4612:       // There are two methods to adjust the density at the bottom of the element.
 4613:       // iunder_deep=0: 
 4614:       const double depth1 = abs(elem->z[kb]); // larger depth
 4615: 
 4616:       if (iunder_deep==0) {
 4617: 
 4618:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4619: 
 4620:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4621: 
 4622:       } else { // iunder_deep != 0
 4623: 
 4624:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4625: 
 4626:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4627: 
 4628:          //   Demeaned density at the same z coordinate as
 4629:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4630:          }
 4631: 
 4632:       } // if iunder_deep
 4633:    } // if elem->z[kb] < elem2->z[kb]
 4634: 
 4635:    return rho;
 4636: }
 4637: 
 4638: 
 4639: extern "C" {
 4640:    __global__ void computeDensityGradient(void) {
 4641: 
 4642:          // Compute the horizontal density gradient at each element.
 4643:       // It works in two steps:
 4644:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4645:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4646:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4647:       //             gradRho.r1 = rho1 - rho0
 4648:       //             gradRho.r2 = rho2 - rho0
 4649:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4650:       // 
 4651:       //  NOTE: We use de-meaned densities.
 4652: 
 4653:       ELEM(elem);
 4654: 
 4655:       if (elem->isDry) return;
 4656: 
 4657:       const int kb  = elem->kb;
 4658:       const int i34 = elem->i34;
 4659: 
 4660:       for (int k = kb + 1; k < nvrt; k++) {
 4661:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4662:          //             gradRho.r1 = rho1 - rho0
 4663:          //             gradRho.r2 = rho2 - rho0
 4664:          int icount = 0;
 4665:          double sumRx = 0.0;
 4666:          double sumRy = 0.0;
 4667:          for (int j1=0; j1<i34; j1++) { 
 4668: 
 4669:             const int j2 = elem->nxq(j1 + 1);
 4670: 
 4671:             // Pairs of consecutive neighbor elements of elem
 4672:             const Element *e1 = elem->nghbElems[j1];
 4673:             const Element *e2 = elem->nghbElems[j2];
 4674: 
 4675:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4676:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4677:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4678: 
 4679:             // Compute the density difference and the vector from elem to e1 and e2
 4680:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4681:             double diffRho1, diffRho2;
 4682:             Vector2 vec1, vec2;
 4683:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4684:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4685: 
 4686:             const double rl1 = length(vec1);
 4687:             const double rl2 = length(vec2);
 4688:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4689: 
 4690:             const double delta = cross(vec1, vec2);
 4691:             const double sintheta = abs(delta)/(rl1*rl2);
 4692: 
 4693:             // To avoid problems, avoid elements with small angle between vectors
 4694:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4695:             const bool validEq = (sintheta > sin_one_deg);
 4696: 
 4697:             if (validEq) {
 4698:                // Solve the system of equations to get the density gradient at elem
 4699:                icount++;
 4700:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4701:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4702:                sumRx += Rx;
 4703:                sumRy += Ry;
 4704:             }
 4705:          } // for j1
 4706: 
 4707:          // Compute the average density gradient at elem
 4708:          if (icount==0) {
 4709:            // Bad mesh quality; bail out with 0 b-cc
 4710:            elem->gradRho[k] = {0.0, 0.0};
 4711:          } else {
 4712:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4713:          }
 4714: 
 4715:       } // for k
 4716: 
 4717:    }
 4718: 
 4719:    __global__ void computeBaroclinicTerm(void) {
 4720:    // Computes the baroclinic term at sides (at half levels).
 4721:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4722:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4723: 
 4724:       SIDE(side);
 4725: 
 4726:       if (side->isDry) return;
 4727: 
 4728:       const Element *e1 = side->elems[0];
 4729:       const Element *e2 = side->elems[1];      
 4730:       const int kb = side->kb;
 4731:       
 4732:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4733: 
 4734:       // interpolates vertically the density gradient of the two elements at the half level/
 4735: 
 4736:       // Starts the integration at the surface and goes down to the bottom
 4737:       int k1 = nvrt - 1;
 4738:       int k2 = nvrt - 1;
 4739: 
 4740:       side->bcc[nvrt-1] = {0.0, 0.0};
 4741:       for (int k = nvrt-2; k >= kb; k--) {
 4742:       // For each prism level (from surface to bottom)...
 4743: 
 4744:          // For both elements, interpolate density gradient at the side's half level.
 4745:          // The gradient at the side is the average of the gradients at the elements.
 4746:          // w1, w2 are used to take into account boundary sides, with just one element.
 4747:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4748:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4749:          const double wsum = w1 + w2;
 4750:          w1 = w1/wsum;
 4751:          w2 = w2/wsum;
 4752:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4753: 
 4754:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4755:          Vector2 gradRho = {0.0, 0.0};
 4756:          if (e1 != nullptr && k > kb) {
 4757:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4758:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4759:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4760:             
 4761:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4762:          }      
 4763:          if (e2 != nullptr && k > kb) {
 4764:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4765:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4766:             
 4767:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4768:          }
 4769: 
 4770:          if constexpr(ics==2) {
 4771:             // IMPLEMENT THIS XXXXXX
 4772:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4773:             // swild(1)=tmp1
 4774:             // swild(2)=tmp2
 4775:          }
 4776:          
 4777:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4778:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4779:          // CHECK INDICES!!! XXX
 4780:          const double grav3 = side->grav3();
 4781:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4782: 
 4783:       } // for
 4784: 
 4785:    }
 4786: 
 4787: 
 4788: 
 4789:    __global__ void computeHorGradientAtSide(void) {
 4790: 
 4791:       // Compute the horizontal density gradient at each element.
 4792:       // It works in two steps:
 4793:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4794:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4795:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4796:       //             gradRho.r1 = rho1 - rho0
 4797:       //             gradRho.r2 = rho2 - rho0
 4798:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4799:       // 
 4800:       //  NOTE: We use de-meaned densities.
 4801: 
 4802:       SIDE(side);
 4803: 
 4804:       if (side->isDry) return;
 4805: 
 4806:       // Computes the gradient of the variables at the side center.
 4807:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4808:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4809:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4810: 
 4811:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4812:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4813:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4814:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4815: 
 4816: 
 4817:    }
 4818: 
 4819: 
 4820:    __global__ void solveMomentumEquations(double time) {
 4821: 
 4822:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4823:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4824: 
 4825:       SIDE(side);
 4826: 
 4827:       if (side->isDry) 
 4828:       {
 4829:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4830: 
 4831:          return;
 4832:       }
 4833: 
 4834:       const Node *n1 = side->n1;
 4835:       const Node *n2 = side->n2;
 4836: 
 4837:       const int kb = side->kb;
 4838: 
 4839:       const double veg_h = side->veg_h();
 4840:       const double grav3 = side->grav3();
 4841: 
 4842:       if (side->is2D()) {
 4843:          // Warning: Do not use htot2, which is updated.
 4844:          const double htot = side->htot1();
 4845:          const double hhat = side->hhat;
 4846: 
 4847:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4848: 
 4849:          Vector2 tau2 = {0.0, 0.0};
 4850:           
 4851:          if constexpr(ics==1) {
 4852:             tau2 = side->tau();
 4853: 
 4854:          } else {
 4855:             assert(false && "Not implemented: ics == 2");
 4856:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4857:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4858:             // taux2=(vn1+tt1)*0.5d0
 4859:             // tauy2=(vn2+ss1)*0.5d0
 4860:          } // if ics         
 4861: 
 4862:          // hat_gam has units of m/s
 4863: 
 4864:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4865: 
 4866:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4867:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4868: 
 4869:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4870: 
 4871:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4872:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4873: 
 4874:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4875: 
 4876:       }
 4877:       else { // 3D
 4878: 
 4879:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4880:          // 
 4881:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4882:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4883:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4884:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4885:          // k+1 and k.
 4886: 
 4887: 
 4888:          // // Define layer thickness & viscosity
 4889:          // for (int k=kb + 1; k<nvrt; k++) {
 4890:          //    const double dzz = side->Dz(k - 1);
 4891: 
 4892:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4893: 
 4894:          //    // Vertical viscosity at the face center
 4895:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4896:         
 4897:          // }
 4898: 
 4899: 
 4900:          const int ndim = nvrt - kb;
 4901:          const double zTopCanopy = side->zTopCanopy();
 4902: 
 4903:          // Initialize the tridiagonal system
 4904:          for (int k = kb + 1; k<nvrt; k++) {
 4905:             
 4906:             const int kin = k - kb;
 4907: 
 4908:             // Vertical viscosity at the face center
 4909:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4910:             const double dzz = side->Dz(k);
 4911: 
 4912:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4913: 
 4914:             alow[kin] = 0.0;
 4915:             cupp[kin] = 0.0;
 4916:             bdia[kin] = 0.0;
 4917: 
 4918:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4919:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4920: 
 4921:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4922:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4923:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4924: 
 4925:             // First part: layers k, k+1
 4926:             if (k < nvrt - 1) {
 4927:                              
 4928:                if constexpr(iveg != 0) {
 4929: 
 4930:                   // If there is vegetation at this level...
 4931:                   if (zTopCanopy > side->zc[k]) {
 4932:                      // If the canopy is above the k layer...
 4933:                      
 4934:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4935:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4936:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4937:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4938: 
 4939:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4940:                      const double vmag2 = length(ut2);
 4941:                      const double vmag1 = length(side->u2[k]);
 4942:                      const double vmag = 0.5*(vmag1 + vmag2);
 4943:                      
 4944:                      // Computes the vegetation alpha at the face center
 4945:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4946: 
 4947:                      cff1 += veg_alpha_sd*dt*vmag;
 4948: 
 4949:                   } // if (zTopCanopy
 4950:                } // if iveg
 4951: 
 4952:                const double tmp = dt*dfz/dzz;
 4953:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4954:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4955:             }
 4956: 
 4957: 
 4958:             // Second part: layers k-1, k
 4959:             if (k > kb + 1) {
 4960: 
 4961:                double cff1 = 1.0; //init \bar{c^k}
 4962: 
 4963:                if constexpr(iveg != 0) {
 4964:                   // If there is vegetation at this level...
 4965:                   if (zTopCanopy > side->zc[k-1]) {
 4966:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4967:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4968: 
 4969:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4970: 
 4971:                      const double vmag2 = length(ut2);
 4972:                      const double vmag1 = length(side->u2[k-1]);
 4973:                      const double vmag = 0.5*(vmag1 + vmag2);
 4974: 
 4975:                      // Computes the vegetation alpha at the face center
 4976:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4977:                      cff1 += veg_alpha_sd*dt*vmag;
 4978:                   } // if zTopCanopy
 4979: 
 4980:                } // if iveg
 4981: 
 4982:                const double tmp = dt*dfz/dzz;
 4983:                alow[kin] += cff1*dzz/6.0 - tmp;
 4984:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4985: 
 4986:             } else { // Bottom boundary
 4987:                // This occurs at the bottom, where the bottom drag is applied.
 4988: 
 4989:                bdia[kin] += dt*side->chi2;
 4990: 
 4991:             } // if (k > kb + 1)
 4992: 
 4993: 
 4994: 
 4995:          } // for (int k
 4996: 
 4997: 
 4998: 
 4999:          // Computes the RHS.
 5000:          // -----------------
 5001: 
 5002:          //	BC to be imposed at the end.
 5003: 
 5004:          const Vector2 gradETP  = side->gradETP;
 5005:          const Vector2 gradPr   = side->gradPr;
 5006:          const Vector2 gradEta1 = side->gradEta1;
 5007:          const Vector2 gradEta2 = side->gradEta2;
 5008: 
 5009:          const Vector2 *btu = side->btu;
 5010:          const Vector2 *u2  = side->u2;
 5011:          const double coriolis = side->coriolis;
 5012:          const Vector2 *nuGradU = side->nuGradU;
 5013: 
 5014: 
 5015:          for (int k = kb + 1; k<nvrt; k++) {
 5016:             const int kin = k - kb;
 5017: 
 5018:             const double dz_0 = side->Dz(k);
 5019:             const double dz_1 = side->Dz(k+1);  
 5020: 
 5021:             rrhs[kin] = {0.0, 0.0};
 5022:             double dz = 0.0;
 5023: 
 5024:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5025:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5026:             if (k < nvrt  ) dz += 0.5*dz_1;
 5027:             if (k > kb + 1) dz += 0.5*dz_0;
 5028: 
 5029:             // Elevation gradient, atmospheric pressure and tidal potential
 5030:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5031: 
 5032:             // Coriolis, advection, wind stress, and horizontal viscosity
 5033:             if (k < nvrt - 1) {
 5034: 
 5035: 
 5036:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5037:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5038:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5039: 
 5040:                //diff stress tensors 1006
 5041:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5042:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5043:                   assert(false && "Not implemented: itur == 5");
 5044:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5045:                }
 5046: 
 5047:             } else { // k=nvrt
 5048:                Vector2 tau2 = {0.0, 0.0};
 5049:                if constexpr(ics==1) {
 5050:                   tau2 = side->tau();
 5051:                } else {
 5052:                   assert(false && "Not implemented: ics == 2");
 5053:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5054:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5055:                   // taux2=(vn1+tt1)*0.5d0
 5056:                   // tauy2=(vn2+ss1)*0.5d0
 5057:                } // if ics
 5058: 
 5059:                rrhs[kin] += dt*tau2;
 5060: 
 5061:             } // if k<nvrt
 5062: 
 5063:             if (k > kb + 1) {
 5064:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5065:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5066:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5067: 
 5068: 
 5069:                // diff stress tensors 1006
 5070:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5071:                   assert(false && "Not implemented: itur == 5");
 5072:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5073:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5074:                }
 5075: 
 5076:             } // if k>kbs + 1
 5077: 
 5078:             // Baroclinic
 5079:             Vector2 *bcc = side->bcc;
 5080:             if constexpr(ibc == 0) {
 5081:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5082:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5083: 
 5084:             } // if ibc==0
 5085: 
 5086: 
 5087:          } // k=kb + 1,nvrt
 5088: 
 5089:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5090:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5091: 
 5092: 
 5093:          for (int k=kb + 1; k<nvrt; k++) {
 5094:             const int kin = k - kb;
 5095: 
 5096:             // Velocity is always clamped to maximum values
 5097:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5098:          } // k
 5099: 
 5100:       } // if side->is2D()
 5101:       
 5102: 
 5103:       // Impose velocity boundary condition at the bottom
 5104:       if constexpr(imm == 2) { // 3D bed deformation model
 5105:          double dep;
 5106:          Vector2 vel;
 5107: 
 5108:          assert(false && "Not implemented: imm == 2");
 5109:          //update_bdef(time, x0, y0, dep, vel);
 5110:          // side->u2[kb] = vel;
 5111: 
 5112:       } else { // imm = 0 or 1
 5113:          if (side->Cd() == 0.0) {
 5114:             side->u2[kb] = side->u2[kb + 1];
 5115:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom
 5116:             side->u2[kb] = {0.0, 0.0};
 5117:          }
 5118:           
 5119:       } // if imm
 5120: 
 5121:       // The velocities below the bottom level are set to zero
 5122:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5123: 
 5124: 
 5125:    }
 5126: 
 5127: 
 5128:    __global__ void applyMomentumBC(void) {
 5129: 
 5130:       SIDE_BND(sideBnd);
 5131: 
 5132:       Side *side = sideBnd->side;
 5133:       const BoundarySegment *segment = sideBnd->segment;
 5134:       const Node *n1 = side->n1;
 5135:       const Node *n2 = side->n2;
 5136: 
 5137:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5138: 
 5139:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5140:       const bool isLand = segment->isLand;
 5141:       const int ifltype = segment->ifltype;
 5142: 
 5143:       const int kb = side->kb;
 5144: 
 5145:       if (!isLand && ifltype != 0) {
 5146:          const Vector2 *ubc = sideBnd->ubc;
 5147:   
 5148:          for (int k=kb; k < nvrt; k++) {
 5149:             
 5150:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5151:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5152: 
 5153:             if (ifltype == -1) {
 5154:                // Flather 1
 5155: 
 5156:                const double depth = side->depth();
 5157: 
 5158:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5159: 
 5160:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5161: 
 5162:                side->u2[k] = vnorm*side->n;
 5163: 
 5164:             } else if (ifltype == -2) { // Discharge
 5165: 
 5166:                const double eta1 = side->eta1();
 5167:                const double eta2 = side->eta2();
 5168:                const double htot = side->htot2();
 5169: 
 5170:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5171:                assert(false && "Not implemented: Discharge bc");
 5172:                // const double dischrg = discharge(eta1);
 5173:                const double dischrg = 0.0; // XXX REMOVE
 5174:                
 5175: 
 5176:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5177: 
 5178:                const double vnorm = dischrg*eta2/htot;
 5179: 
 5180:                side->u2[k] = vnorm*side->n;
 5181: 
 5182: 
 5183:             }
 5184:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5185:                const double vnorm = dot(side->u2[k], side->n);
 5186: 
 5187:                double rat;
 5188:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5189:                else              rat = segment->vobc2; // outgoing
 5190: 
 5191:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5192:             }
 5193:             else { // not Flather or 3D radiation
 5194:                side->u2[k] = ubc[k];
 5195: 
 5196:             } // if (segment->ifltype...
 5197: 
 5198:          }
 5199: 
 5200:       }
 5201:       else if (isLand) { // if it is land boundary side
 5202: 
 5203:          if constexpr(islip == 0) { // free slip
 5204:             for (int k=kb; k < nvrt; k++) {
 5205: 
 5206:                const Vector2 t = side->t();
 5207:                const Vector2 n = side->n;
 5208: 
 5209:                double vnorm = 0.0; // for most cases
 5210:                const double vtan = dot(side->u2[k], t);
 5211:                
 5212:                side->u2[k] = vtan*t - vnorm*n;
 5213: 
 5214:             }
 5215: 
 5216:          } else { // no slip
 5217:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5218: 
 5219:          }
 5220:       } // if (side segment type...
 5221: 
 5222:    
 5223: 
 5224:    }
 5225: 
 5226: 
 5227:    __global__ void shapiroFilter1(void) {
 5228:       // First step of the Shapiro filter (normally used if indvel<=0)
 5229:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5230: 
 5231:       SIDE(side);
 5232: 
 5233:       // Only internal wet sides are processed
 5234:       if (side->isDry || !(side->isInternal())) return;
 5235: 
 5236:       const int kb = side->kb;
 5237: 
 5238:       for (int mm = 1; mm <= niter_shap; mm++) {
 5239: 
 5240:          for (int k = kb + 1; k < nvrt; k++) {
 5241:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5242:             side->bcc[k] = {0.0, 0.0};
 5243:             Vector2 suru = {0.0, 0.0};
 5244: 
 5245:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5246: 
 5247:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5248: 
 5249:                int kin = k;
 5250:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5251:                
 5252:                if constexpr(ics==1) {
 5253:                   suru += nSide->u2[kin];
 5254: 
 5255:                } else {
 5256:                   assert(false && "Not implemented: ics == 2");
 5257:                   // Vector2 vn1, vn2;
 5258:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5259:                   // suru=suru+vn1;
 5260:                   // surv=surv+vn2;
 5261:                }
 5262:             }
 5263: 
 5264: 
 5265:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5266: 
 5267:          }
 5268:       }
 5269:    }
 5270: 
 5271:    __global__ void shapiroFilter2(void) {
 5272:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5273: 
 5274:       SIDE(side);
 5275: 
 5276:       if (side->isDry || !(side->isInternal())) return;
 5277: 
 5278:       const int kb = side->kb;
 5279: 
 5280:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5281: 
 5282:       if (side->is2D()) {
 5283:          // side->u2[kb] = side->u2[nvrt - 1];
 5284:          side->u2[kb + 1] = side->bcc[kb + 1];
 5285:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5286: 
 5287:       } else {
 5288:          // 3D
 5289:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5290:          
 5291:       }
 5292: 
 5293:    }
 5294: 
 5295: 
 5296:    __global__ void ul0UpdateZCoords(void) {
 5297:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5298:       
 5299:       NODE(node);      
 5300: 
 5301:       if (node->isDry2()) { 
 5302: 
 5303:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5304: 
 5305:          if constexpr(ivcor != 1) node->kb = 0;
 5306: 
 5307:       } else {
 5308: 
 5309:          node->updateKb();
 5310:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5311: 
 5312:       }
 5313: 
 5314:       // We use the temp.b field to store the previous state of isDry.
 5315:       node->tmp.b = node->isDry;
 5316: 
 5317:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5318:       node->isDry = true;
 5319: 
 5320:    }
 5321: 
 5322:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5323:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5324:    {
 5325:       ELEM(elem);
 5326: 
 5327:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5328: 
 5329:       // All the nodes of a wet element are wet.
 5330:       if (!elem->isDry) {
 5331:          elem->nodes[0]->isDry = false;
 5332:          elem->nodes[1]->isDry = false;
 5333:          elem->nodes[2]->isDry = false;
 5334:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5335: 
 5336:       }
 5337: 
 5338: 
 5339:       elem->kb = 0;
 5340: 
 5341:       if (elem->isDry) return;
 5342: 
 5343:       // Wet
 5344:       const Node *n1 = elem->nodes[0];
 5345:       const Node *n2 = elem->nodes[1];
 5346:       const Node *n3 = elem->nodes[2];  
 5347:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5348: 
 5349:    //    if(elem->isDry2()) {
 5350:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5351:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5352:    //        call parallel_abort(errmsg)
 5353:    //    }
 5354: 
 5355: 
 5356:       // Computes element's kb as the minimum of the nodes' kb.
 5357:       const int kb1 = n1->kb;
 5358:       const int kb2 = n2->kb;
 5359:       const int kb3 = n3->kb;
 5360:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5361: 
 5362: 
 5363:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5364: 
 5365: 
 5366:       // Computes the element z as the mean of the nodes z.
 5367:       for (int k = elem->kb; k < nvrt; k++) {
 5368: 
 5369:          // Compute the element z as the mean of the nodes z.
 5370:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5371:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5372:          elem->z[k] /= elem->i34;
 5373: 
 5374:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5375:       }
 5376:                   
 5377:    }
 5378: 
 5379:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5380:    {
 5381:       NODE(node);
 5382:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5383: 
 5384:       if (it == iths) return;
 5385: 
 5386: 
 5387:       if(!node->isDry && node->tmp.b) { // rewetted
 5388:          for (int k=0; k < nvrt; k++) {
 5389: 
 5390:             Vector3 utmp={0.0, 0.0, 0.0};
 5391: 
 5392:             double ttmp=0.0;
 5393:             double stmp=0.0;
 5394:             int icount=0;
 5395:             for (int j = 0; j < node->numNodes; j++) {
 5396: 
 5397: 
 5398:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5399:                if (!node->isDry) { // all indices extended
 5400:                   icount++;
 5401: 
 5402:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5403:                   utmp += node->u2[k];
 5404:                   
 5405:                   ttmp += node->tracers[k].tracer[0]; 
 5406:                   stmp += node->tracers[k].tracer[1]; 
 5407:                }
 5408:             }
 5409: 
 5410:             if(icount > 0) {
 5411:                const double inv_icount = 1.0/icount;
 5412:                node->u2[k]     = inv_icount*utmp;
 5413:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5414:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5415:             }
 5416:          }
 5417:       }
 5418:    }
 5419: 
 5420: 
 5421:    __global__ void ul0UpdateSides(int it, int iths) {
 5422: 
 5423:       SIDE(side);
 5424: 
 5425:       // A side is wet if and only if at least one of its elements is wet.
 5426:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5427: 
 5428:       const Node *n1 = side->n1;
 5429:       const Node *n2 = side->n2;
 5430:       const int kb1 = n1->kb;
 5431:       const int kb2 = n2->kb;
 5432: 
 5433:       side->kb = 0; // dry
 5434: 
 5435:       if (isWet) {
 5436: 
 5437:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5438: 
 5439:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5440: 
 5441:          side->kb = min(kb1, kb2);
 5442: 
 5443:          for (int k = side->kb; k < nvrt; k++) {
 5444:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5445: 
 5446:          
 5447:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5448: 
 5449:             // Compute velocity for re-wetted sides 
 5450:             if ((it != iths) && (side->isDry && isWet)) {
 5451:             
 5452:                Vector2 utmp={0.0, 0.0};
 5453: 
 5454:                int icount=0;
 5455: 
 5456:                // For all the sides on the two elements that share this side
 5457:                for (int j=0; j < 2; j++) {
 5458:                   const Element *elem = side->elems[j];
 5459:                   if (elem == nullptr) continue;
 5460: 
 5461:                   for (int jj=0; jj < elem->i34; jj++) {
 5462:                      const Side *nSide = elem->sides[jj];
 5463:                      if (nSide->isDry) continue;
 5464: 
 5465:                      icount++;
 5466:                      utmp += nSide->u2[k];                     
 5467:                   }
 5468:                }
 5469:                   
 5470:                assert(icount > 0 && "No wet sides around this side");
 5471:                if (icount > 0)  side->u2[k] = utmp/icount;
 5472:                   
 5473:             } // if ((it != iths) && (side->isDry && isWet))
 5474: 
 5475:          } // for k
 5476: 
 5477:       } // if isWet
 5478:    
 5479:       side->isDry = !isWet;
 5480: 
 5481:    }
 5482: 
 5483: 
 5484:    __global__ void zeroNodalVelocities(void) {
 5485:       NODE(node);
 5486: 
 5487:       for (int k = 0; k < nvrt; k++) {
 5488:          node->u2[k]   = {0.0, 0.0, 0.0};
 5489:          node->utmp[k] = {0.0, 0.0};
 5490:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5491:       }
 5492:    }
 5493: 
 5494:    __global__ void computeNodalVerticalVelocities1(void) {
 5495:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5496:    // Adds the element's vertical velocity times the element's area.
 5497:       ELEM(elem);
 5498: 
 5499:       for (int j = 0; j < elem->i34; j++) {
 5500:          Node *node = elem->nodes[j];
 5501: 
 5502:          for (int k = node->kb; k < nvrt; k++) {
 5503:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5504:          }
 5505:          atomicAdd(&(node->tmp.d), elem->area);
 5506:       }
 5507:    }
 5508: 
 5509:    __global__ void computeNodalVerticalVelocities2(void) {
 5510:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5511:    // Divides by the total area of the elements sharing the    node.
 5512:       NODE(node);
 5513: 
 5514:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5515:    }
 5516: 
 5517: 
 5518:    __global__ void computeNodalHorizontalVelocities1(void) {
 5519:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5520:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5521: 
 5522:       ELEM(elem);
 5523: 
 5524:       const int kb = elem->kb;
 5525:       const bool isTri = elem->isTri();
 5526: 
 5527:       if constexpr(indvel <= 0) {
 5528:          // Assuming discontinoius hvel.
 5529: 
 5530: 
 5531:          if (isTri) { // For triangles
 5532:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated at one node can be
 5533:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5534: 
 5535:             for (int j = 0; j < 3; j++) {
 5536:                // For every node of the triangle...
 5537:                Node *node = elem->nodes[j];
 5538: 
 5539:                const Side *s1 = elem->sides[j];
 5540:                const Side *s2 = elem->sides[(j + 1) % 3];
 5541:                const Side *s3 = elem->sides[(j + 2) % 3];
 5542: 
 5543:                const int numElements = node->numElements;
 5544: 
 5545:                for (int k = kb; k < nvrt; k++)  {
 5546:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k];
 5547:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5548:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5549:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5550:                   atomicAdd(&(node->utmp[k].x), (1.0/numElements) * u.x);
 5551:                   atomicAdd(&(node->utmp[k].y), (1.0/numElements) * u.y);
 5552: 
 5553:                }
 5554: 
 5555:             }
 5556:          }
 5557:          else { // For quads
 5558: 
 5559:          }
 5560: 
 5561:       }
 5562:       
 5563:    }
 5564: 
 5565: 
 5566:    __global__ void computeNodalHorizontalVelocities2(void) {
 5567:       NODE(node);
 5568: 
 5569:       for (int k = 0; k < nvrt; k++) {
 5570:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5571:       }
 5572:       
 5573:    }   
 5574: 
 5575:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5576:    // XXXX I'm not sure where I got this function from. 
 5577:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5578:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5579:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5580:    // It uses the utmp array as a temporary array to store the velocities.
 5581: 
 5582:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5583: 
 5584:       SIDE(side);
 5585: 
 5586:       const int kb = side->kb;
 5587: 
 5588:       Node *n1 = side->n1;
 5589:       Node *n2 = side->n2;
 5590: 
 5591:       for (int k = kb; k < nvrt; k++) {
 5592: 
 5593:          // Cast the u2 vector into a Vector2 
 5594:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5595:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5596: 
 5597:          n1_u2 = side->u2[k]/n1->numSides;
 5598:          n2_u2 = side->u2[k]/n2->numSides;
 5599: 
 5600:       }
 5601: 
 5602: 
 5603:    }
 5604: 
 5605:    __global__ void resetVelocityOpenBndNodes(void) {
 5606:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5607: 
 5608:       NODE_BND(nodebnd);
 5609: 
 5610:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5611:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5612:       }
 5613: 
 5614:    }
 5615: 
 5616: 
 5617:    __global__ void setVelocityOpenBndNodes(void) {
 5618:    // For open boundary nodes sets their velocity to the imposed values.
 5619: 
 5620:       SIDE_BND(sidebnd);
 5621: 
 5622:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5623:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5624:          // to its segment to the average of the side velocity.
 5625: 
 5626:          for (int k = 0; k < nvrt; k++) {
 5627:             Node *n1 = sidebnd->side->n1;
 5628:             Node *n2 = sidebnd->side->n2;
 5629: 
 5630:             // Cast the u2 vector into a Vector2 
 5631:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5632:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5633: 
 5634:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5635:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5636:          }
 5637:       }
 5638: 
 5639:    }
 5640: 
 5641: 
 5642:    __global__ void computeVerticalVelocity(void) {
 5643:       // Computes the vertical velocity at the (2D) element's centroid.
 5644:       // In this function we will be considering volumetric elements, with side faces and a 
 5645:       // bottom and a top face. We will call them SFs, BF and TF.
 5646:       // It computes the flux coming from BF and the SFs.
 5647:       // If the bed is moving, it takes that into account.
 5648:       // Since water is incompressible, the integral of the velocity times the normal vector
 5649:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5650:       // and the BF is equal to the flux going out from the TF.
 5651:       // TF = - BF - sum(SFs).
 5652:       // It then computes the horizontal velocity at the center of TF.
 5653:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5654:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5655:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5656: 
 5657:       ELEM(elem);
 5658: 
 5659:       if (elem->isDry) return;
 5660: 
 5661:       const int kb = elem->kb;
 5662:       const bool isTri = elem->isTri();
 5663: 
 5664:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5665: 
 5666:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5667:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5668:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5669: 
 5670:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5671: 
 5672:       double area3D;
 5673: 
 5674:       // Bottom face flux
 5675:       double bottomFlux = 0.0;
 5676:       Vector2 u2meanBottom = {0.0, 0.0};
 5677:       const Vector2 gradh = elem->grad2(&Node::depth);
 5678:       if constexpr(imm==2) {
 5679:          Vector3 ubed;
 5680: 
 5681:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5682:          // updateBDEF(ubed);
 5683:      
 5684:          // const double bflux0 = dot(ubed, elem_n1);
 5685: 
 5686:          // elem->w[kb] += ubed.z;
 5687:       }
 5688:       else {
 5689:          Vector2 umean;
 5690:          if constexpr(ics == 1) {
 5691:             u2meanBottom = elem->mean(kb, &Side::u2);
 5692:          }
 5693:          else {
 5694:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5695:          }
 5696: 
 5697:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5698:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5699: 
 5700:          bottomFlux = - dot(gradh, u2meanBottom);
 5701:       } // if imm
 5702: 
 5703:       // Compute w for kb+1 to nvrt-1
 5704:       for (int l = kb; l < nvrt - 1; l++) {
 5705: 
 5706:          // normal vector to the top face of the "volumetric" element (3D)
 5707:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5708: 
 5709:          // Compute the total flux at the sides
 5710:          double sideFlux = 0.0;
 5711:          Vector2 u2top = {0.0, 0.0};
 5712:          for (int j = 0; j < elem->i34; j++) {
 5713:             const Side *side = elem->sides[j];
 5714: 
 5715:             const double sideArea = side->area(l);
 5716:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5717:             const double sign = elem->ssign[j]; 
 5718: 
 5719:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5720:          }
 5721:          
 5722:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5723:          //velocities at the centers of the sides
 5724:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5725: 
 5726:          // The flx at the top ace can be computed from the other flows.
 5727:          const double topFlux = - sideFlux - bottomFlux;
 5728:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5729: 
 5730:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5731: 
 5732:          elem_n1 = elem_n2;
 5733: 
 5734:          bottomFlux = - topFlux;
 5735:       }
 5736:    }  
 5737: 
