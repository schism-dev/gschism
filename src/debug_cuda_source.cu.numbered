 3144: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3145:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3146:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3147:    // 
 3148:    // This kernel is called for all nodes.
 3149: 
 3150: 
 3151:    NODE(node1);
 3152: 
 3153: 
 3154:    node1->clearMatrixRow();
 3155:    node1->qel = 0.0;
 3156: 
 3157:    // THIS IS FOR STRUCTURES XXX
 3158:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3159: 
 3160:    
 3161:    for (int j=0; j<node1->numElements; j++) {
 3162:       // For each element connected to the node...
 3163: 
 3164:       Element *elem = node1->elements[j];
 3165: 
 3166:       // Compute the average gravity
 3167:       const double grav3 = elem->mean(&Node::grav2);
 3168: 
 3169:       // Look at the documentation for the description of the terms in the following integrals
 3170: 
 3171:       // Integral I_1 
 3172:       // \bar{\breve{H}} 
 3173:       const double hhatb = elem->mean(&Side::hhat);        
 3174: 
 3175: 
 3176:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3177: 
 3178:       const int id1 = elem->nodeLocalIdx(node1); 
 3179:       const double area = elem->area;
 3180: 
 3181:       if (elem->isTri()) {
 3182: 
 3183:          // To clarify the notation in this section: 
 3184:          //   i stands for the node under consideration (node1)
 3185:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3186:          const int id2 = elem->nxq(1 + id1);
 3187:          const int id3 = elem->nxq(2 + id1);
 3188:          Node *node2 = elem->nodes[id2];
 3189:          Node *node3 = elem->nodes[id3];
 3190: 
 3191:          const Point2 x1 = node1->p2();
 3192:          const Point2 x2 = node2->p2();
 3193:          const Point2 x3 = node3->p2();
 3194: 
 3195:          // integral of phi_i*phi_j
 3196:          const double ipp_ii = (1.0/6.0 )*area;
 3197:          const double ipp_ij = (1.0/12.0)*area;
 3198:          const double ipp_ik = (1.0/12.0)*area;
 3199: 
 3200:          // integral of [(grad phi_i) * (grad phi_j)]
 3201:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3202:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3203:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3204: 
 3205:          // Computes the different components of integral I_1 of each node with respect to node i.
 3206:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3207:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3208:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3209: 
 3210: if (j==node1->numElements-1) {
 3211: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 3212: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 3213: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3214: }
 3215: 
 3216:          node1->addToSparseMatrix(node1, I1_ii);
 3217:          node1->addToSparseMatrix(node2, I1_ij); 
 3218:          node1->addToSparseMatrix(node3, I1_ik);
 3219: 
 3220: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3221:      
 3222:       }
 3223:       else { // Quad
 3224:          // XXX IMPLEMENT THIS
 3225:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3226:       } 
 3227: 
 3228:  
 3229:       // Integral I_4
 3230:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3231:       // Where
 3232:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3233: 
 3234:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3235:       // of U over the element.
 3236:       Vector2 Umean = {0.0, 0.0};
 3237:       for (int m=0; m<elem->i34; m++) {      
 3238:          const Side *side = elem->sides[m];
 3239: 
 3240:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3241:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3242:       }
 3243:       Umean = Umean/elem->i34;
 3244: 
 3245:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3246: 
 3247:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3248:       const double I_4_1 = dot(gradPhi_1, Umean);
 3249: 
 3250:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3251:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3252:      
 3253:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3254: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 3255: 
 3256:       // Additional terms 
 3257:       double vnorm = 0.0;
 3258:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3259:          Vector3 ubed;
 3260:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3261: 
 3262:          Vector3 gradP = {0.0, 0.0, 1.0};
 3263:          for (int m=0; m < elem->i34; m++) {
 3264:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3265:            gradP += toVector3(gradP_2D, 0.0);
 3266:          }   
 3267:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3268:       } // imm==2
 3269: 
 3270:       if (elem->isTri()) {
 3271:          for (int l=0; l<3; l++) {
 3272:            double fac;
 3273: 
 3274:            Node *node = elem->nodes[l];
 3275: 
 3276:            (node == node1)? fac=2.0 : fac=1.0;
 3277: 
 3278:            if constexpr(imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3279:            else                 node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3280:            
 3281:          }
 3282: 
 3283: 
 3284:          if (!elem->isDry) {
 3285:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3286: 
 3287:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3288:          }
 3289: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 3290: 
 3291:       } // isTri
 3292:       else { // isQuad
 3293:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3294:          // for (int l=0; l<4; l++) {
 3295:          //   const Node *node = elem->nodes[l];
 3296: 
 3297:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3298:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3299: 
 3300:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3301:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3302:          // }
 3303: 
 3304:       } // isQuad
 3305: 
 3306: 
 3307:       node1->qel += (dt/elem->i34)*elem->vsource;
 3308:       
 3309: 
 3310:    } // for all elements connected to the node
 3311:    
 3312: 
 3313: 
 3314:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3315:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3316:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3317:    if (nodeBnd != nullptr)  { 
 3318:       // If it is an open boundary node...
 3319: 
 3320:       // At least one open bnd side, maybe two
 3321:       for (int l=0; l<2; l++) { 
 3322: 
 3323:          // Gets each of the sides sharing the node. 
 3324:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3325: 
 3326:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3327: 
 3328:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3329: 
 3330:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3331:          if (sideBnd != nullptr) {
 3332:             // If the side is on a boundary...
 3333: 
 3334:             // Get the boundary segment
 3335:             const BoundarySegment *sideSegment = sideBnd->segment;
 3336:             const Side *side = sideBnd->side;
 3337: 
 3338:             // Integral I_3
 3339:             if (sideSegment->ifltype != 0) {
 3340:             // Natural or Flather b.c.
 3341: 
 3342:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3343:                // especially for Flather b.c.
 3344:                double ri3 = 0.0;
 3345:                if (!side->isDry) {
 3346:                   // If the side is not dry
 3347:                   
 3348:                   // Computes the side flux of (uth, vth)
 3349:                   double Vn = 0.0;
 3350:                   for (int k = side->kb; k<nvrt-1; k++) {
 3351:                      // uth, vth in lat/lon frame if ics=2
 3352:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3353:                      const double vn1 = dot(sideBnd->uth(k  ), side->n); // outer normal
 3354:                      const double vn2 = dot(sideBnd->uth(k+1), side->n);
 3355: 
 3356:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3357:                   }
 3358: 
 3359:                   ri3 = 0.5*side->len*Vn;
 3360:                }
 3361: 
 3362:                if (sideSegment->ifltype == -1) { // Flather 1
 3363: 
 3364:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3365:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3366: 
 3367:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3368:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3369:                   
 3370:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3371:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3372: 
 3373:                } 
 3374:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3375:                   // Reset ri3
 3376:                   ri3 = 0.0;
 3377: 
 3378:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3379: 
 3380:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3381: 
 3382:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3383:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3384: 
 3385:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3386:                   node1->addToSparseMatrix(node1, con0*2.0);
 3387:                   node1->addToSparseMatrix(node2, con0);
 3388: 
 3389:                } // if Flather or Discharge
 3390: 
 3391:                node1->qel -= thetai*dt*ri3;
 3392: 
 3393:             } // I_3
 3394:           
 3395: 
 3396:             // Integral I_5
 3397:             if(!side->isDry) {
 3398: 
 3399:                const double Unbar = dot(side->U, side->n);
 3400: 
 3401:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3402:                
 3403:             } // I_5
 3404: 
 3405:          } // if is boundary side
 3406: 
 3407:       } // for l
 3408: 
 3409:    } // if isbnd
 3410: 
 3411: 
 3412:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3413: 
 3414: }
 3415: 
 3416: 
 3417: 
 3418: extern "C" {
 3419:    __global__ void rollUpElevation(void) {
 3420: 
 3421:       NODE(node);
 3422: 
 3423:       node->eta2 += node->eta1;
 3424: 
 3425:    }
 3426: 
 3427: 
 3428:    __global__ void backtrackAllNodes(void) {
 3429: 
 3430:       // max/min # of sub-divisions
 3431:       const int ndelt_max = max(1.0, dt/dtb_min);
 3432:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3433: 
 3434:       // Removed all references to swild98 XXX
 3435:       // swild98=0.d0 !init
 3436: 
 3437: 
 3438:       SIDE(side);
 3439: 
 3440:       const int kb = side->kb;
 3441: 
 3442: 
 3443: 
 3444:       // Initialize btrack velocities to the actual velocities at the side 
 3445:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3446: 
 3447: 
 3448:       if (side->isDry) return;
 3449: 
 3450: 
 3451:       // Checks that at least one element is not dry
 3452:       const Element *elem1 = side->elems[0];
 3453:       const Element *elem2 = side->elems[1];
 3454: 
 3455: 
 3456:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3457:       
 3458:       // XXXXXX
 3459:       // !swild_tmp to store global coord. of the starting side
 3460:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3461:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3462:       // !Use sframe2 
 3463:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3464: 
 3465: 
 3466:       for (int k = kb; k < nvrt; k++) {
 3467:       //  Initialize (xt,yt,zt), nnel and vel.
 3468:       //  For ics=2, the coordinates are in local frames
 3469:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3470: 
 3471: 
 3472:          const int iadvf = side->iadv();  // Advection flag
 3473: 
 3474:          Point3 xt;
 3475:          if constexpr(ics==1) {
 3476:             xt = side->center3D(k); 
 3477:          }
 3478:          else // lat/lon; in side lat/lon frame
 3479:          {
 3480:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3481:          // XXX IMPLEMENT THIS
 3482:       //          xt=0.d0
 3483:       //          yt=0.d0
 3484:       //          !centroid coord. for nudging
 3485:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3486:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3487:          }  // ics
 3488: 
 3489: 
 3490:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3491:          // XXX IS THIS NECESSARY?
 3492:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3493: 
 3494:          // If on land or open boundary...
 3495:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3496:          
 3497:          const double vmag = length(toVector2(u_int));
 3498: 
 3499:          if (vmag <= velmin_btrack) {
 3500:             // No activity 
 3501: addDebugPlot(side->center, side->center, 0x00FF00);
 3502:             side->btu[k] = side->u2[k];
 3503:             
 3504:          } else {  // do btrack
 3505: 
 3506:             // Compute number of sub-divisions based on local gradients 
 3507:             // XXX IS THIS NECESSARY?
 3508:             double suma = 0.0;
 3509:             int icount = 0;
 3510:             for (int ii=0; ii<2; ii++) {
 3511: 
 3512:                const Element *elem = side->elems[ii];
 3513:                  
 3514:                if (elem == nullptr) continue;
 3515: 
 3516:                icount++;
 3517: 
 3518:                // Not strictly along z; in ll frame for ics=2
 3519: 
 3520:                double utmp[4];
 3521:                double vtmp[4];
 3522:                for (int jj = 0; jj < elem->i34; jj++) {
 3523: 
 3524:                   const Node *node = elem->nodes[jj];
 3525: 
 3526:                   if constexpr(ics==1) {
 3527:                      utmp[jj] = node->u2[k].x;
 3528:                      vtmp[jj] = node->u2[k].y;  
 3529:                   } else {
 3530:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3531:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3532:                   }
 3533:                } // for jj
 3534: 
 3535:                const Vector2 grad_u = elem->grad2(utmp); 
 3536:                const Vector2 grad_v = elem->grad2(vtmp);
 3537: 
 3538:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3539:             } // for ii
 3540: 
 3541:             assert(icount > 0 && "Impossible 77");
 3542: 
 3543:             // '4' is somewhat arbitrary
 3544:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3545: 
 3546:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3547:          
 3548: 
 3549:             Vector3 u_int = {0.0, 0.0, 0.0};
 3550: 
 3551:             side->btrack(k, dt, dtbk, u_int);
 3552:                
 3553:          } // if vmag (do backtrack)
 3554: 
 3555:       } // for j=jmin,nvrt-1
 3556: 
 3557:    }
 3558: } // extern "C"
 3559: 
 3560: template<int nc>
 3561: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3562: 
 3563: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3564: //
 3565: // a,b,c,rhs: input vectors and are not modified by this program.
 3566: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3567: // rhs is the r.h.s.
 3568: // n: actual rank of the system.
 3569: // rows in u() and rhs();
 3570: // u: output with nc columns (transposed to rows)
 3571: // gam: a working array.
 3572: //
 3573: // NOTES:
 3574: // This is a template function that allows for different numbers of columns in the rhs vector.
 3575: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3576: 
 3577:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3578:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3579: 
 3580:    double bet = b[0];
 3581:    if constexpr (nc == 1) {
 3582:       u[0] = rhs[0]/bet;
 3583:    } else {
 3584:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3585:    }
 3586: 
 3587:    for (int j = 1; j < n; j++) {
 3588:       gam[j] = c[j-1]/bet;
 3589:       bet = b[j] - a[j]*gam[j];
 3590: 
 3591:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3592: 
 3593:       if constexpr (nc == 1) {
 3594:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3595:       } else {
 3596:          for (int k = 0; k < nc; k++) {
 3597:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3598:          }
 3599:       }
 3600:    }
 3601: 
 3602:    // Back-substitution
 3603:    for (int j=n-1; j>=1; j--) {
 3604:       if constexpr (nc == 1) {
 3605:          u[j] = u[j] - gam[j+1]*u[j-1];
 3606:       } else {
 3607:          for (int k = 0; k < nc; k++) {
 3608:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3609:          }
 3610:       }
 3611:    }
 3612: }
 3613: 
 3614: 
 3615: 
 3616: // Helper function that contains the core algorithm
 3617: template<typename XAccessor, typename YAccessor>
 3618: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3619:                                     double  yp_top, double  yp_bot, 
 3620:                                     CubicSpline &spline) {
 3621:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3622:    // 
 3623:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3624:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3625:    //
 3626:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3627:    // 
 3628:    // Inputs: 
 3629:    //            n: dimension for x etc; # of data pts (>=2);
 3630:    //            getX, getY: functions to access x,y coordinates
 3631:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3632:    //     Output: 
 3633:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3634: 
 3635:    const int n = k2 - k1 + 1;
 3636:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3637: 
 3638:    // Allocate memory for the splines
 3639:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3640:    spline.x   = new double[n];
 3641:    spline.y   = new double[n];
 3642:    spline.yp  = new double[n];
 3643:    spline.ypp = new double[n];
 3644: 
 3645:    for (int k=k1; k<=k2; k++) {
 3646:       spline.x[k] = getX(k);
 3647:       spline.y[k] = getY(k);
 3648:    }
 3649: 
 3650:    // This is to simplify expressions later
 3651:    double *x = spline.x;
 3652:    double *y = spline.y;
 3653: 
 3654:    double *a = nullptr;
 3655:    double *b = nullptr;
 3656:    double *c = nullptr;
 3657:    double *gam = nullptr;
 3658:    double *rhs = nullptr;
 3659:    
 3660: 
 3661:       a = new double[n];   // Lower diagonal
 3662:       b = new double[n];   // Diagonal
 3663:       c = new double[n];   // Upper diagonal
 3664:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3665:       rhs = new double[n]; // Right-hand side
 3666: 
 3667:    for (int k=k1; k<=k2; k++) {
 3668:       if (k == k1) {
 3669:          // Bottom level
 3670:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3671:          b[k] = (x[k+1] - x[k])/3.0;
 3672:          c[k] = b[k]/2.0;
 3673:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3674:       } else if (k == n - 1) {
 3675:          // Top level (surface)
 3676:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3677:          b[k] = (x[k] - x[k-1])/3.0;
 3678:          a[k] = b[k]/2.0;
 3679:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3680:       } else {
 3681:          // Intermediate levels
 3682:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3683:          b[k] = (x[k+1] - x[k-1])/3.0;
 3684:          a[k] = (x[k  ] - x[k-1])/6.0;
 3685:          c[k] = (x[k+1] - x[k  ])/6.0;
 3686:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3687:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3688:       }
 3689:    }
 3690: 
 3691:    // Solve the tridiagonal system
 3692:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3693:    
 3694:    spline.yp[k1] = yp_bot;
 3695:    spline.yp[k2] = yp_top;
 3696: 
 3697:    // Compute rest of 1st derivatives using the splines
 3698:    for (int k=k1+1; k<k2; k++) {
 3699:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3700:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3701:    }
 3702:    
 3703:    delete[] a;
 3704:    delete[] b;
 3705:    delete[] c;
 3706:    delete[] gam;
 3707:    delete[] rhs;
 3708: 
 3709: }
 3710: 
 3711: // Array version
 3712: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3713:                                 double y_top, double y_bot, 
 3714:                                 CubicSpline &spline) {
 3715:    auto getX = [x] (int k) { return x[k]; };
 3716:    auto getY = [y] (int k) { return y[k]; };
 3717:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3718: }
 3719: 
 3720: // Lambda version - allows custom access patterns
 3721: template<typename XFunc, typename YFunc>
 3722: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3723:                                 double y_top, double y_bot,
 3724:                                 CubicSpline &spline) {
 3725:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3726: }
