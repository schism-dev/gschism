 8413: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8414:    Element *elems = mesh->localElemData;
 8415: 
 8416:    *addr = elems;
 8417:    *sizeElement = sizeof(Element);
 8418:    switch (varCode) {
 8419:       case (int)VarCode::z:
 8420:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8421:          *sizeType = sizeof(double);
 8422:          break;
 8423:       case (int)VarCode::x:
 8424:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8425:          *sizeType = sizeof(Vector2);
 8426:          break;
 8427:       case (int)VarCode::gradETP:
 8428:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8429:          *sizeType = sizeof(Vector2);
 8430:          break;
 8431:       case (int)VarCode::area:
 8432:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8433:          *sizeType = sizeof(double);
 8434:          break;
 8435:       case (int)VarCode::depth:
 8436:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8437:          *sizeType = sizeof(double);
 8438:          break;
 8439:       case (int)VarCode::radius:
 8440:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8441:          *sizeType = sizeof(double);
 8442:          break;
 8443:       case (int)VarCode::ghat:
 8444:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8445:          *sizeType = sizeof(Vector2);
 8446:          break;
 8447:       case (int)VarCode::kb:
 8448:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8449:          *sizeType = sizeof(int);
 8450:          break;
 8451:       case (int)VarCode::isdry:
 8452:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8453:          *sizeType = sizeof(int);
 8454:          break;            
 8455:       case (int)VarCode::w:
 8456:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8457:          *sizeType = sizeof(double);
 8458:          break;
 8459:       case (int)VarCode::FaceIndices:
 8460:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8461:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8462:          *sizeType = sizeof(Node);
 8463:          break;
 8464:       default:
 8465:          *offset = -1;
 8466:    }
 8467: }
