 6359: #ifdef DONTCOMPILE
 6360: __device__ void computeVerticalAdvection(void) {
 6361:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6362: 
 6363:    sdbt(1:2,:,:)=0.d0
 6364: 
 6365:    const Side *side = FROM kernel;
 6366: 
 6367:    if(side->isDry) return;
 6368: 
 6369:    // If side is wet...
 6370: 
 6371: 
 6372:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6373:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6374:    double ws[nvrt] = {} // w @ side
 6375:    int icount = 0;
 6376:    for (int j=0; j<2; j++) {
 6377:       const Element *elem = side->elements[j];
 6378:        
 6379:       if(elem != nullptr) {
 6380:          icount++;
 6381:          for (int k=0; k<nvrt; k++) {
 6382:             ws[k] = ws[k] + elem->w[k];
 6383:          }
 6384:       }
 6385:    }  // for j
 6386: 
 6387:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6388:    ws = ws/icount;
 6389: 
 6390:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6391:    // Splines allow for a smooth transition between vertical levels.
 6392:    // Splines have continuity restrictions at the internal knots, but
 6393:    // we have to provide the 1st derivatives at the endpoints.
 6394:    const int kbs = side->kbs; 
 6395:    
 6396:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6397:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6398:    initCubicSpline(kbs, nvrt, side, ws, up)
 6399: 
 6400:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6401:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6402:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6403: 
 6404:    // Total advection (average onto side)
 6405:    const Node *node1 = side->nodes[0];
 6406:    const Node *node2 = side->nodes[1];
 6407:    for (int k=kbs(i); k<nvrt; k++) {
 6408: 
 6409:       if constexpr(ics==1) {
 6410:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6411:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6412:       } else {
 6413:          // XXX IMPLEMENT THIS
 6414:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6415:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6416:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6417:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6418:       }  // if ics
 6419: 
 6420: 
 6421:    }
 6422: }
 6423: #endif
 6424: 
 6425: 
 6426: extern "C" {
 6427:    __global__ void computeElemAverageGhat(void) {
 6428:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6429: 
 6430:       ELEM(elem);
 6431:       
 6432:       elem->ghat1= {0.0, 0.0};  
 6433: 
 6434:       if constexpr(ihydraulics != 0) {
 6435:          if (nhtblocks > 0 && elem->isblock) return;
 6436:       }
 6437: 
 6438:       if (elem->isDry) return;
 6439: 
 6440:       // Wet elements.
 6441:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6442:       // tidal potential, horizontal diffusion, and baroclinic etc
 6443:       // Remember to update both fb and F 
 6444:       // If ics=2, ghat1 are in eframe (ll)
 6445:       // cff1-3: coefficients for 2D/3D
 6446:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6447:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6448:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6449: 
 6450:       double av_cff1 = 0.0;  // av. for cff1
 6451:       double av_cff2 = 0.0;  // av. for cff2
 6452:       double av_cff3 = 0.0;  // av. for cff3
 6453:       double av_df = 0.0;  // av. for H^\alpha / H
 6454:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6455:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6456: 
 6457:       const int i34 = elem->i34;
 6458:       const int kb = elem->kb;
 6459: 
 6460:       for (int j=1; j<i34; j++) {
 6461:          // For each node and side in the element...
 6462: 
 6463:          const Node *node = elem->nodes[j];
 6464:          const Side *side = elem->sides[j];
 6465: 
 6466:          const double chi      = side->chi;
 6467:          const double veg_c2   = side->veg_c2;
 6468:          const double veg_beta = side->veg_beta;
 6469:          const double veg_h    = side->veg_h();
 6470:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6471: 
 6472:          // Node - const in elem
 6473:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6474:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6475: 
 6476:          if (elem->depth >= tip_dp) {
 6477:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6478:          }
 6479: 
 6480:          
 6481:          const double htot  = side->htot2();        // Total depth at the side
 6482:          const double zctr2 = side->zTopCanopy();  
 6483: 
 6484:          double cff1; 
 6485:          double cff2; 
 6486:          double cff3;   
 6487:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6488:          // coefficients applied to 2D/3D case 
 6489:             cff1 = side->hhat/htot;
 6490:             cff2 = 0.0;
 6491:             cff3 = 0.0;
 6492:          } else { //3D
 6493:             //Init for no-veg case
 6494:             cff1 = 1.0;
 6495:             cff2 = 1.0;
 6496:             cff3 = 0.0;
 6497: 
 6498:             if constexpr(iveg != 0) {
 6499:                // Computes coefficients used with vegetation terms G1, G2
 6500:                // cff1, cff3 are used for the first two terms in G1, G2:
 6501:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6502:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6503:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6504:                if(veg_h < 0.99*htot) { // submergent vegetation
 6505:                   cff1=1;
 6506:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6507:                   cff3 = veg_c;
 6508: 
 6509:                } else { // emergent vegetation
 6510:                   cff1 = 1.0/(1.0 + veg_c2);
 6511:                   cff2 = cff1;
 6512:                   cff3 = 0.0;
 6513: 
 6514:                }
 6515:             } // if iveg
 6516:          } //  2D/3D
 6517: 
 6518:          av_cff1 += cff1/i34;
 6519:          av_cff2 += cff2/i34;
 6520:          av_cff3 += cff3/i34;
 6521:          av_cff2_chi += cff2*chi/i34;
 6522:          av_cff3_chi += cff3*chi/i34;
 6523:          av_df += min(htot, veg_h)/(htot*i34);
 6524: 
 6525: 
 6526:          // btrack values: U^\star, U^{\star\alpha}
 6527:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6528:          Vector2 Ustar       = {0.0, 0.0}; 
 6529:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6530: 
 6531:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6532:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6533:          } else { //3D
 6534:             for (int k = side->kb; k < nvrt; k++) {
 6535:             
 6536:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6537:                Ustar += w2;
 6538: 
 6539:                if constexpr(iveg != 0) {
 6540:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6541:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6542:                        Ustar_alpha += zrat*w2; // XXXX
 6543:                    }
 6544:                }  // if iveg
 6545:             }  // for k
 6546:          }  //2D/3D
 6547:          
 6548: 
 6549:          // Add btrack & surface stress terms to \breve{G} first
 6550:          if constexpr(ics==1) {
 6551:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6552:          } else {
 6553:             // XXX IMPLEMENT THIS
 6554:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6555:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6556:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6557:          }  // if ics
 6558: 
 6559:          // Surface and bottom stress terms
 6560:          if constexpr(ics==1) {
 6561:             const Vector2 tau    = side->tau();
 6562:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6563: 
 6564:             // Term for surface and bottom stress
 6565:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6566:          } else {
 6567:             // XXX IMPLEMENT THIS
 6568:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6569:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6570:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6571:             // tau_x=(vn1+tt1)/2.d0
 6572:             // tau_y=(vn2+ss1)/2.d0
 6573:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6574:          }  // if ics
 6575: 
 6576:          
 6577: 
 6578:          // All terms in F,F^\alpha,f_b except baroclinic
 6579:          // F, f_b: all explicit terms excluding vegetation 
 6580:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6581:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6582:          const double coriolis = side->coriolis;
 6583:          Vector2 F  =  coriolis*side->U;  // F_x
 6584:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6585:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6586: 
 6587:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6588:             
 6589:             for (int k = side->kb; k < nvrt; k++) {
 6590:                if (zctr2 > side->zc[k-1]) {
 6591:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6592:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6593:                    Fa +=  coriolis*w2*zrat;
 6594:                } // if zctr2
 6595:             } // k
 6596:          } // iveg
 6597: 
 6598:          // Integrate horizontal viscosity force vertically
 6599:          for (int k=side->kb + 1; k<nvrt; k++) {
 6600:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 6601: 
 6602:             F += levelHorVisc;
 6603: 
 6604:             // Vegetation term
 6605:             if constexpr(iveg!=0) {
 6606:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6607:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6608:                   Fa += levelHorVisc*zrat;
 6609:                } 
 6610:             } // if iveg
 6611:          } // for k
 6612: 
 6613:          fb += side->d2uv[side->kb];
 6614: 
 6615: 
 6616:          // Add to ghat1
 6617:          if constexpr(ics==2) {
 6618:             // XXX IMPLEMENT THIS
 6619:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6620:             // bigf1=vn1; bigf2=vn2
 6621:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6622:             // botf1=vn1; botf2=vn2
 6623:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6624:             // bigfa1=vn1; bigfa2=vn2
 6625:          } // if ics
 6626: 
 6627:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6628:       } // for j (nodes and sides)
 6629: 
 6630:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6631:          
 6632:       // Finish off terms in F, F^\alpha and f_b
 6633:       const double grav3 = elem->mean(&Node::grav2);
 6634:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6635: 
 6636: 
 6637:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6638:       for (int j=1; j<i34; j++) { 
 6639:          // For each side in the element...
 6640:          const Side *side = elem->sides[j];
 6641:          const double chi = side->chi;
 6642: 
 6643:          const double htot = side->htot2();
 6644:          const double veg_h = side->veg_h();
 6645:          const Vector2 F  = htot*fb;
 6646:          const Vector2 Fa = min(htot, veg_h)*fb;
 6647: 
 6648:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6649:       } // for j
 6650: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6651:       //botf1 etc are already in elem frame
 6652:       elem->ghat1 += tmp/i34;
 6653: 
 6654:       // Baroclinic force
 6655:       if constexpr(ibc==0) {
 6656:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6657: 
 6658:          Vector2 Fa = {0.0, 0.0};
 6659:          Vector2 intGradRho = {0.0, 0.0};
 6660:          
 6661:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6662:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6663:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6664: 
 6665:             // \in F [m^2/s/s]
 6666:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6667:          }
 6668: 
 6669:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6670:          const Vector2 F = av_df*Fa; //approx
 6671:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6672: 
 6673:       } // if ibc
 6674: 
 6675: 
 6676: 
 6677:    }
 6678: 
 6679: } // extern "C"
 6680: 
 6681: 
 6682: 
 6683: #ifdef DONTCOMPILE
 6684: __global__ void checkMassConservation(Tracers* sumtr) {
 6685: 
 6686:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6687: 
 6688:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6689: 
 6690:    Element *elem = &(mesh->localElemData[i]);
 6691: 
 6692:    // Skip dry elements
 6693:    if (elem->isDry) return;
 6694: 
 6695:    // Local sum array for this thread
 6696:    double localSum[N_TRACERS] = {0.0};
 6697: 
 6698:    // Sum over vertical levels for this element
 6699:    const int kbe = elem->kbe;
 6700:    const double area = elem->area;
 6701: 
 6702:    for (int k = kbe; k < nvrt; k++) {
 6703:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6704:       
 6705:       // Accumulate tracer mass
 6706:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6707:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6708:       }
 6709:    }
 6710: 
 6711:    
 6712: 
 6713:    //  This function returns per element sums. A reduction must be done on the host side.
 6714: }
 6715: 
 6716: 
 6717: __global__ void transport(void) {
 6718: 
 6719:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6720: 
 6721:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6722: 
 6723:    Element *elem = &(mesh->localElemData[ie]);
 6724: 
 6725:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6726: 
 6727:                for (int m=0; m<ntr; m++) {
 6728:                   for (int k=kbe(ie); k<nvrt; k++) {
 6729:                      // Calculate each polynomial's weight 
 6730:                      wm=0.d0; sum1=0.d0; 
 6731:                      wm1=0.d0; wm2=0.d0; 
 6732:                      for (int i=0; i<elem->nweno2; i++) {
 6733:                   
 6734:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6735:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6736:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6737:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6738:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6739:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6740:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6741:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6742:                      // -----------------Hu and Shu (1999)'s method----------------
 6743:                      b4=b1+b2+b3
 6744: 
 6745: //Error: add PRODUCTION CPP
 6746: #ifdef DEBUG
 6747:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6748:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6749:                     call parallel_abort(errmsg)
 6750:                   }
 6751: #endif
 6752: 
 6753:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6754:                   // !----test-------------- 
 6755:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6756:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6757:                   // !wm(i)=wm1(i)*wm2(i)
 6758:                   // !---------------------- 
 6759:                   sum1=sum1+wm(i)
 6760:                 } // end for i
 6761: 
 6762:                 wm=wm/sum1
 6763: 
 6764:                 for (int j=0; j<elem->i34; j++) {
 6765: 
 6766:                   const Side *side  = elem->sides[j];
 6767:                   const Node *node1 = side->n1;
 6768:                   const Node *node2 = side->n2;
 6769: 
 6770:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6771:                      trsd=0.d0
 6772:                      for (int kk=0; kk<nquad; kk++) {
 6773:                         for (int i=0; i<elem->nweno2; i++) {
 6774:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6775:                         } // end for i   
 6776:                      } // end for kk
 6777:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6778:                   } // outward flux
 6779:                } // end for j=1,i34(ie) ! side
 6780:             }
 6781:          }
 6782:               
 6783: 
 6784: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6785: //             //   calculate each polynomial's weight 
 6786: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6787: //                 wm=0.d0; sum1=0.d0
 6788: //                 do i=1,nweno1(ie) !for each polynomial
 6789: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6790: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6791: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6792: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6793: //                   wm(i)=b2
 6794: //                   sum1=sum1+b2
 6795: //                   !wm(i)=1.d0
 6796: //                   !sum1=sum1+1.d0
