 6797: //               endif
 6798: 
 6799: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 6800: //               do j=1,i34(i)
 6801: //                 jsj=elside(j,i) !side
 6802: //                 iweno=.true. !use weno reconstruction as default
