 4388: 
 4389: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4390:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4391:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4392: 
 4393: 
 4394:    NODE(node1);
 4395: 
 4396:    node1->clearMatrixRow();
 4397:    node1->qel = 0.0;
 4398: 
 4399:    // THIS IS FOR STRUCTURES XXX
 4400:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4401: 
 4402:    
 4403:    for (int j=0; j<node1->numElements; j++) {
 4404:       // For each element connected to the node...
 4405: 
 4406:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4407: 
 4408:       Element *elem = node1->elements[j];
 4409: 
 4410:       // Compute the average gravity
 4411:       const double grav3 = elem->mean(&Node::grav2);
 4412: 
 4413:       // Look at the documentation for the description of the terms in the following integrals
 4414: 
 4415:       // Integral I_1 
 4416:       // \bar{\breve{H}} 
 4417:       const double hhatb = elem->mean(&Side::hhat);        
 4418: 
 4419:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4420: 
 4421:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4422:       const double area = elem->area;
 4423: 
 4424:       // Integral I_4
 4425:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4426:       // Where
 4427:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4428: 
 4429:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4430:       // of U over the element.
 4431:       const Vector2 U = elem->mean(&Side::U);
 4432: 
 4433:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4434: 
 4435:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4436:       const double I_4_1 = dot(gradPhi_1, U);
 4437: 
 4438: 
 4439:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4440:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4441: 
 4442:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4443: 
 4444:       // Additional terms 
 4445:       double vnorm = 0.0;
 4446:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4447:          Vector3 ubed = {0.0, 0.0, 0.0};
 4448:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4449:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4450: 
 4451:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4452:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4453:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4454: 
 4455:          // Computes the normal component of the bed velocity
 4456:          vnorm = dot(ubed, N);
 4457:       } // imm==2
 4458: 
 4459:          
 4460: 
 4461:       if (elem->isTri()) {
 4462: 
 4463:          // To clarify the notation in this section: 
 4464:          //   In formulas, we use the following notation:
 4465:          //       i stands for the node under consideration (node1)
 4466:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4467:          //   However, in the code, we use the following notation:
 4468:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4469:          const int id2 = elem->nxq(1 + id1);
 4470:          const int id3 = elem->nxq(2 + id1);
 4471:          Node *node2 = elem->nodes[id2];
 4472:          Node *node3 = elem->nodes[id3];
 4473: 
 4474:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4475: 
 4476:          // integral of phi_i*phi_j
 4477:          const double ipp_ii = (1.0/6.0 )*area;
 4478:          const double ipp_ij = (1.0/12.0)*area;
 4479:          const double ipp_ik = (1.0/12.0)*area;
 4480: 
 4481:          // integral of [(grad phi_i) * (grad phi_j)]
 4482:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4483:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4484:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4485: 
 4486:          // Computes the different components of integral I_1 of each node with respect to node i.
 4487:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4488:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4489:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4490: 
 4491:          node1->addToSparseMatrix(node1, I1_ii);
 4492:          node1->addToSparseMatrix(node2, I1_ij); 
 4493:          node1->addToSparseMatrix(node3, I1_ik);
 4494: 
 4495:          #pragma unroll
 4496:          for (int l=0; l<3; l++) {
 4497: 
 4498:             Node *node = elem->nodes[l];
 4499: 
 4500:             // Additional variation in eta due to bed deformation or vertical velocity
 4501:             double extraEta = 0.0;
 4502:             if      constexpr(imm == 2) extraEta = dt*vnorm;
 4503:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4504: 
 4505: 
 4506:             node1->qel += elem->intPhiPhiTri(l, j)*(node->eta2 + extraEta);
 4507:            
 4508:          }
 4509: 
 4510: 
 4511:          if (!elem->isDry) {
 4512:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4513: 
 4514:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4515: 
 4516:          }
 4517: 
 4518:             // const double ipp   = elem->intPhiPhiTri(id1, l);
 4519:             // const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4520: 
 4521:             // node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4522: 
 4523:       }
 4524:       else { // Quad
 4525:          // To clarify the notation in this section: 
 4526:          //   In formulas, we use the following notation:
 4527:          //       i stands for the node under consideration (node1)
 4528:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4529:          //   However, in the code, we use the following notation:
 4530:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4531:          const int id2 = elem->nxq(1 + id1);
 4532:          const int id3 = elem->nxq(2 + id1);
 4533:          const int id4 = elem->nxq(3 + id1);
 4534:          Node *node2 = elem->nodes[id2];
 4535:          Node *node3 = elem->nodes[id3];
 4536:          Node *node4 = elem->nodes[id4];   
 4537:          
 4538:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, id1);
 4539: 
 4540:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4541:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4542:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4543:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4544:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4545: 
 4546:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4547:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4548:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4549:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4550:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4551: 
 4552:          // Computes the different components of integral I_1 of each node with respect to node i.
 4553:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4554:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4555:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4556:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4557: 
 4558:          node1->addToSparseMatrix(node1, I1_ii);
 4559:          node1->addToSparseMatrix(node2, I1_ij); 
 4560:          node1->addToSparseMatrix(node3, I1_ik);
 4561:          node1->addToSparseMatrix(node4, I1_il);
 4562:   
 4563:          #pragma unroll
 4564:          for (int l=0; l<4; l++) {
 4565: 
 4566:             const Node *node = elem->nodes[l];
 4567: 
 4568:             // Additional variation in eta due to bed deformation or vertical velocity
 4569:             double extraEta = 0.0;
 4570:             if      constexpr(imm == 2) extraEta = dt*vnorm;
 4571:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4572: 
 4573:             const double ipp = elem->intPhiPhiQuad(l, j, x0, x1, x2, x3);
 4574:             const double igpgp = elem->intGradPhiGradPhiQuad(l, j, x0, x1, x2, x3);
 4575:             node1->qel += (node->eta2 + extraEta)*ipp - 
 4576:                            node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*igpgp;
 4577: 
 4578:          }         
 4579:       } 
 4580: 
 4581: 
 4582:      node1->qel += (dt/elem->i34)*elem->vsource;
 4583:       
 4584: 
 4585:    } // for all elements connected to the node
 4586:    
 4587: 
 4588:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4589:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4590:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4591:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4592:       // If it is an open boundary node...
 4593: 
 4594:       // At least one open bnd side, maybe two
 4595:       for (int l=0; l<2; l++) { 
 4596: 
 4597:          // Gets each of the sides sharing the node. 
 4598:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4599: 
 4600:        
 4601: 
 4602:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4603:          if (sideBnd != nullptr) {
 4604:             // If the side is on a boundary...
 4605: 
 4606:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4607: 
 4608:             // Get the boundary segment
 4609:             const BoundarySegment *sideSegment = sideBnd->segment;
 4610:             const Side *side = sideBnd->side;
 4611: 
 4612:             // Integral I_3
 4613:             if (sideSegment->ifltype != 0) {
 4614:             // Natural or Flather b.c.
 4615: 
 4616:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4617:                // especially for Flather b.c.
 4618:                double ri3 = 0.0;
 4619:                if (!side->isDry) {
 4620:                   // If the side is not dry
 4621:                   
 4622:                   // Computes the side flux of (uth, vth)
 4623:                   double Vn = 0.0;
 4624:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4625:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4626:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4627: 
 4628:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4629:                   }
 4630: 
 4631:                   ri3 = 0.5*side->len*Vn;
 4632:                }
 4633: 
 4634:                if (sideSegment->ifltype == -1) { // Flather 1
 4635: 
 4636:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4637:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4638: 
 4639:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4640:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4641:                   
 4642:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4643:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4644: 
 4645:                } 
 4646:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4647:                   // Reset ri3
 4648:                   ri3 = 0.0;
 4649: 
 4650:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4651:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4652: 
 4653:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4654: 
 4655:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4656:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4657: 
 4658:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4659:                   node1->addToSparseMatrix(node1, con0*2.0);
 4660:                   node1->addToSparseMatrix(node2, con0);
 4661: 
 4662:                } // if Flather or Discharge
 4663: 
 4664:                node1->qel -= thetai*dt*ri3;  
 4665: 
 4666: 
 4667:             } // I_3
 4668:           
 4669: 
 4670:             // Integral I_5
 4671:             if(!side->isDry) {
 4672: 
 4673:                const double Unbar = dot(side->U, side->n);
 4674:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4675: 
 4676:             } // I_5
 4677: 
 4678:          } // if is boundary side
 4679: 
 4680:       } // for l
 4681: 
 4682:    } // if isbnd
 4683: 
 4684: 
 4685: }
 4686: 
 4687: 
 4688: 
 4689: extern "C" {
 4690:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4691:                                   int* indices, int* indptr) {
 4692: 
 4693:       NODE(node);
 4694:       
 4695:       const int idx = node->idx;
 4696:       
 4697:       // Computes the index in the nzz array      
 4698:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4699: 
 4700: 
 4701:       indptr[idx] = nzzIdx;
 4702:       indices[nzzIdx] = idx;
 4703: 
 4704:       data_d[nzzIdx]    = node->coeffDiag;
 4705: 
 4706:       b_d[idx] = node->qel;
 4707: 
 4708:       for (int k = 0; k < node->numNodes; ++k) {
 4709:          const Node* nb = node->nodes[k];
 4710: 
 4711:          const int j = nb->idx;
 4712: 
 4713:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4714: 
 4715:          indices[nzzIdx + k + 1] = j;
 4716:       }
 4717: 
 4718:  
 4719:    }
 4720: 
 4721: 
 4722: 
 4723:    __global__ void solverCopyResult(double* x) {
 4724:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4725:       NODE(node);
 4726:       const int idx = node->idx;
 4727: 
 4728:       node->mX = x[idx];
 4729:    }
 4730: 
 4731: 
 4732:    __global__ void rollUpElevation(void) {
 4733: 
 4734:       NODE(node);
 4735: 
 4736:       node->eta1 = node->eta2;
 4737: 
 4738:    }
 4739: 
 4740: 
 4741:    __global__ void backtrackAllNodes(void) {
 4742: 
 4743:       // max/min # of sub-divisions
 4744:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4745:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4746: 
 4747:       SIDE(side);
 4748: 
 4749:       const int kb = side->kb;
 4750: 
 4751: 
 4752:       // Initialize btrack velocities to the actual velocities at the side 
 4753:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4754:   
 4755:       if (side->isDry) return;
 4756:      
 4757: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4758: 
 4759:       // Checks that at least one element is not dry
 4760:       const Element *elem1 = side->elems[0];
 4761:       const Element *elem2 = side->elems[1];
 4762: 
 4763: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4764: 
 4765:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4766:       
 4767:       // XXXXXX
 4768:       // !swild_tmp to store global coord. of the starting side
 4769:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4770:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4771:       // !Use sframe2 
 4772:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4773: 
 4774: 
 4775:       for (int k = kb; k < nvrt; k++) {
 4776:       //  Initialize (xt,yt,zt), nnel and vel.
 4777:       //  For ics=2, the coordinates are all in the side's local frame
 4778:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4779: 
 4780:          const int iadvf = side->iadv();  // Advection flag   
 4781:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4782: 
 4783:          const double vmag2 = norm2(side->u2[k]);
 4784: 
 4785:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4786:             // No activity 
 4787: 
 4788:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4789: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4790: 
 4791:             
 4792:          } else {  // do btrack
 4793: 
 4794:             // Compute number of sub-divisions based on local gradients of the velocity field
 4795: 
 4796:             // XXX IS THIS NECESSARY?
 4797:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4798:             double suma = 0.0;
 4799:             int icount = 0;
 4800:             for (int l=0; l<2; l++) {
 4801:             // For each element sharing the side...
 4802: 
 4803:                const Element *elem = side->elems[l];
 4804:                  
 4805:                if (elem == nullptr) continue;
 4806: 
 4807:                icount++;
 4808: 
 4809:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4810:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4811:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4812: 
 4813:                double utmp[4];
 4814:                double vtmp[4];
 4815:                for (int j = 0; j < elem->i34; j++) {
 4816: 
 4817:                   const Node *node = elem->nodes[j];
 4818: 
 4819:                   if constexpr(ics==1) {
 4820:                      utmp[j] = node->u2[k].x;
 4821:                      vtmp[j] = node->u2[k].y;  
 4822: 
 4823:                   } else {
 4824:                      // 'Project' the velocity from the node frame to the element frame
 4825:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4826:                      utmp[j] = tmp_u2.x;
 4827:                      vtmp[j] = tmp_u2.y;
 4828: 
 4829:                   }
 4830:                } // for j
 4831: 
 4832:                const Vector2 grad_u = elem->grad2(utmp); 
 4833:                const Vector2 grad_v = elem->grad2(vtmp);
 4834:    
 4835:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4836:             } // for ii
 4837: 
 4838:             assert(icount > 0 && "Impossible 77");
 4839: 
 4840:             // '4' is somewhat arbitrary
 4841:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4842: 
 4843:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4844:             Vector3 u_int = {0.0, 0.0, 0.0};
 4845: 
 4846:             side->btrack(k, dt, dtbk, u_int);
 4847: 
 4848: 
 4849:             side->btu[k] = {u_int.x, u_int.y};
 4850:                
 4851:          } // if vmag (do backtrack)
 4852: 
 4853: 
 4854:       } // for k=kb,nvrt-1
 4855: 
 4856:    }
 4857: 
 4858: } // extern "C"
 4859: 
 4860: template<int nc>
 4861: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4862: 
 4863: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4864: //
 4865: // a,b,c,rhs: input vectors and are not modified by this program.
 4866: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4867: // rhs is the r.h.s.
 4868: // n: actual rank of the system.
 4869: // rows in u() and rhs();
 4870: // u: output with nc columns (transposed to rows)
 4871: // gam: a working array.
 4872: //
 4873: // NOTES:
 4874: // This is a template function that allows for different numbers of columns in the rhs vector.
 4875: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4876: 
 4877:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4878:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4879: 
 4880:    double bet = b[0];
 4881:    if constexpr (nc == 1) {
 4882:       u[0] = rhs[0]/bet;
 4883:    } else {
 4884:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4885:    }
 4886: 
 4887:    for (int j = 1; j < n; j++) {
 4888:       gam[j] = c[j - 1]/bet;
 4889:       bet = b[j] - a[j]*gam[j];
 4890: 
 4891:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4892: 
 4893:       if constexpr (nc == 1) {
 4894:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4895:       } else {
 4896:          for (int l = 0; l < nc; l++) {
 4897:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4898:          }
 4899:       }
 4900:    }
 4901: 
 4902:    // Back-substitution
 4903:    for (int j = n - 2; j >= 0; j--) {
 4904:       if constexpr (nc == 1) {
 4905:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4906:       } else {
 4907:          for (int l = 0; l < nc; l++) {
 4908:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4909:          }
 4910:       }
 4911:    }
 4912: }
 4913: 
 4914: 
 4915: 
 4916: // Helper function that contains the core algorithm
 4917: template<typename XAccessor, typename YAccessor>
 4918: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4919:                                     double  yp_top, double  yp_bot, 
 4920:                                     CubicSpline &spline) {
 4921:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4922:    // 
 4923:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4924:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4925:    //
 4926:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4927:    // 
 4928:    // Inputs: 
 4929:    //            n: dimension for x etc; # of data pts (>=2);
 4930:    //            getX, getY: functions to access x,y coordinates
 4931:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4932:    //     Output: 
 4933:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4934: 
 4935:    const int n = k2 - k1 + 1;
 4936:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4937: 
 4938:    // Allocate memory for the splines
 4939:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4940:    spline.x   = new double[n];
 4941:    spline.y   = new double[n];
 4942:    spline.yp  = new double[n];
 4943:    spline.ypp = new double[n];
 4944: 
 4945:    for (int k=k1; k<=k2; k++) {
 4946:       spline.x[k] = getX(k);
 4947:       spline.y[k] = getY(k);
 4948:    }
 4949: 
 4950:    // This is to simplify expressions later
 4951:    double *x = spline.x;
 4952:    double *y = spline.y;
 4953: 
 4954:    double *a = nullptr;
 4955:    double *b = nullptr;
 4956:    double *c = nullptr;
 4957:    double *gam = nullptr;
 4958:    double *rhs = nullptr;
 4959:    
 4960: 
 4961:       a = new double[n];   // Lower diagonal
 4962:       b = new double[n];   // Diagonal
 4963:       c = new double[n];   // Upper diagonal
 4964:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4965:       rhs = new double[n]; // Right-hand side
 4966: 
 4967:    for (int k=k1; k<=k2; k++) {
 4968:       if (k == k1) {
 4969:          // Bottom level
 4970:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4971:          b[k] = (x[k+1] - x[k])/3.0;
 4972:          c[k] = b[k]/2.0;
 4973:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4974:       } else if (k == n - 1) {
 4975:          // Top level (surface)
 4976:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4977:          b[k] = (x[k] - x[k-1])/3.0;
 4978:          a[k] = b[k]/2.0;
 4979:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4980:       } else {
 4981:          // Intermediate levels
 4982:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4983:          b[k] = (x[k+1] - x[k-1])/3.0;
 4984:          a[k] = (x[k  ] - x[k-1])/6.0;
 4985:          c[k] = (x[k+1] - x[k  ])/6.0;
 4986:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4987:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4988:       }
 4989:    }
 4990: 
 4991:    // Solve the tridiagonal system
 4992:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4993:    
 4994:    spline.yp[k1] = yp_bot;
 4995:    spline.yp[k2] = yp_top;
 4996: 
 4997:    // Compute rest of 1st derivatives using the splines
 4998:    for (int k=k1+1; k<k2; k++) {
 4999:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5000:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5001:    }
 5002:    
 5003:    delete[] a;
 5004:    delete[] b;
 5005:    delete[] c;
 5006:    delete[] gam;
 5007:    delete[] rhs;
 5008: 
 5009: }
 5010: 
 5011: // Array version
 5012: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5013:                                 double y_top, double y_bot, 
 5014:                                 CubicSpline &spline) {
 5015:    auto getX = [x] (int k) { return x[k]; };
 5016:    auto getY = [y] (int k) { return y[k]; };
 5017:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5018: }
 5019: 
 5020: // Lambda version - allows custom access patterns
 5021: template<typename XFunc, typename YFunc>
 5022: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5023:                                 double y_top, double y_bot,
 5024:                                 CubicSpline &spline) {
 5025:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5026: }
