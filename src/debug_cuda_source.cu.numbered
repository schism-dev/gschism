 4971: 
 4972: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4973:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4974:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4975:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4976: }
 4977: 
 4978: 
 4979: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4980:    // Brunt-Väisälä frequency at level k.
 4981:    if (k <= node->kb || k >= ivrt) return 0.0;
 4982:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4983: }
 4984: 
 4985: 
 4986: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4987: 
 4988:    
 4989:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4990:    // k is the layer bottom index.
 4991: 
 4992: 
 4993: 
 4994:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4995: 
 4996:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4997:       const double eta2 = node->eta2;
 4998:       const double depth = node->depth;
 4999: 
 5000:       // Distances from the layer midpoint to the surface and bottom
 5001:       const double dist_s = eta2 - z_c;
 5002:       const double dist_b = z_c + depth;
 5003: 
 5004:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 5005: 
 5006:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 5007: 
 5008: 
 5009:    } else {
 5010:       return 1.0; // Other GLS submodels
 5011: 
 5012:    }
 5013: }
 5014: 
 5015: 
 5016: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 5017:    // Minimum mixing length for levels below the surface.
 5018:    // Independent of psimin(); do not invert one to get the other.
 5019:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 5020: }
 5021: 
 5022: 
 5023: __device__ void Turbulence<TurbulenceModel::GLS>::init(Node *node) {
 5024:    // Whole column, including levels below kb. Matches the Fortran cold start.
 5025:    for (int k = 0; k < nvrt; k++) {
 5026:       tke[k]    = tkemin();
 5027:       mxl[k]    = mxlmin(node->depth);
 5028:       nu_tke[k] = diffmin;
 5029:       nu_phi[k] = diffmin;
 5030: 
 5031:       node->dfv[k] = 0.0;
 5032:       node->dfh[k] = 0.0;
 5033:    }
 5034: }
 5035: 
 5036: 
 5037: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 5038: 
 5039:    // Returns the turbulence production due to vegetation averaged over the current layer.
 5040: 
 5041:    if constexpr(iveg == 1) {
 5042:       
 5043:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 5044:       const double zTopCanopy = node->zTopCanopy();
 5045: 
 5046:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 5047: 
 5048:          const double ztop = node->z[k];   // Top of the current layer.
 5049: 
 5050:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 5051:          // Where 1 means that the current level is fully within the vegetation layer.
 5052:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 5053: 
 5054:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 5055:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 5056: 
 5057:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 5058:          // and at the bottom of the layer.
 5059:          const double vmag_top = length(ub2_top);
 5060:          const double vmag_bot = length(node->u2[k-1]);
 5061: 
 5062:          // Volume-averaged velocity cubed.
 5063:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 5064: 
 5065:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 5066:          // and at the bottom of the layer.
 5067:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 5068:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 5069: 
 5070:          // Volume-averaged vegetation alpha cubed.
 5071:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 5072: 
 5073:          return veg_alpha3D*vmag3;
 5074:       } 
 5075:       else {
 5076:          // The current level is not within the vegetation layer, so the production is 0.
 5077:          return 0.0;
 5078:       }
 5079:    } else {
 5080: 
 5081:       // If no vegetation, the production is 0.
 5082:       return 0.0;
 5083:    }
 5084: 
 5085: }
 5086: 
 5087: 
 5088: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 5089:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 5090:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 5091: 
 5092:    const int kb = node->kb;
 5093: 
 5094:    for (int k = kb; k < nvrt; k++) {
 5095:       const double tke = this->tke[k];
 5096:       const double mxl = this->mxl[k];
 5097:       const double u = sqrt(tke);  // Characteristic velocity
 5098:       const double lu = mxl*u;     // Characteristic diffusivity 
 5099: 
 5100:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 5101:       double drho_dz = 0.0;
 5102:       if (k > kb && k < ivrt) {
 5103:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 5104:       }
 5105: 
 5106:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 5107: 
 5108:       // Tsinghua group       
 5109:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 5110: 
 5111:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 5112:       if constexpr (stabilityModel == Galperin) {
 5113:          sh = 0.49393/(1.0-34.676*Gh);
 5114:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 5115:          cmiu  = sqrt(2.0)*sm;
 5116:          cmiup = sqrt(2.0)*sh;
 5117:          cmiu1 = sqrt(2.0)*0.2;
 5118:          cmiu2 = sqrt(2.0)*0.2;
 5119: 
 5120:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 5121:          // Warner's paper has problem
 5122:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 5123:          const double Ghp = Gh;  /// XXXXX needed?
 5124:          sh = 0.4939/(1.0 - 30.19*Ghp);
 5125:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 5126:          cmiu  = sqrt(2.0)*sm;
 5127:          cmiup = sqrt(2.0)*sh;
 5128:          cmiu1 = cmiu/schk();
 5129:          cmiu2 = cmiu/schpsi();
 5130: 
 5131:       } else {
 5132:          assert(false && "Unknown ASM");
 5133: 
 5134:       }
 5135: 
 5136:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 5137:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 5138:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 5139:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 5140:    }
 5141: }
 5142: 
 5143: 
 5144: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 5145: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 5146: 
 5147:    const double z = node->z[k];
 5148:    const double eta2 = node->eta2;
 5149:    const double depth = node->depth;
 5150: 
 5151:    // Distances to the surface and bottom
 5152:    const double dist_s = eta2 - z;
 5153:    const double dist_b = z + depth;
 5154: 
 5155:    // Distance to the closest "wall" (either surface or bottom).  
 5156:    // In the top layer, it is the size of the layer.
 5157:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 5158:    assert(min_dist > 0.0 && "Invalid minimum distance");
 5159: 
 5160:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 5161:    return kappa*min_dist;
 5162: }
 5163: 
 5164: 
 5165: 
 5166: template<TurbulenceModel turbulenceModel>
 5167: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 5168: 
 5169: 
 5170: template<>
 5171: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 5172:    // Constant turbulence model
 5173:    // Does nothing since dfv and dfh are already set  in the initialization.
 5174: }
 5175: 
 5176: template<>
 5177: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 5178:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 5179: 
 5180:    // Solves the following PDEs:
 5181:    //
 5182:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 5183:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 5184:    //
 5185:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 5186:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 5187:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 5188:    //
 5189:    // The equations are solved using a linear *vertical* FEM formulation.
 5190:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 5191:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 5192:    
 5193:    
 5194:    // Get the turbulence model
 5195:    // reinterpret_cast is used to avoid stupid compiler errors.
 5196:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 5197:      
 5198:    const int kb = node->kb;
 5199:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 5200: 
 5201:    double alow_tke[nvrt], alow_phi[nvrt];
 5202:    double bdia_tke[nvrt], bdia_phi[nvrt];
 5203:    double cupp_tke[nvrt], cupp_phi[nvrt];
 5204:    double rhs_tke [nvrt], rhs_phi [nvrt];
 5205:    
 5206:    // Initialize the tridiagonal system
 5207:    for (int kin = 0; kin < nqrows; kin++) {
 5208:       alow_tke[kin]=0.0;
 5209:       bdia_tke[kin]=0.0;
 5210:       cupp_tke[kin]=0.0;
 5211:       rhs_tke [kin]=0.0; 
 5212:       alow_phi[kin]=0.0;
 5213:       bdia_phi[kin]=0.0;
 5214:       cupp_phi[kin]=0.0;
 5215:       rhs_phi [kin]=0.0; 
 5216:    }
 5217: 
 5218: 
 5219: 
 5220:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 5221:    if (node->isDry || node->is2D()) {
 5222: 
 5223:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 5224:       const double diffmin = turb.diffmin;
 5225: 
 5226:       for (int k = 0; k < nvrt; k++) {
 5227:          turb.tke[k]    = turb.tkemin();
 5228:          turb.mxl[k]    = turb.mxlmin(node->depth);
 5229:          node->dfv[k]   = diffmin;
 5230:          node->dfh[k]   = diffmin;
 5231:          turb.nu_tke[k] = diffmin;
 5232:          turb.nu_phi[k] = diffmin;
 5233:       }
 5234: 
 5235:       return;
 5236:    }
 5237: 
 5238:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 5239:    
 5240:    // After here we know that the node is wet and has at least 2 layers.
 5241: 
 5242:    double solution[nvrt], gam[nvrt];
 5243:    
 5244:    const double eta2       = node->eta2;
 5245:    const double depth      = node->depth;
 5246:    const double Cd         = node->Cd; // Drag coefficient
 5247: 
 5248:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 5249:    
 5250:    const double sqU2 = norm2(node->u2[kb + 1]);
 5251:    const double modTau = length(node->tau);
 5252: 
 5253:  
 5254: 
 5255:    const double cpsi1 = turb.cpsi1();
 5256:    const double cpsi2 = turb.cpsi2();
 5257:    // cpsi3 is computed later because it depends on k
 5258: 
 5259: 
 5260:    // Assemble the tridiagonal system
 5261:    // -------------------------------
 5262: 
 5263:    // Loop over each vertical layer (interval between two vertical levels)
 5264:    // Each interval is an element of the vertical FEM formulation.
 5265:    // Two shape functions are defined over each interval. In this function we well call them
 5266:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5267:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5268:    //
 5269:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5270:    // Both systems of equations are assembled in the same loop.
 5271:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5272: 
 5273:       // Indices for the *rows* of the tridiagonal system.
 5274:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5275:       const int k2 = k - kb;     // One at k = kb + 1
 5276: 
 5277:       // Get the properties of the current interval.
 5278:       const double z  = node->z[k]; // bottom level of the interval
 5279:       const double dz = node->Dz(k + 1);
 5280:       
 5281:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5282: 
 5283:       // Turbulence production/dissipation terms (at the center of the interval).
 5284:       
 5285:       const double M2 = norm2(du_dz_c);              // Shear production term
 5286: 
 5287:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5288: 
 5289:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5290: 
 5291:       const double cpsi3 = turb.cpsi3(N2); 
 5292: 
 5293: 
 5294:       // Turbulence quantities at half levels (cell [c]enter)
 5295:       const double tke_1     = turb.tke[k];
 5296:       const double tke_2     = turb.tke[k+1];
 5297:       const double mxl_1     = turb.mxl[k];
 5298:       const double mxl_2     = turb.mxl[k+1];
 5299:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5300:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5301:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5302:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5303:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5304:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5305:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5306: 
 5307:       // Integral of the shape function products:
 5308:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5309:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5310:       const double p1p1 = dz/3.0;
 5311:       const double p1p2 = dz/6.0;
 5312:       const double d1d1 =  1.0/dz;
 5313:       const double d1d2 = -1.0/dz;
 5314: 
 5315:       // Production/dissipation related terms
 5316:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5317:       const double buoy = dfh_c*N2;
 5318:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5319: 
 5320: 
 5321: 
 5322:       // Equation for tke
 5323:       // ---------------
 5324: 
 5325:       // First row (of the two rows that the interval contributes to)
 5326:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5327:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5328:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5329: 
 5330: 
 5331:       if(prod + buoy >= 0.0) { // Net production
 5332:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5333:       } else { // Net dissipation
 5334:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5335:          bdia_tke[k1] -= 2.0*tmp;
 5336:          cupp_tke[k1] -= tmp;
 5337:       }      
 5338:       
 5339:       bdia_tke[k1] += 2.0*dt*diss;
 5340:       cupp_tke[k1] += dt*diss;
 5341:       
 5342:   
 5343:       // Second row (of the two rows that the interval contributes to)
 5344:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5345:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5346:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5347: 
 5348:       if (prod + buoy >= 0.0) { // Net production
 5349:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5350:       } else { // Net dissipation
 5351:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5352:          bdia_tke[k2] -= 2.0*tmp;
 5353:          alow_tke[k2] -= tmp;
 5354:       }
 5355:       
 5356:       bdia_tke[k2] += 2.0*dt*diss;
 5357:       alow_tke[k2] += dt*diss;
 5358: 
 5359: 
 5360:       // Equation for xl
 5361:       // ---------------
 5362: 
 5363:       const double rpub = turb.rpub();
 5364:       const double rmub = turb.rmub();
 5365:       const double rnub = turb.rnub();
 5366:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5367:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5368:       const double psi_c = 0.5*(psi_1 + psi_2);
 5369: 
 5370:       // Production/dissipation related terms
 5371:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5372:       const double buoy_phi = cpsi3*dfh_c*N2;
 5373:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5374: 
 5375:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5376:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5377:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5378: 
 5379:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5380:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5381:       } else { // Net dissipation
 5382:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5383:          bdia_phi[k1] -= 2.0*tmp;
 5384:          cupp_phi[k1] -= tmp;
 5385:       }
 5386: 
 5387:       // Production/dissipation terms
 5388:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5389:       cupp_phi[k1] += dt*diss_phi;
 5390:  
 5391: 
 5392:       // row k2 (upper)
 5393:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5394:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5395:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5396: 
 5397:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5398:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5399:       } else { // Net dissipation
 5400:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5401:          bdia_phi[k2] -= 2.0*tmp;
 5402:          alow_phi[k2] -= tmp;
 5403:       }
 5404: 
 5405:       // Production/dissipation terms
 5406:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5407:       alow_phi[k2] += dt*diss_phi;
 5408: 
 5409:    }
 5410: 
 5411:    // BC
 5412:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5413:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5414: 
 5415: 
 5416:    // Solves for tke.
 5417:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5418: 
 5419: 
 5420:    // B.C. (computed using values from previous time except wind)
 5421:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5422:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5423: 
 5424: 
 5425:    // Update TKE.
 5426:    turb.tke[kb]     = tkebot;
 5427:    turb.tke[kb + 1] = tkebot;
 5428:    turb.tke[ivrt]   = tkesrf;
 5429:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5430:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5431: // printf("tke[%d]: %f, solution[%d]: %f\n", k, turb.tke[k], kin, solution[kin]);   
 5432:    }
 5433: 
 5434: 
 5435: 
 5436:  
 5437:    // Solves for phi.
 5438:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5439: 
 5440: 
 5441:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5442:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5443:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5444: 
 5445:    turb.mxl[kb+1] = mxlbot;
 5446:    turb.mxl[ivrt] = mxlsrf;
 5447:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5448:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5449: 
 5450:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5451: 
 5452:       // Galperin's clipping
 5453:       if (N2 < 0.0) {
 5454:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5455:          turb.mxl[k] = min(turb.mxl[k], upper);
 5456:       }   
 5457: 
 5458: 
 5459: 
 5460:       // Max. mixing length based on dissipation; mxlmin prevails
 5461:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5462: 
 5463:       // Combined max. mixing length including geometric limit
 5464:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5465: 
 5466:       // Clamp the mixing length between the minimum and maximum values
 5467:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5468: 
 5469:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5470: 
 5471: 
 5472:    } // for k
 5473: 
 5474: 
 5475:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5476:    turb.tke[kb] = turb.tke[kb + 1];
 5477:    turb.mxl[kb] = turb.mxl[kb + 1];
 5478: 
 5479: 
 5480:    // Compute vertical diffusivities at new time
 5481:    turb.computeDiffusivities(node);
 5482: 
 5483:    // make all the variables uniform below the bottom level kb
 5484:    for (int k = 0; k < kb; k++) {
 5485:       node->dfv[k] = node->dfv[kb];
 5486:       node->dfh[k] = node->dfh[kb];
 5487:       turb.tke[k] = turb.tke[kb];
 5488:       turb.mxl[k] = turb.mxl[kb];
 5489:       turb.nu_tke[k] = turb.nu_tke[kb];
 5490:       turb.nu_phi[k] = turb.nu_phi[kb];
 5491:    }
 5492: 
 5493:       
 5494: 
 5495: }
 5496: 
 5497: 
 5498: 
 5499: 
 5500: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5501:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5502:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5503: 
 5504: 
 5505:    NODE(node1);
 5506: 
 5507:    node1->clearMatrixRow();
 5508:    node1->qel = 0.0;
 5509: 
 5510:    // THIS IS FOR STRUCTURES XXX
 5511:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5512: 
 5513:    
 5514:    for (int j=0; j<node1->numElements; j++) {
 5515:       // For each element connected to the node...
 5516: 
 5517:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5518: 
 5519:       Element *elem = node1->elements[j];
 5520: 
 5521:       // Compute the average gravity
 5522:       const double grav3 = elem->mean(&Node::grav2);
 5523: 
 5524:       // Look at the documentation for the description of the terms in the following integrals
 5525: 
 5526:       // Integral I_1 
 5527:       // \bar{\breve{H}} 
 5528:       const double hhatb = elem->mean(&Side::hhat);        
 5529: 
 5530:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5531: 
 5532:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5533:       const double area = elem->area;
 5534: 
 5535:       // Integral I_4
 5536:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5537:       // Where
 5538:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5539: 
 5540:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5541:       // of U over the element.
 5542:       const Vector2 U = elem->mean(&Side::U);
 5543: 
 5544:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5545: 
 5546:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5547:       const double I_4_1 = dot(gradPhi_1, U);
 5548: 
 5549: 
 5550:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5551:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5552: 
 5553:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5554: 
 5555: 
 5556:       // Normal component of the bed velocity
 5557:       double ubedNormalComp = 0.0;
 5558:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5559:          Vector3 ubed = {0.0, 0.0, 0.0};
 5560:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5561:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5562: 
 5563:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5564:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5565:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5566: 
 5567:          // Computes the normal component of the bed velocity
 5568:          ubedNormalComp = dot(ubed, N);
 5569:       } // imm==2
 5570: 
 5571:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5572: 
 5573:       if (elem->isTri()) {
 5574: 
 5575:          // To clarify the notation in this section: 
 5576:          //   In formulas, we use the following notation:
 5577:          //       i stands for the node under consideration (node1)
 5578:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5579:          //   However, in the code, we use the following notation:
 5580:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5581:          const int id2 = elem->nxq(1 + id1);
 5582:          const int id3 = elem->nxq(2 + id1);
 5583:          Node *node2 = elem->nodes[id2];
 5584:          Node *node3 = elem->nodes[id3];
 5585: 
 5586:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5587: 
 5588:          // integral of phi_i*phi_j
 5589:          const double ipp_ii = (1.0/6.0 )*area;
 5590:          const double ipp_ij = (1.0/12.0)*area;
 5591:          const double ipp_ik = (1.0/12.0)*area;
 5592: 
 5593:          // integral of [(grad phi_i) * (grad phi_j)]
 5594:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5595:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5596:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5597: 
 5598:          // Computes the different components of integral I_1 of each node with respect to node i.
 5599:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5600:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5601:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5602: 
 5603:          node1->addToSparseMatrix(node1, I1_ii);
 5604:          node1->addToSparseMatrix(node2, I1_ij); 
 5605:          node1->addToSparseMatrix(node3, I1_ik);
 5606: 
 5607:          #pragma unroll
 5608:          for (int l=0; l<3; l++) {
 5609: 
 5610:             Node *node = elem->nodes[l];
 5611: 
 5612:             // Additional variation in eta due to bed deformation or vertical velocity
 5613:             double extraEta = 0.0;
 5614:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5615:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5616: 
 5617: 
 5618:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5619:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5620: 
 5621:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5622: 
 5623:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5624:            
 5625:          }
 5626: 
 5627: 
 5628:       }
 5629:       else { // Quad
 5630:          // To clarify the notation in this section: 
 5631:          //   In formulas, we use the following notation:
 5632:          //       i stands for the node under consideration (node1)
 5633:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5634:          //   However, in the code, we use the following notation:
 5635:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5636:          const int id2 = elem->nxq(1 + id1);
 5637:          const int id3 = elem->nxq(2 + id1);
 5638:          const int id4 = elem->nxq(3 + id1);
 5639:          Node *node2 = elem->nodes[id2];
 5640:          Node *node3 = elem->nodes[id3];
 5641:          Node *node4 = elem->nodes[id4];   
 5642:          
 5643:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5644: 
 5645:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5646:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5647:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5648:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5649:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5650: 
 5651:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5652:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5653:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5654:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5655:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5656: 
 5657: 
 5658:          // Computes the different components of integral I_1 of each node with respect to node i.
 5659:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5660:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5661:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5662:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5663: 
 5664:          node1->addToSparseMatrix(node1, I1_ii);
 5665:          node1->addToSparseMatrix(node2, I1_ij); 
 5666:          node1->addToSparseMatrix(node3, I1_ik);
 5667:          node1->addToSparseMatrix(node4, I1_il);
 5668:   
 5669:          #pragma unroll
 5670:          for (int l=0; l<4; l++) {
 5671: 
 5672:             const Node *node = elem->nodes[l];
 5673: 
 5674:             // Additional variation in eta due to bed deformation or vertical velocity
 5675:             double extraEta = 0.0;
 5676:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5677:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5678: 
 5679:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5680:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5681:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5682: 
 5683:          }         
 5684:       } 
 5685: 
 5686: 
 5687:      node1->qel += (dt/elem->i34)*elem->vsource;
 5688:       
 5689: 
 5690:    } // for all elements connected to the node
 5691:    
 5692: 
 5693:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5694:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5695:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5696:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5697:    // If it is an open boundary node...
 5698: 
 5699:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5700: 
 5701:       // At least one open bnd side, maybe two
 5702:       for (int l=0; l<2; l++) { 
 5703: 
 5704:          // Gets each of the sides sharing the node. 
 5705:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5706: 
 5707:     
 5708: 
 5709:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5710:          if (sideBnd != nullptr) {
 5711:             // If the side is on a boundary...
 5712: 
 5713:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5714: 
 5715:             // Get the boundary segment
 5716:             const BoundarySegment *sideSegment = sideBnd->segment;
 5717:             const Side *side = sideBnd->side;
 5718: 
 5719:             // Integral I_3
 5720:             if (sideSegment->ifltype != 0) {
 5721:             // Natural or Flather b.c.
 5722: 
 5723:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5724:                // especially for Flather b.c.
 5725:                double ri3 = 0.0;
 5726:                if (!side->isDry) {
 5727:                   // If the side is not dry
 5728:                   
 5729:                   // Computes the side flux of (uth, vth)
 5730:                   double Vn = 0.0;
 5731:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5732:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5733:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5734: 
 5735:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5736:                   }
 5737: 
 5738:                   ri3 = 0.5*side->len*Vn;
 5739:                }
 5740: 
 5741:                if (sideSegment->ifltype == -1) { // Flather 1
 5742: 
 5743:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5744:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5745: 
 5746:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5747:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5748:                   
 5749:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5750:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5751: 
 5752:                } 
 5753:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5754:                   // Reset ri3
 5755:                   ri3 = 0.0;
 5756: 
 5757:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5758:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5759: 
 5760:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5761: 
 5762:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5763:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5764: 
 5765:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5766:                   node1->addToSparseMatrix(node1, con0*2.0);
 5767:                   node1->addToSparseMatrix(node2, con0);
 5768: 
 5769:                } // if Flather or Discharge
 5770: 
 5771:                node1->qel -= thetai*dt*ri3;  
 5772: 
 5773: 
 5774:             } // I_3
 5775:           
 5776: 
 5777:             // Integral I_5
 5778:             if(!side->isDry) {
 5779: 
 5780:                const double Unbar = dot(side->U, side->n);
 5781:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5782: 
 5783:             } // I_5
 5784: 
 5785:          } // if is boundary side
 5786: 
 5787:       } // for l
 5788: 
 5789:    } // if isbnd
 5790: 
 5791: 
 5792: }
 5793: 
 5794: 
