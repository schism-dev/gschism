 6732: #ifdef DONTCOMPILE
 6733: __device__ void computeVerticalAdvection(void) {
 6734:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6735: 
 6736:    sdbt(1:2,:,:)=0.d0
 6737: 
 6738:    const Side *side = FROM kernel;
 6739: 
 6740:    if(side->isDry) return;
 6741: 
 6742:    // If side is wet...
 6743: 
 6744: 
 6745:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6746:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6747:    double ws[nvrt] = {} // w @ side
 6748:    int icount = 0;
 6749:    for (int j=0; j<2; j++) {
 6750:       const Element *elem = side->elements[j];
 6751:        
 6752:       if(elem != nullptr) {
 6753:          icount++;
 6754:          for (int k=0; k<nvrt; k++) {
 6755:             ws[k] = ws[k] + elem->w[k];
 6756:          }
 6757:       }
 6758:    }  // for j
 6759: 
 6760:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6761:    ws = ws/icount;
 6762: 
 6763:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6764:    // Splines allow for a smooth transition between vertical levels.
 6765:    // Splines have continuity restrictions at the internal knots, but
 6766:    // we have to provide the 1st derivatives at the endpoints.
 6767:    const int kbs = side->kbs; 
 6768:    
 6769:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6770:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6771:    initCubicSpline(kbs, nvrt, side, ws, up)
 6772: 
 6773:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6774:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6775:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6776: 
 6777:    // Total advection (average onto side)
 6778:    const Node *node1 = side->nodes[0];
 6779:    const Node *node2 = side->nodes[1];
 6780:    for (int k=kbs(i); k<nvrt; k++) {
 6781: 
 6782:       if constexpr(ics==1) {
 6783:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6784:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6785:       } else {
 6786:          // XXX IMPLEMENT THIS
 6787:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6788:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6789:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6790:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6791:       }  // if ics
 6792: 
 6793: 
 6794:    }
 6795: }
 6796: #endif
 6797: 
 6798: 
 6799: extern "C" {
 6800:    __global__ void computeElemAverageGhat(void) {
 6801:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6802: 
 6803:       ELEM(elem);
 6804:       
 6805:       elem->ghat1= {0.0, 0.0};  
 6806: 
 6807:       if constexpr(ihydraulics != 0) {
 6808:          if (nhtblocks > 0 && elem->isblock) return;
 6809:       }
 6810: 
 6811:       if (elem->isDry) return;
 6812: 
 6813:       // Wet elements.
 6814:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6815:       // tidal potential, horizontal diffusion, and baroclinic etc
 6816:       // Remember to update both fb and F 
 6817:       // If ics=2, ghat1 are in eframe (ll)
 6818:       // cff1-3: coefficients for 2D/3D
 6819:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6820:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6821:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6822: 
 6823:       double av_cff1 = 0.0;  // av. for cff1
 6824:       double av_cff2 = 0.0;  // av. for cff2
 6825:       double av_cff3 = 0.0;  // av. for cff3
 6826:       double av_df = 0.0;  // av. for H^\alpha / H
 6827:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6828:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6829: 
 6830:       const int i34 = elem->i34;
 6831:       const int kb = elem->kb;
 6832: 
 6833:       for (int j=0; j<i34; j++) {
 6834:          // For each node and side in the element...
 6835: 
 6836:          const Node *node = elem->nodes[j];
 6837:          const Side *side = elem->sides[j];
 6838: 
 6839:          const double chi      = side->chi;
 6840:          const double veg_c2   = side->veg_c2;
 6841:          const double veg_beta = side->veg_beta;
 6842:          const double veg_h    = side->veg_h();
 6843:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6844: 
 6845:          // Node - const in elem
 6846:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6847:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6848: 
 6849:          if (elem->depth >= tip_dp) {
 6850:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6851:          }
 6852: 
 6853:          
 6854:          const double htot  = side->htot2();        // Total depth at the side
 6855:          const double zctr2 = side->zTopCanopy();  
 6856: 
 6857:          double cff1; 
 6858:          double cff2; 
 6859:          double cff3;   
 6860:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6861:          // coefficients applied to 2D/3D case 
 6862:             cff1 = side->hhat/htot;
 6863:             cff2 = 0.0;
 6864:             cff3 = 0.0;
 6865:          } else { //3D
 6866:             //Init for no-veg case
 6867:             cff1 = 1.0;
 6868:             cff2 = 1.0;
 6869:             cff3 = 0.0;
 6870: 
 6871:             if constexpr(iveg != 0) {
 6872:                // Computes coefficients used with vegetation terms G1, G2
 6873:                // cff1, cff3 are used for the first two terms in G1, G2:
 6874:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6875:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6876:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6877:                if(veg_h < 0.99*htot) { // submergent vegetation
 6878:                   cff1=1;
 6879:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6880:                   cff3 = veg_c;
 6881: 
 6882:                } else { // emergent vegetation
 6883:                   cff1 = 1.0/(1.0 + veg_c2);
 6884:                   cff2 = cff1;
 6885:                   cff3 = 0.0;
 6886: 
 6887:                }
 6888:             } // if iveg
 6889:          } //  2D/3D
 6890: 
 6891:          av_cff1 += cff1/i34;
 6892:          av_cff2 += cff2/i34;
 6893:          av_cff3 += cff3/i34;
 6894:          av_cff2_chi += cff2*chi/i34;
 6895:          av_cff3_chi += cff3*chi/i34;
 6896:          av_df += min(htot, veg_h)/(htot*i34);
 6897: 
 6898: 
 6899:          // btrack values: U^\star, U^{\star\alpha}
 6900:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6901:          Vector2 Ustar       = {0.0, 0.0}; 
 6902:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6903: 
 6904:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6905:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6906:          } else { //3D
 6907:             for (int k = side->kb; k < nvrt; k++) {
 6908:             
 6909:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6910:                Ustar += w2;
 6911: 
 6912:                if constexpr(iveg != 0) {
 6913:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6914:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6915:                        Ustar_alpha += zrat*w2; // XXXX
 6916:                    }
 6917:                }  // if iveg
 6918:             }  // for k
 6919:          }  //2D/3D
 6920:          
 6921: 
 6922:          // Add btrack & surface stress terms to \breve{G} first
 6923:          if constexpr(ics==1) {
 6924: 
 6925:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6926: 
 6927:          } else {
 6928:             // XXX IMPLEMENT THIS
 6929:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6930:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6931:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6932:          }  // if ics
 6933: 
 6934:          // Surface and bottom stress terms
 6935:          if constexpr(ics==1) {
 6936:             const Vector2 tau    = side->tau();
 6937:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6938: 
 6939:             // Term for surface and bottom stress
 6940:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6941: 
 6942:          } else {
 6943:             assert(false && "computeElemAverageGhat: Not implemented");
 6944:             // XXX IMPLEMENT THIS
 6945:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6946:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6947:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6948:             // tau_x=(vn1+tt1)/2.d0
 6949:             // tau_y=(vn2+ss1)/2.d0
 6950:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6951:          }  // if ics
 6952: 
 6953:          
 6954: 
 6955:          // All terms in F,F^\alpha,f_b except baroclinic
 6956:          // F, f_b: all explicit terms excluding vegetation 
 6957:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6958:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6959:          const double coriolis = side->coriolis;
 6960:          Vector2 F  =  coriolis*side->U;  // F_x
 6961:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6962:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6963: 
 6964:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6965:             
 6966:             for (int k = side->kb; k < nvrt; k++) {
 6967:                if (zctr2 > side->zc[k-1]) {
 6968:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6969:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6970:                    Fa +=  coriolis*w2*zrat;
 6971:                } // if zctr2
 6972:             } // k
 6973:          } // iveg
 6974: 
 6975:          // Integrate horizontal viscosity force vertically
 6976:          for (int k=side->kb + 1; k<nvrt; k++) {
 6977:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6978: 
 6979:             F += levelHorVisc;
 6980: 
 6981:             // Vegetation term
 6982:             if constexpr(iveg!=0) {
 6983:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6984:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6985:                   Fa += levelHorVisc*zrat;
 6986:                } 
 6987:             } // if iveg
 6988:          } // for k
 6989: 
 6990:          fb += side->nuGradU[side->kb];
 6991: 
 6992:          // Add to ghat1
 6993:          if constexpr(ics==2) {
 6994:             // XXX IMPLEMENT THIS
 6995:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6996:             // bigf1=vn1; bigf2=vn2
 6997:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6998:             // botf1=vn1; botf2=vn2
 6999:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7000:             // bigfa1=vn1; bigfa2=vn2
 7001:          } // if ics
 7002: 
 7003:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7004:       } // for j (nodes and sides)
 7005: 
 7006:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7007:          
 7008:       // Finish off terms in F, F^\alpha and f_b
 7009:       const double grav3 = elem->mean(&Node::grav2);
 7010:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7011: 
 7012: 
 7013:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7014:       for (int j=1; j<i34; j++) { 
 7015:          // For each side in the element...
 7016:          const Side *side = elem->sides[j];
 7017:          const double chi = side->chi;
 7018: 
 7019:          const double htot = side->htot2();
 7020:          const double veg_h = side->veg_h();
 7021:          const Vector2 F  = htot*fb;
 7022:          const Vector2 Fa = min(htot, veg_h)*fb;
 7023: 
 7024:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7025:       } // for j
 7026: 
 7027:       //botf1 etc are already in elem frame
 7028:       elem->ghat1 += tmp/i34;
 7029: 
 7030:       // Baroclinic force
 7031:       if constexpr(ibc==0) {
 7032:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7033: 
 7034:          Vector2 Fa = {0.0, 0.0};
 7035:          Vector2 intGradRho = {0.0, 0.0};
 7036:          
 7037:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7038:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7039:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7040: 
 7041:             // \in F [m^2/s/s]
 7042:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7043:          }
 7044: 
 7045:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7046:          const Vector2 F = av_df*Fa; //approx
 7047:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7048: 
 7049:       } // if ibc
 7050: 
 7051: 
 7052: 
 7053:    }
 7054: 
 7055: } // extern "C"
 7056: 
 7057: 
 7058: 
 7059: #ifdef DONTCOMPILE
 7060: __global__ void checkMassConservation(Tracers* sumtr) {
 7061: 
 7062:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7063: 
 7064:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7065: 
 7066:    Element *elem = &(mesh->localElemData[i]);
 7067: 
 7068:    // Skip dry elements
 7069:    if (elem->isDry) return;
 7070: 
 7071:    // Local sum array for this thread
 7072:    double localSum[N_TRACERS] = {0.0};
 7073: 
 7074:    // Sum over vertical levels for this element
 7075:    const int kbe = elem->kbe;
 7076:    const double area = elem->area;
 7077: 
 7078:    for (int k = kbe; k < nvrt; k++) {
 7079:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7080:       
 7081:       // Accumulate tracer mass
 7082:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7083:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7084:       }
 7085:    }
 7086: 
 7087:    //  This function returns per element sums. A reduction must be done on the host side.
 7088: }
 7089: 
 7090: 
 7091: __global__ void transport(void) {
 7092: 
 7093:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7094: 
 7095:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7096: 
 7097:    Element *elem = &(mesh->localElemData[ie]);
 7098: 
 7099:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7100: 
 7101:                for (int m=0; m<ntr; m++) {
 7102:                   for (int k=kbe(ie); k<nvrt; k++) {
 7103:                      // Calculate each polynomial's weight 
 7104:                      wm=0.d0; sum1=0.d0; 
 7105:                      wm1=0.d0; wm2=0.d0; 
 7106:                      for (int i=0; i<elem->nweno2; i++) {
 7107:                   
 7108:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7109:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7110:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7111:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7112:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7113:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7114:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7115:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7116:                      // -----------------Hu and Shu (1999)'s method----------------
 7117:                      b4=b1+b2+b3
 7118: 
 7119: //Error: add PRODUCTION CPP
 7120: #ifdef DEBUG
 7121:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7122:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7123:                     call parallel_abort(errmsg)
 7124:                   }
 7125: #endif
 7126: 
 7127:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7128:                   // !----test-------------- 
 7129:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7130:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7131:                   // !wm(i)=wm1(i)*wm2(i)
 7132:                   // !---------------------- 
 7133:                   sum1=sum1+wm(i)
 7134:                 } // end for i
 7135: 
 7136:                 wm=wm/sum1
 7137: 
 7138:                 for (int j=0; j<elem->i34; j++) {
 7139: 
 7140:                   const Side *side  = elem->sides[j];
 7141:                   const Node *node1 = side->n1;
 7142:                   const Node *node2 = side->n2;
 7143: 
 7144:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7145:                      trsd=0.d0
 7146:                      for (int kk=0; kk<nquad; kk++) {
 7147:                         for (int i=0; i<elem->nweno2; i++) {
 7148:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7149:                         } // end for i   
 7150:                      } // end for kk
 7151:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7152:                   } // outward flux
 7153:                } // end for j=1,i34(ie) ! side
 7154:             }
 7155:          }
 7156:               
 7157: 
 7158: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7159: //             //   calculate each polynomial's weight 
 7160: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7161: //                 wm=0.d0; sum1=0.d0
 7162: //                 do i=1,nweno1(ie) !for each polynomial
 7163: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7164: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7165: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7166: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7167: //                   wm(i)=b2
 7168: //                   sum1=sum1+b2
 7169: //                   !wm(i)=1.d0
 7170: //                   !sum1=sum1+1.d0
 7171: 
 7172: // // Error: PRODUCTION
 7173: // #ifdef DEBUG
 7174: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7175: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7176: //                     call parallel_abort(errmsg)
 7177: //                   endif
 7178: // #endif
 7179: 
 7180: //                 enddo !i
 7181: //                 wm=wm/sum1 !final weight
 7182: 
 7183:                 for (int j=0; j<elem->i34; j++) { // side
 7184:                   const Side *side = elem->sides[j];
 7185:                   const Node *node1 = side->n1;
 7186:                   const Node *node2 = side->n2;
 7187: 
 7188:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7189:                     trsd=0.d0
 7190:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7191:                       for (int i=0; i<elem->nweno1; i++) {
 7192:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7193:                       }
 7194:                     enddo //kk
 7195:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7196:                   } // outward flux
 7197:                 } // end for j=1,i34(ie) ! side
 7198:               } // end for k; ntr 
 7199: 
 7200:             else !simple upwind method
 7201:               do j=1,i34(ie)
 7202:                 jsj=elside(j,ie)
 7203:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7204:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7205:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7206:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7207:                   endif
 7208:                 enddo  !vertical layers
 7209:               enddo !j=1,i34(ie) ! side
 7210:             endif !order of accuracy
 7211: 
 7212:          //  enddo !ie
 7213: // !$OMP     end do
 7214: 
