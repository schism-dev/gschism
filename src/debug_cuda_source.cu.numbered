 2399: 
 2400: __device__ __forceinline__ double Element::centerZ(void) const { 
 2401: // Z coordinate of the element center in the global cartesian coordinates.
 2402: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2403: 
 2404:    if constexpr(ics==1) { 
 2405:       return 0.0; 
 2406: 
 2407:    } else { 
 2408: 
 2409:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2410:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2411:    } 
 2412: }
