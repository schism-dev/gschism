 2175:    template<typename T>
 2176:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2177:       T values[4];
 2178:       getSideValues(field, values);
 2179:       
 2180:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2181:       if constexpr (IsVector2<T>::value && ics == 2) {
 2182: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2183:          projectSideVectorsToElementFrame(values);
 2184: printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2185:       }
