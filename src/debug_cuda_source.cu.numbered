 4711:    __global__ void computeFlowBcVelocities(double time) {
 4712: 
 4713:       SIDE_BND(sideBnd);
 4714: 
 4715:       const Side *side = sideBnd->side;
 4716:  
 4717:       const bool isDry = side->isDry;
 4718:       const bool isLand = sideBnd->segment->isLand;
 4719: 
 4720:    
 4721:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4722: 
 4723:       if (isDry || isLand) return;
 4724: 
 4725:       // For wet sides in open boundaries...
 4726:       const Vector2 n = side->n;
 4727:       const BoundarySegment *segment = sideBnd->segment;
 4728: 
 4729:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4730: 
 4731:       const int ifltype = segment->ifltype;
 4732: 
 4733:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4734:       const Vector2 r_nuth0 = r_uth0*n;
 4735: 
 4736: 
 4737:       if (ifltype == 1 || ifltype == 2) {
 4738:       
 4739:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4740: 
 4741:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4742:          
 4743:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4744:          
 4745:       } else if (ifltype == -1) { // Flather 1
 4746: 
 4747:          for (int k = 0; k < nvrt; k++) {
 4748: 
 4749:             // uth is the normal vel.; no ramp up
 4750:             const double uth = sideBnd->nuth(k);
 4751:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4752: 
 4753:             sideBnd->ubc[k] += uth*n;
 4754:          }
 4755: 
 4756:       } else if (ifltype == 3 || ifltype == 5) {
 4757:          // vnth0=0 !normal vel.
 4758: 
 4759:          Vector2 r_u1_bar = {0.0, 0.0};
 4760:          // Computes the contribution to the velocity from all tide frequencies
 4761:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4762: 
 4763:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4764:             const Vector2 umo  = sideBnd->umo(jfr); 
 4765: 
 4766:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4767:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4768:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4769:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4770: 
 4771:          }
 4772: 
 4773: 
 4774:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4775: 
 4776:       } // if (ifltype = 3 || ifltype == 5
 4777: 
 4778: 
 4779: 
 4780:    }
 4781: 
 4782:    __global__ void computeElevationBoundaryConditions(double time) {
 4783:       // Compute elevation essential boundary conditions 
 4784: 
 4785:       NODE_BND(nodeBnd); // Each boundary node.
 4786: 
 4787:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4788: 
 4789:       const Node *node = nodeBnd->node;
 4790:       const BoundarySegment *segment = nodeBnd->segment;
 4791:       const int iettype = segment->iettype;
 4792:       
 4793: 
 4794:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4795:       double eic = 0.0;
 4796:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4797:       else                 eic = 0.0;
 4798: 
 4799:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4800:       const double r_eth = ramp*nodeBnd->eth;
 4801:       double r_eta1_bar = 0.0;
 4802: 
 4803: 
 4804:       // Compute tide elevation
 4805:       if (iettype == 3 || iettype == 5) {   
 4806: 
 4807:          if constexpr(iloadtide==1) { // loading tide
 4808:             assert(false && "Loading tide not implemented");
 4809:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4810:          }
 4811:          
 4812:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4813: 
 4814:             const double efa  = nodeBnd->efa[jfr]; 
 4815:             const double emo  = nodeBnd->emo[jfr]; 
 4816: 
 4817:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4818:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4819:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4820: 
 4821:          } // for jfr
 4822: 
 4823:       } // if iettype
 4824: 
 4825:       switch (iettype) {
 4826:          case 1:
 4827:          case 2:
 4828:          case 4:
 4829:             nodeBnd->elbc = r_eic + r_eth;
 4830:             break;
 4831:          case 3:
 4832:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4833:             break;
 4834:          case 5:
 4835:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4836:             break;
 4837:       } // switch
 4838: 
 4839: 
 4840:       //Add inverse barometric effects
 4841:       if (iettype != 0 && inv_atm_bnd == 1) {
 4842:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4843:       }
 4844: 
 4845:    }
 4846: 
 4847: 
 4848:    __global__ void computeHorizontalViscosity(void) { 
 4849: 
 4850:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4851: 
 4852:       SIDE(side);
 4853: 
 4854:       if (side->isDry) return;
 4855: 
 4856:       for (int k = 0; k < nvrt; k++) {
 4857:          side->nuGradU[k] = {0.0, 0.0};
 4858:       }
 4859: 
 4860:       if constexpr(ihorcon == 1) {
 4861:          for (int k = side->kb; k < nvrt - 1; k++) {
 4862:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4863:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4864:             // By Zhang and Baptista.
 4865: 
 4866:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4867:             // This is a standard discretization of the Laplacian operator.
 4868:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4869:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4870:             // Gamma is hvis_coef0 in the code.
 4871:             // The value of gamma needs to be < 0.5.
 4872: 
 4873:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4874:             // side under consideration in each of the two possible elements that share the side.
 4875:             Vector2 sumU = {0.0, 0.0};
 4876:             for (int l = 0; l < 2; l++) {
 4877:                const Element *elem = side->elems[l];
 4878: 
 4879:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4880: 
 4881:                // Find the local index of the side in the element
 4882:                const int idxSide = elem->sideLocalIdx(side);
 4883: 
 4884:                // Find the two sides that are connected to the side under consideration
 4885:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4886:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4887: 
 4888:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4889: 
 4890:             }
 4891: 
 4892:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4893: 
 4894:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4895:    
 4896:          }
 4897:       }
 4898:       else if constexpr(ihorcon == 2) {
 4899:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4900:       }
 4901: 
 4902: 
 4903:    }
 4904: 
 4905: 
 4906:    __global__ void setEssentialBC(void) {
 4907:       // Set essential boundary conditions 
 4908:       NODE(node); // Each boundary node
 4909:       NodeBoundary *nodeBnd = node->nodeBnd;
 4910:       
 4911:  
 4912:       // Check if this node has essential BC
 4913:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4914:          // Verify BC value is valid
 4915:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4916: 
 4917:        
 4918:          // Set diagonal to 1 and zero off-diagonals
 4919:          node->coeffDiag = 1.0;
 4920: 
 4921:          for (int j = 0; j < node->numNodes; j++) {
 4922:                node->coeffMatrix[j] = 0.0;
 4923:          }
 4924:          
 4925:          // Set solution and RHS to BC value
 4926:          node->mX  = nodeBnd->elbc;
 4927:          node->qel = nodeBnd->elbc;
 4928: 
 4929:       } else {
 4930:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4931: 
 4932:          for (int j = 0; j < node->numNodes; j++) {
 4933:                Node* nbNode = node->nodes[j];
 4934:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4935:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4936:                   // Verify neighbor's BC value
 4937:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4938: 
 4939:                   // Subtract contribution to RHS
 4940:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4941:                   node->coeffMatrix[j] = 0.0;  
 4942:                }
 4943:          }
 4944:       }
 4945:    }
 4946: 
 4947: 
 4948:    __global__ void updateElevation(void) {
 4949:       NODE(node);
 4950: 
 4951: 
 4952:       node->eta2 = node->mX;
 4953: 
 4954:       node->updateZCoordData();
 4955:    }
 4956: 
 4957: 
 4958:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4959: 
 4960:       SIDE(side);
 4961: 
 4962:       side->U = {0.0, 0.0}; 
 4963:          
 4964:       if(side->isDry) return;
 4965: 
 4966:       // Vertically integrated velocity U (in ll if ics=2)
 4967:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4968:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4969:          side->U += side->Dz(k + 1)*uc;  
 4970:       }
 4971: 
 4972:    }
 4973: 
 4974:    __global__ void computeBottomDragVegetation(void) {
 4975:       // UNFINISHED. CHECK THIS:
 4976:       // How many kernels are needed? Why so many for loops?
 4977:       // Is the loop on sides needed?
 4978: 
 4979:       NODE(node);
 4980: 
 4981: 
 4982:       const int    kb      = node->kb;
 4983:       const double htot    = node->htot2(); 
 4984:       
 4985:       if (node->isDry) {
 4986:          // Default values for dry nodes
 4987:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4988:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4989: 
 4990:          return;
 4991:        
 4992:       }
 4993: 
 4994:       // Computes bottom drag Cd based on the selected nchi
 4995:       node->computeBottomDragCd();
 4996:       
 4997: 
 4998: 
 4999:       //   Bottom stress in m^2/s^2
 5000:       if (node->rho[kb + 1] >= -98.0)
 5001:       {
 5002:          const double mag_u = length(node->u2[kb + 1]);
 5003:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5004: 
 5005:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5006:          // !sediment erosion: this part needs more documentation
 5007:       }
 5008:     
 5009: 
 5010: 
 5011:       // Compute vegetation parameters
 5012:       //--------------------------------
 5013: 
 5014:       // SAV constants
 5015:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5016:       constexpr double veg_cfpsi = 0.16;
 5017: 
 5018:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5019:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5020: 
 5021:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5022:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5023:          int kbin = 0; // bin index
 5024:          for (int k = kb; k < nvrt; k++) {
 5025:             // Computes node height above the bottom level
 5026:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5027:             assert(false && "Vertical variation of vegetation not implemented");
 5028: 
 5029:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5030:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5031:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5032:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5033:             // } else {
 5034:             //    // Find the bin at which the current vertical level is
 5035:             //    while (kbin<nbins_veg_vert) {
 5036:             //       const double zn = node->z[kbin];
 5037:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5038:             //          break;
 5039:             //       } // if
 5040:             //       kbin++;
 5041:             //    } // while
 5042:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5043: 
 5044:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5045:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5046:                
 5047:             //    // Linear interpolation of the vegetation parameters
 5048:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5049:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5050:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5051:             // } // if rl10
 5052: 
 5053:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5054: 
 5055:          } // for k
 5056: 
 5057: 
 5058:       } else { // Ganthy (iveg==2)
 5059:       //  Modify canopy height, diameter, and density
 5060: 
 5061:          // Make sure there is vegetation on this node
 5062:          if (node->veg_h_unbent > 0.0) {
 5063:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5064: 
 5065:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5066:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5067:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5068: 
 5069:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5070:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5071:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5072:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5073:          } // if veg_h_unbent
 5074: 
 5075:          for (int k = 0; k < nvrt; k++) {
 5076:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5077:          } // for k
 5078:       
 5079: 
 5080:       } // if iveg
 5081:      
 5082: 
 5083:       // Compute vertical mean of veg_alpha3D
 5084:       if (iveg != 0) {
 5085:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5086:          double sum1=0.0;
 5087:          double sum2=0.0;
 5088:          // Integrate over each level under the canopy...
 5089:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5090:             const double Dz = node->Dz(k);
 5091: 
 5092:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5093:             sum2 += Dz;
 5094: 
 5095:          } // for k
 5096:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5097:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5098: 
 5099:       } // if iveg
 5100: 
 5101:    }
 5102: 
 5103:    __global__ void computeVegetationAndDragParameters(void) {
 5104:       // Computes the vegetation and drag model parameters:
 5105:       // chi, \tilde\chi, beta, \breve{H}
 5106:       
 5107:       SIDE(side);
 5108: 
 5109:       side->hhat = 0.0;
 5110:       side->chi2 = 0.0;
 5111:       side->chi = 0.0;
 5112:       side->veg_c2 = 0.0;
 5113:       side->veg_beta = 0.0;
 5114: 
 5115:       if (side->isDry) return;
 5116: 
 5117:       const double htot = side->htot2();
 5118:       const int    kb   = side->kb;
 5119: 
 5120:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5121: 
 5122:       const double veg_h     = side->veg_h();
 5123:       const double veg_nv    = side->veg_nv();
 5124:       const double veg_c     = side->veg_c();
 5125:       const double veg_beta  = side->veg_beta;
 5126:       const double veg_alpha = side->veg_alpha_vert_mean();
 5127: 
 5128:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5129:       // Velocity magnitude at the bottom level
 5130:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5131:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5132:       side->chi2 = side->Cd()*vmag1;
 5133:       side->chi  = side->chi2;
 5134:       if constexpr(iveg != 0) {
 5135:          const Node *n1 = side->n1;
 5136:          const Node *n2 = side->n2;
 5137:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5138:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5139:       }
 5140: 
 5141:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5142: 
 5143:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5144:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5145:       double magUa = 0.0;
 5146:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5147:          // 3D wet side with veg...
 5148: 
 5149:          double magUa = 0.0;
 5150:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5151:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5152: 
 5153:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5154:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5155:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5156: 
 5157:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5158:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5159: 
 5160:                // Velocity magnitude at the bottom (l) of the level
 5161:                const double ul = length(side->u2[k]);
 5162: 
 5163:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5164:                magUa += Dz*0.5*(uh + ul);
 5165: 
 5166:             } // if HasVegetation
 5167:          } // for k
 5168:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5169: 
 5170:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5171:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5172:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5173:             const double zCpy = side->zTopCanopy();
 5174:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5175:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5176:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5177:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5178:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5179:          } // if isSubmerged
 5180:       } // if iveg   
 5181: 
 5182:       // Computes the friction modified depth, \breve{H} in notes
 5183:       if (side->is2D()) { // 2D
 5184: 
 5185:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5186:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5187: 
 5188:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5189: 
 5190:          side->hhat = htot*htot/fricH; 
 5191: 
 5192:       } else { // 3D
 5193:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5194: 
 5195:          if constexpr(iveg != 0) {
 5196:             
 5197:             if (side->isSubmerged()) { 
 5198:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5199:                side->hhat -= veg_c*Hhat_alpha;
 5200: 
 5201:             } else { // Emergent
 5202:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5203:             }
 5204:          } // if iveg
 5205: 
 5206:          // Enforce positivity for 3D model
 5207:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5208:       } // if 3D
 5209: 
 5210:    }
 5211: 
 5212: 
 5213: 
 5214:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5215:    // Computes the density gradient between two elements, e1 and e2.
 5216:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5217:    // zero in the direction normal to the side. 
 5218:    // 
 5219:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5220:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5221:    //
 5222:    // Input:
 5223:    //    e1: Element
 5224:    //    e2: Neighbor element (or nullptr if boundary)
 5225:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5226:    //    k: Index of the half-level at which the density is interpolated
 5227:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5228:    // 
 5229:    // Output:
 5230:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5231:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5232: 
 5233:       if (e2 == nullptr || e2->isDry) {
 5234:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5235: 
 5236:          Side *side = e1->sides[j];
 5237:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5238:                  
 5239:          if constexpr(ics == 1) {
 5240:             vec = side->n; // Normal vector to the side
 5241:          } else {
 5242:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5243:             // IMPLEMENT THIS XXXXXX
 5244:             // !replace with xel, yel?
 5245:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5246:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5247:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5248:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5249:          } //ics
 5250:                    
 5251:          diffRho = 0.0;
 5252: 
 5253:       } else { //internal and wet
 5254:          if constexpr(ics==1) {
 5255:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5256: 
 5257:             // Vector from e1 to e2
 5258:             vec = e2->center - e1->center;
 5259: 
 5260:          } else { 
 5261:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5262:             // IMPLEMENT THIS XXXXXX
 5263:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5264:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5265:             //                   alow(j)=xctr2
 5266:             //                   bdia(j)=yctr2
 5267:          } // ics
 5268: 
 5269:          diffRho = rho2 - e1->demeanedDensity(k);
 5270:       }
 5271: 
 5272:    }
 5273: 
 5274:    __global__ void computeDensityCubicSplines(void) {
 5275:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5276: 
 5277:       ELEM(elem);
 5278: 
 5279:       if (elem->isDry) return;
 5280: 
 5281:       const int kb = elem->kb;
 5282: 
 5283:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5284:       if (elem->is2D()) {
 5285:          // In the 2D case, the density is constant at the prism level. 
 5286:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5287:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5288:       } else { //3D
 5289: 
 5290:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5291:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5292:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5293:          ///// XXXX CHECK INDICES!!!!!
 5294:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5295:       } // 2D/3D
 5296: 
 5297:    }
 5298: } // extern "C"
 5299: 
 5300: 
 5301: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5302: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5303: 
 5304:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5305: 
 5306:    const int kb  = elem->kb;
 5307:    const int kb2 = elem2->kb;
 5308: 
 5309:    // z-coordinate of prism of elem
 5310:    const double zp = elem->z_prism(k);
 5311: 
 5312:    double rho = 0.0;
 5313: 
 5314:    if (elem2->is2D()) {
 5315:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5316: 
 5317:    } else {  // 3D
 5318: 
 5319:       // eta_min may be < zmax
 5320:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5321:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5322: 
 5323:       // (Extrapolate density below bottom, we will fix it later)
 5324:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5325:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5326:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5327:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5328:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5329:    } // 2D/3D
 5330:      
 5331: 
 5332:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5333:    // Now we need to fix it.
 5334:    if (elem->z[k] < elem2->z[kb2]) {
 5335:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5336: 
 5337:       // There are two methods to adjust the density at the bottom of the element.
 5338:       // iunder_deep=0: 
 5339:       const double depth1 = abs(elem->z[kb]); // larger depth
 5340: 
 5341:       if (iunder_deep==0) {
 5342: 
 5343:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5344: 
 5345:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5346: 
 5347:       } else { // iunder_deep != 0
 5348: 
 5349:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5350: 
 5351:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5352: 
 5353:          //   Demeaned density at the same z coordinate as
 5354:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5355:          }
 5356: 
 5357:       } // if iunder_deep
 5358:    } // if elem->z[kb] < elem2->z[kb]
 5359: 
 5360:    return rho;
 5361: }
 5362: 
 5363: 
 5364: extern "C" {
 5365:    __global__ void computeDensityGradient(void) {
 5366: 
 5367:       if constexpr(ibc != 0) return;
 5368: 
 5369:          // Compute the horizontal density gradient at each element.
 5370:       // It works in two steps:
 5371:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5372:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5373:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5374:       //             gradRho.r1 = rho1 - rho0
 5375:       //             gradRho.r2 = rho2 - rho0
 5376:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5377:       // 
 5378:       //  NOTE: We use de-meaned densities.
 5379: 
 5380:       ELEM(elem);
 5381: 
 5382:       if (elem->isDry) return;
 5383: 
 5384:       const int kb  = elem->kb;
 5385:       const int i34 = elem->i34;
 5386: 
 5387:       for (int k = kb + 1; k < nvrt; k++) {
 5388:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5389:          //             gradRho.r1 = rho1 - rho0
 5390:          //             gradRho.r2 = rho2 - rho0
 5391:          int icount = 0;
 5392:          double sumRx = 0.0;
 5393:          double sumRy = 0.0;
 5394:          for (int j1=0; j1<i34; j1++) { 
 5395: 
 5396:             const int j2 = elem->nxq(j1 + 1);
 5397: 
 5398:             // Pairs of consecutive neighbor elements of elem
 5399:             const Element *e1 = elem->nghbElems[j1];
 5400:             const Element *e2 = elem->nghbElems[j2];
 5401: 
 5402:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5403:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5404:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5405: 
 5406:             // Compute the density difference and the vector from elem to e1 and e2
 5407:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5408:             double diffRho1, diffRho2;
 5409:             Vector2 vec1, vec2;
 5410:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5411:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5412: 
 5413:             const double rl1 = length(vec1);
 5414:             const double rl2 = length(vec2);
 5415:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5416: 
 5417:             const double delta = cross(vec1, vec2);
 5418:             const double sintheta = abs(delta)/(rl1*rl2);
 5419: 
 5420:             // To avoid problems, avoid elements with small angle between vectors
 5421:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5422:             const bool validEq = (sintheta > sin_one_deg);
 5423: 
 5424:             if (validEq) {
 5425:                // Solve the system of equations to get the density gradient at elem
 5426:                icount++;
 5427:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5428:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5429:                sumRx += Rx;
 5430:                sumRy += Ry;
 5431:             }
 5432:          } // for j1
 5433: 
 5434:          // Compute the average density gradient at elem
 5435:          if (icount==0) {
 5436:            // Bad mesh quality; bail out with 0 b-cc
 5437:            elem->gradRho[k] = {0.0, 0.0};
 5438:          } else {
 5439:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5440:          }
 5441: 
 5442:       } // for k
 5443: 
 5444:    }
 5445: 
 5446:    __global__ void computeBaroclinicTerm(void) {
 5447:    // Computes the baroclinic term at sides (at half levels).
 5448:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5449:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5450: 
 5451:       if (ibc == 1) return;
 5452: 
 5453:       SIDE(side);
 5454: 
 5455:       if (side->isDry) return;
 5456: 
 5457:       const Element *e1 = side->elems[0];
 5458:       const Element *e2 = side->elems[1];      
 5459:       const int kb = side->kb;
 5460:       
 5461:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5462: 
 5463:       // interpolates vertically the density gradient of the two elements at the half level/
 5464: 
 5465:       int k1 = max(kb, nvrt / 2);
 5466:       int k2 = max(kb, nvrt / 2);
 5467: 
 5468:       // Starts the integration at the surface and goes down to the bottom
 5469:       side->bcc[nvrt-1] = {0.0, 0.0};
 5470:       for (int k = nvrt - 2; k >= kb; k--) {
 5471:       // For each prism level (from surface to bottom)...
 5472: 
 5473:          // For both elements, interpolate density gradient at the side's half level.
 5474:          // The gradient at the side is the average of the gradients at the elements.
 5475:          // w1, w2 are used to take into account boundary sides, with just one element.
 5476:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5477:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5478:          const double wsum = w1 + w2;
 5479:          w1 = w1/wsum;
 5480:          w2 = w2/wsum;
 5481:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5482: 
 5483:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5484:          Vector2 gradRho = {0.0, 0.0};
 5485:          if (e1 != nullptr && k > kb) {
 5486:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5487:             
 5488:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5489:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5490:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5491: 
 5492:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5493:          }      
 5494:          if (e2 != nullptr && k > kb) {
 5495:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5496:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5497:             
 5498:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5499:          }
 5500: 
 5501:          if constexpr(ics==2) {
 5502:             assert(false && "Not implemented: ics == 2");
 5503:             // IMPLEMENT THIS XXXXXX
 5504:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5505:             // swild(1)=tmp1
 5506:             // swild(2)=tmp2
 5507:          }
 5508:          
 5509:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5510:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5511:          // CHECK INDICES!!! XXX
 5512:          const double grav3 = side->grav3();
 5513:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5514: 
 5515:       } // for
 5516: 
 5517:    }
 5518: 
 5519: 
 5520: 
 5521:    __global__ void computeHorGradientAtSide(void) {
 5522: 
 5523:       // Compute the horizontal density gradient at each element.
 5524:       // It works in two steps:
 5525:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5526:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5527:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5528:       //             gradRho.r1 = rho1 - rho0
 5529:       //             gradRho.r2 = rho2 - rho0
 5530:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5531:       // 
 5532:       //  NOTE: We use de-meaned densities.
 5533: 
 5534:       SIDE(side);
 5535: 
 5536: 
 5537:       if (side->isDry) return;
 5538: 
 5539:       // Computes the gradient of the variables at the side center.
 5540:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5541:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5542:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5543: 
 5544:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5545:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5546:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5547:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5548: 
 5549:    }
 5550: 
 5551: 
 5552:    __global__ void solveMomentumEquations(double time) {
 5553: 
 5554:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5555:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5556: 
 5557:       SIDE(side);
 5558: 
 5559:       if (side->isDry) 
 5560:       {
 5561:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5562: 
 5563:          return;
 5564:       }
 5565: 
 5566:       const Node *n1 = side->n1;
 5567:       const Node *n2 = side->n2;
 5568: 
 5569:       const int kb = side->kb;
 5570: 
 5571:       const double veg_h = side->veg_h();
 5572:       const double grav3 = side->grav3();
 5573: 
 5574:       if (side->is2D()) {
 5575:          // Remember: Do not use htot2, which is updated.
 5576:          const double htot = side->htot1();
 5577:          const double hhat = side->hhat;
 5578: 
 5579:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5580: 
 5581:          Vector2 tau2 = {0.0, 0.0};
 5582:           
 5583:          if constexpr(ics==1) {
 5584:             tau2 = side->tau();
 5585: 
 5586:          } else {
 5587:             assert(false && "Not implemented: ics == 2");
 5588:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5589:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5590:             // taux2=(vn1+tt1)*0.5d0
 5591:             // tauy2=(vn2+ss1)*0.5d0
 5592:          } // if ics         
 5593: 
 5594:          // hat_gam has units of m/s
 5595: 
 5596:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5597:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5598:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5599: 
 5600:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5601: 
 5602: 
 5603:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5604: 
 5605:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5606: 
 5607:       }
 5608:       else { // 3D
 5609: 
 5610:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5611:          // 
 5612:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5613:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5614:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5615:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5616:          // k+1 and k.
 5617: 
 5618: 
 5619:          const int ndim = nvrt - kb;
 5620:          const double zTopCanopy = side->zTopCanopy();
 5621: 
 5622:          // Initialize the tridiagonal system
 5623:          for (int k = kb + 1; k < nvrt; k++) {
 5624:             
 5625:             const int kin = k - (kb + 1);
 5626: 
 5627:             // Vertical viscosity at the face center
 5628:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5629: 
 5630:  
 5631:             alow[kin] = 0.0;
 5632:             cupp[kin] = 0.0;
 5633:             bdia[kin] = 0.0;
 5634: 
 5635:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5636:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5637: 
 5638:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5639:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5640:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5641: 
 5642:             // First part: layers k, k+1
 5643:             if (k < nvrt - 1) {
 5644:                              
 5645:                if constexpr(iveg != 0) {
 5646: 
 5647:                   // If there is vegetation at this level...
 5648:                   if (zTopCanopy > side->zc[k]) {
 5649:                      // If the canopy is above the k layer...
 5650:                      
 5651:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5652:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5653:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5654:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5655: 
 5656:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5657:                      const double vmag2 = length(ut2);
 5658:                      const double vmag1 = length(side->u2[k]);
 5659:                      const double vmag = 0.5*(vmag1 + vmag2);
 5660:                      
 5661:                      // Computes the vegetation alpha at the face center
 5662:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5663: 
 5664:                      cff1 += veg_alpha_sd*dt*vmag;
 5665: 
 5666:                   } // if (zTopCanopy
 5667:                } // if iveg
 5668: 
 5669:                const double dzz = side->Dz(k + 1);
 5670:                const double tmp = dt*dfz/dzz;
 5671:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5672: 
 5673:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5674:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5675:             }
 5676: 
 5677: 
 5678:             // Second part: layers k-1, k
 5679:             if (k > kb + 1) {
 5680: 
 5681:                double cff1 = 1.0; //init \bar{c^k}
 5682: 
 5683:                if constexpr(iveg != 0) {
 5684:                   // If there is vegetation at this level...
 5685:                   if (zTopCanopy > side->zc[k-1]) {
 5686:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5687:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5688: 
 5689:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5690: 
 5691:                      const double vmag2 = length(ut2);
 5692:                      const double vmag1 = length(side->u2[k-1]);
 5693:                      const double vmag = 0.5*(vmag1 + vmag2);
 5694: 
 5695:                      // Computes the vegetation alpha at the face center
 5696:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5697:                      cff1 += veg_alpha_sd*dt*vmag;
 5698:                   } // if zTopCanopy
 5699: 
 5700:                } // if iveg
 5701: 
 5702:                const double dzz = side->Dz(k);
 5703:                const double tmp = dt*dfz/dzz;
 5704:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5705: 
 5706:                alow[kin] += cff1*dzz/6.0 - tmp;
 5707:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5708: 
 5709:             } else { // Bottom boundary
 5710:                // This occurs at the bottom, where the bottom drag is applied.
 5711: 
 5712:                bdia[kin] += dt*side->chi2; // XXXX
 5713: 
 5714:             } // if (k > kb + 1)
 5715: 
 5716: 
 5717:          } // for (int k
 5718: 
 5719: 
 5720: 
 5721:          // Computes the RHS.
 5722:          // -----------------
 5723: 
 5724:          //	BC to be imposed at the end.
 5725: 
 5726:          const Vector2 gradETP  = side->gradETP;
 5727:          const Vector2 gradPr   = side->gradPr;
 5728:          const Vector2 gradEta1 = side->gradEta1;
 5729:          const Vector2 gradEta2 = side->gradEta2;
 5730: 
 5731:          const Vector2 *btu = side->btu;
 5732:          const Vector2 *u2  = side->u2;
 5733:          const double coriolis = side->coriolis;
 5734:          const Vector2 *nuGradU = side->nuGradU;
 5735: 
 5736: 
 5737:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5738:          for (int k = kb + 1; k < nvrt; k++) {
 5739:             const int kin = k - kb - 1;
 5740: 
 5741:             const double dz_0 = side->Dz(k);
 5742:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5743: 
 5744:             rrhs[kin] = {0.0, 0.0};
 5745:             double dz = 0.0;
 5746: 
 5747:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5748:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5749:             if (k < nvrt  ) dz += dz_1;
 5750:             if (k > kb + 1) dz += dz_0;
 5751: 
 5752:             // Elevation gradient, atmospheric pressure and tidal potential
 5753:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5754: 
 5755:             // Coriolis, advection, wind stress, and horizontal viscosity
 5756:             if (k < nvrt - 1) {
 5757: 
 5758: 
 5759:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5760:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5761:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5762:                                                 
 5763: 
 5764:                //diff stress tensors 1006
 5765:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5766:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5767:                   assert(false && "Not implemented: itur == 5");
 5768:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5769:                }
 5770:                // else assert(false && "itur # Not implemented");
 5771: 
 5772:             } else { // k == nvrt - 1 SURFACE
 5773:                Vector2 tau2 = {0.0, 0.0};
 5774:                if constexpr(ics==1) {
 5775:                   tau2 = side->tau();
 5776:       
 5777:                } else {
 5778:                   assert(false && "Not implemented: ics == 2");
 5779:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5780:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5781:                   // taux2=(vn1+tt1)*0.5d0
 5782:                   // tauy2=(vn2+ss1)*0.5d0
 5783:                } // if ics
 5784: 
 5785:                rrhs[kin] += dt*tau2;
 5786:           
 5787: 
 5788:             } // if k<nvrt
 5789: 
 5790: 
 5791:             if (k > kb + 1) {
 5792:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5793:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5794:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5795: 
 5796:                // diff stress tensors 1006
 5797:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5798:                   assert(false && "Not implemented: itur == 5");
 5799:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5800:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5801:                }
 5802:                // else assert(false && "itur # Not implemented");
 5803: 
 5804: 
 5805:             } // if k>kbs + 1
 5806: 
 5807:             // Baroclinic
 5808:             Vector2 *bcc = side->bcc;
 5809:             if constexpr(ibc == 0) {
 5810:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5811:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5812: 
 5813:             } // if ibc==0
 5814: 
 5815:          } // k=kb + 1,nvrt
 5816: 
 5817: 
 5818:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5819: 
 5820:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5821:             const int kin = k - kb - 1;
 5822:    
 5823:             // Velocity is always clamped to maximum values
 5824:             side->u2[k] = clampVelocity(soln[kin]);
 5825:          } // k
 5826: 
 5827:       } // if side->is2D()
 5828:       
 5829: 
 5830:       // Impose velocity boundary condition at the bottom
 5831:       if constexpr(imm == 2) { // 3D bed deformation model
 5832:          double dep;
 5833:          Vector2 vel;
 5834: 
 5835:          assert(false && "Not implemented: imm == 2");
 5836:          //update_bdef(time, x0, y0, dep, vel);
 5837:          // side->u2[kb] = vel;
 5838: 
 5839:       } else { // imm = 0 or 1
 5840:          if (side->Cd() == 0.0) {
 5841:             side->u2[kb] = side->u2[kb + 1];
 5842: 
 5843:          } else if (side->is3D()) { // 3D no slip bottom   
 5844:             side->u2[kb] = {0.0, 0.0};
 5845: 
 5846:          }
 5847:           
 5848:       } // if imm
 5849: 
 5850:       // The velocities below the bottom level are set to zero
 5851:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5852: 
 5853: 
 5854:    }
 5855: 
 5856: 
 5857:    __global__ void applyMomentumBC(void) {
 5858: 
 5859:       SIDE_BND(sideBnd);
 5860: 
 5861:       Side *side = sideBnd->side;
 5862:       const BoundarySegment *segment = sideBnd->segment;
 5863:       const Node *n1 = side->n1;
 5864:       const Node *n2 = side->n2;
 5865: 
 5866:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5867: 
 5868:       const bool isLand = segment->isLand;
 5869:       const int ifltype = segment->ifltype;
 5870: 
 5871:       const int kb = side->kb;
 5872: 
 5873: 
 5874:       if (!isLand && ifltype != 0) {
 5875:          const Vector2 *ubc = sideBnd->ubc;
 5876:   
 5877:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5878:             
 5879:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5880:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5881: 
 5882:             if (ifltype == -1) {
 5883:                // Flather 1
 5884: 
 5885:                const double depth = side->depth();
 5886: 
 5887:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5888: 
 5889:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5890: 
 5891:                side->u2[k] = vnorm*side->n;
 5892: 
 5893:             } else if (ifltype == -2) { // Discharge
 5894: 
 5895:                const double eta1 = side->eta1();
 5896:                const double eta2 = side->eta2();
 5897:                const double htot = side->htot2();
 5898: 
 5899:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5900:                assert(false && "Not implemented: Discharge bc");
 5901:                // const double dischrg = discharge(eta1);
 5902:                const double dischrg = 0.0; // XXX REMOVE
 5903:                
 5904: 
 5905:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5906: 
 5907:                const double vnorm = dischrg*eta2/htot;
 5908: 
 5909:                side->u2[k] = vnorm*side->n;
 5910: 
 5911:             }
 5912:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5913:                const double vnorm = dot(side->u2[k], side->n);
 5914: 
 5915:                double rat;
 5916:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5917:                else              rat = segment->vobc2; // outgoing
 5918: 
 5919:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5920: 
 5921:             }
 5922:             else { // not Flather or 3D radiation
 5923:                side->u2[k] = ubc[k];
 5924: 
 5925:             } // if (segment->ifltype...
 5926: 
 5927:          }
 5928: 
 5929:       }
 5930:       else if (isLand) { // if it is land boundary side
 5931: 
 5932:          if constexpr(islip == 0) { // free slip
 5933: 
 5934:             for (int k = kb; k < nvrt; k++) {
 5935: 
 5936:                const Vector2 t = side->t();
 5937:                const Vector2 n = side->n;
 5938: 
 5939:                double vnorm = 0.0; // for most cases
 5940:                const double vtan = dot(side->u2[k], t);
 5941:                
 5942:                side->u2[k] = vtan*t - vnorm*n;
 5943: 
 5944:             }
 5945: 
 5946:          } else { // no slip
 5947:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5948: 
 5949:          }
 5950:       } // if (side segment type...
 5951: 
 5952:    
 5953: 
 5954:    }
 5955: 
 5956: 
 5957:    __global__ void shapiroFilter1(void) {
 5958:       // First step of the Shapiro filter (normally used if indvel<=0)
 5959:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5960: 
 5961:       SIDE(side);
 5962: 
 5963:       // Only internal wet sides are processed
 5964:       if (side->isDry || !(side->isInternal())) return;
 5965: 
 5966:       const int kb = side->kb;
 5967: 
 5968:       for (int mm = 0; mm < niter_shap; mm++) {
 5969: 
 5970:          for (int k = kb + 1; k < nvrt; k++) {
 5971:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5972:             Vector2 suru = {0.0, 0.0};
 5973: 
 5974:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5975: 
 5976:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5977: 
 5978:                int kin = k;
 5979:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5980:                
 5981:                if constexpr(ics==1) {
 5982:                   suru += nSide->u2[kin];
 5983: 
 5984:                } else {
 5985:                   assert(false && "Not implemented: ics == 2");
 5986:                   // Vector2 vn1, vn2;
 5987:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5988:                   // suru=suru+vn1;
 5989:                   // surv=surv+vn2;
 5990:                }
 5991:             }
 5992: 
 5993:             // Reusing bcc as a temporary array to store the suru values.
 5994:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5995: 
 5996:          }
 5997:       }
 5998:    }
 5999: 
 6000:    __global__ void shapiroFilter2(void) {
 6001:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6002: 
 6003:       SIDE(side);
 6004: 
 6005: 
 6006:       if (side->isDry || !(side->isInternal())) return;
 6007: 
 6008:       const int kb = side->kb;
 6009: 
 6010:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6011: 
 6012:       if (side->is2D()) {
 6013:          side->u2[kb + 1] = side->bcc[kb + 1];
 6014:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6015: 
 6016:       } else {
 6017:          // 3D
 6018:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6019:          
 6020:       }
 6021: 
 6022:    }
 6023: 
 6024: 
 6025:    __global__ void ul0UpdateZCoords(void) {
 6026:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6027:       
 6028:       NODE(node);      
 6029: 
 6030: 
 6031:       if (false) { //node->isDry) { XXXXXXX
 6032: 
 6033:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6034: 
 6035:          if constexpr(ivcor != 1) node->kb = 0;
 6036: 
 6037:       } else {
 6038: 
 6039:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6040:          node->updateKb();
 6041: 
 6042:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6043: 
 6044:       }
 6045: 
 6046:       // We use the temp.b field to store the previous state of isDry.
 6047:       node->tmp.b = node->isDry;
 6048: 
 6049:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6050:       node->isDry = true;
 6051: 
 6052:    }
 6053: 
 6054:    __global__ void ul0ComputeDryElements(void)
 6055:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6056:    {
 6057:       ELEM(elem);
 6058: 
 6059:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6060: 
 6061:       elem->kb = 0;
 6062: 
 6063:       if (elem->isDry) return;
 6064: 
 6065: 
 6066:    //    if(elem->isDry2()) { // XXXX
 6067:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6068:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6069:    //        call parallel_abort(errmsg)
 6070:    //    }
 6071: 
 6072:       const Node *n1 = elem->nodes[0];
 6073:       const Node *n2 = elem->nodes[1];
 6074:       const Node *n3 = elem->nodes[2];  
 6075:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6076: 
 6077:       // Computes element's kb as the minimum of the nodes' kb.
 6078:       const int kb1 = n1->kb;
 6079:       const int kb2 = n2->kb;
 6080:       const int kb3 = n3->kb;
 6081:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6082: 
 6083: 
 6084:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6085: 
 6086: 
 6087:       // Computes the element z as the mean of the nodes z.
 6088:       for (int k = elem->kb; k < nvrt; k++) {
 6089: 
 6090:          // Compute the element z as the mean of the nodes z.
 6091:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6092:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6093:          elem->z[k] /= elem->i34;
 6094: 
 6095:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6096:       }
 6097:                   
 6098:    }
 6099: 
 6100:    __global__ void ul0ComputeDryNodes(void)
 6101:    // Updates node's isDry based on the elements' isDry. 
 6102:    {
 6103:       NODE(node);
 6104: 
 6105:       node->isDry = true;
 6106: 
 6107:       // A node is wet if at least one of the elements sharing it is wet.
 6108:       for (int j = 0; j < node->numElements; j++) {
 6109:          const Element *elem = node->elements[j];
 6110:          if (!elem->isDry) {
 6111:             node->isDry = false;
 6112:             break;
 6113:          }
 6114:       }
 6115: 
 6116:        
 6117:    }
 6118: 
 6119: 
 6120:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6121:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6122:    // node->tmp.b is true if the node was previously dry.
 6123:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6124:    {
 6125:       NODE(node);
 6126:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6127: 
 6128:       // Avoid this the first time step.
 6129:       if (it == iths) return;  
 6130: 
 6131:       const bool wasDry = node->tmp.b;
 6132: 
 6133: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6134: 
 6135:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6136: 
 6137:          for (int k=0; k < nvrt; k++) {
 6138: 
 6139:             Vector3 utmp={0.0, 0.0, 0.0};
 6140: 
 6141:             double ttmp=0.0;
 6142:             double stmp=0.0;
 6143:             int icount=0;
 6144:             for (int j = 0; j < node->numNodes; j++) {
 6145: 
 6146:                const Node *nbrNode = node->nodes[j];
 6147:                
 6148:                const bool wasNbrDry = nbrNode->tmp.b;
 6149: 
 6150:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6151:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6152: 
 6153:                   icount++;
 6154: 
 6155:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6156:                   utmp += nbrNode->uvw2(k);
 6157:                   
 6158:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6159:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6160:                }
 6161:             }
 6162: 
 6163:             if (icount > 0) {
 6164:                const double inv_icount = 1.0/icount;
 6165:                utmp = inv_icount*utmp;
 6166:                node->u2[k]     = toVector2(utmp);
 6167:                node->w2[k]     = utmp.z;
 6168:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6169:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6170:             } else {
 6171:                node->u2[k] = {0.0, 0.0};
 6172:                node->w2[k] = 0.0;
 6173:                // Initialize tracers to 0.0??? XXXXX
 6174:             }
 6175:          }
 6176:       }
 6177:    }
 6178: 
 6179:   
 6180:    
 6181: 
 6182: 
 6183:    __global__ void ul0UpdateSides(int it, int iths) {
 6184:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6185:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6186:    // The dryness of the sides is updated in ul0UpdateSides2.
 6187: 
 6188:       SIDE(side);
 6189: 
 6190:       // A side is wet if and only if at least one of its elements is wet.
 6191:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6192:  
 6193:       const Node *n1 = side->n1;
 6194:       const Node *n2 = side->n2;
 6195:      
 6196:       const int kb1 = n1->kb;
 6197:       const int kb2 = n2->kb;
 6198: 
 6199:       side->kb = 0; // default when dry
 6200: 
 6201:       if (isWet) {
 6202: 
 6203:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6204: 
 6205:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6206: 
 6207:          side->kb = min(kb1, kb2);
 6208: 
 6209:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6210: 
 6211:          for (int k = side->kb; k < nvrt; k++) {
 6212:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6213: 
 6214:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6215: 
 6216:             // Compute velocity for re-wetted sides 
 6217:             if ((it != iths) && (side->isDry && isWet)) {
 6218: 
 6219:                Vector2 utmp={0.0, 0.0};
 6220: 
 6221:                int icount=0;
 6222: 
 6223:                // For all the sides on the two elements that share this side
 6224:                for (int j = 0; j < 2; j++) {
 6225:                   const Element *elem = side->elems[j];
 6226:                   if (elem == nullptr) continue;
 6227: 
 6228:                   for (int jj=0; jj < elem->i34; jj++) {
 6229:                      const Side *nSide = elem->sides[jj];
 6230:                      if (nSide->isDry) continue;
 6231: 
 6232:                      icount++;
 6233:                      utmp += nSide->u2[k];  
 6234:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6235:                   }
 6236:                }
 6237:                   
 6238:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6239:                if (icount > 0)  side->u2[k] = utmp/icount;
 6240:                else             side->u2[k] = {0.0, 0.0};
 6241:                   
 6242:             } // if ((it != iths) && (side->isDry && isWet))
 6243: 
 6244:          } // for k
 6245: 
 6246:       } // if isWet 
 6247:       
 6248: 
 6249: 
 6250:    }
 6251: 
 6252:    __global__ void ul0UpdateSides2(void) {
 6253:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6254:    
 6255:          SIDE(side);
 6256:    
 6257:          const Element *e1 = side->elems[0];
 6258:          const Element *e2 = side->elems[1];
 6259: 
 6260:          // A side is wet if and only if at least one of its elements is wet.
 6261:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6262: 
 6263:          // Update the side's dryness
 6264:          side->isDry = !isWet;
 6265: 
 6266:    }
 6267: 
 6268: 
 6269:    __global__ void zeroNodalVelocities(void) {
 6270:       NODE(node);
 6271: 
 6272:       for (int k = 0; k < nvrt; k++) {
 6273:          node->u2[k]   = {0.0, 0.0};
 6274:          node->w2[k]   = 0.0;
 6275:          node->utmp[k] = {0.0, 0.0};
 6276:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6277:       }
 6278:    }
 6279:  
 6280: 
 6281:    __global__ void computeNodalVerticalVelocities1(void) {
 6282:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6283:    // Adds the element's vertical velocity times the element's area.
 6284:       ELEM(elem);
 6285: 
 6286:       for (int j = 0; j < elem->i34; j++) {
 6287:          Node *node = elem->nodes[j];
 6288: 
 6289:          for (int k = node->kb; k < nvrt; k++) {
 6290:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6291:          }
 6292:          atomicAdd(&(node->tmp.d), elem->area);
 6293:       }
 6294:    }
 6295: 
 6296:    __global__ void computeNodalVerticalVelocities2(void) {
 6297:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6298:    // Divides by the total area of the elements sharing the    node.
 6299:       NODE(node);
 6300: 
 6301:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6302: 
 6303:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6304:    }
 6305: 
 6306: 
 6307:    __global__ void computeNodalHorizontalVelocities1(void) {
 6308: 
 6309:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6310:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6311: 
 6312:       ELEM(elem);
 6313: 
 6314:       if (elem->isDry) return;
 6315: 
 6316:       const int kb = elem->kb;
 6317:       const bool isTri = elem->isTri();
 6318: 
 6319:       if constexpr(indvel <= 0) {
 6320:          // Assuming discontinous hvel.
 6321: 
 6322:          if (isTri) { // For triangles
 6323:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6324:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6325: 
 6326:             for (int j = 0; j < 3; j++) {
 6327:                // For every node of the triangle...
 6328:                Node *node = elem->nodes[j];
 6329: 
 6330:                if (node->isDry) continue;
 6331: 
 6332:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6333:                const Side *s2 = elem->sides[(j + 1) % 3];
 6334:                const Side *s3 = elem->sides[(j + 2) % 3];
 6335: 
 6336:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6337: 
 6338:                atomicAdd(&(node->tmp.i), 1);
 6339: 
 6340:                for (int k = kb; k < nvrt; k++)  {
 6341:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6342:                   u = clampVelocity(u);
 6343:                   atomicAdd(&(node->utmp[k].x), u.x);
 6344:                   atomicAdd(&(node->utmp[k].y), u.y);
 6345: 
 6346:                }
 6347: 
 6348:             }
 6349:          }
 6350:          else { // For quads
 6351:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6352: 
 6353:          }
 6354: 
 6355:       }
 6356:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6357:       
 6358:    }
 6359: 
 6360: 
 6361:    __global__ void computeNodalHorizontalVelocities2(void) {
 6362:       NODE(node);
 6363: 
 6364:       const int nodeCount = node->tmp.i;
 6365: 
 6366:       if (nodeCount == 0) 
 6367:       {
 6368:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6369:          return;
 6370:       }
 6371: 
 6372:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6373:       
 6374:       const int kb = node->kb;
 6375: 
 6376:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6377:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6378:       
 6379:       
 6380:    }   
 6381: 
 6382:  
