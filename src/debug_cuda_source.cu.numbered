 2370: /**
 2371:  * This method performs backtracking from the side center until a time -dt back in time 
 2372:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2373:  * intermediate point.
 2374:  *
 2375:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2376:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2377:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2378:  * remaining time.
 2379:  * 
 2380:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2381:  * 
 2382:  * @param uuint, vvint, wwint: Velocities at the final point
 2383:  * @param jlev: Level at which the backtracking is performed
 2384:  * @param dt, dtbk: Tracking timesteps
 2385:  * @return: True if the backtracking was successful, false otherwise
 2386:  */
 2387: __inline__ __device__ bool Side::btrack(
 2388:       int jlev,
 2389:       double dt,            // Tracking time
 2390:       double dtbk,          // Tracking timestep
 2391:       Vector3 &u_int        // Velocities at the initial point
 2392: ) const {
 2393: 
 2394:    // Start from side center
 2395:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2396: 
 2397:  
 2398: 
 2399:    double time_rm = dt; // Remaining time
 2400: 
 2401: 
 2402:    // // Initialize outputs XXX
 2403:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2404:    //    sclr[i] = 0.0;
 2405:    // }
 2406: 
 2407: 
 2408:    // Initial velocities
 2409:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2410: 
 2411:    // Find the element that is in the direction opposite to the velocity
 2412:    Element* curElem = findElementTowards(toVector2(u_int));
 2413: 
 2414: 
 2415: 
 2416:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2417:    if (curElem == nullptr) {
 2418:       // Make velocity parallel to the side
 2419:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2420:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2421:       curElem = otherElem(curElem);
 2422:       
 2423:    }
 2424: 
 2425: // Nudges it towards the circumcenter
 2426: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2427: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2428:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2429: const double eps = 9.013e-3;                 
 2430: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2431: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2432: 
 2433: 
 2434: 
 2435:    const int MAX_ITERATIONS = 1000; 
 2436:    Element* nextElem = curElem;
 2437:    int iter = 0;
 2438:    while(true) {
 2439: 
 2440:       // Calculate timestep
 2441:       double dtb = min(dtbk, time_rm);
 2442: 
 2443:       // Next point in the backtracking curve
 2444:       Point3 xt = x0 - dtb*u_int;
 2445:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2446:       assert(found && "Backtracking failed in btrack");
 2447: 
 2448:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2449: 
 2450:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2451:                       // then time_rm needs to be increased by the unused time.
 2452: 
 2453:       // If the velocity is too small, we stop the backtracking
 2454:       const double vmag = length(toVector2(u_int));
 2455:       if (vmag <= velmin_btrack) break;
 2456: 
 2457:       // The current point becomes the next segment's starting point.
 2458:       x0 = xt;
 2459:  
 2460:       curElem = nextElem;
 2461: 
 2462:       iter++;
 2463:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2464:    }
 2465: 
 2466: 
 2467: }
 2468: 
 2469: 
 2470: 
 2471: // /**
 2472: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2473: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2474: 
 2475: //    Inputs:
 2476: //    @param x1, y1: point inside the element
 2477: //    @param x2, y2: other end of the line segment
 2478: 
 2479: //    Outputs:
 2480: //    @param intersectingSide:  side that intersects the line segment
 2481: //    @param nextElement: element that contains the intersection point
 2482: //    @param xIntersect, yIntersect: intersection point  
 2483: 
 2484: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2485: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2486: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2487: 
 2488: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2489: //    (Delta) being zero.
 2490: 
 2491: //    The intersection point happens when:
 2492: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2493: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2494:    
 2495: //    Assumption: the 4 points (including those of the side segment) are different.
 2496: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2497: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2498: //    If true, (xIntersect,yIntersect) is the intersection.				
 2499: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2500: // **/
 2501: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 2502: //                                                          Side& intersectingSide, Element& nextElement,
 2503: //                                                          double& xIntersect, double& yIntersect) {
 2504: //    for (int i = 0; i < i34; i++) {
 2505: //       const double x3 = nodes[i]->x;
 2506: //       const double y3 = nodes[i]->y;
 2507: //       const double x4 = nodes[nxq(i+1)]->x;
 2508: //       const double y4 = nodes[nxq(i+1)]->y;
 2509: 
 2510: //       const Side& side = sides[i];
 2511: 
 2512: //       xIntersect=-1.e25;
 2513: //       yIntersect=-1.e25;
 2514: 
 2515: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2516: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2517: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2518: 
 2519: //       if (delta != 0.0) {
 2520: //          // Solves the two linear equations for tt1 and tt2
 2521: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2522: //          const double tt2 = delta2/delta;
 2523: 
 2524: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2525: //          // Similarly, we use tt2 to compute the intersection point.
 2526: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2527: //             xIntersect = x3 + (x4 - x3)*tt2;
 2528: //             yIntersect = y3 + (y4 - y3)*tt2;
 2529: 
 2530: //             intersectingSide = side;
 2531: //             nextElement = nghbElems[i];
 2532: 
 2533: //             return true;
 2534: //          }
 2535:       
 2536: //       }
