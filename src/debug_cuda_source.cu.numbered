 1754: 
 1755: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1756:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1757: 
 1758:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1759: 
 1760:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1761:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1762:    // curElement.
 1763: 
 1764:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1765:    // And uses this velocity instead to continue the tracking.
 1766: 
 1767:    // computes the intersection point in cartesian coordinates
 1768:    Point2 intersection = nextSide->p_t(tt);
 1769: 
 1770:    // Nudges the point to the barycenter of the element. 
 1771:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1772:    // next segment intersects the element sides.  
 1773:    curElem->nudgeToBarycenter(intersection);
 1774: 
 1775:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1776:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1777:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1778:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1779: 
 1780:    // If the side is an open boundary, the tangential velocity is zero.
 1781:    if (nextSide->isBnd()) vtan = 0.0;
 1782: 
 1783:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1784:    const double us = vtan*nextSide->t().x;
 1785:    const double vs = vtan*nextSide->t().y;
 1786:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1787: 
 1788:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1789:    const double len2 = norm2(intersection - toPoint2(xt));
 1790:    const double vel2 = dot(u_int, u_int);        
 1791:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1792:    else            dt = 0.0;
 1793: 
 1794:    // The end of this tracking segment is now the intersection point.
 1795:    xt = {intersection.x, intersection.y, zint};
 1796: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1797:    u_int = {us, vs, ws};
 1798:    
 1799: }
 1800: 
 1801: /**
 1802:  * Tracks a particle through elements and vertical levels in the mesh.
 1803:  * 
 1804:  * @param x0,y0,z0     Starting position coordinates
 1805:  * @param xt,yt,zt     Target position coordinates
 1806:  * @param dtb          Time step for tracking
 1807:  * @param uuint,vvint,wwint Initial velocity components
 1808:  * @param nextElem     Starting/resulting element index
 1809:  * 
 1810:  * @return Status code of type trackExitCodes
 1811:  * 
 1812:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1813:  * of the details are different. The idea is that the code requires less branches and is better fit
 1814:  * for GPU execution.
 1815:  * 
 1816:  * The main ideas here are:
 1817:  * - The starting point is expected to be in the starting element.
 1818:  * - The end point is guaranteed to be inside an element.
 1819:  * - since the starting point is inside the element, there are only two cases: 
 1820:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1821:  *     (b) it does not and (xt,yt) is already in the starting element.
 1822:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1823:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1824:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1825:  * - tt1 can be positive or negative. We only consider the positive values.
 1826:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1827:  * - The next intersection will occur at the smallest positive tt1.
 1828:  * - This intersection will be the next (x0,y0) position.
 1829:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1830:  *   of getting stuck in a loop.
 1831:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1832:  *   was found.
 1833:  */
 1834: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1835:                                                        Element *&nextElem, int &jlev, double &dt) {
 1836: 
 1837:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1838:    // else to do.
 1839:    // If it is, nudges the point to be inside the element.
 1840:    const Element *curElem = nextElem;
 1841:    if (containsPoint(toPoint2(xt), true)) {
 1842: 
 1843:       curElem->interpolateVelocities(xt, u_int);
 1844: 
 1845:       return true;
 1846:    }
 1847: 
 1848:    Side *side = nullptr;
 1849: 
 1850:    // 1. Initial checks
 1851:    // Verify starting element is valid (wet)
 1852:    assert(!curElem->isDry && "Starting element is dry");
 1853: 
 1854:    // Checks if track has a zero length.
 1855:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1856:    // assert(len2 > 0.0 && "Zero length track"); 
 1857:    
 1858:    const int MAX_ITERATIONS = 1000;
 1859:    
 1860:    double t;
 1861:    Side *nextSide = nullptr;
 1862:    double tIntersect = 1e10;
 1863:    double zint = x0.z;
 1864: 
 1865:    // Horizontal tracking loop
 1866:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1867:    // (x0,y0) is inside the element but the target point is not.
 1868: 
 1869:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1870: 
 1871:    assert(found_intersection && "No intersection found at %d");
 1872: 
 1873:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1874: 
 1875:    // if the tracking segment goes out of water (either dry or edge boundary)
 1876:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1877: 
 1878: 
 1879:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1880: 
 1881:       nextElem = this;
 1882:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1883:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1884:       return true;    
 1885:    }
 1886: 
 1887: 
 1888:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1889:    int iterations = 0;
 1890:    while (iterations < MAX_ITERATIONS) {
 1891:       iterations++;
 1892:       
 1893:       Element *curElem = nextElem;
 1894: 
 1895:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1896: 
 1897:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1898: 
 1899:       // If we are already in the target element, we are done.
 1900:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1901:       if (!found_intersection) break;
 1902: 
 1903: 
 1904: 
 1905:       // if the tracking segment goes out of water (either dry or edge boundary).
 1906:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1907: 
 1908:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1909: 
 1910:          nextElem = curElem;
 1911: 
 1912:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1913:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1914:          return true;
 1915:       }
 1916:       
 1917:       // Update position and element for next iteration
 1918:       side = nextSide;
 1919: 
 1920:    }
 1921: 
 1922:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1923: 
 1924:  
 1925:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1926:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1927:    nextElem->interpolateVelocities(xt, u_int);
 1928: 
 1929: 
 1930:    return true;
 1931: }
 1932: 
 1933: 
 1934: __inline__ __device__ double Element::computeSignedArea(void) const {
 1935:    // Compute the area of the element
 1936: 
 1937:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1938: 
 1939:    // In the quad case we need to add the area of the other triangle.
 1940:    if (isQuad()) {
 1941:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1942:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1943:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1944:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1945:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1946:          Error("Negative area found in quad element");
 1947:       }
 1948:       res += ar1;
 1949:    }
 1950: 
 1951:    return res;
 1952: }
 1953: 
 1954: 
 1955: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 1956:                                                                 (nodes[1]->isDry2()) ||
 1957:                                                                 (nodes[2]->isDry2()) ||
 1958:                                                                 (i34==4 && nodes[3]->isDry2());
 1959: }
 1960: 
 1961: 
 1962: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1963:    // In boundary sides, the element 1 is nullptr
 1964:    return side->elems[1] == nullptr; 
 1965: }
 1966: 
 1967: 
 1968: 
 1969: /**
 1970:    Compute the shape coordinates of the point (xt,yt) in the element.
 1971:    @param xt (input): x-coordinate of the point
 1972:    @param shpCoords (output): shape coordinates of the point
 1973:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1974:    @return true if the point is inside the element, false otherwise
 1975: **/
 1976: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 1977:                                             bool fixNegshpCoord) const {
 1978: 
 1979:    // Compute the shape coordinates of the point xt in the element.
 1980:    if (i34==3) {
 1981:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1982:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1983:       // and in this case, the pt will be nudged into the element
 1984:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1985:       // from the local frame, so use additional check.
 1986: 
 1987:       Point2 x0, x1, x2;
 1988: 
 1989:       if constexpr(ics==1) {
 1990:          x0 = nodes[0]->p2();
 1991:          x1 = nodes[1]->p2();
 1992:          x2 = nodes[2]->p2();
 1993:       }
 1994:       else // lat/lon
 1995:       {
 1996:          Error("Not implemented yet");
 1997: #ifdef ICS2
 1998:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1999:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2000:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2001: #endif
 2002:       }
 2003: 
 2004:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2005:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2006:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2007:       shpCoords[3] = 0.0;
 2008:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2009: 
 2010:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2011:       // then we fix the negative shape coordinates.
 2012:       if (fixNegshpCoord && tmpmin<=0.0) {
 2013: 
 2014:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2015:          // keeping the sum of the shape coordinates equal to 1.
 2016:          // I have tested and compared the new algorithm with the old one, and they give
 2017:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2018:          // The new algorithm should be faster since it is branchless.
 2019:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 2020:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2021:          
 2022:          shpCoords[0] = (shpCoords[0] + a)*b;
 2023:          shpCoords[1] = (shpCoords[1] + a)*b;
 2024:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2025: 
 2026:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2027:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2028:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2029:          }
 2030: 
 2031:          // Update the point coordinates for the new shape coordinates
 2032:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2033:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2034:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2035: 
 2036:       }
 2037: 
 2038:       // Check if the point is inside the element
 2039:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2040:    }
 2041:    else {
 2042:       Error("Not implemented yet");
 2043: #ifdef QUADS
 2044:       // Reproject pt in eframe of nel for ics=2
 2045:       if constexpr(ics==1) {
 2046:          xn2 = xt; 
 2047:          yn2 = yt;
 2048:       }
 2049:       else {
 2050:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2051:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2052:       }
 2053: 
 2054:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2055: #endif
 2056:    }
 2057: 
 2058:    return false;  // Never reached
 2059: 
 2060: }
