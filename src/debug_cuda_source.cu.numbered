 5909:    __global__ void ul0UpdateSides(int it, int iths) {
 5910:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5911:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5912:    // The dryness of the sides is updated in ul0UpdateSides2.
 5913: 
 5914:       SIDE(side);
 5915: 
 5916:       // A side is wet if and only if at least one of its elements is wet.
 5917:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5918:  
 5919:       const Node *n1 = side->n1;
 5920:       const Node *n2 = side->n2;
 5921:      
 5922:       const int kb1 = n1->kb;
 5923:       const int kb2 = n2->kb;
 5924: 
 5925:       side->kb = 0; // default when dry
 5926: 
 5927:       if (isWet) {
 5928: 
 5929:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5930: 
 5931:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5932: 
 5933:          side->kb = min(kb1, kb2);
 5934: 
 5935:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5936: 
 5937:          for (int k = side->kb; k < nvrt; k++) {
 5938:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5939: 
 5940:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5941: 
 5942:             // Compute velocity for re-wetted sides 
 5943:             if ((it != iths) && (side->isDry && isWet)) {
 5944: 
 5945:                Vector2 utmp={0.0, 0.0};
 5946: 
 5947:                int icount=0;
 5948: 
 5949:                // For all the sides on the two elements that share this side
 5950:                for (int j = 0; j < 2; j++) {
 5951:                   const Element *elem = side->elems[j];
 5952:                   if (elem == nullptr) continue;
 5953: 
 5954:                   for (int jj=0; jj < elem->i34; jj++) {
 5955:                      const Side *nSide = elem->sides[jj];
 5956:                      if (nSide->isDry) continue;
 5957: 
 5958:                      icount++;
 5959:                      utmp += nSide->u2[k];  
 5960:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5961:                   }
 5962:                }
 5963:                   
 5964:                // assert(icount > 0 && "No wet sides around this side");  XXXXX RECOVER??? 
 5965:                if (icount > 0)  side->u2[k] = utmp/icount;
 5966:                else             side->u2[k] = {0.0, 0.0};
 5967:                   
 5968:             } // if ((it != iths) && (side->isDry && isWet))
 5969: 
 5970:          } // for k
 5971: 
 5972:       } // if isWet 
 5973:       
 5974: 
 5975: 
 5976:    }
 5977: 
 5978:    __global__ void ul0UpdateSides2(void) {
 5979:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5980:    
 5981:          SIDE(side);
 5982:    
 5983:          const Element *e1 = side->elems[0];
 5984:          const Element *e2 = side->elems[1];
 5985: 
 5986:          // A side is wet if and only if at least one of its elements is wet.
 5987:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5988: 
 5989:          // Update the side's dryness
 5990:          side->isDry = !isWet;
 5991: 
 5992: if (side->isDry) {for (int k = 0; k < nvrt; k++) {side->u2[k] = {0.0, 0.0};side->w2[k] = 0.0;}}  // XXXX KKKKKK Not in the original code
 5993: 
 5994:    }
