 8542: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8543:    Element *elems = mesh->localElemData;
 8544: 
 8545:    *addr = elems;
 8546:    *sizeElement = sizeof(Element);
 8547:    switch (varCode) {
 8548:       case (int)VarCode::z:
 8549:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8550:          *sizeType = sizeof(double);
 8551:          break;
 8552:       case (int)VarCode::x:
 8553:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8554:          *sizeType = sizeof(Vector2);
 8555:          break;
 8556:       case (int)VarCode::gradETP:
 8557:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8558:          *sizeType = sizeof(Vector2);
 8559:          break;
 8560:       case (int)VarCode::area:
 8561:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8562:          *sizeType = sizeof(double);
 8563:          break;
 8564:       case (int)VarCode::depth:
 8565:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8566:          *sizeType = sizeof(double);
 8567:          break;
 8568:       case (int)VarCode::radius:
 8569:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8570:          *sizeType = sizeof(double);
 8571:          break;
 8572:       case (int)VarCode::ghat:
 8573:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8574:          *sizeType = sizeof(Vector2);
 8575:          break;
 8576:       case (int)VarCode::kb:
 8577:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8578:          *sizeType = sizeof(int);
 8579:          break;
 8580:       case (int)VarCode::isdry:
 8581:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8582:          *sizeType = sizeof(int);
 8583:          break;            
 8584:       case (int)VarCode::w:
 8585:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8586:          *sizeType = sizeof(double);
 8587:          break;
 8588:       case (int)VarCode::FaceIndices:
 8589:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8590:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8591:          *sizeType = sizeof(Node);
 8592:          break;
 8593:       default:
 8594:          *offset = -1;
 8595:    }
 8596: }
