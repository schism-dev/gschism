 6430: #ifdef DONTCOMPILE
 6431: __device__ void computeVerticalAdvection(void) {
 6432:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6433: 
 6434:    sdbt(1:2,:,:)=0.d0
 6435: 
 6436:    const Side *side = FROM kernel;
 6437: 
 6438:    if(side->isDry) return;
 6439: 
 6440:    // If side is wet...
 6441: 
 6442: 
 6443:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6444:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6445:    double ws[nvrt] = {} // w @ side
 6446:    int icount = 0;
 6447:    for (int j=0; j<2; j++) {
 6448:       const Element *elem = side->elements[j];
 6449:        
 6450:       if(elem != nullptr) {
 6451:          icount++;
 6452:          for (int k=0; k<nvrt; k++) {
 6453:             ws[k] = ws[k] + elem->w[k];
 6454:          }
 6455:       }
 6456:    }  // for j
 6457: 
 6458:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6459:    ws = ws/icount;
 6460: 
 6461:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6462:    // Splines allow for a smooth transition between vertical levels.
 6463:    // Splines have continuity restrictions at the internal knots, but
 6464:    // we have to provide the 1st derivatives at the endpoints.
 6465:    const int kbs = side->kbs; 
 6466:    
 6467:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6468:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6469:    initCubicSpline(kbs, nvrt, side, ws, up)
 6470: 
 6471:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6472:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6473:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6474: 
 6475:    // Total advection (average onto side)
 6476:    const Node *node1 = side->nodes[0];
 6477:    const Node *node2 = side->nodes[1];
 6478:    for (int k=kbs(i); k<nvrt; k++) {
 6479: 
 6480:       if constexpr(ics==1) {
 6481:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6482:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6483:       } else {
 6484:          // XXX IMPLEMENT THIS
 6485:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6486:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6487:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6488:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6489:       }  // if ics
 6490: 
 6491: 
 6492:    }
 6493: }
 6494: #endif
 6495: 
 6496: 
 6497: extern "C" {
 6498:    __global__ void computeElemAverageGhat(void) {
 6499:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6500: 
 6501:       ELEM(elem);
 6502:       
 6503:       elem->ghat1= {0.0, 0.0};  
 6504: 
 6505:       if constexpr(ihydraulics != 0) {
 6506:          if (nhtblocks > 0 && elem->isblock) return;
 6507:       }
 6508: 
 6509:       if (elem->isDry) return;
 6510: 
 6511:       // Wet elements.
 6512:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6513:       // tidal potential, horizontal diffusion, and baroclinic etc
 6514:       // Remember to update both fb and F 
 6515:       // If ics=2, ghat1 are in eframe (ll)
 6516:       // cff1-3: coefficients for 2D/3D
 6517:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6518:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6519:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6520: 
 6521:       double av_cff1 = 0.0;  // av. for cff1
 6522:       double av_cff2 = 0.0;  // av. for cff2
 6523:       double av_cff3 = 0.0;  // av. for cff3
 6524:       double av_df = 0.0;  // av. for H^\alpha / H
 6525:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6526:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6527: 
 6528:       const int i34 = elem->i34;
 6529:       const int kb = elem->kb;
 6530: 
 6531:       for (int j=0; j<i34; j++) {
 6532:          // For each node and side in the element...
 6533: 
 6534:          const Node *node = elem->nodes[j];
 6535:          const Side *side = elem->sides[j];
 6536: 
 6537:          const double chi      = side->chi;
 6538:          const double veg_c2   = side->veg_c2;
 6539:          const double veg_beta = side->veg_beta;
 6540:          const double veg_h    = side->veg_h();
 6541:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6542: 
 6543:          // Node - const in elem
 6544:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6545:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6546: 
 6547:          if (elem->depth >= tip_dp) {
 6548:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6549:          }
 6550: 
 6551:          
 6552:          const double htot  = side->htot2();        // Total depth at the side
 6553:          const double zctr2 = side->zTopCanopy();  
 6554: 
 6555:          double cff1; 
 6556:          double cff2; 
 6557:          double cff3;   
 6558:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6559:          // coefficients applied to 2D/3D case 
 6560:             cff1 = side->hhat/htot;
 6561:             cff2 = 0.0;
 6562:             cff3 = 0.0;
 6563:          } else { //3D
 6564:             //Init for no-veg case
 6565:             cff1 = 1.0;
 6566:             cff2 = 1.0;
 6567:             cff3 = 0.0;
 6568: 
 6569:             if constexpr(iveg != 0) {
 6570:                // Computes coefficients used with vegetation terms G1, G2
 6571:                // cff1, cff3 are used for the first two terms in G1, G2:
 6572:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6573:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6574:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6575:                if(veg_h < 0.99*htot) { // submergent vegetation
 6576:                   cff1=1;
 6577:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6578:                   cff3 = veg_c;
 6579: 
 6580:                } else { // emergent vegetation
 6581:                   cff1 = 1.0/(1.0 + veg_c2);
 6582:                   cff2 = cff1;
 6583:                   cff3 = 0.0;
 6584: 
 6585:                }
 6586:             } // if iveg
 6587:          } //  2D/3D
 6588: 
 6589:          av_cff1 += cff1/i34;
 6590:          av_cff2 += cff2/i34;
 6591:          av_cff3 += cff3/i34;
 6592:          av_cff2_chi += cff2*chi/i34;
 6593:          av_cff3_chi += cff3*chi/i34;
 6594:          av_df += min(htot, veg_h)/(htot*i34);
 6595: 
 6596: 
 6597:          // btrack values: U^\star, U^{\star\alpha}
 6598:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6599:          Vector2 Ustar       = {0.0, 0.0}; 
 6600:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6601: 
 6602:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6603:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6604:          } else { //3D
 6605:             for (int k = side->kb; k < nvrt; k++) {
 6606:             
 6607:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6608:                Ustar += w2;
 6609: 
 6610:                if constexpr(iveg != 0) {
 6611:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6612:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6613:                        Ustar_alpha += zrat*w2; // XXXX
 6614:                    }
 6615:                }  // if iveg
 6616:             }  // for k
 6617:          }  //2D/3D
 6618:          
 6619: 
 6620:          // Add btrack & surface stress terms to \breve{G} first
 6621:          if constexpr(ics==1) {
 6622: 
 6623:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6624: 
 6625:          } else {
 6626:             // XXX IMPLEMENT THIS
 6627:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6628:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6629:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6630:          }  // if ics
 6631: 
 6632:          // Surface and bottom stress terms
 6633:          if constexpr(ics==1) {
 6634:             const Vector2 tau    = side->tau();
 6635:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6636: 
 6637:             // Term for surface and bottom stress
 6638:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6639: 
 6640:          } else {
 6641:             assert(false && "computeElemAverageGhat: Not implemented");
 6642:             // XXX IMPLEMENT THIS
 6643:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6644:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6645:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6646:             // tau_x=(vn1+tt1)/2.d0
 6647:             // tau_y=(vn2+ss1)/2.d0
 6648:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6649:          }  // if ics
 6650: 
 6651:          
 6652: 
 6653:          // All terms in F,F^\alpha,f_b except baroclinic
 6654:          // F, f_b: all explicit terms excluding vegetation 
 6655:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6656:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6657:          const double coriolis = side->coriolis;
 6658:          Vector2 F  =  coriolis*side->U;  // F_x
 6659:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6660:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6661: 
 6662:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6663:             
 6664:             for (int k = side->kb; k < nvrt; k++) {
 6665:                if (zctr2 > side->zc[k-1]) {
 6666:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6667:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6668:                    Fa +=  coriolis*w2*zrat;
 6669:                } // if zctr2
 6670:             } // k
 6671:          } // iveg
 6672: 
 6673:          // Integrate horizontal viscosity force vertically
 6674:          for (int k=side->kb + 1; k<nvrt; k++) {
 6675:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6676: 
 6677:             F += levelHorVisc;
 6678: 
 6679:             // Vegetation term
 6680:             if constexpr(iveg!=0) {
 6681:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6682:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6683:                   Fa += levelHorVisc*zrat;
 6684:                } 
 6685:             } // if iveg
 6686:          } // for k
 6687: 
 6688:          fb += side->nuGradU[side->kb];
 6689: 
 6690:          // Add to ghat1
 6691:          if constexpr(ics==2) {
 6692:             // XXX IMPLEMENT THIS
 6693:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6694:             // bigf1=vn1; bigf2=vn2
 6695:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6696:             // botf1=vn1; botf2=vn2
 6697:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6698:             // bigfa1=vn1; bigfa2=vn2
 6699:          } // if ics
 6700: 
 6701:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6702:       } // for j (nodes and sides)
 6703: 
 6704:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6705:          
 6706:       // Finish off terms in F, F^\alpha and f_b
 6707:       const double grav3 = elem->mean(&Node::grav2);
 6708:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6709: 
 6710: 
 6711:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6712:       for (int j=1; j<i34; j++) { 
 6713:          // For each side in the element...
 6714:          const Side *side = elem->sides[j];
 6715:          const double chi = side->chi;
 6716: 
 6717:          const double htot = side->htot2();
 6718:          const double veg_h = side->veg_h();
 6719:          const Vector2 F  = htot*fb;
 6720:          const Vector2 Fa = min(htot, veg_h)*fb;
 6721: 
 6722:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6723:       } // for j
 6724: 
 6725:       //botf1 etc are already in elem frame
 6726:       elem->ghat1 += tmp/i34;
 6727: 
 6728:       // Baroclinic force
 6729:       if constexpr(ibc==0) {
 6730:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6731: 
 6732:          Vector2 Fa = {0.0, 0.0};
 6733:          Vector2 intGradRho = {0.0, 0.0};
 6734:          
 6735:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6736:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6737:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6738: 
 6739:             // \in F [m^2/s/s]
 6740:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6741:          }
 6742: 
 6743:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6744:          const Vector2 F = av_df*Fa; //approx
 6745:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6746: 
 6747:       } // if ibc
 6748: 
 6749: 
 6750: 
 6751:    }
 6752: 
 6753: } // extern "C"
 6754: 
 6755: 
 6756: 
 6757: #ifdef DONTCOMPILE
 6758: __global__ void checkMassConservation(Tracers* sumtr) {
 6759: 
 6760:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6761: 
 6762:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6763: 
 6764:    Element *elem = &(mesh->localElemData[i]);
 6765: 
 6766:    // Skip dry elements
 6767:    if (elem->isDry) return;
 6768: 
 6769:    // Local sum array for this thread
 6770:    double localSum[N_TRACERS] = {0.0};
 6771: 
 6772:    // Sum over vertical levels for this element
 6773:    const int kbe = elem->kbe;
 6774:    const double area = elem->area;
 6775: 
 6776:    for (int k = kbe; k < nvrt; k++) {
 6777:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6778:       
 6779:       // Accumulate tracer mass
 6780:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6781:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6782:       }
 6783:    }
 6784: 
 6785:    
 6786: 
 6787:    //  This function returns per element sums. A reduction must be done on the host side.
 6788: }
 6789: 
 6790: 
 6791: __global__ void transport(void) {
 6792: 
 6793:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6794: 
 6795:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6796: 
 6797:    Element *elem = &(mesh->localElemData[ie]);
 6798: 
 6799:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6800: 
 6801:                for (int m=0; m<ntr; m++) {
 6802:                   for (int k=kbe(ie); k<nvrt; k++) {
 6803:                      // Calculate each polynomial's weight 
 6804:                      wm=0.d0; sum1=0.d0; 
 6805:                      wm1=0.d0; wm2=0.d0; 
 6806:                      for (int i=0; i<elem->nweno2; i++) {
 6807:                   
 6808:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6809:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6810:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6811:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6812:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6813:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6814:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6815:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6816:                      // -----------------Hu and Shu (1999)'s method----------------
 6817:                      b4=b1+b2+b3
 6818: 
 6819: //Error: add PRODUCTION CPP
 6820: #ifdef DEBUG
 6821:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6822:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6823:                     call parallel_abort(errmsg)
 6824:                   }
 6825: #endif
 6826: 
 6827:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6828:                   // !----test-------------- 
 6829:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6830:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6831:                   // !wm(i)=wm1(i)*wm2(i)
 6832:                   // !---------------------- 
 6833:                   sum1=sum1+wm(i)
 6834:                 } // end for i
 6835: 
 6836:                 wm=wm/sum1
 6837: 
 6838:                 for (int j=0; j<elem->i34; j++) {
 6839: 
 6840:                   const Side *side  = elem->sides[j];
 6841:                   const Node *node1 = side->n1;
 6842:                   const Node *node2 = side->n2;
 6843: 
 6844:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6845:                      trsd=0.d0
 6846:                      for (int kk=0; kk<nquad; kk++) {
 6847:                         for (int i=0; i<elem->nweno2; i++) {
 6848:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6849:                         } // end for i   
 6850:                      } // end for kk
 6851:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6852:                   } // outward flux
 6853:                } // end for j=1,i34(ie) ! side
 6854:             }
 6855:          }
 6856:               
 6857: 
 6858: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6859: //             //   calculate each polynomial's weight 
 6860: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6861: //                 wm=0.d0; sum1=0.d0
 6862: //                 do i=1,nweno1(ie) !for each polynomial
 6863: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6864: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6865: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6866: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6867: //                   wm(i)=b2
 6868: //                   sum1=sum1+b2
 6869: //                   !wm(i)=1.d0
 6870: //                   !sum1=sum1+1.d0
 6871: 
 6872: // // Error: PRODUCTION
 6873: // #ifdef DEBUG
 6874: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6875: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6876: //                     call parallel_abort(errmsg)
 6877: //                   endif
 6878: // #endif
 6879: 
 6880: //                 enddo !i
 6881: //                 wm=wm/sum1 !final weight
 6882: 
 6883:                 for (int j=0; j<elem->i34; j++) { // side
 6884:                   const Side *side = elem->sides[j];
 6885:                   const Node *node1 = side->n1;
 6886:                   const Node *node2 = side->n2;
 6887: 
 6888:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6889:                     trsd=0.d0
 6890:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6891:                       for (int i=0; i<elem->nweno1; i++) {
 6892:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6893:                       }
 6894:                     enddo //kk
 6895:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6896:                   } // outward flux
 6897:                 } // end for j=1,i34(ie) ! side
 6898:               } // end for k; ntr 
 6899: 
 6900:             else !simple upwind method
 6901:               do j=1,i34(ie)
 6902:                 jsj=elside(j,ie)
 6903:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6904:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6905:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6906:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6907:                   endif
 6908:                 enddo  !vertical layers
 6909:               enddo !j=1,i34(ie) ! side
 6910:             endif !order of accuracy
 6911: 
 6912:          //  enddo !ie
 6913: // !$OMP     end do
 6914: 
 6915: // !$OMP     master
 6916: //           !message passing
 6917: //           if (nproc>1) then
 6918: //             !make a copy of side concentrations
 6919: //             trsd_tmp0=trsd_tmp 
 6920: 
 6921: //             !this exchange routine swaps interface concentration between two partitions
 6922: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6923: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6924: 
 6925: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6926: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6927: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6928: 
 6929: 
 6930: //             !This obtains final values for interface sides
 6931: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6932: //       :    endif !nproc>1
