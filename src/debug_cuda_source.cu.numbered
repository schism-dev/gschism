  606:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  607:    
  608:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  609: 
  610:    __device__ double intPhiPhi(int i1, int i2) const;
  611:    
  612:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  613: 
  614:    __device__ Vector2 grad2(double *a) const
  615:    {
  616:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  617:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  618:       if (isQuad()) {
  619:          gx += a[3]*gradPhi[3].x;
  620:          gy += a[3]*gradPhi[3].y;
  621:       }
  622:       return {gx, gy};
  623:    }
  624: 
  625:    __device__ Vector2 grad2(double Node::* field) const
  626:    {
  627:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  628:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  629:       if (isQuad()) {
  630:          gx += (nodes[3]->*field)*gradPhi[3].x;
  631:          gy += (nodes[3]->*field)*gradPhi[3].y;
  632:       }
  633:       return {gx, gy};
  634:    }
  635: 
  636:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  637:    __device__ __forceinline__ Vector3 n(int k) const {
  638:       double area3D;
  639:       return n(k, area3D);
  640:     }
