  460: 
  461: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  462: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  463: //
  464: 
  465:    const double radius2 = dot(p, p);
  466:    const double radius = sqrt(radius2);
  467:  
  468:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  469:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  470: 
  471:    rlon = atan2(p.y, p.x); // (-pi,pi]
  472: 
  473:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  474:       rlat = asin(p.z/radius);
  475:    } else {
  476:       rlat = asin(p.z/rearth_pole);
  477:    }
  478:   
  479: }
  480: 
  481: 
  482: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  483: // Compute the 3D Cartesian coordinates from the latitude and longitude
  484: // Inputs:
  485: //        lat: latitude in radians
  486: //        lon: longitude in radians
  487: // Output:
  488: //        x, y, z: 3D Cartesian coordinates
  489: 
  490:    double sin_lat, cos_lat, sin_lon, cos_lon;
  491: 
  492:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  493:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  494: 
  495:    sincos(lat, &sin_lat, &cos_lat);
  496:    sincos(lon, &sin_lon, &cos_lon);
  497: 
  498:    const double x = rearth_eq*cos_lat*cos_lon;
  499:    const double y = rearth_eq*cos_lat*sin_lon;
  500:    const double z = rearth_pole*sin_lat;
  501: 
  502:    return make_double3(x, y, z);
  503: }
