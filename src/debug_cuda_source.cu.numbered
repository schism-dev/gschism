 1951: __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p, const Side* origSide) {
 1952: // If ics == 2, convert the global point to the local frame of the original side
 1953:    
 1954:    if constexpr (ics == 1) {
 1955:       return p;
 1956:    } else {
 1957:       const Point3 c = {origSide->center.x, origSide->center.y, origSide->centerZ()};
 1958:       const Point3 p2 = origSide->frame.G2L(p - c);
 1959:       return p2; // only the horizontal components
 1960:    }
 1961: }
 1962: 
 1963: __device__ __forceinline__ Point2 toLocalFrame(Point2 const& p, const Side* origSide) {
 1964: // If ics == 2, convert the global vector to the local frame of the original side
 1965:    return toPoint2(toLocalFrame(toPoint3(p, 0.0), origSide));
 1966: }
