 8378: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8379:    // Get the value of a variable from an element
 8380:    // varName is the name of the variable to get
 8381:    // var is the array to store the value
 8382:    // k is the vertical level index of the variable to get
 8383: 
 8384:    ELEM(elem);
 8385:    
 8386:    int idx = elem->idx;
 8387:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8388: 
 8389:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8390:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8391:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8392:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8393:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8394:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8395:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8396:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8397:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8398:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8399:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8400:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8401:       
 8402:    
 8403: }
 8404: 
 8405: 
 8406: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8407:    // Get the value of a variable from an node
 8408:    // varName is the name of the variable to get
 8409:    // var is the array to store the value
 8410:    // k is the vertical level index of the variable to get
 8411: 
 8412:    NODE(node);
 8413:    
 8414:    int idx = node->idx;
 8415:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8416: 
 8417:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8418:    
 8419:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8420:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8421:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8422:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8423:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8424:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8425:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8426:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8427:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8428:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8429:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8430:    
 8431:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8432:       
 8433:    
 8434: }
 8435: 
 8436: 
 8437: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8438:    // Get the value of a variable from an side
 8439:    // varName is the name of the variable to get
 8440:    // var is the array to store the value
 8441:    // k is the vertical level index of the variable to get
 8442:    SIDE(side);
 8443:    
 8444:    int idx = side->idx;
 8445:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8446: 
 8447:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8448:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8449:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8450:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8451:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8452:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8453:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8454:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8455:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8456:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8457:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8458:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8459:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8460:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8461:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8462:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8463:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8464:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8465:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8466:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8467:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8468:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8469:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8470:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8471:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8472:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8473:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8474:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8475:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8476:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8477:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8478:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8479:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8480:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8481:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8482:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8483: }
 8484: 
 8485: 
 8486: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8487:    // Get the value of a variable from an side
 8488:    // varName is the name of the variable to get
 8489:    // var is the array to store the value
 8490:    // k is the vertical level index of the variable to get
 8491:    SIDE_BND(sideBnd);   
 8492: 
 8493:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8494:    if (sideBnd->segment->isLand) idx = -7;
 8495: 
 8496:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8497:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8498: 
 8499: }
