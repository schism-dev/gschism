 8114:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8115:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 8116:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 8117:    double *drag, double *roughness) {
 8118:    mesh->populateElements(i34, elnode, elside,
 8119:                           node_coords, node_coords_ll, use_ll,
 8120:                           wind_rotate_angle,   
 8121:                           isdel, isidenode, isbnd,
 8122:                           nond, nlnd, iond, ilnd,                                  
 8123:                           nodeNeighNodesStart, nodeNeighNodesIndices, nodeNeighElemsStart, nodeNeighElemsIndices, globalNodeIndices, globalElemIndices, globalSideIndices, localNodeIndices, localElemIndices, localSideIndices, localNodePart, localElemPart, localSidePart, drag, roughness);                          
 8124: 
 8125: } 
