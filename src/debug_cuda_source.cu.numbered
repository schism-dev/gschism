 4157: 
 4158:    __global__ void scaleGravity(double loadtide_coef) {
 4159: 
 4160: 
 4161:       NODE(node);
 4162: 
 4163:       // SAL option: scale gravity
 4164:       if constexpr(iloadtide==2) {  // simple const
 4165:          node->grav2 = grav*(1.0 - loadtide_coef);
 4166: 
 4167:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4168:         
 4169:           const double depth = max(node->depth, 0.0);
 4170:           const double tmp1 = sqrt(depth);
 4171:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4172:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4173:                              2.6969e-13*depth*depth*depth*tmp1;
 4174:           
 4175:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4176:           
 4177: 
 4178: 
 4179:           node->grav2 = grav*(1.0 - beta_bar);
 4180: 
 4181:       } else {  // iloadtide=0,1
 4182:           node->grav2 = grav;
 4183: 
 4184:       }
 4185: 
 4186:    }
 4187: 
