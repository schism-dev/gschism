 2518: __device__ void Element::trackGoesOutOfWater(const Side *nextSide, const Side *origSide, Element *curElem, double tt, int jlev,
 2519:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2520: 
 2521:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2522:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2523:    // curElement.
 2524: 
 2525:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2526:    // And uses this velocity instead to continue the tracking.
 2527: 
 2528:    // computes the intersection point in local cartesian coordinates
 2529: //    Point3 intersection = origSide->toLocalFrame(nextSide->p3_t(tt));  // XXXX I don't think this is necessary. The intersection is already computed in findNextIntersection.
 2530: 
 2531: //    // Nudges the point to the barycenter of the element. 
 2532: //    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2533: //    // next segment intersects the element sides. 
 2534: //    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2535: 
 2536: 
 2537: //    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2538: //    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2539: //    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2540: //    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2541: 
 2542: //    // If the side is an open boundary, the tangential velocity is set to zero.
 2543: //    if (nextSide->isBnd()) vtan = 0.0;
 2544: 
 2545: //    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2546: //    const double us = vtan*nextSide->t().x;
 2547: //    const double vs = vtan*nextSide->t().y;
 2548: //    const double ws = nextSide->w2(jlev); 
 2549: 
 2550: //    u_int = {us, vs, ws};
 2551: 
 2552: //    // The end of this tracking segment is now the intersection point.
 2553: //    xt = {intersection.x, intersection.y, zint};
 2554: // // printf("trackGoesOutOfWater: intersection = (%.17f, %.17f, %.17f), zint = %.17f, u_int = (%.17f, %.17f, %.17f)\n", intersection.x, intersection.y, zint, u_int.x, u_int.y, u_int.z);
 2555:    
 2556: }
