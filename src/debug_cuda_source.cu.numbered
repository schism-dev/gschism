 2259: 
 2260: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2261: 
 2262:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2263:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2264:    const Node *n1 = side->n1;
 2265:    const Node *n2 = side->n2;
 2266: 
 2267:    bool n1_match = (n1->nodeBnd->segment == segment);
 2268:    bool n2_match = (n2->nodeBnd->segment == segment);
 2269: 
 2270:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2271:    if (n1_match && n2_match) {
 2272:       return 0.5;
 2273:    } else if (n1_match) {
 2274:       return 1.0;
 2275:    } else if (n2_match) {
 2276:       return 0.0;
 2277:    }
 2278:    return 0.0;
 2279: }
 2280: 
 2281: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2282: 
 2283: 
 2284: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2285: 
 2286:    const double w1 = getBoundaryArrayValueWeight();
 2287:    const double w2 = 1.0 - w1;
 2288:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2289:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2290: 
 2291:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2292: }
 2293: 
 2294: 
 2295: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2296:    const double w1 = getBoundaryArrayValueWeight();
 2297:    const double w2 = 1.0 - w1;
 2298:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2299:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2300: 
 2301:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2302: }
