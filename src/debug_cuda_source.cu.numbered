 5838:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5839: 
 5840:       SIDE(side);
 5841: 
 5842:       side->U = {0.0, 0.0}; 
 5843:          
 5844:       if(side->isDry) return;
 5845: 
 5846:       // Vertically integrated velocity U
 5847:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5848:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5849:          side->U += side->Dz(k + 1)*uc;  
 5850:       }
 5851: 
 5852:    }
 5853: 
 5854:    __global__ void computeBottomDragVegetation(void) {
 5855:       // UNFINISHED. CHECK THIS:
 5856:       // How many kernels are needed? Why so many for loops?
 5857:       // Is the loop on sides needed?
 5858: 
 5859:       NODE(node);
 5860: 
 5861: 
 5862:       const int    kb      = node->kb;
 5863:       const double htot    = node->htot2(); 
 5864:       
 5865:       if (node->isDry) {
 5866:          // Default values for dry nodes
 5867:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5868:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5869: 
 5870:          return;
 5871:        
 5872:       }
 5873: 
 5874:       // Computes bottom drag Cd based on the selected nchi
 5875:       node->computeBottomDragCd();
 5876:       
 5877: 
 5878: 
 5879:       //   Bottom stress in m^2/s^2
 5880:       if (node->rho[kb + 1] >= -98.0)
 5881:       {
 5882:          const double mag_u = length(node->u2[kb + 1]);
 5883:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5884: 
 5885:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5886:          // !sediment erosion: this part needs more documentation
 5887:       }
 5888:     
 5889: 
 5890: 
 5891:       // Compute vegetation parameters
 5892:       //--------------------------------
 5893: 
 5894:       // SAV constants
 5895:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5896:       constexpr double veg_cfpsi = 0.16;
 5897: 
 5898:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5899:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5900: 
 5901:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5902:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5903:          int kbin = 0; // bin index
 5904:          for (int k = kb; k < nvrt; k++) {
 5905:             // Computes node height above the bottom level
 5906:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5907:             assert(false && "Vertical variation of vegetation not implemented");
 5908: 
 5909:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5910:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5911:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5912:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5913:             // } else {
 5914:             //    // Find the bin at which the current vertical level is
 5915:             //    while (kbin<nbins_veg_vert) {
 5916:             //       const double zn = node->z[kbin];
 5917:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5918:             //          break;
 5919:             //       } // if
 5920:             //       kbin++;
 5921:             //    } // while
 5922:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5923: 
 5924:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5925:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5926:                
 5927:             //    // Linear interpolation of the vegetation parameters
 5928:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5929:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5930:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5931:             // } // if rl10
 5932: 
 5933:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5934: 
 5935:          } // for k
 5936: 
 5937: 
 5938:       } else { // Ganthy (iveg==2)
 5939:       //  Modify canopy height, diameter, and density
 5940: 
 5941:          // Make sure there is vegetation on this node
 5942:          if (node->veg_h_unbent > 0.0) {
 5943:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5944: 
 5945:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5946:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5947:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5948: 
 5949:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5950:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5951:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5952:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5953:          } // if veg_h_unbent
 5954: 
 5955:          for (int k = 0; k < nvrt; k++) {
 5956:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5957:          } // for k
 5958:       
 5959: 
 5960:       } // if iveg
 5961:      
 5962: 
 5963:       // Compute vertical mean of veg_alpha3D
 5964:       if (iveg != 0) {
 5965:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5966:          double sum1=0.0;
 5967:          double sum2=0.0;
 5968:          // Integrate over each level under the canopy...
 5969:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5970:             const double Dz = node->Dz(k);
 5971: 
 5972:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5973:             sum2 += Dz;
 5974: 
 5975:          } // for k
 5976:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5977:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5978: 
 5979:       } // if iveg
 5980: 
 5981:    }
 5982: 
 5983:    __global__ void computeVegetationAndDragParameters(void) {
 5984:       // Computes the vegetation and drag model parameters:
 5985:       // chi, \tilde\chi, beta, \breve{H}
 5986:       
 5987:       SIDE(side);
 5988: 
 5989:       side->hhat = 0.0;
 5990:       side->chi2 = 0.0;
 5991:       side->chi = 0.0;
 5992:       side->veg_c2 = 0.0;
 5993:       side->veg_beta = 0.0;
 5994: 
 5995:       if (side->isDry) return;
 5996: 
 5997:       const double htot = side->htot2();
 5998:       const int    kb   = side->kb;
 5999: 
 6000:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6001: 
 6002:       const double veg_h     = side->veg_h();
 6003:       const double veg_nv    = side->veg_nv();
 6004:       const double veg_c     = side->veg_c();
 6005:       const double veg_beta  = side->veg_beta;
 6006:       const double veg_alpha = side->veg_alpha_vert_mean();
 6007: 
 6008:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 6009:       // Velocity magnitude at the bottom level
 6010:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 6011:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6012:       side->chi2 = side->Cd()*vmag1;
 6013:       side->chi  = side->chi2;
 6014:       if constexpr(iveg != 0) {
 6015:          const Node *n1 = side->n1;
 6016:          const Node *n2 = side->n2;
 6017:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6018:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6019:       }
 6020: 
 6021:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6022: 
 6023:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6024:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6025:       double magUa = 0.0;
 6026:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 6027:          // 3D wet side with veg...
 6028: 
 6029:          double magUa = 0.0;
 6030:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6031:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6032: 
 6033:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 6034:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 6035:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6036: 
 6037:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6038:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6039: 
 6040:                // Velocity magnitude at the bottom (l) of the level
 6041:                const double ul = length(side->u2[k]);
 6042: 
 6043:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6044:                magUa += Dz*0.5*(uh + ul);
 6045: 
 6046:             } // if HasVegetation
 6047:          } // for k
 6048:          const double ua = magUa/min(htot, veg_h); // Vertical average
 6049: 
 6050:          // Computes beta, used for computing the stress term at the top of the canopy.      
 6051:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 6052:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6053:             const double zCpy = side->zTopCanopy();
 6054:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6055:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6056:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6057:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6058:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6059:          } // if isSubmerged
 6060:       } // if iveg   
 6061: 
 6062:       // Computes the friction modified depth, \breve{H} in notes
 6063:       if (side->is2D()) { // 2D
 6064: 
 6065:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6066:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6067: 
 6068:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6069: 
 6070:          side->hhat = htot*htot/fricH; 
 6071: 
 6072:       } else { // 3D
 6073:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6074: 
 6075:          if constexpr(iveg != 0) {
 6076:             
 6077:             if (side->isSubmerged()) { 
 6078:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6079:                side->hhat -= veg_c*Hhat_alpha;
 6080: 
 6081:             } else { // Emergent
 6082:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6083:             }
 6084:          } // if iveg
 6085: 
 6086:          // Enforce positivity for 3D model
 6087:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6088:       } // if 3D
 6089: 
 6090:    }
 6091: 
 6092: 
 6093: 
 6094:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6095:    // Computes the density gradient between two elements, e1 and e2.
 6096:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6097:    // zero in the direction normal to the side. 
 6098:    // 
 6099:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6100:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6101:    //
 6102:    // Input:
 6103:    //    e1: Element
 6104:    //    e2: Neighbor element (or nullptr if boundary)
 6105:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6106:    //    k: Index of the half-level at which the density is interpolated
 6107:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6108:    // 
 6109:    // Output:
 6110:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6111:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6112: 
 6113:       if (e2 == nullptr || e2->isDry) {
 6114:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6115: 
 6116:          Side *side = e1->sides[j];
 6117:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6118:                  
 6119:          if constexpr(ics == 1) {
 6120:             vec = side->n; // Normal vector to the side
 6121:          } else {
 6122:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6123:             // IMPLEMENT THIS XXXXXX
 6124:             // !replace with xel, yel?
 6125:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6126:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6127:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6128:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6129:          } //ics
 6130:                    
 6131:          diffRho = 0.0;
 6132: 
 6133:       } else { //internal and wet
 6134:          if constexpr(ics==1) {
 6135:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6136: 
 6137:             // Vector from e1 to e2
 6138:             vec = e2->center - e1->center;
 6139: 
 6140:          } else { 
 6141:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6142:             // Remember that elem->center is in global coordinates
 6143:             // IMPLEMENT THIS XXXXXX
 6144:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6145:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6146:             //                   alow(j)=xctr2
 6147:             //                   bdia(j)=yctr2
 6148:          } // ics
 6149: 
 6150:          diffRho = rho2 - e1->demeanedDensity(k);
 6151:       }
 6152: 
 6153:    }
 6154: 
 6155:    __global__ void computeDensityCubicSplines(void) {
 6156:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6157: 
 6158:       ELEM(elem);
 6159: 
 6160:       if (elem->isDry) return;
 6161: 
 6162:       const int kb = elem->kb;
 6163: 
 6164:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6165:       if (elem->is2D()) {
 6166:          // In the 2D case, the density is constant at the prism level. 
 6167:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6168:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6169:       } else { //3D
 6170: 
 6171:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6172:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6173:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6174:          ///// XXXX CHECK INDICES!!!!!
 6175:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6176:       } // 2D/3D
 6177: 
 6178:    }
 6179: } // extern "C"
 6180: 
 6181: 
 6182: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6183: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6184: 
 6185:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6186: 
 6187:    const int kb  = elem->kb;
 6188:    const int kb2 = elem2->kb;
 6189: 
 6190:    // z-coordinate of prism of elem
 6191:    const double zp = elem->z_prism(k);
 6192: 
 6193:    double rho = 0.0;
 6194: 
 6195:    if (elem2->is2D()) {
 6196:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6197: 
 6198:    } else {  // 3D
 6199: 
 6200:       // eta_min may be < zmax
 6201:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6202:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6203: 
 6204:       // (Extrapolate density below bottom, we will fix it later)
 6205:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6206:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6207:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6208:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6209:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6210:    } // 2D/3D
 6211:      
 6212: 
 6213:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6214:    // Now we need to fix it.
 6215:    if (elem->z[k] < elem2->z[kb2]) {
 6216:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6217: 
 6218:       // There are two methods to adjust the density at the bottom of the element.
 6219:       // iunder_deep=0: 
 6220:       const double depth1 = abs(elem->z[kb]); // larger depth
 6221: 
 6222:       if (iunder_deep==0) {
 6223: 
 6224:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6225: 
 6226:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6227: 
 6228:       } else { // iunder_deep != 0
 6229: 
 6230:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6231: 
 6232:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6233: 
 6234:          //   Demeaned density at the same z coordinate as
 6235:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6236:          }
 6237: 
 6238:       } // if iunder_deep
 6239:    } // if elem->z[kb] < elem2->z[kb]
 6240: 
 6241:    return rho;
 6242: }
 6243: 
 6244: 
 6245: extern "C" {
 6246:    __global__ void computeDensityGradient(void) {
 6247: 
 6248:       if constexpr(ibc != 0) return;
 6249: 
 6250:          // Compute the horizontal density gradient at each element.
 6251:       // It works in two steps:
 6252:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6253:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6254:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6255:       //             gradRho.r1 = rho1 - rho0
 6256:       //             gradRho.r2 = rho2 - rho0
 6257:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6258:       // 
 6259:       //  NOTE: We use de-meaned densities.
 6260: 
 6261:       ELEM(elem);
 6262: 
 6263:       if (elem->isDry) return;
 6264: 
 6265:       const int kb  = elem->kb;
 6266:       const int i34 = elem->i34;
 6267: 
 6268:       for (int k = kb + 1; k < nvrt; k++) {
 6269:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6270:          //             gradRho.r1 = rho1 - rho0
 6271:          //             gradRho.r2 = rho2 - rho0
 6272:          int icount = 0;
 6273:          double sumRx = 0.0;
 6274:          double sumRy = 0.0;
 6275:          for (int j1=0; j1<i34; j1++) { 
 6276: 
 6277:             const int j2 = elem->nxq(j1 + 1);
 6278: 
 6279:             // Pairs of consecutive neighbor elements of elem
 6280:             const Element *e1 = elem->nghbElems[j1];
 6281:             const Element *e2 = elem->nghbElems[j2];
 6282: 
 6283:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6284:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6285:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6286: 
 6287:             // Compute the density difference and the vector from elem to e1 and e2
 6288:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6289:             double diffRho1, diffRho2;
 6290:             Vector2 vec1, vec2;
 6291:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6292:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6293: 
 6294:             const double rl1 = length(vec1);
 6295:             const double rl2 = length(vec2);
 6296:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6297: 
 6298:             const double delta = cross(vec1, vec2);
 6299:             const double sintheta = abs(delta)/(rl1*rl2);
 6300: 
 6301:             // To avoid problems, avoid elements with small angle between vectors
 6302:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6303:             const bool validEq = (sintheta > sin_one_deg);
 6304: 
 6305:             if (validEq) {
 6306:                // Solve the system of equations to get the density gradient at elem
 6307:                icount++;
 6308:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6309:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6310:                sumRx += Rx;
 6311:                sumRy += Ry;
 6312:             }
 6313:          } // for j1
 6314: 
 6315:          // Compute the average density gradient at elem
 6316:          if (icount==0) {
 6317:            // Bad mesh quality; bail out with 0 b-cc
 6318:            elem->gradRho[k] = {0.0, 0.0};
 6319:          } else {
 6320:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6321:          }
 6322: 
 6323:       } // for k
 6324: 
 6325:    }
 6326: 
 6327:    __global__ void computeBaroclinicTerm(void) {
 6328:    // Computes the baroclinic term at sides (at half levels).
 6329:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6330:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6331: 
 6332:       if (ibc == 1) return;
 6333: 
 6334:       SIDE(side);
 6335: 
 6336:       if (side->isDry) return;
 6337: 
 6338:       const Element *e1 = side->elems[0];
 6339:       const Element *e2 = side->elems[1]; 
 6340:       const int kb = side->kb;
 6341:       
 6342:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6343: 
 6344:       // interpolates vertically the density gradient of the two elements at the half level/
 6345: 
 6346:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6347:       int k2 = max(kb, nvrt / 2);
 6348: 
 6349:       // Starts the integration at the surface and goes down to the bottom
 6350:       side->bcc[nvrt-1] = {0.0, 0.0};
 6351:       for (int k = nvrt - 2; k >= kb; k--) {
 6352:       // For each prism level (from surface to bottom)...
 6353: 
 6354:          // For both elements, interpolate density gradient at the side's half level.
 6355:          // The gradient at the side is the average of the gradients at the elements.
 6356:          // w1, w2 are used to take into account boundary sides, with just one element.
 6357:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6358:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6359:          const double wsum = w1 + w2;
 6360:          w1 = w1/wsum;
 6361:          w2 = w2/wsum;
 6362:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6363: 
 6364:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6365:          Vector2 gradRho = {0.0, 0.0};
 6366:          if (e1 != nullptr && k > kb) {
 6367:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6368:             
 6369:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6370:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6371:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6372: 
 6373:             // Grad(rho) vertically interpolated at the side's half level
 6374:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6375: 
 6376:             // Projects the element density gradient to the side frame if needed.
 6377:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6378: 
 6379:             // Adds the contribution of the density gradient at the side's half level
 6380:             gradRho += gradRho1*w1;
 6381:          }      
 6382:          if (e2 != nullptr && k > kb) {
 6383:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6384:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6385:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6386:             
 6387:             // Grad(rho) vertically interpolated at the side's half level
 6388:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6389: 
 6390:             // Projects the element density gradient to the side frame if needed.
 6391:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6392: 
 6393:             // Adds the contribution of the density gradient at the side's half level
 6394:             gradRho += gradRho2*w2;
 6395:          }
 6396: 
 6397:          
 6398:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6399:          // multiplied by -rampbc*(g/rho0) 
 6400:          const double grav3 = side->grav3();
 6401:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6402: 
 6403:       } // for
 6404: 
 6405:    }
 6406: 
 6407: 
 6408: 
 6409:    __global__ void computeHorGradientAtSide(void) {
 6410: 
 6411:       // Compute the horizontal density gradient at each element.
 6412:       // It works in two steps:
 6413:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6414:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6415:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6416:       //             gradRho.r1 = rho1 - rho0
 6417:       //             gradRho.r2 = rho2 - rho0
 6418:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6419:       // 
 6420:       //  NOTE: We use de-meaned densities.
 6421: 
 6422:       SIDE(side);
 6423: 
 6424: 
 6425:       if (side->isDry) return;
 6426: 
 6427:       // Computes the gradient of the variables at the side center.
 6428:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6429:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6430:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6431: 
 6432:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6433:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6434:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6435:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6436: 
 6437:    }
 6438: 
 6439: 
 6440:    __global__ void solveMomentumEquations(double time) {
 6441: 
 6442:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6443:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6444: 
 6445:       SIDE(side);
 6446: 
 6447:       if (side->isDry) 
 6448:       {
 6449:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6450: 
 6451:          return;
 6452:       }
 6453: 
 6454:       const Node *n1 = side->n1;
 6455:       const Node *n2 = side->n2;
 6456: 
 6457:       const int kb = side->kb;
 6458: 
 6459:       const double veg_h = side->veg_h();
 6460:       const double grav3 = side->grav3();
 6461: 
 6462:       if (side->is2D()) {
 6463:          // Remember: Do not use htot2, which is updated.
 6464:          const double htot = side->htot1();
 6465:          const double hhat = side->hhat;
 6466: 
 6467:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6468: 
 6469:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6470:          const Vector2 tau2 = side->tau();
 6471: 
 6472:          // hat_gam has units of m/s
 6473: 
 6474:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6475:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6476:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6477: 
 6478:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6479: 
 6480: 
 6481:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6482: 
 6483:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6484: 
 6485:       }
 6486:       else { // 3D
 6487: 
 6488:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6489:          // 
 6490:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6491:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6492:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6493:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6494:          // k+1 and k.
 6495: 
 6496: 
 6497:          const int ndim = nvrt - kb;
 6498:          const double zTopCanopy = side->zTopCanopy();
 6499: 
 6500:          // Initialize the tridiagonal system
 6501:          for (int k = kb + 1; k < nvrt; k++) {
 6502:             
 6503:             const int kin = k - (kb + 1);
 6504: 
 6505:             // Vertical viscosity at the face center
 6506:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6507: 
 6508:  
 6509:             alow[kin] = 0.0;
 6510:             cupp[kin] = 0.0;
 6511:             bdia[kin] = 0.0;
 6512: 
 6513:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6514:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6515: 
 6516:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6517:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6518:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6519: 
 6520:             // First part: layers k, k+1
 6521:             if (k < nvrt - 1) {
 6522:                              
 6523:                if constexpr(iveg != 0) {
 6524: 
 6525:                   // If there is vegetation at this level...
 6526:                   if (zTopCanopy > side->zc[k]) {
 6527:                      // If the canopy is above the k layer...
 6528:                      
 6529:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6530:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6531:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6532:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6533: 
 6534:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6535:                      const double vmag2 = length(ut2);
 6536:                      const double vmag1 = length(side->u2[k]);
 6537:                      const double vmag = 0.5*(vmag1 + vmag2);
 6538:                      
 6539:                      // Computes the vegetation alpha at the face center
 6540:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6541: 
 6542:                      cff1 += veg_alpha_sd*dt*vmag;
 6543: 
 6544:                   } // if (zTopCanopy
 6545:                } // if iveg
 6546: 
 6547:                const double dzz = side->Dz(k + 1);
 6548:                const double tmp = dt*dfz/dzz;
 6549:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6550: 
 6551:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6552:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6553:             }
 6554: 
 6555: 
 6556:             // Second part: layers k-1, k
 6557:             if (k > kb + 1) {
 6558: 
 6559:                double cff1 = 1.0; //init \bar{c^k}
 6560: 
 6561:                if constexpr(iveg != 0) {
 6562:                   // If there is vegetation at this level...
 6563:                   if (zTopCanopy > side->zc[k-1]) {
 6564:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6565:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6566: 
 6567:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6568: 
 6569:                      const double vmag2 = length(ut2);
 6570:                      const double vmag1 = length(side->u2[k-1]);
 6571:                      const double vmag = 0.5*(vmag1 + vmag2);
 6572: 
 6573:                      // Computes the vegetation alpha at the face center
 6574:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6575:                      cff1 += veg_alpha_sd*dt*vmag;
 6576:                   } // if zTopCanopy
 6577: 
 6578:                } // if iveg
 6579: 
 6580:                const double dzz = side->Dz(k);
 6581:                const double tmp = dt*dfz/dzz;
 6582:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6583: 
 6584:                alow[kin] += cff1*dzz/6.0 - tmp;
 6585:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6586: 
 6587:             } else { // Bottom boundary
 6588:                // This occurs at the bottom, where the bottom drag is applied.
 6589: 
 6590:                bdia[kin] += dt*side->chi2; // XXXX
 6591: 
 6592:             } // if (k > kb + 1)
 6593: 
 6594: 
 6595:          } // for (int k
 6596: 
 6597: 
 6598: 
 6599:          // Computes the RHS.
 6600:          // -----------------
 6601: 
 6602:          //	BC to be imposed at the end.
 6603: 
 6604:          const Vector2 gradETP  = side->gradETP;
 6605:          const Vector2 gradPr   = side->gradPr;
 6606:          const Vector2 gradEta1 = side->gradEta1;
 6607:          const Vector2 gradEta2 = side->gradEta2;
 6608: 
 6609:          const Vector2 *btu = side->btu;
 6610:          const Vector2 *u2  = side->u2;
 6611:          const double coriolis = side->coriolis;
 6612:          const Vector2 *nuGradU = side->nuGradU;
 6613: 
 6614:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6615:          for (int k = kb + 1; k < nvrt; k++) {
 6616:             const int kin = k - kb - 1;
 6617: 
 6618:             const double dz_0 = side->Dz(k);
 6619:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6620: 
 6621:             rrhs[kin] = {0.0, 0.0};
 6622:             double dz = 0.0;
 6623: 
 6624:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6625:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6626:             if (k < nvrt  ) dz += dz_1;
 6627:             if (k > kb + 1) dz += dz_0;
 6628: 
 6629:             // Elevation gradient, atmospheric pressure and tidal potential
 6630:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6631: 
 6632:             // Coriolis, advection, wind stress, and horizontal viscosity
 6633:             if (k < nvrt - 1) {
 6634: 
 6635: 
 6636:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6637:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6638:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6639:                                                 
 6640: 
 6641:                //diff stress tensors 1006
 6642:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6643:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6644:                   assert(false && "Not implemented: itur == 5");
 6645:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6646:                }
 6647:                // else assert(false && "itur # Not implemented");
 6648: 
 6649:             } else { // k == nvrt - 1 SURFACE
 6650:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6651:                const Vector2 tau2 = side->tau();
 6652: 
 6653:                rrhs[kin] += dt*tau2;          
 6654: 
 6655:             } // if k<nvrt
 6656: 
 6657: 
 6658:             if (k > kb + 1) {
 6659:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6660:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6661:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6662: 
 6663:                // diff stress tensors 1006
 6664:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6665:                   assert(false && "Not implemented: itur == 5");
 6666:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6667:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6668:                }
 6669:                // else assert(false && "itur # Not implemented");
 6670: 
 6671: 
 6672:             } // if k>kbs + 1
 6673: 
 6674:             // Baroclinic
 6675:             Vector2 *bcc = side->bcc;
 6676:             if constexpr(ibc == 0) {
 6677:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6678:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6679: 
 6680:             } // if ibc==0
 6681: 
 6682:          } // k=kb + 1,nvrt
 6683: 
 6684: 
 6685:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6686: 
 6687:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6688:             const int kin = k - kb - 1;
 6689:    
 6690:             // Velocity is always clamped to maximum values
 6691:             side->u2[k] = clampVelocity(soln[kin]);
 6692:          } // k
 6693: 
 6694:       } // if side->is2D()
 6695:       
 6696: 
 6697:       // Impose velocity boundary condition at the bottom
 6698:       if constexpr(imm == 2) { // 3D bed deformation model
 6699:          double dep;
 6700:          Vector2 vel;
 6701: 
 6702:          assert(false && "Not implemented: imm == 2");
 6703:          //update_bdef(time, x0, y0, dep, vel);
 6704:          // side->u2[kb] = vel;
 6705: 
 6706:       } else { // imm = 0 or 1
 6707:          if (side->Cd() == 0.0) {
 6708:             side->u2[kb] = side->u2[kb + 1];
 6709: 
 6710:          } else if (side->is3D()) { // 3D no slip bottom   
 6711:             side->u2[kb] = {0.0, 0.0};
 6712: 
 6713:          }
 6714:           
 6715:       } // if imm
 6716: 
 6717:       // The velocities below the bottom level are set to zero
 6718:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6719: 
 6720: 
 6721:    }
 6722: 
 6723: 
 6724:    __global__ void applyMomentumBC(void) {
 6725: 
 6726:       SIDE_BND(sideBnd);
 6727: 
 6728:       Side *side = sideBnd->side;
 6729:       const BoundarySegment *segment = sideBnd->segment;
 6730:       const Node *n1 = side->n1;
 6731:       const Node *n2 = side->n2;
 6732: 
 6733:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6734: 
 6735:       const bool isLand = segment->isLand;
 6736:       const int ifltype = segment->ifltype;
 6737: 
 6738:       const int kb = side->kb;
 6739: 
 6740: 
 6741:       if (!isLand && ifltype != 0) {
 6742:          const Vector2 *ubc = sideBnd->ubc;
 6743:   
 6744:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6745:             
 6746:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6747:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6748: 
 6749:             if (ifltype == -1) {
 6750:                // Flather 1
 6751: 
 6752:                const double depth = side->depth();
 6753: 
 6754:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6755: 
 6756:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6757: 
 6758:                side->u2[k] = vnorm*side->n;
 6759: 
 6760:             } else if (ifltype == -2) { // Discharge
 6761: 
 6762:                const double eta1 = side->eta1();
 6763:                const double eta2 = side->eta2();
 6764:                const double htot = side->htot2();
 6765: 
 6766:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6767:                assert(false && "Not implemented: Discharge bc");
 6768:                // const double dischrg = discharge(eta1);
 6769:                const double dischrg = 0.0; // XXX REMOVE
 6770:                
 6771: 
 6772:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6773: 
 6774:                const double vnorm = dischrg*eta2/htot;
 6775: 
 6776:                side->u2[k] = vnorm*side->n;
 6777: 
 6778:             }
 6779:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6780:                const double vnorm = dot(side->u2[k], side->n);
 6781: 
 6782:                double rat;
 6783:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6784:                else              rat = segment->vobc2; // outgoing
 6785: 
 6786:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6787: 
 6788:             }
 6789:             else { // not Flather or 3D radiation
 6790:                side->u2[k] = ubc[k];
 6791: 
 6792:             } // if (segment->ifltype...
 6793: 
 6794:          }
 6795: 
 6796:       }
 6797:       else if (isLand) { // if it is land boundary side
 6798: 
 6799:          if constexpr(islip == 0) { // free slip
 6800: 
 6801:             for (int k = kb; k < nvrt; k++) {
 6802: 
 6803:                const Vector2 t = side->t();
 6804:                const Vector2 n = side->n;
 6805: 
 6806:                double vnorm = 0.0; // for most cases
 6807:                const double vtan = dot(side->u2[k], t);
 6808:                
 6809:                side->u2[k] = vtan*t - vnorm*n;
 6810: 
 6811:             }
 6812: 
 6813:          } else { // no slip
 6814:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6815: 
 6816:          }
 6817:       } // if (side segment type...
 6818: 
 6819:    
 6820: 
 6821:    }
 6822: 
 6823: 
 6824:    __global__ void shapiroFilter1(void) {
 6825:       // First step of the Shapiro filter (normally used if indvel<=0)
 6826:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6827: 
 6828:       SIDE(side);
 6829: 
 6830:       // Only internal wet sides are processed
 6831:       if (side->isDry || !(side->isInternal())) return;
 6832: 
 6833:       const int kb = side->kb;
 6834: 
 6835:       for (int mm = 0; mm < niter_shap; mm++) {
 6836: 
 6837:          for (int k = kb + 1; k < nvrt; k++) {
 6838:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6839:             Vector2 suru = {0.0, 0.0};
 6840: 
 6841:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6842: 
 6843:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6844: 
 6845:                int kin = k;
 6846:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6847:                
 6848:                // Get the velocity at the neighbor's side.
 6849:                Vector2 nSideU2 = nSide->u2[kin];
 6850: 
 6851:                // Projects the velocity to the current side frame if needed.
 6852:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6853: 
 6854:                suru += nSideU2;
 6855:             }
 6856: 
 6857:             // Reusing bcc as a temporary array to store the suru values.
 6858:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6859: 
 6860:          }
 6861:       }
 6862:    }
 6863: 
 6864:    __global__ void shapiroFilter2(void) {
 6865:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6866: 
 6867:       SIDE(side);
 6868: 
 6869: 
 6870:       if (side->isDry || !(side->isInternal())) return;
 6871: 
 6872:       const int kb = side->kb;
 6873: 
 6874:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6875: 
 6876:       if (side->is2D()) {
 6877:          side->u2[kb + 1] = side->bcc[kb + 1];
 6878:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6879: 
 6880:       } else {
 6881:          // 3D
 6882:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6883:          
 6884:       }
 6885: 
 6886:    }
 6887: 
 6888: 
 6889:    __global__ void ul0UpdateZCoords(void) {
 6890:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6891:       
 6892:       NODE(node);      
 6893: 
 6894: 
 6895:       if (false) { //node->isDry) { XXXXXXX
 6896: 
 6897:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6898: 
 6899:          if constexpr(ivcor != 1) node->kb = 0;
 6900: 
 6901:       } else {
 6902: 
 6903:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6904:          node->updateKb();
 6905: 
 6906:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6907: 
 6908:       }
 6909: 
 6910:       // We use the temp.b field to store the previous state of isDry.
 6911:       node->tmp.b = node->isDry;
 6912: 
 6913:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6914:       node->isDry = true;
 6915: 
 6916:    }
 6917: 
 6918:    __global__ void ul0ComputeDryElements(void)
 6919:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6920:    {
 6921:       ELEM(elem);
 6922: 
 6923:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6924: 
 6925:       elem->kb = 0;
 6926: 
 6927:       if (elem->isDry) return;
 6928: 
 6929: 
 6930:    //    if(elem->isDry2()) { // XXXX
 6931:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6932:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6933:    //        call parallel_abort(errmsg)
 6934:    //    }
 6935: 
 6936:       const Node *n1 = elem->nodes[0];
 6937:       const Node *n2 = elem->nodes[1];
 6938:       const Node *n3 = elem->nodes[2];  
 6939:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6940: 
 6941:       // Computes element's kb as the minimum of the nodes' kb.
 6942:       const int kb1 = n1->kb;
 6943:       const int kb2 = n2->kb;
 6944:       const int kb3 = n3->kb;
 6945:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6946: 
 6947: 
 6948:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6949: 
 6950: 
 6951:       // Computes the element z as the mean of the nodes z.
 6952:       for (int k = elem->kb; k < nvrt; k++) {
 6953: 
 6954:          // Compute the element z as the mean of the nodes z.
 6955:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6956:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6957:          elem->z[k] /= elem->i34;
 6958: 
 6959:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6960:       }
 6961:                   
 6962:    }
 6963: 
 6964:    __global__ void ul0ComputeDryNodes(void)
 6965:    // Updates node's isDry based on the elements' isDry. 
 6966:    {
 6967:       NODE(node);
 6968: 
 6969:       node->isDry = true;
 6970: 
 6971:       // A node is wet if at least one of the elements sharing it is wet.
 6972:       for (int j = 0; j < node->numElements; j++) {
 6973:          const Element *elem = node->elements[j];
 6974:          if (!elem->isDry) {
 6975:             node->isDry = false;
 6976:             break;
 6977:          }
 6978:       }
 6979: 
 6980:        
 6981:    }
 6982: 
 6983: 
 6984:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6985:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6986:    // node->tmp.b is true if the node was previously dry.
 6987:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6988:    {
 6989:       NODE(node);
 6990:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6991: 
 6992:       // Avoid this the first time step.
 6993:       if (it == iths) return;  
 6994: 
 6995:       const bool wasDry = node->tmp.b;
 6996: 
 6997: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6998: 
 6999:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7000: 
 7001:          for (int k=0; k < nvrt; k++) {
 7002: 
 7003:             Vector3 utmp={0.0, 0.0, 0.0};
 7004: 
 7005:             double ttmp=0.0;
 7006:             double stmp=0.0;
 7007:             int icount=0;
 7008:             for (int j = 0; j < node->numNodes; j++) {
 7009: 
 7010:                const Node *nbrNode = node->nodes[j];
 7011:                
 7012:                const bool wasNbrDry = nbrNode->tmp.b;
 7013: 
 7014:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7015:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7016: 
 7017:                   icount++;
 7018: 
 7019:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7020:                   utmp += nbrNode->uvw2(k);
 7021:                   
 7022:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7023:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7024:                }
 7025:             }
 7026: 
 7027:             if (icount > 0) {
 7028:                const double inv_icount = 1.0/icount;
 7029:                utmp = inv_icount*utmp;
 7030:                node->u2[k]     = toVector2(utmp);
 7031:                node->w2[k]     = utmp.z;
 7032:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7033:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7034:             } else {
 7035:                node->u2[k] = {0.0, 0.0};
 7036:                node->w2[k] = 0.0;
 7037:                // Initialize tracers to 0.0??? XXXXX
 7038:             }
 7039:          }
 7040:       }
 7041:    }
 7042: 
 7043:   
 7044:    
 7045: 
 7046: 
 7047:    __global__ void ul0UpdateSides(int it, int iths) {
 7048:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7049:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7050:    // The dryness of the sides is updated in ul0UpdateSides2.
 7051: 
 7052:       SIDE(side);
 7053: 
 7054:       // A side is wet if and only if at least one of its elements is wet.
 7055:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7056:  
 7057:       const Node *n1 = side->n1;
 7058:       const Node *n2 = side->n2;
 7059:      
 7060:       const int kb1 = n1->kb;
 7061:       const int kb2 = n2->kb;
 7062: 
 7063:       side->kb = 0; // default when dry
 7064: 
 7065:       if (isWet) {
 7066: 
 7067:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7068: 
 7069:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7070: 
 7071:          side->kb = min(kb1, kb2);
 7072: 
 7073:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7074: 
 7075:          for (int k = side->kb; k < nvrt; k++) {
 7076:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7077: 
 7078:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7079: 
 7080:             // Compute velocity for re-wetted sides 
 7081:             if ((it != iths) && (side->isDry && isWet)) {
 7082: 
 7083:                Vector2 utmp={0.0, 0.0};
 7084: 
 7085:                int icount=0;
 7086: 
 7087:                // For all the sides on the two elements that share this side
 7088:                for (int j = 0; j < 2; j++) {
 7089:                   const Element *elem = side->elems[j];
 7090:                   if (elem == nullptr) continue;
 7091: 
 7092:                   for (int jj=0; jj < elem->i34; jj++) {
 7093:                      const Side *nSide = elem->sides[jj];
 7094:                      if (nSide->isDry) continue;
 7095: 
 7096:                      icount++;
 7097:                      utmp += nSide->u2[k];  
 7098:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7099:                   }
 7100:                }
 7101:                   
 7102:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7103:                if (icount > 0)  side->u2[k] = utmp/icount;
 7104:                else             side->u2[k] = {0.0, 0.0};
 7105:                   
 7106:             } // if ((it != iths) && (side->isDry && isWet))
 7107: 
 7108:          } // for k
 7109: 
 7110:       } // if isWet 
 7111:       
 7112: 
 7113: 
 7114:    }
 7115: 
 7116:    __global__ void ul0UpdateSides2(void) {
 7117:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7118:    
 7119:          SIDE(side);
 7120:    
 7121:          const Element *e1 = side->elems[0];
 7122:          const Element *e2 = side->elems[1];
 7123: 
 7124:          // A side is wet if and only if at least one of its elements is wet.
 7125:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7126: 
 7127:          // Update the side's dryness
 7128:          side->isDry = !isWet;
 7129: 
 7130:    }
 7131: 
 7132: 
 7133:    __global__ void zeroNodalVelocities(void) {
 7134:       NODE(node);
 7135: 
 7136:       for (int k = 0; k < nvrt; k++) {
 7137:          node->u2[k]   = {0.0, 0.0};
 7138:          node->w2[k]   = 0.0;
 7139:          node->utmp[k] = {0.0, 0.0};         
 7140:       }
 7141:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7142:    }
 7143:  
 7144: 
 7145:    __global__ void computeNodalVerticalVelocities1(void) {
 7146:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7147:    // Adds the element's vertical velocity times the element's area.
 7148:       ELEM(elem);
 7149: 
 7150:       for (int j = 0; j < elem->i34; j++) {
 7151:          Node *node = elem->nodes[j];
 7152: 
 7153:          for (int k = node->kb; k < nvrt; k++) {
 7154:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7155:          }
 7156:          atomicAdd(&(node->tmp.d), elem->area);
 7157:       }
 7158:    }
 7159: 
 7160:    __global__ void computeNodalVerticalVelocities2(void) {
 7161:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7162:    // Divides by the total area of the elements sharing the    node.
 7163:       NODE(node);
 7164: 
 7165:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 7166: 
 7167:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7168:    }
 7169: 
 7170: 
 7171:    __global__ void computeNodalHorizontalVelocities1(void) {
 7172: 
 7173:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7174: 
 7175:       ELEM(elem);
 7176: 
 7177:       if (elem->isDry) return;
 7178: 
 7179:       const int kb = elem->kb;
 7180:       const bool isTri = elem->isTri();
 7181: 
 7182:       if constexpr(indvel <= 0) {
 7183:          // Assuming discontinous hvel.
 7184: 
 7185:          if (isTri) { // For triangles
 7186:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7187:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7188: 
 7189:             for (int j = 0; j < 3; j++) {
 7190:                // For every node of the triangle...
 7191:                Node *node = elem->nodes[j];
 7192: 
 7193:                if (node->isDry) continue;
 7194: 
 7195:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7196:                const Side *s2 = elem->sides[(j + 1) % 3];
 7197:                const Side *s3 = elem->sides[(j + 2) % 3];
 7198: 
 7199:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7200: 
 7201:                atomicAdd(&(node->tmp.i), 1);
 7202: 
 7203:                for (int k = kb; k < nvrt; k++)  {
 7204:                   Vector2 s1u2 = s1->u2[k];
 7205:                   Vector2 s2u2 = s2->u2[k];
 7206:                   Vector2 s3u2 = s3->u2[k];
 7207: 
 7208:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7209:                   if constexpr(ics == 2) {
 7210:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7211:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7212:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7213:                   }
 7214: 
 7215:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 7216:                   u = clampVelocity(u);
 7217:                   atomicAdd(&(node->utmp[k].x), u.x);
 7218:                   atomicAdd(&(node->utmp[k].y), u.y);
 7219: 
 7220:                }
 7221: 
 7222:             }
 7223:          }
 7224:          else { // For quads
 7225:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 7226: 
 7227:          }
 7228: 
 7229:       }
 7230:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7231:       
 7232:    }
 7233: 
 7234: 
 7235:    __global__ void computeNodalHorizontalVelocities2(void) {
 7236:       NODE(node);
 7237: 
 7238:       const int nodeCount = node->tmp.i;
 7239: 
 7240:       if (nodeCount == 0) 
 7241:       {
 7242:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7243:          return;
 7244:       }
 7245: 
 7246:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7247:       
 7248:       const int kb = node->kb;
 7249: 
 7250:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7251:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7252:       
 7253:       
 7254:    }   
 7255: 
 7256:  
 7257: 
 7258:    __global__ void resetVelocityOpenBndNodes(void) {
 7259:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7260: 
 7261:       NODE_BND(nodebnd);
 7262: 
 7263:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7264:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7265:       }
 7266: 
 7267:    }
 7268: 
 7269: 
 7270:    __global__ void setVelocityOpenBndNodes(void) {
 7271:    // For open boundary nodes sets their velocity to the imposed values.
 7272: 
 7273:       SIDE_BND(sidebnd);
 7274: 
 7275:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7276:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7277:          // to its segment to the average of the side velocity.
 7278: 
 7279:          for (int k = 0; k < nvrt; k++) {
 7280:             Node *n1 = sidebnd->side->n1;
 7281:             Node *n2 = sidebnd->side->n2;
 7282: 
 7283: 
 7284:             Vector2 n1_u2(n1->u2[k]);
 7285:             Vector2 n2_u2(n2->u2[k]);
 7286: 
 7287:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7288:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7289:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7290:             }
 7291:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7292:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7293:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7294:             }
 7295: 
 7296:          }
 7297: 
 7298:       }
 7299: 
 7300:    }
 7301: 
 7302: 
 7303:    __global__ void computeVerticalVelocity(void) {
 7304:       // Computes the vertical velocity at the (2D) element's centroid.
 7305:       // In this function we will be considering volumetric elements, with side faces and a 
 7306:       // bottom and a top face. We will call them SFs, BF and TF.
 7307:       // It computes the flux coming from BF and the SFs.
 7308:       // If the bed is moving, it takes that into account.
 7309:       // Since water is incompressible, the integral of the velocity times the normal vector
 7310:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7311:       // and the BF is equal to the flux going out from the TF.
 7312:       // TF = - BF - sum(SFs).
 7313:       // It then computes the horizontal velocity at the center of TF.
 7314:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7315:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7316:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7317: 
 7318:       ELEM(elem);
 7319: 
 7320:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7321: 
 7322:       if (elem->isDry) return;
 7323: 
 7324:       const int kb = elem->kb;
 7325:       const bool isTri = elem->isTri();
 7326: 
 7327:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7328: 
 7329:       // Compute the bottom velocity
 7330:       if constexpr(imm != 0) {
 7331:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7332:       }
 7333: 
 7334: 
 7335:       double bottomArea3D;
 7336:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7337: 
 7338:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7339: 
 7340:       double topArea3D;
 7341: 
 7342:       // Bottom face flux
 7343:       double bottomFlux = 0.0;
 7344:       Vector2 u2meanBottom = {0.0, 0.0};
 7345:       const Vector2 gradh = elem->grad2(&Node::depth);
 7346:       if constexpr(imm==2) {
 7347:          Vector3 ubed;
 7348: 
 7349:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7350:          // updateBDEF(ubed);
 7351:      
 7352:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7353: 
 7354:          // elem->w[kb] += ubed.z;
 7355:       }
 7356:       else {
 7357: 
 7358: 
 7359:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7360:   
 7361:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7362:          // in the direction of motion.
 7363:          const double bottomW = - dot(gradh, u2meanBottom);  
 7364:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7365: 
 7366:          // VElocity associated to the bed deformation
 7367:          double bedVelocity = 0.0;
 7368:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7369: 
 7370:          elem->w[kb] = bedVelocity + bottomW; 
 7371: 
 7372:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7373:          
 7374:       } // if imm
 7375: 
 7376:       // Compute w for kb+1 to nvrt-1
 7377:       for (int l = kb; l < nvrt - 1; l++) {
 7378: 
 7379:          // normal vector to the top face of the "volumetric" element (3D)
 7380:          Vector3 elem_top_n = -elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7381: 
 7382:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7383:          assert(elem_top_n.z < 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7384: 
 7385:          // Compute the total flux at the sides
 7386:          double sideFlux = 0.0;
 7387: 
 7388:          for (int j = 0; j < elem->i34; j++) {
 7389:             const Side *side = elem->sides[j];
 7390:             const int kbs = side->kb;
 7391:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7392:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7393:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7394: 
 7395:             // The area is "clamped" meaning that it takes kb into account.
 7396:             const double sideArea = side->areaClamped(l);
 7397: 
 7398:             const double sign = elem->ssign[j]; 
 7399: 
 7400:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7401:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7402:          }
 7403:          
 7404:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7405:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7406:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7407: 
 7408:          // The flux at the top ace can be computed from the other flows.
 7409:          // All fluxes are in directions into the prism.
 7410:          const double topFlux = - sideFlux - bottomFlux;
 7411: 
 7412:          // Flux at the top face due to the horizontal velocities only
 7413:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7414: 
 7415:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + bottomFlux = 0, so:
 7416:          const double topVerticalFlux = -sideFlux - topHorizontalFlux - bottomFlux;  
 7417: 
 7418:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7419: 
 7420:          bottomFlux = -topFlux;
 7421:       }
 7422:    }  
 7423: 
 7424: 
 7425: 
 7426: 
 7427: 
 7428: 
 7429: 
 7430: // !===============================================================================
 7431: // !===============================================================================
 7432: 
 7433: } // extern "C"
 7434: 
 7435: #ifdef DONTCOMPILE
 7436: __device__ void computeVerticalAdvection(void) {
 7437:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7438: 
 7439:    sdbt(1:2,:,:)=0.d0
 7440: 
 7441:    const Side *side = FROM kernel;
 7442: 
 7443:    if(side->isDry) return;
 7444: 
 7445:    // If side is wet...
 7446: 
 7447: 
 7448:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7449:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7450:    double ws[nvrt] = {} // w @ side
 7451:    int icount = 0;
 7452:    for (int j=0; j<2; j++) {
 7453:       const Element *elem = side->elements[j];
 7454:        
 7455:       if(elem != nullptr) {
 7456:          icount++;
 7457:          for (int k=0; k<nvrt; k++) {
 7458:             ws[k] = ws[k] + elem->w[k];
 7459:          }
 7460:       }
 7461:    }  // for j
 7462: 
 7463:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7464:    ws = ws/icount;
 7465: 
 7466:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7467:    // Splines allow for a smooth transition between vertical levels.
 7468:    // Splines have continuity restrictions at the internal knots, but
 7469:    // we have to provide the 1st derivatives at the endpoints.
 7470:    const int kbs = side->kbs; 
 7471:    
 7472:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7473:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7474:    initCubicSpline(kbs, nvrt, side, ws, up)
 7475: 
 7476:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7477:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7478:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7479: 
 7480:    // Total advection (average onto side)
 7481:    const Node *node1 = side->nodes[0];
 7482:    const Node *node2 = side->nodes[1];
 7483:    for (int k=kbs(i); k<nvrt; k++) {
 7484: 
 7485:       Vector2 bcc1 = node1->bcc[k];
 7486:       Vector2 bcc2 = node2->bcc[k];
 7487:       if constexpr(ics == 2) {
 7488:          // Project the velocities from the node frames to the side frame
 7489:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7490:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7491:       }
 7492: 
 7493:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7494:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7495: 
 7496:    }
 7497: }
 7498: #endif
 7499: 
 7500: 
 7501: extern "C" {
 7502:    __global__ void computeElemAverageGhat(void) {
 7503:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7504: 
 7505:       ELEM(elem);
 7506:       
 7507:       elem->ghat1= {0.0, 0.0};  
 7508: 
 7509:       if constexpr(ihydraulics != 0) {
 7510:          if (nhtblocks > 0 && elem->isblock) return;
 7511:       }
 7512: 
 7513:       
 7514:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7515:       // cff1-3: coefficients for 2D/3D
 7516: 
 7517:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7518:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7519:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7520: 
 7521:       if (elem->isDry) return;
 7522: 
 7523:       // Average of the coefficients
 7524:       double av_cff1 = 0.0;  // av. for cff1
 7525:       double av_cff2 = 0.0;  // av. for cff2
 7526:       double av_cff3 = 0.0;  // av. for cff3
 7527:       double av_df = 0.0;  // av. for H^\alpha / H
 7528:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7529:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7530: 
 7531:       const int i34 = elem->i34;
 7532:       const int kb  = elem->kb;
 7533: 
 7534:       for (int j=0; j<i34; j++) {
 7535:          // For each node and side in the element...
 7536: 
 7537:          const Node *node = elem->nodes[j];
 7538:          const Side *side = elem->sides[j];
 7539: 
 7540:          const double chi      = side->chi;
 7541:          const double veg_c2   = side->veg_c2;
 7542:          const double veg_beta = side->veg_beta;
 7543:          const double veg_h    = side->veg_h();
 7544:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7545: 
 7546:          const Vector2 gradPhi = elem->gradPhi[j];
 7547: 
 7548:          // Node - const in elem
 7549:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7550:          elem->gradPr  += node->pr  *gradPhi;
 7551: 
 7552:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7553: 
 7554:         
 7555:          const double htot  = side->htot2();        // Total depth at the side
 7556:          const double zctr2 = side->zTopCanopy();  
 7557: 
 7558:          double cff1; 
 7559:          double cff2; 
 7560:          double cff3;   
 7561:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7562:          // coefficients applied to 2D/3D case 
 7563:             cff1 = side->hhat/htot;
 7564:             cff2 = 0.0;
 7565:             cff3 = 0.0;
 7566:          } else { //3D
 7567:             //Init for no-veg case
 7568:             cff1 = 1.0;
 7569:             cff2 = 1.0;
 7570:             cff3 = 0.0;
 7571: 
 7572:             if constexpr(iveg != 0) {
 7573:                // Computes coefficients used with vegetation terms G1, G2
 7574:                // cff1, cff3 are used for the first two terms in G1, G2:
 7575:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7576:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7577:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7578:                if(veg_h < 0.99*htot) { // submergent vegetation
 7579:                   cff1 = 1.0;
 7580:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7581:                   cff3 = veg_c;
 7582: 
 7583:                } else { // emergent vegetation
 7584:                   cff1 = 1.0/(1.0 + veg_c2);
 7585:                   cff2 = cff1;
 7586:                   cff3 = 0.0;
 7587: 
 7588:                }
 7589:             } // if iveg
 7590:          } //  2D/3D
 7591: 
 7592:          av_cff1 += cff1/i34;
 7593:          av_cff2 += cff2/i34;
 7594:          av_cff3 += cff3/i34;
 7595:          av_cff2_chi += cff2*chi/i34;
 7596:          av_cff3_chi += cff3*chi/i34;
 7597:          av_df += min(htot, veg_h)/(htot*i34);
 7598: 
 7599: 
 7600:          // btrack values: U^\star, U^{\star\alpha}
 7601:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7602:          Vector2 Ustar       = {0.0, 0.0}; 
 7603:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7604: 
 7605:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7606:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7607:          } else { //3D
 7608:             for (int k = side->kb + 1; k < nvrt; k++) {
 7609:             
 7610:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7611:                Ustar += w2;
 7612: 
 7613:                if constexpr(iveg != 0) {
 7614:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7615:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7616:                        Ustar_alpha += zrat*w2; // XXXX
 7617:                    }
 7618:                }  // if iveg
 7619:             }  // for k
 7620:          }  //2D/3D
 7621: 
 7622:          // If needed, project the side velocities to the element frame
 7623:          if constexpr(ics==2) {
 7624:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7625:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7626:          }
 7627:         
 7628: 
 7629:          // Add btrack & surface stress terms to \breve{G} first
 7630:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7631: 
 7632: 
 7633:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7634:          Vector2 tau    = side->tau();  
 7635:          Vector2 ubstar = side->btu[side->kb + 1];  
 7636: 
 7637:          // If needed, project tau and ubstar to the element frame
 7638:          if constexpr(ics==2) {
 7639:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7640:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7641:          }
 7642: 
 7643:          // Term for surface and bottom stress
 7644:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7645: 
 7646: 
 7647:          // All terms in F,F^\alpha,f_b except baroclinic
 7648:          // F, f_b: all explicit terms excluding vegetation 
 7649:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7650:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7651:          const double coriolis = side->coriolis;
 7652:          Vector2 F  =  coriolis*side->U;  // F_x
 7653:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7654:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7655: 
 7656:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7657:             
 7658:             for (int k = side->kb; k < nvrt; k++) {
 7659:                if (zctr2 > side->zc[k-1]) {
 7660:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7661:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7662:                    Fa +=  coriolis*w2*zrat;
 7663:                } // if zctr2
 7664:             } // k
 7665:          } // iveg
 7666: 
 7667:          // Integrate horizontal viscosity force vertically
 7668:          for (int k=side->kb + 1; k<nvrt; k++) {
 7669:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7670: 
 7671:             F += levelHorVisc;
 7672: 
 7673:             // Vegetation term
 7674:             if constexpr(iveg!=0) {
 7675:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7676:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7677:                   Fa += levelHorVisc*zrat;
 7678:                } 
 7679:             } // if iveg
 7680:          } // for k
 7681: 
 7682:          // Get nu*grad(U) at the side's bottom level
 7683:          Vector2 nuGradU = side->nuGradU[side->kb];
 7684: 
 7685:          fb += nuGradU;
 7686: 
 7687:          // If needed, project vectorsF, fb and Fa to the element frame
 7688:          if constexpr(ics==2) {
 7689:             F    = side->frame.projHorVec(F,    elem->frame);
 7690:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7691:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7692:          } // if ics
 7693: 
 7694:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7695:       } // for j (nodes and sides)
 7696: 
 7697:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7698: 
 7699: 
 7700:       // Finish off terms in F, F^\alpha and f_b
 7701:       const double grav3 = elem->mean(&Node::grav2);
 7702:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7703:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7704:       for (int j=0; j<i34; j++) { 
 7705:          // For each side in the element...
 7706:          const Side *side = elem->sides[j];
 7707:          const double chi = side->chi;
 7708: 
 7709:          const double htot = side->htot2();
 7710:          const double veg_h = side->veg_h();
 7711:          const Vector2 F  = htot*fb;
 7712:          const Vector2 Fa = min(htot, veg_h)*fb;
 7713: 
 7714:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7715:       } // for j
 7716: 
 7717:       // tmp is already in elem frame
 7718:       elem->ghat1 += tmp/i34;
 7719: 
 7720:       // Baroclinic force
 7721:       if constexpr(ibc==0) {
 7722:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7723: 
 7724:          Vector2 Fa = {0.0, 0.0};
 7725:          Vector2 intGradRho = {0.0, 0.0};
 7726:          
 7727:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7728:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7729:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7730: 
 7731:             // \in F [m^2/s/s]
 7732:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7733:          }
 7734: 
 7735:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7736:          const Vector2 F = av_df*Fa; //approx
 7737:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7738: 
 7739:       } // if ibc
 7740: 
 7741: 
 7742: 
 7743:    }
 7744: 
 7745: } // extern "C"
 7746: 
 7747: 
 7748: 
 7749: #ifdef DONTCOMPILE
 7750: __global__ void checkMassConservation(Tracers* sumtr) {
 7751: 
 7752:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7753: 
 7754:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7755: 
 7756:    Element *elem = &(mesh->localElemData[i]);
 7757: 
 7758:    // Skip dry elements
 7759:    if (elem->isDry) return;
 7760: 
 7761:    // Local sum array for this thread
 7762:    double localSum[N_TRACERS] = {0.0};
 7763: 
 7764:    // Sum over vertical levels for this element
 7765:    const int kbe = elem->kbe;
 7766:    const double area = elem->area;
 7767: 
 7768:    for (int k = kbe; k < nvrt; k++) {
 7769:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7770:       
 7771:       // Accumulate tracer mass
 7772:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7773:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7774:       }
 7775:    }
 7776: 
 7777:    //  This function returns per element sums. A reduction must be done on the host side.
 7778: }
 7779: 
 7780: 
 7781: __global__ void transport(void) {
 7782: 
 7783:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7784: 
 7785:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7786: 
 7787:    Element *elem = &(mesh->localElemData[ie]);
 7788: 
 7789:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7790: 
 7791:                for (int m=0; m<ntr; m++) {
 7792:                   for (int k=kbe(ie); k<nvrt; k++) {
 7793:                      // Calculate each polynomial's weight 
 7794:                      wm=0.d0; sum1=0.d0; 
 7795:                      wm1=0.d0; wm2=0.d0; 
 7796:                      for (int i=0; i<elem->nweno2; i++) {
 7797:                   
 7798:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7799:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7800:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7801:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7802:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7803:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7804:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7805:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7806:                      // -----------------Hu and Shu (1999)'s method----------------
 7807:                      b4=b1+b2+b3
 7808: 
 7809: //Error: add PRODUCTION CPP
 7810: #ifdef DEBUG
 7811:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7812:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7813:                     call parallel_abort(errmsg)
 7814:                   }
 7815: #endif
 7816: 
 7817:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7818:                   // !----test-------------- 
 7819:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7820:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7821:                   // !wm(i)=wm1(i)*wm2(i)
 7822:                   // !---------------------- 
 7823:                   sum1=sum1+wm(i)
 7824:                 } // end for i
 7825: 
 7826:                 wm=wm/sum1
 7827: 
 7828:                 for (int j=0; j<elem->i34; j++) {
 7829: 
 7830:                   const Side *side  = elem->sides[j];
 7831:                   const Node *node1 = side->n1;
 7832:                   const Node *node2 = side->n2;
 7833: 
 7834:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7835:                      trsd=0.d0
 7836:                      for (int kk=0; kk<nquad; kk++) {
 7837:                         for (int i=0; i<elem->nweno2; i++) {
 7838:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7839:                         } // end for i   
 7840:                      } // end for kk
 7841:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7842:                   } // outward flux
 7843:                } // end for j=1,i34(ie) ! side
 7844:             }
 7845:          }
 7846:               
 7847: 
 7848: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7849: //             //   calculate each polynomial's weight 
 7850: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7851: //                 wm=0.d0; sum1=0.d0
 7852: //                 do i=1,nweno1(ie) !for each polynomial
 7853: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7854: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7855: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7856: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7857: //                   wm(i)=b2
 7858: //                   sum1=sum1+b2
 7859: //                   !wm(i)=1.d0
 7860: //                   !sum1=sum1+1.d0
 7861: 
 7862: // // Error: PRODUCTION
 7863: // #ifdef DEBUG
 7864: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7865: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7866: //                     call parallel_abort(errmsg)
 7867: //                   endif
 7868: // #endif
 7869: 
 7870: //                 enddo !i
 7871: //                 wm=wm/sum1 !final weight
 7872: 
 7873:                 for (int j=0; j<elem->i34; j++) { // side
 7874:                   const Side *side = elem->sides[j];
 7875:                   const Node *node1 = side->n1;
 7876:                   const Node *node2 = side->n2;
 7877: 
 7878:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7879:                     trsd=0.d0
 7880:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7881:                       for (int i=0; i<elem->nweno1; i++) {
 7882:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7883:                       }
 7884:                     enddo //kk
 7885:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7886:                   } // outward flux
 7887:                 } // end for j=1,i34(ie) ! side
 7888:               } // end for k; ntr 
 7889: 
 7890:             else !simple upwind method
 7891:               do j=1,i34(ie)
 7892:                 jsj=elside(j,ie)
 7893:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7894:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7895:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7896:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7897:                   endif
 7898:                 enddo  !vertical layers
 7899:               enddo !j=1,i34(ie) ! side
 7900:             endif !order of accuracy
 7901: 
 7902:          //  enddo !ie
 7903: // !$OMP     end do
