 1653: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1654:    return;
 1655:    // Lock the mutex
 1656:    lock(&debugPlotMutex);
 1657:  
 1658:    bool ok = true;
 1659:    if (debugPlotIdx == nullptr) ok = false;
 1660:    if (*debugPlotIdx >= 10000) ok = false;
 1661:    if (ok) {
 1662:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1663:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1664:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1665:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1666:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1667:       (*debugPlotIdx)++;
 1668:    }
 1669: 
 1670:    __threadfence();               // ensure all above writes are visible
 1671:    // Unlock the mutex
 1672:    unlock(&debugPlotMutex);
 1673: 
 1674: }
