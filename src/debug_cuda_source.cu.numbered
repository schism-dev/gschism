 7127: 
 7128: __global__ void computeMatrixProductAndDotProducts() {
 7129:    // Computes A*p, r'Mr and p'Ap
 7130: 
 7131:    // 1) shared buffer: first half for rMr, second for pAp
 7132:    __shared__ double sdata[2*BLOCK_SIZE];
 7133:    double* s_rMr = sdata;
 7134:    double* s_pAp = sdata + BLOCK_SIZE;
 7135: 
 7136:    const int tid = threadIdx.x;
 7137: 
 7138:    double l_pAp = 0.0;
 7139: 
 7140:    s_rMr[tid] = 0.0;
 7141:    s_pAp[tid] = 0.0;
 7142: 
 7143:    // 2) get your node pointer
 7144:    // NODE(node);   
 7145:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7146:    Node *node = &(mesh->localNodeData[idx_node]); 
 7147:       if (idx_node < mesh->np) {
 7148: 
 7149:       const double diag = node->coeffDiag;
 7150:       const double r    = node->mR;
 7151:       const double p    = node->mP;  
 7152: 
 7153:       // apply preconditioner on the fly:
 7154:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7155: 
 7156:       // 4) compute Ap = A.p
 7157:       double Ap = node->coeffDiag * node->mP;
 7158:       for (int j = 0; j < node->numNodes; ++j) {
 7159:          const Node *nbNode = node->nodes[j];
 7160:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7161: 
 7162:       }
 7163: 
 7164:       node->mAp = Ap;
 7165:       
 7166: 
 7167:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7168:       // const double l_rMr = r*Mr;  // r'Mr
 7169:       l_pAp = p*Ap;  // p'Ap
 7170: 
 7171: 
 7172:    }
 7173: 
 7174:    // 6) write into shared mem
 7175:    // s_rMr[tid] = l_rMr;
 7176:    s_pAp[tid] = l_pAp;
 7177: 
 7178:    __syncthreads();
 7179: 
 7180:    // 7) block-wide tree reduction
 7181:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7182:       if (tid < stride)  {
 7183:          s_pAp[tid] += s_pAp[tid + stride];
 7184:       }
 7185:       __syncthreads();
 7186:    }
 7187: 
 7188:    // 8) thread 0 atomically accumulates into the globals
 7189:    // XXX: This is slower than it needs to be, but it is simple and works
 7190:    if (tid == 0) {
 7191:       atomicAdd(pAp, s_pAp[0]);
 7192:    }
 7193: 
 7194: 
 7195: }
 7196: 
 7197: 
 7198: __global__ void updateSolutionAndDotProducts(void) {
 7199:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7200: 
 7201:    const int tid = threadIdx.x;
 7202: 
 7203:    s_rMr[tid] = 0.0;
 7204: 
 7205:    // get node & bounds-check:
 7206:    NODE(node);
 7207: 
 7208:    
 7209:    // Compute alpha
 7210:    const double alpha = (*rMr_old)/(*pAp); 
 7211: 
 7212: 
 7213:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7214: 
 7215: 
 7216:    // load scalars
 7217:    const double diag = node->coeffDiag;
 7218:    const double p    = node->mP;
 7219:    const double Ap   = node->mAp;
 7220:    const double x    = node->mX;
 7221:    const double r    = node->mR;
 7222:    
 7223:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7224: 
 7225:    // 1) update solution & residual
 7226:    const double x_new = x + alpha*p;
 7227:    const double r_new = r - alpha*Ap;
 7228:    node->mX = x_new;
 7229:    node->mR = r_new;
 7230: 
 7231:    // 2) apply Jacobi preconditioner on the fly
 7232:    const double Mr_new = r_new/diag;
 7233: 
 7234: 
 7235:    // 3) local contributions for the two dot-products
 7236:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7237: 
 7238:    // 4) write into shared-mem
 7239:    s_rMr[tid] = l_rMr;
 7240: 
 7241:    __syncthreads();
 7242: 
 7243: 
 7244:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7245:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7246:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7247:       __syncthreads();
 7248:    }
 7249: 
 7250:    // 6) thread 0 atomically folds into the global accumulators
 7251:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7252: 
 7253: 
 7254: }
 7255: 
 7256: 
 7257: __global__ void updateSearchDirection() {
 7258: 
 7259:     NODE(node);
 7260: 
 7261:     // recompute z on-the-fly
 7262:     const double z = node->mR / node->coeffDiag;
 7263:     const double p = node->mP;
 7264: 
 7265:     const double beta = (*rMr_new)/(*rMr_old);
 7266: 
 7267: 
 7268:     // p =z + beta*p
 7269:     node->mP = z + beta*p;
 7270: 
 7271: }
 7272: 
 7273: __global__ void initializeScalars(double *scalars) {
 7274: 
 7275:    // These point to a cupy array in the host code
 7276:    rMr_old = scalars + 0;
 7277:    rMr_new = scalars + 1;
 7278:    pAp     = scalars + 2;
 7279: }
 7280: 
 7281: __global__ void initializePreconditionedResidual(void) {
 7282: 
 7283:     __shared__ double s_rMr[BLOCK_SIZE];  
 7284: 
 7285:     s_rMr[threadIdx.x] = 0.0;
 7286: 
 7287:     NODE_ALL(node, valid);
 7288:     const int tid = threadIdx.x;
 7289:     // For the first iteration:
 7290:     // 1. Initial solution x = 0 (already set)
 7291:     // 2. Initial residual r = b (stored in qel)
 7292:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7293: 
 7294: // XXX we should use the guess solution here    
 7295: 
 7296:     double l_rMr = 0.0;
 7297:     if (valid) {
 7298:       // Set initial residual r = b (from qel)
 7299:       node->mR = node->qel;
 7300: 
 7301:       // Compute z = M^-1 * r (preconditioned residual)
 7302:       const double z = node->mR / node->coeffDiag;
 7303: 
 7304:       // Set initial search direction p = z
 7305:       node->mP = z;
 7306: 
 7307:       // Initialize other variables needed for CG
 7308:       node->mX = 0.0;  // Initial solution
 7309:       node->mAp = 0.0; // Will be computed in first iteration
 7310: 
 7311: 
 7312:       // Computes the first r'Mr (reduction)
 7313:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7314:     }
 7315:     // 4) write into shared-mem
 7316:     s_rMr[tid] = l_rMr;
 7317: 
 7318:     __syncthreads();
 7319: 
 7320: 
 7321:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7322:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7323:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7324:         __syncthreads();
 7325:     }
 7326: 
 7327:     // 6) thread 0 atomically folds into the global accumulators
 7328:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7329: 
 7330:     *rMr_old = 0.0;
 7331:     *pAp = 0.0;
 7332: }
 7333: 
 7334: 
 7335: 
 7336: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7337:    Element *elems = mesh->localElemData;
 7338: 
 7339:    *addr = elems;
 7340:    *sizeElement = sizeof(Element);
 7341:    switch (varCode) {
 7342:       case (int)VarCode::z:
 7343:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7344:          *sizeType = sizeof(double);
 7345:          break;
 7346:       case (int)VarCode::x:
 7347:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7348:          *sizeType = sizeof(Vector2);
 7349:          break;
 7350:       case (int)VarCode::area:
 7351:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7352:          *sizeType = sizeof(double);
 7353:          break;
 7354:       case (int)VarCode::depth:
 7355:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7356:          *sizeType = sizeof(double);
 7357:          break;
 7358:       case (int)VarCode::radius:
 7359:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7360:          *sizeType = sizeof(double);
 7361:          break;
 7362:       case (int)VarCode::lonlat:
 7363:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7364:          *sizeType = sizeof(double);
 7365:          break;
 7366:       case (int)VarCode::ghat:
 7367:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7368:          *sizeType = sizeof(Vector2);
 7369:          break;
 7370:       case (int)VarCode::kb:
 7371:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7372:          *sizeType = sizeof(int);
 7373:          break;
 7374:       case (int)VarCode::isdry:
 7375:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7376:          *sizeType = sizeof(int);
 7377:          break;            
 7378:       case (int)VarCode::w:
 7379:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7380:          *sizeType = sizeof(double);
 7381:          break;
 7382:       case (int)VarCode::FaceIndices:
 7383:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7384:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7385:          *sizeType = sizeof(Node);
 7386:          break;
 7387:       default:
 7388:          *offset = -1;
 7389:    }
 7390: }
 7391: 
 7392: 
 7393: extern "C" __global__ void getSideVarAddr(int varCode, void **addr, int *offset, int *sizeSide, int *sizeType) {
 7394:    Side *sides = mesh->localSideData;
 7395: 
 7396:    *addr = sides;
 7397:    *sizeSide = sizeof(Side);
 7398:    switch (varCode) {
 7399:       case (int)VarCode::z:
 7400:          *offset = (int)((char*)&sides[0].zc - (char*)sides);
 7401:          *sizeType = sizeof(double);
 7402:          break;
 7403:       // case (int)VarCode::depth:
 7404:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 7405:       //    *sizeType = sizeof(double);
 7406:       //    break;         
 7407:       case (int)VarCode::x:
 7408:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 7409:          *sizeType = sizeof(Vector2);
 7410:          break;
 7411:       case (int)VarCode::len:
 7412:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 7413:          *sizeType = sizeof(double);
 7414:          break;
 7415:       case (int)VarCode::kb:
 7416:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7417:          *sizeType = sizeof(int);
 7418:          break;
 7419:       case (int)VarCode::isdry:
 7420:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7421:          *sizeType = sizeof(int);
 7422:          break;            
 7423:       case (int)VarCode::w:
 7424:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7425:          *sizeType = sizeof(double);
 7426:          break;
 7427:       case (int)VarCode::u:
 7428:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7429:          *sizeType = sizeof(Vector2);
 7430:          break;   
 7431:       case (int)VarCode::btu:
 7432:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 7433:          *sizeType = sizeof(Vector2);
 7434:          break;          
 7435:       case (int)VarCode::U:
 7436:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7437:          *sizeType = sizeof(Vector2);
 7438:          break;
 7439:       // case (int)VarCode::ghat:
 7440:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 7441:       //    *sizeType = sizeof(Vector2);
 7442:       //    break;   
 7443:       case (int)VarCode::hhat:
 7444:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 7445:          *sizeType = sizeof(Vector2);
 7446:          break;      
 7447:       case (int)VarCode::chi:
 7448:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 7449:          *sizeType = sizeof(double);
 7450:          break;
 7451:       case (int)VarCode::n1:
 7452:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7453:          *sizeType = sizeof(Node);
 7454:          break;
 7455:       case (int)VarCode::n2:
 7456:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7457:          *sizeType = sizeof(Node);
 7458:          break;                   
 7459:       default:
 7460:          *offset = -1;
 7461:    }
 7462: }
 7463: 
 7464: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7465:    Node *nodes = mesh->localNodeData;
 7466: 
 7467:    *addr = nodes;
 7468:    *sizeNode = sizeof(Node);
 7469: 
 7470:    switch (varCode) {
 7471:       case (int)VarCode::depth:
 7472:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7473:          *sizeType = sizeof(double);
 7474:          break;
 7475:       case (int)VarCode::eta:
 7476:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7477:          *sizeType = sizeof(double);
 7478:          break;
 7479:       case (int)VarCode::x:
 7480:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7481:          *sizeType = sizeof(Vector2);
 7482:          break;
 7483:       case (int)VarCode::z:
 7484:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7485:          *sizeType = sizeof(double);
 7486:          break;
 7487:       case (int)VarCode::kb:
 7488:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7489:          *sizeType = sizeof(int);
 7490:          break;
 7491:       case (int)VarCode::isdry:
 7492:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7493:          *sizeType = sizeof(int);
 7494:          break;         
 7495:       case (int)VarCode::w:
 7496:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7497:          *sizeType = sizeof(double);
 7498:          break;
 7499:       case (int)VarCode::u:
 7500:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7501:          *sizeType = sizeof(Vector2);
 7502:          break;         
 7503:       default:
 7504:          *offset = -1;    
 7505:    }  
 7506:    
 7507: }
 7508: 
 7509: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7510:    // Get the value of a variable from an element
 7511:    // varName is the name of the variable to get
 7512:    // var is the array to store the value
 7513:    // k is the vertical level index of the variable to get
 7514: 
 7515:    ELEM(elem);
 7516:    
 7517:    int idx = elem->idx;
 7518:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7519: 
 7520:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7521:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7522:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7523:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7524:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7525:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7526:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7527:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7528:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7529:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7530:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7531:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7532:       
 7533:    
 7534: }
 7535: 
 7536: 
 7537: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7538:    // Get the value of a variable from an node
 7539:    // varName is the name of the variable to get
 7540:    // var is the array to store the value
 7541:    // k is the vertical level index of the variable to get
 7542: 
 7543:    NODE(node);
 7544:    
 7545:    int idx = node->idx;
 7546:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7547: 
 7548:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7549:    
 7550:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7551:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7552:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7553:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7554:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7555:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7556:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7557:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7558:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7559:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7560:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7561:    
 7562:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7563:       
 7564:    
 7565: }
 7566: 
 7567: 
 7568: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7569:    // Get the value of a variable from an side
 7570:    // varName is the name of the variable to get
 7571:    // var is the array to store the value
 7572:    // k is the vertical level index of the variable to get
 7573:    SIDE(side);
 7574:    
 7575:    int idx = side->idx;
 7576:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7577: 
 7578:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7579:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7580:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7581:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7582:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7583:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7584:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7585:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7586:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7587:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7588:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7589:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7590:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7591:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7592:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7593:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7594:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7595:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7596:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7597:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7598:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7599:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7600:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7601:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7602:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7603:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7604:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7605:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7606:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7607:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7608:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7609:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7610:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7611:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7612:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7613:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7614:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7615: }
 7616: 
 7617: 
 7618: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7619:    // Get the value of a variable from an side
 7620:    // varName is the name of the variable to get
 7621:    // var is the array to store the value
 7622:    // k is the vertical level index of the variable to get
 7623:    SIDE_BND(sideBnd);   
 7624: 
 7625:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7626:    if (sideBnd->segment->isLand) idx = -7;
 7627: 
 7628:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7629:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7630: 
 7631: }
