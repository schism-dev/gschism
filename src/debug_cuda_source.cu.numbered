  560: 
  561: // ----------------------------- Frames -----------------------------
  562: 
  563: // Frames are used to transform vectors between different coordinate systems.
  564: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  565: template<int ICS>
  566: struct Frame {};
  567: 
  568: template<>
  569: struct Frame<1> {
  570:    __forceinline__ __device__ void update(double, double) {}
  571:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  572:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  573:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  574:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  575:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  576:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  577: };
  578: 
  579: template<>
  580: struct Frame<2> {
  581:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  582:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  583:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  584:     double t00, t10;        // col0 (t20=0 implicit)
  585:     double t01, t11, t21;   // col1
  586: 
  587:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  588: 
  589:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  590:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  591: 
  592:       double sin_lon, cos_lon, sin_lat, cos_lat;
  593:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  594:       sincos(lat, &sin_lat, &cos_lat);
  595: 
  596:       t00 = -sin_lon;
  597:       t10 =  cos_lon;
  598:       t01 = -cos_lon*sin_lat;
  599:       t11 = -sin_lon*sin_lat;
  600:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  601: 
  602:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  603:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  604: 
  605:       const double col1_norm_inv = 1.0/col1_norm;
  606:       t01 = t01*col1_norm_inv;
  607:       t11 = t11*col1_norm_inv;
  608:       t21 = t21*col1_norm_inv;
  609: 
  610:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  611: 
  612: 
  613:    }
  614: 
  615:    __forceinline__ __device__ void print(void) const {
  616:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  617:    }
  618: 
  619:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  620:       // cross(col0, col1), with t20=0 implicitly:
  621:       // |  i       j       k   |
  622:       // | t00     t10      0   |
  623:       // | t01     t11     t21  |
  624:       t02 =  t10*t21;
  625:       t12 = -t00*t21;
  626:       t22 =  t00*t11 - t10*t01;
  627:    }
  628: 
  629: 
  630:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  631:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  632:    // Inputs:
  633:    //        vec0: vel. in this frame;
  634:    //        frameout: Output frame;
  635:    // Output: 
  636:    //        vel. in new frame  
  637:    //
  638:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  639:    // discarding the z-component of the result to keep only the local horizontal
  640:    // plane of frame 2.
  641:    //
  642:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  643:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  644:    // are orthogonal. This product is computed as dot products between columns of
  645:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  646:    // columns of F2.// 
  647: 
  648:       auto const fo = frameout; // Just an alias for the output frame.
  649:       Vector2 res;
  650: 
  651:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  652:       // of t and fo.t are the same.
  653:       const double d00 = t00*fo.t00 + t10*fo.t10;
  654:       const double d10 = t01*fo.t00 + t11*fo.t10;
  655: 
  656:       const double d01 = t00*fo.t01 + t10*fo.t11;
  657:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  658: 
  659:       res.x = vec0.x * d00 + vec0.y * d10;
  660:       res.y = vec0.x * d01 + vec0.y * d11;
  661: 
  662:       return res;
  663:    }
  664: 
  665:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  666:       Vector3 vo;
  667:       double t02, t12, t22;
  668: 
  669:       // Compute the 3rd column of the frame tensor
  670:       getCol2(t02, t12, t22);
  671: 
  672:       vo.x = vi.x*t00 + vi.y*t10;
  673:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  674:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  675: 
  676:       return vo;
  677:    
  678:    }
  679: 
  680:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  681:       Vector3 vo;
  682:       double t02, t12, t22;
  683: 
  684:    // Compute the 3rd column of the frame tensor
  685:       getCol2(t02, t12, t22);
  686: 
  687:       // F * vi (non-transposed, so we use rows of F)
  688:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  689:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  690:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  691: 
  692:       return vo;
  693:    }
  694: 
  695:    // Unit vectors that define the local frame
  696:    __forceinline__ __device__ Vector3 nUp(void) const {
  697:       // Column 2 = cross(column0, column1)
  698:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  699:    }
  700: 
  701:    __forceinline__ __device__ Vector3 nZonal(void) const {
  702:       // Column 0
  703:       return { t00, t10, 0.0 };
  704:    }
  705: 
  706:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  707:       // Column 1
  708:       return { t01, t11, t21 };
  709:    }
  710: 
  711: };
