 1628: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1629:    // Computes the 3D normal vector to the element at level k
 1630:    // Returns the normal vector and the area of the element
 1631: 
 1632:       if (isTri()) {
 1633:          // For triangles...
 1634: 
 1635:          // Gets the normal vector to the element (with a length equal to twice the area)
 1636:          if constexpr(ics==1) {
 1637:             const int kb0 = max(k, nodes[0]->kb);
 1638:             const int kb1 = max(k, nodes[1]->kb);
 1639:             const int kb2 = max(k, nodes[2]->kb);
 1640: 
 1641:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1642:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1643:             
 1644:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1645:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1646:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1647:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1648: 
 1649:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1650:             area3D = 0.5*len;
 1651: 
 1652:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1653: 
 1654:             return {nx/len, ny/len, nz/len};
 1655: 
 1656:            
 1657:          }
 1658:          else {  // lat/lon
 1659:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1660: 
 1661:          } // if ics
 1662:       }
 1663:       else {
 1664:          // For quads...
 1665: 
 1666:          assert(false && "Element normal vector: quads not yet implemented");
 1667: 
 1668: 
 1669:       }
 1670:    }
 1671: 
 1672: /**
 1673:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1674:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1675:    If the segment is completely inside the element, then it returns true.
 1676: 
 1677:    This function assumes:
 1678:    - The initial point is on a side of the element. 
 1679:    - Its position is given by parameter t in the range [0,1].
 1680:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1681:       intersects the element (elements are convex).
 1682: 
 1683:    To find the intersection point, this function does the following:
 1684:    - it finds the intersection of the line segment with all the element side lines,
 1685:       except for the one that contains the initial point.
 1686:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1687:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1688:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1689:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1690:       track segment is almost parallel to the element side line.
 1691: 
 1692:    Inputs:
 1693:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1694:    @param x2, y2: other end of the line segment
 1695: 
 1696:    Outputs:
 1697:    @param side:  side that intersects the line segment (input and output)
 1698:    @param nextElement (output): element that contains the intersection point
 1699:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1700:    @param zint (input/output): Vertical coordinate of the intersection point
 1701: 
 1702:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1703:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1704:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1705: 
 1706:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1707:    (Delta) being zero.
 1708: 
 1709:    The intersection2 point happens when:
 1710:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1711:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1712:    
 1713:    Assumption: the 4 points (including those of the side segment) are different.
 1714:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1715:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1716:    If true, (xIntersect,yIntersect) is the intersection.				
 1717:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1718: **/
 1719: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1720:                                               double &t, double& tIntersect) {
 1721: 
 1722:    double closest_intersect_t = 1e10;
 1723:    bool found_intersection = false;
 1724: 
 1725:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1726:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1727:    const Point2 x1 = side->point(t);
 1728:    
 1729: 
 1730:    Side *nextSide = nullptr;
 1731:    for (int i = 0; i < i34; i++) {
 1732: 
 1733:       // Element's i-th side 
 1734:       Side *side2 = sides[i];
 1735: 
 1736:       // Skip the side that contains the initial point
 1737:       if (side2 == side) continue;
 1738: 
 1739:       // (x3,y3)-(x4,y4) is the element side line
 1740:       const Point2 x3 = side2->n1->p2();
 1741:       const Point2 x4 = side2->n2->p2();
 1742: 
 1743:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1744:       const double delta = cross(x2 - x1, x3 - x4);
 1745: 
 1746:       if (delta != 0.0) {
 1747: 
 1748:          const double delta1 = cross(x3 - x1, x3 - x4);
 1749:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1750: 
 1751:          // Solves the two linear equations for tt1 and tt2
 1752:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1753:          const double tt2 = delta2/delta;
 1754: 
 1755:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1756:             closest_intersect_t = min(closest_intersect_t, tt1);
 1757:             nextSide = side2;
 1758: 
 1759:             nextElement = nextSide->otherElem(this);
 1760:             tIntersect = max(small, min(tt1, 1.0-small));
 1761:             t = tt2;
 1762: 
 1763:             found_intersection = true;
 1764:          }
 1765:       
 1766:       }
 1767: 
 1768:    }
 1769: 
 1770:    // found_intersection should always be true, since we checked all the sides.  
 1771:    side = nextSide;
 1772: 
 1773:    return found_intersection;
 1774: }
 1775: 
 1776: 
 1777: 
 1778: 
 1779: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1780:                                               double &t, double& tIntersect) {
 1781: 
 1782:    double closest_intersect_t = 1e10;
 1783:    bool found_intersection = false;
 1784: 
 1785:    for (int i = 0; i < i34; i++) {
 1786: 
 1787:       Side *side2 = sides[i];
 1788: 
 1789:       // (x3,y3)-(x4,y4) is the element side line
 1790:       const Point2 x3 = side2->n1->p2();
 1791:       const Point2 x4 = side2->n2->p2();
 1792: 
 1793:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1794:       const double delta = cross(x2 - x1, x3 - x4);
 1795: 
 1796:       if (abs(delta) > 0) {
 1797: 
 1798:          const double delta1 = cross(x3 - x1, x3 - x4);
 1799:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1800: 
 1801:          // Solves the two linear equations for tt1 and tt2
 1802:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1803:          const double tt2 = delta2/delta;
 1804: 
 1805:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1806:             closest_intersect_t = min(closest_intersect_t, tt1);
 1807:             side = side2;
 1808:             nextElement = side->otherElem(this);
 1809:             t = tt2;
 1810:             tIntersect = max(small, min(tt1, 1.0-small));
 1811:             found_intersection = true;
 1812:          }
 1813:       
 1814:       }
 1815:       else {  // parallel segments
 1816:          assert(false && "Parallel segments");
 1817:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1818:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1819: 
 1820:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1821: 
 1822:          // const double dist = dot(x1 - x3, side2->n);
 1823:          // if (abs(dist) < small*length(x3 - x4)) {
 1824:          //    const double2 unitarySide = normalize(x4 - x3);
 1825:          //    const double len = dot(x2 - x1, unitarySide);
 1826:          //    t = t + len;
 1827:          //    t = max(0.0, min(t, 1.0));
 1828:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1829: 
 1830: 
 1831:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1832:          //    // t = tt2;
 1833:          //    found_intersection = true;
 1834:          // }
 1835:       }
 1836: 
 1837: 
 1838:    }
 1839: 
 1840:       
 1841:    assert(found_intersection && "No intersection found");
 1842: 
 1843:    // found_intersection should always be true, since we checked all the sides.  
 1844:    return found_intersection;
 1845: }
 1846: 
 1847: 
 1848: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1849:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1850: 
 1851:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1852: 
 1853:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1854:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1855:    // curElement.
 1856: 
 1857:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1858:    // And uses this velocity instead to continue the tracking.
 1859: 
 1860:    // computes the intersection point in cartesian coordinates
 1861:    Point2 intersection = nextSide->p_t(tt);
 1862: 
 1863:    // Nudges the point to the barycenter of the element. 
 1864:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1865:    // next segment intersects the element sides.  
 1866:    curElem->nudgeToBarycenter(intersection);
 1867: 
 1868:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1869:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1870:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1871:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1872: 
 1873:    // If the side is an open boundary, the tangential velocity is zero.
 1874:    if (nextSide->isBnd()) vtan = 0.0;
 1875: 
 1876:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1877:    const double us = vtan*nextSide->t().x;
 1878:    const double vs = vtan*nextSide->t().y;
 1879:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1880: 
 1881:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1882:    const double len2 = norm2(intersection - toPoint2(xt));
 1883:    const double vel2 = dot(u_int, u_int);        
 1884:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1885:    else            dt = 0.0;
 1886: 
 1887:    // The end of this tracking segment is now the intersection point.
 1888:    xt = {intersection.x, intersection.y, zint};
 1889: 
 1890:    u_int = {us, vs, ws};
 1891:    
 1892: }
 1893: 
 1894: /**
 1895:  * Tracks a particle through elements and vertical levels in the mesh.
 1896:  * 
 1897:  * @param x0,y0,z0     Starting position coordinates
 1898:  * @param xt,yt,zt     Target position coordinates
 1899:  * @param dtb          Time step for tracking
 1900:  * @param uuint,vvint,wwint Initial velocity components
 1901:  * @param nextElem     Starting/resulting element index
 1902:  * 
 1903:  * @return Status code of type trackExitCodes
 1904:  * 
 1905:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1906:  * of the details are different. The idea is that the code requires less branches and is better fit
 1907:  * for GPU execution.
 1908:  * 
 1909:  * The main ideas here are:
 1910:  * - The starting point is expected to be in the starting element.
 1911:  * - The end point is guaranteed to be inside an element.
 1912:  * - since the starting point is inside the element, there are only two cases: 
 1913:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1914:  *     (b) it does not and (xt,yt) is already in the starting element.
 1915:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1916:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1917:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1918:  * - tt1 can be positive or negative. We only consider the positive values.
 1919:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1920:  * - The next intersection will occur at the smallest positive tt1.
 1921:  * - This intersection will be the next (x0,y0) position.
 1922:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1923:  *   of getting stuck in a loop.
 1924:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1925:  *   was found.
 1926:  */
 1927: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1928:                                                        Element *&nextElem, int &jlev, double &dt,
 1929:                                                        const Side *origSide) {
 1930: 
 1931: 
 1932: 
 1933:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1934:    // else to do.
 1935:    // If it is, nudges the point to be inside the element.
 1936:    const Element *curElem = nextElem;
 1937:    if (containsPoint(toPoint2(xt), true)) {
 1938: 
 1939:       curElem->interpolateVelocities(xt, u_int);
 1940: 
 1941: addDebugPlot(x0, xt);
 1942:       return true;
 1943:    }
 1944: 
 1945:    Side *side = nullptr;
 1946: 
 1947:    // 1. Initial checks
 1948:    // Verify starting element is valid (wet)
 1949:    assert(!curElem->isDry && "Starting element is dry");
 1950: 
 1951:    // Checks if track has a zero length.
 1952:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1953:    // assert(len2 > 0.0 && "Zero length track"); 
 1954:    
 1955:    const int MAX_ITERATIONS = 1000;
 1956:    
 1957:    double t;
 1958:    Side *nextSide = nullptr;
 1959:    double tIntersect = 1e10;
 1960:    double zint = x0.z;
 1961: 
 1962:    // Horizontal tracking loop
 1963:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1964:    // (x0,y0) is inside the element but the target point is not.
 1965: 
 1966:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1967: 
 1968:    assert(found_intersection && "No intersection found at %d");
 1969: 
 1970:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1971: 
 1972:    // if the tracking segment goes out of water (either dry or edge boundary)
 1973:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1974: 
 1975: addDebugPlot(x0, xt, 0x00A0FF);
 1976:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1977: addDebugPlot(x0, xt, 0x00A0FF);      
 1978: 
 1979:       nextElem = this;
 1980:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1981:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1982:       return true;    
 1983:    }
 1984: 
 1985: 
 1986:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1987:    int iterations = 0;
 1988:    while (iterations < MAX_ITERATIONS) {
 1989:       iterations++;
 1990:       
 1991:       Element *curElem = nextElem;
 1992: 
 1993:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1994: addDebugPlot(x0, xt);
 1995:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1996: 
 1997:       // If we are already in the target element, we are done.
 1998:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1999:       if (!found_intersection) break;
 2000: 
 2001: 
 2002: 
 2003:       // if the tracking segment goes out of water (either dry or edge boundary).
 2004:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2005: addDebugPlot(x0, xt, 0x00A0FF);
 2006:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2007: addDebugPlot(x0, xt, 0x00A0FF);   
 2008:          nextElem = curElem;
 2009: 
 2010:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2011:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2012:          return true;
 2013:       }
 2014:       
 2015:       // Update position and element for next iteration
 2016:       side = nextSide;
 2017: 
 2018:    }
 2019: 
 2020:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2021: 
 2022:  
 2023:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2024:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2025: addDebugPlot(x0, xt);   
 2026:    nextElem->interpolateVelocities(xt, u_int); 
 2027: 
 2028:    return true;
 2029: }
 2030: 
 2031: 
 2032: __inline__ __device__ double Element::computeSignedArea(void) const {
 2033:    // Compute the area of the element
 2034: 
 2035:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2036: 
 2037:    // In the quad case we need to add the area of the other triangle.
 2038:    if (isQuad()) {
 2039:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2040:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2041:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2042:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2043:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2044:          Error("Negative area found in quad element");
 2045:       }
 2046:       res += ar1;
 2047:    }
 2048: 
 2049:    return res;
 2050: }
 2051: 
 2052: 
 2053: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2054:                                                                 (nodes[1]->isDry2()) ||
 2055:                                                                 (nodes[2]->isDry2()) ||
 2056:                                                                 (i34==4 && nodes[3]->isDry2());
 2057: }
 2058: 
 2059: 
 2060: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2061:    // In boundary sides, the element 1 is nullptr
 2062:    return side->elems[1] == nullptr; 
 2063: }
 2064: 
 2065: 
 2066: 
 2067: /**
 2068:    Compute the shape coordinates of the point (xt,yt) in the element.
 2069:    @param xt (input): x-coordinate of the point
 2070:    @param shpCoords (output): shape coordinates of the point
 2071:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2072:    @return true if the point is inside the element, false otherwise
 2073: **/
 2074: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2075:                                             bool fixNegshpCoord) const {
 2076: 
 2077:    // Compute the shape coordinates of the point xt in the element.
 2078:    if (i34==3) {
 2079:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2080:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2081:       // and in this case, the pt will be nudged into the element
 2082:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2083:       // from the local frame, so use additional check.
 2084: 
 2085:       Point2 x0, x1, x2;
 2086: 
 2087:       if constexpr(ics==1) {
 2088:          x0 = nodes[0]->p2();
 2089:          x1 = nodes[1]->p2();
 2090:          x2 = nodes[2]->p2();
 2091:       }
 2092:       else // lat/lon
 2093:       {
 2094:          Error("Not implemented yet");
 2095: #ifdef ICS2
 2096:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2097:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2098:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2099: #endif
 2100:       }
 2101: 
 2102:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2103:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2104:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2105:       shpCoords[3] = 0.0;
 2106:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2107: 
 2108:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2109:       // then we fix the negative shape coordinates.
 2110:       if (fixNegshpCoord && tmpmin<=0.0) {
 2111: 
 2112:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2113:          // keeping the sum of the shape coordinates equal to 1.
 2114:          // I have tested and compared the new algorithm with the old one, and they give
 2115:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2116:          // The new algorithm should be faster since it is branchless.
 2117:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2118:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2119:          
 2120:          shpCoords[0] = (shpCoords[0] + a)*b;
 2121:          shpCoords[1] = (shpCoords[1] + a)*b;
 2122:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2123: 
 2124:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2125:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2126:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2127:          }
 2128: 
 2129:          // Update the point coordinates for the new shape coordinates
 2130:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2131:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2132:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2133: 
 2134:       }
 2135: 
 2136:       // Check if the point is inside the element
 2137:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2138:    }
 2139:    else {
 2140:       Error("Not implemented yet");
 2141: #ifdef QUADS
 2142:       // Reproject pt in eframe of nel for ics=2
 2143:       if constexpr(ics==1) {
 2144:          xn2 = xt; 
 2145:          yn2 = yt;
 2146:       }
 2147:       else {
 2148:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2149:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2150:       }
 2151: 
 2152:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2153: #endif
 2154:    }
 2155: 
 2156:    return false;  // Never reached
 2157: 
 2158: }
 2159: 
 2160: 
 2161: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2162: // Convert shape coordinates to cartesian coordinates
 2163: 
 2164:    if (i34 == 3) {
 2165:       // Triangular element
 2166:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2167:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2168:    }
 2169:    else {
 2170:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2171:    }
 2172: 
 2173: }
 2174: 
 2175: 
 2176: /**  Interpolate velocities at a given point (xt,yt,zt)
 2177: 
 2178:    @param xt, yt, zt: coordinates of the point to interpolate
 2179:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2180: 
 2181:    This is done in four steps:
 2182: 
 2183:    1. Find the shape coordinates for the final position in the element.
 2184:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2185:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2186:       z levels at xt, yt at each step.   
 2187:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2188:       horizontally and vertically.
 2189: **/
 2190: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2191:    // Interpolate the velocities at the point xt. 
 2192:    // This function works the same for triangular and quadrilateral elements.
 2193:    double shpCoord[4];
 2194: 
 2195:    // First step is to compute the shape coordinates of (xt,yt)
 2196:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2197:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2198: 
 2199:    // Second step is to find the level that contains zt
 2200:    // Uses a binary search to find the level
 2201:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2202:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2203:    int R = nvrt - 1;
 2204: 
 2205:    // Get the z coordinates at the nodes of the element at the levels L and R
 2206:    double zLAtNodes[4], zRAtNodes[4];
 2207:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2208:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2209: 
 2210:    double zL = interpolate(shpCoord, zLAtNodes);
 2211:    double zR = interpolate(shpCoord, zRAtNodes);
 2212:    
 2213:    // Interpolates vertically the velocities
 2214:    double wght1, wght2;
 2215:    if (xt.z<=zL) {
 2216:       wght1 = 1.0;
 2217:       wght2 = 0.0;
 2218:    }
 2219:    else if (xt.z>=zR) {
 2220:       wght1 = 0.0;
 2221:       wght2 = 1.0;
 2222:    }
 2223:    else {
 2224:       // Perform a binary search to find the levels between L and R that contain xt.z
 2225:       while (R - L > 1) {
 2226:          int M = (L + R) / 2;
 2227: 
 2228:          double zMAtNodes[4];
 2229:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2230:          double zM = interpolate(shpCoord, zMAtNodes);
 2231:          if (zM < xt.z) 
 2232:          {
 2233:             L = M;
 2234:             zL = zM;
 2235:          }
 2236:          else 
 2237:          {
 2238:             R = M;
 2239:             zR = zM;
 2240:          }
 2241:       }
 2242:       assert(L == R-1);
 2243:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2244: 
 2245:       wght2 = (xt.z - zL)/(zR - zL);
 2246:       wght1 = 1.0 - wght2;
 2247:    }
 2248: 
 2249:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2250:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2251: 
 2252:    // Neither of the interpolated velocities should be NaN
 2253:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2254: 
 2255: }
