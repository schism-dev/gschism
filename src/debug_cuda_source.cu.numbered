 9787: template<TurbulenceModel M>
 9788: __device__ __forceinline__ double getTKE(const Turbulence<M> &turb, int k) {
 9789:    if constexpr (M == TurbulenceModel::GLS)
 9790:       return turb.tke[k];
 9791:    else
 9792:       return 0.0;
 9793: }
 9794: template<TurbulenceModel M>
 9795: __device__ __forceinline__ double getMXL(const Turbulence<M> &turb, int k) {
 9796:    if constexpr (M == TurbulenceModel::GLS)
 9797:       return turb.mxl[k];
 9798:    else
 9799:       return 0.0;
 9800: }
