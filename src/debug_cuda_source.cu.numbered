 3878:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3879: 
 3880:       NODE_BND(nodeBnd);
 3881: 
 3882:       Node *node = nodeBnd->node;
 3883: 
 3884:       node->ETP = 0.0;
 3885: 
 3886:       for (int j=0; j<ntip; j++) {
 3887: 
 3888:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3889:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3890:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3891: 
 3892:          if constexpr(iloadtide==1) { // loading tide
 3893:             assert(false && "Loading tide not implemented");
 3894:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3895:          }
 3896:          
 3897:       }
 3898:       
 3899:    }
