  854:    int ifltype;  // Type of flow boundary condition
  855:    
  856:    // Elevation boundary condition
  857:    int iettype;  // Type of elevation boundary condition
  858:    double eth;   // Elevation time history
  859: 
  860:    // Flow boundary condition
  861:    double qthcon;  // Flow time history constant
  862:    double vobc1;   // Velocity coefficient 1
  863:    double vobc2;   // Velocity coefficient 2
  864: 
  865:    // Tracer boundary conditions
  866:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  867:    // int  itrtype[natrm];    // Tracer boundary condition type
  868: 
  869:    BoundarySegment(bool _isLand) {
  870:       isLand = _isLand;
  871:       clen = 0.0;
  872:       carea = 0.0;
  873:       ifltype = 0;
  874:       iettype = 0;
  875:       eth = 0.0;
  876:    }
  877: 
  878:    BoundarySegment(void) {
  879:       isLand = false;
  880:       clen = 0.0;
  881:       carea = 0.0;
  882:       ifltype = 0;
  883:       iettype = 0;
  884:       eth = 0.0;
  885:    }
  886: 
  887:    
  888: };
