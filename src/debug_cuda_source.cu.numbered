 1861: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1862:    // Computes the 3D normal vector to the element at level k
 1863:    // Returns the normal vector and the area of the element
 1864: 
 1865:    if (isTri()) {
 1866:       // For triangles...
 1867: 
 1868:       // Gets the normal vector to the element (with a length equal to twice the area)
 1869:       if constexpr(ics==1) {
 1870:          const int kb0 = max(k, nodes[0]->kb);
 1871:          const int kb1 = max(k, nodes[1]->kb);
 1872:          const int kb2 = max(k, nodes[2]->kb);
 1873: 
 1874:          const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1875:          const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1876:          
 1877:          // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1878:          const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1879:          const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1880:          const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1881: 
 1882:          const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1883:          area3D = 0.5*len;
 1884: 
 1885:          assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1886: 
 1887:          return {nx/len, ny/len, nz/len};
 1888: 
 1889:          
 1890:       }
 1891:       else {  // lat/lon
 1892:          assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1893:          return {0.0, 0.0, 0.0};
 1894: 
 1895:       } // if ics
 1896:    }
 1897:    else {
 1898:       // For quads...
 1899: 
 1900:       assert(false && "Element normal vector: quads not yet implemented");
 1901:       return {0.0, 0.0, 0.0};
 1902: 
 1903: 
 1904:    }
 1905: }
