 2162: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2163: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2164: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2165: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2166:    Vector2 grad = {0.0, 0.0};
 2167:    int count = 0;
 2168: 
 2169:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2170: 
 2171:    // First element
 2172:    if (elems[0] != nullptr && condition(elems[0])) {
 2173:       grad += elems[0]->grad2(field);
 2174:       count++;
 2175:    }
 2176: 
 2177:    // Second element
 2178:    if (elems[1] != nullptr && condition(elems[1])) {
 2179:       grad += elems[1]->grad2(field);
 2180:       count++;
 2181:    }
 2182: 
 2183:    if (count > 0) {
 2184:       grad = grad/count;
 2185:    }
 2186:    
 2187:    return grad;
 2188: }
