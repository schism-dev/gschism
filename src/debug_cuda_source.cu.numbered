 8108: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8109:    // Get the value of a variable from an element
 8110:    // varName is the name of the variable to get
 8111:    // var is the array to store the value
 8112:    // k is the vertical level index of the variable to get
 8113: 
 8114:    ELEM(elem);
 8115:    
 8116:    int idx = elem->idx;
 8117:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8118: 
 8119:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8120:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8121:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8122:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8123:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8124:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8125:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8126:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8127:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8128:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8129:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8130:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8131:       
 8132:    
 8133: }
 8134: 
 8135: 
 8136: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8137:    // Get the value of a variable from an node
 8138:    // varName is the name of the variable to get
 8139:    // var is the array to store the value
 8140:    // k is the vertical level index of the variable to get
 8141: 
 8142:    NODE(node);
 8143:    
 8144:    int idx = node->idx;
 8145:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8146: 
 8147:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8148:    
 8149:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8150:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8151:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8152:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8153:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8154:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8155:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8156:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8157:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8158:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8159:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8160:    
 8161:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8162:       
 8163:    
 8164: }
 8165: 
 8166: 
 8167: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8168:    // Get the value of a variable from an side
 8169:    // varName is the name of the variable to get
 8170:    // var is the array to store the value
 8171:    // k is the vertical level index of the variable to get
 8172:    SIDE(side);
 8173:    
 8174:    int idx = side->idx;
 8175:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8176: 
 8177:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8178:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8179:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8180:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8181:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8182:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8183:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8184:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8185:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8186:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8187:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8188:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8189:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8190:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8191:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8192:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8193:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8194:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8195:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8196:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8197:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8198:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8199:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8200:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8201:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8202:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8203:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8204:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8205:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8206:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8207:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8208:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8209:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8210:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8211:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8212:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8213: }
 8214: 
 8215: 
 8216: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8217:    // Get the value of a variable from an side
 8218:    // varName is the name of the variable to get
 8219:    // var is the array to store the value
 8220:    // k is the vertical level index of the variable to get
 8221:    SIDE_BND(sideBnd);   
 8222: 
 8223:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8224:    if (sideBnd->segment->isLand) idx = -7;
 8225: 
 8226:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8227:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8228: 
 8229: }
