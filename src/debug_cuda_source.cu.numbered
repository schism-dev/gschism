  570: struct Element {
  571: 
  572:    // Geometry information
  573:    int idx;                   // Index of the element
  574:    int i34;                   // Number of sides for the element 
  575:    Side *sides[4];            // Sides of the element
  576:    Node *nodes[4];            // Nodes of the element
  577:    Element *nghbElems[4];     // Neighbors of the element
  578: 
  579:    int kb;                    // Bottom index of the element
  580:    double area;               // Area of the element
  581:    double ssign[4];           // Sign associated with each side of an element
  582:    double radius;             // Element equivalent radii
  583: 
  584:    #ifdef USE_FRAMES
  585:    Frame frame;
  586:    #endif
  587: 
  588:    Vector2 gradPhi[4];        // Derivatives of shape functions
  589:    Vector2 gradEta;           // Gradient of free surface elevation
  590:    Vector2 gradPr;            // Gradient of pressure    
  591:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  592: 
  593:    bool isDry;                // True if the element is dry
  594: 
  595:    Point2 center;            // Element center coordinates
  596: 
  597:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  598:    double depth;              // Depth at element (min of all nodes)
  599:    double z[nvrt];            // z-coord  (local frame - vertical up)
  600: 
  601:    // Physical information
  602:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  603: 
  604:    static const bool isblock = false;              // Always false
  605: 
  606:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  607:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  608: 
  609:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  610:    
  611: 
  612:    double vsource;            // Volumetric source/sink term [m^3/s]
  613: 
  614:    double rho[nvrt];          // Density at each prism center
  615:    double rho_mean[nvrt];     // Mean density at each prism center
  616:    CubicSpline rho_spl;
  617:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  618:    double rho_z[nvrt];        // First derivative of density at each prism center
  619:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  620:    
  621: 
  622:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  623: 
  624:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  625:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  626: 
  627:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  628:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  629: 
  630:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  631:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  632:       // Find the local index of the node in the element (0,1,2,3)
  633:       int res = __ffs((nodes[0] == node) | 
  634:                      ((nodes[1] == node) << 1) | 
  635:                      ((nodes[2] == node) << 2) | 
  636:                      ((nodes[3] == node) << 3)) - 1;
  637:       
  638:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  639:       return res;  
  640:    }
  641: 
  642:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  643:       // Find the local index of the side in the element (0,1,2,3)
  644:       int res = __ffs((sides[0] == side) | 
  645:                      ((sides[1] == side) << 1) | 
  646:                      ((sides[2] == side) << 2) | 
  647:                      ((sides[3] == side) << 3)) - 1;
  648:       
  649:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  650:       return res;
  651:    }
  652: 
  653:    __inline__ __device__ int findLevel(double z1, int k) const {
  654:       // Starting at index k, find sequentially the level that contains z
  655: 
  656:       // For testing purposes, forgets k and performs a full search.
  657:       for (k = kb; k < nvrt - 1; k++) {
  658:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  659:       }
  660:       return nvrt - 2;
  661: 
  662: 
  663:       // if z is already betweeen z[k] and z[k+1], return k
  664:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  665:       else if (z1 <  z[k]) { 
  666:          // Search for increasing levels
  667:          for (int kk = k; kk < nvrt - 1; kk++) {
  668:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  669:          }
  670:          return nvrt - 1;
  671:       }
  672:       else {
  673:          // Search for decreasing levels
  674:          for (int kk = k; kk >= kb; kk--) {
  675:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  676:          }
  677:          return 0;
  678:       }
  679:    }
  680: 
  681:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  682:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  683: 
  684: 
  685:    __device__ __forceinline__ double centerZ(void) const;
  686: 
  687:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  688:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  689:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  690:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2) const;
  691:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  692: 
  693: 
  694:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  695:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  696:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  697:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  698:        const double eta = (idxNode & 1) ? +g : -g;
  699:        const double xi  = (idxNode & 2) ? +g : -g;
  700:        return {eta, xi};
  701:    }  
  702: 
  703:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  704:    __device__ __forceinline__ double etaSign(int idxNode) const {
  705:       // bit1: 0 -> -1, 1 -> +1
  706:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  707:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  708:    }
  709: 
  710:    __device__ __forceinline__ double xiSign(int idxNode) const {
  711:       // +1 if (bit0 XOR bit1), else -1
  712:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  713:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  714: 
  715:    }
  716: 
  717:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  718:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  719:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  720:    }
  721: 
  722:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  723:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  724:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  725:    }   
  726: 
  727:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  728:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  729:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  730:    }      
  731:    
  732:    __inline__ __device__ double detJ_eta(void) const;
  733: 
  734:    __inline__ __device__ double detJ_xi(void) const;
  735: 
  736:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  737: 
  738:    // Check if the element is dry using the more up-to-date elevation.
  739:    __inline__ __device__ bool isDry2(void) const;
  740: 
  741:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  742: 
  743:    __inline__ __device__ double computeSignedArea(void) const;
  744: 
  745:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  746:       // Nudges the point (x,y) to the barycenter of the element
  747: 
  748:       p = (1.0 - btrack_nudge)*p + btrack_nudge*center;
  749:    }
