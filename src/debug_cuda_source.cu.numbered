 2553: /**
 2554:  * This method performs backtracking from the side center until a time -dt back in time 
 2555:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2556:  * intermediate point.
 2557:  *
 2558:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2559:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2560:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2561:  * remaining time.
 2562:  * 
 2563:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2564:  * 
 2565:  * @param uuint, vvint, wwint: Velocities at the final point
 2566:  * @param jlev: Level at which the backtracking is performed
 2567:  * @param dt, dtbk: Tracking timesteps
 2568:  * @return: True if the backtracking was successful, false otherwise
 2569:  */
 2570: __inline__ __device__ bool Side::btrack(
 2571:       int jlev,
 2572:       double dt,            // Tracking time
 2573:       double dtbk,          // Tracking timestep
 2574:       Vector3 &u_int        // Velocities at the initial point
 2575: ) const {
 2576: 
 2577:    // Start from side center
 2578:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2579: double dt0 = dt; // XXXXX
 2580: Point3 x00 = x0;
 2581: const int oriJlev = jlev;
 2582:  
 2583:    double time_rm = dt; // Remaining time
 2584: 
 2585: 
 2586: 
 2587: 
 2588:    // Initial velocities
 2589:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2590: 
 2591:    // Find the element that is in the direction opposite to the velocity
 2592:    Element* curElem = findElementTowards(toVector2(u_int));
 2593:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2594: 
 2595: 
 2596:    // Nudges it towards the barycenter
 2597:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2598: 
 2599: 
 2600:    const int MAX_ITERATIONS = 1000; 
 2601:    Element* nextElem = nullptr;
 2602:    int iter = 0;
 2603:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2604:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2605:    while(true) {
 2606: 
 2607:       // Calculate timestep
 2608:       double dtb = min(dtbk, time_rm);
 2609: 
 2610:       // Next point in the backtracking curve
 2611:       xt = x0 - dtb*u_int;
 2612: 
 2613:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2614:       assert(found && "Backtracking failed in btrack");
 2615: 
 2616: 
 2617:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2618:                       // then time_rm needs to be increased by the unused time.
 2619: 
 2620:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2621: 
 2622:       // If the velocity is too small, we stop the backtracking
 2623:       const double vmag = length(toVector2(u_int));
 2624:       if (vmag <= velmin_btrack) break;
 2625: 
 2626:       // The current point becomes the next segment's starting point.
 2627:       x0 = xt;
 2628:  
 2629:       curElem = nextElem;
 2630: 
 2631:       iter++;
 2632: 
 2633:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2634:    }
 2635: 
 2636:    assert(!curElem->isDry && "Final element is dry");
 2637:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element");
 2638: 
 2639:    // Interpolate the velocities at the final point
 2640:    curElem->interpolateVelocities(xt, u_int);
 2641: 
 2642: 
 2643: }
 2644: 
 2645: 
