 2741: //       xIntersect=-1.e25;
 2742: //       yIntersect=-1.e25;
 2743: 
 2744: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2745: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2746: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2747: 
 2748: //       if (delta != 0.0) {
 2749: //          // Solves the two linear equations for tt1 and tt2
 2750: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2751: //          const double tt2 = delta2/delta;
 2752: 
 2753: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2754: //          // Similarly, we use tt2 to compute the intersection point.
 2755: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2756: //             xIntersect = x3 + (x4 - x3)*tt2;
 2757: //             yIntersect = y3 + (y4 - y3)*tt2;
