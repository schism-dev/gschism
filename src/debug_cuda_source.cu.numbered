 4261:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4262: 
 4263:       SIDE(side);
 4264: 
 4265: 
 4266:       side->U = {0.0, 0.0}; 
 4267:          
 4268:       if(side->isDry) return;
 4269: 
 4270:       const Node *node1 = side->n1;
 4271:       const Node *node2 = side->n2;
 4272: 
 4273:       // Vertically integrated velocity U (in ll if ics=2)
 4274:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4275:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4276:       }
 4277: 
 4278:    }
 4279: 
 4280:    __global__ void computeBottomDragVegetation(void) {
 4281:       // UNFINISHED. CHECK THIS:
 4282:       // How many kernels are needed? Why so many for loops?
 4283:       // Is the loop on sides needed?
 4284: 
 4285:       NODE(node);
 4286: 
 4287:       const int    kb      = node->kb;
 4288:       const double htot    = node->htot2();
 4289:       const double rough   = node->rough;
 4290: 
 4291: 
 4292:       if (node->isDry) {
 4293:          // Default values for dry nodes
 4294:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4295:          /// XXX CHECK INDICES
 4296:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4297:       }
 4298: 
 4299:       // Compute bottom drag Cd
 4300:       //--------------------------------
 4301: 
 4302:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4303:       if constexpr(nchi == 1) {
 4304: 
 4305:          bool ltmp = false; // for WBL iteration
 4306: 
 4307:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4308:          // Drag at nodes
 4309:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4310:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4311:         
 4312:          const double rough = node->rough;
 4313:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4314:          if (node->rough == 0.0) {
 4315:             node->Cd = 0.0;
 4316: 
 4317:          } else { //roughness >0 
 4318:             
 4319:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4320:             const double bthick = max(dzb_min, bthick_ori);
 4321: 
 4322:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4323: 
 4324:             double tmp = 1.0/(2.5*log(bthick/rough));
 4325:             node->Cd = tmp*tmp;
 4326: 
 4327:          } // if rough
 4328: 
 4329: 
 4330:          // RECOVER THIS: XXX
 4331:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4332:          // Output warning for WBL if iteration didn't converge
 4333: 
 4334: 
 4335:       } // nchi==1
 4336: 
 4337:       //   Bottom stress in m^2/s^2
 4338:       if (node->rho[kb + 1] >= -98.0)
 4339:       {
 4340:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4341:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4342: 
 4343:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4344:          // !sediment erosion: this part needs more documentation
 4345:       }
 4346: 
 4347:     
 4348:       // Compute vegetation parameters
 4349:       //--------------------------------
 4350: 
 4351:       // SAV constants
 4352:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4353:       constexpr double veg_cfpsi = 0.16;
 4354: 
 4355:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4356:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4357: 
 4358:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4359:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4360:          int kbin = 0; // bin index
 4361:          for (int k = kb; k < nvrt; k++) {
 4362:             // Computes node height above the bottom level
 4363:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4364:             assert(false && "Vertical variation of vegetation not implemented");
 4365: 
 4366:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4367:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4368:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4369:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4370:             // } else {
 4371:             //    // Find the bin at which the current vertical level is
 4372:             //    while (kbin<nbins_veg_vert) {
 4373:             //       const double zn = node->z[kbin];
 4374:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4375:             //          break;
 4376:             //       } // if
 4377:             //       kbin++;
 4378:             //    } // while
 4379:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4380: 
 4381:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4382:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4383:                
 4384:             //    // Linear interpolation of the vegetation parameters
 4385:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4386:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4387:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4388:             // } // if rl10
 4389: 
 4390:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4391: 
 4392:          } // for k
 4393: 
 4394: 
 4395:       } else { // Ganthy (iveg=2)
 4396:       //  Modify canopy height, diameter, and density
 4397: 
 4398:          // Make sure there is vegetation on this node
 4399:          if (node->veg_h_unbent > 0.0) {
 4400:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4401: 
 4402:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4403:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4404:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4405: 
 4406:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4407:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4408:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4409:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4410:          } // if veg_h_unbent
 4411: 
 4412:          for (int k = 0; k < nvrt; k++) {
 4413:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4414:          } // for k
 4415:       
 4416: 
 4417:       } // if iveg
 4418:      
 4419:          
 4420: 
 4421:       // Compute vertical mean of veg_alpha3D
 4422:       if (iveg != 0) {
 4423:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4424:          double sum1=0.0;
 4425:          double sum2=0.0;
 4426:          // Integrate over each level under the canopy...
 4427:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4428:             const double Dz = node->Dz(k);
 4429: 
 4430:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4431:             sum2 += Dz;
 4432: 
 4433:          } // for k
 4434: 
 4435:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4436:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4437: 
 4438:       } // if iveg
 4439: 
 4440:    }
 4441: 
 4442:    __global__ void computeVegetationAndDragParameters(void) {
 4443:       // Computes the vegetation and drag model parameters:
 4444:       // chi, \tilde\chi, beta, \breve{H}
 4445:       
 4446:       SIDE(side);
 4447: 
 4448:       const double htot = side->htot2();
 4449:       const int    kb   = side->kb;
 4450: 
 4451:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4452: 
 4453:       const double veg_h     = side->veg_h();
 4454:       const double veg_nv    = side->veg_nv();
 4455:       const double veg_c     = side->veg_c();
 4456:       const double veg_beta  = side->veg_beta;
 4457:       const double veg_alpha = side->veg_alpha_vert_mean();
 4458: 
 4459:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4460:       // Velocity magnitude at the bottom level
 4461:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4462:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4463:       side->chi2 = side->Cd()*vmag1;
 4464:       side->chi  = side->chi2;
 4465:       if constexpr(iveg != 0) {
 4466:          const Node *n1 = side->n1;
 4467:          const Node *n2 = side->n2;
 4468:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4469:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4470:       }
 4471: 
 4472:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4473: 
 4474:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4475:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4476:       double magUa = 0.0;
 4477:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4478:          // 3D wet side with veg...
 4479: 
 4480:          double magUa = 0.0;
 4481:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4482:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4483: 
 4484:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4485:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4486:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4487: 
 4488:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4489:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4490: 
 4491:                // Velocity magnitude at the bottom (l) of the level
 4492:                const double ul = length(side->u2[k]);
 4493: 
 4494:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4495:                magUa += Dz*0.5*(uh + ul);
 4496: 
 4497:             } // if HasVegetation
 4498:          } // for k
 4499:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4500: 
 4501:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4502:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4503:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4504:             const double zCpy = side->zTopCanopy();
 4505:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4506:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4507:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4508:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4509:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4510:          } // if isSubmerged
 4511:       } // if iveg   
 4512: 
 4513:       // Computes the friction modified depth, \breve{H} in notes
 4514:       if (side->is2D()) { // 2D
 4515: 
 4516:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4517:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4518: 
 4519:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4520: 
 4521:          side->hhat = htot*htot/fricH; 
 4522: 
 4523:       } else { // 3D
 4524:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4525: 
 4526:          if constexpr(iveg != 0) {
 4527:             
 4528:             if (side->isSubmerged()) { 
 4529:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4530:                side->hhat -= veg_c*Hhat_alpha;
 4531: 
 4532:             } else { // Emergent
 4533:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4534:             }
 4535:          } // if iveg
 4536: 
 4537:          // Enforce positivity for 3D model
 4538:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4539:       } // if 3D
 4540: 
 4541:    }
 4542: 
 4543: 
 4544: 
 4545:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4546:    // Computes the density gradient between two elements, e1 and e2.
 4547:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4548:    // zero in the direction normal to the side. 
 4549:    // 
 4550:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4551:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4552:    //
 4553:    // Input:
 4554:    //    e1: Element
 4555:    //    e2: Neighbor element (or nullptr if boundary)
 4556:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4557:    //    k: Index of the half-level at which the density is interpolated
 4558:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4559:    // 
 4560:    // Output:
 4561:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4562:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4563: 
 4564:       if (e2 == nullptr || e2->isDry) {
 4565:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4566: 
 4567:          Side *side = e1->sides[j];
 4568:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4569:                  
 4570:          if constexpr(ics == 1) {
 4571:             vec = side->n; // Normal vector to the side
 4572:          } else {
 4573:             // IMPLEMENT THIS XXXXXX
 4574:             // !replace with xel, yel?
 4575:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4576:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4577:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4578:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4579:          } //ics
 4580:                    
 4581:          diffRho = 0.0;
 4582: 
 4583:       } else { //internal and wet
 4584:          if constexpr(ics==1) {
 4585:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4586: 
 4587:             // Vector from e1 to e2
 4588:             vec = toVector2(e2->center - e1->center);
 4589: 
 4590:          } else { 
 4591:             // IMPLEMENT THIS XXXXXX
 4592:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4593:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4594:             //                   alow(j)=xctr2
 4595:             //                   bdia(j)=yctr2
 4596:          } // ics
 4597: 
 4598:          diffRho = rho2 - e1->demeanedDensity(k);
 4599:       }
 4600: 
 4601:    }
 4602: 
 4603:    __global__ void computeDensityCubicSplines(void) {
 4604:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4605: 
 4606:       ELEM(elem);
 4607: 
 4608:       if (elem->isDry) return;
 4609: 
 4610:       const int kb = elem->kb;
 4611: 
 4612:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4613:       if (elem->is2D()) {
 4614:          // In the 2D case, the density is constant at the prism level. 
 4615:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4616:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4617:       } else { //3D
 4618: 
 4619:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4620:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4621:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4622:          ///// XXXX CHECK INDICES!!!!!
 4623:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4624:       } // 2D/3D
 4625: 
 4626:    }
 4627: } // extern "C"
 4628: 
 4629: 
 4630: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4631: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4632: 
 4633:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4634: 
 4635:    const int kb  = elem->kb;
 4636:    const int kb2 = elem2->kb;
 4637: 
 4638:    // z-coordinate of prism of elem
 4639:    const double zp = elem->z_prism(k);
 4640: 
 4641:    double rho = 0.0;
 4642: 
 4643:    if (elem2->is2D()) {
 4644:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4645: 
 4646:    } else {  // 3D
 4647: 
 4648:       // eta_min may be < zmax
 4649:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4650:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4651: 
 4652:       // (Extrapolate density below bottom, we will fix it later)
 4653:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4654:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4655:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4656:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4657:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4658:    } // 2D/3D
 4659:      
 4660: 
 4661:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4662:    // Now we need to fix it.
 4663:    if (elem->z[k] < elem2->z[kb2]) {
 4664:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4665: 
 4666:       // There are two methods to adjust the density at the bottom of the element.
 4667:       // iunder_deep=0: 
 4668:       const double depth1 = abs(elem->z[kb]); // larger depth
 4669: 
 4670:       if (iunder_deep==0) {
 4671: 
 4672:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4673: 
 4674:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4675: 
 4676:       } else { // iunder_deep != 0
 4677: 
 4678:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4679: 
 4680:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4681: 
 4682:          //   Demeaned density at the same z coordinate as
 4683:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4684:          }
 4685: 
 4686:       } // if iunder_deep
 4687:    } // if elem->z[kb] < elem2->z[kb]
 4688: 
 4689:    return rho;
 4690: }
 4691: 
 4692: 
 4693: extern "C" {
 4694:    __global__ void computeDensityGradient(void) {
 4695: 
 4696:          // Compute the horizontal density gradient at each element.
 4697:       // It works in two steps:
 4698:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4699:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4700:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4701:       //             gradRho.r1 = rho1 - rho0
 4702:       //             gradRho.r2 = rho2 - rho0
 4703:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4704:       // 
 4705:       //  NOTE: We use de-meaned densities.
 4706: 
 4707:       ELEM(elem);
 4708: 
 4709:       if (elem->isDry) return;
 4710: 
 4711:       const int kb  = elem->kb;
 4712:       const int i34 = elem->i34;
 4713: 
 4714:       for (int k = kb + 1; k < nvrt; k++) {
 4715:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4716:          //             gradRho.r1 = rho1 - rho0
 4717:          //             gradRho.r2 = rho2 - rho0
 4718:          int icount = 0;
 4719:          double sumRx = 0.0;
 4720:          double sumRy = 0.0;
 4721:          for (int j1=0; j1<i34; j1++) { 
 4722: 
 4723:             const int j2 = elem->nxq(j1 + 1);
 4724: 
 4725:             // Pairs of consecutive neighbor elements of elem
 4726:             const Element *e1 = elem->nghbElems[j1];
 4727:             const Element *e2 = elem->nghbElems[j2];
 4728: 
 4729:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4730:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4731:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4732: 
 4733:             // Compute the density difference and the vector from elem to e1 and e2
 4734:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4735:             double diffRho1, diffRho2;
 4736:             Vector2 vec1, vec2;
 4737:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4738:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4739: 
 4740:             const double rl1 = length(vec1);
 4741:             const double rl2 = length(vec2);
 4742:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4743: 
 4744:             const double delta = cross(vec1, vec2);
 4745:             const double sintheta = abs(delta)/(rl1*rl2);
 4746: 
 4747:             // To avoid problems, avoid elements with small angle between vectors
 4748:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4749:             const bool validEq = (sintheta > sin_one_deg);
 4750: 
 4751:             if (validEq) {
 4752:                // Solve the system of equations to get the density gradient at elem
 4753:                icount++;
 4754:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4755:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4756:                sumRx += Rx;
 4757:                sumRy += Ry;
 4758:             }
 4759:          } // for j1
 4760: 
 4761:          // Compute the average density gradient at elem
 4762:          if (icount==0) {
 4763:            // Bad mesh quality; bail out with 0 b-cc
 4764:            elem->gradRho[k] = {0.0, 0.0};
 4765:          } else {
 4766:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4767:          }
 4768: 
 4769:       } // for k
 4770: 
 4771:    }
 4772: 
 4773:    __global__ void computeBaroclinicTerm(void) {
 4774:    // Computes the baroclinic term at sides (at half levels).
 4775:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4776:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4777: 
 4778:       SIDE(side);
 4779: 
 4780:       if (side->isDry) return;
 4781: 
 4782:       const Element *e1 = side->elems[0];
 4783:       const Element *e2 = side->elems[1];      
 4784:       const int kb = side->kb;
 4785:       
 4786:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4787: 
 4788:       // interpolates vertically the density gradient of the two elements at the half level/
 4789: 
 4790:       // Starts the integration at the surface and goes down to the bottom
 4791:       int k1 = nvrt - 1;
 4792:       int k2 = nvrt - 1;
 4793: 
 4794:       side->bcc[nvrt-1] = {0.0, 0.0};
 4795:       for (int k = nvrt-2; k >= kb; k--) {
 4796:       // For each prism level (from surface to bottom)...
 4797: 
 4798:          // For both elements, interpolate density gradient at the side's half level.
 4799:          // The gradient at the side is the average of the gradients at the elements.
 4800:          // w1, w2 are used to take into account boundary sides, with just one element.
 4801:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4802:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4803:          const double wsum = w1 + w2;
 4804:          w1 = w1/wsum;
 4805:          w2 = w2/wsum;
 4806:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4807: 
 4808:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4809:          Vector2 gradRho = {0.0, 0.0};
 4810:          if (e1 != nullptr && k > kb) {
 4811:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4812:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4813:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4814:             
 4815:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4816:          }      
 4817:          if (e2 != nullptr && k > kb) {
 4818:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4819:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4820:             
 4821:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4822:          }
 4823: 
 4824:          if constexpr(ics==2) {
 4825:             // IMPLEMENT THIS XXXXXX
 4826:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4827:             // swild(1)=tmp1
 4828:             // swild(2)=tmp2
 4829:          }
 4830:          
 4831:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4832:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4833:          // CHECK INDICES!!! XXX
 4834:          const double grav3 = side->grav3();
 4835:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4836: 
 4837:       } // for
 4838: 
 4839:    }
 4840: 
 4841: 
 4842: 
 4843:    __global__ void computeHorGradientAtSide(void) {
 4844: 
 4845:       // Compute the horizontal density gradient at each element.
 4846:       // It works in two steps:
 4847:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4848:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4849:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4850:       //             gradRho.r1 = rho1 - rho0
 4851:       //             gradRho.r2 = rho2 - rho0
 4852:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4853:       // 
 4854:       //  NOTE: We use de-meaned densities.
 4855: 
 4856:       SIDE(side);
 4857: 
 4858: // printf("side->isDry: %d\n", side->isDry);
 4859:       if (side->isDry) return;
 4860: 
 4861:       // Computes the gradient of the variables at the side center.
 4862:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4863:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4864:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4865: 
 4866:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4867:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4868:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4869:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4870: // printf("gradEta1: %.15f, %.15f\n", side->gradEta1.x, side->gradEta1.y);
 4871: // printf("gradEta2: %.15f, %.15f\n", side->gradEta2.x, side->gradEta2.y);
 4872: // printf("gradETP: %.15f, %.15f\n", side->gradETP.x, side->gradETP.y);
 4873: // printf("gradPr: %.15f, %.15f\n", side->gradPr.x, side->gradPr.y);
 4874: 
 4875: 
 4876:    }
 4877: 
 4878: 
 4879:    __global__ void solveMomentumEquations(double time) {
 4880: 
 4881:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4882:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4883: 
 4884:       SIDE(side);
 4885: 
 4886: if (side->idx == 285) printf("XXXXXXXXX solveMomentumEquations: side idx = %d, isDry = %d\n", side->idx, side->isDry);      
 4887: 
 4888:       if (side->isDry) 
 4889:       {
 4890:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4891: 
 4892:          return;
 4893:       }
 4894: 
 4895:       const Node *n1 = side->n1;
 4896:       const Node *n2 = side->n2;
 4897: 
 4898:       const int kb = side->kb;
 4899: 
 4900:       const double veg_h = side->veg_h();
 4901:       const double grav3 = side->grav3();
 4902: 
 4903:       if (side->is2D()) {
 4904:          // Warning: Do not use htot2, which is updated.
 4905:          const double htot = side->htot1();
 4906:          const double hhat = side->hhat;
 4907: 
 4908:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4909: 
 4910:          Vector2 tau2 = {0.0, 0.0};
 4911:           
 4912:          if constexpr(ics==1) {
 4913:             tau2 = side->tau();
 4914: 
 4915:          } else {
 4916:             assert(false && "Not implemented: ics == 2");
 4917:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4918:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4919:             // taux2=(vn1+tt1)*0.5d0
 4920:             // tauy2=(vn2+ss1)*0.5d0
 4921:          } // if ics         
 4922: 
 4923:          // hat_gam has units of m/s
 4924: 
 4925:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4926: 
 4927:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4928:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4929: 
 4930:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4931: 
 4932:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4933:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4934: 
 4935:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4936: 
 4937: 
 4938:       }
 4939:       else { // 3D
 4940: 
 4941:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4942:          // 
 4943:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4944:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4945:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4946:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4947:          // k+1 and k.
 4948: 
 4949: 
 4950:          // // Define layer thickness & viscosity
 4951:          // for (int k=kb + 1; k<nvrt; k++) {
 4952:          //    const double dzz = side->Dz(k - 1);
 4953: 
 4954:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4955: 
 4956:          //    // Vertical viscosity at the face center
 4957:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4958:         
 4959:          // }
 4960: 
 4961: 
 4962:          const int ndim = nvrt - kb;
 4963:          const double zTopCanopy = side->zTopCanopy();
 4964: 
 4965:          // Initialize the tridiagonal system
 4966:          for (int k = kb + 1; k<nvrt; k++) {
 4967:             
 4968:             const int kin = k - kb;
 4969: 
 4970:             // Vertical viscosity at the face center
 4971:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4972:             const double dzz = side->Dz(k);
 4973: 
 4974:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4975: 
 4976:             alow[kin] = 0.0;
 4977:             cupp[kin] = 0.0;
 4978:             bdia[kin] = 0.0;
 4979: 
 4980:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4981:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4982: 
 4983:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4984:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4985:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4986: 
 4987:             // First part: layers k, k+1
 4988:             if (k < nvrt - 1) {
 4989:                              
 4990:                if constexpr(iveg != 0) {
 4991: 
 4992:                   // If there is vegetation at this level...
 4993:                   if (zTopCanopy > side->zc[k]) {
 4994:                      // If the canopy is above the k layer...
 4995:                      
 4996:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4997:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4998:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4999:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5000: 
 5001:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5002:                      const double vmag2 = length(ut2);
 5003:                      const double vmag1 = length(side->u2[k]);
 5004:                      const double vmag = 0.5*(vmag1 + vmag2);
 5005:                      
 5006:                      // Computes the vegetation alpha at the face center
 5007:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5008: 
 5009:                      cff1 += veg_alpha_sd*dt*vmag;
 5010: 
 5011:                   } // if (zTopCanopy
 5012:                } // if iveg
 5013: 
 5014:                const double tmp = dt*dfz/dzz;
 5015:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5016:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5017:             }
 5018: 
 5019: 
 5020:             // Second part: layers k-1, k
 5021:             if (k > kb + 1) {
 5022: 
 5023:                double cff1 = 1.0; //init \bar{c^k}
 5024: 
 5025:                if constexpr(iveg != 0) {
 5026:                   // If there is vegetation at this level...
 5027:                   if (zTopCanopy > side->zc[k-1]) {
 5028:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5029:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5030: 
 5031:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5032: 
 5033:                      const double vmag2 = length(ut2);
 5034:                      const double vmag1 = length(side->u2[k-1]);
 5035:                      const double vmag = 0.5*(vmag1 + vmag2);
 5036: 
 5037:                      // Computes the vegetation alpha at the face center
 5038:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5039:                      cff1 += veg_alpha_sd*dt*vmag;
 5040:                   } // if zTopCanopy
 5041: 
 5042:                } // if iveg
 5043: 
 5044:                const double tmp = dt*dfz/dzz;
 5045:                alow[kin] += cff1*dzz/6.0 - tmp;
 5046:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5047: 
 5048:             } else { // Bottom boundary
 5049:                // This occurs at the bottom, where the bottom drag is applied.
 5050: 
 5051:                bdia[kin] += dt*side->chi2;
 5052: 
 5053:             } // if (k > kb + 1)
 5054: 
 5055: 
 5056: 
 5057:          } // for (int k
 5058: 
 5059: 
 5060: 
 5061:          // Computes the RHS.
 5062:          // -----------------
 5063: 
 5064:          //	BC to be imposed at the end.
 5065: 
 5066:          const Vector2 gradETP  = side->gradETP;
 5067:          const Vector2 gradPr   = side->gradPr;
 5068:          const Vector2 gradEta1 = side->gradEta1;
 5069:          const Vector2 gradEta2 = side->gradEta2;
 5070: 
 5071:          const Vector2 *btu = side->btu;
 5072:          const Vector2 *u2  = side->u2;
 5073:          const double coriolis = side->coriolis;
 5074:          const Vector2 *nuGradU = side->nuGradU;
 5075: 
 5076: 
 5077:          for (int k = kb + 1; k<nvrt; k++) {
 5078:             const int kin = k - kb;
 5079: 
 5080:             const double dz_0 = side->Dz(k);
 5081:             const double dz_1 = side->Dz(k+1);  
 5082: 
 5083:             rrhs[kin] = {0.0, 0.0};
 5084:             double dz = 0.0;
 5085: 
 5086:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5087:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5088:             if (k < nvrt  ) dz += 0.5*dz_1;
 5089:             if (k > kb + 1) dz += 0.5*dz_0;
 5090: 
 5091:             // Elevation gradient, atmospheric pressure and tidal potential
 5092:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5093: 
 5094:             // Coriolis, advection, wind stress, and horizontal viscosity
 5095:             if (k < nvrt - 1) {
 5096: 
 5097: 
 5098:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5099:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5100:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5101: 
 5102:                //diff stress tensors 1006
 5103:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5104:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5105:                   assert(false && "Not implemented: itur == 5");
 5106:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5107:                }
 5108: 
 5109:             } else { // k=nvrt
 5110:                Vector2 tau2 = {0.0, 0.0};
 5111:                if constexpr(ics==1) {
 5112:                   tau2 = side->tau();
 5113:                } else {
 5114:                   assert(false && "Not implemented: ics == 2");
 5115:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5116:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5117:                   // taux2=(vn1+tt1)*0.5d0
 5118:                   // tauy2=(vn2+ss1)*0.5d0
 5119:                } // if ics
 5120: 
 5121:                rrhs[kin] += dt*tau2;
 5122: 
 5123:             } // if k<nvrt
 5124: 
 5125:             if (k > kb + 1) {
 5126:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5127:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5128:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5129: 
 5130: 
 5131:                // diff stress tensors 1006
 5132:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5133:                   assert(false && "Not implemented: itur == 5");
 5134:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5135:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5136:                }
 5137: 
 5138:             } // if k>kbs + 1
 5139: 
 5140:             // Baroclinic
 5141:             Vector2 *bcc = side->bcc;
 5142:             if constexpr(ibc == 0) {
 5143:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5144:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5145: 
 5146:             } // if ibc==0
 5147: 
 5148: 
 5149:          } // k=kb + 1,nvrt
 5150: 
 5151:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5152:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5153: 
 5154: 
 5155:          for (int k=kb + 1; k<nvrt; k++) {
 5156:             const int kin = k - kb;
 5157: 
 5158:             // Velocity is always clamped to maximum values
 5159:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5160:          } // k
 5161: 
 5162:       } // if side->is2D()
 5163:       
 5164: 
 5165:       // Impose velocity boundary condition at the bottom
 5166:       if constexpr(imm == 2) { // 3D bed deformation model
 5167:          double dep;
 5168:          Vector2 vel;
 5169: 
 5170:          assert(false && "Not implemented: imm == 2");
 5171:          //update_bdef(time, x0, y0, dep, vel);
 5172:          // side->u2[kb] = vel;
 5173: 
 5174:       } else { // imm = 0 or 1
 5175:          if (side->Cd() == 0.0) {
 5176:             side->u2[kb] = side->u2[kb + 1];
 5177:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom   XXXXX use is3D()?
 5178: printf("XXXXXXXXX computeFlowBcVelocities: 3D no slip bottom, side idx = %d\n", side->idx);
 5179:             side->u2[kb] = {0.0, 0.0};
 5180:          }
 5181:           
 5182:       } // if imm
 5183: 
 5184:       // The velocities below the bottom level are set to zero
 5185:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5186: 
 5187: 
 5188:    }
 5189: 
 5190: 
 5191:    __global__ void applyMomentumBC(void) {
 5192: 
 5193:       SIDE_BND(sideBnd);
 5194: 
 5195:       Side *side = sideBnd->side;
 5196:       const BoundarySegment *segment = sideBnd->segment;
 5197:       const Node *n1 = side->n1;
 5198:       const Node *n2 = side->n2;
 5199: 
 5200:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5201: 
 5202:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5203:       const bool isLand = segment->isLand;
 5204:       const int ifltype = segment->ifltype;
 5205: 
 5206:       const int kb = side->kb;
 5207: 
 5208:       if (!isLand && ifltype != 0) {
 5209:          const Vector2 *ubc = sideBnd->ubc;
 5210:   
 5211:          for (int k=kb; k < nvrt; k++) {
 5212:             
 5213:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5214:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5215: 
 5216:             if (ifltype == -1) {
 5217:                // Flather 1
 5218: 
 5219:                const double depth = side->depth();
 5220: 
 5221:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5222: 
 5223:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5224: 
 5225:                side->u2[k] = vnorm*side->n;
 5226: 
 5227:             } else if (ifltype == -2) { // Discharge
 5228: 
 5229:                const double eta1 = side->eta1();
 5230:                const double eta2 = side->eta2();
 5231:                const double htot = side->htot2();
 5232: 
 5233:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5234:                assert(false && "Not implemented: Discharge bc");
 5235:                // const double dischrg = discharge(eta1);
 5236:                const double dischrg = 0.0; // XXX REMOVE
 5237:                
 5238: 
 5239:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5240: 
 5241:                const double vnorm = dischrg*eta2/htot;
 5242: 
 5243:                side->u2[k] = vnorm*side->n;
 5244: 
 5245: 
 5246:             }
 5247:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5248:                const double vnorm = dot(side->u2[k], side->n);
 5249: 
 5250:                double rat;
 5251:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5252:                else              rat = segment->vobc2; // outgoing
 5253: 
 5254:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5255:             }
 5256:             else { // not Flather or 3D radiation
 5257:                side->u2[k] = ubc[k];
 5258: 
 5259:             } // if (segment->ifltype...
 5260: 
 5261:          }
 5262: 
 5263:       }
 5264:       else if (isLand) { // if it is land boundary side
 5265: 
 5266:          if constexpr(islip == 0) { // free slip
 5267: 
 5268:             for (int k=kb; k < nvrt; k++) {
 5269: 
 5270:                const Vector2 t = side->t();
 5271:                const Vector2 n = side->n;
 5272: 
 5273:                double vnorm = 0.0; // for most cases
 5274:                const double vtan = dot(side->u2[k], t);
 5275:                
 5276:                side->u2[k] = vtan*t - vnorm*n;
 5277: 
 5278:             }
 5279: 
 5280:          } else { // no slip
 5281:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5282: 
 5283:          }
 5284:       } // if (side segment type...
 5285: 
 5286:    
 5287: 
 5288:    }
 5289: 
 5290: 
 5291:    __global__ void shapiroFilter1(void) {
 5292:       // First step of the Shapiro filter (normally used if indvel<=0)
 5293:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5294: 
 5295:       SIDE(side);
 5296: 
 5297:       // Only internal wet sides are processed
 5298:       if (side->isDry || !(side->isInternal())) return;
 5299: 
 5300:       const int kb = side->kb;
 5301: 
 5302:       for (int mm = 1; mm <= niter_shap; mm++) {
 5303: 
 5304:          for (int k = kb + 1; k < nvrt; k++) {
 5305:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5306:             side->bcc[k] = {0.0, 0.0};
 5307:             Vector2 suru = {0.0, 0.0};
 5308: 
 5309:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5310: 
 5311:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5312: 
 5313:                int kin = k;
 5314:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5315:                
 5316:                if constexpr(ics==1) {
 5317:                   suru += nSide->u2[kin];
 5318: 
 5319:                } else {
 5320:                   assert(false && "Not implemented: ics == 2");
 5321:                   // Vector2 vn1, vn2;
 5322:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5323:                   // suru=suru+vn1;
 5324:                   // surv=surv+vn2;
 5325:                }
 5326:             }
 5327: 
 5328: 
 5329:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5330: 
 5331:          }
 5332:       }
 5333:    }
 5334: 
 5335:    __global__ void shapiroFilter2(void) {
 5336:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5337: 
 5338:       SIDE(side);
 5339: 
 5340: // side->u2[1] = {10.0,-10.0}; 
 5341: // side->u2[0] = {10.0,-10.0};
 5342: // return;      
 5343: 
 5344:       if (side->isDry || !(side->isInternal())) return;
 5345: 
 5346:       const int kb = side->kb;
 5347: 
 5348:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5349: 
 5350:       if (side->is2D()) {
 5351:          // side->u2[kb] = side->u2[nvrt - 1];
 5352:          side->u2[kb + 1] = side->bcc[kb + 1];
 5353:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5354: 
 5355:       } else {
 5356:          // 3D
 5357:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5358:          
 5359:       }
 5360: 
 5361:    }
 5362: 
 5363: 
 5364:    __global__ void ul0UpdateZCoords(void) {
 5365:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5366:       
 5367:       NODE(node);      
 5368: 
 5369:       if (node->isDry2()) { 
 5370: 
 5371:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5372: 
 5373:          if constexpr(ivcor != 1) node->kb = 0;
 5374: 
 5375:       } else {
 5376: 
 5377:          node->updateKb();
 5378:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5379: 
 5380:       }
 5381: 
 5382:       // We use the temp.b field to store the previous state of isDry.
 5383:       node->tmp.b = node->isDry;
 5384: 
 5385:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5386:       node->isDry = true;
 5387: 
 5388:    }
 5389: 
 5390:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5391:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5392:    {
 5393:       ELEM(elem);
 5394: 
 5395:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5396: 
 5397:       // All the nodes of a wet element are wet.
 5398:       if (!elem->isDry) {
 5399:          elem->nodes[0]->isDry = false;
 5400:          elem->nodes[1]->isDry = false;
 5401:          elem->nodes[2]->isDry = false;
 5402:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5403: 
 5404:       }
 5405: 
 5406: 
 5407:       elem->kb = 0;
 5408: 
 5409:       if (elem->isDry) return;
 5410: 
 5411:       // Wet
 5412:       const Node *n1 = elem->nodes[0];
 5413:       const Node *n2 = elem->nodes[1];
 5414:       const Node *n3 = elem->nodes[2];  
 5415:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5416: 
 5417:    //    if(elem->isDry2()) {
 5418:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5419:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5420:    //        call parallel_abort(errmsg)
 5421:    //    }
 5422: 
 5423: 
 5424:       // Computes element's kb as the minimum of the nodes' kb.
 5425:       const int kb1 = n1->kb;
 5426:       const int kb2 = n2->kb;
 5427:       const int kb3 = n3->kb;
 5428:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5429: 
 5430: 
 5431:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5432: 
 5433: 
 5434:       // Computes the element z as the mean of the nodes z.
 5435:       for (int k = elem->kb; k < nvrt; k++) {
 5436: 
 5437:          // Compute the element z as the mean of the nodes z.
 5438:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5439:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5440:          elem->z[k] /= elem->i34;
 5441: 
 5442:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5443:       }
 5444:                   
 5445:    }
 5446: 
 5447:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5448:    {
 5449:       NODE(node);
 5450:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5451: 
 5452:       if (it == iths) return;
 5453: 
 5454: 
 5455:       if(!node->isDry && node->tmp.b) { // rewetted
 5456:          for (int k=0; k < nvrt; k++) {
 5457: 
 5458:             Vector3 utmp={0.0, 0.0, 0.0};
 5459: 
 5460:             double ttmp=0.0;
 5461:             double stmp=0.0;
 5462:             int icount=0;
 5463:             for (int j = 0; j < node->numNodes; j++) {
 5464: 
 5465: 
 5466:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5467:                if (!node->isDry) { // all indices extended
 5468:                   icount++;
 5469: 
 5470:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5471:                   utmp += node->u2[k];
 5472:                   
 5473:                   ttmp += node->tracers[k].tracer[0]; 
 5474:                   stmp += node->tracers[k].tracer[1]; 
 5475:                }
 5476:             }
 5477: 
 5478:             if(icount > 0) {
 5479:                const double inv_icount = 1.0/icount;
 5480:                node->u2[k]     = inv_icount*utmp;
 5481:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5482:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5483:             }
 5484:          }
 5485:       }
 5486:    }
 5487: 
 5488: 
 5489:    __global__ void ul0UpdateSides(int it, int iths) {
 5490: 
 5491:       SIDE(side);
 5492: 
 5493:       // A side is wet if and only if at least one of its elements is wet.
 5494:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5495: 
 5496:       const Node *n1 = side->n1;
 5497:       const Node *n2 = side->n2;
 5498:       const int kb1 = n1->kb;
 5499:       const int kb2 = n2->kb;
 5500: 
 5501:       side->kb = 0; // dry
 5502: 
 5503:       if (isWet) {
 5504: 
 5505:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5506: 
 5507:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5508: 
 5509:          side->kb = min(kb1, kb2);
 5510: 
 5511:          for (int k = side->kb; k < nvrt; k++) {
 5512:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5513: 
 5514:          
 5515:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5516: 
 5517:             // Compute velocity for re-wetted sides 
 5518:             if ((it != iths) && (side->isDry && isWet)) {
 5519:             
 5520:                Vector2 utmp={0.0, 0.0};
 5521: 
 5522:                int icount=0;
 5523: 
 5524:                // For all the sides on the two elements that share this side
 5525:                for (int j=0; j < 2; j++) {
 5526:                   const Element *elem = side->elems[j];
 5527:                   if (elem == nullptr) continue;
 5528: 
 5529:                   for (int jj=0; jj < elem->i34; jj++) {
 5530:                      const Side *nSide = elem->sides[jj];
 5531:                      if (nSide->isDry) continue;
 5532: 
 5533:                      icount++;
 5534:                      utmp += nSide->u2[k];                     
 5535:                   }
 5536:                }
 5537:                   
 5538:                assert(icount > 0 && "No wet sides around this side");
 5539:                if (icount > 0)  side->u2[k] = utmp/icount;
 5540:                   
 5541:             } // if ((it != iths) && (side->isDry && isWet))
 5542: 
 5543:          } // for k
 5544: 
 5545:       } // if isWet
 5546:    
 5547:       side->isDry = !isWet;
 5548: 
 5549:    }
 5550: 
 5551: 
 5552:    __global__ void zeroNodalVelocities(void) {
 5553:       NODE(node);
 5554: 
 5555:       for (int k = 0; k < nvrt; k++) {
 5556:          node->u2[k]   = {0.0, 0.0, 0.0};
 5557:          node->utmp[k] = {0.0, 0.0};
 5558:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5559:       }
 5560:    }
 5561: 
 5562:    __global__ void computeNodalVerticalVelocities1(void) {
 5563:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5564:    // Adds the element's vertical velocity times the element's area.
 5565:       ELEM(elem);
 5566: 
 5567:       for (int j = 0; j < elem->i34; j++) {
 5568:          Node *node = elem->nodes[j];
 5569: 
 5570:          for (int k = node->kb; k < nvrt; k++) {
 5571:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5572:          }
 5573:          atomicAdd(&(node->tmp.d), elem->area);
 5574:       }
 5575:    }
 5576: 
 5577:    __global__ void computeNodalVerticalVelocities2(void) {
 5578:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5579:    // Divides by the total area of the elements sharing the    node.
 5580:       NODE(node);
 5581: 
 5582:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5583:    }
 5584: 
 5585: 
 5586:    __global__ void computeNodalHorizontalVelocities1(void) {
 5587:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5588:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5589: 
 5590:       ELEM(elem);
 5591: 
 5592:       const int kb = elem->kb;
 5593:       const bool isTri = elem->isTri();
 5594: 
 5595:       if constexpr(indvel <= 0) {
 5596:          // Assuming discontinoius hvel.
 5597: 
 5598: 
 5599:          if (isTri) { // For triangles
 5600:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated at one node can be
 5601:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5602: 
 5603:             for (int j = 0; j < 3; j++) {
 5604:                // For every node of the triangle...
 5605:                Node *node = elem->nodes[j];
 5606: 
 5607:                const Side *s1 = elem->sides[j];
 5608:                const Side *s2 = elem->sides[(j + 1) % 3];
 5609:                const Side *s3 = elem->sides[(j + 2) % 3];
 5610: 
 5611:                const int numElements = node->numElements;
 5612: 
 5613:                for (int k = kb; k < nvrt; k++)  {
 5614:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k];
 5615:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5616:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5617:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5618:                   atomicAdd(&(node->utmp[k].x), (1.0/numElements) * u.x);
 5619:                   atomicAdd(&(node->utmp[k].y), (1.0/numElements) * u.y);
 5620: 
 5621:                }
 5622: 
 5623:             }
 5624:          }
 5625:          else { // For quads
 5626: 
 5627:          }
 5628: 
 5629:       }
 5630:       
 5631:    }
 5632: 
 5633: 
 5634:    __global__ void computeNodalHorizontalVelocities2(void) {
 5635:       NODE(node);
 5636: 
 5637:       for (int k = 0; k < nvrt; k++) {
 5638:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5639:       }
 5640:       
 5641:    }   
 5642: 
 5643:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5644:    // XXXX I'm not sure where I got this function from. 
 5645:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5646:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5647:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5648:    // It uses the utmp array as a temporary array to store the velocities.
 5649: 
 5650:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5651: 
 5652:       SIDE(side);
 5653: 
 5654:       const int kb = side->kb;
 5655: 
 5656:       Node *n1 = side->n1;
 5657:       Node *n2 = side->n2;
 5658: 
 5659:       for (int k = kb; k < nvrt; k++) {
 5660: 
 5661:          // Cast the u2 vector into a Vector2 
 5662:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5663:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5664: 
 5665:          n1_u2 = side->u2[k]/n1->numSides;
 5666:          n2_u2 = side->u2[k]/n2->numSides;
 5667: 
 5668:       }
 5669: 
 5670: 
 5671:    }
 5672: 
 5673:    __global__ void resetVelocityOpenBndNodes(void) {
 5674:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5675: 
 5676:       NODE_BND(nodebnd);
 5677: 
 5678:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5679:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5680:       }
 5681: 
 5682:    }
 5683: 
 5684: 
 5685:    __global__ void setVelocityOpenBndNodes(void) {
 5686:    // For open boundary nodes sets their velocity to the imposed values.
 5687: 
 5688:       SIDE_BND(sidebnd);
 5689: 
 5690:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5691:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5692:          // to its segment to the average of the side velocity.
 5693: 
 5694:          for (int k = 0; k < nvrt; k++) {
 5695:             Node *n1 = sidebnd->side->n1;
 5696:             Node *n2 = sidebnd->side->n2;
 5697: 
 5698:             // Cast the u2 vector into a Vector2 
 5699:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5700:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5701: 
 5702:             if (n1->nodeBnd->segment == sidebnd->segment) {
 5703:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 5704:             }
 5705:             if (n2->nodeBnd->segment == sidebnd->segment) {
 5706:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 5707:             }
 5708: 
 5709:          }
 5710:       }
 5711: 
 5712:    }
