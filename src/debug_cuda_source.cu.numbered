 6641: __global__ void getStructSizes(int* sizes)  {
 6642:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 6643:       sizes[0] = (int)sizeof(Node);
 6644:       sizes[1] = (int)sizeof(Element);
 6645:       sizes[2] = (int)sizeof(Side);
 6646:       sizes[3] = (int)sizeof(NodeBoundary);
 6647:       sizes[4] = (int)sizeof(SideBoundary);
 6648:       sizes[5] = (int)sizeof(BoundarySegment);
 6649: }
 6650: 
 6651: __global__ void printMatrix(void) {
 6652: 
 6653: 
 6654:    // Let only one thread per block print at a time 
 6655: 
 6656:    if (threadIdx.x == 0) {
 6657:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 6658:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 6659:          if (idx_node >= mesh->np) return;
 6660:          const Node *node = mesh->localNodeData + idx_node;
 6661:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 6662:          for (int j = 0; j < node->numNodes; j++) {
 6663:             Node* nbNode = node->nodes[j];
 6664:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 6665:          }
 6666:          printf("]\n");
 6667: 
 6668:       }
 6669:    }
 6670: 
 6671: 
 6672: 
 6673: }
 6674: 
 6675: 
 6676: __global__ void computeMatrixProductAndDotProducts() {
 6677:    // Computes A*p, r'Mr and p'Ap
 6678: 
 6679:    // 1) shared buffer: first half for rMr, second for pAp
 6680:    __shared__ double sdata[2*BLOCK_SIZE];
 6681:    double* s_rMr = sdata;
 6682:    double* s_pAp = sdata + BLOCK_SIZE;
 6683: 
 6684:    s_rMr[threadIdx.x] = 0.0;
 6685:    s_pAp[threadIdx.x] = 0.0;
 6686: 
 6687:    // 2) get your node pointer
 6688:    NODE(node);  
 6689:    const int tid = threadIdx.x;
 6690: 
 6691:    const double diag = node->coeffDiag;
 6692:    const double r    = node->mR;
 6693:    const double p    = node->mP;  
 6694: 
 6695:    // apply preconditioner on the fly:
 6696:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 6697: 
 6698:    // 4) compute Ap = A.p
 6699:    double Ap = node->coeffDiag * node->mP;
 6700:    for (int j = 0; j < node->numNodes; ++j) {
 6701:       const Node *nbNode = node->nodes[j];
 6702:       Ap += node->coeffMatrix[j] * nbNode->mP;
 6703: 
 6704:    }
 6705:    node->mAp = Ap;
 6706:     
 6707: 
 6708:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 6709:    const double l_rMr = r*Mr;  // r'Mr
 6710:    const double l_pAp = p*Ap;  // p'Ap
 6711: 
 6712:    // 6) write into shared mem
 6713:    s_rMr[tid] = l_rMr;
 6714:    s_pAp[tid] = l_pAp;
 6715: 
 6716:    __syncthreads();
 6717: 
 6718:    // 7) block-wide tree reduction
 6719:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6720:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 6721:       __syncthreads();
 6722:    }
 6723: 
 6724:    // 8) thread 0 atomically accumulates into the globals
 6725:    // XXX: This is slower than it needs to be, but it is simple and works
 6726:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 6727: 
 6728: 
 6729: }
 6730: 
 6731: 
 6732: __global__ void updateSolutionAndDotProducts(void) {
 6733:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 6734: 
 6735:    s_rMr[threadIdx.x] = 0.0;
 6736: 
 6737: 
 6738:    // get node & bounds-check:
 6739:    NODE(node);
 6740:    const int tid = threadIdx.x;
 6741: 
 6742: 
 6743:    // Compute alpha
 6744:    const double alpha = (*rMr_old)/(*pAp);
 6745: 
 6746:    // load scalars
 6747:    const double diag = node->coeffDiag;
 6748:    const double p    = node->mP;
 6749:    const double Ap   = node->mAp;
 6750:    const double x    = node->mX;
 6751:    const double r    = node->mR;
 6752:    
 6753:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 6754: 
 6755:    // 1) update solution & residual
 6756:    const double x_new = x + alpha*p;
 6757:    const double r_new = r - alpha*Ap;
 6758:    node->mX = x_new;
 6759:    node->mR = r_new;
 6760: 
 6761:    // 2) apply Jacobi preconditioner on the fly
 6762:    const double Mr_new = r_new/diag;
 6763: 
 6764: 
 6765:    // 3) local contributions for the two dot-products
 6766:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 6767: 
 6768:    // 4) write into shared-mem
 6769:    s_rMr[tid] = l_rMr;
 6770: 
 6771:    __syncthreads();
 6772: 
 6773: 
 6774:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6775:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6776:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6777:       __syncthreads();
 6778:    }
 6779: 
 6780:    // 6) thread 0 atomically folds into the global accumulators
 6781:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 6782: 
 6783: 
 6784: }
 6785: 
 6786: 
 6787: __global__ void updateSearchDirection() {
 6788:     NODE(node);
 6789: 
 6790:     // recompute z on-the-fly
 6791:     const double z = node->mR / node->coeffDiag;
 6792:     const double p = node->mP;
 6793: 
 6794:     const double beta = (*rMr_new)/(*rMr_old);
 6795: 
 6796: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 6797: 
 6798:     // p =z + beta*p
 6799:     node->mP = z + beta*p;
 6800: 
 6801: }
 6802: 
 6803: __global__ void initializePreconditionedResidual(double *scalars) {
 6804: 
 6805:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 6806: 
 6807:     s_rMr[threadIdx.x] = 0.0;
 6808: 
 6809:     NODE(node);
 6810:     const int tid = threadIdx.x;
 6811:     // For the first iteration:
 6812:     // 1. Initial solution x = 0 (already set)
 6813:     // 2. Initial residual r = b (stored in qel)
 6814:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 6815: 
 6816: // XXX we should use the guess solution here    
 6817: 
 6818:     // Set initial residual r = b (from qel)
 6819:     node->mR = node->qel;
 6820: 
 6821:     // Compute z = M^-1 * r (preconditioned residual)
 6822:     const double z = node->mR / node->coeffDiag;
 6823: 
 6824:     // Set initial search direction p = z
 6825:     node->mP = z;
 6826: 
 6827:     // Initialize other variables needed for CG
 6828:     node->mX = 0.0;  // Initial solution
 6829:     node->mAp = 0.0; // Will be computed in first iteration
 6830: 
 6831:     // These point to a cupy array in the host code
 6832:     rMr_old = scalars + 0;
 6833:     rMr_new = scalars + 1;
 6834:     pAp     = scalars + 2;
 6835: 
 6836:     // Computes the first r'Mr (reduction)
 6837:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 6838: 
 6839:     // 4) write into shared-mem
 6840:     s_rMr[tid] = l_rMr;
 6841: 
 6842:     __syncthreads();
 6843: 
 6844: 
 6845:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6846:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6847:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6848:         __syncthreads();
 6849:     }
 6850: 
 6851:     // 6) thread 0 atomically folds into the global accumulators
 6852:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 6853: 
 6854:     *rMr_old = 0.0;
 6855:     *pAp = 0.0;
 6856: }
