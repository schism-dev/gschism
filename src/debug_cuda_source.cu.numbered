 1396: struct BoundarySegment {
 1397: 
 1398:    bool isLand;
 1399: 
 1400:    int idx; // Index of the boundary segment in the input files.
 1401: 
 1402:    double clen;  // Length of the boundary segment
 1403:    double carea; // Area of the boundary segment
 1404: 
 1405:    int ifltype;  // Type of flow boundary condition
 1406:    
 1407:    // Elevation boundary condition
 1408:    int iettype;  // Type of elevation boundary condition
 1409:    double eth;   // Elevation time history
 1410: 
 1411:    // Flow boundary condition
 1412:    double qthcon;  // Flow time history constant
 1413:    double vobc1;   // Velocity coefficient 1
 1414:    double vobc2;   // Velocity coefficient 2
 1415: 
 1416:    // Tracer boundary conditions
 1417:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1418:    // int  itrtype[natrm];    // Tracer boundary condition type
 1419: 
 1420:    BoundarySegment(bool _isLand) {
 1421:       isLand = _isLand;
 1422:       clen = 0.0;
 1423:       carea = 0.0;
 1424:       ifltype = 0;
 1425:       iettype = 0;
 1426:       eth = 0.0;
 1427:    }
 1428: 
 1429:    BoundarySegment(void) {
 1430:       isLand = false;
 1431:       clen = 0.0; 
 1432:       carea = 0.0;
 1433:       ifltype = 0;
 1434:       iettype = 0;
 1435:       eth = 0.0;
 1436:    }
 1437: 
 1438:    
 1439: };
