 2602: /**
 2603:  * This method performs backtracking from the side center until a time -dt back in time 
 2604:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2605:  * intermediate point.
 2606:  *
 2607:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2608:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2609:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2610:  * remaining time.
 2611:  * 
 2612:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2613:  * 
 2614:  * @param uuint, vvint, wwint: Velocities at the final point
 2615:  * @param jlev: Level at which the backtracking is performed
 2616:  * @param dt, dtbk: Tracking timesteps
 2617:  * @return: True if the backtracking was successful, false otherwise
 2618:  */
 2619: __inline__ __device__ bool Side::btrack(
 2620:       int jlev,
 2621:       double dt,            // Tracking time
 2622:       double dtbk,          // Tracking timestep
 2623:       Vector3 &u_int        // Velocities at the initial point
 2624: ) const {
 2625: 
 2626:    // Start from side center
 2627:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2628: 
 2629:  
 2630:    double time_rm = dt; // Remaining time
 2631: 
 2632: 
 2633:    // // Initialize outputs XXX
 2634:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2635:    //    sclr[i] = 0.0;
 2636:    // }
 2637: 
 2638: 
 2639:    // Initial velocities
 2640:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2641: 
 2642:    // Find the element that is in the direction opposite to the velocity
 2643:    Element* curElem = findElementTowards(toVector2(u_int));
 2644: 
 2645: 
 2646:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2647:    if (curElem == nullptr) {
 2648:       // Make velocity parallel to the side
 2649:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2650:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2651:       curElem = otherElem(curElem);
 2652:       
 2653:    }
 2654: 
 2655: // Nudges it towards the circumcenter
 2656: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2657: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2658:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2659: const double eps = 9.013e-3;                 
 2660: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2661: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2662: 
 2663: 
 2664: 
 2665:    const int MAX_ITERATIONS = 1000; 
 2666:    Element* nextElem = curElem;
 2667:    int iter = 0;
 2668:    while(true) {
 2669: 
 2670:       // Calculate timestep
 2671:       double dtb = min(dtbk, time_rm);
 2672: 
 2673:       // Next point in the backtracking curve
 2674:       Point3 xt = x0 - dtb*u_int;
 2675:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2676:       assert(found && "Backtracking failed in btrack");
 2677: 
 2678:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2679: 
 2680:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2681:                       // then time_rm needs to be increased by the unused time.
 2682: 
 2683:       // If the velocity is too small, we stop the backtracking
 2684:       const double vmag = length(toVector2(u_int));
 2685:       if (vmag <= velmin_btrack) break;
 2686: 
 2687:       // The current point becomes the next segment's starting point.
 2688:       x0 = xt;
 2689:  
 2690:       curElem = nextElem;
 2691: 
 2692:       iter++;
 2693:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2694:    }
 2695: 
 2696: 
 2697: }
 2698: 
