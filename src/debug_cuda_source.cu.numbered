 3743: 
 3744:    __global__ void backtrackAllNodes(void) {
 3745: 
 3746:       // max/min # of sub-divisions
 3747:       const int ndelt_max = max(1.0, dt/dtb_min);
 3748:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3749: 
 3750:       // Removed all references to swild98 XXX
 3751:       // swild98=0.d0 !init
 3752: 
 3753: 
 3754:       SIDE(side);
 3755: 
 3756:       const int kb = side->kb;
 3757: 
 3758: 
 3759:       // Initialize btrack velocities to the actual velocities at the side 
 3760:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3761: 
 3762:   
 3763: 
 3764:       // if (side->isDry) return;
 3765:       
 3766: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3767: 
 3768:       // Checks that at least one element is not dry
 3769:       const Element *elem1 = side->elems[0];
 3770:       const Element *elem2 = side->elems[1];
 3771: 
 3772: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3773: 
 3774:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3775:       
 3776:       // XXXXXX
 3777:       // !swild_tmp to store global coord. of the starting side
 3778:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3779:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3780:       // !Use sframe2 
 3781:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3782: 
 3783: 
 3784:       for (int k = kb; k < nvrt; k++) {
 3785:       //  Initialize (xt,yt,zt), nnel and vel.
 3786:       //  For ics=2, the coordinates are in local frames
 3787:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3788: 
 3789: 
 3790:          const int iadvf = side->iadv();  // Advection flag   
 3791:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3792: 
 3793:          Point3 xt;
 3794:          if constexpr(ics==1) {
 3795:             xt = side->center3D(k); 
 3796:          }
 3797:          else // lat/lon; in side lat/lon frame
 3798:          {
 3799:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3800:          // XXX IMPLEMENT THIS
 3801:       //          xt=0.d0
 3802:       //          yt=0.d0
 3803:       //          !centroid coord. for nudging
 3804:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3805:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3806:          }  // ics
 3807: 
 3808: 
 3809: 
 3810:          // If on land or open boundary...
 3811:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3812:          
 3813:          const double vmag = length(side->u2[k]);
 3814: 
 3815:          if (vmag <= velmin_btrack) {
 3816:             // No activity 
 3817: 
 3818:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3819: // addDebugPlot(side->center, side->center, 0x00000F, '+');            
 3820:             
 3821:          } else {  // do btrack
 3822: 
 3823:             // Compute number of sub-divisions based on local gradients 
 3824:             // XXX IS THIS NECESSARY?
 3825:             double suma = 0.0;
 3826:             int icount = 0;
 3827:             for (int ii=0; ii<2; ii++) {
 3828: 
 3829:                const Element *elem = side->elems[ii];
 3830:                  
 3831:                if (elem == nullptr) continue;
 3832: 
 3833:                icount++;
 3834: 
 3835:                // Not strictly along z; in ll frame for ics=2
 3836: 
 3837:                double utmp[4];
 3838:                double vtmp[4];
 3839:                for (int jj = 0; jj < elem->i34; jj++) {
 3840: 
 3841:                   const Node *node = elem->nodes[jj];
 3842: 
 3843:                   if constexpr(ics==1) {
 3844:                      utmp[jj] = node->u2[k].x;
 3845:                      vtmp[jj] = node->u2[k].y;  
 3846:                   } else {
 3847:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3848:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3849:                   }
 3850:                } // for jj
 3851: 
 3852:                const Vector2 grad_u = elem->grad2(utmp); 
 3853:                const Vector2 grad_v = elem->grad2(vtmp);
 3854: 
 3855:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3856:             } // for ii
 3857: 
 3858:             assert(icount > 0 && "Impossible 77");
 3859: 
 3860:             // '4' is somewhat arbitrary
 3861:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3862: 
 3863:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3864: 
 3865:             Vector3 u_int = {0.0, 0.0, 0.0};
 3866: 
 3867:             side->btrack(k, dt, dtbk, u_int);
 3868: 
 3869:             side->btu[k] = toVector2(u_int);
 3870:                
 3871:          } // if vmag (do backtrack)
 3872: 
 3873:       } // for k=kb,nvrt-1
 3874: 
 3875:    }
 3876: 
 3877: } // extern "C"
 3878: 
 3879: template<int nc>
 3880: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3881: 
 3882: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3883: //
 3884: // a,b,c,rhs: input vectors and are not modified by this program.
 3885: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3886: // rhs is the r.h.s.
 3887: // n: actual rank of the system.
 3888: // rows in u() and rhs();
 3889: // u: output with nc columns (transposed to rows)
 3890: // gam: a working array.
 3891: //
 3892: // NOTES:
 3893: // This is a template function that allows for different numbers of columns in the rhs vector.
 3894: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3895: 
 3896:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3897:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3898: 
 3899:    double bet = b[0];
 3900:    if constexpr (nc == 1) {
 3901:       u[0] = rhs[0]/bet;
 3902:    } else {
 3903:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3904:    }
 3905: 
 3906:    for (int j = 1; j < n; j++) {
 3907:       gam[j] = c[j - 1]/bet;
 3908:       bet = b[j] - a[j]*gam[j];
 3909: 
 3910:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3911: 
 3912:       if constexpr (nc == 1) {
 3913:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3914:       } else {
 3915:          for (int l = 0; l < nc; l++) {
 3916:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3917:          }
 3918:       }
 3919:    }
 3920: 
 3921:    // Back-substitution
 3922:    for (int j = n - 2; j >= 0; j--) {
 3923:       if constexpr (nc == 1) {
 3924:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3925:       } else {
 3926:          for (int l = 0; l < nc; l++) {
 3927:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3928:          }
 3929:       }
 3930:    }
 3931: }
 3932: 
 3933: 
 3934: 
 3935: // Helper function that contains the core algorithm
 3936: template<typename XAccessor, typename YAccessor>
 3937: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3938:                                     double  yp_top, double  yp_bot, 
 3939:                                     CubicSpline &spline) {
 3940:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3941:    // 
 3942:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3943:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3944:    //
 3945:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3946:    // 
 3947:    // Inputs: 
 3948:    //            n: dimension for x etc; # of data pts (>=2);
 3949:    //            getX, getY: functions to access x,y coordinates
 3950:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3951:    //     Output: 
 3952:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3953: 
 3954:    const int n = k2 - k1 + 1;
 3955:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3956: 
 3957:    // Allocate memory for the splines
 3958:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3959:    spline.x   = new double[n];
 3960:    spline.y   = new double[n];
 3961:    spline.yp  = new double[n];
 3962:    spline.ypp = new double[n];
 3963: 
 3964:    for (int k=k1; k<=k2; k++) {
 3965:       spline.x[k] = getX(k);
 3966:       spline.y[k] = getY(k);
 3967:    }
 3968: 
 3969:    // This is to simplify expressions later
 3970:    double *x = spline.x;
 3971:    double *y = spline.y;
 3972: 
 3973:    double *a = nullptr;
 3974:    double *b = nullptr;
 3975:    double *c = nullptr;
 3976:    double *gam = nullptr;
 3977:    double *rhs = nullptr;
 3978:    
 3979: 
 3980:       a = new double[n];   // Lower diagonal
 3981:       b = new double[n];   // Diagonal
 3982:       c = new double[n];   // Upper diagonal
 3983:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3984:       rhs = new double[n]; // Right-hand side
 3985: 
 3986:    for (int k=k1; k<=k2; k++) {
 3987:       if (k == k1) {
 3988:          // Bottom level
 3989:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3990:          b[k] = (x[k+1] - x[k])/3.0;
 3991:          c[k] = b[k]/2.0;
 3992:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3993:       } else if (k == n - 1) {
 3994:          // Top level (surface)
 3995:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3996:          b[k] = (x[k] - x[k-1])/3.0;
 3997:          a[k] = b[k]/2.0;
 3998:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3999:       } else {
 4000:          // Intermediate levels
 4001:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4002:          b[k] = (x[k+1] - x[k-1])/3.0;
 4003:          a[k] = (x[k  ] - x[k-1])/6.0;
 4004:          c[k] = (x[k+1] - x[k  ])/6.0;
 4005:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4006:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4007:       }
 4008:    }
 4009: 
 4010:    // Solve the tridiagonal system
 4011:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4012:    
 4013:    spline.yp[k1] = yp_bot;
 4014:    spline.yp[k2] = yp_top;
 4015: 
 4016:    // Compute rest of 1st derivatives using the splines
 4017:    for (int k=k1+1; k<k2; k++) {
 4018:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4019:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4020:    }
 4021:    
 4022:    delete[] a;
 4023:    delete[] b;
 4024:    delete[] c;
 4025:    delete[] gam;
 4026:    delete[] rhs;
 4027: 
 4028: }
 4029: 
 4030: // Array version
 4031: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4032:                                 double y_top, double y_bot, 
 4033:                                 CubicSpline &spline) {
 4034:    auto getX = [x] (int k) { return x[k]; };
 4035:    auto getY = [y] (int k) { return y[k]; };
 4036:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4037: }
 4038: 
 4039: // Lambda version - allows custom access patterns
 4040: template<typename XFunc, typename YFunc>
 4041: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4042:                                 double y_top, double y_bot,
 4043:                                 CubicSpline &spline) {
 4044:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4045: }
