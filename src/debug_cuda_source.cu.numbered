 1860:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1861:       // Compute the different time ramps used in the code 
 1862:       // This function is performed by just one thread
 1863: 
 1864:       rampbc = 1.0;
 1865:       if constexpr(ibc == 0) {
 1866:          if (drampbc > 0.0) {
 1867:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1868:          } else {
 1869:             rampbc = 1.0;
 1870:          }
 1871:       }
 1872: 
 1873:       if (nws != 0) {
 1874:          if (drampwind > 0.0) {
 1875:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1876:          } else {
 1877:             rampwind = 1.0;
 1878:          }
 1879:       }
 1880: 
 1881:       if (drampwafo > 0.0) {
 1882:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1883:       } else {
 1884:          rampwafo = 1.0;
 1885:       }
 1886: 
 1887:       // For source/sinks
 1888:       if (if_source && dramp_ss > 0.0) {
 1889:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1890:       } else {
 1891:          ramp_ss = 1.0;
 1892:       }
 1893: 
 1894:       if (dramp > 0.0) {
 1895:          ramp = tanh(2.0*time/86400.0/dramp);
 1896:       } else {
 1897:          ramp = 1.0;
 1898:       }
 1899: 
 1900: 
 1901:    }
