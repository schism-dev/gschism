 2193:                    if (idx_elem >= mesh->ne) return;
 2194: 
 2195: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 2196:                    Node *node = &(mesh->localNodeData[idx_node]); \
 2197:                    if (idx_node >= mesh->np) return;
 2198: 
 2199: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 2200:                               Node *node = &(mesh->localNodeData[idx_node]); \
 2201:                               const bool valid = (idx_node < mesh->np);                   
 2202: 
 2203: 
 2204: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2205:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 2206:                            if (idx_node_bnd >= mesh->nbp) return;
 2207: 
 2208: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2209:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2210:                            if (idx_side_bnd >= mesh->nbs) return;  
