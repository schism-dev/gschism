 7764:   
 7765: //                     swild4(1,1)=swild4(1,1)*rat+sdbt(2+jj,max(k,kbs(jsj)),jsj)*(1-rat)
 7766: //                     swild4(2,1)=swild4(2,1)*rat+sdbt(2+jj,max(k-1,kbs(jsj)),jsj)*(1-rat)
 7767: //                     psumtr(jj)=psumtr(jj)+0.5d0*(swild4(1,1)+swild4(2,1)) 
 7768: //                   enddo !j
 7769: //                 enddo !jj
 7770: //                 tr_el(1:ntr,k,i)=psumtr(:)/dble(i34(i))
 7771: //               enddo !k
 7772: //             endif !ielem_elm(i)/=0
 7773: 
 7774: 
 7775: // !           Extend
 7776: //             do k=1,kbe(i)
 7777: //               tr_el(1:ntr,k,i)=tr_el(1:ntr,kbe(i)+1,i)
 7778: //             enddo !k
 7779: //           enddo !i=1,ne
 7780: // !$OMP     end do 
 7781: 
 7782: // !$OMP     master
 7783: // !         Update ghosts
 7784: // #ifdef INCLUDE_TIMING
 7785: //           cwtmp=mpi_wtime()
 7786: //           timer_ns(1)=timer_ns(1)+cwtmp-cwtmp2
 7787: // #endif
 7788: //           call exchange_e3d_2t_tr(tr_el)
 7789: 
 7790: // #ifdef INCLUDE_TIMING
 7791: //           cwtmp2=mpi_wtime()
 7792: //           wtimer(9,2)=wtimer(9,2)+cwtmp2-cwtmp
 7793: // #endif
 7794: 
 7795: #endif
