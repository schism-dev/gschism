 4910: 
 4911: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4912:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4913:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4914:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4915: }
 4916: 
 4917: 
 4918: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4919:    // Brunt-Väisälä frequency at level k.
 4920:    if (k <= node->kb || k >= ivrt) return 0.0;
 4921:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4922: }
 4923: 
 4924: 
 4925: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4926: 
 4927:    
 4928:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4929:    // k is the layer bottom index.
 4930: 
 4931: 
 4932: 
 4933:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4934: 
 4935:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4936:       const double eta2 = node->eta2;
 4937:       const double depth = node->depth;
 4938: 
 4939:       // Distances from the layer midpoint to the surface and bottom
 4940:       const double dist_s = eta2 - z_c;
 4941:       const double dist_b = z_c + depth;
 4942: 
 4943:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4944: 
 4945:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4946: 
 4947: 
 4948:    } else {
 4949:       return 1.0; // Other GLS submodels
 4950: 
 4951:    }
 4952: }
 4953: 
 4954: 
 4955: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4956:    // Minimum mixing length for levels below the surface.
 4957:    // Independent of psimin(); do not invert one to get the other.
 4958:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4959: }
 4960: 
 4961: 
 4962: __device__ void Turbulence<TurbulenceModel::GLS>::init(Node *node) {
 4963:    // Whole column, including levels below kb. Matches the Fortran cold start.
 4964:    for (int k = 0; k < nvrt; k++) {
 4965:       tke[k]    = tkemin();
 4966:       mxl[k]    = mxlmin(node->depth);
 4967:       nu_tke[k] = diffmin;
 4968:       nu_phi[k] = diffmin;
 4969: 
 4970:       node->dfv[k] = 0.0;
 4971:       node->dfh[k] = 0.0;
 4972:    }
 4973: }
 4974: 
 4975: 
 4976: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4977: 
 4978:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4979: 
 4980:    if constexpr(iveg == 1) {
 4981:       
 4982:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4983:       const double zTopCanopy = node->zTopCanopy();
 4984: 
 4985:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4986: 
 4987:          const double ztop = node->z[k];   // Top of the current layer.
 4988: 
 4989:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4990:          // Where 1 means that the current level is fully within the vegetation layer.
 4991:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4992: 
 4993:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4994:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4995: 
 4996:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4997:          // and at the bottom of the layer.
 4998:          const double vmag_top = length(ub2_top);
 4999:          const double vmag_bot = length(node->u2[k-1]);
 5000: 
 5001:          // Volume-averaged velocity cubed.
 5002:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 5003: 
 5004:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 5005:          // and at the bottom of the layer.
 5006:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 5007:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 5008: 
 5009:          // Volume-averaged vegetation alpha cubed.
 5010:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 5011: 
 5012:          return veg_alpha3D*vmag3;
 5013:       } 
 5014:       else {
 5015:          // The current level is not within the vegetation layer, so the production is 0.
 5016:          return 0.0;
 5017:       }
 5018:    } else {
 5019: 
 5020:       // If no vegetation, the production is 0.
 5021:       return 0.0;
 5022:    }
 5023: 
 5024: }
 5025: 
 5026: 
 5027: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 5028:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 5029:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 5030: 
 5031:    const int kb = node->kb;
 5032: 
 5033:    for (int k = kb; k < nvrt; k++) {
 5034:       const double tke = this->tke[k];
 5035:       const double mxl = this->mxl[k];
 5036:       const double u = sqrt(tke);  // Characteristic velocity
 5037:       const double lu = mxl*u;     // Characteristic diffusivity 
 5038: 
 5039:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 5040:       double drho_dz = 0.0;
 5041:       if (k > kb && k < ivrt) {
 5042:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 5043:       }
 5044: 
 5045:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 5046: 
 5047:       // Tsinghua group       
 5048:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 5049: 
 5050:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 5051:       if constexpr (stabilityModel == Galperin) {
 5052:          sh = 0.49393/(1.0-34.676*Gh);
 5053:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 5054:          cmiu  = sqrt(2.0)*sm;
 5055:          cmiup = sqrt(2.0)*sh;
 5056:          cmiu1 = sqrt(2.0)*0.2;
 5057:          cmiu2 = sqrt(2.0)*0.2;
 5058: 
 5059:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 5060:          // Warner's paper has problem
 5061:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 5062:          const double Ghp = Gh;  /// XXXXX needed?
 5063:          sh = 0.4939/(1.0 - 30.19*Ghp);
 5064:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 5065:          cmiu  = sqrt(2.0)*sm;
 5066:          cmiup = sqrt(2.0)*sh;
 5067:          cmiu1 = cmiu/schk();
 5068:          cmiu2 = cmiu/schpsi();
 5069: 
 5070:       } else {
 5071:          assert(false && "Unknown ASM");
 5072: 
 5073:       }
 5074: 
 5075:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 5076:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 5077:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 5078:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 5079:    }
 5080: }
 5081: 
 5082: 
 5083: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 5084: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 5085: 
 5086:    const double z = node->z[k];
 5087:    const double eta2 = node->eta2;
 5088:    const double depth = node->depth;
 5089: 
 5090:    // Distances to the surface and bottom
 5091:    const double dist_s = eta2 - z;
 5092:    const double dist_b = z + depth;
 5093: 
 5094:    // Distance to the closest "wall" (either surface or bottom).  
 5095:    // In the top layer, it is the size of the layer.
 5096:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 5097:    assert(min_dist > 0.0 && "Invalid minimum distance");
 5098: 
 5099:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 5100:    return kappa*min_dist;
 5101: }
 5102: 
 5103: 
 5104: 
 5105: template<TurbulenceModel turbulenceModel>
 5106: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 5107: 
 5108: 
 5109: template<>
 5110: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 5111:    // Constant turbulence model
 5112:    // Does nothing since dfv and dfh are already set  in the initialization.
 5113: }
 5114: 
 5115: template<>
 5116: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 5117:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 5118: 
 5119:    // Solves the following PDEs:
 5120:    //
 5121:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 5122:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 5123:    //
 5124:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 5125:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 5126:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 5127:    //
 5128:    // The equations are solved using a linear *vertical* FEM formulation.
 5129:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 5130:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 5131:    
 5132:    
 5133:    // Get the turbulence model
 5134:    // reinterpret_cast is used to avoid stupid compiler errors.
 5135:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 5136:      
 5137:    const int kb = node->kb;
 5138:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 5139: 
 5140:    double alow_tke[nvrt], alow_phi[nvrt];
 5141:    double bdia_tke[nvrt], bdia_phi[nvrt];
 5142:    double cupp_tke[nvrt], cupp_phi[nvrt];
 5143:    double rhs_tke [nvrt], rhs_phi [nvrt];
 5144:    
 5145:    // Initialize the tridiagonal system
 5146:    for (int kin = 0; kin < nqrows; kin++) {
 5147:       alow_tke[kin]=0.0;
 5148:       bdia_tke[kin]=0.0;
 5149:       cupp_tke[kin]=0.0;
 5150:       rhs_tke [kin]=0.0; 
 5151:       alow_phi[kin]=0.0;
 5152:       bdia_phi[kin]=0.0;
 5153:       cupp_phi[kin]=0.0;
 5154:       rhs_phi [kin]=0.0; 
 5155:    }
 5156: 
 5157: 
 5158: 
 5159:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 5160:    if (node->isDry || node->is2D()) {
 5161: 
 5162:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 5163:       const double diffmin = turb.diffmin;
 5164: 
 5165:       for (int k = 0; k < nvrt; k++) {
 5166:          turb.tke[k]    = turb.tkemin();
 5167:          turb.mxl[k]    = turb.mxlmin(node->depth);
 5168:          node->dfv[k]   = diffmin;
 5169:          node->dfh[k]   = diffmin;
 5170:          turb.nu_tke[k] = diffmin;
 5171:          turb.nu_phi[k] = diffmin;
 5172:       }
 5173: 
 5174:       return;
 5175:    }
 5176: 
 5177:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 5178:    
 5179:    // After here we know that the node is wet and has at least 2 layers.
 5180: 
 5181:    double solution[nvrt], gam[nvrt];
 5182:    
 5183:    const double eta2       = node->eta2;
 5184:    const double depth      = node->depth;
 5185:    const double Cd         = node->Cd; // Drag coefficient
 5186: 
 5187:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 5188:    
 5189:    const double sqU2 = norm2(node->u2[kb + 1]);
 5190:    const double modTau = length(node->tau);
 5191: 
 5192:  
 5193: 
 5194:    const double cpsi1 = turb.cpsi1();
 5195:    const double cpsi2 = turb.cpsi2();
 5196:    // cpsi3 is computed later because it depends on k
 5197: 
 5198: 
 5199:    // Assemble the tridiagonal system
 5200:    // -------------------------------
 5201: 
 5202:    // Loop over each vertical layer (interval between two vertical levels)
 5203:    // Each interval is an element of the vertical FEM formulation.
 5204:    // Two shape functions are defined over each interval. In this function we well call them
 5205:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5206:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5207:    //
 5208:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5209:    // Both systems of equations are assembled in the same loop.
 5210:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5211: 
 5212:       // Indices for the *rows* of the tridiagonal system.
 5213:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5214:       const int k2 = k - kb;     // One at k = kb + 1
 5215: 
 5216:       // Get the properties of the current interval.
 5217:       const double z  = node->z[k]; // bottom level of the interval
 5218:       const double dz = node->Dz(k + 1);
 5219:       
 5220:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5221: 
 5222:       // Turbulence production/dissipation terms (at the center of the interval).
 5223:       
 5224:       const double M2 = norm2(du_dz_c);              // Shear production term
 5225: 
 5226:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5227: 
 5228:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5229: 
 5230:       const double cpsi3 = turb.cpsi3(N2); 
 5231: 
 5232: 
 5233:       // Turbulence quantities at half levels (cell [c]enter)
 5234:       const double tke_1     = turb.tke[k];
 5235:       const double tke_2     = turb.tke[k+1];
 5236:       const double mxl_1     = turb.mxl[k];
 5237:       const double mxl_2     = turb.mxl[k+1];
 5238:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5239:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5240:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5241:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5242:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5243:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5244:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5245: 
 5246:       // Integral of the shape function products:
 5247:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5248:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5249:       const double p1p1 = dz/3.0;
 5250:       const double p1p2 = dz/6.0;
 5251:       const double d1d1 =  1.0/dz;
 5252:       const double d1d2 = -1.0/dz;
 5253: 
 5254:       // Production/dissipation related terms
 5255:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5256:       const double buoy = dfh_c*N2;
 5257:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5258: 
 5259: 
 5260: 
 5261:       // Equation for tke
 5262:       // ---------------
 5263: 
 5264:       // First row (of the two rows that the interval contributes to)
 5265:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5266:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5267:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5268: 
 5269: 
 5270:       if(prod + buoy >= 0.0) { // Net production
 5271:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5272:       } else { // Net dissipation
 5273:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5274:          bdia_tke[k1] -= 2.0*tmp;
 5275:          cupp_tke[k1] -= tmp;
 5276:       }      
 5277:       
 5278:       bdia_tke[k1] += 2.0*dt*diss;
 5279:       cupp_tke[k1] += dt*diss;
 5280:       
 5281:   
 5282:       // Second row (of the two rows that the interval contributes to)
 5283:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5284:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5285:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5286: 
 5287:       if (prod + buoy >= 0.0) { // Net production
 5288:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5289:       } else { // Net dissipation
 5290:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5291:          bdia_tke[k2] -= 2.0*tmp;
 5292:          alow_tke[k2] -= tmp;
 5293:       }
 5294:       
 5295:       bdia_tke[k2] += 2.0*dt*diss;
 5296:       alow_tke[k2] += dt*diss;
 5297: 
 5298: 
 5299:       // Equation for xl
 5300:       // ---------------
 5301: 
 5302:       const double rpub = turb.rpub();
 5303:       const double rmub = turb.rmub();
 5304:       const double rnub = turb.rnub();
 5305:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5306:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5307:       const double psi_c = 0.5*(psi_1 + psi_2);
 5308: 
 5309:       // Production/dissipation related terms
 5310:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5311:       const double buoy_phi = cpsi3*dfh_c*N2;
 5312:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5313: 
 5314:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5315:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5316:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5317: 
 5318:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5319:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5320:       } else { // Net dissipation
 5321:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5322:          bdia_phi[k1] -= 2.0*tmp;
 5323:          cupp_phi[k1] -= tmp;
 5324:       }
 5325: 
 5326:       // Production/dissipation terms
 5327:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5328:       cupp_phi[k1] += dt*diss_phi;
 5329:  
 5330: 
 5331:       // row k2 (upper)
 5332:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5333:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5334:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5335: 
 5336:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5337:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5338:       } else { // Net dissipation
 5339:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5340:          bdia_phi[k2] -= 2.0*tmp;
 5341:          alow_phi[k2] -= tmp;
 5342:       }
 5343: 
 5344:       // Production/dissipation terms
 5345:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5346:       alow_phi[k2] += dt*diss_phi;
 5347: 
 5348:    }
 5349: 
 5350:    // BC
 5351:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5352:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5353: 
 5354: 
 5355:    // Solves for tke.
 5356:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5357: 
 5358: 
 5359:    // B.C. (computed using values from previous time except wind)
 5360:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5361:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5362: 
 5363: 
 5364:    // Update TKE.
 5365:    turb.tke[kb]     = tkebot;
 5366:    turb.tke[kb + 1] = tkebot;
 5367:    turb.tke[ivrt]   = tkesrf;
 5368:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5369:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5370: // printf("tke[%d]: %f, solution[%d]: %f\n", k, turb.tke[k], kin, solution[kin]);   
 5371:    }
 5372: 
 5373: 
 5374: 
 5375:  
 5376:    // Solves for phi.
 5377:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5378: 
 5379: 
 5380:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5381:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5382:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5383: 
 5384:    turb.mxl[kb+1] = mxlbot;
 5385:    turb.mxl[ivrt] = mxlsrf;
 5386:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5387:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5388: 
 5389:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5390: 
 5391:       // Galperin's clipping
 5392:       if (N2 < 0.0) {
 5393:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5394:          turb.mxl[k] = min(turb.mxl[k], upper);
 5395:       }   
 5396: 
 5397: 
 5398: 
 5399:       // Max. mixing length based on dissipation; mxlmin prevails
 5400:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5401: 
 5402:       // Combined max. mixing length including geometric limit
 5403:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5404: 
 5405:       // Clamp the mixing length between the minimum and maximum values
 5406:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5407: 
 5408:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5409: 
 5410: 
 5411:    } // for k
 5412: 
 5413: 
 5414:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5415:    turb.tke[kb] = turb.tke[kb + 1];
 5416:    turb.mxl[kb] = turb.mxl[kb + 1];
 5417: 
 5418: 
 5419:    // Compute vertical diffusivities at new time
 5420:    turb.computeDiffusivities(node);
 5421: 
 5422:    // make all the variables uniform below the bottom level kb
 5423:    for (int k = 0; k < kb; k++) {
 5424:       node->dfv[k] = node->dfv[kb];
 5425:       node->dfh[k] = node->dfh[kb];
 5426:       turb.tke[k] = turb.tke[kb];
 5427:       turb.mxl[k] = turb.mxl[kb];
 5428:       turb.nu_tke[k] = turb.nu_tke[kb];
 5429:       turb.nu_phi[k] = turb.nu_phi[kb];
 5430:    }
 5431: 
 5432:       
 5433: 
 5434: }
 5435: 
 5436: 
 5437: 
 5438: 
 5439: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5440:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5441:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5442: 
 5443: 
 5444:    NODE(node1);
 5445: 
 5446:    node1->clearMatrixRow();
 5447:    node1->qel = 0.0;
 5448: 
 5449:    // THIS IS FOR STRUCTURES XXX
 5450:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5451: 
 5452:    
 5453:    for (int j=0; j<node1->numElements; j++) {
 5454:       // For each element connected to the node...
 5455: 
 5456:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5457: 
 5458:       Element *elem = node1->elements[j];
 5459: 
 5460:       // Compute the average gravity
 5461:       const double grav3 = elem->mean(&Node::grav2);
 5462: 
 5463:       // Look at the documentation for the description of the terms in the following integrals
 5464: 
 5465:       // Integral I_1 
 5466:       // \bar{\breve{H}} 
 5467:       const double hhatb = elem->mean(&Side::hhat);        
 5468: 
 5469:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5470: 
 5471:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5472:       const double area = elem->area;
 5473: 
 5474:       // Integral I_4
 5475:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5476:       // Where
 5477:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5478: 
 5479:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5480:       // of U over the element.
 5481:       const Vector2 U = elem->mean(&Side::U);
 5482: 
 5483:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5484: 
 5485:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5486:       const double I_4_1 = dot(gradPhi_1, U);
 5487: 
 5488: 
 5489:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5490:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5491: 
 5492:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5493: 
 5494: 
 5495:       // Normal component of the bed velocity
 5496:       double ubedNormalComp = 0.0;
 5497:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5498:          Vector3 ubed = {0.0, 0.0, 0.0};
 5499:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5500:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5501: 
 5502:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5503:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5504:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5505: 
 5506:          // Computes the normal component of the bed velocity
 5507:          ubedNormalComp = dot(ubed, N);
 5508:       } // imm==2
 5509: 
 5510:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5511: 
 5512:       if (elem->isTri()) {
 5513: 
 5514:          // To clarify the notation in this section: 
 5515:          //   In formulas, we use the following notation:
 5516:          //       i stands for the node under consideration (node1)
 5517:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5518:          //   However, in the code, we use the following notation:
 5519:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5520:          const int id2 = elem->nxq(1 + id1);
 5521:          const int id3 = elem->nxq(2 + id1);
 5522:          Node *node2 = elem->nodes[id2];
 5523:          Node *node3 = elem->nodes[id3];
 5524: 
 5525:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5526: 
 5527:          // integral of phi_i*phi_j
 5528:          const double ipp_ii = (1.0/6.0 )*area;
 5529:          const double ipp_ij = (1.0/12.0)*area;
 5530:          const double ipp_ik = (1.0/12.0)*area;
 5531: 
 5532:          // integral of [(grad phi_i) * (grad phi_j)]
 5533:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5534:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5535:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5536: 
 5537:          // Computes the different components of integral I_1 of each node with respect to node i.
 5538:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5539:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5540:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5541: 
 5542:          node1->addToSparseMatrix(node1, I1_ii);
 5543:          node1->addToSparseMatrix(node2, I1_ij); 
 5544:          node1->addToSparseMatrix(node3, I1_ik);
 5545: 
 5546:          #pragma unroll
 5547:          for (int l=0; l<3; l++) {
 5548: 
 5549:             Node *node = elem->nodes[l];
 5550: 
 5551:             // Additional variation in eta due to bed deformation or vertical velocity
 5552:             double extraEta = 0.0;
 5553:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5554:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5555: 
 5556: 
 5557:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5558:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5559: 
 5560:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5561: 
 5562:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5563:            
 5564:          }
 5565: 
 5566: 
 5567:       }
 5568:       else { // Quad
 5569:          // To clarify the notation in this section: 
 5570:          //   In formulas, we use the following notation:
 5571:          //       i stands for the node under consideration (node1)
 5572:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5573:          //   However, in the code, we use the following notation:
 5574:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5575:          const int id2 = elem->nxq(1 + id1);
 5576:          const int id3 = elem->nxq(2 + id1);
 5577:          const int id4 = elem->nxq(3 + id1);
 5578:          Node *node2 = elem->nodes[id2];
 5579:          Node *node3 = elem->nodes[id3];
 5580:          Node *node4 = elem->nodes[id4];   
 5581:          
 5582:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5583: 
 5584:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5585:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5586:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5587:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5588:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5589: 
 5590:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5591:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5592:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5593:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5594:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5595: 
 5596: 
 5597:          // Computes the different components of integral I_1 of each node with respect to node i.
 5598:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5599:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5600:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5601:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5602: 
 5603:          node1->addToSparseMatrix(node1, I1_ii);
 5604:          node1->addToSparseMatrix(node2, I1_ij); 
 5605:          node1->addToSparseMatrix(node3, I1_ik);
 5606:          node1->addToSparseMatrix(node4, I1_il);
 5607:   
 5608:          #pragma unroll
 5609:          for (int l=0; l<4; l++) {
 5610: 
 5611:             const Node *node = elem->nodes[l];
 5612: 
 5613:             // Additional variation in eta due to bed deformation or vertical velocity
 5614:             double extraEta = 0.0;
 5615:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5616:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5617: 
 5618:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5619:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5620:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5621: 
 5622:          }         
 5623:       } 
 5624: 
 5625: 
 5626:      node1->qel += (dt/elem->i34)*elem->vsource;
 5627:       
 5628: 
 5629:    } // for all elements connected to the node
 5630:    
 5631: 
 5632:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5633:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5634:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5635:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5636:    // If it is an open boundary node...
 5637: 
 5638:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5639: 
 5640:       // At least one open bnd side, maybe two
 5641:       for (int l=0; l<2; l++) { 
 5642: 
 5643:          // Gets each of the sides sharing the node. 
 5644:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5645: 
 5646:     
 5647: 
 5648:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5649:          if (sideBnd != nullptr) {
 5650:             // If the side is on a boundary...
 5651: 
 5652:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5653: 
 5654:             // Get the boundary segment
 5655:             const BoundarySegment *sideSegment = sideBnd->segment;
 5656:             const Side *side = sideBnd->side;
 5657: 
 5658:             // Integral I_3
 5659:             if (sideSegment->ifltype != 0) {
 5660:             // Natural or Flather b.c.
 5661: 
 5662:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5663:                // especially for Flather b.c.
 5664:                double ri3 = 0.0;
 5665:                if (!side->isDry) {
 5666:                   // If the side is not dry
 5667:                   
 5668:                   // Computes the side flux of (uth, vth)
 5669:                   double Vn = 0.0;
 5670:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5671:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5672:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5673: 
 5674:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5675:                   }
 5676: 
 5677:                   ri3 = 0.5*side->len*Vn;
 5678:                }
 5679: 
 5680:                if (sideSegment->ifltype == -1) { // Flather 1
 5681: 
 5682:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5683:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5684: 
 5685:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5686:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5687:                   
 5688:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5689:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5690: 
 5691:                } 
 5692:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5693:                   // Reset ri3
 5694:                   ri3 = 0.0;
 5695: 
 5696:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5697:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5698: 
 5699:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5700: 
 5701:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5702:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5703: 
 5704:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5705:                   node1->addToSparseMatrix(node1, con0*2.0);
 5706:                   node1->addToSparseMatrix(node2, con0);
 5707: 
 5708:                } // if Flather or Discharge
 5709: 
 5710:                node1->qel -= thetai*dt*ri3;  
 5711: 
 5712: 
 5713:             } // I_3
 5714:           
 5715: 
 5716:             // Integral I_5
 5717:             if(!side->isDry) {
 5718: 
 5719:                const double Unbar = dot(side->U, side->n);
 5720:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5721: 
 5722:             } // I_5
 5723: 
 5724:          } // if is boundary side
 5725: 
 5726:       } // for l
 5727: 
 5728:    } // if isbnd
 5729: 
 5730: 
 5731: }
 5732: 
