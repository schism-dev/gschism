 1663:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1664:       // Compute the different time ramps used in the code 
 1665:       // This function is performed by just one thread
 1666: 
 1667:       rampbc = 1.0;
 1668:       if constexpr(ibc == 0) {
 1669:          if (drampbc > 0.0) {
 1670:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1671:          } else {
 1672:             rampbc = 1.0;
 1673:          }
 1674:       }
 1675: 
 1676:       if (nws != 0) {
 1677:          if (drampwind > 0.0) {
 1678:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1679:          } else {
 1680:             rampwind = 1.0;
 1681:          }
 1682:       }
 1683: 
 1684:       if (drampwafo > 0.0) {
 1685:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1686:       } else {
 1687:          rampwafo = 1.0;
 1688:       }
 1689: 
 1690:       // For source/sinks
 1691:       if (if_source && dramp_ss > 0.0) {
 1692:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1693:       } else {
 1694:          ramp_ss = 1.0;
 1695:       }
 1696: 
 1697:       if (dramp > 0.0) {
 1698:          ramp = tanh(2.0*time/86400.0/dramp);
 1699:       } else {
 1700:          ramp = 1.0;
 1701:       }
 1702: 
 1703: 
 1704:    }
