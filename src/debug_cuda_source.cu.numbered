 6433: #ifdef DONTCOMPILE
 6434: __device__ void computeVerticalAdvection(void) {
 6435:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6436: 
 6437:    sdbt(1:2,:,:)=0.d0
 6438: 
 6439:    const Side *side = FROM kernel;
 6440: 
 6441:    if(side->isDry) return;
 6442: 
 6443:    // If side is wet...
 6444: 
 6445: 
 6446:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6447:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6448:    double ws[nvrt] = {} // w @ side
 6449:    int icount = 0;
 6450:    for (int j=0; j<2; j++) {
 6451:       const Element *elem = side->elements[j];
 6452:        
 6453:       if(elem != nullptr) {
 6454:          icount++;
 6455:          for (int k=0; k<nvrt; k++) {
 6456:             ws[k] = ws[k] + elem->w[k];
 6457:          }
 6458:       }
 6459:    }  // for j
 6460: 
 6461:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6462:    ws = ws/icount;
 6463: 
 6464:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6465:    // Splines allow for a smooth transition between vertical levels.
 6466:    // Splines have continuity restrictions at the internal knots, but
 6467:    // we have to provide the 1st derivatives at the endpoints.
 6468:    const int kbs = side->kbs; 
 6469:    
 6470:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6471:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6472:    initCubicSpline(kbs, nvrt, side, ws, up)
 6473: 
 6474:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6475:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6476:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6477: 
 6478:    // Total advection (average onto side)
 6479:    const Node *node1 = side->nodes[0];
 6480:    const Node *node2 = side->nodes[1];
 6481:    for (int k=kbs(i); k<nvrt; k++) {
 6482: 
 6483:       if constexpr(ics==1) {
 6484:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6485:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6486:       } else {
 6487:          // XXX IMPLEMENT THIS
 6488:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6489:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6490:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6491:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6492:       }  // if ics
 6493: 
 6494: 
 6495:    }
 6496: }
 6497: #endif
 6498: 
 6499: 
 6500: extern "C" {
 6501:    __global__ void computeElemAverageGhat(void) {
 6502:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6503: 
 6504:       ELEM(elem);
 6505:       
 6506:       elem->ghat1= {0.0, 0.0};  
 6507: 
 6508:       if constexpr(ihydraulics != 0) {
 6509:          if (nhtblocks > 0 && elem->isblock) return;
 6510:       }
 6511: 
 6512:       if (elem->isDry) return;
 6513: 
 6514:       // Wet elements.
 6515:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6516:       // tidal potential, horizontal diffusion, and baroclinic etc
 6517:       // Remember to update both fb and F 
 6518:       // If ics=2, ghat1 are in eframe (ll)
 6519:       // cff1-3: coefficients for 2D/3D
 6520:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6521:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6522:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6523: 
 6524:       double av_cff1 = 0.0;  // av. for cff1
 6525:       double av_cff2 = 0.0;  // av. for cff2
 6526:       double av_cff3 = 0.0;  // av. for cff3
 6527:       double av_df = 0.0;  // av. for H^\alpha / H
 6528:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6529:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6530: 
 6531:       const int i34 = elem->i34;
 6532:       const int kb = elem->kb;
 6533: 
 6534:       for (int j=1; j<i34; j++) {
 6535:          // For each node and side in the element...
 6536: 
 6537:          const Node *node = elem->nodes[j];
 6538:          const Side *side = elem->sides[j];
 6539: 
 6540:          const double chi      = side->chi;
 6541:          const double veg_c2   = side->veg_c2;
 6542:          const double veg_beta = side->veg_beta;
 6543:          const double veg_h    = side->veg_h();
 6544:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6545: 
 6546:          // Node - const in elem
 6547:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6548:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6549: 
 6550:          if (elem->depth >= tip_dp) {
 6551:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6552:          }
 6553: 
 6554:          
 6555:          const double htot  = side->htot2();        // Total depth at the side
 6556:          const double zctr2 = side->zTopCanopy();  
 6557: 
 6558:          double cff1; 
 6559:          double cff2; 
 6560:          double cff3;   
 6561:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6562:          // coefficients applied to 2D/3D case 
 6563:             cff1 = side->hhat/htot;
 6564:             cff2 = 0.0;
 6565:             cff3 = 0.0;
 6566:          } else { //3D
 6567:             //Init for no-veg case
 6568:             cff1 = 1.0;
 6569:             cff2 = 1.0;
 6570:             cff3 = 0.0;
 6571: 
 6572:             if constexpr(iveg != 0) {
 6573:                // Computes coefficients used with vegetation terms G1, G2
 6574:                // cff1, cff3 are used for the first two terms in G1, G2:
 6575:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6576:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6577:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6578:                if(veg_h < 0.99*htot) { // submergent vegetation
 6579:                   cff1=1;
 6580:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6581:                   cff3 = veg_c;
 6582: 
 6583:                } else { // emergent vegetation
 6584:                   cff1 = 1.0/(1.0 + veg_c2);
 6585:                   cff2 = cff1;
 6586:                   cff3 = 0.0;
 6587: 
 6588:                }
 6589:             } // if iveg
 6590:          } //  2D/3D
 6591: 
 6592:          av_cff1 += cff1/i34;
 6593:          av_cff2 += cff2/i34;
 6594:          av_cff3 += cff3/i34;
 6595:          av_cff2_chi += cff2*chi/i34;
 6596:          av_cff3_chi += cff3*chi/i34;
 6597:          av_df += min(htot, veg_h)/(htot*i34);
 6598: 
 6599: 
 6600:          // btrack values: U^\star, U^{\star\alpha}
 6601:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6602:          Vector2 Ustar       = {0.0, 0.0}; 
 6603:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6604: 
 6605:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6606:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6607:          } else { //3D
 6608:             for (int k = side->kb; k < nvrt; k++) {
 6609:             
 6610:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6611:                Ustar += w2;
 6612: 
 6613:                if constexpr(iveg != 0) {
 6614:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6615:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6616:                        Ustar_alpha += zrat*w2; // XXXX
 6617:                    }
 6618:                }  // if iveg
 6619:             }  // for k
 6620:          }  //2D/3D
 6621:          
 6622: 
 6623:          // Add btrack & surface stress terms to \breve{G} first
 6624:          if constexpr(ics==1) {
 6625:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6626:          } else {
 6627:             // XXX IMPLEMENT THIS
 6628:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6629:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6630:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6631:          }  // if ics
 6632: 
 6633:          // Surface and bottom stress terms
 6634:          if constexpr(ics==1) {
 6635:             const Vector2 tau    = side->tau();
 6636:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6637: 
 6638:             // Term for surface and bottom stress
 6639:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6640:          } else {
 6641:             // XXX IMPLEMENT THIS
 6642:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6643:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6644:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6645:             // tau_x=(vn1+tt1)/2.d0
 6646:             // tau_y=(vn2+ss1)/2.d0
 6647:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6648:          }  // if ics
 6649: 
 6650:          
 6651: 
 6652:          // All terms in F,F^\alpha,f_b except baroclinic
 6653:          // F, f_b: all explicit terms excluding vegetation 
 6654:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6655:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6656:          const double coriolis = side->coriolis;
 6657:          Vector2 F  =  coriolis*side->U;  // F_x
 6658:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6659:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6660: 
 6661:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6662:             
 6663:             for (int k = side->kb; k < nvrt; k++) {
 6664:                if (zctr2 > side->zc[k-1]) {
 6665:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6666:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6667:                    Fa +=  coriolis*w2*zrat;
 6668:                } // if zctr2
 6669:             } // k
 6670:          } // iveg
 6671: 
 6672:          // Integrate horizontal viscosity force vertically
 6673:          for (int k=side->kb + 1; k<nvrt; k++) {
 6674:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6675: 
 6676:             F += levelHorVisc;
 6677: 
 6678:             // Vegetation term
 6679:             if constexpr(iveg!=0) {
 6680:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6681:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6682:                   Fa += levelHorVisc*zrat;
 6683:                } 
 6684:             } // if iveg
 6685:          } // for k
 6686: 
 6687:          fb += side->nuGradU[side->kb];
 6688: 
 6689:          // Add to ghat1
 6690:          if constexpr(ics==2) {
 6691:             // XXX IMPLEMENT THIS
 6692:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6693:             // bigf1=vn1; bigf2=vn2
 6694:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6695:             // botf1=vn1; botf2=vn2
 6696:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6697:             // bigfa1=vn1; bigfa2=vn2
 6698:          } // if ics
 6699: 
 6700:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6701:       } // for j (nodes and sides)
 6702: 
 6703:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6704:          
 6705:       // Finish off terms in F, F^\alpha and f_b
 6706:       const double grav3 = elem->mean(&Node::grav2);
 6707:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6708: 
 6709: 
 6710:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6711:       for (int j=1; j<i34; j++) { 
 6712:          // For each side in the element...
 6713:          const Side *side = elem->sides[j];
 6714:          const double chi = side->chi;
 6715: 
 6716:          const double htot = side->htot2();
 6717:          const double veg_h = side->veg_h();
 6718:          const Vector2 F  = htot*fb;
 6719:          const Vector2 Fa = min(htot, veg_h)*fb;
 6720: 
 6721:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6722:       } // for j
 6723: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6724:       //botf1 etc are already in elem frame
 6725:       elem->ghat1 += tmp/i34;
 6726: 
 6727:       // Baroclinic force
 6728:       if constexpr(ibc==0) {
 6729:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6730: 
 6731:          Vector2 Fa = {0.0, 0.0};
 6732:          Vector2 intGradRho = {0.0, 0.0};
 6733:          
 6734:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6735:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6736:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6737: 
 6738:             // \in F [m^2/s/s]
 6739:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6740:          }
 6741: 
 6742:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6743:          const Vector2 F = av_df*Fa; //approx
 6744:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6745: 
 6746:       } // if ibc
 6747: 
 6748: 
 6749: 
 6750:    }
 6751: 
 6752: } // extern "C"
 6753: 
 6754: 
 6755: 
 6756: #ifdef DONTCOMPILE
 6757: __global__ void checkMassConservation(Tracers* sumtr) {
 6758: 
 6759:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6760: 
 6761:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6762: 
 6763:    Element *elem = &(mesh->localElemData[i]);
 6764: 
 6765:    // Skip dry elements
 6766:    if (elem->isDry) return;
 6767: 
 6768:    // Local sum array for this thread
 6769:    double localSum[N_TRACERS] = {0.0};
 6770: 
 6771:    // Sum over vertical levels for this element
 6772:    const int kbe = elem->kbe;
 6773:    const double area = elem->area;
 6774: 
 6775:    for (int k = kbe; k < nvrt; k++) {
 6776:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6777:       
 6778:       // Accumulate tracer mass
 6779:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6780:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6781:       }
 6782:    }
 6783: 
 6784:    
 6785: 
 6786:    //  This function returns per element sums. A reduction must be done on the host side.
 6787: }
 6788: 
 6789: 
 6790: __global__ void transport(void) {
 6791: 
 6792:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6793: 
 6794:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6795: 
 6796:    Element *elem = &(mesh->localElemData[ie]);
 6797: 
 6798:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6799: 
 6800:                for (int m=0; m<ntr; m++) {
 6801:                   for (int k=kbe(ie); k<nvrt; k++) {
 6802:                      // Calculate each polynomial's weight 
 6803:                      wm=0.d0; sum1=0.d0; 
 6804:                      wm1=0.d0; wm2=0.d0; 
 6805:                      for (int i=0; i<elem->nweno2; i++) {
 6806:                   
 6807:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6808:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6809:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6810:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6811:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6812:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6813:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6814:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6815:                      // -----------------Hu and Shu (1999)'s method----------------
 6816:                      b4=b1+b2+b3
 6817: 
 6818: //Error: add PRODUCTION CPP
 6819: #ifdef DEBUG
 6820:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6821:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6822:                     call parallel_abort(errmsg)
 6823:                   }
 6824: #endif
 6825: 
 6826:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6827:                   // !----test-------------- 
 6828:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6829:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6830:                   // !wm(i)=wm1(i)*wm2(i)
 6831:                   // !---------------------- 
 6832:                   sum1=sum1+wm(i)
 6833:                 } // end for i
 6834: 
 6835:                 wm=wm/sum1
 6836: 
 6837:                 for (int j=0; j<elem->i34; j++) {
 6838: 
 6839:                   const Side *side  = elem->sides[j];
 6840:                   const Node *node1 = side->n1;
 6841:                   const Node *node2 = side->n2;
 6842: 
 6843:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6844:                      trsd=0.d0
 6845:                      for (int kk=0; kk<nquad; kk++) {
 6846:                         for (int i=0; i<elem->nweno2; i++) {
 6847:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6848:                         } // end for i   
 6849:                      } // end for kk
 6850:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6851:                   } // outward flux
 6852:                } // end for j=1,i34(ie) ! side
 6853:             }
 6854:          }
 6855:               
 6856: 
 6857: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6858: //             //   calculate each polynomial's weight 
 6859: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6860: //                 wm=0.d0; sum1=0.d0
 6861: //                 do i=1,nweno1(ie) !for each polynomial
 6862: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6863: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6864: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6865: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6866: //                   wm(i)=b2
 6867: //                   sum1=sum1+b2
 6868: //                   !wm(i)=1.d0
 6869: //                   !sum1=sum1+1.d0
 6870: 
 6871: // // Error: PRODUCTION
 6872: // #ifdef DEBUG
 6873: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6874: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6875: //                     call parallel_abort(errmsg)
 6876: //                   endif
 6877: // #endif
 6878: 
 6879: //                 enddo !i
 6880: //                 wm=wm/sum1 !final weight
 6881: 
 6882:                 for (int j=0; j<elem->i34; j++) { // side
 6883:                   const Side *side = elem->sides[j];
 6884:                   const Node *node1 = side->n1;
 6885:                   const Node *node2 = side->n2;
 6886: 
 6887:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6888:                     trsd=0.d0
 6889:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6890:                       for (int i=0; i<elem->nweno1; i++) {
 6891:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6892:                       }
 6893:                     enddo //kk
 6894:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6895:                   } // outward flux
 6896:                 } // end for j=1,i34(ie) ! side
 6897:               } // end for k; ntr 
 6898: 
 6899:             else !simple upwind method
 6900:               do j=1,i34(ie)
 6901:                 jsj=elside(j,ie)
 6902:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6903:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6904:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6905:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6906:                   endif
 6907:                 enddo  !vertical layers
 6908:               enddo !j=1,i34(ie) ! side
 6909:             endif !order of accuracy
 6910: 
 6911:          //  enddo !ie
 6912: // !$OMP     end do
