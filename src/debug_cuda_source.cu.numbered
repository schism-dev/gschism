  968: 
  969:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  970:    {
  971:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  972:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  973:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  974:       
  975:    }
  976: 
  977:    __device__ Vector3 interpolateVelocities(Point3 xt, const Side *origSide = nullptr) const;
  978: 
  979:    // ------------------------------------------------------------------------------------------------
  980:    // These are functions that work on all nodes/sides of the element.
  981:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  982:    //
  983:    // An example of how to use these functions is:
  984:    //   
  985:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  986:    // 
  987:    // Where L is the level at which the field is to be interpolated. The field can be either
  988:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  989:    // There are different versions of getNodalValues for each of these cases.
  990: 
  991:    template<typename T>
  992:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
