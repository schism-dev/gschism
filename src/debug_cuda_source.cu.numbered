 2426:    template<typename T>
 2427:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2428:       // Get the values of the field at the nodes of the element
 2429:       res[0] = nodes[0]->*field;
 2430:       res[1] = nodes[1]->*field;
 2431:       res[2] = nodes[2]->*field;
 2432:       if (isQuad()) res[3] = nodes[3]->*field;
 2433:       else          res[3] = T();
 2434:    }
 2435: 
 2436:    template<typename T>
 2437:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2438: 
 2439:       assert(level < nvrt && "Level is out of range");
 2440:       // Get the values of the field at the nodes of the element
 2441:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2442:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2443:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2444:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2445:       else          res[3] = T();
 2446:    }    
 2447: 
 2448:    template<typename T>
 2449:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2450: 
 2451:       assert(level < nvrt && "Level is out of range");
 2452: 
 2453:       // Get the values of the func at the nodes of the element
 2454:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2455:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2456:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2457:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2458:       else          res[3] = T();  // This is 0.0 or a zero vector
 2459: 
 2460:    }      
 2461: 
 2462:    template<typename T>
 2463:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2464:       // Get the values of the field at the nodes of the element
 2465:       res[0] = sides[0]->*field;
 2466:       res[1] = sides[1]->*field;
 2467:       res[2] = sides[2]->*field;
 2468:       if (isQuad()) res[3] = sides[3]->*field;
 2469:       else          res[3] = T();
 2470:    }
 2471: 
 2472:    template<typename T>
 2473:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2474: 
 2475:       assert(level < nvrt && "Level is out of range");
 2476: 
 2477:       // Get the values of the field at the nodes of the element
 2478:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2479:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2480:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2481:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2482:       else          res[3] = T();
 2483:    }    
 2484: 
 2485:    template<typename T>
 2486:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2487: 
 2488:       assert(level < nvrt && "Level is out of range");
 2489: 
 2490:       // Get the values of the func at the nodes of the element
 2491:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2492:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2493:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2494:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2495:       else          res[3] = T();  // This is 0.0 or a zero vector
