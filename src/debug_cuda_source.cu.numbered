 1542:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1543:    // If ics == 2, convert the global point to the local frame of the side
 1544:       
 1545:       if constexpr (ics == 1) {
 1546:          return p;
 1547:       } else {
 1548:          const Point3 c = {center.x, center.y, centerZ()};
 1549:          const Point3 local = frame.G2L(p - c);
 1550:          return local;
 1551:       }
 1552:    }
 1553: 
 1554:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1555:       if constexpr (ics == 1) {
 1556:          return p;
 1557:       } else {
 1558:          const Point3 c = {center.x, center.y, centerZ()};
 1559:          return c + frame.L2G(p);
 1560:       }
 1561:    }
 1562: 
 1563: 
 1564:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1565:       if constexpr(ics == 1) return v;
 1566:       else return v_frame.projHorVec(v, frame);
 1567:    }
 1568: 
 1569:    __inline__ __device__ double centerZ(void)      const;
 1570:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1571:    // k is the upper level of the layer (same convention as Dz).
 1572:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt && k > 0); return zc[k] - zc[k - 1]; }
 1573:    __inline__ __device__ double area(int k)        const { assert(k < nvrt && k > 0); return len*Dz(k); }
 1574:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt && k > 0); return len*(zc[max(k, kb)] - zc[max(k - 1, kb)]); }
 1575: 
 1576:    __inline__ __device__ Side* neigh(int index) const { 
 1577:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1578:       assert(index >= 0 && index < 4); 
 1579:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1580: 
 1581:       const int ielem = index & 1;           // 0 or 1
 1582:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1583: 
 1584:       const Element* elem = elems[ielem];
 1585: 
 1586:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1587: 
 1588:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1589: 
 1590:    }
 1591: 
 1592:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1593: 
 1594:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1595: 
 1596:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1597:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1598:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1599:    __inline__ __device__ int iadv(void) const;
 1600: 
 1601:    __inline__ __device__ double grav3(void) const;
 1602:    
 1603:    __inline__ __device__ double eta2(void) const;
 1604:    __inline__ __device__ double eta1(void) const;
 1605:    __inline__ __device__ double w2(int k) const;
 1606:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1607:    __inline__ __device__ double depth(void) const;
 1608:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1609:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1610: 
 1611:    __inline__ __device__ double dfv(int k) const;
 1612: 
 1613:    __inline__ __device__ double veg_h(void)  const;
 1614:    __inline__ __device__ double veg_nv(void) const;
 1615:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1616:    __inline__ __device__ double veg_alpha3D(int k) const;
 1617:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1618: 
 1619:    __inline__ __device__ double Cd(void) const;
 1620: 
 1621:    __inline__ __device__ Vector2 tau(void) const;
 1622: 
 1623:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1624:    
 1625: 
 1626:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1627:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1628:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1629:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1630:    } 
 1631:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1632:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1633:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1634:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1635: 
 1636:    // Get valid starting element (for backtracking)
 1637:    __inline__ __device__ Element* getStartElement() {
 1638:       return elems[0] ? elems[0] : elems[1];
 1639:    }
 1640: 
 1641:    
 1642:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1643:       // Given an element, returns the other element that shares this side
 1644:       return (elems[0] == elem) ? elems[1] : elems[0];
 1645:    }
 1646: 
 1647:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1648:       // Given a node, returns the other node that shares this side
 1649:       return (n1 == node) ? n2 : n1;
 1650:    }
 1651:  
 1652:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1653: 
 1654: 
 1655: 
 1656: 
 1657: };
 1658: 
 1659: 
 1660: // This struct is used to store the boundary information for a node.
 1661: struct NodeBoundary {   
 1662:    int idx;
 1663:    BoundarySegment *segment;
 1664:    Node *node;
 1665:    
 1666:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1667:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1668: 
 1669:    bool isLand;
 1670: 
 1671:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1672:    double elbc;   // Elevation boundary condition
 1673:    double eth;    // Elevation time history
 1674: 
 1675:    double eta_mean; // Mean elevation at nodes
 1676: 
 1677:    bool isEssentialBC;
 1678: 
 1679:    Vector2 uth[nvrt];  // "Time history" velocity
 1680: 
 1681:    // Arrays for harmonic constituents (if needed)
 1682:    // nbfr ? nbfr : 1 is there to avoid a 0-sized array.
 1683:    double  emo[nbfr ? nbfr : 1];  // Elevation amplitude
 1684:    double  efa[nbfr ? nbfr : 1];  // Elevation phase
 1685: 
 1686: 
 1687:    NodeBoundary(void) {
 1688:       isLand = false;
 1689:    }
 1690:    NodeBoundary(bool _isLand) {
 1691:       isLand = _isLand;
 1692:    }
 1693: 
 1694:    
 1695:    __forceinline__ __device__ int numSidesForAverage() const {
 1696:    // Returns the number of sides that are connected to the node and have the same segment.
 1697:    // This is used to compute the average velocity at the node for open boundary nodes.
 1698:       int res = 0;
 1699:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1700:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1701: 
 1702:       return res;
 1703:    }
 1704: 
 1705: 
 1706:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1707:       assert(index == 0 || index == 1); 
 1708:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1709:    }
 1710: 
 1711:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1712:       if (isLand) return;  // land never uses these links
 1713: 
 1714:       SideBoundary *nullSideBoundary = nullptr;
 1715:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1716: 
 1717:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1718:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1719: 
 1720:       // both slots taken. OK if this side was already linked
 1721:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1722:    }
 1723: 
 1724: 
 1725: };
 1726: 
 1727: struct Node {
 1728: 
 1729:    // Geometry information
 1730:    int idx;            // Global index of the node
 1731:    int16_t part;       // Partition of the node
 1732: 
 1733:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1734:    int16_t numNodes;   // Number of nodes neighbors of this node
 1735: 
 1736:    Element **elements; // Array of pointers to the elements that share this node
 1737:    int16_t numElements;// Number of elements that share this node
 1738: 
 1739:    int16_t numSides;   // Number of sides that are connected to this node
 1740: 
 1741: 
 1742:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1743:    double gz;          // Global vertical coordinate at the node.
 1744:    Vector2 u2[nvrt];
 1745:    double  w2[nvrt];
 1746:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1747:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1748:    double lon, lat;
 1749:    double depth;
 1750: 
 1751:    Frame<ics> frame;
 1752: 
 1753:    LocalSigma<ivcor> localSigma;  
 1754: 
 1755:    int16_t kb;     // Bottom index of the node
 1756: 
 1757:    bool isDry;     // True if the node is dry
 1758: 
 1759:    int16_t iadv;   // Advection flag
 1760: 
 1761:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1762:                           // this is nullptr
 1763: 
 1764:    TempVar tmp; // Temporary variable to store different types of variables
 1765: 
 1766:    // Physical information
 1767:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1768:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1769: 
 1770:    double rho[nvrt];     // Density
 1771:    double dfv[nvrt];     // Vertical viscosity
 1772:    double dfh[nvrt];     // Horizontal viscosity  XXXX (does it need to exist when transport is not enabled?)
 1773: 
 1774:    Turbulence<turbulenceModel> turb;
 1775: 
 1776:    double eta1; // Elevation at nodes at previous timestep
 1777:    double eta2; // Elevation at nodes at current timestep
 1778: 
 1779:    double ETP;  // Earth Tidal Potential
 1780: 
 1781:    double pr;    // Air pressure
 1782:    double grav2; // Gravity 
 1783:    
 1784:    Vector2 dav;  // Depth averaged velocity
 1785: 
 1786:    Vector2 tau; // Wind stress vector
 1787: 
 1788:    // Vegetation parameters
 1789:    double veg_h;
 1790:    double veg_nv;
 1791:    double veg_di;
 1792:    double veg_Cd;
 1793:    double veg_h_unbent;
 1794:    double veg_di_unbent;
 1795:    double veg_nv_unbent;
 1796:    double veg_alpha_vert_mean;
 1797:    double veg_alpha0;
 1798:    double veg_alpha3D[nvrt];
 1799: 
 1800:    // Bottom drag parameters
 1801:    double Cd;       // Bottom drag coefficient   
 1802: 
 1803:    // These three are mutually exclusive
 1804:    union {
 1805:       double rmanning; // Bottom Manning's coefficient
 1806:       double rough;    // Bottom roughness length
 1807:       double drag;     // Bottom drag coefficient
 1808:    };
 1809:    Vector2 tau_bot; // Bottom stress vector
 1810: 
 1811:    // XXXX REMOVE FOR IMM>0???
 1812:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1813:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1814: 
 1815:    
 1816:    double qel; // RHS
 1817:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1818:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1819:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1820:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1821: 
 1822:    double mX; // Solution of the FEM system
 1823: 
 1824:    // Meteorological forcing
 1825:    Vector2 u_air;
 1826:    double p_air;  // XXXX is this the same as pr?
 1827:    double t_air;
 1828:    double q_air;
 1829:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1830: 
 1831: 
 1832: 
 1833:    __device__ __forceinline__ int localIndex() const;
 1834:    __device__ __forceinline__ int packedIndex() const;
 1835: 
 1836: 
 1837:    __device__ void setWind(Vector2 &u) {
 1838:    // Sets the wind vector taking into account the mesh angle
 1839:    
 1840:       const double speed = length(u);
 1841: 
 1842:       // Rotate wind vector to the node frame
 1843:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1844: 
 1845:       // Sets the surface stress vector due to wind.
 1846:       if constexpr(nws == 0) {
 1847:          tau = {0.0, 0.0};
 1848: 
 1849:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1850:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1851: 
 1852:       } else {
 1853: 
 1854:          double dragcoef;
 1855: 
 1856:          if constexpr(iwind_form == -1) {
 1857:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1858:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1859: 
 1860:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1861:             tau = cff*u_air;
 1862:  
 1863:          } else if constexpr(iwind_form == 1) {
 1864:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1865:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1866: 
 1867:             dragcoef = max(dragcoef, 4.0e-4);
 1868:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1869:             tau = cff*u_air;
 1870: 
 1871:          } else {
 1872:             tau = {0.0, 0.0};
 1873:          }
 1874:       }
 1875:    }
 1876: 
 1877: 
 1878:    __device__ void setFrame(double lat, double lon) {
 1879:       if constexpr(ics == 1) return;
 1880: 
 1881:       frame.update(lat, lon);        
 1882:     }
 1883: 
 1884:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1885: 
 1886:    __device__ double sigmaTransitionDepth(void) const;
 1887: 
 1888:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1889: 
 1890:    __inline__ __device__ Point2 outputCoords(void) const {
 1891:       if constexpr(ics == 1)  return p;
 1892:       else                    return {rad2deg*lon, rad2deg*lat};
 1893:    }
 1894: 
 1895:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1896:    // If ics == 2, convert the global point to the local frame
 1897:       
 1898:       if constexpr (ics == 1) {
 1899:          return p;
 1900:       } else {
 1901:          const Point3 c = {p.x, p.y, gz};
 1902:          const Point3 local = frame.G2L(p - c);
 1903:          return local;
 1904:       }
 1905:    }
 1906: 
 1907:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1908:    // If ics == 2, convert the global point to the local frame
 1909:       
 1910:       if constexpr (ics == 1) {
 1911:          return p;
 1912:       } else {
 1913:          const Point3 c = {p.x, p.y, gz};
 1914:          return c + frame.L2G(p);
 1915:       }
 1916:    }
 1917: 
 1918:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1919:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1920:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1921:    
 1922:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1923: 
 1924:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1925:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1926:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }   
 1927: 
 1928:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1929:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1930: 
 1931:    __device__ __forceinline__ void clearMatrixRow(void) {
 1932:       // Clear the matrix row for this node
 1933: 
 1934:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1935: 
 1936:    }
 1937: 
 1938:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1939:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1940:       
 1941:       if (node == this) {
 1942:          *coeffDiag += value;
 1943:          return;
 1944:       }
 1945: 
 1946:       int i;
 1947:       for (i = 0; i < numNodes; i++) {
 1948:          if (nodes[i] == node) break;
 1949:       }
 1950: 
 1951:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1952:       coeffRow[csrSlot[i]] += value;
 1953:    }
 1954: 
 1955: 
 1956:    __device__ __inline__ void updateZCoordData(void);
 1957: 
 1958:    __device__ __forceinline__ double compZCoord(int k) const;
 1959: 
 1960:    __device__ void updateKb(void);
 1961: 
 1962:    __device__ __forceinline__ void computeBottomDragCd(void);
 1963: 
 1964: 
 1965: 
 1966: };
