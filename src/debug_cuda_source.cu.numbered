 2072: 
 2073: 
 2074: 
 2075: 
 2076: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2077:    if constexpr(ics == 1)  {
 2078:       return center;
 2079: 
 2080:    } else {
 2081:       const Point2 p0 = nodes[0]->outputCoords();
 2082:       const Point2 p1 = nodes[1]->outputCoords();
 2083:       const Point2 p2 = nodes[2]->outputCoords();
 2084: 
 2085:       if (isTri()) {
 2086:          return (1.0/3.0)*(p0 + p1 + p2);
 2087: 
 2088:       } else {
 2089:          const Point2 p3 = nodes[3]->outputCoords();
 2090:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2091:       }
 2092: 
 2093:    }
 2094: }
 2095: 
 2096: 
 2097: __device__ __forceinline__ double Element::centerZ(void) const { 
 2098: // Z coordinate of the element center in the global cartesian coordinates.
 2099: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2100: 
 2101:    if constexpr(ics==1) { 
 2102:       return 0.0; 
 2103: 
 2104:    } else { 
 2105: 
 2106:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2107:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2108:    } 
 2109: }
