 2704: 
 2705: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2706: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2707: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2708: // Only when ics == 2, the origin is at the element center.
 2709: 
 2710:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2711: 
 2712:    const Node *node = nodes[idxNode];
 2713: 
 2714:    if constexpr(ics==1) {
 2715:       return node->p;
 2716: 
 2717:    } else {
 2718:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2719: 
 2720:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2721: 
 2722:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2723:    }
 2724: 
 2725: }
 2726: 
 2727: 
 2728: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2729:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2730: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2731: 
 2732:    const int id1 = idx;
 2733:    const int id2 = nxq(1 + id1);
 2734:    const int id3 = nxq(2 + id1);
 2735: 
 2736:    if constexpr(ics==1) {
 2737:       x0 = nodes[id1]->p;
 2738:       x1 = nodes[id2]->p;
 2739:       x2 = nodes[id3]->p;
 2740: 
 2741:    } else {
 2742: 
 2743:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2744:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2745:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2746: 
 2747:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2748:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2749:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2750: 
 2751:    }
 2752: 
 2753: }
 2754: 
 2755: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2756:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2757: }
 2758: 
 2759: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2760:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2761:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2762: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2763: 
 2764:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2765: 
 2766: 
 2767: 
 2768:    if constexpr(ics==1) {
 2769:       x0 = nodes[0]->p;
 2770:       x1 = nodes[1]->p;
 2771:       x2 = nodes[2]->p;  
 2772:       x3 = nodes[3]->p;
 2773: 
 2774:    } else {
 2775: 
 2776:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2777:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2778:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2779:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2780: 
 2781:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2782:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2783:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2784:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2785:    }
 2786: 
 2787: }
 2788: 
 2789: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2790:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2791: {
 2792:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2793: }
