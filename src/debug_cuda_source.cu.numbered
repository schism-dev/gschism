 6158: 
 6159:    __global__ void computeVerticalVelocity(void) {
 6160:       // Computes the vertical velocity at the (2D) element's centroid.
 6161:       // In this function we will be considering volumetric elements, with side faces and a 
 6162:       // bottom and a top face. We will call them SFs, BF and TF.
 6163:       // It computes the flux coming from BF and the SFs.
 6164:       // If the bed is moving, it takes that into account.
 6165:       // Since water is incompressible, the integral of the velocity times the normal vector
 6166:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6167:       // and the BF is equal to the flux going out from the TF.
 6168:       // TF = - BF - sum(SFs).
 6169:       // It then computes the horizontal velocity at the center of TF.
 6170:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6171:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6172:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6173: 
 6174:       ELEM(elem);
 6175: 
 6176:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6177: 
 6178:       if (elem->isDry) return;
 6179: 
 6180:       const int kb = elem->kb;
 6181:       const bool isTri = elem->isTri();
 6182: 
 6183:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6184: 
 6185:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6186:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6187:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6188: 
 6189:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6190: 
 6191:       double area3D;
 6192: 
 6193:       // Bottom face flux
 6194:       double bottomFlux = 0.0;
 6195:       Vector2 u2meanBottom = {0.0, 0.0};
 6196:       const Vector2 gradh = elem->grad2(&Node::depth);
 6197:       if constexpr(imm==2) {
 6198:          Vector3 ubed;
 6199: 
 6200:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6201:          // updateBDEF(ubed);
 6202:      
 6203:          // const double bflux0 = dot(ubed, elem_n1);
 6204: 
 6205:          // elem->w[kb] += ubed.z;
 6206:       }
 6207:       else {
 6208:          Vector2 umean;
 6209:          if constexpr(ics == 1) {
 6210:             u2meanBottom = elem->mean(kb, &Side::u2);
 6211:          }
 6212:          else {
 6213:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6214:          }
 6215: 
 6216:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6217:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6218: 
 6219:          bottomFlux = - dot(gradh, u2meanBottom);
 6220:       } // if imm
 6221: 
 6222:       // Compute w for kb+1 to nvrt-1
 6223:       for (int l = kb; l < nvrt - 1; l++) {
 6224: 
 6225:          // normal vector to the top face of the "volumetric" element (3D)
 6226:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6227: 
 6228:          // Compute the total flux at the sides
 6229:          double sideFlux = 0.0;
 6230: 
 6231:          for (int j = 0; j < elem->i34; j++) {
 6232:             const Side *side = elem->sides[j];
 6233: 
 6234:             const double sideArea = side->area(l);
 6235:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6236:             const double sign = elem->ssign[j]; 
 6237: 
 6238:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6239:          }
 6240:          
 6241:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6242:          //velocities at the centers of the sides
 6243:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6244: 
 6245:          // The flx at the top ace can be computed from the other flows.
 6246:          const double topFlux = - sideFlux - bottomFlux;
 6247:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6248: 
 6249:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6250: 
 6251:          elem_n1 = elem_n2;
 6252: 
 6253:          bottomFlux = - topFlux;
 6254:       }
 6255:    }  
 6256: 
 6257: 
 6258: 
 6259: 
 6260: 
 6261: 
 6262: 
 6263: // !===============================================================================
 6264: // !===============================================================================
 6265: 
 6266: } // extern "C"
