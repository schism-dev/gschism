 4220:    __global__ void scaleGravity(double loadtide_coef) {
 4221: 
 4222: 
 4223:       NODE(node);
 4224: 
 4225:       // SAL option: scale gravity
 4226:       if constexpr(iloadtide==2) {  // simple const
 4227:          node->grav2 = grav*(1.0 - loadtide_coef);
 4228: 
 4229:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4230:         
 4231:           const double depth = max(node->depth, 0.0);
 4232:           const double tmp1 = sqrt(depth);
 4233:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4234:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4235:                              2.6969e-13*depth*depth*depth*tmp1;
 4236:           
 4237:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4238:           
 4239: 
 4240: 
 4241:           node->grav2 = grav*(1.0 - beta_bar);
 4242: 
 4243:       } else {  // iloadtide=0,1
 4244:         node->grav2=grav;
 4245: 
 4246:       }
 4247: 
 4248:    }
 4249: 
