 2398: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2399: 
 2400: 
 2401: __device__ void Node::updateKb(void) {
 2402: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2403: 
 2404:    if constexpr(ivcor == 1) return;
 2405: 
 2406: 
 2407:    // Check if node is wet
 2408:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2409: 
 2410:    if (isDry) return;
 2411: 
 2412:    if constexpr(ivcor == 2) {  // SZ coordinates
 2413:       
 2414:       // Compute bottom level index
 2415:       if (depth <= mesh->h_s) {
 2416:          kb = mesh->kz - 1;
 2417:       } else {
 2418:          kb = -1;
 2419:          int L = 0;
 2420:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2421:          
 2422:          while (L <= R) {
 2423:             int M = (R + L) / 2;
 2424: 
 2425:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2426:             
 2427:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2428:                R = M;
 2429:             } else {
 2430:                L = M;
 2431:             }
 2432: 
 2433:             if (R - L == 1) {
 2434:                kb = L;
 2435:                break;
 2436:             }
 2437:          }
 2438:       }
 2439:    } 
 2440: }
 2441: 
 2442: 
 2443: __device__ double Node::compZCoord(int k) const {
 2444:    // Computes the z coordinate at level k.
 2445:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2446:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2447:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2448:    // used 
 2449:    
 2450:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2451:       
 2452:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2453: 
 2454:    if constexpr(ivcor == 2) {
 2455: 
 2456:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2457:       const int kz = mesh->kz;
 2458:       const double h_c = mesh->h_c;
 2459:       const double theta_f = mesh->theta_f;
 2460:       const double sinh_theta_f = mesh->sinh_theta_f;
 2461: 
 2462:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2463:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2464:       // once per time step/node.
 2465:       // CHECK: updateZCoordData
 2466: 
 2467:       if      (k == nvrt-1)      { return eta2; }
 2468:       else if (k == kz)          return -hmod2;
 2469:       else if (k == kb)          return -depth;
 2470:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2471:       else if (k > kz) {
 2472:          const int ksig = k - kz + 1;
 2473: 
 2474:          if (hmod2 <= h_c) {
 2475:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2476:          } 
 2477:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2478:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2479:             assert(false && "ZCOOR: invalid h_c\n");
 2480:          } 
 2481:          else {
 2482:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2483:                          h_c * mesh->sigma[ksig] + 
 2484:                          (hmod2 - h_c) * mesh->cs[ksig];
 2485:          }
 2486:       } else { 
 2487:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2488:       }
 2489: 
 2490:    }
 2491:    else if constexpr(ivcor == 1) {
 2492:       if (k == kb) return -depth;
 2493:       else if (k == nvrt-1) return eta2;
 2494:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2495:    }
 2496:    
 2497:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2498:    return 0.0;
 2499: }
 2500: 
 2501: 
 2502: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2503:                 double *node_coords, double *wind_rotate_angle, 
 2504:                 int *isdel, int *isidenode, int *isbnd,
 2505:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2506:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2507:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2508:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2509:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2510:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2511:                 double *emo, double *efa, 
 2512:                 double *umo, double *ufa, 
 2513:                 double *vmo, double *vfa) {
 2514: 
 2515:    printf("Populating mesh for partition %d\n", partNum);
 2516: 
 2517:    // Horizontal grid
 2518:    printf("Processing %d nodes\n", np);    
 2519: 
 2520: 
 2521:    int idxNodeBoundary = 0;  
 2522:    for (int i = 0; i < np; i++)
 2523:    {
 2524:       Node &node = localNodeData[i];
 2525: 
 2526:       node.idx = i;
 2527: 
 2528:       const int idxNodeStart = nodeNeighNodesStart[i];
 2529:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2530:       node.numNodes = idxNodeEnd - idxNodeStart;
 2531:       node.nodes = nodeNeighNodes + idxNodeStart;
 2532:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2533: 
 2534: 
 2535: 
 2536:       const int idxElemStart = nodeNeighElemsStart[i];
 2537:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2538:       node.numElements = idxElemEnd - idxElemStart;
 2539:       node.elements = nodeNeighElems + idxElemStart;
 2540: 
 2541: 
 2542:       
 2543:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2544:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2545:          const int partNode = localNodePart[idxNodeGlobal]; 
 2546:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2547: 
 2548: 
 2549:          Node *node_ptr = nodes[partNode] + idxNode;
 2550:          
 2551:          nodeNeighNodes[idx] = node_ptr;
 2552:       }
 2553: 
 2554:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2555:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2556:          const int partElem = localElemPart[idxElemGlobal];
 2557:          const int idxElem  = localElemIndices[idxElemGlobal];
 2558: 
 2559:          Element *elem_ptr = elems[partElem] + idxElem;
 2560: 
 2561:          nodeNeighElems[idx] = elem_ptr;
 2562:       }      
 2563: 
 2564: 
 2565:       node.wind_angle = wind_rotate_angle[i];
 2566: 
 2567:       // Element **elements; // pointer to the elements connected to this node
 2568:       // int numElements;   // number of elements shared by this node
 2569: 
 2570:       node.p.x   = node_coords[i * 3];
 2571:       node.p.y   = node_coords[i * 3 + 1];
 2572:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2573:       node.depth = node_coords[i * 3 + 2];
 2574: 
 2575:       node.numSides = 0;
 2576: 
 2577:       // Links the node to the boundary information
 2578:       if (isbnd[i] >= 0) {
 2579:        
 2580:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2581:          node.nodeBnd->node = &node;
 2582: 
 2583: 
 2584:          if (isbnd[i]>0) {
 2585: 
 2586:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2587:             node.nodeBnd->segment->ifltype = isbnd[i];
 2588: 
 2589:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2590:             node.nodeBnd->segment->clen  = nan("1");
 2591:             node.nodeBnd->segment->carea = nan("1");
 2592: 
 2593:          }
 2594:          else {
 2595:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2596:          }
 2597:          
 2598:          idxNodeBoundary++;
 2599:       }
 2600:       else {
 2601:          node.nodeBnd = nullptr;
 2602:       }
 2603: 
 2604:       // XXXX GAUSSIAN HILL VELOCITIES
 2605: #ifdef GAUSSIAN_HILL_VELOCITIES
 2606:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2607:          constexpr double rot_per = 3000.0;
 2608:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2609:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2610:       // XXXXX
 2611: #endif
 2612:    }
 2613: 
 2614:    nbp = idxNodeBoundary;
 2615: 
 2616:    printf("Processing %d sides\n", ns);
 2617:    int idxSideBoundary = 0;
 2618:    for (int i = 0; i < ns; i++)
 2619:    {
 2620:       Side &side = localSideData[i];
 2621:       side.idx = i;
 2622:       // finding the pointer to the nodes that form the side
 2623:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2624:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2625: 
 2626:       const int locidx_n1 = localNodeIndices[idx_n1];
 2627:       const int locidx_n2 = localNodeIndices[idx_n2];
 2628:       const int part_n1 =   localNodePart[idx_n1];
 2629:       const int part_n2 =   localNodePart[idx_n2];
 2630: 
 2631:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2632:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2633: 
 2634:       // Counts the number of sides connected to each node
 2635:       side.n1->numSides++;
 2636:       side.n2->numSides++;
 2637: 
 2638:       // Normal, unitary vector to the side
 2639:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2640:       side.n = normalize(side.n);
 2641: 
 2642:       // Side boundary type
 2643:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2644:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2645:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2646:       
 2647:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2648:       {
 2649:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2650:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2651:          else                  side.sideBnd->segment = n2bnd->segment;
 2652:          side.sideBnd->side = &side;
 2653:          idxSideBoundary++;
 2654:       }
 2655:       else side.sideBnd = nullptr;
 2656: 
 2657:       nbs = idxSideBoundary;
 2658: 
 2659:       // finding the pointer to the elements that share the side
 2660:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2661:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2662: 
 2663:       if (idx_e1 > -1) {
 2664:          const int locidx_e1 = localElemIndices[idx_e1];
 2665:          const int part_e1 =  localElemPart[idx_e1];
 2666:          side.elems[0] = elems[part_e1] + locidx_e1;
 2667:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2668:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2669:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2670:       }
 2671:       else {
 2672:          side.elems[0] = nullptr;
 2673:       }
 2674: 
 2675:       if (idx_e2 > -1) {
 2676:          const int locidx_e2 = localElemIndices[idx_e2];
 2677:          const int part_e2 =  localElemPart[idx_e2];
 2678:          side.elems[1] = elems[part_e2] + locidx_e2;
 2679:       }
 2680:       else {
 2681:          side.elems[1] = nullptr;
 2682:       }
 2683: 
 2684: 
 2685: 
 2686:       // Compute the center of the side
 2687:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2688: 
 2689: #ifdef GAUSSIAN_HILL_VELOCITIES
 2690: // XXXX
 2691: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2692: constexpr double rot_per=3000.0;
 2693: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2694: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2695: // XXXXX      
 2696: #endif
 2697:       // Compute the z level at the center of the side
 2698:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2699: 
 2700:       // Compute the length of the side
 2701:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2702:       side.length = sqrt(dot(vLen, vLen));
 2703: 
 2704:    }
 2705: 
 2706:    printf("Processing %d elements\n", ne);
 2707:    for (int i = 0; i < ne; i++)
 2708:    {
 2709:       Element &elem = localElemData[i];
 2710:       elem.idx = i;
 2711:       for (int j = 0; j < i34[i]; j++) {
 2712:          const int idxNode = elnode[i*4 + j];  
 2713:          const int idxSide = elside[i*4 + j];
 2714:          
 2715:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2716:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2717: 
 2718: 
 2719: 
 2720:          // Find the neighboring element  
 2721:          if (elem.sides[j]->elems[0] == &elem) {
 2722:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2723:          }
 2724:          else {
 2725:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2726:          }
 2727:          
 2728:       }
 2729: 
 2730:       elem.i34 = i34[i];
 2731: 
 2732: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2733: 
 2734:       // Compute the centroid of the element and its depth
 2735:       Vector2 center = {0.0, 0.0};
 2736:       elem.depth = 0.0;
 2737:       for (int j = 0; j < i34[i]; j++) {
 2738:          center += elem.nodes[j]->p2()/i34[i];
 2739:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2740:       }
 2741:       elem.center.x = center.x;
 2742:       elem.center.y = center.y;
 2743: 
 2744:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2745:       
 2746:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2747:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2748: 
 2749:       elem.area = elem.computeSignedArea(); 
 2750:       elem.radius = sqrt(elem.area)/pi; 
 2751:       
 2752:       // Determines which way the normal vector to each side is oriented.
 2753:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2754:       for (int j = 0; j < i34[i]; j++)  
 2755:       {
 2756:          if (elem.sides[j]->elems[0] == &elem) {
 2757:             elem.ssign[j] =  1.0;
 2758:          }
 2759:          else {
 2760:             elem.ssign[j] = -1.0;
 2761:          }
 2762: 
 2763:       }
 2764: 
 2765:       // Derivatives of shape functions
 2766:       //  For ics=2, this is done inside element/ll frame XXX
 2767:       //  For quads, the derivative is evaluated at centroid
 2768:       const int i34 = elem.i34;
 2769:       for (int j = 0; j < i34; j++) {
 2770:          const double area = elem.area;
 2771:          const int id2 = elem.nxq(1 + j);
 2772:          const int id3 = elem.nxq(2 + j);
 2773:          const int id4 = elem.nxq(3 + j);
 2774:          if (elem.isTri()) {
 2775:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2776:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2777:             // da1/dx = (y1 - y2)/(2*area)
 2778:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2779:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2780:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2781:          }
 2782:          else  { // Quad; evaluate at centroid
 2783:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2784:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2785:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2786:          } // if Tri
 2787: 
 2788:       } // for j
 2789: 
 2790:    }
 2791: 
 2792: 
 2793:    // Processing the boundary nodes
 2794:    int idx = 0;
 2795:    for (int iseg = 0; iseg < nope; iseg++) {
 2796:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2797: 
 2798:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2799: 
 2800:          nodeBnd->isEssentialBC = true;
 2801: nodeBnd->iettype = 3;
 2802:          nodeBnd->elbc = 0.0;
 2803: 
 2804:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2805:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2806:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2807:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2808:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2809:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2810:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2811: printf("nodeBnd->efa[%d] = %f, nodeBnd->emo[%d] = %f, nodeBnd->umo[%d] = %f, nodeBnd->ufa[%d] = %f, nodeBnd->vmo[%d] = %f, nodeBnd->vfa[%d] = %f\n", jfr, nodeBnd->efa[jfr], jfr, nodeBnd->emo[jfr], jfr, nodeBnd->umo[jfr], jfr, nodeBnd->ufa[jfr], jfr, nodeBnd->vmo[jfr], jfr, nodeBnd->vfa[jfr]);
 2812:          }
 2813: 
 2814:          idx++;
 2815:       }
 2816: 
 2817:    }
 2818: 
 2819: }
 2820: 
 2821: 
 2822: 
 2823: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2824:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2825:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2826:    // 
 2827:    // This kernel is called for all nodes.
 2828: 
 2829: 
 2830:    NODE(node1);
 2831: 
 2832: 
 2833:    node1->clearMatrixRow();
 2834:    node1->qel = 0.0;
 2835: 
 2836:    // THIS IS FOR STRUCTURES XXX
 2837:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2838: 
 2839:    
 2840:    for (int j=0; j<node1->numElements; j++) {
 2841:       // For each element connected to the node...
 2842: 
 2843:       Element *elem = node1->elements[j];
 2844: 
 2845:       // Compute the average gravity
 2846:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2847:       const double grav3 = elem->mean(&Node::grav2);
 2848: 
 2849:       // Look at the documentation for the description of the terms in the following integrals
 2850: 
 2851:       // Integral I_1 
 2852:       // \bar{\breve{H}} 
 2853:       const double hhatb = elem->mean(&Side::hhat);        
 2854: 
 2855: 
 2856:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2857: 
 2858:       const int id1 = elem->nodeLocalIdx(node1); 
 2859:       const double area = elem->area;
 2860: 
 2861:       if (elem->isTri()) {
 2862: 
 2863:          // To clarify the notation in this section: 
 2864:          //   i stands for the node under consideration (node1)
 2865:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2866:          const int id2 = elem->nxq(1 + id1);
 2867:          const int id3 = elem->nxq(2 + id1);
 2868:          Node *node2 = elem->nodes[id2];
 2869:          Node *node3 = elem->nodes[id3];
 2870: 
 2871:          const Point2 x1 = node1->p2();
 2872:          const Point2 x2 = node2->p2();
 2873:          const Point2 x3 = node3->p2();
 2874: 
 2875:          // integral of phi_i*phi_j
 2876:          const double ipp_ii = (1.0/6.0 )*area;
 2877:          const double ipp_ij = (1.0/12.0)*area;
 2878:          const double ipp_ik = (1.0/12.0)*area;
 2879: 
 2880:          // integral of [(grad phi_i) * (grad phi_j)]
 2881:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2882:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2883:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2884: 
 2885:          // Computes the different components of integral I_1 of each node with respect to node i.
 2886:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2887:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2888:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2889: 
 2890: if (j==node1->numElements-1) {
 2891: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2892: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2893: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2894: }
 2895: 
 2896:          node1->addToSparseMatrix(node1, I1_ii);
 2897:          node1->addToSparseMatrix(node2, I1_ij); 
 2898:          node1->addToSparseMatrix(node3, I1_ik);
 2899: 
 2900: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2901:      
 2902:       }
 2903:       else { // Quad
 2904:          // XXX IMPLEMENT THIS
 2905:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2906:       } 
 2907: 
 2908:  
 2909:       // Integral I_4
 2910:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2911:       // Where
 2912:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2913: 
 2914:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2915:       // of U over the element.
 2916:       Vector2 Umean = {0.0, 0.0};
 2917:       for (int m=0; m<elem->i34; m++) {      
 2918:          const Side *side = elem->sides[m];
 2919: 
 2920:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2921:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2922:       }
 2923:       Umean = Umean/elem->i34;
 2924: 
 2925:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2926: 
 2927:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2928:       const double I_4_1 = dot(gradPhi_1, Umean);
 2929: 
 2930:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2931:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2932:      
 2933:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2934: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2935: 
 2936:       // Additional terms 
 2937:       double vnorm = 0.0;
 2938:       if (imm == 2)  { // Pre-compute vnorm on the element
 2939:          Vector3 ubed;
 2940:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2941: 
 2942:          Vector3 gradP = {0.0, 0.0, 1.0};
 2943:          for (int m=0; m < elem->i34; m++) {
 2944:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2945:            gradP += toVector3(gradP_2D, 0.0);
 2946:          }   
 2947:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2948:       } // imm==2
 2949: 
 2950:       if (elem->isTri()) {
 2951:          for (int l=0; l<3; l++) {
 2952:            double fac;
 2953: 
 2954:            Node *node = elem->nodes[l];
 2955: 
 2956:            (node == node1)? fac=2.0 : fac=1.0;
 2957: 
 2958:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2959:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2960:            
 2961:          }
 2962: 
 2963: 
 2964:          if (!elem->isDry) {
 2965:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2966:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2967:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2968: 
 2969:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2970:          }
 2971: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2972: 
 2973:       } // isTri
 2974:       else { // isQuad
 2975:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2976:          // for (int l=0; l<4; l++) {
 2977:          //   const Node *node = elem->nodes[l];
 2978: 
 2979:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2980:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2981: 
 2982:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2983:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2984:          // }
 2985: 
 2986:       } // isQuad
 2987: 
 2988: 
 2989:       node1->qel += (dt/elem->i34)*elem->vsource;
 2990:       
 2991: 
 2992:    } // for all elements connected to the node
 2993:    
 2994: 
 2995: 
 2996:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2997:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2998:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2999:    if (nodeBnd != nullptr)  { 
 3000:       // If it is an open boundary node...
 3001: 
 3002:       // At least one open bnd side, maybe two
 3003:       for (int l=0; l<2; l++) { 
 3004: 
 3005:          // Gets each of the sides sharing the node. 
 3006:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3007: 
 3008:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3009: 
 3010:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3011: 
 3012: 
 3013:          if (sideBnd != nullptr) {
 3014:             // If the side is on a boundary...
 3015: 
 3016:             // Get the boundary segment
 3017:             const BoundarySegment *sideSegment = sideBnd->segment;
 3018:             const Side *side = sideBnd->side;
 3019: 
 3020:             // Integral I_3
 3021:             if (sideSegment->ifltype != 0) {
 3022:             // Natural or Flather b.c.
 3023: 
 3024:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3025:                // especially for Flather b.c.
 3026:                double ri3 = 0.0;
 3027:                if (!side->isDry) {
 3028:                   // If the side is not dry
 3029:                   
 3030:                   // Computes the side flux of (uth, vth)
 3031:                   double Vn = 0.0;
 3032:                   for (int k = side->kb; k<nvrt-1; k++) {
 3033:                      // uth, vth in lat/lon frame if ics=2
 3034:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3035:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 3036:                      const double vn2 = dot(side->uth[k+1], side->n);
 3037: 
 3038:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3039:                   }
 3040: 
 3041:                   ri3 = 0.5*side->length*Vn;
 3042:                }
 3043: 
 3044:                if (sideSegment->ifltype == -1) { // Flather 1
 3045: 
 3046:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3047:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3048: 
 3049:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 3050:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3051:                   
 3052:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3053:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3054: 
 3055:                } 
 3056:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3057:                   // Reset ri3
 3058:                   ri3 = 0.0;
 3059: 
 3060:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3061: 
 3062:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3063: 
 3064:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3065:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3066: 
 3067:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 3068:                   node1->addToSparseMatrix(node1, con0*2.0);
 3069:                   node1->addToSparseMatrix(node2, con0);
 3070: 
 3071:                } // if Flather or Discharge
 3072: 
 3073:                node1->qel -= thetai*dt*ri3;
 3074: 
 3075:             } // I_3
 3076:           
 3077: 
 3078:             // Integral I_5
 3079:             if(!side->isDry) {
 3080: 
 3081:                const double Unbar = dot(side->U, side->n);
 3082: 
 3083:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 3084:                
 3085:             } // I_5
 3086: 
 3087:          } // if is boundary side
 3088: 
 3089:       } // for l
 3090: 
 3091:    } // if isbnd
 3092: 
 3093: 
 3094:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3095: 
 3096: }
 3097: 
