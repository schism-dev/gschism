 7938: extern "C"
 7939:                                  
 7940:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7941:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7942:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7943:                    int *isdel, int *isidenode, int *isbnd,
 7944:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7945:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7946:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7947:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7948:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7949:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7950:                    double *drag, double *roughness,
 7951:                    double *emo, double *efa, 
 7952:                    double *umo, double *ufa, 
 7953:                    double *vmo, double *vfa) {
 7954: 
 7955:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7956:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 7957:                        isdel, isidenode, isbnd,
 7958:                        nond, nlnd, iond, ilnd, 
 7959:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7960:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7961:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7962:                        localNodeIndices, localElemIndices, localSideIndices,
 7963:                        localNodePart, localElemPart, localSidePart,
 7964:                        drag, roughness,
 7965:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 7966:   }
