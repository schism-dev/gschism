 2670: 
 2671: //       const Side& side = sides[i];
 2672: 
 2673: //       xIntersect=-1.e25;
 2674: //       yIntersect=-1.e25;
 2675: 
 2676: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2677: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2678: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2679: 
 2680: //       if (delta != 0.0) {
 2681: //          // Solves the two linear equations for tt1 and tt2
 2682: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2683: //          const double tt2 = delta2/delta;
 2684: 
 2685: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2686: //          // Similarly, we use tt2 to compute the intersection point.
 2687: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2688: //             xIntersect = x3 + (x4 - x3)*tt2;
