 1348: // This struct is used to store the boundary information for a node.
 1349: struct NodeBoundary {   
 1350:    int idx;
 1351:    BoundarySegment *segment;
 1352:    Node *node;
 1353:    
 1354:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1355:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1356: 
 1357:    bool isLand;
 1358: 
 1359:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1360:    double elbc;   // Elevation boundary condition
 1361:    double eth;    // Elevation time history
 1362: 
 1363:    double eta_mean; // Mean elevation at nodes
 1364: 
 1365:    bool isEssentialBC;
 1366: 
 1367:    Vector2 uth[nvrt];  // "Time history" velocity
 1368: 
 1369:    // Arrays for harmonic constituents (if needed)
 1370:    double  emo[nbfr];  // Elevation amplitude
 1371:    double  efa[nbfr];  // Elevation phase
 1372:    Vector2 umo[nbfr];  // velocity amplitude
 1373:    Vector2 ufa[nbfr];  // velocity phase
 1374: 
 1375: 
 1376:    NodeBoundary(void) {
 1377:       isLand = false;
 1378:    }
 1379:    NodeBoundary(bool _isLand) {
 1380:       isLand = _isLand;
 1381:    }
 1382: 
 1383:    
 1384:    __forceinline__ __device__ int numSidesForAverage() const {
 1385:    // Returns the number of sides that are connected to the node and have the same segment.
 1386:    // This is used to compute the average velocity at the node for open boundary nodes.
 1387:       int res = 0;
 1388:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1389:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1390: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1391:       return res;
 1392:    }
 1393: 
 1394: 
 1395:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1396:       assert(index == 0 || index == 1); 
 1397:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1398:    }
 1399: 
 1400:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1401:       if (isLand) return;  // land never uses these links
 1402: 
 1403:       SideBoundary *nullSideBoundary = nullptr;
 1404:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1405: 
 1406:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1407:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1408: 
 1409:       // both slots taken. OK if this side was already linked
 1410:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1411:    }
 1412: 
 1413: 
 1414: };
 1415: 
 1416: struct Node {
 1417: 
 1418:    // Geometry information
 1419:    int idx;            // Global index of the node
 1420:    int16_t part;       // Partition of the node
 1421: 
 1422:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1423:    int16_t numNodes;   // Number of nodes neighbors of this node
 1424: 
 1425:    Element **elements; // Array of pointers to the elements that share this node
 1426:    int16_t numElements;// Number of elements that share this node
 1427: 
 1428:    int16_t numSides;   // Number of sides that are connected to this node
 1429: 
 1430: 
 1431:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1432:    double gz;          // Global vertical coordinate at the node.
 1433:    Vector2 u2[nvrt];
 1434:    double  w2[nvrt];
 1435:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1436:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1437:    double lon, lat;
 1438:    double depth;
 1439: 
 1440:    Frame<ics> frame;
 1441: 
 1442:    LocalSigma<ivcor> localSigma;  
 1443: 
 1444:    int16_t kb;     // Bottom index of the node
 1445: 
 1446:    bool isDry;     // True if the node is dry
 1447: 
 1448:    int16_t iadv;   // Advection flag
 1449: 
 1450:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1451:                           // this is nullptr
 1452: 
 1453:    TempVar tmp; // Temporary variable to store different types of variables
 1454: 
 1455:    // Physical information
 1456:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1457:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1458: 
 1459:    double rho[nvrt];     // Density
 1460:    double dfv[nvrt];     // Vertical viscosity
 1461: 
 1462:    double eta1; // Elevation at nodes at previous timestep
 1463:    double eta2; // Elevation at nodes at current timestep
 1464: 
 1465:    double ETP;  // Earth Tidal Potential
 1466: 
 1467:    double pr;    // Air pressure
 1468:    double grav2; // Gravity 
 1469:    
 1470:    Vector2 dav;  // Depth averaged velocity
 1471: 
 1472:    Vector2 tau; // Wind stress vector
 1473: 
 1474:    // Vegetation parameters
 1475:    double veg_h;
 1476:    double veg_nv;
 1477:    double veg_di;
 1478:    double veg_Cd;
 1479:    double veg_h_unbent;
 1480:    double veg_di_unbent;
 1481:    double veg_nv_unbent;
 1482:    double veg_alpha_vert_mean;
 1483:    double veg_alpha0;
 1484:    double veg_alpha3D[nvrt];
 1485: 
 1486:    // Bottom drag parameters
 1487:    double Cd;       // Bottom drag coefficient   
 1488: 
 1489:    // These three are mutually exclusive
 1490:    union {
 1491:       double rmanning; // Bottom Manning's coefficient
 1492:       double rough;    // Bottom roughness length
 1493:       double drag;     // Bottom drag coefficient
 1494:    };
 1495:    Vector2 tau_bot; // Bottom stress vector
 1496: 
 1497:    // XXXX REMOVE FOR IMM>0???
 1498:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1499:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1500: 
 1501:    
 1502:    double qel; // RHS
 1503:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1504:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1505:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1506:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1507: 
 1508:    double mX; // Solution of the FEM system
 1509: 
 1510:    // Meteorological forcing
 1511:    Vector2 u_air;
 1512:    double p_air;  // XXXX is this the same as pr?
 1513:    double t_air;
 1514:    double q_air;
 1515:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1516: 
 1517: 
 1518: 
 1519:    __device__ __forceinline__ int localIndex() const;
 1520:    __device__ __forceinline__ int packedIndex() const;
 1521: 
 1522: 
 1523:    __device__ void setWind(Vector2 &u) {
 1524:    // Sets the wind vector taking into account the mesh angle
 1525:    
 1526:       const double speed = length(u);
 1527: 
 1528:       // Rotate wind vector to the node frame
 1529:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1530: 
 1531:       // Sets the surface stress vector due to wind.
 1532:       if constexpr(nws == 0) {
 1533:          tau = {0.0, 0.0};
 1534: 
 1535:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1536:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1537: 
 1538:       } else {
 1539: 
 1540:          double dragcoef;
 1541: 
 1542:          if constexpr(iwind_form == -1) {
 1543:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1544:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1545: 
 1546:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1547:             tau = cff*u_air;
 1548:  
 1549:          } else if constexpr(iwind_form == 1) {
 1550:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1551:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1552: 
 1553:             dragcoef = max(dragcoef, 4.0e-4);
 1554:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1555:             tau = cff*u_air;
 1556: 
 1557:          } else {
 1558:             tau = {0.0, 0.0};
 1559:          }
 1560:       }
 1561:    }
 1562: 
 1563: 
 1564:    __device__ void setFrame(double lat, double lon) {
 1565:       if constexpr(ics == 1) return;
 1566: 
 1567:       frame.update(lat, lon);        
 1568:     }
 1569: 
 1570:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1571: 
 1572:    __device__ double sigmaTransitionDepth(void) const;
 1573: 
 1574:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1575: 
 1576:    __inline__ __device__ Point2 outputCoords(void) const {
 1577:       if constexpr(ics == 1)  return p;
 1578:       else                    return {rad2deg*lon, rad2deg*lat};
 1579:    }
 1580: 
 1581:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1582:    // If ics == 2, convert the global point to the local frame
 1583:       
 1584:       if constexpr (ics == 1) {
 1585:          return p;
 1586:       } else {
 1587:          const Point3 c = {p.x, p.y, gz};
 1588:          const Point3 local = frame.G2L(p - c);
 1589:          return local;
 1590:       }
 1591:    }
 1592: 
 1593:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1594:    // If ics == 2, convert the global point to the local frame
 1595:       
 1596:       if constexpr (ics == 1) {
 1597:          return p;
 1598:       } else {
 1599:          const Point3 c = {p.x, p.y, gz};
 1600:          return c + frame.L2G(p);
 1601:       }
 1602:    }
 1603: 
 1604:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1605:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1606:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1607:    
 1608:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1609: 
 1610:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1611: 
 1612:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1613:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1614: 
 1615:    __device__ __forceinline__ void clearMatrixRow(void) {
 1616:       // Clear the matrix row for this node
 1617: 
 1618:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1619: 
 1620:    }
 1621: 
 1622:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1623:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1624:       
 1625:       if (node == this) {
 1626:          *coeffDiag += value;
 1627:          return;
 1628:       }
 1629: 
 1630:       int i;
 1631:       for (i = 0; i < numNodes; i++) {
 1632:          if (nodes[i] == node) break;
 1633:       }
 1634: 
 1635:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1636:       coeffRow[csrSlot[i]] += value;
 1637:    }
 1638: 
 1639: 
 1640:    __device__ __inline__ void updateZCoordData(void);
 1641: 
 1642:    __device__ __forceinline__ double compZCoord(int k) const;
 1643: 
 1644:    __device__ void updateKb(void);
 1645: 
 1646:    __device__ __forceinline__ void computeBottomDragCd(void);
 1647: 
 1648: 
 1649: 
