 2259: // Convenience macros for accessing the objects in kernels.
 2260: 
 2261: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 2262:                    Side *side = &(mesh->localSideData[idx_side]); \
 2263:                    if (idx_side >= mesh->ns) return;
 2264: 
 2265: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 2266:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 2267:                    if (idx_elem >= mesh->ne) return;
 2268: 
 2269: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 2270:                    Node *node = &(mesh->localNodeData[idx_node]); \
 2271:                    if (idx_node >= mesh->np) return;
 2272: 
 2273: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 2274:                               Node *node = &(mesh->localNodeData[idx_node]); \
 2275:                               const bool valid = (idx_node < mesh->np);                   
 2276: 
 2277: 
 2278: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2279:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 2280:                            if (idx_node_bnd >= mesh->nbp) return;
 2281: 
 2282: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2283:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2284:                            if (idx_side_bnd >= mesh->nbs) return;  
