 1599: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1600:    // Lock the mutex
 1601:    lock(&debugPlotMutex);
 1602:  
 1603:    if (debugPlotIdx == nullptr) return;
 1604:    if (*debugPlotIdx >= 10000) return;
 1605: // printf("addDebugPlot 2, x1 = (%f, %f), x2 = (%f, %f)\n", x1.x, x1.y, x2.x, x2.y);   
 1606:    debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1607:    debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1608:    debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1609:    debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1610:    debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1611:    (*debugPlotIdx)++;
 1612:    // Unlock the mutex
 1613:    unlock(&debugPlotMutex);
 1614: 
 1615: }
