 1069: 
 1070:    __device__ __forceinline__ void computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 1071:                                                     Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const;
