 2645:    template<typename T>
 2646:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2647:       T values[4];
 2648:       getNodalValues(field, values);
 2649: 
 2650:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2651:       if constexpr (IsVector2<T>::value && ics == 2) {
 2652: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2653:          projectNodeVectorsToElementFrame(values);
 2654: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2655:       }
 2656: 
 2657:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2658:    }
 2659: 
 2660:    template<typename T>
 2661:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2662:       T values[4];
 2663:       getSideValues(field, values);
 2664:       
 2665:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2666:       if constexpr (IsVector2<T>::value && ics == 2) {
 2667: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2668:          projectSideVectorsToElementFrame(values);
 2669: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2670:       }
 2671: 
 2672:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2673:    }   
 2674: 
 2675:    template<typename T>
 2676:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2677: 
 2678:       T values[4];
 2679: 
 2680: 
 2681:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2682:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2683:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2684:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2685:       else          values[3] = T();
 2686: 
 2687:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2688: 
 2689:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2690:    }
