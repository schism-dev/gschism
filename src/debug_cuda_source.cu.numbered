 5279:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5280: 
 5281:       NODE_BND(nodeBnd);
 5282: 
 5283:       Node *node = nodeBnd->node;
 5284: 
 5285:       node->ETP = 0.0;
 5286: 
 5287:       // For all tidal potential components
 5288:       for (int j=0; j<ntip; j++) {
 5289: 
 5290:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5291: 
 5292:          node->ETP += nodeETP;
 5293: 
 5294:          if constexpr(iloadtide==1) { // loading tide
 5295:             assert(false && "Loading tide not implemented");
 5296:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5297:          }
 5298:          
 5299:       }
 5300: 
 5301:      
 5302:    }
