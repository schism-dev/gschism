 3810: 
 3811: __device__ __forceinline__ int Node::packedIndex() const {
 3812:    // Returns the packed index of the node
 3813:    // Packed index is the index of the partition-block matrices and vectors.
 3814:    return nodeOffsetPerPartition[part] + localIndex();
 3815: }
