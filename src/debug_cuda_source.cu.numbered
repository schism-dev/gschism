 3918: 
 3919: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3920:    // Computes the z coordinate at level k.
 3921:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3922:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3923:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3924:    // used 
 3925: 
 3926:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3927:    
 3928:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3929: 
 3930:    if (isDry2()) return 0.0;  
 3931: 
 3932:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3933: 
 3934:    if constexpr(ivcor == 2) {
 3935: 
 3936:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3937:       const double h_c = mesh->h_c;
 3938:       const double theta_f = mesh->theta_f;
 3939:       const double sinh_theta_f = mesh->sinh_theta_f;
 3940: 
 3941: 
 3942:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3943:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3944:       // once per time step/node. XXXX
 3945:       // CHECK: updateZCoordData
 3946: 
 3947:       //  To simplify comparisons, I define index versions of count variables.
 3948:       if      (k == ivrt)     return eta2; 
 3949:       else if (k == izlev)    return -hmod2;
 3950:       else if (k == kb)       return -depth;
 3951:       else if (k < izlev)     return mesh->ztot[k];
 3952:       else if (k > izlev) {
 3953:          const int ksig = k - izlev;
 3954: 
 3955:          if (hmod2 <= h_c) {
 3956:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3957: 
 3958:          } 
 3959:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3960:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3961:             assert(false && "compZCoord: invalid h_c\n");
 3962:          } 
 3963:          else {
 3964:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3965:                    h_c * mesh->sigma[ksig] + 
 3966:                    (hmod2 - h_c) * mesh->cs[ksig];
 3967:          }
 3968:       } else { 
 3969:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3970:       }
 3971: 
 3972:    }
 3973:    else {  // if constexpr(ivcor == 1)
 3974:       if (k <= kb)        return -depth; 
 3975:       else if (k == ivrt) return eta2;
 3976:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3977: 
 3978:    }
 3979:    
 3980:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3981:    return 0.0;
 3982: }
 3983: 
 3984: 
 3985: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3986:    // Computes the bottom drag Cd based on the selected nchi
 3987: 
 3988:    if constexpr(nchi == 0) {
 3989:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3990:       Cd = drag;  // Read from drag file
 3991: 
 3992:    } else if constexpr(nchi == 1) {
 3993:       // 
 3994: 
 3995:       bool ltmp = false; // for WBL iteration
 3996: 
 3997:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3998:       if (isDry || (rough == 0.0)) {
 3999:          Cd = 0.0;
 4000: 
 4001:       } else { //roughness >0 
 4002:          
 4003:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4004: 
 4005:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4006: 
 4007:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4008: 
 4009:       } // if rough
 4010: 
 4011:    } else if constexpr(nchi == -1) {
 4012:    // Manning 
 4013:  
 4014:       const double htot = max(hmin_man, htot2()); 
 4015:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4016: 
 4017:    } else {
 4018:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4019:       
 4020:    } // if nchi
 4021: 
 4022: }
 4023: 
 4024: 
 4025: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4026:    // Checks if a side in on the boundary
 4027:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4028: 
 4029:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4030:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4031: 
 4032:    // Indices of the nodes that form the side
 4033:    //
 4034:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4035:    const int n1 = side.n1->idx;
 4036:    const int n2 = side.n2->idx;
 4037:    isLand = false;
 4038:    
 4039: 
 4040:    // Check if the side is on a land boundary
 4041:    for (int i = 0; i < nland; i++) {
 4042:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4043:          // Consecutive nodes in the land boundary segment
 4044:          const int b1 = ilnd[i + j*nland];
 4045:          const int b2 = ilnd[i + (j + 1)*nland];
 4046: 
 4047:          assert(b1 != -1 && b2 != -1);
 4048: 
 4049:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4050:             
 4051:             isLand = true;
 4052:             return i;
 4053:          }
 4054:       }
 4055:    }
 4056: 
 4057:    // Check if the side is on an open boundary
 4058:    for (int i = 0; i < nope; i++) {
 4059:       for (int j = 0; j < nond[i] - 1; j++) {
 4060:          // Consecutive nodes in the open boundary segment
 4061:          const int b1 = iond[i + j*nope];
 4062:          const int b2 = iond[i + (j + 1)*nope];
 4063: 
 4064:          assert(b1 != -1 && b2 != -1);
 4065: 
 4066:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4067:             isLand = false;
 4068:             return i;
 4069:          }
 4070:       }
 4071:    }
 4072: 
 4073:    // Check that the nodes are not both on the boundary
 4074:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 4075:         && "side not in ilnd/iond but both nodes are boundary" );
 4076: 
 4077:    return -1;
 4078: }
 4079: 
 4080: 
 4081: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4082:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4083:                                     double *wind_rotate_angle, 
 4084:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4085:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4086:                                     int16_t *nodePermutationSort, double *crs_data,
 4087:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4088:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4089:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4090:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4091:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 4092: 
 4093:    NODE(pnode);  
 4094:    const int i = idx_node;
 4095:    const int iglobal = globalNodeIndices[i];
 4096:    Node &node(*pnode);
 4097: 
 4098:    node.idx = iglobal;
 4099:    node.part = localNodePart[iglobal];
 4100: 
 4101:    // It is important to differentiate between the global and local "start" indices because they
 4102:    // play different, but related, roles in this code. The global "start" indices are used
 4103:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4104:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4105:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4106:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4107:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4108:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4109:    node.numNodes = idxNodeEnd - idxNodeStart;
 4110:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4111: 
 4112:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4113:    node.coeffRow = crs_data + rowStart; 
 4114: 
 4115:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4116: 
 4117: 
 4118: 
 4119:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4120:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4121:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4122:    node.numElements = idxElemEnd - idxElemStart;
 4123:    node.elements = nodeNeighElems + idxElemLocalStart;
 4124: 
 4125: 
 4126:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4127:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4128:       const int partNode = localNodePart[idxNodeGlobal]; 
 4129:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4130: 
 4131:       Node *node_ptr = nodes[partNode] + idxNode;
 4132:       
 4133:       nodeNeighNodes[idxLocal] = node_ptr;
 4134:    }
 4135: 
 4136: 
 4137:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4138:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4139:       const int partElem = localElemPart[idxElemGlobal];
 4140:       const int idxElem  = localElemIndices[idxElemGlobal];
 4141: 
 4142:       Element *elem_ptr = elems[partElem] + idxElem;
 4143: 
 4144:       nodeNeighElems[idxLocal] = elem_ptr;
 4145:    }      
 4146: 
 4147:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4148:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4149: 
 4150:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4151: 
 4152:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4153:    if constexpr(ics == 1) {
 4154:       node.p.x   = node_coords[i * 3];
 4155:       node.p.y   = node_coords[i * 3 + 1];
 4156:       node.gz = 0.0;
 4157: 
 4158:       if (use_ll) {                                    // <-- add
 4159:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4160:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4161:       }  
 4162: 
 4163:    } else {
 4164:       const double lon = deg2rad*node_coords[i * 3];
 4165:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4166: 
 4167:       Point3 p = computeXYZfromLatLon(lat, lon);
 4168:       node.p = toVector2(p);
 4169:       node.gz = p.z;
 4170:       node.lon = lon;
 4171:       node.lat = lat;
 4172: 
 4173:       #ifdef USE_FRAMES
 4174:       node.setFrame(lat, lon);
 4175:       #endif
 4176: 
 4177: 
 4178:    }
 4179: 
 4180:    node.depth = node_coords[i * 3 + 2];
 4181: 
 4182:    node.numSides = 0;
 4183: 
 4184:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4185:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4186:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4187:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4188:    else assert(false && "populateNodes: selected nchi not implemented.");
 4189: 
 4190:    if constexpr(ivcor == 1) 
 4191:    {  
 4192:       node.kb = kb[iglobal];
 4193: 
 4194:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4195:    }
 4196: 
 4197:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4198:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4199:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4200:    for (int k = 0; k < nvrt; k++) node.dfh[k] = dfh0;   // XXXX (does it need to exist when transport is not enabled?)
 4201: 
 4202:    
 4203:    // Links the node to the boundary information
 4204:    if (isbnd[iglobal] >= 0) {
 4205:      
 4206:       // Get the index of the node boundary
 4207:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4208: 
 4209:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4210:       node.nodeBnd->node = &node;
 4211: 
 4212:       node.nodeBnd->sideBnd1 = nullptr;
 4213:       node.nodeBnd->sideBnd2 = nullptr;
 4214: 
 4215:       if (isbnd[iglobal]>=0) {
 4216: 
 4217:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4218:          
 4219:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4220:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4221: 
 4222:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4223:          node.nodeBnd->segment->clen  = nan("1");
 4224:          node.nodeBnd->segment->carea = nan("1");
 4225: 
 4226:       }
 4227:    } else {
 4228: 
 4229:       node.nodeBnd = nullptr; // For internal nodes
 4230: 
 4231:       if (isbnd[iglobal] == landSegment) {
 4232:          node.nodeBnd = landBoundaryNode;
 4233:          node.nodeBnd->segment = landBoundarySegment;
 4234:       }
 4235:       
 4236:    }
 4237:    
 4238:    // XXXX GAUSSIAN HILL VELOCITIES
 4239:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4240:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4241:          constexpr double rot_per = 3000.0;
 4242:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4243:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4244:       // XXXXX
 4245:    #endif
 4246: 
 4247: }
 4248: 
 4249: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4250:    
 4251:    NODE(node);
 4252:    const int localIdx = idx_node;
 4253: 
 4254: 
 4255:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4256:    int16_t *csrSlot = node->csrSlot;  
 4257: 
 4258:    // Simply count the number of nodes with a smaller global index than the current node.
 4259:    // It accounts for the diagonal element.
 4260:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4261:    // local index, but taking into account all the partitions (in order).
 4262:    for (int i = 0; i < node->numNodes; ++i) {
 4263:       const int col = node->nodes[i]->packedIndex();
 4264:       int16_t idx = 0;
 4265: 
 4266:       //Takes care of the diagonal element.
 4267:       if (node->packedIndex() < col) ++idx;          
 4268: 
 4269:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4270:       csrSlot[i] = idx;
 4271:    }
 4272: 
 4273:    // Find the diagonal element in the CRS matrix.
 4274:    int16_t idxDiag = 0;
 4275:    for (int j = 0; j < node->numNodes; ++j)
 4276:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4277: 
 4278:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4279: 
 4280:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4281:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4282: 
 4283:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4284:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4285:    crs_indptr[localIdx] = rowStart;
 4286: 
 4287:    // Fills crs_indices array using the per-partition indexing.
 4288:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4289:    crs_indices[rowStart + d] = node->packedIndex();  
 4290:    for (int j = 0; j < node->numNodes; ++j) {
 4291:       Node *nb = node->nodes[j];
 4292:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4293:    }
 4294: 
 4295: 
 4296: }
 4297: 
 4298: 
 4299: 
 4300: 
 4301: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4302:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4303:                                     double *wind_rotate_angle,   
 4304:                                     int *isdel, int *isidenode, int *isbnd,
 4305:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4306:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4307:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4308:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4309:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4310:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4311:                                     double *drag, double *roughness) {
 4312: 
 4313: 
 4314:    SIDE(pside);
 4315:    Side &side(*pside);
 4316:    const int i = idx_side;
 4317:    const int iglobal = globalSideIndices[i];
 4318:    side.idx = iglobal;  
 4319:    
 4320:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4321:    const double fc   = 2.0*omega_e*sin(sfea0);
 4322:    const double beta = 2.0*omega_e*cos(sfea0);
 4323: 
 4324:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4325: 
 4326:    // finding the pointer to the nodes that form the side
 4327:    const int idx_n1 = isidenode[iglobal*2];
 4328:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4329: 
 4330: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4331: 
 4332:    const int locidx_n1 = localNodeIndices[idx_n1];
 4333:    const int locidx_n2 = localNodeIndices[idx_n2];
 4334:    const int part_n1 =   localNodePart[idx_n1];
 4335:    const int part_n2 =   localNodePart[idx_n2];
 4336: 
 4337: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4338: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4339: 
 4340:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4341:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4342: 
 4343: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4344: 
 4345:    // Counts the number of sides connected to each node
 4346:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4347:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4348: 
 4349:    // Side boundary type
 4350:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4351:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4352: // if (i == 0) printf("populateSides: 2\n");
 4353: 
 4354:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4355:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4356:    {
 4357:       bool isLand = false;
 4358:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4359:       
 4360:       if (isbs > -1) {
 4361:          // assert(isLand || isbs>=0);
 4362:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4363: 
 4364:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4365: 
 4366:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4367:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4368: 
 4369:          assert (isLand == side.sideBnd->segment->isLand);
 4370:          
 4371:          side.sideBnd->side = &side;
 4372: 
 4373:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4374:          n1bnd->linkSideBoundary(side.sideBnd);
 4375:          n2bnd->linkSideBoundary(side.sideBnd);
 4376: 
 4377:       }
 4378:       else {
 4379:          side.sideBnd = nullptr;
 4380:       }
 4381:    }
 4382:    else 
 4383:    {
 4384:       side.sideBnd = nullptr;
 4385:    }
 4386: 
 4387: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4388: 
 4389:    // finding the pointer to the elements that share the side
 4390:    const int idx_e1 = isdel[iglobal*2];
 4391:    const int idx_e2 = isdel[iglobal*2 + 1];
 4392: 
 4393:    if (idx_e1 > -1) {
 4394:       const int locidx_e1 = localElemIndices[idx_e1];
 4395:       const int part_e1 =  localElemPart[idx_e1];
 4396:       side.elems[0] = elems[part_e1] + locidx_e1;
 4397: 
 4398:    }
 4399:    else {
 4400:       side.elems[0] = nullptr;
 4401:    }
 4402: 
 4403: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4404: 
 4405:    if (idx_e2 > -1) {
 4406:       const int locidx_e2 = localElemIndices[idx_e2];
 4407:       const int part_e2 =  localElemPart[idx_e2];
 4408:       side.elems[1] = elems[part_e2] + locidx_e2;
 4409:    }
 4410:    else {
 4411:       side.elems[1] = nullptr;
 4412:    }
 4413: 
 4414: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4415: 
 4416:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4417:       
 4418:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4419:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4420:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4421:          
 4422:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4423:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4424:       // printf("sideBnd: %p\n", side.sideBnd);
 4425:       // assert(false && "Side has no elements and no boundary");
 4426:    }
 4427:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4428: 
 4429:    // Compute the center of the side
 4430:    side.center = 0.5*(side.n1->p + side.n2->p);
 4431: 
 4432:    #ifdef USE_FRAMES
 4433:    side.setFrame();
 4434:    #endif
 4435: 
 4436: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4437: 
 4438:    // Normal, unitary vector to the side
 4439:    if constexpr(ics == 1) {
 4440:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4441:       side.n = normalize(side.n);
 4442:    }
 4443:    else {
 4444:       // Unit side vector in 3D cartesian coordinates
 4445:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4446: 
 4447:       nSide = normalize(nSide);
 4448: 
 4449:       // Its cross product with the unit local z-axis vector (nUp) is the
 4450:       // normal vector we are looking for.
 4451:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4452: 
 4453:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4454:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4455:       side.n = -normalize(n2D); 
 4456: 
 4457:    }
 4458: 
 4459: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4460: 
 4461:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4462:    side.shapiro = shapiro0;
 4463: 
 4464:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4465:    // XXXX
 4466:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4467:    constexpr double rot_per=3000.0;
 4468:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4469:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4470:    // XXXXX      
 4471:    #endif
 4472:    // Compute the z level at the center of the side
 4473:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4474:    
 4475:    // Compute the length of the side
 4476:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4477: 
 4478: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4479: 
 4480:    // Compute the Coriolis coefficient
 4481: 
 4482:    if constexpr(ncor == -1 || ncor == 0) {
 4483:       side.coriolis = coricoef;
 4484:    }
 4485:    else {
 4486:       const double sphi = side.lat();  // Latitude at the center of the side
 4487: 
 4488:       assert(use_ll && "use_ll must be true when ncor > 0");
 4489: 
 4490:       if constexpr(ics == 1) {
 4491:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4492:       }
 4493:       else { // ics == 2
 4494:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4495:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4496:       }
 4497: 
 4498:    }
 4499: 
 4500: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4501: 
 4502: }
 4503: 
 4504: 
 4505: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4506:    double *node_coords, double *node_coords_ll, bool use_ll,
 4507:    double *wind_rotate_angle,   
 4508:    int *isdel, int *isidenode, int *isbnd,
 4509:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4510:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4511:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4512:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4513:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4514:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4515:    double *drag, double *roughness) {
 4516: 
 4517:    ELEM(pelem);
 4518:    Element &elem(*pelem);
 4519:    const int i = idx_elem;
 4520: 
 4521:    elem.idx = i;
 4522: 
 4523:    for (int j = 0; j < i34[i]; j++) {
 4524:       const int idxNode = elnode[i*4 + j];  
 4525:       const int idxSide = elside[i*4 + j];
 4526:       
 4527:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4528:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4529: 
 4530:       // Find the neighboring element  
 4531:       if (elem.sides[j]->elems[0] == &elem) {
 4532:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4533:       }
 4534:       else {
 4535:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4536:       }
 4537:       
 4538:    }
 4539: 
 4540:    elem.i34 = i34[i];
 4541: 
 4542:    // Compute the barycenter of the element and its depth
 4543:    elem.center = {0.0, 0.0};
 4544:    elem.depth = 1e10;
 4545:    for (int j = 0; j < i34[i]; j++) {
 4546: 
 4547:       elem.center += elem.nodes[j]->p/i34[i];
 4548:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4549:    }
 4550: 
 4551:    #ifdef USE_FRAMES
 4552:    elem.setFrame();
 4553:    #endif
 4554: 
 4555:    elem.area = elem.computeSignedArea(); 
 4556:    elem.radius = sqrt(elem.area)/pi; 
 4557:    
 4558:    // Determines which way the normal vector to each side is oriented.
 4559:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4560:    for (int j = 0; j < i34[i]; j++)  
 4561:    {
 4562:       if (elem.sides[j]->elems[0] == &elem) {
 4563:          elem.ssign[j] =  1.0;
 4564:       }
 4565:       else {
 4566:          elem.ssign[j] = -1.0;
 4567:       }
 4568: 
 4569:    }
 4570: 
 4571:   
 4572: 
 4573:    // Derivatives of shape functions
 4574:    //  For ics=2, this is done in the element frame
 4575:    //  For quads, the derivative is evaluated at centroid
 4576:    for (int j = 0; j < elem.i34; j++) {
 4577:       const double area = elem.area;
 4578:       const int id2 = elem.nxq(1 + j);
 4579:       const int id3 = elem.nxq(2 + j);
 4580:       const int id4 = elem.nxq(3 + j);
 4581:       if (elem.isTri()) {
 4582:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4583:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4584:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4585:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4586:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4587:          // And so on for the other shape functions.
 4588: 
 4589:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4590:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4591:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4592: 
 4593:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4594:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4595: 
 4596:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4597: 
 4598:       }
 4599:       else  { // Quad, the derivatives are evaluated at the centroid
 4600: 
 4601:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4602:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4603:          // ...
 4604:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4605: 
 4606:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4607:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4608:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4609: 
 4610:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4611:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4612: 
 4613:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4614: 
 4615:       } // if Tri/Quad
 4616: 
 4617:    } // for j   
 4618:    
 4619:    
 4620: 
 4621: }
 4622: 
 4623: 
 4624: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4625:                                             double *emo, double *efa, 
 4626:                                             double *umo, double *ufa, 
 4627:                                             double *vmo, double *vfa,
 4628:                                             int *ifltype, int *iettype) {
 4629: 
 4630:    NODE_BND(nodeBnd);
 4631:    const int idx = idx_node_bnd;    
 4632: 
 4633:    nodeBnd->idx = idx;
 4634: 
 4635:    // Need to find the segment index and the index of the node on the segment
 4636:    int idxNode = -1;
 4637:    int iseg, i;
 4638:    for (iseg = 0; iseg < nope; iseg++) {
 4639:       // for each segment...
 4640:       for (i = 0; i < nond[iseg]; i++) {
 4641:          idxNode = iond[iseg + i*nope];
 4642:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4643:          
 4644:       }
 4645:    }
 4646: 
 4647:    assert(iseg < nope && "iseg is out of bounds");
 4648: 
 4649: found: // Jumped here when the node was found
 4650: 
 4651:    nodeBnd->isEssentialBC = true;
 4652:    nodeBnd->elbc = 0.0;
 4653: 
 4654:    nodeBnd->segment->ifltype = ifltype[iseg];
 4655:    nodeBnd->segment->iettype = iettype[iseg];
 4656: 
 4657:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4658: 
 4659:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4660: 
 4661:       nodeBnd->efa[jfr] = efa[idx2];
 4662:       nodeBnd->emo[jfr] = emo[idx2];
 4663:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4664:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4665: 
 4666:    }
 4667:         
 4668: 
 4669: }
 4670: 
 4671: __device__ void Mesh::populateBoundarySideLinks(void) {
 4672: 
 4673:    SIDE_BND(sideBnd);
 4674: 
 4675:    const Side *side = sideBnd->side;
 4676: 
 4677:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4678:    // and the rightSide is the side s that has s->n1 == side->n2
 4679:    for (int i = 0; i < mesh->nbs; i++) {
 4680: 
 4681:       Side *s = &mesh->localSideData[i];
 4682: 
 4683:       if (s == side) continue;  // Do not link the side to itself
 4684:    
 4685:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4686:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4687:    }
 4688:    
 4689: }
 4690: 
 4691: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4692:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4693:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4694:                 int *isdel, int *isidenode, int *isbnd,
 4695:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4696:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4697:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4698:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4699:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4700:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4701:                 double *drag, double *roughness,
 4702:                 double *emo, double *efa, 
 4703:                 double *umo, double *ufa, 
 4704:                 double *vmo, double *vfa) {
 4705: 
 4706:    printf("Populating mesh for partition %d\n", partNum);
 4707: 
 4708:    // XXXXXX THIS function does almost nothing. 
 4709: 
 4710:    nbs = *sharedIdxSideBoundary + 1;
 4711:    nbp = *sharedIdxNodeBoundary + 1;
 4712: 
 4713:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4714: 
 4715: }
