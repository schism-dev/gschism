 2085: 
 2086: /**
 2087:  * Find the element that contains the target point.
 2088:  * 
 2089:  * @param x0,y0,z0     Starting position coordinates
 2090:  * @param xt,yt,zt     Target position coordinates
 2091:  * @param dtb          Time step for tracking
 2092:  * @param u_int        Initial velocity components
 2093:  * @param nextElem     Starting/resulting element index
 2094:  * 
 2095:  * @return Status code of type trackExitCodes
 2096:  * 
 2097:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2098:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2099:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2100:  * as close the the segment AB as possible, the next point at each iteration is computed
 2101:  * along segment AB, but just after the current element.
 2102:  */
 2103: 
 2104: 
 2105: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2106: 
 2107:    constexpr int MAX_ITERATIONS = 40;
 2108: 
 2109:    int iter = 0;
 2110:    double fac = 0.00001;
 2111:    while (iter < MAX_ITERATIONS) {
 2112:       iter++;
 2113: 
 2114:       Bool4 isLeft, isObtuse, isBisector;
 2115:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2116: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2117:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2118: 
 2119: 
 2120:       if (isValid.none()) 
 2121:       // Inside the element if none of the edges is a valid continuation
 2122:       {
 2123:          // Just returns true and the element (curElem) is unchanged).
 2124:          // This means that the algorithm has found the element that contains the target point.
 2125:          return true;
 2126:       }
 2127:       else { // Outside the element
 2128: 
 2129:          // Outside this element. Pick the first valid exit side and cross.
 2130:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2131:          Element *prevElem = curElem;
 2132:          curElem = lastCrossSide->otherElem(curElem);
 2133: 
 2134:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2135:          // along the boundary.
 2136:          if (curElem == nullptr || curElem->isDry) {
 2137:          
 2138:             curElem = prevElem;
 2139:             return false;
 2140:          }
 2141:          
 2142:       }
 2143: 
 2144:    }
 2145: 
 2146:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2147: }
 2148: 
 2149: 
