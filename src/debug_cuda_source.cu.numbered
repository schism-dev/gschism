 1951:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 1952:    // Project the vectors from the node frame to the element frame
 1953: 
 1954:  
 1955:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 1956:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 1957:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 1958:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 1959:       else          v[3] = Vector2();
 1960:    }
 1961: 
 1962:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 1963:    // Project the vectors from the side frame to the element frame
 1964: 
 1965:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 1966:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 1967:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 1968:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 1969:       else          v[3] = Vector2();
 1970:    }
