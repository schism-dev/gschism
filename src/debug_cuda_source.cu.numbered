  510:    int kb;                    // Bottom index of the element
  511:    double area;               // Area of the element
  512:    double ssign[4];           // Sign associated with each side of an element
  513:    double radius;             // Element equivalent radii
  514: 
  515: #ifdef USE_FRAMES
  516:    Frame frame;
  517: #endif
  518: 
  519:    Vector2 gradPhi[4];        // Derivatives of shape functions
  520:    Vector2 gradEta;           // Gradient of free surface elevation
  521:    Vector2 gradPr;            // Gradient of pressure    
  522:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  523: 
  524:    bool isDry;                // True if the element is dry
  525: 
  526:    Vector2 center;         // Element center coordinates
  527:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  528:    double depth;              // Depth at element (min of all nodes)
  529:    double z[nvrt];            // z-coord  (local frame - vertical up)
  530: 
  531:    // Physical information
  532:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  533: 
  534:    static const bool isblock = false;              // Always false
  535: 
  536:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  537:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  538: 
  539:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  540:    
  541: 
  542:    double vsource;            // Volumetric source/sink term [m^3/s]
  543: 
  544:    double rho[nvrt];          // Density at each prism center
  545:    double rho_mean[nvrt];     // Mean density at each prism center
  546:    CubicSpline rho_spl;
  547:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  548:    double rho_z[nvrt];        // First derivative of density at each prism center
  549:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  550:    
  551: 
  552:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  553: 
  554:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  555:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  556: 
  557:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  558:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  559: 
  560:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  561:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  562:       // Find the local index of the node in the element (0,1,2,3)
  563:       int res = __ffs((nodes[0] == node) | 
  564:                      ((nodes[1] == node) << 1) | 
  565:                      ((nodes[2] == node) << 2) | 
  566:                      ((nodes[3] == node) << 3)) - 1;
  567:       
  568:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  569:       return res;  
  570:    }
  571: 
  572:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  573:       // Find the local index of the side in the element (0,1,2,3)
  574:       int res = __ffs((sides[0] == side) | 
  575:                      ((sides[1] == side) << 1) | 
  576:                      ((sides[2] == side) << 2) | 
  577:                      ((sides[3] == side) << 3)) - 1;
  578:       
  579:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  580:       return res;
  581:    }
  582: 
  583: 
  584:    __inline__ __device__ int findLevel(double z1, int k) const {
  585:       // Starting at index k, find sequentially the level that contains z
  586: 
  587:       // For testing purposes, forgets k and performs a full search.
  588:       for (k = kb; k < nvrt - 1; k++) {
  589:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  590:       }
  591:       return nvrt - 2;
  592: 
  593: 
  594:       // if z is already betweeen z[k] and z[k+1], return k
  595:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  596:       else if (z1 <  z[k]) { 
  597:          // Search for increasing levels
  598:          for (int kk = k; kk < nvrt - 1; kk++) {
  599:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  600:          }
  601:          return nvrt - 1;
  602:       }
  603:       else {
  604:          // Search for decreasing levels
  605:          for (int kk = k; kk >= kb; kk--) {
  606:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  607:          }
  608:          return 0;
  609:       }
  610:    }
  611: 
  612:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  613:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  614: 
  615:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  616:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  617:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  618:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  619:        const double eta = (idx & 1) ? +g : -g;
  620:        const double xi  = (idx & 2) ? +g : -g;
  621:        return {eta, xi};
  622:    }  
  623: 
  624:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  625:    __device__ __forceinline__ double etaSign(int idx) const {
  626:       // bit1: 0 -> -1, 1 -> +1
  627:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  628:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  629:    }
  630: 
  631:    __device__ __forceinline__ double xiSign(int idx) const {
  632:       // +1 if (bit0 XOR bit1), else -1
  633:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  634:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  635: 
  636:    }
  637: 
  638:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  639:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  640:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  641:    }
  642: 
  643:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  644:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  645:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  646:    }   
  647: 
  648:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  649:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  650:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  651:    }      
  652:    
  653:    __inline__ __device__ double detJ_eta(void) const;
  654: 
  655:    __inline__ __device__ double detJ_xi(void) const;
  656: 
  657:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  658: 
  659:    // Check if the element is dry using the more up-to-date elevation.
  660:    __inline__ __device__ bool isDry2(void) const;
  661: 
  662:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  663: 
  664:    __inline__ __device__ double computeSignedArea(void) const;
  665: 
  666:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  667:       // Nudges the point (x,y) to the barycenter of the element
  668: 
  669:       p = (1.0 - btrack_nudge)*p + btrack_nudge*center;
  670:    }
  671: 
  672:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  673: 
  674:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo) const;
  675:    
  676:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  677: 
  678:    __device__ double intPhiPhi(int i1, int i2) const;
  679: 
  680:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  681: 
  682:    __device__ Vector2 grad2(double *a) const
  683:    {
  684:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  685:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  686:       if (isQuad()) {
  687:          gx += a[3]*gradPhi[3].x;
  688:          gy += a[3]*gradPhi[3].y;
  689:       }
  690:       return {gx, gy};
  691:    }
  692: 
  693:    __device__ Vector2 grad2(double Node::* field) const
  694:    {
  695:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  696:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  697:       if (isQuad()) {
  698:          gx += (nodes[3]->*field)*gradPhi[3].x;
  699:          gy += (nodes[3]->*field)*gradPhi[3].y;
  700:       }
  701:       return {gx, gy};
  702:    }
  703: 
  704:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  705:    __device__ __forceinline__ Vector3 n(int k) const {
  706:       double area3D;
  707:       return n(k, area3D);
  708:     }
