 7798: __global__ void printMatrix(bool full) {
 7799:    // Debugging: print the matrix
 7800: 
 7801:    const int size = mesh->np;
 7802:    double sum = 0.0;
 7803:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7804:       const Node *node = mesh->localNodeData + idx_node;
 7805:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7806:       for (int j = 0; j < node->numNodes; j++) {
 7807:          Node* nbNode = node->nodes[j];
 7808:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7809:          sum += node->coeffMatrix[j];
 7810:       }
 7811:       if (full) printf("]\n");
 7812: 
 7813: 
 7814:    }
 7815:    if (!full) printf("sum=%lf\n", sum);
 7816: }
 7817: 
 7818: 
 7819: __global__ void returnMatrix(double *res) {
 7820:    // Debugging: returns the matrix as a CuPy array
 7821: 
 7822:    const int size = mesh->np;
 7823:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7824:       const Node *node = mesh->localNodeData + idx_node;
 7825:       res[idx_node*size + idx_node] = node->coeffDiag;
 7826:       for (int j = 0; j < node->numNodes; j++) {
 7827:          Node* nbNode = node->nodes[j];
 7828:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7829:       }
 7830: 
 7831:    }
 7832:    
 7833: }
 7834: 
 7835: 
 7836: __global__ void computeMatrixProductAndDotProducts() {
 7837:    // Computes A*p, r'Mr and p'Ap
 7838: 
 7839:    // 1) shared buffer: first half for rMr, second for pAp
 7840:    __shared__ double sdata[2*BLOCK_SIZE];
 7841:    double* s_rMr = sdata;
 7842:    double* s_pAp = sdata + BLOCK_SIZE;
 7843: 
 7844:    const int tid = threadIdx.x;
 7845: 
 7846:    double l_pAp = 0.0;
 7847: 
 7848:    s_rMr[tid] = 0.0;
 7849:    s_pAp[tid] = 0.0;
 7850: 
 7851:    // 2) get your node pointer
 7852:    // NODE(node);   
 7853:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7854:    Node *node = &(mesh->localNodeData[idx_node]); 
 7855:       if (idx_node < mesh->np) {
 7856: 
 7857:       const double diag = node->coeffDiag;
 7858:       const double r    = node->mR;
 7859:       const double p    = node->mP;  
 7860: 
 7861:       // apply preconditioner on the fly:
 7862:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7863: 
 7864:       // 4) compute Ap = A.p
 7865:       double Ap = node->coeffDiag * node->mP;
 7866:       for (int j = 0; j < node->numNodes; ++j) {
 7867:          const Node *nbNode = node->nodes[j];
 7868:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7869: 
 7870:       }
 7871: 
 7872:       node->mAp = Ap;
 7873:       
 7874: 
 7875:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7876:       // const double l_rMr = r*Mr;  // r'Mr
 7877:       l_pAp = p*Ap;  // p'Ap
 7878: 
 7879: 
 7880:    }
 7881: 
 7882:    // 6) write into shared mem
 7883:    // s_rMr[tid] = l_rMr;
 7884:    s_pAp[tid] = l_pAp;
 7885: 
 7886:    __syncthreads();
 7887: 
 7888:    // 7) block-wide tree reduction
 7889:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7890:       if (tid < stride)  {
 7891:          s_pAp[tid] += s_pAp[tid + stride];
 7892:       }
 7893:       __syncthreads();
 7894:    }
 7895: 
 7896:    // 8) thread 0 atomically accumulates into the globals
 7897:    // XXX: This is slower than it needs to be, but it is simple and works
 7898:    if (tid == 0) {
 7899:       atomicAdd(pAp, s_pAp[0]);
 7900:    }
 7901: 
 7902: 
 7903: }
 7904: 
 7905: 
 7906: __global__ void updateSolutionAndDotProducts(void) {
 7907:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7908: 
 7909:    const int tid = threadIdx.x;
 7910: 
 7911:    s_rMr[tid] = 0.0;
 7912: 
 7913:    // get node & bounds-check:
 7914:    NODE(node);
 7915: 
 7916:    
 7917:    // Compute alpha
 7918:    const double alpha = (*rMr_old)/(*pAp); 
 7919: 
 7920: 
 7921:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7922: 
 7923: 
 7924:    // load scalars
 7925:    const double diag = node->coeffDiag;
 7926:    const double p    = node->mP;
 7927:    const double Ap   = node->mAp;
 7928:    const double x    = node->mX;
 7929:    const double r    = node->mR;
 7930:    
 7931:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7932: 
 7933:    // 1) update solution & residual
 7934:    const double x_new = x + alpha*p;
 7935:    const double r_new = r - alpha*Ap;
 7936:    node->mX = x_new;
 7937:    node->mR = r_new;
 7938: 
 7939:    // 2) apply Jacobi preconditioner on the fly
 7940:    const double Mr_new = r_new/diag;
 7941: 
 7942: 
 7943:    // 3) local contributions for the two dot-products
 7944:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7945: 
 7946:    // 4) write into shared-mem
 7947:    s_rMr[tid] = l_rMr;
 7948: 
 7949:    __syncthreads();
 7950: 
 7951: 
 7952:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7953:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7954:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7955:       __syncthreads();
 7956:    }
 7957: 
 7958:    // 6) thread 0 atomically folds into the global accumulators
 7959:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7960: 
 7961: 
 7962: }
 7963: 
 7964: 
 7965: __global__ void updateSearchDirection() {
 7966: 
 7967:     NODE(node);
 7968: 
 7969:     // recompute z on-the-fly
 7970:     const double z = node->mR / node->coeffDiag;
 7971:     const double p = node->mP;
 7972: 
 7973:     const double beta = (*rMr_new)/(*rMr_old);
 7974: 
 7975: 
 7976:     // p =z + beta*p
 7977:     node->mP = z + beta*p;
 7978: 
 7979: }
 7980: 
 7981: __global__ void initializeScalars(double *scalars) {
 7982: 
 7983:    // These point to a cupy array in the host code
 7984:    rMr_old = scalars + 0;
 7985:    rMr_new = scalars + 1;
 7986:    pAp     = scalars + 2;
 7987: }
 7988: 
 7989: __global__ void initializePreconditionedResidual(void) {
 7990: 
 7991:     __shared__ double s_rMr[BLOCK_SIZE];  
 7992: 
 7993:     s_rMr[threadIdx.x] = 0.0;
 7994: 
 7995:     NODE_ALL(node, valid);
 7996:     const int tid = threadIdx.x;
 7997:     // For the first iteration:
 7998:     // 1. Initial solution x = 0 (already set)
 7999:     // 2. Initial residual r = b (stored in qel)
 8000:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8001: 
 8002: // XXX we should use the guess solution here    
 8003: 
 8004:     double l_rMr = 0.0;
 8005:     if (valid) {
 8006:       // Set initial residual r = b (from qel)
 8007:       node->mR = node->qel;
 8008: 
 8009:       // Compute z = M^-1 * r (preconditioned residual)
 8010:       const double z = node->mR / node->coeffDiag;
 8011: 
 8012:       // Set initial search direction p = z
 8013:       node->mP = z;
 8014: 
 8015:       // Initialize other variables needed for CG
 8016:       node->mX = 0.0;  // Initial solution
 8017:       node->mAp = 0.0; // Will be computed in first iteration
 8018: 
 8019: 
 8020:       // Computes the first r'Mr (reduction)
 8021:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8022:     }
 8023:     // 4) write into shared-mem
 8024:     s_rMr[tid] = l_rMr;
 8025: 
 8026:     __syncthreads();
 8027: 
 8028: 
 8029:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8030:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8031:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8032:         __syncthreads();
 8033:     }
 8034: 
 8035:     // 6) thread 0 atomically folds into the global accumulators
 8036:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8037: 
 8038:     *rMr_old = 0.0;
 8039:     *pAp = 0.0;
 8040: }
 8041: 
 8042: 
