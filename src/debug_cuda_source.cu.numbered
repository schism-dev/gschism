  334: struct Tracers {
  335:     double tracer[N_TRACERS];
  336: };
  337: 
  338: 
  339: 
  340: struct Frame {
  341:    double _t[9]; // t stands for tensor.
  342: 
  343:    // Access the tensor in Fortran order
  344:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  345: 
  346:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  347: 
  348:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  349: 
  350:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  351:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  352:       sincos(ar2, &sin_ar2, &cos_ar2);
  353: 
  354:       t(0,0) = -sin_ar1;
  355:       t(1,0) =  cos_ar1;
  356:       t(2,0) =  0.0;
  357:       t(0,1) = -cos_ar1*sin_ar2;
  358:       t(1,1) = -sin_ar1*sin_ar2;
  359: 
  360:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  361: 
  362:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  363:       assert (ar4!=0.0 && "GRID: ar4=0");
  364: 
  365:       const double ar4_inv = 1.0/ar4;
  366:       t(0,1) = t(0,1)*ar4_inv;
  367:       t(1,1) = t(1,1)*ar4_inv;
  368:       t(2,1) = t(2,1)*ar4_inv;
  369: 
  370:       // The third vector is the cross product of the first two
  371:       crossProduct(t(0,0), t(1,0), t(2,0), 
  372:                    t(0,1), t(1,1), t(2,1), 
  373:                    t(0,2), t(1,2), t(2,2));
  374:    }
  375: 
  376: 
  377:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  378:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  379:    // Inputs:
  380:    //        vec0: vel. in this frame;
  381:    //        frameout: Output frame;
  382:    // Output: 
  383:    //        vec1: vel. in new frame  
  384: 
  385:       auto const fo = frameout;
  386:       Vector2 vec1;
  387: 
  388:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  389:       // of t and fo.t are the same.
  390:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  391:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  392: 
  393:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  394:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  395: 
  396:       return vec1;
  397:    }
  398: 
  399:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  400:       // Transform a vector from global to local frame
  401:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  402:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  403:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  404:    }
  405: 
  406:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  407:       // Transform a vector from local to global frame
  408:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  409:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  410:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  411:    }   
  412: 
  413:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  414:    // Tranforms a point from global to local frame     
  415:       G2L(pi - origin0, po);
  416:    }
  417: 
  418:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  419:    // Transforms a point from local to global frame      
  420:       L2G(pi, po);
  421:       po = po + origin0;
  422:    }
  423: 
  424: };
