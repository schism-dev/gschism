 1770: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1771:    // Computes the 3D normal vector to the element at level k
 1772:    // Returns the normal vector and the area of the element
 1773: 
 1774:       if (isTri()) {
 1775:          // For triangles...
 1776: 
 1777:          // Gets the normal vector to the element (with a length equal to twice the area)
 1778:          if constexpr(ics==1) {
 1779:             const int kb0 = max(k, nodes[0]->kb);
 1780:             const int kb1 = max(k, nodes[1]->kb);
 1781:             const int kb2 = max(k, nodes[2]->kb);
 1782: 
 1783:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1784:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1785:             
 1786:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1787:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1788:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1789:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1790: 
 1791:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1792:             area3D = 0.5*len;
 1793: 
 1794:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1795: 
 1796:             return {nx/len, ny/len, nz/len};
 1797: 
 1798:            
 1799:          }
 1800:          else {  // lat/lon
 1801:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1802:             return {0.0, 0.0, 0.0};
 1803: 
 1804:          } // if ics
 1805:       }
 1806:       else {
 1807:          // For quads...
 1808: 
 1809:          assert(false && "Element normal vector: quads not yet implemented");
 1810:          return {0.0, 0.0, 0.0};
 1811: 
 1812: 
 1813:       }
 1814:    }
 1815: 
 1816: /**
 1817:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1818:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1819:    If the segment is completely inside the element, then it returns true.
 1820: 
 1821:    This function assumes:
 1822:    - The initial point is on a side of the element. 
 1823:    - Its position is given by parameter t in the range [0,1].
 1824:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1825:       intersects the element (elements are convex).
 1826: 
 1827:    To find the intersection point, this function does the following:
 1828:    - it finds the intersection of the line segment with all the element side lines,
 1829:       except for the one that contains the initial point.
 1830:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1831:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1832:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1833:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1834:       track segment is almost parallel to the element side line.
 1835: 
 1836:    Inputs:
 1837:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1838:    @param x2, y2: other end of the line segment
 1839: 
 1840:    Outputs:
 1841:    @param side:  side that intersects the line segment (input and output)
 1842:    @param nextElement (output): element that contains the intersection point
 1843:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1844:    @param zint (input/output): Vertical coordinate of the intersection point
 1845: 
 1846:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1847:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1848:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1849: 
 1850:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1851:    (Delta) being zero.
 1852: 
 1853:    The intersection2 point happens when:
 1854:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1855:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1856:    
 1857:    Assumption: the 4 points (including those of the side segment) are different.
 1858:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1859:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1860:    If true, (xIntersect,yIntersect) is the intersection.				
 1861:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1862: **/
 1863: 
 1864: 
 1865: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1866:                                               double &t, double& tIntersect) {
 1867:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1868:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1869: 
 1870:    double closest_intersect_t = 1e10;
 1871:    bool found_intersection = false;
 1872: 
 1873:    for (int i = 0; i < i34; i++) {
 1874: 
 1875:       Side *side2 = sides[i];
 1876: 
 1877:       // (x3,y3)-(x4,y4) is the element side line
 1878:       const Point2 x3 = side2->n1->p;
 1879:       const Point2 x4 = side2->n2->p;
 1880: 
 1881:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1882:       const double delta = cross(x2 - x1, x3 - x4);
 1883: 
 1884:       if (abs(delta) > 0) {
 1885: 
 1886:          const double delta1 = cross(x3 - x1, x3 - x4);
 1887:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1888: 
 1889:          // Solves the two linear equations for tt1 and tt2
 1890:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1891:          const double tt2 = delta2/delta;
 1892: 
 1893:          if (tt1 >= -small2 && tt2 >= -small2 && tt2 <= 1.0 + small2 && tt1 <= 1.0 + small2) {
 1894:             closest_intersect_t = min(closest_intersect_t, tt1);
 1895:             side = side2;
 1896:             nextElement = side->otherElem(this);
 1897:             t = tt2;
 1898:             tIntersect = max(small, min(tt1, 1.0-small));
 1899:             found_intersection = true;
 1900:          }
 1901:       
 1902:       }
 1903:       else {  // parallel segments
 1904: 
 1905: printf("XXXXXXX Parallel segments !!!!!!!!!!!!!!!!!!!!!!\n");
 1906:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1907:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1908: 
 1909:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1910:          const double dist = dot(x1 - x3, side2->n);
 1911:          if (abs(dist) < small*length(x3 - x4)) {
 1912:             const double2 unitarySide = normalize(x4 - x3);
 1913:             const double len = dot(x2 - x1, unitarySide);
 1914:             t = t + len;
 1915:             t = max(0.0, min(t, 1.0));
 1916:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1917: 
 1918: 
 1919:             // tIntersect = max(small, min(tt1, 1.0-small));
 1920:             // t = tt2;
 1921:             found_intersection = true;
 1922:          }
 1923:       }
 1924: 
 1925: 
 1926:    }
 1927: 
 1928: if (!found_intersection) 
 1929: {
 1930:    printf("AAAAAAA %i  %i\n", nextElement->containsPoint(x1), nextElement->containsPoint(x2));
 1931:    printf("@@@()()@@@@YYYY@@@@@@@@@ No intersection found closest_intersect_t = %.17g, x1 = (%e,%e), x2 = (%e,%e)\n", closest_intersect_t, x1.x, x1.y, x2.x, x2.y);      
 1932:    
 1933: for (int i = 0; i < i34; i++) {
 1934: 
 1935:    Side *side2 = sides[i];
 1936: 
 1937:    // (x3,y3)-(x4,y4) is the element side line
 1938:    const Point2 x3 = side2->n1->p;
 1939:    const Point2 x4 = side2->n2->p;
 1940: 
 1941:    // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1942:    const double delta = cross(x2 - x1, x3 - x4);
 1943: 
 1944:    if (abs(delta) > 0) {
 1945: 
 1946:       const double delta1 = cross(x3 - x1, x3 - x4);
 1947:       const double delta2 = cross(x2 - x1, x3 - x1); 
 1948: 
 1949:       // Solves the two linear equations for tt1 and tt2
 1950:       const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1951:       const double tt2 = delta2/delta;
 1952: 
 1953: printf("CCCCCC i = %d, delta = %.17g, delta1 = %.17g, delta2 = %.17g, tt1 = %.17g, tt2 = %.17g\n", i, delta, delta1, delta2, tt1, tt2);      
 1954: 
 1955:       if ((tt1 >= -small2) && (tt2 >= -small2) && (tt2 <= 1.0 + small2) && (tt1 <= 1.0 + small2)) {
 1956:          closest_intersect_t = min(closest_intersect_t, tt1);
 1957:          side = side2;
 1958:          nextElement = side->otherElem(this);
 1959:          t = tt2;
 1960:          tIntersect = max(small, min(tt1, 1.0-small));
 1961:          found_intersection = true;
 1962:          printf("DDDDDD found_intersection = true, tt1 = %.17g, tt2 = %.17g\n", tt1, tt2);      
 1963:       }
 1964:    
 1965:    }
 1966: }
 1967: 
 1968: }
 1969:    assert(found_intersection && "No intersection found");
 1970: 
 1971:    // found_intersection should always be true, since we checked all the sides.  
 1972:    return found_intersection;
 1973: }
 1974: 
 1975: 
 1976: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1977:                                              Point3 &xt, double zint, Vector3 &u_int) {
 1978: 
 1979: // printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1980: 
 1981:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1982:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 1983:    // curElement.
 1984: 
 1985:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1986:    // And uses this velocity instead to continue the tracking.
 1987: 
 1988:    // computes the intersection point in cartesian coordinates
 1989:    Point2 intersection = nextSide->p_t(tt);
 1990: 
 1991:    // Nudges the point to the barycenter of the element. 
 1992:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1993:    // next segment intersects the element sides. 
 1994:    curElem->nudgeToBarycenter(intersection);
 1995: 
 1996: // double shpCoords[4];
 1997: // bool res = computeShapeCoords(intersection, shpCoords, false);
 1998: // printf("JJJJJ shpCoords = %.17g, %.17g, %.17g\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 1999: 
 2000:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2001:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2002:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2003:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2004: 
 2005:    // If the side is an open boundary, the tangential velocity is set to zero.
 2006:    if (nextSide->isBnd()) vtan = 0.0;
 2007: 
 2008:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2009:    const double us = vtan*nextSide->t().x;
 2010:    const double vs = vtan*nextSide->t().y;
 2011:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);  //  XXXX Why not use the side's velocity?
 2012: 
 2013: 
 2014:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2015:    const double len2 = norm2(intersection - toPoint2(xt));
 2016:    const double vel2 = dot(u_int, u_int);        
 2017:    
 2018:    // The end of this tracking segment is now the intersection point.
 2019:    xt = {intersection.x, intersection.y, zint};
 2020: 
 2021:    u_int = {us, vs, ws};
 2022: // printf("@@@@@@@XXXX@@@@@@@@@ idx = %d, us = %.17g, vs = %.17g, ws = %.17g, dt = %.17g\n", curElem->idx, us, vs, ws, dt);   
 2023:    
 2024: }
 2025: 
 2026: /**
 2027:  * Tracks a particle through elements and vertical levels in the mesh.
 2028:  * 
 2029:  * @param x0,y0,z0     Starting position coordinates
 2030:  * @param xt,yt,zt     Target position coordinates
 2031:  * @param dtb          Time step for tracking
 2032:  * @param uuint,vvint,wwint Initial velocity components
 2033:  * @param nextElem     Starting/resulting element index
 2034:  * 
 2035:  * @return Status code of type trackExitCodes
 2036:  * 
 2037:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2038:  * of the details are different. The idea is that the code requires less branches and is better fit
 2039:  * for GPU execution.
 2040:  * 
 2041:  * The main ideas here are:
 2042:  * - The starting point is expected to be in the starting element.
 2043:  * - since the starting point is inside the element, there are only two cases: 
 2044:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2045:  *     (b) it does not and (xt,yt) is already in the starting element.
 2046:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2047:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2048:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2049:  * - tt1 can be positive or negative. We only consider the positive values.
 2050:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2051:  * - The next intersection will occur at the smallest positive tt1.
 2052:  * - This intersection will be the next (x0,y0) position.
 2053:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2054:  *   of getting stuck in a loop.
 2055:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2056:  *   was found.
 2057:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2058:  */
 2059: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2060:                                                        Element *&nextElem, int &jlev, double &dt,
 2061:                                                        const Side *origSide) {
 2062:                                                             
 2063:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2064:    // else to do. This means that the full step occurred within the current element.
 2065:    assert(!isDry && "Starting element is dry");
 2066:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2067: 
 2068:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2069:       assert(!isDry && "Target point is inside a dry element");
 2070: 
 2071:       interpolateVelocities(xt, u_int);
 2072: 
 2073:       nextElem = this;
 2074: 
 2075: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2076:       return true;
 2077:    }
 2078: 
 2079: if (!containsPoint(toPoint2(x0)))   
 2080: {
 2081:    double shpCoords[4];
 2082:    printf("XXXXXXXXXXXXXXXXXXXXXXXX Starting point is not inside the element x0 = %.17g, %.17g, %.17g\n", x0.x, x0.y, x0.z);
 2083:    computeShapeCoords(toPoint2(x0), shpCoords, false);
 2084:    printf("XXXXXXXXXXXXXXXXXXXXXXXX shpCoords = %.17g, %.17g, %.17g, %.17g\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2085:    computeShapeCoords(toPoint2(xt), shpCoords, true);
 2086:    printf("XXXXXXXXXXXXXXXXXXXXXXXX shpCoords = %.17g, %.17g, %.17g, %.17g\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2087:    // if (jlev==0)addDebugPlot(x0, xt, 0xFFAF00, 'x');  // yellow
 2088:    // if (jlev==10)addDebugPlot(x0, xt, 0xFFCF00, 'x');  // yellow
 2089:    return true;
 2090: }
 2091:    assert(containsPoint(toPoint2(x0)) && "XXXX Starting point is not inside the element");
 2092: 
 2093: 
 2094:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2095:    assert(len2 > 0.0 && "Zero length track"); 
 2096:    
 2097:    // const int MAX_ITERATIONS = 1000;
 2098:    
 2099:    double t;
 2100:    Side *nextSide = nullptr;
 2101:    double tIntersect = 1e10;
 2102:    double zint = x0.z;
 2103: 
 2104: 
 2105:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2106:    // (x0,y0) is inside the element but the target point is not.
 2107:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2108: 
 2109:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2110:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2111: 
 2112:    if (nextElem != nullptr) nextElem->nudgeToBarycenter(xtmp);
 2113:    
 2114: 
 2115:    assert(found_intersection && "No intersection found at %d");
 2116: 
 2117:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2118:    xt = {xtmp.x, xtmp.y, zint};
 2119: 
 2120:    // if the tracking segment goes out of water (either dry or edge boundary)
 2121:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2122: 
 2123: 
 2124:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2125: // if (jlev==10)addDebugPlot(x0, xt, 0x0000DF, '+');  // dark blue
 2126: 
 2127:       nextElem = this;
 2128:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2129:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2130:       return true;    
 2131:    }
 2132: 
 2133: 
 2134: if (!nextElem->containsPoint(toPoint2(xt))) 
 2135: {
 2136:    printf("XXXXXXXXXXXXXXXXXXXXXXXX Target point is not inside the next element jlev = %d, x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g\n", jlev, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 2137: // if (jlev==10)addDebugPlot(x0, xt, 0xFFAF00, 'x');  // yellow
 2138:    return true;
 2139: }
 2140:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2141:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2142:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2143: 
 2144:    nextElem->interpolateVelocities(xt, u_int); 
 2145: // if (jlev==10)addDebugPlot(x0, xt, 0xFF0000, 'x');  // red  
 2146: 
 2147:    assert(nextElem != this && "Next element is the same as the current element");
 2148: 
 2149:    return true;
 2150: }
 2151: 
 2152: 
 2153: __inline__ __device__ double Element::computeSignedArea(void) const {
 2154:    // Compute the area of the element
 2155: 
 2156:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2157: 
 2158:    // In the quad case we need to add the area of the other triangle.
 2159:    if (isQuad()) {
 2160:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2161:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2162:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2163:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2164: 
 2165:       res += ar1;
 2166:    }
 2167: 
 2168:    return res;
 2169: }
 2170: 
 2171: 
 2172: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2173:                                                                 (nodes[1]->isDry2()) ||
 2174:                                                                 (nodes[2]->isDry2()) ||
 2175:                                                                 (i34==4 && nodes[3]->isDry2());
 2176: }
 2177: 
 2178: __inline__ __device__ double Element::detJ_eta(void) const {
 2179:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2180:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2181: }
 2182: 
 2183: __inline__ __device__ double Element::detJ_xi(void) const {
 2184:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2185:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2186: }
 2187: 
 2188: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2189:    // In boundary sides, the element 1 is nullptr
 2190:    return side->elems[1] == nullptr; 
 2191: }
