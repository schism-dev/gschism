 2554:    
 2555:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2556:    // Project the vectors from the node frame to the element frame
 2557: 
 2558:  
 2559:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2560:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2561:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2562:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2563:       else          v[3] = Vector2();
 2564:    }
 2565: 
 2566:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2567:    // Project the vectors from the side frame to the element frame
 2568: 
 2569:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2570:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2571:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2572:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2573:       else          v[3] = Vector2();
 2574:    }
 2575: 
 2576: 
 2577:    template<typename T>
 2578:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2579:       T values[4];
 2580:       getNodalValues(level, func, values);
 2581: 
 2582:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2583:       if constexpr (IsVector2<T>::value && ics == 2) {
 2584: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2585:          projectNodeVectorsToElementFrame(values);
 2586: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2587:       }
 2588: 
 2589:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2590:    }
 2591: 
 2592:    template<typename T>
 2593:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2594:       T values[4];
 2595:       getNodalValues(field, values);
 2596: 
 2597:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2598:       if constexpr (IsVector2<T>::value && ics == 2) {
 2599: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2600:          projectNodeVectorsToElementFrame(values);
 2601: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2602:       }
 2603:       
 2604:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2605:    }
