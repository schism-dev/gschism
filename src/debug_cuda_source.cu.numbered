 7126: __global__ void getStructSizes(int* sizes)  {
 7127:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7128:       sizes[0] = (int)sizeof(Node);
 7129:       sizes[1] = (int)sizeof(Element);
 7130:       sizes[2] = (int)sizeof(Side);
 7131:       sizes[3] = (int)sizeof(NodeBoundary);
 7132:       sizes[4] = (int)sizeof(SideBoundary);
 7133:       sizes[5] = (int)sizeof(BoundarySegment);
 7134: }
