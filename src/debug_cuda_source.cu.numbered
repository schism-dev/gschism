 5635: 
 5636: 
 5637:    __global__ void backtrackAllNodes(void) {
 5638: 
 5639:       // max/min # of sub-divisions
 5640:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5641:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5642: 
 5643:       SIDE(side);
 5644: 
 5645:       const int kb = side->kb;
 5646: 
 5647: 
 5648:       // Initialize btrack velocities to the actual velocities at the side 
 5649:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5650:   
 5651:       if (side->isDry) return;
 5652:      
 5653: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5654: 
 5655:       // Checks that at least one element is not dry
 5656:       const Element *elem1 = side->elems[0];
 5657:       const Element *elem2 = side->elems[1];
 5658: 
 5659: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5660: 
 5661:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5662:       
 5663:       // XXXXXX
 5664:       // !swild_tmp to store global coord. of the starting side
 5665:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5666:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5667:       // !Use sframe2 
 5668:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5669: 
 5670: 
 5671:       for (int k = kb; k < nvrt; k++) {
 5672:       //  For ics=2, the coordinates are all in the side's local frame
 5673: 
 5674:          const int iadvf = side->iadv();  // Advection flag   
 5675:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5676: 
 5677:          const double vmag2 = norm2(side->u2[k]);
 5678: 
 5679:          if (vmag2 <= velmin_btrack_sq) {  
 5680:             // No activity 
 5681: 
 5682:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5683:             
 5684:          } else {  // do btrack
 5685: 
 5686:             // Compute number of sub-divisions based on local gradients of the velocity field
 5687: 
 5688:             // XXX IS THIS NECESSARY?
 5689:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5690:             double suma = 0.0;
 5691:             int icount = 0;
 5692:             #pragma unroll
 5693:             for (int l=0; l<2; l++) {
 5694:             // For each element sharing the side...
 5695: 
 5696:                const Element *elem = side->elems[l];
 5697:                  
 5698:                if (elem == nullptr) continue;
 5699: 
 5700:                icount++;
 5701: 
 5702:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5703:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5704:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5705: 
 5706:                double utmp[4];
 5707:                double vtmp[4];
 5708:                #pragma unroll
 5709:                for (int j = 0; j < elem->i34; j++) {
 5710: 
 5711:                   const Node *node = elem->nodes[j];
 5712: 
 5713:                   if constexpr(ics==1) {
 5714:                      utmp[j] = node->u2[k].x;
 5715:                      vtmp[j] = node->u2[k].y;  
 5716: 
 5717:                   } else {
 5718:                      // 'Project' the velocity from the node frame to the element frame
 5719:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5720:                      utmp[j] = tmp_u2.x;
 5721:                      vtmp[j] = tmp_u2.y;
 5722: 
 5723:                   }
 5724:                } // for j
 5725: 
 5726:                const Vector2 grad_u = elem->grad2(utmp); 
 5727:                const Vector2 grad_v = elem->grad2(vtmp);
 5728:    
 5729:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5730:             } // for l
 5731: 
 5732:             assert(icount > 0 && "Impossible 77");
 5733: 
 5734:             // '4' is somewhat arbitrary
 5735:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5736: 
 5737:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5738:             Vector3 u_int = {0.0, 0.0, 0.0};
 5739: 
 5740:             side->btrack(k, dt, dtbk, u_int);
 5741: 
 5742: 
 5743:             side->btu[k] = {u_int.x, u_int.y};
 5744:                
 5745:          } // if vmag (do backtrack)
 5746: 
 5747: 
 5748:       } // for k=kb,nvrt-1
 5749: 
 5750:    }
 5751: 
 5752: } // extern "C"
 5753: 
 5754: template<int nc>
 5755: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5756: 
 5757: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5758: //
 5759: // Although this is a general function, it is used only for equations on vertical levels.
 5760: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5761: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5762: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5763: //
 5764: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5765: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5766: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5767: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5768: 
 5769:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5770:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5771: 
 5772:    double bet = b[0];
 5773:    if constexpr (nc == 1) {
 5774:       u[0] = rhs[0]/bet;
 5775:    } else {
 5776:       #pragma unroll
 5777:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5778:    }
 5779: 
 5780:    for (int j = 1; j < n; j++) {
 5781:       gam[j] = c[j - 1]/bet;
 5782:       bet = b[j] - a[j]*gam[j];
 5783: 
 5784:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5785: 
 5786:       if constexpr (nc == 1) {
 5787:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5788:       } else {
 5789:          #pragma unroll
 5790:          for (int l = 0; l < nc; l++) {
 5791:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5792:          }
 5793:       }
 5794:    }
 5795: 
 5796:    // Back-substitution
 5797:    for (int j = n - 2; j >= 0; j--) {
 5798:       if constexpr (nc == 1) {
 5799:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5800:       } else {
 5801:          for (int l = 0; l < nc; l++) {
 5802:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5803:          }
 5804:       }
 5805:    }
 5806: }
 5807: 
 5808: 
 5809: 
 5810: // Helper function that contains the core algorithm
 5811: template<typename XAccessor, typename YAccessor>
 5812: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5813:                                     double  yp_top, double  yp_bot, 
 5814:                                     CubicSpline &spline) {
 5815:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5816:    // 
 5817:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5818:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5819:    //
 5820:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5821:    // 
 5822:    // Inputs: 
 5823:    //            n: dimension for x etc; # of data pts (>=2);
 5824:    //            getX, getY: functions to access x,y coordinates
 5825:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5826:    //     Output: 
 5827:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5828: 
 5829:    const int n = k2 - k1 + 1;
 5830:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5831: 
 5832:    // Allocate memory for the splines
 5833:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5834:    spline.x   = new double[n];
 5835:    spline.y   = new double[n];
 5836:    spline.yp  = new double[n];
 5837:    spline.ypp = new double[n];
 5838: 
 5839:    for (int k=k1; k<=k2; k++) {
 5840:       spline.x[k] = getX(k);
 5841:       spline.y[k] = getY(k);
 5842:    }
 5843: 
 5844:    // This is to simplify expressions later
 5845:    double *x = spline.x;
 5846:    double *y = spline.y;
 5847: 
 5848:    double *a = nullptr;
 5849:    double *b = nullptr;
 5850:    double *c = nullptr;
 5851:    double *gam = nullptr;
 5852:    double *rhs = nullptr;
 5853:    
 5854: 
 5855:       a = new double[n];   // Lower diagonal
 5856:       b = new double[n];   // Diagonal
 5857:       c = new double[n];   // Upper diagonal
 5858:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5859:       rhs = new double[n]; // Right-hand side
 5860: 
 5861:    for (int k=k1; k<=k2; k++) {
 5862:       if (k == k1) {
 5863:          // Bottom level
 5864:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5865:          b[k] = (x[k+1] - x[k])/3.0;
 5866:          c[k] = b[k]/2.0;
 5867:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5868:       } else if (k == n - 1) {
 5869:          // Top level (surface)
 5870:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5871:          b[k] = (x[k] - x[k-1])/3.0;
 5872:          a[k] = b[k]/2.0;
 5873:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5874:       } else {
 5875:          // Intermediate levels
 5876:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5877:          b[k] = (x[k+1] - x[k-1])/3.0;
 5878:          a[k] = (x[k  ] - x[k-1])/6.0;
 5879:          c[k] = (x[k+1] - x[k  ])/6.0;
 5880:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5881:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5882:       }
 5883:    }
 5884: 
 5885:    // Solve the tridiagonal system
 5886:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5887:    
 5888:    spline.yp[k1] = yp_bot;
 5889:    spline.yp[k2] = yp_top;
 5890: 
 5891:    // Compute rest of 1st derivatives using the splines
 5892:    for (int k=k1+1; k<k2; k++) {
 5893:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5894:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5895:    }
 5896:    
 5897:    delete[] a;
 5898:    delete[] b;
 5899:    delete[] c;
 5900:    delete[] gam;
 5901:    delete[] rhs;
 5902: 
 5903: }
 5904: 
 5905: // Array version
 5906: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5907:                                 double y_top, double y_bot, 
 5908:                                 CubicSpline &spline) {
 5909:    auto getX = [x] (int k) { return x[k]; };
 5910:    auto getY = [y] (int k) { return y[k]; };
 5911:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5912: }
 5913: 
 5914: // Lambda version - allows custom access patterns
 5915: template<typename XFunc, typename YFunc>
 5916: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5917:                                 double y_top, double y_bot,
 5918:                                 CubicSpline &spline) {
 5919:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5920: }
