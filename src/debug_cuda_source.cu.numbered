 9070: __global__ void getStructSizes(int* sizes)  {
 9071:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 9072:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 9073:       sizes[0] = (int)sizeof(Node);
 9074:       sizes[1] = (int)sizeof(Element);
 9075:       sizes[2] = (int)sizeof(Side);
 9076:       sizes[3] = (int)sizeof(NodeBoundary);
 9077:       sizes[4] = (int)sizeof(SideBoundary);
 9078:       sizes[5] = (int)sizeof(BoundarySegment);
 9079: }
