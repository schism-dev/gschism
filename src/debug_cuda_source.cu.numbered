 8108: 
 8109: __global__ void returnMatrix(double *res) {
 8110:    // Debugging: returns the matrix as a CuPy array
 8111: 
 8112:    const int size = mesh->np;
 8113:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8114:       const Node *node = mesh->localNodeData + idx_node;
 8115:       res[idx_node*size + idx_node] = node->coeffDiag;
 8116:       for (int j = 0; j < node->numNodes; j++) {
 8117:          Node* nbNode = node->nodes[j];
 8118:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8119:       }
 8120: 
 8121:    }
 8122:    
 8123: }
 8124: 
 8125: __global__ void returnX(double *res) {
 8126:    // Debugging: returns the matrix as a CuPy array
 8127: 
