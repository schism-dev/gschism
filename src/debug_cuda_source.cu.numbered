 6004: extern "C" {
 6005: 
 6006:    __global__ void scaleGravity(double loadtide_coef) {
 6007: 
 6008: 
 6009:       NODE(node);
 6010: 
 6011:       // SAL option: scale gravity
 6012:       if constexpr(iloadtide==2) {  // simple const
 6013:          node->grav2 = grav*(1.0 - loadtide_coef);
 6014: 
 6015:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6016:         
 6017:           const double depth = max(node->depth, 0.0);
 6018:           const double tmp1 = sqrt(depth);
 6019:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6020:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6021:                              2.6969e-13*depth*depth*depth*tmp1;
 6022:           
 6023:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6024:           
 6025: 
 6026: 
 6027:           node->grav2 = grav*(1.0 - beta_bar);
 6028: 
 6029:       } else {  // iloadtide=0,1
 6030:           node->grav2 = grav;
 6031: 
 6032:       }
 6033: 
 6034:    }
 6035: 
 6036: 
 6037:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 6038:       NODE(node);
 6039: 
 6040:       const int idx = node->idx;
 6041:       Vector2 wind = {xWind[idx], yWind[idx]};
 6042: 
 6043:       if constexpr(nws != 0 && iwindoff != 0) {
 6044:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6045:       }
 6046: 
 6047:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6048:       node->setWind(wind);
 6049: 
 6050:       node->pr = pressAir[idx];
 6051:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6052: 
 6053:    }
