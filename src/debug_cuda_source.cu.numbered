 1757: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1758:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1759: }
 1760: 
 1761: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1762:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1763: }   
 1764: 
 1765: __device__ __inline__ double min3(double a, double b, double c) {
 1766:    return min(a, min(b, c));
 1767: }
 1768: 
 1769: __device__ __inline__ double max3(double a, double b, double c) {
 1770:    return max(a, max(b, c));
 1771: }
 1772: 
 1773: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1774:    return min(a, min(b, min(c, d)));
 1775: }
 1776: 
