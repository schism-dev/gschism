 2366: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2367: {
 2368:     uintptr_t p = (uintptr_t)address;
 2369:     assert((p & 1) == 0);
 2370: 
 2371:     unsigned int* base = (unsigned int*)(p & ~3);
 2372:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2373:                                   :  (unsigned int)val;
 2374: 
 2375:     atomicAdd(base, addend);
 2376: }
