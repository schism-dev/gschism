 2689: 
 2690: //       const Side& side = sides[i];
 2691: 
 2692: //       xIntersect=-1.e25;
 2693: //       yIntersect=-1.e25;
 2694: 
 2695: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2696: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2697: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2698: 
 2699: //       if (delta != 0.0) {
 2700: //          // Solves the two linear equations for tt1 and tt2
 2701: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2702: //          const double tt2 = delta2/delta;
 2703: 
 2704: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2705: //          // Similarly, we use tt2 to compute the intersection point.
 2706: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2707: //             xIntersect = x3 + (x4 - x3)*tt2;
 2708: //             yIntersect = y3 + (y4 - y3)*tt2;
 2709: 
 2710: //             intersectingSide = side;
