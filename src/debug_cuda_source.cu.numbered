 1342: // Helper functions for computing the local node index at a given offset from another.
 1343: __device__ __inline__ int nxq(int offset, int index, int size) {
 1344:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1345:    // to the index to make it positive
 1346:    assert(index + offset + 16*size >= 0);
 1347:    return (index + offset + 16*size) % size;  
 1348: }
 1349: 
 1350: __device__ __inline__ int nxq(int index, int size) {
 1351:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1352:    // to the index to make it positive
 1353:    assert(index + 16*size >= 0);
 1354:    return (index + 16*size) % size; 
 1355: }
