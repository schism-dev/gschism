 1958: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 1959: // return;   
 1960:    // Lock the mutex
 1961:    lock(&debugPlotMutex);
 1962:  
 1963:    bool ok = true;
 1964:    if (debugPlotIdx == nullptr) ok = false;
 1965:    if (*debugPlotIdx >= 10000) ok = false;
 1966:    if (ok) {
 1967:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1968:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1969:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1970:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1971:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1972:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 1973:       debugPlot[(*debugPlotIdx) + 6*10000] = (double)label;
 1974:       (*debugPlotIdx)++;
 1975:    }
 1976: 
 1977:    __threadfence();               // ensure all above writes are visible
 1978:    // Unlock the mutex
 1979:    unlock(&debugPlotMutex);
 1980: 
 1981: }
