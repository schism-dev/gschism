 4845: 
 4846:    __global__ void backtrackAllNodes(void) {
 4847: 
 4848:       // max/min # of sub-divisions
 4849:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4850:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4851: 
 4852:       SIDE(side);
 4853: 
 4854:       const int kb = side->kb;
 4855: 
 4856: 
 4857:       // Initialize btrack velocities to the actual velocities at the side 
 4858:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4859:   
 4860:       if (side->isDry) return;
 4861:      
 4862: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4863: 
 4864:       // Checks that at least one element is not dry
 4865:       const Element *elem1 = side->elems[0];
 4866:       const Element *elem2 = side->elems[1];
 4867: 
 4868: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4869: 
 4870:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4871:       
 4872:       // XXXXXX
 4873:       // !swild_tmp to store global coord. of the starting side
 4874:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4875:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4876:       // !Use sframe2 
 4877:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4878: 
 4879: 
 4880:       for (int k = kb; k < nvrt; k++) {
 4881:       //  For ics=2, the coordinates are all in the side's local frame
 4882: 
 4883:          const int iadvf = side->iadv();  // Advection flag   
 4884:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4885: 
 4886:          const double vmag2 = norm2(side->u2[k]);
 4887: 
 4888:          if (vmag2 <= velmin_btrack_sq) {  
 4889:             // No activity 
 4890: 
 4891:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4892:             
 4893:          } else {  // do btrack
 4894: 
 4895:             // Compute number of sub-divisions based on local gradients of the velocity field
 4896: 
 4897:             // XXX IS THIS NECESSARY?
 4898:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4899:             double suma = 0.0;
 4900:             int icount = 0;
 4901:             #pragma unroll
 4902:             for (int l=0; l<2; l++) {
 4903:             // For each element sharing the side...
 4904: 
 4905:                const Element *elem = side->elems[l];
 4906:                  
 4907:                if (elem == nullptr) continue;
 4908: 
 4909:                icount++;
 4910: 
 4911:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4912:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4913:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4914: 
 4915:                double utmp[4];
 4916:                double vtmp[4];
 4917:                #pragma unroll
 4918:                for (int j = 0; j < elem->i34; j++) {
 4919: 
 4920:                   const Node *node = elem->nodes[j];
 4921: 
 4922:                   if constexpr(ics==1) {
 4923:                      utmp[j] = node->u2[k].x;
 4924:                      vtmp[j] = node->u2[k].y;  
 4925: 
 4926:                   } else {
 4927:                      // 'Project' the velocity from the node frame to the element frame
 4928:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4929:                      utmp[j] = tmp_u2.x;
 4930:                      vtmp[j] = tmp_u2.y;
 4931: 
 4932:                   }
 4933:                } // for j
 4934: 
 4935:                const Vector2 grad_u = elem->grad2(utmp); 
 4936:                const Vector2 grad_v = elem->grad2(vtmp);
 4937:    
 4938:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4939:             } // for l
 4940: 
 4941:             assert(icount > 0 && "Impossible 77");
 4942: 
 4943:             // '4' is somewhat arbitrary
 4944:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4945: 
 4946:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4947:             Vector3 u_int = {0.0, 0.0, 0.0};
 4948: 
 4949:             side->btrack(k, dt, dtbk, u_int);
 4950: 
 4951: 
 4952:             side->btu[k] = {u_int.x, u_int.y};
 4953:                
 4954:          } // if vmag (do backtrack)
 4955: 
 4956: 
 4957:       } // for k=kb,nvrt-1
 4958: 
 4959:    }
 4960: 
 4961: } // extern "C"
 4962: 
 4963: template<int nc>
 4964: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4965: 
 4966: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4967: //
 4968: // a,b,c,rhs: input vectors and are not modified by this program.
 4969: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4970: // rhs is the r.h.s.
 4971: // n: actual rank of the system.
 4972: // rows in u() and rhs();
 4973: // u: output with nc columns (transposed to rows)
 4974: // gam: a working array.
 4975: //
 4976: // NOTES:
 4977: // This is a template function that allows for different numbers of columns in the rhs vector.
 4978: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4979: 
 4980:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4981:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4982: 
 4983:    double bet = b[0];
 4984:    if constexpr (nc == 1) {
 4985:       u[0] = rhs[0]/bet;
 4986:    } else {
 4987:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4988:    }
 4989: 
 4990:    for (int j = 1; j < n; j++) {
 4991:       gam[j] = c[j - 1]/bet;
 4992:       bet = b[j] - a[j]*gam[j];
 4993: 
 4994:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4995: 
 4996:       if constexpr (nc == 1) {
 4997:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4998:       } else {
 4999:          for (int l = 0; l < nc; l++) {
 5000:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5001:          }
 5002:       }
 5003:    }
 5004: 
 5005:    // Back-substitution
 5006:    for (int j = n - 2; j >= 0; j--) {
 5007:       if constexpr (nc == 1) {
 5008:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5009:       } else {
 5010:          for (int l = 0; l < nc; l++) {
 5011:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5012:          }
 5013:       }
 5014:    }
 5015: }
 5016: 
 5017: 
 5018: 
 5019: // Helper function that contains the core algorithm
 5020: template<typename XAccessor, typename YAccessor>
 5021: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5022:                                     double  yp_top, double  yp_bot, 
 5023:                                     CubicSpline &spline) {
 5024:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5025:    // 
 5026:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5027:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5028:    //
 5029:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5030:    // 
 5031:    // Inputs: 
 5032:    //            n: dimension for x etc; # of data pts (>=2);
 5033:    //            getX, getY: functions to access x,y coordinates
 5034:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5035:    //     Output: 
 5036:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5037: 
 5038:    const int n = k2 - k1 + 1;
 5039:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5040: 
 5041:    // Allocate memory for the splines
 5042:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5043:    spline.x   = new double[n];
 5044:    spline.y   = new double[n];
 5045:    spline.yp  = new double[n];
 5046:    spline.ypp = new double[n];
 5047: 
 5048:    for (int k=k1; k<=k2; k++) {
 5049:       spline.x[k] = getX(k);
 5050:       spline.y[k] = getY(k);
 5051:    }
 5052: 
 5053:    // This is to simplify expressions later
 5054:    double *x = spline.x;
 5055:    double *y = spline.y;
 5056: 
 5057:    double *a = nullptr;
 5058:    double *b = nullptr;
 5059:    double *c = nullptr;
 5060:    double *gam = nullptr;
 5061:    double *rhs = nullptr;
 5062:    
 5063: 
 5064:       a = new double[n];   // Lower diagonal
 5065:       b = new double[n];   // Diagonal
 5066:       c = new double[n];   // Upper diagonal
 5067:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5068:       rhs = new double[n]; // Right-hand side
 5069: 
 5070:    for (int k=k1; k<=k2; k++) {
 5071:       if (k == k1) {
 5072:          // Bottom level
 5073:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5074:          b[k] = (x[k+1] - x[k])/3.0;
 5075:          c[k] = b[k]/2.0;
 5076:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5077:       } else if (k == n - 1) {
 5078:          // Top level (surface)
 5079:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5080:          b[k] = (x[k] - x[k-1])/3.0;
 5081:          a[k] = b[k]/2.0;
 5082:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5083:       } else {
 5084:          // Intermediate levels
 5085:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5086:          b[k] = (x[k+1] - x[k-1])/3.0;
 5087:          a[k] = (x[k  ] - x[k-1])/6.0;
 5088:          c[k] = (x[k+1] - x[k  ])/6.0;
 5089:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5090:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5091:       }
 5092:    }
 5093: 
 5094:    // Solve the tridiagonal system
 5095:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5096:    
 5097:    spline.yp[k1] = yp_bot;
 5098:    spline.yp[k2] = yp_top;
 5099: 
 5100:    // Compute rest of 1st derivatives using the splines
 5101:    for (int k=k1+1; k<k2; k++) {
 5102:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5103:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5104:    }
 5105:    
 5106:    delete[] a;
 5107:    delete[] b;
 5108:    delete[] c;
 5109:    delete[] gam;
 5110:    delete[] rhs;
 5111: 
 5112: }
 5113: 
 5114: // Array version
 5115: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5116:                                 double y_top, double y_bot, 
 5117:                                 CubicSpline &spline) {
 5118:    auto getX = [x] (int k) { return x[k]; };
 5119:    auto getY = [y] (int k) { return y[k]; };
 5120:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5121: }
 5122: 
 5123: // Lambda version - allows custom access patterns
 5124: template<typename XFunc, typename YFunc>
 5125: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5126:                                 double y_top, double y_bot,
 5127:                                 CubicSpline &spline) {
 5128:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5129: }
