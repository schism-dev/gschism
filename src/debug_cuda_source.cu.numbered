 2415:    template<typename T>
 2416:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2417:       // Get the values of the field at the nodes of the element
 2418:       res[0] = nodes[0]->*field;
 2419:       res[1] = nodes[1]->*field;
 2420:       res[2] = nodes[2]->*field;
 2421:       if (isQuad()) res[3] = nodes[3]->*field;
 2422:       else          res[3] = T();
 2423:    }
 2424: 
 2425:    template<typename T>
 2426:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2427: 
 2428:       assert(level < nvrt && "Level is out of range");
 2429:       // Get the values of the field at the nodes of the element
 2430:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2431:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2432:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2433:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2434:       else          res[3] = T();
 2435:    }    
 2436: 
 2437:    template<typename T>
 2438:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2439: 
 2440:       assert(level < nvrt && "Level is out of range");
 2441: 
 2442:       // Get the values of the func at the nodes of the element
 2443:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2444:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2445:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2446:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2447:       else          res[3] = T();  // This is 0.0 or a zero vector
 2448: 
 2449:    }      
 2450: 
 2451:    template<typename T>
 2452:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2453:       // Get the values of the field at the nodes of the element
 2454:       res[0] = sides[0]->*field;
 2455:       res[1] = sides[1]->*field;
 2456:       res[2] = sides[2]->*field;
 2457:       if (isQuad()) res[3] = sides[3]->*field;
 2458:       else          res[3] = T();
 2459:    }
