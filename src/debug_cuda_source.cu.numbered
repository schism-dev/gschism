 1751: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1752:    // Computes the 3D normal vector to the element at level k
 1753:    // Returns the normal vector and the area of the element
 1754: 
 1755:       if (isTri()) {
 1756:          // For triangles...
 1757: 
 1758:          // Gets the normal vector to the element (with a length equal to twice the area)
 1759:          if constexpr(ics==1) {
 1760:             const int kb0 = max(k, nodes[0]->kb);
 1761:             const int kb1 = max(k, nodes[1]->kb);
 1762:             const int kb2 = max(k, nodes[2]->kb);
 1763: 
 1764:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1765:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1766:             
 1767:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1768:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1769:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1770:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1771: 
 1772:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1773:             area3D = 0.5*len;
 1774: 
 1775:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1776: 
 1777:             return {nx/len, ny/len, nz/len};
 1778: 
 1779:            
 1780:          }
 1781:          else {  // lat/lon
 1782:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1783: 
 1784:          } // if ics
 1785:       }
 1786:       else {
 1787:          // For quads...
 1788: 
 1789:          assert(false && "Element normal vector: quads not yet implemented");
 1790: 
 1791: 
 1792:       }
 1793:    }
 1794: 
 1795: /**
 1796:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1797:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1798:    If the segment is completely inside the element, then it returns true.
 1799: 
 1800:    This function assumes:
 1801:    - The initial point is on a side of the element. 
 1802:    - Its position is given by parameter t in the range [0,1].
 1803:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1804:       intersects the element (elements are convex).
 1805: 
 1806:    To find the intersection point, this function does the following:
 1807:    - it finds the intersection of the line segment with all the element side lines,
 1808:       except for the one that contains the initial point.
 1809:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1810:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1811:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1812:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1813:       track segment is almost parallel to the element side line.
 1814: 
 1815:    Inputs:
 1816:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1817:    @param x2, y2: other end of the line segment
 1818: 
 1819:    Outputs:
 1820:    @param side:  side that intersects the line segment (input and output)
 1821:    @param nextElement (output): element that contains the intersection point
 1822:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1823:    @param zint (input/output): Vertical coordinate of the intersection point
 1824: 
 1825:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1826:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1827:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1828: 
 1829:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1830:    (Delta) being zero.
 1831: 
 1832:    The intersection2 point happens when:
 1833:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1834:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1835:    
 1836:    Assumption: the 4 points (including those of the side segment) are different.
 1837:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1838:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1839:    If true, (xIntersect,yIntersect) is the intersection.				
 1840:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1841: **/
 1842: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1843:                                               double &t, double& tIntersect) {
 1844: 
 1845:    double closest_intersect_t = 1e10;
 1846:    bool found_intersection = false;
 1847: 
 1848:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1849:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1850:    const Point2 x1 = side->point(t);
 1851:    
 1852: 
 1853:    Side *nextSide = nullptr;
 1854:    for (int i = 0; i < i34; i++) {
 1855: 
 1856:       // Element's i-th side 
 1857:       Side *side2 = sides[i];
 1858: 
 1859:       // Skip the side that contains the initial point
 1860:       if (side2 == side) continue;
 1861: 
 1862:       // (x3,y3)-(x4,y4) is the element side line
 1863:       const Point2 x3 = side2->n1->p;
 1864:       const Point2 x4 = side2->n2->p;
 1865: 
 1866:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1867:       const double delta = cross(x2 - x1, x3 - x4);
 1868: 
 1869:       if (delta != 0.0) {
 1870: 
 1871:          const double delta1 = cross(x3 - x1, x3 - x4);
 1872:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1873: 
 1874:          // Solves the two linear equations for tt1 and tt2
 1875:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1876:          const double tt2 = delta2/delta;
 1877: 
 1878:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1879:             closest_intersect_t = min(closest_intersect_t, tt1);
 1880:             nextSide = side2;
 1881: 
 1882:             nextElement = nextSide->otherElem(this);
 1883:             tIntersect = max(small, min(tt1, 1.0-small));
 1884:             t = tt2;
 1885: 
 1886:             found_intersection = true;
 1887:          }
 1888:       
 1889:       }
 1890: 
 1891:    }
 1892: 
 1893:    // found_intersection should always be true, since we checked all the sides.  
 1894:    side = nextSide;
 1895: 
 1896:    return found_intersection;
 1897: }
 1898: 
 1899: 
 1900: 
 1901: 
 1902: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1903:                                               double &t, double& tIntersect) {
 1904: 
 1905:    double closest_intersect_t = 1e10;
 1906:    bool found_intersection = false;
 1907: 
 1908:    for (int i = 0; i < i34; i++) {
 1909: 
 1910:       Side *side2 = sides[i];
 1911: 
 1912:       // (x3,y3)-(x4,y4) is the element side line
 1913:       const Point2 x3 = side2->n1->p;
 1914:       const Point2 x4 = side2->n2->p;
 1915: 
 1916:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1917:       const double delta = cross(x2 - x1, x3 - x4);
 1918: 
 1919:       if (abs(delta) > 0) {
 1920: 
 1921:          const double delta1 = cross(x3 - x1, x3 - x4);
 1922:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1923: 
 1924:          // Solves the two linear equations for tt1 and tt2
 1925:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1926:          const double tt2 = delta2/delta;
 1927: 
 1928:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1929:             closest_intersect_t = min(closest_intersect_t, tt1);
 1930:             side = side2;
 1931:             nextElement = side->otherElem(this);
 1932:             t = tt2;
 1933:             tIntersect = max(small, min(tt1, 1.0-small));
 1934:             found_intersection = true;
 1935:          }
 1936:       
 1937:       }
 1938:       else {  // parallel segments
 1939:          assert(false && "Parallel segments");
 1940:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1941:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1942: 
 1943:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1944: 
 1945:          // const double dist = dot(x1 - x3, side2->n);
 1946:          // if (abs(dist) < small*length(x3 - x4)) {
 1947:          //    const double2 unitarySide = normalize(x4 - x3);
 1948:          //    const double len = dot(x2 - x1, unitarySide);
 1949:          //    t = t + len;
 1950:          //    t = max(0.0, min(t, 1.0));
 1951:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1952: 
 1953: 
 1954:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1955:          //    // t = tt2;
 1956:          //    found_intersection = true;
 1957:          // }
 1958:       }
 1959: 
 1960: 
 1961:    }
 1962: 
 1963:       
 1964:    assert(found_intersection && "No intersection found");
 1965: 
 1966:    // found_intersection should always be true, since we checked all the sides.  
 1967:    return found_intersection;
 1968: }
 1969: 
 1970: 
 1971: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1972:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1973: 
 1974:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1975: 
 1976:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1977:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1978:    // curElement.
 1979: 
 1980:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1981:    // And uses this velocity instead to continue the tracking.
 1982: 
 1983:    // computes the intersection point in cartesian coordinates
 1984:    Point2 intersection = nextSide->p_t(tt);
 1985: 
 1986:    // Nudges the point to the barycenter of the element. 
 1987:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1988:    // next segment intersects the element sides.  
 1989:    curElem->nudgeToBarycenter(intersection);
 1990: 
 1991:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1992:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1993:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1994:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1995: 
 1996:    // If the side is an open boundary, the tangential velocity is zero.
 1997:    if (nextSide->isBnd()) vtan = 0.0;
 1998: 
 1999:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2000:    const double us = vtan*nextSide->t().x;
 2001:    const double vs = vtan*nextSide->t().y;
 2002:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 2003: 
 2004:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2005:    const double len2 = norm2(intersection - toPoint2(xt));
 2006:    const double vel2 = dot(u_int, u_int);        
 2007:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 2008:    else            dt = 0.0;
 2009: 
 2010:    // The end of this tracking segment is now the intersection point.
 2011:    xt = {intersection.x, intersection.y, zint};
 2012: 
 2013:    u_int = {us, vs, ws};
 2014:    
 2015: }
 2016: 
 2017: /**
 2018:  * Tracks a particle through elements and vertical levels in the mesh.
 2019:  * 
 2020:  * @param x0,y0,z0     Starting position coordinates
 2021:  * @param xt,yt,zt     Target position coordinates
 2022:  * @param dtb          Time step for tracking
 2023:  * @param uuint,vvint,wwint Initial velocity components
 2024:  * @param nextElem     Starting/resulting element index
 2025:  * 
 2026:  * @return Status code of type trackExitCodes
 2027:  * 
 2028:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2029:  * of the details are different. The idea is that the code requires less branches and is better fit
 2030:  * for GPU execution.
 2031:  * 
 2032:  * The main ideas here are:
 2033:  * - The starting point is expected to be in the starting element.
 2034:  * - The end point is guaranteed to be inside an element.
 2035:  * - since the starting point is inside the element, there are only two cases: 
 2036:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2037:  *     (b) it does not and (xt,yt) is already in the starting element.
 2038:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2039:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2040:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2041:  * - tt1 can be positive or negative. We only consider the positive values.
 2042:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2043:  * - The next intersection will occur at the smallest positive tt1.
 2044:  * - This intersection will be the next (x0,y0) position.
 2045:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2046:  *   of getting stuck in a loop.
 2047:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2048:  *   was found.
 2049:  */
 2050: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2051:                                                        Element *&nextElem, int &jlev, double &dt,
 2052:                                                        const Side *origSide) {
 2053: 
 2054: 
 2055: 
 2056:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2057:    // else to do.
 2058:    // If it is, nudges the point to be inside the element.
 2059:    const Element *curElem = nextElem;
 2060:    if (containsPoint(toPoint2(xt), true)) {
 2061: 
 2062:       curElem->interpolateVelocities(xt, u_int);
 2063: 
 2064: addDebugPlot(x0, xt);
 2065:       return true;
 2066:    }
 2067: 
 2068:    Side *side = nullptr;
 2069: 
 2070:    // 1. Initial checks
 2071:    // Verify starting element is valid (wet)
 2072:    assert(!curElem->isDry && "Starting element is dry");
 2073: 
 2074:    // Checks if track has a zero length.
 2075:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2076:    // assert(len2 > 0.0 && "Zero length track"); 
 2077:    
 2078:    const int MAX_ITERATIONS = 1000;
 2079:    
 2080:    double t;
 2081:    Side *nextSide = nullptr;
 2082:    double tIntersect = 1e10;
 2083:    double zint = x0.z;
 2084: 
 2085:    // Horizontal tracking loop
 2086:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2087:    // (x0,y0) is inside the element but the target point is not.
 2088: 
 2089:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2090: 
 2091:    assert(found_intersection && "No intersection found at %d");
 2092: 
 2093:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2094: 
 2095:    // if the tracking segment goes out of water (either dry or edge boundary)
 2096:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2097: 
 2098: addDebugPlot(x0, xt, 0x00A0FF);
 2099:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2100: addDebugPlot(x0, xt, 0x00A0FF);      
 2101: 
 2102:       nextElem = this;
 2103:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2104:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2105:       return true;    
 2106:    }
 2107: 
 2108: 
 2109:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2110:    int iterations = 0;
 2111:    while (iterations < MAX_ITERATIONS) {
 2112:       iterations++;
 2113:       
 2114:       Element *curElem = nextElem;
 2115: 
 2116:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2117: addDebugPlot(x0, xt);
 2118:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2119: 
 2120:       // If we are already in the target element, we are done.
 2121:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2122:       if (!found_intersection) break;
 2123: 
 2124: 
 2125: 
 2126:       // if the tracking segment goes out of water (either dry or edge boundary).
 2127:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2128: addDebugPlot(x0, xt, 0x00A0FF);
 2129:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2130: addDebugPlot(x0, xt, 0x00A0FF);   
 2131:          nextElem = curElem;
 2132: 
 2133:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2134:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2135:          return true;
 2136:       }
 2137:       
 2138:       // Update position and element for next iteration
 2139:       side = nextSide;
 2140: 
 2141:    }
 2142: 
 2143:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2144: 
 2145:  
 2146:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2147:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2148: addDebugPlot(x0, xt);   
 2149:    nextElem->interpolateVelocities(xt, u_int); 
 2150: 
 2151:    return true;
 2152: }
 2153: 
 2154: 
 2155: __inline__ __device__ double Element::computeSignedArea(void) const {
 2156:    // Compute the area of the element
 2157: 
 2158:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2159: 
 2160:    // In the quad case we need to add the area of the other triangle.
 2161:    if (isQuad()) {
 2162:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2163:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2164:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2165:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2166: 
 2167:       res += ar1;
 2168:    }
 2169: 
 2170:    return res;
 2171: }
 2172: 
 2173: 
 2174: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2175:                                                                 (nodes[1]->isDry2()) ||
 2176:                                                                 (nodes[2]->isDry2()) ||
 2177:                                                                 (i34==4 && nodes[3]->isDry2());
 2178: }
 2179: 
 2180: __inline__ __device__ double Element::detJ_eta(void) const {
 2181:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2182:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2183: }
 2184: 
 2185: __inline__ __device__ double Element::detJ_xi(void) const {
 2186:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2187:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2188: }
 2189: 
 2190: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2191:    // In boundary sides, the element 1 is nullptr
 2192:    return side->elems[1] == nullptr; 
 2193: }
 2194: 
 2195: 
 2196: 
 2197: /**
 2198:    Compute the shape coordinates of the point (xt,yt) in the element.
 2199:    @param xt (input): x-coordinate of the point
 2200:    @param shpCoords (output): shape coordinates of the point
 2201:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2202:    @return true if the point is inside the element, false otherwise
 2203: **/
 2204: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2205:                                             bool fixNegshpCoord) const {
 2206: 
 2207:    // Compute the shape coordinates of the point xt in the element.
 2208:    if (i34==3) {
 2209:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2210:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2211:       // and in this case, the pt will be nudged into the element
 2212:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2213:       // from the local frame, so use additional check.
 2214: 
 2215:       Point2 x0, x1, x2;
 2216: 
 2217:       if constexpr(ics==1) {
 2218:          x0 = nodes[0]->p;
 2219:          x1 = nodes[1]->p;
 2220:          x2 = nodes[2]->p;
 2221:       }
 2222:       else // lat/lon
 2223:       {
 2224:          Error("Not implemented yet");
 2225: #ifdef ICS2
 2226:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2227:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2228:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2229: #endif
 2230:       }
 2231: 
 2232:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2233:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2234:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2235:       shpCoords[3] = 0.0;
 2236:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2237: 
 2238:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2239:       // then we fix the negative shape coordinates.
 2240:       if (fixNegshpCoord && tmpmin<=0.0) {
 2241: 
 2242:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2243:          // keeping the sum of the shape coordinates equal to 1.
 2244:          // I have tested and compared the new algorithm with the old one, and they give
 2245:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2246:          // The new algorithm should be faster since it is branchless.
 2247:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2248:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2249:          
 2250:          shpCoords[0] = (shpCoords[0] + a)*b;
 2251:          shpCoords[1] = (shpCoords[1] + a)*b;
 2252:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2253: 
 2254:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2255:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2256:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2257:          }
 2258: 
 2259:          // Update the point coordinates for the new shape coordinates
 2260:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2261:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2262:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2263: 
 2264:       }
 2265: 
 2266:       // Check if the point is inside the element
 2267:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2268:    }
 2269:    else {
 2270:       Error("Not implemented yet");
 2271: #ifdef QUADS
 2272:       // Reproject pt in eframe of nel for ics=2
 2273:       if constexpr(ics==1) {
 2274:          xn2 = xt; 
 2275:          yn2 = yt;
 2276:       }
 2277:       else {
 2278:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2279:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2280:       }
 2281: 
 2282:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2283: #endif
 2284:    }
 2285: 
 2286:    return false;  // Never reached
 2287: 
 2288: }
 2289: 
 2290: 
 2291: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2292: // Convert shape coordinates to cartesian coordinates
 2293: 
 2294:    if (i34 == 3) {
 2295:       // Triangular element
 2296:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2297:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2298:    }
 2299:    else {
 2300:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2301:    }
 2302: 
 2303: }
 2304: 
 2305: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2306:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2307:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2308:    // The formula for the integral is:
 2309:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2310: 
 2311:    printf("intPhiPhi: TEST\n");
 2312: 
 2313:    const Node *n0 = nodes[0];
 2314:    const Node *n1 = nodes[1];
 2315:    const Node *n2 = nodes[2];
 2316:    const Node *n3 = nodes[3];
 2317: 
 2318:    const Vector2 p0 = n0->p;
 2319:    const Vector2 p1 = n1->p;
 2320:    const Vector2 p2 = n2->p;
 2321:    const Vector2 p3 = n3->p;
 2322: 
 2323:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2324:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2325:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2326:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2327: 
 2328:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2329: }
 2330:    
 2331: 
 2332: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2333:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2334:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2335:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2336:    // The formula is also based on the identity:
 2337:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2338:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2339: 
 2340:    printf("intGradPhiGradPhi: TEST\n");   
 2341: 
 2342:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2343: 
 2344:    const double x0 = nodes[0]->p.x;
 2345:    const double y0 = nodes[0]->p.y;
 2346:    const double x1 = nodes[1]->p.x;
 2347:    const double y1 = nodes[1]->p.y;
 2348:    const double x2 = nodes[2]->p.x;
 2349:    const double y2 = nodes[2]->p.y;
 2350:    const double x3 = nodes[3]->p.x;
 2351:    const double y3 = nodes[3]->p.y;
 2352: 
 2353:    double res = 0.0;
 2354:    
 2355:    // Quadrature points in xi and eta coordinates
 2356:    #pragma unroll
 2357:    for (int i = 0; i < 4; i++) {
 2358:       // For each quadrature point...
 2359: 
 2360:       const Point2 p = GaussPoint(i);
 2361:       const double eta = p.x;
 2362:       const double xi  = p.y;
 2363: 
 2364:       // Jacobian entries at the Gauss point p
 2365:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2366:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2367:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2368:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2369: 
 2370:       const double detJ = jacobianDet(p);
 2371:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2372: 
 2373:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2374:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2375:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2376:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2377:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2378: 
 2379:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2380:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2381:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2382:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2383:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2384: 
 2385:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2386:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2387:    }
 2388: 
 2389:    return res;
 2390: }
 2391: 
 2392: 
 2393: /**  Interpolate velocities at a given point (xt,yt,zt)
 2394: 
 2395:    @param xt, yt, zt: coordinates of the point to interpolate
 2396:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2397: 
 2398:    This is done in four steps:
 2399: 
 2400:    1. Find the shape coordinates for the final position in the element.
 2401:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2402:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2403:       z levels at xt, yt at each step.   
 2404:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2405:       horizontally and vertically.
 2406: **/
 2407: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2408:    // Interpolate the velocities at the point xt. 
 2409:    // This function works the same for triangular and quadrilateral elements.
 2410:    double shpCoord[4];
 2411: 
 2412:    // First step is to compute the shape coordinates of (xt,yt)
 2413:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2414:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2415: 
 2416:    // Second step is to find the level that contains zt
 2417:    // Uses a binary search to find the level
 2418:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2419:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2420:    int R = nvrt - 1;
 2421: 
 2422:    // Get the z coordinates at the nodes of the element at the levels L and R
 2423:    double zLAtNodes[4], zRAtNodes[4];
 2424:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2425:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2426: 
 2427:    double zL = interpolate(shpCoord, zLAtNodes);
 2428:    double zR = interpolate(shpCoord, zRAtNodes);
 2429:    
 2430:    // Interpolates vertically the velocities
 2431:    double wght1, wght2;
 2432:    if (xt.z<=zL) {
 2433:       wght1 = 1.0;
 2434:       wght2 = 0.0;
 2435:    }
 2436:    else if (xt.z>=zR) {
 2437:       wght1 = 0.0;
 2438:       wght2 = 1.0;
 2439:    }
 2440:    else {
 2441:       // Perform a binary search to find the levels between L and R that contain xt.z
 2442:       while (R - L > 1) {
 2443:          int M = (L + R) / 2;
 2444: 
 2445:          double zMAtNodes[4];
 2446:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2447:          double zM = interpolate(shpCoord, zMAtNodes);
 2448:          if (zM < xt.z) 
 2449:          {
 2450:             L = M;
 2451:             zL = zM;
 2452:          }
 2453:          else 
 2454:          {
 2455:             R = M;
 2456:             zR = zM;
 2457:          }
 2458:       }
 2459:       assert(L == R-1);
 2460:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2461: 
 2462:       wght2 = (xt.z - zL)/(zR - zL);
 2463:       wght1 = 1.0 - wght2;
 2464:    }
 2465: 
 2466:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2467:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2468: 
 2469:    // Neither of the interpolated velocities should be NaN
 2470:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2471: 
 2472: }
 2473: 
 2474: 
 2475: 
 2476: 
 2477: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2478: 
 2479:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2480:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2481:    const Node *n1 = side->n1;
 2482:    const Node *n2 = side->n2;
 2483: 
 2484:    bool n1_match = (n1->nodeBnd->segment == segment);
 2485:    bool n2_match = (n2->nodeBnd->segment == segment);
 2486: 
 2487:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2488:    if (n1_match && n2_match) {
 2489:       return 0.5;
 2490:    } else if (n1_match) {
 2491:       return 1.0;
 2492:    } else if (n2_match) {
 2493:       return 0.0;
 2494:    }
 2495: 
 2496:    return 0.0;
 2497: }
