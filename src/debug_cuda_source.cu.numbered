 2042: 
 2043: __device__ void lock(int *mutex) {
 2044:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2045: }
 2046: 
 2047: __device__ void unlock(int *mutex) {
 2048:     atomicExch(mutex, 0);
 2049: }
 2050: 
 2051: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2052: // return;   
 2053:    // Lock the mutex
 2054:    lock(&debugPlotMutex);
 2055:  
 2056:    bool ok = true;
 2057:    if (debugPlotIdx == nullptr) ok = false;
 2058:    if (*debugPlotIdx >= 1000000) ok = false;
 2059:    if (ok) {
 2060:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2061:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2062:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2063:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2064:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2065:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2066:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2067:       (*debugPlotIdx)++;
 2068:    }
 2069: 
 2070:    __threadfence();               // ensure all above writes are visible
 2071:    // Unlock the mutex
 2072:    unlock(&debugPlotMutex);
 2073: 
 2074: }
