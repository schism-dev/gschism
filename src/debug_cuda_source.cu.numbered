  731:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  732: 
  733:    // ------------------------------------------------------------------------------------------------
  734:    // These are functions that work on all nodes of the element.
  735:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  736:    //
  737:    // An example of how to use these functions is:
  738:    //   
  739:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  740:    // 
  741:    // Where L is the level at which the field is to be interpolated. The field can be either
  742:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  743:    // There are different versions of getNodalValues for each of these cases.
  744: 
  745:    template<typename T>
  746:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  747:       // Get the values of the field at the nodes of the element
  748:       res[0] = nodes[0]->*field;
  749:       res[1] = nodes[1]->*field;
  750:       res[2] = nodes[2]->*field;
  751:       if (isQuad()) res[3] = nodes[3]->*field;
  752:       else          res[3] = T();
  753:    }
  754: 
  755:    template<typename T>
  756:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  757:       // Get the values of the field at the nodes of the element
  758:       res[0] = (nodes[0]->*field)[level];
  759:       res[1] = (nodes[1]->*field)[level];
  760:       res[2] = (nodes[2]->*field)[level];
  761:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  762:       else          res[3] = T();
  763:    }    
  764: 
  765:    template<typename T>
  766:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  767:       // Get the values of the func at the nodes of the element
  768:       res[0] = (nodes[0]->*func)(level);
  769:       res[1] = (nodes[1]->*func)(level);
  770:       res[2] = (nodes[2]->*func)(level);
  771:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  772:       else          res[3] = T();  // This is 0.0 or a zero vector
  773: 
  774:    }      
  775: 
  776:    template<typename T>
  777:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  778:       // Get the values of the field at the nodes of the element
  779:       res[0] = sides[0]->*field;
  780:       res[1] = sides[1]->*field;
  781:       res[2] = sides[2]->*field;
  782:       if (isQuad()) res[3] = sides[3]->*field;
  783:       else          res[3] = T();
  784:    }
  785: 
  786:    template<typename T>
  787:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  788:       // Get the values of the field at the nodes of the element
  789:       res[0] = (sides[0]->*field)[level];
  790:       res[1] = (sides[1]->*field)[level];
  791:       res[2] = (sides[2]->*field)[level];
  792:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  793:       else          res[3] = T();
  794:    }    
  795: 
  796:    template<typename T>
  797:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  798:       // Get the values of the func at the nodes of the element
  799:       res[0] = (sides[0]->*func)(level);
  800:       res[1] = (sides[1]->*func)(level);
  801:       res[2] = (sides[2]->*func)(level);
  802:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  803:       else          res[3] = T();  // This is 0.0 or a zero vector
  804: 
  805:    }      
  806: 
  807:    template<typename T>
  808:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  809:       T values[4];
  810:       getNodalValues(level, func, values);
  811: 
  812:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  813:    }
  814: 
  815:    template<typename T>
  816:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  817:       T values[4];
  818:       getNodalValues(field, values);
  819:       
  820:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  821:    }
  822: 
  823: 
  824:    template<typename T>
  825:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  826:       T values[4];
  827:       getNodalValues(level, field, values);
  828: 
  829:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  830:    }
  831: 
  832:    template<typename T>
  833:    __device__ T mean(T Node::* field) const {
  834:       T values[4];
  835:       getNodalValues(field, values);
  836: 
  837:       return (values[0] + values[1] + values[2] + values[3])/i34;
  838:    }
  839: 
  840:    template<typename T>
  841:    __device__ T mean(T Side::* field) const {
  842:       T values[4];
  843:       getSideValues(field, values);
  844:       
  845:       return (values[0] + values[1] + values[2] + values[3])/i34;
  846:    }   
  847: 
  848:    template<typename T>
  849:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  850:       T values[4];
  851:       getNodalValues(level, field, values);
  852: 
  853:       return (values[0] + values[1] + values[2] + values[3])/i34;
  854:    }
  855: 
  856:    template<typename T>
  857:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  858:       T values[4];
  859:       getSideValues(level, field, values);
  860:       
  861:       return (values[0] + values[1] + values[2] + values[3])/i34;
  862:    }   
  863: 
  864:    // __device__ double mean(double (Node::*func)(int) const) const {
  865:    //    double values[4];
  866:    //    getNodalValues(level, func, values);
  867:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  868:    // }
  869:    // ------------------------------------------------------------------------------------------------
