 7144: __global__ void printMatrix(bool full) {
 7145:    // Debugging: print the matrix
 7146: 
 7147:    const int size = mesh->np;
 7148:    double sum = 0.0;
 7149:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7150:       const Node *node = mesh->localNodeData + idx_node;
 7151:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7152:       for (int j = 0; j < node->numNodes; j++) {
 7153:          Node* nbNode = node->nodes[j];
 7154:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7155:          sum += node->coeffMatrix[j];
 7156:       }
 7157:       if (full) printf("]\n");
 7158: 
 7159: 
 7160:    }
 7161:    if (!full) printf("sum=%lf\n", sum);
 7162: }
