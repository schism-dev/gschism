 4274:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4275: 
 4276:       NODE_BND(nodeBnd);
 4277: 
 4278:       Node *node = nodeBnd->node;
 4279: 
 4280:       node->ETP = 0.0;
 4281: 
 4282:       for (int j=0; j<ntip; j++) {
 4283: 
 4284:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4285:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4286:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4287: 
 4288:          if constexpr(iloadtide==1) { // loading tide
 4289:             assert(false && "Loading tide not implemented");
 4290:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4291:          }
 4292:          
 4293:       }
 4294:       
 4295:    }
