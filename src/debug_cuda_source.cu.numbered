 6512:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6513: 
 6514:       SIDE(side);
 6515: 
 6516:       side->U = {0.0, 0.0}; 
 6517:          
 6518:       if(side->isDry) return;
 6519: 
 6520:       // Vertically integrated velocity U
 6521:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6522:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6523:          side->U += side->Dz(k + 1)*uc;  
 6524:       }
 6525: 
 6526:    }
