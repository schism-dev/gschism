 2138: 
 2139: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2140:    if constexpr(ics == 1)  {
 2141:       return center;
 2142: 
 2143:    } else {
 2144:       const Point2 p0 = nodes[0]->outputCoords();
 2145:       const Point2 p1 = nodes[1]->outputCoords();
 2146:       const Point2 p2 = nodes[2]->outputCoords();
 2147: 
 2148:       if (isTri()) {
 2149:          return (1.0/3.0)*(p0 + p1 + p2);
 2150: 
 2151:       } else {
 2152:          const Point2 p3 = nodes[3]->outputCoords();
 2153:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2154:       }
 2155: 
 2156:    }
 2157: }
 2158: 
 2159: 
 2160: __device__ __forceinline__ double Element::centerZ(void) const { 
 2161: // Z coordinate of the element center in the global cartesian coordinates.
 2162: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2163: 
 2164:    if constexpr(ics==1) { 
 2165:       return 0.0; 
 2166: 
 2167:    } else { 
 2168: 
 2169:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2170:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2171:    } 
 2172: }
