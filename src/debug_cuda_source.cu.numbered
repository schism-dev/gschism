 8249: __global__ void returnMatrix(double *res) {
 8250:    // Debugging: returns the matrix as a CuPy array
 8251: 
 8252:    const int size = mesh->np;
 8253:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8254:       const Node *node = mesh->localNodeData + idx_node;
 8255:       res[idx_node*size + idx_node] = node->coeffDiag;
 8256:       for (int j = 0; j < node->numNodes; j++) {
 8257:          Node* nbNode = node->nodes[j];
 8258:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8259:       }
 8260: 
 8261:    }
 8262:    
 8263: }
