 8457: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8458: 
 8459:    ELEM(elem);
 8460: 
 8461:    switch (varCode) {
 8462:       case (int)VarCode::outputCoords:
 8463:          const Point2 coords = elem->outputCoords();
 8464:          res[elem->idx*2    ] = coords.x;
 8465:          res[elem->idx*2 + 1] = coords.y;
 8466:          break;
 8467:    }
 8468: }
 8469: 
 8470: 
 8471: extern "C" __global__ void getSideVarFunc(int varCode, double *res) {
 8472: 
 8473:    SIDE(side);
 8474: 
