 2137: 
 2138: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2139:    if constexpr(ics == 1)  {
 2140:       return center;
 2141: 
 2142:    } else {
 2143:       const Point2 p0 = nodes[0]->outputCoords();
 2144:       const Point2 p1 = nodes[1]->outputCoords();
 2145:       const Point2 p2 = nodes[2]->outputCoords();
 2146: 
 2147:       if (isTri()) {
 2148:          return (1.0/3.0)*(p0 + p1 + p2);
 2149: 
 2150:       } else {
 2151:          const Point2 p3 = nodes[3]->outputCoords();
 2152:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2153:       }
 2154: 
 2155:    }
 2156: }
 2157: 
 2158: 
 2159: __device__ __forceinline__ double Element::centerZ(void) const { 
 2160: // Z coordinate of the element center in the global cartesian coordinates.
 2161: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2162: 
 2163:    if constexpr(ics==1) { 
 2164:       return 0.0; 
 2165: 
 2166:    } else { 
 2167: 
 2168:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2169:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2170:    } 
 2171: }
