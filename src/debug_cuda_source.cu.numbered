 1823: 
 1824: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1825:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1826: 
 1827:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1828: 
 1829:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1830:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1831:    // curElement.
 1832: 
 1833:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1834:    // And uses this velocity instead to continue the tracking.
 1835: 
 1836:    // computes the intersection point in cartesian coordinates
 1837:    Point2 intersection = nextSide->p_t(tt);
 1838: 
 1839:    // Nudges the point to the barycenter of the element. 
 1840:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1841:    // next segment intersects the element sides.  
 1842:    curElem->nudgeToBarycenter(intersection);
 1843: 
 1844:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1845:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1846:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1847:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1848: 
 1849:    // If the side is an open boundary, the tangential velocity is zero.
 1850:    if (nextSide->isBnd()) vtan = 0.0;
 1851: 
 1852:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1853:    const double us = vtan*nextSide->t().x;
 1854:    const double vs = vtan*nextSide->t().y;
 1855:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1856: 
 1857:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1858:    const double len2 = norm2(intersection - toPoint2(xt));
 1859:    const double vel2 = dot(u_int, u_int);        
 1860:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1861:    else            dt = 0.0;
 1862: 
 1863:    // The end of this tracking segment is now the intersection point.
 1864:    xt = {intersection.x, intersection.y, zint};
 1865: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1866:    u_int = {us, vs, ws};
 1867:    
 1868: }
 1869: 
 1870: /**
 1871:  * Tracks a particle through elements and vertical levels in the mesh.
 1872:  * 
 1873:  * @param x0,y0,z0     Starting position coordinates
 1874:  * @param xt,yt,zt     Target position coordinates
 1875:  * @param dtb          Time step for tracking
 1876:  * @param uuint,vvint,wwint Initial velocity components
 1877:  * @param nextElem     Starting/resulting element index
 1878:  * 
 1879:  * @return Status code of type trackExitCodes
 1880:  * 
 1881:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1882:  * of the details are different. The idea is that the code requires less branches and is better fit
 1883:  * for GPU execution.
 1884:  * 
 1885:  * The main ideas here are:
 1886:  * - The starting point is expected to be in the starting element.
 1887:  * - The end point is guaranteed to be inside an element.
 1888:  * - since the starting point is inside the element, there are only two cases: 
 1889:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1890:  *     (b) it does not and (xt,yt) is already in the starting element.
 1891:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1892:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1893:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1894:  * - tt1 can be positive or negative. We only consider the positive values.
 1895:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1896:  * - The next intersection will occur at the smallest positive tt1.
 1897:  * - This intersection will be the next (x0,y0) position.
 1898:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1899:  *   of getting stuck in a loop.
 1900:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1901:  *   was found.
 1902:  */
 1903: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1904:                                                        Element *&nextElem, int &jlev, double &dt) {
 1905: 
 1906:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1907:    // else to do.
 1908:    // If it is, nudges the point to be inside the element.
 1909:    const Element *curElem = nextElem;
 1910:    if (containsPoint(toPoint2(xt), true)) {
 1911: 
 1912:       curElem->interpolateVelocities(xt, u_int);
 1913: 
 1914:       return true;
 1915:    }
 1916: 
 1917:    Side *side = nullptr;
 1918: 
 1919:    // 1. Initial checks
 1920:    // Verify starting element is valid (wet)
 1921:    assert(!curElem->isDry && "Starting element is dry");
 1922: 
 1923:    // Checks if track has a zero length.
 1924:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1925:    // assert(len2 > 0.0 && "Zero length track"); 
 1926:    
 1927:    const int MAX_ITERATIONS = 1000;
 1928:    
 1929:    double t;
 1930:    Side *nextSide = nullptr;
 1931:    double tIntersect = 1e10;
 1932:    double zint = x0.z;
 1933: 
 1934:    // Horizontal tracking loop
 1935:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1936:    // (x0,y0) is inside the element but the target point is not.
 1937: 
 1938:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1939: 
 1940:    assert(found_intersection && "No intersection found at %d");
 1941: 
 1942:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1943: 
 1944:    // if the tracking segment goes out of water (either dry or edge boundary)
 1945:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1946: 
 1947: 
 1948:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1949: 
 1950:       nextElem = this;
 1951:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1952:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1953:       return true;    
 1954:    }
 1955: 
 1956: 
 1957:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1958:    int iterations = 0;
 1959:    while (iterations < MAX_ITERATIONS) {
 1960:       iterations++;
 1961:       
 1962:       Element *curElem = nextElem;
 1963: 
 1964:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1965: 
 1966:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1967: 
 1968:       // If we are already in the target element, we are done.
 1969:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1970:       if (!found_intersection) break;
 1971: 
 1972: 
 1973: 
 1974:       // if the tracking segment goes out of water (either dry or edge boundary).
 1975:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1976: 
 1977:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1978: 
 1979:          nextElem = curElem;
 1980: 
 1981:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1982:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1983:          return true;
 1984:       }
 1985:       
 1986:       // Update position and element for next iteration
 1987:       side = nextSide;
 1988: 
 1989:    }
 1990: 
 1991:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1992: 
 1993:  
 1994:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1995:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1996:    nextElem->interpolateVelocities(xt, u_int);
 1997: 
 1998: 
 1999:    return true;
 2000: }
 2001: 
 2002: 
 2003: __inline__ __device__ double Element::computeSignedArea(void) const {
 2004:    // Compute the area of the element
 2005: 
 2006:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2007: 
 2008:    // In the quad case we need to add the area of the other triangle.
 2009:    if (isQuad()) {
 2010:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2011:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2012:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2013:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2014:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2015:          Error("Negative area found in quad element");
 2016:       }
 2017:       res += ar1;
 2018:    }
 2019: 
 2020:    return res;
 2021: }
 2022: 
 2023: 
 2024: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2025:                                                                 (nodes[1]->isDry2()) ||
 2026:                                                                 (nodes[2]->isDry2()) ||
 2027:                                                                 (i34==4 && nodes[3]->isDry2());
 2028: }
 2029: 
 2030: 
 2031: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2032:    // In boundary sides, the element 1 is nullptr
 2033:    return side->elems[1] == nullptr; 
 2034: }
 2035: 
 2036: 
 2037: 
 2038: /**
 2039:    Compute the shape coordinates of the point (xt,yt) in the element.
 2040:    @param xt (input): x-coordinate of the point
 2041:    @param shpCoords (output): shape coordinates of the point
 2042:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2043:    @return true if the point is inside the element, false otherwise
 2044: **/
 2045: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2046:                                             bool fixNegshpCoord) const {
 2047: 
 2048:    // Compute the shape coordinates of the point xt in the element.
 2049:    if (i34==3) {
 2050:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2051:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2052:       // and in this case, the pt will be nudged into the element
 2053:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2054:       // from the local frame, so use additional check.
 2055: 
 2056:       Point2 x0, x1, x2;
 2057: 
 2058:       if constexpr(ics==1) {
 2059:          x0 = nodes[0]->p2();
 2060:          x1 = nodes[1]->p2();
 2061:          x2 = nodes[2]->p2();
 2062:       }
 2063:       else // lat/lon
 2064:       {
 2065:          Error("Not implemented yet");
 2066: #ifdef ICS2
 2067:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2068:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2069:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2070: #endif
 2071:       }
 2072: 
 2073:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2074:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2075:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2076:       shpCoords[3] = 0.0;
 2077:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2078: 
 2079:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2080:       // then we fix the negative shape coordinates.
 2081:       if (fixNegshpCoord && tmpmin<=0.0) {
 2082: 
 2083:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2084:          // keeping the sum of the shape coordinates equal to 1.
 2085:          // I have tested and compared the new algorithm with the old one, and they give
 2086:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2087:          // The new algorithm should be faster since it is branchless.
 2088:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 2089:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2090:          
 2091:          shpCoords[0] = (shpCoords[0] + a)*b;
 2092:          shpCoords[1] = (shpCoords[1] + a)*b;
 2093:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2094: 
 2095:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2096:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2097:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2098:          }
 2099: 
 2100:          // Update the point coordinates for the new shape coordinates
 2101:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2102:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2103:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2104: 
 2105:       }
 2106: 
 2107:       // Check if the point is inside the element
 2108:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2109:    }
 2110:    else {
 2111:       Error("Not implemented yet");
 2112: #ifdef QUADS
 2113:       // Reproject pt in eframe of nel for ics=2
 2114:       if constexpr(ics==1) {
 2115:          xn2 = xt; 
 2116:          yn2 = yt;
 2117:       }
 2118:       else {
 2119:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2120:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2121:       }
 2122: 
 2123:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2124: #endif
 2125:    }
 2126: 
 2127:    return false;  // Never reached
 2128: 
 2129: }
 2130: 
 2131: 
 2132: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2133: // Convert shape coordinates to cartesian coordinates
 2134: 
 2135:    if (i34 == 3) {
 2136:       // Triangular element
 2137:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2138:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2139:    }
 2140:    else {
 2141:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2142:    }
 2143: 
 2144: }
