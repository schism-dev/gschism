 8476:       case (int)VarCode::outputCoords:
 8477:          const Point2 coords = side->outputCoords();
 8478:          res[side->idx*2    ] = coords.x;
 8479:          res[side->idx*2 + 1] = coords.y;
 8480:          break;
 8481:    }
 8482: }
