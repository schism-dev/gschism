 5333:    __global__ void resetBoundaryAreas(void) {
 5334:       // Reset boundary areas and lengths for each segment.
 5335: 
 5336:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5337:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5338:       SIDE_BND(sideBnd);
 5339: 
 5340:       BoundarySegment *segment = sideBnd->segment;
 5341: 
 5342:       segment->carea = 0.0;
 5343:       segment->clen = 0.0;
 5344:  
 5345:    }
 5346: 
 5347:    __global__ void computeBoundaryAreas(void) {
 5348:    // Calculation of cross-section areas and lengths for flow b.c.
 5349: 
 5350:       SIDE_BND(sideBnd);
 5351: 
 5352:       const Side *side = sideBnd->side;
 5353:       BoundarySegment *segment = sideBnd->segment;
 5354: 
 5355:       if (segment->ifltype != 0) {
 5356: 
 5357:          const Node *n1 = side->n1;
 5358:          const Node *n2 = side->n2;
 5359: 
 5360:          const double htot = side->htot2();
 5361: 
 5362:          if (!side->isDry) {
 5363:             atomicAdd(&segment->carea, htot*side->len);
 5364:             atomicAdd(&segment->clen, side->len);
 5365:          }
 5366:       }
 5367: 
 5368:    }
 5369: 
 5370: 
 5371:    __global__ void computeFlowBcVelocities(double time) {
 5372: 
 5373:       SIDE_BND(sideBnd);
 5374: 
 5375:       const Side *side = sideBnd->side;
 5376:  
 5377:       const bool isDry = side->isDry;
 5378:       const bool isLand = sideBnd->segment->isLand;
 5379: 
 5380:    
 5381:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5382: 
 5383:       if (isDry || isLand) return;
 5384: 
 5385:       // For wet sides in open boundaries...
 5386:       const Vector2 n = side->n;
 5387:       const BoundarySegment *segment = sideBnd->segment;
 5388: 
 5389:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5390: 
 5391:       const int ifltype = segment->ifltype;
 5392: 
 5393:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5394:       const Vector2 r_nuth0 = r_uth0*n;
 5395: 
 5396: 
 5397:       if (ifltype == 1 || ifltype == 2) {
 5398:       
 5399:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5400: 
 5401:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5402:          
 5403:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5404:          
 5405:       } else if (ifltype == -1) { // Flather 1
 5406: 
 5407:          for (int k = 0; k < nvrt; k++) {
 5408: 
 5409:             // uth is the normal vel.; no ramp up
 5410:             const double uth = sideBnd->nuth(k);
 5411:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5412: 
 5413:             sideBnd->ubc[k] += uth*n;
 5414:          }
 5415: 
 5416:       } else if (ifltype == 3 || ifltype == 5) {
 5417:          // vnth0=0 !normal vel.
 5418: 
 5419:          Vector2 r_u1_bar = {0.0, 0.0};
 5420:          // Computes the contribution to the velocity from all tide frequencies
 5421:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5422: 
 5423:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5424:             const Vector2 umo  = sideBnd->umo(jfr); 
 5425: 
 5426:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5427:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5428:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5429:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5430: 
 5431:          }
 5432: 
 5433: 
 5434:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5435: 
 5436:       } // if (ifltype = 3 || ifltype == 5
 5437: 
 5438: 
 5439: 
 5440:    }
 5441: 
 5442:    __global__ void computeElevationBoundaryConditions(double time) {
 5443:       // Compute elevation essential boundary conditions 
 5444: 
 5445:       NODE_BND(nodeBnd); // Each boundary node.
 5446: 
 5447:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5448: 
 5449:       const Node *node = nodeBnd->node;
 5450:       const BoundarySegment *segment = nodeBnd->segment;
 5451:       const int iettype = segment->iettype;
 5452:       
 5453: 
 5454:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5455:       double eic = 0.0;
 5456:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5457:       else                 eic = 0.0;
 5458: 
 5459:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5460:       const double r_eth = ramp*nodeBnd->eth;
 5461:       double r_eta1_bar = 0.0;
 5462: 
 5463:       // Compute tide elevation
 5464:       if (iettype == 3 || iettype == 5) {   
 5465: 
 5466:          if constexpr(iloadtide==1) { // loading tide
 5467:             assert(false && "Loading tide not implemented");
 5468:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5469:          }
 5470:          
 5471:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5472: 
 5473:             const double efa  = nodeBnd->efa[jfr]; 
 5474:             const double emo  = nodeBnd->emo[jfr]; 
 5475: 
 5476:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5477:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5478:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5479: 
 5480: 
 5481:          } // for jfr
 5482: 
 5483:       } // if iettype
 5484: 
 5485:       switch (iettype) {
 5486:          case 1:
 5487:          case 2:
 5488:          case 4:
 5489:             nodeBnd->elbc = r_eic + r_eth;
 5490:             break;
 5491:          case 3:
 5492:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5493:             break;
 5494:          case 5:
 5495:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5496:             break;
 5497:       } // switch
 5498: 
 5499: 
 5500:       //Add inverse barometric effects
 5501:       if (iettype != 0 && inv_atm_bnd == 1) {
 5502:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5503:       }
 5504: 
 5505:    }
 5506: 
 5507: 
 5508:    __global__ void computeHorizontalViscosity(void) { 
 5509: 
 5510:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5511: 
 5512:       SIDE(side);
 5513: 
 5514:       if (side->isDry) return;
 5515: 
 5516:       for (int k = 0; k < nvrt; k++) {
 5517:          side->nuGradU[k] = {0.0, 0.0};
 5518:       }
 5519: 
 5520:       if constexpr(ihorcon == 1) {
 5521:          for (int k = side->kb; k < nvrt - 1; k++) {
 5522:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5523:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5524:             // By Zhang and Baptista.
 5525: 
 5526:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5527:             // This is a standard discretization of the Laplacian operator.
 5528:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5529:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5530:             // Gamma is hvis_coef0 in the code.
 5531:             // The value of gamma needs to be < 0.5.
 5532: 
 5533:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5534:             // side under consideration in each of the two possible elements that share the side.
 5535:             Vector2 sumU = {0.0, 0.0};
 5536:             for (int l = 0; l < 2; l++) {
 5537:                const Element *elem = side->elems[l];
 5538: 
 5539:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5540: 
 5541:                // Find the local index of the side in the element
 5542:                const int idxSide = elem->sideLocalIdx(side);
 5543: 
 5544:                // Find the two sides that are connected to the side under consideration
 5545:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5546:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5547: 
 5548:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5549: 
 5550:             }
 5551: 
 5552:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5553: 
 5554:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5555:    
 5556:          }
 5557:       }
 5558:       else if constexpr(ihorcon == 2) {
 5559:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5560:       }
 5561: 
 5562: 
 5563:    }
 5564: 
 5565: 
 5566:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5567: 
 5568:       // Set essential boundary conditions 
 5569:       NODE(node); // Each boundary node
 5570:       NodeBoundary *nodeBnd = node->nodeBnd;
 5571:       
 5572:  
 5573:       // Check if this node has essential BC
 5574:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5575:          // Verify BC value is valid
 5576:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5577: 
 5578:        
 5579:          // Set diagonal to 1 and zero off-diagonals
 5580:          node->coeffDiag = 1.0;
 5581: 
 5582:          for (int j = 0; j < node->numNodes; j++) {
 5583:                node->coeffMatrix[j] = 0.0;
 5584:          }
 5585:          
 5586:          // Set solution and RHS to BC value
 5587:          node->mX  = nodeBnd->elbc;
 5588:          node->qel = nodeBnd->elbc;
 5589: 
 5590:       } else {
 5591:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5592: 
 5593:          for (int j = 0; j < node->numNodes; j++) {
 5594:                Node* nbNode = node->nodes[j];
 5595:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5596:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5597:                   // Verify neighbor's BC value
 5598:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5599: 
 5600:                   // Subtract contribution to RHS
 5601:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5602:                   node->coeffMatrix[j] = 0.0;  
 5603:                }
 5604:          }
 5605:       }
 5606:    }
 5607: 
 5608: 
 5609:    __global__ void updateElevation(void) {
 5610:       NODE(node);
 5611: 
 5612: 
 5613:       node->eta2 = node->mX;
 5614: 
 5615:       node->updateZCoordData();
 5616:    }
