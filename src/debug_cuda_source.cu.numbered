 5597: 
 5598: 
 5599:    __global__ void backtrackAllNodes(void) {
 5600: 
 5601:       // max/min # of sub-divisions
 5602:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5603:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5604: 
 5605:       SIDE(side);
 5606: 
 5607:       const int kb = side->kb;
 5608: 
 5609: 
 5610:       // Initialize btrack velocities to the actual velocities at the side 
 5611:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5612:   
 5613:       if (side->isDry) return;
 5614:      
 5615: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5616: 
 5617:       // Checks that at least one element is not dry
 5618:       const Element *elem1 = side->elems[0];
 5619:       const Element *elem2 = side->elems[1];
 5620: 
 5621: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5622: 
 5623:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5624:       
 5625:       // XXXXXX
 5626:       // !swild_tmp to store global coord. of the starting side
 5627:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5628:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5629:       // !Use sframe2 
 5630:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5631: 
 5632: 
 5633:       for (int k = kb; k < nvrt; k++) {
 5634:       //  For ics=2, the coordinates are all in the side's local frame
 5635: 
 5636:          const int iadvf = side->iadv();  // Advection flag   
 5637:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5638: 
 5639:          const double vmag2 = norm2(side->u2[k]);
 5640: 
 5641:          if (vmag2 <= velmin_btrack_sq) {  
 5642:             // No activity 
 5643: 
 5644:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5645:             
 5646:          } else {  // do btrack
 5647: 
 5648:             // Compute number of sub-divisions based on local gradients of the velocity field
 5649: 
 5650:             // XXX IS THIS NECESSARY?
 5651:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5652:             double suma = 0.0;
 5653:             int icount = 0;
 5654:             #pragma unroll
 5655:             for (int l=0; l<2; l++) {
 5656:             // For each element sharing the side...
 5657: 
 5658:                const Element *elem = side->elems[l];
 5659:                  
 5660:                if (elem == nullptr) continue;
 5661: 
 5662:                icount++;
 5663: 
 5664:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5665:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5666:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5667: 
 5668:                double utmp[4];
 5669:                double vtmp[4];
 5670:                #pragma unroll
 5671:                for (int j = 0; j < elem->i34; j++) {
 5672: 
 5673:                   const Node *node = elem->nodes[j];
 5674: 
 5675:                   if constexpr(ics==1) {
 5676:                      utmp[j] = node->u2[k].x;
 5677:                      vtmp[j] = node->u2[k].y;  
 5678: 
 5679:                   } else {
 5680:                      // 'Project' the velocity from the node frame to the element frame
 5681:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5682:                      utmp[j] = tmp_u2.x;
 5683:                      vtmp[j] = tmp_u2.y;
 5684: 
 5685:                   }
 5686:                } // for j
 5687: 
 5688:                const Vector2 grad_u = elem->grad2(utmp); 
 5689:                const Vector2 grad_v = elem->grad2(vtmp);
 5690:    
 5691:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5692:             } // for l
 5693: 
 5694:             assert(icount > 0 && "Impossible 77");
 5695: 
 5696:             // '4' is somewhat arbitrary
 5697:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5698: 
 5699:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5700:             Vector3 u_int = {0.0, 0.0, 0.0};
 5701: 
 5702:             side->btrack(k, dt, dtbk, u_int);
 5703: 
 5704: 
 5705:             side->btu[k] = {u_int.x, u_int.y};
 5706:                
 5707:          } // if vmag (do backtrack)
 5708: 
 5709: 
 5710:       } // for k=kb,nvrt-1
 5711: 
 5712:    }
 5713: 
 5714: } // extern "C"
 5715: 
 5716: template<int nc>
 5717: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5718: 
 5719: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5720: //
 5721: // Although this is a general function, it is used only for equations on vertical levels.
 5722: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5723: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5724: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5725: //
 5726: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5727: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5728: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5729: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5730: 
 5731:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5732:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5733: 
 5734:    double bet = b[0];
 5735:    if constexpr (nc == 1) {
 5736:       u[0] = rhs[0]/bet;
 5737:    } else {
 5738:       #pragma unroll
 5739:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5740:    }
 5741: 
 5742:    for (int j = 1; j < n; j++) {
 5743:       gam[j] = c[j - 1]/bet;
 5744:       bet = b[j] - a[j]*gam[j];
 5745: 
 5746:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5747: 
 5748:       if constexpr (nc == 1) {
 5749:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5750:       } else {
 5751:          #pragma unroll
 5752:          for (int l = 0; l < nc; l++) {
 5753:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5754:          }
 5755:       }
 5756:    }
 5757: 
 5758:    // Back-substitution
 5759:    for (int j = n - 2; j >= 0; j--) {
 5760:       if constexpr (nc == 1) {
 5761:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5762:       } else {
 5763:          for (int l = 0; l < nc; l++) {
 5764:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5765:          }
 5766:       }
 5767:    }
 5768: }
 5769: 
 5770: 
 5771: 
 5772: // Helper function that contains the core algorithm
 5773: template<typename XAccessor, typename YAccessor>
 5774: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5775:                                     double  yp_top, double  yp_bot, 
 5776:                                     CubicSpline &spline) {
 5777:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5778:    // 
 5779:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5780:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5781:    //
 5782:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5783:    // 
 5784:    // Inputs: 
 5785:    //            n: dimension for x etc; # of data pts (>=2);
 5786:    //            getX, getY: functions to access x,y coordinates
 5787:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5788:    //     Output: 
 5789:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5790: 
 5791:    const int n = k2 - k1 + 1;
 5792:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5793: 
 5794:    // Allocate memory for the splines
 5795:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5796:    spline.x   = new double[n];
 5797:    spline.y   = new double[n];
 5798:    spline.yp  = new double[n];
 5799:    spline.ypp = new double[n];
 5800: 
 5801:    for (int k=k1; k<=k2; k++) {
 5802:       spline.x[k] = getX(k);
 5803:       spline.y[k] = getY(k);
 5804:    }
 5805: 
 5806:    // This is to simplify expressions later
 5807:    double *x = spline.x;
 5808:    double *y = spline.y;
 5809: 
 5810:    double *a = nullptr;
 5811:    double *b = nullptr;
 5812:    double *c = nullptr;
 5813:    double *gam = nullptr;
 5814:    double *rhs = nullptr;
 5815:    
 5816: 
 5817:       a = new double[n];   // Lower diagonal
 5818:       b = new double[n];   // Diagonal
 5819:       c = new double[n];   // Upper diagonal
 5820:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5821:       rhs = new double[n]; // Right-hand side
 5822: 
 5823:    for (int k=k1; k<=k2; k++) {
 5824:       if (k == k1) {
 5825:          // Bottom level
 5826:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5827:          b[k] = (x[k+1] - x[k])/3.0;
 5828:          c[k] = b[k]/2.0;
 5829:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5830:       } else if (k == n - 1) {
 5831:          // Top level (surface)
 5832:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5833:          b[k] = (x[k] - x[k-1])/3.0;
 5834:          a[k] = b[k]/2.0;
 5835:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5836:       } else {
 5837:          // Intermediate levels
 5838:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5839:          b[k] = (x[k+1] - x[k-1])/3.0;
 5840:          a[k] = (x[k  ] - x[k-1])/6.0;
 5841:          c[k] = (x[k+1] - x[k  ])/6.0;
 5842:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5843:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5844:       }
 5845:    }
 5846: 
 5847:    // Solve the tridiagonal system
 5848:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5849:    
 5850:    spline.yp[k1] = yp_bot;
 5851:    spline.yp[k2] = yp_top;
 5852: 
 5853:    // Compute rest of 1st derivatives using the splines
 5854:    for (int k=k1+1; k<k2; k++) {
 5855:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5856:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5857:    }
 5858:    
 5859:    delete[] a;
 5860:    delete[] b;
 5861:    delete[] c;
 5862:    delete[] gam;
 5863:    delete[] rhs;
 5864: 
 5865: }
 5866: 
 5867: // Array version
 5868: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5869:                                 double y_top, double y_bot, 
 5870:                                 CubicSpline &spline) {
 5871:    auto getX = [x] (int k) { return x[k]; };
 5872:    auto getY = [y] (int k) { return y[k]; };
 5873:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5874: }
 5875: 
 5876: // Lambda version - allows custom access patterns
 5877: template<typename XFunc, typename YFunc>
 5878: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5879:                                 double y_top, double y_bot,
 5880:                                 CubicSpline &spline) {
 5881:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5882: }
 5883: 
 5884: 
 5885: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 5886: {
 5887:    assert("Not implemented");
 5888: 
 5889:    return 0.0;
 5890: }
