 8583:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8584:          *sizeType = sizeof(int);
 8585:          break;            
 8586:       // case (int)VarCode::w:
 8587:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8588:       //    *sizeType = sizeof(double);
 8589:       //    break;
 8590:       case (int)VarCode::u:
 8591:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8592:          *sizeType = sizeof(Vector2);
 8593:          break;   
 8594:       case (int)VarCode::btu:
 8595:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 8596:          *sizeType = sizeof(Vector2);
 8597:          break;          
 8598:       case (int)VarCode::U:
 8599:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 8600:          *sizeType = sizeof(Vector2);
 8601:          break;
 8602:       case (int)VarCode::gradETP:
 8603:          *offset = (int)((char*)&sides[0].gradETP.x - (char*)sides);
 8604:          *sizeType = sizeof(Vector2);
 8605:          break;
 8606:       case (int)VarCode::gradPr:
 8607:          *offset = (int)((char*)&sides[0].gradPr.x - (char*)sides);
 8608:          *sizeType = sizeof(Vector2);
 8609:          break;
 8610:       case (int)VarCode::gradEta1:
 8611:          *offset = (int)((char*)&sides[0].gradEta1.x - (char*)sides);
 8612:          *sizeType = sizeof(Vector2);
 8613:          break;
 8614:       case (int)VarCode::gradEta2:
 8615:          *offset = (int)((char*)&sides[0].gradEta2.x - (char*)sides);
 8616:          *sizeType = sizeof(Vector2);
 8617:          break;
 8618:       // case (int)VarCode::ghat:
 8619:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 8620:       //    *sizeType = sizeof(Vector2);
 8621:       //    break;   
 8622:       case (int)VarCode::hhat:
 8623:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 8624:          *sizeType = sizeof(Vector2);
 8625:          break;      
 8626:       case (int)VarCode::chi:
 8627:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 8628:          *sizeType = sizeof(double);
 8629:          break;
 8630:       case (int)VarCode::n1:
 8631:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8632:          *sizeType = sizeof(Node);
 8633:          break;
 8634:       case (int)VarCode::n2:
 8635:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8636:          *sizeType = sizeof(Node);
 8637:          break;                   
 8638:       default:
 8639:          *offset = -1;
 8640:    }
 8641: }
