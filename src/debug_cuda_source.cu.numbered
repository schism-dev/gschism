 3950:    __global__ void computeFlowBcVelocities(double time) {
 3951: 
 3952:       SIDE_BND(sideBnd);
 3953: 
 3954:       const Side *side = sideBnd->side;
 3955:  
 3956:       const bool isDry = side->isDry;
 3957: 
 3958:       if (isDry) {
 3959:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 3960:          return;
 3961:       }
 3962: 
 3963:       // For wet sides in open boundaries...
 3964:       const Vector2 n = side->n;
 3965:       const BoundarySegment *segment = sideBnd->segment;
 3966: 
 3967:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 3968: 
 3969:       const int ifltype = segment->ifltype;
 3970:       const int iettype = segment->iettype;
 3971: 
 3972:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 3973:       const Vector2 r_nuth0 = r_uth0*n;
 3974: 
 3975:       for (int k = 0; k < nvrt; k++) {
 3976:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 3977:          Vector2 r_u1_bar = {0.0, 0.0};
 3978:       
 3979:          if (ifltype == 1 || ifltype == 2) {
 3980:          
 3981:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 3982: 
 3983:             const double unth0 = segment->qthcon*ramp/segment->carea;
 3984:             
 3985:             r_uth = unth0*n;  // This case has no ramp-up
 3986:             
 3987:          } else if (ifltype == -1) { // Flather 1
 3988: 
 3989:             // uth is the normal vel.; no ramp up
 3990:             const double uth = sideBnd->nuth(k);
 3991:             r_uth = uth*n;
 3992:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 3993: 
 3994: 
 3995:          } else if (ifltype == 3 || ifltype == 5) {
 3996:             // vnth0=0 !normal vel.
 3997: 
 3998:             // Computes the contribution to the velocity from all tide frequencies
 3999:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4000: 
 4001:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4002:                const Vector2 umo  = sideBnd->umo(jfr); 
 4003: 
 4004:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4005:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4006:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4007:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4008:             }
 4009: 
 4010:          } // if (ifltype = 3 || ifltype == 5
 4011: 
 4012: 
 4013:          switch (iettype) {
 4014:             case 1:
 4015:             case 2:
 4016:             case 4:
 4017:                sideBnd->ubc[k] = r_uth;
 4018:                break;
 4019:             case 3:
 4020:                sideBnd->ubc[k] = r_u1_bar;
 4021:                break;
 4022:             case 5:
 4023:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4024:                break;
 4025:          } // switch
 4026: 
 4027:       } // for k
 4028:    }
 4029: 
 4030:    __global__ void computeElevationBoundaryConditions(double time) {
 4031:       // Compute elevation essential boundary conditions 
 4032: 
 4033:       NODE_BND(nodeBnd); // Each boundary node.
 4034: 
 4035:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4036: 
 4037:       const Node *node = nodeBnd->node;
 4038:       const BoundarySegment *segment = nodeBnd->segment;
 4039:       const int iettype = segment->iettype;
 4040:       
 4041: 
 4042:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4043:       double eic = 0.0;
 4044:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4045:       else                 eic = 0.0;
 4046: 
 4047:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4048:       const double r_eth = ramp*nodeBnd->eth;
 4049:       double r_eta1_bar = 0.0;
 4050: 
 4051: 
 4052:       // Compute tide elevation
 4053:       if (iettype == 3 || iettype == 5) {   
 4054: 
 4055:          if constexpr(iloadtide==1) { // loading tide
 4056:             assert(false && "Loading tide not implemented");
 4057:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4058:          }
 4059:          
 4060:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4061: 
 4062:             const double efa  = nodeBnd->efa[jfr]; 
 4063:             const double emo  = nodeBnd->emo[jfr]; 
 4064: 
 4065:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4066:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4067:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4068: 
 4069:          } // for jfr
 4070: 
 4071:       } // if iettype
 4072: 
 4073:       switch (iettype) {
 4074:          case 1:
 4075:          case 2:
 4076:          case 4:
 4077:             nodeBnd->elbc = r_eic + r_eth;
 4078:             break;
 4079:          case 3:
 4080:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4081:             break;
 4082:          case 5:
 4083:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4084:             break;
 4085:       } // switch
 4086: 
 4087: 
 4088:       //Add inverse barometric effects
 4089:       if (iettype != 0 && inv_atm_bnd == 1) {
 4090:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4091:       }
 4092: 
 4093:    }
 4094: 
 4095: 
 4096:    __global__ void computeHorizontalViscosity(void) { 
 4097: 
 4098:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4099: 
 4100:       SIDE(side);
 4101: 
 4102:       if (side->isDry) return;
 4103: 
 4104:       for (int k = 0; k < nvrt; k++) {
 4105:          side->nuGradU[k] = {0.0, 0.0};
 4106:       }
 4107: 
 4108:       if constexpr(ihorcon == 1) {
 4109:          for (int k = side->kb; k < nvrt - 1; k++) {
 4110:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4111:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4112:             // By Zhang and Baptista.
 4113: 
 4114:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4115:             // This is a standard discretization of the Laplacian operator.
 4116:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4117:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4118:             // Gamma is hvis_coef0 in the code.
 4119:             // The value of gamma needs to be < 0.5.
 4120: 
 4121:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4122:             // side under consideration in each of the two possible elements that share the side.
 4123:             Vector2 sumU = {0.0, 0.0};
 4124:             for (int l = 0; l < 2; l++) {
 4125:                const Element *elem = side->elems[l];
 4126: 
 4127:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4128: 
 4129:                // Find the local index of the side in the element
 4130:                const int idxSide = elem->sideLocalIdx(side);
 4131:                // Find the two sides that are connected to the side under consideration
 4132:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4133:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4134: 
 4135:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4136: 
 4137:             }
 4138: 
 4139:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4140:    
 4141:          }
 4142:       }
 4143:       else if constexpr(ihorcon == 2) {
 4144:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4145:       }
 4146: 
 4147: 
 4148:    }
 4149: 
 4150: 
 4151:    __global__ void setEssentialBC(void) {
 4152:       // Set essential boundary conditions 
 4153:       NODE(node); // Each boundary node
 4154:       NodeBoundary *nodeBnd = node->nodeBnd;
 4155:       
 4156: // nodeBnd->isEssentialBC = true;      
 4157:       // Check if this node has essential BC
 4158:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4159:          // Verify BC value is valid
 4160:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4161: 
 4162:        
 4163:          // Set diagonal to 1 and zero off-diagonals
 4164:          node->coeffDiag = 1.0;
 4165: 
 4166:          for (int j = 0; j < node->numNodes; j++) {
 4167:                node->coeffMatrix[j] = 0.0;
 4168:          }
 4169:          
 4170:          // Set solution and RHS to BC value
 4171:          node->mX  = nodeBnd->elbc;
 4172:          node->qel = nodeBnd->elbc;
 4173: 
 4174:       } else {
 4175:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4176: 
 4177:          for (int j = 0; j < node->numNodes; j++) {
 4178:                Node* nbNode = node->nodes[j];
 4179:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4180:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4181:                   // Verify neighbor's BC value
 4182:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4183: 
 4184:                   // Subtract contribution to RHS
 4185:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4186:                   node->coeffMatrix[j] = 0.0;  
 4187:                }
 4188:          }
 4189:       }
 4190:    }
 4191: 
 4192: 
 4193:    __global__ void updateElevation(void) {
 4194:       NODE(node);
 4195: 
 4196:       node->eta2 = node->mX;
 4197:    }
