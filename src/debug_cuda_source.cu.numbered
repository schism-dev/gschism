 1636: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1637:    // Computes the 3D normal vector to the element at level k
 1638:    // Returns the normal vector and the area of the element
 1639: 
 1640:       if (isTri()) {
 1641:          // For triangles...
 1642: 
 1643:          // Gets the normal vector to the element (with a length equal to twice the area)
 1644:          if constexpr(ics==1) {
 1645:             const int kb0 = max(k, nodes[0]->kb);
 1646:             const int kb1 = max(k, nodes[1]->kb);
 1647:             const int kb2 = max(k, nodes[2]->kb);
 1648: 
 1649:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1650:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1651:             
 1652:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1653:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1654:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1655:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1656: 
 1657:             area3D = sqrt(nx*nx + ny*ny + nz*nz);
 1658: 
 1659:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1660: 
 1661:             return {nx/area3D, ny/area3D, nz/area3D};
 1662: 
 1663:            
 1664:          }
 1665:          else {  // lat/lon
 1666:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1667: 
 1668:          } // if ics
 1669:       }
 1670:       else {
 1671:          // For quads...
 1672: 
 1673:          assert(false && "Element normal vector: quads not yet implemented");
 1674: 
 1675: 
 1676:       }
 1677:    }
 1678: 
 1679: /**
 1680:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1681:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1682:    If the segment is completely inside the element, then it returns true.
 1683: 
 1684:    This function assumes:
 1685:    - The initial point is on a side of the element. 
 1686:    - Its position is given by parameter t in the range [0,1].
 1687:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1688:       intersects the element (elements are convex).
 1689: 
 1690:    To find the intersection point, this function does the following:
 1691:    - it finds the intersection of the line segment with all the element side lines,
 1692:       except for the one that contains the initial point.
 1693:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1694:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1695:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1696:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1697:       track segment is almost parallel to the element side line.
 1698: 
 1699:    Inputs:
 1700:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1701:    @param x2, y2: other end of the line segment
 1702: 
 1703:    Outputs:
 1704:    @param side:  side that intersects the line segment (input and output)
 1705:    @param nextElement (output): element that contains the intersection point
 1706:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1707:    @param zint (input/output): Vertical coordinate of the intersection point
 1708: 
 1709:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1710:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1711:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1712: 
 1713:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1714:    (Delta) being zero.
 1715: 
 1716:    The intersection2 point happens when:
 1717:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1718:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1719:    
 1720:    Assumption: the 4 points (including those of the side segment) are different.
 1721:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1722:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1723:    If true, (xIntersect,yIntersect) is the intersection.				
 1724:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1725: **/
 1726: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1727:                                               double &t, double& tIntersect) {
 1728: 
 1729:    double closest_intersect_t = 1e10;
 1730:    bool found_intersection = false;
 1731: 
 1732:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1733:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1734:    const Point2 x1 = side->point(t);
 1735:    
 1736: 
 1737:    Side *nextSide = nullptr;
 1738:    for (int i = 0; i < i34; i++) {
 1739: 
 1740:       // Element's i-th side 
 1741:       Side *side2 = sides[i];
 1742: 
 1743:       // Skip the side that contains the initial point
 1744:       if (side2 == side) continue;
 1745: 
 1746:       // (x3,y3)-(x4,y4) is the element side line
 1747:       const Point2 x3 = side2->n1->p2();
 1748:       const Point2 x4 = side2->n2->p2();
 1749: 
 1750:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1751:       const double delta = cross(x2 - x1, x3 - x4);
 1752: 
 1753:       if (delta != 0.0) {
 1754: 
 1755:          const double delta1 = cross(x3 - x1, x3 - x4);
 1756:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1757: 
 1758:          // Solves the two linear equations for tt1 and tt2
 1759:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1760:          const double tt2 = delta2/delta;
 1761: 
 1762:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1763:             closest_intersect_t = min(closest_intersect_t, tt1);
 1764:             nextSide = side2;
 1765: 
 1766:             nextElement = nextSide->otherElem(this);
 1767:             tIntersect = max(small, min(tt1, 1.0-small));
 1768:             t = tt2;
 1769: 
 1770:             found_intersection = true;
 1771:          }
 1772:       
 1773:       }
 1774: 
 1775:    }
 1776:    
 1777: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1778: 
 1779: 
 1780:    // found_intersection should always be true, since we checked all the sides.  
 1781:    side = nextSide;
 1782: // if (found_intersection) {
 1783: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1784: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1785: // }   
 1786:    // if (!found_intersection) {
 1787:    //    // Check if the segment is parallel to the initial side
 1788:    //    printf("XXX segment: side = %p\n", side);
 1789:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1790:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1791:    //       assert(false && "Segment is parallel to the initial side");
 1792:    //       found_intersection = true;
 1793:    //       nextElement = side->otherElem(this);
 1794:    //       tIntersect = t;
 1795:    //       t = 0.0;
 1796:    //       found_intersection = true;
 1797:    //    }
 1798:    // }
 1799:    return found_intersection;
 1800: }
