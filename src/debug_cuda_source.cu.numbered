 2962: 
 2963: __device__ void Node::updateKb(void) {
 2964: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2965: 
 2966:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 2967: 
 2968: 
 2969:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2970: 
 2971:    if constexpr(ivcor == 2) {  // SZ coordinates
 2972:       
 2973:       // Compute bottom level index
 2974:       if (depth <= mesh->h_s) {
 2975:          kb = izlev;   
 2976:          
 2977:       } else {
 2978:          kb = -1;
 2979:          int L = 0;
 2980:          int R = nzlev; 
 2981:          
 2982:          while (L <= R) {
 2983:             int M = (R + L) / 2;
 2984: 
 2985: 
 2986:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2987:             
 2988:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2989:                R = M;
 2990:             } else {
 2991:                L = M;
 2992:             }
 2993: 
 2994:             if (R - L == 1) {
 2995:                kb = L;
 2996:                break;
 2997:             }
 2998:          }
 2999: 
 3000:          // Checks that the binary search was successful
 3001:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3002:        
 3003:       }
 3004:    } 
 3005: }
 3006: 
 3007: 
 3008: __device__ __inline__ void Node::updateZCoordData(void) {
 3009: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3010: 
 3011:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3012:    // if (isDry2()) {
 3013:    //    kb = -1;  // XXXXXXXX KKKKK
 3014:    //    return;
 3015:    // }
 3016: 
 3017: 
 3018:    if constexpr(ivcor == 2) {  // SZ coordinates
 3019:       
 3020:       // Compute bottom level index
 3021:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3022:    } 
 3023:    else if (ivcor == 1) {  // Localized sigma
 3024:       // Do nothing
 3025:    }
 3026: 
 3027: 
 3028: }
 3029: 
 3030: 
 3031: __device__ double Node::compZCoord(int k) const {
 3032:    // Computes the z coordinate at level k.
 3033:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3034:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3035:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3036:    // used 
 3037: 
 3038:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 3039:    
 3040:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3041: 
 3042:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 3043: 
 3044:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 3045: 
 3046:    if constexpr(ivcor == 2) {
 3047: 
 3048:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3049:       const double h_c = mesh->h_c;
 3050:       const double theta_f = mesh->theta_f;
 3051:       const double sinh_theta_f = mesh->sinh_theta_f;
 3052: 
 3053: 
 3054:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3055:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3056:       // once per time step/node.
 3057:       // CHECK: updateZCoordData
 3058: 
 3059:       //  To simplify comparisons, I define index versions of count variables.
 3060:       if      (k == ivrt)     return eta2; 
 3061:       else if (k == izlev)    return -hmod2;
 3062:       else if (k == kb)       return -depth;
 3063:       else if (k < izlev)     return mesh->ztot[k];
 3064:       else if (k > izlev) {
 3065:          const int ksig = k - izlev;
 3066: 
 3067:          if (hmod2 <= h_c) {
 3068:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3069: 
 3070:          } 
 3071:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3072:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3073:             assert(false && "ZCOOR (1): invalid h_c\n");
 3074:          } 
 3075:          else {
 3076:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3077:                    h_c * mesh->sigma[ksig] + 
 3078:                    (hmod2 - h_c) * mesh->cs[ksig];
 3079:          }
 3080:       } else { 
 3081:          assert(false && "ZCOOR (2): invalid level or coordinate system\n");
 3082:       }
 3083: 
 3084:    }
 3085:    else if constexpr(ivcor == 1) {
 3086:       if (k <= kb)        return -depth; 
 3087:       else if (k == ivrt) return eta2;
 3088:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3089:    }
 3090:    
 3091:    assert(false && "ZCOOR (3): invalid level or coordinate system\n");
 3092:    return 0.0;
 3093: }
 3094: 
 3095: 
 3096: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3097:    // Computes the bottom drag Cd based on the selected nchi
 3098: 
 3099:    if constexpr(nchi == 0) {
 3100:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3101:       Cd = drag;  // Read from drag file
 3102: 
 3103:    } else if constexpr(nchi == 1) {
 3104:       // 
 3105: 
 3106:       bool ltmp = false; // for WBL iteration
 3107: 
 3108:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3109:       if (isDry || (rough == 0.0)) {
 3110:          Cd = 0.0;
 3111: 
 3112:       } else { //roughness >0 
 3113:          
 3114:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3115: 
 3116:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3117: 
 3118:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3119: 
 3120:       } // if rough
 3121: 
 3122:    } else if constexpr(nchi == -1) {
 3123:    // Manning 
 3124:  
 3125:       const double htot = max(hmin_man, htot2()); 
 3126:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3127: 
 3128:    } else {
 3129:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3130:       
 3131:    } // if nchi
 3132: 
 3133: }
 3134: 
 3135: 
 3136: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3137:    // Checks if a side in on the boundary
 3138:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3139: 
 3140:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3141:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3142: 
 3143:    // Indices of the nodes that form the side
 3144:    const int n1 = side.n1->idx;
 3145:    const int n2 = side.n2->idx;
 3146:    isLand = false;
 3147:    
 3148: 
 3149:    // Check if the side is on a land boundary
 3150:    for (int i = 0; i < nland; i++) {
 3151:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3152:          // Consecutive nodes in the land boundary segment
 3153:          const int b1 = ilnd[i + j*nland];
 3154:          const int b2 = ilnd[i + (j + 1)*nland];
 3155: 
 3156:          assert(b1 != -1 && b2 != -1);
 3157: 
 3158:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3159:             
 3160:             isLand = true;
 3161:             return i;
 3162:          }
 3163:       }
 3164:    }
 3165: 
 3166:    // Check if the side is on an open boundary
 3167:    for (int i = 0; i < nope; i++) {
 3168:       for (int j = 0; j < nond[i] - 1; j++) {
 3169:          // Consecutive nodes in the open boundary segment
 3170:          const int b1 = iond[i + j*nope];
 3171:          const int b2 = iond[i + (j + 1)*nope];
 3172: 
 3173:          assert(b1 != -1 && b2 != -1);
 3174: 
 3175:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3176:             isLand = false;
 3177:             return i;
 3178:          }
 3179:       }
 3180:    }
 3181: 
 3182:    return -1;
 3183: }
 3184: 
 3185: 
 3186: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3187:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3188:                                     double *wind_rotate_angle, 
 3189:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3190:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3191:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3192:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3193:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3194: 
 3195:    NODE(pnode);  
 3196:    const int i = idx_node;
 3197:    Node &node(*pnode);
 3198: 
 3199:    node.idx = i;
 3200: 
 3201:    const int idxNodeStart = nodeNeighNodesStart[i];
 3202:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3203:    node.numNodes = idxNodeEnd - idxNodeStart;
 3204:    node.nodes = nodeNeighNodes + idxNodeStart;
 3205:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3206: 
 3207: 
 3208: 
 3209:    const int idxElemStart = nodeNeighElemsStart[i];
 3210:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3211:    node.numElements = idxElemEnd - idxElemStart;
 3212:    node.elements = nodeNeighElems + idxElemStart;
 3213: 
 3214: 
 3215:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3216:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3217:       const int partNode = localNodePart[idxNodeGlobal]; 
 3218:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3219: 
 3220:       Node *node_ptr = nodes[partNode] + idxNode;
 3221:       
 3222:       nodeNeighNodes[idx] = node_ptr;
 3223:    }
 3224: 
 3225: 
 3226:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3227:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3228:       const int partElem = localElemPart[idxElemGlobal];
 3229:       const int idxElem  = localElemIndices[idxElemGlobal];
 3230: 
 3231:       Element *elem_ptr = elems[partElem] + idxElem;
 3232: 
 3233:       nodeNeighElems[idx] = elem_ptr;
 3234:    }      
 3235: 
 3236:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3237:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3238: 
 3239:    node.p.x   = node_coords[i * 3];
 3240:    node.p.y   = node_coords[i * 3 + 1];
 3241:    node.depth = node_coords[i * 3 + 2];
 3242: 
 3243:    if (use_ll) {
 3244:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3245:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3246:    }
 3247: 
 3248: 
 3249:    node.numSides = 0;
 3250: 
 3251:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3252:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3253:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3254:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3255:    else assert(false && "populateNodes: selected nchi not implemented.");
 3256:    
 3257:    if constexpr(ivcor == 1) 
 3258:    {  
 3259:       node.kb = kb[i];
 3260:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3261:    }
 3262: 
 3263:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3264:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3265:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3266: 
 3267:    
 3268:    // Links the node to the boundary information
 3269:    if (isbnd[i] >= 0) {
 3270:      
 3271:       // Get the index of the node boundary
 3272:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3273: 
 3274:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3275:       node.nodeBnd->node = &node;
 3276: 
 3277:       node.nodeBnd->sideBnd1 = nullptr;
 3278:       node.nodeBnd->sideBnd2 = nullptr;
 3279: 
 3280:       if (isbnd[i]>=0) {
 3281: 
 3282:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3283:          
 3284:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3285:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3286: 
 3287:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3288:          node.nodeBnd->segment->clen  = nan("1");
 3289:          node.nodeBnd->segment->carea = nan("1");
 3290: 
 3291:       }
 3292:    } else {
 3293: 
 3294:       node.nodeBnd = nullptr; // For internal nodes
 3295: 
 3296:       if (isbnd[i] == landSegment) {
 3297:          node.nodeBnd = &landBoundaryNode;
 3298:          node.nodeBnd->segment = &landBoundarySegment;
 3299:       }
 3300:       
 3301:    }
 3302:    
 3303:    // XXXX GAUSSIAN HILL VELOCITIES
 3304: #ifdef GAUSSIAN_HILL_VELOCITIES
 3305:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3306:       constexpr double rot_per = 3000.0;
 3307:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3308:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3309:    // XXXXX
 3310: #endif
 3311: 
 3312: }
 3313: 
 3314: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3315:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3316:                                     double *wind_rotate_angle,   
 3317:                                     int *isdel, int *isidenode, int *isbnd,
 3318:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3319:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3320:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3321:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3322:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3323:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3324:                                     double *drag, double *roughness) {
 3325: 
 3326: 
 3327:    SIDE(pside);
 3328:    Side &side(*pside);
 3329:    const int i = idx_side;
 3330: 
 3331:    side.idx = i;  
 3332:    
 3333:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3334:    const double fc   = 2.0*omega_e*sin(sfea0);
 3335:    const double beta = 2.0*omega_e*cos(sfea0);
 3336: 
 3337:    // finding the pointer to the nodes that form the side
 3338:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3339:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3340: 
 3341:    const int locidx_n1 = localNodeIndices[idx_n1];
 3342:    const int locidx_n2 = localNodeIndices[idx_n2];
 3343:    const int part_n1 =   localNodePart[idx_n1];
 3344:    const int part_n2 =   localNodePart[idx_n2];
 3345: 
 3346:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3347:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3348: 
 3349:    // Counts the number of sides connected to each node
 3350:    side.n1->numSides++;
 3351:    side.n2->numSides++;
 3352: 
 3353:    // Normal, unitary vector to the side
 3354:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3355:    side.n = normalize(side.n);
 3356: 
 3357:    // Side boundary type
 3358:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3359:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3360: 
 3361:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3362:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3363:    {
 3364:       bool isLand = false;
 3365:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3366:       
 3367:       if (isbs > -1) {
 3368:          // assert(isLand || isbs>=0);
 3369:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3370: 
 3371:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3372: 
 3373:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3374:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3375: 
 3376:          assert (isLand == side.sideBnd->segment->isLand);
 3377: 
 3378:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3379:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3380:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3381: 
 3382:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3383:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3384:          
 3385:          side.sideBnd->side = &side;
 3386: 
 3387:       }
 3388:       else {
 3389:          side.sideBnd = nullptr;
 3390:       }
 3391:    }
 3392:    else 
 3393:    {
 3394:       side.sideBnd = nullptr;
 3395:    }
 3396: 
 3397: 
 3398:    // finding the pointer to the elements that share the side
 3399:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3400:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3401: 
 3402:    if (idx_e1 > -1) {
 3403:       const int locidx_e1 = localElemIndices[idx_e1];
 3404:       const int part_e1 =  localElemPart[idx_e1];
 3405:       side.elems[0] = elems[part_e1] + locidx_e1;
 3406: 
 3407:    }
 3408:    else {
 3409:       side.elems[0] = nullptr;
 3410:    }
 3411: 
 3412:    if (idx_e2 > -1) {
 3413:       const int locidx_e2 = localElemIndices[idx_e2];
 3414:       const int part_e2 =  localElemPart[idx_e2];
 3415:       side.elems[1] = elems[part_e2] + locidx_e2;
 3416:    }
 3417:    else {
 3418:       side.elems[1] = nullptr;
 3419:    }
 3420: 
 3421:    // Compute the center of the side
 3422:    side.center = 0.5*(side.n1->p + side.n2->p);
 3423: 
 3424:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3425:    side.shapiro = shapiro0;
 3426: 
 3427: #ifdef GAUSSIAN_HILL_VELOCITIES
 3428: // XXXX
 3429: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3430: constexpr double rot_per=3000.0;
 3431: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3432: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3433: // XXXXX      
 3434: #endif
 3435:    // Compute the z level at the center of the side
 3436:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3437:    
 3438:    // Compute the length of the side
 3439:    const Vector2 vLen = side.n2->p - side.n1->p;
 3440:    side.len = sqrt(dot(vLen, vLen));
 3441: 
 3442: 
 3443:    // Compute the Coriolis coefficient
 3444: 
 3445:    if constexpr(ncor == -1 || ncor == 0) {
 3446:       side.coriolis = coricoef;
 3447:    }
 3448:    else {
 3449:       const double sphi = side.lat();  // Latitude at the center of the side
 3450: 
 3451: // XXXXXX ERROR WHEN use_ll is false??????
 3452:       if constexpr(ics == 1) {
 3453:          // XXXXXXX
 3454:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3455:       }
 3456:       else {
 3457:          side.coriolis = 2.0*omega_e*sin(sphi);  // XXX Sin()? Can it be optimized?
 3458:       }
 3459: 
 3460:    }
 3461: 
 3462: }
 3463: 
 3464: 
 3465: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3466:    double *node_coords, double *node_coords_ll, bool use_ll,
 3467:    double *wind_rotate_angle,   
 3468:    int *isdel, int *isidenode, int *isbnd,
 3469:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3470:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3471:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3472:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3473:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3474:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3475:    double *drag, double *roughness) {
 3476: 
 3477:    ELEM(pelem);
 3478:    Element &elem(*pelem);
 3479:    const int i = idx_elem;
 3480: 
 3481:    elem.idx = i;
 3482: 
 3483:    for (int j = 0; j < i34[i]; j++) {
 3484:       const int idxNode = elnode[i*4 + j];  
 3485:       const int idxSide = elside[i*4 + j];
 3486:       
 3487:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3488:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3489: 
 3490:       // Find the neighboring element  
 3491:       if (elem.sides[j]->elems[0] == &elem) {
 3492:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3493:       }
 3494:       else {
 3495:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3496:       }
 3497:       
 3498:    }
 3499: 
 3500:    elem.i34 = i34[i];
 3501: 
 3502:    // Compute the barycenter of the element and its depth
 3503:    elem.center = {0.0, 0.0};
 3504:    elem.depth = 0.0;
 3505:    for (int j = 0; j < i34[i]; j++) {
 3506: 
 3507:       elem.center += elem.nodes[j]->p/i34[i];
 3508:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3509:    }
 3510: 
 3511: 
 3512:    
 3513:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3514:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3515: 
 3516:    elem.area = elem.computeSignedArea(); 
 3517:    elem.radius = sqrt(elem.area)/pi; 
 3518:    
 3519:    // Determines which way the normal vector to each side is oriented.
 3520:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3521:    for (int j = 0; j < i34[i]; j++)  
 3522:    {
 3523:       if (elem.sides[j]->elems[0] == &elem) {
 3524:          elem.ssign[j] =  1.0;
 3525:       }
 3526:       else {
 3527:          elem.ssign[j] = -1.0;
 3528:       }
 3529: 
 3530:    }
 3531: 
 3532:    // Derivatives of shape functions
 3533:    //  For ics=2, this is done inside element/ll frame XXX
 3534:    //  For quads, the derivative is evaluated at centroid
 3535:    for (int j = 0; j < elem.i34; j++) {
 3536:       const double area = elem.area;
 3537:       const int id2 = elem.nxq(1 + j);
 3538:       const int id3 = elem.nxq(2 + j);
 3539:       const int id4 = elem.nxq(3 + j);
 3540:       if (elem.isTri()) {
 3541:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3542:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3543:          // da1/dx = (y1 - y2)/(2*area)
 3544: 
 3545:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 3546:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3547:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 3548: 
 3549:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 3550:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 3551: 
 3552:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3553:       }
 3554:       else  { // Quad; evaluate at centroid
 3555: 
 3556:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 3557:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3558:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 3559: 
 3560:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 3561:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 3562: 
 3563:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3564:       } // if Tri
 3565: 
 3566:    } // for j   
 3567:    
 3568:    
 3569: 
 3570: }
 3571: 
 3572: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3573:                                             double *emo, double *efa, 
 3574:                                             double *umo, double *ufa, 
 3575:                                             double *vmo, double *vfa) {
 3576: 
 3577:    NODE_BND(nodeBnd);
 3578:    const int idx = idx_node_bnd;    
 3579: 
 3580:    nodeBnd->idx = idx;
 3581: 
 3582:    // Need to find the segment index and the index of the node on the segment
 3583:    int idxNode = -1;
 3584:    int iseg, i;
 3585:    for (iseg = 0; iseg < nope; iseg++) {
 3586:       // for each segment...
 3587:       for (i = 0; i < nond[iseg]; i++) {
 3588:          idxNode = iond[iseg + i*nope];
 3589:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3590:          
 3591:       }
 3592:    }
 3593: 
 3594:    assert(iseg < nope && "iseg is out of bounds");
 3595: 
 3596: found: // Jumped here when the node was found
 3597: 
 3598:    nodeBnd->isEssentialBC = true;
 3599:    nodeBnd->elbc = 0.0;
 3600: 
 3601:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3602: 
 3603:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3604:       nodeBnd->efa[jfr] = efa[idx2];
 3605:       nodeBnd->emo[jfr] = emo[idx2];
 3606:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3607:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3608: 
 3609:    }
 3610:         
 3611: 
 3612: }
