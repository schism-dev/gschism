 7702: __global__ void printMatrix(bool full) {
 7703:    // Debugging: print the matrix
 7704: 
 7705:    const int size = mesh->np;
 7706:    double sum = 0.0;
 7707:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7708:       const Node *node = mesh->localNodeData + idx_node;
 7709:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7710:       for (int j = 0; j < node->numNodes; j++) {
 7711:          Node* nbNode = node->nodes[j];
 7712:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7713:          sum += node->coeffMatrix[j];
 7714:       }
 7715:       if (full) printf("]\n");
 7716: 
 7717: 
 7718:    }
 7719:    if (!full) printf("sum=%lf\n", sum);
 7720: }
