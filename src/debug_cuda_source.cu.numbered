 2171:    template<typename T>
 2172:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2173:       T values[4];
 2174:       getNodalValues(level, func, values);
 2175: 
 2176:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2177:       if constexpr (IsVector2<T>::value && ics == 2) {
 2178: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2179:          projectNodeVectorsToElementFrame(values);
 2180: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2181:       }
 2182: 
 2183:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2184:    }
 2185: 
 2186:    template<typename T>
 2187:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2188:       T values[4];
 2189:       getNodalValues(field, values);
 2190: 
 2191:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2192:       if constexpr (IsVector2<T>::value && ics == 2) {
 2193: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2194:          projectNodeVectorsToElementFrame(values);
 2195: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2196:       }
 2197:       
 2198:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2199:    }
