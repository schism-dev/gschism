 4255:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4256: 
 4257:       NODE_BND(nodeBnd);
 4258: 
 4259:       Node *node = nodeBnd->node;
 4260: 
 4261:       node->ETP = 0.0;
 4262: 
 4263:       for (int j=0; j<ntip; j++) {
 4264: 
 4265:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4266:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4267: printf("RAAAAMP  ramp = %f, arg = %f\n", ramp, arg);         
 4268:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4269: 
 4270:          if constexpr(iloadtide==1) { // loading tide
 4271:             assert(false && "Loading tide not implemented");
 4272:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4273:          }
 4274:          
 4275:       }
 4276:       
 4277:    }
