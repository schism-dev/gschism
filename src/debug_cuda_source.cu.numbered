 3441: // __device__ void vertLinearInterp(double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 3442: // //     Routine to do vertical linear interpolation in z
 3443: // //     Inputs:
 3444: // //
 3445: // //       k1,k2: lower and upper limits for za, s_in 
 3446: // //       zt: desired interpolation level
 3447: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 3448: // //       s_in[0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 3449: // //     Outputs:
