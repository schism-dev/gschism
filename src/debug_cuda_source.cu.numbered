  714:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  715:                                         double& tIntersect);
  716: 
  717:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  718:       // Check if the point (xt,yt) is inside the element
  719:       double shpCoords[4];
  720: 
  721:       bool res = computeShapeCoords(xt, shpCoords, fiNo);
  722: 
  723:       return res;
  724:    }
  725: 
  726:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  727:       // Check if the point (xt,yt) is inside the element.
  728:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  729:       double shpCoords[4];
  730: 
  731:       Vector2 tmp_xt = xt;
  732:       const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
  733:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords);
  734: 
  735:       if (fixCoords && res) xt = tmp_xt;
  736: 
  737:       return res;
  738:    }
  739: 
  740:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  741:    {
  742:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  743:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  744:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  745:       
  746:    }
