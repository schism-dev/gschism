 5653:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5654: 
 5655:       SIDE(side);
 5656: 
 5657:       side->U = {0.0, 0.0}; 
 5658:          
 5659:       if(side->isDry) return;
 5660: 
 5661:       // Vertically integrated velocity U
 5662:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5663:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5664:          side->U += side->Dz(k + 1)*uc;  
 5665:       }
 5666: 
 5667:    }
 5668: 
 5669:    __global__ void computeBottomDragVegetation(void) {
 5670:       // UNFINISHED. CHECK THIS:
 5671:       // How many kernels are needed? Why so many for loops?
 5672:       // Is the loop on sides needed?
 5673: 
 5674:       NODE(node);
 5675: 
 5676: 
 5677:       const int    kb      = node->kb;
 5678:       const double htot    = node->htot2(); 
 5679:       
 5680:       if (node->isDry) {
 5681:          // Default values for dry nodes
 5682:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5683:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5684: 
 5685:          return;
 5686:        
 5687:       }
 5688: 
 5689:       // Computes bottom drag Cd based on the selected nchi
 5690:       node->computeBottomDragCd();
 5691:       
 5692: 
 5693: 
 5694:       //   Bottom stress in m^2/s^2
 5695:       if (node->rho[kb + 1] >= -98.0)
 5696:       {
 5697:          const double mag_u = length(node->u2[kb + 1]);
 5698:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5699: 
 5700:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5701:          // !sediment erosion: this part needs more documentation
 5702:       }
 5703:     
 5704: 
 5705: 
 5706:       // Compute vegetation parameters
 5707:       //--------------------------------
 5708: 
 5709:       // SAV constants
 5710:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5711:       constexpr double veg_cfpsi = 0.16;
 5712: 
 5713:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5714:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5715: 
 5716:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5717:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5718:          int kbin = 0; // bin index
 5719:          for (int k = kb; k < nvrt; k++) {
 5720:             // Computes node height above the bottom level
 5721:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5722:             assert(false && "Vertical variation of vegetation not implemented");
 5723: 
 5724:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5725:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5726:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5727:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5728:             // } else {
 5729:             //    // Find the bin at which the current vertical level is
 5730:             //    while (kbin<nbins_veg_vert) {
 5731:             //       const double zn = node->z[kbin];
 5732:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5733:             //          break;
 5734:             //       } // if
 5735:             //       kbin++;
 5736:             //    } // while
 5737:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5738: 
 5739:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5740:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5741:                
 5742:             //    // Linear interpolation of the vegetation parameters
 5743:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5744:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5745:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5746:             // } // if rl10
 5747: 
 5748:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5749: 
 5750:          } // for k
 5751: 
 5752: 
 5753:       } else { // Ganthy (iveg==2)
 5754:       //  Modify canopy height, diameter, and density
 5755: 
 5756:          // Make sure there is vegetation on this node
 5757:          if (node->veg_h_unbent > 0.0) {
 5758:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5759: 
 5760:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5761:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5762:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5763: 
 5764:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5765:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5766:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5767:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5768:          } // if veg_h_unbent
 5769: 
 5770:          for (int k = 0; k < nvrt; k++) {
 5771:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5772:          } // for k
 5773:       
 5774: 
 5775:       } // if iveg
 5776:      
 5777: 
 5778:       // Compute vertical mean of veg_alpha3D
 5779:       if (iveg != 0) {
 5780:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5781:          double sum1=0.0;
 5782:          double sum2=0.0;
 5783:          // Integrate over each level under the canopy...
 5784:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5785:             const double Dz = node->Dz(k);
 5786: 
 5787:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5788:             sum2 += Dz;
 5789: 
 5790:          } // for k
 5791:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5792:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5793: 
 5794:       } // if iveg
 5795: 
 5796:    }
 5797: 
 5798:    __global__ void computeVegetationAndDragParameters(void) {
 5799:       // Computes the vegetation and drag model parameters:
 5800:       // chi, \tilde\chi, beta, \breve{H}
 5801:       
 5802:       SIDE(side);
 5803: 
 5804:       side->hhat = 0.0;
 5805:       side->chi2 = 0.0;
 5806:       side->chi = 0.0;
 5807:       side->veg_c2 = 0.0;
 5808:       side->veg_beta = 0.0;
 5809: 
 5810:       if (side->isDry) return;
 5811: 
 5812:       const double htot = side->htot2();
 5813:       const int    kb   = side->kb;
 5814: 
 5815:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5816: 
 5817:       const double veg_h     = side->veg_h();
 5818:       const double veg_nv    = side->veg_nv();
 5819:       const double veg_c     = side->veg_c();
 5820:       const double veg_beta  = side->veg_beta;
 5821:       const double veg_alpha = side->veg_alpha_vert_mean();
 5822: 
 5823:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5824:       // Velocity magnitude at the bottom level
 5825:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5826:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5827:       side->chi2 = side->Cd()*vmag1;
 5828:       side->chi  = side->chi2;
 5829: 
 5830:       if constexpr(iveg != 0) {
 5831:          const Node *n1 = side->n1;
 5832:          const Node *n2 = side->n2;
 5833:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5834:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5835:       }
 5836: 
 5837:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5838: 
 5839:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5840:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5841:       double magUa = 0.0;
 5842:       if constexpr(iveg != 0) {
 5843:          if (side->is3D() && veg_h > 0.0) {
 5844:             // 3D wet side with veg...
 5845: 
 5846:             double magUa = 0.0;
 5847:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5848:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5849: 
 5850:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5851:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5852:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5853: 
 5854:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5855:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5856: 
 5857:                   // Velocity magnitude at the bottom (l) of the level
 5858:                   const double ul = length(side->u2[k]);
 5859: 
 5860:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5861:                   magUa += Dz*0.5*(uh + ul);
 5862: 
 5863:                } // if HasVegetation
 5864:             } // for k
 5865:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5866: 
 5867:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5868:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5869:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5870:                const double zCpy = side->zTopCanopy();
 5871:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5872:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5873:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5874:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5875:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5876:             } // if isSubmerged
 5877:          } // if is3D
 5878:       } // if iveg   
 5879: 
 5880:       // Computes the friction modified depth, \breve{H} in notes
 5881:       if (side->is2D()) { // 2D
 5882: 
 5883:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5884:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5885: 
 5886:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5887: 
 5888:          side->hhat = htot*htot/fricH; 
 5889: 
 5890:       } else { // 3D
 5891:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5892: 
 5893:          if constexpr(iveg != 0) {
 5894:             
 5895:             if (side->isSubmerged()) { 
 5896:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5897:                side->hhat -= veg_c*Hhat_alpha;
 5898: 
 5899:             } else { // Emergent
 5900:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5901:             }
 5902:          } // if iveg
 5903: 
 5904:          // Enforce positivity for 3D model
 5905:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5906:       } // if 3D
 5907: 
 5908:    }
 5909: 
 5910: 
 5911: 
 5912:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5913:    // Computes the density gradient between two elements, e1 and e2.
 5914:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5915:    // zero in the direction normal to the side. 
 5916:    // 
 5917:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5918:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5919:    //
 5920:    // Input:
 5921:    //    e1: Element
 5922:    //    e2: Neighbor element (or nullptr if boundary)
 5923:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5924:    //    k: Index of the half-level at which the density is interpolated
 5925:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5926:    // 
 5927:    // Output:
 5928:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5929:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5930: 
 5931:       if (e2 == nullptr || e2->isDry) {
 5932:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5933: 
 5934:          Side *side = e1->sides[j];
 5935:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5936:                  
 5937:          if constexpr(ics == 1) {
 5938:             vec = side->n; // Normal vector to the side
 5939:          } else {
 5940:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5941:             // IMPLEMENT THIS XXXXXX
 5942:             // !replace with xel, yel?
 5943:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5944:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5945:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5946:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5947:          } //ics
 5948:                    
 5949:          diffRho = 0.0;
 5950: 
 5951:       } else { //internal and wet
 5952:          if constexpr(ics==1) {
 5953:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5954: 
 5955:             // Vector from e1 to e2
 5956:             vec = e2->center - e1->center;
 5957: 
 5958:          } else { 
 5959:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5960:             // Remember that elem->center is in global coordinates
 5961:             // IMPLEMENT THIS XXXXXX
 5962:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5963:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5964:             //                   alow(j)=xctr2
 5965:             //                   bdia(j)=yctr2
 5966:          } // ics
 5967: 
 5968:          diffRho = rho2 - e1->demeanedDensity(k);
 5969:       }
 5970: 
 5971:    }
 5972: 
 5973:    __global__ void computeDensityCubicSplines(void) {
 5974:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5975: 
 5976:       ELEM(elem);
 5977: 
 5978:       if (elem->isDry) return;
 5979: 
 5980:       const int kb = elem->kb;
 5981: 
 5982:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5983:       if (elem->is2D()) {
 5984:          // In the 2D case, the density is constant at the prism level. 
 5985:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5986:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5987:       } else { //3D
 5988: 
 5989:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5990:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5991:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5992:          ///// XXXX CHECK INDICES!!!!!
 5993:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5994:       } // 2D/3D
 5995: 
 5996:    }
 5997: } // extern "C"
 5998: 
 5999: 
 6000: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6001: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6002: 
 6003:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6004: 
 6005:    const int kb  = elem->kb;
 6006:    const int kb2 = elem2->kb;
 6007: 
 6008:    // z-coordinate of prism of elem
 6009:    const double zp = elem->z_prism(k);
 6010: 
 6011:    double rho = 0.0;
 6012: 
 6013:    if (elem2->is2D()) {
 6014:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6015: 
 6016:    } else {  // 3D
 6017: 
 6018:       // eta_min may be < zmax
 6019:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6020:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6021: 
 6022:       // (Extrapolate density below bottom, we will fix it later)
 6023:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6024:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6025:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6026:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6027:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6028:    } // 2D/3D
 6029:      
 6030: 
 6031:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6032:    // Now we need to fix it.
 6033:    if (elem->z[k] < elem2->z[kb2]) {
 6034:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6035: 
 6036:       // There are two methods to adjust the density at the bottom of the element.
 6037:       // iunder_deep=0: 
 6038:       const double depth1 = abs(elem->z[kb]); // larger depth
 6039: 
 6040:       if (iunder_deep==0) {
 6041: 
 6042:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6043: 
 6044:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6045: 
 6046:       } else { // iunder_deep != 0
 6047: 
 6048:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6049: 
 6050:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6051: 
 6052:          //   Demeaned density at the same z coordinate as
 6053:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6054:          }
 6055: 
 6056:       } // if iunder_deep
 6057:    } // if elem->z[kb] < elem2->z[kb]
 6058: 
 6059:    return rho;
 6060: }
 6061: 
 6062: 
 6063: extern "C" {
 6064:    __global__ void computeDensityGradient(void) {
 6065: 
 6066:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6067:       if constexpr(ibc != 0) return;
 6068: 
 6069:          // Compute the horizontal density gradient at each element.
 6070:       // It works in two steps:
 6071:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6072:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6073:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6074:       //             gradRho.r1 = rho1 - rho0
 6075:       //             gradRho.r2 = rho2 - rho0
 6076:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6077:       // 
 6078:       //  NOTE: We use de-meaned densities.
 6079: 
 6080:       ELEM(elem);
 6081: 
 6082:       if (elem->isDry) return;
 6083: 
 6084:       const int kb  = elem->kb;
 6085:       const int i34 = elem->i34;
 6086: 
 6087:       for (int k = kb + 1; k < nvrt; k++) {
 6088:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6089:          //             gradRho.r1 = rho1 - rho0
 6090:          //             gradRho.r2 = rho2 - rho0
 6091:          int icount = 0;
 6092:          double sumRx = 0.0;
 6093:          double sumRy = 0.0;
 6094:          for (int j1=0; j1<i34; j1++) { 
 6095: 
 6096:             const int j2 = elem->nxq(j1 + 1);
 6097: 
 6098:             // Pairs of consecutive neighbor elements of elem
 6099:             const Element *e1 = elem->nghbElems[j1];
 6100:             const Element *e2 = elem->nghbElems[j2];
 6101: 
 6102:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6103:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6104:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6105: 
 6106:             // Compute the density difference and the vector from elem to e1 and e2
 6107:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6108:             double diffRho1, diffRho2;
 6109:             Vector2 vec1, vec2;
 6110:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6111:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6112: 
 6113:             const double rl1 = length(vec1);
 6114:             const double rl2 = length(vec2);
 6115:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6116: 
 6117:             const double delta = cross(vec1, vec2);
 6118:             const double sintheta = abs(delta)/(rl1*rl2);
 6119: 
 6120:             // To avoid problems, avoid elements with small angle between vectors
 6121:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6122:             const bool validEq = (sintheta > sin_one_deg);
 6123: 
 6124:             if (validEq) {
 6125:                // Solve the system of equations to get the density gradient at elem
 6126:                icount++;
 6127:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6128:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6129:                sumRx += Rx;
 6130:                sumRy += Ry;
 6131:             }
 6132:          } // for j1
 6133: 
 6134:          // Compute the average density gradient at elem
 6135:          if (icount==0) {
 6136:            // Bad mesh quality; bail out with 0 b-cc
 6137:            elem->gradRho[k] = {0.0, 0.0};
 6138:          } else {
 6139:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6140:          }
 6141: 
 6142:       } // for k
 6143: 
 6144:    }
 6145: 
 6146:    __global__ void computeBaroclinicTerm(void) {
 6147:    // Computes the baroclinic term at sides (at half levels).
 6148:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6149:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6150: 
 6151:       if (ibc == 1) return;
 6152: 
 6153:       SIDE(side);
 6154: 
 6155:       if (side->isDry) return;
 6156: 
 6157:       const Element *e1 = side->elems[0];
 6158:       const Element *e2 = side->elems[1]; 
 6159:       const int kb = side->kb;
 6160:       
 6161:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6162: 
 6163:       // interpolates vertically the density gradient of the two elements at the half level/
 6164: 
 6165:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6166:       int k2 = max(kb, nvrt / 2);
 6167: 
 6168:       // Starts the integration at the surface and goes down to the bottom
 6169:       side->bcc[nvrt-1] = {0.0, 0.0};
 6170:       for (int k = nvrt - 2; k >= kb; k--) {
 6171:       // For each prism level (from surface to bottom)...
 6172: 
 6173:          // For both elements, interpolate density gradient at the side's half level.
 6174:          // The gradient at the side is the average of the gradients at the elements.
 6175:          // w1, w2 are used to take into account boundary sides, with just one element.
 6176:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6177:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6178:          const double wsum = w1 + w2;
 6179:          w1 = w1/wsum;
 6180:          w2 = w2/wsum;
 6181:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6182: 
 6183:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6184:          Vector2 gradRho = {0.0, 0.0};
 6185:          if (e1 != nullptr && k > kb) {
 6186:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6187:             
 6188:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6189:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6190:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6191: 
 6192:             // Grad(rho) vertically interpolated at the side's half level
 6193:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6194: 
 6195:             // Projects the element density gradient to the side frame if needed.
 6196:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6197: 
 6198:             // Adds the contribution of the density gradient at the side's half level
 6199:             gradRho += gradRho1*w1;
 6200:          }      
 6201:          if (e2 != nullptr && k > kb) {
 6202:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6203:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6204:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6205:             
 6206:             // Grad(rho) vertically interpolated at the side's half level
 6207:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6208: 
 6209:             // Projects the element density gradient to the side frame if needed.
 6210:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6211: 
 6212:             // Adds the contribution of the density gradient at the side's half level
 6213:             gradRho += gradRho2*w2;
 6214:          }
 6215: 
 6216:          
 6217:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6218:          // multiplied by -rampbc*(g/rho0) 
 6219:          const double grav3 = side->grav3();
 6220:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6221: 
 6222:       } // for
 6223: 
 6224:    }
 6225: 
 6226: 
 6227: 
 6228:    __global__ void computeHorGradientAtSide(void) {
 6229: 
 6230:       // Compute the horizontal density gradient at each element.
 6231:       // It works in two steps:
 6232:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6233:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6234:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6235:       //             gradRho.r1 = rho1 - rho0
 6236:       //             gradRho.r2 = rho2 - rho0
 6237:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6238:       // 
 6239:       //  NOTE: We use de-meaned densities.
 6240: 
 6241:       SIDE(side);
 6242: 
 6243: 
 6244:       if (side->isDry) return;
 6245: 
 6246:       // Computes the gradient of the variables at the side center.
 6247:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6248:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6249:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6250: 
 6251:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6252:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6253:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6254:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6255: 
 6256:    }
 6257: 
 6258: 
 6259:    __global__ void solveMomentumEquations(double time) {
 6260: 
 6261:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6262:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6263: 
 6264:       SIDE(side);
 6265: 
 6266:       if (side->isDry) 
 6267:       {
 6268:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6269: 
 6270:          return;
 6271:       }
 6272: 
 6273:       const Node *n1 = side->n1;
 6274:       const Node *n2 = side->n2;
 6275: 
 6276:       const int kb = side->kb;
 6277: 
 6278:       const double veg_h = side->veg_h();
 6279:       const double grav3 = side->grav3();
 6280: 
 6281:       if (side->is2D()) {
 6282:          // Remember: Do not use htot2, which is updated.
 6283:          const double htot = side->htot1();
 6284:          const double hhat = side->hhat;
 6285: 
 6286:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6287: 
 6288:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6289:          const Vector2 tau2 = side->tau();
 6290: 
 6291:          // hat_gam has units of m/s
 6292: 
 6293:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6294:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6295:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6296: 
 6297:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6298: 
 6299: 
 6300:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6301: 
 6302:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6303: 
 6304:       }
 6305:       else { // 3D
 6306: 
 6307:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6308:          // 
 6309:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6310:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6311:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6312:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6313:          // k+1 and k.
 6314: 
 6315: 
 6316:          const int ndim = nvrt - kb;
 6317:          const double zTopCanopy = side->zTopCanopy();
 6318: 
 6319:          // Initialize the tridiagonal system
 6320:          for (int k = kb + 1; k < nvrt; k++) {
 6321:             
 6322:             const int kin = k - (kb + 1);
 6323: 
 6324:             // Vertical viscosity at the face center
 6325:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6326: 
 6327:  
 6328:             alow[kin] = 0.0;
 6329:             cupp[kin] = 0.0;
 6330:             bdia[kin] = 0.0;
 6331: 
 6332:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6333:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6334: 
 6335:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6336:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6337:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6338: 
 6339:             // First part: layers k, k+1
 6340:             if (k < nvrt - 1) {
 6341:                              
 6342:                if constexpr(iveg != 0) {
 6343: 
 6344:                   // If there is vegetation at this level...
 6345:                   if (zTopCanopy > side->zc[k]) {
 6346:                      // If the canopy is above the k layer...
 6347:                      
 6348:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6349:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6350:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6351:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6352: 
 6353:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6354:                      const double vmag2 = length(ut2);
 6355:                      const double vmag1 = length(side->u2[k]);
 6356:                      const double vmag = 0.5*(vmag1 + vmag2);
 6357:                      
 6358:                      // Computes the vegetation alpha at the face center
 6359:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6360: 
 6361:                      cff1 += veg_alpha_sd*dt*vmag;
 6362: 
 6363:                   } // if (zTopCanopy
 6364:                } // if iveg
 6365: 
 6366:                const double dzz = side->Dz(k + 1);
 6367:                const double tmp = dt*dfz/dzz;
 6368:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6369: 
 6370:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6371:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6372:             }
 6373: 
 6374: 
 6375:             // Second part: layers k-1, k
 6376:             if (k > kb + 1) {
 6377: 
 6378:                double cff1 = 1.0; //init \bar{c^k}
 6379: 
 6380:                if constexpr(iveg != 0) {
 6381:                   // If there is vegetation at this level...
 6382:                   if (zTopCanopy > side->zc[k-1]) {
 6383:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6384:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6385: 
 6386:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6387: 
 6388:                      const double vmag2 = length(ut2);
 6389:                      const double vmag1 = length(side->u2[k-1]);
 6390:                      const double vmag = 0.5*(vmag1 + vmag2);
 6391: 
 6392:                      // Computes the vegetation alpha at the face center
 6393:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6394:                      cff1 += veg_alpha_sd*dt*vmag;
 6395:                   } // if zTopCanopy
 6396: 
 6397:                } // if iveg
 6398: 
 6399:                const double dzz = side->Dz(k);
 6400:                const double tmp = dt*dfz/dzz;
 6401:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6402: 
 6403:                alow[kin] += cff1*dzz/6.0 - tmp;
 6404:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6405: 
 6406:             } else { // Bottom boundary
 6407:                // This occurs at the bottom, where the bottom drag is applied.
 6408: 
 6409:                bdia[kin] += dt*side->chi2; // XXXX
 6410: 
 6411:             } // if (k > kb + 1)
 6412: 
 6413: 
 6414:          } // for (int k
 6415: 
 6416: 
 6417: 
 6418:          // Computes the RHS.
 6419:          // -----------------
 6420: 
 6421:          //	BC to be imposed at the end.
 6422: 
 6423:          const Vector2 gradETP  = side->gradETP;
 6424:          const Vector2 gradPr   = side->gradPr;
 6425:          const Vector2 gradEta1 = side->gradEta1;
 6426:          const Vector2 gradEta2 = side->gradEta2;
 6427: 
 6428:          const Vector2 *btu = side->btu;
 6429:          const Vector2 *u2  = side->u2;
 6430:          const double coriolis = side->coriolis;
 6431:          const Vector2 *nuGradU = side->nuGradU;
 6432: 
 6433:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6434:          for (int k = kb + 1; k < nvrt; k++) {
 6435:             const int kin = k - kb - 1;
 6436: 
 6437:             const double dz_0 = side->Dz(k);
 6438:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6439: 
 6440:             rrhs[kin] = {0.0, 0.0};
 6441:             double dz = 0.0;
 6442: 
 6443:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6444:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6445:             if (k < nvrt  ) dz += dz_1;
 6446:             if (k > kb + 1) dz += dz_0;
 6447: 
 6448:             // Elevation gradient, atmospheric pressure and tidal potential
 6449:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6450: 
 6451:             // Coriolis, advection, wind stress, and horizontal viscosity
 6452:             if (k < nvrt - 1) {
 6453: 
 6454: 
 6455:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6456:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6457:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6458:                                                 
 6459: 
 6460:                //diff stress tensors 1006
 6461:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6462:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6463:                   assert(false && "Not implemented: itur == 5");
 6464:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6465:                }
 6466:                // else assert(false && "itur # Not implemented");
 6467: 
 6468:             } else { // k == nvrt - 1 SURFACE
 6469:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6470:                const Vector2 tau2 = side->tau();
 6471: 
 6472:                rrhs[kin] += dt*tau2;          
 6473: 
 6474:             } // if k<nvrt
 6475: 
 6476: 
 6477:             if (k > kb + 1) {
 6478:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6479:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6480:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6481: 
 6482:                // diff stress tensors 1006
 6483:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6484:                   assert(false && "Not implemented: itur == 5");
 6485:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6486:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6487:                }
 6488:                // else assert(false && "itur # Not implemented");
 6489: 
 6490: 
 6491:             } // if k>kbs + 1
 6492: 
 6493:             // Baroclinic
 6494:             Vector2 *bcc = side->bcc;
 6495:             if constexpr(ibc == 0) {
 6496:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6497:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6498: 
 6499:             } // if ibc==0
 6500: 
 6501:          } // k=kb + 1,nvrt
 6502: 
 6503: 
 6504:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6505: 
 6506:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6507:             const int kin = k - kb - 1;
 6508:    
 6509:             // Velocity is always clamped to maximum values
 6510:             side->u2[k] = clampVelocity(soln[kin]);
 6511:          } // k
 6512: 
 6513:       } // if side->is2D()
 6514:       
 6515: 
 6516:       // Impose velocity boundary condition at the bottom
 6517:       if constexpr(imm == 2) { // 3D bed deformation model
 6518:          double dep;
 6519:          Vector2 vel;
 6520: 
 6521:          assert(false && "Not implemented: imm == 2");
 6522:          //update_bdef(time, x0, y0, dep, vel);
 6523:          // side->u2[kb] = vel;
 6524: 
 6525:       } else { // imm = 0 or 1
 6526:          if (side->Cd() == 0.0) {
 6527:             side->u2[kb] = side->u2[kb + 1];
 6528: 
 6529:          } else if (side->is3D()) { // 3D no slip bottom   
 6530:             side->u2[kb] = {0.0, 0.0};
 6531: 
 6532:          }
 6533:           
 6534:       } // if imm
 6535: 
 6536:       // The velocities below the bottom level are set to zero
 6537:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6538: 
 6539: 
 6540:    }
 6541: 
 6542: 
 6543:    __global__ void applyMomentumBC(void) {
 6544: 
 6545:       SIDE_BND(sideBnd);
 6546: 
 6547:       Side *side = sideBnd->side;
 6548:       const BoundarySegment *segment = sideBnd->segment;
 6549:       const Node *n1 = side->n1;
 6550:       const Node *n2 = side->n2;
 6551: 
 6552:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6553: 
 6554:       const bool isLand = segment->isLand;
 6555:       const int ifltype = segment->ifltype;
 6556: 
 6557:       const int kb = side->kb;
 6558: 
 6559: 
 6560:       if (!isLand && ifltype != 0) {
 6561:          const Vector2 *ubc = sideBnd->ubc;
 6562:   
 6563:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6564:             
 6565:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6566:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6567: 
 6568:             if (ifltype == -1) {
 6569:                // Flather 1
 6570: 
 6571:                const double depth = side->depth();
 6572: 
 6573:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6574: 
 6575:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6576: 
 6577:                side->u2[k] = vnorm*side->n;
 6578: 
 6579:             } else if (ifltype == -2) { // Discharge
 6580: 
 6581:                const double eta1 = side->eta1();
 6582:                const double eta2 = side->eta2();
 6583:                const double htot = side->htot2();
 6584: 
 6585:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6586:                assert(false && "Not implemented: Discharge bc");
 6587:                // const double dischrg = discharge(eta1);
 6588:                const double dischrg = 0.0; // XXX REMOVE
 6589:                
 6590: 
 6591:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6592: 
 6593:                const double vnorm = dischrg*eta2/htot;
 6594: 
 6595:                side->u2[k] = vnorm*side->n;
 6596: 
 6597:             }
 6598:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6599:                const double vnorm = dot(side->u2[k], side->n);
 6600: 
 6601:                double rat;
 6602:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6603:                else              rat = segment->vobc2; // outgoing
 6604: 
 6605:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6606: 
 6607:             }
 6608:             else { // not Flather or 3D radiation
 6609:                side->u2[k] = ubc[k];
 6610: 
 6611:             } // if (segment->ifltype...
 6612: 
 6613:          }
 6614: 
 6615:       }
 6616:       else if (isLand) { // if it is land boundary side
 6617: 
 6618:          if constexpr(islip == 0) { // free slip
 6619: 
 6620:             for (int k = kb; k < nvrt; k++) {
 6621: 
 6622:                const Vector2 t = side->t();
 6623:                const Vector2 n = side->n;
 6624: 
 6625:                double vnorm = 0.0; // for most cases
 6626:                const double vtan = dot(side->u2[k], t);
 6627:                
 6628:                side->u2[k] = vtan*t - vnorm*n;
 6629: 
 6630:             }
 6631: 
 6632:          } else { // no slip
 6633:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6634: 
 6635:          }
 6636:       } // if (side segment type...
 6637: 
 6638:    }
 6639: 
 6640: 
 6641:    __global__ void shapiroFilter1(void) {
 6642:       // First step of the Shapiro filter (normally used if indvel<=0)
 6643:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6644: 
 6645:       SIDE(side);
 6646: 
 6647:       // Only internal wet sides are processed
 6648:       if (side->isDry || !(side->isInternal())) return;
 6649: 
 6650:       const int kb = side->kb;
 6651: 
 6652:       for (int mm = 0; mm < niter_shap; mm++) {
 6653: 
 6654:          for (int k = kb + 1; k < nvrt; k++) {
 6655:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6656:             Vector2 suru = {0.0, 0.0};
 6657: 
 6658:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6659: 
 6660:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6661: 
 6662:                int kin = k;
 6663:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6664:                
 6665:                // Get the velocity at the neighbor's side.
 6666:                Vector2 nSideU2 = nSide->u2[kin];
 6667: 
 6668:                // Projects the velocity to the current side frame if needed.
 6669:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6670: 
 6671:                suru += nSideU2;
 6672:             }
 6673: 
 6674:             // Reusing bcc as a temporary array to store the suru values.
 6675:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6676: 
 6677:          }
 6678:       }
 6679:    }
 6680: 
 6681:    __global__ void shapiroFilter2(void) {
 6682:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6683: 
 6684:       SIDE(side);
 6685: 
 6686: 
 6687:       if (side->isDry || !(side->isInternal())) return;
 6688: 
 6689:       const int kb = side->kb;
 6690: 
 6691:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6692: 
 6693:       if (side->is2D()) {
 6694:          side->u2[kb + 1] = side->bcc[kb + 1];
 6695:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6696: 
 6697:       } else {
 6698:          // 3D
 6699:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6700:          
 6701:       }
 6702: 
 6703:    }
 6704: 
 6705: 
 6706:    __global__ void ul0UpdateZCoords(void) {
 6707:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6708:       
 6709:       NODE(node);      
 6710: 
 6711: 
 6712:       if (false) { //node->isDry) { XXXXXXX
 6713: 
 6714:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6715: 
 6716:          if constexpr(ivcor != 1) node->kb = 0;
 6717: 
 6718:       } else {
 6719: 
 6720:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6721:          node->updateKb();
 6722: 
 6723:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6724: 
 6725:       }
 6726: 
 6727:       // We use the temp.b field to store the previous state of isDry.
 6728:       node->tmp.b = node->isDry;
 6729: 
 6730:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6731:       node->isDry = true;
 6732: 
 6733:    }
 6734: 
 6735:    __global__ void ul0ComputeDryElements(void)
 6736:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6737:    {
 6738:       ELEM(elem);
 6739: 
 6740:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6741: 
 6742:       elem->kb = 0;
 6743: 
 6744:       if (elem->isDry) return;
 6745: 
 6746: 
 6747:    //    if(elem->isDry2()) { // XXXX
 6748:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6749:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6750:    //        call parallel_abort(errmsg)
 6751:    //    }
 6752: 
 6753:       const Node *n1 = elem->nodes[0];
 6754:       const Node *n2 = elem->nodes[1];
 6755:       const Node *n3 = elem->nodes[2];  
 6756:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6757: 
 6758:       // Computes element's kb as the minimum of the nodes' kb.
 6759:       const int kb1 = n1->kb;
 6760:       const int kb2 = n2->kb;
 6761:       const int kb3 = n3->kb;
 6762:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6763: 
 6764: 
 6765:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6766: 
 6767: 
 6768:       // Computes the element z as the mean of the nodes z.
 6769:       for (int k = elem->kb; k < nvrt; k++) {
 6770: 
 6771:          // Compute the element z as the mean of the nodes z.
 6772:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6773:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6774:          elem->z[k] /= elem->i34;
 6775: 
 6776:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6777:       }
 6778:                   
 6779:    }
 6780: 
 6781:    __global__ void ul0ComputeDryNodes(void)
 6782:    // Updates node's isDry based on the elements' isDry. 
 6783:    {
 6784:       NODE(node);
 6785: 
 6786:       node->isDry = true;
 6787: 
 6788:       // A node is wet if at least one of the elements sharing it is wet.
 6789:       for (int j = 0; j < node->numElements; j++) {
 6790:          const Element *elem = node->elements[j];
 6791:          if (!elem->isDry) {
 6792:             node->isDry = false;
 6793:             break;
 6794:          }
 6795:       }
 6796: 
 6797:        
 6798:    }
 6799: 
 6800: 
 6801:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6802:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6803:    // node->tmp.b is true if the node was previously dry.
 6804:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6805:    {
 6806:       NODE(node);
 6807:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6808: 
 6809:       // Avoid this the first time step.
 6810:       if (it == iths) return;  
 6811: 
 6812:       const bool wasDry = node->tmp.b;
 6813: 
 6814: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6815: 
 6816:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6817: 
 6818:          for (int k=0; k < nvrt; k++) {
 6819: 
 6820:             Vector3 utmp={0.0, 0.0, 0.0};
 6821: 
 6822:             double ttmp=0.0;
 6823:             double stmp=0.0;
 6824:             int icount=0;
 6825:             for (int j = 0; j < node->numNodes; j++) {
 6826: 
 6827:                const Node *nbrNode = node->nodes[j];
 6828:                
 6829:                const bool wasNbrDry = nbrNode->tmp.b;
 6830: 
 6831:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6832:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6833: 
 6834:                   icount++;
 6835: 
 6836:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6837:                   utmp += nbrNode->uvw2(k);
 6838:                   
 6839:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6840:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6841:                }
 6842:             }
 6843: 
 6844:             if (icount > 0) {
 6845:                const double inv_icount = 1.0/icount;
 6846:                utmp = inv_icount*utmp;
 6847:                node->u2[k]     = {utmp.x, utmp.y};
 6848:                node->w2[k]     = utmp.z;
 6849:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6850:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6851:             } else {
 6852:                node->u2[k] = {0.0, 0.0};
 6853:                node->w2[k] = 0.0;
 6854:                // Initialize tracers to 0.0??? XXXXX
 6855:             }
 6856:          }
 6857:       }
 6858:    }
 6859: 
 6860:   
 6861:    
 6862: 
 6863: 
 6864:    __global__ void ul0UpdateSides(int it, int iths) {
 6865:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6866:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6867:    // The dryness of the sides is updated in ul0UpdateSides2.
 6868: 
 6869:       SIDE(side);
 6870: 
 6871:       // A side is wet if and only if at least one of its elements is wet.
 6872:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6873:  
 6874:       const Node *n1 = side->n1;
 6875:       const Node *n2 = side->n2;
 6876:      
 6877:       const int kb1 = n1->kb;
 6878:       const int kb2 = n2->kb;
 6879: 
 6880:       side->kb = 0; // default when dry
 6881: 
 6882:       if (isWet) {
 6883: 
 6884:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6885: 
 6886:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6887: 
 6888:          side->kb = min(kb1, kb2);
 6889: 
 6890:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6891: 
 6892:          for (int k = side->kb; k < nvrt; k++) {
 6893:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6894: 
 6895:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6896: 
 6897:             // Compute velocity for re-wetted sides 
 6898:             if ((it != iths) && (side->isDry && isWet)) {
 6899: 
 6900:                Vector2 utmp={0.0, 0.0};
 6901: 
 6902:                int icount=0;
 6903: 
 6904:                // For all the sides on the two elements that share this side
 6905:                for (int j = 0; j < 2; j++) {
 6906:                   const Element *elem = side->elems[j];
 6907:                   if (elem == nullptr) continue;
 6908: 
 6909:                   for (int jj=0; jj < elem->i34; jj++) {
 6910:                      const Side *nSide = elem->sides[jj];
 6911:                      if (nSide->isDry) continue;
 6912: 
 6913:                      icount++;
 6914:                      utmp += nSide->u2[k];  
 6915:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6916:                   }
 6917:                }
 6918:                   
 6919:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6920:                if (icount > 0)  side->u2[k] = utmp/icount;
 6921:                else             side->u2[k] = {0.0, 0.0};
 6922:                   
 6923:             } // if ((it != iths) && (side->isDry && isWet))
 6924: 
 6925:          } // for k
 6926: 
 6927:       } // if isWet 
 6928:       
 6929: 
 6930: 
 6931:    }
 6932: 
 6933:    __global__ void ul0UpdateSides2(void) {
 6934:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6935:    
 6936:          SIDE(side);
 6937:    
 6938:          const Element *e1 = side->elems[0];
 6939:          const Element *e2 = side->elems[1];
 6940: 
 6941:          // A side is wet if and only if at least one of its elements is wet.
 6942:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6943: 
 6944:          // Update the side's dryness
 6945:          side->isDry = !isWet;
 6946: 
 6947:    }
 6948: 
 6949: 
 6950:    __global__ void zeroNodalVelocities(void) {
 6951:       NODE(node);
 6952: 
 6953:       for (int k = 0; k < nvrt; k++) {
 6954:          node->u2[k]   = {0.0, 0.0};
 6955:          node->w2[k]   = 0.0;
 6956:          node->utmp[k] = {0.0, 0.0};         
 6957:       }
 6958:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6959:    }
 6960:  
 6961: 
 6962:    __global__ void computeNodalVerticalVelocities1(void) {
 6963:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6964:    // Adds the element's vertical velocity times the element's area.
 6965:       ELEM(elem);
 6966: 
 6967:       for (int j = 0; j < elem->i34; j++) {
 6968:          Node *node = elem->nodes[j];
 6969: 
 6970:          for (int k = node->kb; k < nvrt; k++) {
 6971:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6972:          }
 6973:          atomicAdd(&(node->tmp.d), elem->area);
 6974:       }
 6975:    }
 6976: 
 6977:    __global__ void computeNodalVerticalVelocities2(void) {
 6978:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6979:    // Divides by the total area of the elements sharing the    node.
 6980:       NODE(node);
 6981: 
 6982: 
 6983:       const double invArea = 1.0 / node->tmp.d;
 6984:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6985: 
 6986:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6987:    }
 6988: 
 6989: 
 6990:    __global__ void computeNodalHorizontalVelocities1(void) {
 6991: 
 6992:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6993: 
 6994:       ELEM(elem);
 6995: 
 6996:       if (elem->isDry) return;
 6997: 
 6998:       const int kb = elem->kb;
 6999:       const bool isTri = elem->isTri();
 7000: 
 7001:       if constexpr(indvel <= 0) {
 7002:          // Assuming discontinous hvel.
 7003: 
 7004:          if (isTri) { // For triangles
 7005:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7006:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7007:             #pragma unroll
 7008:             for (int j = 0; j < 3; j++) {
 7009:                // For every node of the triangle...
 7010:                Node *node = elem->nodes[j];
 7011: 
 7012:                if (node->isDry) continue;
 7013: 
 7014:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7015:                const Side *s2 = elem->sides[(j + 1) % 3];
 7016:                const Side *s3 = elem->sides[(j + 2) % 3];
 7017: 
 7018:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7019: 
 7020:                atomicAdd(&(node->tmp.i), 1);
 7021: 
 7022:                for (int k = kb; k < nvrt; k++)  {
 7023:                   Vector2 s1u2 = s1->u2[k];
 7024:                   Vector2 s2u2 = s2->u2[k];
 7025:                   Vector2 s3u2 = s3->u2[k];
 7026: 
 7027:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7028:                   if constexpr(ics == 2) {
 7029:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7030:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7031:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7032:                   }
 7033: 
 7034:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7035:                   u = clampVelocity(u);
 7036:                   atomicAdd(&(node->utmp[k].x), u.x);
 7037:                   atomicAdd(&(node->utmp[k].y), u.y);
 7038: 
 7039:                }
 7040: 
 7041:             }
 7042:          }
 7043:          else { // For quads
 7044: 
 7045: 
 7046:             // Compute the bilinear coordinates of the center of each diagonal.
 7047:             double xi, eta;
 7048:             double shp13[4], shp24[4];
 7049:             Point2 x0, x1, x2, x3;
 7050:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7051:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7052:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7053: 
 7054:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7055:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7056: 
 7057: 
 7058: 
 7059: 
 7060:             for (int k = kb; k < nvrt; k++) {
 7061: 
 7062:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7063:                Vector2 sideU[4];
 7064:                #pragma unroll
 7065:                for (int j = 0; j < 4; j++) {
 7066:                   Vector2 u = elem->sides[j]->u2[k];
 7067:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7068:                   sideU[j] = u;
 7069:                }
 7070: 
 7071:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7072:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7073: 
 7074:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7075:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7076:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7077:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7078:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7079:                #pragma unroll
 7080:                for (int j = 0; j < 4; j++) {
 7081:                   Node *node = elem->nodes[j];
 7082:                   if (node->isDry) continue;
 7083: 
 7084:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7085:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7086:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7087:                }
 7088:             }
 7089: 
 7090:          }
 7091: 
 7092:       }
 7093:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7094:       
 7095:    }
 7096: 
 7097: 
 7098:    __global__ void computeNodalHorizontalVelocities2(void) {
 7099:       NODE(node);
 7100: 
 7101:       const int nodeCount = node->tmp.i;
 7102: 
 7103:       if (nodeCount == 0) 
 7104:       {
 7105:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7106:          return;
 7107:       }
 7108: 
 7109:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7110:       
 7111:       const int kb = node->kb;
 7112: 
 7113:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7114:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7115:       
 7116:       
 7117:    }   
 7118: 
 7119:  
 7120: 
 7121:    __global__ void resetVelocityOpenBndNodes(void) {
 7122:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7123: 
 7124:       NODE_BND(nodebnd);
 7125: printf("DDDDDDDDDD\n");  // XXXXXXX
 7126:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7127:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7128:       }
 7129: 
 7130:    }
 7131: 
 7132: 
 7133:    __global__ void setVelocityOpenBndNodes(void) {
 7134:    // For open boundary nodes sets their velocity to the imposed values.
 7135: 
 7136:       SIDE_BND(sidebnd);
 7137: 
 7138:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7139:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7140:          // to its segment to the average of the side velocity.
 7141: 
 7142:          for (int k = 0; k < nvrt; k++) {
 7143:             Node *n1 = sidebnd->side->n1;
 7144:             Node *n2 = sidebnd->side->n2;
 7145: 
 7146: 
 7147:             Vector2 n1_u2(n1->u2[k]);
 7148:             Vector2 n2_u2(n2->u2[k]);
 7149: 
 7150:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7151:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7152:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7153:             }
 7154:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7155:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7156:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7157:             }
 7158: 
 7159:          }
 7160: 
 7161:       }
 7162: 
 7163:    }
 7164: 
 7165: 
 7166:    __global__ void computeVerticalVelocity(void) {
 7167:       // Computes the vertical velocity at the (2D) element's centroid.
 7168:       // In this function we will be considering volumetric elements, with side faces and a 
 7169:       // bottom and a top face. We will call them SFs, BF and TF.
 7170:       // It computes the flux coming from BF and the SFs.
 7171:       // If the bed is moving, it takes that into account.
 7172:       // Since water is incompressible, the integral of the velocity times the normal vector
 7173:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7174:       // and the BF is equal to the flux going out from the TF.
 7175:       // TF = - BF - sum(SFs).
 7176:       // It then computes the horizontal velocity at the center of TF.
 7177:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7178:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7179:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7180: 
 7181:       ELEM(elem);
 7182: 
 7183:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7184: 
 7185:       if (elem->isDry) return;
 7186: 
 7187:       const int kb = elem->kb;
 7188:       const bool isTri = elem->isTri();
 7189: 
 7190:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7191: 
 7192:       // Compute the bottom velocity
 7193:       if constexpr(imm != 0) {
 7194:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7195:       }
 7196: 
 7197: 
 7198:       double bottomArea3D;
 7199:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7200: 
 7201:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7202: 
 7203:       double topArea3D;
 7204: 
 7205:       // Bottom face flux
 7206:       double bottomFlux = 0.0;
 7207:       Vector2 u2meanBottom = {0.0, 0.0};
 7208:       const Vector2 gradh = elem->grad2(&Node::depth);
 7209:       if constexpr(imm==2) {
 7210:          Vector3 ubed;
 7211: 
 7212:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7213:          // updateBDEF(ubed);
 7214:      
 7215:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7216: 
 7217:          // elem->w[kb] += ubed.z;
 7218:       }
 7219:       else {
 7220: 
 7221:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7222:   
 7223:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7224:          // in the direction of motion.
 7225:          const double bottomW = - dot(gradh, u2meanBottom);  
 7226:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7227: 
 7228:          // VElocity associated to the bed deformation
 7229:          double bedVelocity = 0.0;
 7230:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7231: 
 7232:          elem->w[kb] = bedVelocity + bottomW; 
 7233: 
 7234:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7235:          
 7236:       } // if imm
 7237: 
 7238:       // Compute w for kb+1 to nvrt-1
 7239:       for (int l = kb; l < nvrt - 1; l++) {
 7240: 
 7241:          // normal vector to the top face of the "volumetric" element (3D)
 7242:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7243: 
 7244:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7245:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7246: 
 7247:          // Compute the total flux at the sides
 7248:          double sideFlux = 0.0;
 7249: 
 7250:          for (int j = 0; j < elem->i34; j++) {
 7251:             const Side *side = elem->sides[j];
 7252:             const int kbs = side->kb;
 7253:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7254:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7255:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7256: 
 7257:             // The area is "clamped" meaning that it takes kb into account.
 7258:             const double sideArea = side->areaClamped(l);
 7259: 
 7260:             const double sign = elem->ssign[j]; 
 7261: 
 7262:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7263:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7264:          }
 7265:          
 7266:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7267:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7268:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7269: 
 7270:          // The flux at the top ace can be computed from the other flows.
 7271:          // All fluxes are in directions into the prism.
 7272:          const double topFlux = - sideFlux - bottomFlux;
 7273: 
 7274:          // Flux at the top face due to the horizontal velocities only
 7275:          // topFlux = topHorizontalFlux + topVerticalFlux
 7276:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7277: 
 7278:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7279:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7280: 
 7281:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7282: 
 7283:          bottomFlux = -topFlux;
 7284:          
 7285:       }
 7286: 
 7287:    }  
 7288: 
 7289: 
 7290: 
 7291: 
 7292: 
 7293: 
 7294: 
 7295: // !===============================================================================
 7296: // !===============================================================================
 7297: 
 7298: } // extern "C"
 7299: 
 7300: #ifdef DONTCOMPILE
 7301: __device__ void computeVerticalAdvection(void) {
 7302:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7303: 
 7304:    sdbt(1:2,:,:)=0.d0
 7305: 
 7306:    const Side *side = FROM kernel;
 7307: 
 7308:    if(side->isDry) return;
 7309: 
 7310:    // If side is wet...
 7311: 
 7312: 
 7313:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7314:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7315:    double ws[nvrt] = {} // w @ side
 7316:    int icount = 0;
 7317:    for (int j=0; j<2; j++) {
 7318:       const Element *elem = side->elements[j];
 7319:        
 7320:       if(elem != nullptr) {
 7321:          icount++;
 7322:          for (int k=0; k<nvrt; k++) {
 7323:             ws[k] = ws[k] + elem->w[k];
 7324:          }
 7325:       }
 7326:    }  // for j
 7327: 
 7328:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7329:    ws = ws/icount;
 7330: 
 7331:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7332:    // Splines allow for a smooth transition between vertical levels.
 7333:    // Splines have continuity restrictions at the internal knots, but
 7334:    // we have to provide the 1st derivatives at the endpoints.
 7335:    const int kbs = side->kbs; 
 7336:    
 7337:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7338:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7339:    initCubicSpline(kbs, nvrt, side, ws, up)
 7340: 
 7341:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7342:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7343:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7344: 
 7345:    // Total advection (average onto side)
 7346:    const Node *node1 = side->nodes[0];
 7347:    const Node *node2 = side->nodes[1];
 7348:    for (int k=kbs(i); k<nvrt; k++) {
 7349: 
 7350:       Vector2 bcc1 = node1->bcc[k];
 7351:       Vector2 bcc2 = node2->bcc[k];
 7352:       if constexpr(ics == 2) {
 7353:          // Project the velocities from the node frames to the side frame
 7354:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7355:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7356:       }
 7357: 
 7358:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7359:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7360: 
 7361:    }
 7362: }
 7363: #endif
 7364: 
 7365: 
 7366: extern "C" {
 7367:    __global__ void computeElemAverageGhat(void) {
 7368:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7369: 
 7370:       ELEM(elem);
 7371:       
 7372:       elem->ghat1= {0.0, 0.0};  
 7373: 
 7374:       if constexpr(ihydraulics != 0) {
 7375:          if (nhtblocks > 0 && elem->isblock) return;
 7376:       }
 7377: 
 7378:       
 7379:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7380:       // cff1-3: coefficients for 2D/3D
 7381: 
 7382:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7383:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7384:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7385: 
 7386:       if (elem->isDry) return;
 7387: 
 7388:       // Average of the coefficients
 7389:       double av_cff1 = 0.0;  // av. for cff1
 7390:       double av_cff2 = 0.0;  // av. for cff2
 7391:       double av_cff3 = 0.0;  // av. for cff3
 7392:       double av_df = 0.0;  // av. for H^\alpha / H
 7393:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7394:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7395: 
 7396:       const int i34 = elem->i34;
 7397:       const int kb  = elem->kb;
 7398: 
 7399:       for (int j=0; j<i34; j++) {
 7400:          // For each node and side in the element...
 7401: 
 7402:          const Node *node = elem->nodes[j];
 7403:          const Side *side = elem->sides[j];
 7404: 
 7405:          const double chi      = side->chi;
 7406:          const double veg_c2   = side->veg_c2;
 7407:          const double veg_beta = side->veg_beta;
 7408:          const double veg_h    = side->veg_h();
 7409:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7410: 
 7411:          const Vector2 gradPhi = elem->gradPhi[j];
 7412: 
 7413:          // Node - const in elem
 7414:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7415:          elem->gradPr  += node->pr  *gradPhi;
 7416: 
 7417:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7418: 
 7419:         
 7420:          const double htot  = side->htot2();        // Total depth at the side
 7421:          const double zctr2 = side->zTopCanopy();  
 7422: 
 7423:          double cff1; 
 7424:          double cff2; 
 7425:          double cff3;   
 7426:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7427:          // coefficients applied to 2D/3D case 
 7428:             cff1 = side->hhat/htot;
 7429:             cff2 = 0.0;
 7430:             cff3 = 0.0;
 7431:          } else { //3D
 7432:             //Init for no-veg case
 7433:             cff1 = 1.0;
 7434:             cff2 = 1.0;
 7435:             cff3 = 0.0;
 7436: 
 7437:             if constexpr(iveg != 0) {
 7438:                // Computes coefficients used with vegetation terms G1, G2
 7439:                // cff1, cff3 are used for the first two terms in G1, G2:
 7440:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7441:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7442:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7443:                if(veg_h < 0.99*htot) { // submergent vegetation
 7444:                   cff1 = 1.0;
 7445:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7446:                   cff3 = veg_c;
 7447: 
 7448:                } else { // emergent vegetation
 7449:                   cff1 = 1.0/(1.0 + veg_c2);
 7450:                   cff2 = cff1;
 7451:                   cff3 = 0.0;
 7452: 
 7453:                }
 7454:             } // if iveg
 7455:          } //  2D/3D
 7456: 
 7457:          av_cff1 += cff1/i34;
 7458:          av_cff2 += cff2/i34;
 7459:          av_cff3 += cff3/i34;
 7460:          av_cff2_chi += cff2*chi/i34;
 7461:          av_cff3_chi += cff3*chi/i34;
 7462:          av_df += min(htot, veg_h)/(htot*i34);
 7463: 
 7464: 
 7465:          // btrack values: U^\star, U^{\star\alpha}
 7466:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7467:          Vector2 Ustar       = {0.0, 0.0}; 
 7468:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7469: 
 7470:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7471:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7472:          } else { //3D
 7473:             for (int k = side->kb + 1; k < nvrt; k++) {
 7474:             
 7475:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7476:                Ustar += w2;
 7477: 
 7478:                if constexpr(iveg != 0) {
 7479:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7480:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7481:                        Ustar_alpha += zrat*w2; // XXXX
 7482:                    }
 7483:                }  // if iveg
 7484:             }  // for k
 7485:          }  //2D/3D
 7486: 
 7487:          // If needed, project the side velocities to the element frame
 7488:          if constexpr(ics==2) {
 7489:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7490:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7491:          }
 7492:         
 7493: 
 7494:          // Add btrack & surface stress terms to \breve{G} first
 7495:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7496: 
 7497: 
 7498:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7499:          Vector2 tau    = side->tau();  
 7500:          Vector2 ubstar = side->btu[side->kb + 1];  
 7501: 
 7502:          // If needed, project tau and ubstar to the element frame
 7503:          if constexpr(ics==2) {
 7504:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7505:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7506:          }
 7507: 
 7508:          // Term for surface and bottom stress
 7509:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7510: 
 7511: 
 7512:          // All terms in F,F^\alpha,f_b except baroclinic
 7513:          // F, f_b: all explicit terms excluding vegetation 
 7514:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7515:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7516:          const double coriolis = side->coriolis;
 7517:          Vector2 F  =  coriolis*side->U;  // F_x
 7518:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7519:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7520: 
 7521:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7522:             
 7523:             for (int k = side->kb; k < nvrt; k++) {
 7524:                if (zctr2 > side->zc[k-1]) {
 7525:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7526:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7527:                    Fa +=  coriolis*w2*zrat;
 7528:                } // if zctr2
 7529:             } // k
 7530:          } // iveg
 7531: 
 7532:          // Integrate horizontal viscosity force vertically
 7533:          for (int k=side->kb + 1; k<nvrt; k++) {
 7534:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7535: 
 7536:             F += levelHorVisc;
 7537: 
 7538:             // Vegetation term
 7539:             if constexpr(iveg!=0) {
 7540:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7541:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7542:                   Fa += levelHorVisc*zrat;
 7543:                } 
 7544:             } // if iveg
 7545:          } // for k
 7546: 
 7547:          // Get nu*grad(U) at the side's bottom level
 7548:          Vector2 nuGradU = side->nuGradU[side->kb];
 7549: 
 7550:          fb += nuGradU;
 7551: 
 7552:          // If needed, project vectorsF, fb and Fa to the element frame
 7553:          if constexpr(ics==2) {
 7554:             F    = side->frame.projHorVec(F,    elem->frame);
 7555:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7556:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7557:          } // if ics
 7558: 
 7559:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7560:       } // for j (nodes and sides)
 7561: 
 7562:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7563: 
 7564: 
 7565:       // Finish off terms in F, F^\alpha and f_b
 7566:       const double grav3 = elem->mean(&Node::grav2);
 7567:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7568:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7569:       for (int j=0; j<i34; j++) { 
 7570:          // For each side in the element...
 7571:          const Side *side = elem->sides[j];
 7572:          const double chi = side->chi;
 7573: 
 7574:          const double htot = side->htot2();
 7575:          const double veg_h = side->veg_h();
 7576:          const Vector2 F  = htot*fb;
 7577:          const Vector2 Fa = min(htot, veg_h)*fb;
 7578: 
 7579:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7580:       } // for j
 7581: 
 7582:       // tmp is already in elem frame
 7583:       elem->ghat1 += tmp/i34;
 7584: 
 7585:       // Baroclinic force
 7586:       if constexpr(ibc==0) {
 7587:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7588: 
 7589:          Vector2 Fa = {0.0, 0.0};
 7590:          Vector2 intGradRho = {0.0, 0.0};
 7591:          
 7592:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7593:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7594:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7595: 
 7596:             // \in F [m^2/s/s]
 7597:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7598:          }
 7599: 
 7600:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7601:          const Vector2 F = av_df*Fa; //approx
 7602:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7603: 
 7604:       } // if ibc
 7605: 
 7606: 
 7607: 
 7608:    }
 7609: 
 7610: } // extern "C"
 7611: 
 7612: 
 7613: 
 7614: #ifdef DONTCOMPILE
 7615: __global__ void checkMassConservation(Tracers* sumtr) {
 7616: 
 7617:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7618: 
 7619:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7620: 
 7621:    Element *elem = &(mesh->localElemData[i]);
 7622: 
 7623:    // Skip dry elements
 7624:    if (elem->isDry) return;
 7625: 
 7626:    // Local sum array for this thread
 7627:    double localSum[N_TRACERS] = {0.0};
 7628: 
 7629:    // Sum over vertical levels for this element
 7630:    const int kbe = elem->kbe;
 7631:    const double area = elem->area;
 7632: 
 7633:    for (int k = kbe; k < nvrt; k++) {
 7634:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7635:       
 7636:       // Accumulate tracer mass
 7637:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7638:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7639:       }
 7640:    }
 7641: 
 7642:    //  This function returns per element sums. A reduction must be done on the host side.
 7643: }
 7644: 
 7645: 
 7646: __global__ void transport(void) {
 7647: 
 7648:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7649: 
 7650:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7651: 
 7652:    Element *elem = &(mesh->localElemData[ie]);
 7653: 
 7654:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7655: 
 7656:                for (int m=0; m<ntr; m++) {
 7657:                   for (int k=kbe(ie); k<nvrt; k++) {
 7658:                      // Calculate each polynomial's weight 
 7659:                      wm=0.d0; sum1=0.d0; 
 7660:                      wm1=0.d0; wm2=0.d0; 
 7661:                      for (int i=0; i<elem->nweno2; i++) {
 7662:                   
 7663:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7664:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7665:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7666:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7667:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7668:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7669:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7670:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7671:                      // -----------------Hu and Shu (1999)'s method----------------
 7672:                      b4=b1+b2+b3
 7673: 
 7674: //Error: add PRODUCTION CPP
 7675: #ifdef DEBUG
 7676:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7677:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7678:                     call parallel_abort(errmsg)
 7679:                   }
 7680: #endif
 7681: 
 7682:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7683:                   // !----test-------------- 
 7684:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7685:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7686:                   // !wm(i)=wm1(i)*wm2(i)
 7687:                   // !---------------------- 
 7688:                   sum1=sum1+wm(i)
 7689:                 } // end for i
 7690: 
 7691:                 wm=wm/sum1
 7692: 
 7693:                 for (int j=0; j<elem->i34; j++) {
 7694: 
 7695:                   const Side *side  = elem->sides[j];
 7696:                   const Node *node1 = side->n1;
 7697:                   const Node *node2 = side->n2;
 7698: 
 7699:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7700:                      trsd=0.d0
 7701:                      for (int kk=0; kk<nquad; kk++) {
 7702:                         for (int i=0; i<elem->nweno2; i++) {
 7703:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7704:                         } // end for i   
 7705:                      } // end for kk
 7706:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7707:                   } // outward flux
 7708:                } // end for j=1,i34(ie) ! side
 7709:             }
 7710:          }
 7711:               
 7712: 
 7713: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7714: //             //   calculate each polynomial's weight 
 7715: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7716: //                 wm=0.d0; sum1=0.d0
 7717: //                 do i=1,nweno1(ie) !for each polynomial
 7718: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7719: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7720: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7721: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7722: //                   wm(i)=b2
 7723: //                   sum1=sum1+b2
 7724: //                   !wm(i)=1.d0
 7725: //                   !sum1=sum1+1.d0
 7726: 
 7727: // // Error: PRODUCTION
 7728: // #ifdef DEBUG
 7729: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7730: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7731: //                     call parallel_abort(errmsg)
 7732: //                   endif
 7733: // #endif
 7734: 
 7735: //                 enddo !i
 7736: //                 wm=wm/sum1 !final weight
 7737: 
 7738:                 for (int j=0; j<elem->i34; j++) { // side
 7739:                   const Side *side = elem->sides[j];
 7740:                   const Node *node1 = side->n1;
 7741:                   const Node *node2 = side->n2;
 7742: 
 7743:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7744:                     trsd=0.d0
 7745:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7746:                       for (int i=0; i<elem->nweno1; i++) {
 7747:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7748:                       }
 7749:                     enddo //kk
 7750:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7751:                   } // outward flux
 7752:                 } // end for j=1,i34(ie) ! side
 7753:               } // end for k; ntr 
 7754: 
 7755:             else !simple upwind method
 7756:               do j=1,i34(ie)
 7757:                 jsj=elside(j,ie)
 7758:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7759:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7760:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7761:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7762:                   endif
 7763:                 enddo  !vertical layers
 7764:               enddo !j=1,i34(ie) ! side
 7765:             endif !order of accuracy
 7766: 
 7767:          //  enddo !ie
 7768: // !$OMP     end do
 7769: 
 7770: // !$OMP     master
 7771: //           !message passing
 7772: //           if (nproc>1) then
 7773: //             !make a copy of side concentrations
 7774: //             trsd_tmp0=trsd_tmp 
 7775: 
 7776: //             !this exchange routine swaps interface concentration between two partitions
 7777: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7778: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7779: 
 7780: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7781: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7782: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
