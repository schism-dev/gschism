 8025: 
 8026: __global__ void computeMatrixProductAndDotProducts() {
 8027:    // Computes A*p, r'Mr and p'Ap
 8028: 
 8029:    // 1) shared buffer: first half for rMr, second for pAp
 8030:    __shared__ double sdata[2*BLOCK_SIZE];
 8031:    double* s_rMr = sdata;
 8032:    double* s_pAp = sdata + BLOCK_SIZE;
 8033: 
 8034:    const int tid = threadIdx.x;
 8035: 
 8036:    double l_pAp = 0.0;
 8037: 
 8038:    s_rMr[tid] = 0.0;
 8039:    s_pAp[tid] = 0.0;
 8040: 
 8041:    // 2) get your node pointer
 8042:    // NODE(node);   
 8043:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8044:    Node *node = &(mesh->localNodeData[idx_node]); 
 8045:       if (idx_node < mesh->np) {
 8046: 
 8047:       const double diag = node->coeffDiag;
 8048:       const double r    = node->mR;
 8049:       const double p    = node->mP;  
 8050: 
 8051:       // apply preconditioner on the fly:
 8052:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8053: 
 8054:       // 4) compute Ap = A.p
 8055:       double Ap = node->coeffDiag * node->mP;
 8056:       for (int j = 0; j < node->numNodes; ++j) {
 8057:          const Node *nbNode = node->nodes[j];
 8058:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8059: 
 8060:       }
 8061: 
 8062:       node->mAp = Ap;
 8063:       
 8064: 
 8065:       // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 8066:       // const double l_rMr = r*Mr;  // r'Mr
 8067:       l_pAp = p*Ap;  // p'Ap
 8068: 
 8069: 
 8070:    }
 8071: 
 8072:    // 6) write into shared mem
 8073:    // s_rMr[tid] = l_rMr;
 8074:    s_pAp[tid] = l_pAp;
 8075: 
 8076:    __syncthreads();
 8077: 
 8078:    // 7) block-wide tree reduction
 8079:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8080:       if (tid < stride)  {
 8081:          s_pAp[tid] += s_pAp[tid + stride];
 8082:       }
 8083:       __syncthreads();
 8084:    }
 8085: 
 8086:    // 8) thread 0 atomically accumulates into the globals
 8087:    // XXX: This is slower than it needs to be, but it is simple and works
 8088:    if (tid == 0) {
 8089:       atomicAdd(pAp, s_pAp[0]);
 8090:    }
 8091: 
 8092: 
 8093: }
 8094: 
 8095: 
 8096: __global__ void updateSolutionAndDotProducts(void) {
 8097:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8098: 
 8099:    const int tid = threadIdx.x;
 8100: 
 8101:    s_rMr[tid] = 0.0;
 8102: 
 8103:    // get node & bounds-check:
 8104:    NODE(node);
 8105: 
 8106:    
 8107:    // Compute alpha
 8108:    const double alpha = (*rMr_old)/(*pAp);
 8109: 
 8110:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8111: 
 8112: 
 8113:    // load scalars
 8114:    const double diag = node->coeffDiag;
 8115:    const double p    = node->mP;
 8116:    const double Ap   = node->mAp;
 8117:    const double x    = node->mX;
 8118:    const double r    = node->mR;
 8119:    
 8120:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8121: 
 8122:    // 1) update solution & residual
 8123:    const double x_new = x + alpha*p;
 8124:    const double r_new = r - alpha*Ap;
 8125:    node->mX = x_new;
 8126:    node->mR = r_new;
 8127: 
 8128:    // 2) apply Jacobi preconditioner on the fly
 8129:    const double Mr_new = r_new/diag;
 8130: 
 8131: 
 8132:    // 3) local contributions for the two dot-products
 8133:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8134: 
 8135:    // 4) write into shared-mem
 8136:    s_rMr[tid] = l_rMr;
 8137: 
 8138:    __syncthreads();
 8139: 
 8140: 
 8141:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8142:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8143:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8144:       __syncthreads();
 8145:    }
 8146: 
 8147:    // 6) thread 0 atomically folds into the global accumulators
 8148:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8149: 
 8150: 
 8151: }
 8152: 
 8153: 
 8154: __global__ void updateSearchDirection() {
 8155: 
 8156:     NODE(node);
 8157: 
 8158:     // recompute z on-the-fly
 8159:     const double z = node->mR / node->coeffDiag;
 8160:     const double p = node->mP;
 8161: 
 8162:     const double beta = (*rMr_new)/(*rMr_old);
 8163: 
 8164: 
 8165:     // p =z + beta*p
 8166:     node->mP = z + beta*p;
 8167: 
 8168: }
 8169: 
 8170: __global__ void initializeScalars(double *scalars) {
 8171: 
 8172:    // These point to a cupy array in the host code
 8173:    rMr_old = scalars + 0;
 8174:    rMr_new = scalars + 1;
 8175:    pAp     = scalars + 2;
 8176: }
 8177: 
 8178: __global__ void initializePreconditionedResidual(void) {
 8179: 
 8180:     __shared__ double s_rMr[BLOCK_SIZE];  
 8181: 
 8182:     s_rMr[threadIdx.x] = 0.0;
 8183: 
 8184:     NODE_ALL(node, valid);
 8185:     const int tid = threadIdx.x;
 8186:     // For the first iteration:
 8187:     // 1. Initial solution x = 0 (already set)
 8188:     // 2. Initial residual r = b (stored in qel)
 8189:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8190: 
 8191: // XXX we should use the guess solution here    
 8192: 
 8193:     double l_rMr = 0.0;
 8194:     if (valid) {
 8195:       // Set initial residual r = b (from qel)
 8196:       node->mR = node->qel;
 8197: 
 8198:       // Compute z = M^-1 * r (preconditioned residual)
 8199:       const double z = node->mR / node->coeffDiag;
 8200: 
 8201:       // Set initial search direction p = z
 8202:       node->mP = z;
 8203: 
 8204:       // Initialize other variables needed for CG
 8205:       node->mX = 0.0;  // Initial solution
 8206:       node->mAp = 0.0; // Will be computed in first iteration
 8207: 
 8208: 
 8209:       // Computes the first r'Mr (reduction)
 8210:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8211:     }
 8212:     // 4) write into shared-mem
 8213:     s_rMr[tid] = l_rMr;
 8214: 
 8215:     __syncthreads();
 8216: 
 8217: 
 8218:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8219:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8220:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8221:         __syncthreads();
 8222:     }
 8223: 
 8224:     // 6) thread 0 atomically folds into the global accumulators
 8225:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8226: 
 8227:     *rMr_old = 0.0;
 8228:     *pAp = 0.0;
 8229: }
 8230: 
 8231: 
 8232: 
 8233: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8234:    Element *elems = mesh->localElemData;
 8235: 
 8236:    *addr = elems;
 8237:    *sizeElement = sizeof(Element);
 8238:    switch (varCode) {
 8239:       case (int)VarCode::z:
 8240:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8241:          *sizeType = sizeof(double);
 8242:          break;
 8243:       case (int)VarCode::x:
 8244:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8245:          *sizeType = sizeof(Vector2);
 8246:          break;
 8247:       case (int)VarCode::area:
 8248:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8249:          *sizeType = sizeof(double);
 8250:          break;
 8251:       case (int)VarCode::depth:
 8252:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8253:          *sizeType = sizeof(double);
 8254:          break;
 8255:       case (int)VarCode::radius:
 8256:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8257:          *sizeType = sizeof(double);
 8258:          break;
 8259:       case (int)VarCode::lonlat:
 8260:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 8261:          *sizeType = sizeof(double);
 8262:          break;
 8263:       case (int)VarCode::ghat:
 8264:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8265:          *sizeType = sizeof(Vector2);
 8266:          break;
 8267:       case (int)VarCode::kb:
 8268:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8269:          *sizeType = sizeof(int);
 8270:          break;
 8271:       case (int)VarCode::isdry:
 8272:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8273:          *sizeType = sizeof(int);
 8274:          break;            
 8275:       case (int)VarCode::w:
 8276:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8277:          *sizeType = sizeof(double);
 8278:          break;
 8279:       case (int)VarCode::FaceIndices:
 8280:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8281:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8282:          *sizeType = sizeof(Node);
 8283:          break;
 8284:       default:
 8285:          *offset = -1;
 8286:    }
 8287: }
 8288: 
 8289: 
 8290: extern "C" __global__ void getSideVarAddr(int varCode, void **addr, int *offset, int *sizeSide, int *sizeType) {
 8291:    Side *sides = mesh->localSideData;
 8292: 
 8293:    *addr = sides;
 8294:    *sizeSide = sizeof(Side);
 8295:    switch (varCode) {
 8296:       case (int)VarCode::z:
 8297:          *offset = (int)((char*)&sides[0].zc - (char*)sides);
 8298:          *sizeType = sizeof(double);
 8299:          break;
 8300:       case (int)VarCode::x:
 8301:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 8302:          *sizeType = sizeof(Vector2);
 8303:          break;
 8304:       case (int)VarCode::len:
 8305:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 8306:          *sizeType = sizeof(double);
 8307:          break;
 8308:       case (int)VarCode::kb:
 8309:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 8310:          *sizeType = sizeof(int);
 8311:          break;
 8312:       case (int)VarCode::isdry:
 8313:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8314:          *sizeType = sizeof(int);
 8315:          break;            
 8316:       case (int)VarCode::w:
 8317:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8318:          *sizeType = sizeof(double);
 8319:          break;
 8320:       case (int)VarCode::u:
 8321:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8322:          *sizeType = sizeof(Vector2);
 8323:          break;   
 8324:       case (int)VarCode::n1:
 8325:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8326:          *sizeType = sizeof(Node);
 8327:          break;
 8328:       case (int)VarCode::n2:
 8329:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8330:          *sizeType = sizeof(Node);
 8331:          break;                   
 8332:       default:
 8333:          *offset = -1;
 8334:    }
 8335: }
