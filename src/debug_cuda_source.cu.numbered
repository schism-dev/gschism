 9147: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 9148: 
 9149:    ELEM(elem);
 9150: 
 9151:    switch (varCode) {
 9152:       case (int)VarCode::outputCoords:
 9153:          const Point2 coords = elem->outputCoords();
 9154:          res[elem->idx*2    ] = coords.x;
 9155:          res[elem->idx*2 + 1] = coords.y;
 9156:          break;
 9157:    }
 9158: }
