 2960: 
 2961: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2962: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2963: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 2964: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2965: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2966: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 2967: __inline__ __device__ Point3  Side::p3_t(double t) const { return {x(t), y(t), z(t)}; }
 2968: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 2969: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2970: // Computes the gradient of the field at the side center.
 2971:    Vector2 grad = {0.0, 0.0};
 2972:    int count = 0;
 2973: 
 2974:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 2975:    // as the average of the gradients at each element.
 2976:    // First element
 2977:    if (elems[0] != nullptr && condition(elems[0])) {
 2978:       Vector2 elemGrad = elems[0]->grad2(field);
 2979: 
 2980:       // For ics=2, projects the element gradient from its frame to the side frame
 2981:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 2982: 
 2983: 
 2984:       grad += elemGrad;
 2985: 
 2986:       count++;
 2987:    }
 2988: 
 2989:    // Second element
 2990:    if (elems[1] != nullptr && condition(elems[1])) {
 2991: 
 2992:       Vector2 elemGrad = elems[1]->grad2(field);
 2993: 
 2994:       // For ics=2, projects the element gradient from its frame to the side frame
 2995:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 2996: 
 2997:       grad += elemGrad;
 2998: 
 2999:       count++;
 3000:    }
 3001: 
 3002:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3003:    if (count > 0) {
 3004:       grad = grad*(1.0/count);
 3005:    }
 3006:    
 3007:    return grad;
 3008: }
 3009: 
 3010: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3011: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3012: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3013: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3014: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3015: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3016: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3017: 
 3018: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3019: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3020: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3021: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
