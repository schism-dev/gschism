 8435: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8436:    Element *elems = mesh->localElemData;
 8437: 
 8438:    *addr = elems;
 8439:    *sizeElement = sizeof(Element);
 8440:    switch (varCode) {
 8441:       case (int)VarCode::z:
 8442:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8443:          *sizeType = sizeof(double);
 8444:          break;
 8445:       case (int)VarCode::x:
 8446:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8447:          *sizeType = sizeof(Vector2);
 8448:          break;
 8449:       case (int)VarCode::gradETP:
 8450:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8451:          *sizeType = sizeof(Vector2);
 8452:          break;
 8453:       case (int)VarCode::area:
 8454:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8455:          *sizeType = sizeof(double);
 8456:          break;
 8457:       case (int)VarCode::depth:
 8458:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8459:          *sizeType = sizeof(double);
 8460:          break;
 8461:       case (int)VarCode::radius:
 8462:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8463:          *sizeType = sizeof(double);
 8464:          break;
 8465:       case (int)VarCode::ghat:
 8466:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8467:          *sizeType = sizeof(Vector2);
 8468:          break;
 8469:       case (int)VarCode::kb:
 8470:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8471:          *sizeType = sizeof(int);
 8472:          break;
 8473:       case (int)VarCode::isdry:
 8474:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8475:          *sizeType = sizeof(int);
 8476:          break;            
 8477:       case (int)VarCode::w:
 8478:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8479:          *sizeType = sizeof(double);
 8480:          break;
 8481:       case (int)VarCode::FaceIndices:
 8482:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8483:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8484:          *sizeType = sizeof(Node);
 8485:          break;
 8486:       default:
 8487:          *offset = -1;
 8488:    }
 8489: }
