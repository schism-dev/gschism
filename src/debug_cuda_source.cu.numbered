 4428:    __global__ void computeFlowBcVelocities(double time) {
 4429: 
 4430:       SIDE_BND(sideBnd);
 4431: 
 4432:       const Side *side = sideBnd->side;
 4433:  
 4434:       const bool isDry = side->isDry;
 4435:       const bool isLand = sideBnd->segment->isLand;
 4436: 
 4437:    
 4438:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4439: 
 4440:       if (isDry || isLand) return;
 4441: 
 4442:       // For wet sides in open boundaries...
 4443:       const Vector2 n = side->n;
 4444:       const BoundarySegment *segment = sideBnd->segment;
 4445: 
 4446:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4447: 
 4448:       const int ifltype = segment->ifltype;
 4449: 
 4450:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4451:       const Vector2 r_nuth0 = r_uth0*n;
 4452: 
 4453: 
 4454:       if (ifltype == 1 || ifltype == 2) {
 4455:       
 4456:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4457: 
 4458:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4459:          
 4460:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4461:          
 4462:       } else if (ifltype == -1) { // Flather 1
 4463: 
 4464:          for (int k = 0; k < nvrt; k++) {
 4465: 
 4466:             // uth is the normal vel.; no ramp up
 4467:             const double uth = sideBnd->nuth(k);
 4468:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4469: 
 4470:             sideBnd->ubc[k] += uth*n;
 4471:          }
 4472: 
 4473:       } else if (ifltype == 3 || ifltype == 5) {
 4474:          // vnth0=0 !normal vel.
 4475: 
 4476:          Vector2 r_u1_bar = {0.0, 0.0};
 4477:          // Computes the contribution to the velocity from all tide frequencies
 4478:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4479: 
 4480:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4481:             const Vector2 umo  = sideBnd->umo(jfr); 
 4482: 
 4483:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4484:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4485:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4486:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4487: // printf("r_u1_bar = %f, %f, ramp = %f, ff = %f, umo = %f, %f, ufa = %f, %f\n", r_u1_bar.x, r_u1_bar.y, ramp, ff[jfr], umo.x, umo.y, ufa.x, ufa.y);         
 4488:          }
 4489: 
 4490: 
 4491:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4492: 
 4493:       } // if (ifltype = 3 || ifltype == 5
 4494: 
 4495: 
 4496: 
 4497:    }
 4498: 
 4499:    __global__ void computeElevationBoundaryConditions(double time) {
 4500:       // Compute elevation essential boundary conditions 
 4501: 
 4502:       NODE_BND(nodeBnd); // Each boundary node.
 4503: 
 4504:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4505: 
 4506:       const Node *node = nodeBnd->node;
 4507:       const BoundarySegment *segment = nodeBnd->segment;
 4508:       const int iettype = segment->iettype;
 4509:       
 4510: 
 4511:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4512:       double eic = 0.0;
 4513:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4514:       else                 eic = 0.0;
 4515: 
 4516:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4517:       const double r_eth = ramp*nodeBnd->eth;
 4518:       double r_eta1_bar = 0.0;
 4519: 
 4520: 
 4521:       // Compute tide elevation
 4522:       if (iettype == 3 || iettype == 5) {   
 4523: 
 4524:          if constexpr(iloadtide==1) { // loading tide
 4525:             assert(false && "Loading tide not implemented");
 4526:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4527:          }
 4528:          
 4529:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4530: 
 4531:             const double efa  = nodeBnd->efa[jfr]; 
 4532:             const double emo  = nodeBnd->emo[jfr]; 
 4533: 
 4534:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4535:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4536:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4537: 
 4538:          } // for jfr
 4539: 
 4540:       } // if iettype
 4541: 
 4542:       switch (iettype) {
 4543:          case 1:
 4544:          case 2:
 4545:          case 4:
 4546:             nodeBnd->elbc = r_eic + r_eth;
 4547:             break;
 4548:          case 3:
 4549:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4550:             break;
 4551:          case 5:
 4552:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4553:             break;
 4554:       } // switch
 4555: 
 4556: 
 4557:       //Add inverse barometric effects
 4558:       if (iettype != 0 && inv_atm_bnd == 1) {
 4559:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4560:       }
 4561: 
 4562:    }
 4563: 
 4564: 
 4565:    __global__ void computeHorizontalViscosity(void) { 
 4566: 
 4567:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4568: 
 4569:       SIDE(side);
 4570: 
 4571:       if (side->isDry) return;
 4572: 
 4573:       for (int k = 0; k < nvrt; k++) {
 4574:          side->nuGradU[k] = {0.0, 0.0};
 4575:       }
 4576: 
 4577:       if constexpr(ihorcon == 1) {
 4578:          for (int k = side->kb; k < nvrt - 1; k++) {
 4579:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4580:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4581:             // By Zhang and Baptista.
 4582: 
 4583:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4584:             // This is a standard discretization of the Laplacian operator.
 4585:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4586:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4587:             // Gamma is hvis_coef0 in the code.
 4588:             // The value of gamma needs to be < 0.5.
 4589: 
 4590:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4591:             // side under consideration in each of the two possible elements that share the side.
 4592:             Vector2 sumU = {0.0, 0.0};
 4593:             for (int l = 0; l < 2; l++) {
 4594:                const Element *elem = side->elems[l];
 4595: 
 4596:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4597: 
 4598:                // Find the local index of the side in the element
 4599:                const int idxSide = elem->sideLocalIdx(side);
 4600:                // Find the two sides that are connected to the side under consideration
 4601:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4602:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4603: 
 4604:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4605: 
 4606:             }
 4607: 
 4608:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4609:    
 4610:          }
 4611:       }
 4612:       else if constexpr(ihorcon == 2) {
 4613:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4614:       }
 4615: 
 4616: 
 4617:    }
 4618: 
 4619: 
 4620:    __global__ void setEssentialBC(void) {
 4621:       // Set essential boundary conditions 
 4622:       NODE(node); // Each boundary node
 4623:       NodeBoundary *nodeBnd = node->nodeBnd;
 4624:       
 4625: // nodeBnd->isEssentialBC = true;      
 4626:       // Check if this node has essential BC
 4627:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4628:          // Verify BC value is valid
 4629:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4630: 
 4631:        
 4632:          // Set diagonal to 1 and zero off-diagonals
 4633:          node->coeffDiag = 1.0;
 4634: 
 4635:          for (int j = 0; j < node->numNodes; j++) {
 4636:                node->coeffMatrix[j] = 0.0;
 4637:          }
 4638:          
 4639:          // Set solution and RHS to BC value
 4640:          node->mX  = nodeBnd->elbc;
 4641:          node->qel = nodeBnd->elbc;
 4642: 
 4643:       } else {
 4644:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4645: 
 4646:          for (int j = 0; j < node->numNodes; j++) {
 4647:                Node* nbNode = node->nodes[j];
 4648:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4649:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4650:                   // Verify neighbor's BC value
 4651:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4652: 
 4653:                   // Subtract contribution to RHS
 4654:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4655:                   node->coeffMatrix[j] = 0.0;  
 4656:                }
 4657:          }
 4658:       }
 4659:    }
 4660: 
 4661: 
 4662:    __global__ void updateElevation(void) {
 4663:       NODE(node);
 4664: 
 4665:       node->eta2 = node->mX;
 4666: 
 4667:       node->updateZCoordData();
 4668:    }
