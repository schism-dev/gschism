 1896: 
 1897: /**
 1898:  * Find the element that contains the target point.
 1899:  * 
 1900:  * @param x0,y0,z0     Starting position coordinates
 1901:  * @param xt,yt,zt     Target position coordinates
 1902:  * @param dtb          Time step for tracking
 1903:  * @param u_int        Initial velocity components
 1904:  * @param nextElem     Starting/resulting element index
 1905:  * 
 1906:  * @return Status code of type trackExitCodes
 1907:  * 
 1908:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1909:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1910:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1911:  * as close the the segment AB as possible, the next point at each iteration is computed
 1912:  * along segment AB, but just after the current element.
 1913:  */
 1914: 
 1915: 
 1916: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1917: 
 1918:    constexpr int MAX_ITERATIONS = 40;
 1919: 
 1920:    int iter = 0;
 1921:    double fac = 0.00001;
 1922:    while (iter < MAX_ITERATIONS) {
 1923:       iter++;
 1924: if (iter > 30) printf("XX>>X iter = %d, jlev = %d, curElem->idx = %d, origSide->idx = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, jlev, curElem->idx, origSide->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 1925:       Bool4 isLeft, isObtuse, isBisector;
 1926:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 1927: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 1928:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 1929: 
 1930:       if (isValid.none()) 
 1931:       // Inside the element if none of the edges is a valid continuation
 1932:       {
 1933:          // Just returns true and the element (curElem) is unchanged).
 1934:          // This means that the algorithm has found the element that contains the target point.
 1935:          return true;
 1936:       }
 1937:       else { // Outside the element
 1938: 
 1939:          // Outside this element. Pick the first valid exit side and cross.
 1940:          lastCrossSide = curElem->sides[isValid.firstOne()];
 1941:          Element *prevElem = curElem;
 1942:          curElem = lastCrossSide->otherElem(curElem);
 1943: 
 1944:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 1945:          // along the boundary.
 1946:          if (curElem == nullptr || curElem->isDry) {
 1947:          
 1948:             curElem = prevElem;
 1949:             return false;
 1950:          }
 1951:          
 1952:       }
 1953: 
 1954:    }
 1955: 
 1956:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 1957: }
