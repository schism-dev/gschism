  956:    __device__ void setFrame(void) {
  957:       if constexpr(ics == 1) return;
  958: 
  959:       double lat, lon;
  960:       const Point3 p = toPoint3(center, centerZ());
  961: 
  962:       // Compute the latitude and longitude of the element center
  963:       computeLatLon(p, lat, lon);
  964: 
  965:       frame.update(lat, lon);        
  966:    }
