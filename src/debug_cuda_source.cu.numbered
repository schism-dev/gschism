 2736: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2737: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2738: 
 2739: //       if (delta != 0.0) {
