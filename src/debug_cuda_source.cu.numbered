 3836: extern "C" {
 3837: 
 3838:    __global__ void scaleGravity(double loadtide_coef) {
 3839: 
 3840: 
 3841:       NODE(node);
 3842: 
 3843:       // SAL option: scale gravity
 3844:       if constexpr(iloadtide==2) {  // simple const
 3845:          node->grav2 = grav*(1.0 - loadtide_coef);
 3846: 
 3847:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3848:         
 3849:           const double depth = max(node->depth, 0.0);
 3850:           const double tmp1 = sqrt(depth);
 3851:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3852:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3853:                              2.6969e-13*depth*depth*depth*tmp1;
 3854:           
 3855:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3856:           
 3857: 
 3858: 
 3859:           node->grav2 = grav*(1.0 - beta_bar);
 3860: 
 3861:       } else {  // iloadtide=0,1
 3862:         node->grav2=grav;
 3863: 
 3864:       }
 3865: 
 3866:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3867:    }
 3868: 
