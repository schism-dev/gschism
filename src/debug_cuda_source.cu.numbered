 2347:    template<typename T>
 2348:    __device__ __forceinline__ T Element::mean(int level, T (Node::* field)[nvrt]) const {
 2349:       T values[4];
 2350:       getNodalValues(level, field, values);
 2351: 
 2352:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2353:       if constexpr (IsVector2<T>::value && ics == 2) {
 2354: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2355:          projectNodeVectorsToElementFrame(values);
 2356: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2357:       }
 2358: 
 2359:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2360:    }
