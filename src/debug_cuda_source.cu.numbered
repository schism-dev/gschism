 1419: struct Mesh {
 1420:    public:  
 1421: 
 1422:    int partNum; // Partition number for this mesh.
 1423: 
 1424:    // Pointers to each GPU's local memory (size is the number of partitions).
 1425:    Node**    nodes;  
 1426:    Element** elems;  
 1427:    Side**    sides;  
 1428:    
 1429:    // Local memory
 1430:    Node*    localNodeData; 
 1431:    Element* localElemData;
 1432:    Side*    localSideData; 
 1433: 
 1434:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1435:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1436:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1437:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1438:    
 1439:    const int npgb;  // Global number of horizontal nodes
 1440:    const int negb;  // Global number of elements
 1441:    const int nsgb;  // Global number of sides
 1442: 
 1443:    const int np;   // Local number of horizontal nodes 
 1444:    const int ne;   // Local number of elements
 1445:    const int ns;   // Local number of sides
 1446: 
 1447:    int nbp;  // Local number of boundary nodes
 1448:    int nbs;  // Local number of boundary sides
 1449: 
 1450:    int nEntries;  // Total number of matrix elements
 1451: 
 1452:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1453:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1454:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1455: 
 1456:   
 1457:    // Additional topology information
 1458:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1459:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1460: 
 1461:    BoundarySegment landBoundarySegment;
 1462:    NodeBoundary landBoundaryNode;
 1463: 
 1464:    // Vertical coordinate system
 1465:    // Sigma levels
 1466:    double h_s; 
 1467:    double h_c; 
 1468: 
 1469:    double theta_b;
 1470:    double theta_f, sinh_theta_f;
 1471:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1472:    double *ztot;
 1473:    double *cs;
 1474:    double *dcs;
 1475: 
 1476:    // // Get's the pointer to the node using the array of global pointers to nodes
 1477:    // __device__ const Node *getGlobalNode(int jn) {
 1478:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
 1479:    //    return nodes[idx] + idx;
 1480:    // }
 1481: 
 1482:    // // Get's the pointer to the element using the array of global pointers to elements
 1483:    // __device__ const Element *getGlobalElem(int je) {
 1484:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1485:    //    return elems[idx] + idx;
 1486:    // }
 1487: 
 1488:    // // Get's the pointer to the side using the array of global pointers to sides
 1489:    // __device__ const Side *getGlobalSide(int js) {
 1490:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1491:    //    return sides[idx] + idx;
 1492:    // }
 1493: 
 1494:    // // Get's the global index of local node idx
 1495:    // __device__ int getGlobalNodeIndex(int idx) {
 1496:    //    return idx + partNum * max_np;
 1497:    // }
 1498: 
 1499:    // // Get's the global index of local element idx
 1500:    // __device__ int getGlobalElemIndex(int idx) {
 1501:    //    return idx + partNum * max_ne;
 1502:    // }
 1503: 
 1504:    // // Get's the global index of local side idx
 1505:    // __device__ int getGlobalSideIndex(int idx) {
 1506:    //    return idx + partNum * max_ns;
 1507:    // }  
 1508: 
 1509:    __device__ Mesh(int partNum,
 1510:                    int npgb, int negb, int nsgb, 
 1511:                    int np, int ne, int ns,
 1512:                    int max_np, int max_ne, int max_ns, int nseg,
 1513:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1514:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1515:                    Node    **localNodeNeighNodesMem,
 1516:                    Element **localNodeNeighElemsMem,
 1517:                    double *partCoeffMatrixMem,
 1518:                    NodeBoundary *localNodeBoundaryMem,
 1519:                    SideBoundary *localSideBoundaryMem,
 1520:                    BoundarySegment *localSegmentMem,
 1521:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1522:                    double *cs, double *dcs
 1523:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1524:                        np(np), ne(ne), ns(ns),
 1525:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1526:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1527:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1528:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1529:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1530:                        localSegmentMem(localSegmentMem),
 1531:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1532:                        cs(cs), dcs(dcs),
 1533:                        coeffMatrixMem(partCoeffMatrixMem),
 1534:                        landBoundarySegment(true),
 1535:                        landBoundaryNode(true)
 1536:    {
 1537:       printf("Mesh constructor for partition %d\n", partNum);
 1538: 
 1539:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1540:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1541:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1542:  
 1543:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1544:       
 1545:       sinh_theta_f = sinh(theta_f);
 1546: 
