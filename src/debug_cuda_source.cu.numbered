 2799: 
 2800: __device__ void Node::updateKb(void) {
 2801: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2802: 
 2803:    if constexpr(ivcor == 1) return;
 2804: 
 2805: 
 2806:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2807: 
 2808:    if constexpr(ivcor == 2) {  // SZ coordinates
 2809:       
 2810:       // Compute bottom level index
 2811:       if (depth <= mesh->h_s) {
 2812:          kb = izlev;   
 2813:          
 2814:       } else {
 2815:          kb = -1;
 2816:          int L = 0;
 2817:          int R = nzlev; 
 2818:          
 2819:          while (L <= R) {
 2820:             int M = (R + L) / 2;
 2821: 
 2822: 
 2823:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2824:             
 2825:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2826:                R = M;
 2827:             } else {
 2828:                L = M;
 2829:             }
 2830: 
 2831:             if (R - L == 1) {
 2832:                kb = L;
 2833:                break;
 2834:             }
 2835:          }
 2836: 
 2837:          // Checks that the binary search was successful
 2838:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2839:        
 2840:       }
 2841:    } 
 2842: }
 2843: 
