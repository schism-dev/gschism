 8918:                    double *node_coords, double *node_coords_ll, bool use_ll,
 8919:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 8920:                    int *isdel, int *isidenode, int *isbnd,
 8921:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 8922:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8923:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8924:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8925:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 8926:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 8927:                    double *drag, double *roughness,
 8928:                    double *emo, double *efa, 
 8929:                    double *umo, double *ufa, 
 8930:                    double *vmo, double *vfa) {
 8931: 
 8932:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8933:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 8934:                        isdel, isidenode, isbnd,
 8935:                        nond, nlnd, iond, ilnd, 
 8936:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8937:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8938:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 8939:                        localNodeIndices, localElemIndices, localSideIndices,
 8940:                        localNodePart, localElemPart, localSidePart,
 8941:                        drag, roughness,
 8942:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 8943:   }
