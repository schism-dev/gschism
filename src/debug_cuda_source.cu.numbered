 1001: struct Node {
 1002: 
 1003:    // Geometry information
 1004:    int idx;        // Index of the node
 1005:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1006:    int numNodes;   // Number of nodes neighbors of this node
 1007: 
 1008:    Element **elements; // Array of pointers to the elements that share this node
 1009:    int numElements;   // Number of elements that share this node
 1010: 
 1011:    Point3 p;
