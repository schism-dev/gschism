 6777:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6778: 
 6779:       SIDE(side);
 6780: 
 6781:       side->U = {0.0, 0.0}; 
 6782:          
 6783:       if(side->isDry) return;
 6784: 
 6785:       // Vertically integrated velocity U
 6786:       #pragma unroll 1
 6787:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6788: 
 6789:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6790: 
 6791:          side->U += side->Dz(k + 1)*uc;  
 6792: 
 6793:       }
 6794:    }
