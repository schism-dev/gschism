  914:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  915:                                        Point3 &xt, double zint, Vector3 &u_int);
  916:     
  917:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  918:                                                  Element *&nextElem, int &jlev, double &dt, double time_rm,
  919:                                                  const Side *origSide);
