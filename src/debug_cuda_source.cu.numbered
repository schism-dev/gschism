 7639: __global__ void returnMatrix(double *res) {
 7640:    // Debugging: returns the matrix as a CuPy array
 7641: 
 7642:    const int size = mesh->np;
 7643:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7644:       const Node *node = mesh->localNodeData + idx_node;
 7645:       res[idx_node*size + idx_node] = node->coeffDiag;
 7646:       for (int j = 0; j < node->numNodes; j++) {
 7647:          Node* nbNode = node->nodes[j];
 7648:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7649:       }
 7650: 
 7651:    }
 7652:    
 7653: }
