 6429: #ifdef DONTCOMPILE
 6430: __device__ void computeVerticalAdvection(void) {
 6431:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6432: 
 6433:    sdbt(1:2,:,:)=0.d0
 6434: 
 6435:    const Side *side = FROM kernel;
 6436: 
 6437:    if(side->isDry) return;
 6438: 
 6439:    // If side is wet...
 6440: 
 6441: 
 6442:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6443:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6444:    double ws[nvrt] = {} // w @ side
 6445:    int icount = 0;
 6446:    for (int j=0; j<2; j++) {
 6447:       const Element *elem = side->elements[j];
 6448:        
 6449:       if(elem != nullptr) {
 6450:          icount++;
 6451:          for (int k=0; k<nvrt; k++) {
 6452:             ws[k] = ws[k] + elem->w[k];
 6453:          }
 6454:       }
 6455:    }  // for j
 6456: 
 6457:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6458:    ws = ws/icount;
 6459: 
 6460:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6461:    // Splines allow for a smooth transition between vertical levels.
 6462:    // Splines have continuity restrictions at the internal knots, but
 6463:    // we have to provide the 1st derivatives at the endpoints.
 6464:    const int kbs = side->kbs; 
 6465:    
 6466:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6467:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6468:    initCubicSpline(kbs, nvrt, side, ws, up)
 6469: 
 6470:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6471:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6472:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6473: 
 6474:    // Total advection (average onto side)
 6475:    const Node *node1 = side->nodes[0];
 6476:    const Node *node2 = side->nodes[1];
 6477:    for (int k=kbs(i); k<nvrt; k++) {
 6478: 
 6479:       if constexpr(ics==1) {
 6480:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6481:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6482:       } else {
 6483:          // XXX IMPLEMENT THIS
 6484:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6485:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6486:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6487:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6488:       }  // if ics
 6489: 
 6490: 
 6491:    }
 6492: }
 6493: #endif
 6494: 
 6495: 
 6496: extern "C" {
 6497:    __global__ void computeElemAverageGhat(void) {
 6498:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6499: 
 6500:       ELEM(elem);
 6501:       
 6502:       elem->ghat1= {0.0, 0.0};  
 6503: 
 6504:       if constexpr(ihydraulics != 0) {
 6505:          if (nhtblocks > 0 && elem->isblock) return;
 6506:       }
 6507: 
 6508: 
 6509: 
 6510:       
 6511:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6512:       // tidal potential, horizontal diffusion, and baroclinic etc
 6513:       // Remember to update both fb and F 
 6514:       // If ics=2, ghat1 are in eframe (ll)
 6515:       // cff1-3: coefficients for 2D/3D
 6516:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6517:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6518:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6519: 
 6520:       if (elem->isDry) return;
 6521: 
 6522:       double av_cff1 = 0.0;  // av. for cff1
 6523:       double av_cff2 = 0.0;  // av. for cff2
 6524:       double av_cff3 = 0.0;  // av. for cff3
 6525:       double av_df = 0.0;  // av. for H^\alpha / H
 6526:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6527:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6528: 
 6529:       const int i34 = elem->i34;
 6530:       const int kb = elem->kb;
 6531: 
 6532:       for (int j=0; j<i34; j++) {
 6533:          // For each node and side in the element...
 6534: 
 6535:          const Node *node = elem->nodes[j];
 6536:          const Side *side = elem->sides[j];
 6537: 
 6538:          const double chi      = side->chi;
 6539:          const double veg_c2   = side->veg_c2;
 6540:          const double veg_beta = side->veg_beta;
 6541:          const double veg_h    = side->veg_h();
 6542:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6543: 
 6544:          // Node - const in elem
 6545:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6546:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6547: 
 6548:          if (elem->depth >= tip_dp) {
 6549:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6550:          }
 6551: 
 6552:          
 6553:          const double htot  = side->htot2();        // Total depth at the side
 6554:          const double zctr2 = side->zTopCanopy();  
 6555: 
 6556:          double cff1; 
 6557:          double cff2; 
 6558:          double cff3;   
 6559:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6560:          // coefficients applied to 2D/3D case 
 6561:             cff1 = side->hhat/htot;
 6562:             cff2 = 0.0;
 6563:             cff3 = 0.0;
 6564:          } else { //3D
 6565:             //Init for no-veg case
 6566:             cff1 = 1.0;
 6567:             cff2 = 1.0;
 6568:             cff3 = 0.0;
 6569: 
 6570:             if constexpr(iveg != 0) {
 6571:                // Computes coefficients used with vegetation terms G1, G2
 6572:                // cff1, cff3 are used for the first two terms in G1, G2:
 6573:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6574:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6575:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6576:                if(veg_h < 0.99*htot) { // submergent vegetation
 6577:                   cff1=1;
 6578:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6579:                   cff3 = veg_c;
 6580: 
 6581:                } else { // emergent vegetation
 6582:                   cff1 = 1.0/(1.0 + veg_c2);
 6583:                   cff2 = cff1;
 6584:                   cff3 = 0.0;
 6585: 
 6586:                }
 6587:             } // if iveg
 6588:          } //  2D/3D
 6589: 
 6590:          av_cff1 += cff1/i34;
 6591:          av_cff2 += cff2/i34;
 6592:          av_cff3 += cff3/i34;
 6593:          av_cff2_chi += cff2*chi/i34;
 6594:          av_cff3_chi += cff3*chi/i34;
 6595:          av_df += min(htot, veg_h)/(htot*i34);
 6596: 
 6597: 
 6598:          // btrack values: U^\star, U^{\star\alpha}
 6599:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6600:          Vector2 Ustar       = {0.0, 0.0}; 
 6601:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6602: 
 6603:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6604:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6605:          } else { //3D
 6606:             for (int k = side->kb + 1; k < nvrt; k++) {
 6607:             
 6608:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6609:                Ustar += w2;
 6610: 
 6611:                if constexpr(iveg != 0) {
 6612:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6613:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6614:                        Ustar_alpha += zrat*w2; // XXXX
 6615:                    }
 6616:                }  // if iveg
 6617:             }  // for k
 6618:          }  //2D/3D
 6619: 
 6620:          // If needed, project the side velocities to the element frame
 6621:          if constexpr(ics==2) {
 6622:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 6623:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 6624:          }
 6625:          
 6626: 
 6627:          // Add btrack & surface stress terms to \breve{G} first
 6628:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6629: 
 6630: 
 6631: 
 6632:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 6633:          Vector2 tau    = side->tau();  
 6634:          Vector2 ubstar = side->btu[side->kb + 1];  
 6635: 
 6636:          // If needed, project tau and ubstar to the element frame
 6637:          if constexpr(ics==2) {
 6638:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 6639:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 6640:          }
 6641: 
 6642:          // Term for surface and bottom stress
 6643:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6644: 
 6645: 
 6646:          // All terms in F,F^\alpha,f_b except baroclinic
 6647:          // F, f_b: all explicit terms excluding vegetation 
 6648:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6649:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6650:          const double coriolis = side->coriolis;
 6651:          Vector2 F  =  coriolis*side->U;  // F_x
 6652:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6653:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6654: 
 6655:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6656:             
 6657:             for (int k = side->kb; k < nvrt; k++) {
 6658:                if (zctr2 > side->zc[k-1]) {
 6659:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6660:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6661:                    Fa +=  coriolis*w2*zrat;
 6662:                } // if zctr2
 6663:             } // k
 6664:          } // iveg
 6665: 
 6666:          // Integrate horizontal viscosity force vertically
 6667:          for (int k=side->kb + 1; k<nvrt; k++) {
 6668:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6669: 
 6670:             F += levelHorVisc;
 6671: 
 6672:             // Vegetation term
 6673:             if constexpr(iveg!=0) {
 6674:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6675:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6676:                   Fa += levelHorVisc*zrat;
 6677:                } 
 6678:             } // if iveg
 6679:          } // for k
 6680: 
 6681:          // Get nu*grad(U) at the side's bottom level
 6682:          Vector2 nuGradU = side->nuGradU[side->kb];
 6683: 
 6684:          fb += nuGradU;
 6685: 
 6686:          // If needed, project vectorsF, fb and Fa to the element frame
 6687:          if constexpr(ics==2) {
 6688:             F    = side->frame.projHorVec(F,    elem->frame);
 6689:             fb   = side->frame.projHorVec(fb,   elem->frame);
 6690:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 6691:          } // if ics
 6692: 
 6693:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6694:       } // for j (nodes and sides)
 6695: 
 6696:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6697:          
 6698:       // Finish off terms in F, F^\alpha and f_b
 6699:       const double grav3 = elem->mean(&Node::grav2);
 6700:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6701: 
 6702: 
 6703:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6704:       for (int j=1; j<i34; j++) { 
 6705:          // For each side in the element...
 6706:          const Side *side = elem->sides[j];
 6707:          const double chi = side->chi;
 6708: 
 6709:          const double htot = side->htot2();
 6710:          const double veg_h = side->veg_h();
 6711:          const Vector2 F  = htot*fb;
 6712:          const Vector2 Fa = min(htot, veg_h)*fb;
 6713: 
 6714:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6715:       } // for j
 6716: 
 6717:       //botf1 etc are already in elem frame
 6718:       elem->ghat1 += tmp/i34;
 6719: 
 6720:       // Baroclinic force
 6721:       if constexpr(ibc==0) {
 6722:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6723: 
 6724:          Vector2 Fa = {0.0, 0.0};
 6725:          Vector2 intGradRho = {0.0, 0.0};
 6726:          
 6727:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6728:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6729:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6730: 
 6731:             // \in F [m^2/s/s]
 6732:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6733:          }
 6734: 
 6735:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6736:          const Vector2 F = av_df*Fa; //approx
 6737:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6738: 
 6739:       } // if ibc
 6740: 
 6741: 
 6742: 
 6743:    }
 6744: 
 6745: } // extern "C"
 6746: 
 6747: 
 6748: 
 6749: #ifdef DONTCOMPILE
 6750: __global__ void checkMassConservation(Tracers* sumtr) {
 6751: 
 6752:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6753: 
 6754:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6755: 
 6756:    Element *elem = &(mesh->localElemData[i]);
 6757: 
 6758:    // Skip dry elements
 6759:    if (elem->isDry) return;
 6760: 
 6761:    // Local sum array for this thread
 6762:    double localSum[N_TRACERS] = {0.0};
 6763: 
 6764:    // Sum over vertical levels for this element
 6765:    const int kbe = elem->kbe;
 6766:    const double area = elem->area;
 6767: 
 6768:    for (int k = kbe; k < nvrt; k++) {
 6769:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6770:       
 6771:       // Accumulate tracer mass
 6772:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6773:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6774:       }
 6775:    }
 6776: 
 6777:    //  This function returns per element sums. A reduction must be done on the host side.
 6778: }
 6779: 
 6780: 
 6781: __global__ void transport(void) {
 6782: 
 6783:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6784: 
 6785:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6786: 
 6787:    Element *elem = &(mesh->localElemData[ie]);
 6788: 
 6789:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6790: 
 6791:                for (int m=0; m<ntr; m++) {
 6792:                   for (int k=kbe(ie); k<nvrt; k++) {
 6793:                      // Calculate each polynomial's weight 
 6794:                      wm=0.d0; sum1=0.d0; 
 6795:                      wm1=0.d0; wm2=0.d0; 
 6796:                      for (int i=0; i<elem->nweno2; i++) {
 6797:                   
 6798:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6799:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6800:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6801:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6802:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6803:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6804:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6805:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6806:                      // -----------------Hu and Shu (1999)'s method----------------
 6807:                      b4=b1+b2+b3
 6808: 
 6809: //Error: add PRODUCTION CPP
 6810: #ifdef DEBUG
 6811:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6812:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6813:                     call parallel_abort(errmsg)
 6814:                   }
 6815: #endif
 6816: 
 6817:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6818:                   // !----test-------------- 
 6819:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6820:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6821:                   // !wm(i)=wm1(i)*wm2(i)
 6822:                   // !---------------------- 
 6823:                   sum1=sum1+wm(i)
 6824:                 } // end for i
 6825: 
 6826:                 wm=wm/sum1
 6827: 
 6828:                 for (int j=0; j<elem->i34; j++) {
 6829: 
 6830:                   const Side *side  = elem->sides[j];
 6831:                   const Node *node1 = side->n1;
 6832:                   const Node *node2 = side->n2;
 6833: 
 6834:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6835:                      trsd=0.d0
 6836:                      for (int kk=0; kk<nquad; kk++) {
 6837:                         for (int i=0; i<elem->nweno2; i++) {
 6838:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6839:                         } // end for i   
 6840:                      } // end for kk
 6841:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6842:                   } // outward flux
 6843:                } // end for j=1,i34(ie) ! side
 6844:             }
 6845:          }
 6846:               
 6847: 
 6848: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6849: //             //   calculate each polynomial's weight 
 6850: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6851: //                 wm=0.d0; sum1=0.d0
 6852: //                 do i=1,nweno1(ie) !for each polynomial
 6853: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6854: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6855: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6856: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6857: //                   wm(i)=b2
 6858: //                   sum1=sum1+b2
 6859: //                   !wm(i)=1.d0
 6860: //                   !sum1=sum1+1.d0
 6861: 
 6862: // // Error: PRODUCTION
 6863: // #ifdef DEBUG
 6864: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6865: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6866: //                     call parallel_abort(errmsg)
 6867: //                   endif
 6868: // #endif
 6869: 
 6870: //                 enddo !i
 6871: //                 wm=wm/sum1 !final weight
 6872: 
 6873:                 for (int j=0; j<elem->i34; j++) { // side
 6874:                   const Side *side = elem->sides[j];
 6875:                   const Node *node1 = side->n1;
 6876:                   const Node *node2 = side->n2;
 6877: 
 6878:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6879:                     trsd=0.d0
 6880:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6881:                       for (int i=0; i<elem->nweno1; i++) {
 6882:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6883:                       }
 6884:                     enddo //kk
 6885:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6886:                   } // outward flux
 6887:                 } // end for j=1,i34(ie) ! side
 6888:               } // end for k; ntr 
 6889: 
 6890:             else !simple upwind method
 6891:               do j=1,i34(ie)
 6892:                 jsj=elside(j,ie)
 6893:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6894:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6895:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6896:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6897:                   endif
 6898:                 enddo  !vertical layers
 6899:               enddo !j=1,i34(ie) ! side
 6900:             endif !order of accuracy
 6901: 
 6902:          //  enddo !ie
 6903: // !$OMP     end do
 6904: 
 6905: // !$OMP     master
 6906: //           !message passing
 6907: //           if (nproc>1) then
 6908: //             !make a copy of side concentrations
 6909: //             trsd_tmp0=trsd_tmp 
 6910: 
 6911: //             !this exchange routine swaps interface concentration between two partitions
 6912: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6913: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6914: 
 6915: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6916: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6917: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6918: 
 6919: 
 6920: //             !This obtains final values for interface sides
 6921: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6922: //       :    endif !nproc>1
 6923: //           !message passing end
 6924: // !$OMP     end master
 6925: // !$OMP     barrier
 6926: 
 6927: 
 6928: // !         Do advection; conc @ dry elem will not be changed
 6929: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 6930: // !$OMP     do reduction(+: h_mass_in)
 6931: //           do i=1,ne
 6932: //             if(idry_e(i)==1) cycle
 6933: 
 6934: 
 6935: // !           Wet elements with 3 wet nodes
 6936: //             do k=kbe(i)+1,nvrt
 6937: 
 6938: 
 6939: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 6940: //               dtb_by_bigv = dtb/bigv
 6941:     
 6942: // !             Advective flux
 6943: //               if (ntd_weno==1 .or. itd_weno==1) then
 6944: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 6945: //               else
 6946: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 6947: //               endif
 6948: 
 6949: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 6950: //               do j=1,i34(i)
 6951: //                 jsj=elside(j,i) !side
 6952: //                 iweno=.true. !use weno reconstruction as default
 6953: //                 iel=ic3(j,i) !neighboring elem
 6954: 
 6955: //                 if(iel/=0) then
 6956: //                   if(idry_e(iel)==1) cycle
 6957: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 6958: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 6959: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 6960: //                     iweno=.false.
 6961: //                   endif
 6962: //                 else !land or open bnd side
 6963: //                   !skip land bnd and outflowing open bnd, 
 6964: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 6965: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 6966: //                     !For outflow open bnd side, estimate mass in (open
 6967: //                     !side cannot be interface side)
 6968: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 6969: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 6970: //                     endif
 6971: 
 6972: //                     cycle
 6973: //                   endif
 6974: 
 6975: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 6976: //                   iweno=.false.  !reset to upwind
 6977: //                   ibnd=isbs(jsj) !global bnd #
 6978: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 6979: //                   nwild(1:2)=0
 6980: //                   do ll=1,2 !nodes
 6981: //                     ndo=isidenode(ll,jsj)
 6982: //                     do lll=1,2 !2 possible bnds
 6983: //                       if(isbnd(lll,ndo)==ibnd) then
 6984: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 6985: //                         exit
 6986: //                       endif
 6987: //                     enddo !lll
 6988: //                   enddo !ll
 6989: //                   ind1=nwild(1); ind2=nwild(2);
 6990: 
 6991: //                   do jj=1,natrm
 6992: //                     if(ntrs(jj)<=0) cycle
 6993: 
 6994: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 6995: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 6996: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 6997: //                       enddo !ll
 6998: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 6999: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7000: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7001: //                       enddo !ll
