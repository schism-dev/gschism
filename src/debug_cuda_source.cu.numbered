 9279: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9280:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9281:    NODE(node);
 9282: 
 9283:    switch (varCode) {
 9284:       case (int)VarCode::outputCoords: {
 9285:          const Point2 coords = node->outputCoords();
 9286:          double *out = (double *)((char *)res + idx_node * 16);
 9287:          out[0] = coords.x;
 9288:          out[1] = coords.y;
 9289:          break;
 9290:       }
 9291:       case (int)VarCode::depth:
 9292:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9293:          break;
 9294:       case (int)VarCode::kb:
 9295:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9296:          break;
 9297:       case (int)VarCode::eta:
 9298:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9299:          break;
 9300:       case (int)VarCode::u_air: {
 9301:          double *out = (double *)((char *)res + idx_node * 16);
 9302:          out[0] = node->u_air.x;
 9303:          out[1] = node->u_air.y;
 9304:          break;
 9305:       }
 9306:       case (int)VarCode::isdry:
 9307:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9308:          break;
 9309:       case (int)VarCode::u: {
 9310:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9311:          if (k >= 0) {
 9312:             out[0] = node->u2[k].x;
 9313:             out[1] = node->u2[k].y;
 9314:          } else {
 9315:             for (int lev = 0; lev < nvrt; lev++) {
 9316:                out[lev*2    ] = node->u2[lev].x;
 9317:                out[lev*2 + 1] = node->u2[lev].y;
 9318:             }
 9319:          }
 9320:          break;
 9321:       }
 9322:       case (int)VarCode::z: {
 9323:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9324:          if (k >= 0)
 9325:             out[0] = node->z[k];
 9326:          else
 9327:             for (int lev = 0; lev < nvrt; lev++)
 9328:                out[lev] = node->z[lev];
 9329:          break;
 9330:       }
 9331:       case (int)VarCode::w: {
 9332:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9333:          if (k >= 0)
 9334:             out[0] = node->w2[k];
 9335:          else
 9336:             for (int lev = 0; lev < nvrt; lev++)
 9337:                out[lev] = node->w2[lev];
 9338:          break;
 9339:       }
 9340:       case (int)VarCode::dfh: {
 9341:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9342:          if (k >= 0)
 9343:             out[0] = node->dfh[k];
 9344:          else
 9345:             for (int lev = 0; lev < nvrt; lev++)
 9346:                out[lev] = node->dfh[lev];
 9347:          break;
 9348:       }
 9349:       case (int)VarCode::dfv: {
 9350:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9351:          if (k >= 0)
 9352:             out[0] = node->dfv[k];
 9353:          else
 9354:             for (int lev = 0; lev < nvrt; lev++)
 9355:                out[lev] = node->dfv[lev];
 9356:          break;
 9357:       }
 9358:       case (int)VarCode::tke: {
 9359:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9360:          if (k >= 0)
 9361:             out[0] = getTKE(node->turb, k);
 9362:          else
 9363:             for (int lev = 0; lev < nvrt; lev++)
 9364:                out[lev] = getTKE(node->turb, lev);
 9365:          break;
 9366:       }
 9367:       case (int)VarCode::mxl: {
 9368:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9369:          if (k >= 0)
 9370:             out[0] = getMXL(node->turb, k);
 9371:          else
 9372:             for (int lev = 0; lev < nvrt; lev++)
 9373:                out[lev] = getMXL(node->turb, lev);
 9374:          break;
 9375:       }
 9376:    }
 9377: }
