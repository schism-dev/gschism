 2800: 
 2801: __device__ double Node::compZCoord(int k) const {
 2802:    // Computes the z coordinate at level k.
 2803:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2804:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2805:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2806:    // used 
 2807: 
 2808:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 2809:    
 2810:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2811: 
 2812:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 2813: 
 2814:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2815: 
 2816:    if constexpr(ivcor == 2) {
 2817: 
 2818:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2819:       const double h_c = mesh->h_c;
 2820:       const double theta_f = mesh->theta_f;
 2821:       const double sinh_theta_f = mesh->sinh_theta_f;
 2822: 
 2823: 
 2824:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2825:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2826:       // once per time step/node.
 2827:       // CHECK: updateZCoordData
 2828: 
 2829:       //  To simplify comparisons, I define index versions of count variables.
 2830:       if      (k == ivrt)     return eta2; 
 2831:       else if (k == izlev)    return -hmod2;
 2832:       else if (k == kb)       return -depth;
 2833:       else if (k < izlev)     return mesh->ztot[k];
 2834:       else if (k > izlev) {
 2835:          const int ksig = k - izlev;
 2836: 
 2837:          if (hmod2 <= h_c) {
 2838:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2839: 
 2840:          } 
 2841:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 2842:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2843:             assert(false && "ZCOOR: invalid h_c\n");
 2844:          } 
 2845:          else {
 2846:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2847:                    h_c * mesh->sigma[ksig] + 
 2848:                    (hmod2 - h_c) * mesh->cs[ksig];
 2849:          }
 2850:       } else { 
 2851:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2852:       }
 2853: 
 2854:    }
 2855:    else if constexpr(ivcor == 1) {
 2856:       if (k == kb) return -depth;
 2857:       else if (k == nvrt-1) return eta2;
 2858:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2859:    }
 2860:    
 2861:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2862:    return 0.0;
 2863: }
 2864: 
 2865: 
 2866: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2867:    // Computes the bottom drag Cd based on the selected nchi
 2868: 
 2869:    if constexpr(nchi == 0) {
 2870:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2871:       Cd = drag;  // Read from drag file
 2872: 
 2873:    } else if constexpr(nchi == 1) {
 2874:       // 
 2875: 
 2876:       bool ltmp = false; // for WBL iteration
 2877: 
 2878:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2879:       if (isDry || (rough == 0.0)) {
 2880:          Cd = 0.0;
 2881: 
 2882:       } else { //roughness >0 
 2883:          
 2884:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2885: 
 2886:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2887: 
 2888:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2889: 
 2890:       } // if rough
 2891: 
 2892:    } else if constexpr(nchi == -1) {
 2893:    // Manning 
 2894:  
 2895:       const double htot = max(hmin_man, htot2()); 
 2896:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2897: 
 2898:    } else {
 2899:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2900:       
 2901:    } // if nchi
 2902: 
 2903: }
 2904: 
 2905: 
 2906: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2907:    // Checks if a side in on the boundary
 2908:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2909: 
 2910:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2911:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2912: 
 2913:    // Indices of the nodes that form the side
 2914:    const int n1 = side.n1->idx;
 2915:    const int n2 = side.n2->idx;
 2916:    isLand = false;
 2917:    
 2918: 
 2919:    // Check if the side is on a land boundary
 2920:    for (int i = 0; i < nland; i++) {
 2921:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2922:          // Consecutive nodes in the land boundary segment
 2923:          const int b1 = ilnd[i + j*nland];
 2924:          const int b2 = ilnd[i + (j + 1)*nland];
 2925: 
 2926:          assert(b1 != -1 && b2 != -1);
 2927: 
 2928:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2929:             
 2930:             isLand = true;
 2931:             return i;
 2932:          }
 2933:       }
 2934:    }
 2935: 
 2936:    // Check if the side is on an open boundary
 2937:    for (int i = 0; i < nope; i++) {
 2938:       for (int j = 0; j < nond[i] - 1; j++) {
 2939:          // Consecutive nodes in the open boundary segment
 2940:          const int b1 = iond[i + j*nope];
 2941:          const int b2 = iond[i + (j + 1)*nope];
 2942: 
 2943:          assert(b1 != -1 && b2 != -1);
 2944: 
 2945:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2946:             isLand = false;
 2947:             return i;
 2948:          }
 2949:       }
 2950:    }
 2951: 
 2952:    return -1;
 2953: }
 2954: 
 2955: 
 2956: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2957:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2958:                                     double *wind_rotate_angle, 
 2959:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2960:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2961:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2962:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2963:                                     double *drag, double *roughness, double *rmanning) {
 2964: 
 2965:    NODE(pnode);  
 2966:    const int i = idx_node;
 2967:    Node &node(*pnode);
 2968: 
 2969:    node.idx = i;
 2970: 
 2971:    const int idxNodeStart = nodeNeighNodesStart[i];
 2972:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2973:    node.numNodes = idxNodeEnd - idxNodeStart;
 2974:    node.nodes = nodeNeighNodes + idxNodeStart;
 2975:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2976: 
 2977: 
 2978: 
 2979:    const int idxElemStart = nodeNeighElemsStart[i];
 2980:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2981:    node.numElements = idxElemEnd - idxElemStart;
 2982:    node.elements = nodeNeighElems + idxElemStart;
 2983: 
 2984: 
 2985:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2986:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2987:       const int partNode = localNodePart[idxNodeGlobal]; 
 2988:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2989: 
 2990:       Node *node_ptr = nodes[partNode] + idxNode;
 2991:       
 2992:       nodeNeighNodes[idx] = node_ptr;
 2993:    }
 2994: 
 2995: 
 2996:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2997:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2998:       const int partElem = localElemPart[idxElemGlobal];
 2999:       const int idxElem  = localElemIndices[idxElemGlobal];
 3000: 
 3001:       Element *elem_ptr = elems[partElem] + idxElem;
 3002: 
 3003:       nodeNeighElems[idx] = elem_ptr;
 3004:    }      
 3005: 
 3006:    node.wind_angle = wind_rotate_angle[i];
 3007: 
 3008: 
 3009:    node.p.x   = node_coords[i * 3];
 3010:    node.p.y   = node_coords[i * 3 + 1];
 3011:    node.depth = node_coords[i * 3 + 2];
 3012: 
 3013:    if (use_ll) {
 3014:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3015:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3016:    }
 3017: 
 3018: 
 3019:    node.numSides = 0;
 3020: 
 3021:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3022:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3023:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3024:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3025:    else assert(false && "populateNodes: selected nchi not implemented.");
 3026:    
 3027:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3028:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3029:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3030: 
 3031:    
 3032:    // Links the node to the boundary information
 3033:    if (isbnd[i] >= 0) {
 3034:      
 3035:       // Get the index of the node boundary
 3036:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3037: 
 3038:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3039:       node.nodeBnd->node = &node;
 3040: 
 3041:       node.nodeBnd->sideBnd1 = nullptr;
 3042:       node.nodeBnd->sideBnd2 = nullptr;
 3043: 
 3044:       if (isbnd[i]>=0) {
 3045: 
 3046:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3047:          
 3048:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3049:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3050: 
 3051:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3052:          node.nodeBnd->segment->clen  = nan("1");
 3053:          node.nodeBnd->segment->carea = nan("1");
 3054: 
 3055:       }
 3056:    } else {
 3057: 
 3058:       node.nodeBnd = nullptr; // For internal nodes
 3059: 
 3060:       if (isbnd[i] == landSegment) {
 3061:          node.nodeBnd = &landBoundaryNode;
 3062:          node.nodeBnd->segment = &landBoundarySegment;
 3063:       }
 3064:       
 3065:    }
 3066:    
 3067:    // XXXX GAUSSIAN HILL VELOCITIES
 3068: #ifdef GAUSSIAN_HILL_VELOCITIES
 3069:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3070:       constexpr double rot_per = 3000.0;
 3071:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3072:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3073:    // XXXXX
 3074: #endif
 3075: 
 3076: }
 3077: 
 3078: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3079:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3080:                                     double *wind_rotate_angle,   
 3081:                                     int *isdel, int *isidenode, int *isbnd,
 3082:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3083:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3084:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3085:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3086:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3087:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3088:                                     double *drag, double *roughness) {
 3089: 
 3090: 
 3091:    SIDE(pside);
 3092:    Side &side(*pside);
 3093:    const int i = idx_side;
 3094: 
 3095:    side.idx = i;  
 3096:    
 3097:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3098:    const double fc   = 2.0*omega_e*sin(sfea0);
 3099:    const double beta = 2.0*omega_e*cos(sfea0);
 3100: 
 3101:    // finding the pointer to the nodes that form the side
 3102:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3103:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3104: 
 3105:    const int locidx_n1 = localNodeIndices[idx_n1];
 3106:    const int locidx_n2 = localNodeIndices[idx_n2];
 3107:    const int part_n1 =   localNodePart[idx_n1];
 3108:    const int part_n2 =   localNodePart[idx_n2];
 3109: 
 3110:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3111:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3112: 
 3113:    // Counts the number of sides connected to each node
 3114:    side.n1->numSides++;
 3115:    side.n2->numSides++;
 3116: 
 3117:    // Normal, unitary vector to the side
 3118:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3119:    side.n = normalize(side.n);
 3120: 
 3121:    // Side boundary type
 3122:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3123:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3124: 
 3125:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3126:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3127:    {
 3128:       bool isLand = false;
 3129:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3130:       
 3131:       if (isbs > -1) {
 3132:          // assert(isLand || isbs>=0);
 3133:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3134: 
 3135:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3136: 
 3137:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3138:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3139: 
 3140:          assert (isLand == side.sideBnd->segment->isLand);
 3141: 
 3142:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3143:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3144:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3145: 
 3146:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3147:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3148:          
 3149:          side.sideBnd->side = &side;
 3150: 
 3151:       }
 3152:       else {
 3153:          side.sideBnd = nullptr;
 3154:       }
 3155:    }
 3156:    else 
 3157:    {
 3158:       side.sideBnd = nullptr;
 3159:    }
 3160: 
 3161: 
 3162:    // finding the pointer to the elements that share the side
 3163:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3164:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3165: 
 3166:    if (idx_e1 > -1) {
 3167:       const int locidx_e1 = localElemIndices[idx_e1];
 3168:       const int part_e1 =  localElemPart[idx_e1];
 3169:       side.elems[0] = elems[part_e1] + locidx_e1;
 3170: 
 3171:    }
 3172:    else {
 3173:       side.elems[0] = nullptr;
 3174:    }
 3175: 
 3176:    if (idx_e2 > -1) {
 3177:       const int locidx_e2 = localElemIndices[idx_e2];
 3178:       const int part_e2 =  localElemPart[idx_e2];
 3179:       side.elems[1] = elems[part_e2] + locidx_e2;
 3180:    }
 3181:    else {
 3182:       side.elems[1] = nullptr;
 3183:    }
 3184: 
 3185:    // Compute the center of the side
 3186:    side.center = 0.5*(side.n1->p + side.n2->p);
 3187: 
 3188:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3189:    side.shapiro = shapiro0;
 3190: 
 3191: #ifdef GAUSSIAN_HILL_VELOCITIES
 3192: // XXXX
 3193: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3194: constexpr double rot_per=3000.0;
 3195: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3196: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3197: // XXXXX      
 3198: #endif
 3199:    // Compute the z level at the center of the side
 3200:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3201:    
 3202:    // Compute the length of the side
 3203:    const Vector2 vLen = side.n2->p - side.n1->p;
 3204:    side.len = sqrt(dot(vLen, vLen));
 3205: 
 3206: 
 3207:    // Compute the Coriolis coefficient
 3208: 
 3209:    if constexpr(ncor == -1 || ncor == 0) {
 3210:       side.coriolis = coricoef;
 3211:    }
 3212:    else {
 3213:       const double sphi = side.lat();  // Latitude at the center of the side
 3214: 
 3215: // XXXXXX ERROR WHEN use_ll is false??????
 3216:       if constexpr(ics == 1) {
 3217:          // XXXXXXX
 3218:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3219:       }
 3220:       else {
 3221:          side.coriolis = 2.0*omega_e*sin(sphi);
 3222:       }
 3223: 
 3224:    }
 3225: }
 3226: 
 3227: 
 3228: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3229:    double *node_coords, double *node_coords_ll, bool use_ll,
 3230:    double *wind_rotate_angle,   
 3231:    int *isdel, int *isidenode, int *isbnd,
 3232:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3233:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3234:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3235:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3236:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3237:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3238:    double *drag, double *roughness) {
 3239: 
 3240:    ELEM(pelem);
 3241:    Element &elem(*pelem);
 3242:    const int i = idx_elem;
 3243: 
 3244:    elem.idx = i;
 3245: 
 3246:    for (int j = 0; j < i34[i]; j++) {
 3247:       const int idxNode = elnode[i*4 + j];  
 3248:       const int idxSide = elside[i*4 + j];
 3249:       
 3250:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3251:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3252: 
 3253:       // Find the neighboring element  
 3254:       if (elem.sides[j]->elems[0] == &elem) {
 3255:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3256:       }
 3257:       else {
 3258:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3259:       }
 3260:       
 3261:    }
 3262: 
 3263:    elem.i34 = i34[i];
 3264: 
 3265:    // Compute the barycenter of the element and its depth
 3266:    elem.center = {0.0, 0.0};
 3267:    elem.depth = 0.0;
 3268:    for (int j = 0; j < i34[i]; j++) {
 3269: 
 3270:       elem.center += elem.nodes[j]->p/i34[i];
 3271:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3272:    }
 3273: 
 3274: 
 3275:    
 3276:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3277:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3278: 
 3279:    elem.area = elem.computeSignedArea(); 
 3280:    elem.radius = sqrt(elem.area)/pi; 
 3281:    
 3282:    // Determines which way the normal vector to each side is oriented.
 3283:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3284:    for (int j = 0; j < i34[i]; j++)  
 3285:    {
 3286:       if (elem.sides[j]->elems[0] == &elem) {
 3287:          elem.ssign[j] =  1.0;
 3288:       }
 3289:       else {
 3290:          elem.ssign[j] = -1.0;
 3291:       }
 3292: 
 3293:    }
 3294: 
 3295:    // Derivatives of shape functions
 3296:    //  For ics=2, this is done inside element/ll frame XXX
 3297:    //  For quads, the derivative is evaluated at centroid
 3298:    for (int j = 0; j < elem.i34; j++) {
 3299:       const double area = elem.area;
 3300:       const int id2 = elem.nxq(1 + j);
 3301:       const int id3 = elem.nxq(2 + j);
 3302:       const int id4 = elem.nxq(3 + j);
 3303:       if (elem.isTri()) {
 3304:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3305:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3306:          // da1/dx = (y1 - y2)/(2*area)
 3307:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3308:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3309:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3310:       }
 3311:       else  { // Quad; evaluate at centroid
 3312:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3313:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3314:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3315:       } // if Tri
 3316: 
 3317:    } // for j   
 3318:    
 3319:    
 3320: 
 3321: }
 3322: 
 3323: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3324:                                             double *emo, double *efa, 
 3325:                                             double *umo, double *ufa, 
 3326:                                             double *vmo, double *vfa) {
 3327: 
 3328: 
 3329:    NODE_BND(nodeBnd);
 3330:    const int idx = idx_node_bnd;    
 3331: 
 3332:    nodeBnd->idx = idx;
 3333: 
 3334:    // Need to find the segment index and the index of the node on the segment
 3335:    int idxNode = -1;
 3336:    int iseg, i;
 3337:    for (iseg = 0; iseg < nope; iseg++) {
 3338:       // for each segment...
 3339:       for (i = 0; i < nond[iseg]; i++) {
 3340:          idxNode = iond[iseg + i*nope];
 3341:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3342:          
 3343:       }
 3344:    }
 3345: 
 3346:    assert(iseg < nope && "iseg is out of bounds");
 3347: 
 3348: found: // Jumped here when the node was found
 3349: 
 3350:    nodeBnd->isEssentialBC = true;
 3351:    nodeBnd->elbc = 0.0;
 3352: 
 3353:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3354: 
 3355:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3356:       nodeBnd->efa[jfr] = efa[idx2];
 3357:       nodeBnd->emo[jfr] = emo[idx2];
 3358:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3359:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3360: 
 3361:    }
 3362:         
 3363: 
 3364: }
