 4357: 
 4358: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4359:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4360:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4361: 
 4362: 
 4363:    NODE(node1);
 4364: 
 4365:    node1->clearMatrixRow();
 4366:    node1->qel = 0.0;
 4367: 
 4368:    // THIS IS FOR STRUCTURES XXX
 4369:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4370: 
 4371:    
 4372:    for (int j=0; j<node1->numElements; j++) {
 4373:       // For each element connected to the node...
 4374: 
 4375:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4376: 
 4377:       Element *elem = node1->elements[j];
 4378: 
 4379:       // Compute the average gravity
 4380:       const double grav3 = elem->mean(&Node::grav2);
 4381: 
 4382:       // Look at the documentation for the description of the terms in the following integrals
 4383: 
 4384:       // Integral I_1 
 4385:       // \bar{\breve{H}} 
 4386:       const double hhatb = elem->mean(&Side::hhat);        
 4387: 
 4388:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4389: 
 4390:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4391:       const double area = elem->area;
 4392: 
 4393:       // Integral I_4
 4394:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4395:       // Where
 4396:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4397: 
 4398:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4399:       // of U over the element.
 4400:       const Vector2 U = elem->mean(&Side::U);
 4401: 
 4402:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4403: 
 4404:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4405:       const double I_4_1 = dot(gradPhi_1, U);
 4406: 
 4407: 
 4408:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4409:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4410: 
 4411:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4412: 
 4413: 
 4414:       // Normal component of the bed velocity
 4415:       double ubedNormalComp = 0.0;
 4416:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4417:          Vector3 ubed = {0.0, 0.0, 0.0};
 4418:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4419:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4420: 
 4421:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4422:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4423:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4424: 
 4425:          // Computes the normal component of the bed velocity
 4426:          ubedNormalComp = dot(ubed, N);
 4427:       } // imm==2
 4428: 
 4429:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4430: 
 4431:       if (elem->isTri()) {
 4432: 
 4433:          // To clarify the notation in this section: 
 4434:          //   In formulas, we use the following notation:
 4435:          //       i stands for the node under consideration (node1)
 4436:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4437:          //   However, in the code, we use the following notation:
 4438:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4439:          const int id2 = elem->nxq(1 + id1);
 4440:          const int id3 = elem->nxq(2 + id1);
 4441:          Node *node2 = elem->nodes[id2];
 4442:          Node *node3 = elem->nodes[id3];
 4443: 
 4444:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4445: 
 4446:          // integral of phi_i*phi_j
 4447:          const double ipp_ii = (1.0/6.0 )*area;
 4448:          const double ipp_ij = (1.0/12.0)*area;
 4449:          const double ipp_ik = (1.0/12.0)*area;
 4450: 
 4451:          // integral of [(grad phi_i) * (grad phi_j)]
 4452:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4453:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4454:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4455: 
 4456:          // Computes the different components of integral I_1 of each node with respect to node i.
 4457:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4458:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4459:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4460: 
 4461:          node1->addToSparseMatrix(node1, I1_ii);
 4462:          node1->addToSparseMatrix(node2, I1_ij); 
 4463:          node1->addToSparseMatrix(node3, I1_ik);
 4464: 
 4465:          #pragma unroll
 4466:          for (int l=0; l<3; l++) {
 4467: 
 4468:             Node *node = elem->nodes[l];
 4469: 
 4470:             // Additional variation in eta due to bed deformation or vertical velocity
 4471:             double extraEta = 0.0;
 4472:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4473:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4474: 
 4475: 
 4476:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4477:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4478: 
 4479:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4480: 
 4481:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4482:            
 4483:          }
 4484: 
 4485: 
 4486:       }
 4487:       else { // Quad
 4488:          // To clarify the notation in this section: 
 4489:          //   In formulas, we use the following notation:
 4490:          //       i stands for the node under consideration (node1)
 4491:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4492:          //   However, in the code, we use the following notation:
 4493:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4494:          const int id2 = elem->nxq(1 + id1);
 4495:          const int id3 = elem->nxq(2 + id1);
 4496:          const int id4 = elem->nxq(3 + id1);
 4497:          Node *node2 = elem->nodes[id2];
 4498:          Node *node3 = elem->nodes[id3];
 4499:          Node *node4 = elem->nodes[id4];   
 4500:          
 4501:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4502: 
 4503:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4504:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4505:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4506:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4507:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4508: 
 4509:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4510:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4511:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4512:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4513:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4514: 
 4515: 
 4516:          // Computes the different components of integral I_1 of each node with respect to node i.
 4517:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4518:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4519:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4520:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4521: 
 4522:          node1->addToSparseMatrix(node1, I1_ii);
 4523:          node1->addToSparseMatrix(node2, I1_ij); 
 4524:          node1->addToSparseMatrix(node3, I1_ik);
 4525:          node1->addToSparseMatrix(node4, I1_il);
 4526:   
 4527:          #pragma unroll
 4528:          for (int l=0; l<4; l++) {
 4529: 
 4530:             const Node *node = elem->nodes[l];
 4531: 
 4532:             // Additional variation in eta due to bed deformation or vertical velocity
 4533:             double extraEta = 0.0;
 4534:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4535:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4536: 
 4537:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4538:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4539:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4540: 
 4541:          }         
 4542:       } 
 4543: 
 4544: 
 4545:      node1->qel += (dt/elem->i34)*elem->vsource;
 4546:       
 4547: 
 4548:    } // for all elements connected to the node
 4549:    
 4550: 
 4551:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4552:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4553:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4554:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4555:    // If it is an open boundary node...
 4556: 
 4557:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4558: 
 4559:       // At least one open bnd side, maybe two
 4560:       for (int l=0; l<2; l++) { 
 4561: 
 4562:          // Gets each of the sides sharing the node. 
 4563:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4564: 
 4565:     
 4566: 
 4567:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4568:          if (sideBnd != nullptr) {
 4569:             // If the side is on a boundary...
 4570: 
 4571:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4572: 
 4573:             // Get the boundary segment
 4574:             const BoundarySegment *sideSegment = sideBnd->segment;
 4575:             const Side *side = sideBnd->side;
 4576: 
 4577:             // Integral I_3
 4578:             if (sideSegment->ifltype != 0) {
 4579:             // Natural or Flather b.c.
 4580: 
 4581:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4582:                // especially for Flather b.c.
 4583:                double ri3 = 0.0;
 4584:                if (!side->isDry) {
 4585:                   // If the side is not dry
 4586:                   
 4587:                   // Computes the side flux of (uth, vth)
 4588:                   double Vn = 0.0;
 4589:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4590:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4591:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4592: 
 4593:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4594:                   }
 4595: 
 4596:                   ri3 = 0.5*side->len*Vn;
 4597:                }
 4598: 
 4599:                if (sideSegment->ifltype == -1) { // Flather 1
 4600: 
 4601:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4602:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4603: 
 4604:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4605:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4606:                   
 4607:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4608:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4609: 
 4610:                } 
 4611:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4612:                   // Reset ri3
 4613:                   ri3 = 0.0;
 4614: 
 4615:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4616:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4617: 
 4618:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4619: 
 4620:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4621:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4622: 
 4623:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4624:                   node1->addToSparseMatrix(node1, con0*2.0);
 4625:                   node1->addToSparseMatrix(node2, con0);
 4626: 
 4627:                } // if Flather or Discharge
 4628: 
 4629:                node1->qel -= thetai*dt*ri3;  
 4630: 
 4631: 
 4632:             } // I_3
 4633:           
 4634: 
 4635:             // Integral I_5
 4636:             if(!side->isDry) {
 4637: 
 4638:                const double Unbar = dot(side->U, side->n);
 4639:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4640: 
 4641:             } // I_5
 4642: 
 4643:          } // if is boundary side
 4644: 
 4645:       } // for l
 4646: 
 4647:    } // if isbnd
 4648: 
 4649: 
 4650: }
 4651: 
 4652: 
 4653: 
 4654: extern "C" {
 4655:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4656:                                   int* indices, int* indptr) {
 4657: 
 4658:       NODE(node);
 4659:       
 4660:       const int idx = node->idx;
 4661:       
 4662:       // Computes the index in the nzz array      
 4663:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4664: 
 4665: 
 4666:       indptr[idx] = nzzIdx;
 4667:       indices[nzzIdx] = idx;
 4668: 
 4669:       data_d[nzzIdx]    = node->coeffDiag;
 4670: 
 4671:       b_d[idx] = node->qel;
 4672: 
 4673:       for (int k = 0; k < node->numNodes; ++k) {
 4674:          const Node* nb = node->nodes[k];
 4675: 
 4676:          const int j = nb->idx;
 4677: 
 4678:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4679: 
 4680:          indices[nzzIdx + k + 1] = j;
 4681:       }
 4682: 
 4683:  
 4684:    }
 4685: 
 4686: 
 4687: 
 4688:    __global__ void solverCopyResult(double* x) {
 4689:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4690:       NODE(node);
 4691:       const int idx = node->idx;
 4692: 
 4693:       node->mX = x[idx];
 4694:    }
 4695: 
 4696: 
 4697:    __global__ void rollUpElevation(void) {
 4698: 
 4699:       NODE(node);
 4700: 
 4701:       node->eta1 = node->eta2;
 4702: 
 4703:    }
 4704: 
 4705: 
 4706:    __global__ void backtrackAllNodes(void) {
 4707: 
 4708:       // max/min # of sub-divisions
 4709:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4710:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4711: 
 4712:       SIDE(side);
 4713: 
 4714:       const int kb = side->kb;
 4715: 
 4716: 
 4717:       // Initialize btrack velocities to the actual velocities at the side 
 4718:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4719:   
 4720:       if (side->isDry) return;
 4721:      
 4722: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4723: 
 4724:       // Checks that at least one element is not dry
 4725:       const Element *elem1 = side->elems[0];
 4726:       const Element *elem2 = side->elems[1];
 4727: 
 4728: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4729: 
 4730:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4731:       
 4732:       // XXXXXX
 4733:       // !swild_tmp to store global coord. of the starting side
 4734:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4735:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4736:       // !Use sframe2 
 4737:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4738: 
 4739: 
 4740:       for (int k = kb; k < nvrt; k++) {
 4741:       //  For ics=2, the coordinates are all in the side's local frame
 4742: 
 4743:          const int iadvf = side->iadv();  // Advection flag   
 4744:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4745: 
 4746:          const double vmag2 = norm2(side->u2[k]);
 4747: 
 4748:          if (vmag2 <= velmin_btrack_sq) {  
 4749:             // No activity 
 4750: 
 4751:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4752:             
 4753:          } else {  // do btrack
 4754: 
 4755:             // Compute number of sub-divisions based on local gradients of the velocity field
 4756: 
 4757:             // XXX IS THIS NECESSARY?
 4758:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4759:             double suma = 0.0;
 4760:             int icount = 0;
 4761:             #pragma unroll
 4762:             for (int l=0; l<2; l++) {
 4763:             // For each element sharing the side...
 4764: 
 4765:                const Element *elem = side->elems[l];
 4766:                  
 4767:                if (elem == nullptr) continue;
 4768: 
 4769:                icount++;
 4770: 
 4771:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4772:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4773:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4774: 
 4775:                double utmp[4];
 4776:                double vtmp[4];
 4777:                #pragma unroll
 4778:                for (int j = 0; j < elem->i34; j++) {
 4779: 
 4780:                   const Node *node = elem->nodes[j];
 4781: 
 4782:                   if constexpr(ics==1) {
 4783:                      utmp[j] = node->u2[k].x;
 4784:                      vtmp[j] = node->u2[k].y;  
 4785: 
 4786:                   } else {
 4787:                      // 'Project' the velocity from the node frame to the element frame
 4788:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4789:                      utmp[j] = tmp_u2.x;
 4790:                      vtmp[j] = tmp_u2.y;
 4791: 
 4792:                   }
 4793:                } // for j
 4794: 
 4795:                const Vector2 grad_u = elem->grad2(utmp); 
 4796:                const Vector2 grad_v = elem->grad2(vtmp);
 4797:    
 4798:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4799:             } // for l
 4800: 
 4801:             assert(icount > 0 && "Impossible 77");
 4802: 
 4803:             // '4' is somewhat arbitrary
 4804:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4805: 
 4806:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4807:             Vector3 u_int = {0.0, 0.0, 0.0};
 4808: 
 4809:             side->btrack(k, dt, dtbk, u_int);
 4810: 
 4811: 
 4812:             side->btu[k] = {u_int.x, u_int.y};
 4813:                
 4814:          } // if vmag (do backtrack)
 4815: 
 4816: 
 4817:       } // for k=kb,nvrt-1
 4818: 
 4819:    }
 4820: 
 4821: } // extern "C"
 4822: 
 4823: template<int nc>
 4824: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4825: 
 4826: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4827: //
 4828: // a,b,c,rhs: input vectors and are not modified by this program.
 4829: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4830: // rhs is the r.h.s.
 4831: // n: actual rank of the system.
 4832: // rows in u() and rhs();
 4833: // u: output with nc columns (transposed to rows)
 4834: // gam: a working array.
 4835: //
 4836: // NOTES:
 4837: // This is a template function that allows for different numbers of columns in the rhs vector.
 4838: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4839: 
 4840:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4841:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4842: 
 4843:    double bet = b[0];
 4844:    if constexpr (nc == 1) {
 4845:       u[0] = rhs[0]/bet;
 4846:    } else {
 4847:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4848:    }
 4849: 
 4850:    for (int j = 1; j < n; j++) {
 4851:       gam[j] = c[j - 1]/bet;
 4852:       bet = b[j] - a[j]*gam[j];
 4853: 
 4854:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4855: 
 4856:       if constexpr (nc == 1) {
 4857:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4858:       } else {
 4859:          for (int l = 0; l < nc; l++) {
 4860:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4861:          }
 4862:       }
 4863:    }
 4864: 
 4865:    // Back-substitution
 4866:    for (int j = n - 2; j >= 0; j--) {
 4867:       if constexpr (nc == 1) {
 4868:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4869:       } else {
 4870:          for (int l = 0; l < nc; l++) {
 4871:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4872:          }
 4873:       }
 4874:    }
 4875: }
 4876: 
 4877: 
 4878: 
 4879: // Helper function that contains the core algorithm
 4880: template<typename XAccessor, typename YAccessor>
 4881: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4882:                                     double  yp_top, double  yp_bot, 
 4883:                                     CubicSpline &spline) {
 4884:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4885:    // 
 4886:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4887:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4888:    //
 4889:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4890:    // 
 4891:    // Inputs: 
 4892:    //            n: dimension for x etc; # of data pts (>=2);
 4893:    //            getX, getY: functions to access x,y coordinates
 4894:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4895:    //     Output: 
 4896:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4897: 
 4898:    const int n = k2 - k1 + 1;
 4899:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4900: 
 4901:    // Allocate memory for the splines
 4902:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4903:    spline.x   = new double[n];
 4904:    spline.y   = new double[n];
 4905:    spline.yp  = new double[n];
 4906:    spline.ypp = new double[n];
 4907: 
 4908:    for (int k=k1; k<=k2; k++) {
 4909:       spline.x[k] = getX(k);
 4910:       spline.y[k] = getY(k);
 4911:    }
 4912: 
 4913:    // This is to simplify expressions later
 4914:    double *x = spline.x;
 4915:    double *y = spline.y;
 4916: 
 4917:    double *a = nullptr;
 4918:    double *b = nullptr;
 4919:    double *c = nullptr;
 4920:    double *gam = nullptr;
 4921:    double *rhs = nullptr;
 4922:    
 4923: 
 4924:       a = new double[n];   // Lower diagonal
 4925:       b = new double[n];   // Diagonal
 4926:       c = new double[n];   // Upper diagonal
 4927:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4928:       rhs = new double[n]; // Right-hand side
 4929: 
 4930:    for (int k=k1; k<=k2; k++) {
 4931:       if (k == k1) {
 4932:          // Bottom level
 4933:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4934:          b[k] = (x[k+1] - x[k])/3.0;
 4935:          c[k] = b[k]/2.0;
 4936:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4937:       } else if (k == n - 1) {
 4938:          // Top level (surface)
 4939:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4940:          b[k] = (x[k] - x[k-1])/3.0;
 4941:          a[k] = b[k]/2.0;
 4942:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4943:       } else {
 4944:          // Intermediate levels
 4945:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4946:          b[k] = (x[k+1] - x[k-1])/3.0;
 4947:          a[k] = (x[k  ] - x[k-1])/6.0;
 4948:          c[k] = (x[k+1] - x[k  ])/6.0;
 4949:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4950:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4951:       }
 4952:    }
 4953: 
 4954:    // Solve the tridiagonal system
 4955:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4956:    
 4957:    spline.yp[k1] = yp_bot;
 4958:    spline.yp[k2] = yp_top;
 4959: 
 4960:    // Compute rest of 1st derivatives using the splines
 4961:    for (int k=k1+1; k<k2; k++) {
 4962:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4963:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4964:    }
 4965:    
 4966:    delete[] a;
 4967:    delete[] b;
 4968:    delete[] c;
 4969:    delete[] gam;
 4970:    delete[] rhs;
 4971: 
 4972: }
 4973: 
 4974: // Array version
 4975: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4976:                                 double y_top, double y_bot, 
 4977:                                 CubicSpline &spline) {
 4978:    auto getX = [x] (int k) { return x[k]; };
 4979:    auto getY = [y] (int k) { return y[k]; };
 4980:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4981: }
 4982: 
 4983: // Lambda version - allows custom access patterns
 4984: template<typename XFunc, typename YFunc>
 4985: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4986:                                 double y_top, double y_bot,
 4987:                                 CubicSpline &spline) {
 4988:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4989: }
