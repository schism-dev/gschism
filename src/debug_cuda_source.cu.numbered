 4687:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4688: 
 4689:       SIDE(side);
 4690: 
 4691: 
 4692:       side->U = {0.0, 0.0}; 
 4693:          
 4694:       if(side->isDry) return;
 4695: 
 4696:       const Node *node1 = side->n1;
 4697:       const Node *node2 = side->n2;
 4698: 
 4699:       // Vertically integrated velocity U (in ll if ics=2)
 4700:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4701:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4702:       }
 4703: 
 4704:    }
 4705: 
 4706:    __global__ void computeBottomDragVegetation(void) {
 4707:       // UNFINISHED. CHECK THIS:
 4708:       // How many kernels are needed? Why so many for loops?
 4709:       // Is the loop on sides needed?
 4710: 
 4711:       NODE(node);
 4712: 
 4713: 
 4714:       const int    kb      = node->kb;
 4715:       const double htot    = node->htot2(); 
 4716:       
 4717:       if (node->isDry) {
 4718:          // Default values for dry nodes
 4719:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4720:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4721: 
 4722:          return;
 4723:        
 4724:       }
 4725: 
 4726:       // Computes bottom drag Cd based on the selected nchi
 4727:       node->computeBottomDragCd();
 4728:       
 4729: 
 4730: 
 4731:       //   Bottom stress in m^2/s^2
 4732:       if (node->rho[kb + 1] >= -98.0)
 4733:       {
 4734:          const double mag_u = length(node->u2[kb + 1]);
 4735:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4736: 
 4737:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4738:          // !sediment erosion: this part needs more documentation
 4739:       }
 4740:     
 4741: 
 4742: 
 4743:       // Compute vegetation parameters
 4744:       //--------------------------------
 4745: 
 4746:       // SAV constants
 4747:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4748:       constexpr double veg_cfpsi = 0.16;
 4749: 
 4750:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4751:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4752: 
 4753:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4754:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4755:          int kbin = 0; // bin index
 4756:          for (int k = kb; k < nvrt; k++) {
 4757:             // Computes node height above the bottom level
 4758:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4759:             assert(false && "Vertical variation of vegetation not implemented");
 4760: 
 4761:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4762:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4763:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4764:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4765:             // } else {
 4766:             //    // Find the bin at which the current vertical level is
 4767:             //    while (kbin<nbins_veg_vert) {
 4768:             //       const double zn = node->z[kbin];
 4769:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4770:             //          break;
 4771:             //       } // if
 4772:             //       kbin++;
 4773:             //    } // while
 4774:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4775: 
 4776:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4777:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4778:                
 4779:             //    // Linear interpolation of the vegetation parameters
 4780:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4781:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4782:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4783:             // } // if rl10
 4784: 
 4785:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4786: 
 4787:          } // for k
 4788: 
 4789: 
 4790:       } else { // Ganthy (iveg==2)
 4791:       //  Modify canopy height, diameter, and density
 4792: 
 4793:          // Make sure there is vegetation on this node
 4794:          if (node->veg_h_unbent > 0.0) {
 4795:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4796: 
 4797:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4798:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4799:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4800: 
 4801:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4802:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4803:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4804:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4805:          } // if veg_h_unbent
 4806: 
 4807:          for (int k = 0; k < nvrt; k++) {
 4808:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4809:          } // for k
 4810:       
 4811: 
 4812:       } // if iveg
 4813:      
 4814: 
 4815:       // Compute vertical mean of veg_alpha3D
 4816:       if (iveg != 0) {
 4817:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4818:          double sum1=0.0;
 4819:          double sum2=0.0;
 4820:          // Integrate over each level under the canopy...
 4821:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4822:             const double Dz = node->Dz(k);
 4823: 
 4824:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4825:             sum2 += Dz;
 4826: 
 4827:          } // for k
 4828:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4829:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4830: 
 4831:       } // if iveg
 4832: 
 4833:    }
 4834: 
 4835:    __global__ void computeVegetationAndDragParameters(void) {
 4836:       // Computes the vegetation and drag model parameters:
 4837:       // chi, \tilde\chi, beta, \breve{H}
 4838:       
 4839:       SIDE(side);
 4840: 
 4841:       if (side->isDry) return;
 4842: 
 4843:       const double htot = side->htot2();
 4844:       const int    kb   = side->kb;
 4845: 
 4846:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4847: 
 4848:       const double veg_h     = side->veg_h();
 4849:       const double veg_nv    = side->veg_nv();
 4850:       const double veg_c     = side->veg_c();
 4851:       const double veg_beta  = side->veg_beta;
 4852:       const double veg_alpha = side->veg_alpha_vert_mean();
 4853: 
 4854:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4855:       // Velocity magnitude at the bottom level
 4856:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4857:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4858:       side->chi2 = side->Cd()*vmag1;
 4859:       side->chi  = side->chi2;
 4860:       if constexpr(iveg != 0) {
 4861:          const Node *n1 = side->n1;
 4862:          const Node *n2 = side->n2;
 4863:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4864:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4865:       }
 4866: 
 4867:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4868: 
 4869:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4870:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4871:       double magUa = 0.0;
 4872:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4873:          // 3D wet side with veg...
 4874: 
 4875:          double magUa = 0.0;
 4876:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4877:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4878: 
 4879:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4880:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4881:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4882: 
 4883:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4884:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4885: 
 4886:                // Velocity magnitude at the bottom (l) of the level
 4887:                const double ul = length(side->u2[k]);
 4888: 
 4889:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4890:                magUa += Dz*0.5*(uh + ul);
 4891: 
 4892:             } // if HasVegetation
 4893:          } // for k
 4894:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4895: 
 4896:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4897:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4898:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4899:             const double zCpy = side->zTopCanopy();
 4900:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4901:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4902:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4903:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4904:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4905:          } // if isSubmerged
 4906:       } // if iveg   
 4907: 
 4908:       // Computes the friction modified depth, \breve{H} in notes
 4909:       if (side->is2D()) { // 2D
 4910: 
 4911:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4912:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4913: 
 4914:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4915: 
 4916:          side->hhat = htot*htot/fricH; 
 4917: 
 4918:       } else { // 3D
 4919:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4920: 
 4921:          if constexpr(iveg != 0) {
 4922:             
 4923:             if (side->isSubmerged()) { 
 4924:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4925:                side->hhat -= veg_c*Hhat_alpha;
 4926: 
 4927:             } else { // Emergent
 4928:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4929:             }
 4930:          } // if iveg
 4931: 
 4932:          // Enforce positivity for 3D model
 4933:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4934:       } // if 3D
 4935: 
 4936:    }
 4937: 
 4938: 
 4939: 
 4940:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4941:    // Computes the density gradient between two elements, e1 and e2.
 4942:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4943:    // zero in the direction normal to the side. 
 4944:    // 
 4945:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4946:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4947:    //
 4948:    // Input:
 4949:    //    e1: Element
 4950:    //    e2: Neighbor element (or nullptr if boundary)
 4951:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4952:    //    k: Index of the half-level at which the density is interpolated
 4953:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4954:    // 
 4955:    // Output:
 4956:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4957:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4958: 
 4959:       if (e2 == nullptr || e2->isDry) {
 4960:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4961: 
 4962:          Side *side = e1->sides[j];
 4963:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4964:                  
 4965:          if constexpr(ics == 1) {
 4966:             vec = side->n; // Normal vector to the side
 4967:          } else {
 4968:             // IMPLEMENT THIS XXXXXX
 4969:             // !replace with xel, yel?
 4970:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4971:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4972:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4973:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4974:          } //ics
 4975:                    
 4976:          diffRho = 0.0;
 4977: 
 4978:       } else { //internal and wet
 4979:          if constexpr(ics==1) {
 4980:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4981: 
 4982:             // Vector from e1 to e2
 4983:             vec = e2->center - e1->center;
 4984: 
 4985:          } else { 
 4986:             // IMPLEMENT THIS XXXXXX
 4987:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4988:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4989:             //                   alow(j)=xctr2
 4990:             //                   bdia(j)=yctr2
 4991:          } // ics
 4992: 
 4993:          diffRho = rho2 - e1->demeanedDensity(k);
 4994:       }
 4995: 
 4996:    }
 4997: 
 4998:    __global__ void computeDensityCubicSplines(void) {
 4999:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5000: 
 5001:       ELEM(elem);
 5002: 
 5003:       if (elem->isDry) return;
 5004: 
 5005:       const int kb = elem->kb;
 5006: 
 5007:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5008:       if (elem->is2D()) {
 5009:          // In the 2D case, the density is constant at the prism level. 
 5010:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5011:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5012:       } else { //3D
 5013: 
 5014:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5015:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5016:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5017:          ///// XXXX CHECK INDICES!!!!!
 5018:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5019:       } // 2D/3D
 5020: 
 5021:    }
 5022: } // extern "C"
 5023: 
 5024: 
 5025: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5026: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5027: 
 5028:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5029: 
 5030:    const int kb  = elem->kb;
 5031:    const int kb2 = elem2->kb;
 5032: 
 5033:    // z-coordinate of prism of elem
 5034:    const double zp = elem->z_prism(k);
 5035: 
 5036:    double rho = 0.0;
 5037: 
 5038:    if (elem2->is2D()) {
 5039:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5040: 
 5041:    } else {  // 3D
 5042: 
 5043:       // eta_min may be < zmax
 5044:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5045:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5046: 
 5047:       // (Extrapolate density below bottom, we will fix it later)
 5048:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5049:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5050:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5051:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5052:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5053:    } // 2D/3D
 5054:      
 5055: 
 5056:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5057:    // Now we need to fix it.
 5058:    if (elem->z[k] < elem2->z[kb2]) {
 5059:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5060: 
 5061:       // There are two methods to adjust the density at the bottom of the element.
 5062:       // iunder_deep=0: 
 5063:       const double depth1 = abs(elem->z[kb]); // larger depth
 5064: 
 5065:       if (iunder_deep==0) {
 5066: 
 5067:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5068: 
 5069:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5070: 
 5071:       } else { // iunder_deep != 0
 5072: 
 5073:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5074: 
 5075:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5076: 
 5077:          //   Demeaned density at the same z coordinate as
 5078:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5079:          }
 5080: 
 5081:       } // if iunder_deep
 5082:    } // if elem->z[kb] < elem2->z[kb]
 5083: 
 5084:    return rho;
 5085: }
 5086: 
 5087: 
 5088: extern "C" {
 5089:    __global__ void computeDensityGradient(void) {
 5090: 
 5091:       if constexpr(ibc != 0) return;
 5092: 
 5093:          // Compute the horizontal density gradient at each element.
 5094:       // It works in two steps:
 5095:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5096:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5097:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5098:       //             gradRho.r1 = rho1 - rho0
 5099:       //             gradRho.r2 = rho2 - rho0
 5100:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5101:       // 
 5102:       //  NOTE: We use de-meaned densities.
 5103: 
 5104:       ELEM(elem);
 5105: 
 5106:       if (elem->isDry) return;
 5107: 
 5108:       const int kb  = elem->kb;
 5109:       const int i34 = elem->i34;
 5110: 
 5111:       for (int k = kb + 1; k < nvrt; k++) {
 5112:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5113:          //             gradRho.r1 = rho1 - rho0
 5114:          //             gradRho.r2 = rho2 - rho0
 5115:          int icount = 0;
 5116:          double sumRx = 0.0;
 5117:          double sumRy = 0.0;
 5118:          for (int j1=0; j1<i34; j1++) { 
 5119: 
 5120:             const int j2 = elem->nxq(j1 + 1);
 5121: 
 5122:             // Pairs of consecutive neighbor elements of elem
 5123:             const Element *e1 = elem->nghbElems[j1];
 5124:             const Element *e2 = elem->nghbElems[j2];
 5125: 
 5126:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5127:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5128:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5129: 
 5130:             // Compute the density difference and the vector from elem to e1 and e2
 5131:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5132:             double diffRho1, diffRho2;
 5133:             Vector2 vec1, vec2;
 5134:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5135:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5136: 
 5137:             const double rl1 = length(vec1);
 5138:             const double rl2 = length(vec2);
 5139:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5140: 
 5141:             const double delta = cross(vec1, vec2);
 5142:             const double sintheta = abs(delta)/(rl1*rl2);
 5143: 
 5144:             // To avoid problems, avoid elements with small angle between vectors
 5145:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5146:             const bool validEq = (sintheta > sin_one_deg);
 5147: 
 5148:             if (validEq) {
 5149:                // Solve the system of equations to get the density gradient at elem
 5150:                icount++;
 5151:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5152:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5153:                sumRx += Rx;
 5154:                sumRy += Ry;
 5155:             }
 5156:          } // for j1
 5157: 
 5158:          // Compute the average density gradient at elem
 5159:          if (icount==0) {
 5160:            // Bad mesh quality; bail out with 0 b-cc
 5161:            elem->gradRho[k] = {0.0, 0.0};
 5162:          } else {
 5163:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5164:          }
 5165: 
 5166:       } // for k
 5167: 
 5168:    }
 5169: 
 5170:    __global__ void computeBaroclinicTerm(void) {
 5171:    // Computes the baroclinic term at sides (at half levels).
 5172:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5173:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5174: 
 5175:       if (ibc == 1) return;
 5176: 
 5177:       SIDE(side);
 5178: 
 5179:       if (side->isDry) return;
 5180: 
 5181:       const Element *e1 = side->elems[0];
 5182:       const Element *e2 = side->elems[1];      
 5183:       const int kb = side->kb;
 5184:       
 5185:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5186: 
 5187:       // interpolates vertically the density gradient of the two elements at the half level/
 5188: 
 5189:       int k1 = max(kb, nvrt / 2);
 5190:       int k2 = max(kb, nvrt / 2);
 5191: 
 5192:       // Starts the integration at the surface and goes down to the bottom
 5193:       side->bcc[nvrt-1] = {0.0, 0.0};
 5194:       for (int k = nvrt - 2; k >= kb; k--) {
 5195:       // For each prism level (from surface to bottom)...
 5196: 
 5197:          // For both elements, interpolate density gradient at the side's half level.
 5198:          // The gradient at the side is the average of the gradients at the elements.
 5199:          // w1, w2 are used to take into account boundary sides, with just one element.
 5200:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5201:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5202:          const double wsum = w1 + w2;
 5203:          w1 = w1/wsum;
 5204:          w2 = w2/wsum;
 5205:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5206: 
 5207:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5208:          Vector2 gradRho = {0.0, 0.0};
 5209:          if (e1 != nullptr && k > kb) {
 5210:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5211:             
 5212:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5213:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5214:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5215: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5216:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5217:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5218:          }      
 5219:          if (e2 != nullptr && k > kb) {
 5220:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5221:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5222:             
 5223:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5224:          }
 5225: 
 5226:          if constexpr(ics==2) {
 5227:             assert(false && "Not implemented: ics == 2");
 5228:             // IMPLEMENT THIS XXXXXX
 5229:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5230:             // swild(1)=tmp1
 5231:             // swild(2)=tmp2
 5232:          }
 5233:          
 5234:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5235:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5236:          // CHECK INDICES!!! XXX
 5237:          const double grav3 = side->grav3();
 5238:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5239: 
 5240:       } // for
 5241: 
 5242:    }
 5243: 
 5244: 
 5245: 
 5246:    __global__ void computeHorGradientAtSide(void) {
 5247: 
 5248:       // Compute the horizontal density gradient at each element.
 5249:       // It works in two steps:
 5250:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5251:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5252:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5253:       //             gradRho.r1 = rho1 - rho0
 5254:       //             gradRho.r2 = rho2 - rho0
 5255:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5256:       // 
 5257:       //  NOTE: We use de-meaned densities.
 5258: 
 5259:       SIDE(side);
 5260: 
 5261: // printf("side->isDry: %d\n", side->isDry);
 5262:       if (side->isDry) return;
 5263: 
 5264:       // Computes the gradient of the variables at the side center.
 5265:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5266:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5267:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5268: 
 5269:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5270:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5271:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5272:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5273: 
 5274: 
 5275:    }
 5276: 
 5277: 
 5278:    __global__ void solveMomentumEquations(double time) {
 5279: 
 5280:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5281:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5282: 
 5283:       SIDE(side);
 5284: 
 5285:       if (side->isDry) 
 5286:       {
 5287:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5288: 
 5289:          return;
 5290:       }
 5291: 
 5292:       const Node *n1 = side->n1;
 5293:       const Node *n2 = side->n2;
 5294: 
 5295:       const int kb = side->kb;
 5296: 
 5297:       const double veg_h = side->veg_h();
 5298:       const double grav3 = side->grav3();
 5299: 
 5300:       if (side->is2D()) {
 5301:          // Warning: Do not use htot2, which is updated.
 5302:          const double htot = side->htot1();
 5303:          const double hhat = side->hhat;
 5304: 
 5305:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5306: 
 5307:          Vector2 tau2 = {0.0, 0.0};
 5308:           
 5309:          if constexpr(ics==1) {
 5310:             tau2 = side->tau();
 5311: 
 5312:          } else {
 5313:             assert(false && "Not implemented: ics == 2");
 5314:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5315:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5316:             // taux2=(vn1+tt1)*0.5d0
 5317:             // tauy2=(vn2+ss1)*0.5d0
 5318:          } // if ics         
 5319: 
 5320:          // hat_gam has units of m/s
 5321: 
 5322:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5323: 
 5324:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5325:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5326: 
 5327:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5328: 
 5329: 
 5330:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5331:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5332: 
 5333:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5334: 
 5335:       }
 5336:       else { // 3D
 5337: 
 5338:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5339:          // 
 5340:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5341:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5342:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5343:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5344:          // k+1 and k.
 5345: 
 5346: 
 5347:          const int ndim = nvrt - kb;
 5348:          const double zTopCanopy = side->zTopCanopy();
 5349: 
 5350:          // Initialize the tridiagonal system
 5351:          for (int k = kb + 1; k < nvrt; k++) {
 5352:             
 5353:             const int kin = k - (kb + 1);
 5354: 
 5355:             // Vertical viscosity at the face center
 5356:             const double dfz =  0.01; //0.5*(side->dfv(k - 1) + side->dfv(k)); ///XXXXX KKKKK
 5357:  
 5358:             alow[kin] = 0.0;
 5359:             cupp[kin] = 0.0;
 5360:             bdia[kin] = 0.0;
 5361: 
 5362:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5363:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5364: 
 5365:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5366:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5367:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5368: 
 5369:             // First part: layers k, k+1
 5370:             if (k < nvrt - 1) {
 5371:                              
 5372:                if constexpr(iveg != 0) {
 5373: 
 5374:                   // If there is vegetation at this level...
 5375:                   if (zTopCanopy > side->zc[k]) {
 5376:                      // If the canopy is above the k layer...
 5377:                      
 5378:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5379:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5380:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5381:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5382: 
 5383:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5384:                      const double vmag2 = length(ut2);
 5385:                      const double vmag1 = length(side->u2[k]);
 5386:                      const double vmag = 0.5*(vmag1 + vmag2);
 5387:                      
 5388:                      // Computes the vegetation alpha at the face center
 5389:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5390: 
 5391:                      cff1 += veg_alpha_sd*dt*vmag;
 5392: 
 5393:                   } // if (zTopCanopy
 5394:                } // if iveg
 5395: 
 5396:                const double dzz = side->Dz(k + 1);
 5397:                const double tmp = dt*dfz/dzz;
 5398:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5399: 
 5400:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5401:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5402:             }
 5403: 
 5404: 
 5405:             // Second part: layers k-1, k
 5406:             if (k > kb + 1) {
 5407: 
 5408:                double cff1 = 1.0; //init \bar{c^k}
 5409: 
 5410:                if constexpr(iveg != 0) {
 5411:                   // If there is vegetation at this level...
 5412:                   if (zTopCanopy > side->zc[k-1]) {
 5413:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5414:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5415: 
 5416:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5417: 
 5418:                      const double vmag2 = length(ut2);
 5419:                      const double vmag1 = length(side->u2[k-1]);
 5420:                      const double vmag = 0.5*(vmag1 + vmag2);
 5421: 
 5422:                      // Computes the vegetation alpha at the face center
 5423:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5424:                      cff1 += veg_alpha_sd*dt*vmag;
 5425:                   } // if zTopCanopy
 5426: 
 5427:                } // if iveg
 5428: 
 5429:                const double dzz = side->Dz(k);
 5430:                const double tmp = dt*dfz/dzz;
 5431:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5432: 
 5433:                alow[kin] += cff1*dzz/6.0 - tmp;
 5434:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5435: 
 5436:             } else { // Bottom boundary
 5437:                // This occurs at the bottom, where the bottom drag is applied.
 5438: 
 5439:                bdia[kin] += dt*side->chi2; // XXXX
 5440: 
 5441:             } // if (k > kb + 1)
 5442: 
 5443: 
 5444:          } // for (int k
 5445: 
 5446: 
 5447: 
 5448:          // Computes the RHS.
 5449:          // -----------------
 5450: 
 5451:          //	BC to be imposed at the end.
 5452: 
 5453:          const Vector2 gradETP  = side->gradETP;
 5454:          const Vector2 gradPr   = side->gradPr;
 5455:          const Vector2 gradEta1 = side->gradEta1;
 5456:          const Vector2 gradEta2 = side->gradEta2;
 5457: 
 5458:          const Vector2 *btu = side->btu;
 5459:          const Vector2 *u2  = side->u2;
 5460:          const double coriolis = side->coriolis;
 5461:          const Vector2 *nuGradU = side->nuGradU;
 5462: 
 5463: 
 5464:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5465: 
 5466:          for (int k = kb + 1; k < nvrt; k++) {
 5467:             const int kin = k - kb - 1;
 5468: 
 5469:             const double dz_0 = side->Dz(k);
 5470:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5471: 
 5472:             rrhs[kin] = {0.0, 0.0};
 5473:             double dz = 0.0;
 5474: 
 5475:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5476:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5477:             if (k < nvrt  ) dz += dz_1;
 5478:             if (k > kb + 1) dz += dz_0;
 5479: 
 5480:             // Elevation gradient, atmospheric pressure and tidal potential
 5481:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5482: 
 5483:             // Coriolis, advection, wind stress, and horizontal viscosity
 5484:             if (k < nvrt - 1) {
 5485: 
 5486: 
 5487:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5488:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5489:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5490:                                                 
 5491: 
 5492:                //diff stress tensors 1006
 5493:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5494:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5495:                   assert(false && "Not implemented: itur == 5");
 5496:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5497:                }
 5498:                // else assert(false && "itur # Not implemented");
 5499: 
 5500:             } else { // k == nvrt - 1 SURFACE
 5501:                Vector2 tau2 = {0.0, 0.0};
 5502:                if constexpr(ics==1) {
 5503:                   tau2 = side->tau();
 5504:       
 5505:                } else {
 5506:                   assert(false && "Not implemented: ics == 2");
 5507:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5508:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5509:                   // taux2=(vn1+tt1)*0.5d0
 5510:                   // tauy2=(vn2+ss1)*0.5d0
 5511:                } // if ics
 5512: 
 5513:                rrhs[kin] += dt*tau2;
 5514: 
 5515:             } // if k<nvrt
 5516: 
 5517:             if (k > kb + 1) {
 5518:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5519:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5520:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5521: 
 5522:                // diff stress tensors 1006
 5523:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5524:                   assert(false && "Not implemented: itur == 5");
 5525:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5526:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5527:                }
 5528:                // else assert(false && "itur # Not implemented");
 5529: 
 5530: 
 5531:             } // if k>kbs + 1
 5532: 
 5533:             // Baroclinic
 5534:             Vector2 *bcc = side->bcc;
 5535:             if constexpr(ibc == 0) {
 5536:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5537:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5538: 
 5539:             } // if ibc==0
 5540: 
 5541:          } // k=kb + 1,nvrt
 5542: 
 5543: 
 5544:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5545: 
 5546:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5547:             const int kin = k - kb - 1;
 5548:    
 5549:             // Velocity is always clamped to maximum values
 5550:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5551:          } // k
 5552: 
 5553:       } // if side->is2D()
 5554:       
 5555: 
 5556:       // Impose velocity boundary condition at the bottom
 5557:       if constexpr(imm == 2) { // 3D bed deformation model
 5558:          double dep;
 5559:          Vector2 vel;
 5560: 
 5561:          assert(false && "Not implemented: imm == 2");
 5562:          //update_bdef(time, x0, y0, dep, vel);
 5563:          // side->u2[kb] = vel;
 5564: 
 5565:       } else { // imm = 0 or 1
 5566:          if (side->Cd() == 0.0) {
 5567:             side->u2[kb] = side->u2[kb + 1];
 5568: 
 5569:          } else if (side->is3D()) { // 3D no slip bottom   
 5570:             side->u2[kb] = {0.0, 0.0};
 5571:          }
 5572:           
 5573:       } // if imm
 5574: 
 5575:       // The velocities below the bottom level are set to zero
 5576:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5577: 
 5578: 
 5579:    }
 5580: 
 5581: 
 5582:    __global__ void applyMomentumBC(void) {
 5583: 
 5584:       SIDE_BND(sideBnd);
 5585: 
 5586:       Side *side = sideBnd->side;
 5587:       const BoundarySegment *segment = sideBnd->segment;
 5588:       const Node *n1 = side->n1;
 5589:       const Node *n2 = side->n2;
 5590: 
 5591:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5592: 
 5593:       const bool isLand = segment->isLand;
 5594:       const int ifltype = segment->ifltype;
 5595: 
 5596:       const int kb = side->kb;
 5597: 
 5598:       if (!isLand && ifltype != 0) {
 5599:          const Vector2 *ubc = sideBnd->ubc;
 5600:   
 5601:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5602:             
 5603:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5604:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5605: 
 5606:             if (ifltype == -1) {
 5607:                // Flather 1
 5608: 
 5609:                const double depth = side->depth();
 5610: 
 5611:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5612: 
 5613:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5614: 
 5615:                side->u2[k] = vnorm*side->n;
 5616: 
 5617:             } else if (ifltype == -2) { // Discharge
 5618: 
 5619:                const double eta1 = side->eta1();
 5620:                const double eta2 = side->eta2();
 5621:                const double htot = side->htot2();
 5622: 
 5623:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5624:                assert(false && "Not implemented: Discharge bc");
 5625:                // const double dischrg = discharge(eta1);
 5626:                const double dischrg = 0.0; // XXX REMOVE
 5627:                
 5628: 
 5629:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5630: 
 5631:                const double vnorm = dischrg*eta2/htot;
 5632: 
 5633:                side->u2[k] = vnorm*side->n;
 5634: 
 5635:             }
 5636:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5637:                const double vnorm = dot(side->u2[k], side->n);
 5638: 
 5639:                double rat;
 5640:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5641:                else              rat = segment->vobc2; // outgoing
 5642: 
 5643:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5644: 
 5645:             }
 5646:             else { // not Flather or 3D radiation
 5647: printf("ifltype = %d\n", ifltype);
 5648:                side->u2[k] = ubc[k];
 5649: 
 5650:             } // if (segment->ifltype...
 5651: 
 5652:          }
 5653: 
 5654:       }
 5655:       else if (isLand) { // if it is land boundary side
 5656: 
 5657:          if constexpr(islip == 0) { // free slip
 5658: 
 5659:             for (int k = kb; k < nvrt; k++) {
 5660: 
 5661:                const Vector2 t = side->t();
 5662:                const Vector2 n = side->n;
 5663: 
 5664:                double vnorm = 0.0; // for most cases
 5665:                const double vtan = dot(side->u2[k], t);
 5666:                
 5667:                side->u2[k] = vtan*t - vnorm*n;
 5668: 
 5669:             }
 5670: 
 5671:          } else { // no slip
 5672:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5673: 
 5674:          }
 5675:       } // if (side segment type...
 5676: 
 5677:    
 5678: 
 5679:    }
 5680: 
 5681: 
 5682:    __global__ void shapiroFilter1(void) {
 5683:       // First step of the Shapiro filter (normally used if indvel<=0)
 5684:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5685: 
 5686:       SIDE(side);
 5687: 
 5688:       // Only internal wet sides are processed
 5689:       if (side->isDry || !(side->isInternal())) return;
 5690: 
 5691:       const int kb = side->kb;
 5692: 
 5693:       for (int mm = 0; mm < niter_shap; mm++) {
 5694: 
 5695:          for (int k = kb + 1; k < nvrt; k++) {
 5696:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5697:             Vector2 suru = {0.0, 0.0};
 5698: 
 5699:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5700: 
 5701:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5702: 
 5703:                int kin = k;
 5704:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5705:                
 5706:                if constexpr(ics==1) {
 5707:                   suru += nSide->u2[kin];
 5708: 
 5709:                } else {
 5710:                   assert(false && "Not implemented: ics == 2");
 5711:                   // Vector2 vn1, vn2;
 5712:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5713:                   // suru=suru+vn1;
 5714:                   // surv=surv+vn2;
 5715:                }
 5716:             }
 5717: 
 5718:             // Reusing bcc as a temporary array to store the suru values.
 5719:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5720: 
 5721:          }
 5722:       }
 5723:    }
 5724: 
 5725:    __global__ void shapiroFilter2(void) {
 5726:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5727: 
 5728:       SIDE(side);
 5729: 
 5730:       if (side->isDry || !(side->isInternal())) return;
 5731: 
 5732:       const int kb = side->kb;
 5733: 
 5734:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5735: 
 5736:       if (side->is2D()) {
 5737:          side->u2[kb + 1] = side->bcc[kb + 1];
 5738:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5739: 
 5740:       } else {
 5741:          // 3D
 5742:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5743:          
 5744:       }
 5745: 
 5746:    }
 5747: 
 5748: 
 5749:    __global__ void ul0UpdateZCoords(void) {
 5750:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5751:       
 5752:       NODE(node);      
 5753: 
 5754: 
 5755:       if (node->isDry2()) { 
 5756: 
 5757:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5758: 
 5759:          if constexpr(ivcor != 1) node->kb = 0;
 5760: 
 5761:       } else {
 5762: 
 5763:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5764:          node->updateKb();
 5765: 
 5766:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5767: 
 5768:       }
 5769: 
 5770:       // We use the temp.b field to store the previous state of isDry.
 5771:       node->tmp.b = node->isDry;
 5772: 
 5773:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5774:       node->isDry = true;
 5775: 
 5776:    }
 5777: 
 5778:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5779:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5780:    {
 5781:       ELEM(elem);
 5782: 
 5783:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5784: 
 5785:       Node *n1 = elem->nodes[0];
 5786:       Node *n2 = elem->nodes[1];
 5787:       Node *n3 = elem->nodes[2];  
 5788:       Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5789: 
 5790:       // All the nodes of a dry element are wet.
 5791:       if (!elem->isDry) {
 5792:          n1->isDry = false;
 5793:          n2->isDry = false;
 5794:          n3->isDry = false;
 5795:          if (elem->isQuad()) n4->isDry = false;
 5796: 
 5797: 
 5798:       }
 5799: 
 5800:       elem->kb = 0;
 5801: 
 5802:       if (elem->isDry) return;
 5803: 
 5804: 
 5805: 
 5806:    //    if(elem->isDry2()) { // XXXX
 5807:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5808:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5809:    //        call parallel_abort(errmsg)
 5810:    //    }
 5811: 
 5812: 
 5813:       // Computes element's kb as the minimum of the nodes' kb.
 5814:       const int kb1 = n1->kb;
 5815:       const int kb2 = n2->kb;
 5816:       const int kb3 = n3->kb;
 5817:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5818: 
 5819: 
 5820:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5821: 
 5822: 
 5823:       // Computes the element z as the mean of the nodes z.
 5824:       for (int k = elem->kb; k < nvrt; k++) {
 5825: 
 5826:          // Compute the element z as the mean of the nodes z.
 5827:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5828:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5829:          elem->z[k] /= elem->i34;
 5830: 
 5831:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5832:       }
 5833:                   
 5834:    }
 5835: 
 5836:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5837:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5838:    // node->tmp.b is true if the node was previously dry.
 5839:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5840:    {
 5841:       NODE(node);
 5842:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5843: 
 5844:       // Avoid this the first time step.
 5845:       if (it == iths) return;  
 5846: 
 5847:       
 5848:       // assert(node->isDry == node->isDry2() && "These two must be identical at this point"); XXXXX 
 5849:       if ((!node->isDry) && node->tmp.b) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5850: 
 5851:          for (int k=0; k < nvrt; k++) {
 5852: 
 5853:             Vector3 utmp={0.0, 0.0, 0.0};
 5854: 
 5855:             double ttmp=0.0;
 5856:             double stmp=0.0;
 5857:             int icount=0;
 5858:             for (int j = 0; j < node->numNodes; j++) {
 5859: 
 5860:                const Node *nbrNode = node->nodes[j];
 5861: 
 5862:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5863:                if (!nbrNode->tmp.b) { // Previously wet surrounding nodes
 5864: 
 5865:                   icount++;
 5866: 
 5867:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5868:                   utmp += nbrNode->uvw2(k);
 5869:                   
 5870:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5871:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5872:                }
 5873:             }
 5874: 
 5875:             if (icount > 0) {
 5876:                const double inv_icount = 1.0/icount;
 5877:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5878:                node->w2[k]     = inv_icount*utmp.z;
 5879:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5880:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5881:             }
 5882:             else {
 5883:                node->u2[k] = {0.0, 0.0};
 5884:                node->w2[k] = 0.0;
 5885:             }
 5886:          }
 5887:       }
 5888:    }
 5889: 
 5890:   
 5891:    
 5892: 
 5893: 
 5894:    __global__ void ul0UpdateSides(int it, int iths) {
 5895:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5896: 
 5897:       SIDE(side);
 5898: 
 5899:       // A side is wet if and only if at least one of its elements is wet.
 5900:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5901:  
 5902:       const Node *n1 = side->n1;
 5903:       const Node *n2 = side->n2;
 5904:      
 5905:       const int kb1 = n1->kb;
 5906:       const int kb2 = n2->kb;
 5907: 
 5908:       side->kb = 0; // dry
 5909: 
 5910:       if (isWet) {
 5911: 
 5912:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5913: 
 5914:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5915: 
 5916:          side->kb = min(kb1, kb2);
 5917: 
 5918:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5919: 
 5920:          for (int k = side->kb; k < nvrt; k++) {
 5921:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5922: 
 5923:          
 5924:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5925: 
 5926:             // Compute velocity for re-wetted sides 
 5927:             if ((it != iths) && (side->isDry && isWet)) {
 5928: 
 5929:                Vector2 utmp={0.0, 0.0};
 5930: 
 5931:                int icount=0;
 5932: 
 5933:                // For all the sides on the two elements that share this side
 5934:                for (int j = 0; j < 2; j++) {
 5935:                   const Element *elem = side->elems[j];
 5936:                   if (elem == nullptr) continue;
 5937: 
 5938:                   for (int jj=0; jj < elem->i34; jj++) {
 5939:                      const Side *nSide = elem->sides[jj];
 5940:                      if (nSide->isDry) continue;
 5941: 
 5942:                      icount++;
 5943:                      utmp += nSide->u2[k];  
 5944:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5945:                   }
 5946:                }
 5947:                   
 5948:                // assert(icount > 0 && "No wet sides around this side");  XXXXX RECOVER??? 
 5949:                if (icount > 0)  side->u2[k] = utmp/icount;
 5950:                else             side->u2[k] = {0.0, 0.0};
 5951:                   
 5952:             } // if ((it != iths) && (side->isDry && isWet))
 5953: 
 5954:          } // for k
 5955: 
 5956:       } // if isWet
 5957:    
 5958: 
 5959: 
 5960:    }
 5961: 
 5962:    __global__ void ul0UpdateSides2(void) {
 5963:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5964:    
 5965:          SIDE(side);
 5966:    
 5967:          // A side is wet if and only if at least one of its elements is wet.
 5968:          const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5969: 
 5970:          // Update the side's dryness
 5971:          side->isDry = !isWet;
 5972: 
 5973:    }
 5974: 
 5975: 
 5976:    __global__ void zeroNodalVelocities(void) {
 5977:       NODE(node);
 5978: 
 5979:       for (int k = 0; k < nvrt; k++) {
 5980:          node->u2[k]   = {0.0, 0.0};
 5981:          node->w2[k]   = 0.0;
 5982:          node->utmp[k] = {0.0, 0.0};
 5983:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5984:       }
 5985:    }
 5986: 
 5987:  
 5988: 
 5989:    __global__ void computeNodalVerticalVelocities1(void) {
 5990:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5991:    // Adds the element's vertical velocity times the element's area.
 5992:       ELEM(elem);
 5993: 
 5994:       for (int j = 0; j < elem->i34; j++) {
 5995:          Node *node = elem->nodes[j];
 5996: 
 5997:          for (int k = node->kb; k < nvrt; k++) {
 5998:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5999:          }
 6000:          atomicAdd(&(node->tmp.d), elem->area);
 6001:       }
 6002:    }
 6003: 
 6004:    __global__ void computeNodalVerticalVelocities2(void) {
 6005:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6006:    // Divides by the total area of the elements sharing the    node.
 6007:       NODE(node);
 6008: 
 6009:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6010: 
 6011:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6012:    }
 6013: 
 6014: 
 6015:    __global__ void computeNodalHorizontalVelocities1(void) {
 6016:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6017:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6018: 
 6019:       ELEM(elem);
 6020: 
 6021:       if (elem->isDry) return;
 6022: 
 6023:       const int kb = elem->kb;
 6024:       const bool isTri = elem->isTri();
 6025: 
 6026:       if constexpr(indvel <= 0) {
 6027:          // Assuming discontinous hvel.
 6028: 
 6029:          if (isTri) { // For triangles
 6030:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6031:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6032: 
 6033:             for (int j = 0; j < 3; j++) {
 6034:                // For every node of the triangle...
 6035:                Node *node = elem->nodes[j];
 6036: 
 6037:                if (node->isDry) continue;
 6038: 
 6039:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6040:                const Side *s2 = elem->sides[(j + 1) % 3];
 6041:                const Side *s3 = elem->sides[(j + 2) % 3];
 6042: 
 6043: 
 6044:                atomicAdd(&(node->tmp.i), 1);
 6045: 
 6046:                for (int k = kb; k < nvrt; k++)  {
 6047:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at node j.   XXXX Function for clamping velocities. const vector2 u
 6048:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6049:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6050:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6051:                   atomicAdd(&(node->utmp[k].x), u.x);
 6052:                   atomicAdd(&(node->utmp[k].y), u.y);
 6053: 
 6054:                }
 6055: 
 6056:             }
 6057:          }
 6058:          else { // For quads
 6059:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6060: 
 6061:          }
 6062: 
 6063:       }
 6064:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6065:       
 6066:    }
 6067: 
 6068: 
 6069:    __global__ void computeNodalHorizontalVelocities2(void) {
 6070:       NODE(node);
 6071: 
 6072:       const int nodeCount = node->tmp.i;
 6073: 
 6074:       if (nodeCount == 0) 
 6075:       {
 6076:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6077:          return;
 6078:       }
 6079: 
 6080:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6081:       
 6082:       const int kb = node->kb;
 6083: 
 6084:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6085:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6086:       
 6087:       
 6088:    }   
 6089: 
 6090:  
 6091: 
 6092:    __global__ void resetVelocityOpenBndNodes(void) {
 6093:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6094: 
 6095:       NODE_BND(nodebnd);
 6096: 
 6097:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6098:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6099:       }
 6100: 
 6101:    }
 6102: 
 6103: 
 6104:    __global__ void setVelocityOpenBndNodes(void) {
 6105:    // For open boundary nodes sets their velocity to the imposed values.
 6106: 
 6107:       SIDE_BND(sidebnd);
 6108: 
 6109:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6110:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6111:          // to its segment to the average of the side velocity.
 6112: 
 6113:          for (int k = 0; k < nvrt; k++) {
 6114:             Node *n1 = sidebnd->side->n1;
 6115:             Node *n2 = sidebnd->side->n2;
 6116: 
 6117: 
 6118:             Vector2 n1_u2(n1->u2[k]);
 6119:             Vector2 n2_u2(n2->u2[k]);
 6120: 
 6121:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6122:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6123:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6124:             }
 6125:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6126:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6127:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6128:             }
 6129: 
 6130:          }
 6131: 
 6132:       }
 6133: 
 6134:    }
 6135: 
 6136: 
 6137:    __global__ void computeVerticalVelocity(void) {
 6138:       // Computes the vertical velocity at the (2D) element's centroid.
 6139:       // In this function we will be considering volumetric elements, with side faces and a 
 6140:       // bottom and a top face. We will call them SFs, BF and TF.
 6141:       // It computes the flux coming from BF and the SFs.
 6142:       // If the bed is moving, it takes that into account.
 6143:       // Since water is incompressible, the integral of the velocity times the normal vector
 6144:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6145:       // and the BF is equal to the flux going out from the TF.
 6146:       // TF = - BF - sum(SFs).
 6147:       // It then computes the horizontal velocity at the center of TF.
 6148:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6149:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6150:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6151: 
 6152:       ELEM(elem);
 6153: 
 6154:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6155: 
 6156:       if (elem->isDry) return;
 6157: 
 6158:       const int kb = elem->kb;
 6159:       const bool isTri = elem->isTri();
 6160: 
 6161:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6162: 
 6163:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6164:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6165:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6166: 
 6167:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6168: 
 6169:       double area3D;
 6170: 
 6171:       // Bottom face flux
 6172:       double bottomFlux = 0.0;
 6173:       Vector2 u2meanBottom = {0.0, 0.0};
 6174:       const Vector2 gradh = elem->grad2(&Node::depth);
 6175:       if constexpr(imm==2) {
 6176:          Vector3 ubed;
 6177: 
 6178:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6179:          // updateBDEF(ubed);
 6180:      
 6181:          // const double bflux0 = dot(ubed, elem_n1);
 6182: 
 6183:          // elem->w[kb] += ubed.z;
 6184:       }
 6185:       else {
 6186:          Vector2 umean;
 6187:          if constexpr(ics == 1) {
 6188:             u2meanBottom = elem->mean(kb, &Side::u2);
 6189:          }
 6190:          else {
 6191:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6192:          }
 6193: 
 6194:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6195:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6196: 
 6197:          bottomFlux = - dot(gradh, u2meanBottom);
 6198:       } // if imm
 6199: 
 6200:       // Compute w for kb+1 to nvrt-1
 6201:       for (int l = kb; l < nvrt - 1; l++) {
 6202: 
 6203:          // normal vector to the top face of the "volumetric" element (3D)
 6204:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6205: 
 6206:          // Compute the total flux at the sides
 6207:          double sideFlux = 0.0;
 6208: 
 6209:          for (int j = 0; j < elem->i34; j++) {
 6210:             const Side *side = elem->sides[j];
 6211: 
 6212:             const double sideArea = side->area(l);
 6213:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6214:             const double sign = elem->ssign[j]; 
 6215: 
 6216:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6217:          }
 6218:          
 6219:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6220:          //velocities at the centers of the sides
 6221:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6222: 
 6223:          // The flx at the top ace can be computed from the other flows.
 6224:          const double topFlux = - sideFlux - bottomFlux;
 6225:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6226: 
 6227:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6228: 
 6229:          elem_n1 = elem_n2;
 6230: 
 6231:          bottomFlux = - topFlux;
 6232:       }
 6233:    }  
 6234: 
 6235: 
 6236: 
 6237: 
 6238: 
