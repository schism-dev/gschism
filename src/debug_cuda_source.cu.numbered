 7593: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7594:    // Get the value of a variable from an element
 7595:    // varName is the name of the variable to get
 7596:    // var is the array to store the value
 7597:    // k is the vertical level index of the variable to get
 7598: 
 7599:    ELEM(elem);
 7600:    
 7601:    int idx = elem->idx;
 7602:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7603: 
 7604:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7605:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7606:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7607:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7608:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7609:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7610:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7611:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7612:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7613:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7614:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7615:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7616:       
 7617:    
 7618: }
 7619: 
 7620: 
 7621: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7622:    // Get the value of a variable from an node
 7623:    // varName is the name of the variable to get
 7624:    // var is the array to store the value
 7625:    // k is the vertical level index of the variable to get
 7626: 
 7627:    NODE(node);
 7628:    
 7629:    int idx = node->idx;
 7630:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7631: 
 7632:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7633:    
 7634:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7635:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7636:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7637:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7638:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7639:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7640:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7641:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7642:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7643:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7644:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7645:    
 7646:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7647:       
 7648:    
 7649: }
 7650: 
 7651: 
 7652: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7653:    // Get the value of a variable from an side
 7654:    // varName is the name of the variable to get
 7655:    // var is the array to store the value
 7656:    // k is the vertical level index of the variable to get
 7657:    SIDE(side);
 7658:    
 7659:    int idx = side->idx;
 7660:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7661: 
 7662:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7663:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7664:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7665:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7666:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7667:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7668:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7669:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7670:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7671:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7672:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7673:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7674:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7675:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7676:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7677:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7678:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7679:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7680:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7681:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7682:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7683:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7684:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7685:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7686:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7687:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7688:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7689:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7690:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7691:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7692:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7693:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7694:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7695:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7696:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7697:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7698:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7699: }
 7700: 
 7701: 
 7702: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7703:    // Get the value of a variable from an side
 7704:    // varName is the name of the variable to get
 7705:    // var is the array to store the value
 7706:    // k is the vertical level index of the variable to get
 7707:    SIDE_BND(sideBnd);   
 7708: 
 7709:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7710:    if (sideBnd->segment->isLand) idx = -7;
 7711: 
 7712:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7713:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7714: 
 7715: }
