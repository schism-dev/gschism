 5455:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5456: 
 5457:       SIDE(side);
 5458: 
 5459:       side->U = {0.0, 0.0}; 
 5460:          
 5461:       if(side->isDry) return;
 5462: 
 5463:       // Vertically integrated velocity U
 5464:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5465:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5466:          side->U += side->Dz(k + 1)*uc;  
 5467:       }
 5468: 
 5469:    }
 5470: 
 5471:    __global__ void computeBottomDragVegetation(void) {
 5472:       // UNFINISHED. CHECK THIS:
 5473:       // How many kernels are needed? Why so many for loops?
 5474:       // Is the loop on sides needed?
 5475: 
 5476:       NODE(node);
 5477: 
 5478: 
 5479:       const int    kb      = node->kb;
 5480:       const double htot    = node->htot2(); 
 5481:       
 5482:       if (node->isDry) {
 5483:          // Default values for dry nodes
 5484:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5485:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5486: 
 5487:          return;
 5488:        
 5489:       }
 5490: 
 5491:       // Computes bottom drag Cd based on the selected nchi
 5492:       node->computeBottomDragCd();
 5493:       
 5494: 
 5495: 
 5496:       //   Bottom stress in m^2/s^2
 5497:       if (node->rho[kb + 1] >= -98.0)
 5498:       {
 5499:          const double mag_u = length(node->u2[kb + 1]);
 5500:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5501: 
 5502:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5503:          // !sediment erosion: this part needs more documentation
 5504:       }
 5505:     
 5506: 
 5507: 
 5508:       // Compute vegetation parameters
 5509:       //--------------------------------
 5510: 
 5511:       // SAV constants
 5512:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5513:       constexpr double veg_cfpsi = 0.16;
 5514: 
 5515:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5516:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5517: 
 5518:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5519:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5520:          int kbin = 0; // bin index
 5521:          for (int k = kb; k < nvrt; k++) {
 5522:             // Computes node height above the bottom level
 5523:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5524:             assert(false && "Vertical variation of vegetation not implemented");
 5525: 
 5526:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5527:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5528:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5529:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5530:             // } else {
 5531:             //    // Find the bin at which the current vertical level is
 5532:             //    while (kbin<nbins_veg_vert) {
 5533:             //       const double zn = node->z[kbin];
 5534:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5535:             //          break;
 5536:             //       } // if
 5537:             //       kbin++;
 5538:             //    } // while
 5539:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5540: 
 5541:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5542:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5543:                
 5544:             //    // Linear interpolation of the vegetation parameters
 5545:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5546:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5547:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5548:             // } // if rl10
 5549: 
 5550:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5551: 
 5552:          } // for k
 5553: 
 5554: 
 5555:       } else { // Ganthy (iveg==2)
 5556:       //  Modify canopy height, diameter, and density
 5557: 
 5558:          // Make sure there is vegetation on this node
 5559:          if (node->veg_h_unbent > 0.0) {
 5560:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5561: 
 5562:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5563:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5564:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5565: 
 5566:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5567:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5568:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5569:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5570:          } // if veg_h_unbent
 5571: 
 5572:          for (int k = 0; k < nvrt; k++) {
 5573:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5574:          } // for k
 5575:       
 5576: 
 5577:       } // if iveg
 5578:      
 5579: 
 5580:       // Compute vertical mean of veg_alpha3D
 5581:       if (iveg != 0) {
 5582:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5583:          double sum1=0.0;
 5584:          double sum2=0.0;
 5585:          // Integrate over each level under the canopy...
 5586:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5587:             const double Dz = node->Dz(k);
 5588: 
 5589:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5590:             sum2 += Dz;
 5591: 
 5592:          } // for k
 5593:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5594:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5595: 
 5596:       } // if iveg
 5597: 
 5598:    }
 5599: 
 5600:    __global__ void computeVegetationAndDragParameters(void) {
 5601:       // Computes the vegetation and drag model parameters:
 5602:       // chi, \tilde\chi, beta, \breve{H}
 5603:       
 5604:       SIDE(side);
 5605: 
 5606:       side->hhat = 0.0;
 5607:       side->chi2 = 0.0;
 5608:       side->chi = 0.0;
 5609:       side->veg_c2 = 0.0;
 5610:       side->veg_beta = 0.0;
 5611: 
 5612:       if (side->isDry) return;
 5613: 
 5614:       const double htot = side->htot2();
 5615:       const int    kb   = side->kb;
 5616: 
 5617:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5618: 
 5619:       const double veg_h     = side->veg_h();
 5620:       const double veg_nv    = side->veg_nv();
 5621:       const double veg_c     = side->veg_c();
 5622:       const double veg_beta  = side->veg_beta;
 5623:       const double veg_alpha = side->veg_alpha_vert_mean();
 5624: 
 5625:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5626:       // Velocity magnitude at the bottom level
 5627:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5628:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5629:       side->chi2 = side->Cd()*vmag1;
 5630:       side->chi  = side->chi2;
 5631:       if constexpr(iveg != 0) {
 5632:          const Node *n1 = side->n1;
 5633:          const Node *n2 = side->n2;
 5634:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5635:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5636:       }
 5637: 
 5638:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5639: 
 5640:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5641:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5642:       double magUa = 0.0;
 5643:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5644:          // 3D wet side with veg...
 5645: 
 5646:          double magUa = 0.0;
 5647:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5648:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5649: 
 5650:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5651:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5652:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5653: 
 5654:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5655:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5656: 
 5657:                // Velocity magnitude at the bottom (l) of the level
 5658:                const double ul = length(side->u2[k]);
 5659: 
 5660:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5661:                magUa += Dz*0.5*(uh + ul);
 5662: 
 5663:             } // if HasVegetation
 5664:          } // for k
 5665:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5666: 
 5667:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5668:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5669:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5670:             const double zCpy = side->zTopCanopy();
 5671:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5672:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5673:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5674:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5675:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5676:          } // if isSubmerged
 5677:       } // if iveg   
 5678: 
 5679:       // Computes the friction modified depth, \breve{H} in notes
 5680:       if (side->is2D()) { // 2D
 5681: 
 5682:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5683:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5684: 
 5685:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5686: 
 5687:          side->hhat = htot*htot/fricH; 
 5688: 
 5689:       } else { // 3D
 5690:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5691: 
 5692:          if constexpr(iveg != 0) {
 5693:             
 5694:             if (side->isSubmerged()) { 
 5695:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5696:                side->hhat -= veg_c*Hhat_alpha;
 5697: 
 5698:             } else { // Emergent
 5699:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5700:             }
 5701:          } // if iveg
 5702: 
 5703:          // Enforce positivity for 3D model
 5704:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5705:       } // if 3D
 5706: 
 5707:    }
 5708: 
 5709: 
 5710: 
 5711:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5712:    // Computes the density gradient between two elements, e1 and e2.
 5713:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5714:    // zero in the direction normal to the side. 
 5715:    // 
 5716:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5717:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5718:    //
 5719:    // Input:
 5720:    //    e1: Element
 5721:    //    e2: Neighbor element (or nullptr if boundary)
 5722:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5723:    //    k: Index of the half-level at which the density is interpolated
 5724:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5725:    // 
 5726:    // Output:
 5727:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5728:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5729: 
 5730:       if (e2 == nullptr || e2->isDry) {
 5731:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5732: 
 5733:          Side *side = e1->sides[j];
 5734:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5735:                  
 5736:          if constexpr(ics == 1) {
 5737:             vec = side->n; // Normal vector to the side
 5738:          } else {
 5739:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5740:             // IMPLEMENT THIS XXXXXX
 5741:             // !replace with xel, yel?
 5742:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5743:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5744:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5745:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5746:          } //ics
 5747:                    
 5748:          diffRho = 0.0;
 5749: 
 5750:       } else { //internal and wet
 5751:          if constexpr(ics==1) {
 5752:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5753: 
 5754:             // Vector from e1 to e2
 5755:             vec = e2->center - e1->center;
 5756: 
 5757:          } else { 
 5758:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5759:             // IMPLEMENT THIS XXXXXX
 5760:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5761:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5762:             //                   alow(j)=xctr2
 5763:             //                   bdia(j)=yctr2
 5764:          } // ics
 5765: 
 5766:          diffRho = rho2 - e1->demeanedDensity(k);
 5767:       }
 5768: 
 5769:    }
 5770: 
 5771:    __global__ void computeDensityCubicSplines(void) {
 5772:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5773: 
 5774:       ELEM(elem);
 5775: 
 5776:       if (elem->isDry) return;
 5777: 
 5778:       const int kb = elem->kb;
 5779: 
 5780:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5781:       if (elem->is2D()) {
 5782:          // In the 2D case, the density is constant at the prism level. 
 5783:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5784:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5785:       } else { //3D
 5786: 
 5787:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5788:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5789:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5790:          ///// XXXX CHECK INDICES!!!!!
 5791:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5792:       } // 2D/3D
 5793: 
 5794:    }
 5795: } // extern "C"
 5796: 
 5797: 
 5798: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5799: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5800: 
 5801:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5802: 
 5803:    const int kb  = elem->kb;
 5804:    const int kb2 = elem2->kb;
 5805: 
 5806:    // z-coordinate of prism of elem
 5807:    const double zp = elem->z_prism(k);
 5808: 
 5809:    double rho = 0.0;
 5810: 
 5811:    if (elem2->is2D()) {
 5812:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5813: 
 5814:    } else {  // 3D
 5815: 
 5816:       // eta_min may be < zmax
 5817:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5818:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5819: 
 5820:       // (Extrapolate density below bottom, we will fix it later)
 5821:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5822:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5823:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5824:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5825:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5826:    } // 2D/3D
 5827:      
 5828: 
 5829:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5830:    // Now we need to fix it.
 5831:    if (elem->z[k] < elem2->z[kb2]) {
 5832:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5833: 
 5834:       // There are two methods to adjust the density at the bottom of the element.
 5835:       // iunder_deep=0: 
 5836:       const double depth1 = abs(elem->z[kb]); // larger depth
 5837: 
 5838:       if (iunder_deep==0) {
 5839: 
 5840:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5841: 
 5842:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5843: 
 5844:       } else { // iunder_deep != 0
 5845: 
 5846:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5847: 
 5848:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5849: 
 5850:          //   Demeaned density at the same z coordinate as
 5851:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5852:          }
 5853: 
 5854:       } // if iunder_deep
 5855:    } // if elem->z[kb] < elem2->z[kb]
 5856: 
 5857:    return rho;
 5858: }
 5859: 
 5860: 
 5861: extern "C" {
 5862:    __global__ void computeDensityGradient(void) {
 5863: 
 5864:       if constexpr(ibc != 0) return;
 5865: 
 5866:          // Compute the horizontal density gradient at each element.
 5867:       // It works in two steps:
 5868:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5869:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5870:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5871:       //             gradRho.r1 = rho1 - rho0
 5872:       //             gradRho.r2 = rho2 - rho0
 5873:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5874:       // 
 5875:       //  NOTE: We use de-meaned densities.
 5876: 
 5877:       ELEM(elem);
 5878: 
 5879:       if (elem->isDry) return;
 5880: 
 5881:       const int kb  = elem->kb;
 5882:       const int i34 = elem->i34;
 5883: 
 5884:       for (int k = kb + 1; k < nvrt; k++) {
 5885:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5886:          //             gradRho.r1 = rho1 - rho0
 5887:          //             gradRho.r2 = rho2 - rho0
 5888:          int icount = 0;
 5889:          double sumRx = 0.0;
 5890:          double sumRy = 0.0;
 5891:          for (int j1=0; j1<i34; j1++) { 
 5892: 
 5893:             const int j2 = elem->nxq(j1 + 1);
 5894: 
 5895:             // Pairs of consecutive neighbor elements of elem
 5896:             const Element *e1 = elem->nghbElems[j1];
 5897:             const Element *e2 = elem->nghbElems[j2];
 5898: 
 5899:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5900:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5901:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5902: 
 5903:             // Compute the density difference and the vector from elem to e1 and e2
 5904:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5905:             double diffRho1, diffRho2;
 5906:             Vector2 vec1, vec2;
 5907:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5908:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5909: 
 5910:             const double rl1 = length(vec1);
 5911:             const double rl2 = length(vec2);
 5912:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5913: 
 5914:             const double delta = cross(vec1, vec2);
 5915:             const double sintheta = abs(delta)/(rl1*rl2);
 5916: 
 5917:             // To avoid problems, avoid elements with small angle between vectors
 5918:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5919:             const bool validEq = (sintheta > sin_one_deg);
 5920: 
 5921:             if (validEq) {
 5922:                // Solve the system of equations to get the density gradient at elem
 5923:                icount++;
 5924:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5925:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5926:                sumRx += Rx;
 5927:                sumRy += Ry;
 5928:             }
 5929:          } // for j1
 5930: 
 5931:          // Compute the average density gradient at elem
 5932:          if (icount==0) {
 5933:            // Bad mesh quality; bail out with 0 b-cc
 5934:            elem->gradRho[k] = {0.0, 0.0};
 5935:          } else {
 5936:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5937:          }
 5938: 
 5939:       } // for k
 5940: 
 5941:    }
 5942: 
 5943:    __global__ void computeBaroclinicTerm(void) {
 5944:    // Computes the baroclinic term at sides (at half levels).
 5945:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5946:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5947: 
 5948:       if (ibc == 1) return;
 5949: 
 5950:       SIDE(side);
 5951: 
 5952:       if (side->isDry) return;
 5953: 
 5954:       const Element *e1 = side->elems[0];
 5955:       const Element *e2 = side->elems[1]; 
 5956:       const int kb = side->kb;
 5957:       
 5958:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5959: 
 5960:       // interpolates vertically the density gradient of the two elements at the half level/
 5961: 
 5962:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 5963:       int k2 = max(kb, nvrt / 2);
 5964: 
 5965:       // Starts the integration at the surface and goes down to the bottom
 5966:       side->bcc[nvrt-1] = {0.0, 0.0};
 5967:       for (int k = nvrt - 2; k >= kb; k--) {
 5968:       // For each prism level (from surface to bottom)...
 5969: 
 5970:          // For both elements, interpolate density gradient at the side's half level.
 5971:          // The gradient at the side is the average of the gradients at the elements.
 5972:          // w1, w2 are used to take into account boundary sides, with just one element.
 5973:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5974:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5975:          const double wsum = w1 + w2;
 5976:          w1 = w1/wsum;
 5977:          w2 = w2/wsum;
 5978:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5979: 
 5980:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5981:          Vector2 gradRho = {0.0, 0.0};
 5982:          if (e1 != nullptr && k > kb) {
 5983:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5984:             
 5985:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5986:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5987:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5988: 
 5989:             // Grad(rho) vertically interpolated at the side's half level
 5990:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 5991: 
 5992:             // Projects the element density gradient to the side frame if needed.
 5993:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 5994: 
 5995:             // Adds the contribution of the density gradient at the side's half level
 5996:             gradRho += gradRho1*w1;
 5997:          }      
 5998:          if (e2 != nullptr && k > kb) {
 5999:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6000:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6001:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6002:             
 6003:             // Grad(rho) vertically interpolated at the side's half level
 6004:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6005: 
 6006:             // Projects the element density gradient to the side frame if needed.
 6007:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6008: 
 6009:             // Adds the contribution of the density gradient at the side's half level
 6010:             gradRho += gradRho2*w2;
 6011:          }
 6012: 
 6013:          
 6014:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6015:          // multiplied by -rampbc*(g/rho0) 
 6016:          const double grav3 = side->grav3();
 6017:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6018: 
 6019:       } // for
 6020: 
 6021:    }
 6022: 
 6023: 
 6024: 
 6025:    __global__ void computeHorGradientAtSide(void) {
 6026: 
 6027:       // Compute the horizontal density gradient at each element.
 6028:       // It works in two steps:
 6029:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6030:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6031:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6032:       //             gradRho.r1 = rho1 - rho0
 6033:       //             gradRho.r2 = rho2 - rho0
 6034:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6035:       // 
 6036:       //  NOTE: We use de-meaned densities.
 6037: 
 6038:       SIDE(side);
 6039: 
 6040: 
 6041:       if (side->isDry) return;
 6042: 
 6043:       // Computes the gradient of the variables at the side center.
 6044:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6045:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6046:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6047: 
 6048:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6049:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6050:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6051:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6052: 
 6053:    }
 6054: 
 6055: 
 6056:    __global__ void solveMomentumEquations(double time) {
 6057: 
 6058:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6059:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6060: 
 6061:       SIDE(side);
 6062: 
 6063:       if (side->isDry) 
 6064:       {
 6065:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6066: 
 6067:          return;
 6068:       }
 6069: 
 6070:       const Node *n1 = side->n1;
 6071:       const Node *n2 = side->n2;
 6072: 
 6073:       const int kb = side->kb;
 6074: 
 6075:       const double veg_h = side->veg_h();
 6076:       const double grav3 = side->grav3();
 6077: 
 6078:       if (side->is2D()) {
 6079:          // Remember: Do not use htot2, which is updated.
 6080:          const double htot = side->htot1();
 6081:          const double hhat = side->hhat;
 6082: 
 6083:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6084: 
 6085:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6086:          const Vector2 tau2 = side->tau();
 6087: 
 6088:          // hat_gam has units of m/s
 6089: 
 6090:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6091:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6092:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6093: 
 6094:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6095: 
 6096: 
 6097:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6098: 
 6099:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6100: 
 6101:       }
 6102:       else { // 3D
 6103: 
 6104:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6105:          // 
 6106:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6107:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6108:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6109:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6110:          // k+1 and k.
 6111: 
 6112: 
 6113:          const int ndim = nvrt - kb;
 6114:          const double zTopCanopy = side->zTopCanopy();
 6115: 
 6116:          // Initialize the tridiagonal system
 6117:          for (int k = kb + 1; k < nvrt; k++) {
 6118:             
 6119:             const int kin = k - (kb + 1);
 6120: 
 6121:             // Vertical viscosity at the face center
 6122:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6123: 
 6124:  
 6125:             alow[kin] = 0.0;
 6126:             cupp[kin] = 0.0;
 6127:             bdia[kin] = 0.0;
 6128: 
 6129:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6130:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6131: 
 6132:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6133:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6134:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6135: 
 6136:             // First part: layers k, k+1
 6137:             if (k < nvrt - 1) {
 6138:                              
 6139:                if constexpr(iveg != 0) {
 6140: 
 6141:                   // If there is vegetation at this level...
 6142:                   if (zTopCanopy > side->zc[k]) {
 6143:                      // If the canopy is above the k layer...
 6144:                      
 6145:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6146:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6147:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6148:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6149: 
 6150:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6151:                      const double vmag2 = length(ut2);
 6152:                      const double vmag1 = length(side->u2[k]);
 6153:                      const double vmag = 0.5*(vmag1 + vmag2);
 6154:                      
 6155:                      // Computes the vegetation alpha at the face center
 6156:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6157: 
 6158:                      cff1 += veg_alpha_sd*dt*vmag;
 6159: 
 6160:                   } // if (zTopCanopy
 6161:                } // if iveg
 6162: 
 6163:                const double dzz = side->Dz(k + 1);
 6164:                const double tmp = dt*dfz/dzz;
 6165:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6166: 
 6167:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6168:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6169:             }
 6170: 
 6171: 
 6172:             // Second part: layers k-1, k
 6173:             if (k > kb + 1) {
 6174: 
 6175:                double cff1 = 1.0; //init \bar{c^k}
 6176: 
 6177:                if constexpr(iveg != 0) {
 6178:                   // If there is vegetation at this level...
 6179:                   if (zTopCanopy > side->zc[k-1]) {
 6180:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6181:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6182: 
 6183:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6184: 
 6185:                      const double vmag2 = length(ut2);
 6186:                      const double vmag1 = length(side->u2[k-1]);
 6187:                      const double vmag = 0.5*(vmag1 + vmag2);
 6188: 
 6189:                      // Computes the vegetation alpha at the face center
 6190:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6191:                      cff1 += veg_alpha_sd*dt*vmag;
 6192:                   } // if zTopCanopy
 6193: 
 6194:                } // if iveg
 6195: 
 6196:                const double dzz = side->Dz(k);
 6197:                const double tmp = dt*dfz/dzz;
 6198:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6199: 
 6200:                alow[kin] += cff1*dzz/6.0 - tmp;
 6201:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6202: 
 6203:             } else { // Bottom boundary
 6204:                // This occurs at the bottom, where the bottom drag is applied.
 6205: 
 6206:                bdia[kin] += dt*side->chi2; // XXXX
 6207: 
 6208:             } // if (k > kb + 1)
 6209: 
 6210: 
 6211:          } // for (int k
 6212: 
 6213: 
 6214: 
 6215:          // Computes the RHS.
 6216:          // -----------------
 6217: 
 6218:          //	BC to be imposed at the end.
 6219: 
 6220:          const Vector2 gradETP  = side->gradETP;
 6221:          const Vector2 gradPr   = side->gradPr;
 6222:          const Vector2 gradEta1 = side->gradEta1;
 6223:          const Vector2 gradEta2 = side->gradEta2;
 6224: 
 6225:          const Vector2 *btu = side->btu;
 6226:          const Vector2 *u2  = side->u2;
 6227:          const double coriolis = side->coriolis;
 6228:          const Vector2 *nuGradU = side->nuGradU;
 6229: 
 6230: 
 6231:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6232:          for (int k = kb + 1; k < nvrt; k++) {
 6233:             const int kin = k - kb - 1;
 6234: 
 6235:             const double dz_0 = side->Dz(k);
 6236:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6237: 
 6238:             rrhs[kin] = {0.0, 0.0};
 6239:             double dz = 0.0;
 6240: 
 6241:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6242:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6243:             if (k < nvrt  ) dz += dz_1;
 6244:             if (k > kb + 1) dz += dz_0;
 6245: 
 6246:             // Elevation gradient, atmospheric pressure and tidal potential
 6247:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 6248: 
 6249:             // Coriolis, advection, wind stress, and horizontal viscosity
 6250:             if (k < nvrt - 1) {
 6251: 
 6252: 
 6253:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6254:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6255:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6256:                                                 
 6257: 
 6258:                //diff stress tensors 1006
 6259:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6260:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6261:                   assert(false && "Not implemented: itur == 5");
 6262:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6263:                }
 6264:                // else assert(false && "itur # Not implemented");
 6265: 
 6266:             } else { // k == nvrt - 1 SURFACE
 6267:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6268:                const Vector2 tau2 = side->tau();
 6269: 
 6270:                rrhs[kin] += dt*tau2;          
 6271: 
 6272:             } // if k<nvrt
 6273: 
 6274: 
 6275:             if (k > kb + 1) {
 6276:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6277:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6278:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6279: 
 6280:                // diff stress tensors 1006
 6281:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6282:                   assert(false && "Not implemented: itur == 5");
 6283:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6284:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6285:                }
 6286:                // else assert(false && "itur # Not implemented");
 6287: 
 6288: 
 6289:             } // if k>kbs + 1
 6290: 
 6291:             // Baroclinic
 6292:             Vector2 *bcc = side->bcc;
 6293:             if constexpr(ibc == 0) {
 6294:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6295:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6296: 
 6297:             } // if ibc==0
 6298: 
 6299:          } // k=kb + 1,nvrt
 6300: 
 6301: 
 6302:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6303: 
 6304:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6305:             const int kin = k - kb - 1;
 6306:    
 6307:             // Velocity is always clamped to maximum values
 6308:             side->u2[k] = clampVelocity(soln[kin]);
 6309:          } // k
 6310: 
 6311:       } // if side->is2D()
 6312:       
 6313: 
 6314:       // Impose velocity boundary condition at the bottom
 6315:       if constexpr(imm == 2) { // 3D bed deformation model
 6316:          double dep;
 6317:          Vector2 vel;
 6318: 
 6319:          assert(false && "Not implemented: imm == 2");
 6320:          //update_bdef(time, x0, y0, dep, vel);
 6321:          // side->u2[kb] = vel;
 6322: 
 6323:       } else { // imm = 0 or 1
 6324:          if (side->Cd() == 0.0) {
 6325:             side->u2[kb] = side->u2[kb + 1];
 6326: 
 6327:          } else if (side->is3D()) { // 3D no slip bottom   
 6328:             side->u2[kb] = {0.0, 0.0};
 6329: 
 6330:          }
 6331:           
 6332:       } // if imm
 6333: 
 6334:       // The velocities below the bottom level are set to zero
 6335:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6336: 
 6337: 
 6338:    }
 6339: 
 6340: 
 6341:    __global__ void applyMomentumBC(void) {
 6342: 
 6343:       SIDE_BND(sideBnd);
 6344: 
 6345:       Side *side = sideBnd->side;
 6346:       const BoundarySegment *segment = sideBnd->segment;
 6347:       const Node *n1 = side->n1;
 6348:       const Node *n2 = side->n2;
 6349: 
 6350:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6351: 
 6352:       const bool isLand = segment->isLand;
 6353:       const int ifltype = segment->ifltype;
 6354: 
 6355:       const int kb = side->kb;
 6356: 
 6357: 
 6358:       if (!isLand && ifltype != 0) {
 6359:          const Vector2 *ubc = sideBnd->ubc;
 6360:   
 6361:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 6362:             
 6363:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6364:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6365: 
 6366:             if (ifltype == -1) {
 6367:                // Flather 1
 6368: 
 6369:                const double depth = side->depth();
 6370: 
 6371:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6372: 
 6373:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6374: 
 6375:                side->u2[k] = vnorm*side->n;
 6376: 
 6377:             } else if (ifltype == -2) { // Discharge
 6378: 
 6379:                const double eta1 = side->eta1();
 6380:                const double eta2 = side->eta2();
 6381:                const double htot = side->htot2();
 6382: 
 6383:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6384:                assert(false && "Not implemented: Discharge bc");
 6385:                // const double dischrg = discharge(eta1);
 6386:                const double dischrg = 0.0; // XXX REMOVE
 6387:                
 6388: 
 6389:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6390: 
 6391:                const double vnorm = dischrg*eta2/htot;
 6392: 
 6393:                side->u2[k] = vnorm*side->n;
 6394: 
 6395:             }
 6396:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6397:                const double vnorm = dot(side->u2[k], side->n);
 6398: 
 6399:                double rat;
 6400:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6401:                else              rat = segment->vobc2; // outgoing
 6402: 
 6403:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6404: 
 6405:             }
 6406:             else { // not Flather or 3D radiation
 6407:                side->u2[k] = ubc[k];
 6408: 
 6409:             } // if (segment->ifltype...
 6410: 
 6411:          }
 6412: 
 6413:       }
 6414:       else if (isLand) { // if it is land boundary side
 6415: 
 6416:          if constexpr(islip == 0) { // free slip
 6417: 
 6418:             for (int k = kb; k < nvrt; k++) {
 6419: 
 6420:                const Vector2 t = side->t();
 6421:                const Vector2 n = side->n;
 6422: 
 6423:                double vnorm = 0.0; // for most cases
 6424:                const double vtan = dot(side->u2[k], t);
 6425:                
 6426:                side->u2[k] = vtan*t - vnorm*n;
 6427: 
 6428:             }
 6429: 
 6430:          } else { // no slip
 6431:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6432: 
 6433:          }
 6434:       } // if (side segment type...
 6435: 
 6436:    
 6437: 
 6438:    }
 6439: 
 6440: 
 6441:    __global__ void shapiroFilter1(void) {
 6442:       // First step of the Shapiro filter (normally used if indvel<=0)
 6443:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6444: 
 6445:       SIDE(side);
 6446: 
 6447:       // Only internal wet sides are processed
 6448:       if (side->isDry || !(side->isInternal())) return;
 6449: 
 6450:       const int kb = side->kb;
 6451: 
 6452:       for (int mm = 0; mm < niter_shap; mm++) {
 6453: 
 6454:          for (int k = kb + 1; k < nvrt; k++) {
 6455:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6456:             Vector2 suru = {0.0, 0.0};
 6457: 
 6458:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6459: 
 6460:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6461: 
 6462:                int kin = k;
 6463:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6464:                
 6465:                // Get the velocity at the neighbor's side.
 6466:                Vector2 nSideU2 = nSide->u2[kin];
 6467: 
 6468:                // Projects the velocity to the current side frame if needed.
 6469:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6470: 
 6471:                suru += nSideU2;
 6472:             }
 6473: 
 6474:             // Reusing bcc as a temporary array to store the suru values.
 6475:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6476: 
 6477:          }
 6478:       }
 6479:    }
 6480: 
 6481:    __global__ void shapiroFilter2(void) {
 6482:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6483: 
 6484:       SIDE(side);
 6485: 
 6486: 
 6487:       if (side->isDry || !(side->isInternal())) return;
 6488: 
 6489:       const int kb = side->kb;
 6490: 
 6491:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6492: 
 6493:       if (side->is2D()) {
 6494:          side->u2[kb + 1] = side->bcc[kb + 1];
 6495:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6496: 
 6497:       } else {
 6498:          // 3D
 6499:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6500:          
 6501:       }
 6502: 
 6503:    }
 6504: 
 6505: 
 6506:    __global__ void ul0UpdateZCoords(void) {
 6507:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6508:       
 6509:       NODE(node);      
 6510: 
 6511: 
 6512:       if (false) { //node->isDry) { XXXXXXX
 6513: 
 6514:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6515: 
 6516:          if constexpr(ivcor != 1) node->kb = 0;
 6517: 
 6518:       } else {
 6519: 
 6520:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6521:          node->updateKb();
 6522: 
 6523:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6524: 
 6525:       }
 6526: 
 6527:       // We use the temp.b field to store the previous state of isDry.
 6528:       node->tmp.b = node->isDry;
 6529: 
 6530:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6531:       node->isDry = true;
 6532: 
 6533:    }
 6534: 
 6535:    __global__ void ul0ComputeDryElements(void)
 6536:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6537:    {
 6538:       ELEM(elem);
 6539: 
 6540:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6541: 
 6542:       elem->kb = 0;
 6543: 
 6544:       if (elem->isDry) return;
 6545: 
 6546: 
 6547:    //    if(elem->isDry2()) { // XXXX
 6548:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6549:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6550:    //        call parallel_abort(errmsg)
 6551:    //    }
 6552: 
 6553:       const Node *n1 = elem->nodes[0];
 6554:       const Node *n2 = elem->nodes[1];
 6555:       const Node *n3 = elem->nodes[2];  
 6556:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6557: 
 6558:       // Computes element's kb as the minimum of the nodes' kb.
 6559:       const int kb1 = n1->kb;
 6560:       const int kb2 = n2->kb;
 6561:       const int kb3 = n3->kb;
 6562:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6563: 
 6564: 
 6565:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6566: 
 6567: 
 6568:       // Computes the element z as the mean of the nodes z.
 6569:       for (int k = elem->kb; k < nvrt; k++) {
 6570: 
 6571:          // Compute the element z as the mean of the nodes z.
 6572:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6573:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6574:          elem->z[k] /= elem->i34;
 6575: 
 6576: if (k>elem->kb && elem->z[k] <= elem->z[k-1]) printf("EEEE elem->isDry = %d, idx1 = %d, idx2 = %d, idx3 = %d, z1[k] = %f, z2[k] = %f, z3[k] = %f, z1[k-1] = %f, z2[k-1] = %f, z3[k-1] = %f, k = %d, kb = %d, kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d, z[k] = %f, z[k-1] = %f\n", elem->isDry, n1->idx, n2->idx, n3->idx, n1->z[max(k, kb1)], n2->z[max(k, kb2)], n3->z[max(k, kb3)], n1->z[max(k-1, kb1)], n2->z[max(k-1, kb2)], n3->z[max(k-1, kb3)],  k, elem->kb, kb1, kb2, kb3, kb4, elem->z[k], elem->z[k-1]);
 6577:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6578:       }
 6579:                   
 6580:    }
 6581: 
 6582:    __global__ void ul0ComputeDryNodes(void)
 6583:    // Updates node's isDry based on the elements' isDry. 
 6584:    {
 6585:       NODE(node);
 6586: 
 6587:       node->isDry = true;
 6588: 
 6589:       // A node is wet if at least one of the elements sharing it is wet.
 6590:       for (int j = 0; j < node->numElements; j++) {
 6591:          const Element *elem = node->elements[j];
 6592:          if (!elem->isDry) {
 6593:             node->isDry = false;
 6594:             break;
 6595:          }
 6596:       }
 6597: 
 6598:        
 6599:    }
 6600: 
 6601: 
 6602:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6603:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6604:    // node->tmp.b is true if the node was previously dry.
 6605:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6606:    {
 6607:       NODE(node);
 6608:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6609: 
 6610:       // Avoid this the first time step.
 6611:       if (it == iths) return;  
 6612: 
 6613:       const bool wasDry = node->tmp.b;
 6614: 
 6615: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6616: 
 6617:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6618: 
 6619:          for (int k=0; k < nvrt; k++) {
 6620: 
 6621:             Vector3 utmp={0.0, 0.0, 0.0};
 6622: 
 6623:             double ttmp=0.0;
 6624:             double stmp=0.0;
 6625:             int icount=0;
 6626:             for (int j = 0; j < node->numNodes; j++) {
 6627: 
 6628:                const Node *nbrNode = node->nodes[j];
 6629:                
 6630:                const bool wasNbrDry = nbrNode->tmp.b;
 6631: 
 6632:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6633:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6634: 
 6635:                   icount++;
 6636: 
 6637:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6638:                   utmp += nbrNode->uvw2(k);
 6639:                   
 6640:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6641:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6642:                }
 6643:             }
 6644: 
 6645:             if (icount > 0) {
 6646:                const double inv_icount = 1.0/icount;
 6647:                utmp = inv_icount*utmp;
 6648:                node->u2[k]     = toVector2(utmp);
 6649:                node->w2[k]     = utmp.z;
 6650:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6651:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6652:             } else {
 6653:                node->u2[k] = {0.0, 0.0};
 6654:                node->w2[k] = 0.0;
 6655:                // Initialize tracers to 0.0??? XXXXX
 6656:             }
 6657:          }
 6658:       }
 6659:    }
 6660: 
 6661:   
 6662:    
 6663: 
 6664: 
 6665:    __global__ void ul0UpdateSides(int it, int iths) {
 6666:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6667:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6668:    // The dryness of the sides is updated in ul0UpdateSides2.
 6669: 
 6670:       SIDE(side);
 6671: 
 6672:       // A side is wet if and only if at least one of its elements is wet.
 6673:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6674:  
 6675:       const Node *n1 = side->n1;
 6676:       const Node *n2 = side->n2;
 6677:      
 6678:       const int kb1 = n1->kb;
 6679:       const int kb2 = n2->kb;
 6680: 
 6681:       side->kb = 0; // default when dry
 6682: 
 6683:       if (isWet) {
 6684: 
 6685:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6686: 
 6687:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6688: 
 6689:          side->kb = min(kb1, kb2);
 6690: 
 6691:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6692: 
 6693:          for (int k = side->kb; k < nvrt; k++) {
 6694:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6695: 
 6696:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6697: 
 6698:             // Compute velocity for re-wetted sides 
 6699:             if ((it != iths) && (side->isDry && isWet)) {
 6700: 
 6701:                Vector2 utmp={0.0, 0.0};
 6702: 
 6703:                int icount=0;
 6704: 
 6705:                // For all the sides on the two elements that share this side
 6706:                for (int j = 0; j < 2; j++) {
 6707:                   const Element *elem = side->elems[j];
 6708:                   if (elem == nullptr) continue;
 6709: 
 6710:                   for (int jj=0; jj < elem->i34; jj++) {
 6711:                      const Side *nSide = elem->sides[jj];
 6712:                      if (nSide->isDry) continue;
 6713: 
 6714:                      icount++;
 6715:                      utmp += nSide->u2[k];  
 6716:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6717:                   }
 6718:                }
 6719:                   
 6720:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6721:                if (icount > 0)  side->u2[k] = utmp/icount;
 6722:                else             side->u2[k] = {0.0, 0.0};
 6723:                   
 6724:             } // if ((it != iths) && (side->isDry && isWet))
 6725: 
 6726:          } // for k
 6727: 
 6728:       } // if isWet 
 6729:       
 6730: 
 6731: 
 6732:    }
 6733: 
 6734:    __global__ void ul0UpdateSides2(void) {
 6735:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6736:    
 6737:          SIDE(side);
 6738:    
 6739:          const Element *e1 = side->elems[0];
 6740:          const Element *e2 = side->elems[1];
 6741: 
 6742:          // A side is wet if and only if at least one of its elements is wet.
 6743:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6744: 
 6745:          // Update the side's dryness
 6746:          side->isDry = !isWet;
 6747: 
 6748:    }
 6749: 
 6750: 
 6751:    __global__ void zeroNodalVelocities(void) {
 6752:       NODE(node);
 6753: 
 6754:       for (int k = 0; k < nvrt; k++) {
 6755:          node->u2[k]   = {0.0, 0.0};
 6756:          node->w2[k]   = 0.0;
 6757:          node->utmp[k] = {0.0, 0.0};
 6758:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6759:       }
 6760:    }
 6761:  
 6762: 
 6763:    __global__ void computeNodalVerticalVelocities1(void) {
 6764:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6765:    // Adds the element's vertical velocity times the element's area.
 6766:       ELEM(elem);
 6767: 
 6768:       for (int j = 0; j < elem->i34; j++) {
 6769:          Node *node = elem->nodes[j];
 6770: 
 6771:          for (int k = node->kb; k < nvrt; k++) {
 6772:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6773:          }
 6774:          atomicAdd(&(node->tmp.d), elem->area);
 6775:       }
 6776:    }
 6777: 
 6778:    __global__ void computeNodalVerticalVelocities2(void) {
 6779:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6780:    // Divides by the total area of the elements sharing the    node.
 6781:       NODE(node);
 6782: 
 6783:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6784: 
 6785:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6786:    }
 6787: 
 6788: 
 6789:    __global__ void computeNodalHorizontalVelocities1(void) {
 6790: 
 6791:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6792: 
 6793:       ELEM(elem);
 6794: 
 6795:       if (elem->isDry) return;
 6796: 
 6797:       const int kb = elem->kb;
 6798:       const bool isTri = elem->isTri();
 6799: 
 6800:       if constexpr(indvel <= 0) {
 6801:          // Assuming discontinous hvel.
 6802: 
 6803:          if (isTri) { // For triangles
 6804:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6805:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6806: 
 6807:             for (int j = 0; j < 3; j++) {
 6808:                // For every node of the triangle...
 6809:                Node *node = elem->nodes[j];
 6810: 
 6811:                if (node->isDry) continue;
 6812: 
 6813:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6814:                const Side *s2 = elem->sides[(j + 1) % 3];
 6815:                const Side *s3 = elem->sides[(j + 2) % 3];
 6816: 
 6817:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6818: 
 6819:                atomicAdd(&(node->tmp.i), 1);
 6820: 
 6821:                for (int k = kb; k < nvrt; k++)  {
 6822:                   Vector2 s1u2 = s1->u2[k];
 6823:                   Vector2 s2u2 = s2->u2[k];
 6824:                   Vector2 s3u2 = s3->u2[k];
 6825: 
 6826:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6827:                   if constexpr(ics == 2) {
 6828:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6829:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6830:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6831:                   }
 6832: 
 6833:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 6834:                   u = clampVelocity(u);
 6835:                   atomicAdd(&(node->utmp[k].x), u.x);
 6836:                   atomicAdd(&(node->utmp[k].y), u.y);
 6837: 
 6838:                }
 6839: 
 6840:             }
 6841:          }
 6842:          else { // For quads
 6843:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6844: 
 6845:          }
 6846: 
 6847:       }
 6848:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6849:       
 6850:    }
 6851: 
 6852: 
 6853:    __global__ void computeNodalHorizontalVelocities2(void) {
 6854:       NODE(node);
 6855: 
 6856:       const int nodeCount = node->tmp.i;
 6857: 
 6858:       if (nodeCount == 0) 
 6859:       {
 6860:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6861:          return;
 6862:       }
 6863: 
 6864:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6865:       
 6866:       const int kb = node->kb;
 6867: 
 6868:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6869:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6870:       
 6871:       
 6872:    }   
 6873: 
 6874:  
 6875: 
 6876:    __global__ void resetVelocityOpenBndNodes(void) {
 6877:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6878: 
 6879:       NODE_BND(nodebnd);
 6880: 
 6881:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6882:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6883:       }
 6884: 
 6885:    }
 6886: 
 6887: 
 6888:    __global__ void setVelocityOpenBndNodes(void) {
 6889:    // For open boundary nodes sets their velocity to the imposed values.
 6890: 
 6891:       SIDE_BND(sidebnd);
 6892: 
 6893:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6894:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6895:          // to its segment to the average of the side velocity.
 6896: 
 6897:          for (int k = 0; k < nvrt; k++) {
 6898:             Node *n1 = sidebnd->side->n1;
 6899:             Node *n2 = sidebnd->side->n2;
 6900: 
 6901: 
 6902:             Vector2 n1_u2(n1->u2[k]);
 6903:             Vector2 n2_u2(n2->u2[k]);
 6904: 
 6905:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6906:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6907:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6908:             }
 6909:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6910:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6911:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6912:             }
 6913: 
 6914:          }
 6915: 
 6916:       }
 6917: 
 6918:    }
 6919: 
 6920: 
 6921:    __global__ void computeVerticalVelocity(void) {
 6922:       // Computes the vertical velocity at the (2D) element's centroid.
 6923:       // In this function we will be considering volumetric elements, with side faces and a 
 6924:       // bottom and a top face. We will call them SFs, BF and TF.
 6925:       // It computes the flux coming from BF and the SFs.
 6926:       // If the bed is moving, it takes that into account.
 6927:       // Since water is incompressible, the integral of the velocity times the normal vector
 6928:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6929:       // and the BF is equal to the flux going out from the TF.
 6930:       // TF = - BF - sum(SFs).
 6931:       // It then computes the horizontal velocity at the center of TF.
 6932:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6933:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6934:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6935: 
 6936:       ELEM(elem);
 6937: 
 6938:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6939: 
 6940:       if (elem->isDry) return;
 6941: 
 6942:       const int kb = elem->kb;
 6943:       const bool isTri = elem->isTri();
 6944: 
 6945:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6946: 
 6947:       // Compute the bottom velocity
 6948:       if constexpr(imm != 0) {
 6949:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 6950:       }
 6951: 
 6952: 
 6953:       double bottomArea3D;
 6954:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 6955: 
 6956:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 6957: 
 6958:       double topArea3D;
 6959: 
 6960:       // Bottom face flux
 6961:       double bottomFlux = 0.0;
 6962:       Vector2 u2meanBottom = {0.0, 0.0};
 6963:       const Vector2 gradh = elem->grad2(&Node::depth);
 6964:       if constexpr(imm==2) {
 6965:          Vector3 ubed;
 6966: 
 6967:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6968:          // updateBDEF(ubed);
 6969:      
 6970:          // const double bflux0 = dot(ubed, elem_bottom_n);
 6971: 
 6972:          // elem->w[kb] += ubed.z;
 6973:       }
 6974:       else {
 6975: 
 6976: 
 6977:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 6978:   
 6979:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 6980:          // in the direction of motion.
 6981:          const double bottomW = - dot(gradh, u2meanBottom);  
 6982:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 6983: 
 6984:          // VElocity associated to the bed deformation
 6985:          double bedVelocity = 0.0;
 6986:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 6987: 
 6988:          elem->w[kb] = bedVelocity + bottomW; 
 6989: 
 6990:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 6991:          
 6992:       } // if imm
 6993: 
 6994:       // Compute w for kb+1 to nvrt-1
 6995:       for (int l = kb; l < nvrt - 1; l++) {
 6996: 
 6997:          // normal vector to the top face of the "volumetric" element (3D)
 6998:          Vector3 elem_top_n = -elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6999: 
 7000:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7001:          assert(elem_top_n.z < 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7002: 
 7003:          // Compute the total flux at the sides
 7004:          double sideFlux = 0.0;
 7005: 
 7006:          for (int j = 0; j < elem->i34; j++) {
 7007:             const Side *side = elem->sides[j];
 7008:             const int kbs = side->kb;
 7009:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7010:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7011:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7012: 
 7013:             // The area is "clamped" meaning that it takes kb into account.
 7014:             const double sideArea = side->areaClamped(l);
 7015: 
 7016:             const double sign = elem->ssign[j]; 
 7017: 
 7018:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7019:             sideFlux -= sign*dot(u2c, side->n)*sideArea;
 7020:          }
 7021:          
 7022:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7023:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7024:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7025: 
 7026:          // The flux at the top ace can be computed from the other flows.
 7027:          // All fluxes are in directions into the prism.
 7028:          const double topFlux = - sideFlux - bottomFlux;
 7029: 
 7030:          // Flux at the top face due to the horizontal velocities only
 7031:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7032: 
 7033:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + bottomFlux = 0, so:
 7034:          const double topVerticalFlux = -sideFlux - topHorizontalFlux - bottomFlux;  
 7035: 
 7036:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7037: 
 7038:          bottomFlux = -topFlux;
 7039:       }
 7040:    }  
 7041: 
 7042: 
 7043: 
 7044: 
 7045: 
 7046: 
 7047: 
 7048: // !===============================================================================
 7049: // !===============================================================================
 7050: 
 7051: } // extern "C"
 7052: 
 7053: #ifdef DONTCOMPILE
 7054: __device__ void computeVerticalAdvection(void) {
 7055:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7056: 
 7057:    sdbt(1:2,:,:)=0.d0
 7058: 
 7059:    const Side *side = FROM kernel;
 7060: 
 7061:    if(side->isDry) return;
 7062: 
 7063:    // If side is wet...
 7064: 
 7065: 
 7066:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7067:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7068:    double ws[nvrt] = {} // w @ side
 7069:    int icount = 0;
 7070:    for (int j=0; j<2; j++) {
 7071:       const Element *elem = side->elements[j];
 7072:        
 7073:       if(elem != nullptr) {
 7074:          icount++;
 7075:          for (int k=0; k<nvrt; k++) {
 7076:             ws[k] = ws[k] + elem->w[k];
 7077:          }
 7078:       }
 7079:    }  // for j
 7080: 
 7081:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7082:    ws = ws/icount;
 7083: 
 7084:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7085:    // Splines allow for a smooth transition between vertical levels.
 7086:    // Splines have continuity restrictions at the internal knots, but
 7087:    // we have to provide the 1st derivatives at the endpoints.
 7088:    const int kbs = side->kbs; 
 7089:    
 7090:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7091:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7092:    initCubicSpline(kbs, nvrt, side, ws, up)
 7093: 
 7094:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7095:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7096:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7097: 
 7098:    // Total advection (average onto side)
 7099:    const Node *node1 = side->nodes[0];
 7100:    const Node *node2 = side->nodes[1];
 7101:    for (int k=kbs(i); k<nvrt; k++) {
 7102: 
 7103:       Vector2 bcc1 = node1->bcc[k];
 7104:       Vector2 bcc2 = node2->bcc[k];
 7105:       if constexpr(ics == 2) {
 7106:          // Project the velocities from the node frames to the side frame
 7107:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7108:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7109:       }
 7110: 
 7111:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7112:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7113: 
 7114:    }
 7115: }
 7116: #endif
 7117: 
 7118: 
 7119: extern "C" {
 7120:    __global__ void computeElemAverageGhat(void) {
 7121:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7122: 
 7123:       ELEM(elem);
 7124:       
 7125:       elem->ghat1= {0.0, 0.0};  
 7126: 
 7127:       if constexpr(ihydraulics != 0) {
 7128:          if (nhtblocks > 0 && elem->isblock) return;
 7129:       }
 7130: 
 7131:       
 7132:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7133:       // cff1-3: coefficients for 2D/3D
 7134: 
 7135:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7136:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7137:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7138: 
 7139:       if (elem->isDry) return;
 7140: 
 7141:       // Average of the coefficients
 7142:       double av_cff1 = 0.0;  // av. for cff1
 7143:       double av_cff2 = 0.0;  // av. for cff2
 7144:       double av_cff3 = 0.0;  // av. for cff3
 7145:       double av_df = 0.0;  // av. for H^\alpha / H
 7146:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7147:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7148: 
 7149:       const int i34 = elem->i34;
 7150:       const int kb  = elem->kb;
 7151: 
 7152:       for (int j=0; j<i34; j++) {
 7153:          // For each node and side in the element...
 7154: 
 7155:          const Node *node = elem->nodes[j];
 7156:          const Side *side = elem->sides[j];
 7157: 
 7158:          const double chi      = side->chi;
 7159:          const double veg_c2   = side->veg_c2;
 7160:          const double veg_beta = side->veg_beta;
 7161:          const double veg_h    = side->veg_h();
 7162:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7163: 
 7164:          // Node - const in elem
 7165:          elem->gradEta += node->eta2*elem->gradPhi[j];  // gradPhi is always in the element frame
 7166:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 7167: 
 7168:          if (elem->depth >= tip_dp) {
 7169:            elem->gradETP += node->ETP*elem->gradPhi[j];
 7170:          }
 7171: 
 7172:          
 7173:          const double htot  = side->htot2();        // Total depth at the side
 7174:          const double zctr2 = side->zTopCanopy();  
 7175: 
 7176:          double cff1; 
 7177:          double cff2; 
 7178:          double cff3;   
 7179:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7180:          // coefficients applied to 2D/3D case 
 7181:             cff1 = side->hhat/htot;
 7182:             cff2 = 0.0;
 7183:             cff3 = 0.0;
 7184:          } else { //3D
 7185:             //Init for no-veg case
 7186:             cff1 = 1.0;
 7187:             cff2 = 1.0;
 7188:             cff3 = 0.0;
 7189: 
 7190:             if constexpr(iveg != 0) {
 7191:                // Computes coefficients used with vegetation terms G1, G2
 7192:                // cff1, cff3 are used for the first two terms in G1, G2:
 7193:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7194:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7195:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7196:                if(veg_h < 0.99*htot) { // submergent vegetation
 7197:                   cff1=1;
 7198:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7199:                   cff3 = veg_c;
 7200: 
 7201:                } else { // emergent vegetation
 7202:                   cff1 = 1.0/(1.0 + veg_c2);
 7203:                   cff2 = cff1;
 7204:                   cff3 = 0.0;
 7205: 
 7206:                }
 7207:             } // if iveg
 7208:          } //  2D/3D
 7209: 
 7210:          av_cff1 += cff1/i34;
 7211:          av_cff2 += cff2/i34;
 7212:          av_cff3 += cff3/i34;
 7213:          av_cff2_chi += cff2*chi/i34;
 7214:          av_cff3_chi += cff3*chi/i34;
 7215:          av_df += min(htot, veg_h)/(htot*i34);
 7216: 
 7217: 
 7218:          // btrack values: U^\star, U^{\star\alpha}
 7219:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7220:          Vector2 Ustar       = {0.0, 0.0}; 
 7221:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7222: 
 7223:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7224:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7225:          } else { //3D
 7226:             for (int k = side->kb + 1; k < nvrt; k++) {
 7227:             
 7228:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7229:                Ustar += w2;
 7230: 
 7231:                if constexpr(iveg != 0) {
 7232:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7233:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7234:                        Ustar_alpha += zrat*w2; // XXXX
 7235:                    }
 7236:                }  // if iveg
 7237:             }  // for k
 7238:          }  //2D/3D
 7239: 
 7240:          // If needed, project the side velocities to the element frame
 7241:          if constexpr(ics==2) {
 7242:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7243:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7244:          }
 7245:         
 7246: 
 7247:          // Add btrack & surface stress terms to \breve{G} first
 7248:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7249: 
 7250: 
 7251:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7252:          Vector2 tau    = side->tau();  
 7253:          Vector2 ubstar = side->btu[side->kb + 1];  
 7254: 
 7255:          // If needed, project tau and ubstar to the element frame
 7256:          if constexpr(ics==2) {
 7257:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7258:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7259:          }
 7260: 
 7261:          // Term for surface and bottom stress
 7262:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7263: 
 7264: 
 7265:          // All terms in F,F^\alpha,f_b except baroclinic
 7266:          // F, f_b: all explicit terms excluding vegetation 
 7267:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7268:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7269:          const double coriolis = side->coriolis;
 7270:          Vector2 F  =  coriolis*side->U;  // F_x
 7271:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7272:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7273: 
 7274:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7275:             
 7276:             for (int k = side->kb; k < nvrt; k++) {
 7277:                if (zctr2 > side->zc[k-1]) {
 7278:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7279:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7280:                    Fa +=  coriolis*w2*zrat;
 7281:                } // if zctr2
 7282:             } // k
 7283:          } // iveg
 7284: 
 7285:          // Integrate horizontal viscosity force vertically
 7286:          for (int k=side->kb + 1; k<nvrt; k++) {
 7287:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7288: 
 7289:             F += levelHorVisc;
 7290: 
 7291:             // Vegetation term
 7292:             if constexpr(iveg!=0) {
 7293:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7294:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7295:                   Fa += levelHorVisc*zrat;
 7296:                } 
 7297:             } // if iveg
 7298:          } // for k
 7299: 
 7300:          // Get nu*grad(U) at the side's bottom level
 7301:          Vector2 nuGradU = side->nuGradU[side->kb];
 7302: 
 7303:          fb += nuGradU;
 7304: 
 7305:          // If needed, project vectorsF, fb and Fa to the element frame
 7306:          if constexpr(ics==2) {
 7307:             F    = side->frame.projHorVec(F,    elem->frame);
 7308:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7309:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7310:          } // if ics
 7311: 
 7312:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7313:       } // for j (nodes and sides)
 7314: 
 7315:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7316:          
 7317:       // Finish off terms in F, F^\alpha and f_b
 7318:       const double grav3 = elem->mean(&Node::grav2);
 7319:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7320: 
 7321: 
 7322:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7323:       for (int j=1; j<i34; j++) { 
 7324:          // For each side in the element...
 7325:          const Side *side = elem->sides[j];
 7326:          const double chi = side->chi;
 7327: 
 7328:          const double htot = side->htot2();
 7329:          const double veg_h = side->veg_h();
 7330:          const Vector2 F  = htot*fb;
 7331:          const Vector2 Fa = min(htot, veg_h)*fb;
 7332: 
 7333:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7334:       } // for j
 7335: 
 7336:       //botf1 etc are already in elem frame
 7337:       elem->ghat1 += tmp/i34;
 7338: 
 7339:       // Baroclinic force
 7340:       if constexpr(ibc==0) {
 7341:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7342: 
 7343:          Vector2 Fa = {0.0, 0.0};
 7344:          Vector2 intGradRho = {0.0, 0.0};
 7345:          
 7346:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7347:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7348:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7349: 
 7350:             // \in F [m^2/s/s]
 7351:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7352:          }
 7353: 
 7354:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7355:          const Vector2 F = av_df*Fa; //approx
 7356:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7357: 
 7358:       } // if ibc
 7359: 
 7360: 
 7361: 
 7362:    }
 7363: 
 7364: } // extern "C"
 7365: 
 7366: 
