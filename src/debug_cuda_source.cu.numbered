 1355:    int nbp;  // Local number of boundary nodes
 1356:    int nbs;  // Local number of boundary sides
 1357: 
 1358:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1359:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1360:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1361: 
 1362:   
