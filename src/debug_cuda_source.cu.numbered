 5611:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5612: 
 5613:       SIDE(side);
 5614: 
 5615:       side->U = {0.0, 0.0}; 
 5616:          
 5617:       if(side->isDry) return;
 5618: 
 5619:       // Vertically integrated velocity U
 5620:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5621:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5622:          side->U += side->Dz(k + 1)*uc;  
 5623:       }
 5624: 
 5625:    }
 5626: 
 5627:    __global__ void computeBottomDragVegetation(void) {
 5628:       // UNFINISHED. CHECK THIS:
 5629:       // How many kernels are needed? Why so many for loops?
 5630:       // Is the loop on sides needed?
 5631: 
 5632:       NODE(node);
 5633: 
 5634: 
 5635:       const int    kb      = node->kb;
 5636:       const double htot    = node->htot2(); 
 5637:       
 5638:       if (node->isDry) {
 5639:          // Default values for dry nodes
 5640:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5641:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5642: 
 5643:          return;
 5644:        
 5645:       }
 5646: 
 5647:       // Computes bottom drag Cd based on the selected nchi
 5648:       node->computeBottomDragCd();
 5649:       
 5650: 
 5651: 
 5652:       //   Bottom stress in m^2/s^2
 5653:       if (node->rho[kb + 1] >= -98.0)
 5654:       {
 5655:          const double mag_u = length(node->u2[kb + 1]);
 5656:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5657: 
 5658:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5659:          // !sediment erosion: this part needs more documentation
 5660:       }
 5661:     
 5662: 
 5663: 
 5664:       // Compute vegetation parameters
 5665:       //--------------------------------
 5666: 
 5667:       // SAV constants
 5668:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5669:       constexpr double veg_cfpsi = 0.16;
 5670: 
 5671:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5672:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5673: 
 5674:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5675:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5676:          int kbin = 0; // bin index
 5677:          for (int k = kb; k < nvrt; k++) {
 5678:             // Computes node height above the bottom level
 5679:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5680:             assert(false && "Vertical variation of vegetation not implemented");
 5681: 
 5682:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5683:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5684:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5685:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5686:             // } else {
 5687:             //    // Find the bin at which the current vertical level is
 5688:             //    while (kbin<nbins_veg_vert) {
 5689:             //       const double zn = node->z[kbin];
 5690:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5691:             //          break;
 5692:             //       } // if
 5693:             //       kbin++;
 5694:             //    } // while
 5695:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5696: 
 5697:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5698:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5699:                
 5700:             //    // Linear interpolation of the vegetation parameters
 5701:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5702:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5703:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5704:             // } // if rl10
 5705: 
 5706:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5707: 
 5708:          } // for k
 5709: 
 5710: 
 5711:       } else { // Ganthy (iveg==2)
 5712:       //  Modify canopy height, diameter, and density
 5713: 
 5714:          // Make sure there is vegetation on this node
 5715:          if (node->veg_h_unbent > 0.0) {
 5716:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5717: 
 5718:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5719:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5720:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5721: 
 5722:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5723:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5724:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5725:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5726:          } // if veg_h_unbent
 5727: 
 5728:          for (int k = 0; k < nvrt; k++) {
 5729:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5730:          } // for k
 5731:       
 5732: 
 5733:       } // if iveg
 5734:      
 5735: 
 5736:       // Compute vertical mean of veg_alpha3D
 5737:       if (iveg != 0) {
 5738:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5739:          double sum1=0.0;
 5740:          double sum2=0.0;
 5741:          // Integrate over each level under the canopy...
 5742:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5743:             const double Dz = node->Dz(k);
 5744: 
 5745:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5746:             sum2 += Dz;
 5747: 
 5748:          } // for k
 5749:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5750:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5751: 
 5752:       } // if iveg
 5753: 
 5754:    }
 5755: 
 5756:    __global__ void computeVegetationAndDragParameters(void) {
 5757:       // Computes the vegetation and drag model parameters:
 5758:       // chi, \tilde\chi, beta, \breve{H}
 5759:       
 5760:       SIDE(side);
 5761: 
 5762:       side->hhat = 0.0;
 5763:       side->chi2 = 0.0;
 5764:       side->chi = 0.0;
 5765:       side->veg_c2 = 0.0;
 5766:       side->veg_beta = 0.0;
 5767: 
 5768:       if (side->isDry) return;
 5769: 
 5770:       const double htot = side->htot2();
 5771:       const int    kb   = side->kb;
 5772: 
 5773:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5774: 
 5775:       const double veg_h     = side->veg_h();
 5776:       const double veg_nv    = side->veg_nv();
 5777:       const double veg_c     = side->veg_c();
 5778:       const double veg_beta  = side->veg_beta;
 5779:       const double veg_alpha = side->veg_alpha_vert_mean();
 5780: 
 5781:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5782:       // Velocity magnitude at the bottom level
 5783:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5784:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5785:       side->chi2 = side->Cd()*vmag1;
 5786:       side->chi  = side->chi2;
 5787: 
 5788:       if constexpr(iveg != 0) {
 5789:          const Node *n1 = side->n1;
 5790:          const Node *n2 = side->n2;
 5791:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5792:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5793:       }
 5794: 
 5795:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5796: 
 5797:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5798:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5799:       double magUa = 0.0;
 5800:       if constexpr(iveg != 0) {
 5801:          if (side->is3D() && veg_h > 0.0) {
 5802:             // 3D wet side with veg...
 5803: 
 5804:             double magUa = 0.0;
 5805:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5806:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5807: 
 5808:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5809:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5810:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5811: 
 5812:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5813:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5814: 
 5815:                   // Velocity magnitude at the bottom (l) of the level
 5816:                   const double ul = length(side->u2[k]);
 5817: 
 5818:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5819:                   magUa += Dz*0.5*(uh + ul);
 5820: 
 5821:                } // if HasVegetation
 5822:             } // for k
 5823:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5824: 
 5825:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5826:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5827:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5828:                const double zCpy = side->zTopCanopy();
 5829:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5830:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5831:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5832:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5833:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5834:             } // if isSubmerged
 5835:          } // if is3D
 5836:       } // if iveg   
 5837: 
 5838:       // Computes the friction modified depth, \breve{H} in notes
 5839:       if (side->is2D()) { // 2D
 5840: 
 5841:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5842:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5843: 
 5844:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5845: 
 5846:          side->hhat = htot*htot/fricH; 
 5847: 
 5848:       } else { // 3D
 5849:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5850: 
 5851:          if constexpr(iveg != 0) {
 5852:             
 5853:             if (side->isSubmerged()) { 
 5854:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5855:                side->hhat -= veg_c*Hhat_alpha;
 5856: 
 5857:             } else { // Emergent
 5858:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5859:             }
 5860:          } // if iveg
 5861: 
 5862:          // Enforce positivity for 3D model
 5863:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5864:       } // if 3D
 5865: 
 5866:    }
 5867: 
 5868: 
 5869: 
 5870:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5871:    // Computes the density gradient between two elements, e1 and e2.
 5872:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5873:    // zero in the direction normal to the side. 
 5874:    // 
 5875:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5876:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5877:    //
 5878:    // Input:
 5879:    //    e1: Element
 5880:    //    e2: Neighbor element (or nullptr if boundary)
 5881:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5882:    //    k: Index of the half-level at which the density is interpolated
 5883:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5884:    // 
 5885:    // Output:
 5886:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5887:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5888: 
 5889:       if (e2 == nullptr || e2->isDry) {
 5890:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5891: 
 5892:          Side *side = e1->sides[j];
 5893:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5894:                  
 5895:          if constexpr(ics == 1) {
 5896:             vec = side->n; // Normal vector to the side
 5897:          } else {
 5898:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5899:             // IMPLEMENT THIS XXXXXX
 5900:             // !replace with xel, yel?
 5901:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5902:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5903:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5904:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5905:          } //ics
 5906:                    
 5907:          diffRho = 0.0;
 5908: 
 5909:       } else { //internal and wet
 5910:          if constexpr(ics==1) {
 5911:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5912: 
 5913:             // Vector from e1 to e2
 5914:             vec = e2->center - e1->center;
 5915: 
 5916:          } else { 
 5917:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5918:             // Remember that elem->center is in global coordinates
 5919:             // IMPLEMENT THIS XXXXXX
 5920:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5921:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5922:             //                   alow(j)=xctr2
 5923:             //                   bdia(j)=yctr2
 5924:          } // ics
 5925: 
 5926:          diffRho = rho2 - e1->demeanedDensity(k);
 5927:       }
 5928: 
 5929:    }
 5930: 
 5931:    __global__ void computeDensityCubicSplines(void) {
 5932:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5933: 
 5934:       ELEM(elem);
 5935: 
 5936:       if (elem->isDry) return;
 5937: 
 5938:       const int kb = elem->kb;
 5939: 
 5940:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5941:       if (elem->is2D()) {
 5942:          // In the 2D case, the density is constant at the prism level. 
 5943:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5944:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5945:       } else { //3D
 5946: 
 5947:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5948:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5949:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5950:          ///// XXXX CHECK INDICES!!!!!
 5951:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5952:       } // 2D/3D
 5953: 
 5954:    }
 5955: } // extern "C"
 5956: 
 5957: 
 5958: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5959: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5960: 
 5961:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5962: 
 5963:    const int kb  = elem->kb;
 5964:    const int kb2 = elem2->kb;
 5965: 
 5966:    // z-coordinate of prism of elem
 5967:    const double zp = elem->z_prism(k);
 5968: 
 5969:    double rho = 0.0;
 5970: 
 5971:    if (elem2->is2D()) {
 5972:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5973: 
 5974:    } else {  // 3D
 5975: 
 5976:       // eta_min may be < zmax
 5977:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5978:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5979: 
 5980:       // (Extrapolate density below bottom, we will fix it later)
 5981:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5982:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5983:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5984:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5985:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5986:    } // 2D/3D
 5987:      
 5988: 
 5989:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5990:    // Now we need to fix it.
 5991:    if (elem->z[k] < elem2->z[kb2]) {
 5992:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5993: 
 5994:       // There are two methods to adjust the density at the bottom of the element.
 5995:       // iunder_deep=0: 
 5996:       const double depth1 = abs(elem->z[kb]); // larger depth
 5997: 
 5998:       if (iunder_deep==0) {
 5999: 
 6000:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6001: 
 6002:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6003: 
 6004:       } else { // iunder_deep != 0
 6005: 
 6006:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6007: 
 6008:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6009: 
 6010:          //   Demeaned density at the same z coordinate as
 6011:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6012:          }
 6013: 
 6014:       } // if iunder_deep
 6015:    } // if elem->z[kb] < elem2->z[kb]
 6016: 
 6017:    return rho;
 6018: }
 6019: 
 6020: 
 6021: extern "C" {
 6022:    __global__ void computeDensityGradient(void) {
 6023: 
 6024:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6025:       if constexpr(ibc != 0) return;
 6026: 
 6027:          // Compute the horizontal density gradient at each element.
 6028:       // It works in two steps:
 6029:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6030:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6031:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6032:       //             gradRho.r1 = rho1 - rho0
 6033:       //             gradRho.r2 = rho2 - rho0
 6034:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6035:       // 
 6036:       //  NOTE: We use de-meaned densities.
 6037: 
 6038:       ELEM(elem);
 6039: 
 6040:       if (elem->isDry) return;
 6041: 
 6042:       const int kb  = elem->kb;
 6043:       const int i34 = elem->i34;
 6044: 
 6045:       for (int k = kb + 1; k < nvrt; k++) {
 6046:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6047:          //             gradRho.r1 = rho1 - rho0
 6048:          //             gradRho.r2 = rho2 - rho0
 6049:          int icount = 0;
 6050:          double sumRx = 0.0;
 6051:          double sumRy = 0.0;
 6052:          for (int j1=0; j1<i34; j1++) { 
 6053: 
 6054:             const int j2 = elem->nxq(j1 + 1);
 6055: 
 6056:             // Pairs of consecutive neighbor elements of elem
 6057:             const Element *e1 = elem->nghbElems[j1];
 6058:             const Element *e2 = elem->nghbElems[j2];
 6059: 
 6060:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6061:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6062:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6063: 
 6064:             // Compute the density difference and the vector from elem to e1 and e2
 6065:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6066:             double diffRho1, diffRho2;
 6067:             Vector2 vec1, vec2;
 6068:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6069:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6070: 
 6071:             const double rl1 = length(vec1);
 6072:             const double rl2 = length(vec2);
 6073:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6074: 
 6075:             const double delta = cross(vec1, vec2);
 6076:             const double sintheta = abs(delta)/(rl1*rl2);
 6077: 
 6078:             // To avoid problems, avoid elements with small angle between vectors
 6079:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6080:             const bool validEq = (sintheta > sin_one_deg);
 6081: 
 6082:             if (validEq) {
 6083:                // Solve the system of equations to get the density gradient at elem
 6084:                icount++;
 6085:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6086:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6087:                sumRx += Rx;
 6088:                sumRy += Ry;
 6089:             }
 6090:          } // for j1
 6091: 
 6092:          // Compute the average density gradient at elem
 6093:          if (icount==0) {
 6094:            // Bad mesh quality; bail out with 0 b-cc
 6095:            elem->gradRho[k] = {0.0, 0.0};
 6096:          } else {
 6097:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6098:          }
 6099: 
 6100:       } // for k
 6101: 
 6102:    }
 6103: 
 6104:    __global__ void computeBaroclinicTerm(void) {
 6105:    // Computes the baroclinic term at sides (at half levels).
 6106:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6107:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6108: 
 6109:       if (ibc == 1) return;
 6110: 
 6111:       SIDE(side);
 6112: 
 6113:       if (side->isDry) return;
 6114: 
 6115:       const Element *e1 = side->elems[0];
 6116:       const Element *e2 = side->elems[1]; 
 6117:       const int kb = side->kb;
 6118:       
 6119:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6120: 
 6121:       // interpolates vertically the density gradient of the two elements at the half level/
 6122: 
 6123:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6124:       int k2 = max(kb, nvrt / 2);
 6125: 
 6126:       // Starts the integration at the surface and goes down to the bottom
 6127:       side->bcc[nvrt-1] = {0.0, 0.0};
 6128:       for (int k = nvrt - 2; k >= kb; k--) {
 6129:       // For each prism level (from surface to bottom)...
 6130: 
 6131:          // For both elements, interpolate density gradient at the side's half level.
 6132:          // The gradient at the side is the average of the gradients at the elements.
 6133:          // w1, w2 are used to take into account boundary sides, with just one element.
 6134:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6135:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6136:          const double wsum = w1 + w2;
 6137:          w1 = w1/wsum;
 6138:          w2 = w2/wsum;
 6139:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6140: 
 6141:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6142:          Vector2 gradRho = {0.0, 0.0};
 6143:          if (e1 != nullptr && k > kb) {
 6144:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6145:             
 6146:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6147:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6148:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6149: 
 6150:             // Grad(rho) vertically interpolated at the side's half level
 6151:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6152: 
 6153:             // Projects the element density gradient to the side frame if needed.
 6154:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6155: 
 6156:             // Adds the contribution of the density gradient at the side's half level
 6157:             gradRho += gradRho1*w1;
 6158:          }      
 6159:          if (e2 != nullptr && k > kb) {
 6160:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6161:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6162:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6163:             
 6164:             // Grad(rho) vertically interpolated at the side's half level
 6165:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6166: 
 6167:             // Projects the element density gradient to the side frame if needed.
 6168:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6169: 
 6170:             // Adds the contribution of the density gradient at the side's half level
 6171:             gradRho += gradRho2*w2;
 6172:          }
 6173: 
 6174:          
 6175:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6176:          // multiplied by -rampbc*(g/rho0) 
 6177:          const double grav3 = side->grav3();
 6178:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6179: 
 6180:       } // for
 6181: 
 6182:    }
 6183: 
 6184: 
 6185: 
 6186:    __global__ void computeHorGradientAtSide(void) {
 6187: 
 6188:       // Compute the horizontal density gradient at each element.
 6189:       // It works in two steps:
 6190:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6191:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6192:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6193:       //             gradRho.r1 = rho1 - rho0
 6194:       //             gradRho.r2 = rho2 - rho0
 6195:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6196:       // 
 6197:       //  NOTE: We use de-meaned densities.
 6198: 
 6199:       SIDE(side);
 6200: 
 6201: 
 6202:       if (side->isDry) return;
 6203: 
 6204:       // Computes the gradient of the variables at the side center.
 6205:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6206:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6207:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6208: 
 6209:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6210:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6211:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6212:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6213: 
 6214:    }
 6215: 
 6216: 
 6217:    __global__ void solveMomentumEquations(double time) {
 6218: 
 6219:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6220:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6221: 
 6222:       SIDE(side);
 6223: 
 6224:       if (side->isDry) 
 6225:       {
 6226:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6227: 
 6228:          return;
 6229:       }
 6230: 
 6231:       const Node *n1 = side->n1;
 6232:       const Node *n2 = side->n2;
 6233: 
 6234:       const int kb = side->kb;
 6235: 
 6236:       const double veg_h = side->veg_h();
 6237:       const double grav3 = side->grav3();
 6238: 
 6239:       if (side->is2D()) {
 6240:          // Remember: Do not use htot2, which is updated.
 6241:          const double htot = side->htot1();
 6242:          const double hhat = side->hhat;
 6243: 
 6244:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6245: 
 6246:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6247:          const Vector2 tau2 = side->tau();
 6248: 
 6249:          // hat_gam has units of m/s
 6250: 
 6251:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6252:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6253:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6254: 
 6255:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6256: 
 6257: 
 6258:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6259: 
 6260:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6261: 
 6262:       }
 6263:       else { // 3D
 6264: 
 6265:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6266:          // 
 6267:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6268:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6269:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6270:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6271:          // k+1 and k.
 6272: 
 6273: 
 6274:          const int ndim = nvrt - kb;
 6275:          const double zTopCanopy = side->zTopCanopy();
 6276: 
 6277:          // Initialize the tridiagonal system
 6278:          for (int k = kb + 1; k < nvrt; k++) {
 6279:             
 6280:             const int kin = k - (kb + 1);
 6281: 
 6282:             // Vertical viscosity at the face center
 6283:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6284: 
 6285:  
 6286:             alow[kin] = 0.0;
 6287:             cupp[kin] = 0.0;
 6288:             bdia[kin] = 0.0;
 6289: 
 6290:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6291:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6292: 
 6293:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6294:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6295:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6296: 
 6297:             // First part: layers k, k+1
 6298:             if (k < nvrt - 1) {
 6299:                              
 6300:                if constexpr(iveg != 0) {
 6301: 
 6302:                   // If there is vegetation at this level...
 6303:                   if (zTopCanopy > side->zc[k]) {
 6304:                      // If the canopy is above the k layer...
 6305:                      
 6306:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6307:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6308:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6309:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6310: 
 6311:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6312:                      const double vmag2 = length(ut2);
 6313:                      const double vmag1 = length(side->u2[k]);
 6314:                      const double vmag = 0.5*(vmag1 + vmag2);
 6315:                      
 6316:                      // Computes the vegetation alpha at the face center
 6317:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6318: 
 6319:                      cff1 += veg_alpha_sd*dt*vmag;
 6320: 
 6321:                   } // if (zTopCanopy
 6322:                } // if iveg
 6323: 
 6324:                const double dzz = side->Dz(k + 1);
 6325:                const double tmp = dt*dfz/dzz;
 6326:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6327: 
 6328:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6329:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6330:             }
 6331: 
 6332: 
 6333:             // Second part: layers k-1, k
 6334:             if (k > kb + 1) {
 6335: 
 6336:                double cff1 = 1.0; //init \bar{c^k}
 6337: 
 6338:                if constexpr(iveg != 0) {
 6339:                   // If there is vegetation at this level...
 6340:                   if (zTopCanopy > side->zc[k-1]) {
 6341:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6342:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6343: 
 6344:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6345: 
 6346:                      const double vmag2 = length(ut2);
 6347:                      const double vmag1 = length(side->u2[k-1]);
 6348:                      const double vmag = 0.5*(vmag1 + vmag2);
 6349: 
 6350:                      // Computes the vegetation alpha at the face center
 6351:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6352:                      cff1 += veg_alpha_sd*dt*vmag;
 6353:                   } // if zTopCanopy
 6354: 
 6355:                } // if iveg
 6356: 
 6357:                const double dzz = side->Dz(k);
 6358:                const double tmp = dt*dfz/dzz;
 6359:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6360: 
 6361:                alow[kin] += cff1*dzz/6.0 - tmp;
 6362:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6363: 
 6364:             } else { // Bottom boundary
 6365:                // This occurs at the bottom, where the bottom drag is applied.
 6366: 
 6367:                bdia[kin] += dt*side->chi2; // XXXX
 6368: 
 6369:             } // if (k > kb + 1)
 6370: 
 6371: 
 6372:          } // for (int k
 6373: 
 6374: 
 6375: 
 6376:          // Computes the RHS.
 6377:          // -----------------
 6378: 
 6379:          //	BC to be imposed at the end.
 6380: 
 6381:          const Vector2 gradETP  = side->gradETP;
 6382:          const Vector2 gradPr   = side->gradPr;
 6383:          const Vector2 gradEta1 = side->gradEta1;
 6384:          const Vector2 gradEta2 = side->gradEta2;
 6385: 
 6386:          const Vector2 *btu = side->btu;
 6387:          const Vector2 *u2  = side->u2;
 6388:          const double coriolis = side->coriolis;
 6389:          const Vector2 *nuGradU = side->nuGradU;
 6390: 
 6391:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6392:          for (int k = kb + 1; k < nvrt; k++) {
 6393:             const int kin = k - kb - 1;
 6394: 
 6395:             const double dz_0 = side->Dz(k);
 6396:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6397: 
 6398:             rrhs[kin] = {0.0, 0.0};
 6399:             double dz = 0.0;
 6400: 
 6401:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6402:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6403:             if (k < nvrt  ) dz += dz_1;
 6404:             if (k > kb + 1) dz += dz_0;
 6405: 
 6406:             // Elevation gradient, atmospheric pressure and tidal potential
 6407:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6408: 
 6409:             // Coriolis, advection, wind stress, and horizontal viscosity
 6410:             if (k < nvrt - 1) {
 6411: 
 6412: 
 6413:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6414:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6415:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6416:                                                 
 6417: 
 6418:                //diff stress tensors 1006
 6419:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6420:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6421:                   assert(false && "Not implemented: itur == 5");
 6422:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6423:                }
 6424:                // else assert(false && "itur # Not implemented");
 6425: 
 6426:             } else { // k == nvrt - 1 SURFACE
 6427:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6428:                const Vector2 tau2 = side->tau();
 6429: 
 6430:                rrhs[kin] += dt*tau2;          
 6431: 
 6432:             } // if k<nvrt
 6433: 
 6434: 
 6435:             if (k > kb + 1) {
 6436:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6437:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6438:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6439: 
 6440:                // diff stress tensors 1006
 6441:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6442:                   assert(false && "Not implemented: itur == 5");
 6443:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6444:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6445:                }
 6446:                // else assert(false && "itur # Not implemented");
 6447: 
 6448: 
 6449:             } // if k>kbs + 1
 6450: 
 6451:             // Baroclinic
 6452:             Vector2 *bcc = side->bcc;
 6453:             if constexpr(ibc == 0) {
 6454:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6455:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6456: 
 6457:             } // if ibc==0
 6458: 
 6459:          } // k=kb + 1,nvrt
 6460: 
 6461: 
 6462:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6463: 
 6464:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6465:             const int kin = k - kb - 1;
 6466:    
 6467:             // Velocity is always clamped to maximum values
 6468:             side->u2[k] = clampVelocity(soln[kin]);
 6469:          } // k
 6470: 
 6471:       } // if side->is2D()
 6472:       
 6473: 
 6474:       // Impose velocity boundary condition at the bottom
 6475:       if constexpr(imm == 2) { // 3D bed deformation model
 6476:          double dep;
 6477:          Vector2 vel;
 6478: 
 6479:          assert(false && "Not implemented: imm == 2");
 6480:          //update_bdef(time, x0, y0, dep, vel);
 6481:          // side->u2[kb] = vel;
 6482: 
 6483:       } else { // imm = 0 or 1
 6484:          if (side->Cd() == 0.0) {
 6485:             side->u2[kb] = side->u2[kb + 1];
 6486: 
 6487:          } else if (side->is3D()) { // 3D no slip bottom   
 6488:             side->u2[kb] = {0.0, 0.0};
 6489: 
 6490:          }
 6491:           
 6492:       } // if imm
 6493: 
 6494:       // The velocities below the bottom level are set to zero
 6495:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6496: 
 6497: 
 6498:    }
 6499: 
 6500: 
 6501:    __global__ void applyMomentumBC(void) {
 6502: 
 6503:       SIDE_BND(sideBnd);
 6504: 
 6505:       Side *side = sideBnd->side;
 6506:       const BoundarySegment *segment = sideBnd->segment;
 6507:       const Node *n1 = side->n1;
 6508:       const Node *n2 = side->n2;
 6509: 
 6510:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6511: 
 6512:       const bool isLand = segment->isLand;
 6513:       const int ifltype = segment->ifltype;
 6514: 
 6515:       const int kb = side->kb;
 6516: 
 6517: 
 6518:       if (!isLand && ifltype != 0) {
 6519:          const Vector2 *ubc = sideBnd->ubc;
 6520:   
 6521:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6522:             
 6523:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6524:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6525: 
 6526:             if (ifltype == -1) {
 6527:                // Flather 1
 6528: 
 6529:                const double depth = side->depth();
 6530: 
 6531:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6532: 
 6533:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6534: 
 6535:                side->u2[k] = vnorm*side->n;
 6536: 
 6537:             } else if (ifltype == -2) { // Discharge
 6538: 
 6539:                const double eta1 = side->eta1();
 6540:                const double eta2 = side->eta2();
 6541:                const double htot = side->htot2();
 6542: 
 6543:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6544:                assert(false && "Not implemented: Discharge bc");
 6545:                // const double dischrg = discharge(eta1);
 6546:                const double dischrg = 0.0; // XXX REMOVE
 6547:                
 6548: 
 6549:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6550: 
 6551:                const double vnorm = dischrg*eta2/htot;
 6552: 
 6553:                side->u2[k] = vnorm*side->n;
 6554: 
 6555:             }
 6556:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6557:                const double vnorm = dot(side->u2[k], side->n);
 6558: 
 6559:                double rat;
 6560:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6561:                else              rat = segment->vobc2; // outgoing
 6562: 
 6563:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6564: 
 6565:             }
 6566:             else { // not Flather or 3D radiation
 6567:                side->u2[k] = ubc[k];
 6568: 
 6569:             } // if (segment->ifltype...
 6570: 
 6571:          }
 6572: 
 6573:       }
 6574:       else if (isLand) { // if it is land boundary side
 6575: 
 6576:          if constexpr(islip == 0) { // free slip
 6577: 
 6578:             for (int k = kb; k < nvrt; k++) {
 6579: 
 6580:                const Vector2 t = side->t();
 6581:                const Vector2 n = side->n;
 6582: 
 6583:                double vnorm = 0.0; // for most cases
 6584:                const double vtan = dot(side->u2[k], t);
 6585:                
 6586:                side->u2[k] = vtan*t - vnorm*n;
 6587: 
 6588:             }
 6589: 
 6590:          } else { // no slip
 6591:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6592: 
 6593:          }
 6594:       } // if (side segment type...
 6595: 
 6596:    }
 6597: 
 6598: 
 6599:    __global__ void shapiroFilter1(void) {
 6600:       // First step of the Shapiro filter (normally used if indvel<=0)
 6601:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6602: 
 6603:       SIDE(side);
 6604: 
 6605:       // Only internal wet sides are processed
 6606:       if (side->isDry || !(side->isInternal())) return;
 6607: 
 6608:       const int kb = side->kb;
 6609: 
 6610:       for (int mm = 0; mm < niter_shap; mm++) {
 6611: 
 6612:          for (int k = kb + 1; k < nvrt; k++) {
 6613:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6614:             Vector2 suru = {0.0, 0.0};
 6615: 
 6616:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6617: 
 6618:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6619: 
 6620:                int kin = k;
 6621:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6622:                
 6623:                // Get the velocity at the neighbor's side.
 6624:                Vector2 nSideU2 = nSide->u2[kin];
 6625: 
 6626:                // Projects the velocity to the current side frame if needed.
 6627:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6628: 
 6629:                suru += nSideU2;
 6630:             }
 6631: 
 6632:             // Reusing bcc as a temporary array to store the suru values.
 6633:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6634: 
 6635:          }
 6636:       }
 6637:    }
 6638: 
 6639:    __global__ void shapiroFilter2(void) {
 6640:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6641: 
 6642:       SIDE(side);
 6643: 
 6644: 
 6645:       if (side->isDry || !(side->isInternal())) return;
 6646: 
 6647:       const int kb = side->kb;
 6648: 
 6649:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6650: 
 6651:       if (side->is2D()) {
 6652:          side->u2[kb + 1] = side->bcc[kb + 1];
 6653:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6654: 
 6655:       } else {
 6656:          // 3D
 6657:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6658:          
 6659:       }
 6660: 
 6661:    }
 6662: 
 6663: 
 6664:    __global__ void ul0UpdateZCoords(void) {
 6665:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6666:       
 6667:       NODE(node);      
 6668: 
 6669: 
 6670:       if (false) { //node->isDry) { XXXXXXX
 6671: 
 6672:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6673: 
 6674:          if constexpr(ivcor != 1) node->kb = 0;
 6675: 
 6676:       } else {
 6677: 
 6678:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6679:          node->updateKb();
 6680: 
 6681:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6682: 
 6683:       }
 6684: 
 6685:       // We use the temp.b field to store the previous state of isDry.
 6686:       node->tmp.b = node->isDry;
 6687: 
 6688:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6689:       node->isDry = true;
 6690: 
 6691:    }
 6692: 
 6693:    __global__ void ul0ComputeDryElements(void)
 6694:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6695:    {
 6696:       ELEM(elem);
 6697: 
 6698:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6699: 
 6700:       elem->kb = 0;
 6701: 
 6702:       if (elem->isDry) return;
 6703: 
 6704: 
 6705:    //    if(elem->isDry2()) { // XXXX
 6706:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6707:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6708:    //        call parallel_abort(errmsg)
 6709:    //    }
 6710: 
 6711:       const Node *n1 = elem->nodes[0];
 6712:       const Node *n2 = elem->nodes[1];
 6713:       const Node *n3 = elem->nodes[2];  
 6714:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6715: 
 6716:       // Computes element's kb as the minimum of the nodes' kb.
 6717:       const int kb1 = n1->kb;
 6718:       const int kb2 = n2->kb;
 6719:       const int kb3 = n3->kb;
 6720:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6721: 
 6722: 
 6723:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6724: 
 6725: 
 6726:       // Computes the element z as the mean of the nodes z.
 6727:       for (int k = elem->kb; k < nvrt; k++) {
 6728: 
 6729:          // Compute the element z as the mean of the nodes z.
 6730:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6731:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6732:          elem->z[k] /= elem->i34;
 6733: 
 6734:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6735:       }
 6736:                   
 6737:    }
 6738: 
 6739:    __global__ void ul0ComputeDryNodes(void)
 6740:    // Updates node's isDry based on the elements' isDry. 
 6741:    {
 6742:       NODE(node);
 6743: 
 6744:       node->isDry = true;
 6745: 
 6746:       // A node is wet if at least one of the elements sharing it is wet.
 6747:       for (int j = 0; j < node->numElements; j++) {
 6748:          const Element *elem = node->elements[j];
 6749:          if (!elem->isDry) {
 6750:             node->isDry = false;
 6751:             break;
 6752:          }
 6753:       }
 6754: 
 6755:        
 6756:    }
 6757: 
 6758: 
 6759:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6760:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6761:    // node->tmp.b is true if the node was previously dry.
 6762:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6763:    {
 6764:       NODE(node);
 6765:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6766: 
 6767:       // Avoid this the first time step.
 6768:       if (it == iths) return;  
 6769: 
 6770:       const bool wasDry = node->tmp.b;
 6771: 
 6772: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6773: 
 6774:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6775: 
 6776:          for (int k=0; k < nvrt; k++) {
 6777: 
 6778:             Vector3 utmp={0.0, 0.0, 0.0};
 6779: 
 6780:             double ttmp=0.0;
 6781:             double stmp=0.0;
 6782:             int icount=0;
 6783:             for (int j = 0; j < node->numNodes; j++) {
 6784: 
 6785:                const Node *nbrNode = node->nodes[j];
 6786:                
 6787:                const bool wasNbrDry = nbrNode->tmp.b;
 6788: 
 6789:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6790:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6791: 
 6792:                   icount++;
 6793: 
 6794:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6795:                   utmp += nbrNode->uvw2(k);
 6796:                   
 6797:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6798:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6799:                }
 6800:             }
 6801: 
 6802:             if (icount > 0) {
 6803:                const double inv_icount = 1.0/icount;
 6804:                utmp = inv_icount*utmp;
 6805:                node->u2[k]     = {utmp.x, utmp.y};
 6806:                node->w2[k]     = utmp.z;
 6807:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6808:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6809:             } else {
 6810:                node->u2[k] = {0.0, 0.0};
 6811:                node->w2[k] = 0.0;
 6812:                // Initialize tracers to 0.0??? XXXXX
 6813:             }
 6814:          }
 6815:       }
 6816:    }
 6817: 
 6818:   
 6819:    
 6820: 
 6821: 
 6822:    __global__ void ul0UpdateSides(int it, int iths) {
 6823:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6824:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6825:    // The dryness of the sides is updated in ul0UpdateSides2.
 6826: 
 6827:       SIDE(side);
 6828: 
 6829:       // A side is wet if and only if at least one of its elements is wet.
 6830:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6831:  
 6832:       const Node *n1 = side->n1;
 6833:       const Node *n2 = side->n2;
 6834:      
 6835:       const int kb1 = n1->kb;
 6836:       const int kb2 = n2->kb;
 6837: 
 6838:       side->kb = 0; // default when dry
 6839: 
 6840:       if (isWet) {
 6841: 
 6842:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6843: 
 6844:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6845: 
 6846:          side->kb = min(kb1, kb2);
 6847: 
 6848:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6849: 
 6850:          for (int k = side->kb; k < nvrt; k++) {
 6851:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6852: 
 6853:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6854: 
 6855:             // Compute velocity for re-wetted sides 
 6856:             if ((it != iths) && (side->isDry && isWet)) {
 6857: 
 6858:                Vector2 utmp={0.0, 0.0};
 6859: 
 6860:                int icount=0;
 6861: 
 6862:                // For all the sides on the two elements that share this side
 6863:                for (int j = 0; j < 2; j++) {
 6864:                   const Element *elem = side->elems[j];
 6865:                   if (elem == nullptr) continue;
 6866: 
 6867:                   for (int jj=0; jj < elem->i34; jj++) {
 6868:                      const Side *nSide = elem->sides[jj];
 6869:                      if (nSide->isDry) continue;
 6870: 
 6871:                      icount++;
 6872:                      utmp += nSide->u2[k];  
 6873:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6874:                   }
 6875:                }
 6876:                   
 6877:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6878:                if (icount > 0)  side->u2[k] = utmp/icount;
 6879:                else             side->u2[k] = {0.0, 0.0};
 6880:                   
 6881:             } // if ((it != iths) && (side->isDry && isWet))
 6882: 
 6883:          } // for k
 6884: 
 6885:       } // if isWet 
 6886:       
 6887: 
 6888: 
 6889:    }
 6890: 
 6891:    __global__ void ul0UpdateSides2(void) {
 6892:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6893:    
 6894:          SIDE(side);
 6895:    
 6896:          const Element *e1 = side->elems[0];
 6897:          const Element *e2 = side->elems[1];
 6898: 
 6899:          // A side is wet if and only if at least one of its elements is wet.
 6900:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6901: 
 6902:          // Update the side's dryness
 6903:          side->isDry = !isWet;
 6904: 
 6905:    }
 6906: 
 6907: 
 6908:    __global__ void zeroNodalVelocities(void) {
 6909:       NODE(node);
 6910: 
 6911:       for (int k = 0; k < nvrt; k++) {
 6912:          node->u2[k]   = {0.0, 0.0};
 6913:          node->w2[k]   = 0.0;
 6914:          node->utmp[k] = {0.0, 0.0};         
 6915:       }
 6916:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6917:    }
 6918:  
 6919: 
 6920:    __global__ void computeNodalVerticalVelocities1(void) {
 6921:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6922:    // Adds the element's vertical velocity times the element's area.
 6923:       ELEM(elem);
 6924: 
 6925:       for (int j = 0; j < elem->i34; j++) {
 6926:          Node *node = elem->nodes[j];
 6927: 
 6928:          for (int k = node->kb; k < nvrt; k++) {
 6929:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6930:          }
 6931:          atomicAdd(&(node->tmp.d), elem->area);
 6932:       }
 6933:    }
 6934: 
 6935:    __global__ void computeNodalVerticalVelocities2(void) {
 6936:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6937:    // Divides by the total area of the elements sharing the    node.
 6938:       NODE(node);
 6939: 
 6940: 
 6941:       const double invArea = 1.0 / node->tmp.d;
 6942:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6943: 
 6944:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6945:    }
 6946: 
 6947: 
 6948:    __global__ void computeNodalHorizontalVelocities1(void) {
 6949: 
 6950:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6951: 
 6952:       ELEM(elem);
 6953: 
 6954:       if (elem->isDry) return;
 6955: 
 6956:       const int kb = elem->kb;
 6957:       const bool isTri = elem->isTri();
 6958: 
 6959:       if constexpr(indvel <= 0) {
 6960:          // Assuming discontinous hvel.
 6961: 
 6962:          if (isTri) { // For triangles
 6963:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6964:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6965:             #pragma unroll
 6966:             for (int j = 0; j < 3; j++) {
 6967:                // For every node of the triangle...
 6968:                Node *node = elem->nodes[j];
 6969: 
 6970:                if (node->isDry) continue;
 6971: 
 6972:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6973:                const Side *s2 = elem->sides[(j + 1) % 3];
 6974:                const Side *s3 = elem->sides[(j + 2) % 3];
 6975: 
 6976:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6977: 
 6978:                atomicAdd(&(node->tmp.i), 1);
 6979: 
 6980:                for (int k = kb; k < nvrt; k++)  {
 6981:                   Vector2 s1u2 = s1->u2[k];
 6982:                   Vector2 s2u2 = s2->u2[k];
 6983:                   Vector2 s3u2 = s3->u2[k];
 6984: 
 6985:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6986:                   if constexpr(ics == 2) {
 6987:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6988:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6989:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6990:                   }
 6991: 
 6992:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 6993:                   u = clampVelocity(u);
 6994:                   atomicAdd(&(node->utmp[k].x), u.x);
 6995:                   atomicAdd(&(node->utmp[k].y), u.y);
 6996: 
 6997:                }
 6998: 
 6999:             }
 7000:          }
 7001:          else { // For quads
 7002: 
 7003: 
 7004:             // Compute the bilinear coordinates of the center of each diagonal.
 7005:             double xi, eta;
 7006:             double shp13[4], shp24[4];
 7007:             Point2 x0, x1, x2, x3;
 7008:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7009:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7010:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7011: 
 7012:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7013:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7014: 
 7015: 
 7016: 
 7017: 
 7018:             for (int k = kb; k < nvrt; k++) {
 7019: 
 7020:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7021:                Vector2 sideU[4];
 7022:                #pragma unroll
 7023:                for (int j = 0; j < 4; j++) {
 7024:                   Vector2 u = elem->sides[j]->u2[k];
 7025:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7026:                   sideU[j] = u;
 7027:                }
 7028: 
 7029:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7030:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7031: 
 7032:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7033:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7034:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7035:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7036:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7037:                #pragma unroll
 7038:                for (int j = 0; j < 4; j++) {
 7039:                   Node *node = elem->nodes[j];
 7040:                   if (node->isDry) continue;
 7041: 
 7042:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7043:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7044:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7045:                }
 7046:             }
 7047: 
 7048:          }
 7049: 
 7050:       }
 7051:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7052:       
 7053:    }
 7054: 
 7055: 
 7056:    __global__ void computeNodalHorizontalVelocities2(void) {
 7057:       NODE(node);
 7058: 
 7059:       const int nodeCount = node->tmp.i;
 7060: 
 7061:       if (nodeCount == 0) 
 7062:       {
 7063:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7064:          return;
 7065:       }
 7066: 
 7067:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7068:       
 7069:       const int kb = node->kb;
 7070: 
 7071:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7072:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7073:       
 7074:       
 7075:    }   
 7076: 
 7077:  
