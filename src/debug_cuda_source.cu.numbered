 2068: /**
 2069:    Compute the shape coordinates of the point (xt,yt) in the element.
 2070:    @param xt (input): x-coordinate of the point
 2071:    @param shpCoords (output): shape coordinates of the point
 2072:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2073:    @return true if the point is inside the element, false otherwise
 2074: **/
 2075: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2076:                                             bool fixNegshpCoord) const {
 2077: 
 2078:    // Compute the shape coordinates of the point xt in the element.
 2079:    if (i34==3) {
 2080:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2081:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2082:       // and in this case, the pt will be nudged into the element
 2083:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2084:       // from the local frame, so use additional check.
 2085: 
 2086:       Point2 x0, x1, x2;
 2087: 
 2088:       if constexpr(ics==1) {
 2089:          x0 = nodes[0]->p2();
 2090:          x1 = nodes[1]->p2();
 2091:          x2 = nodes[2]->p2();
 2092:       }
 2093:       else // lat/lon
 2094:       {
 2095:          Error("Not implemented yet");
 2096: #ifdef ICS2
 2097:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2098:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2099:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2100: #endif
 2101:       }
 2102: 
 2103:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2104:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2105:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2106:       shpCoords[3] = 0.0;
 2107:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2108: 
 2109:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2110:       // then we fix the negative shape coordinates.
 2111:       if (fixNegshpCoord && tmpmin<=0.0) {
 2112: 
 2113:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2114:          // keeping the sum of the shape coordinates equal to 1.
 2115:          // I have tested and compared the new algorithm with the old one, and they give
 2116:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2117:          // The new algorithm should be faster since it is branchless.
 2118:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2119:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2120:          
 2121:          shpCoords[0] = (shpCoords[0] + a)*b;
 2122:          shpCoords[1] = (shpCoords[1] + a)*b;
 2123:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2124: 
 2125:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2126:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2127:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2128:          }
 2129: 
 2130:          // Update the point coordinates for the new shape coordinates
 2131:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2132:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2133:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2134: 
 2135:       }
 2136: 
 2137:       // Check if the point is inside the element
 2138:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2139:    }
 2140:    else {
 2141:       Error("Not implemented yet");
 2142: #ifdef QUADS
 2143:       // Reproject pt in eframe of nel for ics=2
 2144:       if constexpr(ics==1) {
 2145:          xn2 = xt; 
 2146:          yn2 = yt;
 2147:       }
 2148:       else {
 2149:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2150:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2151:       }
 2152: 
 2153:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2154: #endif
 2155:    }
 2156: 
 2157:    return false;  // Never reached
 2158: 
 2159: }
 2160: 
 2161: 
 2162: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2163: // Convert shape coordinates to cartesian coordinates
 2164: 
 2165:    if (i34 == 3) {
 2166:       // Triangular element
 2167:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2168:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2169:    }
 2170:    else {
 2171:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2172:    }
 2173: 
 2174: }
