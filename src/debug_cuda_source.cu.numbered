 7469:          break;            
 7470:       case (int)VarCode::w:
 7471:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7472:          *sizeType = sizeof(double);
 7473:          break;
 7474:       case (int)VarCode::u:
 7475:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7476:          *sizeType = sizeof(Vector2);
 7477:          break;   
 7478:       case (int)VarCode::U:
 7479:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7480:          *sizeType = sizeof(Vector2);
 7481:          break;
 7482:       case (int)VarCode::ghat:
 7483:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7484:          *sizeType = sizeof(Vector2);
 7485:          break;                        
 7486:       case (int)VarCode::n1:
 7487:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7488:          *sizeType = sizeof(Node);
 7489:          break;
 7490:       case (int)VarCode::n2:
 7491:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7492:          *sizeType = sizeof(Node);
 7493:          break;                   
 7494:       default:
 7495:          *offset = -1;
 7496:    }
 7497: }
