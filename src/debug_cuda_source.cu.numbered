 4315:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4316: 
 4317:       SIDE(side);
 4318: 
 4319: 
 4320:       side->U = {0.0, 0.0}; 
 4321:          
 4322:       if(side->isDry) return;
 4323: 
 4324:       const Node *node1 = side->n1;
 4325:       const Node *node2 = side->n2;
 4326: 
 4327:       // Vertically integrated velocity U (in ll if ics=2)
 4328:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4329:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4330:       }
 4331: 
 4332:    }
 4333: 
 4334:    __global__ void computeBottomDragVegetation(void) {
 4335:       // UNFINISHED. CHECK THIS:
 4336:       // How many kernels are needed? Why so many for loops?
 4337:       // Is the loop on sides needed?
 4338: 
 4339:       NODE(node);
 4340: 
 4341:       const int    kb      = node->kb;
 4342:       const double htot    = node->htot2();
 4343:       const double rough   = node->rough;
 4344: 
 4345: 
 4346:       if (node->isDry) {
 4347:          // Default values for dry nodes
 4348:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4349:          /// XXX CHECK INDICES
 4350:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4351:       }
 4352: 
 4353:       // Compute bottom drag Cd
 4354:       //--------------------------------
 4355: 
 4356:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4357:       if (nchi==1) {
 4358: 
 4359:          bool ltmp = false; // for WBL iteration
 4360: 
 4361:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4362:          // Drag at nodes
 4363:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4364:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4365:         
 4366:          const double rough = node->rough;
 4367:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4368:          if (node->rough == 0.0) {
 4369:             node->Cd = 0.0;
 4370: 
 4371:          } else { //roughness >0 
 4372:             
 4373:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4374:             const double bthick = max(dzb_min, bthick_ori);
 4375: 
 4376:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4377: 
 4378:             double tmp = 1.0/(2.5*log(bthick/rough));
 4379:             node->Cd = tmp*tmp;
 4380: 
 4381:          } // if rough
 4382: 
 4383: 
 4384:          // RECOVER THIS: XXX
 4385:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4386:          // Output warning for WBL if iteration didn't converge
 4387: 
 4388: 
 4389:       } // nchi==1
 4390: 
 4391:       //   Bottom stress in m^2/s^2
 4392:       if (node->rho[kb + 1] >= -98.0)
 4393:       {
 4394:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4395:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4396:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4397:          // !sediment erosion: this part needs more documentation
 4398:       }
 4399: 
 4400:     
 4401:       // Compute vegetation parameters
 4402:       //--------------------------------
 4403: 
 4404:       // SAV constants
 4405:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4406:       constexpr double veg_cfpsi = 0.16;
 4407: 
 4408:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4409:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4410: 
 4411:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4412:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4413:          int kbin = 0; // bin index
 4414:          for (int k = kb; k < nvrt; k++) {
 4415:             // Computes node height above the bottom level
 4416:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4417:             assert(false && "Vertical variation of vegetation not implemented");
 4418: 
 4419:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4420:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4421:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4422:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4423:             // } else {
 4424:             //    // Find the bin at which the current vertical level is
 4425:             //    while (kbin<nbins_veg_vert) {
 4426:             //       const double zn = node->z[kbin];
 4427:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4428:             //          break;
 4429:             //       } // if
 4430:             //       kbin++;
 4431:             //    } // while
 4432:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4433: 
 4434:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4435:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4436:                
 4437:             //    // Linear interpolation of the vegetation parameters
 4438:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4439:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4440:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4441:             // } // if rl10
 4442: 
 4443:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4444: 
 4445:          } // for k
 4446: 
 4447: 
 4448:       } else { // Ganthy (iveg=2)
 4449:       //  Modify canopy height, diameter, and density
 4450: 
 4451:          // Make sure there is vegetation on this node
 4452:          if (node->veg_h_unbent > 0.0) {
 4453:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4454: 
 4455:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4456:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4457:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4458: 
 4459:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4460:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4461:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4462:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4463:          } // if veg_h_unbent
 4464: 
 4465:          for (int k = 0; k < nvrt; k++) {
 4466:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4467:          } // for k
 4468:       
 4469: 
 4470:       } // if iveg
 4471:      
 4472:          
 4473: 
 4474:       // Compute vertical mean of veg_alpha3D
 4475:       if (iveg != 0) {
 4476:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4477:          double sum1=0.0;
 4478:          double sum2=0.0;
 4479:          // Integrate over each level under the canopy...
 4480:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4481:             const double Dz = node->Dz(k);
 4482: 
 4483:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4484:             sum2 += Dz;
 4485: 
 4486:          } // for k
 4487: 
 4488:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4489:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4490: 
 4491:       } // if iveg
 4492: 
 4493:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4494: 
 4495:    }
 4496: 
 4497:    __global__ void computeVegetationAndDragParameters(void) {
 4498:       // Computes the vegetation and drag model parameters:
 4499:       // chi, \tilde\chi, beta, \breve{H}
 4500:       
 4501:       SIDE(side);
 4502: 
 4503:       const double htot = side->htot2();
 4504:       const int    kb   = side->kb;
 4505: 
 4506:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4507: 
 4508:       const double veg_h     = side->veg_h();
 4509:       const double veg_nv    = side->veg_nv();
 4510:       const double veg_c     = side->veg_c();
 4511:       const double veg_beta  = side->veg_beta;
 4512:       const double veg_alpha = side->veg_alpha_vert_mean();
 4513: 
 4514:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4515:       // Velocity magnitude at the bottom level
 4516:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4517:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4518:       side->chi2 = side->Cd()*vmag1;
 4519:       side->chi  = side->chi2;
 4520:       if constexpr(iveg != 0) {
 4521:          const Node *n1 = side->n1;
 4522:          const Node *n2 = side->n2;
 4523:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4524:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4525:       }
 4526: 
 4527:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4528: 
 4529:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4530:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4531:       double magUa = 0.0;
 4532:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4533:          // 3D wet side with veg...
 4534: 
 4535:          double magUa = 0.0;
 4536:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4537:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4538: 
 4539:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4540:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4541:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4542: 
 4543:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4544:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4545: 
 4546:                // Velocity magnitude at the bottom (l) of the level
 4547:                const double ul = length(side->u2[k]);
 4548: 
 4549:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4550:                magUa += Dz*0.5*(uh + ul);
 4551: 
 4552:             } // if HasVegetation
 4553:          } // for k
 4554:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4555: 
 4556:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4557:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4558:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4559:             const double zCpy = side->zTopCanopy();
 4560:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4561:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4562:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4563:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4564:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4565:          } // if isSubmerged
 4566:       } // if iveg   
 4567: 
 4568:       // Computes the friction modified depth, \breve{H} in notes
 4569:       if (side->is2D()) { // 2D
 4570: 
 4571:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4572:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4573: 
 4574:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4575: 
 4576:          side->hhat = htot*htot/fricH; 
 4577: 
 4578:       } else { // 3D
 4579:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4580: 
 4581:          if constexpr(iveg != 0) {
 4582:             
 4583:             if (side->isSubmerged()) { 
 4584:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4585:                side->hhat -= veg_c*Hhat_alpha;
 4586: 
 4587:             } else { // Emergent
 4588:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4589:             }
 4590:          } // if iveg
 4591: 
 4592:          // Enforce positivity for 3D model
 4593:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4594:       } // if 3D
 4595: 
 4596:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4597: 
 4598:         
 4599:    }
 4600: 
 4601: 
 4602: 
 4603:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4604:    // Computes the density gradient between two elements, e1 and e2.
 4605:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4606:    // zero in the direction normal to the side. 
 4607:    // 
 4608:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4609:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4610:    //
 4611:    // Input:
 4612:    //    e1: Element
 4613:    //    e2: Neighbor element (or nullptr if boundary)
 4614:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4615:    //    k: Index of the half-level at which the density is interpolated
 4616:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4617:    // 
 4618:    // Output:
 4619:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4620:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4621: 
 4622:       if (e2 == nullptr || e2->isDry) {
 4623:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4624: 
 4625:          Side *side = e1->sides[j];
 4626:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4627:                  
 4628:          if constexpr(ics == 1) {
 4629:             vec = side->n; // Normal vector to the side
 4630:          } else {
 4631:             // IMPLEMENT THIS XXXXXX
 4632:             // !replace with xel, yel?
 4633:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4634:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4635:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4636:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4637:          } //ics
 4638:                    
 4639:          diffRho = 0.0;
 4640: 
 4641:       } else { //internal and wet
 4642:          if constexpr(ics==1) {
 4643:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4644: 
 4645:             // Vector from e1 to e2
 4646:             vec = toVector2(e2->center - e1->center);
 4647: 
 4648:          } else { 
 4649:             // IMPLEMENT THIS XXXXXX
 4650:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4651:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4652:             //                   alow(j)=xctr2
 4653:             //                   bdia(j)=yctr2
 4654:          } // ics
 4655: 
 4656:          diffRho = rho2 - e1->demeanedDensity(k);
 4657:       }
 4658: 
 4659:    }
 4660: 
 4661:    __global__ void computeDensityCubicSplines(void) {
 4662:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4663: 
 4664:       ELEM(elem);
 4665: 
 4666:       if (elem->isDry) return;
 4667: 
 4668:       const int kb = elem->kb;
 4669: 
 4670:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4671:       if (elem->is2D()) {
 4672:          // In the 2D case, the density is constant at the prism level. 
 4673:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4674:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4675:       } else { //3D
 4676: 
 4677:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4678:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4679:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4680:          ///// XXXX CHECK INDICES!!!!!
 4681:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4682:       } // 2D/3D
 4683: 
 4684:    }
 4685: } // extern "C"
 4686: 
 4687: 
 4688: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4689: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4690: 
 4691:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4692: 
 4693:    const int kb  = elem->kb;
 4694:    const int kb2 = elem2->kb;
 4695: 
 4696:    // z-coordinate of prism of elem
 4697:    const double zp = elem->z_prism(k);
 4698: 
 4699:    double rho = 0.0;
 4700: 
 4701:    if (elem2->is2D()) {
 4702:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4703: 
 4704:    } else {  // 3D
 4705: 
 4706:       // eta_min may be < zmax
 4707:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4708:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4709: 
 4710:       // (Extrapolate density below bottom, we will fix it later)
 4711:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4712:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4713:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4714:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4715:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4716:    } // 2D/3D
 4717:      
 4718: 
 4719:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4720:    // Now we need to fix it.
 4721:    if (elem->z[k] < elem2->z[kb2]) {
 4722:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4723: 
 4724:       // There are two methods to adjust the density at the bottom of the element.
 4725:       // iunder_deep=0: 
 4726:       const double depth1 = abs(elem->z[kb]); // larger depth
 4727: 
 4728:       if (iunder_deep==0) {
 4729: 
 4730:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4731: 
 4732:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4733: 
 4734:       } else { // iunder_deep != 0
 4735: 
 4736:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4737: 
 4738:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4739: 
 4740:          //   Demeaned density at the same z coordinate as
 4741:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4742:          }
 4743: 
 4744:       } // if iunder_deep
 4745:    } // if elem->z[kb] < elem2->z[kb]
 4746: 
 4747:    return rho;
 4748: }
 4749: 
 4750: 
 4751: extern "C" {
 4752:    __global__ void computeDensityGradient(void) {
 4753: 
 4754:          // Compute the horizontal density gradient at each element.
 4755:       // It works in two steps:
 4756:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4757:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4758:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4759:       //             gradRho.r1 = rho1 - rho0
 4760:       //             gradRho.r2 = rho2 - rho0
 4761:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4762:       // 
 4763:       //  NOTE: We use de-meaned densities.
 4764: 
 4765:       ELEM(elem);
 4766: 
 4767:       if (elem->isDry) return;
 4768: 
 4769:       const int kb  = elem->kb;
 4770:       const int i34 = elem->i34;
 4771: 
 4772:       for (int k = kb + 1; k < nvrt; k++) {
 4773:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4774:          //             gradRho.r1 = rho1 - rho0
 4775:          //             gradRho.r2 = rho2 - rho0
 4776:          int icount = 0;
 4777:          double sumRx = 0.0;
 4778:          double sumRy = 0.0;
 4779:          for (int j1=0; j1<i34; j1++) { 
 4780: 
 4781:             const int j2 = elem->nxq(j1 + 1);
 4782: 
 4783:             // Pairs of consecutive neighbor elements of elem
 4784:             const Element *e1 = elem->nghbElems[j1];
 4785:             const Element *e2 = elem->nghbElems[j2];
 4786: 
 4787:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4788:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4789:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4790: 
 4791:             // Compute the density difference and the vector from elem to e1 and e2
 4792:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4793:             double diffRho1, diffRho2;
 4794:             Vector2 vec1, vec2;
 4795:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4796:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4797: 
 4798:             const double rl1 = length(vec1);
 4799:             const double rl2 = length(vec2);
 4800:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4801: 
 4802:             const double delta = cross(vec1, vec2);
 4803:             const double sintheta = abs(delta)/(rl1*rl2);
 4804: 
 4805:             // To avoid problems, avoid elements with small angle between vectors
 4806:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4807:             const bool validEq = (sintheta > sin_one_deg);
 4808: 
 4809:             if (validEq) {
 4810:                // Solve the system of equations to get the density gradient at elem
 4811:                icount++;
 4812:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4813:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4814:                sumRx += Rx;
 4815:                sumRy += Ry;
 4816:             }
 4817:          } // for j1
 4818: 
 4819:          // Compute the average density gradient at elem
 4820:          if (icount==0) {
 4821:            // Bad mesh quality; bail out with 0 b-cc
 4822:            elem->gradRho[k] = {0.0, 0.0};
 4823:          } else {
 4824:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4825:          }
 4826: 
 4827:       } // for k
 4828: 
 4829:    }
 4830: 
 4831:    __global__ void computeBaroclinicTerm(void) {
 4832:    // Computes the baroclinic term at sides (at half levels).
 4833:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4834:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4835: 
 4836:       SIDE(side);
 4837: 
 4838:       if (side->isDry) return;
 4839: 
 4840:       const Element *e1 = side->elems[0];
 4841:       const Element *e2 = side->elems[1];      
 4842:       const int kb = side->kb;
 4843:       
 4844:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4845: 
 4846:       // interpolates vertically the density gradient of the two elements at the half level/
 4847: 
 4848:       // Starts the integration at the surface and goes down to the bottom
 4849:       int k1 = nvrt - 1;
 4850:       int k2 = nvrt - 1;
 4851: 
 4852:       side->bcc[nvrt-1] = {0.0, 0.0};
 4853:       for (int k = nvrt-2; k >= kb; k--) {
 4854:       // For each prism level (from surface to bottom)...
 4855: 
 4856:          // For both elements, interpolate density gradient at the side's half level.
 4857:          // The gradient at the side is the average of the gradients at the elements.
 4858:          // w1, w2 are used to take into account boundary sides, with just one element.
 4859:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4860:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4861:          const double wsum = w1 + w2;
 4862:          w1 = w1/wsum;
 4863:          w2 = w2/wsum;
 4864:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4865: 
 4866:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4867:          Vector2 gradRho = {0.0, 0.0};
 4868:          if (e1 != nullptr && k > kb) {
 4869:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4870:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4871:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4872:             
 4873:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4874:          }      
 4875:          if (e2 != nullptr && k > kb) {
 4876:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4877:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4878:             
 4879:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4880:          }
 4881: 
 4882:          if constexpr(ics==2) {
 4883:             // IMPLEMENT THIS XXXXXX
 4884:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4885:             // swild(1)=tmp1
 4886:             // swild(2)=tmp2
 4887:          }
 4888:          
 4889:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4890:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4891:          // CHECK INDICES!!! XXX
 4892:          const double grav3 = side->grav3();
 4893:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4894: printf(">>>side->bcc[%d] = %e, %e, rampbc: %e, grav3: %e, rho0: %e, side->Dz(k + 1): %e, gradRho: %e, %e\n", k, side->bcc[k].x, side->bcc[k].y, rampbc, grav3, rho0, side->Dz(k + 1), gradRho.x, gradRho.y);
 4895: 
 4896:       } // for
 4897: 
 4898:    }
 4899: 
 4900: 
 4901: 
 4902:    __global__ void computeHorGradientAtSide(void) {
 4903: 
 4904:       // Compute the horizontal density gradient at each element.
 4905:       // It works in two steps:
 4906:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4907:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4908:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4909:       //             gradRho.r1 = rho1 - rho0
 4910:       //             gradRho.r2 = rho2 - rho0
 4911:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4912:       // 
 4913:       //  NOTE: We use de-meaned densities.
 4914: 
 4915:       SIDE(side);
 4916: 
 4917:       if (side->isDry) return;
 4918: 
 4919:       // Computes the gradient of the variables at the side center.
 4920:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4921:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4922:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4923: 
 4924:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4925:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4926:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4927:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4928: 
 4929: 
 4930:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4931:          side->gradEta1.x, side->gradEta1.y, 
 4932:          side->gradEta2.x, side->gradEta2.y, 
 4933:          side->gradETP.x, side->gradETP.y, 
 4934:          side->gradPr.x, side->gradPr.y);
 4935: 
 4936: 
 4937:    }
 4938: 
 4939: 
 4940:    __global__ void solveMomentumEquations(double time) {
 4941: 
 4942:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4943:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4944: 
 4945:       SIDE(side);
 4946: 
 4947:       if (side->isDry) 
 4948:       {
 4949:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4950: 
 4951:          return;
 4952:       }
 4953: 
 4954:       const Node *n1 = side->n1;
 4955:       const Node *n2 = side->n2;
 4956: 
 4957:       const int kb = side->kb;
 4958: 
 4959:       const double veg_h = side->veg_h();
 4960:       const double grav3 = side->grav3();
 4961: 
 4962: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4963:       if (side->is2D()) {
 4964:          // Warning: Do not use htot2, which is updated.
 4965:          const double htot = side->htot1();
 4966:          const double hhat = side->hhat;
 4967: printf("htot: %e, hhat: %e\n", htot, hhat);
 4968:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4969: 
 4970:          Vector2 tau2 = {0.0, 0.0};
 4971:           
 4972:          if constexpr(ics==1) {
 4973:             tau2 = side->tau();
 4974: 
 4975:          } else {
 4976:             assert(false && "Not implemented: ics == 2");
 4977:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4978:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4979:             // taux2=(vn1+tt1)*0.5d0
 4980:             // tauy2=(vn2+ss1)*0.5d0
 4981:          } // if ics         
 4982: 
 4983:          // hat_gam has units of m/s
 4984: 
 4985:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4986: 
 4987: printf("coriolisTerm: %e, %e\n", coriolisTerm.x, coriolisTerm.y);
 4988: 
 4989:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4990:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4991: 
 4992:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4993: 
 4994:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4995:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4996: 
 4997:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4998: 
 4999: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e, hat_gam = %e, %e, hhat = %e, htot = %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y, side->nuGradU[nvrt-1].x, side->nuGradU[nvrt-1].y, hhat, htot);
 5000: 
 5001:       }
 5002:       else { // 3D
 5003: 
 5004:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5005:          // 
 5006:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5007:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5008:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5009:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5010:          // k+1 and k.
 5011: 
 5012: 
 5013:          // // Define layer thickness & viscosity
 5014:          // for (int k=kb + 1; k<nvrt; k++) {
 5015:          //    const double dzz = side->Dz(k - 1);
 5016: 
 5017:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5018: 
 5019:          //    // Vertical viscosity at the face center
 5020:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 5021:         
 5022:          // }
 5023: 
 5024: 
 5025:          const int ndim = nvrt - kb;
 5026:          const double zTopCanopy = side->zTopCanopy();
 5027: 
 5028:          // Initialize the tridiagonal system
 5029:          for (int k = kb + 1; k<nvrt; k++) {
 5030:             
 5031:             const int kin = k - kb;
 5032: 
 5033:             // Vertical viscosity at the face center
 5034:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 5035:             const double dzz = side->Dz(k);
 5036: 
 5037:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 5038:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 5039:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5040: 
 5041:             alow[kin] = 0.0;
 5042:             cupp[kin] = 0.0;
 5043:             bdia[kin] = 0.0;
 5044: 
 5045:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5046:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5047: 
 5048:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5049:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5050:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5051: 
 5052:             // First part: layers k, k+1
 5053:             if (k < nvrt - 1) {
 5054:                              
 5055:                if constexpr(iveg != 0) {
 5056: 
 5057:                   // If there is vegetation at this level...
 5058:                   if (zTopCanopy > side->zc[k]) {
 5059:                      // If the canopy is above the k layer...
 5060:                      
 5061:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5062:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5063:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5064:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5065: 
 5066:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5067:                      const double vmag2 = length(ut2);
 5068:                      const double vmag1 = length(side->u2[k]);
 5069:                      const double vmag = 0.5*(vmag1 + vmag2);
 5070:                      
 5071:                      // Computes the vegetation alpha at the face center
 5072:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5073: 
 5074:                      cff1 += veg_alpha_sd*dt*vmag;
 5075: 
 5076:                   } // if (zTopCanopy
 5077:                } // if iveg
 5078: 
 5079:                const double tmp = dt*dfz/dzz;
 5080:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5081:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5082: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 5083:             }
 5084: 
 5085: 
 5086:             // Second part: layers k-1, k
 5087:             if (k > kb + 1) {
 5088: 
 5089:                double cff1 = 1.0; //init \bar{c^k}
 5090: 
 5091:                if constexpr(iveg != 0) {
 5092:                   // If there is vegetation at this level...
 5093:                   if (zTopCanopy > side->zc[k-1]) {
 5094:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5095:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5096: 
 5097:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5098: 
 5099:                      const double vmag2 = length(ut2);
 5100:                      const double vmag1 = length(side->u2[k-1]);
 5101:                      const double vmag = 0.5*(vmag1 + vmag2);
 5102: 
 5103:                      // Computes the vegetation alpha at the face center
 5104:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5105:                      cff1 += veg_alpha_sd*dt*vmag;
 5106:                   } // if zTopCanopy
 5107: 
 5108:                } // if iveg
 5109: 
 5110:                const double tmp = dt*dfz/dzz;
 5111:                alow[kin] += cff1*dzz/6.0 - tmp;
 5112:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5113: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 5114:             } else { // Bottom boundary
 5115:                // This occurs at the bottom, where the bottom drag is applied.
 5116: 
 5117:                bdia[kin] += dt*side->chi2;
 5118: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 5119:             } // if (k > kb + 1)
 5120: 
 5121: 
 5122: 
 5123:          } // for (int k
 5124: 
 5125: 
 5126: 
 5127:          // Computes the RHS.
 5128:          // -----------------
 5129: 
 5130:          //	BC to be imposed at the end.
 5131: 
 5132:          const Vector2 gradETP  = side->gradETP;
 5133:          const Vector2 gradPr   = side->gradPr;
 5134:          const Vector2 gradEta1 = side->gradEta1;
 5135:          const Vector2 gradEta2 = side->gradEta2;
 5136: 
 5137:          const Vector2 *btu = side->btu;
 5138:          const Vector2 *u2  = side->u2;
 5139:          const double coriolis = side->coriolis;
 5140:          const Vector2 *nuGradU = side->nuGradU;
 5141: 
 5142: 
 5143:          for (int k = kb + 1; k<nvrt; k++) {
 5144:             const int kin = k - kb;
 5145: 
 5146:             const double dz_0 = side->Dz(k);
 5147:             const double dz_1 = side->Dz(k+1);  
 5148: 
 5149:             rrhs[kin] = {0.0, 0.0};
 5150:             double dz = 0.0;
 5151: 
 5152:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5153:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5154:             if (k < nvrt  ) dz += 0.5*dz_1;
 5155:             if (k > kb + 1) dz += 0.5*dz_0;
 5156: 
 5157:             // Elevation gradient, atmospheric pressure and tidal potential
 5158:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5159: 
 5160:             // Coriolis, advection, wind stress, and horizontal viscosity
 5161:             if (k < nvrt - 1) {
 5162: 
 5163: 
 5164:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5165:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5166:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5167: 
 5168:                //diff stress tensors 1006
 5169:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5170:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5171:                   assert(false && "Not implemented: itur == 5");
 5172:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5173:                }
 5174: 
 5175:             } else { // k=nvrt
 5176:                Vector2 tau2 = {0.0, 0.0};
 5177:                if constexpr(ics==1) {
 5178:                   tau2 = side->tau();
 5179:                } else {
 5180:                   assert(false && "Not implemented: ics == 2");
 5181:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5182:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5183:                   // taux2=(vn1+tt1)*0.5d0
 5184:                   // tauy2=(vn2+ss1)*0.5d0
 5185:                } // if ics
 5186: 
 5187:                rrhs[kin] += dt*tau2;
 5188: 
 5189:             } // if k<nvrt
 5190: 
 5191:             if (k > kb + 1) {
 5192:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5193:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5194:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5195: 
 5196: 
 5197:                // diff stress tensors 1006
 5198:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5199:                   assert(false && "Not implemented: itur == 5");
 5200:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5201:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5202:                }
 5203: 
 5204:             } // if k>kbs + 1
 5205: 
 5206:             // Baroclinic
 5207:             Vector2 *bcc = side->bcc;
 5208:             if constexpr(ibc == 0) {
 5209:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5210:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5211: 
 5212:             } // if ibc==0
 5213: 
 5214: 
 5215:          } // k=kb + 1,nvrt
 5216: 
 5217: printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 5218:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5219:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5220: printf("::: u[0] = %e, u[1] = %e, u[2] = %e, u[3] = %e\n", u[0], u[1], u[2], u[3]);
 5221: 
 5222: 
 5223:          for (int k=kb + 1; k<nvrt; k++) {
 5224:             const int kin = k - kb;
 5225: 
 5226:             // Velocity is always clamped to maximum values
 5227:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5228:          } // k
 5229: 
 5230:       } // if side->is2D()
 5231:       
 5232: 
 5233:       // Impose velocity boundary condition at the bottom
 5234:       if constexpr(imm == 2) { // 3D bed deformation model
 5235:          double dep;
 5236:          Vector2 vel;
 5237: 
 5238:          assert(false && "Not implemented: imm == 2");
 5239:          //update_bdef(time, x0, y0, dep, vel);
 5240:          // side->u2[kb] = vel;
 5241: 
 5242:       } else { // imm = 0 or 1
 5243:          if (side->Cd() == 0.0) {
 5244:             side->u2[kb] = side->u2[kb + 1];
 5245:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom
 5246:             side->u2[kb] = {0.0, 0.0};
 5247:          }
 5248:           
 5249:       } // if imm
 5250: 
 5251:       // The velocities below the bottom level are set to zero
 5252:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5253: 
 5254: 
 5255:    }
 5256: 
 5257: 
 5258:    __global__ void applyMomentumBC(void) {
 5259: 
 5260:       SIDE_BND(sideBnd);
 5261: 
 5262:       Side *side = sideBnd->side;
 5263:       const BoundarySegment *segment = sideBnd->segment;
 5264:       const Node *n1 = side->n1;
 5265:       const Node *n2 = side->n2;
 5266: 
 5267:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5268: 
 5269:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5270:       const bool isLand = segment->isLand;
 5271:       const int ifltype = segment->ifltype;
 5272: 
 5273:       const int kb = side->kb;
 5274: 
 5275: printf("ifltype = %d, isLand = %d, segment = %d, ubc = %e,%e\n", ifltype, segment->isLand, segment, sideBnd->ubc[kb].x, sideBnd->ubc[kb].y);    
 5276:       if (!isLand && ifltype != 0) {
 5277:          const Vector2 *ubc = sideBnd->ubc;
 5278:   
 5279:          for (int k=kb; k < nvrt; k++) {
 5280:             
 5281:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5282:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5283: 
 5284:             if (ifltype == -1) {
 5285:                // Flather 1
 5286: 
 5287:                const double depth = side->depth();
 5288: 
 5289:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5290: 
 5291:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5292: 
 5293:                side->u2[k] = vnorm*side->n;
 5294: 
 5295:             } else if (ifltype == -2) { // Discharge
 5296: 
 5297:                const double eta1 = side->eta1();
 5298:                const double eta2 = side->eta2();
 5299:                const double htot = side->htot2();
 5300: 
 5301:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5302:                assert(false && "Not implemented: Discharge bc");
 5303:                // const double dischrg = discharge(eta1);
 5304:                const double dischrg = 0.0; // XXX REMOVE
 5305:                
 5306: 
 5307:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5308: 
 5309:                const double vnorm = dischrg*eta2/htot;
 5310: 
 5311:                side->u2[k] = vnorm*side->n;
 5312: 
 5313: 
 5314:             }
 5315:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5316:                const double vnorm = dot(side->u2[k], side->n);
 5317: 
 5318:                double rat;
 5319:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5320:                else              rat = segment->vobc2; // outgoing
 5321: 
 5322:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5323:             }
 5324:             else { // not Flather or 3D radiation
 5325:                side->u2[k] = ubc[k];
 5326: printf("****** idx = %d, k = %d, side->idx = %d, ubc = %e,%e\n", side->idx, k, side->idx, ubc[k].x, ubc[k].y);               
 5327: 
 5328:             } // if (segment->ifltype...
 5329: 
 5330:          }
 5331: 
 5332:       }
 5333:       else if (isLand) { // if it is land boundary side
 5334: 
 5335:          if constexpr(islip == 0) { // free slip
 5336:             for (int k=kb; k < nvrt; k++) {
 5337:                double vnorm = 0.0; // for most cases
 5338:                const double vtan = dot(side->u2[k], side->t());
 5339:                const Vector2 t = side->t();
 5340:                const Vector2 n = side->n;
 5341: printf("islip   = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);      
 5342:                side->u2[k] = vtan*t - vnorm*n;
 5343: printf("islipXX = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);                     
 5344:             }
 5345: 
 5346:          } else { // no slip
 5347:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5348: 
 5349:          }
 5350:       } // if (side segment type...
 5351: 
 5352:    
 5353: 
 5354:    }
 5355: 
 5356: 
 5357:    __global__ void shapiroFilter1(void) {
 5358:       // First step of the Shapiro filter (normally used if indvel<=0)
 5359:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5360: 
 5361:       SIDE(side);
 5362: 
 5363:       // Only internal wet sides are processed
 5364:       if (side->isDry || !(side->isInternal())) return;
 5365: 
 5366:       const int kb = side->kb;
 5367: 
 5368:       for (int mm = 1; mm <= niter_shap; mm++) {
 5369: 
 5370:          for (int k = kb + 1; k < nvrt; k++) {
 5371:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5372:             side->bcc[k] = {0.0, 0.0};
 5373:             Vector2 suru = {0.0, 0.0};
 5374: 
 5375:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5376: 
 5377:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5378: printf("idx = %d, j = %d,nSide->idx = %d, nSide->u2[k] = %e,%e\n", side->idx, j, nSide->idx, nSide->u2[k].x, nSide->u2[k].y);
 5379: 
 5380:                int kin = k;
 5381:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5382:                
 5383:                if constexpr(ics==1) {
 5384:                   suru += nSide->u2[kin];
 5385: 
 5386:                } else {
 5387:                   assert(false && "Not implemented: ics == 2");
 5388:                   // Vector2 vn1, vn2;
 5389:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5390:                   // suru=suru+vn1;
 5391:                   // surv=surv+vn2;
 5392:                }
 5393:             }
 5394: 
 5395: 
 5396:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5397: printf("NNNN idx = %d, suru = %f,%f, side->u2[k] = %f,%f, side->bcc[k] = %f,%f\n", side->idx, suru.x, suru.y, side->u2[k].x, side->u2[k].y, side->bcc[k].x, side->bcc[k].y);            
 5398: 
 5399:          }
 5400:       }
 5401:    }
 5402: 
 5403:    __global__ void shapiroFilter2(void) {
 5404:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5405: 
 5406:       SIDE(side);
 5407: 
 5408:       if (side->isDry || !(side->isInternal())) return;
 5409: 
 5410:       const int kb = side->kb;
 5411: 
 5412:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5413: 
 5414:       if (side->is2D()) {
 5415:          // side->u2[kb] = side->u2[nvrt - 1];
 5416:          side->u2[kb + 1] = side->bcc[kb + 1];
 5417:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5418: 
 5419:       } else {
 5420:          // 3D
 5421:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5422:          
 5423:       }
 5424: 
 5425:    }
 5426: 
 5427: 
 5428:    __global__ void ul0UpdateZCoords(void) {
 5429:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5430:       
 5431:       NODE(node);      
 5432: 
 5433:       if (node->isDry2()) { 
 5434: 
 5435:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5436: 
 5437:          if constexpr(ivcor != 1) node->kb = 0;
 5438: 
 5439:       } else {
 5440: 
 5441:          node->updateKb();
 5442:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5443: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 5444: 
 5445:       } // if wet or dry
 5446: 
 5447:       // We use the temp.b field to store the previous state of isDry.
 5448:       node->tmp.b = node->isDry;
 5449: 
 5450:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5451:       node->isDry = true;
 5452: 
 5453:    }
 5454: 
 5455:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5456:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5457:    {
 5458:       ELEM(elem);
 5459: 
 5460:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5461: 
 5462:       // All the nodes of a wet element are wet.
 5463:       if (!elem->isDry) {
 5464:          elem->nodes[0]->isDry = false;
 5465:          elem->nodes[1]->isDry = false;
 5466:          elem->nodes[2]->isDry = false;
 5467:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5468: 
 5469:       }
 5470: 
 5471: 
 5472:       elem->kb = 0;
 5473: 
 5474:       if (elem->isDry) return;
 5475: 
 5476:       // Wet
 5477:       const Node *n1 = elem->nodes[0];
 5478:       const Node *n2 = elem->nodes[1];
 5479:       const Node *n3 = elem->nodes[2];  
 5480:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5481: 
 5482:    //    if(elem->isDry2()) {
 5483:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5484:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5485:    //        call parallel_abort(errmsg)
 5486:    //    }
 5487: 
 5488: 
 5489:       // Computes element's kb as the minimum of the nodes' kb.
 5490:       const int kb1 = n1->kb;
 5491:       const int kb2 = n2->kb;
 5492:       const int kb3 = n3->kb;
 5493:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5494: 
 5495: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5496: 
 5497:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5498: 
 5499: 
 5500:       // Computes the element z as the mean of the nodes z.
 5501:       for (int k = elem->kb; k < nvrt; k++) {
 5502: 
 5503:          // Compute the element z as the mean of the nodes z.
 5504:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5505:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5506:          elem->z[k] /= elem->i34;
 5507: 
 5508:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5509:       }
 5510:                   
 5511:    }
 5512: 
 5513:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5514:    {
 5515:       NODE(node);
 5516:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5517: 
 5518:       if (it == iths) return;
 5519: 
 5520: 
 5521:       if(!node->isDry && node->tmp.b) { // rewetted
 5522:          for (int k=0; k < nvrt; k++) {
 5523: 
 5524:             Vector3 utmp={0.0, 0.0, 0.0};
 5525: 
 5526:             double ttmp=0.0;
 5527:             double stmp=0.0;
 5528:             int icount=0;
 5529:             for (int j = 0; j < node->numNodes; j++) {
 5530: 
 5531: 
 5532:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5533:                if (!node->isDry) { // all indices extended
 5534:                   icount++;
 5535: 
 5536:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5537:                   utmp += node->u2[k];
 5538:                   
 5539:                   ttmp += node->tracers[k].tracer[0]; 
 5540:                   stmp += node->tracers[k].tracer[1]; 
 5541:                }
 5542:             }
 5543: 
 5544:             if(icount > 0) {
 5545:                const double inv_icount = 1.0/icount;
 5546:                node->u2[k]     = inv_icount*utmp;
 5547:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5548:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5549:             }
 5550:          }
 5551:       }
 5552:    }
 5553: 
 5554: 
 5555:    __global__ void ul0UpdateSides(int it, int iths) {
 5556: 
 5557:       SIDE(side);
 5558: 
 5559:       // A side is wet if and only if at least one of its elements is wet.
 5560:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5561: 
 5562:       const Node *n1 = side->n1;
 5563:       const Node *n2 = side->n2;
 5564:       const int kb1 = n1->kb;
 5565:       const int kb2 = n2->kb;
 5566: 
 5567:       side->kb = 0; // dry
 5568: 
 5569:       if (isWet) {
 5570: 
 5571:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5572: 
 5573:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5574: 
 5575:          side->kb = min(kb1, kb2);
 5576: 
 5577:          for (int k = side->kb; k < nvrt; k++) {
 5578:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5579: 
 5580:          
 5581:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5582: 
 5583:             // Compute velocity for re-wetted sides 
 5584:             if ((it != iths) && (side->isDry && isWet)) {
 5585:             
 5586:                Vector2 utmp={0.0, 0.0};
 5587: 
 5588:                int icount=0;
 5589: 
 5590:                // For all the sides on the two elements that share this side
 5591:                for (int j=0; j < 2; j++) {
 5592:                   const Element *elem = side->elems[j];
 5593:                   if (elem == nullptr) continue;
 5594: 
 5595:                   for (int jj=0; jj < elem->i34; jj++) {
 5596:                      const Side *nSide = elem->sides[jj];
 5597:                      if (nSide->isDry) continue;
 5598: 
 5599:                      icount++;
 5600:                      utmp += nSide->u2[k];                     
 5601:                   }
 5602:                }
 5603:                   
 5604:                assert(icount > 0 && "No wet sides around this side");
 5605:                if (icount > 0)  side->u2[k] = utmp/icount;
 5606:                   
 5607:             } // if ((it != iths) && (side->isDry && isWet))
 5608: 
 5609:          } // for k
 5610: 
 5611:       } // if isWet
 5612:    
 5613:       side->isDry = !isWet;
 5614: 
 5615:    }
 5616: 
 5617: 
 5618:    __global__ void zeroNodalVelocities(void) {
 5619:       NODE(node);
 5620: 
 5621:       for (int k = 0; k < nvrt; k++) {
 5622:          node->u2[k]   = {0.0, 0.0, 0.0};
 5623:          node->utmp[k] = {0.0, 0.0};
 5624:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5625:       }
 5626:    }
 5627: 
 5628:    __global__ void computeNodalVerticalVelocities1(void) {
 5629:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5630:    // Adds the element's vertical velocity times the element's area.
 5631:       ELEM(elem);
 5632: 
 5633:       for (int j = 0; j < elem->i34; j++) {
 5634:          Node *node = elem->nodes[j];
 5635: 
 5636:          for (int k = node->kb; k < nvrt; k++) {
 5637:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5638:          }
 5639:          atomicAdd(&(node->tmp.d), elem->area);
 5640:       }
 5641:    }
 5642: 
 5643:    __global__ void computeNodalVerticalVelocities2(void) {
 5644:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5645:    // Divides by the total area of the elements sharing the    node.
 5646:       NODE(node);
 5647: printf("node->idx = %d, node->tmp.d = %e, node->u2[k].z = %e\n", node->idx, node->tmp.d, node->u2[0].z);
 5648:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5649:    }
 5650: 
 5651: 
 5652:    __global__ void computeNodalHorizontalVelocities1(void) {
 5653:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5654:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5655: 
 5656:       ELEM(elem);
 5657: 
 5658:       const int kb = elem->kb;
 5659:       const bool isTri = elem->isTri();
 5660: 
 5661:       if constexpr(indvel <= 0) {
 5662:          // Assuming discontinoius hvel.
 5663: 
 5664: 
 5665:          if (isTri) { // For triangles
 5666:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated at one node can be
 5667:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5668: 
 5669:             for (int j = 0; j < 3; j++) {
 5670:                // For every node of the triangle...
 5671:                Node *node = elem->nodes[j];
 5672: 
 5673:                const Side *s1 = elem->sides[j];
 5674:                const Side *s2 = elem->sides[(j + 1) % 3];
 5675:                const Side *s3 = elem->sides[(j + 2) % 3];
 5676: 
 5677:                const int numElements = node->numElements;
 5678: 
 5679:                for (int k = kb; k < nvrt; k++)  {
 5680:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k];
 5681:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5682:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5683:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5684:                   atomicAdd(&(node->utmp[k].x), (1.0/numElements) * u.x);
 5685:                   atomicAdd(&(node->utmp[k].y), (1.0/numElements) * u.y);
 5686: 
 5687: auto uu = (1.0/numElements) * u;                  
 5688: if (k==0 && node->idx == 1) printf("elem->idx = %d, node->idx = %d, utmp = %e,%e, node->numElements = %d, node->numSides = %d, u = %e,%e\n", elem->idx, node->idx, node->utmp[k].x, node->utmp[k].y, node->numElements, node->numSides, uu.x, uu.y);                  
 5689:                }
 5690: 
 5691:             }
 5692:          }
 5693:          else { // For quads
 5694: 
 5695:          }
 5696: 
 5697:       }
 5698:       
 5699:    }
 5700: 
 5701: 
 5702:    __global__ void computeNodalHorizontalVelocities2(void) {
 5703:       NODE(node);
 5704: 
 5705:       for (int k = 0; k < nvrt; k++) {
 5706:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5707:       }
 5708:       
 5709:    }   
