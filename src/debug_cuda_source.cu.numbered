 4234: 
 4235: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4236:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4237:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4238: 
 4239: 
 4240:    NODE(node1);
 4241: 
 4242:    node1->clearMatrixRow();
 4243:    node1->qel = 0.0;
 4244: 
 4245:    // THIS IS FOR STRUCTURES XXX
 4246:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4247: 
 4248:    
 4249:    for (int j=0; j<node1->numElements; j++) {
 4250:       // For each element connected to the node...
 4251: 
 4252:       Element *elem = node1->elements[j];
 4253: 
 4254: 
 4255: 
 4256:       // Compute the average gravity
 4257:       const double grav3 = elem->mean(&Node::grav2);
 4258: 
 4259:       // Look at the documentation for the description of the terms in the following integrals
 4260: 
 4261:       // Integral I_1 
 4262:       // \bar{\breve{H}} 
 4263:       const double hhatb = elem->mean(&Side::hhat);        
 4264: 
 4265:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4266: 
 4267:       const int id1 = elem->nodeLocalIdx(node1); 
 4268:       const double area = elem->area;
 4269: 
 4270:       if (elem->isTri()) {
 4271: 
 4272:          // To clarify the notation in this section: 
 4273:          //   i stands for the node under consideration (node1)
 4274:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4275:          const int id2 = elem->nxq(1 + id1);
 4276:          const int id3 = elem->nxq(2 + id1);
 4277:          Node *node2 = elem->nodes[id2];
 4278:          Node *node3 = elem->nodes[id3];
 4279: 
 4280:          Point2 x1, x2, x3;
 4281:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4282: 
 4283: 
 4284:          // integral of phi_i*phi_j
 4285:          const double ipp_ii = (1.0/6.0 )*area;
 4286:          const double ipp_ij = (1.0/12.0)*area;
 4287:          const double ipp_ik = (1.0/12.0)*area;
 4288: 
 4289:          // integral of [(grad phi_i) * (grad phi_j)]
 4290:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4291:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4292:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4293: 
 4294:          // Computes the different components of integral I_1 of each node with respect to node i.
 4295:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4296:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4297:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4298: 
 4299:          node1->addToSparseMatrix(node1, I1_ii);
 4300:          node1->addToSparseMatrix(node2, I1_ij); 
 4301:          node1->addToSparseMatrix(node3, I1_ik);
 4302: 
 4303:       }
 4304:       else { // Quad
 4305:          // XXX IMPLEMENT THIS
 4306:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4307: 
 4308:          // // To clarify the notation in this section: 
 4309:          // //   i stands for the node under consideration (node1)
 4310:          // //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4311:          // const int id2 = elem->nxq(1 + id1);
 4312:          // const int id3 = elem->nxq(2 + id1);
 4313:          // const int id4 = elem->nxq(3 + id1);
 4314:          // Node *node2 = elem->nodes[id2];
 4315:          // Node *node3 = elem->nodes[id3];
 4316:          // Node *node4 = elem->nodes[id4];         
 4317: 
 4318:          // // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4319:          // const double ipp_ii = elem->intPhiPhi(id1, id1);
 4320:          // const double ipp_ij = elem->intPhiPhi(id1, id2);
 4321:          // const double ipp_ik = elem->intPhiPhi(id1, id3);
 4322:          // const double ipp_il = elem->intPhiPhi(id1, id4);
 4323: 
 4324:          // // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4325:          // const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4326:          // const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4327:          // const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4328:          // const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4329: 
 4330:          // // Computes the different components of integral I_1 of each node with respect to node i.
 4331:          // const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4332:          // const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4333:          // const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4334:          // const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4335: 
 4336:          // node1->addToSparseMatrix(node1, I1_ii);
 4337:          // node1->addToSparseMatrix(node2, I1_ij); 
 4338:          // node1->addToSparseMatrix(node3, I1_ik);
 4339:          // node1->addToSparseMatrix(node4, I1_il);
 4340:   
 4341:       } 
 4342: 
 4343:  
 4344:       // Integral I_4
 4345:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4346:       // Where
 4347:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4348: 
 4349:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4350:       // of U over the element.
 4351:       Vector2 U = {0.0, 0.0};
 4352:       for (int m=0; m < elem->i34; m++) {      
 4353:          const Side *side = elem->sides[m];
 4354: 
 4355:          if constexpr(ics == 1) U += side->U; 
 4356:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4357: 
 4358:       }
 4359:       U = U/elem->i34;
 4360: 
 4361: 
 4362:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4363: 
 4364: 
 4365:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4366:       const double I_4_1 = dot(gradPhi_1, U);
 4367: 
 4368: 
 4369:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4370:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4371: 
 4372:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4373: 
 4374:       // Additional terms 
 4375:       double vnorm = 0.0;
 4376:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4377:          Vector3 ubed = {0.0, 0.0, 0.0};
 4378:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4379: 
 4380:          Vector3 gradP = {0.0, 0.0, 1.0};
 4381:          for (int m=0; m < elem->i34; m++) {
 4382:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4383:            gradP += toVector3(gradP_2D, 0.0);
 4384:          }   
 4385:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4386:       } // imm==2
 4387: 
 4388:       if (elem->isTri()) {
 4389:          for (int l=0; l<3; l++) {
 4390: 
 4391:             Node *node = elem->nodes[l];
 4392: 
 4393:             double fac = (node == node1) ? 2.0 : 1.0;
 4394:    
 4395:             if      constexpr(imm == 2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4396:             else if constexpr(imm == 1) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + (node->bdef2 - node->bdef1)); 
 4397:             else                        node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2); 
 4398:            
 4399:          }
 4400: 
 4401: 
 4402:          if (!elem->isDry) {
 4403:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4404: 
 4405:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4406: 
 4407:          }
 4408: 
 4409:       } // isTri
 4410:       else { // isQuad
 4411:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4412:          // for (int l=0; l<4; l++) {
 4413:          //   const Node *node = elem->nodes[l];
 4414: 
 4415:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4416:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4417: 
 4418:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4419:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4420:          // }
 4421: 
 4422:       } // isQuad
 4423: 
 4424: 
 4425:      node1->qel += (dt/elem->i34)*elem->vsource;
 4426:       
 4427: 
 4428:    } // for all elements connected to the node
 4429:    
 4430: 
 4431:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4432:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4433:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4434:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4435:       // If it is an open boundary node...
 4436: 
 4437:       // At least one open bnd side, maybe two
 4438:       for (int l=0; l<2; l++) { 
 4439: 
 4440:          // Gets each of the sides sharing the node. 
 4441:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4442: 
 4443:        
 4444: 
 4445:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4446:          if (sideBnd != nullptr) {
 4447:             // If the side is on a boundary...
 4448: 
 4449:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4450: 
 4451:             // Get the boundary segment
 4452:             const BoundarySegment *sideSegment = sideBnd->segment;
 4453:             const Side *side = sideBnd->side;
 4454: 
 4455:             // Integral I_3
 4456:             if (sideSegment->ifltype != 0) {
 4457:             // Natural or Flather b.c.
 4458: 
 4459:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4460:                // especially for Flather b.c.
 4461:                double ri3 = 0.0;
 4462:                if (!side->isDry) {
 4463:                   // If the side is not dry
 4464:                   
 4465:                   // Computes the side flux of (uth, vth)
 4466:                   double Vn = 0.0;
 4467:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4468:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4469:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4470: 
 4471:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4472:                   }
 4473: 
 4474:                   ri3 = 0.5*side->len*Vn;
 4475:                }
 4476: 
 4477:                if (sideSegment->ifltype == -1) { // Flather 1
 4478: 
 4479:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4480:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4481: 
 4482:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4483:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4484:                   
 4485:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4486:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4487: 
 4488:                } 
 4489:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4490:                   // Reset ri3
 4491:                   ri3 = 0.0;
 4492: 
 4493:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4494: 
 4495:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4496: 
 4497:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4498:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4499: 
 4500:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4501:                   node1->addToSparseMatrix(node1, con0*2.0);
 4502:                   node1->addToSparseMatrix(node2, con0);
 4503: 
 4504:                } // if Flather or Discharge
 4505: 
 4506:                node1->qel -= thetai*dt*ri3;
 4507: 
 4508: 
 4509:             } // I_3
 4510:           
 4511: 
 4512:             // Integral I_5
 4513:             if(!side->isDry) {
 4514: 
 4515:                const double Unbar = dot(side->U, side->n);
 4516:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4517: 
 4518:             } // I_5
 4519: 
 4520:          } // if is boundary side
 4521: 
 4522:       } // for l
 4523: 
 4524:    } // if isbnd
 4525: 
 4526: 
 4527: }
 4528: 
 4529: 
 4530: 
 4531: extern "C" {
 4532:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4533:                                   int* indices, int* indptr) {
 4534: 
 4535:       NODE(node);
 4536:       
 4537:       const int idx = node->idx;
 4538:       
 4539:       // Computes the index in the nzz array      
 4540:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4541: 
 4542: 
 4543:       indptr[idx] = nzzIdx;
 4544:       indices[nzzIdx] = idx;
 4545: 
 4546:       data_d[nzzIdx]    = node->coeffDiag;
 4547: 
 4548:       b_d[idx] = node->qel;
 4549: 
 4550:       for (int k = 0; k < node->numNodes; ++k) {
 4551:          const Node* nb = node->nodes[k];
 4552: 
 4553:          const int j = nb->idx;
 4554: 
 4555:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4556: 
 4557:          indices[nzzIdx + k + 1] = j;
 4558:       }
 4559: 
 4560:  
 4561:    }
 4562: 
 4563: 
 4564: 
 4565:    __global__ void solverCopyResult(double* x) {
 4566:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4567:       NODE(node);
 4568:       const int idx = node->idx;
 4569: 
 4570:       node->mX = x[idx];
 4571:    }
 4572: 
 4573: 
 4574:    __global__ void rollUpElevation(void) {
 4575: 
 4576:       NODE(node);
 4577: 
 4578:       node->eta1 = node->eta2;
 4579: 
 4580:    }
 4581: 
 4582: 
 4583:    __global__ void backtrackAllNodes(void) {
 4584: 
 4585:       // max/min # of sub-divisions
 4586:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4587:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4588: 
 4589: 
 4590:       SIDE(side);
 4591: 
 4592:       const int kb = side->kb;
 4593: 
 4594: 
 4595:       // Initialize btrack velocities to the actual velocities at the side 
 4596:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4597: 
 4598:   
 4599: 
 4600:       if (side->isDry) return;
 4601:      
 4602: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4603: 
 4604:       // Checks that at least one element is not dry
 4605:       const Element *elem1 = side->elems[0];
 4606:       const Element *elem2 = side->elems[1];
 4607: 
 4608: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4609: 
 4610:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4611:       
 4612:       // XXXXXX
 4613:       // !swild_tmp to store global coord. of the starting side
 4614:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4615:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4616:       // !Use sframe2 
 4617:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4618: 
 4619: 
 4620:       for (int k = kb; k < nvrt; k++) {
 4621:       //  Initialize (xt,yt,zt), nnel and vel.
 4622:       //  For ics=2, the coordinates are all in the side's local frame
 4623:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4624: 
 4625:          const int iadvf = side->iadv();  // Advection flag   
 4626:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4627: 
 4628:          // If on land or open boundary...
 4629:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4630:          
 4631:          const double vmag = length(side->u2[k]);
 4632: 
 4633:          if (vmag <= velmin_btrack) {
 4634:             // No activity 
 4635: 
 4636:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4637: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4638: 
 4639:             
 4640:          } else {  // do btrack
 4641: 
 4642:             // Compute number of sub-divisions based on local gradients of the velocity field
 4643: 
 4644:             // XXX IS THIS NECESSARY?
 4645:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4646:             double suma = 0.0;
 4647:             int icount = 0;
 4648:             for (int l=0; l<2; l++) {
 4649:             // For each element sharing the side...
 4650: 
 4651:                const Element *elem = side->elems[l];
 4652:                  
 4653:                if (elem == nullptr) continue;
 4654: 
 4655:                icount++;
 4656: 
 4657:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4658:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4659:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4660: 
 4661:                double utmp[4];
 4662:                double vtmp[4];
 4663:                for (int j = 0; j < elem->i34; j++) {
 4664: 
 4665:                   const Node *node = elem->nodes[j];
 4666: 
 4667:                   if constexpr(ics==1) {
 4668:                      utmp[j] = node->u2[k].x;
 4669:                      vtmp[j] = node->u2[k].y;  
 4670: 
 4671:                   } else {
 4672:                      // 'Project' the velocity from the node frame to the element frame
 4673:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4674:                      utmp[j] = tmp_u2.x;
 4675:                      vtmp[j] = tmp_u2.y;
 4676: 
 4677:                   }
 4678:                } // for j
 4679: 
 4680:                const Vector2 grad_u = elem->grad2(utmp); 
 4681:                const Vector2 grad_v = elem->grad2(vtmp);
 4682:    
 4683:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4684:             } // for ii
 4685: 
 4686:             assert(icount > 0 && "Impossible 77");
 4687: 
 4688:             // '4' is somewhat arbitrary
 4689:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4690:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4691:             Vector3 u_int = {0.0, 0.0, 0.0};
 4692: 
 4693:             bool res =side->btrack(k, dt, dtbk, u_int);
 4694: 
 4695:             side->btu[k] = toVector2(u_int);
 4696:                
 4697:          } // if vmag (do backtrack)
 4698: 
 4699: 
 4700:       } // for k=kb,nvrt-1
 4701: 
 4702:    }
 4703: 
 4704: } // extern "C"
 4705: 
 4706: template<int nc>
 4707: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4708: 
 4709: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4710: //
 4711: // a,b,c,rhs: input vectors and are not modified by this program.
 4712: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4713: // rhs is the r.h.s.
 4714: // n: actual rank of the system.
 4715: // rows in u() and rhs();
 4716: // u: output with nc columns (transposed to rows)
 4717: // gam: a working array.
 4718: //
 4719: // NOTES:
 4720: // This is a template function that allows for different numbers of columns in the rhs vector.
 4721: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4722: 
 4723:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4724:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4725: 
 4726:    double bet = b[0];
 4727:    if constexpr (nc == 1) {
 4728:       u[0] = rhs[0]/bet;
 4729:    } else {
 4730:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4731:    }
 4732: 
 4733:    for (int j = 1; j < n; j++) {
 4734:       gam[j] = c[j - 1]/bet;
 4735:       bet = b[j] - a[j]*gam[j];
 4736: 
 4737:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4738: 
 4739:       if constexpr (nc == 1) {
 4740:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4741:       } else {
 4742:          for (int l = 0; l < nc; l++) {
 4743:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4744:          }
 4745:       }
 4746:    }
 4747: 
 4748:    // Back-substitution
 4749:    for (int j = n - 2; j >= 0; j--) {
 4750:       if constexpr (nc == 1) {
 4751:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4752:       } else {
 4753:          for (int l = 0; l < nc; l++) {
 4754:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4755:          }
 4756:       }
 4757:    }
 4758: }
 4759: 
 4760: 
 4761: 
 4762: // Helper function that contains the core algorithm
 4763: template<typename XAccessor, typename YAccessor>
 4764: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4765:                                     double  yp_top, double  yp_bot, 
 4766:                                     CubicSpline &spline) {
 4767:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4768:    // 
 4769:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4770:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4771:    //
 4772:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4773:    // 
 4774:    // Inputs: 
 4775:    //            n: dimension for x etc; # of data pts (>=2);
 4776:    //            getX, getY: functions to access x,y coordinates
 4777:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4778:    //     Output: 
 4779:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4780: 
 4781:    const int n = k2 - k1 + 1;
 4782:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4783: 
 4784:    // Allocate memory for the splines
 4785:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4786:    spline.x   = new double[n];
 4787:    spline.y   = new double[n];
 4788:    spline.yp  = new double[n];
 4789:    spline.ypp = new double[n];
 4790: 
 4791:    for (int k=k1; k<=k2; k++) {
 4792:       spline.x[k] = getX(k);
 4793:       spline.y[k] = getY(k);
 4794:    }
 4795: 
 4796:    // This is to simplify expressions later
 4797:    double *x = spline.x;
 4798:    double *y = spline.y;
 4799: 
 4800:    double *a = nullptr;
 4801:    double *b = nullptr;
 4802:    double *c = nullptr;
 4803:    double *gam = nullptr;
 4804:    double *rhs = nullptr;
 4805:    
 4806: 
 4807:       a = new double[n];   // Lower diagonal
 4808:       b = new double[n];   // Diagonal
 4809:       c = new double[n];   // Upper diagonal
 4810:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4811:       rhs = new double[n]; // Right-hand side
 4812: 
 4813:    for (int k=k1; k<=k2; k++) {
 4814:       if (k == k1) {
 4815:          // Bottom level
 4816:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4817:          b[k] = (x[k+1] - x[k])/3.0;
 4818:          c[k] = b[k]/2.0;
 4819:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4820:       } else if (k == n - 1) {
 4821:          // Top level (surface)
 4822:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4823:          b[k] = (x[k] - x[k-1])/3.0;
 4824:          a[k] = b[k]/2.0;
 4825:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4826:       } else {
 4827:          // Intermediate levels
 4828:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4829:          b[k] = (x[k+1] - x[k-1])/3.0;
 4830:          a[k] = (x[k  ] - x[k-1])/6.0;
 4831:          c[k] = (x[k+1] - x[k  ])/6.0;
 4832:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4833:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4834:       }
 4835:    }
 4836: 
 4837:    // Solve the tridiagonal system
 4838:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4839:    
 4840:    spline.yp[k1] = yp_bot;
 4841:    spline.yp[k2] = yp_top;
 4842: 
 4843:    // Compute rest of 1st derivatives using the splines
 4844:    for (int k=k1+1; k<k2; k++) {
 4845:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4846:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4847:    }
 4848:    
 4849:    delete[] a;
 4850:    delete[] b;
 4851:    delete[] c;
 4852:    delete[] gam;
 4853:    delete[] rhs;
 4854: 
 4855: }
 4856: 
 4857: // Array version
 4858: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4859:                                 double y_top, double y_bot, 
 4860:                                 CubicSpline &spline) {
 4861:    auto getX = [x] (int k) { return x[k]; };
 4862:    auto getY = [y] (int k) { return y[k]; };
 4863:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4864: }
 4865: 
 4866: // Lambda version - allows custom access patterns
 4867: template<typename XFunc, typename YFunc>
 4868: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4869:                                 double y_top, double y_bot,
 4870:                                 CubicSpline &spline) {
 4871:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4872: }
 4873: 
 4874: 
 4875: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4876: {
 4877:    assert("Not implemented");
 4878: 
 4879:    return 0.0;
 4880: }
