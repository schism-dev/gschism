 1684:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1685:       // Compute the different time ramps used in the code 
 1686:       // This function is performed by just one thread
 1687: 
 1688:       rampbc = 1.0;
 1689:       if constexpr(ibc == 0) {
 1690:          if (drampbc > 0.0) {
 1691:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1692:          } else {
 1693:             rampbc = 1.0;
 1694:          }
 1695:       }
 1696: 
 1697:       if (nws != 0) {
 1698:          if (drampwind > 0.0) {
 1699:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1700:          } else {
 1701:             rampwind = 1.0;
 1702:          }
 1703:       }
 1704: 
 1705:       if (drampwafo > 0.0) {
 1706:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1707:       } else {
 1708:          rampwafo = 1.0;
 1709:       }
 1710: 
 1711:       // For source/sinks
 1712:       if (if_source && dramp_ss > 0.0) {
 1713:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1714:       } else {
 1715:          ramp_ss = 1.0;
 1716:       }
 1717: 
 1718:       if (dramp > 0.0) {
 1719:          ramp = tanh(2.0*time/86400.0/dramp);
 1720:       } else {
 1721:          ramp = 1.0;
 1722:       }
 1723: 
 1724: 
 1725:    }
