 6312:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6313: 
 6314:       NODE(node);
 6315: 
 6316:       node->ETP = 0.0;
 6317: 
 6318:       if constexpr(ntip == 0) return;
 6319: 
 6320:       // For all tidal potential components
 6321:       for (int j=0; j<ntip; j++) {
 6322: 
 6323:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6324: 
 6325:          node->ETP += nodeETP;
 6326: 
 6327:          if constexpr(iloadtide==1) { // loading tide
 6328:             assert(false && "Loading tide not implemented");
 6329:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6330:          }
 6331:          
 6332:       }
 6333: 
 6334:      
 6335:    }
