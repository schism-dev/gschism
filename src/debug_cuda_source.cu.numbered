 3707:    __global__ void computeElevationBoundaryConditions(double time) {
 3708:       // Compute elevation essential boundary conditions 
 3709: 
 3710:       NODE_BND(nodeBnd); // Each boundary node.
 3711: 
 3712:       const Node *node = nodeBnd->node;
 3713:       const int iettype = nodeBnd->iettype;
 3714: 
 3715:       double eic = 0.0;
 3716:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3717:       else               eic = 0.0;
 3718: 
 3719:       const double r_eic = (1.0 - ramp)*eic; 
 3720:       const double r_eth = ramp*nodeBnd->eth;
 3721:       double eta1_bar = r_eic;
 3722: 
 3723: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3724:       // Compute tide elevation
 3725:       if (iettype == 3 || iettype == 5) {   
 3726: 
 3727:          if constexpr(iloadtide==1) { // loading tide
 3728:             assert(false && "Loading tide not implemented");
 3729:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3730:          }
 3731:          
 3732:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3733: 
 3734:             const double efa  = nodeBnd->efa[jfr]; 
 3735:             const double emo  = nodeBnd->emo[jfr]; 
 3736: 
 3737:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3738:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3739:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3740: 
 3741:  printf("++++>> jfr = %d, time = %f, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, time, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3742:          } // for jfr
 3743: 
 3744:       } // if iettype
 3745: 
 3746:       switch (iettype) {
 3747:          case 1:
 3748:          case 2:
 3749:             nodeBnd->elbc = r_eth + r_eic;
 3750:             break;
 3751:          case 3:
 3752:             nodeBnd->elbc = eta1_bar + r_eic;
 3753:             break;
 3754:          case 4:
 3755:             nodeBnd->elbc = r_eth + r_eic;
 3756:             break;
 3757:          case 5:
 3758:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3759:             break;
 3760:       } // switch
 3761: 
 3762: 
 3763:       //Add inverse barometric effects
 3764:       if (iettype != 0 && inv_atm_bnd == 1) {
 3765:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3766:       }
 3767: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3768:    }
 3769: 
 3770: 
 3771:    __global__ void setEssentialBC(void) {
 3772:       // Set essential boundary conditions 
 3773:       NODE(node); // Each boundary node
 3774:       NodeBoundary *nodeBnd = node->nodeBnd;
 3775: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3776:       
 3777: // nodeBnd->isEssentialBC = true;      
 3778:       // Check if this node has essential BC
 3779:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3780:          // Verify BC value is valid
 3781:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3782: 
 3783:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3784:          
 3785:          // Set diagonal to 1 and zero off-diagonals
 3786:          node->coeffDiag = 1.0;
 3787:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3788: 
 3789:          for (int j = 0; j < node->numNodes; j++) {
 3790:                node->coeffMatrix[j] = 0.0;
 3791:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3792:          }
 3793:          
 3794:          // Set solution and RHS to BC value
 3795:          node->mX  = nodeBnd->elbc;
 3796:          node->qel = nodeBnd->elbc;
 3797: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3798:       } else {
 3799:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3800: 
 3801:          for (int j = 0; j < node->numNodes; j++) {
 3802:                Node* nbNode = node->nodes[j];
 3803:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3804:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3805:                   // Verify neighbor's BC value
 3806:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3807: 
 3808:                   // Subtract contribution to RHS
 3809:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3810:                   node->coeffMatrix[j] = 0.0;  
 3811:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3812:                }
 3813:          }
 3814:       }
 3815:    }
 3816: 
 3817: 
 3818:    __global__ void updateElevation(void) {
 3819:       NODE(node);
 3820: 
 3821:       node->eta2 = node->mX;
 3822: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 3823:    }
