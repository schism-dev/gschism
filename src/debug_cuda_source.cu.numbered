 8607:          *sizeType = sizeof(double);
 8608:          break;
 8609:       // case (int)VarCode::depth:
 8610:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 8611:       //    *sizeType = sizeof(double);
 8612:       //    break;         
 8613:       case (int)VarCode::x:
 8614:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 8615:          *sizeType = sizeof(Vector2);
 8616:          break;
 8617:       case (int)VarCode::len:
 8618:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 8619:          *sizeType = sizeof(double);
 8620:          break;
 8621:       case (int)VarCode::kb:
 8622:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 8623:          *sizeType = sizeof(int);
 8624:          break;
 8625:       case (int)VarCode::isdry:
 8626:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8627:          *sizeType = sizeof(int);
 8628:          break;            
 8629:       // case (int)VarCode::w:
 8630:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8631:       //    *sizeType = sizeof(double);
 8632:       //    break;
 8633:       case (int)VarCode::u:
 8634:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8635:          *sizeType = sizeof(Vector2);
 8636:          break;   
 8637:       case (int)VarCode::btu:
 8638:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 8639:          *sizeType = sizeof(Vector2);
 8640:          break;          
 8641:       case (int)VarCode::U:
 8642:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 8643:          *sizeType = sizeof(Vector2);
 8644:          break;
 8645:       case (int)VarCode::gradETP:
 8646:          *offset = (int)((char*)&sides[0].gradETP.x - (char*)sides);
 8647:          *sizeType = sizeof(Vector2);
 8648:          break;
 8649:       case (int)VarCode::gradPr:
 8650:          *offset = (int)((char*)&sides[0].gradPr.x - (char*)sides);
 8651:          *sizeType = sizeof(Vector2);
 8652:          break;
 8653:       case (int)VarCode::gradEta1:
 8654:          *offset = (int)((char*)&sides[0].gradEta1.x - (char*)sides);
 8655:          *sizeType = sizeof(Vector2);
 8656:          break;
 8657:       case (int)VarCode::gradEta2:
 8658:          *offset = (int)((char*)&sides[0].gradEta2.x - (char*)sides);
 8659:          *sizeType = sizeof(Vector2);
 8660:          break;
 8661:       // case (int)VarCode::ghat:
 8662:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 8663:       //    *sizeType = sizeof(Vector2);
 8664:       //    break;   
 8665:       case (int)VarCode::hhat:
 8666:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 8667:          *sizeType = sizeof(Vector2);
 8668:          break;      
 8669:       case (int)VarCode::chi:
 8670:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 8671:          *sizeType = sizeof(double);
 8672:          break;
 8673:       case (int)VarCode::n1:
 8674:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8675:          *sizeType = sizeof(Node);
 8676:          break;
 8677:       case (int)VarCode::n2:
 8678:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8679:          *sizeType = sizeof(Node);
 8680:          break;                   
 8681:       default:
 8682:          *offset = -1;
 8683:    }
 8684: }
 8685: 
 8686: 
 8687: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8688:    Node *nodes = mesh->localNodeData;
 8689: 
 8690:    *addr = nodes;
 8691:    *sizeNode = sizeof(Node);
 8692: 
 8693:    switch (varCode) {
 8694:       case (int)VarCode::depth:
 8695:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8696:          *sizeType = sizeof(double);
 8697:          break;
 8698:       case (int)VarCode::eta:
 8699:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8700:          *sizeType = sizeof(double);
 8701:          break;
 8702:       case (int)VarCode::x:
 8703:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8704:          *sizeType = sizeof(Vector2);
 8705:          break;
 8706:       case (int)VarCode::z:
 8707:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8708:          *sizeType = sizeof(double);
 8709:          break;
 8710:       case (int)VarCode::kb:
 8711:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8712:          *sizeType = sizeof(int);
 8713:          break;
 8714:       case (int)VarCode::isdry:
 8715:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8716:          *sizeType = sizeof(int);
 8717:          break;         
 8718:       case (int)VarCode::w:
 8719:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8720:          *sizeType = sizeof(double);
 8721:          break;
 8722:       case (int)VarCode::u:
 8723:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8724:          *sizeType = sizeof(Vector2);
 8725:          break;  
 8726:       case (int)VarCode::u_air:
 8727:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8728:          *sizeType = sizeof(Vector2);
 8729:          break;
 8730:       default:
 8731:          *offset = -1;    
 8732:    }  
 8733:    
 8734: }
