 2375: /**
 2376:  * This method performs backtracking from the side center until a time -dt back in time 
 2377:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2378:  * intermediate point.
 2379:  *
 2380:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2381:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2382:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2383:  * remaining time.
 2384:  * 
 2385:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2386:  * 
 2387:  * @param uuint, vvint, wwint: Velocities at the final point
 2388:  * @param jlev: Level at which the backtracking is performed
 2389:  * @param dt, dtbk: Tracking timesteps
 2390:  * @return: True if the backtracking was successful, false otherwise
 2391:  */
 2392: __inline__ __device__ bool Side::btrack(
 2393:       int jlev,
 2394:       double dt,            // Tracking time
 2395:       double dtbk,          // Tracking timestep
 2396:       Vector3 &u_int        // Velocities at the initial point
 2397: ) const {
 2398: 
 2399:    // Start from side center
 2400:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2401: 
 2402:  
 2403: 
 2404:    double time_rm = dt; // Remaining time
 2405: 
 2406: 
 2407:    // // Initialize outputs XXX
 2408:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2409:    //    sclr[i] = 0.0;
 2410:    // }
 2411: 
 2412: 
 2413:    // Initial velocities
 2414:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2415: 
 2416:    // Find the element that is in the direction opposite to the velocity
 2417:    Element* curElem = findElementTowards(toVector2(u_int));
 2418: 
 2419: 
 2420: 
 2421:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2422:    if (curElem == nullptr) {
 2423:       // Make velocity parallel to the side
 2424:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2425:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2426:       curElem = otherElem(curElem);
 2427:       
 2428:    }
 2429: 
 2430: // Nudges it towards the circumcenter
 2431: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2432: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2433:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2434: const double eps = 9.013e-3;                 
 2435: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2436: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2437: 
 2438: 
 2439: 
 2440:    const int MAX_ITERATIONS = 1000; 
 2441:    Element* nextElem = curElem;
 2442:    int iter = 0;
 2443:    while(true) {
 2444: 
 2445:       // Calculate timestep
 2446:       double dtb = min(dtbk, time_rm);
 2447: 
 2448:       // Next point in the backtracking curve
 2449:       Point3 xt = x0 - dtb*u_int;
 2450:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2451:       assert(found && "Backtracking failed in btrack");
 2452: 
 2453:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2454: 
 2455:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2456:                       // then time_rm needs to be increased by the unused time.
 2457: 
 2458:       // If the velocity is too small, we stop the backtracking
 2459:       const double vmag = length(toVector2(u_int));
 2460:       if (vmag <= velmin_btrack) break;
 2461: 
 2462:       // The current point becomes the next segment's starting point.
 2463:       x0 = xt;
 2464:  
 2465:       curElem = nextElem;
 2466: 
 2467:       iter++;
 2468:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2469:    }
 2470: 
 2471: 
 2472: }
 2473: 
 2474: 
 2475: 
 2476: // /**
 2477: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2478: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2479: 
 2480: //    Inputs:
 2481: //    @param x1, y1: point inside the element
 2482: //    @param x2, y2: other end of the line segment
 2483: 
 2484: //    Outputs:
 2485: //    @param intersectingSide:  side that intersects the line segment
 2486: //    @param nextElement: element that contains the intersection point
 2487: //    @param xIntersect, yIntersect: intersection point  
 2488: 
 2489: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2490: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2491: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2492: 
 2493: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2494: //    (Delta) being zero.
 2495: 
 2496: //    The intersection point happens when:
 2497: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2498: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2499:    
 2500: //    Assumption: the 4 points (including those of the side segment) are different.
 2501: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2502: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2503: //    If true, (xIntersect,yIntersect) is the intersection.				
 2504: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2505: // **/
 2506: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 2507: //                                                          Side& intersectingSide, Element& nextElement,
 2508: //                                                          double& xIntersect, double& yIntersect) {
 2509: //    for (int i = 0; i < i34; i++) {
 2510: //       const double x3 = nodes[i]->x;
 2511: //       const double y3 = nodes[i]->y;
 2512: //       const double x4 = nodes[nxq(i+1)]->x;
 2513: //       const double y4 = nodes[nxq(i+1)]->y;
 2514: 
 2515: //       const Side& side = sides[i];
 2516: 
 2517: //       xIntersect=-1.e25;
 2518: //       yIntersect=-1.e25;
 2519: 
 2520: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2521: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2522: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2523: 
 2524: //       if (delta != 0.0) {
 2525: //          // Solves the two linear equations for tt1 and tt2
 2526: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2527: //          const double tt2 = delta2/delta;
 2528: 
 2529: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2530: //          // Similarly, we use tt2 to compute the intersection point.
 2531: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2532: //             xIntersect = x3 + (x4 - x3)*tt2;
 2533: //             yIntersect = y3 + (y4 - y3)*tt2;
 2534: 
 2535: //             intersectingSide = side;
 2536: //             nextElement = nghbElems[i];
 2537: 
 2538: //             return true;
 2539: //          }
 2540:       
 2541: //       }
 2542: //       else {
 2543: //          // The two segments are parallel
 2544: //          return false;
 2545: //       }
 2546: 
 2547: //    }
 2548: 
 2549: //    return false;
 2550: 
 2551: // }
