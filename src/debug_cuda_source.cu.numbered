 4413: // __device__ void vertLinearInterp(double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 4414: // //     Routine to do vertical linear interpolation in z
 4415: // //     Inputs:
 4416: // //
 4417: // //       k1,k2: lower and upper limits for za, s_in 
 4418: // //       zt: desired interpolation level
 4419: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 4420: // //       s_in[0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 4421: // //     Outputs:
 4422: // //       s_out: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 4423: // //                   is used below bottom or above surface.
 4424: // //       ibelow: flag indicating if zt is below za(k1)
 4425: // //
 4426: 
 4427: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 4428: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 4429:    
 4430: //    ibelow = 0;
 4431: 
 4432: //    if (zt < za[k1]) {
 4433: //       // Below bottom
 4434: //       ibelow = 1;
 4435: //       s_out = s_in[k1];
 4436: 
 4437: //    } else if(zt>=za[k2]) {
 4438: //       // Above surface
 4439: //       s_out = s_in[k2];
 4440: 
 4441: //    } else {
 4442: //       // Normal case (between bottom and surface)
 4443:       
