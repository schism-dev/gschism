 1662: // Helper functions for computing the local node index at a given offset from another.
 1663: __device__ __inline__ int nxq(int offset, int index, int size) {
 1664:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1665:    // to the index to make it positive
 1666:    assert(index + offset + 16*size >= 0);
 1667:    return (index + offset + 16*size) % size;  
 1668: }
 1669: 
 1670: __device__ __inline__ int nxq(int index, int size) {
 1671:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1672:    // to the index to make it positive
 1673:    assert(index + 16*size >= 0);
 1674:    return (index + 16*size) % size; 
 1675: }
