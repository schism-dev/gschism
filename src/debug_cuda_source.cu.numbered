 6215:    //        call parallel_abort(errmsg)
 6216:    //      endif
 6217:    //      icount=0
 6218:    //      icount2=0
 6219:    //      do k=1,nope_global
 6220:    //        if(iabs(ifltype(k))>=4) then
 6221:    //          icount=icount+1
 6222:    //          if(icount>nfltype2) call parallel_abort('STEP: wrong counting 6')
 6223:    //          do j=1,nond_global(k)
 6224:    //            icount2=icount2+1
 6225:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 6226: 
