 1643: __device__ __inline__ double min3(double a, double b, double c) {
 1644:    return min(a, min(b, c));
 1645: }
 1646: 
 1647: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1648:    return min(a, min(b, min(c, d)));
