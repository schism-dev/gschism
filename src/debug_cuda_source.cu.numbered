 2250:    template<typename T>
 2251:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2252:       T values[4];
 2253:       getNodalValues(level, func, values);
 2254: 
 2255:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2256:       if constexpr (IsVector2<T>::value && ics == 2) {
 2257: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2258:          projectNodeVectorsToElementFrame(values);
 2259: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2260:       }
 2261: 
 2262:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2263:    }
 2264: 
 2265:    template<typename T>
 2266:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2267:       T values[4];
 2268:       getNodalValues(field, values);
 2269: 
 2270:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2271:       if constexpr (IsVector2<T>::value && ics == 2) {
 2272: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2273:          projectNodeVectorsToElementFrame(values);
 2274: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2275:       }
 2276:       
 2277:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2278:    }
 2279: 
 2280: 
 2281:    template<typename T>
 2282:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2283:       T values[4];
 2284:       getNodalValues(level, field, values);
 2285:       
 2286: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2287:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2288:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2289:       if constexpr (IsVector2<T>::value && ics == 2) {
 2290: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2291:          projectNodeVectorsToElementFrame(values);
 2292: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2293:       }
 2294: 
 2295:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2296:    }
 2297: 
 2298:    template<typename T>
 2299:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2300:       T values[4];
 2301:       getNodalValues(field, values);
 2302: 
 2303:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2304:       if constexpr (IsVector2<T>::value && ics == 2) {
 2305: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2306:          projectNodeVectorsToElementFrame(values);
 2307: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2308:       }
 2309: 
 2310:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2311:    }
 2312: 
 2313:    template<typename T>
 2314:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2315:       T values[4];
 2316:       getSideValues(field, values);
 2317:       
 2318:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2319:       if constexpr (IsVector2<T>::value && ics == 2) {
 2320: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2321:          projectSideVectorsToElementFrame(values);
 2322: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2323:       }
 2324: 
 2325:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2326:    }   
 2327: 
 2328:    template<typename T>
 2329:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2330: 
 2331:       T values[4];
 2332: 
 2333: 
 2334:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2335:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2336:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2337:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2338:       else          values[3] = T();
 2339: 
 2340:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2341: 
 2342:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2343:    }
