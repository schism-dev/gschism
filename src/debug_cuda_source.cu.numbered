 1732: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1733: // return;   
 1734:    // Lock the mutex
 1735:    lock(&debugPlotMutex);
 1736:  
 1737:    bool ok = true;
 1738:    if (debugPlotIdx == nullptr) ok = false;
 1739:    if (*debugPlotIdx >= 10000) ok = false;
 1740:    if (ok) {
 1741:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1742:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1743:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1744:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1745:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1746:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1747:       (*debugPlotIdx)++;
 1748:    }
 1749: 
 1750:    __threadfence();               // ensure all above writes are visible
 1751:    // Unlock the mutex
 1752:    unlock(&debugPlotMutex);
 1753: 
 1754: }
