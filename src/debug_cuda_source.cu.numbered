 4142:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4143: 
 4144:       NODE_BND(nodeBnd);
 4145: 
 4146:       Node *node = nodeBnd->node;
 4147: 
 4148:       node->ETP = 0.0;
 4149: 
 4150:       for (int j=0; j<ntip; j++) {
 4151: 
 4152:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4153:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4154:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4155: 
 4156:          if constexpr(iloadtide==1) { // loading tide
 4157:             assert(false && "Loading tide not implemented");
 4158:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4159:          }
 4160:          
 4161:       }
 4162:       
 4163:    }
