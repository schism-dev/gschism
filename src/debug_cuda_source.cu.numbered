 8207: #ifdef OLD_PCG_SOLVER
 8208: __global__ void computeMatrixProductAndDotProducts() {
 8209:    // Computes A*p, r'Mr and p'Ap
 8210: 
 8211:    // 1) shared buffer: first half for rMr, second for pAp
 8212:    __shared__ double sdata[2*BLOCK_SIZE];
 8213:    double* s_rMr = sdata;
 8214:    double* s_pAp = sdata + BLOCK_SIZE;
 8215: 
 8216:    const int tid = threadIdx.x;
 8217: 
 8218:    double l_pAp = 0.0;
 8219: 
 8220:    s_rMr[tid] = 0.0;
 8221:    s_pAp[tid] = 0.0;
 8222: 
 8223:    // 2) get your node pointer
 8224:    // NODE(node);   
 8225:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8226:    Node *node = &(mesh->localNodeData[idx_node]); 
 8227:       if (idx_node < mesh->np) {
 8228: 
 8229:       const double diag = node->coeffDiag;
 8230:       const double r    = node->mR;
 8231:       const double p    = node->mP;  
 8232: 
 8233:       // apply preconditioner on the fly:
 8234:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8235: 
 8236:       // 4) compute Ap = A.p
 8237:       double Ap = node->coeffDiag * node->mP;
 8238:       for (int j = 0; j < node->numNodes; ++j) {
 8239:          const Node *nbNode = node->nodes[j];
 8240:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8241: 
 8242:       }
 8243: 
 8244:       node->mAp = Ap;
 8245:       
 8246: 
 8247:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8248:       // const double l_rMr = r*Mr;  // r'Mr
 8249:       l_pAp = p*Ap;  // p'Ap
 8250: 
 8251: 
 8252:    }
 8253: 
 8254:    // 6) write into shared mem
 8255:    // s_rMr[tid] = l_rMr;
 8256:    s_pAp[tid] = l_pAp;
 8257: 
 8258:    __syncthreads();
 8259: 
 8260:    // 7) block-wide tree reduction
 8261:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8262:       if (tid < stride)  {
 8263:          s_pAp[tid] += s_pAp[tid + stride];
 8264:       }
 8265:       __syncthreads();
 8266:    }
 8267: 
 8268:    // 8) thread 0 atomically accumulates into the globals
 8269:    // XXX: This is slower than it needs to be, but it is simple and works
 8270:    if (tid == 0) {
 8271:       atomicAdd(pAp, s_pAp[0]);
 8272:    }
 8273: 
 8274: 
 8275: }
 8276: 
 8277: 
 8278: __global__ void updateSolutionAndDotProducts(void) {
 8279:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8280: 
 8281:    const int tid = threadIdx.x;
 8282: 
 8283:    s_rMr[tid] = 0.0;
 8284: 
 8285:    // get node & bounds-check:
 8286:    NODE(node);
 8287: 
 8288:    
 8289:    // Compute alpha
 8290:    const double alpha = (*rMr_old)/(*pAp); 
 8291: 
 8292: 
 8293:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8294: 
 8295: 
 8296:    // load scalars
 8297:    const double diag = node->coeffDiag;
 8298:    const double p    = node->mP;
 8299:    const double Ap   = node->mAp;
 8300:    const double x    = node->mX;
 8301:    const double r    = node->mR;
 8302:    
 8303:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8304: 
 8305:    // 1) update solution & residual
 8306:    const double x_new = x + alpha*p;
 8307:    const double r_new = r - alpha*Ap;
 8308:    node->mX = x_new;
 8309:    node->mR = r_new;
 8310: 
 8311:    // 2) apply Jacobi preconditioner on the fly
 8312:    const double Mr_new = r_new/diag;
 8313: 
 8314: 
 8315:    // 3) local contributions for the two dot-products
 8316:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8317: 
 8318:    // 4) write into shared-mem
 8319:    s_rMr[tid] = l_rMr;
 8320: 
 8321:    __syncthreads();
 8322: 
 8323: 
 8324:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8325:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8326:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8327:       __syncthreads();
 8328:    }
 8329: 
 8330:    // 6) thread 0 atomically folds into the global accumulators
 8331:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8332: 
 8333: 
 8334: }
 8335: 
 8336: 
 8337: __global__ void updateSearchDirection() {
 8338: 
 8339:     NODE(node);
 8340: 
 8341:     // recompute z on-the-fly
 8342:     const double z = node->mR / node->coeffDiag;
 8343:     const double p = node->mP;
 8344: 
 8345:     const double beta = (*rMr_new)/(*rMr_old);
 8346: 
 8347: 
 8348:     // p =z + beta*p
 8349:     node->mP = z + beta*p;
 8350: 
 8351: }
 8352: 
 8353: __global__ void initializeScalars(double *scalars) {
 8354: 
 8355:    // These point to a cupy array in the host code
 8356:    rMr_old = scalars + 0;
 8357:    rMr_new = scalars + 1;
 8358:    pAp     = scalars + 2;
 8359: }
 8360: 
 8361: __global__ void initializePreconditionedResidual(void) {
 8362: 
 8363:     __shared__ double s_rMr[BLOCK_SIZE];  
 8364: 
 8365:     s_rMr[threadIdx.x] = 0.0;
 8366: 
 8367:     NODE_ALL(node, valid);
 8368:     const int tid = threadIdx.x;
 8369:     // For the first iteration:
 8370:     // 1. Initial solution x = 0 (already set)
 8371:     // 2. Initial residual r = b (stored in qel)
 8372:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8373: 
 8374: // XXX we should use the guess solution here    
 8375: 
 8376:     double l_rMr = 0.0;
 8377:     if (valid) {
 8378:       // Set initial residual r = b (from qel)
 8379:       node->mR = node->qel;
 8380: 
 8381:       // Compute z = M^-1 * r (preconditioned residual)
 8382:       const double z = node->mR / node->coeffDiag;
 8383: 
 8384:       // Set initial search direction p = z
 8385:       node->mP = z;
 8386: 
 8387:       // Initialize other variables needed for CG
 8388:       node->mX = 0.0;  // Initial solution
 8389:       node->mAp = 0.0; // Will be computed in first iteration
 8390: 
 8391: 
 8392:       // Computes the first r'Mr (reduction)
 8393:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8394:     }
 8395:     // 4) write into shared-mem
 8396:     s_rMr[tid] = l_rMr;
 8397: 
 8398:     __syncthreads();
 8399: 
 8400: 
 8401:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8402:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8403:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8404:         __syncthreads();
 8405:     }
 8406: 
 8407:     // 6) thread 0 atomically folds into the global accumulators
 8408:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8409: 
 8410:     *rMr_old = 0.0;
 8411:     *pAp = 0.0;
 8412: }
 8413: #endif
 8414: 
 8415: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8416: 
 8417:    ELEM(elem);
 8418: 
 8419:    switch (varCode) {
 8420:       case (int)VarCode::outputCoords:
 8421:          const Point2 coords = elem->outputCoords();
 8422:          res[elem->idx*2    ] = coords.x;
 8423:          res[elem->idx*2 + 1] = coords.y;
 8424:          break;
 8425:    }
 8426: }
