 2596:    template<typename T>
 2597:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2598:       T values[4];
 2599:       getNodalValues(level, func, values);
 2600: 
 2601:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2602:       if constexpr (IsVector2<T>::value && ics == 2) {
 2603: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2604:          projectNodeVectorsToElementFrame(values);
 2605: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2606:       }
 2607: 
 2608:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2609:    }
 2610: 
 2611:    template<typename T>
 2612:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2613:       T values[4];
 2614:       getNodalValues(field, values);
 2615: 
 2616:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2617:       if constexpr (IsVector2<T>::value && ics == 2) {
 2618: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2619:          projectNodeVectorsToElementFrame(values);
 2620: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2621:       }
 2622:       
 2623:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2624:    }
 2625: 
 2626: 
 2627:    template<typename T>
 2628:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2629:       T values[4];
 2630:       getNodalValues(level, field, values);
 2631:       
 2632: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2633:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2634:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2635:       if constexpr (IsVector2<T>::value && ics == 2) {
 2636: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2637:          projectNodeVectorsToElementFrame(values);
 2638: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2639:       }
 2640: 
 2641:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2642:    }
