  424: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  425:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  426:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  427: }
  428: 
  429: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  430:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  431:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  432: }
  433: 
  434: 
  435: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  436:    x3 = y1*z2 - y2*z1;
  437:    y3 = x2*z1 - x1*z2;
  438:    z3 = x1*y2 - x2*y1;
  439: }
