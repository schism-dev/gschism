 4826: 
 4827:    __global__ void backtrackAllNodes(void) {
 4828: 
 4829:       // max/min # of sub-divisions
 4830:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4831:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4832: 
 4833: 
 4834:       SIDE(side);
 4835: 
 4836:       const int kb = side->kb;
 4837: 
 4838: 
 4839:       // Initialize btrack velocities to the actual velocities at the side 
 4840:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4841: 
 4842:   
 4843: 
 4844:       if (side->isDry) return;
 4845:      
 4846: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4847: 
 4848:       // Checks that at least one element is not dry
 4849:       const Element *elem1 = side->elems[0];
 4850:       const Element *elem2 = side->elems[1];
 4851: 
 4852: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4853: 
 4854:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4855:       
 4856:       // XXXXXX
 4857:       // !swild_tmp to store global coord. of the starting side
 4858:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4859:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4860:       // !Use sframe2 
 4861:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4862: 
 4863: 
 4864:       for (int k = kb; k < nvrt; k++) {
 4865:       //  Initialize (xt,yt,zt), nnel and vel.
 4866:       //  For ics=2, the coordinates are all in the side's local frame
 4867:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4868: 
 4869:          const int iadvf = side->iadv();  // Advection flag   
 4870:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4871: 
 4872:          // If on land or open boundary...
 4873:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4874:          
 4875:          const double vmag = length(side->u2[k]);
 4876: 
 4877:          if (vmag <= velmin_btrack) {
 4878:             // No activity 
 4879: 
 4880:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4881: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4882: 
 4883:             
 4884:          } else {  // do btrack
 4885: 
 4886:             // Compute number of sub-divisions based on local gradients of the velocity field
 4887: 
 4888:             // XXX IS THIS NECESSARY?
 4889:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4890:             double suma = 0.0;
 4891:             int icount = 0;
 4892:             for (int l=0; l<2; l++) {
 4893:             // For each element sharing the side...
 4894: 
 4895:                const Element *elem = side->elems[l];
 4896:                  
 4897:                if (elem == nullptr) continue;
 4898: 
 4899:                icount++;
 4900: 
 4901:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4902:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4903:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4904: 
 4905:                double utmp[4];
 4906:                double vtmp[4];
 4907:                for (int j = 0; j < elem->i34; j++) {
 4908: 
 4909:                   const Node *node = elem->nodes[j];
 4910: 
 4911:                   if constexpr(ics==1) {
 4912:                      utmp[j] = node->u2[k].x;
 4913:                      vtmp[j] = node->u2[k].y;  
 4914: 
 4915:                   } else {
 4916:                      // 'Project' the velocity from the node frame to the element frame
 4917:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4918:                      utmp[j] = tmp_u2.x;
 4919:                      vtmp[j] = tmp_u2.y;
 4920: 
 4921:                   }
 4922:                } // for j
 4923: 
 4924:                const Vector2 grad_u = elem->grad2(utmp); 
 4925:                const Vector2 grad_v = elem->grad2(vtmp);
 4926:    
 4927:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4928:             } // for ii
 4929: 
 4930:             assert(icount > 0 && "Impossible 77");
 4931: 
 4932:             // '4' is somewhat arbitrary
 4933:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4934:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4935:             Vector3 u_int = {0.0, 0.0, 0.0};
 4936: 
 4937:             bool res =side->btrack(k, dt, dtbk, u_int);
 4938: 
 4939:             side->btu[k] = toVector2(u_int);
 4940:                
 4941:          } // if vmag (do backtrack)
 4942: 
 4943: 
 4944:       } // for k=kb,nvrt-1
 4945: 
 4946:    }
 4947: 
 4948: } // extern "C"
 4949: 
 4950: template<int nc>
 4951: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4952: 
 4953: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4954: //
 4955: // a,b,c,rhs: input vectors and are not modified by this program.
 4956: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4957: // rhs is the r.h.s.
 4958: // n: actual rank of the system.
 4959: // rows in u() and rhs();
 4960: // u: output with nc columns (transposed to rows)
 4961: // gam: a working array.
 4962: //
 4963: // NOTES:
 4964: // This is a template function that allows for different numbers of columns in the rhs vector.
 4965: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4966: 
 4967:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4968:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4969: 
 4970:    double bet = b[0];
 4971:    if constexpr (nc == 1) {
 4972:       u[0] = rhs[0]/bet;
 4973:    } else {
 4974:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4975:    }
 4976: 
 4977:    for (int j = 1; j < n; j++) {
 4978:       gam[j] = c[j - 1]/bet;
 4979:       bet = b[j] - a[j]*gam[j];
 4980: 
 4981:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4982: 
 4983:       if constexpr (nc == 1) {
 4984:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4985:       } else {
 4986:          for (int l = 0; l < nc; l++) {
 4987:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4988:          }
 4989:       }
 4990:    }
 4991: 
 4992:    // Back-substitution
 4993:    for (int j = n - 2; j >= 0; j--) {
 4994:       if constexpr (nc == 1) {
 4995:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4996:       } else {
 4997:          for (int l = 0; l < nc; l++) {
 4998:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4999:          }
 5000:       }
 5001:    }
 5002: }
 5003: 
 5004: 
 5005: 
 5006: // Helper function that contains the core algorithm
 5007: template<typename XAccessor, typename YAccessor>
 5008: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5009:                                     double  yp_top, double  yp_bot, 
 5010:                                     CubicSpline &spline) {
 5011:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5012:    // 
 5013:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5014:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5015:    //
 5016:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5017:    // 
 5018:    // Inputs: 
 5019:    //            n: dimension for x etc; # of data pts (>=2);
 5020:    //            getX, getY: functions to access x,y coordinates
 5021:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5022:    //     Output: 
 5023:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5024: 
 5025:    const int n = k2 - k1 + 1;
 5026:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5027: 
 5028:    // Allocate memory for the splines
 5029:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5030:    spline.x   = new double[n];
 5031:    spline.y   = new double[n];
 5032:    spline.yp  = new double[n];
 5033:    spline.ypp = new double[n];
 5034: 
 5035:    for (int k=k1; k<=k2; k++) {
 5036:       spline.x[k] = getX(k);
 5037:       spline.y[k] = getY(k);
 5038:    }
 5039: 
 5040:    // This is to simplify expressions later
 5041:    double *x = spline.x;
 5042:    double *y = spline.y;
 5043: 
 5044:    double *a = nullptr;
 5045:    double *b = nullptr;
 5046:    double *c = nullptr;
 5047:    double *gam = nullptr;
 5048:    double *rhs = nullptr;
 5049:    
 5050: 
 5051:       a = new double[n];   // Lower diagonal
 5052:       b = new double[n];   // Diagonal
 5053:       c = new double[n];   // Upper diagonal
 5054:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5055:       rhs = new double[n]; // Right-hand side
 5056: 
 5057:    for (int k=k1; k<=k2; k++) {
 5058:       if (k == k1) {
 5059:          // Bottom level
 5060:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5061:          b[k] = (x[k+1] - x[k])/3.0;
 5062:          c[k] = b[k]/2.0;
 5063:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5064:       } else if (k == n - 1) {
 5065:          // Top level (surface)
 5066:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5067:          b[k] = (x[k] - x[k-1])/3.0;
 5068:          a[k] = b[k]/2.0;
 5069:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5070:       } else {
 5071:          // Intermediate levels
 5072:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5073:          b[k] = (x[k+1] - x[k-1])/3.0;
 5074:          a[k] = (x[k  ] - x[k-1])/6.0;
 5075:          c[k] = (x[k+1] - x[k  ])/6.0;
 5076:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5077:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5078:       }
 5079:    }
 5080: 
 5081:    // Solve the tridiagonal system
 5082:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5083:    
 5084:    spline.yp[k1] = yp_bot;
 5085:    spline.yp[k2] = yp_top;
 5086: 
 5087:    // Compute rest of 1st derivatives using the splines
 5088:    for (int k=k1+1; k<k2; k++) {
 5089:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5090:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5091:    }
 5092:    
 5093:    delete[] a;
 5094:    delete[] b;
 5095:    delete[] c;
 5096:    delete[] gam;
 5097:    delete[] rhs;
 5098: 
 5099: }
 5100: 
 5101: // Array version
 5102: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5103:                                 double y_top, double y_bot, 
 5104:                                 CubicSpline &spline) {
 5105:    auto getX = [x] (int k) { return x[k]; };
 5106:    auto getY = [y] (int k) { return y[k]; };
 5107:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5108: }
 5109: 
 5110: // Lambda version - allows custom access patterns
 5111: template<typename XFunc, typename YFunc>
 5112: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5113:                                 double y_top, double y_bot,
 5114:                                 CubicSpline &spline) {
 5115:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5116: }
