 6744: #ifdef DONTCOMPILE
 6745: __device__ void computeVerticalAdvection(void) {
 6746:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6747: 
 6748:    sdbt(1:2,:,:)=0.d0
 6749: 
 6750:    const Side *side = FROM kernel;
 6751: 
 6752:    if(side->isDry) return;
 6753: 
 6754:    // If side is wet...
 6755: 
 6756: 
 6757:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6758:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6759:    double ws[nvrt] = {} // w @ side
 6760:    int icount = 0;
 6761:    for (int j=0; j<2; j++) {
 6762:       const Element *elem = side->elements[j];
 6763:        
 6764:       if(elem != nullptr) {
 6765:          icount++;
 6766:          for (int k=0; k<nvrt; k++) {
 6767:             ws[k] = ws[k] + elem->w[k];
 6768:          }
 6769:       }
 6770:    }  // for j
 6771: 
 6772:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6773:    ws = ws/icount;
 6774: 
 6775:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6776:    // Splines allow for a smooth transition between vertical levels.
 6777:    // Splines have continuity restrictions at the internal knots, but
 6778:    // we have to provide the 1st derivatives at the endpoints.
 6779:    const int kbs = side->kbs; 
 6780:    
 6781:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6782:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6783:    initCubicSpline(kbs, nvrt, side, ws, up)
 6784: 
 6785:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6786:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6787:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6788: 
 6789:    // Total advection (average onto side)
 6790:    const Node *node1 = side->nodes[0];
 6791:    const Node *node2 = side->nodes[1];
 6792:    for (int k=kbs(i); k<nvrt; k++) {
 6793: 
 6794:       if constexpr(ics==1) {
 6795:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6796:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6797:       } else {
 6798:          // XXX IMPLEMENT THIS
 6799:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6800:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6801:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6802:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6803:       }  // if ics
 6804: 
 6805: 
 6806:    }
 6807: }
 6808: #endif
 6809: 
 6810: 
 6811: extern "C" {
 6812:    __global__ void computeElemAverageGhat(void) {
 6813:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6814: 
 6815:       ELEM(elem);
 6816:       
 6817:       elem->ghat1= {0.0, 0.0};  
 6818: 
 6819:       if constexpr(ihydraulics != 0) {
 6820:          if (nhtblocks > 0 && elem->isblock) return;
 6821:       }
 6822: 
 6823:       if (elem->isDry) return;
 6824: 
 6825:       // Wet elements.
 6826:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6827:       // tidal potential, horizontal diffusion, and baroclinic etc
 6828:       // Remember to update both fb and F 
 6829:       // If ics=2, ghat1 are in eframe (ll)
 6830:       // cff1-3: coefficients for 2D/3D
 6831:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6832:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6833:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6834: 
 6835:       double av_cff1 = 0.0;  // av. for cff1
 6836:       double av_cff2 = 0.0;  // av. for cff2
 6837:       double av_cff3 = 0.0;  // av. for cff3
 6838:       double av_df = 0.0;  // av. for H^\alpha / H
 6839:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6840:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6841: 
 6842:       const int i34 = elem->i34;
 6843:       const int kb = elem->kb;
 6844: 
 6845:       for (int j=0; j<i34; j++) {
 6846:          // For each node and side in the element...
 6847: 
 6848:          const Node *node = elem->nodes[j];
 6849:          const Side *side = elem->sides[j];
 6850: 
 6851:          const double chi      = side->chi;
 6852:          const double veg_c2   = side->veg_c2;
 6853:          const double veg_beta = side->veg_beta;
 6854:          const double veg_h    = side->veg_h();
 6855:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6856: 
 6857:          // Node - const in elem
 6858:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6859:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6860: 
 6861:          if (elem->depth >= tip_dp) {
 6862:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6863:          }
 6864: 
 6865:          
 6866:          const double htot  = side->htot2();        // Total depth at the side
 6867:          const double zctr2 = side->zTopCanopy();  
 6868: 
 6869:          double cff1; 
 6870:          double cff2; 
 6871:          double cff3;   
 6872:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6873:          // coefficients applied to 2D/3D case 
 6874:             cff1 = side->hhat/htot;
 6875:             cff2 = 0.0;
 6876:             cff3 = 0.0;
 6877:          } else { //3D
 6878:             //Init for no-veg case
 6879:             cff1 = 1.0;
 6880:             cff2 = 1.0;
 6881:             cff3 = 0.0;
 6882: 
 6883:             if constexpr(iveg != 0) {
 6884:                // Computes coefficients used with vegetation terms G1, G2
 6885:                // cff1, cff3 are used for the first two terms in G1, G2:
 6886:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6887:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6888:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6889:                if(veg_h < 0.99*htot) { // submergent vegetation
 6890:                   cff1=1;
 6891:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6892:                   cff3 = veg_c;
 6893: 
 6894:                } else { // emergent vegetation
 6895:                   cff1 = 1.0/(1.0 + veg_c2);
 6896:                   cff2 = cff1;
 6897:                   cff3 = 0.0;
 6898: 
 6899:                }
 6900:             } // if iveg
 6901:          } //  2D/3D
 6902: 
 6903:          av_cff1 += cff1/i34;
 6904:          av_cff2 += cff2/i34;
 6905:          av_cff3 += cff3/i34;
 6906:          av_cff2_chi += cff2*chi/i34;
 6907:          av_cff3_chi += cff3*chi/i34;
 6908:          av_df += min(htot, veg_h)/(htot*i34);
 6909: 
 6910: 
 6911:          // btrack values: U^\star, U^{\star\alpha}
 6912:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6913:          Vector2 Ustar       = {0.0, 0.0}; 
 6914:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6915: 
 6916:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6917:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6918:          } else { //3D
 6919:             for (int k = side->kb; k < nvrt; k++) {
 6920:             
 6921:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6922:                Ustar += w2;
 6923: 
 6924:                if constexpr(iveg != 0) {
 6925:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6926:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6927:                        Ustar_alpha += zrat*w2; // XXXX
 6928:                    }
 6929:                }  // if iveg
 6930:             }  // for k
 6931:          }  //2D/3D
 6932:          
 6933: 
 6934:          // Add btrack & surface stress terms to \breve{G} first
 6935:          if constexpr(ics==1) {
 6936: 
 6937:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6938: 
 6939:          } else {
 6940:             // XXX IMPLEMENT THIS
 6941:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6942:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6943:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6944:          }  // if ics
 6945: 
 6946:          // Surface and bottom stress terms
 6947:          if constexpr(ics==1) {
 6948:             const Vector2 tau    = side->tau();
 6949:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6950: 
 6951:             // Term for surface and bottom stress
 6952:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6953: 
 6954:          } else {
 6955:             assert(false && "computeElemAverageGhat: Not implemented");
 6956:             // XXX IMPLEMENT THIS
 6957:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6958:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6959:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6960:             // tau_x=(vn1+tt1)/2.d0
 6961:             // tau_y=(vn2+ss1)/2.d0
 6962:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6963:          }  // if ics
 6964: 
 6965:          
 6966: 
 6967:          // All terms in F,F^\alpha,f_b except baroclinic
 6968:          // F, f_b: all explicit terms excluding vegetation 
 6969:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6970:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6971:          const double coriolis = side->coriolis;
 6972:          Vector2 F  =  coriolis*side->U;  // F_x
 6973:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6974:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6975: 
 6976:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6977:             
 6978:             for (int k = side->kb; k < nvrt; k++) {
 6979:                if (zctr2 > side->zc[k-1]) {
 6980:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6981:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6982:                    Fa +=  coriolis*w2*zrat;
 6983:                } // if zctr2
 6984:             } // k
 6985:          } // iveg
 6986: 
 6987:          // Integrate horizontal viscosity force vertically
 6988:          for (int k=side->kb + 1; k<nvrt; k++) {
 6989:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6990: 
 6991:             F += levelHorVisc;
 6992: 
 6993:             // Vegetation term
 6994:             if constexpr(iveg!=0) {
 6995:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6996:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6997:                   Fa += levelHorVisc*zrat;
 6998:                } 
 6999:             } // if iveg
 7000:          } // for k
 7001: 
 7002:          fb += side->nuGradU[side->kb];
 7003: 
 7004:          // Add to ghat1
 7005:          if constexpr(ics==2) {
 7006:             // XXX IMPLEMENT THIS
 7007:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7008:             // bigf1=vn1; bigf2=vn2
 7009:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7010:             // botf1=vn1; botf2=vn2
 7011:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7012:             // bigfa1=vn1; bigfa2=vn2
 7013:          } // if ics
 7014: 
 7015:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7016:       } // for j (nodes and sides)
 7017: 
 7018:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7019:          
 7020:       // Finish off terms in F, F^\alpha and f_b
 7021:       const double grav3 = elem->mean(&Node::grav2);
 7022:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7023: 
 7024: 
 7025:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7026:       for (int j=1; j<i34; j++) { 
 7027:          // For each side in the element...
 7028:          const Side *side = elem->sides[j];
 7029:          const double chi = side->chi;
 7030: 
 7031:          const double htot = side->htot2();
 7032:          const double veg_h = side->veg_h();
 7033:          const Vector2 F  = htot*fb;
 7034:          const Vector2 Fa = min(htot, veg_h)*fb;
 7035: 
 7036:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7037:       } // for j
 7038: 
 7039:       //botf1 etc are already in elem frame
 7040:       elem->ghat1 += tmp/i34;
 7041: 
 7042:       // Baroclinic force
 7043:       if constexpr(ibc==0) {
 7044:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7045: 
 7046:          Vector2 Fa = {0.0, 0.0};
 7047:          Vector2 intGradRho = {0.0, 0.0};
 7048:          
 7049:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7050:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7051:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7052: 
 7053:             // \in F [m^2/s/s]
 7054:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7055:          }
 7056: 
 7057:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7058:          const Vector2 F = av_df*Fa; //approx
 7059:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7060: 
 7061:       } // if ibc
 7062: 
 7063: 
 7064: 
 7065:    }
 7066: 
 7067: } // extern "C"
 7068: 
 7069: 
 7070: 
 7071: #ifdef DONTCOMPILE
 7072: __global__ void checkMassConservation(Tracers* sumtr) {
 7073: 
 7074:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7075: 
 7076:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7077: 
 7078:    Element *elem = &(mesh->localElemData[i]);
 7079: 
 7080:    // Skip dry elements
 7081:    if (elem->isDry) return;
 7082: 
 7083:    // Local sum array for this thread
 7084:    double localSum[N_TRACERS] = {0.0};
 7085: 
 7086:    // Sum over vertical levels for this element
 7087:    const int kbe = elem->kbe;
 7088:    const double area = elem->area;
 7089: 
 7090:    for (int k = kbe; k < nvrt; k++) {
 7091:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7092:       
 7093:       // Accumulate tracer mass
 7094:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7095:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7096:       }
 7097:    }
 7098: 
 7099:    //  This function returns per element sums. A reduction must be done on the host side.
 7100: }
 7101: 
 7102: 
 7103: __global__ void transport(void) {
 7104: 
 7105:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7106: 
 7107:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7108: 
 7109:    Element *elem = &(mesh->localElemData[ie]);
 7110: 
 7111:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7112: 
 7113:                for (int m=0; m<ntr; m++) {
 7114:                   for (int k=kbe(ie); k<nvrt; k++) {
 7115:                      // Calculate each polynomial's weight 
 7116:                      wm=0.d0; sum1=0.d0; 
 7117:                      wm1=0.d0; wm2=0.d0; 
 7118:                      for (int i=0; i<elem->nweno2; i++) {
 7119:                   
 7120:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7121:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7122:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7123:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7124:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7125:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7126:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7127:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7128:                      // -----------------Hu and Shu (1999)'s method----------------
 7129:                      b4=b1+b2+b3
 7130: 
 7131: //Error: add PRODUCTION CPP
 7132: #ifdef DEBUG
 7133:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7134:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7135:                     call parallel_abort(errmsg)
 7136:                   }
 7137: #endif
 7138: 
 7139:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7140:                   // !----test-------------- 
 7141:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7142:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7143:                   // !wm(i)=wm1(i)*wm2(i)
 7144:                   // !---------------------- 
 7145:                   sum1=sum1+wm(i)
 7146:                 } // end for i
 7147: 
 7148:                 wm=wm/sum1
 7149: 
 7150:                 for (int j=0; j<elem->i34; j++) {
 7151: 
 7152:                   const Side *side  = elem->sides[j];
 7153:                   const Node *node1 = side->n1;
 7154:                   const Node *node2 = side->n2;
 7155: 
 7156:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7157:                      trsd=0.d0
 7158:                      for (int kk=0; kk<nquad; kk++) {
 7159:                         for (int i=0; i<elem->nweno2; i++) {
 7160:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7161:                         } // end for i   
 7162:                      } // end for kk
 7163:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7164:                   } // outward flux
 7165:                } // end for j=1,i34(ie) ! side
 7166:             }
 7167:          }
 7168:               
 7169: 
 7170: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7171: //             //   calculate each polynomial's weight 
 7172: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7173: //                 wm=0.d0; sum1=0.d0
 7174: //                 do i=1,nweno1(ie) !for each polynomial
 7175: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7176: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7177: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7178: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7179: //                   wm(i)=b2
 7180: //                   sum1=sum1+b2
 7181: //                   !wm(i)=1.d0
 7182: //                   !sum1=sum1+1.d0
 7183: 
 7184: // // Error: PRODUCTION
 7185: // #ifdef DEBUG
 7186: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7187: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7188: //                     call parallel_abort(errmsg)
 7189: //                   endif
 7190: // #endif
 7191: 
 7192: //                 enddo !i
 7193: //                 wm=wm/sum1 !final weight
 7194: 
 7195:                 for (int j=0; j<elem->i34; j++) { // side
 7196:                   const Side *side = elem->sides[j];
 7197:                   const Node *node1 = side->n1;
 7198:                   const Node *node2 = side->n2;
 7199: 
 7200:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7201:                     trsd=0.d0
 7202:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7203:                       for (int i=0; i<elem->nweno1; i++) {
 7204:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7205:                       }
 7206:                     enddo //kk
 7207:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7208:                   } // outward flux
 7209:                 } // end for j=1,i34(ie) ! side
 7210:               } // end for k; ntr 
 7211: 
 7212:             else !simple upwind method
 7213:               do j=1,i34(ie)
 7214:                 jsj=elside(j,ie)
 7215:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7216:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7217:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7218:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7219:                   endif
 7220:                 enddo  !vertical layers
 7221:               enddo !j=1,i34(ie) ! side
 7222:             endif !order of accuracy
 7223: 
 7224:          //  enddo !ie
 7225: // !$OMP     end do
 7226: 
 7227: // !$OMP     master
 7228: //           !message passing
 7229: //           if (nproc>1) then
 7230: //             !make a copy of side concentrations
 7231: //             trsd_tmp0=trsd_tmp 
