  525: 
  526: struct Frame {
  527:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  528:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  529:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  530:     double t00, t10;        // col0 (t20=0 implicit)
  531:     double t01, t11, t21;   // col1
  532: 
  533:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  534: 
  535:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  536:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  537: 
  538:       double sin_lon, cos_lon, sin_lat, cos_lat;
  539:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  540:       sincos(lat, &sin_lat, &cos_lat);
  541: 
  542:       t00 = -sin_lon;
  543:       t10 =  cos_lon;
  544:       t01 = -cos_lon*sin_lat;
  545:       t11 = -sin_lon*sin_lat;
  546:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  547: // printf("lat = %f, lon = %f, cos_lat = %f, sin_lat = %f, cos_lon = %f, sin_lon = %f\n", lat, lon, cos_lat, sin_lat, cos_lon, sin_lon);
  548: // printf("t00 = %f, t10 = %f, t01 = %f, t11 = %f, t21 = %f\n", t00, t10, t01, t11, t21);
  549: 
  550:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  551:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  552: 
  553:       const double col1_norm_inv = 1.0/col1_norm;
  554:       t01 = t01*col1_norm_inv;
  555:       t11 = t11*col1_norm_inv;
  556:       t21 = t21*col1_norm_inv;
  557: 
  558:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  559: 
  560: 
  561:    }
  562: 
  563:    __forceinline__ __device__ void print(void) const {
  564:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  565:    }
  566: 
  567:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  568:       // cross(col0, col1), with t20=0 implicitly:
  569:       // |  i       j       k   |
  570:       // | t00     t10      0   |
  571:       // | t01     t11     t21  |
  572:       t02 =  t10*t21;
  573:       t12 = -t00*t21;
  574:       t22 =  t00*t11 - t10*t01;
  575:    }
  576: 
  577: 
  578:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  579:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  580:    // Inputs:
  581:    //        vec0: vel. in this frame;
  582:    //        frameout: Output frame;
  583:    // Output: 
  584:    //        vel. in new frame  
  585:    //
  586:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  587:    // discarding the z-component of the result to keep only the local horizontal
  588:    // plane of frame 2.
  589:    //
  590:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  591:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  592:    // are orthogonal. This product is computed as dot products between columns of
  593:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  594:    // columns of F2.// 
  595: 
  596:       auto const fo = frameout; // Just an alias for the output frame.
  597:       Vector2 res;
  598: 
  599:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  600:       // of t and fo.t are the same.
  601:       const double d00 = t00*fo.t00 + t10*fo.t10;
  602:       const double d10 = t01*fo.t00 + t11*fo.t10;
  603: 
  604:       const double d01 = t00*fo.t01 + t10*fo.t11;
  605:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  606: 
  607:       res.x = vec0.x * d00 + vec0.y * d10;
  608:       res.y = vec0.x * d01 + vec0.y * d11;
  609: 
  610:       return res;
  611:    }
  612: 
  613:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  614:       Vector3 vo;
  615:       double t02, t12, t22;
  616: 
  617:       // Compute the 3rd column of the frame tensor
  618:       getCol2(t02, t12, t22);
  619: 
  620:       vo.x = vi.x*t00 + vi.y*t10;
  621:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  622:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  623: 
  624:       return vo;
  625:    
  626:    }
  627: 
  628:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  629:       Vector3 vo;
  630:       double t02, t12, t22;
  631: 
  632:    // Compute the 3rd column of the frame tensor
  633:       getCol2(t02, t12, t22);
  634: 
  635:       // F * vi (non-transposed, so we use rows of F)
  636:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  637:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  638:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  639: 
  640:       return vo;
  641:    }
  642: 
  643:    // Unit vectors that define the local frame
  644:    __forceinline__ __device__ Vector3 nUp(void) const {
  645:       // Column 2 = cross(column0, column1)
  646:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  647:    }
  648: 
  649:    __forceinline__ __device__ Vector3 nZonal(void) const {
  650:       // Column 0
  651:       return { t00, t10, 0.0 };
  652:    }
  653: 
  654:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  655:       // Column 1
  656:       return { t01, t11, t21 };
  657:    }
  658: 
  659: };
