  890:                                        Point3 &xt, double zint, Vector3 &u_int);
  891:     
  892:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  893:                                                  Element *&nextElem, int &jlev, double &dt, double time_rm,
