 7695: __global__ void printMatrix(bool full) {
 7696:    // Debugging: print the matrix
 7697: 
 7698:    const int size = mesh->np;
 7699:    double sum = 0.0;
 7700:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7701:       const Node *node = mesh->localNodeData + idx_node;
 7702:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7703:       for (int j = 0; j < node->numNodes; j++) {
 7704:          Node* nbNode = node->nodes[j];
 7705:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7706:          sum += node->coeffMatrix[j];
 7707:       }
 7708:       if (full) printf("]\n");
 7709: 
 7710: 
 7711:    }
 7712:    if (!full) printf("sum=%lf\n", sum);
 7713: }
