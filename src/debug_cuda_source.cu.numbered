 1070: 
 1071:    double mP; // Search direction for conjugate gradient method
 1072:    double mR; // Residual for conjugate gradient method
 1073:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1074:    double mX; // Solution for conjugate gradient method
