 1215: struct Node {
 1216: 
 1217:    // Geometry information
 1218:    int idx;        // Index of the node
 1219:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1220:    int numNodes;   // Number of nodes neighbors of this node
 1221: 
 1222:    Element **elements; // Array of pointers to the elements that share this node
 1223:    int numElements;    // Number of elements that share this node
 1224: 
 1225:    int numSides;       // Number of sides that are connected to this node
 1226: 
 1227:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1228:    double gz;          // Global vertical coordinate at the node.
 1229:    Vector2 u2[nvrt];
 1230:    double  w2[nvrt];
 1231:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1232:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1233:    double lon, lat;
 1234:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1235:    double depth;
 1236: 
 1237:    #ifdef USE_FRAMES
 1238:    Frame frame;
 1239:    #endif
 1240: 
 1241:    #ifdef USE_LOCALIZED_SIGMA   
 1242:    double localSigma[nvrt];
 1243:    #endif
 1244: 
 1245:    int kb;       // Bottom index of the node
 1246: 
 1247:    bool isDry;     // True if the node is dry
 1248: 
 1249:    int iadv;     // Advection flag
 1250: 
 1251:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1252:                           // this is nullptr
 1253: 
 1254:    TempVar tmp; // Temporary variable to store different types of variables
 1255: 
 1256:    // Physical information
 1257:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1258:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1259: 
 1260:    double rho[nvrt];     // Density
 1261:    double dfv[nvrt];     // Vertical viscosity
 1262: 
 1263:    double eta1; // Elevation at nodes at previous timestep
 1264:    double eta2; // Elevation at nodes at current timestep
 1265: 
 1266:    double ETP;  // Earth Tidal Potential
 1267: 
 1268:    double pr;    // Air pressure
 1269:    double grav2; // Gravity 
 1270:    
 1271:    Vector2 dav;  // Depth averaged velocity
 1272: 
 1273:    Vector2 tau; // Wind stress vector
 1274: 
 1275:    // Vegetation parameters
 1276:    double veg_h;
 1277:    double veg_nv;
 1278:    double veg_di;
 1279:    double veg_Cd;
 1280:    double veg_h_unbent;
 1281:    double veg_di_unbent;
 1282:    double veg_nv_unbent;
 1283:    double veg_alpha_vert_mean;
 1284:    double veg_alpha0;
 1285:    double veg_alpha3D[nvrt];
 1286: 
 1287:    // Bottom drag parameters
 1288:    double Cd;       // Bottom drag coefficient   
 1289: 
 1290:    // These three are mutually exclusive
 1291:    union {
 1292:       double rmanning; // Bottom Manning's coefficient
 1293:       double rough;    // Bottom roughness length
 1294:       double drag;     // Bottom drag coefficient
 1295:    };
 1296:    Vector2 tau_bot; // Bottom stress vector
 1297: 
 1298:    double bdef1; // Bottom deformation at previous timestep
 1299:    double bdef2; // Bottom deformation at current timestep
 1300: 
 1301:    double qel; // RHS
 1302:    double coeffDiag; // Diagonal coefficient of the matrix
 1303:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1304: 
 1305:    double mP; // Search direction for conjugate gradient method
 1306:    double mR; // Residual for conjugate gradient method
 1307:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1308:    double mX; // Solution for conjugate gradient method
 1309: 
 1310:    // Meteorological forcing
 1311:    Vector2 u_air;
 1312:    double p_air;  // XXXX is this the same as pr?
 1313:    double t_air;
 1314:    double q_air;
 1315:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1316: 
 1317:    __device__ void setWind(Vector2 &u) {
 1318:    // Sets the wind vector taking into account the mesh angle
 1319:    
 1320:       const double speed = length(u);
 1321: 
 1322:       // Rotate wind vector to the node frame
 1323:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1324: 
 1325:       // Sets the surface stress vector due to wind.
 1326:       if constexpr(nws == 0) {
 1327:          tau = {0.0, 0.0};
 1328: 
 1329:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1330:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1331: 
 1332:       } else {
 1333: 
 1334:          double dragcoef;
 1335: 
 1336:          if constexpr(iwind_form == -1) {
 1337:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1338:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1339: 
 1340:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1341:             tau = cff*u_air;
 1342:  
 1343:          } else if constexpr(iwind_form == 1) {
 1344:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1345:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1346: 
 1347:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1348:             tau = cff*u_air;
 1349: 
 1350:          } else {
 1351:             tau = {0.0, 0.0};
 1352:          }
 1353:       }
 1354:    }
 1355: 
 1356:    #ifdef USE_FRAMES
 1357:    __device__ void setFrame(double lat, double lon) {
 1358: 
 1359:       frame.update(lat, lon);        
 1360:     }
 1361:    #endif
 1362: 
 1363:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1364: 
 1365:    __device__ double sigmaTransitionDepth(void) const;
 1366: 
 1367:    __inline__ __device__ Point2 outputCoords(void) const {
 1368:       if constexpr(ics == 1)  return p;
 1369:       else                    return {rad2deg*lon, rad2deg*lat};
 1370:    }
 1371: 
 1372:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1373:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1374:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1375:    
 1376:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1377: 
 1378:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1379: 
 1380:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1381:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1382: 
 1383:    __device__ __forceinline__ void clearMatrixRow(void) {
 1384:       // Clear the matrix row for this node
 1385: 
 1386: 
 1387:       coeffDiag = 0.0;
 1388: 
 1389:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1390: 
 1391:    }
 1392: 
 1393:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1394:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1395:       
 1396:       if (node == this) {
 1397:          coeffDiag += value;
 1398:      
 1399:       } else {
 1400:          // Search (linearly)the index of the node in the array of nodes
 1401:          // XXX: This is not efficient, see if we can improve this
 1402:          int i;
 1403:          for (i = 0; i < numNodes; i++) {
 1404:             if (nodes[i] == node) {
 1405:                break;
 1406:             }
 1407:          }
 1408:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1409:          coeffMatrix[i] += value;
 1410:       }
 1411:    }
 1412: 
 1413: 
 1414:    __device__ __inline__ void updateZCoordData(void);
 1415: 
 1416:    __device__ __forceinline__ double compZCoord(int k) const;
 1417: 
 1418:    __device__ void updateKb(void);
 1419: 
 1420:    __device__ __forceinline__ void computeBottomDragCd(void);
 1421: 
 1422: 
 1423: 
 1424: };
