 3838: extern "C" {
 3839: 
 3840:    __global__ void scaleGravity(double loadtide_coef) {
 3841: 
 3842: 
 3843:       NODE(node);
 3844: 
 3845:       // SAL option: scale gravity
 3846:       if constexpr(iloadtide==2) {  // simple const
 3847:          node->grav2 = grav*(1.0 - loadtide_coef);
 3848: 
 3849:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3850:         
 3851:           const double depth = max(node->depth, 0.0);
 3852:           const double tmp1 = sqrt(depth);
 3853:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3854:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3855:                              2.6969e-13*depth*depth*depth*tmp1;
 3856:           
 3857:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3858:           
 3859: 
 3860: 
 3861:           node->grav2 = grav*(1.0 - beta_bar);
 3862: 
 3863:       } else {  // iloadtide=0,1
 3864:         node->grav2=grav;
 3865: 
 3866:       }
 3867: 
 3868:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3869:    }
 3870: 
 3871: 
 3872:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3873: 
 3874:       NODE_BND(nodeBnd);
 3875: 
 3876:       Node *node = nodeBnd->node;
 3877: 
 3878:       node->ETP = 0.0;
 3879: 
 3880:       for (int j=0; j<ntip; j++) {
 3881: 
 3882:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3883:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3884:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3885: 
 3886:          if constexpr(iloadtide==1) { // loading tide
 3887:             assert(false && "Loading tide not implemented");
 3888:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3889:          }
 3890:          
 3891:       }
 3892:       
 3893:    }
