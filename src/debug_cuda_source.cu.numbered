 4047:    __global__ void computeFlowBcVelocities(double time) {
 4048: 
 4049:       SIDE_BND(sideBnd);
 4050: 
 4051:       const Side *side = sideBnd->side;
 4052:  
 4053:       const bool isDry = side->isDry;
 4054: 
 4055:       if (isDry) {
 4056:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4057:          return;
 4058:       }
 4059: 
 4060:       // For wet sides in open boundaries...
 4061:       const Vector2 n = side->n;
 4062:       const BoundarySegment *segment = sideBnd->segment;
 4063: 
 4064:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4065: 
 4066:       const int ifltype = segment->ifltype;
 4067:       const int iettype = segment->iettype;
 4068: 
 4069:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4070:       const Vector2 r_nuth0 = r_uth0*n;
 4071: 
 4072: 
 4073: printf("ZZZ4  idx = %d, ifltype = %d, r_nuth0 = %f, %f\n", sideBnd->side->idx, ifltype, r_nuth0.x, r_nuth0.y);
 4074:       for (int k = 0; k < nvrt; k++) {
 4075:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4076:          Vector2 r_u1_bar = {0.0, 0.0};
 4077:       
 4078:          if (ifltype == 1 || ifltype == 2) {
 4079:          
 4080:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4081: 
 4082:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4083:             
 4084:             r_uth = unth0*n;  // This case has no ramp-up
 4085:             
 4086:          } else if (ifltype == -1) { // Flather 1
 4087: 
 4088:             // uth is the normal vel.; no ramp up
 4089:             const double uth = sideBnd->nuth(k);
 4090:             r_uth = uth*n;
 4091:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4092: 
 4093: 
 4094:          } else if (ifltype == 3 || ifltype == 5) {
 4095:             // vnth0=0 !normal vel.
 4096: 
 4097: printf("ZZZ3  idx = %d, jfr = %d, ifltype = %d, r_uth = %f, %f\n", sideBnd->side->idx, nbfr, ifltype, r_uth.x, r_uth.y);
 4098:             // Computes the contribution to the velocity from all tide frequencies
 4099:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4100: 
 4101:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4102:                const Vector2 umo  = sideBnd->umo(jfr); 
 4103: 
 4104:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4105:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4106:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4107:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4108: printf("ZZZ2  idx = %d, jfr = %d, ncyc = %d, face = %f, argx = %f, argy = %f, umo = %f, %f, ufa = %f, %f, ramp = %f, ff = %f, r_u1_bar = %e, %e\n", sideBnd->side->idx, jfr, ncyc, face[jfr], argx, argy, umo.x, umo.y, ufa.x, ufa.y, ramp, ff[jfr], r_u1_bar.x, r_u1_bar.y);               
 4109:             }
 4110: 
 4111:          } // if (ifltype = 3 || ifltype == 5
 4112: 
 4113: 
 4114:          switch (iettype) {
 4115:             case 1:
 4116:             case 2:
 4117:             case 4:
 4118:                sideBnd->ubc[k] = r_uth;
 4119:                break;
 4120:             case 3:
 4121:                sideBnd->ubc[k] = r_u1_bar;
 4122:                break;
 4123:             case 5:
 4124:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4125:                break;
 4126:          } // switch
 4127: 
 4128: printf("ZZZ  idx = %d, iettype = %d, r_u1_bar = %f, %f, sideBnd->ubc[%d] = %f, %f\n", sideBnd->side->idx, iettype, r_u1_bar.x, r_u1_bar.y, k, sideBnd->ubc[k].x, sideBnd->ubc[k].y);
 4129:       } // for k
 4130:    }
 4131: 
 4132:    __global__ void computeElevationBoundaryConditions(double time) {
 4133:       // Compute elevation essential boundary conditions 
 4134: 
 4135:       NODE_BND(nodeBnd); // Each boundary node.
 4136: 
 4137:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4138: 
 4139:       const Node *node = nodeBnd->node;
 4140:       const BoundarySegment *segment = nodeBnd->segment;
 4141:       const int iettype = segment->iettype;
 4142:       
 4143: 
 4144:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4145:       double eic = 0.0;
 4146:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4147:       else                 eic = 0.0;
 4148: 
 4149:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4150:       const double r_eth = ramp*nodeBnd->eth;
 4151:       double r_eta1_bar = 0.0;
 4152: 
 4153: 
 4154:       // Compute tide elevation
 4155:       if (iettype == 3 || iettype == 5) {   
 4156: 
 4157:          if constexpr(iloadtide==1) { // loading tide
 4158:             assert(false && "Loading tide not implemented");
 4159:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4160:          }
 4161:          
 4162:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4163: 
 4164:             const double efa  = nodeBnd->efa[jfr]; 
 4165:             const double emo  = nodeBnd->emo[jfr]; 
 4166: 
 4167:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4168:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4169:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4170: 
 4171:          } // for jfr
 4172: 
 4173:       } // if iettype
 4174: 
 4175:       switch (iettype) {
 4176:          case 1:
 4177:          case 2:
 4178:          case 4:
 4179:             nodeBnd->elbc = r_eic + r_eth;
 4180:             break;
 4181:          case 3:
 4182:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4183:             break;
 4184:          case 5:
 4185:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4186:             break;
 4187:       } // switch
 4188: 
 4189: 
 4190:       //Add inverse barometric effects
 4191:       if (iettype != 0 && inv_atm_bnd == 1) {
 4192:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4193:       }
 4194: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 4195:    }
 4196: 
 4197: 
 4198:    __global__ void computeHorizontalViscosity(void) { 
 4199: 
 4200:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4201: 
 4202:       SIDE(side);
 4203: 
 4204:       if (side->isDry) return;
 4205: 
 4206:       for (int k = 0; k < nvrt; k++) {
 4207:          side->nuGradU[k] = {0.0, 0.0};
 4208:       }
 4209: 
 4210:       if constexpr(ihorcon == 1) {
 4211:          for (int k = side->kb; k < nvrt - 1; k++) {
 4212:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4213:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4214:             // By Zhang and Baptista.
 4215: 
 4216:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4217:             // This is a standard discretization of the Laplacian operator.
 4218:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4219:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4220:             // Gamma is hvis_coef0 in the code.
 4221:             // The value of gamma needs to be < 0.5.
 4222: 
 4223:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4224:             // side under consideration in each of the two possible elements that share the side.
 4225:             Vector2 sumU = {0.0, 0.0};
 4226:             for (int l = 0; l < 2; l++) {
 4227:                const Element *elem = side->elems[l];
 4228: 
 4229:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4230: 
 4231:                // Find the local index of the side in the element
 4232:                const int idxSide = elem->sideLocalIdx(side);
 4233:                // Find the two sides that are connected to the side under consideration
 4234:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4235:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4236: 
 4237:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4238: 
 4239:             }
 4240: 
 4241:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4242:    printf("+++++ side->nuGradU = %f, %f\n", side->nuGradU[k].x, side->nuGradU[k].y);
 4243: 
 4244:    
 4245:          }
 4246:       }
 4247:       else if constexpr(ihorcon == 2) {
 4248:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4249:       }
 4250: 
 4251: 
 4252:    }
 4253: 
 4254: 
 4255:    __global__ void setEssentialBC(void) {
 4256:       // Set essential boundary conditions 
 4257:       NODE(node); // Each boundary node
 4258:       NodeBoundary *nodeBnd = node->nodeBnd;
 4259: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 4260:       
 4261: // nodeBnd->isEssentialBC = true;      
 4262:       // Check if this node has essential BC
 4263:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4264:          // Verify BC value is valid
 4265:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4266: 
 4267:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 4268:          
 4269:          // Set diagonal to 1 and zero off-diagonals
 4270:          node->coeffDiag = 1.0;
 4271:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 4272: 
 4273:          for (int j = 0; j < node->numNodes; j++) {
 4274:                node->coeffMatrix[j] = 0.0;
 4275:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4276:          }
 4277:          
 4278:          // Set solution and RHS to BC value
 4279:          node->mX  = nodeBnd->elbc;
 4280:          node->qel = nodeBnd->elbc;
 4281: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 4282:       } else {
 4283:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4284: 
 4285:          for (int j = 0; j < node->numNodes; j++) {
 4286:                Node* nbNode = node->nodes[j];
 4287:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4288:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4289:                   // Verify neighbor's BC value
 4290:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4291: 
 4292:                   // Subtract contribution to RHS
 4293:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4294:                   node->coeffMatrix[j] = 0.0;  
 4295:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4296:                }
 4297:          }
 4298:       }
 4299:    }
 4300: 
 4301: 
 4302:    __global__ void updateElevation(void) {
 4303:       NODE(node);
 4304: 
 4305:       node->eta2 = node->mX;
 4306: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 4307:    }
