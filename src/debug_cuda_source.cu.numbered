 9546: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 9547:    // Get the value of a variable from an side
 9548:    // varName is the name of the variable to get
 9549:    // var is the array to store the value
 9550:    // k is the vertical level index of the variable to get
 9551:    SIDE_BND(sideBnd);   
 9552: 
 9553:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 9554:    if (sideBnd->segment->isLand) idx = -7;
 9555: 
 9556:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 9557:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 9558: 
 9559: }
