 1495:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1496:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1497:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1498:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1499:    
 1500:    const int npgb;  // Global number of horizontal nodes
 1501:    const int negb;  // Global number of elements
 1502:    const int nsgb;  // Global number of sides
 1503: 
 1504:    const int np;   // Local number of horizontal nodes 
