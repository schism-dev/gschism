 7262: // !===============================================================================
 7263: 
 7264: } // extern "C"
 7265: 
 7266: #ifdef DONTCOMPILE
 7267: __device__ void computeVerticalAdvection(void) {
 7268:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7269: 
 7270:    sdbt(1:2,:,:)=0.d0
 7271: 
 7272:    const Side *side = FROM kernel;
 7273: 
 7274:    if(side->isDry) return;
 7275: 
 7276:    // If side is wet...
 7277: 
 7278: 
 7279:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7280:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7281:    double ws[nvrt] = {} // w @ side
 7282:    int icount = 0;
 7283:    for (int j=0; j<2; j++) {
 7284:       const Element *elem = side->elements[j];
 7285:        
 7286:       if(elem != nullptr) {
 7287:          icount++;
 7288:          for (int k=0; k<nvrt; k++) {
 7289:             ws[k] = ws[k] + elem->w[k];
 7290:          }
 7291:       }
 7292:    }  // for j
 7293: 
 7294:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7295:    ws = ws/icount;
 7296: 
 7297:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7298:    // Splines allow for a smooth transition between vertical levels.
 7299:    // Splines have continuity restrictions at the internal knots, but
 7300:    // we have to provide the 1st derivatives at the endpoints.
 7301:    const int kbs = side->kbs; 
 7302:    
 7303:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7304:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7305:    initCubicSpline(kbs, nvrt, side, ws, up)
 7306: 
 7307:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7308:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7309:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7310: 
 7311:    // Total advection (average onto side)
 7312:    const Node *node1 = side->nodes[0];
 7313:    const Node *node2 = side->nodes[1];
 7314:    for (int k=kbs(i); k<nvrt; k++) {
 7315: 
 7316:       Vector2 bcc1 = node1->bcc[k];
 7317:       Vector2 bcc2 = node2->bcc[k];
 7318:       if constexpr(ics == 2) {
 7319:          // Project the velocities from the node frames to the side frame
 7320:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7321:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7322:       }
 7323: 
 7324:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7325:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7326: 
 7327:    }
 7328: }
 7329: #endif
 7330: 
 7331: 
 7332: extern "C" {
 7333:    __global__ void computeElemAverageGhat(void) {
 7334:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7335: 
 7336:       ELEM(elem);
 7337:       
 7338:       elem->ghat1= {0.0, 0.0};  
 7339: 
 7340:       if constexpr(ihydraulics != 0) {
 7341:          if (nhtblocks > 0 && elem->isblock) return;
 7342:       }
 7343: 
 7344:       
 7345:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7346:       // cff1-3: coefficients for 2D/3D
 7347: 
 7348:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7349:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7350:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7351: 
 7352:       if (elem->isDry) return;
 7353: 
 7354:       // Average of the coefficients
 7355:       double av_cff1 = 0.0;  // av. for cff1
 7356:       double av_cff2 = 0.0;  // av. for cff2
 7357:       double av_cff3 = 0.0;  // av. for cff3
 7358:       double av_df = 0.0;  // av. for H^\alpha / H
 7359:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7360:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7361: 
 7362:       const int i34 = elem->i34;
 7363:       const int kb  = elem->kb;
 7364: 
 7365:       for (int j=0; j<i34; j++) {
 7366:          // For each node and side in the element...
 7367: 
 7368:          const Node *node = elem->nodes[j];
 7369:          const Side *side = elem->sides[j];
 7370: 
 7371:          const double chi      = side->chi;
 7372:          const double veg_c2   = side->veg_c2;
 7373:          const double veg_beta = side->veg_beta;
 7374:          const double veg_h    = side->veg_h();
 7375:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7376: 
 7377:          const Vector2 gradPhi = elem->gradPhi[j];
 7378: 
 7379:          // Node - const in elem
 7380:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7381:          elem->gradPr  += node->pr  *gradPhi;
 7382: 
 7383:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7384: 
 7385:         
 7386:          const double htot  = side->htot2();        // Total depth at the side
 7387:          const double zctr2 = side->zTopCanopy();  
 7388: 
 7389:          double cff1; 
 7390:          double cff2; 
 7391:          double cff3;   
 7392:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7393:          // coefficients applied to 2D/3D case 
 7394:             cff1 = side->hhat/htot;
 7395:             cff2 = 0.0;
 7396:             cff3 = 0.0;
 7397:          } else { //3D
 7398:             //Init for no-veg case
 7399:             cff1 = 1.0;
 7400:             cff2 = 1.0;
 7401:             cff3 = 0.0;
 7402: 
 7403:             if constexpr(iveg != 0) {
 7404:                // Computes coefficients used with vegetation terms G1, G2
 7405:                // cff1, cff3 are used for the first two terms in G1, G2:
 7406:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7407:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7408:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7409:                if(veg_h < 0.99*htot) { // submergent vegetation
 7410:                   cff1 = 1.0;
 7411:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7412:                   cff3 = veg_c;
 7413: 
 7414:                } else { // emergent vegetation
 7415:                   cff1 = 1.0/(1.0 + veg_c2);
 7416:                   cff2 = cff1;
 7417:                   cff3 = 0.0;
 7418: 
 7419:                }
 7420:             } // if iveg
 7421:          } //  2D/3D
 7422: 
 7423:          av_cff1 += cff1/i34;
 7424:          av_cff2 += cff2/i34;
 7425:          av_cff3 += cff3/i34;
 7426:          av_cff2_chi += cff2*chi/i34;
 7427:          av_cff3_chi += cff3*chi/i34;
 7428:          av_df += min(htot, veg_h)/(htot*i34);
 7429: 
 7430: 
 7431:          // btrack values: U^\star, U^{\star\alpha}
 7432:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7433:          Vector2 Ustar       = {0.0, 0.0}; 
 7434:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7435: 
 7436:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7437:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7438:          } else { //3D
 7439:             for (int k = side->kb + 1; k < nvrt; k++) {
 7440:             
 7441:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7442:                Ustar += w2;
 7443: 
 7444:                if constexpr(iveg != 0) {
 7445:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7446:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7447:                        Ustar_alpha += zrat*w2; // XXXX
 7448:                    }
 7449:                }  // if iveg
 7450:             }  // for k
 7451:          }  //2D/3D
 7452: 
 7453:          // If needed, project the side velocities to the element frame
 7454:          if constexpr(ics==2) {
 7455:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7456:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7457:          }
 7458:         
 7459: 
 7460:          // Add btrack & surface stress terms to \breve{G} first
 7461:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7462: 
 7463: 
 7464:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7465:          Vector2 tau    = side->tau();  
 7466:          Vector2 ubstar = side->btu[side->kb + 1];  
 7467: 
 7468:          // If needed, project tau and ubstar to the element frame
 7469:          if constexpr(ics==2) {
 7470:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7471:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7472:          }
 7473: 
 7474:          // Term for surface and bottom stress
 7475:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7476: 
 7477: 
 7478:          // All terms in F,F^\alpha,f_b except baroclinic
 7479:          // F, f_b: all explicit terms excluding vegetation 
 7480:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7481:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7482:          const double coriolis = side->coriolis;
 7483:          Vector2 F  =  coriolis*side->U;  // F_x
 7484:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7485:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7486: 
 7487:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7488:             
 7489:             for (int k = side->kb; k < nvrt; k++) {
 7490:                if (zctr2 > side->zc[k-1]) {
 7491:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7492:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7493:                    Fa +=  coriolis*w2*zrat;
 7494:                } // if zctr2
 7495:             } // k
 7496:          } // iveg
 7497: 
 7498:          // Integrate horizontal viscosity force vertically
 7499:          for (int k=side->kb + 1; k<nvrt; k++) {
 7500:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7501: 
 7502:             F += levelHorVisc;
 7503: 
 7504:             // Vegetation term
 7505:             if constexpr(iveg!=0) {
 7506:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7507:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7508:                   Fa += levelHorVisc*zrat;
 7509:                } 
 7510:             } // if iveg
 7511:          } // for k
 7512: 
 7513:          // Get nu*grad(U) at the side's bottom level
 7514:          Vector2 nuGradU = side->nuGradU[side->kb];
 7515: 
 7516:          fb += nuGradU;
 7517: 
 7518:          // If needed, project vectorsF, fb and Fa to the element frame
 7519:          if constexpr(ics==2) {
 7520:             F    = side->frame.projHorVec(F,    elem->frame);
 7521:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7522:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7523:          } // if ics
 7524: 
 7525:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7526:       } // for j (nodes and sides)
 7527: 
 7528:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7529: 
 7530: 
 7531:       // Finish off terms in F, F^\alpha and f_b
 7532:       const double grav3 = elem->mean(&Node::grav2);
 7533:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7534:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7535:       for (int j=0; j<i34; j++) { 
 7536:          // For each side in the element...
 7537:          const Side *side = elem->sides[j];
 7538:          const double chi = side->chi;
 7539: 
 7540:          const double htot = side->htot2();
 7541:          const double veg_h = side->veg_h();
 7542:          const Vector2 F  = htot*fb;
 7543:          const Vector2 Fa = min(htot, veg_h)*fb;
 7544: 
 7545:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7546:       } // for j
 7547: 
 7548:       // tmp is already in elem frame
 7549:       elem->ghat1 += tmp/i34;
 7550: 
 7551:       // Baroclinic force
 7552:       if constexpr(ibc==0) {
 7553:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7554: 
 7555:          Vector2 Fa = {0.0, 0.0};
 7556:          Vector2 intGradRho = {0.0, 0.0};
 7557:          
 7558:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7559:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7560:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7561: 
 7562:             // \in F [m^2/s/s]
 7563:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7564:          }
 7565: 
 7566:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7567:          const Vector2 F = av_df*Fa; //approx
 7568:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7569: 
 7570:       } // if ibc
 7571: 
 7572: 
 7573: 
 7574:    }
 7575: 
 7576: } // extern "C"
 7577: 
 7578: 
 7579: 
 7580: #ifdef DONTCOMPILE
 7581: __global__ void checkMassConservation(Tracers* sumtr) {
 7582: 
 7583:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7584: 
 7585:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7586: 
 7587:    Element *elem = &(mesh->localElemData[i]);
 7588: 
 7589:    // Skip dry elements
 7590:    if (elem->isDry) return;
 7591: 
 7592:    // Local sum array for this thread
 7593:    double localSum[N_TRACERS] = {0.0};
 7594: 
 7595:    // Sum over vertical levels for this element
 7596:    const int kbe = elem->kbe;
 7597:    const double area = elem->area;
 7598: 
 7599:    for (int k = kbe; k < nvrt; k++) {
 7600:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7601:       
 7602:       // Accumulate tracer mass
 7603:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7604:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7605:       }
 7606:    }
 7607: 
 7608:    //  This function returns per element sums. A reduction must be done on the host side.
 7609: }
 7610: 
 7611: 
 7612: __global__ void transport(void) {
 7613: 
 7614:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7615: 
 7616:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7617: 
 7618:    Element *elem = &(mesh->localElemData[ie]);
 7619: 
 7620:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7621: 
 7622:                for (int m=0; m<ntr; m++) {
 7623:                   for (int k=kbe(ie); k<nvrt; k++) {
 7624:                      // Calculate each polynomial's weight 
 7625:                      wm=0.d0; sum1=0.d0; 
 7626:                      wm1=0.d0; wm2=0.d0; 
 7627:                      for (int i=0; i<elem->nweno2; i++) {
 7628:                   
 7629:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7630:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7631:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7632:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7633:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7634:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7635:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7636:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7637:                      // -----------------Hu and Shu (1999)'s method----------------
 7638:                      b4=b1+b2+b3
 7639: 
 7640: //Error: add PRODUCTION CPP
 7641: #ifdef DEBUG
 7642:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7643:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7644:                     call parallel_abort(errmsg)
 7645:                   }
 7646: #endif
 7647: 
 7648:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7649:                   // !----test-------------- 
 7650:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7651:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7652:                   // !wm(i)=wm1(i)*wm2(i)
 7653:                   // !---------------------- 
 7654:                   sum1=sum1+wm(i)
 7655:                 } // end for i
 7656: 
 7657:                 wm=wm/sum1
 7658: 
 7659:                 for (int j=0; j<elem->i34; j++) {
 7660: 
 7661:                   const Side *side  = elem->sides[j];
 7662:                   const Node *node1 = side->n1;
 7663:                   const Node *node2 = side->n2;
 7664: 
 7665:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7666:                      trsd=0.d0
 7667:                      for (int kk=0; kk<nquad; kk++) {
 7668:                         for (int i=0; i<elem->nweno2; i++) {
 7669:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7670:                         } // end for i   
 7671:                      } // end for kk
 7672:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7673:                   } // outward flux
 7674:                } // end for j=1,i34(ie) ! side
 7675:             }
 7676:          }
 7677:               
 7678: 
 7679: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7680: //             //   calculate each polynomial's weight 
 7681: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7682: //                 wm=0.d0; sum1=0.d0
 7683: //                 do i=1,nweno1(ie) !for each polynomial
 7684: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7685: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7686: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7687: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7688: //                   wm(i)=b2
 7689: //                   sum1=sum1+b2
 7690: //                   !wm(i)=1.d0
 7691: //                   !sum1=sum1+1.d0
 7692: 
 7693: // // Error: PRODUCTION
 7694: // #ifdef DEBUG
 7695: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7696: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7697: //                     call parallel_abort(errmsg)
 7698: //                   endif
 7699: // #endif
 7700: 
 7701: //                 enddo !i
 7702: //                 wm=wm/sum1 !final weight
 7703: 
 7704:                 for (int j=0; j<elem->i34; j++) { // side
 7705:                   const Side *side = elem->sides[j];
 7706:                   const Node *node1 = side->n1;
 7707:                   const Node *node2 = side->n2;
 7708: 
 7709:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7710:                     trsd=0.d0
 7711:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7712:                       for (int i=0; i<elem->nweno1; i++) {
 7713:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7714:                       }
 7715:                     enddo //kk
 7716:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7717:                   } // outward flux
 7718:                 } // end for j=1,i34(ie) ! side
 7719:               } // end for k; ntr 
 7720: 
 7721:             else !simple upwind method
 7722:               do j=1,i34(ie)
 7723:                 jsj=elside(j,ie)
 7724:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7725:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7726:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7727:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7728:                   endif
 7729:                 enddo  !vertical layers
 7730:               enddo !j=1,i34(ie) ! side
 7731:             endif !order of accuracy
 7732: 
 7733:          //  enddo !ie
 7734: // !$OMP     end do
 7735: 
 7736: // !$OMP     master
 7737: //           !message passing
 7738: //           if (nproc>1) then
 7739: //             !make a copy of side concentrations
 7740: //             trsd_tmp0=trsd_tmp 
 7741: 
 7742: //             !this exchange routine swaps interface concentration between two partitions
 7743: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7744: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7745: 
 7746: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7747: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7748: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7749: 
 7750: 
 7751: //             !This obtains final values for interface sides
 7752: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7753: //       :    endif !nproc>1
 7754: //           !message passing end
 7755: // !$OMP     end master
 7756: // !$OMP     barrier
 7757: 
 7758: 
 7759: // !         Do advection; conc @ dry elem will not be changed
 7760: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7761: // !$OMP     do reduction(+: h_mass_in)
 7762: //           do i=1,ne
 7763: //             if(idry_e(i)==1) cycle
 7764: 
 7765: 
 7766: // !           Wet elements with 3 wet nodes
 7767: //             do k=kbe(i)+1,nvrt
 7768: 
 7769: 
 7770: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7771: //               dtb_by_bigv = dtb/bigv
 7772:     
 7773: // !             Advective flux
 7774: //               if (ntd_weno==1 .or. itd_weno==1) then
 7775: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7776: //               else
 7777: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7778: //               endif
 7779: 
 7780: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7781: //               do j=1,i34(i)
 7782: //                 jsj=elside(j,i) !side
 7783: //                 iweno=.true. !use weno reconstruction as default
 7784: //                 iel=ic3(j,i) !neighboring elem
 7785: 
 7786: //                 if(iel/=0) then
 7787: //                   if(idry_e(iel)==1) cycle
 7788: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7789: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7790: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7791: //                     iweno=.false.
 7792: //                   endif
 7793: //                 else !land or open bnd side
 7794: //                   !skip land bnd and outflowing open bnd, 
 7795: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7796: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7797: //                     !For outflow open bnd side, estimate mass in (open
 7798: //                     !side cannot be interface side)
 7799: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7800: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7801: //                     endif
 7802: 
 7803: //                     cycle
 7804: //                   endif
 7805: 
 7806: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7807: //                   iweno=.false.  !reset to upwind
 7808: //                   ibnd=isbs(jsj) !global bnd #
 7809: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7810: //                   nwild(1:2)=0
 7811: //                   do ll=1,2 !nodes
 7812: //                     ndo=isidenode(ll,jsj)
 7813: //                     do lll=1,2 !2 possible bnds
 7814: //                       if(isbnd(lll,ndo)==ibnd) then
 7815: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7816: //                         exit
 7817: //                       endif
 7818: //                     enddo !lll
 7819: //                   enddo !ll
 7820: //                   ind1=nwild(1); ind2=nwild(2);
 7821: 
 7822: //                   do jj=1,natrm
 7823: //                     if(ntrs(jj)<=0) cycle
 7824: 
 7825: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7826: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7827: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7828: //                       enddo !ll
 7829: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7830: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7831: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7832: //                       enddo !ll
 7833: //                     else if(itrtype(jj,ibnd)==3) then
 7834: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7835: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7836: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7837: //                       enddo !ll
 7838: //                     else if(itrtype(jj,ibnd)==4) then
 7839: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7840: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7841: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7842: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
