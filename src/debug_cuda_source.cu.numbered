 8006: 
 8007: __global__ void computeMatrixProductAndDotProducts() {
 8008:    // Computes A*p, r'Mr and p'Ap
 8009: 
 8010:    // 1) shared buffer: first half for rMr, second for pAp
 8011:    __shared__ double sdata[2*BLOCK_SIZE];
 8012:    double* s_rMr = sdata;
 8013:    double* s_pAp = sdata + BLOCK_SIZE;
 8014: 
 8015:    const int tid = threadIdx.x;
 8016: 
 8017:    double l_pAp = 0.0;
 8018: 
 8019:    s_rMr[tid] = 0.0;
 8020:    s_pAp[tid] = 0.0;
 8021: 
 8022:    // 2) get your node pointer
 8023:    // NODE(node);   
 8024:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8025:    Node *node = &(mesh->localNodeData[idx_node]); 
 8026:    if (idx_node < mesh->np) {
 8027: 
 8028: 
 8029:    const double diag = node->coeffDiag;
 8030:    const double r    = node->mR;
 8031:    const double p    = node->mP;  
 8032: 
 8033:    // apply preconditioner on the fly:
 8034:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8035: 
 8036:    // 4) compute Ap = A.p
 8037:    double Ap = node->coeffDiag * node->mP;
 8038:    for (int j = 0; j < node->numNodes; ++j) {
 8039:       const Node *nbNode = node->nodes[j];
 8040:       Ap += node->coeffMatrix[j] * nbNode->mP;
 8041: 
 8042:    }
 8043: 
 8044:    node->mAp = Ap;
 8045:     
 8046: 
 8047:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 8048:    // const double l_rMr = r*Mr;  // r'Mr
 8049:    l_pAp = p*Ap;  // p'Ap
 8050: 
 8051: 
 8052:    }
 8053: 
 8054:    // 6) write into shared mem
 8055:    // s_rMr[tid] = l_rMr;
 8056:    s_pAp[tid] = l_pAp;
 8057: 
 8058:    __syncthreads();
 8059: 
 8060:    // 7) block-wide tree reduction
 8061:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8062:       if (tid < stride)  {
 8063:          s_pAp[tid] += s_pAp[tid + stride];
 8064:       }
 8065:       __syncthreads();
 8066:    }
 8067: 
 8068:    // 8) thread 0 atomically accumulates into the globals
 8069:    // XXX: This is slower than it needs to be, but it is simple and works
 8070:    if (tid == 0) {
 8071:       atomicAdd(pAp, s_pAp[0]);
 8072:    }
 8073: 
 8074: 
 8075: }
 8076: 
 8077: 
 8078: __global__ void updateSolutionAndDotProducts(void) {
 8079:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8080: 
 8081:    const int tid = threadIdx.x;
 8082: 
 8083:    s_rMr[tid] = 0.0;
 8084: 
 8085:    // get node & bounds-check:
 8086:    NODE(node);
 8087: 
 8088:    
 8089:    // Compute alpha
 8090:    const double alpha = (*rMr_old)/(*pAp);
 8091: 
 8092:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8093: 
 8094: 
 8095:    // load scalars
 8096:    const double diag = node->coeffDiag;
 8097:    const double p    = node->mP;
 8098:    const double Ap   = node->mAp;
 8099:    const double x    = node->mX;
 8100:    const double r    = node->mR;
 8101:    
 8102:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8103: 
 8104:    // 1) update solution & residual
 8105:    const double x_new = x + alpha*p;
 8106:    const double r_new = r - alpha*Ap;
 8107:    node->mX = x_new;
 8108:    node->mR = r_new;
 8109: 
 8110:    // 2) apply Jacobi preconditioner on the fly
 8111:    const double Mr_new = r_new/diag;
 8112: 
 8113: 
 8114:    // 3) local contributions for the two dot-products
 8115:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8116: 
 8117:    // 4) write into shared-mem
 8118:    s_rMr[tid] = l_rMr;
 8119: 
 8120:    __syncthreads();
 8121: 
 8122: 
 8123:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8124:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8125:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8126:       __syncthreads();
 8127:    }
 8128: 
 8129:    // 6) thread 0 atomically folds into the global accumulators
 8130:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8131: 
 8132: 
 8133: }
 8134: 
 8135: 
 8136: __global__ void updateSearchDirection() {
 8137: 
 8138:     NODE(node);
 8139: 
 8140:     // recompute z on-the-fly
 8141:     const double z = node->mR / node->coeffDiag;
 8142:     const double p = node->mP;
 8143: 
 8144:     const double beta = (*rMr_new)/(*rMr_old);
 8145: 
 8146: 
 8147:     // p =z + beta*p
 8148:     node->mP = z + beta*p;
 8149: 
 8150: }
 8151: 
 8152: __global__ void initializeScalars(double *scalars) {
 8153: 
 8154:    // These point to a cupy array in the host code
 8155:    rMr_old = scalars + 0;
 8156:    rMr_new = scalars + 1;
 8157:    pAp     = scalars + 2;
 8158: }
 8159: 
 8160: __global__ void initializePreconditionedResidual(void) {
 8161: 
 8162:     __shared__ double s_rMr[BLOCK_SIZE];  
 8163: 
 8164:     s_rMr[threadIdx.x] = 0.0;
 8165: 
 8166:     NODE_ALL(node, valid);
 8167:     const int tid = threadIdx.x;
 8168:     // For the first iteration:
 8169:     // 1. Initial solution x = 0 (already set)
 8170:     // 2. Initial residual r = b (stored in qel)
 8171:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8172: 
 8173: // XXX we should use the guess solution here    
 8174: 
 8175:     double l_rMr = 0.0;
 8176:     if (valid) {
 8177:       // Set initial residual r = b (from qel)
 8178:       node->mR = node->qel;
 8179: 
 8180:       // Compute z = M^-1 * r (preconditioned residual)
 8181:       const double z = node->mR / node->coeffDiag;
 8182: 
 8183:       // Set initial search direction p = z
 8184:       node->mP = z;
 8185: 
 8186:       // Initialize other variables needed for CG
 8187:       node->mX = 0.0;  // Initial solution
 8188:       node->mAp = 0.0; // Will be computed in first iteration
 8189: 
 8190: 
 8191:       // Computes the first r'Mr (reduction)
 8192:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8193:     }
 8194:     // 4) write into shared-mem
 8195:     s_rMr[tid] = l_rMr;
 8196: 
 8197:     __syncthreads();
 8198: 
 8199: 
 8200:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8201:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8202:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8203:         __syncthreads();
 8204:     }
 8205: 
 8206:     // 6) thread 0 atomically folds into the global accumulators
 8207:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8208: 
 8209:     *rMr_old = 0.0;
 8210:     *pAp = 0.0;
 8211: }
 8212: 
 8213: 
 8214: 
 8215: 
 8216: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 8217:    // Get the value of a variable from an element
 8218:    // varName is the name of the variable to get
 8219:    // var is the array to store the value
 8220:    // k is the vertical level index of the variable to get
 8221: 
 8222:    ELEM(elem);
 8223:    
 8224:    int idx = elem->idx;
 8225:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8226: 
 8227:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8228:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 8229:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 8230:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 8231:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 8232:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 8233:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 8234:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 8235:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 8236:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 8237:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 8238:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 8239:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 8240:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 8241:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8242:       
 8243:    
 8244: }
 8245: 
 8246: 
 8247: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8248:    // Get the value of a variable from an node
 8249:    // varName is the name of the variable to get
 8250:    // var is the array to store the value
 8251:    // k is the vertical level index of the variable to get
 8252: 
 8253:    NODE(node);
 8254:    
 8255:    int idx = node->idx;
 8256:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8257: 
 8258:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8259:    
 8260:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8261:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8262:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 8263:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8264:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8265:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8266:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8267:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 8268:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8269:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8270:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 8271:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8272:    
 8273:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8274:       
 8275:    
 8276: }
 8277: 
 8278: 
 8279: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8280:    // Get the value of a variable from an side
 8281:    // varName is the name of the variable to get
 8282:    // var is the array to store the value
 8283:    // k is the vertical level index of the variable to get
 8284:    SIDE(side);
 8285:    
 8286:    int idx = side->idx;
 8287:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8288: 
 8289:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8290:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8291:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8292:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8293:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8294:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8295:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8296:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8297:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8298:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8299:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8300:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8301:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8302:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8303:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8304:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8305:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 8306:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8307:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8308:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8309:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8310:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8311:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8312:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8313:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8314:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8315:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8316:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8317:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8318:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8319:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8320:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8321:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8322:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8323:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8324: }
 8325: 
 8326: 
 8327: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8328:    // Get the value of a variable from an side
 8329:    // varName is the name of the variable to get
 8330:    // var is the array to store the value
 8331:    // k is the vertical level index of the variable to get
 8332:    SIDE_BND(sideBnd);   
 8333: 
 8334:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-7;
 8335:    if (sideBnd->segment->isLand) idx = -1;
 8336: 
 8337:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8338:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8339: 
 8340: }
