 5035:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5036: 
 5037:       NODE_BND(nodeBnd);
 5038: 
 5039:       Node *node = nodeBnd->node;
 5040: 
 5041:       node->ETP = 0.0;
 5042: 
 5043:       for (int j=0; j<ntip; j++) {
 5044: 
 5045:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 5046:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 5047:    
 5048:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 5049: 
 5050:          if constexpr(iloadtide==1) { // loading tide
 5051:             assert(false && "Loading tide not implemented");
 5052:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5053:          }
 5054:          
 5055:       }
 5056:       
 5057:    }
