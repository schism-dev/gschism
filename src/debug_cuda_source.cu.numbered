 8038: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8039:    Node *nodes = mesh->localNodeData;
 8040: 
 8041:    *addr = nodes;
 8042:    *sizeNode = sizeof(Node);
 8043: 
 8044:    switch (varCode) {
 8045:       case (int)VarCode::depth:
 8046:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8047:          *sizeType = sizeof(double);
 8048:          break;
 8049:       case (int)VarCode::eta:
 8050:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8051:          *sizeType = sizeof(double);
 8052:          break;
 8053:       case (int)VarCode::x:
 8054:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8055:          *sizeType = sizeof(Vector2);
 8056:          break;
 8057:       case (int)VarCode::z:
 8058:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 8059:          *sizeType = sizeof(double);
 8060:          break;
 8061:       case (int)VarCode::kb:
 8062:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8063:          *sizeType = sizeof(int);
 8064:          break;
 8065:       case (int)VarCode::isdry:
 8066:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8067:          *sizeType = sizeof(int);
 8068:          break;         
 8069:       case (int)VarCode::w:
 8070:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8071:          *sizeType = sizeof(double);
 8072:          break;
 8073:       case (int)VarCode::u:
 8074:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8075:          *sizeType = sizeof(Vector2);
 8076:          break;         
 8077:       default:
 8078:          *offset = -1;    
 8079:    }  
 8080:    
 8081: }
