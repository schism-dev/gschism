 8060: __global__ void printMatrix(bool full) {
 8061:    // Debugging: print the matrix
 8062: 
 8063:    const int size = mesh->np;
 8064:    double sum = 0.0;
 8065:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8066:       const Node *node = mesh->localNodeData + idx_node;
 8067:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8068:       for (int j = 0; j < node->numNodes; j++) {
 8069:          Node* nbNode = node->nodes[j];
 8070:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8071:          sum += node->coeffMatrix[j];
 8072:       }
 8073:       if (full) printf("]\n");
 8074: 
 8075: 
 8076:    }
 8077:    if (!full) printf("sum=%lf\n", sum);
 8078: }
