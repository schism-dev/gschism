 1467:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1468:       // Compute the different time ramps used in the code 
 1469:       // This function is performed by just one thread
 1470: 
 1471:       if constexpr(ibc == 0) {
 1472:          if (drampbc > 0.0) {
 1473:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1474:          } else {
 1475:             rampbc = 1.0;
 1476:          }
 1477: 
 1478:          if (nws != 0 && drampwind > 0.0) {
 1479:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1480:          } else {
 1481:             rampwind = 1.0;
 1482:          }
 1483:       }
 1484: 
 1485:       if (drampwafo > 0.0) {
 1486:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1487:       } else {
 1488:          rampwafo = 1.0;
 1489:       }
 1490: 
 1491:       // For source/sinks
 1492:       if (if_source && dramp_ss > 0.0) {
 1493:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1494:       } else {
 1495:          ramp_ss = 1.0;
 1496:       }
 1497: 
 1498:       if (dramp > 0.0) {
 1499:          ramp = tanh(2.0*time/86400.0/dramp);
 1500:       } else {
 1501:          ramp = 1.0;
 1502:       }
 1503: 
 1504:    }
 1505:       
