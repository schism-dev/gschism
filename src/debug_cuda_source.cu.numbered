  230: 
  231: struct Bool4 {
  232:    unsigned int m; // bit i = lane i
  233: 
  234:    __device__ __forceinline__ bool get(int i) const { return (m >> i) & 1u; }
  235:    __device__ __forceinline__ void set(int i, bool v) {m = (m & ~(1u << i)) | ((unsigned int)(v) << i); }
  236: 
  237:    __device__ __forceinline__ bool all(void) const { return m == 0x0F; }
  238:    __device__ __forceinline__ bool any(void) const { return m != 0; }
  239:    __device__ __forceinline__ bool none(void) const { return m == 0; }
  240:    __device__ __forceinline__ int firstOne(void) const { return __ffs(m) - 1; }
  241: 
  242: };
  243: 
  244: __device__ __forceinline__ Bool4 operator!(Bool4 x) { x.m = (~x.m) & 0x0F; return x; }
  245: __device__ __forceinline__ Bool4 operator&(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m & b.m)}; }
  246: __device__ __forceinline__ Bool4 operator|(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m | b.m)}; }
