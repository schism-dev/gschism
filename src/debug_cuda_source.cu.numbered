 4134:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4135: 
 4136:       NODE_BND(nodeBnd);
 4137: 
 4138:       Node *node = nodeBnd->node;
 4139: 
 4140:       node->ETP = 0.0;
 4141: 
 4142:       for (int j=0; j<ntip; j++) {
 4143: 
 4144:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4145:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4146:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4147: 
 4148:          if constexpr(iloadtide==1) { // loading tide
 4149:             assert(false && "Loading tide not implemented");
 4150:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4151:          }
 4152:          
 4153:       }
 4154:       
 4155:    }
