 2160:    template<typename T>
 2161:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2162:       // Get the values of the field at the nodes of the element
 2163:       res[0] = nodes[0]->*field;
 2164:       res[1] = nodes[1]->*field;
 2165:       res[2] = nodes[2]->*field;
 2166:       if (isQuad()) res[3] = nodes[3]->*field;
 2167:       else          res[3] = T();
 2168:    }
 2169: 
 2170:    template<typename T>
 2171:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2172: 
 2173:       assert(level < nvrt && "Level is out of range");
 2174:       // Get the values of the field at the nodes of the element
 2175:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2176:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2177:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2178:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2179:       else          res[3] = T();
 2180:    }    
 2181: 
 2182:    template<typename T>
 2183:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2184: 
 2185:       assert(level < nvrt && "Level is out of range");
 2186: 
 2187:       // Get the values of the func at the nodes of the element
 2188:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2189:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2190:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2191:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2192:       else          res[3] = T();  // This is 0.0 or a zero vector
 2193: 
 2194:    }      
