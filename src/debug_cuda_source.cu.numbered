 4090:    __global__ void backtrackAllNodes(void) {
 4091: 
 4092:       // max/min # of sub-divisions
 4093:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4094:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4095: 
 4096: 
 4097:       SIDE(side);
 4098: 
 4099:       const int kb = side->kb;
 4100: 
 4101: 
 4102:       // Initialize btrack velocities to the actual velocities at the side 
 4103:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4104: 
 4105:   
 4106: 
 4107:       if (side->isDry) return;
 4108:       
 4109: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4110: 
 4111:       // Checks that at least one element is not dry
 4112:       const Element *elem1 = side->elems[0];
 4113:       const Element *elem2 = side->elems[1];
 4114: 
 4115: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4116: 
 4117:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4118:       
 4119:       // XXXXXX
 4120:       // !swild_tmp to store global coord. of the starting side
 4121:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4122:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4123:       // !Use sframe2 
 4124:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4125: 
 4126: 
 4127:       for (int k = kb; k < nvrt; k++) {
 4128:       //  Initialize (xt,yt,zt), nnel and vel.
 4129:       //  For ics=2, the coordinates are in local frames
 4130:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4131: 
 4132: 
 4133:          const int iadvf = side->iadv();  // Advection flag   
 4134:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4135: 
 4136:          Point3 xt;
 4137:          if constexpr(ics==1) {
 4138:             xt = side->center3D(k); 
 4139:          }
 4140:          else // lat/lon; in side lat/lon frame
 4141:          {
 4142:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4143:          // XXX IMPLEMENT THIS
 4144:       //          xt=0.d0
 4145:       //          yt=0.d0
 4146:       //          !centroid coord. for nudging
 4147:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4148:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4149:          }  // ics
 4150: 
 4151: 
 4152: 
 4153:          // If on land or open boundary...
 4154:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4155:          
 4156:          const double vmag = length(side->u2[k]);
 4157: 
 4158:          if (vmag <= velmin_btrack) {
 4159:             // No activity 
 4160: 
 4161:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4162: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4163: 
 4164: 
 4165:             
 4166:          } else {  // do btrack
 4167: 
 4168:             // Compute number of sub-divisions based on local gradients of the velocity field
 4169: 
 4170:             // XXX IS THIS NECESSARY?
 4171:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4172:             double suma = 0.0;
 4173:             int icount = 0;
 4174:             for (int l=0; l<2; l++) {
 4175:             // For each element sharing the side...
 4176: 
 4177:                const Element *elem = side->elems[l];
 4178:                  
 4179:                if (elem == nullptr) continue;
 4180: 
 4181:                icount++;
 4182: 
 4183:                // Not strictly along z; in ll frame for ics=2
 4184: 
 4185:                ShapeCoords utmp, vtmp;
 4186:                for (int j = 0; j < elem->i34; j++) {
 4187: 
 4188:                   const Node *node = elem->nodes[j];
 4189: 
 4190:                   if constexpr(ics==1) {
 4191:                      utmp[j] = node->u2[k].x;
 4192:                      vtmp[j] = node->u2[k].y;  
 4193:                   } else {
 4194:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4195:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(j),vtmp0(j))
 4196:                   }
 4197:                } // for j
 4198: 
 4199:                const Vector2 grad_u = elem->grad2(utmp); 
 4200:                const Vector2 grad_v = elem->grad2(vtmp);
 4201: 
 4202:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4203:             } // for ii
 4204: 
 4205:             assert(icount > 0 && "Impossible 77");
 4206: 
 4207:             // '4' is somewhat arbitrary
 4208:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4209: 
 4210:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4211: 
 4212:             Vector3 u_int = {0.0, 0.0, 0.0};
 4213: 
 4214: printf("backtrackAllNodes: side->idx = %d, k = %d, dt = %f, dtbk = %f\n", side->idx, k, dt, dtbk);
 4215:             side->btu[k] = side->btrack(k, dt, dtbk);
 4216: 
 4217:                
 4218:          } // if vmag (do backtrack)
 4219: 
 4220: 
 4221:       } // for k=kb,nvrt-1
 4222: 
 4223:    }
 4224: 
 4225: } // extern "C"
