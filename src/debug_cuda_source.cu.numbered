 7126: 
 7127:    __global__ void computeVerticalVelocity(void) {
 7128:       // Computes the vertical velocity at the (2D) element's centroid.
 7129:       // In this function we will be considering volumetric elements, with side faces and a 
 7130:       // bottom and a top face. We will call them SFs, BF and TF.
 7131:       // It computes the flux coming from BF and the SFs.
 7132:       // If the bed is moving, it takes that into account.
 7133:       // Since water is incompressible, the integral of the velocity times the normal vector
 7134:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7135:       // and the BF is equal to the flux going out from the TF.
 7136:       // TF = - BF - sum(SFs).
 7137:       // It then computes the horizontal velocity at the center of TF.
 7138:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7139:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7140:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7141: 
 7142:       ELEM(elem);
 7143: 
 7144:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7145: 
 7146:       if (elem->isDry) return;
 7147: 
 7148:       const int kb = elem->kb;
 7149:       const bool isTri = elem->isTri();
 7150: 
 7151:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7152: 
 7153:       // Compute the bottom velocity
 7154:       if constexpr(imm != 0) {
 7155:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7156:       }
 7157: 
 7158: 
 7159:       double bottomArea3D;
 7160:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7161: 
 7162:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7163: 
 7164:       double topArea3D;
 7165: 
 7166:       // Bottom face flux
 7167:       double bottomFlux = 0.0;
 7168:       Vector2 u2meanBottom = {0.0, 0.0};
 7169:       const Vector2 gradh = elem->grad2(&Node::depth);
 7170:       if constexpr(imm==2) {
 7171:          Vector3 ubed;
 7172: 
 7173:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7174:          // updateBDEF(ubed);
 7175:      
 7176:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7177: 
 7178:          // elem->w[kb] += ubed.z;
 7179:       }
 7180:       else {
 7181: 
 7182:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7183:   
 7184:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7185:          // in the direction of motion.
 7186:          const double bottomW = - dot(gradh, u2meanBottom);  
 7187:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7188: 
 7189:          // VElocity associated to the bed deformation
 7190:          double bedVelocity = 0.0;
 7191:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7192: 
 7193:          elem->w[kb] = bedVelocity + bottomW; 
 7194: 
 7195:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7196:          
 7197:       } // if imm
 7198: 
 7199:       // Compute w for kb+1 to nvrt-1
 7200:       for (int l = kb; l < nvrt - 1; l++) {
 7201: 
 7202:          // normal vector to the top face of the "volumetric" element (3D)
 7203:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7204: 
 7205:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7206:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7207: 
 7208:          // Compute the total flux at the sides
 7209:          double sideFlux = 0.0;
 7210: 
 7211:          for (int j = 0; j < elem->i34; j++) {
 7212:             const Side *side = elem->sides[j];
 7213:             const int kbs = side->kb;
 7214:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7215:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7216:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7217: 
 7218:             // The area is "clamped" meaning that it takes kb into account.
 7219:             const double sideArea = side->areaClamped(l);
 7220: 
 7221:             const double sign = elem->ssign[j]; 
 7222: 
 7223:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7224:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7225:          }
 7226:          
 7227:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7228:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7229:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7230: 
 7231:          // The flux at the top ace can be computed from the other flows.
 7232:          // All fluxes are in directions into the prism.
 7233:          const double topFlux = - sideFlux - bottomFlux;
 7234: 
 7235:          // Flux at the top face due to the horizontal velocities only
 7236:          // topFlux = topHorizontalFlux + topVerticalFlux
 7237:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7238: 
 7239:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7240:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7241: 
 7242:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7243: 
 7244:          bottomFlux = -topFlux;
 7245:          
 7246:       }
 7247: 
 7248:    }  
 7249: 
 7250: 
 7251: 
 7252: 
 7253: 
 7254: 
 7255: 
 7256: // !===============================================================================
 7257: // !===============================================================================
 7258: 
 7259: } // extern "C"
 7260: 
 7261: #ifdef DONTCOMPILE
 7262: __device__ void computeVerticalAdvection(void) {
 7263:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7264: 
 7265:    sdbt(1:2,:,:)=0.d0
 7266: 
 7267:    const Side *side = FROM kernel;
 7268: 
 7269:    if(side->isDry) return;
 7270: 
 7271:    // If side is wet...
 7272: 
 7273: 
 7274:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7275:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7276:    double ws[nvrt] = {} // w @ side
 7277:    int icount = 0;
 7278:    for (int j=0; j<2; j++) {
 7279:       const Element *elem = side->elements[j];
 7280:        
 7281:       if(elem != nullptr) {
 7282:          icount++;
 7283:          for (int k=0; k<nvrt; k++) {
 7284:             ws[k] = ws[k] + elem->w[k];
 7285:          }
 7286:       }
 7287:    }  // for j
 7288: 
 7289:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7290:    ws = ws/icount;
 7291: 
 7292:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7293:    // Splines allow for a smooth transition between vertical levels.
 7294:    // Splines have continuity restrictions at the internal knots, but
 7295:    // we have to provide the 1st derivatives at the endpoints.
 7296:    const int kbs = side->kbs; 
 7297:    
 7298:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7299:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7300:    initCubicSpline(kbs, nvrt, side, ws, up)
 7301: 
 7302:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7303:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7304:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7305: 
 7306:    // Total advection (average onto side)
 7307:    const Node *node1 = side->nodes[0];
 7308:    const Node *node2 = side->nodes[1];
 7309:    for (int k=kbs(i); k<nvrt; k++) {
 7310: 
 7311:       Vector2 bcc1 = node1->bcc[k];
 7312:       Vector2 bcc2 = node2->bcc[k];
 7313:       if constexpr(ics == 2) {
 7314:          // Project the velocities from the node frames to the side frame
 7315:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7316:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7317:       }
 7318: 
 7319:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7320:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7321: 
 7322:    }
 7323: }
 7324: #endif
 7325: 
 7326: 
 7327: extern "C" {
 7328:    __global__ void computeElemAverageGhat(void) {
 7329:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7330: 
 7331:       ELEM(elem);
 7332:       
 7333:       elem->ghat1= {0.0, 0.0};  
 7334: 
 7335:       if constexpr(ihydraulics != 0) {
 7336:          if (nhtblocks > 0 && elem->isblock) return;
 7337:       }
 7338: 
 7339:       
 7340:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7341:       // cff1-3: coefficients for 2D/3D
 7342: 
 7343:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7344:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7345:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7346: 
 7347:       if (elem->isDry) return;
 7348: 
 7349:       // Average of the coefficients
 7350:       double av_cff1 = 0.0;  // av. for cff1
 7351:       double av_cff2 = 0.0;  // av. for cff2
 7352:       double av_cff3 = 0.0;  // av. for cff3
 7353:       double av_df = 0.0;  // av. for H^\alpha / H
 7354:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7355:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7356: 
 7357:       const int i34 = elem->i34;
 7358:       const int kb  = elem->kb;
 7359: 
 7360:       for (int j=0; j<i34; j++) {
 7361:          // For each node and side in the element...
 7362: 
 7363:          const Node *node = elem->nodes[j];
 7364:          const Side *side = elem->sides[j];
 7365: 
 7366:          const double chi      = side->chi;
 7367:          const double veg_c2   = side->veg_c2;
 7368:          const double veg_beta = side->veg_beta;
 7369:          const double veg_h    = side->veg_h();
 7370:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7371: 
 7372:          const Vector2 gradPhi = elem->gradPhi[j];
 7373: 
 7374:          // Node - const in elem
 7375:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7376:          elem->gradPr  += node->pr  *gradPhi;
 7377: 
 7378:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7379: 
 7380:         
 7381:          const double htot  = side->htot2();        // Total depth at the side
 7382:          const double zctr2 = side->zTopCanopy();  
 7383: 
 7384:          double cff1; 
 7385:          double cff2; 
 7386:          double cff3;   
 7387:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7388:          // coefficients applied to 2D/3D case 
 7389:             cff1 = side->hhat/htot;
 7390:             cff2 = 0.0;
 7391:             cff3 = 0.0;
 7392:          } else { //3D
 7393:             //Init for no-veg case
 7394:             cff1 = 1.0;
 7395:             cff2 = 1.0;
 7396:             cff3 = 0.0;
 7397: 
 7398:             if constexpr(iveg != 0) {
 7399:                // Computes coefficients used with vegetation terms G1, G2
 7400:                // cff1, cff3 are used for the first two terms in G1, G2:
 7401:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7402:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7403:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7404:                if(veg_h < 0.99*htot) { // submergent vegetation
 7405:                   cff1 = 1.0;
 7406:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7407:                   cff3 = veg_c;
 7408: 
 7409:                } else { // emergent vegetation
 7410:                   cff1 = 1.0/(1.0 + veg_c2);
 7411:                   cff2 = cff1;
 7412:                   cff3 = 0.0;
 7413: 
 7414:                }
 7415:             } // if iveg
 7416:          } //  2D/3D
 7417: 
 7418:          av_cff1 += cff1/i34;
 7419:          av_cff2 += cff2/i34;
 7420:          av_cff3 += cff3/i34;
 7421:          av_cff2_chi += cff2*chi/i34;
 7422:          av_cff3_chi += cff3*chi/i34;
 7423:          av_df += min(htot, veg_h)/(htot*i34);
 7424: 
 7425: 
 7426:          // btrack values: U^\star, U^{\star\alpha}
 7427:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7428:          Vector2 Ustar       = {0.0, 0.0}; 
 7429:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7430: 
 7431:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7432:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7433:          } else { //3D
 7434:             for (int k = side->kb + 1; k < nvrt; k++) {
 7435:             
 7436:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7437:                Ustar += w2;
 7438: 
 7439:                if constexpr(iveg != 0) {
 7440:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7441:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7442:                        Ustar_alpha += zrat*w2; // XXXX
 7443:                    }
 7444:                }  // if iveg
 7445:             }  // for k
 7446:          }  //2D/3D
 7447: 
 7448:          // If needed, project the side velocities to the element frame
 7449:          if constexpr(ics==2) {
 7450:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7451:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7452:          }
 7453:         
 7454: 
 7455:          // Add btrack & surface stress terms to \breve{G} first
 7456:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7457: 
 7458: 
 7459:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7460:          Vector2 tau    = side->tau();  
 7461:          Vector2 ubstar = side->btu[side->kb + 1];  
 7462: 
 7463:          // If needed, project tau and ubstar to the element frame
 7464:          if constexpr(ics==2) {
 7465:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7466:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7467:          }
 7468: 
 7469:          // Term for surface and bottom stress
 7470:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7471: 
 7472: 
 7473:          // All terms in F,F^\alpha,f_b except baroclinic
 7474:          // F, f_b: all explicit terms excluding vegetation 
 7475:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7476:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7477:          const double coriolis = side->coriolis;
 7478:          Vector2 F  =  coriolis*side->U;  // F_x
 7479:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7480:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7481: 
 7482:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7483:             
 7484:             for (int k = side->kb; k < nvrt; k++) {
 7485:                if (zctr2 > side->zc[k-1]) {
 7486:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7487:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7488:                    Fa +=  coriolis*w2*zrat;
 7489:                } // if zctr2
 7490:             } // k
 7491:          } // iveg
 7492: 
 7493:          // Integrate horizontal viscosity force vertically
 7494:          for (int k=side->kb + 1; k<nvrt; k++) {
 7495:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7496: 
 7497:             F += levelHorVisc;
 7498: 
 7499:             // Vegetation term
 7500:             if constexpr(iveg!=0) {
 7501:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7502:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7503:                   Fa += levelHorVisc*zrat;
 7504:                } 
 7505:             } // if iveg
 7506:          } // for k
 7507: 
 7508:          // Get nu*grad(U) at the side's bottom level
 7509:          Vector2 nuGradU = side->nuGradU[side->kb];
 7510: 
 7511:          fb += nuGradU;
 7512: 
 7513:          // If needed, project vectorsF, fb and Fa to the element frame
 7514:          if constexpr(ics==2) {
 7515:             F    = side->frame.projHorVec(F,    elem->frame);
 7516:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7517:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7518:          } // if ics
 7519: 
 7520:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7521:       } // for j (nodes and sides)
 7522: 
 7523:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7524: 
 7525: 
 7526:       // Finish off terms in F, F^\alpha and f_b
 7527:       const double grav3 = elem->mean(&Node::grav2);
 7528:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7529:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7530:       for (int j=0; j<i34; j++) { 
 7531:          // For each side in the element...
 7532:          const Side *side = elem->sides[j];
 7533:          const double chi = side->chi;
 7534: 
 7535:          const double htot = side->htot2();
 7536:          const double veg_h = side->veg_h();
 7537:          const Vector2 F  = htot*fb;
 7538:          const Vector2 Fa = min(htot, veg_h)*fb;
 7539: 
 7540:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7541:       } // for j
 7542: 
 7543:       // tmp is already in elem frame
 7544:       elem->ghat1 += tmp/i34;
 7545: 
 7546:       // Baroclinic force
 7547:       if constexpr(ibc==0) {
 7548:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7549: 
 7550:          Vector2 Fa = {0.0, 0.0};
 7551:          Vector2 intGradRho = {0.0, 0.0};
 7552:          
 7553:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7554:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7555:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7556: 
 7557:             // \in F [m^2/s/s]
 7558:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7559:          }
 7560: 
 7561:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7562:          const Vector2 F = av_df*Fa; //approx
 7563:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7564: 
 7565:       } // if ibc
 7566: 
 7567: 
 7568: 
 7569:    }
 7570: 
 7571: } // extern "C"
 7572: 
 7573: 
 7574: 
 7575: #ifdef DONTCOMPILE
 7576: __global__ void checkMassConservation(Tracers* sumtr) {
 7577: 
 7578:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7579: 
 7580:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7581: 
 7582:    Element *elem = &(mesh->localElemData[i]);
 7583: 
 7584:    // Skip dry elements
 7585:    if (elem->isDry) return;
 7586: 
 7587:    // Local sum array for this thread
 7588:    double localSum[N_TRACERS] = {0.0};
 7589: 
 7590:    // Sum over vertical levels for this element
 7591:    const int kbe = elem->kbe;
 7592:    const double area = elem->area;
 7593: 
 7594:    for (int k = kbe; k < nvrt; k++) {
 7595:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7596:       
 7597:       // Accumulate tracer mass
 7598:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7599:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7600:       }
 7601:    }
 7602: 
 7603:    //  This function returns per element sums. A reduction must be done on the host side.
 7604: }
 7605: 
 7606: 
 7607: __global__ void transport(void) {
 7608: 
 7609:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7610: 
 7611:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7612: 
 7613:    Element *elem = &(mesh->localElemData[ie]);
 7614: 
 7615:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7616: 
 7617:                for (int m=0; m<ntr; m++) {
 7618:                   for (int k=kbe(ie); k<nvrt; k++) {
 7619:                      // Calculate each polynomial's weight 
 7620:                      wm=0.d0; sum1=0.d0; 
 7621:                      wm1=0.d0; wm2=0.d0; 
 7622:                      for (int i=0; i<elem->nweno2; i++) {
 7623:                   
 7624:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7625:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7626:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7627:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7628:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7629:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7630:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7631:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7632:                      // -----------------Hu and Shu (1999)'s method----------------
 7633:                      b4=b1+b2+b3
 7634: 
 7635: //Error: add PRODUCTION CPP
 7636: #ifdef DEBUG
 7637:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7638:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7639:                     call parallel_abort(errmsg)
 7640:                   }
 7641: #endif
 7642: 
 7643:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7644:                   // !----test-------------- 
 7645:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7646:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7647:                   // !wm(i)=wm1(i)*wm2(i)
 7648:                   // !---------------------- 
 7649:                   sum1=sum1+wm(i)
 7650:                 } // end for i
 7651: 
 7652:                 wm=wm/sum1
 7653: 
 7654:                 for (int j=0; j<elem->i34; j++) {
 7655: 
 7656:                   const Side *side  = elem->sides[j];
 7657:                   const Node *node1 = side->n1;
 7658:                   const Node *node2 = side->n2;
 7659: 
 7660:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7661:                      trsd=0.d0
 7662:                      for (int kk=0; kk<nquad; kk++) {
 7663:                         for (int i=0; i<elem->nweno2; i++) {
 7664:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7665:                         } // end for i   
 7666:                      } // end for kk
 7667:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7668:                   } // outward flux
 7669:                } // end for j=1,i34(ie) ! side
 7670:             }
 7671:          }
 7672:               
 7673: 
 7674: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7675: //             //   calculate each polynomial's weight 
 7676: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7677: //                 wm=0.d0; sum1=0.d0
 7678: //                 do i=1,nweno1(ie) !for each polynomial
 7679: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7680: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7681: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7682: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7683: //                   wm(i)=b2
 7684: //                   sum1=sum1+b2
 7685: //                   !wm(i)=1.d0
 7686: //                   !sum1=sum1+1.d0
 7687: 
 7688: // // Error: PRODUCTION
 7689: // #ifdef DEBUG
 7690: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7691: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7692: //                     call parallel_abort(errmsg)
 7693: //                   endif
 7694: // #endif
 7695: 
 7696: //                 enddo !i
 7697: //                 wm=wm/sum1 !final weight
 7698: 
 7699:                 for (int j=0; j<elem->i34; j++) { // side
 7700:                   const Side *side = elem->sides[j];
 7701:                   const Node *node1 = side->n1;
 7702:                   const Node *node2 = side->n2;
 7703: 
 7704:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7705:                     trsd=0.d0
 7706:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7707:                       for (int i=0; i<elem->nweno1; i++) {
 7708:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7709:                       }
 7710:                     enddo //kk
 7711:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7712:                   } // outward flux
 7713:                 } // end for j=1,i34(ie) ! side
 7714:               } // end for k; ntr 
 7715: 
 7716:             else !simple upwind method
 7717:               do j=1,i34(ie)
 7718:                 jsj=elside(j,ie)
 7719:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7720:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7721:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7722:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7723:                   endif
 7724:                 enddo  !vertical layers
 7725:               enddo !j=1,i34(ie) ! side
 7726:             endif !order of accuracy
 7727: 
 7728:          //  enddo !ie
 7729: // !$OMP     end do
 7730: 
 7731: // !$OMP     master
 7732: //           !message passing
 7733: //           if (nproc>1) then
 7734: //             !make a copy of side concentrations
 7735: //             trsd_tmp0=trsd_tmp 
 7736: 
 7737: //             !this exchange routine swaps interface concentration between two partitions
 7738: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7739: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7740: 
 7741: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7742: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7743: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7744: 
 7745: 
 7746: //             !This obtains final values for interface sides
 7747: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7748: //       :    endif !nproc>1
 7749: //           !message passing end
 7750: // !$OMP     end master
 7751: // !$OMP     barrier
 7752: 
 7753: 
 7754: // !         Do advection; conc @ dry elem will not be changed
 7755: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7756: // !$OMP     do reduction(+: h_mass_in)
 7757: //           do i=1,ne
 7758: //             if(idry_e(i)==1) cycle
 7759: 
 7760: 
 7761: // !           Wet elements with 3 wet nodes
 7762: //             do k=kbe(i)+1,nvrt
 7763: 
 7764: 
 7765: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7766: //               dtb_by_bigv = dtb/bigv
 7767:     
 7768: // !             Advective flux
 7769: //               if (ntd_weno==1 .or. itd_weno==1) then
 7770: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7771: //               else
 7772: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7773: //               endif
 7774: 
 7775: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7776: //               do j=1,i34(i)
 7777: //                 jsj=elside(j,i) !side
 7778: //                 iweno=.true. !use weno reconstruction as default
 7779: //                 iel=ic3(j,i) !neighboring elem
 7780: 
 7781: //                 if(iel/=0) then
 7782: //                   if(idry_e(iel)==1) cycle
 7783: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7784: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7785: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7786: //                     iweno=.false.
 7787: //                   endif
 7788: //                 else !land or open bnd side
 7789: //                   !skip land bnd and outflowing open bnd, 
 7790: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7791: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7792: //                     !For outflow open bnd side, estimate mass in (open
 7793: //                     !side cannot be interface side)
 7794: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7795: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7796: //                     endif
 7797: 
 7798: //                     cycle
 7799: //                   endif
 7800: 
 7801: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7802: //                   iweno=.false.  !reset to upwind
 7803: //                   ibnd=isbs(jsj) !global bnd #
 7804: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7805: //                   nwild(1:2)=0
 7806: //                   do ll=1,2 !nodes
 7807: //                     ndo=isidenode(ll,jsj)
 7808: //                     do lll=1,2 !2 possible bnds
 7809: //                       if(isbnd(lll,ndo)==ibnd) then
 7810: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7811: //                         exit
 7812: //                       endif
 7813: //                     enddo !lll
 7814: //                   enddo !ll
 7815: //                   ind1=nwild(1); ind2=nwild(2);
 7816: 
 7817: //                   do jj=1,natrm
 7818: //                     if(ntrs(jj)<=0) cycle
 7819: 
 7820: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7821: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7822: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7823: //                       enddo !ll
 7824: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7825: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7826: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
