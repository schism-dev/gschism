 3805:    __global__ void computeElevationBoundaryConditions(double time) {
 3806:       // Compute elevation essential boundary conditions 
 3807: 
 3808:       NODE_BND(nodeBnd); // Each boundary node.
 3809: 
 3810:       const Node *node = nodeBnd->node;
 3811:       const int iettype = nodeBnd->iettype;
 3812: 
 3813:       double eic = 0.0;
 3814:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3815:       else               eic = 0.0;
 3816: 
 3817:       const double r_eic = (1.0 - ramp)*eic; 
 3818:       const double r_eth = ramp*nodeBnd->eth;
 3819:       double eta1_bar = r_eic;
 3820: 
 3821: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3822:       // Compute tide elevation
 3823:       if (iettype == 3 || iettype == 5) {   
 3824: 
 3825:          if constexpr(iloadtide==1) { // loading tide
 3826:             assert(false && "Loading tide not implemented");
 3827:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3828:          }
 3829:          
 3830:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3831: 
 3832:             const double efa  = nodeBnd->efa[jfr]; 
 3833:             const double emo  = nodeBnd->emo[jfr]; 
 3834: 
 3835:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3836:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3837:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3838: 
 3839:  printf("++++>> jfr = %d, time = %f, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, time, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3840:          } // for jfr
 3841: 
 3842:       } // if iettype
 3843: 
 3844:       switch (iettype) {
 3845:          case 1:
 3846:          case 2:
 3847:             nodeBnd->elbc = r_eth + r_eic;
 3848:             break;
 3849:          case 3:
 3850:             nodeBnd->elbc = eta1_bar + r_eic;
 3851:             break;
 3852:          case 4:
 3853:             nodeBnd->elbc = r_eth + r_eic;
 3854:             break;
 3855:          case 5:
 3856:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3857:             break;
 3858:       } // switch
 3859: 
 3860: 
 3861:       //Add inverse barometric effects
 3862:       if (iettype != 0 && inv_atm_bnd == 1) {
 3863:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3864:       }
 3865: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3866:    }
 3867: 
 3868: 
 3869:    __global__ void setEssentialBC(void) {
 3870:       // Set essential boundary conditions 
 3871:       NODE(node); // Each boundary node
 3872:       NodeBoundary *nodeBnd = node->nodeBnd;
 3873: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3874:       
 3875: // nodeBnd->isEssentialBC = true;      
 3876:       // Check if this node has essential BC
 3877:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3878:          // Verify BC value is valid
 3879:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3880: 
 3881:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3882:          
 3883:          // Set diagonal to 1 and zero off-diagonals
 3884:          node->coeffDiag = 1.0;
 3885:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3886: 
 3887:          for (int j = 0; j < node->numNodes; j++) {
 3888:                node->coeffMatrix[j] = 0.0;
 3889:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3890:          }
 3891:          
 3892:          // Set solution and RHS to BC value
 3893:          node->mX  = nodeBnd->elbc;
 3894:          node->qel = nodeBnd->elbc;
 3895: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3896:       } else {
 3897:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3898: 
 3899:          for (int j = 0; j < node->numNodes; j++) {
 3900:                Node* nbNode = node->nodes[j];
 3901:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3902:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3903:                   // Verify neighbor's BC value
 3904:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3905: 
 3906:                   // Subtract contribution to RHS
 3907:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3908:                   node->coeffMatrix[j] = 0.0;  
 3909:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3910:                }
 3911:          }
 3912:       }
 3913:    }
 3914: 
 3915: 
 3916:    __global__ void updateElevation(void) {
 3917:       NODE(node);
 3918: 
 3919:       node->eta2 = node->mX;
 3920: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 3921:    }
 3922: 
 3923: 
 3924:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3925: 
 3926:       SIDE(side);
 3927: 
 3928: 
 3929:       side->U = {0.0, 0.0}; 
 3930:          
 3931:       if(side->isDry) return;
 3932: 
 3933:       const Node *node1 = side->n1;
 3934:       const Node *node2 = side->n2;
 3935: 
 3936:       // Vertically integrated velocity U (in ll if ics=2)
 3937:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3938:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3939:       }
 3940: 
 3941:    }
 3942: 
 3943:    __global__ void computeBottomDragVegetation(void) {
 3944:       // UNFINISHED. CHECK THIS:
 3945:       // How many kernels are needed? Why so many for loops?
 3946:       // Is the loop on sides needed?
 3947: 
 3948:       NODE(node);
 3949: 
 3950:       const int    kb      = node->kb;
 3951:       const double htot    = node->htot2();
 3952:       const double rough   = node->rough;
 3953: 
 3954: 
 3955:       if (node->isDry) {
 3956:          // Default values for dry nodes
 3957:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3958:          /// XXX CHECK INDICES
 3959:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3960:       }
 3961: 
 3962:       // Compute bottom drag Cd
 3963:       //--------------------------------
 3964: 
 3965:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3966:       if (nchi==1) {
 3967: 
 3968:          bool ltmp = false; // for WBL iteration
 3969: 
 3970:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3971:          // Drag at nodes
 3972:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3973:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3974:         
 3975:          const double rough = node->rough;
 3976:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3977:          if (node->rough == 0.0) {
 3978:             node->Cd = 0.0;
 3979: 
 3980:          } else { //roughness >0 
 3981:             
 3982:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 3983:             const double bthick = max(dzb_min, bthick_ori);
 3984: 
 3985:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3986: 
 3987:             double tmp = 1.0/(2.5*log(bthick/rough));
 3988:             node->Cd = tmp*tmp;
 3989: 
 3990:          } // if rough
 3991: 
 3992: 
 3993:          // RECOVER THIS: XXX
 3994:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3995:          // Output warning for WBL if iteration didn't converge
 3996: 
 3997: 
 3998:       } // nchi==1
 3999: 
 4000:       //   Bottom stress in m^2/s^2
 4001:       if (node->rho[kb + 1] >= -98.0)
 4002:       {
 4003:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4004:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4005:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4006:          // !sediment erosion: this part needs more documentation
 4007:       }
 4008: 
 4009:     
 4010:       // Compute vegetation parameters
 4011:       //--------------------------------
 4012: 
 4013:       // SAV constants
 4014:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4015:       constexpr double veg_cfpsi = 0.16;
 4016: 
 4017:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4018:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4019: 
 4020:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4021:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4022:          int kbin = 0; // bin index
 4023:          for (int k = kb; k < nvrt; k++) {
 4024:             // Computes node height above the bottom level
 4025:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4026:             assert(false && "Vertical variation of vegetation not implemented");
 4027: 
 4028:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4029:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4030:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4031:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4032:             // } else {
 4033:             //    // Find the bin at which the current vertical level is
 4034:             //    while (kbin<nbins_veg_vert) {
 4035:             //       const double zn = node->z[kbin];
 4036:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4037:             //          break;
 4038:             //       } // if
 4039:             //       kbin++;
 4040:             //    } // while
 4041:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4042: 
 4043:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4044:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4045:                
 4046:             //    // Linear interpolation of the vegetation parameters
 4047:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4048:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4049:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4050:             // } // if rl10
 4051: 
 4052:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4053: 
 4054:          } // for k
 4055: 
 4056: 
 4057:       } else { // Ganthy (iveg=2)
 4058:       //  Modify canopy height, diameter, and density
 4059: 
 4060:          // Make sure there is vegetation on this node
 4061:          if (node->veg_h_unbent > 0.0) {
 4062:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4063: 
 4064:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4065:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4066:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4067: 
 4068:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4069:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4070:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4071:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4072:          } // if veg_h_unbent
 4073: 
 4074:          for (int k = 0; k < nvrt; k++) {
 4075:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4076:          } // for k
 4077:       
 4078: 
 4079:       } // if iveg
 4080:      
 4081:          
 4082: 
 4083:       // Compute vertical mean of veg_alpha3D
 4084:       if (iveg != 0) {
 4085:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4086:          double sum1=0.0;
 4087:          double sum2=0.0;
 4088:          // Integrate over each level under the canopy...
 4089:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4090:             const double Dz = node->Dz(k);
 4091: 
 4092:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4093:             sum2 += Dz;
 4094: 
 4095:          } // for k
 4096: 
 4097:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4098:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4099: 
 4100:       } // if iveg
 4101: 
 4102:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4103: 
 4104:    }
 4105: 
 4106:    __global__ void computeVegetationAndDragParameters(void) {
 4107:       // Computes the vegetation and drag model parameters:
 4108:       // chi, \tilde\chi, beta, \breve{H}
 4109:       
 4110:       SIDE(side);
 4111: 
 4112:       const double htot = side->htot2();
 4113:       const int    kb   = side->kb;
 4114: 
 4115:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4116: 
 4117:       const double veg_h     = side->veg_h();
 4118:       const double veg_nv    = side->veg_nv();
 4119:       const double veg_c     = side->veg_c();
 4120:       const double veg_beta  = side->veg_beta;
 4121:       const double veg_alpha = side->veg_alpha_vert_mean();
 4122: 
 4123:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4124:       // Velocity magnitude at the bottom level
 4125:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4126:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4127:       side->chi2 = side->Cd()*vmag1;
 4128:       side->chi  = side->chi2;
 4129:       if constexpr(iveg != 0) {
 4130:          const Node *n1 = side->n1;
 4131:          const Node *n2 = side->n2;
 4132:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4133:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4134:       }
 4135: 
 4136:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4137: 
 4138:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4139:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4140:       double magUa = 0.0;
 4141:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4142:          // 3D wet side with veg...
 4143: 
 4144:          double magUa = 0.0;
 4145:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4146:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4147: 
 4148:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4149:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4150:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4151: 
 4152:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4153:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4154: 
 4155:                // Velocity magnitude at the bottom (l) of the level
 4156:                const double ul = length(side->u2[k]);
 4157: 
 4158:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4159:                magUa += Dz*0.5*(uh + ul);
 4160: 
 4161:             } // if HasVegetation
 4162:          } // for k
 4163:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4164: 
 4165:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4166:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4167:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4168:             const double zCpy = side->zTopCanopy();
 4169:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4170:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4171:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4172:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4173:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4174:          } // if isSubmerged
 4175:       } // if iveg   
 4176: 
 4177:       // Computes the friction modified depth, \breve{H} in notes
 4178:       if (side->is2D()) { // 2D
 4179: 
 4180:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4181:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4182: 
 4183:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4184: 
 4185:          side->hhat = htot*htot/fricH; 
 4186: 
 4187:       } else { // 3D
 4188:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4189: 
 4190:          if constexpr(iveg != 0) {
 4191:             
 4192:             if (side->isSubmerged()) { 
 4193:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4194:                side->hhat -= veg_c*Hhat_alpha;
 4195: 
 4196:             } else { // Emergent
 4197:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4198:             }
 4199:          } // if iveg
 4200: 
 4201:          // Enforce positivity for 3D model
 4202:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4203:       } // if 3D
 4204: 
 4205:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4206: 
 4207:         
 4208:    }
 4209: 
 4210: 
 4211: 
 4212:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4213:    // Computes the density gradient between two elements, e1 and e2.
 4214:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4215:    // zero in the direction normal to the side. 
 4216:    // 
 4217:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4218:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4219:    //
 4220:    // Input:
 4221:    //    e1: Element
 4222:    //    e2: Neighbor element (or nullptr if boundary)
 4223:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4224:    //    k: Index of the half-level at which the density is interpolated
 4225:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4226:    // 
 4227:    // Output:
 4228:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4229:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4230: 
 4231:       if (e2 == nullptr || e2->isDry) {
 4232:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4233: 
 4234:          Side *side = e1->sides[j];
 4235:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4236:                  
 4237:          if constexpr(ics == 1) {
 4238:             vec = side->n; // Normal vector to the side
 4239:          } else {
 4240:             // IMPLEMENT THIS XXXXXX
 4241:             // !replace with xel, yel?
 4242:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4243:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4244:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4245:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4246:          } //ics
 4247:                    
 4248:          diffRho = 0.0;
 4249: 
 4250:       } else { //internal and wet
 4251:          if constexpr(ics==1) {
 4252:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4253: 
 4254:             // Vector from e1 to e2
 4255:             vec = toVector2(e2->center - e1->center);
 4256: 
 4257:          } else { 
 4258:             // IMPLEMENT THIS XXXXXX
 4259:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4260:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4261:             //                   alow(j)=xctr2
 4262:             //                   bdia(j)=yctr2
 4263:          } // ics
 4264: 
 4265:          diffRho = rho2 - e1->demeanedDensity(k);
 4266:       }
 4267: 
 4268:    }
 4269: 
 4270:    __global__ void computeDensityCubicSplines(void) {
 4271:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4272: 
 4273:       ELEM(elem);
 4274: 
 4275:       if (elem->isDry) return;
 4276: 
 4277:       const int kb = elem->kb;
 4278: 
 4279:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4280:       if (elem->is2D()) {
 4281:          // In the 2D case, the density is constant at the prism level. 
 4282:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4283:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4284:       } else { //3D
 4285: 
 4286:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4287:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4288:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4289:          ///// XXXX CHECK INDICES!!!!!
 4290:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4291:       } // 2D/3D
 4292: 
 4293:    }
 4294: } // extern "C"
 4295: 
 4296: 
 4297: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4298: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4299: 
 4300:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4301: 
 4302:    const int kb  = elem->kb;
 4303:    const int kb2 = elem2->kb;
 4304: 
 4305:    // z-coordinate of prism of elem
 4306:    const double zp = elem->z_prism(k);
 4307: 
 4308:    double rho = 0.0;
 4309: 
 4310:    if (elem2->is2D()) {
 4311:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4312: 
 4313:    } else {  // 3D
 4314: 
 4315:       // eta_min may be < zmax
 4316:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4317:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4318: 
 4319:       // (Extrapolate density below bottom, we will fix it later)
 4320:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4321:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4322:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4323:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4324:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4325:    } // 2D/3D
 4326:      
 4327: 
 4328:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4329:    // Now we need to fix it.
 4330:    if (elem->z[k] < elem2->z[kb2]) {
 4331:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4332: 
 4333:       // There are two methods to adjust the density at the bottom of the element.
 4334:       // iunder_deep=0: 
 4335:       const double depth1 = abs(elem->z[kb]); // larger depth
 4336: 
 4337:       if (iunder_deep==0) {
 4338: 
 4339:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4340: 
 4341:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4342: 
 4343:       } else { // iunder_deep != 0
 4344: 
 4345:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4346: 
 4347:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4348: 
 4349:          //   Demeaned density at the same z coordinate as
 4350:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4351:          }
 4352: 
 4353:       } // if iunder_deep
 4354:    } // if elem->z[kb] < elem2->z[kb]
 4355: 
 4356:    return rho;
 4357: }
 4358: 
 4359: 
 4360: extern "C" {
 4361:    __global__ void computeDensityGradient(void) {
 4362: 
 4363:          // Compute the horizontal density gradient at each element.
 4364:       // It works in two steps:
 4365:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4366:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4367:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4368:       //             gradRho.r1 = rho1 - rho0
 4369:       //             gradRho.r2 = rho2 - rho0
 4370:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4371:       // 
 4372:       //  NOTE: We use de-meaned densities.
 4373: 
 4374:       ELEM(elem);
 4375: 
 4376:       if (elem->isDry) return;
 4377: 
 4378:       const int kb  = elem->kb;
 4379:       const int i34 = elem->i34;
 4380: 
 4381:       for (int k = kb + 1; k < nvrt; k++) {
 4382:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4383:          //             gradRho.r1 = rho1 - rho0
 4384:          //             gradRho.r2 = rho2 - rho0
 4385:          int icount = 0;
 4386:          double sumRx = 0.0;
 4387:          double sumRy = 0.0;
 4388:          for (int j1=0; j1<i34; j1++) { 
 4389: 
 4390:             const int j2 = elem->nxq(j1 + 1);
 4391: 
 4392:             // Pairs of consecutive neighbor elements of elem
 4393:             const Element *e1 = elem->nghbElems[j1];
 4394:             const Element *e2 = elem->nghbElems[j2];
 4395: 
 4396:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4397:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4398:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4399: 
 4400:             // Compute the density difference and the vector from elem to e1 and e2
 4401:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4402:             double diffRho1, diffRho2;
 4403:             Vector2 vec1, vec2;
 4404:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4405:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4406: 
 4407:             const double rl1 = length(vec1);
 4408:             const double rl2 = length(vec2);
 4409:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4410: 
 4411:             const double delta = cross(vec1, vec2);
 4412:             const double sintheta = abs(delta)/(rl1*rl2);
 4413: 
 4414:             // To avoid problems, avoid elements with small angle between vectors
 4415:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4416:             const bool validEq = (sintheta > sin_one_deg);
 4417: 
 4418:             if (validEq) {
 4419:                // Solve the system of equations to get the density gradient at elem
 4420:                icount++;
 4421:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4422:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4423:                sumRx += Rx;
 4424:                sumRy += Ry;
 4425:             }
 4426:          } // for j1
 4427: 
 4428:          // Compute the average density gradient at elem
 4429:          if (icount==0) {
 4430:            // Bad mesh quality; bail out with 0 b-cc
 4431:            elem->gradRho[k] = {0.0, 0.0};
 4432:          } else {
 4433:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4434:          }
 4435: 
 4436:       } // for k
 4437: 
 4438:    }
 4439: 
 4440:    __global__ void computeBaroclinicTerm(void) {
 4441:    // Computes the baroclinic term at sides (at half levels).
 4442:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4443:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4444: 
 4445:       SIDE(side);
 4446: 
 4447:       if (side->isDry) return;
 4448: 
 4449:       const Element *e1 = side->elems[0];
 4450:       const Element *e2 = side->elems[1];      
 4451:       const int kb = side->kb;
 4452:       
 4453:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4454: 
 4455:       // interpolates vertically the density gradient of the two elements at the half level/
 4456: 
 4457:       // Starts the integration at the surface and goes down to the bottom
 4458:       int k1 = nvrt - 1;
 4459:       int k2 = nvrt - 1;
 4460: 
 4461:       side->bcc[nvrt-1] = {0.0, 0.0};
 4462:       for (int k = nvrt-1; k >= kb; k--) {
 4463:       // For each prism level (from surface to bottom)...
 4464: 
 4465:          // For both elements, interpolate density gradient at the side's half level.
 4466:          // The gradient at the side is the average of the gradients at the elements.
 4467:          // w1, w2 are used to take into account boundary sides, with just one element.
 4468:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4469:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4470:          const double wsum = w1 + w2;
 4471:          w1 = w1/wsum;
 4472:          w2 = w2/wsum;
 4473:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4474: 
 4475:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4476:          Vector2 gradRho = {0.0, 0.0};
 4477:          if (e1 != nullptr && k > kb) {
 4478:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4479:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4480:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4481:             
 4482:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4483:          }      
 4484:          if (e2 != nullptr && k > kb) {
 4485:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4486:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4487:             
 4488:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4489:          }
 4490: 
 4491:          if constexpr(ics==2) {
 4492:             // IMPLEMENT THIS XXXXXX
 4493:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4494:             // swild(1)=tmp1
 4495:             // swild(2)=tmp2
 4496:          }
 4497:          
 4498:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4499:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4500:          // CHECK INDICES!!! XXX
 4501:          const double grav3 = side->grav3();
 4502:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4503:       } // for
 4504: 
 4505:    }
 4506: 
 4507: 
 4508: 
 4509:    __global__ void computeHorGradientAtSide(void) {
 4510: 
 4511:       // Compute the horizontal density gradient at each element.
 4512:       // It works in two steps:
 4513:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4514:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4515:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4516:       //             gradRho.r1 = rho1 - rho0
 4517:       //             gradRho.r2 = rho2 - rho0
 4518:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4519:       // 
 4520:       //  NOTE: We use de-meaned densities.
 4521: 
 4522:       SIDE(side);
 4523: 
 4524:       if (side->isDry) return;
 4525: 
 4526:       // Computes the gradient of the variables at the side center.
 4527:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4528:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4529:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4530: 
 4531:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4532:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4533:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4534:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4535: 
 4536: 
 4537:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4538:          side->gradEta1.x, side->gradEta1.y, 
 4539:          side->gradEta2.x, side->gradEta2.y, 
 4540:          side->gradETP.x, side->gradETP.y, 
 4541:          side->gradPr.x, side->gradPr.y);
 4542: 
 4543: 
 4544:    }
 4545: 
 4546: 
 4547:    __global__ void solveMomentumEquations(double time) {
 4548: 
 4549:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4550:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4551: 
 4552:       SIDE(side);
 4553: 
 4554:       if (side->isDry) 
 4555:       {
 4556:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4557: 
 4558:          return;
 4559:       }
 4560: 
 4561:       const Node *n1 = side->n1;
 4562:       const Node *n2 = side->n2;
 4563: 
 4564:       const int kb = side->kb;
 4565: 
 4566:       const double veg_h = side->veg_h();
 4567:       const double grav3 = side->grav3();
 4568: 
 4569: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4570:       if (side->is2D()) {
 4571:          // Warning: Do not use htot2, which is updated.
 4572:          const double htot = side->htot1();
 4573:          const double hhat = side->hhat;
 4574: 
 4575:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4576: 
 4577:          Vector2 tau2 = {0.0, 0.0};
 4578:           
 4579:          if constexpr(ics==1) {
 4580:             tau2 = side->tau();
 4581: 
 4582:          } else {
 4583:             assert(false && "Not implemented: ics == 2");
 4584:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4585:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4586:             // taux2=(vn1+tt1)*0.5d0
 4587:             // tauy2=(vn2+ss1)*0.5d0
 4588:          } // if ics         
 4589: 
 4590:          // hat_gam has units of m/s
 4591: 
 4592:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4593: 
 4594:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4595:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4596: 
 4597:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4598: 
 4599:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4600:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4601: 
 4602:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4603: 
 4604: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y);
 4605: 
 4606:       }
 4607:       else { // 3D
 4608: 
 4609:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4610:          // 
 4611:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4612:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4613:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4614:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4615:          // k+1 and k.
 4616: 
 4617: 
 4618:          // // Define layer thickness & viscosity
 4619:          // for (int k=kb + 1; k<nvrt; k++) {
 4620:          //    const double dzz = side->Dz(k - 1);
 4621: 
 4622:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4623: 
 4624:          //    // Vertical viscosity at the face center
 4625:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4626:         
 4627:          // }
 4628: 
 4629: 
 4630:          const int ndim = nvrt - kb;
 4631:          const double zTopCanopy = side->zTopCanopy();
 4632: 
 4633:          // Initialize the tridiagonal system
 4634:          for (int k = kb + 1; k<nvrt; k++) {
 4635:             
 4636:             const int kin = k - kb;
 4637: 
 4638:             // Vertical viscosity at the face center
 4639:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4640:             const double dzz = side->Dz(k);
 4641: 
 4642:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 4643:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 4644:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4645: 
 4646:             alow[kin] = 0.0;
 4647:             cupp[kin] = 0.0;
 4648:             bdia[kin] = 0.0;
 4649: 
 4650:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4651:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4652: 
 4653:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4654:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4655:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4656: 
 4657:             // First part: layers k, k+1
 4658:             if (k < nvrt - 1) {
 4659:                              
 4660:                if constexpr(iveg != 0) {
 4661: 
 4662:                   // If there is vegetation at this level...
 4663:                   if (zTopCanopy > side->zc[k]) {
 4664:                      // If the canopy is above the k layer...
 4665:                      
 4666:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4667:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4668:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4669:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4670: 
 4671:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4672:                      const double vmag2 = length(ut2);
 4673:                      const double vmag1 = length(side->u2[k]);
 4674:                      const double vmag = 0.5*(vmag1 + vmag2);
 4675:                      
 4676:                      // Computes the vegetation alpha at the face center
 4677:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4678: 
 4679:                      cff1 += veg_alpha_sd*dt*vmag;
 4680: 
 4681:                   } // if (zTopCanopy
 4682:                } // if iveg
 4683: 
 4684:                const double tmp = dt*dfz/dzz;
 4685:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4686:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4687: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 4688:             }
 4689: 
 4690: 
 4691:             // Second part: layers k-1, k
 4692:             if (k > kb + 1) {
 4693: 
 4694:                double cff1 = 1.0; //init \bar{c^k}
 4695: 
 4696:                if constexpr(iveg != 0) {
 4697:                   // If there is vegetation at this level...
 4698:                   if (zTopCanopy > side->zc[k-1]) {
 4699:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4700:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4701: 
 4702:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4703: 
 4704:                      const double vmag2 = length(ut2);
 4705:                      const double vmag1 = length(side->u2[k-1]);
 4706:                      const double vmag = 0.5*(vmag1 + vmag2);
 4707: 
 4708:                      // Computes the vegetation alpha at the face center
 4709:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4710:                      cff1 += veg_alpha_sd*dt*vmag;
 4711:                   } // if zTopCanopy
 4712: 
 4713:                } // if iveg
 4714: 
 4715:                const double tmp = dt*dfz/dzz;
 4716:                alow[kin] += cff1*dzz/6.0 - tmp;
 4717:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4718: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 4719:             } else { // Bottom boundary
 4720:                // This occurs at the bottom, where the bottom drag is applied.
 4721: 
 4722:                bdia[kin] += dt*side->chi2;
 4723: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 4724:             } // if (k > kb + 1)
 4725: 
 4726: 
 4727: 
 4728:          } // for (int k
 4729: 
 4730: 
 4731: 
 4732:          // Computes the RHS.
 4733:          // -----------------
 4734: 
 4735:          //	BC to be imposed at the end.
 4736: 
 4737:          const Vector2 gradETP  = side->gradETP;
 4738:          const Vector2 gradPr   = side->gradPr;
 4739:          const Vector2 gradEta1 = side->gradEta1;
 4740:          const Vector2 gradEta2 = side->gradEta2;
 4741: 
 4742:          const Vector2 *btu = side->btu;
 4743:          const Vector2 *u2  = side->u2;
 4744:          const double coriolis = side->coriolis;
 4745:          const Vector2 *d2uv = side->d2uv;
 4746: 
 4747: 
 4748:          for (int k = kb + 1; k<nvrt; k++) {
 4749:             const int kin = k - kb;
 4750: 
 4751:             const double dz_0 = side->Dz(k);
 4752:             const double dz_1 = side->Dz(k+1);  
 4753: 
 4754:             rrhs[kin] = {0.0, 0.0};
 4755:             double dz = 0.0;
 4756: 
 4757:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 4758:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 4759:             if (k < nvrt  ) dz += 0.5*dz_1;
 4760:             if (k > kb + 1) dz += 0.5*dz_0;
 4761: 
 4762:             // Elevation gradient, atmospheric pressure and tidal potential
 4763:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 4764: 
 4765:             // Coriolis, advection, wind stress, and horizontal viscosity
 4766:             if (k < nvrt - 1) {
 4767: 
 4768: 
 4769:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 4770:                                           (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 4771:                                           dt*(2.0*d2uv[k] + d2uv[k + 1]));
 4772: 
 4773:                //diff stress tensors 1006
 4774:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 4775:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 4776:                   assert(false && "Not implemented: itur == 5");
 4777:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 4778:                }
 4779: 
 4780:             } else { // k=nvrt
 4781:                Vector2 tau2 = {0.0, 0.0};
 4782:                if constexpr(ics==1) {
 4783:                   tau2 = side->tau();
 4784:                } else {
 4785:                   assert(false && "Not implemented: ics == 2");
 4786:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4787:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4788:                   // taux2=(vn1+tt1)*0.5d0
 4789:                   // tauy2=(vn2+ss1)*0.5d0
 4790:                } // if ics
 4791: 
 4792:                rrhs[kin] += dt*tau2;
 4793: 
 4794:             } // if k<nvrt
 4795: 
 4796:             if (k > kb + 1) {
 4797:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k - 1] + 
 4798:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 4799:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 4800: 
 4801: 
 4802:                // diff stress tensors 1006
 4803:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 4804:                   assert(false && "Not implemented: itur == 5");
 4805:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 4806:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 4807:                }
 4808: 
 4809:             } // if k>kbs + 1
 4810: 
 4811:             // Baroclinic
 4812:             Vector2 *bcc = side->bcc;
 4813:             if constexpr(ibc == 0) {
 4814:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 4815:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 4816: 
 4817:             } // if ibc==0
 4818: 
 4819: 
 4820:          } // k=kb + 1,nvrt
 4821: 
 4822:    printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 4823:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4824:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 4825: 
 4826:          for (int k=kb + 1; k<nvrt; k++) {
 4827:             const int kin = k - kb;
 4828: 
 4829:             // Velocity is always clamped to maximum values
 4830:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 4831:          } // k
 4832: 
 4833:       } // if side->is2D()
 4834:       
 4835: 
 4836:       // Impose velocity boundary conditions at the bottom
 4837:       if constexpr(imm == 2) { // 3D bed deformation model
 4838:          double dep;
 4839:          Vector2 vel;
 4840: 
 4841:          assert(false && "Not implemented: imm == 2");
 4842:          //update_bdef(time, x0, y0, dep, vel);
 4843:          // side->u2[kb] = vel;
 4844: 
 4845:       } else { // imm = 0 or 1
 4846:          if (side->Cd() == 0.0) {
 4847:             side->u2[kb] = side->u2[kb + 1];
 4848:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 4849:             side->u2[kb] = {0.0, 0.0};
 4850:          }
 4851:           
 4852:       } // if imm
 4853: 
 4854:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4855:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 4856:       
 4857: 
 4858:    }
 4859: 
 4860: 
 4861:    __device__ void applyMomentumBC(void) {
 4862: 
 4863:       SIDE_BND(side_bnd);
 4864: 
 4865:       Side *side = side_bnd->side;
 4866:       const BoundarySegment *segment = side_bnd->segment;
 4867:       const Node *n1 = side->n1;
 4868:       const Node *n2 = side->n2;
 4869: 
 4870:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 4871:       const bool isLand     = (segment == (BoundarySegment *)landSegment);
 4872:       const bool isInternal = (segment == (BoundarySegment *)internalSegment);
 4873: 
 4874:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 4875:       const int kb = side->kb;
 4876: 
 4877:       if (!isLand && segment->ifltype != 0) {
 4878:          const Vector2 *uth = side->uth;
 4879: 
 4880:          for (int k=kb; k < nvrt; k++) {
 4881:             assert(segment->ifltype == -2 || (uth[k].x >= -98 && uth[k].y >= -98) && "Momentum BC: Side has no velocity boundary conditions");
 4882: 
 4883:             Vector2 uth = side->uth[k];
 4884: 
 4885:             if (segment->ifltype == -1) {
 4886:                // Flather 1
 4887: 
 4888:                const double depth = side->depth();
 4889: 
 4890:                assert(n1->nodeBnd->eta_mean >= -98 && n2->nodeBnd->eta_mean >= -98 && "Flather bnd elevation not assigned");
 4891:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 4892: 
 4893:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->etaMeanBnd()) + dot(uth, side->n);
 4894: 
 4895:                side->u2[k] = vnorm*side->n;
 4896: 
 4897:             } else if (segment->ifltype == -2) { // Discharge
 4898: 
 4899: 
 4900:                const double eta1 = side->eta1();
 4901:                const double eta2 = side->eta2();
 4902:                const double htot = side->htot2();
 4903: 
 4904:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 4905:                assert(false && "Not implemented: Discharge bc");
 4906:                // const double dischrg = discharge(eta1);
 4907:                const double dischrg = 0.0; // XXX REMOVE
 4908:                
 4909: 
 4910:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 4911: 
 4912:                const double vnorm = dischrg*eta2/htot;
 4913: 
 4914:                side->u2[k] = vnorm*side->n;
 4915: 
 4916: 
 4917:             }
 4918:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 4919:                const double vnorm = dot(side->u2[k], side->n);
 4920: 
 4921:                double rat;
 4922:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 4923:                else              rat = segment->vobc2; // outgoing
 4924: 
 4925:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*uth;
 4926:             }
 4927:             else { // not Flather or 3D radiation
 4928:                side->u2[k] = uth;
 4929: 
 4930:             } // if (segment->ifltype...
 4931: 
 4932:          }
 4933: 
 4934:       }
 4935:       else if (isLand) { // land bnd
 4936:          if constexpr(islip == 0) { // free slip
 4937:             for (int k=kb; k < nvrt; k++) {
 4938:                double vnorm = 0.0; // for most cases
 4939:                const double vtan = dot(side->u2[k], side->t());
 4940:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 4941:             }
 4942: 
 4943:          } else { // no slip
 4944:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 4945: 
 4946:          }
 4947:       } // if (side segment type...
 4948: 
 4949:       
 4950: 
 4951: 
 4952: 
 4953:    }
 4954: 
 4955: 
 4956:    __device__ void shapiroFilter1(void) {
 4957:       // First step of the Shapiro filter (normally used if indvel<=0)
 4958:       // Computes the filtered values and stores them in bcc (as a temporary array).
 4959: 
 4960:       if constexpr(ishapiro == 0) return;
 4961: 
 4962:       SIDE(side);
 4963: 
 4964:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4965: 
 4966:       if (side->isDry || isInternal ) return;
 4967: 
 4968:       const int kb = side->kb;
 4969: 
 4970:       for (int mm = 1; mm <= niter_shap; mm++) {
 4971: 
 4972: 
 4973:          // Internal wet sides
 4974:          for (int k = kb + 1; k < nvrt; k++) {
 4975:             // WARNING: reusing bcc as a temporary array to store the suru values.
 4976:             side->bcc[k] = {0.0, 0.0};
 4977:             Vector2 suru = {0.0, 0.0};
 4978: 
 4979:             for (int j=0; j<4; j++) {
 4980: 
 4981:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 4982:                
 4983:                int kin = k;
 4984:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 4985:                
 4986:                if constexpr(ics==1) {
 4987:                   suru += side->u2[kin];
 4988:                } else {
 4989:                   assert(false && "Not implemented: ics == 2");
 4990:                   // Vector2 vn1, vn2;
 4991:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 4992:                   // suru=suru+vn1;
 4993:                   // surv=surv+vn2;
 4994:                }
 4995:             }
 4996: 
 4997:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 4998: 
 4999:          }
 5000:       }
 5001:    }
 5002: 
 5003:    __device__ void shapiroFilter2(void) {
 5004:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5005: 
 5006:       if constexpr(ishapiro == 0) return;
 5007: 
 5008:       SIDE(side);
 5009: 
 5010:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 5011: 
 5012:       if (side->isDry || isInternal ) return;
 5013: 
 5014:       const int kb = side->kb;
 5015: 
 5016:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5017: 
 5018:       if (side->is2D()) {
 5019:          side->u2[kb] = side->u2[nvrt - 1];
 5020:          
 5021:       } else {
 5022:          // 3D
 5023:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5024:          
 5025:       }
 5026: 
 5027:    }
 5028: 
 5029: 
 5030:    __global__ void ul0UpdateZCoords(void) {
 5031:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5032:       
 5033:       NODE(node);      
 5034: 
 5035:       if (node->isDry2()) { 
 5036: 
 5037:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5038: 
 5039:          if constexpr(ivcor != 1) node->kb = 0;
 5040: 
 5041:       } else {
 5042: 
 5043:          node->updateKb();
 5044:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5045: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 5046: 
 5047:       } // if wet or dry
 5048: 
 5049:       // We use the temp.b field to store the previous state of isDry.
 5050:       node->tmp.b = node->isDry;
 5051: 
 5052:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5053:       node->isDry = true;
 5054: 
 5055:    }
 5056: 
 5057:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5058:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5059:    {
 5060:       ELEM(elem);
 5061: 
 5062:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5063: 
 5064:       // All the nodes of a wet element are wet.
 5065:       if (!elem->isDry) {
 5066:          elem->nodes[0]->isDry = false;
 5067:          elem->nodes[1]->isDry = false;
 5068:          elem->nodes[2]->isDry = false;
 5069:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5070: 
 5071:       }
 5072: 
 5073: 
 5074:       elem->kb = 0;
 5075: 
 5076:       if (elem->isDry) return;
 5077: 
 5078:       // Wet
 5079:       const Node *n1 = elem->nodes[0];
 5080:       const Node *n2 = elem->nodes[1];
 5081:       const Node *n3 = elem->nodes[2];  
 5082:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5083: 
 5084:    //    if(elem->isDry2()) {
 5085:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5086:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5087:    //        call parallel_abort(errmsg)
 5088:    //    }
 5089: 
 5090: 
 5091:       // Computes element's kb as the minimum of the nodes' kb.
 5092:       const int kb1 = n1->kb;
 5093:       const int kb2 = n2->kb;
 5094:       const int kb3 = n3->kb;
 5095:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5096: 
 5097: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5098: 
 5099:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5100: 
 5101: 
 5102:       // Computes the element z as the mean of the nodes z.
 5103:       for (int k = elem->kb; k < nvrt; k++) {
 5104: 
 5105:          // Compute the element z as the mean of the nodes z.
 5106:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5107:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5108:          elem->z[k] /= elem->i34;
 5109: 
 5110:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5111:       }
 5112:                   
 5113:    }
 5114: 
 5115:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5116:    {
 5117:       NODE(node);
 5118:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5119: 
 5120:       if (it == iths) return;
 5121: 
 5122: 
 5123:       if(!node->isDry && node->tmp.b) { // rewetted
 5124:          for (int k=0; k < nvrt; k++) {
 5125: 
 5126:             Vector3 utmp={0.0, 0.0, 0.0};
 5127: 
 5128:             double ttmp=0.0;
 5129:             double stmp=0.0;
 5130:             int icount=0;
 5131:             for (int j = 0; j < node->numNodes; j++) {
 5132: 
 5133: 
 5134:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5135:                if (!node->isDry) { // all indices extended
 5136:                   icount++;
 5137: 
 5138:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5139:                   utmp += node->u2[k];
 5140:                   
 5141:                   ttmp += node->tracers[k].tracer[0]; 
 5142:                   stmp += node->tracers[k].tracer[1]; 
 5143:                }
 5144:             }
 5145: 
 5146:             if(icount > 0) {
 5147:                const double inv_icount = 1.0/icount;
 5148:                node->u2[k]     = inv_icount*utmp;
 5149:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5150:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5151:             }
 5152:          }
 5153:       }
 5154:    }
 5155: 
 5156: 
 5157:    __global__ void ul0UpdateSides(int it, int iths) {
 5158: 
 5159:       SIDE(side);
 5160: 
 5161:       // A side is wet if and only if at least one of its elements is wet.
 5162:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5163: 
 5164:       const Node *n1 = side->n1;
 5165:       const Node *n2 = side->n2;
 5166:       const int kb1 = n1->kb;
 5167:       const int kb2 = n2->kb;
 5168: 
 5169:       side->kb = 0; // dry
 5170: 
 5171:       if (isWet) {
 5172: 
 5173:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5174: 
 5175:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5176: 
 5177:          side->kb = min(kb1, kb2);
 5178: 
 5179:          for (int k = side->kb; k < nvrt; k++) {
 5180:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5181: 
 5182:          
 5183:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5184: 
 5185:             // Compute velocity for re-wetted sides 
 5186:             if ((it != iths) && (side->isDry && isWet)) {
 5187:             
 5188:                Vector2 utmp={0.0, 0.0};
 5189: 
 5190:                int icount=0;
 5191: 
 5192:                // For all the sides on the two elements that share this side
 5193:                for (int j=0; j < 2; j++) {
 5194:                   const Element *elem = side->elems[j];
 5195:                   if (elem == nullptr) continue;
 5196: 
 5197:                   for (int jj=0; jj < elem->i34; jj++) {
 5198:                      const Side *nSide = elem->sides[jj];
 5199:                      if (nSide->isDry) continue;
 5200: 
 5201:                      icount++;
 5202:                      utmp += nSide->u2[k];                     
 5203:                   }
 5204:                }
 5205:                   
 5206:                assert(icount > 0 && "No wet sides around this side");
 5207:                if (icount > 0)  side->u2[k] = utmp/icount;
 5208:                   
 5209:             } // if ((it != iths) && (side->isDry && isWet))
 5210: 
 5211:          } // for k
 5212: 
 5213:       } // if isWet
 5214:    
 5215:       side->isDry = !isWet;
 5216: 
 5217:    }
 5218: 
 5219: 
 5220:    __global__ void zeroNodalVelocities(void) {
 5221:       NODE(node);
 5222: 
 5223:       for (int k = 0; k < nvrt; k++) {
 5224:          node->u2[k] = {0.0, 0.0, 0.0};
 5225:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5226:       }
 5227:    }
 5228: 
 5229:    __global__ void computeNodalVerticalVelocities1(void) {
 5230:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5231:    // Adds the element's vertical velocity times the element's area.
 5232:       ELEM(elem);
 5233: 
 5234:       for (int j = 0; j < elem->i34; j++) {
 5235:          Node *node = elem->nodes[j];
 5236: 
 5237:          for (int k = node->kb; k < nvrt; k++) {
 5238:             node->u2[k].z += elem->w[k]*elem->area;
 5239:             node->tmp.d += elem->area;
 5240:          }
 5241:       }
 5242:    }
 5243: 
 5244:    __global__ void computeNodalVerticalVelocities2(void) {
 5245:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5246:    // Divides by the total area of the elements sharing the    node.
 5247:       ELEM(elem);
 5248: 
 5249:       for (int j = 0; j < elem->i34; j++) {
 5250:          Node *node = elem->nodes[j];
 5251: 
 5252:          for (int k = node->kb; k < nvrt; k++) node->u2[k].z /= node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5253:       }
 5254:    }
 5255: 
 5256:    __global__ void computeNodalHorizontalVelocities(void) {
 5257:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5258:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5259:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5260: 
 5261:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5262: 
 5263:       SIDE(side);
 5264: 
 5265:       const int kb = side->kb;
 5266: 
 5267:       Node *n1 = side->n1;
 5268:       Node *n2 = side->n2;
 5269: 
 5270:       for (int k = kb; k < nvrt; k++) {
 5271: 
 5272:          // Cast the u2 vector into a Vector2 
 5273:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5274:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5275: 
 5276:          n1_u2 += side->u2[k]/n1->numSides;
 5277:          n2_u2 += side->u2[k]/n2->numSides;
 5278: 
 5279:       }
 5280: 
 5281: 
 5282:    }
 5283: 
 5284:    __global__ void resetVelocityOpenBndNodes(void) {
 5285:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5286: 
 5287:       NODE_BND(nodebnd);
 5288: 
 5289:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5290:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5291:       }
 5292: 
 5293:    }
 5294: 
 5295: 
 5296:    __global__ void setVelocityOpenBndNodes(void) {
 5297:    // For open boundary nodes sets their velocity to the imposed values.
 5298: 
 5299:       SIDE_BND(sidebnd);
 5300: 
 5301:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5302:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5303:          // to its segment to the average of the side velocity.
 5304: 
 5305:          for (int k = 0; k < nvrt; k++) {
 5306:             Node *n1 = sidebnd->side->n1;
 5307:             Node *n2 = sidebnd->side->n2;
 5308: 
 5309:             // Cast the u2 vector into a Vector2 
 5310:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5311:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5312: 
 5313:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5314:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5315:          }
 5316:       }
 5317: 
 5318:    }
 5319: 
 5320: 
 5321:    __global__ void computeVerticalVelocity(void) {
 5322:       // Computes the vertical velocity at the (2D) element's centroid.
 5323:       // In this function we will be considering volumetric elements, with side faces and a 
 5324:       // bottom and a top face. We will call them SFs, BF and TF.
 5325:       // It computes the flux coming from BF and the SFs.
 5326:       // If the bed is moving, it takes that into account.
 5327:       // Since water is incompressible, the integral of the velocity times the normal vector
 5328:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5329:       // and the BF is equal to the flux going out from the TF.
 5330:       // TF = - BF - sum(SFs).
 5331:       // It then computes the horizontal velocity at the center of TF.
 5332:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5333:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5334:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5335: 
 5336:       ELEM(elem);
 5337: 
 5338:       if (elem->isDry) return;
 5339: 
 5340:       const int kb = elem->kb;
 5341:       const bool isTri = elem->isTri();
 5342: 
 5343:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5344: 
 5345:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5346:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5347:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5348: 
 5349:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5350: 
 5351:       double area3D;
 5352: 
 5353:       // Bottom face flux
 5354:       double bottomFlux = 0.0;
 5355:       Vector2 u2meanBottom = {0.0, 0.0};
 5356:       const Vector2 gradh = elem->grad2(&Node::depth);
 5357:       if constexpr(imm==2) {
 5358:          Vector3 ubed;
 5359: 
 5360:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5361:          // updateBDEF(ubed);
 5362:      
 5363:          // const double bflux0 = dot(ubed, elem_n1);
 5364: 
 5365:          // elem->w[kb] += ubed.z;
 5366:       }
 5367:       else {
 5368:          Vector2 umean;
 5369:          if constexpr(ics == 1) {
 5370:             u2meanBottom = elem->mean(kb, &Side::u2);
 5371:          }
 5372:          else {
 5373:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5374:          }
 5375: 
 5376:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5377:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5378: 
 5379:          bottomFlux = - dot(gradh, u2meanBottom);
 5380:       } // if imm
 5381: 
 5382:       // Compute w for kb+1 to nvrt-1
 5383:       for (int l = kb; l < nvrt - 1; l++) {
 5384: 
 5385:          // normal vector to the top face of the "volumetric" element (3D)
 5386:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5387: 
 5388:          // Compute the total flux at the sides
 5389:          double sideFlux = 0.0;
 5390:          Vector2 u2top = {0.0, 0.0};
 5391:          for (int j = 0; j < elem->i34; j++) {
 5392:             const Side *side = elem->sides[j];
 5393: 
 5394:             const double sideArea = side->area(l + 1);
 5395:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5396:             const double sign = elem->ssign[j]; 
 5397: 
 5398:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5399:          }
 5400:          
 5401:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5402:          //velocities at the centers of the sides
 5403:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5404: 
 5405:          // The flx at the top ace can be computed from the other flows.
 5406:          const double topFlux = - sideFlux - bottomFlux;
 5407:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5408: 
 5409:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5410: printf("sideFlux = %f, topHorizontalFlux = %f, bottomFlux = %f, area3D = %f, elem->w[%d] = %.16f, elem_n2.z = %f\n", sideFlux, topHorizontalFlux, bottomFlux, area3D, l + 1, elem->w[l + 1], elem_n2.z);
 5411:          elem_n1 = elem_n2;
 5412: 
 5413:          bottomFlux = - topFlux;
 5414:       }
 5415:    }  
 5416: 
 5417: 
 5418: 
 5419: 
 5420: 
 5421: 
 5422: //    __device__ void updateLevels1(void) {
