  303: // Polynomial class
  304: template<int grade>
  305: struct Polynomial {
  306:     // Static assertion to give a clear error message at compile time
  307:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  308: };
  309: 
  310: 
  311: // Explicit specialization for grade 4
  312: template<>
  313: struct Polynomial<4> {
  314:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  315: 
  316:    // Constructor from coefficients
  317:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  318: 
  319:    __device__ __forceinline__ double eval(double x) const {
  320:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  321:    }
  322: };
