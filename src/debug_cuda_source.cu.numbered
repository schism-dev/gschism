 4773:    __global__ void computeFlowBcVelocities(double time) {
 4774: 
 4775:       SIDE_BND(sideBnd);
 4776: 
 4777:       const Side *side = sideBnd->side;
 4778:  
 4779:       const bool isDry = side->isDry;
 4780:       const bool isLand = sideBnd->segment->isLand;
 4781: 
 4782:    
 4783:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4784: 
 4785:       if (isDry || isLand) return;
 4786: 
 4787:       // For wet sides in open boundaries...
 4788:       const Vector2 n = side->n;
 4789:       const BoundarySegment *segment = sideBnd->segment;
 4790: 
 4791:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4792: 
 4793:       const int ifltype = segment->ifltype;
 4794: 
 4795:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4796:       const Vector2 r_nuth0 = r_uth0*n;
 4797: 
 4798: 
 4799:       if (ifltype == 1 || ifltype == 2) {
 4800:       
 4801:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4802: 
 4803:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4804:          
 4805:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4806:          
 4807:       } else if (ifltype == -1) { // Flather 1
 4808: 
 4809:          for (int k = 0; k < nvrt; k++) {
 4810: 
 4811:             // uth is the normal vel.; no ramp up
 4812:             const double uth = sideBnd->nuth(k);
 4813:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4814: 
 4815:             sideBnd->ubc[k] += uth*n;
 4816:          }
 4817: 
 4818:       } else if (ifltype == 3 || ifltype == 5) {
 4819:          // vnth0=0 !normal vel.
 4820: 
 4821:          Vector2 r_u1_bar = {0.0, 0.0};
 4822:          // Computes the contribution to the velocity from all tide frequencies
 4823:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4824: 
 4825:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4826:             const Vector2 umo  = sideBnd->umo(jfr); 
 4827: 
 4828:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4829:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4830:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4831:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4832: 
 4833:          }
 4834: 
 4835: 
 4836:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4837: 
 4838:       } // if (ifltype = 3 || ifltype == 5
 4839: 
 4840: 
 4841: 
 4842:    }
 4843: 
 4844:    __global__ void computeElevationBoundaryConditions(double time) {
 4845:       // Compute elevation essential boundary conditions 
 4846: 
 4847:       NODE_BND(nodeBnd); // Each boundary node.
 4848: 
 4849:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4850: 
 4851:       const Node *node = nodeBnd->node;
 4852:       const BoundarySegment *segment = nodeBnd->segment;
 4853:       const int iettype = segment->iettype;
 4854:       
 4855: 
 4856:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4857:       double eic = 0.0;
 4858:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4859:       else                 eic = 0.0;
 4860: 
 4861:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4862:       const double r_eth = ramp*nodeBnd->eth;
 4863:       double r_eta1_bar = 0.0;
 4864: 
 4865: 
 4866:       // Compute tide elevation
 4867:       if (iettype == 3 || iettype == 5) {   
 4868: 
 4869:          if constexpr(iloadtide==1) { // loading tide
 4870:             assert(false && "Loading tide not implemented");
 4871:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4872:          }
 4873:          
 4874:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4875: 
 4876:             const double efa  = nodeBnd->efa[jfr]; 
 4877:             const double emo  = nodeBnd->emo[jfr]; 
 4878: 
 4879:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4880:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4881:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4882: 
 4883:          } // for jfr
 4884: 
 4885:       } // if iettype
 4886: 
 4887:       switch (iettype) {
 4888:          case 1:
 4889:          case 2:
 4890:          case 4:
 4891:             nodeBnd->elbc = r_eic + r_eth;
 4892:             break;
 4893:          case 3:
 4894:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4895:             break;
 4896:          case 5:
 4897:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4898:             break;
 4899:       } // switch
 4900: 
 4901: 
 4902:       //Add inverse barometric effects
 4903:       if (iettype != 0 && inv_atm_bnd == 1) {
 4904:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4905:       }
 4906: 
 4907:    }
 4908: 
 4909: 
 4910:    __global__ void computeHorizontalViscosity(void) { 
 4911: 
 4912:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4913: 
 4914:       SIDE(side);
 4915: 
 4916:       if (side->isDry) return;
 4917: 
 4918:       for (int k = 0; k < nvrt; k++) {
 4919:          side->nuGradU[k] = {0.0, 0.0};
 4920:       }
 4921: 
 4922:       if constexpr(ihorcon == 1) {
 4923:          for (int k = side->kb; k < nvrt - 1; k++) {
 4924:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4925:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4926:             // By Zhang and Baptista.
 4927: 
 4928:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4929:             // This is a standard discretization of the Laplacian operator.
 4930:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4931:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4932:             // Gamma is hvis_coef0 in the code.
 4933:             // The value of gamma needs to be < 0.5.
 4934: 
 4935:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4936:             // side under consideration in each of the two possible elements that share the side.
 4937:             Vector2 sumU = {0.0, 0.0};
 4938:             for (int l = 0; l < 2; l++) {
 4939:                const Element *elem = side->elems[l];
 4940: 
 4941:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4942: 
 4943:                // Find the local index of the side in the element
 4944:                const int idxSide = elem->sideLocalIdx(side);
 4945: 
 4946:                // Find the two sides that are connected to the side under consideration
 4947:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4948:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4949: 
 4950:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4951: 
 4952:             }
 4953: 
 4954:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4955: 
 4956:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4957:    
 4958:          }
 4959:       }
 4960:       else if constexpr(ihorcon == 2) {
 4961:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4962:       }
 4963: 
 4964: 
 4965:    }
 4966: 
 4967: 
 4968:    __global__ void setEssentialBC(void) {
 4969:       // Set essential boundary conditions 
 4970:       NODE(node); // Each boundary node
 4971:       NodeBoundary *nodeBnd = node->nodeBnd;
 4972:       
 4973:  
 4974:       // Check if this node has essential BC
 4975:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4976:          // Verify BC value is valid
 4977:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4978: 
 4979:        
 4980:          // Set diagonal to 1 and zero off-diagonals
 4981:          node->coeffDiag = 1.0;
 4982: 
 4983:          for (int j = 0; j < node->numNodes; j++) {
 4984:                node->coeffMatrix[j] = 0.0;
 4985:          }
 4986:          
 4987:          // Set solution and RHS to BC value
 4988:          node->mX  = nodeBnd->elbc;
 4989:          node->qel = nodeBnd->elbc;
 4990: 
 4991:       } else {
 4992:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4993: 
 4994:          for (int j = 0; j < node->numNodes; j++) {
 4995:                Node* nbNode = node->nodes[j];
 4996:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4997:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4998:                   // Verify neighbor's BC value
 4999:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5000: 
 5001:                   // Subtract contribution to RHS
 5002:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5003:                   node->coeffMatrix[j] = 0.0;  
 5004:                }
 5005:          }
 5006:       }
 5007:    }
 5008: 
 5009: 
 5010:    __global__ void updateElevation(void) {
 5011:       NODE(node);
 5012: 
 5013: 
 5014:       node->eta2 = node->mX;
 5015: 
 5016:       node->updateZCoordData();
 5017:    }
 5018: 
 5019: 
 5020:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5021: 
 5022:       SIDE(side);
 5023: 
 5024:       side->U = {0.0, 0.0}; 
 5025:          
 5026:       if(side->isDry) return;
 5027: 
 5028:       // Vertically integrated velocity U
 5029:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5030:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5031:          side->U += side->Dz(k + 1)*uc;  
 5032:       }
 5033: 
 5034:    }
 5035: 
 5036:    __global__ void computeBottomDragVegetation(void) {
 5037:       // UNFINISHED. CHECK THIS:
 5038:       // How many kernels are needed? Why so many for loops?
 5039:       // Is the loop on sides needed?
 5040: 
 5041:       NODE(node);
 5042: 
 5043: 
 5044:       const int    kb      = node->kb;
 5045:       const double htot    = node->htot2(); 
 5046:       
 5047:       if (node->isDry) {
 5048:          // Default values for dry nodes
 5049:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5050:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5051: 
 5052:          return;
 5053:        
 5054:       }
 5055: 
 5056:       // Computes bottom drag Cd based on the selected nchi
 5057:       node->computeBottomDragCd();
 5058:       
 5059: 
 5060: 
 5061:       //   Bottom stress in m^2/s^2
 5062:       if (node->rho[kb + 1] >= -98.0)
 5063:       {
 5064:          const double mag_u = length(node->u2[kb + 1]);
 5065:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5066: 
 5067:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5068:          // !sediment erosion: this part needs more documentation
 5069:       }
 5070:     
 5071: 
 5072: 
 5073:       // Compute vegetation parameters
 5074:       //--------------------------------
 5075: 
 5076:       // SAV constants
 5077:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5078:       constexpr double veg_cfpsi = 0.16;
 5079: 
 5080:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5081:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5082: 
 5083:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5084:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5085:          int kbin = 0; // bin index
 5086:          for (int k = kb; k < nvrt; k++) {
 5087:             // Computes node height above the bottom level
 5088:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5089:             assert(false && "Vertical variation of vegetation not implemented");
 5090: 
 5091:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5092:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5093:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5094:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5095:             // } else {
 5096:             //    // Find the bin at which the current vertical level is
 5097:             //    while (kbin<nbins_veg_vert) {
 5098:             //       const double zn = node->z[kbin];
 5099:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5100:             //          break;
 5101:             //       } // if
 5102:             //       kbin++;
 5103:             //    } // while
 5104:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5105: 
 5106:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5107:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5108:                
 5109:             //    // Linear interpolation of the vegetation parameters
 5110:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5111:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5112:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5113:             // } // if rl10
 5114: 
 5115:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5116: 
 5117:          } // for k
 5118: 
 5119: 
 5120:       } else { // Ganthy (iveg==2)
 5121:       //  Modify canopy height, diameter, and density
 5122: 
 5123:          // Make sure there is vegetation on this node
 5124:          if (node->veg_h_unbent > 0.0) {
 5125:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5126: 
 5127:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5128:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5129:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5130: 
 5131:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5132:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5133:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5134:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5135:          } // if veg_h_unbent
 5136: 
 5137:          for (int k = 0; k < nvrt; k++) {
 5138:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5139:          } // for k
 5140:       
 5141: 
 5142:       } // if iveg
 5143:      
 5144: 
 5145:       // Compute vertical mean of veg_alpha3D
 5146:       if (iveg != 0) {
 5147:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5148:          double sum1=0.0;
 5149:          double sum2=0.0;
 5150:          // Integrate over each level under the canopy...
 5151:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5152:             const double Dz = node->Dz(k);
 5153: 
 5154:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5155:             sum2 += Dz;
 5156: 
 5157:          } // for k
 5158:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5159:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5160: 
 5161:       } // if iveg
 5162: 
 5163:    }
 5164: 
 5165:    __global__ void computeVegetationAndDragParameters(void) {
 5166:       // Computes the vegetation and drag model parameters:
 5167:       // chi, \tilde\chi, beta, \breve{H}
 5168:       
 5169:       SIDE(side);
 5170: 
 5171:       side->hhat = 0.0;
 5172:       side->chi2 = 0.0;
 5173:       side->chi = 0.0;
 5174:       side->veg_c2 = 0.0;
 5175:       side->veg_beta = 0.0;
 5176: 
 5177:       if (side->isDry) return;
 5178: 
 5179:       const double htot = side->htot2();
 5180:       const int    kb   = side->kb;
 5181: 
 5182:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5183: 
 5184:       const double veg_h     = side->veg_h();
 5185:       const double veg_nv    = side->veg_nv();
 5186:       const double veg_c     = side->veg_c();
 5187:       const double veg_beta  = side->veg_beta;
 5188:       const double veg_alpha = side->veg_alpha_vert_mean();
 5189: 
 5190:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5191:       // Velocity magnitude at the bottom level
 5192:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5193:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5194:       side->chi2 = side->Cd()*vmag1;
 5195:       side->chi  = side->chi2;
 5196:       if constexpr(iveg != 0) {
 5197:          const Node *n1 = side->n1;
 5198:          const Node *n2 = side->n2;
 5199:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5200:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5201:       }
 5202: 
 5203:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5204: 
 5205:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5206:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5207:       double magUa = 0.0;
 5208:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5209:          // 3D wet side with veg...
 5210: 
 5211:          double magUa = 0.0;
 5212:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5213:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5214: 
 5215:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5216:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5217:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5218: 
 5219:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5220:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5221: 
 5222:                // Velocity magnitude at the bottom (l) of the level
 5223:                const double ul = length(side->u2[k]);
 5224: 
 5225:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5226:                magUa += Dz*0.5*(uh + ul);
 5227: 
 5228:             } // if HasVegetation
 5229:          } // for k
 5230:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5231: 
 5232:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5233:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5234:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5235:             const double zCpy = side->zTopCanopy();
 5236:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5237:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5238:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5239:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5240:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5241:          } // if isSubmerged
 5242:       } // if iveg   
 5243: 
 5244:       // Computes the friction modified depth, \breve{H} in notes
 5245:       if (side->is2D()) { // 2D
 5246: 
 5247:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5248:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5249: 
 5250:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5251: 
 5252:          side->hhat = htot*htot/fricH; 
 5253: 
 5254:       } else { // 3D
 5255:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5256: 
 5257:          if constexpr(iveg != 0) {
 5258:             
 5259:             if (side->isSubmerged()) { 
 5260:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5261:                side->hhat -= veg_c*Hhat_alpha;
 5262: 
 5263:             } else { // Emergent
 5264:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5265:             }
 5266:          } // if iveg
 5267: 
 5268:          // Enforce positivity for 3D model
 5269:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5270:       } // if 3D
 5271: 
 5272:    }
 5273: 
 5274: 
 5275: 
 5276:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5277:    // Computes the density gradient between two elements, e1 and e2.
 5278:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5279:    // zero in the direction normal to the side. 
 5280:    // 
 5281:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5282:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5283:    //
 5284:    // Input:
 5285:    //    e1: Element
 5286:    //    e2: Neighbor element (or nullptr if boundary)
 5287:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5288:    //    k: Index of the half-level at which the density is interpolated
 5289:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5290:    // 
 5291:    // Output:
 5292:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5293:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5294: 
 5295:       if (e2 == nullptr || e2->isDry) {
 5296:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5297: 
 5298:          Side *side = e1->sides[j];
 5299:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5300:                  
 5301:          if constexpr(ics == 1) {
 5302:             vec = side->n; // Normal vector to the side
 5303:          } else {
 5304:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5305:             // IMPLEMENT THIS XXXXXX
 5306:             // !replace with xel, yel?
 5307:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5308:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5309:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5310:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5311:          } //ics
 5312:                    
 5313:          diffRho = 0.0;
 5314: 
 5315:       } else { //internal and wet
 5316:          if constexpr(ics==1) {
 5317:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5318: 
 5319:             // Vector from e1 to e2
 5320:             vec = e2->center - e1->center;
 5321: 
 5322:          } else { 
 5323:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5324:             // IMPLEMENT THIS XXXXXX
 5325:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5326:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5327:             //                   alow(j)=xctr2
 5328:             //                   bdia(j)=yctr2
 5329:          } // ics
 5330: 
 5331:          diffRho = rho2 - e1->demeanedDensity(k);
 5332:       }
 5333: 
 5334:    }
 5335: 
 5336:    __global__ void computeDensityCubicSplines(void) {
 5337:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5338: 
 5339:       ELEM(elem);
 5340: 
 5341:       if (elem->isDry) return;
 5342: 
 5343:       const int kb = elem->kb;
 5344: 
 5345:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5346:       if (elem->is2D()) {
 5347:          // In the 2D case, the density is constant at the prism level. 
 5348:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5349:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5350:       } else { //3D
 5351: 
 5352:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5353:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5354:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5355:          ///// XXXX CHECK INDICES!!!!!
 5356:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5357:       } // 2D/3D
 5358: 
 5359:    }
 5360: } // extern "C"
 5361: 
 5362: 
 5363: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5364: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5365: 
 5366:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5367: 
 5368:    const int kb  = elem->kb;
 5369:    const int kb2 = elem2->kb;
 5370: 
 5371:    // z-coordinate of prism of elem
 5372:    const double zp = elem->z_prism(k);
 5373: 
 5374:    double rho = 0.0;
 5375: 
 5376:    if (elem2->is2D()) {
 5377:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5378: 
 5379:    } else {  // 3D
 5380: 
 5381:       // eta_min may be < zmax
 5382:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5383:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5384: 
 5385:       // (Extrapolate density below bottom, we will fix it later)
 5386:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5387:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5388:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5389:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5390:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5391:    } // 2D/3D
 5392:      
 5393: 
 5394:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5395:    // Now we need to fix it.
 5396:    if (elem->z[k] < elem2->z[kb2]) {
 5397:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5398: 
 5399:       // There are two methods to adjust the density at the bottom of the element.
 5400:       // iunder_deep=0: 
 5401:       const double depth1 = abs(elem->z[kb]); // larger depth
 5402: 
 5403:       if (iunder_deep==0) {
 5404: 
 5405:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5406: 
 5407:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5408: 
 5409:       } else { // iunder_deep != 0
 5410: 
 5411:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5412: 
 5413:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5414: 
 5415:          //   Demeaned density at the same z coordinate as
 5416:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5417:          }
 5418: 
 5419:       } // if iunder_deep
 5420:    } // if elem->z[kb] < elem2->z[kb]
 5421: 
 5422:    return rho;
 5423: }
 5424: 
 5425: 
 5426: extern "C" {
 5427:    __global__ void computeDensityGradient(void) {
 5428: 
 5429:       if constexpr(ibc != 0) return;
 5430: 
 5431:          // Compute the horizontal density gradient at each element.
 5432:       // It works in two steps:
 5433:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5434:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5435:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5436:       //             gradRho.r1 = rho1 - rho0
 5437:       //             gradRho.r2 = rho2 - rho0
 5438:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5439:       // 
 5440:       //  NOTE: We use de-meaned densities.
 5441: 
 5442:       ELEM(elem);
 5443: 
 5444:       if (elem->isDry) return;
 5445: 
 5446:       const int kb  = elem->kb;
 5447:       const int i34 = elem->i34;
 5448: 
 5449:       for (int k = kb + 1; k < nvrt; k++) {
 5450:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5451:          //             gradRho.r1 = rho1 - rho0
 5452:          //             gradRho.r2 = rho2 - rho0
 5453:          int icount = 0;
 5454:          double sumRx = 0.0;
 5455:          double sumRy = 0.0;
 5456:          for (int j1=0; j1<i34; j1++) { 
 5457: 
 5458:             const int j2 = elem->nxq(j1 + 1);
 5459: 
 5460:             // Pairs of consecutive neighbor elements of elem
 5461:             const Element *e1 = elem->nghbElems[j1];
 5462:             const Element *e2 = elem->nghbElems[j2];
 5463: 
 5464:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5465:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5466:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5467: 
 5468:             // Compute the density difference and the vector from elem to e1 and e2
 5469:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5470:             double diffRho1, diffRho2;
 5471:             Vector2 vec1, vec2;
 5472:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5473:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5474: 
 5475:             const double rl1 = length(vec1);
 5476:             const double rl2 = length(vec2);
 5477:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5478: 
 5479:             const double delta = cross(vec1, vec2);
 5480:             const double sintheta = abs(delta)/(rl1*rl2);
 5481: 
 5482:             // To avoid problems, avoid elements with small angle between vectors
 5483:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5484:             const bool validEq = (sintheta > sin_one_deg);
 5485: 
 5486:             if (validEq) {
 5487:                // Solve the system of equations to get the density gradient at elem
 5488:                icount++;
 5489:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5490:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5491:                sumRx += Rx;
 5492:                sumRy += Ry;
 5493:             }
 5494:          } // for j1
 5495: 
 5496:          // Compute the average density gradient at elem
 5497:          if (icount==0) {
 5498:            // Bad mesh quality; bail out with 0 b-cc
 5499:            elem->gradRho[k] = {0.0, 0.0};
 5500:          } else {
 5501:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5502:          }
 5503: 
 5504:       } // for k
 5505: 
 5506:    }
 5507: 
 5508:    __global__ void computeBaroclinicTerm(void) {
 5509:    // Computes the baroclinic term at sides (at half levels).
 5510:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5511:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5512: 
 5513:       if (ibc == 1) return;
 5514: 
 5515:       SIDE(side);
 5516: 
 5517:       if (side->isDry) return;
 5518: 
 5519:       const Element *e1 = side->elems[0];
 5520:       const Element *e2 = side->elems[1]; 
 5521:       const int kb = side->kb;
 5522:       
 5523:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5524: 
 5525:       // interpolates vertically the density gradient of the two elements at the half level/
 5526: 
 5527:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 5528:       int k2 = max(kb, nvrt / 2);
 5529: 
 5530:       // Starts the integration at the surface and goes down to the bottom
 5531:       side->bcc[nvrt-1] = {0.0, 0.0};
 5532:       for (int k = nvrt - 2; k >= kb; k--) {
 5533:       // For each prism level (from surface to bottom)...
 5534: 
 5535:          // For both elements, interpolate density gradient at the side's half level.
 5536:          // The gradient at the side is the average of the gradients at the elements.
 5537:          // w1, w2 are used to take into account boundary sides, with just one element.
 5538:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5539:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5540:          const double wsum = w1 + w2;
 5541:          w1 = w1/wsum;
 5542:          w2 = w2/wsum;
 5543:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5544: 
 5545:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5546:          Vector2 gradRho = {0.0, 0.0};
 5547:          if (e1 != nullptr && k > kb) {
 5548:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5549:             
 5550:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5551:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5552:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5553: 
 5554:             // Grad(rho) vertically interpolated at the side's half level
 5555:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 5556: 
 5557:             // Projects the element density gradient to the side frame if needed.
 5558:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 5559: 
 5560:             // Adds the contribution of the density gradient at the side's half level
 5561:             gradRho += gradRho1*w1;
 5562:          }      
 5563:          if (e2 != nullptr && k > kb) {
 5564:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5565:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5566:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5567:             
 5568:             // Grad(rho) vertically interpolated at the side's half level
 5569:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 5570: 
 5571:             // Projects the element density gradient to the side frame if needed.
 5572:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 5573: 
 5574:             // Adds the contribution of the density gradient at the side's half level
 5575:             gradRho += gradRho2*w2;
 5576:          }
 5577: 
 5578:          
 5579:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5580:          // multiplied by -rampbc*(g/rho0) 
 5581:          const double grav3 = side->grav3();
 5582:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 5583: 
 5584:       } // for
 5585: 
 5586:    }
 5587: 
 5588: 
 5589: 
 5590:    __global__ void computeHorGradientAtSide(void) {
 5591: 
 5592:       // Compute the horizontal density gradient at each element.
 5593:       // It works in two steps:
 5594:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5595:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5596:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5597:       //             gradRho.r1 = rho1 - rho0
 5598:       //             gradRho.r2 = rho2 - rho0
 5599:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5600:       // 
 5601:       //  NOTE: We use de-meaned densities.
 5602: 
 5603:       SIDE(side);
 5604: 
 5605: 
 5606:       if (side->isDry) return;
 5607: 
 5608:       // Computes the gradient of the variables at the side center.
 5609:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5610:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5611:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5612: 
 5613:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5614:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5615:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5616:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5617: 
 5618:    }
 5619: 
 5620: 
 5621:    __global__ void solveMomentumEquations(double time) {
 5622: 
 5623:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5624:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5625: 
 5626:       SIDE(side);
 5627: 
 5628:       if (side->isDry) 
 5629:       {
 5630:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5631: 
 5632:          return;
 5633:       }
 5634: 
 5635:       const Node *n1 = side->n1;
 5636:       const Node *n2 = side->n2;
 5637: 
 5638:       const int kb = side->kb;
 5639: 
 5640:       const double veg_h = side->veg_h();
 5641:       const double grav3 = side->grav3();
 5642: 
 5643:       if (side->is2D()) {
 5644:          // Remember: Do not use htot2, which is updated.
 5645:          const double htot = side->htot1();
 5646:          const double hhat = side->hhat;
 5647: 
 5648:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5649: 
 5650:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5651:          const Vector2 tau2 = side->tau();
 5652: 
 5653:          // hat_gam has units of m/s
 5654: 
 5655:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5656:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5657:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5658: 
 5659:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5660: 
 5661: 
 5662:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5663: 
 5664:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5665: 
 5666:       }
 5667:       else { // 3D
 5668: 
 5669:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5670:          // 
 5671:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5672:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5673:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5674:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5675:          // k+1 and k.
 5676: 
 5677: 
 5678:          const int ndim = nvrt - kb;
 5679:          const double zTopCanopy = side->zTopCanopy();
 5680: 
 5681:          // Initialize the tridiagonal system
 5682:          for (int k = kb + 1; k < nvrt; k++) {
 5683:             
 5684:             const int kin = k - (kb + 1);
 5685: 
 5686:             // Vertical viscosity at the face center
 5687:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5688: 
 5689:  
 5690:             alow[kin] = 0.0;
 5691:             cupp[kin] = 0.0;
 5692:             bdia[kin] = 0.0;
 5693: 
 5694:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5695:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5696: 
 5697:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5698:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5699:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5700: 
 5701:             // First part: layers k, k+1
 5702:             if (k < nvrt - 1) {
 5703:                              
 5704:                if constexpr(iveg != 0) {
 5705: 
 5706:                   // If there is vegetation at this level...
 5707:                   if (zTopCanopy > side->zc[k]) {
 5708:                      // If the canopy is above the k layer...
 5709:                      
 5710:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5711:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5712:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5713:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5714: 
 5715:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5716:                      const double vmag2 = length(ut2);
 5717:                      const double vmag1 = length(side->u2[k]);
 5718:                      const double vmag = 0.5*(vmag1 + vmag2);
 5719:                      
 5720:                      // Computes the vegetation alpha at the face center
 5721:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5722: 
 5723:                      cff1 += veg_alpha_sd*dt*vmag;
 5724: 
 5725:                   } // if (zTopCanopy
 5726:                } // if iveg
 5727: 
 5728:                const double dzz = side->Dz(k + 1);
 5729:                const double tmp = dt*dfz/dzz;
 5730:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5731: 
 5732:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5733:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5734:             }
 5735: 
 5736: 
 5737:             // Second part: layers k-1, k
 5738:             if (k > kb + 1) {
 5739: 
 5740:                double cff1 = 1.0; //init \bar{c^k}
 5741: 
 5742:                if constexpr(iveg != 0) {
 5743:                   // If there is vegetation at this level...
 5744:                   if (zTopCanopy > side->zc[k-1]) {
 5745:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5746:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5747: 
 5748:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5749: 
 5750:                      const double vmag2 = length(ut2);
 5751:                      const double vmag1 = length(side->u2[k-1]);
 5752:                      const double vmag = 0.5*(vmag1 + vmag2);
 5753: 
 5754:                      // Computes the vegetation alpha at the face center
 5755:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5756:                      cff1 += veg_alpha_sd*dt*vmag;
 5757:                   } // if zTopCanopy
 5758: 
 5759:                } // if iveg
 5760: 
 5761:                const double dzz = side->Dz(k);
 5762:                const double tmp = dt*dfz/dzz;
 5763:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5764: 
 5765:                alow[kin] += cff1*dzz/6.0 - tmp;
 5766:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5767: 
 5768:             } else { // Bottom boundary
 5769:                // This occurs at the bottom, where the bottom drag is applied.
 5770: 
 5771:                bdia[kin] += dt*side->chi2; // XXXX
 5772: 
 5773:             } // if (k > kb + 1)
 5774: 
 5775: 
 5776:          } // for (int k
 5777: 
 5778: 
 5779: 
 5780:          // Computes the RHS.
 5781:          // -----------------
 5782: 
 5783:          //	BC to be imposed at the end.
 5784: 
 5785:          const Vector2 gradETP  = side->gradETP;
 5786:          const Vector2 gradPr   = side->gradPr;
 5787:          const Vector2 gradEta1 = side->gradEta1;
 5788:          const Vector2 gradEta2 = side->gradEta2;
 5789: 
 5790:          const Vector2 *btu = side->btu;
 5791:          const Vector2 *u2  = side->u2;
 5792:          const double coriolis = side->coriolis;
 5793:          const Vector2 *nuGradU = side->nuGradU;
 5794: 
 5795: 
 5796:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5797:          for (int k = kb + 1; k < nvrt; k++) {
 5798:             const int kin = k - kb - 1;
 5799: 
 5800:             const double dz_0 = side->Dz(k);
 5801:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5802: 
 5803:             rrhs[kin] = {0.0, 0.0};
 5804:             double dz = 0.0;
 5805: 
 5806:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5807:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5808:             if (k < nvrt  ) dz += dz_1;
 5809:             if (k > kb + 1) dz += dz_0;
 5810: 
 5811:             // Elevation gradient, atmospheric pressure and tidal potential
 5812:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5813: 
 5814:             // Coriolis, advection, wind stress, and horizontal viscosity
 5815:             if (k < nvrt - 1) {
 5816: 
 5817: 
 5818:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5819:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5820:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5821:                                                 
 5822: 
 5823:                //diff stress tensors 1006
 5824:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5825:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5826:                   assert(false && "Not implemented: itur == 5");
 5827:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5828:                }
 5829:                // else assert(false && "itur # Not implemented");
 5830: 
 5831:             } else { // k == nvrt - 1 SURFACE
 5832:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5833:                const Vector2 tau2 = side->tau();
 5834: 
 5835:                rrhs[kin] += dt*tau2;          
 5836: 
 5837:             } // if k<nvrt
 5838: 
 5839: 
 5840:             if (k > kb + 1) {
 5841:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5842:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5843:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5844: 
 5845:                // diff stress tensors 1006
 5846:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5847:                   assert(false && "Not implemented: itur == 5");
 5848:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5849:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5850:                }
 5851:                // else assert(false && "itur # Not implemented");
 5852: 
 5853: 
 5854:             } // if k>kbs + 1
 5855: 
 5856:             // Baroclinic
 5857:             Vector2 *bcc = side->bcc;
 5858:             if constexpr(ibc == 0) {
 5859:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5860:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5861: 
 5862:             } // if ibc==0
 5863: 
 5864:          } // k=kb + 1,nvrt
 5865: 
 5866: 
 5867:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5868: 
 5869:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5870:             const int kin = k - kb - 1;
 5871:    
 5872:             // Velocity is always clamped to maximum values
 5873:             side->u2[k] = clampVelocity(soln[kin]);
 5874:          } // k
 5875: 
 5876:       } // if side->is2D()
 5877:       
 5878: 
 5879:       // Impose velocity boundary condition at the bottom
 5880:       if constexpr(imm == 2) { // 3D bed deformation model
 5881:          double dep;
 5882:          Vector2 vel;
 5883: 
 5884:          assert(false && "Not implemented: imm == 2");
 5885:          //update_bdef(time, x0, y0, dep, vel);
 5886:          // side->u2[kb] = vel;
 5887: 
 5888:       } else { // imm = 0 or 1
 5889:          if (side->Cd() == 0.0) {
 5890:             side->u2[kb] = side->u2[kb + 1];
 5891: 
 5892:          } else if (side->is3D()) { // 3D no slip bottom   
 5893:             side->u2[kb] = {0.0, 0.0};
 5894: 
 5895:          }
 5896:           
 5897:       } // if imm
 5898: 
 5899:       // The velocities below the bottom level are set to zero
 5900:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5901: 
 5902: 
 5903:    }
 5904: 
 5905: 
 5906:    __global__ void applyMomentumBC(void) {
 5907: 
 5908:       SIDE_BND(sideBnd);
 5909: 
 5910:       Side *side = sideBnd->side;
 5911:       const BoundarySegment *segment = sideBnd->segment;
 5912:       const Node *n1 = side->n1;
 5913:       const Node *n2 = side->n2;
 5914: 
 5915:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5916: 
 5917:       const bool isLand = segment->isLand;
 5918:       const int ifltype = segment->ifltype;
 5919: 
 5920:       const int kb = side->kb;
 5921: 
 5922: 
 5923:       if (!isLand && ifltype != 0) {
 5924:          const Vector2 *ubc = sideBnd->ubc;
 5925:   
 5926:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5927:             
 5928:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5929:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5930: 
 5931:             if (ifltype == -1) {
 5932:                // Flather 1
 5933: 
 5934:                const double depth = side->depth();
 5935: 
 5936:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5937: 
 5938:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5939: 
 5940:                side->u2[k] = vnorm*side->n;
 5941: 
 5942:             } else if (ifltype == -2) { // Discharge
 5943: 
 5944:                const double eta1 = side->eta1();
 5945:                const double eta2 = side->eta2();
 5946:                const double htot = side->htot2();
 5947: 
 5948:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5949:                assert(false && "Not implemented: Discharge bc");
 5950:                // const double dischrg = discharge(eta1);
 5951:                const double dischrg = 0.0; // XXX REMOVE
 5952:                
 5953: 
 5954:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5955: 
 5956:                const double vnorm = dischrg*eta2/htot;
 5957: 
 5958:                side->u2[k] = vnorm*side->n;
 5959: 
 5960:             }
 5961:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5962:                const double vnorm = dot(side->u2[k], side->n);
 5963: 
 5964:                double rat;
 5965:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5966:                else              rat = segment->vobc2; // outgoing
 5967: 
 5968:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5969: 
 5970:             }
 5971:             else { // not Flather or 3D radiation
 5972:                side->u2[k] = ubc[k];
 5973: 
 5974:             } // if (segment->ifltype...
 5975: 
 5976:          }
 5977: 
 5978:       }
 5979:       else if (isLand) { // if it is land boundary side
 5980: 
 5981:          if constexpr(islip == 0) { // free slip
 5982: 
 5983:             for (int k = kb; k < nvrt; k++) {
 5984: 
 5985:                const Vector2 t = side->t();
 5986:                const Vector2 n = side->n;
 5987: 
 5988:                double vnorm = 0.0; // for most cases
 5989:                const double vtan = dot(side->u2[k], t);
 5990:                
 5991:                side->u2[k] = vtan*t - vnorm*n;
 5992: 
 5993:             }
 5994: 
 5995:          } else { // no slip
 5996:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5997: 
 5998:          }
 5999:       } // if (side segment type...
 6000: 
 6001:    
 6002: 
 6003:    }
 6004: 
 6005: 
 6006:    __global__ void shapiroFilter1(void) {
 6007:       // First step of the Shapiro filter (normally used if indvel<=0)
 6008:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6009: 
 6010:       SIDE(side);
 6011: 
 6012:       // Only internal wet sides are processed
 6013:       if (side->isDry || !(side->isInternal())) return;
 6014: 
 6015:       const int kb = side->kb;
 6016: 
 6017:       for (int mm = 0; mm < niter_shap; mm++) {
 6018: 
 6019:          for (int k = kb + 1; k < nvrt; k++) {
 6020:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6021:             Vector2 suru = {0.0, 0.0};
 6022: 
 6023:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6024: 
 6025:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6026: 
 6027:                int kin = k;
 6028:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6029:                
 6030:                // Get the velocity at the neighbor's side.
 6031:                Vector2 nSideU2 = nSide->u2[kin];
 6032: 
 6033:                // Projects the velocity to the current side frame if needed.
 6034:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6035: 
 6036:                suru += nSideU2;
 6037:             }
 6038: 
 6039:             // Reusing bcc as a temporary array to store the suru values.
 6040:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6041: 
 6042:          }
 6043:       }
 6044:    }
 6045: 
 6046:    __global__ void shapiroFilter2(void) {
 6047:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6048: 
 6049:       SIDE(side);
 6050: 
 6051: 
 6052:       if (side->isDry || !(side->isInternal())) return;
 6053: 
 6054:       const int kb = side->kb;
 6055: 
 6056:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6057: 
 6058:       if (side->is2D()) {
 6059:          side->u2[kb + 1] = side->bcc[kb + 1];
 6060:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6061: 
 6062:       } else {
 6063:          // 3D
 6064:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6065:          
 6066:       }
 6067: 
 6068:    }
 6069: 
 6070: 
 6071:    __global__ void ul0UpdateZCoords(void) {
 6072:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6073:       
 6074:       NODE(node);      
 6075: 
 6076: 
 6077:       if (false) { //node->isDry) { XXXXXXX
 6078: 
 6079:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6080: 
 6081:          if constexpr(ivcor != 1) node->kb = 0;
 6082: 
 6083:       } else {
 6084: 
 6085:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6086:          node->updateKb();
 6087: 
 6088:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6089: 
 6090:       }
 6091: 
 6092:       // We use the temp.b field to store the previous state of isDry.
 6093:       node->tmp.b = node->isDry;
 6094: 
 6095:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6096:       node->isDry = true;
 6097: 
 6098:    }
 6099: 
 6100:    __global__ void ul0ComputeDryElements(void)
 6101:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6102:    {
 6103:       ELEM(elem);
 6104: 
 6105:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6106: 
 6107:       elem->kb = 0;
 6108: 
 6109:       if (elem->isDry) return;
 6110: 
 6111: 
 6112:    //    if(elem->isDry2()) { // XXXX
 6113:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6114:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6115:    //        call parallel_abort(errmsg)
 6116:    //    }
 6117: 
 6118:       const Node *n1 = elem->nodes[0];
 6119:       const Node *n2 = elem->nodes[1];
 6120:       const Node *n3 = elem->nodes[2];  
 6121:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6122: 
 6123:       // Computes element's kb as the minimum of the nodes' kb.
 6124:       const int kb1 = n1->kb;
 6125:       const int kb2 = n2->kb;
 6126:       const int kb3 = n3->kb;
 6127:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6128: 
 6129: 
 6130:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6131: 
 6132: 
 6133:       // Computes the element z as the mean of the nodes z.
 6134:       for (int k = elem->kb; k < nvrt; k++) {
 6135: 
 6136:          // Compute the element z as the mean of the nodes z.
 6137:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6138:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6139:          elem->z[k] /= elem->i34;
 6140: 
 6141: if (k>elem->kb && elem->z[k] <= elem->z[k-1]) printf("EEEE elem->isDry = %d, idx1 = %d, idx2 = %d, idx3 = %d, z1[k] = %f, z2[k] = %f, z3[k] = %f, z1[k-1] = %f, z2[k-1] = %f, z3[k-1] = %f, k = %d, kb = %d, kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d, z[k] = %f, z[k-1] = %f\n", elem->isDry, n1->idx, n2->idx, n3->idx, n1->z[max(k, kb1)], n2->z[max(k, kb2)], n3->z[max(k, kb3)], n1->z[max(k-1, kb1)], n2->z[max(k-1, kb2)], n3->z[max(k-1, kb3)],  k, elem->kb, kb1, kb2, kb3, kb4, elem->z[k], elem->z[k-1]);
 6142:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6143:       }
 6144:                   
 6145:    }
 6146: 
 6147:    __global__ void ul0ComputeDryNodes(void)
 6148:    // Updates node's isDry based on the elements' isDry. 
 6149:    {
 6150:       NODE(node);
 6151: 
 6152:       node->isDry = true;
 6153: 
 6154:       // A node is wet if at least one of the elements sharing it is wet.
 6155:       for (int j = 0; j < node->numElements; j++) {
 6156:          const Element *elem = node->elements[j];
 6157:          if (!elem->isDry) {
 6158:             node->isDry = false;
 6159:             break;
 6160:          }
 6161:       }
 6162: 
 6163:        
 6164:    }
 6165: 
 6166: 
 6167:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6168:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6169:    // node->tmp.b is true if the node was previously dry.
 6170:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6171:    {
 6172:       NODE(node);
 6173:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6174: 
 6175:       // Avoid this the first time step.
 6176:       if (it == iths) return;  
 6177: 
 6178:       const bool wasDry = node->tmp.b;
 6179: 
 6180: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6181: 
 6182:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6183: 
 6184:          for (int k=0; k < nvrt; k++) {
 6185: 
 6186:             Vector3 utmp={0.0, 0.0, 0.0};
 6187: 
 6188:             double ttmp=0.0;
 6189:             double stmp=0.0;
 6190:             int icount=0;
 6191:             for (int j = 0; j < node->numNodes; j++) {
 6192: 
 6193:                const Node *nbrNode = node->nodes[j];
 6194:                
 6195:                const bool wasNbrDry = nbrNode->tmp.b;
 6196: 
 6197:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6198:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6199: 
 6200:                   icount++;
 6201: 
 6202:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6203:                   utmp += nbrNode->uvw2(k);
 6204:                   
 6205:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6206:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6207:                }
 6208:             }
 6209: 
 6210:             if (icount > 0) {
 6211:                const double inv_icount = 1.0/icount;
 6212:                utmp = inv_icount*utmp;
 6213:                node->u2[k]     = toVector2(utmp);
 6214:                node->w2[k]     = utmp.z;
 6215:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6216:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6217:             } else {
 6218:                node->u2[k] = {0.0, 0.0};
 6219:                node->w2[k] = 0.0;
 6220:                // Initialize tracers to 0.0??? XXXXX
 6221:             }
 6222:          }
 6223:       }
 6224:    }
 6225: 
 6226:   
 6227:    
 6228: 
 6229: 
 6230:    __global__ void ul0UpdateSides(int it, int iths) {
 6231:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6232:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6233:    // The dryness of the sides is updated in ul0UpdateSides2.
 6234: 
 6235:       SIDE(side);
 6236: 
 6237:       // A side is wet if and only if at least one of its elements is wet.
 6238:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6239:  
 6240:       const Node *n1 = side->n1;
 6241:       const Node *n2 = side->n2;
 6242:      
 6243:       const int kb1 = n1->kb;
 6244:       const int kb2 = n2->kb;
 6245: 
 6246:       side->kb = 0; // default when dry
 6247: 
 6248:       if (isWet) {
 6249: 
 6250:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6251: 
 6252:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6253: 
 6254:          side->kb = min(kb1, kb2);
 6255: 
 6256:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6257: 
 6258:          for (int k = side->kb; k < nvrt; k++) {
 6259:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6260: 
 6261:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6262: 
 6263:             // Compute velocity for re-wetted sides 
 6264:             if ((it != iths) && (side->isDry && isWet)) {
 6265: 
 6266:                Vector2 utmp={0.0, 0.0};
 6267: 
 6268:                int icount=0;
 6269: 
 6270:                // For all the sides on the two elements that share this side
 6271:                for (int j = 0; j < 2; j++) {
 6272:                   const Element *elem = side->elems[j];
 6273:                   if (elem == nullptr) continue;
 6274: 
 6275:                   for (int jj=0; jj < elem->i34; jj++) {
 6276:                      const Side *nSide = elem->sides[jj];
 6277:                      if (nSide->isDry) continue;
 6278: 
 6279:                      icount++;
 6280:                      utmp += nSide->u2[k];  
 6281:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6282:                   }
 6283:                }
 6284:                   
 6285:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6286:                if (icount > 0)  side->u2[k] = utmp/icount;
 6287:                else             side->u2[k] = {0.0, 0.0};
 6288:                   
 6289:             } // if ((it != iths) && (side->isDry && isWet))
 6290: 
 6291:          } // for k
 6292: 
 6293:       } // if isWet 
 6294:       
 6295: 
 6296: 
 6297:    }
 6298: 
 6299:    __global__ void ul0UpdateSides2(void) {
 6300:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6301:    
 6302:          SIDE(side);
 6303:    
 6304:          const Element *e1 = side->elems[0];
 6305:          const Element *e2 = side->elems[1];
 6306: 
 6307:          // A side is wet if and only if at least one of its elements is wet.
 6308:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6309: 
 6310:          // Update the side's dryness
 6311:          side->isDry = !isWet;
 6312: 
 6313:    }
 6314: 
 6315: 
 6316:    __global__ void zeroNodalVelocities(void) {
 6317:       NODE(node);
 6318: 
 6319:       for (int k = 0; k < nvrt; k++) {
 6320:          node->u2[k]   = {0.0, 0.0};
 6321:          node->w2[k]   = 0.0;
 6322:          node->utmp[k] = {0.0, 0.0};
 6323:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6324:       }
 6325:    }
 6326:  
 6327: 
 6328:    __global__ void computeNodalVerticalVelocities1(void) {
 6329:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6330:    // Adds the element's vertical velocity times the element's area.
 6331:       ELEM(elem);
 6332: 
 6333:       for (int j = 0; j < elem->i34; j++) {
 6334:          Node *node = elem->nodes[j];
 6335: 
 6336:          for (int k = node->kb; k < nvrt; k++) {
 6337:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6338:          }
 6339:          atomicAdd(&(node->tmp.d), elem->area);
 6340:       }
 6341:    }
 6342: 
 6343:    __global__ void computeNodalVerticalVelocities2(void) {
 6344:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6345:    // Divides by the total area of the elements sharing the    node.
 6346:       NODE(node);
 6347: 
 6348:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6349: 
 6350:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6351:    }
 6352: 
 6353: 
 6354:    __global__ void computeNodalHorizontalVelocities1(void) {
 6355: 
 6356:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6357: 
 6358:       ELEM(elem);
 6359: 
 6360:       if (elem->isDry) return;
 6361: 
 6362:       const int kb = elem->kb;
 6363:       const bool isTri = elem->isTri();
 6364: 
 6365:       if constexpr(indvel <= 0) {
 6366:          // Assuming discontinous hvel.
 6367: 
 6368:          if (isTri) { // For triangles
 6369:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6370:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6371: 
 6372:             for (int j = 0; j < 3; j++) {
 6373:                // For every node of the triangle...
 6374:                Node *node = elem->nodes[j];
 6375: 
 6376:                if (node->isDry) continue;
 6377: 
 6378:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6379:                const Side *s2 = elem->sides[(j + 1) % 3];
 6380:                const Side *s3 = elem->sides[(j + 2) % 3];
 6381: 
 6382:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6383: 
 6384:                atomicAdd(&(node->tmp.i), 1);
 6385: 
 6386:                for (int k = kb; k < nvrt; k++)  {
 6387:                   Vector2 s1u2 = s1->u2[k];
 6388:                   Vector2 s2u2 = s2->u2[k];
 6389:                   Vector2 s3u2 = s3->u2[k];
 6390: 
 6391:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6392:                   if constexpr(ics == 2) {
 6393:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6394:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6395:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6396:                   }
 6397: 
 6398:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 6399:                   u = clampVelocity(u);
 6400:                   atomicAdd(&(node->utmp[k].x), u.x);
 6401:                   atomicAdd(&(node->utmp[k].y), u.y);
 6402: 
 6403:                }
 6404: 
 6405:             }
 6406:          }
 6407:          else { // For quads
 6408:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6409: 
 6410:          }
 6411: 
 6412:       }
 6413:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6414:       
 6415:    }
 6416: 
 6417: 
 6418:    __global__ void computeNodalHorizontalVelocities2(void) {
 6419:       NODE(node);
 6420: 
 6421:       const int nodeCount = node->tmp.i;
 6422: 
 6423:       if (nodeCount == 0) 
 6424:       {
 6425:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6426:          return;
 6427:       }
 6428: 
 6429:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6430:       
 6431:       const int kb = node->kb;
 6432: 
 6433:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6434:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6435:       
 6436:       
 6437:    }   
 6438: 
 6439:  
 6440: 
 6441:    __global__ void resetVelocityOpenBndNodes(void) {
 6442:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6443: 
 6444:       NODE_BND(nodebnd);
 6445: 
 6446:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6447:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6448:       }
 6449: 
 6450:    }
 6451: 
 6452: 
 6453:    __global__ void setVelocityOpenBndNodes(void) {
 6454:    // For open boundary nodes sets their velocity to the imposed values.
 6455: 
 6456:       SIDE_BND(sidebnd);
 6457: 
 6458:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6459:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6460:          // to its segment to the average of the side velocity.
 6461: 
 6462:          for (int k = 0; k < nvrt; k++) {
 6463:             Node *n1 = sidebnd->side->n1;
 6464:             Node *n2 = sidebnd->side->n2;
 6465: 
 6466: 
 6467:             Vector2 n1_u2(n1->u2[k]);
 6468:             Vector2 n2_u2(n2->u2[k]);
 6469: 
 6470:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6471:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6472:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6473:             }
 6474:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6475:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6476:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6477:             }
 6478: 
 6479:          }
 6480: 
 6481:       }
 6482: 
 6483:    }
 6484: 
 6485: 
 6486:    __global__ void computeVerticalVelocity(void) {
 6487:       // Computes the vertical velocity at the (2D) element's centroid.
 6488:       // In this function we will be considering volumetric elements, with side faces and a 
 6489:       // bottom and a top face. We will call them SFs, BF and TF.
 6490:       // It computes the flux coming from BF and the SFs.
 6491:       // If the bed is moving, it takes that into account.
 6492:       // Since water is incompressible, the integral of the velocity times the normal vector
 6493:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6494:       // and the BF is equal to the flux going out from the TF.
 6495:       // TF = - BF - sum(SFs).
 6496:       // It then computes the horizontal velocity at the center of TF.
 6497:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6498:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6499:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6500: 
 6501:       ELEM(elem);
 6502: 
 6503:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6504: 
 6505:       if (elem->isDry) return;
 6506: 
 6507:       const int kb = elem->kb;
 6508:       const bool isTri = elem->isTri();
 6509: 
 6510:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6511: 
 6512:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6513:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6514:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6515: 
 6516:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6517: 
 6518:       double area3D;
 6519: 
 6520:       // Bottom face flux
 6521:       double bottomFlux = 0.0;
 6522:       Vector2 u2meanBottom = {0.0, 0.0};
 6523:       const Vector2 gradh = elem->grad2(&Node::depth);
 6524:       if constexpr(imm==2) {
 6525:          Vector3 ubed;
 6526: 
 6527:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6528:          // updateBDEF(ubed);
 6529:      
 6530:          // const double bflux0 = dot(ubed, elem_n1);
 6531: 
 6532:          // elem->w[kb] += ubed.z;
 6533:       }
 6534:       else {
 6535:          u2meanBottom = elem->mean(kb, &Side::u2);
 6536:          if constexpr(ics == 2) {
 6537:             // Project the velocity from the side frame to the element frame
 6538:             u2meanBottom = elem->frame.projHorVec(u2meanBottom, elem->frame);
 6539:          }
 6540: 
 6541:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6542:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6543: 
 6544:          bottomFlux = - dot(gradh, u2meanBottom);
 6545:       } // if imm
 6546: 
 6547:       // Compute w for kb+1 to nvrt-1
 6548:       for (int l = kb; l < nvrt - 1; l++) {
 6549: 
 6550:          // normal vector to the top face of the "volumetric" element (3D)
 6551:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6552: 
 6553:          // Compute the total flux at the sides
 6554:          double sideFlux = 0.0;
 6555: 
 6556:          for (int j = 0; j < elem->i34; j++) {
 6557:             const Side *side = elem->sides[j];
 6558: 
 6559:             const double sideArea = side->area(l);
 6560:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6561:             const double sign = elem->ssign[j]; 
 6562: 
 6563:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6564:          }
 6565:          
 6566:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6567:          //velocities at the centers of the sides
 6568:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6569: 
 6570:          // The flx at the top ace can be computed from the other flows.
 6571:          const double topFlux = - sideFlux - bottomFlux;
 6572:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6573: 
 6574:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6575: 
 6576:          elem_n1 = elem_n2;
 6577: 
 6578:          bottomFlux = - topFlux;
 6579:       }
 6580:    }  
 6581: 
 6582: 
 6583: 
 6584: 
 6585: 
 6586: 
 6587: 
 6588: // !===============================================================================
 6589: // !===============================================================================
 6590: 
 6591: } // extern "C"
 6592: 
 6593: #ifdef DONTCOMPILE
 6594: __device__ void computeVerticalAdvection(void) {
 6595:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6596: 
 6597:    sdbt(1:2,:,:)=0.d0
 6598: 
 6599:    const Side *side = FROM kernel;
 6600: 
 6601:    if(side->isDry) return;
 6602: 
 6603:    // If side is wet...
 6604: 
 6605: 
 6606:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6607:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6608:    double ws[nvrt] = {} // w @ side
 6609:    int icount = 0;
 6610:    for (int j=0; j<2; j++) {
 6611:       const Element *elem = side->elements[j];
 6612:        
 6613:       if(elem != nullptr) {
 6614:          icount++;
 6615:          for (int k=0; k<nvrt; k++) {
 6616:             ws[k] = ws[k] + elem->w[k];
 6617:          }
 6618:       }
 6619:    }  // for j
 6620: 
 6621:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6622:    ws = ws/icount;
 6623: 
 6624:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6625:    // Splines allow for a smooth transition between vertical levels.
 6626:    // Splines have continuity restrictions at the internal knots, but
 6627:    // we have to provide the 1st derivatives at the endpoints.
 6628:    const int kbs = side->kbs; 
 6629:    
 6630:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6631:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6632:    initCubicSpline(kbs, nvrt, side, ws, up)
 6633: 
 6634:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6635:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6636:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6637: 
 6638:    // Total advection (average onto side)
 6639:    const Node *node1 = side->nodes[0];
 6640:    const Node *node2 = side->nodes[1];
 6641:    for (int k=kbs(i); k<nvrt; k++) {
 6642: 
 6643:       Vector2 bcc1 = node1->bcc[k];
 6644:       Vector2 bcc2 = node2->bcc[k];
 6645:       if constexpr(ics == 2) {
 6646:          // Project the velocities from the node frames to the side frame
 6647:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 6648:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 6649:       }
 6650: 
 6651:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 6652:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 6653: 
 6654:    }
 6655: }
 6656: #endif
 6657: 
 6658: 
 6659: extern "C" {
 6660:    __global__ void computeElemAverageGhat(void) {
 6661:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6662: 
 6663:       ELEM(elem);
 6664:       
 6665:       elem->ghat1= {0.0, 0.0};  
 6666: 
 6667:       if constexpr(ihydraulics != 0) {
 6668:          if (nhtblocks > 0 && elem->isblock) return;
 6669:       }
 6670: 
 6671:       
 6672:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 6673:       // cff1-3: coefficients for 2D/3D
 6674: 
 6675:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6676:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6677:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 6678: 
 6679:       if (elem->isDry) return;
 6680: 
 6681:       // Average of the coefficients
 6682:       double av_cff1 = 0.0;  // av. for cff1
 6683:       double av_cff2 = 0.0;  // av. for cff2
 6684:       double av_cff3 = 0.0;  // av. for cff3
 6685:       double av_df = 0.0;  // av. for H^\alpha / H
 6686:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6687:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6688: 
 6689:       const int i34 = elem->i34;
 6690:       const int kb  = elem->kb;
 6691: 
 6692:       for (int j=0; j<i34; j++) {
 6693:          // For each node and side in the element...
 6694: 
 6695:          const Node *node = elem->nodes[j];
 6696:          const Side *side = elem->sides[j];
 6697: 
 6698:          const double chi      = side->chi;
 6699:          const double veg_c2   = side->veg_c2;
 6700:          const double veg_beta = side->veg_beta;
 6701:          const double veg_h    = side->veg_h();
 6702:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6703: 
 6704:          // Node - const in elem
 6705:          elem->gradEta += node->eta2*elem->gradPhi[j];  // gradPhi is always in the element frame
 6706:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6707: 
 6708:          if (elem->depth >= tip_dp) {
 6709:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6710:          }
 6711: 
 6712:          
 6713:          const double htot  = side->htot2();        // Total depth at the side
 6714:          const double zctr2 = side->zTopCanopy();  
 6715: 
 6716:          double cff1; 
 6717:          double cff2; 
 6718:          double cff3;   
 6719:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6720:          // coefficients applied to 2D/3D case 
 6721:             cff1 = side->hhat/htot;
 6722:             cff2 = 0.0;
 6723:             cff3 = 0.0;
 6724:          } else { //3D
 6725:             //Init for no-veg case
 6726:             cff1 = 1.0;
 6727:             cff2 = 1.0;
 6728:             cff3 = 0.0;
 6729: 
 6730:             if constexpr(iveg != 0) {
 6731:                // Computes coefficients used with vegetation terms G1, G2
 6732:                // cff1, cff3 are used for the first two terms in G1, G2:
 6733:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6734:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6735:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6736:                if(veg_h < 0.99*htot) { // submergent vegetation
 6737:                   cff1=1;
 6738:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6739:                   cff3 = veg_c;
 6740: 
 6741:                } else { // emergent vegetation
 6742:                   cff1 = 1.0/(1.0 + veg_c2);
 6743:                   cff2 = cff1;
 6744:                   cff3 = 0.0;
 6745: 
 6746:                }
 6747:             } // if iveg
 6748:          } //  2D/3D
 6749: 
 6750:          av_cff1 += cff1/i34;
 6751:          av_cff2 += cff2/i34;
 6752:          av_cff3 += cff3/i34;
 6753:          av_cff2_chi += cff2*chi/i34;
 6754:          av_cff3_chi += cff3*chi/i34;
 6755:          av_df += min(htot, veg_h)/(htot*i34);
 6756: 
 6757: 
 6758:          // btrack values: U^\star, U^{\star\alpha}
 6759:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6760:          Vector2 Ustar       = {0.0, 0.0}; 
 6761:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6762: 
 6763:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6764:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6765:          } else { //3D
 6766:             for (int k = side->kb + 1; k < nvrt; k++) {
 6767:             
 6768:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6769:                Ustar += w2;
 6770: 
 6771:                if constexpr(iveg != 0) {
 6772:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6773:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6774:                        Ustar_alpha += zrat*w2; // XXXX
 6775:                    }
 6776:                }  // if iveg
 6777:             }  // for k
 6778:          }  //2D/3D
 6779: 
 6780:          // If needed, project the side velocities to the element frame
 6781:          if constexpr(ics==2) {
 6782:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 6783:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 6784:          }
 6785:          
 6786: 
 6787:          // Add btrack & surface stress terms to \breve{G} first
 6788:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6789: 
 6790: 
 6791: 
 6792:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 6793:          Vector2 tau    = side->tau();  
 6794:          Vector2 ubstar = side->btu[side->kb + 1];  
 6795: 
 6796:          // If needed, project tau and ubstar to the element frame
 6797:          if constexpr(ics==2) {
 6798:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 6799:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 6800:          }
 6801: 
 6802:          // Term for surface and bottom stress
 6803:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6804: 
 6805: 
 6806:          // All terms in F,F^\alpha,f_b except baroclinic
 6807:          // F, f_b: all explicit terms excluding vegetation 
 6808:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6809:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6810:          const double coriolis = side->coriolis;
 6811:          Vector2 F  =  coriolis*side->U;  // F_x
 6812:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6813:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6814: 
 6815:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6816:             
 6817:             for (int k = side->kb; k < nvrt; k++) {
 6818:                if (zctr2 > side->zc[k-1]) {
 6819:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6820:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6821:                    Fa +=  coriolis*w2*zrat;
 6822:                } // if zctr2
 6823:             } // k
 6824:          } // iveg
 6825: 
 6826:          // Integrate horizontal viscosity force vertically
 6827:          for (int k=side->kb + 1; k<nvrt; k++) {
 6828:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6829: 
 6830:             F += levelHorVisc;
 6831: 
 6832:             // Vegetation term
 6833:             if constexpr(iveg!=0) {
 6834:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6835:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6836:                   Fa += levelHorVisc*zrat;
 6837:                } 
 6838:             } // if iveg
 6839:          } // for k
 6840: 
 6841:          // Get nu*grad(U) at the side's bottom level
 6842:          Vector2 nuGradU = side->nuGradU[side->kb];
 6843: 
 6844:          fb += nuGradU;
 6845: 
 6846:          // If needed, project vectorsF, fb and Fa to the element frame
 6847:          if constexpr(ics==2) {
 6848:             F    = side->frame.projHorVec(F,    elem->frame);
 6849:             fb   = side->frame.projHorVec(fb,   elem->frame);
 6850:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 6851:          } // if ics
 6852: 
 6853:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6854:       } // for j (nodes and sides)
 6855: 
 6856:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6857:          
 6858:       // Finish off terms in F, F^\alpha and f_b
 6859:       const double grav3 = elem->mean(&Node::grav2);
 6860:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6861: 
 6862: 
 6863:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6864:       for (int j=1; j<i34; j++) { 
 6865:          // For each side in the element...
 6866:          const Side *side = elem->sides[j];
 6867:          const double chi = side->chi;
 6868: 
 6869:          const double htot = side->htot2();
 6870:          const double veg_h = side->veg_h();
 6871:          const Vector2 F  = htot*fb;
 6872:          const Vector2 Fa = min(htot, veg_h)*fb;
 6873: 
 6874:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6875:       } // for j
 6876: 
 6877:       //botf1 etc are already in elem frame
 6878:       elem->ghat1 += tmp/i34;
 6879: 
 6880:       // Baroclinic force
 6881:       if constexpr(ibc==0) {
 6882:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6883: 
 6884:          Vector2 Fa = {0.0, 0.0};
 6885:          Vector2 intGradRho = {0.0, 0.0};
 6886:          
 6887:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 6888:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 6889:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6890: 
 6891:             // \in F [m^2/s/s]
 6892:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6893:          }
 6894: 
 6895:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6896:          const Vector2 F = av_df*Fa; //approx
 6897:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6898: 
 6899:       } // if ibc
 6900: 
 6901: 
 6902: 
 6903:    }
 6904: 
 6905: } // extern "C"
 6906: 
 6907: 
 6908: 
 6909: #ifdef DONTCOMPILE
 6910: __global__ void checkMassConservation(Tracers* sumtr) {
 6911: 
 6912:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6913: 
 6914:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6915: 
 6916:    Element *elem = &(mesh->localElemData[i]);
 6917: 
 6918:    // Skip dry elements
 6919:    if (elem->isDry) return;
 6920: 
 6921:    // Local sum array for this thread
 6922:    double localSum[N_TRACERS] = {0.0};
 6923: 
 6924:    // Sum over vertical levels for this element
 6925:    const int kbe = elem->kbe;
 6926:    const double area = elem->area;
 6927: 
 6928:    for (int k = kbe; k < nvrt; k++) {
 6929:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6930:       
 6931:       // Accumulate tracer mass
 6932:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6933:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6934:       }
 6935:    }
 6936: 
 6937:    //  This function returns per element sums. A reduction must be done on the host side.
 6938: }
 6939: 
 6940: 
 6941: __global__ void transport(void) {
 6942: 
 6943:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6944: 
 6945:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6946: 
 6947:    Element *elem = &(mesh->localElemData[ie]);
 6948: 
 6949:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6950: 
 6951:                for (int m=0; m<ntr; m++) {
 6952:                   for (int k=kbe(ie); k<nvrt; k++) {
 6953:                      // Calculate each polynomial's weight 
 6954:                      wm=0.d0; sum1=0.d0; 
 6955:                      wm1=0.d0; wm2=0.d0; 
 6956:                      for (int i=0; i<elem->nweno2; i++) {
 6957:                   
 6958:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6959:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6960:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6961:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6962:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6963:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6964:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6965:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6966:                      // -----------------Hu and Shu (1999)'s method----------------
 6967:                      b4=b1+b2+b3
 6968: 
 6969: //Error: add PRODUCTION CPP
 6970: #ifdef DEBUG
 6971:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6972:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6973:                     call parallel_abort(errmsg)
 6974:                   }
 6975: #endif
 6976: 
 6977:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6978:                   // !----test-------------- 
 6979:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6980:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6981:                   // !wm(i)=wm1(i)*wm2(i)
 6982:                   // !---------------------- 
 6983:                   sum1=sum1+wm(i)
 6984:                 } // end for i
 6985: 
 6986:                 wm=wm/sum1
 6987: 
 6988:                 for (int j=0; j<elem->i34; j++) {
 6989: 
 6990:                   const Side *side  = elem->sides[j];
 6991:                   const Node *node1 = side->n1;
 6992:                   const Node *node2 = side->n2;
 6993: 
 6994:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6995:                      trsd=0.d0
 6996:                      for (int kk=0; kk<nquad; kk++) {
 6997:                         for (int i=0; i<elem->nweno2; i++) {
 6998:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6999:                         } // end for i   
 7000:                      } // end for kk
 7001:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7002:                   } // outward flux
 7003:                } // end for j=1,i34(ie) ! side
 7004:             }
 7005:          }
 7006:               
 7007: 
 7008: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7009: //             //   calculate each polynomial's weight 
 7010: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7011: //                 wm=0.d0; sum1=0.d0
 7012: //                 do i=1,nweno1(ie) !for each polynomial
 7013: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7014: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7015: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7016: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7017: //                   wm(i)=b2
 7018: //                   sum1=sum1+b2
 7019: //                   !wm(i)=1.d0
 7020: //                   !sum1=sum1+1.d0
 7021: 
 7022: // // Error: PRODUCTION
 7023: // #ifdef DEBUG
 7024: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7025: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7026: //                     call parallel_abort(errmsg)
 7027: //                   endif
 7028: // #endif
 7029: 
 7030: //                 enddo !i
 7031: //                 wm=wm/sum1 !final weight
 7032: 
 7033:                 for (int j=0; j<elem->i34; j++) { // side
 7034:                   const Side *side = elem->sides[j];
 7035:                   const Node *node1 = side->n1;
 7036:                   const Node *node2 = side->n2;
 7037: 
 7038:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7039:                     trsd=0.d0
 7040:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7041:                       for (int i=0; i<elem->nweno1; i++) {
 7042:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7043:                       }
 7044:                     enddo //kk
 7045:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7046:                   } // outward flux
 7047:                 } // end for j=1,i34(ie) ! side
 7048:               } // end for k; ntr 
 7049: 
 7050:             else !simple upwind method
 7051:               do j=1,i34(ie)
 7052:                 jsj=elside(j,ie)
 7053:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7054:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7055:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7056:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7057:                   endif
 7058:                 enddo  !vertical layers
 7059:               enddo !j=1,i34(ie) ! side
 7060:             endif !order of accuracy
 7061: 
