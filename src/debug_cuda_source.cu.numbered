 1796: // Helper functions for computing the local node index at a given offset from another.
 1797: __device__ __inline__ int nxq(int offset, int index, int size) {
 1798:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1799:    // to the index to make it positive
 1800:    assert(index + offset + 16*size >= 0);
 1801:    return (index + offset + 16*size) % size;  
 1802: }
 1803: 
 1804: __device__ __inline__ int nxq(int index, int size) {
 1805:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1806:    // to the index to make it positive
 1807:    assert(index + 16*size >= 0);
 1808:    return (index + 16*size) % size; 
 1809: }
