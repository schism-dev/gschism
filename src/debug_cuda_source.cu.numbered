 2063: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2064: // Convert shape coordinates to cartesian coordinates
 2065: 
 2066:    if (i34 == 3) {
 2067:       // Triangular element
 2068:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2069:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2070:    }
 2071:    else {
 2072:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2073:    }
 2074: 
 2075: }
