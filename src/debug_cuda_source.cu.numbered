 6498: #ifdef DONTCOMPILE
 6499: __device__ void computeVerticalAdvection(void) {
 6500:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6501: 
 6502:    sdbt(1:2,:,:)=0.d0
 6503: 
 6504:    const Side *side = FROM kernel;
 6505: 
 6506:    if(side->isDry) return;
 6507: 
 6508:    // If side is wet...
 6509: 
 6510: 
 6511:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6512:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6513:    double ws[nvrt] = {} // w @ side
 6514:    int icount = 0;
 6515:    for (int j=0; j<2; j++) {
 6516:       const Element *elem = side->elements[j];
 6517:        
 6518:       if(elem != nullptr) {
 6519:          icount++;
 6520:          for (int k=0; k<nvrt; k++) {
 6521:             ws[k] = ws[k] + elem->w[k];
 6522:          }
 6523:       }
 6524:    }  // for j
 6525: 
 6526:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6527:    ws = ws/icount;
 6528: 
 6529:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6530:    // Splines allow for a smooth transition between vertical levels.
 6531:    // Splines have continuity restrictions at the internal knots, but
 6532:    // we have to provide the 1st derivatives at the endpoints.
 6533:    const int kbs = side->kbs; 
 6534:    
 6535:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6536:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6537:    initCubicSpline(kbs, nvrt, side, ws, up)
 6538: 
 6539:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6540:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6541:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6542: 
 6543:    // Total advection (average onto side)
 6544:    const Node *node1 = side->nodes[0];
 6545:    const Node *node2 = side->nodes[1];
 6546:    for (int k=kbs(i); k<nvrt; k++) {
 6547: 
 6548:       if constexpr(ics==1) {
 6549:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6550:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6551:       } else {
 6552:          // XXX IMPLEMENT THIS
 6553:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6554:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6555:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6556:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6557:       }  // if ics
 6558: 
 6559: 
 6560:    }
 6561: }
 6562: #endif
 6563: 
 6564: 
 6565: extern "C" {
 6566:    __global__ void computeElemAverageGhat(void) {
 6567:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6568: 
 6569:       ELEM(elem);
 6570:       
 6571:       elem->ghat1= {0.0, 0.0};  
 6572: 
 6573:       if constexpr(ihydraulics != 0) {
 6574:          if (nhtblocks > 0 && elem->isblock) return;
 6575:       }
 6576: 
 6577:       if (elem->isDry) return;
 6578: 
 6579:       // Wet elements.
 6580:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6581:       // tidal potential, horizontal diffusion, and baroclinic etc
 6582:       // Remember to update both fb and F 
 6583:       // If ics=2, ghat1 are in eframe (ll)
 6584:       // cff1-3: coefficients for 2D/3D
 6585:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6586:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6587:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6588: 
 6589:       double av_cff1 = 0.0;  // av. for cff1
 6590:       double av_cff2 = 0.0;  // av. for cff2
 6591:       double av_cff3 = 0.0;  // av. for cff3
 6592:       double av_df = 0.0;  // av. for H^\alpha / H
 6593:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6594:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6595: 
 6596:       const int i34 = elem->i34;
 6597:       const int kb = elem->kb;
 6598: 
 6599:       for (int j=1; j<i34; j++) {
 6600:          // For each node and side in the element...
 6601: 
 6602:          const Node *node = elem->nodes[j];
 6603:          const Side *side = elem->sides[j];
 6604: 
 6605:          const double chi      = side->chi;
 6606:          const double veg_c2   = side->veg_c2;
 6607:          const double veg_beta = side->veg_beta;
 6608:          const double veg_h    = side->veg_h();
 6609:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6610: 
 6611:          // Node - const in elem
 6612:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6613:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6614: 
 6615:          if (elem->depth >= tip_dp) {
 6616:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6617:          }
 6618: 
 6619:          
 6620:          const double htot  = side->htot2();        // Total depth at the side
 6621:          const double zctr2 = side->zTopCanopy();  
 6622: 
 6623:          double cff1; 
 6624:          double cff2; 
 6625:          double cff3;   
 6626:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6627:          // coefficients applied to 2D/3D case 
 6628:             cff1 = side->hhat/htot;
 6629:             cff2 = 0.0;
 6630:             cff3 = 0.0;
 6631:          } else { //3D
 6632:             //Init for no-veg case
 6633:             cff1 = 1.0;
 6634:             cff2 = 1.0;
 6635:             cff3 = 0.0;
 6636: 
 6637:             if constexpr(iveg != 0) {
 6638:                // Computes coefficients used with vegetation terms G1, G2
 6639:                // cff1, cff3 are used for the first two terms in G1, G2:
 6640:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6641:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6642:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6643:                if(veg_h < 0.99*htot) { // submergent vegetation
 6644:                   cff1=1;
 6645:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6646:                   cff3 = veg_c;
 6647: 
 6648:                } else { // emergent vegetation
 6649:                   cff1 = 1.0/(1.0 + veg_c2);
 6650:                   cff2 = cff1;
 6651:                   cff3 = 0.0;
 6652: 
 6653:                }
 6654:             } // if iveg
 6655:          } //  2D/3D
 6656: 
 6657:          av_cff1 += cff1/i34;
 6658:          av_cff2 += cff2/i34;
 6659:          av_cff3 += cff3/i34;
 6660:          av_cff2_chi += cff2*chi/i34;
 6661:          av_cff3_chi += cff3*chi/i34;
 6662:          av_df += min(htot, veg_h)/(htot*i34);
 6663: 
 6664: 
 6665:          // btrack values: U^\star, U^{\star\alpha}
 6666:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6667:          Vector2 Ustar       = {0.0, 0.0}; 
 6668:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6669: 
 6670:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6671:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6672:          } else { //3D
 6673:             for (int k = side->kb; k < nvrt; k++) {
 6674:             
 6675:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6676:                Ustar += w2;
 6677: 
 6678:                if constexpr(iveg != 0) {
 6679:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6680:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6681:                        Ustar_alpha += zrat*w2; // XXXX
 6682:                    }
 6683:                }  // if iveg
 6684:             }  // for k
 6685:          }  //2D/3D
 6686:          
 6687: 
 6688:          // Add btrack & surface stress terms to \breve{G} first
 6689:          if constexpr(ics==1) {
 6690:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6691:          } else {
 6692:             // XXX IMPLEMENT THIS
 6693:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6694:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6695:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6696:          }  // if ics
 6697: 
 6698:          // Surface and bottom stress terms
 6699:          if constexpr(ics==1) {
 6700:             const Vector2 tau    = side->tau();
 6701:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6702: 
 6703:             // Term for surface and bottom stress
 6704:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6705:          } else {
 6706:             // XXX IMPLEMENT THIS
 6707:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6708:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6709:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6710:             // tau_x=(vn1+tt1)/2.d0
 6711:             // tau_y=(vn2+ss1)/2.d0
 6712:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6713:          }  // if ics
 6714: 
 6715:          
 6716: 
 6717:          // All terms in F,F^\alpha,f_b except baroclinic
 6718:          // F, f_b: all explicit terms excluding vegetation 
 6719:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6720:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6721:          const double coriolis = side->coriolis;
 6722:          Vector2 F  =  coriolis*side->U;  // F_x
 6723:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6724:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6725: 
 6726:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6727:             
 6728:             for (int k = side->kb; k < nvrt; k++) {
 6729:                if (zctr2 > side->zc[k-1]) {
 6730:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6731:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6732:                    Fa +=  coriolis*w2*zrat;
 6733:                } // if zctr2
 6734:             } // k
 6735:          } // iveg
 6736: 
 6737:          // Integrate horizontal viscosity force vertically
 6738:          for (int k=side->kb + 1; k<nvrt; k++) {
 6739:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6740: 
 6741:             F += levelHorVisc;
 6742: 
 6743:             // Vegetation term
 6744:             if constexpr(iveg!=0) {
 6745:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6746:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6747:                   Fa += levelHorVisc*zrat;
 6748:                } 
 6749:             } // if iveg
 6750:          } // for k
 6751: 
 6752:          fb += side->nuGradU[side->kb];
 6753: 
 6754:          // Add to ghat1
 6755:          if constexpr(ics==2) {
 6756:             // XXX IMPLEMENT THIS
 6757:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6758:             // bigf1=vn1; bigf2=vn2
 6759:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6760:             // botf1=vn1; botf2=vn2
 6761:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6762:             // bigfa1=vn1; bigfa2=vn2
 6763:          } // if ics
 6764: 
 6765:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6766:       } // for j (nodes and sides)
 6767: 
 6768:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6769:          
 6770:       // Finish off terms in F, F^\alpha and f_b
 6771:       const double grav3 = elem->mean(&Node::grav2);
 6772:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6773: 
 6774: 
 6775:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6776:       for (int j=1; j<i34; j++) { 
 6777:          // For each side in the element...
 6778:          const Side *side = elem->sides[j];
 6779:          const double chi = side->chi;
 6780: 
 6781:          const double htot = side->htot2();
 6782:          const double veg_h = side->veg_h();
 6783:          const Vector2 F  = htot*fb;
 6784:          const Vector2 Fa = min(htot, veg_h)*fb;
 6785: 
 6786:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6787:       } // for j
 6788: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6789:       //botf1 etc are already in elem frame
 6790:       elem->ghat1 += tmp/i34;
 6791: 
 6792:       // Baroclinic force
 6793:       if constexpr(ibc==0) {
 6794:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6795: 
 6796:          Vector2 Fa = {0.0, 0.0};
 6797:          Vector2 intGradRho = {0.0, 0.0};
 6798:          
 6799:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6800:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6801:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6802: 
 6803:             // \in F [m^2/s/s]
 6804:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6805:          }
 6806: 
 6807:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6808:          const Vector2 F = av_df*Fa; //approx
 6809:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6810: 
 6811:       } // if ibc
 6812: 
 6813: 
 6814: 
 6815:    }
 6816: 
 6817: } // extern "C"
 6818: 
 6819: 
