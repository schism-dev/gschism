 3128: 
 3129: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3130: 
 3131: 
 3132: __device__ void Node::updateKb(void) {
 3133: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3134: 
 3135:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3136: 
 3137: 
 3138:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3139: 
 3140:    if constexpr(ivcor == 2) {  // SZ coordinates
 3141:       
 3142:       // Compute bottom level index
 3143:       if (depth <= mesh->h_s) {
 3144:          kb = izlev;   
 3145:          
 3146:       } else {
 3147:          kb = -1;
 3148:          int L = 0;
 3149:          int R = nzlev; 
 3150:          
 3151:          while (L <= R) {
 3152:             int M = (R + L) / 2;
 3153: 
 3154: 
 3155:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3156:             
 3157:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3158:                R = M;
 3159:             } else {
 3160:                L = M;
 3161:             }
 3162: 
 3163:             if (R - L == 1) {
 3164:                kb = L;
 3165:                break;
 3166:             }
 3167:          }
 3168: 
 3169:          // Checks that the binary search was successful
 3170:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3171:        
 3172:       }
 3173:    } 
 3174: }
 3175: 
 3176: 
 3177: __device__ __inline__ void Node::updateZCoordData(void) {
 3178: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3179: 
 3180:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3181:    // if (isDry2()) {
 3182:    //    kb = -1;  // XXXXXXXX KKKKK
 3183:    //    return;
 3184:    // }
 3185: 
 3186: 
 3187:    if constexpr(ivcor == 2) {  // SZ coordinates
 3188:       
 3189:       // Compute bottom level index
 3190:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3191:    } 
 3192:    else if (ivcor == 1) {  // Localized sigma
 3193:       // Do nothing
 3194:    }
 3195: 
 3196: 
 3197: }
