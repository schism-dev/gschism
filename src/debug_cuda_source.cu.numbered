 2644:    template<typename T>
 2645:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2646:       T values[4];
 2647:       getNodalValues(field, values);
 2648: 
 2649:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2650:       if constexpr (IsVector2<T>::value && ics == 2) {
 2651: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2652:          projectNodeVectorsToElementFrame(values);
 2653: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2654:       }
 2655: 
 2656:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2657:    }
 2658: 
 2659:    template<typename T>
 2660:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2661:       T values[4];
 2662:       getSideValues(field, values);
 2663:       
 2664:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2665:       if constexpr (IsVector2<T>::value && ics == 2) {
 2666: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2667:          projectSideVectorsToElementFrame(values);
 2668: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2669:       }
 2670: 
 2671:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2672:    }   
