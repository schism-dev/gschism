 1826: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1827: // return;   
 1828:    // Lock the mutex
 1829:    lock(&debugPlotMutex);
 1830:  
 1831:    bool ok = true;
 1832:    if (debugPlotIdx == nullptr) ok = false;
 1833:    if (*debugPlotIdx >= 10000) ok = false;
 1834:    if (ok) {
 1835:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1836:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1837:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1838:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1839:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1840:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1841:       (*debugPlotIdx)++;
 1842:    }
 1843: 
 1844:    __threadfence();               // ensure all above writes are visible
 1845:    // Unlock the mutex
 1846:    unlock(&debugPlotMutex);
 1847: 
 1848: }
