 1060: struct Side {
 1061: 
 1062:    // Geometry information
 1063:    int idx;               // Index of the side
 1064:    Node *n1, *n2;
 1065:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1066: 
 1067:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1068:    Vector2 center;        // Location of side center. 
 1069:    double zc[nvrt];       // Side center z-coord at each vertical level
 1070: 
 1071:    #ifdef USE_FRAMES
 1072:    Frame frame;
 1073:    #endif
 1074: 
 1075:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1076:                           // this is nullptr
