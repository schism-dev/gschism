 1802: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1803:                                               double &t, double& tIntersect) {
 1804: 
 1805:    double closest_intersect_t = 1e10;
 1806:    bool found_intersection = false;
 1807: 
 1808: double minDelta = 1e10; 
 1809: double btt1 = 1e10, btt2;
 1810:    for (int i = 0; i < i34; i++) {
 1811: 
 1812:       Side *side2 = sides[i];
 1813: 
 1814:       // (x3,y3)-(x4,y4) is the element side line
 1815:       const Point2 x3 = side2->n1->p2();
 1816:       const Point2 x4 = side2->n2->p2();
 1817: 
 1818:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1819:       const double delta = cross(x2 - x1, x3 - x4);
 1820: 
 1821:       if (abs(delta) > 0) {
 1822: 
 1823:          const double delta1 = cross(x3 - x1, x3 - x4);
 1824:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1825: 
 1826:          // Solves the two linear equations for tt1 and tt2
 1827:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1828:          const double tt2 = delta2/delta;
 1829: 
 1830: if (abs(tt1) < abs(btt1)) {
 1831:    minDelta = abs(delta);
 1832:    btt1 = tt1;
 1833:    btt2 = tt2;
 1834: }
 1835: 
 1836: if (idx == 0) printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1837:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1838:             closest_intersect_t = min(closest_intersect_t, tt1);
 1839:             side = side2;
 1840:             nextElement = side->otherElem(this);
 1841:             t = tt2;
 1842:             tIntersect = max(small, min(tt1, 1.0-small));
 1843:             found_intersection = true;
 1844:          }
 1845:       
 1846:       }
 1847:       else {  // parallel segments
 1848:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1849:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1850: 
 1851:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1852: 
 1853:          // const double dist = dot(x1 - x3, side2->n);
 1854:          // if (abs(dist) < small*length(x3 - x4)) {
 1855:          //    const double2 unitarySide = normalize(x4 - x3);
 1856:          //    const double len = dot(x2 - x1, unitarySide);
 1857:          //    t = t + len;
 1858:          //    t = max(0.0, min(t, 1.0));
 1859:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1860: 
 1861: 
 1862:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1863:          //    // t = tt2;
 1864:          //    found_intersection = true;
 1865:          // }
 1866:       }
 1867: 
 1868: 
 1869:    }
 1870: 
 1871:    if (!found_intersection) {
 1872:       
 1873: if (idx == 0) printf("ZZ No intersection found:\n"
 1874:            "Element %d\n"
 1875:            "in = %d\n"
 1876:            "minDelta = %e\n"
 1877:            "tt1 = %e, tt2 = %e\n"
 1878:            "segment: (%f, %f)-(%f, %f)\n"
 1879:            "Vertices:\n"
 1880:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1881:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1882:            IDX(nextElement),
 1883:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1884:            minDelta,
 1885:            btt1, btt2,
 1886:            x1.x, x1.y,
 1887:            x2.x, x2.y,
 1888:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1889:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1890:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1891:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1892:            nodes[0]->p.x, nodes[0]->p.y,
 1893:            nodes[1]->p.x, nodes[1]->p.y,
 1894:            nodes[2]->p.x, nodes[2]->p.y,
 1895:            nodes[0]->p.x, nodes[0]->p.y);
 1896: 
 1897:    }
 1898: 
 1899:    // assert(found_intersection && "No intersection found");
 1900: 
 1901:    // found_intersection should always be true, since we checked all the sides.  
 1902:    return found_intersection;
 1903: }
