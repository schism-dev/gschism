 4438: 
 4439:    __global__ void computeFlowBcVelocities(double time) {
 4440: 
 4441:       SIDE_BND(sideBnd);
 4442: 
 4443:       const Side *side = sideBnd->side;
 4444:  
 4445:       const bool isDry = side->isDry;
 4446:       const bool isLand = sideBnd->segment->isLand;
 4447: 
 4448:    
 4449:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4450: 
 4451:       if (isDry || isLand) return;
 4452: 
 4453:       // For wet sides in open boundaries...
 4454:       const Vector2 n = side->n;
 4455:       const BoundarySegment *segment = sideBnd->segment;
 4456: 
 4457:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4458: 
 4459:       const int ifltype = segment->ifltype;
 4460: 
 4461:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4462:       const Vector2 r_nuth0 = r_uth0*n;
 4463: 
 4464: 
 4465:       if (ifltype == 1 || ifltype == 2) {
 4466:       
 4467:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4468: 
 4469:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4470:          
 4471:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4472:          
 4473:       } else if (ifltype == -1) { // Flather 1
 4474: 
 4475:          for (int k = 0; k < nvrt; k++) {
 4476: 
 4477:             // uth is the normal vel.; no ramp up
 4478:             const double uth = sideBnd->nuth(k);
 4479:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4480: 
 4481:             sideBnd->ubc[k] += uth*n;
 4482:          }
 4483: 
 4484:       } else if (ifltype == 3 || ifltype == 5) {
 4485:          // vnth0=0 !normal vel.
 4486: 
 4487:          Vector2 r_u1_bar = {0.0, 0.0};
 4488:          // Computes the contribution to the velocity from all tide frequencies
 4489:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4490: 
 4491:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4492:             const Vector2 umo  = sideBnd->umo(jfr); 
 4493: 
 4494:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4495:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4496:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4497:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4498: // printf("r_u1_bar = %f, %f, ramp = %f, ff = %f, umo = %f, %f, ufa = %f, %f\n", r_u1_bar.x, r_u1_bar.y, ramp, ff[jfr], umo.x, umo.y, ufa.x, ufa.y);         
 4499:          }
 4500: 
 4501: 
 4502:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4503: 
 4504:       } // if (ifltype = 3 || ifltype == 5
 4505: 
 4506: 
 4507: 
 4508:    }
 4509: 
 4510:    __global__ void computeElevationBoundaryConditions(double time) {
 4511:       // Compute elevation essential boundary conditions 
 4512: 
 4513:       NODE_BND(nodeBnd); // Each boundary node.
 4514: 
 4515:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4516: 
 4517:       const Node *node = nodeBnd->node;
 4518:       const BoundarySegment *segment = nodeBnd->segment;
 4519:       const int iettype = segment->iettype;
 4520:       
 4521: 
 4522:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4523:       double eic = 0.0;
 4524:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4525:       else                 eic = 0.0;
 4526: 
 4527:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4528:       const double r_eth = ramp*nodeBnd->eth;
 4529:       double r_eta1_bar = 0.0;
 4530: 
 4531: 
 4532:       // Compute tide elevation
 4533:       if (iettype == 3 || iettype == 5) {   
 4534: 
 4535:          if constexpr(iloadtide==1) { // loading tide
 4536:             assert(false && "Loading tide not implemented");
 4537:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4538:          }
 4539:          
 4540:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4541: 
 4542:             const double efa  = nodeBnd->efa[jfr]; 
 4543:             const double emo  = nodeBnd->emo[jfr]; 
 4544: 
 4545:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4546:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4547:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4548: 
 4549:          } // for jfr
 4550: 
 4551:       } // if iettype
 4552: 
 4553:       switch (iettype) {
 4554:          case 1:
 4555:          case 2:
 4556:          case 4:
 4557:             nodeBnd->elbc = r_eic + r_eth;
 4558:             break;
 4559:          case 3:
 4560:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4561:             break;
 4562:          case 5:
 4563:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4564:             break;
 4565:       } // switch
 4566: 
 4567: 
 4568:       //Add inverse barometric effects
 4569:       if (iettype != 0 && inv_atm_bnd == 1) {
 4570:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4571:       }
 4572: 
 4573:    }
 4574: 
 4575: 
 4576:    __global__ void computeHorizontalViscosity(void) { 
 4577: 
 4578:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4579: 
 4580:       SIDE(side);
 4581: 
 4582:       if (side->isDry) return;
 4583: 
 4584:       for (int k = 0; k < nvrt; k++) {
 4585:          side->nuGradU[k] = {0.0, 0.0};
 4586:       }
 4587: 
 4588:       if constexpr(ihorcon == 1) {
 4589:          for (int k = side->kb; k < nvrt - 1; k++) {
 4590:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4591:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4592:             // By Zhang and Baptista.
 4593: 
 4594:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4595:             // This is a standard discretization of the Laplacian operator.
 4596:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4597:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4598:             // Gamma is hvis_coef0 in the code.
 4599:             // The value of gamma needs to be < 0.5.
 4600: 
 4601:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4602:             // side under consideration in each of the two possible elements that share the side.
 4603:             Vector2 sumU = {0.0, 0.0};
 4604:             for (int l = 0; l < 2; l++) {
 4605:                const Element *elem = side->elems[l];
 4606: 
 4607:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4608: 
 4609:                // Find the local index of the side in the element
 4610:                const int idxSide = elem->sideLocalIdx(side);
 4611:                // Find the two sides that are connected to the side under consideration
 4612:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4613:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4614: 
 4615:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4616: 
 4617:             }
 4618: 
 4619:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4620:    
 4621:          }
 4622:       }
 4623:       else if constexpr(ihorcon == 2) {
 4624:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4625:       }
 4626: 
 4627: 
 4628:    }
 4629: 
 4630: 
 4631:    __global__ void setEssentialBC(void) {
 4632:       // Set essential boundary conditions 
 4633:       NODE(node); // Each boundary node
 4634:       NodeBoundary *nodeBnd = node->nodeBnd;
 4635:       
 4636: // nodeBnd->isEssentialBC = true;      
 4637:       // Check if this node has essential BC
 4638:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4639:          // Verify BC value is valid
 4640:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4641: 
 4642:        
 4643:          // Set diagonal to 1 and zero off-diagonals
 4644:          node->coeffDiag = 1.0;
 4645: 
 4646:          for (int j = 0; j < node->numNodes; j++) {
 4647:                node->coeffMatrix[j] = 0.0;
 4648:          }
 4649:          
 4650:          // Set solution and RHS to BC value
 4651:          node->mX  = nodeBnd->elbc;
 4652:          node->qel = nodeBnd->elbc;
 4653: 
 4654:       } else {
 4655:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4656: 
 4657:          for (int j = 0; j < node->numNodes; j++) {
 4658:                Node* nbNode = node->nodes[j];
 4659:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4660:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4661:                   // Verify neighbor's BC value
 4662:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4663: 
 4664:                   // Subtract contribution to RHS
 4665:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4666:                   node->coeffMatrix[j] = 0.0;  
 4667:                }
 4668:          }
 4669:       }
 4670:    }
 4671: 
 4672: 
 4673:    __global__ void updateElevation(void) {
 4674:       NODE(node);
 4675: 
 4676: 
 4677:       node->eta2 = node->mX;
 4678: 
 4679:       node->updateZCoordData();
 4680:    }
