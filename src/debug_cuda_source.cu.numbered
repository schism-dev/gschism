  928:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo, const Side *origSide = nullptr) const;
  929:    
  930:    __device__ __forceinline__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  931: 
