 5872: #ifdef DONTCOMPILE
 5873: __device__ void computeVerticalAdvection(void) {
 5874:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 5875: 
 5876:    sdbt(1:2,:,:)=0.d0
 5877: 
 5878:    const Side *side = FROM kernel;
 5879: 
 5880:    if(side->isDry) return;
 5881: 
 5882:    // If side is wet...
 5883: 
 5884: 
 5885:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 5886:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 5887:    double ws[nvrt] = {} // w @ side
 5888:    int icount = 0;
 5889:    for (int j=0; j<2; j++) {
 5890:       const Element *elem = side->elements[j];
 5891:        
 5892:       if(elem != nullptr) {
 5893:          icount++;
 5894:          for (int k=0; k<nvrt; k++) {
 5895:             ws[k] = ws[k] + elem->w[k];
 5896:          }
 5897:       }
 5898:    }  // for j
 5899: 
 5900:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 5901:    ws = ws/icount;
 5902: 
 5903:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 5904:    // Splines allow for a smooth transition between vertical levels.
 5905:    // Splines have continuity restrictions at the internal knots, but
 5906:    // we have to provide the 1st derivatives at the endpoints.
 5907:    const int kbs = side->kbs; 
 5908:    
 5909:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5910:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5911:    initCubicSpline(kbs, nvrt, side, ws, up)
 5912: 
 5913:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5914:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5915:    initCubicSpline(kbs, nvrt, side, ws, vp)
 5916: 
 5917:    // Total advection (average onto side)
 5918:    const Node *node1 = side->nodes[0];
 5919:    const Node *node2 = side->nodes[1];
 5920:    for (int k=kbs(i); k<nvrt; k++) {
 5921: 
 5922:       if constexpr(ics==1) {
 5923:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 5924:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 5925:       } else {
 5926:          // XXX IMPLEMENT THIS
 5927:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 5928:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 5929:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 5930:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 5931:       }  // if ics
 5932: 
 5933: 
 5934:    }
 5935: }
 5936: #endif
 5937: 
 5938: 
 5939: extern "C" {
 5940:    __global__ void computeElemAverageGhat(void) {
 5941:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 5942: 
 5943:       ELEM(elem);
 5944:       
 5945:       elem->ghat1= {0.0, 0.0};  
 5946: 
 5947:       if constexpr(ihydraulics != 0) {
 5948:          if (nhtblocks > 0 && elem->isblock) return;
 5949:       }
 5950: 
 5951:       if (elem->isDry) return;
 5952: 
 5953:       // Wet elements.
 5954:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 5955:       // tidal potential, horizontal diffusion, and baroclinic etc
 5956:       // Remember to update both fb and F 
 5957:       // If ics=2, ghat1 are in eframe (ll)
 5958:       // cff1-3: coefficients for 2D/3D
 5959:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 5960:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 5961:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 5962: 
 5963:       double av_cff1 = 0.0;  // av. for cff1
 5964:       double av_cff2 = 0.0;  // av. for cff2
 5965:       double av_cff3 = 0.0;  // av. for cff3
 5966:       double av_df = 0.0;  // av. for H^\alpha / H
 5967:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 5968:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 5969: 
 5970:       const int i34 = elem->i34;
 5971:       const int kb = elem->kb;
 5972: 
 5973:       for (int j=1; j<i34; j++) {
 5974:          // For each node and side in the element...
 5975: 
 5976:          const Node *node = elem->nodes[j];
 5977:          const Side *side = elem->sides[j];
 5978: 
 5979:          const double chi      = side->chi;
 5980:          const double veg_c2   = side->veg_c2;
 5981:          const double veg_beta = side->veg_beta;
 5982:          const double veg_h    = side->veg_h();
 5983:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 5984: 
 5985:          // Node - const in elem
 5986:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 5987:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 5988: 
 5989:          if (elem->depth >= tip_dp) {
 5990:            elem->gradETP += node->ETP*elem->gradPhi[j];
 5991:          }
 5992: 
 5993:          
 5994:          const double htot  = side->htot2();        // Total depth at the side
 5995:          const double zctr2 = side->zTopCanopy();  
 5996: 
 5997:          double cff1; 
 5998:          double cff2; 
 5999:          double cff3;   
 6000:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6001:          // coefficients applied to 2D/3D case 
 6002:             cff1 = side->hhat/htot;
 6003:             cff2 = 0.0;
 6004:             cff3 = 0.0;
 6005:          } else { //3D
 6006:             //Init for no-veg case
 6007:             cff1 = 1.0;
 6008:             cff2 = 1.0;
 6009:             cff3 = 0.0;
 6010: 
 6011:             if constexpr(iveg != 0) {
 6012:                // Computes coefficients used with vegetation terms G1, G2
 6013:                // cff1, cff3 are used for the first two terms in G1, G2:
 6014:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6015:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6016:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6017:                if(veg_h < 0.99*htot) { // submergent vegetation
 6018:                   cff1=1;
 6019:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6020:                   cff3 = veg_c;
 6021: 
 6022:                } else { // emergent vegetation
 6023:                   cff1 = 1.0/(1.0 + veg_c2);
 6024:                   cff2 = cff1;
 6025:                   cff3 = 0.0;
 6026: 
 6027:                }
 6028:             } // if iveg
 6029:          } //  2D/3D
 6030: 
 6031:          av_cff1 += cff1/i34;
 6032:          av_cff2 += cff2/i34;
 6033:          av_cff3 += cff3/i34;
 6034:          av_cff2_chi += cff2*chi/i34;
 6035:          av_cff3_chi += cff3*chi/i34;
 6036:          av_df += min(htot, veg_h)/(htot*i34);
 6037: 
 6038: 
 6039:          // btrack values: U^\star, U^{\star\alpha}
 6040:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6041:          Vector2 Ustar       = {0.0, 0.0}; 
 6042:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6043: 
 6044:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6045:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6046:          } else { //3D
 6047:             for (int k = side->kb; k < nvrt; k++) {
 6048:             
 6049:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6050:                Ustar += w2;
 6051: 
 6052:                if constexpr(iveg != 0) {
 6053:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6054:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6055:                        Ustar_alpha += zrat*w2; // XXXX
 6056:                    }
 6057:                }  // if iveg
 6058:             }  // for k
 6059:          }  //2D/3D
 6060:          
 6061: 
 6062:          // Add btrack & surface stress terms to \breve{G} first
 6063:          if constexpr(ics==1) {
 6064:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6065:          } else {
 6066:             // XXX IMPLEMENT THIS
 6067:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6068:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6069:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6070:          }  // if ics
 6071: 
 6072:          // Surface and bottom stress terms
 6073:          if constexpr(ics==1) {
 6074:             const Vector2 tau    = side->tau();
 6075:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6076: 
 6077:             // Term for surface and bottom stress
 6078:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6079:          } else {
 6080:             // XXX IMPLEMENT THIS
 6081:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6082:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6083:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6084:             // tau_x=(vn1+tt1)/2.d0
 6085:             // tau_y=(vn2+ss1)/2.d0
 6086:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6087:          }  // if ics
 6088: 
 6089:          
 6090: 
 6091:          // All terms in F,F^\alpha,f_b except baroclinic
 6092:          // F, f_b: all explicit terms excluding vegetation 
 6093:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6094:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6095:          const double coriolis = side->coriolis;
 6096:          Vector2 F  =  coriolis*side->U;  // F_x
 6097:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6098:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6099: 
 6100:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6101:             
 6102:             for (int k = side->kb; k < nvrt; k++) {
 6103:                if (zctr2 > side->zc[k-1]) {
 6104:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6105:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6106:                    Fa +=  coriolis*w2*zrat;
 6107:                } // if zctr2
 6108:             } // k
 6109:          } // iveg
 6110: 
 6111:          // Integrate horizontal viscosity force vertically
 6112:          for (int k=side->kb + 1; k<nvrt; k++) {
 6113:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 6114: 
 6115:             F += levelHorVisc;
 6116: 
 6117:             // Vegetation term
 6118:             if constexpr(iveg!=0) {
 6119:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6120:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6121:                   Fa += levelHorVisc*zrat;
 6122:                } 
 6123:             } // if iveg
 6124:          } // for k
 6125: 
 6126:          fb += side->d2uv[side->kb];
 6127: 
 6128: 
 6129:          // Add to ghat1
 6130:          if constexpr(ics==2) {
 6131:             // XXX IMPLEMENT THIS
 6132:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6133:             // bigf1=vn1; bigf2=vn2
 6134:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6135:             // botf1=vn1; botf2=vn2
 6136:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6137:             // bigfa1=vn1; bigfa2=vn2
 6138:          } // if ics
 6139: 
 6140:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6141:       } // for j (nodes and sides)
 6142: 
 6143:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6144:          
 6145:       // Finish off terms in F, F^\alpha and f_b
 6146:       const double grav3 = elem->mean(&Node::grav2);
 6147:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6148: 
 6149: 
 6150:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6151:       for (int j=1; j<i34; j++) { 
 6152:          // For each side in the element...
 6153:          const Side *side = elem->sides[j];
 6154:          const double chi = side->chi;
 6155: 
 6156:          const double htot = side->htot2();
 6157:          const double veg_h = side->veg_h();
 6158:          const Vector2 F  = htot*fb;
 6159:          const Vector2 Fa = min(htot, veg_h)*fb;
 6160: 
 6161:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6162:       } // for j
 6163: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6164:       //botf1 etc are already in elem frame
 6165:       elem->ghat1 += tmp/i34;
 6166: 
 6167:       // Baroclinic force
 6168:       if constexpr(ibc==0) {
 6169:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6170: 
 6171:          Vector2 Fa = {0.0, 0.0};
 6172:          Vector2 intGradRho = {0.0, 0.0};
 6173:          
 6174:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6175:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6176:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6177: 
 6178:             // \in F [m^2/s/s]
 6179:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6180:          }
 6181: 
 6182:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6183:          const Vector2 F = av_df*Fa; //approx
 6184:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6185: 
 6186:       } // if ibc
 6187: 
 6188: 
 6189: 
 6190:    }
 6191: 
 6192: } // extern "C"
 6193: 
 6194: 
 6195: 
 6196: #ifdef DONTCOMPILE
 6197: __global__ void checkMassConservation(Tracers* sumtr) {
 6198: 
 6199:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6200: 
 6201:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6202: 
 6203:    Element *elem = &(mesh->localElemData[i]);
 6204: 
 6205:    // Skip dry elements
 6206:    if (elem->isDry) return;
 6207: 
 6208:    // Local sum array for this thread
 6209:    double localSum[N_TRACERS] = {0.0};
 6210: 
 6211:    // Sum over vertical levels for this element
 6212:    const int kbe = elem->kbe;
 6213:    const double area = elem->area;
 6214: 
 6215:    for (int k = kbe; k < nvrt; k++) {
 6216:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6217:       
 6218:       // Accumulate tracer mass
 6219:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6220:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6221:       }
 6222:    }
 6223: 
 6224:    
 6225: 
 6226:    //  This function returns per element sums. A reduction must be done on the host side.
 6227: }
 6228: 
 6229: 
 6230: __global__ void transport(void) {
 6231: 
 6232:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6233: 
 6234:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6235: 
 6236:    Element *elem = &(mesh->localElemData[ie]);
 6237: 
 6238:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6239: 
 6240:                for (int m=0; m<ntr; m++) {
 6241:                   for (int k=kbe(ie); k<nvrt; k++) {
 6242:                      // Calculate each polynomial's weight 
 6243:                      wm=0.d0; sum1=0.d0; 
 6244:                      wm1=0.d0; wm2=0.d0; 
 6245:                      for (int i=0; i<elem->nweno2; i++) {
 6246:                   
 6247:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6248:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6249:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6250:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6251:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6252:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6253:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6254:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6255:                      // -----------------Hu and Shu (1999)'s method----------------
 6256:                      b4=b1+b2+b3
 6257: 
 6258: //Error: add PRODUCTION CPP
 6259: #ifdef DEBUG
 6260:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6261:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6262:                     call parallel_abort(errmsg)
 6263:                   }
 6264: #endif
 6265: 
 6266:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6267:                   // !----test-------------- 
 6268:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6269:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6270:                   // !wm(i)=wm1(i)*wm2(i)
 6271:                   // !---------------------- 
 6272:                   sum1=sum1+wm(i)
 6273:                 } // end for i
 6274: 
 6275:                 wm=wm/sum1
 6276: 
 6277:                 for (int j=0; j<elem->i34; j++) {
 6278: 
 6279:                   const Side *side  = elem->sides[j];
 6280:                   const Node *node1 = side->n1;
 6281:                   const Node *node2 = side->n2;
 6282: 
 6283:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6284:                      trsd=0.d0
 6285:                      for (int kk=0; kk<nquad; kk++) {
 6286:                         for (int i=0; i<elem->nweno2; i++) {
 6287:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6288:                         } // end for i   
 6289:                      } // end for kk
 6290:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6291:                   } // outward flux
 6292:                } // end for j=1,i34(ie) ! side
 6293:             }
 6294:          }
 6295:               
 6296: 
 6297: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6298: //             //   calculate each polynomial's weight 
 6299: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6300: //                 wm=0.d0; sum1=0.d0
 6301: //                 do i=1,nweno1(ie) !for each polynomial
 6302: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6303: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6304: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6305: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6306: //                   wm(i)=b2
 6307: //                   sum1=sum1+b2
 6308: //                   !wm(i)=1.d0
 6309: //                   !sum1=sum1+1.d0
 6310: 
 6311: // // Error: PRODUCTION
 6312: // #ifdef DEBUG
 6313: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6314: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6315: //                     call parallel_abort(errmsg)
 6316: //                   endif
 6317: // #endif
 6318: 
 6319: //                 enddo !i
 6320: //                 wm=wm/sum1 !final weight
 6321: 
 6322:                 for (int j=0; j<elem->i34; j++) { // side
 6323:                   const Side *side = elem->sides[j];
 6324:                   const Node *node1 = side->n1;
 6325:                   const Node *node2 = side->n2;
 6326: 
 6327:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6328:                     trsd=0.d0
 6329:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6330:                       for (int i=0; i<elem->nweno1; i++) {
 6331:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6332:                       }
 6333:                     enddo //kk
 6334:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6335:                   } // outward flux
 6336:                 } // end for j=1,i34(ie) ! side
 6337:               } // end for k; ntr 
 6338: 
 6339:             else !simple upwind method
 6340:               do j=1,i34(ie)
 6341:                 jsj=elside(j,ie)
 6342:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6343:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6344:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6345:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6346:                   endif
 6347:                 enddo  !vertical layers
 6348:               enddo !j=1,i34(ie) ! side
 6349:             endif !order of accuracy
 6350: 
 6351:          //  enddo !ie
 6352: // !$OMP     end do
 6353: 
 6354: // !$OMP     master
 6355: //           !message passing
 6356: //           if (nproc>1) then
 6357: //             !make a copy of side concentrations
 6358: //             trsd_tmp0=trsd_tmp 
 6359: 
 6360: //             !this exchange routine swaps interface concentration between two partitions
 6361: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6362: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6363: 
 6364: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6365: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6366: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6367: 
 6368: 
 6369: //             !This obtains final values for interface sides
 6370: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6371: //       :    endif !nproc>1
 6372: //           !message passing end
 6373: // !$OMP     end master
 6374: // !$OMP     barrier
 6375: 
 6376: 
