  855: struct Side {
  856: 
  857:    // Geometry information
  858:    int idx;               // Index of the side
  859:    Node *n1, *n2;
  860:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  861: 
  862:    double len;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  863:    Vector2 center;        // Location of side center. 
  864:    double zc[nvrt];       // Side center z-coord at each vertical level
  865: 
  866:    Frame frame;
  867: 
  868:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  869:                           // this is nullptr
  870:    
  871:    int kb;                // Bottom index of the side
  872:    bool isDry;             // True if the side is dry
  873:  
  874:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  875: 
  876:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  877: 
  878:    // Physical information
  879:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  880:    double  w2[nvrt];            // Vertical velocity at each vertical level
  881:    Vector2 btu[nvrt];           // Back-tracked velocity
  882:    Vector2 U;                   // Vertically averaged velocity vector  
  883: 
  884:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  885: 
  886:    Vector2 bcc[nvrt];           // Baroclinic term
  887:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  888: 
  889:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  890:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  891:    Vector2 gradPr;               // Gradient of pressure
  892:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  893: 
  894: 
  895:    double hhat;                 // \breve{H} in notes
  896: 
  897:    double shapiro;
  898: 
  899:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  900: 
  901:    double coriolis;             // Coriolis parameter
  902: 
  903:    // Vegetation parameters
  904:    double veg_c2;
  905:    double veg_beta;
  906: 
  907:    // Bottom drag parameters.
  908:    double chi;
  909:    double chi2;
  910: 
  911:    __inline__ __device__ double x(double t) const;
  912:    __inline__ __device__ double y(double t) const;
  913:    __inline__ __device__ Point2 p_t(double t) const;
  914: 
  915:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  916:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  917:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  918:    __inline__ __device__ double area(int k)     const { return len*Dz(k + 1); }
  919: 
  920:    __inline__ __device__ Side* neigh(int index) const { 
  921:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  922:       assert(index >= 0 && index < 4); 
  923:       assert(elems[0] != nullptr && elems[1] != nullptr);
  924: 
  925:       const int ielem = index & 1;           // 0 or 1
  926:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  927: 
  928:       const Element* elem = elems[ielem];
  929: 
  930:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  931: 
  932:       return elem->sides[elem->nxq(locSideIdx + iside)];
  933: 
  934:    }
  935: 
  936:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  937: 
  938:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  939: 
  940:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  941:    __inline__ __device__ bool isBnd2(void) const { return elems[0] == nullptr; } // This is a different type of being boundary. XXXXX CHECK IF THIS THE SAME
  942:    __inline__ __device__ int iadv(void) const;
  943: 
  944:    __inline__ __device__ double grav3(void) const;
  945:    
  946:    __inline__ __device__ double eta2(void) const;
  947:    __inline__ __device__ double eta1(void) const;
  948:    __inline__ __device__ double depth(void) const;
  949:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  950:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  951: 
  952:    __inline__ __device__ double dfv(int k) const;
  953: 
  954:    __inline__ __device__ double veg_h(void)  const;
  955:    __inline__ __device__ double veg_nv(void) const;
  956:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  957:    __inline__ __device__ double veg_alpha3D(int k) const;
  958:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  959: 
  960:    __inline__ __device__ double etaMeanBnd(void) const;
  961: 
  962:    __inline__ __device__ double Cd(void) const;
  963: 
  964:    __inline__ __device__ Vector2 tau(void) const;
  965: 
  966:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  967:    
  968: 
  969:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  970:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  971:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  972:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  973:    } 
  974:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  975:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  976:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  977:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  978: 
  979:    // Get valid starting element (for backtracking)
  980:    __inline__ __device__ Element* getStartElement() {
  981:       return elems[0] ? elems[0] : elems[1];
  982:    }
  983: 
  984:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  985:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  986: 
  987:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
  988: 
  989:       // Dot product of the negative velocity vector with the side normal vector
  990:       const double dot_prod1 = -dot(u, n);
  991: 
  992:       // Vector from side center to element 0 centroid
  993:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  994: 
  995:       // Dot product of the vector with the side normal vector
  996:       const double dot_prod2 = dot(v2, n);
  997: 
  998:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  999:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1000: 
 1001:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1002:       else                           return elems[1];
 1003: 
 1004:  
 1005:    }
 1006: 
 1007:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1008:       // Given an element, returns the other element that shares this side
 1009:       return (elems[0] == elem) ? elems[1] : elems[0];
 1010:    }
 1011: 
 1012:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1013:       // Given a node, returns the other node that shares this side
 1014:       return (n1 == node) ? n2 : n1;
 1015:    }
 1016:  
 1017:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1018: 
 1019: 
 1020: 
 1021: 
 1022: };
