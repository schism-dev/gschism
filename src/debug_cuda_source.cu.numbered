 7383: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7384:    Element *elems = mesh->localElemData;
 7385: 
 7386:    *addr = elems;
 7387:    *sizeElement = sizeof(Element);
 7388:    switch (varCode) {
 7389:       case (int)VarCode::z:
 7390:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7391:          *sizeType = sizeof(double);
 7392:          break;
 7393:       case (int)VarCode::x:
 7394:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7395:          *sizeType = sizeof(Vector2);
 7396:          break;
 7397:       case (int)VarCode::area:
 7398:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7399:          *sizeType = sizeof(double);
 7400:          break;
 7401:       case (int)VarCode::depth:
 7402:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7403:          *sizeType = sizeof(double);
 7404:          break;
 7405:       case (int)VarCode::radius:
 7406:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7407:          *sizeType = sizeof(double);
 7408:          break;
 7409:       case (int)VarCode::lonlat:
 7410:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7411:          *sizeType = sizeof(double);
 7412:          break;
 7413:       case (int)VarCode::ghat:
 7414:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7415:          *sizeType = sizeof(Vector2);
 7416:          break;
 7417:       case (int)VarCode::kb:
 7418:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7419:          *sizeType = sizeof(int);
 7420:          break;
 7421:       case (int)VarCode::isdry:
 7422:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7423:          *sizeType = sizeof(int);
 7424:          break;            
 7425:       case (int)VarCode::w:
 7426:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7427:          *sizeType = sizeof(double);
 7428:          break;
 7429:       case (int)VarCode::FaceIndices:
 7430:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7431:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7432:          *sizeType = sizeof(Node);
 7433:          break;
 7434:       default:
 7435:          *offset = -1;
 7436:    }
 7437: }
