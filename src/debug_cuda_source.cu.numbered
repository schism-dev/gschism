 4424:    //      do k=1,nope_global
 4425:    //        if(iabs(ifltype(k))>=4) then
 4426:    //          icount=icount+1
 4427:    //          if(icount>nfltype2) call parallel_abort('STEP: wrong counting 6')
 4428:    //          do j=1,nond_global(k)
 4429:    //            icount2=icount2+1
 4430:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 4431: 
 4432:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 4433:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 4434:    //          enddo !j
 4435:    //        endif
 4436:    //      enddo !k
 4437:    //    endif !nfltype2
 4438:    }
