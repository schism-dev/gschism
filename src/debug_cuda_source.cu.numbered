  511:    Frame frame;
  512: 
  513:    Vector2 gradPhi[4];        // Derivatives of shape functions
  514:    Vector2 gradEta;           // Gradient of free surface elevation
  515:    Vector2 gradPr;            // Gradient of pressure    
  516:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  517: 
  518:    bool isDry;                // True if the element is dry
  519: 
  520:    Vector2 center;         // Element center coordinates
  521:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  522:    double depth;              // Depth at element (min of all nodes)
  523:    double z[nvrt];            // z-coord  (local frame - vertical up)
  524: 
  525:    // Physical information
  526:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  527: 
  528:    static const bool isblock = false;              // Always false
  529: 
  530:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  531:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  532: 
  533:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  534:    
  535: 
  536:    double vsource;            // Volumetric source/sink term [m^3/s]
  537: 
  538:    double rho[nvrt];          // Density at each prism center
  539:    double rho_mean[nvrt];     // Mean density at each prism center
  540:    CubicSpline rho_spl;
  541:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  542:    double rho_z[nvrt];        // First derivative of density at each prism center
  543:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  544:    
  545: 
  546:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  547: 
  548:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  549:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  550: 
  551:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  552:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  553: 
  554:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  555:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  556:       // Find the local index of the node in the element (0,1,2,3)
  557:       int res = __ffs((nodes[0] == node) | 
  558:                      ((nodes[1] == node) << 1) | 
  559:                      ((nodes[2] == node) << 2) | 
  560:                      ((nodes[3] == node) << 3)) - 1;
  561:       
  562:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  563:       return res;  
  564:    }
  565: 
  566:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  567:       // Find the local index of the side in the element (0,1,2,3)
  568:       int res = __ffs((sides[0] == side) | 
  569:                      ((sides[1] == side) << 1) | 
  570:                      ((sides[2] == side) << 2) | 
  571:                      ((sides[3] == side) << 3)) - 1;
  572:       
  573:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  574:       return res;
  575:    }
  576: 
  577: 
  578:    __inline__ __device__ int findLevel(double z1, int k) const {
  579:       // Starting at index k, find sequentially the level that contains z
  580: 
  581:       // For testing purposes, forgets k and performs a full search.
  582:       for (k = kb; k < nvrt - 1; k++) {
  583:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  584:       }
  585:       return nvrt - 2;
  586: 
  587: 
  588:       // if z is already betweeen z[k] and z[k+1], return k
  589:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  590:       else if (z1 <  z[k]) { 
  591:          // Search for increasing levels
  592:          for (int kk = k; kk < nvrt - 1; kk++) {
  593:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  594:          }
  595:          return nvrt - 1;
  596:       }
  597:       else {
  598:          // Search for decreasing levels
  599:          for (int kk = k; kk >= kb; kk--) {
  600:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  601:          }
  602:          return 0;
  603:       }
  604:    }
  605: 
  606:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  607:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  608: 
  609:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  610:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  611:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  612:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  613:        const double eta = (idx & 1) ? +g : -g;
  614:        const double xi  = (idx & 2) ? +g : -g;
  615:        return {eta, xi};
  616:    }  
  617: 
  618:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  619:    __device__ __forceinline__ double etaSign(int idx) const {
  620:       // bit1: 0 -> -1, 1 -> +1
  621:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  622:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  623:    }
  624: 
  625:    __device__ __forceinline__ double xiSign(int idx) const {
  626:       // +1 if (bit0 XOR bit1), else -1
  627:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  628:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  629: 
  630:    }
  631: 
  632:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  633:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  634:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  635:    }
  636: 
  637:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  638:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  639:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  640:    }   
  641: 
  642:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  643:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  644:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  645:    }      
  646:    
  647:    __inline__ __device__ double detJ_eta(void) const;
  648: 
  649:    __inline__ __device__ double detJ_xi(void) const;
  650: 
  651:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  652: 
  653:    // Check if the element is dry using the more up-to-date elevation.
  654:    __inline__ __device__ bool isDry2(void) const;
  655: 
  656:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  657: 
  658:    __inline__ __device__ double computeSignedArea(void) const;
  659: 
  660:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  661:       // Nudges the point (x,y) to the barycenter of the element
  662: 
  663:       p = (1.0 - btrack_nudge)*p + btrack_nudge*center;
  664:    }
  665: 
  666:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  667:    
  668:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  669: 
  670:    __device__ double intPhiPhi(int i1, int i2) const;
  671: 
  672:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  673: 
  674:    __device__ Vector2 grad2(double *a) const
  675:    {
  676:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  677:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  678:       if (isQuad()) {
  679:          gx += a[3]*gradPhi[3].x;
  680:          gy += a[3]*gradPhi[3].y;
  681:       }
  682:       return {gx, gy};
  683:    }
  684: 
  685:    __device__ Vector2 grad2(double Node::* field) const
  686:    {
  687:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  688:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  689:       if (isQuad()) {
  690:          gx += (nodes[3]->*field)*gradPhi[3].x;
  691:          gy += (nodes[3]->*field)*gradPhi[3].y;
  692:       }
  693:       return {gx, gy};
  694:    }
  695: 
  696:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  697:    __device__ __forceinline__ Vector3 n(int k) const {
  698:       double area3D;
  699:       return n(k, area3D);
  700:     }
