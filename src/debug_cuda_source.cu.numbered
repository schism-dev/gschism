  222: struct Bool4 {
  223:    unsigned int m; // bit i = lane i
  224: 
  225:    __device__ __forceinline__ bool get(int i) const { return (m >> i) & 1u; }
  226:    __device__ __forceinline__ void set(int i, bool v) {m = (m & ~(1u << i)) | ((unsigned int)(v) << i); }
  227: 
  228:    __device__ __forceinline__ bool all(void) const { return m == 0x0F; }
  229:    __device__ __forceinline__ bool any(void) const { return m != 0; }
  230:    __device__ __forceinline__ bool none(void) const { return m == 0; }
  231:    __device__ __forceinline__ int firstOne(void) const { return __ffs(m) - 1; }
  232: 
  233: };
  234: 
  235: __device__ __forceinline__ Bool4 operator!(Bool4 x) { x.m = (~x.m) & 0x0F; return x; }
  236: __device__ __forceinline__ Bool4 operator&(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m & b.m)}; }
  237: __device__ __forceinline__ Bool4 operator|(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m | b.m)}; }
