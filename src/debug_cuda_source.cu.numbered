 2545: // }
 2546: 
 2547: 
 2548: 
 2549: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2550: 
 2551: 
 2552: __device__ void Node::updateKb(void) {
 2553: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2554: 
 2555:    if constexpr(ivcor == 1) return;
 2556: 
 2557: 
 2558:    // Check if node is wet
 2559:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2560: 
 2561:    if (isDry) return;
 2562: 
 2563:    if constexpr(ivcor == 2) {  // SZ coordinates
 2564:       
 2565:       // Compute bottom level index
 2566:       if (depth <= mesh->h_s) {
 2567:          kb = mesh->kz - 1;
 2568:       } else {
 2569:          kb = -1;
 2570:          int L = 0;
 2571:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2572:          
 2573:          while (L <= R) {
 2574:             int M = (R + L) / 2;
 2575: 
 2576:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2577:             
 2578:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2579:                R = M;
 2580:             } else {
 2581:                L = M;
 2582:             }
 2583: 
 2584:             if (R - L == 1) {
 2585:                kb = L;
 2586:                break;
 2587:             }
 2588:          }
 2589:       }
 2590:    } 
 2591: }
 2592: 
 2593: 
 2594: __device__ double Node::compZCoord(int k) const {
 2595:    // Computes the z coordinate at level k.
 2596:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2597:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2598:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2599:    // used 
 2600:    
 2601:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2602:       
 2603:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2604: 
 2605:    if constexpr(ivcor == 2) {
 2606: 
 2607:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2608:       const int kz = mesh->kz;
 2609:       const double h_c = mesh->h_c;
 2610:       const double theta_f = mesh->theta_f;
 2611:       const double sinh_theta_f = mesh->sinh_theta_f;
 2612: 
 2613:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2614:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2615:       // once per time step/node.
 2616:       // CHECK: updateZCoordData
 2617: 
 2618:       if      (k == nvrt-1)      { return eta2; }
 2619:       else if (k == kz)          return -hmod2;
 2620:       else if (k == kb)          return -depth;
 2621:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2622:       else if (k > kz) {
 2623:          const int ksig = k - kz + 1;
 2624: 
 2625:          if (hmod2 <= h_c) {
 2626:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2627:          } 
 2628:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2629:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2630:             assert(false && "ZCOOR: invalid h_c\n");
 2631:          } 
 2632:          else {
 2633:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2634:                          h_c * mesh->sigma[ksig] + 
 2635:                          (hmod2 - h_c) * mesh->cs[ksig];
 2636:          }
 2637:       } else { 
 2638:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2639:       }
 2640: 
 2641:    }
 2642:    else if constexpr(ivcor == 1) {
 2643:       if (k == kb) return -depth;
 2644:       else if (k == nvrt-1) return eta2;
 2645:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2646:    }
 2647:    
 2648:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2649:    return 0.0;
 2650: }
 2651: 
 2652: 
 2653: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2654:    // Checks if a side in on the boundary
 2655:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2656: 
 2657:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2658:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2659: 
 2660:    // Indices of the nodes that form the side
 2661:    const int n1 = side.n1->idx;
 2662:    const int n2 = side.n2->idx;
 2663: 
 2664:    // Check if the side is on a land boundary
 2665:    for (int i = 0; i < nland; i++) {
 2666:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2667:          // Consecutive nodes in the land boundary segment
 2668:          const int b1 = ilnd[i*mnlnd + j];
 2669:          const int b2 = ilnd[i*mnlnd + j + 1];
 2670: 
 2671:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2672:             isLand = true;
 2673:             return i;
 2674:          }
 2675:       }
 2676:    }
 2677: 
 2678:    // Check if the side is on an open boundary
 2679:    for (int i = 0; i < nope; i++) {
 2680:       for (int j = 0; j < nond[i] - 1; j++) {
 2681:          // Consecutive nodes in the open boundary segment
 2682:          const int b1 = iond[i*mnond + j];
 2683:          const int b2 = iond[i*mnond + j + 1];
 2684: 
 2685:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2686:             isLand = false;
 2687:             return i;
 2688:          }
 2689:       }
 2690:    }
 2691:    return -1;
 2692: }
 2693: 
 2694: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2695:                 double *node_coords, double *wind_rotate_angle, 
 2696:                 int *isdel, int *isidenode, int *isbnd,
 2697:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2698:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2699:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2700:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2701:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2702:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2703:                 double *emo, double *efa, 
 2704:                 double *umo, double *ufa, 
 2705:                 double *vmo, double *vfa) {
 2706: 
 2707:    printf("Populating mesh for partition %d\n", partNum);
 2708: 
 2709:    // Horizontal grid
 2710:    printf("Processing %d nodes\n", np);    
 2711: 
 2712: 
 2713:    int idxNodeBoundary = 0;  
 2714:    for (int i = 0; i < np; i++)
 2715:    {
 2716:       Node &node = localNodeData[i];
 2717: 
 2718:       node.idx = i;
 2719: 
 2720:       const int idxNodeStart = nodeNeighNodesStart[i];
 2721:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2722:       node.numNodes = idxNodeEnd - idxNodeStart;
 2723:       node.nodes = nodeNeighNodes + idxNodeStart;
 2724:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2725: 
 2726: 
 2727: 
 2728:       const int idxElemStart = nodeNeighElemsStart[i];
 2729:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2730:       node.numElements = idxElemEnd - idxElemStart;
 2731:       node.elements = nodeNeighElems + idxElemStart;
 2732: 
 2733: 
 2734:       
 2735:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2736:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2737:          const int partNode = localNodePart[idxNodeGlobal]; 
 2738:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2739: 
 2740: 
 2741:          Node *node_ptr = nodes[partNode] + idxNode;
 2742:          
 2743:          nodeNeighNodes[idx] = node_ptr;
 2744:       }
 2745: 
 2746:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2747:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2748:          const int partElem = localElemPart[idxElemGlobal];
 2749:          const int idxElem  = localElemIndices[idxElemGlobal];
 2750: 
 2751:          Element *elem_ptr = elems[partElem] + idxElem;
 2752: 
 2753:          nodeNeighElems[idx] = elem_ptr;
 2754:       }      
 2755: 
 2756: 
 2757:       node.wind_angle = wind_rotate_angle[i];
 2758: 
 2759:       // Element **elements; // pointer to the elements connected to this node
 2760:       // int numElements;   // number of elements shared by this node
 2761: 
 2762:       node.p.x   = node_coords[i * 3];
 2763:       node.p.y   = node_coords[i * 3 + 1];
 2764:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2765:       node.depth = node_coords[i * 3 + 2];
 2766: 
 2767:       node.numSides = 0;
 2768: 
 2769: 
 2770:       // Links the node to the boundary information
 2771:       if (isbnd[i] >= 0) {
 2772:        
 2773:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2774:          node.nodeBnd->node = &node;
 2775: 
 2776:          node.nodeBnd->sideBnd1 = nullptr;
 2777:          node.nodeBnd->sideBnd2 = nullptr;
 2778: 
 2779:          if (isbnd[i]>=0) {
 2780: 
 2781:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2782:             
 2783:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2784:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2785: 
 2786:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2787:             node.nodeBnd->segment->clen  = nan("1");
 2788:             node.nodeBnd->segment->carea = nan("1");
 2789: 
 2790:          }
 2791: //          else {
 2792: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2793: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2794: //          }
 2795:          
 2796:          idxNodeBoundary++;
 2797:       }
 2798:       else {
 2799:          node.nodeBnd = nullptr; // For internal nodes
 2800: 
 2801:          if (isbnd[i] == landSegment) {
 2802:             node.nodeBnd = &landBoundaryNode;
 2803:             node.nodeBnd->segment = &landBoundarySegment;
 2804:          }
 2805:          // node.nodeBnd->node = &node;
 2806:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2807:          // // node.nodeBnd = nullptr;
 2808:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2809:         
 2810:       }
 2811: 
 2812:       // XXXX GAUSSIAN HILL VELOCITIES
 2813: #ifdef GAUSSIAN_HILL_VELOCITIES
 2814:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2815:          constexpr double rot_per = 3000.0;
 2816:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2817:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2818:       // XXXXX
 2819: #endif
 2820:    }
 2821: 
 2822:    nbp = idxNodeBoundary;
 2823: 
 2824:    printf("Processing %d sides\n", ns);
 2825:    int idxSideBoundary = 0;
 2826:    for (int i = 0; i < ns; i++)
 2827:    {
 2828:       Side &side = localSideData[i];
 2829:       side.idx = i;
 2830:       // finding the pointer to the nodes that form the side
 2831:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2832:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2833: 
 2834:       const int locidx_n1 = localNodeIndices[idx_n1];
 2835:       const int locidx_n2 = localNodeIndices[idx_n2];
 2836:       const int part_n1 =   localNodePart[idx_n1];
 2837:       const int part_n2 =   localNodePart[idx_n2];
 2838: 
 2839:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2840:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2841: 
 2842:       // Counts the number of sides connected to each node
 2843:       side.n1->numSides++;
 2844:       side.n2->numSides++;
 2845: 
 2846:       // Normal, unitary vector to the side
 2847:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2848:       side.n = normalize(side.n);
 2849: 
 2850:       // Side boundary type
 2851:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2852:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2853: 
 2854:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2855:       // If both nodes are on the boundary, then the side may be on the boundary
 2856:       {
 2857:          bool isLand = false;
 2858:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2859: 
 2860:          if (isbs > -1) {
 2861:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2862:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2863:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2864: 
 2865:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2866:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2867:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2868: 
 2869:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2870:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2871:           
 2872:             side.sideBnd->side = &side;
 2873:             idxSideBoundary++;
 2874: 
 2875:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2876:          }
 2877:          
 2878: 
 2879:       // }
 2880:       // 
 2881: 
 2882: 
 2883: 
 2884: 
 2885: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2886: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2887: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2888: //       {
 2889: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2890: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2891: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2892: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2893: // if (side.sideBnd->segment == nullptr) continue;
 2894: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2895: //          else                  side.sideBnd->segment = n2bnd->segment;
 2896: //          side.sideBnd->side = &side;
 2897: //          idxSideBoundary++;
 2898: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2899:       }
 2900:       else side.sideBnd = nullptr;
 2901: 
 2902:       nbs = idxSideBoundary;
 2903: 
 2904:       // finding the pointer to the elements that share the side
 2905:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2906:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2907: 
 2908:       if (idx_e1 > -1) {
 2909:          const int locidx_e1 = localElemIndices[idx_e1];
 2910:          const int part_e1 =  localElemPart[idx_e1];
 2911:          side.elems[0] = elems[part_e1] + locidx_e1;
 2912: 
 2913:       }
 2914:       else {
 2915:          side.elems[0] = nullptr;
 2916:       }
 2917: 
 2918:       if (idx_e2 > -1) {
 2919:          const int locidx_e2 = localElemIndices[idx_e2];
 2920:          const int part_e2 =  localElemPart[idx_e2];
 2921:          side.elems[1] = elems[part_e2] + locidx_e2;
 2922:       }
 2923:       else {
 2924:          side.elems[1] = nullptr;
 2925:       }
 2926: 
 2927:       // Compute the center of the side
 2928:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2929: 
 2930:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 2931:       side.shapiro = shapiro0;
 2932: 
 2933: #ifdef GAUSSIAN_HILL_VELOCITIES
 2934: // XXXX
 2935: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2936: constexpr double rot_per=3000.0;
 2937: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2938: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2939: // XXXXX      
 2940: #endif
 2941:       // Compute the z level at the center of the side
 2942:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2943: 
 2944:       // Compute the length of the side
 2945:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2946:       side.len = sqrt(dot(vLen, vLen));
 2947: 
 2948:    }
 2949: 
 2950:    printf("Processing %d elements\n", ne);
 2951:    for (int i = 0; i < ne; i++)
 2952:    {
 2953:       Element &elem = localElemData[i];
 2954:       elem.idx = i;
 2955:       for (int j = 0; j < i34[i]; j++) {
 2956:          const int idxNode = elnode[i*4 + j];  
 2957:          const int idxSide = elside[i*4 + j];
 2958:          
 2959:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2960:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2961: 
 2962: 
 2963: 
 2964:          // Find the neighboring element  
 2965:          if (elem.sides[j]->elems[0] == &elem) {
 2966:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2967:          }
 2968:          else {
 2969:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2970:          }
 2971:          
 2972:       }
 2973: 
 2974:       elem.i34 = i34[i];
 2975: 
 2976:       // Compute the centroid of the element and its depth
 2977:       Vector2 center = {0.0, 0.0};
 2978:       elem.depth = 0.0;
 2979:       for (int j = 0; j < i34[i]; j++) {
 2980:          center += elem.nodes[j]->p2()/i34[i];
 2981:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2982:       }
 2983:       elem.center.x = center.x;
 2984:       elem.center.y = center.y;
 2985: 
 2986: 
 2987:       
 2988:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2989:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2990: 
 2991:       elem.area = elem.computeSignedArea(); 
 2992:       elem.radius = sqrt(elem.area)/pi; 
 2993:       
 2994:       // Determines which way the normal vector to each side is oriented.
 2995:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2996:       for (int j = 0; j < i34[i]; j++)  
 2997:       {
 2998:          if (elem.sides[j]->elems[0] == &elem) {
 2999:             elem.ssign[j] =  1.0;
 3000:          }
 3001:          else {
 3002:             elem.ssign[j] = -1.0;
 3003:          }
 3004: 
 3005:       }
 3006: 
 3007:       // Derivatives of shape functions
 3008:       //  For ics=2, this is done inside element/ll frame XXX
 3009:       //  For quads, the derivative is evaluated at centroid
 3010:       const int i34 = elem.i34;
 3011:       for (int j = 0; j < i34; j++) {
 3012:          const double area = elem.area;
 3013:          const int id2 = elem.nxq(1 + j);
 3014:          const int id3 = elem.nxq(2 + j);
 3015:          const int id4 = elem.nxq(3 + j);
 3016:          if (elem.isTri()) {
 3017:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3018:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3019:             // da1/dx = (y1 - y2)/(2*area)
 3020:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3021:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3022:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3023:          }
 3024:          else  { // Quad; evaluate at centroid
 3025:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3026:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3027:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3028:          } // if Tri
 3029: 
 3030:       } // for j
 3031: 
 3032:    }
 3033: 
 3034: 
 3035:    // Processing the boundary nodes
 3036:    int idx = 0;
 3037:    for (int iseg = 0; iseg < nope; iseg++) {
 3038:       // for each segment...
 3039:       
 3040:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3041:          // for each node on the segment...
 3042: 
 3043:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3044: 
 3045:          nodeBnd->isEssentialBC = true;
 3046: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3047:          nodeBnd->elbc = 0.0;
 3048: 
 3049:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3050: 
 3051:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3052:             nodeBnd->efa[jfr] = efa[idx];
 3053:             nodeBnd->emo[jfr] = emo[idx];
 3054:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3055:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3056: 
 3057:          }
 3058: 
 3059:          idx++;
 3060:       }
 3061: 
 3062:    }
 3063: 
 3064: }
 3065: 
 3066: 
 3067: 
 3068: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3069:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3070:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3071:    // 
 3072:    // This kernel is called for all nodes.
 3073: 
 3074: 
 3075:    NODE(node1);
 3076: 
 3077: 
 3078:    node1->clearMatrixRow();
 3079:    node1->qel = 0.0;
 3080: 
 3081:    // THIS IS FOR STRUCTURES XXX
 3082:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3083: 
 3084:    
 3085:    for (int j=0; j<node1->numElements; j++) {
 3086:       // For each element connected to the node...
 3087: 
 3088:       Element *elem = node1->elements[j];
 3089: 
 3090:       // Compute the average gravity
 3091:       const double grav3 = elem->mean(&Node::grav2);
 3092: 
 3093:       // Look at the documentation for the description of the terms in the following integrals
 3094: 
 3095:       // Integral I_1 
 3096:       // \bar{\breve{H}} 
 3097:       const double hhatb = elem->mean(&Side::hhat);        
 3098: 
 3099: 
 3100:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3101: 
 3102:       const int id1 = elem->nodeLocalIdx(node1); 
 3103:       const double area = elem->area;
 3104: 
 3105:       if (elem->isTri()) {
 3106: 
 3107:          // To clarify the notation in this section: 
 3108:          //   i stands for the node under consideration (node1)
 3109:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3110:          const int id2 = elem->nxq(1 + id1);
 3111:          const int id3 = elem->nxq(2 + id1);
 3112:          Node *node2 = elem->nodes[id2];
 3113:          Node *node3 = elem->nodes[id3];
 3114: 
 3115:          const Point2 x1 = node1->p2();
 3116:          const Point2 x2 = node2->p2();
 3117:          const Point2 x3 = node3->p2();
 3118: 
 3119:          // integral of phi_i*phi_j
 3120:          const double ipp_ii = (1.0/6.0 )*area;
 3121:          const double ipp_ij = (1.0/12.0)*area;
 3122:          const double ipp_ik = (1.0/12.0)*area;
 3123: 
 3124:          // integral of [(grad phi_i) * (grad phi_j)]
 3125:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3126:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3127:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3128: 
 3129:          // Computes the different components of integral I_1 of each node with respect to node i.
 3130:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3131:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3132:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3133: 
 3134:          node1->addToSparseMatrix(node1, I1_ii);
 3135:          node1->addToSparseMatrix(node2, I1_ij); 
 3136:          node1->addToSparseMatrix(node3, I1_ik);
 3137: 
 3138:       }
 3139:       else { // Quad
 3140:          // XXX IMPLEMENT THIS
 3141:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3142:       } 
 3143: 
 3144:  
 3145:       // Integral I_4
 3146:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3147:       // Where
 3148:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3149: 
 3150:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3151:       // of U over the element.
 3152:       Vector2 Umean = {0.0, 0.0};
 3153:       for (int m=0; m<elem->i34; m++) {      
 3154:          const Side *side = elem->sides[m];
 3155: 
 3156:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3157:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3158:       }
 3159:       Umean = Umean/elem->i34;
 3160: 
 3161:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3162: 
 3163:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3164:       const double I_4_1 = dot(gradPhi_1, Umean);
 3165: 
 3166:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3167:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3168:      
 3169:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3170: 
 3171:       // Additional terms 
 3172:       double vnorm = 0.0;
 3173:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3174:          Vector3 ubed;
 3175:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3176: 
 3177:          Vector3 gradP = {0.0, 0.0, 1.0};
 3178:          for (int m=0; m < elem->i34; m++) {
 3179:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3180:            gradP += toVector3(gradP_2D, 0.0);
 3181:          }   
 3182:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3183:       } // imm==2
 3184: 
 3185:       if (elem->isTri()) {
 3186:          for (int l=0; l<3; l++) {
 3187:             double fac;
 3188: 
 3189:             Node *node = elem->nodes[l];
 3190: 
 3191:             fac = (node == node1) ? 2.0 : 1.0;
 3192:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3193:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3194:            
 3195:          }
 3196: 
 3197: 
 3198:          if (!elem->isDry) {
 3199:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3200: 
 3201:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3202:          }
 3203: 
 3204:       } // isTri
 3205:       else { // isQuad
 3206:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3207:          // for (int l=0; l<4; l++) {
 3208:          //   const Node *node = elem->nodes[l];
 3209: 
 3210:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3211:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3212: 
 3213:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3214:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3215:          // }
 3216: 
 3217:       } // isQuad
 3218: 
 3219: 
 3220:       node1->qel += (dt/elem->i34)*elem->vsource;
 3221:       
 3222: 
 3223:    } // for all elements connected to the node
 3224:    
 3225: 
 3226: 
 3227:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3228:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3229:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3230:    if (nodeBnd != nullptr)  { 
 3231:       // If it is an open boundary node...
 3232: 
 3233:       // At least one open bnd side, maybe two
 3234:       for (int l=0; l<2; l++) { 
 3235: 
 3236:          // Gets each of the sides sharing the node. 
 3237:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3238: 
 3239:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3240: 
 3241:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3242: 
 3243:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3244:          if (sideBnd != nullptr) {
 3245:             // If the side is on a boundary...
 3246: 
 3247:             // Get the boundary segment
 3248:             const BoundarySegment *sideSegment = sideBnd->segment;
 3249:             const Side *side = sideBnd->side;
 3250: 
 3251:             // Integral I_3
 3252:             if (sideSegment->ifltype != 0) {
 3253:             // Natural or Flather b.c.
 3254: 
 3255:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3256:                // especially for Flather b.c.
 3257:                double ri3 = 0.0;
 3258:                if (!side->isDry) {
 3259:                   // If the side is not dry
 3260:                   
 3261:                   // Computes the side flux of (uth, vth)
 3262:                   double Vn = 0.0;
 3263:                   for (int k = side->kb; k<nvrt-1; k++) {
 3264:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3265:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3266: 
 3267:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3268:                   }
 3269: 
 3270:                   ri3 = 0.5*side->len*Vn;
 3271:                }
 3272: 
 3273:                if (sideSegment->ifltype == -1) { // Flather 1
 3274: 
 3275:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3276:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3277: 
 3278:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3279:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3280:                   
 3281:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3282:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3283: 
 3284:                } 
 3285:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3286:                   // Reset ri3
 3287:                   ri3 = 0.0;
 3288: 
 3289:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3290: 
 3291:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3292: 
 3293:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3294:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3295: 
 3296:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3297:                   node1->addToSparseMatrix(node1, con0*2.0);
 3298:                   node1->addToSparseMatrix(node2, con0);
 3299: 
 3300:                } // if Flather or Discharge
 3301: 
 3302:                node1->qel -= thetai*dt*ri3;
 3303: 
 3304:             } // I_3
 3305:           
 3306: 
 3307:             // Integral I_5
 3308:             if(!side->isDry) {
 3309: 
 3310:                const double Unbar = dot(side->U, side->n);
 3311:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3312: 
 3313:             } // I_5
 3314: 
 3315:          } // if is boundary side
 3316: 
 3317:       } // for l
 3318: 
 3319:    } // if isbnd
 3320: 
 3321: 
 3322: }
 3323: 
 3324: 
 3325: 
 3326: extern "C" {
 3327:    __global__ void rollUpElevation(void) {
 3328: 
 3329:       NODE(node);
 3330: 
 3331:       node->eta2 += node->eta1;
 3332: 
 3333:    }
 3334: 
 3335: 
 3336:    __global__ void backtrackAllNodes(void) {
 3337: 
 3338:       // max/min # of sub-divisions
 3339:       const int ndelt_max = max(1.0, dt/dtb_min);
 3340:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3341: 
 3342:       // Removed all references to swild98 XXX
 3343:       // swild98=0.d0 !init
 3344: 
 3345: 
 3346:       SIDE(side);
 3347: 
 3348:       const int kb = side->kb;
 3349: 
 3350: 
 3351: 
 3352:       // Initialize btrack velocities to the actual velocities at the side 
 3353:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3354: 
 3355:       if (side->isDry) return;
 3356: 
 3357: 
 3358:       // Checks that at least one element is not dry
 3359:       const Element *elem1 = side->elems[0];
 3360:       const Element *elem2 = side->elems[1];
 3361: 
 3362: 
 3363:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3364:       
 3365:       // XXXXXX
 3366:       // !swild_tmp to store global coord. of the starting side
 3367:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3368:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3369:       // !Use sframe2 
 3370:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3371: 
 3372: 
 3373:       for (int k = kb; k < nvrt; k++) {
 3374:       //  Initialize (xt,yt,zt), nnel and vel.
 3375:       //  For ics=2, the coordinates are in local frames
 3376:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3377: 
 3378: 
 3379:          const int iadvf = side->iadv();  // Advection flag
 3380: 
 3381:          Point3 xt;
 3382:          if constexpr(ics==1) {
 3383:             xt = side->center3D(k); 
 3384:          }
 3385:          else // lat/lon; in side lat/lon frame
 3386:          {
 3387:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3388:          // XXX IMPLEMENT THIS
 3389:       //          xt=0.d0
 3390:       //          yt=0.d0
 3391:       //          !centroid coord. for nudging
 3392:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3393:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3394:          }  // ics
 3395: 
 3396: 
 3397:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3398:          // XXX IS THIS NECESSARY?
 3399:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3400: 
 3401:          // If on land or open boundary...
 3402:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3403:          
 3404:          const double vmag = length(toVector2(u_int));
 3405: 
 3406:          if (vmag <= velmin_btrack) {
 3407:             // No activity 
 3408: addDebugPlot(side->center, side->center, 0x00FF00);
 3409: 
 3410:             side->btu[k] = side->u2[k];
 3411:             
 3412:          } else {  // do btrack
 3413: 
 3414:             // Compute number of sub-divisions based on local gradients 
 3415:             // XXX IS THIS NECESSARY?
 3416:             double suma = 0.0;
 3417:             int icount = 0;
 3418:             for (int ii=0; ii<2; ii++) {
 3419: 
 3420:                const Element *elem = side->elems[ii];
 3421:                  
 3422:                if (elem == nullptr) continue;
 3423: 
 3424:                icount++;
 3425: 
 3426:                // Not strictly along z; in ll frame for ics=2
 3427: 
 3428:                double utmp[4];
 3429:                double vtmp[4];
 3430:                for (int jj = 0; jj < elem->i34; jj++) {
 3431: 
 3432:                   const Node *node = elem->nodes[jj];
 3433: 
 3434:                   if constexpr(ics==1) {
 3435:                      utmp[jj] = node->u2[k].x;
 3436:                      vtmp[jj] = node->u2[k].y;  
 3437:                   } else {
 3438:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3439:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3440:                   }
 3441:                } // for jj
 3442: 
 3443:                const Vector2 grad_u = elem->grad2(utmp); 
 3444:                const Vector2 grad_v = elem->grad2(vtmp);
 3445: 
 3446:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3447:             } // for ii
 3448: 
 3449:             assert(icount > 0 && "Impossible 77");
 3450: 
 3451:             // '4' is somewhat arbitrary
 3452:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3453: 
 3454:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3455:          
 3456: 
 3457:             Vector3 u_int = {0.0, 0.0, 0.0};
 3458: 
 3459:             side->btrack(k, dt, dtbk, u_int);
 3460:             side->btu[k] = toVector2(u_int);
 3461:                
 3462:          } // if vmag (do backtrack)
 3463: 
 3464:       } // for j=jmin,nvrt-1
 3465: 
 3466:    }
 3467: } // extern "C"
 3468: 
 3469: template<int nc>
 3470: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3471: 
 3472: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3473: //
 3474: // a,b,c,rhs: input vectors and are not modified by this program.
 3475: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3476: // rhs is the r.h.s.
 3477: // n: actual rank of the system.
 3478: // rows in u() and rhs();
 3479: // u: output with nc columns (transposed to rows)
 3480: // gam: a working array.
 3481: //
 3482: // NOTES:
 3483: // This is a template function that allows for different numbers of columns in the rhs vector.
 3484: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3485: 
 3486:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3487:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3488: 
 3489:    double bet = b[0];
 3490:    if constexpr (nc == 1) {
 3491:       u[0] = rhs[0]/bet;
 3492:    } else {
 3493:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3494:    }
 3495: 
 3496:    for (int j = 1; j < n; j++) {
 3497:       gam[j] = c[j-1]/bet;
 3498:       bet = b[j] - a[j]*gam[j];
 3499: 
 3500:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3501: 
 3502:       if constexpr (nc == 1) {
 3503:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3504:       } else {
 3505:          for (int k = 0; k < nc; k++) {
 3506:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3507:          }
 3508:       }
 3509:    }
 3510: 
 3511:    // Back-substitution
 3512:    for (int j=n-1; j>=1; j--) {
 3513:       if constexpr (nc == 1) {
 3514:          u[j] = u[j] - gam[j+1]*u[j-1];
 3515:       } else {
 3516:          for (int k = 0; k < nc; k++) {
 3517:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3518:          }
 3519:       }
 3520:    }
 3521: }
 3522: 
 3523: 
 3524: 
 3525: // Helper function that contains the core algorithm
 3526: template<typename XAccessor, typename YAccessor>
 3527: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3528:                                     double  yp_top, double  yp_bot, 
 3529:                                     CubicSpline &spline) {
 3530:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3531:    // 
 3532:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3533:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3534:    //
 3535:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3536:    // 
 3537:    // Inputs: 
 3538:    //            n: dimension for x etc; # of data pts (>=2);
 3539:    //            getX, getY: functions to access x,y coordinates
 3540:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3541:    //     Output: 
 3542:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3543: 
 3544:    const int n = k2 - k1 + 1;
 3545:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3546: 
 3547:    // Allocate memory for the splines
 3548:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3549:    spline.x   = new double[n];
 3550:    spline.y   = new double[n];
 3551:    spline.yp  = new double[n];
 3552:    spline.ypp = new double[n];
 3553: 
 3554:    for (int k=k1; k<=k2; k++) {
 3555:       spline.x[k] = getX(k);
 3556:       spline.y[k] = getY(k);
 3557:    }
 3558: 
 3559:    // This is to simplify expressions later
 3560:    double *x = spline.x;
 3561:    double *y = spline.y;
 3562: 
 3563:    double *a = nullptr;
 3564:    double *b = nullptr;
 3565:    double *c = nullptr;
 3566:    double *gam = nullptr;
 3567:    double *rhs = nullptr;
 3568:    
 3569: 
 3570:       a = new double[n];   // Lower diagonal
 3571:       b = new double[n];   // Diagonal
 3572:       c = new double[n];   // Upper diagonal
 3573:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3574:       rhs = new double[n]; // Right-hand side
 3575: 
 3576:    for (int k=k1; k<=k2; k++) {
 3577:       if (k == k1) {
 3578:          // Bottom level
 3579:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3580:          b[k] = (x[k+1] - x[k])/3.0;
 3581:          c[k] = b[k]/2.0;
 3582:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3583:       } else if (k == n - 1) {
 3584:          // Top level (surface)
 3585:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3586:          b[k] = (x[k] - x[k-1])/3.0;
 3587:          a[k] = b[k]/2.0;
 3588:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3589:       } else {
 3590:          // Intermediate levels
 3591:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3592:          b[k] = (x[k+1] - x[k-1])/3.0;
 3593:          a[k] = (x[k  ] - x[k-1])/6.0;
 3594:          c[k] = (x[k+1] - x[k  ])/6.0;
 3595:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3596:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3597:       }
 3598:    }
 3599: 
 3600:    // Solve the tridiagonal system
 3601:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3602:    
 3603:    spline.yp[k1] = yp_bot;
 3604:    spline.yp[k2] = yp_top;
 3605: 
 3606:    // Compute rest of 1st derivatives using the splines
 3607:    for (int k=k1+1; k<k2; k++) {
 3608:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3609:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3610:    }
 3611:    
 3612:    delete[] a;
 3613:    delete[] b;
 3614:    delete[] c;
 3615:    delete[] gam;
 3616:    delete[] rhs;
 3617: 
 3618: }
 3619: 
 3620: // Array version
 3621: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3622:                                 double y_top, double y_bot, 
 3623:                                 CubicSpline &spline) {
 3624:    auto getX = [x] (int k) { return x[k]; };
 3625:    auto getY = [y] (int k) { return y[k]; };
 3626:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3627: }
 3628: 
 3629: // Lambda version - allows custom access patterns
 3630: template<typename XFunc, typename YFunc>
 3631: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3632:                                 double y_top, double y_bot,
 3633:                                 CubicSpline &spline) {
 3634:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3635: }
 3636: 
 3637: 
 3638: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3639: {
 3640:    assert("Not implemented");
 3641: 
 3642:    return 0.0;
 3643: }
