  448: // Polynomial class
  449: template<int grade>
  450: struct Polynomial {
  451:     // Static assertion to give a clear error message at compile time
  452:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  453: };
  454: 
  455: 
  456: // Explicit specialization for grade 4
  457: template<>
  458: struct Polynomial<4> {
  459:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  460: 
  461:    // Constructor from coefficients
  462:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  463: 
  464:    __device__ __forceinline__ double eval(double x) const {
  465:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  466:    }
  467: };
