 2332: 
 2333: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2334: 
 2335:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2336:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2337:    const Node *n1 = side->n1;
 2338:    const Node *n2 = side->n2;
 2339: 
 2340:    bool n1_match = (n1->nodeBnd->segment == segment);
 2341:    bool n2_match = (n2->nodeBnd->segment == segment);
 2342: 
 2343:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2344:    if (n1_match && n2_match) {
 2345:       return 0.5;
 2346:    } else if (n1_match) {
 2347:       return 1.0;
 2348:    } else if (n2_match) {
 2349:       return 0.0;
 2350:    }
 2351:    return 0.0;
 2352: }
 2353: 
 2354: 
 2355: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2356: 
 2357:    const double w1 = getBoundaryArrayValueWeight();
 2358:    const double w2 = 1.0 - w1;
 2359:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2360:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2361: 
 2362:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2363: }
 2364: 
 2365: 
 2366: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2367:    const double w1 = getBoundaryArrayValueWeight();
 2368:    const double w2 = 1.0 - w1;
 2369:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2370:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2371: 
 2372:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2373: }
