 1059: // This struct is used to store the boundary information for a node.
 1060: struct NodeBoundary {   
 1061:    BoundarySegment *segment;
 1062:    Node *node;
 1063:    
 1064:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1065:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1066: 
 1067:    bool isLand;
 1068: 
 1069:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1070:    double elbc;   // Elevation boundary condition
 1071:    double eth;    // Elevation time history
 1072: 
 1073:    double eta_mean; // Mean elevation at nodes
 1074: 
 1075:    bool isEssentialBC;
 1076: 
 1077:    Vector2 uth[nvrt];  // "Time history" velocity
 1078: 
 1079:    // Arrays for harmonic constituents (if needed)
 1080:    double  emo[nbfr];  // Elevation amplitude
 1081:    double  efa[nbfr];  // Elevation phase
 1082:    Vector2 umo[nbfr];  // velocity amplitude
 1083:    Vector2 ufa[nbfr];  // velocity phase
 1084: 
 1085: 
 1086:    NodeBoundary(void) {
 1087:       isLand = false;
 1088:    }
 1089:    NodeBoundary(bool _isLand) {
 1090:       isLand = _isLand;
 1091:    }
 1092: 
 1093:    
 1094:    __forceinline__ __device__ int numSidesForAverage() const {
 1095:    // Returns the number of sides that are connected to the node and have the same segment.
 1096:    // This is used to compute the average velocity at the node for open boundary nodes.
 1097:       int res = 0;
 1098:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1099:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1100: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1101:       return res;
 1102:    }
 1103: 
 1104: 
 1105:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1106:       assert(index == 0 || index == 1); 
 1107:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1108:    }
 1109: 
 1110: 
 1111: };
