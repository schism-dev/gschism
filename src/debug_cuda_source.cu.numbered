 1845: __device__ __inline__ double min3(double a, double b, double c) {
 1846:    return min(a, min(b, c));
 1847: }
 1848: 
 1849: __device__ __inline__ double max3(double a, double b, double c) {
 1850:    return max(a, max(b, c));
 1851: }
 1852: 
 1853: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1854:    return min(a, min(b, min(c, d)));
 1855: }
