 6878: //                   do jj=1,natrm
 6879: //                     if(ntrs(jj)<=0) cycle
 6880: 
 6881: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 6882: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 6883: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 6884: //                       enddo !ll
 6885: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 6886: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
