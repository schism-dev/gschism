 7788: __global__ void printMatrix(bool full) {
 7789:    // Debugging: print the matrix
 7790: 
 7791:    const int size = mesh->np;
 7792:    double sum = 0.0;
 7793:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7794:       const Node *node = mesh->localNodeData + idx_node;
 7795:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7796:       for (int j = 0; j < node->numNodes; j++) {
 7797:          Node* nbNode = node->nodes[j];
 7798:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7799:          sum += node->coeffMatrix[j];
 7800:       }
 7801:       if (full) printf("]\n");
 7802: 
 7803: 
 7804:    }
 7805:    if (!full) printf("sum=%lf\n", sum);
 7806: }
 7807: 
 7808: 
 7809: __global__ void returnMatrix(double *res) {
 7810:    // Debugging: returns the matrix as a CuPy array
 7811: 
 7812:    const int size = mesh->np;
 7813:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7814:       const Node *node = mesh->localNodeData + idx_node;
 7815:       res[idx_node*size + idx_node] = node->coeffDiag;
 7816:       for (int j = 0; j < node->numNodes; j++) {
 7817:          Node* nbNode = node->nodes[j];
 7818:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7819:       }
 7820: 
 7821:    }
 7822:    
 7823: }
 7824: 
 7825: 
 7826: __global__ void computeMatrixProductAndDotProducts() {
 7827:    // Computes A*p, r'Mr and p'Ap
 7828: 
 7829:    // 1) shared buffer: first half for rMr, second for pAp
 7830:    __shared__ double sdata[2*BLOCK_SIZE];
 7831:    double* s_rMr = sdata;
 7832:    double* s_pAp = sdata + BLOCK_SIZE;
 7833: 
 7834:    const int tid = threadIdx.x;
 7835: 
 7836:    double l_pAp = 0.0;
 7837: 
 7838:    s_rMr[tid] = 0.0;
 7839:    s_pAp[tid] = 0.0;
 7840: 
 7841:    // 2) get your node pointer
 7842:    // NODE(node);   
 7843:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7844:    Node *node = &(mesh->localNodeData[idx_node]); 
 7845:       if (idx_node < mesh->np) {
 7846: 
 7847:       const double diag = node->coeffDiag;
 7848:       const double r    = node->mR;
 7849:       const double p    = node->mP;  
 7850: 
 7851:       // apply preconditioner on the fly:
 7852:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7853: 
 7854:       // 4) compute Ap = A.p
 7855:       double Ap = node->coeffDiag * node->mP;
 7856:       for (int j = 0; j < node->numNodes; ++j) {
 7857:          const Node *nbNode = node->nodes[j];
 7858:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7859: 
 7860:       }
 7861: 
 7862:       node->mAp = Ap;
 7863:       
 7864: 
 7865:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7866:       // const double l_rMr = r*Mr;  // r'Mr
 7867:       l_pAp = p*Ap;  // p'Ap
 7868: 
 7869: 
 7870:    }
 7871: 
 7872:    // 6) write into shared mem
 7873:    // s_rMr[tid] = l_rMr;
 7874:    s_pAp[tid] = l_pAp;
 7875: 
 7876:    __syncthreads();
 7877: 
 7878:    // 7) block-wide tree reduction
 7879:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7880:       if (tid < stride)  {
 7881:          s_pAp[tid] += s_pAp[tid + stride];
 7882:       }
 7883:       __syncthreads();
 7884:    }
 7885: 
 7886:    // 8) thread 0 atomically accumulates into the globals
 7887:    // XXX: This is slower than it needs to be, but it is simple and works
 7888:    if (tid == 0) {
 7889:       atomicAdd(pAp, s_pAp[0]);
 7890:    }
 7891: 
 7892: 
 7893: }
 7894: 
 7895: 
 7896: __global__ void updateSolutionAndDotProducts(void) {
 7897:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7898: 
 7899:    const int tid = threadIdx.x;
 7900: 
 7901:    s_rMr[tid] = 0.0;
 7902: 
 7903:    // get node & bounds-check:
 7904:    NODE(node);
 7905: 
 7906:    
 7907:    // Compute alpha
 7908:    const double alpha = (*rMr_old)/(*pAp); 
 7909: 
 7910: 
 7911:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7912: 
 7913: 
 7914:    // load scalars
 7915:    const double diag = node->coeffDiag;
 7916:    const double p    = node->mP;
 7917:    const double Ap   = node->mAp;
 7918:    const double x    = node->mX;
 7919:    const double r    = node->mR;
 7920:    
 7921:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7922: 
 7923:    // 1) update solution & residual
 7924:    const double x_new = x + alpha*p;
 7925:    const double r_new = r - alpha*Ap;
 7926:    node->mX = x_new;
 7927:    node->mR = r_new;
 7928: 
 7929:    // 2) apply Jacobi preconditioner on the fly
 7930:    const double Mr_new = r_new/diag;
 7931: 
 7932: 
 7933:    // 3) local contributions for the two dot-products
 7934:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7935: 
 7936:    // 4) write into shared-mem
 7937:    s_rMr[tid] = l_rMr;
 7938: 
 7939:    __syncthreads();
 7940: 
 7941: 
 7942:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7943:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7944:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7945:       __syncthreads();
 7946:    }
 7947: 
 7948:    // 6) thread 0 atomically folds into the global accumulators
 7949:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7950: 
 7951: 
 7952: }
 7953: 
 7954: 
 7955: __global__ void updateSearchDirection() {
 7956: 
 7957:     NODE(node);
 7958: 
 7959:     // recompute z on-the-fly
 7960:     const double z = node->mR / node->coeffDiag;
 7961:     const double p = node->mP;
 7962: 
 7963:     const double beta = (*rMr_new)/(*rMr_old);
 7964: 
 7965: 
 7966:     // p =z + beta*p
 7967:     node->mP = z + beta*p;
 7968: 
 7969: }
 7970: 
 7971: __global__ void initializeScalars(double *scalars) {
 7972: 
 7973:    // These point to a cupy array in the host code
 7974:    rMr_old = scalars + 0;
 7975:    rMr_new = scalars + 1;
 7976:    pAp     = scalars + 2;
 7977: }
 7978: 
 7979: __global__ void initializePreconditionedResidual(void) {
 7980: 
 7981:     __shared__ double s_rMr[BLOCK_SIZE];  
 7982: 
 7983:     s_rMr[threadIdx.x] = 0.0;
 7984: 
 7985:     NODE_ALL(node, valid);
 7986:     const int tid = threadIdx.x;
 7987:     // For the first iteration:
 7988:     // 1. Initial solution x = 0 (already set)
 7989:     // 2. Initial residual r = b (stored in qel)
 7990:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7991: 
 7992: // XXX we should use the guess solution here    
 7993: 
 7994:     double l_rMr = 0.0;
 7995:     if (valid) {
 7996:       // Set initial residual r = b (from qel)
 7997:       node->mR = node->qel;
 7998: 
 7999:       // Compute z = M^-1 * r (preconditioned residual)
 8000:       const double z = node->mR / node->coeffDiag;
 8001: 
 8002:       // Set initial search direction p = z
 8003:       node->mP = z;
 8004: 
 8005:       // Initialize other variables needed for CG
 8006:       node->mX = 0.0;  // Initial solution
 8007:       node->mAp = 0.0; // Will be computed in first iteration
 8008: 
 8009: 
 8010:       // Computes the first r'Mr (reduction)
 8011:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8012:     }
 8013:     // 4) write into shared-mem
 8014:     s_rMr[tid] = l_rMr;
 8015: 
 8016:     __syncthreads();
 8017: 
 8018: 
 8019:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8020:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8021:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8022:         __syncthreads();
 8023:     }
 8024: 
 8025:     // 6) thread 0 atomically folds into the global accumulators
 8026:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8027: 
 8028:     *rMr_old = 0.0;
 8029:     *pAp = 0.0;
 8030: }
 8031: 
 8032: 
 8033: 
 8034: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8035:    Element *elems = mesh->localElemData;
 8036: 
 8037:    *addr = elems;
 8038:    *sizeElement = sizeof(Element);
 8039:    switch (varCode) {
 8040:       case (int)VarCode::z:
 8041:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8042:          *sizeType = sizeof(double);
 8043:          break;
 8044:       case (int)VarCode::x:
 8045:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8046:          *sizeType = sizeof(Vector2);
 8047:          break;
 8048:       case (int)VarCode::area:
 8049:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8050:          *sizeType = sizeof(double);
 8051:          break;
 8052:       case (int)VarCode::depth:
 8053:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8054:          *sizeType = sizeof(double);
 8055:          break;
 8056:       case (int)VarCode::radius:
 8057:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8058:          *sizeType = sizeof(double);
 8059:          break;
 8060:       case (int)VarCode::lonlat:
 8061:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 8062:          *sizeType = sizeof(double);
 8063:          break;
 8064:       case (int)VarCode::ghat:
 8065:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8066:          *sizeType = sizeof(Vector2);
 8067:          break;
 8068:       case (int)VarCode::kb:
 8069:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8070:          *sizeType = sizeof(int);
 8071:          break;
 8072:       case (int)VarCode::isdry:
 8073:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8074:          *sizeType = sizeof(int);
 8075:          break;            
 8076:       case (int)VarCode::w:
 8077:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8078:          *sizeType = sizeof(double);
 8079:          break;
 8080:       case (int)VarCode::FaceIndices:
 8081:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8082:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8083:          *sizeType = sizeof(Node);
 8084:          break;
 8085:       default:
 8086:          *offset = -1;
 8087:    }
 8088: }
