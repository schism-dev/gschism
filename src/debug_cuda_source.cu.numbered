 9518: __global__ void printMatrix(bool full) {
 9519:    // Debugging: print the FEM matrix row for each local node
 9520: 
 9521:    const int size = mesh->np;
 9522:    double sum = 0.0;
 9523: 
 9524:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9525:       const Node *node = mesh->localNodeData + idx_node;
 9526: 
 9527:       if (full)
 9528:          printf("idx_node = %d [%d] diag=%lf, [",
 9529:                 idx_node, node->numNodes, *(node->coeffDiag));
 9530: 
 9531:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9532:       for (int k = 0; k < node->numNodes + 1; k++)
 9533:          sum += node->coeffRow[k];
 9534: 
 9535:       for (int j = 0; j < node->numNodes; j++) {
 9536:          const Node *nbNode = node->nodes[j];
 9537:          const double aij = node->coeffRow[node->csrSlot[j]];
 9538:          if (full && aij != 0.0)
 9539:             printf("%d:%f,  ", nbNode->idx, aij);
 9540:       }
 9541: 
 9542:       if (full) printf("]\n");
 9543:    }
 9544: 
 9545:    if (!full) printf("sum=%lf\n", sum);
 9546: }
 9547: 
