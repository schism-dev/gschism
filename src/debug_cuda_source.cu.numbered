 7746: 
 7747: __global__ void computeMatrixProductAndDotProducts() {
 7748:    // Computes A*p, r'Mr and p'Ap
 7749: 
 7750:    // 1) shared buffer: first half for rMr, second for pAp
 7751:    __shared__ double sdata[2*BLOCK_SIZE];
 7752:    double* s_rMr = sdata;
 7753:    double* s_pAp = sdata + BLOCK_SIZE;
 7754: 
 7755:    const int tid = threadIdx.x;
 7756: 
 7757:    double l_pAp = 0.0;
 7758: 
 7759:    s_rMr[tid] = 0.0;
 7760:    s_pAp[tid] = 0.0;
 7761: 
 7762:    // 2) get your node pointer
 7763:    // NODE(node);   
 7764:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7765:    Node *node = &(mesh->localNodeData[idx_node]); 
 7766:       if (idx_node < mesh->np) {
 7767: 
 7768:       const double diag = node->coeffDiag;
 7769:       const double r    = node->mR;
 7770:       const double p    = node->mP;  
 7771: 
 7772:       // apply preconditioner on the fly:
 7773:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7774: 
 7775:       // 4) compute Ap = A.p
 7776:       double Ap = node->coeffDiag * node->mP;
 7777:       for (int j = 0; j < node->numNodes; ++j) {
 7778:          const Node *nbNode = node->nodes[j];
 7779:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7780: 
 7781:       }
 7782: 
 7783:       node->mAp = Ap;
 7784:       
 7785: 
 7786:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7787:       // const double l_rMr = r*Mr;  // r'Mr
 7788:       l_pAp = p*Ap;  // p'Ap
 7789: 
 7790: 
 7791:    }
 7792: 
 7793:    // 6) write into shared mem
 7794:    // s_rMr[tid] = l_rMr;
 7795:    s_pAp[tid] = l_pAp;
 7796: 
 7797:    __syncthreads();
 7798: 
 7799:    // 7) block-wide tree reduction
 7800:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7801:       if (tid < stride)  {
 7802:          s_pAp[tid] += s_pAp[tid + stride];
 7803:       }
 7804:       __syncthreads();
 7805:    }
 7806: 
 7807:    // 8) thread 0 atomically accumulates into the globals
 7808:    // XXX: This is slower than it needs to be, but it is simple and works
 7809:    if (tid == 0) {
 7810:       atomicAdd(pAp, s_pAp[0]);
 7811:    }
 7812: 
 7813: 
 7814: }
 7815: 
 7816: 
 7817: __global__ void updateSolutionAndDotProducts(void) {
 7818:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7819: 
 7820:    const int tid = threadIdx.x;
 7821: 
 7822:    s_rMr[tid] = 0.0;
 7823: 
 7824:    // get node & bounds-check:
 7825:    NODE(node);
 7826: 
 7827:    
 7828:    // Compute alpha
 7829:    const double alpha = (*rMr_old)/(*pAp); 
 7830: 
 7831: 
 7832:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7833: 
 7834: 
 7835:    // load scalars
 7836:    const double diag = node->coeffDiag;
 7837:    const double p    = node->mP;
 7838:    const double Ap   = node->mAp;
 7839:    const double x    = node->mX;
 7840:    const double r    = node->mR;
 7841:    
 7842:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7843: 
 7844:    // 1) update solution & residual
 7845:    const double x_new = x + alpha*p;
 7846:    const double r_new = r - alpha*Ap;
 7847:    node->mX = x_new;
 7848:    node->mR = r_new;
 7849: 
 7850:    // 2) apply Jacobi preconditioner on the fly
 7851:    const double Mr_new = r_new/diag;
 7852: 
 7853: 
 7854:    // 3) local contributions for the two dot-products
 7855:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7856: 
 7857:    // 4) write into shared-mem
 7858:    s_rMr[tid] = l_rMr;
 7859: 
 7860:    __syncthreads();
 7861: 
 7862: 
 7863:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7864:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7865:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7866:       __syncthreads();
 7867:    }
 7868: 
 7869:    // 6) thread 0 atomically folds into the global accumulators
 7870:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7871: 
 7872: 
 7873: }
 7874: 
 7875: 
 7876: __global__ void updateSearchDirection() {
 7877: 
 7878:     NODE(node);
 7879: 
 7880:     // recompute z on-the-fly
 7881:     const double z = node->mR / node->coeffDiag;
 7882:     const double p = node->mP;
 7883: 
 7884:     const double beta = (*rMr_new)/(*rMr_old);
 7885: 
 7886: 
 7887:     // p =z + beta*p
 7888:     node->mP = z + beta*p;
 7889: 
 7890: }
 7891: 
 7892: __global__ void initializeScalars(double *scalars) {
 7893: 
 7894:    // These point to a cupy array in the host code
 7895:    rMr_old = scalars + 0;
 7896:    rMr_new = scalars + 1;
 7897:    pAp     = scalars + 2;
 7898: }
 7899: 
 7900: __global__ void initializePreconditionedResidual(void) {
 7901: 
 7902:     __shared__ double s_rMr[BLOCK_SIZE];  
 7903: 
 7904:     s_rMr[threadIdx.x] = 0.0;
 7905: 
 7906:     NODE_ALL(node, valid);
 7907:     const int tid = threadIdx.x;
 7908:     // For the first iteration:
 7909:     // 1. Initial solution x = 0 (already set)
 7910:     // 2. Initial residual r = b (stored in qel)
 7911:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7912: 
 7913: // XXX we should use the guess solution here    
 7914: 
 7915:     double l_rMr = 0.0;
 7916:     if (valid) {
 7917:       // Set initial residual r = b (from qel)
 7918:       node->mR = node->qel;
 7919: 
 7920:       // Compute z = M^-1 * r (preconditioned residual)
 7921:       const double z = node->mR / node->coeffDiag;
 7922: 
 7923:       // Set initial search direction p = z
 7924:       node->mP = z;
 7925: 
 7926:       // Initialize other variables needed for CG
 7927:       node->mX = 0.0;  // Initial solution
 7928:       node->mAp = 0.0; // Will be computed in first iteration
 7929: 
 7930: 
 7931:       // Computes the first r'Mr (reduction)
 7932:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7933:     }
 7934:     // 4) write into shared-mem
 7935:     s_rMr[tid] = l_rMr;
 7936: 
 7937:     __syncthreads();
 7938: 
 7939: 
 7940:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7941:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7942:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7943:         __syncthreads();
 7944:     }
 7945: 
 7946:     // 6) thread 0 atomically folds into the global accumulators
 7947:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7948: 
 7949:     *rMr_old = 0.0;
 7950:     *pAp = 0.0;
 7951: }
 7952: 
 7953: 
 7954: 
 7955: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7956:    Element *elems = mesh->localElemData;
 7957: 
 7958:    *addr = elems;
 7959:    *sizeElement = sizeof(Element);
 7960:    switch (varCode) {
 7961:       case (int)VarCode::z:
 7962:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7963:          *sizeType = sizeof(double);
 7964:          break;
 7965:       case (int)VarCode::x:
 7966:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7967:          *sizeType = sizeof(Vector2);
 7968:          break;
 7969:       case (int)VarCode::area:
 7970:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7971:          *sizeType = sizeof(double);
 7972:          break;
 7973:       case (int)VarCode::depth:
 7974:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7975:          *sizeType = sizeof(double);
 7976:          break;
 7977:       case (int)VarCode::radius:
 7978:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7979:          *sizeType = sizeof(double);
 7980:          break;
 7981:       case (int)VarCode::lonlat:
 7982:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7983:          *sizeType = sizeof(double);
 7984:          break;
 7985:       case (int)VarCode::ghat:
 7986:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7987:          *sizeType = sizeof(Vector2);
 7988:          break;
 7989:       case (int)VarCode::kb:
 7990:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7991:          *sizeType = sizeof(int);
 7992:          break;
 7993:       case (int)VarCode::isdry:
 7994:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7995:          *sizeType = sizeof(int);
 7996:          break;            
 7997:       case (int)VarCode::w:
 7998:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7999:          *sizeType = sizeof(double);
 8000:          break;
 8001:       case (int)VarCode::FaceIndices:
 8002:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8003:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8004:          *sizeType = sizeof(Node);
 8005:          break;
 8006:       default:
 8007:          *offset = -1;
 8008:    }
 8009: }
 8010: 
