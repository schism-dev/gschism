 1381:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1382:       // Compute the different time ramps used in the code 
 1383:       // This function is performed by just one thread
 1384: 
 1385:       if constexpr(ibc == 0) {
 1386:          if (drampbc > 0.0) {
 1387:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1388:          } else {
 1389:             rampbc = 1.0;
 1390:          }
 1391: 
 1392:          if (nws != 0 && drampwind > 0.0) {
 1393:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1394:          } else {
 1395:             rampwind = 1.0;
 1396:          }
 1397:       }
 1398: 
 1399:       if (drampwafo > 0.0) {
 1400:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1401:       } else {
 1402:          rampwafo = 1.0;
 1403:       }
 1404: 
 1405:       // For source/sinks
 1406:       if (if_source && dramp_ss > 0.0) {
 1407:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1408:       } else {
 1409:          ramp_ss = 1.0;
 1410:       }
 1411: 
 1412:       if (dramp > 0.0) {
 1413:          ramp = tanh(2.0*time/86400.0/dramp);
 1414:       } else {
 1415:          ramp = 1.0;
 1416:       }
 1417: 
 1418:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1419:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1420:    }
 1421:       
