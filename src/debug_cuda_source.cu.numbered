 5344: __device__ __forceinline__ int localIdx(Node* node) {
 5345:    const int part = node->part;
 5346:    const int localIdx = node - mesh->nodes[part]; // The local index of the node in the partition is computed as the difference between the node and the start of the node memory block in the partition
 5347:    return localIdx;
 5348: }
