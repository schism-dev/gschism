 1350: __device__ __inline__ double min3(double a, double b, double c) {
 1351:    return min(a, min(b, c));
 1352: }
 1353: 
 1354: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1355:    return min(a, min(b, min(c, d)));
 1356: }
