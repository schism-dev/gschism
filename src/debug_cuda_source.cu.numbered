 1870: 
 1871: __device__ __forceinline__ double Element::centerZ(void) const { 
 1872: // Z coordinate of the element center in the global cartesian coordinates.
 1873: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 1874: 
 1875:    if constexpr(ics==1) { 
 1876:       return 0.0; 
 1877:    } else { 
 1878:       if (isTri()) {
 1879:          return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz); 
 1880:       } else {
 1881:          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz); 
 1882:       }
 1883: 
 1884:    } 
 1885: }
