 1297:    __device__ void setFrame(void) {
 1298:       if constexpr(ics == 1) return;
 1299: 
 1300:       double lat, lon;
 1301:       const Point3 p = toPoint3(center, centerZ());
 1302: 
 1303:       // Compute the latitude and longitude of the element center
 1304:       computeLatLon(p, lat, lon);
 1305: 
 1306:       frame.update(lat, lon);        
 1307:    }
