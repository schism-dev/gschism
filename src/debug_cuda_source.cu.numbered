 4551: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4552:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4553:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4554:                 int *isdel, int *isidenode, int *isbnd,
 4555:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4556:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4557:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4558:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4559:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4560:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4561:                 double *drag, double *roughness,
 4562:                 double *emo, double *efa, 
 4563:                 double *umo, double *ufa, 
 4564:                 double *vmo, double *vfa) {
 4565: 
 4566:    printf("Populating mesh for partition %d\n", partNum);
 4567: 
 4568:    // XXXXXX THIS function does almost nothing. 
 4569: 
 4570:    nbs = *sharedIdxSideBoundary + 1;
 4571:    nbp = *sharedIdxNodeBoundary + 1;
 4572: 
 4573:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4574: 
 4575: }
