 1387: struct Side {
 1388: 
 1389:    // Geometry information
 1390:    int idx;               // Index of the side
 1391:    Node *n1, *n2;
 1392:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1393: 
 1394:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1395:    Vector2 center;        // Location of side center. 
 1396:    double zc[nvrt];       // Side center z-coord at each vertical level
 1397: 
 1398:    Frame<ics> frame;
 1399:    
 1400:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1401:                           // this is nullptr
 1402:    
 1403:    int16_t kb;            // Bottom index of the side
 1404:    bool isDry;            // True if the side is dry
 1405:  
 1406:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1407: 
 1408:    Tracers tracers[nvrt]; // Tracer concentrations at nodes
 1409: 
 1410:    // Physical information
 1411:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1412:    Vector2 btu[nvrt];           // Back-tracked velocity
 1413:    Vector2 U;                   // Vertically averaged velocity vector  
 1414: 
 1415:    Vector2 nuGradU[nvrt];          // nu*grad u
 1416: 
 1417:    Vector2 bcc[nvrt];           // Baroclinic term
 1418:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1419: 
 1420:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1421:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1422:    Vector2 gradPr;               // Gradient of pressure
 1423:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1424: 
 1425: 
 1426:    double hhat;                 // \breve{H} in notes
 1427: 
 1428:    double shapiro;
 1429: 
 1430:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1431: 
 1432:    double coriolis;             // Coriolis parameter
 1433: 
 1434:    // Vegetation parameters
 1435:    double veg_c2;
 1436:    double veg_beta;
 1437: 
 1438:    // Bottom drag parameters.
 1439:    double chi;
 1440:    double chi2;
 1441: 
 1442:    __inline__ __device__ Point2 outputCoords(void) const;
 1443: 
 1444:    __inline__ __device__ double x(double t) const;
 1445:    __inline__ __device__ double y(double t) const;
 1446:    __inline__ __device__ double z(double t) const;
 1447:    __inline__ __device__ double lon(void) const;
 1448:    __inline__ __device__ double lat(void) const;
 1449:    __inline__ __device__ Point2 p2_t(double t) const;
 1450: 
 1451:    __device__ void setFrame(void) {
 1452:       if constexpr(ics == 1) return;
 1453: 
 1454:       double lat, lon;
 1455:       const Point3 p = toPoint3(center, centerZ());
 1456: 
 1457:       // Compute the latitude and longitude of the element center
 1458:       computeLatLon(p, lat, lon);
 1459: 
 1460:       frame.update(lat, lon);        
 1461:    }
 1462:    
 1463: 
 1464:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1465:    // If ics == 2, convert the global point to the local frame of the side
 1466:       
 1467:       if constexpr (ics == 1) {
 1468:          return p;
 1469:       } else {
 1470:          const Point3 c = {center.x, center.y, centerZ()};
 1471:          const Point3 local = frame.G2L(p - c);
 1472:          return local;
 1473:       }
 1474:    }
 1475: 
 1476:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1477:       if constexpr (ics == 1) {
 1478:          return p;
 1479:       } else {
 1480:          const Point3 c = {center.x, center.y, centerZ()};
 1481:          return c + frame.L2G(p);
 1482:       }
 1483:    }
 1484: 
 1485: 
 1486:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1487:       if constexpr(ics == 1) return v;
 1488:       else return v_frame.projHorVec(v, frame);
 1489:    }
 1490: 
 1491:    __inline__ __device__ double centerZ(void)      const;
 1492:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1493:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1494:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1495:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1496: 
 1497:    __inline__ __device__ Side* neigh(int index) const { 
 1498:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1499:       assert(index >= 0 && index < 4); 
 1500:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1501: 
 1502:       const int ielem = index & 1;           // 0 or 1
 1503:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1504: 
 1505:       const Element* elem = elems[ielem];
 1506: 
 1507:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1508: 
 1509:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1510: 
 1511:    }
 1512: 
 1513:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1514: 
 1515:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1516: 
 1517:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1518:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1519:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1520:    __inline__ __device__ int iadv(void) const;
 1521: 
 1522:    __inline__ __device__ double grav3(void) const;
 1523:    
 1524:    __inline__ __device__ double eta2(void) const;
 1525:    __inline__ __device__ double eta1(void) const;
 1526:    __inline__ __device__ double w2(int k) const;
 1527:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1528:    __inline__ __device__ double depth(void) const;
 1529:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1530:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1531: 
 1532:    __inline__ __device__ double dfv(int k) const;
 1533: 
 1534:    __inline__ __device__ double veg_h(void)  const;
 1535:    __inline__ __device__ double veg_nv(void) const;
 1536:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1537:    __inline__ __device__ double veg_alpha3D(int k) const;
 1538:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1539: 
 1540:    __inline__ __device__ double Cd(void) const;
 1541: 
 1542:    __inline__ __device__ Vector2 tau(void) const;
 1543: 
 1544:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1545:    
 1546: 
 1547:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1548:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1549:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1550:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1551:    } 
 1552:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1553:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1554:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1555:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1556: 
 1557:    // Get valid starting element (for backtracking)
 1558:    __inline__ __device__ Element* getStartElement() {
 1559:       return elems[0] ? elems[0] : elems[1];
 1560:    }
 1561: 
 1562:    
 1563:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1564:       // Given an element, returns the other element that shares this side
 1565:       return (elems[0] == elem) ? elems[1] : elems[0];
 1566:    }
 1567: 
 1568:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1569:       // Given a node, returns the other node that shares this side
 1570:       return (n1 == node) ? n2 : n1;
 1571:    }
 1572:  
 1573:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1574: 
 1575: 
 1576: 
 1577: 
 1578: };
