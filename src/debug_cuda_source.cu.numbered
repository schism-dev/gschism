 8356: #ifdef OLD_PCG_SOLVER
 8357: __global__ void computeMatrixProductAndDotProducts() {
 8358:    // Computes A*p, r'Mr and p'Ap
 8359: 
 8360:    // 1) shared buffer: first half for rMr, second for pAp
 8361:    __shared__ double sdata[2*BLOCK_SIZE];
 8362:    double* s_rMr = sdata;
 8363:    double* s_pAp = sdata + BLOCK_SIZE;
 8364: 
 8365:    const int tid = threadIdx.x;
 8366: 
 8367:    double l_pAp = 0.0;
 8368: 
 8369:    s_rMr[tid] = 0.0;
 8370:    s_pAp[tid] = 0.0;
 8371: 
 8372:    // 2) get your node pointer
 8373:    // NODE(node);   
 8374:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8375:    Node *node = &(mesh->localNodeData[idx_node]); 
 8376:       if (idx_node < mesh->np) {
 8377: 
 8378:       const double diag = node->coeffDiag;
 8379:       const double r    = node->mR;
 8380:       const double p    = node->mP;  
 8381: 
 8382:       // apply preconditioner on the fly:
 8383:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8384: 
 8385:       // 4) compute Ap = A.p
 8386:       double Ap = node->coeffDiag * node->mP;
 8387:       for (int j = 0; j < node->numNodes; ++j) {
 8388:          const Node *nbNode = node->nodes[j];
 8389:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8390: 
 8391:       }
 8392: 
 8393:       node->mAp = Ap;
 8394:       
 8395: 
 8396:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8397:       // const double l_rMr = r*Mr;  // r'Mr
 8398:       l_pAp = p*Ap;  // p'Ap
 8399: 
 8400: 
 8401:    }
 8402: 
 8403:    // 6) write into shared mem
 8404:    // s_rMr[tid] = l_rMr;
 8405:    s_pAp[tid] = l_pAp;
 8406: 
 8407:    __syncthreads();
 8408: 
 8409:    // 7) block-wide tree reduction
 8410:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8411:       if (tid < stride)  {
 8412:          s_pAp[tid] += s_pAp[tid + stride];
 8413:       }
 8414:       __syncthreads();
 8415:    }
 8416: 
 8417:    // 8) thread 0 atomically accumulates into the globals
 8418:    // XXX: This is slower than it needs to be, but it is simple and works
 8419:    if (tid == 0) {
 8420:       atomicAdd(pAp, s_pAp[0]);
 8421:    }
 8422: 
 8423: 
 8424: }
 8425: 
 8426: 
 8427: __global__ void updateSolutionAndDotProducts(void) {
 8428:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8429: 
 8430:    const int tid = threadIdx.x;
 8431: 
 8432:    s_rMr[tid] = 0.0;
 8433: 
 8434:    // get node & bounds-check:
 8435:    NODE(node);
 8436: 
 8437:    
 8438:    // Compute alpha
 8439:    const double alpha = (*rMr_old)/(*pAp); 
 8440: 
 8441: 
 8442:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8443: 
 8444: 
 8445:    // load scalars
 8446:    const double diag = node->coeffDiag;
 8447:    const double p    = node->mP;
 8448:    const double Ap   = node->mAp;
 8449:    const double x    = node->mX;
 8450:    const double r    = node->mR;
 8451:    
 8452:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8453: 
 8454:    // 1) update solution & residual
 8455:    const double x_new = x + alpha*p;
 8456:    const double r_new = r - alpha*Ap;
 8457:    node->mX = x_new;
 8458:    node->mR = r_new;
 8459: 
 8460:    // 2) apply Jacobi preconditioner on the fly
 8461:    const double Mr_new = r_new/diag;
 8462: 
 8463: 
 8464:    // 3) local contributions for the two dot-products
 8465:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8466: 
 8467:    // 4) write into shared-mem
 8468:    s_rMr[tid] = l_rMr;
 8469: 
 8470:    __syncthreads();
 8471: 
 8472: 
 8473:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8474:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8475:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8476:       __syncthreads();
 8477:    }
 8478: 
 8479:    // 6) thread 0 atomically folds into the global accumulators
 8480:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8481: 
 8482: 
 8483: }
 8484: 
 8485: 
 8486: __global__ void updateSearchDirection() {
 8487: 
 8488:     NODE(node);
 8489: 
 8490:     // recompute z on-the-fly
 8491:     const double z = node->mR / node->coeffDiag;
 8492:     const double p = node->mP;
 8493: 
 8494:     const double beta = (*rMr_new)/(*rMr_old);
 8495: 
 8496: 
 8497:     // p =z + beta*p
 8498:     node->mP = z + beta*p;
 8499: 
 8500: }
 8501: 
 8502: __global__ void initializeScalars(double *scalars) {
 8503: 
 8504:    // These point to a cupy array in the host code
 8505:    rMr_old = scalars + 0;
 8506:    rMr_new = scalars + 1;
 8507:    pAp     = scalars + 2;
 8508: }
 8509: 
 8510: __global__ void initializePreconditionedResidual(void) {
 8511: 
 8512:     __shared__ double s_rMr[BLOCK_SIZE];  
 8513: 
 8514:     s_rMr[threadIdx.x] = 0.0;
 8515: 
 8516:     NODE_ALL(node, valid);
 8517:     const int tid = threadIdx.x;
 8518:     // For the first iteration:
 8519:     // 1. Initial solution x = 0 (already set)
 8520:     // 2. Initial residual r = b (stored in qel)
 8521:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8522: 
 8523: // XXX we should use the guess solution here    
 8524: 
 8525:     double l_rMr = 0.0;
 8526:     if (valid) {
 8527:       // Set initial residual r = b (from qel)
 8528:       node->mR = node->qel;
 8529: 
 8530:       // Compute z = M^-1 * r (preconditioned residual)
 8531:       const double z = node->mR / node->coeffDiag;
 8532: 
 8533:       // Set initial search direction p = z
 8534:       node->mP = z;
 8535: 
 8536:       // Initialize other variables needed for CG
 8537:       node->mX = 0.0;  // Initial solution
 8538:       node->mAp = 0.0; // Will be computed in first iteration
 8539: 
 8540: 
 8541:       // Computes the first r'Mr (reduction)
 8542:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8543:     }
 8544:     // 4) write into shared-mem
 8545:     s_rMr[tid] = l_rMr;
 8546: 
 8547:     __syncthreads();
 8548: 
 8549: 
 8550:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8551:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8552:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8553:         __syncthreads();
 8554:     }
 8555: 
 8556:     // 6) thread 0 atomically folds into the global accumulators
 8557:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8558: 
 8559:     *rMr_old = 0.0;
 8560:     *pAp = 0.0;
 8561: }
 8562: #endif
 8563: 
 8564: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
