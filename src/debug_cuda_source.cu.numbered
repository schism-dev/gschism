 7402: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7403:    Element *elems = mesh->localElemData;
 7404: 
 7405:    *addr = elems;
 7406:    *sizeElement = sizeof(Element);
 7407:    switch (varCode) {
 7408:       case (int)VarCode::z:
 7409:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7410:          *sizeType = sizeof(double);
 7411:          break;
 7412:       case (int)VarCode::x:
 7413:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7414:          *sizeType = sizeof(Vector2);
 7415:          break;
 7416:       case (int)VarCode::area:
 7417:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7418:          *sizeType = sizeof(double);
 7419:          break;
 7420:       case (int)VarCode::depth:
 7421:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7422:          *sizeType = sizeof(double);
 7423:          break;
 7424:       case (int)VarCode::radius:
 7425:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7426:          *sizeType = sizeof(double);
 7427:          break;
 7428:       case (int)VarCode::lonlat:
 7429:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7430:          *sizeType = sizeof(double);
 7431:          break;
 7432:       case (int)VarCode::ghat:
 7433:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7434:          *sizeType = sizeof(Vector2);
 7435:          break;
 7436:       case (int)VarCode::kb:
 7437:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7438:          *sizeType = sizeof(int);
 7439:          break;
 7440:       case (int)VarCode::isdry:
 7441:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7442:          *sizeType = sizeof(int);
 7443:          break;            
 7444:       case (int)VarCode::w:
 7445:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7446:          *sizeType = sizeof(double);
 7447:          break;
 7448:       case (int)VarCode::FaceIndices:
 7449:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7450:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7451:          *sizeType = sizeof(Node);
 7452:          break;
 7453:       default:
 7454:          *offset = -1;
 7455:    }
 7456: }
