 1853: __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p, const Side* origSide) {
 1854: // If ics == 2, convert the global point to the local frame of the original side
 1855:    
 1856:    if constexpr (ics == 1) {
 1857:       return p;
 1858:    } else {
 1859:       const Point3 c = {origSide->center.x, origSide->center.y, origSide->centerZ()};
 1860:       const Point3 p2 = origSide->frame.G2L(p - c);
 1861:       return p2; // only the horizontal components
 1862:    }
 1863: }
 1864: 
 1865: __device__ __forceinline__ Point2 toLocalFrame(Point2 const& p, const Side* origSide) {
 1866: // If ics == 2, convert the global vector to the local frame of the original side
 1867:    return toPoint2(toLocalFrame(toPoint3(p, 0.0), origSide));
 1868: }
