 1434: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1435:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1436: }
 1437: 
 1438: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1439:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1440: }   
 1441: 
 1442: __device__ __inline__ double min3(double a, double b, double c) {
 1443:    return min(a, min(b, c));
 1444: }
 1445: 
 1446: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1447:    return min(a, min(b, min(c, d)));
 1448: }
