 4311:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4312: 
 4313:       SIDE(side);
 4314: 
 4315: 
 4316:       side->U = {0.0, 0.0}; 
 4317:          
 4318:       if(side->isDry) return;
 4319: 
 4320:       const Node *node1 = side->n1;
 4321:       const Node *node2 = side->n2;
 4322: 
 4323:       // Vertically integrated velocity U (in ll if ics=2)
 4324:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4325:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4326:       }
 4327: 
 4328:    }
 4329: 
 4330:    __global__ void computeBottomDragVegetation(void) {
 4331:       // UNFINISHED. CHECK THIS:
 4332:       // How many kernels are needed? Why so many for loops?
 4333:       // Is the loop on sides needed?
 4334: 
 4335:       NODE(node);
 4336: 
 4337:       const int    kb      = node->kb;
 4338:       const double htot    = node->htot2();
 4339:       const double rough   = node->rough;
 4340: 
 4341: 
 4342:       if (node->isDry) {
 4343:          // Default values for dry nodes
 4344:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4345:          /// XXX CHECK INDICES
 4346:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4347:       }
 4348: 
 4349:       // Compute bottom drag Cd
 4350:       //--------------------------------
 4351: 
 4352:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4353:       if (nchi==1) {
 4354: 
 4355:          bool ltmp = false; // for WBL iteration
 4356: 
 4357:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4358:          // Drag at nodes
 4359:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4360:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4361:         
 4362:          const double rough = node->rough;
 4363:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4364:          if (node->rough == 0.0) {
 4365:             node->Cd = 0.0;
 4366: 
 4367:          } else { //roughness >0 
 4368:             
 4369:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4370:             const double bthick = max(dzb_min, bthick_ori);
 4371: 
 4372:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4373: 
 4374:             double tmp = 1.0/(2.5*log(bthick/rough));
 4375:             node->Cd = tmp*tmp;
 4376: 
 4377:          } // if rough
 4378: 
 4379: 
 4380:          // RECOVER THIS: XXX
 4381:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4382:          // Output warning for WBL if iteration didn't converge
 4383: 
 4384: 
 4385:       } // nchi==1
 4386: 
 4387:       //   Bottom stress in m^2/s^2
 4388:       if (node->rho[kb + 1] >= -98.0)
 4389:       {
 4390:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4391:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4392:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4393:          // !sediment erosion: this part needs more documentation
 4394:       }
 4395: 
 4396:     
 4397:       // Compute vegetation parameters
 4398:       //--------------------------------
 4399: 
 4400:       // SAV constants
 4401:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4402:       constexpr double veg_cfpsi = 0.16;
 4403: 
 4404:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4405:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4406: 
 4407:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4408:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4409:          int kbin = 0; // bin index
 4410:          for (int k = kb; k < nvrt; k++) {
 4411:             // Computes node height above the bottom level
 4412:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4413:             assert(false && "Vertical variation of vegetation not implemented");
 4414: 
 4415:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4416:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4417:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4418:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4419:             // } else {
 4420:             //    // Find the bin at which the current vertical level is
 4421:             //    while (kbin<nbins_veg_vert) {
 4422:             //       const double zn = node->z[kbin];
 4423:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4424:             //          break;
 4425:             //       } // if
 4426:             //       kbin++;
 4427:             //    } // while
 4428:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4429: 
 4430:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4431:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4432:                
 4433:             //    // Linear interpolation of the vegetation parameters
 4434:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4435:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4436:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4437:             // } // if rl10
 4438: 
 4439:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4440: 
 4441:          } // for k
 4442: 
 4443: 
 4444:       } else { // Ganthy (iveg=2)
 4445:       //  Modify canopy height, diameter, and density
 4446: 
 4447:          // Make sure there is vegetation on this node
 4448:          if (node->veg_h_unbent > 0.0) {
 4449:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4450: 
 4451:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4452:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4453:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4454: 
 4455:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4456:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4457:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4458:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4459:          } // if veg_h_unbent
 4460: 
 4461:          for (int k = 0; k < nvrt; k++) {
 4462:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4463:          } // for k
 4464:       
 4465: 
 4466:       } // if iveg
 4467:      
 4468:          
 4469: 
 4470:       // Compute vertical mean of veg_alpha3D
 4471:       if (iveg != 0) {
 4472:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4473:          double sum1=0.0;
 4474:          double sum2=0.0;
 4475:          // Integrate over each level under the canopy...
 4476:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4477:             const double Dz = node->Dz(k);
 4478: 
 4479:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4480:             sum2 += Dz;
 4481: 
 4482:          } // for k
 4483: 
 4484:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4485:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4486: 
 4487:       } // if iveg
 4488: 
 4489:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4490: 
 4491:    }
 4492: 
 4493:    __global__ void computeVegetationAndDragParameters(void) {
 4494:       // Computes the vegetation and drag model parameters:
 4495:       // chi, \tilde\chi, beta, \breve{H}
 4496:       
 4497:       SIDE(side);
 4498: 
 4499:       const double htot = side->htot2();
 4500:       const int    kb   = side->kb;
 4501: 
 4502:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4503: 
 4504:       const double veg_h     = side->veg_h();
 4505:       const double veg_nv    = side->veg_nv();
 4506:       const double veg_c     = side->veg_c();
 4507:       const double veg_beta  = side->veg_beta;
 4508:       const double veg_alpha = side->veg_alpha_vert_mean();
 4509: 
 4510:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4511:       // Velocity magnitude at the bottom level
 4512:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4513:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4514:       side->chi2 = side->Cd()*vmag1;
 4515:       side->chi  = side->chi2;
 4516:       if constexpr(iveg != 0) {
 4517:          const Node *n1 = side->n1;
 4518:          const Node *n2 = side->n2;
 4519:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4520:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4521:       }
 4522: 
 4523:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4524: 
 4525:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4526:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4527:       double magUa = 0.0;
 4528:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4529:          // 3D wet side with veg...
 4530: 
 4531:          double magUa = 0.0;
 4532:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4533:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4534: 
 4535:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4536:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4537:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4538: 
 4539:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4540:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4541: 
 4542:                // Velocity magnitude at the bottom (l) of the level
 4543:                const double ul = length(side->u2[k]);
 4544: 
 4545:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4546:                magUa += Dz*0.5*(uh + ul);
 4547: 
 4548:             } // if HasVegetation
 4549:          } // for k
 4550:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4551: 
 4552:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4553:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4554:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4555:             const double zCpy = side->zTopCanopy();
 4556:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4557:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4558:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4559:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4560:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4561:          } // if isSubmerged
 4562:       } // if iveg   
 4563: 
 4564:       // Computes the friction modified depth, \breve{H} in notes
 4565:       if (side->is2D()) { // 2D
 4566: 
 4567:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4568:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4569: 
 4570:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4571: 
 4572:          side->hhat = htot*htot/fricH; 
 4573: 
 4574:       } else { // 3D
 4575:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4576: 
 4577:          if constexpr(iveg != 0) {
 4578:             
 4579:             if (side->isSubmerged()) { 
 4580:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4581:                side->hhat -= veg_c*Hhat_alpha;
 4582: 
 4583:             } else { // Emergent
 4584:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4585:             }
 4586:          } // if iveg
 4587: 
 4588:          // Enforce positivity for 3D model
 4589:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4590:       } // if 3D
 4591: 
 4592:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4593: 
 4594:         
 4595:    }
 4596: 
 4597: 
 4598: 
 4599:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4600:    // Computes the density gradient between two elements, e1 and e2.
 4601:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4602:    // zero in the direction normal to the side. 
 4603:    // 
 4604:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4605:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4606:    //
 4607:    // Input:
 4608:    //    e1: Element
 4609:    //    e2: Neighbor element (or nullptr if boundary)
 4610:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4611:    //    k: Index of the half-level at which the density is interpolated
 4612:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4613:    // 
 4614:    // Output:
 4615:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4616:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4617: 
 4618:       if (e2 == nullptr || e2->isDry) {
 4619:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4620: 
 4621:          Side *side = e1->sides[j];
 4622:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4623:                  
 4624:          if constexpr(ics == 1) {
 4625:             vec = side->n; // Normal vector to the side
 4626:          } else {
 4627:             // IMPLEMENT THIS XXXXXX
 4628:             // !replace with xel, yel?
 4629:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4630:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4631:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4632:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4633:          } //ics
 4634:                    
 4635:          diffRho = 0.0;
 4636: 
 4637:       } else { //internal and wet
 4638:          if constexpr(ics==1) {
 4639:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4640: 
 4641:             // Vector from e1 to e2
 4642:             vec = toVector2(e2->center - e1->center);
 4643: 
 4644:          } else { 
 4645:             // IMPLEMENT THIS XXXXXX
 4646:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4647:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4648:             //                   alow(j)=xctr2
 4649:             //                   bdia(j)=yctr2
 4650:          } // ics
 4651: 
 4652:          diffRho = rho2 - e1->demeanedDensity(k);
 4653:       }
 4654: 
 4655:    }
 4656: 
 4657:    __global__ void computeDensityCubicSplines(void) {
 4658:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4659: 
 4660:       ELEM(elem);
 4661: 
 4662:       if (elem->isDry) return;
 4663: 
 4664:       const int kb = elem->kb;
 4665: 
 4666:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4667:       if (elem->is2D()) {
 4668:          // In the 2D case, the density is constant at the prism level. 
 4669:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4670:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4671:       } else { //3D
 4672: 
 4673:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4674:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4675:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4676:          ///// XXXX CHECK INDICES!!!!!
 4677:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4678:       } // 2D/3D
 4679: 
 4680:    }
 4681: } // extern "C"
 4682: 
 4683: 
 4684: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4685: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4686: 
 4687:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4688: 
 4689:    const int kb  = elem->kb;
 4690:    const int kb2 = elem2->kb;
 4691: 
 4692:    // z-coordinate of prism of elem
 4693:    const double zp = elem->z_prism(k);
 4694: 
 4695:    double rho = 0.0;
 4696: 
 4697:    if (elem2->is2D()) {
 4698:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4699: 
 4700:    } else {  // 3D
 4701: 
 4702:       // eta_min may be < zmax
 4703:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4704:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4705: 
 4706:       // (Extrapolate density below bottom, we will fix it later)
 4707:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4708:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4709:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4710:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4711:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4712:    } // 2D/3D
 4713:      
 4714: 
 4715:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4716:    // Now we need to fix it.
 4717:    if (elem->z[k] < elem2->z[kb2]) {
 4718:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4719: 
 4720:       // There are two methods to adjust the density at the bottom of the element.
 4721:       // iunder_deep=0: 
 4722:       const double depth1 = abs(elem->z[kb]); // larger depth
 4723: 
 4724:       if (iunder_deep==0) {
 4725: 
 4726:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4727: 
 4728:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4729: 
 4730:       } else { // iunder_deep != 0
 4731: 
 4732:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4733: 
 4734:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4735: 
 4736:          //   Demeaned density at the same z coordinate as
 4737:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4738:          }
 4739: 
 4740:       } // if iunder_deep
 4741:    } // if elem->z[kb] < elem2->z[kb]
 4742: 
 4743:    return rho;
 4744: }
 4745: 
 4746: 
 4747: extern "C" {
 4748:    __global__ void computeDensityGradient(void) {
 4749: 
 4750:          // Compute the horizontal density gradient at each element.
 4751:       // It works in two steps:
 4752:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4753:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4754:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4755:       //             gradRho.r1 = rho1 - rho0
 4756:       //             gradRho.r2 = rho2 - rho0
 4757:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4758:       // 
 4759:       //  NOTE: We use de-meaned densities.
 4760: 
 4761:       ELEM(elem);
 4762: 
 4763:       if (elem->isDry) return;
 4764: 
 4765:       const int kb  = elem->kb;
 4766:       const int i34 = elem->i34;
 4767: 
 4768:       for (int k = kb + 1; k < nvrt; k++) {
 4769:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4770:          //             gradRho.r1 = rho1 - rho0
 4771:          //             gradRho.r2 = rho2 - rho0
 4772:          int icount = 0;
 4773:          double sumRx = 0.0;
 4774:          double sumRy = 0.0;
 4775:          for (int j1=0; j1<i34; j1++) { 
 4776: 
 4777:             const int j2 = elem->nxq(j1 + 1);
 4778: 
 4779:             // Pairs of consecutive neighbor elements of elem
 4780:             const Element *e1 = elem->nghbElems[j1];
 4781:             const Element *e2 = elem->nghbElems[j2];
 4782: 
 4783:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4784:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4785:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4786: 
 4787:             // Compute the density difference and the vector from elem to e1 and e2
 4788:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4789:             double diffRho1, diffRho2;
 4790:             Vector2 vec1, vec2;
 4791:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4792:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4793: 
 4794:             const double rl1 = length(vec1);
 4795:             const double rl2 = length(vec2);
 4796:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4797: 
 4798:             const double delta = cross(vec1, vec2);
 4799:             const double sintheta = abs(delta)/(rl1*rl2);
 4800: 
 4801:             // To avoid problems, avoid elements with small angle between vectors
 4802:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4803:             const bool validEq = (sintheta > sin_one_deg);
 4804: 
 4805:             if (validEq) {
 4806:                // Solve the system of equations to get the density gradient at elem
 4807:                icount++;
 4808:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4809:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4810:                sumRx += Rx;
 4811:                sumRy += Ry;
 4812:             }
 4813:          } // for j1
 4814: 
 4815:          // Compute the average density gradient at elem
 4816:          if (icount==0) {
 4817:            // Bad mesh quality; bail out with 0 b-cc
 4818:            elem->gradRho[k] = {0.0, 0.0};
 4819:          } else {
 4820:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4821:          }
 4822: 
 4823:       } // for k
 4824: 
 4825:    }
 4826: 
 4827:    __global__ void computeBaroclinicTerm(void) {
 4828:    // Computes the baroclinic term at sides (at half levels).
 4829:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4830:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4831: 
 4832:       SIDE(side);
 4833: 
 4834:       if (side->isDry) return;
 4835: 
 4836:       const Element *e1 = side->elems[0];
 4837:       const Element *e2 = side->elems[1];      
 4838:       const int kb = side->kb;
 4839:       
 4840:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4841: 
 4842:       // interpolates vertically the density gradient of the two elements at the half level/
 4843: 
 4844:       // Starts the integration at the surface and goes down to the bottom
 4845:       int k1 = nvrt - 1;
 4846:       int k2 = nvrt - 1;
 4847: 
 4848:       side->bcc[nvrt-1] = {0.0, 0.0};
 4849:       for (int k = nvrt-2; k >= kb; k--) {
 4850:       // For each prism level (from surface to bottom)...
 4851: 
 4852:          // For both elements, interpolate density gradient at the side's half level.
 4853:          // The gradient at the side is the average of the gradients at the elements.
 4854:          // w1, w2 are used to take into account boundary sides, with just one element.
 4855:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4856:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4857:          const double wsum = w1 + w2;
 4858:          w1 = w1/wsum;
 4859:          w2 = w2/wsum;
 4860:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4861: 
 4862:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4863:          Vector2 gradRho = {0.0, 0.0};
 4864:          if (e1 != nullptr && k > kb) {
 4865:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4866:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4867:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4868:             
 4869:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4870:          }      
 4871:          if (e2 != nullptr && k > kb) {
 4872:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4873:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4874:             
 4875:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4876:          }
 4877: 
 4878:          if constexpr(ics==2) {
 4879:             // IMPLEMENT THIS XXXXXX
 4880:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4881:             // swild(1)=tmp1
 4882:             // swild(2)=tmp2
 4883:          }
 4884:          
 4885:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4886:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4887:          // CHECK INDICES!!! XXX
 4888:          const double grav3 = side->grav3();
 4889:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4890: printf(">>>side->bcc[%d] = %e, %e, rampbc: %e, grav3: %e, rho0: %e, side->Dz(k + 1): %e, gradRho: %e, %e\n", k, side->bcc[k].x, side->bcc[k].y, rampbc, grav3, rho0, side->Dz(k + 1), gradRho.x, gradRho.y);
 4891: 
 4892:       } // for
 4893: 
 4894:    }
 4895: 
 4896: 
 4897: 
 4898:    __global__ void computeHorGradientAtSide(void) {
 4899: 
 4900:       // Compute the horizontal density gradient at each element.
 4901:       // It works in two steps:
 4902:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4903:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4904:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4905:       //             gradRho.r1 = rho1 - rho0
 4906:       //             gradRho.r2 = rho2 - rho0
 4907:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4908:       // 
 4909:       //  NOTE: We use de-meaned densities.
 4910: 
 4911:       SIDE(side);
 4912: 
 4913:       if (side->isDry) return;
 4914: 
 4915:       // Computes the gradient of the variables at the side center.
 4916:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4917:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4918:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4919: 
 4920:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4921:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4922:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4923:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4924: 
 4925: 
 4926:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4927:          side->gradEta1.x, side->gradEta1.y, 
 4928:          side->gradEta2.x, side->gradEta2.y, 
 4929:          side->gradETP.x, side->gradETP.y, 
 4930:          side->gradPr.x, side->gradPr.y);
 4931: 
 4932: 
 4933:    }
 4934: 
 4935: 
 4936:    __global__ void solveMomentumEquations(double time) {
 4937: 
 4938:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4939:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4940: 
 4941:       SIDE(side);
 4942: 
 4943:       if (side->isDry) 
 4944:       {
 4945:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4946: 
 4947:          return;
 4948:       }
 4949: 
 4950:       const Node *n1 = side->n1;
 4951:       const Node *n2 = side->n2;
 4952: 
 4953:       const int kb = side->kb;
 4954: 
 4955:       const double veg_h = side->veg_h();
 4956:       const double grav3 = side->grav3();
 4957: 
 4958: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4959:       if (side->is2D()) {
 4960:          // Warning: Do not use htot2, which is updated.
 4961:          const double htot = side->htot1();
 4962:          const double hhat = side->hhat;
 4963: printf("htot: %e, hhat: %e\n", htot, hhat);
 4964:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4965: 
 4966:          Vector2 tau2 = {0.0, 0.0};
 4967:           
 4968:          if constexpr(ics==1) {
 4969:             tau2 = side->tau();
 4970: 
 4971:          } else {
 4972:             assert(false && "Not implemented: ics == 2");
 4973:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4974:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4975:             // taux2=(vn1+tt1)*0.5d0
 4976:             // tauy2=(vn2+ss1)*0.5d0
 4977:          } // if ics         
 4978: 
 4979:          // hat_gam has units of m/s
 4980: 
 4981:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4982: 
 4983: printf("coriolisTerm: %e, %e\n", coriolisTerm.x, coriolisTerm.y);
 4984: 
 4985:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4986:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4987: 
 4988:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4989: 
 4990:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4991:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4992: 
 4993:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4994: 
 4995: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e, hat_gam = %e, %e, hhat = %e, htot = %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y, side->nuGradU[nvrt-1].x, side->nuGradU[nvrt-1].y, hhat, htot);
 4996: 
 4997:       }
 4998:       else { // 3D
 4999: 
 5000:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5001:          // 
 5002:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5003:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5004:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5005:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5006:          // k+1 and k.
 5007: 
 5008: 
 5009:          // // Define layer thickness & viscosity
 5010:          // for (int k=kb + 1; k<nvrt; k++) {
 5011:          //    const double dzz = side->Dz(k - 1);
 5012: 
 5013:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5014: 
 5015:          //    // Vertical viscosity at the face center
 5016:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 5017:         
 5018:          // }
 5019: 
 5020: 
 5021:          const int ndim = nvrt - kb;
 5022:          const double zTopCanopy = side->zTopCanopy();
 5023: 
 5024:          // Initialize the tridiagonal system
 5025:          for (int k = kb + 1; k<nvrt; k++) {
 5026:             
 5027:             const int kin = k - kb;
 5028: 
 5029:             // Vertical viscosity at the face center
 5030:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 5031:             const double dzz = side->Dz(k);
 5032: 
 5033:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 5034:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 5035:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5036: 
 5037:             alow[kin] = 0.0;
 5038:             cupp[kin] = 0.0;
 5039:             bdia[kin] = 0.0;
 5040: 
 5041:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5042:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5043: 
 5044:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5045:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5046:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5047: 
 5048:             // First part: layers k, k+1
 5049:             if (k < nvrt - 1) {
 5050:                              
 5051:                if constexpr(iveg != 0) {
 5052: 
 5053:                   // If there is vegetation at this level...
 5054:                   if (zTopCanopy > side->zc[k]) {
 5055:                      // If the canopy is above the k layer...
 5056:                      
 5057:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5058:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5059:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5060:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5061: 
 5062:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5063:                      const double vmag2 = length(ut2);
 5064:                      const double vmag1 = length(side->u2[k]);
 5065:                      const double vmag = 0.5*(vmag1 + vmag2);
 5066:                      
 5067:                      // Computes the vegetation alpha at the face center
 5068:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5069: 
 5070:                      cff1 += veg_alpha_sd*dt*vmag;
 5071: 
 5072:                   } // if (zTopCanopy
 5073:                } // if iveg
 5074: 
 5075:                const double tmp = dt*dfz/dzz;
 5076:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5077:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5078: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 5079:             }
 5080: 
 5081: 
 5082:             // Second part: layers k-1, k
 5083:             if (k > kb + 1) {
 5084: 
 5085:                double cff1 = 1.0; //init \bar{c^k}
 5086: 
 5087:                if constexpr(iveg != 0) {
 5088:                   // If there is vegetation at this level...
 5089:                   if (zTopCanopy > side->zc[k-1]) {
 5090:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5091:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5092: 
 5093:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5094: 
 5095:                      const double vmag2 = length(ut2);
 5096:                      const double vmag1 = length(side->u2[k-1]);
 5097:                      const double vmag = 0.5*(vmag1 + vmag2);
 5098: 
 5099:                      // Computes the vegetation alpha at the face center
 5100:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5101:                      cff1 += veg_alpha_sd*dt*vmag;
 5102:                   } // if zTopCanopy
 5103: 
 5104:                } // if iveg
 5105: 
 5106:                const double tmp = dt*dfz/dzz;
 5107:                alow[kin] += cff1*dzz/6.0 - tmp;
 5108:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5109: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 5110:             } else { // Bottom boundary
 5111:                // This occurs at the bottom, where the bottom drag is applied.
 5112: 
 5113:                bdia[kin] += dt*side->chi2;
 5114: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 5115:             } // if (k > kb + 1)
 5116: 
 5117: 
 5118: 
 5119:          } // for (int k
 5120: 
 5121: 
 5122: 
 5123:          // Computes the RHS.
 5124:          // -----------------
 5125: 
 5126:          //	BC to be imposed at the end.
 5127: 
 5128:          const Vector2 gradETP  = side->gradETP;
 5129:          const Vector2 gradPr   = side->gradPr;
 5130:          const Vector2 gradEta1 = side->gradEta1;
 5131:          const Vector2 gradEta2 = side->gradEta2;
 5132: 
 5133:          const Vector2 *btu = side->btu;
 5134:          const Vector2 *u2  = side->u2;
 5135:          const double coriolis = side->coriolis;
 5136:          const Vector2 *nuGradU = side->nuGradU;
 5137: 
 5138: 
 5139:          for (int k = kb + 1; k<nvrt; k++) {
 5140:             const int kin = k - kb;
 5141: 
 5142:             const double dz_0 = side->Dz(k);
 5143:             const double dz_1 = side->Dz(k+1);  
 5144: 
 5145:             rrhs[kin] = {0.0, 0.0};
 5146:             double dz = 0.0;
 5147: 
 5148:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5149:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5150:             if (k < nvrt  ) dz += 0.5*dz_1;
 5151:             if (k > kb + 1) dz += 0.5*dz_0;
 5152: 
 5153:             // Elevation gradient, atmospheric pressure and tidal potential
 5154:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5155: 
 5156:             // Coriolis, advection, wind stress, and horizontal viscosity
 5157:             if (k < nvrt - 1) {
 5158: 
 5159: 
 5160:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5161:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5162:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5163: 
 5164:                //diff stress tensors 1006
 5165:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5166:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5167:                   assert(false && "Not implemented: itur == 5");
 5168:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5169:                }
 5170: 
 5171:             } else { // k=nvrt
 5172:                Vector2 tau2 = {0.0, 0.0};
 5173:                if constexpr(ics==1) {
 5174:                   tau2 = side->tau();
 5175:                } else {
 5176:                   assert(false && "Not implemented: ics == 2");
 5177:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5178:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5179:                   // taux2=(vn1+tt1)*0.5d0
 5180:                   // tauy2=(vn2+ss1)*0.5d0
 5181:                } // if ics
 5182: 
 5183:                rrhs[kin] += dt*tau2;
 5184: 
 5185:             } // if k<nvrt
 5186: 
 5187:             if (k > kb + 1) {
 5188:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5189:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5190:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5191: 
 5192: 
 5193:                // diff stress tensors 1006
 5194:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5195:                   assert(false && "Not implemented: itur == 5");
 5196:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5197:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5198:                }
 5199: 
 5200:             } // if k>kbs + 1
 5201: 
 5202:             // Baroclinic
 5203:             Vector2 *bcc = side->bcc;
 5204:             if constexpr(ibc == 0) {
 5205:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5206:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5207: 
 5208:             } // if ibc==0
 5209: 
 5210: 
 5211:          } // k=kb + 1,nvrt
 5212: 
 5213: printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 5214:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5215:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5216: printf("::: u[0] = %e, u[1] = %e, u[2] = %e, u[3] = %e\n", u[0], u[1], u[2], u[3]);
 5217: 
 5218: 
 5219:          for (int k=kb + 1; k<nvrt; k++) {
 5220:             const int kin = k - kb;
 5221: 
 5222:             // Velocity is always clamped to maximum values
 5223:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 5224:          } // k
 5225: 
 5226:       } // if side->is2D()
 5227:       
 5228: 
 5229:       // Impose velocity boundary condition at the bottom
 5230:       if constexpr(imm == 2) { // 3D bed deformation model
 5231:          double dep;
 5232:          Vector2 vel;
 5233: 
 5234:          assert(false && "Not implemented: imm == 2");
 5235:          //update_bdef(time, x0, y0, dep, vel);
 5236:          // side->u2[kb] = vel;
 5237: 
 5238:       } else { // imm = 0 or 1
 5239:          if (side->Cd() == 0.0) {
 5240:             side->u2[kb] = side->u2[kb + 1];
 5241:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom
 5242:             side->u2[kb] = {0.0, 0.0};
 5243:          }
 5244:           
 5245:       } // if imm
 5246: 
 5247:       // The velocities below the bottom level are set to zero
 5248:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5249: 
 5250: 
 5251:    }
 5252: 
 5253: 
 5254:    __global__ void applyMomentumBC(void) {
 5255: 
 5256:       SIDE_BND(sideBnd);
 5257: 
 5258:       Side *side = sideBnd->side;
 5259:       const BoundarySegment *segment = sideBnd->segment;
 5260:       const Node *n1 = side->n1;
 5261:       const Node *n2 = side->n2;
 5262: 
 5263:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5264: 
 5265:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5266:       const bool isLand = segment->isLand;
 5267:       const int ifltype = segment->ifltype;
 5268: 
 5269:       const int kb = side->kb;
 5270: 
 5271: printf("ifltype = %d, isLand = %d, segment = %d, ubc = %e,%e\n", ifltype, segment->isLand, segment, sideBnd->ubc[kb].x, sideBnd->ubc[kb].y);    
 5272:       if (!isLand && ifltype != 0) {
 5273:          const Vector2 *ubc = sideBnd->ubc;
 5274:   
 5275:          for (int k=kb; k < nvrt; k++) {
 5276:             
 5277:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5278:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5279: 
 5280:             if (ifltype == -1) {
 5281:                // Flather 1
 5282: 
 5283:                const double depth = side->depth();
 5284: 
 5285:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5286: 
 5287:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5288: 
 5289:                side->u2[k] = vnorm*side->n;
 5290: 
 5291:             } else if (ifltype == -2) { // Discharge
 5292: 
 5293:                const double eta1 = side->eta1();
 5294:                const double eta2 = side->eta2();
 5295:                const double htot = side->htot2();
 5296: 
 5297:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5298:                assert(false && "Not implemented: Discharge bc");
 5299:                // const double dischrg = discharge(eta1);
 5300:                const double dischrg = 0.0; // XXX REMOVE
 5301:                
 5302: 
 5303:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5304: 
 5305:                const double vnorm = dischrg*eta2/htot;
 5306: 
 5307:                side->u2[k] = vnorm*side->n;
 5308: 
 5309: 
 5310:             }
 5311:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5312:                const double vnorm = dot(side->u2[k], side->n);
 5313: 
 5314:                double rat;
 5315:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5316:                else              rat = segment->vobc2; // outgoing
 5317: 
 5318:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5319:             }
 5320:             else { // not Flather or 3D radiation
 5321:                side->u2[k] = ubc[k];
 5322: printf("****** idx = %d, k = %d, side->idx = %d, ubc = %e,%e\n", side->idx, k, side->idx, ubc[k].x, ubc[k].y);               
 5323: 
 5324:             } // if (segment->ifltype...
 5325: 
 5326:          }
 5327: 
 5328:       }
 5329:       else if (isLand) { // if it is land boundary side
 5330: 
 5331:          if constexpr(islip == 0) { // free slip
 5332:             for (int k=kb; k < nvrt; k++) {
 5333:                double vnorm = 0.0; // for most cases
 5334:                const double vtan = dot(side->u2[k], side->t());
 5335:                const Vector2 t = side->t();
 5336:                const Vector2 n = side->n;
 5337: printf("islip   = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);      
 5338:                side->u2[k] = vtan*t - vnorm*n;
 5339: printf("islipXX = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);                     
 5340:             }
 5341: 
 5342:          } else { // no slip
 5343:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5344: 
 5345:          }
 5346:       } // if (side segment type...
 5347: 
 5348:    
 5349: 
 5350:    }
 5351: 
 5352: 
 5353:    __global__ void shapiroFilter1(void) {
 5354:       // First step of the Shapiro filter (normally used if indvel<=0)
 5355:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5356: 
 5357:       SIDE(side);
 5358: 
 5359:       // Only internal wet sides are processed
 5360:       if (side->isDry || !(side->isInternal())) return;
 5361: 
 5362:       const int kb = side->kb;
 5363: 
 5364:       for (int mm = 1; mm <= niter_shap; mm++) {
 5365: 
 5366:          for (int k = kb + 1; k < nvrt; k++) {
 5367:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5368:             side->bcc[k] = {0.0, 0.0};
 5369:             Vector2 suru = {0.0, 0.0};
 5370: 
 5371:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5372: 
 5373:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5374: printf("idx = %d, j = %d,nSide->idx = %d, nSide->u2[k] = %e,%e\n", side->idx, j, nSide->idx, nSide->u2[k].x, nSide->u2[k].y);
 5375: 
 5376:                int kin = k;
 5377:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5378:                
 5379:                if constexpr(ics==1) {
 5380:                   suru += nSide->u2[kin];
 5381: 
 5382:                } else {
 5383:                   assert(false && "Not implemented: ics == 2");
 5384:                   // Vector2 vn1, vn2;
 5385:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5386:                   // suru=suru+vn1;
 5387:                   // surv=surv+vn2;
 5388:                }
 5389:             }
 5390: 
 5391: 
 5392:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5393: printf("NNNN idx = %d, suru = %f,%f, side->u2[k] = %f,%f, side->bcc[k] = %f,%f\n", side->idx, suru.x, suru.y, side->u2[k].x, side->u2[k].y, side->bcc[k].x, side->bcc[k].y);            
 5394: 
 5395:          }
 5396:       }
 5397:    }
 5398: 
 5399:    __global__ void shapiroFilter2(void) {
 5400:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5401: 
 5402:       SIDE(side);
 5403: 
 5404:       if (side->isDry || !(side->isInternal())) return;
 5405: 
 5406:       const int kb = side->kb;
 5407: 
 5408:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5409: 
 5410:       if (side->is2D()) {
 5411:          // side->u2[kb] = side->u2[nvrt - 1];
 5412:          side->u2[kb + 1] = side->bcc[kb + 1];
 5413:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5414: 
 5415:       } else {
 5416:          // 3D
 5417:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5418:          
 5419:       }
 5420: 
 5421:    }
 5422: 
 5423: 
 5424:    __global__ void ul0UpdateZCoords(void) {
 5425:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5426:       
 5427:       NODE(node);      
 5428: 
 5429:       if (node->isDry2()) { 
 5430: 
 5431:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5432: 
 5433:          if constexpr(ivcor != 1) node->kb = 0;
 5434: 
 5435:       } else {
 5436: 
 5437:          node->updateKb();
 5438:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5439: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 5440: 
 5441:       } // if wet or dry
 5442: 
 5443:       // We use the temp.b field to store the previous state of isDry.
 5444:       node->tmp.b = node->isDry;
 5445: 
 5446:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5447:       node->isDry = true;
 5448: 
 5449:    }
 5450: 
 5451:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5452:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5453:    {
 5454:       ELEM(elem);
 5455: 
 5456:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5457: 
 5458:       // All the nodes of a wet element are wet.
 5459:       if (!elem->isDry) {
 5460:          elem->nodes[0]->isDry = false;
 5461:          elem->nodes[1]->isDry = false;
 5462:          elem->nodes[2]->isDry = false;
 5463:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5464: 
 5465:       }
 5466: 
 5467: 
 5468:       elem->kb = 0;
 5469: 
 5470:       if (elem->isDry) return;
 5471: 
 5472:       // Wet
 5473:       const Node *n1 = elem->nodes[0];
 5474:       const Node *n2 = elem->nodes[1];
 5475:       const Node *n3 = elem->nodes[2];  
 5476:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5477: 
 5478:    //    if(elem->isDry2()) {
 5479:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5480:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5481:    //        call parallel_abort(errmsg)
 5482:    //    }
 5483: 
 5484: 
 5485:       // Computes element's kb as the minimum of the nodes' kb.
 5486:       const int kb1 = n1->kb;
 5487:       const int kb2 = n2->kb;
 5488:       const int kb3 = n3->kb;
 5489:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5490: 
 5491: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5492: 
 5493:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5494: 
 5495: 
 5496:       // Computes the element z as the mean of the nodes z.
 5497:       for (int k = elem->kb; k < nvrt; k++) {
 5498: 
 5499:          // Compute the element z as the mean of the nodes z.
 5500:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5501:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5502:          elem->z[k] /= elem->i34;
 5503: 
 5504:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5505:       }
 5506:                   
 5507:    }
 5508: 
 5509:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5510:    {
 5511:       NODE(node);
 5512:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5513: 
 5514:       if (it == iths) return;
 5515: 
 5516: 
 5517:       if(!node->isDry && node->tmp.b) { // rewetted
 5518:          for (int k=0; k < nvrt; k++) {
 5519: 
 5520:             Vector3 utmp={0.0, 0.0, 0.0};
 5521: 
 5522:             double ttmp=0.0;
 5523:             double stmp=0.0;
 5524:             int icount=0;
 5525:             for (int j = 0; j < node->numNodes; j++) {
 5526: 
 5527: 
 5528:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5529:                if (!node->isDry) { // all indices extended
 5530:                   icount++;
 5531: 
 5532:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5533:                   utmp += node->u2[k];
 5534:                   
 5535:                   ttmp += node->tracers[k].tracer[0]; 
 5536:                   stmp += node->tracers[k].tracer[1]; 
 5537:                }
 5538:             }
 5539: 
 5540:             if(icount > 0) {
 5541:                const double inv_icount = 1.0/icount;
 5542:                node->u2[k]     = inv_icount*utmp;
 5543:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5544:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5545:             }
 5546:          }
 5547:       }
 5548:    }
 5549: 
 5550: 
 5551:    __global__ void ul0UpdateSides(int it, int iths) {
 5552: 
 5553:       SIDE(side);
 5554: 
 5555:       // A side is wet if and only if at least one of its elements is wet.
 5556:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5557: 
 5558:       const Node *n1 = side->n1;
 5559:       const Node *n2 = side->n2;
 5560:       const int kb1 = n1->kb;
 5561:       const int kb2 = n2->kb;
 5562: 
 5563:       side->kb = 0; // dry
 5564: 
 5565:       if (isWet) {
 5566: 
 5567:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5568: 
 5569:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5570: 
 5571:          side->kb = min(kb1, kb2);
 5572: 
 5573:          for (int k = side->kb; k < nvrt; k++) {
 5574:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5575: 
 5576:          
 5577:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5578: 
 5579:             // Compute velocity for re-wetted sides 
 5580:             if ((it != iths) && (side->isDry && isWet)) {
 5581:             
 5582:                Vector2 utmp={0.0, 0.0};
 5583: 
 5584:                int icount=0;
 5585: 
 5586:                // For all the sides on the two elements that share this side
 5587:                for (int j=0; j < 2; j++) {
 5588:                   const Element *elem = side->elems[j];
 5589:                   if (elem == nullptr) continue;
 5590: 
 5591:                   for (int jj=0; jj < elem->i34; jj++) {
 5592:                      const Side *nSide = elem->sides[jj];
 5593:                      if (nSide->isDry) continue;
 5594: 
 5595:                      icount++;
 5596:                      utmp += nSide->u2[k];                     
 5597:                   }
 5598:                }
 5599:                   
 5600:                assert(icount > 0 && "No wet sides around this side");
 5601:                if (icount > 0)  side->u2[k] = utmp/icount;
 5602:                   
 5603:             } // if ((it != iths) && (side->isDry && isWet))
 5604: 
 5605:          } // for k
 5606: 
 5607:       } // if isWet
 5608:    
 5609:       side->isDry = !isWet;
 5610: 
 5611:    }
 5612: 
 5613: 
 5614:    __global__ void zeroNodalVelocities(void) {
 5615:       NODE(node);
 5616: 
 5617:       for (int k = 0; k < nvrt; k++) {
 5618:          node->u2[k] = {0.0, 0.0, 0.0};
 5619:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5620:       }
 5621:    }
 5622: 
 5623:    __global__ void computeNodalVerticalVelocities1(void) {
 5624:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5625:    // Adds the element's vertical velocity times the element's area.
 5626:       ELEM(elem);
 5627: 
 5628:       for (int j = 0; j < elem->i34; j++) {
 5629:          Node *node = elem->nodes[j];
 5630: 
 5631:          for (int k = node->kb; k < nvrt; k++) {
 5632:             node->u2[k].z += elem->w[k]*elem->area;
 5633:             node->tmp.d += elem->area;
 5634:          }
 5635:       }
 5636:    }
 5637: 
 5638:    __global__ void computeNodalVerticalVelocities2(void) {
 5639:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5640:    // Divides by the total area of the elements sharing the    node.
 5641:       ELEM(elem);
 5642: 
 5643:       for (int j = 0; j < elem->i34; j++) {
 5644:          Node *node = elem->nodes[j];
 5645: 
 5646:          for (int k = node->kb; k < nvrt; k++) node->u2[k].z /= node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5647:       }
 5648:    }
 5649: 
 5650:    __global__ void computeNodalHorizontalVelocities(void) {
 5651:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5652:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5653:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5654: 
 5655:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5656: 
 5657:       SIDE(side);
 5658: 
 5659:       const int kb = side->kb;
 5660: 
 5661:       Node *n1 = side->n1;
 5662:       Node *n2 = side->n2;
 5663: 
 5664:       for (int k = kb; k < nvrt; k++) {
 5665: 
 5666:          // Cast the u2 vector into a Vector2 
 5667:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5668:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5669: 
 5670:          n1_u2 += side->u2[k]/n1->numSides;
 5671:          n2_u2 += side->u2[k]/n2->numSides;
 5672: 
 5673:       }
 5674: 
 5675: 
 5676:    }
 5677: 
 5678:    __global__ void resetVelocityOpenBndNodes(void) {
 5679:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5680: 
 5681:       NODE_BND(nodebnd);
 5682: 
 5683:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5684:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5685:       }
 5686: 
 5687:    }
 5688: 
 5689: 
 5690:    __global__ void setVelocityOpenBndNodes(void) {
 5691:    // For open boundary nodes sets their velocity to the imposed values.
 5692: 
 5693:       SIDE_BND(sidebnd);
 5694: 
 5695:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5696:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5697:          // to its segment to the average of the side velocity.
 5698: 
 5699:          for (int k = 0; k < nvrt; k++) {
 5700:             Node *n1 = sidebnd->side->n1;
 5701:             Node *n2 = sidebnd->side->n2;
 5702: 
 5703:             // Cast the u2 vector into a Vector2 
 5704:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5705:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5706: 
 5707:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5708:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5709:          }
 5710:       }
 5711: 
 5712:    }
 5713: 
 5714: 
 5715:    __global__ void computeVerticalVelocity(void) {
 5716:       // Computes the vertical velocity at the (2D) element's centroid.
 5717:       // In this function we will be considering volumetric elements, with side faces and a 
 5718:       // bottom and a top face. We will call them SFs, BF and TF.
 5719:       // It computes the flux coming from BF and the SFs.
 5720:       // If the bed is moving, it takes that into account.
 5721:       // Since water is incompressible, the integral of the velocity times the normal vector
 5722:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5723:       // and the BF is equal to the flux going out from the TF.
 5724:       // TF = - BF - sum(SFs).
 5725:       // It then computes the horizontal velocity at the center of TF.
 5726:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5727:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5728:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5729: 
 5730:       ELEM(elem);
 5731: 
 5732:       if (elem->isDry) return;
 5733: 
 5734:       const int kb = elem->kb;
 5735:       const bool isTri = elem->isTri();
 5736: 
 5737:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5738: 
 5739:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5740:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5741:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5742: 
 5743:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5744: 
 5745:       double area3D;
 5746: 
 5747:       // Bottom face flux
 5748:       double bottomFlux = 0.0;
 5749:       Vector2 u2meanBottom = {0.0, 0.0};
 5750:       const Vector2 gradh = elem->grad2(&Node::depth);
 5751:       if constexpr(imm==2) {
 5752:          Vector3 ubed;
 5753: 
 5754:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5755:          // updateBDEF(ubed);
 5756:      
 5757:          // const double bflux0 = dot(ubed, elem_n1);
 5758: 
 5759:          // elem->w[kb] += ubed.z;
 5760:       }
 5761:       else {
 5762:          Vector2 umean;
 5763:          if constexpr(ics == 1) {
 5764:             u2meanBottom = elem->mean(kb, &Side::u2);
 5765:          }
 5766:          else {
 5767:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5768:          }
 5769: 
 5770:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5771:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5772: 
 5773:          bottomFlux = - dot(gradh, u2meanBottom);
 5774:       } // if imm
 5775: 
 5776:       // Compute w for kb+1 to nvrt-1
 5777:       for (int l = kb; l < nvrt - 1; l++) {
 5778: 
 5779:          // normal vector to the top face of the "volumetric" element (3D)
 5780:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5781: 
 5782:          // Compute the total flux at the sides
 5783:          double sideFlux = 0.0;
 5784:          Vector2 u2top = {0.0, 0.0};
 5785:          for (int j = 0; j < elem->i34; j++) {
 5786:             const Side *side = elem->sides[j];
 5787: 
 5788:             const double sideArea = side->area(l);
 5789:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5790:             const double sign = elem->ssign[j]; 
 5791: 
 5792:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5793: printf("idx = %d, l = %d, sideFlux = %f, u2c = %f,%f, side->len = %f, zc = %f, %f, sideArea = %f\n", side->idx, l, sideFlux, u2c.x, u2c.y, side->len, side->zc[l], side->zc[l + 1], sideArea);            
 5794:          }
 5795:          
 5796:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5797:          //velocities at the centers of the sides
 5798:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5799: 
 5800:          // The flx at the top ace can be computed from the other flows.
 5801:          const double topFlux = - sideFlux - bottomFlux;
 5802:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5803: 
 5804:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5805: printf("idx = %d, l = %d, sideFlux = %f, topHorizontalFlux = %f, bottomFlux = %f, area3D = %f, elem->w[%d] = %.16f, elem_n2.z = %f\n", elem->idx, l, sideFlux, topHorizontalFlux, bottomFlux, area3D, l + 1, elem->w[l + 1], elem_n2.z);
 5806: 
 5807: 
 5808:          elem_n1 = elem_n2;
 5809: 
 5810:          bottomFlux = - topFlux;
 5811:       }
 5812:    }  
