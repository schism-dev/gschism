 1317: // This struct is used to store the boundary information for a node.
 1318: struct NodeBoundary {   
 1319:    int idx;
 1320:    BoundarySegment *segment;
 1321:    Node *node;
 1322:    
 1323:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1324:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1325: 
 1326:    bool isLand;
 1327: 
 1328:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1329:    double elbc;   // Elevation boundary condition
 1330:    double eth;    // Elevation time history
 1331: 
 1332:    double eta_mean; // Mean elevation at nodes
 1333: 
 1334:    bool isEssentialBC;
 1335: 
 1336:    Vector2 uth[nvrt];  // "Time history" velocity
 1337: 
 1338:    // Arrays for harmonic constituents (if needed)
 1339:    double  emo[nbfr];  // Elevation amplitude
 1340:    double  efa[nbfr];  // Elevation phase
 1341:    Vector2 umo[nbfr];  // velocity amplitude
 1342:    Vector2 ufa[nbfr];  // velocity phase
 1343: 
 1344: 
 1345:    NodeBoundary(void) {
 1346:       isLand = false;
 1347:    }
 1348:    NodeBoundary(bool _isLand) {
 1349:       isLand = _isLand;
 1350:    }
 1351: 
 1352:    
 1353:    __forceinline__ __device__ int numSidesForAverage() const {
 1354:    // Returns the number of sides that are connected to the node and have the same segment.
 1355:    // This is used to compute the average velocity at the node for open boundary nodes.
 1356:       int res = 0;
 1357:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1358:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1359: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1360:       return res;
 1361:    }
 1362: 
 1363: 
 1364:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1365:       assert(index == 0 || index == 1); 
 1366:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1367:    }
 1368: 
 1369: 
 1370: };
 1371: 
 1372: struct Node {
 1373: 
 1374:    // Geometry information
 1375:    int idx;        // Index of the node
 1376:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1377:    int numNodes;   // Number of nodes neighbors of this node
 1378: 
 1379:    Element **elements; // Array of pointers to the elements that share this node
 1380:    int numElements;    // Number of elements that share this node
 1381: 
 1382:    int numSides;       // Number of sides that are connected to this node
 1383: 
 1384:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1385:    double gz;          // Global vertical coordinate at the node.
 1386:    Vector2 u2[nvrt];
 1387:    double  w2[nvrt];
 1388:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1389:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1390:    double lon, lat;
 1391:    double depth;
 1392: 
 1393:    Frame<ics> frame;
 1394: 
 1395:    LocalSigma<ivcor> localSigma;  
 1396: 
 1397:    int kb;       // Bottom index of the node
 1398: 
 1399:    bool isDry;     // True if the node is dry
 1400: 
 1401:    int iadv;     // Advection flag
 1402: 
 1403:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1404:                           // this is nullptr
 1405: 
 1406:    TempVar tmp; // Temporary variable to store different types of variables
 1407: 
 1408:    // Physical information
 1409:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1410:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1411: 
 1412:    double rho[nvrt];     // Density
 1413:    double dfv[nvrt];     // Vertical viscosity
 1414: 
 1415:    double eta1; // Elevation at nodes at previous timestep
 1416:    double eta2; // Elevation at nodes at current timestep
 1417: 
 1418:    double ETP;  // Earth Tidal Potential
 1419: 
 1420:    double pr;    // Air pressure
 1421:    double grav2; // Gravity 
 1422:    
 1423:    Vector2 dav;  // Depth averaged velocity
 1424: 
 1425:    Vector2 tau; // Wind stress vector
 1426: 
 1427:    // Vegetation parameters
 1428:    double veg_h;
 1429:    double veg_nv;
 1430:    double veg_di;
 1431:    double veg_Cd;
 1432:    double veg_h_unbent;
 1433:    double veg_di_unbent;
 1434:    double veg_nv_unbent;
 1435:    double veg_alpha_vert_mean;
 1436:    double veg_alpha0;
 1437:    double veg_alpha3D[nvrt];
 1438: 
 1439:    // Bottom drag parameters
 1440:    double Cd;       // Bottom drag coefficient   
 1441: 
 1442:    // These three are mutually exclusive
 1443:    union {
 1444:       double rmanning; // Bottom Manning's coefficient
 1445:       double rough;    // Bottom roughness length
 1446:       double drag;     // Bottom drag coefficient
 1447:    };
 1448:    Vector2 tau_bot; // Bottom stress vector
 1449: 
 1450:    // XXXX REMOVE FOR IMM>0???
 1451:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1452:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1453: 
 1454:    double qel; // RHS
 1455:    double coeffDiag; // Diagonal coefficient of the matrix
 1456:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1457: 
 1458:    // This was used by a previous version of the conjugate gradient method
 1459:    // double mP; // Search direction for conjugate gradient method
 1460:    // double mR; // Residual for conjugate gradient method
 1461:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1462: 
 1463:    double mX; // Solution of the FEM system
 1464: 
 1465:    // Meteorological forcing
 1466:    Vector2 u_air;
 1467:    double p_air;  // XXXX is this the same as pr?
 1468:    double t_air;
 1469:    double q_air;
 1470:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1471: 
 1472:    __device__ void setWind(Vector2 &u) {
 1473:    // Sets the wind vector taking into account the mesh angle
 1474:    
 1475:       const double speed = length(u);
 1476: 
 1477:       // Rotate wind vector to the node frame
 1478:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1479: 
 1480:       // Sets the surface stress vector due to wind.
 1481:       if constexpr(nws == 0) {
 1482:          tau = {0.0, 0.0};
 1483: 
 1484:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1485:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1486: 
 1487:       } else {
 1488: 
 1489:          double dragcoef;
 1490: 
 1491:          if constexpr(iwind_form == -1) {
 1492:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1493:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1494: 
 1495:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1496:             tau = cff*u_air;
 1497:  
 1498:          } else if constexpr(iwind_form == 1) {
 1499:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1500:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1501: 
 1502:             dragcoef = max(dragcoef, 4.0e-4);
 1503:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1504:             tau = cff*u_air;
 1505: 
 1506:          } else {
 1507:             tau = {0.0, 0.0};
 1508:          }
 1509:       }
 1510:    }
 1511: 
 1512: 
 1513:    __device__ void setFrame(double lat, double lon) {
 1514:       if constexpr(ics == 1) return;
 1515: 
 1516:       frame.update(lat, lon);        
 1517:     }
 1518: 
 1519:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1520: 
 1521:    __device__ double sigmaTransitionDepth(void) const;
 1522: 
 1523:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1524: 
 1525:    __inline__ __device__ Point2 outputCoords(void) const {
 1526:       if constexpr(ics == 1)  return p;
 1527:       else                    return {rad2deg*lon, rad2deg*lat};
 1528:    }
 1529: 
 1530:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1531:    // If ics == 2, convert the global point to the local frame
 1532:       
 1533:       if constexpr (ics == 1) {
 1534:          return p;
 1535:       } else {
 1536:          const Point3 c = {p.x, p.y, gz};
 1537:          const Point3 local = frame.G2L(p - c);
 1538:          return local;
 1539:       }
 1540:    }
 1541: 
 1542:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1543:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1544:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1545:    
 1546:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1547: 
 1548:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1549: 
 1550:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1551:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1552: 
 1553:    __device__ __forceinline__ void clearMatrixRow(void) {
 1554:       // Clear the matrix row for this node
 1555: 
 1556: 
 1557:       coeffDiag = 0.0;
 1558: 
 1559:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1560: 
 1561:    }
 1562: 
 1563:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1564:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1565:       
 1566:       if (node == this) {
 1567:          coeffDiag += value;
 1568:      
 1569:       } else {
 1570:          // Search (linearly)the index of the node in the array of nodes
 1571:          // XXX: This is not efficient, see if we can improve this
 1572:          int i;
 1573:          for (i = 0; i < numNodes; i++) {
 1574:             if (nodes[i] == node) {
 1575:                break;
 1576:             }
 1577:          }
 1578:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1579:          coeffMatrix[i] += value;
 1580:       }
 1581:    }
 1582: 
 1583: 
 1584:    __device__ __inline__ void updateZCoordData(void);
 1585: 
 1586:    __device__ __forceinline__ double compZCoord(int k) const;
 1587: 
 1588:    __device__ void updateKb(void);
 1589: 
 1590:    __device__ __forceinline__ void computeBottomDragCd(void);
 1591: 
 1592: 
 1593: 
 1594: };
