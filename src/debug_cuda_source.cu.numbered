 2548: 
 2549: 
 2550: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2551: 
 2552: 
 2553: __device__ void Node::updateKb(void) {
 2554: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2555: 
 2556:    if constexpr(ivcor == 1) return;
 2557: 
 2558: 
 2559:    // Check if node is wet
 2560:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2561: 
 2562:    if (isDry) return;
 2563: 
 2564:    if constexpr(ivcor == 2) {  // SZ coordinates
 2565:       
 2566:       // Compute bottom level index
 2567:       if (depth <= mesh->h_s) {
 2568:          kb = nzlev;
 2569:       } else {
 2570:          kb = -1;
 2571:          int L = 0;
 2572:          int R = nzlev; 
 2573:          
 2574:          while (L <= R) {
 2575:             int M = (R + L) / 2;
 2576: 
 2577: printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2578:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2579:             
 2580:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2581:                R = M;
 2582:             } else {
 2583:                L = M;
 2584:             }
 2585: 
 2586:             if (R - L == 1) {
 2587:                kb = L;
 2588:                break;
 2589:             }
 2590:          }
 2591:       }
 2592:    } 
 2593: }
 2594: 
 2595: 
 2596: __device__ __inline__ void Node::updateZCoordData(void) {
 2597: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2598: 
 2599:    if (isDry2()) return;
 2600: 
 2601:    if constexpr(ivcor == 2) {  // SZ coordinates
 2602:       
 2603:       // Compute bottom level index
 2604:       if (depth <= mesh->h_s) {
 2605:             kb = nzlev;
 2606:       } else {
 2607:          kb = -1;
 2608:          for (int i = 0; i <= nzlev; i++) {
 2609:             // XXX Use binary search
 2610:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2611:                kb = i;
 2612:                break;
 2613:             }
 2614:          }
 2615:       }
 2616:    } 
 2617:    else if (ivcor == 1) {  // Localized sigma
 2618:       // Do nothing
 2619:    }
 2620: 
 2621: }
 2622: 
 2623: __device__ double Node::compZCoord(int k) const {
 2624:    // Computes the z coordinate at level k.
 2625:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2626:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2627:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2628:    // used 
 2629:    
 2630:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2631: 
 2632:   
 2633:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2634: 
 2635:    if constexpr(ivcor == 2) {
 2636: 
 2637:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2638:       const double h_c = mesh->h_c;
 2639:       const double theta_f = mesh->theta_f;
 2640:       const double sinh_theta_f = mesh->sinh_theta_f;
 2641: 
 2642:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2643:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2644:       // once per time step/node.
 2645:       // CHECK: updateZCoordData
 2646: 
 2647:       if      (k == nvrt-1)           return eta2; 
 2648:       else if (k == nzlev)            return -hmod2;
 2649:       else if (k == kb)               return -depth;
 2650:       else if (k < nzlev && k >= 0)   return mesh->ztot[k];
 2651:       else if (k > nzlev) {
 2652:          const int ksig = k - nzlev + 1;
 2653: 
 2654:          if (hmod2 <= h_c) {
 2655: printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2656:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2657:          } 
 2658:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2659:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2660:             assert(false && "ZCOOR: invalid h_c\n");
 2661:          } 
 2662:          else {
 2663: printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2664:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2665:                          h_c * mesh->sigma[ksig] + 
 2666:                          (hmod2 - h_c) * mesh->cs[ksig];
 2667:          }
 2668:       } else { 
 2669:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2670:       }
 2671: 
 2672:    }
 2673:    else if constexpr(ivcor == 1) {
 2674:       if (k == kb) return -depth;
 2675:       else if (k == nvrt-1) return eta2;
 2676:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2677:    }
 2678:    
 2679:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2680:    return 0.0;
 2681: }
 2682: 
 2683: 
 2684: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2685:    // Checks if a side in on the boundary
 2686:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2687: 
 2688:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2689:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2690: 
 2691:    // Indices of the nodes that form the side
 2692:    const int n1 = side.n1->idx;
 2693:    const int n2 = side.n2->idx;
 2694: 
 2695:    // Check if the side is on a land boundary
 2696:    for (int i = 0; i < nland; i++) {
 2697:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2698:          // Consecutive nodes in the land boundary segment
 2699:          const int b1 = ilnd[i*mnlnd + j];
 2700:          const int b2 = ilnd[i*mnlnd + j + 1];
 2701: 
 2702:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2703:             isLand = true;
 2704:             return i;
 2705:          }
 2706:       }
 2707:    }
 2708: 
 2709:    // Check if the side is on an open boundary
 2710:    for (int i = 0; i < nope; i++) {
 2711:       for (int j = 0; j < nond[i] - 1; j++) {
 2712:          // Consecutive nodes in the open boundary segment
 2713:          const int b1 = iond[i*mnond + j];
 2714:          const int b2 = iond[i*mnond + j + 1];
 2715: 
 2716:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2717:             isLand = false;
 2718:             return i;
 2719:          }
 2720:       }
 2721:    }
 2722:    return -1;
 2723: }
 2724: 
 2725: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2726:                 double *node_coords, double *node_coords_ll, bool use_ll,
 2727:                 double *wind_rotate_angle, 
 2728:                 int *isdel, int *isidenode, int *isbnd,
 2729:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2730:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2731:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2732:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2733:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2734:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2735:                 double *drag, double *roughness,
 2736:                 double *emo, double *efa, 
 2737:                 double *umo, double *ufa, 
 2738:                 double *vmo, double *vfa) {
 2739: 
 2740:    printf("Populating mesh for partition %d\n", partNum);
 2741: 
 2742:    // Horizontal grid
 2743:    printf("Processing %d nodes\n", np);   
 2744: 
 2745:    
 2746:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 2747:    const double fc   = 2.0*omega_e*sin(sfea0);
 2748:    const double beta = 2.0*omega_e*cos(sfea0);
 2749: 
 2750: 
 2751:    int idxNodeBoundary = 0;  
 2752:    for (int i = 0; i < np; i++)
 2753:    {
 2754:       Node &node = localNodeData[i];
 2755: 
 2756:       node.idx = i;
 2757: 
 2758:       const int idxNodeStart = nodeNeighNodesStart[i];
 2759:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2760:       node.numNodes = idxNodeEnd - idxNodeStart;
 2761:       node.nodes = nodeNeighNodes + idxNodeStart;
 2762:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2763: 
 2764: 
 2765: 
 2766:       const int idxElemStart = nodeNeighElemsStart[i];
 2767:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2768:       node.numElements = idxElemEnd - idxElemStart;
 2769:       node.elements = nodeNeighElems + idxElemStart;
 2770: 
 2771: 
 2772:       
 2773:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2774:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2775:          const int partNode = localNodePart[idxNodeGlobal]; 
 2776:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2777: 
 2778: 
 2779:          Node *node_ptr = nodes[partNode] + idxNode;
 2780:          
 2781:          nodeNeighNodes[idx] = node_ptr;
 2782:       }
 2783: 
 2784:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2785:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2786:          const int partElem = localElemPart[idxElemGlobal];
 2787:          const int idxElem  = localElemIndices[idxElemGlobal];
 2788: 
 2789:          Element *elem_ptr = elems[partElem] + idxElem;
 2790: 
 2791:          nodeNeighElems[idx] = elem_ptr;
 2792:       }      
 2793: 
 2794: 
 2795:       node.wind_angle = wind_rotate_angle[i];
 2796: 
 2797:       // Element **elements; // pointer to the elements connected to this node
 2798:       // int numElements;   // number of elements shared by this node
 2799: 
 2800:       node.p.x   = node_coords[i * 3];
 2801:       node.p.y   = node_coords[i * 3 + 1];
 2802:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2803:       node.depth = node_coords[i * 3 + 2];
 2804: 
 2805:       node.numSides = 0;
 2806: 
 2807:       node.Cd = drag[i];
 2808:       node.rough = roughness[i];
 2809:       for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 2810: 
 2811:       // Links the node to the boundary information
 2812:       if (isbnd[i] >= 0) {
 2813:        
 2814:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2815:          node.nodeBnd->node = &node;
 2816: 
 2817:          node.nodeBnd->sideBnd1 = nullptr;
 2818:          node.nodeBnd->sideBnd2 = nullptr;
 2819: 
 2820:          if (isbnd[i]>=0) {
 2821: 
 2822:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2823:             
 2824:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2825:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2826: 
 2827:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2828:             node.nodeBnd->segment->clen  = nan("1");
 2829:             node.nodeBnd->segment->carea = nan("1");
 2830: 
 2831:          }
 2832: //          else {  XXXXXX
 2833: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2834: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2835: //          }
 2836:          
 2837:          idxNodeBoundary++;
 2838:       }
 2839:       else {
 2840:          node.nodeBnd = nullptr; // For internal nodes
 2841: 
 2842:          if (isbnd[i] == landSegment) {
 2843:             node.nodeBnd = &landBoundaryNode;
 2844:             node.nodeBnd->segment = &landBoundarySegment;
 2845:          }
 2846:          // node.nodeBnd->node = &node;
 2847:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2848:          // // node.nodeBnd = nullptr;
 2849:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2850:         
 2851:       }
 2852: 
 2853:       // XXXX GAUSSIAN HILL VELOCITIES
 2854: #ifdef GAUSSIAN_HILL_VELOCITIES
 2855:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2856:          constexpr double rot_per = 3000.0;
 2857:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2858:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2859:       // XXXXX
 2860: #endif
 2861:    }
 2862: 
 2863:    nbp = idxNodeBoundary;
 2864: 
 2865:    printf("Processing %d sides\n", ns);
 2866:    int idxSideBoundary = 0;
 2867:    for (int i = 0; i < ns; i++)
 2868:    {
 2869:       Side &side = localSideData[i];
 2870:       side.idx = i;
 2871:       // finding the pointer to the nodes that form the side
 2872:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2873:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2874: 
 2875:       const int locidx_n1 = localNodeIndices[idx_n1];
 2876:       const int locidx_n2 = localNodeIndices[idx_n2];
 2877:       const int part_n1 =   localNodePart[idx_n1];
 2878:       const int part_n2 =   localNodePart[idx_n2];
 2879: 
 2880:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2881:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2882: 
 2883:       // Counts the number of sides connected to each node
 2884:       side.n1->numSides++;
 2885:       side.n2->numSides++;
 2886: 
 2887:       // Normal, unitary vector to the side
 2888:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2889:       side.n = normalize(side.n);
 2890: 
 2891:       // Side boundary type
 2892:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2893:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2894: 
 2895:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2896:       // If both nodes are on the boundary, then the side may be on the boundary
 2897:       {
 2898:          bool isLand = false;
 2899:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2900: 
 2901:          if (isbs > -1) {
 2902:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2903:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2904:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2905: 
 2906:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2907:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2908:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2909: 
 2910:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2911:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2912:           
 2913:             side.sideBnd->side = &side;
 2914:             idxSideBoundary++;
 2915: 
 2916:          }
 2917:          
 2918: 
 2919:       // }
 2920:       // 
 2921: 
 2922: 
 2923: 
 2924: 
 2925: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2926: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2927: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2928: //       {
 2929: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2930: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2931: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2932: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2933: // if (side.sideBnd->segment == nullptr) continue;
 2934: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2935: //          else                  side.sideBnd->segment = n2bnd->segment;
 2936: //          side.sideBnd->side = &side;
 2937: //          idxSideBoundary++;
 2938: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2939:       }
 2940:       else side.sideBnd = nullptr;
 2941: 
 2942:       nbs = idxSideBoundary;
 2943: 
 2944:       // finding the pointer to the elements that share the side
 2945:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2946:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2947: 
 2948:       if (idx_e1 > -1) {
 2949:          const int locidx_e1 = localElemIndices[idx_e1];
 2950:          const int part_e1 =  localElemPart[idx_e1];
 2951:          side.elems[0] = elems[part_e1] + locidx_e1;
 2952: 
 2953:       }
 2954:       else {
 2955:          side.elems[0] = nullptr;
 2956:       }
 2957: 
 2958:       if (idx_e2 > -1) {
 2959:          const int locidx_e2 = localElemIndices[idx_e2];
 2960:          const int part_e2 =  localElemPart[idx_e2];
 2961:          side.elems[1] = elems[part_e2] + locidx_e2;
 2962:       }
 2963:       else {
 2964:          side.elems[1] = nullptr;
 2965:       }
 2966: 
 2967:       // Compute the center of the side
 2968:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2969: 
 2970:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 2971:       side.shapiro = shapiro0;
 2972: 
 2973: #ifdef GAUSSIAN_HILL_VELOCITIES
 2974: // XXXX
 2975: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2976: constexpr double rot_per=3000.0;
 2977: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2978: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2979: // XXXXX      
 2980: #endif
 2981:       // Compute the z level at the center of the side
 2982:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2983: 
 2984:       // Compute the length of the side
 2985:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2986:       side.len = sqrt(dot(vLen, vLen));
 2987: 
 2988: 
 2989:       // Compute the Coriolis coefficient
 2990: 
 2991:       if constexpr(ncor == -1 || ncor == 0) {
 2992:          side.coriolis = coricoef;
 2993:       }
 2994:       else {
 2995:          const double sphi = side.lat();  // Latitude at the center of the side
 2996: 
 2997:          if constexpr(ics == 1) {
 2998:             side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 2999:          }
 3000:          else {
 3001:             side.coriolis = 2.0*omega_e*sin(sphi);
 3002:          }
 3003:       }
 3004: 
 3005: 
 3006:    }
 3007: 
 3008:    printf("Processing %d elements\n", ne);
 3009:    for (int i = 0; i < ne; i++)
 3010:    {
 3011:       Element &elem = localElemData[i];
 3012:       elem.idx = i;
 3013:       for (int j = 0; j < i34[i]; j++) {
 3014:          const int idxNode = elnode[i*4 + j];  
 3015:          const int idxSide = elside[i*4 + j];
 3016:          
 3017:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3018:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3019: 
 3020: 
 3021: 
 3022:          // Find the neighboring element  
 3023:          if (elem.sides[j]->elems[0] == &elem) {
 3024:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3025:          }
 3026:          else {
 3027:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3028:          }
 3029:          
 3030:       }
 3031: 
 3032:       elem.i34 = i34[i];
 3033: 
 3034:       // Compute the centroid of the element and its depth
 3035:       Vector2 center = {0.0, 0.0};
 3036:       elem.depth = 0.0;
 3037:       for (int j = 0; j < i34[i]; j++) {
 3038:          center += elem.nodes[j]->p2()/i34[i];
 3039:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3040:       }
 3041:       elem.center.x = center.x;
 3042:       elem.center.y = center.y;
 3043: 
 3044: 
 3045:       
 3046:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3047:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3048: 
 3049:       elem.area = elem.computeSignedArea(); 
 3050:       elem.radius = sqrt(elem.area)/pi; 
 3051:       
 3052:       // Determines which way the normal vector to each side is oriented.
 3053:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3054:       for (int j = 0; j < i34[i]; j++)  
 3055:       {
 3056:          if (elem.sides[j]->elems[0] == &elem) {
 3057:             elem.ssign[j] =  1.0;
 3058:          }
 3059:          else {
 3060:             elem.ssign[j] = -1.0;
 3061:          }
 3062: 
 3063:       }
 3064: 
 3065:       // Derivatives of shape functions
 3066:       //  For ics=2, this is done inside element/ll frame XXX
 3067:       //  For quads, the derivative is evaluated at centroid
 3068:       const int i34 = elem.i34;
 3069:       for (int j = 0; j < i34; j++) {
 3070:          const double area = elem.area;
 3071:          const int id2 = elem.nxq(1 + j);
 3072:          const int id3 = elem.nxq(2 + j);
 3073:          const int id4 = elem.nxq(3 + j);
 3074:          if (elem.isTri()) {
 3075:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3076:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3077:             // da1/dx = (y1 - y2)/(2*area)
 3078:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3079:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3080:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3081:          }
 3082:          else  { // Quad; evaluate at centroid
 3083:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3084:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3085:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3086:          } // if Tri
 3087: 
 3088:       } // for j
 3089: 
 3090:    }
 3091: 
 3092: 
 3093:    // Processing the boundary nodes
 3094:    int idx = 0;
 3095:    for (int iseg = 0; iseg < nope; iseg++) {
 3096:       // for each segment...
 3097:       
 3098:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3099:          // for each node on the segment...
 3100: 
 3101:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3102: 
 3103:          nodeBnd->isEssentialBC = true;
 3104:          nodeBnd->elbc = 0.0;
 3105: 
 3106:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3107: 
 3108:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3109:             nodeBnd->efa[jfr] = efa[idx];
 3110:             nodeBnd->emo[jfr] = emo[idx];
 3111:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3112:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3113: 
 3114:          }
 3115: 
 3116:          idx++;
 3117:       }
 3118: 
 3119:    }
 3120: 
 3121: }
 3122: 
 3123: 
 3124: 
 3125: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3126:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3127:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3128:    // 
 3129:    // This kernel is called for all nodes.
 3130: 
 3131: 
 3132:    NODE(node1);
 3133: 
 3134: 
 3135:    node1->clearMatrixRow();
 3136:    node1->qel = 0.0;
 3137: 
 3138:    // THIS IS FOR STRUCTURES XXX
 3139:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3140: 
 3141:    
 3142:    for (int j=0; j<node1->numElements; j++) {
 3143:       // For each element connected to the node...
 3144: 
 3145:       Element *elem = node1->elements[j];
 3146: 
 3147:       // Compute the average gravity
 3148:       const double grav3 = elem->mean(&Node::grav2);
 3149: 
 3150:       // Look at the documentation for the description of the terms in the following integrals
 3151: 
 3152:       // Integral I_1 
 3153:       // \bar{\breve{H}} 
 3154:       const double hhatb = elem->mean(&Side::hhat);        
 3155: 
 3156: 
 3157:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3158: 
 3159:       const int id1 = elem->nodeLocalIdx(node1); 
 3160:       const double area = elem->area;
 3161: 
 3162:       if (elem->isTri()) {
 3163: 
 3164:          // To clarify the notation in this section: 
 3165:          //   i stands for the node under consideration (node1)
 3166:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3167:          const int id2 = elem->nxq(1 + id1);
 3168:          const int id3 = elem->nxq(2 + id1);
 3169:          Node *node2 = elem->nodes[id2];
 3170:          Node *node3 = elem->nodes[id3];
 3171: 
 3172:          const Point2 x1 = node1->p2();
 3173:          const Point2 x2 = node2->p2();
 3174:          const Point2 x3 = node3->p2();
 3175: 
 3176:          // integral of phi_i*phi_j
 3177:          const double ipp_ii = (1.0/6.0 )*area;
 3178:          const double ipp_ij = (1.0/12.0)*area;
 3179:          const double ipp_ik = (1.0/12.0)*area;
 3180: 
 3181:          // integral of [(grad phi_i) * (grad phi_j)]
 3182:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3183:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3184:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3185: 
 3186:          // Computes the different components of integral I_1 of each node with respect to node i.
 3187:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3188:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3189:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3190: 
 3191:          node1->addToSparseMatrix(node1, I1_ii);
 3192:          node1->addToSparseMatrix(node2, I1_ij); 
 3193:          node1->addToSparseMatrix(node3, I1_ik);
 3194: 
 3195:       }
 3196:       else { // Quad
 3197:          // XXX IMPLEMENT THIS
 3198:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3199:       } 
 3200: 
 3201:  
 3202:       // Integral I_4
 3203:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3204:       // Where
 3205:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3206: 
 3207:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3208:       // of U over the element.
 3209:       Vector2 Umean = {0.0, 0.0};
 3210:       for (int m=0; m<elem->i34; m++) {      
 3211:          const Side *side = elem->sides[m];
 3212: 
 3213:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3214:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3215:       }
 3216:       Umean = Umean/elem->i34;
 3217: 
 3218:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3219: 
 3220:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3221:       const double I_4_1 = dot(gradPhi_1, Umean);
 3222: 
 3223:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3224:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3225:      
 3226: // printf(">>> k = %d, node idx = %d, elem->idx = %d, Umean = %.15e,%.15e, I_4_1 = %.15e, I_4_2 = %.15e, node1->qel = %.15e\n", j, node1->idx, elem->idx, Umean.x, Umean.y, I_4_1, I_4_2, dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2));
 3227: // printf(">>> k = %d, node idx = %d, elem->idx = %d, ghat1 = %.15e,%.15e, gradPhi = %.15e,%.15e\n", j, node1->idx, elem->idx, elem->ghat1.x, elem->ghat1.y, gradPhi_1.x, gradPhi_1.y);
 3228:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3229: 
 3230:       // Additional terms 
 3231:       double vnorm = 0.0;
 3232:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3233:          Vector3 ubed;
 3234:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3235: 
 3236:          Vector3 gradP = {0.0, 0.0, 1.0};
 3237:          for (int m=0; m < elem->i34; m++) {
 3238:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3239:            gradP += toVector3(gradP_2D, 0.0);
 3240:          }   
 3241:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3242:       } // imm==2
 3243: 
 3244:       if (elem->isTri()) {
 3245:          for (int l=0; l<3; l++) {
 3246:             double fac;
 3247: 
 3248:             Node *node = elem->nodes[l];
 3249: 
 3250:             fac = (node == node1) ? 2.0 : 1.0;
 3251:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3252:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3253: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3254:            
 3255:          }
 3256: 
 3257: 
 3258:          if (!elem->isDry) {
 3259:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3260: 
 3261:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3262: // printf("BBB>>>  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta) = %.15e\n",  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta));
 3263:          }
 3264: 
 3265:       } // isTri
 3266:       else { // isQuad
 3267:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3268:          // for (int l=0; l<4; l++) {
 3269:          //   const Node *node = elem->nodes[l];
 3270: 
 3271:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3272:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3273: 
 3274:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3275:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3276:          // }
 3277: 
 3278:       } // isQuad
 3279: 
 3280: 
 3281:       node1->qel += (dt/elem->i34)*elem->vsource;
 3282:       
 3283: 
 3284:    } // for all elements connected to the node
 3285:    
 3286: 
 3287: 
 3288:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3289:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3290:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3291:    if (nodeBnd != nullptr)  { 
 3292:       // If it is an open boundary node...
 3293: 
 3294:       // At least one open bnd side, maybe two
 3295:       for (int l=0; l<2; l++) { 
 3296: 
 3297:          // Gets each of the sides sharing the node. 
 3298:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3299: 
 3300:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3301: 
 3302:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3303: 
 3304:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3305:          if (sideBnd != nullptr) {
 3306:             // If the side is on a boundary...
 3307: 
 3308:             // Get the boundary segment
 3309:             const BoundarySegment *sideSegment = sideBnd->segment;
 3310:             const Side *side = sideBnd->side;
 3311: 
 3312:             // Integral I_3
 3313:             if (sideSegment->ifltype != 0) {
 3314:             // Natural or Flather b.c.
 3315: 
 3316:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3317:                // especially for Flather b.c.
 3318:                double ri3 = 0.0;
 3319:                if (!side->isDry) {
 3320:                   // If the side is not dry
 3321:                   
 3322:                   // Computes the side flux of (uth, vth)
 3323:                   double Vn = 0.0;
 3324:                   for (int k = side->kb; k<nvrt-1; k++) {
 3325:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3326:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3327: 
 3328:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3329:                   }
 3330: 
 3331:                   ri3 = 0.5*side->len*Vn;
 3332:                }
 3333: 
 3334:                if (sideSegment->ifltype == -1) { // Flather 1
 3335: 
 3336:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3337:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3338: 
 3339:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3340:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3341:                   
 3342:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3343:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3344: 
 3345:                } 
 3346:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3347:                   // Reset ri3
 3348:                   ri3 = 0.0;
 3349: 
 3350:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3351: 
 3352:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3353: 
 3354:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3355:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3356: 
 3357:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3358:                   node1->addToSparseMatrix(node1, con0*2.0);
 3359:                   node1->addToSparseMatrix(node2, con0);
 3360: 
 3361:                } // if Flather or Discharge
 3362: 
 3363:                node1->qel -= thetai*dt*ri3;
 3364: 
 3365:             } // I_3
 3366:           
 3367: 
 3368:             // Integral I_5
 3369:             if(!side->isDry) {
 3370: 
 3371:                const double Unbar = dot(side->U, side->n);
 3372:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3373: 
 3374:             } // I_5
 3375: 
 3376:          } // if is boundary side
 3377: 
 3378:       } // for l
 3379: 
 3380:    } // if isbnd
 3381: 
 3382: 
 3383: }
 3384: 
 3385: 
 3386: 
 3387: extern "C" {
 3388:    __global__ void rollUpElevation(void) {
 3389: 
 3390:       NODE(node);
 3391: 
 3392:       node->eta1 = node->eta2;
 3393: 
 3394:    }
 3395: 
 3396: 
 3397:    __global__ void backtrackAllNodes(void) {
 3398: 
 3399:       // max/min # of sub-divisions
 3400:       const int ndelt_max = max(1.0, dt/dtb_min);
 3401:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3402: 
 3403:       // Removed all references to swild98 XXX
 3404:       // swild98=0.d0 !init
 3405: 
 3406: 
 3407:       SIDE(side);
 3408: 
 3409:       const int kb = side->kb;
 3410: 
 3411: 
 3412: 
 3413:       // Initialize btrack velocities to the actual velocities at the side 
 3414:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3415: 
 3416:       if (side->isDry) return;
 3417: 
 3418: 
 3419:       // Checks that at least one element is not dry
 3420:       const Element *elem1 = side->elems[0];
 3421:       const Element *elem2 = side->elems[1];
 3422: 
 3423: 
 3424:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3425:       
 3426:       // XXXXXX
 3427:       // !swild_tmp to store global coord. of the starting side
 3428:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3429:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3430:       // !Use sframe2 
 3431:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3432: 
 3433: 
 3434:       for (int k = kb; k < nvrt; k++) {
 3435:       //  Initialize (xt,yt,zt), nnel and vel.
 3436:       //  For ics=2, the coordinates are in local frames
 3437:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3438: 
 3439: 
 3440:          const int iadvf = side->iadv();  // Advection flag
 3441: 
 3442:          Point3 xt;
 3443:          if constexpr(ics==1) {
 3444:             xt = side->center3D(k); 
 3445:          }
 3446:          else // lat/lon; in side lat/lon frame
 3447:          {
 3448:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3449:          // XXX IMPLEMENT THIS
 3450:       //          xt=0.d0
 3451:       //          yt=0.d0
 3452:       //          !centroid coord. for nudging
 3453:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3454:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3455:          }  // ics
 3456: 
 3457: 
 3458: 
 3459:          // If on land or open boundary...
 3460:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3461:          
 3462:          const double vmag = length(side->u2[k]);
 3463: 
 3464:          if (vmag <= velmin_btrack) {
 3465:             // No activity 
 3466: 
 3467:             side->btu[k] = side->u2[k];
 3468:             
 3469:          } else {  // do btrack
 3470: 
 3471:             // Compute number of sub-divisions based on local gradients 
 3472:             // XXX IS THIS NECESSARY?
 3473:             double suma = 0.0;
 3474:             int icount = 0;
 3475:             for (int ii=0; ii<2; ii++) {
 3476: 
 3477:                const Element *elem = side->elems[ii];
 3478:                  
 3479:                if (elem == nullptr) continue;
 3480: 
 3481:                icount++;
 3482: 
 3483:                // Not strictly along z; in ll frame for ics=2
 3484: 
 3485:                double utmp[4];
 3486:                double vtmp[4];
 3487:                for (int jj = 0; jj < elem->i34; jj++) {
 3488: 
 3489:                   const Node *node = elem->nodes[jj];
 3490: 
 3491:                   if constexpr(ics==1) {
 3492:                      utmp[jj] = node->u2[k].x;
 3493:                      vtmp[jj] = node->u2[k].y;  
 3494:                   } else {
 3495:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3496:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3497:                   }
 3498:                } // for jj
 3499: 
 3500:                const Vector2 grad_u = elem->grad2(utmp); 
 3501:                const Vector2 grad_v = elem->grad2(vtmp);
 3502: 
 3503:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3504:             } // for ii
 3505: 
 3506:             assert(icount > 0 && "Impossible 77");
 3507: 
 3508:             // '4' is somewhat arbitrary
 3509:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3510: 
 3511:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3512:          
 3513: 
 3514:             Vector3 u_int = {0.0, 0.0, 0.0};
 3515: 
 3516:             side->btrack(k, dt, dtbk, u_int);
 3517:             side->btu[k] = toVector2(u_int);
 3518:                
 3519:          } // if vmag (do backtrack)
 3520: 
 3521:       } // for j=jmin,nvrt-1
 3522: 
 3523:    }
 3524: } // extern "C"
 3525: 
 3526: template<int nc>
 3527: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3528: 
 3529: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3530: //
 3531: // a,b,c,rhs: input vectors and are not modified by this program.
 3532: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3533: // rhs is the r.h.s.
 3534: // n: actual rank of the system.
 3535: // rows in u() and rhs();
 3536: // u: output with nc columns (transposed to rows)
 3537: // gam: a working array.
 3538: //
 3539: // NOTES:
 3540: // This is a template function that allows for different numbers of columns in the rhs vector.
 3541: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3542: 
 3543:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3544:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3545: 
 3546:    double bet = b[0];
 3547:    if constexpr (nc == 1) {
 3548:       u[0] = rhs[0]/bet;
 3549:    } else {
 3550:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3551:    }
 3552: 
 3553:    for (int j = 1; j < n; j++) {
 3554:       gam[j] = c[j-1]/bet;
 3555:       bet = b[j] - a[j]*gam[j];
 3556: 
 3557:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3558: 
 3559:       if constexpr (nc == 1) {
 3560:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3561:       } else {
 3562:          for (int k = 0; k < nc; k++) {
 3563:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3564:          }
 3565:       }
 3566:    }
 3567: 
 3568:    // Back-substitution
 3569:    for (int j=n-1; j>=1; j--) {
 3570:       if constexpr (nc == 1) {
 3571:          u[j] = u[j] - gam[j+1]*u[j-1];
 3572:       } else {
 3573:          for (int k = 0; k < nc; k++) {
 3574:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3575:          }
 3576:       }
 3577:    }
 3578: }
 3579: 
 3580: 
 3581: 
 3582: // Helper function that contains the core algorithm
 3583: template<typename XAccessor, typename YAccessor>
 3584: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3585:                                     double  yp_top, double  yp_bot, 
 3586:                                     CubicSpline &spline) {
 3587:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3588:    // 
 3589:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3590:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3591:    //
 3592:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3593:    // 
 3594:    // Inputs: 
 3595:    //            n: dimension for x etc; # of data pts (>=2);
 3596:    //            getX, getY: functions to access x,y coordinates
 3597:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3598:    //     Output: 
 3599:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3600: 
 3601:    const int n = k2 - k1 + 1;
 3602:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3603: 
 3604:    // Allocate memory for the splines
 3605:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3606:    spline.x   = new double[n];
 3607:    spline.y   = new double[n];
 3608:    spline.yp  = new double[n];
 3609:    spline.ypp = new double[n];
 3610: 
 3611:    for (int k=k1; k<=k2; k++) {
 3612:       spline.x[k] = getX(k);
 3613:       spline.y[k] = getY(k);
 3614:    }
 3615: 
 3616:    // This is to simplify expressions later
 3617:    double *x = spline.x;
 3618:    double *y = spline.y;
 3619: 
 3620:    double *a = nullptr;
 3621:    double *b = nullptr;
 3622:    double *c = nullptr;
 3623:    double *gam = nullptr;
 3624:    double *rhs = nullptr;
 3625:    
 3626: 
 3627:       a = new double[n];   // Lower diagonal
 3628:       b = new double[n];   // Diagonal
 3629:       c = new double[n];   // Upper diagonal
 3630:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3631:       rhs = new double[n]; // Right-hand side
 3632: 
 3633:    for (int k=k1; k<=k2; k++) {
 3634:       if (k == k1) {
 3635:          // Bottom level
 3636:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3637:          b[k] = (x[k+1] - x[k])/3.0;
 3638:          c[k] = b[k]/2.0;
 3639:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3640:       } else if (k == n - 1) {
 3641:          // Top level (surface)
 3642:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3643:          b[k] = (x[k] - x[k-1])/3.0;
 3644:          a[k] = b[k]/2.0;
 3645:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3646:       } else {
 3647:          // Intermediate levels
 3648:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3649:          b[k] = (x[k+1] - x[k-1])/3.0;
 3650:          a[k] = (x[k  ] - x[k-1])/6.0;
 3651:          c[k] = (x[k+1] - x[k  ])/6.0;
 3652:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3653:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3654:       }
 3655:    }
 3656: 
 3657:    // Solve the tridiagonal system
 3658:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3659:    
 3660:    spline.yp[k1] = yp_bot;
 3661:    spline.yp[k2] = yp_top;
 3662: 
 3663:    // Compute rest of 1st derivatives using the splines
 3664:    for (int k=k1+1; k<k2; k++) {
 3665:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3666:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3667:    }
 3668:    
 3669:    delete[] a;
 3670:    delete[] b;
 3671:    delete[] c;
 3672:    delete[] gam;
 3673:    delete[] rhs;
 3674: 
 3675: }
 3676: 
 3677: // Array version
 3678: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3679:                                 double y_top, double y_bot, 
 3680:                                 CubicSpline &spline) {
 3681:    auto getX = [x] (int k) { return x[k]; };
 3682:    auto getY = [y] (int k) { return y[k]; };
 3683:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3684: }
 3685: 
 3686: // Lambda version - allows custom access patterns
 3687: template<typename XFunc, typename YFunc>
 3688: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3689:                                 double y_top, double y_bot,
 3690:                                 CubicSpline &spline) {
 3691:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3692: }
 3693: 
