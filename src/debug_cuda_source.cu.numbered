 3952: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3953:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3954:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3955:                 int *isdel, int *isidenode, int *isbnd,
 3956:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3957:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3958:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3959:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3960:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3961:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3962:                 double *drag, double *roughness,
 3963:                 double *emo, double *efa, 
