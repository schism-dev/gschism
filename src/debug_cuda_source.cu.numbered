 2153: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2154: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2155: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2156: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2157:    Vector2 grad = {0.0, 0.0};
 2158:    int count = 0;
 2159: 
 2160:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2161: 
 2162:    // First element
 2163:    if (elems[0] != nullptr && condition(elems[0])) {
 2164:       grad += elems[0]->grad2(field);
 2165:       count++;
 2166:    }
 2167: 
 2168:    // Second element
 2169:    if (elems[1] != nullptr && condition(elems[1])) {
 2170:       grad += elems[1]->grad2(field);
 2171:       count++;
 2172:    }
 2173: 
 2174:    if (count > 0) {
 2175:       grad = grad/count;
 2176:    }
 2177:    
 2178:    return grad;
 2179: }
 2180: 
 2181: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2182: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2183: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2184: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2185: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2186: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2187: 
 2188: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2189: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2190: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2191: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2192: 
 2193: __inline__ __device__ double  Side::etaMeanBnd(void) const { assert(n1->nodeBnd != nullptr && n2->nodeBnd != nullptr && "etaMeanBnd not assigned"); 
 2194:                                                              return 0.5*(n1->nodeBnd->eta_mean + n2->nodeBnd->eta_mean); }
 2195: 
 2196: 
 2197: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2198: 
 2199: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
