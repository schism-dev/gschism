 6357: #ifdef DONTCOMPILE
 6358: __device__ void computeVerticalAdvection(void) {
 6359:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6360: 
 6361:    sdbt(1:2,:,:)=0.d0
 6362: 
 6363:    const Side *side = FROM kernel;
 6364: 
 6365:    if(side->isDry) return;
 6366: 
 6367:    // If side is wet...
 6368: 
 6369: 
 6370:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6371:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6372:    double ws[nvrt] = {} // w @ side
 6373:    int icount = 0;
 6374:    for (int j=0; j<2; j++) {
 6375:       const Element *elem = side->elements[j];
 6376:        
 6377:       if(elem != nullptr) {
 6378:          icount++;
 6379:          for (int k=0; k<nvrt; k++) {
 6380:             ws[k] = ws[k] + elem->w[k];
 6381:          }
 6382:       }
 6383:    }  // for j
 6384: 
 6385:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6386:    ws = ws/icount;
 6387: 
 6388:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6389:    // Splines allow for a smooth transition between vertical levels.
 6390:    // Splines have continuity restrictions at the internal knots, but
 6391:    // we have to provide the 1st derivatives at the endpoints.
 6392:    const int kbs = side->kbs; 
 6393:    
 6394:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6395:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6396:    initCubicSpline(kbs, nvrt, side, ws, up)
 6397: 
 6398:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6399:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6400:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6401: 
 6402:    // Total advection (average onto side)
 6403:    const Node *node1 = side->nodes[0];
 6404:    const Node *node2 = side->nodes[1];
 6405:    for (int k=kbs(i); k<nvrt; k++) {
 6406: 
 6407:       if constexpr(ics==1) {
 6408:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6409:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6410:       } else {
 6411:          // XXX IMPLEMENT THIS
 6412:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6413:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6414:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6415:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6416:       }  // if ics
 6417: 
 6418: 
 6419:    }
 6420: }
 6421: #endif
 6422: 
 6423: 
 6424: extern "C" {
 6425:    __global__ void computeElemAverageGhat(void) {
 6426:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6427: 
 6428:       ELEM(elem);
 6429:       
 6430:       elem->ghat1= {0.0, 0.0};  
 6431: 
 6432:       if constexpr(ihydraulics != 0) {
 6433:          if (nhtblocks > 0 && elem->isblock) return;
 6434:       }
 6435: 
 6436:       if (elem->isDry) return;
 6437: 
 6438:       // Wet elements.
 6439:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6440:       // tidal potential, horizontal diffusion, and baroclinic etc
 6441:       // Remember to update both fb and F 
 6442:       // If ics=2, ghat1 are in eframe (ll)
 6443:       // cff1-3: coefficients for 2D/3D
 6444:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6445:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6446:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6447: 
 6448:       double av_cff1 = 0.0;  // av. for cff1
 6449:       double av_cff2 = 0.0;  // av. for cff2
 6450:       double av_cff3 = 0.0;  // av. for cff3
 6451:       double av_df = 0.0;  // av. for H^\alpha / H
 6452:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6453:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6454: 
 6455:       const int i34 = elem->i34;
 6456:       const int kb = elem->kb;
 6457: 
 6458:       for (int j=0; j<i34; j++) {
 6459:          // For each node and side in the element...
 6460: 
 6461:          const Node *node = elem->nodes[j];
 6462:          const Side *side = elem->sides[j];
 6463: 
 6464:          const double chi      = side->chi;
 6465:          const double veg_c2   = side->veg_c2;
 6466:          const double veg_beta = side->veg_beta;
 6467:          const double veg_h    = side->veg_h();
 6468:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6469: 
 6470:          // Node - const in elem
 6471:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6472:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6473: 
 6474:          if (elem->depth >= tip_dp) {
 6475:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6476:          }
 6477: 
 6478:          
 6479:          const double htot  = side->htot2();        // Total depth at the side
 6480:          const double zctr2 = side->zTopCanopy();  
 6481: 
 6482:          double cff1; 
 6483:          double cff2; 
 6484:          double cff3;   
 6485:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6486:          // coefficients applied to 2D/3D case 
 6487:             cff1 = side->hhat/htot;
 6488:             cff2 = 0.0;
 6489:             cff3 = 0.0;
 6490:          } else { //3D
 6491:             //Init for no-veg case
 6492:             cff1 = 1.0;
 6493:             cff2 = 1.0;
 6494:             cff3 = 0.0;
 6495: 
 6496:             if constexpr(iveg != 0) {
 6497:                // Computes coefficients used with vegetation terms G1, G2
 6498:                // cff1, cff3 are used for the first two terms in G1, G2:
 6499:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6500:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6501:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6502:                if(veg_h < 0.99*htot) { // submergent vegetation
 6503:                   cff1=1;
 6504:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6505:                   cff3 = veg_c;
 6506: 
 6507:                } else { // emergent vegetation
 6508:                   cff1 = 1.0/(1.0 + veg_c2);
 6509:                   cff2 = cff1;
 6510:                   cff3 = 0.0;
 6511: 
 6512:                }
 6513:             } // if iveg
 6514:          } //  2D/3D
 6515: 
 6516:          av_cff1 += cff1/i34;
 6517:          av_cff2 += cff2/i34;
 6518:          av_cff3 += cff3/i34;
 6519:          av_cff2_chi += cff2*chi/i34;
 6520:          av_cff3_chi += cff3*chi/i34;
 6521:          av_df += min(htot, veg_h)/(htot*i34);
 6522: 
 6523: 
 6524:          // btrack values: U^\star, U^{\star\alpha}
 6525:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6526:          Vector2 Ustar       = {0.0, 0.0}; 
 6527:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6528: 
 6529:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6530:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6531:          } else { //3D
 6532:             for (int k = side->kb; k < nvrt; k++) {
 6533:             
 6534:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6535:                Ustar += w2;
 6536: 
 6537:                if constexpr(iveg != 0) {
 6538:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6539:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6540:                        Ustar_alpha += zrat*w2; // XXXX
 6541:                    }
 6542:                }  // if iveg
 6543:             }  // for k
 6544:          }  //2D/3D
 6545:          
 6546: 
 6547:          // Add btrack & surface stress terms to \breve{G} first
 6548:          if constexpr(ics==1) {
 6549: 
 6550:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6551: 
 6552:          } else {
 6553:             // XXX IMPLEMENT THIS
 6554:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6555:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6556:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6557:          }  // if ics
 6558: 
 6559:          // Surface and bottom stress terms
 6560:          if constexpr(ics==1) {
 6561:             const Vector2 tau    = side->tau();
 6562:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6563: 
 6564:             // Term for surface and bottom stress
 6565:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6566: 
 6567:          } else {
 6568:             assert(false && "computeElemAverageGhat: Not implemented");
 6569:             // XXX IMPLEMENT THIS
 6570:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6571:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6572:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6573:             // tau_x=(vn1+tt1)/2.d0
 6574:             // tau_y=(vn2+ss1)/2.d0
 6575:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6576:          }  // if ics
 6577: 
 6578:          
 6579: 
 6580:          // All terms in F,F^\alpha,f_b except baroclinic
 6581:          // F, f_b: all explicit terms excluding vegetation 
 6582:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6583:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6584:          const double coriolis = side->coriolis;
 6585:          Vector2 F  =  coriolis*side->U;  // F_x
 6586:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6587:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6588: 
 6589:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6590:             
 6591:             for (int k = side->kb; k < nvrt; k++) {
 6592:                if (zctr2 > side->zc[k-1]) {
 6593:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6594:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6595:                    Fa +=  coriolis*w2*zrat;
 6596:                } // if zctr2
 6597:             } // k
 6598:          } // iveg
 6599: 
 6600:          // Integrate horizontal viscosity force vertically
 6601:          for (int k=side->kb + 1; k<nvrt; k++) {
 6602:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6603: 
 6604:             F += levelHorVisc;
 6605: 
 6606:             // Vegetation term
 6607:             if constexpr(iveg!=0) {
 6608:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6609:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6610:                   Fa += levelHorVisc*zrat;
 6611:                } 
 6612:             } // if iveg
 6613:          } // for k
 6614: 
 6615:          fb += side->nuGradU[side->kb];
 6616: 
 6617:          // Add to ghat1
 6618:          if constexpr(ics==2) {
 6619:             // XXX IMPLEMENT THIS
 6620:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6621:             // bigf1=vn1; bigf2=vn2
 6622:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6623:             // botf1=vn1; botf2=vn2
 6624:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6625:             // bigfa1=vn1; bigfa2=vn2
 6626:          } // if ics
 6627: 
 6628:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6629:       } // for j (nodes and sides)
 6630: 
 6631:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6632:          
 6633:       // Finish off terms in F, F^\alpha and f_b
 6634:       const double grav3 = elem->mean(&Node::grav2);
 6635:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6636: 
 6637: 
 6638:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6639:       for (int j=1; j<i34; j++) { 
 6640:          // For each side in the element...
 6641:          const Side *side = elem->sides[j];
 6642:          const double chi = side->chi;
 6643: 
 6644:          const double htot = side->htot2();
 6645:          const double veg_h = side->veg_h();
 6646:          const Vector2 F  = htot*fb;
 6647:          const Vector2 Fa = min(htot, veg_h)*fb;
 6648: 
 6649:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6650:       } // for j
 6651: 
 6652:       //botf1 etc are already in elem frame
 6653:       elem->ghat1 += tmp/i34;
 6654: 
 6655:       // Baroclinic force
 6656:       if constexpr(ibc==0) {
 6657:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6658: 
 6659:          Vector2 Fa = {0.0, 0.0};
 6660:          Vector2 intGradRho = {0.0, 0.0};
 6661:          
 6662:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6663:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6664:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6665: 
 6666:             // \in F [m^2/s/s]
 6667:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6668:          }
 6669: 
 6670:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6671:          const Vector2 F = av_df*Fa; //approx
 6672:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6673: 
 6674:       } // if ibc
 6675: 
 6676: 
 6677: 
 6678:    }
 6679: 
 6680: } // extern "C"
 6681: 
 6682: 
 6683: 
 6684: #ifdef DONTCOMPILE
 6685: __global__ void checkMassConservation(Tracers* sumtr) {
 6686: 
 6687:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6688: 
 6689:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6690: 
 6691:    Element *elem = &(mesh->localElemData[i]);
 6692: 
 6693:    // Skip dry elements
 6694:    if (elem->isDry) return;
 6695: 
 6696:    // Local sum array for this thread
 6697:    double localSum[N_TRACERS] = {0.0};
 6698: 
 6699:    // Sum over vertical levels for this element
 6700:    const int kbe = elem->kbe;
 6701:    const double area = elem->area;
 6702: 
 6703:    for (int k = kbe; k < nvrt; k++) {
 6704:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6705:       
 6706:       // Accumulate tracer mass
 6707:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6708:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6709:       }
 6710:    }
 6711: 
 6712:    
 6713: 
 6714:    //  This function returns per element sums. A reduction must be done on the host side.
 6715: }
 6716: 
 6717: 
 6718: __global__ void transport(void) {
 6719: 
 6720:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6721: 
 6722:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6723: 
 6724:    Element *elem = &(mesh->localElemData[ie]);
 6725: 
 6726:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6727: 
 6728:                for (int m=0; m<ntr; m++) {
 6729:                   for (int k=kbe(ie); k<nvrt; k++) {
 6730:                      // Calculate each polynomial's weight 
 6731:                      wm=0.d0; sum1=0.d0; 
 6732:                      wm1=0.d0; wm2=0.d0; 
 6733:                      for (int i=0; i<elem->nweno2; i++) {
 6734:                   
 6735:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6736:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6737:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6738:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6739:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6740:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6741:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6742:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6743:                      // -----------------Hu and Shu (1999)'s method----------------
 6744:                      b4=b1+b2+b3
 6745: 
 6746: //Error: add PRODUCTION CPP
 6747: #ifdef DEBUG
 6748:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6749:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6750:                     call parallel_abort(errmsg)
 6751:                   }
 6752: #endif
 6753: 
 6754:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6755:                   // !----test-------------- 
 6756:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6757:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6758:                   // !wm(i)=wm1(i)*wm2(i)
 6759:                   // !---------------------- 
 6760:                   sum1=sum1+wm(i)
 6761:                 } // end for i
 6762: 
 6763:                 wm=wm/sum1
 6764: 
 6765:                 for (int j=0; j<elem->i34; j++) {
 6766: 
 6767:                   const Side *side  = elem->sides[j];
 6768:                   const Node *node1 = side->n1;
 6769:                   const Node *node2 = side->n2;
 6770: 
 6771:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6772:                      trsd=0.d0
 6773:                      for (int kk=0; kk<nquad; kk++) {
 6774:                         for (int i=0; i<elem->nweno2; i++) {
 6775:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6776:                         } // end for i   
 6777:                      } // end for kk
 6778:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6779:                   } // outward flux
 6780:                } // end for j=1,i34(ie) ! side
 6781:             }
 6782:          }
 6783:               
 6784: 
 6785: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6786: //             //   calculate each polynomial's weight 
 6787: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6788: //                 wm=0.d0; sum1=0.d0
 6789: //                 do i=1,nweno1(ie) !for each polynomial
 6790: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6791: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6792: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6793: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6794: //                   wm(i)=b2
 6795: //                   sum1=sum1+b2
 6796: //                   !wm(i)=1.d0
 6797: //                   !sum1=sum1+1.d0
 6798: 
 6799: // // Error: PRODUCTION
 6800: // #ifdef DEBUG
 6801: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6802: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6803: //                     call parallel_abort(errmsg)
 6804: //                   endif
 6805: // #endif
 6806: 
 6807: //                 enddo !i
 6808: //                 wm=wm/sum1 !final weight
 6809: 
 6810:                 for (int j=0; j<elem->i34; j++) { // side
 6811:                   const Side *side = elem->sides[j];
 6812:                   const Node *node1 = side->n1;
 6813:                   const Node *node2 = side->n2;
 6814: 
 6815:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6816:                     trsd=0.d0
 6817:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6818:                       for (int i=0; i<elem->nweno1; i++) {
 6819:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6820:                       }
 6821:                     enddo //kk
 6822:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6823:                   } // outward flux
 6824:                 } // end for j=1,i34(ie) ! side
 6825:               } // end for k; ntr 
 6826: 
 6827:             else !simple upwind method
 6828:               do j=1,i34(ie)
 6829:                 jsj=elside(j,ie)
 6830:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6831:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6832:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6833:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6834:                   endif
 6835:                 enddo  !vertical layers
 6836:               enddo !j=1,i34(ie) ! side
 6837:             endif !order of accuracy
 6838: 
 6839:          //  enddo !ie
 6840: // !$OMP     end do
 6841: 
 6842: // !$OMP     master
 6843: //           !message passing
 6844: //           if (nproc>1) then
 6845: //             !make a copy of side concentrations
 6846: //             trsd_tmp0=trsd_tmp 
 6847: 
 6848: //             !this exchange routine swaps interface concentration between two partitions
 6849: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
