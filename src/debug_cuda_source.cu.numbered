  319: __device__ __forceinline__ double clamp(double x, double minval, double maxval) {
  320:    assert(minval <= maxval && "clamp: minval > maxval");
  321:    return fmin(fmax(x, minval), maxval);
  322: }
  323: 
  324: __device__ __forceinline__ int clamp(int x, int minval, int maxval) {
  325:    assert(minval <= maxval && "clamp: minval > maxval");
  326:    return max(minval, min(x, maxval));
  327: }
