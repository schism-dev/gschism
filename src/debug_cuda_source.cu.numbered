 1772: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1773:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1774: }
 1775: 
 1776: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1777:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1778: }   
 1779: 
 1780: __device__ __inline__ double min3(double a, double b, double c) {
 1781:    return min(a, min(b, c));
 1782: }
 1783: 
 1784: __device__ __inline__ double max3(double a, double b, double c) {
 1785:    return max(a, max(b, c));
 1786: }
 1787: 
 1788: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1789:    return min(a, min(b, min(c, d)));
 1790: }
