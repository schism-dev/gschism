 5310:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5311: 
 5312:       NODE_BND(nodeBnd);
 5313: 
 5314:       Node *node = nodeBnd->node;
 5315: 
 5316:       node->ETP = 0.0;
 5317: 
 5318:       // For all tidal potential components
 5319:       for (int j=0; j<ntip; j++) {
 5320: 
 5321:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5322: 
 5323:          node->ETP += nodeETP;
