 1777:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1778:       // Compute the different time ramps used in the code 
 1779:       // This function is performed by just one thread
 1780: 
 1781:       rampbc = 1.0;
 1782:       if constexpr(ibc == 0) {
 1783:          if (drampbc > 0.0) {
 1784:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1785:          } else {
 1786:             rampbc = 1.0;
 1787:          }
 1788:       }
 1789: 
 1790:       if (nws != 0) {
 1791:          if (drampwind > 0.0) {
 1792:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1793:          } else {
 1794:             rampwind = 1.0;
 1795:          }
 1796:       }
 1797: 
 1798:       if (drampwafo > 0.0) {
 1799:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1800:       } else {
 1801:          rampwafo = 1.0;
 1802:       }
 1803: 
 1804:       // For source/sinks
 1805:       if (if_source && dramp_ss > 0.0) {
 1806:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1807:       } else {
 1808:          ramp_ss = 1.0;
 1809:       }
 1810: 
 1811:       if (dramp > 0.0) {
 1812:          ramp = tanh(2.0*time/86400.0/dramp);
 1813:       } else {
 1814:          ramp = 1.0;
 1815:       }
 1816: 
 1817: 
 1818:    }
