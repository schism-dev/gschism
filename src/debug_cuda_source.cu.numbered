 3616: 
 3617: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3618:    // Computes the z coordinate at level k.
 3619:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3620:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3621:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3622:    // used 
 3623: 
 3624:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3625:    
 3626:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3627: 
 3628:    if (isDry2()) return 0.0;  
 3629: 
 3630:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3631: 
 3632:    if constexpr(ivcor == 2) {
 3633: 
 3634:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3635:       const double h_c = mesh->h_c;
 3636:       const double theta_f = mesh->theta_f;
 3637:       const double sinh_theta_f = mesh->sinh_theta_f;
 3638: 
 3639: 
 3640:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3641:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3642:       // once per time step/node. XXXX
 3643:       // CHECK: updateZCoordData
 3644: 
 3645:       //  To simplify comparisons, I define index versions of count variables.
 3646:       if      (k == ivrt)     return eta2; 
 3647:       else if (k == izlev)    return -hmod2;
 3648:       else if (k == kb)       return -depth;
 3649:       else if (k < izlev)     return mesh->ztot[k];
 3650:       else if (k > izlev) {
 3651:          const int ksig = k - izlev;
 3652: 
 3653:          if (hmod2 <= h_c) {
 3654:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3655: 
 3656:          } 
 3657:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3658:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3659:             assert(false && "compZCoord: invalid h_c\n");
 3660:          } 
 3661:          else {
 3662:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3663:                    h_c * mesh->sigma[ksig] + 
 3664:                    (hmod2 - h_c) * mesh->cs[ksig];
 3665:          }
 3666:       } else { 
 3667:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3668:       }
 3669: 
 3670:    }
 3671:    else {  // if constexpr(ivcor == 1)
 3672:       if (k <= kb)        return -depth; 
 3673:       else if (k == ivrt) return eta2;
 3674:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3675: 
 3676:    }
 3677:    
 3678:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3679:    return 0.0;
 3680: }
 3681: 
 3682: 
 3683: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3684:    // Computes the bottom drag Cd based on the selected nchi
 3685: 
 3686:    if constexpr(nchi == 0) {
 3687:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3688:       Cd = drag;  // Read from drag file
 3689: 
 3690:    } else if constexpr(nchi == 1) {
 3691:       // 
 3692: 
 3693:       bool ltmp = false; // for WBL iteration
 3694: 
 3695:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3696:       if (isDry || (rough == 0.0)) {
 3697:          Cd = 0.0;
 3698: 
 3699:       } else { //roughness >0 
 3700:          
 3701:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3702: 
 3703:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3704: 
 3705:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3706: 
 3707:       } // if rough
 3708: 
 3709:    } else if constexpr(nchi == -1) {
 3710:    // Manning 
 3711:  
 3712:       const double htot = max(hmin_man, htot2()); 
 3713:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3714: 
 3715:    } else {
 3716:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3717:       
 3718:    } // if nchi
 3719: 
 3720: }
 3721: 
 3722: 
 3723: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3724:    // Checks if a side in on the boundary
 3725:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3726: 
 3727:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3728:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3729: 
 3730:    // Indices of the nodes that form the side
 3731:    //
 3732:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3733:    const int n1 = side.n1->idx;
 3734:    const int n2 = side.n2->idx;
 3735:    isLand = false;
 3736:    
 3737: 
 3738:    // Check if the side is on a land boundary
 3739:    for (int i = 0; i < nland; i++) {
 3740:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3741:          // Consecutive nodes in the land boundary segment
 3742:          const int b1 = ilnd[i + j*nland];
 3743:          const int b2 = ilnd[i + (j + 1)*nland];
 3744: 
 3745:          assert(b1 != -1 && b2 != -1);
 3746: 
 3747:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3748:             
 3749:             isLand = true;
 3750:             return i;
 3751:          }
 3752:       }
 3753:    }
 3754: 
 3755:    // Check if the side is on an open boundary
 3756:    for (int i = 0; i < nope; i++) {
 3757:       for (int j = 0; j < nond[i] - 1; j++) {
 3758:          // Consecutive nodes in the open boundary segment
 3759:          const int b1 = iond[i + j*nope];
 3760:          const int b2 = iond[i + (j + 1)*nope];
 3761: 
 3762:          assert(b1 != -1 && b2 != -1);
 3763: 
 3764:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3765:             isLand = false;
 3766:             return i;
 3767:          }
 3768:       }
 3769:    }
 3770: 
 3771:    return -1;
 3772: }
 3773: 
 3774: 
 3775: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3776:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3777:                                     double *wind_rotate_angle, 
 3778:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3779:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3780:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3781:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3782:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3783: 
 3784:    NODE(pnode);  
 3785:    const int i = idx_node;
 3786:    Node &node(*pnode);
 3787: 
 3788:    node.idx = i;
 3789: 
 3790:    const int idxNodeStart = nodeNeighNodesStart[i];
 3791:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3792:    node.numNodes = idxNodeEnd - idxNodeStart;
 3793:    node.nodes = nodeNeighNodes + idxNodeStart;
 3794:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3795: 
 3796: 
 3797: 
 3798:    const int idxElemStart = nodeNeighElemsStart[i];
 3799:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3800:    node.numElements = idxElemEnd - idxElemStart;
 3801:    node.elements = nodeNeighElems + idxElemStart;
 3802: 
 3803: 
 3804:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3805:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3806:       const int partNode = localNodePart[idxNodeGlobal]; 
 3807:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3808: 
 3809:       Node *node_ptr = nodes[partNode] + idxNode;
 3810:       
 3811:       nodeNeighNodes[idx] = node_ptr;
 3812:    }
 3813: 
 3814: 
 3815:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3816:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3817:       const int partElem = localElemPart[idxElemGlobal];
 3818:       const int idxElem  = localElemIndices[idxElemGlobal];
 3819: 
 3820:       Element *elem_ptr = elems[partElem] + idxElem;
 3821: 
 3822:       nodeNeighElems[idx] = elem_ptr;
 3823:    }      
 3824: 
 3825:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3826:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3827: 
 3828:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3829: 
 3830:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3831:    if constexpr(ics == 1) {
 3832:       node.p.x   = node_coords[i * 3];
 3833:       node.p.y   = node_coords[i * 3 + 1];
 3834:       node.gz = 0.0;
 3835: 
 3836:       if (use_ll) {                                    // <-- add
 3837:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3838:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3839:       }  
 3840: 
 3841:    } else {
 3842:       const double lon = deg2rad*node_coords[i * 3];
 3843:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3844: 
 3845:       Point3 p = computeXYZfromLatLon(lat, lon);
 3846:       node.p = toVector2(p);
 3847:       node.gz = p.z;
 3848:       node.lon = lon;
 3849:       node.lat = lat;
 3850: 
 3851:       #ifdef USE_FRAMES
 3852:       node.setFrame(lat, lon);
 3853:       #endif
 3854: 
 3855: 
 3856:    }
 3857: 
 3858:    node.depth = node_coords[i * 3 + 2];
 3859: 
 3860:    node.numSides = 0;
 3861: 
 3862:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3863:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3864:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3865:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3866:    else assert(false && "populateNodes: selected nchi not implemented.");
 3867: 
 3868:    if constexpr(ivcor == 1) 
 3869:    {  
 3870:       node.kb = kb[i];
 3871: 
 3872:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3873:    }
 3874: 
 3875:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3876:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3877:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3878: 
 3879:    
 3880:    // Links the node to the boundary information
 3881:    if (isbnd[i] >= 0) {
 3882:      
 3883:       // Get the index of the node boundary
 3884:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3885: 
 3886:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3887:       node.nodeBnd->node = &node;
 3888: 
 3889:       node.nodeBnd->sideBnd1 = nullptr;
 3890:       node.nodeBnd->sideBnd2 = nullptr;
 3891: 
 3892:       if (isbnd[i]>=0) {
 3893: 
 3894:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3895:          
 3896:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3897:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3898: 
 3899:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3900:          node.nodeBnd->segment->clen  = nan("1");
 3901:          node.nodeBnd->segment->carea = nan("1");
 3902: 
 3903:       }
 3904:    } else {
 3905: 
 3906:       node.nodeBnd = nullptr; // For internal nodes
 3907: 
 3908:       if (isbnd[i] == landSegment) {
 3909:          node.nodeBnd = &landBoundaryNode;
 3910:          node.nodeBnd->segment = &landBoundarySegment;
 3911:       }
 3912:       
 3913:    }
 3914:    
 3915:    // XXXX GAUSSIAN HILL VELOCITIES
 3916:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3917:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3918:          constexpr double rot_per = 3000.0;
 3919:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3920:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3921:       // XXXXX
 3922:    #endif
 3923: 
 3924: }
 3925: 
 3926: 
 3927: 
 3928: 
 3929: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3930:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3931:                                     double *wind_rotate_angle,   
 3932:                                     int *isdel, int *isidenode, int *isbnd,
 3933:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3934:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3935:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3936:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3937:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3938:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3939:                                     double *drag, double *roughness) {
 3940: 
 3941: 
 3942:    SIDE(pside);
 3943:    Side &side(*pside);
 3944:    const int i = idx_side;
 3945: 
 3946:    side.idx = i;  
 3947:    
 3948:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3949:    const double fc   = 2.0*omega_e*sin(sfea0);
 3950:    const double beta = 2.0*omega_e*cos(sfea0);
 3951: 
 3952:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3953: 
 3954:    // finding the pointer to the nodes that form the side
 3955:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3956:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3957: 
 3958:    const int locidx_n1 = localNodeIndices[idx_n1];
 3959:    const int locidx_n2 = localNodeIndices[idx_n2];
 3960:    const int part_n1 =   localNodePart[idx_n1];
 3961:    const int part_n2 =   localNodePart[idx_n2];
 3962: 
 3963:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3964:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3965: 
 3966: 
 3967:    // Counts the number of sides connected to each node
 3968:    atomicAdd(&side.n1->numSides, 1);
 3969:    atomicAdd(&side.n2->numSides, 1);
 3970: 
 3971:    // Side boundary type
 3972:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3973:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3974: 
 3975:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3976:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3977:    {
 3978:       bool isLand = false;
 3979:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3980:       
 3981:       if (isbs > -1) {
 3982:          // assert(isLand || isbs>=0);
 3983:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3984: 
 3985:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3986: 
 3987:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3988:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3989: 
 3990:          assert (isLand == side.sideBnd->segment->isLand);
 3991: 
 3992: printf("idx_side: %d, side.sideBnd = %p, n1bnd->idx: %d, n2bnd->idx: %d, n1bnd->sideBnd1: %p, n1bnd->sideBnd2: %p, n2bnd->sideBnd1: %p, n2bnd->sideBnd2: %p\n", i, side.sideBnd, n1bnd->idx, n2bnd->idx, n1bnd->sideBnd1, n1bnd->sideBnd2, n2bnd->sideBnd1, n2bnd->sideBnd2);
 3993: 
 3994:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3995:          // if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3996:          // else                            n1bnd->sideBnd2 = side.sideBnd;
 3997: 
 3998:          // if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3999:          // else                            n2bnd->sideBnd2 = side.sideBnd;
 4000:          
 4001:          side.sideBnd->side = &side;
 4002: 
 4003:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4004:          n1bnd->linkSideBoundary(side.sideBnd);
 4005:          n2bnd->linkSideBoundary(side.sideBnd);
 4006: 
 4007:       }
 4008:       else {
 4009:          side.sideBnd = nullptr;
 4010:       }
 4011:    }
 4012:    else 
 4013:    {
 4014:       side.sideBnd = nullptr;
 4015:    }
 4016: 
 4017: 
 4018:    // finding the pointer to the elements that share the side
 4019:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4020:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4021: 
 4022:    if (idx_e1 > -1) {
 4023:       const int locidx_e1 = localElemIndices[idx_e1];
 4024:       const int part_e1 =  localElemPart[idx_e1];
 4025:       side.elems[0] = elems[part_e1] + locidx_e1;
 4026: 
 4027:    }
 4028:    else {
 4029:       side.elems[0] = nullptr;
 4030:    }
 4031: 
 4032:    if (idx_e2 > -1) {
 4033:       const int locidx_e2 = localElemIndices[idx_e2];
 4034:       const int part_e2 =  localElemPart[idx_e2];
 4035:       side.elems[1] = elems[part_e2] + locidx_e2;
 4036:    }
 4037:    else {
 4038:       side.elems[1] = nullptr;
 4039:    }
 4040:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4041:       
 4042:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4043:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4044:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4045:          
 4046:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4047:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4048:       // printf("sideBnd: %p\n", side.sideBnd);
 4049:       // assert(false && "Side has no elements and no boundary");
 4050:    }
 4051:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4052: 
 4053:    // Compute the center of the side
 4054:    side.center = 0.5*(side.n1->p + side.n2->p);
 4055: 
 4056:    #ifdef USE_FRAMES
 4057:    side.setFrame();
 4058:    #endif
 4059: 
 4060:    // Normal, unitary vector to the side
 4061:    if constexpr(ics == 1) {
 4062:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4063:       side.n = normalize(side.n);
 4064:    }
 4065:    else {
 4066:       // Unit side vector in 3D cartesian coordinates
 4067:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4068: 
 4069:       nSide = normalize(nSide);
 4070: 
 4071:       // Its cross product with the unit local z-axis vector (nUp) is the
 4072:       // normal vector we are looking for.
 4073:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4074: 
 4075:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4076:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4077:       side.n = -normalize(n2D); 
 4078: 
 4079:    }
 4080: 
 4081:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4082:    side.shapiro = shapiro0;
 4083: 
 4084:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4085:    // XXXX
 4086:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4087:    constexpr double rot_per=3000.0;
 4088:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4089:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4090:    // XXXXX      
 4091:    #endif
 4092:    // Compute the z level at the center of the side
 4093:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4094:    
 4095:    // Compute the length of the side
 4096:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4097: 
 4098: 
 4099:    // Compute the Coriolis coefficient
 4100: 
 4101:    if constexpr(ncor == -1 || ncor == 0) {
 4102:       side.coriolis = coricoef;
 4103:    }
 4104:    else {
 4105:       const double sphi = side.lat();  // Latitude at the center of the side
 4106: 
 4107:       assert(use_ll && "use_ll must be true when ncor > 0");
 4108: 
 4109:       if constexpr(ics == 1) {
 4110:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4111:       }
 4112:       else { // ics == 2
 4113:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4114:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4115:       }
 4116: 
 4117:    }
 4118: 
 4119: }
 4120: 
 4121: 
 4122: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4123:    double *node_coords, double *node_coords_ll, bool use_ll,
 4124:    double *wind_rotate_angle,   
 4125:    int *isdel, int *isidenode, int *isbnd,
 4126:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4127:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4128:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4129:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4130:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4131:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4132:    double *drag, double *roughness) {
 4133: 
 4134:    ELEM(pelem);
 4135:    Element &elem(*pelem);
 4136:    const int i = idx_elem;
 4137: 
 4138:    elem.idx = i;
 4139: 
 4140:    for (int j = 0; j < i34[i]; j++) {
 4141:       const int idxNode = elnode[i*4 + j];  
 4142:       const int idxSide = elside[i*4 + j];
 4143:       
 4144:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4145:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4146: 
 4147:       // Find the neighboring element  
 4148:       if (elem.sides[j]->elems[0] == &elem) {
 4149:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4150:       }
 4151:       else {
 4152:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4153:       }
 4154:       
 4155:    }
 4156: 
 4157:    elem.i34 = i34[i];
 4158: 
 4159:    // Compute the barycenter of the element and its depth
 4160:    elem.center = {0.0, 0.0};
 4161:    elem.depth = 1e10;
 4162:    for (int j = 0; j < i34[i]; j++) {
 4163: 
 4164:       elem.center += elem.nodes[j]->p/i34[i];
 4165:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4166:    }
 4167: 
 4168:    #ifdef USE_FRAMES
 4169:    elem.setFrame();
 4170:    #endif
 4171: 
 4172:    elem.area = elem.computeSignedArea(); 
 4173:    elem.radius = sqrt(elem.area)/pi; 
 4174:    
 4175:    // Determines which way the normal vector to each side is oriented.
 4176:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4177:    for (int j = 0; j < i34[i]; j++)  
 4178:    {
 4179:       if (elem.sides[j]->elems[0] == &elem) {
 4180:          elem.ssign[j] =  1.0;
 4181:       }
 4182:       else {
 4183:          elem.ssign[j] = -1.0;
 4184:       }
 4185: 
 4186:    }
 4187: 
 4188:   
 4189: 
 4190:    // Derivatives of shape functions
 4191:    //  For ics=2, this is done in the element frame
 4192:    //  For quads, the derivative is evaluated at centroid
 4193:    for (int j = 0; j < elem.i34; j++) {
 4194:       const double area = elem.area;
 4195:       const int id2 = elem.nxq(1 + j);
 4196:       const int id3 = elem.nxq(2 + j);
 4197:       const int id4 = elem.nxq(3 + j);
 4198:       if (elem.isTri()) {
 4199:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4200:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4201:          // da1/dx = (y1 - y2)/(2*area)
 4202: 
 4203:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4204:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4205:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4206: 
 4207:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4208:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4209: 
 4210:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4211: 
 4212:       }
 4213:       else  { // Quad; evaluate at centroid
 4214: 
 4215:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4216:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4217:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4218: 
 4219:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4220:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4221: 
 4222:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4223:       } // if Tri/Quad
 4224: 
 4225:    } // for j   
 4226:    
 4227:    
 4228: 
 4229: }
 4230: 
 4231: 
 4232: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4233:                                             double *emo, double *efa, 
 4234:                                             double *umo, double *ufa, 
 4235:                                             double *vmo, double *vfa,
 4236:                                             int *ifltype, int *iettype) {
 4237: 
 4238:    NODE_BND(nodeBnd);
 4239:    const int idx = idx_node_bnd;    
 4240: 
 4241:    nodeBnd->idx = idx;
 4242: 
 4243:    // Need to find the segment index and the index of the node on the segment
 4244:    int idxNode = -1;
 4245:    int iseg, i;
 4246:    for (iseg = 0; iseg < nope; iseg++) {
 4247:       // for each segment...
 4248:       for (i = 0; i < nond[iseg]; i++) {
 4249:          idxNode = iond[iseg + i*nope];
 4250:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4251:          
 4252:       }
 4253:    }
 4254: 
 4255:    assert(iseg < nope && "iseg is out of bounds");
 4256: 
 4257: found: // Jumped here when the node was found
 4258: printf("idxNode: %d, iseg: %d, i: %d\n", idxNode, iseg, i);
 4259:    nodeBnd->isEssentialBC = true;
 4260:    nodeBnd->elbc = 0.0;
 4261: 
 4262:    nodeBnd->segment->ifltype = ifltype[iseg];
 4263:    nodeBnd->segment->iettype = iettype[iseg];
 4264: 
 4265:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4266: 
 4267:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4268: 
 4269:       nodeBnd->efa[jfr] = efa[idx2];
 4270:       nodeBnd->emo[jfr] = emo[idx2];
 4271:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4272:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4273: 
 4274:    }
 4275:         
 4276: 
 4277: }
 4278: 
 4279: __device__ void Mesh::populateBoundarySideLinks(void) {
 4280: 
 4281:    SIDE_BND(sideBnd);
 4282: 
 4283:    const Side *side = sideBnd->side;
 4284: 
 4285:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4286:    // and the rightSide is the side s that has s->n1 == side->n2
 4287:    for (int i = 0; i < mesh->nbs; i++) {
 4288: 
 4289:       Side *s = &mesh->localSideData[i];
 4290: 
 4291:       if (s == side) continue;  // Do not link the side to itself
 4292:    
 4293:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4294:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4295:    }
 4296:    
 4297: }
 4298: 
 4299: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4300:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4301:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4302:                 int *isdel, int *isidenode, int *isbnd,
 4303:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4304:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4305:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4306:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4307:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4308:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4309:                 double *drag, double *roughness,
 4310:                 double *emo, double *efa, 
 4311:                 double *umo, double *ufa, 
 4312:                 double *vmo, double *vfa) {
 4313: 
 4314:    printf("Populating mesh for partition %d\n", partNum);
 4315: 
 4316:    // XXXXXX THIS function does almost nothing. 
 4317: 
 4318:    nbs = *sharedIdxSideBoundary + 1;
 4319:    nbp = *sharedIdxNodeBoundary + 1;
 4320: 
 4321:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4322: 
