 8062: __global__ void printMatrix(bool full) {
 8063:    // Debugging: print the matrix
 8064: 
 8065:    const int size = mesh->np;
 8066:    double sum = 0.0;
 8067:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8068:       const Node *node = mesh->localNodeData + idx_node;
 8069:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8070:       for (int j = 0; j < node->numNodes; j++) {
 8071:          Node* nbNode = node->nodes[j];
 8072:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8073:          sum += node->coeffMatrix[j];
 8074:       }
 8075:       if (full) printf("]\n");
 8076: 
 8077: 
 8078:    }
 8079:    if (!full) printf("sum=%lf\n", sum);
 8080: }
