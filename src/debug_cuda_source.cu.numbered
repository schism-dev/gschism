 9470: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 9471:    Node *nodes = mesh->localNodeData;
 9472: 
 9473:    *addr = nodes;
 9474:    *sizeNode = sizeof(Node);
 9475: 
 9476:    switch (varCode) {
 9477:       case (int)VarCode::depth:
 9478:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 9479:          *sizeType = sizeof(double);
 9480:          break;
 9481:       case (int)VarCode::eta:
 9482:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 9483:          *sizeType = sizeof(double);
 9484:          break;
 9485:       case (int)VarCode::x:
 9486:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 9487:          *sizeType = sizeof(Vector2);
 9488:          break;
 9489:       case (int)VarCode::z:
 9490:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 9491:          *sizeType = sizeof(double);
 9492:          break;
 9493:       case (int)VarCode::kb:
 9494:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 9495:          *sizeType = sizeof(int);
 9496:          break;
 9497:       case (int)VarCode::isdry:
 9498:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 9499:          *sizeType = sizeof(int);
 9500:          break;         
 9501:       case (int)VarCode::w:
 9502:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 9503:          *sizeType = sizeof(double);
 9504:          break;
 9505:       case (int)VarCode::u:
 9506:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 9507:          *sizeType = sizeof(Vector2);
 9508:          break;  
 9509:       case (int)VarCode::u_air:
 9510:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 9511:          *sizeType = sizeof(Vector2);
 9512:          break;
 9513:       default:
 9514:          *offset = -1;    
 9515:    }  
 9516:    
 9517: }
