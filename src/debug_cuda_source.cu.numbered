 3746: 
 3747:    __global__ void backtrackAllNodes(void) {
 3748: 
 3749:       // max/min # of sub-divisions
 3750:       const int ndelt_max = max(1.0, dt/dtb_min);
 3751:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3752: 
 3753:       // Removed all references to swild98 XXX
 3754:       // swild98=0.d0 !init
 3755: 
 3756: 
 3757: 
 3758:       SIDE(side);
 3759: 
 3760:       const int kb = side->kb;
 3761: 
 3762: 
 3763:       // Initialize btrack velocities to the actual velocities at the side 
 3764:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3765: 
 3766:   
 3767: 
 3768:       if (side->isDry) return;
 3769:       
 3770: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3771: 
 3772:       // Checks that at least one element is not dry
 3773:       const Element *elem1 = side->elems[0];
 3774:       const Element *elem2 = side->elems[1];
 3775: 
 3776: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3777: 
 3778:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3779:       
 3780:       // XXXXXX
 3781:       // !swild_tmp to store global coord. of the starting side
 3782:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3783:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3784:       // !Use sframe2 
 3785:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3786: 
 3787: 
 3788:       for (int k = kb; k < nvrt; k++) {
 3789:       //  Initialize (xt,yt,zt), nnel and vel.
 3790:       //  For ics=2, the coordinates are in local frames
 3791:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3792: 
 3793: 
 3794:          const int iadvf = side->iadv();  // Advection flag   
 3795:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3796: 
 3797:          Point3 xt;
 3798:          if constexpr(ics==1) {
 3799:             xt = side->center3D(k); 
 3800:          }
 3801:          else // lat/lon; in side lat/lon frame
 3802:          {
 3803:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3804:          // XXX IMPLEMENT THIS
 3805:       //          xt=0.d0
 3806:       //          yt=0.d0
 3807:       //          !centroid coord. for nudging
 3808:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3809:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3810:          }  // ics
 3811: 
 3812: 
 3813: 
 3814:          // If on land or open boundary...
 3815:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3816:          
 3817:          const double vmag = length(side->u2[k]);
 3818: 
 3819:          if (vmag <= velmin_btrack) {
 3820:             // No activity 
 3821: 
 3822:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3823: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 3824: 
 3825: 
 3826:             
 3827:          } else {  // do btrack
 3828: 
 3829:             // Compute number of sub-divisions based on local gradients 
 3830:             // XXX IS THIS NECESSARY?
 3831:             double suma = 0.0;
 3832:             int icount = 0;
 3833:             for (int ii=0; ii<2; ii++) {
 3834: 
 3835:                const Element *elem = side->elems[ii];
 3836:                  
 3837:                if (elem == nullptr) continue;
 3838: 
 3839:                icount++;
 3840: 
 3841:                // Not strictly along z; in ll frame for ics=2
 3842: 
 3843:                double utmp[4];
 3844:                double vtmp[4];
 3845:                for (int jj = 0; jj < elem->i34; jj++) {
 3846: 
 3847:                   const Node *node = elem->nodes[jj];
 3848: 
 3849:                   if constexpr(ics==1) {
 3850:                      utmp[jj] = node->u2[k].x;
 3851:                      vtmp[jj] = node->u2[k].y;  
 3852:                   } else {
 3853:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3854:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3855:                   }
 3856:                } // for jj
 3857: 
 3858:                const Vector2 grad_u = elem->grad2(utmp); 
 3859:                const Vector2 grad_v = elem->grad2(vtmp);
 3860: 
 3861:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3862:             } // for ii
 3863: 
 3864:             assert(icount > 0 && "Impossible 77");
 3865: 
 3866:             // '4' is somewhat arbitrary
 3867:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3868: 
 3869:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3870: 
 3871:             Vector3 u_int = {0.0, 0.0, 0.0};
 3872: 
 3873:             bool res =side->btrack(k, dt, dtbk, u_int);
 3874: 
 3875:             side->btu[k] = toVector2(u_int);
 3876:                
 3877:          } // if vmag (do backtrack)
 3878: 
 3879: 
 3880:       } // for k=kb,nvrt-1
 3881: 
 3882:    }
 3883: 
 3884: } // extern "C"
 3885: 
 3886: template<int nc>
 3887: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3888: 
 3889: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3890: //
 3891: // a,b,c,rhs: input vectors and are not modified by this program.
 3892: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3893: // rhs is the r.h.s.
 3894: // n: actual rank of the system.
 3895: // rows in u() and rhs();
 3896: // u: output with nc columns (transposed to rows)
 3897: // gam: a working array.
 3898: //
 3899: // NOTES:
 3900: // This is a template function that allows for different numbers of columns in the rhs vector.
 3901: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3902: 
 3903:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3904:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3905: 
 3906:    double bet = b[0];
 3907:    if constexpr (nc == 1) {
 3908:       u[0] = rhs[0]/bet;
 3909:    } else {
 3910:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3911:    }
 3912: 
 3913:    for (int j = 1; j < n; j++) {
 3914:       gam[j] = c[j - 1]/bet;
 3915:       bet = b[j] - a[j]*gam[j];
 3916: 
 3917:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3918: 
 3919:       if constexpr (nc == 1) {
 3920:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3921:       } else {
 3922:          for (int l = 0; l < nc; l++) {
 3923:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3924:          }
 3925:       }
 3926:    }
 3927: 
 3928:    // Back-substitution
 3929:    for (int j = n - 2; j >= 0; j--) {
 3930:       if constexpr (nc == 1) {
 3931:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3932:       } else {
 3933:          for (int l = 0; l < nc; l++) {
 3934:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3935:          }
 3936:       }
 3937:    }
 3938: }
 3939: 
 3940: 
 3941: 
 3942: // Helper function that contains the core algorithm
 3943: template<typename XAccessor, typename YAccessor>
 3944: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3945:                                     double  yp_top, double  yp_bot, 
 3946:                                     CubicSpline &spline) {
 3947:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3948:    // 
 3949:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3950:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3951:    //
 3952:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3953:    // 
 3954:    // Inputs: 
 3955:    //            n: dimension for x etc; # of data pts (>=2);
 3956:    //            getX, getY: functions to access x,y coordinates
 3957:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3958:    //     Output: 
 3959:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3960: 
 3961:    const int n = k2 - k1 + 1;
 3962:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3963: 
 3964:    // Allocate memory for the splines
 3965:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3966:    spline.x   = new double[n];
 3967:    spline.y   = new double[n];
 3968:    spline.yp  = new double[n];
 3969:    spline.ypp = new double[n];
 3970: 
 3971:    for (int k=k1; k<=k2; k++) {
 3972:       spline.x[k] = getX(k);
 3973:       spline.y[k] = getY(k);
 3974:    }
 3975: 
 3976:    // This is to simplify expressions later
 3977:    double *x = spline.x;
 3978:    double *y = spline.y;
 3979: 
 3980:    double *a = nullptr;
 3981:    double *b = nullptr;
 3982:    double *c = nullptr;
 3983:    double *gam = nullptr;
 3984:    double *rhs = nullptr;
 3985:    
 3986: 
 3987:       a = new double[n];   // Lower diagonal
 3988:       b = new double[n];   // Diagonal
 3989:       c = new double[n];   // Upper diagonal
 3990:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3991:       rhs = new double[n]; // Right-hand side
 3992: 
 3993:    for (int k=k1; k<=k2; k++) {
 3994:       if (k == k1) {
 3995:          // Bottom level
 3996:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3997:          b[k] = (x[k+1] - x[k])/3.0;
 3998:          c[k] = b[k]/2.0;
 3999:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4000:       } else if (k == n - 1) {
 4001:          // Top level (surface)
 4002:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4003:          b[k] = (x[k] - x[k-1])/3.0;
 4004:          a[k] = b[k]/2.0;
 4005:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4006:       } else {
 4007:          // Intermediate levels
 4008:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4009:          b[k] = (x[k+1] - x[k-1])/3.0;
 4010:          a[k] = (x[k  ] - x[k-1])/6.0;
 4011:          c[k] = (x[k+1] - x[k  ])/6.0;
 4012:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4013:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4014:       }
 4015:    }
 4016: 
 4017:    // Solve the tridiagonal system
 4018:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4019:    
 4020:    spline.yp[k1] = yp_bot;
 4021:    spline.yp[k2] = yp_top;
 4022: 
 4023:    // Compute rest of 1st derivatives using the splines
 4024:    for (int k=k1+1; k<k2; k++) {
 4025:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4026:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4027:    }
 4028:    
 4029:    delete[] a;
 4030:    delete[] b;
 4031:    delete[] c;
 4032:    delete[] gam;
 4033:    delete[] rhs;
 4034: 
 4035: }
 4036: 
 4037: // Array version
 4038: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4039:                                 double y_top, double y_bot, 
 4040:                                 CubicSpline &spline) {
 4041:    auto getX = [x] (int k) { return x[k]; };
 4042:    auto getY = [y] (int k) { return y[k]; };
 4043:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4044: }
 4045: 
 4046: // Lambda version - allows custom access patterns
 4047: template<typename XFunc, typename YFunc>
 4048: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4049:                                 double y_top, double y_bot,
 4050:                                 CubicSpline &spline) {
 4051:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4052: }
 4053: 
 4054: 
 4055: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4056: {
 4057:    assert("Not implemented");
 4058: 
 4059:    return 0.0;
 4060: }
