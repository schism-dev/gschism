 1344:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1345:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1346:    
 1347:    const int npgb;  // Global number of horizontal nodes
 1348:    const int negb;  // Global number of elements
 1349:    const int nsgb;  // Global number of sides
