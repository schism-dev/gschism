 2057: 
 2058: __device__ __forceinline__ double Element::centerZ(void) const { 
 2059: // Z coordinate of the element center in the global cartesian coordinates.
 2060: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2061: 
 2062:    if constexpr(ics==1) { 
 2063:       return 0.0; 
 2064: 
 2065:    } else { 
 2066: 
 2067:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2068:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2069:    } 
 2070: }
 2071: 
 2072: 
 2073:    template<typename T>
 2074:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2075:       // Get the values of the field at the nodes of the element
 2076:       res[0] = nodes[0]->*field;
 2077:       res[1] = nodes[1]->*field;
 2078:       res[2] = nodes[2]->*field;
 2079:       if (isQuad()) res[3] = nodes[3]->*field;
 2080:       else          res[3] = T();
 2081:    }
