 3398: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3399: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3400: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3401: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3402: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3403: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3404: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3405: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3406: // Computes the gradient of the field at the side center.
 3407:    Vector2 grad = {0.0, 0.0};
 3408:    int count = 0;
 3409: 
 3410:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3411:    // as the average of the gradients at each element.
 3412:    // First element
 3413:    if (elems[0] != nullptr && condition(elems[0])) {
 3414:       Vector2 elemGrad = elems[0]->grad2(field);
 3415: 
 3416:       // For ics=2, projects the element gradient from its frame to the side frame
 3417:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3418: 
 3419:       grad += elemGrad;
 3420: 
 3421:       count++;
 3422:    }
 3423: 
 3424:    // Second element
 3425:    if (elems[1] != nullptr && condition(elems[1])) {
 3426: 
 3427:       Vector2 elemGrad = elems[1]->grad2(field);
 3428: 
 3429:       // For ics=2, projects the element gradient from its frame to the side frame
 3430:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3431: 
 3432:       grad += elemGrad;
 3433: 
 3434:       count++;
 3435:    }
 3436: 
 3437:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3438:    if (count > 0) {
 3439:       grad = grad*(1.0/count);
 3440:    }
 3441:    
 3442:    return grad;
 3443: }
