 2191: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 2192:                    Side *side = &(mesh->localSideData[idx_side]); \
 2193:                    if (idx_side >= mesh->ns) return;
 2194: 
 2195: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 2196:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 2197:                    if (idx_elem >= mesh->ne) return;
 2198: 
 2199: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 2200:                    Node *node = &(mesh->localNodeData[idx_node]); \
 2201:                    if (idx_node >= mesh->np) return;
 2202: 
 2203: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 2204:                               Node *node = &(mesh->localNodeData[idx_node]); \
 2205:                               const bool valid = (idx_node < mesh->np);                   
 2206: 
 2207: 
 2208: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2209:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 2210:                            if (idx_node_bnd >= mesh->nbp) return;
 2211: 
 2212: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2213:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2214:                            if (idx_side_bnd >= mesh->nbs) return;  
