 7433: #ifdef DONTCOMPILE
 7434: __global__ void checkMassConservation(Tracers* sumtr) {
 7435: 
 7436:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7437: 
 7438:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7439: 
 7440:    Element *elem = &(mesh->localElemData[i]);
 7441: 
 7442:    // Skip dry elements
 7443:    if (elem->isDry) return;
 7444: 
 7445:    // Local sum array for this thread
 7446:    double localSum[N_TRACERS] = {0.0};
 7447: 
 7448:    // Sum over vertical levels for this element
 7449:    const int kbe = elem->kbe;
 7450:    const double area = elem->area;
 7451: 
 7452:    for (int k = kbe; k < nvrt; k++) {
 7453:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7454:       
 7455:       // Accumulate tracer mass
 7456:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7457:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7458:       }
 7459:    }
 7460: 
 7461:    
 7462: 
 7463:    //  This function returns per element sums. A reduction must be done on the host side.
 7464: }
 7465: 
 7466: 
 7467: __global__ void transport(void) {
 7468: 
 7469:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7470: 
 7471:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7472: 
 7473:    Element *elem = &(mesh->localElemData[ie]);
 7474: 
 7475:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7476: 
 7477:                for (int m=0; m<ntr; m++) {
 7478:                   for (int k=kbe(ie); k<nvrt; k++) {
 7479:                      // Calculate each polynomial's weight 
 7480:                      wm=0.d0; sum1=0.d0; 
 7481:                      wm1=0.d0; wm2=0.d0; 
 7482:                      for (int i=0; i<elem->nweno2; i++) {
 7483:                   
 7484:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7485:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7486:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7487:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7488:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7489:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7490:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7491:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7492:                      // -----------------Hu and Shu (1999)'s method----------------
 7493:                      b4=b1+b2+b3
 7494: 
 7495: //Error: add PRODUCTION CPP
 7496: #ifdef DEBUG
 7497:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7498:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7499:                     call parallel_abort(errmsg)
 7500:                   }
 7501: #endif
 7502: 
 7503:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7504:                   // !----test-------------- 
 7505:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7506:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7507:                   // !wm(i)=wm1(i)*wm2(i)
 7508:                   // !---------------------- 
 7509:                   sum1=sum1+wm(i)
 7510:                 } // end for i
 7511: 
 7512:                 wm=wm/sum1
 7513: 
 7514:                 for (int j=0; j<elem->i34; j++) {
 7515: 
 7516:                   const Side *side  = elem->sides[j];
 7517:                   const Node *node1 = side->n1;
 7518:                   const Node *node2 = side->n2;
 7519: 
 7520:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7521:                      trsd=0.d0
 7522:                      for (int kk=0; kk<nquad; kk++) {
 7523:                         for (int i=0; i<elem->nweno2; i++) {
 7524:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7525:                         } // end for i   
 7526:                      } // end for kk
 7527:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7528:                   } // outward flux
 7529:                } // end for j=1,i34(ie) ! side
 7530:             }
 7531:          }
 7532:               
 7533: 
 7534: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7535: //             //   calculate each polynomial's weight 
 7536: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7537: //                 wm=0.d0; sum1=0.d0
 7538: //                 do i=1,nweno1(ie) !for each polynomial
 7539: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7540: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7541: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7542: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7543: //                   wm(i)=b2
 7544: //                   sum1=sum1+b2
 7545: //                   !wm(i)=1.d0
 7546: //                   !sum1=sum1+1.d0
 7547: 
 7548: // // Error: PRODUCTION
 7549: // #ifdef DEBUG
 7550: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7551: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7552: //                     call parallel_abort(errmsg)
 7553: //                   endif
 7554: // #endif
 7555: 
 7556: //                 enddo !i
 7557: //                 wm=wm/sum1 !final weight
 7558: 
 7559:                 for (int j=0; j<elem->i34; j++) { // side
 7560:                   const Side *side = elem->sides[j];
 7561:                   const Node *node1 = side->n1;
 7562:                   const Node *node2 = side->n2;
 7563: 
 7564:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7565:                     trsd=0.d0
 7566:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7567:                       for (int i=0; i<elem->nweno1; i++) {
 7568:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7569:                       }
 7570:                     enddo //kk
 7571:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7572:                   } // outward flux
 7573:                 } // end for j=1,i34(ie) ! side
 7574:               } // end for k; ntr 
 7575: 
 7576:             else !simple upwind method
 7577:               do j=1,i34(ie)
 7578:                 jsj=elside(j,ie)
 7579:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7580:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7581:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7582:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7583:                   endif
 7584:                 enddo  !vertical layers
 7585:               enddo !j=1,i34(ie) ! side
 7586:             endif !order of accuracy
 7587: 
 7588:          //  enddo !ie
 7589: // !$OMP     end do
