 2419: 
 2420: __device__ __forceinline__ double Element::centerZ(void) const { 
 2421: // Z coordinate of the element center in the global cartesian coordinates.
 2422: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2423: 
 2424:    if constexpr(ics==1) { 
 2425:       return 0.0; 
 2426: 
 2427:    } else { 
 2428: 
 2429:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2430:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2431:    } 
 2432: }
