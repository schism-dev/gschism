 2161: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2162: // return;   
 2163:    // Lock the mutex
 2164:    lock(&debugPlotMutex);
 2165:  
 2166:    bool ok = true;
 2167:    if (debugPlotIdx == nullptr) ok = false;
 2168:    if (*debugPlotIdx >= 1000000) ok = false;
 2169:    if (ok) {
 2170:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2171:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2172:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2173:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2174:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2175:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2176:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2177:       (*debugPlotIdx)++;
 2178:    }
 2179: 
 2180:    __threadfence();               // ensure all above writes are visible
 2181:    // Unlock the mutex
 2182:    unlock(&debugPlotMutex);
 2183: 
 2184: }
 2185: 
 2186: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2187:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 2188: }
