 3208: 
 3209: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3210:    if constexpr(ics == 1) {
 3211:       return center;
 3212: 
 3213:    } else {
 3214:       const Point2 p0 = n1->outputCoords();
 3215:       const Point2 p1 = n2->outputCoords();
 3216:       return (1.0/2.0)*(p0 + p1);
 3217: 
 3218:    }
 3219: }
 3220: 
 3221: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3222: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3223: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3224: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3225: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3226: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3227: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3228: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3229: // Computes the gradient of the field at the side center.
 3230:    Vector2 grad = {0.0, 0.0};
 3231:    int count = 0;
 3232: 
 3233:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3234:    // as the average of the gradients at each element.
 3235:    // First element
 3236:    if (elems[0] != nullptr && condition(elems[0])) {
 3237:       Vector2 elemGrad = elems[0]->grad2(field);
 3238: 
 3239:       // For ics=2, projects the element gradient from its frame to the side frame
 3240:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3241: 
 3242:       grad += elemGrad;
 3243: 
 3244:       count++;
 3245:    }
 3246: 
 3247:    // Second element
 3248:    if (elems[1] != nullptr && condition(elems[1])) {
 3249: 
 3250:       Vector2 elemGrad = elems[1]->grad2(field);
 3251: 
 3252:       // For ics=2, projects the element gradient from its frame to the side frame
 3253:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3254: 
 3255:       grad += elemGrad;
 3256: 
 3257:       count++;
 3258:    }
 3259: 
 3260:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3261:    if (count > 0) {
 3262:       grad = grad*(1.0/count);
 3263:    }
 3264:    
 3265:    return grad;
 3266: }
 3267: 
 3268: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3269: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3270: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3271: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3272: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3273: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3274: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3275: 
 3276: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3277: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3278: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3279: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3280: 
 3281: 
 3282: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3283: 
 3284: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3285:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3286:    if constexpr(ics == 1) { 
 3287:       return 0.5*(n1->tau + n2->tau);
 3288: 
 3289:    } else {
 3290:       // Project the tau from the node frames to the side frame
 3291:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3292:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3293: 
 3294:       return 0.5*(stau1 + stau2);
 3295:    }
 3296: }
 3297: 
 3298: /**
 3299:  * This method performs backtracking from the side center until a time -dt back in time 
 3300:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3301:  * intermediate point.
 3302:  *
 3303:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3304:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3305:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3306:  * remaining time.
 3307:  * 
 3308:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3309:  * 
 3310:  * @param uuint, vvint, wwint: Velocities at the final point
 3311:  * @param jlev: Level at which the backtracking is performed
 3312:  * @param dt, dtbk: Tracking timesteps
 3313:   */
 3314: __inline__ __device__ void Side::btrack(
 3315:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3316:       double dt,            // Tracking time
 3317:       double dtbk,          // Tracking timestep
 3318:       Vector3 &u_int        // Velocities at the initial point
 3319: ) const {
 3320: 
 3321:    // Start from side center
 3322:    Point3 x0;
 3323: 
 3324:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3325:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3326: 
 3327:  
 3328:    double time_rm = dt; // Remaining time
 3329:    double time_rm_1 = 1e10;
 3330:    double time_rm_2 = 2e10;
 3331:    double time_rm_3 = 3e10;
 3332: 
 3333: 
 3334:    // Initial velocities
 3335:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3336: 
 3337:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3338:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3339: 
 3340:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3341: 
 3342: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3343: 
 3344: 
 3345:    constexpr int MAX_ITERATIONS = 100; 
 3346:    int iter = 0;
 3347:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3348:    while(true) {
 3349: 
 3350:       // Calculate timestep
 3351:       const double dtb = min(dtbk, time_rm);
 3352: 
 3353: // if (iter >= 38) printf("AAAAA iter = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, curElem->idx, x0.x, x0.y, x0.z, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3354: 
 3355:       // Next point in the backtracking curve
 3356:       xt = x0 - dtb*u_int;
 3357: // if (jlev == 48 && idx == 1603507)   showPoints(x0, xt, jlev, this, 0xFFFF00u, 'x', 1, 0, 0);
 3358: // // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3359: // // if ((jlev==45)) printf("jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3360: // if ((jlev==45))
 3361: // {
 3362: // // const Point3 p1 = toLocalFrame(x0);
 3363: // // const Point3 p2 = toLocalFrame(xt);
 3364: // // printf("jlev = %d, iter = %d, p1 = (%.17f, %.17f, %.17f), p2 = (%.17f, %.17f, %.17f)\n", jlev, iter, p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
 3365: // showPoints(x0, xt, jlev, this, 0x0000FFu, 'o', 1, 0, 0); 
 3366:     
 3367: // }
 3368: 
 3369:       double t, s; // parameters for the line segments p0pt and p1p2
 3370:       Side *lastCrossSide = nullptr;
 3371:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3372: 
 3373: 
 3374: // if (iter >= 38) printf("BBBBB idx = %d, jlev = %d, lastCrossSide->idx = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), iter = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", idx, jlev, lastCrossSide->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, iter, curElem->idx, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3375: 
 3376:       if (time_rm_3 <= time_rm) {
 3377:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3378:          xt = x0;
 3379:          break;
 3380:       }
 3381: 
 3382: 
 3383:       if (!found) {
 3384:       // This means that the walk reached a boundary or a dry element.
 3385: 
 3386:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3387: 
 3388:          // Finds the point at the boundary where the line segment x0xt intersects.
 3389:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3390:          // due to floating point errors, it does not exactly intersect.
 3391:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3392:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3393:          // To compute the intersection point we start with the parametric equations.
 3394:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3395:          // We cross-prouct by v1 to cancel the s term:
 3396:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3397:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3398: 
 3399:          // Side coordinates in the origSide frame.
 3400:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3401:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3402: 
 3403:          Point2  p0 = {x0.x, x0.y};
 3404:          Point2  pt = {xt.x, xt.y};
 3405: 
 3406:          const Vector2 v1 = pt - p0;
 3407:          const Vector2 v2 = p2 - p1;
 3408: 
 3409: 
 3410: 
 3411:          // We are assuming intersection, so we clamp t to the range [0,1].
 3412:          const double denom = cross(v2, v1);
 3413:          
 3414: 
 3415: 
 3416: 
 3417:          if (abs(denom) < small) {
 3418:             // small denominators are fairly common. They occur when the line segment x0xt 
 3419:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3420:             // boundary, where the backtracking curve startt sliding along the boundary.
 3421:             // In this case, we simply assume that the two lines are very close to each other
 3422:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3423:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3424:             if (t<0.0000000001) t = 0.0;
 3425:             if (t>0.9999999999) t = 1.0;
 3426: 
 3427:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3428:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3429: 
 3430:          }
 3431:          else {
 3432:             
 3433:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3434:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3435:             if (t>0.9999999999) t = 1.0;
 3436:             // From the originaL equation we can solve for s:
 3437:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3438:             // Computing the dot product by v1, we get:
 3439:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3440:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3441:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3442: 
 3443:          }
 3444: 
 3445:          
 3446:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3447:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3448: 
 3449: 
 3450: 
 3451:          // We update the new target point to be right at the intersection point,
 3452:          // and the remaining time must include the time we haven't "used".
 3453:          time_rm -= s*dtb;
 3454:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3455: 
 3456: // Point3 xct = {curElem->center.x, curElem->center.y, curElem->centerZ()};
 3457: // xct = toLocalFrame(xct);
 3458: // xt = (1-0.00001)*xt + 0.00001*xct;
 3459:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3460:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3461: 
 3462:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3463:          // but extracting only the component along the tangent vector v2.
 3464:          Vector2 tangent = normalize(v2);
 3465:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3466: 
 3467:          const Vector2 u2D = make_double2(u.x, u.y);
 3468:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3469: 
 3470: 
 3471:       } else {
 3472: 
 3473:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3474: 
 3475:          time_rm -= dtb; 
 3476: 
 3477:          u_int = curElem->interpolateVelocities(xt, this);
 3478: 
 3479:       }
 3480: 
 3481:       if (time_rm <= 0.0) break; 
 3482: 
 3483:       // If the velocity is too small, we stop the backtracking
 3484:       const double vmag2 = norm2(toVector2(u_int));
 3485:       if (vmag2 <= velmin_btrack_sq)  {
 3486: 
 3487:          time_rm = 0.0; 
 3488:          return; 
 3489:       }
 3490: 
 3491:       // The current point becomes the next segment's starting point.
 3492:       x0 = xt;
 3493:  
 3494:       iter++;
 3495: 
 3496: 
 3497:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3498: 
 3499:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3500:       time_rm_3 = time_rm_2;
 3501:       time_rm_2 = time_rm_1;
 3502:       time_rm_1 = time_rm;
 3503:    }
 3504: 
 3505:    assert(curElem != nullptr && "Final element is nullptr");
 3506:    assert(!curElem->isDry && "Final element is dry");
 3507:    
 3508: 
 3509: 
 3510:    // Interpolate the velocities at the final point with respect to the current side frame
 3511:    u_int = curElem->interpolateVelocities(xt, this);
 3512: 
 3513: 
 3514: }
 3515: 
 3516: 
 3517: 
 3518: 
 3519: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3520: 
 3521: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3522: 
 3523:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3524:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3525: 
 3526:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3527:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3528: 
 3529:    double fun_lat = 0.0;
 3530:    switch (jspc[idxComp]) {
 3531:       case 0:
 3532:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3533:          break;
 3534:       case 1:
 3535:          fun_lat = sin(2.0*lat);
 3536:          break;
 3537:       case 2:
 3538:          fun_lat = pow<2>(cos(lat));
 3539:          break;
 3540:       default:
 3541:          assert(false && "computeETP: invalid jspc");
 3542:    }
 3543:    
 3544:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3545: 
 3546: }
 3547: 
 3548: 
 3549: __device__ void Node::updateKb(void) {
 3550: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3551: 
 3552:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3553: 
 3554: 
 3555:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3556: 
 3557:    if constexpr(ivcor == 2) {  // SZ coordinates
 3558:       
 3559:       // Compute bottom level index
 3560:       if (depth <= mesh->h_s) {
 3561:          kb = izlev;   
 3562:          
 3563:       } else {
 3564:          kb = -1;
 3565:          int L = 0;
 3566:          int R = nzlev; 
 3567:          
 3568:          while (L <= R) {
 3569:             int M = (R + L) / 2;
 3570: 
 3571: 
 3572:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3573:             
 3574:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3575:                R = M;
 3576:             } else {
 3577:                L = M;
 3578:             }
 3579: 
 3580:             if (R - L == 1) {
 3581:                kb = L;
 3582:                break;
 3583:             }
 3584:          }
 3585: 
 3586:          // Checks that the binary search was successful
 3587:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3588:        
 3589:       }
 3590:    } 
 3591: }
 3592: 
 3593: 
 3594: __device__ __inline__ void Node::updateZCoordData(void) {
 3595: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3596: 
 3597:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3598:    // if (isDry2()) {
 3599:    //    kb = -1;  // XXXXXXXX KKKKK
 3600:    //    return;
 3601:    // }
 3602: 
 3603: 
 3604:    if constexpr(ivcor == 2) {  // SZ coordinates
 3605:       
 3606:       // Compute bottom level index
 3607:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3608:    } 
 3609:    else {  // if (ivcor == 1) Localized sigma
 3610:       // Do nothing
 3611:    }
 3612: 
 3613: 
 3614: }
