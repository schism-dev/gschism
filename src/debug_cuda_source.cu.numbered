 2115: 
 2116: /**
 2117:    Compute the shape coordinates of the point (xt,yt) in the element.
 2118:    @param xt (input): x-coordinate of the point
 2119:    @param shpCoords (output): shape coordinates of the point
 2120: **/
 2121: __device__ void Element::computeShapeCoords(Point2 &xt, ShapeCoords &shpCoords) const {
 2122: 
 2123:    // Compute the shape coordinates of the point xt in the element.
 2124:    if (i34==3) {
 2125:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2126:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2127:       // and in this case, the pt will be nudged into the element
 2128:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2129:       // from the local frame, so use additional check.
 2130: 
 2131:       Point2 x0, x1, x2;
 2132: 
 2133:       if constexpr(ics==1) {
 2134:          x0 = nodes[0]->p;
 2135:          x1 = nodes[1]->p;
 2136:          x2 = nodes[2]->p;
 2137:       }
 2138:       else // lat/lon
 2139:       {
 2140:          Error("Not implemented yet");
 2141:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2142:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2143:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2144:       }
 2145: 
 2146:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2147:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2148:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2149:       shpCoords[3] = 0.0;
 2150: 
 2151:    }
 2152:    else {
 2153:       Error("Not implemented yet");
 2154: #ifdef QUADS
 2155:       // Reproject pt in eframe of nel for ics=2
 2156:       if constexpr(ics==1) {
 2157:          xn2 = xt; 
 2158:          yn2 = yt;
 2159:       }
 2160:       else {
 2161:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2162:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2163:       }
 2164: 
 2165:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2166: #endif
 2167:    }
 2168: 
 2169: 
 2170: }
 2171: 
 2172: 
 2173: __device__ void Element::shapeCoordsToXY(ShapeCoords const &shpCoords, Vector2 &xt) const {
 2174: // Convert shape coordinates to cartesian coordinates
 2175: 
 2176:    assert(false && "shapeCoordsToXY: Not implemented, xt is not modified"); 
 2177:    if (i34 == 3) {
 2178:       // Triangular element
 2179:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2180:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2181:    }
 2182:    else {
 2183:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2184:    }
 2185: 
 2186: }
 2187: 
 2188: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2189:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2190:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2191:    // The formula for the integral is:
 2192:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2193: 
 2194:    printf("intPhiPhi: TEST\n");
 2195: 
 2196:    const Node *n0 = nodes[0];
 2197:    const Node *n1 = nodes[1];
 2198:    const Node *n2 = nodes[2];
 2199:    const Node *n3 = nodes[3];
 2200: 
 2201:    const Vector2 p0 = n0->p;
 2202:    const Vector2 p1 = n1->p;
 2203:    const Vector2 p2 = n2->p;
 2204:    const Vector2 p3 = n3->p;
 2205: 
 2206:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2207:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2208:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2209:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2210: 
 2211:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2212: }
 2213:    
 2214: 
 2215: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2216:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2217:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2218:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2219:    // The formula is also based on the identity:
 2220:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2221:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2222: 
 2223:    printf("intGradPhiGradPhi: TEST\n");   
 2224: 
 2225:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2226: 
 2227:    const double x0 = nodes[0]->p.x;
 2228:    const double y0 = nodes[0]->p.y;
 2229:    const double x1 = nodes[1]->p.x;
 2230:    const double y1 = nodes[1]->p.y;
 2231:    const double x2 = nodes[2]->p.x;
 2232:    const double y2 = nodes[2]->p.y;
 2233:    const double x3 = nodes[3]->p.x;
 2234:    const double y3 = nodes[3]->p.y;
 2235: 
 2236:    double res = 0.0;
 2237:    
 2238:    // Quadrature points in xi and eta coordinates
 2239:    #pragma unroll
 2240:    for (int i = 0; i < 4; i++) {
 2241:       // For each quadrature point...
 2242: 
 2243:       const Point2 p = GaussPoint(i);
 2244:       const double eta = p.x;
 2245:       const double xi  = p.y;
 2246: 
 2247:       // Jacobian entries at the Gauss point p
 2248:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2249:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2250:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2251:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2252: 
 2253:       const double detJ = jacobianDet(p);
 2254:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2255: 
 2256:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2257:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2258:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2259:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2260:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2261: 
 2262:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2263:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2264:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2265:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2266:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2267: 
 2268:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2269:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2270:    }
 2271: 
 2272:    return res;
 2273: }
 2274: 
 2275: 
 2276: /**  Interpolate velocities at a given point (xt,yt,zt)
 2277: 
 2278:    @param xt, yt, zt: coordinates of the point to interpolate
 2279:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2280: 
 2281:    This is done in four steps:
 2282: 
 2283:    1. Find the shape coordinates for the final position in the element.
 2284:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2285:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2286:       z levels at xt, yt at each step.   
 2287:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2288:       horizontally and vertically.
 2289: **/
 2290: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2291:    // Interpolate the velocities at the point xt. 
 2292:    // This function works the same for triangular and quadrilateral elements.
 2293:    ShapeCoords shpCoord;
 2294: 
 2295:    // First step is to compute the shape coordinates of (xt,yt)
 2296:    computeShapeCoords(toVector2(xt), shpCoord);
 2297: 
 2298: if ((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) < -small))   {
 2299:    printf("Invalid shape coordinates: shpCoord[0] = %f, shpCoord[1] = %f, shpCoord[2] = %f, shpCoord[3] = %f, xt = %f, yt = %f, zt = %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3], xt.x, xt.y, xt.z);
 2300:    return;
 2301: }
 2302:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2303: 
 2304:    // Second step is to find the level that contains zt
 2305:    // Uses a binary search to find the level
 2306:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2307:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2308:    int R = nvrt - 1;
 2309: 
 2310:    // Get the z coordinates at the nodes of the element at the levels L and R
 2311:    ShapeCoords zLAtNodes, zRAtNodes, zMAtNodes;
 2312:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2313:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2314: 
 2315:    double zL = interpolate(shpCoord, zLAtNodes);
 2316:    double zR = interpolate(shpCoord, zRAtNodes);
 2317:    
 2318:    // Interpolates vertically the velocities
 2319:    double wght1, wght2;
 2320:    if (xt.z<=zL) {
 2321:       wght1 = 1.0;
 2322:       wght2 = 0.0;
 2323:       xt.z = zL;
 2324:    }
 2325:    else if (xt.z>=zR) {
 2326:       wght1 = 0.0;
 2327:       wght2 = 1.0;
 2328:       xt.z = zR;
 2329:    }
 2330:    else {
 2331:       // Perform a binary search to find the levels between L and R that contain xt.z
 2332:       while (R - L > 1) {
 2333:          int M = (L + R) / 2.0;
 2334: 
 2335:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2336:          double zM = interpolate(shpCoord, zMAtNodes);
 2337:          if (zM < xt.z) 
 2338:          {
 2339:             L = M;
 2340:             zL = zM;
 2341:          }
 2342:          else 
 2343:          {
 2344:             R = M;
 2345:             zR = zM;
 2346:          }
 2347:       }
 2348:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2349:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2350: 
 2351:       wght2 = (xt.z - zL)/(zR - zL);
 2352:       wght1 = 1.0 - wght2;
 2353: 
 2354:    }
 2355: 
 2356: 
 2357:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2358:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2359: 
 2360: if (isnan(u_int.x) || isnan(u_int.y) || isnan(u_int.z))  {
 2361: printf("NaN velocities in interpolateVelocities: xt.z = %f, zL = %f, zR = %f, wght1 = %f, wght2 = %f, u_int = %f, %f, %f\n", xt.z, zL, zR, wght1, wght2, u_int.x, u_int.y, u_int.z);
 2362: u_int = {0.0, 0.0, 0.0};
 2363: return;
 2364: }
 2365:    // Neither of the interpolated velocities should be NaN
 2366:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2367: 
 2368: }
 2369: 
 2370: 
 2371: 
 2372: 
 2373: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2374: 
 2375:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2376:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2377:    const Node *n1 = side->n1;
 2378:    const Node *n2 = side->n2;
 2379: 
 2380:    bool n1_match = (n1->nodeBnd->segment == segment);
 2381:    bool n2_match = (n2->nodeBnd->segment == segment);
 2382: 
 2383:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2384:    if (n1_match && n2_match) {
 2385:       return 0.5;
 2386:    } else if (n1_match) {
 2387:       return 1.0;
 2388:    } else if (n2_match) {
 2389:       return 0.0;
 2390:    }
 2391: 
 2392:    return 0.0;
 2393: }
 2394: 
 2395: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2396: 
 2397: 
 2398: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2399: 
 2400:    const double w1 = getBoundaryArrayValueWeight();
 2401:    const double w2 = 1.0 - w1;
 2402:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2403:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2404: 
 2405:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2406: }
 2407: 
 2408: 
 2409: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2410:    const double w1 = getBoundaryArrayValueWeight();
 2411:    const double w2 = 1.0 - w1;
 2412:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2413:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2414: 
 2415:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2416: 
 2417: }
 2418: 
 2419: 
 2420: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2421:    // Returns the value of the velocity at the side center
 2422:    const double w1 = getBoundaryArrayValueWeight();
 2423:    const double w2 = 1.0 - w1;
 2424:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2425:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2426: 
 2427:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2428: }
 2429: 
 2430: 
 2431: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2432:    // Returns the value of the normal component of the velocity at the side center
 2433:    const double w1 = getBoundaryArrayValueWeight();
 2434:    const double w2 = 1.0 - w1;
 2435:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2436:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2437: 
 2438:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2439: }
 2440: 
 2441: 
 2442: 
 2443: __inline__ __device__ double  Side::x(double t, bool checkInterval)   const { assert(!checkInterval || (t >= 0.0 && t <= 1.0)); return (1-t)*n1->p.x + t*n2->p.x; }
 2444: __inline__ __device__ double  Side::y(double t, bool checkInterval)   const { assert(!checkInterval || (t >= 0.0 && t <= 1.0)); return (1-t)*n1->p.y + t*n2->p.y; }
 2445: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2446: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2447: __inline__ __device__ Point2  Side::p_t(double t, bool checkInterval) const { return {x(t, checkInterval), y(t, checkInterval)}; }
 2448: __inline__ __device__ Vector3 Side::interpolateCenterVelocityVertically(Point3 xt) const { 
 2449: // Interpolates the side's center vertically at point xt.
 2450: // 
 2451: // The horizontal velocity (u2) is stored at the side center, but the vertical velocity (w) 
 2452: // is stored at the nodes. Since vertical levels vary in space along the side, we use the 
 2453: // parametric position t of xt along the side to determine which vertical levels bracket 
 2454: // xt.z, then interpolate the center velocity between those levels.
 2455: //
 2456: // This is an approximation used only when backtracking slides along a side.
 2457: //
 2458: // @param xt: A point on the side (not necessarily at the center) whose z-coordinate 
 2459: //            determines the vertical interpolation level
 2460: // @return: Interpolated 3D velocity vector (u, v, w) at the side center at the vertical 
 2461: //          level corresponding to xt.z
 2462: 
 2463: 
 2464:    // Convert 2d coordinates to parametric coordinates on the side
 2465:    const double t = dot(toPoint2(xt) - n1->p, t12())/len;
 2466: 
 2467:    // Searches using binary search the vertical level that contains the z-coordinate of the point
 2468:    int L = kb;
 2469:    int R = nvrt - 1;
 2470:    while (R - L > 1) {
 2471:       int M = (L + R) / 2;
 2472:       const double z = (1 - t)*n1->z[M] + t*n2->z[M];
 2473:       if (z < xt.z) L = M;
 2474:       else R = M;
 2475:    }
 2476:    assert(L == R - 1 && "Binary search failed to find the vertical level containing zt");
 2477: 
 2478:    // Interpolates the center velocity at the relative distance of xt.z between the two levels L and R
 2479:    const double z1 = (1 - t)*n1->z[L] + t*n2->z[L];
 2480:    const double z2 = (1 - t)*n1->z[R] + t*n2->z[R];
 2481:    const double weight2 = (xt.z - z1)/(z2 - z1);
 2482:    const double weight1 = 1.0 - weight2;
 2483: 
 2484:    // Interpolate the horizontal velocity
 2485:    const Vector2 u = weight1*u2[L] + weight2*u2[R];
 2486: 
 2487:    // Interpolate the vertical velocity
 2488:    const double w1 = (1 - t)*n1->w2[L] + t*n2->w2[L];
 2489:    const double w2 = (1 - t)*n1->w2[R] + t*n2->w2[R];
 2490:    const double w = weight1*w1 + weight2*w2;
 2491: 
 2492:    return {u.x, u.y, w};
 2493: 
 2494: }
 2495: 
 2496: __forceinline__ __device__ bool Side::containsPoint(Vector2 x) const { 
 2497:    // Check if the point (x,y) is in the side, meaning that it includes points that are close to the side (within geometricEpsilon).
 2498: 
 2499:    const double t = length(x - n1->p)/len; // Parameterization of the point on the side (0 at n1, 1 at n2)
 2500:    return (t >= -2*geometricEpsilon) && (t <= 1.0 + 2*geometricEpsilon) && (abs(relativeSignedDistanceToPoint(x)) <= geometricEpsilon); 
 2501: }
 2502: 
 2503: 
 2504: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2505:    Vector2 grad = {0.0, 0.0};
 2506:    int count = 0;
 2507: 
 2508:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2509: 
 2510:    // First element
 2511:    if (elems[0] != nullptr && condition(elems[0])) {
 2512:       grad += elems[0]->grad2(field);
 2513:       count++;
 2514:    }
 2515: 
 2516:    // Second element
 2517:    if (elems[1] != nullptr && condition(elems[1])) {
 2518:       grad += elems[1]->grad2(field);
 2519:       count++;
 2520:    }
 2521: 
 2522:    if (count > 0) {
 2523:       grad = grad*(1.0/count);
 2524:    }
 2525:    
 2526:    return grad;
 2527: }
 2528: 
 2529: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2530: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2531: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2532: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2533: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2534: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2535: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2536: 
 2537: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2538: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2539: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2540: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2541: 
 2542: 
 2543: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2544: 
 2545: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
