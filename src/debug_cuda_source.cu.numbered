 8499: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8500:    Element *elems = mesh->localElemData;
 8501: 
 8502:    *addr = elems;
 8503:    *sizeElement = sizeof(Element);
 8504:    switch (varCode) {
 8505:       case (int)VarCode::z:
 8506:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8507:          *sizeType = sizeof(double);
 8508:          break;
 8509:       case (int)VarCode::x:
 8510:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8511:          *sizeType = sizeof(Vector2);
 8512:          break;
 8513:       case (int)VarCode::gradETP:
 8514:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8515:          *sizeType = sizeof(Vector2);
 8516:          break;
 8517:       case (int)VarCode::area:
 8518:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8519:          *sizeType = sizeof(double);
 8520:          break;
 8521:       case (int)VarCode::depth:
 8522:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8523:          *sizeType = sizeof(double);
 8524:          break;
 8525:       case (int)VarCode::radius:
 8526:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8527:          *sizeType = sizeof(double);
 8528:          break;
 8529:       case (int)VarCode::ghat:
 8530:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8531:          *sizeType = sizeof(Vector2);
 8532:          break;
 8533:       case (int)VarCode::kb:
 8534:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8535:          *sizeType = sizeof(int);
 8536:          break;
 8537:       case (int)VarCode::isdry:
 8538:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8539:          *sizeType = sizeof(int);
 8540:          break;            
 8541:       case (int)VarCode::w:
 8542:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8543:          *sizeType = sizeof(double);
 8544:          break;
 8545:       case (int)VarCode::FaceIndices:
 8546:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8547:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8548:          *sizeType = sizeof(Node);
 8549:          break;
 8550:       default:
 8551:          *offset = -1;
 8552:    }
 8553: }
