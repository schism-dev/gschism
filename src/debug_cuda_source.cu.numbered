 1981:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 1982:    // Project the vectors from the node frame to the element frame
 1983: 
 1984:  
 1985:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 1986:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 1987:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 1988:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 1989:       else          v[3] = Vector2();
 1990:    }
 1991: 
 1992:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 1993:    // Project the vectors from the side frame to the element frame
 1994: 
 1995:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 1996:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 1997:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 1998:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 1999:       else          v[3] = Vector2();
 2000:    }
