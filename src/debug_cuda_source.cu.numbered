 6011: extern "C" {
 6012: 
 6013:    __global__ void scaleGravity(double loadtide_coef) {
 6014: 
 6015: 
 6016:       NODE(node);
 6017: 
 6018:       // SAL option: scale gravity
 6019:       if constexpr(iloadtide==2) {  // simple const
 6020:          node->grav2 = grav*(1.0 - loadtide_coef);
 6021: 
 6022:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6023:         
 6024:           const double depth = max(node->depth, 0.0);
 6025:           const double tmp1 = sqrt(depth);
 6026:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6027:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6028:                              2.6969e-13*depth*depth*depth*tmp1;
 6029:           
 6030:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6031:           
 6032: 
 6033: 
 6034:           node->grav2 = grav*(1.0 - beta_bar);
 6035: 
 6036:       } else {  // iloadtide=0,1
 6037:           node->grav2 = grav;
 6038: 
 6039:       }
 6040: 
 6041:    }
 6042: 
 6043: 
 6044:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 6045:       NODE(node);
 6046: 
 6047:       const int idx = node->idx;
 6048:       Vector2 wind = {xWind[idx], yWind[idx]};
 6049: 
 6050:       if constexpr(nws != 0 && iwindoff != 0) {
 6051:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6052:       }
 6053: 
 6054:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6055:       node->setWind(wind);
 6056: 
 6057:       node->pr = pressAir[idx];
 6058:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6059: 
 6060:    }
