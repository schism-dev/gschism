 7395: //                     do lll=1,2 !2 possible bnds
 7396: //                       if(isbnd(lll,ndo)==ibnd) then
 7397: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7398: //                         exit
 7399: //                       endif
 7400: //                     enddo !lll
 7401: //                   enddo !ll
 7402: //                   ind1=nwild(1); ind2=nwild(2);
 7403: 
 7404: //                   do jj=1,natrm
 7405: //                     if(ntrs(jj)<=0) cycle
 7406: 
 7407: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7408: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
