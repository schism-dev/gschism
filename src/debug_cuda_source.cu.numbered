 1519: // Helper functions for computing the local node index at a given offset from another.
 1520: __device__ __inline__ int nxq(int offset, int index, int size) {
 1521:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1522:    // to the index to make it positive
 1523:    assert(index + offset + 16*size >= 0);
 1524:    return (index + offset + 16*size) % size;  
 1525: }
 1526: 
 1527: __device__ __inline__ int nxq(int index, int size) {
 1528:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1529:    // to the index to make it positive
 1530:    assert(index + 16*size >= 0);
 1531:    return (index + 16*size) % size; 
 1532: }
