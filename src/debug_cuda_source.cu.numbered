  977: struct Side {
  978: 
  979:    // Geometry information
  980:    int idx;               // Index of the side
  981:    Node *n1, *n2;
  982:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  983: 
  984:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  985:    Vector2 center;        // Location of side center. 
  986:    double zc[nvrt];       // Side center z-coord at each vertical level
  987: 
  988:    Frame frame;
  989: 
  990:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  991:                           // this is nullptr
  992:    
  993:    int kb;                // Bottom index of the side
  994:    bool isDry;            // True if the side is dry
  995:  
  996:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  997: 
  998:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  999: 
 1000:    // Physical information
 1001:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1002:    Vector2 btu[nvrt];           // Back-tracked velocity
 1003:    Vector2 U;                   // Vertically averaged velocity vector  
 1004: 
 1005:    Vector2 nuGradU[nvrt];          // nu*grad u
 1006: 
 1007:    Vector2 bcc[nvrt];           // Baroclinic term
 1008:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1009: 
 1010:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1011:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1012:    Vector2 gradPr;               // Gradient of pressure
 1013:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1014: 
 1015: 
 1016:    double hhat;                 // \breve{H} in notes
 1017: 
 1018:    double shapiro;
 1019: 
 1020:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1021: 
 1022:    double coriolis;             // Coriolis parameter
 1023: 
 1024:    // Vegetation parameters
 1025:    double veg_c2;
 1026:    double veg_beta;
 1027: 
 1028:    // Bottom drag parameters.
 1029:    double chi;
 1030:    double chi2;
 1031: 
 1032:    __inline__ __device__ double x(double t) const;
 1033:    __inline__ __device__ double y(double t) const;
 1034:    __inline__ __device__ double lon(void) const;
 1035:    __inline__ __device__ double lat(void) const;
 1036:    __inline__ __device__ Point2 p_t(double t) const;
 1037: 
 1038:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1039:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1040:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1041: 
 1042:    __inline__ __device__ Side* neigh(int index) const { 
 1043:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1044:       assert(index >= 0 && index < 4); 
 1045:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1046: 
 1047:       const int ielem = index & 1;           // 0 or 1
 1048:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1049: 
 1050:       const Element* elem = elems[ielem];
 1051: 
 1052:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1053: 
 1054:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1055: 
 1056:    }
 1057: 
 1058:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1059: 
 1060:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1061: 
 1062:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1063:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1064:    __inline__ __device__ int iadv(void) const;
 1065: 
 1066:    __inline__ __device__ double grav3(void) const;
 1067:    
 1068:    __inline__ __device__ double eta2(void) const;
 1069:    __inline__ __device__ double eta1(void) const;
 1070:    __inline__ __device__ double w2(int k) const;
 1071:    __inline__ __device__ double depth(void) const;
 1072:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1073:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1074: 
 1075:    __inline__ __device__ double dfv(int k) const;
 1076: 
 1077:    __inline__ __device__ double veg_h(void)  const;
 1078:    __inline__ __device__ double veg_nv(void) const;
 1079:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1080:    __inline__ __device__ double veg_alpha3D(int k) const;
 1081:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1082: 
 1083:    __inline__ __device__ double Cd(void) const;
 1084: 
 1085:    __inline__ __device__ Vector2 tau(void) const;
 1086: 
 1087:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1088:    
 1089: 
 1090:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1091:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1092:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1093:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1094:    } 
 1095:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1096:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1097:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1098:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1099: 
 1100:    // Get valid starting element (for backtracking)
 1101:    __inline__ __device__ Element* getStartElement() {
 1102:       return elems[0] ? elems[0] : elems[1];
 1103:    }
 1104: 
 1105:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1106:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1107:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1108: 
 1109:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1110: 
 1111:       // Dot product of the negative velocity vector with the side normal vector
 1112:       const double dot_prod1 = -dot(u, n);
 1113: 
 1114:       // Vector from side center to element 0 centroid
 1115:       const Vector2 v2 = elems[0]->center - center;
 1116: 
 1117:       // Dot product of the vector with the side normal vector
 1118:       const double dot_prod2 = dot(v2, n);
 1119: 
 1120:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1121:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1122: 
 1123:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1124:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1125: 
 1126:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1127: 
 1128:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1129:       else                           return !isDry1 ? elems[1] : elems[0];
 1130: 
 1131:  
 1132:    }
 1133: 
 1134:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1135:       // Given an element, returns the other element that shares this side
 1136:       return (elems[0] == elem) ? elems[1] : elems[0];
 1137:    }
 1138: 
 1139:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1140:       // Given a node, returns the other node that shares this side
 1141:       return (n1 == node) ? n2 : n1;
 1142:    }
 1143:  
 1144:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1145: 
 1146: 
 1147: 
 1148: 
 1149: };
