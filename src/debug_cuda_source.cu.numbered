 4950:    __global__ void computeFlowBcVelocities(double time) {
 4951: 
 4952:       SIDE_BND(sideBnd);
 4953: 
 4954:       const Side *side = sideBnd->side;
 4955:  
 4956:       const bool isDry = side->isDry;
 4957:       const bool isLand = sideBnd->segment->isLand;
 4958: 
 4959:    
 4960:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4961: 
 4962:       if (isDry || isLand) return;
 4963: 
 4964:       // For wet sides in open boundaries...
 4965:       const Vector2 n = side->n;
 4966:       const BoundarySegment *segment = sideBnd->segment;
 4967: 
 4968:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4969: 
 4970:       const int ifltype = segment->ifltype;
 4971: 
 4972:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4973:       const Vector2 r_nuth0 = r_uth0*n;
 4974: 
 4975: 
 4976:       if (ifltype == 1 || ifltype == 2) {
 4977:       
 4978:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4979: 
 4980:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4981:          
 4982:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4983:          
 4984:       } else if (ifltype == -1) { // Flather 1
 4985: 
 4986:          for (int k = 0; k < nvrt; k++) {
 4987: 
 4988:             // uth is the normal vel.; no ramp up
 4989:             const double uth = sideBnd->nuth(k);
 4990:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4991: 
 4992:             sideBnd->ubc[k] += uth*n;
 4993:          }
 4994: 
 4995:       } else if (ifltype == 3 || ifltype == 5) {
 4996:          // vnth0=0 !normal vel.
 4997: 
 4998:          Vector2 r_u1_bar = {0.0, 0.0};
 4999:          // Computes the contribution to the velocity from all tide frequencies
 5000:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5001: 
 5002:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5003:             const Vector2 umo  = sideBnd->umo(jfr); 
 5004: 
 5005:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5006:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5007:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5008:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5009: 
 5010:          }
 5011: 
 5012: 
 5013:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5014: 
 5015:       } // if (ifltype = 3 || ifltype == 5
 5016: 
 5017: 
 5018: 
 5019:    }
 5020: 
 5021:    __global__ void computeElevationBoundaryConditions(double time) {
 5022:       // Compute elevation essential boundary conditions 
 5023: 
 5024:       NODE_BND(nodeBnd); // Each boundary node.
 5025: 
 5026:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5027: 
 5028:       const Node *node = nodeBnd->node;
 5029:       const BoundarySegment *segment = nodeBnd->segment;
 5030:       const int iettype = segment->iettype;
 5031:       
 5032: 
 5033:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5034:       double eic = 0.0;
 5035:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 5036:       else                 eic = 0.0;
 5037: 
 5038:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5039:       const double r_eth = ramp*nodeBnd->eth;
 5040:       double r_eta1_bar = 0.0;
 5041: 
 5042: 
 5043:       // Compute tide elevation
 5044:       if (iettype == 3 || iettype == 5) {   
 5045: 
 5046:          if constexpr(iloadtide==1) { // loading tide
 5047:             assert(false && "Loading tide not implemented");
 5048:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5049:          }
 5050:          
 5051:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5052: 
 5053:             const double efa  = nodeBnd->efa[jfr]; 
 5054:             const double emo  = nodeBnd->emo[jfr]; 
 5055: 
 5056:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5057:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5058:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5059: 
 5060:          } // for jfr
 5061: 
 5062:       } // if iettype
 5063: 
 5064:       switch (iettype) {
 5065:          case 1:
 5066:          case 2:
 5067:          case 4:
 5068:             nodeBnd->elbc = r_eic + r_eth;
 5069:             break;
 5070:          case 3:
 5071:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5072:             break;
 5073:          case 5:
 5074:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5075:             break;
 5076:       } // switch
 5077: 
 5078: 
 5079:       //Add inverse barometric effects
 5080:       if (iettype != 0 && inv_atm_bnd == 1) {
 5081:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5082:       }
 5083: 
 5084:    }
 5085: 
 5086: 
 5087:    __global__ void computeHorizontalViscosity(void) { 
 5088: 
 5089:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5090: 
 5091:       SIDE(side);
 5092: 
 5093:       if (side->isDry) return;
 5094: 
 5095:       for (int k = 0; k < nvrt; k++) {
 5096:          side->nuGradU[k] = {0.0, 0.0};
 5097:       }
 5098: 
 5099:       if constexpr(ihorcon == 1) {
 5100:          for (int k = side->kb; k < nvrt - 1; k++) {
 5101:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5102:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5103:             // By Zhang and Baptista.
 5104: 
 5105:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5106:             // This is a standard discretization of the Laplacian operator.
 5107:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5108:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5109:             // Gamma is hvis_coef0 in the code.
 5110:             // The value of gamma needs to be < 0.5.
 5111: 
 5112:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5113:             // side under consideration in each of the two possible elements that share the side.
 5114:             Vector2 sumU = {0.0, 0.0};
 5115:             for (int l = 0; l < 2; l++) {
 5116:                const Element *elem = side->elems[l];
 5117: 
 5118:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5119: 
 5120:                // Find the local index of the side in the element
 5121:                const int idxSide = elem->sideLocalIdx(side);
 5122: 
 5123:                // Find the two sides that are connected to the side under consideration
 5124:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5125:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5126: 
 5127:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5128: 
 5129:             }
 5130: 
 5131:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5132: 
 5133:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5134:    
 5135:          }
 5136:       }
 5137:       else if constexpr(ihorcon == 2) {
 5138:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5139:       }
 5140: 
 5141: 
 5142:    }
 5143: 
 5144: 
 5145:    __global__ void setEssentialBC(void) {
 5146:       // Set essential boundary conditions 
 5147:       NODE(node); // Each boundary node
 5148:       NodeBoundary *nodeBnd = node->nodeBnd;
 5149:       
 5150:  
 5151:       // Check if this node has essential BC
 5152:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5153:          // Verify BC value is valid
 5154:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5155: 
 5156:        
 5157:          // Set diagonal to 1 and zero off-diagonals
 5158:          node->coeffDiag = 1.0;
 5159: 
 5160:          for (int j = 0; j < node->numNodes; j++) {
 5161:                node->coeffMatrix[j] = 0.0;
 5162:          }
 5163:          
 5164:          // Set solution and RHS to BC value
 5165:          node->mX  = nodeBnd->elbc;
 5166:          node->qel = nodeBnd->elbc;
 5167: 
 5168:       } else {
 5169:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5170: 
 5171:          for (int j = 0; j < node->numNodes; j++) {
 5172:                Node* nbNode = node->nodes[j];
 5173:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5174:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5175:                   // Verify neighbor's BC value
 5176:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5177: 
 5178:                   // Subtract contribution to RHS
 5179:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5180:                   node->coeffMatrix[j] = 0.0;  
 5181:                }
 5182:          }
 5183:       }
 5184:    }
 5185: 
 5186: 
 5187:    __global__ void updateElevation(void) {
 5188:       NODE(node);
 5189: 
 5190: 
 5191:       node->eta2 = node->mX;
 5192: 
 5193:       node->updateZCoordData();
 5194:    }
 5195: 
 5196: 
 5197:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5198: 
 5199:       SIDE(side);
 5200: 
 5201:       side->U = {0.0, 0.0}; 
 5202:          
 5203:       if(side->isDry) return;
 5204: 
 5205:       // Vertically integrated velocity U
 5206:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5207:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5208:          side->U += side->Dz(k + 1)*uc;  
 5209:       }
 5210: 
 5211:    }
 5212: 
 5213:    __global__ void computeBottomDragVegetation(void) {
 5214:       // UNFINISHED. CHECK THIS:
 5215:       // How many kernels are needed? Why so many for loops?
 5216:       // Is the loop on sides needed?
 5217: 
 5218:       NODE(node);
 5219: 
 5220: 
 5221:       const int    kb      = node->kb;
 5222:       const double htot    = node->htot2(); 
 5223:       
 5224:       if (node->isDry) {
 5225:          // Default values for dry nodes
 5226:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5227:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5228: 
 5229:          return;
 5230:        
 5231:       }
 5232: 
 5233:       // Computes bottom drag Cd based on the selected nchi
 5234:       node->computeBottomDragCd();
 5235:       
 5236: 
 5237: 
 5238:       //   Bottom stress in m^2/s^2
 5239:       if (node->rho[kb + 1] >= -98.0)
 5240:       {
 5241:          const double mag_u = length(node->u2[kb + 1]);
 5242:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5243: 
 5244:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5245:          // !sediment erosion: this part needs more documentation
 5246:       }
 5247:     
 5248: 
 5249: 
 5250:       // Compute vegetation parameters
 5251:       //--------------------------------
 5252: 
 5253:       // SAV constants
 5254:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5255:       constexpr double veg_cfpsi = 0.16;
 5256: 
 5257:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5258:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5259: 
 5260:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5261:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5262:          int kbin = 0; // bin index
 5263:          for (int k = kb; k < nvrt; k++) {
 5264:             // Computes node height above the bottom level
 5265:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5266:             assert(false && "Vertical variation of vegetation not implemented");
 5267: 
 5268:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5269:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5270:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5271:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5272:             // } else {
 5273:             //    // Find the bin at which the current vertical level is
 5274:             //    while (kbin<nbins_veg_vert) {
 5275:             //       const double zn = node->z[kbin];
 5276:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5277:             //          break;
 5278:             //       } // if
 5279:             //       kbin++;
 5280:             //    } // while
 5281:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5282: 
 5283:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5284:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5285:                
 5286:             //    // Linear interpolation of the vegetation parameters
 5287:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5288:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5289:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5290:             // } // if rl10
 5291: 
 5292:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5293: 
 5294:          } // for k
 5295: 
 5296: 
 5297:       } else { // Ganthy (iveg==2)
 5298:       //  Modify canopy height, diameter, and density
 5299: 
 5300:          // Make sure there is vegetation on this node
 5301:          if (node->veg_h_unbent > 0.0) {
 5302:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5303: 
 5304:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5305:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5306:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5307: 
 5308:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5309:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5310:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5311:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5312:          } // if veg_h_unbent
 5313: 
 5314:          for (int k = 0; k < nvrt; k++) {
 5315:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5316:          } // for k
 5317:       
 5318: 
 5319:       } // if iveg
 5320:      
 5321: 
 5322:       // Compute vertical mean of veg_alpha3D
 5323:       if (iveg != 0) {
 5324:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5325:          double sum1=0.0;
 5326:          double sum2=0.0;
 5327:          // Integrate over each level under the canopy...
 5328:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5329:             const double Dz = node->Dz(k);
 5330: 
 5331:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5332:             sum2 += Dz;
 5333: 
 5334:          } // for k
 5335:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5336:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5337: 
 5338:       } // if iveg
 5339: 
 5340:    }
 5341: 
 5342:    __global__ void computeVegetationAndDragParameters(void) {
 5343:       // Computes the vegetation and drag model parameters:
 5344:       // chi, \tilde\chi, beta, \breve{H}
 5345:       
 5346:       SIDE(side);
 5347: 
 5348:       side->hhat = 0.0;
 5349:       side->chi2 = 0.0;
 5350:       side->chi = 0.0;
 5351:       side->veg_c2 = 0.0;
 5352:       side->veg_beta = 0.0;
 5353: 
 5354:       if (side->isDry) return;
 5355: 
 5356:       const double htot = side->htot2();
 5357:       const int    kb   = side->kb;
 5358: 
 5359:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5360: 
 5361:       const double veg_h     = side->veg_h();
 5362:       const double veg_nv    = side->veg_nv();
 5363:       const double veg_c     = side->veg_c();
 5364:       const double veg_beta  = side->veg_beta;
 5365:       const double veg_alpha = side->veg_alpha_vert_mean();
 5366: 
 5367:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5368:       // Velocity magnitude at the bottom level
 5369:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5370:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5371:       side->chi2 = side->Cd()*vmag1;
 5372:       side->chi  = side->chi2;
 5373:       if constexpr(iveg != 0) {
 5374:          const Node *n1 = side->n1;
 5375:          const Node *n2 = side->n2;
 5376:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5377:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5378:       }
 5379: 
 5380:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5381: 
 5382:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5383:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5384:       double magUa = 0.0;
 5385:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5386:          // 3D wet side with veg...
 5387: 
 5388:          double magUa = 0.0;
 5389:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5390:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5391: 
 5392:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5393:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5394:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5395: 
 5396:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5397:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5398: 
 5399:                // Velocity magnitude at the bottom (l) of the level
 5400:                const double ul = length(side->u2[k]);
 5401: 
 5402:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5403:                magUa += Dz*0.5*(uh + ul);
 5404: 
 5405:             } // if HasVegetation
 5406:          } // for k
 5407:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5408: 
 5409:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5410:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5411:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5412:             const double zCpy = side->zTopCanopy();
 5413:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5414:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5415:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5416:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5417:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5418:          } // if isSubmerged
 5419:       } // if iveg   
 5420: 
 5421:       // Computes the friction modified depth, \breve{H} in notes
 5422:       if (side->is2D()) { // 2D
 5423: 
 5424:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5425:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5426: 
 5427:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5428: 
 5429:          side->hhat = htot*htot/fricH; 
 5430: 
 5431:       } else { // 3D
 5432:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5433: 
 5434:          if constexpr(iveg != 0) {
 5435:             
 5436:             if (side->isSubmerged()) { 
 5437:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5438:                side->hhat -= veg_c*Hhat_alpha;
 5439: 
 5440:             } else { // Emergent
 5441:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5442:             }
 5443:          } // if iveg
 5444: 
 5445:          // Enforce positivity for 3D model
 5446:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5447:       } // if 3D
 5448: 
 5449:    }
 5450: 
 5451: 
 5452: 
 5453:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5454:    // Computes the density gradient between two elements, e1 and e2.
 5455:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5456:    // zero in the direction normal to the side. 
 5457:    // 
 5458:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5459:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5460:    //
 5461:    // Input:
 5462:    //    e1: Element
 5463:    //    e2: Neighbor element (or nullptr if boundary)
 5464:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5465:    //    k: Index of the half-level at which the density is interpolated
 5466:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5467:    // 
 5468:    // Output:
 5469:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5470:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5471: 
 5472:       if (e2 == nullptr || e2->isDry) {
 5473:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5474: 
 5475:          Side *side = e1->sides[j];
 5476:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5477:                  
 5478:          if constexpr(ics == 1) {
 5479:             vec = side->n; // Normal vector to the side
 5480:          } else {
 5481:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5482:             // IMPLEMENT THIS XXXXXX
 5483:             // !replace with xel, yel?
 5484:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5485:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5486:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5487:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5488:          } //ics
 5489:                    
 5490:          diffRho = 0.0;
 5491: 
 5492:       } else { //internal and wet
 5493:          if constexpr(ics==1) {
 5494:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5495: 
 5496:             // Vector from e1 to e2
 5497:             vec = e2->center - e1->center;
 5498: 
 5499:          } else { 
 5500:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5501:             // IMPLEMENT THIS XXXXXX
 5502:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5503:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5504:             //                   alow(j)=xctr2
 5505:             //                   bdia(j)=yctr2
 5506:          } // ics
 5507: 
 5508:          diffRho = rho2 - e1->demeanedDensity(k);
 5509:       }
 5510: 
 5511:    }
 5512: 
 5513:    __global__ void computeDensityCubicSplines(void) {
 5514:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5515: 
 5516:       ELEM(elem);
 5517: 
 5518:       if (elem->isDry) return;
 5519: 
 5520:       const int kb = elem->kb;
 5521: 
 5522:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5523:       if (elem->is2D()) {
 5524:          // In the 2D case, the density is constant at the prism level. 
 5525:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5526:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5527:       } else { //3D
 5528: 
 5529:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5530:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5531:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5532:          ///// XXXX CHECK INDICES!!!!!
 5533:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5534:       } // 2D/3D
 5535: 
 5536:    }
 5537: } // extern "C"
 5538: 
 5539: 
 5540: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5541: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5542: 
 5543:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5544: 
 5545:    const int kb  = elem->kb;
 5546:    const int kb2 = elem2->kb;
 5547: 
 5548:    // z-coordinate of prism of elem
 5549:    const double zp = elem->z_prism(k);
 5550: 
 5551:    double rho = 0.0;
 5552: 
 5553:    if (elem2->is2D()) {
 5554:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5555: 
 5556:    } else {  // 3D
 5557: 
 5558:       // eta_min may be < zmax
 5559:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5560:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5561: 
 5562:       // (Extrapolate density below bottom, we will fix it later)
 5563:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5564:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5565:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5566:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5567:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5568:    } // 2D/3D
 5569:      
 5570: 
 5571:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5572:    // Now we need to fix it.
 5573:    if (elem->z[k] < elem2->z[kb2]) {
 5574:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5575: 
 5576:       // There are two methods to adjust the density at the bottom of the element.
 5577:       // iunder_deep=0: 
 5578:       const double depth1 = abs(elem->z[kb]); // larger depth
 5579: 
 5580:       if (iunder_deep==0) {
 5581: 
 5582:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5583: 
 5584:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5585: 
 5586:       } else { // iunder_deep != 0
 5587: 
 5588:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5589: 
 5590:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5591: 
 5592:          //   Demeaned density at the same z coordinate as
 5593:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5594:          }
 5595: 
 5596:       } // if iunder_deep
 5597:    } // if elem->z[kb] < elem2->z[kb]
 5598: 
 5599:    return rho;
 5600: }
 5601: 
 5602: 
 5603: extern "C" {
 5604:    __global__ void computeDensityGradient(void) {
 5605: 
 5606:       if constexpr(ibc != 0) return;
 5607: 
 5608:          // Compute the horizontal density gradient at each element.
 5609:       // It works in two steps:
 5610:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5611:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5612:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5613:       //             gradRho.r1 = rho1 - rho0
 5614:       //             gradRho.r2 = rho2 - rho0
 5615:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5616:       // 
 5617:       //  NOTE: We use de-meaned densities.
 5618: 
 5619:       ELEM(elem);
 5620: 
 5621:       if (elem->isDry) return;
 5622: 
 5623:       const int kb  = elem->kb;
 5624:       const int i34 = elem->i34;
 5625: 
 5626:       for (int k = kb + 1; k < nvrt; k++) {
 5627:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5628:          //             gradRho.r1 = rho1 - rho0
 5629:          //             gradRho.r2 = rho2 - rho0
 5630:          int icount = 0;
 5631:          double sumRx = 0.0;
 5632:          double sumRy = 0.0;
 5633:          for (int j1=0; j1<i34; j1++) { 
 5634: 
 5635:             const int j2 = elem->nxq(j1 + 1);
 5636: 
 5637:             // Pairs of consecutive neighbor elements of elem
 5638:             const Element *e1 = elem->nghbElems[j1];
 5639:             const Element *e2 = elem->nghbElems[j2];
 5640: 
 5641:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5642:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5643:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5644: 
 5645:             // Compute the density difference and the vector from elem to e1 and e2
 5646:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5647:             double diffRho1, diffRho2;
 5648:             Vector2 vec1, vec2;
 5649:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5650:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5651: 
 5652:             const double rl1 = length(vec1);
 5653:             const double rl2 = length(vec2);
 5654:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5655: 
 5656:             const double delta = cross(vec1, vec2);
 5657:             const double sintheta = abs(delta)/(rl1*rl2);
 5658: 
 5659:             // To avoid problems, avoid elements with small angle between vectors
 5660:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5661:             const bool validEq = (sintheta > sin_one_deg);
 5662: 
 5663:             if (validEq) {
 5664:                // Solve the system of equations to get the density gradient at elem
 5665:                icount++;
 5666:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5667:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5668:                sumRx += Rx;
 5669:                sumRy += Ry;
 5670:             }
 5671:          } // for j1
 5672: 
 5673:          // Compute the average density gradient at elem
 5674:          if (icount==0) {
 5675:            // Bad mesh quality; bail out with 0 b-cc
 5676:            elem->gradRho[k] = {0.0, 0.0};
 5677:          } else {
 5678:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5679:          }
 5680: 
 5681:       } // for k
 5682: 
 5683:    }
 5684: 
 5685:    __global__ void computeBaroclinicTerm(void) {
 5686:    // Computes the baroclinic term at sides (at half levels).
 5687:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5688:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5689: 
 5690:       if (ibc == 1) return;
 5691: 
 5692:       SIDE(side);
 5693: 
 5694:       if (side->isDry) return;
 5695: 
 5696:       const Element *e1 = side->elems[0];
 5697:       const Element *e2 = side->elems[1]; 
 5698:       const int kb = side->kb;
 5699:       
 5700:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5701: 
 5702:       // interpolates vertically the density gradient of the two elements at the half level/
 5703: 
 5704:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 5705:       int k2 = max(kb, nvrt / 2);
 5706: 
 5707:       // Starts the integration at the surface and goes down to the bottom
 5708:       side->bcc[nvrt-1] = {0.0, 0.0};
 5709:       for (int k = nvrt - 2; k >= kb; k--) {
 5710:       // For each prism level (from surface to bottom)...
 5711: 
 5712:          // For both elements, interpolate density gradient at the side's half level.
 5713:          // The gradient at the side is the average of the gradients at the elements.
 5714:          // w1, w2 are used to take into account boundary sides, with just one element.
 5715:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5716:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5717:          const double wsum = w1 + w2;
 5718:          w1 = w1/wsum;
 5719:          w2 = w2/wsum;
 5720:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5721: 
 5722:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5723:          Vector2 gradRho = {0.0, 0.0};
 5724:          if (e1 != nullptr && k > kb) {
 5725:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5726:             
 5727:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5728:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5729:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5730: 
 5731:             // Grad(rho) vertically interpolated at the side's half level
 5732:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 5733: 
 5734:             // Projects the element density gradient to the side frame if needed.
 5735:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 5736: 
 5737:             // Adds the contribution of the density gradient at the side's half level
 5738:             gradRho += gradRho1*w1;
 5739:          }      
 5740:          if (e2 != nullptr && k > kb) {
 5741:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5742:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5743:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5744:             
 5745:             // Grad(rho) vertically interpolated at the side's half level
 5746:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 5747: 
 5748:             // Projects the element density gradient to the side frame if needed.
 5749:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 5750: 
 5751:             // Adds the contribution of the density gradient at the side's half level
 5752:             gradRho += gradRho2*w2;
 5753:          }
 5754: 
 5755:          
 5756:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5757:          // multiplied by -rampbc*(g/rho0) 
 5758:          const double grav3 = side->grav3();
 5759:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 5760: 
 5761:       } // for
 5762: 
 5763:    }
 5764: 
 5765: 
 5766: 
 5767:    __global__ void computeHorGradientAtSide(void) {
 5768: 
 5769:       // Compute the horizontal density gradient at each element.
 5770:       // It works in two steps:
 5771:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5772:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5773:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5774:       //             gradRho.r1 = rho1 - rho0
 5775:       //             gradRho.r2 = rho2 - rho0
 5776:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5777:       // 
 5778:       //  NOTE: We use de-meaned densities.
 5779: 
 5780:       SIDE(side);
 5781: 
 5782: 
 5783:       if (side->isDry) return;
 5784: 
 5785:       // Computes the gradient of the variables at the side center.
 5786:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5787:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5788:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5789: 
 5790:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5791:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5792:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5793:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5794: 
 5795:    }
 5796: 
 5797: 
 5798:    __global__ void solveMomentumEquations(double time) {
 5799: 
 5800:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5801:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5802: 
 5803:       SIDE(side);
 5804: 
 5805:       if (side->isDry) 
 5806:       {
 5807:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5808: 
 5809:          return;
 5810:       }
 5811: 
 5812:       const Node *n1 = side->n1;
 5813:       const Node *n2 = side->n2;
 5814: 
 5815:       const int kb = side->kb;
 5816: 
 5817:       const double veg_h = side->veg_h();
 5818:       const double grav3 = side->grav3();
 5819: 
 5820:       if (side->is2D()) {
 5821:          // Remember: Do not use htot2, which is updated.
 5822:          const double htot = side->htot1();
 5823:          const double hhat = side->hhat;
 5824: 
 5825:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5826: 
 5827:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5828:          const Vector2 tau2 = side->tau();
 5829: 
 5830:          // hat_gam has units of m/s
 5831: 
 5832:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5833:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5834:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5835: 
 5836:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5837: 
 5838: 
 5839:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5840: 
 5841:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5842: 
 5843:       }
 5844:       else { // 3D
 5845: 
 5846:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5847:          // 
 5848:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5849:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5850:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5851:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5852:          // k+1 and k.
 5853: 
 5854: 
 5855:          const int ndim = nvrt - kb;
 5856:          const double zTopCanopy = side->zTopCanopy();
 5857: 
 5858:          // Initialize the tridiagonal system
 5859:          for (int k = kb + 1; k < nvrt; k++) {
 5860:             
 5861:             const int kin = k - (kb + 1);
 5862: 
 5863:             // Vertical viscosity at the face center
 5864:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5865: 
 5866:  
 5867:             alow[kin] = 0.0;
 5868:             cupp[kin] = 0.0;
 5869:             bdia[kin] = 0.0;
 5870: 
 5871:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5872:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5873: 
 5874:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5875:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5876:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5877: 
 5878:             // First part: layers k, k+1
 5879:             if (k < nvrt - 1) {
 5880:                              
 5881:                if constexpr(iveg != 0) {
 5882: 
 5883:                   // If there is vegetation at this level...
 5884:                   if (zTopCanopy > side->zc[k]) {
 5885:                      // If the canopy is above the k layer...
 5886:                      
 5887:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5888:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5889:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5890:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5891: 
 5892:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5893:                      const double vmag2 = length(ut2);
 5894:                      const double vmag1 = length(side->u2[k]);
 5895:                      const double vmag = 0.5*(vmag1 + vmag2);
 5896:                      
 5897:                      // Computes the vegetation alpha at the face center
 5898:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5899: 
 5900:                      cff1 += veg_alpha_sd*dt*vmag;
 5901: 
 5902:                   } // if (zTopCanopy
 5903:                } // if iveg
 5904: 
 5905:                const double dzz = side->Dz(k + 1);
 5906:                const double tmp = dt*dfz/dzz;
 5907:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5908: 
 5909:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5910:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5911:             }
 5912: 
 5913: 
 5914:             // Second part: layers k-1, k
 5915:             if (k > kb + 1) {
 5916: 
 5917:                double cff1 = 1.0; //init \bar{c^k}
 5918: 
 5919:                if constexpr(iveg != 0) {
 5920:                   // If there is vegetation at this level...
 5921:                   if (zTopCanopy > side->zc[k-1]) {
 5922:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5923:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5924: 
 5925:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5926: 
 5927:                      const double vmag2 = length(ut2);
 5928:                      const double vmag1 = length(side->u2[k-1]);
 5929:                      const double vmag = 0.5*(vmag1 + vmag2);
 5930: 
 5931:                      // Computes the vegetation alpha at the face center
 5932:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5933:                      cff1 += veg_alpha_sd*dt*vmag;
 5934:                   } // if zTopCanopy
 5935: 
 5936:                } // if iveg
 5937: 
 5938:                const double dzz = side->Dz(k);
 5939:                const double tmp = dt*dfz/dzz;
 5940:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5941: 
 5942:                alow[kin] += cff1*dzz/6.0 - tmp;
 5943:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5944: 
 5945:             } else { // Bottom boundary
 5946:                // This occurs at the bottom, where the bottom drag is applied.
 5947: 
 5948:                bdia[kin] += dt*side->chi2; // XXXX
 5949: 
 5950:             } // if (k > kb + 1)
 5951: 
 5952: 
 5953:          } // for (int k
 5954: 
 5955: 
 5956: 
 5957:          // Computes the RHS.
 5958:          // -----------------
 5959: 
 5960:          //	BC to be imposed at the end.
 5961: 
 5962:          const Vector2 gradETP  = side->gradETP;
 5963:          const Vector2 gradPr   = side->gradPr;
 5964:          const Vector2 gradEta1 = side->gradEta1;
 5965:          const Vector2 gradEta2 = side->gradEta2;
 5966: 
 5967:          const Vector2 *btu = side->btu;
 5968:          const Vector2 *u2  = side->u2;
 5969:          const double coriolis = side->coriolis;
 5970:          const Vector2 *nuGradU = side->nuGradU;
 5971: 
 5972: 
 5973:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5974:          for (int k = kb + 1; k < nvrt; k++) {
 5975:             const int kin = k - kb - 1;
 5976: 
 5977:             const double dz_0 = side->Dz(k);
 5978:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5979: 
 5980:             rrhs[kin] = {0.0, 0.0};
 5981:             double dz = 0.0;
 5982: 
 5983:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5984:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5985:             if (k < nvrt  ) dz += dz_1;
 5986:             if (k > kb + 1) dz += dz_0;
 5987: 
 5988:             // Elevation gradient, atmospheric pressure and tidal potential
 5989:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5990: 
 5991:             // Coriolis, advection, wind stress, and horizontal viscosity
 5992:             if (k < nvrt - 1) {
 5993: 
 5994: 
 5995:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5996:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5997:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5998:                                                 
 5999: 
 6000:                //diff stress tensors 1006
 6001:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6002:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6003:                   assert(false && "Not implemented: itur == 5");
 6004:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6005:                }
 6006:                // else assert(false && "itur # Not implemented");
 6007: 
 6008:             } else { // k == nvrt - 1 SURFACE
 6009:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6010:                const Vector2 tau2 = side->tau();
 6011: 
 6012:                rrhs[kin] += dt*tau2;          
 6013: 
 6014:             } // if k<nvrt
 6015: 
 6016: 
 6017:             if (k > kb + 1) {
 6018:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6019:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6020:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6021: 
 6022:                // diff stress tensors 1006
 6023:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6024:                   assert(false && "Not implemented: itur == 5");
 6025:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6026:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6027:                }
 6028:                // else assert(false && "itur # Not implemented");
 6029: 
 6030: 
 6031:             } // if k>kbs + 1
 6032: 
 6033:             // Baroclinic
 6034:             Vector2 *bcc = side->bcc;
 6035:             if constexpr(ibc == 0) {
 6036:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6037:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6038: 
 6039:             } // if ibc==0
 6040: 
 6041:          } // k=kb + 1,nvrt
 6042: 
 6043: 
 6044:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6045: 
 6046:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6047:             const int kin = k - kb - 1;
 6048:    
 6049:             // Velocity is always clamped to maximum values
 6050:             side->u2[k] = clampVelocity(soln[kin]);
 6051:          } // k
 6052: 
 6053:       } // if side->is2D()
 6054:       
 6055: 
 6056:       // Impose velocity boundary condition at the bottom
 6057:       if constexpr(imm == 2) { // 3D bed deformation model
 6058:          double dep;
 6059:          Vector2 vel;
 6060: 
 6061:          assert(false && "Not implemented: imm == 2");
 6062:          //update_bdef(time, x0, y0, dep, vel);
 6063:          // side->u2[kb] = vel;
 6064: 
 6065:       } else { // imm = 0 or 1
 6066:          if (side->Cd() == 0.0) {
 6067:             side->u2[kb] = side->u2[kb + 1];
 6068: 
 6069:          } else if (side->is3D()) { // 3D no slip bottom   
 6070:             side->u2[kb] = {0.0, 0.0};
 6071: 
 6072:          }
 6073:           
 6074:       } // if imm
 6075: 
 6076:       // The velocities below the bottom level are set to zero
 6077:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6078: 
 6079: 
 6080:    }
 6081: 
 6082: 
 6083:    __global__ void applyMomentumBC(void) {
 6084: 
 6085:       SIDE_BND(sideBnd);
 6086: 
 6087:       Side *side = sideBnd->side;
 6088:       const BoundarySegment *segment = sideBnd->segment;
 6089:       const Node *n1 = side->n1;
 6090:       const Node *n2 = side->n2;
 6091: 
 6092:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6093: 
 6094:       const bool isLand = segment->isLand;
 6095:       const int ifltype = segment->ifltype;
 6096: 
 6097:       const int kb = side->kb;
 6098: 
 6099: 
 6100:       if (!isLand && ifltype != 0) {
 6101:          const Vector2 *ubc = sideBnd->ubc;
 6102:   
 6103:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 6104:             
 6105:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6106:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6107: 
 6108:             if (ifltype == -1) {
 6109:                // Flather 1
 6110: 
 6111:                const double depth = side->depth();
 6112: 
 6113:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6114: 
 6115:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6116: 
 6117:                side->u2[k] = vnorm*side->n;
 6118: 
 6119:             } else if (ifltype == -2) { // Discharge
 6120: 
 6121:                const double eta1 = side->eta1();
 6122:                const double eta2 = side->eta2();
 6123:                const double htot = side->htot2();
 6124: 
 6125:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6126:                assert(false && "Not implemented: Discharge bc");
 6127:                // const double dischrg = discharge(eta1);
 6128:                const double dischrg = 0.0; // XXX REMOVE
 6129:                
 6130: 
 6131:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6132: 
 6133:                const double vnorm = dischrg*eta2/htot;
 6134: 
 6135:                side->u2[k] = vnorm*side->n;
 6136: 
 6137:             }
 6138:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6139:                const double vnorm = dot(side->u2[k], side->n);
 6140: 
 6141:                double rat;
 6142:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6143:                else              rat = segment->vobc2; // outgoing
 6144: 
 6145:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6146: 
 6147:             }
 6148:             else { // not Flather or 3D radiation
 6149:                side->u2[k] = ubc[k];
 6150: 
 6151:             } // if (segment->ifltype...
 6152: 
 6153:          }
 6154: 
 6155:       }
 6156:       else if (isLand) { // if it is land boundary side
 6157: 
 6158:          if constexpr(islip == 0) { // free slip
 6159: 
 6160:             for (int k = kb; k < nvrt; k++) {
 6161: 
 6162:                const Vector2 t = side->t();
 6163:                const Vector2 n = side->n;
 6164: 
 6165:                double vnorm = 0.0; // for most cases
 6166:                const double vtan = dot(side->u2[k], t);
 6167:                
 6168:                side->u2[k] = vtan*t - vnorm*n;
 6169: 
 6170:             }
 6171: 
 6172:          } else { // no slip
 6173:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6174: 
 6175:          }
 6176:       } // if (side segment type...
 6177: 
 6178:    
 6179: 
 6180:    }
 6181: 
 6182: 
 6183:    __global__ void shapiroFilter1(void) {
 6184:       // First step of the Shapiro filter (normally used if indvel<=0)
 6185:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6186: 
 6187:       SIDE(side);
 6188: 
 6189:       // Only internal wet sides are processed
 6190:       if (side->isDry || !(side->isInternal())) return;
 6191: 
 6192:       const int kb = side->kb;
 6193: 
 6194:       for (int mm = 0; mm < niter_shap; mm++) {
 6195: 
 6196:          for (int k = kb + 1; k < nvrt; k++) {
 6197:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6198:             Vector2 suru = {0.0, 0.0};
 6199: 
 6200:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6201: 
 6202:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6203: 
 6204:                int kin = k;
 6205:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6206:                
 6207:                // Get the velocity at the neighbor's side.
 6208:                Vector2 nSideU2 = nSide->u2[kin];
 6209: 
 6210:                // Projects the velocity to the current side frame if needed.
 6211:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6212: 
 6213:                suru += nSideU2;
 6214:             }
 6215: 
 6216:             // Reusing bcc as a temporary array to store the suru values.
 6217:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6218: 
 6219:          }
 6220:       }
 6221:    }
 6222: 
 6223:    __global__ void shapiroFilter2(void) {
 6224:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6225: 
 6226:       SIDE(side);
 6227: 
 6228: 
 6229:       if (side->isDry || !(side->isInternal())) return;
 6230: 
 6231:       const int kb = side->kb;
 6232: 
 6233:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6234: 
 6235:       if (side->is2D()) {
 6236:          side->u2[kb + 1] = side->bcc[kb + 1];
 6237:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6238: 
 6239:       } else {
 6240:          // 3D
 6241:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6242:          
 6243:       }
 6244: 
 6245:    }
 6246: 
 6247: 
 6248:    __global__ void ul0UpdateZCoords(void) {
 6249:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6250:       
 6251:       NODE(node);      
 6252: 
 6253: 
 6254:       if (false) { //node->isDry) { XXXXXXX
 6255: 
 6256:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6257: 
 6258:          if constexpr(ivcor != 1) node->kb = 0;
 6259: 
 6260:       } else {
 6261: 
 6262:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6263:          node->updateKb();
 6264: 
 6265:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6266: 
 6267:       }
 6268: 
 6269:       // We use the temp.b field to store the previous state of isDry.
 6270:       node->tmp.b = node->isDry;
 6271: 
 6272:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6273:       node->isDry = true;
 6274: 
 6275:    }
 6276: 
 6277:    __global__ void ul0ComputeDryElements(void)
 6278:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6279:    {
 6280:       ELEM(elem);
 6281: 
 6282:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6283: 
 6284:       elem->kb = 0;
 6285: 
 6286:       if (elem->isDry) return;
 6287: 
 6288: 
 6289:    //    if(elem->isDry2()) { // XXXX
 6290:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6291:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6292:    //        call parallel_abort(errmsg)
 6293:    //    }
 6294: 
 6295:       const Node *n1 = elem->nodes[0];
 6296:       const Node *n2 = elem->nodes[1];
 6297:       const Node *n3 = elem->nodes[2];  
 6298:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6299: 
 6300:       // Computes element's kb as the minimum of the nodes' kb.
 6301:       const int kb1 = n1->kb;
 6302:       const int kb2 = n2->kb;
 6303:       const int kb3 = n3->kb;
 6304:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6305: 
 6306: 
 6307:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6308: 
 6309: 
 6310:       // Computes the element z as the mean of the nodes z.
 6311:       for (int k = elem->kb; k < nvrt; k++) {
 6312: 
 6313:          // Compute the element z as the mean of the nodes z.
 6314:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6315:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6316:          elem->z[k] /= elem->i34;
 6317: 
 6318: if (k>elem->kb && elem->z[k] <= elem->z[k-1]) printf("EEEE elem->isDry = %d, idx1 = %d, idx2 = %d, idx3 = %d, z1[k] = %f, z2[k] = %f, z3[k] = %f, z1[k-1] = %f, z2[k-1] = %f, z3[k-1] = %f, k = %d, kb = %d, kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d, z[k] = %f, z[k-1] = %f\n", elem->isDry, n1->idx, n2->idx, n3->idx, n1->z[max(k, kb1)], n2->z[max(k, kb2)], n3->z[max(k, kb3)], n1->z[max(k-1, kb1)], n2->z[max(k-1, kb2)], n3->z[max(k-1, kb3)],  k, elem->kb, kb1, kb2, kb3, kb4, elem->z[k], elem->z[k-1]);
 6319:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6320:       }
 6321:                   
 6322:    }
 6323: 
 6324:    __global__ void ul0ComputeDryNodes(void)
 6325:    // Updates node's isDry based on the elements' isDry. 
 6326:    {
 6327:       NODE(node);
 6328: 
 6329:       node->isDry = true;
 6330: 
 6331:       // A node is wet if at least one of the elements sharing it is wet.
 6332:       for (int j = 0; j < node->numElements; j++) {
 6333:          const Element *elem = node->elements[j];
 6334:          if (!elem->isDry) {
 6335:             node->isDry = false;
 6336:             break;
 6337:          }
 6338:       }
 6339: 
 6340:        
 6341:    }
 6342: 
 6343: 
 6344:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6345:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6346:    // node->tmp.b is true if the node was previously dry.
 6347:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6348:    {
 6349:       NODE(node);
 6350:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6351: 
 6352:       // Avoid this the first time step.
 6353:       if (it == iths) return;  
 6354: 
 6355:       const bool wasDry = node->tmp.b;
 6356: 
 6357: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6358: 
 6359:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6360: 
 6361:          for (int k=0; k < nvrt; k++) {
 6362: 
 6363:             Vector3 utmp={0.0, 0.0, 0.0};
 6364: 
 6365:             double ttmp=0.0;
 6366:             double stmp=0.0;
 6367:             int icount=0;
 6368:             for (int j = 0; j < node->numNodes; j++) {
 6369: 
 6370:                const Node *nbrNode = node->nodes[j];
 6371:                
 6372:                const bool wasNbrDry = nbrNode->tmp.b;
 6373: 
 6374:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6375:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6376: 
 6377:                   icount++;
 6378: 
 6379:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6380:                   utmp += nbrNode->uvw2(k);
 6381:                   
 6382:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6383:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6384:                }
 6385:             }
 6386: 
 6387:             if (icount > 0) {
 6388:                const double inv_icount = 1.0/icount;
 6389:                utmp = inv_icount*utmp;
 6390:                node->u2[k]     = toVector2(utmp);
 6391:                node->w2[k]     = utmp.z;
 6392:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6393:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6394:             } else {
 6395:                node->u2[k] = {0.0, 0.0};
 6396:                node->w2[k] = 0.0;
 6397:                // Initialize tracers to 0.0??? XXXXX
 6398:             }
 6399:          }
 6400:       }
 6401:    }
 6402: 
 6403:   
 6404:    
 6405: 
 6406: 
 6407:    __global__ void ul0UpdateSides(int it, int iths) {
 6408:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6409:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6410:    // The dryness of the sides is updated in ul0UpdateSides2.
 6411: 
 6412:       SIDE(side);
 6413: 
 6414:       // A side is wet if and only if at least one of its elements is wet.
 6415:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6416:  
 6417:       const Node *n1 = side->n1;
 6418:       const Node *n2 = side->n2;
 6419:      
 6420:       const int kb1 = n1->kb;
 6421:       const int kb2 = n2->kb;
 6422: 
 6423:       side->kb = 0; // default when dry
 6424: 
 6425:       if (isWet) {
 6426: 
 6427:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6428: 
 6429:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6430: 
 6431:          side->kb = min(kb1, kb2);
 6432: 
 6433:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6434: 
 6435:          for (int k = side->kb; k < nvrt; k++) {
 6436:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6437: 
 6438:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6439: 
 6440:             // Compute velocity for re-wetted sides 
 6441:             if ((it != iths) && (side->isDry && isWet)) {
 6442: 
 6443:                Vector2 utmp={0.0, 0.0};
 6444: 
 6445:                int icount=0;
 6446: 
 6447:                // For all the sides on the two elements that share this side
 6448:                for (int j = 0; j < 2; j++) {
 6449:                   const Element *elem = side->elems[j];
 6450:                   if (elem == nullptr) continue;
 6451: 
 6452:                   for (int jj=0; jj < elem->i34; jj++) {
 6453:                      const Side *nSide = elem->sides[jj];
 6454:                      if (nSide->isDry) continue;
 6455: 
 6456:                      icount++;
 6457:                      utmp += nSide->u2[k];  
 6458:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6459:                   }
 6460:                }
 6461:                   
 6462:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6463:                if (icount > 0)  side->u2[k] = utmp/icount;
 6464:                else             side->u2[k] = {0.0, 0.0};
 6465:                   
 6466:             } // if ((it != iths) && (side->isDry && isWet))
 6467: 
 6468:          } // for k
 6469: 
 6470:       } // if isWet 
 6471:       
 6472: 
 6473: 
 6474:    }
 6475: 
 6476:    __global__ void ul0UpdateSides2(void) {
 6477:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6478:    
 6479:          SIDE(side);
 6480:    
 6481:          const Element *e1 = side->elems[0];
 6482:          const Element *e2 = side->elems[1];
 6483: 
 6484:          // A side is wet if and only if at least one of its elements is wet.
 6485:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6486: 
 6487:          // Update the side's dryness
 6488:          side->isDry = !isWet;
 6489: 
 6490:    }
 6491: 
 6492: 
 6493:    __global__ void zeroNodalVelocities(void) {
 6494:       NODE(node);
 6495: 
 6496:       for (int k = 0; k < nvrt; k++) {
 6497:          node->u2[k]   = {0.0, 0.0};
 6498:          node->w2[k]   = 0.0;
 6499:          node->utmp[k] = {0.0, 0.0};
 6500:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6501:       }
 6502:    }
 6503:  
 6504: 
 6505:    __global__ void computeNodalVerticalVelocities1(void) {
 6506:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6507:    // Adds the element's vertical velocity times the element's area.
 6508:       ELEM(elem);
 6509: 
 6510:       for (int j = 0; j < elem->i34; j++) {
 6511:          Node *node = elem->nodes[j];
 6512: 
 6513:          for (int k = node->kb; k < nvrt; k++) {
 6514:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6515:          }
 6516:          atomicAdd(&(node->tmp.d), elem->area);
 6517:       }
 6518:    }
 6519: 
 6520:    __global__ void computeNodalVerticalVelocities2(void) {
 6521:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6522:    // Divides by the total area of the elements sharing the    node.
 6523:       NODE(node);
 6524: 
 6525:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6526: 
 6527:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6528:    }
 6529: 
 6530: 
 6531:    __global__ void computeNodalHorizontalVelocities1(void) {
 6532: 
 6533:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6534: 
 6535:       ELEM(elem);
 6536: 
 6537:       if (elem->isDry) return;
 6538: 
 6539:       const int kb = elem->kb;
 6540:       const bool isTri = elem->isTri();
 6541: 
 6542:       if constexpr(indvel <= 0) {
 6543:          // Assuming discontinous hvel.
 6544: 
 6545:          if (isTri) { // For triangles
 6546:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6547:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6548: 
 6549:             for (int j = 0; j < 3; j++) {
 6550:                // For every node of the triangle...
 6551:                Node *node = elem->nodes[j];
 6552: 
 6553:                if (node->isDry) continue;
 6554: 
 6555:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6556:                const Side *s2 = elem->sides[(j + 1) % 3];
 6557:                const Side *s3 = elem->sides[(j + 2) % 3];
 6558: 
 6559:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6560: 
 6561:                atomicAdd(&(node->tmp.i), 1);
 6562: 
 6563:                for (int k = kb; k < nvrt; k++)  {
 6564:                   Vector2 s1u2 = s1->u2[k];
 6565:                   Vector2 s2u2 = s2->u2[k];
 6566:                   Vector2 s3u2 = s3->u2[k];
 6567: 
 6568:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6569:                   if constexpr(ics == 2) {
 6570:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6571:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6572:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6573:                   }
 6574: 
 6575:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 6576:                   u = clampVelocity(u);
 6577:                   atomicAdd(&(node->utmp[k].x), u.x);
 6578:                   atomicAdd(&(node->utmp[k].y), u.y);
 6579: 
 6580:                }
 6581: 
 6582:             }
 6583:          }
 6584:          else { // For quads
 6585:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6586: 
 6587:          }
 6588: 
 6589:       }
 6590:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6591:       
 6592:    }
 6593: 
 6594: 
 6595:    __global__ void computeNodalHorizontalVelocities2(void) {
 6596:       NODE(node);
 6597: 
 6598:       const int nodeCount = node->tmp.i;
 6599: 
 6600:       if (nodeCount == 0) 
 6601:       {
 6602:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6603:          return;
 6604:       }
 6605: 
 6606:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6607:       
 6608:       const int kb = node->kb;
 6609: 
 6610:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6611:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6612:       
 6613:       
 6614:    }   
 6615: 
 6616:  
