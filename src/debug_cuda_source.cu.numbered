 3967: 
 3968: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3969:    // Computes the z coordinate at level k.
 3970:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3971:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3972:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3973:    // used 
 3974: 
 3975:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3976:    
 3977:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3978: 
 3979:    if (isDry2()) return 0.0;  
 3980: 
 3981:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3982: 
 3983:    if constexpr(ivcor == 2) {
 3984: 
 3985:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3986:       const double h_c = mesh->h_c;
 3987:       const double theta_f = mesh->theta_f;
 3988:       const double sinh_theta_f = mesh->sinh_theta_f;
 3989: 
 3990: 
 3991:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3992:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3993:       // once per time step/node. XXXX
 3994:       // CHECK: updateZCoordData
 3995: 
 3996:       //  To simplify comparisons, I define index versions of count variables.
 3997:       if      (k == ivrt)     return eta2; 
 3998:       else if (k == izlev)    return -hmod2;
 3999:       else if (k == kb)       return -depth;
 4000:       else if (k < izlev)     return mesh->ztot[k];
 4001:       else if (k > izlev) {
 4002:          const int ksig = k - izlev;
 4003: 
 4004:          if (hmod2 <= h_c) {
 4005:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 4006: 
 4007:          } 
 4008:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 4009:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 4010:             assert(false && "compZCoord: invalid h_c\n");
 4011:          } 
 4012:          else {
 4013:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 4014:                    h_c * mesh->sigma[ksig] + 
 4015:                    (hmod2 - h_c) * mesh->cs[ksig];
 4016:          }
 4017:       } else { 
 4018:          assert(false && "compZCoord: invalid level or coordinate system\n");
 4019:       }
 4020: 
 4021:    }
 4022:    else {  // if constexpr(ivcor == 1)
 4023:       if (k <= kb)        return -depth; 
 4024:       else if (k == ivrt) return eta2;
 4025:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 4026: 
 4027:    }
 4028:    
 4029:    assert(false && "compZCoord: invalid level or coordinate system\n");
 4030:    return 0.0;
 4031: }
 4032: 
 4033: 
 4034: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 4035:    // Computes the bottom drag Cd based on the selected nchi
 4036: 
 4037:    if constexpr(nchi == 0) {
 4038:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 4039:       Cd = drag;  // Read from drag file
 4040: 
 4041:    } else if constexpr(nchi == 1) {
 4042:       // 
 4043: 
 4044:       bool ltmp = false; // for WBL iteration
 4045: 
 4046:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4047:       if (isDry || (rough == 0.0)) {
 4048:          Cd = 0.0;
 4049: 
 4050:       } else { //roughness >0 
 4051:          
 4052:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4053: 
 4054:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4055: 
 4056:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4057: 
 4058:       } // if rough
 4059: 
 4060:    } else if constexpr(nchi == -1) {
 4061:    // Manning 
 4062:  
 4063:       const double htot = max(hmin_man, htot2()); 
 4064:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4065: 
 4066:    } else {
 4067:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4068:       
 4069:    } // if nchi
 4070: 
 4071: }
 4072: 
 4073: 
 4074: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4075:    // Checks if a side in on the boundary
 4076:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4077: 
 4078:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4079:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4080: 
 4081:    // Indices of the nodes that form the side
 4082:    //
 4083:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4084:    const int n1 = side.n1->idx;
 4085:    const int n2 = side.n2->idx;
 4086:    isLand = false;
 4087:    
 4088: 
 4089:    // Check if the side is on a land boundary
 4090:    for (int i = 0; i < nland; i++) {
 4091:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4092:          // Consecutive nodes in the land boundary segment
 4093:          const int b1 = ilnd[i + j*nland];
 4094:          const int b2 = ilnd[i + (j + 1)*nland];
 4095: 
 4096:          assert(b1 != -1 && b2 != -1);
 4097: 
 4098:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4099:             
 4100:             isLand = true;
 4101:             return i;
 4102:          }
 4103:       }
 4104:    }
 4105: 
 4106:    // Check if the side is on an open boundary
 4107:    for (int i = 0; i < nope; i++) {
 4108:       for (int j = 0; j < nond[i] - 1; j++) {
 4109:          // Consecutive nodes in the open boundary segment
 4110:          const int b1 = iond[i + j*nope];
 4111:          const int b2 = iond[i + (j + 1)*nope];
 4112: 
 4113:          assert(b1 != -1 && b2 != -1);
 4114: 
 4115:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4116:             isLand = false;
 4117:             return i;
 4118:          }
 4119:       }
 4120:    }
 4121: 
 4122: 
 4123:    return -1;
 4124: }
 4125: 
 4126: 
 4127: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4128:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4129:                                     double *wind_rotate_angle, 
 4130:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4131:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4132:                                     int16_t *nodePermutationSort, double *crs_data,
 4133:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4134:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4135:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4136:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4137:                                     double *drag, double *roughness, double *rmanning, 
 4138:                                     double *diffmin, double *diffmax,
 4139:                                     double *temp, double *salt,
 4140:                                     int *kb, double *localSigma) {
 4141: 
 4142:    NODE(pnode);  
 4143:    const int i = idx_node;
 4144:    const int iglobal = globalNodeIndices[i];
 4145:    Node &node(*pnode);
 4146: 
 4147:    node.idx = iglobal;
 4148:    node.part = localNodePart[iglobal];
 4149: 
 4150:    // It is important to differentiate between the global and local "start" indices because they
 4151:    // play different, but related, roles in this code. The global "start" indices are used
 4152:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4153:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4154:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4155:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4156:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4157:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4158:    node.numNodes = idxNodeEnd - idxNodeStart;
 4159:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4160: 
 4161:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4162:    node.coeffRow = crs_data + rowStart; 
 4163: 
 4164:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4165: 
 4166: 
 4167: 
 4168:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4169:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4170:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4171:    node.numElements = idxElemEnd - idxElemStart;
 4172:    node.elements = nodeNeighElems + idxElemLocalStart;
 4173: 
 4174: 
 4175:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4176:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4177:       const int partNode = localNodePart[idxNodeGlobal]; 
 4178:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4179: 
 4180:       Node *node_ptr = nodes[partNode] + idxNode;
 4181:       
 4182:       nodeNeighNodes[idxLocal] = node_ptr;
 4183:    }
 4184: 
 4185: 
 4186:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4187:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4188:       const int partElem = localElemPart[idxElemGlobal];
 4189:       const int idxElem  = localElemIndices[idxElemGlobal];
 4190: 
 4191:       Element *elem_ptr = elems[partElem] + idxElem;
 4192: 
 4193:       nodeNeighElems[idxLocal] = elem_ptr;
 4194:    }      
 4195: 
 4196:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4197:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4198: 
 4199:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4200: 
 4201:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4202:    if constexpr(ics == 1) {
 4203:       node.p.x   = node_coords[i * 3];
 4204:       node.p.y   = node_coords[i * 3 + 1];
 4205:       node.gz = 0.0;
 4206: 
 4207:       if (use_ll) {                                    // <-- add
 4208:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4209:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4210:       }  
 4211: 
 4212:    } else {
 4213:       const double lon = deg2rad*node_coords[i * 3];
 4214:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4215: 
 4216:       Point3 p = computeXYZfromLatLon(lat, lon);
 4217:       node.p = toVector2(p);
 4218:       node.gz = p.z;
 4219:       node.lon = lon;
 4220:       node.lat = lat;
 4221: 
 4222:       #ifdef USE_FRAMES
 4223:       node.setFrame(lat, lon);
 4224:       #endif
 4225: 
 4226: 
 4227:    }
 4228: 
 4229:    node.depth = node_coords[i * 3 + 2];
 4230: 
 4231:    node.numSides = 0;
 4232: 
 4233:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4234:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4235:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4236:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4237:    else assert(false && "populateNodes: selected nchi not implemented.");
 4238: 
 4239:    // Populate the diffmin and diffmax values read from the files.
 4240:    // (Only used for GLS, GOTM, and SedimentMix.)
 4241:    node.turb.setDiffLimits(diffmin[iglobal], diffmax[iglobal]);
 4242: 
 4243:    // Cold-start T,S: vertically homogeneous nodal I.C. (temp.ic/salt.ic or barotropic constants).
 4244:    // tr0 keeps the initial field (e.g. type-3 open BC); tracers is the working nodal state.
 4245:    {
 4246:       const double t0 = temp[iglobal];
 4247:       const double s0 = salt[iglobal];
 4248:       for (int k = 0; k < nvrt; k++) {
 4249:          node.tr0[k].tracer[0]     = t0;
 4250:          node.tr0[k].tracer[1]     = s0;
 4251:          node.tracers[k].tracer[0] = t0;
 4252:          node.tracers[k].tracer[1] = s0;
 4253:       }
 4254:    }
 4255: 
 4256:    if constexpr(ivcor == 1) 
 4257:    {  
 4258:       node.kb = kb[iglobal];
 4259: 
 4260:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4261:    }
 4262: 
 4263:    for (int k = 0; k < nvrt; k++) {
 4264:       node.rho[k] = rho0;
 4265:       node.z[k] = -1e20;
 4266:    }
 4267: 
 4268:    // Initialize the turbulence model including the vertical viscosity/diffusivity
 4269:    node.turb.init(&node);
 4270: 
 4271:    
 4272:    // Links the node to the boundary information
 4273:    if (isbnd[iglobal] >= 0) {
 4274:      
 4275:       // Get the index of the node boundary
 4276:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4277: 
 4278:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4279:       node.nodeBnd->node = &node;
 4280: 
 4281:       node.nodeBnd->sideBnd1 = nullptr;
 4282:       node.nodeBnd->sideBnd2 = nullptr;
 4283: 
 4284:       if (isbnd[iglobal]>=0) {
 4285: 
 4286:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4287:          
 4288:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4289:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4290: 
 4291:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4292:          node.nodeBnd->segment->clen  = nan("1");
 4293:          node.nodeBnd->segment->carea = nan("1");
 4294: 
 4295:       }
 4296:    } else {
 4297: 
 4298:       node.nodeBnd = nullptr; // For internal nodes
 4299: 
 4300:       if (isbnd[iglobal] == landSegment) {
 4301:          node.nodeBnd = landBoundaryNode;
 4302:          node.nodeBnd->segment = landBoundarySegment;
 4303:       }
 4304:       
 4305:    }
 4306:    
 4307:    // XXXX GAUSSIAN HILL VELOCITIES
 4308:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4309:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4310:          constexpr double rot_per = 3000.0;
 4311:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4312:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4313:       // XXXXX
 4314:    #endif
 4315: 
 4316: }
 4317: 
 4318: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4319:    
 4320:    NODE(node);
 4321:    const int localIdx = idx_node;
 4322: 
 4323: 
 4324:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4325:    int16_t *csrSlot = node->csrSlot;  
 4326: 
 4327:    // Simply count the number of nodes with a smaller global index than the current node.
 4328:    // It accounts for the diagonal element.
 4329:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4330:    // local index, but taking into account all the partitions (in order).
 4331:    for (int i = 0; i < node->numNodes; ++i) {
 4332:       const int col = node->nodes[i]->packedIndex();
 4333:       int16_t idx = 0;
 4334: 
 4335:       //Takes care of the diagonal element.
 4336:       if (node->packedIndex() < col) ++idx;          
 4337: 
 4338:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4339:       csrSlot[i] = idx;
 4340:    }
 4341: 
 4342:    // Find the diagonal element in the CRS matrix.
 4343:    int16_t idxDiag = 0;
 4344:    for (int j = 0; j < node->numNodes; ++j)
 4345:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4346: 
 4347:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4348: 
 4349:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4350:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4351: 
 4352:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4353:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4354:    crs_indptr[localIdx] = rowStart;
 4355: 
 4356:    // Fills crs_indices array using the per-partition indexing.
 4357:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4358:    crs_indices[rowStart + d] = node->packedIndex();  
 4359:    for (int j = 0; j < node->numNodes; ++j) {
 4360:       Node *nb = node->nodes[j];
 4361:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4362:    }
 4363: 
 4364: 
 4365: }
 4366: 
 4367: 
 4368: 
 4369: 
 4370: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4371:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4372:                                     double *wind_rotate_angle,   
 4373:                                     int *isdel, int *isidenode, int *isbnd,
 4374:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4375:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4376:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4377:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4378:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4379:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4380:                                     double *drag, double *roughness) {
 4381: 
 4382: 
 4383:    SIDE(pside);
 4384:    Side &side(*pside);
 4385:    const int i = idx_side;
 4386:    const int iglobal = globalSideIndices[i];
 4387:    side.idx = iglobal;  
 4388:    
 4389:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4390:    const double fc   = 2.0*omega_e*sin(sfea0);
 4391:    const double beta = 2.0*omega_e*cos(sfea0);
 4392: 
 4393:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4394: 
 4395:    // finding the pointer to the nodes that form the side
 4396:    const int idx_n1 = isidenode[iglobal*2];
 4397:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4398: 
 4399: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4400: 
 4401:    const int locidx_n1 = localNodeIndices[idx_n1];
 4402:    const int locidx_n2 = localNodeIndices[idx_n2];
 4403:    const int part_n1 =   localNodePart[idx_n1];
 4404:    const int part_n2 =   localNodePart[idx_n2];
 4405: 
 4406: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4407: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4408: 
 4409:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4410:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4411: 
 4412: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4413: 
 4414:    // Counts the number of sides connected to each node
 4415:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4416:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4417: 
 4418:    // Side boundary type
 4419:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4420:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4421: // if (i == 0) printf("populateSides: 2\n");
 4422: 
 4423:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4424:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4425:    {
 4426:       bool isLand = false;
 4427:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4428:       
 4429:       if (isbs > -1) {
 4430:          // assert(isLand || isbs>=0);
 4431:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4432: 
 4433:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4434: 
 4435:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4436:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4437: 
 4438:          assert (isLand == side.sideBnd->segment->isLand);
 4439:          
 4440:          side.sideBnd->side = &side;
 4441: 
 4442:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4443:          n1bnd->linkSideBoundary(side.sideBnd);
 4444:          n2bnd->linkSideBoundary(side.sideBnd);
 4445: 
 4446:       }
 4447:       else {
 4448:          side.sideBnd = nullptr;
 4449:       }
 4450:    }
 4451:    else 
 4452:    {
 4453:       side.sideBnd = nullptr;
 4454:    }
 4455: 
 4456: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4457: 
 4458:    // finding the pointer to the elements that share the side
 4459:    const int idx_e1 = isdel[iglobal*2];
 4460:    const int idx_e2 = isdel[iglobal*2 + 1];
 4461: 
 4462:    if (idx_e1 > -1) {
 4463:       const int locidx_e1 = localElemIndices[idx_e1];
 4464:       const int part_e1 =  localElemPart[idx_e1];
 4465:       side.elems[0] = elems[part_e1] + locidx_e1;
 4466: 
 4467:    }
 4468:    else {
 4469:       side.elems[0] = nullptr;
 4470:    }
 4471: 
 4472: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4473: 
 4474:    if (idx_e2 > -1) {
 4475:       const int locidx_e2 = localElemIndices[idx_e2];
 4476:       const int part_e2 =  localElemPart[idx_e2];
 4477:       side.elems[1] = elems[part_e2] + locidx_e2;
 4478:    }
 4479:    else {
 4480:       side.elems[1] = nullptr;
 4481:    }
 4482: 
 4483: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4484: 
 4485:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4486:       
 4487:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4488:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4489:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4490:          
 4491:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4492:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4493:       // printf("sideBnd: %p\n", side.sideBnd);
 4494:       // assert(false && "Side has no elements and no boundary");
 4495:    }
 4496:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4497: 
 4498:    // Compute the center of the side
 4499:    side.center = 0.5*(side.n1->p + side.n2->p);
 4500: 
 4501:    #ifdef USE_FRAMES
 4502:    side.setFrame();
 4503:    #endif
 4504: 
 4505: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4506: 
 4507:    // Normal, unitary vector to the side
 4508:    if constexpr(ics == 1) {
 4509:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4510:       side.n = normalize(side.n);
 4511:    }
 4512:    else {
 4513:       // Unit side vector in 3D cartesian coordinates
 4514:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4515: 
 4516:       nSide = normalize(nSide);
 4517: 
 4518:       // Its cross product with the unit local z-axis vector (nUp) is the
 4519:       // normal vector we are looking for.
 4520:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4521: 
 4522:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4523:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4524:       side.n = -normalize(n2D); 
 4525: 
 4526:    }
 4527: 
 4528: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4529: 
 4530:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4531:    side.shapiro = shapiro0;
 4532: 
 4533:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4534:    // XXXX
 4535:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4536:    constexpr double rot_per=3000.0;
 4537:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4538:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4539:    // XXXXX      
 4540:    #endif
 4541:    // Compute the z level at the center of the side
 4542:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4543:    
 4544:    // Compute the length of the side
 4545:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4546: 
 4547: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4548: 
 4549:    // Compute the Coriolis coefficient
 4550: 
 4551:    if constexpr(ncor == -1 || ncor == 0) {
 4552:       side.coriolis = coricoef;
 4553:    }
 4554:    else {
 4555:       const double sphi = side.lat();  // Latitude at the center of the side
 4556: 
 4557:       assert(use_ll && "use_ll must be true when ncor > 0");
 4558: 
 4559:       if constexpr(ics == 1) {
 4560:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4561:       }
 4562:       else { // ics == 2
 4563:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4564:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4565:       }
 4566: 
 4567:    }
 4568: 
 4569: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4570: 
 4571: }
 4572: 
 4573: 
 4574: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4575:    double *node_coords, double *node_coords_ll, bool use_ll,
 4576:    double *wind_rotate_angle,   
 4577:    int *isdel, int *isidenode, int *isbnd,
 4578:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4579:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4580:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4581:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4582:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4583:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4584:    double *drag, double *roughness) {
 4585: 
 4586:    ELEM(pelem);
 4587:    Element &elem(*pelem);
 4588:    const int i = idx_elem;
 4589: 
 4590:    elem.idx = i;
 4591: 
 4592:    for (int j = 0; j < i34[i]; j++) {
 4593:       const int idxNode = elnode[i*4 + j];  
 4594:       const int idxSide = elside[i*4 + j];
 4595:       
 4596:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4597:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4598: 
 4599:       // Find the neighboring element  
 4600:       if (elem.sides[j]->elems[0] == &elem) {
 4601:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4602:       }
 4603:       else {
 4604:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4605:       }
 4606:       
 4607:    }
 4608: 
 4609:    elem.i34 = i34[i];
 4610: 
 4611:    // Compute the barycenter of the element and its depth
 4612:    elem.center = {0.0, 0.0};
 4613:    elem.depth = 1e10;
 4614:    for (int j = 0; j < i34[i]; j++) {
 4615: 
 4616:       elem.center += elem.nodes[j]->p/i34[i];
 4617:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4618:    }
 4619: 
 4620:    #ifdef USE_FRAMES
 4621:    elem.setFrame();
 4622:    #endif
 4623: 
 4624:    elem.area = elem.computeSignedArea(); 
 4625:    elem.radius = sqrt(elem.area)/pi; 
 4626:    
 4627:    // Determines which way the normal vector to each side is oriented.
 4628:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4629:    for (int j = 0; j < i34[i]; j++)  
 4630:    {
 4631:       if (elem.sides[j]->elems[0] == &elem) {
 4632:          elem.ssign[j] =  1.0;
 4633:       }
 4634:       else {
 4635:          elem.ssign[j] = -1.0;
 4636:       }
 4637: 
 4638:    }
 4639: 
 4640:   
 4641: 
 4642:    // Derivatives of shape functions
 4643:    //  For ics=2, this is done in the element frame
 4644:    //  For quads, the derivative is evaluated at centroid
 4645:    for (int j = 0; j < elem.i34; j++) {
 4646:       const double area = elem.area;
 4647:       const int id2 = elem.nxq(1 + j);
 4648:       const int id3 = elem.nxq(2 + j);
 4649:       const int id4 = elem.nxq(3 + j);
 4650:       if (elem.isTri()) {
 4651:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4652:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4653:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4654:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4655:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4656:          // And so on for the other shape functions.
 4657: 
 4658:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4659:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4660:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4661: 
 4662:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4663:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4664: 
 4665:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4666: 
 4667:       }
 4668:       else  { // Quad, the derivatives are evaluated at the centroid
 4669: 
 4670:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4671:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4672:          // ...
 4673:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4674: 
 4675:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4676:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4677:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4678: 
 4679:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4680:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4681: 
 4682:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4683: 
 4684:       } // if Tri/Quad
 4685: 
 4686:    } // for j   
 4687: 
 4688:    // Initial element tracers: average surrounding nodal I.C. (levels k and k-1)
 4689:    // For level k: average of node values at k and k-1 over the element nodes.
 4690:    // Level 0 copies level 1 (Fortran tr_el(:,1)=tr_el(:,2)).
 4691:    const double inv = 1.0 / (2.0 * elem.i34);
 4692:    for (int k = 1; k < nvrt; k++) {
 4693:       Tracers sum = {};
 4694:       for (int j = 0; j < elem.i34; j++) {
 4695:          const Node *nd = elem.nodes[j];
 4696:          for (int itr = 0; itr < ntracers; itr++)
 4697:             sum.tracer[itr] += nd->tr0[k].tracer[itr] + nd->tr0[k - 1].tracer[itr];
 4698:       }
 4699:       for (int itr = 0; itr < ntracers; itr++)
 4700:          elem.tracers[k].tracer[itr] = inv * sum.tracer[itr];
 4701:    }
 4702:    elem.tracers[0] = elem.tracers[1];
 4703: 
 4704: }
 4705: 
 4706: 
 4707: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4708:                                             double *emo, double *efa, 
 4709:                                             double *umo, double *ufa, 
 4710:                                             double *vmo, double *vfa,
 4711:                                             int *ifltype, int *iettype, 
 4712:                                             double *qthcon, double *eth) {
 4713: 
 4714:    NODE_BND(nodeBnd);
 4715:    const int idx = idx_node_bnd;    
 4716: 
 4717:    nodeBnd->idx = idx;
 4718: 
 4719:    // Need to find the segment index and the index of the node on the segment
 4720:    int idxNode = -1;
 4721:    int iseg, i;
 4722:    for (iseg = 0; iseg < nope; iseg++) {
 4723:       // for each segment...
 4724:       for (i = 0; i < nond[iseg]; i++) {
 4725:          idxNode = iond[iseg + i*nope];
 4726:          if (idxNode == nodeBnd->node->idx) 
 4727:          {
 4728:             // This is done for every segment that the node is part of, overwriting the previous values.
 4729:             // The result is that the segment with the highest index is the one that is used.
 4730:             nodeBnd->isEssentialBC = (iettype[iseg] != 0);
 4731:             nodeBnd->elbc = 0.0;
 4732: 
 4733:             // XXXXXX This may make more sense in populateBoundarySides.
 4734:             nodeBnd->segment->ifltype = ifltype[iseg];
 4735:             nodeBnd->segment->iettype = iettype[iseg];
 4736:             nodeBnd->segment->qthcon  = qthcon[iseg];
 4737:             nodeBnd->segment->eth     = eth[iseg];
 4738:             nodeBnd->eth     = eth[iseg]; // XXXXXXX Is this always needed? ot only for certain ietype?
 4739:             nodeBnd->segment->idx = iseg;
 4740: 
 4741:             for (int jfr = 0; jfr < nbfr; jfr++) {
 4742: 
 4743:                const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4744: 
 4745:                nodeBnd->efa[jfr] = efa[idx2];
 4746:                nodeBnd->emo[jfr] = emo[idx2];
 4747: 
 4748:             }
 4749:          }         
 4750:       }
 4751:    }
 4752: 
 4753: 
 4754:    assert(iseg <= nope && "iseg is out of bounds");
 4755: 
 4756: 
 4757: 
 4758: 
 4759:         
 4760: 
 4761: }
 4762: 
 4763: __device__ void Mesh::populateBoundarySides(int *nond, int *iond,
 4764:                                             double *emo, double *efa, 
 4765:                                             double *umo, double *ufa, 
 4766:                                             double *vmo, double *vfa,
 4767:                                             int *ifltype, int *iettype, double *qthcon) {
 4768: 
 4769:    SIDE_BND(sideBnd);
 4770: 
 4771:    const Side *side = sideBnd->side;
 4772: 
 4773: 
 4774:    // Indices of the nodes on the side 
 4775:    const int n1 = side->n1->idx;
 4776:    const int n2 = side->n2->idx;
 4777: 
 4778:    const int iseg = sideBnd->segment->idx;
 4779: 
 4780:    // Find the index of the side in the segment data array.
 4781:    for (int i = 0; i < nond[iseg] - 1; i++) {
 4782: 
 4783:       // Indices of the nodes at both ends of the side (obtained from the boundary node list)
 4784:       const int b1 = iond[iseg + i*nope];
 4785:       const int b2 = iond[iseg + (i + 1)*nope];
 4786: 
 4787:       // Find the side that connects the two nodes by comparing the indices of the nodes at both ends of the side (computed from 
 4788:       // the boundary node list) with the indices of the nodes at the ends of the side (obtained from the side structure).
 4789:       if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4790: 
 4791:          for (int jfr = 0; jfr < nbfr; jfr++) {
 4792:          // For each tidal component...
 4793: 
 4794:             const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4795: 
 4796:             // velocity magnitude at both ends of the side (1,2)            
 4797:             const double umo1 = umo[idx2];
 4798:             const double vmo1 = vmo[idx2];
 4799:             const double umo2 = umo[idx2 + nope];
 4800:             const double vmo2 = vmo[idx2 + nope];
 4801: 
 4802:             // velocity phases at both ends of the side (1,2)
 4803:             const double ufa1 = ufa[idx2];
 4804:             const double vfa1 = vfa[idx2];
 4805:             const double ufa2 = ufa[idx2 + nope];
 4806:             const double vfa2 = vfa[idx2 + nope];
 4807: 
 4808:             // These expressions compute the amplitude and phase of the velocity components at the center of the side.
 4809:             // The expressions replicate SCHISM by computing equivalent amplitude and phase for the velocity components at the center of the side.
 4810:             // Equivalent to SCHISM: average of the two reconstructed node tides
 4811:             //   0.5 * (a1*cos(theta - phi1) + a2*cos(theta - phi2))
 4812:             // with theta = amig*t + face. Folded here into one (umo, ufa) per
 4813:             // frequency so the step only does ramp*ff*umo*cos(theta - ufa).
 4814:             // Fortran keeps both (a, phi) on the nodes and averages after the
 4815:             // cosines; the result is the same.
 4816:             sideBnd->umo[jfr] = {0.5*sqrt(pow<2>(umo1) + pow<2>(umo2) + 2*umo1*umo2*cos(ufa1 - ufa2)), 0.5*sqrt(pow<2>(vmo1) + pow<2>(vmo2) + 2*vmo1*vmo2*cos(vfa1 - vfa2))};
 4817:             sideBnd->ufa[jfr] = {atan2(umo1*sin(ufa1) + umo2*sin(ufa2), umo1*cos(ufa1) + umo2*cos(ufa2)), atan2(vmo1*sin(vfa1) + vmo2*sin(vfa2), vmo1*cos(vfa1) + vmo2*cos(vfa2))};
 4818: 
 4819:          } // for jfr
 4820: 
 4821:       }
 4822:    }
 4823: 
 4824: 
 4825: }
 4826: 
 4827: __device__ void Mesh::populateBoundarySideLinks(void) {
 4828: 
 4829:    SIDE_BND(sideBnd);
 4830: 
 4831:    const Side *side = sideBnd->side;
 4832: 
 4833:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4834:    // and the rightSide is the side s that has s->n1 == side->n2
 4835:    for (int i = 0; i < mesh->nbs; i++) {
 4836: 
 4837:       Side *s = &mesh->localSideData[i];
 4838: 
 4839:       if (s == side) continue;  // Do not link the side to itself
 4840:    
 4841:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4842:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4843:    }
 4844: 
 4845:   
 4846: }
