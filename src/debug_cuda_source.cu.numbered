 1712: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1713:    return;
 1714:    // Lock the mutex
 1715:    lock(&debugPlotMutex);
 1716:  
 1717:    bool ok = true;
 1718:    if (debugPlotIdx == nullptr) ok = false;
 1719:    if (*debugPlotIdx >= 10000) ok = false;
 1720:    if (ok) {
 1721:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1722:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1723:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1724:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1725:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1726:       (*debugPlotIdx)++;
 1727:    }
 1728: 
 1729:    __threadfence();               // ensure all above writes are visible
 1730:    // Unlock the mutex
 1731:    unlock(&debugPlotMutex);
 1732: 
 1733: }
 1734: 
 1735: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1736:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1737: }
