 7171: 
 7172: __global__ void computeMatrixProductAndDotProducts() {
 7173:    // Computes A*p, r'Mr and p'Ap
 7174: 
 7175:    // 1) shared buffer: first half for rMr, second for pAp
 7176:    __shared__ double sdata[2*BLOCK_SIZE];
 7177:    double* s_rMr = sdata;
 7178:    double* s_pAp = sdata + BLOCK_SIZE;
 7179: 
 7180:    s_rMr[threadIdx.x] = 0.0;
 7181:    s_pAp[threadIdx.x] = 0.0;
 7182: 
 7183:    // 2) get your node pointer
 7184:    NODE(node);  
 7185:    const int tid = threadIdx.x;
 7186: 
 7187:    const double diag = node->coeffDiag;
 7188:    const double r    = node->mR;
 7189:    const double p    = node->mP;  
 7190: 
 7191:    // apply preconditioner on the fly:
 7192:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7193: 
 7194:    // 4) compute Ap = A.p
 7195:    double Ap = node->coeffDiag * node->mP;
 7196:    for (int j = 0; j < node->numNodes; ++j) {
 7197:       const Node *nbNode = node->nodes[j];
 7198:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7199: 
 7200:    }
 7201:    node->mAp = Ap;
 7202:     
 7203: 
 7204:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7205:    const double l_rMr = r*Mr;  // r'Mr
 7206:    const double l_pAp = p*Ap;  // p'Ap
 7207: 
 7208:    // 6) write into shared mem
 7209:    s_rMr[tid] = l_rMr;
 7210:    s_pAp[tid] = l_pAp;
 7211: 
 7212:    __syncthreads();
 7213: 
 7214:    // 7) block-wide tree reduction
 7215:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7216:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7217:       __syncthreads();
 7218:    }
 7219: 
 7220:    // 8) thread 0 atomically accumulates into the globals
 7221:    // XXX: This is slower than it needs to be, but it is simple and works
 7222:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7223: 
 7224: 
 7225: }
 7226: 
 7227: 
 7228: __global__ void updateSolutionAndDotProducts(void) {
 7229:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7230: 
 7231:    s_rMr[threadIdx.x] = 0.0;
 7232: 
 7233: 
 7234:    // get node & bounds-check:
 7235:    NODE(node);
 7236:    const int tid = threadIdx.x;
 7237: 
 7238: 
 7239:    // Compute alpha
 7240:    const double alpha = (*rMr_old)/(*pAp);
 7241: 
 7242:    // load scalars
 7243:    const double diag = node->coeffDiag;
 7244:    const double p    = node->mP;
 7245:    const double Ap   = node->mAp;
 7246:    const double x    = node->mX;
 7247:    const double r    = node->mR;
 7248:    
 7249:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7250: 
 7251:    // 1) update solution & residual
 7252:    const double x_new = x + alpha*p;
 7253:    const double r_new = r - alpha*Ap;
 7254:    node->mX = x_new;
 7255:    node->mR = r_new;
 7256: 
 7257:    // 2) apply Jacobi preconditioner on the fly
 7258:    const double Mr_new = r_new/diag;
 7259: 
 7260: 
 7261:    // 3) local contributions for the two dot-products
 7262:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7263: 
 7264:    // 4) write into shared-mem
 7265:    s_rMr[tid] = l_rMr;
 7266: 
 7267:    __syncthreads();
 7268: 
 7269: 
 7270:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7271:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7272:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7273:       __syncthreads();
 7274:    }
 7275: 
 7276:    // 6) thread 0 atomically folds into the global accumulators
 7277:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7278: 
 7279: 
 7280: }
 7281: 
 7282: 
 7283: __global__ void updateSearchDirection() {
 7284:     NODE(node);
 7285: 
 7286:     // recompute z on-the-fly
 7287:     const double z = node->mR / node->coeffDiag;
 7288:     const double p = node->mP;
 7289: 
 7290:     const double beta = (*rMr_new)/(*rMr_old);
 7291: 
 7292: 
 7293:     // p =z + beta*p
 7294:     node->mP = z + beta*p;
 7295: 
 7296: }
 7297: 
 7298: __global__ void initializePreconditionedResidual(double *scalars) {
 7299: 
 7300:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7301: 
 7302:     s_rMr[threadIdx.x] = 0.0;
 7303: 
 7304:     NODE(node);
 7305:     const int tid = threadIdx.x;
 7306:     // For the first iteration:
 7307:     // 1. Initial solution x = 0 (already set)
 7308:     // 2. Initial residual r = b (stored in qel)
 7309:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7310: 
 7311: // XXX we should use the guess solution here    
 7312: 
 7313:     // Set initial residual r = b (from qel)
 7314:     node->mR = node->qel;
 7315: 
 7316:     // Compute z = M^-1 * r (preconditioned residual)
 7317:     const double z = node->mR / node->coeffDiag;
 7318: 
 7319:     // Set initial search direction p = z
 7320:     node->mP = z;
 7321: 
 7322:     // Initialize other variables needed for CG
 7323:     node->mX = 0.0;  // Initial solution
 7324:     node->mAp = 0.0; // Will be computed in first iteration
 7325: 
 7326:     // These point to a cupy array in the host code
 7327:     rMr_old = scalars + 0;
 7328:     rMr_new = scalars + 1;
 7329:     pAp     = scalars + 2;
 7330: 
 7331:     // Computes the first r'Mr (reduction)
 7332:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7333: 
 7334:     // 4) write into shared-mem
 7335:     s_rMr[tid] = l_rMr;
 7336: 
 7337:     __syncthreads();
 7338: 
 7339: 
 7340:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7341:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7342:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7343:         __syncthreads();
 7344:     }
 7345: 
 7346:     // 6) thread 0 atomically folds into the global accumulators
 7347:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7348: 
 7349:     *rMr_old = 0.0;
 7350:     *pAp = 0.0;
 7351: }
 7352: 
 7353: 
 7354: 
 7355: 
 7356: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7357:    // Get the value of a variable from an element
 7358:    // varName is the name of the variable to get
 7359:    // var is the array to store the value
 7360:    // k is the vertical level index of the variable to get
 7361: 
 7362:    ELEM(elem);
 7363:    
 7364:    int idx = elem->idx;
 7365:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7366: 
 7367:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7368:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7369:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7370:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7371:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7372:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7373:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7374:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7375:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7376:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7377:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7378:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7379:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7380:       
 7381:    
 7382: }
 7383: 
 7384: 
 7385: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7386:    // Get the value of a variable from an node
 7387:    // varName is the name of the variable to get
 7388:    // var is the array to store the value
 7389:    // k is the vertical level index of the variable to get
 7390: 
 7391:    NODE(node);
 7392:    
 7393:    int idx = node->idx;
 7394:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7395: 
 7396:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7397:    
 7398:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7399:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7400:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7401:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7402:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7403:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7404:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7405:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7406:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7407:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7408:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7409:    
 7410:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7411:       
 7412:    
 7413: }
 7414: 
 7415: 
 7416: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7417:    // Get the value of a variable from an side
 7418:    // varName is the name of the variable to get
 7419:    // var is the array to store the value
 7420:    // k is the vertical level index of the variable to get
 7421:    SIDE(side);
 7422:    
 7423:    int idx = side->idx;
 7424:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7425: 
 7426:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7427:    
 7428:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7429:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7430:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7431:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7432:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7433:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7434:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7435:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7436:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7437:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7438:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7439:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7440:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7441:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7442:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7443:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7444:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7445:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7446:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7447:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7448:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7449:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7450:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7451:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7452: }
