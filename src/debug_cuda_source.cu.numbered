 6537: 
 6538: __global__ void computeMatrixProductAndDotProducts() {
 6539:    // Computes A*p, r'Mr and p'Ap
 6540: 
 6541:    // 1) shared buffer: first half for rMr, second for pAp
 6542:    __shared__ double sdata[2*BLOCK_SIZE];
 6543:    double* s_rMr = sdata;
 6544:    double* s_pAp = sdata + BLOCK_SIZE;
 6545: 
 6546:    s_rMr[threadIdx.x] = 0.0;
 6547:    s_pAp[threadIdx.x] = 0.0;
 6548: 
 6549:    // 2) get your node pointer
 6550:    NODE(node);  
 6551:    const int tid = threadIdx.x;
 6552: 
 6553:    const double diag = node->coeffDiag;
 6554:    const double r    = node->mR;
 6555:    const double p    = node->mP;  
 6556: 
 6557:    // apply preconditioner on the fly:
 6558:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 6559: 
 6560:    // 4) compute Ap = A.p
 6561:    double Ap = node->coeffDiag * node->mP;
 6562:    for (int j = 0; j < node->numNodes; ++j) {
 6563:       const Node *nbNode = node->nodes[j];
 6564:       Ap += node->coeffMatrix[j] * nbNode->mP;
 6565: 
 6566:    }
 6567:    node->mAp = Ap;
 6568:     
 6569: 
 6570:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 6571:    const double l_rMr = r*Mr;  // r'Mr
 6572:    const double l_pAp = p*Ap;  // p'Ap
 6573: 
 6574:    // 6) write into shared mem
 6575:    s_rMr[tid] = l_rMr;
 6576:    s_pAp[tid] = l_pAp;
 6577: 
 6578:    __syncthreads();
 6579: 
 6580:    // 7) block-wide tree reduction
 6581:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6582:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 6583:       __syncthreads();
 6584:    }
 6585: 
 6586:    // 8) thread 0 atomically accumulates into the globals
 6587:    // XXX: This is slower than it needs to be, but it is simple and works
 6588:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 6589: 
 6590: 
 6591: }
 6592: 
 6593: 
 6594: __global__ void updateSolutionAndDotProducts(void) {
 6595:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 6596: 
 6597:    s_rMr[threadIdx.x] = 0.0;
 6598: 
 6599: 
 6600:    // get node & bounds-check:
 6601:    NODE(node);
 6602:    const int tid = threadIdx.x;
 6603: 
 6604: 
 6605:    // Compute alpha
 6606:    const double alpha = (*rMr_old)/(*pAp);
 6607: 
 6608:    // load scalars
 6609:    const double diag = node->coeffDiag;
 6610:    const double p    = node->mP;
 6611:    const double Ap   = node->mAp;
 6612:    const double x    = node->mX;
 6613:    const double r    = node->mR;
 6614:    
 6615:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 6616: 
 6617:    // 1) update solution & residual
 6618:    const double x_new = x + alpha*p;
 6619:    const double r_new = r - alpha*Ap;
 6620:    node->mX = x_new;
 6621:    node->mR = r_new;
 6622: 
 6623:    // 2) apply Jacobi preconditioner on the fly
 6624:    const double Mr_new = r_new/diag;
 6625: 
 6626: 
 6627:    // 3) local contributions for the two dot-products
 6628:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 6629: 
 6630:    // 4) write into shared-mem
 6631:    s_rMr[tid] = l_rMr;
 6632: 
 6633:    __syncthreads();
 6634: 
 6635: 
 6636:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6637:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6638:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6639:       __syncthreads();
 6640:    }
 6641: 
 6642:    // 6) thread 0 atomically folds into the global accumulators
 6643:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 6644: 
 6645: 
 6646: }
 6647: 
 6648: 
 6649: __global__ void updateSearchDirection() {
 6650:     NODE(node);
 6651: 
 6652:     // recompute z on-the-fly
 6653:     const double z = node->mR / node->coeffDiag;
 6654:     const double p = node->mP;
 6655: 
 6656:     const double beta = (*rMr_new)/(*rMr_old);
 6657: 
 6658: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 6659: 
 6660:     // p =z + beta*p
 6661:     node->mP = z + beta*p;
 6662: 
 6663: }
 6664: 
 6665: __global__ void initializePreconditionedResidual(double *scalars) {
 6666: 
 6667:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 6668: 
 6669:     s_rMr[threadIdx.x] = 0.0;
 6670: 
 6671:     NODE(node);
 6672:     const int tid = threadIdx.x;
 6673:     // For the first iteration:
 6674:     // 1. Initial solution x = 0 (already set)
 6675:     // 2. Initial residual r = b (stored in qel)
 6676:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 6677: 
 6678: // XXX we should use the guess solution here    
 6679: 
 6680:     // Set initial residual r = b (from qel)
 6681:     node->mR = node->qel;
 6682: 
 6683:     // Compute z = M^-1 * r (preconditioned residual)
 6684:     const double z = node->mR / node->coeffDiag;
 6685: 
 6686:     // Set initial search direction p = z
 6687:     node->mP = z;
 6688: 
 6689:     // Initialize other variables needed for CG
 6690:     node->mX = 0.0;  // Initial solution
 6691:     node->mAp = 0.0; // Will be computed in first iteration
 6692: 
 6693:     // These point to a cupy array in the host code
 6694:     rMr_old = scalars + 0;
 6695:     rMr_new = scalars + 1;
 6696:     pAp     = scalars + 2;
 6697: 
 6698:     // Computes the first r'Mr (reduction)
 6699:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 6700: 
 6701:     // 4) write into shared-mem
 6702:     s_rMr[tid] = l_rMr;
 6703: 
 6704:     __syncthreads();
 6705: 
 6706: 
 6707:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6708:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6709:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6710:         __syncthreads();
 6711:     }
 6712: 
 6713:     // 6) thread 0 atomically folds into the global accumulators
 6714:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 6715: 
 6716:     *rMr_old = 0.0;
 6717:     *pAp = 0.0;
 6718: }
