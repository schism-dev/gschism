  885:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  886:                                        Point3 &xt, double zint, Vector3 &u_int);
  887:     
  888:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  889:                                                  Element *&nextElem, int &jlev, double &dt, double time_rm,
  890:                                                  const Side *origSide);
  891: 
