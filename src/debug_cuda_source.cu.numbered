 2746: //       const double y4 = nodes[nxq(i+1)]->y;
 2747: 
 2748: //       const Side& side = sides[i];
 2749: 
 2750: //       xIntersect=-1.e25;
 2751: //       yIntersect=-1.e25;
 2752: 
 2753: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2754: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2755: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2756: 
 2757: //       if (delta != 0.0) {
 2758: //          // Solves the two linear equations for tt1 and tt2
 2759: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2760: //          const double tt2 = delta2/delta;
 2761: 
 2762: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2763: //          // Similarly, we use tt2 to compute the intersection point.
 2764: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2765: //             xIntersect = x3 + (x4 - x3)*tt2;
