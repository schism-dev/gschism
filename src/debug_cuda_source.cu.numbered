 1855:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1856:       // Compute the different time ramps used in the code 
 1857:       // This function is performed by just one thread
 1858: 
 1859:       rampbc = 1.0;
 1860:       if constexpr(ibc == 0) {
 1861:          if (drampbc > 0.0) {
 1862:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1863:          } else {
 1864:             rampbc = 1.0;
 1865:          }
 1866:       }
 1867: 
 1868:       if (nws != 0) {
 1869:          if (drampwind > 0.0) {
 1870:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1871:          } else {
 1872:             rampwind = 1.0;
 1873:          }
 1874:       }
 1875: 
 1876:       if (drampwafo > 0.0) {
 1877:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1878:       } else {
 1879:          rampwafo = 1.0;
 1880:       }
 1881: 
 1882:       // For source/sinks
 1883:       if (if_source && dramp_ss > 0.0) {
 1884:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1885:       } else {
 1886:          ramp_ss = 1.0;
 1887:       }
 1888: 
 1889:       if (dramp > 0.0) {
 1890:          ramp = tanh(2.0*time/86400.0/dramp);
 1891:       } else {
 1892:          ramp = 1.0;
 1893:       }
 1894: 
 1895: 
 1896:    }
