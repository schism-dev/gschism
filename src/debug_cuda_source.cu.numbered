 2319:    template<typename T>
 2320:    __device__ __forceinline__ T Element::mean(int level, T (Side::* field)[nvrt]) const {
 2321:       T values[4];
 2322:       getSideValues(level, field, values);
 2323: 
 2324:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2325:       if constexpr (IsVector2<T>::value && ics == 2) {
 2326: // XXXXX printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2327:          projectSideVectorsToElementFrame(values);
 2328: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2329:       }
 2330: 
 2331:       return (values[0] + values[1] + values[2] + values[3])/i34;
