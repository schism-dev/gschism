 6033: extern "C" {
 6034: 
 6035:    __global__ void scaleGravity(double loadtide_coef) {
 6036: 
 6037: 
 6038:       NODE(node);
 6039: 
 6040:       // SAL option: scale gravity
 6041:       if constexpr(iloadtide==2) {  // simple const
 6042:          node->grav2 = grav*(1.0 - loadtide_coef);
 6043: 
 6044:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6045:         
 6046:           const double depth = max(node->depth, 0.0);
 6047:           const double tmp1 = sqrt(depth);
 6048:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6049:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6050:                              2.6969e-13*depth*depth*depth*tmp1;
 6051:           
 6052:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6053:           
 6054: 
 6055: 
 6056:           node->grav2 = grav*(1.0 - beta_bar);
 6057: 
 6058:       } else {  // iloadtide=0,1
 6059:           node->grav2 = grav;
 6060: 
 6061:       }
 6062: 
 6063:    }
 6064: 
