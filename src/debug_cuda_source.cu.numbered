 8164: __global__ void returnMatrix(double *res) {
 8165:    // Debugging: returns the matrix as a CuPy array
 8166: 
 8167:    const int size = mesh->np;
 8168:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8169:       const Node *node = mesh->localNodeData + idx_node;
 8170:       res[idx_node*size + idx_node] = node->coeffDiag;
 8171:       for (int j = 0; j < node->numNodes; j++) {
 8172:          Node* nbNode = node->nodes[j];
 8173:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8174:       }
 8175: 
 8176:    }
 8177:    
 8178: }
