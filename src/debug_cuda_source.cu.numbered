 4337: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4338:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4339:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4340:                 int *isdel, int *isidenode, int *isbnd,
 4341:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4342:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4343:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4344:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4345:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4346:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4347:                 double *drag, double *roughness,
 4348:                 double *emo, double *efa, 
 4349:                 double *umo, double *ufa, 
 4350:                 double *vmo, double *vfa) {
 4351: 
 4352:    printf("Populating mesh for partition %d\n", partNum);
 4353: 
 4354:    // XXXXXX THIS function does almost nothing. 
 4355: 
 4356:    nbs = *sharedIdxSideBoundary + 1;
 4357:    nbp = *sharedIdxNodeBoundary + 1;
 4358: 
 4359:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4360: 
 4361: }
