 3495: // //                   is used below bottom or above surface.
 3496: // //       ibelow: flag indicating if zt is below za(k1)
 3497: // //
 3498: 
 3499: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 3500: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 3501:    
 3502: //    ibelow = 0;
 3503: 
 3504: //    if (zt < za[k1]) {
 3505: //       // Below bottom
 3506: //       ibelow = 1;
 3507: //       s_out = s_in[k1];
 3508: 
 3509: //    } else if(zt>=za[k2]) {
 3510: //       // Above surface
 3511: //       s_out = s_in[k2];
 3512: 
 3513: //    } else {
 3514: //       // Normal case (between bottom and surface)
 3515:       
 3516: //       // Finds the level index using binary search
 3517: //       int l1 = k1;
 3518: //       int l2 = k2;
 3519: //       int k = (l1 + l2)/2;
 3520: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 3521: //           int k = (l1 + l2)/2;
 3522: //           if (zt >= za[k]) l1 = k;
