 2799: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2800: 
 2801:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2802:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2803:    const Node *n1 = side->n1;
 2804:    const Node *n2 = side->n2;
 2805: 
 2806:    bool n1_match = (n1->nodeBnd->segment == segment);
 2807:    bool n2_match = (n2->nodeBnd->segment == segment);
 2808: 
 2809:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2810:    if (n1_match && n2_match) {
 2811:       return 0.5;
 2812:    } else if (n1_match) {
 2813:       return 1.0;
 2814:    } else if (n2_match) {
 2815:       return 0.0;
 2816:    }
 2817: 
 2818:    return 0.0;
 2819: }
 2820: 
 2821: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2822: 
 2823: 
 2824: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2825: 
 2826:    const double w1 = getBoundaryArrayValueWeight();
 2827:    const double w2 = 1.0 - w1;
 2828:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2829:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2830: 
 2831:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2832: }
 2833: 
 2834: 
 2835: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2836:    const double w1 = getBoundaryArrayValueWeight();
 2837:    const double w2 = 1.0 - w1;
 2838:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2839:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2840: 
 2841:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2842: 
 2843: }
 2844: 
 2845: 
 2846: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2847:    // Returns the value of the velocity at the side center
 2848:    const double w1 = getBoundaryArrayValueWeight();
 2849:    const double w2 = 1.0 - w1;
 2850:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2851:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2852: 
 2853:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2854: }
 2855: 
 2856: 
 2857: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2858:    // Returns the value of the normal component of the velocity at the side center
 2859:    const double w1 = getBoundaryArrayValueWeight();
 2860:    const double w2 = 1.0 - w1;
 2861:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2862:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2863: 
 2864:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2865: }
