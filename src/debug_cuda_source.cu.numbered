 1591:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1592:       // Compute the different time ramps used in the code 
 1593:       // This function is performed by just one thread
 1594: 
 1595:       if constexpr(ibc == 0) {
 1596:          if (drampbc > 0.0) {
 1597:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1598:          } else {
 1599:             rampbc = 1.0;
 1600:          }
 1601: 
 1602:          if (nws != 0 && drampwind > 0.0) {
 1603:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1604:          } else {
 1605:             rampwind = 1.0;
 1606:          }
 1607:       }
 1608: 
 1609:       if (drampwafo > 0.0) {
 1610:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1611:       } else {
 1612:          rampwafo = 1.0;
 1613:       }
 1614: 
 1615:       // For source/sinks
 1616:       if (if_source && dramp_ss > 0.0) {
 1617:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1618:       } else {
 1619:          ramp_ss = 1.0;
 1620:       }
 1621: 
 1622:       if (dramp > 0.0) {
 1623:          ramp = tanh(2.0*time/86400.0/dramp);
 1624:       } else {
 1625:          ramp = 1.0;
 1626:       }
 1627: 
 1628:    }
