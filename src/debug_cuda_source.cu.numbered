 2221:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2222: 
 2223:       assert(level < nvrt && "Level is out of range");
 2224: 
 2225:       // Get the values of the func at the nodes of the element
 2226:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2227:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2228:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2229:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2230:       else          res[3] = T();  // This is 0.0 or a zero vector
 2231: 
 2232:    }      
