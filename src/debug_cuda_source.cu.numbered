 9276: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9277:    SIDE(side);
 9278: 
 9279:    switch (varCode) {
 9280:       case (int)VarCode::outputCoords: {
 9281:          const Point2 coords = side->outputCoords();
 9282:          double *out = (double *)((char *)res + idx_side * 16);
 9283:          out[0] = coords.x;
 9284:          out[1] = coords.y;
 9285:          break;
 9286:       }
 9287:       case (int)VarCode::n1:
 9288:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9289:          break;
 9290:       case (int)VarCode::n2:
 9291:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9292:          break;
 9293:       case (int)VarCode::isdry:
 9294:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9295:          break;
 9296:    }
 9297: }
