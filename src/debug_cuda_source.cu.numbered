 1907: struct Mesh {
 1908:    public:  
 1909: 
 1910:    int partNum; // Partition number for this mesh.
 1911: 
 1912:    // Pointers to each GPU's local memory (size is the number of partitions).
 1913:    Node**    nodes;  
 1914:    Element** elems;  
 1915:    Side**    sides;  
 1916:    
 1917:    // Local memory
 1918:    Node*    localNodeData; 
 1919:    Element* localElemData;
 1920:    Side*    localSideData; 
 1921: 
 1922:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1923:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1924:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1925:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1926:    
 1927:    const int npgb;  // Global number of horizontal nodes
 1928:    const int negb;  // Global number of elements
 1929:    const int nsgb;  // Global number of sides
 1930: 
 1931:    const int np;   // Local number of horizontal nodes 
 1932:    const int ne;   // Local number of elements
 1933:    const int ns;   // Local number of sides
 1934: 
 1935:    int nbp;  // Local number of boundary nodes
 1936:    int nbs;  // Local number of boundary sides
 1937: 
 1938:    int nEntries;  // Total number of matrix elements
 1939: 
 1940:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1941:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1942:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1943: 
 1944:   
 1945:    // Additional topology information
 1946:    Node    **nodeNeighNodes;     // Array of pointers to the nodes neighbors of each node
 1947:    Element **nodeNeighElems;     // Array of pointers to the elements neighbors of each node
 1948:    int16_t *nodePermutationSort; // Array of indices for the array nodes such that neighbors nodes are sorted in increasing order of their global index.
 1949: 
 1950:    BoundarySegment *landBoundarySegment;
 1951:    NodeBoundary *landBoundaryNode;
 1952: 
 1953:    // Vertical coordinate system
 1954:    // Sigma levels
 1955:    double h_s; 
 1956:    double h_c; 
 1957: 
 1958:    double theta_b;
 1959:    double theta_f, sinh_theta_f;
 1960:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1961:    double *ztot;
 1962:    double *cs;
 1963:    double *dcs;
 1964: 
 1965: 
 1966: 
 1967:    __device__ Mesh(int partNum,
 1968:                    int npgb, int negb, int nsgb, 
 1969:                    int np, int ne, int ns,
 1970:                    int max_np, int max_ne, int max_ns, int nseg,
 1971:                    NodeBoundary *plandNodeBndMem, BoundarySegment *plandSegMem,
 1972:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1973:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1974:                    Node    **localNodeNeighNodesMem,
 1975:                    Element **localNodeNeighElemsMem,
 1976:                    int16_t *localNodePermutationSortMem,
 1977:                    double *partCoeffMatrixMem,
 1978:                    NodeBoundary *localNodeBoundaryMem,
 1979:                    SideBoundary *localSideBoundaryMem,
 1980:                    BoundarySegment *localSegmentMem,
 1981:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1982:                    double *cs, double *dcs
 1983:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1984:                        np(np), ne(ne), ns(ns),
 1985:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1986:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1987:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1988:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1989:                        nodePermutationSort(localNodePermutationSortMem), coeffMatrixMem(partCoeffMatrixMem),
 1990:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1991:                        localSegmentMem(localSegmentMem),
 1992:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1993:                        cs(cs), dcs(dcs),
 1994:                        landBoundarySegment(plandSegMem),
 1995:                        landBoundaryNode(plandNodeBndMem)
 1996:    {
 1997:       printf("Mesh constructor for partition %d\n", partNum);
 1998: 
 1999:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 2000:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 2001:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 2002:  
 2003:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 2004:       
 2005:       sinh_theta_f = sinh(theta_f);
 2006: 
 2007:       *landBoundaryNode    = NodeBoundary(true);
 2008:       *landBoundarySegment = BoundarySegment(true);   
 2009: 
 2010:    }
