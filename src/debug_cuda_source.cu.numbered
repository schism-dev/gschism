 7542: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7543:    Node *nodes = mesh->localNodeData;
 7544: 
 7545:    *addr = nodes;
 7546:    *sizeNode = sizeof(Node);
 7547: 
 7548:    switch (varCode) {
 7549:       case (int)VarCode::depth:
 7550:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7551:          *sizeType = sizeof(double);
 7552:          break;
 7553:       case (int)VarCode::eta:
 7554:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7555:          *sizeType = sizeof(double);
 7556:          break;
 7557:       case (int)VarCode::x:
 7558:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7559:          *sizeType = sizeof(Vector2);
 7560:          break;
 7561:       case (int)VarCode::z:
 7562:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7563:          *sizeType = sizeof(double);
 7564:          break;
 7565:       case (int)VarCode::kb:
 7566:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7567:          *sizeType = sizeof(int);
 7568:          break;
 7569:       case (int)VarCode::isdry:
 7570:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7571:          *sizeType = sizeof(int);
 7572:          break;         
 7573:       case (int)VarCode::w:
 7574:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7575:          *sizeType = sizeof(double);
 7576:          break;
 7577:       case (int)VarCode::u:
 7578:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7579:          *sizeType = sizeof(Vector2);
 7580:          break;         
 7581:       default:
 7582:          *offset = -1;    
 7583:    }  
 7584:    
 7585: }
