 6526: __global__ void printMatrix(void) {
 6527: 
 6528: 
 6529:    // Let only one thread per block print at a time 
 6530: 
 6531:    if (threadIdx.x == 0) {
 6532:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 6533:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 6534:          if (idx_node >= mesh->np) return;
 6535:          const Node *node = mesh->localNodeData + idx_node;
 6536:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 6537:          for (int j = 0; j < node->numNodes; j++) {
 6538:             Node* nbNode = node->nodes[j];
 6539:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 6540:          }
 6541:          printf("]\n");
 6542: 
 6543:       }
 6544:    }
 6545: 
 6546: 
 6547: 
 6548: }
