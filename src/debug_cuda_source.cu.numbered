 8669: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8670:    Node *nodes = mesh->localNodeData;
 8671: 
 8672:    *addr = nodes;
 8673:    *sizeNode = sizeof(Node);
 8674: 
 8675:    switch (varCode) {
 8676:       case (int)VarCode::depth:
 8677:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8678:          *sizeType = sizeof(double);
 8679:          break;
 8680:       case (int)VarCode::eta:
 8681:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8682:          *sizeType = sizeof(double);
 8683:          break;
 8684:       case (int)VarCode::x:
 8685:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8686:          *sizeType = sizeof(Vector2);
 8687:          break;
 8688:       case (int)VarCode::z:
 8689:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8690:          *sizeType = sizeof(double);
 8691:          break;
 8692:       case (int)VarCode::kb:
 8693:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8694:          *sizeType = sizeof(int);
 8695:          break;
 8696:       case (int)VarCode::isdry:
 8697:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8698:          *sizeType = sizeof(int);
 8699:          break;         
 8700:       case (int)VarCode::w:
 8701:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8702:          *sizeType = sizeof(double);
 8703:          break;
 8704:       case (int)VarCode::u:
 8705:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8706:          *sizeType = sizeof(Vector2);
 8707:          break;  
 8708:       case (int)VarCode::u_air:
 8709:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8710:          *sizeType = sizeof(Vector2);
 8711:          break;
 8712:       default:
 8713:          *offset = -1;    
 8714:    }  
 8715:    
 8716: }
 8717: 
 8718: 
 8719: 
 8720: 
 8721: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8722:    // Get the value of a variable from an side
 8723:    // varName is the name of the variable to get
 8724:    // var is the array to store the value
 8725:    // k is the vertical level index of the variable to get
 8726:    SIDE_BND(sideBnd);   
 8727: 
 8728:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8729:    if (sideBnd->segment->isLand) idx = -7;
 8730: 
 8731:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8732:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8733: 
 8734: }
