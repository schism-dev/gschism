 1729: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1730:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1731: }
