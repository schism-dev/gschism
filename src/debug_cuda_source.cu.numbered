 2548: /**
 2549:  * This method performs backtracking from the side center until a time -dt back in time 
 2550:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2551:  * intermediate point.
 2552:  *
 2553:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2554:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2555:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2556:  * remaining time.
 2557:  * 
 2558:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2559:  * 
 2560:  * @param uuint, vvint, wwint: Velocities at the final point
 2561:  * @param jlev: Level at which the backtracking is performed
 2562:  * @param dt, dtbk: Tracking timesteps
 2563:  * @return: True if the backtracking was successful, false otherwise
 2564:  */
 2565: __inline__ __device__ bool Side::btrack(
 2566:       int jlev,
 2567:       double dt,            // Tracking time
 2568:       double dtbk,          // Tracking timestep
 2569:       Vector3 &u_int        // Velocities at the initial point
 2570: ) const {
 2571: 
 2572:    // Start from side center
 2573:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2574: double dt0 = dt; // XXXXX
 2575: Point3 x00 = x0;
 2576: const int oriJlev = jlev;
 2577:  
 2578:    double time_rm = dt; // Remaining time
 2579: 
 2580: 
 2581: 
 2582: 
 2583:    // Initial velocities
 2584:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2585: 
 2586:    // Find the element that is in the direction opposite to the velocity
 2587:    Element* curElem = findElementTowards(toVector2(u_int));
 2588: 
 2589: 
 2590:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2591:    if (curElem == nullptr) {
 2592:       // Make velocity parallel to the side
 2593:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2594:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2595:       curElem = otherElem(curElem);
 2596: 
 2597:    }
 2598: 
 2599:    if (curElem == nullptr || curElem->isDry) { 
 2600:       // This means that the starting side is shared by dry elements (or one dry and one boundary side).
 2601:       u_int = {0.0, 0.0, 0.0}; 
 2602:       return true;
 2603:    }
 2604: 
 2605:    // Nudges it towards the barycenter
 2606:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2607: 
 2608: 
 2609:    const int MAX_ITERATIONS = 1000; 
 2610:    Element* nextElem = nullptr;
 2611:    int iter = 0;
 2612: assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2613:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2614:    while(true) {
 2615: 
 2616:       // Calculate timestep
 2617:       double dtb = min(dtbk, time_rm);
 2618: 
 2619:       // Next point in the backtracking curve
 2620:       xt = x0 - dtb*u_int;
 2621: 
 2622:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2623:       assert(found && "Backtracking failed in btrack");
 2624: 
 2625: 
 2626:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2627:                       // then time_rm needs to be increased by the unused time.
 2628: 
 2629:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2630: 
 2631:       // If the velocity is too small, we stop the backtracking
 2632:       const double vmag = length(toVector2(u_int));
 2633:       if (vmag <= velmin_btrack) break;
 2634: 
 2635:       // The current point becomes the next segment's starting point.
 2636:       x0 = xt;
 2637:  
 2638:       curElem = nextElem;
 2639: 
 2640:       iter++;
 2641: 
 2642:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2643:    }
 2644: 
 2645:    // Interpolate the velocities at the final point
 2646:    curElem->interpolateVelocities(xt, u_int);
 2647: 
 2648: 
 2649: }
 2650: 
 2651: 
