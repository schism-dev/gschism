 4539:    __global__ void computeFlowBcVelocities(double time) {
 4540: 
 4541:       SIDE_BND(sideBnd);
 4542: 
 4543:       const Side *side = sideBnd->side;
 4544:  
 4545:       const bool isDry = side->isDry;
 4546:       const bool isLand = sideBnd->segment->isLand;
 4547: 
 4548:    
 4549:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4550: 
 4551:       if (isDry || isLand) return;
 4552: 
 4553:       // For wet sides in open boundaries...
 4554:       const Vector2 n = side->n;
 4555:       const BoundarySegment *segment = sideBnd->segment;
 4556: 
 4557:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4558: 
 4559:       const int ifltype = segment->ifltype;
 4560: 
 4561:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4562:       const Vector2 r_nuth0 = r_uth0*n;
 4563: 
 4564: 
 4565:       if (ifltype == 1 || ifltype == 2) {
 4566:       
 4567:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4568: 
 4569:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4570:          
 4571:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4572:          
 4573:       } else if (ifltype == -1) { // Flather 1
 4574: 
 4575:          for (int k = 0; k < nvrt; k++) {
 4576: 
 4577:             // uth is the normal vel.; no ramp up
 4578:             const double uth = sideBnd->nuth(k);
 4579:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4580: 
 4581:             sideBnd->ubc[k] += uth*n;
 4582:          }
 4583: 
 4584:       } else if (ifltype == 3 || ifltype == 5) {
 4585:          // vnth0=0 !normal vel.
 4586: 
 4587:          Vector2 r_u1_bar = {0.0, 0.0};
 4588:          // Computes the contribution to the velocity from all tide frequencies
 4589:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4590: 
 4591:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4592:             const Vector2 umo  = sideBnd->umo(jfr); 
 4593: 
 4594:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4595:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4596:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4597:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4598:          }
 4599: 
 4600: 
 4601:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4602: 
 4603:       } // if (ifltype = 3 || ifltype == 5
 4604: 
 4605: 
 4606: 
 4607:    }
 4608: 
 4609:    __global__ void computeElevationBoundaryConditions(double time) {
 4610:       // Compute elevation essential boundary conditions 
 4611: 
 4612:       NODE_BND(nodeBnd); // Each boundary node.
 4613: 
 4614:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4615: 
 4616:       const Node *node = nodeBnd->node;
 4617:       const BoundarySegment *segment = nodeBnd->segment;
 4618:       const int iettype = segment->iettype;
 4619:       
 4620: 
 4621:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4622:       double eic = 0.0;
 4623:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4624:       else                 eic = 0.0;
 4625: 
 4626:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4627:       const double r_eth = ramp*nodeBnd->eth;
 4628:       double r_eta1_bar = 0.0;
 4629: 
 4630: 
 4631:       // Compute tide elevation
 4632:       if (iettype == 3 || iettype == 5) {   
 4633: 
 4634:          if constexpr(iloadtide==1) { // loading tide
 4635:             assert(false && "Loading tide not implemented");
 4636:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4637:          }
 4638:          
 4639:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4640: 
 4641:             const double efa  = nodeBnd->efa[jfr]; 
 4642:             const double emo  = nodeBnd->emo[jfr]; 
 4643: 
 4644:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4645:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4646:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4647: 
 4648:          } // for jfr
 4649: 
 4650:       } // if iettype
 4651: 
 4652:       switch (iettype) {
 4653:          case 1:
 4654:          case 2:
 4655:          case 4:
 4656:             nodeBnd->elbc = r_eic + r_eth;
 4657:             break;
 4658:          case 3:
 4659:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4660:             break;
 4661:          case 5:
 4662:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4663:             break;
 4664:       } // switch
 4665: 
 4666: 
 4667:       //Add inverse barometric effects
 4668:       if (iettype != 0 && inv_atm_bnd == 1) {
 4669:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4670:       }
 4671: 
 4672:    }
 4673: 
 4674: 
 4675:    __global__ void computeHorizontalViscosity(void) { 
 4676: 
 4677:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4678: 
 4679:       SIDE(side);
 4680: 
 4681:       if (side->isDry) return;
 4682: 
 4683:       for (int k = 0; k < nvrt; k++) {
 4684:          side->nuGradU[k] = {0.0, 0.0};
 4685:       }
 4686: 
 4687:       if constexpr(ihorcon == 1) {
 4688:          for (int k = side->kb; k < nvrt - 1; k++) {
 4689:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4690:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4691:             // By Zhang and Baptista.
 4692: 
 4693:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4694:             // This is a standard discretization of the Laplacian operator.
 4695:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4696:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4697:             // Gamma is hvis_coef0 in the code.
 4698:             // The value of gamma needs to be < 0.5.
 4699: 
 4700:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4701:             // side under consideration in each of the two possible elements that share the side.
 4702:             Vector2 sumU = {0.0, 0.0};
 4703:             for (int l = 0; l < 2; l++) {
 4704:                const Element *elem = side->elems[l];
 4705: 
 4706:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4707: 
 4708:                // Find the local index of the side in the element
 4709:                const int idxSide = elem->sideLocalIdx(side);
 4710:                // Find the two sides that are connected to the side under consideration
 4711:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4712:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4713: 
 4714:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4715: 
 4716:             }
 4717: 
 4718:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4719:    
 4720:          }
 4721:       }
 4722:       else if constexpr(ihorcon == 2) {
 4723:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4724:       }
 4725: 
 4726: 
 4727:    }
 4728: 
 4729: 
 4730:    __global__ void setEssentialBC(void) {
 4731:       // Set essential boundary conditions 
 4732:       NODE(node); // Each boundary node
 4733:       NodeBoundary *nodeBnd = node->nodeBnd;
 4734:       
 4735: // nodeBnd->isEssentialBC = true;      
 4736:       // Check if this node has essential BC
 4737:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4738:          // Verify BC value is valid
 4739:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4740: 
 4741:        
 4742:          // Set diagonal to 1 and zero off-diagonals
 4743:          node->coeffDiag = 1.0;
 4744: 
 4745:          for (int j = 0; j < node->numNodes; j++) {
 4746:                node->coeffMatrix[j] = 0.0;
 4747:          }
 4748:          
 4749:          // Set solution and RHS to BC value
 4750:          node->mX  = nodeBnd->elbc;
 4751:          node->qel = nodeBnd->elbc;
 4752: 
 4753:       } else {
 4754:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4755: 
 4756:          for (int j = 0; j < node->numNodes; j++) {
 4757:                Node* nbNode = node->nodes[j];
 4758:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4759:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4760:                   // Verify neighbor's BC value
 4761:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4762: 
 4763:                   // Subtract contribution to RHS
 4764:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4765:                   node->coeffMatrix[j] = 0.0;  
 4766:                }
 4767:          }
 4768:       }
 4769:    }
 4770: 
 4771: 
 4772:    __global__ void updateElevation(void) {
 4773:       NODE(node);
 4774: 
 4775:       node->eta2 = node->mX;
 4776: 
 4777:       node->updateZCoordData();
 4778:    }
