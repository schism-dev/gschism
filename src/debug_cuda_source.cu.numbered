 2199: 
 2200: /**
 2201:    Compute the shape coordinates of the point (xt,yt) in the element.
 2202:    @param xt (input): x-coordinate of the point
 2203:    @param shpCoords (output): shape coordinates of the point
 2204:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2205:    @return true if the point is inside the element, false otherwise
 2206: **/
 2207: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2208:                                             bool fixNegshpCoord) const {
 2209: 
 2210:    // Compute the shape coordinates of the point xt in the element.
 2211:    if (i34==3) {
 2212:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2213:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2214:       // and in this case, the pt will be nudged into the element
 2215:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2216:       // from the local frame, so use additional check.
 2217: 
 2218:       Point2 x0, x1, x2;
 2219: 
 2220:       if constexpr(ics==1) {
 2221:          x0 = nodes[0]->p;
 2222:          x1 = nodes[1]->p;
 2223:          x2 = nodes[2]->p;
 2224:       }
 2225:       else // lat/lon
 2226:       {
 2227:          Error("Not implemented yet");
 2228:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2229:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2230:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2231:       }
 2232: 
 2233:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2234:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2235:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2236:       shpCoords[3] = 0.0;
 2237: 
 2238:       const double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2239:       const bool res = (tmpmin >= -small);     
 2240: 
 2241:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2242:       // then we fix the negative shape coordinates.
 2243:       if ((tmpmin < 1.0e-4) && fixNegshpCoord) {
 2244: 
 2245:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2246:          // keeping the sum of the shape coordinates equal to 1.
 2247:          // I have tested and compared the new algorithm with the old one, and they give
 2248:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2249:          // The new algorithm should be faster since it is branchless.
 2250:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2251:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2252:          
 2253:          shpCoords[0] = (shpCoords[0] + a)*b;
 2254:          shpCoords[1] = (shpCoords[1] + a)*b;
 2255:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2256: 
 2257:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2258:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2259:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2260:          }
 2261: 
 2262:          // Update the point coordinates for the new shape coordinates
 2263:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2264:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2265:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2266: 
 2267:       }
 2268: 
 2269:       // Check if the point is inside the element
 2270:       return res;      
 2271:    }
 2272:    else {
 2273:       Error("Not implemented yet");
 2274: #ifdef QUADS
 2275:       // Reproject pt in eframe of nel for ics=2
 2276:       if constexpr(ics==1) {
 2277:          xn2 = xt; 
 2278:          yn2 = yt;
 2279:       }
 2280:       else {
 2281:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2282:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2283:       }
 2284: 
 2285:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2286: #endif
 2287:    }
 2288: 
 2289:    assert(false && "computeShapeCoords: should never reach this point");
 2290:    return false;  // Never reached
 2291: 
 2292: }
 2293: 
 2294: 
 2295: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2296: // Convert shape coordinates to cartesian coordinates
 2297: 
 2298:    if (i34 == 3) {
 2299:       // Triangular element
 2300:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2301:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2302:    }
 2303:    else {
 2304:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2305:    }
 2306: 
 2307: }
 2308: 
 2309: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2310:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2311:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2312:    // The formula for the integral is:
 2313:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2314: 
 2315:    printf("intPhiPhi: TEST\n");
 2316: 
 2317:    const Node *n0 = nodes[0];
 2318:    const Node *n1 = nodes[1];
 2319:    const Node *n2 = nodes[2];
 2320:    const Node *n3 = nodes[3];
 2321: 
 2322:    const Vector2 p0 = n0->p;
 2323:    const Vector2 p1 = n1->p;
 2324:    const Vector2 p2 = n2->p;
 2325:    const Vector2 p3 = n3->p;
 2326: 
 2327:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2328:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2329:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2330:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2331: 
 2332:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2333: }
 2334:    
 2335: 
 2336: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2337:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2338:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2339:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2340:    // The formula is also based on the identity:
 2341:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2342:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2343: 
 2344:    printf("intGradPhiGradPhi: TEST\n");   
 2345: 
 2346:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2347: 
 2348:    const double x0 = nodes[0]->p.x;
 2349:    const double y0 = nodes[0]->p.y;
 2350:    const double x1 = nodes[1]->p.x;
 2351:    const double y1 = nodes[1]->p.y;
 2352:    const double x2 = nodes[2]->p.x;
 2353:    const double y2 = nodes[2]->p.y;
 2354:    const double x3 = nodes[3]->p.x;
 2355:    const double y3 = nodes[3]->p.y;
 2356: 
 2357:    double res = 0.0;
 2358:    
 2359:    // Quadrature points in xi and eta coordinates
 2360:    #pragma unroll
 2361:    for (int i = 0; i < 4; i++) {
 2362:       // For each quadrature point...
 2363: 
 2364:       const Point2 p = GaussPoint(i);
 2365:       const double eta = p.x;
 2366:       const double xi  = p.y;
 2367: 
 2368:       // Jacobian entries at the Gauss point p
 2369:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2370:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2371:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2372:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2373: 
 2374:       const double detJ = jacobianDet(p);
 2375:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2376: 
 2377:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2378:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2379:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2380:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2381:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2382: 
 2383:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2384:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2385:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2386:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2387:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2388: 
 2389:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2390:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2391:    }
 2392: 
 2393:    return res;
 2394: }
 2395: 
 2396: 
 2397: /**  Interpolate velocities at a given point (xt,yt,zt)
 2398: 
 2399:    @param xt, yt, zt: coordinates of the point to interpolate
 2400:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2401: 
 2402:    This is done in four steps:
 2403: 
 2404:    1. Find the shape coordinates for the final position in the element.
 2405:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2406:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2407:       z levels at xt, yt at each step.   
 2408:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2409:       horizontally and vertically.
 2410: **/
 2411: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2412:    // Interpolate the velocities at the point xt. 
 2413:    // This function works the same for triangular and quadrilateral elements.
 2414:    double shpCoord[4];
 2415: 
 2416:    // First step is to compute the shape coordinates of (xt,yt)
 2417:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2418: 
 2419:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2420: 
 2421:    // Second step is to find the level that contains zt
 2422:    // Uses a binary search to find the level
 2423:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2424:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2425:    int R = nvrt - 1;
 2426: 
 2427:    // Get the z coordinates at the nodes of the element at the levels L and R
 2428:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2429:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2430:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2431: 
 2432:    double zL = interpolate(shpCoord, zLAtNodes);
 2433:    double zR = interpolate(shpCoord, zRAtNodes);
 2434:    
 2435:    // Interpolates vertically the velocities
 2436:    double wght1, wght2;
 2437:    if (xt.z<=zL) {
 2438:       wght1 = 1.0;
 2439:       wght2 = 0.0;
 2440:       xt.z = zL;
 2441:    }
 2442:    else if (xt.z>=zR) {
 2443:       wght1 = 0.0;
 2444:       wght2 = 1.0;
 2445:       xt.z = zR;
 2446:    }
 2447:    else {
 2448:       // Perform a binary search to find the levels between L and R that contain xt.z
 2449:       while (R - L > 1) {
 2450:          int M = (L + R) / 2.0;
 2451: 
 2452:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2453:          double zM = interpolate(shpCoord, zMAtNodes);
 2454:          if (zM < xt.z) 
 2455:          {
 2456:             L = M;
 2457:             zL = zM;
 2458:          }
 2459:          else 
 2460:          {
 2461:             R = M;
 2462:             zR = zM;
 2463:          }
 2464:       }
 2465:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2466:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2467: 
 2468:       wght2 = (xt.z - zL)/(zR - zL);
 2469:       wght1 = 1.0 - wght2;
 2470: 
 2471:    }
 2472: 
 2473: // Debug print for specific point
 2474: if (fabs(xt.x - 9394.376) <= 40.0 &&
 2475:     fabs(xt.y - 3998.7960) <= 4.0 &&
 2476:     fabs(xt.z - ( -0.20766)) <= 0.01) {
 2477:    // double z2AtNodes[4], z3AtNodes[4], z10AtNodes[4];
 2478:    // getNodalValues(2, &Node::compZCoord, z2AtNodes);
 2479:    // getNodalValues(3, &Node::compZCoord, z3AtNodes);
 2480:    // getNodalValues(10, &Node::compZCoord, z10AtNodes);
 2481:    // double z2 = interpolate(shpCoord, z2AtNodes);
 2482:    // double z3 = interpolate(shpCoord, z3AtNodes);
 2483:    // double z10 = interpolate(shpCoord, z10AtNodes);
 2484:    Vector2 u0atNodes[4], u1atNodes[4];
 2485:    getNodalValues(0, &Node::u2, u0atNodes);
 2486:    getNodalValues(1, &Node::u2, u1atNodes);
 2487:    auto u0 = interpolate(L, shpCoord, &Node::uvw2);
 2488:    auto u1 = interpolate(R, shpCoord, &Node::uvw2);
 2489:    auto uint = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2490:    printf("DEBUG: elem-idx = %d, L=%d, R=%d, wght1=%.17g, \nxt=(%.17g, %.17g, %.17g), zL=%.17g, zR=%.17g, u0 = %.17g, u1 = %.17g, \nzLAtNodes = %.17g, %.17g, %.17g\nzMAtNodes = %.17g, %.17g, %.17g\nzRAtNodes = %.17g, %.17g, %.17g, \nshpCoord = %.17g, %.17g, %.17g\nu0atNodes = %.17g, %.17g, %.17g\nu1atNodes = %.17g, %.17g, %.17g\nuint = %.17g, %.17g, %.17g\n", 
 2491:          idx, L, R, wght1, xt.x, xt.y, xt.z, zL, zR,  u0.x, u1.x, zLAtNodes[0], zLAtNodes[1], zLAtNodes[2], zMAtNodes[0], zMAtNodes[1], zMAtNodes[2], zRAtNodes[0], zRAtNodes[1], zRAtNodes[2], shpCoord[0], shpCoord[1], shpCoord[2], 
 2492:          u0atNodes[0].x, u0atNodes[1].x, u0atNodes[2].x, 
 2493:          u1atNodes[0].x, u1atNodes[1].x, u1atNodes[2].x,
 2494: 
 2495:          uint.x, uint.y, uint.z);
 2496: }
 2497: 
 2498:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2499:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2500: 
 2501:    // Neither of the interpolated velocities should be NaN
 2502:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2503: 
 2504: }
