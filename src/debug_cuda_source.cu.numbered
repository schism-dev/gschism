 5883:    __global__ void computeBottomDragVegetation(void) {
 5884:       // UNFINISHED. CHECK THIS:
 5885:       // How many kernels are needed? Why so many for loops?
 5886:       // Is the loop on sides needed?
 5887: 
 5888:       NODE(node);
 5889: 
 5890: 
 5891:       const int    kb      = node->kb;
 5892:       const double htot    = node->htot2(); 
 5893:       
 5894:       if (node->isDry) {
 5895:          // Default values for dry nodes
 5896:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5897:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5898: 
 5899:          return;
 5900:        
 5901:       }
 5902: 
 5903:       // Computes bottom drag Cd based on the selected nchi
 5904:       node->computeBottomDragCd();
 5905:       
 5906: 
 5907: 
 5908:       //   Bottom stress in m^2/s^2
 5909:       if (node->rho[kb + 1] >= -98.0)
 5910:       {
 5911:          const double mag_u = length(node->u2[kb + 1]);
 5912:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5913: 
 5914:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5915:          // !sediment erosion: this part needs more documentation
 5916:       }
 5917:     
 5918: 
 5919: 
 5920:       // Compute vegetation parameters
 5921:       //--------------------------------
 5922: 
 5923:       // SAV constants
 5924:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5925:       constexpr double veg_cfpsi = 0.16;
 5926: 
 5927:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5928:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5929: 
 5930:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5931:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5932:          int kbin = 0; // bin index
 5933:          for (int k = kb; k < nvrt; k++) {
 5934:             // Computes node height above the bottom level
 5935:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5936:             assert(false && "Vertical variation of vegetation not implemented");
 5937: 
 5938:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5939:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5940:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5941:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5942:             // } else {
 5943:             //    // Find the bin at which the current vertical level is
 5944:             //    while (kbin<nbins_veg_vert) {
 5945:             //       const double zn = node->z[kbin];
 5946:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5947:             //          break;
 5948:             //       } // if
 5949:             //       kbin++;
 5950:             //    } // while
 5951:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5952: 
 5953:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5954:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5955:                
 5956:             //    // Linear interpolation of the vegetation parameters
 5957:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5958:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5959:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5960:             // } // if rl10
 5961: 
 5962:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5963: 
 5964:          } // for k
 5965: 
 5966: 
 5967:       } else { // Ganthy (iveg==2)
 5968:       //  Modify canopy height, diameter, and density
 5969: 
 5970:          // Make sure there is vegetation on this node
 5971:          if (node->veg_h_unbent > 0.0) {
 5972:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5973: 
 5974:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5975:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5976:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5977: 
 5978:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5979:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5980:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5981:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5982:          } // if veg_h_unbent
 5983: 
 5984:          for (int k = 0; k < nvrt; k++) {
 5985:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5986:          } // for k
 5987:       
 5988: 
 5989:       } // if iveg
 5990:      
 5991: 
 5992:       // Compute vertical mean of veg_alpha3D
 5993:       if (iveg != 0) {
 5994:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5995:          double sum1=0.0;
 5996:          double sum2=0.0;
 5997:          // Integrate over each level under the canopy...
 5998:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5999:             const double Dz = node->Dz(k);
 6000: 
 6001:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6002:             sum2 += Dz;
 6003: 
 6004:          } // for k
 6005:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6006:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6007: 
 6008:       } // if iveg
 6009: 
 6010:    }
 6011: 
 6012:    __global__ void computeVegetationAndDragParameters(void) {
 6013:       // Computes the vegetation and drag model parameters:
 6014:       // chi, \tilde\chi, beta, \breve{H}
 6015:       
 6016:       SIDE(side);
 6017: 
 6018:       side->hhat = 0.0;
 6019:       side->chi2 = 0.0;
 6020:       side->chi = 0.0;
 6021:       side->veg_c2 = 0.0;
 6022:       side->veg_beta = 0.0;
 6023: 
 6024:       if (side->isDry) return;
 6025: 
 6026:       const double htot = side->htot2();
 6027:       const int    kb   = side->kb;
 6028: 
 6029:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6030: 
 6031:       const double veg_h     = side->veg_h();
 6032:       const double veg_nv    = side->veg_nv();
 6033:       const double veg_c     = side->veg_c();
 6034:       const double veg_beta  = side->veg_beta;
 6035:       const double veg_alpha = side->veg_alpha_vert_mean();
 6036: 
 6037:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6038:       // Velocity magnitude at the bottom level
 6039:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6040:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6041:       side->chi2 = side->Cd()*vmag1;
 6042:       side->chi  = side->chi2;
 6043: 
 6044:       if constexpr(iveg != 0) {
 6045:          const Node *n1 = side->n1;
 6046:          const Node *n2 = side->n2;
 6047:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6048:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6049:       }
 6050: 
 6051:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6052: 
 6053:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6054:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6055:       double magUa = 0.0;
 6056:       if constexpr(iveg != 0) {
 6057:          if (side->is3D() && veg_h > 0.0) {
 6058:             // 3D wet side with veg...
 6059: 
 6060:             double magUa = 0.0;
 6061:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6062:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6063: 
 6064:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6065:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6066:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6067: 
 6068:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6069:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6070: 
 6071:                   // Velocity magnitude at the bottom (l) of the level
 6072:                   const double ul = length(side->u2[k]);
 6073: 
 6074:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6075:                   magUa += Dz*0.5*(uh + ul);
 6076: 
 6077:                } // if HasVegetation
 6078:             } // for k
 6079:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6080: 
 6081:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6082:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6083:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6084:                const double zCpy = side->zTopCanopy();
 6085:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6086:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6087:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6088:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6089:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6090:             } // if isSubmerged
 6091:          } // if is3D
 6092:       } // if iveg   
 6093: 
 6094:       // Computes the friction modified depth, \breve{H} in notes
 6095:       if (side->is2D()) { // 2D
 6096: 
 6097:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6098:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6099: 
 6100:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6101: 
 6102:          side->hhat = htot*htot/fricH; 
 6103: 
 6104:       } else { // 3D
 6105:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6106: 
 6107:          if constexpr(iveg != 0) {
 6108:             
 6109:             if (side->isSubmerged()) { 
 6110:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6111:                side->hhat -= veg_c*Hhat_alpha;
 6112: 
 6113:             } else { // Emergent
 6114:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6115:             }
 6116:          } // if iveg
 6117: 
 6118:          // Enforce positivity for 3D model
 6119:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6120:       } // if 3D
 6121: 
 6122:    }
 6123: 
 6124: 
 6125: 
 6126:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6127:    // Computes the density gradient between two elements, e1 and e2.
 6128:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6129:    // zero in the direction normal to the side. 
 6130:    // 
 6131:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6132:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6133:    //
 6134:    // Input:
 6135:    //    e1: Element
 6136:    //    e2: Neighbor element (or nullptr if boundary)
 6137:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6138:    //    k: Index of the half-level at which the density is interpolated
 6139:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6140:    // 
 6141:    // Output:
 6142:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6143:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6144: 
 6145:       if (e2 == nullptr || e2->isDry) {
 6146:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6147: 
 6148:          Side *side = e1->sides[j];
 6149:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6150:                  
 6151:          if constexpr(ics == 1) {
 6152:             vec = side->n; // Normal vector to the side
 6153:          } else {
 6154:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6155:             // IMPLEMENT THIS XXXXXX
 6156:             // !replace with xel, yel?
 6157:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6158:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6159:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6160:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6161:          } //ics
 6162:                    
 6163:          diffRho = 0.0;
 6164: 
 6165:       } else { //internal and wet
 6166:          if constexpr(ics==1) {
 6167:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6168: 
 6169:             // Vector from e1 to e2
 6170:             vec = e2->center - e1->center;
 6171: 
 6172:          } else { 
 6173:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6174:             // Remember that elem->center is in global coordinates
 6175:             // IMPLEMENT THIS XXXXXX
 6176:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6177:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6178:             //                   alow(j)=xctr2
 6179:             //                   bdia(j)=yctr2
 6180:          } // ics
 6181: 
 6182:          diffRho = rho2 - e1->demeanedDensity(k);
 6183:       }
 6184: 
 6185:    }
 6186: 
 6187:    __global__ void computeDensityCubicSplines(void) {
 6188:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6189: 
 6190:       ELEM(elem);
 6191: 
 6192:       if (elem->isDry) return;
 6193: 
 6194:       const int kb = elem->kb;
 6195: 
 6196:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6197:       if (elem->is2D()) {
 6198:          // In the 2D case, the density is constant at the prism level. 
 6199:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6200:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6201:       } else { //3D
 6202: 
 6203:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6204:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6205:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6206:          ///// XXXX CHECK INDICES!!!!!
 6207:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6208:       } // 2D/3D
 6209: 
 6210:    }
 6211: } // extern "C"
 6212: 
 6213: 
 6214: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6215: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6216: 
 6217:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6218: 
 6219:    const int kb  = elem->kb;
 6220:    const int kb2 = elem2->kb;
 6221: 
 6222:    // z-coordinate of prism of elem
 6223:    const double zp = elem->z_prism(k);
 6224: 
 6225:    double rho = 0.0;
 6226: 
 6227:    if (elem2->is2D()) {
 6228:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6229: 
 6230:    } else {  // 3D
 6231: 
 6232:       // eta_min may be < zmax
 6233:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6234:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6235: 
 6236:       // (Extrapolate density below bottom, we will fix it later)
 6237:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6238:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6239:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6240:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6241:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6242:    } // 2D/3D
 6243:      
 6244: 
 6245:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6246:    // Now we need to fix it.
 6247:    if (elem->z[k] < elem2->z[kb2]) {
 6248:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6249: 
 6250:       // There are two methods to adjust the density at the bottom of the element.
 6251:       // iunder_deep=0: 
 6252:       const double depth1 = abs(elem->z[kb]); // larger depth
 6253: 
 6254:       if (iunder_deep==0) {
 6255: 
 6256:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6257: 
 6258:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6259: 
 6260:       } else { // iunder_deep != 0
 6261: 
 6262:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6263: 
 6264:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6265: 
 6266:          //   Demeaned density at the same z coordinate as
 6267:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6268:          }
 6269: 
 6270:       } // if iunder_deep
 6271:    } // if elem->z[kb] < elem2->z[kb]
 6272: 
 6273:    return rho;
 6274: }
 6275: 
 6276: 
 6277: extern "C" {
 6278:    __global__ void computeDensityGradient(void) {
 6279: 
 6280:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6281:       if constexpr(ibc != 0) return;
 6282: 
 6283:          // Compute the horizontal density gradient at each element.
 6284:       // It works in two steps:
 6285:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6286:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6287:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6288:       //             gradRho.r1 = rho1 - rho0
 6289:       //             gradRho.r2 = rho2 - rho0
 6290:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6291:       // 
 6292:       //  NOTE: We use de-meaned densities.
 6293: 
 6294:       ELEM(elem);
 6295: 
 6296:       if (elem->isDry) return;
 6297: 
 6298:       const int kb  = elem->kb;
 6299:       const int i34 = elem->i34;
 6300: 
 6301:       for (int k = kb + 1; k < nvrt; k++) {
 6302:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6303:          //             gradRho.r1 = rho1 - rho0
 6304:          //             gradRho.r2 = rho2 - rho0
 6305:          int icount = 0;
 6306:          double sumRx = 0.0;
 6307:          double sumRy = 0.0;
 6308:          for (int j1=0; j1<i34; j1++) { 
 6309: 
 6310:             const int j2 = elem->nxq(j1 + 1);
 6311: 
 6312:             // Pairs of consecutive neighbor elements of elem
 6313:             const Element *e1 = elem->nghbElems[j1];
 6314:             const Element *e2 = elem->nghbElems[j2];
 6315: 
 6316:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6317:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6318:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6319: 
 6320:             // Compute the density difference and the vector from elem to e1 and e2
 6321:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6322:             double diffRho1, diffRho2;
 6323:             Vector2 vec1, vec2;
 6324:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6325:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6326: 
 6327:             const double rl1 = length(vec1);
 6328:             const double rl2 = length(vec2);
 6329:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6330: 
 6331:             const double delta = cross(vec1, vec2);
 6332:             const double sintheta = abs(delta)/(rl1*rl2);
 6333: 
 6334:             // To avoid problems, avoid elements with small angle between vectors
 6335:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6336:             const bool validEq = (sintheta > sin_one_deg);
 6337: 
 6338:             if (validEq) {
 6339:                // Solve the system of equations to get the density gradient at elem
 6340:                icount++;
 6341:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6342:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6343:                sumRx += Rx;
 6344:                sumRy += Ry;
 6345:             }
 6346:          } // for j1
 6347: 
 6348:          // Compute the average density gradient at elem
 6349:          if (icount==0) {
 6350:            // Bad mesh quality; bail out with 0 b-cc
 6351:            elem->gradRho[k] = {0.0, 0.0};
 6352:          } else {
 6353:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6354:          }
 6355: 
 6356:       } // for k
 6357: 
 6358:    }
 6359: 
 6360:    __global__ void computeBaroclinicTerm(void) {
 6361:    // Computes the baroclinic term at sides (at half levels).
 6362:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6363:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6364: 
 6365:       if (ibc == 1) return;
 6366: 
 6367:       SIDE(side);
 6368: 
 6369:       if (side->isDry) return;
 6370: 
 6371:       const Element *e1 = side->elems[0];
 6372:       const Element *e2 = side->elems[1]; 
 6373:       const int kb = side->kb;
 6374:       
 6375:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6376: 
 6377:       // interpolates vertically the density gradient of the two elements at the half level/
 6378: 
 6379:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6380:       int k2 = max(kb, nvrt / 2);
 6381: 
 6382:       // Starts the integration at the surface and goes down to the bottom
 6383:       side->bcc[nvrt-1] = {0.0, 0.0};
 6384:       for (int k = nvrt - 2; k >= kb; k--) {
 6385:       // For each prism level (from surface to bottom)...
 6386: 
 6387:          // For both elements, interpolate density gradient at the side's half level.
 6388:          // The gradient at the side is the average of the gradients at the elements.
 6389:          // w1, w2 are used to take into account boundary sides, with just one element.
 6390:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6391:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6392:          const double wsum = w1 + w2;
 6393:          w1 = w1/wsum;
 6394:          w2 = w2/wsum;
 6395:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6396: 
 6397:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6398:          Vector2 gradRho = {0.0, 0.0};
 6399:          if (e1 != nullptr && k > kb) {
 6400:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6401:             
 6402:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6403:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6404:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6405: 
 6406:             // Grad(rho) vertically interpolated at the side's half level
 6407:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6408: 
 6409:             // Projects the element density gradient to the side frame if needed.
 6410:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6411: 
 6412:             // Adds the contribution of the density gradient at the side's half level
 6413:             gradRho += gradRho1*w1;
 6414:          }      
 6415:          if (e2 != nullptr && k > kb) {
 6416:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6417:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6418:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6419:             
 6420:             // Grad(rho) vertically interpolated at the side's half level
 6421:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6422: 
 6423:             // Projects the element density gradient to the side frame if needed.
 6424:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6425: 
 6426:             // Adds the contribution of the density gradient at the side's half level
 6427:             gradRho += gradRho2*w2;
 6428:          }
 6429: 
 6430:          
 6431:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6432:          // multiplied by -rampbc*(g/rho0) 
 6433:          const double grav3 = side->grav3();
 6434:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6435: 
 6436:       } // for
 6437: 
 6438:    }
 6439: 
 6440: 
 6441: 
 6442:    __global__ void computeHorGradientAtSide(void) {
 6443: 
 6444:       // Compute the horizontal density gradient at each element.
 6445:       // It works in two steps:
 6446:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6447:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6448:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6449:       //             gradRho.r1 = rho1 - rho0
 6450:       //             gradRho.r2 = rho2 - rho0
 6451:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6452:       // 
 6453:       //  NOTE: We use de-meaned densities.
 6454: 
 6455:       SIDE(side);
 6456: 
 6457: 
 6458:       if (side->isDry) return;
 6459: 
 6460:       // Computes the gradient of the variables at the side center.
 6461:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6462:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6463:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6464: 
 6465:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6466:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6467:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6468:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6469: 
 6470:    }
 6471: 
 6472: 
 6473:    __global__ void solveMomentumEquations(double time) {
 6474: 
 6475:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6476:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6477: 
 6478:       SIDE(side);
 6479: 
 6480:       if (side->isDry) 
 6481:       {
 6482:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6483: 
 6484:          return;
 6485:       }
 6486: 
 6487:       const Node *n1 = side->n1;
 6488:       const Node *n2 = side->n2;
 6489: 
 6490:       const int kb = side->kb;
 6491: 
 6492:       const double veg_h = side->veg_h();
 6493:       const double grav3 = side->grav3();
 6494: 
 6495:       if (side->is2D()) {
 6496:          // Remember: Do not use htot2, which is updated.
 6497:          const double htot = side->htot1();
 6498:          const double hhat = side->hhat;
 6499: 
 6500:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6501: 
 6502:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6503:          const Vector2 tau2 = side->tau();
 6504: 
 6505:          // hat_gam has units of m/s
 6506: 
 6507:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6508:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6509:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6510: 
 6511:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6512: 
 6513: 
 6514:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6515: 
 6516:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6517: 
 6518:       }
 6519:       else { // 3D
 6520: 
 6521:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6522:          // 
 6523:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6524:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6525:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6526:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6527:          // k+1 and k.
 6528: 
 6529: 
 6530:          const int ndim = nvrt - kb;
 6531:          const double zTopCanopy = side->zTopCanopy();
 6532: 
 6533:          // Initialize the tridiagonal system
 6534:          for (int k = kb + 1; k < nvrt; k++) {
 6535:             
 6536:             const int kin = k - (kb + 1);
 6537: 
 6538:             // Vertical viscosity at the face center
 6539:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6540: 
 6541:  
 6542:             alow[kin] = 0.0;
 6543:             cupp[kin] = 0.0;
 6544:             bdia[kin] = 0.0;
 6545: 
 6546:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6547:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6548: 
 6549:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6550:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6551:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6552: 
 6553:             // First part: layers k, k+1
 6554:             if (k < nvrt - 1) {
 6555:                              
 6556:                if constexpr(iveg != 0) {
 6557: 
 6558:                   // If there is vegetation at this level...
 6559:                   if (zTopCanopy > side->zc[k]) {
 6560:                      // If the canopy is above the k layer...
 6561:                      
 6562:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6563:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6564:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6565:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6566: 
 6567:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6568:                      const double vmag2 = length(ut2);
 6569:                      const double vmag1 = length(side->u2[k]);
 6570:                      const double vmag = 0.5*(vmag1 + vmag2);
 6571:                      
 6572:                      // Computes the vegetation alpha at the face center
 6573:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6574: 
 6575:                      cff1 += veg_alpha_sd*dt*vmag;
 6576: 
 6577:                   } // if (zTopCanopy
 6578:                } // if iveg
 6579: 
 6580:                const double dzz = side->Dz(k + 1);
 6581:                const double tmp = dt*dfz/dzz;
 6582:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6583: 
 6584:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6585:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6586:             }
 6587: 
 6588: 
 6589:             // Second part: layers k-1, k
 6590:             if (k > kb + 1) {
 6591: 
 6592:                double cff1 = 1.0; //init \bar{c^k}
 6593: 
 6594:                if constexpr(iveg != 0) {
 6595:                   // If there is vegetation at this level...
 6596:                   if (zTopCanopy > side->zc[k-1]) {
 6597:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6598:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6599: 
 6600:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6601: 
 6602:                      const double vmag2 = length(ut2);
 6603:                      const double vmag1 = length(side->u2[k-1]);
 6604:                      const double vmag = 0.5*(vmag1 + vmag2);
 6605: 
 6606:                      // Computes the vegetation alpha at the face center
 6607:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6608:                      cff1 += veg_alpha_sd*dt*vmag;
 6609:                   } // if zTopCanopy
 6610: 
 6611:                } // if iveg
 6612: 
 6613:                const double dzz = side->Dz(k);
 6614:                const double tmp = dt*dfz/dzz;
 6615:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6616: 
 6617:                alow[kin] += cff1*dzz/6.0 - tmp;
 6618:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6619: 
 6620:             } else { // Bottom boundary
 6621:                // This occurs at the bottom, where the bottom drag is applied.
 6622: 
 6623:                bdia[kin] += dt*side->chi2; // XXXX
 6624: 
 6625:             } // if (k > kb + 1)
 6626: 
 6627: 
 6628:          } // for (int k
 6629: 
 6630: 
 6631: 
 6632:          // Computes the RHS.
 6633:          // -----------------
 6634: 
 6635:          //	BC to be imposed at the end.
 6636: 
 6637:          const Vector2 gradETP  = side->gradETP;
 6638:          const Vector2 gradPr   = side->gradPr;
 6639:          const Vector2 gradEta1 = side->gradEta1;
 6640:          const Vector2 gradEta2 = side->gradEta2;
 6641: 
 6642:          const Vector2 *btu = side->btu;
 6643:          const Vector2 *u2  = side->u2;
 6644:          const double coriolis = side->coriolis;
 6645:          const Vector2 *nuGradU = side->nuGradU;
 6646: 
 6647:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6648:          for (int k = kb + 1; k < nvrt; k++) {
 6649:             const int kin = k - kb - 1;
 6650: 
 6651:             const double dz_0 = side->Dz(k);
 6652:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6653: 
 6654:             rrhs[kin] = {0.0, 0.0};
 6655:             double dz = 0.0;
 6656: 
 6657:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6658:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6659:             if (k < nvrt  ) dz += dz_1;
 6660:             if (k > kb + 1) dz += dz_0;
 6661: 
 6662:             // Elevation gradient, atmospheric pressure and tidal potential
 6663:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6664: 
 6665:             // Coriolis, advection, wind stress, and horizontal viscosity
 6666:             if (k < nvrt - 1) {
 6667: 
 6668: 
 6669:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6670:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6671:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6672:                                                 
 6673: 
 6674:                //diff stress tensors 1006
 6675:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6676:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6677:                   assert(false && "Not implemented: itur == 5");
 6678:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6679:                }
 6680:                // else assert(false && "itur # Not implemented");
 6681: 
 6682:             } else { // k == nvrt - 1 SURFACE
 6683:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6684:                const Vector2 tau2 = side->tau();
 6685: 
 6686:                rrhs[kin] += dt*tau2;          
 6687: 
 6688:             } // if k<nvrt
 6689: 
 6690: 
 6691:             if (k > kb + 1) {
 6692:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6693:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6694:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6695: 
 6696:                // diff stress tensors 1006
 6697:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6698:                   assert(false && "Not implemented: itur == 5");
 6699:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6700:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6701:                }
 6702:                // else assert(false && "itur # Not implemented");
 6703: 
 6704: 
 6705:             } // if k>kbs + 1
 6706: 
 6707:             // Baroclinic
 6708:             Vector2 *bcc = side->bcc;
 6709:             if constexpr(ibc == 0) {
 6710:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6711:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6712: 
 6713:             } // if ibc==0
 6714: 
 6715:          } // k=kb + 1,nvrt
 6716: 
 6717: 
 6718:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6719: 
 6720:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6721:             const int kin = k - kb - 1;
 6722:    
 6723:             // Velocity is always clamped to maximum values
 6724:             side->u2[k] = clampVelocity(soln[kin]);
 6725:          } // k
 6726: 
 6727:       } // if side->is2D()
 6728:       
 6729: 
 6730:       // Impose velocity boundary condition at the bottom
 6731:       if constexpr(imm == 2) { // 3D bed deformation model
 6732:          double dep;
 6733:          Vector2 vel;
 6734: 
 6735:          assert(false && "Not implemented: imm == 2");
 6736:          //update_bdef(time, x0, y0, dep, vel);
 6737:          // side->u2[kb] = vel;
 6738: 
 6739:       } else { // imm = 0 or 1
 6740:          if (side->Cd() == 0.0) {
 6741:             side->u2[kb] = side->u2[kb + 1];
 6742: 
 6743:          } else if (side->is3D()) { // 3D no slip bottom   
 6744:             side->u2[kb] = {0.0, 0.0};
 6745: 
 6746:          }
 6747:           
 6748:       } // if imm
 6749: 
 6750:       // The velocities below the bottom level are set to zero
 6751:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6752: 
 6753: 
 6754:    }
 6755: 
 6756: 
 6757:    __global__ void applyMomentumBC(void) {
 6758: 
 6759:       SIDE_BND(sideBnd);
 6760: 
 6761:       Side *side = sideBnd->side;
 6762:       const BoundarySegment *segment = sideBnd->segment;
 6763:       const Node *n1 = side->n1;
 6764:       const Node *n2 = side->n2;
 6765: 
 6766:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6767: 
 6768:       const bool isLand = segment->isLand;
 6769:       const int ifltype = segment->ifltype;
 6770: 
 6771:       const int kb = side->kb;
 6772: 
 6773: 
 6774:       if (!isLand && ifltype != 0) {
 6775:          const Vector2 *ubc = sideBnd->ubc;
 6776:   
 6777:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6778:             
 6779:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6780:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6781: 
 6782:             if (ifltype == -1) {
 6783:                // Flather 1
 6784: 
 6785:                const double depth = side->depth();
 6786: 
 6787:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6788: 
 6789:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6790: 
 6791:                side->u2[k] = vnorm*side->n;
 6792: 
 6793:             } else if (ifltype == -2) { // Discharge
 6794: 
 6795:                const double eta1 = side->eta1();
 6796:                const double eta2 = side->eta2();
 6797:                const double htot = side->htot2();
 6798: 
 6799:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6800:                assert(false && "Not implemented: Discharge bc");
 6801:                // const double dischrg = discharge(eta1);
 6802:                const double dischrg = 0.0; // XXX REMOVE
 6803:                
 6804: 
 6805:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6806: 
 6807:                const double vnorm = dischrg*eta2/htot;
 6808: 
 6809:                side->u2[k] = vnorm*side->n;
 6810: 
 6811:             }
 6812:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6813:                const double vnorm = dot(side->u2[k], side->n);
 6814: 
 6815:                double rat;
 6816:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6817:                else              rat = segment->vobc2; // outgoing
 6818: 
 6819:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6820: 
 6821:             }
 6822:             else { // not Flather or 3D radiation
 6823:                side->u2[k] = ubc[k];
 6824: 
 6825:             } // if (segment->ifltype...
 6826: 
 6827:          }
 6828: 
 6829:       }
 6830:       else if (isLand) { // if it is land boundary side
 6831: 
 6832:          if constexpr(islip == 0) { // free slip
 6833: 
 6834:             for (int k = kb; k < nvrt; k++) {
 6835: 
 6836:                const Vector2 t = side->t();
 6837:                const Vector2 n = side->n;
 6838: 
 6839:                double vnorm = 0.0; // for most cases
 6840:                const double vtan = dot(side->u2[k], t);
 6841:                
 6842:                side->u2[k] = vtan*t - vnorm*n;
 6843: 
 6844:             }
 6845: 
 6846:          } else { // no slip
 6847:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6848: 
 6849:          }
 6850:       } // if (side segment type...
 6851: 
 6852:    }
 6853: 
 6854: 
 6855:    __global__ void shapiroFilter1(void) {
 6856:       // First step of the Shapiro filter (normally used if indvel<=0)
 6857:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6858: 
 6859:       SIDE(side);
 6860: 
 6861:       // Only internal wet sides are processed
 6862:       if (side->isDry || !(side->isInternal())) return;
 6863: 
 6864:       const int kb = side->kb;
 6865: 
 6866:       for (int mm = 0; mm < niter_shap; mm++) {
 6867: 
 6868:          for (int k = kb + 1; k < nvrt; k++) {
 6869:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6870:             Vector2 suru = {0.0, 0.0};
 6871: 
 6872:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6873: 
 6874:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6875: 
 6876:                int kin = k;
 6877:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6878:                
 6879:                // Get the velocity at the neighbor's side.
 6880:                Vector2 nSideU2 = nSide->u2[kin];
 6881: 
 6882:                // Projects the velocity to the current side frame if needed.
 6883:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6884: 
 6885:                suru += nSideU2;
 6886:             }
 6887: 
 6888:             // Reusing bcc as a temporary array to store the suru values.
 6889:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6890: 
 6891:          }
 6892:       }
 6893:    }
 6894: 
 6895:    __global__ void shapiroFilter2(void) {
 6896:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6897: 
 6898:       SIDE(side);
 6899: 
 6900: 
 6901:       if (side->isDry || !(side->isInternal())) return;
 6902: 
 6903:       const int kb = side->kb;
 6904: 
 6905:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6906: 
 6907:       if (side->is2D()) {
 6908:          side->u2[kb + 1] = side->bcc[kb + 1];
 6909:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6910: 
 6911:       } else {
 6912:          // 3D
 6913:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6914:          
 6915:       }
 6916: 
 6917:    }
 6918: 
 6919: 
 6920:    __global__ void ul0UpdateZCoords(void) {
 6921:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6922:       
 6923:       NODE(node);      
 6924: 
 6925: 
 6926:       if (false) { //node->isDry) { XXXXXXX
 6927: 
 6928:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6929: 
 6930:          if constexpr(ivcor != 1) node->kb = 0;
 6931: 
 6932:       } else {
 6933: 
 6934:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6935:          node->updateKb();
 6936: 
 6937:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6938: 
 6939:       }
 6940: 
 6941:       // We use the temp.b field to store the previous state of isDry.
 6942:       node->tmp.b = node->isDry;
 6943: 
 6944:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6945:       node->isDry = true;
 6946: 
 6947:    }
 6948: 
 6949:    __global__ void ul0ComputeDryElements(void)
 6950:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6951:    {
 6952:       ELEM(elem);
 6953: 
 6954:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6955: 
 6956:       elem->kb = 0;
 6957: 
 6958:       if (elem->isDry) return;
 6959: 
 6960: 
 6961:    //    if(elem->isDry2()) { // XXXX
 6962:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6963:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6964:    //        call parallel_abort(errmsg)
 6965:    //    }
 6966: 
 6967:       const Node *n1 = elem->nodes[0];
 6968:       const Node *n2 = elem->nodes[1];
 6969:       const Node *n3 = elem->nodes[2];  
 6970:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6971: 
 6972:       // Computes element's kb as the minimum of the nodes' kb.
 6973:       const int kb1 = n1->kb;
 6974:       const int kb2 = n2->kb;
 6975:       const int kb3 = n3->kb;
 6976:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6977: 
 6978: 
 6979:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6980: 
 6981: 
 6982:       // Computes the element z as the mean of the nodes z.
 6983:       for (int k = elem->kb; k < nvrt; k++) {
 6984: 
 6985:          // Compute the element z as the mean of the nodes z.
 6986:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6987:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6988:          elem->z[k] /= elem->i34;
 6989: 
 6990:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6991:       }
 6992:                   
 6993:    }
 6994: 
 6995:    __global__ void ul0ComputeDryNodes(void)
 6996:    // Updates node's isDry based on the elements' isDry. 
 6997:    {
 6998:       NODE(node);
 6999: 
 7000:       node->isDry = true;
 7001: 
 7002:       // A node is wet if at least one of the elements sharing it is wet.
 7003:       for (int j = 0; j < node->numElements; j++) {
 7004:          const Element *elem = node->elements[j];
 7005:          if (!elem->isDry) {
 7006:             node->isDry = false;
 7007:             break;
 7008:          }
 7009:       }
 7010: 
 7011:        
 7012:    }
 7013: 
 7014: 
 7015:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7016:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7017:    // node->tmp.b is true if the node was previously dry.
 7018:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7019:    {
 7020:       NODE(node);
 7021:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7022: 
 7023:       // Avoid this the first time step.
 7024:       if (it == iths) return;  
 7025: 
 7026:       const bool wasDry = node->tmp.b;
 7027: 
 7028: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7029: 
 7030:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7031: 
 7032:          for (int k=0; k < nvrt; k++) {
 7033: 
 7034:             Vector3 utmp={0.0, 0.0, 0.0};
 7035: 
 7036:             double ttmp=0.0;
 7037:             double stmp=0.0;
 7038:             int icount=0;
 7039:             for (int j = 0; j < node->numNodes; j++) {
 7040: 
 7041:                const Node *nbrNode = node->nodes[j];
 7042:                
 7043:                const bool wasNbrDry = nbrNode->tmp.b;
 7044: 
 7045:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7046:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7047: 
 7048:                   icount++;
 7049: 
 7050:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7051:                   utmp += nbrNode->uvw2(k);
 7052:                   
 7053:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7054:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7055:                }
 7056:             }
 7057: 
 7058:             if (icount > 0) {
 7059:                const double inv_icount = 1.0/icount;
 7060:                utmp = inv_icount*utmp;
 7061:                node->u2[k]     = {utmp.x, utmp.y};
 7062:                node->w2[k]     = utmp.z;
 7063:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7064:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7065:             } else {
 7066:                node->u2[k] = {0.0, 0.0};
 7067:                node->w2[k] = 0.0;
 7068:                // Initialize tracers to 0.0??? XXXXX
 7069:             }
 7070:          }
 7071:       }
 7072:    }
 7073: 
 7074:   
 7075:    
 7076: 
 7077: 
 7078:    __global__ void ul0UpdateSides(int it, int iths) {
 7079:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7080:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7081:    // The dryness of the sides is updated in ul0UpdateSides2.
 7082: 
 7083:       SIDE(side);
 7084: 
 7085:       // A side is wet if and only if at least one of its elements is wet.
 7086:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7087:  
 7088:       const Node *n1 = side->n1;
 7089:       const Node *n2 = side->n2;
 7090:      
 7091:       const int kb1 = n1->kb;
 7092:       const int kb2 = n2->kb;
 7093: 
 7094:       side->kb = 0; // default when dry
 7095: 
 7096:       if (isWet) {
 7097: 
 7098:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7099: 
 7100:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7101: 
 7102:          side->kb = min(kb1, kb2);
 7103: 
 7104:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7105: 
 7106:          for (int k = side->kb; k < nvrt; k++) {
 7107:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7108: 
 7109:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7110: 
 7111:             // Compute velocity for re-wetted sides 
 7112:             if ((it != iths) && (side->isDry && isWet)) {
 7113: 
 7114:                Vector2 utmp={0.0, 0.0};
 7115: 
 7116:                int icount=0;
 7117: 
 7118:                // For all the sides on the two elements that share this side
 7119:                for (int j = 0; j < 2; j++) {
 7120:                   const Element *elem = side->elems[j];
 7121:                   if (elem == nullptr) continue;
 7122: 
 7123:                   for (int jj=0; jj < elem->i34; jj++) {
 7124:                      const Side *nSide = elem->sides[jj];
 7125:                      if (nSide->isDry) continue;
 7126: 
 7127:                      icount++;
 7128:                      utmp += nSide->u2[k];  
 7129:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7130:                   }
 7131:                }
 7132:                   
 7133:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7134:                if (icount > 0)  side->u2[k] = utmp/icount;
 7135:                else             side->u2[k] = {0.0, 0.0};
 7136:                   
 7137:             } // if ((it != iths) && (side->isDry && isWet))
 7138: 
 7139:          } // for k
 7140: 
 7141:       } // if isWet 
 7142:       
 7143: 
 7144: 
 7145:    }
 7146: 
 7147:    __global__ void ul0UpdateSides2(void) {
 7148:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7149:    
 7150:          SIDE(side);
 7151:    
 7152:          const Element *e1 = side->elems[0];
 7153:          const Element *e2 = side->elems[1];
 7154: 
 7155:          // A side is wet if and only if at least one of its elements is wet.
 7156:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7157: 
 7158:          // Update the side's dryness
 7159:          side->isDry = !isWet;
 7160: 
 7161:    }
 7162: 
 7163: 
 7164:    __global__ void zeroNodalVelocities(void) {
 7165:       NODE(node);
 7166: 
 7167:       for (int k = 0; k < nvrt; k++) {
 7168:          node->u2[k]   = {0.0, 0.0};
 7169:          node->w2[k]   = 0.0;
 7170:          node->utmp[k] = {0.0, 0.0};         
 7171:       }
 7172:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7173:    }
 7174:  
 7175: 
 7176:    __global__ void computeNodalVerticalVelocities1(void) {
 7177:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7178:    // Adds the element's vertical velocity times the element's area.
 7179:       ELEM(elem);
 7180: 
 7181:       for (int j = 0; j < elem->i34; j++) {
 7182:          Node *node = elem->nodes[j];
 7183: 
 7184:          for (int k = node->kb; k < nvrt; k++) {
 7185:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7186:          }
 7187:          atomicAdd(&(node->tmp.d), elem->area);
 7188:       }
 7189:    }
 7190: 
 7191:    __global__ void computeNodalVerticalVelocities2(void) {
 7192:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7193:    // Divides by the total area of the elements sharing the    node.
 7194:       NODE(node);
 7195: 
 7196: 
 7197:       const double invArea = 1.0 / node->tmp.d;
 7198:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7199: 
 7200:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7201:    }
 7202: 
 7203: 
 7204:    __global__ void computeNodalHorizontalVelocities1(void) {
 7205: 
 7206:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7207: 
 7208:       ELEM(elem);
 7209: 
 7210:       if (elem->isDry) return;
 7211: 
 7212:       const int kb = elem->kb;
 7213:       const bool isTri = elem->isTri();
 7214: 
 7215:       if constexpr(indvel <= 0) {
 7216:          // Assuming discontinous hvel.
 7217: 
 7218:          if (isTri) { // For triangles
 7219:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7220:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7221:             #pragma unroll
 7222:             for (int j = 0; j < 3; j++) {
 7223:                // For every node of the triangle...
 7224:                Node *node = elem->nodes[j];
 7225: 
 7226:                if (node->isDry) continue;
 7227: 
 7228:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7229:                const Side *s2 = elem->sides[(j + 1) % 3];
 7230:                const Side *s3 = elem->sides[(j + 2) % 3];
 7231: 
 7232:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7233: 
 7234:                atomicAdd(&(node->tmp.i), 1);
 7235: 
 7236:                for (int k = kb; k < nvrt; k++)  {
 7237:                   Vector2 s1u2 = s1->u2[k];
 7238:                   Vector2 s2u2 = s2->u2[k];
 7239:                   Vector2 s3u2 = s3->u2[k];
 7240: 
 7241:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7242:                   if constexpr(ics == 2) {
 7243:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7244:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7245:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7246:                   }
 7247: 
 7248:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7249:                   u = clampVelocity(u);
 7250:                   atomicAdd(&(node->utmp[k].x), u.x);
 7251:                   atomicAdd(&(node->utmp[k].y), u.y);
 7252: 
 7253:                }
 7254: 
 7255:             }
 7256:          }
 7257:          else { // For quads
 7258: 
 7259: 
 7260:             // Compute the bilinear coordinates of the center of each diagonal.
 7261:             double xi, eta;
 7262:             double shp13[4], shp24[4];
 7263:             Point2 x0, x1, x2, x3;
 7264:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7265:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7266:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7267: 
 7268:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7269:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7270: 
 7271: 
 7272: 
 7273: 
 7274:             for (int k = kb; k < nvrt; k++) {
 7275: 
 7276:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7277:                Vector2 sideU[4];
 7278:                #pragma unroll
 7279:                for (int j = 0; j < 4; j++) {
 7280:                   Vector2 u = elem->sides[j]->u2[k];
 7281:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7282:                   sideU[j] = u;
 7283:                }
 7284: 
 7285:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7286:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7287: 
 7288:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7289:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7290:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7291:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7292:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7293:                #pragma unroll
 7294:                for (int j = 0; j < 4; j++) {
 7295:                   Node *node = elem->nodes[j];
 7296:                   if (node->isDry) continue;
 7297: 
 7298:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7299:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7300:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7301:                }
 7302:             }
 7303: 
 7304:          }
 7305: 
 7306:       }
 7307:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7308:       
 7309:    }
 7310: 
 7311: 
 7312:    __global__ void computeNodalHorizontalVelocities2(void) {
 7313:       NODE(node);
 7314: 
 7315:       const int nodeCount = node->tmp.i;
 7316: 
 7317:       if (nodeCount == 0) 
 7318:       {
 7319:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7320:          return;
 7321:       }
 7322: 
 7323:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7324:       
 7325:       const int kb = node->kb;
 7326: 
 7327:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7328:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7329:       
 7330:       
 7331:    }   
 7332: 
 7333:  
