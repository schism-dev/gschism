 4949: 
 4950:    __global__ void backtrackAllNodes(void) {
 4951: 
 4952:       // max/min # of sub-divisions
 4953:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4954:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4955: 
 4956:       SIDE(side);
 4957: 
 4958:       const int kb = side->kb;
 4959: 
 4960: 
 4961:       // Initialize btrack velocities to the actual velocities at the side 
 4962:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4963:   
 4964:       if (side->isDry) return;
 4965:      
 4966: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4967: 
 4968:       // Checks that at least one element is not dry
 4969:       const Element *elem1 = side->elems[0];
 4970:       const Element *elem2 = side->elems[1];
 4971: 
 4972: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4973: 
 4974:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4975:       
 4976:       // XXXXXX
 4977:       // !swild_tmp to store global coord. of the starting side
 4978:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4979:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4980:       // !Use sframe2 
 4981:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4982: 
 4983: 
 4984:       for (int k = kb; k < nvrt; k++) {
 4985:       //  For ics=2, the coordinates are all in the side's local frame
 4986: 
 4987:          const int iadvf = side->iadv();  // Advection flag   
 4988:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4989: 
 4990:          const double vmag2 = norm2(side->u2[k]);
 4991: 
 4992:          if (vmag2 <= velmin_btrack_sq) {  
 4993:             // No activity 
 4994: 
 4995:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4996:             
 4997:          } else {  // do btrack
 4998: 
 4999:             // Compute number of sub-divisions based on local gradients of the velocity field
 5000: 
 5001:             // XXX IS THIS NECESSARY?
 5002:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5003:             double suma = 0.0;
 5004:             int icount = 0;
 5005:             #pragma unroll
 5006:             for (int l=0; l<2; l++) {
 5007:             // For each element sharing the side...
 5008: 
 5009:                const Element *elem = side->elems[l];
 5010:                  
 5011:                if (elem == nullptr) continue;
 5012: 
 5013:                icount++;
 5014: 
 5015:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5016:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5017:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5018: 
 5019:                double utmp[4];
 5020:                double vtmp[4];
 5021:                #pragma unroll
 5022:                for (int j = 0; j < elem->i34; j++) {
 5023: 
 5024:                   const Node *node = elem->nodes[j];
 5025: 
 5026:                   if constexpr(ics==1) {
 5027:                      utmp[j] = node->u2[k].x;
 5028:                      vtmp[j] = node->u2[k].y;  
 5029: 
 5030:                   } else {
 5031:                      // 'Project' the velocity from the node frame to the element frame
 5032:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5033:                      utmp[j] = tmp_u2.x;
 5034:                      vtmp[j] = tmp_u2.y;
 5035: 
 5036:                   }
 5037:                } // for j
 5038: 
 5039:                const Vector2 grad_u = elem->grad2(utmp); 
 5040:                const Vector2 grad_v = elem->grad2(vtmp);
 5041:    
 5042:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5043:             } // for l
 5044: 
 5045:             assert(icount > 0 && "Impossible 77");
 5046: 
 5047:             // '4' is somewhat arbitrary
 5048:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5049: 
 5050:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5051:             Vector3 u_int = {0.0, 0.0, 0.0};
 5052: 
 5053:             side->btrack(k, dt, dtbk, u_int);
 5054: 
 5055: 
 5056:             side->btu[k] = {u_int.x, u_int.y};
 5057:                
 5058:          } // if vmag (do backtrack)
 5059: 
 5060: 
 5061:       } // for k=kb,nvrt-1
 5062: 
 5063:    }
 5064: 
 5065: } // extern "C"
 5066: 
 5067: template<int nc>
 5068: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5069: 
 5070: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 5071: //
 5072: // a,b,c,rhs: input vectors and are not modified by this program.
 5073: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 5074: // rhs is the r.h.s.
 5075: // n: actual rank of the system.
 5076: // rows in u() and rhs();
 5077: // u: output with nc columns (transposed to rows)
 5078: // gam: a working array.
 5079: //
 5080: // NOTES:
 5081: // This is a template function that allows for different numbers of columns in the rhs vector.
 5082: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 5083: 
 5084:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5085:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5086: 
 5087:    double bet = b[0];
 5088:    if constexpr (nc == 1) {
 5089:       u[0] = rhs[0]/bet;
 5090:    } else {
 5091:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5092:    }
 5093: 
 5094:    for (int j = 1; j < n; j++) {
 5095:       gam[j] = c[j - 1]/bet;
 5096:       bet = b[j] - a[j]*gam[j];
 5097: 
 5098:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5099: 
 5100:       if constexpr (nc == 1) {
 5101:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5102:       } else {
 5103:          for (int l = 0; l < nc; l++) {
 5104:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5105:          }
 5106:       }
 5107:    }
 5108: 
 5109:    // Back-substitution
 5110:    for (int j = n - 2; j >= 0; j--) {
 5111:       if constexpr (nc == 1) {
 5112:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5113:       } else {
 5114:          for (int l = 0; l < nc; l++) {
 5115:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5116:          }
 5117:       }
 5118:    }
 5119: }
 5120: 
 5121: 
 5122: 
 5123: // Helper function that contains the core algorithm
 5124: template<typename XAccessor, typename YAccessor>
 5125: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5126:                                     double  yp_top, double  yp_bot, 
 5127:                                     CubicSpline &spline) {
 5128:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5129:    // 
 5130:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5131:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5132:    //
 5133:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5134:    // 
 5135:    // Inputs: 
 5136:    //            n: dimension for x etc; # of data pts (>=2);
 5137:    //            getX, getY: functions to access x,y coordinates
 5138:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5139:    //     Output: 
 5140:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5141: 
 5142:    const int n = k2 - k1 + 1;
 5143:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5144: 
 5145:    // Allocate memory for the splines
 5146:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5147:    spline.x   = new double[n];
 5148:    spline.y   = new double[n];
 5149:    spline.yp  = new double[n];
 5150:    spline.ypp = new double[n];
 5151: 
 5152:    for (int k=k1; k<=k2; k++) {
 5153:       spline.x[k] = getX(k);
 5154:       spline.y[k] = getY(k);
 5155:    }
 5156: 
 5157:    // This is to simplify expressions later
 5158:    double *x = spline.x;
 5159:    double *y = spline.y;
 5160: 
 5161:    double *a = nullptr;
 5162:    double *b = nullptr;
 5163:    double *c = nullptr;
 5164:    double *gam = nullptr;
 5165:    double *rhs = nullptr;
 5166:    
 5167: 
 5168:       a = new double[n];   // Lower diagonal
 5169:       b = new double[n];   // Diagonal
 5170:       c = new double[n];   // Upper diagonal
 5171:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5172:       rhs = new double[n]; // Right-hand side
 5173: 
 5174:    for (int k=k1; k<=k2; k++) {
 5175:       if (k == k1) {
 5176:          // Bottom level
 5177:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5178:          b[k] = (x[k+1] - x[k])/3.0;
 5179:          c[k] = b[k]/2.0;
 5180:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5181:       } else if (k == n - 1) {
 5182:          // Top level (surface)
 5183:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5184:          b[k] = (x[k] - x[k-1])/3.0;
 5185:          a[k] = b[k]/2.0;
 5186:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5187:       } else {
 5188:          // Intermediate levels
 5189:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5190:          b[k] = (x[k+1] - x[k-1])/3.0;
 5191:          a[k] = (x[k  ] - x[k-1])/6.0;
 5192:          c[k] = (x[k+1] - x[k  ])/6.0;
 5193:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5194:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5195:       }
 5196:    }
 5197: 
 5198:    // Solve the tridiagonal system
 5199:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5200:    
 5201:    spline.yp[k1] = yp_bot;
 5202:    spline.yp[k2] = yp_top;
 5203: 
 5204:    // Compute rest of 1st derivatives using the splines
 5205:    for (int k=k1+1; k<k2; k++) {
 5206:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5207:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5208:    }
 5209:    
 5210:    delete[] a;
 5211:    delete[] b;
 5212:    delete[] c;
 5213:    delete[] gam;
 5214:    delete[] rhs;
 5215: 
 5216: }
 5217: 
 5218: // Array version
 5219: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5220:                                 double y_top, double y_bot, 
 5221:                                 CubicSpline &spline) {
 5222:    auto getX = [x] (int k) { return x[k]; };
 5223:    auto getY = [y] (int k) { return y[k]; };
 5224:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5225: }
 5226: 
 5227: // Lambda version - allows custom access patterns
 5228: template<typename XFunc, typename YFunc>
 5229: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5230:                                 double y_top, double y_bot,
 5231:                                 CubicSpline &spline) {
 5232:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5233: }
