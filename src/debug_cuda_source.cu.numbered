 1983: __inline__ __device__ Point2 Element::outputCoords(void) const {
 1984:    if constexpr(ics == 1)  {
 1985:       return center;
 1986: 
 1987:    } else {
 1988:       const Point2 p0 = nodes[0]->outputCoords();
 1989:       const Point2 p1 = nodes[1]->outputCoords();
 1990:       const Point2 p2 = nodes[2]->outputCoords();
 1991: 
 1992:       if (isTri()) {
 1993:          return (1.0/3.0)*(p0 + p1 + p2);
 1994: 
 1995:       } else {
 1996:          const Point2 p3 = nodes[3]->outputCoords();
 1997:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 1998:       }
 1999: 
 2000:    }
 2001: }
 2002: 
 2003: __device__ __forceinline__ double Element::centerZ(void) const { 
 2004: // Z coordinate of the element center in the global cartesian coordinates.
 2005: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2006: 
 2007:    if constexpr(ics==1) { 
 2008:       return 0.0; 
 2009: 
 2010:    } else { 
 2011: 
 2012:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2013:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2014:    } 
 2015: }
