 1048: struct Side {
 1049: 
 1050:    // Geometry information
 1051:    int idx;               // Index of the side
 1052:    Node *n1, *n2;
 1053:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1054: 
 1055:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1056:    Vector2 center;        // Location of side center. 
 1057:    double zc[nvrt];       // Side center z-coord at each vertical level
 1058: 
 1059:    #ifdef USE_FRAMES
 1060:    Frame frame;
 1061:    #endif
 1062: 
 1063:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1064:                           // this is nullptr
 1065:    
 1066:    int kb;                // Bottom index of the side
 1067:    bool isDry;            // True if the side is dry
 1068:  
 1069:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1070: 
 1071:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1072: 
 1073:    // Physical information
 1074:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1075:    Vector2 btu[nvrt];           // Back-tracked velocity
 1076:    Vector2 U;                   // Vertically averaged velocity vector  
 1077: 
 1078:    Vector2 nuGradU[nvrt];          // nu*grad u
 1079: 
 1080:    Vector2 bcc[nvrt];           // Baroclinic term
 1081:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1082: 
 1083:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1084:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1085:    Vector2 gradPr;               // Gradient of pressure
 1086:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1087: 
 1088: 
 1089:    double hhat;                 // \breve{H} in notes
 1090: 
 1091:    double shapiro;
 1092: 
 1093:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1094: 
 1095:    double coriolis;             // Coriolis parameter
 1096: 
 1097:    // Vegetation parameters
 1098:    double veg_c2;
 1099:    double veg_beta;
 1100: 
 1101:    // Bottom drag parameters.
 1102:    double chi;
 1103:    double chi2;
 1104: 
 1105:    __inline__ __device__ Point2 outputCoords(void) const;
 1106: 
 1107:    __inline__ __device__ double x(double t) const;
 1108:    __inline__ __device__ double y(double t) const;
 1109:    __inline__ __device__ double z(double t) const;
 1110:    __inline__ __device__ double lon(void) const;
 1111:    __inline__ __device__ double lat(void) const;
 1112:    __inline__ __device__ Point2 p2_t(double t) const;
 1113:    __inline__ __device__ Point3 p3_t(double t) const;
 1114: 
 1115:    #ifdef USE_FRAMES
 1116:    __device__ void setFrame(void) {
 1117:       double lat, lon;
 1118:       const Point3 p = toPoint3(center, centerZ());
 1119: 
 1120:       // Compute the latitude and longitude of the element center
 1121:       computeLatLon(p, lat, lon);
 1122: 
 1123:       frame.update(lat, lon);        
 1124:    }
 1125:    #endif
 1126: 
 1127:    __inline__ __device__ double centerZ(void)      const;
 1128:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1129:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1130:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1131:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1132: 
 1133:    __inline__ __device__ Side* neigh(int index) const { 
 1134:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1135:       assert(index >= 0 && index < 4); 
 1136:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1137: 
 1138:       const int ielem = index & 1;           // 0 or 1
 1139:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1140: 
 1141:       const Element* elem = elems[ielem];
 1142: 
 1143:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1144: 
 1145:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1146: 
 1147:    }
 1148: 
 1149:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1150: 
 1151:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1152: 
 1153:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1154:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1155:    __inline__ __device__ int iadv(void) const;
 1156: 
 1157:    __inline__ __device__ double grav3(void) const;
 1158:    
 1159:    __inline__ __device__ double eta2(void) const;
 1160:    __inline__ __device__ double eta1(void) const;
 1161:    __inline__ __device__ double w2(int k) const;
 1162:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1163:    __inline__ __device__ double depth(void) const;
 1164:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1165:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1166: 
 1167:    __inline__ __device__ double dfv(int k) const;
 1168: 
 1169:    __inline__ __device__ double veg_h(void)  const;
 1170:    __inline__ __device__ double veg_nv(void) const;
 1171:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1172:    __inline__ __device__ double veg_alpha3D(int k) const;
 1173:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1174: 
 1175:    __inline__ __device__ double Cd(void) const;
 1176: 
 1177:    __inline__ __device__ Vector2 tau(void) const;
 1178: 
 1179:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1180:    
 1181: 
 1182:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1183:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1184:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1185:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1186:    } 
 1187:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1188:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1189:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1190:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1191: 
 1192:    // Get valid starting element (for backtracking)
 1193:    __inline__ __device__ Element* getStartElement() {
 1194:       return elems[0] ? elems[0] : elems[1];
 1195:    }
 1196: 
 1197:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1198:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1199:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1200: 
 1201:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1202: 
 1203:       // Dot product of the negative velocity vector with the side normal vector
 1204:       const double dot_prod1 = -dot(u, n);
 1205: 
 1206:       // Vector from side center to element 0 centroid
 1207:       const Vector2 v2 = elems[0]->center - center;
 1208: 
 1209:       // Dot product of the vector with the side normal vector
 1210:       const double dot_prod2 = dot(v2, n);
 1211: 
 1212:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1213:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1214: 
 1215:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1216:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1217: 
 1218:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1219: 
 1220:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1221:       else                           return !isDry1 ? elems[1] : elems[0];
 1222: 
 1223:  
 1224:    }
 1225: 
 1226:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1227:       // Given an element, returns the other element that shares this side
 1228:       return (elems[0] == elem) ? elems[1] : elems[0];
 1229:    }
 1230: 
 1231:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1232:       // Given a node, returns the other node that shares this side
 1233:       return (n1 == node) ? n2 : n1;
 1234:    }
 1235:  
 1236:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1237: 
 1238: 
 1239: 
 1240: 
 1241: };
 1242: 
