 8281: __global__ void printMatrix(bool full) {
 8282:    // Debugging: print the matrix
 8283: 
 8284:    const int size = mesh->np;
 8285:    double sum = 0.0;
 8286:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8287:       const Node *node = mesh->localNodeData + idx_node;
 8288:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8289:       for (int j = 0; j < node->numNodes; j++) {
 8290:          Node* nbNode = node->nodes[j];
 8291:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8292:          sum += node->coeffMatrix[j];
 8293:       }
 8294:       if (full) printf("]\n");
 8295: 
 8296: 
 8297:    }
 8298:    if (!full) printf("sum=%lf\n", sum);
 8299: }
