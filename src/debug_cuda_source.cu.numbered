  190: using Vector2 = double2; 
  191: using Vector3 = double3;
  192: using Point2  = double2;
  193: using Point3  = double3;
  194: 
  195: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  196:     return make_double2(a.x + b.x, a.y + b.y);
  197: }
  198: using Vector2 = double2; 
  199: using Vector3 = double3;
  200: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  201:     a.x += b.x;
  202:     a.y += b.y;
  203:     return a;
  204: }
  205: 
  206: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  207:     return make_double2(a.x - b.x, a.y - b.y);
  208: }
  209: 
  210: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  211:     a.x -= b.x;
  212:     a.y -= b.y;
  213:     return a;
  214: }
  215: 
  216: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  217:     return make_double2(v.x * s, v.y * s);
  218: }
  219: 
  220: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  221:     return v * s;  // reuse the previous operator
  222: }
  223: 
  224: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  225:     return make_double2(v.x / s, v.y / s);
  226: }
  227: 
  228: __device__ __forceinline__ double norm2(const double2& v) {
  229:     return v.x*v.x + v.y*v.y;
  230: }
  231: 
  232: __device__ __forceinline__ double length(const double2& v) {
  233:     return sqrt(v.x*v.x + v.y*v.y);
  234: }
  235: 
  236: __device__ __forceinline__ double2 normalize(const double2& v) {
  237:     return v / length(v);
  238: }
  239: 
  240: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  241:     return v.x*w.x + v.y*w.y;
  242: }
  243: 
  244: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  245:     return v.x*w.y - v.y*w.x;
  246: }
  247: 
  248: __device__ __forceinline__ double2 rot90(const double2& a) {
  249:     return make_double2(a.y, -a.x);
  250: }
  251: 
  252: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  253:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  254: }
  255: 
  256: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  257:     a.x += b.x;
  258:     a.y += b.y;
  259:     a.z += b.z;
  260:     return a;
  261: }
  262: 
  263: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  264:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  265: }
  266: 
  267: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  268:     return make_double3(v.x * s, v.y * s, v.z * s);
  269: }
  270: 
  271: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
