 3870: 
 3871: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3872: 
 3873: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3874: 
 3875:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3876:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3877: 
 3878:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3879:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3880: 
 3881:    double fun_lat = 0.0;
 3882:    switch (jspc[idxComp]) {
 3883:       case 0:
 3884:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3885:          break;
 3886:       case 1:
 3887:          fun_lat = sin(2.0*lat);
 3888:          break;
 3889:       case 2:
 3890:          fun_lat = pow<2>(cos(lat));
 3891:          break;
 3892:       default:
 3893:          assert(false && "computeETP: invalid jspc");
 3894:    }
 3895:    
 3896:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3897: 
 3898: }
 3899: 
 3900: __device__ void Node::updateKb(void) {
 3901: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3902: 
 3903:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3904: 
 3905: 
 3906:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3907: 
 3908:    if constexpr(ivcor == 2) {  // SZ coordinates
 3909:       
 3910:       // Compute bottom level index
 3911:       if (depth <= mesh->h_s) {
 3912:          kb = izlev;   
 3913:          
 3914:       } else {
 3915:          kb = -1;
 3916:          int L = 0;
 3917:          int R = nzlev; 
 3918:          
 3919:          while (L <= R) {
 3920:             int M = (R + L) / 2;
 3921: 
 3922: 
 3923:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3924:             
 3925:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3926:                R = M;
 3927:             } else {
 3928:                L = M;
 3929:             }
 3930: 
 3931:             if (R - L == 1) {
 3932:                kb = L;
 3933:                break;
 3934:             }
 3935:          }
 3936: 
 3937:          // Checks that the binary search was successful
 3938:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3939:        
 3940:       }
 3941:    } 
 3942: }
 3943: 
