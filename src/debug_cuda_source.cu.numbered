 3857:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3858: 
 3859:       SIDE(side);
 3860: 
 3861: 
 3862:       side->U = {0.0, 0.0}; 
 3863:          
 3864:       if(side->isDry) return;
 3865: 
 3866:       const Node *node1 = side->n1;
 3867:       const Node *node2 = side->n2;
 3868: 
 3869:       // Vertically integrated velocity U (in ll if ics=2)
 3870:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3871:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3872:       }
 3873: 
 3874:    }
 3875: 
 3876:    __global__ void computeBottomDragVegetation(void) {
 3877:       // UNFINISHED. CHECK THIS:
 3878:       // How many kernels are needed? Why so many for loops?
 3879:       // Is the loop on sides needed?
 3880: 
 3881:       NODE(node);
 3882: 
 3883:       const int    kb      = node->kb;
 3884:       const double htot    = node->htot2();
 3885:       const double rough   = node->rough;
 3886: 
 3887: 
 3888:       if (node->isDry) {
 3889:          // Default values for dry nodes
 3890:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3891:          /// XXX CHECK INDICES
 3892:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3893:       }
 3894: 
 3895:       // Compute bottom drag Cd
 3896:       //--------------------------------
 3897: 
 3898:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3899:       if (nchi==1) {
 3900: 
 3901:          bool ltmp = false; // for WBL iteration
 3902: 
 3903:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3904:          // Drag at nodes
 3905:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3906:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3907:         
 3908:          const double rough = node->rough;
 3909:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3910:          if (node->rough == 0.0) {
 3911:             node->Cd = 0.0;
 3912: 
 3913:          } else { //roughness >0 
 3914:             
 3915:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 3916:             const double bthick = max(dzb_min, bthick_ori);
 3917: 
 3918:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3919: 
 3920:             double tmp = 1.0/(2.5*log(bthick/rough));
 3921:             node->Cd = tmp*tmp;
 3922: 
 3923:          } // if rough
 3924: 
 3925: 
 3926:          // RECOVER THIS: XXX
 3927:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3928:          // Output warning for WBL if iteration didn't converge
 3929: 
 3930: 
 3931:       } // nchi==1
 3932: 
 3933:       //   Bottom stress in m^2/s^2
 3934:       if (node->rho[kb + 1] >= -98.0)
 3935:       {
 3936:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3937:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3938:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3939:          // !sediment erosion: this part needs more documentation
 3940:       }
 3941: 
 3942:     
 3943:       // Compute vegetation parameters
 3944:       //--------------------------------
 3945: 
 3946:       // SAV constants
 3947:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3948:       constexpr double veg_cfpsi = 0.16;
 3949: 
 3950:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3951:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3952: 
 3953:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3954:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3955:          int kbin = 0; // bin index
 3956:          for (int k = kb; k < nvrt; k++) {
 3957:             // Computes node height above the bottom level
 3958:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 3959:             assert(false && "Vertical variation of vegetation not implemented");
 3960: 
 3961:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3962:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3963:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3964:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3965:             // } else {
 3966:             //    // Find the bin at which the current vertical level is
 3967:             //    while (kbin<nbins_veg_vert) {
 3968:             //       const double zn = node->z[kbin];
 3969:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3970:             //          break;
 3971:             //       } // if
 3972:             //       kbin++;
 3973:             //    } // while
 3974:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3975: 
 3976:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3977:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3978:                
 3979:             //    // Linear interpolation of the vegetation parameters
 3980:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3981:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3982:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3983:             // } // if rl10
 3984: 
 3985:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3986: 
 3987:          } // for k
 3988: 
 3989: 
 3990:       } else { // Ganthy (iveg=2)
 3991:       //  Modify canopy height, diameter, and density
 3992: 
 3993:          // Make sure there is vegetation on this node
 3994:          if (node->veg_h_unbent > 0.0) {
 3995:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3996: 
 3997:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3998:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3999:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4000: 
 4001:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4002:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4003:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4004:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4005:          } // if veg_h_unbent
 4006: 
 4007:          for (int k = 0; k < nvrt; k++) {
 4008:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4009:          } // for k
 4010:       
 4011: 
 4012:       } // if iveg
 4013:      
 4014:          
 4015: 
 4016:       // Compute vertical mean of veg_alpha3D
 4017:       if (iveg != 0) {
 4018:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4019:          double sum1=0.0;
 4020:          double sum2=0.0;
 4021:          // Integrate over each level under the canopy...
 4022:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4023:             const double Dz = node->Dz(k);
 4024: 
 4025:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4026:             sum2 += Dz;
 4027: 
 4028:          } // for k
 4029: 
 4030:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4031:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4032: 
 4033:       } // if iveg
 4034: 
 4035:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4036: 
 4037:    }
 4038: 
 4039:    __global__ void computeVegetationAndDragParameters(void) {
 4040:       // Computes the vegetation and drag model parameters:
 4041:       // chi, \tilde\chi, beta, \breve{H}
 4042:       
 4043:       SIDE(side);
 4044: 
 4045:       const double htot = side->htot2();
 4046:       const int    kb   = side->kb;
 4047: 
 4048:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4049: 
 4050:       const double veg_h     = side->veg_h();
 4051:       const double veg_nv    = side->veg_nv();
 4052:       const double veg_c     = side->veg_c();
 4053:       const double veg_beta  = side->veg_beta;
 4054:       const double veg_alpha = side->veg_alpha_vert_mean();
 4055: 
 4056:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4057:       // Velocity magnitude at the bottom level
 4058:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4059:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4060:       side->chi2 = side->Cd()*vmag1;
 4061:       side->chi  = side->chi2;
 4062:       if constexpr(iveg != 0) {
 4063:          const Node *n1 = side->n1;
 4064:          const Node *n2 = side->n2;
 4065:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4066:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4067:       }
 4068: 
 4069:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4070: 
 4071:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4072:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4073:       double magUa = 0.0;
 4074:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4075:          // 3D wet side with veg...
 4076: 
 4077:          double magUa = 0.0;
 4078:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4079:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4080: 
 4081:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4082:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4083:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4084: 
 4085:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4086:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4087: 
 4088:                // Velocity magnitude at the bottom (l) of the level
 4089:                const double ul = length(side->u2[k]);
 4090: 
 4091:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4092:                magUa += Dz*0.5*(uh + ul);
 4093: 
 4094:             } // if HasVegetation
 4095:          } // for k
 4096:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4097: 
 4098:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4099:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4100:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4101:             const double zCpy = side->zTopCanopy();
 4102:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4103:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4104:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4105:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4106:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4107:          } // if isSubmerged
 4108:       } // if iveg   
 4109: 
 4110:       // Computes the friction modified depth, \breve{H} in notes
 4111:       if (side->is2D()) { // 2D
 4112: 
 4113:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4114:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4115: 
 4116:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4117: 
 4118:          side->hhat = htot*htot/fricH; 
 4119: 
 4120:       } else { // 3D
 4121:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4122: 
 4123:          if constexpr(iveg != 0) {
 4124:             
 4125:             if (side->isSubmerged()) { 
 4126:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4127:                side->hhat -= veg_c*Hhat_alpha;
 4128: 
 4129:             } else { // Emergent
 4130:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4131:             }
 4132:          } // if iveg
 4133: 
 4134:          // Enforce positivity for 3D model
 4135:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4136:       } // if 3D
 4137: 
 4138:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4139: 
 4140:         
 4141:    }
 4142: 
 4143: 
 4144: 
 4145:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4146:    // Computes the density gradient between two elements, e1 and e2.
 4147:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4148:    // zero in the direction normal to the side. 
 4149:    // 
 4150:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4151:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4152:    //
 4153:    // Input:
 4154:    //    e1: Element
 4155:    //    e2: Neighbor element (or nullptr if boundary)
 4156:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4157:    //    k: Index of the half-level at which the density is interpolated
 4158:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4159:    // 
 4160:    // Output:
 4161:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4162:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4163: 
 4164:       if (e2 == nullptr || e2->isDry) {
 4165:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4166: 
 4167:          Side *side = e1->sides[j];
 4168:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4169:                  
 4170:          if constexpr(ics == 1) {
 4171:             vec = side->n; // Normal vector to the side
 4172:          } else {
 4173:             // IMPLEMENT THIS XXXXXX
 4174:             // !replace with xel, yel?
 4175:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4176:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4177:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4178:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4179:          } //ics
 4180:                    
 4181:          diffRho = 0.0;
 4182: 
 4183:       } else { //internal and wet
 4184:          if constexpr(ics==1) {
 4185:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4186: 
 4187:             // Vector from e1 to e2
 4188:             vec = toVector2(e2->center - e1->center);
 4189: 
 4190:          } else { 
 4191:             // IMPLEMENT THIS XXXXXX
 4192:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4193:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4194:             //                   alow(j)=xctr2
 4195:             //                   bdia(j)=yctr2
 4196:          } // ics
 4197: 
 4198:          diffRho = rho2 - e1->demeanedDensity(k);
 4199:       }
 4200: 
 4201:    }
 4202: 
 4203:    __global__ void computeDensityCubicSplines(void) {
 4204:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4205: 
 4206:       ELEM(elem);
 4207: 
 4208:       if (elem->isDry) return;
 4209: 
 4210:       const int kb = elem->kb;
 4211: 
 4212:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4213:       if (elem->is2D()) {
 4214:          // In the 2D case, the density is constant at the prism level. 
 4215:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4216:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4217:       } else { //3D
 4218: 
 4219:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4220:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4221:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4222:          ///// XXXX CHECK INDICES!!!!!
 4223:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4224:       } // 2D/3D
 4225: 
 4226:    }
 4227: } // extern "C"
 4228: 
 4229: 
 4230: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4231: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4232: 
 4233:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4234: 
 4235:    const int kb  = elem->kb;
 4236:    const int kb2 = elem2->kb;
 4237: 
 4238:    // z-coordinate of prism of elem
 4239:    const double zp = elem->z_prism(k);
 4240: 
 4241:    double rho = 0.0;
 4242: 
 4243:    if (elem2->is2D()) {
 4244:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4245: 
 4246:    } else {  // 3D
 4247: 
 4248:       // eta_min may be < zmax
 4249:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4250:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4251: 
 4252:       // (Extrapolate density below bottom, we will fix it later)
 4253:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4254:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4255:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4256:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4257:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4258:    } // 2D/3D
 4259:      
 4260: 
 4261:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4262:    // Now we need to fix it.
 4263:    if (elem->z[k] < elem2->z[kb2]) {
 4264:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4265: 
 4266:       // There are two methods to adjust the density at the bottom of the element.
 4267:       // iunder_deep=0: 
 4268:       const double depth1 = abs(elem->z[kb]); // larger depth
 4269: 
 4270:       if (iunder_deep==0) {
 4271: 
 4272:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4273: 
 4274:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4275: 
 4276:       } else { // iunder_deep != 0
 4277: 
 4278:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4279: 
 4280:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4281: 
 4282:          //   Demeaned density at the same z coordinate as
 4283:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4284:          }
 4285: 
 4286:       } // if iunder_deep
 4287:    } // if elem->z[kb] < elem2->z[kb]
 4288: 
 4289:    return rho;
 4290: }
 4291: 
 4292: 
 4293: extern "C" {
 4294:    __global__ void computeDensityGradient(void) {
 4295: 
 4296:          // Compute the horizontal density gradient at each element.
 4297:       // It works in two steps:
 4298:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4299:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4300:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4301:       //             gradRho.r1 = rho1 - rho0
 4302:       //             gradRho.r2 = rho2 - rho0
 4303:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4304:       // 
 4305:       //  NOTE: We use de-meaned densities.
 4306: 
 4307:       ELEM(elem);
 4308: 
 4309:       if (elem->isDry) return;
 4310: 
 4311:       const int kb  = elem->kb;
 4312:       const int i34 = elem->i34;
 4313: 
 4314:       for (int k = kb + 1; k < nvrt; k++) {
 4315:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4316:          //             gradRho.r1 = rho1 - rho0
 4317:          //             gradRho.r2 = rho2 - rho0
 4318:          int icount = 0;
 4319:          double sumRx = 0.0;
 4320:          double sumRy = 0.0;
 4321:          for (int j1=0; j1<i34; j1++) { 
 4322: 
 4323:             const int j2 = elem->nxq(j1 + 1);
 4324: 
 4325:             // Pairs of consecutive neighbor elements of elem
 4326:             const Element *e1 = elem->nghbElems[j1];
 4327:             const Element *e2 = elem->nghbElems[j2];
 4328: 
 4329:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4330:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4331:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4332: 
 4333:             // Compute the density difference and the vector from elem to e1 and e2
 4334:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4335:             double diffRho1, diffRho2;
 4336:             Vector2 vec1, vec2;
 4337:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4338:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4339: 
 4340:             const double rl1 = length(vec1);
 4341:             const double rl2 = length(vec2);
 4342:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4343: 
 4344:             const double delta = cross(vec1, vec2);
 4345:             const double sintheta = abs(delta)/(rl1*rl2);
 4346: 
 4347:             // To avoid problems, avoid elements with small angle between vectors
 4348:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4349:             const bool validEq = (sintheta > sin_one_deg);
 4350: 
 4351:             if (validEq) {
 4352:                // Solve the system of equations to get the density gradient at elem
 4353:                icount++;
 4354:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4355:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4356:                sumRx += Rx;
 4357:                sumRy += Ry;
 4358:             }
 4359:          } // for j1
 4360: 
 4361:          // Compute the average density gradient at elem
 4362:          if (icount==0) {
 4363:            // Bad mesh quality; bail out with 0 b-cc
 4364:            elem->gradRho[k] = {0.0, 0.0};
 4365:          } else {
 4366:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4367:          }
 4368: 
 4369:       } // for k
 4370: 
 4371:    }
 4372: 
 4373:    __global__ void computeBaroclinicTerm(void) {
 4374:    // Computes the baroclinic term at sides (at half levels).
 4375:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4376:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4377: 
 4378:       SIDE(side);
 4379: 
 4380:       if (side->isDry) return;
 4381: 
 4382:       const Element *e1 = side->elems[0];
 4383:       const Element *e2 = side->elems[1];      
 4384:       const int kb = side->kb;
 4385:       
 4386:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4387: 
 4388:       // interpolates vertically the density gradient of the two elements at the half level/
 4389: 
 4390:       // Starts the integration at the surface and goes down to the bottom
 4391:       int k1 = nvrt - 1;
 4392:       int k2 = nvrt - 1;
 4393: 
 4394:       side->bcc[nvrt-1] = {0.0, 0.0};
 4395:       for (int k = nvrt-1; k >= kb; k--) {
 4396:       // For each prism level (from surface to bottom)...
 4397: 
 4398:          // For both elements, interpolate density gradient at the side's half level.
 4399:          // The gradient at the side is the average of the gradients at the elements.
 4400:          // w1, w2 are used to take into account boundary sides, with just one element.
 4401:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4402:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4403:          const double wsum = w1 + w2;
 4404:          w1 = w1/wsum;
 4405:          w2 = w2/wsum;
 4406:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4407: 
 4408:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4409:          Vector2 gradRho = {0.0, 0.0};
 4410:          if (e1 != nullptr && k > kb) {
 4411:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4412:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4413:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4414:             
 4415:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4416:          }      
 4417:          if (e2 != nullptr && k > kb) {
 4418:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4419:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4420:             
 4421:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4422:          }
 4423: 
 4424:          if constexpr(ics==2) {
 4425:             // IMPLEMENT THIS XXXXXX
 4426:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4427:             // swild(1)=tmp1
 4428:             // swild(2)=tmp2
 4429:          }
 4430:          
 4431:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4432:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4433:          // CHECK INDICES!!! XXX
 4434:          const double grav3 = side->grav3();
 4435:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4436:       } // for
 4437: 
 4438:    }
 4439: 
 4440: 
 4441: 
 4442:    __global__ void computeHorGradientAtSide(void) {
 4443: 
 4444:       // Compute the horizontal density gradient at each element.
 4445:       // It works in two steps:
 4446:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4447:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4448:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4449:       //             gradRho.r1 = rho1 - rho0
 4450:       //             gradRho.r2 = rho2 - rho0
 4451:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4452:       // 
 4453:       //  NOTE: We use de-meaned densities.
 4454: 
 4455:       SIDE(side);
 4456: 
 4457:       if (side->isDry) return;
 4458: 
 4459:       // Computes the gradient of the variables at the side center.
 4460:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4461:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4462:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4463: 
 4464:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4465:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4466:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4467:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4468: 
 4469: 
 4470:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4471:          side->gradEta1.x, side->gradEta1.y, 
 4472:          side->gradEta2.x, side->gradEta2.y, 
 4473:          side->gradETP.x, side->gradETP.y, 
 4474:          side->gradPr.x, side->gradPr.y);
 4475: 
 4476: 
 4477:    }
 4478: 
 4479: 
 4480:    __global__ void solveMomentumEquations(double time) {
 4481: 
 4482:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4483:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4484: 
 4485:       SIDE(side);
 4486: 
 4487:       if (side->isDry) 
 4488:       {
 4489:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4490: 
 4491:          return;
 4492:       }
 4493: 
 4494:       const Node *n1 = side->n1;
 4495:       const Node *n2 = side->n2;
 4496: 
 4497:       const int kb = side->kb;
 4498: 
 4499:       const double veg_h = side->veg_h();
 4500:       const double grav3 = side->grav3();
 4501: 
 4502: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4503:       if (side->is2D()) {
 4504:          // Warning: Do not use htot2, which is updated.
 4505:          const double htot = side->htot1();
 4506:          const double hhat = side->hhat;
 4507: 
 4508:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4509: 
 4510:          Vector2 tau2 = {0.0, 0.0};
 4511:           
 4512:          if constexpr(ics==1) {
 4513:             tau2 = side->tau();
 4514: 
 4515:          } else {
 4516:             assert(false && "Not implemented: ics == 2");
 4517:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4518:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4519:             // taux2=(vn1+tt1)*0.5d0
 4520:             // tauy2=(vn2+ss1)*0.5d0
 4521:          } // if ics         
 4522: 
 4523:          // hat_gam has units of m/s
 4524: 
 4525:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4526: 
 4527:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4528:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4529: 
 4530:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4531: 
 4532:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4533:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4534: 
 4535:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4536: 
 4537: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y);
 4538: 
 4539:       }
 4540:       else { // 3D
 4541: 
 4542:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4543:          // 
 4544:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4545:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4546:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4547:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4548:          // k+1 and k.
 4549: 
 4550: 
 4551:          // // Define layer thickness & viscosity
 4552:          // for (int k=kb + 1; k<nvrt; k++) {
 4553:          //    const double dzz = side->Dz(k - 1);
 4554: 
 4555:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4556: 
 4557:          //    // Vertical viscosity at the face center
 4558:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4559:         
 4560:          // }
 4561: 
 4562: 
 4563:          const int ndim = nvrt - kb;
 4564:          const double zTopCanopy = side->zTopCanopy();
 4565: 
 4566:          // Initialize the tridiagonal system
 4567:          for (int k = kb + 1; k<nvrt; k++) {
 4568:             
 4569:             const int kin = k - kb;
 4570: 
 4571:             // Vertical viscosity at the face center
 4572:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4573:             const double dzz = side->Dz(k);
 4574: 
 4575:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 4576:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 4577:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4578: 
 4579:             alow[kin] = 0.0;
 4580:             cupp[kin] = 0.0;
 4581:             bdia[kin] = 0.0;
 4582: 
 4583:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4584:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4585: 
 4586:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4587:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4588:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4589: 
 4590:             // First part: layers k, k+1
 4591:             if (k < nvrt - 1) {
 4592:                              
 4593:                if constexpr(iveg != 0) {
 4594: 
 4595:                   // If there is vegetation at this level...
 4596:                   if (zTopCanopy > side->zc[k]) {
 4597:                      // If the canopy is above the k layer...
 4598:                      
 4599:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4600:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4601:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4602:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4603: 
 4604:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4605:                      const double vmag2 = length(ut2);
 4606:                      const double vmag1 = length(side->u2[k]);
 4607:                      const double vmag = 0.5*(vmag1 + vmag2);
 4608:                      
 4609:                      // Computes the vegetation alpha at the face center
 4610:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4611: 
 4612:                      cff1 += veg_alpha_sd*dt*vmag;
 4613: 
 4614:                   } // if (zTopCanopy
 4615:                } // if iveg
 4616: 
 4617:                const double tmp = dt*dfz/dzz;
 4618:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4619:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4620: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 4621:             }
 4622: 
 4623: 
 4624:             // Second part: layers k-1, k
 4625:             if (k > kb + 1) {
 4626: 
 4627:                double cff1 = 1.0; //init \bar{c^k}
 4628: 
 4629:                if constexpr(iveg != 0) {
 4630:                   // If there is vegetation at this level...
 4631:                   if (zTopCanopy > side->zc[k-1]) {
 4632:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4633:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4634: 
 4635:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4636: 
 4637:                      const double vmag2 = length(ut2);
 4638:                      const double vmag1 = length(side->u2[k-1]);
 4639:                      const double vmag = 0.5*(vmag1 + vmag2);
 4640: 
 4641:                      // Computes the vegetation alpha at the face center
 4642:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4643:                      cff1 += veg_alpha_sd*dt*vmag;
 4644:                   } // if zTopCanopy
 4645: 
 4646:                } // if iveg
 4647: 
 4648:                const double tmp = dt*dfz/dzz;
 4649:                alow[kin] += cff1*dzz/6.0 - tmp;
 4650:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4651: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 4652:             } else { // Bottom boundary
 4653:                // This occurs at the bottom, where the bottom drag is applied.
 4654: 
 4655:                bdia[kin] += dt*side->chi2;
 4656: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 4657:             } // if (k > kb + 1)
 4658: 
 4659: 
 4660: 
 4661:          } // for (int k
 4662: 
 4663: 
 4664: 
 4665:          // Computes the RHS.
 4666:          // -----------------
 4667: 
 4668:          //	BC to be imposed at the end.
 4669: 
 4670:          const Vector2 gradETP  = side->gradETP;
 4671:          const Vector2 gradPr   = side->gradPr;
 4672:          const Vector2 gradEta1 = side->gradEta1;
 4673:          const Vector2 gradEta2 = side->gradEta2;
 4674: 
 4675:          const Vector2 *btu = side->btu;
 4676:          const Vector2 *u2  = side->u2;
 4677:          const double coriolis = side->coriolis;
 4678:          const Vector2 *d2uv = side->d2uv;
 4679: 
 4680: 
 4681:          for (int k = kb + 1; k<nvrt; k++) {
 4682:             const int kin = k - kb;
 4683: 
 4684:             const double dz_0 = side->Dz(k);
 4685:             const double dz_1 = side->Dz(k+1);  
 4686: 
 4687:             rrhs[kin] = {0.0, 0.0};
 4688:             double dz = 0.0;
 4689: 
 4690:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 4691:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 4692:             if (k < nvrt  ) dz += 0.5*dz_1;
 4693:             if (k > kb + 1) dz += 0.5*dz_0;
 4694: 
 4695:             // Elevation gradient, atmospheric pressure and tidal potential
 4696:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 4697: 
 4698:             // Coriolis, advection, wind stress, and horizontal viscosity
 4699:             if (k < nvrt - 1) {
 4700: 
 4701: 
 4702:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 4703:                                           (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 4704:                                           dt*(2.0*d2uv[k] + d2uv[k + 1]));
 4705: 
 4706:                //diff stress tensors 1006
 4707:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 4708:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 4709:                   assert(false && "Not implemented: itur == 5");
 4710:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 4711:                }
 4712: 
 4713:             } else { // k=nvrt
 4714:                Vector2 tau2 = {0.0, 0.0};
 4715:                if constexpr(ics==1) {
 4716:                   tau2 = side->tau();
 4717:                } else {
 4718:                   assert(false && "Not implemented: ics == 2");
 4719:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4720:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4721:                   // taux2=(vn1+tt1)*0.5d0
 4722:                   // tauy2=(vn2+ss1)*0.5d0
 4723:                } // if ics
 4724: 
 4725:                rrhs[kin] += dt*tau2;
 4726: 
 4727:             } // if k<nvrt
 4728: 
 4729:             if (k > kb + 1) {
 4730:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k - 1] + 
 4731:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 4732:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 4733: 
 4734: 
 4735:                // diff stress tensors 1006
 4736:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 4737:                   assert(false && "Not implemented: itur == 5");
 4738:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 4739:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 4740:                }
 4741: 
 4742:             } // if k>kbs + 1
 4743: 
 4744:             // Baroclinic
 4745:             Vector2 *bcc = side->bcc;
 4746:             if constexpr(ibc == 0) {
 4747:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 4748:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 4749: 
 4750:             } // if ibc==0
 4751: 
 4752: 
 4753:          } // k=kb + 1,nvrt
 4754: 
 4755:    printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 4756:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4757:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 4758: 
 4759:          for (int k=kb + 1; k<nvrt; k++) {
 4760:             const int kin = k - kb;
 4761: 
 4762:             // Velocity is always clamped to maximum values
 4763:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 4764:          } // k
 4765: 
 4766:       } // if side->is2D()
 4767:       
 4768: 
 4769:       // Impose velocity boundary conditions at the bottom
 4770:       if constexpr(imm == 2) { //no slip
 4771:          double dep;
 4772:          Vector2 vel;
 4773: 
 4774:          assert(false && "Not implemented: imm == 2");
 4775:          //update_bdef(time, x0, y0, dep, vel);
 4776:          // side->u2[kb] = vel;
 4777: 
 4778:       } else {
 4779:          if (side->Cd() == 0.0) {
 4780:             side->u2[kb] = side->u2[kb + 1];
 4781:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 4782:             side->u2[kb] = {0.0, 0.0};
 4783:          }
 4784:           
 4785:       } // if imm
 4786: 
 4787:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4788:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 4789:       
 4790: 
 4791:    }
 4792: 
 4793: 
 4794:    __device__ void applyMomentumBC(void) {
 4795: 
 4796:       SIDE_BND(side_bnd);
 4797: 
 4798:       Side *side = side_bnd->side;
 4799:       const BoundarySegment *segment = side_bnd->segment;
 4800:       const Node *n1 = side->n1;
 4801:       const Node *n2 = side->n2;
 4802: 
 4803:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 4804:       const bool isLand     = (segment == (BoundarySegment *)landSegment);
 4805:       const bool isInternal = (segment == (BoundarySegment *)internalSegment);
 4806: 
 4807:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 4808:       const int kb = side->kb;
 4809: 
 4810:       if (!isLand && segment->ifltype != 0) {
 4811:          const Vector2 *uth = side->uth;
 4812: 
 4813:          for (int k=kb; k < nvrt; k++) {
 4814:             assert(segment->ifltype == -2 || (uth[k].x >= -98 && uth[k].y >= -98) && "Momentum BC: Side has no velocity boundary conditions");
 4815: 
 4816:             Vector2 uth = side->uth[k];
 4817: 
 4818:             if (segment->ifltype == -1) {
 4819:                // Flather 1
 4820: 
 4821:                const double depth = side->depth();
 4822: 
 4823:                assert(n1->nodeBnd->eta_mean >= -98 && n2->nodeBnd->eta_mean >= -98 && "Flather bnd elevation not assigned");
 4824:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 4825: 
 4826:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->etaMeanBnd()) + dot(uth, side->n);
 4827: 
 4828:                side->u2[k] = vnorm*side->n;
 4829: 
 4830:             } else if (segment->ifltype == -2) { // Discharge
 4831: 
 4832: 
 4833:                const double eta1 = side->eta1();
 4834:                const double eta2 = side->eta2();
 4835:                const double htot = side->htot2();
 4836: 
 4837:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 4838:                assert(false && "Not implemented: Discharge bc");
 4839:                // const double dischrg = discharge(eta1);
 4840:                const double dischrg = 0.0; // XXX REMOVE
 4841:                
 4842: 
 4843:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 4844: 
 4845:                const double vnorm = dischrg*eta2/htot;
 4846: 
 4847:                side->u2[k] = vnorm*side->n;
 4848: 
 4849: 
 4850:             }
 4851:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 4852:                const double vnorm = dot(side->u2[k], side->n);
 4853: 
 4854:                double rat;
 4855:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 4856:                else              rat = segment->vobc2; // outgoing
 4857: 
 4858:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*uth;
 4859:             }
 4860:             else { // not Flather or 3D radiation
 4861:                side->u2[k] = uth;
 4862: 
 4863:             } // if (segment->ifltype...
 4864: 
 4865:          }
 4866: 
 4867:       }
 4868:       else if (isLand) { // land bnd
 4869:          if constexpr(islip == 0) { // free slip
 4870:             for (int k=kb; k < nvrt; k++) {
 4871:                double vnorm = 0.0; // for most cases
 4872:                const double vtan = dot(side->u2[k], side->t());
 4873:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 4874:             }
 4875: 
 4876:          } else { // no slip
 4877:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 4878: 
 4879:          }
 4880:       } // if (side segment type...
 4881: 
 4882:       
 4883: 
 4884: 
 4885: 
 4886:    }
 4887: 
 4888: 
 4889:    __device__ void shapiroFilter1(void) {
 4890:       // First step of the Shapiro filter (normally used if indvel<=0)
 4891:       // Computes the filtered values and stores them in bcc (as a temporary array).
 4892: 
 4893:       if constexpr(ishapiro == 0) return;
 4894: 
 4895:       SIDE(side);
 4896: 
 4897:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4898: 
 4899:       if (side->isDry || isInternal ) return;
 4900: 
 4901:       const int kb = side->kb;
 4902: 
 4903:       for (int mm = 1; mm <= niter_shap; mm++) {
 4904: 
 4905: 
 4906:          // Internal wet sides
 4907:          for (int k = kb + 1; k < nvrt; k++) {
 4908:             // WARNING: reusing bcc as a temporary array to store the suru values.
 4909:             side->bcc[k] = {0.0, 0.0};
 4910:             Vector2 suru = {0.0, 0.0};
 4911: 
 4912:             for (int j=0; j<4; j++) {
 4913: 
 4914:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 4915:                
 4916:                int kin = k;
 4917:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 4918:                
 4919:                if constexpr(ics==1) {
 4920:                   suru += side->u2[kin];
 4921:                } else {
 4922:                   assert(false && "Not implemented: ics == 2");
 4923:                   // Vector2 vn1, vn2;
 4924:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 4925:                   // suru=suru+vn1;
 4926:                   // surv=surv+vn2;
 4927:                }
 4928:             }
 4929: 
 4930:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 4931: 
 4932:          }
 4933:       }
 4934:    }
 4935: 
 4936:    __device__ void shapiroFilter2(void) {
 4937:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 4938: 
 4939:       if constexpr(ishapiro == 0) return;
 4940: 
 4941:       SIDE(side);
 4942: 
 4943:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4944: 
 4945:       if (side->isDry || isInternal ) return;
 4946: 
 4947:       const int kb = side->kb;
 4948: 
 4949:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 4950: 
 4951:       if (side->is2D()) {
 4952:          side->u2[kb] = side->u2[nvrt - 1];
 4953:          
 4954:       } else {
 4955:          // 3D
 4956:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 4957:          
 4958:       }
 4959: 
 4960:    }
 4961: 
 4962: 
 4963:    __global__ void ul0UpdateZCoords(void) {
 4964:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 4965:       
 4966:       NODE(node);      
 4967: 
 4968:       if (node->isDry2()) { 
 4969: 
 4970:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 4971: 
 4972:          if constexpr(ivcor != 1) node->kb = 0;
 4973: 
 4974:       } else {
 4975: 
 4976:          node->updateKb();
 4977:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 4978: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 4979: 
 4980:       } // if wet or dry
 4981: 
 4982:       // We use the temp.b field to store the previous state of isDry.
 4983:       node->tmp.b = node->isDry;
 4984: 
 4985:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 4986:       node->isDry = true;
 4987: 
 4988:    }
 4989: 
 4990:    __global__ void ul0ComputeDryElementsAndNodes(void)
 4991:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 4992:    {
 4993:       ELEM(elem);
 4994: 
 4995:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 4996: 
 4997:       // All the nodes of a wet element are wet.
 4998:       if (!elem->isDry) {
 4999:          elem->nodes[0]->isDry = false;
 5000:          elem->nodes[1]->isDry = false;
 5001:          elem->nodes[2]->isDry = false;
 5002:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5003: 
 5004:       }
 5005: 
 5006: 
 5007:       elem->kb = 0;
 5008: 
 5009:       if (elem->isDry) return;
 5010: 
 5011:       // Wet
 5012:       const Node *n1 = elem->nodes[0];
 5013:       const Node *n2 = elem->nodes[1];
 5014:       const Node *n3 = elem->nodes[2];  
 5015:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5016: 
 5017:    //    if(elem->isDry2()) {
 5018:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5019:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5020:    //        call parallel_abort(errmsg)
 5021:    //    }
 5022: 
 5023: 
 5024:       // Computes element's kb as the minimum of the nodes' kb.
 5025:       const int kb1 = n1->kb;
 5026:       const int kb2 = n2->kb;
 5027:       const int kb3 = n3->kb;
 5028:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5029: 
 5030: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5031: 
 5032:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5033: 
 5034: 
 5035:       // Computes the element z as the mean of the nodes z.
 5036:       for (int k = elem->kb; k < nvrt; k++) {
 5037: 
 5038:          // Compute the element z as the mean of the nodes z.
 5039:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5040:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5041:          elem->z[k] /= elem->i34;
 5042: 
 5043:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5044:       }
 5045:                   
 5046:    }
 5047: 
 5048:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5049:    {
 5050:       NODE(node);
 5051:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5052: 
 5053:       if (it == iths) return;
 5054: 
 5055: 
 5056:       if(!node->isDry && node->tmp.b) { // rewetted
 5057:          for (int k=0; k < nvrt; k++) {
 5058: 
 5059:             Vector3 utmp={0.0, 0.0, 0.0};
 5060: 
 5061:             double ttmp=0.0;
 5062:             double stmp=0.0;
 5063:             int icount=0;
 5064:             for (int j = 0; j < node->numNodes; j++) {
 5065: 
 5066: 
 5067:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5068:                if (!node->isDry) { // all indices extended
 5069:                   icount++;
 5070: 
 5071:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5072:                   utmp += node->u2[k];
 5073:                   
 5074:                   ttmp += node->tracers[k].tracer[0]; 
 5075:                   stmp += node->tracers[k].tracer[1]; 
 5076:                }
 5077:             }
 5078: 
 5079:             if(icount > 0) {
 5080:                const double inv_icount = 1.0/icount;
 5081:                node->u2[k]     = inv_icount*utmp;
 5082:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5083:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5084:             }
 5085:          }
 5086:       }
 5087:    }
 5088: 
 5089: 
 5090:    __global__ void ul0UpdateSides(int it, int iths) {
 5091: 
 5092:       SIDE(side);
 5093: 
 5094:       // A side is wet if and only if at least one of its elements is wet.
 5095:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5096: 
 5097:       const Node *n1 = side->n1;
 5098:       const Node *n2 = side->n2;
 5099:       const int kb1 = n1->kb;
 5100:       const int kb2 = n2->kb;
 5101: 
 5102:       side->kb = 0; // dry
 5103: 
 5104:       if (isWet) {
 5105: 
 5106:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5107: 
 5108:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5109: 
 5110:          side->kb = min(kb1, kb2);
 5111: 
 5112:          for (int k = side->kb; k < nvrt; k++) {
 5113:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5114: 
 5115:          
 5116:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5117: 
 5118:             // Compute velocity for re-wetted sides 
 5119:             if ((it != iths) && (side->isDry && isWet)) {
 5120:             
 5121:                Vector2 utmp={0.0, 0.0};
 5122: 
 5123:                int icount=0;
 5124: 
 5125:                // For all the sides on the two elements that share this side
 5126:                for (int j=0; j < 2; j++) {
 5127:                   const Element *elem = side->elems[j];
 5128:                   if (elem == nullptr) continue;
 5129: 
 5130:                   for (int jj=0; jj < elem->i34; jj++) {
 5131:                      const Side *nSide = elem->sides[jj];
 5132:                      if (nSide->isDry) continue;
 5133: 
 5134:                      icount++;
 5135:                      utmp += nSide->u2[k];                     
 5136:                   }
 5137:                }
 5138:                   
 5139:                assert(icount > 0 && "No wet sides around this side");
 5140:                if (icount > 0)  side->u2[k] = utmp/icount;
 5141:                   
 5142:             } // if ((it != iths) && (side->isDry && isWet))
 5143: 
 5144:          } // for k
 5145: 
 5146:       } // if isWet
 5147:    
 5148:       side->isDry = !isWet;
 5149: 
 5150:    }
 5151: 
 5152: 
 5153:    __global__ void zeroNodalVelocities(void) {
 5154:       NODE(node);
 5155: 
 5156:       for (int k = 0; k < nvrt; k++) {
 5157:          node->u2[k] = {0.0, 0.0, 0.0};
 5158:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5159:       }
 5160:    }
 5161: 
 5162:    __global__ void computeNodalVerticalVelocities1(void) {
 5163:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5164:    // Adds the element's vertical velocity times the element's area.
 5165:       ELEM(elem);
 5166: 
 5167:       for (int j = 0; j < elem->i34; j++) {
 5168:          Node *node = elem->nodes[j];
 5169: 
 5170:          for (int k = node->kb; k < nvrt; k++) {
 5171:             node->u2[k].z += elem->w[k]*elem->area;
 5172:             node->tmp.d += elem->area;
 5173:          }
 5174:       }
 5175:    }
 5176: 
 5177:    __global__ void computeNodalVerticalVelocities2(void) {
 5178:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5179:    // Divides by the total area of the elements sharing the    node.
 5180:       ELEM(elem);
 5181: 
 5182:       for (int j = 0; j < elem->i34; j++) {
 5183:          Node *node = elem->nodes[j];
 5184: 
 5185:          for (int k = node->kb; k < nvrt; k++) node->u2[k].z /= node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5186:       }
 5187:    }
 5188: 
 5189:    __global__ void computeNodalHorizontalVelocities(void) {
 5190:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5191:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5192:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5193: 
 5194:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5195: 
 5196:       SIDE(side);
 5197: 
 5198:       const int kb = side->kb;
 5199: 
 5200:       Node *n1 = side->n1;
 5201:       Node *n2 = side->n2;
 5202: 
 5203:       for (int k = kb; k < nvrt; k++) {
 5204: 
 5205:          // Cast the u2 vector into a Vector2 
 5206:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5207:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5208: 
 5209:          n1_u2 += side->u2[k]/n1->numSides;
 5210:          n2_u2 += side->u2[k]/n2->numSides;
 5211: 
 5212:       }
 5213: 
 5214: 
 5215:    }
 5216: 
 5217:    __global__ void resetVelocityOpenBndNodes(void) {
 5218:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5219: 
 5220:       NODE_BND(nodebnd);
 5221: 
 5222:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5223:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5224:       }
 5225: 
 5226:    }
 5227: 
 5228: 
 5229:    __global__ void setVelocityOpenBndNodes(void) {
 5230:    // For open boundary nodes sets their velocity to the imposed values.
 5231: 
 5232:       SIDE_BND(sidebnd);
 5233: 
 5234:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5235:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5236:          // to its segment to the average of the side velocity.
 5237: 
 5238:          for (int k = 0; k < nvrt; k++) {
 5239:             Node *n1 = sidebnd->side->n1;
 5240:             Node *n2 = sidebnd->side->n2;
 5241: 
 5242:             // Cast the u2 vector into a Vector2 
 5243:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5244:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5245: 
 5246:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5247:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5248:          }
 5249:       }
 5250: 
 5251:    }
 5252: 
