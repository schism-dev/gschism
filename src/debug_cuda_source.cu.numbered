 6528:    __global__ void computeBottomDragVegetation(void) {
 6529:       // UNFINISHED. CHECK THIS: XXXXX
 6530:       // How many kernels are needed? Why so many for loops?
 6531:       // Is the loop on sides needed?
 6532: 
 6533:       NODE(node);
 6534: 
 6535:       const int    kb      = node->kb;
 6536:       const double htot    = node->htot2(); 
 6537:       
 6538:       if (node->isDry) {
 6539:          // Default values for dry nodes
 6540:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6541:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6542: 
 6543:          return;
 6544:        
 6545:       }
 6546: 
 6547:       // Computes bottom drag Cd based on the selected nchi
 6548:       node->computeBottomDragCd();
 6549:       
 6550: 
 6551: 
 6552:       //   Bottom stress in m^2/s^2
 6553:       if (node->rho[kb + 1] >= -98.0)
 6554:       {
 6555:          const double mag_u = length(node->u2[kb + 1]);
 6556:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6557: 
 6558:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6559:          // !sediment erosion: this part needs more documentation
 6560:       }
 6561:     
 6562: 
 6563: 
 6564:       // Compute vegetation parameters
 6565:       //--------------------------------
 6566: 
 6567: 
 6568:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6569:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6570: 
 6571:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6572:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6573:          int kbin = 0; // bin index
 6574:          for (int k = kb; k < nvrt; k++) {
 6575:             // Computes node height above the bottom level
 6576:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6577:             assert(false && "Vertical variation of vegetation not implemented");
 6578: 
 6579:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6580:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6581:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6582:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6583:             // } else {
 6584:             //    // Find the bin at which the current vertical level is
 6585:             //    while (kbin<nbins_veg_vert) {
 6586:             //       const double zn = node->z[kbin];
 6587:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6588:             //          break;
 6589:             //       } // if
 6590:             //       kbin++;
 6591:             //    } // while
 6592:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6593: 
 6594:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6595:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6596:                
 6597:             //    // Linear interpolation of the vegetation parameters
 6598:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6599:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6600:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6601:             // } // if rl10
 6602: 
 6603:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6604: 
 6605:          } // for k
 6606: 
 6607: 
 6608:       } else { // Ganthy (iveg==2)
 6609:       //  Modify canopy height, diameter, and density
 6610: 
 6611:          // Make sure there is vegetation on this node
 6612:          if (node->veg_h_unbent > 0.0) {
 6613:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6614: 
 6615:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6616:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6617:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6618: 
 6619:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6620:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6621:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6622:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6623:          } // if veg_h_unbent
 6624: 
 6625:          for (int k = 0; k < nvrt; k++) {
 6626:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6627:          } // for k
 6628:       
 6629: 
 6630:       } // if iveg
 6631:      
 6632: 
 6633:       // Compute vertical mean of veg_alpha3D
 6634:       if (iveg != 0) {
 6635:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6636:          double sum1=0.0;
 6637:          double sum2=0.0;
 6638:          // Integrate over each level under the canopy...
 6639:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6640:             const double Dz = node->Dz(k);
 6641: 
 6642:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6643:             sum2 += Dz;
 6644: 
 6645:          } // for k
 6646:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6647:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6648: 
 6649:       } // if iveg
 6650: 
 6651:    }
