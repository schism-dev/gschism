 1555: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1556:                    Side *side = &(mesh->localSideData[idx_side]); \
 1557:                    if (idx_side >= mesh->ns) return;
 1558: 
 1559: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1560:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1561:                    if (idx_elem >= mesh->ne) return;
 1562: 
 1563: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1564:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1565:                    if (idx_node >= mesh->np) return;
 1566: 
 1567: 
 1568: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1569:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1570:                            if (idx_node_bnd >= mesh->nbp) return;
 1571: 
 1572: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1573:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1574:                            if (idx_side_bnd >= mesh->nbs) return;                           
 1575: 
