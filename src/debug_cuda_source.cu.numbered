 4268:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4269: 
 4270:       SIDE(side);
 4271: 
 4272: 
 4273:       side->U = {0.0, 0.0}; 
 4274:          
 4275:       if(side->isDry) return;
 4276: 
 4277:       const Node *node1 = side->n1;
 4278:       const Node *node2 = side->n2;
 4279: 
 4280:       // Vertically integrated velocity U (in ll if ics=2)
 4281:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4282:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4283:       }
 4284: 
 4285:    }
 4286: 
 4287:    __global__ void computeBottomDragVegetation(void) {
 4288:       // UNFINISHED. CHECK THIS:
 4289:       // How many kernels are needed? Why so many for loops?
 4290:       // Is the loop on sides needed?
 4291: 
 4292:       NODE(node);
 4293: 
 4294:       const int    kb      = node->kb;
 4295:       const double htot    = node->htot2();
 4296:       const double rough   = node->rough;
 4297: 
 4298: 
 4299:       if (node->isDry) {
 4300:          // Default values for dry nodes
 4301:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4302:          /// XXX CHECK INDICES
 4303:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4304:       }
 4305: 
 4306:       // Compute bottom drag Cd
 4307:       //--------------------------------
 4308: 
 4309:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4310:       if constexpr(nchi == 1) {
 4311: 
 4312:          bool ltmp = false; // for WBL iteration
 4313: 
 4314:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4315:          // Drag at nodes
 4316:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4317:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4318:         
 4319:          const double rough = node->rough;
 4320:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4321:          if (node->rough == 0.0) {
 4322:             node->Cd = 0.0;
 4323: 
 4324:          } else { //roughness >0 
 4325:             
 4326:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4327:             const double bthick = max(dzb_min, bthick_ori);
 4328: 
 4329:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4330: 
 4331:             double tmp = 1.0/(2.5*log(bthick/rough));
 4332:             node->Cd = tmp*tmp;
 4333: 
 4334:          } // if rough
 4335: 
 4336: 
 4337:          // RECOVER THIS: XXX
 4338:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4339:          // Output warning for WBL if iteration didn't converge
 4340: 
 4341: 
 4342:       } // nchi==1
 4343: 
 4344:       //   Bottom stress in m^2/s^2
 4345:       if (node->rho[kb + 1] >= -98.0)
 4346:       {
 4347:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4348:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4349: 
 4350:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4351:          // !sediment erosion: this part needs more documentation
 4352:       }
 4353: 
 4354:     
 4355:       // Compute vegetation parameters
 4356:       //--------------------------------
 4357: 
 4358:       // SAV constants
 4359:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4360:       constexpr double veg_cfpsi = 0.16;
 4361: 
 4362:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4363:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4364: 
 4365:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4366:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4367:          int kbin = 0; // bin index
 4368:          for (int k = kb; k < nvrt; k++) {
 4369:             // Computes node height above the bottom level
 4370:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4371:             assert(false && "Vertical variation of vegetation not implemented");
 4372: 
 4373:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4374:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4375:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4376:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4377:             // } else {
 4378:             //    // Find the bin at which the current vertical level is
 4379:             //    while (kbin<nbins_veg_vert) {
 4380:             //       const double zn = node->z[kbin];
 4381:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4382:             //          break;
 4383:             //       } // if
 4384:             //       kbin++;
 4385:             //    } // while
 4386:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4387: 
 4388:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4389:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4390:                
 4391:             //    // Linear interpolation of the vegetation parameters
 4392:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4393:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4394:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4395:             // } // if rl10
 4396: 
 4397:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4398: 
 4399:          } // for k
 4400: 
 4401: 
 4402:       } else { // Ganthy (iveg=2)
 4403:       //  Modify canopy height, diameter, and density
 4404: 
 4405:          // Make sure there is vegetation on this node
 4406:          if (node->veg_h_unbent > 0.0) {
 4407:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4408: 
 4409:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4410:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4411:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4412: 
 4413:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4414:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4415:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4416:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4417:          } // if veg_h_unbent
 4418: 
 4419:          for (int k = 0; k < nvrt; k++) {
 4420:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4421:          } // for k
 4422:       
 4423: 
 4424:       } // if iveg
 4425:      
 4426:          
 4427: 
 4428:       // Compute vertical mean of veg_alpha3D
 4429:       if (iveg != 0) {
 4430:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4431:          double sum1=0.0;
 4432:          double sum2=0.0;
 4433:          // Integrate over each level under the canopy...
 4434:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4435:             const double Dz = node->Dz(k);
 4436: 
 4437:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4438:             sum2 += Dz;
 4439: 
 4440:          } // for k
 4441: 
 4442:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4443:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4444: 
 4445:       } // if iveg
 4446: 
 4447:    }
 4448: 
 4449:    __global__ void computeVegetationAndDragParameters(void) {
 4450:       // Computes the vegetation and drag model parameters:
 4451:       // chi, \tilde\chi, beta, \breve{H}
 4452:       
 4453:       SIDE(side);
 4454: 
 4455:       const double htot = side->htot2();
 4456:       const int    kb   = side->kb;
 4457: 
 4458:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4459: 
 4460:       const double veg_h     = side->veg_h();
 4461:       const double veg_nv    = side->veg_nv();
 4462:       const double veg_c     = side->veg_c();
 4463:       const double veg_beta  = side->veg_beta;
 4464:       const double veg_alpha = side->veg_alpha_vert_mean();
 4465: 
 4466:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4467:       // Velocity magnitude at the bottom level
 4468:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4469:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4470:       side->chi2 = side->Cd()*vmag1;
 4471:       side->chi  = side->chi2;
 4472:       if constexpr(iveg != 0) {
 4473:          const Node *n1 = side->n1;
 4474:          const Node *n2 = side->n2;
 4475:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4476:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4477:       }
 4478: 
 4479:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4480: 
 4481:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4482:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4483:       double magUa = 0.0;
 4484:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4485:          // 3D wet side with veg...
 4486: 
 4487:          double magUa = 0.0;
 4488:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4489:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4490: 
 4491:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4492:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4493:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4494: 
 4495:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4496:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4497: 
 4498:                // Velocity magnitude at the bottom (l) of the level
 4499:                const double ul = length(side->u2[k]);
 4500: 
 4501:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4502:                magUa += Dz*0.5*(uh + ul);
 4503: 
 4504:             } // if HasVegetation
 4505:          } // for k
 4506:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4507: 
 4508:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4509:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4510:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4511:             const double zCpy = side->zTopCanopy();
 4512:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4513:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4514:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4515:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4516:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4517:          } // if isSubmerged
 4518:       } // if iveg   
 4519: 
 4520:       // Computes the friction modified depth, \breve{H} in notes
 4521:       if (side->is2D()) { // 2D
 4522: 
 4523:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4524:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4525: 
 4526:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4527: 
 4528:          side->hhat = htot*htot/fricH; 
 4529: 
 4530:       } else { // 3D
 4531:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4532: 
 4533:          if constexpr(iveg != 0) {
 4534:             
 4535:             if (side->isSubmerged()) { 
 4536:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4537:                side->hhat -= veg_c*Hhat_alpha;
 4538: 
 4539:             } else { // Emergent
 4540:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4541:             }
 4542:          } // if iveg
 4543: 
 4544:          // Enforce positivity for 3D model
 4545:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4546:       } // if 3D
 4547: 
 4548:    }
 4549: 
 4550: 
 4551: 
 4552:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4553:    // Computes the density gradient between two elements, e1 and e2.
 4554:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4555:    // zero in the direction normal to the side. 
 4556:    // 
 4557:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4558:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4559:    //
 4560:    // Input:
 4561:    //    e1: Element
 4562:    //    e2: Neighbor element (or nullptr if boundary)
 4563:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4564:    //    k: Index of the half-level at which the density is interpolated
 4565:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4566:    // 
 4567:    // Output:
 4568:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4569:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4570: 
 4571:       if (e2 == nullptr || e2->isDry) {
 4572:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4573: 
 4574:          Side *side = e1->sides[j];
 4575:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4576:                  
 4577:          if constexpr(ics == 1) {
 4578:             vec = side->n; // Normal vector to the side
 4579:          } else {
 4580:             // IMPLEMENT THIS XXXXXX
 4581:             // !replace with xel, yel?
 4582:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4583:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4584:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4585:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4586:          } //ics
 4587:                    
 4588:          diffRho = 0.0;
 4589: 
 4590:       } else { //internal and wet
 4591:          if constexpr(ics==1) {
 4592:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4593: 
 4594:             // Vector from e1 to e2
 4595:             vec = toVector2(e2->center - e1->center);
 4596: 
 4597:          } else { 
 4598:             // IMPLEMENT THIS XXXXXX
 4599:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4600:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4601:             //                   alow(j)=xctr2
 4602:             //                   bdia(j)=yctr2
 4603:          } // ics
 4604: 
 4605:          diffRho = rho2 - e1->demeanedDensity(k);
 4606:       }
 4607: 
 4608:    }
 4609: 
 4610:    __global__ void computeDensityCubicSplines(void) {
 4611:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4612: 
 4613:       ELEM(elem);
 4614: 
 4615:       if (elem->isDry) return;
 4616: 
 4617:       const int kb = elem->kb;
 4618: 
 4619:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4620:       if (elem->is2D()) {
 4621:          // In the 2D case, the density is constant at the prism level. 
 4622:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4623:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4624:       } else { //3D
 4625: 
 4626:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4627:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4628:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4629:          ///// XXXX CHECK INDICES!!!!!
 4630:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4631:       } // 2D/3D
 4632: 
 4633:    }
 4634: } // extern "C"
 4635: 
 4636: 
 4637: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4638: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4639: 
 4640:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4641: 
 4642:    const int kb  = elem->kb;
 4643:    const int kb2 = elem2->kb;
 4644: 
 4645:    // z-coordinate of prism of elem
 4646:    const double zp = elem->z_prism(k);
 4647: 
 4648:    double rho = 0.0;
 4649: 
 4650:    if (elem2->is2D()) {
 4651:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4652: 
 4653:    } else {  // 3D
 4654: 
 4655:       // eta_min may be < zmax
 4656:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4657:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4658: 
 4659:       // (Extrapolate density below bottom, we will fix it later)
 4660:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4661:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4662:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4663:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4664:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4665:    } // 2D/3D
 4666:      
 4667: 
 4668:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4669:    // Now we need to fix it.
 4670:    if (elem->z[k] < elem2->z[kb2]) {
 4671:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4672: 
 4673:       // There are two methods to adjust the density at the bottom of the element.
 4674:       // iunder_deep=0: 
 4675:       const double depth1 = abs(elem->z[kb]); // larger depth
 4676: 
 4677:       if (iunder_deep==0) {
 4678: 
 4679:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4680: 
 4681:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4682: 
 4683:       } else { // iunder_deep != 0
 4684: 
 4685:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4686: 
 4687:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4688: 
 4689:          //   Demeaned density at the same z coordinate as
 4690:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4691:          }
 4692: 
 4693:       } // if iunder_deep
 4694:    } // if elem->z[kb] < elem2->z[kb]
 4695: 
 4696:    return rho;
 4697: }
 4698: 
 4699: 
 4700: extern "C" {
 4701:    __global__ void computeDensityGradient(void) {
 4702: 
 4703:          // Compute the horizontal density gradient at each element.
 4704:       // It works in two steps:
 4705:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4706:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4707:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4708:       //             gradRho.r1 = rho1 - rho0
 4709:       //             gradRho.r2 = rho2 - rho0
 4710:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4711:       // 
 4712:       //  NOTE: We use de-meaned densities.
 4713: 
 4714:       ELEM(elem);
 4715: 
 4716:       if (elem->isDry) return;
 4717: 
 4718:       const int kb  = elem->kb;
 4719:       const int i34 = elem->i34;
 4720: 
 4721:       for (int k = kb + 1; k < nvrt; k++) {
 4722:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4723:          //             gradRho.r1 = rho1 - rho0
 4724:          //             gradRho.r2 = rho2 - rho0
 4725:          int icount = 0;
 4726:          double sumRx = 0.0;
 4727:          double sumRy = 0.0;
 4728:          for (int j1=0; j1<i34; j1++) { 
 4729: 
 4730:             const int j2 = elem->nxq(j1 + 1);
 4731: 
 4732:             // Pairs of consecutive neighbor elements of elem
 4733:             const Element *e1 = elem->nghbElems[j1];
 4734:             const Element *e2 = elem->nghbElems[j2];
 4735: 
 4736:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4737:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4738:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4739: 
 4740:             // Compute the density difference and the vector from elem to e1 and e2
 4741:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4742:             double diffRho1, diffRho2;
 4743:             Vector2 vec1, vec2;
 4744:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4745:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4746: 
 4747:             const double rl1 = length(vec1);
 4748:             const double rl2 = length(vec2);
 4749:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4750: 
 4751:             const double delta = cross(vec1, vec2);
 4752:             const double sintheta = abs(delta)/(rl1*rl2);
 4753: 
 4754:             // To avoid problems, avoid elements with small angle between vectors
 4755:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4756:             const bool validEq = (sintheta > sin_one_deg);
 4757: 
 4758:             if (validEq) {
 4759:                // Solve the system of equations to get the density gradient at elem
 4760:                icount++;
 4761:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4762:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4763:                sumRx += Rx;
 4764:                sumRy += Ry;
 4765:             }
 4766:          } // for j1
 4767: 
 4768:          // Compute the average density gradient at elem
 4769:          if (icount==0) {
 4770:            // Bad mesh quality; bail out with 0 b-cc
 4771:            elem->gradRho[k] = {0.0, 0.0};
 4772:          } else {
 4773:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4774:          }
 4775: 
 4776:       } // for k
 4777: 
 4778:    }
 4779: 
 4780:    __global__ void computeBaroclinicTerm(void) {
 4781:    // Computes the baroclinic term at sides (at half levels).
 4782:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4783:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4784: 
 4785:       SIDE(side);
 4786: 
 4787:       if (side->isDry) return;
 4788: 
 4789:       const Element *e1 = side->elems[0];
 4790:       const Element *e2 = side->elems[1];      
 4791:       const int kb = side->kb;
 4792:       
 4793:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4794: 
 4795:       // interpolates vertically the density gradient of the two elements at the half level/
 4796: 
 4797:       // Starts the integration at the surface and goes down to the bottom
 4798:       int k1 = nvrt - 1;
 4799:       int k2 = nvrt - 1;
 4800: 
 4801:       side->bcc[nvrt-1] = {0.0, 0.0};
 4802:       for (int k = nvrt-2; k >= kb; k--) {
 4803:       // For each prism level (from surface to bottom)...
 4804: 
 4805:          // For both elements, interpolate density gradient at the side's half level.
 4806:          // The gradient at the side is the average of the gradients at the elements.
 4807:          // w1, w2 are used to take into account boundary sides, with just one element.
 4808:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4809:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4810:          const double wsum = w1 + w2;
 4811:          w1 = w1/wsum;
 4812:          w2 = w2/wsum;
 4813:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4814: 
 4815:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4816:          Vector2 gradRho = {0.0, 0.0};
 4817:          if (e1 != nullptr && k > kb) {
 4818:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4819:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4820:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4821:             
 4822:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4823:          }      
 4824:          if (e2 != nullptr && k > kb) {
 4825:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4826:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4827:             
 4828:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4829:          }
 4830: 
 4831:          if constexpr(ics==2) {
 4832:             // IMPLEMENT THIS XXXXXX
 4833:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4834:             // swild(1)=tmp1
 4835:             // swild(2)=tmp2
 4836:          }
 4837:          
 4838:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4839:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4840:          // CHECK INDICES!!! XXX
 4841:          const double grav3 = side->grav3();
 4842:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4843: 
 4844:       } // for
 4845: 
 4846:    }
 4847: 
 4848: 
 4849: 
 4850:    __global__ void computeHorGradientAtSide(void) {
 4851: 
 4852:       // Compute the horizontal density gradient at each element.
 4853:       // It works in two steps:
 4854:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4855:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4856:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4857:       //             gradRho.r1 = rho1 - rho0
 4858:       //             gradRho.r2 = rho2 - rho0
 4859:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4860:       // 
 4861:       //  NOTE: We use de-meaned densities.
 4862: 
 4863:       SIDE(side);
 4864: 
 4865: // printf("side->isDry: %d\n", side->isDry);
 4866:       if (side->isDry) return;
 4867: 
 4868:       // Computes the gradient of the variables at the side center.
 4869:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4870:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4871:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4872: 
 4873:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4874:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4875:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4876:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4877: // printf("gradEta1: %.15f, %.15f\n", side->gradEta1.x, side->gradEta1.y);
 4878: // printf("gradEta2: %.15f, %.15f\n", side->gradEta2.x, side->gradEta2.y);
 4879: // printf("gradETP: %.15f, %.15f\n", side->gradETP.x, side->gradETP.y);
 4880: // printf("gradPr: %.15f, %.15f\n", side->gradPr.x, side->gradPr.y);
 4881: 
 4882: 
 4883:    }
 4884: 
 4885: 
 4886:    __global__ void solveMomentumEquations(double time) {
 4887: 
 4888:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4889:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4890: 
 4891:       SIDE(side);
 4892: 
 4893: 
 4894:       if (side->isDry) 
 4895:       {
 4896:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4897: 
 4898:          return;
 4899:       }
 4900: 
 4901:       const Node *n1 = side->n1;
 4902:       const Node *n2 = side->n2;
 4903: 
 4904:       const int kb = side->kb;
 4905: 
 4906:       const double veg_h = side->veg_h();
 4907:       const double grav3 = side->grav3();
 4908: 
 4909:       if (side->is2D()) {
 4910:          // Warning: Do not use htot2, which is updated.
 4911:          const double htot = side->htot1();
 4912:          const double hhat = side->hhat;
 4913: 
 4914:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4915: 
 4916:          Vector2 tau2 = {0.0, 0.0};
 4917:           
 4918:          if constexpr(ics==1) {
 4919:             tau2 = side->tau();
 4920: 
 4921:          } else {
 4922:             assert(false && "Not implemented: ics == 2");
 4923:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4924:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4925:             // taux2=(vn1+tt1)*0.5d0
 4926:             // tauy2=(vn2+ss1)*0.5d0
 4927:          } // if ics         
 4928: 
 4929:          // hat_gam has units of m/s
 4930: 
 4931:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4932: 
 4933:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4934:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4935: 
 4936:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4937: 
 4938:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4939:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4940: 
 4941:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4942: 
 4943: 
 4944:       }
 4945:       else { // 3D
 4946: 
 4947:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4948:          // 
 4949:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4950:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4951:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4952:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4953:          // k+1 and k.
 4954: 
 4955: 
 4956:          // // Define layer thickness & viscosity
 4957:          // for (int k=kb + 1; k<nvrt; k++) {
 4958:          //    const double dzz = side->Dz(k - 1);
 4959: 
 4960:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4961: 
 4962:          //    // Vertical viscosity at the face center
 4963:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4964:         
 4965:          // }
 4966: 
 4967: 
 4968:          const int ndim = nvrt - kb;
 4969:          const double zTopCanopy = side->zTopCanopy();
 4970: 
 4971:          // Initialize the tridiagonal system
 4972:          for (int k = kb + 1; k < nvrt; k++) {
 4973:             
 4974:             const int kin = k - (kb + 1);
 4975: 
 4976:             // Vertical viscosity at the face center
 4977:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4978:             const double dzz = side->Dz(k);
 4979: 
 4980:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4981: 
 4982:             alow[kin] = 0.0;
 4983:             cupp[kin] = 0.0;
 4984:             bdia[kin] = 0.0;
 4985: 
 4986:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4987:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4988: 
 4989:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4990:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4991:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4992: 
 4993:             // First part: layers k, k+1
 4994:             if (k < nvrt - 1) {
 4995:                              
 4996:                if constexpr(iveg != 0) {
 4997: 
 4998:                   // If there is vegetation at this level...
 4999:                   if (zTopCanopy > side->zc[k]) {
 5000:                      // If the canopy is above the k layer...
 5001:                      
 5002:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5003:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5004:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5005:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5006: 
 5007:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5008:                      const double vmag2 = length(ut2);
 5009:                      const double vmag1 = length(side->u2[k]);
 5010:                      const double vmag = 0.5*(vmag1 + vmag2);
 5011:                      
 5012:                      // Computes the vegetation alpha at the face center
 5013:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5014: 
 5015:                      cff1 += veg_alpha_sd*dt*vmag;
 5016: 
 5017:                   } // if (zTopCanopy
 5018:                } // if iveg
 5019: 
 5020:                const double tmp = dt*dfz/dzz;
 5021:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5022:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5023:             }
 5024: 
 5025: 
 5026:             // Second part: layers k-1, k
 5027:             if (k > kb + 1) {
 5028: 
 5029:                double cff1 = 1.0; //init \bar{c^k}
 5030: 
 5031:                if constexpr(iveg != 0) {
 5032:                   // If there is vegetation at this level...
 5033:                   if (zTopCanopy > side->zc[k-1]) {
 5034:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5035:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5036: 
 5037:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5038: 
 5039:                      const double vmag2 = length(ut2);
 5040:                      const double vmag1 = length(side->u2[k-1]);
 5041:                      const double vmag = 0.5*(vmag1 + vmag2);
 5042: 
 5043:                      // Computes the vegetation alpha at the face center
 5044:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5045:                      cff1 += veg_alpha_sd*dt*vmag;
 5046:                   } // if zTopCanopy
 5047: 
 5048:                } // if iveg
 5049: 
 5050:                const double tmp = dt*dfz/dzz;
 5051:                alow[kin] += cff1*dzz/6.0 - tmp;
 5052:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5053: 
 5054:             } else { // Bottom boundary
 5055:                // This occurs at the bottom, where the bottom drag is applied.
 5056: 
 5057:                bdia[kin] += dt*side->chi2;
 5058: 
 5059:             } // if (k > kb + 1)
 5060: 
 5061: 
 5062: 
 5063:          } // for (int k
 5064: 
 5065: 
 5066: 
 5067:          // Computes the RHS.
 5068:          // -----------------
 5069: 
 5070:          //	BC to be imposed at the end.
 5071: 
 5072:          const Vector2 gradETP  = side->gradETP;
 5073:          const Vector2 gradPr   = side->gradPr;
 5074:          const Vector2 gradEta1 = side->gradEta1;
 5075:          const Vector2 gradEta2 = side->gradEta2;
 5076: 
 5077:          const Vector2 *btu = side->btu;
 5078:          const Vector2 *u2  = side->u2;
 5079:          const double coriolis = side->coriolis;
 5080:          const Vector2 *nuGradU = side->nuGradU;
 5081: 
 5082: 
 5083:          for (int k = kb + 1; k<nvrt; k++) {
 5084:             const int kin = k - kb;
 5085: 
 5086:             const double dz_0 = side->Dz(k);
 5087:             const double dz_1 = side->Dz(k+1);  
 5088: 
 5089:             rrhs[kin] = {0.0, 0.0};
 5090:             double dz = 0.0;
 5091: 
 5092:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5093:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5094:             if (k < nvrt  ) dz += 0.5*dz_1;
 5095:             if (k > kb + 1) dz += 0.5*dz_0;
 5096: 
 5097:             // Elevation gradient, atmospheric pressure and tidal potential
 5098:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5099: 
 5100:             // Coriolis, advection, wind stress, and horizontal viscosity
 5101:             if (k < nvrt - 1) {
 5102: 
 5103: 
 5104:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5105:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5106:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5107: 
 5108:                //diff stress tensors 1006
 5109:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5110:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5111:                   assert(false && "Not implemented: itur == 5");
 5112:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5113:                }
 5114: 
 5115:             } else { // k=nvrt
 5116:                Vector2 tau2 = {0.0, 0.0};
 5117:                if constexpr(ics==1) {
 5118:                   tau2 = side->tau();
 5119:                } else {
 5120:                   assert(false && "Not implemented: ics == 2");
 5121:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5122:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5123:                   // taux2=(vn1+tt1)*0.5d0
 5124:                   // tauy2=(vn2+ss1)*0.5d0
 5125:                } // if ics
 5126: 
 5127:                rrhs[kin] += dt*tau2;
 5128: 
 5129:             } // if k<nvrt
 5130: 
 5131:             if (k > kb + 1) {
 5132:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5133:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5134:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5135: 
 5136: 
 5137:                // diff stress tensors 1006
 5138:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5139:                   assert(false && "Not implemented: itur == 5");
 5140:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5141:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5142:                }
 5143: 
 5144:             } // if k>kbs + 1
 5145: 
 5146:             // Baroclinic
 5147:             Vector2 *bcc = side->bcc;
 5148:             if constexpr(ibc == 0) {
 5149:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5150:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5151: 
 5152:             } // if ibc==0
 5153: 
 5154: 
 5155:          } // k=kb + 1,nvrt
 5156: 
 5157:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5158: // if (side->idx == 1) for (int k=0; k<nvrt; k++) printf("AAAAAA alow[%d] = %f, bdia[%d] = %f, cupp[%d] = %f, rrhs[%d] = %f\n", k, alow[k], k, bdia[k], k, cupp[k], k, rrhs[k]);   
 5159:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5160: 
 5161: 
 5162:          for (int k=kb + 1; k<nvrt; k++) {
 5163:             const int kin = k - kb;
 5164: 
 5165:             // Velocity is always clamped to maximum values
 5166:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5167:          } // k
 5168: 
 5169:       } // if side->is2D()
 5170:       
 5171: 
 5172:       // Impose velocity boundary condition at the bottom
 5173:       if constexpr(imm == 2) { // 3D bed deformation model
 5174:          double dep;
 5175:          Vector2 vel;
 5176: 
 5177:          assert(false && "Not implemented: imm == 2");
 5178:          //update_bdef(time, x0, y0, dep, vel);
 5179:          // side->u2[kb] = vel;
 5180: 
 5181:       } else { // imm = 0 or 1
 5182:          if (side->Cd() == 0.0) {
 5183:             side->u2[kb] = side->u2[kb + 1];
 5184:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom   XXXXX use is3D()?
 5185: // printf("XXXXXXXXX computeFlowBcVelocities: 3D no slip bottom, side idx = %d\n", side->idx);
 5186:             side->u2[kb] = {0.0, 0.0};
 5187:          }
 5188:           
 5189:       } // if imm
 5190: 
 5191:       // The velocities below the bottom level are set to zero
 5192:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5193: 
 5194: 
 5195:    }
 5196: 
 5197: 
 5198:    __global__ void applyMomentumBC(void) {
 5199: 
 5200:       SIDE_BND(sideBnd);
 5201: 
 5202:       Side *side = sideBnd->side;
 5203:       const BoundarySegment *segment = sideBnd->segment;
 5204:       const Node *n1 = side->n1;
 5205:       const Node *n2 = side->n2;
 5206: 
 5207:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5208: 
 5209:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5210:       const bool isLand = segment->isLand;
 5211:       const int ifltype = segment->ifltype;
 5212: 
 5213:       const int kb = side->kb;
 5214: 
 5215:       if (!isLand && ifltype != 0) {
 5216:          const Vector2 *ubc = sideBnd->ubc;
 5217:   
 5218:          for (int k=kb; k < nvrt; k++) {
 5219:             
 5220:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5221:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5222: 
 5223:             if (ifltype == -1) {
 5224:                // Flather 1
 5225: 
 5226:                const double depth = side->depth();
 5227: 
 5228:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5229: 
 5230:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5231: 
 5232:                side->u2[k] = vnorm*side->n;
 5233: 
 5234:             } else if (ifltype == -2) { // Discharge
 5235: 
 5236:                const double eta1 = side->eta1();
 5237:                const double eta2 = side->eta2();
 5238:                const double htot = side->htot2();
 5239: 
 5240:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5241:                assert(false && "Not implemented: Discharge bc");
 5242:                // const double dischrg = discharge(eta1);
 5243:                const double dischrg = 0.0; // XXX REMOVE
 5244:                
 5245: 
 5246:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5247: 
 5248:                const double vnorm = dischrg*eta2/htot;
 5249: 
 5250:                side->u2[k] = vnorm*side->n;
 5251: 
 5252: 
 5253:             }
 5254:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5255:                const double vnorm = dot(side->u2[k], side->n);
 5256: 
 5257:                double rat;
 5258:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5259:                else              rat = segment->vobc2; // outgoing
 5260: 
 5261:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5262:             }
 5263:             else { // not Flather or 3D radiation
 5264:                side->u2[k] = ubc[k];
 5265: 
 5266:             } // if (segment->ifltype...
 5267: 
 5268:          }
 5269: 
 5270:       }
 5271:       else if (isLand) { // if it is land boundary side
 5272: 
 5273:          if constexpr(islip == 0) { // free slip
 5274: 
 5275:             for (int k=kb; k < nvrt; k++) {
 5276: 
 5277:                const Vector2 t = side->t();
 5278:                const Vector2 n = side->n;
 5279: 
 5280:                double vnorm = 0.0; // for most cases
 5281:                const double vtan = dot(side->u2[k], t);
 5282:                
 5283:                side->u2[k] = vtan*t - vnorm*n;
 5284: 
 5285:             }
 5286: 
 5287:          } else { // no slip
 5288:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5289: 
 5290:          }
 5291:       } // if (side segment type...
 5292: 
 5293:    
 5294: 
 5295:    }
 5296: 
 5297: 
 5298:    __global__ void shapiroFilter1(void) {
 5299:       // First step of the Shapiro filter (normally used if indvel<=0)
 5300:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5301: 
 5302:       SIDE(side);
 5303: 
 5304:       // Only internal wet sides are processed
 5305:       if (side->isDry || !(side->isInternal())) return;
 5306: 
 5307:       const int kb = side->kb;
 5308: 
 5309:       for (int mm = 1; mm <= niter_shap; mm++) {
 5310: 
 5311:          for (int k = kb + 1; k < nvrt; k++) {
 5312:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5313:             side->bcc[k] = {0.0, 0.0};
 5314:             Vector2 suru = {0.0, 0.0};
 5315: 
 5316:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5317: 
 5318:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5319: 
 5320:                int kin = k;
 5321:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5322:                
 5323:                if constexpr(ics==1) {
 5324:                   suru += nSide->u2[kin];
 5325: 
 5326:                } else {
 5327:                   assert(false && "Not implemented: ics == 2");
 5328:                   // Vector2 vn1, vn2;
 5329:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5330:                   // suru=suru+vn1;
 5331:                   // surv=surv+vn2;
 5332:                }
 5333:             }
 5334: 
 5335: 
 5336:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5337: 
 5338:          }
 5339:       }
 5340:    }
 5341: 
 5342:    __global__ void shapiroFilter2(void) {
 5343:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5344: 
 5345:       SIDE(side);
 5346: 
 5347: // side->u2[1] = {10.0,-10.0}; 
 5348: // side->u2[0] = {10.0,-10.0};
 5349: // return;      
 5350: 
 5351:       if (side->isDry || !(side->isInternal())) return;
 5352: 
 5353:       const int kb = side->kb;
 5354: 
 5355:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5356: 
 5357:       if (side->is2D()) {
 5358:          // side->u2[kb] = side->u2[nvrt - 1];
 5359:          side->u2[kb + 1] = side->bcc[kb + 1];
 5360:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5361: 
 5362:       } else {
 5363:          // 3D
 5364:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5365:          
 5366:       }
 5367: 
 5368:    }
 5369: 
 5370: 
 5371:    __global__ void ul0UpdateZCoords(void) {
 5372:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5373:       
 5374:       NODE(node);      
 5375: 
 5376: 
 5377:       if (node->isDry2()) { 
 5378: 
 5379:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5380: 
 5381:          if constexpr(ivcor != 1) node->kb = 0;
 5382: 
 5383:       } else {
 5384: 
 5385:          node->updateKb();
 5386:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5387: 
 5388:       }
 5389: 
 5390:       // We use the temp.b field to store the previous state of isDry.
 5391:       node->tmp.b = node->isDry;
 5392: 
 5393:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5394:       node->isDry = true;
 5395: 
 5396:    }
 5397: 
 5398:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5399:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5400:    {
 5401:       ELEM(elem);
 5402: 
 5403:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5404: 
 5405:       // All the nodes of a wet element are wet.
 5406:       if (!elem->isDry) {
 5407:          elem->nodes[0]->isDry = false;
 5408:          elem->nodes[1]->isDry = false;
 5409:          elem->nodes[2]->isDry = false;
 5410:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5411: 
 5412:       }
 5413: 
 5414: 
 5415:       elem->kb = 0;
 5416: 
 5417:       if (elem->isDry) return;
 5418: 
 5419:       // Wet
 5420:       const Node *n1 = elem->nodes[0];
 5421:       const Node *n2 = elem->nodes[1];
 5422:       const Node *n3 = elem->nodes[2];  
 5423:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5424: 
 5425:    //    if(elem->isDry2()) {
 5426:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5427:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5428:    //        call parallel_abort(errmsg)
 5429:    //    }
 5430: 
 5431: 
 5432:       // Computes element's kb as the minimum of the nodes' kb.
 5433:       const int kb1 = n1->kb;
 5434:       const int kb2 = n2->kb;
 5435:       const int kb3 = n3->kb;
 5436:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5437: 
 5438: 
 5439:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5440: 
 5441: 
 5442:       // Computes the element z as the mean of the nodes z.
 5443:       for (int k = elem->kb; k < nvrt; k++) {
 5444: 
 5445:          // Compute the element z as the mean of the nodes z.
 5446:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5447:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5448:          elem->z[k] /= elem->i34;
 5449: 
 5450:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5451:       }
 5452:                   
 5453:    }
 5454: 
 5455:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5456:    {
 5457:       NODE(node);
 5458:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5459: 
 5460:       if (it == iths) return;
 5461: 
 5462: 
 5463:       if(!node->isDry && node->tmp.b) { // rewetted
 5464:          for (int k=0; k < nvrt; k++) {
 5465: 
 5466:             Vector3 utmp={0.0, 0.0, 0.0};
 5467: 
 5468:             double ttmp=0.0;
 5469:             double stmp=0.0;
 5470:             int icount=0;
 5471:             for (int j = 0; j < node->numNodes; j++) {
 5472: 
 5473: 
 5474:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5475:                if (!node->isDry) { // all indices extended
 5476:                   icount++;
 5477: 
 5478:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5479:                   utmp += node->u2[k];
 5480:                   
 5481:                   ttmp += node->tracers[k].tracer[0]; 
 5482:                   stmp += node->tracers[k].tracer[1]; 
 5483:                }
 5484:             }
 5485: 
 5486:             if(icount > 0) {
 5487:                const double inv_icount = 1.0/icount;
 5488:                node->u2[k]     = inv_icount*utmp;
 5489:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5490:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5491:             }
 5492:          }
 5493:       }
 5494:    }
 5495: 
 5496: 
 5497:    __global__ void ul0UpdateSides(int it, int iths) {
 5498: 
 5499:       SIDE(side);
 5500: 
 5501:       // A side is wet if and only if at least one of its elements is wet.
 5502:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5503: 
 5504:       const Node *n1 = side->n1;
 5505:       const Node *n2 = side->n2;
 5506:       const int kb1 = n1->kb;
 5507:       const int kb2 = n2->kb;
 5508: 
 5509:       side->kb = 0; // dry
 5510: 
 5511:       if (isWet) {
 5512: 
 5513:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5514: 
 5515:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5516: 
 5517:          side->kb = min(kb1, kb2);
 5518: 
 5519:          for (int k = side->kb; k < nvrt; k++) {
 5520:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5521: 
 5522:          
 5523:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5524: 
 5525:             // Compute velocity for re-wetted sides 
 5526:             if ((it != iths) && (side->isDry && isWet)) {
 5527:             
 5528:                Vector2 utmp={0.0, 0.0};
 5529: 
 5530:                int icount=0;
 5531: 
 5532:                // For all the sides on the two elements that share this side
 5533:                for (int j=0; j < 2; j++) {
 5534:                   const Element *elem = side->elems[j];
 5535:                   if (elem == nullptr) continue;
 5536: 
 5537:                   for (int jj=0; jj < elem->i34; jj++) {
 5538:                      const Side *nSide = elem->sides[jj];
 5539:                      if (nSide->isDry) continue;
 5540: 
 5541:                      icount++;
 5542:                      utmp += nSide->u2[k];                     
 5543:                   }
 5544:                }
 5545:                   
 5546:                assert(icount > 0 && "No wet sides around this side");
 5547:                if (icount > 0)  side->u2[k] = utmp/icount;
 5548:                   
 5549:             } // if ((it != iths) && (side->isDry && isWet))
 5550: 
 5551:          } // for k
 5552: 
 5553:       } // if isWet
 5554:    
 5555:       side->isDry = !isWet;
 5556: 
 5557:    }
 5558: 
 5559: 
 5560:    __global__ void zeroNodalVelocities(void) {
 5561:       NODE(node);
 5562: 
 5563:       for (int k = 0; k < nvrt; k++) {
 5564:          node->u2[k]   = {0.0, 0.0, 0.0};
 5565:          node->utmp[k] = {0.0, 0.0};
 5566:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5567:       }
 5568:    }
 5569: 
 5570:    __global__ void computeNodalVerticalVelocities1(void) {
 5571:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5572:    // Adds the element's vertical velocity times the element's area.
 5573:       ELEM(elem);
 5574: 
 5575:       for (int j = 0; j < elem->i34; j++) {
 5576:          Node *node = elem->nodes[j];
 5577: 
 5578:          for (int k = node->kb; k < nvrt; k++) {
 5579:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5580:          }
 5581:          atomicAdd(&(node->tmp.d), elem->area);
 5582:       }
 5583:    }
 5584: 
 5585:    __global__ void computeNodalVerticalVelocities2(void) {
 5586:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5587:    // Divides by the total area of the elements sharing the    node.
 5588:       NODE(node);
 5589: 
 5590:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5591:    }
 5592: 
 5593: 
 5594:    __global__ void computeNodalHorizontalVelocities1(void) {
 5595:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5596:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5597: 
 5598:       ELEM(elem);
 5599: 
 5600:       const int kb = elem->kb;
 5601:       const bool isTri = elem->isTri();
 5602: 
 5603:       if constexpr(indvel <= 0) {
 5604:          // Assuming discontinoius hvel.
 5605: 
 5606: 
 5607:          if (isTri) { // For triangles
 5608:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated at one node can be
 5609:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5610: 
 5611:             for (int j = 0; j < 3; j++) {
 5612:                // For every node of the triangle...
 5613:                Node *node = elem->nodes[j];
 5614: 
 5615:                const Side *s1 = elem->sides[j];
 5616:                const Side *s2 = elem->sides[(j + 1) % 3];
 5617:                const Side *s3 = elem->sides[(j + 2) % 3];
 5618: 
 5619:                const int numElements = node->numElements;
 5620: 
 5621:                for (int k = kb; k < nvrt; k++)  {
 5622:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k];
 5623:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5624:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5625:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5626:                   atomicAdd(&(node->utmp[k].x), (1.0/numElements) * u.x);
 5627:                   atomicAdd(&(node->utmp[k].y), (1.0/numElements) * u.y);
 5628: 
 5629:                }
 5630: 
 5631:             }
 5632:          }
 5633:          else { // For quads
 5634: 
 5635:          }
 5636: 
 5637:       }
 5638:       
 5639:    }
 5640: 
 5641: 
 5642:    __global__ void computeNodalHorizontalVelocities2(void) {
 5643:       NODE(node);
 5644: 
 5645:       for (int k = 0; k < nvrt; k++) {
 5646:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5647:       }
 5648:       
 5649:    }   
 5650: 
 5651:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5652:    // XXXX I'm not sure where I got this function from. 
 5653:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5654:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5655:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5656:    // It uses the utmp array as a temporary array to store the velocities.
 5657: 
 5658:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5659: 
 5660:       SIDE(side);
 5661: 
 5662:       const int kb = side->kb;
 5663: 
 5664:       Node *n1 = side->n1;
 5665:       Node *n2 = side->n2;
 5666: 
 5667:       for (int k = kb; k < nvrt; k++) {
 5668: 
 5669:          // Cast the u2 vector into a Vector2 
 5670:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5671:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5672: 
 5673:          n1_u2 = side->u2[k]/n1->numSides;
 5674:          n2_u2 = side->u2[k]/n2->numSides;
 5675: 
 5676:       }
 5677: 
 5678: 
 5679:    }
 5680: 
 5681:    __global__ void resetVelocityOpenBndNodes(void) {
 5682:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5683: 
 5684:       NODE_BND(nodebnd);
 5685: 
 5686:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5687:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5688:       }
 5689: 
 5690:    }
 5691: 
 5692: 
 5693:    __global__ void setVelocityOpenBndNodes(void) {
 5694:    // For open boundary nodes sets their velocity to the imposed values.
 5695: 
 5696:       SIDE_BND(sidebnd);
 5697: 
 5698:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5699:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5700:          // to its segment to the average of the side velocity.
 5701: 
 5702:          for (int k = 0; k < nvrt; k++) {
 5703:             Node *n1 = sidebnd->side->n1;
 5704:             Node *n2 = sidebnd->side->n2;
 5705: 
 5706:             // Cast the u2 vector into a Vector2 
 5707:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5708:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5709: 
 5710:             if (n1->nodeBnd->segment == sidebnd->segment) {
 5711:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 5712:             }
 5713:             if (n2->nodeBnd->segment == sidebnd->segment) {
 5714:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 5715:             }
 5716: 
 5717:          }
 5718:       }
 5719: 
 5720:    }
