 1978: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 1979: {
 1980:     uintptr_t p = (uintptr_t)address;
 1981:     assert((p & 1) == 0);
 1982: 
 1983:     unsigned int* base = (unsigned int*)(p & ~3);
 1984:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 1985:                                   :  (unsigned int)val;
 1986: 
 1987:     atomicAdd(base, addend);
 1988: }
