 8083: __global__ void returnMatrix(double *res) {
 8084:    // Debugging: returns the matrix as a CuPy array
 8085: 
 8086:    const int size = mesh->np;
 8087:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8088:       const Node *node = mesh->localNodeData + idx_node;
 8089:       res[idx_node*size + idx_node] = node->coeffDiag;
 8090:       for (int j = 0; j < node->numNodes; j++) {
 8091:          Node* nbNode = node->nodes[j];
 8092:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8093:       }
 8094: 
 8095:    }
 8096:    
 8097: }
 8098: 
