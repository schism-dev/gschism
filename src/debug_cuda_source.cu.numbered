 3687: 
 3688: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3689:    // Computes the z coordinate at level k.
 3690:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3691:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3692:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3693:    // used 
 3694: 
 3695:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3696:    
 3697:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3698: 
 3699:    if (isDry2()) return 0.0;  
 3700: 
 3701:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3702: 
 3703:    if constexpr(ivcor == 2) {
 3704: 
 3705:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3706:       const double h_c = mesh->h_c;
 3707:       const double theta_f = mesh->theta_f;
 3708:       const double sinh_theta_f = mesh->sinh_theta_f;
 3709: 
 3710: 
 3711:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3712:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3713:       // once per time step/node. XXXX
 3714:       // CHECK: updateZCoordData
 3715: 
 3716:       //  To simplify comparisons, I define index versions of count variables.
 3717:       if      (k == ivrt)     return eta2; 
 3718:       else if (k == izlev)    return -hmod2;
 3719:       else if (k == kb)       return -depth;
 3720:       else if (k < izlev)     return mesh->ztot[k];
 3721:       else if (k > izlev) {
 3722:          const int ksig = k - izlev;
 3723: 
 3724:          if (hmod2 <= h_c) {
 3725:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3726: 
 3727:          } 
 3728:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3729:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3730:             assert(false && "compZCoord: invalid h_c\n");
 3731:          } 
 3732:          else {
 3733:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3734:                    h_c * mesh->sigma[ksig] + 
 3735:                    (hmod2 - h_c) * mesh->cs[ksig];
 3736:          }
 3737:       } else { 
 3738:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3739:       }
 3740: 
 3741:    }
 3742:    else {  // if constexpr(ivcor == 1)
 3743:       if (k <= kb)        return -depth; 
 3744:       else if (k == ivrt) return eta2;
 3745:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3746: 
 3747:    }
 3748:    
 3749:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3750:    return 0.0;
 3751: }
 3752: 
 3753: 
 3754: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3755:    // Computes the bottom drag Cd based on the selected nchi
 3756: 
 3757:    if constexpr(nchi == 0) {
 3758:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3759:       Cd = drag;  // Read from drag file
 3760: 
 3761:    } else if constexpr(nchi == 1) {
 3762:       // 
 3763: 
 3764:       bool ltmp = false; // for WBL iteration
 3765: 
 3766:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3767:       if (isDry || (rough == 0.0)) {
 3768:          Cd = 0.0;
 3769: 
 3770:       } else { //roughness >0 
 3771:          
 3772:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3773: 
 3774:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3775: 
 3776:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3777: 
 3778:       } // if rough
 3779: 
 3780:    } else if constexpr(nchi == -1) {
 3781:    // Manning 
 3782:  
 3783:       const double htot = max(hmin_man, htot2()); 
 3784:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3785: 
 3786:    } else {
 3787:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3788:       
 3789:    } // if nchi
 3790: 
 3791: }
 3792: 
 3793: 
 3794: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3795:    // Checks if a side in on the boundary
 3796:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3797: 
 3798:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3799:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3800: 
 3801:    // Indices of the nodes that form the side
 3802:    //
 3803:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3804:    const int n1 = side.n1->idx;
 3805:    const int n2 = side.n2->idx;
 3806:    isLand = false;
 3807:    
 3808: 
 3809:    // Check if the side is on a land boundary
 3810:    for (int i = 0; i < nland; i++) {
 3811:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3812:          // Consecutive nodes in the land boundary segment
 3813:          const int b1 = ilnd[i + j*nland];
 3814:          const int b2 = ilnd[i + (j + 1)*nland];
 3815: 
 3816:          assert(b1 != -1 && b2 != -1);
 3817: 
 3818:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3819:             
 3820:             isLand = true;
 3821:             return i;
 3822:          }
 3823:       }
 3824:    }
 3825: 
 3826:    // Check if the side is on an open boundary
 3827:    for (int i = 0; i < nope; i++) {
 3828:       for (int j = 0; j < nond[i] - 1; j++) {
 3829:          // Consecutive nodes in the open boundary segment
 3830:          const int b1 = iond[i + j*nope];
 3831:          const int b2 = iond[i + (j + 1)*nope];
 3832: 
 3833:          assert(b1 != -1 && b2 != -1);
 3834: 
 3835:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3836:             isLand = false;
 3837:             return i;
 3838:          }
 3839:       }
 3840:    }
 3841: 
 3842:    return -1;
 3843: }
 3844: 
 3845: 
 3846: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3847:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3848:                                     double *wind_rotate_angle, 
 3849:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3850:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3851:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3852:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3853:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3854: 
 3855:    NODE(pnode);  
 3856:    const int i = idx_node;
 3857:    Node &node(*pnode);
 3858: 
 3859:    node.idx = i;
 3860: 
 3861:    const int idxNodeStart = nodeNeighNodesStart[i];
 3862:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3863:    node.numNodes = idxNodeEnd - idxNodeStart;
 3864:    node.nodes = nodeNeighNodes + idxNodeStart;
 3865:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3866: 
 3867: 
 3868: 
 3869:    const int idxElemStart = nodeNeighElemsStart[i];
 3870:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3871:    node.numElements = idxElemEnd - idxElemStart;
 3872:    node.elements = nodeNeighElems + idxElemStart;
 3873: 
 3874: 
 3875:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3876:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3877:       const int partNode = localNodePart[idxNodeGlobal]; 
 3878:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3879: 
 3880:       Node *node_ptr = nodes[partNode] + idxNode;
 3881:       
 3882:       nodeNeighNodes[idx] = node_ptr;
 3883:    }
 3884: 
 3885: 
 3886:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3887:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3888:       const int partElem = localElemPart[idxElemGlobal];
 3889:       const int idxElem  = localElemIndices[idxElemGlobal];
 3890: 
 3891:       Element *elem_ptr = elems[partElem] + idxElem;
 3892: 
 3893:       nodeNeighElems[idx] = elem_ptr;
 3894:    }      
 3895: 
 3896:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3897:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3898: 
 3899:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3900: 
 3901:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3902:    if constexpr(ics == 1) {
 3903:       node.p.x   = node_coords[i * 3];
 3904:       node.p.y   = node_coords[i * 3 + 1];
 3905:       node.gz = 0.0;
 3906: 
 3907:       if (use_ll) {                                    // <-- add
 3908:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3909:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3910:       }  
 3911: 
 3912:    } else {
 3913:       const double lon = deg2rad*node_coords[i * 3];
 3914:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3915: 
 3916:       Point3 p = computeXYZfromLatLon(lat, lon);
 3917:       node.p = toVector2(p);
 3918:       node.gz = p.z;
 3919:       node.lon = lon;
 3920:       node.lat = lat;
 3921: 
 3922:       #ifdef USE_FRAMES
 3923:       node.setFrame(lat, lon);
 3924:       #endif
 3925: 
 3926: 
 3927:    }
 3928: 
 3929:    node.depth = node_coords[i * 3 + 2];
 3930: 
 3931:    node.numSides = 0;
 3932: 
 3933:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3934:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3935:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3936:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3937:    else assert(false && "populateNodes: selected nchi not implemented.");
 3938:    
 3939:    if constexpr(ivcor == 1) 
 3940:    {  
 3941:       node.kb = kb[i];
 3942: 
 3943:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3944:    }
 3945: 
 3946:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3947:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3948:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3949: 
 3950:    
 3951:    // Links the node to the boundary information
 3952:    if (isbnd[i] >= 0) {
 3953:      
 3954:       // Get the index of the node boundary
 3955:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3956: 
 3957:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3958:       node.nodeBnd->node = &node;
 3959: 
 3960:       node.nodeBnd->sideBnd1 = nullptr;
 3961:       node.nodeBnd->sideBnd2 = nullptr;
 3962: 
 3963:       if (isbnd[i]>=0) {
 3964: 
 3965:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3966:          
 3967:          node.nodeBnd->segment->ifltype = 7777 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3968:          node.nodeBnd->segment->iettype = 7777; // XXXXXXXXX
 3969: 
 3970:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3971:          node.nodeBnd->segment->clen  = nan("1");
 3972:          node.nodeBnd->segment->carea = nan("1");
 3973: 
 3974:       }
 3975:    } else {
 3976: 
 3977:       node.nodeBnd = nullptr; // For internal nodes
 3978: 
 3979:       if (isbnd[i] == landSegment) {
 3980:          node.nodeBnd = &landBoundaryNode;
 3981:          node.nodeBnd->segment = &landBoundarySegment;
 3982:       }
 3983:       
 3984:    }
 3985:    
 3986:    // XXXX GAUSSIAN HILL VELOCITIES
 3987:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3988:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3989:          constexpr double rot_per = 3000.0;
 3990:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3991:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3992:       // XXXXX
 3993:    #endif
 3994: 
 3995: }
 3996: 
 3997: 
 3998: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3999:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4000:                                     double *wind_rotate_angle,   
 4001:                                     int *isdel, int *isidenode, int *isbnd,
 4002:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4003:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4004:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4005:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4006:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4007:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4008:                                     double *drag, double *roughness) {
 4009: 
 4010: 
 4011:    SIDE(pside);
 4012:    Side &side(*pside);
 4013:    const int i = idx_side;
 4014: 
 4015:    side.idx = i;  
 4016:    
 4017:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4018:    const double fc   = 2.0*omega_e*sin(sfea0);
 4019:    const double beta = 2.0*omega_e*cos(sfea0);
 4020: 
 4021:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4022: 
 4023:    // finding the pointer to the nodes that form the side
 4024:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4025:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4026: 
 4027:    const int locidx_n1 = localNodeIndices[idx_n1];
 4028:    const int locidx_n2 = localNodeIndices[idx_n2];
 4029:    const int part_n1 =   localNodePart[idx_n1];
 4030:    const int part_n2 =   localNodePart[idx_n2];
 4031: 
 4032:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4033:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4034: 
 4035: 
 4036:    // Counts the number of sides connected to each node
 4037:    side.n1->numSides++;
 4038:    side.n2->numSides++;
 4039: 
 4040:    // Side boundary type
 4041:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4042:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4043: 
 4044:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4045:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4046:    {
 4047:       bool isLand = false;
 4048:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4049:       
 4050:       if (isbs > -1) {
 4051:          // assert(isLand || isbs>=0);
 4052:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4053: 
 4054:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4055: 
 4056:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4057:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4058: 
 4059:          assert (isLand == side.sideBnd->segment->isLand);
 4060: 
 4061:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4062:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4063:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4064: 
 4065:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4066:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4067:          
 4068:          side.sideBnd->side = &side;
 4069: 
 4070:       }
 4071:       else {
 4072:          side.sideBnd = nullptr;
 4073:       }
 4074:    }
 4075:    else 
 4076:    {
 4077:       side.sideBnd = nullptr;
 4078:    }
 4079: 
 4080: 
 4081:    // finding the pointer to the elements that share the side
 4082:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4083:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4084: 
 4085:    if (idx_e1 > -1) {
 4086:       const int locidx_e1 = localElemIndices[idx_e1];
 4087:       const int part_e1 =  localElemPart[idx_e1];
 4088:       side.elems[0] = elems[part_e1] + locidx_e1;
 4089: 
 4090:    }
 4091:    else {
 4092:       side.elems[0] = nullptr;
 4093:    }
 4094: 
 4095:    if (idx_e2 > -1) {
 4096:       const int locidx_e2 = localElemIndices[idx_e2];
 4097:       const int part_e2 =  localElemPart[idx_e2];
 4098:       side.elems[1] = elems[part_e2] + locidx_e2;
 4099:    }
 4100:    else {
 4101:       side.elems[1] = nullptr;
 4102:    }
 4103:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4104:       
 4105:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4106:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4107:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4108:          
 4109:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4110:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4111:       // printf("sideBnd: %p\n", side.sideBnd);
 4112:       // assert(false && "Side has no elements and no boundary");
 4113:    }
 4114:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4115: 
 4116:    // Compute the center of the side
 4117:    side.center = 0.5*(side.n1->p + side.n2->p);
 4118: 
 4119:    #ifdef USE_FRAMES
 4120:    side.setFrame();
 4121:    #endif
 4122: 
 4123:    // Normal, unitary vector to the side
 4124:    if constexpr(ics == 1) {
 4125:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4126:       side.n = normalize(side.n);
 4127:    }
 4128:    else {
 4129:       // Unit side vector in 3D cartesian coordinates
 4130:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4131: 
 4132:       nSide = normalize(nSide);
 4133: 
 4134:       // Its cross product with the unit local z-axis vector (nUp) is the
 4135:       // normal vector we are looking for.
 4136:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4137: 
 4138:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4139:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4140:       side.n = -normalize(n2D); 
 4141: 
 4142:    }
 4143: 
 4144:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4145:    side.shapiro = shapiro0;
 4146: 
 4147:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4148:    // XXXX
 4149:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4150:    constexpr double rot_per=3000.0;
 4151:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4152:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4153:    // XXXXX      
 4154:    #endif
 4155:    // Compute the z level at the center of the side
 4156:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4157:    
 4158:    // Compute the length of the side
 4159:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4160: 
 4161: 
 4162:    // Compute the Coriolis coefficient
 4163: 
 4164:    if constexpr(ncor == -1 || ncor == 0) {
 4165:       side.coriolis = coricoef;
 4166:    }
 4167:    else {
 4168:       const double sphi = side.lat();  // Latitude at the center of the side
 4169: 
 4170:       assert(use_ll && "use_ll must be true when ncor > 0");
 4171: 
 4172:       if constexpr(ics == 1) {
 4173:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4174:       }
 4175:       else { // ics == 2
 4176:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4177:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4178:       }
 4179: 
 4180:    }
 4181: 
 4182: }
 4183: 
 4184: 
 4185: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4186:    double *node_coords, double *node_coords_ll, bool use_ll,
 4187:    double *wind_rotate_angle,   
 4188:    int *isdel, int *isidenode, int *isbnd,
 4189:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4190:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4191:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4192:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4193:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4194:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4195:    double *drag, double *roughness) {
 4196: 
 4197:    ELEM(pelem);
 4198:    Element &elem(*pelem);
 4199:    const int i = idx_elem;
 4200: 
 4201:    elem.idx = i;
 4202: 
 4203:    for (int j = 0; j < i34[i]; j++) {
 4204:       const int idxNode = elnode[i*4 + j];  
 4205:       const int idxSide = elside[i*4 + j];
 4206:       
 4207:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4208:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4209: 
 4210:       // Find the neighboring element  
 4211:       if (elem.sides[j]->elems[0] == &elem) {
 4212:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4213:       }
 4214:       else {
 4215:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4216:       }
 4217:       
 4218:    }
 4219: 
 4220:    elem.i34 = i34[i];
 4221: 
 4222:    // Compute the barycenter of the element and its depth
 4223:    elem.center = {0.0, 0.0};
 4224:    elem.depth = 1e10;
 4225:    for (int j = 0; j < i34[i]; j++) {
 4226: 
 4227:       elem.center += elem.nodes[j]->p/i34[i];
 4228:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4229:    }
 4230: 
 4231:    #ifdef USE_FRAMES
 4232:    elem.setFrame();
 4233:    #endif
 4234: 
 4235:    elem.area = elem.computeSignedArea(); 
 4236:    elem.radius = sqrt(elem.area)/pi; 
 4237:    
 4238:    // Determines which way the normal vector to each side is oriented.
 4239:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4240:    for (int j = 0; j < i34[i]; j++)  
 4241:    {
 4242:       if (elem.sides[j]->elems[0] == &elem) {
 4243:          elem.ssign[j] =  1.0;
 4244:       }
 4245:       else {
 4246:          elem.ssign[j] = -1.0;
 4247:       }
 4248: 
 4249:    }
 4250: 
 4251:   
 4252: 
 4253:    // Derivatives of shape functions
 4254:    //  For ics=2, this is done in the element frame
 4255:    //  For quads, the derivative is evaluated at centroid
 4256:    for (int j = 0; j < elem.i34; j++) {
 4257:       const double area = elem.area;
 4258:       const int id2 = elem.nxq(1 + j);
 4259:       const int id3 = elem.nxq(2 + j);
 4260:       const int id4 = elem.nxq(3 + j);
 4261:       if (elem.isTri()) {
 4262:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4263:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4264:          // da1/dx = (y1 - y2)/(2*area)
 4265: 
 4266:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4267:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4268:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4269: 
 4270:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4271:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4272: 
 4273:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4274: 
 4275:       }
 4276:       else  { // Quad; evaluate at centroid
 4277: 
 4278:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4279:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4280:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4281: 
 4282:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4283:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4284: 
 4285:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4286:       } // if Tri
 4287: 
 4288:    } // for j   
 4289:    
 4290:    
 4291: 
 4292: }
 4293: 
 4294: 
 4295: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4296:                                             double *emo, double *efa, 
 4297:                                             double *umo, double *ufa, 
 4298:                                             double *vmo, double *vfa,
 4299:                                             int *ifltype, int *iettype) {
 4300: 
 4301:    NODE_BND(nodeBnd);
 4302:    const int idx = idx_node_bnd;    
 4303: 
 4304:    nodeBnd->idx = idx;
 4305: 
 4306:    // Need to find the segment index and the index of the node on the segment
 4307:    int idxNode = -1;
 4308:    int iseg, i;
 4309:    for (iseg = 0; iseg < nope; iseg++) {
 4310:       // for each segment...
 4311:       for (i = 0; i < nond[iseg]; i++) {
 4312:          idxNode = iond[iseg + i*nope];
 4313:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4314:          
 4315:       }
 4316:    }
 4317: 
 4318:    assert(iseg < nope && "iseg is out of bounds");
 4319: 
 4320: found: // Jumped here when the node was found
 4321: 
 4322:    nodeBnd->isEssentialBC = true;
 4323:    nodeBnd->elbc = 0.0;
 4324: 
 4325:    nodeBnd->segment->ifltype = ifltype[iseg];
 4326:    nodeBnd->segment->iettype = iettype[iseg];
 4327: 
 4328:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4329: 
 4330:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4331: 
 4332:       nodeBnd->efa[jfr] = efa[idx2];
 4333:       nodeBnd->emo[jfr] = emo[idx2];
 4334:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4335:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4336: 
 4337:    }
 4338:         
 4339: 
 4340: }
 4341: 
 4342: __device__ void Mesh::populateBoundarySideLinks(void) {
 4343: 
 4344:    SIDE_BND(sideBnd);
 4345: 
 4346:    const Side *side = sideBnd->side;
 4347: 
 4348:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4349:    // and the rightSide is the side s that has s->n1 == side->n2
 4350:    for (int i = 0; i < mesh->nbs; i++) {
 4351: 
 4352:       Side *s = &mesh->localSideData[i];
 4353: 
 4354:       if (s == side) continue;  // Do not link the side to itself
 4355:    
 4356:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4357:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4358:    }
 4359:    
 4360: }
