 2287: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2288: {
 2289:     uintptr_t p = (uintptr_t)address;
 2290:     assert((p & 1) == 0);
 2291: 
 2292:     unsigned int* base = (unsigned int*)(p & ~3);
 2293:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2294:                                   :  (unsigned int)val;
 2295: 
 2296:     atomicAdd(base, addend);
 2297: }
