 4877: 
 4878: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4879:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4880:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4881:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4882: }
 4883: 
 4884: 
 4885: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4886:    // Brunt-Väisälä frequency at level k.
 4887:    if (k <= node->kb || k >= ivrt) return 0.0;
 4888:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4889: }
 4890: 
 4891: 
 4892: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4893: 
 4894:    
 4895:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4896:    // k is the layer bottom index.
 4897: 
 4898: 
 4899: 
 4900:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4901: 
 4902:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4903:       const double eta2 = node->eta2;
 4904:       const double depth = node->depth;
 4905: 
 4906:       // Distances from the layer midpoint to the surface and bottom
 4907:       const double dist_s = eta2 - z_c;
 4908:       const double dist_b = z_c + depth;
 4909: 
 4910:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4911: 
 4912:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4913: 
 4914: 
 4915:    } else {
 4916:       return 1.0; // Other GLS submodels
 4917: 
 4918:    }
 4919: }
 4920: 
 4921: 
 4922: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4923:    // Minimum mixing length for levels below the surface.
 4924:    // Independent of psimin(); do not invert one to get the other.
 4925:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4926: }
 4927: 
 4928: 
 4929: __device__ void Turbulence<TurbulenceModel::GLS>::init(Node *node) {
 4930:    // Whole column, including levels below kb. Matches the Fortran cold start.
 4931:    for (int k = 0; k < nvrt; k++) {
 4932:       tke[k]    = tkemin();
 4933:       mxl[k]    = mxlmin(node->depth);
 4934:       nu_tke[k] = diffmin;
 4935:       nu_phi[k] = diffmin;
 4936: 
 4937:       node->dfv[k] = 0.0;
 4938:       node->dfh[k] = 0.0;
 4939:    }
 4940: }
 4941: 
 4942: 
 4943: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4944: 
 4945:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4946: 
 4947:    if constexpr(iveg == 1) {
 4948:       
 4949:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4950:       const double zTopCanopy = node->zTopCanopy();
 4951: 
 4952:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4953: 
 4954:          const double ztop = node->z[k];   // Top of the current layer.
 4955: 
 4956:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4957:          // Where 1 means that the current level is fully within the vegetation layer.
 4958:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4959: 
 4960:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4961:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4962: 
 4963:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4964:          // and at the bottom of the layer.
 4965:          const double vmag_top = length(ub2_top);
 4966:          const double vmag_bot = length(node->u2[k-1]);
 4967: 
 4968:          // Volume-averaged velocity cubed.
 4969:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4970: 
 4971:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4972:          // and at the bottom of the layer.
 4973:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4974:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4975: 
 4976:          // Volume-averaged vegetation alpha cubed.
 4977:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4978: 
 4979:          return veg_alpha3D*vmag3;
 4980:       } 
 4981:       else {
 4982:          // The current level is not within the vegetation layer, so the production is 0.
 4983:          return 0.0;
 4984:       }
 4985:    } else {
 4986: 
 4987:       // If no vegetation, the production is 0.
 4988:       return 0.0;
 4989:    }
 4990: 
 4991: }
 4992: 
 4993: 
 4994: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 4995:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 4996:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 4997: 
 4998:    const int kb = node->kb;
 4999: 
 5000:    for (int k = kb; k < nvrt; k++) {
 5001:       const double tke = this->tke[k];
 5002:       const double mxl = this->mxl[k];
 5003:       const double u = sqrt(tke);  // Characteristic velocity
 5004:       const double lu = mxl*u;     // Characteristic diffusivity 
 5005: 
 5006:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 5007:       double drho_dz = 0.0;
 5008:       if (k > kb && k < ivrt) {
 5009:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 5010:       }
 5011: 
 5012:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 5013: 
 5014:       // Tsinghua group       
 5015:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 5016: 
 5017:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 5018:       if constexpr (stabilityModel == Galperin) {
 5019:          sh = 0.49393/(1.0-34.676*Gh);
 5020:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 5021:          cmiu  = sqrt(2.0)*sm;
 5022:          cmiup = sqrt(2.0)*sh;
 5023:          cmiu1 = sqrt(2.0)*0.2;
 5024:          cmiu2 = sqrt(2.0)*0.2;
 5025: 
 5026:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 5027:          // Warner's paper has problem
 5028:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 5029:          const double Ghp = Gh;  /// XXXXX needed?
 5030:          sh = 0.4939/(1.0 - 30.19*Ghp);
 5031:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 5032:          cmiu  = sqrt(2.0)*sm;
 5033:          cmiup = sqrt(2.0)*sh;
 5034:          cmiu1 = cmiu/schk();
 5035:          cmiu2 = cmiu/schpsi();
 5036: 
 5037:       } else {
 5038:          assert(false && "Unknown ASM");
 5039: 
 5040:       }
 5041: 
 5042:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 5043:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 5044:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 5045:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 5046:    }
 5047: }
 5048: 
 5049: 
 5050: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 5051: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 5052: 
 5053:    const double z = node->z[k];
 5054:    const double eta2 = node->eta2;
 5055:    const double depth = node->depth;
 5056: 
 5057:    // Distances to the surface and bottom
 5058:    const double dist_s = eta2 - z;
 5059:    const double dist_b = z + depth;
 5060: 
 5061:    // Distance to the closest "wall" (either surface or bottom).  
 5062:    // In the top layer, it is the size of the layer.
 5063:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 5064:    assert(min_dist > 0.0 && "Invalid minimum distance");
 5065: 
 5066:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 5067:    return kappa*min_dist;
 5068: }
 5069: 
 5070: 
 5071: 
 5072: template<TurbulenceModel turbulenceModel>
 5073: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 5074: 
 5075: 
 5076: template<>
 5077: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 5078:    // Constant turbulence model
 5079:    // Does nothing since dfv and dfh are already set  in the initialization.
 5080: }
 5081: 
 5082: template<>
 5083: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 5084:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 5085: 
 5086:    // Solves the following PDEs:
 5087:    //
 5088:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 5089:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 5090:    //
 5091:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 5092:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 5093:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 5094:    //
 5095:    // The equations are solved using a linear *vertical* FEM formulation.
 5096:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 5097:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 5098:    
 5099:    
 5100:    // Get the turbulence model
 5101:    // reinterpret_cast is used to avoid stupid compiler errors.
 5102:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 5103:      
 5104:    const int kb = node->kb;
 5105:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 5106: 
 5107:    double alow_tke[nvrt], alow_phi[nvrt];
 5108:    double bdia_tke[nvrt], bdia_phi[nvrt];
 5109:    double cupp_tke[nvrt], cupp_phi[nvrt];
 5110:    double rhs_tke [nvrt], rhs_phi [nvrt];
 5111:    
 5112:    // Initialize the tridiagonal system
 5113:    for (int kin = 0; kin < nqrows; kin++) {
 5114:       alow_tke[kin]=0.0;
 5115:       bdia_tke[kin]=0.0;
 5116:       cupp_tke[kin]=0.0;
 5117:       rhs_tke [kin]=0.0; 
 5118:       alow_phi[kin]=0.0;
 5119:       bdia_phi[kin]=0.0;
 5120:       cupp_phi[kin]=0.0;
 5121:       rhs_phi [kin]=0.0; 
 5122:    }
 5123: 
 5124: 
 5125: 
 5126:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 5127:    if (node->isDry || node->is2D()) {
 5128: 
 5129:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 5130:       const double diffmin = turb.diffmin;
 5131: 
 5132:       for (int k = 0; k < nvrt; k++) {
 5133:          turb.tke[k]    = turb.tkemin();
 5134:          turb.mxl[k]    = turb.mxlmin(node->depth);
 5135:          node->dfv[k]   = diffmin;
 5136:          node->dfh[k]   = diffmin;
 5137:          turb.nu_tke[k] = diffmin;
 5138:          turb.nu_phi[k] = diffmin;
 5139:       }
 5140: 
 5141:       return;
 5142:    }
 5143: 
 5144:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 5145:    
 5146:    // After here we know that the node is wet and has at least 2 layers.
 5147: 
 5148:    double solution[nvrt], gam[nvrt];
 5149:    
 5150:    const double eta2       = node->eta2;
 5151:    const double depth      = node->depth;
 5152:    const double Cd         = node->Cd; // Drag coefficient
 5153: 
 5154:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 5155:    
 5156:    const double sqU2 = norm2(node->u2[kb + 1]);
 5157:    const double modTau = length(node->tau);
 5158: 
 5159:  
 5160: 
 5161:    const double cpsi1 = turb.cpsi1();
 5162:    const double cpsi2 = turb.cpsi2();
 5163:    // cpsi3 is computed later because it depends on k
 5164: 
 5165: 
 5166:    // Assemble the tridiagonal system
 5167:    // -------------------------------
 5168: 
 5169:    // Loop over each vertical layer (interval between two vertical levels)
 5170:    // Each interval is an element of the vertical FEM formulation.
 5171:    // Two shape functions are defined over each interval. In this function we well call them
 5172:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5173:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5174:    //
 5175:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5176:    // Both systems of equations are assembled in the same loop.
 5177:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5178: 
 5179:       // Indices for the *rows* of the tridiagonal system.
 5180:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5181:       const int k2 = k - kb;     // One at k = kb + 1
 5182: 
 5183:       // Get the properties of the current interval.
 5184:       const double z  = node->z[k]; // bottom level of the interval
 5185:       const double dz = node->Dz(k + 1);
 5186:       
 5187:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5188: 
 5189:       // Turbulence production/dissipation terms (at the center of the interval).
 5190:       
 5191:       const double M2 = norm2(du_dz_c);              // Shear production term
 5192: 
 5193:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5194: 
 5195:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5196: 
 5197:       const double cpsi3 = turb.cpsi3(N2); 
 5198: 
 5199: 
 5200:       // Turbulence quantities at half levels (cell [c]enter)
 5201:       const double tke_1     = turb.tke[k];
 5202:       const double tke_2     = turb.tke[k+1];
 5203:       const double mxl_1     = turb.mxl[k];
 5204:       const double mxl_2     = turb.mxl[k+1];
 5205:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5206:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5207:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5208:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5209:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5210:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5211:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5212: 
 5213:       // Integral of the shape function products:
 5214:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5215:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5216:       const double p1p1 = dz/3.0;
 5217:       const double p1p2 = dz/6.0;
 5218:       const double d1d1 =  1.0/dz;
 5219:       const double d1d2 = -1.0/dz;
 5220: 
 5221:       // Production/dissipation related terms
 5222:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5223:       const double buoy = dfh_c*N2;
 5224:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5225: 
 5226: 
 5227: 
 5228:       // Equation for tke
 5229:       // ---------------
 5230: 
 5231:       // First row (of the two rows that the interval contributes to)
 5232:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5233:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5234:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5235: 
 5236: 
 5237:       if(prod + buoy >= 0.0) { // Net production
 5238:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5239:       } else { // Net dissipation
 5240:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5241:          bdia_tke[k1] -= 2.0*tmp;
 5242:          cupp_tke[k1] -= tmp;
 5243:       }      
 5244:       
 5245:       bdia_tke[k1] += 2.0*dt*diss;
 5246:       cupp_tke[k1] += dt*diss;
 5247:       
 5248:   
 5249:       // Second row (of the two rows that the interval contributes to)
 5250:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5251:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5252:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5253: 
 5254:       if (prod + buoy >= 0.0) { // Net production
 5255:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5256:       } else { // Net dissipation
 5257:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5258:          bdia_tke[k2] -= 2.0*tmp;
 5259:          alow_tke[k2] -= tmp;
 5260:       }
 5261:       
 5262:       bdia_tke[k2] += 2.0*dt*diss;
 5263:       alow_tke[k2] += dt*diss;
 5264: 
 5265: 
 5266:       // Equation for xl
 5267:       // ---------------
 5268: 
 5269:       const double rpub = turb.rpub();
 5270:       const double rmub = turb.rmub();
 5271:       const double rnub = turb.rnub();
 5272:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5273:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5274:       const double psi_c = 0.5*(psi_1 + psi_2);
 5275: 
 5276:       // Production/dissipation related terms
 5277:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5278:       const double buoy_phi = cpsi3*dfh_c*N2;
 5279:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5280: 
 5281:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5282:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5283:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5284: 
 5285:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5286:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5287:       } else { // Net dissipation
 5288:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5289:          bdia_phi[k1] -= 2.0*tmp;
 5290:          cupp_phi[k1] -= tmp;
 5291:       }
 5292: 
 5293:       // Production/dissipation terms
 5294:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5295:       cupp_phi[k1] += dt*diss_phi;
 5296:  
 5297: 
 5298:       // row k2 (upper)
 5299:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5300:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5301:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5302: 
 5303:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5304:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5305:       } else { // Net dissipation
 5306:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5307:          bdia_phi[k2] -= 2.0*tmp;
 5308:          alow_phi[k2] -= tmp;
 5309:       }
 5310: 
 5311:       // Production/dissipation terms
 5312:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5313:       alow_phi[k2] += dt*diss_phi;
 5314: 
 5315:    }
 5316: 
 5317:    // BC
 5318:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5319:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5320: 
 5321: 
 5322:    // Solves for tke.
 5323:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5324: 
 5325: 
 5326:    // B.C. (computed using values from previous time except wind)
 5327:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5328:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5329: 
 5330: 
 5331:    // Update TKE.
 5332:    turb.tke[kb]     = tkebot;
 5333:    turb.tke[kb + 1] = tkebot;
 5334:    turb.tke[ivrt]   = tkesrf;
 5335:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5336:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5337: // printf("tke[%d]: %f, solution[%d]: %f\n", k, turb.tke[k], kin, solution[kin]);   
 5338:    }
 5339: 
 5340: 
 5341: 
 5342:  
 5343:    // Solves for phi.
 5344:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5345: 
 5346: 
 5347:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5348:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5349:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5350: 
 5351:    turb.mxl[kb+1] = mxlbot;
 5352:    turb.mxl[ivrt] = mxlsrf;
 5353:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5354:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5355: 
 5356:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5357: 
 5358:       // Galperin's clipping
 5359:       if (N2 < 0.0) {
 5360:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5361:          turb.mxl[k] = min(turb.mxl[k], upper);
 5362:       }   
 5363: 
 5364: 
 5365: 
 5366:       // Max. mixing length based on dissipation; mxlmin prevails
 5367:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5368: 
 5369:       // Combined max. mixing length including geometric limit
 5370:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5371: 
 5372:       // Clamp the mixing length between the minimum and maximum values
 5373:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5374: 
 5375:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5376: 
 5377: 
 5378:    } // for k
 5379: 
 5380: 
 5381:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5382:    turb.tke[kb] = turb.tke[kb + 1];
 5383:    turb.mxl[kb] = turb.mxl[kb + 1];
 5384: 
 5385: 
 5386:    // Compute vertical diffusivities at new time
 5387:    turb.computeDiffusivities(node);
 5388: 
 5389:    // make all the variables uniform below the bottom level kb
 5390:    for (int k = 0; k < kb; k++) {
 5391:       node->dfv[k] = node->dfv[kb];
 5392:       node->dfh[k] = node->dfh[kb];
 5393:       turb.tke[k] = turb.tke[kb];
 5394:       turb.mxl[k] = turb.mxl[kb];
 5395:       turb.nu_tke[k] = turb.nu_tke[kb];
 5396:       turb.nu_phi[k] = turb.nu_phi[kb];
 5397:    }
 5398: 
 5399:       
 5400: 
 5401: }
 5402: 
 5403: 
 5404: 
 5405: 
 5406: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5407:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5408:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5409: 
 5410: 
 5411:    NODE(node1);
 5412: 
 5413:    node1->clearMatrixRow();
 5414:    node1->qel = 0.0;
 5415: 
 5416:    // THIS IS FOR STRUCTURES XXX
 5417:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5418: 
 5419:    
 5420:    for (int j=0; j<node1->numElements; j++) {
 5421:       // For each element connected to the node...
 5422: 
 5423:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5424: 
 5425:       Element *elem = node1->elements[j];
 5426: 
 5427:       // Compute the average gravity
 5428:       const double grav3 = elem->mean(&Node::grav2);
 5429: 
 5430:       // Look at the documentation for the description of the terms in the following integrals
 5431: 
 5432:       // Integral I_1 
 5433:       // \bar{\breve{H}} 
 5434:       const double hhatb = elem->mean(&Side::hhat);        
 5435: 
 5436:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5437: 
 5438:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5439:       const double area = elem->area;
 5440: 
 5441:       // Integral I_4
 5442:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5443:       // Where
 5444:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5445: 
 5446:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5447:       // of U over the element.
 5448:       const Vector2 U = elem->mean(&Side::U);
 5449: 
 5450:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5451: 
 5452:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5453:       const double I_4_1 = dot(gradPhi_1, U);
 5454: 
 5455: 
 5456:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5457:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5458: 
 5459:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5460: 
 5461: 
 5462:       // Normal component of the bed velocity
 5463:       double ubedNormalComp = 0.0;
 5464:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5465:          Vector3 ubed = {0.0, 0.0, 0.0};
 5466:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5467:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5468: 
 5469:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5470:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5471:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5472: 
 5473:          // Computes the normal component of the bed velocity
 5474:          ubedNormalComp = dot(ubed, N);
 5475:       } // imm==2
 5476: 
 5477:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5478: 
 5479:       if (elem->isTri()) {
 5480: 
 5481:          // To clarify the notation in this section: 
 5482:          //   In formulas, we use the following notation:
 5483:          //       i stands for the node under consideration (node1)
 5484:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5485:          //   However, in the code, we use the following notation:
 5486:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5487:          const int id2 = elem->nxq(1 + id1);
 5488:          const int id3 = elem->nxq(2 + id1);
 5489:          Node *node2 = elem->nodes[id2];
 5490:          Node *node3 = elem->nodes[id3];
 5491: 
 5492:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5493: 
 5494:          // integral of phi_i*phi_j
 5495:          const double ipp_ii = (1.0/6.0 )*area;
 5496:          const double ipp_ij = (1.0/12.0)*area;
 5497:          const double ipp_ik = (1.0/12.0)*area;
 5498: 
 5499:          // integral of [(grad phi_i) * (grad phi_j)]
 5500:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5501:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5502:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5503: 
 5504:          // Computes the different components of integral I_1 of each node with respect to node i.
 5505:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5506:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5507:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5508: 
 5509:          node1->addToSparseMatrix(node1, I1_ii);
 5510:          node1->addToSparseMatrix(node2, I1_ij); 
 5511:          node1->addToSparseMatrix(node3, I1_ik);
 5512: 
 5513:          #pragma unroll
 5514:          for (int l=0; l<3; l++) {
 5515: 
 5516:             Node *node = elem->nodes[l];
 5517: 
 5518:             // Additional variation in eta due to bed deformation or vertical velocity
 5519:             double extraEta = 0.0;
 5520:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5521:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5522: 
 5523: 
 5524:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5525:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5526: 
 5527:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5528: 
 5529:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5530:            
 5531:          }
 5532: 
 5533: 
 5534:       }
 5535:       else { // Quad
 5536:          // To clarify the notation in this section: 
 5537:          //   In formulas, we use the following notation:
 5538:          //       i stands for the node under consideration (node1)
 5539:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5540:          //   However, in the code, we use the following notation:
 5541:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5542:          const int id2 = elem->nxq(1 + id1);
 5543:          const int id3 = elem->nxq(2 + id1);
 5544:          const int id4 = elem->nxq(3 + id1);
 5545:          Node *node2 = elem->nodes[id2];
 5546:          Node *node3 = elem->nodes[id3];
 5547:          Node *node4 = elem->nodes[id4];   
 5548:          
 5549:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5550: 
 5551:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5552:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5553:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5554:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5555:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5556: 
 5557:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5558:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5559:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5560:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5561:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5562: 
 5563: 
 5564:          // Computes the different components of integral I_1 of each node with respect to node i.
 5565:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5566:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5567:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5568:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5569: 
 5570:          node1->addToSparseMatrix(node1, I1_ii);
 5571:          node1->addToSparseMatrix(node2, I1_ij); 
 5572:          node1->addToSparseMatrix(node3, I1_ik);
 5573:          node1->addToSparseMatrix(node4, I1_il);
 5574:   
 5575:          #pragma unroll
 5576:          for (int l=0; l<4; l++) {
 5577: 
 5578:             const Node *node = elem->nodes[l];
 5579: 
 5580:             // Additional variation in eta due to bed deformation or vertical velocity
 5581:             double extraEta = 0.0;
 5582:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5583:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5584: 
 5585:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5586:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5587:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5588: 
 5589:          }         
 5590:       } 
 5591: 
 5592: 
 5593:      node1->qel += (dt/elem->i34)*elem->vsource;
 5594:       
 5595: 
 5596:    } // for all elements connected to the node
 5597:    
 5598: 
 5599:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5600:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5601:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5602:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5603:    // If it is an open boundary node...
 5604: 
 5605:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5606: 
 5607:       // At least one open bnd side, maybe two
 5608:       for (int l=0; l<2; l++) { 
 5609: 
 5610:          // Gets each of the sides sharing the node. 
 5611:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5612: 
 5613:     
 5614: 
 5615:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5616:          if (sideBnd != nullptr) {
 5617:             // If the side is on a boundary...
 5618: 
 5619:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5620: 
 5621:             // Get the boundary segment
 5622:             const BoundarySegment *sideSegment = sideBnd->segment;
 5623:             const Side *side = sideBnd->side;
 5624: 
 5625:             // Integral I_3
 5626:             if (sideSegment->ifltype != 0) {
 5627:             // Natural or Flather b.c.
 5628: 
 5629:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5630:                // especially for Flather b.c.
 5631:                double ri3 = 0.0;
 5632:                if (!side->isDry) {
 5633:                   // If the side is not dry
 5634:                   
 5635:                   // Computes the side flux of (uth, vth)
 5636:                   double Vn = 0.0;
 5637:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5638:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5639:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5640: 
 5641:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5642:                   }
 5643: 
 5644:                   ri3 = 0.5*side->len*Vn;
 5645:                }
 5646: 
 5647:                if (sideSegment->ifltype == -1) { // Flather 1
 5648: 
 5649:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5650:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5651: 
 5652:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5653:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5654:                   
 5655:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5656:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5657: 
 5658:                } 
 5659:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5660:                   // Reset ri3
 5661:                   ri3 = 0.0;
 5662: 
 5663:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5664:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5665: 
 5666:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5667: 
 5668:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5669:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5670: 
 5671:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5672:                   node1->addToSparseMatrix(node1, con0*2.0);
 5673:                   node1->addToSparseMatrix(node2, con0);
 5674: 
 5675:                } // if Flather or Discharge
 5676: 
 5677:                node1->qel -= thetai*dt*ri3;  
 5678: 
 5679: 
 5680:             } // I_3
 5681:           
 5682: 
 5683:             // Integral I_5
 5684:             if(!side->isDry) {
 5685: 
 5686:                const double Unbar = dot(side->U, side->n);
 5687:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5688: 
 5689:             } // I_5
 5690: 
 5691:          } // if is boundary side
 5692: 
 5693:       } // for l
 5694: 
 5695:    } // if isbnd
 5696: 
 5697: 
 5698: }
 5699: 
 5700: 
 5701: 
 5702: extern "C" {
 5703: 
 5704:    __global__ void gatherBFromMesh(double* b) {
 5705:       // b[local] <- qel  (local = idx_node on this device)
 5706:       NODE(node);
 5707:       b[idx_node] = node->qel;
 5708:    }
 5709: 
 5710:    
 5711:    __global__ void scatterXToMesh(double* x) {
 5712:       // mX <- x[local]
 5713:       NODE(node);
 5714:       node->mX = x[idx_node];
 5715:    }
 5716: 
 5717:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 5718:                                  int* indices, int* indptr) {
 5719:       // XXXXXXXXXXXX REMOVE!!!
 5720:       assert(false && "setupCGSolver has beed deprecated");
 5721: 
 5722:       // NODE(node);
 5723:       
 5724:       // const int idx = node->idx;
 5725:       
 5726:       // // Computes the index in the nzz array      
 5727:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 5728: 
 5729: 
 5730:       // indptr[idx] = nzzIdx;
 5731:       // indices[nzzIdx] = idx;
 5732: 
 5733:       // data_d[nzzIdx]    = node->coeffDiag;
 5734: 
