 1875: // Convenience macros for accessing the objects in kernels.
 1876: 
 1877: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1878:                    Side *side = &(mesh->localSideData[idx_side]); \
 1879:                    if (idx_side >= mesh->ns) return;
 1880: 
 1881: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1882:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1883:                    if (idx_elem >= mesh->ne) return;
 1884: 
 1885: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1886:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1887:                    if (idx_node >= mesh->np) return;
 1888: 
 1889: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1890:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1891:                               const bool valid = (idx_node < mesh->np);                   
 1892: 
 1893: 
 1894: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1895:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1896:                            if (idx_node_bnd >= mesh->nbp) return;
 1897: 
 1898: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1899:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1900:                            if (idx_side_bnd >= mesh->nbs) return;                           
