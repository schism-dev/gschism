 7601: __global__ void getStructSizes(int* sizes)  {
 7602:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7603:       sizes[0] = (int)sizeof(Node);
 7604:       sizes[1] = (int)sizeof(Element);
 7605:       sizes[2] = (int)sizeof(Side);
 7606:       sizes[3] = (int)sizeof(NodeBoundary);
 7607:       sizes[4] = (int)sizeof(SideBoundary);
 7608:       sizes[5] = (int)sizeof(BoundarySegment);
 7609: }
