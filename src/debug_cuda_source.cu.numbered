 7931:          break;            
 7932:       case (int)VarCode::w:
 7933:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7934:          *sizeType = sizeof(double);
 7935:          break;
 7936:       case (int)VarCode::u:
 7937:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7938:          *sizeType = sizeof(Vector2);
 7939:          break;   
 7940:       case (int)VarCode::n1:
 7941:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7942:          *sizeType = sizeof(Node);
 7943:          break;
 7944:       case (int)VarCode::n2:
 7945:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7946:          *sizeType = sizeof(Node);
 7947:          break;                   
 7948:       default:
 7949:          *offset = -1;
 7950:    }
 7951: }
