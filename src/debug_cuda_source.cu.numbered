 7069: 
 7070:    __global__ void computeVerticalVelocity(void) {
 7071:       // Computes the vertical velocity at the (2D) element's centroid.
 7072:       // In this function we will be considering volumetric elements, with side faces and a 
 7073:       // bottom and a top face. We will call them SFs, BF and TF.
 7074:       // It computes the flux coming from BF and the SFs.
 7075:       // If the bed is moving, it takes that into account.
 7076:       // Since water is incompressible, the integral of the velocity times the normal vector
 7077:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7078:       // and the BF is equal to the flux going out from the TF.
 7079:       // TF = - BF - sum(SFs).
 7080:       // It then computes the horizontal velocity at the center of TF.
 7081:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7082:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7083:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7084: 
 7085:       ELEM(elem);
 7086: 
 7087:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7088: 
 7089:       if (elem->isDry) return;
 7090: 
 7091:       const int kb = elem->kb;
 7092:       const bool isTri = elem->isTri();
 7093: 
 7094:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7095: 
 7096:       // Compute the bottom velocity
 7097:       if constexpr(imm != 0) {
 7098:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7099:       }
 7100: 
 7101: 
 7102:       double bottomArea3D;
 7103:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7104: 
 7105:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7106: 
 7107:       double topArea3D;
 7108: 
 7109:       // Bottom face flux
 7110:       double bottomFlux = 0.0;
 7111:       Vector2 u2meanBottom = {0.0, 0.0};
 7112:       const Vector2 gradh = elem->grad2(&Node::depth);
 7113:       if constexpr(imm==2) {
 7114:          Vector3 ubed;
 7115: 
 7116:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7117:          // updateBDEF(ubed);
 7118:      
 7119:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7120: 
 7121:          // elem->w[kb] += ubed.z;
 7122:       }
 7123:       else {
 7124: 
 7125:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7126:   
 7127:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7128:          // in the direction of motion.
 7129:          const double bottomW = - dot(gradh, u2meanBottom);  
 7130:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7131: 
 7132:          // VElocity associated to the bed deformation
 7133:          double bedVelocity = 0.0;
 7134:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7135: 
 7136:          elem->w[kb] = bedVelocity + bottomW; 
 7137: 
 7138:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7139:          
 7140:       } // if imm
 7141: 
 7142:       // Compute w for kb+1 to nvrt-1
 7143:       for (int l = kb; l < nvrt - 1; l++) {
 7144: 
 7145:          // normal vector to the top face of the "volumetric" element (3D)
 7146:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7147: 
 7148:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7149:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7150: 
 7151:          // Compute the total flux at the sides
 7152:          double sideFlux = 0.0;
 7153: 
 7154:          for (int j = 0; j < elem->i34; j++) {
 7155:             const Side *side = elem->sides[j];
 7156:             const int kbs = side->kb;
 7157:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7158:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7159:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7160: 
 7161:             // The area is "clamped" meaning that it takes kb into account.
 7162:             const double sideArea = side->areaClamped(l);
 7163: 
 7164:             const double sign = elem->ssign[j]; 
 7165: 
 7166:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7167:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7168:          }
 7169:          
 7170:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7171:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7172:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7173: 
 7174:          // The flux at the top ace can be computed from the other flows.
 7175:          // All fluxes are in directions into the prism.
 7176:          const double topFlux = - sideFlux - bottomFlux;
 7177: 
 7178:          // Flux at the top face due to the horizontal velocities only
 7179:          // topFlux = topHorizontalFlux + topVerticalFlux
 7180:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7181: 
 7182:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7183:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7184: 
 7185:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7186: 
 7187:          bottomFlux = -topFlux;
 7188:          
 7189:       }
 7190: 
 7191:    }  
 7192: 
 7193: 
 7194: 
 7195: 
 7196: 
 7197: 
 7198: 
