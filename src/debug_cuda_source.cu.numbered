 7679:                                  
 7680:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7681:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7682:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7683:                    int *isdel, int *isidenode, int *isbnd,
 7684:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7685:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7686:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7687:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7688:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7689:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7690:                    double *drag, double *roughness,
 7691:                    double *emo, double *efa, 
 7692:                    double *umo, double *ufa, 
 7693:                    double *vmo, double *vfa) {
 7694: 
 7695:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7696:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 7697:                        isdel, isidenode, isbnd,
 7698:                        nond, nlnd, iond, ilnd, 
 7699:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7700:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7701:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7702:                        localNodeIndices, localElemIndices, localSideIndices,
 7703:                        localNodePart, localElemPart, localSidePart,
 7704:                        drag, roughness,
 7705:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 7706:   }
