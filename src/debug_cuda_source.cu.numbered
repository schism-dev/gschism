 3383: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3384:    if constexpr(ics == 1) {
 3385:       return center;
 3386: 
 3387:    } else {
 3388:       const Point2 p0 = n1->outputCoords();
 3389:       const Point2 p1 = n2->outputCoords();
 3390:       return (1.0/2.0)*(p0 + p1);
 3391: 
 3392:    }
 3393: }
