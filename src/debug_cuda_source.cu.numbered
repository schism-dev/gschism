 7992: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7993:    Element *elems = mesh->localElemData;
 7994: 
 7995:    *addr = elems;
 7996:    *sizeElement = sizeof(Element);
 7997:    switch (varCode) {
 7998:       case (int)VarCode::z:
 7999:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8000:          *sizeType = sizeof(double);
 8001:          break;
 8002:       case (int)VarCode::x:
 8003:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8004:          *sizeType = sizeof(Vector2);
 8005:          break;
 8006:       case (int)VarCode::area:
 8007:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8008:          *sizeType = sizeof(double);
 8009:          break;
 8010:       case (int)VarCode::depth:
 8011:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8012:          *sizeType = sizeof(double);
 8013:          break;
 8014:       case (int)VarCode::radius:
 8015:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8016:          *sizeType = sizeof(double);
 8017:          break;
 8018:       case (int)VarCode::ghat:
 8019:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8020:          *sizeType = sizeof(Vector2);
 8021:          break;
 8022:       case (int)VarCode::kb:
 8023:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8024:          *sizeType = sizeof(int);
 8025:          break;
 8026:       case (int)VarCode::isdry:
 8027:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8028:          *sizeType = sizeof(int);
 8029:          break;            
 8030:       case (int)VarCode::w:
 8031:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8032:          *sizeType = sizeof(double);
 8033:          break;
 8034:       case (int)VarCode::FaceIndices:
 8035:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8036:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8037:          *sizeType = sizeof(Node);
 8038:          break;
 8039:       default:
 8040:          *offset = -1;
 8041:    }
 8042: }
