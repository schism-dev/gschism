 2075:    template<typename T>
 2076:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2077:       // Get the values of the field at the nodes of the element
 2078:       res[0] = nodes[0]->*field;
 2079:       res[1] = nodes[1]->*field;
 2080:       res[2] = nodes[2]->*field;
 2081:       if (isQuad()) res[3] = nodes[3]->*field;
 2082:       else          res[3] = T();
 2083:    }
 2084: 
 2085:    template<typename T>
 2086:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2087: 
 2088:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2089:       // Get the values of the field at the nodes of the element
 2090:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2091:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2092:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2093:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2094:       else          res[3] = T();
 2095:    }    
