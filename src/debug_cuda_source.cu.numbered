 5604: 
 5605: 
 5606:    __global__ void backtrackAllNodes(void) {
 5607: 
 5608:       // max/min # of sub-divisions
 5609:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5610:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5611: 
 5612:       SIDE(side);
 5613: 
 5614:       const int kb = side->kb;
 5615: 
 5616: 
 5617:       // Initialize btrack velocities to the actual velocities at the side 
 5618:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5619:   
 5620:       if (side->isDry) return;
 5621:      
 5622: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5623: 
 5624:       // Checks that at least one element is not dry
 5625:       const Element *elem1 = side->elems[0];
 5626:       const Element *elem2 = side->elems[1];
 5627: 
 5628: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5629: 
 5630:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5631:       
 5632:       // XXXXXX
 5633:       // !swild_tmp to store global coord. of the starting side
 5634:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5635:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5636:       // !Use sframe2 
 5637:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5638: 
 5639: 
 5640:       for (int k = kb; k < nvrt; k++) {
 5641:       //  For ics=2, the coordinates are all in the side's local frame
 5642: 
 5643:          const int iadvf = side->iadv();  // Advection flag   
 5644:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5645: 
 5646:          const double vmag2 = norm2(side->u2[k]);
 5647: 
 5648:          if (vmag2 <= velmin_btrack_sq) {  
 5649:             // No activity 
 5650: 
 5651:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5652:             
 5653:          } else {  // do btrack
 5654: 
 5655:             // Compute number of sub-divisions based on local gradients of the velocity field
 5656: 
 5657:             // XXX IS THIS NECESSARY?
 5658:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5659:             double suma = 0.0;
 5660:             int icount = 0;
 5661:             #pragma unroll
 5662:             for (int l=0; l<2; l++) {
 5663:             // For each element sharing the side...
 5664: 
 5665:                const Element *elem = side->elems[l];
 5666:                  
 5667:                if (elem == nullptr) continue;
 5668: 
 5669:                icount++;
 5670: 
 5671:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5672:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5673:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5674: 
 5675:                double utmp[4];
 5676:                double vtmp[4];
 5677:                #pragma unroll
 5678:                for (int j = 0; j < elem->i34; j++) {
 5679: 
 5680:                   const Node *node = elem->nodes[j];
 5681: 
 5682:                   if constexpr(ics==1) {
 5683:                      utmp[j] = node->u2[k].x;
 5684:                      vtmp[j] = node->u2[k].y;  
 5685: 
 5686:                   } else {
 5687:                      // 'Project' the velocity from the node frame to the element frame
 5688:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5689:                      utmp[j] = tmp_u2.x;
 5690:                      vtmp[j] = tmp_u2.y;
 5691: 
 5692:                   }
 5693:                } // for j
 5694: 
 5695:                const Vector2 grad_u = elem->grad2(utmp); 
 5696:                const Vector2 grad_v = elem->grad2(vtmp);
 5697:    
 5698:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5699:             } // for l
 5700: 
 5701:             assert(icount > 0 && "Impossible 77");
 5702: 
 5703:             // '4' is somewhat arbitrary
 5704:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5705: 
 5706:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5707:             Vector3 u_int = {0.0, 0.0, 0.0};
 5708: 
 5709:             side->btrack(k, dt, dtbk, u_int);
 5710: 
 5711: 
 5712:             side->btu[k] = {u_int.x, u_int.y};
 5713:                
 5714:          } // if vmag (do backtrack)
 5715: 
 5716: 
 5717:       } // for k=kb,nvrt-1
 5718: 
 5719:    }
 5720: 
 5721: } // extern "C"
 5722: 
 5723: template<int nc>
 5724: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5725: 
 5726: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5727: //
 5728: // Although this is a general function, it is used only for equations on vertical levels.
 5729: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5730: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5731: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5732: //
 5733: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5734: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5735: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5736: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5737: 
 5738:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5739:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5740: 
 5741:    double bet = b[0];
 5742:    if constexpr (nc == 1) {
 5743:       u[0] = rhs[0]/bet;
 5744:    } else {
 5745:       #pragma unroll
 5746:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5747:    }
 5748: 
 5749:    for (int j = 1; j < n; j++) {
 5750:       gam[j] = c[j - 1]/bet;
 5751:       bet = b[j] - a[j]*gam[j];
 5752: 
 5753:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5754: 
 5755:       if constexpr (nc == 1) {
 5756:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5757:       } else {
 5758:          #pragma unroll
 5759:          for (int l = 0; l < nc; l++) {
 5760:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5761:          }
 5762:       }
 5763:    }
 5764: 
 5765:    // Back-substitution
 5766:    for (int j = n - 2; j >= 0; j--) {
 5767:       if constexpr (nc == 1) {
 5768:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5769:       } else {
 5770:          for (int l = 0; l < nc; l++) {
 5771:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5772:          }
 5773:       }
 5774:    }
 5775: }
 5776: 
 5777: 
 5778: 
 5779: // Helper function that contains the core algorithm
 5780: template<typename XAccessor, typename YAccessor>
 5781: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5782:                                     double  yp_top, double  yp_bot, 
 5783:                                     CubicSpline &spline) {
 5784:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5785:    // 
 5786:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5787:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5788:    //
 5789:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5790:    // 
 5791:    // Inputs: 
 5792:    //            n: dimension for x etc; # of data pts (>=2);
 5793:    //            getX, getY: functions to access x,y coordinates
 5794:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5795:    //     Output: 
 5796:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5797: 
 5798:    const int n = k2 - k1 + 1;
 5799:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5800: 
 5801:    // Allocate memory for the splines
 5802:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5803:    spline.x   = new double[n];
 5804:    spline.y   = new double[n];
 5805:    spline.yp  = new double[n];
 5806:    spline.ypp = new double[n];
 5807: 
 5808:    for (int k=k1; k<=k2; k++) {
 5809:       spline.x[k] = getX(k);
 5810:       spline.y[k] = getY(k);
 5811:    }
 5812: 
 5813:    // This is to simplify expressions later
 5814:    double *x = spline.x;
 5815:    double *y = spline.y;
 5816: 
 5817:    double *a = nullptr;
 5818:    double *b = nullptr;
 5819:    double *c = nullptr;
 5820:    double *gam = nullptr;
 5821:    double *rhs = nullptr;
 5822:    
 5823: 
 5824:       a = new double[n];   // Lower diagonal
 5825:       b = new double[n];   // Diagonal
 5826:       c = new double[n];   // Upper diagonal
 5827:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5828:       rhs = new double[n]; // Right-hand side
 5829: 
 5830:    for (int k=k1; k<=k2; k++) {
 5831:       if (k == k1) {
 5832:          // Bottom level
 5833:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5834:          b[k] = (x[k+1] - x[k])/3.0;
 5835:          c[k] = b[k]/2.0;
 5836:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5837:       } else if (k == n - 1) {
 5838:          // Top level (surface)
 5839:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5840:          b[k] = (x[k] - x[k-1])/3.0;
 5841:          a[k] = b[k]/2.0;
 5842:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5843:       } else {
 5844:          // Intermediate levels
 5845:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5846:          b[k] = (x[k+1] - x[k-1])/3.0;
 5847:          a[k] = (x[k  ] - x[k-1])/6.0;
 5848:          c[k] = (x[k+1] - x[k  ])/6.0;
 5849:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5850:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5851:       }
 5852:    }
 5853: 
 5854:    // Solve the tridiagonal system
 5855:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5856:    
 5857:    spline.yp[k1] = yp_bot;
 5858:    spline.yp[k2] = yp_top;
 5859: 
 5860:    // Compute rest of 1st derivatives using the splines
 5861:    for (int k=k1+1; k<k2; k++) {
 5862:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5863:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5864:    }
 5865:    
 5866:    delete[] a;
 5867:    delete[] b;
 5868:    delete[] c;
 5869:    delete[] gam;
 5870:    delete[] rhs;
 5871: 
 5872: }
 5873: 
 5874: // Array version
 5875: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5876:                                 double y_top, double y_bot, 
 5877:                                 CubicSpline &spline) {
 5878:    auto getX = [x] (int k) { return x[k]; };
 5879:    auto getY = [y] (int k) { return y[k]; };
 5880:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5881: }
 5882: 
 5883: // Lambda version - allows custom access patterns
 5884: template<typename XFunc, typename YFunc>
 5885: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5886:                                 double y_top, double y_bot,
 5887:                                 CubicSpline &spline) {
 5888:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5889: }
 5890: 
 5891: 
 5892: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 5893: {
 5894:    assert("Not implemented");
 5895: 
 5896:    return 0.0;
 5897: }
