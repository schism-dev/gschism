  653:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  654: 
  655:    // ------------------------------------------------------------------------------------------------
  656:    // These are functions that work on all nodes of the element.
  657:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  658:    //
  659:    // An example of how to use these functions is:
  660:    //   
  661:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  662:    // 
  663:    // Where L is the level at which the field is to be interpolated. The field can be either
  664:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  665:    // There are different versions of getNodalValues for each of these cases.
  666: 
  667:    template<typename T>
  668:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  669:       // Get the values of the field at the nodes of the element
  670:       res[0] = nodes[0]->*field;
  671:       res[1] = nodes[1]->*field;
  672:       res[2] = nodes[2]->*field;
  673:       if (isQuad()) res[3] = nodes[3]->*field;
  674:       else          res[3] = T();
  675:    }
  676: 
  677:    template<typename T>
  678:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  679:       // Get the values of the field at the nodes of the element
  680:       res[0] = (nodes[0]->*field)[level];
  681:       res[1] = (nodes[1]->*field)[level];
  682:       res[2] = (nodes[2]->*field)[level];
  683:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  684:       else          res[3] = T();
  685:    }    
  686: 
  687:    template<typename T>
  688:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  689:       // Get the values of the func at the nodes of the element
  690:       res[0] = (nodes[0]->*func)(level);
  691:       res[1] = (nodes[1]->*func)(level);
  692:       res[2] = (nodes[2]->*func)(level);
  693:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  694:       else          res[3] = T();  // This is 0.0 or a zero vector
  695: 
  696:    }      
  697: 
  698:    template<typename T>
  699:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  700:       // Get the values of the field at the nodes of the element
  701:       res[0] = sides[0]->*field;
  702:       res[1] = sides[1]->*field;
  703:       res[2] = sides[2]->*field;
  704:       if (isQuad()) res[3] = sides[3]->*field;
  705:       else          res[3] = T();
  706:    }
  707: 
  708:    template<typename T>
  709:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  710:       // Get the values of the field at the nodes of the element
  711:       res[0] = (sides[0]->*field)[level];
  712:       res[1] = (sides[1]->*field)[level];
  713:       res[2] = (sides[2]->*field)[level];
  714:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  715:       else          res[3] = T();
  716:    }    
  717: 
  718:    template<typename T>
  719:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  720:       // Get the values of the func at the nodes of the element
  721:       res[0] = (sides[0]->*func)(level);
  722:       res[1] = (sides[1]->*func)(level);
  723:       res[2] = (sides[2]->*func)(level);
  724:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  725:       else          res[3] = T();  // This is 0.0 or a zero vector
  726: 
  727:    }      
  728: 
  729: 
  730:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  731:       double values[4];
  732:       getNodalValues(level, func, values);
  733: 
  734:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  735:    }
  736: 
  737:    template<typename T>
  738:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  739:       T values[4];
  740:       getNodalValues(field, values);
  741:       
  742:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  743:    }
  744: 
  745: 
  746:    template<typename T>
  747:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  748:       T values[4];
  749:       getNodalValues(level, field, values);
  750: 
  751:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  752:    }
  753: 
  754:    template<typename T>
  755:    __device__ T mean(T Node::* field) const {
  756:       T values[4];
  757:       getNodalValues(field, values);
  758: 
  759:       return (values[0] + values[1] + values[2] + values[3])/i34;
  760:    }
  761: 
  762:    template<typename T>
  763:    __device__ T mean(T Side::* field) const {
  764:       T values[4];
  765:       getSideValues(field, values);
  766:       
  767:       return (values[0] + values[1] + values[2] + values[3])/i34;
  768:    }   
  769: 
  770:    template<typename T>
  771:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  772:       T values[4];
  773:       getNodalValues(level, field, values);
  774: 
  775:       return (values[0] + values[1] + values[2] + values[3])/i34;
  776:    }
  777: 
  778:    template<typename T>
  779:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  780:       T values[4];
  781:       getSideValues(level, field, values);
  782:       
  783:       return (values[0] + values[1] + values[2] + values[3])/i34;
  784:    }   
  785: 
  786:    // __device__ double mean(double (Node::*func)(int) const) const {
