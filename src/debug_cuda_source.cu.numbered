 1749: // Helper functions for computing the local node index at a given offset from another.
 1750: __device__ __inline__ int nxq(int offset, int index, int size) {
 1751:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1752:    // to the index to make it positive
 1753:    assert(index + offset + 16*size >= 0);
 1754:    return (index + offset + 16*size) % size;  
 1755: }
 1756: 
 1757: __device__ __inline__ int nxq(int index, int size) {
 1758:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1759:    // to the index to make it positive
 1760:    assert(index + 16*size >= 0);
 1761:    return (index + 16*size) % size; 
 1762: }
