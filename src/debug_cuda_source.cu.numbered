 4683:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4684: 
 4685:       SIDE(side);
 4686: 
 4687:       side->U = {0.0, 0.0}; 
 4688:          
 4689:       if(side->isDry) return;
 4690: 
 4691:       const Node *node1 = side->n1;
 4692:       const Node *node2 = side->n2;
 4693: 
 4694:       // Vertically integrated velocity U (in ll if ics=2)
 4695:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4696:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4697:       }
 4698: 
 4699:    }
 4700: 
 4701:    __global__ void computeBottomDragVegetation(void) {
 4702:       // UNFINISHED. CHECK THIS:
 4703:       // How many kernels are needed? Why so many for loops?
 4704:       // Is the loop on sides needed?
 4705: 
 4706:       NODE(node);
 4707: 
 4708: 
 4709:       const int    kb      = node->kb;
 4710:       const double htot    = node->htot2(); 
 4711:       
 4712:       if (node->isDry) {
 4713:          // Default values for dry nodes
 4714:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4715:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4716: 
 4717:          return;
 4718:        
 4719:       }
 4720: 
 4721:       // Computes bottom drag Cd based on the selected nchi
 4722:       node->computeBottomDragCd();
 4723:       
 4724: 
 4725: 
 4726:       //   Bottom stress in m^2/s^2
 4727:       if (node->rho[kb + 1] >= -98.0)
 4728:       {
 4729:          const double mag_u = length(node->u2[kb + 1]);
 4730:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4731: 
 4732:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4733:          // !sediment erosion: this part needs more documentation
 4734:       }
 4735:     
 4736: 
 4737: 
 4738:       // Compute vegetation parameters
 4739:       //--------------------------------
 4740: 
 4741:       // SAV constants
 4742:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4743:       constexpr double veg_cfpsi = 0.16;
 4744: 
 4745:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4746:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4747: 
 4748:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4749:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4750:          int kbin = 0; // bin index
 4751:          for (int k = kb; k < nvrt; k++) {
 4752:             // Computes node height above the bottom level
 4753:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4754:             assert(false && "Vertical variation of vegetation not implemented");
 4755: 
 4756:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4757:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4758:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4759:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4760:             // } else {
 4761:             //    // Find the bin at which the current vertical level is
 4762:             //    while (kbin<nbins_veg_vert) {
 4763:             //       const double zn = node->z[kbin];
 4764:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4765:             //          break;
 4766:             //       } // if
 4767:             //       kbin++;
 4768:             //    } // while
 4769:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4770: 
 4771:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4772:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4773:                
 4774:             //    // Linear interpolation of the vegetation parameters
 4775:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4776:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4777:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4778:             // } // if rl10
 4779: 
 4780:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4781: 
 4782:          } // for k
 4783: 
 4784: 
 4785:       } else { // Ganthy (iveg==2)
 4786:       //  Modify canopy height, diameter, and density
 4787: 
 4788:          // Make sure there is vegetation on this node
 4789:          if (node->veg_h_unbent > 0.0) {
 4790:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4791: 
 4792:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4793:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4794:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4795: 
 4796:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4797:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4798:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4799:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4800:          } // if veg_h_unbent
 4801: 
 4802:          for (int k = 0; k < nvrt; k++) {
 4803:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4804:          } // for k
 4805:       
 4806: 
 4807:       } // if iveg
 4808:      
 4809: 
 4810:       // Compute vertical mean of veg_alpha3D
 4811:       if (iveg != 0) {
 4812:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4813:          double sum1=0.0;
 4814:          double sum2=0.0;
 4815:          // Integrate over each level under the canopy...
 4816:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4817:             const double Dz = node->Dz(k);
 4818: 
 4819:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4820:             sum2 += Dz;
 4821: 
 4822:          } // for k
 4823:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4824:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4825: 
 4826:       } // if iveg
 4827: 
 4828:    }
 4829: 
 4830:    __global__ void computeVegetationAndDragParameters(void) {
 4831:       // Computes the vegetation and drag model parameters:
 4832:       // chi, \tilde\chi, beta, \breve{H}
 4833:       
 4834:       SIDE(side);
 4835: 
 4836:       if (side->isDry) return;
 4837: 
 4838:       const double htot = side->htot2();
 4839:       const int    kb   = side->kb;
 4840: 
 4841:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4842: 
 4843:       const double veg_h     = side->veg_h();
 4844:       const double veg_nv    = side->veg_nv();
 4845:       const double veg_c     = side->veg_c();
 4846:       const double veg_beta  = side->veg_beta;
 4847:       const double veg_alpha = side->veg_alpha_vert_mean();
 4848: 
 4849:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4850:       // Velocity magnitude at the bottom level
 4851:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4852:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4853:       side->chi2 = side->Cd()*vmag1;
 4854:       side->chi  = side->chi2;
 4855:       if constexpr(iveg != 0) {
 4856:          const Node *n1 = side->n1;
 4857:          const Node *n2 = side->n2;
 4858:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4859:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4860:       }
 4861: 
 4862:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4863: 
 4864:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4865:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4866:       double magUa = 0.0;
 4867:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4868:          // 3D wet side with veg...
 4869: 
 4870:          double magUa = 0.0;
 4871:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4872:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4873: 
 4874:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4875:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4876:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4877: 
 4878:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4879:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4880: 
 4881:                // Velocity magnitude at the bottom (l) of the level
 4882:                const double ul = length(side->u2[k]);
 4883: 
 4884:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4885:                magUa += Dz*0.5*(uh + ul);
 4886: 
 4887:             } // if HasVegetation
 4888:          } // for k
 4889:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4890: 
 4891:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4892:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4893:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4894:             const double zCpy = side->zTopCanopy();
 4895:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4896:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4897:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4898:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4899:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4900:          } // if isSubmerged
 4901:       } // if iveg   
 4902: 
 4903:       // Computes the friction modified depth, \breve{H} in notes
 4904:       if (side->is2D()) { // 2D
 4905: 
 4906:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4907:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4908: 
 4909:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4910: 
 4911:          side->hhat = htot*htot/fricH; 
 4912: 
 4913:       } else { // 3D
 4914:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4915: 
 4916:          if constexpr(iveg != 0) {
 4917:             
 4918:             if (side->isSubmerged()) { 
 4919:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4920:                side->hhat -= veg_c*Hhat_alpha;
 4921: 
 4922:             } else { // Emergent
 4923:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4924:             }
 4925:          } // if iveg
 4926: 
 4927:          // Enforce positivity for 3D model
 4928:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4929:       } // if 3D
 4930: 
 4931:    }
 4932: 
 4933: 
 4934: 
 4935:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4936:    // Computes the density gradient between two elements, e1 and e2.
 4937:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4938:    // zero in the direction normal to the side. 
 4939:    // 
 4940:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4941:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4942:    //
 4943:    // Input:
 4944:    //    e1: Element
 4945:    //    e2: Neighbor element (or nullptr if boundary)
 4946:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4947:    //    k: Index of the half-level at which the density is interpolated
 4948:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4949:    // 
 4950:    // Output:
 4951:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4952:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4953: 
 4954:       if (e2 == nullptr || e2->isDry) {
 4955:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4956: 
 4957:          Side *side = e1->sides[j];
 4958:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4959:                  
 4960:          if constexpr(ics == 1) {
 4961:             vec = side->n; // Normal vector to the side
 4962:          } else {
 4963:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4964:             // IMPLEMENT THIS XXXXXX
 4965:             // !replace with xel, yel?
 4966:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4967:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4968:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4969:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4970:          } //ics
 4971:                    
 4972:          diffRho = 0.0;
 4973: 
 4974:       } else { //internal and wet
 4975:          if constexpr(ics==1) {
 4976:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4977: 
 4978:             // Vector from e1 to e2
 4979:             vec = e2->center - e1->center;
 4980: 
 4981:          } else { 
 4982:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4983:             // IMPLEMENT THIS XXXXXX
 4984:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4985:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4986:             //                   alow(j)=xctr2
 4987:             //                   bdia(j)=yctr2
 4988:          } // ics
 4989: 
 4990:          diffRho = rho2 - e1->demeanedDensity(k);
 4991:       }
 4992: 
 4993:    }
 4994: 
 4995:    __global__ void computeDensityCubicSplines(void) {
 4996:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4997: 
 4998:       ELEM(elem);
 4999: 
 5000:       if (elem->isDry) return;
 5001: 
 5002:       const int kb = elem->kb;
 5003: 
 5004:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5005:       if (elem->is2D()) {
 5006:          // In the 2D case, the density is constant at the prism level. 
 5007:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5008:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5009:       } else { //3D
 5010: 
 5011:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5012:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5013:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5014:          ///// XXXX CHECK INDICES!!!!!
 5015:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5016:       } // 2D/3D
 5017: 
 5018:    }
 5019: } // extern "C"
 5020: 
 5021: 
 5022: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5023: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5024: 
 5025:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5026: 
 5027:    const int kb  = elem->kb;
 5028:    const int kb2 = elem2->kb;
 5029: 
 5030:    // z-coordinate of prism of elem
 5031:    const double zp = elem->z_prism(k);
 5032: 
 5033:    double rho = 0.0;
 5034: 
 5035:    if (elem2->is2D()) {
 5036:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5037: 
 5038:    } else {  // 3D
 5039: 
 5040:       // eta_min may be < zmax
 5041:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5042:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5043: 
 5044:       // (Extrapolate density below bottom, we will fix it later)
 5045:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5046:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5047:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5048:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5049:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5050:    } // 2D/3D
 5051:      
 5052: 
 5053:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5054:    // Now we need to fix it.
 5055:    if (elem->z[k] < elem2->z[kb2]) {
 5056:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5057: 
 5058:       // There are two methods to adjust the density at the bottom of the element.
 5059:       // iunder_deep=0: 
 5060:       const double depth1 = abs(elem->z[kb]); // larger depth
 5061: 
 5062:       if (iunder_deep==0) {
 5063: 
 5064:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5065: 
 5066:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5067: 
 5068:       } else { // iunder_deep != 0
 5069: 
 5070:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5071: 
 5072:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5073: 
 5074:          //   Demeaned density at the same z coordinate as
 5075:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5076:          }
 5077: 
 5078:       } // if iunder_deep
 5079:    } // if elem->z[kb] < elem2->z[kb]
 5080: 
 5081:    return rho;
 5082: }
 5083: 
 5084: 
 5085: extern "C" {
 5086:    __global__ void computeDensityGradient(void) {
 5087: 
 5088:       if constexpr(ibc != 0) return;
 5089: 
 5090:          // Compute the horizontal density gradient at each element.
 5091:       // It works in two steps:
 5092:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5093:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5094:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5095:       //             gradRho.r1 = rho1 - rho0
 5096:       //             gradRho.r2 = rho2 - rho0
 5097:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5098:       // 
 5099:       //  NOTE: We use de-meaned densities.
 5100: 
 5101:       ELEM(elem);
 5102: 
 5103:       if (elem->isDry) return;
 5104: 
 5105:       const int kb  = elem->kb;
 5106:       const int i34 = elem->i34;
 5107: 
 5108:       for (int k = kb + 1; k < nvrt; k++) {
 5109:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5110:          //             gradRho.r1 = rho1 - rho0
 5111:          //             gradRho.r2 = rho2 - rho0
 5112:          int icount = 0;
 5113:          double sumRx = 0.0;
 5114:          double sumRy = 0.0;
 5115:          for (int j1=0; j1<i34; j1++) { 
 5116: 
 5117:             const int j2 = elem->nxq(j1 + 1);
 5118: 
 5119:             // Pairs of consecutive neighbor elements of elem
 5120:             const Element *e1 = elem->nghbElems[j1];
 5121:             const Element *e2 = elem->nghbElems[j2];
 5122: 
 5123:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5124:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5125:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5126: 
 5127:             // Compute the density difference and the vector from elem to e1 and e2
 5128:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5129:             double diffRho1, diffRho2;
 5130:             Vector2 vec1, vec2;
 5131:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5132:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5133: 
 5134:             const double rl1 = length(vec1);
 5135:             const double rl2 = length(vec2);
 5136:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5137: 
 5138:             const double delta = cross(vec1, vec2);
 5139:             const double sintheta = abs(delta)/(rl1*rl2);
 5140: 
 5141:             // To avoid problems, avoid elements with small angle between vectors
 5142:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5143:             const bool validEq = (sintheta > sin_one_deg);
 5144: 
 5145:             if (validEq) {
 5146:                // Solve the system of equations to get the density gradient at elem
 5147:                icount++;
 5148:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5149:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5150:                sumRx += Rx;
 5151:                sumRy += Ry;
 5152:             }
 5153:          } // for j1
 5154: 
 5155:          // Compute the average density gradient at elem
 5156:          if (icount==0) {
 5157:            // Bad mesh quality; bail out with 0 b-cc
 5158:            elem->gradRho[k] = {0.0, 0.0};
 5159:          } else {
 5160:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5161:          }
 5162: 
 5163:       } // for k
 5164: 
 5165:    }
 5166: 
 5167:    __global__ void computeBaroclinicTerm(void) {
 5168:    // Computes the baroclinic term at sides (at half levels).
 5169:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5170:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5171: 
 5172:       if (ibc == 1) return;
 5173: 
 5174:       SIDE(side);
 5175: 
 5176:       if (side->isDry) return;
 5177: 
 5178:       const Element *e1 = side->elems[0];
 5179:       const Element *e2 = side->elems[1];      
 5180:       const int kb = side->kb;
 5181:       
 5182:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5183: 
 5184:       // interpolates vertically the density gradient of the two elements at the half level/
 5185: 
 5186:       int k1 = max(kb, nvrt / 2);
 5187:       int k2 = max(kb, nvrt / 2);
 5188: 
 5189:       // Starts the integration at the surface and goes down to the bottom
 5190:       side->bcc[nvrt-1] = {0.0, 0.0};
 5191:       for (int k = nvrt - 2; k >= kb; k--) {
 5192:       // For each prism level (from surface to bottom)...
 5193: 
 5194:          // For both elements, interpolate density gradient at the side's half level.
 5195:          // The gradient at the side is the average of the gradients at the elements.
 5196:          // w1, w2 are used to take into account boundary sides, with just one element.
 5197:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5198:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5199:          const double wsum = w1 + w2;
 5200:          w1 = w1/wsum;
 5201:          w2 = w2/wsum;
 5202:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5203: 
 5204:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5205:          Vector2 gradRho = {0.0, 0.0};
 5206:          if (e1 != nullptr && k > kb) {
 5207:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5208:             
 5209:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5210:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5211:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5212: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5213:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5214:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5215:          }      
 5216:          if (e2 != nullptr && k > kb) {
 5217:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5218:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5219:             
 5220:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5221:          }
 5222: 
 5223:          if constexpr(ics==2) {
 5224:             assert(false && "Not implemented: ics == 2");
 5225:             // IMPLEMENT THIS XXXXXX
 5226:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5227:             // swild(1)=tmp1
 5228:             // swild(2)=tmp2
 5229:          }
 5230:          
 5231:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5232:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5233:          // CHECK INDICES!!! XXX
 5234:          const double grav3 = side->grav3();
 5235:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5236: 
 5237:       } // for
 5238: 
 5239:    }
 5240: 
 5241: 
 5242: 
 5243:    __global__ void computeHorGradientAtSide(void) {
 5244: 
 5245:       // Compute the horizontal density gradient at each element.
 5246:       // It works in two steps:
 5247:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5248:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5249:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5250:       //             gradRho.r1 = rho1 - rho0
 5251:       //             gradRho.r2 = rho2 - rho0
 5252:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5253:       // 
 5254:       //  NOTE: We use de-meaned densities.
 5255: 
 5256:       SIDE(side);
 5257: 
 5258: // printf("side->isDry: %d\n", side->isDry);
 5259:       if (side->isDry) return;
 5260: 
 5261:       // Computes the gradient of the variables at the side center.
 5262:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5263:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5264:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5265: 
 5266:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5267:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5268:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5269:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5270: 
 5271:    }
 5272: 
 5273: 
 5274:    __global__ void solveMomentumEquations(double time) {
 5275: 
 5276:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5277:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5278: 
 5279:       SIDE(side);
 5280: 
 5281:       if (side->isDry) 
 5282:       {
 5283:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5284: 
 5285:          return;
 5286:       }
 5287: 
 5288:       const Node *n1 = side->n1;
 5289:       const Node *n2 = side->n2;
 5290: 
 5291:       const int kb = side->kb;
 5292: 
 5293:       const double veg_h = side->veg_h();
 5294:       const double grav3 = side->grav3();
 5295: 
 5296:       if (side->is2D()) {
 5297:          // Warning: Do not use htot2, which is updated.
 5298:          const double htot = side->htot1();
 5299:          const double hhat = side->hhat;
 5300: 
 5301:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5302: 
 5303:          Vector2 tau2 = {0.0, 0.0};
 5304:           
 5305:          if constexpr(ics==1) {
 5306:             tau2 = side->tau();
 5307: 
 5308:          } else {
 5309:             assert(false && "Not implemented: ics == 2");
 5310:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5311:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5312:             // taux2=(vn1+tt1)*0.5d0
 5313:             // tauy2=(vn2+ss1)*0.5d0
 5314:          } // if ics         
 5315: 
 5316:          // hat_gam has units of m/s
 5317: 
 5318:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5319: 
 5320:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5321:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5322: 
 5323:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5324: 
 5325: 
 5326:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5327:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5328: 
 5329:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5330: 
 5331:       }
 5332:       else { // 3D
 5333: 
 5334:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5335:          // 
 5336:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5337:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5338:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5339:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5340:          // k+1 and k.
 5341: 
 5342: 
 5343:          const int ndim = nvrt - kb;
 5344:          const double zTopCanopy = side->zTopCanopy();
 5345: 
 5346:          // Initialize the tridiagonal system
 5347:          for (int k = kb + 1; k < nvrt; k++) {
 5348:             
 5349:             const int kin = k - (kb + 1);
 5350: 
 5351:             // Vertical viscosity at the face center
 5352:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5353: 
 5354:  
 5355:             alow[kin] = 0.0;
 5356:             cupp[kin] = 0.0;
 5357:             bdia[kin] = 0.0;
 5358: 
 5359:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5360:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5361: 
 5362:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5363:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5364:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5365: 
 5366:             // First part: layers k, k+1
 5367:             if (k < nvrt - 1) {
 5368:                              
 5369:                if constexpr(iveg != 0) {
 5370: 
 5371:                   // If there is vegetation at this level...
 5372:                   if (zTopCanopy > side->zc[k]) {
 5373:                      // If the canopy is above the k layer...
 5374:                      
 5375:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5376:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5377:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5378:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5379: 
 5380:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5381:                      const double vmag2 = length(ut2);
 5382:                      const double vmag1 = length(side->u2[k]);
 5383:                      const double vmag = 0.5*(vmag1 + vmag2);
 5384:                      
 5385:                      // Computes the vegetation alpha at the face center
 5386:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5387: 
 5388:                      cff1 += veg_alpha_sd*dt*vmag;
 5389: 
 5390:                   } // if (zTopCanopy
 5391:                } // if iveg
 5392: 
 5393:                const double dzz = side->Dz(k + 1);
 5394:                const double tmp = dt*dfz/dzz;
 5395:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5396: 
 5397:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5398:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5399:             }
 5400: 
 5401: 
 5402:             // Second part: layers k-1, k
 5403:             if (k > kb + 1) {
 5404: 
 5405:                double cff1 = 1.0; //init \bar{c^k}
 5406: 
 5407:                if constexpr(iveg != 0) {
 5408:                   // If there is vegetation at this level...
 5409:                   if (zTopCanopy > side->zc[k-1]) {
 5410:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5411:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5412: 
 5413:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5414: 
 5415:                      const double vmag2 = length(ut2);
 5416:                      const double vmag1 = length(side->u2[k-1]);
 5417:                      const double vmag = 0.5*(vmag1 + vmag2);
 5418: 
 5419:                      // Computes the vegetation alpha at the face center
 5420:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5421:                      cff1 += veg_alpha_sd*dt*vmag;
 5422:                   } // if zTopCanopy
 5423: 
 5424:                } // if iveg
 5425: 
 5426:                const double dzz = side->Dz(k);
 5427:                const double tmp = dt*dfz/dzz;
 5428:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5429: 
 5430:                alow[kin] += cff1*dzz/6.0 - tmp;
 5431:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5432: 
 5433:             } else { // Bottom boundary
 5434:                // This occurs at the bottom, where the bottom drag is applied.
 5435: 
 5436:                bdia[kin] += dt*side->chi2; // XXXX
 5437: 
 5438:             } // if (k > kb + 1)
 5439: 
 5440: 
 5441:          } // for (int k
 5442: 
 5443: 
 5444: 
 5445:          // Computes the RHS.
 5446:          // -----------------
 5447: 
 5448:          //	BC to be imposed at the end.
 5449: 
 5450:          const Vector2 gradETP  = side->gradETP;
 5451:          const Vector2 gradPr   = side->gradPr;
 5452:          const Vector2 gradEta1 = side->gradEta1;
 5453:          const Vector2 gradEta2 = side->gradEta2;
 5454: 
 5455:          const Vector2 *btu = side->btu;
 5456:          const Vector2 *u2  = side->u2;
 5457:          const double coriolis = side->coriolis;
 5458:          const Vector2 *nuGradU = side->nuGradU;
 5459: 
 5460: 
 5461:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5462: 
 5463:          for (int k = kb + 1; k < nvrt; k++) {
 5464:             const int kin = k - kb - 1;
 5465: 
 5466:             const double dz_0 = side->Dz(k);
 5467:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5468: 
 5469:             rrhs[kin] = {0.0, 0.0};
 5470:             double dz = 0.0;
 5471: 
 5472:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5473:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5474:             if (k < nvrt  ) dz += dz_1;
 5475:             if (k > kb + 1) dz += dz_0;
 5476: 
 5477:             // Elevation gradient, atmospheric pressure and tidal potential
 5478:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5479: 
 5480:             // Coriolis, advection, wind stress, and horizontal viscosity
 5481:             if (k < nvrt - 1) {
 5482: 
 5483: 
 5484:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5485:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5486:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5487:                                                 
 5488: 
 5489:                //diff stress tensors 1006
 5490:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5491:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5492:                   assert(false && "Not implemented: itur == 5");
 5493:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5494:                }
 5495:                // else assert(false && "itur # Not implemented");
 5496: 
 5497:             } else { // k == nvrt - 1 SURFACE
 5498:                Vector2 tau2 = {0.0, 0.0};
 5499:                if constexpr(ics==1) {
 5500:                   tau2 = side->tau();
 5501:       
 5502:                } else {
 5503:                   assert(false && "Not implemented: ics == 2");
 5504:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5505:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5506:                   // taux2=(vn1+tt1)*0.5d0
 5507:                   // tauy2=(vn2+ss1)*0.5d0
 5508:                } // if ics
 5509: 
 5510:                rrhs[kin] += dt*tau2;
 5511:           
 5512: 
 5513:             } // if k<nvrt
 5514: 
 5515:             if (k > kb + 1) {
 5516:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5517:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5518:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5519: 
 5520:                // diff stress tensors 1006
 5521:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5522:                   assert(false && "Not implemented: itur == 5");
 5523:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5524:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5525:                }
 5526:                // else assert(false && "itur # Not implemented");
 5527: 
 5528: 
 5529:             } // if k>kbs + 1
 5530: 
 5531:             // Baroclinic
 5532:             Vector2 *bcc = side->bcc;
 5533:             if constexpr(ibc == 0) {
 5534:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5535:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5536: 
 5537:             } // if ibc==0
 5538: 
 5539:          } // k=kb + 1,nvrt
 5540: 
 5541: 
 5542:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5543: 
 5544:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5545:             const int kin = k - kb - 1;
 5546:    
 5547:             // Velocity is always clamped to maximum values
 5548:             side->u2[k] = {clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely)};
 5549:          } // k
 5550: 
 5551:       } // if side->is2D()
 5552:       
 5553: 
 5554:       // Impose velocity boundary condition at the bottom
 5555:       if constexpr(imm == 2) { // 3D bed deformation model
 5556:          double dep;
 5557:          Vector2 vel;
 5558: 
 5559:          assert(false && "Not implemented: imm == 2");
 5560:          //update_bdef(time, x0, y0, dep, vel);
 5561:          // side->u2[kb] = vel;
 5562: 
 5563:       } else { // imm = 0 or 1
 5564:          if (side->Cd() == 0.0) {
 5565:             side->u2[kb] = side->u2[kb + 1];
 5566: 
 5567:          } else if (side->is3D()) { // 3D no slip bottom   
 5568:             side->u2[kb] = {0.0, 0.0};
 5569:          }
 5570:           
 5571:       } // if imm
 5572: 
 5573:       // The velocities below the bottom level are set to zero
 5574:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5575: 
 5576: 
 5577:    }
 5578: 
 5579: 
 5580:    __global__ void applyMomentumBC(void) {
 5581: 
 5582:       SIDE_BND(sideBnd);
 5583: 
 5584:       Side *side = sideBnd->side;
 5585:       const BoundarySegment *segment = sideBnd->segment;
 5586:       const Node *n1 = side->n1;
 5587:       const Node *n2 = side->n2;
 5588: 
 5589:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5590: 
 5591:       const bool isLand = segment->isLand;
 5592:       const int ifltype = segment->ifltype;
 5593: 
 5594:       const int kb = side->kb;
 5595: 
 5596: 
 5597:       if (!isLand && ifltype != 0) {
 5598:          const Vector2 *ubc = sideBnd->ubc;
 5599:   
 5600:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5601:             
 5602:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5603:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5604: 
 5605:             if (ifltype == -1) {
 5606:                // Flather 1
 5607: 
 5608:                const double depth = side->depth();
 5609: 
 5610:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5611: 
 5612:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5613: 
 5614:                side->u2[k] = vnorm*side->n;
 5615: 
 5616:             } else if (ifltype == -2) { // Discharge
 5617: 
 5618:                const double eta1 = side->eta1();
 5619:                const double eta2 = side->eta2();
 5620:                const double htot = side->htot2();
 5621: 
 5622:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5623:                assert(false && "Not implemented: Discharge bc");
 5624:                // const double dischrg = discharge(eta1);
 5625:                const double dischrg = 0.0; // XXX REMOVE
 5626:                
 5627: 
 5628:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5629: 
 5630:                const double vnorm = dischrg*eta2/htot;
 5631: 
 5632:                side->u2[k] = vnorm*side->n;
 5633: 
 5634:             }
 5635:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5636:                const double vnorm = dot(side->u2[k], side->n);
 5637: 
 5638:                double rat;
 5639:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5640:                else              rat = segment->vobc2; // outgoing
 5641: 
 5642:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5643: 
 5644:             }
 5645:             else { // not Flather or 3D radiation
 5646:                side->u2[k] = ubc[k];
 5647: 
 5648:             } // if (segment->ifltype...
 5649: 
 5650:          }
 5651: 
 5652:       }
 5653:       else if (isLand) { // if it is land boundary side
 5654: 
 5655:          if constexpr(islip == 0) { // free slip
 5656: 
 5657:             for (int k = kb; k < nvrt; k++) {
 5658: 
 5659:                const Vector2 t = side->t();
 5660:                const Vector2 n = side->n;
 5661: 
 5662:                double vnorm = 0.0; // for most cases
 5663:                const double vtan = dot(side->u2[k], t);
 5664:                
 5665:                side->u2[k] = vtan*t - vnorm*n;
 5666: 
 5667:             }
 5668: 
 5669:          } else { // no slip
 5670:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5671: 
 5672:          }
 5673:       } // if (side segment type...
 5674: 
 5675:    
 5676: 
 5677:    }
 5678: 
 5679: 
 5680:    __global__ void shapiroFilter1(void) {
 5681:       // First step of the Shapiro filter (normally used if indvel<=0)
 5682:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5683: 
 5684:       SIDE(side);
 5685: 
 5686:       // Only internal wet sides are processed
 5687:       if (side->isDry || !(side->isInternal())) return;
 5688: 
 5689:       const int kb = side->kb;
 5690: 
 5691:       for (int mm = 0; mm < niter_shap; mm++) {
 5692: 
 5693:          for (int k = kb + 1; k < nvrt; k++) {
 5694:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5695:             Vector2 suru = {0.0, 0.0};
 5696: 
 5697:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5698: 
 5699:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5700: 
 5701:                int kin = k;
 5702:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5703:                
 5704:                if constexpr(ics==1) {
 5705:                   suru += nSide->u2[kin];
 5706: 
 5707:                } else {
 5708:                   assert(false && "Not implemented: ics == 2");
 5709:                   // Vector2 vn1, vn2;
 5710:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5711:                   // suru=suru+vn1;
 5712:                   // surv=surv+vn2;
 5713:                }
 5714:             }
 5715: 
 5716:             // Reusing bcc as a temporary array to store the suru values.
 5717:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5718: 
 5719:          }
 5720:       }
 5721:    }
 5722: 
 5723:    __global__ void shapiroFilter2(void) {
 5724:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5725: 
 5726:       SIDE(side);
 5727: 
 5728: 
 5729:       if (side->isDry || !(side->isInternal())) return;
 5730: 
 5731:       const int kb = side->kb;
 5732: 
 5733:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5734: 
 5735:       if (side->is2D()) {
 5736:          side->u2[kb + 1] = side->bcc[kb + 1];
 5737:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5738: 
 5739:       } else {
 5740:          // 3D
 5741:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5742:          
 5743:       }
 5744: 
 5745:    }
 5746: 
 5747: 
 5748:    __global__ void ul0UpdateZCoords(void) {
 5749:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5750:       
 5751:       NODE(node);      
 5752: 
 5753: 
 5754:       if (false) {//node->isDry) {  //XXXXXXXXXXXXXXXXX
 5755: 
 5756:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5757: 
 5758:          if constexpr(ivcor != 1) node->kb = 0;
 5759: 
 5760:       } else {
 5761: 
 5762:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5763:          node->updateKb();
 5764: 
 5765:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5766: 
 5767:       }
 5768: 
 5769:       // We use the temp.b field to store the previous state of isDry.
 5770:       node->tmp.b = node->isDry;
 5771: 
 5772:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5773:       node->isDry = true;
 5774: 
 5775:    }
 5776: 
 5777:    __global__ void ul0ComputeDryElements(void)
 5778:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5779:    {
 5780:       ELEM(elem);
 5781: 
 5782:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5783: 
 5784:       elem->kb = 0;
 5785: 
 5786:       if (elem->isDry) return;
 5787: 
 5788: 
 5789:    //    if(elem->isDry2()) { // XXXX
 5790:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5791:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5792:    //        call parallel_abort(errmsg)
 5793:    //    }
 5794: 
 5795:       const Node *n1 = elem->nodes[0];
 5796:       const Node *n2 = elem->nodes[1];
 5797:       const Node *n3 = elem->nodes[2];  
 5798:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5799: 
 5800:       // Computes element's kb as the minimum of the nodes' kb.
 5801:       const int kb1 = n1->kb;
 5802:       const int kb2 = n2->kb;
 5803:       const int kb3 = n3->kb;
 5804:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5805: 
 5806: 
 5807:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5808: 
 5809: 
 5810:       // Computes the element z as the mean of the nodes z.
 5811:       for (int k = elem->kb; k < nvrt; k++) {
 5812: 
 5813:          // Compute the element z as the mean of the nodes z.
 5814:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5815:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5816:          elem->z[k] /= elem->i34;
 5817: 
 5818:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5819:       }
 5820:                   
 5821:    }
 5822: 
 5823:    __global__ void ul0ComputeDryNodes(void)
 5824:    // Updates node's isDry based on the elements' isDry. 
 5825:    {
 5826:       NODE(node);
 5827: 
 5828:       node->isDry = true;
 5829: 
 5830:       // A node is wet if at least one of the elements sharing it is wet.
 5831:       for (int j = 0; j < node->numElements; j++) {
 5832:          const Element *elem = node->elements[j];
 5833:          if (!elem->isDry) {
 5834:             node->isDry = false;
 5835:             break;
 5836:          }
 5837:       }
 5838: 
 5839:        
 5840:    }
 5841: 
 5842: 
 5843:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5844:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5845:    // node->tmp.b is true if the node was previously dry.
 5846:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5847:    {
 5848:       NODE(node);
 5849:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5850: 
 5851:       // Avoid this the first time step.
 5852:       if (it == iths) return;  
 5853: 
 5854:       const bool wasDry = node->tmp.b;
 5855: 
 5856: if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5857: 
 5858:       // assert(node->isDry == node->isDry2() && "These two must be identical at this point"); XXXXX 
 5859:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5860: 
 5861:          for (int k=0; k < nvrt; k++) {
 5862: 
 5863:             Vector3 utmp={0.0, 0.0, 0.0};
 5864: 
 5865:             double ttmp=0.0;
 5866:             double stmp=0.0;
 5867:             int icount=0;
 5868:             for (int j = 0; j < node->numNodes; j++) {
 5869: 
 5870:                const Node *nbrNode = node->nodes[j];
 5871:                
 5872:                const bool wasNbrDry = nbrNode->tmp.b;
 5873: 
 5874:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5875:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5876: 
 5877:                   icount++;
 5878: 
 5879:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5880:                   utmp += nbrNode->uvw2(k);
 5881:                   
 5882:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5883:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5884:                }
 5885:             }
 5886: 
 5887:             if (icount > 0) {
 5888:                const double inv_icount = 1.0/icount;
 5889:                utmp = inv_icount*utmp;
 5890:                node->u2[k]     = toVector2(utmp);
 5891:                node->w2[k]     = utmp.z;
 5892:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5893:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5894:             } else {
 5895:                node->u2[k] = {0.0, 0.0};
 5896:                node->w2[k] = 0.0;
 5897:                // Initialize tracers to 0.0??? XXXXX
 5898:             }
 5899:          }
 5900:       }
 5901:    }
 5902: 
