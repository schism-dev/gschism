  264: 
  265: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  266:     return make_double3(v.x * s, v.y * s, v.z * s);
  267: }
  268: 
  269: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
