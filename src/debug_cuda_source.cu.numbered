 2596: /**
 2597:  * This method performs backtracking from the side center until a time -dt back in time 
 2598:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2599:  * intermediate point.
 2600:  *
 2601:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2602:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2603:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2604:  * remaining time.
 2605:  * 
 2606:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2607:  * 
 2608:  * @param uuint, vvint, wwint: Velocities at the final point
 2609:  * @param jlev: Level at which the backtracking is performed
 2610:  * @param dt, dtbk: Tracking timesteps
 2611:  * @return: True if the backtracking was successful, false otherwise
 2612:  */
 2613: __inline__ __device__ bool Side::btrack(
 2614:       int jlev,
 2615:       double dt,            // Tracking time
 2616:       double dtbk,          // Tracking timestep
 2617:       Vector3 &u_int        // Velocities at the initial point
 2618: ) const {
 2619: 
 2620:    // Start from side center
 2621:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2622: double dt0 = dt;
 2623: Point3 x00 = x0;
 2624:  
 2625:    double time_rm = dt; // Remaining time
 2626: 
 2627: 
 2628: 
 2629: 
 2630:    // Initial velocities
 2631:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2632: 
 2633:    // Find the element that is in the direction opposite to the velocity
 2634:    Element* curElem = findElementTowards(toVector2(u_int));
 2635: 
 2636: 
 2637:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2638:    if (curElem == nullptr) {
 2639:       // Make velocity parallel to the side
 2640:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2641:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2642:       curElem = otherElem(curElem);
 2643: 
 2644: 
 2645: // if (curElem == nullptr) { u_int = {0.0, 0.0, 0.0}; return true;}
 2646: // assert(curElem!=nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2647: // printf("@@@@@@@YYYY@@@@@@@@@ curElem = %p, isDry = %d\n", curElem, curElem->isDry);
 2648:       
 2649:    }
 2650: 
 2651:    if (curElem == nullptr || curElem->isDry) { 
 2652:       // This means that the starting side is shared by dry elements (or one dry and one boundary side).
 2653:       u_int = {0.0, 0.0, 0.0}; 
 2654:       return true;
 2655:    }
 2656: 
 2657:    // Nudges it towards the barycenter
 2658:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2659: 
 2660: 
 2661: 
 2662: 
 2663:    const int MAX_ITERATIONS = 1000; 
 2664:    Element* nextElem = nullptr;
 2665:    int iter = 0;
 2666: assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2667:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2668:    while(true) {
 2669: 
 2670:       // Calculate timestep
 2671:       double dtb = min(dtbk, time_rm);
 2672: if (dtb>0.0 && dtb < 1e-5) {
 2673: printf("@@@@@@@@@@@@@@@4 dtbk = %.17g, time_rm = %.17g\n", dtbk, time_rm);
 2674: assert(false && "dtb < 1e-5");
 2675: }
 2676: 
 2677:       // Next point in the backtracking curve
 2678:       xt = x0 - dtb*u_int;
 2679: if (!curElem->containsPoint(toPoint2(x0))) printf("@@@@@@@@@ iter = %d, x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g, dtbk = %.17g, dtb = %.17g, u_int = %.17g, %.17g, %.17g\n", iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, dtbk, dtb, u_int.x, u_int.y, u_int.z);      
 2680: assert(curElem->containsPoint(toPoint2(x0)) && "YYY Starting point is not inside the element");
 2681:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2682:       assert(found && "Backtracking failed in btrack");
 2683: 
 2684:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2685: 
 2686:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2687:                       // then time_rm needs to be increased by the unused time.
 2688: 
 2689:       // If the velocity is too small, we stop the backtracking
 2690:       const double vmag = length(toVector2(u_int));
 2691:       if (vmag <= velmin_btrack) break;
 2692: 
 2693:       // The current point becomes the next segment's starting point.
 2694:       x0 = xt;
 2695:  
 2696:       curElem = nextElem;
 2697: 
 2698:       iter++;
 2699: if (iter>100) {
 2700:    // if (dtb>0.0 && dtb < 1e-5) {
 2701:    //    printf("@@@@@@@@@@@@@@@4 dtbk = %.17g, time_rm = %.17g\n", dtbk, time_rm);
 2702:    //    assert(false && "dtb < 1e-5");
 2703:    //    }
 2704: printf("@@@@@@@@@@@@@@@@ curElem->idx = %d, nextElem->idx = %d, isdry = %d, n1->idx = %d, n2->idx = %d, iter = %d\n", curElem->idx, nextElem->idx, curElem->isDry, n1->idx, n2->idx, iter);
 2705: printf("@@@@@@@@@@@@@@@2 x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g\n", x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 2706: printf("@@@@@@@@@@@@@@@3 dtbk = %.17g, dtb = %.17g, u_int = %.17g, %.17g, %.17g, time_rm = %.17g\n", dtbk, dtb, u_int.x, u_int.y, u_int.z, time_rm);
 2707: }
 2708: if (iter>900) return true;
 2709:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2710:    }
 2711: 
 2712:    // Interpolate the velocities at the final point
 2713:    curElem->interpolateVelocities(xt, u_int);
 2714: 
 2715:    // if (jlev==9) addDebugPlot(x00, x00 + dt0*u_int, 0xFFCF00, 'x');  // yellow
 2716:    if (jlev==1 ) addDebugPlot(x00, x00 + dt0*u_int, 0x00F0FF, '+');  // green
 2717: 
 2718: 
 2719: }
 2720: 
