 2333:    template<typename T>
 2334:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2335:       T values[4];
 2336:       getSideValues(field, values);
 2337:       
 2338:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2339:       if constexpr (IsVector2<T>::value && ics == 2) {
 2340: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2341:          projectSideVectorsToElementFrame(values);
 2342: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2343:       }
 2344: 
 2345:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2346:    }   
