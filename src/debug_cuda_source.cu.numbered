 2374: 
 2375: __device__ void Node::updateKb(void) {
 2376: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2377: 
 2378:    if constexpr(ivcor == 1) return;
 2379: 
 2380: 
 2381:    // Check if node is wet
 2382:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2383: 
 2384:    if (isDry) return;
 2385: 
 2386:    if constexpr(ivcor == 2) {  // SZ coordinates
 2387:       
 2388:       // Compute bottom level index
 2389:       if (depth <= mesh->h_s) {
 2390:          kb = mesh->kz - 1;
 2391:       } else {
 2392:          kb = -1;
 2393:          int L = 0;
 2394:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2395:          
 2396:          while (L <= R) {
 2397:             int M = (R + L) / 2;
 2398: 
 2399:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2400:             
 2401:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2402:                R = M;
 2403:             } else {
 2404:                L = M;
 2405:             }
 2406: 
 2407:             if (R - L == 1) {
 2408:                kb = L;
 2409:                break;
 2410:             }
 2411:          }
 2412:       }
 2413:    } 
 2414: }
 2415: 
 2416: 
 2417: __device__ double Node::compZCoord(int k) const {
 2418:    // Computes the z coordinate at level k.
 2419:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2420:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2421:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2422:    // used 
 2423:    
 2424:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2425:       
 2426:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2427: 
 2428:    if constexpr(ivcor == 2) {
 2429: 
 2430:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2431:       const int kz = mesh->kz;
 2432:       const double h_c = mesh->h_c;
 2433:       const double theta_f = mesh->theta_f;
 2434:       const double sinh_theta_f = mesh->sinh_theta_f;
 2435: 
 2436:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2437:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2438:       // once per time step/node.
 2439:       // CHECK: updateZCoordData
 2440: 
 2441:       if (k == kz)               return -hmod2;
 2442:       else if (k == nvrt-1)      return eta2;
 2443:       else if (k == kb)          return -depth;
 2444:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2445:       else if (k > kz) {
 2446:          const int ksig = k - kz + 1;
 2447: 
 2448:          if (hmod2 <= h_c) {
 2449:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2450:          } 
 2451:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2452:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2453:             assert(false && "ZCOOR: invalid h_c\n");
 2454:          } 
 2455:          else {
 2456:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2457:                          h_c * mesh->sigma[ksig] + 
 2458:                          (hmod2 - h_c) * mesh->cs[ksig];
 2459:          }
 2460:       } else { 
 2461:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2462:       }
 2463: 
 2464:    }
 2465:    else if constexpr(ivcor == 1) {
 2466:       if (k == kb) return -depth;
 2467:       else if (k == nvrt-1) return eta2;
 2468:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2469:    }
 2470:    
 2471:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2472:    return 0.0;
 2473: }
 2474: 
 2475: 
 2476: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2477:                 double *node_coords, double *wind_rotate_angle, 
 2478:                 int *isdel, int *isidenode, int *isbnd,
 2479:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2480:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2481:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2482:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2483:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2484:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2485:                 double *emo, double *efa, 
 2486:                 double *umo, double *ufa, 
 2487:                 double *vmo, double *vfa) {
 2488: 
 2489:    printf("Populating mesh for partition %d\n", partNum);
 2490: 
 2491:    // Horizontal grid
 2492:    printf("Processing %d nodes\n", np);    
 2493: 
 2494: 
 2495:    int idxNodeBoundary = 0;  
 2496:    for (int i = 0; i < np; i++)
 2497:    {
 2498:       Node &node = localNodeData[i];
 2499: 
 2500:       node.idx = i;
 2501: 
 2502:       const int idxNodeStart = nodeNeighNodesStart[i];
 2503:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2504:       node.numNodes = idxNodeEnd - idxNodeStart;
 2505:       node.nodes = nodeNeighNodes + idxNodeStart;
 2506:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2507: 
 2508: 
 2509: 
 2510:       const int idxElemStart = nodeNeighElemsStart[i];
 2511:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2512:       node.numElements = idxElemEnd - idxElemStart;
 2513:       node.elements = nodeNeighElems + idxElemStart;
 2514: 
 2515: 
 2516:       
 2517:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2518:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2519:          const int partNode = localNodePart[idxNodeGlobal]; 
 2520:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2521: 
 2522: 
 2523:          Node *node_ptr = nodes[partNode] + idxNode;
 2524:          
 2525:          nodeNeighNodes[idx] = node_ptr;
 2526:       }
 2527: 
 2528:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2529:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2530:          const int partElem = localElemPart[idxElemGlobal];
 2531:          const int idxElem  = localElemIndices[idxElemGlobal];
 2532: 
 2533:          Element *elem_ptr = elems[partElem] + idxElem;
 2534: 
 2535:          nodeNeighElems[idx] = elem_ptr;
 2536:       }      
 2537: 
 2538: 
 2539:       node.wind_angle = wind_rotate_angle[i];
 2540: 
 2541:       // Element **elements; // pointer to the elements connected to this node
 2542:       // int numElements;   // number of elements shared by this node
 2543: 
 2544:       node.p.x   = node_coords[i * 3];
 2545:       node.p.y   = node_coords[i * 3 + 1];
 2546:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2547:       node.depth = node_coords[i * 3 + 2];
 2548: 
 2549: 
 2550: 
 2551:       // Links the node to the boundary information
 2552:       if (isbnd[i] >= 0) {
 2553:        
 2554:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2555:          node.nodeBnd->node = &node;
 2556: 
 2557:          if (isbnd[i]>0) {
 2558: 
 2559:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2560:             node.nodeBnd->segment->ifltype = isbnd[i];
 2561: 
 2562:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2563:             node.nodeBnd->segment->clen  = nan("1");
 2564:             node.nodeBnd->segment->carea = nan("1");
 2565: 
 2566:          }
 2567:          else {
 2568:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2569:          }
 2570:          
 2571:          idxNodeBoundary++;
 2572:       }
 2573:       else {
 2574:          node.nodeBnd = nullptr;
 2575:       }
 2576: 
 2577: // XXXX
 2578: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2579: constexpr double rot_per = 3000.0;
 2580: constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2581: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2582: // XXXXX
 2583:    }
 2584: 
 2585:    nbp = idxNodeBoundary;
 2586: 
 2587:    printf("Processing %d sides\n", ns);
 2588:    int idxSideBoundary = 0;
 2589:    for (int i = 0; i < ns; i++)
 2590:    {
 2591:       Side &side = localSideData[i];
 2592:       side.idx = i;
 2593:       // finding the pointer to the nodes that form the side
 2594:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2595:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2596: 
 2597:       const int locidx_n1 = localNodeIndices[idx_n1];
 2598:       const int locidx_n2 = localNodeIndices[idx_n2];
 2599:       const int part_n1 =   localNodePart[idx_n1];
 2600:       const int part_n2 =   localNodePart[idx_n2];
 2601: 
 2602:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2603:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2604: 
 2605:       // Normal vector to the side
 2606:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2607:       const double norm = sqrt(dot(side.n, side.n));
 2608:       side.n = side.n/norm;
 2609: 
 2610:       // Side boundary type
 2611:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2612:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2613:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2614:       
 2615:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2616:       {
 2617:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2618:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2619:          else                  side.sideBnd->segment = n2bnd->segment;
 2620:          side.sideBnd->side = &side;
 2621:          idxSideBoundary++;
 2622:       }
 2623:       else side.sideBnd = nullptr;
 2624: 
 2625:       nbs = idxSideBoundary;
 2626: 
 2627:       // finding the pointer to the elements that share the side
 2628:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2629:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2630: 
 2631:       if (idx_e1 > -1) {
 2632:          const int locidx_e1 = localElemIndices[idx_e1];
 2633:          const int part_e1 =  localElemPart[idx_e1];
 2634:          side.elems[0] = elems[part_e1] + locidx_e1;
 2635:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2636:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2637:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2638:       }
 2639:       else {
 2640:          side.elems[0] = nullptr;
 2641:       }
 2642: 
 2643:       if (idx_e2 > -1) {
 2644:          const int locidx_e2 = localElemIndices[idx_e2];
 2645:          const int part_e2 =  localElemPart[idx_e2];
 2646:          side.elems[1] = elems[part_e2] + locidx_e2;
 2647:       }
 2648:       else {
 2649:          side.elems[1] = nullptr;
 2650:       }
 2651: 
 2652: 
 2653: 
 2654:       // Compute the center of the side
 2655:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2656: 
 2657: // XXXX
 2658: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2659: constexpr double rot_per=3000.0;
 2660: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2661: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2662: // XXXXX      
 2663: 
 2664:       // Compute the z level at the center of the side
 2665:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2666: 
 2667:       // Compute the length of the side
 2668:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2669:       side.length = sqrt(dot(vLen, vLen));
 2670: 
 2671:    }
 2672: 
 2673:    printf("Processing %d elements\n", ne);
 2674:    for (int i = 0; i < ne; i++)
 2675:    {
 2676:       Element &elem = localElemData[i];
 2677:       elem.idx = i;
 2678:       for (int j = 0; j < i34[i]; j++) {
 2679:          const int idxNode = elnode[i*4 + j];  
 2680:          const int idxSide = elside[i*4 + j];
 2681:          
 2682:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2683:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2684: 
 2685: 
 2686: 
 2687:          // Find the neighboring element  
 2688:          if (elem.sides[j]->elems[0] == &elem) {
 2689:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2690:          }
 2691:          else {
 2692:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2693:          }
 2694:          
 2695:       }
 2696: 
 2697:       elem.i34 = i34[i];
 2698: 
 2699: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2700: 
 2701:       // Compute the centroid of the element and its depth
 2702:       Vector2 center = {0.0, 0.0};
 2703:       elem.depth = 0.0;
 2704:       for (int j = 0; j < i34[i]; j++) {
 2705:          center += elem.nodes[j]->p2()/i34[i];
 2706:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2707:       }
 2708:       elem.center.x = center.x;
 2709:       elem.center.y = center.y;
 2710: 
 2711:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2712:       
 2713:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2714:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2715: 
 2716:       elem.area = elem.computeSignedArea(); 
 2717:       elem.radius = sqrt(elem.area)/pi; 
 2718:       
 2719:       // Determines which way the normal vector to each side is oriented.
 2720:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2721:       for (int j = 0; j < i34[i]; j++)  
 2722:       {
 2723:          if (elem.sides[j]->elems[0] == &elem) {
 2724:             elem.ssign[j] =  1.0;
 2725:          }
 2726:          else {
 2727:             elem.ssign[j] = -1.0;
 2728:          }
 2729: 
 2730:       }
 2731: 
 2732:       // Derivatives of shape functions
 2733:       //  For ics=2, this is done inside element/ll frame XXX
 2734:       //  For quads, the derivative is evaluated at centroid
 2735:       const int i34 = elem.i34;
 2736:       for (int j = 0; j < i34; j++) {
 2737:          const double area = elem.area;
 2738:          const int id2 = elem.nxq(1 + j);
 2739:          const int id3 = elem.nxq(2 + j);
 2740:          const int id4 = elem.nxq(3 + j);
 2741:          if (elem.isTri()) {
 2742:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2743:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2744:             // da1/dx = (y1 - y2)/(2*area)
 2745:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2746:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2747:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2748:          }
 2749:          else  { // Quad; evaluate at centroid
 2750:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2751:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2752:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2753:          } // if Tri
 2754: 
 2755:       } // for j
 2756: 
 2757:    }
 2758: 
 2759: 
 2760:    // Processing the boundary nodes
 2761:    int idx = 0;
 2762:    for (int iseg = 0; iseg < nope; iseg++) {
 2763:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2764: 
 2765:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2766: 
 2767:          nodeBnd->isEssentialBC = true;
 2768: nodeBnd->iettype = 3;
 2769:          nodeBnd->elbc = 0.0;
 2770: 
 2771:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2772:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2773:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2774:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2775:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2776:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2777:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2778: printf("nodeBnd->efa[%d] = %f, nodeBnd->emo[%d] = %f, nodeBnd->umo[%d] = %f, nodeBnd->ufa[%d] = %f, nodeBnd->vmo[%d] = %f, nodeBnd->vfa[%d] = %f\n", jfr, nodeBnd->efa[jfr], jfr, nodeBnd->emo[jfr], jfr, nodeBnd->umo[jfr], jfr, nodeBnd->ufa[jfr], jfr, nodeBnd->vmo[jfr], jfr, nodeBnd->vfa[jfr]);
 2779:          }
 2780: 
 2781:          idx++;
 2782:       }
 2783: 
 2784:    }
 2785: 
 2786: }
 2787: 
 2788: 
 2789: 
 2790: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2791:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2792:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2793:    // 
 2794:    // This kernel is called for all nodes.
 2795: 
 2796: 
 2797:    NODE(node1);
 2798: 
 2799: 
 2800:    node1->clearMatrixRow();
 2801:    node1->qel = 0.0;
 2802: 
 2803:    // THIS IS FOR STRUCTURES XXX
 2804:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2805: 
 2806:    
 2807:    for (int j=0; j<node1->numElements; j++) {
 2808:       // For each element connected to the node...
 2809: 
 2810:       Element *elem = node1->elements[j];
 2811: 
 2812:       // Compute the average gravity
 2813:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2814:       const double grav3 = elem->mean(&Node::grav2);
 2815: 
 2816:       // Look at the documentation for the description of the terms in the following integrals
 2817: 
 2818:       // Integral I_1 
 2819:       // \bar{\breve{H}} 
 2820:       const double hhatb = elem->mean(&Side::hhat);        
 2821: 
 2822: 
 2823:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2824: 
 2825:       const int id1 = elem->nodeLocalIdx(node1); 
 2826:       const double area = elem->area;
 2827: 
 2828:       if (elem->isTri()) {
 2829: 
 2830:          // To clarify the notation in this section: 
 2831:          //   i stands for the node under consideration (node1)
 2832:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2833:          const int id2 = elem->nxq(1 + id1);
 2834:          const int id3 = elem->nxq(2 + id1);
 2835:          Node *node2 = elem->nodes[id2];
 2836:          Node *node3 = elem->nodes[id3];
 2837: 
 2838:          const Point2 x1 = node1->p2();
 2839:          const Point2 x2 = node2->p2();
 2840:          const Point2 x3 = node3->p2();
 2841: 
 2842:          // integral of phi_i*phi_j
 2843:          const double ipp_ii = (1.0/6.0 )*area;
 2844:          const double ipp_ij = (1.0/12.0)*area;
 2845:          const double ipp_ik = (1.0/12.0)*area;
 2846: 
 2847:          // integral of [(grad phi_i) * (grad phi_j)]
 2848:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2849:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2850:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2851: 
 2852:          // Computes the different components of integral I_1 of each node with respect to node i.
 2853:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2854:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2855:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2856: 
 2857: if (j==node1->numElements-1) {
 2858: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2859: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2860: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2861: }
 2862: 
 2863:          node1->addToSparseMatrix(node1, I1_ii);
 2864:          node1->addToSparseMatrix(node2, I1_ij); 
 2865:          node1->addToSparseMatrix(node3, I1_ik);
 2866: 
 2867: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2868:      
 2869:       }
 2870:       else { // Quad
 2871:          // XXX IMPLEMENT THIS
 2872:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2873:       } 
 2874: 
 2875:  
 2876:       // Integral I_4
 2877:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2878:       // Where
 2879:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2880: 
 2881:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2882:       // of U over the element.
 2883:       Vector2 Umean = {0.0, 0.0};
 2884:       for (int m=0; m<elem->i34; m++) {      
 2885:          const Side *side = elem->sides[m];
 2886: 
 2887:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2888:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2889:       }
 2890:       Umean = Umean/elem->i34;
 2891: 
 2892:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2893: 
 2894:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2895:       const double I_4_1 = dot(gradPhi_1, Umean);
 2896: 
 2897:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2898:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2899:      
 2900:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2901: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2902: 
 2903:       // Additional terms 
 2904:       double vnorm = 0.0;
 2905:       if (imm == 2)  { // Pre-compute vnorm on the element
 2906:          Vector3 ubed;
 2907:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2908: 
 2909:          Vector3 gradP = {0.0, 0.0, 1.0};
 2910:          for (int m=0; m < elem->i34; m++) {
 2911:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2912:            gradP += toVector3(gradP_2D, 0.0);
 2913:          }   
 2914:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2915:       } // imm==2
 2916: 
 2917:       if (elem->isTri()) {
 2918:          for (int l=0; l<3; l++) {
 2919:            double fac;
 2920: 
 2921:            Node *node = elem->nodes[l];
 2922: 
 2923:            (node == node1)? fac=2.0 : fac=1.0;
 2924: 
 2925:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2926:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2927:            
 2928:          }
 2929: 
 2930: 
 2931:          if (!elem->isDry) {
 2932:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2933:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2934:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2935: 
 2936:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2937:          }
 2938: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2939: 
 2940:       } // isTri
 2941:       else { // isQuad
 2942:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2943:          // for (int l=0; l<4; l++) {
 2944:          //   const Node *node = elem->nodes[l];
 2945: 
 2946:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2947:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2948: 
 2949:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2950:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2951:          // }
 2952: 
 2953:       } // isQuad
 2954: 
 2955: 
 2956:       node1->qel += (dt/elem->i34)*elem->vsource;
 2957:       
 2958: 
 2959:    } // for all elements connected to the node
 2960:    
 2961: 
 2962: 
 2963:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2964:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2965:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2966:    if (nodeBnd != nullptr)  { 
 2967:       // If it is an open boundary node...
 2968: 
 2969:       // At least one open bnd side, maybe two
 2970:       for (int l=0; l<2; l++) { 
 2971: 
 2972:          // Gets each of the sides sharing the node. 
 2973:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2974: 
 2975:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2976: 
 2977:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2978: 
 2979: 
 2980:          if (sideBnd != nullptr) {
 2981:             // If the side is on a boundary...
 2982: 
 2983:             // Get the boundary segment
 2984:             const BoundarySegment *sideSegment = sideBnd->segment;
 2985:             const Side *side = sideBnd->side;
 2986: 
 2987:             // Integral I_3
 2988:             if (sideSegment->ifltype != 0) {
 2989:             // Natural or Flather b.c.
 2990: 
 2991:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2992:                // especially for Flather b.c.
 2993:                double ri3 = 0.0;
 2994:                if (!side->isDry) {
 2995:                   // If the side is not dry
 2996:                   
 2997:                   // Computes the side flux of (uth, vth)
 2998:                   double Vn = 0.0;
 2999:                   for (int k = side->kb; k<nvrt-1; k++) {
 3000:                      // uth, vth in lat/lon frame if ics=2
 3001:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3002:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 3003:                      const double vn2 = dot(side->uth[k+1], side->n);
 3004: 
 3005:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3006:                   }
 3007: 
 3008:                   ri3 = 0.5*side->length*Vn;
 3009:                }
 3010: 
 3011:                if (sideSegment->ifltype == -1) { // Flather 1
 3012: 
 3013:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3014:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3015: 
 3016:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 3017:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3018:                   
 3019:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3020:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3021: 
 3022:                } 
 3023:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3024:                   // Reset ri3
 3025:                   ri3 = 0.0;
 3026: 
 3027:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3028: 
 3029:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3030: 
 3031:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3032:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3033: 
 3034:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 3035:                   node1->addToSparseMatrix(node1, con0*2.0);
 3036:                   node1->addToSparseMatrix(node2, con0);
 3037: 
 3038:                } // if Flather or Discharge
 3039: 
 3040:                node1->qel -= thetai*dt*ri3;
 3041: 
 3042:             } // I_3
 3043:           
 3044: 
 3045:             // Integral I_5
 3046:             if(!side->isDry) {
 3047: 
 3048:                const double Unbar = dot(side->U, side->n);
 3049: 
 3050:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 3051:                
 3052:             } // I_5
 3053: 
 3054:          } // if is boundary side
 3055: 
 3056:       } // for l
 3057: 
 3058:    } // if isbnd
 3059: 
 3060: 
 3061:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3062: 
 3063: }
 3064: 
 3065: 
 3066: 
 3067: extern "C" {
 3068:    __global__ void rollUpElevation(void) {
 3069: 
 3070:       NODE(node);
 3071: 
 3072:       node->eta2 += node->eta1;
 3073: 
 3074:    }
 3075: 
 3076: 
 3077:    __global__ void backtrackAllNodes(void) {
 3078: 
 3079:       // max/min # of sub-divisions
 3080:       const int ndelt_max = max(1.0, dt/dtb_min);
 3081:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3082: 
 3083:       // Removed all references to swild98 XXX
 3084:       // swild98=0.d0 !init
 3085: 
 3086: 
 3087:       SIDE(side);
 3088: 
 3089:       const int kb = side->kb;
 3090: 
 3091:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 3092: 
 3093:       // Initialize btrack velocities to the actual velocities at the side 
 3094:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3095: 
 3096: 
 3097:       if (side->isDry) return;
 3098: 
 3099: 
 3100:       // Checks that at least one element is not dry
 3101:       const Element *elem1 = side->elems[0];
 3102:       const Element *elem2 = side->elems[1];
 3103: 
 3104: 
 3105:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3106:       
 3107:       // XXXXXX
 3108:       // !swild_tmp to store global coord. of the starting side
 3109:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3110:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3111:       // !Use sframe2 
 3112:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3113: 
 3114: 
 3115:       for (int k = kb; k < nvrt; k++) {
 3116:       //  Initialize (xt,yt,zt), nnel and vel.
 3117:       //  For ics=2, the coordinates are in local frames
 3118:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3119: 
 3120: 
 3121:          const int iadvf = side->iadv();  // Advection flag
 3122: 
 3123:          Point3 xt;
 3124:          if constexpr(ics==1) {
 3125:             xt = side->center3D(k); 
 3126:          }
 3127:          else // lat/lon; in side lat/lon frame
 3128:          {
 3129:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3130:          // XXX IMPLEMENT THIS
 3131:       //          xt=0.d0
 3132:       //          yt=0.d0
 3133:       //          !centroid coord. for nudging
 3134:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3135:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3136:          }  // ics
 3137: 
 3138: 
 3139:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3140:          // XXX IS THIS NECESSARY?
 3141:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3142: 
 3143:          // If on land or open boundary...
 3144:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3145:          
 3146:          const double vmag = length(toVector2(u_int));
 3147: 
 3148:          if (vmag <= velmin_btrack) {
 3149:             // No activity 
 3150: 
 3151:             side->btu[k] = side->u2[k];
 3152: 
 3153:             
 3154:          } else {  // do btrack
 3155: 
 3156:           
 3157:             // Compute number of sub-divisions based on local gradients 
 3158:             // XXX IS THIS NECESSARY?
 3159:             double suma = 0.0;
 3160:             int icount = 0;
 3161:             for (int ii=0; ii<2; ii++) {
 3162: 
 3163:                const Element *elem = side->elems[ii];
 3164:                  
 3165:                if (elem == nullptr) continue;
 3166: 
 3167:                icount++;
 3168: 
 3169:                // Not strictly along z; in ll frame for ics=2
 3170: 
 3171:                double utmp[4];
 3172:                double vtmp[4];
 3173:                for (int jj = 0; jj < elem->i34; jj++) {
 3174: 
 3175:                   const Node *node = elem->nodes[jj];
 3176: 
 3177:                   if constexpr(ics==1) {
 3178:                      utmp[jj] = node->u2[k].x;
 3179:                      vtmp[jj] = node->u2[k].y;  
 3180:                   } else {
 3181:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3182:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3183:                   }
 3184:                } // for jj
 3185: 
 3186:                const Vector2 grad_u = elem->grad2(utmp); 
 3187:                const Vector2 grad_v = elem->grad2(vtmp);
 3188: 
 3189:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3190:             } // for ii
 3191: 
 3192:             assert(icount > 0 && "Impossible 77");
 3193: 
 3194:             // '4' is somewhat arbitrary
 3195:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3196: 
 3197:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3198:          
 3199: 
 3200:             Vector3 u_int = {0.0, 0.0, 0.0};
 3201: 
 3202:             side->btrack(k, dt, dtbk, u_int);
 3203: 
 3204:                
 3205:          } // if vmag (do backtrack)
 3206: 
 3207:       } // for j=jmin,nvrt-1
 3208: 
 3209:    }
 3210: } // extern "C"
 3211: 
 3212: template<int nc>
 3213: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3214: 
 3215: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3216: //
 3217: // a,b,c,rhs: input vectors and are not modified by this program.
 3218: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3219: // rhs is the r.h.s.
 3220: // n: actual rank of the system.
 3221: // rows in u() and rhs();
 3222: // u: output with nc columns (transposed to rows)
 3223: // gam: a working array.
 3224: //
 3225: // NOTES:
 3226: // This is a template function that allows for different numbers of columns in the rhs vector.
 3227: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3228: 
 3229:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3230:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3231: 
 3232:    double bet = b[0];
 3233:    if constexpr (nc == 1) {
 3234:       u[0] = rhs[0]/bet;
 3235:    } else {
 3236:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3237:    }
 3238: 
 3239:    for (int j = 1; j < n; j++) {
 3240:       gam[j] = c[j-1]/bet;
 3241:       bet = b[j] - a[j]*gam[j];
 3242: 
 3243:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3244: 
 3245:       if constexpr (nc == 1) {
 3246:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3247:       } else {
 3248:          for (int k = 0; k < nc; k++) {
 3249:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3250:          }
 3251:       }
 3252:    }
 3253: 
 3254:    // Back-substitution
 3255:    for (int j=n-1; j>=1; j--) {
 3256:       if constexpr (nc == 1) {
 3257:          u[j] = u[j] - gam[j+1]*u[j-1];
 3258:       } else {
 3259:          for (int k = 0; k < nc; k++) {
 3260:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3261:          }
 3262:       }
 3263:    }
 3264: }
 3265: 
 3266: 
 3267: 
 3268: // Helper function that contains the core algorithm
 3269: template<typename XAccessor, typename YAccessor>
 3270: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3271:                                     double  yp_top, double  yp_bot, 
 3272:                                     CubicSpline &spline) {
 3273:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3274:    // 
 3275:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3276:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3277:    //
 3278:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3279:    // 
 3280:    // Inputs: 
 3281:    //            n: dimension for x etc; # of data pts (>=2);
 3282:    //            getX, getY: functions to access x,y coordinates
 3283:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3284:    //     Output: 
 3285:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3286: 
 3287:    const int n = k2 - k1 + 1;
 3288:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3289: 
 3290:    // Allocate memory for the splines
 3291:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3292:    spline.x   = new double[n];
 3293:    spline.y   = new double[n];
 3294:    spline.yp  = new double[n];
 3295:    spline.ypp = new double[n];
 3296: 
 3297:    for (int k=k1; k<=k2; k++) {
 3298:       spline.x[k] = getX(k);
 3299:       spline.y[k] = getY(k);
 3300:    }
 3301: 
 3302:    // This is to simplify expressions later
 3303:    double *x = spline.x;
 3304:    double *y = spline.y;
 3305: 
 3306:    double *a = nullptr;
 3307:    double *b = nullptr;
 3308:    double *c = nullptr;
 3309:    double *gam = nullptr;
 3310:    double *rhs = nullptr;
 3311:    
 3312: 
 3313:       a = new double[n];   // Lower diagonal
 3314:       b = new double[n];   // Diagonal
 3315:       c = new double[n];   // Upper diagonal
 3316:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3317:       rhs = new double[n]; // Right-hand side
 3318: 
 3319:    for (int k=k1; k<=k2; k++) {
 3320:       if (k == k1) {
 3321:          // Bottom level
 3322:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3323:          b[k] = (x[k+1] - x[k])/3.0;
 3324:          c[k] = b[k]/2.0;
 3325:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3326:       } else if (k == n - 1) {
 3327:          // Top level (surface)
 3328:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3329:          b[k] = (x[k] - x[k-1])/3.0;
 3330:          a[k] = b[k]/2.0;
 3331:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3332:       } else {
 3333:          // Intermediate levels
 3334:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3335:          b[k] = (x[k+1] - x[k-1])/3.0;
 3336:          a[k] = (x[k  ] - x[k-1])/6.0;
 3337:          c[k] = (x[k+1] - x[k  ])/6.0;
 3338:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3339:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3340:       }
 3341:    }
 3342: 
 3343:    // Solve the tridiagonal system
 3344:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3345:    
 3346:    spline.yp[k1] = yp_bot;
 3347:    spline.yp[k2] = yp_top;
 3348: 
 3349:    // Compute rest of 1st derivatives using the splines
 3350:    for (int k=k1+1; k<k2; k++) {
 3351:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3352:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3353:    }
 3354:    
 3355:    delete[] a;
 3356:    delete[] b;
 3357:    delete[] c;
 3358:    delete[] gam;
 3359:    delete[] rhs;
 3360: 
 3361: }
 3362: 
 3363: // Array version
 3364: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3365:                                 double y_top, double y_bot, 
 3366:                                 CubicSpline &spline) {
 3367:    auto getX = [x] (int k) { return x[k]; };
 3368:    auto getY = [y] (int k) { return y[k]; };
 3369:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3370: }
 3371: 
 3372: // Lambda version - allows custom access patterns
 3373: template<typename XFunc, typename YFunc>
 3374: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3375:                                 double y_top, double y_bot,
 3376:                                 CubicSpline &spline) {
 3377:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3378: }
 3379: 
 3380: 
 3381: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3382: {
 3383:    assert("Not implemented");
 3384: 
 3385:    return 0.0;
 3386: }
