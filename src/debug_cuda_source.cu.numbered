 1405: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1406:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1407: }
 1408: 
 1409: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1410:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1411: }   
 1412: 
 1413: __device__ __inline__ double min3(double a, double b, double c) {
 1414:    return min(a, min(b, c));
 1415: }
 1416: 
 1417: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1418:    return min(a, min(b, min(c, d)));
 1419: }
