 4224:    __global__ void scaleGravity(double loadtide_coef) {
 4225: 
 4226: 
 4227:       NODE(node);
 4228: 
 4229:       // SAL option: scale gravity
 4230:       if constexpr(iloadtide==2) {  // simple const
 4231:          node->grav2 = grav*(1.0 - loadtide_coef);
 4232: 
 4233:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4234:         
 4235:           const double depth = max(node->depth, 0.0);
 4236:           const double tmp1 = sqrt(depth);
 4237:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4238:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4239:                              2.6969e-13*depth*depth*depth*tmp1;
 4240:           
 4241:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4242:           
 4243: 
 4244: 
 4245:           node->grav2 = grav*(1.0 - beta_bar);
 4246: 
 4247:       } else {  // iloadtide=0,1
 4248:           node->grav2 = grav;
 4249: 
 4250:       }
 4251: 
 4252:    }
 4253: 
