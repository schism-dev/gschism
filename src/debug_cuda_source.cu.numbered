 5553:    __global__ void resetBoundaryAreas(void) {
 5554:       // Reset boundary areas and lengths for each segment.
 5555: 
 5556:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5557:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5558:       SIDE_BND(sideBnd);
 5559: 
 5560:       BoundarySegment *segment = sideBnd->segment;
 5561: 
 5562:       segment->carea = 0.0;
 5563:       segment->clen = 0.0;
 5564:  
 5565:    }
 5566: 
 5567:    __global__ void computeBoundaryAreas(void) {
 5568:    // Calculation of cross-section areas and lengths for flow b.c.
 5569: 
 5570:       SIDE_BND(sideBnd);
 5571: 
 5572:       const Side *side = sideBnd->side;
 5573:       BoundarySegment *segment = sideBnd->segment;
 5574: 
 5575:       if (segment->ifltype != 0) {
 5576: 
 5577:          const Node *n1 = side->n1;
 5578:          const Node *n2 = side->n2;
 5579: 
 5580:          const double htot = side->htot2();
 5581: 
 5582:          if (!side->isDry) {
 5583:             atomicAdd(&segment->carea, htot*side->len);
 5584:             atomicAdd(&segment->clen, side->len);
 5585:          }
 5586:       }
 5587: 
 5588:    }
 5589: 
 5590: 
 5591:    __global__ void computeFlowBcVelocities(double time) {
 5592: 
 5593:       SIDE_BND(sideBnd);
 5594: 
 5595:       const Side *side = sideBnd->side;
 5596:  
 5597:       const bool isDry = side->isDry;
 5598:       const bool isLand = sideBnd->segment->isLand;
 5599: 
 5600:    
 5601:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5602: 
 5603:       if (isDry || isLand) return;
 5604: 
 5605:       // For wet sides in open boundaries...
 5606:       const Vector2 n = side->n;
 5607:       const BoundarySegment *segment = sideBnd->segment;
 5608: 
 5609:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5610: 
 5611:       const int ifltype = segment->ifltype;
 5612: 
 5613:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5614:       const Vector2 r_nuth0 = r_uth0*n;
 5615: 
 5616: 
 5617:       if (ifltype == 1 || ifltype == 2) {
 5618:       
 5619:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5620: 
 5621:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5622:          
 5623:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5624:          
 5625:       } else if (ifltype == -1) { // Flather 1
 5626: 
 5627:          for (int k = 0; k < nvrt; k++) {
 5628: 
 5629:             // uth is the normal vel.; no ramp up
 5630:             const double uth = sideBnd->nuth(k);
 5631:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5632: 
 5633:             sideBnd->ubc[k] += uth*n;
 5634:          }
 5635: 
 5636:       } else if (ifltype == 3 || ifltype == 5) {
 5637:          // vnth0=0 !normal vel.
 5638: 
 5639:          Vector2 r_u1_bar = {0.0, 0.0};
 5640:          // Computes the contribution to the velocity from all tide frequencies
 5641:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5642: 
 5643:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5644:             const Vector2 umo  = sideBnd->umo(jfr); 
 5645: 
 5646:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5647:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5648:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5649:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5650: 
 5651:          }
 5652: 
 5653: 
 5654:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5655: 
 5656:       } // if (ifltype = 3 || ifltype == 5
 5657: 
 5658: 
 5659: 
 5660:    }
 5661: 
 5662:    __global__ void computeElevationBoundaryConditions(double time) {
 5663:       // Compute elevation essential boundary conditions 
 5664: 
 5665:       NODE_BND(nodeBnd); // Each boundary node.
 5666: 
 5667:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5668: 
 5669:       const Node *node = nodeBnd->node;
 5670:       const BoundarySegment *segment = nodeBnd->segment;
 5671:       const int iettype = segment->iettype;
 5672:       
 5673: 
 5674:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5675:       double eic = 0.0;
 5676:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 5677:       else                 eic = 0.0;
 5678: 
 5679:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5680:       const double r_eth = ramp*nodeBnd->eth;
 5681:       double r_eta1_bar = 0.0;
 5682: 
 5683: 
 5684:       // Compute tide elevation
 5685:       if (iettype == 3 || iettype == 5) {   
 5686: 
 5687:          if constexpr(iloadtide==1) { // loading tide
 5688:             assert(false && "Loading tide not implemented");
 5689:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5690:          }
 5691:          
 5692:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5693: 
 5694:             const double efa  = nodeBnd->efa[jfr]; 
 5695:             const double emo  = nodeBnd->emo[jfr]; 
 5696: 
 5697:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5698:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5699:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5700: 
 5701:          } // for jfr
 5702: 
 5703:       } // if iettype
 5704: 
 5705:       switch (iettype) {
 5706:          case 1:
 5707:          case 2:
 5708:          case 4:
 5709:             nodeBnd->elbc = r_eic + r_eth;
 5710:             break;
 5711:          case 3:
 5712:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5713:             break;
 5714:          case 5:
 5715:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5716:             break;
 5717:       } // switch
 5718: 
 5719: 
 5720:       //Add inverse barometric effects
 5721:       if (iettype != 0 && inv_atm_bnd == 1) {
 5722:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5723:       }
 5724: 
 5725:    }
 5726: 
 5727: 
 5728:    __global__ void computeHorizontalViscosity(void) { 
 5729: 
 5730:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5731: 
 5732:       SIDE(side);
 5733: 
 5734:       if (side->isDry) return;
 5735: 
 5736:       for (int k = 0; k < nvrt; k++) {
 5737:          side->nuGradU[k] = {0.0, 0.0};
 5738:       }
 5739: 
 5740:       if constexpr(ihorcon == 1) {
 5741:          for (int k = side->kb; k < nvrt - 1; k++) {
 5742:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5743:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5744:             // By Zhang and Baptista.
 5745: 
 5746:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5747:             // This is a standard discretization of the Laplacian operator.
 5748:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5749:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5750:             // Gamma is hvis_coef0 in the code.
 5751:             // The value of gamma needs to be < 0.5.
 5752: 
 5753:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5754:             // side under consideration in each of the two possible elements that share the side.
 5755:             Vector2 sumU = {0.0, 0.0};
 5756:             for (int l = 0; l < 2; l++) {
 5757:                const Element *elem = side->elems[l];
 5758: 
 5759:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5760: 
 5761:                // Find the local index of the side in the element
 5762:                const int idxSide = elem->sideLocalIdx(side);
 5763: 
 5764:                // Find the two sides that are connected to the side under consideration
 5765:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5766:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5767: 
 5768:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5769: 
 5770:             }
 5771: 
 5772:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5773: 
 5774:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5775:    
 5776:          }
 5777:       }
 5778:       else if constexpr(ihorcon == 2) {
 5779:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5780:       }
 5781: 
 5782: 
 5783:    }
 5784: 
 5785: 
 5786:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5787:       // Set essential boundary conditions 
 5788:       NODE(node); // Each boundary node
 5789:       NodeBoundary *nodeBnd = node->nodeBnd;
 5790:       
 5791:  
 5792:       // Check if this node has essential BC
 5793:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5794:          // Verify BC value is valid
 5795:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5796: 
 5797:        
 5798:          // Set diagonal to 1 and zero off-diagonals
 5799:          node->coeffDiag = 1.0;
 5800: 
 5801:          for (int j = 0; j < node->numNodes; j++) {
 5802:                node->coeffMatrix[j] = 0.0;
 5803:          }
 5804:          
 5805:          // Set solution and RHS to BC value
 5806:          node->mX  = nodeBnd->elbc;
 5807:          node->qel = nodeBnd->elbc;
 5808: 
 5809:       } else {
 5810:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5811: 
 5812:          for (int j = 0; j < node->numNodes; j++) {
 5813:                Node* nbNode = node->nodes[j];
 5814:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5815:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5816:                   // Verify neighbor's BC value
 5817:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5818: 
 5819:                   // Subtract contribution to RHS
 5820:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5821:                   node->coeffMatrix[j] = 0.0;  
 5822:                }
 5823:          }
 5824:       }
 5825:    }
