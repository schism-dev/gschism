 3703: 
 3704: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3705: 
 3706: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3707: 
 3708:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3709:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3710: 
 3711: 
 3712: 
 3713:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3714:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3715: 
 3716:    double fun_lat = 0.0;
 3717:    switch (jspc[idxComp]) {
 3718:       case 0:
 3719:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3720:          break;
 3721:       case 1:
 3722:          fun_lat = sin(2.0*lat);
 3723:          break;
 3724:       case 2:
 3725:          fun_lat = pow<2>(cos(lat));
 3726:          break;
 3727:       default:
 3728:          assert(false && "computeETP: invalid jspc");
 3729:    }
 3730:    
 3731:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3732: 
 3733: }
 3734: 
 3735: 
 3736: __device__ void Node::updateKb(void) {
 3737: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3738: 
 3739:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3740: 
 3741: 
 3742:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3743: 
 3744:    if constexpr(ivcor == 2) {  // SZ coordinates
 3745:       
 3746:       // Compute bottom level index
 3747:       if (depth <= mesh->h_s) {
 3748:          kb = izlev;   
 3749:          
 3750:       } else {
 3751:          kb = -1;
 3752:          int L = 0;
 3753:          int R = nzlev; 
 3754:          
 3755:          while (L <= R) {
 3756:             int M = (R + L) / 2;
 3757: 
 3758: 
 3759:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3760:             
 3761:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3762:                R = M;
 3763:             } else {
 3764:                L = M;
 3765:             }
 3766: 
 3767:             if (R - L == 1) {
 3768:                kb = L;
 3769:                break;
 3770:             }
 3771:          }
 3772: 
 3773:          // Checks that the binary search was successful
 3774:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3775:        
 3776:       }
 3777:    } 
 3778: }
 3779: 
 3780: 
 3781: __device__ __inline__ void Node::updateZCoordData(void) {
 3782: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3783: 
 3784:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3785:    // if (isDry2()) {
 3786:    //    kb = -1;  // XXXXXXXX KKKKK
 3787:    //    return;
 3788:    // }
 3789: 
 3790: 
 3791:    if constexpr(ivcor == 2) {  // SZ coordinates
 3792:       
 3793:       // Compute bottom level index
 3794:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3795:    } 
 3796:    else {  // if (ivcor == 1) Localized sigma
 3797:       // Do nothing
 3798:    }
 3799: 
 3800: 
 3801: }
 3802: 
 3803: 
 3804: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3805:    // Computes the z coordinate at level k.
 3806:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3807:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3808:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3809:    // used 
 3810: 
 3811:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3812:    
 3813:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3814: 
 3815:    if (isDry2()) return 0.0;  
 3816: 
 3817:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3818: 
 3819:    if constexpr(ivcor == 2) {
 3820: 
 3821:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3822:       const double h_c = mesh->h_c;
 3823:       const double theta_f = mesh->theta_f;
 3824:       const double sinh_theta_f = mesh->sinh_theta_f;
 3825: 
 3826: 
 3827:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3828:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3829:       // once per time step/node. XXXX
 3830:       // CHECK: updateZCoordData
 3831: 
 3832:       //  To simplify comparisons, I define index versions of count variables.
 3833:       if      (k == ivrt)     return eta2; 
 3834:       else if (k == izlev)    return -hmod2;
 3835:       else if (k == kb)       return -depth;
 3836:       else if (k < izlev)     return mesh->ztot[k];
 3837:       else if (k > izlev) {
 3838:          const int ksig = k - izlev;
 3839: 
 3840:          if (hmod2 <= h_c) {
 3841:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3842: 
 3843:          } 
 3844:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3845:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3846:             assert(false && "compZCoord: invalid h_c\n");
 3847:          } 
 3848:          else {
 3849:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3850:                    h_c * mesh->sigma[ksig] + 
 3851:                    (hmod2 - h_c) * mesh->cs[ksig];
 3852:          }
 3853:       } else { 
 3854:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3855:       }
 3856: 
 3857:    }
 3858:    else {  // if constexpr(ivcor == 1)
 3859:       if (k <= kb)        return -depth; 
 3860:       else if (k == ivrt) return eta2;
 3861:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3862: 
 3863:    }
 3864:    
 3865:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3866:    return 0.0;
 3867: }
 3868: 
 3869: 
 3870: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3871:    // Computes the bottom drag Cd based on the selected nchi
 3872: 
 3873:    if constexpr(nchi == 0) {
 3874:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3875:       Cd = drag;  // Read from drag file
 3876: 
 3877:    } else if constexpr(nchi == 1) {
 3878:       // 
 3879: 
 3880:       bool ltmp = false; // for WBL iteration
 3881: 
 3882:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3883:       if (isDry || (rough == 0.0)) {
 3884:          Cd = 0.0;
 3885: 
 3886:       } else { //roughness >0 
 3887:          
 3888:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3889: 
 3890:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3891: 
 3892:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3893: 
 3894:       } // if rough
 3895: 
 3896:    } else if constexpr(nchi == -1) {
 3897:    // Manning 
 3898:  
 3899:       const double htot = max(hmin_man, htot2()); 
 3900:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3901: 
 3902:    } else {
 3903:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3904:       
 3905:    } // if nchi
 3906: 
 3907: }
 3908: 
 3909: 
 3910: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3911:    // Checks if a side in on the boundary
 3912:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3913: 
 3914:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3915:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3916: 
 3917:    // Indices of the nodes that form the side
 3918:    const int n1 = side.n1->idx;
 3919:    const int n2 = side.n2->idx;
 3920:    isLand = false;
 3921:    
 3922: 
 3923:    // Check if the side is on a land boundary
 3924:    for (int i = 0; i < nland; i++) {
 3925:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3926:          // Consecutive nodes in the land boundary segment
 3927:          const int b1 = ilnd[i + j*nland];
 3928:          const int b2 = ilnd[i + (j + 1)*nland];
 3929: 
 3930:          assert(b1 != -1 && b2 != -1);
 3931: 
 3932:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3933:             
 3934:             isLand = true;
 3935:             return i;
 3936:          }
 3937:       }
 3938:    }
 3939: 
 3940:    // Check if the side is on an open boundary
 3941:    for (int i = 0; i < nope; i++) {
 3942:       for (int j = 0; j < nond[i] - 1; j++) {
 3943:          // Consecutive nodes in the open boundary segment
 3944:          const int b1 = iond[i + j*nope];
 3945:          const int b2 = iond[i + (j + 1)*nope];
 3946: 
 3947:          assert(b1 != -1 && b2 != -1);
 3948: 
 3949:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3950:             isLand = false;
 3951:             return i;
 3952:          }
 3953:       }
 3954:    }
 3955: 
 3956:    return -1;
 3957: }
 3958: 
 3959: 
 3960: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3961:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3962:                                     double *wind_rotate_angle, 
 3963:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3964:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3965:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3966:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3967:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3968: 
 3969:    NODE(pnode);  
 3970:    const int i = idx_node;
 3971:    Node &node(*pnode);
 3972: 
 3973:    node.idx = i;
 3974: 
 3975:    const int idxNodeStart = nodeNeighNodesStart[i];
 3976:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3977:    node.numNodes = idxNodeEnd - idxNodeStart;
 3978:    node.nodes = nodeNeighNodes + idxNodeStart;
 3979:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3980: 
 3981: 
 3982: 
 3983:    const int idxElemStart = nodeNeighElemsStart[i];
 3984:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3985:    node.numElements = idxElemEnd - idxElemStart;
 3986:    node.elements = nodeNeighElems + idxElemStart;
 3987: 
 3988: 
 3989:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3990:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3991:       const int partNode = localNodePart[idxNodeGlobal]; 
 3992:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3993: 
 3994:       Node *node_ptr = nodes[partNode] + idxNode;
 3995:       
 3996:       nodeNeighNodes[idx] = node_ptr;
 3997:    }
 3998: 
 3999: 
 4000:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 4001:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4002:       const int partElem = localElemPart[idxElemGlobal];
 4003:       const int idxElem  = localElemIndices[idxElemGlobal];
 4004: 
 4005:       Element *elem_ptr = elems[partElem] + idxElem;
 4006: 
 4007:       nodeNeighElems[idx] = elem_ptr;
 4008:    }      
 4009: 
 4010:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4011:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4012:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4013: 
 4014:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4015:    if constexpr(ics == 1) {
 4016:       node.p.x   = node_coords[i * 3];
 4017:       node.p.y   = node_coords[i * 3 + 1];
 4018:       node.gz = 0.0;
 4019: 
 4020:    } else {
 4021:       const double lon = deg2rad*node_coords[i * 3];
 4022:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4023: 
 4024:       Point3 p = computeXYZfromLatLon(lat, lon);
 4025:       node.p = toVector2(p);
 4026:       node.gz = p.z;
 4027:       node.lon = lon;
 4028:       node.lat = lat;
 4029: 
 4030:       #ifdef USE_FRAMES
 4031:       node.setFrame(lat, lon);
 4032:       #endif
 4033: 
 4034: 
 4035:    }
 4036: 
 4037:    node.depth = node_coords[i * 3 + 2];
 4038: 
 4039:    node.numSides = 0;
 4040: 
 4041:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4042:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 4043:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 4044:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 4045:    else assert(false && "populateNodes: selected nchi not implemented.");
 4046:    
 4047:    if constexpr(ivcor == 1) 
 4048:    {  
 4049:       node.kb = kb[i];
 4050:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 4051:    }
 4052: 
 4053:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4054:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4055:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4056: 
 4057:    
 4058:    // Links the node to the boundary information
 4059:    if (isbnd[i] >= 0) {
 4060:      
 4061:       // Get the index of the node boundary
 4062:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4063: 
 4064:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4065:       node.nodeBnd->node = &node;
 4066: 
 4067:       node.nodeBnd->sideBnd1 = nullptr;
 4068:       node.nodeBnd->sideBnd2 = nullptr;
 4069: 
 4070:       if (isbnd[i]>=0) {
 4071: 
 4072:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 4073:          
 4074:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4075:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4076: 
 4077:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4078:          node.nodeBnd->segment->clen  = nan("1");
 4079:          node.nodeBnd->segment->carea = nan("1");
 4080: 
 4081:       }
 4082:    } else {
 4083: 
 4084:       node.nodeBnd = nullptr; // For internal nodes
 4085: 
 4086:       if (isbnd[i] == landSegment) {
 4087:          node.nodeBnd = &landBoundaryNode;
 4088:          node.nodeBnd->segment = &landBoundarySegment;
 4089:       }
 4090:       
 4091:    }
 4092:    
 4093:    // XXXX GAUSSIAN HILL VELOCITIES
 4094:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4095:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4096:          constexpr double rot_per = 3000.0;
 4097:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4098:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4099:       // XXXXX
 4100:    #endif
 4101: 
 4102: }
 4103: 
 4104: 
 4105: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4106:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4107:                                     double *wind_rotate_angle,   
 4108:                                     int *isdel, int *isidenode, int *isbnd,
 4109:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4110:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4111:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4112:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4113:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4114:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4115:                                     double *drag, double *roughness) {
 4116: 
 4117: 
 4118:    SIDE(pside);
 4119:    Side &side(*pside);
 4120:    const int i = idx_side;
 4121: 
 4122:    side.idx = i;  
 4123:    
 4124:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4125:    const double fc   = 2.0*omega_e*sin(sfea0);
 4126:    const double beta = 2.0*omega_e*cos(sfea0);
 4127: 
 4128:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4129: 
 4130:    // finding the pointer to the nodes that form the side
 4131:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4132:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4133: 
 4134:    const int locidx_n1 = localNodeIndices[idx_n1];
 4135:    const int locidx_n2 = localNodeIndices[idx_n2];
 4136:    const int part_n1 =   localNodePart[idx_n1];
 4137:    const int part_n2 =   localNodePart[idx_n2];
 4138: 
 4139:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4140:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4141: 
 4142: 
 4143:    // Counts the number of sides connected to each node
 4144:    side.n1->numSides++;
 4145:    side.n2->numSides++;
 4146: 
 4147:    // Side boundary type
 4148:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4149:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4150: 
 4151:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4152:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4153:    {
 4154:       bool isLand = false;
 4155:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4156:       
 4157:       if (isbs > -1) {
 4158:          // assert(isLand || isbs>=0);
 4159:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4160: 
 4161:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4162: 
 4163:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4164:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4165: 
 4166:          assert (isLand == side.sideBnd->segment->isLand);
 4167: 
 4168:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4169:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4170:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4171: 
 4172:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4173:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4174:          
 4175:          side.sideBnd->side = &side;
 4176: 
 4177:       }
 4178:       else {
 4179:          side.sideBnd = nullptr;
 4180:       }
 4181:    }
 4182:    else 
 4183:    {
 4184:       side.sideBnd = nullptr;
 4185:    }
 4186: 
 4187: 
 4188:    // finding the pointer to the elements that share the side
 4189:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4190:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4191: 
 4192:    if (idx_e1 > -1) {
 4193:       const int locidx_e1 = localElemIndices[idx_e1];
 4194:       const int part_e1 =  localElemPart[idx_e1];
 4195:       side.elems[0] = elems[part_e1] + locidx_e1;
 4196: 
 4197:    }
 4198:    else {
 4199:       side.elems[0] = nullptr;
 4200:    }
 4201: 
 4202:    if (idx_e2 > -1) {
 4203:       const int locidx_e2 = localElemIndices[idx_e2];
 4204:       const int part_e2 =  localElemPart[idx_e2];
 4205:       side.elems[1] = elems[part_e2] + locidx_e2;
 4206:    }
 4207:    else {
 4208:       side.elems[1] = nullptr;
 4209:    }
 4210:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4211:       
 4212:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4213:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4214:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4215:          
 4216:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4217:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4218:       // printf("sideBnd: %p\n", side.sideBnd);
 4219:       // assert(false && "Side has no elements and no boundary");
 4220:    }
 4221:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4222: 
 4223:    // Compute the center of the side
 4224:    side.center = 0.5*(side.n1->p + side.n2->p);
 4225: 
 4226:    #ifdef USE_FRAMES
 4227:    side.setFrame();
 4228:    #endif
 4229: 
 4230:    // Normal, unitary vector to the side
 4231:    if constexpr(ics == 1) {
 4232:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4233:       side.n = normalize(side.n);
 4234:    }
 4235:    else {
 4236:       // Unit side vector in 3D cartesian coordinates
 4237:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4238:       nSide = normalize(nSide);
 4239: 
 4240:       // It cross product with the unit local z-axis vector (nUp) is the
 4241:       // normal vector we are looking for.
 4242:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4243: 
 4244:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4245:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4246:       side.n = normalize(n2D);      
 4247: 
 4248:    }
 4249: 
 4250:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4251:    side.shapiro = shapiro0;
 4252: 
 4253:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4254:    // XXXX
 4255:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4256:    constexpr double rot_per=3000.0;
 4257:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4258:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4259:    // XXXXX      
 4260:    #endif
 4261:    // Compute the z level at the center of the side
 4262:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4263:    
 4264:    // Compute the length of the side
 4265:    const Vector2 vLen = side.n2->p - side.n1->p;
 4266:    side.len = sqrt(dot(vLen, vLen));
 4267: 
 4268: 
 4269:    // Compute the Coriolis coefficient
 4270: 
 4271:    if constexpr(ncor == -1 || ncor == 0) {
 4272:       side.coriolis = coricoef;
 4273:    }
 4274:    else {
 4275:       const double sphi = side.lat();  // Latitude at the center of the side
 4276: 
 4277:       assert(use_ll && "use_ll must be true when ncor > 0");
 4278: 
 4279:       if constexpr(ics == 1) {
 4280:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4281:       }
 4282:       else { // ics == 2
 4283:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4284:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4285:       }
 4286: 
 4287:    }
 4288: 
 4289: }
 4290: 
 4291: 
 4292: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4293:    double *node_coords, double *node_coords_ll, bool use_ll,
 4294:    double *wind_rotate_angle,   
 4295:    int *isdel, int *isidenode, int *isbnd,
 4296:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4297:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4298:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4299:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4300:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4301:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4302:    double *drag, double *roughness) {
 4303: 
 4304:    ELEM(pelem);
 4305:    Element &elem(*pelem);
 4306:    const int i = idx_elem;
 4307: 
 4308:    elem.idx = i;
 4309: 
 4310:    for (int j = 0; j < i34[i]; j++) {
 4311:       const int idxNode = elnode[i*4 + j];  
 4312:       const int idxSide = elside[i*4 + j];
 4313:       
 4314:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4315:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4316: 
 4317:       // Find the neighboring element  
 4318:       if (elem.sides[j]->elems[0] == &elem) {
 4319:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4320:       }
 4321:       else {
 4322:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4323:       }
 4324:       
 4325:    }
 4326: 
 4327:    elem.i34 = i34[i];
 4328: 
 4329:    // Compute the barycenter of the element and its depth
 4330:    elem.center = {0.0, 0.0};
 4331:    elem.depth = 1e10;
 4332:    for (int j = 0; j < i34[i]; j++) {
 4333: 
 4334:       elem.center += elem.nodes[j]->p/i34[i];
 4335:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4336:    }
 4337: 
 4338:    #ifdef USE_FRAMES
 4339:    elem.setFrame();
 4340:    #endif
 4341: 
 4342:    elem.area = elem.computeSignedArea(); 
 4343:    elem.radius = sqrt(elem.area)/pi; 
 4344:    
 4345:    // Determines which way the normal vector to each side is oriented.
 4346:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4347:    for (int j = 0; j < i34[i]; j++)  
 4348:    {
 4349:       if (elem.sides[j]->elems[0] == &elem) {
 4350:          elem.ssign[j] =  1.0;
 4351:       }
 4352:       else {
 4353:          elem.ssign[j] = -1.0;
 4354:       }
 4355: 
 4356:    }
 4357: 
 4358:   
 4359: 
 4360:    // Derivatives of shape functions
 4361:    //  For ics=2, this is done in the element frame
 4362:    //  For quads, the derivative is evaluated at centroid
 4363:    for (int j = 0; j < elem.i34; j++) {
 4364:       const double area = elem.area;
 4365:       const int id2 = elem.nxq(1 + j);
 4366:       const int id3 = elem.nxq(2 + j);
 4367:       const int id4 = elem.nxq(3 + j);
 4368:       if (elem.isTri()) {
 4369:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4370:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4371:          // da1/dx = (y1 - y2)/(2*area)
 4372: 
 4373:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4374:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4375:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4376: 
 4377:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4378:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4379: 
 4380:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4381: 
 4382:       }
 4383:       else  { // Quad; evaluate at centroid
 4384: 
 4385:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4386:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4387:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4388: 
 4389:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4390:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4391: 
 4392:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4393:       } // if Tri
 4394: 
 4395:    } // for j   
 4396:    
 4397:    
 4398: 
 4399: }
 4400: 
 4401: 
 4402: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4403:                                             double *emo, double *efa, 
 4404:                                             double *umo, double *ufa, 
 4405:                                             double *vmo, double *vfa,
 4406:                                             int *ifltype, int *iettype) {
 4407: 
 4408:    NODE_BND(nodeBnd);
 4409:    const int idx = idx_node_bnd;    
 4410: 
 4411:    nodeBnd->idx = idx;
 4412: 
 4413:    // Need to find the segment index and the index of the node on the segment
 4414:    int idxNode = -1;
 4415:    int iseg, i;
 4416:    for (iseg = 0; iseg < nope; iseg++) {
 4417:       // for each segment...
 4418:       for (i = 0; i < nond[iseg]; i++) {
 4419:          idxNode = iond[iseg + i*nope];
 4420:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4421:          
 4422:       }
 4423:    }
 4424: 
 4425:    assert(iseg < nope && "iseg is out of bounds");
 4426: 
 4427: found: // Jumped here when the node was found
 4428: 
 4429:    nodeBnd->isEssentialBC = true;
 4430:    nodeBnd->elbc = 0.0;
 4431: 
 4432:    nodeBnd->segment->ifltype = ifltype[iseg];
 4433:    nodeBnd->segment->iettype = iettype[iseg];
 4434: 
 4435:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4436: 
 4437:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 4438:       nodeBnd->efa[jfr] = efa[idx2];
 4439:       nodeBnd->emo[jfr] = emo[idx2];
 4440:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4441:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4442: 
 4443:    }
 4444:         
 4445: 
 4446: }
 4447: 
 4448: __device__ void Mesh::populateBoundarySideLinks(void) {
 4449: 
 4450:    SIDE_BND(sideBnd);
 4451:    const int idx = idx_side_bnd;    
 4452: 
 4453:    Side *side = sideBnd->side;
 4454: 
 4455:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4456:    // and the rightSide is the side s that has s->n1 == side->n2
 4457:    for (int i = 0; i < mesh->nbs; i++) {
 4458: 
 4459:       Side *s = &mesh->localSideData[i];
 4460: 
 4461:       if (s == side) continue;  // Do not link the side to itself
 4462:    
 4463:       if (s->n1 == side->n2) sideBnd->leftSide = s;
 4464:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4465:    }
 4466:    
 4467: }
 4468: 
 4469: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4470:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4471:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4472:                 int *isdel, int *isidenode, int *isbnd,
 4473:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4474:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4475:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4476:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4477:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4478:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4479:                 double *drag, double *roughness,
 4480:                 double *emo, double *efa, 
 4481:                 double *umo, double *ufa, 
 4482:                 double *vmo, double *vfa) {
 4483: 
 4484:    printf("Populating mesh for partition %d\n", partNum);
 4485: 
 4486:    // XXXXXX THIS function does almost nothing. 
 4487: 
 4488:    nbs = *sharedIdxSideBoundary + 1;
 4489:    nbp = *sharedIdxNodeBoundary + 1;
 4490: 
 4491:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4492: 
 4493: }
