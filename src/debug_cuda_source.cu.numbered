 2543: 
 2544: __inline__ __device__ void backtrackFromPoint(BTPoint &bkPoint, double dt, double dtbk);
 2545: 
 2546: 
 2547: /**
 2548:  * This method performs backtracking from the side center until a time -dt back in time 
 2549:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2550:  * intermediate point.
 2551:  *
 2552:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2553:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2554:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2555:  * remaining time.
 2556:  * 
 2557:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2558:  * 
 2559:  * @param uuint, vvint, wwint: Velocities at the final point
 2560:  * @param jlev: Level at which the backtracking is performed
 2561:  * @param dt, dtbk: Tracking timesteps
 2562:  * @return: backtracked velocity at the final point
 2563:  */
 2564: __inline__ __device__ Vector2 Side::btrack(
 2565:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2566:       double dt,            // Tracking time
 2567:       double dtbk           // Tracking timestep
 2568: ) const {
 2569: 
 2570:    // Start from side center
 2571:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2572: 
 2573:  
 2574:    double time_rm = dt; // Remaining time
 2575: 
 2576:    BTPoint btPoint(x0, BTPoint::BTPointType::btSide, this->elems[0], const_cast<Side*>(this));
 2577: 
 2578:    btPoint.u = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2579: 
 2580: if (btPoint.elem->idx == 56898) printf("6222 btPoint.elem = %p, btPoint.type = %d\n", btPoint.elem, btPoint.type);
 2581:    backtrackFromPoint(btPoint, dt, dtbk);
 2582: if (btPoint.elem->idx == 56898) printf("6333 btPoint.elem = %p, btPoint.type = %d\n", btPoint.elem, btPoint.type);
 2583: 
 2584:    return toVector2(btPoint.u);
 2585: 
 2586: }
 2587: 
 2588: 
 2589: __device__ void findNextPoint(BTPoint &curPoint, double dtbk);
 2590: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2); 
 2591: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE2(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2); 
 2592: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(BTPoint &curPoint, Point3 &xt);
 2593: __device__ void DEAL_WITH_POINT_MOVING_ALONG_SIDE(BTPoint &curPoint, Point3 &xt);
 2594: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(BTPoint &curPoint, Point3 &xt);
 2595: 
 2596: 
 2597: 
 2598: 
 2599: /**
 2600:  * This function performs backtracking from startPoint until a time -dt back in time from the current time. 
 2601:  * The backtracking is performed using the velocities (u,v,w) at each intermediate point (except at open and land boundaries)
 2602:  *
 2603:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2604:  * a maximum length of dtbk*vel_step, where vel_step is the module of the velocity at that step and dtbk is 
 2605:  * the timestep (of the backtracking). The actual length of the segment can be shorter if the backtracking intersects a side or a node.
 2606:  * 
 2607:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2608:  * 
 2609:  * @param startPoint: Starting point of the backtracking
 2610:  * @param klev: Level at which the backtracking is performed
 2611:  * @param dt: Tracking time
 2612:  * @param dtbk: Tracking timestep
 2613:  
 2614:  */
 2615:  __inline__ __device__ void backtrackFromPoint(BTPoint &bkPoint, double dt, double dtbk) {
 2616: 
 2617:    const int MAX_ITERATIONS = 1000; 
 2618: 
 2619:    double remainingTime = dt; 
 2620: 
 2621:    int iter = 0;
 2622: 
 2623:    while (remainingTime > 0.0) {
 2624:     
 2625:       
 2626:       iter++;
 2627: 
 2628:       // If the velocity is too small, we stop the backtracking
 2629:       if (length(bkPoint.u) <= velmin_btrack) break;
 2630:       
 2631:       assert(iter < MAX_ITERATIONS && "Max iterations reached in backtrackFromPoint");
 2632: 
 2633: 
 2634:       // Finds the next point in the backtracking curve. updates bkPoint.
 2635:       findNextPoint(bkPoint, min(dtbk, remainingTime));
 2636: 
 2637: 
 2638: 
 2639:       remainingTime -= bkPoint.dt;
 2640:    } 
 2641: 
 2642: }
 2643: 
 2644: /**
 2645:  * Finds the next point in the backtracking curve from the current point.
 2646:  * 
 2647:  * @param curPoint      Current backtracking point (input/output - will be updated to next point)
 2648:  * @param dtbk          Maximum timestep for this segment
 2649:  * 
 2650:  * The function handles three cases based on curPoint.type:
 2651:  * - btElement: Point is in element interior
 2652:  * - btSide: Point is on a side
 2653:  * - btNode: Point is at a node
 2654:  * 
 2655:  * The actual timestep may be less than dtbk if an intersection is found.
 2656:  *
 2657:  * For this algorithms, the interior of an element is defined as the 'skinny' element whose shape coordinates are larger than small. A point that is not in the interior
 2658:  * of an element is either outside the mesh, or on a side or node.
 2659:  */
 2660:  __device__ void findNextPoint(BTPoint &curPoint, double dtbk) {
 2661: 
 2662:    const Point3 x0 = curPoint.x;
 2663:    const Vector3 u = curPoint.u;
 2664: 
 2665: DEBUG_INFO();
 2666:    
 2667:    // Calculate target point (backward in time)
 2668:    Point3 xt = x0 - dtbk*u;
 2669: // printf("ZZZZ curPoint.side = %p, curPoint.elem = %p, curPoint.node = %p, curPoint.type = %d\n", curPoint.side, curPoint.elem, curPoint.node, curPoint.type);
 2670:    // The current point always 'belongs' to an element (even if it is a node or a side, in which case it is one of the elements sharing the node or the side).
 2671:    // This element is used to interpolate the velocity.
 2672:    const Element *elem = curPoint.elem;  
 2673:    assert(elem != nullptr && "elem is nullptr in findNextPoint");
 2674: 
 2675:    curPoint.dt = dtbk;
 2676: 
 2677: // printf("BBBBB curPoint.type = %d, elem->idx = %d\n", curPoint.type, elem->idx);   
 2678:  
 2679:    // How the next point is found depends on the type of the current point:
 2680:    switch (curPoint.type) {
 2681:       
 2682:       case BTPoint::BTPointType::btElement: {  // Starting from element interior...
 2683: DEBUG_INFO();
 2684: 
 2685:          // When starting from the interior of an element, the next point is either in the interior of the same element, or it will intersect a side or a node.
 2686: // printf("4 elem = %p\n", elem);      
 2687: ShapeCoords shpCoord;   
 2688: elem->computeShapeCoords(toVector2(xt), shpCoord); // XXXX
 2689: DEBUG_INFO();
 2690:          // If the target point is still inside the 'skinny' element, the next point is in the element interior
 2691:          if (elem->containsPoint2(toPoint2(xt))) {
 2692:             // Still inside element -> next point is in element interior
 2693:             // In this case, the next point is in the interior of the same element.
 2694:             curPoint.x = xt;
 2695:             curPoint.dt = dtbk;
 2696:             // The rest of fields of curPoint do not change in this case (except for u, which is computed at the end)
 2697:             addDebugPlot(x0, xt, 0xDF401F, '+');            
 2698: 
 2699:          } else {
 2700:             // Target point is outside -> An intersection with element boundary is *guaranteed*.
 2701:             // In this case, the next point is on a side or a node.
 2702: // printf("AAxxA3\n");            
 2703:             DEAL_WITH_POINT_INTERSECTING_SIDE2(curPoint, xt, nullptr, nullptr);
 2704: // printf("AAxxA4  elem->idx = %d\n", curPoint.elem->idx);            
 2705:             addDebugPlot(x0, xt, 0x1FF01F, 'o');            
 2706:  
 2707:          }
 2708: DEBUG_INFO();
 2709: 
 2710:       }
 2711: 
 2712:       break;
 2713:       
 2714: 
 2715:       case BTPoint::BTPointType::btSide: {  // Starting from a side...
 2716:       
 2717: DEBUG_INFO();
 2718:          // In this case there are four main possibilities:
 2719:          // - xt is in the interior of one of the elements sharing the side.
 2720:          // - x0xt intersects the sides of one of the elements sharing the side (not including the shared side).
 2721:          // - x0xt is collinear with the shared side.
 2722:          // - xt is outside the mesh.
 2723: 
 2724:          const Side *side = curPoint.side;
 2725: 
 2726:          assert(!(side->isDry) && "Side is dry");
 2727: 
 2728:          Element *e1 = side->elems[0];
 2729:          Element *e2 = side->elems[1];
 2730: 
 2731:          assert((e1 != nullptr && !e1->isDry) || (e2 != nullptr && !e2->isDry) && "Side has no wet elements");
 2732: 
 2733:          // e2 can be nullptr if the side is a boundary side.
 2734:          const bool isInsideE1 =  e1 != nullptr && !e1->isDry && e1->containsPoint2(toPoint2(xt));
 2735:          const bool isInsideE2 = (e2 != nullptr && !e2->isDry && !isInsideE1) ? e2->containsPoint2(toPoint2(xt)) : false;
 2736:               
 2737: DEBUG_INFO();   
 2738: 
 2739:          // Check if it is inside one of the elements
 2740:          if (isInsideE1 || isInsideE2) {
 2741:             // If it is inside one of the elements, the next point is in the interior of an element.
 2742:             
 2743:             Element *nextElem = isInsideE1?e1:e2;
 2744: DEBUG_INFO();
 2745:             assert(!(nextElem->isDry) && "Element is dry"); // XXXX 
 2746:             // The new current point will be the target point
 2747:             curPoint.x = xt;
 2748:             curPoint.type = BTPoint::BTPointType::btElement;
 2749:             curPoint.elem = nextElem;
 2750: assert(nextElem!=nullptr && !nextElem->isDry && "EEEE3");
 2751:             curPoint.side = nullptr;
 2752:             curPoint.node = nullptr;
 2753:             curPoint.t = 0.0; 
 2754:             curPoint.dt = dtbk;
 2755: DEBUG_INFO();            
 2756: 
 2757:          } else {  // Point xt is not inside one of the elements sharing the side...
 2758: DEBUG_INFO(); 
 2759:             // The element is either along the current side or intersects the sides of one of the elements sharing the side.
 2760: 
 2761:             // Checks if x0xt is collinear with the side in a consistent way.
 2762:             const double lenSide = side->len;
 2763:             const Vector2 v2 = toPoint2(xt) - toPoint2(x0);
 2764:             const double lenX0Xt = length(v2);
 2765:             bool isAlongSide = false;
 2766: DEBUG_INFO();
 2767:             if (lenSide > lenX0Xt) { // if x0xt is shorter than the side...
 2768: DEBUG_INFO();
 2769:                isAlongSide = side->containsPoint(toPoint2(xt));
 2770:             }
 2771:             else { // if x0xt is longer than the side...
 2772: DEBUG_INFO();
 2773:                // Computes a smaller collinear segment that starts at x0 and has length lenSide. The end point of this segment must be on the side.
 2774:                const Point2 xtmp = toPoint2(x0) + v2*lenSide/lenX0Xt;
 2775:                isAlongSide = side->containsPoint(xtmp);
 2776: DEBUG_INFO();
 2777: 
 2778:             }
 2779: DEBUG_INFO(); 
 2780:             if (isAlongSide) {
 2781:                // x0xt is contained in the same side x0 is on.
 2782:                DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 2783: 
 2784: addDebugPlot(x0, curPoint.x, 0x1FF01F, '+');
 2785:             } else {
 2786: 
 2787:                // Gets the element that is in the direction opposite to the velocity vector (remember that we are backtracking)
 2788:                Element *nextElem = side->findElementTowards(toVector2(u));
 2789:              
 2790:                
 2791: 
 2792:                if (nextElem == nullptr || nextElem->isDry) {
 2793:                   // The segment goes out of water.
 2794:                   DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(curPoint, xt);
 2795:                   
 2796:                } else {
 2797:                   // x0xt intersects another side of the element.
 2798:                   
 2799:                   curPoint.elem = nextElem;
 2800:                   assert(curPoint.elem != nullptr && "curPoint.elem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2801: 
 2802:                   // This is a situation we know how to handle. 
 2803:                   printf("DDD2, nextElem = %p, nextElem->isDry = %d\n", nextElem, nextElem->isDry);                              
 2804:                   DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, side, nullptr);
 2805:                   printf("DDD3\n");
 2806:                }
 2807: 
 2808:             }
 2809:          
 2810:          }
 2811: 
 2812:       }
 2813: DEBUG_INFO();
 2814: addDebugPlot(x0, xt, 0x4FD01F, '+');        
 2815: DEBUG_INFO();
 2816:       break;
 2817:       
 2818:       case BTPoint::BTPointType::btNode: {  // Starting from a node...
 2819: DEBUG_INFO();
 2820:          const Node *node = curPoint.node;
 2821: 
 2822:          printf("btNode, node = %p\n", node);         
 2823:          
 2824:          // Check if the xt is inside one of the elements sharing the node
 2825:          for (int i = 0; i < node->numElements; i++) {
 2826:             Element *e = node->elements[i];
 2827: 
 2828:             
 2829:             if (e->containsSegment(node, toPoint2(xt))) {
 2830:                // This means that x0xt is contained in the element (in the sense that the wedge formed by the node and its adjacent sides includes the segment x0xt). 
 2831:                // This is in a 'fat' sense, meaning that it covers the cases where x0xt is actually along one of these sides.
 2832: 
 2833:                
 2834:                if (e->isDry) {
 2835: printf("AAA1, curPoint.elem = %p, e = %p, curPoint.elem->isDry = %d\n", curPoint.elem, e, curPoint.elem->isDry);                  
 2836:                   DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(curPoint, xt);
 2837:                   return;
 2838: 
 2839:                }
 2840: 
 2841:                if (e->containsPoint2(toPoint2(xt))) {
 2842:                   // xt is contained in the element
 2843:                   curPoint.x = xt;
 2844:                   curPoint.dt = dtbk;
 2845:                   curPoint.type = BTPoint::BTPointType::btElement;
 2846:                   curPoint.elem = e;
 2847: assert(e !=nullptr && !e->isDry && "EEEE1");                  
 2848:                   curPoint.side = nullptr;
 2849:                   curPoint.node = nullptr;
 2850:                   return;
 2851: 
 2852:                } else {
 2853:                   // xt must intersect one of the opposite sides of the element
 2854:                   int idxSide1, idxSide2;
 2855:                   e->getSidesContainingNode(node, idxSide1, idxSide2);
 2856:                   const Side *side1 = e->sides[idxSide1];
 2857:                   const Side *side2 = e->sides[idxSide2];
 2858:                   curPoint.elem = e;
 2859: assert(e !=nullptr && !e->isDry && "EEEE2");
 2860:                   printf("DDD3a\n");                              
 2861:                   DEAL_WITH_POINT_INTERSECTING_SIDE(curPoint, xt, side1, side2);
 2862:                   printf("DDD3b\n");                              
 2863:                   return;
 2864:                }
 2865:                   
 2866:             } 
 2867:             
 2868: 
 2869:          } 
 2870: printf("AAA2aaaa\n");         
 2871: if (curPoint.node != nullptr) printf("AAA2 curPoint.node.idx = %d, node.p = %.17f, %.17f\n", curPoint.node->idx, curPoint.node->p.x, curPoint.node->p.y);                  
 2872: else printf("AAA2 curPoint.node = nullptr\n");                  
 2873:          // computes the maximal contiguous block of wet elements containing curPoint.elem.
 2874:          DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(curPoint, xt);    
 2875: DEBUG_INFO();         
 2876:       }
 2877: 
 2878:    } // switch
 2879: DEBUG_INFO();
 2880: // if (curPoint.elem == 0) curPoint.elem = curPoint.side->elems[0];
 2881: // if (curPoint.side != nullptr && curPoint.side->idx == 5) printf("6 curPoint.type = %d, curPoint.elem = %p\n", curPoint.type, curPoint.elem);
 2882: if (curPoint.elem->idx == 16191) printf("6 curPoint.elem = %p, type = %d, dtbk = %.17f, curPoint.elem = %p, curPoint.side = %p\n", curPoint.elem, curPoint.type, curPoint.dt, curPoint.elem, curPoint.side);
 2883: if (curPoint.elem == nullptr) printf("XXXXXXXXXXXXX curPoint.side = %p\n", curPoint.side);
 2884:    // Interpolates the velocities at the next point
 2885:    assert(curPoint.elem != nullptr && "curPoint.elem is nullptr");
 2886:    curPoint.elem->interpolateVelocities(curPoint.x, curPoint.u);
 2887: if (curPoint.elem->idx == 16191) printf("6222 curPoint.elem = %p, type = %d\n", curPoint.elem, curPoint.type);
 2888: DEBUG_INFO();
 2889: }
 2890: 
 2891: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2) {
 2892:    // This function deals with the case where the segment x0xt intersects a side of the element that is not one of the two sides to exclude.
 2893: // if (it>=115) printf("ZZZZZ1 curPoint.type = %d, curPoint.elem.idx = %d, curPoint.side = %p\n", curPoint.type, curPoint.elem->idx, curPoint.side);
 2894: Element *oldelem = curPoint.elem;
 2895:    Side *intersectSide = nullptr;
 2896:    Element *nextElem = nullptr;
 2897:    double t, tIntersect;
 2898: 
 2899:    const Point2 x1 = toPoint2(curPoint.x);
 2900:    const Point2 x2 = toPoint2(xt);
 2901:    const Element *elem = curPoint.elem;
 2902: 
 2903:    assert(elem != nullptr && "elem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2904: 
 2905:    // assert( elem->containsPoint2(x1) && "Starting point is not inside the element");                                    
 2906:    assert(!elem->containsPoint2(x2) && "Ending point is not outside the element");
 2907: 
 2908:    double closest_intersect_t = 1e10;
 2909:    bool found_intersection = false;
 2910:    double tt1, tt2, last_tt2 = 77777777.0; // XXXXXX
 2911:    for (int i = 0; i < elem->i34; i++) {
 2912: 
 2913:       Side *side = elem->sides[i];
 2914: 
 2915: assert(side != nullptr && "side is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2916: 
 2917:       if (excludeSide1 == side || excludeSide2 == side) continue;
 2918: 
 2919:       // (x3,y3)-(x4,y4) is the element side line
 2920:       const Point2 x3 = side->n1->p;
 2921:       const Point2 x4 = side->n2->p;
 2922: 
 2923:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2924:       const double delta = cross(x2 - x1, x3 - x4);
 2925: 
 2926:       if (abs(delta) > 0) {
 2927: 
 2928:          const double delta1 = cross(x3 - x1, x3 - x4);
 2929:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2930: 
 2931:          // Solves the two linear equations for tt1 and tt2
 2932:          tt1 = delta1/delta; // delta is not zero, so we can divide
 2933:          tt2 = delta2/delta;
 2934: 
 2935:          // Computes a distance to interval [0,1]
 2936:          const double distTo01 = max3(0.0, -tt1, tt1 - 1.0);
 2937: 
 2938:          if (closest_intersect_t > distTo01) {
 2939:             intersectSide = side;
 2940:             closest_intersect_t = distTo01;
 2941:             nextElem = side->otherElem(elem);
 2942:             found_intersection = true;
 2943:             last_tt2 = tt2;
 2944:          }
 2945: 
 2946:       }
 2947: 
 2948:    } // for
 2949: 
 2950:    assert(found_intersection && "No intersection found in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2951:    assert(intersectSide != nullptr && "intersectSide is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2952:    
 2953: 
 2954: 
 2955:    // if (nextElem == nullptr) printf("LLLL intersectSide->elems[0]->isDry = %d\n", intersectSide->elems[0]->isDry);
 2956: 
 2957:    // if (nextElem == nullptr && intersectSide->elems[1] != nullptr) printf("LLLL intersectSide->elems[1]->isDry = %d\n", intersectSide->elems[1]->isDry);
 2958:    if (nextElem == nullptr) nextElem = intersectSide->elems[0];  // elems[0] is never nullptr. This is done in case the element is not set yet.
 2959:    assert(nextElem != nullptr && "nextElem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 2960: 
 2961:    
 2962:    if (last_tt2 < geometricEpsilon) {
 2963:       curPoint.type = BTPoint::BTPointType::btNode;
 2964:       curPoint.node = intersectSide->n1;
 2965:       curPoint.side = intersectSide;
 2966:       curPoint.t = 0.0; 
 2967: 
 2968:    }
 2969:    else if (last_tt2 > 1.0 - geometricEpsilon) {
 2970:       curPoint.type = BTPoint::BTPointType::btNode;
 2971:       curPoint.node = intersectSide->n2;
 2972:       curPoint.side = intersectSide;
 2973:       curPoint.t = 1.0; 
 2974:       
 2975:    }
 2976:    else {
 2977:       curPoint.type = BTPoint::BTPointType::btSide;
 2978:       curPoint.side = intersectSide;
 2979:       curPoint.node = nullptr;
 2980:       curPoint.t = last_tt2;
 2981:    }
 2982: 
 2983:    curPoint.elem = nextElem;
 2984:    curPoint.dt = curPoint.dt*closest_intersect_t;
 2985:    toPoint2(curPoint.x) = intersectSide->p_t(curPoint.t);
 2986:    curPoint.x.z = (1.0 - closest_intersect_t)*curPoint.x.z + closest_intersect_t*xt.z;
 2987: if (it>=115) printf("ZZZZZ2 curPoint.type = %d, oldelem.idx = %d, newelem.idx = %d, IDX(curPoint.side) = %d IDX(curPoint.side->n1) = %d IDX(curPoint.side->n2) = %d\n", curPoint.type, oldelem->idx, nextElem->idx, curPoint.side->idx, curPoint.side->n1->idx, curPoint.side->n2->idx);
 2988: 
 2989: }
 2990: 
 2991: 
 2992: 
 2993: __device__ void DEAL_WITH_POINT_INTERSECTING_SIDE2(BTPoint &curPoint, Point3 &xt, const Side *excludeSide1, const Side *excludeSide2) {
 2994:    // This function deals with the case where the segment x0xt intersects a side of the element that is not one of the two sides to exclude.
 2995: // if (it>=115) printf("ZZZZZ1 curPoint.type = %d, curPoint.elem.idx = %d, curPoint.side = %p\n", curPoint.type, curPoint.elem->idx, curPoint.side);
 2996: Element *oldelem = curPoint.elem;
 2997:    Side *intersectSide = nullptr;
 2998:    Element *nextElem = nullptr;
 2999:    double t, tIntersect;
 3000: 
 3001:    const Point2 x1 = toPoint2(curPoint.x);
 3002:    const Point2 x2 = toPoint2(xt);
 3003:    const Element *elem = curPoint.elem;
 3004: 
 3005:    assert(elem != nullptr && "elem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3006: 
 3007:    // assert( elem->containsPoint2(x1) && "Starting point is not inside the element");                                    
 3008:    assert(!elem->containsPoint2(x2) && "Ending point is not outside the element");
 3009: 
 3010:    double closest_intersect_t = 1e10;
 3011:    bool found_intersection = false;
 3012:    double tt1, tt2, last_tt2 = 77777777.0; // XXXXXX
 3013:    for (int i = 0; i < elem->i34; i++) {
 3014: 
 3015:       Side *side = elem->sides[i];
 3016: 
 3017: assert(side != nullptr && "side is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3018: 
 3019:       if (excludeSide1 == side || excludeSide2 == side) continue;
 3020: 
 3021:       // (x3,y3)-(x4,y4) is the element side line
 3022:       const Point2 x3 = side->n1->p;
 3023:       const Point2 x4 = side->n2->p;
 3024: 
 3025:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 3026:       const double delta = cross(x2 - x1, x3 - x4);
 3027: 
 3028:       if (abs(delta) > 0) {
 3029: 
 3030:          const double delta1 = cross(x3 - x1, x3 - x4);
 3031:          const double delta2 = cross(x2 - x1, x3 - x1); 
 3032: 
 3033:          // Solves the two linear equations for tt1 and tt2
 3034:          tt1 = delta1/delta; // delta is not zero, so we can divide
 3035:          tt2 = delta2/delta;
 3036: 
 3037:          // Computes a distance to interval [0,1]
 3038:          const double distTo01 = max3(0.0, -tt1, tt1 - 1.0);
 3039: 
 3040:          if (closest_intersect_t > distTo01) {
 3041:             intersectSide = side;
 3042:             closest_intersect_t = distTo01;
 3043:             nextElem = side->otherElem(elem);
 3044:             found_intersection = true;
 3045:             last_tt2 = tt2;
 3046:          }
 3047: 
 3048:       }
 3049: 
 3050:    } // for
 3051: 
 3052:    assert(found_intersection && "No intersection found in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3053:    assert(intersectSide != nullptr && "intersectSide is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3054:    
 3055: 
 3056: 
 3057:    // if (nextElem == nullptr) printf("LLLL intersectSide->elems[0]->isDry = %d\n", intersectSide->elems[0]->isDry);
 3058: 
 3059:    // if (nextElem == nullptr && intersectSide->elems[1] != nullptr) printf("LLLL intersectSide->elems[1]->isDry = %d\n", intersectSide->elems[1]->isDry);
 3060:    if (nextElem == nullptr) nextElem = intersectSide->elems[0];  // elems[0] is never nullptr. This is done in case the element is not set yet.
 3061:    assert(nextElem != nullptr && "nextElem is nullptr in DEAL_WITH_POINT_INTERSECTING_SIDE");
 3062: 
 3063: //  printf("YYYYY1 intersectSide = %p, n1 = %d, n2 = %d, last_tt2 = %.16f\n", intersectSide, intersectSide->n1->idx, intersectSide->n2->idx, last_tt2);
 3064: // printf("TTTTTT last_tt2 = %.16f geometricEpsilon = %.16f  intersectSide = %p, sizeof(BTPointType) = %d\n", last_tt2, geometricEpsilon, intersectSide, sizeof(BTPoint::BTPointType));
 3065: // printf("TTTTTT curPoint.type = %d, it = %d\n", curPoint.type, it);
 3066: 
 3067:    if (last_tt2 < geometricEpsilon) {
 3068:       curPoint.type = BTPoint::BTPointType::btNode;
 3069:       curPoint.node = intersectSide->n1;
 3070:       curPoint.side = intersectSide;
 3071:       curPoint.t = 0.0; 
 3072: 
 3073:    }
 3074:    else if (last_tt2 > 1.0 - geometricEpsilon) {
 3075:       curPoint.type = BTPoint::BTPointType::btNode;
 3076:       curPoint.node = intersectSide->n2;
 3077:       curPoint.side = intersectSide;
 3078:       curPoint.t = 1.0; 
 3079:       
 3080:    }
 3081:    else {
 3082: return;
 3083: 
 3084: unsigned long long type_addr = (unsigned long long)&curPoint.side;
 3085: unsigned long long type_size = sizeof(BTPoint::BTPointType);
 3086: unsigned long long align_mask = 15;
 3087: unsigned long long type_offset = (type_addr & align_mask);
 3088: // printf("TTTTTT type_addr = %llu, type_size = %llu, align_mask = %llu, type_offset = %llu\n", type_addr, type_size, align_mask, type_offset);
 3089: curPoint.type= curPoint.type;
 3090:       // curPoint.type = BTPoint::BTPointType::btSide;
 3091:       curPoint.side = intersectSide;
 3092:       curPoint.node = nullptr;
 3093:       curPoint.t = last_tt2;
 3094:    }
 3095: 
 3096:    curPoint.elem = nextElem;
 3097:    curPoint.dt = curPoint.dt*closest_intersect_t;
 3098:    toPoint2(curPoint.x) = intersectSide->p_t(curPoint.t);
 3099:    curPoint.x.z = (1.0 - closest_intersect_t)*curPoint.x.z + closest_intersect_t*xt.z;
 3100: if (it>=115) printf("ZZZZZ2 curPoint.type = %d, oldelem.idx = %d, newelem.idx = %d, IDX(curPoint.side) = %d IDX(curPoint.side->n1) = %d IDX(curPoint.side->n2) = %d\n", curPoint.type, oldelem->idx, nextElem->idx, curPoint.side->idx, curPoint.side->n1->idx, curPoint.side->n2->idx);
 3101: return;
 3102: }
