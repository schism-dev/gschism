 8803: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8804:    // Get the value of a variable from an side
 8805:    // varName is the name of the variable to get
 8806:    // var is the array to store the value
 8807:    // k is the vertical level index of the variable to get
 8808:    SIDE_BND(sideBnd);   
 8809: 
 8810:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8811:    if (sideBnd->segment->isLand) idx = -7;
 8812: 
 8813:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8814:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8815: 
 8816: }
