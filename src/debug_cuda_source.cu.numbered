 2580: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2581:    // Check if the point (xt,yt) is inside the element.
 2582:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2583:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (2)");
 2584: 
 2585:    double shpCoords[4];
 2586:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2587: 
 2588:    return res;
 2589: }
 2590: 
 2591: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2592:    // Check if the point (xt,yt) is inside the element.
 2593:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2594:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2595:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (3)");
 2596: 
 2597:    double shpCoords[4];
 2598:    Vector2 tmp_xt = xt;
 2599:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2600: printf("HEREEEEEE\n");
 2601:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2602: 
 2603:    if (fixCoords && res) xt = tmp_xt;
 2604: 
 2605:    return res;
 2606: }
