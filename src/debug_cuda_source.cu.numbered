 1130:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
 1131:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
 1132:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
