 3927: extern "C" {
 3928:    __global__ void rollUpElevation(void) {
 3929: 
 3930:       NODE(node);
 3931: 
 3932:       node->eta1 = node->eta2;
 3933: 
 3934:    }
 3935: 
 3936: 
 3937:    __global__ void backtrackAllNodes(void) {
 3938: 
 3939:       // max/min # of sub-divisions
 3940:       const int ndelt_max = max(1.0, dt/dtb_min);
 3941:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3942: 
 3943:       // Removed all references to swild98 XXX
 3944:       // swild98=0.d0 !init
 3945: 
 3946: 
 3947:       SIDE(side);
 3948: 
 3949:       const int kb = side->kb;
 3950: 
 3951: 
 3952:       // Initialize btrack velocities to the actual velocities at the side 
 3953:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3954: 
 3955:       if (side->isDry) return;
 3956: 
 3957: 
 3958:       // Checks that at least one element is not dry
 3959:       const Element *elem1 = side->elems[0];
 3960:       const Element *elem2 = side->elems[1];
 3961: 
 3962: 
 3963:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3964:       
 3965:       // XXXXXX
 3966:       // !swild_tmp to store global coord. of the starting side
 3967:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3968:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3969:       // !Use sframe2 
 3970:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3971: 
 3972: 
 3973:       for (int k = kb; k < nvrt; k++) {
 3974:       //  Initialize (xt,yt,zt), nnel and vel.
 3975:       //  For ics=2, the coordinates are in local frames
 3976:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3977: 
 3978: 
 3979:          const int iadvf = side->iadv();  // Advection flag
 3980: 
 3981:          Point3 xt;
 3982:          if constexpr(ics==1) {
 3983:             xt = side->center3D(k); 
 3984:          }
 3985:          else // lat/lon; in side lat/lon frame
 3986:          {
 3987:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3988:          // XXX IMPLEMENT THIS
 3989:       //          xt=0.d0
 3990:       //          yt=0.d0
 3991:       //          !centroid coord. for nudging
 3992:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3993:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3994:          }  // ics
 3995: 
 3996: 
 3997: 
 3998:          // If on land or open boundary...
 3999:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4000:          
 4001:          const double vmag = length(side->u2[k]);
 4002: 
 4003:          if (vmag <= velmin_btrack) {
 4004:             // No activity 
 4005: 
 4006:             side->btu[k] = side->u2[k];
 4007:             
 4008:          } else {  // do btrack
 4009: 
 4010:             // Compute number of sub-divisions based on local gradients 
 4011:             // XXX IS THIS NECESSARY?
 4012:             double suma = 0.0;
 4013:             int icount = 0;
 4014:             for (int ii=0; ii<2; ii++) {
 4015: 
 4016:                const Element *elem = side->elems[ii];
 4017:                  
 4018:                if (elem == nullptr) continue;
 4019: 
 4020:                icount++;
 4021: 
 4022:                // Not strictly along z; in ll frame for ics=2
 4023: 
 4024:                double utmp[4];
 4025:                double vtmp[4];
 4026:                for (int jj = 0; jj < elem->i34; jj++) {
 4027: 
 4028:                   const Node *node = elem->nodes[jj];
 4029: 
 4030:                   if constexpr(ics==1) {
 4031:                      utmp[jj] = node->u2[k].x;
 4032:                      vtmp[jj] = node->u2[k].y;  
 4033:                   } else {
 4034:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4035:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 4036:                   }
 4037:                } // for jj
 4038: 
 4039:                const Vector2 grad_u = elem->grad2(utmp); 
 4040:                const Vector2 grad_v = elem->grad2(vtmp);
 4041: 
 4042:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4043:             } // for ii
 4044: 
 4045:             assert(icount > 0 && "Impossible 77");
 4046: 
 4047:             // '4' is somewhat arbitrary
 4048:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4049: 
 4050:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4051:          
 4052: 
 4053:             Vector3 u_int = {0.0, 0.0, 0.0};
 4054: 
 4055:             side->btrack(k, dt, dtbk, u_int);
 4056:             side->btu[k] = toVector2(u_int);
 4057:                
 4058:          } // if vmag (do backtrack)
 4059: 
 4060:       } // for k=kb,nvrt-1
 4061: 
 4062:    }
 4063: 
 4064: } // extern "C"
 4065: 
 4066: template<int nc>
 4067: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4068: 
 4069: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4070: //
 4071: // a,b,c,rhs: input vectors and are not modified by this program.
 4072: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4073: // rhs is the r.h.s.
 4074: // n: actual rank of the system.
 4075: // rows in u() and rhs();
 4076: // u: output with nc columns (transposed to rows)
 4077: // gam: a working array.
 4078: //
 4079: // NOTES:
 4080: // This is a template function that allows for different numbers of columns in the rhs vector.
 4081: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4082: 
 4083:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4084:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4085: 
 4086:    double bet = b[0];
 4087:    if constexpr (nc == 1) {
 4088:       u[0] = rhs[0]/bet;
 4089:    } else {
 4090:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4091:    }
 4092: 
 4093:    for (int j = 1; j < n; j++) {
 4094:       gam[j] = c[j - 1]/bet;
 4095:       bet = b[j] - a[j]*gam[j];
 4096: 
 4097:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4098: 
 4099:       if constexpr (nc == 1) {
 4100:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4101:       } else {
 4102:          for (int l = 0; l < nc; l++) {
 4103:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4104:          }
 4105:       }
 4106:    }
 4107: 
 4108:    // Back-substitution
 4109:    for (int j = n - 2; j >= 0; j--) {
 4110:       if constexpr (nc == 1) {
 4111:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4112:       } else {
 4113:          for (int l = 0; l < nc; l++) {
 4114:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4115:          }
 4116:       }
 4117:    }
 4118: }
 4119: 
 4120: 
 4121: 
 4122: // Helper function that contains the core algorithm
 4123: template<typename XAccessor, typename YAccessor>
 4124: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4125:                                     double  yp_top, double  yp_bot, 
 4126:                                     CubicSpline &spline) {
 4127:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4128:    // 
 4129:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4130:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4131:    //
 4132:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4133:    // 
 4134:    // Inputs: 
 4135:    //            n: dimension for x etc; # of data pts (>=2);
 4136:    //            getX, getY: functions to access x,y coordinates
 4137:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4138:    //     Output: 
 4139:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4140: 
 4141:    const int n = k2 - k1 + 1;
 4142:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4143: 
 4144:    // Allocate memory for the splines
 4145:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4146:    spline.x   = new double[n];
 4147:    spline.y   = new double[n];
 4148:    spline.yp  = new double[n];
 4149:    spline.ypp = new double[n];
 4150: 
 4151:    for (int k=k1; k<=k2; k++) {
 4152:       spline.x[k] = getX(k);
 4153:       spline.y[k] = getY(k);
 4154:    }
 4155: 
 4156:    // This is to simplify expressions later
 4157:    double *x = spline.x;
 4158:    double *y = spline.y;
 4159: 
 4160:    double *a = nullptr;
 4161:    double *b = nullptr;
 4162:    double *c = nullptr;
 4163:    double *gam = nullptr;
 4164:    double *rhs = nullptr;
 4165:    
 4166: 
 4167:       a = new double[n];   // Lower diagonal
 4168:       b = new double[n];   // Diagonal
 4169:       c = new double[n];   // Upper diagonal
 4170:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4171:       rhs = new double[n]; // Right-hand side
 4172: 
 4173:    for (int k=k1; k<=k2; k++) {
 4174:       if (k == k1) {
 4175:          // Bottom level
 4176:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4177:          b[k] = (x[k+1] - x[k])/3.0;
 4178:          c[k] = b[k]/2.0;
 4179:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4180:       } else if (k == n - 1) {
 4181:          // Top level (surface)
 4182:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4183:          b[k] = (x[k] - x[k-1])/3.0;
 4184:          a[k] = b[k]/2.0;
 4185:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4186:       } else {
 4187:          // Intermediate levels
 4188:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4189:          b[k] = (x[k+1] - x[k-1])/3.0;
 4190:          a[k] = (x[k  ] - x[k-1])/6.0;
 4191:          c[k] = (x[k+1] - x[k  ])/6.0;
 4192:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4193:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4194:       }
 4195:    }
 4196: 
 4197:    // Solve the tridiagonal system
 4198:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4199:    
 4200:    spline.yp[k1] = yp_bot;
 4201:    spline.yp[k2] = yp_top;
 4202: 
 4203:    // Compute rest of 1st derivatives using the splines
 4204:    for (int k=k1+1; k<k2; k++) {
 4205:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4206:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4207:    }
 4208:    
 4209:    delete[] a;
 4210:    delete[] b;
 4211:    delete[] c;
 4212:    delete[] gam;
 4213:    delete[] rhs;
 4214: 
 4215: }
 4216: 
 4217: // Array version
 4218: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4219:                                 double y_top, double y_bot, 
 4220:                                 CubicSpline &spline) {
 4221:    auto getX = [x] (int k) { return x[k]; };
 4222:    auto getY = [y] (int k) { return y[k]; };
 4223:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4224: }
 4225: 
 4226: // Lambda version - allows custom access patterns
 4227: template<typename XFunc, typename YFunc>
 4228: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4229:                                 double y_top, double y_bot,
 4230:                                 CubicSpline &spline) {
 4231:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4232: }
 4233: 
