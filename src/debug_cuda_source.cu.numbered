 8007:          break;
 8008:       // case (int)VarCode::depth:
 8009:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 8010:       //    *sizeType = sizeof(double);
 8011:       //    break;         
 8012:       case (int)VarCode::x:
 8013:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 8014:          *sizeType = sizeof(Vector2);
 8015:          break;
 8016:       case (int)VarCode::len:
 8017:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 8018:          *sizeType = sizeof(double);
 8019:          break;
 8020:       case (int)VarCode::kb:
 8021:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 8022:          *sizeType = sizeof(int);
 8023:          break;
 8024:       case (int)VarCode::isdry:
 8025:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8026:          *sizeType = sizeof(int);
 8027:          break;            
 8028:       case (int)VarCode::w:
 8029:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8030:          *sizeType = sizeof(double);
 8031:          break;
 8032:       case (int)VarCode::u:
 8033:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8034:          *sizeType = sizeof(Vector2);
 8035:          break;   
 8036:       case (int)VarCode::n1:
 8037:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8038:          *sizeType = sizeof(Node);
 8039:          break;
 8040:       case (int)VarCode::n2:
 8041:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8042:          *sizeType = sizeof(Node);
 8043:          break;                   
 8044:       default:
 8045:          *offset = -1;
 8046:    }
 8047: }
