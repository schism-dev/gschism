 1726: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1727:    return;
 1728:    // Lock the mutex
 1729:    lock(&debugPlotMutex);
 1730:  
 1731:    bool ok = true;
 1732:    if (debugPlotIdx == nullptr) ok = false;
 1733:    if (*debugPlotIdx >= 10000) ok = false;
 1734:    if (ok) {
 1735:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1736:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1737:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1738:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1739:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1740:       (*debugPlotIdx)++;
 1741:    }
 1742: 
 1743:    __threadfence();               // ensure all above writes are visible
 1744:    // Unlock the mutex
 1745:    unlock(&debugPlotMutex);
 1746: 
 1747: }
