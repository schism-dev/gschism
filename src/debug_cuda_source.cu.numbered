 3865: extern "C" {
 3866:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3867:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3868:                                   int* indices, int* indptr) {
 3869: 
 3870:       NODE(node);
 3871:       
 3872:       const int idx = node->idx;
 3873:       
 3874:       // Computes the index in the nzz array      
 3875:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3876: 
 3877: 
 3878:       indptr[idx] = nzzIdx;
 3879:       indices[nzzIdx] = idx;
 3880: 
 3881:       data_d[nzzIdx]    = node->coeffDiag;
 3882:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3883: 
 3884:       diag_d[idx] = 1.0/node->coeffDiag;
 3885:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3886: 
 3887:       b_d[idx] = node->qel;
 3888:       b_f[idx] = (float)node->qel;
 3889: 
 3890:       for (int k = 0; k < node->numNodes; ++k) {
 3891:          const Node* nb = node->nodes[k];
 3892: 
 3893:          const int j = nb->idx;
 3894: 
 3895:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3896:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3897: 
 3898:          indices[nzzIdx + k + 1] = j;
 3899:       }
 3900: 
 3901: 
 3902:    }
 3903: }
