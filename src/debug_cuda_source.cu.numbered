  193: using Vector2 = double2; 
  194: using Vector3 = double3;
  195: using Point2  = double2;
  196: using Point3  = double3;
  197: 
  198: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  199:     return make_double2(a.x + b.x, a.y + b.y);
  200: }
  201: using Vector2 = double2; 
  202: using Vector3 = double3;
  203: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  204:     a.x += b.x;
  205:     a.y += b.y;
  206:     return a;
  207: }
  208: 
  209: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  210:     return make_double2(a.x - b.x, a.y - b.y);
  211: }
  212: 
  213: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  214:     a.x -= b.x;
  215:     a.y -= b.y;
  216:     return a;
  217: }
  218: 
  219: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  220:     return make_double2(v.x * s, v.y * s);
  221: }
  222: 
  223: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  224:     return v * s;  // reuse the previous operator
  225: }
  226: 
  227: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  228:     return make_double2(v.x / s, v.y / s);
  229: }
  230: 
  231: __device__ __forceinline__ double norm2(const double2& v) {
  232:     return v.x*v.x + v.y*v.y;
  233: }
  234: 
  235: __device__ __forceinline__ double length(const double2& v) {
  236:     return sqrt(v.x*v.x + v.y*v.y);
  237: }
  238: 
  239: __device__ __forceinline__ double2 normalize(const double2& v) {
  240:     return v / length(v);
  241: }
  242: 
  243: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  244:     return v.x*w.x + v.y*w.y;
  245: }
  246: 
  247: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  248:     return v.x*w.y - v.y*w.x;
  249: }
  250: 
  251: __device__ __forceinline__ double2 rot90(const double2& a) {
  252:     return make_double2(a.y, -a.x);
  253: }
  254: 
  255: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  256:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  257: }
  258: 
  259: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  260:     a.x += b.x;
  261:     a.y += b.y;
  262:     a.z += b.z;
  263:     return a;
  264: }
  265: 
  266: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  267:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
