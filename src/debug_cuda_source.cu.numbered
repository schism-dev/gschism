 2119:       Point3 X1 = origSide->frame.L2G(x1) + toPoint3(origSide->center, origSide->centerZ());// + origSide->center3D(jlev);
 2120:       Point3 X2 = origSide->frame.L2G(x2) + toPoint3(origSide->center, origSide->centerZ());// + origSide->center3D(jlev);
