 7163: __global__ void returnMatrix(double *res) {
 7164:    // Debugging: returns the matrix as a CuPy array
 7165: 
 7166:    const int size = mesh->np;
 7167:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7168:       const Node *node = mesh->localNodeData + idx_node;
 7169:       res[idx_node*size + idx_node] = node->coeffDiag;
 7170:       for (int j = 0; j < node->numNodes; j++) {
 7171:          Node* nbNode = node->nodes[j];
 7172:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7173:       }
 7174: 
 7175:    }
 7176:    
 7177: }
