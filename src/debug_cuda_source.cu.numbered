 1819: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1820: return;   
 1821:    // Lock the mutex
 1822:    lock(&debugPlotMutex);
 1823:  
 1824:    bool ok = true;
 1825:    if (debugPlotIdx == nullptr) ok = false;
 1826:    if (*debugPlotIdx >= 10000) ok = false;
 1827:    if (ok) {
 1828:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1829:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1830:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1831:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1832:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1833:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1834:       (*debugPlotIdx)++;
 1835:    }
 1836: 
 1837:    __threadfence();               // ensure all above writes are visible
 1838:    // Unlock the mutex
 1839:    unlock(&debugPlotMutex);
 1840: 
 1841: }
