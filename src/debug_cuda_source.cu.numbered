 3958: __device__ __forceinline__ int Node::packedIndex() const {
 3959:    // Returns the packed index of the node
 3960:    // Packed index is the index of the partition-block matrices and vectors.
 3961:    return nodeOffsetPerPartition[part] + localIndex();
 3962: }
