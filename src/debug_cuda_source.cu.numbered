  409: // Polynomial class
  410: template<int grade>
  411: struct Polynomial {
  412:     // Static assertion to give a clear error message at compile time
  413:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  414: };
  415: 
  416: 
  417: // Explicit specialization for grade 4
  418: template<>
  419: struct Polynomial<4> {
  420:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  421: 
  422:    // Constructor from coefficients
  423:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  424: 
  425:    __device__ __forceinline__ double eval(double x) const {
  426:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  427:    }
  428: };
