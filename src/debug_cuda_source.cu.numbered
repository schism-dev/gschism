  186: 
  187: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  188:     return make_double2(a.x + b.x, a.y + b.y);
  189: }
  190: 
  191: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  192:     a.x += b.x;
  193:     a.y += b.y;
  194:     return a;
  195: }
  196: 
  197: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  198:     return make_double2(a.x - b.x, a.y - b.y);
  199: }
  200: 
  201: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  202:     a.x -= b.x;
  203:     a.y -= b.y;
  204:     return a;
  205: }
  206: 
  207: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  208:     return make_double2(v.x * s, v.y * s);
  209: }
  210: 
  211: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  212:     return v * s;  // reuse the previous operator
  213: }
  214: 
  215: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  216:     return make_double2(v.x / s, v.y / s);
  217: }
  218: 
  219: __device__ __forceinline__ double norm2(const double2& v) {
  220:     return v.x*v.x + v.y*v.y;
  221: }
  222: 
  223: __device__ __forceinline__ double length(const double2& v) {
  224:     return sqrt(v.x*v.x + v.y*v.y);
  225: }
  226: 
  227: __device__ __forceinline__ double2 normalize(const double2& v) {
  228:     return v / length(v);
  229: }
  230: 
  231: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  232:     return v.x*w.x + v.y*w.y;
  233: }
  234: 
  235: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  236:     return v.x*w.y - v.y*w.x;
  237: }
  238: 
  239: __device__ __forceinline__ double2 rot90(const double2& a) {
  240:     return make_double2(a.y, -a.x);
  241: }
  242: 
  243: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  244:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  245: }
  246: 
  247: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  248:     a.x += b.x;
  249:     a.y += b.y;
  250:     a.z += b.z;
  251:     return a;
  252: }
  253: 
  254: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  255:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  256: }
  257: 
  258: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  259:     return make_double3(v.x * s, v.y * s, v.z * s);
  260: }
  261: 
  262: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  263:     return v * s;
