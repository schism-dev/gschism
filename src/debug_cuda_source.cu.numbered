 1456: // Helper functions for computing the local node index at a given offset from another.
 1457: __device__ __inline__ int nxq(int offset, int index, int size) {
 1458:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1459:    // to the index to make it positive
 1460:    assert(index + offset + 16*size >= 0);
 1461:    return (index + offset + 16*size) % size;  
 1462: }
 1463: 
 1464: __device__ __inline__ int nxq(int index, int size) {
 1465:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1466:    // to the index to make it positive
 1467:    assert(index + 16*size >= 0);
 1468:    return (index + 16*size) % size; 
 1469: }
