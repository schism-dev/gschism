 1726:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1727:       // Compute the different time ramps used in the code 
 1728:       // This function is performed by just one thread
 1729: 
 1730:       rampbc = 1.0;
 1731:       if constexpr(ibc == 0) {
 1732:          if (drampbc > 0.0) {
 1733:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1734:          } else {
 1735:             rampbc = 1.0;
 1736:          }
 1737:       }
 1738: 
 1739:       if (nws != 0) {
 1740:          if (drampwind > 0.0) {
 1741:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1742:          } else {
 1743:             rampwind = 1.0;
 1744:          }
 1745:       }
 1746: 
 1747:       if (drampwafo > 0.0) {
 1748:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1749:       } else {
 1750:          rampwafo = 1.0;
 1751:       }
 1752: 
 1753:       // For source/sinks
 1754:       if (if_source && dramp_ss > 0.0) {
 1755:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1756:       } else {
 1757:          ramp_ss = 1.0;
 1758:       }
 1759: 
 1760:       if (dramp > 0.0) {
 1761:          ramp = tanh(2.0*time/86400.0/dramp);
 1762:       } else {
 1763:          ramp = 1.0;
 1764:       }
 1765: 
 1766: 
 1767:    }
