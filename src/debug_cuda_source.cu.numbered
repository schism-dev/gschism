 2270: 
 2271: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2272: 
 2273:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2274:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2275:    const Node *n1 = side->n1;
 2276:    const Node *n2 = side->n2;
 2277: 
 2278:    bool n1_match = (n1->nodeBnd->segment == segment);
 2279:    bool n2_match = (n2->nodeBnd->segment == segment);
 2280: 
 2281:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2282:    if (n1_match && n2_match) {
 2283:       return 0.5;
 2284:    } else if (n1_match) {
 2285:       return 1.0;
 2286:    } else if (n2_match) {
 2287:       return 0.0;
 2288:    }
 2289:    return 0.0;
 2290: }
 2291: 
 2292: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2293: 
 2294: 
 2295: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2296: 
 2297:    const double w1 = getBoundaryArrayValueWeight();
 2298:    const double w2 = 1.0 - w1;
 2299:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2300:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2301: 
 2302:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2303: }
 2304: 
 2305: 
 2306: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2307:    const double w1 = getBoundaryArrayValueWeight();
 2308:    const double w2 = 1.0 - w1;
 2309:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2310:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2311: 
 2312:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2313: }
 2314: 
 2315: 
 2316: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2317:    // Returns the value of the velocity at the side center
 2318:    const double w1 = getBoundaryArrayValueWeight();
 2319:    const double w2 = 1.0 - w1;
 2320:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2321:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2322: 
 2323:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2324: }
 2325: 
 2326: 
 2327: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2328:    // Returns the value of the normal component of the velocity at the side center
 2329:    const double w1 = getBoundaryArrayValueWeight();
 2330:    const double w2 = 1.0 - w1;
 2331:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2332:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2333: 
 2334:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2335: }
