 1968: 
 1969: __inline__ __device__ Point2 Element::outputCoords(void) const {
 1970:    if constexpr(ics == 1)  {
 1971:       return center;
 1972: 
 1973:    } else {
 1974:       const Point2 p0 = nodes[0]->outputCoords();
 1975:       const Point2 p1 = nodes[1]->outputCoords();
 1976:       const Point2 p2 = nodes[2]->outputCoords();
 1977: 
 1978:       if (isTri()) {
 1979:          return (1.0/3.0)*(p0 + p1 + p2);
 1980: 
 1981:       } else {
 1982:          const Point2 p3 = nodes[3]->outputCoords();
 1983:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 1984:       }
 1985: 
 1986:    }
 1987: }
 1988: 
 1989: __device__ __forceinline__ double Element::centerZ(void) const { 
 1990: // Z coordinate of the element center in the global cartesian coordinates.
 1991: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 1992: 
 1993:    if constexpr(ics==1) { 
 1994:       return 0.0; 
 1995:    } else { 
 1996:       if (isTri()) {
 1997:          return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz); 
 1998:       } else {
 1999:          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz); 
 2000:       }
 2001: 
 2002:    } 
 2003: }
