 2036: 
 2037: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2038:    if constexpr(ics == 1)  {
 2039:       return center;
 2040: 
 2041:    } else {
 2042:       const Point2 p0 = nodes[0]->outputCoords();
 2043:       const Point2 p1 = nodes[1]->outputCoords();
 2044:       const Point2 p2 = nodes[2]->outputCoords();
 2045: 
 2046:       if (isTri()) {
 2047:          return (1.0/3.0)*(p0 + p1 + p2);
 2048: 
 2049:       } else {
 2050:          const Point2 p3 = nodes[3]->outputCoords();
 2051:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2052:       }
 2053: 
 2054:    }
 2055: }
