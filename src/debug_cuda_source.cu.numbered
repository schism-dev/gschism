 2156: // Helper functions for computing the local node index at a given offset from another.
 2157: __device__ __inline__ int nxq(int offset, int index, int size) {
 2158:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2159:    // to the index to make it positive
 2160:    assert(index + offset + 16*size >= 0);
 2161:    return (index + offset + 16*size) % size;  
 2162: }
 2163: 
 2164: __device__ __inline__ int nxq(int index, int size) {
 2165:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2166:    // to the index to make it positive
 2167:    assert(index + 16*size >= 0);
 2168:    return (index + 16*size) % size; 
 2169: }
