 1928:    
 1929:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 1930:    // Project the vectors from the node frame to the element frame
 1931: 
 1932:       frame.print();
 1933:       nodes[0]->frame.print();
 1934:       nodes[1]->frame.print();
 1935:       nodes[2]->frame.print();
 1936:       if (isQuad()) nodes[3]->frame.print();
 1937: 
 1938:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 1939:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 1940:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 1941:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 1942:       else          v[3] = Vector2();
 1943:    }
 1944: 
 1945:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 1946:    // Project the vectors from the side frame to the element frame
 1947: 
 1948:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 1949:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 1950:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 1951:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 1952:       else          v[3] = Vector2();
 1953:    }
 1954: 
