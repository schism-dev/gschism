 1625:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1626:       // Compute the different time ramps used in the code 
 1627:       // This function is performed by just one thread
 1628: 
 1629:       rampbc = 1.0;
 1630:       if constexpr(ibc == 0) {
 1631:          if (drampbc > 0.0) {
 1632:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1633:          } else {
 1634:             rampbc = 1.0;
 1635:          }
 1636:       }
 1637: 
 1638:       if (nws != 0) {
 1639:          if (drampwind > 0.0) {
 1640:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1641:          } else {
 1642:             rampwind = 1.0;
 1643:          }
 1644:       }
 1645: 
 1646:       if (drampwafo > 0.0) {
 1647:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1648:       } else {
 1649:          rampwafo = 1.0;
 1650:       }
 1651: 
 1652:       // For source/sinks
 1653:       if (if_source && dramp_ss > 0.0) {
 1654:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1655:       } else {
 1656:          ramp_ss = 1.0;
 1657:       }
 1658: 
 1659:       if (dramp > 0.0) {
 1660:          ramp = tanh(2.0*time/86400.0/dramp);
 1661:       } else {
 1662:          ramp = 1.0;
 1663:       }
 1664: 
 1665: 
 1666:    }
