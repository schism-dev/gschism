 2383: 
 2384: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2385: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2386: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2387: // Only when ics == 2, the origin is at the element center.
 2388: 
 2389:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2390: 
 2391:    const Node *node = nodes[idxNode];
 2392: 
 2393:    if constexpr(ics==1) {
 2394:       return node->p;
 2395: 
 2396:    } else {
 2397:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2398: 
 2399:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2400: 
 2401:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2402:    }
 2403: 
 2404: }
 2405: 
 2406: 
 2407: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2408:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2409: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2410: 
 2411:    const int id1 = idx;
 2412:    const int id2 = nxq(1 + id1);
 2413:    const int id3 = nxq(2 + id1);
 2414: 
 2415:    if constexpr(ics==1) {
 2416:       x0 = nodes[id1]->p;
 2417:       x1 = nodes[id2]->p;
 2418:       x2 = nodes[id3]->p;
 2419: 
 2420:    } else {
 2421: 
 2422:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2423:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2424:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2425: 
 2426:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2427:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2428:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2429: 
 2430:    }
 2431: 
 2432: }
 2433: 
 2434: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2435:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2436: }
 2437: 
 2438: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2439:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2440:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2441: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2442: 
 2443:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2444: 
 2445: 
 2446: 
 2447:    if constexpr(ics==1) {
 2448:       x0 = nodes[0]->p;
 2449:       x1 = nodes[1]->p;
 2450:       x2 = nodes[2]->p;  
 2451:       x3 = nodes[3]->p;
 2452: 
 2453:    } else {
 2454: 
 2455:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2456:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2457:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2458:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2459: 
 2460:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2461:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2462:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2463:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2464:    }
 2465: 
 2466: }
 2467: 
 2468: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2469:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2470: {
 2471:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2472: }
 2473: 
 2474: 
 2475: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2476: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2477: // Returns the normal vector and the area of the element at this level
 2478:    
 2479:    double nx, ny, nz;
 2480: 
 2481:    if (isTri()) {
 2482:       // For triangles...
 2483: 
 2484:       // Indices of the nodes at level k, taking care of not going below the bed
 2485:       const int k0 = max(k, nodes[0]->kb);
 2486:       const int k1 = max(k, nodes[1]->kb);
 2487:       const int k2 = max(k, nodes[2]->kb);
 2488: 
 2489:       // Gets the element frame coordinates of the nodes at level k
 2490:       Point3 x0, x1, x2;
 2491:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2492:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2493:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2494:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2495: 
 2496:       } else {  // ics == 2
 2497:          Point2 h0, h1, h2;
 2498: 
 2499:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2500: 
 2501:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2502:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2503:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2504:       }
 2505: 
 2506:       const Vector3 n20 = x2 - x0;
 2507:       const Vector3 n10 = x1 - x0; 
 2508: 
 2509:       // Computes the cross product of vectors n20 and n10. 
 2510:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2511:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2512:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2513: 
 2514:   
 2515:    }
 2516:    else {
 2517:       // For quads...
 2518:       Point2 h0, h1, h2, h3;
 2519: 
 2520:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2521: 
 2522:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2523:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2524:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2525:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2526: 
 2527:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2528:       nx = n20.y*n31.z - n20.z*n31.y;
 2529:       ny = n20.z*n31.x - n20.x*n31.z;
 2530:       nz = n20.x*n31.y - n20.y*n31.x;
 2531: 
 2532:    }
 2533: 
 2534:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2535:    area3D = 0.5*len;
 2536: 
 2537:    const double inv_len = 1.0/len;
 2538: 
 2539:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2540: 
 2541: }
 2542: 
 2543: 
 2544: // Helper functions to get the 2D local node position for the Celestial walk
 2545: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2546:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2547:    const Node *node = getNodeInOrder(idx2);
 2548: 
 2549:    double z = 0.0;
 2550:    if constexpr(ics == 2) z = node->gz;
 2551:    
 2552:    Point3 p = toPoint3(node->p, z);
 2553: 
 2554:    return toPoint2(origSide->toLocalFrame(p));
 2555: }
 2556: 
 2557: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2558:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2559: }
 2560: 
 2561: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2562:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2563: // Computes the three per-side predicates needed for the celestial walk
 2564: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2565: //
 2566: // xt is in local frame coordinates for origSide if ics == 2.
 2567: //
 2568: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2569: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2570: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2571: // meaningless on triangles are masked to a safe value (see comments below).
 2572: {
 2573:    // Project all 4 corner positions once into the local 2D frame.
 2574:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2575:    // getLocalNodePosition only transforms/projects if ics == 2.
 2576:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2577:                         getLocalNodePosition(1, origSide), 
 2578:                         getLocalNodePosition(2, origSide), 
 2579:                         getLocalNodePosition(3, origSide)};
 2580: 
 2581:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2582:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2583:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2584:    // But still farther towards the target point from the current point.
 2585:    const Vector2 vt0 = xt - x0;
 2586:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2587:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2588:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2589: 
 2590:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2591:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2592: 
 2593: 
 2594: // if (origSide->idx == 2860848 && jlev == 46) {
 2595: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2596: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2597: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2598: // }
 2599:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2600:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2601:    //  here the orientation is baked into the corners array.)
 2602:    const int i3 = nxq(3);
 2603:    const Vector2 s0 = C[ 1] - C[ 0];
 2604:    const Vector2 s1 = C[ 2] - C[ 1];
 2605:    const Vector2 s2 = C[i3] - C[ 2];
 2606:    const Vector2 s3 = C[ 0] - C[i3];
 2607:    
 2608:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2609:    // The corners array is built from getNode in CCW order, so the orientation
 2610:    // is already correct and no ssign factor is needed in the formulas below.
 2611:    //
 2612:    // i3 = nxq(3): the index of the corner after side 2.
 2613:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2614:    //   Quad:     i3 == 3.
 2615:    //
 2616:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2617:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2618:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2619:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2620:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2621:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2622: 
 2623: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2624: 
 2625:    // For triangles, the corner after side 2 is the closing corner where
 2626:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2627:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2628:    // s0 for triangles, s3 for quads.
 2629:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2630: 
 2631:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2632:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2633:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2634:    //
 2635:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2636:    // result is false naturally. No sentinel needed.
 2637:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2638:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2639:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2640:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2641: 
 2642:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2643:    // on the "exit through side I" half of the corner cone, separated by the
 2644:    // approximate angular bisector of the celestial walk. The bisector is
 2645:    // perpendicular to the chord across the corner; the test is the sign of
 2646:    // (xt - corner_vertex) projected onto that chord.
 2647:    //
 2648:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2649:    // (the validity rule sets valid_3 = false), so its computed value for
 2650:    // triangles doesn't matter. No sentinel needed.
 2651:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2652:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2653:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2654:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2655: 
 2656: }
 2657: 
 2658: 
 2659: __inline__ __device__ double Element::computeSignedArea(void) const {
 2660:    // Compute the area of the element
 2661: 
 2662:    Point2 x0, x1, x2, x3;
 2663:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2664: 
 2665: 
 2666:    double res = signedArea(x0, x1, x2);
 2667: 
 2668:    // In the quad case we need to add the area of the other triangle.
 2669:    if (isQuad()) {
 2670:       x3 = getLocalHorizontalNodePosition(3);
 2671:       double ar1 = signedArea(x0, x2, x3);
 2672:       double ar2 = signedArea(x0, x1, x3);
 2673:       double ar3 = signedArea(x1, x2, x3);
 2674:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2675: 
 2676:       res += ar1;
 2677: 
 2678:    }
 2679: 
 2680:    return res;
 2681: }
 2682: 
 2683: 
 2684: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2685:                                                                 (nodes[1]->isDry2()) ||
 2686:                                                                 (nodes[2]->isDry2()) ||
 2687:                                                                 (isQuad() && nodes[3]->isDry2());
 2688: }
 2689: 
 2690: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2691:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2692: }
 2693: 
 2694: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2695:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2696: }
 2697: 
 2698: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2699:    // In boundary sides, the element 1 is nullptr
 2700:    return side->elems[1] == nullptr; 
 2701: }
 2702: 
 2703: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2704:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2705:    // For ics == 2, this function uses local frame coordinates.
 2706: 
 2707:    assert(isQuad());
 2708: 
 2709:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2710:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2711:    // where vxi, veta, vb are vectors and c is the center of the element.
 2712: 
 2713:    Point2 p0, p1, p2, p3;
 2714: 
 2715:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2716: 
 2717:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2718:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2719:    // vectors vxi and veta connect the centers of opposite sides
 2720:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2721:    // vb is zero for parallelogram elements.
 2722:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2723: 
 2724:    //  The bilinear mapping is:
 2725:    //      P(s,t) = C + s*U + t*V + s*t*W
 2726:    //
 2727:    //  where:
 2728:    //    C = centroid (average of four vertices)
 2729:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2730:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2731:    //    W = bilinear correction; measures deviation from parallelogram
 2732:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2733:    //        W = 0 for parallelogram elements.
 2734:    //
 2735:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2736:    //
 2737:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2738:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2739:    //
 2740:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2741:    //
 2742:    //  Geometrically, (L) projects everything onto the direction
 2743:    //  perpendicular to W, where the mapping is purely affine.
 2744:    //
 2745:    //  The dot product with nb retains the nonlinear term:
 2746:    //
 2747:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2748:    //
 2749:    //  Geometrically, (Q) projects onto the W direction, where
 2750:    //  the nonlinearity lives.
 2751:    //
 2752:    //  We solve (L) for whichever variable has the larger coefficient
 2753:    //  (better conditioned back-substitution), substitute into (Q),
 2754:    //  and get a scalar quadratic in the other variable.
 2755:    // ================================================================
 2756: 
 2757:    // ---- Basis vectors ----
 2758:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2759:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2760:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2761:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2762:    // W: nonlinear correction. Difference between quad and parallelogram.
 2763:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2764:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2765: 
 2766:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2767:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2768:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2769:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2770:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2771: 
 2772:    // ---- nb: direction parallel to W, L1-normalized ----
 2773:    // We don't need a unit vector -- just a well-scaled direction parallel
 2774:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2775:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2776:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2777:    //
 2778:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2779:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2780:    // and the quadratic solver takes its linear path (a ~ 0).
 2781:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2782:    const double inv_wlen = 1.0 / wlen1;
 2783:    const Vector2 nb = vb * inv_wlen;
 2784: 
 2785:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2786:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2787:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2788:    // What remains is a pure affine relationship between xi and eta.
 2789:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2790:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2791:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2792: 
 2793:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2794:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2795:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2796:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2797:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2798:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2799:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2800: 
 2801:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2802:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2803:    // minimizing round-off amplification.
 2804:    //
 2805:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2806:    // that uses predicated moves.
 2807:    //
 2808:    // if (fabs(Ls) > fabs(Lt)) {
 2809:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2810:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2811:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2812:    //    const double A = -Qw * Lt;
 2813:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2814:    //    const double C =  Qs * Lp - Qp * Ls;
 2815: 
 2816:    //    double eta1, eta2;
 2817:    //    solveQuadratic(A, B, C, eta1, eta2);
 2818: 
 2819:    //    // Pick root with smaller |eta| (domain centered at 0).
 2820:    //    // Ternary-> predicated move, no branch divergence.
 2821:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2822: 
 2823:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2824:    //    xi = (Lp - Lt * eta) / Ls;
 2825: 
 2826:    // } else {
 2827:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2828:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2829:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2830:    //    const double A = -Qw * Ls;
 2831:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2832:    //    const double C =  Qt * Lp - Qp * Lt;
 2833: 
 2834:    //    double xi1, xi2;
 2835:    //    solveQuadratic(A, B, C, xi1, xi2);
 2836: 
 2837:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2838: 
 2839:    //    eta = (Lp - Ls * xi) / Lt;
 2840:    // }
 2841:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2842:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2843:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2844:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2845:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2846: 
 2847:    // Quadratic:  A*r^2 + B*r + C = 0
 2848:    // (same formula for both cases, just with swapped coefficients)
 2849:    const double A = -Qw * Lb;
 2850:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2851:    const double C =  Qa * Lp - Qp * La;
 2852: 
 2853:    double r1, r2;
 2854:    solveQuadratic(A, B, C, r1, r2);
 2855: 
 2856:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2857:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2858: 
 2859:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2860:    const double other = (Lp - Lb * r) / La;
 2861: 
 2862:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2863:    xi  = solve_s ? r     : other;
 2864:    eta = solve_s ? other : r;
 2865: 
 2866: 
 2867:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2868:    xi  = clamp(xi,  -1.0, 1.0);
 2869:    eta = clamp(eta, -1.0, 1.0);
 2870: 
 2871:    // ---- Shape functions ----
 2872:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2873:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2874:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2875:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2876:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2877:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2878:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2879:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2880: 
 2881:    return true;
 2882: }
 2883: 
 2884: /**
 2885:    Compute the shape coordinates of the point (xt,yt) in the element.
 2886:    @param xt (input): x-coordinate of the point
 2887:    @param shpCoords (output): shape coordinates of the point
 2888:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2889:    @return true if the point is inside the element, false otherwise
 2890: **/
 2891: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2892: 
 2893:    // Compute the shape coordinates of the point xt in the element.
 2894:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2895:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2896:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2897:    // from the local frame, so use additional check.
 2898: 
 2899: 
 2900:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 2901: 
 2902:    if (isTri()) { // Triangular element
 2903: 
 2904:       // Horizontal local node coordinates. 
 2905:       Point2 x0, x1, x2;
 2906:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 2907: 
 2908:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2909:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2910:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2911:       shpCoords[3] = 0.0;
 2912: 
 2913:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2914:       const bool res = (tmpmin >= -small);  
 2915:       
 2916:       // When to fix the negative shape coordinates?
 2917:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2918: 
 2919:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2920:       // then we fix the negative shape coordinates.
 2921:       if ((tmpmin < 0) && fix) {
 2922: 
 2923:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2924:          // keeping the sum of the shape coordinates equal to 1.
 2925:          // I have tested and compared the new algorithm with the old one, and they give
 2926:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2927:          // The new algorithm should be faster since it is branchless.
 2928:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2929:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2930: 
 2931:          shpCoords[0] = (shpCoords[0] + a)*b;
 2932:          shpCoords[1] = (shpCoords[1] + a)*b;
 2933:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2934: 
 2935:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2936:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2937:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2938: 
 2939:          // Update the point coordinates for the new shape coordinates
 2940:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2941:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2942: 
 2943:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2944: 
 2945:       }
 2946: 
 2947:       // Return true if the point is inside the element
 2948:       return res;      
 2949:    }
 2950:    else {
 2951:       assert(isQuad() && "computeShapeCoords");
 2952: 
 2953:       // Horizontal local node coordinates with respect to the original side.
 2954:       Point2 x0, x1, x2, x3;
 2955:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 2956: 
 2957:       const double a0 = signedArea(x0, x1, xt);
 2958:       const double a1 = signedArea(x1, x2, xt);
 2959:       const double a2 = signedArea(x2, x3, xt);
 2960:       const double a3 = signedArea(x3, x0, xt);
 2961: 
 2962:       const double minArea = min4(a0, a1, a2, a3);
 2963:       
 2964:       const bool res = (minArea > -small*area);
 2965: 
 2966:       // When to fix the negative shape coordinates?
 2967:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2968: 
 2969:       double xi, eta;    
 2970: 
 2971:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 2972:       // Does nothing if ics == 1.
 2973:       assert(origSide != nullptr);
 2974:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 2975: 
 2976:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 2977: 
 2978:       if (fix) {
 2979:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2980:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2981:          xt.x = interpolate(shpCoords, xn);
 2982:          xt.y = interpolate(shpCoords, yn);
 2983:       }
 2984: 
 2985:       return res;
 2986:    }
 2987: 
 2988: 
 2989:    assert(false && "computeShapeCoords: should never reach this point");
 2990:    return false;  // Never reached
 2991: 
 2992: }
 2993: 
 2994: 
 2995: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2996: // Convert shape coordinates to cartesian coordinates
 2997: 
 2998:    if (isTri()) {
 2999:       // Triangular element
 3000: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3001:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3002:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3003:    }
 3004:    else {
 3005:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3006:    }
 3007: 
 3008: }
 3009: 
 3010: 
 3011: 
 3012: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3013:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3014:    
 3015:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3016: }
 3017: 
 3018: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3019:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3020:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3021:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3022:    return area * dot(gradPhi[i], gradPhi[j]);
 3023: }
 3024: 
 3025: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3026:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3027:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3028:    // The formula for the integral is:
 3029:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3030:    
 3031:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3032:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3033:    const double eta_sum  = eta_n(i) + eta_n(j);
 3034:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3035: 
 3036:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3037:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3038: 
 3039: 
 3040:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3041: }
 3042:    
 3043: 
 3044: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3045:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3046:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3047:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3048:    // The formula is also based on the identity:
 3049:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3050:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3051: 
 3052:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3053: 
 3054: 
 3055: 
 3056:    double res = 0.0;
 3057:    
 3058:    // Quadrature points in xi and eta coordinates
 3059:    #pragma unroll
 3060:    for (int i = 0; i < 4; i++) {
 3061:       // For each quadrature point...
 3062: 
 3063:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3064:       const double eta = p.x;
 3065:       const double xi  = p.y;
 3066: 
 3067:       // Jacobian entries at the Gauss point p
 3068:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3069:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3070:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3071:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3072: 
 3073:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3074:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3075: 
 3076:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3077:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3078:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3079:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3080:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3081: 
 3082:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3083:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3084:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3085:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3086:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3087: 
 3088:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3089:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3090:    }
 3091: 
 3092:    return res;
 3093: }
 3094: 
 3095: 
 3096: /**  Interpolate velocities at a given point (xt,yt,zt)
 3097: 
 3098:    @param xt, yt, zt: coordinates of the point to interpolate
 3099:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3100: 
 3101:    This is done in four steps:
 3102: 
 3103:    1. Find the shape coordinates for the final position in the element.
 3104:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3105:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3106:       z levels at xt, yt at each step.   
 3107:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3108:       horizontally and vertically.
 3109: **/
 3110: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3111:    // Interpolate the velocities at the point xt. 
 3112:    // This function works the same for triangular and quadrilateral elements.
 3113:    double shpCoord[4];
 3114:    Vector3 u_int;
 3115: 
 3116: 
 3117:    // First step is to compute the shape coordinates of (xt,yt)
 3118: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3119:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3120: 
 3121:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3122: 
 3123:    // Second step is to find the level that contains zt
 3124:    // Uses a binary search to find the level
 3125:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3126:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3127:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3128:    int R = nvrt - 1;
 3129: 
 3130:    // Get the z coordinates at the nodes of the element at the levels L and R
 3131:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3132:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3133:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3134: 
 3135: 
 3136:    double zL = interpolate(shpCoord, zLAtNodes);
 3137:    double zR = interpolate(shpCoord, zRAtNodes);
 3138: 
 3139:    // Interpolates vertically the velocities
 3140:    double wght1, wght2;
 3141:    if (xt.z <= zL) {
 3142:       wght1 = 1.0;
 3143:       wght2 = 0.0;
 3144:       xt.z = zL;
 3145:    }
 3146:    else if (xt.z >= zR) {
 3147:       wght1 = 0.0;
 3148:       wght2 = 1.0;
 3149:       xt.z = zR;
 3150:    }
 3151:    else {
 3152:       // Perform a binary search to find the levels between L and R that contain xt.z
 3153:       while (R - L > 1) {
 3154:          int M = (L + R) / 2.0;
 3155: 
 3156:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3157:          double zM = interpolate(shpCoord, zMAtNodes);
 3158:          if (zM < xt.z) 
 3159:          {
 3160:             L = M;
 3161:             zL = zM;
 3162:          }
 3163:          else 
 3164:          {
 3165:             R = M;
 3166:             zR = zM;
 3167:          }
 3168:       }
 3169:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3170:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3171: 
 3172:       wght2 = (xt.z - zL)/(zR - zL);
 3173:       wght1 = 1.0 - wght2;
 3174: 
 3175:    }
 3176: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3177: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3178:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3179:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3180:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3181:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3182: 
 3183:    // Project the velocity from the local frame to the origSide frame
 3184:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3185:    u_int = {uv.x, uv.y, w};
 3186: 
 3187:    // Neither of the interpolated velocities should be NaN
 3188:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3189: 
 3190:    return u_int;
 3191: 
 3192: }
 3193: 
 3194: 
 3195: 
 3196: 
 3197: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3198: 
 3199:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3200:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3201:    const Node *n1 = side->n1;
 3202:    const Node *n2 = side->n2;
 3203: 
 3204:    bool n1_match = (n1->nodeBnd->segment == segment);
 3205:    bool n2_match = (n2->nodeBnd->segment == segment);
 3206: 
 3207:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3208:    if (n1_match && n2_match) {
 3209:       return 0.5;
 3210:    } else if (n1_match) {
 3211:       return 1.0;
 3212:    } else if (n2_match) {
 3213:       return 0.0;
 3214:    }
 3215: 
 3216:    return 0.0;
 3217: }
 3218: 
 3219: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3220: 
 3221: 
 3222: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3223: 
 3224:    const double w1 = getBoundaryArrayValueWeight();
 3225:    const double w2 = 1.0 - w1;
 3226:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3227:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3228: 
 3229:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3230: }
 3231: 
 3232: 
 3233: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3234:    const double w1 = getBoundaryArrayValueWeight();
 3235:    const double w2 = 1.0 - w1;
 3236:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3237:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3238: 
 3239:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3240: 
 3241: }
 3242: 
 3243: 
 3244: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3245:    // Returns the value of the velocity at the side center
 3246:    const double w1 = getBoundaryArrayValueWeight();
 3247:    const double w2 = 1.0 - w1;
 3248:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3249:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3250: 
 3251:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3252: }
 3253: 
 3254: 
 3255: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3256:    // Returns the value of the normal component of the velocity at the side center
 3257:    const double w1 = getBoundaryArrayValueWeight();
 3258:    const double w2 = 1.0 - w1;
 3259:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3260:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3261: 
 3262:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3263: }
 3264: 
 3265: 
 3266: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3267:    if constexpr(ics == 1) {
 3268:       return center;
 3269: 
 3270:    } else {
 3271:       const Point2 p0 = n1->outputCoords();
 3272:       const Point2 p1 = n2->outputCoords();
 3273:       return (1.0/2.0)*(p0 + p1);
 3274: 
 3275:    }
 3276: }
 3277: 
 3278: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3279: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3280: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3281: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3282: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3283: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3284: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3285: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3286: // Computes the gradient of the field at the side center.
 3287:    Vector2 grad = {0.0, 0.0};
 3288:    int count = 0;
 3289: 
 3290:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3291:    // as the average of the gradients at each element.
 3292:    // First element
 3293:    if (elems[0] != nullptr && condition(elems[0])) {
 3294:       Vector2 elemGrad = elems[0]->grad2(field);
 3295: 
 3296:       // For ics=2, projects the element gradient from its frame to the side frame
 3297:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3298: 
 3299:       grad += elemGrad;
 3300: 
 3301:       count++;
 3302:    }
 3303: 
 3304:    // Second element
 3305:    if (elems[1] != nullptr && condition(elems[1])) {
 3306: 
 3307:       Vector2 elemGrad = elems[1]->grad2(field);
 3308: 
 3309:       // For ics=2, projects the element gradient from its frame to the side frame
 3310:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3311: 
 3312:       grad += elemGrad;
 3313: 
 3314:       count++;
 3315:    }
 3316: 
 3317:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3318:    if (count > 0) {
 3319:       grad = grad*(1.0/count);
 3320:    }
 3321:    
 3322:    return grad;
 3323: }
 3324: 
 3325: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3326: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3327: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3328: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3329: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3330: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3331: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3332: 
 3333: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3334: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3335: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3336: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3337: 
 3338: 
 3339: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3340: 
 3341: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3342:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3343:    if constexpr(ics == 1) { 
 3344:       return 0.5*(n1->tau + n2->tau);
 3345: 
 3346:    } else {
 3347:       // Project the tau from the node frames to the side frame
 3348:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3349:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3350: 
 3351:       return 0.5*(stau1 + stau2);
 3352:    }
 3353: }
 3354: 
 3355: /**
 3356:  * This method performs backtracking from the side center until a time -dt back in time 
 3357:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3358:  * intermediate point.
 3359:  *
 3360:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3361:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3362:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3363:  * remaining time.
 3364:  * 
 3365:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3366:  * 
 3367:  * @param uuint, vvint, wwint: Velocities at the final point
 3368:  * @param jlev: Level at which the backtracking is performed
 3369:  * @param dt, dtbk: Tracking timesteps
 3370:   */
 3371: __inline__ __device__ void Side::btrack(
 3372:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3373:       double dt,            // Tracking time
 3374:       double dtbk,          // Tracking timestep
 3375:       Vector3 &u_int        // Velocities at the initial point
 3376: ) const {
 3377: 
 3378:    // Start from side center
 3379:    Point3 x0;
 3380: 
 3381:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3382:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3383: 
 3384:  
 3385:    double time_rm = dt; // Remaining time
 3386:    double time_rm_1 = 1e10;
 3387:    double time_rm_2 = 2e10;
 3388:    double time_rm_3 = 3e10;
 3389: 
 3390: 
 3391:    // Initial velocities
 3392:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3393: 
 3394:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3395:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3396: 
 3397:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3398: 
 3399: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3400: 
 3401: 
 3402:    constexpr int MAX_ITERATIONS = 100; 
 3403:    int iter = 0;
 3404:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3405:    while(true) {
 3406: 
 3407:       // Calculate timestep
 3408:       const double dtb = min(dtbk, time_rm);
 3409: 
 3410:       // Next point in the backtracking curve
 3411:       xt = x0 - dtb*u_int;
 3412: 
 3413:       double t, s; // parameters for the line segments p0pt and p1p2
 3414:       Side *lastCrossSide = nullptr;
 3415:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3416: 
 3417: 
 3418:       if (time_rm_3 <= time_rm) {
 3419:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3420:          xt = x0;
 3421:          break;
 3422:       }
 3423: 
 3424: 
 3425:       if (!found) {
 3426:       // This means that the walk reached a boundary or a dry element.
 3427: 
 3428:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3429: 
 3430:          // Finds the point at the boundary where the line segment x0xt intersects.
 3431:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3432:          // due to floating point errors, it does not exactly intersect.
 3433:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3434:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3435:          // To compute the intersection point we start with the parametric equations.
 3436:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3437:          // We cross-prouct by v1 to cancel the s term:
 3438:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3439:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3440: 
 3441:          // Side coordinates in the origSide frame.
 3442:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3443:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3444: 
 3445:          Point2  p0 = {x0.x, x0.y};
 3446:          Point2  pt = {xt.x, xt.y};
 3447: 
 3448:          const Vector2 v1 = pt - p0;
 3449:          const Vector2 v2 = p2 - p1;
 3450: 
 3451: 
 3452: 
 3453:          // We are assuming intersection, so we clamp t to the range [0,1].
 3454:          const double denom = cross(v2, v1);
 3455:          
 3456: 
 3457: 
 3458: 
 3459:          if (abs(denom) < small) {
 3460:             // small denominators are fairly common. They occur when the line segment x0xt 
 3461:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3462:             // boundary, where the backtracking curve startt sliding along the boundary.
 3463:             // In this case, we simply assume that the two lines are very close to each other
 3464:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3465:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3466:             if (t<0.0000000001) t = 0.0;
 3467:             if (t>0.9999999999) t = 1.0;
 3468: 
 3469:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3470:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3471: 
 3472:          }
 3473:          else {
 3474:             
 3475:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3476:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3477:             if (t>0.9999999999) t = 1.0;
 3478:             // From the originaL equation we can solve for s:
 3479:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3480:             // Computing the dot product by v1, we get:
 3481:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3482:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3483:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3484: 
 3485:          }
 3486: 
 3487:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3488: 
 3489: 
 3490:          // We update the new target point to be right at the intersection point,
 3491:          // and the remaining time must include the time we haven't "used".
 3492:          time_rm -= s*dtb;
 3493:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3494: 
 3495: 
 3496:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3497:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3498: 
 3499:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3500:          // but extracting only the component along the tangent vector v2.
 3501:          Vector2 tangent = normalize(v2);
 3502:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3503: 
 3504:          const Vector2 u2D = make_double2(u.x, u.y);
 3505:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3506: 
 3507: 
 3508:       } else {
 3509: 
 3510:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3511: 
 3512:          time_rm -= dtb; 
 3513: 
 3514:          u_int = curElem->interpolateVelocities(xt, this);
 3515: 
 3516:       }
 3517: 
 3518:       if (time_rm <= 0.0) break; 
 3519: 
 3520:       // If the velocity is too small, we stop the backtracking
 3521:       const double vmag2 = norm2(toVector2(u_int));
 3522:       if (vmag2 <= velmin_btrack_sq)  {
 3523:          time_rm = 0.0; 
 3524:          return; 
 3525:       }
 3526: 
 3527:       // The current point becomes the next segment's starting point.
 3528:       x0 = xt;
 3529:  
 3530:       iter++;
 3531: 
 3532: // XXXXXXXXXXXXXXXXX
 3533: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3534:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3535: 
 3536:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3537:       time_rm_3 = time_rm_2;
 3538:       time_rm_2 = time_rm_1;
 3539:       time_rm_1 = time_rm;
 3540:    }
 3541: 
 3542:    assert(curElem != nullptr && "Final element is nullptr");
 3543:    assert(!curElem->isDry && "Final element is dry");
 3544:    
 3545: 
 3546: 
 3547:    // Interpolate the velocities at the final point with respect to the current side frame
 3548:    u_int = curElem->interpolateVelocities(xt, this);
 3549: 
 3550: 
 3551: }
 3552: 
 3553: 
 3554: 
 3555: 
 3556: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3557: 
 3558: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3559: 
 3560:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3561:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3562: 
 3563:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3564:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3565: 
 3566:    double fun_lat = 0.0;
 3567:    switch (jspc[idxComp]) {
 3568:       case 0:
 3569:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3570:          break;
 3571:       case 1:
 3572:          fun_lat = sin(2.0*lat);
 3573:          break;
 3574:       case 2:
 3575:          fun_lat = pow<2>(cos(lat));
 3576:          break;
 3577:       default:
 3578:          assert(false && "computeETP: invalid jspc");
 3579:    }
 3580:    
 3581:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3582: 
 3583: }
 3584: 
 3585: __device__ void Node::updateKb(void) {
 3586: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3587: 
 3588:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3589: 
 3590: 
 3591:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3592: 
 3593:    if constexpr(ivcor == 2) {  // SZ coordinates
 3594:       
 3595:       // Compute bottom level index
 3596:       if (depth <= mesh->h_s) {
 3597:          kb = izlev;   
 3598:          
 3599:       } else {
 3600:          kb = -1;
 3601:          int L = 0;
 3602:          int R = nzlev; 
 3603:          
 3604:          while (L <= R) {
 3605:             int M = (R + L) / 2;
 3606: 
 3607: 
 3608:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3609:             
 3610:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3611:                R = M;
 3612:             } else {
 3613:                L = M;
 3614:             }
 3615: 
 3616:             if (R - L == 1) {
 3617:                kb = L;
 3618:                break;
 3619:             }
 3620:          }
 3621: 
 3622:          // Checks that the binary search was successful
 3623:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3624:        
 3625:       }
 3626:    } 
 3627: }
