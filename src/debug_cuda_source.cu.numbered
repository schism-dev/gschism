  173: 
  174: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  175:     return make_double2(a.x + b.x, a.y + b.y);
  176: }
  177: 
  178: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  179:     a.x += b.x;
  180:     a.y += b.y;
  181:     return a;
  182: }
  183: 
  184: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  185:     return make_double2(a.x - b.x, a.y - b.y);
  186: }
  187: 
  188: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  189:     a.x -= b.x;
  190:     a.y -= b.y;
  191:     return a;
  192: }
  193: 
  194: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  195:     return make_double2(v.x * s, v.y * s);
  196: }
  197: 
  198: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  199:     return v * s;  // reuse the previous operator
  200: }
  201: 
  202: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  203:     return make_double2(v.x / s, v.y / s);
  204: }
  205: 
  206: __device__ __forceinline__ double norm2(const double2& v) {
  207:     return v.x*v.x + v.y*v.y;
  208: }
  209: 
  210: __device__ __forceinline__ double length(const double2& v) {
  211:     return sqrt(v.x*v.x + v.y*v.y);
  212: }
  213: 
  214: __device__ __forceinline__ double2 normalize(const double2& v) {
  215:     return v / length(v);
  216: }
  217: 
  218: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  219:     return v.x*w.x + v.y*w.y;
  220: }
  221: 
  222: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  223:     return v.x*w.y - v.y*w.x;
  224: }
  225: 
  226: __device__ __forceinline__ double2 rot90(const double2& a) {
  227:     return make_double2(a.y, -a.x);
  228: }
  229: 
  230: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  231:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  232: }
  233: 
  234: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  235:     a.x += b.x;
  236:     a.y += b.y;
  237:     a.z += b.z;
  238:     return a;
  239: }
  240: 
  241: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  242:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  243: }
  244: 
  245: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  246:     return make_double3(v.x * s, v.y * s, v.z * s);
  247: }
  248: 
  249: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  250:     return v * s;
  251: }
  252: 
  253: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  254:     return make_double3(v.x / s, v.y / s, v.z / s);
  255: }
  256: 
  257: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  258:     return v.x*w.x + v.y*w.y + v.z*w.z;
  259: }
  260: 
  261: __device__ __forceinline__ double norm2(const double3& v) {
  262:     return v.x*v.x + v.y*v.y + v.z*v.z;
