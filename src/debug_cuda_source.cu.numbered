 4393: 
 4394: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4395:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4396:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4397: 
 4398: 
 4399:    NODE(node1);
 4400: 
 4401:    node1->clearMatrixRow();
 4402:    node1->qel = 0.0;
 4403: 
 4404:    // THIS IS FOR STRUCTURES XXX
 4405:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4406: 
 4407:    
 4408:    for (int j=0; j<node1->numElements; j++) {
 4409:       // For each element connected to the node...
 4410: 
 4411:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4412: 
 4413:       Element *elem = node1->elements[j];
 4414: 
 4415:       // Compute the average gravity
 4416:       const double grav3 = elem->mean(&Node::grav2);
 4417: 
 4418:       // Look at the documentation for the description of the terms in the following integrals
 4419: 
 4420:       // Integral I_1 
 4421:       // \bar{\breve{H}} 
 4422:       const double hhatb = elem->mean(&Side::hhat);        
 4423: 
 4424:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4425: 
 4426:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4427:       const double area = elem->area;
 4428: 
 4429:       // Integral I_4
 4430:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4431:       // Where
 4432:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4433: 
 4434:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4435:       // of U over the element.
 4436:       const Vector2 U = elem->mean(&Side::U);
 4437: 
 4438:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4439: 
 4440:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4441:       const double I_4_1 = dot(gradPhi_1, U);
 4442: 
 4443: 
 4444:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4445:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4446: 
 4447:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4448: 
 4449: 
 4450:       // Normal component of the bed velocity
 4451:       double ubedNormalComp = 0.0;
 4452:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4453:          Vector3 ubed = {0.0, 0.0, 0.0};
 4454:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4455:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4456: 
 4457:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4458:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4459:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4460: 
 4461:          // Computes the normal component of the bed velocity
 4462:          ubedNormalComp = dot(ubed, N);
 4463:       } // imm==2
 4464: 
 4465:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4466: 
 4467:       if (elem->isTri()) {
 4468: 
 4469:          // To clarify the notation in this section: 
 4470:          //   In formulas, we use the following notation:
 4471:          //       i stands for the node under consideration (node1)
 4472:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4473:          //   However, in the code, we use the following notation:
 4474:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4475:          const int id2 = elem->nxq(1 + id1);
 4476:          const int id3 = elem->nxq(2 + id1);
 4477:          Node *node2 = elem->nodes[id2];
 4478:          Node *node3 = elem->nodes[id3];
 4479: 
 4480:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4481: 
 4482:          // integral of phi_i*phi_j
 4483:          const double ipp_ii = (1.0/6.0 )*area;
 4484:          const double ipp_ij = (1.0/12.0)*area;
 4485:          const double ipp_ik = (1.0/12.0)*area;
 4486: 
 4487:          // integral of [(grad phi_i) * (grad phi_j)]
 4488:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4489:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4490:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4491: 
 4492:          // Computes the different components of integral I_1 of each node with respect to node i.
 4493:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4494:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4495:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4496: 
 4497:          node1->addToSparseMatrix(node1, I1_ii);
 4498:          node1->addToSparseMatrix(node2, I1_ij); 
 4499:          node1->addToSparseMatrix(node3, I1_ik);
 4500: 
 4501:          #pragma unroll
 4502:          for (int l=0; l<3; l++) {
 4503: 
 4504:             Node *node = elem->nodes[l];
 4505: 
 4506:             // Additional variation in eta due to bed deformation or vertical velocity
 4507:             double extraEta = 0.0;
 4508:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4509:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4510: 
 4511: 
 4512:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4513:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4514: 
 4515:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4516: 
 4517:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4518:            
 4519:          }
 4520: 
 4521: 
 4522:       }
 4523:       else { // Quad
 4524:          // To clarify the notation in this section: 
 4525:          //   In formulas, we use the following notation:
 4526:          //       i stands for the node under consideration (node1)
 4527:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4528:          //   However, in the code, we use the following notation:
 4529:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4530:          const int id2 = elem->nxq(1 + id1);
 4531:          const int id3 = elem->nxq(2 + id1);
 4532:          const int id4 = elem->nxq(3 + id1);
 4533:          Node *node2 = elem->nodes[id2];
 4534:          Node *node3 = elem->nodes[id3];
 4535:          Node *node4 = elem->nodes[id4];   
 4536:          
 4537:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4538: 
 4539:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4540:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4541:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4542:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4543:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4544: 
 4545:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4546:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4547:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4548:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4549:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4550: 
 4551: 
 4552:          // Computes the different components of integral I_1 of each node with respect to node i.
 4553:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4554:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4555:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4556:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4557: 
 4558:          node1->addToSparseMatrix(node1, I1_ii);
 4559:          node1->addToSparseMatrix(node2, I1_ij); 
 4560:          node1->addToSparseMatrix(node3, I1_ik);
 4561:          node1->addToSparseMatrix(node4, I1_il);
 4562:   
 4563:          #pragma unroll
 4564:          for (int l=0; l<4; l++) {
 4565: 
 4566:             const Node *node = elem->nodes[l];
 4567: 
 4568:             // Additional variation in eta due to bed deformation or vertical velocity
 4569:             double extraEta = 0.0;
 4570:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4571:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4572: 
 4573:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4574:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4575:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4576: 
 4577:          }         
 4578:       } 
 4579: 
 4580: 
 4581:      node1->qel += (dt/elem->i34)*elem->vsource;
 4582:       
 4583: 
 4584:    } // for all elements connected to the node
 4585:    
 4586: 
 4587:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4588:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4589:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4590:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 4591:    // If it is an open boundary node...
 4592: 
 4593:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4594: 
 4595:       // At least one open bnd side, maybe two
 4596:       for (int l=0; l<2; l++) { 
 4597: 
 4598:          // Gets each of the sides sharing the node. 
 4599:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4600: 
 4601:     
 4602: 
 4603:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4604:          if (sideBnd != nullptr) {
 4605:             // If the side is on a boundary...
 4606: 
 4607:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4608: 
 4609:             // Get the boundary segment
 4610:             const BoundarySegment *sideSegment = sideBnd->segment;
 4611:             const Side *side = sideBnd->side;
 4612: 
 4613:             // Integral I_3
 4614:             if (sideSegment->ifltype != 0) {
 4615:             // Natural or Flather b.c.
 4616: 
 4617:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4618:                // especially for Flather b.c.
 4619:                double ri3 = 0.0;
 4620:                if (!side->isDry) {
 4621:                   // If the side is not dry
 4622:                   
 4623:                   // Computes the side flux of (uth, vth)
 4624:                   double Vn = 0.0;
 4625:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4626:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4627:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4628: 
 4629:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4630:                   }
 4631: 
 4632:                   ri3 = 0.5*side->len*Vn;
 4633:                }
 4634: 
 4635:                if (sideSegment->ifltype == -1) { // Flather 1
 4636: 
 4637:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4638:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4639: 
 4640:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4641:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4642:                   
 4643:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4644:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4645: 
 4646:                } 
 4647:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4648:                   // Reset ri3
 4649:                   ri3 = 0.0;
 4650: 
 4651:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4652:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4653: 
 4654:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4655: 
 4656:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4657:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4658: 
 4659:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4660:                   node1->addToSparseMatrix(node1, con0*2.0);
 4661:                   node1->addToSparseMatrix(node2, con0);
 4662: 
 4663:                } // if Flather or Discharge
 4664: 
 4665:                node1->qel -= thetai*dt*ri3;  
 4666: 
 4667: 
 4668:             } // I_3
 4669:           
 4670: 
 4671:             // Integral I_5
 4672:             if(!side->isDry) {
 4673: 
 4674:                const double Unbar = dot(side->U, side->n);
 4675:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4676: 
 4677:             } // I_5
 4678: 
 4679:          } // if is boundary side
 4680: 
 4681:       } // for l
 4682: 
 4683:    } // if isbnd
 4684: 
 4685: 
 4686: }
 4687: 
 4688: 
 4689: 
 4690: extern "C" {
 4691:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4692:                                   int* indices, int* indptr) {
 4693: 
 4694:       NODE(node);
 4695:       
 4696:       const int idx = node->idx;
 4697:       
 4698:       // Computes the index in the nzz array      
 4699:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4700: 
 4701: 
 4702:       indptr[idx] = nzzIdx;
 4703:       indices[nzzIdx] = idx;
 4704: 
 4705:       data_d[nzzIdx]    = node->coeffDiag;
 4706: 
 4707:       b_d[idx] = node->qel;
 4708: 
 4709:       for (int k = 0; k < node->numNodes; ++k) {
 4710:          const Node* nb = node->nodes[k];
 4711: 
 4712:          const int j = nb->idx;
 4713: 
 4714:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4715: 
 4716:          indices[nzzIdx + k + 1] = j;
 4717:       }
 4718: 
 4719:  
 4720:    }
 4721: 
 4722: 
 4723: 
 4724:    __global__ void solverCopyResult(double* x) {
 4725:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4726:       NODE(node);
 4727:       const int idx = node->idx;
 4728: 
 4729:       node->mX = x[idx];
 4730:    }
 4731: 
 4732: 
 4733:    __global__ void rollUpElevation(void) {
 4734: 
 4735:       NODE(node);
 4736: 
 4737:       node->eta1 = node->eta2;
 4738: 
 4739:    }
 4740: 
 4741: 
 4742:    __global__ void backtrackAllNodes(void) {
 4743: 
 4744:       // max/min # of sub-divisions
 4745:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4746:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4747: 
 4748:       SIDE(side);
 4749: 
 4750:       const int kb = side->kb;
 4751: 
 4752: 
 4753:       // Initialize btrack velocities to the actual velocities at the side 
 4754:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4755:   
 4756:       if (side->isDry) return;
 4757:      
 4758: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4759: 
 4760:       // Checks that at least one element is not dry
 4761:       const Element *elem1 = side->elems[0];
 4762:       const Element *elem2 = side->elems[1];
 4763: 
 4764: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4765: 
 4766:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4767:       
 4768:       // XXXXXX
 4769:       // !swild_tmp to store global coord. of the starting side
 4770:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4771:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4772:       // !Use sframe2 
 4773:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4774: 
 4775: 
 4776:       for (int k = kb; k < nvrt; k++) {
 4777:       //  For ics=2, the coordinates are all in the side's local frame
 4778: 
 4779:          const int iadvf = side->iadv();  // Advection flag   
 4780:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4781: 
 4782:          const double vmag2 = norm2(side->u2[k]);
 4783: 
 4784:          if (vmag2 <= velmin_btrack_sq) {  
 4785:             // No activity 
 4786: 
 4787:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4788:             
 4789:          } else {  // do btrack
 4790: 
 4791:             // Compute number of sub-divisions based on local gradients of the velocity field
 4792: 
 4793:             // XXX IS THIS NECESSARY?
 4794:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4795:             double suma = 0.0;
 4796:             int icount = 0;
 4797:             #pragma unroll
 4798:             for (int l=0; l<2; l++) {
 4799:             // For each element sharing the side...
 4800: 
 4801:                const Element *elem = side->elems[l];
 4802:                  
 4803:                if (elem == nullptr) continue;
 4804: 
 4805:                icount++;
 4806: 
 4807:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4808:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4809:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4810: 
 4811:                double utmp[4];
 4812:                double vtmp[4];
 4813:                #pragma unroll
 4814:                for (int j = 0; j < elem->i34; j++) {
 4815: 
 4816:                   const Node *node = elem->nodes[j];
 4817: 
 4818:                   if constexpr(ics==1) {
 4819:                      utmp[j] = node->u2[k].x;
 4820:                      vtmp[j] = node->u2[k].y;  
 4821: 
 4822:                   } else {
 4823:                      // 'Project' the velocity from the node frame to the element frame
 4824:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4825:                      utmp[j] = tmp_u2.x;
 4826:                      vtmp[j] = tmp_u2.y;
 4827: 
 4828:                   }
 4829:                } // for j
 4830: 
 4831:                const Vector2 grad_u = elem->grad2(utmp); 
 4832:                const Vector2 grad_v = elem->grad2(vtmp);
 4833:    
 4834:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4835:             } // for l
 4836: 
 4837:             assert(icount > 0 && "Impossible 77");
 4838: 
 4839:             // '4' is somewhat arbitrary
 4840:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4841: 
 4842:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4843:             Vector3 u_int = {0.0, 0.0, 0.0};
 4844: 
 4845:             side->btrack(k, dt, dtbk, u_int);
 4846: 
 4847: 
 4848:             side->btu[k] = {u_int.x, u_int.y};
 4849:                
 4850:          } // if vmag (do backtrack)
 4851: 
 4852: 
 4853:       } // for k=kb,nvrt-1
 4854: 
 4855:    }
 4856: 
 4857: } // extern "C"
 4858: 
 4859: template<int nc>
 4860: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4861: 
 4862: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4863: //
 4864: // a,b,c,rhs: input vectors and are not modified by this program.
 4865: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4866: // rhs is the r.h.s.
 4867: // n: actual rank of the system.
 4868: // rows in u() and rhs();
 4869: // u: output with nc columns (transposed to rows)
 4870: // gam: a working array.
 4871: //
 4872: // NOTES:
 4873: // This is a template function that allows for different numbers of columns in the rhs vector.
 4874: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4875: 
 4876:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4877:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4878: 
 4879:    double bet = b[0];
 4880:    if constexpr (nc == 1) {
 4881:       u[0] = rhs[0]/bet;
 4882:    } else {
 4883:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4884:    }
 4885: 
 4886:    for (int j = 1; j < n; j++) {
 4887:       gam[j] = c[j - 1]/bet;
 4888:       bet = b[j] - a[j]*gam[j];
 4889: 
 4890:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4891: 
 4892:       if constexpr (nc == 1) {
 4893:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4894:       } else {
 4895:          for (int l = 0; l < nc; l++) {
 4896:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4897:          }
 4898:       }
 4899:    }
 4900: 
 4901:    // Back-substitution
 4902:    for (int j = n - 2; j >= 0; j--) {
 4903:       if constexpr (nc == 1) {
 4904:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4905:       } else {
 4906:          for (int l = 0; l < nc; l++) {
 4907:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4908:          }
 4909:       }
 4910:    }
 4911: }
 4912: 
 4913: 
 4914: 
 4915: // Helper function that contains the core algorithm
 4916: template<typename XAccessor, typename YAccessor>
 4917: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4918:                                     double  yp_top, double  yp_bot, 
 4919:                                     CubicSpline &spline) {
 4920:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4921:    // 
 4922:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4923:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4924:    //
 4925:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4926:    // 
 4927:    // Inputs: 
 4928:    //            n: dimension for x etc; # of data pts (>=2);
 4929:    //            getX, getY: functions to access x,y coordinates
 4930:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4931:    //     Output: 
 4932:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4933: 
 4934:    const int n = k2 - k1 + 1;
 4935:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4936: 
 4937:    // Allocate memory for the splines
 4938:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4939:    spline.x   = new double[n];
 4940:    spline.y   = new double[n];
 4941:    spline.yp  = new double[n];
 4942:    spline.ypp = new double[n];
 4943: 
 4944:    for (int k=k1; k<=k2; k++) {
 4945:       spline.x[k] = getX(k);
 4946:       spline.y[k] = getY(k);
 4947:    }
 4948: 
 4949:    // This is to simplify expressions later
 4950:    double *x = spline.x;
 4951:    double *y = spline.y;
 4952: 
 4953:    double *a = nullptr;
 4954:    double *b = nullptr;
 4955:    double *c = nullptr;
 4956:    double *gam = nullptr;
 4957:    double *rhs = nullptr;
 4958:    
 4959: 
 4960:       a = new double[n];   // Lower diagonal
 4961:       b = new double[n];   // Diagonal
 4962:       c = new double[n];   // Upper diagonal
 4963:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4964:       rhs = new double[n]; // Right-hand side
 4965: 
 4966:    for (int k=k1; k<=k2; k++) {
 4967:       if (k == k1) {
 4968:          // Bottom level
 4969:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4970:          b[k] = (x[k+1] - x[k])/3.0;
 4971:          c[k] = b[k]/2.0;
 4972:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4973:       } else if (k == n - 1) {
 4974:          // Top level (surface)
 4975:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4976:          b[k] = (x[k] - x[k-1])/3.0;
 4977:          a[k] = b[k]/2.0;
 4978:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4979:       } else {
 4980:          // Intermediate levels
 4981:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4982:          b[k] = (x[k+1] - x[k-1])/3.0;
 4983:          a[k] = (x[k  ] - x[k-1])/6.0;
 4984:          c[k] = (x[k+1] - x[k  ])/6.0;
 4985:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4986:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4987:       }
 4988:    }
 4989: 
 4990:    // Solve the tridiagonal system
 4991:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4992:    
 4993:    spline.yp[k1] = yp_bot;
 4994:    spline.yp[k2] = yp_top;
 4995: 
 4996:    // Compute rest of 1st derivatives using the splines
 4997:    for (int k=k1+1; k<k2; k++) {
 4998:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4999:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5000:    }
 5001:    
 5002:    delete[] a;
 5003:    delete[] b;
 5004:    delete[] c;
 5005:    delete[] gam;
 5006:    delete[] rhs;
 5007: 
 5008: }
 5009: 
 5010: // Array version
 5011: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5012:                                 double y_top, double y_bot, 
 5013:                                 CubicSpline &spline) {
 5014:    auto getX = [x] (int k) { return x[k]; };
 5015:    auto getY = [y] (int k) { return y[k]; };
 5016:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5017: }
 5018: 
 5019: // Lambda version - allows custom access patterns
 5020: template<typename XFunc, typename YFunc>
 5021: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5022:                                 double y_top, double y_bot,
 5023:                                 CubicSpline &spline) {
 5024:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5025: }
