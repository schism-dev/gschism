 6656:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6657: 
 6658:       SIDE(side);
 6659: 
 6660:       side->U = {0.0, 0.0}; 
 6661:          
 6662:       if(side->isDry) return;
 6663: 
 6664:       // Vertically integrated velocity U
 6665:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6666:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6667:          side->U += side->Dz(k + 1)*uc;  
 6668:       }
 6669: 
 6670:    }
 6671: 
 6672:    __global__ void computeBottomDragVegetation(void) {
 6673:       // UNFINISHED. CHECK THIS: XXXXX
 6674:       // How many kernels are needed? Why so many for loops?
 6675:       // Is the loop on sides needed?
 6676: 
 6677:       NODE(node);
 6678: 
 6679:       const int    kb      = node->kb;
 6680:       const double htot    = node->htot2(); 
 6681:       
 6682:       if (node->isDry) {
 6683:          // Default values for dry nodes
 6684:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6685:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6686: 
 6687:          return;
 6688:        
 6689:       }
 6690: 
 6691:       // Computes bottom drag Cd based on the selected nchi
 6692:       node->computeBottomDragCd();
 6693:       
 6694: 
 6695: 
 6696:       //   Bottom stress in m^2/s^2
 6697:       if (node->rho[kb + 1] >= -98.0)
 6698:       {
 6699:          const double mag_u = length(node->u2[kb + 1]);
 6700:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6701: 
 6702:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6703:          // !sediment erosion: this part needs more documentation
 6704:       }
 6705:     
 6706: 
 6707: 
 6708:       // Compute vegetation parameters
 6709:       //--------------------------------
 6710: 
 6711: 
 6712:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6713:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6714: 
 6715:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6716:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6717:          int kbin = 0; // bin index
 6718:          for (int k = kb; k < nvrt; k++) {
 6719:             // Computes node height above the bottom level
 6720:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6721:             assert(false && "Vertical variation of vegetation not implemented");
 6722: 
 6723:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6724:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6725:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6726:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6727:             // } else {
 6728:             //    // Find the bin at which the current vertical level is
 6729:             //    while (kbin<nbins_veg_vert) {
 6730:             //       const double zn = node->z[kbin];
 6731:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6732:             //          break;
 6733:             //       } // if
 6734:             //       kbin++;
 6735:             //    } // while
 6736:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6737: 
 6738:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6739:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6740:                
 6741:             //    // Linear interpolation of the vegetation parameters
 6742:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6743:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6744:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6745:             // } // if rl10
 6746: 
 6747:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6748: 
 6749:          } // for k
 6750: 
 6751: 
 6752:       } else { // Ganthy (iveg==2)
 6753:       //  Modify canopy height, diameter, and density
 6754: 
 6755:          // Make sure there is vegetation on this node
 6756:          if (node->veg_h_unbent > 0.0) {
 6757:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6758: 
 6759:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6760:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6761:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6762: 
 6763:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6764:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6765:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6766:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6767:          } // if veg_h_unbent
 6768: 
 6769:          for (int k = 0; k < nvrt; k++) {
 6770:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6771:          } // for k
 6772:       
 6773: 
 6774:       } // if iveg
 6775:      
 6776: 
 6777:       // Compute vertical mean of veg_alpha3D
 6778:       if (iveg != 0) {
 6779:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6780:          double sum1=0.0;
 6781:          double sum2=0.0;
 6782:          // Integrate over each level under the canopy...
 6783:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6784:             const double Dz = node->Dz(k);
 6785: 
 6786:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6787:             sum2 += Dz;
 6788: 
 6789:          } // for k
 6790:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6791:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6792: 
 6793:       } // if iveg
 6794: 
 6795:    }
 6796: 
 6797: 
 6798:    __global__ void computeTurbulence(void) {
 6799: 
 6800:       NODE(node);
 6801: 
 6802:       // Calls the templated function to compute the turbulence model parameters.
 6803:       // turbulenceModel is just a class enum version of itur.
 6804:       computeTurbulenceModel<turbulenceModel>(node);
 6805:       
 6806:    }
 6807: 
 6808: 
 6809:    __global__ void computeVegetationAndDragParameters(void) {
 6810:       // Computes the vegetation and drag model parameters:
 6811:       // chi, \tilde\chi, beta, \breve{H}
 6812:       
 6813:       SIDE(side);
 6814: 
 6815:       side->hhat = 0.0;
 6816:       side->chi2 = 0.0;
 6817:       side->chi = 0.0;
 6818:       side->veg_c2 = 0.0;
 6819:       side->veg_beta = 0.0;
 6820: 
 6821:       if (side->isDry) return;
 6822: 
 6823:       const double htot = side->htot2();
 6824:       const int    kb   = side->kb;
 6825: 
 6826:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6827: 
 6828:       const double veg_h     = side->veg_h();
 6829:       const double veg_nv    = side->veg_nv();
 6830:       const double veg_c     = side->veg_c();
 6831:       const double veg_beta  = side->veg_beta;
 6832:       const double veg_alpha = side->veg_alpha_vert_mean();
 6833: 
 6834:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6835:       // Velocity magnitude at the bottom level
 6836:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6837:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6838:       side->chi2 = side->Cd()*vmag1;
 6839:       side->chi  = side->chi2;
 6840: 
 6841:       if constexpr(iveg != 0) {
 6842:          const Node *n1 = side->n1;
 6843:          const Node *n2 = side->n2;
 6844:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6845:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6846:       }
 6847: 
 6848:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6849: 
 6850:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6851:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6852:       double magUa = 0.0;
 6853:       if constexpr(iveg != 0) {
 6854:          if (side->is3D() && veg_h > 0.0) {
 6855:             // 3D wet side with veg...
 6856: 
 6857:             double magUa = 0.0;
 6858:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6859:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6860: 
 6861:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6862:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6863:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6864: 
 6865:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6866:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6867: 
 6868:                   // Velocity magnitude at the bottom (l) of the level
 6869:                   const double ul = length(side->u2[k]);
 6870: 
 6871:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6872:                   magUa += Dz*0.5*(uh + ul);
 6873: 
 6874:                } // if HasVegetation
 6875:             } // for k
 6876:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6877: 
 6878:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6879:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6880:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6881:                const double zCpy = side->zTopCanopy();
 6882:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6883:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6884:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6885:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6886:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6887:             } // if isSubmerged
 6888:          } // if is3D
 6889:       } // if iveg   
 6890: 
 6891:       // Computes the friction modified depth, \breve{H} in notes
 6892:       if (side->is2D()) { // 2D
 6893: 
 6894:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6895:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6896: 
 6897:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6898: 
 6899:          side->hhat = htot*htot/fricH; 
 6900: 
 6901:       } else { // 3D
 6902:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6903: 
 6904:          if constexpr(iveg != 0) {
 6905:             
 6906:             if (side->isSubmerged()) { 
 6907:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6908:                side->hhat -= veg_c*Hhat_alpha;
 6909: 
 6910:             } else { // Emergent
 6911:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6912:             }
 6913:          } // if iveg
 6914: 
 6915:          // Enforce positivity for 3D model
 6916:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6917:       } // if 3D
 6918: 
 6919:    }
 6920: 
 6921: 
 6922: 
 6923:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6924:    // Computes the density gradient between two elements, e1 and e2.
 6925:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6926:    // zero in the direction normal to the side. 
 6927:    // 
 6928:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6929:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6930:    //
 6931:    // Input:
 6932:    //    e1: Element
 6933:    //    e2: Neighbor element (or nullptr if boundary)
 6934:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6935:    //    k: Index of the half-level at which the density is interpolated
 6936:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6937:    // 
 6938:    // Output:
 6939:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6940:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6941: 
 6942:       if (e2 == nullptr || e2->isDry) {
 6943:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6944: 
 6945:          Side *side = e1->sides[j];
 6946:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6947:                  
 6948:          if constexpr(ics == 1) {
 6949:             vec = side->n; // Normal vector to the side
 6950:          } else {
 6951:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6952:             // IMPLEMENT THIS XXXXXX
 6953:             // !replace with xel, yel?
 6954:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6955:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6956:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6957:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6958:          } //ics
 6959:                    
 6960:          diffRho = 0.0;
 6961: 
 6962:       } else { //internal and wet
 6963:          if constexpr(ics==1) {
 6964:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6965: 
 6966:             // Vector from e1 to e2
 6967:             vec = e2->center - e1->center;
 6968: 
 6969:          } else { 
 6970:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6971:             // Remember that elem->center is in global coordinates
 6972:             // IMPLEMENT THIS XXXXXX
 6973:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6974:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6975:             //                   alow(j)=xctr2
 6976:             //                   bdia(j)=yctr2
 6977:          } // ics
 6978: 
 6979:          diffRho = rho2 - e1->demeanedDensity(k);
 6980:       }
 6981: 
 6982:    }
 6983: 
 6984:    __global__ void computeDensityCubicSplines(void) {
 6985:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6986: 
 6987:       ELEM(elem);
 6988: 
 6989:       if (elem->isDry) return;
 6990: 
 6991:       const int kb = elem->kb;
 6992: 
 6993:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6994:       if (elem->is2D()) {
 6995:          // In the 2D case, the density is constant at the prism level. 
 6996:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6997:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6998:       } else { //3D
 6999: 
 7000:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 7001:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 7002:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 7003:          ///// XXXX CHECK INDICES!!!!!
 7004:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 7005:       } // 2D/3D
 7006: 
 7007:    }
 7008: } // extern "C"
 7009: 
 7010: 
 7011: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 7012: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 7013: 
 7014:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 7015: 
 7016:    const int kb  = elem->kb;
 7017:    const int kb2 = elem2->kb;
 7018: 
 7019:    // z-coordinate of prism of elem
 7020:    const double zp = elem->z_prism(k);
 7021: 
 7022:    double rho = 0.0;
 7023: 
 7024:    if (elem2->is2D()) {
 7025:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 7026: 
 7027:    } else {  // 3D
 7028: 
 7029:       // eta_min may be < zmax
 7030:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 7031:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 7032: 
 7033:       // (Extrapolate density below bottom, we will fix it later)
 7034:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 7035:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 7036:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 7037:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 7038:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 7039:    } // 2D/3D
 7040:      
 7041: 
 7042:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 7043:    // Now we need to fix it.
 7044:    if (elem->z[k] < elem2->z[kb2]) {
 7045:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 7046: 
 7047:       // There are two methods to adjust the density at the bottom of the element.
 7048:       // iunder_deep=0: 
 7049:       const double depth1 = abs(elem->z[kb]); // larger depth
 7050: 
 7051:       if (iunder_deep==0) {
 7052: 
 7053:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 7054: 
 7055:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 7056: 
 7057:       } else { // iunder_deep != 0
 7058: 
 7059:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 7060: 
 7061:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 7062: 
 7063:          //   Demeaned density at the same z coordinate as
 7064:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 7065:          }
 7066: 
 7067:       } // if iunder_deep
 7068:    } // if elem->z[kb] < elem2->z[kb]
 7069: 
 7070:    return rho;
 7071: }
 7072: 
 7073: 
 7074: extern "C" {
 7075:    __global__ void computeDensityGradient(void) {
 7076: 
 7077:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 7078:       if constexpr(ibc != 0) return;
 7079: 
 7080:          // Compute the horizontal density gradient at each element.
 7081:       // It works in two steps:
 7082:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7083:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7084:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7085:       //             gradRho.r1 = rho1 - rho0
 7086:       //             gradRho.r2 = rho2 - rho0
 7087:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7088:       // 
 7089:       //  NOTE: We use de-meaned densities.
 7090: 
 7091:       ELEM(elem);
 7092: 
 7093:       if (elem->isDry) return;
 7094: 
 7095:       const int kb  = elem->kb;
 7096:       const int i34 = elem->i34;
 7097: 
 7098:       for (int k = kb + 1; k < nvrt; k++) {
 7099:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 7100:          //             gradRho.r1 = rho1 - rho0
 7101:          //             gradRho.r2 = rho2 - rho0
 7102:          int icount = 0;
 7103:          double sumRx = 0.0;
 7104:          double sumRy = 0.0;
 7105:          for (int j1=0; j1<i34; j1++) { 
 7106: 
 7107:             const int j2 = elem->nxq(j1 + 1);
 7108: 
 7109:             // Pairs of consecutive neighbor elements of elem
 7110:             const Element *e1 = elem->nghbElems[j1];
 7111:             const Element *e2 = elem->nghbElems[j2];
 7112: 
 7113:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 7114:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 7115:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 7116: 
 7117:             // Compute the density difference and the vector from elem to e1 and e2
 7118:             // getRhoDiffAndVec takes into account boundaries/dry elements
 7119:             double diffRho1, diffRho2;
 7120:             Vector2 vec1, vec2;
 7121:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 7122:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 7123: 
 7124:             const double rl1 = length(vec1);
 7125:             const double rl2 = length(vec2);
 7126:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 7127: 
 7128:             const double delta = cross(vec1, vec2);
 7129:             const double sintheta = abs(delta)/(rl1*rl2);
 7130: 
 7131:             // To avoid problems, avoid elements with small angle between vectors
 7132:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 7133:             const bool validEq = (sintheta > sin_one_deg);
 7134: 
 7135:             if (validEq) {
 7136:                // Solve the system of equations to get the density gradient at elem
 7137:                icount++;
 7138:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7139:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7140:                sumRx += Rx;
 7141:                sumRy += Ry;
 7142:             }
 7143:          } // for j1
 7144: 
 7145:          // Compute the average density gradient at elem
 7146:          if (icount==0) {
 7147:            // Bad mesh quality; bail out with 0 b-cc
 7148:            elem->gradRho[k] = {0.0, 0.0};
 7149:          } else {
 7150:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7151:          }
 7152: 
 7153:       } // for k
 7154: 
 7155:    }
 7156: 
 7157:    __global__ void computeBaroclinicTerm(void) {
 7158:    // Computes the baroclinic term at sides (at half levels).
 7159:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7160:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7161: 
 7162:       if (ibc == 1) return;
 7163: 
 7164:       SIDE(side);
 7165: 
 7166:       if (side->isDry) return;
 7167: 
 7168:       const Element *e1 = side->elems[0];
 7169:       const Element *e2 = side->elems[1]; 
 7170:       const int kb = side->kb;
 7171:       
 7172:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7173: 
 7174:       // interpolates vertically the density gradient of the two elements at the half level/
 7175: 
 7176:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7177:       int k2 = max(kb, nvrt / 2);
 7178: 
 7179:       // Starts the integration at the surface and goes down to the bottom
 7180:       side->bcc[nvrt-1] = {0.0, 0.0};
 7181:       for (int k = nvrt - 2; k >= kb; k--) {
 7182:       // For each prism level (from surface to bottom)...
 7183: 
 7184:          // For both elements, interpolate density gradient at the side's half level.
 7185:          // The gradient at the side is the average of the gradients at the elements.
 7186:          // w1, w2 are used to take into account boundary sides, with just one element.
 7187:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7188:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7189:          const double wsum = w1 + w2;
 7190:          w1 = w1/wsum;
 7191:          w2 = w2/wsum;
 7192:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7193: 
 7194:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7195:          Vector2 gradRho = {0.0, 0.0};
 7196:          if (e1 != nullptr && k > kb) {
 7197:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7198:             
 7199:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7200:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7201:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7202: 
 7203:             // Grad(rho) vertically interpolated at the side's half level
 7204:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7205: 
 7206:             // Projects the element density gradient to the side frame if needed.
 7207:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7208: 
 7209:             // Adds the contribution of the density gradient at the side's half level
 7210:             gradRho += gradRho1*w1;
 7211:          }      
 7212:          if (e2 != nullptr && k > kb) {
 7213:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7214:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7215:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7216:             
 7217:             // Grad(rho) vertically interpolated at the side's half level
 7218:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7219: 
 7220:             // Projects the element density gradient to the side frame if needed.
 7221:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7222: 
 7223:             // Adds the contribution of the density gradient at the side's half level
 7224:             gradRho += gradRho2*w2;
 7225:          }
 7226: 
 7227:          
 7228:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7229:          // multiplied by -rampbc*(g/rho0) 
 7230:          const double grav3 = side->grav3();
 7231:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7232: 
 7233:       } // for
 7234: 
 7235:    }
 7236: 
 7237: 
 7238: 
 7239:    __global__ void computeHorGradientAtSide(void) {
 7240: 
 7241:       // Compute the horizontal density gradient at each element.
 7242:       // It works in two steps:
 7243:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7244:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7245:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7246:       //             gradRho.r1 = rho1 - rho0
 7247:       //             gradRho.r2 = rho2 - rho0
 7248:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7249:       // 
 7250:       //  NOTE: We use de-meaned densities.
 7251: 
 7252:       SIDE(side);
 7253: 
 7254: 
 7255:       if (side->isDry) return;
 7256: 
 7257:       // Computes the gradient of the variables at the side center.
 7258:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7259:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7260:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7261: 
 7262:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7263:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7264:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7265:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7266: 
 7267:    }
 7268: 
 7269: 
 7270:    __global__ void solveMomentumEquations(double time) {
 7271: 
 7272:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7273:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7274: 
 7275:       SIDE(side);
 7276: 
 7277:       if (side->isDry) 
 7278:       {
 7279:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7280: 
 7281:          return;
 7282:       }
 7283: 
 7284:       const Node *n1 = side->n1;
 7285:       const Node *n2 = side->n2;
 7286: 
 7287:       const int kb = side->kb;
 7288: 
 7289:       const double veg_h = side->veg_h();
 7290:       const double grav3 = side->grav3();
 7291: 
 7292:       if (side->is2D()) {
 7293:          // Remember: Do not use htot2, which is updated.
 7294:          const double htot = side->htot1();
 7295:          const double hhat = side->hhat;
 7296: 
 7297:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7298: 
 7299:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7300:          const Vector2 tau2 = side->tau();
 7301: 
 7302:          // hat_gam has units of m/s
 7303: 
 7304:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7305:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7306:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7307: 
 7308:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7309: 
 7310: 
 7311:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7312: 
 7313:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7314: 
 7315:       }
 7316:       else { // 3D
 7317: 
 7318:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7319:          // 
 7320:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7321:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7322:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7323:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7324:          // k+1 and k.
 7325: 
 7326: 
 7327:          const int ndim = nvrt - kb;
 7328:          const double zTopCanopy = side->zTopCanopy();
 7329: 
 7330:          // Initialize the tridiagonal system
 7331:          for (int k = kb + 1; k < nvrt; k++) {
 7332:             
 7333:             const int kin = k - (kb + 1);
 7334: 
 7335:  
 7336:             alow[kin] = 0.0;
 7337:             cupp[kin] = 0.0;
 7338:             bdia[kin] = 0.0;
 7339: 
 7340:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7341:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7342: 
 7343:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7344:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7345:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7346: 
 7347:             // First part: layers k, k+1
 7348:             if (k < nvrt - 1) {
 7349:                              
 7350:                if constexpr(iveg != 0) {
 7351: 
 7352:                   // If there is vegetation at this level...
 7353:                   if (zTopCanopy > side->zc[k]) {
 7354:                      // If the canopy is above the k layer...
 7355:                      
 7356:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7357:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7358:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7359:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7360: 
 7361:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7362:                      const double vmag2 = length(ut2);
 7363:                      const double vmag1 = length(side->u2[k]);
 7364:                      const double vmag = 0.5*(vmag1 + vmag2);
 7365:                      
 7366:                      // Computes the vegetation alpha at the face center
 7367:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7368: 
 7369:                      cff1 += veg_alpha_sd*dt*vmag;
 7370: 
 7371:                   } // if (zTopCanopy
 7372:                } // if iveg
 7373: 
 7374:                const double dzz = side->Dz(k + 1);
 7375:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k + 1)); // Vertical viscosity at the face center
 7376:                const double tmp = dt*dfz/dzz;
 7377:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7378: 
 7379:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7380:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7381:             }
 7382: 
 7383: 
 7384:             // Second part: layers k-1, k
 7385:             if (k > kb + 1) {
 7386: 
 7387:                double cff1 = 1.0; //init \bar{c^k}
 7388: 
 7389:                if constexpr(iveg != 0) {
 7390:                   // If there is vegetation at this level...
 7391:                   if (zTopCanopy > side->zc[k-1]) {
 7392:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7393:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7394: 
 7395:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7396: 
 7397:                      const double vmag2 = length(ut2);
 7398:                      const double vmag1 = length(side->u2[k-1]);
 7399:                      const double vmag = 0.5*(vmag1 + vmag2);
 7400: 
 7401:                      // Computes the vegetation alpha at the face center
 7402:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7403:                      cff1 += veg_alpha_sd*dt*vmag;
 7404:                   } // if zTopCanopy
 7405: 
 7406:                } // if iveg
 7407: 
 7408:                const double dzz = side->Dz(k);
 7409:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k - 1)); // Vertical viscosity at the face center
 7410:                const double tmp = dt*dfz/dzz;
 7411:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7412: 
 7413:                alow[kin] += cff1*dzz/6.0 - tmp;
 7414:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7415: 
 7416:             } else { // Bottom boundary
 7417:                // This occurs at the bottom, where the bottom drag is applied.
 7418: 
 7419:                bdia[kin] += dt*side->chi2; // XXXX
 7420: 
 7421:             } // if (k > kb + 1)
 7422: 
 7423: 
 7424:          } // for (int k
 7425: 
 7426: 
 7427: 
 7428:          // Computes the RHS.
 7429:          // -----------------
 7430: 
 7431:          //	BC to be imposed at the end.
 7432: 
 7433:          const Vector2 gradETP  = side->gradETP;
 7434:          const Vector2 gradPr   = side->gradPr;
 7435:          const Vector2 gradEta1 = side->gradEta1;
 7436:          const Vector2 gradEta2 = side->gradEta2;
 7437: 
 7438:          const Vector2 *btu = side->btu;
 7439:          const Vector2 *u2  = side->u2;
 7440:          const double coriolis = side->coriolis;
 7441:          const Vector2 *nuGradU = side->nuGradU;
 7442: 
 7443:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7444:          for (int k = kb + 1; k < nvrt; k++) {
 7445:             const int kin = k - kb - 1;
 7446: 
 7447:             const double dz_0 = side->Dz(k);
 7448:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7449: 
 7450:             rrhs[kin] = {0.0, 0.0};
 7451:             double dz = 0.0;
 7452: 
 7453:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7454:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7455:             if (k < nvrt  ) dz += dz_1;
 7456:             if (k > kb + 1) dz += dz_0;
 7457: 
 7458:             // Elevation gradient, atmospheric pressure and tidal potential
 7459:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7460: 
 7461:             // Coriolis, advection, wind stress, and horizontal viscosity
 7462:             if (k < nvrt - 1) {
 7463: 
 7464: 
 7465:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7466:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7467:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7468:                                                 
 7469: 
 7470:                //diff stress tensors 1006
 7471:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7472:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7473:                   assert(false && "Not implemented: itur == 5");
 7474:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7475:                }
 7476:                // else assert(false && "itur # Not implemented");
 7477: 
 7478:             } else { // k == nvrt - 1 SURFACE
 7479:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7480:                const Vector2 tau2 = side->tau();
 7481: 
 7482:                rrhs[kin] += dt*tau2;          
 7483: 
 7484:             } // if k<nvrt
 7485: 
 7486: 
 7487:             if (k > kb + 1) {
 7488:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7489:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7490:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7491: 
 7492:                // diff stress tensors 1006
 7493:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7494:                   assert(false && "Not implemented: itur == 5");
 7495:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7496:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7497:                }
 7498:                // else assert(false && "itur # Not implemented");
 7499: 
 7500: 
 7501:             } // if k>kbs + 1
 7502: 
 7503:             // Baroclinic
 7504:             Vector2 *bcc = side->bcc;
 7505:             if constexpr(ibc == 0) {
 7506:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7507:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7508: 
 7509:             } // if ibc==0
 7510: 
 7511:          } // k=kb + 1,nvrt
 7512: 
 7513: 
 7514:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7515: 
 7516:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7517:             const int kin = k - kb - 1;
 7518:    
 7519:             // Velocity is always clamped to maximum values
 7520:             side->u2[k] = clampVelocity(soln[kin]);
 7521:          } // k
 7522: 
 7523:       } // if side->is2D()
 7524:       
 7525: 
 7526:       // Impose velocity boundary condition at the bottom
 7527:       if constexpr(imm == 2) { // 3D bed deformation model
 7528:          double dep;
 7529:          Vector2 vel;
 7530: 
 7531:          assert(false && "Not implemented: imm == 2");
 7532:          //update_bdef(time, x0, y0, dep, vel);
 7533:          // side->u2[kb] = vel;
 7534: 
 7535:       } else { // imm = 0 or 1
 7536:          if (side->Cd() == 0.0) {
 7537:             side->u2[kb] = side->u2[kb + 1];
 7538: 
 7539:          } else if (side->is3D()) { // 3D no slip bottom   
 7540:             side->u2[kb] = {0.0, 0.0};
 7541: 
 7542:          }
 7543:           
 7544:       } // if imm
 7545: 
 7546:       // The velocities below the bottom level are set to zero
 7547:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7548: 
 7549: 
 7550:    }
 7551: 
 7552: 
 7553:    __global__ void applyMomentumBC(void) {
 7554: 
 7555:       SIDE_BND(sideBnd);
 7556: 
 7557:       Side *side = sideBnd->side;
 7558:       const BoundarySegment *segment = sideBnd->segment;
 7559:       const Node *n1 = side->n1;
 7560:       const Node *n2 = side->n2;
 7561: 
 7562:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7563: 
 7564:       const bool isLand = segment->isLand;
 7565:       const int ifltype = segment->ifltype;
 7566: 
 7567:       const int kb = side->kb;
 7568: 
 7569: 
 7570:       if (!isLand && ifltype != 0) {
 7571:          const Vector2 *ubc = sideBnd->ubc;
 7572:   
 7573:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7574:             
 7575:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7576:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7577: 
 7578:             if (ifltype == -1) {
 7579:                // Flather 1
 7580: 
 7581:                const double depth = side->depth();
 7582: 
 7583:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7584: 
 7585:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7586: 
 7587:                side->u2[k] = vnorm*side->n;
 7588: 
 7589:             } else if (ifltype == -2) { // Discharge
 7590: 
 7591:                const double eta1 = side->eta1();
 7592:                const double eta2 = side->eta2();
 7593:                const double htot = side->htot2();
 7594: 
 7595:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7596:                assert(false && "Not implemented: Discharge bc");
 7597:                // const double dischrg = discharge(eta1);
 7598:                const double dischrg = 0.0; // XXX REMOVE
 7599:                
 7600: 
 7601:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7602: 
 7603:                const double vnorm = dischrg*eta2/htot;
 7604: 
 7605:                side->u2[k] = vnorm*side->n;
 7606: 
 7607:             }
 7608:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7609:                const double vnorm = dot(side->u2[k], side->n);
 7610: 
 7611:                double rat;
 7612:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7613:                else              rat = segment->vobc2; // outgoing
 7614: 
 7615:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7616: 
 7617:             }
 7618:             else { // not Flather or 3D radiation
 7619: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7620:                side->u2[k] = ubc[k];
 7621: 
 7622:             } // if (segment->ifltype...
 7623: 
 7624:          }
 7625: 
 7626:       }
 7627:       else if (isLand) { // if it is land boundary side
 7628: 
 7629:          if constexpr(islip == 0) { // free slip
 7630: 
 7631:             for (int k = kb; k < nvrt; k++) {
 7632: 
 7633:                const Vector2 t = side->t();
 7634:                const Vector2 n = side->n;
 7635: 
 7636:                double vnorm = 0.0; // for most cases
 7637:                const double vtan = dot(side->u2[k], t);
 7638:                
 7639:                side->u2[k] = vtan*t - vnorm*n;
 7640: 
 7641:             }
 7642: 
 7643:          } else { // no slip
 7644:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7645: 
 7646:          }
 7647:       } // if (side segment type...
 7648: 
 7649:    }
 7650: 
 7651: 
 7652:    __global__ void shapiroFilter1(void) {
 7653:       // First step of the Shapiro filter (normally used if indvel<=0)
 7654:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7655: 
 7656:       SIDE(side);
 7657: 
 7658:       // Only internal wet sides are processed
 7659:       if (side->isDry || !(side->isInternal())) return;
 7660: 
 7661:       const int kb = side->kb;
 7662: 
 7663:       for (int mm = 0; mm < niter_shap; mm++) {
 7664: 
 7665:          for (int k = kb + 1; k < nvrt; k++) {
 7666:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7667:             Vector2 suru = {0.0, 0.0};
 7668: 
 7669:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7670: 
 7671:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7672: 
 7673:                int kin = k;
 7674:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7675:                
 7676:                // Get the velocity at the neighbor's side.
 7677:                Vector2 nSideU2 = nSide->u2[kin];
 7678: 
 7679:                // Projects the velocity to the current side frame if needed.
 7680:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7681: 
 7682:                suru += nSideU2;
 7683:             }
 7684: 
 7685:             // Reusing bcc as a temporary array to store the suru values.
 7686:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7687: 
 7688:          }
 7689:       }
 7690:    }
 7691: 
 7692:    __global__ void shapiroFilter2(void) {
 7693:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7694: 
 7695:       SIDE(side);
 7696: 
 7697: 
 7698:       if (side->isDry || !(side->isInternal())) return;
 7699: 
 7700:       const int kb = side->kb;
 7701: 
 7702:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7703: 
 7704:       if (side->is2D()) {
 7705:          side->u2[kb + 1] = side->bcc[kb + 1];
 7706:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7707: 
 7708:       } else {
 7709:          // 3D
 7710:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7711:          
 7712:       }
 7713: 
 7714:    }
 7715: 
 7716: 
 7717:    __global__ void ul0UpdateZCoords(void) {
 7718:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7719:       
 7720:       NODE(node);      
 7721: 
 7722: 
 7723:       if (false) { //node->isDry) { XXXXXXX
 7724: 
 7725:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7726: 
 7727:          if constexpr(ivcor != 1) node->kb = 0;
 7728: 
 7729:       } else {
 7730: 
 7731:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7732:          node->updateKb();
 7733: 
 7734:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7735: 
 7736:       }
 7737: 
 7738:       // We use the temp.b field to store the previous state of isDry.
 7739:       node->tmp.b = node->isDry;
 7740: 
 7741:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7742:       node->isDry = true;
 7743: 
 7744:    }
 7745: 
 7746:    __global__ void ul0ComputeDryElements(void)
 7747:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7748:    {
 7749:       ELEM(elem);
 7750: 
 7751:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7752: 
 7753:       elem->kb = 0;
 7754: 
 7755:       if (elem->isDry) return;
 7756: 
 7757: 
 7758:    //    if(elem->isDry2()) { // XXXX
 7759:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7760:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7761:    //        call parallel_abort(errmsg)
 7762:    //    }
 7763: 
 7764:       const Node *n1 = elem->nodes[0];
 7765:       const Node *n2 = elem->nodes[1];
 7766:       const Node *n3 = elem->nodes[2];  
 7767:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7768: 
 7769:       // Computes element's kb as the minimum of the nodes' kb.
 7770:       const int kb1 = n1->kb;
 7771:       const int kb2 = n2->kb;
 7772:       const int kb3 = n3->kb;
 7773:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7774: 
 7775: 
 7776:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7777: 
 7778: 
 7779:       // Computes the element z as the mean of the nodes z.
 7780:       for (int k = elem->kb; k < nvrt; k++) {
 7781: 
 7782:          // Compute the element z as the mean of the nodes z.
 7783:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7784:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7785:          elem->z[k] /= elem->i34;
 7786: 
 7787:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7788:       }
 7789:                   
 7790:    }
 7791: 
 7792:    __global__ void ul0ComputeDryNodes(void)
 7793:    // Updates node's isDry based on the elements' isDry. 
 7794:    {
 7795:       NODE(node);
 7796: 
 7797:       node->isDry = true;
 7798: 
 7799:       // A node is wet if at least one of the elements sharing it is wet.
 7800:       for (int j = 0; j < node->numElements; j++) {
 7801:          const Element *elem = node->elements[j];
 7802:          if (!elem->isDry) {
 7803:             node->isDry = false;
 7804:             break;
 7805:          }
 7806:       }
 7807: 
 7808:        
 7809:    }
 7810: 
 7811: 
 7812:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7813:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7814:    // node->tmp.b is true if the node was previously dry.
 7815:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7816:    {
 7817:       NODE(node);
 7818:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7819: 
 7820:       // Avoid this the first time step.
 7821:       if (it == iths) return;  
 7822: 
 7823:       const bool wasDry = node->tmp.b;
 7824: 
 7825: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7826: 
 7827:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7828: 
 7829:          for (int k=0; k < nvrt; k++) {
 7830: 
 7831:             Vector3 utmp={0.0, 0.0, 0.0};
 7832: 
 7833:             double ttmp=0.0;
 7834:             double stmp=0.0;
 7835:             int icount=0;
 7836:             for (int j = 0; j < node->numNodes; j++) {
 7837: 
 7838:                const Node *nbrNode = node->nodes[j];
 7839:                
 7840:                const bool wasNbrDry = nbrNode->tmp.b;
 7841: 
 7842:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7843:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7844: 
 7845:                   icount++;
 7846: 
 7847:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7848:                   utmp += nbrNode->uvw2(k);
 7849:                   
 7850:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7851:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7852:                }
 7853:             }
 7854: 
 7855:             if (icount > 0) {
 7856:                const double inv_icount = 1.0/icount;
 7857:                utmp = inv_icount*utmp;
 7858:                node->u2[k]     = {utmp.x, utmp.y};
 7859:                node->w2[k]     = utmp.z;
 7860:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7861:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7862:             } else {
 7863:                node->u2[k] = {0.0, 0.0};
 7864:                node->w2[k] = 0.0;
 7865:                // Initialize tracers to 0.0??? XXXXX
 7866:             }
 7867:          }
 7868:       }
 7869:    }
 7870: 
 7871:   
 7872:    
 7873: 
 7874: 
 7875:    __global__ void ul0UpdateSides(int it, int iths) {
 7876:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7877:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7878:    // The dryness of the sides is updated in ul0UpdateSides2.
 7879: 
 7880:       SIDE(side);
 7881: 
 7882:       // A side is wet if and only if at least one of its elements is wet.
 7883:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7884:  
 7885:       const Node *n1 = side->n1;
 7886:       const Node *n2 = side->n2;
 7887:      
 7888:       const int kb1 = n1->kb;
 7889:       const int kb2 = n2->kb;
 7890: 
 7891:       side->kb = 0; // default when dry
 7892: 
 7893:       if (isWet) {
 7894: 
 7895:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7896: 
 7897:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7898: 
 7899:          side->kb = min(kb1, kb2);
 7900: 
 7901:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7902: 
 7903:          for (int k = side->kb; k < nvrt; k++) {
 7904:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7905: 
 7906:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7907: 
 7908:             // Compute velocity for re-wetted sides 
 7909:             if ((it != iths) && (side->isDry && isWet)) {
 7910: 
 7911:                Vector2 utmp={0.0, 0.0};
 7912: 
 7913:                int icount=0;
 7914: 
 7915:                // For all the sides on the two elements that share this side
 7916:                for (int j = 0; j < 2; j++) {
 7917:                   const Element *elem = side->elems[j];
 7918:                   if (elem == nullptr) continue;
 7919: 
 7920:                   for (int jj=0; jj < elem->i34; jj++) {
 7921:                      const Side *nSide = elem->sides[jj];
 7922:                      if (nSide->isDry) continue;
 7923: 
 7924:                      icount++;
 7925:                      utmp += nSide->u2[k];  
 7926:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7927:                   }
 7928:                }
 7929:                   
 7930:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7931:                if (icount > 0)  side->u2[k] = utmp/icount;
 7932:                else             side->u2[k] = {0.0, 0.0};
 7933:                   
 7934:             } // if ((it != iths) && (side->isDry && isWet))
 7935: 
 7936:          } // for k
 7937: 
 7938:       } // if isWet 
 7939:       
 7940: 
 7941: 
 7942:    }
 7943: 
 7944:    __global__ void ul0UpdateSides2(void) {
 7945:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7946:    
 7947:          SIDE(side);
 7948:    
 7949:          const Element *e1 = side->elems[0];
 7950:          const Element *e2 = side->elems[1];
 7951: 
 7952:          // A side is wet if and only if at least one of its elements is wet.
 7953:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7954: 
 7955:          // Update the side's dryness
 7956:          side->isDry = !isWet;
 7957: 
 7958:    }
 7959: 
 7960: 
 7961:    __global__ void zeroNodalVelocities(void) {
 7962:       NODE(node);
 7963: 
 7964:       for (int k = 0; k < nvrt; k++) {
 7965:          node->u2[k]   = {0.0, 0.0};
 7966:          node->w2[k]   = 0.0;
 7967:          node->utmp[k] = {0.0, 0.0};         
 7968:       }
 7969:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7970:    }
 7971:  
 7972: 
 7973:    __global__ void computeNodalVerticalVelocities1(void) {
 7974:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7975:    // Adds the element's vertical velocity times the element's area.
 7976:       ELEM(elem);
 7977: 
 7978:       for (int j = 0; j < elem->i34; j++) {
 7979:          Node *node = elem->nodes[j];
 7980: 
 7981:          for (int k = node->kb; k < nvrt; k++) {
 7982:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7983:          }
 7984:          atomicAdd(&(node->tmp.d), elem->area);
 7985:       }
 7986:    }
 7987: 
 7988:    __global__ void computeNodalVerticalVelocities2(void) {
 7989:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7990:    // Divides by the total area of the elements sharing the    node.
 7991:       NODE(node);
 7992: 
 7993: 
 7994:       const double invArea = 1.0 / node->tmp.d;
 7995:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7996: 
 7997:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7998:    }
 7999: 
 8000: 
 8001:    __global__ void computeNodalHorizontalVelocities1(void) {
 8002: 
 8003:       assert(indvel <= 0 && "computeNodalHorizontalVelocities1 only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 8004: 
 8005:       ELEM(elem);
 8006: 
 8007:       if (elem->isDry) return;
 8008: 
 8009:       const int kb = elem->kb;
 8010:       const bool isTri = elem->isTri();
 8011: 
 8012:       if constexpr(indvel <= 0) {
 8013:          // Assuming discontinous hvel.
 8014: 
 8015:          if (isTri) { // For triangles
 8016:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 8017:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 8018:             #pragma unroll
 8019:             for (int j = 0; j < 3; j++) {
 8020:                // For every node of the triangle...
 8021:                Node *node = elem->nodes[j];
 8022: 
 8023:                if (node->isDry) continue;
 8024: 
 8025:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 8026:                const Side *s2 = elem->sides[(j + 1) % 3];
 8027:                const Side *s3 = elem->sides[(j + 2) % 3];
 8028: 
 8029:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 8030: 
 8031:                atomicAdd(&(node->tmp.i), 1);
 8032: 
 8033:                for (int k = kb; k < nvrt; k++)  {
 8034:                   Vector2 s1u2 = s1->u2[k];
 8035:                   Vector2 s2u2 = s2->u2[k];
 8036:                   Vector2 s3u2 = s3->u2[k];
 8037: 
 8038:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 8039:                   if constexpr(ics == 2) {
 8040:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 8041:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 8042:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 8043:                   }
 8044: 
 8045:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 8046:                   u = clampVelocity(u);
 8047:                   atomicAdd(&(node->utmp[k].x), u.x);
 8048:                   atomicAdd(&(node->utmp[k].y), u.y);
 8049: 
 8050:                }
 8051: 
 8052:             }
 8053:          }
 8054:          else { // For quads
 8055: 
 8056: 
 8057:             // Compute the bilinear coordinates of the center of each diagonal.
 8058:             double xi, eta;
 8059:             double shp13[4], shp24[4];
 8060:             Point2 x0, x1, x2, x3;
 8061:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 8062:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 8063:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 8064: 
 8065:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 8066:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 8067: 
 8068: 
 8069: 
 8070: 
 8071:             for (int k = kb; k < nvrt; k++) {
 8072: 
 8073:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 8074:                Vector2 sideU[4];
 8075:                #pragma unroll
 8076:                for (int j = 0; j < 4; j++) {
 8077:                   Vector2 u = elem->sides[j]->u2[k];
 8078:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 8079:                   sideU[j] = u;
 8080:                }
 8081: 
 8082:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 8083:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 8084: 
 8085:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 8086:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 8087:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 8088:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 8089:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 8090:                #pragma unroll
 8091:                for (int j = 0; j < 4; j++) {
 8092:                   Node *node = elem->nodes[j];
 8093:                   if (node->isDry) continue;
 8094: 
 8095:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 8096:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 8097:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 8098:                }
 8099:             }
 8100: 
 8101:          }
 8102: 
 8103:       }
 8104:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 8105:       
 8106:    }
 8107: 
 8108: 
 8109:    __global__ void computeNodalHorizontalVelocities2(void) {
 8110:       NODE(node);
 8111: 
 8112:       const int nodeCount = node->tmp.i;
 8113: 
 8114:       if (nodeCount == 0) 
 8115:       {
 8116:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 8117:          return;
 8118:       }
 8119: 
 8120:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 8121:       
 8122:       const int kb = node->kb;
 8123: 
 8124:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 8125:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 8126:       
 8127:       
 8128:    }   
 8129: 
 8130:  
 8131: 
 8132:    __global__ void resetVelocityOpenBndNodes(void) {
 8133:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8134: 
 8135:       NODE_BND(nodebnd);
 8136: // printf("DDDDDDDDDD\n");  // XXXXXXX
 8137:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8138:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8139:       }
 8140: 
 8141:    }
 8142: 
 8143: 
 8144:    __global__ void setVelocityOpenBndNodes(void) {
 8145:    // For open boundary nodes sets their velocity to the imposed values.
 8146: 
 8147:       SIDE_BND(sidebnd);
 8148: 
 8149:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8150:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8151:          // to its segment to the average of the side velocity.
 8152: 
 8153:          for (int k = 0; k < nvrt; k++) {
 8154:             Node *n1 = sidebnd->side->n1;
 8155:             Node *n2 = sidebnd->side->n2;
 8156: 
 8157: 
 8158:             Vector2 &n1_u2 = n1->u2[k];
 8159:             Vector2 &n2_u2 = n2->u2[k];
 8160: 
 8161:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8162:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8163:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8164:             }
 8165:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8166:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8167:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8168:             }
 8169: 
 8170:          }
 8171: 
 8172:       }
 8173: 
 8174:    }
 8175: 
 8176: 
 8177:    __global__ void computeVerticalVelocity(void) {
 8178:       // Computes the vertical velocity at the (2D) element's centroid.
 8179:       // In this function we will be considering volumetric elements, with side faces and a 
 8180:       // bottom and a top face. We will call them SFs, BF and TF.
 8181:       // It computes the flux coming from BF and the SFs.
 8182:       // If the bed is moving, it takes that into account.
 8183:       // Since water is incompressible, the integral of the velocity times the normal vector
 8184:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8185:       // and the BF is equal to the flux going out from the TF.
 8186:       // TF = - BF - sum(SFs).
 8187:       // It then computes the horizontal velocity at the center of TF.
 8188:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8189:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8190:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8191: 
 8192:       ELEM(elem);
 8193: 
 8194:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8195: 
 8196:       if (elem->isDry) return;
 8197: 
 8198:       const int kb = elem->kb;
 8199:       const bool isTri = elem->isTri();
 8200: 
 8201:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8202: 
 8203:       // Compute the bottom velocity
 8204:       if constexpr(imm != 0) {
 8205:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8206:       }
 8207: 
 8208: 
 8209:       double bottomArea3D;
 8210:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8211: 
 8212:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8213: 
 8214:       double topArea3D;
 8215: 
 8216:       // Bottom face flux
 8217:       double bottomFlux = 0.0;
 8218:       Vector2 u2meanBottom = {0.0, 0.0};
 8219:       const Vector2 gradh = elem->grad2(&Node::depth);
 8220:       if constexpr(imm==2) {
 8221:          Vector3 ubed;
 8222: 
 8223:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8224:          // updateBDEF(ubed);
 8225:      
 8226:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8227: 
 8228:          // elem->w[kb] += ubed.z;
 8229:       }
 8230:       else {
 8231: 
 8232:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8233:   
 8234:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8235:          // in the direction of motion.
 8236:          const double bottomW = - dot(gradh, u2meanBottom);  
 8237:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8238: 
 8239:          // VElocity associated to the bed deformation
 8240:          double bedVelocity = 0.0;
 8241:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8242: 
 8243:          elem->w[kb] = bedVelocity + bottomW; 
 8244: 
 8245:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8246:          
 8247:       } // if imm
 8248: 
 8249:       // Compute w for kb+1 to nvrt-1
 8250:       for (int l = kb; l < nvrt - 1; l++) {
 8251: 
 8252:          // normal vector to the top face of the "volumetric" element (3D)
 8253:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8254: 
 8255:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8256:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8257: 
 8258:          // Compute the total flux at the sides
 8259:          double sideFlux = 0.0;
 8260: 
 8261:          for (int j = 0; j < elem->i34; j++) {
 8262:             const Side *side = elem->sides[j];
 8263:             const int kbs = side->kb;
 8264:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8265:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8266:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8267: 
 8268:             // The area is "clamped" meaning that it takes kb into account.
 8269:             const double sideArea = side->areaClamped(l + 1);
 8270: 
 8271:             const double sign = elem->ssign[j]; 
 8272: 
 8273:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8274:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8275:          }
 8276:          
 8277:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8278:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8279:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8280: 
 8281:          // The flux at the top ace can be computed from the other flows.
 8282:          // All fluxes are in directions into the prism.
 8283:          const double topFlux = - sideFlux - bottomFlux;
 8284: 
 8285:          // Flux at the top face due to the horizontal velocities only
 8286:          // topFlux = topHorizontalFlux + topVerticalFlux
 8287:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8288: 
 8289:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8290:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8291: 
 8292:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8293: 
 8294:          bottomFlux = -topFlux;
 8295:          
 8296:       }
 8297: 
 8298:    }  
 8299: 
 8300: 
 8301: 
 8302: 
 8303: 
 8304: 
 8305: 
 8306: // !===============================================================================
 8307: // !===============================================================================
 8308: 
 8309: } // extern "C"
 8310: 
 8311: #ifdef DONTCOMPILE
 8312: __device__ void computeVerticalAdvection(void) {
 8313:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8314: 
 8315:    sdbt(1:2,:,:)=0.d0
 8316: 
 8317:    const Side *side = FROM kernel;
 8318: 
 8319:    if(side->isDry) return;
 8320: 
 8321:    // If side is wet...
 8322: 
 8323: 
 8324:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8325:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8326:    double ws[nvrt] = {} // w @ side
 8327:    int icount = 0;
 8328:    for (int j=0; j<2; j++) {
 8329:       const Element *elem = side->elements[j];
 8330:        
 8331:       if(elem != nullptr) {
 8332:          icount++;
 8333:          for (int k=0; k<nvrt; k++) {
 8334:             ws[k] = ws[k] + elem->w[k];
 8335:          }
 8336:       }
 8337:    }  // for j
 8338: 
 8339:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8340:    ws = ws/icount;
 8341: 
 8342:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8343:    // Splines allow for a smooth transition between vertical levels.
 8344:    // Splines have continuity restrictions at the internal knots, but
 8345:    // we have to provide the 1st derivatives at the endpoints.
 8346:    const int kbs = side->kbs; 
 8347:    
 8348:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8349:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8350:    initCubicSpline(kbs, nvrt, side, ws, up)
 8351: 
 8352:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8353:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8354:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8355: 
 8356:    // Total advection (average onto side)
 8357:    const Node *node1 = side->nodes[0];
 8358:    const Node *node2 = side->nodes[1];
 8359:    for (int k=kbs(i); k<nvrt; k++) {
 8360: 
 8361:       Vector2 bcc1 = node1->bcc[k];
 8362:       Vector2 bcc2 = node2->bcc[k];
 8363:       if constexpr(ics == 2) {
 8364:          // Project the velocities from the node frames to the side frame
 8365:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8366:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8367:       }
 8368: 
 8369:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8370:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8371: 
 8372:    }
 8373: }
 8374: #endif
 8375: 
 8376: 
 8377: extern "C" {
 8378:    __global__ void computeElemAverageGhat(void) {
 8379:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8380: 
 8381:       ELEM(elem);
 8382:       
 8383:       elem->ghat1= {0.0, 0.0};  
 8384: 
 8385:       if constexpr(ihydraulics != 0) {
 8386:          if (nhtblocks > 0 && elem->isblock) return;
 8387:       }
 8388: 
 8389:       
 8390:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8391:       // cff1-3: coefficients for 2D/3D
 8392: 
 8393:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8394:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8395:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8396: 
 8397:       if (elem->isDry) return;
 8398: 
 8399:       // Average of the coefficients
 8400:       double av_cff1 = 0.0;  // av. for cff1
 8401:       double av_cff2 = 0.0;  // av. for cff2
 8402:       double av_cff3 = 0.0;  // av. for cff3
 8403:       double av_df = 0.0;  // av. for H^\alpha / H
 8404:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8405:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8406: 
 8407:       const int i34 = elem->i34;
 8408:       const int kb  = elem->kb;
 8409: 
 8410:       for (int j=0; j<i34; j++) {
 8411:          // For each node and side in the element...
 8412: 
 8413:          const Node *node = elem->nodes[j];
 8414:          const Side *side = elem->sides[j];
 8415: 
 8416:          const double chi      = side->chi;
 8417:          const double veg_c2   = side->veg_c2;
 8418:          const double veg_beta = side->veg_beta;
 8419:          const double veg_h    = side->veg_h();
 8420:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8421: 
 8422:          const Vector2 gradPhi = elem->gradPhi[j];
 8423: 
 8424:          // Node - const in elem
 8425:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8426:          elem->gradPr  += node->pr  *gradPhi;
 8427: 
 8428:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8429: 
 8430:         
 8431:          const double htot  = side->htot2();        // Total depth at the side
 8432:          const double zctr2 = side->zTopCanopy();  
 8433: 
 8434:          double cff1; 
 8435:          double cff2; 
 8436:          double cff3;   
 8437:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8438:          // coefficients applied to 2D/3D case 
 8439:             cff1 = side->hhat/htot;
 8440:             cff2 = 0.0;
 8441:             cff3 = 0.0;
 8442:          } else { //3D
 8443:             //Init for no-veg case
 8444:             cff1 = 1.0;
 8445:             cff2 = 1.0;
 8446:             cff3 = 0.0;
 8447: 
 8448:             if constexpr(iveg != 0) {
 8449:                // Computes coefficients used with vegetation terms G1, G2
 8450:                // cff1, cff3 are used for the first two terms in G1, G2:
 8451:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8452:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8453:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8454:                if(veg_h < 0.99*htot) { // submergent vegetation
 8455:                   cff1 = 1.0;
 8456:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8457:                   cff3 = veg_c;
 8458: 
 8459:                } else { // emergent vegetation
 8460:                   cff1 = 1.0/(1.0 + veg_c2);
 8461:                   cff2 = cff1;
 8462:                   cff3 = 0.0;
 8463: 
 8464:                }
 8465:             } // if iveg
 8466:          } //  2D/3D
 8467: 
 8468:          av_cff1 += cff1/i34;
 8469:          av_cff2 += cff2/i34;
 8470:          av_cff3 += cff3/i34;
 8471:          av_cff2_chi += cff2*chi/i34;
 8472:          av_cff3_chi += cff3*chi/i34;
 8473:          av_df += min(htot, veg_h)/(htot*i34);
 8474: 
 8475: 
 8476:          // btrack values: U^\star, U^{\star\alpha}
 8477:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8478:          Vector2 Ustar       = {0.0, 0.0}; 
 8479:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8480: 
 8481:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8482:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8483:          } else { //3D
 8484:             for (int k = side->kb + 1; k < nvrt; k++) {
 8485:             
 8486:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8487:                Ustar += w2;
 8488: 
 8489:                if constexpr(iveg != 0) {
 8490:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8491:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8492:                        Ustar_alpha += zrat*w2; // XXXX
 8493:                    }
 8494:                }  // if iveg
 8495:             }  // for k
 8496:          }  //2D/3D
 8497: 
 8498:          // If needed, project the side velocities to the element frame
 8499:          if constexpr(ics==2) {
 8500:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8501:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8502:          }
 8503:         
 8504: 
 8505:          // Add btrack & surface stress terms to \breve{G} first
 8506:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8507: 
 8508: 
 8509:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8510:          Vector2 tau    = side->tau();  
 8511:          Vector2 ubstar = side->btu[side->kb + 1];  
 8512: 
 8513:          // If needed, project tau and ubstar to the element frame
 8514:          if constexpr(ics==2) {
 8515:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8516:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8517:          }
 8518: 
 8519:          // Term for surface and bottom stress
 8520:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8521: 
 8522: 
 8523:          // All terms in F,F^\alpha,f_b except baroclinic
 8524:          // F, f_b: all explicit terms excluding vegetation 
 8525:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8526:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8527:          const double coriolis = side->coriolis;
 8528:          Vector2 F  =  coriolis*side->U;  // F_x
 8529:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8530:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8531: 
 8532:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8533:             
 8534:             for (int k = side->kb; k < nvrt; k++) {
 8535:                if (zctr2 > side->zc[k-1]) {
 8536:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8537:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8538:                    Fa +=  coriolis*w2*zrat;
 8539:                } // if zctr2
 8540:             } // k
 8541:          } // iveg
 8542: 
 8543:          // Integrate horizontal viscosity force vertically
 8544:          for (int k=side->kb + 1; k<nvrt; k++) {
 8545:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8546: 
 8547:             F += levelHorVisc;
 8548: 
 8549:             // Vegetation term
 8550:             if constexpr(iveg!=0) {
 8551:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8552:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8553:                   Fa += levelHorVisc*zrat;
 8554:                } 
 8555:             } // if iveg
 8556:          } // for k
 8557: 
 8558:          // Get nu*grad(U) at the side's bottom level
 8559:          Vector2 nuGradU = side->nuGradU[side->kb];
 8560: 
 8561:          fb += nuGradU;
 8562: 
 8563:          // If needed, project vectorsF, fb and Fa to the element frame
 8564:          if constexpr(ics==2) {
 8565:             F    = side->frame.projHorVec(F,    elem->frame);
 8566:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8567:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8568:          } // if ics
 8569: 
 8570:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8571:       } // for j (nodes and sides)
 8572: 
 8573:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8574: 
 8575: 
 8576:       // Finish off terms in F, F^\alpha and f_b
 8577:       const double grav3 = elem->mean(&Node::grav2);
 8578:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8579:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8580:       for (int j=0; j<i34; j++) { 
 8581:          // For each side in the element...
 8582:          const Side *side = elem->sides[j];
 8583:          const double chi = side->chi;
 8584: 
 8585:          const double htot = side->htot2();
 8586:          const double veg_h = side->veg_h();
 8587:          const Vector2 F  = htot*fb;
 8588:          const Vector2 Fa = min(htot, veg_h)*fb;
 8589: 
 8590:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8591:       } // for j
 8592: 
 8593:       // tmp is already in elem frame
 8594:       elem->ghat1 += tmp/i34;
 8595: 
 8596:       // Baroclinic force
 8597:       if constexpr(ibc==0) {
 8598:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8599: 
 8600:          Vector2 Fa = {0.0, 0.0};
 8601:          Vector2 intGradRho = {0.0, 0.0};
 8602:          
 8603:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8604:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8605:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8606: 
 8607:             // \in F [m^2/s/s]
 8608:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8609:          }
 8610: 
 8611:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8612:          const Vector2 F = av_df*Fa; //approx
 8613:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8614: 
 8615:       } // if ibc 
 8616: 
 8617: 
 8618: 
 8619:    } 
 8620: 
 8621: 
 8622: 
 8623: 
 8624: 
 8625: // ------------------------------------------------------------
 8626: // Transport
 8627: // ------------------------------------------------------------
 8628: 
 8629: __device__ bool TransportElem<TransportModel::Upwind>::use1stOrderUpwind(const Element *elem) const {
 8630:    if (itvd) {
 8631:       // Marked as such in tvd.prop: always 1st order upwind for this element
 8632:       return true;
 8633:    }
 8634: 
 8635:    // If any node of the element is shallow, use 1st order upwind
 8636:    for (int j = 0; j < elem->i34; j++) {
 8637:       if (elem->nodes[j]->htot2() < h_tvd) return true;
 8638:    }
 8639:    return false;
 8640: }
 8641: 
 8642: __device__ void TransportElem<TransportModel::Upwind>::savePrevTraces(const Element *elem) {
 8643:    for (int k = 0; k < nvrt; k++) prevTraces[k] = elem->tracers[k];
 8644: }
 8645: 
 8646: __device__ double TransportElem<TransportModel::Upwind>::maxPrismDt(const Element *elem, int k) const {
 8647:    if (inflow[k] == 0.0) return huge_double;
 8648:    return elem->volume(k - 1) / inflow[k] * (1.0 - 1.0e-6);
 8649: }
 8650: 
 8651: __global__ void computeHorizAdvecFluxes(void) {
 8652: 
 8653: 
 8654:    SIDE(side)
 8655: 
 8656:    auto &transport = side->transport;
 8657: 
 8658:    for (int k = 0; k < nvrt; k++) transport.Qh[k] = -1.0e34; // Sentinel value for dry sides.
 8659: 
 8660:    if (side->isDry) return;
 8661: 
 8662:    const bool isLand = (side->sideBnd!=nullptr && side->sideBnd->segment != nullptr && side->sideBnd->segment->isLand);
 8663:    const int kb = side->kb;
 8664: 
 8665:    for (int k = kb + 1; k < nvrt; k++) {
 8666:       if (isLand) {
 8667:          transport.Qh[k] = 0.0;
 8668: 
 8669:       } else {
 8670:          const Vector2 n = side->n; // normal vector to the side
 8671:          const double area = side->area(k); // Area of the side face.
 8672:          const double vnor1 = dot(n, side->u2[k]);
 8673:          const double vnor2 = dot(n, side->u2[k-1]);
 8674:          const double vnor_c = 0.5*(vnor1 + vnor2); // Normal velocity at the face center.
 8675: 
 8676:          transport.Qh[k] = area*vnor_c; 
 8677:       }
 8678: 
 8679:    }
 8680: 
 8681: }
 8682: 
 8683: __global__ void horizontalAdvection(void) {
 8684: 
 8685:    // Horizontal advection kernel.
 8686:    // -------------------------------
 8687: 
 8688:    // In this model, equations are written in such a way that concentration at time t+1 are computed from
 8689:    // *differences* of concentrations at the cell underconsideration and concentrations upwind of it. 
 8690:    // (how upwind is determined depends on the scheme)
 8691:    // 
 8692:    // For the 1st order upwind scheme, "upwind concentration" at outflow faces is the concentration at the cell itself.
 8693:    // So only inflow faces contribute to the concentration change at the cell.
 8694: 
 8695:    // In the implementation, we do 1st order independently and then consider TVD as an additional update term computed as 
 8696:    // as a sum over all faces (inflow and outflow).
 8697: 
 8698: 
 8699:    // Compute total inflow and maximum allowed sub-time step
 8700:    ELEM(elem)
 8701: 
 8702:    const int kb = elem->kb;
 8703:    const int i34 = elem->i34;
 8704:    auto &transport = elem->transport;
 8705: 
 8706:    if (elem->isDry) return;
 8707: 
 8708:    elem->transport.maxDt = huge_double;
 8709: 
 8710:    for (int k = 0; k < kb + 1; k++) elem->transport.inflow[k] = 0.0;
 8711: 
 8712:    for (int k = kb + 1; k < nvrt; k++) { // For each wet prism in the element...
 8713: 
 8714:       transport.inflow[k] = 0.0;
 8715: 
 8716:       for (int j = 0; j < i34; j++) { // For each side in the element...
 8717:          const Side *side = elem->sides[j];
 8718:          const auto &sideTransport = side->transport;
 8719:          const double ssign = elem->ssign[j];
 8720:          const int kbs = side->kb;
 8721: 
 8722:          if (k <= kbs) continue;
 8723: 
 8724:          // Get the element at the other end of side j.
 8725:          const Element *neighElem = side->otherElem(elem);
 8726:          if (neighElem == nullptr || neighElem->isDry) continue;
 8727: 
 8728:          const double faceQ = sideTransport.Qh[k];
 8729:          const bool inFlux = (ssign*faceQ) < 0.0; // true if the flux points into the element
 8730: 
 8731:          const BoundarySegment *boundarySegment = (side->sideBnd == nullptr) ? nullptr : side->sideBnd->segment;
 8732:          const bool isLand = (boundarySegment != nullptr && boundarySegment->isLand);
 8733: 
 8734:          // Count this side's flux only when water flows into the element, and the water is coming from somewhere 
 8735:          // real: either a wet neighboring element, or an open boundary.         
 8736:          if (isLand || !inFlux) continue;
 8737: 
 8738:          for (int itr = 0; itr < ntracers; itr++) {
 8739:             transport.inflow[k] += fabs(faceQ);  // Sum of all inflow fluxes at level k.
 8740:          }
 8741: 
 8742:       }
 8743:       
 8744:       // computes the minimum allowed sub-time step for the prism
 8745:       elem->transport.maxDt = min(elem->transport.maxDt, elem->transport.maxPrismDt(elem, k));
 8746:    }
 8747: 
 8748: }
 8749: 
 8750: __device__ __forceinline__ void atomicMinDouble(double *addr, double val) {
 8751:    unsigned long long *p = (unsigned long long *)addr;
 8752:    unsigned long long old = *p, assumed;
 8753:    do {
 8754:       assumed = old;
 8755:       old = atomicCAS(p, assumed,
 8756:          __double_as_longlong(fmin(val, __longlong_as_double(assumed))));
 8757:    } while (assumed != old);
 8758: }
 8759: 
 8760: __device__ __forceinline__ double blockMin(double v) {
 8761:    __shared__ double sh[32];
 8762:    const int lane = threadIdx.x & 31;
 8763:    const int warp = threadIdx.x >> 5;
 8764:    for (int o = 16; o > 0; o >>= 1)
 8765:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 8766:    if (lane == 0) sh[warp] = v;
 8767:    __syncthreads();
 8768:    if (warp == 0) {
 8769:       const int nw = blockDim.x >> 5;
 8770:       v = (lane < nw) ? sh[lane] : huge_double;
 8771:       for (int o = 16; o > 0; o >>= 1)
 8772:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 8773:    }
 8774:    return v;  // only lane 0 of warp 0 is the block min
 8775: }
 8776: 
 8777: extern "C" __global__ void minTransportDt(double *out) {
 8778:    const int idx = threadIdx.x + blockIdx.x * blockDim.x;
 8779:    double v = huge_double;
 8780:    if (idx < mesh->ne) {
 8781:       Element *elem = &mesh->localElemData[idx];
 8782:       if (!elem->isDry) v = elem->transport.maxDt;
 8783:    }
 8784:    __shared__ double sh[32];
 8785:    const int lane = threadIdx.x & 31;
 8786:    const int warp = threadIdx.x >> 5;
 8787:    for (int o = 16; o > 0; o >>= 1)
 8788:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 8789:    if (lane == 0) sh[warp] = v;
 8790:    __syncthreads();
 8791:    if (warp == 0) {
 8792:       const int nw = (blockDim.x + 31) >> 5;
 8793:       v = (lane < nw) ? sh[lane] : huge_double;
 8794:       for (int o = 16; o > 0; o >>= 1)
 8795:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 8796:       if (lane == 0) atomicMinDouble(out, v);
 8797:    }
 8798: }
