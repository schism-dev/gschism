 1696: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1697:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1698: }
 1699: 
 1700: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1701:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1702: }   
 1703: 
 1704: __device__ __inline__ double min3(double a, double b, double c) {
 1705:    return min(a, min(b, c));
 1706: }
 1707: 
 1708: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1709:    return min(a, min(b, min(c, d)));
 1710: }
