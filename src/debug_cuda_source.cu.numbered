 3826:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3827: 
 3828:       SIDE(side);
 3829: 
 3830: 
 3831:       side->U = {0.0, 0.0}; 
 3832:          
 3833:       if(side->isDry) return;
 3834: 
 3835:       const Node *node1 = side->n1;
 3836:       const Node *node2 = side->n2;
 3837: 
 3838:       // Vertically integrated velocity U (in ll if ics=2)
 3839:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3840:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3841:       }
 3842: 
 3843:    }
 3844: 
 3845:    __global__ void computeBottomDragVegetation(void) {
 3846:       // UNFINISHED. CHECK THIS:
 3847:       // How many kernels are needed? Why so many for loops?
 3848:       // Is the loop on sides needed?
 3849: 
 3850:       NODE(node);
 3851: 
 3852:       const int    kb      = node->kb;
 3853:       const double htot    = node->htot2();
 3854:       const double rough   = node->rough;
 3855: 
 3856: 
 3857:       if (node->isDry) {
 3858:          // Default values for dry nodes
 3859:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3860:          /// XXX CHECK INDICES
 3861:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3862:       }
 3863: 
 3864:       // Compute bottom drag Cd
 3865:       //--------------------------------
 3866: 
 3867:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3868:       if (nchi==1) {
 3869: 
 3870:          bool ltmp = false; // for WBL iteration
 3871: 
 3872:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3873:          // Drag at nodes
 3874:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3875:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3876:         
 3877:          const double rough = node->rough;
 3878:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3879:          if (node->rough == 0.0) {
 3880:             node->Cd = 0.0;
 3881: 
 3882:          } else { //roughness >0 
 3883:             
 3884:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 3885:             const double bthick = max(dzb_min, bthick_ori);
 3886: 
 3887:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3888: 
 3889:             double tmp = 1.0/(2.5*log(bthick/rough));
 3890:             node->Cd = tmp*tmp;
 3891: 
 3892:          } // if rough
 3893: 
 3894: 
 3895:          // RECOVER THIS: XXX
 3896:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3897:          // Output warning for WBL if iteration didn't converge
 3898: 
 3899: 
 3900:       } // nchi==1
 3901: 
 3902:       //   Bottom stress in m^2/s^2
 3903:       if (node->rho[kb + 1] >= -98.0)
 3904:       {
 3905:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3906:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3907:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3908:          // !sediment erosion: this part needs more documentation
 3909:       }
 3910: 
 3911:     
 3912:       // Compute vegetation parameters
 3913:       //--------------------------------
 3914: 
 3915:       // SAV constants
 3916:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3917:       constexpr double veg_cfpsi = 0.16;
 3918: 
 3919:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3920:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3921: 
 3922:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3923:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3924:          int kbin = 0; // bin index
 3925:          for (int k = kb; k < nvrt; k++) {
 3926:             // Computes node height above the bottom level
 3927:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 3928:             assert(false && "Vertical variation of vegetation not implemented");
 3929: 
 3930:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3931:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3932:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3933:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3934:             // } else {
 3935:             //    // Find the bin at which the current vertical level is
 3936:             //    while (kbin<nbins_veg_vert) {
 3937:             //       const double zn = node->z[kbin];
 3938:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3939:             //          break;
 3940:             //       } // if
 3941:             //       kbin++;
 3942:             //    } // while
 3943:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3944: 
 3945:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3946:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3947:                
 3948:             //    // Linear interpolation of the vegetation parameters
 3949:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3950:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3951:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3952:             // } // if rl10
 3953: 
 3954:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3955: 
 3956:          } // for k
 3957: 
 3958: 
 3959:       } else { // Ganthy (iveg=2)
 3960:       //  Modify canopy height, diameter, and density
 3961: 
 3962:          // Make sure there is vegetation on this node
 3963:          if (node->veg_h_unbent > 0.0) {
 3964:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3965: 
 3966:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3967:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3968:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3969: 
 3970:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3971:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3972:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3973:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3974:          } // if veg_h_unbent
 3975: 
 3976:          for (int k = 0; k < nvrt; k++) {
 3977:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3978:          } // for k
 3979:       
 3980: 
 3981:       } // if iveg
 3982:      
 3983:          
 3984: 
 3985:       // Compute vertical mean of veg_alpha3D
 3986:       if (iveg != 0) {
 3987:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3988:          double sum1=0.0;
 3989:          double sum2=0.0;
 3990:          // Integrate over each level under the canopy...
 3991:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3992:             const double Dz = node->Dz(k);
 3993: 
 3994:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3995:             sum2 += Dz;
 3996: 
 3997:          } // for k
 3998: 
 3999:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4000:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4001: 
 4002:       } // if iveg
 4003: 
 4004:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4005: 
 4006:    }
 4007: 
 4008:    __global__ void computeVegetationAndDragParameters(void) {
 4009:       // Computes the vegetation and drag model parameters:
 4010:       // chi, \tilde\chi, beta, \breve{H}
 4011:       
 4012:       SIDE(side);
 4013: 
 4014:       const double htot = side->htot2();
 4015:       const int    kb   = side->kb;
 4016: 
 4017:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4018: 
 4019:       const double veg_h     = side->veg_h();
 4020:       const double veg_nv    = side->veg_nv();
 4021:       const double veg_c     = side->veg_c();
 4022:       const double veg_beta  = side->veg_beta;
 4023:       const double veg_alpha = side->veg_alpha_vert_mean();
 4024: 
 4025:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4026:       // Velocity magnitude at the bottom level
 4027:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4028:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4029:       side->chi2 = side->Cd()*vmag1;
 4030:       side->chi  = side->chi2;
 4031:       if constexpr(iveg != 0) {
 4032:          const Node *n1 = side->n1;
 4033:          const Node *n2 = side->n2;
 4034:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4035:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4036:       }
 4037: 
 4038:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4039: 
 4040:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4041:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4042:       double magUa = 0.0;
 4043:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4044:          // 3D wet side with veg...
 4045: 
 4046:          double magUa = 0.0;
 4047:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4048:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4049: 
 4050:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4051:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4052:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4053: 
 4054:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4055:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4056: 
 4057:                // Velocity magnitude at the bottom (l) of the level
 4058:                const double ul = length(side->u2[k]);
 4059: 
 4060:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4061:                magUa += Dz*0.5*(uh + ul);
 4062: 
 4063:             } // if HasVegetation
 4064:          } // for k
 4065:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4066: 
 4067:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4068:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4069:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4070:             const double zCpy = side->zTopCanopy();
 4071:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4072:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4073:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4074:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4075:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4076:          } // if isSubmerged
 4077:       } // if iveg   
 4078: 
 4079:       // Computes the friction modified depth, \breve{H} in notes
 4080:       if (side->is2D()) { // 2D
 4081: 
 4082:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4083:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4084: 
 4085:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4086: 
 4087:          side->hhat = htot*htot/fricH; 
 4088: 
 4089:       } else { // 3D
 4090:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4091: 
 4092:          if constexpr(iveg != 0) {
 4093:             
 4094:             if (side->isSubmerged()) { 
 4095:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4096:                side->hhat -= veg_c*Hhat_alpha;
 4097: 
 4098:             } else { // Emergent
 4099:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4100:             }
 4101:          } // if iveg
 4102: 
 4103:          // Enforce positivity for 3D model
 4104:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4105:       } // if 3D
 4106: 
 4107:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4108: 
 4109:         
 4110:    }
 4111: 
 4112: 
 4113: 
 4114:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4115:    // Computes the density gradient between two elements, e1 and e2.
 4116:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4117:    // zero in the direction normal to the side. 
 4118:    // 
 4119:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4120:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4121:    //
 4122:    // Input:
 4123:    //    e1: Element
 4124:    //    e2: Neighbor element (or nullptr if boundary)
 4125:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4126:    //    k: Index of the half-level at which the density is interpolated
 4127:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4128:    // 
 4129:    // Output:
 4130:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4131:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4132: 
 4133:       if (e2 == nullptr || e2->isDry) {
 4134:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4135: 
 4136:          Side *side = e1->sides[j];
 4137:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4138:                  
 4139:          if constexpr(ics == 1) {
 4140:             vec = side->n; // Normal vector to the side
 4141:          } else {
 4142:             // IMPLEMENT THIS XXXXXX
 4143:             // !replace with xel, yel?
 4144:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4145:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4146:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4147:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4148:          } //ics
 4149:                    
 4150:          diffRho = 0.0;
 4151: 
 4152:       } else { //internal and wet
 4153:          if constexpr(ics==1) {
 4154:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4155: 
 4156:             // Vector from e1 to e2
 4157:             vec = toVector2(e2->center - e1->center);
 4158: 
 4159:          } else { 
 4160:             // IMPLEMENT THIS XXXXXX
 4161:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4162:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4163:             //                   alow(j)=xctr2
 4164:             //                   bdia(j)=yctr2
 4165:          } // ics
 4166: 
 4167:          diffRho = rho2 - e1->demeanedDensity(k);
 4168:       }
 4169: 
 4170:    }
 4171: 
 4172:    __global__ void computeDensityCubicSplines(void) {
 4173:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4174: 
 4175:       ELEM(elem);
 4176: 
 4177:       if (elem->isDry) return;
 4178: 
 4179:       const int kb = elem->kb;
 4180: 
 4181:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4182:       if (elem->is2D()) {
 4183:          // In the 2D case, the density is constant at the prism level. 
 4184:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4185:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4186:       } else { //3D
 4187: 
 4188:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4189:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4190:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4191:          ///// XXXX CHECK INDICES!!!!!
 4192:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4193:       } // 2D/3D
 4194: 
 4195:    }
 4196: } // extern "C"
 4197: 
 4198: 
 4199: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4200: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4201: 
 4202:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4203: 
 4204:    const int kb  = elem->kb;
 4205:    const int kb2 = elem2->kb;
 4206: 
 4207:    // z-coordinate of prism of elem
 4208:    const double zp = elem->z_prism(k);
 4209: 
 4210:    double rho = 0.0;
 4211: 
 4212:    if (elem2->is2D()) {
 4213:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4214: 
 4215:    } else {  // 3D
 4216: 
 4217:       // eta_min may be < zmax
 4218:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4219:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4220: 
 4221:       // (Extrapolate density below bottom, we will fix it later)
 4222:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4223:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4224:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4225:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4226:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4227:    } // 2D/3D
 4228:      
 4229: 
 4230:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4231:    // Now we need to fix it.
 4232:    if (elem->z[k] < elem2->z[kb2]) {
 4233:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4234: 
 4235:       // There are two methods to adjust the density at the bottom of the element.
 4236:       // iunder_deep=0: 
 4237:       const double depth1 = abs(elem->z[kb]); // larger depth
 4238: 
 4239:       if (iunder_deep==0) {
 4240: 
 4241:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4242: 
 4243:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4244: 
 4245:       } else { // iunder_deep != 0
 4246: 
 4247:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4248: 
 4249:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4250: 
 4251:          //   Demeaned density at the same z coordinate as
 4252:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4253:          }
 4254: 
 4255:       } // if iunder_deep
 4256:    } // if elem->z[kb] < elem2->z[kb]
 4257: 
 4258:    return rho;
 4259: }
 4260: 
 4261: 
 4262: extern "C" {
 4263:    __global__ void computeDensityGradient(void) {
 4264: 
 4265:          // Compute the horizontal density gradient at each element.
 4266:       // It works in two steps:
 4267:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4268:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4269:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4270:       //             gradRho.r1 = rho1 - rho0
 4271:       //             gradRho.r2 = rho2 - rho0
 4272:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4273:       // 
 4274:       //  NOTE: We use de-meaned densities.
 4275: 
 4276:       ELEM(elem);
 4277: 
 4278:       if (elem->isDry) return;
 4279: 
 4280:       const int kb  = elem->kb;
 4281:       const int i34 = elem->i34;
 4282: 
 4283:       for (int k = kb + 1; k < nvrt; k++) {
 4284:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4285:          //             gradRho.r1 = rho1 - rho0
 4286:          //             gradRho.r2 = rho2 - rho0
 4287:          int icount = 0;
 4288:          double sumRx = 0.0;
 4289:          double sumRy = 0.0;
 4290:          for (int j1=0; j1<i34; j1++) { 
 4291: 
 4292:             const int j2 = elem->nxq(j1 + 1);
 4293: 
 4294:             // Pairs of consecutive neighbor elements of elem
 4295:             const Element *e1 = elem->nghbElems[j1];
 4296:             const Element *e2 = elem->nghbElems[j2];
 4297: 
 4298:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4299:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4300:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4301: 
 4302:             // Compute the density difference and the vector from elem to e1 and e2
 4303:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4304:             double diffRho1, diffRho2;
 4305:             Vector2 vec1, vec2;
 4306:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4307:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4308: 
 4309:             const double rl1 = length(vec1);
 4310:             const double rl2 = length(vec2);
 4311:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4312: 
 4313:             const double delta = cross(vec1, vec2);
 4314:             const double sintheta = abs(delta)/(rl1*rl2);
 4315: 
 4316:             // To avoid problems, avoid elements with small angle between vectors
 4317:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4318:             const bool validEq = (sintheta > sin_one_deg);
 4319: 
 4320:             if (validEq) {
 4321:                // Solve the system of equations to get the density gradient at elem
 4322:                icount++;
 4323:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4324:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4325:                sumRx += Rx;
 4326:                sumRy += Ry;
 4327:             }
 4328:          } // for j1
 4329: 
 4330:          // Compute the average density gradient at elem
 4331:          if (icount==0) {
 4332:            // Bad mesh quality; bail out with 0 b-cc
 4333:            elem->gradRho[k] = {0.0, 0.0};
 4334:          } else {
 4335:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4336:          }
 4337: 
 4338:       } // for k
 4339: 
 4340:    }
 4341: 
 4342:    __global__ void computeBaroclinicTerm(void) {
 4343:    // Computes the baroclinic term at sides (at half levels).
 4344:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4345:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4346: 
 4347:       SIDE(side);
 4348: 
 4349:       if (side->isDry) return;
 4350: 
 4351:       const Element *e1 = side->elems[0];
 4352:       const Element *e2 = side->elems[1];      
 4353:       const int kb = side->kb;
 4354:       
 4355:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4356: 
 4357:       // interpolates vertically the density gradient of the two elements at the half level/
 4358: 
 4359:       // Starts the integration at the surface and goes down to the bottom
 4360:       int k1 = nvrt - 1;
 4361:       int k2 = nvrt - 1;
 4362: 
 4363:       side->bcc[nvrt-1] = {0.0, 0.0};
 4364:       for (int k = nvrt-1; k >= kb; k--) {
 4365:       // For each prism level (from surface to bottom)...
 4366: 
 4367:          // For both elements, interpolate density gradient at the side's half level.
 4368:          // The gradient at the side is the average of the gradients at the elements.
 4369:          // w1, w2 are used to take into account boundary sides, with just one element.
 4370:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4371:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4372:          const double wsum = w1 + w2;
 4373:          w1 = w1/wsum;
 4374:          w2 = w2/wsum;
 4375:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4376: 
 4377:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4378:          Vector2 gradRho = {0.0, 0.0};
 4379:          if (e1 != nullptr && k > kb) {
 4380:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4381:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4382:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4383:             
 4384:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4385:          }      
 4386:          if (e2 != nullptr && k > kb) {
 4387:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4388:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4389:             
 4390:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4391:          }
 4392: 
 4393:          if constexpr(ics==2) {
 4394:             // IMPLEMENT THIS XXXXXX
 4395:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4396:             // swild(1)=tmp1
 4397:             // swild(2)=tmp2
 4398:          }
 4399:          
 4400:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4401:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4402:          // CHECK INDICES!!! XXX
 4403:          const double grav3 = side->grav3();
 4404:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4405:       } // for
 4406: 
 4407:    }
 4408: 
 4409: 
 4410: 
 4411:    __global__ void computeHorGradientAtSide(void) {
 4412: 
 4413:       // Compute the horizontal density gradient at each element.
 4414:       // It works in two steps:
 4415:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4416:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4417:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4418:       //             gradRho.r1 = rho1 - rho0
 4419:       //             gradRho.r2 = rho2 - rho0
 4420:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4421:       // 
 4422:       //  NOTE: We use de-meaned densities.
 4423: 
 4424:       SIDE(side);
 4425: 
 4426:       if (side->isDry) return;
 4427: 
 4428:       // Computes the gradient of the variables at the side center.
 4429:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4430:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4431:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4432: 
 4433:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4434:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4435:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4436:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4437: 
 4438: 
 4439:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4440:          side->gradEta1.x, side->gradEta1.y, 
 4441:          side->gradEta2.x, side->gradEta2.y, 
 4442:          side->gradETP.x, side->gradETP.y, 
 4443:          side->gradPr.x, side->gradPr.y);
 4444: 
 4445: 
 4446:    }
 4447: 
 4448: 
 4449:    __global__ void solveMomentumEquations(double time) {
 4450: 
 4451:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4452:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4453: 
 4454:       SIDE(side);
 4455: 
 4456:       if (side->isDry) 
 4457:       {
 4458:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4459: 
 4460:          return;
 4461:       }
 4462: 
 4463:       const Node *n1 = side->n1;
 4464:       const Node *n2 = side->n2;
 4465: 
 4466:       const int kb = side->kb;
 4467: 
 4468:       const double veg_h = side->veg_h();
 4469:       const double grav3 = side->grav3();
 4470: 
 4471: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4472:       if (side->is2D()) {
 4473:          // Warning: Do not use htot2, which is updated.
 4474:          const double htot = side->htot1();
 4475:          const double hhat = side->hhat;
 4476: 
 4477:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4478: 
 4479:          Vector2 tau2 = {0.0, 0.0};
 4480:           
 4481:          if constexpr(ics==1) {
 4482:             tau2 = side->tau();
 4483: 
 4484:          } else {
 4485:             assert(false && "Not implemented: ics == 2");
 4486:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4487:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4488:             // taux2=(vn1+tt1)*0.5d0
 4489:             // tauy2=(vn2+ss1)*0.5d0
 4490:          } // if ics         
 4491: 
 4492:          // hat_gam has units of m/s
 4493: 
 4494:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4495: 
 4496:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4497:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4498: 
 4499:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4500: 
 4501:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4502:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4503: 
 4504:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4505: 
 4506: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y);
 4507: 
 4508:       }
 4509:       else { // 3D
 4510: 
 4511:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4512:          // 
 4513:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4514:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4515:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4516:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4517:          // k+1 and k.
 4518: 
 4519: 
 4520:          // // Define layer thickness & viscosity
 4521:          // for (int k=kb + 1; k<nvrt; k++) {
 4522:          //    const double dzz = side->Dz(k - 1);
 4523: 
 4524:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4525: 
 4526:          //    // Vertical viscosity at the face center
 4527:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4528:         
 4529:          // }
 4530: 
 4531: 
 4532:          const int ndim = nvrt - kb;
 4533:          const double zTopCanopy = side->zTopCanopy();
 4534: 
 4535:          // Initialize the tridiagonal system
 4536:          for (int k = kb + 1; k<nvrt; k++) {
 4537:             
 4538:             const int kin = k - kb;
 4539: 
 4540:             // Vertical viscosity at the face center
 4541:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4542:             const double dzz = side->Dz(k);
 4543: 
 4544:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 4545:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 4546:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4547: 
 4548:             alow[kin] = 0.0;
 4549:             cupp[kin] = 0.0;
 4550:             bdia[kin] = 0.0;
 4551: 
 4552:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4553:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4554: 
 4555:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4556:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4557:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4558: 
 4559:             // First part: layers k, k+1
 4560:             if (k < nvrt - 1) {
 4561:                              
 4562:                if constexpr(iveg != 0) {
 4563: 
 4564:                   // If there is vegetation at this level...
 4565:                   if (zTopCanopy > side->zc[k]) {
 4566:                      // If the canopy is above the k layer...
 4567:                      
 4568:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4569:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4570:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4571:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4572: 
 4573:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4574:                      const double vmag2 = length(ut2);
 4575:                      const double vmag1 = length(side->u2[k]);
 4576:                      const double vmag = 0.5*(vmag1 + vmag2);
 4577:                      
 4578:                      // Computes the vegetation alpha at the face center
 4579:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4580: 
 4581:                      cff1 += veg_alpha_sd*dt*vmag;
 4582: 
 4583:                   } // if (zTopCanopy
 4584:                } // if iveg
 4585: 
 4586:                const double tmp = dt*dfz/dzz;
 4587:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4588:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4589: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 4590:             }
 4591: 
 4592: 
 4593:             // Second part: layers k-1, k
 4594:             if (k > kb + 1) {
 4595: 
 4596:                double cff1 = 1.0; //init \bar{c^k}
 4597: 
 4598:                if constexpr(iveg != 0) {
 4599:                   // If there is vegetation at this level...
 4600:                   if (zTopCanopy > side->zc[k-1]) {
 4601:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4602:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4603: 
 4604:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4605: 
 4606:                      const double vmag2 = length(ut2);
 4607:                      const double vmag1 = length(side->u2[k-1]);
 4608:                      const double vmag = 0.5*(vmag1 + vmag2);
 4609: 
 4610:                      // Computes the vegetation alpha at the face center
 4611:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4612:                      cff1 += veg_alpha_sd*dt*vmag;
 4613:                   } // if zTopCanopy
 4614: 
 4615:                } // if iveg
 4616: 
 4617:                const double tmp = dt*dfz/dzz;
 4618:                alow[kin] += cff1*dzz/6.0 - tmp;
 4619:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4620: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 4621:             } else { // Bottom boundary
 4622:                // This occurs at the bottom, where the bottom drag is applied.
 4623: 
 4624:                bdia[kin] += dt*side->chi2;
 4625: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 4626:             } // if (k > kb + 1)
 4627: 
 4628: 
 4629: 
 4630:          } // for (int k
 4631: 
 4632: 
 4633: 
 4634:          // Computes the RHS.
 4635:          // -----------------
 4636: 
 4637:          //	BC to be imposed at the end.
 4638: 
 4639:          const Vector2 gradETP  = side->gradETP;
 4640:          const Vector2 gradPr   = side->gradPr;
 4641:          const Vector2 gradEta1 = side->gradEta1;
 4642:          const Vector2 gradEta2 = side->gradEta2;
 4643: 
 4644:          const Vector2 *btu = side->btu;
 4645:          const Vector2 *u2  = side->u2;
 4646:          const double coriolis = side->coriolis;
 4647:          const Vector2 *d2uv = side->d2uv;
 4648: 
 4649: 
 4650:          for (int k = kb + 1; k<nvrt; k++) {
 4651:             const int kin = k - kb;
 4652: 
 4653:             const double dz_0 = side->Dz(k);
 4654:             const double dz_1 = side->Dz(k+1);  
 4655: 
 4656:             rrhs[kin] = {0.0, 0.0};
 4657:             double dz = 0.0;
 4658: 
 4659:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 4660:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 4661:             if (k < nvrt  ) dz += 0.5*dz_1;
 4662:             if (k > kb + 1) dz += 0.5*dz_0;
 4663: 
 4664:             // Elevation gradient, atmospheric pressure and tidal potential
 4665:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 4666: 
 4667:             // Coriolis, advection, wind stress, and horizontal viscosity
 4668:             if (k < nvrt - 1) {
 4669: 
 4670: 
 4671:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 4672:                                           (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 4673:                                           dt*(2.0*d2uv[k] + d2uv[k + 1]));
 4674: 
 4675:                //diff stress tensors 1006
 4676:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 4677:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 4678:                   assert(false && "Not implemented: itur == 5");
 4679:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 4680:                }
 4681: 
 4682:             } else { // k=nvrt
 4683:                Vector2 tau2 = {0.0, 0.0};
 4684:                if constexpr(ics==1) {
 4685:                   tau2 = side->tau();
 4686:                } else {
 4687:                   assert(false && "Not implemented: ics == 2");
 4688:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4689:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4690:                   // taux2=(vn1+tt1)*0.5d0
 4691:                   // tauy2=(vn2+ss1)*0.5d0
 4692:                } // if ics
 4693: 
 4694:                rrhs[kin] += dt*tau2;
 4695: 
 4696:             } // if k<nvrt
 4697: 
 4698:             if (k > kb + 1) {
 4699:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k - 1] + 
 4700:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 4701:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 4702: 
 4703: 
 4704:                // diff stress tensors 1006
 4705:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 4706:                   assert(false && "Not implemented: itur == 5");
 4707:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 4708:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 4709:                }
 4710: 
 4711:             } // if k>kbs + 1
 4712: 
 4713:             // Baroclinic
 4714:             Vector2 *bcc = side->bcc;
 4715:             if constexpr(ibc == 0) {
 4716:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 4717:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 4718: 
 4719:             } // if ibc==0
 4720: 
 4721: 
 4722:          } // k=kb + 1,nvrt
 4723: 
 4724:    printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 4725:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4726:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 4727: 
 4728:          for (int k=kb + 1; k<nvrt; k++) {
 4729:             const int kin = k - kb;
 4730: 
 4731:             // Velocity is always clamped to maximum values
 4732:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 4733:          } // k
 4734: 
 4735:       } // if side->is2D()
 4736:       
 4737: 
 4738:       // Impose velocity boundary conditions at the bottom
 4739:       if constexpr(imm == 2) { //no slip
 4740:          double dep;
 4741:          Vector2 vel;
 4742: 
 4743:          assert(false && "Not implemented: imm == 2");
 4744:          //update_bdef(time, x0, y0, dep, vel);
 4745:          // side->u2[kb] = vel;
 4746: 
 4747:       } else {
 4748:          if (side->Cd() == 0.0) {
 4749:             side->u2[kb] = side->u2[kb + 1];
 4750:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 4751:             side->u2[kb] = {0.0, 0.0};
 4752:          }
 4753:           
 4754:       } // if imm
 4755: 
 4756:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4757:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 4758:       
 4759: 
 4760:    }
 4761: 
 4762: 
 4763:    __device__ void applyMomentumBC(void) {
 4764: 
 4765:       SIDE_BND(side_bnd);
 4766: 
 4767:       Side *side = side_bnd->side;
 4768:       const BoundarySegment *segment = side_bnd->segment;
 4769:       const Node *n1 = side->n1;
 4770:       const Node *n2 = side->n2;
 4771: 
 4772:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 4773:       const bool isLand     = (segment == (BoundarySegment *)landSegment);
 4774:       const bool isInternal = (segment == (BoundarySegment *)internalSegment);
 4775: 
 4776:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 4777:       const int kb = side->kb;
 4778: 
 4779:       if (!isLand && segment->ifltype != 0) {
 4780:          const Vector2 *uth = side->uth;
 4781: 
 4782:          for (int k=kb; k < nvrt; k++) {
 4783:             assert(segment->ifltype == -2 || (uth[k].x >= -98 && uth[k].y >= -98) && "Momentum BC: Side has no velocity boundary conditions");
 4784: 
 4785:             Vector2 uth = side->uth[k];
 4786: 
 4787:             if (segment->ifltype == -1) {
 4788:                // Flather 1
 4789: 
 4790:                const double depth = side->depth();
 4791: 
 4792:                assert(n1->nodeBnd->eta_mean >= -98 && n2->nodeBnd->eta_mean >= -98 && "Flather bnd elevation not assigned");
 4793:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 4794: 
 4795:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->etaMeanBnd()) + dot(uth, side->n);
 4796: 
 4797:                side->u2[k] = vnorm*side->n;
 4798: 
 4799:             } else if (segment->ifltype == -2) { // Discharge
 4800: 
 4801: 
 4802:                const double eta1 = side->eta1();
 4803:                const double eta2 = side->eta2();
 4804:                const double htot = side->htot2();
 4805: 
 4806:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 4807:                assert(false && "Not implemented: Discharge bc");
 4808:                // const double dischrg = discharge(eta1);
 4809:                const double dischrg = 0.0; // XXX REMOVE
 4810:                
 4811: 
 4812:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 4813: 
 4814:                const double vnorm = dischrg*eta2/htot;
 4815: 
 4816:                side->u2[k] = vnorm*side->n;
 4817: 
 4818: 
 4819:             }
 4820:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 4821:                const double vnorm = dot(side->u2[k], side->n);
 4822: 
 4823:                double rat;
 4824:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 4825:                else              rat = segment->vobc2; // outgoing
 4826: 
 4827:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*uth;
 4828:             }
 4829:             else { // not Flather or 3D radiation
 4830:                side->u2[k] = uth;
 4831: 
 4832:             } // if (segment->ifltype...
 4833: 
 4834:          }
 4835: 
 4836:       }
 4837:       else if (isLand) { // land bnd
 4838:          if constexpr(islip == 0) { // free slip
 4839:             for (int k=kb; k < nvrt; k++) {
 4840:                double vnorm = 0.0; // for most cases
 4841:                const double vtan = dot(side->u2[k], side->t());
 4842:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 4843:             }
 4844: 
 4845:          } else { // no slip
 4846:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 4847: 
 4848:          }
 4849:       } // if (side segment type...
 4850: 
 4851:       
 4852: 
 4853: 
 4854: 
 4855:    }
 4856: 
 4857: 
 4858:    __device__ void shapiroFilter1(void) {
 4859:       // First step of the Shapiro filter (normally used if indvel<=0)
 4860:       // Computes the filtered values and stores them in bcc (as a temporary array).
 4861: 
 4862:       if constexpr(ishapiro == 0) return;
 4863: 
 4864:       SIDE(side);
 4865: 
 4866:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4867: 
 4868:       if (side->isDry || isInternal ) return;
 4869: 
 4870:       const int kb = side->kb;
 4871: 
 4872:       for (int mm = 1; mm <= niter_shap; mm++) {
 4873: 
 4874: 
 4875:          // Internal wet sides
 4876:          for (int k = kb + 1; k < nvrt; k++) {
 4877:             // WARNING: reusing bcc as a temporary array to store the suru values.
 4878:             side->bcc[k] = {0.0, 0.0};
 4879:             Vector2 suru = {0.0, 0.0};
 4880: 
 4881:             for (int j=0; j<4; j++) {
 4882: 
 4883:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 4884:                
 4885:                int kin = k;
 4886:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 4887:                
 4888:                if constexpr(ics==1) {
 4889:                   suru += side->u2[kin];
 4890:                } else {
 4891:                   assert(false && "Not implemented: ics == 2");
 4892:                   // Vector2 vn1, vn2;
 4893:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 4894:                   // suru=suru+vn1;
 4895:                   // surv=surv+vn2;
 4896:                }
 4897:             }
 4898: 
 4899:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 4900: 
 4901:          }
 4902:       }
 4903:    }
 4904: 
 4905:    __device__ void shapiroFilter2(void) {
 4906:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 4907: 
 4908:       if constexpr(ishapiro == 0) return;
 4909: 
 4910:       SIDE(side);
 4911: 
 4912:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4913: 
 4914:       if (side->isDry || isInternal ) return;
 4915: 
 4916:       const int kb = side->kb;
 4917: 
 4918:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 4919: 
 4920:       if (side->is2D()) {
 4921:          side->u2[kb] = side->u2[nvrt - 1];
 4922:          
 4923:       } else {
 4924:          // 3D
 4925:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 4926:          
 4927:       }
 4928: 
 4929:    }
 4930: 
 4931: 
 4932:    __global__ void ul0UpdateZCoords(void) {
 4933:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 4934:       
 4935:       NODE(node);      
 4936: 
 4937:       if (node->isDry2()) { 
 4938: 
 4939:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 4940: 
 4941:          if constexpr(ivcor != 1) node->kb = 0;
 4942: 
 4943:       } else {
 4944: 
 4945:          node->updateKb();
 4946:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 4947: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 4948: 
 4949:       } // if wet or dry
 4950: 
 4951:       // We use the temp.b field to store the previous state of isDry.
 4952:       node->tmp.b = node->isDry;
 4953: 
 4954:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 4955:       node->isDry = true;
 4956: 
 4957:    }
 4958: 
 4959:    __global__ void ul0ComputeDryElementsAndNodes(void)
 4960:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 4961:    {
 4962:       ELEM(elem);
 4963: 
 4964:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 4965: 
 4966:       // All the nodes of a wet element are wet.
 4967:       if (!elem->isDry) {
 4968:          elem->nodes[0]->isDry = false;
 4969:          elem->nodes[1]->isDry = false;
 4970:          elem->nodes[2]->isDry = false;
 4971:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 4972: 
 4973:       }
 4974: 
 4975: 
 4976:       elem->kb = 0;
 4977: 
 4978:       if (elem->isDry) return;
 4979: 
 4980:       // Wet
 4981:       const Node *n1 = elem->nodes[0];
 4982:       const Node *n2 = elem->nodes[1];
 4983:       const Node *n3 = elem->nodes[2];  
 4984:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 4985: 
 4986:    //    if(elem->isDry2()) {
 4987:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 4988:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 4989:    //        call parallel_abort(errmsg)
 4990:    //    }
 4991: 
 4992: 
 4993:       // Computes element's kb as the minimum of the nodes' kb.
 4994:       const int kb1 = n1->kb;
 4995:       const int kb2 = n2->kb;
 4996:       const int kb3 = n3->kb;
 4997:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 4998: 
 4999: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5000: 
 5001:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5002: 
 5003: 
 5004:       // Computes the element z as the mean of the nodes z.
 5005:       for (int k = elem->kb; k < nvrt; k++) {
 5006: 
 5007:          // Compute the element z as the mean of the nodes z.
 5008:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5009:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5010:          elem->z[k] /= elem->i34;
 5011: 
 5012:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5013:       }
 5014:                   
 5015:    }
 5016: 
 5017:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5018:    {
 5019:       NODE(node);
 5020:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5021: 
 5022:       if (it == iths) return;
 5023: 
 5024: 
 5025:       if(!node->isDry && node->tmp.b) { // rewetted
 5026:          for (int k=0; k < nvrt; k++) {
 5027: 
 5028:             Vector3 utmp={0.0, 0.0, 0.0};
 5029: 
 5030:             double ttmp=0.0;
 5031:             double stmp=0.0;
 5032:             int icount=0;
 5033:             for (int j = 0; j < node->numNodes; j++) {
 5034: 
 5035: 
 5036:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5037:                if (!node->isDry) { // all indices extended
 5038:                   icount++;
 5039: 
 5040:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5041:                   utmp += node->u2[k];
 5042:                   
 5043:                   ttmp += node->tracers[k].tracer[0]; 
 5044:                   stmp += node->tracers[k].tracer[1]; 
 5045:                }
 5046:             }
 5047: 
 5048:             if(icount > 0) {
 5049:                const double inv_icount = 1.0/icount;
 5050:                node->u2[k]     = inv_icount*utmp;
 5051:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5052:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5053:             }
 5054:          }
 5055:       }
 5056:    }
 5057: 
 5058: 
 5059:    __global__ void ul0UpdateSides(int it, int iths) {
 5060: 
 5061:       SIDE(side);
 5062: 
 5063:       // A side is wet if and only if at least one of its elements is wet.
 5064:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5065: 
 5066:       const Node *n1 = side->n1;
 5067:       const Node *n2 = side->n2;
 5068:       const int kb1 = n1->kb;
 5069:       const int kb2 = n2->kb;
 5070: 
 5071:       side->kb = 0; // dry
 5072: 
 5073:       if (isWet) {
 5074: 
 5075:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5076: 
 5077:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5078: 
 5079:          side->kb = min(kb1, kb2);
 5080: 
 5081:          for (int k = side->kb; k < nvrt; k++) {
 5082:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5083: 
 5084:          
 5085:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5086: 
 5087:             // Compute velocity for re-wetted sides 
 5088:             if ((it != iths) && (side->isDry && isWet)) {
 5089:             
 5090:                Vector2 utmp={0.0, 0.0};
 5091: 
 5092:                int icount=0;
 5093: 
 5094:                // For all the sides on the two elements that share this side
 5095:                for (int j=0; j < 2; j++) {
 5096:                   const Element *elem = side->elems[j];
 5097:                   if (elem == nullptr) continue;
 5098: 
 5099:                   for (int jj=0; jj < elem->i34; jj++) {
 5100:                      const Side *nSide = elem->sides[jj];
 5101:                      if (nSide->isDry) continue;
 5102: 
 5103:                      icount++;
 5104:                      utmp += nSide->u2[k];                     
 5105:                   }
 5106:                }
 5107:                   
 5108:                assert(icount > 0 && "No wet sides around this side");
 5109:                if (icount > 0)  side->u2[k] = utmp/icount;
 5110:                   
 5111:             } // if ((it != iths) && (side->isDry && isWet))
 5112: 
 5113:          } // for k
 5114: 
 5115:       } // if isWet
 5116:    
 5117:       side->isDry = !isWet;
 5118: 
 5119:    }
 5120: 
