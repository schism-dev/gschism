 2463: 
 2464: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2465:    if constexpr(ics == 1)  {
 2466:       return center;
 2467: 
 2468:    } else {
 2469:       const Point2 p0 = nodes[0]->outputCoords();
 2470:       const Point2 p1 = nodes[1]->outputCoords();
 2471:       const Point2 p2 = nodes[2]->outputCoords();
 2472: 
 2473:       if (isTri()) {
 2474:          return (1.0/3.0)*(p0 + p1 + p2);
 2475: 
 2476:       } else {
 2477:          const Point2 p3 = nodes[3]->outputCoords();
 2478:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2479:       }
 2480: 
 2481:    }
 2482: }
 2483: 
 2484: 
 2485: __device__ __forceinline__ double Element::centerZ(void) const { 
 2486: // Z coordinate of the element center in the global cartesian coordinates.
 2487: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2488: 
 2489:    if constexpr(ics==1) { 
 2490:       return 0.0; 
 2491: 
 2492:    } else { 
 2493: 
 2494:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2495:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2496:    } 
 2497: }
