 1575: // Helper functions for computing the local node index at a given offset from another.
 1576: __device__ __inline__ int nxq(int offset, int index, int size) {
 1577:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1578:    // to the index to make it positive
 1579:    assert(index + offset + 16*size >= 0);
 1580:    return (index + offset + 16*size) % size;  
 1581: }
 1582: 
 1583: __device__ __inline__ int nxq(int index, int size) {
 1584:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1585:    // to the index to make it positive
 1586:    assert(index + 16*size >= 0);
 1587:    return (index + 16*size) % size; 
 1588: }
