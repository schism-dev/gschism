  883:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  884:                                        Point3 &xt, double zint, Vector3 &u_int);
  885:     
  886:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  887:                                                  Element *&nextElem, int &jlev, double &dt,
  888:                                                  const Side *origSide);
  889: 
  890: };
