 1606:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1607:       // Compute the different time ramps used in the code 
 1608:       // This function is performed by just one thread
 1609: 
 1610:       rampbc = 1.0;
 1611:       if constexpr(ibc == 0) {
 1612:          if (drampbc > 0.0) {
 1613:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1614:          } else {
 1615:             rampbc = 1.0;
 1616:          }
 1617:       }
 1618: 
 1619:       if (nws != 0) {
 1620:          if (drampwind > 0.0) {
 1621:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1622:          } else {
 1623:             rampwind = 1.0;
 1624:          }
 1625:       }
 1626: 
 1627:       if (drampwafo > 0.0) {
 1628:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1629:       } else {
 1630:          rampwafo = 1.0;
 1631:       }
 1632: 
 1633:       // For source/sinks
 1634:       if (if_source && dramp_ss > 0.0) {
 1635:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1636:       } else {
 1637:          ramp_ss = 1.0;
 1638:       }
 1639: 
 1640:       if (dramp > 0.0) {
 1641:          ramp = tanh(2.0*time/86400.0/dramp);
 1642:       } else {
 1643:          ramp = 1.0;
 1644:       }
 1645: 
 1646: 
 1647:    }
