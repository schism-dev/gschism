 1555: __device__ __inline__ double min3(double a, double b, double c) {
 1556:    return min(a, min(b, c));
 1557: }
 1558: 
 1559: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1560:    return min(a, min(b, min(c, d)));
