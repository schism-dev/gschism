 8351: 
 8352:    SIDE(side);
 8353: 
 8354:    switch (varCode) {
 8355:       case (int)VarCode::outputCoords:
 8356:          const Point2 coords = side->outputCoords();
 8357:          res[side->idx*2    ] = coords.x;
 8358:          res[side->idx*2 + 1] = coords.y;
 8359:          break;
 8360:    }
 8361: }
