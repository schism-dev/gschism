 6911:    __global__ void zeroNodalVelocities(void) {
 6912:       NODE(node);
 6913: 
 6914:       for (int k = 0; k < nvrt; k++) {
 6915:          node->u2[k]   = {0.0, 0.0};
 6916:          node->w2[k]   = 0.0;
 6917:          node->utmp[k] = {0.0, 0.0};         
 6918:       }
 6919:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6920:    }
 6921:  
 6922: 
 6923:    __global__ void computeNodalVerticalVelocities1(void) {
 6924:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6925:    // Adds the element's vertical velocity times the element's area.
 6926:       ELEM(elem);
 6927: 
 6928:       for (int j = 0; j < elem->i34; j++) {
 6929:          Node *node = elem->nodes[j];
 6930: 
 6931:          for (int k = node->kb; k < nvrt; k++) {
 6932:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6933:          }
 6934:          atomicAdd(&(node->tmp.d), elem->area);
 6935:       }
 6936:    }
 6937: 
 6938:    __global__ void computeNodalVerticalVelocities2(void) {
 6939:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6940:    // Divides by the total area of the elements sharing the    node.
 6941:       NODE(node);
 6942: 
 6943: 
 6944:       const double invArea = 1.0 / node->tmp.d;
 6945:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6946: 
 6947:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6948:    }
 6949: 
