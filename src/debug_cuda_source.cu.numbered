 1568:                    if (idx_side >= mesh->ns) return;
 1569: 
 1570: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1571:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1572:                    if (idx_elem >= mesh->ne) return;
 1573: 
 1574: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1575:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1576:                    if (idx_node >= mesh->np) return;
 1577: 
 1578: 
 1579: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1580:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1581:                            if (idx_node_bnd >= mesh->nbp) return;
 1582: 
 1583: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1584:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1585:                            if (idx_side_bnd >= mesh->nbs) return;                           
 1586: 
 1587: Polynomial<4> *polyDischarge; // XXX read from file
