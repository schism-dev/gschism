 2050:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2051:       T values[4];
 2052:       getNodalValues(field, values);
 2053: 
 2054:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2055:       if constexpr (IsVector2<T>::value && ics == 2) {
 2056: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2057:          projectNodeVectorsToElementFrame(values);
 2058: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2059:       }
 2060: 
 2061:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2062:    }
