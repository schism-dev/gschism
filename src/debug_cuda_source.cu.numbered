 7437: //                         adv_tr(jj)=adv_tr(jj)-tmp !reset to previous value
 7438: //                         if(ssign(j,i)*flux_adv_hface(k,jsj)<0.d0) then  !inflow 
 7439: //                           adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7440: //                         endif
 7441: //                       endif
 7442: //                       !when ntd_weno=1, reduces to: adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 7443: //                     enddo
 7444: //                   else !upwind
 7445: //                     if(ssign(j,i)*flux_adv_hface(k,jsj)<0) then  !inflow 
