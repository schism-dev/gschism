 1474:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1475:       // Compute the different time ramps used in the code 
 1476:       // This function is performed by just one thread
 1477: 
 1478:       if constexpr(ibc == 0) {
 1479:          if (drampbc > 0.0) {
 1480:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1481:          } else {
 1482:             rampbc = 1.0;
 1483:          }
 1484: 
 1485:          if (nws != 0 && drampwind > 0.0) {
 1486:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1487:          } else {
 1488:             rampwind = 1.0;
 1489:          }
 1490:       }
 1491: 
 1492:       if (drampwafo > 0.0) {
 1493:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1494:       } else {
 1495:          rampwafo = 1.0;
 1496:       }
 1497: 
 1498:       // For source/sinks
 1499:       if (if_source && dramp_ss > 0.0) {
 1500:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1501:       } else {
 1502:          ramp_ss = 1.0;
 1503:       }
 1504: 
 1505:       if (dramp > 0.0) {
 1506:          ramp = tanh(2.0*time/86400.0/dramp);
 1507:       } else {
 1508:          ramp = 1.0;
 1509:       }
 1510: 
 1511:    }
 1512:       
