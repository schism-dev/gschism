 2551: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2552:    const double w1 = getBoundaryArrayValueWeight();
 2553:    const double w2 = 1.0 - w1;
 2554:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2555:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2556: 
 2557:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2558: 
 2559: }
