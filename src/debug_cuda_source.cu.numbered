 1513: // Each device has a global mesh object
 1514: __device__ Mesh* mesh = nullptr; 
 1515: 
 1516: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1517:                    Side *side = &(mesh->localSideData[idx_side]); \
 1518:                    if (idx_side >= mesh->ns) return;
 1519: 
 1520: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1521:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1522:                    if (idx_elem >= mesh->ne) return;
 1523: 
 1524: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1525:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1526:                    if (idx_node >= mesh->np) return;
 1527: 
 1528: 
 1529: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1530:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1531:                            if (idx_node_bnd >= mesh->nbp) return;
 1532: 
 1533: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1534:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1535:                            if (idx_side_bnd >= mesh->nbs) return;                           
 1536: 
 1537: Polynomial<4> *polyDischarge; // XXX read from file
