 4780: extern "C" {
 4781: 
 4782:    __global__ void scaleGravity(double loadtide_coef) {
 4783: 
 4784: 
 4785:       NODE(node);
 4786: 
 4787:       // SAL option: scale gravity
 4788:       if constexpr(iloadtide==2) {  // simple const
 4789:          node->grav2 = grav*(1.0 - loadtide_coef);
 4790: 
 4791:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4792:         
 4793:           const double depth = max(node->depth, 0.0);
 4794:           const double tmp1 = sqrt(depth);
 4795:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4796:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4797:                              2.6969e-13*depth*depth*depth*tmp1;
 4798:           
 4799:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4800:           
 4801: 
 4802: 
 4803:           node->grav2 = grav*(1.0 - beta_bar);
 4804: 
 4805:       } else {  // iloadtide=0,1
 4806:           node->grav2 = grav;
 4807: 
 4808:       }
 4809: 
 4810:    }
 4811: 
