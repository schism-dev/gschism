 5044:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5045: 
 5046:       SIDE(side);
 5047: 
 5048:       side->U = {0.0, 0.0}; 
 5049:          
 5050:       if(side->isDry) return;
 5051: 
 5052:       // Vertically integrated velocity U
 5053:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5054:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5055:          side->U += side->Dz(k + 1)*uc;  
 5056:       }
 5057: 
 5058:    }
