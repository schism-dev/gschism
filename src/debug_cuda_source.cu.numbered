 1481: 
 1482: /**
 1483:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1484:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1485:    If the segment is completely inside the element, then it returns true.
 1486: 
 1487:    This function assumes:
 1488:    - The initial point is on a side of the element. 
 1489:    - Its position is given by parameter t in the range [0,1].
 1490:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1491:       intersects the element (elements are convex).
 1492: 
 1493:    To find the intersection point, this function does the following:
 1494:    - it finds the intersection of the line segment with all the element side lines,
 1495:       except for the one that contains the initial point.
 1496:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1497:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1498:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1499:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1500:       track segment is almost parallel to the element side line.
 1501: 
 1502:    Inputs:
 1503:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1504:    @param x2, y2: other end of the line segment
 1505: 
 1506:    Outputs:
 1507:    @param side:  side that intersects the line segment (input and output)
 1508:    @param nextElement (output): element that contains the intersection point
 1509:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1510:    @param zint (input/output): Vertical coordinate of the intersection point
 1511: 
 1512:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1513:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1514:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1515: 
 1516:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1517:    (Delta) being zero.
 1518: 
 1519:    The intersection2 point happens when:
 1520:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1521:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1522:    
 1523:    Assumption: the 4 points (including those of the side segment) are different.
 1524:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1525:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1526:    If true, (xIntersect,yIntersect) is the intersection.				
 1527:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1528: **/
 1529: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1530:                                               double &t, double& tIntersect) {
 1531: 
 1532:    double closest_intersect_t = 1e10;
 1533:    bool found_intersection = false;
 1534: 
 1535:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1536:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1537:    const Point2 x1 = side->point(t);
 1538:    
 1539: 
 1540:    Side *nextSide = nullptr;
 1541:    for (int i = 0; i < i34; i++) {
 1542: 
 1543:       // Element's i-th side 
 1544:       Side *side2 = sides[i];
 1545: 
 1546:       // Skip the side that contains the initial point
 1547:       if (side2 == side) continue;
 1548: 
 1549:       // (x3,y3)-(x4,y4) is the element side line
 1550:       const Point2 x3 = side2->n1->p2();
 1551:       const Point2 x4 = side2->n2->p2();
 1552: 
 1553:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1554:       const double delta = cross(x2 - x1, x3 - x4);
 1555: 
 1556:       if (delta != 0.0) {
 1557: 
 1558:          const double delta1 = cross(x3 - x1, x3 - x4);
 1559:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1560: 
 1561:          // Solves the two linear equations for tt1 and tt2
 1562:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1563:          const double tt2 = delta2/delta;
 1564: 
 1565:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1566:             closest_intersect_t = min(closest_intersect_t, tt1);
 1567:             nextSide = side2;
 1568: 
 1569:             nextElement = nextSide->otherElem(this);
 1570:             tIntersect = max(small, min(tt1, 1.0-small));
 1571:             t = tt2;
 1572: 
 1573:             found_intersection = true;
 1574:          }
 1575:       
 1576:       }
 1577: 
 1578:    }
 1579:    
 1580: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1581: 
 1582: 
 1583:    // found_intersection should always be true, since we checked all the sides.  
 1584:    side = nextSide;
 1585: // if (found_intersection) {
 1586: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1587: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1588: // }   
 1589:    // if (!found_intersection) {
 1590:    //    // Check if the segment is parallel to the initial side
 1591:    //    printf("XXX segment: side = %p\n", side);
 1592:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1593:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1594:    //       assert(false && "Segment is parallel to the initial side");
 1595:    //       found_intersection = true;
 1596:    //       nextElement = side->otherElem(this);
 1597:    //       tIntersect = t;
 1598:    //       t = 0.0;
 1599:    //       found_intersection = true;
 1600:    //    }
 1601:    // }
 1602:    return found_intersection;
 1603: }
 1604: 
 1605: 
 1606: 
 1607: 
 1608: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1609:                                               double &t, double& tIntersect) {
 1610: 
 1611:    double closest_intersect_t = 1e10;
 1612:    bool found_intersection = false;
 1613: 
 1614: double minDelta = 1e10; 
 1615: double btt1, btt2;
 1616:    for (int i = 0; i < i34; i++) {
 1617: 
 1618:       Side *side2 = sides[i];
 1619: 
 1620:       // (x3,y3)-(x4,y4) is the element side line
 1621:       const Point2 x3 = side2->n1->p2();
 1622:       const Point2 x4 = side2->n2->p2();
 1623: 
 1624:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1625:       const double delta = cross(x2 - x1, x3 - x4);
 1626: 
 1627:       if (abs(delta) > 0) {
 1628: 
 1629:          const double delta1 = cross(x3 - x1, x3 - x4);
 1630:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1631: 
 1632:          // Solves the two linear equations for tt1 and tt2
 1633:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1634:          const double tt2 = delta2/delta;
 1635: 
 1636: if (abs(delta) < minDelta) {
 1637:    minDelta = abs(delta);
 1638:    btt1 = tt1;
 1639:    btt2 = tt2;
 1640: }
 1641: double small = 1e-7;
 1642:          printf("RRRRRR tt1 = %e, tt2 = %e\n", tt1, tt2);
 1643:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1644:             closest_intersect_t = min(closest_intersect_t, tt1);
 1645:             side = side2;
 1646:             nextElement = side->otherElem(this);
 1647:             t = tt2;
 1648:             tIntersect = max(small, min(tt1, 1.0-small));
 1649:             found_intersection = true;
 1650:          }
 1651:       
 1652:       }
 1653:       else {  // parallel segments
 1654:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1655:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1656: 
 1657:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1658: 
 1659:          // const double dist = dot(x1 - x3, side2->n);
 1660:          // if (abs(dist) < small*length(x3 - x4)) {
 1661:          //    const double2 unitarySide = normalize(x4 - x3);
 1662:          //    const double len = dot(x2 - x1, unitarySide);
 1663:          //    t = t + len;
 1664:          //    t = max(0.0, min(t, 1.0));
 1665:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1666: 
 1667: 
 1668:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1669:          //    // t = tt2;
 1670:          //    found_intersection = true;
 1671:          // }
 1672:       }
 1673: 
 1674: 
 1675:    }
 1676: 
 1677:    if (!found_intersection) {
 1678:       
 1679:       printf("ZZ No intersection found:\n"
 1680:            "Element %d\n"
 1681:            "in = %d\n"
 1682:            "minDelta = %e\n"
 1683:            "tt1 = %e, tt2 = %e\n"
 1684:            "segment: (%f, %f)-(%f, %f)\n"
 1685:            "Vertices:\n"
 1686:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1687:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1688:            IDX(nextElement),
 1689:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1690:            minDelta,
 1691:            btt1, btt2,
 1692:            x1.x, x1.y,
 1693:            x2.x, x2.y,
 1694:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1695:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1696:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1697:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1698:            nodes[0]->p.x, nodes[0]->p.y,
 1699:            nodes[1]->p.x, nodes[1]->p.y,
 1700:            nodes[2]->p.x, nodes[2]->p.y,
 1701:            nodes[0]->p.x, nodes[0]->p.y);
 1702: 
 1703:    }
 1704: 
 1705:    // assert(found_intersection && "No intersection found");
 1706: 
 1707:    // found_intersection should always be true, since we checked all the sides.  
 1708:    return found_intersection;
 1709: }
 1710: 
 1711: 
 1712: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1713:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1714: 
 1715:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1716: 
 1717:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1718:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1719:    // curElement.
 1720: 
 1721:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1722:    // And uses this velocity instead to continue the tracking.
 1723: 
 1724:    // computes the intersection point in cartesian coordinates
 1725:    Point2 intersection = nextSide->p_t(tt);
 1726: 
 1727:    // Nudges the point to the barycenter of the element. 
 1728:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1729:    // next segment intersects the element sides.  
 1730:    curElem->nudgeToBarycenter(intersection);
 1731: 
 1732:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1733:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1734:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1735:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1736: 
 1737:    // If the side is an open boundary, the tangential velocity is zero.
 1738:    if (nextSide->isBnd()) vtan = 0.0;
 1739: 
 1740:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1741:    const double us = vtan*nextSide->t().x;
 1742:    const double vs = vtan*nextSide->t().y;
 1743:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1744: 
 1745:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1746:    const double len2 = length(intersection - toPoint2(xt));
 1747:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1748:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1749:    else            dt = 0.0;
 1750: 
 1751:    // The end of this tracking segment is now the intersection point.
 1752:    xt = {intersection.x, intersection.y, zint};
 1753: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1754:    u_int = {us, vs, ws};
 1755:    
 1756: }
 1757: 
 1758: /**
 1759:  * Tracks a particle through elements and vertical levels in the mesh.
 1760:  * 
 1761:  * @param x0,y0,z0     Starting position coordinates
 1762:  * @param xt,yt,zt     Target position coordinates
 1763:  * @param dtb          Time step for tracking
 1764:  * @param uuint,vvint,wwint Initial velocity components
 1765:  * @param nextElem     Starting/resulting element index
 1766:  * 
 1767:  * @return Status code of type trackExitCodes
 1768:  * 
 1769:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1770:  * of the details are different. The idea is that the code requires less branches and is better fit
 1771:  * for GPU execution.
 1772:  * 
 1773:  * The main ideas here are:
 1774:  * - The starting point is expected to be in the starting element.
 1775:  * - The end point is guaranteed to be inside an element.
 1776:  * - since the starting point is inside the element, there are only two cases: 
 1777:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1778:  *     (b) it does not and (xt,yt) is already in the starting element.
 1779:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1780:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1781:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1782:  * - tt1 can be positive or negative. We only consider the positive values.
 1783:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1784:  * - The next intersection will occur at the smallest positive tt1.
 1785:  * - This intersection will be the next (x0,y0) position.
 1786:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1787:  *   of getting stuck in a loop.
 1788:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1789:  *   was found.
 1790:  */
 1791: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1792:                                                        Element *&nextElem, int &jlev, double &dt) {
 1793: 
 1794:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1795:    // else to do.
 1796: 
 1797:    const Element *curElem = nextElem;
 1798:    if (containsPoint(toPoint2(xt))) {
 1799:       curElem->interpolateVelocities(xt, u_int);
 1800:       return true;
 1801:    }
 1802: 
 1803:    Side *side = nullptr;
 1804: 
 1805:    // 1. Initial checks
 1806:    // Verify starting element is valid (wet)
 1807:    assert(!curElem->isDry && "Starting element is dry");
 1808: 
 1809:    // Checks if track has a zero length.
 1810:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1811:    // assert(len2 > 0.0 && "Zero length track"); 
 1812:    
 1813:    const int MAX_ITERATIONS = 1000;
 1814:    
 1815:    double t;
 1816:    Side *nextSide = nullptr;
 1817:    double tIntersect = 1e10;
 1818:    double zint = x0.z;
 1819: 
 1820:    // Horizontal tracking loop
 1821:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1822:    // (x0,y0) is inside the element but the target point is not.
 1823: 
 1824:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1825: 
 1826:    if (!found_intersection) {
 1827: double shpCoords_0[4];
 1828: double shpCoords_t[4];
 1829: computeShapeCoords(toPoint2(x0), shpCoords_0, false);
 1830: computeShapeCoords(toPoint2(xt), shpCoords_t, false);
 1831:       printf("No intersection found (containsPoint = %d, %d [%.17g, %.17g, %.17g] [%.17g, %.17g, %.17g]):\n"
 1832:            "Elements %d, %d\n"
 1833:            "Side %d\n"
 1834:            "segment: (%f, %f),(%f, %f)\n"
 1835:            "triangle node indices: %d, %d, %d\n"
 1836:            "triangle: (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n",
 1837:            containsPoint(toPoint2(x0)), containsPoint(toPoint2(xt)),
 1838:            shpCoords_0[0], shpCoords_0[1], shpCoords_0[2],
 1839:            shpCoords_t[0], shpCoords_t[1], shpCoords_t[2],
 1840:            IDX(curElem), IDX(nextElem),
 1841:            IDX(nextSide),
 1842:            x0.x, x0.y,
 1843:            xt.x, xt.y,
 1844:            curElem->nodes[0]->idx, curElem->nodes[1]->idx, curElem->nodes[2]->idx,
 1845:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y,
 1846:            curElem->nodes[1]->p.x, curElem->nodes[1]->p.y,
 1847:            curElem->nodes[2]->p.x, curElem->nodes[2]->p.y,
 1848:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y);
 1849:    }
 1850:    assert(found_intersection && "No intersection found at %d");
 1851: 
 1852:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1853: 
 1854:    // if the tracking segment goes out of water (either dry or edge boundary)
 1855:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1856: 
 1857: 
 1858:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1859:       nextElem = this;
 1860:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1861:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1862:       return true;    
 1863:    }
 1864: 
 1865: 
 1866:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1867:    int iterations = 0;
 1868:    while (iterations < MAX_ITERATIONS) {
 1869:       iterations++;
 1870:       
 1871:       Element *curElem = nextElem;
 1872: 
 1873:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1874: 
 1875:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1876: 
 1877:       // If we are already in the target element, we are done.
 1878:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1879:       if (!found_intersection) break;
 1880: 
 1881: 
 1882: 
 1883:       // if the tracking segment goes out of water (either dry or edge boundary).
 1884:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1885: 
 1886:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1887: 
 1888:          nextElem = curElem;
 1889: 
 1890: 
 1891:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1892:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1893:          return true;
 1894:       }
 1895:       
 1896:       // Update position and element for next iteration
 1897:       side = nextSide;
 1898: 
 1899:    }
 1900: 
 1901:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1902: 
 1903:  
 1904:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1905:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1906:    nextElem->interpolateVelocities(xt, u_int);
 1907: 
 1908: 
 1909:    return true;
 1910: }
 1911: 
 1912: 
 1913: __inline__ __device__ double Element::computeSignedArea(void) const {
 1914:    // Compute the area of the element
 1915: 
 1916:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1917: 
 1918:    // In the quad case we need to add the area of the other triangle.
 1919:    if (isQuad()) {
 1920:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1921:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1922:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1923:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1924:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1925:          Error("Negative area found in quad element");
 1926:       }
 1927:       res += ar1;
 1928:    }
 1929: 
 1930:    return res;
 1931: }
 1932: 
 1933: 
 1934: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 1935:                                                                 (nodes[1]->isDry2()) ||
 1936:                                                                 (nodes[2]->isDry2()) ||
 1937:                                                                 (i34==4 && nodes[3]->isDry2());
 1938: }
 1939: 
 1940: 
 1941: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1942:    // In boundary sides, the element 1 is nullptr
 1943:    return side->elems[1] == nullptr; 
 1944: }
 1945: 
 1946: 
 1947: 
 1948: /**
 1949:    Compute the shape coordinates of the point (xt,yt) in the element.
 1950:    @param xt (input): x-coordinate of the point
 1951:    @param shpCoords (output): shape coordinates of the point
 1952:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1953:    @return true if the point is inside the element, false otherwise
 1954: **/
 1955: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1956:                                             bool fixNegshpCoord) const {
 1957: 
 1958:    // Compute the shape coordinates of the point xt in the element.
 1959:    if (i34==3) {
 1960:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1961:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1962:       // and in this case, the pt will be nudged into the element
 1963:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1964:       // from the local frame, so use additional check.
 1965: 
 1966:       Point2 x0, x1, x2;
 1967: 
 1968:       if constexpr(ics==1) {
 1969:          x0 = nodes[0]->p2();
 1970:          x1 = nodes[1]->p2();
 1971:          x2 = nodes[2]->p2();
 1972:       }
 1973:       else // lat/lon
 1974:       {
 1975:          Error("Not implemented yet");
 1976: #ifdef ICS2
 1977:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1978:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1979:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1980: #endif
 1981:       }
 1982: 
 1983:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1984:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1985:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1986:       shpCoords[3] = 0.0;
 1987:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1988: 
 1989:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1990:       // then we fix the negative shape coordinates.
 1991:       if (fixNegshpCoord && tmpmin<=0.0) {
 1992: 
 1993:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1994:          // keeping the sum of the shape coordinates equal to 1.
 1995:          // I have tested and compared the new algorithm with the old one, and they give
 1996:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1997:          // The new algorithm should be faster since it is branchless.
 1998:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1999:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2000:          
 2001:          shpCoords[0] = (shpCoords[0] + a)*b;
 2002:          shpCoords[1] = (shpCoords[1] + a)*b;
 2003:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2004: 
 2005:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2006:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2007:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2008:          }
 2009: 
 2010:          // Update the point coordinates for the new shape coordinates
 2011:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2012:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2013:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2014: 
 2015:       }
 2016: 
 2017:       // Check if the point is inside the element
 2018:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2019:    }
 2020:    else {
 2021:       Error("Not implemented yet");
 2022: #ifdef QUADS
 2023:       // Reproject pt in eframe of nel for ics=2
 2024:       if constexpr(ics==1) {
 2025:          xn2 = xt; 
 2026:          yn2 = yt;
 2027:       }
 2028:       else {
 2029:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2030:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2031:       }
 2032: 
 2033:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2034: #endif
 2035:    }
 2036: 
 2037:    return false;  // Never reached
 2038: 
 2039: }
 2040: 
 2041: 
 2042: /**  Interpolate velocities at a given point (xt,yt,zt)
 2043: 
 2044:    @param xt, yt, zt: coordinates of the point to interpolate
 2045:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2046: 
 2047:    This is done in four steps:
 2048: 
 2049:    1. Find the shape coordinates for the final position in the element.
 2050:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2051:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2052:       z levels at xt, yt at each step.   
 2053:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2054:       horizontally and vertically.
 2055: **/
 2056: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2057:    // Interpolate the velocities at the point xt. 
 2058:    // This function works the same for triangular and quadrilateral elements.
 2059:    double shpCoord[4];
 2060: 
 2061: 
 2062:    // First step is to compute the shape coordinates of (xt,yt)
 2063:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2064:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2065: 
 2066:    // Second step is to find the level that contains zt
 2067:    // Uses a binary search to find the level
 2068:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2069:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2070:    int R = nvrt - 1;
 2071: 
 2072:    // Get the z coordinates at the nodes of the element at the levels L and R
 2073:    double zLAtNodes[4], zRAtNodes[4];
 2074:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2075:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2076: 
 2077:    double zL = interpolate(shpCoord, zLAtNodes);
 2078:    double zR = interpolate(shpCoord, zRAtNodes);
 2079:    
 2080:    // Interpolates vertically the velocities
 2081:    double wght1, wght2;
 2082:    if (xt.z<=zL) {
 2083:       wght1 = 1.0;
 2084:       wght2 = 0.0;
 2085:    }
 2086:    else if (xt.z>=zR) {
 2087:       wght1 = 0.0;
 2088:       wght2 = 1.0;
 2089:    }
 2090:    else {
 2091:       // Perform a binary search to find the levels between L and R that contain xt.z
 2092:       while (R - L > 1) {
 2093:          int M = (L + R) / 2;
 2094: 
 2095:          double zMAtNodes[4];
 2096:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2097:          double zM = interpolate(shpCoord, zMAtNodes);
 2098:          if (zM < xt.z) 
 2099:          {
 2100:             L = M;
 2101:             zL = zM;
 2102:          }
 2103:          else 
 2104:          {
 2105:             R = M;
 2106:             zR = zM;
 2107:          }
 2108:       }
 2109:       assert(L == R-1);
 2110:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2111: 
 2112:       wght2 = (xt.z - zL)/(zR - zL);
 2113:       wght1 = 1.0 - wght2;
 2114:    }
 2115: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 2116: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2117:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2118:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2119: 
 2120:    // Neither of the interpolated velocities should be NaN
 2121:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2122: 
 2123: }
