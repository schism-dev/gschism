 6508:    __global__ void zeroNodalVelocities(void) {
 6509:       NODE(node);
 6510: 
 6511:       for (int k = 0; k < nvrt; k++) {
 6512:          node->u2[k]   = {0.0, 0.0};
 6513:          node->w2[k]   = 0.0;
 6514:          node->utmp[k] = {0.0, 0.0};
 6515:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6516:       }
 6517:    }
 6518:  
 6519: 
 6520:    __global__ void computeNodalVerticalVelocities1(void) {
 6521:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6522:    // Adds the element's vertical velocity times the element's area.
 6523:       ELEM(elem);
 6524: 
 6525:       for (int j = 0; j < elem->i34; j++) {
 6526:          Node *node = elem->nodes[j];
 6527: 
 6528:          for (int k = node->kb; k < nvrt; k++) {
 6529:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6530:          }
 6531:          atomicAdd(&(node->tmp.d), elem->area);
 6532:       }
 6533:    }
 6534: 
 6535:    __global__ void computeNodalVerticalVelocities2(void) {
 6536:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6537:    // Divides by the total area of the elements sharing the    node.
 6538:       NODE(node);
 6539: 
 6540:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6541: 
 6542:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6543:    }
 6544: 
 6545: 
 6546:    __global__ void computeNodalHorizontalVelocities1(void) {
 6547: 
 6548:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6549:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6550: 
 6551:       ELEM(elem);
 6552: 
 6553:       if (elem->isDry) return;
 6554: 
 6555:       const int kb = elem->kb;
 6556:       const bool isTri = elem->isTri();
 6557: 
 6558:       if constexpr(indvel <= 0) {
 6559:          // Assuming discontinous hvel.
 6560: 
 6561:          if (isTri) { // For triangles
 6562:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6563:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6564: 
 6565:             for (int j = 0; j < 3; j++) {
 6566:                // For every node of the triangle...
 6567:                Node *node = elem->nodes[j];
 6568: 
 6569:                if (node->isDry) continue;
 6570: 
 6571:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6572:                const Side *s2 = elem->sides[(j + 1) % 3];
 6573:                const Side *s3 = elem->sides[(j + 2) % 3];
 6574: 
 6575:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6576: 
 6577:                atomicAdd(&(node->tmp.i), 1);
 6578: 
 6579:                for (int k = kb; k < nvrt; k++)  {
 6580:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6581:                   u = clampVelocity(u);
 6582:                   atomicAdd(&(node->utmp[k].x), u.x);
 6583:                   atomicAdd(&(node->utmp[k].y), u.y);
 6584: 
 6585:                }
 6586: 
 6587:             }
 6588:          }
 6589:          else { // For quads
 6590:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6591: 
 6592:          }
 6593: 
 6594:       }
 6595:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6596:       
 6597:    }
 6598: 
 6599: 
 6600:    __global__ void computeNodalHorizontalVelocities2(void) {
 6601:       NODE(node);
 6602: 
 6603:       const int nodeCount = node->tmp.i;
 6604: 
 6605:       if (nodeCount == 0) 
 6606:       {
 6607:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6608:          return;
 6609:       }
 6610: 
 6611:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6612:       
 6613:       const int kb = node->kb;
 6614: 
 6615:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6616:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6617:       
 6618:       
 6619:    }   
 6620: 
