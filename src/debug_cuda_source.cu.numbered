 7068: __global__ void printMatrix(bool full) {
 7069:    // Debugging: print the matrix
 7070: 
 7071:    const int size = mesh->np;
 7072:    double sum = 0.0;
 7073:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7074:       const Node *node = mesh->localNodeData + idx_node;
 7075:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7076:       for (int j = 0; j < node->numNodes; j++) {
 7077:          Node* nbNode = node->nodes[j];
 7078:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7079:          sum += node->coeffMatrix[j];
 7080:       }
 7081:       if (full) printf("]\n");
 7082: 
 7083: 
 7084:    }
 7085:    if (!full) printf("sum=%lf\n", sum);
 7086: }
