 4261:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4262: 
 4263:       NODE_BND(nodeBnd);
 4264: 
 4265:       Node *node = nodeBnd->node;
 4266: 
 4267:       node->ETP = 0.0;
 4268: 
 4269:       for (int j=0; j<ntip; j++) {
 4270: 
 4271:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4272:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4273:    
 4274:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4275: 
 4276:          if constexpr(iloadtide==1) { // loading tide
 4277:             assert(false && "Loading tide not implemented");
 4278:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4279:          }
 4280:          
 4281:       }
 4282:       
 4283:    }
