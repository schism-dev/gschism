  491:    Frame frame;
  492: 
  493:    Vector2 gradPhi[4];       // Derivatives of shape functions
  494:    Vector2 gradEta;          // Gradient of free surface elevation
  495:    Vector2 gradPr;           // Gradient of pressure    
  496:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  497: 
  498:    bool isDry;                // True if the element is dry
  499: 
  500:    Vector3 center;            // Element center coordinates
  501:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  502:    double depth;              // Depth at element (min of all nodes)
  503:    double z[nvrt];            // z-coord  (local frame - vertical up)
  504: 
  505:    // Physical information
  506:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
