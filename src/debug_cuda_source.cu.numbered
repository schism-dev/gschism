 6528:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6529: 
 6530:       SIDE(side);
 6531: 
 6532:       side->U = {0.0, 0.0}; 
 6533:          
 6534:       if(side->isDry) return;
 6535: 
 6536:       // Vertically integrated velocity U
 6537:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6538:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6539:          side->U += side->Dz(k + 1)*uc;  
 6540:       }
 6541: 
 6542:    }
