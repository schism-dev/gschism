 7610: __global__ void getStructSizes(int* sizes)  {
 7611:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7612:       sizes[0] = (int)sizeof(Node);
 7613:       sizes[1] = (int)sizeof(Element);
 7614:       sizes[2] = (int)sizeof(Side);
 7615:       sizes[3] = (int)sizeof(NodeBoundary);
 7616:       sizes[4] = (int)sizeof(SideBoundary);
 7617:       sizes[5] = (int)sizeof(BoundarySegment);
 7618: }
