 2628: 
 2629: 
 2630: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2631: 
 2632: 
 2633: __device__ void Node::updateKb(void) {
 2634: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2635: 
 2636:    if constexpr(ivcor == 1) return;
 2637: 
 2638: 
 2639:    // Check if node is wet
 2640:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2641: 
 2642:    if (isDry) return;
 2643: 
 2644:    if constexpr(ivcor == 2) {  // SZ coordinates
 2645:       
 2646:       // Compute bottom level index
 2647:       if (depth <= mesh->h_s) {
 2648:          kb = mesh->kz - 1;
 2649:       } else {
 2650:          kb = -1;
 2651:          int L = 0;
 2652:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2653:          
 2654:          while (L <= R) {
 2655:             int M = (R + L) / 2;
 2656: 
 2657:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2658:             
 2659:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2660:                R = M;
 2661:             } else {
 2662:                L = M;
 2663:             }
 2664: 
 2665:             if (R - L == 1) {
 2666:                kb = L;
 2667:                break;
 2668:             }
 2669:          }
 2670:       }
 2671:    } 
 2672: }
 2673: 
 2674: 
 2675: __device__ double Node::compZCoord(int k) const {
 2676:    // Computes the z coordinate at level k.
 2677:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2678:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2679:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2680:    // used 
 2681:    
 2682:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2683:       
 2684:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2685: 
 2686:    if constexpr(ivcor == 2) {
 2687: 
 2688:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2689:       const int kz = mesh->kz;
 2690:       const double h_c = mesh->h_c;
 2691:       const double theta_f = mesh->theta_f;
 2692:       const double sinh_theta_f = mesh->sinh_theta_f;
 2693: 
 2694:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2695:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2696:       // once per time step/node.
 2697:       // CHECK: updateZCoordData
 2698: 
 2699:       if      (k == nvrt-1)      { return eta2; }
 2700:       else if (k == kz)          return -hmod2;
 2701:       else if (k == kb)          return -depth;
 2702:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2703:       else if (k > kz) {
 2704:          const int ksig = k - kz + 1;
 2705: 
 2706:          if (hmod2 <= h_c) {
 2707:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2708:          } 
 2709:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2710:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2711:             assert(false && "ZCOOR: invalid h_c\n");
 2712:          } 
 2713:          else {
 2714:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2715:                          h_c * mesh->sigma[ksig] + 
 2716:                          (hmod2 - h_c) * mesh->cs[ksig];
 2717:          }
 2718:       } else { 
 2719:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2720:       }
 2721: 
 2722:    }
 2723:    else if constexpr(ivcor == 1) {
 2724:       if (k == kb) return -depth;
 2725:       else if (k == nvrt-1) return eta2;
 2726:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2727:    }
 2728:    
 2729:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2730:    return 0.0;
 2731: }
 2732: 
 2733: 
 2734: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2735:    // Checks if a side in on the boundary
 2736:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2737: 
 2738:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2739:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2740: 
 2741:    // Indices of the nodes that form the side
 2742:    const int n1 = side.n1->idx;
 2743:    const int n2 = side.n2->idx;
 2744: 
 2745:    // Check if the side is on a land boundary
 2746:    for (int i = 0; i < nland; i++) {
 2747:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2748:          // Consecutive nodes in the land boundary segment
 2749:          const int b1 = ilnd[i*mnlnd + j];
 2750:          const int b2 = ilnd[i*mnlnd + j + 1];
 2751: 
 2752:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2753:             isLand = true;
 2754:             return i;
 2755:          }
 2756:       }
 2757:    }
 2758: 
 2759:    // Check if the side is on an open boundary
 2760:    for (int i = 0; i < nope; i++) {
 2761:       for (int j = 0; j < nond[i] - 1; j++) {
 2762:          // Consecutive nodes in the open boundary segment
 2763:          const int b1 = iond[i*mnond + j];
 2764:          const int b2 = iond[i*mnond + j + 1];
 2765: 
 2766:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2767:             isLand = false;
 2768:             return i;
 2769:          }
 2770:       }
 2771:    }
 2772:    return -1;
 2773: }
 2774: 
 2775: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2776:                 double *node_coords, double *wind_rotate_angle, 
 2777:                 int *isdel, int *isidenode, int *isbnd,
 2778:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2779:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2780:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2781:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2782:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2783:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2784:                 double *emo, double *efa, 
 2785:                 double *umo, double *ufa, 
 2786:                 double *vmo, double *vfa) {
 2787: 
 2788:    printf("Populating mesh for partition %d\n", partNum);
 2789: 
 2790:    // Horizontal grid
 2791:    printf("Processing %d nodes\n", np);    
 2792: 
 2793: 
 2794:    int idxNodeBoundary = 0;  
 2795:    for (int i = 0; i < np; i++)
 2796:    {
 2797:       Node &node = localNodeData[i];
 2798: 
 2799:       node.idx = i;
 2800: 
 2801:       const int idxNodeStart = nodeNeighNodesStart[i];
 2802:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2803:       node.numNodes = idxNodeEnd - idxNodeStart;
 2804:       node.nodes = nodeNeighNodes + idxNodeStart;
 2805:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2806: 
 2807: 
 2808: 
 2809:       const int idxElemStart = nodeNeighElemsStart[i];
 2810:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2811:       node.numElements = idxElemEnd - idxElemStart;
 2812:       node.elements = nodeNeighElems + idxElemStart;
 2813: 
 2814: 
 2815:       
 2816:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2817:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2818:          const int partNode = localNodePart[idxNodeGlobal]; 
 2819:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2820: 
 2821: 
 2822:          Node *node_ptr = nodes[partNode] + idxNode;
 2823:          
 2824:          nodeNeighNodes[idx] = node_ptr;
 2825:       }
 2826: 
 2827:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2828:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2829:          const int partElem = localElemPart[idxElemGlobal];
 2830:          const int idxElem  = localElemIndices[idxElemGlobal];
 2831: 
 2832:          Element *elem_ptr = elems[partElem] + idxElem;
 2833: 
 2834:          nodeNeighElems[idx] = elem_ptr;
 2835:       }      
 2836: 
 2837: 
 2838:       node.wind_angle = wind_rotate_angle[i];
 2839: 
 2840:       // Element **elements; // pointer to the elements connected to this node
 2841:       // int numElements;   // number of elements shared by this node
 2842: 
 2843:       node.p.x   = node_coords[i * 3];
 2844:       node.p.y   = node_coords[i * 3 + 1];
 2845:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2846:       node.depth = node_coords[i * 3 + 2];
 2847: 
 2848:       node.numSides = 0;
 2849: 
 2850: printf("EEEEEE idx = %d, isbnd[i] = %d, node.nodeBnd = %p\n", i, isbnd[i], node.nodeBnd);
 2851:       // Links the node to the boundary information
 2852:       if (isbnd[i] >= 0) {
 2853:        
 2854:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2855:          node.nodeBnd->node = &node;
 2856: 
 2857:          node.nodeBnd->sideBnd1 = nullptr;
 2858:          node.nodeBnd->sideBnd2 = nullptr;
 2859: 
 2860:          if (isbnd[i]>=0) {
 2861: 
 2862:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2863:             
 2864:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2865:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2866: 
 2867:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2868:             node.nodeBnd->segment->clen  = nan("1");
 2869:             node.nodeBnd->segment->carea = nan("1");
 2870: 
 2871:          }
 2872: //          else {
 2873: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2874: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2875: //          }
 2876:          
 2877:          idxNodeBoundary++;
 2878: printf("EEEEEEhhhh idx = %d, isbnd[i] = %d, idxNodeBoundary = %d\n", i, isbnd[i], idxNodeBoundary);         
 2879:       }
 2880:       else {
 2881:          node.nodeBnd = nullptr; // For internal nodes
 2882: printf("EEEEEQQ isbnd[i] = %d, node.nodeBnd = %p\n", isbnd[i], node.nodeBnd); 
 2883:          if (isbnd[i] == landSegment) {
 2884:             node.nodeBnd = &landBoundaryNode;
 2885:             node.nodeBnd->segment = &landBoundarySegment;
 2886:          }
 2887:          // node.nodeBnd->node = &node;
 2888:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2889:          // // node.nodeBnd = nullptr;
 2890:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2891:         
 2892:       }
 2893: 
 2894:       // XXXX GAUSSIAN HILL VELOCITIES
 2895: #ifdef GAUSSIAN_HILL_VELOCITIES
 2896:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2897:          constexpr double rot_per = 3000.0;
 2898:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2899:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2900:       // XXXXX
 2901: #endif
 2902:    }
 2903: 
 2904:    nbp = idxNodeBoundary;
 2905: 
 2906:    printf("Processing %d sides\n", ns);
 2907:    int idxSideBoundary = 0;
 2908:    for (int i = 0; i < ns; i++)
 2909:    {
 2910:       Side &side = localSideData[i];
 2911:       side.idx = i;
 2912:       // finding the pointer to the nodes that form the side
 2913:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2914:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2915: 
 2916:       const int locidx_n1 = localNodeIndices[idx_n1];
 2917:       const int locidx_n2 = localNodeIndices[idx_n2];
 2918:       const int part_n1 =   localNodePart[idx_n1];
 2919:       const int part_n2 =   localNodePart[idx_n2];
 2920: 
 2921:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2922:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2923: 
 2924:       // Counts the number of sides connected to each node
 2925:       side.n1->numSides++;
 2926:       side.n2->numSides++;
 2927: 
 2928:       // Normal, unitary vector to the side
 2929:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2930:       side.n = normalize(side.n);
 2931: 
 2932:       // Side boundary type
 2933:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2934:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2935: 
 2936:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2937:       // If both nodes are on the boundary, then the side may be on the boundary
 2938:       {
 2939:          bool isLand = false;
 2940:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2941: 
 2942:          if (isbs > -1) {
 2943:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2944:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2945:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2946: 
 2947:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2948:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2949:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2950: 
 2951:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2952:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2953:           
 2954:             side.sideBnd->side = &side;
 2955:             idxSideBoundary++;
 2956: 
 2957:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2958:          }
 2959:          
 2960: 
 2961:       // }
 2962:       // 
 2963: 
 2964: 
 2965: 
 2966: 
 2967: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2968: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2969: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2970: //       {
 2971: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2972: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2973: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2974: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2975: // if (side.sideBnd->segment == nullptr) continue;
 2976: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2977: //          else                  side.sideBnd->segment = n2bnd->segment;
 2978: //          side.sideBnd->side = &side;
 2979: //          idxSideBoundary++;
 2980: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2981:       }
 2982:       else side.sideBnd = nullptr;
 2983: 
 2984:       nbs = idxSideBoundary;
 2985: // printf("Here3: %d", i);
 2986:       // finding the pointer to the elements that share the side
 2987:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2988:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2989: 
 2990:       if (idx_e1 > -1) {
 2991:          const int locidx_e1 = localElemIndices[idx_e1];
 2992:          const int part_e1 =  localElemPart[idx_e1];
 2993:          side.elems[0] = elems[part_e1] + locidx_e1;
 2994: 
 2995:       }
 2996:       else {
 2997:          side.elems[0] = nullptr;
 2998:       }
 2999: // printf("Here4: %d", i);
 3000:       if (idx_e2 > -1) {
 3001:          const int locidx_e2 = localElemIndices[idx_e2];
 3002:          const int part_e2 =  localElemPart[idx_e2];
 3003:          side.elems[1] = elems[part_e2] + locidx_e2;
 3004:       }
 3005:       else {
 3006:          side.elems[1] = nullptr;
 3007:       }
 3008: // printf("Here5: %d", i);
 3009: 
 3010: 
 3011:       // Compute the center of the side
 3012:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3013: 
 3014:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3015:       side.shapiro = shapiro0;
 3016: 
 3017: #ifdef GAUSSIAN_HILL_VELOCITIES
 3018: // XXXX
 3019: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3020: constexpr double rot_per=3000.0;
 3021: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3022: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3023: // XXXXX      
 3024: #endif
 3025:       // Compute the z level at the center of the side
 3026:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3027: 
 3028:       // Compute the length of the side
 3029:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3030:       side.len = sqrt(dot(vLen, vLen));
 3031: 
 3032:    }
 3033: 
 3034:    printf("Processing %d elements\n", ne);
 3035:    for (int i = 0; i < ne; i++)
 3036:    {
 3037:       Element &elem = localElemData[i];
 3038:       elem.idx = i;
 3039:       for (int j = 0; j < i34[i]; j++) {
 3040:          const int idxNode = elnode[i*4 + j];  
 3041:          const int idxSide = elside[i*4 + j];
 3042:          
 3043:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3044:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3045: 
 3046: 
 3047: 
 3048:          // Find the neighboring element  
 3049:          if (elem.sides[j]->elems[0] == &elem) {
 3050:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3051:          }
 3052:          else {
 3053:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3054:          }
 3055:          
 3056:       }
 3057: 
 3058:       elem.i34 = i34[i];
 3059: 
 3060: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 3061: 
 3062:       // Compute the centroid of the element and its depth
 3063:       Vector2 center = {0.0, 0.0};
 3064:       elem.depth = 0.0;
 3065:       for (int j = 0; j < i34[i]; j++) {
 3066:          center += elem.nodes[j]->p2()/i34[i];
 3067:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3068:       }
 3069:       elem.center.x = center.x;
 3070:       elem.center.y = center.y;
 3071: 
 3072:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 3073:       
 3074:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3075:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3076: 
 3077:       elem.area = elem.computeSignedArea(); 
 3078:       elem.radius = sqrt(elem.area)/pi; 
 3079:       
 3080:       // Determines which way the normal vector to each side is oriented.
 3081:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3082:       for (int j = 0; j < i34[i]; j++)  
 3083:       {
 3084:          if (elem.sides[j]->elems[0] == &elem) {
 3085:             elem.ssign[j] =  1.0;
 3086:          }
 3087:          else {
 3088:             elem.ssign[j] = -1.0;
 3089:          }
 3090: 
 3091:       }
 3092: 
 3093:       // Derivatives of shape functions
 3094:       //  For ics=2, this is done inside element/ll frame XXX
 3095:       //  For quads, the derivative is evaluated at centroid
 3096:       const int i34 = elem.i34;
 3097:       for (int j = 0; j < i34; j++) {
 3098:          const double area = elem.area;
 3099:          const int id2 = elem.nxq(1 + j);
 3100:          const int id3 = elem.nxq(2 + j);
 3101:          const int id4 = elem.nxq(3 + j);
 3102:          if (elem.isTri()) {
 3103:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3104:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3105:             // da1/dx = (y1 - y2)/(2*area)
 3106:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3107:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3108:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3109:          }
 3110:          else  { // Quad; evaluate at centroid
 3111:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3112:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3113:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3114:          } // if Tri
 3115: 
 3116:       } // for j
 3117: 
 3118:    }
 3119: 
 3120: 
 3121:    // Processing the boundary nodes
 3122:    int idx = 0;
 3123:    for (int iseg = 0; iseg < nope; iseg++) {
 3124:       // for each segment...
 3125:       
 3126:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3127:          // for each node on the segment...
 3128: 
 3129:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3130: 
 3131:          nodeBnd->isEssentialBC = true;
 3132: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3133:          nodeBnd->elbc = 0.0;
 3134: 
 3135:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3136: 
 3137:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3138:             nodeBnd->efa[jfr] = efa[idx];
 3139:             nodeBnd->emo[jfr] = emo[idx];
 3140:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3141:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3142: 
 3143:          }
 3144: 
 3145:          idx++;
 3146:       }
 3147: 
 3148:    }
 3149: 
 3150: }
