 7891: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7892:    Element *elems = mesh->localElemData;
 7893: 
 7894:    *addr = elems;
 7895:    *sizeElement = sizeof(Element);
 7896:    switch (varCode) {
 7897:       case (int)VarCode::z:
 7898:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7899:          *sizeType = sizeof(double);
 7900:          break;
 7901:       case (int)VarCode::x:
 7902:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7903:          *sizeType = sizeof(Vector2);
 7904:          break;
 7905:       case (int)VarCode::area:
 7906:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7907:          *sizeType = sizeof(double);
 7908:          break;
 7909:       case (int)VarCode::depth:
 7910:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7911:          *sizeType = sizeof(double);
 7912:          break;
 7913:       case (int)VarCode::radius:
 7914:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7915:          *sizeType = sizeof(double);
 7916:          break;
 7917:       case (int)VarCode::lonlat:
 7918:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7919:          *sizeType = sizeof(double);
 7920:          break;
 7921:       case (int)VarCode::ghat:
 7922:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7923:          *sizeType = sizeof(Vector2);
 7924:          break;
 7925:       case (int)VarCode::kb:
 7926:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7927:          *sizeType = sizeof(int);
 7928:          break;
 7929:       case (int)VarCode::isdry:
 7930:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7931:          *sizeType = sizeof(int);
 7932:          break;            
 7933:       case (int)VarCode::w:
 7934:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7935:          *sizeType = sizeof(double);
 7936:          break;
 7937:       case (int)VarCode::FaceIndices:
 7938:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7939:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7940:          *sizeType = sizeof(Node);
 7941:          break;
 7942:       default:
 7943:          *offset = -1;
 7944:    }
 7945: }
