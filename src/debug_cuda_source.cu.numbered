 2180:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2181:    // Project the vectors from the node frame to the element frame
 2182: 
 2183:  
 2184:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2185:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2186:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2187:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2188:       else          v[3] = Vector2();
 2189:    }
 2190: 
 2191:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2192:    // Project the vectors from the side frame to the element frame
 2193: 
 2194:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2195:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2196:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2197:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2198:       else          v[3] = Vector2();
 2199:    }
