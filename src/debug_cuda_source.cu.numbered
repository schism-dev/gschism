 1453: 
 1454:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1455:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1456:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1457: 
