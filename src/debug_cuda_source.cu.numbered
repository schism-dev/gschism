 5324:    __global__ void resetBoundaryAreas(void) {
 5325:       // Reset boundary areas and lengths for each segment.
 5326: 
 5327:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5328:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5329:       SIDE_BND(sideBnd);
 5330: 
 5331:       BoundarySegment *segment = sideBnd->segment;
 5332: 
 5333:       segment->carea = 0.0;
 5334:       segment->clen = 0.0;
 5335:  
 5336:    }
 5337: 
 5338:    __global__ void computeBoundaryAreas(void) {
 5339:    // Calculation of cross-section areas and lengths for flow b.c.
 5340: 
 5341:       SIDE_BND(sideBnd);
 5342: 
 5343:       const Side *side = sideBnd->side;
 5344:       BoundarySegment *segment = sideBnd->segment;
 5345: 
 5346:       if (segment->ifltype != 0) {
 5347: 
 5348:          const Node *n1 = side->n1;
 5349:          const Node *n2 = side->n2;
 5350: 
 5351:          const double htot = side->htot2();
 5352: 
 5353:          if (!side->isDry) {
 5354:             atomicAdd(&segment->carea, htot*side->len);
 5355:             atomicAdd(&segment->clen, side->len);
 5356:          }
 5357:       }
 5358: 
 5359:    }
 5360: 
 5361: 
 5362:    __global__ void computeFlowBcVelocities(double time) {
 5363: 
 5364:       SIDE_BND(sideBnd);
 5365: 
 5366:       const Side *side = sideBnd->side;
 5367:  
 5368:       const bool isDry = side->isDry;
 5369:       const bool isLand = sideBnd->segment->isLand;
 5370: 
 5371:    
 5372:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5373: 
 5374:       if (isDry || isLand) return;
 5375: 
 5376:       // For wet sides in open boundaries...
 5377:       const Vector2 n = side->n;
 5378:       const BoundarySegment *segment = sideBnd->segment;
 5379: 
 5380:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5381: 
 5382:       const int ifltype = segment->ifltype;
 5383: 
 5384:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5385:       const Vector2 r_nuth0 = r_uth0*n;
 5386: 
 5387: 
 5388:       if (ifltype == 1 || ifltype == 2) {
 5389:       
 5390:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5391: 
 5392:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5393:          
 5394:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5395:          
 5396:       } else if (ifltype == -1) { // Flather 1
 5397: 
 5398:          for (int k = 0; k < nvrt; k++) {
 5399: 
 5400:             // uth is the normal vel.; no ramp up
 5401:             const double uth = sideBnd->nuth(k);
 5402:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5403: 
 5404:             sideBnd->ubc[k] += uth*n;
 5405:          }
 5406: 
 5407:       } else if (ifltype == 3 || ifltype == 5) {
 5408:          // vnth0=0 !normal vel.
 5409: 
 5410:          Vector2 r_u1_bar = {0.0, 0.0};
 5411:          // Computes the contribution to the velocity from all tide frequencies
 5412:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5413: 
 5414:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5415:             const Vector2 umo  = sideBnd->umo(jfr); 
 5416: 
 5417:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5418:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5419:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5420:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5421: 
 5422:          }
 5423: 
 5424: 
 5425:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5426: 
 5427:       } // if (ifltype = 3 || ifltype == 5
 5428: 
 5429: 
 5430: 
 5431:    }
 5432: 
 5433:    __global__ void computeElevationBoundaryConditions(double time) {
 5434:       // Compute elevation essential boundary conditions 
 5435: 
 5436:       NODE_BND(nodeBnd); // Each boundary node.
 5437: 
 5438:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5439: 
 5440:       const Node *node = nodeBnd->node;
 5441:       const BoundarySegment *segment = nodeBnd->segment;
 5442:       const int iettype = segment->iettype;
 5443:       
 5444: 
 5445:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5446:       double eic = 0.0;
 5447:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5448:       else                 eic = 0.0;
 5449: 
 5450:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5451:       const double r_eth = ramp*nodeBnd->eth;
 5452:       double r_eta1_bar = 0.0;
 5453: 
 5454:       // Compute tide elevation
 5455:       if (iettype == 3 || iettype == 5) {   
 5456: 
 5457:          if constexpr(iloadtide==1) { // loading tide
 5458:             assert(false && "Loading tide not implemented");
 5459:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5460:          }
 5461:          
 5462:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5463: 
 5464:             const double efa  = nodeBnd->efa[jfr]; 
 5465:             const double emo  = nodeBnd->emo[jfr]; 
 5466: 
 5467:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5468:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5469:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5470: 
 5471: 
 5472:          } // for jfr
 5473: 
 5474:       } // if iettype
 5475: 
 5476:       switch (iettype) {
 5477:          case 1:
 5478:          case 2:
 5479:          case 4:
 5480:             nodeBnd->elbc = r_eic + r_eth;
 5481:             break;
 5482:          case 3:
 5483:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5484:             break;
 5485:          case 5:
 5486:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5487:             break;
 5488:       } // switch
 5489: 
 5490: 
 5491:       //Add inverse barometric effects
 5492:       if (iettype != 0 && inv_atm_bnd == 1) {
 5493:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5494:       }
 5495: 
 5496:    }
 5497: 
 5498: 
 5499:    __global__ void computeHorizontalViscosity(void) { 
 5500: 
 5501:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5502: 
 5503:       SIDE(side);
 5504: 
 5505:       if (side->isDry) return;
 5506: 
 5507:       for (int k = 0; k < nvrt; k++) {
 5508:          side->nuGradU[k] = {0.0, 0.0};
 5509:       }
 5510: 
 5511:       if constexpr(ihorcon == 1) {
 5512:          for (int k = side->kb; k < nvrt - 1; k++) {
 5513:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5514:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5515:             // By Zhang and Baptista.
 5516: 
 5517:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5518:             // This is a standard discretization of the Laplacian operator.
 5519:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5520:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5521:             // Gamma is hvis_coef0 in the code.
 5522:             // The value of gamma needs to be < 0.5.
 5523: 
 5524:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5525:             // side under consideration in each of the two possible elements that share the side.
 5526:             Vector2 sumU = {0.0, 0.0};
 5527:             for (int l = 0; l < 2; l++) {
 5528:                const Element *elem = side->elems[l];
 5529: 
 5530:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5531: 
 5532:                // Find the local index of the side in the element
 5533:                const int idxSide = elem->sideLocalIdx(side);
 5534: 
 5535:                // Find the two sides that are connected to the side under consideration
 5536:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5537:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5538: 
 5539:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5540: 
 5541:             }
 5542: 
 5543:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5544: 
 5545:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5546:    
 5547:          }
 5548:       }
 5549:       else if constexpr(ihorcon == 2) {
 5550:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5551:       }
 5552: 
 5553: 
 5554:    }
 5555: 
 5556: 
 5557:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5558: 
 5559:       // Set essential boundary conditions 
 5560:       NODE(node); // Each boundary node
 5561:       NodeBoundary *nodeBnd = node->nodeBnd;
 5562:       
 5563:  
 5564:       // Check if this node has essential BC
 5565:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5566:          // Verify BC value is valid
 5567:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5568: 
 5569:        
 5570:          // Set diagonal to 1 and zero off-diagonals
 5571:          node->coeffDiag = 1.0;
 5572: 
 5573:          for (int j = 0; j < node->numNodes; j++) {
 5574:                node->coeffMatrix[j] = 0.0;
 5575:          }
 5576:          
 5577:          // Set solution and RHS to BC value
 5578:          node->mX  = nodeBnd->elbc;
 5579:          node->qel = nodeBnd->elbc;
 5580: 
 5581:       } else {
 5582:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5583: 
 5584:          for (int j = 0; j < node->numNodes; j++) {
 5585:                Node* nbNode = node->nodes[j];
 5586:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5587:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5588:                   // Verify neighbor's BC value
 5589:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5590: 
 5591:                   // Subtract contribution to RHS
 5592:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5593:                   node->coeffMatrix[j] = 0.0;  
 5594:                }
 5595:          }
 5596:       }
 5597:    }
 5598: 
 5599: 
 5600:    __global__ void updateElevation(void) {
 5601:       NODE(node);
 5602: 
 5603: 
 5604:       node->eta2 = node->mX;
 5605: 
 5606:       node->updateZCoordData();
 5607:    }
