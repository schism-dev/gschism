 4459: //           else             l2 = k;
 4460: //       }
 4461: //       // Now l1 and l2 are adjacent levels and zt is between them
 4462: 
 4463: //       assert(za[l2] - za[l1] > 0.0 && "vertLinearInterp: za[l2] - za[l1] <= 0");
