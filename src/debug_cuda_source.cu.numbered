 8685:          *sizeType = sizeof(double);
 8686:          break;
 8687:       // case (int)VarCode::depth:
 8688:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 8689:       //    *sizeType = sizeof(double);
 8690:       //    break;         
