 6537:    __global__ void computeBottomDragVegetation(void) {
 6538:       // UNFINISHED. CHECK THIS: XXXXX
 6539:       // How many kernels are needed? Why so many for loops?
 6540:       // Is the loop on sides needed?
 6541: 
 6542:       NODE(node);
 6543: 
 6544:       const int    kb      = node->kb;
 6545:       const double htot    = node->htot2(); 
 6546:       
 6547:       if (node->isDry) {
 6548:          // Default values for dry nodes
 6549:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6550:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6551: 
 6552:          return;
 6553:        
 6554:       }
 6555: 
 6556:       // Computes bottom drag Cd based on the selected nchi
 6557:       node->computeBottomDragCd();
 6558:       
 6559: 
 6560: 
 6561:       //   Bottom stress in m^2/s^2
 6562:       if (node->rho[kb + 1] >= -98.0)
 6563:       {
 6564:          const double mag_u = length(node->u2[kb + 1]);
 6565:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6566: 
 6567:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6568:          // !sediment erosion: this part needs more documentation
 6569:       }
 6570:     
 6571: 
 6572: 
 6573:       // Compute vegetation parameters
 6574:       //--------------------------------
 6575: 
 6576: 
 6577:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6578:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6579: 
 6580:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6581:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6582:          int kbin = 0; // bin index
 6583:          for (int k = kb; k < nvrt; k++) {
 6584:             // Computes node height above the bottom level
 6585:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6586:             assert(false && "Vertical variation of vegetation not implemented");
 6587: 
 6588:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6589:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6590:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6591:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6592:             // } else {
 6593:             //    // Find the bin at which the current vertical level is
 6594:             //    while (kbin<nbins_veg_vert) {
 6595:             //       const double zn = node->z[kbin];
 6596:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6597:             //          break;
 6598:             //       } // if
 6599:             //       kbin++;
 6600:             //    } // while
 6601:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6602: 
 6603:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6604:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6605:                
 6606:             //    // Linear interpolation of the vegetation parameters
 6607:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6608:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6609:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6610:             // } // if rl10
 6611: 
 6612:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6613: 
 6614:          } // for k
 6615: 
 6616: 
 6617:       } else { // Ganthy (iveg==2)
 6618:       //  Modify canopy height, diameter, and density
 6619: 
 6620:          // Make sure there is vegetation on this node
 6621:          if (node->veg_h_unbent > 0.0) {
 6622:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6623: 
 6624:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6625:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6626:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6627: 
 6628:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6629:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6630:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6631:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6632:          } // if veg_h_unbent
 6633: 
 6634:          for (int k = 0; k < nvrt; k++) {
 6635:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6636:          } // for k
 6637:       
 6638: 
 6639:       } // if iveg
 6640:      
 6641: 
 6642:       // Compute vertical mean of veg_alpha3D
 6643:       if (iveg != 0) {
 6644:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6645:          double sum1=0.0;
 6646:          double sum2=0.0;
 6647:          // Integrate over each level under the canopy...
 6648:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6649:             const double Dz = node->Dz(k);
 6650: 
 6651:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6652:             sum2 += Dz;
 6653: 
 6654:          } // for k
 6655:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6656:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6657: 
 6658:       } // if iveg
 6659: 
 6660:    }
