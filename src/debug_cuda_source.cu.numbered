  746: 
  747:    __device__ double interpolate(const ShapeCoords &shapeCoords, const ShapeCoords &zAtNodes) const
  748:    {
  749:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  750:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  751:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  752:       
  753:    }
  754: 
  755:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  756: 
  757:    // ------------------------------------------------------------------------------------------------
  758:    // These are functions that work on all nodes of the element.
  759:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  760:    //
  761:    // An example of how to use these functions is:
  762:    //   
  763:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  764:    // 
  765:    // Where L is the level at which the field is to be interpolated. The field can be either
  766:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  767:    // There are different versions of getNodalValues for each of these cases.
  768: 
  769:    template<typename T>
  770:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  771:       // Get the values of the field at the nodes of the element
  772:       res[0] = nodes[0]->*field;
  773:       res[1] = nodes[1]->*field;
  774:       res[2] = nodes[2]->*field;
  775:       if (isQuad()) res[3] = nodes[3]->*field;
  776:       else          res[3] = T();
  777:    }
  778: 
  779:    template<typename T>
  780:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  781:       // Get the values of the field at the nodes of the element
  782:       res[0] = (nodes[0]->*field)[level];
  783:       res[1] = (nodes[1]->*field)[level];
  784:       res[2] = (nodes[2]->*field)[level];
  785:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  786:       else          res[3] = T();
  787:    }    
  788: 
  789:    template<typename T>
  790:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  791:       // Get the values of the func at the nodes of the element
  792:       res[0] = (nodes[0]->*func)(level);
  793:       res[1] = (nodes[1]->*func)(level);
  794:       res[2] = (nodes[2]->*func)(level);
  795:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  796:       else          res[3] = T();  // This is 0.0 or a zero vector
  797: 
  798:    }      
  799: 
  800:    template<typename T>
  801:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  802:       // Get the values of the field at the nodes of the element
  803:       res[0] = sides[0]->*field;
  804:       res[1] = sides[1]->*field;
  805:       res[2] = sides[2]->*field;
  806:       if (isQuad()) res[3] = sides[3]->*field;
  807:       else          res[3] = T();
  808:    }
  809: 
  810:    template<typename T>
  811:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  812:       // Get the values of the field at the nodes of the element
  813:       res[0] = (sides[0]->*field)[level];
  814:       res[1] = (sides[1]->*field)[level];
  815:       res[2] = (sides[2]->*field)[level];
  816:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  817:       else          res[3] = T();
  818:    }    
  819: 
  820:    template<typename T>
  821:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  822:       // Get the values of the func at the nodes of the element
  823:       res[0] = (sides[0]->*func)(level);
  824:       res[1] = (sides[1]->*func)(level);
  825:       res[2] = (sides[2]->*func)(level);
  826:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  827:       else          res[3] = T();  // This is 0.0 or a zero vector
  828: 
  829:    }      
  830: 
  831:    template<typename T>
  832:    __device__ T interpolate(int level, const ShapeCoords shapeCoords, T (Node::*func)(int) const) const {
  833:       T values[4];
  834:       getNodalValues(level, func, values);
  835: 
  836:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  837:    }
  838: 
  839:    template<typename T>
  840:    __device__ T interpolate(const ShapeCoords shapeCoords, T Node::* field) const {
  841:       T values[4];
  842:       getNodalValues(field, values);
  843:       
  844:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  845:    }
  846: 
  847: 
  848:    template<typename T>
  849:    __device__ T interpolate(int level, const ShapeCoords shapeCoords, T (Node::* field)[nvrt]) const {
  850:       T values[4];
  851:       getNodalValues(level, field, values);
  852: 
  853:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  854:    }
  855: 
  856:    template<typename T>
  857:    __device__ T mean(T Node::* field) const {
  858:       T values[4];
  859:       getNodalValues(field, values);
  860: 
  861:       assert(i34 == 4 || values[3] == T() && "mean: values[3] is not zero with i34 == 4");
  862: 
  863:       return (values[0] + values[1] + values[2] + values[3])/i34;
  864:    }
  865: 
  866:    template<typename T>
  867:    __device__ T mean(T Side::* field) const {
  868:       T values[4];
  869:       getSideValues(field, values);
  870:       
  871:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  872: 
  873:       return (values[0] + values[1] + values[2] + values[3])/i34;
  874:    }   
  875: 
  876:    template<typename T>
  877:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  878:       T values[4];
  879:       getNodalValues(level, field, values);
  880: 
  881:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  882: 
  883:       return (values[0] + values[1] + values[2] + values[3])/i34;
  884:    }
  885: 
  886:    template<typename T>
  887:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  888:       T values[4];
  889:       getSideValues(level, field, values);
  890:       
  891:       // assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  892: 
  893:       return (values[0] + values[1] + values[2] + values[3])/i34;
  894:    }   
  895: 
  896:    // __device__ double mean(double (Node::*func)(int) const) const {
  897:    //    double values[4];
  898:    //    getNodalValues(level, func, values);
  899:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  900:    // }
  901:    // ------------------------------------------------------------------------------------------------
  902: 
  903:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  904:       // Convert global coordinates to local coordinates
