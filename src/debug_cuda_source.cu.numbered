 7239: __global__ void printMatrix(void) {
 7240:    // Debugging: print the matrix
 7241: 
 7242:    const int size = mesh->np;
 7243:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7244:       const Node *node = mesh->localNodeData + idx_node;
 7245:       printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7246:       for (int j = 0; j < node->numNodes; j++) {
 7247:          Node* nbNode = node->nodes[j];
 7248:          if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7249:       }
 7250:       printf("]\n");
 7251: 
 7252:    }
 7253: 
 7254: }
 7255: 
 7256: 
 7257: __global__ void returnMatrix(double *res) {
 7258:    // Debugging: returns the matrix as a CuPy array
 7259: 
 7260:    const int size = mesh->np;
 7261:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7262:       const Node *node = mesh->localNodeData + idx_node;
 7263:       res[idx_node*size + idx_node] = node->coeffDiag;
 7264:       for (int j = 0; j < node->numNodes; j++) {
 7265:          Node* nbNode = node->nodes[j];
 7266:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7267:       }
 7268: 
 7269:    }
 7270:    
 7271: }
