 6261: extern "C" {
 6262: 
 6263:    __global__ void scaleGravity(double loadtide_coef) {
 6264: 
 6265: 
 6266:       NODE(node);
 6267: 
 6268:       // SAL option: scale gravity
 6269:       if constexpr(iloadtide==2) {  // simple const
 6270:          node->grav2 = grav*(1.0 - loadtide_coef);
 6271: 
 6272:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6273:         
 6274:           const double depth = max(node->depth, 0.0);
 6275:           const double tmp1 = sqrt(depth);
 6276:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6277:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6278:                              2.6969e-13*depth*depth*depth*tmp1;
 6279:           
 6280:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6281:           
 6282: 
 6283: 
 6284:           node->grav2 = grav*(1.0 - beta_bar);
 6285: 
 6286:       } else {  // iloadtide=0,1
 6287:           node->grav2 = grav;
 6288: 
 6289:       }
 6290: 
 6291:    }
