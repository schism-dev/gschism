 1378: struct BoundarySegment {
 1379: 
 1380:    bool isLand;
 1381: 
 1382:    int idx; // Index of the boundary segment in the input files.
 1383: 
 1384:    double clen;  // Length of the boundary segment
 1385:    double carea; // Area of the boundary segment
 1386: 
 1387:    int ifltype;  // Type of flow boundary condition
 1388:    
 1389:    // Elevation boundary condition
 1390:    int iettype;  // Type of elevation boundary condition
 1391:    double eth;   // Elevation time history
 1392: 
 1393:    // Flow boundary condition
 1394:    double qthcon;  // Flow time history constant
 1395:    double vobc1;   // Velocity coefficient 1
 1396:    double vobc2;   // Velocity coefficient 2
 1397: 
 1398:    // Tracer boundary conditions
 1399:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1400:    // int  itrtype[natrm];    // Tracer boundary condition type
 1401: 
 1402:    BoundarySegment(bool _isLand) {
 1403:       isLand = _isLand;
 1404:       clen = 0.0;
 1405:       carea = 0.0;
 1406:       ifltype = 0;
 1407:       iettype = 0;
 1408:       eth = 0.0;
 1409:    }
 1410: 
 1411:    BoundarySegment(void) {
 1412:       isLand = false;
 1413:       clen = 0.0; 
 1414:       carea = 0.0;
 1415:       ifltype = 0;
 1416:       iettype = 0;
 1417:       eth = 0.0;
 1418:    }
 1419: 
 1420:    
 1421: };
