 1885:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1886:       // Compute the different time ramps used in the code 
 1887:       // This function is performed by just one thread
 1888: 
 1889:       rampbc = 1.0;
 1890:       if constexpr(ibc == 0) {
 1891:          if (drampbc > 0.0) {
 1892:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1893:          } else {
 1894:             rampbc = 1.0;
 1895:          }
 1896:       }
 1897: 
 1898:       if (nws != 0) {
 1899:          if (drampwind > 0.0) {
 1900:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1901:          } else {
 1902:             rampwind = 1.0;
 1903:          }
 1904:       }
 1905: 
 1906:       if (drampwafo > 0.0) {
 1907:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1908:       } else {
 1909:          rampwafo = 1.0;
 1910:       }
 1911: 
 1912:       // For source/sinks
 1913:       if (if_source && dramp_ss > 0.0) {
 1914:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1915:       } else {
 1916:          ramp_ss = 1.0;
 1917:       }
 1918: 
 1919:       if (dramp > 0.0) {
 1920:          ramp = tanh(2.0*time/86400.0/dramp);
 1921:       } else {
 1922:          ramp = 1.0;
 1923:       }
 1924: 
 1925: 
 1926:    }
