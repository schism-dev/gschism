 1590: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1591:    return;
 1592:    // Lock the mutex
 1593:    lock(&debugPlotMutex);
 1594:  
 1595:    bool ok = true;
 1596:    if (debugPlotIdx == nullptr) ok = false;
 1597:    if (*debugPlotIdx >= 10000) ok = false;
 1598:    if (ok) {
 1599:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1600:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1601:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1602:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1603:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1604:       (*debugPlotIdx)++;
 1605:    }
 1606: 
 1607:    __threadfence();               // ensure all above writes are visible
 1608:    // Unlock the mutex
 1609:    unlock(&debugPlotMutex);
 1610: 
 1611: }
 1612: 
 1613: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1614:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1615: }
