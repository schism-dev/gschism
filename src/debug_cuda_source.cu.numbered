 2741: 
 2742: //       const Side& side = sides[i];
 2743: 
 2744: //       xIntersect=-1.e25;
 2745: //       yIntersect=-1.e25;
 2746: 
 2747: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2748: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2749: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2750: 
 2751: //       if (delta != 0.0) {
 2752: //          // Solves the two linear equations for tt1 and tt2
 2753: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2754: //          const double tt2 = delta2/delta;
 2755: 
 2756: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2757: //          // Similarly, we use tt2 to compute the intersection point.
 2758: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2759: //             xIntersect = x3 + (x4 - x3)*tt2;
