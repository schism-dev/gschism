 2983: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2984: // Convert shape coordinates to cartesian coordinates
 2985: 
 2986:    if (isTri()) {
 2987:       // Triangular element
 2988: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 2989:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2990:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2991:    }
 2992:    else {
 2993:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2994:    }
 2995: 
 2996: }
