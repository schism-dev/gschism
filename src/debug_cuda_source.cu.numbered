 2240: 
 2241: 
 2242: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2243: 
 2244:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2245:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2246:    const Node *n1 = side->n1;
 2247:    const Node *n2 = side->n2;
 2248: 
 2249:    bool n1_match = (n1->nodeBnd->segment == segment);
 2250:    bool n2_match = (n2->nodeBnd->segment == segment);
 2251: 
 2252:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2253:    if (n1_match && n2_match) {
 2254:       return 0.5;
 2255:    } else if (n1_match) {
 2256:       return 1.0;
 2257:    } else if (n2_match) {
 2258:       return 0.0;
 2259:    }
 2260:    return 0.0;
 2261: }
 2262: 
 2263: 
 2264: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2265: 
 2266:    const double w1 = getBoundaryArrayValueWeight();
 2267:    const double w2 = 1.0 - w1;
 2268:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2269:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2270: 
 2271:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2272: }
 2273: 
 2274: 
 2275: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2276:    const double w1 = getBoundaryArrayValueWeight();
 2277:    const double w2 = 1.0 - w1;
 2278:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2279:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2280: 
 2281:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2282: }
 2283: 
 2284: 
 2285: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2286:    // Returns the value of the velocity at the side center
 2287:    const double w1 = getBoundaryArrayValueWeight();
 2288:    const double w2 = 1.0 - w1;
 2289:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2290:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2291: 
 2292:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2293: }
 2294: 
 2295: 
 2296: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2297:    // Returns the value of the normal component of the velocity at the side center
 2298:    const double w1 = getBoundaryArrayValueWeight();
 2299:    const double w2 = 1.0 - w1;
 2300:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2301:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2302: 
 2303:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2304: }
