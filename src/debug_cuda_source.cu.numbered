 1837: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1838:    // Computes the 3D normal vector to the element at level k
 1839:    // Returns the normal vector and the area of the element
 1840: 
 1841:       if (isTri()) {
 1842:          // For triangles...
 1843: 
 1844:          // Gets the normal vector to the element (with a length equal to twice the area)
 1845:          if constexpr(ics==1) {
 1846:             const int kb0 = max(k, nodes[0]->kb);
 1847:             const int kb1 = max(k, nodes[1]->kb);
 1848:             const int kb2 = max(k, nodes[2]->kb);
 1849: 
 1850:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1851:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1852:             
 1853:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1854:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1855:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1856:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1857: 
 1858:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1859:             area3D = 0.5*len;
 1860: 
 1861:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1862: 
 1863:             return {nx/len, ny/len, nz/len};
 1864: 
 1865:            
 1866:          }
 1867:          else {  // lat/lon
 1868:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1869:             return {0.0, 0.0, 0.0};
 1870: 
 1871:          } // if ics
 1872:       }
 1873:       else {
 1874:          // For quads...
 1875: 
 1876:          assert(false && "Element normal vector: quads not yet implemented");
 1877:          return {0.0, 0.0, 0.0};
 1878: 
 1879: 
 1880:       }
 1881:    }
 1882: 
 1883: /**
 1884:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1885:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1886:    If the segment is completely inside the element, then it returns true.
 1887: 
 1888:    This function assumes:
 1889:    - The initial point is on a side of the element. 
 1890:    - Its position is given by parameter t in the range [0,1].
 1891:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1892:       intersects the element (elements are convex).
 1893: 
 1894:    To find the intersection point, this function does the following:
 1895:    - it finds the intersection of the line segment with all the element side lines,
 1896:       except for the one that contains the initial point.
 1897:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1898:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1899:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1900:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1901:       track segment is almost parallel to the element side line.
 1902: 
 1903:    Inputs:
 1904:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1905:    @param x2, y2: other end of the line segment
 1906: 
 1907:    Outputs:
 1908:    @param side:  side that intersects the line segment (input and output)
 1909:    @param nextElement (output): element that contains the intersection point
 1910:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1911:    @param zint (input/output): Vertical coordinate of the intersection point
 1912: 
 1913:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1914:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1915:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1916: 
 1917:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1918:    (Delta) being zero.
 1919: 
 1920:    The intersection2 point happens when:
 1921:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1922:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1923:    
 1924:    Assumption: the 4 points (including those of the side segment) are different.
 1925:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1926:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1927:    If true, (xIntersect,yIntersect) is the intersection.				
 1928:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1929: **/
 1930: 
 1931: 
 1932: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1933:                                               double &t, double& tIntersect) {
 1934:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1935:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1936: 
 1937:    double closest_intersect_t = 1e10;
 1938:    bool found_intersection = false;
 1939: 
 1940:    for (int i = 0; i < i34; i++) {
 1941: 
 1942:       Side *side2 = sides[i];
 1943: 
 1944:       // (x3,y3)-(x4,y4) is the element side line
 1945:       const Point2 x3 = side2->n1->p;
 1946:       const Point2 x4 = side2->n2->p;
 1947: 
 1948:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1949:       const double delta = cross(x2 - x1, x3 - x4);
 1950: 
 1951:       if (abs(delta) > 0) {
 1952: 
 1953:          const double delta1 = cross(x3 - x1, x3 - x4);
 1954:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1955: 
 1956:          // Solves the two linear equations for tt1 and tt2
 1957:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1958:          const double tt2 = delta2/delta;
 1959: 
 1960:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1961:             closest_intersect_t = min(closest_intersect_t, tt1);
 1962:             side = side2;
 1963:             nextElement = side->otherElem(this);
 1964:             t =          clamp(tt2, small, 1.0-small);
 1965:             tIntersect = clamp(tt1, small, 1.0-small);
 1966:             found_intersection = true;
 1967:          }
 1968: 
 1969:       
 1970:       }
 1971:       else {  // parallel segments
 1972: 
 1973:          continue; 
 1974:          assert(false && "Parallel segments should not happen under the new code");
 1975:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1976:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1977: 
 1978:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1979:          const double dist = dot(x1 - x3, side2->n);
 1980:          if (abs(dist) < small*length(x3 - x4)) {
 1981:             const double2 unitarySide = normalize(x4 - x3);
 1982:             const double len = dot(x2 - x1, unitarySide);
 1983:             t = t + len;
 1984:             t = max(0.0, min(t, 1.0));
 1985:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1986: 
 1987: 
 1988:             // tIntersect = max(small, min(tt1, 1.0-small));
 1989:             // t = tt2;
 1990:             found_intersection = true;
 1991:          }
 1992:       }
 1993: 
 1994: 
 1995:    }
 1996: 
 1997: 
 1998:    assert(found_intersection && "No intersection found");
 1999: 
 2000:    // found_intersection should always be true, since we checked all the sides.  
 2001:    return found_intersection;
 2002: }
 2003: 
 2004: 
 2005: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2006:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2007: 
 2008:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2009:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2010:    // curElement.
 2011: 
 2012:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2013:    // And uses this velocity instead to continue the tracking.
 2014: 
 2015:    // computes the intersection point in cartesian coordinates
 2016:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2017: 
 2018:    // Nudges the point to the barycenter of the element. 
 2019:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2020:    // next segment intersects the element sides. 
 2021:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2022: 
 2023: 
 2024:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2025:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2026:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2027:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2028: 
 2029:    // If the side is an open boundary, the tangential velocity is set to zero.
 2030:    if (nextSide->isBnd()) vtan = 0.0;
 2031: 
 2032:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2033:    const double us = vtan*nextSide->t().x;
 2034:    const double vs = vtan*nextSide->t().y;
 2035:    const double ws = nextSide->w2(jlev); 
 2036: 
 2037:    u_int = {us, vs, ws};
 2038: 
 2039:    // The end of this tracking segment is now the intersection point.
 2040:    xt = {intersection.x, intersection.y, zint};
 2041:    
 2042: }
 2043: 
 2044: /**
 2045:  * Tracks a particle through elements and vertical levels in the mesh.
 2046:  * 
 2047:  * @param x0,y0,z0     Starting position coordinates
 2048:  * @param xt,yt,zt     Target position coordinates
 2049:  * @param dtb          Time step for tracking
 2050:  * @param u_int        Initial velocity components
 2051:  * @param nextElem     Starting/resulting element index
 2052:  * 
 2053:  * @return Status code of type trackExitCodes
 2054:  * 
 2055:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2056:  * of the details are different. The idea is that the code requires less branches and is better fit
 2057:  * for GPU execution.
 2058:  * 
 2059:  * The main ideas here are:
 2060:  * - The starting point is expected to be in the starting element.
 2061:  * - since the starting point is inside the element, there are only two cases: 
 2062:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2063:  *     (b) it does not and (xt,yt) is already in the starting element.
 2064:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2065:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2066:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2067:  * - tt1 can be positive or negative. We only consider the positive values.
 2068:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2069:  * - The next intersection will occur at the smallest positive tt1.
 2070:  * - This intersection will be the next (x0,y0) position.
 2071:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2072:  *   of getting stuck in a loop.
 2073:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2074:  *   was found.
 2075:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2076:  */
 2077: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2078:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2079:                                                        const Side *origSide) {
 2080:                                                             
 2081:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2082:    // else to do. This means that the full step occurred within the current element.
 2083:    assert(!isDry && "Starting element is dry");
 2084:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2085: 
 2086:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2087: 
 2088:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2089:       assert(!isDry && "Target point is inside a dry element");
 2090: 
 2091:       interpolateVelocities(xt, u_int);
 2092: 
 2093:       nextElem = this;
 2094: 
 2095: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2096:       return true;
 2097:    }
 2098: 
 2099: 
 2100:    
 2101: 
 2102:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2103:    
 2104:    double t;
 2105:    Side *nextSide = nullptr;
 2106:    double tIntersect = 1e10;
 2107: 
 2108: 
 2109:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2110:    // (x0,y0) is inside the element but the target point is not.
 2111:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2112:    assert(found_intersection && "No intersection found at %d");
 2113: 
 2114:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2115: 
 2116:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2117:    if (nextElem != nullptr && !nextElem->isDry) {
 2118:       assert(nextElem->containsPoint(xtmp) && "Intersection point is not inside the next element");
 2119:       nextElem->nudgeToBarycenter(xtmp);
 2120:    }
 2121: 
 2122:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2123:    xt = {xtmp.x, xtmp.y, zint};
 2124: 
 2125:    // if the tracking segment goes out of water (either dry or edge boundary)
 2126:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2127: 
 2128: 
 2129:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2130: 
 2131:       assert(this->containsPoint(toPoint2(xt)) && "Target point is not inside the current element");
 2132:       // When this happens, the backtracking stops.
 2133:       // dt = time_rm;  LLLLLL KKKK XXXX
 2134:       dt *= tIntersect;
 2135: 
 2136:       // In this case, the next element is again the current element.
 2137:       nextElem = this;
 2138: 
 2139: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2140: 
 2141:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2142:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2143:       return true;    
 2144:    }
 2145: 
 2146: 
 2147:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2148:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2149:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2150: 
 2151:    
 2152:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2153: 
 2154:    nextElem->interpolateVelocities(xt, u_int); 
 2155: 
 2156:    assert(nextElem != this && "Next element is the same as the current element");
 2157: 
 2158:    return true;
 2159: }
 2160: 
 2161: 
 2162: __inline__ __device__ double Element::computeSignedArea(void) const {
 2163:    // Compute the area of the element
 2164: 
 2165:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2166: 
 2167:    // In the quad case we need to add the area of the other triangle.
 2168:    if (isQuad()) {
 2169:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2170:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2171:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2172:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2173: 
 2174:       res += ar1;
 2175:    }
 2176: 
 2177:    return res;
 2178: }
 2179: 
 2180: 
 2181: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2182:                                                                 (nodes[1]->isDry2()) ||
 2183:                                                                 (nodes[2]->isDry2()) ||
 2184:                                                                 (i34==4 && nodes[3]->isDry2());
 2185: }
 2186: 
 2187: __inline__ __device__ double Element::detJ_eta(void) const {
 2188:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2189:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2190: }
 2191: 
 2192: __inline__ __device__ double Element::detJ_xi(void) const {
 2193:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2194:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2195: }
 2196: 
 2197: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2198:    // In boundary sides, the element 1 is nullptr
 2199:    return side->elems[1] == nullptr; 
 2200: }
 2201: 
 2202: 
 2203: 
 2204: /**
 2205:    Compute the shape coordinates of the point (xt,yt) in the element.
 2206:    @param xt (input): x-coordinate of the point
 2207:    @param shpCoords (output): shape coordinates of the point
 2208:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2209:    @return true if the point is inside the element, false otherwise
 2210: **/
 2211: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegshpCoord) const {
 2212: 
 2213:    // Compute the shape coordinates of the point xt in the element.
 2214:    if (i34==3) {
 2215:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2216:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2217:       // and in this case, the pt will be nudged into the element
 2218:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2219:       // from the local frame, so use additional check.
 2220: 
 2221:       Point2 x0, x1, x2;
 2222: 
 2223:       if constexpr(ics==1) {
 2224:          x0 = nodes[0]->p;
 2225:          x1 = nodes[1]->p;
 2226:          x2 = nodes[2]->p;
 2227:       }
 2228:       else // lat/lon
 2229:       {
 2230:          Error("Not implemented yet");
 2231:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2232:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2233:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2234:       }
 2235: 
 2236:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2237:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2238:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2239:       shpCoords[3] = 0.0;
 2240: 
 2241:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2242:       const bool res = (tmpmin >= -small);  
 2243:       
 2244:       // If the point is not inside the element, we do not need to fix the negative shape coordinates.
 2245:       fixNegshpCoord = fixNegshpCoord && res;
 2246: 
 2247:       
 2248:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2249:       // then we fix the negative shape coordinates.
 2250:       if ((tmpmin < 0) && fixNegshpCoord) {
 2251: 
 2252:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2253:          // keeping the sum of the shape coordinates equal to 1.
 2254:          // I have tested and compared the new algorithm with the old one, and they give
 2255:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2256:          // The new algorithm should be faster since it is branchless.
 2257:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2258:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2259:          
 2260:          shpCoords[0] = (shpCoords[0] + a)*b;
 2261:          shpCoords[1] = (shpCoords[1] + a)*b;
 2262:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2263: 
 2264:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2265:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2266:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2267:          }
 2268: 
 2269:          // Update the point coordinates for the new shape coordinates
 2270:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2271:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2272:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2273: 
 2274:       }
 2275: 
 2276:       // Check if the point is inside the element
 2277:       return res;      
 2278:    }
 2279:    else {
 2280:       Error("Not implemented yet");
 2281: #ifdef QUADS
 2282:       // Reproject pt in eframe of nel for ics=2
 2283:       if constexpr(ics==1) {
 2284:          xn2 = xt; 
 2285:          yn2 = yt;
 2286:       }
 2287:       else {
 2288:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2289:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2290:       }
 2291: 
 2292:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2293: #endif
 2294:    }
 2295: 
 2296:    assert(false && "computeShapeCoords: should never reach this point");
 2297:    return false;  // Never reached
 2298: 
 2299: }
 2300: 
 2301: 
 2302: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2303: // Convert shape coordinates to cartesian coordinates
 2304: 
 2305:    if (i34 == 3) {
 2306:       // Triangular element
 2307:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2308:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2309:    }
 2310:    else {
 2311:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2312:    }
 2313: 
 2314: }
 2315: 
 2316: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2317:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2318:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2319:    // The formula for the integral is:
 2320:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2321: 
 2322:    printf("intPhiPhi: TEST\n");
 2323: 
 2324:    const Node *n0 = nodes[0];
 2325:    const Node *n1 = nodes[1];
 2326:    const Node *n2 = nodes[2];
 2327:    const Node *n3 = nodes[3];
 2328: 
 2329:    const Vector2 p0 = n0->p;
 2330:    const Vector2 p1 = n1->p;
 2331:    const Vector2 p2 = n2->p;
 2332:    const Vector2 p3 = n3->p;
 2333: 
 2334:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2335:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2336:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2337:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2338: 
 2339:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2340: }
 2341:    
 2342: 
 2343: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2344:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2345:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2346:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2347:    // The formula is also based on the identity:
 2348:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2349:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2350: 
 2351:    printf("intGradPhiGradPhi: TEST\n");   
 2352: 
 2353:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2354: 
 2355:    const double x0 = nodes[0]->p.x;
 2356:    const double y0 = nodes[0]->p.y;
 2357:    const double x1 = nodes[1]->p.x;
 2358:    const double y1 = nodes[1]->p.y;
 2359:    const double x2 = nodes[2]->p.x;
 2360:    const double y2 = nodes[2]->p.y;
 2361:    const double x3 = nodes[3]->p.x;
 2362:    const double y3 = nodes[3]->p.y;
 2363: 
 2364:    double res = 0.0;
 2365:    
 2366:    // Quadrature points in xi and eta coordinates
 2367:    #pragma unroll
 2368:    for (int i = 0; i < 4; i++) {
 2369:       // For each quadrature point...
 2370: 
 2371:       const Point2 p = GaussPoint(i);
 2372:       const double eta = p.x;
 2373:       const double xi  = p.y;
 2374: 
 2375:       // Jacobian entries at the Gauss point p
 2376:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2377:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2378:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2379:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2380: 
 2381:       const double detJ = jacobianDet(p);
 2382:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2383: 
 2384:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2385:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2386:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2387:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2388:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2389: 
 2390:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2391:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2392:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2393:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2394:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2395: 
 2396:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2397:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2398:    }
 2399: 
 2400:    return res;
 2401: }
 2402: 
 2403: 
 2404: /**  Interpolate velocities at a given point (xt,yt,zt)
 2405: 
 2406:    @param xt, yt, zt: coordinates of the point to interpolate
 2407:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2408: 
 2409:    This is done in four steps:
 2410: 
 2411:    1. Find the shape coordinates for the final position in the element.
 2412:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2413:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2414:       z levels at xt, yt at each step.   
 2415:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2416:       horizontally and vertically.
 2417: **/
 2418: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2419:    // Interpolate the velocities at the point xt. 
 2420:    // This function works the same for triangular and quadrilateral elements.
 2421:    double shpCoord[4];
 2422: 
 2423:    // First step is to compute the shape coordinates of (xt,yt)
 2424:    computeShapeCoords(toVector2(xt), shpCoord, true);
 2425: 
 2426:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2427: 
 2428:    // Second step is to find the level that contains zt
 2429:    // Uses a binary search to find the level
 2430:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2431:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2432:    int R = nvrt - 1;
 2433: 
 2434:    // Get the z coordinates at the nodes of the element at the levels L and R
 2435:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2436:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2437:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2438: 
 2439:    double zL = interpolate(shpCoord, zLAtNodes);
 2440:    double zR = interpolate(shpCoord, zRAtNodes);
 2441:    
 2442:    // Interpolates vertically the velocities
 2443:    double wght1, wght2;
 2444:    if (xt.z<=zL) {
 2445:       wght1 = 1.0;
 2446:       wght2 = 0.0;
 2447:       xt.z = zL;
 2448:    }
 2449:    else if (xt.z>=zR) {
 2450:       wght1 = 0.0;
 2451:       wght2 = 1.0;
 2452:       xt.z = zR;
 2453:    }
 2454:    else {
 2455:       // Perform a binary search to find the levels between L and R that contain xt.z
 2456:       while (R - L > 1) {
 2457:          int M = (L + R) / 2.0;
 2458: 
 2459:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2460:          double zM = interpolate(shpCoord, zMAtNodes);
 2461:          if (zM < xt.z) 
 2462:          {
 2463:             L = M;
 2464:             zL = zM;
 2465:          }
 2466:          else 
 2467:          {
 2468:             R = M;
 2469:             zR = zM;
 2470:          }
 2471:       }
 2472:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2473:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2474: 
 2475:       wght2 = (xt.z - zL)/(zR - zL);
 2476:       wght1 = 1.0 - wght2;
 2477: 
 2478:    }
 2479: 
 2480: 
 2481:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2482:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2483: 
 2484:    // Neither of the interpolated velocities should be NaN
 2485:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2486: 
 2487: }
 2488: 
 2489: 
 2490: 
 2491: 
 2492: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2493: 
 2494:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2495:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2496:    const Node *n1 = side->n1;
 2497:    const Node *n2 = side->n2;
 2498: 
 2499:    bool n1_match = (n1->nodeBnd->segment == segment);
 2500:    bool n2_match = (n2->nodeBnd->segment == segment);
 2501: 
 2502:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2503:    if (n1_match && n2_match) {
 2504:       return 0.5;
 2505:    } else if (n1_match) {
 2506:       return 1.0;
 2507:    } else if (n2_match) {
 2508:       return 0.0;
 2509:    }
 2510: 
 2511:    return 0.0;
 2512: }
 2513: 
 2514: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2515: 
 2516: 
 2517: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2518: 
 2519:    const double w1 = getBoundaryArrayValueWeight();
 2520:    const double w2 = 1.0 - w1;
 2521:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2522:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2523: 
 2524:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2525: }
 2526: 
 2527: 
 2528: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2529:    const double w1 = getBoundaryArrayValueWeight();
 2530:    const double w2 = 1.0 - w1;
 2531:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2532:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2533: 
 2534:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2535: 
 2536: }
 2537: 
 2538: 
 2539: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2540:    // Returns the value of the velocity at the side center
 2541:    const double w1 = getBoundaryArrayValueWeight();
 2542:    const double w2 = 1.0 - w1;
 2543:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2544:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2545: 
 2546:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2547: }
 2548: 
 2549: 
 2550: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2551:    // Returns the value of the normal component of the velocity at the side center
 2552:    const double w1 = getBoundaryArrayValueWeight();
 2553:    const double w2 = 1.0 - w1;
 2554:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2555:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2556: 
 2557:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2558: }
