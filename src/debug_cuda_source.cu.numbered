 3810: extern "C" {
 3811: 
 3812:    __global__ void scaleGravity(double loadtide_coef) {
 3813: 
 3814: 
 3815:       NODE(node);
 3816: 
 3817:       // SAL option: scale gravity
 3818:       if constexpr(iloadtide==2) {  // simple const
 3819:          node->grav2 = grav*(1.0 - loadtide_coef);
 3820: 
 3821:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3822:         
 3823:           const double depth = max(node->depth, 0.0);
 3824:           const double tmp1 = sqrt(depth);
 3825:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3826:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3827:                              2.6969e-13*depth*depth*depth*tmp1;
 3828:           
 3829:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3830:           
 3831: 
 3832: 
 3833:           node->grav2 = grav*(1.0 - beta_bar);
 3834: 
 3835:       } else {  // iloadtide=0,1
 3836:         node->grav2=grav;
 3837: 
 3838:       }
 3839: 
 3840:    }
 3841: 
 3842: 
 3843:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3844: 
 3845:       NODE_BND(nodeBnd);
 3846: 
 3847:       Node *node = nodeBnd->node;
 3848: 
 3849:       node->ETP = 0.0;
 3850: 
 3851:       for (int j=0; j<ntip; j++) {
 3852: 
 3853:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3854:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3855:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3856: 
 3857:          if constexpr(iloadtide==1) { // loading tide
 3858:             assert(false && "Loading tide not implemented");
 3859:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3860:          }
 3861:          
 3862:       }
 3863:       
 3864:    }
