 4399: 
 4400: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4401:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4402:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4403: 
 4404: 
 4405:    NODE(node1);
 4406: 
 4407:    node1->clearMatrixRow();
 4408:    node1->qel = 0.0;
 4409: 
 4410:    // THIS IS FOR STRUCTURES XXX
 4411:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4412: 
 4413:    
 4414:    for (int j=0; j<node1->numElements; j++) {
 4415:       // For each element connected to the node...
 4416: 
 4417:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4418: 
 4419:       Element *elem = node1->elements[j];
 4420: 
 4421:       // Compute the average gravity
 4422:       const double grav3 = elem->mean(&Node::grav2);
 4423: 
 4424:       // Look at the documentation for the description of the terms in the following integrals
 4425: 
 4426:       // Integral I_1 
 4427:       // \bar{\breve{H}} 
 4428:       const double hhatb = elem->mean(&Side::hhat);        
 4429: 
 4430:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4431: 
 4432:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4433:       const double area = elem->area;
 4434: 
 4435:       // Integral I_4
 4436:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4437:       // Where
 4438:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4439: 
 4440:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4441:       // of U over the element.
 4442:       const Vector2 U = elem->mean(&Side::U);
 4443: 
 4444:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4445: 
 4446:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4447:       const double I_4_1 = dot(gradPhi_1, U);
 4448: 
 4449: 
 4450:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4451:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4452: 
 4453:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4454: 
 4455: 
 4456:       // Normal component of the bed velocity
 4457:       double ubedNormalComp = 0.0;
 4458:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4459:          Vector3 ubed = {0.0, 0.0, 0.0};
 4460:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4461:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4462: 
 4463:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4464:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4465:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4466: 
 4467:          // Computes the normal component of the bed velocity
 4468:          ubedNormalComp = dot(ubed, N);
 4469:       } // imm==2
 4470: 
 4471:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4472: 
 4473:       if (elem->isTri()) {
 4474: 
 4475:          // To clarify the notation in this section: 
 4476:          //   In formulas, we use the following notation:
 4477:          //       i stands for the node under consideration (node1)
 4478:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4479:          //   However, in the code, we use the following notation:
 4480:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4481:          const int id2 = elem->nxq(1 + id1);
 4482:          const int id3 = elem->nxq(2 + id1);
 4483:          Node *node2 = elem->nodes[id2];
 4484:          Node *node3 = elem->nodes[id3];
 4485: 
 4486:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4487: 
 4488:          // integral of phi_i*phi_j
 4489:          const double ipp_ii = (1.0/6.0 )*area;
 4490:          const double ipp_ij = (1.0/12.0)*area;
 4491:          const double ipp_ik = (1.0/12.0)*area;
 4492: 
 4493:          // integral of [(grad phi_i) * (grad phi_j)]
 4494:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4495:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4496:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4497: 
 4498:          // Computes the different components of integral I_1 of each node with respect to node i.
 4499:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4500:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4501:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4502: 
 4503:          node1->addToSparseMatrix(node1, I1_ii);
 4504:          node1->addToSparseMatrix(node2, I1_ij); 
 4505:          node1->addToSparseMatrix(node3, I1_ik);
 4506: 
 4507:          #pragma unroll
 4508:          for (int l=0; l<3; l++) {
 4509: 
 4510:             Node *node = elem->nodes[l];
 4511: 
 4512:             // Additional variation in eta due to bed deformation or vertical velocity
 4513:             double extraEta = 0.0;
 4514:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4515:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4516: 
 4517: 
 4518:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4519:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4520: 
 4521:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4522: 
 4523:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4524:            
 4525:          }
 4526: 
 4527: 
 4528:          // if (!elem->isDry) {
 4529:          //   const Vector2 gradEta = elem->grad2(&Node::eta2);
 4530: 
 4531:          //   node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4532: 
 4533:          // }
 4534: 
 4535: 
 4536: 
 4537:       }
 4538:       else { // Quad
 4539:          // To clarify the notation in this section: 
 4540:          //   In formulas, we use the following notation:
 4541:          //       i stands for the node under consideration (node1)
 4542:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4543:          //   However, in the code, we use the following notation:
 4544:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4545:          const int id2 = elem->nxq(1 + id1);
 4546:          const int id3 = elem->nxq(2 + id1);
 4547:          const int id4 = elem->nxq(3 + id1);
 4548:          Node *node2 = elem->nodes[id2];
 4549:          Node *node3 = elem->nodes[id3];
 4550:          Node *node4 = elem->nodes[id4];   
 4551:          
 4552:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, id1);
 4553: 
 4554:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4555:          const double ipp_ii = elem->intPhiPhiQuad(0, 0, x0, x1, x2, x3);
 4556:          const double ipp_ij = elem->intPhiPhiQuad(0, 1, x0, x1, x2, x3);
 4557:          const double ipp_ik = elem->intPhiPhiQuad(0, 2, x0, x1, x2, x3);
 4558:          const double ipp_il = elem->intPhiPhiQuad(0, 3, x0, x1, x2, x3);
 4559: 
 4560:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4561:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(0, 0, x0, x1, x2, x3);
 4562:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(0, 1, x0, x1, x2, x3);
 4563:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(0, 2, x0, x1, x2, x3);
 4564:          const double igpgp_il = elem->intGradPhiGradPhiQuad(0, 3, x0, x1, x2, x3);
 4565: 
 4566:          // Computes the different components of integral I_1 of each node with respect to node i.
 4567:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4568:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4569:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4570:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4571: 
 4572:          node1->addToSparseMatrix(node1, I1_ii);
 4573:          node1->addToSparseMatrix(node2, I1_ij); 
 4574:          node1->addToSparseMatrix(node3, I1_ik);
 4575:          node1->addToSparseMatrix(node4, I1_il);
 4576:   
 4577:          #pragma unroll
 4578:          for (int l=0; l<4; l++) {
 4579: 
 4580:             const Node *node = elem->nodes[l];
 4581: 
 4582:             // Additional variation in eta due to bed deformation or vertical velocity
 4583:             double extraEta = 0.0;
 4584:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4585:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4586: 
 4587:             const double ipp = elem->intPhiPhiQuad(l, j, x0, x1, x2, x3);
 4588:             const double igpgp = elem->intGradPhiGradPhiQuad(l, j, x0, x1, x2, x3);
 4589:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4590: 
 4591:          }         
 4592:       } 
 4593: 
 4594: 
 4595:      node1->qel += (dt/elem->i34)*elem->vsource;
 4596:       
 4597: 
 4598:    } // for all elements connected to the node
 4599:    
 4600: 
 4601:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4602:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4603:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4604:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4605:       // If it is an open boundary node...
 4606: 
 4607:       // At least one open bnd side, maybe two
 4608:       for (int l=0; l<2; l++) { 
 4609: 
 4610:          // Gets each of the sides sharing the node. 
 4611:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4612: 
 4613:        
 4614: 
 4615:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4616:          if (sideBnd != nullptr) {
 4617:             // If the side is on a boundary...
 4618: 
 4619:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4620: 
 4621:             // Get the boundary segment
 4622:             const BoundarySegment *sideSegment = sideBnd->segment;
 4623:             const Side *side = sideBnd->side;
 4624: 
 4625:             // Integral I_3
 4626:             if (sideSegment->ifltype != 0) {
 4627:             // Natural or Flather b.c.
 4628: 
 4629:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4630:                // especially for Flather b.c.
 4631:                double ri3 = 0.0;
 4632:                if (!side->isDry) {
 4633:                   // If the side is not dry
 4634:                   
 4635:                   // Computes the side flux of (uth, vth)
 4636:                   double Vn = 0.0;
 4637:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4638:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4639:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4640: 
 4641:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4642:                   }
 4643: 
 4644:                   ri3 = 0.5*side->len*Vn;
 4645:                }
 4646: 
 4647:                if (sideSegment->ifltype == -1) { // Flather 1
 4648: 
 4649:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4650:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4651: 
 4652:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4653:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4654:                   
 4655:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4656:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4657: 
 4658:                } 
 4659:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4660:                   // Reset ri3
 4661:                   ri3 = 0.0;
 4662: 
 4663:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4664:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4665: 
 4666:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4667: 
 4668:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4669:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4670: 
 4671:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4672:                   node1->addToSparseMatrix(node1, con0*2.0);
 4673:                   node1->addToSparseMatrix(node2, con0);
 4674: 
 4675:                } // if Flather or Discharge
 4676: 
 4677:                node1->qel -= thetai*dt*ri3;  
 4678: 
 4679: 
 4680:             } // I_3
 4681:           
 4682: 
 4683:             // Integral I_5
 4684:             if(!side->isDry) {
 4685: 
 4686:                const double Unbar = dot(side->U, side->n);
 4687:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4688: 
 4689:             } // I_5
 4690: 
 4691:          } // if is boundary side
 4692: 
 4693:       } // for l
 4694: 
 4695:    } // if isbnd
 4696: 
 4697: 
 4698: }
 4699: 
 4700: 
 4701: 
 4702: extern "C" {
 4703:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4704:                                   int* indices, int* indptr) {
 4705: 
 4706:       NODE(node);
 4707:       
 4708:       const int idx = node->idx;
 4709:       
 4710:       // Computes the index in the nzz array      
 4711:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4712: 
 4713: 
 4714:       indptr[idx] = nzzIdx;
 4715:       indices[nzzIdx] = idx;
 4716: 
 4717:       data_d[nzzIdx]    = node->coeffDiag;
 4718: 
 4719:       b_d[idx] = node->qel;
 4720: 
 4721:       for (int k = 0; k < node->numNodes; ++k) {
 4722:          const Node* nb = node->nodes[k];
 4723: 
 4724:          const int j = nb->idx;
 4725: 
 4726:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4727: 
 4728:          indices[nzzIdx + k + 1] = j;
 4729:       }
 4730: 
 4731:  
 4732:    }
 4733: 
 4734: 
 4735: 
 4736:    __global__ void solverCopyResult(double* x) {
 4737:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4738:       NODE(node);
 4739:       const int idx = node->idx;
 4740: 
 4741:       node->mX = x[idx];
 4742:    }
 4743: 
 4744: 
 4745:    __global__ void rollUpElevation(void) {
 4746: 
 4747:       NODE(node);
 4748: 
 4749:       node->eta1 = node->eta2;
 4750: 
 4751:    }
 4752: 
 4753: 
 4754:    __global__ void backtrackAllNodes(void) {
 4755: 
 4756:       // max/min # of sub-divisions
 4757:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4758:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4759: 
 4760:       SIDE(side);
 4761: 
 4762:       const int kb = side->kb;
 4763: 
 4764: 
 4765:       // Initialize btrack velocities to the actual velocities at the side 
 4766:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4767:   
 4768:       if (side->isDry) return;
 4769:      
 4770: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4771: 
 4772:       // Checks that at least one element is not dry
 4773:       const Element *elem1 = side->elems[0];
 4774:       const Element *elem2 = side->elems[1];
 4775: 
 4776: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4777: 
 4778:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4779:       
 4780:       // XXXXXX
 4781:       // !swild_tmp to store global coord. of the starting side
 4782:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4783:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4784:       // !Use sframe2 
 4785:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4786: 
 4787: 
 4788:       for (int k = kb; k < nvrt; k++) {
 4789:       //  Initialize (xt,yt,zt), nnel and vel.
 4790:       //  For ics=2, the coordinates are all in the side's local frame
 4791:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4792: 
 4793:          const int iadvf = side->iadv();  // Advection flag   
 4794:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4795: 
 4796:          const double vmag2 = norm2(side->u2[k]);
 4797: 
 4798:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4799:             // No activity 
 4800: 
 4801:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4802: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4803: 
 4804:             
 4805:          } else {  // do btrack
 4806: 
 4807:             // Compute number of sub-divisions based on local gradients of the velocity field
 4808: 
 4809:             // XXX IS THIS NECESSARY?
 4810:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4811:             double suma = 0.0;
 4812:             int icount = 0;
 4813:             for (int l=0; l<2; l++) {
 4814:             // For each element sharing the side...
 4815: 
 4816:                const Element *elem = side->elems[l];
 4817:                  
 4818:                if (elem == nullptr) continue;
 4819: 
 4820:                icount++;
 4821: 
 4822:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4823:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4824:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4825: 
 4826:                double utmp[4];
 4827:                double vtmp[4];
 4828:                for (int j = 0; j < elem->i34; j++) {
 4829: 
 4830:                   const Node *node = elem->nodes[j];
 4831: 
 4832:                   if constexpr(ics==1) {
 4833:                      utmp[j] = node->u2[k].x;
 4834:                      vtmp[j] = node->u2[k].y;  
 4835: 
 4836:                   } else {
 4837:                      // 'Project' the velocity from the node frame to the element frame
 4838:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4839:                      utmp[j] = tmp_u2.x;
 4840:                      vtmp[j] = tmp_u2.y;
 4841: 
 4842:                   }
 4843:                } // for j
 4844: 
 4845:                const Vector2 grad_u = elem->grad2(utmp); 
 4846:                const Vector2 grad_v = elem->grad2(vtmp);
 4847:    
 4848:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4849:             } // for ii
 4850: 
 4851:             assert(icount > 0 && "Impossible 77");
 4852: 
 4853:             // '4' is somewhat arbitrary
 4854:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4855: 
 4856:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4857:             Vector3 u_int = {0.0, 0.0, 0.0};
 4858: 
 4859:             side->btrack(k, dt, dtbk, u_int);
 4860: 
 4861: 
 4862:             side->btu[k] = {u_int.x, u_int.y};
 4863:                
 4864:          } // if vmag (do backtrack)
 4865: 
 4866: 
 4867:       } // for k=kb,nvrt-1
 4868: 
 4869:    }
 4870: 
 4871: } // extern "C"
 4872: 
 4873: template<int nc>
 4874: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4875: 
 4876: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4877: //
 4878: // a,b,c,rhs: input vectors and are not modified by this program.
 4879: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4880: // rhs is the r.h.s.
 4881: // n: actual rank of the system.
 4882: // rows in u() and rhs();
 4883: // u: output with nc columns (transposed to rows)
 4884: // gam: a working array.
 4885: //
 4886: // NOTES:
 4887: // This is a template function that allows for different numbers of columns in the rhs vector.
 4888: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4889: 
 4890:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4891:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4892: 
 4893:    double bet = b[0];
 4894:    if constexpr (nc == 1) {
 4895:       u[0] = rhs[0]/bet;
 4896:    } else {
 4897:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4898:    }
 4899: 
 4900:    for (int j = 1; j < n; j++) {
 4901:       gam[j] = c[j - 1]/bet;
 4902:       bet = b[j] - a[j]*gam[j];
 4903: 
 4904:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4905: 
 4906:       if constexpr (nc == 1) {
 4907:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4908:       } else {
 4909:          for (int l = 0; l < nc; l++) {
 4910:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4911:          }
 4912:       }
 4913:    }
 4914: 
 4915:    // Back-substitution
 4916:    for (int j = n - 2; j >= 0; j--) {
 4917:       if constexpr (nc == 1) {
 4918:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4919:       } else {
 4920:          for (int l = 0; l < nc; l++) {
 4921:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4922:          }
 4923:       }
 4924:    }
 4925: }
 4926: 
 4927: 
 4928: 
 4929: // Helper function that contains the core algorithm
 4930: template<typename XAccessor, typename YAccessor>
 4931: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4932:                                     double  yp_top, double  yp_bot, 
 4933:                                     CubicSpline &spline) {
 4934:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4935:    // 
 4936:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4937:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4938:    //
 4939:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4940:    // 
 4941:    // Inputs: 
 4942:    //            n: dimension for x etc; # of data pts (>=2);
 4943:    //            getX, getY: functions to access x,y coordinates
 4944:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4945:    //     Output: 
 4946:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4947: 
 4948:    const int n = k2 - k1 + 1;
 4949:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4950: 
 4951:    // Allocate memory for the splines
 4952:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4953:    spline.x   = new double[n];
 4954:    spline.y   = new double[n];
 4955:    spline.yp  = new double[n];
 4956:    spline.ypp = new double[n];
 4957: 
 4958:    for (int k=k1; k<=k2; k++) {
 4959:       spline.x[k] = getX(k);
 4960:       spline.y[k] = getY(k);
 4961:    }
 4962: 
 4963:    // This is to simplify expressions later
 4964:    double *x = spline.x;
 4965:    double *y = spline.y;
 4966: 
 4967:    double *a = nullptr;
 4968:    double *b = nullptr;
 4969:    double *c = nullptr;
 4970:    double *gam = nullptr;
 4971:    double *rhs = nullptr;
 4972:    
 4973: 
 4974:       a = new double[n];   // Lower diagonal
 4975:       b = new double[n];   // Diagonal
 4976:       c = new double[n];   // Upper diagonal
 4977:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4978:       rhs = new double[n]; // Right-hand side
 4979: 
 4980:    for (int k=k1; k<=k2; k++) {
 4981:       if (k == k1) {
 4982:          // Bottom level
 4983:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4984:          b[k] = (x[k+1] - x[k])/3.0;
 4985:          c[k] = b[k]/2.0;
 4986:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4987:       } else if (k == n - 1) {
 4988:          // Top level (surface)
 4989:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4990:          b[k] = (x[k] - x[k-1])/3.0;
 4991:          a[k] = b[k]/2.0;
 4992:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4993:       } else {
 4994:          // Intermediate levels
 4995:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4996:          b[k] = (x[k+1] - x[k-1])/3.0;
 4997:          a[k] = (x[k  ] - x[k-1])/6.0;
 4998:          c[k] = (x[k+1] - x[k  ])/6.0;
 4999:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5000:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5001:       }
 5002:    }
 5003: 
 5004:    // Solve the tridiagonal system
 5005:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5006:    
 5007:    spline.yp[k1] = yp_bot;
 5008:    spline.yp[k2] = yp_top;
 5009: 
 5010:    // Compute rest of 1st derivatives using the splines
 5011:    for (int k=k1+1; k<k2; k++) {
 5012:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5013:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5014:    }
 5015:    
 5016:    delete[] a;
 5017:    delete[] b;
 5018:    delete[] c;
 5019:    delete[] gam;
 5020:    delete[] rhs;
 5021: 
 5022: }
 5023: 
 5024: // Array version
 5025: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5026:                                 double y_top, double y_bot, 
 5027:                                 CubicSpline &spline) {
 5028:    auto getX = [x] (int k) { return x[k]; };
 5029:    auto getY = [y] (int k) { return y[k]; };
 5030:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5031: }
 5032: 
 5033: // Lambda version - allows custom access patterns
 5034: template<typename XFunc, typename YFunc>
 5035: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5036:                                 double y_top, double y_bot,
 5037:                                 CubicSpline &spline) {
 5038:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5039: }
