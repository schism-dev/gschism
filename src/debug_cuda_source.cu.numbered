 3567: 
 3568: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3569:    if constexpr(ics == 1) {
 3570:       return center;
 3571: 
 3572:    } else {
 3573:       const Point2 p0 = n1->outputCoords();
 3574:       const Point2 p1 = n2->outputCoords();
 3575:       return (1.0/2.0)*(p0 + p1);
 3576: 
 3577:    }
 3578: }
 3579: 
 3580: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3581: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3582: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3583: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3584: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3585: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3586: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3587: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3588: // Computes the gradient of the field at the side center.
 3589:    Vector2 grad = {0.0, 0.0};
 3590:    int count = 0;
 3591: 
 3592:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3593:    // as the average of the gradients at each element.
 3594:    // First element
 3595:    if (elems[0] != nullptr && condition(elems[0])) {
 3596:       Vector2 elemGrad = elems[0]->grad2(field);
 3597: 
 3598:       // For ics=2, projects the element gradient from its frame to the side frame
 3599:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3600: 
 3601:       grad += elemGrad;
 3602: 
 3603:       count++;
 3604:    }
 3605: 
 3606:    // Second element
 3607:    if (elems[1] != nullptr && condition(elems[1])) {
 3608: 
 3609:       Vector2 elemGrad = elems[1]->grad2(field);
 3610: 
 3611:       // For ics=2, projects the element gradient from its frame to the side frame
 3612:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3613: 
 3614:       grad += elemGrad;
 3615: 
 3616:       count++;
 3617:    }
 3618: 
 3619:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3620:    if (count > 0) {
 3621:       grad = grad*(1.0/count);
 3622:    }
 3623:    
 3624:    return grad;
 3625: }
 3626: 
 3627: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3628: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3629: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3630: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3631: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3632: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3633: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3634: 
 3635: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3636: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3637: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3638: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3639: 
 3640: 
 3641: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3642: 
 3643: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3644:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3645:    if constexpr(ics == 1) { 
 3646:       return 0.5*(n1->tau + n2->tau);
 3647: 
 3648:    } else {
 3649:       // Project the tau from the node frames to the side frame
 3650:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3651:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3652: 
 3653:       return 0.5*(stau1 + stau2);
 3654:    }
 3655: }
 3656: 
 3657: /**
 3658:  * This method performs backtracking from the side center until a time -dt back in time 
 3659:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3660:  * intermediate point.
 3661:  *
 3662:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3663:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3664:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3665:  * remaining time.
 3666:  * 
 3667:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3668:  * 
 3669:  * @param uuint, vvint, wwint: Velocities at the final point
 3670:  * @param jlev: Level at which the backtracking is performed
 3671:  * @param dt, dtbk: Tracking timesteps
 3672:   */
 3673: __inline__ __device__ void Side::btrack(
 3674:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3675:       double dt,            // Tracking time
 3676:       double dtbk,          // Tracking timestep
 3677:       Vector3 &u_int        // Velocities at the initial point
 3678: ) const {
 3679: 
 3680:    // Start from side center
 3681:    Point3 x0;
 3682: 
 3683:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3684:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3685: 
 3686:  
 3687:    double time_rm = dt; // Remaining time
 3688:    double time_rm_1 = 1e10;
 3689:    double time_rm_2 = 2e10;
 3690:    double time_rm_3 = 3e10;
 3691: 
 3692: 
 3693:    // Initial velocities
 3694:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3695: 
 3696:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3697:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3698: 
 3699:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3700: 
 3701: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3702: 
 3703: 
 3704:    constexpr int MAX_ITERATIONS = 100; 
 3705:    int iter = 0;
 3706:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3707:    while(true) {
 3708: 
 3709:       // Calculate timestep
 3710:       const double dtb = min(dtbk, time_rm);
 3711: 
 3712:       // Next point in the backtracking curve
 3713:       xt = x0 - dtb*u_int;
 3714: 
 3715:       double t, s; // parameters for the line segments p0pt and p1p2
 3716:       Side *lastCrossSide = nullptr;
 3717:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3718: 
 3719: 
 3720:       if (time_rm_3 <= time_rm) {
 3721:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3722:          xt = x0;
 3723:          break;
 3724:       }
 3725: 
 3726: 
 3727:       if (!found) {
 3728:       // This means that the walk reached a boundary or a dry element.
 3729: 
 3730:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3731: 
 3732:          // Finds the point at the boundary where the line segment x0xt intersects.
 3733:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3734:          // due to floating point errors, it does not exactly intersect.
 3735:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3736:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3737:          // To compute the intersection point we start with the parametric equations.
 3738:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3739:          // We cross-prouct by v1 to cancel the s term:
 3740:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3741:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3742: 
 3743:          // Side coordinates in the origSide frame.
 3744:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3745:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3746: 
 3747:          Point2  p0 = {x0.x, x0.y};
 3748:          Point2  pt = {xt.x, xt.y};
 3749: 
 3750:          const Vector2 v1 = pt - p0;
 3751:          const Vector2 v2 = p2 - p1;
 3752: 
 3753: 
 3754: 
 3755:          // We are assuming intersection, so we clamp t to the range [0,1].
 3756:          const double denom = cross(v2, v1);
 3757:          
 3758: 
 3759: 
 3760: 
 3761:          if (abs(denom) < small) {
 3762:             // small denominators are fairly common. They occur when the line segment x0xt 
 3763:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3764:             // boundary, where the backtracking curve startt sliding along the boundary.
 3765:             // In this case, we simply assume that the two lines are very close to each other
 3766:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3767:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3768:             if (t<0.0000000001) t = 0.0;
 3769:             if (t>0.9999999999) t = 1.0;
 3770: 
 3771:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3772:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3773: 
 3774:          }
 3775:          else {
 3776:             
 3777:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3778:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3779:             if (t>0.9999999999) t = 1.0;
 3780:             // From the originaL equation we can solve for s:
 3781:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3782:             // Computing the dot product by v1, we get:
 3783:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3784:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3785:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3786: 
 3787:          }
 3788: 
 3789:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3790: 
 3791: 
 3792:          // We update the new target point to be right at the intersection point,
 3793:          // and the remaining time must include the time we haven't "used".
 3794:          time_rm -= s*dtb;
 3795:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3796: 
 3797: 
 3798:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3799:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3800: 
 3801:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3802:          // but extracting only the component along the tangent vector v2.
 3803:          Vector2 tangent = normalize(v2);
 3804:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3805: 
 3806:          const Vector2 u2D = make_double2(u.x, u.y);
 3807:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3808: 
 3809: 
 3810:       } else {
 3811: 
 3812:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3813: 
 3814:          time_rm -= dtb; 
 3815: 
 3816:          u_int = curElem->interpolateVelocities(xt, this);
 3817: 
 3818:       }
 3819: 
 3820:       if (time_rm <= 0.0) break; 
 3821: 
 3822:       // If the velocity is too small, we stop the backtracking
 3823:       const double vmag2 = norm2(toVector2(u_int));
 3824:       if (vmag2 <= velmin_btrack_sq)  {
 3825:          time_rm = 0.0; 
 3826:          return; 
 3827:       }
 3828: 
 3829:       // The current point becomes the next segment's starting point.
 3830:       x0 = xt;
 3831:  
 3832:       iter++;
 3833: 
 3834: // XXXXXXXXXXXXXXXXX
 3835: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3836:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3837: 
 3838:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3839:       time_rm_3 = time_rm_2;
 3840:       time_rm_2 = time_rm_1;
 3841:       time_rm_1 = time_rm;
 3842:    }
 3843: 
 3844:    assert(curElem != nullptr && "Final element is nullptr");
 3845:    assert(!curElem->isDry && "Final element is dry");
 3846:    
 3847: 
 3848: 
 3849:    // Interpolate the velocities at the final point with respect to the current side frame
 3850:    u_int = curElem->interpolateVelocities(xt, this);
 3851: 
 3852: 
 3853: }
 3854: 
 3855: 
