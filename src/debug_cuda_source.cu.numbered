 6848: #ifdef DONTCOMPILE
 6849: __device__ void computeVerticalAdvection(void) {
 6850:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6851: 
 6852:    sdbt(1:2,:,:)=0.d0
 6853: 
 6854:    const Side *side = FROM kernel;
 6855: 
 6856:    if(side->isDry) return;
 6857: 
 6858:    // If side is wet...
 6859: 
 6860: 
 6861:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6862:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6863:    double ws[nvrt] = {} // w @ side
 6864:    int icount = 0;
 6865:    for (int j=0; j<2; j++) {
 6866:       const Element *elem = side->elements[j];
 6867:        
 6868:       if(elem != nullptr) {
 6869:          icount++;
 6870:          for (int k=0; k<nvrt; k++) {
 6871:             ws[k] = ws[k] + elem->w[k];
 6872:          }
 6873:       }
 6874:    }  // for j
 6875: 
 6876:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6877:    ws = ws/icount;
 6878: 
 6879:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6880:    // Splines allow for a smooth transition between vertical levels.
 6881:    // Splines have continuity restrictions at the internal knots, but
 6882:    // we have to provide the 1st derivatives at the endpoints.
 6883:    const int kbs = side->kbs; 
 6884:    
 6885:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6886:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6887:    initCubicSpline(kbs, nvrt, side, ws, up)
 6888: 
 6889:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6890:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6891:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6892: 
 6893:    // Total advection (average onto side)
 6894:    const Node *node1 = side->nodes[0];
 6895:    const Node *node2 = side->nodes[1];
 6896:    for (int k=kbs(i); k<nvrt; k++) {
 6897: 
 6898:       if constexpr(ics==1) {
 6899:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6900:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6901:       } else {
 6902:          // XXX IMPLEMENT THIS
 6903:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6904:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6905:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6906:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6907:       }  // if ics
 6908: 
 6909: 
 6910:    }
 6911: }
 6912: #endif
 6913: 
 6914: 
 6915: extern "C" {
 6916:    __global__ void computeElemAverageGhat(void) {
 6917:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6918: 
 6919:       ELEM(elem);
 6920:       
 6921:       elem->ghat1= {0.0, 0.0};  
 6922: 
 6923:       if constexpr(ihydraulics != 0) {
 6924:          if (nhtblocks > 0 && elem->isblock) return;
 6925:       }
 6926: 
 6927:       if (elem->isDry) return;
 6928: 
 6929:       // Wet elements.
 6930:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6931:       // tidal potential, horizontal diffusion, and baroclinic etc
 6932:       // Remember to update both fb and F 
 6933:       // If ics=2, ghat1 are in eframe (ll)
 6934:       // cff1-3: coefficients for 2D/3D
 6935:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6936:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6937:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6938: 
 6939:       double av_cff1 = 0.0;  // av. for cff1
 6940:       double av_cff2 = 0.0;  // av. for cff2
 6941:       double av_cff3 = 0.0;  // av. for cff3
 6942:       double av_df = 0.0;  // av. for H^\alpha / H
 6943:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6944:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6945: 
 6946:       const int i34 = elem->i34;
 6947:       const int kb = elem->kb;
 6948: 
 6949:       for (int j=0; j<i34; j++) {
 6950:          // For each node and side in the element...
 6951: 
 6952:          const Node *node = elem->nodes[j];
 6953:          const Side *side = elem->sides[j];
 6954: 
 6955:          const double chi      = side->chi;
 6956:          const double veg_c2   = side->veg_c2;
 6957:          const double veg_beta = side->veg_beta;
 6958:          const double veg_h    = side->veg_h();
 6959:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6960: 
 6961:          // Node - const in elem
 6962:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6963:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6964: 
 6965:          if (elem->depth >= tip_dp) {
 6966:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6967:          }
 6968: 
 6969:          
 6970:          const double htot  = side->htot2();        // Total depth at the side
 6971:          const double zctr2 = side->zTopCanopy();  
 6972: 
 6973:          double cff1; 
 6974:          double cff2; 
 6975:          double cff3;   
 6976:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6977:          // coefficients applied to 2D/3D case 
 6978:             cff1 = side->hhat/htot;
 6979:             cff2 = 0.0;
 6980:             cff3 = 0.0;
 6981:          } else { //3D
 6982:             //Init for no-veg case
 6983:             cff1 = 1.0;
 6984:             cff2 = 1.0;
 6985:             cff3 = 0.0;
 6986: 
 6987:             if constexpr(iveg != 0) {
 6988:                // Computes coefficients used with vegetation terms G1, G2
 6989:                // cff1, cff3 are used for the first two terms in G1, G2:
 6990:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6991:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6992:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6993:                if(veg_h < 0.99*htot) { // submergent vegetation
 6994:                   cff1=1;
 6995:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6996:                   cff3 = veg_c;
 6997: 
 6998:                } else { // emergent vegetation
 6999:                   cff1 = 1.0/(1.0 + veg_c2);
 7000:                   cff2 = cff1;
 7001:                   cff3 = 0.0;
 7002: 
 7003:                }
 7004:             } // if iveg
 7005:          } //  2D/3D
 7006: 
 7007:          av_cff1 += cff1/i34;
 7008:          av_cff2 += cff2/i34;
 7009:          av_cff3 += cff3/i34;
 7010:          av_cff2_chi += cff2*chi/i34;
 7011:          av_cff3_chi += cff3*chi/i34;
 7012:          av_df += min(htot, veg_h)/(htot*i34);
 7013: 
 7014: 
 7015:          // btrack values: U^\star, U^{\star\alpha}
 7016:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7017:          Vector2 Ustar       = {0.0, 0.0}; 
 7018:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7019: 
 7020:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7021:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7022:          } else { //3D
 7023:             for (int k = side->kb; k < nvrt; k++) {
 7024:             
 7025:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7026:                Ustar += w2;
 7027: 
 7028:                if constexpr(iveg != 0) {
 7029:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7030:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7031:                        Ustar_alpha += zrat*w2; // XXXX
 7032:                    }
 7033:                }  // if iveg
 7034:             }  // for k
 7035:          }  //2D/3D
 7036:          
 7037: 
 7038:          // Add btrack & surface stress terms to \breve{G} first
 7039:          if constexpr(ics==1) {
 7040: 
 7041:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7042: 
 7043:          } else {
 7044:             // XXX IMPLEMENT THIS
 7045:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7046:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7047:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7048:          }  // if ics
 7049: 
 7050:          // Surface and bottom stress terms
 7051:          if constexpr(ics==1) {
 7052:             const Vector2 tau    = side->tau();
 7053:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7054: 
 7055:             // Term for surface and bottom stress
 7056:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7057: 
 7058:          } else {
 7059:             assert(false && "computeElemAverageGhat: Not implemented");
 7060:             // XXX IMPLEMENT THIS
 7061:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7062:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7063:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7064:             // tau_x=(vn1+tt1)/2.d0
 7065:             // tau_y=(vn2+ss1)/2.d0
 7066:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7067:          }  // if ics
 7068: 
 7069:          
 7070: 
 7071:          // All terms in F,F^\alpha,f_b except baroclinic
 7072:          // F, f_b: all explicit terms excluding vegetation 
 7073:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7074:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7075:          const double coriolis = side->coriolis;
 7076:          Vector2 F  =  coriolis*side->U;  // F_x
 7077:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7078:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7079: 
 7080:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7081:             
 7082:             for (int k = side->kb; k < nvrt; k++) {
 7083:                if (zctr2 > side->zc[k-1]) {
 7084:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7085:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7086:                    Fa +=  coriolis*w2*zrat;
 7087:                } // if zctr2
 7088:             } // k
 7089:          } // iveg
 7090: 
 7091:          // Integrate horizontal viscosity force vertically
 7092:          for (int k=side->kb + 1; k<nvrt; k++) {
 7093:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7094: 
 7095:             F += levelHorVisc;
 7096: 
 7097:             // Vegetation term
 7098:             if constexpr(iveg!=0) {
 7099:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7100:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7101:                   Fa += levelHorVisc*zrat;
 7102:                } 
 7103:             } // if iveg
 7104:          } // for k
 7105: 
 7106:          fb += side->nuGradU[side->kb];
 7107: 
 7108:          // Add to ghat1
 7109:          if constexpr(ics==2) {
 7110:             // XXX IMPLEMENT THIS
 7111:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7112:             // bigf1=vn1; bigf2=vn2
 7113:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7114:             // botf1=vn1; botf2=vn2
 7115:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7116:             // bigfa1=vn1; bigfa2=vn2
 7117:          } // if ics
 7118: 
 7119:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7120:       } // for j (nodes and sides)
 7121: 
 7122:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7123:          
 7124:       // Finish off terms in F, F^\alpha and f_b
 7125:       const double grav3 = elem->mean(&Node::grav2);
 7126:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7127: 
 7128: 
 7129:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7130:       for (int j=1; j<i34; j++) { 
 7131:          // For each side in the element...
 7132:          const Side *side = elem->sides[j];
 7133:          const double chi = side->chi;
 7134: 
 7135:          const double htot = side->htot2();
 7136:          const double veg_h = side->veg_h();
 7137:          const Vector2 F  = htot*fb;
 7138:          const Vector2 Fa = min(htot, veg_h)*fb;
 7139: 
 7140:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7141:       } // for j
 7142: 
 7143:       //botf1 etc are already in elem frame
 7144:       elem->ghat1 += tmp/i34;
 7145: 
 7146:       // Baroclinic force
 7147:       if constexpr(ibc==0) {
 7148:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7149: 
 7150:          Vector2 Fa = {0.0, 0.0};
 7151:          Vector2 intGradRho = {0.0, 0.0};
 7152:          
 7153:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7154:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7155:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7156: 
 7157:             // \in F [m^2/s/s]
 7158:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7159:          }
 7160: 
 7161:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7162:          const Vector2 F = av_df*Fa; //approx
 7163:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7164: 
 7165:       } // if ibc
 7166: 
 7167: 
 7168: 
 7169:    }
 7170: 
 7171: } // extern "C"
 7172: 
 7173: 
 7174: 
 7175: #ifdef DONTCOMPILE
 7176: __global__ void checkMassConservation(Tracers* sumtr) {
 7177: 
 7178:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7179: 
 7180:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7181: 
 7182:    Element *elem = &(mesh->localElemData[i]);
 7183: 
 7184:    // Skip dry elements
 7185:    if (elem->isDry) return;
 7186: 
 7187:    // Local sum array for this thread
 7188:    double localSum[N_TRACERS] = {0.0};
 7189: 
 7190:    // Sum over vertical levels for this element
 7191:    const int kbe = elem->kbe;
 7192:    const double area = elem->area;
 7193: 
 7194:    for (int k = kbe; k < nvrt; k++) {
 7195:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7196:       
 7197:       // Accumulate tracer mass
 7198:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7199:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7200:       }
 7201:    }
 7202: 
 7203:    //  This function returns per element sums. A reduction must be done on the host side.
 7204: }
 7205: 
 7206: 
 7207: __global__ void transport(void) {
 7208: 
 7209:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7210: 
 7211:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7212: 
 7213:    Element *elem = &(mesh->localElemData[ie]);
 7214: 
 7215:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7216: 
 7217:                for (int m=0; m<ntr; m++) {
 7218:                   for (int k=kbe(ie); k<nvrt; k++) {
 7219:                      // Calculate each polynomial's weight 
 7220:                      wm=0.d0; sum1=0.d0; 
 7221:                      wm1=0.d0; wm2=0.d0; 
 7222:                      for (int i=0; i<elem->nweno2; i++) {
 7223:                   
 7224:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7225:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7226:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7227:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7228:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7229:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7230:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7231:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7232:                      // -----------------Hu and Shu (1999)'s method----------------
 7233:                      b4=b1+b2+b3
 7234: 
 7235: //Error: add PRODUCTION CPP
 7236: #ifdef DEBUG
 7237:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7238:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7239:                     call parallel_abort(errmsg)
 7240:                   }
 7241: #endif
 7242: 
 7243:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7244:                   // !----test-------------- 
 7245:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7246:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7247:                   // !wm(i)=wm1(i)*wm2(i)
 7248:                   // !---------------------- 
 7249:                   sum1=sum1+wm(i)
 7250:                 } // end for i
 7251: 
 7252:                 wm=wm/sum1
 7253: 
 7254:                 for (int j=0; j<elem->i34; j++) {
 7255: 
 7256:                   const Side *side  = elem->sides[j];
 7257:                   const Node *node1 = side->n1;
 7258:                   const Node *node2 = side->n2;
 7259: 
 7260:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7261:                      trsd=0.d0
 7262:                      for (int kk=0; kk<nquad; kk++) {
 7263:                         for (int i=0; i<elem->nweno2; i++) {
 7264:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7265:                         } // end for i   
 7266:                      } // end for kk
 7267:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7268:                   } // outward flux
 7269:                } // end for j=1,i34(ie) ! side
 7270:             }
 7271:          }
 7272:               
 7273: 
 7274: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7275: //             //   calculate each polynomial's weight 
 7276: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7277: //                 wm=0.d0; sum1=0.d0
 7278: //                 do i=1,nweno1(ie) !for each polynomial
 7279: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7280: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7281: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7282: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7283: //                   wm(i)=b2
 7284: //                   sum1=sum1+b2
 7285: //                   !wm(i)=1.d0
 7286: //                   !sum1=sum1+1.d0
 7287: 
 7288: // // Error: PRODUCTION
 7289: // #ifdef DEBUG
 7290: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7291: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7292: //                     call parallel_abort(errmsg)
 7293: //                   endif
 7294: // #endif
 7295: 
 7296: //                 enddo !i
 7297: //                 wm=wm/sum1 !final weight
 7298: 
 7299:                 for (int j=0; j<elem->i34; j++) { // side
 7300:                   const Side *side = elem->sides[j];
 7301:                   const Node *node1 = side->n1;
 7302:                   const Node *node2 = side->n2;
 7303: 
 7304:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7305:                     trsd=0.d0
 7306:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7307:                       for (int i=0; i<elem->nweno1; i++) {
 7308:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7309:                       }
 7310:                     enddo //kk
 7311:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7312:                   } // outward flux
 7313:                 } // end for j=1,i34(ie) ! side
 7314:               } // end for k; ntr 
 7315: 
 7316:             else !simple upwind method
 7317:               do j=1,i34(ie)
 7318:                 jsj=elside(j,ie)
 7319:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7320:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7321:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7322:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7323:                   endif
 7324:                 enddo  !vertical layers
 7325:               enddo !j=1,i34(ie) ! side
 7326:             endif !order of accuracy
 7327: 
 7328:          //  enddo !ie
 7329: // !$OMP     end do
 7330: 
 7331: // !$OMP     master
 7332: //           !message passing
 7333: //           if (nproc>1) then
 7334: //             !make a copy of side concentrations
 7335: //             trsd_tmp0=trsd_tmp 
 7336: 
 7337: //             !this exchange routine swaps interface concentration between two partitions
 7338: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7339: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7340: 
 7341: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7342: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7343: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7344: 
 7345: 
 7346: //             !This obtains final values for interface sides
 7347: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7348: //       :    endif !nproc>1
 7349: //           !message passing end
 7350: // !$OMP     end master
