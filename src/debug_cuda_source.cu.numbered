 2562: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2563:    // Returns the value of the velocity at the side center
 2564:    const double w1 = getBoundaryArrayValueWeight();
 2565:    const double w2 = 1.0 - w1;
 2566:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2567:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2568: 
 2569:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2570: }
 2571: 
 2572: 
 2573: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2574:    // Returns the value of the normal component of the velocity at the side center
 2575:    const double w1 = getBoundaryArrayValueWeight();
 2576:    const double w2 = 1.0 - w1;
 2577:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2578:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2579: 
 2580:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2581: }
