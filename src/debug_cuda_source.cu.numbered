 3821: 
 3822: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3823:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3824:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3825: 
 3826: 
 3827:    NODE(node1);
 3828: 
 3829:    node1->clearMatrixRow();
 3830:    node1->qel = 0.0;
 3831: 
 3832:    // THIS IS FOR STRUCTURES XXX
 3833:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3834: 
 3835:    
 3836:    for (int j=0; j<node1->numElements; j++) {
 3837:       // For each element connected to the node...
 3838: 
 3839:       Element *elem = node1->elements[j];
 3840: 
 3841: 
 3842: 
 3843:       // Compute the average gravity
 3844:       const double grav3 = elem->mean(&Node::grav2);
 3845: 
 3846:       // Look at the documentation for the description of the terms in the following integrals
 3847: 
 3848:       // Integral I_1 
 3849:       // \bar{\breve{H}} 
 3850:       const double hhatb = elem->mean(&Side::hhat);        
 3851: 
 3852:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3853: 
 3854:       const int id1 = elem->nodeLocalIdx(node1); 
 3855:       const double area = elem->area;
 3856: 
 3857:       if (elem->isTri()) {
 3858: 
 3859:          // To clarify the notation in this section: 
 3860:          //   i stands for the node under consideration (node1)
 3861:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3862:          const int id2 = elem->nxq(1 + id1);
 3863:          const int id3 = elem->nxq(2 + id1);
 3864:          Node *node2 = elem->nodes[id2];
 3865:          Node *node3 = elem->nodes[id3];
 3866: 
 3867:          Point2 x1, x2, x3;
 3868:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3);
 3869: 
 3870:          // integral of phi_i*phi_j
 3871:          const double ipp_ii = (1.0/6.0 )*area;
 3872:          const double ipp_ij = (1.0/12.0)*area;
 3873:          const double ipp_ik = (1.0/12.0)*area;
 3874: 
 3875:          // integral of [(grad phi_i) * (grad phi_j)]
 3876:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3877:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3878:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3879: 
 3880:          // Computes the different components of integral I_1 of each node with respect to node i.
 3881:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3882:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3883:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3884: 
 3885:          node1->addToSparseMatrix(node1, I1_ii);
 3886:          node1->addToSparseMatrix(node2, I1_ij); 
 3887:          node1->addToSparseMatrix(node3, I1_ik);
 3888: 
 3889:       }
 3890:       else { // Quad
 3891:          // XXX IMPLEMENT THIS
 3892:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3893: 
 3894:          // To clarify the notation in this section: 
 3895:          //   i stands for the node under consideration (node1)
 3896:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3897:          const int id2 = elem->nxq(1 + id1);
 3898:          const int id3 = elem->nxq(2 + id1);
 3899:          const int id4 = elem->nxq(3 + id1);
 3900:          Node *node2 = elem->nodes[id2];
 3901:          Node *node3 = elem->nodes[id3];
 3902:          Node *node4 = elem->nodes[id4];         
 3903: 
 3904:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3905:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3906:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3907:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3908:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3909: 
 3910:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3911:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3912:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3913:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3914:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3915: 
 3916:          // Computes the different components of integral I_1 of each node with respect to node i.
 3917:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3918:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3919:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3920:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3921: 
 3922:          node1->addToSparseMatrix(node1, I1_ii);
 3923:          node1->addToSparseMatrix(node2, I1_ij); 
 3924:          node1->addToSparseMatrix(node3, I1_ik);
 3925:          node1->addToSparseMatrix(node4, I1_il);
 3926:   
 3927:       } 
 3928: 
 3929:  
 3930:       // Integral I_4
 3931:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3932:       // Where
 3933:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3934: 
 3935:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3936:       // of U over the element.
 3937:       Vector2 U = {0.0, 0.0};
 3938:       for (int m=0; m < elem->i34; m++) {      
 3939:          const Side *side = elem->sides[m];
 3940: 
 3941:          if constexpr(ics == 1) U += side->U; 
 3942:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 3943:       }
 3944:       U = U/elem->i34;
 3945: 
 3946: 
 3947:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3948: 
 3949: 
 3950:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3951:       const double I_4_1 = dot(gradPhi_1, U);
 3952: 
 3953: 
 3954:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3955:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3956: 
 3957:      
 3958:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3959: 
 3960:       // Additional terms 
 3961:       double vnorm = 0.0;
 3962:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3963:          Vector3 ubed = {0.0, 0.0, 0.0};
 3964:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3965: 
 3966:          Vector3 gradP = {0.0, 0.0, 1.0};
 3967:          for (int m=0; m < elem->i34; m++) {
 3968:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3969:            gradP += toVector3(gradP_2D, 0.0);
 3970:          }   
 3971:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3972:       } // imm==2
 3973: 
 3974:       if (elem->isTri()) {
 3975:          for (int l=0; l<3; l++) {
 3976: 
 3977:             Node *node = elem->nodes[l];
 3978: 
 3979:             double fac = (node == node1) ? 2.0 : 1.0;
 3980:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3981:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3982:            
 3983:          }
 3984: 
 3985: 
 3986:          if (!elem->isDry) {
 3987:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3988: 
 3989:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3990: 
 3991:          }
 3992: 
 3993:       } // isTri
 3994:       else { // isQuad
 3995:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3996:          // for (int l=0; l<4; l++) {
 3997:          //   const Node *node = elem->nodes[l];
 3998: 
 3999:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4000:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4001: 
 4002:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4003:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4004:          // }
 4005: 
 4006:       } // isQuad
 4007: 
 4008: 
 4009:      node1->qel += (dt/elem->i34)*elem->vsource;
 4010:       
 4011: 
 4012:    } // for all elements connected to the node
 4013:    
 4014: 
 4015:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4016:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4017:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4018:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4019:       // If it is an open boundary node...
 4020: 
 4021:       // At least one open bnd side, maybe two
 4022:       for (int l=0; l<2; l++) { 
 4023: 
 4024:          // Gets each of the sides sharing the node. 
 4025:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4026: 
 4027:        
 4028: 
 4029:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4030:          if (sideBnd != nullptr) {
 4031:             // If the side is on a boundary...
 4032: 
 4033:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4034: 
 4035:             // Get the boundary segment
 4036:             const BoundarySegment *sideSegment = sideBnd->segment;
 4037:             const Side *side = sideBnd->side;
 4038: 
 4039:             // Integral I_3
 4040:             if (sideSegment->ifltype != 0) {
 4041:             // Natural or Flather b.c.
 4042: 
 4043:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4044:                // especially for Flather b.c.
 4045:                double ri3 = 0.0;
 4046:                if (!side->isDry) {
 4047:                   // If the side is not dry
 4048:                   
 4049:                   // Computes the side flux of (uth, vth)
 4050:                   double Vn = 0.0;
 4051:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4052:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4053:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4054: 
 4055:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4056:                   }
 4057: 
 4058:                   ri3 = 0.5*side->len*Vn;
 4059:                }
 4060: 
 4061:                if (sideSegment->ifltype == -1) { // Flather 1
 4062: 
 4063:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4064:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4065: 
 4066:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4067:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4068:                   
 4069:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4070:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4071: 
 4072:                } 
 4073:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4074:                   // Reset ri3
 4075:                   ri3 = 0.0;
 4076: 
 4077:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4078: 
 4079:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4080: 
 4081:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4082:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4083: 
 4084:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4085:                   node1->addToSparseMatrix(node1, con0*2.0);
 4086:                   node1->addToSparseMatrix(node2, con0);
 4087: 
 4088:                } // if Flather or Discharge
 4089: 
 4090:                node1->qel -= thetai*dt*ri3;
 4091: 
 4092: 
 4093:             } // I_3
 4094:           
 4095: 
 4096:             // Integral I_5
 4097:             if(!side->isDry) {
 4098: 
 4099:                const double Unbar = dot(side->U, side->n);
 4100:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4101: 
 4102:             } // I_5
 4103: 
 4104:          } // if is boundary side
 4105: 
 4106:       } // for l
 4107: 
 4108:    } // if isbnd
 4109: 
 4110: 
 4111: }
 4112: 
 4113: 
 4114: 
 4115: extern "C" {
 4116:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4117:                                   int* indices, int* indptr) {
 4118: 
 4119:       NODE(node);
 4120:       
 4121:       const int idx = node->idx;
 4122:       
 4123:       // Computes the index in the nzz array      
 4124:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4125: 
 4126: 
 4127:       indptr[idx] = nzzIdx;
 4128:       indices[nzzIdx] = idx;
 4129: 
 4130:       data_d[nzzIdx]    = node->coeffDiag;
 4131: 
 4132:       b_d[idx] = node->qel;
 4133: 
 4134:       for (int k = 0; k < node->numNodes; ++k) {
 4135:          const Node* nb = node->nodes[k];
 4136: 
 4137:          const int j = nb->idx;
 4138: 
 4139:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4140: 
 4141:          indices[nzzIdx + k + 1] = j;
 4142:       }
 4143: 
 4144:  
 4145:    }
