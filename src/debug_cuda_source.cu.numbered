 1854:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1855:       // Compute the different time ramps used in the code 
 1856:       // This function is performed by just one thread
 1857: 
 1858:       rampbc = 1.0;
 1859:       if constexpr(ibc == 0) {
 1860:          if (drampbc > 0.0) {
 1861:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1862:          } else {
 1863:             rampbc = 1.0;
 1864:          }
 1865:       }
 1866: 
 1867:       if (nws != 0) {
 1868:          if (drampwind > 0.0) {
 1869:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1870:          } else {
 1871:             rampwind = 1.0;
 1872:          }
 1873:       }
 1874: 
 1875:       if (drampwafo > 0.0) {
 1876:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1877:       } else {
 1878:          rampwafo = 1.0;
 1879:       }
 1880: 
 1881:       // For source/sinks
 1882:       if (if_source && dramp_ss > 0.0) {
 1883:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1884:       } else {
 1885:          ramp_ss = 1.0;
 1886:       }
 1887: 
 1888:       if (dramp > 0.0) {
 1889:          ramp = tanh(2.0*time/86400.0/dramp);
 1890:       } else {
 1891:          ramp = 1.0;
 1892:       }
 1893: 
 1894: 
 1895:    }
