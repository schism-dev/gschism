 1535: 
 1536: // Each device has a global mesh object
 1537: __device__ Mesh* mesh = nullptr; 
 1538: 
 1539: 
 1540: 
 1541: // Convenience macros for accessing the objects in kernels.
 1542: 
 1543: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1544:                    Side *side = &(mesh->localSideData[idx_side]); \
 1545:                    if (idx_side >= mesh->ns) return;
 1546: 
 1547: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1548:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1549:                    if (idx_elem >= mesh->ne) return;
 1550: 
 1551: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1552:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1553:                    if (idx_node >= mesh->np) return;
 1554: 
 1555: 
 1556: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1557:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
