 1652: // Helper functions for computing the local node index at a given offset from another.
 1653: __device__ __inline__ int nxq(int offset, int index, int size) {
 1654:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1655:    // to the index to make it positive
 1656:    assert(index + offset + 16*size >= 0);
 1657:    return (index + offset + 16*size) % size;  
 1658: }
 1659: 
 1660: __device__ __inline__ int nxq(int index, int size) {
 1661:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1662:    // to the index to make it positive
 1663:    assert(index + 16*size >= 0);
 1664:    return (index + 16*size) % size; 
 1665: }
