 6673: 
 6674:    __global__ void computeVegetationAndDragParameters(void) {
 6675:       // Computes the vegetation and drag model parameters:
 6676:       // chi, \tilde\chi, beta, \breve{H}
 6677:       
 6678:       SIDE(side);
 6679: 
 6680:       side->hhat = 0.0;
 6681:       side->chi2 = 0.0;
 6682:       side->chi = 0.0;
 6683:       side->veg_c2 = 0.0;
 6684:       side->veg_beta = 0.0;
 6685: 
 6686:       if (side->isDry) return;
 6687: 
 6688:       const double htot = side->htot2();
 6689:       const int    kb   = side->kb;
 6690: 
 6691:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6692: 
 6693:       const double veg_h     = side->veg_h();
 6694:       const double veg_nv    = side->veg_nv();
 6695:       const double veg_c     = side->veg_c();
 6696:       const double veg_beta  = side->veg_beta;
 6697:       const double veg_alpha = side->veg_alpha_vert_mean();
 6698: 
 6699:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6700:       // Velocity magnitude at the bottom level
 6701:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6702:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6703:       side->chi2 = side->Cd()*vmag1;
 6704:       side->chi  = side->chi2;
 6705: 
 6706:       if constexpr(iveg != 0) {
 6707:          const Node *n1 = side->n1;
 6708:          const Node *n2 = side->n2;
 6709:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6710:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6711:       }
 6712: 
 6713:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6714: 
 6715:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6716:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6717:       double magUa = 0.0;
 6718:       if constexpr(iveg != 0) {
 6719:          if (side->is3D() && veg_h > 0.0) {
 6720:             // 3D wet side with veg...
 6721: 
 6722:             double magUa = 0.0;
 6723:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6724:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6725: 
 6726:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6727:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6728:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6729: 
 6730:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6731:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6732: 
 6733:                   // Velocity magnitude at the bottom (l) of the level
 6734:                   const double ul = length(side->u2[k]);
 6735: 
 6736:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6737:                   magUa += Dz*0.5*(uh + ul);
 6738: 
 6739:                } // if HasVegetation
 6740:             } // for k
 6741:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6742: 
 6743:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6744:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6745:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6746:                const double zCpy = side->zTopCanopy();
 6747:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6748:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6749:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6750:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6751:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6752:             } // if isSubmerged
 6753:          } // if is3D
 6754:       } // if iveg   
 6755: 
 6756:       // Computes the friction modified depth, \breve{H} in notes
 6757:       if (side->is2D()) { // 2D
 6758: 
 6759:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6760:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6761: 
 6762:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6763: 
 6764:          side->hhat = htot*htot/fricH; 
 6765: 
 6766:       } else { // 3D
 6767:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6768: 
 6769:          if constexpr(iveg != 0) {
 6770:             
 6771:             if (side->isSubmerged()) { 
 6772:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6773:                side->hhat -= veg_c*Hhat_alpha;
 6774: 
 6775:             } else { // Emergent
 6776:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6777:             }
 6778:          } // if iveg
 6779: 
 6780:          // Enforce positivity for 3D model
 6781:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6782:       } // if 3D
 6783: 
 6784:    }
 6785: 
 6786: 
 6787: 
 6788:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6789:    // Computes the density gradient between two elements, e1 and e2.
 6790:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6791:    // zero in the direction normal to the side. 
 6792:    // 
 6793:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6794:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6795:    //
 6796:    // Input:
 6797:    //    e1: Element
 6798:    //    e2: Neighbor element (or nullptr if boundary)
 6799:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6800:    //    k: Index of the half-level at which the density is interpolated
 6801:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6802:    // 
 6803:    // Output:
 6804:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6805:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6806: 
 6807:       if (e2 == nullptr || e2->isDry) {
 6808:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6809: 
 6810:          Side *side = e1->sides[j];
 6811:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6812:                  
 6813:          if constexpr(ics == 1) {
 6814:             vec = side->n; // Normal vector to the side
 6815:          } else {
 6816:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6817:             // IMPLEMENT THIS XXXXXX
 6818:             // !replace with xel, yel?
 6819:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6820:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6821:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6822:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6823:          } //ics
 6824:                    
 6825:          diffRho = 0.0;
 6826: 
 6827:       } else { //internal and wet
 6828:          if constexpr(ics==1) {
 6829:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6830: 
 6831:             // Vector from e1 to e2
 6832:             vec = e2->center - e1->center;
 6833: 
 6834:          } else { 
 6835:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6836:             // Remember that elem->center is in global coordinates
 6837:             // IMPLEMENT THIS XXXXXX
 6838:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6839:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6840:             //                   alow(j)=xctr2
 6841:             //                   bdia(j)=yctr2
 6842:          } // ics
 6843: 
 6844:          diffRho = rho2 - e1->demeanedDensity(k);
 6845:       }
 6846: 
 6847:    }
 6848: 
 6849:    __global__ void computeDensityCubicSplines(void) {
 6850:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6851: 
 6852:       ELEM(elem);
 6853: 
 6854:       if (elem->isDry) return;
 6855: 
 6856:       const int kb = elem->kb;
 6857: 
 6858:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6859:       if (elem->is2D()) {
 6860:          // In the 2D case, the density is constant at the prism level. 
 6861:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6862:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6863:       } else { //3D
 6864: 
 6865:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6866:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6867:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6868:          ///// XXXX CHECK INDICES!!!!!
 6869:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6870:       } // 2D/3D
 6871: 
 6872:    }
 6873: } // extern "C"
 6874: 
 6875: 
 6876: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6877: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6878: 
 6879:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6880: 
 6881:    const int kb  = elem->kb;
 6882:    const int kb2 = elem2->kb;
 6883: 
 6884:    // z-coordinate of prism of elem
 6885:    const double zp = elem->z_prism(k);
 6886: 
 6887:    double rho = 0.0;
 6888: 
 6889:    if (elem2->is2D()) {
 6890:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6891: 
 6892:    } else {  // 3D
 6893: 
 6894:       // eta_min may be < zmax
 6895:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6896:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6897: 
 6898:       // (Extrapolate density below bottom, we will fix it later)
 6899:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6900:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6901:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6902:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6903:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6904:    } // 2D/3D
 6905:      
 6906: 
 6907:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6908:    // Now we need to fix it.
 6909:    if (elem->z[k] < elem2->z[kb2]) {
 6910:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6911: 
 6912:       // There are two methods to adjust the density at the bottom of the element.
 6913:       // iunder_deep=0: 
 6914:       const double depth1 = abs(elem->z[kb]); // larger depth
 6915: 
 6916:       if (iunder_deep==0) {
 6917: 
 6918:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6919: 
 6920:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6921: 
 6922:       } else { // iunder_deep != 0
 6923: 
 6924:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6925: 
 6926:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6927: 
 6928:          //   Demeaned density at the same z coordinate as
 6929:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6930:          }
 6931: 
 6932:       } // if iunder_deep
 6933:    } // if elem->z[kb] < elem2->z[kb]
 6934: 
 6935:    return rho;
 6936: }
 6937: 
 6938: 
 6939: extern "C" {
 6940:    __global__ void computeDensityGradient(void) {
 6941: 
 6942:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6943:       if constexpr(ibc != 0) return;
 6944: 
 6945:          // Compute the horizontal density gradient at each element.
 6946:       // It works in two steps:
 6947:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6948:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6949:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6950:       //             gradRho.r1 = rho1 - rho0
 6951:       //             gradRho.r2 = rho2 - rho0
 6952:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6953:       // 
 6954:       //  NOTE: We use de-meaned densities.
 6955: 
 6956:       ELEM(elem);
 6957: 
 6958:       if (elem->isDry) return;
 6959: 
 6960:       const int kb  = elem->kb;
 6961:       const int i34 = elem->i34;
 6962: 
 6963:       for (int k = kb + 1; k < nvrt; k++) {
 6964:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6965:          //             gradRho.r1 = rho1 - rho0
 6966:          //             gradRho.r2 = rho2 - rho0
 6967:          int icount = 0;
 6968:          double sumRx = 0.0;
 6969:          double sumRy = 0.0;
 6970:          for (int j1=0; j1<i34; j1++) { 
 6971: 
 6972:             const int j2 = elem->nxq(j1 + 1);
 6973: 
 6974:             // Pairs of consecutive neighbor elements of elem
 6975:             const Element *e1 = elem->nghbElems[j1];
 6976:             const Element *e2 = elem->nghbElems[j2];
 6977: 
 6978:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6979:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6980:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6981: 
 6982:             // Compute the density difference and the vector from elem to e1 and e2
 6983:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6984:             double diffRho1, diffRho2;
 6985:             Vector2 vec1, vec2;
 6986:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6987:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6988: 
 6989:             const double rl1 = length(vec1);
 6990:             const double rl2 = length(vec2);
 6991:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6992: 
 6993:             const double delta = cross(vec1, vec2);
 6994:             const double sintheta = abs(delta)/(rl1*rl2);
 6995: 
 6996:             // To avoid problems, avoid elements with small angle between vectors
 6997:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6998:             const bool validEq = (sintheta > sin_one_deg);
 6999: 
 7000:             if (validEq) {
 7001:                // Solve the system of equations to get the density gradient at elem
 7002:                icount++;
 7003:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7004:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7005:                sumRx += Rx;
 7006:                sumRy += Ry;
 7007:             }
 7008:          } // for j1
 7009: 
 7010:          // Compute the average density gradient at elem
 7011:          if (icount==0) {
 7012:            // Bad mesh quality; bail out with 0 b-cc
 7013:            elem->gradRho[k] = {0.0, 0.0};
 7014:          } else {
 7015:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7016:          }
 7017: 
 7018:       } // for k
 7019: 
 7020:    }
 7021: 
 7022:    __global__ void computeBaroclinicTerm(void) {
 7023:    // Computes the baroclinic term at sides (at half levels).
 7024:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7025:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7026: 
 7027:       if (ibc == 1) return;
 7028: 
 7029:       SIDE(side);
 7030: 
 7031:       if (side->isDry) return;
 7032: 
 7033:       const Element *e1 = side->elems[0];
 7034:       const Element *e2 = side->elems[1]; 
 7035:       const int kb = side->kb;
 7036:       
 7037:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7038: 
 7039:       // interpolates vertically the density gradient of the two elements at the half level/
 7040: 
 7041:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7042:       int k2 = max(kb, nvrt / 2);
 7043: 
 7044:       // Starts the integration at the surface and goes down to the bottom
 7045:       side->bcc[nvrt-1] = {0.0, 0.0};
 7046:       for (int k = nvrt - 2; k >= kb; k--) {
 7047:       // For each prism level (from surface to bottom)...
 7048: 
 7049:          // For both elements, interpolate density gradient at the side's half level.
 7050:          // The gradient at the side is the average of the gradients at the elements.
 7051:          // w1, w2 are used to take into account boundary sides, with just one element.
 7052:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7053:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7054:          const double wsum = w1 + w2;
 7055:          w1 = w1/wsum;
 7056:          w2 = w2/wsum;
 7057:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7058: 
 7059:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7060:          Vector2 gradRho = {0.0, 0.0};
 7061:          if (e1 != nullptr && k > kb) {
 7062:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7063:             
 7064:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7065:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7066:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7067: 
 7068:             // Grad(rho) vertically interpolated at the side's half level
 7069:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7070: 
 7071:             // Projects the element density gradient to the side frame if needed.
 7072:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7073: 
 7074:             // Adds the contribution of the density gradient at the side's half level
 7075:             gradRho += gradRho1*w1;
 7076:          }      
 7077:          if (e2 != nullptr && k > kb) {
 7078:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7079:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7080:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7081:             
 7082:             // Grad(rho) vertically interpolated at the side's half level
 7083:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7084: 
 7085:             // Projects the element density gradient to the side frame if needed.
 7086:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7087: 
 7088:             // Adds the contribution of the density gradient at the side's half level
 7089:             gradRho += gradRho2*w2;
 7090:          }
 7091: 
 7092:          
 7093:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7094:          // multiplied by -rampbc*(g/rho0) 
 7095:          const double grav3 = side->grav3();
 7096:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7097: 
 7098:       } // for
 7099: 
 7100:    }
 7101: 
 7102: 
 7103: 
 7104:    __global__ void computeHorGradientAtSide(void) {
 7105: 
 7106:       // Compute the horizontal density gradient at each element.
 7107:       // It works in two steps:
 7108:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7109:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7110:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7111:       //             gradRho.r1 = rho1 - rho0
 7112:       //             gradRho.r2 = rho2 - rho0
 7113:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7114:       // 
 7115:       //  NOTE: We use de-meaned densities.
 7116: 
 7117:       SIDE(side);
 7118: 
 7119: 
 7120:       if (side->isDry) return;
 7121: 
 7122:       // Computes the gradient of the variables at the side center.
 7123:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7124:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7125:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7126: 
 7127:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7128:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7129:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7130:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7131: 
 7132:    }
 7133: 
 7134: 
 7135:    __global__ void solveMomentumEquations(double time) {
 7136: 
 7137:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7138:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7139: 
 7140:       SIDE(side);
 7141: 
 7142:       if (side->isDry) 
 7143:       {
 7144:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7145: 
 7146:          return;
 7147:       }
 7148: 
 7149:       const Node *n1 = side->n1;
 7150:       const Node *n2 = side->n2;
 7151: 
 7152:       const int kb = side->kb;
 7153: 
 7154:       const double veg_h = side->veg_h();
 7155:       const double grav3 = side->grav3();
 7156: 
 7157:       if (side->is2D()) {
 7158:          // Remember: Do not use htot2, which is updated.
 7159:          const double htot = side->htot1();
 7160:          const double hhat = side->hhat;
 7161: 
 7162:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7163: 
 7164:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7165:          const Vector2 tau2 = side->tau();
 7166: 
 7167:          // hat_gam has units of m/s
 7168: 
 7169:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7170:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7171:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7172: 
 7173:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7174: 
 7175: 
 7176:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7177: 
 7178:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7179: 
 7180:       }
 7181:       else { // 3D
 7182: 
 7183:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7184:          // 
 7185:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7186:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7187:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7188:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7189:          // k+1 and k.
 7190: 
 7191: 
 7192:          const int ndim = nvrt - kb;
 7193:          const double zTopCanopy = side->zTopCanopy();
 7194: 
 7195:          // Initialize the tridiagonal system
 7196:          for (int k = kb + 1; k < nvrt; k++) {
 7197:             
 7198:             const int kin = k - (kb + 1);
 7199: 
 7200:             // Vertical viscosity at the face center
 7201:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 7202: 
 7203:  
 7204:             alow[kin] = 0.0;
 7205:             cupp[kin] = 0.0;
 7206:             bdia[kin] = 0.0;
 7207: 
 7208:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7209:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7210: 
 7211:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7212:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7213:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7214: 
 7215:             // First part: layers k, k+1
 7216:             if (k < nvrt - 1) {
 7217:                              
 7218:                if constexpr(iveg != 0) {
 7219: 
 7220:                   // If there is vegetation at this level...
 7221:                   if (zTopCanopy > side->zc[k]) {
 7222:                      // If the canopy is above the k layer...
 7223:                      
 7224:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7225:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7226:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7227:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7228: 
 7229:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7230:                      const double vmag2 = length(ut2);
 7231:                      const double vmag1 = length(side->u2[k]);
 7232:                      const double vmag = 0.5*(vmag1 + vmag2);
 7233:                      
 7234:                      // Computes the vegetation alpha at the face center
 7235:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7236: 
 7237:                      cff1 += veg_alpha_sd*dt*vmag;
 7238: 
 7239:                   } // if (zTopCanopy
 7240:                } // if iveg
 7241: 
 7242:                const double dzz = side->Dz(k + 1);
 7243:                const double tmp = dt*dfz/dzz;
 7244:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7245: 
 7246:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7247:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7248:             }
 7249: 
 7250: 
 7251:             // Second part: layers k-1, k
 7252:             if (k > kb + 1) {
 7253: 
 7254:                double cff1 = 1.0; //init \bar{c^k}
 7255: 
 7256:                if constexpr(iveg != 0) {
 7257:                   // If there is vegetation at this level...
 7258:                   if (zTopCanopy > side->zc[k-1]) {
 7259:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7260:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7261: 
 7262:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7263: 
 7264:                      const double vmag2 = length(ut2);
 7265:                      const double vmag1 = length(side->u2[k-1]);
 7266:                      const double vmag = 0.5*(vmag1 + vmag2);
 7267: 
 7268:                      // Computes the vegetation alpha at the face center
 7269:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7270:                      cff1 += veg_alpha_sd*dt*vmag;
 7271:                   } // if zTopCanopy
 7272: 
 7273:                } // if iveg
 7274: 
 7275:                const double dzz = side->Dz(k);
 7276:                const double tmp = dt*dfz/dzz;
 7277:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7278: 
 7279:                alow[kin] += cff1*dzz/6.0 - tmp;
 7280:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7281: 
 7282:             } else { // Bottom boundary
 7283:                // This occurs at the bottom, where the bottom drag is applied.
 7284: 
 7285:                bdia[kin] += dt*side->chi2; // XXXX
 7286: 
 7287:             } // if (k > kb + 1)
 7288: 
 7289: 
 7290:          } // for (int k
 7291: 
 7292: 
 7293: 
 7294:          // Computes the RHS.
 7295:          // -----------------
 7296: 
 7297:          //	BC to be imposed at the end.
 7298: 
 7299:          const Vector2 gradETP  = side->gradETP;
 7300:          const Vector2 gradPr   = side->gradPr;
 7301:          const Vector2 gradEta1 = side->gradEta1;
 7302:          const Vector2 gradEta2 = side->gradEta2;
 7303: 
 7304:          const Vector2 *btu = side->btu;
 7305:          const Vector2 *u2  = side->u2;
 7306:          const double coriolis = side->coriolis;
 7307:          const Vector2 *nuGradU = side->nuGradU;
 7308: 
 7309:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7310:          for (int k = kb + 1; k < nvrt; k++) {
 7311:             const int kin = k - kb - 1;
 7312: 
 7313:             const double dz_0 = side->Dz(k);
 7314:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7315: 
 7316:             rrhs[kin] = {0.0, 0.0};
 7317:             double dz = 0.0;
 7318: 
 7319:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7320:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7321:             if (k < nvrt  ) dz += dz_1;
 7322:             if (k > kb + 1) dz += dz_0;
 7323: 
 7324:             // Elevation gradient, atmospheric pressure and tidal potential
 7325:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7326: 
 7327:             // Coriolis, advection, wind stress, and horizontal viscosity
 7328:             if (k < nvrt - 1) {
 7329: 
 7330: 
 7331:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7332:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7333:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7334:                                                 
 7335: 
 7336:                //diff stress tensors 1006
 7337:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7338:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7339:                   assert(false && "Not implemented: itur == 5");
 7340:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7341:                }
 7342:                // else assert(false && "itur # Not implemented");
 7343: 
 7344:             } else { // k == nvrt - 1 SURFACE
 7345:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7346:                const Vector2 tau2 = side->tau();
 7347: 
 7348:                rrhs[kin] += dt*tau2;          
 7349: 
 7350:             } // if k<nvrt
 7351: 
 7352: 
 7353:             if (k > kb + 1) {
 7354:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7355:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7356:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7357: 
 7358:                // diff stress tensors 1006
 7359:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7360:                   assert(false && "Not implemented: itur == 5");
 7361:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7362:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7363:                }
 7364:                // else assert(false && "itur # Not implemented");
 7365: 
 7366: 
 7367:             } // if k>kbs + 1
 7368: 
 7369:             // Baroclinic
 7370:             Vector2 *bcc = side->bcc;
 7371:             if constexpr(ibc == 0) {
 7372:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7373:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7374: 
 7375:             } // if ibc==0
 7376: 
 7377:          } // k=kb + 1,nvrt
 7378: 
 7379: 
 7380:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7381: 
 7382:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7383:             const int kin = k - kb - 1;
 7384:    
 7385:             // Velocity is always clamped to maximum values
 7386:             side->u2[k] = clampVelocity(soln[kin]);
 7387:          } // k
 7388: 
 7389:       } // if side->is2D()
 7390:       
 7391: 
 7392:       // Impose velocity boundary condition at the bottom
 7393:       if constexpr(imm == 2) { // 3D bed deformation model
 7394:          double dep;
 7395:          Vector2 vel;
 7396: 
 7397:          assert(false && "Not implemented: imm == 2");
 7398:          //update_bdef(time, x0, y0, dep, vel);
 7399:          // side->u2[kb] = vel;
 7400: 
 7401:       } else { // imm = 0 or 1
 7402:          if (side->Cd() == 0.0) {
 7403:             side->u2[kb] = side->u2[kb + 1];
 7404: 
 7405:          } else if (side->is3D()) { // 3D no slip bottom   
 7406:             side->u2[kb] = {0.0, 0.0};
 7407: 
 7408:          }
 7409:           
 7410:       } // if imm
 7411: 
 7412:       // The velocities below the bottom level are set to zero
 7413:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7414: 
 7415: 
 7416:    }
 7417: 
 7418: 
 7419:    __global__ void applyMomentumBC(void) {
 7420: 
 7421:       SIDE_BND(sideBnd);
 7422: 
 7423:       Side *side = sideBnd->side;
 7424:       const BoundarySegment *segment = sideBnd->segment;
 7425:       const Node *n1 = side->n1;
 7426:       const Node *n2 = side->n2;
 7427: 
 7428:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7429: 
 7430:       const bool isLand = segment->isLand;
 7431:       const int ifltype = segment->ifltype;
 7432: 
 7433:       const int kb = side->kb;
 7434: 
 7435: 
 7436:       if (!isLand && ifltype != 0) {
 7437:          const Vector2 *ubc = sideBnd->ubc;
 7438:   
 7439:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7440:             
 7441:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7442:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7443: 
 7444:             if (ifltype == -1) {
 7445:                // Flather 1
 7446: 
 7447:                const double depth = side->depth();
 7448: 
 7449:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7450: 
 7451:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7452: 
 7453:                side->u2[k] = vnorm*side->n;
 7454: 
 7455:             } else if (ifltype == -2) { // Discharge
 7456: 
 7457:                const double eta1 = side->eta1();
 7458:                const double eta2 = side->eta2();
 7459:                const double htot = side->htot2();
 7460: 
 7461:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7462:                assert(false && "Not implemented: Discharge bc");
 7463:                // const double dischrg = discharge(eta1);
 7464:                const double dischrg = 0.0; // XXX REMOVE
 7465:                
 7466: 
 7467:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7468: 
 7469:                const double vnorm = dischrg*eta2/htot;
 7470: 
 7471:                side->u2[k] = vnorm*side->n;
 7472: 
 7473:             }
 7474:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7475:                const double vnorm = dot(side->u2[k], side->n);
 7476: 
 7477:                double rat;
 7478:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7479:                else              rat = segment->vobc2; // outgoing
 7480: 
 7481:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7482: 
 7483:             }
 7484:             else { // not Flather or 3D radiation
 7485: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7486:                side->u2[k] = ubc[k];
 7487: 
 7488:             } // if (segment->ifltype...
 7489: 
 7490:          }
 7491: 
 7492:       }
 7493:       else if (isLand) { // if it is land boundary side
 7494: 
 7495:          if constexpr(islip == 0) { // free slip
 7496: 
 7497:             for (int k = kb; k < nvrt; k++) {
 7498: 
 7499:                const Vector2 t = side->t();
 7500:                const Vector2 n = side->n;
 7501: 
 7502:                double vnorm = 0.0; // for most cases
 7503:                const double vtan = dot(side->u2[k], t);
 7504:                
 7505:                side->u2[k] = vtan*t - vnorm*n;
 7506: 
 7507:             }
 7508: 
 7509:          } else { // no slip
 7510:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7511: 
 7512:          }
 7513:       } // if (side segment type...
 7514: 
 7515:    }
 7516: 
 7517: 
 7518:    __global__ void shapiroFilter1(void) {
 7519:       // First step of the Shapiro filter (normally used if indvel<=0)
 7520:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7521: 
 7522:       SIDE(side);
 7523: 
 7524:       // Only internal wet sides are processed
 7525:       if (side->isDry || !(side->isInternal())) return;
 7526: 
 7527:       const int kb = side->kb;
 7528: 
 7529:       for (int mm = 0; mm < niter_shap; mm++) {
 7530: 
 7531:          for (int k = kb + 1; k < nvrt; k++) {
 7532:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7533:             Vector2 suru = {0.0, 0.0};
 7534: 
 7535:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7536: 
 7537:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7538: 
 7539:                int kin = k;
 7540:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7541:                
 7542:                // Get the velocity at the neighbor's side.
 7543:                Vector2 nSideU2 = nSide->u2[kin];
 7544: 
 7545:                // Projects the velocity to the current side frame if needed.
 7546:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7547: 
 7548:                suru += nSideU2;
 7549:             }
 7550: 
 7551:             // Reusing bcc as a temporary array to store the suru values.
 7552:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7553: 
 7554:          }
 7555:       }
 7556:    }
 7557: 
 7558:    __global__ void shapiroFilter2(void) {
 7559:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7560: 
 7561:       SIDE(side);
 7562: 
 7563: 
 7564:       if (side->isDry || !(side->isInternal())) return;
 7565: 
 7566:       const int kb = side->kb;
 7567: 
 7568:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7569: 
 7570:       if (side->is2D()) {
 7571:          side->u2[kb + 1] = side->bcc[kb + 1];
 7572:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7573: 
 7574:       } else {
 7575:          // 3D
 7576:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7577:          
 7578:       }
 7579: 
 7580:    }
 7581: 
 7582: 
 7583:    __global__ void ul0UpdateZCoords(void) {
 7584:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7585:       
 7586:       NODE(node);      
 7587: 
 7588: 
 7589:       if (false) { //node->isDry) { XXXXXXX
 7590: 
 7591:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7592: 
 7593:          if constexpr(ivcor != 1) node->kb = 0;
 7594: 
 7595:       } else {
 7596: 
 7597:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7598:          node->updateKb();
 7599: 
 7600:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7601: 
 7602:       }
 7603: 
 7604:       // We use the temp.b field to store the previous state of isDry.
 7605:       node->tmp.b = node->isDry;
 7606: 
 7607:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7608:       node->isDry = true;
 7609: 
 7610:    }
 7611: 
 7612:    __global__ void ul0ComputeDryElements(void)
 7613:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7614:    {
 7615:       ELEM(elem);
 7616: 
 7617:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7618: 
 7619:       elem->kb = 0;
 7620: 
 7621:       if (elem->isDry) return;
 7622: 
 7623: 
 7624:    //    if(elem->isDry2()) { // XXXX
 7625:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7626:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7627:    //        call parallel_abort(errmsg)
 7628:    //    }
 7629: 
 7630:       const Node *n1 = elem->nodes[0];
 7631:       const Node *n2 = elem->nodes[1];
 7632:       const Node *n3 = elem->nodes[2];  
 7633:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7634: 
 7635:       // Computes element's kb as the minimum of the nodes' kb.
 7636:       const int kb1 = n1->kb;
 7637:       const int kb2 = n2->kb;
 7638:       const int kb3 = n3->kb;
 7639:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7640: 
 7641: 
 7642:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7643: 
 7644: 
 7645:       // Computes the element z as the mean of the nodes z.
 7646:       for (int k = elem->kb; k < nvrt; k++) {
 7647: 
 7648:          // Compute the element z as the mean of the nodes z.
 7649:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7650:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7651:          elem->z[k] /= elem->i34;
 7652: 
 7653:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7654:       }
 7655:                   
 7656:    }
 7657: 
 7658:    __global__ void ul0ComputeDryNodes(void)
 7659:    // Updates node's isDry based on the elements' isDry. 
 7660:    {
 7661:       NODE(node);
 7662: 
 7663:       node->isDry = true;
 7664: 
 7665:       // A node is wet if at least one of the elements sharing it is wet.
 7666:       for (int j = 0; j < node->numElements; j++) {
 7667:          const Element *elem = node->elements[j];
 7668:          if (!elem->isDry) {
 7669:             node->isDry = false;
 7670:             break;
 7671:          }
 7672:       }
 7673: 
 7674:        
 7675:    }
 7676: 
 7677: 
 7678:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7679:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7680:    // node->tmp.b is true if the node was previously dry.
 7681:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7682:    {
 7683:       NODE(node);
 7684:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7685: 
 7686:       // Avoid this the first time step.
 7687:       if (it == iths) return;  
 7688: 
 7689:       const bool wasDry = node->tmp.b;
 7690: 
 7691: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7692: 
 7693:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7694: 
 7695:          for (int k=0; k < nvrt; k++) {
 7696: 
 7697:             Vector3 utmp={0.0, 0.0, 0.0};
 7698: 
 7699:             double ttmp=0.0;
 7700:             double stmp=0.0;
 7701:             int icount=0;
 7702:             for (int j = 0; j < node->numNodes; j++) {
 7703: 
 7704:                const Node *nbrNode = node->nodes[j];
 7705:                
 7706:                const bool wasNbrDry = nbrNode->tmp.b;
 7707: 
 7708:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7709:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7710: 
 7711:                   icount++;
 7712: 
 7713:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7714:                   utmp += nbrNode->uvw2(k);
 7715:                   
 7716:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7717:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7718:                }
 7719:             }
 7720: 
 7721:             if (icount > 0) {
 7722:                const double inv_icount = 1.0/icount;
 7723:                utmp = inv_icount*utmp;
 7724:                node->u2[k]     = {utmp.x, utmp.y};
 7725:                node->w2[k]     = utmp.z;
 7726:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7727:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7728:             } else {
 7729:                node->u2[k] = {0.0, 0.0};
 7730:                node->w2[k] = 0.0;
 7731:                // Initialize tracers to 0.0??? XXXXX
 7732:             }
 7733:          }
 7734:       }
 7735:    }
 7736: 
 7737:   
 7738:    
 7739: 
 7740: 
 7741:    __global__ void ul0UpdateSides(int it, int iths) {
 7742:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7743:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7744:    // The dryness of the sides is updated in ul0UpdateSides2.
 7745: 
 7746:       SIDE(side);
 7747: 
 7748:       // A side is wet if and only if at least one of its elements is wet.
 7749:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7750:  
 7751:       const Node *n1 = side->n1;
 7752:       const Node *n2 = side->n2;
 7753:      
 7754:       const int kb1 = n1->kb;
 7755:       const int kb2 = n2->kb;
 7756: 
 7757:       side->kb = 0; // default when dry
 7758: 
 7759:       if (isWet) {
 7760: 
 7761:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7762: 
 7763:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7764: 
 7765:          side->kb = min(kb1, kb2);
 7766: 
 7767:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7768: 
 7769:          for (int k = side->kb; k < nvrt; k++) {
 7770:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7771: 
 7772:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7773: 
 7774:             // Compute velocity for re-wetted sides 
 7775:             if ((it != iths) && (side->isDry && isWet)) {
 7776: 
 7777:                Vector2 utmp={0.0, 0.0};
 7778: 
 7779:                int icount=0;
 7780: 
 7781:                // For all the sides on the two elements that share this side
 7782:                for (int j = 0; j < 2; j++) {
 7783:                   const Element *elem = side->elems[j];
 7784:                   if (elem == nullptr) continue;
 7785: 
 7786:                   for (int jj=0; jj < elem->i34; jj++) {
 7787:                      const Side *nSide = elem->sides[jj];
 7788:                      if (nSide->isDry) continue;
 7789: 
 7790:                      icount++;
 7791:                      utmp += nSide->u2[k];  
 7792:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7793:                   }
 7794:                }
 7795:                   
 7796:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7797:                if (icount > 0)  side->u2[k] = utmp/icount;
 7798:                else             side->u2[k] = {0.0, 0.0};
 7799:                   
 7800:             } // if ((it != iths) && (side->isDry && isWet))
 7801: 
 7802:          } // for k
 7803: 
 7804:       } // if isWet 
 7805:       
 7806: 
 7807: 
 7808:    }
 7809: 
 7810:    __global__ void ul0UpdateSides2(void) {
 7811:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7812:    
 7813:          SIDE(side);
 7814:    
 7815:          const Element *e1 = side->elems[0];
 7816:          const Element *e2 = side->elems[1];
 7817: 
 7818:          // A side is wet if and only if at least one of its elements is wet.
 7819:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7820: 
 7821:          // Update the side's dryness
 7822:          side->isDry = !isWet;
 7823: 
 7824:    }
 7825: 
 7826: 
 7827:    __global__ void zeroNodalVelocities(void) {
 7828:       NODE(node);
 7829: 
 7830:       for (int k = 0; k < nvrt; k++) {
 7831:          node->u2[k]   = {0.0, 0.0};
 7832:          node->w2[k]   = 0.0;
 7833:          node->utmp[k] = {0.0, 0.0};         
 7834:       }
 7835:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7836:    }
 7837:  
 7838: 
 7839:    __global__ void computeNodalVerticalVelocities1(void) {
 7840:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7841:    // Adds the element's vertical velocity times the element's area.
 7842:       ELEM(elem);
 7843: 
 7844:       for (int j = 0; j < elem->i34; j++) {
 7845:          Node *node = elem->nodes[j];
 7846: 
 7847:          for (int k = node->kb; k < nvrt; k++) {
 7848:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7849:          }
 7850:          atomicAdd(&(node->tmp.d), elem->area);
 7851:       }
 7852:    }
 7853: 
 7854:    __global__ void computeNodalVerticalVelocities2(void) {
 7855:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7856:    // Divides by the total area of the elements sharing the    node.
 7857:       NODE(node);
 7858: 
 7859: 
 7860:       const double invArea = 1.0 / node->tmp.d;
 7861:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7862: 
 7863:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7864:    }
 7865: 
 7866: 
 7867:    __global__ void computeNodalHorizontalVelocities1(void) {
 7868: 
 7869:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7870: 
 7871:       ELEM(elem);
 7872: 
 7873:       if (elem->isDry) return;
 7874: 
 7875:       const int kb = elem->kb;
 7876:       const bool isTri = elem->isTri();
 7877: 
 7878:       if constexpr(indvel <= 0) {
 7879:          // Assuming discontinous hvel.
 7880: 
 7881:          if (isTri) { // For triangles
 7882:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7883:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7884:             #pragma unroll
 7885:             for (int j = 0; j < 3; j++) {
 7886:                // For every node of the triangle...
 7887:                Node *node = elem->nodes[j];
 7888: 
 7889:                if (node->isDry) continue;
 7890: 
 7891:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7892:                const Side *s2 = elem->sides[(j + 1) % 3];
 7893:                const Side *s3 = elem->sides[(j + 2) % 3];
 7894: 
 7895:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7896: 
 7897:                atomicAdd(&(node->tmp.i), 1);
 7898: 
 7899:                for (int k = kb; k < nvrt; k++)  {
 7900:                   Vector2 s1u2 = s1->u2[k];
 7901:                   Vector2 s2u2 = s2->u2[k];
 7902:                   Vector2 s3u2 = s3->u2[k];
 7903: 
 7904:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7905:                   if constexpr(ics == 2) {
 7906:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7907:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7908:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7909:                   }
 7910: 
 7911:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7912:                   u = clampVelocity(u);
 7913:                   atomicAdd(&(node->utmp[k].x), u.x);
 7914:                   atomicAdd(&(node->utmp[k].y), u.y);
 7915: 
 7916:                }
 7917: 
 7918:             }
 7919:          }
 7920:          else { // For quads
 7921: 
 7922: 
 7923:             // Compute the bilinear coordinates of the center of each diagonal.
 7924:             double xi, eta;
 7925:             double shp13[4], shp24[4];
 7926:             Point2 x0, x1, x2, x3;
 7927:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7928:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7929:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7930: 
 7931:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7932:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7933: 
 7934: 
 7935: 
 7936: 
 7937:             for (int k = kb; k < nvrt; k++) {
 7938: 
 7939:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7940:                Vector2 sideU[4];
 7941:                #pragma unroll
 7942:                for (int j = 0; j < 4; j++) {
 7943:                   Vector2 u = elem->sides[j]->u2[k];
 7944:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7945:                   sideU[j] = u;
 7946:                }
 7947: 
 7948:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7949:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7950: 
 7951:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7952:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7953:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7954:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7955:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7956:                #pragma unroll
 7957:                for (int j = 0; j < 4; j++) {
 7958:                   Node *node = elem->nodes[j];
 7959:                   if (node->isDry) continue;
 7960: 
 7961:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7962:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7963:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7964:                }
 7965:             }
 7966: 
 7967:          }
 7968: 
 7969:       }
 7970:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7971:       
 7972:    }
 7973: 
 7974: 
 7975:    __global__ void computeNodalHorizontalVelocities2(void) {
 7976:       NODE(node);
 7977: 
 7978:       const int nodeCount = node->tmp.i;
 7979: 
 7980:       if (nodeCount == 0) 
 7981:       {
 7982:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7983:          return;
 7984:       }
 7985: 
 7986:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7987:       
 7988:       const int kb = node->kb;
 7989: 
 7990:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7991:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7992:       
 7993:       
 7994:    }   
 7995: 
 7996:  
 7997: 
 7998:    __global__ void resetVelocityOpenBndNodes(void) {
 7999:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8000: 
 8001:       NODE_BND(nodebnd);
 8002: // printf("DDDDDDDDDD\n");  // XXXXXXX
 8003:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8004:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8005:       }
 8006: 
 8007:    }
 8008: 
 8009: 
 8010:    __global__ void setVelocityOpenBndNodes(void) {
 8011:    // For open boundary nodes sets their velocity to the imposed values.
 8012: 
 8013:       SIDE_BND(sidebnd);
 8014: 
 8015:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8016:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8017:          // to its segment to the average of the side velocity.
 8018: 
 8019:          for (int k = 0; k < nvrt; k++) {
 8020:             Node *n1 = sidebnd->side->n1;
 8021:             Node *n2 = sidebnd->side->n2;
 8022: 
 8023: 
 8024:             Vector2 &n1_u2 = n1->u2[k];
 8025:             Vector2 &n2_u2 = n2->u2[k];
 8026: 
 8027:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8028:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8029:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8030:             }
 8031:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8032:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8033:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8034:             }
 8035: 
 8036:          }
 8037: 
 8038:       }
 8039: 
 8040:    }
 8041: 
 8042: 
 8043:    __global__ void computeVerticalVelocity(void) {
 8044:       // Computes the vertical velocity at the (2D) element's centroid.
 8045:       // In this function we will be considering volumetric elements, with side faces and a 
 8046:       // bottom and a top face. We will call them SFs, BF and TF.
 8047:       // It computes the flux coming from BF and the SFs.
 8048:       // If the bed is moving, it takes that into account.
 8049:       // Since water is incompressible, the integral of the velocity times the normal vector
 8050:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8051:       // and the BF is equal to the flux going out from the TF.
 8052:       // TF = - BF - sum(SFs).
 8053:       // It then computes the horizontal velocity at the center of TF.
 8054:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8055:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8056:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8057: 
 8058:       ELEM(elem);
 8059: 
 8060:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8061: 
 8062:       if (elem->isDry) return;
 8063: 
 8064:       const int kb = elem->kb;
 8065:       const bool isTri = elem->isTri();
 8066: 
 8067:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8068: 
 8069:       // Compute the bottom velocity
 8070:       if constexpr(imm != 0) {
 8071:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8072:       }
 8073: 
 8074: 
 8075:       double bottomArea3D;
 8076:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8077: 
 8078:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8079: 
 8080:       double topArea3D;
 8081: 
 8082:       // Bottom face flux
 8083:       double bottomFlux = 0.0;
 8084:       Vector2 u2meanBottom = {0.0, 0.0};
 8085:       const Vector2 gradh = elem->grad2(&Node::depth);
 8086:       if constexpr(imm==2) {
 8087:          Vector3 ubed;
 8088: 
 8089:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8090:          // updateBDEF(ubed);
 8091:      
 8092:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8093: 
 8094:          // elem->w[kb] += ubed.z;
 8095:       }
 8096:       else {
 8097: 
 8098:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8099:   
 8100:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8101:          // in the direction of motion.
 8102:          const double bottomW = - dot(gradh, u2meanBottom);  
 8103:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8104: 
 8105:          // VElocity associated to the bed deformation
 8106:          double bedVelocity = 0.0;
 8107:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8108: 
 8109:          elem->w[kb] = bedVelocity + bottomW; 
 8110: 
 8111:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8112:          
 8113:       } // if imm
 8114: 
 8115:       // Compute w for kb+1 to nvrt-1
 8116:       for (int l = kb; l < nvrt - 1; l++) {
 8117: 
 8118:          // normal vector to the top face of the "volumetric" element (3D)
 8119:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8120: 
 8121:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8122:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8123: 
 8124:          // Compute the total flux at the sides
 8125:          double sideFlux = 0.0;
 8126: 
 8127:          for (int j = 0; j < elem->i34; j++) {
 8128:             const Side *side = elem->sides[j];
 8129:             const int kbs = side->kb;
 8130:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8131:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8132:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8133: 
 8134:             // The area is "clamped" meaning that it takes kb into account.
 8135:             const double sideArea = side->areaClamped(l);
 8136: 
 8137:             const double sign = elem->ssign[j]; 
 8138: 
 8139:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8140:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8141:          }
 8142:          
 8143:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8144:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8145:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8146: 
 8147:          // The flux at the top ace can be computed from the other flows.
 8148:          // All fluxes are in directions into the prism.
 8149:          const double topFlux = - sideFlux - bottomFlux;
 8150: 
 8151:          // Flux at the top face due to the horizontal velocities only
 8152:          // topFlux = topHorizontalFlux + topVerticalFlux
 8153:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8154: 
 8155:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8156:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8157: 
 8158:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8159: 
 8160:          bottomFlux = -topFlux;
 8161:          
 8162:       }
 8163: 
 8164:    }  
 8165: 
 8166: 
 8167: 
 8168: 
 8169: 
 8170: 
