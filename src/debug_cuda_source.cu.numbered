  820: struct BoundarySegment {
  821: 
  822:    bool isLand;
  823: 
  824:    double clen;  // Length of the boundary segment
  825:    double carea; // Area of the boundary segment
  826: 
  827:    int ifltype;  // Type of flow boundary condition
  828:    
  829:    // Elevation boundary condition
  830:    int iettype;  // Type of elevation boundary condition
  831:    double eth;   // Elevation time history
  832: 
  833:    // Flow boundary condition
  834:    double qthcon;  // Flow time history constant
  835:    double vobc1;   // Velocity coefficient 1
  836:    double vobc2;   // Velocity coefficient 2
  837: 
  838:    // Tracer boundary conditions
  839:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  840:    // int  itrtype[natrm];    // Tracer boundary condition type
  841: 
  842:    BoundarySegment(bool _isLand) {
  843:       isLand = _isLand;
  844:       clen = 0.0;
  845:       carea = 0.0;
  846:       ifltype = 0;
  847:       iettype = 0;
  848:       eth = 0.0;
  849:    }
  850: 
  851:    BoundarySegment(void) {
  852:       isLand = false;
  853:       clen = 0.0;
  854:       carea = 0.0;
  855:       ifltype = 0;
  856:       iettype = 0;
  857:       eth = 0.0;
  858:    }
  859: 
  860:    
  861: };
