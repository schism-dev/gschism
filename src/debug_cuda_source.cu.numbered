 1135: // This struct is used to store the boundary information for a node.
 1136: struct NodeBoundary {   
 1137:    int idx;
 1138:    BoundarySegment *segment;
 1139:    Node *node;
 1140:    
 1141:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1142:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1143: 
 1144:    bool isLand;
 1145: 
 1146:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1147:    double elbc;   // Elevation boundary condition
 1148:    double eth;    // Elevation time history
 1149: 
 1150:    double eta_mean; // Mean elevation at nodes
 1151: 
 1152:    bool isEssentialBC;
 1153: 
 1154:    Vector2 uth[nvrt];  // "Time history" velocity
 1155: 
 1156:    // Arrays for harmonic constituents (if needed)
 1157:    double  emo[nbfr];  // Elevation amplitude
 1158:    double  efa[nbfr];  // Elevation phase
 1159:    Vector2 umo[nbfr];  // velocity amplitude
 1160:    Vector2 ufa[nbfr];  // velocity phase
 1161: 
 1162: 
 1163:    NodeBoundary(void) {
 1164:       isLand = false;
 1165:    }
 1166:    NodeBoundary(bool _isLand) {
 1167:       isLand = _isLand;
 1168:    }
 1169: 
 1170:    
 1171:    __forceinline__ __device__ int numSidesForAverage() const {
 1172:    // Returns the number of sides that are connected to the node and have the same segment.
 1173:    // This is used to compute the average velocity at the node for open boundary nodes.
 1174:       int res = 0;
 1175:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1176:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1177: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1178:       return res;
 1179:    }
 1180: 
 1181: 
 1182:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1183:       assert(index == 0 || index == 1); 
 1184:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1185:    }
 1186: 
 1187: 
 1188: };
 1189: 
 1190: struct Node {
 1191: 
 1192:    // Geometry information
 1193:    int idx;        // Index of the node
 1194:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1195:    int numNodes;   // Number of nodes neighbors of this node
 1196: 
 1197:    Element **elements; // Array of pointers to the elements that share this node
 1198:    int numElements;    // Number of elements that share this node
 1199: 
 1200:    int numSides;       // Number of sides that are connected to this node
 1201: 
 1202:    Point2 p;
 1203:    Vector2 u2[nvrt];
 1204:    double  w2[nvrt];
 1205:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1206:    double z[nvrt];
 1207:    double lon, lat;
 1208:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1209:    double depth;
 1210: 
 1211:    int kb;       // Bottom index of the node
 1212: 
 1213:    bool isDry;     // True if the node is dry
 1214: 
 1215:    int iadv;     // Advection flag
 1216: 
 1217:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1218:                           // this is nullptr
 1219: 
 1220:    TempVar tmp; // Temporary variable to store different types of variables
 1221: 
 1222:    // Physical information
 1223:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1224:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1225: 
 1226:    double rho[nvrt];     // Density
 1227:    double dfv[nvrt];     // Vertical viscosity
 1228: 
 1229:    double eta1; // Elevation at nodes at previous timestep
 1230:    double eta2; // Elevation at nodes at current timestep
 1231: 
 1232:    double ETP;  // Earth Tidal Potential
 1233: 
 1234:    double pr;    // Air pressure
 1235:    double grav2; // Gravity 
 1236:    
 1237:    Vector2 dav;  // Depth averaged velocity
 1238: 
 1239:    Vector2 tau; // Wind stress vector
 1240: 
 1241:    // Vegetation parameters
 1242:    double veg_h;
 1243:    double veg_nv;
 1244:    double veg_di;
 1245:    double veg_Cd;
 1246:    double veg_h_unbent;
 1247:    double veg_di_unbent;
 1248:    double veg_nv_unbent;
 1249:    double veg_alpha_vert_mean;
 1250:    double veg_alpha0;
 1251:    double veg_alpha3D[nvrt];
 1252: 
 1253:    // Bottom drag parameters
 1254:    double Cd;       // Bottom drag coefficient   
 1255: 
 1256:    // These three are mutually exclusive
 1257:    union {
 1258:       double rmanning; // Bottom Manning's coefficient
 1259:       double rough;    // Bottom roughness length
 1260:       double drag;     // Bottom drag coefficient
 1261:    };
 1262:    Vector2 tau_bot; // Bottom stress vector
 1263: 
 1264:    double bdef1; // Bottom deformation at previous timestep
 1265:    double bdef2; // Bottom deformation at current timestep
 1266: 
 1267:    double qel; // RHS
 1268:    double coeffDiag; // Diagonal coefficient of the matrix
 1269:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1270: 
 1271:    double mP; // Search direction for conjugate gradient method
 1272:    double mR; // Residual for conjugate gradient method
 1273:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1274:    double mX; // Solution for conjugate gradient method
 1275: 
 1276:    // Meteorological forcing
 1277:    Vector2 u_air;
 1278:    double p_air;
 1279:    double t_air;
 1280:    double q_air;
 1281:    double wind_angle;  // Wind rotation angle
 1282: 
 1283:    __device__ void setWind(Vector2 &u) {
 1284:    // Sets the wind vector taking into account the wind rotation angle
 1285:    
 1286:       const double dir = atan2(-u.x,-u.y);
 1287:       const double speed = length(u);
 1288: 
 1289:       // Calculate new u and v components with added rotation angle
 1290:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1291:    }
 1292: 
 1293: 
 1294:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1295: 
 1296:    __device__ double sigmaTransitionDepth(void) const;
 1297: 
 1298:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1299:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1300:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1301:    
 1302:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1303: 
 1304:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1305: 
 1306:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1307:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1308: 
 1309:    __device__ __forceinline__ void clearMatrixRow(void) {
 1310:       // Clear the matrix row for this node
 1311: 
 1312: 
 1313:       coeffDiag = 0.0;
 1314: 
 1315:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1316: 
 1317:    }
 1318: 
 1319:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1320:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1321:       
 1322:       if (node == this) {
 1323:          coeffDiag += value;
 1324:      
 1325:       } else {
 1326:          // Search (linearly)the index of the node in the array of nodes
 1327:          // XXX: This is not efficient, see if we can improve this
 1328:          int i;
 1329:          for (i = 0; i < numNodes; i++) {
 1330:             if (nodes[i] == node) {
 1331:                break;
 1332:             }
 1333:          }
 1334:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1335:          coeffMatrix[i] += value;
 1336:       }
 1337:    }
 1338: 
 1339: 
 1340:    __device__ __inline__ void updateZCoordData(void);
 1341: 
 1342:    __device__ double compZCoord(int k) const;
 1343: 
 1344:    __device__ void updateKb(void);
 1345: 
 1346:    __device__ __forceinline__ void computeBottomDragCd(void);
 1347: 
 1348: 
 1349: 
 1350: };
