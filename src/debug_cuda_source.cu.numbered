 7025:    __global__ void resetVelocityOpenBndNodes(void) {
 7026:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7027: 
 7028:       NODE_BND(nodebnd);
 7029: printf("DDDDDDDDDD\n");
 7030:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7031:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7032:       }
 7033: 
 7034:    }
