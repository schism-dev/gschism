 8457: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8458:    Element *elems = mesh->localElemData;
 8459: 
 8460:    *addr = elems;
 8461:    *sizeElement = sizeof(Element);
 8462:    switch (varCode) {
 8463:       case (int)VarCode::z:
 8464:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8465:          *sizeType = sizeof(double);
 8466:          break;
 8467:       case (int)VarCode::x:
 8468:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8469:          *sizeType = sizeof(Vector2);
 8470:          break;
 8471:       case (int)VarCode::gradETP:
 8472:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8473:          *sizeType = sizeof(Vector2);
 8474:          break;
 8475:       case (int)VarCode::area:
 8476:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8477:          *sizeType = sizeof(double);
 8478:          break;
 8479:       case (int)VarCode::depth:
 8480:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8481:          *sizeType = sizeof(double);
 8482:          break;
 8483:       case (int)VarCode::radius:
 8484:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8485:          *sizeType = sizeof(double);
 8486:          break;
 8487:       case (int)VarCode::ghat:
 8488:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8489:          *sizeType = sizeof(Vector2);
 8490:          break;
 8491:       case (int)VarCode::kb:
 8492:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8493:          *sizeType = sizeof(int);
 8494:          break;
 8495:       case (int)VarCode::isdry:
 8496:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8497:          *sizeType = sizeof(int);
 8498:          break;            
 8499:       case (int)VarCode::w:
 8500:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8501:          *sizeType = sizeof(double);
 8502:          break;
 8503:       case (int)VarCode::FaceIndices:
 8504:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8505:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8506:          *sizeType = sizeof(Node);
 8507:          break;
 8508:       default:
 8509:          *offset = -1;
 8510:    }
 8511: }
