 1575: __device__ __inline__ double min3(double a, double b, double c) {
 1576:    return min(a, min(b, c));
 1577: }
 1578: 
 1579: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1580:    return min(a, min(b, min(c, d)));
 1581: }
