 8424: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8425:    Element *elems = mesh->localElemData;
 8426: 
 8427:    *addr = elems;
 8428:    *sizeElement = sizeof(Element);
 8429:    switch (varCode) {
 8430:       case (int)VarCode::z:
 8431:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8432:          *sizeType = sizeof(double);
 8433:          break;
 8434:       case (int)VarCode::x:
 8435:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8436:          *sizeType = sizeof(Vector2);
 8437:          break;
 8438:       case (int)VarCode::gradETP:
 8439:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8440:          *sizeType = sizeof(Vector2);
 8441:          break;
 8442:       case (int)VarCode::area:
 8443:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8444:          *sizeType = sizeof(double);
 8445:          break;
 8446:       case (int)VarCode::depth:
 8447:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8448:          *sizeType = sizeof(double);
 8449:          break;
 8450:       case (int)VarCode::radius:
 8451:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8452:          *sizeType = sizeof(double);
 8453:          break;
 8454:       case (int)VarCode::ghat:
 8455:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8456:          *sizeType = sizeof(Vector2);
 8457:          break;
 8458:       case (int)VarCode::kb:
 8459:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8460:          *sizeType = sizeof(int);
 8461:          break;
 8462:       case (int)VarCode::isdry:
 8463:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8464:          *sizeType = sizeof(int);
 8465:          break;            
 8466:       case (int)VarCode::w:
 8467:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8468:          *sizeType = sizeof(double);
 8469:          break;
 8470:       case (int)VarCode::FaceIndices:
 8471:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8472:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8473:          *sizeType = sizeof(Node);
 8474:          break;
 8475:       default:
 8476:          *offset = -1;
 8477:    }
 8478: }
