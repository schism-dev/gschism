 2483:    template<typename T>
 2484:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2485:       // Get the values of the field at the nodes of the element
 2486:       res[0] = nodes[0]->*field;
 2487:       res[1] = nodes[1]->*field;
 2488:       res[2] = nodes[2]->*field;
 2489:       if (isQuad()) res[3] = nodes[3]->*field;
 2490:       else          res[3] = T();
 2491:    }
 2492: 
 2493:    template<typename T>
 2494:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2495: 
 2496:       assert(level < nvrt && "Level is out of range");
 2497:       // Get the values of the field at the nodes of the element
 2498:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2499:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2500:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2501:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2502:       else          res[3] = T();
 2503:    }    
 2504: 
 2505:    template<typename T>
 2506:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2507: 
 2508:       assert(level < nvrt && "Level is out of range");
 2509: 
 2510:       // Get the values of the func at the nodes of the element
 2511:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2512:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2513:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2514:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2515:       else          res[3] = T();  // This is 0.0 or a zero vector
 2516: 
 2517:    }      
 2518: 
 2519:    template<typename T>
 2520:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2521:       // Get the values of the field at the nodes of the element
 2522:       res[0] = sides[0]->*field;
 2523:       res[1] = sides[1]->*field;
 2524:       res[2] = sides[2]->*field;
 2525:       if (isQuad()) res[3] = sides[3]->*field;
 2526:       else          res[3] = T();
 2527:    }
 2528: 
 2529:    template<typename T>
 2530:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2531: 
 2532:       assert(level < nvrt && "Level is out of range");
 2533: 
 2534:       // Get the values of the field at the nodes of the element
 2535:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2536:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2537:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2538:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2539:       else          res[3] = T();
 2540:    }    
 2541: 
 2542:    template<typename T>
 2543:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2544: 
 2545:       assert(level < nvrt && "Level is out of range");
 2546: 
 2547:       // Get the values of the func at the nodes of the element
 2548:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2549:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2550:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2551:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2552:       else          res[3] = T();  // This is 0.0 or a zero vector
