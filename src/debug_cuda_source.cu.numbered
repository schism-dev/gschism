 3812:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3813: 
 3814:       SIDE(side);
 3815: 
 3816: 
 3817:       side->U = {0.0, 0.0}; 
 3818:          
 3819:       if(side->isDry) return;
 3820: 
 3821:       const Node *node1 = side->n1;
 3822:       const Node *node2 = side->n2;
 3823: 
 3824:       // Vertically integrated velocity U (in ll if ics=2)
 3825:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3826:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3827:       }
 3828: 
 3829:    }
 3830: 
 3831:    __global__ void computeBottomDragVegetation(void) {
 3832:       // UNFINISHED. CHECK THIS:
 3833:       // How many kernels are needed? Why so many for loops?
 3834:       // Is the loop on sides needed?
 3835: 
 3836:       NODE(node);
 3837: 
 3838:       const int    kb      = node->kb;
 3839:       const double htot    = node->htot2();
 3840:       const double rough   = node->rough;
 3841: 
 3842: 
 3843:       if (node->isDry) {
 3844:          // Default values for dry nodes
 3845:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3846:          /// XXX CHECK INDICES
 3847:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3848:       }
 3849: 
 3850:       // Compute bottom drag Cd
 3851:       //--------------------------------
 3852: 
 3853:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3854:       if (nchi==1) {
 3855: 
 3856:          bool ltmp = false; // for WBL iteration
 3857: 
 3858:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3859:          // Drag at nodes
 3860:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3861:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3862:         
 3863:          const double rough = node->rough;
 3864:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3865:          if (node->rough == 0.0) {
 3866:             node->Cd = 0.0;
 3867: 
 3868:          } else { //roughness >0 
 3869:             
 3870:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 3871:             const double bthick = max(dzb_min, bthick_ori);
 3872: 
 3873:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3874: 
 3875:             double tmp = 1.0/(2.5*log(bthick/rough));
 3876:             node->Cd = tmp*tmp;
 3877: 
 3878:          } // if rough
 3879: 
 3880: 
 3881:          // RECOVER THIS: XXX
 3882:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3883:          // Output warning for WBL if iteration didn't converge
 3884: 
 3885: 
 3886:       } // nchi==1
 3887: 
 3888:       //   Bottom stress in m^2/s^2
 3889:       if (node->rho[kb + 1] >= -98.0)
 3890:       {
 3891:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3892:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3893:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3894:          // !sediment erosion: this part needs more documentation
 3895:       }
 3896: 
 3897:     
 3898:       // Compute vegetation parameters
 3899:       //--------------------------------
 3900: 
 3901:       // SAV constants
 3902:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3903:       constexpr double veg_cfpsi = 0.16;
 3904: 
 3905:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3906:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3907: 
 3908:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3909:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3910:          int kbin = 0; // bin index
 3911:          for (int k = kb; k < nvrt; k++) {
 3912:             // Computes node height above the bottom level
 3913:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 3914:             assert(false && "Vertical variation of vegetation not implemented");
 3915: 
 3916:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3917:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3918:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3919:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3920:             // } else {
 3921:             //    // Find the bin at which the current vertical level is
 3922:             //    while (kbin<nbins_veg_vert) {
 3923:             //       const double zn = node->z[kbin];
 3924:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3925:             //          break;
 3926:             //       } // if
 3927:             //       kbin++;
 3928:             //    } // while
 3929:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3930: 
 3931:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3932:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3933:                
 3934:             //    // Linear interpolation of the vegetation parameters
 3935:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3936:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3937:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3938:             // } // if rl10
 3939: 
 3940:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3941: 
 3942:          } // for k
 3943: 
 3944: 
 3945:       } else { // Ganthy (iveg=2)
 3946:       //  Modify canopy height, diameter, and density
 3947: 
 3948:          // Make sure there is vegetation on this node
 3949:          if (node->veg_h_unbent > 0.0) {
 3950:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3951: 
 3952:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3953:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3954:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3955: 
 3956:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3957:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3958:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3959:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3960:          } // if veg_h_unbent
 3961: 
 3962:          for (int k = 0; k < nvrt; k++) {
 3963:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3964:          } // for k
 3965:       
 3966: 
 3967:       } // if iveg
 3968:      
 3969:          
 3970: 
 3971:       // Compute vertical mean of veg_alpha3D
 3972:       if (iveg != 0) {
 3973:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3974:          double sum1=0.0;
 3975:          double sum2=0.0;
 3976:          // Integrate over each level under the canopy...
 3977:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3978:             const double Dz = node->Dz(k);
 3979: 
 3980:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3981:             sum2 += Dz;
 3982: 
 3983:          } // for k
 3984: 
 3985:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3986:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3987: 
 3988:       } // if iveg
 3989: 
 3990:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3991: 
 3992:    }
 3993: 
 3994:    __global__ void computeVegetationAndDragParameters(void) {
 3995:       // Computes the vegetation and drag model parameters:
 3996:       // chi, \tilde\chi, beta, \breve{H}
 3997:       
 3998:       SIDE(side);
 3999: 
 4000:       const double htot = side->htot2();
 4001:       const int    kb   = side->kb;
 4002: 
 4003:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4004: 
 4005:       const double veg_h     = side->veg_h();
 4006:       const double veg_nv    = side->veg_nv();
 4007:       const double veg_c     = side->veg_c();
 4008:       const double veg_beta  = side->veg_beta;
 4009:       const double veg_alpha = side->veg_alpha_vert_mean();
 4010: 
 4011:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4012:       // Velocity magnitude at the bottom level
 4013:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4014:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4015:       side->chi2 = side->Cd()*vmag1;
 4016:       side->chi  = side->chi2;
 4017:       if constexpr(iveg != 0) {
 4018:          const Node *n1 = side->n1;
 4019:          const Node *n2 = side->n2;
 4020:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4021:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4022:       }
 4023: 
 4024:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4025: 
 4026:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4027:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4028:       double magUa = 0.0;
 4029:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4030:          // 3D wet side with veg...
 4031: 
 4032:          double magUa = 0.0;
 4033:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4034:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4035: 
 4036:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4037:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4038:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4039: 
 4040:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4041:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4042: 
 4043:                // Velocity magnitude at the bottom (l) of the level
 4044:                const double ul = length(side->u2[k]);
 4045: 
 4046:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4047:                magUa += Dz*0.5*(uh + ul);
 4048: 
 4049:             } // if HasVegetation
 4050:          } // for k
 4051:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4052: 
 4053:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4054:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4055:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4056:             const double zCpy = side->zTopCanopy();
 4057:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4058:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4059:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4060:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4061:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4062:          } // if isSubmerged
 4063:       } // if iveg   
 4064: 
 4065:       // Computes the friction modified depth, \breve{H} in notes
 4066:       if (side->is2D()) { // 2D
 4067: 
 4068:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4069:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4070: 
 4071:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4072: 
 4073:          side->hhat = htot*htot/fricH; 
 4074: 
 4075:       } else { // 3D
 4076:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4077: 
 4078:          if constexpr(iveg != 0) {
 4079:             
 4080:             if (side->isSubmerged()) { 
 4081:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4082:                side->hhat -= veg_c*Hhat_alpha;
 4083: 
 4084:             } else { // Emergent
 4085:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4086:             }
 4087:          } // if iveg
 4088: 
 4089:          // Enforce positivity for 3D model
 4090:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4091:       } // if 3D
 4092: 
 4093:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4094: 
 4095:         
 4096:    }
 4097: 
 4098: 
 4099: 
 4100:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4101:    // Computes the density gradient between two elements, e1 and e2.
 4102:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4103:    // zero in the direction normal to the side. 
 4104:    // 
 4105:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4106:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4107:    //
 4108:    // Input:
 4109:    //    e1: Element
 4110:    //    e2: Neighbor element (or nullptr if boundary)
 4111:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4112:    //    k: Index of the half-level at which the density is interpolated
 4113:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4114:    // 
 4115:    // Output:
 4116:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4117:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4118: 
 4119:       if (e2 == nullptr || e2->isDry) {
 4120:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4121: 
 4122:          Side *side = e1->sides[j];
 4123:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4124:                  
 4125:          if constexpr(ics == 1) {
 4126:             vec = side->n; // Normal vector to the side
 4127:          } else {
 4128:             // IMPLEMENT THIS XXXXXX
 4129:             // !replace with xel, yel?
 4130:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4131:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4132:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4133:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4134:          } //ics
 4135:                    
 4136:          diffRho = 0.0;
 4137: 
 4138:       } else { //internal and wet
 4139:          if constexpr(ics==1) {
 4140:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4141: 
 4142:             // Vector from e1 to e2
 4143:             vec = toVector2(e2->center - e1->center);
 4144: 
 4145:          } else { 
 4146:             // IMPLEMENT THIS XXXXXX
 4147:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4148:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4149:             //                   alow(j)=xctr2
 4150:             //                   bdia(j)=yctr2
 4151:          } // ics
 4152: 
 4153:          diffRho = rho2 - e1->demeanedDensity(k);
 4154:       }
 4155: 
 4156:    }
 4157: 
 4158:    __global__ void computeDensityCubicSplines(void) {
 4159:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4160: 
 4161:       ELEM(elem);
 4162: 
 4163:       if (elem->isDry) return;
 4164: 
 4165:       const int kb = elem->kb;
 4166: 
 4167:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4168:       if (elem->is2D()) {
 4169:          // In the 2D case, the density is constant at the prism level. 
 4170:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4171:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4172:       } else { //3D
 4173: 
 4174:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4175:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4176:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4177:          ///// XXXX CHECK INDICES!!!!!
 4178:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4179:       } // 2D/3D
 4180: 
 4181:    }
 4182: } // extern "C"
 4183: 
 4184: 
 4185: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4186: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4187: 
 4188:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4189: 
 4190:    const int kb  = elem->kb;
 4191:    const int kb2 = elem2->kb;
 4192: 
 4193:    // z-coordinate of prism of elem
 4194:    const double zp = elem->z_prism(k);
 4195: 
 4196:    double rho = 0.0;
 4197: 
 4198:    if (elem2->is2D()) {
 4199:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4200: 
 4201:    } else {  // 3D
 4202: 
 4203:       // eta_min may be < zmax
 4204:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4205:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4206: 
 4207:       // (Extrapolate density below bottom, we will fix it later)
 4208:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4209:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4210:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4211:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4212:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4213:    } // 2D/3D
 4214:      
 4215: 
 4216:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4217:    // Now we need to fix it.
 4218:    if (elem->z[k] < elem2->z[kb2]) {
 4219:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4220: 
 4221:       // There are two methods to adjust the density at the bottom of the element.
 4222:       // iunder_deep=0: 
 4223:       const double depth1 = abs(elem->z[kb]); // larger depth
 4224: 
 4225:       if (iunder_deep==0) {
 4226: 
 4227:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4228: 
 4229:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4230: 
 4231:       } else { // iunder_deep != 0
 4232: 
 4233:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4234: 
 4235:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4236: 
 4237:          //   Demeaned density at the same z coordinate as
 4238:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4239:          }
 4240: 
 4241:       } // if iunder_deep
 4242:    } // if elem->z[kb] < elem2->z[kb]
 4243: 
 4244:    return rho;
 4245: }
 4246: 
 4247: 
 4248: extern "C" {
 4249:    __global__ void computeDensityGradient(void) {
 4250: 
 4251:          // Compute the horizontal density gradient at each element.
 4252:       // It works in two steps:
 4253:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4254:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4255:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4256:       //             gradRho.r1 = rho1 - rho0
 4257:       //             gradRho.r2 = rho2 - rho0
 4258:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4259:       // 
 4260:       //  NOTE: We use de-meaned densities.
 4261: 
 4262:       ELEM(elem);
 4263: 
 4264:       if (elem->isDry) return;
 4265: 
 4266:       const int kb  = elem->kb;
 4267:       const int i34 = elem->i34;
 4268: 
 4269:       for (int k = kb + 1; k < nvrt; k++) {
 4270:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4271:          //             gradRho.r1 = rho1 - rho0
 4272:          //             gradRho.r2 = rho2 - rho0
 4273:          int icount = 0;
 4274:          double sumRx = 0.0;
 4275:          double sumRy = 0.0;
 4276:          for (int j1=0; j1<i34; j1++) { 
 4277: 
 4278:             const int j2 = elem->nxq(j1 + 1);
 4279: 
 4280:             // Pairs of consecutive neighbor elements of elem
 4281:             const Element *e1 = elem->nghbElems[j1];
 4282:             const Element *e2 = elem->nghbElems[j2];
 4283: 
 4284:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4285:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4286:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4287: 
 4288:             // Compute the density difference and the vector from elem to e1 and e2
 4289:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4290:             double diffRho1, diffRho2;
 4291:             Vector2 vec1, vec2;
 4292:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4293:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4294: 
 4295:             const double rl1 = length(vec1);
 4296:             const double rl2 = length(vec2);
 4297:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4298: 
 4299:             const double delta = cross(vec1, vec2);
 4300:             const double sintheta = abs(delta)/(rl1*rl2);
 4301: 
 4302:             // To avoid problems, avoid elements with small angle between vectors
 4303:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4304:             const bool validEq = (sintheta > sin_one_deg);
 4305: 
 4306:             if (validEq) {
 4307:                // Solve the system of equations to get the density gradient at elem
 4308:                icount++;
 4309:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4310:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4311:                sumRx += Rx;
 4312:                sumRy += Ry;
 4313:             }
 4314:          } // for j1
 4315: 
 4316:          // Compute the average density gradient at elem
 4317:          if (icount==0) {
 4318:            // Bad mesh quality; bail out with 0 b-cc
 4319:            elem->gradRho[k] = {0.0, 0.0};
 4320:          } else {
 4321:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4322:          }
 4323: 
 4324:       } // for k
 4325: 
 4326:    }
 4327: 
 4328:    __global__ void computeBaroclinicTerm(void) {
 4329:    // Computes the baroclinic term at sides (at half levels).
 4330:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4331:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4332: 
 4333:       SIDE(side);
 4334: 
 4335:       if (side->isDry) return;
 4336: 
 4337:       const Element *e1 = side->elems[0];
 4338:       const Element *e2 = side->elems[1];      
 4339:       const int kb = side->kb;
 4340:       
 4341:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4342: 
 4343:       // interpolates vertically the density gradient of the two elements at the half level/
 4344: 
 4345:       // Starts the integration at the surface and goes down to the bottom
 4346:       int k1 = nvrt - 1;
 4347:       int k2 = nvrt - 1;
 4348: 
 4349:       side->bcc[nvrt-1] = {0.0, 0.0};
 4350:       for (int k = nvrt-1; k >= kb; k--) {
 4351:       // For each prism level (from surface to bottom)...
 4352: 
 4353:          // For both elements, interpolate density gradient at the side's half level.
 4354:          // The gradient at the side is the average of the gradients at the elements.
 4355:          // w1, w2 are used to take into account boundary sides, with just one element.
 4356:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4357:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4358:          const double wsum = w1 + w2;
 4359:          w1 = w1/wsum;
 4360:          w2 = w2/wsum;
 4361:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4362: 
 4363:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4364:          Vector2 gradRho = {0.0, 0.0};
 4365:          if (e1 != nullptr && k > kb) {
 4366:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4367:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4368:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4369:             
 4370:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4371:          }      
 4372:          if (e2 != nullptr && k > kb) {
 4373:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4374:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4375:             
 4376:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4377:          }
 4378: 
 4379:          if constexpr(ics==2) {
 4380:             // IMPLEMENT THIS XXXXXX
 4381:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4382:             // swild(1)=tmp1
 4383:             // swild(2)=tmp2
 4384:          }
 4385:          
 4386:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4387:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4388:          // CHECK INDICES!!! XXX
 4389:          const double grav3 = side->grav3();
 4390:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4391:       } // for
 4392: 
 4393:    }
 4394: 
 4395: 
 4396: 
 4397:    __global__ void computeHorGradientAtSide(void) {
 4398: 
 4399:       // Compute the horizontal density gradient at each element.
 4400:       // It works in two steps:
 4401:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4402:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4403:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4404:       //             gradRho.r1 = rho1 - rho0
 4405:       //             gradRho.r2 = rho2 - rho0
 4406:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4407:       // 
 4408:       //  NOTE: We use de-meaned densities.
 4409: 
 4410:       SIDE(side);
 4411: 
 4412:       if (side->isDry) return;
 4413: 
 4414:       // Computes the gradient of the variables at the side center.
 4415:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4416:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4417:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4418: 
 4419:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4420:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4421:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4422:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4423: 
 4424: 
 4425:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4426:          side->gradEta1.x, side->gradEta1.y, 
 4427:          side->gradEta2.x, side->gradEta2.y, 
 4428:          side->gradETP.x, side->gradETP.y, 
 4429:          side->gradPr.x, side->gradPr.y);
 4430: 
 4431: 
 4432:    }
 4433: 
 4434: 
 4435:    __global__ void solveMomentumEquations(double time) {
 4436: 
 4437:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4438:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4439: 
 4440:       SIDE(side);
 4441: 
 4442:       if (side->isDry) 
 4443:       {
 4444:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4445: 
 4446:          return;
 4447:       }
 4448: 
 4449:       const Node *n1 = side->n1;
 4450:       const Node *n2 = side->n2;
 4451: 
 4452:       const int kb = side->kb;
 4453: 
 4454:       const double veg_h = side->veg_h();
 4455:       const double grav3 = side->grav3();
 4456: 
 4457:       if (side->is2D()) {
 4458:          // Warning: Do not use htot2, which is updated.
 4459:          const double htot = side->htot1();
 4460:          const double hhat = side->hhat;
 4461: 
 4462:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4463: 
 4464:          Vector2 tau2 = {0.0, 0.0};
 4465:           
 4466:          if constexpr(ics==1) {
 4467:             tau2 = side->tau();
 4468: 
 4469:          } else {
 4470:             assert(false && "Not implemented: ics == 2");
 4471:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4472:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4473:             // taux2=(vn1+tt1)*0.5d0
 4474:             // tauy2=(vn2+ss1)*0.5d0
 4475:          } // if ics         
 4476: 
 4477:          // hat_gam has units of m/s
 4478: 
 4479:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4480: 
 4481:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4482:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4483: 
 4484:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4485: 
 4486:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4487:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4488: 
 4489:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4490: 
 4491:       }
 4492:       else { // 3D
 4493: 
 4494:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4495:          // 
 4496:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4497:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4498:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4499:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4500:          // k+1 and k.
 4501: 
 4502: 
 4503:          // // Define layer thickness & viscosity
 4504:          // for (int k=kb + 1; k<nvrt; k++) {
 4505:          //    const double dzz = side->Dz(k - 1);
 4506: 
 4507:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4508: 
 4509:          //    // Vertical viscosity at the face center
 4510:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4511:         
 4512:          // }
 4513: 
 4514: 
 4515:          const int ndim = nvrt - kb;
 4516:          const double zTopCanopy = side->zTopCanopy();
 4517: 
 4518:          // Initialize the tridiagonal system
 4519:          for (int k=kb+1; k<nvrt; k++) {
 4520:             
 4521:             const int kin = k - kb;
 4522: 
 4523:             // Vertical viscosity at the face center
 4524:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4525:             const double dzz = side->Dz(k);
 4526: 
 4527:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 4528:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 4529:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4530: 
 4531:             alow[kin] = 0.0;
 4532:             cupp[kin] = 0.0;
 4533:             bdia[kin] = 0.0;
 4534: 
 4535:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4536:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4537:             if constexpr(iveg != 0) {	
 4538: 
 4539:                // We divide the code into two parts, one that deals with layers k, k+1, and another that deals with k-1, k.
 4540:                // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4541:                // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4542: 
 4543:                // First part: layers k, k+1
 4544:                if (k < nvrt - 1) {
 4545:                              
 4546:  
 4547:                   // If there is vegetation at this level...
 4548:                   if (zTopCanopy > side->zc[k]) {
 4549:                      // If the canopy is above the k layer...
 4550:                      
 4551:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4552:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4553:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4554:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4555: 
 4556:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4557:                      const double vmag2 = length(ut2);
 4558:                      const double vmag1 = length(side->u2[k]);
 4559:                      const double vmag = 0.5*(vmag1 + vmag2);
 4560:                      
 4561:                      // Computes the vegetation alpha at the face center
 4562:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4563: 
 4564:                      cff1 += veg_alpha_sd*dt*vmag;
 4565:                   } // if iveg
 4566: 
 4567:                   const double tmp = dt*dfz/dzz;
 4568:                   cupp[kin] += cff1*dzz/6.0 - tmp;
 4569:                   bdia[kin] += cff1*dzz/3.0 + tmp;
 4570:                
 4571:                }
 4572: 
 4573: 
 4574:                // Second part: layers k-1, k
 4575:                if (k > kb + 1) {
 4576: 
 4577:                   double cff1 = 1.0; //init \bar{c^k}
 4578: 
 4579:                   // If there is vegetation at this level...
 4580:                   if (zTopCanopy > side->zc[k-1]) {
 4581:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4582:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4583: 
 4584:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4585: 
 4586:                      const double vmag2 = length(ut2);
 4587:                      const double vmag1 = length(side->u2[k-1]);
 4588:                      const double vmag = 0.5*(vmag1 + vmag2);
 4589: 
 4590:                      // Computes the vegetation alpha at the face center
 4591:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4592:                      cff1 += veg_alpha_sd*dt*vmag;
 4593:                   } // if zTopCanopy
 4594: 
 4595:                   const double tmp = dt*dfz/dzz;
 4596:                   alow[kin] += cff1*dzz/6.0 - tmp;
 4597:                   bdia[kin] += cff1*dzz/3.0 + tmp;
 4598: 
 4599:                } else { // Bottom boundary
 4600:                   // This occurs at the bottom, where the bottom drag is applied.
 4601: 
 4602:                   bdia[kin] += dt*side->chi2;
 4603: 
 4604:                } // if (k > kb + 1)
 4605: 
 4606: 
 4607: 
 4608:             }
 4609:          }
 4610: 
 4611: 
 4612:          // Computes the RHS.
 4613:          // -----------------
 4614: 
 4615:          //	BC to be imposed at the end.
 4616: 
 4617:          const Vector2 gradETP  = side->gradETP;
 4618:          const Vector2 gradPr   = side->gradPr;
 4619:          const Vector2 gradEta1 = side->gradEta1;
 4620:          const Vector2 gradEta2 = side->gradEta2;
 4621: 
 4622:          const Vector2 *btu = side->btu;
 4623:          const Vector2 *u2  = side->u2;
 4624:          const double coriolis = side->coriolis;
 4625:          const Vector2 *d2uv = side->d2uv;
 4626: 
 4627: 
 4628:          for (int k = kb + 1; k<nvrt; k++) {
 4629:             const int kin = k - kb;
 4630: 
 4631:             const double dz_0 = side->Dz(k);
 4632:             const double dz_1 = side->Dz(k+1);  
 4633: 
 4634:             rrhs[kin] = {0.0, 0.0};
 4635:             double dz = 0.0;
 4636: 
 4637:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 4638:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 4639:             if (k < nvrt  ) dz += 0.5*dz_1;
 4640:             if (k > kb + 1) dz += 0.5*dz_0;
 4641: 
 4642:             // Elevation gradient, atmospheric pressure and tidal potential
 4643:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 4644: 
 4645:             // Coriolis, advection, wind stress, and horizontal viscosity
 4646:             if (k < nvrt - 1) {
 4647: 
 4648: 
 4649:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 4650:                                         (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 4651:                                         dt*(2.0*d2uv[k] + d2uv[k + 1]));
 4652: 
 4653:                //diff stress tensors 1006
 4654:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 4655:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 4656:                   assert(false && "Not implemented: itur == 5");
 4657:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 4658:                }
 4659: 
 4660:             } else { // k=nvrt
 4661:                Vector2 tau2 = {0.0, 0.0};
 4662:                if constexpr(ics==1) {
 4663:                   tau2 = side->tau();
 4664:                } else {
 4665:                   assert(false && "Not implemented: ics == 2");
 4666:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4667:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4668:                   // taux2=(vn1+tt1)*0.5d0
 4669:                   // tauy2=(vn2+ss1)*0.5d0
 4670:                } // if ics
 4671: 
 4672:                rrhs[kin] += dt*tau2;
 4673: 
 4674:             } // if k<nvrt
 4675: 
 4676:             if (k > kb + 1) {
 4677:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k - 1] + 
 4678:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 4679:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 4680: 
 4681: 
 4682:                // diff stress tensors 1006
 4683:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 4684:                   assert(false && "Not implemented: itur == 5");
 4685:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 4686:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 4687:                }
 4688: 
 4689:             } // if k>kbs + 1
 4690: 
 4691:             // Baroclinic
 4692:             Vector2 *bcc = side->bcc;
 4693:             if constexpr(ibc == 0) {
 4694:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 4695:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 4696: 
 4697:             } // if ibc==0
 4698: 
 4699: 
 4700:          } // k=kb + 1,nvrt
 4701: // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4702:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 4703: 
 4704:          for (int k=kb + 1; k<nvrt; k++) {
 4705:             const int kin = k - kb;
 4706: 
 4707:             // Velocity is always clamped to maximum values
 4708:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 4709:          } // k
 4710:       }
 4711: 
 4712:       // Impose velocity boundary conditions at the bottom
 4713:       if constexpr(imm == 2) { //no slip
 4714:          double dep;
 4715:          Vector2 vel;
 4716: 
 4717:          assert(false && "Not implemented: imm == 2");
 4718:          //update_bdef(time, x0, y0, dep, vel);
 4719:          // side->u2[kb] = vel;
 4720: 
 4721:       } else {
 4722:          if (side->Cd() == 0.0) {
 4723:             side->u2[kb] = side->u2[kb + 1];
 4724:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 4725:             side->u2[kb] = {0.0, 0.0};
 4726:          }
 4727:           
 4728:       } // if imm
 4729: 
 4730:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4731:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 4732:       
 4733: 
 4734:    }
 4735: 
 4736: 
 4737:    __device__ void applyMomentumBC(void) {
 4738: 
 4739:       SIDE_BND(side_bnd);
 4740: 
 4741:       Side *side = side_bnd->side;
 4742:       const BoundarySegment *segment = side_bnd->segment;
 4743:       const Node *n1 = side->n1;
 4744:       const Node *n2 = side->n2;
 4745: 
 4746:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 4747:       const bool isLand     = (segment == (BoundarySegment *)landSegment);
 4748:       const bool isInternal = (segment == (BoundarySegment *)internalSegment);
 4749: 
 4750:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 4751:       const int kb = side->kb;
 4752: 
 4753:       if (!isLand && segment->ifltype != 0) {
 4754:          const Vector2 *uth = side->uth;
 4755: 
 4756:          for (int k=kb; k < nvrt; k++) {
 4757:             assert(segment->ifltype == -2 || (uth[k].x >= -98 && uth[k].y >= -98) && "Momentum BC: Side has no velocity boundary conditions");
 4758: 
 4759:             Vector2 uth = side->uth[k];
 4760: 
 4761:             if (segment->ifltype == -1) {
 4762:                // Flather 1
 4763: 
 4764:                const double depth = side->depth();
 4765: 
 4766:                assert(n1->nodeBnd->eta_mean >= -98 && n2->nodeBnd->eta_mean >= -98 && "Flather bnd elevation not assigned");
 4767:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 4768: 
 4769:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->etaMeanBnd()) + dot(uth, side->n);
 4770: 
 4771:                side->u2[k] = vnorm*side->n;
 4772: 
 4773:             } else if (segment->ifltype == -2) { // Discharge
 4774: 
 4775: 
 4776:                const double eta1 = side->eta1();
 4777:                const double eta2 = side->eta2();
 4778:                const double htot = side->htot2();
 4779: 
 4780:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 4781:                assert(false && "Not implemented: Discharge bc");
 4782:                // const double dischrg = discharge(eta1);
 4783:                const double dischrg = 0.0; // XXX REMOVE
 4784:                
 4785: 
 4786:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 4787: 
 4788:                const double vnorm = dischrg*eta2/htot;
 4789: 
 4790:                side->u2[k] = vnorm*side->n;
 4791: 
 4792: 
 4793:             }
 4794:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 4795:                const double vnorm = dot(side->u2[k], side->n);
 4796: 
 4797:                double rat;
 4798:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 4799:                else              rat = segment->vobc2; // outgoing
 4800: 
 4801:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*uth;
 4802:             }
 4803:             else { // not Flather or 3D radiation
 4804:                side->u2[k] = uth;
 4805: 
 4806:             } // if (segment->ifltype...
 4807: 
 4808:          }
 4809: 
 4810:       }
 4811:       else if (isLand) { // land bnd
 4812:          if constexpr(islip == 0) { // free slip
 4813:             for (int k=kb; k < nvrt; k++) {
 4814:                double vnorm = 0.0; // for most cases
 4815:                const double vtan = dot(side->u2[k], side->t());
 4816:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 4817:             }
 4818: 
 4819:          } else { // no slip
 4820:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 4821: 
 4822:          }
 4823:       } // if (side segment type...
 4824: 
 4825:       
 4826: 
 4827: 
 4828: 
 4829:    }
 4830: 
 4831: 
 4832:    __device__ void shapiroFilter1(void) {
 4833:       // First step of the Shapiro filter (normally used if indvel<=0)
 4834:       // Computes the filtered values and stores them in bcc (as a temporary array).
 4835: 
 4836:       if constexpr(ishapiro == 0) return;
 4837: 
 4838:       SIDE(side);
 4839: 
 4840:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4841: 
 4842:       if (side->isDry || isInternal ) return;
 4843: 
 4844:       const int kb = side->kb;
 4845: 
 4846:       for (int mm = 1; mm <= niter_shap; mm++) {
 4847: 
 4848: 
 4849:          // Internal wet sides
 4850:          for (int k = kb + 1; k < nvrt; k++) {
 4851:             // WARNING: reusing bcc as a temporary array to store the suru values.
 4852:             side->bcc[k] = {0.0, 0.0};
 4853:             Vector2 suru = {0.0, 0.0};
 4854: 
 4855:             for (int j=0; j<4; j++) {
 4856: 
 4857:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 4858:                
 4859:                int kin = k;
 4860:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 4861:                
 4862:                if constexpr(ics==1) {
 4863:                   suru += side->u2[kin];
 4864:                } else {
 4865:                   assert(false && "Not implemented: ics == 2");
 4866:                   // Vector2 vn1, vn2;
 4867:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 4868:                   // suru=suru+vn1;
 4869:                   // surv=surv+vn2;
 4870:                }
 4871:             }
 4872: 
 4873:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 4874: 
 4875:          }
 4876:       }
 4877:    }
 4878: 
 4879:    __device__ void shapiroFilter2(void) {
 4880:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 4881: 
 4882:       if constexpr(ishapiro == 0) return;
 4883: 
 4884:       SIDE(side);
 4885: 
 4886:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4887: 
 4888:       if (side->isDry || isInternal ) return;
 4889: 
 4890:       const int kb = side->kb;
 4891: 
 4892:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 4893: 
 4894:       if (side->is2D()) {
 4895:          side->u2[kb] = side->u2[nvrt - 1];
 4896:          
 4897:       } else {
 4898:          // 3D
 4899:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 4900:          
 4901:       }
 4902: 
 4903:    }
 4904: 
 4905: 
 4906:    __global__ void ul0UpdateZCoords(void) {
 4907:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 4908:       
 4909:       NODE(node);      
 4910: 
 4911:       if (node->isDry2()) { 
 4912: 
 4913:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 4914: 
 4915:          if constexpr(ivcor != 1) node->kb = 0;
 4916: 
 4917:       } else {
 4918: 
 4919:          node->updateKb();
 4920:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 4921: 
 4922:       } // if wet or dry
 4923: 
 4924:       // We use the temp.b field to store the previous state of isDry.
 4925:       node->tmp.b = node->isDry;
 4926: 
 4927:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 4928:       node->isDry = true;
 4929: 
 4930:    }
 4931: 
 4932:    __global__ void ul0ComputeDryElementsAndNodes(void)
 4933:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 4934:    {
 4935:       ELEM(elem);
 4936: 
 4937:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 4938: 
 4939:       // All the nodes of a wet element are wet.
 4940:       if (!elem->isDry) {
 4941:          elem->nodes[0]->isDry = false;
 4942:          elem->nodes[1]->isDry = false;
 4943:          elem->nodes[2]->isDry = false;
 4944:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 4945: 
 4946:       }
 4947: 
 4948: 
 4949:       elem->kb = 0;
 4950: 
 4951:       if (elem->isDry) return;
 4952: 
 4953:       // Wet
 4954:       const Node *n1 = elem->nodes[0];
 4955:       const Node *n2 = elem->nodes[1];
 4956:       const Node *n3 = elem->nodes[2];  
 4957:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 4958: 
 4959:    //    if(elem->isDry2()) {
 4960:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 4961:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 4962:    //        call parallel_abort(errmsg)
 4963:    //    }
 4964: 
 4965: 
 4966:       // Computes element's kb as the minimum of the nodes' kb.
 4967:       const int kb1 = n1->kb;
 4968:       const int kb2 = n2->kb;
 4969:       const int kb3 = n3->kb;
 4970:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 4971: 
 4972:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 4973: 
 4974: 
 4975:       // Computes the element z as the mean of the nodes z.
 4976:       for (int k = elem->kb; k < nvrt; k++) {
 4977: 
 4978:          // Compute the element z as the mean of the nodes z.
 4979:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 4980:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 4981:          elem->z[k] /= elem->i34;
 4982: 
 4983: 
 4984:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 4985:       }
 4986:                   
 4987:    }
 4988: 
 4989:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 4990:    {
 4991:       NODE(node);
 4992:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 4993: 
 4994:       if (it == iths) return;
 4995: 
 4996: 
 4997:       if(!node->isDry && node->tmp.b) { // rewetted
 4998:          for (int k=0; k < nvrt; k++) {
 4999: 
 5000:             Vector3 utmp={0.0, 0.0, 0.0};
 5001: 
 5002:             double ttmp=0.0;
 5003:             double stmp=0.0;
 5004:             int icount=0;
 5005:             for (int j = 0; j < node->numNodes; j++) {
 5006: 
 5007: 
 5008:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5009:                if (!node->isDry) { // all indices extended
 5010:                   icount++;
 5011: 
 5012:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5013:                   utmp += node->u2[k];
 5014:                   
 5015:                   ttmp += node->tracers[k].tracer[0]; 
 5016:                   stmp += node->tracers[k].tracer[1]; 
 5017:                }
 5018:             }
 5019: 
 5020:             if(icount > 0) {
 5021:                const double inv_icount = 1.0/icount;
 5022:                node->u2[k]     = inv_icount*utmp;
 5023:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5024:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5025:             }
 5026:          }
 5027:       }
 5028:    }
 5029: 
 5030: 
 5031:    __global__ void ul0UpdateSides(int it, int iths) {
 5032: 
 5033:       SIDE(side);
 5034: 
 5035:       // A side is wet if and only if at least one of its elements is wet.
 5036:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5037: 
 5038:       const Node *n1 = side->n1;
 5039:       const Node *n2 = side->n2;
 5040:       const int kb1 = n1->kb;
 5041:       const int kb2 = n2->kb;
 5042: 
 5043:       side->kb = 0; // dry
 5044: 
 5045:       if (isWet) {
 5046: 
 5047:          assert((n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5048: 
 5049:          assert(side->htot2() <= h0 && "Weird side. Total depth is smaller than h0.");
 5050: 
 5051:          side->kb = min(kb1, kb2);
 5052: 
 5053:          for (int k = side->kb; k < nvrt; k++) {
 5054:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5055: 
 5056:          
 5057:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] <= 0.0) && "Weird side (3)");
 5058: 
 5059:             // Compute velocity for re-wetted sides 
 5060:             if ((it != iths) && (side->isDry && isWet)) {
 5061:             
 5062:                Vector2 utmp={0.0, 0.0};
 5063: 
 5064:                int icount=0;
 5065: 
 5066:                // For all the sides on the two elements that share this side
 5067:                for (int j=0; j < 2; j++) {
 5068:                   const Element *elem = side->elems[j];
 5069:                   if (elem == nullptr) continue;
 5070: 
 5071:                   for (int jj=0; jj < elem->i34; jj++) {
 5072:                      const Side *nSide = elem->sides[jj];
 5073:                      if (nSide->isDry) continue;
 5074: 
 5075:                      icount++;
 5076:                      utmp += nSide->u2[k];                     
 5077:                   }
 5078:                }
 5079:                   
 5080:                assert(icount > 0 && "No wet sides around this side");
 5081:                if (icount > 0)  side->u2[k] = utmp/icount;
 5082:                   
 5083:             } // if ((it != iths) && (side->isDry && isWet))
 5084: 
 5085:          } // for k
 5086: 
 5087:       } // if isWet
 5088:    
 5089:       side->isDry = !isWet;
 5090: 
 5091:    }
 5092: 
 5093: 
