 1126: struct Side {
 1127: 
 1128:    // Geometry information
 1129:    int idx;               // Index of the side
 1130:    Node *n1, *n2;
 1131:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1132: 
 1133:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1134:    Vector2 center;        // Location of side center. 
 1135:    double zc[nvrt];       // Side center z-coord at each vertical level
 1136: 
 1137:    Frame<ics> frame;
 1138:    
 1139:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1140:                           // this is nullptr
 1141:    
 1142:    int kb;                // Bottom index of the side
 1143:    bool isDry;            // True if the side is dry
 1144:  
 1145:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1146: 
 1147:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1148: 
 1149:    // Physical information
 1150:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1151:    Vector2 btu[nvrt];           // Back-tracked velocity
 1152:    Vector2 U;                   // Vertically averaged velocity vector  
 1153: 
 1154:    Vector2 nuGradU[nvrt];          // nu*grad u
 1155: 
 1156:    Vector2 bcc[nvrt];           // Baroclinic term
 1157:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1158: 
 1159:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1160:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1161:    Vector2 gradPr;               // Gradient of pressure
 1162:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1163: 
 1164: 
 1165:    double hhat;                 // \breve{H} in notes
 1166: 
 1167:    double shapiro;
 1168: 
 1169:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1170: 
 1171:    double coriolis;             // Coriolis parameter
 1172: 
 1173:    // Vegetation parameters
 1174:    double veg_c2;
 1175:    double veg_beta;
 1176: 
 1177:    // Bottom drag parameters.
 1178:    double chi;
 1179:    double chi2;
 1180: 
 1181:    __inline__ __device__ Point2 outputCoords(void) const;
 1182: 
 1183:    __inline__ __device__ double x(double t) const;
 1184:    __inline__ __device__ double y(double t) const;
 1185:    __inline__ __device__ double z(double t) const;
 1186:    __inline__ __device__ double lon(void) const;
 1187:    __inline__ __device__ double lat(void) const;
 1188:    __inline__ __device__ Point2 p2_t(double t) const;
 1189: 
 1190:    __device__ void setFrame(void) {
 1191:       if constexpr(ics == 1) return;
 1192: 
 1193:       double lat, lon;
 1194:       const Point3 p = toPoint3(center, centerZ());
 1195: 
 1196:       // Compute the latitude and longitude of the element center
 1197:       computeLatLon(p, lat, lon);
 1198: 
 1199:       frame.update(lat, lon);        
 1200:    }
 1201:    
 1202: 
 1203:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1204:    // If ics == 2, convert the global point to the local frame of the side
 1205:       
 1206:       if constexpr (ics == 1) {
 1207:          return p;
 1208:       } else {
 1209:          const Point3 c = {center.x, center.y, centerZ()};
 1210:          const Point3 local = frame.G2L(p - c);
 1211:          return local;
 1212:       }
 1213:    }
 1214: 
 1215: 
 1216:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1217:       if constexpr(ics == 1) return v;
 1218:       else return v_frame.projHorVec(v, frame);
 1219:    }
 1220: 
 1221:    __inline__ __device__ double centerZ(void)      const;
 1222:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1223:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1224:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1225:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1226: 
 1227:    __inline__ __device__ Side* neigh(int index) const { 
 1228:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1229:       assert(index >= 0 && index < 4); 
 1230:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1231: 
 1232:       const int ielem = index & 1;           // 0 or 1
 1233:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1234: 
 1235:       const Element* elem = elems[ielem];
 1236: 
 1237:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1238: 
 1239:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1240: 
 1241:    }
 1242: 
 1243:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1244: 
 1245:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1246: 
 1247:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1248:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1249:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1250:    __inline__ __device__ int iadv(void) const;
 1251: 
 1252:    __inline__ __device__ double grav3(void) const;
 1253:    
 1254:    __inline__ __device__ double eta2(void) const;
 1255:    __inline__ __device__ double eta1(void) const;
 1256:    __inline__ __device__ double w2(int k) const;
 1257:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1258:    __inline__ __device__ double depth(void) const;
 1259:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1260:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1261: 
 1262:    __inline__ __device__ double dfv(int k) const;
 1263: 
 1264:    __inline__ __device__ double veg_h(void)  const;
 1265:    __inline__ __device__ double veg_nv(void) const;
 1266:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1267:    __inline__ __device__ double veg_alpha3D(int k) const;
 1268:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1269: 
 1270:    __inline__ __device__ double Cd(void) const;
 1271: 
 1272:    __inline__ __device__ Vector2 tau(void) const;
 1273: 
 1274:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1275:    
 1276: 
 1277:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1278:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1279:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1280:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1281:    } 
 1282:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1283:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1284:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1285:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1286: 
 1287:    // Get valid starting element (for backtracking)
 1288:    __inline__ __device__ Element* getStartElement() {
 1289:       return elems[0] ? elems[0] : elems[1];
 1290:    }
 1291: 
 1292:    
 1293:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1294:       // Given an element, returns the other element that shares this side
 1295:       return (elems[0] == elem) ? elems[1] : elems[0];
 1296:    }
 1297: 
 1298:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1299:       // Given a node, returns the other node that shares this side
 1300:       return (n1 == node) ? n2 : n1;
 1301:    }
 1302:  
 1303:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1304: 
 1305: 
 1306: 
 1307: 
 1308: };
