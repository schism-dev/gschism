 2310: 
 2311: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2312: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2313: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2314: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2315:    Vector2 grad = {0.0, 0.0};
 2316:    int count = 0;
 2317: 
 2318:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2319: 
 2320:    // First element
 2321:    if (elems[0] != nullptr && condition(elems[0])) {
 2322:       grad += elems[0]->grad2(field);
 2323:       count++;
 2324:    }
 2325: 
 2326:    // Second element
 2327:    if (elems[1] != nullptr && condition(elems[1])) {
 2328:       grad += elems[1]->grad2(field);
 2329:       count++;
 2330:    }
 2331: 
 2332:    if (count > 0) {
 2333:       grad = grad/count;
 2334:    }
 2335:    
 2336:    return grad;
 2337: }
 2338: 
 2339: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2340: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2341: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2342: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2343: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2344: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2345: 
 2346: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2347: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2348: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2349: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2350: 
 2351: 
 2352: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2353: 
 2354: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2355: 
 2356: /**
 2357:  * This method performs backtracking from the side center until a time -dt back in time 
 2358:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2359:  * intermediate point.
 2360:  *
 2361:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2362:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2363:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2364:  * remaining time.
 2365:  * 
 2366:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2367:  * 
 2368:  * @param uuint, vvint, wwint: Velocities at the final point
 2369:  * @param jlev: Level at which the backtracking is performed
 2370:  * @param dt, dtbk: Tracking timesteps
 2371:  * @return: True if the backtracking was successful, false otherwise
 2372:  */
 2373: __inline__ __device__ bool Side::btrack(
 2374:       int jlev,
 2375:       double dt,            // Tracking time
 2376:       double dtbk,          // Tracking timestep
 2377:       Vector3 &u_int        // Velocities at the initial point
 2378: ) const {
 2379: 
 2380:    // Start from side center
 2381:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2382: 
 2383:  
 2384: 
 2385:    double time_rm = dt; // Remaining time
 2386: 
 2387: 
 2388:    // // Initialize outputs XXX
 2389:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2390:    //    sclr[i] = 0.0;
 2391:    // }
 2392: 
 2393: 
 2394:    // Initial velocities
 2395:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2396: 
 2397:    // Find the element that is in the direction opposite to the velocity
 2398:    Element* curElem = findElementTowards(toVector2(u_int));
 2399: 
 2400: 
 2401: 
 2402:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2403:    if (curElem == nullptr) {
 2404:       // Make velocity parallel to the side
 2405:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2406:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2407:       curElem = otherElem(curElem);
 2408:       
 2409:    }
 2410: 
 2411: // Nudges it towards the circumcenter
 2412: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2413: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2414:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2415: const double eps = 9.013e-3;                 
 2416: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2417: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2418: 
 2419: 
 2420: 
 2421:    const int MAX_ITERATIONS = 1000; 
 2422:    Element* nextElem = curElem;
 2423:    int iter = 0;
 2424:    while(true) {
 2425: 
 2426:       // Calculate timestep
 2427:       double dtb = min(dtbk, time_rm);
 2428: 
 2429:       // Next point in the backtracking curve
 2430:       Point3 xt = x0 - dtb*u_int;
 2431:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2432:       assert(found && "Backtracking failed in btrack");
 2433: 
 2434:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2435: 
 2436:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2437:                       // then time_rm needs to be increased by the unused time.
 2438: 
 2439:       // If the velocity is too small, we stop the backtracking
 2440:       const double vmag = length(toVector2(u_int));
 2441:       if (vmag <= velmin_btrack) break;
 2442: 
 2443:       // The current point becomes the next segment's starting point.
 2444:       x0 = xt;
 2445:  
 2446:       curElem = nextElem;
 2447: 
 2448:       iter++;
 2449:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2450:    }
 2451: 
 2452: 
 2453: }
