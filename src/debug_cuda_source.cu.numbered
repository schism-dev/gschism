 5610:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5611: 
 5612:       SIDE(side);
 5613: 
 5614:       side->U = {0.0, 0.0}; 
 5615:          
 5616:       if(side->isDry) return;
 5617: 
 5618:       // Vertically integrated velocity U
 5619:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5620:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5621:          side->U += side->Dz(k + 1)*uc;  
 5622:       }
 5623: 
 5624:    }
 5625: 
 5626:    __global__ void computeBottomDragVegetation(void) {
 5627:       // UNFINISHED. CHECK THIS:
 5628:       // How many kernels are needed? Why so many for loops?
 5629:       // Is the loop on sides needed?
 5630: 
 5631:       NODE(node);
 5632: 
 5633: 
 5634:       const int    kb      = node->kb;
 5635:       const double htot    = node->htot2(); 
 5636:       
 5637:       if (node->isDry) {
 5638:          // Default values for dry nodes
 5639:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5640:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5641: 
 5642:          return;
 5643:        
 5644:       }
 5645: 
 5646:       // Computes bottom drag Cd based on the selected nchi
 5647:       node->computeBottomDragCd();
 5648:       
 5649: 
 5650: 
 5651:       //   Bottom stress in m^2/s^2
 5652:       if (node->rho[kb + 1] >= -98.0)
 5653:       {
 5654:          const double mag_u = length(node->u2[kb + 1]);
 5655:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5656: 
 5657:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5658:          // !sediment erosion: this part needs more documentation
 5659:       }
 5660:     
 5661: 
 5662: 
 5663:       // Compute vegetation parameters
 5664:       //--------------------------------
 5665: 
 5666:       // SAV constants
 5667:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5668:       constexpr double veg_cfpsi = 0.16;
 5669: 
 5670:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5671:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5672: 
 5673:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5674:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5675:          int kbin = 0; // bin index
 5676:          for (int k = kb; k < nvrt; k++) {
 5677:             // Computes node height above the bottom level
 5678:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5679:             assert(false && "Vertical variation of vegetation not implemented");
 5680: 
 5681:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5682:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5683:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5684:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5685:             // } else {
 5686:             //    // Find the bin at which the current vertical level is
 5687:             //    while (kbin<nbins_veg_vert) {
 5688:             //       const double zn = node->z[kbin];
 5689:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5690:             //          break;
 5691:             //       } // if
 5692:             //       kbin++;
 5693:             //    } // while
 5694:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5695: 
 5696:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5697:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5698:                
 5699:             //    // Linear interpolation of the vegetation parameters
 5700:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5701:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5702:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5703:             // } // if rl10
 5704: 
 5705:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5706: 
 5707:          } // for k
 5708: 
 5709: 
 5710:       } else { // Ganthy (iveg==2)
 5711:       //  Modify canopy height, diameter, and density
 5712: 
 5713:          // Make sure there is vegetation on this node
 5714:          if (node->veg_h_unbent > 0.0) {
 5715:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5716: 
 5717:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5718:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5719:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5720: 
 5721:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5722:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5723:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5724:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5725:          } // if veg_h_unbent
 5726: 
 5727:          for (int k = 0; k < nvrt; k++) {
 5728:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5729:          } // for k
 5730:       
 5731: 
 5732:       } // if iveg
 5733:      
 5734: 
 5735:       // Compute vertical mean of veg_alpha3D
 5736:       if (iveg != 0) {
 5737:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5738:          double sum1=0.0;
 5739:          double sum2=0.0;
 5740:          // Integrate over each level under the canopy...
 5741:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5742:             const double Dz = node->Dz(k);
 5743: 
 5744:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5745:             sum2 += Dz;
 5746: 
 5747:          } // for k
 5748:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5749:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5750: 
 5751:       } // if iveg
 5752: 
 5753:    }
 5754: 
 5755:    __global__ void computeVegetationAndDragParameters(void) {
 5756:       // Computes the vegetation and drag model parameters:
 5757:       // chi, \tilde\chi, beta, \breve{H}
 5758:       
 5759:       SIDE(side);
 5760: 
 5761:       side->hhat = 0.0;
 5762:       side->chi2 = 0.0;
 5763:       side->chi = 0.0;
 5764:       side->veg_c2 = 0.0;
 5765:       side->veg_beta = 0.0;
 5766: 
 5767:       if (side->isDry) return;
 5768: 
 5769:       const double htot = side->htot2();
 5770:       const int    kb   = side->kb;
 5771: 
 5772:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5773: 
 5774:       const double veg_h     = side->veg_h();
 5775:       const double veg_nv    = side->veg_nv();
 5776:       const double veg_c     = side->veg_c();
 5777:       const double veg_beta  = side->veg_beta;
 5778:       const double veg_alpha = side->veg_alpha_vert_mean();
 5779: 
 5780:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5781:       // Velocity magnitude at the bottom level
 5782:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5783:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5784:       side->chi2 = side->Cd()*vmag1;
 5785:       side->chi  = side->chi2;
 5786: 
 5787:       if constexpr(iveg != 0) {
 5788:          const Node *n1 = side->n1;
 5789:          const Node *n2 = side->n2;
 5790:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5791:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5792:       }
 5793: 
 5794:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5795: 
 5796:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5797:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5798:       double magUa = 0.0;
 5799:       if constexpr(iveg != 0) {
 5800:          if (side->is3D() && veg_h > 0.0) {
 5801:             // 3D wet side with veg...
 5802: 
 5803:             double magUa = 0.0;
 5804:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5805:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5806: 
 5807:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5808:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5809:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5810: 
 5811:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5812:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5813: 
 5814:                   // Velocity magnitude at the bottom (l) of the level
 5815:                   const double ul = length(side->u2[k]);
 5816: 
 5817:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5818:                   magUa += Dz*0.5*(uh + ul);
 5819: 
 5820:                } // if HasVegetation
 5821:             } // for k
 5822:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5823: 
 5824:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5825:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5826:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5827:                const double zCpy = side->zTopCanopy();
 5828:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5829:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5830:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5831:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5832:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5833:             } // if isSubmerged
 5834:          } // if is3D
 5835:       } // if iveg   
 5836: 
 5837:       // Computes the friction modified depth, \breve{H} in notes
 5838:       if (side->is2D()) { // 2D
 5839: 
 5840:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5841:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5842: 
 5843:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5844: 
 5845:          side->hhat = htot*htot/fricH; 
 5846: 
 5847:       } else { // 3D
 5848:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5849: 
 5850:          if constexpr(iveg != 0) {
 5851:             
 5852:             if (side->isSubmerged()) { 
 5853:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5854:                side->hhat -= veg_c*Hhat_alpha;
 5855: 
 5856:             } else { // Emergent
 5857:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5858:             }
 5859:          } // if iveg
 5860: 
 5861:          // Enforce positivity for 3D model
 5862:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5863:       } // if 3D
 5864: 
 5865:    }
 5866: 
 5867: 
 5868: 
 5869:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5870:    // Computes the density gradient between two elements, e1 and e2.
 5871:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5872:    // zero in the direction normal to the side. 
 5873:    // 
 5874:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5875:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5876:    //
 5877:    // Input:
 5878:    //    e1: Element
 5879:    //    e2: Neighbor element (or nullptr if boundary)
 5880:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5881:    //    k: Index of the half-level at which the density is interpolated
 5882:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5883:    // 
 5884:    // Output:
 5885:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5886:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5887: 
 5888:       if (e2 == nullptr || e2->isDry) {
 5889:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5890: 
 5891:          Side *side = e1->sides[j];
 5892:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5893:                  
 5894:          if constexpr(ics == 1) {
 5895:             vec = side->n; // Normal vector to the side
 5896:          } else {
 5897:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5898:             // IMPLEMENT THIS XXXXXX
 5899:             // !replace with xel, yel?
 5900:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5901:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5902:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5903:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5904:          } //ics
 5905:                    
 5906:          diffRho = 0.0;
 5907: 
 5908:       } else { //internal and wet
 5909:          if constexpr(ics==1) {
 5910:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5911: 
 5912:             // Vector from e1 to e2
 5913:             vec = e2->center - e1->center;
 5914: 
 5915:          } else { 
 5916:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5917:             // Remember that elem->center is in global coordinates
 5918:             // IMPLEMENT THIS XXXXXX
 5919:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5920:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5921:             //                   alow(j)=xctr2
 5922:             //                   bdia(j)=yctr2
 5923:          } // ics
 5924: 
 5925:          diffRho = rho2 - e1->demeanedDensity(k);
 5926:       }
 5927: 
 5928:    }
 5929: 
 5930:    __global__ void computeDensityCubicSplines(void) {
 5931:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5932: 
 5933:       ELEM(elem);
 5934: 
 5935:       if (elem->isDry) return;
 5936: 
 5937:       const int kb = elem->kb;
 5938: 
 5939:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5940:       if (elem->is2D()) {
 5941:          // In the 2D case, the density is constant at the prism level. 
 5942:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5943:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5944:       } else { //3D
 5945: 
 5946:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5947:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5948:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5949:          ///// XXXX CHECK INDICES!!!!!
 5950:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5951:       } // 2D/3D
 5952: 
 5953:    }
 5954: } // extern "C"
 5955: 
 5956: 
 5957: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5958: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5959: 
 5960:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5961: 
 5962:    const int kb  = elem->kb;
 5963:    const int kb2 = elem2->kb;
 5964: 
 5965:    // z-coordinate of prism of elem
 5966:    const double zp = elem->z_prism(k);
 5967: 
 5968:    double rho = 0.0;
 5969: 
 5970:    if (elem2->is2D()) {
 5971:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5972: 
 5973:    } else {  // 3D
 5974: 
 5975:       // eta_min may be < zmax
 5976:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5977:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5978: 
 5979:       // (Extrapolate density below bottom, we will fix it later)
 5980:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5981:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5982:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5983:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5984:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5985:    } // 2D/3D
 5986:      
 5987: 
 5988:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5989:    // Now we need to fix it.
 5990:    if (elem->z[k] < elem2->z[kb2]) {
 5991:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5992: 
 5993:       // There are two methods to adjust the density at the bottom of the element.
 5994:       // iunder_deep=0: 
 5995:       const double depth1 = abs(elem->z[kb]); // larger depth
 5996: 
 5997:       if (iunder_deep==0) {
 5998: 
 5999:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6000: 
 6001:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6002: 
 6003:       } else { // iunder_deep != 0
 6004: 
 6005:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6006: 
 6007:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6008: 
 6009:          //   Demeaned density at the same z coordinate as
 6010:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6011:          }
 6012: 
 6013:       } // if iunder_deep
 6014:    } // if elem->z[kb] < elem2->z[kb]
 6015: 
 6016:    return rho;
 6017: }
 6018: 
 6019: 
 6020: extern "C" {
 6021:    __global__ void computeDensityGradient(void) {
 6022: 
 6023:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6024:       if constexpr(ibc != 0) return;
 6025: 
 6026:          // Compute the horizontal density gradient at each element.
 6027:       // It works in two steps:
 6028:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6029:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6030:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6031:       //             gradRho.r1 = rho1 - rho0
 6032:       //             gradRho.r2 = rho2 - rho0
 6033:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6034:       // 
 6035:       //  NOTE: We use de-meaned densities.
 6036: 
 6037:       ELEM(elem);
 6038: 
 6039:       if (elem->isDry) return;
 6040: 
 6041:       const int kb  = elem->kb;
 6042:       const int i34 = elem->i34;
 6043: 
 6044:       for (int k = kb + 1; k < nvrt; k++) {
 6045:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6046:          //             gradRho.r1 = rho1 - rho0
 6047:          //             gradRho.r2 = rho2 - rho0
 6048:          int icount = 0;
 6049:          double sumRx = 0.0;
 6050:          double sumRy = 0.0;
 6051:          for (int j1=0; j1<i34; j1++) { 
 6052: 
 6053:             const int j2 = elem->nxq(j1 + 1);
 6054: 
 6055:             // Pairs of consecutive neighbor elements of elem
 6056:             const Element *e1 = elem->nghbElems[j1];
 6057:             const Element *e2 = elem->nghbElems[j2];
 6058: 
 6059:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6060:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6061:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6062: 
 6063:             // Compute the density difference and the vector from elem to e1 and e2
 6064:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6065:             double diffRho1, diffRho2;
 6066:             Vector2 vec1, vec2;
 6067:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6068:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6069: 
 6070:             const double rl1 = length(vec1);
 6071:             const double rl2 = length(vec2);
 6072:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6073: 
 6074:             const double delta = cross(vec1, vec2);
 6075:             const double sintheta = abs(delta)/(rl1*rl2);
 6076: 
 6077:             // To avoid problems, avoid elements with small angle between vectors
 6078:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6079:             const bool validEq = (sintheta > sin_one_deg);
 6080: 
 6081:             if (validEq) {
 6082:                // Solve the system of equations to get the density gradient at elem
 6083:                icount++;
 6084:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6085:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6086:                sumRx += Rx;
 6087:                sumRy += Ry;
 6088:             }
 6089:          } // for j1
 6090: 
 6091:          // Compute the average density gradient at elem
 6092:          if (icount==0) {
 6093:            // Bad mesh quality; bail out with 0 b-cc
 6094:            elem->gradRho[k] = {0.0, 0.0};
 6095:          } else {
 6096:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6097:          }
 6098: 
 6099:       } // for k
 6100: 
 6101:    }
 6102: 
 6103:    __global__ void computeBaroclinicTerm(void) {
 6104:    // Computes the baroclinic term at sides (at half levels).
 6105:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6106:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6107: 
 6108:       if (ibc == 1) return;
 6109: 
 6110:       SIDE(side);
 6111: 
 6112:       if (side->isDry) return;
 6113: 
 6114:       const Element *e1 = side->elems[0];
 6115:       const Element *e2 = side->elems[1]; 
 6116:       const int kb = side->kb;
 6117:       
 6118:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6119: 
 6120:       // interpolates vertically the density gradient of the two elements at the half level/
 6121: 
 6122:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6123:       int k2 = max(kb, nvrt / 2);
 6124: 
 6125:       // Starts the integration at the surface and goes down to the bottom
 6126:       side->bcc[nvrt-1] = {0.0, 0.0};
 6127:       for (int k = nvrt - 2; k >= kb; k--) {
 6128:       // For each prism level (from surface to bottom)...
 6129: 
 6130:          // For both elements, interpolate density gradient at the side's half level.
 6131:          // The gradient at the side is the average of the gradients at the elements.
 6132:          // w1, w2 are used to take into account boundary sides, with just one element.
 6133:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6134:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6135:          const double wsum = w1 + w2;
 6136:          w1 = w1/wsum;
 6137:          w2 = w2/wsum;
 6138:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6139: 
 6140:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6141:          Vector2 gradRho = {0.0, 0.0};
 6142:          if (e1 != nullptr && k > kb) {
 6143:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6144:             
 6145:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6146:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6147:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6148: 
 6149:             // Grad(rho) vertically interpolated at the side's half level
 6150:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6151: 
 6152:             // Projects the element density gradient to the side frame if needed.
 6153:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6154: 
 6155:             // Adds the contribution of the density gradient at the side's half level
 6156:             gradRho += gradRho1*w1;
 6157:          }      
 6158:          if (e2 != nullptr && k > kb) {
 6159:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6160:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6161:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6162:             
 6163:             // Grad(rho) vertically interpolated at the side's half level
 6164:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6165: 
 6166:             // Projects the element density gradient to the side frame if needed.
 6167:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6168: 
 6169:             // Adds the contribution of the density gradient at the side's half level
 6170:             gradRho += gradRho2*w2;
 6171:          }
 6172: 
 6173:          
 6174:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6175:          // multiplied by -rampbc*(g/rho0) 
 6176:          const double grav3 = side->grav3();
 6177:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6178: 
 6179:       } // for
 6180: 
 6181:    }
 6182: 
 6183: 
 6184: 
 6185:    __global__ void computeHorGradientAtSide(void) {
 6186: 
 6187:       // Compute the horizontal density gradient at each element.
 6188:       // It works in two steps:
 6189:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6190:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6191:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6192:       //             gradRho.r1 = rho1 - rho0
 6193:       //             gradRho.r2 = rho2 - rho0
 6194:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6195:       // 
 6196:       //  NOTE: We use de-meaned densities.
 6197: 
 6198:       SIDE(side);
 6199: 
 6200: 
 6201:       if (side->isDry) return;
 6202: 
 6203:       // Computes the gradient of the variables at the side center.
 6204:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6205:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6206:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6207: 
 6208:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6209:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6210:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6211:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6212: 
 6213:    }
 6214: 
 6215: 
 6216:    __global__ void solveMomentumEquations(double time) {
 6217: 
 6218:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6219:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6220: 
 6221:       SIDE(side);
 6222: 
 6223:       if (side->isDry) 
 6224:       {
 6225:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6226: 
 6227:          return;
 6228:       }
 6229: 
 6230:       const Node *n1 = side->n1;
 6231:       const Node *n2 = side->n2;
 6232: 
 6233:       const int kb = side->kb;
 6234: 
 6235:       const double veg_h = side->veg_h();
 6236:       const double grav3 = side->grav3();
 6237: 
 6238:       if (side->is2D()) {
 6239:          // Remember: Do not use htot2, which is updated.
 6240:          const double htot = side->htot1();
 6241:          const double hhat = side->hhat;
 6242: 
 6243:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6244: 
 6245:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6246:          const Vector2 tau2 = side->tau();
 6247: 
 6248:          // hat_gam has units of m/s
 6249: 
 6250:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6251:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6252:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6253: 
 6254:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6255: 
 6256: 
 6257:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6258: 
 6259:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6260: 
 6261:       }
 6262:       else { // 3D
 6263: 
 6264:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6265:          // 
 6266:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6267:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6268:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6269:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6270:          // k+1 and k.
 6271: 
 6272: 
 6273:          const int ndim = nvrt - kb;
 6274:          const double zTopCanopy = side->zTopCanopy();
 6275: 
 6276:          // Initialize the tridiagonal system
 6277:          for (int k = kb + 1; k < nvrt; k++) {
 6278:             
 6279:             const int kin = k - (kb + 1);
 6280: 
 6281:             // Vertical viscosity at the face center
 6282:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6283: 
 6284:  
 6285:             alow[kin] = 0.0;
 6286:             cupp[kin] = 0.0;
 6287:             bdia[kin] = 0.0;
 6288: 
 6289:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6290:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6291: 
 6292:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6293:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6294:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6295: 
 6296:             // First part: layers k, k+1
 6297:             if (k < nvrt - 1) {
 6298:                              
 6299:                if constexpr(iveg != 0) {
 6300: 
 6301:                   // If there is vegetation at this level...
 6302:                   if (zTopCanopy > side->zc[k]) {
 6303:                      // If the canopy is above the k layer...
 6304:                      
 6305:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6306:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6307:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6308:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6309: 
 6310:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6311:                      const double vmag2 = length(ut2);
 6312:                      const double vmag1 = length(side->u2[k]);
 6313:                      const double vmag = 0.5*(vmag1 + vmag2);
 6314:                      
 6315:                      // Computes the vegetation alpha at the face center
 6316:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6317: 
 6318:                      cff1 += veg_alpha_sd*dt*vmag;
 6319: 
 6320:                   } // if (zTopCanopy
 6321:                } // if iveg
 6322: 
 6323:                const double dzz = side->Dz(k + 1);
 6324:                const double tmp = dt*dfz/dzz;
 6325:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6326: 
 6327:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6328:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6329:             }
 6330: 
 6331: 
 6332:             // Second part: layers k-1, k
 6333:             if (k > kb + 1) {
 6334: 
 6335:                double cff1 = 1.0; //init \bar{c^k}
 6336: 
 6337:                if constexpr(iveg != 0) {
 6338:                   // If there is vegetation at this level...
 6339:                   if (zTopCanopy > side->zc[k-1]) {
 6340:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6341:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6342: 
 6343:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6344: 
 6345:                      const double vmag2 = length(ut2);
 6346:                      const double vmag1 = length(side->u2[k-1]);
 6347:                      const double vmag = 0.5*(vmag1 + vmag2);
 6348: 
 6349:                      // Computes the vegetation alpha at the face center
 6350:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6351:                      cff1 += veg_alpha_sd*dt*vmag;
 6352:                   } // if zTopCanopy
 6353: 
 6354:                } // if iveg
 6355: 
 6356:                const double dzz = side->Dz(k);
 6357:                const double tmp = dt*dfz/dzz;
 6358:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6359: 
 6360:                alow[kin] += cff1*dzz/6.0 - tmp;
 6361:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6362: 
 6363:             } else { // Bottom boundary
 6364:                // This occurs at the bottom, where the bottom drag is applied.
 6365: 
 6366:                bdia[kin] += dt*side->chi2; // XXXX
 6367: 
 6368:             } // if (k > kb + 1)
 6369: 
 6370: 
 6371:          } // for (int k
 6372: 
 6373: 
 6374: 
 6375:          // Computes the RHS.
 6376:          // -----------------
 6377: 
 6378:          //	BC to be imposed at the end.
 6379: 
 6380:          const Vector2 gradETP  = side->gradETP;
 6381:          const Vector2 gradPr   = side->gradPr;
 6382:          const Vector2 gradEta1 = side->gradEta1;
 6383:          const Vector2 gradEta2 = side->gradEta2;
 6384: 
 6385:          const Vector2 *btu = side->btu;
 6386:          const Vector2 *u2  = side->u2;
 6387:          const double coriolis = side->coriolis;
 6388:          const Vector2 *nuGradU = side->nuGradU;
 6389: 
 6390:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6391:          for (int k = kb + 1; k < nvrt; k++) {
 6392:             const int kin = k - kb - 1;
 6393: 
 6394:             const double dz_0 = side->Dz(k);
 6395:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6396: 
 6397:             rrhs[kin] = {0.0, 0.0};
 6398:             double dz = 0.0;
 6399: 
 6400:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6401:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6402:             if (k < nvrt  ) dz += dz_1;
 6403:             if (k > kb + 1) dz += dz_0;
 6404: 
 6405:             // Elevation gradient, atmospheric pressure and tidal potential
 6406:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6407: 
 6408:             // Coriolis, advection, wind stress, and horizontal viscosity
 6409:             if (k < nvrt - 1) {
 6410: 
 6411: 
 6412:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6413:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6414:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6415:                                                 
 6416: 
 6417:                //diff stress tensors 1006
 6418:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6419:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6420:                   assert(false && "Not implemented: itur == 5");
 6421:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6422:                }
 6423:                // else assert(false && "itur # Not implemented");
 6424: 
 6425:             } else { // k == nvrt - 1 SURFACE
 6426:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6427:                const Vector2 tau2 = side->tau();
 6428: 
 6429:                rrhs[kin] += dt*tau2;          
 6430: 
 6431:             } // if k<nvrt
 6432: 
 6433: 
 6434:             if (k > kb + 1) {
 6435:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6436:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6437:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6438: 
 6439:                // diff stress tensors 1006
 6440:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6441:                   assert(false && "Not implemented: itur == 5");
 6442:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6443:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6444:                }
 6445:                // else assert(false && "itur # Not implemented");
 6446: 
 6447: 
 6448:             } // if k>kbs + 1
 6449: 
 6450:             // Baroclinic
 6451:             Vector2 *bcc = side->bcc;
 6452:             if constexpr(ibc == 0) {
 6453:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6454:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6455: 
 6456:             } // if ibc==0
 6457: 
 6458:          } // k=kb + 1,nvrt
 6459: 
 6460: 
 6461:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6462: 
 6463:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6464:             const int kin = k - kb - 1;
 6465:    
 6466:             // Velocity is always clamped to maximum values
 6467:             side->u2[k] = clampVelocity(soln[kin]);
 6468:          } // k
 6469: 
 6470:       } // if side->is2D()
 6471:       
 6472: 
 6473:       // Impose velocity boundary condition at the bottom
 6474:       if constexpr(imm == 2) { // 3D bed deformation model
 6475:          double dep;
 6476:          Vector2 vel;
 6477: 
 6478:          assert(false && "Not implemented: imm == 2");
 6479:          //update_bdef(time, x0, y0, dep, vel);
 6480:          // side->u2[kb] = vel;
 6481: 
 6482:       } else { // imm = 0 or 1
 6483:          if (side->Cd() == 0.0) {
 6484:             side->u2[kb] = side->u2[kb + 1];
 6485: 
 6486:          } else if (side->is3D()) { // 3D no slip bottom   
 6487:             side->u2[kb] = {0.0, 0.0};
 6488: 
 6489:          }
 6490:           
 6491:       } // if imm
 6492: 
 6493:       // The velocities below the bottom level are set to zero
 6494:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6495: 
 6496: 
 6497:    }
 6498: 
 6499: 
 6500:    __global__ void applyMomentumBC(void) {
 6501: 
 6502:       SIDE_BND(sideBnd);
 6503: 
 6504:       Side *side = sideBnd->side;
 6505:       const BoundarySegment *segment = sideBnd->segment;
 6506:       const Node *n1 = side->n1;
 6507:       const Node *n2 = side->n2;
 6508: 
 6509:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6510: 
 6511:       const bool isLand = segment->isLand;
 6512:       const int ifltype = segment->ifltype;
 6513: 
 6514:       const int kb = side->kb;
 6515: 
 6516: 
 6517:       if (!isLand && ifltype != 0) {
 6518:          const Vector2 *ubc = sideBnd->ubc;
 6519:   
 6520:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6521:             
 6522:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6523:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6524: 
 6525:             if (ifltype == -1) {
 6526:                // Flather 1
 6527: 
 6528:                const double depth = side->depth();
 6529: 
 6530:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6531: 
 6532:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6533: 
 6534:                side->u2[k] = vnorm*side->n;
 6535: 
 6536:             } else if (ifltype == -2) { // Discharge
 6537: 
 6538:                const double eta1 = side->eta1();
 6539:                const double eta2 = side->eta2();
 6540:                const double htot = side->htot2();
 6541: 
 6542:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6543:                assert(false && "Not implemented: Discharge bc");
 6544:                // const double dischrg = discharge(eta1);
 6545:                const double dischrg = 0.0; // XXX REMOVE
 6546:                
 6547: 
 6548:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6549: 
 6550:                const double vnorm = dischrg*eta2/htot;
 6551: 
 6552:                side->u2[k] = vnorm*side->n;
 6553: 
 6554:             }
 6555:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6556:                const double vnorm = dot(side->u2[k], side->n);
 6557: 
 6558:                double rat;
 6559:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6560:                else              rat = segment->vobc2; // outgoing
 6561: 
 6562:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6563: 
 6564:             }
 6565:             else { // not Flather or 3D radiation
 6566:                side->u2[k] = ubc[k];
 6567: 
 6568:             } // if (segment->ifltype...
 6569: 
 6570:          }
 6571: 
 6572:       }
 6573:       else if (isLand) { // if it is land boundary side
 6574: 
 6575:          if constexpr(islip == 0) { // free slip
 6576: 
 6577:             for (int k = kb; k < nvrt; k++) {
 6578: 
 6579:                const Vector2 t = side->t();
 6580:                const Vector2 n = side->n;
 6581: 
 6582:                double vnorm = 0.0; // for most cases
 6583:                const double vtan = dot(side->u2[k], t);
 6584:                
 6585:                side->u2[k] = vtan*t - vnorm*n;
 6586: 
 6587:             }
 6588: 
 6589:          } else { // no slip
 6590:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6591: 
 6592:          }
 6593:       } // if (side segment type...
 6594: 
 6595:    }
 6596: 
 6597: 
 6598:    __global__ void shapiroFilter1(void) {
 6599:       // First step of the Shapiro filter (normally used if indvel<=0)
 6600:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6601: 
 6602:       SIDE(side);
 6603: 
 6604:       // Only internal wet sides are processed
 6605:       if (side->isDry || !(side->isInternal())) return;
 6606: 
 6607:       const int kb = side->kb;
 6608: 
 6609:       for (int mm = 0; mm < niter_shap; mm++) {
 6610: 
 6611:          for (int k = kb + 1; k < nvrt; k++) {
 6612:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6613:             Vector2 suru = {0.0, 0.0};
 6614: 
 6615:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6616: 
 6617:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6618: 
 6619:                int kin = k;
 6620:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6621:                
 6622:                // Get the velocity at the neighbor's side.
 6623:                Vector2 nSideU2 = nSide->u2[kin];
 6624: 
 6625:                // Projects the velocity to the current side frame if needed.
 6626:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6627: 
 6628:                suru += nSideU2;
 6629:             }
 6630: 
 6631:             // Reusing bcc as a temporary array to store the suru values.
 6632:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6633: 
 6634:          }
 6635:       }
 6636:    }
 6637: 
 6638:    __global__ void shapiroFilter2(void) {
 6639:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6640: 
 6641:       SIDE(side);
 6642: 
 6643: 
 6644:       if (side->isDry || !(side->isInternal())) return;
 6645: 
 6646:       const int kb = side->kb;
 6647: 
 6648:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6649: 
 6650:       if (side->is2D()) {
 6651:          side->u2[kb + 1] = side->bcc[kb + 1];
 6652:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6653: 
 6654:       } else {
 6655:          // 3D
 6656:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6657:          
 6658:       }
 6659: 
 6660:    }
 6661: 
 6662: 
 6663:    __global__ void ul0UpdateZCoords(void) {
 6664:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6665:       
 6666:       NODE(node);      
 6667: 
 6668: 
 6669:       if (false) { //node->isDry) { XXXXXXX
 6670: 
 6671:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6672: 
 6673:          if constexpr(ivcor != 1) node->kb = 0;
 6674: 
 6675:       } else {
 6676: 
 6677:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6678:          node->updateKb();
 6679: 
 6680:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6681: 
 6682:       }
 6683: 
 6684:       // We use the temp.b field to store the previous state of isDry.
 6685:       node->tmp.b = node->isDry;
 6686: 
 6687:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6688:       node->isDry = true;
 6689: 
 6690:    }
 6691: 
 6692:    __global__ void ul0ComputeDryElements(void)
 6693:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6694:    {
 6695:       ELEM(elem);
 6696: 
 6697:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6698: 
 6699:       elem->kb = 0;
 6700: 
 6701:       if (elem->isDry) return;
 6702: 
 6703: 
 6704:    //    if(elem->isDry2()) { // XXXX
 6705:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6706:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6707:    //        call parallel_abort(errmsg)
 6708:    //    }
 6709: 
 6710:       const Node *n1 = elem->nodes[0];
 6711:       const Node *n2 = elem->nodes[1];
 6712:       const Node *n3 = elem->nodes[2];  
 6713:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6714: 
 6715:       // Computes element's kb as the minimum of the nodes' kb.
 6716:       const int kb1 = n1->kb;
 6717:       const int kb2 = n2->kb;
 6718:       const int kb3 = n3->kb;
 6719:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6720: 
 6721: 
 6722:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6723: 
 6724: 
 6725:       // Computes the element z as the mean of the nodes z.
 6726:       for (int k = elem->kb; k < nvrt; k++) {
 6727: 
 6728:          // Compute the element z as the mean of the nodes z.
 6729:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6730:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6731:          elem->z[k] /= elem->i34;
 6732: 
 6733:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6734:       }
 6735:                   
 6736:    }
 6737: 
 6738:    __global__ void ul0ComputeDryNodes(void)
 6739:    // Updates node's isDry based on the elements' isDry. 
 6740:    {
 6741:       NODE(node);
 6742: 
 6743:       node->isDry = true;
 6744: 
 6745:       // A node is wet if at least one of the elements sharing it is wet.
 6746:       for (int j = 0; j < node->numElements; j++) {
 6747:          const Element *elem = node->elements[j];
 6748:          if (!elem->isDry) {
 6749:             node->isDry = false;
 6750:             break;
 6751:          }
 6752:       }
 6753: 
 6754:        
 6755:    }
 6756: 
 6757: 
 6758:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6759:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6760:    // node->tmp.b is true if the node was previously dry.
 6761:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6762:    {
 6763:       NODE(node);
 6764:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6765: 
 6766:       // Avoid this the first time step.
 6767:       if (it == iths) return;  
 6768: 
 6769:       const bool wasDry = node->tmp.b;
 6770: 
 6771: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6772: 
 6773:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6774: 
 6775:          for (int k=0; k < nvrt; k++) {
 6776: 
 6777:             Vector3 utmp={0.0, 0.0, 0.0};
 6778: 
 6779:             double ttmp=0.0;
 6780:             double stmp=0.0;
 6781:             int icount=0;
 6782:             for (int j = 0; j < node->numNodes; j++) {
 6783: 
 6784:                const Node *nbrNode = node->nodes[j];
 6785:                
 6786:                const bool wasNbrDry = nbrNode->tmp.b;
 6787: 
 6788:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6789:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6790: 
 6791:                   icount++;
 6792: 
 6793:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6794:                   utmp += nbrNode->uvw2(k);
 6795:                   
 6796:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6797:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6798:                }
 6799:             }
 6800: 
 6801:             if (icount > 0) {
 6802:                const double inv_icount = 1.0/icount;
 6803:                utmp = inv_icount*utmp;
 6804:                node->u2[k]     = {utmp.x, utmp.y};
 6805:                node->w2[k]     = utmp.z;
 6806:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6807:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6808:             } else {
 6809:                node->u2[k] = {0.0, 0.0};
 6810:                node->w2[k] = 0.0;
 6811:                // Initialize tracers to 0.0??? XXXXX
 6812:             }
 6813:          }
 6814:       }
 6815:    }
 6816: 
 6817:   
 6818:    
 6819: 
 6820: 
 6821:    __global__ void ul0UpdateSides(int it, int iths) {
 6822:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6823:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6824:    // The dryness of the sides is updated in ul0UpdateSides2.
 6825: 
 6826:       SIDE(side);
 6827: 
 6828:       // A side is wet if and only if at least one of its elements is wet.
 6829:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6830:  
 6831:       const Node *n1 = side->n1;
 6832:       const Node *n2 = side->n2;
 6833:      
 6834:       const int kb1 = n1->kb;
 6835:       const int kb2 = n2->kb;
 6836: 
 6837:       side->kb = 0; // default when dry
 6838: 
 6839:       if (isWet) {
 6840: 
 6841:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6842: 
 6843:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6844: 
 6845:          side->kb = min(kb1, kb2);
 6846: 
 6847:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6848: 
 6849:          for (int k = side->kb; k < nvrt; k++) {
 6850:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6851: 
 6852:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6853: 
 6854:             // Compute velocity for re-wetted sides 
 6855:             if ((it != iths) && (side->isDry && isWet)) {
 6856: 
 6857:                Vector2 utmp={0.0, 0.0};
 6858: 
 6859:                int icount=0;
 6860: 
 6861:                // For all the sides on the two elements that share this side
 6862:                for (int j = 0; j < 2; j++) {
 6863:                   const Element *elem = side->elems[j];
 6864:                   if (elem == nullptr) continue;
 6865: 
 6866:                   for (int jj=0; jj < elem->i34; jj++) {
 6867:                      const Side *nSide = elem->sides[jj];
 6868:                      if (nSide->isDry) continue;
 6869: 
 6870:                      icount++;
 6871:                      utmp += nSide->u2[k];  
 6872:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6873:                   }
 6874:                }
 6875:                   
 6876:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6877:                if (icount > 0)  side->u2[k] = utmp/icount;
 6878:                else             side->u2[k] = {0.0, 0.0};
 6879:                   
 6880:             } // if ((it != iths) && (side->isDry && isWet))
 6881: 
 6882:          } // for k
 6883: 
 6884:       } // if isWet 
 6885:       
 6886: 
 6887: 
 6888:    }
 6889: 
 6890:    __global__ void ul0UpdateSides2(void) {
 6891:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6892:    
 6893:          SIDE(side);
 6894:    
 6895:          const Element *e1 = side->elems[0];
 6896:          const Element *e2 = side->elems[1];
 6897: 
 6898:          // A side is wet if and only if at least one of its elements is wet.
 6899:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6900: 
 6901:          // Update the side's dryness
 6902:          side->isDry = !isWet;
 6903: 
 6904:    }
 6905: 
 6906: 
 6907:    __global__ void zeroNodalVelocities(void) {
 6908:       NODE(node);
 6909: 
 6910:       for (int k = 0; k < nvrt; k++) {
 6911:          node->u2[k]   = {0.0, 0.0};
 6912:          node->w2[k]   = 0.0;
 6913:          node->utmp[k] = {0.0, 0.0};         
 6914:       }
 6915:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6916:    }
 6917:  
 6918: 
 6919:    __global__ void computeNodalVerticalVelocities1(void) {
 6920:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6921:    // Adds the element's vertical velocity times the element's area.
 6922:       ELEM(elem);
 6923: 
 6924:       for (int j = 0; j < elem->i34; j++) {
 6925:          Node *node = elem->nodes[j];
 6926: 
 6927:          for (int k = node->kb; k < nvrt; k++) {
 6928:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6929:          }
 6930:          atomicAdd(&(node->tmp.d), elem->area);
 6931:       }
 6932:    }
 6933: 
 6934:    __global__ void computeNodalVerticalVelocities2(void) {
 6935:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6936:    // Divides by the total area of the elements sharing the    node.
 6937:       NODE(node);
 6938: 
 6939: 
 6940:       const double invArea = 1.0 / node->tmp.d;
 6941:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6942: 
 6943:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6944:    }
 6945: 
 6946: 
 6947:    __global__ void computeNodalHorizontalVelocities1(void) {
 6948: 
 6949:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6950: 
 6951:       ELEM(elem);
 6952: 
 6953:       if (elem->isDry) return;
 6954: 
 6955:       const int kb = elem->kb;
 6956:       const bool isTri = elem->isTri();
 6957: 
 6958:       if constexpr(indvel <= 0) {
 6959:          // Assuming discontinous hvel.
 6960: 
 6961:          if (isTri) { // For triangles
 6962:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6963:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6964:             #pragma unroll
 6965:             for (int j = 0; j < 3; j++) {
 6966:                // For every node of the triangle...
 6967:                Node *node = elem->nodes[j];
 6968: 
 6969:                if (node->isDry) continue;
 6970: 
 6971:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6972:                const Side *s2 = elem->sides[(j + 1) % 3];
 6973:                const Side *s3 = elem->sides[(j + 2) % 3];
 6974: 
 6975:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6976: 
 6977:                atomicAdd(&(node->tmp.i), 1);
 6978: 
 6979:                for (int k = kb; k < nvrt; k++)  {
 6980:                   Vector2 s1u2 = s1->u2[k];
 6981:                   Vector2 s2u2 = s2->u2[k];
 6982:                   Vector2 s3u2 = s3->u2[k];
 6983: 
 6984:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6985:                   if constexpr(ics == 2) {
 6986:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6987:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6988:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6989:                   }
 6990: 
 6991:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 6992:                   u = clampVelocity(u);
 6993:                   atomicAdd(&(node->utmp[k].x), u.x);
 6994:                   atomicAdd(&(node->utmp[k].y), u.y);
 6995: 
 6996:                }
 6997: 
 6998:             }
 6999:          }
 7000:          else { // For quads
 7001: 
 7002: 
 7003:             // Compute the bilinear coordinates of the center of each diagonal.
 7004:             double xi, eta;
 7005:             double shp13[4], shp24[4];
 7006:             Point2 x0, x1, x2, x3;
 7007:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7008:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7009:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7010: 
 7011:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7012:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7013: 
 7014: 
 7015: 
 7016: 
 7017:             for (int k = kb; k < nvrt; k++) {
 7018: 
 7019:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7020:                Vector2 sideU[4];
 7021:                #pragma unroll
 7022:                for (int j = 0; j < 4; j++) {
 7023:                   Vector2 u = elem->sides[j]->u2[k];
 7024:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7025:                   sideU[j] = u;
 7026:                }
 7027: 
 7028:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7029:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7030: 
 7031:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7032:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7033:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7034:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7035:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7036:                #pragma unroll
 7037:                for (int j = 0; j < 4; j++) {
 7038:                   Node *node = elem->nodes[j];
 7039:                   if (node->isDry) continue;
 7040: 
 7041:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7042:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7043:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7044:                }
 7045:             }
 7046: 
 7047:          }
 7048: 
 7049:       }
 7050:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7051:       
 7052:    }
 7053: 
 7054: 
 7055:    __global__ void computeNodalHorizontalVelocities2(void) {
 7056:       NODE(node);
 7057: 
 7058:       const int nodeCount = node->tmp.i;
 7059: 
 7060:       if (nodeCount == 0) 
 7061:       {
 7062:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7063:          return;
 7064:       }
 7065: 
 7066:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7067:       
 7068:       const int kb = node->kb;
 7069: 
 7070:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7071:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7072:       
 7073:       
 7074:    }   
 7075: 
 7076:  
