 1994: __device__ void lock(int *mutex) {
 1995:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1996: }
 1997: 
 1998: __device__ void unlock(int *mutex) {
 1999:     atomicExch(mutex, 0);
 2000: }
