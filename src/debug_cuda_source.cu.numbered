 1136: // This struct is used to store the boundary information for a node.
 1137: struct NodeBoundary {   
 1138:    int idx;
 1139:    BoundarySegment *segment;
 1140:    Node *node;
 1141:    
 1142:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1143:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1144: 
 1145:    bool isLand;
 1146: 
 1147:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1148:    double elbc;   // Elevation boundary condition
 1149:    double eth;    // Elevation time history
 1150: 
 1151:    double eta_mean; // Mean elevation at nodes
 1152: 
 1153:    bool isEssentialBC;
 1154: 
 1155:    Vector2 uth[nvrt];  // "Time history" velocity
 1156: 
 1157:    // Arrays for harmonic constituents (if needed)
 1158:    double  emo[nbfr];  // Elevation amplitude
 1159:    double  efa[nbfr];  // Elevation phase
 1160:    Vector2 umo[nbfr];  // velocity amplitude
 1161:    Vector2 ufa[nbfr];  // velocity phase
 1162: 
 1163: 
 1164:    NodeBoundary(void) {
 1165:       isLand = false;
 1166:    }
 1167:    NodeBoundary(bool _isLand) {
 1168:       isLand = _isLand;
 1169:    }
 1170: 
 1171:    
 1172:    __forceinline__ __device__ int numSidesForAverage() const {
 1173:    // Returns the number of sides that are connected to the node and have the same segment.
 1174:    // This is used to compute the average velocity at the node for open boundary nodes.
 1175:       int res = 0;
 1176:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1177:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1178: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1179:       return res;
 1180:    }
 1181: 
 1182: 
 1183:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1184:       assert(index == 0 || index == 1); 
 1185:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1186:    }
 1187: 
 1188: 
 1189: };
 1190: 
 1191: struct Node {
 1192: 
 1193:    // Geometry information
 1194:    int idx;        // Index of the node
 1195:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1196:    int numNodes;   // Number of nodes neighbors of this node
 1197: 
 1198:    Element **elements; // Array of pointers to the elements that share this node
 1199:    int numElements;    // Number of elements that share this node
 1200: 
 1201:    int numSides;       // Number of sides that are connected to this node
 1202: 
 1203:    Point2 p;
 1204:    Vector2 u2[nvrt];
 1205:    double  w2[nvrt];
 1206:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1207:    double z[nvrt];
 1208:    double lon, lat;
 1209:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1210:    double depth;
 1211: 
 1212:    int kb;       // Bottom index of the node
 1213: 
 1214:    bool isDry;     // True if the node is dry
 1215: 
 1216:    int iadv;     // Advection flag
 1217: 
 1218:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1219:                           // this is nullptr
 1220: 
 1221:    TempVar tmp; // Temporary variable to store different types of variables
 1222: 
 1223:    // Physical information
 1224:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1225:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1226: 
 1227:    double rho[nvrt];     // Density
 1228:    double dfv[nvrt];     // Vertical viscosity
 1229: 
 1230:    double eta1; // Elevation at nodes at previous timestep
 1231:    double eta2; // Elevation at nodes at current timestep
 1232: 
 1233:    double ETP;  // Earth Tidal Potential
 1234: 
 1235:    double pr;    // Air pressure
 1236:    double grav2; // Gravity 
 1237:    
 1238:    Vector2 dav;  // Depth averaged velocity
 1239: 
 1240:    Vector2 tau; // Wind stress vector
 1241: 
 1242:    // Vegetation parameters
 1243:    double veg_h;
 1244:    double veg_nv;
 1245:    double veg_di;
 1246:    double veg_Cd;
 1247:    double veg_h_unbent;
 1248:    double veg_di_unbent;
 1249:    double veg_nv_unbent;
 1250:    double veg_alpha_vert_mean;
 1251:    double veg_alpha0;
 1252:    double veg_alpha3D[nvrt];
 1253: 
 1254:    // Bottom drag parameters
 1255:    double Cd;       // Bottom drag coefficient   
 1256: 
 1257:    // These three are mutually exclusive
 1258:    union {
 1259:       double rmanning; // Bottom Manning's coefficient
 1260:       double rough;    // Bottom roughness length
 1261:       double drag;     // Bottom drag coefficient
 1262:    };
 1263:    Vector2 tau_bot; // Bottom stress vector
 1264: 
 1265:    double bdef1; // Bottom deformation at previous timestep
 1266:    double bdef2; // Bottom deformation at current timestep
 1267: 
 1268:    double qel; // RHS
 1269:    double coeffDiag; // Diagonal coefficient of the matrix
 1270:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1271: 
 1272:    double mP; // Search direction for conjugate gradient method
 1273:    double mR; // Residual for conjugate gradient method
 1274:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1275:    double mX; // Solution for conjugate gradient method
 1276: 
 1277:    // Meteorological forcing
 1278:    Vector2 u_air;
 1279:    double p_air;
 1280:    double t_air;
 1281:    double q_air;
 1282:    double wind_angle;  // Wind rotation angle
 1283: 
 1284:    __device__ void setWind(Vector2 &u) {
 1285:    // Sets the wind vector taking into account the wind rotation angle
 1286:    
 1287:       const double dir = atan2(-u.x,-u.y);
 1288:       const double speed = length(u);
 1289: 
 1290:       // Calculate new u and v components with added rotation angle
 1291:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1292:    }
 1293: 
 1294: 
 1295:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1296: 
 1297:    __device__ double sigmaTransitionDepth(void) const;
 1298: 
 1299:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1300:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1301:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1302:    
 1303:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1304: 
 1305:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1306: 
 1307:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1308:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1309: 
 1310:    __device__ __forceinline__ void clearMatrixRow(void) {
 1311:       // Clear the matrix row for this node
 1312: 
 1313: 
 1314:       coeffDiag = 0.0;
 1315: 
 1316:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1317: 
 1318:    }
 1319: 
 1320:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1321:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1322:       
 1323:       if (node == this) {
 1324:          coeffDiag += value;
 1325:      
 1326:       } else {
 1327:          // Search (linearly)the index of the node in the array of nodes
 1328:          // XXX: This is not efficient, see if we can improve this
 1329:          int i;
 1330:          for (i = 0; i < numNodes; i++) {
 1331:             if (nodes[i] == node) {
 1332:                break;
 1333:             }
 1334:          }
 1335:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1336:          coeffMatrix[i] += value;
 1337:       }
 1338:    }
 1339: 
 1340: 
 1341:    __device__ __inline__ void updateZCoordData(void);
 1342: 
 1343:    __device__ double compZCoord(int k) const;
 1344: 
 1345:    __device__ void updateKb(void);
 1346: 
 1347:    __device__ __forceinline__ void computeBottomDragCd(void);
 1348: 
 1349: 
 1350: 
 1351: };
