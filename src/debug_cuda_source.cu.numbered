 1807: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1808: // return;   
 1809:    // Lock the mutex
 1810:    lock(&debugPlotMutex);
 1811:  
 1812:    bool ok = true;
 1813:    if (debugPlotIdx == nullptr) ok = false;
 1814:    if (*debugPlotIdx >= 10000) ok = false;
 1815:    if (ok) {
 1816:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1817:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1818:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1819:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1820:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1821:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1822:       (*debugPlotIdx)++;
 1823:    }
 1824: 
 1825:    __threadfence();               // ensure all above writes are visible
 1826:    // Unlock the mutex
 1827:    unlock(&debugPlotMutex);
 1828: 
 1829: }
