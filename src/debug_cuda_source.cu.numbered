 1943: // Convenience macros for accessing the objects in kernels.
 1944: 
 1945: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1946:                    Side *side = &(mesh->localSideData[idx_side]); \
 1947:                    if (idx_side >= mesh->ns) return;
 1948: 
 1949: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1950:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1951:                    if (idx_elem >= mesh->ne) return;
 1952: 
 1953: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1954:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1955:                    if (idx_node >= mesh->np) return;
 1956: 
 1957: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1958:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1959:                               const bool valid = (idx_node < mesh->np);                   
 1960: 
 1961: 
 1962: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1963:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1964:                            if (idx_node_bnd >= mesh->nbp) return;
 1965: 
 1966: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1967:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1968:                            if (idx_side_bnd >= mesh->nbs) return;                           
 1969: 
 1970: Polynomial<4> *polyDischarge; // XXX read from file
