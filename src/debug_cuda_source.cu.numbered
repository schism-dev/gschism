 4495: 
 4496: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4497:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4498:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4499: 
 4500: 
 4501:    NODE(node1);
 4502: 
 4503:    node1->clearMatrixRow();
 4504:    node1->qel = 0.0;
 4505: 
 4506:    // THIS IS FOR STRUCTURES XXX
 4507:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4508: 
 4509:    
 4510:    for (int j=0; j<node1->numElements; j++) {
 4511:       // For each element connected to the node...
 4512: 
 4513:       Element *elem = node1->elements[j];
 4514: 
 4515: 
 4516: 
 4517:       // Compute the average gravity
 4518:       const double grav3 = elem->mean(&Node::grav2);
 4519: 
 4520:       // Look at the documentation for the description of the terms in the following integrals
 4521: 
 4522:       // Integral I_1 
 4523:       // \bar{\breve{H}} 
 4524:       const double hhatb = elem->mean(&Side::hhat);        
 4525: 
 4526:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4527: 
 4528:       const int id1 = elem->nodeLocalIdx(node1); 
 4529:       const double area = elem->area;
 4530: 
 4531:       if (elem->isTri()) {
 4532: 
 4533:          // To clarify the notation in this section: 
 4534:          //   i stands for the node under consideration (node1)
 4535:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4536:          const int id2 = elem->nxq(1 + id1);
 4537:          const int id3 = elem->nxq(2 + id1);
 4538:          Node *node2 = elem->nodes[id2];
 4539:          Node *node3 = elem->nodes[id3];
 4540: 
 4541:          Point2 x1, x2, x3;
 4542:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4543: 
 4544: 
 4545:          // integral of phi_i*phi_j
 4546:          const double ipp_ii = (1.0/6.0 )*area;
 4547:          const double ipp_ij = (1.0/12.0)*area;
 4548:          const double ipp_ik = (1.0/12.0)*area;
 4549: 
 4550:          // integral of [(grad phi_i) * (grad phi_j)]
 4551:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4552:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4553:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4554: 
 4555:          // Computes the different components of integral I_1 of each node with respect to node i.
 4556:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4557:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4558:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4559: 
 4560:          node1->addToSparseMatrix(node1, I1_ii);
 4561:          node1->addToSparseMatrix(node2, I1_ij); 
 4562:          node1->addToSparseMatrix(node3, I1_ik);
 4563: 
 4564:       }
 4565:       else { // Quad
 4566:          // XXX IMPLEMENT THIS
 4567:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4568: 
 4569:          // // To clarify the notation in this section: 
 4570:          // //   i stands for the node under consideration (node1)
 4571:          // //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4572:          // const int id2 = elem->nxq(1 + id1);
 4573:          // const int id3 = elem->nxq(2 + id1);
 4574:          // const int id4 = elem->nxq(3 + id1);
 4575:          // Node *node2 = elem->nodes[id2];
 4576:          // Node *node3 = elem->nodes[id3];
 4577:          // Node *node4 = elem->nodes[id4];         
 4578: 
 4579:          // // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4580:          // const double ipp_ii = elem->intPhiPhi(id1, id1);
 4581:          // const double ipp_ij = elem->intPhiPhi(id1, id2);
 4582:          // const double ipp_ik = elem->intPhiPhi(id1, id3);
 4583:          // const double ipp_il = elem->intPhiPhi(id1, id4);
 4584: 
 4585:          // // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4586:          // const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4587:          // const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4588:          // const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4589:          // const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4590: 
 4591:          // // Computes the different components of integral I_1 of each node with respect to node i.
 4592:          // const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4593:          // const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4594:          // const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4595:          // const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4596: 
 4597:          // node1->addToSparseMatrix(node1, I1_ii);
 4598:          // node1->addToSparseMatrix(node2, I1_ij); 
 4599:          // node1->addToSparseMatrix(node3, I1_ik);
 4600:          // node1->addToSparseMatrix(node4, I1_il);
 4601:   
 4602:       } 
 4603: 
 4604:  
 4605:       // Integral I_4
 4606:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4607:       // Where
 4608:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4609: 
 4610:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4611:       // of U over the element.
 4612:       Vector2 U = {0.0, 0.0};
 4613:       for (int m=0; m < elem->i34; m++) {      
 4614:          const Side *side = elem->sides[m];
 4615: 
 4616:          if constexpr(ics == 1) U += side->U; 
 4617:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4618: 
 4619:       }
 4620:       U = U/elem->i34;
 4621: 
 4622: 
 4623:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4624: 
 4625: 
 4626:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4627:       const double I_4_1 = dot(gradPhi_1, U);
 4628: 
 4629: 
 4630:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4631:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4632: 
 4633:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4634: 
 4635:       // Additional terms 
 4636:       double vnorm = 0.0;
 4637:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4638:          Vector3 ubed = {0.0, 0.0, 0.0};
 4639:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4640:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4641: 
 4642:          Vector3 gradP = {0.0, 0.0, 1.0};
 4643:          for (int m=0; m < elem->i34; m++) {
 4644:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4645:            gradP += toVector3(gradP_2D, 0.0);
 4646:          }   
 4647:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4648:       } // imm==2
 4649: 
 4650:       if (elem->isTri()) {
 4651:          for (int l=0; l<3; l++) {
 4652: 
 4653:             Node *node = elem->nodes[l];
 4654: 
 4655:             double fac = (node == node1) ? 2.0 : 1.0;
 4656:    
 4657:             if      constexpr(imm == 2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4658:             else if constexpr(imm == 1) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + (node->bdef2 - node->bdef1)); 
 4659:             else                        node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2); 
 4660:            
 4661:          }
 4662: 
 4663: 
 4664:          if (!elem->isDry) {
 4665:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4666: 
 4667:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4668: 
 4669:          }
 4670: 
 4671:       } // isTri
 4672:       else { // isQuad
 4673:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4674:          // for (int l=0; l<4; l++) {
 4675:          //   const Node *node = elem->nodes[l];
 4676: 
 4677:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4678:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4679: 
 4680:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4681:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4682:          // }
 4683: 
 4684:       } // isQuad
 4685: 
 4686: 
 4687:      node1->qel += (dt/elem->i34)*elem->vsource;
 4688:       
 4689: 
 4690:    } // for all elements connected to the node
 4691:    
 4692: 
 4693:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4694:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4695:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4696:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4697:       // If it is an open boundary node...
 4698: 
 4699:       // At least one open bnd side, maybe two
 4700:       for (int l=0; l<2; l++) { 
 4701: 
 4702:          // Gets each of the sides sharing the node. 
 4703:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4704: 
 4705:        
 4706: 
 4707:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4708:          if (sideBnd != nullptr) {
 4709:             // If the side is on a boundary...
 4710: 
 4711:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4712: 
 4713:             // Get the boundary segment
 4714:             const BoundarySegment *sideSegment = sideBnd->segment;
 4715:             const Side *side = sideBnd->side;
 4716: 
 4717:             // Integral I_3
 4718:             if (sideSegment->ifltype != 0) {
 4719:             // Natural or Flather b.c.
 4720: 
 4721:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4722:                // especially for Flather b.c.
 4723:                double ri3 = 0.0;
 4724:                if (!side->isDry) {
 4725:                   // If the side is not dry
 4726:                   
 4727:                   // Computes the side flux of (uth, vth)
 4728:                   double Vn = 0.0;
 4729:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4730:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4731:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4732: 
 4733:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4734:                   }
 4735: 
 4736:                   ri3 = 0.5*side->len*Vn;
 4737:                }
 4738: 
 4739:                if (sideSegment->ifltype == -1) { // Flather 1
 4740: 
 4741:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4742:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4743: 
 4744:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4745:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4746:                   
 4747:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4748:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4749: 
 4750:                } 
 4751:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4752:                   // Reset ri3
 4753:                   ri3 = 0.0;
 4754: 
 4755:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4756:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4757: 
 4758:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4759: 
 4760:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4761:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4762: 
 4763:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4764:                   node1->addToSparseMatrix(node1, con0*2.0);
 4765:                   node1->addToSparseMatrix(node2, con0);
 4766: 
 4767:                } // if Flather or Discharge
 4768: 
 4769:                node1->qel -= thetai*dt*ri3;
 4770: 
 4771: 
 4772:             } // I_3
 4773:           
 4774: 
 4775:             // Integral I_5
 4776:             if(!side->isDry) {
 4777: 
 4778:                const double Unbar = dot(side->U, side->n);
 4779:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4780: 
 4781:             } // I_5
 4782: 
 4783:          } // if is boundary side
 4784: 
 4785:       } // for l
 4786: 
 4787:    } // if isbnd
 4788: 
 4789: 
 4790: }
 4791: 
 4792: 
 4793: 
 4794: extern "C" {
 4795:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4796:                                   int* indices, int* indptr) {
 4797: 
 4798:       NODE(node);
 4799:       
 4800:       const int idx = node->idx;
 4801:       
 4802:       // Computes the index in the nzz array      
 4803:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4804: 
 4805: 
 4806:       indptr[idx] = nzzIdx;
 4807:       indices[nzzIdx] = idx;
 4808: 
 4809:       data_d[nzzIdx]    = node->coeffDiag;
 4810: 
 4811:       b_d[idx] = node->qel;
 4812: 
 4813:       for (int k = 0; k < node->numNodes; ++k) {
 4814:          const Node* nb = node->nodes[k];
 4815: 
 4816:          const int j = nb->idx;
 4817: 
 4818:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4819: 
 4820:          indices[nzzIdx + k + 1] = j;
 4821:       }
 4822: 
 4823:  
 4824:    }
