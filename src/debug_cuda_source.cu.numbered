 2734: 
 2735: __device__ void Node::updateKb(void) {
 2736: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2737: 
 2738:    if constexpr(ivcor == 1) return;
 2739: 
 2740: 
 2741:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2742: 
 2743:    if constexpr(ivcor == 2) {  // SZ coordinates
 2744:       
 2745:       // Compute bottom level index
 2746:       if (depth <= mesh->h_s) {
 2747:          kb = izlev;   
 2748:          
 2749:       } else {
 2750:          kb = -1;
 2751:          int L = 0;
 2752:          int R = nzlev; 
 2753:          
 2754:          while (L <= R) {
 2755:             int M = (R + L) / 2;
 2756: 
 2757: 
 2758:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2759:             
 2760:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2761:                R = M;
 2762:             } else {
 2763:                L = M;
 2764:             }
 2765: 
 2766:             if (R - L == 1) {
 2767:                kb = L;
 2768:                break;
 2769:             }
 2770:          }
 2771: 
 2772:          // Checks that the binary search was successful
 2773:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2774:        
 2775:       }
 2776:    } 
 2777: }
 2778: 
