 6074:       }
 6075: 
 6076:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6077:       node->setWind(wind);
 6078: 
 6079:       node->pr = pressAir[idx];
 6080:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6081: 
 6082:    }
