 7621: __global__ void printMatrix(bool full) {
 7622:    // Debugging: print the matrix
 7623: 
 7624:    const int size = mesh->np;
 7625:    double sum = 0.0;
 7626:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7627:       const Node *node = mesh->localNodeData + idx_node;
 7628:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7629:       for (int j = 0; j < node->numNodes; j++) {
 7630:          Node* nbNode = node->nodes[j];
 7631:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7632:          sum += node->coeffMatrix[j];
 7633:       }
 7634:       if (full) printf("]\n");
 7635: 
 7636: 
 7637:    }
 7638:    if (!full) printf("sum=%lf\n", sum);
 7639: }
