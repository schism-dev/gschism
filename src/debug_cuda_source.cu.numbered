 1364:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1365:       // Compute the different time ramps used in the code 
 1366:       // This function is performed by just one thread
 1367: 
 1368:       if constexpr(ibc == 0) {
 1369:          if (drampbc > 0.0) {
 1370:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1371:          } else {
 1372:             rampbc = 1.0;
 1373:          }
 1374: 
 1375:          if (nws != 0 && drampwind > 0.0) {
 1376:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1377:          } else {
 1378:             rampwind = 1.0;
 1379:          }
 1380:       }
 1381: 
 1382:       if (drampwafo > 0.0) {
 1383:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1384:       } else {
 1385:          rampwafo = 1.0;
 1386:       }
 1387: 
 1388:       // For source/sinks
 1389:       if (if_source && dramp_ss > 0.0) {
 1390:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1391:       } else {
 1392:          ramp_ss = 1.0;
 1393:       }
 1394: 
 1395:       if (dramp > 0.0) {
 1396:          ramp = tanh(2.0*time/86400.0/dramp);
 1397:       } else {
 1398:          ramp = 1.0;
 1399:       }
 1400: 
 1401:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1402:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1403:    }
 1404:       
 1405: 
