 8678: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8679:    // Get the value of a variable from an side
 8680:    // varName is the name of the variable to get
 8681:    // var is the array to store the value
 8682:    // k is the vertical level index of the variable to get
 8683:    SIDE_BND(sideBnd);   
 8684: 
 8685:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8686:    if (sideBnd->segment->isLand) idx = -7;
 8687: 
 8688:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8689:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8690: 
 8691: }
