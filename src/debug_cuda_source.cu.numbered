 4246:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4247: 
 4248:       SIDE(side);
 4249: 
 4250: 
 4251:       side->U = {0.0, 0.0}; 
 4252:          
 4253:       if(side->isDry) return;
 4254: 
 4255:       const Node *node1 = side->n1;
 4256:       const Node *node2 = side->n2;
 4257: 
 4258:       // Vertically integrated velocity U (in ll if ics=2)
 4259:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4260:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4261:       }
 4262: 
 4263:    }
 4264: 
 4265:    __global__ void computeBottomDragVegetation(void) {
 4266:       // UNFINISHED. CHECK THIS:
 4267:       // How many kernels are needed? Why so many for loops?
 4268:       // Is the loop on sides needed?
 4269: 
 4270:       NODE(node);
 4271: 
 4272:       const int    kb      = node->kb;
 4273:       const double htot    = node->htot2();
 4274:       const double rough   = node->rough;
 4275: 
 4276: 
 4277:       if (node->isDry) {
 4278:          // Default values for dry nodes
 4279:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4280:          /// XXX CHECK INDICES
 4281:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4282:       }
 4283: 
 4284:       // Compute bottom drag Cd
 4285:       //--------------------------------
 4286: 
 4287:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4288:       if (nchi==1) {
 4289: 
 4290:          bool ltmp = false; // for WBL iteration
 4291: 
 4292:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4293:          // Drag at nodes
 4294:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4295:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4296:         
 4297:          const double rough = node->rough;
 4298:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4299:          if (node->rough == 0.0) {
 4300:             node->Cd = 0.0;
 4301: 
 4302:          } else { //roughness >0 
 4303:             
 4304:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4305:             const double bthick = max(dzb_min, bthick_ori);
 4306: 
 4307:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4308: 
 4309:             double tmp = 1.0/(2.5*log(bthick/rough));
 4310:             node->Cd = tmp*tmp;
 4311: 
 4312:          } // if rough
 4313: 
 4314: 
 4315:          // RECOVER THIS: XXX
 4316:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4317:          // Output warning for WBL if iteration didn't converge
 4318: 
 4319: 
 4320:       } // nchi==1
 4321: 
 4322:       //   Bottom stress in m^2/s^2
 4323:       if (node->rho[kb + 1] >= -98.0)
 4324:       {
 4325:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4326:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4327:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4328:          // !sediment erosion: this part needs more documentation
 4329:       }
 4330: 
 4331:     
 4332:       // Compute vegetation parameters
 4333:       //--------------------------------
 4334: 
 4335:       // SAV constants
 4336:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4337:       constexpr double veg_cfpsi = 0.16;
 4338: 
 4339:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4340:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4341: 
 4342:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4343:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4344:          int kbin = 0; // bin index
 4345:          for (int k = kb; k < nvrt; k++) {
 4346:             // Computes node height above the bottom level
 4347:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4348:             assert(false && "Vertical variation of vegetation not implemented");
 4349: 
 4350:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4351:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4352:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4353:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4354:             // } else {
 4355:             //    // Find the bin at which the current vertical level is
 4356:             //    while (kbin<nbins_veg_vert) {
 4357:             //       const double zn = node->z[kbin];
 4358:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4359:             //          break;
 4360:             //       } // if
 4361:             //       kbin++;
 4362:             //    } // while
 4363:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4364: 
 4365:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4366:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4367:                
 4368:             //    // Linear interpolation of the vegetation parameters
 4369:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4370:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4371:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4372:             // } // if rl10
 4373: 
 4374:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4375: 
 4376:          } // for k
 4377: 
 4378: 
 4379:       } else { // Ganthy (iveg=2)
 4380:       //  Modify canopy height, diameter, and density
 4381: 
 4382:          // Make sure there is vegetation on this node
 4383:          if (node->veg_h_unbent > 0.0) {
 4384:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4385: 
 4386:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4387:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4388:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4389: 
 4390:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4391:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4392:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4393:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4394:          } // if veg_h_unbent
 4395: 
 4396:          for (int k = 0; k < nvrt; k++) {
 4397:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4398:          } // for k
 4399:       
 4400: 
 4401:       } // if iveg
 4402:      
 4403:          
 4404: 
 4405:       // Compute vertical mean of veg_alpha3D
 4406:       if (iveg != 0) {
 4407:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4408:          double sum1=0.0;
 4409:          double sum2=0.0;
 4410:          // Integrate over each level under the canopy...
 4411:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4412:             const double Dz = node->Dz(k);
 4413: 
 4414:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4415:             sum2 += Dz;
 4416: 
 4417:          } // for k
 4418: 
 4419:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4420:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4421: 
 4422:       } // if iveg
 4423: 
 4424:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4425: 
 4426:    }
 4427: 
 4428:    __global__ void computeVegetationAndDragParameters(void) {
 4429:       // Computes the vegetation and drag model parameters:
 4430:       // chi, \tilde\chi, beta, \breve{H}
 4431:       
 4432:       SIDE(side);
 4433: 
 4434:       const double htot = side->htot2();
 4435:       const int    kb   = side->kb;
 4436: 
 4437:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4438: 
 4439:       const double veg_h     = side->veg_h();
 4440:       const double veg_nv    = side->veg_nv();
 4441:       const double veg_c     = side->veg_c();
 4442:       const double veg_beta  = side->veg_beta;
 4443:       const double veg_alpha = side->veg_alpha_vert_mean();
 4444: 
 4445:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4446:       // Velocity magnitude at the bottom level
 4447:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4448:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4449:       side->chi2 = side->Cd()*vmag1;
 4450:       side->chi  = side->chi2;
 4451:       if constexpr(iveg != 0) {
 4452:          const Node *n1 = side->n1;
 4453:          const Node *n2 = side->n2;
 4454:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4455:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4456:       }
 4457: 
 4458:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4459: 
 4460:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4461:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4462:       double magUa = 0.0;
 4463:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4464:          // 3D wet side with veg...
 4465: 
 4466:          double magUa = 0.0;
 4467:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4468:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4469: 
 4470:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4471:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4472:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4473: 
 4474:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4475:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4476: 
 4477:                // Velocity magnitude at the bottom (l) of the level
 4478:                const double ul = length(side->u2[k]);
 4479: 
 4480:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4481:                magUa += Dz*0.5*(uh + ul);
 4482: 
 4483:             } // if HasVegetation
 4484:          } // for k
 4485:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4486: 
 4487:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4488:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4489:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4490:             const double zCpy = side->zTopCanopy();
 4491:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4492:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4493:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4494:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4495:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4496:          } // if isSubmerged
 4497:       } // if iveg   
 4498: 
 4499:       // Computes the friction modified depth, \breve{H} in notes
 4500:       if (side->is2D()) { // 2D
 4501: 
 4502:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4503:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4504: 
 4505:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4506: 
 4507:          side->hhat = htot*htot/fricH; 
 4508: 
 4509:       } else { // 3D
 4510:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4511: 
 4512:          if constexpr(iveg != 0) {
 4513:             
 4514:             if (side->isSubmerged()) { 
 4515:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4516:                side->hhat -= veg_c*Hhat_alpha;
 4517: 
 4518:             } else { // Emergent
 4519:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4520:             }
 4521:          } // if iveg
 4522: 
 4523:          // Enforce positivity for 3D model
 4524:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4525:       } // if 3D
 4526: 
 4527:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4528: 
 4529:         
 4530:    }
 4531: 
 4532: 
 4533: 
 4534:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4535:    // Computes the density gradient between two elements, e1 and e2.
 4536:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4537:    // zero in the direction normal to the side. 
 4538:    // 
 4539:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4540:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4541:    //
 4542:    // Input:
 4543:    //    e1: Element
 4544:    //    e2: Neighbor element (or nullptr if boundary)
 4545:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4546:    //    k: Index of the half-level at which the density is interpolated
 4547:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4548:    // 
 4549:    // Output:
 4550:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4551:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4552: 
 4553:       if (e2 == nullptr || e2->isDry) {
 4554:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4555: 
 4556:          Side *side = e1->sides[j];
 4557:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4558:                  
 4559:          if constexpr(ics == 1) {
 4560:             vec = side->n; // Normal vector to the side
 4561:          } else {
 4562:             // IMPLEMENT THIS XXXXXX
 4563:             // !replace with xel, yel?
 4564:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4565:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4566:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4567:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4568:          } //ics
 4569:                    
 4570:          diffRho = 0.0;
 4571: 
 4572:       } else { //internal and wet
 4573:          if constexpr(ics==1) {
 4574:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4575: 
 4576:             // Vector from e1 to e2
 4577:             vec = toVector2(e2->center - e1->center);
 4578: 
 4579:          } else { 
 4580:             // IMPLEMENT THIS XXXXXX
 4581:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4582:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4583:             //                   alow(j)=xctr2
 4584:             //                   bdia(j)=yctr2
 4585:          } // ics
 4586: 
 4587:          diffRho = rho2 - e1->demeanedDensity(k);
 4588:       }
 4589: 
 4590:    }
 4591: 
 4592:    __global__ void computeDensityCubicSplines(void) {
 4593:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4594: 
 4595:       ELEM(elem);
 4596: 
 4597:       if (elem->isDry) return;
 4598: 
 4599:       const int kb = elem->kb;
 4600: 
 4601:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4602:       if (elem->is2D()) {
 4603:          // In the 2D case, the density is constant at the prism level. 
 4604:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4605:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4606:       } else { //3D
 4607: 
 4608:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4609:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4610:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4611:          ///// XXXX CHECK INDICES!!!!!
 4612:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4613:       } // 2D/3D
 4614: 
 4615:    }
 4616: } // extern "C"
 4617: 
 4618: 
 4619: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4620: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4621: 
 4622:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4623: 
 4624:    const int kb  = elem->kb;
 4625:    const int kb2 = elem2->kb;
 4626: 
 4627:    // z-coordinate of prism of elem
 4628:    const double zp = elem->z_prism(k);
 4629: 
 4630:    double rho = 0.0;
 4631: 
 4632:    if (elem2->is2D()) {
 4633:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4634: 
 4635:    } else {  // 3D
 4636: 
 4637:       // eta_min may be < zmax
 4638:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4639:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4640: 
 4641:       // (Extrapolate density below bottom, we will fix it later)
 4642:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4643:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4644:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4645:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4646:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4647:    } // 2D/3D
 4648:      
 4649: 
 4650:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4651:    // Now we need to fix it.
 4652:    if (elem->z[k] < elem2->z[kb2]) {
 4653:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4654: 
 4655:       // There are two methods to adjust the density at the bottom of the element.
 4656:       // iunder_deep=0: 
 4657:       const double depth1 = abs(elem->z[kb]); // larger depth
 4658: 
 4659:       if (iunder_deep==0) {
 4660: 
 4661:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4662: 
 4663:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4664: 
 4665:       } else { // iunder_deep != 0
 4666: 
 4667:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4668: 
 4669:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4670: 
 4671:          //   Demeaned density at the same z coordinate as
 4672:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4673:          }
 4674: 
 4675:       } // if iunder_deep
 4676:    } // if elem->z[kb] < elem2->z[kb]
 4677: 
 4678:    return rho;
 4679: }
 4680: 
 4681: 
 4682: extern "C" {
 4683:    __global__ void computeDensityGradient(void) {
 4684: 
 4685:          // Compute the horizontal density gradient at each element.
 4686:       // It works in two steps:
 4687:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4688:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4689:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4690:       //             gradRho.r1 = rho1 - rho0
 4691:       //             gradRho.r2 = rho2 - rho0
 4692:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4693:       // 
 4694:       //  NOTE: We use de-meaned densities.
 4695: 
 4696:       ELEM(elem);
 4697: 
 4698:       if (elem->isDry) return;
 4699: 
 4700:       const int kb  = elem->kb;
 4701:       const int i34 = elem->i34;
 4702: 
 4703:       for (int k = kb + 1; k < nvrt; k++) {
 4704:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4705:          //             gradRho.r1 = rho1 - rho0
 4706:          //             gradRho.r2 = rho2 - rho0
 4707:          int icount = 0;
 4708:          double sumRx = 0.0;
 4709:          double sumRy = 0.0;
 4710:          for (int j1=0; j1<i34; j1++) { 
 4711: 
 4712:             const int j2 = elem->nxq(j1 + 1);
 4713: 
 4714:             // Pairs of consecutive neighbor elements of elem
 4715:             const Element *e1 = elem->nghbElems[j1];
 4716:             const Element *e2 = elem->nghbElems[j2];
 4717: 
 4718:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4719:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4720:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4721: 
 4722:             // Compute the density difference and the vector from elem to e1 and e2
 4723:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4724:             double diffRho1, diffRho2;
 4725:             Vector2 vec1, vec2;
 4726:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4727:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4728: 
 4729:             const double rl1 = length(vec1);
 4730:             const double rl2 = length(vec2);
 4731:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4732: 
 4733:             const double delta = cross(vec1, vec2);
 4734:             const double sintheta = abs(delta)/(rl1*rl2);
 4735: 
 4736:             // To avoid problems, avoid elements with small angle between vectors
 4737:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4738:             const bool validEq = (sintheta > sin_one_deg);
 4739: 
 4740:             if (validEq) {
 4741:                // Solve the system of equations to get the density gradient at elem
 4742:                icount++;
 4743:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4744:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4745:                sumRx += Rx;
 4746:                sumRy += Ry;
 4747:             }
 4748:          } // for j1
 4749: 
 4750:          // Compute the average density gradient at elem
 4751:          if (icount==0) {
 4752:            // Bad mesh quality; bail out with 0 b-cc
 4753:            elem->gradRho[k] = {0.0, 0.0};
 4754:          } else {
 4755:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4756:          }
 4757: 
 4758:       } // for k
 4759: 
 4760:    }
 4761: 
 4762:    __global__ void computeBaroclinicTerm(void) {
 4763:    // Computes the baroclinic term at sides (at half levels).
 4764:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4765:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4766: 
 4767:       SIDE(side);
 4768: 
 4769:       if (side->isDry) return;
 4770: 
 4771:       const Element *e1 = side->elems[0];
 4772:       const Element *e2 = side->elems[1];      
 4773:       const int kb = side->kb;
 4774:       
 4775:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4776: 
 4777:       // interpolates vertically the density gradient of the two elements at the half level/
 4778: 
 4779:       // Starts the integration at the surface and goes down to the bottom
 4780:       int k1 = nvrt - 1;
 4781:       int k2 = nvrt - 1;
 4782: 
 4783:       side->bcc[nvrt-1] = {0.0, 0.0};
 4784:       for (int k = nvrt-2; k >= kb; k--) {
 4785:       // For each prism level (from surface to bottom)...
 4786: 
 4787:          // For both elements, interpolate density gradient at the side's half level.
 4788:          // The gradient at the side is the average of the gradients at the elements.
 4789:          // w1, w2 are used to take into account boundary sides, with just one element.
 4790:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4791:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4792:          const double wsum = w1 + w2;
 4793:          w1 = w1/wsum;
 4794:          w2 = w2/wsum;
 4795:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4796: 
 4797:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4798:          Vector2 gradRho = {0.0, 0.0};
 4799:          if (e1 != nullptr && k > kb) {
 4800:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4801:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4802:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4803:             
 4804:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4805:          }      
 4806:          if (e2 != nullptr && k > kb) {
 4807:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4808:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4809:             
 4810:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4811:          }
 4812: 
 4813:          if constexpr(ics==2) {
 4814:             // IMPLEMENT THIS XXXXXX
 4815:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4816:             // swild(1)=tmp1
 4817:             // swild(2)=tmp2
 4818:          }
 4819:          
 4820:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4821:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4822:          // CHECK INDICES!!! XXX
 4823:          const double grav3 = side->grav3();
 4824:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4825: printf(">>>side->bcc[%d] = %e, %e, rampbc: %e, grav3: %e, rho0: %e, side->Dz(k + 1): %e, gradRho: %e, %e\n", k, side->bcc[k].x, side->bcc[k].y, rampbc, grav3, rho0, side->Dz(k + 1), gradRho.x, gradRho.y);
 4826: 
 4827:       } // for
 4828: 
 4829:    }
 4830: 
 4831: 
 4832: 
 4833:    __global__ void computeHorGradientAtSide(void) {
 4834: 
 4835:       // Compute the horizontal density gradient at each element.
 4836:       // It works in two steps:
 4837:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4838:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4839:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4840:       //             gradRho.r1 = rho1 - rho0
 4841:       //             gradRho.r2 = rho2 - rho0
 4842:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4843:       // 
 4844:       //  NOTE: We use de-meaned densities.
 4845: 
 4846:       SIDE(side);
 4847: 
 4848:       if (side->isDry) return;
 4849: 
 4850:       // Computes the gradient of the variables at the side center.
 4851:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4852:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4853:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4854: 
 4855:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4856:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4857:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4858:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4859: 
 4860: 
 4861:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4862:          side->gradEta1.x, side->gradEta1.y, 
 4863:          side->gradEta2.x, side->gradEta2.y, 
 4864:          side->gradETP.x, side->gradETP.y, 
 4865:          side->gradPr.x, side->gradPr.y);
 4866: 
 4867: 
 4868:    }
 4869: 
 4870: 
 4871:    __global__ void solveMomentumEquations(double time) {
 4872: 
 4873:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4874:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4875: 
 4876:       SIDE(side);
 4877: 
 4878:       if (side->isDry) 
 4879:       {
 4880:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4881: 
 4882:          return;
 4883:       }
 4884: 
 4885:       const Node *n1 = side->n1;
 4886:       const Node *n2 = side->n2;
 4887: 
 4888:       const int kb = side->kb;
 4889: 
 4890:       const double veg_h = side->veg_h();
 4891:       const double grav3 = side->grav3();
 4892: 
 4893: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4894:       if (side->is2D()) {
 4895:          // Warning: Do not use htot2, which is updated.
 4896:          const double htot = side->htot1();
 4897:          const double hhat = side->hhat;
 4898: 
 4899:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4900: 
 4901:          Vector2 tau2 = {0.0, 0.0};
 4902:           
 4903:          if constexpr(ics==1) {
 4904:             tau2 = side->tau();
 4905: 
 4906:          } else {
 4907:             assert(false && "Not implemented: ics == 2");
 4908:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4909:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4910:             // taux2=(vn1+tt1)*0.5d0
 4911:             // tauy2=(vn2+ss1)*0.5d0
 4912:          } // if ics         
 4913: 
 4914:          // hat_gam has units of m/s
 4915: 
 4916:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4917: 
 4918:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4919:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4920: 
 4921:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4922: 
 4923:          const double ux = -clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4924:          const double uy = -clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4925: 
 4926:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4927: 
 4928: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e, hat_gam = %e, %e, hhat = %e, htot = %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y, side->d2uv[nvrt-1].x, side->d2uv[nvrt-1].y, hhat, htot);
 4929: 
 4930:       }
 4931:       else { // 3D
 4932: 
 4933:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4934:          // 
 4935:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4936:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4937:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4938:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4939:          // k+1 and k.
 4940: 
 4941: 
 4942:          // // Define layer thickness & viscosity
 4943:          // for (int k=kb + 1; k<nvrt; k++) {
 4944:          //    const double dzz = side->Dz(k - 1);
 4945: 
 4946:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4947: 
 4948:          //    // Vertical viscosity at the face center
 4949:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4950:         
 4951:          // }
 4952: 
 4953: 
 4954:          const int ndim = nvrt - kb;
 4955:          const double zTopCanopy = side->zTopCanopy();
 4956: 
 4957:          // Initialize the tridiagonal system
 4958:          for (int k = kb + 1; k<nvrt; k++) {
 4959:             
 4960:             const int kin = k - kb;
 4961: 
 4962:             // Vertical viscosity at the face center
 4963:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4964:             const double dzz = side->Dz(k);
 4965: 
 4966:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 4967:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 4968:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4969: 
 4970:             alow[kin] = 0.0;
 4971:             cupp[kin] = 0.0;
 4972:             bdia[kin] = 0.0;
 4973: 
 4974:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4975:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4976: 
 4977:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4978:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4979:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4980: 
 4981:             // First part: layers k, k+1
 4982:             if (k < nvrt - 1) {
 4983:                              
 4984:                if constexpr(iveg != 0) {
 4985: 
 4986:                   // If there is vegetation at this level...
 4987:                   if (zTopCanopy > side->zc[k]) {
 4988:                      // If the canopy is above the k layer...
 4989:                      
 4990:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4991:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4992:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4993:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4994: 
 4995:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4996:                      const double vmag2 = length(ut2);
 4997:                      const double vmag1 = length(side->u2[k]);
 4998:                      const double vmag = 0.5*(vmag1 + vmag2);
 4999:                      
 5000:                      // Computes the vegetation alpha at the face center
 5001:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5002: 
 5003:                      cff1 += veg_alpha_sd*dt*vmag;
 5004: 
 5005:                   } // if (zTopCanopy
 5006:                } // if iveg
 5007: 
 5008:                const double tmp = dt*dfz/dzz;
 5009:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5010:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5011: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 5012:             }
 5013: 
 5014: 
 5015:             // Second part: layers k-1, k
 5016:             if (k > kb + 1) {
 5017: 
 5018:                double cff1 = 1.0; //init \bar{c^k}
 5019: 
 5020:                if constexpr(iveg != 0) {
 5021:                   // If there is vegetation at this level...
 5022:                   if (zTopCanopy > side->zc[k-1]) {
 5023:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5024:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5025: 
 5026:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5027: 
 5028:                      const double vmag2 = length(ut2);
 5029:                      const double vmag1 = length(side->u2[k-1]);
 5030:                      const double vmag = 0.5*(vmag1 + vmag2);
 5031: 
 5032:                      // Computes the vegetation alpha at the face center
 5033:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5034:                      cff1 += veg_alpha_sd*dt*vmag;
 5035:                   } // if zTopCanopy
 5036: 
 5037:                } // if iveg
 5038: 
 5039:                const double tmp = dt*dfz/dzz;
 5040:                alow[kin] += cff1*dzz/6.0 - tmp;
 5041:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5042: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 5043:             } else { // Bottom boundary
 5044:                // This occurs at the bottom, where the bottom drag is applied.
 5045: 
 5046:                bdia[kin] += dt*side->chi2;
 5047: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 5048:             } // if (k > kb + 1)
 5049: 
 5050: 
 5051: 
 5052:          } // for (int k
 5053: 
 5054: 
 5055: 
 5056:          // Computes the RHS.
 5057:          // -----------------
 5058: 
 5059:          //	BC to be imposed at the end.
 5060: 
 5061:          const Vector2 gradETP  = side->gradETP;
 5062:          const Vector2 gradPr   = side->gradPr;
 5063:          const Vector2 gradEta1 = side->gradEta1;
 5064:          const Vector2 gradEta2 = side->gradEta2;
 5065: 
 5066:          const Vector2 *btu = side->btu;
 5067:          const Vector2 *u2  = side->u2;
 5068:          const double coriolis = side->coriolis;
 5069:          const Vector2 *d2uv = side->d2uv;
 5070: 
 5071: 
 5072:          for (int k = kb + 1; k<nvrt; k++) {
 5073:             const int kin = k - kb;
 5074: 
 5075:             const double dz_0 = side->Dz(k);
 5076:             const double dz_1 = side->Dz(k+1);  
 5077: 
 5078:             rrhs[kin] = {0.0, 0.0};
 5079:             double dz = 0.0;
 5080: 
 5081:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5082:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5083:             if (k < nvrt  ) dz += 0.5*dz_1;
 5084:             if (k > kb + 1) dz += 0.5*dz_0;
 5085: 
 5086:             // Elevation gradient, atmospheric pressure and tidal potential
 5087:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5088: 
 5089:             // Coriolis, advection, wind stress, and horizontal viscosity
 5090:             if (k < nvrt - 1) {
 5091: 
 5092: 
 5093:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5094:                                           (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 5095:                                           dt*(2.0*d2uv[k] + d2uv[k + 1]));
 5096: 
 5097:                //diff stress tensors 1006
 5098:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5099:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5100:                   assert(false && "Not implemented: itur == 5");
 5101:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5102:                }
 5103: 
 5104:             } else { // k=nvrt
 5105:                Vector2 tau2 = {0.0, 0.0};
 5106:                if constexpr(ics==1) {
 5107:                   tau2 = side->tau();
 5108:                } else {
 5109:                   assert(false && "Not implemented: ics == 2");
 5110:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5111:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5112:                   // taux2=(vn1+tt1)*0.5d0
 5113:                   // tauy2=(vn2+ss1)*0.5d0
 5114:                } // if ics
 5115: 
 5116:                rrhs[kin] += dt*tau2;
 5117: 
 5118:             } // if k<nvrt
 5119: 
 5120:             if (k > kb + 1) {
 5121:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5122:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 5123:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 5124: 
 5125: 
 5126:                // diff stress tensors 1006
 5127:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5128:                   assert(false && "Not implemented: itur == 5");
 5129:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5130:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5131:                }
 5132: 
 5133:             } // if k>kbs + 1
 5134: 
 5135:             // Baroclinic
 5136:             Vector2 *bcc = side->bcc;
 5137:             if constexpr(ibc == 0) {
 5138:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5139:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5140: 
 5141:             } // if ibc==0
 5142: 
 5143: 
 5144:          } // k=kb + 1,nvrt
 5145: 
 5146:    printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 5147:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5148:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5149: 
 5150:          for (int k=kb + 1; k<nvrt; k++) {
 5151:             const int kin = k - kb;
 5152: 
 5153:             // Velocity is always clamped to maximum values
 5154:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 5155:          } // k
 5156: 
 5157:       } // if side->is2D()
 5158:       
 5159: 
 5160:       // Impose velocity boundary conditions at the bottom
 5161:       if constexpr(imm == 2) { // 3D bed deformation model
 5162:          double dep;
 5163:          Vector2 vel;
 5164: 
 5165:          assert(false && "Not implemented: imm == 2");
 5166:          //update_bdef(time, x0, y0, dep, vel);
 5167:          // side->u2[kb] = vel;
 5168: 
 5169:       } else { // imm = 0 or 1
 5170:          if (side->Cd() == 0.0) {
 5171:             side->u2[kb] = side->u2[kb + 1];
 5172:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 5173:             side->u2[kb] = {0.0, 0.0};
 5174:          }
 5175:           
 5176:       } // if imm
 5177: 
 5178:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 5179:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5180:       
 5181: 
 5182:    }
 5183: 
 5184: 
 5185:    __device__ void applyMomentumBC(void) {
 5186: 
 5187:       SIDE_BND(sideBnd);
 5188: 
 5189:       Side *side = sideBnd->side;
 5190:       const BoundarySegment *segment = sideBnd->segment;
 5191:       const Node *n1 = side->n1;
 5192:       const Node *n2 = side->n2;
 5193: 
 5194:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5195:       const bool isLand     = (segment == (BoundarySegment *)landSegment);
 5196:       const bool isInternal = (segment == (BoundarySegment *)internalSegment);
 5197: 
 5198:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 5199:       const int kb = side->kb;
 5200: 
 5201:       if (!isLand && segment->ifltype != 0) {
 5202:          const Vector2 *ubc = sideBnd->ubc;
 5203: 
 5204:          for (int k=kb; k < nvrt; k++) {
 5205:             
 5206:             assert(segment->ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5207:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5208: 
 5209:             if (segment->ifltype == -1) {
 5210:                // Flather 1
 5211: 
 5212:                const double depth = side->depth();
 5213: 
 5214:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5215: 
 5216:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->etaMeanBnd()) + dot(ubc[k], side->n);
 5217: 
 5218:                side->u2[k] = vnorm*side->n;
 5219: 
 5220:             } else if (segment->ifltype == -2) { // Discharge
 5221: 
 5222: 
 5223:                const double eta1 = side->eta1();
 5224:                const double eta2 = side->eta2();
 5225:                const double htot = side->htot2();
 5226: 
 5227:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5228:                assert(false && "Not implemented: Discharge bc");
 5229:                // const double dischrg = discharge(eta1);
 5230:                const double dischrg = 0.0; // XXX REMOVE
 5231:                
 5232: 
 5233:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5234: 
 5235:                const double vnorm = dischrg*eta2/htot;
 5236: 
 5237:                side->u2[k] = vnorm*side->n;
 5238: 
 5239: 
 5240:             }
 5241:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 5242:                const double vnorm = dot(side->u2[k], side->n);
 5243: 
 5244:                double rat;
 5245:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5246:                else              rat = segment->vobc2; // outgoing
 5247: 
 5248:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5249:             }
 5250:             else { // not Flather or 3D radiation
 5251:                side->u2[k] = ubc[k];
 5252: 
 5253:             } // if (segment->ifltype...
 5254: 
 5255:          }
 5256: 
 5257:       }
 5258:       else if (isLand) { // land bnd
 5259:          if constexpr(islip == 0) { // free slip
 5260:             for (int k=kb; k < nvrt; k++) {
 5261:                double vnorm = 0.0; // for most cases
 5262:                const double vtan = dot(side->u2[k], side->t());
 5263:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 5264:             }
 5265: 
 5266:          } else { // no slip
 5267:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5268: 
 5269:          }
 5270:       } // if (side segment type...
 5271: 
 5272:       
 5273: 
 5274: 
 5275: 
 5276:    }
 5277: 
 5278: 
 5279:    __device__ void shapiroFilter1(void) {
 5280:       // First step of the Shapiro filter (normally used if indvel<=0)
 5281:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5282: 
 5283:       if constexpr(ishapiro == 0) return;
 5284: 
 5285:       SIDE(side);
 5286: 
 5287:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 5288: 
 5289:       if (side->isDry || isInternal ) return;
 5290: 
 5291:       const int kb = side->kb;
 5292: 
 5293:       for (int mm = 1; mm <= niter_shap; mm++) {
 5294: 
 5295: 
 5296:          // Internal wet sides
 5297:          for (int k = kb + 1; k < nvrt; k++) {
 5298:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5299:             side->bcc[k] = {0.0, 0.0};
 5300:             Vector2 suru = {0.0, 0.0};
 5301: 
 5302:             for (int j=0; j<4; j++) {
 5303: 
 5304:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5305:                
 5306:                int kin = k;
 5307:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5308:                
 5309:                if constexpr(ics==1) {
 5310:                   suru += side->u2[kin];
 5311:                } else {
 5312:                   assert(false && "Not implemented: ics == 2");
 5313:                   // Vector2 vn1, vn2;
 5314:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5315:                   // suru=suru+vn1;
 5316:                   // surv=surv+vn2;
 5317:                }
 5318:             }
 5319: 
 5320:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5321: 
 5322:          }
 5323:       }
 5324:    }
 5325: 
 5326:    __device__ void shapiroFilter2(void) {
 5327:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5328: 
 5329:       if constexpr(ishapiro == 0) return;
 5330: 
 5331:       SIDE(side);
 5332: 
 5333:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 5334: 
 5335:       if (side->isDry || isInternal ) return;
 5336: 
 5337:       const int kb = side->kb;
 5338: 
 5339:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5340: 
 5341:       if (side->is2D()) {
 5342:          side->u2[kb] = side->u2[nvrt - 1];
 5343:          
 5344:       } else {
 5345:          // 3D
 5346:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5347:          
 5348:       }
 5349: 
 5350:    }
 5351: 
 5352: 
 5353:    __global__ void ul0UpdateZCoords(void) {
 5354:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5355:       
 5356:       NODE(node);      
 5357: 
 5358:       if (node->isDry2()) { 
 5359: 
 5360:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5361: 
 5362:          if constexpr(ivcor != 1) node->kb = 0;
 5363: 
 5364:       } else {
 5365: 
 5366:          node->updateKb();
 5367:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5368: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 5369: 
 5370:       } // if wet or dry
 5371: 
 5372:       // We use the temp.b field to store the previous state of isDry.
 5373:       node->tmp.b = node->isDry;
 5374: 
 5375:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5376:       node->isDry = true;
 5377: 
 5378:    }
 5379: 
 5380:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5381:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5382:    {
 5383:       ELEM(elem);
 5384: 
 5385:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5386: 
 5387:       // All the nodes of a wet element are wet.
 5388:       if (!elem->isDry) {
 5389:          elem->nodes[0]->isDry = false;
 5390:          elem->nodes[1]->isDry = false;
 5391:          elem->nodes[2]->isDry = false;
 5392:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5393: 
 5394:       }
 5395: 
 5396: 
 5397:       elem->kb = 0;
 5398: 
 5399:       if (elem->isDry) return;
 5400: 
 5401:       // Wet
 5402:       const Node *n1 = elem->nodes[0];
 5403:       const Node *n2 = elem->nodes[1];
 5404:       const Node *n3 = elem->nodes[2];  
 5405:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5406: 
 5407:    //    if(elem->isDry2()) {
 5408:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5409:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5410:    //        call parallel_abort(errmsg)
 5411:    //    }
 5412: 
 5413: 
 5414:       // Computes element's kb as the minimum of the nodes' kb.
 5415:       const int kb1 = n1->kb;
 5416:       const int kb2 = n2->kb;
 5417:       const int kb3 = n3->kb;
 5418:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5419: 
 5420: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5421: 
 5422:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5423: 
 5424: 
 5425:       // Computes the element z as the mean of the nodes z.
 5426:       for (int k = elem->kb; k < nvrt; k++) {
 5427: 
 5428:          // Compute the element z as the mean of the nodes z.
 5429:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5430:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5431:          elem->z[k] /= elem->i34;
 5432: 
 5433:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5434:       }
 5435:                   
 5436:    }
 5437: 
 5438:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5439:    {
 5440:       NODE(node);
 5441:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5442: 
 5443:       if (it == iths) return;
 5444: 
 5445: 
 5446:       if(!node->isDry && node->tmp.b) { // rewetted
 5447:          for (int k=0; k < nvrt; k++) {
 5448: 
 5449:             Vector3 utmp={0.0, 0.0, 0.0};
 5450: 
 5451:             double ttmp=0.0;
 5452:             double stmp=0.0;
 5453:             int icount=0;
 5454:             for (int j = 0; j < node->numNodes; j++) {
 5455: 
 5456: 
 5457:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5458:                if (!node->isDry) { // all indices extended
 5459:                   icount++;
 5460: 
 5461:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5462:                   utmp += node->u2[k];
 5463:                   
 5464:                   ttmp += node->tracers[k].tracer[0]; 
 5465:                   stmp += node->tracers[k].tracer[1]; 
 5466:                }
 5467:             }
 5468: 
 5469:             if(icount > 0) {
 5470:                const double inv_icount = 1.0/icount;
 5471:                node->u2[k]     = inv_icount*utmp;
 5472:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5473:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5474:             }
 5475:          }
 5476:       }
 5477:    }
 5478: 
 5479: 
 5480:    __global__ void ul0UpdateSides(int it, int iths) {
 5481: 
 5482:       SIDE(side);
 5483: 
 5484:       // A side is wet if and only if at least one of its elements is wet.
 5485:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5486: 
 5487:       const Node *n1 = side->n1;
 5488:       const Node *n2 = side->n2;
 5489:       const int kb1 = n1->kb;
 5490:       const int kb2 = n2->kb;
 5491: 
 5492:       side->kb = 0; // dry
 5493: 
 5494:       if (isWet) {
 5495: 
 5496:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5497: 
 5498:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5499: 
 5500:          side->kb = min(kb1, kb2);
 5501: 
 5502:          for (int k = side->kb; k < nvrt; k++) {
 5503:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5504: 
 5505:          
 5506:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5507: 
 5508:             // Compute velocity for re-wetted sides 
 5509:             if ((it != iths) && (side->isDry && isWet)) {
 5510:             
 5511:                Vector2 utmp={0.0, 0.0};
 5512: 
 5513:                int icount=0;
 5514: 
 5515:                // For all the sides on the two elements that share this side
 5516:                for (int j=0; j < 2; j++) {
 5517:                   const Element *elem = side->elems[j];
 5518:                   if (elem == nullptr) continue;
 5519: 
 5520:                   for (int jj=0; jj < elem->i34; jj++) {
 5521:                      const Side *nSide = elem->sides[jj];
 5522:                      if (nSide->isDry) continue;
 5523: 
 5524:                      icount++;
 5525:                      utmp += nSide->u2[k];                     
 5526:                   }
 5527:                }
 5528:                   
 5529:                assert(icount > 0 && "No wet sides around this side");
 5530:                if (icount > 0)  side->u2[k] = utmp/icount;
 5531:                   
 5532:             } // if ((it != iths) && (side->isDry && isWet))
 5533: 
 5534:          } // for k
 5535: 
 5536:       } // if isWet
 5537:    
 5538:       side->isDry = !isWet;
 5539: 
 5540:    }
 5541: 
 5542: 
 5543:    __global__ void zeroNodalVelocities(void) {
 5544:       NODE(node);
 5545: 
 5546:       for (int k = 0; k < nvrt; k++) {
 5547:          node->u2[k] = {0.0, 0.0, 0.0};
 5548:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5549:       }
 5550:    }
 5551: 
 5552:    __global__ void computeNodalVerticalVelocities1(void) {
 5553:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5554:    // Adds the element's vertical velocity times the element's area.
 5555:       ELEM(elem);
 5556: 
 5557:       for (int j = 0; j < elem->i34; j++) {
 5558:          Node *node = elem->nodes[j];
 5559: 
 5560:          for (int k = node->kb; k < nvrt; k++) {
 5561:             node->u2[k].z += elem->w[k]*elem->area;
 5562:             node->tmp.d += elem->area;
 5563:          }
 5564:       }
 5565:    }
 5566: 
 5567:    __global__ void computeNodalVerticalVelocities2(void) {
 5568:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5569:    // Divides by the total area of the elements sharing the    node.
 5570:       ELEM(elem);
 5571: 
 5572:       for (int j = 0; j < elem->i34; j++) {
 5573:          Node *node = elem->nodes[j];
 5574: 
 5575:          for (int k = node->kb; k < nvrt; k++) node->u2[k].z /= node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5576:       }
 5577:    }
 5578: 
 5579:    __global__ void computeNodalHorizontalVelocities(void) {
 5580:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5581:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5582:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5583: 
 5584:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5585: 
 5586:       SIDE(side);
 5587: 
 5588:       const int kb = side->kb;
 5589: 
 5590:       Node *n1 = side->n1;
 5591:       Node *n2 = side->n2;
 5592: 
 5593:       for (int k = kb; k < nvrt; k++) {
 5594: 
 5595:          // Cast the u2 vector into a Vector2 
 5596:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5597:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5598: 
 5599:          n1_u2 += side->u2[k]/n1->numSides;
 5600:          n2_u2 += side->u2[k]/n2->numSides;
 5601: 
 5602:       }
 5603: 
 5604: 
 5605:    }
 5606: 
 5607:    __global__ void resetVelocityOpenBndNodes(void) {
 5608:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5609: 
 5610:       NODE_BND(nodebnd);
 5611: 
 5612:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5613:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5614:       }
 5615: 
 5616:    }
 5617: 
 5618: 
 5619:    __global__ void setVelocityOpenBndNodes(void) {
 5620:    // For open boundary nodes sets their velocity to the imposed values.
 5621: 
 5622:       SIDE_BND(sidebnd);
 5623: 
 5624:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5625:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5626:          // to its segment to the average of the side velocity.
 5627: 
 5628:          for (int k = 0; k < nvrt; k++) {
 5629:             Node *n1 = sidebnd->side->n1;
 5630:             Node *n2 = sidebnd->side->n2;
 5631: 
 5632:             // Cast the u2 vector into a Vector2 
 5633:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5634:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5635: 
 5636:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5637:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5638:          }
 5639:       }
 5640: 
 5641:    }
 5642: 
 5643: 
 5644:    __global__ void computeVerticalVelocity(void) {
 5645:       // Computes the vertical velocity at the (2D) element's centroid.
 5646:       // In this function we will be considering volumetric elements, with side faces and a 
 5647:       // bottom and a top face. We will call them SFs, BF and TF.
 5648:       // It computes the flux coming from BF and the SFs.
 5649:       // If the bed is moving, it takes that into account.
 5650:       // Since water is incompressible, the integral of the velocity times the normal vector
 5651:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5652:       // and the BF is equal to the flux going out from the TF.
 5653:       // TF = - BF - sum(SFs).
 5654:       // It then computes the horizontal velocity at the center of TF.
 5655:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5656:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5657:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5658: 
 5659:       ELEM(elem);
 5660: 
 5661:       if (elem->isDry) return;
 5662: 
 5663:       const int kb = elem->kb;
 5664:       const bool isTri = elem->isTri();
 5665: 
 5666:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5667: 
 5668:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5669:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5670:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5671: 
 5672:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5673: 
 5674:       double area3D;
 5675: 
 5676:       // Bottom face flux
 5677:       double bottomFlux = 0.0;
 5678:       Vector2 u2meanBottom = {0.0, 0.0};
 5679:       const Vector2 gradh = elem->grad2(&Node::depth);
 5680:       if constexpr(imm==2) {
 5681:          Vector3 ubed;
 5682: 
 5683:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5684:          // updateBDEF(ubed);
 5685:      
 5686:          // const double bflux0 = dot(ubed, elem_n1);
 5687: 
 5688:          // elem->w[kb] += ubed.z;
 5689:       }
 5690:       else {
 5691:          Vector2 umean;
 5692:          if constexpr(ics == 1) {
 5693:             u2meanBottom = elem->mean(kb, &Side::u2);
 5694:          }
 5695:          else {
 5696:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5697:          }
 5698: 
 5699:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5700:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5701: 
 5702:          bottomFlux = - dot(gradh, u2meanBottom);
 5703:       } // if imm
 5704: 
 5705:       // Compute w for kb+1 to nvrt-1
 5706:       for (int l = kb; l < nvrt - 1; l++) {
 5707: 
 5708:          // normal vector to the top face of the "volumetric" element (3D)
 5709:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5710: 
 5711:          // Compute the total flux at the sides
 5712:          double sideFlux = 0.0;
 5713:          Vector2 u2top = {0.0, 0.0};
 5714:          for (int j = 0; j < elem->i34; j++) {
 5715:             const Side *side = elem->sides[j];
 5716: 
 5717:             const double sideArea = side->area(l + 1);
 5718:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5719:             const double sign = elem->ssign[j]; 
 5720: 
 5721:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5722:          }
 5723:          
 5724:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5725:          //velocities at the centers of the sides
 5726:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5727: 
 5728:          // The flx at the top ace can be computed from the other flows.
 5729:          const double topFlux = - sideFlux - bottomFlux;
 5730:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5731: 
 5732:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5733: printf("sideFlux = %f, topHorizontalFlux = %f, bottomFlux = %f, area3D = %f, elem->w[%d] = %.16f, elem_n2.z = %f\n", sideFlux, topHorizontalFlux, bottomFlux, area3D, l + 1, elem->w[l + 1], elem_n2.z);
 5734:          elem_n1 = elem_n2;
 5735: 
 5736:          bottomFlux = - topFlux;
 5737:       }
 5738:    }  
 5739: 
 5740: 
 5741: 
 5742: 
 5743: 
 5744: 
