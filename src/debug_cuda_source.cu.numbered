 7094:    __global__ void setVelocityOpenBndNodes(void) {
 7095:    // For open boundary nodes sets their velocity to the imposed values.
 7096: 
 7097:       SIDE_BND(sidebnd);
 7098: 
 7099:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7100:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7101:          // to its segment to the average of the side velocity.
 7102: 
 7103:          for (int k = 0; k < nvrt; k++) {
 7104:             Node *n1 = sidebnd->side->n1;
 7105:             Node *n2 = sidebnd->side->n2;
 7106: 
 7107: 
 7108:             Vector2 n1_u2(n1->u2[k]);
 7109:             Vector2 n2_u2(n2->u2[k]);
 7110: 
 7111:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7112:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7113:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7114:             }
 7115:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7116:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7117:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7118:             }
 7119: 
 7120:          }
 7121: 
 7122:       }
 7123: 
 7124:    }
