  526: 
  527: template<int IVCOR>
  528: struct LocalSigma {};   
  529: 
  530: template<>
  531: struct LocalSigma<2> {
  532:    __device__ double operator[](int k) const { return 0.0; }
  533:    __device__ double& operator[](int k) { return (double &)*((double *)nullptr); }
  534: };
  535: 
  536: template<>
  537: struct LocalSigma<1> {
  538:    double localSigma[nvrt];
  539:    __device__ double operator[](int k) const { return localSigma[k]; }
  540:    __device__ double& operator[](int k) { return localSigma[k]; }
  541: };
