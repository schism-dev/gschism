 1719: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1720:    return;
 1721:    // Lock the mutex
 1722:    lock(&debugPlotMutex);
 1723:  
 1724:    bool ok = true;
 1725:    if (debugPlotIdx == nullptr) ok = false;
 1726:    if (*debugPlotIdx >= 10000) ok = false;
 1727:    if (ok) {
 1728:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1729:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1730:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1731:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1732:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1733:       (*debugPlotIdx)++;
 1734:    }
 1735: 
 1736:    __threadfence();               // ensure all above writes are visible
 1737:    // Unlock the mutex
 1738:    unlock(&debugPlotMutex);
 1739: 
 1740: }
