 9672: __global__ void printMatrix(bool full) {
 9673:    // Debugging: print the FEM matrix row for each local node
 9674: 
 9675:    const int size = mesh->np;
 9676:    double sum = 0.0;
 9677: 
 9678:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9679:       const Node *node = mesh->localNodeData + idx_node;
 9680: 
 9681:       if (full)
 9682:          printf("idx_node = %d [%d] diag=%lf, [",
 9683:                 idx_node, node->numNodes, *(node->coeffDiag));
 9684: 
 9685:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9686:       for (int k = 0; k < node->numNodes + 1; k++)
 9687:          sum += node->coeffRow[k];
 9688: 
 9689:       for (int j = 0; j < node->numNodes; j++) {
 9690:          const Node *nbNode = node->nodes[j];
 9691:          const double aij = node->coeffRow[node->csrSlot[j]];
 9692:          if (full && aij != 0.0)
 9693:             printf("%d:%f,  ", nbNode->idx, aij);
 9694:       }
 9695: 
 9696:       if (full) printf("]\n");
 9697:    }
 9698: 
 9699:    if (!full) printf("sum=%lf\n", sum);
 9700: }
