 1325: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1326:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1327: }
 1328: 
 1329: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1330:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1331: }   
 1332: 
 1333: __device__ __inline__ double min3(double a, double b, double c) {
 1334:    return min(a, min(b, c));
 1335: }
 1336: 
 1337: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1338:    return min(a, min(b, min(c, d)));
 1339: }
