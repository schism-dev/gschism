 1486:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1487:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1488:  
 1489:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1490:       
 1491:       sinh_theta_f = sinh(theta_f);
 1492: 
 1493:    }
