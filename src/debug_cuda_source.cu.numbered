 3626: __device__ __inline__ void Node::updateZCoordData(void) {
 3627: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3628: 
 3629:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3630:    // if (isDry2()) {
 3631:    //    kb = -1;  // XXXXXXXX KKKKK
 3632:    //    return;
 3633:    // }
 3634: 
 3635: 
 3636:    if constexpr(ivcor == 2) {  // SZ coordinates
 3637:       
 3638:       // Compute bottom level index
 3639:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3640:    } 
 3641:    else {  // if (ivcor == 1) Localized sigma
 3642:       // Do nothing
 3643:    }
 3644: 
 3645: 
 3646: }
