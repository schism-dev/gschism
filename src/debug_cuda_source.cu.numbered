 2187: /**
 2188:  * This method performs backtracking from the side center until a time -dt back in time 
 2189:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2190:  * intermediate point.
 2191:  *
 2192:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2193:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2194:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2195:  * remaining time.
 2196:  * 
 2197:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2198:  * 
 2199:  * @param uuint, vvint, wwint: Velocities at the final point
 2200:  * @param jlev: Level at which the backtracking is performed
 2201:  * @param dt, dtbk: Tracking timesteps
 2202:  * @return: True if the backtracking was successful, false otherwise
 2203:  */
 2204: __inline__ __device__ bool Side::btrack(
 2205:       int jlev,
 2206:       double dt,            // Tracking time
 2207:       double dtbk,          // Tracking timestep
 2208:       Vector3 &u_int        // Velocities at the initial point
 2209: ) const {
 2210: 
 2211:    // Start from side center
 2212:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2213:  
 2214: 
 2215:    double time_rm = dt; // Remaining time
 2216: 
 2217: 
 2218:    // // Initialize outputs XXX
 2219:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2220:    //    sclr[i] = 0.0;
 2221:    // }
 2222: 
 2223: 
 2224:    // Initial velocities
 2225:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2226: 
 2227:    // Find the element that is in the direction opposite to the velocity
 2228:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2229: 
 2230:    const int MAX_ITERATIONS = 2; // XXXXXXXXXXXX 1000!!!!
 2231:    Element* nextElem = curElem;
 2232:    int iter = 0;
 2233:    while(true) {
 2234: 
 2235:       // Calculate timestep
 2236:       double dtb = min(dtbk, time_rm);
 2237: 
 2238:       // Next point in the backtracking curve
 2239:       Point3 xt = x0 - dtb*u_int;
 2240: 
 2241: printf(" ________#iter11 = %d, jlev = %d, side.idx = %d, u_int = %.17g,%.17g,%.17g, x0 = %.17g,%.17g,%.17g, xt = %.17g,%.17g,%.17g\n", iter, jlev, idx, u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);      
 2242: 
 2243:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2244: printf(" ________#iter22 = %d, jlev = %d, side.idx = %d, u_int = %.17g,%.17g,%.17g, x0 = %.17g,%.17g,%.17g, xt = %.17g,%.17g,%.17g\n", iter, jlev, idx, u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);      
 2245:       assert(found && "Backtracking failed in btrack");
 2246: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2247:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2248:                       // then time_rm needs to be increased by the unused time.
 2249:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2250: 
 2251:       // The current point becomes the next segment's starting point.
 2252:       x0 = xt;
 2253:  
 2254:       curElem = nextElem;
 2255: 
 2256:       iter++;
 2257:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2258:    }
 2259: 
 2260: 
 2261: }
