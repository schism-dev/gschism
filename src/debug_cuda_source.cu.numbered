  969: 
  970:    __device__ void setFrame(void) {
  971:       if constexpr(ics == 1) return;
  972: 
  973:       double lat, lon;
  974:       const Point3 p = toPoint3(center, centerZ());
  975: 
  976:       // Compute the latitude and longitude of the element center
  977:       computeLatLon(p, lat, lon);
  978: 
  979:       frame.update(lat, lon);        
  980:    }
  981: 
  982: 
  983:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  984:    {
  985:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  986:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  987:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  988:       
  989:    }
  990: 
  991:    __device__ Vector3 interpolateVelocities(Point3 xt, const Side *origSide = nullptr) const;
  992: 
  993:    // ------------------------------------------------------------------------------------------------
  994:    // These are functions that work on all nodes/sides of the element.
  995:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  996:    //
  997:    // An example of how to use these functions is:
  998:    //   
  999:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1000:    // 
 1001:    // Where L is the level at which the field is to be interpolated. The field can be either
 1002:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
 1003:    // There are different versions of getNodalValues for each of these cases.
 1004: 
 1005:    template<typename T>
 1006:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
 1007: 
 1008:    template<typename T>
 1009:    __device__ __forceinline__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const;
 1010:   
 1011:    template<typename T>
 1012:    __device__ __forceinline__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const;
 1013: 
 1014:    template<typename T>
 1015:    __device__ __forceinline__ void getSideValues(T Side::* field, T res[4]) const;
 1016: 
 1017:    template<typename T>
 1018:    __device__ __forceinline__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const;
 1019: 
 1020:    template<typename T>
 1021:    __device__ __forceinline__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const;
 1022: 
 1023:    
 1024:    __forceinline__ __device__ void projectNodeVectorsToElementFrame(Vector2 *v) const;
 1025:    __forceinline__ __device__ void projectSideVectorsToElementFrame(Vector2 *v) const;
 1026: 
 1027: 
 1028:    template<typename T>
 1029:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const;
 1030: 
 1031:    template<typename T>
 1032:    __device__ __forceinline__ T interpolate(const double shapeCoords[4], T Node::* field) const;
 1033: 
 1034:    template<typename T>
 1035:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const;
 1036: 
 1037:    template<typename T>
 1038:    __device__ __forceinline__ T mean(T Node::* field) const;
 1039: 
 1040:    template<typename T>
 1041:    __device__ __forceinline__ T mean(T Side::* field) const;
 1042: 
 1043:    template<typename T>
 1044:    __device__ __forceinline__ T mean(int level,  T (Side::*func)(int) const) const;
 1045: 
 1046:    template<typename T>
 1047:    __device__ __forceinline__ T mean(int level, T (Node::* field)[nvrt]) const;
 1048: 
 1049:    template<typename T>
 1050:    __device__ __forceinline__ T mean(int level, T (Side::* field)[nvrt]) const;
 1051: 
 1052: 
 1053: 
 1054:    // __device__ double mean(double (Node::*func)(int) const) const {
 1055:    //    double values[4];
 1056:    //    getNodalValues(level, func, values);
 1057:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 1058:    // }
 1059:    // ------------------------------------------------------------------------------------------------
 1060: 
 1061: 
 1062: 
 1063: 
 1064:    __device__ __forceinline__ Point2 getLocalNodePosition(int idx, const Side* origSide) const;
 1065: 
 1066:    __device__ __forceinline__ Node *getNodeInOrder(int idx) const;
 1067: 
 1068:    __device__ __forceinline__ void computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 1069:                                                     Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const;
 1070:     
 1071: 
