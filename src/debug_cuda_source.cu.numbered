 6618:    __global__ void resetVelocityOpenBndNodes(void) {
 6619:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6620: 
 6621:       NODE_BND(nodebnd);
 6622: 
 6623:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6624:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6625:       }
 6626: 
 6627:    }
 6628: 
 6629: 
 6630:    __global__ void setVelocityOpenBndNodes(void) {
 6631:    // For open boundary nodes sets their velocity to the imposed values.
 6632: 
 6633:       SIDE_BND(sidebnd);
 6634: 
 6635:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6636:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6637:          // to its segment to the average of the side velocity.
 6638: 
 6639:          for (int k = 0; k < nvrt; k++) {
 6640:             Node *n1 = sidebnd->side->n1;
 6641:             Node *n2 = sidebnd->side->n2;
 6642: 
 6643: 
 6644:             Vector2 n1_u2(n1->u2[k]);
 6645:             Vector2 n2_u2(n2->u2[k]);
 6646: 
 6647:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6648:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6649:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6650:             }
 6651:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6652:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6653:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6654:             }
 6655: 
 6656:          }
 6657: 
 6658:       }
 6659: 
 6660:    }
 6661: 
 6662: 
 6663:    __global__ void computeVerticalVelocity(void) {
 6664:       // Computes the vertical velocity at the (2D) element's centroid.
 6665:       // In this function we will be considering volumetric elements, with side faces and a 
 6666:       // bottom and a top face. We will call them SFs, BF and TF.
 6667:       // It computes the flux coming from BF and the SFs.
 6668:       // If the bed is moving, it takes that into account.
 6669:       // Since water is incompressible, the integral of the velocity times the normal vector
 6670:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6671:       // and the BF is equal to the flux going out from the TF.
 6672:       // TF = - BF - sum(SFs).
 6673:       // It then computes the horizontal velocity at the center of TF.
 6674:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6675:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6676:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6677: 
 6678:       ELEM(elem);
 6679: 
 6680:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6681: 
 6682:       if (elem->isDry) return;
 6683: 
 6684:       const int kb = elem->kb;
 6685:       const bool isTri = elem->isTri();
 6686: 
 6687:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6688: 
 6689:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6690:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6691:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6692: 
 6693:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6694: 
 6695:       double area3D;
 6696: 
 6697:       // Bottom face flux
 6698:       double bottomFlux = 0.0;
 6699:       Vector2 u2meanBottom = {0.0, 0.0};
 6700:       const Vector2 gradh = elem->grad2(&Node::depth);
 6701:       if constexpr(imm==2) {
 6702:          Vector3 ubed;
 6703: 
 6704:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6705:          // updateBDEF(ubed);
 6706:      
 6707:          // const double bflux0 = dot(ubed, elem_n1);
 6708: 
 6709:          // elem->w[kb] += ubed.z;
 6710:       }
 6711:       else {
 6712:          u2meanBottom = elem->mean(kb, &Side::u2);  // The mean computation includes the projection to the element frame if ics=2
 6713:   
 6714:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6715:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6716: 
 6717:          bottomFlux = - dot(gradh, u2meanBottom);
 6718:       } // if imm
 6719: 
 6720:       // Compute w for kb+1 to nvrt-1
 6721:       for (int l = kb; l < nvrt - 1; l++) {
 6722: 
 6723:          // normal vector to the top face of the "volumetric" element (3D)
 6724:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6725: 
 6726:          // Compute the total flux at the sides
 6727:          double sideFlux = 0.0;
 6728: 
 6729:          for (int j = 0; j < elem->i34; j++) {
 6730:             const Side *side = elem->sides[j];
 6731: 
 6732:             const double sideArea = side->area(l);
 6733:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6734:             const double sign = elem->ssign[j]; 
 6735: 
 6736:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6737:          }
 6738:          
 6739:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6740:          //velocities at the centers of the sides
 6741:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6742: 
 6743:          // The flx at the top ace can be computed from the other flows.
 6744:          const double topFlux = - sideFlux - bottomFlux;
 6745:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6746: 
 6747:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6748: 
 6749:          elem_n1 = elem_n2;
 6750: 
 6751:          bottomFlux = - topFlux;
 6752:       }
 6753:    }  
 6754: 
 6755: 
 6756: 
 6757: 
 6758: 
 6759: 
 6760: 
 6761: // !===============================================================================
 6762: // !===============================================================================
 6763: 
 6764: } // extern "C"
 6765: 
 6766: #ifdef DONTCOMPILE
 6767: __device__ void computeVerticalAdvection(void) {
 6768:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6769: 
 6770:    sdbt(1:2,:,:)=0.d0
 6771: 
 6772:    const Side *side = FROM kernel;
 6773: 
 6774:    if(side->isDry) return;
 6775: 
 6776:    // If side is wet...
 6777: 
 6778: 
 6779:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6780:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6781:    double ws[nvrt] = {} // w @ side
 6782:    int icount = 0;
 6783:    for (int j=0; j<2; j++) {
 6784:       const Element *elem = side->elements[j];
 6785:        
 6786:       if(elem != nullptr) {
 6787:          icount++;
 6788:          for (int k=0; k<nvrt; k++) {
 6789:             ws[k] = ws[k] + elem->w[k];
 6790:          }
 6791:       }
 6792:    }  // for j
 6793: 
 6794:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6795:    ws = ws/icount;
 6796: 
 6797:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6798:    // Splines allow for a smooth transition between vertical levels.
 6799:    // Splines have continuity restrictions at the internal knots, but
 6800:    // we have to provide the 1st derivatives at the endpoints.
 6801:    const int kbs = side->kbs; 
 6802:    
 6803:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6804:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6805:    initCubicSpline(kbs, nvrt, side, ws, up)
 6806: 
 6807:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6808:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6809:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6810: 
 6811:    // Total advection (average onto side)
 6812:    const Node *node1 = side->nodes[0];
 6813:    const Node *node2 = side->nodes[1];
 6814:    for (int k=kbs(i); k<nvrt; k++) {
 6815: 
 6816:       Vector2 bcc1 = node1->bcc[k];
 6817:       Vector2 bcc2 = node2->bcc[k];
 6818:       if constexpr(ics == 2) {
 6819:          // Project the velocities from the node frames to the side frame
 6820:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 6821:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 6822:       }
 6823: 
 6824:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 6825:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 6826: 
 6827:    }
 6828: }
 6829: #endif
 6830: 
 6831: 
 6832: extern "C" {
 6833:    __global__ void computeElemAverageGhat(void) {
 6834:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6835: 
 6836:       ELEM(elem);
 6837:       
 6838:       elem->ghat1= {0.0, 0.0};  
 6839: 
 6840:       if constexpr(ihydraulics != 0) {
 6841:          if (nhtblocks > 0 && elem->isblock) return;
 6842:       }
 6843: 
 6844:       
 6845:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 6846:       // cff1-3: coefficients for 2D/3D
 6847: 
 6848:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6849:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6850:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 6851: 
 6852:       if (elem->isDry) return;
 6853: 
 6854:       // Average of the coefficients
 6855:       double av_cff1 = 0.0;  // av. for cff1
 6856:       double av_cff2 = 0.0;  // av. for cff2
 6857:       double av_cff3 = 0.0;  // av. for cff3
 6858:       double av_df = 0.0;  // av. for H^\alpha / H
 6859:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6860:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6861: 
 6862:       const int i34 = elem->i34;
 6863:       const int kb  = elem->kb;
 6864: 
 6865:       for (int j=0; j<i34; j++) {
 6866:          // For each node and side in the element...
 6867: 
 6868:          const Node *node = elem->nodes[j];
 6869:          const Side *side = elem->sides[j];
 6870: 
 6871:          const double chi      = side->chi;
 6872:          const double veg_c2   = side->veg_c2;
 6873:          const double veg_beta = side->veg_beta;
 6874:          const double veg_h    = side->veg_h();
 6875:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6876: 
 6877:          // Node - const in elem
 6878:          elem->gradEta += node->eta2*elem->gradPhi[j];  // gradPhi is always in the element frame
 6879:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6880: 
 6881:          if (elem->depth >= tip_dp) {
 6882:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6883:          }
 6884: 
 6885:          
 6886:          const double htot  = side->htot2();        // Total depth at the side
 6887:          const double zctr2 = side->zTopCanopy();  
 6888: 
 6889:          double cff1; 
 6890:          double cff2; 
 6891:          double cff3;   
 6892:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6893:          // coefficients applied to 2D/3D case 
 6894:             cff1 = side->hhat/htot;
 6895:             cff2 = 0.0;
 6896:             cff3 = 0.0;
 6897:          } else { //3D
 6898:             //Init for no-veg case
 6899:             cff1 = 1.0;
 6900:             cff2 = 1.0;
 6901:             cff3 = 0.0;
 6902: 
 6903:             if constexpr(iveg != 0) {
 6904:                // Computes coefficients used with vegetation terms G1, G2
 6905:                // cff1, cff3 are used for the first two terms in G1, G2:
 6906:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6907:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6908:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6909:                if(veg_h < 0.99*htot) { // submergent vegetation
 6910:                   cff1=1;
 6911:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6912:                   cff3 = veg_c;
 6913: 
 6914:                } else { // emergent vegetation
 6915:                   cff1 = 1.0/(1.0 + veg_c2);
 6916:                   cff2 = cff1;
 6917:                   cff3 = 0.0;
 6918: 
 6919:                }
 6920:             } // if iveg
 6921:          } //  2D/3D
 6922: 
 6923:          av_cff1 += cff1/i34;
 6924:          av_cff2 += cff2/i34;
 6925:          av_cff3 += cff3/i34;
 6926:          av_cff2_chi += cff2*chi/i34;
 6927:          av_cff3_chi += cff3*chi/i34;
 6928:          av_df += min(htot, veg_h)/(htot*i34);
 6929: 
 6930: 
 6931:          // btrack values: U^\star, U^{\star\alpha}
 6932:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6933:          Vector2 Ustar       = {0.0, 0.0}; 
 6934:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6935: 
 6936:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6937:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6938:          } else { //3D
 6939:             for (int k = side->kb + 1; k < nvrt; k++) {
 6940:             
 6941:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6942:                Ustar += w2;
 6943: 
 6944:                if constexpr(iveg != 0) {
 6945:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6946:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6947:                        Ustar_alpha += zrat*w2; // XXXX
 6948:                    }
 6949:                }  // if iveg
 6950:             }  // for k
 6951:          }  //2D/3D
 6952: 
 6953:          // If needed, project the side velocities to the element frame
 6954:          if constexpr(ics==2) {
 6955:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 6956:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 6957:          }
 6958:         
 6959: 
 6960:          // Add btrack & surface stress terms to \breve{G} first
 6961:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6962: 
 6963: 
 6964:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 6965:          Vector2 tau    = side->tau();  
 6966:          Vector2 ubstar = side->btu[side->kb + 1];  
 6967: 
 6968:          // If needed, project tau and ubstar to the element frame
 6969:          if constexpr(ics==2) {
 6970:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 6971:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 6972:          }
 6973: 
 6974:          // Term for surface and bottom stress
 6975:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6976: 
 6977: 
 6978:          // All terms in F,F^\alpha,f_b except baroclinic
 6979:          // F, f_b: all explicit terms excluding vegetation 
 6980:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6981:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6982:          const double coriolis = side->coriolis;
 6983:          Vector2 F  =  coriolis*side->U;  // F_x
 6984:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6985:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6986: 
 6987:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6988:             
 6989:             for (int k = side->kb; k < nvrt; k++) {
 6990:                if (zctr2 > side->zc[k-1]) {
 6991:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6992:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6993:                    Fa +=  coriolis*w2*zrat;
 6994:                } // if zctr2
 6995:             } // k
 6996:          } // iveg
 6997: 
 6998:          // Integrate horizontal viscosity force vertically
 6999:          for (int k=side->kb + 1; k<nvrt; k++) {
 7000:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7001: 
 7002:             F += levelHorVisc;
 7003: 
 7004:             // Vegetation term
 7005:             if constexpr(iveg!=0) {
 7006:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7007:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7008:                   Fa += levelHorVisc*zrat;
 7009:                } 
 7010:             } // if iveg
 7011:          } // for k
 7012: 
 7013:          // Get nu*grad(U) at the side's bottom level
 7014:          Vector2 nuGradU = side->nuGradU[side->kb];
 7015: 
 7016:          fb += nuGradU;
 7017: 
 7018:          // If needed, project vectorsF, fb and Fa to the element frame
 7019:          if constexpr(ics==2) {
 7020:             F    = side->frame.projHorVec(F,    elem->frame);
 7021:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7022:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7023:          } // if ics
 7024: 
 7025:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7026:       } // for j (nodes and sides)
 7027: 
 7028:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7029:          
 7030:       // Finish off terms in F, F^\alpha and f_b
 7031:       const double grav3 = elem->mean(&Node::grav2);
 7032:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7033: 
 7034: 
 7035:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7036:       for (int j=1; j<i34; j++) { 
 7037:          // For each side in the element...
 7038:          const Side *side = elem->sides[j];
 7039:          const double chi = side->chi;
 7040: 
 7041:          const double htot = side->htot2();
 7042:          const double veg_h = side->veg_h();
 7043:          const Vector2 F  = htot*fb;
 7044:          const Vector2 Fa = min(htot, veg_h)*fb;
 7045: 
 7046:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7047:       } // for j
 7048: 
 7049:       //botf1 etc are already in elem frame
 7050:       elem->ghat1 += tmp/i34;
 7051: 
 7052:       // Baroclinic force
 7053:       if constexpr(ibc==0) {
 7054:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7055: 
 7056:          Vector2 Fa = {0.0, 0.0};
 7057:          Vector2 intGradRho = {0.0, 0.0};
 7058:          
 7059:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7060:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7061:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7062: 
 7063:             // \in F [m^2/s/s]
 7064:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7065:          }
 7066: 
 7067:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7068:          const Vector2 F = av_df*Fa; //approx
 7069:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7070: 
 7071:       } // if ibc
 7072: 
 7073: 
 7074: 
 7075:    }
 7076: 
 7077: } // extern "C"
 7078: 
 7079: 
 7080: 
 7081: #ifdef DONTCOMPILE
 7082: __global__ void checkMassConservation(Tracers* sumtr) {
 7083: 
 7084:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7085: 
 7086:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7087: 
 7088:    Element *elem = &(mesh->localElemData[i]);
 7089: 
 7090:    // Skip dry elements
 7091:    if (elem->isDry) return;
 7092: 
 7093:    // Local sum array for this thread
 7094:    double localSum[N_TRACERS] = {0.0};
 7095: 
 7096:    // Sum over vertical levels for this element
 7097:    const int kbe = elem->kbe;
 7098:    const double area = elem->area;
 7099: 
 7100:    for (int k = kbe; k < nvrt; k++) {
 7101:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7102:       
 7103:       // Accumulate tracer mass
 7104:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7105:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7106:       }
 7107:    }
 7108: 
 7109:    //  This function returns per element sums. A reduction must be done on the host side.
 7110: }
 7111: 
 7112: 
 7113: __global__ void transport(void) {
 7114: 
 7115:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7116: 
 7117:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7118: 
 7119:    Element *elem = &(mesh->localElemData[ie]);
 7120: 
 7121:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7122: 
 7123:                for (int m=0; m<ntr; m++) {
 7124:                   for (int k=kbe(ie); k<nvrt; k++) {
 7125:                      // Calculate each polynomial's weight 
 7126:                      wm=0.d0; sum1=0.d0; 
 7127:                      wm1=0.d0; wm2=0.d0; 
 7128:                      for (int i=0; i<elem->nweno2; i++) {
 7129:                   
 7130:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7131:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7132:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7133:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7134:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7135:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7136:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7137:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7138:                      // -----------------Hu and Shu (1999)'s method----------------
 7139:                      b4=b1+b2+b3
 7140: 
 7141: //Error: add PRODUCTION CPP
 7142: #ifdef DEBUG
 7143:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7144:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7145:                     call parallel_abort(errmsg)
 7146:                   }
 7147: #endif
 7148: 
 7149:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7150:                   // !----test-------------- 
 7151:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7152:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7153:                   // !wm(i)=wm1(i)*wm2(i)
 7154:                   // !---------------------- 
 7155:                   sum1=sum1+wm(i)
 7156:                 } // end for i
 7157: 
 7158:                 wm=wm/sum1
 7159: 
 7160:                 for (int j=0; j<elem->i34; j++) {
 7161: 
 7162:                   const Side *side  = elem->sides[j];
 7163:                   const Node *node1 = side->n1;
 7164:                   const Node *node2 = side->n2;
 7165: 
 7166:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7167:                      trsd=0.d0
 7168:                      for (int kk=0; kk<nquad; kk++) {
 7169:                         for (int i=0; i<elem->nweno2; i++) {
 7170:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7171:                         } // end for i   
 7172:                      } // end for kk
 7173:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7174:                   } // outward flux
 7175:                } // end for j=1,i34(ie) ! side
 7176:             }
 7177:          }
 7178:               
 7179: 
 7180: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7181: //             //   calculate each polynomial's weight 
 7182: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7183: //                 wm=0.d0; sum1=0.d0
 7184: //                 do i=1,nweno1(ie) !for each polynomial
 7185: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7186: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7187: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7188: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7189: //                   wm(i)=b2
 7190: //                   sum1=sum1+b2
 7191: //                   !wm(i)=1.d0
 7192: //                   !sum1=sum1+1.d0
 7193: 
 7194: // // Error: PRODUCTION
 7195: // #ifdef DEBUG
 7196: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7197: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7198: //                     call parallel_abort(errmsg)
 7199: //                   endif
 7200: // #endif
 7201: 
 7202: //                 enddo !i
 7203: //                 wm=wm/sum1 !final weight
 7204: 
 7205:                 for (int j=0; j<elem->i34; j++) { // side
 7206:                   const Side *side = elem->sides[j];
 7207:                   const Node *node1 = side->n1;
 7208:                   const Node *node2 = side->n2;
 7209: 
 7210:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7211:                     trsd=0.d0
 7212:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7213:                       for (int i=0; i<elem->nweno1; i++) {
 7214:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7215:                       }
 7216:                     enddo //kk
 7217:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7218:                   } // outward flux
 7219:                 } // end for j=1,i34(ie) ! side
 7220:               } // end for k; ntr 
 7221: 
 7222:             else !simple upwind method
 7223:               do j=1,i34(ie)
 7224:                 jsj=elside(j,ie)
 7225:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7226:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7227:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7228:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7229:                   endif
 7230:                 enddo  !vertical layers
 7231:               enddo !j=1,i34(ie) ! side
 7232:             endif !order of accuracy
 7233: 
 7234:          //  enddo !ie
 7235: // !$OMP     end do
 7236: 
 7237: // !$OMP     master
 7238: //           !message passing
 7239: //           if (nproc>1) then
 7240: //             !make a copy of side concentrations
 7241: //             trsd_tmp0=trsd_tmp 
 7242: 
 7243: //             !this exchange routine swaps interface concentration between two partitions
 7244: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7245: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7246: 
 7247: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7248: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7249: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7250: 
 7251: 
 7252: //             !This obtains final values for interface sides
 7253: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7254: //       :    endif !nproc>1
 7255: //           !message passing end
 7256: // !$OMP     end master
 7257: // !$OMP     barrier
 7258: 
 7259: 
 7260: // !         Do advection; conc @ dry elem will not be changed
 7261: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7262: // !$OMP     do reduction(+: h_mass_in)
 7263: //           do i=1,ne
 7264: //             if(idry_e(i)==1) cycle
 7265: 
 7266: 
 7267: // !           Wet elements with 3 wet nodes
 7268: //             do k=kbe(i)+1,nvrt
 7269: 
 7270: 
 7271: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
