 2082: 
 2083: 
 2084: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2085:    if constexpr(ics == 1)  {
 2086:       return center;
 2087: 
 2088:    } else {
 2089:       const Point2 p0 = nodes[0]->outputCoords();
 2090:       const Point2 p1 = nodes[1]->outputCoords();
 2091:       const Point2 p2 = nodes[2]->outputCoords();
 2092: 
 2093:       if (isTri()) {
 2094:          return (1.0/3.0)*(p0 + p1 + p2);
 2095: 
 2096:       } else {
 2097:          const Point2 p3 = nodes[3]->outputCoords();
 2098:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2099:       }
 2100: 
 2101:    }
 2102: }
 2103: 
 2104: 
 2105: __device__ __forceinline__ double Element::centerZ(void) const { 
 2106: // Z coordinate of the element center in the global cartesian coordinates.
 2107: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2108: 
 2109:    if constexpr(ics==1) { 
 2110:       return 0.0; 
 2111: 
 2112:    } else { 
 2113: 
 2114:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2115:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2116:    } 
 2117: }
