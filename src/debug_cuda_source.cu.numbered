 4789: extern "C" {
 4790:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4791:                                   int* indices, int* indptr) {
 4792: 
 4793:       NODE(node);
 4794:       
 4795:       const int idx = node->idx;
 4796:       
 4797:       // Computes the index in the nzz array      
 4798:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4799: 
 4800: 
 4801:       indptr[idx] = nzzIdx;
 4802:       indices[nzzIdx] = idx;
 4803: 
 4804:       data_d[nzzIdx]    = node->coeffDiag;
 4805: 
 4806:       b_d[idx] = node->qel;
 4807: 
 4808:       for (int k = 0; k < node->numNodes; ++k) {
 4809:          const Node* nb = node->nodes[k];
 4810: 
 4811:          const int j = nb->idx;
 4812: 
 4813:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4814: 
 4815:          indices[nzzIdx + k + 1] = j;
 4816:       }
 4817: 
 4818:  
 4819:    }
 4820: 
 4821: 
 4822: 
 4823:    __global__ void solverCopyResult(double* x) {
 4824:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4825:       NODE(node);
 4826:       const int idx = node->idx;
 4827: 
 4828:       node->mX = x[idx];
 4829:    }
