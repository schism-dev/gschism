 8120: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8121:    // Get the value of a variable from an element
 8122:    // varName is the name of the variable to get
 8123:    // var is the array to store the value
 8124:    // k is the vertical level index of the variable to get
 8125: 
 8126:    ELEM(elem);
 8127:    
 8128:    int idx = elem->idx;
 8129:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8130: 
 8131:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8132:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8133:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8134:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8135:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8136:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8137:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8138:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8139:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8140:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8141:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8142:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8143:       
 8144:    
 8145: }
 8146: 
 8147: 
 8148: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8149:    // Get the value of a variable from an node
 8150:    // varName is the name of the variable to get
 8151:    // var is the array to store the value
 8152:    // k is the vertical level index of the variable to get
 8153: 
 8154:    NODE(node);
 8155:    
 8156:    int idx = node->idx;
 8157:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8158: 
 8159:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8160:    
 8161:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8162:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8163:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8164:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8165:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8166:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8167:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8168:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8169:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8170:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8171:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8172:    
 8173:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8174:       
 8175:    
 8176: }
 8177: 
 8178: 
 8179: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8180:    // Get the value of a variable from an side
 8181:    // varName is the name of the variable to get
 8182:    // var is the array to store the value
 8183:    // k is the vertical level index of the variable to get
 8184:    SIDE(side);
 8185:    
 8186:    int idx = side->idx;
 8187:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8188: 
 8189:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8190:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8191:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8192:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8193:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8194:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8195:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8196:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8197:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8198:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8199:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8200:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8201:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8202:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8203:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8204:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8205:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8206:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8207:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8208:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8209:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8210:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8211:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8212:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8213:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8214:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8215:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8216:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8217:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8218:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8219:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8220:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8221:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8222:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8223:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8224:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8225: }
 8226: 
 8227: 
 8228: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8229:    // Get the value of a variable from an side
 8230:    // varName is the name of the variable to get
 8231:    // var is the array to store the value
 8232:    // k is the vertical level index of the variable to get
 8233:    SIDE_BND(sideBnd);   
 8234: 
 8235:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8236:    if (sideBnd->segment->isLand) idx = -7;
 8237: 
 8238:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8239:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8240: 
 8241: }
