 2118: 
 2119: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2120:    if constexpr(ics == 1)  {
 2121:       return center;
 2122: 
 2123:    } else {
 2124:       const Point2 p0 = nodes[0]->outputCoords();
 2125:       const Point2 p1 = nodes[1]->outputCoords();
 2126:       const Point2 p2 = nodes[2]->outputCoords();
 2127: 
 2128:       if (isTri()) {
 2129:          return (1.0/3.0)*(p0 + p1 + p2);
 2130: 
 2131:       } else {
 2132:          const Point2 p3 = nodes[3]->outputCoords();
 2133:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2134:       }
 2135: 
 2136:    }
 2137: }
 2138: 
 2139: 
 2140: __device__ __forceinline__ double Element::centerZ(void) const { 
 2141: // Z coordinate of the element center in the global cartesian coordinates.
 2142: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2143: 
 2144:    if constexpr(ics==1) { 
 2145:       return 0.0; 
 2146: 
 2147:    } else { 
 2148: 
 2149:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2150:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2151:    } 
 2152: }
