  223: // Simple math functions ---------------------------------------------------------------------------
  224: 
  225: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  226: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  227: // Outputs:
  228: //        x1: first solution
  229: //        x2: second solution
  230: 
  231:        // Use float-specific absolute value for speed on GPU
  232:     const double absA = fabs(A);
  233:     const double absB = fabs(B);
  234: 
  235:     // 1. Near-linear case: a is effectively 0.
  236:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  237:     // This branch is almost never taken, so it won't hurt performance.
  238:     if (absA < 1e-14 * (absB + 1e-30)) {
  239:         const double x = -C / B;
  240:         x1 = x;
  241:         x2 = x;
  242:         return;  // Degenerate case: A = 0.
  243:     }
  244: 
  245:    const double delta = max(0.0, B*B - 4.0*A*C);
  246: 
  247:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  248:    const double s = sqrt(delta);
  249: 
  250:    // Numerically stable quadratic roots:
  251:    // q = -0.5*(B + sign(B)*sqrt(delta))
  252:    const double q = -0.5 * (B + copysign(s, B));
  253: 
  254:    x1 = q/A;
  255:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  256: 
  257: }
