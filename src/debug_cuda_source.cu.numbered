 8702:          break;
 8703:       case (int)VarCode::isdry:
 8704:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8705:          *sizeType = sizeof(int);
 8706:          break;            
 8707:       // case (int)VarCode::w:
 8708:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8709:       //    *sizeType = sizeof(double);
 8710:       //    break;
 8711:       case (int)VarCode::u:
