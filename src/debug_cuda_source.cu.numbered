 9180: 
 9181: __global__ void returnMatrix(double *res) {
 9182:    // Debugging: dense local matrix, row-major, size = mesh->np
 9183:    // Assumes single-partition / local indexing (see note below).
 9184: 
 9185:    const int size = mesh->np;
 9186: 
 9187:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9188:       const Node *node = mesh->localNodeData + idx_node;
 9189: 
 9190:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9191: 
 9192:       for (int j = 0; j < node->numNodes; j++) {
 9193:          const Node *nbNode = node->nodes[j];
 9194:          // Only dump neighbors that live on this partition
 9195:          if (nbNode->part != mesh->partNum) continue;
 9196: 
 9197:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9198:          const double aij = node->coeffRow[node->csrSlot[j]];
 9199:          if (aij != 0.0)
 9200:             res[jlocal * size + idx_node] = aij;
 9201:       }
 9202:    }
 9203: }
