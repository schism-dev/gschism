 2213: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 2214:                    Side *side = &(mesh->localSideData[idx_side]); \
 2215:                    if (idx_side >= mesh->ns) return;
 2216: 
 2217: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 2218:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 2219:                    if (idx_elem >= mesh->ne) return;
 2220: 
 2221: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 2222:                    Node *node = &(mesh->localNodeData[idx_node]); \
 2223:                    if (idx_node >= mesh->np) return;
 2224: 
 2225: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 2226:                               Node *node = &(mesh->localNodeData[idx_node]); \
 2227:                               const bool valid = (idx_node < mesh->np);                   
 2228: 
