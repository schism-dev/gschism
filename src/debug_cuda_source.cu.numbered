 1528:    __device__ void setFrame(void) {
 1529:       if constexpr(ics == 1) return;
 1530: 
 1531:       double lat, lon;
 1532:       const Point3 p = toPoint3(center, centerZ());
 1533: 
 1534:       // Compute the latitude and longitude of the element center
 1535:       computeLatLon(p, lat, lon);
