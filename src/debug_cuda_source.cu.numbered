 8231: __global__ void returnMatrix(double *res) {
 8232:    // Debugging: returns the matrix as a CuPy array
 8233: 
 8234:    const int size = mesh->np;
 8235:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8236:       const Node *node = mesh->localNodeData + idx_node;
 8237:       res[idx_node*size + idx_node] = node->coeffDiag;
 8238:       for (int j = 0; j < node->numNodes; j++) {
 8239:          Node* nbNode = node->nodes[j];
 8240:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8241:       }
 8242: 
 8243:    }
 8244:    
 8245: }
