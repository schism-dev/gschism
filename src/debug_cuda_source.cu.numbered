  354: 
  355: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  356:     a.x += b.x;
  357:     a.y += b.y;
  358:     return a;
  359: }
  360: 
  361: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
