 4624:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4625: 
 4626:       NODE_BND(nodeBnd);
 4627: 
 4628:       Node *node = nodeBnd->node;
 4629: 
 4630:       node->ETP = 0.0;
 4631: 
 4632:       for (int j=0; j<ntip; j++) {
 4633: 
 4634:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4635:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4636:    
 4637:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4638: 
 4639:          if constexpr(iloadtide==1) { // loading tide
 4640:             assert(false && "Loading tide not implemented");
 4641:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4642:          }
 4643:          
 4644:       }
 4645:       
 4646:    }
