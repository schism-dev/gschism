 4356: 
 4357: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4358:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4359:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4360: 
 4361: 
 4362:    NODE(node1);
 4363: 
 4364:    node1->clearMatrixRow();
 4365:    node1->qel = 0.0;
 4366: 
 4367:    // THIS IS FOR STRUCTURES XXX
 4368:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4369: 
 4370:    
 4371:    for (int j=0; j<node1->numElements; j++) {
 4372:       // For each element connected to the node...
 4373: 
 4374:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4375: 
 4376:       Element *elem = node1->elements[j];
 4377: 
 4378:       // Compute the average gravity
 4379:       const double grav3 = elem->mean(&Node::grav2);
 4380: 
 4381:       // Look at the documentation for the description of the terms in the following integrals
 4382: 
 4383:       // Integral I_1 
 4384:       // \bar{\breve{H}} 
 4385:       const double hhatb = elem->mean(&Side::hhat);        
 4386: 
 4387:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4388: 
 4389:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4390:       const double area = elem->area;
 4391: 
 4392:       // Integral I_4
 4393:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4394:       // Where
 4395:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4396: 
 4397:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4398:       // of U over the element.
 4399:       const Vector2 U = elem->mean(&Side::U);
 4400: 
 4401:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4402: 
 4403:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4404:       const double I_4_1 = dot(gradPhi_1, U);
 4405: 
 4406: 
 4407:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4408:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4409: 
 4410:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4411: 
 4412: 
 4413:       // Normal component of the bed velocity
 4414:       double ubedNormalComp = 0.0;
 4415:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4416:          Vector3 ubed = {0.0, 0.0, 0.0};
 4417:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4418:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4419: 
 4420:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4421:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4422:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4423: 
 4424:          // Computes the normal component of the bed velocity
 4425:          ubedNormalComp = dot(ubed, N);
 4426:       } // imm==2
 4427: 
 4428:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4429: 
 4430:       if (elem->isTri()) {
 4431: 
 4432:          // To clarify the notation in this section: 
 4433:          //   In formulas, we use the following notation:
 4434:          //       i stands for the node under consideration (node1)
 4435:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4436:          //   However, in the code, we use the following notation:
 4437:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4438:          const int id2 = elem->nxq(1 + id1);
 4439:          const int id3 = elem->nxq(2 + id1);
 4440:          Node *node2 = elem->nodes[id2];
 4441:          Node *node3 = elem->nodes[id3];
 4442: 
 4443:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4444: 
 4445:          // integral of phi_i*phi_j
 4446:          const double ipp_ii = (1.0/6.0 )*area;
 4447:          const double ipp_ij = (1.0/12.0)*area;
 4448:          const double ipp_ik = (1.0/12.0)*area;
 4449: 
 4450:          // integral of [(grad phi_i) * (grad phi_j)]
 4451:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4452:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4453:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4454: 
 4455:          // Computes the different components of integral I_1 of each node with respect to node i.
 4456:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4457:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4458:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4459: 
 4460:          node1->addToSparseMatrix(node1, I1_ii);
 4461:          node1->addToSparseMatrix(node2, I1_ij); 
 4462:          node1->addToSparseMatrix(node3, I1_ik);
 4463: 
 4464:          #pragma unroll
 4465:          for (int l=0; l<3; l++) {
 4466: 
 4467:             Node *node = elem->nodes[l];
 4468: 
 4469:             // Additional variation in eta due to bed deformation or vertical velocity
 4470:             double extraEta = 0.0;
 4471:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4472:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4473: 
 4474: 
 4475:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4476:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4477: 
 4478:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4479: 
 4480:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4481:            
 4482:          }
 4483: 
 4484: 
 4485:       }
 4486:       else { // Quad
 4487:          // To clarify the notation in this section: 
 4488:          //   In formulas, we use the following notation:
 4489:          //       i stands for the node under consideration (node1)
 4490:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4491:          //   However, in the code, we use the following notation:
 4492:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4493:          const int id2 = elem->nxq(1 + id1);
 4494:          const int id3 = elem->nxq(2 + id1);
 4495:          const int id4 = elem->nxq(3 + id1);
 4496:          Node *node2 = elem->nodes[id2];
 4497:          Node *node3 = elem->nodes[id3];
 4498:          Node *node4 = elem->nodes[id4];   
 4499:          
 4500:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4501: 
 4502:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4503:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4504:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4505:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4506:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4507: 
 4508:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4509:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4510:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4511:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4512:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4513: 
 4514: 
 4515:          // Computes the different components of integral I_1 of each node with respect to node i.
 4516:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4517:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4518:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4519:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4520: 
 4521:          node1->addToSparseMatrix(node1, I1_ii);
 4522:          node1->addToSparseMatrix(node2, I1_ij); 
 4523:          node1->addToSparseMatrix(node3, I1_ik);
 4524:          node1->addToSparseMatrix(node4, I1_il);
 4525:   
 4526:          #pragma unroll
 4527:          for (int l=0; l<4; l++) {
 4528: 
 4529:             const Node *node = elem->nodes[l];
 4530: 
 4531:             // Additional variation in eta due to bed deformation or vertical velocity
 4532:             double extraEta = 0.0;
 4533:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4534:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4535: 
 4536:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4537:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4538:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4539: 
 4540:          }         
 4541:       } 
 4542: 
 4543: 
 4544:      node1->qel += (dt/elem->i34)*elem->vsource;
 4545:       
 4546: 
 4547:    } // for all elements connected to the node
 4548:    
 4549: 
 4550:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4551:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4552:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4553:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4554:    // If it is an open boundary node...
 4555: 
 4556:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4557: 
 4558:       // At least one open bnd side, maybe two
 4559:       for (int l=0; l<2; l++) { 
 4560: 
 4561:          // Gets each of the sides sharing the node. 
 4562:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4563: 
 4564:     
 4565: 
 4566:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4567:          if (sideBnd != nullptr) {
 4568:             // If the side is on a boundary...
 4569: 
 4570:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4571: 
 4572:             // Get the boundary segment
 4573:             const BoundarySegment *sideSegment = sideBnd->segment;
 4574:             const Side *side = sideBnd->side;
 4575: 
 4576:             // Integral I_3
 4577:             if (sideSegment->ifltype != 0) {
 4578:             // Natural or Flather b.c.
 4579: 
 4580:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4581:                // especially for Flather b.c.
 4582:                double ri3 = 0.0;
 4583:                if (!side->isDry) {
 4584:                   // If the side is not dry
 4585:                   
 4586:                   // Computes the side flux of (uth, vth)
 4587:                   double Vn = 0.0;
 4588:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4589:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4590:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4591: 
 4592:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4593:                   }
 4594: 
 4595:                   ri3 = 0.5*side->len*Vn;
 4596:                }
 4597: 
 4598:                if (sideSegment->ifltype == -1) { // Flather 1
 4599: 
 4600:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4601:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4602: 
 4603:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4604:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4605:                   
 4606:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4607:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4608: 
 4609:                } 
 4610:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4611:                   // Reset ri3
 4612:                   ri3 = 0.0;
 4613: 
 4614:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4615:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4616: 
 4617:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4618: 
 4619:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4620:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4621: 
 4622:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4623:                   node1->addToSparseMatrix(node1, con0*2.0);
 4624:                   node1->addToSparseMatrix(node2, con0);
 4625: 
 4626:                } // if Flather or Discharge
 4627: 
 4628:                node1->qel -= thetai*dt*ri3;  
 4629: 
 4630: 
 4631:             } // I_3
 4632:           
 4633: 
 4634:             // Integral I_5
 4635:             if(!side->isDry) {
 4636: 
 4637:                const double Unbar = dot(side->U, side->n);
 4638:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4639: 
 4640:             } // I_5
 4641: 
 4642:          } // if is boundary side
 4643: 
 4644:       } // for l
 4645: 
 4646:    } // if isbnd
 4647: 
 4648: 
 4649: }
 4650: 
 4651: 
 4652: 
 4653: extern "C" {
 4654:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4655:                                   int* indices, int* indptr) {
 4656: 
 4657:       NODE(node);
 4658:       
 4659:       const int idx = node->idx;
 4660:       
 4661:       // Computes the index in the nzz array      
 4662:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4663: 
 4664: 
 4665:       indptr[idx] = nzzIdx;
 4666:       indices[nzzIdx] = idx;
 4667: 
 4668:       data_d[nzzIdx]    = node->coeffDiag;
 4669: 
 4670:       b_d[idx] = node->qel;
 4671: 
 4672:       for (int k = 0; k < node->numNodes; ++k) {
 4673:          const Node* nb = node->nodes[k];
 4674: 
 4675:          const int j = nb->idx;
 4676: 
 4677:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4678: 
 4679:          indices[nzzIdx + k + 1] = j;
 4680:       }
 4681: 
 4682:  
 4683:    }
 4684: 
 4685: 
 4686: 
 4687:    __global__ void solverCopyResult(double* x) {
 4688:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4689:       NODE(node);
 4690:       const int idx = node->idx;
 4691: 
 4692:       node->mX = x[idx];
 4693:    }
 4694: 
 4695: 
 4696:    __global__ void rollUpElevation(void) {
 4697: 
 4698:       NODE(node);
 4699: 
 4700:       node->eta1 = node->eta2;
 4701: 
 4702:    }
 4703: 
 4704: 
 4705:    __global__ void backtrackAllNodes(void) {
 4706: 
 4707:       // max/min # of sub-divisions
 4708:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4709:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4710: 
 4711:       SIDE(side);
 4712: 
 4713:       const int kb = side->kb;
 4714: 
 4715: 
 4716:       // Initialize btrack velocities to the actual velocities at the side 
 4717:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4718:   
 4719:       if (side->isDry) return;
 4720:      
 4721: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4722: 
 4723:       // Checks that at least one element is not dry
 4724:       const Element *elem1 = side->elems[0];
 4725:       const Element *elem2 = side->elems[1];
 4726: 
 4727: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4728: 
 4729:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4730:       
 4731:       // XXXXXX
 4732:       // !swild_tmp to store global coord. of the starting side
 4733:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4734:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4735:       // !Use sframe2 
 4736:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4737: 
 4738: 
 4739:       for (int k = kb; k < nvrt; k++) {
 4740:       //  For ics=2, the coordinates are all in the side's local frame
 4741: 
 4742:          const int iadvf = side->iadv();  // Advection flag   
 4743:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4744: 
 4745:          const double vmag2 = norm2(side->u2[k]);
 4746: 
 4747:          if (vmag2 <= velmin_btrack_sq) {  
 4748:             // No activity 
 4749: 
 4750:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4751:             
 4752:          } else {  // do btrack
 4753: 
 4754:             // Compute number of sub-divisions based on local gradients of the velocity field
 4755: 
 4756:             // XXX IS THIS NECESSARY?
 4757:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4758:             double suma = 0.0;
 4759:             int icount = 0;
 4760:             #pragma unroll
 4761:             for (int l=0; l<2; l++) {
 4762:             // For each element sharing the side...
 4763: 
 4764:                const Element *elem = side->elems[l];
 4765:                  
 4766:                if (elem == nullptr) continue;
 4767: 
 4768:                icount++;
 4769: 
 4770:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4771:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4772:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4773: 
 4774:                double utmp[4];
 4775:                double vtmp[4];
 4776:                #pragma unroll
 4777:                for (int j = 0; j < elem->i34; j++) {
 4778: 
 4779:                   const Node *node = elem->nodes[j];
 4780: 
 4781:                   if constexpr(ics==1) {
 4782:                      utmp[j] = node->u2[k].x;
 4783:                      vtmp[j] = node->u2[k].y;  
 4784: 
 4785:                   } else {
 4786:                      // 'Project' the velocity from the node frame to the element frame
 4787:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4788:                      utmp[j] = tmp_u2.x;
 4789:                      vtmp[j] = tmp_u2.y;
 4790: 
 4791:                   }
 4792:                } // for j
 4793: 
 4794:                const Vector2 grad_u = elem->grad2(utmp); 
 4795:                const Vector2 grad_v = elem->grad2(vtmp);
 4796:    
 4797:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4798:             } // for l
 4799: 
 4800:             assert(icount > 0 && "Impossible 77");
 4801: 
 4802:             // '4' is somewhat arbitrary
 4803:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4804: 
 4805:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4806:             Vector3 u_int = {0.0, 0.0, 0.0};
 4807: 
 4808:             side->btrack(k, dt, dtbk, u_int);
 4809: 
 4810: 
 4811:             side->btu[k] = {u_int.x, u_int.y};
 4812:                
 4813:          } // if vmag (do backtrack)
 4814: 
 4815: 
 4816:       } // for k=kb,nvrt-1
 4817: 
 4818:    }
 4819: 
 4820: } // extern "C"
 4821: 
 4822: template<int nc>
 4823: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4824: 
 4825: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4826: //
 4827: // a,b,c,rhs: input vectors and are not modified by this program.
 4828: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4829: // rhs is the r.h.s.
 4830: // n: actual rank of the system.
 4831: // rows in u() and rhs();
 4832: // u: output with nc columns (transposed to rows)
 4833: // gam: a working array.
 4834: //
 4835: // NOTES:
 4836: // This is a template function that allows for different numbers of columns in the rhs vector.
 4837: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4838: 
 4839:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4840:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4841: 
 4842:    double bet = b[0];
 4843:    if constexpr (nc == 1) {
 4844:       u[0] = rhs[0]/bet;
 4845:    } else {
 4846:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4847:    }
 4848: 
 4849:    for (int j = 1; j < n; j++) {
 4850:       gam[j] = c[j - 1]/bet;
 4851:       bet = b[j] - a[j]*gam[j];
 4852: 
 4853:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4854: 
 4855:       if constexpr (nc == 1) {
 4856:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4857:       } else {
 4858:          for (int l = 0; l < nc; l++) {
 4859:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4860:          }
 4861:       }
 4862:    }
 4863: 
 4864:    // Back-substitution
 4865:    for (int j = n - 2; j >= 0; j--) {
 4866:       if constexpr (nc == 1) {
 4867:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4868:       } else {
 4869:          for (int l = 0; l < nc; l++) {
 4870:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4871:          }
 4872:       }
 4873:    }
 4874: }
 4875: 
 4876: 
 4877: 
 4878: // Helper function that contains the core algorithm
 4879: template<typename XAccessor, typename YAccessor>
 4880: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4881:                                     double  yp_top, double  yp_bot, 
 4882:                                     CubicSpline &spline) {
 4883:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4884:    // 
 4885:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4886:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4887:    //
 4888:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4889:    // 
 4890:    // Inputs: 
 4891:    //            n: dimension for x etc; # of data pts (>=2);
 4892:    //            getX, getY: functions to access x,y coordinates
 4893:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4894:    //     Output: 
 4895:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4896: 
 4897:    const int n = k2 - k1 + 1;
 4898:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4899: 
 4900:    // Allocate memory for the splines
 4901:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4902:    spline.x   = new double[n];
 4903:    spline.y   = new double[n];
 4904:    spline.yp  = new double[n];
 4905:    spline.ypp = new double[n];
 4906: 
 4907:    for (int k=k1; k<=k2; k++) {
 4908:       spline.x[k] = getX(k);
 4909:       spline.y[k] = getY(k);
 4910:    }
 4911: 
 4912:    // This is to simplify expressions later
 4913:    double *x = spline.x;
 4914:    double *y = spline.y;
 4915: 
 4916:    double *a = nullptr;
 4917:    double *b = nullptr;
 4918:    double *c = nullptr;
 4919:    double *gam = nullptr;
 4920:    double *rhs = nullptr;
 4921:    
 4922: 
 4923:       a = new double[n];   // Lower diagonal
 4924:       b = new double[n];   // Diagonal
 4925:       c = new double[n];   // Upper diagonal
 4926:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4927:       rhs = new double[n]; // Right-hand side
 4928: 
 4929:    for (int k=k1; k<=k2; k++) {
 4930:       if (k == k1) {
 4931:          // Bottom level
 4932:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4933:          b[k] = (x[k+1] - x[k])/3.0;
 4934:          c[k] = b[k]/2.0;
 4935:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4936:       } else if (k == n - 1) {
 4937:          // Top level (surface)
 4938:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4939:          b[k] = (x[k] - x[k-1])/3.0;
 4940:          a[k] = b[k]/2.0;
 4941:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4942:       } else {
 4943:          // Intermediate levels
 4944:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4945:          b[k] = (x[k+1] - x[k-1])/3.0;
 4946:          a[k] = (x[k  ] - x[k-1])/6.0;
 4947:          c[k] = (x[k+1] - x[k  ])/6.0;
 4948:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4949:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4950:       }
 4951:    }
 4952: 
 4953:    // Solve the tridiagonal system
 4954:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4955:    
 4956:    spline.yp[k1] = yp_bot;
 4957:    spline.yp[k2] = yp_top;
 4958: 
 4959:    // Compute rest of 1st derivatives using the splines
 4960:    for (int k=k1+1; k<k2; k++) {
 4961:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4962:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4963:    }
 4964:    
 4965:    delete[] a;
 4966:    delete[] b;
 4967:    delete[] c;
 4968:    delete[] gam;
 4969:    delete[] rhs;
 4970: 
 4971: }
 4972: 
 4973: // Array version
 4974: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4975:                                 double y_top, double y_bot, 
 4976:                                 CubicSpline &spline) {
 4977:    auto getX = [x] (int k) { return x[k]; };
 4978:    auto getY = [y] (int k) { return y[k]; };
 4979:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4980: }
 4981: 
 4982: // Lambda version - allows custom access patterns
 4983: template<typename XFunc, typename YFunc>
 4984: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4985:                                 double y_top, double y_bot,
 4986:                                 CubicSpline &spline) {
 4987:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4988: }
