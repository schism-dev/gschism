 4330: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4331:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4332:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4333:                 int *isdel, int *isidenode, int *isbnd,
 4334:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4335:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4336:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4337:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4338:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4339:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4340:                 double *drag, double *roughness,
 4341:                 double *emo, double *efa, 
 4342:                 double *umo, double *ufa, 
 4343:                 double *vmo, double *vfa) {
 4344: 
 4345:    printf("Populating mesh for partition %d\n", partNum);
 4346: 
 4347:    // XXXXXX THIS function does almost nothing. 
 4348: 
 4349:    nbs = *sharedIdxSideBoundary + 1;
 4350:    nbp = *sharedIdxNodeBoundary + 1;
 4351: 
 4352:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4353: 
 4354: }
