 1449:    // Tidal velocity boundary conditions. They are computed from the nodal tidal velocity amplitudes and phases in populateBoundarySides().
 1450:    // nbfr ? nbfr : 1 is there to avoid a 0-sized array.
 1451:    Vector2 umo[nbfr ? nbfr : 1];  // tidal velocity amplitude 
