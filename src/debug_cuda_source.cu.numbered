 6445: #ifdef DONTCOMPILE
 6446: __device__ void computeVerticalAdvection(void) {
 6447:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6448: 
 6449:    sdbt(1:2,:,:)=0.d0
 6450: 
 6451:    const Side *side = FROM kernel;
 6452: 
 6453:    if(side->isDry) return;
 6454: 
 6455:    // If side is wet...
 6456: 
 6457: 
 6458:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6459:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6460:    double ws[nvrt] = {} // w @ side
 6461:    int icount = 0;
 6462:    for (int j=0; j<2; j++) {
 6463:       const Element *elem = side->elements[j];
 6464:        
 6465:       if(elem != nullptr) {
 6466:          icount++;
 6467:          for (int k=0; k<nvrt; k++) {
 6468:             ws[k] = ws[k] + elem->w[k];
 6469:          }
 6470:       }
 6471:    }  // for j
 6472: 
 6473:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6474:    ws = ws/icount;
 6475: 
 6476:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6477:    // Splines allow for a smooth transition between vertical levels.
 6478:    // Splines have continuity restrictions at the internal knots, but
 6479:    // we have to provide the 1st derivatives at the endpoints.
 6480:    const int kbs = side->kbs; 
 6481:    
 6482:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6483:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6484:    initCubicSpline(kbs, nvrt, side, ws, up)
 6485: 
 6486:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6487:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6488:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6489: 
 6490:    // Total advection (average onto side)
 6491:    const Node *node1 = side->nodes[0];
 6492:    const Node *node2 = side->nodes[1];
 6493:    for (int k=kbs(i); k<nvrt; k++) {
 6494: 
 6495:       if constexpr(ics==1) {
 6496:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6497:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6498:       } else {
 6499:          // XXX IMPLEMENT THIS
 6500:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6501:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6502:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6503:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6504:       }  // if ics
 6505: 
 6506: 
 6507:    }
 6508: }
 6509: #endif
 6510: 
 6511: 
 6512: extern "C" {
 6513:    __global__ void computeElemAverageGhat(void) {
 6514:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6515: 
 6516:       ELEM(elem);
 6517:       
 6518:       elem->ghat1= {0.0, 0.0};  
 6519: 
 6520:       if constexpr(ihydraulics != 0) {
 6521:          if (nhtblocks > 0 && elem->isblock) return;
 6522:       }
 6523: 
 6524:       if (elem->isDry) return;
 6525: 
 6526:       // Wet elements.
 6527:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6528:       // tidal potential, horizontal diffusion, and baroclinic etc
 6529:       // Remember to update both fb and F 
 6530:       // If ics=2, ghat1 are in eframe (ll)
 6531:       // cff1-3: coefficients for 2D/3D
 6532:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6533:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6534:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6535: 
 6536:       double av_cff1 = 0.0;  // av. for cff1
 6537:       double av_cff2 = 0.0;  // av. for cff2
 6538:       double av_cff3 = 0.0;  // av. for cff3
 6539:       double av_df = 0.0;  // av. for H^\alpha / H
 6540:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6541:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6542: 
 6543:       const int i34 = elem->i34;
 6544:       const int kb = elem->kb;
 6545: 
 6546:       for (int j=0; j<i34; j++) {
 6547:          // For each node and side in the element...
 6548: 
 6549:          const Node *node = elem->nodes[j];
 6550:          const Side *side = elem->sides[j];
 6551: 
 6552:          const double chi      = side->chi;
 6553:          const double veg_c2   = side->veg_c2;
 6554:          const double veg_beta = side->veg_beta;
 6555:          const double veg_h    = side->veg_h();
 6556:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6557: 
 6558:          // Node - const in elem
 6559:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6560:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6561: 
 6562:          if (elem->depth >= tip_dp) {
 6563:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6564:          }
 6565: 
 6566:          
 6567:          const double htot  = side->htot2();        // Total depth at the side
 6568:          const double zctr2 = side->zTopCanopy();  
 6569: 
 6570:          double cff1; 
 6571:          double cff2; 
 6572:          double cff3;   
 6573:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6574:          // coefficients applied to 2D/3D case 
 6575:             cff1 = side->hhat/htot;
 6576:             cff2 = 0.0;
 6577:             cff3 = 0.0;
 6578:          } else { //3D
 6579:             //Init for no-veg case
 6580:             cff1 = 1.0;
 6581:             cff2 = 1.0;
 6582:             cff3 = 0.0;
 6583: 
 6584:             if constexpr(iveg != 0) {
 6585:                // Computes coefficients used with vegetation terms G1, G2
 6586:                // cff1, cff3 are used for the first two terms in G1, G2:
 6587:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6588:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6589:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6590:                if(veg_h < 0.99*htot) { // submergent vegetation
 6591:                   cff1=1;
 6592:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6593:                   cff3 = veg_c;
 6594: 
 6595:                } else { // emergent vegetation
 6596:                   cff1 = 1.0/(1.0 + veg_c2);
 6597:                   cff2 = cff1;
 6598:                   cff3 = 0.0;
 6599: 
 6600:                }
 6601:             } // if iveg
 6602:          } //  2D/3D
 6603: 
 6604:          av_cff1 += cff1/i34;
 6605:          av_cff2 += cff2/i34;
 6606:          av_cff3 += cff3/i34;
 6607:          av_cff2_chi += cff2*chi/i34;
 6608:          av_cff3_chi += cff3*chi/i34;
 6609:          av_df += min(htot, veg_h)/(htot*i34);
 6610: 
 6611: 
 6612:          // btrack values: U^\star, U^{\star\alpha}
 6613:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6614:          Vector2 Ustar       = {0.0, 0.0}; 
 6615:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6616: 
 6617:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6618:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6619:          } else { //3D
 6620:             for (int k = side->kb; k < nvrt; k++) {
 6621:             
 6622:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6623:                Ustar += w2;
 6624: 
 6625:                if constexpr(iveg != 0) {
 6626:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6627:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6628:                        Ustar_alpha += zrat*w2; // XXXX
 6629:                    }
 6630:                }  // if iveg
 6631:             }  // for k
 6632:          }  //2D/3D
 6633:          
 6634: 
 6635:          // Add btrack & surface stress terms to \breve{G} first
 6636:          if constexpr(ics==1) {
 6637: 
 6638:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6639: 
 6640:          } else {
 6641:             // XXX IMPLEMENT THIS
 6642:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6643:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6644:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6645:          }  // if ics
 6646: 
 6647:          // Surface and bottom stress terms
 6648:          if constexpr(ics==1) {
 6649:             const Vector2 tau    = side->tau();
 6650:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6651: 
 6652:             // Term for surface and bottom stress
 6653:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6654: 
 6655:          } else {
 6656:             assert(false && "computeElemAverageGhat: Not implemented");
 6657:             // XXX IMPLEMENT THIS
 6658:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6659:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6660:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6661:             // tau_x=(vn1+tt1)/2.d0
 6662:             // tau_y=(vn2+ss1)/2.d0
 6663:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6664:          }  // if ics
 6665: 
 6666:          
 6667: 
 6668:          // All terms in F,F^\alpha,f_b except baroclinic
 6669:          // F, f_b: all explicit terms excluding vegetation 
 6670:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6671:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6672:          const double coriolis = side->coriolis;
 6673:          Vector2 F  =  coriolis*side->U;  // F_x
 6674:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6675:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6676: 
 6677:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6678:             
 6679:             for (int k = side->kb; k < nvrt; k++) {
 6680:                if (zctr2 > side->zc[k-1]) {
 6681:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6682:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6683:                    Fa +=  coriolis*w2*zrat;
 6684:                } // if zctr2
 6685:             } // k
 6686:          } // iveg
 6687: 
 6688:          // Integrate horizontal viscosity force vertically
 6689:          for (int k=side->kb + 1; k<nvrt; k++) {
 6690:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6691: 
 6692:             F += levelHorVisc;
 6693: 
 6694:             // Vegetation term
 6695:             if constexpr(iveg!=0) {
 6696:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6697:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6698:                   Fa += levelHorVisc*zrat;
 6699:                } 
 6700:             } // if iveg
 6701:          } // for k
 6702: 
 6703:          fb += side->nuGradU[side->kb];
 6704: 
 6705:          // Add to ghat1
 6706:          if constexpr(ics==2) {
 6707:             // XXX IMPLEMENT THIS
 6708:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6709:             // bigf1=vn1; bigf2=vn2
 6710:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6711:             // botf1=vn1; botf2=vn2
 6712:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6713:             // bigfa1=vn1; bigfa2=vn2
 6714:          } // if ics
 6715: 
 6716:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6717:       } // for j (nodes and sides)
 6718: 
 6719:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6720:          
 6721:       // Finish off terms in F, F^\alpha and f_b
 6722:       const double grav3 = elem->mean(&Node::grav2);
 6723:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6724: 
 6725: 
 6726:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6727:       for (int j=1; j<i34; j++) { 
 6728:          // For each side in the element...
 6729:          const Side *side = elem->sides[j];
 6730:          const double chi = side->chi;
 6731: 
 6732:          const double htot = side->htot2();
 6733:          const double veg_h = side->veg_h();
 6734:          const Vector2 F  = htot*fb;
 6735:          const Vector2 Fa = min(htot, veg_h)*fb;
 6736: 
 6737:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6738:       } // for j
 6739: 
 6740:       //botf1 etc are already in elem frame
 6741:       elem->ghat1 += tmp/i34;
 6742: 
 6743:       // Baroclinic force
 6744:       if constexpr(ibc==0) {
 6745:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6746: 
 6747:          Vector2 Fa = {0.0, 0.0};
 6748:          Vector2 intGradRho = {0.0, 0.0};
 6749:          
 6750:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6751:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6752:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6753: 
 6754:             // \in F [m^2/s/s]
 6755:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6756:          }
 6757: 
 6758:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6759:          const Vector2 F = av_df*Fa; //approx
 6760:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6761: 
 6762:       } // if ibc
 6763: 
 6764: 
 6765: 
 6766:    }
 6767: 
 6768: } // extern "C"
 6769: 
 6770: 
 6771: 
 6772: #ifdef DONTCOMPILE
 6773: __global__ void checkMassConservation(Tracers* sumtr) {
 6774: 
 6775:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6776: 
 6777:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6778: 
 6779:    Element *elem = &(mesh->localElemData[i]);
 6780: 
 6781:    // Skip dry elements
 6782:    if (elem->isDry) return;
 6783: 
 6784:    // Local sum array for this thread
 6785:    double localSum[N_TRACERS] = {0.0};
 6786: 
 6787:    // Sum over vertical levels for this element
 6788:    const int kbe = elem->kbe;
 6789:    const double area = elem->area;
 6790: 
 6791:    for (int k = kbe; k < nvrt; k++) {
 6792:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6793:       
 6794:       // Accumulate tracer mass
 6795:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6796:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6797:       }
 6798:    }
 6799: 
 6800:    
 6801: 
 6802:    //  This function returns per element sums. A reduction must be done on the host side.
 6803: }
 6804: 
 6805: 
 6806: __global__ void transport(void) {
 6807: 
 6808:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6809: 
 6810:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6811: 
 6812:    Element *elem = &(mesh->localElemData[ie]);
 6813: 
 6814:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6815: 
 6816:                for (int m=0; m<ntr; m++) {
 6817:                   for (int k=kbe(ie); k<nvrt; k++) {
 6818:                      // Calculate each polynomial's weight 
 6819:                      wm=0.d0; sum1=0.d0; 
 6820:                      wm1=0.d0; wm2=0.d0; 
 6821:                      for (int i=0; i<elem->nweno2; i++) {
 6822:                   
 6823:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6824:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6825:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6826:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6827:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6828:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6829:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6830:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6831:                      // -----------------Hu and Shu (1999)'s method----------------
 6832:                      b4=b1+b2+b3
 6833: 
 6834: //Error: add PRODUCTION CPP
 6835: #ifdef DEBUG
 6836:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6837:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6838:                     call parallel_abort(errmsg)
 6839:                   }
 6840: #endif
 6841: 
 6842:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6843:                   // !----test-------------- 
 6844:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6845:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6846:                   // !wm(i)=wm1(i)*wm2(i)
 6847:                   // !---------------------- 
 6848:                   sum1=sum1+wm(i)
 6849:                 } // end for i
 6850: 
 6851:                 wm=wm/sum1
 6852: 
 6853:                 for (int j=0; j<elem->i34; j++) {
 6854: 
 6855:                   const Side *side  = elem->sides[j];
 6856:                   const Node *node1 = side->n1;
 6857:                   const Node *node2 = side->n2;
 6858: 
 6859:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6860:                      trsd=0.d0
 6861:                      for (int kk=0; kk<nquad; kk++) {
 6862:                         for (int i=0; i<elem->nweno2; i++) {
 6863:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6864:                         } // end for i   
 6865:                      } // end for kk
 6866:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6867:                   } // outward flux
 6868:                } // end for j=1,i34(ie) ! side
 6869:             }
 6870:          }
 6871:               
 6872: 
 6873: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6874: //             //   calculate each polynomial's weight 
 6875: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6876: //                 wm=0.d0; sum1=0.d0
 6877: //                 do i=1,nweno1(ie) !for each polynomial
 6878: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6879: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6880: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6881: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6882: //                   wm(i)=b2
 6883: //                   sum1=sum1+b2
 6884: //                   !wm(i)=1.d0
 6885: //                   !sum1=sum1+1.d0
 6886: 
 6887: // // Error: PRODUCTION
 6888: // #ifdef DEBUG
 6889: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6890: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6891: //                     call parallel_abort(errmsg)
 6892: //                   endif
 6893: // #endif
 6894: 
 6895: //                 enddo !i
 6896: //                 wm=wm/sum1 !final weight
 6897: 
 6898:                 for (int j=0; j<elem->i34; j++) { // side
 6899:                   const Side *side = elem->sides[j];
 6900:                   const Node *node1 = side->n1;
 6901:                   const Node *node2 = side->n2;
 6902: 
 6903:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6904:                     trsd=0.d0
 6905:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6906:                       for (int i=0; i<elem->nweno1; i++) {
 6907:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6908:                       }
 6909:                     enddo //kk
 6910:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6911:                   } // outward flux
 6912:                 } // end for j=1,i34(ie) ! side
 6913:               } // end for k; ntr 
