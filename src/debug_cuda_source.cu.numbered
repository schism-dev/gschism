 2151: 
 2152: /**
 2153:    Compute the shape coordinates of the point (xt,yt) in the element.
 2154:    @param xt (input): x-coordinate of the point
 2155:    @param shpCoords (output): shape coordinates of the point
 2156:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2157:    @return true if the point is inside the element, false otherwise
 2158: **/
 2159: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegshpCoord) const {
 2160: 
 2161:    // Compute the shape coordinates of the point xt in the element.
 2162:    if (i34==3) {
 2163:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2164:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2165:       // and in this case, the pt will be nudged into the element
 2166:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2167:       // from the local frame, so use additional check.
 2168: 
 2169:       Point2 x0, x1, x2;
 2170: 
 2171:       if constexpr(ics==1) {
 2172:          x0 = nodes[0]->p;
 2173:          x1 = nodes[1]->p;
 2174:          x2 = nodes[2]->p;
 2175:       }
 2176:       else // lat/lon
 2177:       {
 2178:          Error("Not implemented yet");
 2179:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2180:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2181:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2182:       }
 2183: 
 2184:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2185:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2186:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2187:       shpCoords[3] = 0.0;
 2188: 
 2189:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2190:       const bool res = (tmpmin >= -small);  
 2191:       
 2192:       // If the point is not inside the element, we do not need to fix the negative shape coordinates.
 2193:       fixNegshpCoord = fixNegshpCoord && res;
 2194: 
 2195:       
 2196:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2197:       // then we fix the negative shape coordinates.
 2198:       if ((tmpmin < 0) && fixNegshpCoord) {
 2199: 
 2200:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2201:          // keeping the sum of the shape coordinates equal to 1.
 2202:          // I have tested and compared the new algorithm with the old one, and they give
 2203:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2204:          // The new algorithm should be faster since it is branchless.
 2205:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2206:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2207:          
 2208:          shpCoords[0] = (shpCoords[0] + a)*b;
 2209:          shpCoords[1] = (shpCoords[1] + a)*b;
 2210:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2211: 
 2212:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2213:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2214:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2215:          }
 2216: 
 2217:          // Update the point coordinates for the new shape coordinates
 2218:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2219:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2220:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2221: 
 2222:       }
 2223: 
 2224:       // Check if the point is inside the element
 2225:       return res;      
 2226:    }
 2227:    else {
 2228:       Error("Not implemented yet");
 2229: #ifdef QUADS
 2230:       // Reproject pt in eframe of nel for ics=2
 2231:       if constexpr(ics==1) {
 2232:          xn2 = xt; 
 2233:          yn2 = yt;
 2234:       }
 2235:       else {
 2236:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2237:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2238:       }
 2239: 
 2240:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2241: #endif
 2242:    }
 2243: 
 2244:    assert(false && "computeShapeCoords: should never reach this point");
 2245:    return false;  // Never reached
 2246: 
 2247: }
 2248: 
 2249: 
 2250: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2251: // Convert shape coordinates to cartesian coordinates
 2252: 
 2253:    if (i34 == 3) {
 2254:       // Triangular element
 2255:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2256:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2257:    }
 2258:    else {
 2259:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2260:    }
 2261: 
 2262: }
 2263: 
 2264: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2265:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2266:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2267:    // The formula for the integral is:
 2268:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2269: 
 2270:    printf("intPhiPhi: TEST\n");
 2271: 
 2272:    const Node *n0 = nodes[0];
 2273:    const Node *n1 = nodes[1];
 2274:    const Node *n2 = nodes[2];
 2275:    const Node *n3 = nodes[3];
 2276: 
 2277:    const Vector2 p0 = n0->p;
 2278:    const Vector2 p1 = n1->p;
 2279:    const Vector2 p2 = n2->p;
 2280:    const Vector2 p3 = n3->p;
 2281: 
 2282:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2283:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2284:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2285:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2286: 
 2287:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2288: }
 2289:    
 2290: 
 2291: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2292:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2293:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2294:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2295:    // The formula is also based on the identity:
 2296:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2297:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2298: 
 2299:    printf("intGradPhiGradPhi: TEST\n");   
 2300: 
 2301:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2302: 
 2303:    const double x0 = nodes[0]->p.x;
 2304:    const double y0 = nodes[0]->p.y;
 2305:    const double x1 = nodes[1]->p.x;
 2306:    const double y1 = nodes[1]->p.y;
 2307:    const double x2 = nodes[2]->p.x;
 2308:    const double y2 = nodes[2]->p.y;
 2309:    const double x3 = nodes[3]->p.x;
 2310:    const double y3 = nodes[3]->p.y;
 2311: 
 2312:    double res = 0.0;
 2313:    
 2314:    // Quadrature points in xi and eta coordinates
 2315:    #pragma unroll
 2316:    for (int i = 0; i < 4; i++) {
 2317:       // For each quadrature point...
 2318: 
 2319:       const Point2 p = GaussPoint(i);
 2320:       const double eta = p.x;
 2321:       const double xi  = p.y;
 2322: 
 2323:       // Jacobian entries at the Gauss point p
 2324:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2325:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2326:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2327:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2328: 
 2329:       const double detJ = jacobianDet(p);
 2330:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2331: 
 2332:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2333:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2334:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2335:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2336:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2337: 
 2338:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2339:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2340:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2341:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2342:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2343: 
 2344:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2345:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2346:    }
 2347: 
 2348:    return res;
 2349: }
 2350: 
 2351: 
 2352: /**  Interpolate velocities at a given point (xt,yt,zt)
 2353: 
 2354:    @param xt, yt, zt: coordinates of the point to interpolate
 2355:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2356: 
 2357:    This is done in four steps:
 2358: 
 2359:    1. Find the shape coordinates for the final position in the element.
 2360:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2361:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2362:       z levels at xt, yt at each step.   
 2363:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2364:       horizontally and vertically.
 2365: **/
 2366: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2367:    // Interpolate the velocities at the point xt. 
 2368:    // This function works the same for triangular and quadrilateral elements.
 2369:    double shpCoord[4];
 2370: 
 2371:    // First step is to compute the shape coordinates of (xt,yt)
 2372:    computeShapeCoords(toVector2(xt), shpCoord, true);
 2373: 
 2374:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2375: 
 2376:    // Second step is to find the level that contains zt
 2377:    // Uses a binary search to find the level
 2378:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2379:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2380:    int R = nvrt - 1;
 2381: 
 2382:    // Get the z coordinates at the nodes of the element at the levels L and R
 2383:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2384:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2385:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2386: 
 2387:    double zL = interpolate(shpCoord, zLAtNodes);
 2388:    double zR = interpolate(shpCoord, zRAtNodes);
 2389:    
 2390:    // Interpolates vertically the velocities
 2391:    double wght1, wght2;
 2392:    if (xt.z<=zL) {
 2393:       wght1 = 1.0;
 2394:       wght2 = 0.0;
 2395:       xt.z = zL;
 2396:    }
 2397:    else if (xt.z>=zR) {
 2398:       wght1 = 0.0;
 2399:       wght2 = 1.0;
 2400:       xt.z = zR;
 2401:    }
 2402:    else {
 2403:       // Perform a binary search to find the levels between L and R that contain xt.z
 2404:       while (R - L > 1) {
 2405:          int M = (L + R) / 2.0;
 2406: 
 2407:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2408:          double zM = interpolate(shpCoord, zMAtNodes);
 2409:          if (zM < xt.z) 
 2410:          {
 2411:             L = M;
 2412:             zL = zM;
 2413:          }
 2414:          else 
 2415:          {
 2416:             R = M;
 2417:             zR = zM;
 2418:          }
 2419:       }
 2420:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2421:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2422: 
 2423:       wght2 = (xt.z - zL)/(zR - zL);
 2424:       wght1 = 1.0 - wght2;
 2425: 
 2426:    }
 2427: 
 2428: 
 2429:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2430:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2431: 
 2432:    // Neither of the interpolated velocities should be NaN
 2433:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2434: 
 2435: }
 2436: 
 2437: 
 2438: 
 2439: 
 2440: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2441: 
 2442:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2443:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2444:    const Node *n1 = side->n1;
 2445:    const Node *n2 = side->n2;
 2446: 
 2447:    bool n1_match = (n1->nodeBnd->segment == segment);
 2448:    bool n2_match = (n2->nodeBnd->segment == segment);
 2449: 
 2450:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2451:    if (n1_match && n2_match) {
 2452:       return 0.5;
 2453:    } else if (n1_match) {
 2454:       return 1.0;
 2455:    } else if (n2_match) {
 2456:       return 0.0;
 2457:    }
 2458: 
 2459:    return 0.0;
 2460: }
 2461: 
 2462: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2463: 
 2464: 
 2465: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2466: 
 2467:    const double w1 = getBoundaryArrayValueWeight();
 2468:    const double w2 = 1.0 - w1;
 2469:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2470:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2471: 
 2472:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2473: }
 2474: 
 2475: 
 2476: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2477:    const double w1 = getBoundaryArrayValueWeight();
 2478:    const double w2 = 1.0 - w1;
 2479:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2480:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2481: 
 2482:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2483: 
 2484: }
 2485: 
 2486: 
 2487: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2488:    // Returns the value of the velocity at the side center
 2489:    const double w1 = getBoundaryArrayValueWeight();
 2490:    const double w2 = 1.0 - w1;
 2491:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2492:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2493: 
 2494:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2495: }
 2496: 
 2497: 
 2498: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2499:    // Returns the value of the normal component of the velocity at the side center
 2500:    const double w1 = getBoundaryArrayValueWeight();
 2501:    const double w2 = 1.0 - w1;
 2502:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2503:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2504: 
 2505:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2506: }
 2507: 
 2508: 
 2509: 
 2510: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2511: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2512: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2513: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2514: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2515: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2516:    Vector2 grad = {0.0, 0.0};
 2517:    int count = 0;
 2518: 
 2519:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2520: 
 2521:    // First element
 2522:    if (elems[0] != nullptr && condition(elems[0])) {
 2523:       grad += elems[0]->grad2(field);
 2524:       count++;
 2525:    }
 2526: 
 2527:    // Second element
 2528:    if (elems[1] != nullptr && condition(elems[1])) {
 2529:       grad += elems[1]->grad2(field);
 2530:       count++;
 2531:    }
 2532: 
 2533:    if (count > 0) {
 2534:       grad = grad*(1.0/count);
 2535:    }
 2536:    
 2537:    return grad;
 2538: }
