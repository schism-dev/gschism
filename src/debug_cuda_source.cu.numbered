 2086: __device__ void lock(int *mutex) {
 2087:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2088: }
 2089: 
 2090: __device__ void unlock(int *mutex) {
 2091:     atomicExch(mutex, 0);
 2092: }
