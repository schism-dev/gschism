 9169: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9170:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9171:    NODE(node);
 9172: 
 9173:    switch (varCode) {
 9174:       case (int)VarCode::outputCoords: {
 9175:          const Point2 coords = node->outputCoords();
 9176:          double *out = (double *)((char *)res + idx_node * 16);
 9177:          out[0] = coords.x;
 9178:          out[1] = coords.y;
 9179:          break;
 9180:       }
 9181:       case (int)VarCode::depth:
 9182:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9183:          break;
 9184:       case (int)VarCode::kb:
 9185:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9186:          break;
 9187:       case (int)VarCode::eta:
 9188:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9189:          break;
 9190:       case (int)VarCode::u_air: {
 9191:          double *out = (double *)((char *)res + idx_node * 16);
 9192:          out[0] = node->u_air.x;
 9193:          out[1] = node->u_air.y;
 9194:          break;
 9195:       }
 9196:       case (int)VarCode::isdry:
 9197:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9198:          break;
 9199:       case (int)VarCode::u: {
 9200:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9201:          if (k >= 0) {
 9202:             out[0] = node->u2[k].x;
 9203:             out[1] = node->u2[k].y;
 9204:          } else {
 9205:             for (int lev = 0; lev < nvrt; lev++) {
 9206:                out[lev*2    ] = node->u2[lev].x;
 9207:                out[lev*2 + 1] = node->u2[lev].y;
 9208:             }
 9209:          }
 9210:          break;
 9211:       }
 9212:       case (int)VarCode::z: {
 9213:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9214:          if (k >= 0)
 9215:             out[0] = node->z[k];
 9216:          else
 9217:             for (int lev = 0; lev < nvrt; lev++)
 9218:                out[lev] = node->z[lev];
 9219:          break;
 9220:       }
 9221:       case (int)VarCode::w: {
 9222:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9223:          if (k >= 0)
 9224:             out[0] = node->w2[k];
 9225:          else
 9226:             for (int lev = 0; lev < nvrt; lev++)
 9227:                out[lev] = node->w2[lev];
 9228:          break;
 9229:       }
 9230:       case (int)VarCode::dfh: {
 9231:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9232:          if (k >= 0)
 9233:             out[0] = node->dfh[k];
 9234:          else
 9235:             for (int lev = 0; lev < nvrt; lev++)
 9236:                out[lev] = node->dfh[lev];
 9237:          break;
 9238:       }
 9239:       case (int)VarCode::dfv: {
 9240:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9241:          if (k >= 0)
 9242:             out[0] = node->dfv[k];
 9243:          else
 9244:             for (int lev = 0; lev < nvrt; lev++)
 9245:                out[lev] = node->dfv[lev];
 9246:          break;
 9247:       }
 9248:    }
 9249: }
 9250: 
 9251: 
 9252: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9253:    SIDE(side);
 9254: 
 9255:    switch (varCode) {
 9256:       case (int)VarCode::outputCoords: {
 9257:          const Point2 coords = side->outputCoords();
 9258:          double *out = (double *)((char *)res + idx_side * 16);
 9259:          out[0] = coords.x;
 9260:          out[1] = coords.y;
 9261:          break;
 9262:       }
 9263:       case (int)VarCode::n1:
 9264:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9265:          break;
 9266:       case (int)VarCode::n2:
 9267:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9268:          break;
 9269:       case (int)VarCode::isdry:
 9270:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9271:          break;
 9272:    }
 9273: }
