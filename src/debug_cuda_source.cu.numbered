 2210:                    if (idx_elem >= mesh->ne) return;
 2211: 
 2212: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 2213:                    Node *node = &(mesh->localNodeData[idx_node]); \
 2214:                    if (idx_node >= mesh->np) return;
 2215: 
 2216: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 2217:                               Node *node = &(mesh->localNodeData[idx_node]); \
 2218:                               const bool valid = (idx_node < mesh->np);                   
 2219: 
 2220: 
 2221: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2222:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 2223:                            if (idx_node_bnd >= mesh->nbp) return;
 2224: 
 2225: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2226:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2227:                            if (idx_side_bnd >= mesh->nbs) return;  
