 3797: __device__ __inline__ void Node::updateZCoordData(void) {
 3798: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3799: 
 3800:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3801:    // if (isDry2()) {
 3802:    //    kb = -1;  // XXXXXXXX KKKKK
 3803:    //    return;
 3804:    // }
 3805: 
 3806: 
 3807:    if constexpr(ivcor == 2) {  // SZ coordinates
 3808:       
 3809:       // Compute bottom level index
 3810:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3811:    } 
 3812:    else {  // if (ivcor == 1) Localized sigma
 3813:       // Do nothing
 3814:    }
 3815: 
 3816: 
 3817: }
