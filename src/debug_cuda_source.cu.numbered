 1359: // Helper functions for computing the local node index at a given offset from another.
 1360: __device__ __inline__ int nxq(int offset, int index, int size) {
 1361:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1362:    // to the index to make it positive
 1363:    assert(index + offset + 16*size >= 0);
 1364:    return (index + offset + 16*size) % size;  
 1365: }
 1366: 
 1367: __device__ __inline__ int nxq(int index, int size) {
 1368:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1369:    // to the index to make it positive
 1370:    assert(index + 16*size >= 0);
 1371:    return (index + 16*size) % size; 
 1372: }
