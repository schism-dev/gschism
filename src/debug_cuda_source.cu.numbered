  905:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  906:                                        Point3 &xt, double zint, Vector3 &u_int);
  907:     
  908:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  909:                                                  Element *&nextElem, int &jlev, double &dt, double time_rm,
