 6503: __global__ void getStructSizes(int* sizes)  {
 6504:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 6505:       sizes[0] = (int)sizeof(Node);
 6506:       sizes[1] = (int)sizeof(Element);
 6507:       sizes[2] = (int)sizeof(Side);
 6508:       sizes[3] = (int)sizeof(NodeBoundary);
 6509:       sizes[4] = (int)sizeof(SideBoundary);
 6510:       sizes[5] = (int)sizeof(BoundarySegment);
 6511: }
