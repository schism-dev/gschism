 1670:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1671:       // Compute the different time ramps used in the code 
 1672:       // This function is performed by just one thread
 1673: 
 1674:       rampbc = 1.0;
 1675:       if constexpr(ibc == 0) {
 1676:          if (drampbc > 0.0) {
 1677:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1678:          } else {
 1679:             rampbc = 1.0;
 1680:          }
 1681:       }
 1682: 
 1683:       if (nws != 0) {
 1684:          if (drampwind > 0.0) {
 1685:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1686:          } else {
 1687:             rampwind = 1.0;
 1688:          }
 1689:       }
 1690: 
 1691:       if (drampwafo > 0.0) {
 1692:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1693:       } else {
 1694:          rampwafo = 1.0;
 1695:       }
 1696: 
 1697:       // For source/sinks
 1698:       if (if_source && dramp_ss > 0.0) {
 1699:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1700:       } else {
 1701:          ramp_ss = 1.0;
 1702:       }
 1703: 
 1704:       if (dramp > 0.0) {
 1705:          ramp = tanh(2.0*time/86400.0/dramp);
 1706:       } else {
 1707:          ramp = 1.0;
 1708:       }
 1709: 
 1710: 
 1711:    }
