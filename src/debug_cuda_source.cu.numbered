 3904: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3905: 
 3906: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3907: 
 3908:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3909:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3910: 
 3911:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3912:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3913: 
 3914:    double fun_lat = 0.0;
 3915:    switch (jspc[idxComp]) {
 3916:       case 0:
 3917:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3918:          break;
 3919:       case 1:
 3920:          fun_lat = sin(2.0*lat);
 3921:          break;
 3922:       case 2:
 3923:          fun_lat = pow<2>(cos(lat));
 3924:          break;
 3925:       default:
 3926:          assert(false && "computeETP: invalid jspc");
 3927:    }
 3928:    
 3929:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3930: 
 3931: }
 3932: 
 3933: __device__ void Node::updateKb(void) {
 3934: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3935: 
 3936:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3937: 
 3938: 
 3939:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3940: 
 3941:    if constexpr(ivcor == 2) {  // SZ coordinates
 3942:       
 3943:       // Compute bottom level index
 3944:       if (depth <= mesh->h_s) {
 3945:          kb = izlev;   
 3946:          
 3947:       } else {
 3948:          kb = -1;
 3949:          int L = 0;
 3950:          int R = nzlev; 
 3951:          
 3952:          while (L <= R) {
 3953:             int M = (R + L) / 2;
 3954: 
 3955: 
 3956:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3957:             
 3958:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3959:                R = M;
 3960:             } else {
 3961:                L = M;
 3962:             }
 3963: 
 3964:             if (R - L == 1) {
 3965:                kb = L;
 3966:                break;
 3967:             }
 3968:          }
 3969: 
 3970:          // Checks that the binary search was successful
 3971:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3972:        
 3973:       }
 3974:    } 
 3975: }
