 7145: __global__ void getStructSizes(int* sizes)  {
 7146:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7147:       sizes[0] = (int)sizeof(Node);
 7148:       sizes[1] = (int)sizeof(Element);
 7149:       sizes[2] = (int)sizeof(Side);
 7150:       sizes[3] = (int)sizeof(NodeBoundary);
