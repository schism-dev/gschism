 2597:    template<typename T>
 2598:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2599:       T values[4];
 2600:       getNodalValues(level, func, values);
 2601: 
 2602:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2603:       if constexpr (IsVector2<T>::value && ics == 2) {
 2604: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2605:          projectNodeVectorsToElementFrame(values);
 2606: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2607:       }
 2608: 
 2609:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2610:    }
 2611: 
 2612:    template<typename T>
 2613:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2614:       T values[4];
 2615:       getNodalValues(field, values);
 2616: 
 2617:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2618:       if constexpr (IsVector2<T>::value && ics == 2) {
 2619: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2620:          projectNodeVectorsToElementFrame(values);
 2621: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2622:       }
 2623:       
 2624:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2625:    }
 2626: 
 2627: 
 2628:    template<typename T>
 2629:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2630:       T values[4];
 2631:       getNodalValues(level, field, values);
 2632:       
 2633: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2634:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2635:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2636:       if constexpr (IsVector2<T>::value && ics == 2) {
 2637: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2638:          projectNodeVectorsToElementFrame(values);
 2639: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2640:       }
 2641: 
 2642:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2643:    }
