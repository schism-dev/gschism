 1131: // This struct is used to store the boundary information for a node.
 1132: struct NodeBoundary {   
 1133:    int idx;
 1134:    BoundarySegment *segment;
 1135:    Node *node;
 1136:    
 1137:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1138:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1139: 
 1140:    bool isLand;
 1141: 
 1142:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1143:    double elbc;   // Elevation boundary condition
 1144:    double eth;    // Elevation time history
 1145: 
 1146:    double eta_mean; // Mean elevation at nodes
 1147: 
 1148:    bool isEssentialBC;
 1149: 
 1150:    Vector2 uth[nvrt];  // "Time history" velocity
 1151: 
 1152:    // Arrays for harmonic constituents (if needed)
 1153:    double  emo[nbfr];  // Elevation amplitude
 1154:    double  efa[nbfr];  // Elevation phase
 1155:    Vector2 umo[nbfr];  // velocity amplitude
 1156:    Vector2 ufa[nbfr];  // velocity phase
 1157: 
 1158: 
 1159:    NodeBoundary(void) {
 1160:       isLand = false;
 1161:    }
 1162:    NodeBoundary(bool _isLand) {
 1163:       isLand = _isLand;
 1164:    }
 1165: 
 1166:    
 1167:    __forceinline__ __device__ int numSidesForAverage() const {
 1168:    // Returns the number of sides that are connected to the node and have the same segment.
 1169:    // This is used to compute the average velocity at the node for open boundary nodes.
 1170:       int res = 0;
 1171:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1172:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1173: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1174:       return res;
 1175:    }
 1176: 
 1177: 
 1178:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1179:       assert(index == 0 || index == 1); 
 1180:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1181:    }
 1182: 
 1183: 
 1184: };
