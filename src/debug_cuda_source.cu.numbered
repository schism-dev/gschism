 1570: __device__ void lock(int *mutex) {
 1571:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1572: }
 1573: 
 1574: __device__ void unlock(int *mutex) {
 1575:     atomicExch(mutex, 0);
