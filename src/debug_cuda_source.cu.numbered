 1779: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1780:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1781: }
 1782: 
 1783: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1784:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1785: }   
 1786: 
 1787: __device__ __inline__ double min3(double a, double b, double c) {
 1788:    return min(a, min(b, c));
 1789: }
 1790: 
 1791: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1792:    return min(a, min(b, min(c, d)));
 1793: }
