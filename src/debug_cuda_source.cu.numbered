 5289:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5290: 
 5291:       NODE(node);
 5292: 
 5293:       node->ETP = 0.0;
 5294: 
 5295:       if constexpr(ntip == 0) return;
 5296: 
 5297:       // For all tidal potential components
 5298:       for (int j=0; j<ntip; j++) {
 5299: 
 5300:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5301: 
 5302:          node->ETP += nodeETP;
 5303: 
 5304:          if constexpr(iloadtide==1) { // loading tide
 5305:             assert(false && "Loading tide not implemented");
 5306:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5307:          }
 5308:          
 5309:       }
 5310: 
 5311:      
 5312:    }
