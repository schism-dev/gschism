 4522:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4523: 
 4524:       NODE_BND(nodeBnd);
 4525: 
 4526:       Node *node = nodeBnd->node;
 4527: 
 4528:       node->ETP = 0.0;
 4529: 
 4530:       for (int j=0; j<ntip; j++) {
 4531: 
 4532:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4533:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4534:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4535: 
 4536:          if constexpr(iloadtide==1) { // loading tide
 4537:             assert(false && "Loading tide not implemented");
 4538:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4539:          }
 4540:          
 4541:       }
 4542:       
 4543:    }
