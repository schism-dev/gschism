  188: using Vector2 = double2; 
  189: using Vector3 = double3;
  190: using Point2  = double2;
  191: using Point3  = double3;
  192: 
  193: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  194:     return make_double2(a.x + b.x, a.y + b.y);
  195: }
  196: using Vector2 = double2; 
  197: using Vector3 = double3;
  198: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  199:     a.x += b.x;
  200:     a.y += b.y;
  201:     return a;
  202: }
  203: 
  204: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  205:     return make_double2(a.x - b.x, a.y - b.y);
  206: }
  207: 
  208: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  209:     a.x -= b.x;
  210:     a.y -= b.y;
  211:     return a;
  212: }
  213: 
  214: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  215:     return make_double2(v.x * s, v.y * s);
  216: }
  217: 
  218: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  219:     return v * s;  // reuse the previous operator
  220: }
  221: 
  222: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  223:     return make_double2(v.x / s, v.y / s);
  224: }
  225: 
  226: __device__ __forceinline__ double norm2(const double2& v) {
  227:     return v.x*v.x + v.y*v.y;
  228: }
  229: 
  230: __device__ __forceinline__ double length(const double2& v) {
  231:     return sqrt(v.x*v.x + v.y*v.y);
  232: }
  233: 
  234: __device__ __forceinline__ double2 normalize(const double2& v) {
  235:     return v / length(v);
  236: }
  237: 
  238: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  239:     return v.x*w.x + v.y*w.y;
  240: }
  241: 
  242: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  243:     return v.x*w.y - v.y*w.x;
  244: }
  245: 
  246: __device__ __forceinline__ double2 rot90(const double2& a) {
  247:     return make_double2(a.y, -a.x);
  248: }
  249: 
  250: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  251:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  252: }
  253: 
  254: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  255:     a.x += b.x;
  256:     a.y += b.y;
  257:     a.z += b.z;
  258:     return a;
  259: }
  260: 
  261: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  262:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
