 5555: 
 5556:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5557: 
 5558:       SIDE(side);
 5559: 
 5560:       side->U = {0.0, 0.0}; 
 5561:          
 5562:       if(side->isDry) return;
 5563: 
 5564:       // Vertically integrated velocity U
 5565:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5566:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5567:          side->U += side->Dz(k + 1)*uc;  
 5568:       }
 5569: 
 5570:    }
 5571: 
 5572:    __global__ void computeBottomDragVegetation(void) {
 5573:       // UNFINISHED. CHECK THIS:
 5574:       // How many kernels are needed? Why so many for loops?
 5575:       // Is the loop on sides needed?
 5576: 
 5577:       NODE(node);
 5578: 
 5579: 
 5580:       const int    kb      = node->kb;
 5581:       const double htot    = node->htot2(); 
 5582:       
 5583:       if (node->isDry) {
 5584:          // Default values for dry nodes
 5585:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5586:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5587: 
 5588:          return;
 5589:        
 5590:       }
 5591: 
 5592:       // Computes bottom drag Cd based on the selected nchi
 5593:       node->computeBottomDragCd();
 5594:       
 5595: 
 5596: 
 5597:       //   Bottom stress in m^2/s^2
 5598:       if (node->rho[kb + 1] >= -98.0)
 5599:       {
 5600:          const double mag_u = length(node->u2[kb + 1]);
 5601:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5602: 
 5603:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5604:          // !sediment erosion: this part needs more documentation
 5605:       }
 5606:     
 5607: 
 5608: 
 5609:       // Compute vegetation parameters
 5610:       //--------------------------------
 5611: 
 5612:       // SAV constants
 5613:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5614:       constexpr double veg_cfpsi = 0.16;
 5615: 
 5616:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5617:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5618: 
 5619:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5620:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5621:          int kbin = 0; // bin index
 5622:          for (int k = kb; k < nvrt; k++) {
 5623:             // Computes node height above the bottom level
 5624:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5625:             assert(false && "Vertical variation of vegetation not implemented");
 5626: 
 5627:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5628:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5629:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5630:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5631:             // } else {
 5632:             //    // Find the bin at which the current vertical level is
 5633:             //    while (kbin<nbins_veg_vert) {
 5634:             //       const double zn = node->z[kbin];
 5635:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5636:             //          break;
 5637:             //       } // if
 5638:             //       kbin++;
 5639:             //    } // while
 5640:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5641: 
 5642:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5643:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5644:                
 5645:             //    // Linear interpolation of the vegetation parameters
 5646:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5647:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5648:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5649:             // } // if rl10
 5650: 
 5651:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5652: 
 5653:          } // for k
 5654: 
 5655: 
 5656:       } else { // Ganthy (iveg==2)
 5657:       //  Modify canopy height, diameter, and density
 5658: 
 5659:          // Make sure there is vegetation on this node
 5660:          if (node->veg_h_unbent > 0.0) {
 5661:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5662: 
 5663:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5664:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5665:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5666: 
 5667:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5668:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5669:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5670:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5671:          } // if veg_h_unbent
 5672: 
 5673:          for (int k = 0; k < nvrt; k++) {
 5674:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5675:          } // for k
 5676:       
 5677: 
 5678:       } // if iveg
 5679:      
 5680: 
 5681:       // Compute vertical mean of veg_alpha3D
 5682:       if (iveg != 0) {
 5683:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5684:          double sum1=0.0;
 5685:          double sum2=0.0;
 5686:          // Integrate over each level under the canopy...
 5687:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5688:             const double Dz = node->Dz(k);
 5689: 
 5690:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5691:             sum2 += Dz;
 5692: 
 5693:          } // for k
 5694:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5695:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5696: 
 5697:       } // if iveg
 5698: 
 5699:    }
 5700: 
 5701:    __global__ void computeVegetationAndDragParameters(void) {
 5702:       // Computes the vegetation and drag model parameters:
 5703:       // chi, \tilde\chi, beta, \breve{H}
 5704:       
 5705:       SIDE(side);
 5706: 
 5707:       side->hhat = 0.0;
 5708:       side->chi2 = 0.0;
 5709:       side->chi = 0.0;
 5710:       side->veg_c2 = 0.0;
 5711:       side->veg_beta = 0.0;
 5712: 
 5713:       if (side->isDry) return;
 5714: 
 5715:       const double htot = side->htot2();
 5716:       const int    kb   = side->kb;
 5717: 
 5718:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5719: 
 5720:       const double veg_h     = side->veg_h();
 5721:       const double veg_nv    = side->veg_nv();
 5722:       const double veg_c     = side->veg_c();
 5723:       const double veg_beta  = side->veg_beta;
 5724:       const double veg_alpha = side->veg_alpha_vert_mean();
 5725: 
 5726:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5727:       // Velocity magnitude at the bottom level
 5728:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5729:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5730:       side->chi2 = side->Cd()*vmag1;
 5731:       side->chi  = side->chi2;
 5732:       if constexpr(iveg != 0) {
 5733:          const Node *n1 = side->n1;
 5734:          const Node *n2 = side->n2;
 5735:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5736:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5737:       }
 5738: 
 5739:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5740: 
 5741:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5742:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5743:       double magUa = 0.0;
 5744:       if constexpr(iveg != 0) {
 5745:          if (side->is3D() && veg_h > 0.0) {
 5746:             // 3D wet side with veg...
 5747: 
 5748:             double magUa = 0.0;
 5749:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5750:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5751: 
 5752:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5753:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5754:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5755: 
 5756:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5757:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5758: 
 5759:                   // Velocity magnitude at the bottom (l) of the level
 5760:                   const double ul = length(side->u2[k]);
 5761: 
 5762:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5763:                   magUa += Dz*0.5*(uh + ul);
 5764: 
 5765:                } // if HasVegetation
 5766:             } // for k
 5767:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5768: 
 5769:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5770:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5771:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5772:                const double zCpy = side->zTopCanopy();
 5773:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5774:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5775:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5776:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5777:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5778:             } // if isSubmerged
 5779:          } // if is3D
 5780:       } // if iveg   
 5781: 
 5782:       // Computes the friction modified depth, \breve{H} in notes
 5783:       if (side->is2D()) { // 2D
 5784: 
 5785:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5786:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5787: 
 5788:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5789: 
 5790:          side->hhat = htot*htot/fricH; 
 5791: 
 5792:       } else { // 3D
 5793:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5794: 
 5795:          if constexpr(iveg != 0) {
 5796:             
 5797:             if (side->isSubmerged()) { 
 5798:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5799:                side->hhat -= veg_c*Hhat_alpha;
 5800: 
 5801:             } else { // Emergent
 5802:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5803:             }
 5804:          } // if iveg
 5805: 
 5806:          // Enforce positivity for 3D model
 5807:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5808:       } // if 3D
 5809: 
 5810:    }
 5811: 
 5812: 
 5813: 
 5814:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5815:    // Computes the density gradient between two elements, e1 and e2.
 5816:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5817:    // zero in the direction normal to the side. 
 5818:    // 
 5819:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5820:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5821:    //
 5822:    // Input:
 5823:    //    e1: Element
 5824:    //    e2: Neighbor element (or nullptr if boundary)
 5825:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5826:    //    k: Index of the half-level at which the density is interpolated
 5827:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5828:    // 
 5829:    // Output:
 5830:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5831:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5832: 
 5833:       if (e2 == nullptr || e2->isDry) {
 5834:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5835: 
 5836:          Side *side = e1->sides[j];
 5837:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5838:                  
 5839:          if constexpr(ics == 1) {
 5840:             vec = side->n; // Normal vector to the side
 5841:          } else {
 5842:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5843:             // IMPLEMENT THIS XXXXXX
 5844:             // !replace with xel, yel?
 5845:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5846:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5847:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5848:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5849:          } //ics
 5850:                    
 5851:          diffRho = 0.0;
 5852: 
 5853:       } else { //internal and wet
 5854:          if constexpr(ics==1) {
 5855:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5856: 
 5857:             // Vector from e1 to e2
 5858:             vec = e2->center - e1->center;
 5859: 
 5860:          } else { 
 5861:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5862:             // Remember that elem->center is in global coordinates
 5863:             // IMPLEMENT THIS XXXXXX
 5864:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5865:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5866:             //                   alow(j)=xctr2
 5867:             //                   bdia(j)=yctr2
 5868:          } // ics
 5869: 
 5870:          diffRho = rho2 - e1->demeanedDensity(k);
 5871:       }
 5872: 
 5873:    }
 5874: 
 5875:    __global__ void computeDensityCubicSplines(void) {
 5876:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5877: 
 5878:       ELEM(elem);
 5879: 
 5880:       if (elem->isDry) return;
 5881: 
 5882:       const int kb = elem->kb;
 5883: 
 5884:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5885:       if (elem->is2D()) {
 5886:          // In the 2D case, the density is constant at the prism level. 
 5887:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5888:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5889:       } else { //3D
 5890: 
 5891:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5892:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5893:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5894:          ///// XXXX CHECK INDICES!!!!!
 5895:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5896:       } // 2D/3D
 5897: 
 5898:    }
 5899: } // extern "C"
 5900: 
 5901: 
 5902: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5903: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5904: 
 5905:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5906: 
 5907:    const int kb  = elem->kb;
 5908:    const int kb2 = elem2->kb;
 5909: 
 5910:    // z-coordinate of prism of elem
 5911:    const double zp = elem->z_prism(k);
 5912: 
 5913:    double rho = 0.0;
 5914: 
 5915:    if (elem2->is2D()) {
 5916:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5917: 
 5918:    } else {  // 3D
 5919: 
 5920:       // eta_min may be < zmax
 5921:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5922:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5923: 
 5924:       // (Extrapolate density below bottom, we will fix it later)
 5925:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5926:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5927:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5928:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5929:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5930:    } // 2D/3D
 5931:      
 5932: 
 5933:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5934:    // Now we need to fix it.
 5935:    if (elem->z[k] < elem2->z[kb2]) {
 5936:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5937: 
 5938:       // There are two methods to adjust the density at the bottom of the element.
 5939:       // iunder_deep=0: 
 5940:       const double depth1 = abs(elem->z[kb]); // larger depth
 5941: 
 5942:       if (iunder_deep==0) {
 5943: 
 5944:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5945: 
 5946:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5947: 
 5948:       } else { // iunder_deep != 0
 5949: 
 5950:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5951: 
 5952:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5953: 
 5954:          //   Demeaned density at the same z coordinate as
 5955:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5956:          }
 5957: 
 5958:       } // if iunder_deep
 5959:    } // if elem->z[kb] < elem2->z[kb]
 5960: 
 5961:    return rho;
 5962: }
 5963: 
 5964: 
 5965: extern "C" {
 5966:    __global__ void computeDensityGradient(void) {
 5967: 
 5968:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 5969:       if constexpr(ibc != 0) return;
 5970: 
 5971:          // Compute the horizontal density gradient at each element.
 5972:       // It works in two steps:
 5973:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5974:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5975:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5976:       //             gradRho.r1 = rho1 - rho0
 5977:       //             gradRho.r2 = rho2 - rho0
 5978:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5979:       // 
 5980:       //  NOTE: We use de-meaned densities.
 5981: 
 5982:       ELEM(elem);
 5983: 
 5984:       if (elem->isDry) return;
 5985: 
 5986:       const int kb  = elem->kb;
 5987:       const int i34 = elem->i34;
 5988: 
 5989:       for (int k = kb + 1; k < nvrt; k++) {
 5990:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5991:          //             gradRho.r1 = rho1 - rho0
 5992:          //             gradRho.r2 = rho2 - rho0
 5993:          int icount = 0;
 5994:          double sumRx = 0.0;
 5995:          double sumRy = 0.0;
 5996:          for (int j1=0; j1<i34; j1++) { 
 5997: 
 5998:             const int j2 = elem->nxq(j1 + 1);
 5999: 
 6000:             // Pairs of consecutive neighbor elements of elem
 6001:             const Element *e1 = elem->nghbElems[j1];
 6002:             const Element *e2 = elem->nghbElems[j2];
 6003: 
 6004:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6005:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6006:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6007: 
 6008:             // Compute the density difference and the vector from elem to e1 and e2
 6009:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6010:             double diffRho1, diffRho2;
 6011:             Vector2 vec1, vec2;
 6012:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6013:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6014: 
 6015:             const double rl1 = length(vec1);
 6016:             const double rl2 = length(vec2);
 6017:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6018: 
 6019:             const double delta = cross(vec1, vec2);
 6020:             const double sintheta = abs(delta)/(rl1*rl2);
 6021: 
 6022:             // To avoid problems, avoid elements with small angle between vectors
 6023:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6024:             const bool validEq = (sintheta > sin_one_deg);
 6025: 
 6026:             if (validEq) {
 6027:                // Solve the system of equations to get the density gradient at elem
 6028:                icount++;
 6029:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6030:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6031:                sumRx += Rx;
 6032:                sumRy += Ry;
 6033:             }
 6034:          } // for j1
 6035: 
 6036:          // Compute the average density gradient at elem
 6037:          if (icount==0) {
 6038:            // Bad mesh quality; bail out with 0 b-cc
 6039:            elem->gradRho[k] = {0.0, 0.0};
 6040:          } else {
 6041:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6042:          }
 6043: 
 6044:       } // for k
 6045: 
 6046:    }
 6047: 
 6048:    __global__ void computeBaroclinicTerm(void) {
 6049:    // Computes the baroclinic term at sides (at half levels).
 6050:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6051:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6052: 
 6053:       if (ibc == 1) return;
 6054: 
 6055:       SIDE(side);
 6056: 
 6057:       if (side->isDry) return;
 6058: 
 6059:       const Element *e1 = side->elems[0];
 6060:       const Element *e2 = side->elems[1]; 
 6061:       const int kb = side->kb;
 6062:       
 6063:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6064: 
 6065:       // interpolates vertically the density gradient of the two elements at the half level/
 6066: 
 6067:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6068:       int k2 = max(kb, nvrt / 2);
 6069: 
 6070:       // Starts the integration at the surface and goes down to the bottom
 6071:       side->bcc[nvrt-1] = {0.0, 0.0};
 6072:       for (int k = nvrt - 2; k >= kb; k--) {
 6073:       // For each prism level (from surface to bottom)...
 6074: 
 6075:          // For both elements, interpolate density gradient at the side's half level.
 6076:          // The gradient at the side is the average of the gradients at the elements.
 6077:          // w1, w2 are used to take into account boundary sides, with just one element.
 6078:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6079:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6080:          const double wsum = w1 + w2;
 6081:          w1 = w1/wsum;
 6082:          w2 = w2/wsum;
 6083:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6084: 
 6085:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6086:          Vector2 gradRho = {0.0, 0.0};
 6087:          if (e1 != nullptr && k > kb) {
 6088:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6089:             
 6090:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6091:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6092:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6093: 
 6094:             // Grad(rho) vertically interpolated at the side's half level
 6095:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6096: 
 6097:             // Projects the element density gradient to the side frame if needed.
 6098:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6099: 
 6100:             // Adds the contribution of the density gradient at the side's half level
 6101:             gradRho += gradRho1*w1;
 6102:          }      
 6103:          if (e2 != nullptr && k > kb) {
 6104:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6105:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6106:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6107:             
 6108:             // Grad(rho) vertically interpolated at the side's half level
 6109:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6110: 
 6111:             // Projects the element density gradient to the side frame if needed.
 6112:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6113: 
 6114:             // Adds the contribution of the density gradient at the side's half level
 6115:             gradRho += gradRho2*w2;
 6116:          }
 6117: 
 6118:          
 6119:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6120:          // multiplied by -rampbc*(g/rho0) 
 6121:          const double grav3 = side->grav3();
 6122:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6123: 
 6124:       } // for
 6125: 
 6126:    }
 6127: 
 6128: 
 6129: 
 6130:    __global__ void computeHorGradientAtSide(void) {
 6131: 
 6132:       // Compute the horizontal density gradient at each element.
 6133:       // It works in two steps:
 6134:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6135:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6136:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6137:       //             gradRho.r1 = rho1 - rho0
 6138:       //             gradRho.r2 = rho2 - rho0
 6139:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6140:       // 
 6141:       //  NOTE: We use de-meaned densities.
 6142: 
 6143:       SIDE(side);
 6144: 
 6145: 
 6146:       if (side->isDry) return;
 6147: 
 6148:       // Computes the gradient of the variables at the side center.
 6149:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6150:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6151:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6152: 
 6153:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6154:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6155:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6156:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6157: 
 6158:    }
 6159: 
 6160: 
 6161:    __global__ void solveMomentumEquations(double time) {
 6162: 
 6163:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6164:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6165: 
 6166:       SIDE(side);
 6167: 
 6168:       if (side->isDry) 
 6169:       {
 6170:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6171: 
 6172:          return;
 6173:       }
 6174: 
 6175:       const Node *n1 = side->n1;
 6176:       const Node *n2 = side->n2;
 6177: 
 6178:       const int kb = side->kb;
 6179: 
 6180:       const double veg_h = side->veg_h();
 6181:       const double grav3 = side->grav3();
 6182: 
 6183:       if (side->is2D()) {
 6184:          // Remember: Do not use htot2, which is updated.
 6185:          const double htot = side->htot1();
 6186:          const double hhat = side->hhat;
 6187: 
 6188:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6189: 
 6190:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6191:          const Vector2 tau2 = side->tau();
 6192: 
 6193:          // hat_gam has units of m/s
 6194: 
 6195:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6196:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6197:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6198: 
 6199:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6200: 
 6201: 
 6202:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6203: 
 6204:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6205: 
 6206:       }
 6207:       else { // 3D
 6208: 
 6209:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6210:          // 
 6211:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6212:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6213:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6214:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6215:          // k+1 and k.
 6216: 
 6217: 
 6218:          const int ndim = nvrt - kb;
 6219:          const double zTopCanopy = side->zTopCanopy();
 6220: 
 6221:          // Initialize the tridiagonal system
 6222:          for (int k = kb + 1; k < nvrt; k++) {
 6223:             
 6224:             const int kin = k - (kb + 1);
 6225: 
 6226:             // Vertical viscosity at the face center
 6227:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6228: 
 6229:  
 6230:             alow[kin] = 0.0;
 6231:             cupp[kin] = 0.0;
 6232:             bdia[kin] = 0.0;
 6233: 
 6234:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6235:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6236: 
 6237:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6238:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6239:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6240: 
 6241:             // First part: layers k, k+1
 6242:             if (k < nvrt - 1) {
 6243:                              
 6244:                if constexpr(iveg != 0) {
 6245: 
 6246:                   // If there is vegetation at this level...
 6247:                   if (zTopCanopy > side->zc[k]) {
 6248:                      // If the canopy is above the k layer...
 6249:                      
 6250:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6251:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6252:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6253:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6254: 
 6255:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6256:                      const double vmag2 = length(ut2);
 6257:                      const double vmag1 = length(side->u2[k]);
 6258:                      const double vmag = 0.5*(vmag1 + vmag2);
 6259:                      
 6260:                      // Computes the vegetation alpha at the face center
 6261:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6262: 
 6263:                      cff1 += veg_alpha_sd*dt*vmag;
 6264: 
 6265:                   } // if (zTopCanopy
 6266:                } // if iveg
 6267: 
 6268:                const double dzz = side->Dz(k + 1);
 6269:                const double tmp = dt*dfz/dzz;
 6270:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6271: 
 6272:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6273:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6274:             }
 6275: 
 6276: 
 6277:             // Second part: layers k-1, k
 6278:             if (k > kb + 1) {
 6279: 
 6280:                double cff1 = 1.0; //init \bar{c^k}
 6281: 
 6282:                if constexpr(iveg != 0) {
 6283:                   // If there is vegetation at this level...
 6284:                   if (zTopCanopy > side->zc[k-1]) {
 6285:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6286:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6287: 
 6288:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6289: 
 6290:                      const double vmag2 = length(ut2);
 6291:                      const double vmag1 = length(side->u2[k-1]);
 6292:                      const double vmag = 0.5*(vmag1 + vmag2);
 6293: 
 6294:                      // Computes the vegetation alpha at the face center
 6295:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6296:                      cff1 += veg_alpha_sd*dt*vmag;
 6297:                   } // if zTopCanopy
 6298: 
 6299:                } // if iveg
 6300: 
 6301:                const double dzz = side->Dz(k);
 6302:                const double tmp = dt*dfz/dzz;
 6303:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6304: 
 6305:                alow[kin] += cff1*dzz/6.0 - tmp;
 6306:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6307: 
 6308:             } else { // Bottom boundary
 6309:                // This occurs at the bottom, where the bottom drag is applied.
 6310: 
 6311:                bdia[kin] += dt*side->chi2; // XXXX
 6312: 
 6313:             } // if (k > kb + 1)
 6314: 
 6315: 
 6316:          } // for (int k
 6317: 
 6318: 
 6319: 
 6320:          // Computes the RHS.
 6321:          // -----------------
 6322: 
 6323:          //	BC to be imposed at the end.
 6324: 
 6325:          const Vector2 gradETP  = side->gradETP;
 6326:          const Vector2 gradPr   = side->gradPr;
 6327:          const Vector2 gradEta1 = side->gradEta1;
 6328:          const Vector2 gradEta2 = side->gradEta2;
 6329: 
 6330:          const Vector2 *btu = side->btu;
 6331:          const Vector2 *u2  = side->u2;
 6332:          const double coriolis = side->coriolis;
 6333:          const Vector2 *nuGradU = side->nuGradU;
 6334: 
 6335:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6336:          for (int k = kb + 1; k < nvrt; k++) {
 6337:             const int kin = k - kb - 1;
 6338: 
 6339:             const double dz_0 = side->Dz(k);
 6340:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6341: 
 6342:             rrhs[kin] = {0.0, 0.0};
 6343:             double dz = 0.0;
 6344: 
 6345:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6346:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6347:             if (k < nvrt  ) dz += dz_1;
 6348:             if (k > kb + 1) dz += dz_0;
 6349: 
 6350:             // Elevation gradient, atmospheric pressure and tidal potential
 6351:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6352: 
 6353:             // Coriolis, advection, wind stress, and horizontal viscosity
 6354:             if (k < nvrt - 1) {
 6355: 
 6356: 
 6357:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6358:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6359:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6360:                                                 
 6361: 
 6362:                //diff stress tensors 1006
 6363:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6364:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6365:                   assert(false && "Not implemented: itur == 5");
 6366:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6367:                }
 6368:                // else assert(false && "itur # Not implemented");
 6369: 
 6370:             } else { // k == nvrt - 1 SURFACE
 6371:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6372:                const Vector2 tau2 = side->tau();
 6373: 
 6374:                rrhs[kin] += dt*tau2;          
 6375: 
 6376:             } // if k<nvrt
 6377: 
 6378: 
 6379:             if (k > kb + 1) {
 6380:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6381:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6382:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6383: 
 6384:                // diff stress tensors 1006
 6385:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6386:                   assert(false && "Not implemented: itur == 5");
 6387:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6388:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6389:                }
 6390:                // else assert(false && "itur # Not implemented");
 6391: 
 6392: 
 6393:             } // if k>kbs + 1
 6394: 
 6395:             // Baroclinic
 6396:             Vector2 *bcc = side->bcc;
 6397:             if constexpr(ibc == 0) {
 6398:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6399:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6400: 
 6401:             } // if ibc==0
 6402: 
 6403:          } // k=kb + 1,nvrt
 6404: 
 6405: 
 6406:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6407: 
 6408:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6409:             const int kin = k - kb - 1;
 6410:    
 6411:             // Velocity is always clamped to maximum values
 6412:             side->u2[k] = clampVelocity(soln[kin]);
 6413:          } // k
 6414: 
 6415:       } // if side->is2D()
 6416:       
 6417: 
 6418:       // Impose velocity boundary condition at the bottom
 6419:       if constexpr(imm == 2) { // 3D bed deformation model
 6420:          double dep;
 6421:          Vector2 vel;
 6422: 
 6423:          assert(false && "Not implemented: imm == 2");
 6424:          //update_bdef(time, x0, y0, dep, vel);
 6425:          // side->u2[kb] = vel;
 6426: 
 6427:       } else { // imm = 0 or 1
 6428:          if (side->Cd() == 0.0) {
 6429:             side->u2[kb] = side->u2[kb + 1];
 6430: 
 6431:          } else if (side->is3D()) { // 3D no slip bottom   
 6432:             side->u2[kb] = {0.0, 0.0};
 6433: 
 6434:          }
 6435:           
 6436:       } // if imm
 6437: 
 6438:       // The velocities below the bottom level are set to zero
 6439:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6440: 
 6441: 
 6442:    }
 6443: 
 6444: 
 6445:    __global__ void applyMomentumBC(void) {
 6446: 
 6447:       SIDE_BND(sideBnd);
 6448: 
 6449:       Side *side = sideBnd->side;
 6450:       const BoundarySegment *segment = sideBnd->segment;
 6451:       const Node *n1 = side->n1;
 6452:       const Node *n2 = side->n2;
 6453: 
 6454:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6455: 
 6456:       const bool isLand = segment->isLand;
 6457:       const int ifltype = segment->ifltype;
 6458: 
 6459:       const int kb = side->kb;
 6460: 
 6461: 
 6462:       if (!isLand && ifltype != 0) {
 6463:          const Vector2 *ubc = sideBnd->ubc;
 6464:   
 6465:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6466:             
 6467:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6468:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6469: 
 6470:             if (ifltype == -1) {
 6471:                // Flather 1
 6472: 
 6473:                const double depth = side->depth();
 6474: 
 6475:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6476: 
 6477:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6478: 
 6479:                side->u2[k] = vnorm*side->n;
 6480: 
 6481:             } else if (ifltype == -2) { // Discharge
 6482: 
 6483:                const double eta1 = side->eta1();
 6484:                const double eta2 = side->eta2();
 6485:                const double htot = side->htot2();
 6486: 
 6487:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6488:                assert(false && "Not implemented: Discharge bc");
 6489:                // const double dischrg = discharge(eta1);
 6490:                const double dischrg = 0.0; // XXX REMOVE
 6491:                
 6492: 
 6493:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6494: 
 6495:                const double vnorm = dischrg*eta2/htot;
 6496: 
 6497:                side->u2[k] = vnorm*side->n;
 6498: 
 6499:             }
 6500:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6501:                const double vnorm = dot(side->u2[k], side->n);
 6502: 
 6503:                double rat;
 6504:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6505:                else              rat = segment->vobc2; // outgoing
 6506: 
 6507:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6508: 
 6509:             }
 6510:             else { // not Flather or 3D radiation
 6511:                side->u2[k] = ubc[k];
 6512: 
 6513:             } // if (segment->ifltype...
 6514: 
 6515:          }
 6516: 
 6517:       }
 6518:       else if (isLand) { // if it is land boundary side
 6519: 
 6520:          if constexpr(islip == 0) { // free slip
 6521: 
 6522:             for (int k = kb; k < nvrt; k++) {
 6523: 
 6524:                const Vector2 t = side->t();
 6525:                const Vector2 n = side->n;
 6526: 
 6527:                double vnorm = 0.0; // for most cases
 6528:                const double vtan = dot(side->u2[k], t);
 6529:                
 6530:                side->u2[k] = vtan*t - vnorm*n;
 6531: 
 6532:             }
 6533: 
 6534:          } else { // no slip
 6535:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6536: 
 6537:          }
 6538:       } // if (side segment type...
 6539: 
 6540:    }
 6541: 
 6542: 
 6543:    __global__ void shapiroFilter1(void) {
 6544:       // First step of the Shapiro filter (normally used if indvel<=0)
 6545:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6546: 
 6547:       SIDE(side);
 6548: 
 6549:       // Only internal wet sides are processed
 6550:       if (side->isDry || !(side->isInternal())) return;
 6551: 
 6552:       const int kb = side->kb;
 6553: 
 6554:       for (int mm = 0; mm < niter_shap; mm++) {
 6555: 
 6556:          for (int k = kb + 1; k < nvrt; k++) {
 6557:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6558:             Vector2 suru = {0.0, 0.0};
 6559: 
 6560:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6561: 
 6562:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6563: 
 6564:                int kin = k;
 6565:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6566:                
 6567:                // Get the velocity at the neighbor's side.
 6568:                Vector2 nSideU2 = nSide->u2[kin];
 6569: 
 6570:                // Projects the velocity to the current side frame if needed.
 6571:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6572: 
 6573:                suru += nSideU2;
 6574:             }
 6575: 
 6576:             // Reusing bcc as a temporary array to store the suru values.
 6577:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6578: 
 6579:          }
 6580:       }
 6581:    }
 6582: 
 6583:    __global__ void shapiroFilter2(void) {
 6584:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6585: 
 6586:       SIDE(side);
 6587: 
 6588: 
 6589:       if (side->isDry || !(side->isInternal())) return;
 6590: 
 6591:       const int kb = side->kb;
 6592: 
 6593:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6594: 
 6595:       if (side->is2D()) {
 6596:          side->u2[kb + 1] = side->bcc[kb + 1];
 6597:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6598: 
 6599:       } else {
 6600:          // 3D
 6601:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6602:          
 6603:       }
 6604: 
 6605:    }
 6606: 
 6607: 
 6608:    __global__ void ul0UpdateZCoords(void) {
 6609:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6610:       
 6611:       NODE(node);      
 6612: 
 6613: 
 6614:       if (false) { //node->isDry) { XXXXXXX
 6615: 
 6616:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6617: 
 6618:          if constexpr(ivcor != 1) node->kb = 0;
 6619: 
 6620:       } else {
 6621: 
 6622:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6623:          node->updateKb();
 6624: 
 6625:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6626: 
 6627:       }
 6628: 
 6629:       // We use the temp.b field to store the previous state of isDry.
 6630:       node->tmp.b = node->isDry;
 6631: 
 6632:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6633:       node->isDry = true;
 6634: 
 6635:    }
 6636: 
 6637:    __global__ void ul0ComputeDryElements(void)
 6638:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6639:    {
 6640:       ELEM(elem);
 6641: 
 6642:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6643: 
 6644:       elem->kb = 0;
 6645: 
 6646:       if (elem->isDry) return;
 6647: 
 6648: 
 6649:    //    if(elem->isDry2()) { // XXXX
 6650:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6651:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6652:    //        call parallel_abort(errmsg)
 6653:    //    }
 6654: 
 6655:       const Node *n1 = elem->nodes[0];
 6656:       const Node *n2 = elem->nodes[1];
 6657:       const Node *n3 = elem->nodes[2];  
 6658:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6659: 
 6660:       // Computes element's kb as the minimum of the nodes' kb.
 6661:       const int kb1 = n1->kb;
 6662:       const int kb2 = n2->kb;
 6663:       const int kb3 = n3->kb;
 6664:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6665: 
 6666: 
 6667:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6668: 
 6669: 
 6670:       // Computes the element z as the mean of the nodes z.
 6671:       for (int k = elem->kb; k < nvrt; k++) {
 6672: 
 6673:          // Compute the element z as the mean of the nodes z.
 6674:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6675:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6676:          elem->z[k] /= elem->i34;
 6677: 
 6678:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6679:       }
 6680:                   
 6681:    }
 6682: 
 6683:    __global__ void ul0ComputeDryNodes(void)
 6684:    // Updates node's isDry based on the elements' isDry. 
 6685:    {
 6686:       NODE(node);
 6687: 
 6688:       node->isDry = true;
 6689: 
 6690:       // A node is wet if at least one of the elements sharing it is wet.
 6691:       for (int j = 0; j < node->numElements; j++) {
 6692:          const Element *elem = node->elements[j];
 6693:          if (!elem->isDry) {
 6694:             node->isDry = false;
 6695:             break;
 6696:          }
 6697:       }
 6698: 
 6699:        
 6700:    }
 6701: 
 6702: 
 6703:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6704:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6705:    // node->tmp.b is true if the node was previously dry.
 6706:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6707:    {
 6708:       NODE(node);
 6709:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6710: 
 6711:       // Avoid this the first time step.
 6712:       if (it == iths) return;  
 6713: 
 6714:       const bool wasDry = node->tmp.b;
 6715: 
 6716: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6717: 
 6718:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6719: 
 6720:          for (int k=0; k < nvrt; k++) {
 6721: 
 6722:             Vector3 utmp={0.0, 0.0, 0.0};
 6723: 
 6724:             double ttmp=0.0;
 6725:             double stmp=0.0;
 6726:             int icount=0;
 6727:             for (int j = 0; j < node->numNodes; j++) {
 6728: 
 6729:                const Node *nbrNode = node->nodes[j];
 6730:                
 6731:                const bool wasNbrDry = nbrNode->tmp.b;
 6732: 
 6733:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6734:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6735: 
 6736:                   icount++;
 6737: 
 6738:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6739:                   utmp += nbrNode->uvw2(k);
 6740:                   
 6741:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6742:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6743:                }
 6744:             }
 6745: 
 6746:             if (icount > 0) {
 6747:                const double inv_icount = 1.0/icount;
 6748:                utmp = inv_icount*utmp;
 6749:                node->u2[k]     = {utmp.x, utmp.y};
 6750:                node->w2[k]     = utmp.z;
 6751:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6752:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6753:             } else {
 6754:                node->u2[k] = {0.0, 0.0};
 6755:                node->w2[k] = 0.0;
 6756:                // Initialize tracers to 0.0??? XXXXX
 6757:             }
 6758:          }
 6759:       }
 6760:    }
 6761: 
 6762:   
 6763:    
 6764: 
 6765: 
 6766:    __global__ void ul0UpdateSides(int it, int iths) {
 6767:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6768:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6769:    // The dryness of the sides is updated in ul0UpdateSides2.
 6770: 
 6771:       SIDE(side);
 6772: 
 6773:       // A side is wet if and only if at least one of its elements is wet.
 6774:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6775:  
 6776:       const Node *n1 = side->n1;
 6777:       const Node *n2 = side->n2;
 6778:      
 6779:       const int kb1 = n1->kb;
 6780:       const int kb2 = n2->kb;
 6781: 
 6782:       side->kb = 0; // default when dry
 6783: 
 6784:       if (isWet) {
 6785: 
 6786:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6787: 
 6788:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6789: 
 6790:          side->kb = min(kb1, kb2);
 6791: 
 6792:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6793: 
 6794:          for (int k = side->kb; k < nvrt; k++) {
 6795:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6796: 
 6797:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6798: 
 6799:             // Compute velocity for re-wetted sides 
 6800:             if ((it != iths) && (side->isDry && isWet)) {
 6801: 
 6802:                Vector2 utmp={0.0, 0.0};
 6803: 
 6804:                int icount=0;
 6805: 
 6806:                // For all the sides on the two elements that share this side
 6807:                for (int j = 0; j < 2; j++) {
 6808:                   const Element *elem = side->elems[j];
 6809:                   if (elem == nullptr) continue;
 6810: 
 6811:                   for (int jj=0; jj < elem->i34; jj++) {
 6812:                      const Side *nSide = elem->sides[jj];
 6813:                      if (nSide->isDry) continue;
 6814: 
 6815:                      icount++;
 6816:                      utmp += nSide->u2[k];  
 6817:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6818:                   }
 6819:                }
 6820:                   
 6821:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6822:                if (icount > 0)  side->u2[k] = utmp/icount;
 6823:                else             side->u2[k] = {0.0, 0.0};
 6824:                   
 6825:             } // if ((it != iths) && (side->isDry && isWet))
 6826: 
 6827:          } // for k
 6828: 
 6829:       } // if isWet 
 6830:       
 6831: 
 6832: 
 6833:    }
 6834: 
 6835:    __global__ void ul0UpdateSides2(void) {
 6836:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6837:    
 6838:          SIDE(side);
 6839:    
 6840:          const Element *e1 = side->elems[0];
 6841:          const Element *e2 = side->elems[1];
 6842: 
 6843:          // A side is wet if and only if at least one of its elements is wet.
 6844:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6845: 
 6846:          // Update the side's dryness
 6847:          side->isDry = !isWet;
 6848: 
 6849:    }
 6850: 
 6851: 
 6852:    __global__ void zeroNodalVelocities(void) {
 6853:       NODE(node);
 6854: 
 6855:       for (int k = 0; k < nvrt; k++) {
 6856:          node->u2[k]   = {0.0, 0.0};
 6857:          node->w2[k]   = 0.0;
 6858:          node->utmp[k] = {0.0, 0.0};         
 6859:       }
 6860:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6861:    }
 6862:  
 6863: 
 6864:    __global__ void computeNodalVerticalVelocities1(void) {
 6865:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6866:    // Adds the element's vertical velocity times the element's area.
 6867:       ELEM(elem);
 6868: 
 6869:       for (int j = 0; j < elem->i34; j++) {
 6870:          Node *node = elem->nodes[j];
 6871: 
 6872:          for (int k = node->kb; k < nvrt; k++) {
 6873:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6874:          }
 6875:          atomicAdd(&(node->tmp.d), elem->area);
 6876:       }
 6877:    }
 6878: 
 6879:    __global__ void computeNodalVerticalVelocities2(void) {
 6880:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6881:    // Divides by the total area of the elements sharing the    node.
 6882:       NODE(node);
 6883: 
 6884: 
 6885:       const double invArea = 1.0 / node->tmp.d;
 6886:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6887: 
 6888:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6889:    }
 6890: 
 6891: 
 6892:    __global__ void computeNodalHorizontalVelocities1(void) {
 6893: 
 6894:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6895: 
 6896:       ELEM(elem);
 6897: 
 6898:       if (elem->isDry) return;
 6899: 
 6900:       const int kb = elem->kb;
 6901:       const bool isTri = elem->isTri();
 6902: 
 6903:       if constexpr(indvel <= 0) {
 6904:          // Assuming discontinous hvel.
 6905: 
 6906:          if (isTri) { // For triangles
 6907:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6908:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6909:             #pragma unroll
 6910:             for (int j = 0; j < 3; j++) {
 6911:                // For every node of the triangle...
 6912:                Node *node = elem->nodes[j];
 6913: 
 6914:                if (node->isDry) continue;
 6915: 
 6916:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6917:                const Side *s2 = elem->sides[(j + 1) % 3];
 6918:                const Side *s3 = elem->sides[(j + 2) % 3];
 6919: 
 6920:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6921: 
 6922:                atomicAdd(&(node->tmp.i), 1);
 6923: 
 6924:                for (int k = kb; k < nvrt; k++)  {
 6925:                   Vector2 s1u2 = s1->u2[k];
 6926:                   Vector2 s2u2 = s2->u2[k];
 6927:                   Vector2 s3u2 = s3->u2[k];
 6928: 
 6929:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6930:                   if constexpr(ics == 2) {
 6931:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6932:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6933:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6934:                   }
 6935: 
 6936:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 6937:                   u = clampVelocity(u);
 6938:                   atomicAdd(&(node->utmp[k].x), u.x);
 6939:                   atomicAdd(&(node->utmp[k].y), u.y);
 6940: 
 6941:                }
 6942: 
 6943:             }
 6944:          }
 6945:          else { // For quads
 6946: 
 6947: 
 6948:             // Compute the bilinear coordinates of the center of each diagonal.
 6949:             double xi, eta;
 6950:             double shp13[4], shp24[4];
 6951:             Point2 x0, x1, x2, x3;
 6952:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 6953:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 6954:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 6955: 
 6956:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 6957:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 6958: 
 6959: 
 6960: 
 6961: 
 6962:             for (int k = kb; k < nvrt; k++) {
 6963: 
 6964:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 6965:                Vector2 sideU[4];
 6966:                #pragma unroll
 6967:                for (int j = 0; j < 4; j++) {
 6968:                   Vector2 u = elem->sides[j]->u2[k];
 6969:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 6970:                   sideU[j] = u;
 6971:                }
 6972: 
 6973:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 6974:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 6975: 
 6976:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 6977:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 6978:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 6979:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 6980:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 6981:                #pragma unroll
 6982:                for (int j = 0; j < 4; j++) {
 6983:                   Node *node = elem->nodes[j];
 6984:                   if (node->isDry) continue;
 6985: 
 6986:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 6987:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 6988:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 6989:                }
 6990:             }
 6991: 
 6992:          }
 6993: 
 6994:       }
 6995:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6996:       
 6997:    }
 6998: 
 6999: 
 7000:    __global__ void computeNodalHorizontalVelocities2(void) {
 7001:       NODE(node);
 7002: 
 7003:       const int nodeCount = node->tmp.i;
 7004: 
 7005:       if (nodeCount == 0) 
 7006:       {
 7007:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7008:          return;
 7009:       }
 7010: 
 7011:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7012:       
 7013:       const int kb = node->kb;
 7014: 
 7015:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7016:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7017:       
 7018:       
 7019:    }   
 7020: 
 7021:  
