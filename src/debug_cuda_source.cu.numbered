 5048: extern "C" {
 5049: 
 5050:    __global__ void scaleGravity(double loadtide_coef) {
 5051: 
 5052: 
 5053:       NODE(node);
 5054: 
 5055:       // SAL option: scale gravity
 5056:       if constexpr(iloadtide==2) {  // simple const
 5057:          node->grav2 = grav*(1.0 - loadtide_coef);
 5058: 
 5059:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5060:         
 5061:           const double depth = max(node->depth, 0.0);
 5062:           const double tmp1 = sqrt(depth);
 5063:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5064:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5065:                              2.6969e-13*depth*depth*depth*tmp1;
 5066:           
 5067:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5068:           
 5069: 
 5070: 
 5071:           node->grav2 = grav*(1.0 - beta_bar);
 5072: 
 5073:       } else {  // iloadtide=0,1
 5074:           node->grav2 = grav;
 5075: 
 5076:       }
 5077: 
 5078:    }
 5079: 
