 3864: __device__ __forceinline__ int Node::packedIndex() const {
 3865:    // Returns the packed index of the node
 3866:    // Packed index is the index of the partition-block matrices and vectors.
 3867:    return nodeOffsetPerPartition[part] + localIndex();
 3868: }
