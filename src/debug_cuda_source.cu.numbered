 8559:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8560:          *sizeType = sizeof(double);
 8561:          break;
 8562:       case (int)VarCode::x:
 8563:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8564:          *sizeType = sizeof(Vector2);
 8565:          break;
 8566:       case (int)VarCode::z:
 8567:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8568:          *sizeType = sizeof(double);
 8569:          break;
 8570:       case (int)VarCode::kb:
 8571:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8572:          *sizeType = sizeof(int);
 8573:          break;
 8574:       case (int)VarCode::isdry:
 8575:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8576:          *sizeType = sizeof(int);
 8577:          break;         
 8578:       case (int)VarCode::w:
 8579:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8580:          *sizeType = sizeof(double);
 8581:          break;
 8582:       case (int)VarCode::u:
 8583:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8584:          *sizeType = sizeof(Vector2);
 8585:          break;  
 8586:       case (int)VarCode::u_air:
 8587:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8588:          *sizeType = sizeof(Vector2);
 8589:          break;
 8590:       default:
 8591:          *offset = -1;    
 8592:    }  
 8593:    
 8594: }
