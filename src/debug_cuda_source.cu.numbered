 7778: // #ifdef DEBUG
 7779: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7780: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7781: //                     call parallel_abort(errmsg)
 7782: //                   endif
 7783: // #endif
 7784: 
 7785: //                 enddo !i
 7786: //                 wm=wm/sum1 !final weight
 7787: 
 7788:                 for (int j=0; j<elem->i34; j++) { // side
 7789:                   const Side *side = elem->sides[j];
 7790:                   const Node *node1 = side->n1;
 7791:                   const Node *node2 = side->n2;
 7792: 
 7793:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7794:                     trsd=0.d0
 7795:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7796:                       for (int i=0; i<elem->nweno1; i++) {
 7797:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7798:                       }
 7799:                     enddo //kk
 7800:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7801:                   } // outward flux
 7802:                 } // end for j=1,i34(ie) ! side
 7803:               } // end for k; ntr 
 7804: 
 7805:             else !simple upwind method
 7806:               do j=1,i34(ie)
 7807:                 jsj=elside(j,ie)
 7808:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7809:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7810:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7811:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7812:                   endif
 7813:                 enddo  !vertical layers
 7814:               enddo !j=1,i34(ie) ! side
 7815:             endif !order of accuracy
 7816: 
