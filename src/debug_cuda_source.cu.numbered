  315: // Polynomial class
  316: template<int grade>
  317: struct Polynomial {
  318:     // Static assertion to give a clear error message at compile time
  319:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  320: };
  321: 
  322: 
  323: // Explicit specialization for grade 4
  324: template<>
  325: struct Polynomial<4> {
  326:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  327: 
  328:    // Constructor from coefficients
  329:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  330: 
  331:    __device__ __forceinline__ double eval(double x) const {
  332:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  333:    }
  334: };
  335: 
  336: // ------------------------------------------------------------------------------------------------
  337: 
  338: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  339:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  340:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  341: }
  342: 
  343: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  344:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  345:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  346: }
  347: 
  348: 
  349: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  350:    x3 = y1*z2 - y2*z1;
  351:    y3 = x2*z1 - x1*z2;
  352:    z3 = x1*y2 - x2*y1;
  353: }
  354: 
  355: 
  356: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  357: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  358: 
  359:    const double radius2 = dot(p, p);
  360:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  361:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  362: 
  363:    rlon = atan2(p.y, p.x); // (-pi,pi]
  364: 
  365:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  366:       rlat = asin(p.z/sqrt(radius2));
  367:    } else {
  368:       rlat = asin(p.z/rearth_pole);
  369:    }
  370:   
  371: }
  372: 
  373: __inline__ __device__ void Error(const char* msg) {
  374:    printf("Error: %s\n", msg);
  375:    assert(false);
  376: }
