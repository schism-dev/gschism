 8022: 
 8023: __global__ void computeMatrixProductAndDotProducts() {
 8024:    // Computes A*p, r'Mr and p'Ap
 8025: 
 8026:    // 1) shared buffer: first half for rMr, second for pAp
 8027:    __shared__ double sdata[2*BLOCK_SIZE];
 8028:    double* s_rMr = sdata;
 8029:    double* s_pAp = sdata + BLOCK_SIZE;
 8030: 
 8031:    const int tid = threadIdx.x;
 8032: 
 8033:    double l_pAp = 0.0;
 8034: 
 8035:    s_rMr[tid] = 0.0;
 8036:    s_pAp[tid] = 0.0;
 8037: 
 8038:    // 2) get your node pointer
 8039:    // NODE(node);   
 8040:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8041:    Node *node = &(mesh->localNodeData[idx_node]); 
 8042:    if (idx_node < mesh->np) {
 8043: 
 8044: 
 8045:    const double diag = node->coeffDiag;
 8046:    const double r    = node->mR;
 8047:    const double p    = node->mP;  
 8048: 
 8049:    // apply preconditioner on the fly:
 8050:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8051: 
 8052:    // 4) compute Ap = A.p
 8053:    double Ap = node->coeffDiag * node->mP;
 8054:    for (int j = 0; j < node->numNodes; ++j) {
 8055:       const Node *nbNode = node->nodes[j];
 8056:       Ap += node->coeffMatrix[j] * nbNode->mP;
 8057: 
 8058:    }
 8059: 
 8060:    node->mAp = Ap;
 8061:     
 8062: 
 8063:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 8064:    // const double l_rMr = r*Mr;  // r'Mr
 8065:    l_pAp = p*Ap;  // p'Ap
 8066: 
 8067: 
 8068:    }
 8069: 
 8070:    // 6) write into shared mem
 8071:    // s_rMr[tid] = l_rMr;
 8072:    s_pAp[tid] = l_pAp;
 8073: 
 8074:    __syncthreads();
 8075: 
 8076:    // 7) block-wide tree reduction
 8077:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8078:       if (tid < stride)  {
 8079:          s_pAp[tid] += s_pAp[tid + stride];
 8080:       }
 8081:       __syncthreads();
 8082:    }
 8083: 
 8084:    // 8) thread 0 atomically accumulates into the globals
 8085:    // XXX: This is slower than it needs to be, but it is simple and works
 8086:    if (tid == 0) {
 8087:       atomicAdd(pAp, s_pAp[0]);
 8088:    }
 8089: 
 8090: 
 8091: }
 8092: 
 8093: 
 8094: __global__ void updateSolutionAndDotProducts(void) {
 8095:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8096: 
 8097:    const int tid = threadIdx.x;
 8098: 
 8099:    s_rMr[tid] = 0.0;
 8100: 
 8101:    // get node & bounds-check:
 8102:    NODE(node);
 8103: 
 8104:    
 8105:    // Compute alpha
 8106:    const double alpha = (*rMr_old)/(*pAp);
 8107: 
 8108:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8109: 
 8110: 
 8111:    // load scalars
 8112:    const double diag = node->coeffDiag;
 8113:    const double p    = node->mP;
 8114:    const double Ap   = node->mAp;
 8115:    const double x    = node->mX;
 8116:    const double r    = node->mR;
 8117:    
 8118:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8119: 
 8120:    // 1) update solution & residual
 8121:    const double x_new = x + alpha*p;
 8122:    const double r_new = r - alpha*Ap;
 8123:    node->mX = x_new;
 8124:    node->mR = r_new;
 8125: 
 8126:    // 2) apply Jacobi preconditioner on the fly
 8127:    const double Mr_new = r_new/diag;
 8128: 
 8129: 
 8130:    // 3) local contributions for the two dot-products
 8131:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8132: 
 8133:    // 4) write into shared-mem
 8134:    s_rMr[tid] = l_rMr;
 8135: 
 8136:    __syncthreads();
 8137: 
 8138: 
 8139:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8140:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8141:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8142:       __syncthreads();
 8143:    }
 8144: 
 8145:    // 6) thread 0 atomically folds into the global accumulators
 8146:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8147: 
 8148: 
 8149: }
 8150: 
 8151: 
 8152: __global__ void updateSearchDirection() {
 8153: 
 8154:     NODE(node);
 8155: 
 8156:     // recompute z on-the-fly
 8157:     const double z = node->mR / node->coeffDiag;
 8158:     const double p = node->mP;
 8159: 
 8160:     const double beta = (*rMr_new)/(*rMr_old);
 8161: 
 8162: 
 8163:     // p =z + beta*p
 8164:     node->mP = z + beta*p;
 8165: 
 8166: }
 8167: 
 8168: __global__ void initializeScalars(double *scalars) {
 8169: 
 8170:    // These point to a cupy array in the host code
 8171:    rMr_old = scalars + 0;
 8172:    rMr_new = scalars + 1;
 8173:    pAp     = scalars + 2;
 8174: }
 8175: 
 8176: __global__ void initializePreconditionedResidual(void) {
 8177: 
 8178:     __shared__ double s_rMr[BLOCK_SIZE];  
 8179: 
 8180:     s_rMr[threadIdx.x] = 0.0;
 8181: 
 8182:     NODE_ALL(node, valid);
 8183:     const int tid = threadIdx.x;
 8184:     // For the first iteration:
 8185:     // 1. Initial solution x = 0 (already set)
 8186:     // 2. Initial residual r = b (stored in qel)
 8187:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8188: 
 8189: // XXX we should use the guess solution here    
 8190: 
 8191:     double l_rMr = 0.0;
 8192:     if (valid) {
 8193:       // Set initial residual r = b (from qel)
 8194:       node->mR = node->qel;
 8195: 
 8196:       // Compute z = M^-1 * r (preconditioned residual)
 8197:       const double z = node->mR / node->coeffDiag;
 8198: 
 8199:       // Set initial search direction p = z
 8200:       node->mP = z;
 8201: 
 8202:       // Initialize other variables needed for CG
 8203:       node->mX = 0.0;  // Initial solution
 8204:       node->mAp = 0.0; // Will be computed in first iteration
 8205: 
 8206: 
 8207:       // Computes the first r'Mr (reduction)
 8208:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8209:     }
 8210:     // 4) write into shared-mem
 8211:     s_rMr[tid] = l_rMr;
 8212: 
 8213:     __syncthreads();
 8214: 
 8215: 
 8216:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8217:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8218:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8219:         __syncthreads();
 8220:     }
 8221: 
 8222:     // 6) thread 0 atomically folds into the global accumulators
 8223:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8224: 
 8225:     *rMr_old = 0.0;
 8226:     *pAp = 0.0;
 8227: }
 8228: 
 8229: 
 8230: 
 8231: 
 8232: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 8233:    // Get the value of a variable from an element
 8234:    // varName is the name of the variable to get
 8235:    // var is the array to store the value
 8236:    // k is the vertical level index of the variable to get
 8237: 
 8238:    ELEM(elem);
 8239:    
 8240:    int idx = elem->idx;
 8241:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8242: 
 8243:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8244:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 8245:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 8246:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 8247:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 8248:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 8249:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 8250:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 8251:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 8252:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 8253:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 8254:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 8255:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 8256:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 8257:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8258:       
 8259:    
 8260: }
 8261: 
 8262: 
 8263: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8264:    // Get the value of a variable from an node
 8265:    // varName is the name of the variable to get
 8266:    // var is the array to store the value
 8267:    // k is the vertical level index of the variable to get
 8268: 
 8269:    NODE(node);
 8270:    
 8271:    int idx = node->idx;
 8272:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8273: 
 8274:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8275:    
 8276:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8277:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8278:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 8279:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8280:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8281:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8282:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8283:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 8284:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8285:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8286:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 8287:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8288:    
 8289:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8290:       
 8291:    
 8292: }
 8293: 
 8294: 
 8295: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8296:    // Get the value of a variable from an side
 8297:    // varName is the name of the variable to get
 8298:    // var is the array to store the value
 8299:    // k is the vertical level index of the variable to get
 8300:    SIDE(side);
 8301:    
 8302:    int idx = side->idx;
 8303:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8304: 
 8305:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8306:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8307:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8308:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8309:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8310:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8311:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8312:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8313:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8314:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8315:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8316:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8317:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8318:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8319:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8320:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8321:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 8322:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8323:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8324:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8325:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8326:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8327:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8328:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8329:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8330:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8331:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8332:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8333:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8334:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8335:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8336:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8337:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8338:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8339:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8340: }
 8341: 
 8342: 
 8343: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8344:    // Get the value of a variable from an side
 8345:    // varName is the name of the variable to get
 8346:    // var is the array to store the value
 8347:    // k is the vertical level index of the variable to get
 8348:    SIDE_BND(sideBnd);   
 8349: 
 8350:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8351:    if (sideBnd->segment->isLand) idx = -7;
 8352: 
 8353:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8354:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8355: 
 8356: }
