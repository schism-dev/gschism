 1460:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1461:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1462: 
 1463:    BoundarySegment landBoundarySegment;
 1464:    NodeBoundary landBoundaryNode;
 1465: 
 1466:    // Vertical coordinate system
 1467:    // Sigma levels
 1468:    double h_s; 
 1469:    double h_c; 
 1470: 
 1471:    double theta_b;
 1472:    double theta_f, sinh_theta_f;
 1473:    double *sigma_lcl;
 1474:    double *sigma;
 1475:    double *ztot;
 1476:    double *cs;
 1477:    double *dcs;
