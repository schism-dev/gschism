 3776: extern "C" {
 3777:    __global__ void rollUpElevation(void) {
 3778: 
 3779:       NODE(node);
 3780: 
 3781:       node->eta1 = node->eta2;
 3782: 
 3783:    }
 3784: 
 3785: 
 3786:    __global__ void backtrackAllNodes(void) {
 3787: 
 3788:       // max/min # of sub-divisions
 3789:       const int ndelt_max = max(1.0, dt/dtb_min);
 3790:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3791: 
 3792:       // Removed all references to swild98 XXX
 3793:       // swild98=0.d0 !init
 3794: 
 3795: 
 3796:       SIDE(side);
 3797: 
 3798:       const int kb = side->kb;
 3799: 
 3800: 
 3801:       // Initialize btrack velocities to the actual velocities at the side 
 3802:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3803: 
 3804:       if (side->isDry) return;
 3805: 
 3806: 
 3807:       // Checks that at least one element is not dry
 3808:       const Element *elem1 = side->elems[0];
 3809:       const Element *elem2 = side->elems[1];
 3810: 
 3811: 
 3812:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3813:       
 3814:       // XXXXXX
 3815:       // !swild_tmp to store global coord. of the starting side
 3816:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3817:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3818:       // !Use sframe2 
 3819:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3820: 
 3821: 
 3822:       for (int k = kb; k < nvrt; k++) {
 3823:       //  Initialize (xt,yt,zt), nnel and vel.
 3824:       //  For ics=2, the coordinates are in local frames
 3825:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3826: 
 3827: 
 3828:          const int iadvf = side->iadv();  // Advection flag
 3829: 
 3830:          Point3 xt;
 3831:          if constexpr(ics==1) {
 3832:             xt = side->center3D(k); 
 3833:          }
 3834:          else // lat/lon; in side lat/lon frame
 3835:          {
 3836:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3837:          // XXX IMPLEMENT THIS
 3838:       //          xt=0.d0
 3839:       //          yt=0.d0
 3840:       //          !centroid coord. for nudging
 3841:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3842:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3843:          }  // ics
 3844: 
 3845: 
 3846: 
 3847:          // If on land or open boundary...
 3848:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3849:          
 3850:          const double vmag = length(side->u2[k]);
 3851: 
 3852:          if (vmag <= velmin_btrack) {
 3853:             // No activity 
 3854: 
 3855:             side->btu[k] = side->u2[k];
 3856:             
 3857:          } else {  // do btrack
 3858: 
 3859:             // Compute number of sub-divisions based on local gradients 
 3860:             // XXX IS THIS NECESSARY?
 3861:             double suma = 0.0;
 3862:             int icount = 0;
 3863:             for (int ii=0; ii<2; ii++) {
 3864: 
 3865:                const Element *elem = side->elems[ii];
 3866:                  
 3867:                if (elem == nullptr) continue;
 3868: 
 3869:                icount++;
 3870: 
 3871:                // Not strictly along z; in ll frame for ics=2
 3872: 
 3873:                double utmp[4];
 3874:                double vtmp[4];
 3875:                for (int jj = 0; jj < elem->i34; jj++) {
 3876: 
 3877:                   const Node *node = elem->nodes[jj];
 3878: 
 3879:                   if constexpr(ics==1) {
 3880:                      utmp[jj] = node->u2[k].x;
 3881:                      vtmp[jj] = node->u2[k].y;  
 3882:                   } else {
 3883:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3884:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3885:                   }
 3886:                } // for jj
 3887: 
 3888:                const Vector2 grad_u = elem->grad2(utmp); 
 3889:                const Vector2 grad_v = elem->grad2(vtmp);
 3890: 
 3891:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3892:             } // for ii
 3893: 
 3894:             assert(icount > 0 && "Impossible 77");
 3895: 
 3896:             // '4' is somewhat arbitrary
 3897:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3898: 
 3899:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3900:          
 3901: 
 3902:             Vector3 u_int = {0.0, 0.0, 0.0};
 3903: 
 3904:             side->btrack(k, dt, dtbk, u_int);
 3905:             side->btu[k] = toVector2(u_int);
 3906:                
 3907:          } // if vmag (do backtrack)
 3908: 
 3909:       } // for k=kb,nvrt-1
 3910: 
 3911:    }
 3912: 
 3913: } // extern "C"
 3914: 
 3915: template<int nc>
 3916: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3917: 
 3918: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3919: //
 3920: // a,b,c,rhs: input vectors and are not modified by this program.
 3921: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3922: // rhs is the r.h.s.
 3923: // n: actual rank of the system.
 3924: // rows in u() and rhs();
 3925: // u: output with nc columns (transposed to rows)
 3926: // gam: a working array.
 3927: //
 3928: // NOTES:
 3929: // This is a template function that allows for different numbers of columns in the rhs vector.
 3930: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3931: 
 3932:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3933:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3934: 
 3935:    double bet = b[0];
 3936:    if constexpr (nc == 1) {
 3937:       u[0] = rhs[0]/bet;
 3938:    } else {
 3939:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3940:    }
 3941: 
 3942:    for (int j = 1; j < n; j++) {
 3943:       gam[j] = c[j - 1]/bet;
 3944:       bet = b[j] - a[j]*gam[j];
 3945: 
 3946:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3947: 
 3948:       if constexpr (nc == 1) {
 3949:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3950:       } else {
 3951:          for (int l = 0; l < nc; l++) {
 3952:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3953:          }
 3954:       }
 3955:    }
 3956: 
 3957:    // Back-substitution
 3958:    for (int j = n - 2; j >= 0; j--) {
 3959:       if constexpr (nc == 1) {
 3960:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3961:       } else {
 3962:          for (int l = 0; l < nc; l++) {
 3963:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3964:          }
 3965:       }
 3966:    }
 3967: }
 3968: 
 3969: 
 3970: 
 3971: // Helper function that contains the core algorithm
 3972: template<typename XAccessor, typename YAccessor>
 3973: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3974:                                     double  yp_top, double  yp_bot, 
 3975:                                     CubicSpline &spline) {
 3976:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3977:    // 
 3978:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3979:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3980:    //
 3981:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3982:    // 
 3983:    // Inputs: 
 3984:    //            n: dimension for x etc; # of data pts (>=2);
 3985:    //            getX, getY: functions to access x,y coordinates
 3986:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3987:    //     Output: 
 3988:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3989: 
 3990:    const int n = k2 - k1 + 1;
 3991:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3992: 
 3993:    // Allocate memory for the splines
 3994:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3995:    spline.x   = new double[n];
 3996:    spline.y   = new double[n];
 3997:    spline.yp  = new double[n];
 3998:    spline.ypp = new double[n];
 3999: 
 4000:    for (int k=k1; k<=k2; k++) {
 4001:       spline.x[k] = getX(k);
 4002:       spline.y[k] = getY(k);
 4003:    }
 4004: 
 4005:    // This is to simplify expressions later
 4006:    double *x = spline.x;
 4007:    double *y = spline.y;
 4008: 
 4009:    double *a = nullptr;
 4010:    double *b = nullptr;
 4011:    double *c = nullptr;
 4012:    double *gam = nullptr;
 4013:    double *rhs = nullptr;
 4014:    
 4015: 
 4016:       a = new double[n];   // Lower diagonal
 4017:       b = new double[n];   // Diagonal
 4018:       c = new double[n];   // Upper diagonal
 4019:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4020:       rhs = new double[n]; // Right-hand side
 4021: 
 4022:    for (int k=k1; k<=k2; k++) {
 4023:       if (k == k1) {
 4024:          // Bottom level
 4025:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4026:          b[k] = (x[k+1] - x[k])/3.0;
 4027:          c[k] = b[k]/2.0;
 4028:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4029:       } else if (k == n - 1) {
 4030:          // Top level (surface)
 4031:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4032:          b[k] = (x[k] - x[k-1])/3.0;
 4033:          a[k] = b[k]/2.0;
 4034:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4035:       } else {
 4036:          // Intermediate levels
 4037:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4038:          b[k] = (x[k+1] - x[k-1])/3.0;
 4039:          a[k] = (x[k  ] - x[k-1])/6.0;
 4040:          c[k] = (x[k+1] - x[k  ])/6.0;
 4041:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4042:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4043:       }
 4044:    }
 4045: 
 4046:    // Solve the tridiagonal system
 4047:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4048:    
 4049:    spline.yp[k1] = yp_bot;
 4050:    spline.yp[k2] = yp_top;
 4051: 
 4052:    // Compute rest of 1st derivatives using the splines
 4053:    for (int k=k1+1; k<k2; k++) {
 4054:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4055:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4056:    }
 4057:    
 4058:    delete[] a;
 4059:    delete[] b;
 4060:    delete[] c;
 4061:    delete[] gam;
 4062:    delete[] rhs;
 4063: 
 4064: }
 4065: 
 4066: // Array version
 4067: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4068:                                 double y_top, double y_bot, 
 4069:                                 CubicSpline &spline) {
 4070:    auto getX = [x] (int k) { return x[k]; };
 4071:    auto getY = [y] (int k) { return y[k]; };
 4072:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4073: }
 4074: 
 4075: // Lambda version - allows custom access patterns
 4076: template<typename XFunc, typename YFunc>
 4077: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4078:                                 double y_top, double y_bot,
 4079:                                 CubicSpline &spline) {
 4080:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4081: }
 4082: 
 4083: 
 4084: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4085: {
 4086:    assert("Not implemented");
 4087: 
 4088:    return 0.0;
 4089: }
