 5375:    __global__ void resetBoundaryAreas(void) {
 5376:       // Reset boundary areas and lengths for each segment.
 5377: 
 5378:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5379:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5380:       SIDE_BND(sideBnd);
 5381: 
 5382:       BoundarySegment *segment = sideBnd->segment;
 5383: 
 5384:       segment->carea = 0.0;
 5385:       segment->clen = 0.0;
 5386:  
 5387:    }
 5388: 
 5389:    __global__ void computeBoundaryAreas(void) {
 5390:    // Calculation of cross-section areas and lengths for flow b.c.
 5391: 
 5392:       SIDE_BND(sideBnd);
 5393: 
 5394:       const Side *side = sideBnd->side;
 5395:       BoundarySegment *segment = sideBnd->segment;
 5396: 
 5397:       if (segment->ifltype != 0) {
 5398: 
 5399:          const Node *n1 = side->n1;
 5400:          const Node *n2 = side->n2;
 5401: 
 5402:          const double htot = side->htot2();
 5403: 
 5404:          if (!side->isDry) {
 5405:             atomicAdd(&segment->carea, htot*side->len);
 5406:             atomicAdd(&segment->clen, side->len);
 5407:          }
 5408:       }
 5409: 
 5410:    }
 5411: 
 5412: 
 5413:    __global__ void computeFlowBcVelocities(double time) {
 5414: 
 5415:       SIDE_BND(sideBnd);
 5416: 
 5417:       const Side *side = sideBnd->side;
 5418:  
 5419:       const bool isDry = side->isDry;
 5420:       const bool isLand = sideBnd->segment->isLand;
 5421: 
 5422:    
 5423:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5424: 
 5425:       if (isDry || isLand) return;
 5426: 
 5427:       // For wet sides in open boundaries...
 5428:       const Vector2 n = side->n;
 5429:       const BoundarySegment *segment = sideBnd->segment;
 5430: 
 5431:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5432: 
 5433:       const int ifltype = segment->ifltype;
 5434: 
 5435:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5436:       const Vector2 r_nuth0 = r_uth0*n;
 5437: 
 5438: 
 5439:       if (ifltype == 1 || ifltype == 2) {
 5440:       
 5441:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5442: 
 5443:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5444:          
 5445:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5446:          
 5447:       } else if (ifltype == -1) { // Flather 1
 5448: 
 5449:          for (int k = 0; k < nvrt; k++) {
 5450: 
 5451:             // uth is the normal vel.; no ramp up
 5452:             const double uth = sideBnd->nuth(k);
 5453:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5454: 
 5455:             sideBnd->ubc[k] += uth*n;
 5456:          }
 5457: 
 5458:       } else if (ifltype == 3 || ifltype == 5) {
 5459:          // vnth0=0 !normal vel.
 5460: 
 5461:          Vector2 r_u1_bar = {0.0, 0.0};
 5462:          // Computes the contribution to the velocity from all tide frequencies
 5463:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5464: 
 5465:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5466:             const Vector2 umo  = sideBnd->umo(jfr); 
 5467: 
 5468:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5469:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5470:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5471:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5472: 
 5473:          }
 5474: 
 5475: 
 5476:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5477: 
 5478:       } // if (ifltype = 3 || ifltype == 5
 5479: 
 5480: 
 5481: 
 5482:    }
 5483: 
 5484:    __global__ void computeElevationBoundaryConditions(double time) {
 5485:       // Compute elevation essential boundary conditions 
 5486: 
 5487:       NODE_BND(nodeBnd); // Each boundary node.
 5488: 
 5489:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5490: 
 5491:       const Node *node = nodeBnd->node;
 5492:       const BoundarySegment *segment = nodeBnd->segment;
 5493:       const int iettype = segment->iettype;
 5494:       
 5495: 
 5496:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5497:       double eic = 0.0;
 5498:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5499:       else                 eic = 0.0;
 5500: 
 5501:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5502:       const double r_eth = ramp*nodeBnd->eth;
 5503:       double r_eta1_bar = 0.0;
 5504: 
 5505:       // Compute tide elevation
 5506:       if (iettype == 3 || iettype == 5) {   
 5507: 
 5508:          if constexpr(iloadtide==1) { // loading tide
 5509:             assert(false && "Loading tide not implemented");
 5510:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5511:          }
 5512:          
 5513:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5514: 
 5515:             const double efa  = nodeBnd->efa[jfr]; 
 5516:             const double emo  = nodeBnd->emo[jfr]; 
 5517: 
 5518:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5519:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5520:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5521: 
 5522: 
 5523:          } // for jfr
 5524: 
 5525:       } // if iettype
 5526: 
 5527:       switch (iettype) {
 5528:          case 1:
 5529:          case 2:
 5530:          case 4:
 5531:             nodeBnd->elbc = r_eic + r_eth;
 5532:             break;
 5533:          case 3:
 5534:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5535:             break;
 5536:          case 5:
 5537:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5538:             break;
 5539:       } // switch
 5540: 
 5541: 
 5542:       //Add inverse barometric effects
 5543:       if (iettype != 0 && inv_atm_bnd == 1) {
 5544:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5545:       }
 5546: 
 5547:    }
 5548: 
 5549: 
 5550:    __global__ void computeHorizontalViscosity(void) { 
 5551: 
 5552:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5553: 
 5554:       SIDE(side);
 5555: 
 5556:       if (side->isDry) return;
 5557: 
 5558:       for (int k = 0; k < nvrt; k++) {
 5559:          side->nuGradU[k] = {0.0, 0.0};
 5560:       }
 5561: 
 5562:       if constexpr(ihorcon == 1) {
 5563:          for (int k = side->kb; k < nvrt - 1; k++) {
 5564:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5565:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5566:             // By Zhang and Baptista.
 5567: 
 5568:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5569:             // This is a standard discretization of the Laplacian operator.
 5570:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5571:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5572:             // Gamma is hvis_coef0 in the code.
 5573:             // The value of gamma needs to be < 0.5.
 5574: 
 5575:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5576:             // side under consideration in each of the two possible elements that share the side.
 5577:             Vector2 sumU = {0.0, 0.0};
 5578:             for (int l = 0; l < 2; l++) {
 5579:                const Element *elem = side->elems[l];
 5580: 
 5581:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5582: 
 5583:                // Find the local index of the side in the element
 5584:                const int idxSide = elem->sideLocalIdx(side);
 5585: 
 5586:                // Find the two sides that are connected to the side under consideration
 5587:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5588:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5589: 
 5590:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5591: 
 5592:             }
 5593: 
 5594:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5595: 
 5596:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5597:    
 5598:          }
 5599:       }
 5600:       else if constexpr(ihorcon == 2) {
 5601:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5602:       }
 5603: 
 5604: 
 5605:    }
 5606: 
 5607: 
 5608:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5609: 
 5610:       // Set essential boundary conditions 
 5611:       NODE(node); // Each boundary node
 5612:       NodeBoundary *nodeBnd = node->nodeBnd;
 5613:       
 5614:  
 5615:       // Check if this node has essential BC
 5616:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5617:          // Verify BC value is valid
 5618:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5619: 
 5620:        
 5621:          // Set diagonal to 1 and zero off-diagonals
 5622:          node->coeffDiag = 1.0;
 5623: 
 5624:          for (int j = 0; j < node->numNodes; j++) {
 5625:                node->coeffMatrix[j] = 0.0;
 5626:          }
 5627:          
 5628:          // Set solution and RHS to BC value
 5629:          node->mX  = nodeBnd->elbc;
 5630:          node->qel = nodeBnd->elbc;
 5631: 
 5632:       } else {
 5633:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5634: 
 5635:          for (int j = 0; j < node->numNodes; j++) {
 5636:                Node* nbNode = node->nodes[j];
 5637:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5638:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5639:                   // Verify neighbor's BC value
 5640:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5641: 
 5642:                   // Subtract contribution to RHS
 5643:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5644:                   node->coeffMatrix[j] = 0.0;  
 5645:                }
 5646:          }
 5647:       }
 5648:    }
 5649: 
 5650: 
 5651:    __global__ void updateElevation(void) {
 5652:       NODE(node);
 5653: 
 5654: 
 5655:       node->eta2 = node->mX;
 5656: 
 5657:       node->updateZCoordData();
 5658:    }
