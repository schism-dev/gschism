 9118: #ifdef DONTCOMPILE
 9119: __global__ void checkMassConservation(Tracers* sumtr) {
 9120: 
 9121:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 9122: 
 9123:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 9124: 
 9125:    Element *elem = &(mesh->localElemData[i]);
 9126: 
 9127:    // Skip dry elements
 9128:    if (elem->isDry) return;
 9129: 
 9130:    // Local sum array for this thread
 9131:    double localSum[ntracers] = {0.0};
 9132: 
 9133:    // Sum over vertical levels for this element
 9134:    const int kbe = elem->kbe;
 9135:    const double area = elem->area;
 9136: 
 9137:    for (int k = kbe; k < nvrt; k++) {
 9138:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 9139:       
 9140:       // Accumulate tracer mass
 9141:       for (int tr = 0; tr < ntracers; tr++) {
 9142:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 9143:       }
 9144:    }
 9145: 
 9146:    //  This function returns per element sums. A reduction must be done on the host side.
 9147: }  
 9148: 
 9149: 
 9150: __global__ void transport(void) {
 9151: 
 9152:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 9153: 
 9154:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 9155: 
 9156:    Element *elem = &(mesh->localElemData[ie]);
 9157: 
 9158:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 9159: 
 9160:                for (int m=0; m<ntr; m++) {
 9161:                   for (int k=kbe(ie); k<nvrt; k++) {
 9162:                      // Calculate each polynomial's weight 
 9163:                      wm=0.d0; sum1=0.d0; 
 9164:                      wm1=0.d0; wm2=0.d0; 
 9165:                      for (int i=0; i<elem->nweno2; i++) {
 9166:                   
 9167:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9168:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9169:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9170:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9171:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9172:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 9173:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 9174:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 9175:                      // -----------------Hu and Shu (1999)'s method----------------
 9176:                      b4=b1+b2+b3
 9177: 
 9178: //Error: add PRODUCTION CPP
 9179: #ifdef DEBUG
 9180:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 9181:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 9182:                     call parallel_abort(errmsg)
 9183:                   }
 9184: #endif
 9185: 
 9186:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 9187:                   // !----test-------------- 
 9188:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 9189:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 9190:                   // !wm(i)=wm1(i)*wm2(i)
 9191:                   // !---------------------- 
 9192:                   sum1=sum1+wm(i)
 9193:                 } // end for i
 9194: 
 9195:                 wm=wm/sum1
 9196: 
 9197:                 for (int j=0; j<elem->i34; j++) {
 9198: 
 9199:                   const Side *side  = elem->sides[j];
 9200:                   const Node *node1 = side->n1;
 9201:                   const Node *node2 = side->n2;
 9202: 
 9203:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 9204:                      trsd=0.d0
 9205:                      for (int kk=0; kk<nquad; kk++) {
 9206:                         for (int i=0; i<elem->nweno2; i++) {
 9207:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9208:                         } // end for i   
 9209:                      } // end for kk
 9210:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9211:                   } // outward flux
 9212:                } // end for j=1,i34(ie) ! side
 9213:             }
 9214:          }
 9215:               
 9216: 
 9217: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 9218: //             //   calculate each polynomial's weight 
 9219: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 9220: //                 wm=0.d0; sum1=0.d0
 9221: //                 do i=1,nweno1(ie) !for each polynomial
 9222: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9223: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9224: //                   b1=b1*b1+b2*b2 !smoothness indicator
 9225: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 9226: //                   wm(i)=b2
 9227: //                   sum1=sum1+b2
 9228: //                   !wm(i)=1.d0
 9229: //                   !sum1=sum1+1.d0
 9230: 
 9231: // // Error: PRODUCTION
 9232: // #ifdef DEBUG
 9233: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 9234: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 9235: //                     call parallel_abort(errmsg)
 9236: //                   endif
 9237: // #endif
 9238: 
 9239: //                 enddo !i
 9240: //                 wm=wm/sum1 !final weight
 9241: 
 9242:                 for (int j=0; j<elem->i34; j++) { // side
 9243:                   const Side *side = elem->sides[j];
 9244:                   const Node *node1 = side->n1;
 9245:                   const Node *node2 = side->n2;
 9246: 
 9247:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 9248:                     trsd=0.d0
 9249:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 9250:                       for (int i=0; i<elem->nweno1; i++) {
 9251:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 9252:                       }
 9253:                     enddo //kk
 9254:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9255:                   } // outward flux
 9256:                 } // end for j=1,i34(ie) ! side
 9257:               } // end for k; ntr 
 9258: 
 9259:             else !simple upwind method
 9260:               do j=1,i34(ie)
 9261:                 jsj=elside(j,ie)
 9262:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 9263:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 9264:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 9265:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 9266:                   endif
 9267:                 enddo  !vertical layers
 9268:               enddo !j=1,i34(ie) ! side
 9269:             endif !order of accuracy
