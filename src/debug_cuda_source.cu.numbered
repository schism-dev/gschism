 5466:    __global__ void resetBoundaryAreas(void) {
 5467:       // Reset boundary areas and lengths for each segment.
 5468: 
 5469:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5470:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5471:       SIDE_BND(sideBnd);
 5472: 
 5473:       BoundarySegment *segment = sideBnd->segment;
 5474: 
 5475:       segment->carea = 0.0;
 5476:       segment->clen = 0.0;
 5477:  
 5478:    }
 5479: 
 5480:    __global__ void computeBoundaryAreas(void) {
 5481:    // Calculation of cross-section areas and lengths for flow b.c.
 5482: 
 5483:       SIDE_BND(sideBnd);
 5484: 
 5485:       const Side *side = sideBnd->side;
 5486:       BoundarySegment *segment = sideBnd->segment;
 5487: 
 5488:       if (segment->ifltype != 0) {
 5489: 
 5490:          const Node *n1 = side->n1;
 5491:          const Node *n2 = side->n2;
 5492: 
 5493:          const double htot = side->htot2();
 5494: 
 5495:          if (!side->isDry) {
 5496:             atomicAdd(&segment->carea, htot*side->len);
 5497:             atomicAdd(&segment->clen, side->len);
 5498:          }
 5499:       }
 5500: 
 5501:    }
 5502: 
 5503: 
 5504:    __global__ void computeFlowBcVelocities(double time) {
 5505: 
 5506:       SIDE_BND(sideBnd);
 5507: 
 5508:       const Side *side = sideBnd->side;
 5509:  
 5510:       const bool isDry = side->isDry;
 5511:       const bool isLand = sideBnd->segment->isLand;
 5512: 
 5513:    
 5514:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5515: 
 5516:       if (isDry || isLand) return;
 5517: 
 5518:       // For wet sides in open boundaries...
 5519:       const Vector2 n = side->n;
 5520:       const BoundarySegment *segment = sideBnd->segment;
 5521: 
 5522:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5523: 
 5524:       const int ifltype = segment->ifltype;
 5525: 
 5526:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5527:       const Vector2 r_nuth0 = r_uth0*n;
 5528: 
 5529: 
 5530:       if (ifltype == 1 || ifltype == 2) {
 5531:       
 5532:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5533: 
 5534:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5535:          
 5536:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5537:          
 5538:       } else if (ifltype == -1) { // Flather 1
 5539: 
 5540:          for (int k = 0; k < nvrt; k++) {
 5541: 
 5542:             // uth is the normal vel.; no ramp up
 5543:             const double uth = sideBnd->nuth(k);
 5544:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5545: 
 5546:             sideBnd->ubc[k] += uth*n;
 5547:          }
 5548: 
 5549:       } else if (ifltype == 3 || ifltype == 5) {
 5550:          // vnth0=0 !normal vel.
 5551: 
 5552:          Vector2 r_u1_bar = {0.0, 0.0};
 5553:          // Computes the contribution to the velocity from all tide frequencies
 5554:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5555: 
 5556:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5557:             const Vector2 umo  = sideBnd->umo(jfr); 
 5558: 
 5559:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5560:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5561:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5562:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5563: 
 5564:          }
 5565: 
 5566: 
 5567:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5568: 
 5569:       } // if (ifltype = 3 || ifltype == 5
 5570: 
 5571: 
 5572: 
 5573:    }
 5574: 
 5575:    __global__ void computeElevationBoundaryConditions(double time) {
 5576:       // Compute elevation essential boundary conditions 
 5577: 
 5578:       NODE_BND(nodeBnd); // Each boundary node.
 5579: 
 5580:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5581: 
 5582:       const Node *node = nodeBnd->node;
 5583:       const BoundarySegment *segment = nodeBnd->segment;
 5584:       const int iettype = segment->iettype;
 5585:       
 5586: 
 5587:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5588:       double eic = 0.0;
 5589:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5590:       else                 eic = 0.0;
 5591: 
 5592:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5593:       const double r_eth = ramp*nodeBnd->eth;
 5594:       double r_eta1_bar = 0.0;
 5595: 
 5596:       // Compute tide elevation
 5597:       if (iettype == 3 || iettype == 5) {   
 5598: 
 5599:          if constexpr(iloadtide==1) { // loading tide
 5600:             assert(false && "Loading tide not implemented");
 5601:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5602:          }
 5603:          
 5604:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5605: 
 5606:             const double efa  = nodeBnd->efa[jfr]; 
 5607:             const double emo  = nodeBnd->emo[jfr]; 
 5608: 
 5609:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5610:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5611:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5612: 
 5613: 
 5614:          } // for jfr
 5615: 
 5616:       } // if iettype
 5617: 
 5618:       switch (iettype) {
 5619:          case 1:
 5620:          case 2:
 5621:          case 4:
 5622:             nodeBnd->elbc = r_eic + r_eth;
 5623:             break;
 5624:          case 3:
 5625:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5626:             break;
 5627:          case 5:
 5628:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5629:             break;
 5630:       } // switch
 5631: 
 5632: 
 5633:       //Add inverse barometric effects
 5634:       if (iettype != 0 && inv_atm_bnd == 1) {
 5635:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5636:       }
 5637: 
 5638:    }
 5639: 
 5640: 
 5641:    __global__ void computeHorizontalViscosity(void) { 
 5642: 
 5643:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5644: 
 5645:       SIDE(side);
 5646: 
 5647:       if (side->isDry) return;
 5648: 
 5649:       for (int k = 0; k < nvrt; k++) {
 5650:          side->nuGradU[k] = {0.0, 0.0};
 5651:       }
 5652: 
 5653:       if constexpr(ihorcon == 1) {
 5654:          for (int k = side->kb; k < nvrt - 1; k++) {
 5655:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5656:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5657:             // By Zhang and Baptista.
 5658: 
 5659:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5660:             // This is a standard discretization of the Laplacian operator.
 5661:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5662:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5663:             // Gamma is hvis_coef0 in the code.
 5664:             // The value of gamma needs to be < 0.5.
 5665: 
 5666:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5667:             // side under consideration in each of the two possible elements that share the side.
 5668:             Vector2 sumU = {0.0, 0.0};
 5669:             for (int l = 0; l < 2; l++) {
 5670:                const Element *elem = side->elems[l];
 5671: 
 5672:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5673: 
 5674:                // Find the local index of the side in the element
 5675:                const int idxSide = elem->sideLocalIdx(side);
 5676: 
 5677:                // Find the two sides that are connected to the side under consideration
 5678:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5679:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5680: 
 5681:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5682: 
 5683:             }
 5684: 
 5685:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5686: 
 5687:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5688:    
 5689:          }
 5690:       }
 5691:       else if constexpr(ihorcon == 2) {
 5692:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5693:       }
 5694: 
 5695: 
 5696:    }
 5697: 
 5698: 
 5699:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5700: 
 5701:       // Set essential boundary conditions 
 5702:       NODE(node); // Each boundary node
 5703:       NodeBoundary *nodeBnd = node->nodeBnd;
 5704:       
 5705:  
 5706:       // Check if this node has essential BC
 5707:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5708: 
 5709:          // Verify BC value is valid
 5710:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5711: 
 5712:        
 5713:          // Set diagonal to 1 and zero off-diagonals
 5714:          for (int j = 0; j <= node->numNodes; j++) {
 5715:                node->coeffRow[j] = 0.0;
 5716:          }
 5717: 
 5718:          *(node->coeffDiag) = 1.0;
 5719: 
 5720: 
 5721:          // Set solution and RHS to BC value
 5722:          node->mX  = nodeBnd->elbc;
 5723:          node->qel = nodeBnd->elbc;
 5724: 
 5725:       } else {
 5726:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5727: 
 5728:          for (int j = 0; j < node->numNodes; j++) {
 5729:                const Node* nbNode = node->nodes[j];
 5730:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 5731: 
 5732:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5733:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 5734: 
 5735:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5736:                   // Verify neighbor's BC value
 5737:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5738: 
 5739:                   // Subtract contribution to RHS
 5740:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 5741:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 5742:                }
 5743:          }
 5744: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 5745:       }
 5746:    }
 5747: 
 5748: 
 5749:    __global__ void updateElevation(void) {
 5750:       NODE(node);
 5751: 
 5752: 
 5753:       node->eta2 = node->mX;
 5754: 
 5755:       node->updateZCoordData();
 5756:    }
