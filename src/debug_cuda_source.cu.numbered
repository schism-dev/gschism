 8131: __global__ void returnMatrix(double *res) {
 8132:    // Debugging: returns the matrix as a CuPy array
 8133: 
 8134:    const int size = mesh->np;
 8135:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8136:       const Node *node = mesh->localNodeData + idx_node;
 8137:       res[idx_node*size + idx_node] = node->coeffDiag;
 8138:       for (int j = 0; j < node->numNodes; j++) {
 8139:          Node* nbNode = node->nodes[j];
 8140:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8141:       }
 8142: 
 8143:    }
 8144:    
 8145: }
