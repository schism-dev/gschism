 2237: /**
 2238:  * Find the element that contains the target point.
 2239:  * 
 2240:  * @param x0,y0,z0     Starting position coordinates
 2241:  * @param xt,yt,zt     Target position coordinates
 2242:  * @param dtb          Time step for tracking
 2243:  * @param u_int        Initial velocity components
 2244:  * @param nextElem     Starting/resulting element index
 2245:  * 
 2246:  * @return Status code of type trackExitCodes
 2247:  * 
 2248:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2249:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2250:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2251:  * as close the the segment AB as possible, the next point at each iteration is computed
 2252:  * along segment AB, but just after the current element.
 2253:  */
 2254: 
 2255: 
 2256: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2257: 
 2258:    constexpr int MAX_ITERATIONS = 40;
 2259: 
 2260:    int iter = 0;
 2261:    double fac = 0.00001;
 2262:    while (iter < MAX_ITERATIONS) {
 2263:       iter++;
 2264: 
 2265:       Bool4 isLeft, isObtuse, isBisector;
 2266:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2267: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2268:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2269: 
 2270: 
 2271:       if (isValid.none()) 
 2272:       // Inside the element if none of the edges is a valid continuation
 2273:       {
 2274:          // Just returns true and the element (curElem) is unchanged).
 2275:          // This means that the algorithm has found the element that contains the target point.
 2276:          return true;
 2277:       }
 2278:       else { // Outside the element
 2279: 
 2280:          // Outside this element. Pick the first valid exit side and cross.
 2281:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2282:          Element *prevElem = curElem;
 2283:          curElem = lastCrossSide->otherElem(curElem);
 2284: 
 2285:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2286:          // along the boundary.
 2287:          if (curElem == nullptr || curElem->isDry) {
 2288:          
 2289:             curElem = prevElem;
 2290:             return false;
 2291:          }
 2292:          
 2293:       }
 2294: 
 2295:    }
 2296: 
 2297:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2298: }
 2299: 
