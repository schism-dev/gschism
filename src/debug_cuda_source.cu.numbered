  685:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  686: 
  687:    // ------------------------------------------------------------------------------------------------
  688:    // These are functions that work on all nodes of the element.
  689:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  690:    //
  691:    // An example of how to use these functions is:
  692:    //   
  693:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  694:    // 
  695:    // Where L is the level at which the field is to be interpolated. The field can be either
  696:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  697:    // There are different versions of getNodalValues for each of these cases.
  698: 
  699:    template<typename T>
  700:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  701:       // Get the values of the field at the nodes of the element
  702:       res[0] = nodes[0]->*field;
  703:       res[1] = nodes[1]->*field;
  704:       res[2] = nodes[2]->*field;
  705:       if (isQuad()) res[3] = nodes[3]->*field;
  706:       else          res[3] = T();
  707:    }
  708: 
  709:    template<typename T>
  710:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  711:       // Get the values of the field at the nodes of the element
  712:       res[0] = (nodes[0]->*field)[level];
  713:       res[1] = (nodes[1]->*field)[level];
  714:       res[2] = (nodes[2]->*field)[level];
  715:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  716:       else          res[3] = T();
  717:    }    
  718: 
  719:    template<typename T>
  720:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  721:       // Get the values of the func at the nodes of the element
  722:       res[0] = (nodes[0]->*func)(level);
  723:       res[1] = (nodes[1]->*func)(level);
  724:       res[2] = (nodes[2]->*func)(level);
  725:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  726:       else          res[3] = T();  // This is 0.0 or a zero vector
  727: 
  728:    }      
  729: 
  730:    template<typename T>
  731:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  732:       // Get the values of the field at the nodes of the element
  733:       res[0] = sides[0]->*field;
  734:       res[1] = sides[1]->*field;
  735:       res[2] = sides[2]->*field;
  736:       if (isQuad()) res[3] = sides[3]->*field;
  737:       else          res[3] = T();
  738:    }
  739: 
  740:    template<typename T>
  741:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  742:       // Get the values of the field at the nodes of the element
  743:       res[0] = (sides[0]->*field)[level];
  744:       res[1] = (sides[1]->*field)[level];
  745:       res[2] = (sides[2]->*field)[level];
  746:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  747:       else          res[3] = T();
  748:    }    
  749: 
  750:    template<typename T>
  751:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  752:       // Get the values of the func at the nodes of the element
  753:       res[0] = (sides[0]->*func)(level);
  754:       res[1] = (sides[1]->*func)(level);
  755:       res[2] = (sides[2]->*func)(level);
  756:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  757:       else          res[3] = T();  // This is 0.0 or a zero vector
  758: 
  759:    }      
  760: 
  761: 
  762:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  763:       double values[4];
  764:       getNodalValues(level, func, values);
  765: 
  766:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  767:    }
  768: 
  769:    template<typename T>
  770:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  771:       T values[4];
  772:       getNodalValues(field, values);
  773:       
  774:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  775:    }
  776: 
  777: 
  778:    template<typename T>
  779:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  780:       T values[4];
  781:       getNodalValues(level, field, values);
  782: 
  783:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  784:    }
  785: 
  786:    template<typename T>
  787:    __device__ T mean(T Node::* field) const {
  788:       T values[4];
  789:       getNodalValues(field, values);
  790: 
  791:       return (values[0] + values[1] + values[2] + values[3])/i34;
  792:    }
  793: 
  794:    template<typename T>
  795:    __device__ T mean(T Side::* field) const {
  796:       T values[4];
  797:       getSideValues(field, values);
  798:       
  799:       return (values[0] + values[1] + values[2] + values[3])/i34;
  800:    }   
  801: 
  802:    template<typename T>
  803:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  804:       T values[4];
  805:       getNodalValues(level, field, values);
  806: 
  807:       return (values[0] + values[1] + values[2] + values[3])/i34;
  808:    }
  809: 
  810:    template<typename T>
  811:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  812:       T values[4];
  813:       getSideValues(level, field, values);
  814:       
  815:       return (values[0] + values[1] + values[2] + values[3])/i34;
  816:    }   
  817: 
  818:    // __device__ double mean(double (Node::*func)(int) const) const {
