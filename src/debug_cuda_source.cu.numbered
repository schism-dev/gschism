 7062: __global__ void printMatrix(bool full) {
 7063:    // Debugging: print the matrix
 7064: 
 7065:    const int size = mesh->np;
 7066:    double sum = 0.0;
 7067:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7068:       const Node *node = mesh->localNodeData + idx_node;
 7069:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7070:       for (int j = 0; j < node->numNodes; j++) {
 7071:          Node* nbNode = node->nodes[j];
 7072:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7073:          sum += node->coeffMatrix[j];
 7074:       }
 7075:       if (full) printf("]\n");
 7076: 
 7077: 
 7078:    }
 7079:    if (!full) printf("sum=%lf\n", sum);
 7080: }
