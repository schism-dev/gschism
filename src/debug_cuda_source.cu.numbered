 2280:    template<typename T>
 2281:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2282:       // Get the values of the field at the nodes of the element
 2283:       res[0] = nodes[0]->*field;
 2284:       res[1] = nodes[1]->*field;
 2285:       res[2] = nodes[2]->*field;
 2286:       if (isQuad()) res[3] = nodes[3]->*field;
 2287:       else          res[3] = T();
 2288:    }
 2289: 
 2290:    template<typename T>
 2291:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2292: 
 2293:       assert(level < nvrt && "Level is out of range");
 2294:       // Get the values of the field at the nodes of the element
 2295:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2296:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2297:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2298:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2299:       else          res[3] = T();
 2300:    }    
 2301: 
 2302:    template<typename T>
 2303:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2304: 
 2305:       assert(level < nvrt && "Level is out of range");
 2306: 
 2307:       // Get the values of the func at the nodes of the element
 2308:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2309:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2310:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2311:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2312:       else          res[3] = T();  // This is 0.0 or a zero vector
 2313: 
 2314:    }      
