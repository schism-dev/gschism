 4195:    __global__ void scaleGravity(double loadtide_coef) {
 4196: 
 4197: 
 4198:       NODE(node);
 4199: 
 4200:       // SAL option: scale gravity
 4201:       if constexpr(iloadtide==2) {  // simple const
 4202:          node->grav2 = grav*(1.0 - loadtide_coef);
 4203: 
 4204:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4205:         
 4206:           const double depth = max(node->depth, 0.0);
 4207:           const double tmp1 = sqrt(depth);
 4208:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4209:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4210:                              2.6969e-13*depth*depth*depth*tmp1;
 4211:           
 4212:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4213:           
 4214: 
 4215: 
 4216:           node->grav2 = grav*(1.0 - beta_bar);
 4217: 
 4218:       } else {  // iloadtide=0,1
 4219:         node->grav2=grav;
 4220: 
 4221:       }
 4222: 
 4223:    }
 4224: 
