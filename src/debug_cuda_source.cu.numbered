 9114: 
 9115: __global__ void returnMatrix(double *res) {
 9116:    // Debugging: dense local matrix, row-major, size = mesh->np
 9117:    // Assumes single-partition / local indexing (see note below).
 9118: 
 9119:    const int size = mesh->np;
 9120: 
 9121:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9122:       const Node *node = mesh->localNodeData + idx_node;
 9123: 
 9124:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9125: 
 9126:       for (int j = 0; j < node->numNodes; j++) {
 9127:          const Node *nbNode = node->nodes[j];
 9128:          // Only dump neighbors that live on this partition
 9129:          if (nbNode->part != mesh->partNum) continue;
 9130: 
 9131:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9132:          const double aij = node->coeffRow[node->csrSlot[j]];
 9133:          if (aij != 0.0)
 9134:             res[jlocal * size + idx_node] = aij;
 9135:       }
 9136:    }
 9137: }
