 3036: 
 3037: 
 3038: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3039:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3040:    
 3041:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3042: }
 3043: 
 3044: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3045:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3046:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3047:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3048:    return area * dot(gradPhi[i], gradPhi[j]);
 3049: }
 3050: 
 3051: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3052:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3053:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3054:    // The formula for the integral is:
 3055:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3056:    
 3057:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3058:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3059:    const double eta_sum  = eta_n(i) + eta_n(j);
 3060:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3061: 
 3062:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // xi derivative of the Jacobian determinant
 3063:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3064: 
 3065:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_xi*eta_term*xi_sum + detJ_eta*xi_term*eta_sum);
 3066: }
 3067:    
 3068: 
 3069: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3070:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3071:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3072:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3073:    // The formula is also based on the identity:
 3074:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3075:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3076: 
 3077:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3078: 
 3079: 
 3080: 
 3081:    double res = 0.0;
 3082:    
 3083:    // Quadrature points in xi and eta coordinates
 3084:    #pragma unroll
 3085:    for (int i = 0; i < 4; i++) {
 3086:       // For each quadrature point...
 3087: 
 3088:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3089:       const double eta = p.x;
 3090:       const double xi  = p.y;
 3091: 
 3092:       // Jacobian entries at the Gauss point p
 3093:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3094:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3095:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + xi *(x0.y + x2.y - x1.y - x3.y) );
 3096:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + eta*(x0.y + x2.y - x1.y - x3.y) );      
 3097: 
 3098:       const double detJ = jacobianDetQuad(p, x0, x1, x2, x3);
 3099:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3100: 
 3101:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3102:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3103:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3104:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3105:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3106: 
 3107:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3108:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3109:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3110:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3111:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3112: 
 3113:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3114:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3115:    }
 3116: 
 3117:    return res;
 3118: }
 3119: 
 3120: 
 3121: /**  Interpolate velocities at a given point (xt,yt,zt)
 3122: 
 3123:    @param xt, yt, zt: coordinates of the point to interpolate
 3124:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3125: 
 3126:    This is done in four steps:
 3127: 
 3128:    1. Find the shape coordinates for the final position in the element.
 3129:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3130:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3131:       z levels at xt, yt at each step.   
 3132:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3133:       horizontally and vertically.
 3134: **/
 3135: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3136:    // Interpolate the velocities at the point xt. 
 3137:    // This function works the same for triangular and quadrilateral elements.
 3138:    double shpCoord[4];
 3139:    Vector3 u_int;
 3140: 
 3141: 
 3142:    // First step is to compute the shape coordinates of (xt,yt)
 3143: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3144:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3145: 
 3146:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3147: 
 3148:    // Second step is to find the level that contains zt
 3149:    // Uses a binary search to find the level
 3150:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3151:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3152:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3153:    int R = nvrt - 1;
 3154: 
 3155:    // Get the z coordinates at the nodes of the element at the levels L and R
 3156:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3157:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3158:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3159: 
 3160: 
 3161:    double zL = interpolate(shpCoord, zLAtNodes);
 3162:    double zR = interpolate(shpCoord, zRAtNodes);
 3163: 
 3164:    // Interpolates vertically the velocities
 3165:    double wght1, wght2;
 3166:    if (xt.z <= zL) {
 3167:       wght1 = 1.0;
 3168:       wght2 = 0.0;
 3169:       xt.z = zL;
 3170:    }
 3171:    else if (xt.z >= zR) {
 3172:       wght1 = 0.0;
 3173:       wght2 = 1.0;
 3174:       xt.z = zR;
 3175:    }
 3176:    else {
 3177:       // Perform a binary search to find the levels between L and R that contain xt.z
 3178:       while (R - L > 1) {
 3179:          int M = (L + R) / 2.0;
 3180: 
 3181:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3182:          double zM = interpolate(shpCoord, zMAtNodes);
 3183:          if (zM < xt.z) 
 3184:          {
 3185:             L = M;
 3186:             zL = zM;
 3187:          }
 3188:          else 
 3189:          {
 3190:             R = M;
 3191:             zR = zM;
 3192:          }
 3193:       }
 3194:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3195:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3196: 
 3197:       wght2 = (xt.z - zL)/(zR - zL);
 3198:       wght1 = 1.0 - wght2;
 3199: 
 3200:    }
 3201: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3202: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3203:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3204:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3205:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3206:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3207: 
 3208:    // Project the velocity from the local frame to the origSide frame
 3209:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3210:    u_int = {uv.x, uv.y, w};
 3211: 
 3212:    // Neither of the interpolated velocities should be NaN
 3213:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3214: 
 3215:    return u_int;
 3216: 
 3217: }
 3218: 
 3219: 
 3220: 
 3221: 
 3222: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3223: 
 3224:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3225:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3226:    const Node *n1 = side->n1;
 3227:    const Node *n2 = side->n2;
 3228: 
 3229:    bool n1_match = (n1->nodeBnd->segment == segment);
 3230:    bool n2_match = (n2->nodeBnd->segment == segment);
 3231: 
 3232:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3233:    if (n1_match && n2_match) {
 3234:       return 0.5;
 3235:    } else if (n1_match) {
 3236:       return 1.0;
 3237:    } else if (n2_match) {
 3238:       return 0.0;
 3239:    }
 3240: 
 3241:    return 0.0;
 3242: }
 3243: 
 3244: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3245: 
 3246: 
 3247: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3248: 
 3249:    const double w1 = getBoundaryArrayValueWeight();
 3250:    const double w2 = 1.0 - w1;
 3251:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3252:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3253: 
 3254:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3255: }
 3256: 
 3257: 
 3258: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3259:    const double w1 = getBoundaryArrayValueWeight();
 3260:    const double w2 = 1.0 - w1;
 3261:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3262:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3263: 
 3264:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3265: 
 3266: }
 3267: 
 3268: 
 3269: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3270:    // Returns the value of the velocity at the side center
 3271:    const double w1 = getBoundaryArrayValueWeight();
 3272:    const double w2 = 1.0 - w1;
 3273:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3274:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3275: 
 3276:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3277: }
 3278: 
 3279: 
 3280: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3281:    // Returns the value of the normal component of the velocity at the side center
 3282:    const double w1 = getBoundaryArrayValueWeight();
 3283:    const double w2 = 1.0 - w1;
 3284:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3285:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3286: 
 3287:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3288: }
