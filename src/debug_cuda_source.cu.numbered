 6215: 
 6216:    __global__ void computeVerticalVelocity(void) {
 6217:       // Computes the vertical velocity at the (2D) element's centroid.
 6218:       // In this function we will be considering volumetric elements, with side faces and a 
 6219:       // bottom and a top face. We will call them SFs, BF and TF.
 6220:       // It computes the flux coming from BF and the SFs.
 6221:       // If the bed is moving, it takes that into account.
 6222:       // Since water is incompressible, the integral of the velocity times the normal vector
 6223:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6224:       // and the BF is equal to the flux going out from the TF.
 6225:       // TF = - BF - sum(SFs).
 6226:       // It then computes the horizontal velocity at the center of TF.
 6227:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6228:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6229:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6230: 
 6231:       ELEM(elem);
 6232: 
 6233:       if (elem->isDry) return;
 6234: 
 6235:       const int kb = elem->kb;
 6236:       const bool isTri = elem->isTri();
 6237: 
 6238:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6239: 
 6240:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6241:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6242:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6243: 
 6244:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6245: 
 6246:       double area3D;
 6247: 
 6248:       // Bottom face flux
 6249:       double bottomFlux = 0.0;
 6250:       Vector2 u2meanBottom = {0.0, 0.0};
 6251:       const Vector2 gradh = elem->grad2(&Node::depth);
 6252:       if constexpr(imm==2) {
 6253:          Vector3 ubed;
 6254: 
 6255:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6256:          // updateBDEF(ubed);
 6257:      
 6258:          // const double bflux0 = dot(ubed, elem_n1);
 6259: 
 6260:          // elem->w[kb] += ubed.z;
 6261:       }
 6262:       else {
 6263:          Vector2 umean;
 6264:          if constexpr(ics == 1) {
 6265:             u2meanBottom = elem->mean(kb, &Side::u2);
 6266:          }
 6267:          else {
 6268:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6269:          }
 6270: 
 6271:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6272:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6273: 
 6274:          bottomFlux = - dot(gradh, u2meanBottom);
 6275:       } // if imm
 6276: 
 6277:       // Compute w for kb+1 to nvrt-1
 6278:       for (int l = kb; l < nvrt - 1; l++) {
 6279: 
 6280:          // normal vector to the top face of the "volumetric" element (3D)
 6281:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6282: 
 6283:          // Compute the total flux at the sides
 6284:          double sideFlux = 0.0;
 6285:          Vector2 u2top = {0.0, 0.0};
 6286:          for (int j = 0; j < elem->i34; j++) {
 6287:             const Side *side = elem->sides[j];
 6288: 
 6289:             const double sideArea = side->area(l);
 6290:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6291:             const double sign = elem->ssign[j]; 
 6292: 
 6293:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6294:          }
 6295:          
 6296:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6297:          //velocities at the centers of the sides
 6298:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6299: 
 6300:          // The flx at the top ace can be computed from the other flows.
 6301:          const double topFlux = - sideFlux - bottomFlux;
 6302:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6303: 
 6304:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6305: 
 6306:          elem_n1 = elem_n2;
 6307: 
 6308:          bottomFlux = - topFlux;
 6309:       }
 6310:    }  
 6311: 
