 6226:    __global__ void resetBoundaryAreas(void) {
 6227:       // Reset boundary areas and lengths for each segment.
 6228: 
 6229:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6230:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6231:       SIDE_BND(sideBnd);
 6232: 
 6233:       BoundarySegment *segment = sideBnd->segment;
 6234: 
 6235:       segment->carea = 0.0;
 6236:       segment->clen = 0.0;
 6237:  
 6238:    }
 6239: 
 6240:    __global__ void computeBoundaryAreas(void) {
 6241:    // Calculation of cross-section areas and lengths for flow b.c.
 6242: 
 6243:       SIDE_BND(sideBnd);
 6244: 
 6245:       const Side *side = sideBnd->side;
 6246:       BoundarySegment *segment = sideBnd->segment;
 6247: 
 6248:       if (segment->ifltype != 0) {
 6249: 
 6250:          const Node *n1 = side->n1;
 6251:          const Node *n2 = side->n2;
 6252: 
 6253:          const double htot = side->htot2();
 6254: 
 6255:          if (!side->isDry) {
 6256:             atomicAdd(&segment->carea, htot*side->len);
 6257:             atomicAdd(&segment->clen, side->len);
 6258:          }
 6259:       }
 6260: 
 6261:    }
 6262: 
 6263: 
 6264:    __global__ void computeFlowBcVelocities(double time) {
 6265: 
 6266:       SIDE_BND(sideBnd);
 6267: 
 6268:       const Side *side = sideBnd->side;
 6269:  
 6270:       const bool isDry = side->isDry;
 6271:       const bool isLand = sideBnd->segment->isLand;
 6272: 
 6273:    
 6274:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6275: 
 6276:       if (isDry || isLand) return;
 6277: 
 6278:       // For wet sides in open boundaries...
 6279:       const Vector2 n = side->n;
 6280:       const BoundarySegment *segment = sideBnd->segment;
 6281: 
 6282:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6283: 
 6284:       const int ifltype = segment->ifltype;
 6285: 
 6286:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6287:       const Vector2 r_nuth0 = r_uth0*n;
 6288: 
 6289: 
 6290:       if (ifltype == 1 || ifltype == 2) {
 6291:       
 6292:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6293: 
 6294:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6295: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6296:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6297:          
 6298:       } else if (ifltype == -1) { // Flather 1
 6299: 
 6300:          for (int k = 0; k < nvrt; k++) {
 6301: 
 6302:             // uth is the normal vel.; no ramp up
 6303:             const double uth = sideBnd->nuth(k);
 6304:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6305: 
 6306:             sideBnd->ubc[k] += uth*n;
 6307:          }
 6308: 
 6309:       } else if (ifltype == 3 || ifltype == 5) {
 6310:          // vnth0=0 !normal vel.
 6311: 
 6312:          Vector2 r_u1_bar = {0.0, 0.0};
 6313:          // Computes the contribution to the velocity from all tide frequencies
 6314:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6315: 
 6316:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 6317:             const Vector2 umo  = sideBnd->umo(jfr); 
 6318: 
 6319:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6320:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6321:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6322:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6323: 
 6324:          }
 6325: 
 6326: 
 6327:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6328: 
 6329:       } // if (ifltype = 3 || ifltype == 5
 6330: 
 6331: 
 6332: 
 6333:    }
 6334: 
 6335:    __global__ void computeElevationBoundaryConditions(double time) {
 6336:       // Compute elevation essential boundary conditions 
 6337: 
 6338:       NODE_BND(nodeBnd); // Each boundary node.
 6339: 
 6340:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6341: 
 6342:       const Node *node = nodeBnd->node;
 6343:       const BoundarySegment *segment = nodeBnd->segment;
 6344:       const int iettype = segment->iettype;
 6345:       
 6346: 
 6347:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6348:       double eic = 0.0;
 6349:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6350:       else                 eic = 0.0;
 6351: 
 6352:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6353:       const double r_eth = ramp*nodeBnd->eth;
 6354:       double r_eta1_bar = 0.0;
 6355: 
 6356:       // Compute tide elevation
 6357:       if (iettype == 3 || iettype == 5) {   
 6358: 
 6359:          if constexpr(iloadtide==1) { // loading tide
 6360:             assert(false && "Loading tide not implemented");
 6361:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6362:          }
 6363:          
 6364:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6365: 
 6366:             const double efa  = nodeBnd->efa[jfr]; 
 6367:             const double emo  = nodeBnd->emo[jfr]; 
 6368: 
 6369:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6370:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6371:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6372: 
 6373: 
 6374:          } // for jfr
 6375: 
 6376:       } // if iettype
 6377: 
 6378:       switch (iettype) {
 6379:          case 1:
 6380:          case 2:
 6381:          case 4:
 6382:             nodeBnd->elbc = r_eic + r_eth;
 6383:             break;
 6384:          case 3:
 6385:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6386:             break;
 6387:          case 5:
 6388:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6389:             break;
 6390:       } // switch
 6391: 
 6392: 
 6393:       //Add inverse barometric effects
 6394:       if (iettype != 0 && inv_atm_bnd == 1) {
 6395:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6396:       }
 6397: 
 6398:    }
 6399: 
 6400: 
 6401:    __global__ void computeHorizontalViscosity(void) { 
 6402: 
 6403:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6404: 
 6405:       SIDE(side);
 6406: 
 6407:       if (side->isDry) return;
 6408: 
 6409:       for (int k = 0; k < nvrt; k++) {
 6410:          side->nuGradU[k] = {0.0, 0.0};
 6411:       }
 6412: 
 6413:       if constexpr(ihorcon == 1) {
 6414:          for (int k = side->kb; k < nvrt - 1; k++) {
 6415:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6416:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6417:             // By Zhang and Baptista.
 6418: 
 6419:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6420:             // This is a standard discretization of the Laplacian operator.
 6421:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6422:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6423:             // Gamma is hvis_coef0 in the code.
 6424:             // The value of gamma needs to be < 0.5.
 6425: 
 6426:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6427:             // side under consideration in each of the two possible elements that share the side.
 6428:             Vector2 sumU = {0.0, 0.0};
 6429:             for (int l = 0; l < 2; l++) {
 6430:                const Element *elem = side->elems[l];
 6431: 
 6432:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6433: 
 6434:                // Find the local index of the side in the element
 6435:                const int idxSide = elem->sideLocalIdx(side);
 6436: 
 6437:                // Find the two sides that are connected to the side under consideration
 6438:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6439:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6440: 
 6441:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6442: 
 6443:             }
 6444: 
 6445:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6446: 
 6447:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6448:    
 6449:          }
 6450:       }
 6451:       else if constexpr(ihorcon == 2) {
 6452:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6453:       }
 6454: 
 6455: 
 6456:    }
 6457: 
 6458: 
 6459:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6460: 
 6461:       // Set essential boundary conditions 
 6462:       NODE(node); // Each boundary node
 6463:       NodeBoundary *nodeBnd = node->nodeBnd;
 6464:       
 6465:  
 6466:       // Check if this node has essential BC
 6467:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6468: 
 6469:          // Verify BC value is valid
 6470:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6471: 
 6472:        
 6473:          // Set diagonal to 1 and zero off-diagonals
 6474:          for (int j = 0; j <= node->numNodes; j++) {
 6475:                node->coeffRow[j] = 0.0;
 6476:          }
 6477: 
 6478:          *(node->coeffDiag) = 1.0;
 6479: 
 6480: 
 6481:          // Set solution and RHS to BC value
 6482:          node->mX  = nodeBnd->elbc;
 6483:          node->qel = nodeBnd->elbc;
 6484: 
 6485:       } else {
 6486:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6487: 
 6488:          for (int j = 0; j < node->numNodes; j++) {
 6489:                const Node* nbNode = node->nodes[j];
 6490:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6491: 
 6492:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6493:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 6494: 
 6495:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6496:                   // Verify neighbor's BC value
 6497:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6498: 
 6499:                   // Subtract contribution to RHS
 6500:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6501:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6502:                }
 6503:          }
 6504: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6505:       }
 6506:    }
 6507: 
