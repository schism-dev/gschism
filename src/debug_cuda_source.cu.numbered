 6268: #ifdef DONTCOMPILE
 6269: __device__ void computeVerticalAdvection(void) {
 6270:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6271: 
 6272:    sdbt(1:2,:,:)=0.d0
 6273: 
 6274:    const Side *side = FROM kernel;
 6275: 
 6276:    if(side->isDry) return;
 6277: 
 6278:    // If side is wet...
 6279: 
 6280: 
 6281:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6282:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6283:    double ws[nvrt] = {} // w @ side
 6284:    int icount = 0;
 6285:    for (int j=0; j<2; j++) {
 6286:       const Element *elem = side->elements[j];
 6287:        
 6288:       if(elem != nullptr) {
 6289:          icount++;
 6290:          for (int k=0; k<nvrt; k++) {
 6291:             ws[k] = ws[k] + elem->w[k];
 6292:          }
 6293:       }
 6294:    }  // for j
 6295: 
 6296:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6297:    ws = ws/icount;
 6298: 
 6299:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6300:    // Splines allow for a smooth transition between vertical levels.
 6301:    // Splines have continuity restrictions at the internal knots, but
 6302:    // we have to provide the 1st derivatives at the endpoints.
 6303:    const int kbs = side->kbs; 
 6304:    
 6305:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6306:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6307:    initCubicSpline(kbs, nvrt, side, ws, up)
 6308: 
 6309:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6310:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6311:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6312: 
 6313:    // Total advection (average onto side)
 6314:    const Node *node1 = side->nodes[0];
 6315:    const Node *node2 = side->nodes[1];
 6316:    for (int k=kbs(i); k<nvrt; k++) {
 6317: 
 6318:       if constexpr(ics==1) {
 6319:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6320:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6321:       } else {
 6322:          // XXX IMPLEMENT THIS
 6323:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6324:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6325:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6326:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6327:       }  // if ics
 6328: 
 6329: 
 6330:    }
 6331: }
 6332: #endif
