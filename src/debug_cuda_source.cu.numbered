 5060:    __global__ void computeBottomDragVegetation(void) {
 5061:       // UNFINISHED. CHECK THIS:
 5062:       // How many kernels are needed? Why so many for loops?
 5063:       // Is the loop on sides needed?
 5064: 
 5065:       NODE(node);
 5066: 
 5067: 
 5068:       const int    kb      = node->kb;
 5069:       const double htot    = node->htot2(); 
 5070:       
 5071:       if (node->isDry) {
 5072:          // Default values for dry nodes
 5073:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5074:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5075: 
 5076:          return;
 5077:        
 5078:       }
 5079: 
 5080:       // Computes bottom drag Cd based on the selected nchi
 5081:       node->computeBottomDragCd();
 5082:       
 5083: 
 5084: 
 5085:       //   Bottom stress in m^2/s^2
 5086:       if (node->rho[kb + 1] >= -98.0)
 5087:       {
 5088:          const double mag_u = length(node->u2[kb + 1]);
 5089:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5090: 
 5091:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5092:          // !sediment erosion: this part needs more documentation
 5093:       }
 5094:     
 5095: 
 5096: 
 5097:       // Compute vegetation parameters
 5098:       //--------------------------------
 5099: 
 5100:       // SAV constants
 5101:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5102:       constexpr double veg_cfpsi = 0.16;
 5103: 
 5104:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5105:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5106: 
 5107:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5108:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5109:          int kbin = 0; // bin index
 5110:          for (int k = kb; k < nvrt; k++) {
 5111:             // Computes node height above the bottom level
 5112:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5113:             assert(false && "Vertical variation of vegetation not implemented");
 5114: 
 5115:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5116:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5117:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5118:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5119:             // } else {
 5120:             //    // Find the bin at which the current vertical level is
 5121:             //    while (kbin<nbins_veg_vert) {
 5122:             //       const double zn = node->z[kbin];
 5123:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5124:             //          break;
 5125:             //       } // if
 5126:             //       kbin++;
 5127:             //    } // while
 5128:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5129: 
 5130:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5131:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5132:                
 5133:             //    // Linear interpolation of the vegetation parameters
 5134:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5135:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5136:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5137:             // } // if rl10
 5138: 
 5139:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5140: 
 5141:          } // for k
 5142: 
 5143: 
 5144:       } else { // Ganthy (iveg==2)
 5145:       //  Modify canopy height, diameter, and density
 5146: 
 5147:          // Make sure there is vegetation on this node
 5148:          if (node->veg_h_unbent > 0.0) {
 5149:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5150: 
 5151:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5152:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5153:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5154: 
 5155:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5156:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5157:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5158:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5159:          } // if veg_h_unbent
 5160: 
 5161:          for (int k = 0; k < nvrt; k++) {
 5162:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5163:          } // for k
 5164:       
 5165: 
 5166:       } // if iveg
 5167:      
 5168: 
 5169:       // Compute vertical mean of veg_alpha3D
 5170:       if (iveg != 0) {
 5171:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5172:          double sum1=0.0;
 5173:          double sum2=0.0;
 5174:          // Integrate over each level under the canopy...
 5175:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5176:             const double Dz = node->Dz(k);
 5177: 
 5178:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5179:             sum2 += Dz;
 5180: 
 5181:          } // for k
 5182:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5183:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5184: 
 5185:       } // if iveg
 5186: 
 5187:    }
 5188: 
 5189:    __global__ void computeVegetationAndDragParameters(void) {
 5190:       // Computes the vegetation and drag model parameters:
 5191:       // chi, \tilde\chi, beta, \breve{H}
 5192:       
 5193:       SIDE(side);
 5194: 
 5195:       side->hhat = 0.0;
 5196:       side->chi2 = 0.0;
 5197:       side->chi = 0.0;
 5198:       side->veg_c2 = 0.0;
 5199:       side->veg_beta = 0.0;
 5200: 
 5201:       if (side->isDry) return;
 5202: 
 5203:       const double htot = side->htot2();
 5204:       const int    kb   = side->kb;
 5205: 
 5206:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5207: 
 5208:       const double veg_h     = side->veg_h();
 5209:       const double veg_nv    = side->veg_nv();
 5210:       const double veg_c     = side->veg_c();
 5211:       const double veg_beta  = side->veg_beta;
 5212:       const double veg_alpha = side->veg_alpha_vert_mean();
 5213: 
 5214:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5215:       // Velocity magnitude at the bottom level
 5216:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5217:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5218:       side->chi2 = side->Cd()*vmag1;
 5219:       side->chi  = side->chi2;
 5220:       if constexpr(iveg != 0) {
 5221:          const Node *n1 = side->n1;
 5222:          const Node *n2 = side->n2;
 5223:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5224:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5225:       }
 5226: 
 5227:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5228: 
 5229:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5230:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5231:       double magUa = 0.0;
 5232:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5233:          // 3D wet side with veg...
 5234: 
 5235:          double magUa = 0.0;
 5236:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5237:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5238: 
 5239:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5240:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5241:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5242: 
 5243:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5244:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5245: 
 5246:                // Velocity magnitude at the bottom (l) of the level
 5247:                const double ul = length(side->u2[k]);
 5248: 
 5249:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5250:                magUa += Dz*0.5*(uh + ul);
 5251: 
 5252:             } // if HasVegetation
 5253:          } // for k
 5254:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5255: 
 5256:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5257:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5258:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5259:             const double zCpy = side->zTopCanopy();
 5260:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5261:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5262:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5263:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5264:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5265:          } // if isSubmerged
 5266:       } // if iveg   
 5267: 
 5268:       // Computes the friction modified depth, \breve{H} in notes
 5269:       if (side->is2D()) { // 2D
 5270: 
 5271:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5272:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5273: 
 5274:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5275: 
 5276:          side->hhat = htot*htot/fricH; 
 5277: 
 5278:       } else { // 3D
 5279:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5280: 
 5281:          if constexpr(iveg != 0) {
 5282:             
 5283:             if (side->isSubmerged()) { 
 5284:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5285:                side->hhat -= veg_c*Hhat_alpha;
 5286: 
 5287:             } else { // Emergent
 5288:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5289:             }
 5290:          } // if iveg
 5291: 
 5292:          // Enforce positivity for 3D model
 5293:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5294:       } // if 3D
 5295: 
 5296:    }
 5297: 
 5298: 
 5299: 
 5300:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5301:    // Computes the density gradient between two elements, e1 and e2.
 5302:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5303:    // zero in the direction normal to the side. 
 5304:    // 
 5305:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5306:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5307:    //
 5308:    // Input:
 5309:    //    e1: Element
 5310:    //    e2: Neighbor element (or nullptr if boundary)
 5311:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5312:    //    k: Index of the half-level at which the density is interpolated
 5313:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5314:    // 
 5315:    // Output:
 5316:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5317:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5318: 
 5319:       if (e2 == nullptr || e2->isDry) {
 5320:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5321: 
 5322:          Side *side = e1->sides[j];
 5323:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5324:                  
 5325:          if constexpr(ics == 1) {
 5326:             vec = side->n; // Normal vector to the side
 5327:          } else {
 5328:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5329:             // IMPLEMENT THIS XXXXXX
 5330:             // !replace with xel, yel?
 5331:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5332:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5333:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5334:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5335:          } //ics
 5336:                    
 5337:          diffRho = 0.0;
 5338: 
 5339:       } else { //internal and wet
 5340:          if constexpr(ics==1) {
 5341:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5342: 
 5343:             // Vector from e1 to e2
 5344:             vec = e2->center - e1->center;
 5345: 
 5346:          } else { 
 5347:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5348:             // IMPLEMENT THIS XXXXXX
 5349:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5350:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5351:             //                   alow(j)=xctr2
 5352:             //                   bdia(j)=yctr2
 5353:          } // ics
 5354: 
 5355:          diffRho = rho2 - e1->demeanedDensity(k);
 5356:       }
 5357: 
 5358:    }
 5359: 
 5360:    __global__ void computeDensityCubicSplines(void) {
 5361:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5362: 
 5363:       ELEM(elem);
 5364: 
 5365:       if (elem->isDry) return;
 5366: 
 5367:       const int kb = elem->kb;
 5368: 
 5369:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5370:       if (elem->is2D()) {
 5371:          // In the 2D case, the density is constant at the prism level. 
 5372:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5373:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5374:       } else { //3D
 5375: 
 5376:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5377:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5378:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5379:          ///// XXXX CHECK INDICES!!!!!
 5380:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5381:       } // 2D/3D
 5382: 
 5383:    }
 5384: } // extern "C"
 5385: 
 5386: 
 5387: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5388: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5389: 
 5390:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5391: 
 5392:    const int kb  = elem->kb;
 5393:    const int kb2 = elem2->kb;
 5394: 
 5395:    // z-coordinate of prism of elem
 5396:    const double zp = elem->z_prism(k);
 5397: 
 5398:    double rho = 0.0;
 5399: 
 5400:    if (elem2->is2D()) {
 5401:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5402: 
 5403:    } else {  // 3D
 5404: 
 5405:       // eta_min may be < zmax
 5406:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5407:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5408: 
 5409:       // (Extrapolate density below bottom, we will fix it later)
 5410:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5411:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5412:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5413:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5414:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5415:    } // 2D/3D
 5416:      
 5417: 
 5418:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5419:    // Now we need to fix it.
 5420:    if (elem->z[k] < elem2->z[kb2]) {
 5421:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5422: 
 5423:       // There are two methods to adjust the density at the bottom of the element.
 5424:       // iunder_deep=0: 
 5425:       const double depth1 = abs(elem->z[kb]); // larger depth
 5426: 
 5427:       if (iunder_deep==0) {
 5428: 
 5429:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5430: 
 5431:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5432: 
 5433:       } else { // iunder_deep != 0
 5434: 
 5435:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5436: 
 5437:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5438: 
 5439:          //   Demeaned density at the same z coordinate as
 5440:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5441:          }
 5442: 
 5443:       } // if iunder_deep
 5444:    } // if elem->z[kb] < elem2->z[kb]
 5445: 
 5446:    return rho;
 5447: }
 5448: 
 5449: 
 5450: extern "C" {
 5451:    __global__ void computeDensityGradient(void) {
 5452: 
 5453:       if constexpr(ibc != 0) return;
 5454: 
 5455:          // Compute the horizontal density gradient at each element.
 5456:       // It works in two steps:
 5457:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5458:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5459:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5460:       //             gradRho.r1 = rho1 - rho0
 5461:       //             gradRho.r2 = rho2 - rho0
 5462:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5463:       // 
 5464:       //  NOTE: We use de-meaned densities.
 5465: 
 5466:       ELEM(elem);
 5467: 
 5468:       if (elem->isDry) return;
 5469: 
 5470:       const int kb  = elem->kb;
 5471:       const int i34 = elem->i34;
 5472: 
 5473:       for (int k = kb + 1; k < nvrt; k++) {
 5474:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5475:          //             gradRho.r1 = rho1 - rho0
 5476:          //             gradRho.r2 = rho2 - rho0
 5477:          int icount = 0;
 5478:          double sumRx = 0.0;
 5479:          double sumRy = 0.0;
 5480:          for (int j1=0; j1<i34; j1++) { 
 5481: 
 5482:             const int j2 = elem->nxq(j1 + 1);
 5483: 
 5484:             // Pairs of consecutive neighbor elements of elem
 5485:             const Element *e1 = elem->nghbElems[j1];
 5486:             const Element *e2 = elem->nghbElems[j2];
 5487: 
 5488:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5489:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5490:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5491: 
 5492:             // Compute the density difference and the vector from elem to e1 and e2
 5493:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5494:             double diffRho1, diffRho2;
 5495:             Vector2 vec1, vec2;
 5496:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5497:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5498: 
 5499:             const double rl1 = length(vec1);
 5500:             const double rl2 = length(vec2);
 5501:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5502: 
 5503:             const double delta = cross(vec1, vec2);
 5504:             const double sintheta = abs(delta)/(rl1*rl2);
 5505: 
 5506:             // To avoid problems, avoid elements with small angle between vectors
 5507:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5508:             const bool validEq = (sintheta > sin_one_deg);
 5509: 
 5510:             if (validEq) {
 5511:                // Solve the system of equations to get the density gradient at elem
 5512:                icount++;
 5513:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5514:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5515:                sumRx += Rx;
 5516:                sumRy += Ry;
 5517:             }
 5518:          } // for j1
 5519: 
 5520:          // Compute the average density gradient at elem
 5521:          if (icount==0) {
 5522:            // Bad mesh quality; bail out with 0 b-cc
 5523:            elem->gradRho[k] = {0.0, 0.0};
 5524:          } else {
 5525:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5526:          }
 5527: 
 5528:       } // for k
 5529: 
 5530:    }
 5531: 
 5532:    __global__ void computeBaroclinicTerm(void) {
 5533:    // Computes the baroclinic term at sides (at half levels).
 5534:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5535:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5536: 
 5537:       if (ibc == 1) return;
 5538: 
 5539:       SIDE(side);
 5540: 
 5541:       if (side->isDry) return;
 5542: 
 5543:       const Element *e1 = side->elems[0];
 5544:       const Element *e2 = side->elems[1]; 
 5545:       const int kb = side->kb;
 5546:       
 5547:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5548: 
 5549:       // interpolates vertically the density gradient of the two elements at the half level/
 5550: 
 5551:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 5552:       int k2 = max(kb, nvrt / 2);
 5553: 
 5554:       // Starts the integration at the surface and goes down to the bottom
 5555:       side->bcc[nvrt-1] = {0.0, 0.0};
 5556:       for (int k = nvrt - 2; k >= kb; k--) {
 5557:       // For each prism level (from surface to bottom)...
 5558: 
 5559:          // For both elements, interpolate density gradient at the side's half level.
 5560:          // The gradient at the side is the average of the gradients at the elements.
 5561:          // w1, w2 are used to take into account boundary sides, with just one element.
 5562:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5563:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5564:          const double wsum = w1 + w2;
 5565:          w1 = w1/wsum;
 5566:          w2 = w2/wsum;
 5567:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5568: 
 5569:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5570:          Vector2 gradRho = {0.0, 0.0};
 5571:          if (e1 != nullptr && k > kb) {
 5572:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5573:             
 5574:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5575:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5576:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5577: 
 5578:             // Grad(rho) vertically interpolated at the side's half level
 5579:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 5580: 
 5581:             // Projects the element density gradient to the side frame if needed.
 5582:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 5583: 
 5584:             // Adds the contribution of the density gradient at the side's half level
 5585:             gradRho += gradRho1*w1;
 5586:          }      
 5587:          if (e2 != nullptr && k > kb) {
 5588:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5589:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5590:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5591:             
 5592:             // Grad(rho) vertically interpolated at the side's half level
 5593:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 5594: 
 5595:             // Projects the element density gradient to the side frame if needed.
 5596:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 5597: 
 5598:             // Adds the contribution of the density gradient at the side's half level
 5599:             gradRho += gradRho2*w2;
 5600:          }
 5601: 
 5602:          
 5603:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5604:          // multiplied by -rampbc*(g/rho0) 
 5605:          const double grav3 = side->grav3();
 5606:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 5607: 
 5608:       } // for
 5609: 
 5610:    }
 5611: 
 5612: 
 5613: 
 5614:    __global__ void computeHorGradientAtSide(void) {
 5615: 
 5616:       // Compute the horizontal density gradient at each element.
 5617:       // It works in two steps:
 5618:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5619:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5620:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5621:       //             gradRho.r1 = rho1 - rho0
 5622:       //             gradRho.r2 = rho2 - rho0
 5623:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5624:       // 
 5625:       //  NOTE: We use de-meaned densities.
 5626: 
 5627:       SIDE(side);
 5628: 
 5629: 
 5630:       if (side->isDry) return;
 5631: 
 5632:       // Computes the gradient of the variables at the side center.
 5633:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5634:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5635:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5636: 
 5637:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5638:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5639:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5640:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5641: 
 5642:    }
 5643: 
 5644: 
 5645:    __global__ void solveMomentumEquations(double time) {
 5646: 
 5647:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5648:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5649: 
 5650:       SIDE(side);
 5651: 
 5652:       if (side->isDry) 
 5653:       {
 5654:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5655: 
 5656:          return;
 5657:       }
 5658: 
 5659:       const Node *n1 = side->n1;
 5660:       const Node *n2 = side->n2;
 5661: 
 5662:       const int kb = side->kb;
 5663: 
 5664:       const double veg_h = side->veg_h();
 5665:       const double grav3 = side->grav3();
 5666: 
 5667:       if (side->is2D()) {
 5668:          // Remember: Do not use htot2, which is updated.
 5669:          const double htot = side->htot1();
 5670:          const double hhat = side->hhat;
 5671: 
 5672:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5673: 
 5674:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5675:          const Vector2 tau2 = side->tau();
 5676: 
 5677:          // hat_gam has units of m/s
 5678: 
 5679:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5680:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5681:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5682: 
 5683:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5684: 
 5685: 
 5686:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5687: 
 5688:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5689: 
 5690:       }
 5691:       else { // 3D
 5692: 
 5693:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5694:          // 
 5695:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5696:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5697:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5698:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5699:          // k+1 and k.
 5700: 
 5701: 
 5702:          const int ndim = nvrt - kb;
 5703:          const double zTopCanopy = side->zTopCanopy();
 5704: 
 5705:          // Initialize the tridiagonal system
 5706:          for (int k = kb + 1; k < nvrt; k++) {
 5707:             
 5708:             const int kin = k - (kb + 1);
 5709: 
 5710:             // Vertical viscosity at the face center
 5711:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5712: 
 5713:  
 5714:             alow[kin] = 0.0;
 5715:             cupp[kin] = 0.0;
 5716:             bdia[kin] = 0.0;
 5717: 
 5718:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5719:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5720: 
 5721:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5722:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5723:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5724: 
 5725:             // First part: layers k, k+1
 5726:             if (k < nvrt - 1) {
 5727:                              
 5728:                if constexpr(iveg != 0) {
 5729: 
 5730:                   // If there is vegetation at this level...
 5731:                   if (zTopCanopy > side->zc[k]) {
 5732:                      // If the canopy is above the k layer...
 5733:                      
 5734:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5735:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5736:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5737:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5738: 
 5739:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5740:                      const double vmag2 = length(ut2);
 5741:                      const double vmag1 = length(side->u2[k]);
 5742:                      const double vmag = 0.5*(vmag1 + vmag2);
 5743:                      
 5744:                      // Computes the vegetation alpha at the face center
 5745:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5746: 
 5747:                      cff1 += veg_alpha_sd*dt*vmag;
 5748: 
 5749:                   } // if (zTopCanopy
 5750:                } // if iveg
 5751: 
 5752:                const double dzz = side->Dz(k + 1);
 5753:                const double tmp = dt*dfz/dzz;
 5754:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5755: 
 5756:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5757:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5758:             }
 5759: 
 5760: 
 5761:             // Second part: layers k-1, k
 5762:             if (k > kb + 1) {
 5763: 
 5764:                double cff1 = 1.0; //init \bar{c^k}
 5765: 
 5766:                if constexpr(iveg != 0) {
 5767:                   // If there is vegetation at this level...
 5768:                   if (zTopCanopy > side->zc[k-1]) {
 5769:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5770:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5771: 
 5772:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5773: 
 5774:                      const double vmag2 = length(ut2);
 5775:                      const double vmag1 = length(side->u2[k-1]);
 5776:                      const double vmag = 0.5*(vmag1 + vmag2);
 5777: 
 5778:                      // Computes the vegetation alpha at the face center
 5779:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5780:                      cff1 += veg_alpha_sd*dt*vmag;
 5781:                   } // if zTopCanopy
 5782: 
 5783:                } // if iveg
 5784: 
 5785:                const double dzz = side->Dz(k);
 5786:                const double tmp = dt*dfz/dzz;
 5787:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5788: 
 5789:                alow[kin] += cff1*dzz/6.0 - tmp;
 5790:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5791: 
 5792:             } else { // Bottom boundary
 5793:                // This occurs at the bottom, where the bottom drag is applied.
 5794: 
 5795:                bdia[kin] += dt*side->chi2; // XXXX
 5796: 
 5797:             } // if (k > kb + 1)
 5798: 
 5799: 
 5800:          } // for (int k
 5801: 
 5802: 
 5803: 
 5804:          // Computes the RHS.
 5805:          // -----------------
 5806: 
 5807:          //	BC to be imposed at the end.
 5808: 
 5809:          const Vector2 gradETP  = side->gradETP;
 5810:          const Vector2 gradPr   = side->gradPr;
 5811:          const Vector2 gradEta1 = side->gradEta1;
 5812:          const Vector2 gradEta2 = side->gradEta2;
 5813: 
 5814:          const Vector2 *btu = side->btu;
 5815:          const Vector2 *u2  = side->u2;
 5816:          const double coriolis = side->coriolis;
 5817:          const Vector2 *nuGradU = side->nuGradU;
 5818: 
 5819: 
 5820:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5821:          for (int k = kb + 1; k < nvrt; k++) {
 5822:             const int kin = k - kb - 1;
 5823: 
 5824:             const double dz_0 = side->Dz(k);
 5825:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5826: 
 5827:             rrhs[kin] = {0.0, 0.0};
 5828:             double dz = 0.0;
 5829: 
 5830:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5831:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5832:             if (k < nvrt  ) dz += dz_1;
 5833:             if (k > kb + 1) dz += dz_0;
 5834: 
 5835:             // Elevation gradient, atmospheric pressure and tidal potential
 5836:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5837: 
 5838:             // Coriolis, advection, wind stress, and horizontal viscosity
 5839:             if (k < nvrt - 1) {
 5840: 
 5841: 
 5842:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5843:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5844:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5845:                                                 
 5846: 
 5847:                //diff stress tensors 1006
 5848:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5849:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5850:                   assert(false && "Not implemented: itur == 5");
 5851:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5852:                }
 5853:                // else assert(false && "itur # Not implemented");
 5854: 
 5855:             } else { // k == nvrt - 1 SURFACE
 5856:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5857:                const Vector2 tau2 = side->tau();
 5858: 
 5859:                rrhs[kin] += dt*tau2;          
 5860: 
 5861:             } // if k<nvrt
 5862: 
 5863: 
 5864:             if (k > kb + 1) {
 5865:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5866:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5867:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5868: 
 5869:                // diff stress tensors 1006
 5870:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5871:                   assert(false && "Not implemented: itur == 5");
 5872:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5873:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5874:                }
 5875:                // else assert(false && "itur # Not implemented");
 5876: 
 5877: 
 5878:             } // if k>kbs + 1
 5879: 
 5880:             // Baroclinic
 5881:             Vector2 *bcc = side->bcc;
 5882:             if constexpr(ibc == 0) {
 5883:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5884:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5885: 
 5886:             } // if ibc==0
 5887: 
 5888:          } // k=kb + 1,nvrt
 5889: 
 5890: 
 5891:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5892: 
 5893:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5894:             const int kin = k - kb - 1;
 5895:    
 5896:             // Velocity is always clamped to maximum values
 5897:             side->u2[k] = clampVelocity(soln[kin]);
 5898:          } // k
 5899: 
 5900:       } // if side->is2D()
 5901:       
 5902: 
 5903:       // Impose velocity boundary condition at the bottom
 5904:       if constexpr(imm == 2) { // 3D bed deformation model
 5905:          double dep;
 5906:          Vector2 vel;
 5907: 
 5908:          assert(false && "Not implemented: imm == 2");
 5909:          //update_bdef(time, x0, y0, dep, vel);
 5910:          // side->u2[kb] = vel;
 5911: 
 5912:       } else { // imm = 0 or 1
 5913:          if (side->Cd() == 0.0) {
 5914:             side->u2[kb] = side->u2[kb + 1];
 5915: 
 5916:          } else if (side->is3D()) { // 3D no slip bottom   
 5917:             side->u2[kb] = {0.0, 0.0};
 5918: 
 5919:          }
 5920:           
 5921:       } // if imm
 5922: 
 5923:       // The velocities below the bottom level are set to zero
 5924:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5925: 
 5926: 
 5927:    }
 5928: 
 5929: 
 5930:    __global__ void applyMomentumBC(void) {
 5931: 
 5932:       SIDE_BND(sideBnd);
 5933: 
 5934:       Side *side = sideBnd->side;
 5935:       const BoundarySegment *segment = sideBnd->segment;
 5936:       const Node *n1 = side->n1;
 5937:       const Node *n2 = side->n2;
 5938: 
 5939:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5940: 
 5941:       const bool isLand = segment->isLand;
 5942:       const int ifltype = segment->ifltype;
 5943: 
 5944:       const int kb = side->kb;
 5945: 
 5946: 
 5947:       if (!isLand && ifltype != 0) {
 5948:          const Vector2 *ubc = sideBnd->ubc;
 5949:   
 5950:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5951:             
 5952:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5953:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5954: 
 5955:             if (ifltype == -1) {
 5956:                // Flather 1
 5957: 
 5958:                const double depth = side->depth();
 5959: 
 5960:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5961: 
 5962:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5963: 
 5964:                side->u2[k] = vnorm*side->n;
 5965: 
 5966:             } else if (ifltype == -2) { // Discharge
 5967: 
 5968:                const double eta1 = side->eta1();
 5969:                const double eta2 = side->eta2();
 5970:                const double htot = side->htot2();
 5971: 
 5972:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5973:                assert(false && "Not implemented: Discharge bc");
 5974:                // const double dischrg = discharge(eta1);
 5975:                const double dischrg = 0.0; // XXX REMOVE
 5976:                
 5977: 
 5978:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5979: 
 5980:                const double vnorm = dischrg*eta2/htot;
 5981: 
 5982:                side->u2[k] = vnorm*side->n;
 5983: 
 5984:             }
 5985:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5986:                const double vnorm = dot(side->u2[k], side->n);
 5987: 
 5988:                double rat;
 5989:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5990:                else              rat = segment->vobc2; // outgoing
 5991: 
 5992:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5993: 
 5994:             }
 5995:             else { // not Flather or 3D radiation
 5996:                side->u2[k] = ubc[k];
 5997: 
 5998:             } // if (segment->ifltype...
 5999: 
 6000:          }
 6001: 
 6002:       }
 6003:       else if (isLand) { // if it is land boundary side
 6004: 
 6005:          if constexpr(islip == 0) { // free slip
 6006: 
 6007:             for (int k = kb; k < nvrt; k++) {
 6008: 
 6009:                const Vector2 t = side->t();
 6010:                const Vector2 n = side->n;
 6011: 
 6012:                double vnorm = 0.0; // for most cases
 6013:                const double vtan = dot(side->u2[k], t);
 6014:                
 6015:                side->u2[k] = vtan*t - vnorm*n;
 6016: 
 6017:             }
 6018: 
 6019:          } else { // no slip
 6020:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6021: 
 6022:          }
 6023:       } // if (side segment type...
 6024: 
 6025:    
 6026: 
 6027:    }
 6028: 
 6029: 
 6030:    __global__ void shapiroFilter1(void) {
 6031:       // First step of the Shapiro filter (normally used if indvel<=0)
 6032:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6033: 
 6034:       SIDE(side);
 6035: 
 6036:       // Only internal wet sides are processed
 6037:       if (side->isDry || !(side->isInternal())) return;
 6038: 
 6039:       const int kb = side->kb;
 6040: 
 6041:       for (int mm = 0; mm < niter_shap; mm++) {
 6042: 
 6043:          for (int k = kb + 1; k < nvrt; k++) {
 6044:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6045:             Vector2 suru = {0.0, 0.0};
 6046: 
 6047:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6048: 
 6049:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6050: 
 6051:                int kin = k;
 6052:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6053:                
 6054:                // Get the velocity at the neighbor's side.
 6055:                Vector2 nSideU2 = nSide->u2[kin];
 6056: 
 6057:                // Projects the velocity to the current side frame if needed.
 6058:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6059: 
 6060:                suru += nSideU2;
 6061:             }
 6062: 
 6063:             // Reusing bcc as a temporary array to store the suru values.
 6064:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6065: 
 6066:          }
 6067:       }
 6068:    }
 6069: 
 6070:    __global__ void shapiroFilter2(void) {
 6071:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6072: 
 6073:       SIDE(side);
 6074: 
 6075: 
 6076:       if (side->isDry || !(side->isInternal())) return;
 6077: 
 6078:       const int kb = side->kb;
 6079: 
 6080:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6081: 
 6082:       if (side->is2D()) {
 6083:          side->u2[kb + 1] = side->bcc[kb + 1];
 6084:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6085: 
 6086:       } else {
 6087:          // 3D
 6088:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6089:          
 6090:       }
 6091: 
 6092:    }
 6093: 
 6094: 
 6095:    __global__ void ul0UpdateZCoords(void) {
 6096:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6097:       
 6098:       NODE(node);      
 6099: 
 6100: 
 6101:       if (false) { //node->isDry) { XXXXXXX
 6102: 
 6103:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6104: 
 6105:          if constexpr(ivcor != 1) node->kb = 0;
 6106: 
 6107:       } else {
 6108: 
 6109:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6110:          node->updateKb();
 6111: 
 6112:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6113: 
 6114:       }
 6115: 
 6116:       // We use the temp.b field to store the previous state of isDry.
 6117:       node->tmp.b = node->isDry;
 6118: 
 6119:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6120:       node->isDry = true;
 6121: 
 6122:    }
 6123: 
 6124:    __global__ void ul0ComputeDryElements(void)
 6125:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6126:    {
 6127:       ELEM(elem);
 6128: 
 6129:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6130: 
 6131:       elem->kb = 0;
 6132: 
 6133:       if (elem->isDry) return;
 6134: 
 6135: 
 6136:    //    if(elem->isDry2()) { // XXXX
 6137:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6138:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6139:    //        call parallel_abort(errmsg)
 6140:    //    }
 6141: 
 6142:       const Node *n1 = elem->nodes[0];
 6143:       const Node *n2 = elem->nodes[1];
 6144:       const Node *n3 = elem->nodes[2];  
 6145:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6146: 
 6147:       // Computes element's kb as the minimum of the nodes' kb.
 6148:       const int kb1 = n1->kb;
 6149:       const int kb2 = n2->kb;
 6150:       const int kb3 = n3->kb;
 6151:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6152: 
 6153: 
 6154:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6155: 
 6156: 
 6157:       // Computes the element z as the mean of the nodes z.
 6158:       for (int k = elem->kb; k < nvrt; k++) {
 6159: 
 6160:          // Compute the element z as the mean of the nodes z.
 6161:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6162:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6163:          elem->z[k] /= elem->i34;
 6164: 
 6165: if (k>elem->kb && elem->z[k] <= elem->z[k-1]) printf("EEEE elem->isDry = %d, idx1 = %d, idx2 = %d, idx3 = %d, z1[k] = %f, z2[k] = %f, z3[k] = %f, z1[k-1] = %f, z2[k-1] = %f, z3[k-1] = %f, k = %d, kb = %d, kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d, z[k] = %f, z[k-1] = %f\n", elem->isDry, n1->idx, n2->idx, n3->idx, n1->z[max(k, kb1)], n2->z[max(k, kb2)], n3->z[max(k, kb3)], n1->z[max(k-1, kb1)], n2->z[max(k-1, kb2)], n3->z[max(k-1, kb3)],  k, elem->kb, kb1, kb2, kb3, kb4, elem->z[k], elem->z[k-1]);
 6166:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6167:       }
 6168:                   
 6169:    }
 6170: 
 6171:    __global__ void ul0ComputeDryNodes(void)
 6172:    // Updates node's isDry based on the elements' isDry. 
 6173:    {
 6174:       NODE(node);
 6175: 
 6176:       node->isDry = true;
 6177: 
 6178:       // A node is wet if at least one of the elements sharing it is wet.
 6179:       for (int j = 0; j < node->numElements; j++) {
 6180:          const Element *elem = node->elements[j];
 6181:          if (!elem->isDry) {
 6182:             node->isDry = false;
 6183:             break;
 6184:          }
 6185:       }
 6186: 
 6187:        
 6188:    }
 6189: 
 6190: 
 6191:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6192:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6193:    // node->tmp.b is true if the node was previously dry.
 6194:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6195:    {
 6196:       NODE(node);
 6197:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6198: 
 6199:       // Avoid this the first time step.
 6200:       if (it == iths) return;  
 6201: 
 6202:       const bool wasDry = node->tmp.b;
 6203: 
 6204: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6205: 
 6206:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6207: 
 6208:          for (int k=0; k < nvrt; k++) {
 6209: 
 6210:             Vector3 utmp={0.0, 0.0, 0.0};
 6211: 
 6212:             double ttmp=0.0;
 6213:             double stmp=0.0;
 6214:             int icount=0;
 6215:             for (int j = 0; j < node->numNodes; j++) {
 6216: 
 6217:                const Node *nbrNode = node->nodes[j];
 6218:                
 6219:                const bool wasNbrDry = nbrNode->tmp.b;
 6220: 
 6221:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6222:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6223: 
 6224:                   icount++;
 6225: 
 6226:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6227:                   utmp += nbrNode->uvw2(k);
 6228:                   
 6229:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6230:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6231:                }
 6232:             }
 6233: 
 6234:             if (icount > 0) {
 6235:                const double inv_icount = 1.0/icount;
 6236:                utmp = inv_icount*utmp;
 6237:                node->u2[k]     = toVector2(utmp);
 6238:                node->w2[k]     = utmp.z;
 6239:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6240:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6241:             } else {
 6242:                node->u2[k] = {0.0, 0.0};
 6243:                node->w2[k] = 0.0;
 6244:                // Initialize tracers to 0.0??? XXXXX
 6245:             }
 6246:          }
 6247:       }
 6248:    }
 6249: 
 6250:   
 6251:    
 6252: 
 6253: 
 6254:    __global__ void ul0UpdateSides(int it, int iths) {
 6255:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6256:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6257:    // The dryness of the sides is updated in ul0UpdateSides2.
 6258: 
 6259:       SIDE(side);
 6260: 
 6261:       // A side is wet if and only if at least one of its elements is wet.
 6262:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6263:  
 6264:       const Node *n1 = side->n1;
 6265:       const Node *n2 = side->n2;
 6266:      
 6267:       const int kb1 = n1->kb;
 6268:       const int kb2 = n2->kb;
 6269: 
 6270:       side->kb = 0; // default when dry
 6271: 
 6272:       if (isWet) {
 6273: 
 6274:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6275: 
 6276:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6277: 
 6278:          side->kb = min(kb1, kb2);
 6279: 
 6280:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6281: 
 6282:          for (int k = side->kb; k < nvrt; k++) {
 6283:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6284: 
 6285:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6286: 
 6287:             // Compute velocity for re-wetted sides 
 6288:             if ((it != iths) && (side->isDry && isWet)) {
 6289: 
 6290:                Vector2 utmp={0.0, 0.0};
 6291: 
 6292:                int icount=0;
 6293: 
 6294:                // For all the sides on the two elements that share this side
 6295:                for (int j = 0; j < 2; j++) {
 6296:                   const Element *elem = side->elems[j];
 6297:                   if (elem == nullptr) continue;
 6298: 
 6299:                   for (int jj=0; jj < elem->i34; jj++) {
 6300:                      const Side *nSide = elem->sides[jj];
 6301:                      if (nSide->isDry) continue;
 6302: 
 6303:                      icount++;
 6304:                      utmp += nSide->u2[k];  
 6305:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6306:                   }
 6307:                }
 6308:                   
 6309:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6310:                if (icount > 0)  side->u2[k] = utmp/icount;
 6311:                else             side->u2[k] = {0.0, 0.0};
 6312:                   
 6313:             } // if ((it != iths) && (side->isDry && isWet))
 6314: 
 6315:          } // for k
 6316: 
 6317:       } // if isWet 
 6318:       
 6319: 
 6320: 
 6321:    }
 6322: 
 6323:    __global__ void ul0UpdateSides2(void) {
 6324:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6325:    
 6326:          SIDE(side);
 6327:    
 6328:          const Element *e1 = side->elems[0];
 6329:          const Element *e2 = side->elems[1];
 6330: 
 6331:          // A side is wet if and only if at least one of its elements is wet.
 6332:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6333: 
 6334:          // Update the side's dryness
 6335:          side->isDry = !isWet;
 6336: 
 6337:    }
 6338: 
 6339: 
 6340:    __global__ void zeroNodalVelocities(void) {
 6341:       NODE(node);
 6342: 
 6343:       for (int k = 0; k < nvrt; k++) {
 6344:          node->u2[k]   = {0.0, 0.0};
 6345:          node->w2[k]   = 0.0;
 6346:          node->utmp[k] = {0.0, 0.0};
 6347:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6348:       }
 6349:    }
 6350:  
 6351: 
 6352:    __global__ void computeNodalVerticalVelocities1(void) {
 6353:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6354:    // Adds the element's vertical velocity times the element's area.
 6355:       ELEM(elem);
 6356: 
 6357:       for (int j = 0; j < elem->i34; j++) {
 6358:          Node *node = elem->nodes[j];
 6359: 
 6360:          for (int k = node->kb; k < nvrt; k++) {
 6361:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6362:          }
 6363:          atomicAdd(&(node->tmp.d), elem->area);
 6364:       }
 6365:    }
 6366: 
 6367:    __global__ void computeNodalVerticalVelocities2(void) {
 6368:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6369:    // Divides by the total area of the elements sharing the    node.
 6370:       NODE(node);
 6371: 
 6372:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6373: 
 6374:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6375:    }
 6376: 
 6377: 
 6378:    __global__ void computeNodalHorizontalVelocities1(void) {
 6379: 
 6380:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6381: 
 6382:       ELEM(elem);
 6383: 
 6384:       if (elem->isDry) return;
 6385: 
 6386:       const int kb = elem->kb;
 6387:       const bool isTri = elem->isTri();
 6388: 
 6389:       if constexpr(indvel <= 0) {
 6390:          // Assuming discontinous hvel.
 6391: 
 6392:          if (isTri) { // For triangles
 6393:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6394:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6395: 
 6396:             for (int j = 0; j < 3; j++) {
 6397:                // For every node of the triangle...
 6398:                Node *node = elem->nodes[j];
 6399: 
 6400:                if (node->isDry) continue;
 6401: 
 6402:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6403:                const Side *s2 = elem->sides[(j + 1) % 3];
 6404:                const Side *s3 = elem->sides[(j + 2) % 3];
 6405: 
 6406:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6407: 
 6408:                atomicAdd(&(node->tmp.i), 1);
 6409: 
 6410:                for (int k = kb; k < nvrt; k++)  {
 6411:                   Vector2 s1u2 = s1->u2[k];
 6412:                   Vector2 s2u2 = s2->u2[k];
 6413:                   Vector2 s3u2 = s3->u2[k];
 6414: 
 6415:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6416:                   if constexpr(ics == 2) {
 6417:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6418:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6419:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6420:                   }
 6421: 
 6422:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 6423:                   u = clampVelocity(u);
 6424:                   atomicAdd(&(node->utmp[k].x), u.x);
 6425:                   atomicAdd(&(node->utmp[k].y), u.y);
 6426: 
 6427:                }
 6428: 
 6429:             }
 6430:          }
 6431:          else { // For quads
 6432:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6433: 
 6434:          }
 6435: 
 6436:       }
 6437:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6438:       
 6439:    }
 6440: 
 6441: 
 6442:    __global__ void computeNodalHorizontalVelocities2(void) {
 6443:       NODE(node);
 6444: 
 6445:       const int nodeCount = node->tmp.i;
 6446: 
 6447:       if (nodeCount == 0) 
 6448:       {
 6449:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6450:          return;
 6451:       }
 6452: 
 6453:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6454:       
 6455:       const int kb = node->kb;
 6456: 
 6457:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6458:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6459:       
 6460:       
 6461:    }   
 6462: 
 6463:  
 6464: 
 6465:    __global__ void resetVelocityOpenBndNodes(void) {
 6466:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6467: 
 6468:       NODE_BND(nodebnd);
 6469: 
 6470:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6471:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6472:       }
 6473: 
 6474:    }
 6475: 
 6476: 
 6477:    __global__ void setVelocityOpenBndNodes(void) {
 6478:    // For open boundary nodes sets their velocity to the imposed values.
 6479: 
 6480:       SIDE_BND(sidebnd);
 6481: 
 6482:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6483:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6484:          // to its segment to the average of the side velocity.
 6485: 
 6486:          for (int k = 0; k < nvrt; k++) {
 6487:             Node *n1 = sidebnd->side->n1;
 6488:             Node *n2 = sidebnd->side->n2;
 6489: 
 6490: 
 6491:             Vector2 n1_u2(n1->u2[k]);
 6492:             Vector2 n2_u2(n2->u2[k]);
 6493: 
 6494:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6495:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6496:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6497:             }
 6498:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6499:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6500:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6501:             }
 6502: 
 6503:          }
 6504: 
 6505:       }
 6506: 
 6507:    }
 6508: 
 6509: 
 6510:    __global__ void computeVerticalVelocity(void) {
 6511:       // Computes the vertical velocity at the (2D) element's centroid.
 6512:       // In this function we will be considering volumetric elements, with side faces and a 
 6513:       // bottom and a top face. We will call them SFs, BF and TF.
 6514:       // It computes the flux coming from BF and the SFs.
 6515:       // If the bed is moving, it takes that into account.
 6516:       // Since water is incompressible, the integral of the velocity times the normal vector
 6517:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6518:       // and the BF is equal to the flux going out from the TF.
 6519:       // TF = - BF - sum(SFs).
 6520:       // It then computes the horizontal velocity at the center of TF.
 6521:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6522:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6523:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6524: 
 6525:       ELEM(elem);
 6526: 
 6527:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6528: 
 6529:       if (elem->isDry) return;
 6530: 
 6531:       const int kb = elem->kb;
 6532:       const bool isTri = elem->isTri();
 6533: 
 6534:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6535: 
 6536:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6537:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6538:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6539: 
 6540:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6541: 
 6542:       double area3D;
 6543: 
 6544:       // Bottom face flux
 6545:       double bottomFlux = 0.0;
 6546:       Vector2 u2meanBottom = {0.0, 0.0};
 6547:       const Vector2 gradh = elem->grad2(&Node::depth);
 6548:       if constexpr(imm==2) {
 6549:          Vector3 ubed;
 6550: 
 6551:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6552:          // updateBDEF(ubed);
 6553:      
 6554:          // const double bflux0 = dot(ubed, elem_n1);
 6555: 
 6556:          // elem->w[kb] += ubed.z;
 6557:       }
 6558:       else {
 6559:          u2meanBottom = elem->mean(kb, &Side::u2);
 6560:          if constexpr(ics == 2) {
 6561:             // Project the velocity from the side frame to the element frame
 6562:             u2meanBottom = elem->frame.projHorVec(u2meanBottom, elem->frame);
 6563:          }
 6564: 
 6565:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6566:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6567: 
 6568:          bottomFlux = - dot(gradh, u2meanBottom);
 6569:       } // if imm
 6570: 
 6571:       // Compute w for kb+1 to nvrt-1
 6572:       for (int l = kb; l < nvrt - 1; l++) {
 6573: 
 6574:          // normal vector to the top face of the "volumetric" element (3D)
 6575:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6576: 
 6577:          // Compute the total flux at the sides
 6578:          double sideFlux = 0.0;
 6579: 
 6580:          for (int j = 0; j < elem->i34; j++) {
 6581:             const Side *side = elem->sides[j];
 6582: 
 6583:             const double sideArea = side->area(l);
 6584:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6585:             const double sign = elem->ssign[j]; 
 6586: 
 6587:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6588:          }
 6589:          
 6590:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6591:          //velocities at the centers of the sides
 6592:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6593: 
 6594:          // The flx at the top ace can be computed from the other flows.
 6595:          const double topFlux = - sideFlux - bottomFlux;
 6596:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6597: 
 6598:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6599: 
 6600:          elem_n1 = elem_n2;
 6601: 
 6602:          bottomFlux = - topFlux;
 6603:       }
 6604:    }  
 6605: 
 6606: 
 6607: 
 6608: 
 6609: 
 6610: 
 6611: 
 6612: // !===============================================================================
 6613: // !===============================================================================
 6614: 
 6615: } // extern "C"
 6616: 
 6617: #ifdef DONTCOMPILE
 6618: __device__ void computeVerticalAdvection(void) {
 6619:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6620: 
 6621:    sdbt(1:2,:,:)=0.d0
 6622: 
 6623:    const Side *side = FROM kernel;
 6624: 
 6625:    if(side->isDry) return;
 6626: 
 6627:    // If side is wet...
 6628: 
 6629: 
 6630:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6631:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6632:    double ws[nvrt] = {} // w @ side
 6633:    int icount = 0;
 6634:    for (int j=0; j<2; j++) {
 6635:       const Element *elem = side->elements[j];
 6636:        
 6637:       if(elem != nullptr) {
 6638:          icount++;
 6639:          for (int k=0; k<nvrt; k++) {
 6640:             ws[k] = ws[k] + elem->w[k];
 6641:          }
 6642:       }
 6643:    }  // for j
 6644: 
 6645:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6646:    ws = ws/icount;
 6647: 
 6648:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6649:    // Splines allow for a smooth transition between vertical levels.
 6650:    // Splines have continuity restrictions at the internal knots, but
 6651:    // we have to provide the 1st derivatives at the endpoints.
 6652:    const int kbs = side->kbs; 
 6653:    
 6654:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6655:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6656:    initCubicSpline(kbs, nvrt, side, ws, up)
 6657: 
 6658:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6659:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6660:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6661: 
 6662:    // Total advection (average onto side)
 6663:    const Node *node1 = side->nodes[0];
 6664:    const Node *node2 = side->nodes[1];
 6665:    for (int k=kbs(i); k<nvrt; k++) {
 6666: 
 6667:       Vector2 bcc1 = node1->bcc[k];
 6668:       Vector2 bcc2 = node2->bcc[k];
 6669:       if constexpr(ics == 2) {
 6670:          // Project the velocities from the node frames to the side frame
 6671:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 6672:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 6673:       }
 6674: 
 6675:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 6676:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 6677: 
 6678:    }
 6679: }
 6680: #endif
 6681: 
 6682: 
 6683: extern "C" {
 6684:    __global__ void computeElemAverageGhat(void) {
 6685:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6686: 
 6687:       ELEM(elem);
 6688:       
 6689:       elem->ghat1= {0.0, 0.0};  
 6690: 
 6691:       if constexpr(ihydraulics != 0) {
 6692:          if (nhtblocks > 0 && elem->isblock) return;
 6693:       }
 6694: 
 6695:       
 6696:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 6697:       // cff1-3: coefficients for 2D/3D
 6698: 
 6699:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6700:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6701:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 6702: 
 6703:       if (elem->isDry) return;
 6704: 
 6705:       // Average of the coefficients
 6706:       double av_cff1 = 0.0;  // av. for cff1
 6707:       double av_cff2 = 0.0;  // av. for cff2
 6708:       double av_cff3 = 0.0;  // av. for cff3
 6709:       double av_df = 0.0;  // av. for H^\alpha / H
 6710:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6711:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6712: 
 6713:       const int i34 = elem->i34;
 6714:       const int kb  = elem->kb;
 6715: 
 6716:       for (int j=0; j<i34; j++) {
 6717:          // For each node and side in the element...
 6718: 
 6719:          const Node *node = elem->nodes[j];
 6720:          const Side *side = elem->sides[j];
 6721: 
 6722:          const double chi      = side->chi;
 6723:          const double veg_c2   = side->veg_c2;
 6724:          const double veg_beta = side->veg_beta;
 6725:          const double veg_h    = side->veg_h();
 6726:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6727: 
 6728:          // Node - const in elem
 6729:          elem->gradEta += node->eta2*elem->gradPhi[j];  // gradPhi is always in the element frame
 6730:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6731: 
 6732:          if (elem->depth >= tip_dp) {
 6733:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6734:          }
 6735: 
 6736:          
 6737:          const double htot  = side->htot2();        // Total depth at the side
 6738:          const double zctr2 = side->zTopCanopy();  
 6739: 
 6740:          double cff1; 
 6741:          double cff2; 
 6742:          double cff3;   
 6743:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6744:          // coefficients applied to 2D/3D case 
 6745:             cff1 = side->hhat/htot;
 6746:             cff2 = 0.0;
 6747:             cff3 = 0.0;
 6748:          } else { //3D
 6749:             //Init for no-veg case
 6750:             cff1 = 1.0;
 6751:             cff2 = 1.0;
 6752:             cff3 = 0.0;
 6753: 
 6754:             if constexpr(iveg != 0) {
 6755:                // Computes coefficients used with vegetation terms G1, G2
 6756:                // cff1, cff3 are used for the first two terms in G1, G2:
 6757:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6758:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6759:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6760:                if(veg_h < 0.99*htot) { // submergent vegetation
 6761:                   cff1=1;
 6762:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6763:                   cff3 = veg_c;
 6764: 
 6765:                } else { // emergent vegetation
 6766:                   cff1 = 1.0/(1.0 + veg_c2);
 6767:                   cff2 = cff1;
 6768:                   cff3 = 0.0;
 6769: 
 6770:                }
 6771:             } // if iveg
 6772:          } //  2D/3D
 6773: 
 6774:          av_cff1 += cff1/i34;
 6775:          av_cff2 += cff2/i34;
 6776:          av_cff3 += cff3/i34;
 6777:          av_cff2_chi += cff2*chi/i34;
 6778:          av_cff3_chi += cff3*chi/i34;
 6779:          av_df += min(htot, veg_h)/(htot*i34);
 6780: 
 6781: 
 6782:          // btrack values: U^\star, U^{\star\alpha}
 6783:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6784:          Vector2 Ustar       = {0.0, 0.0}; 
 6785:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6786: 
 6787:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6788:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6789:          } else { //3D
 6790:             for (int k = side->kb + 1; k < nvrt; k++) {
 6791:             
 6792:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6793:                Ustar += w2;
 6794: 
 6795:                if constexpr(iveg != 0) {
 6796:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6797:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6798:                        Ustar_alpha += zrat*w2; // XXXX
 6799:                    }
 6800:                }  // if iveg
 6801:             }  // for k
 6802:          }  //2D/3D
 6803: 
 6804:          // If needed, project the side velocities to the element frame
 6805:          if constexpr(ics==2) {
 6806:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 6807:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 6808:          }
 6809:          
 6810: 
 6811:          // Add btrack & surface stress terms to \breve{G} first
 6812:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6813: 
 6814: 
 6815: 
 6816:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 6817:          Vector2 tau    = side->tau();  
 6818:          Vector2 ubstar = side->btu[side->kb + 1];  
 6819: 
 6820:          // If needed, project tau and ubstar to the element frame
 6821:          if constexpr(ics==2) {
 6822:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 6823:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 6824:          }
 6825: 
 6826:          // Term for surface and bottom stress
 6827:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6828: 
 6829: 
 6830:          // All terms in F,F^\alpha,f_b except baroclinic
 6831:          // F, f_b: all explicit terms excluding vegetation 
 6832:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6833:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6834:          const double coriolis = side->coriolis;
 6835:          Vector2 F  =  coriolis*side->U;  // F_x
 6836:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6837:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6838: 
 6839:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6840:             
 6841:             for (int k = side->kb; k < nvrt; k++) {
 6842:                if (zctr2 > side->zc[k-1]) {
 6843:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6844:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6845:                    Fa +=  coriolis*w2*zrat;
 6846:                } // if zctr2
 6847:             } // k
 6848:          } // iveg
 6849: 
 6850:          // Integrate horizontal viscosity force vertically
 6851:          for (int k=side->kb + 1; k<nvrt; k++) {
 6852:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6853: 
 6854:             F += levelHorVisc;
 6855: 
 6856:             // Vegetation term
 6857:             if constexpr(iveg!=0) {
 6858:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6859:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6860:                   Fa += levelHorVisc*zrat;
 6861:                } 
 6862:             } // if iveg
 6863:          } // for k
 6864: 
 6865:          // Get nu*grad(U) at the side's bottom level
 6866:          Vector2 nuGradU = side->nuGradU[side->kb];
 6867: 
 6868:          fb += nuGradU;
 6869: 
 6870:          // If needed, project vectorsF, fb and Fa to the element frame
 6871:          if constexpr(ics==2) {
 6872:             F    = side->frame.projHorVec(F,    elem->frame);
 6873:             fb   = side->frame.projHorVec(fb,   elem->frame);
 6874:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 6875:          } // if ics
 6876: 
 6877:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6878:       } // for j (nodes and sides)
 6879: 
 6880:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6881:          
 6882:       // Finish off terms in F, F^\alpha and f_b
 6883:       const double grav3 = elem->mean(&Node::grav2);
 6884:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6885: 
 6886: 
 6887:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6888:       for (int j=1; j<i34; j++) { 
 6889:          // For each side in the element...
 6890:          const Side *side = elem->sides[j];
 6891:          const double chi = side->chi;
 6892: 
 6893:          const double htot = side->htot2();
 6894:          const double veg_h = side->veg_h();
 6895:          const Vector2 F  = htot*fb;
 6896:          const Vector2 Fa = min(htot, veg_h)*fb;
 6897: 
 6898:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6899:       } // for j
 6900: 
 6901:       //botf1 etc are already in elem frame
 6902:       elem->ghat1 += tmp/i34;
 6903: 
 6904:       // Baroclinic force
 6905:       if constexpr(ibc==0) {
 6906:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6907: 
 6908:          Vector2 Fa = {0.0, 0.0};
 6909:          Vector2 intGradRho = {0.0, 0.0};
 6910:          
 6911:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 6912:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 6913:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6914: 
 6915:             // \in F [m^2/s/s]
 6916:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6917:          }
 6918: 
 6919:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6920:          const Vector2 F = av_df*Fa; //approx
 6921:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6922: 
 6923:       } // if ibc
 6924: 
 6925: 
 6926: 
 6927:    }
 6928: 
 6929: } // extern "C"
 6930: 
 6931: 
 6932: 
 6933: #ifdef DONTCOMPILE
 6934: __global__ void checkMassConservation(Tracers* sumtr) {
 6935: 
 6936:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6937: 
 6938:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6939: 
 6940:    Element *elem = &(mesh->localElemData[i]);
 6941: 
 6942:    // Skip dry elements
 6943:    if (elem->isDry) return;
 6944: 
 6945:    // Local sum array for this thread
 6946:    double localSum[N_TRACERS] = {0.0};
 6947: 
 6948:    // Sum over vertical levels for this element
 6949:    const int kbe = elem->kbe;
 6950:    const double area = elem->area;
 6951: 
 6952:    for (int k = kbe; k < nvrt; k++) {
 6953:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6954:       
 6955:       // Accumulate tracer mass
 6956:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6957:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6958:       }
 6959:    }
 6960: 
 6961:    //  This function returns per element sums. A reduction must be done on the host side.
 6962: }
 6963: 
 6964: 
 6965: __global__ void transport(void) {
 6966: 
 6967:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6968: 
 6969:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6970: 
 6971:    Element *elem = &(mesh->localElemData[ie]);
 6972: 
 6973:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6974: 
 6975:                for (int m=0; m<ntr; m++) {
 6976:                   for (int k=kbe(ie); k<nvrt; k++) {
 6977:                      // Calculate each polynomial's weight 
 6978:                      wm=0.d0; sum1=0.d0; 
 6979:                      wm1=0.d0; wm2=0.d0; 
 6980:                      for (int i=0; i<elem->nweno2; i++) {
 6981:                   
 6982:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6983:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6984:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6985:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6986:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6987:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6988:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6989:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6990:                      // -----------------Hu and Shu (1999)'s method----------------
 6991:                      b4=b1+b2+b3
 6992: 
 6993: //Error: add PRODUCTION CPP
 6994: #ifdef DEBUG
 6995:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6996:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6997:                     call parallel_abort(errmsg)
 6998:                   }
 6999: #endif
 7000: 
 7001:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7002:                   // !----test-------------- 
 7003:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7004:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7005:                   // !wm(i)=wm1(i)*wm2(i)
 7006:                   // !---------------------- 
 7007:                   sum1=sum1+wm(i)
 7008:                 } // end for i
 7009: 
 7010:                 wm=wm/sum1
 7011: 
 7012:                 for (int j=0; j<elem->i34; j++) {
 7013: 
 7014:                   const Side *side  = elem->sides[j];
 7015:                   const Node *node1 = side->n1;
 7016:                   const Node *node2 = side->n2;
 7017: 
 7018:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7019:                      trsd=0.d0
 7020:                      for (int kk=0; kk<nquad; kk++) {
 7021:                         for (int i=0; i<elem->nweno2; i++) {
 7022:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7023:                         } // end for i   
 7024:                      } // end for kk
 7025:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7026:                   } // outward flux
 7027:                } // end for j=1,i34(ie) ! side
 7028:             }
 7029:          }
 7030:               
 7031: 
 7032: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7033: //             //   calculate each polynomial's weight 
 7034: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7035: //                 wm=0.d0; sum1=0.d0
 7036: //                 do i=1,nweno1(ie) !for each polynomial
 7037: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7038: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7039: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7040: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7041: //                   wm(i)=b2
 7042: //                   sum1=sum1+b2
 7043: //                   !wm(i)=1.d0
 7044: //                   !sum1=sum1+1.d0
 7045: 
 7046: // // Error: PRODUCTION
 7047: // #ifdef DEBUG
 7048: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7049: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7050: //                     call parallel_abort(errmsg)
 7051: //                   endif
 7052: // #endif
 7053: 
 7054: //                 enddo !i
 7055: //                 wm=wm/sum1 !final weight
 7056: 
 7057:                 for (int j=0; j<elem->i34; j++) { // side
 7058:                   const Side *side = elem->sides[j];
 7059:                   const Node *node1 = side->n1;
 7060:                   const Node *node2 = side->n2;
 7061: 
 7062:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7063:                     trsd=0.d0
 7064:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7065:                       for (int i=0; i<elem->nweno1; i++) {
 7066:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7067:                       }
 7068:                     enddo //kk
 7069:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7070:                   } // outward flux
 7071:                 } // end for j=1,i34(ie) ! side
 7072:               } // end for k; ntr 
 7073: 
 7074:             else !simple upwind method
 7075:               do j=1,i34(ie)
 7076:                 jsj=elside(j,ie)
 7077:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7078:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7079:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7080:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7081:                   endif
 7082:                 enddo  !vertical layers
 7083:               enddo !j=1,i34(ie) ! side
 7084:             endif !order of accuracy
 7085: 
 7086:          //  enddo !ie
 7087: // !$OMP     end do
 7088: 
 7089: // !$OMP     master
 7090: //           !message passing
 7091: //           if (nproc>1) then
 7092: //             !make a copy of side concentrations
 7093: //             trsd_tmp0=trsd_tmp 
