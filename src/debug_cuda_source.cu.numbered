 1773:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1774:       // Compute the different time ramps used in the code 
 1775:       // This function is performed by just one thread
 1776: 
 1777:       rampbc = 1.0;
 1778:       if constexpr(ibc == 0) {
 1779:          if (drampbc > 0.0) {
 1780:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1781:          } else {
 1782:             rampbc = 1.0;
 1783:          }
 1784:       }
 1785: 
 1786:       if (nws != 0) {
 1787:          if (drampwind > 0.0) {
 1788:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1789:          } else {
 1790:             rampwind = 1.0;
 1791:          }
 1792:       }
 1793: 
 1794:       if (drampwafo > 0.0) {
 1795:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1796:       } else {
 1797:          rampwafo = 1.0;
 1798:       }
 1799: 
 1800:       // For source/sinks
 1801:       if (if_source && dramp_ss > 0.0) {
 1802:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1803:       } else {
 1804:          ramp_ss = 1.0;
 1805:       }
 1806: 
 1807:       if (dramp > 0.0) {
 1808:          ramp = tanh(2.0*time/86400.0/dramp);
 1809:       } else {
 1810:          ramp = 1.0;
 1811:       }
 1812: 
 1813: 
 1814:    }
