 3888:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3889: 
 3890:       NODE_BND(nodeBnd);
 3891: 
 3892:       Node *node = nodeBnd->node;
 3893: 
 3894:       node->ETP = 0.0;
 3895: 
 3896:       for (int j=0; j<ntip; j++) {
 3897: 
 3898:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3899:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3900:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3901: 
 3902:          if constexpr(iloadtide==1) { // loading tide
 3903:             assert(false && "Loading tide not implemented");
 3904:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3905:          }
 3906:          
 3907:       }
 3908:       
 3909:    }
