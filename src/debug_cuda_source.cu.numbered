 6817: #ifdef DONTCOMPILE
 6818: __device__ void computeVerticalAdvection(void) {
 6819:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6820: 
 6821:    sdbt(1:2,:,:)=0.d0
 6822: 
 6823:    const Side *side = FROM kernel;
 6824: 
 6825:    if(side->isDry) return;
 6826: 
 6827:    // If side is wet...
 6828: 
 6829: 
 6830:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6831:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6832:    double ws[nvrt] = {} // w @ side
 6833:    int icount = 0;
 6834:    for (int j=0; j<2; j++) {
 6835:       const Element *elem = side->elements[j];
 6836:        
 6837:       if(elem != nullptr) {
 6838:          icount++;
 6839:          for (int k=0; k<nvrt; k++) {
 6840:             ws[k] = ws[k] + elem->w[k];
 6841:          }
 6842:       }
 6843:    }  // for j
 6844: 
 6845:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6846:    ws = ws/icount;
 6847: 
 6848:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6849:    // Splines allow for a smooth transition between vertical levels.
 6850:    // Splines have continuity restrictions at the internal knots, but
 6851:    // we have to provide the 1st derivatives at the endpoints.
 6852:    const int kbs = side->kbs; 
 6853:    
 6854:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6855:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6856:    initCubicSpline(kbs, nvrt, side, ws, up)
 6857: 
 6858:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6859:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6860:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6861: 
 6862:    // Total advection (average onto side)
 6863:    const Node *node1 = side->nodes[0];
 6864:    const Node *node2 = side->nodes[1];
 6865:    for (int k=kbs(i); k<nvrt; k++) {
 6866: 
 6867:       if constexpr(ics==1) {
 6868:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6869:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6870:       } else {
 6871:          // XXX IMPLEMENT THIS
 6872:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6873:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6874:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6875:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6876:       }  // if ics
 6877: 
 6878: 
 6879:    }
 6880: }
 6881: #endif
 6882: 
 6883: 
 6884: extern "C" {
 6885:    __global__ void computeElemAverageGhat(void) {
 6886:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6887: 
 6888:       ELEM(elem);
 6889:       
 6890:       elem->ghat1= {0.0, 0.0};  
 6891: 
 6892:       if constexpr(ihydraulics != 0) {
 6893:          if (nhtblocks > 0 && elem->isblock) return;
 6894:       }
 6895: 
 6896:       if (elem->isDry) return;
 6897: 
 6898:       // Wet elements.
 6899:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6900:       // tidal potential, horizontal diffusion, and baroclinic etc
 6901:       // Remember to update both fb and F 
 6902:       // If ics=2, ghat1 are in eframe (ll)
 6903:       // cff1-3: coefficients for 2D/3D
 6904:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6905:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6906:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6907: 
 6908:       double av_cff1 = 0.0;  // av. for cff1
 6909:       double av_cff2 = 0.0;  // av. for cff2
 6910:       double av_cff3 = 0.0;  // av. for cff3
 6911:       double av_df = 0.0;  // av. for H^\alpha / H
 6912:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6913:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6914: 
 6915:       const int i34 = elem->i34;
 6916:       const int kb = elem->kb;
 6917: 
 6918:       for (int j=0; j<i34; j++) {
 6919:          // For each node and side in the element...
 6920: 
 6921:          const Node *node = elem->nodes[j];
 6922:          const Side *side = elem->sides[j];
 6923: 
 6924:          const double chi      = side->chi;
 6925:          const double veg_c2   = side->veg_c2;
 6926:          const double veg_beta = side->veg_beta;
 6927:          const double veg_h    = side->veg_h();
 6928:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6929: 
 6930:          // Node - const in elem
 6931:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6932:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6933: 
 6934:          if (elem->depth >= tip_dp) {
 6935:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6936:          }
 6937: 
 6938:          
 6939:          const double htot  = side->htot2();        // Total depth at the side
 6940:          const double zctr2 = side->zTopCanopy();  
 6941: 
 6942:          double cff1; 
 6943:          double cff2; 
 6944:          double cff3;   
 6945:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6946:          // coefficients applied to 2D/3D case 
 6947:             cff1 = side->hhat/htot;
 6948:             cff2 = 0.0;
 6949:             cff3 = 0.0;
 6950:          } else { //3D
 6951:             //Init for no-veg case
 6952:             cff1 = 1.0;
 6953:             cff2 = 1.0;
 6954:             cff3 = 0.0;
 6955: 
 6956:             if constexpr(iveg != 0) {
 6957:                // Computes coefficients used with vegetation terms G1, G2
 6958:                // cff1, cff3 are used for the first two terms in G1, G2:
 6959:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6960:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6961:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6962:                if(veg_h < 0.99*htot) { // submergent vegetation
 6963:                   cff1=1;
 6964:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6965:                   cff3 = veg_c;
 6966: 
 6967:                } else { // emergent vegetation
 6968:                   cff1 = 1.0/(1.0 + veg_c2);
 6969:                   cff2 = cff1;
 6970:                   cff3 = 0.0;
 6971: 
 6972:                }
 6973:             } // if iveg
 6974:          } //  2D/3D
 6975: 
 6976:          av_cff1 += cff1/i34;
 6977:          av_cff2 += cff2/i34;
 6978:          av_cff3 += cff3/i34;
 6979:          av_cff2_chi += cff2*chi/i34;
 6980:          av_cff3_chi += cff3*chi/i34;
 6981:          av_df += min(htot, veg_h)/(htot*i34);
 6982: 
 6983: 
 6984:          // btrack values: U^\star, U^{\star\alpha}
 6985:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6986:          Vector2 Ustar       = {0.0, 0.0}; 
 6987:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6988: 
 6989:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6990:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6991:          } else { //3D
 6992:             for (int k = side->kb; k < nvrt; k++) {
 6993:             
 6994:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6995:                Ustar += w2;
 6996: 
 6997:                if constexpr(iveg != 0) {
 6998:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6999:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7000:                        Ustar_alpha += zrat*w2; // XXXX
 7001:                    }
 7002:                }  // if iveg
 7003:             }  // for k
 7004:          }  //2D/3D
 7005:          
 7006: 
 7007:          // Add btrack & surface stress terms to \breve{G} first
 7008:          if constexpr(ics==1) {
 7009: 
 7010:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7011: 
 7012:          } else {
 7013:             // XXX IMPLEMENT THIS
 7014:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7015:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7016:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7017:          }  // if ics
 7018: 
 7019:          // Surface and bottom stress terms
 7020:          if constexpr(ics==1) {
 7021:             const Vector2 tau    = side->tau();
 7022:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7023: 
 7024:             // Term for surface and bottom stress
 7025:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7026: 
 7027:          } else {
 7028:             assert(false && "computeElemAverageGhat: Not implemented");
 7029:             // XXX IMPLEMENT THIS
 7030:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7031:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7032:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7033:             // tau_x=(vn1+tt1)/2.d0
 7034:             // tau_y=(vn2+ss1)/2.d0
 7035:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7036:          }  // if ics
 7037: 
 7038:          
 7039: 
 7040:          // All terms in F,F^\alpha,f_b except baroclinic
 7041:          // F, f_b: all explicit terms excluding vegetation 
 7042:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7043:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7044:          const double coriolis = side->coriolis;
 7045:          Vector2 F  =  coriolis*side->U;  // F_x
 7046:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7047:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7048: 
 7049:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7050:             
 7051:             for (int k = side->kb; k < nvrt; k++) {
 7052:                if (zctr2 > side->zc[k-1]) {
 7053:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7054:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7055:                    Fa +=  coriolis*w2*zrat;
 7056:                } // if zctr2
 7057:             } // k
 7058:          } // iveg
 7059: 
 7060:          // Integrate horizontal viscosity force vertically
 7061:          for (int k=side->kb + 1; k<nvrt; k++) {
 7062:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7063: 
 7064:             F += levelHorVisc;
 7065: 
 7066:             // Vegetation term
 7067:             if constexpr(iveg!=0) {
 7068:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7069:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7070:                   Fa += levelHorVisc*zrat;
 7071:                } 
 7072:             } // if iveg
 7073:          } // for k
 7074: 
 7075:          fb += side->nuGradU[side->kb];
 7076: 
 7077:          // Add to ghat1
 7078:          if constexpr(ics==2) {
 7079:             // XXX IMPLEMENT THIS
 7080:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7081:             // bigf1=vn1; bigf2=vn2
 7082:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7083:             // botf1=vn1; botf2=vn2
 7084:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7085:             // bigfa1=vn1; bigfa2=vn2
 7086:          } // if ics
 7087: 
 7088:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7089:       } // for j (nodes and sides)
 7090: 
 7091:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7092:          
 7093:       // Finish off terms in F, F^\alpha and f_b
 7094:       const double grav3 = elem->mean(&Node::grav2);
 7095:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7096: 
 7097: 
 7098:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7099:       for (int j=1; j<i34; j++) { 
 7100:          // For each side in the element...
 7101:          const Side *side = elem->sides[j];
 7102:          const double chi = side->chi;
 7103: 
 7104:          const double htot = side->htot2();
 7105:          const double veg_h = side->veg_h();
 7106:          const Vector2 F  = htot*fb;
 7107:          const Vector2 Fa = min(htot, veg_h)*fb;
 7108: 
 7109:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7110:       } // for j
 7111: 
 7112:       //botf1 etc are already in elem frame
 7113:       elem->ghat1 += tmp/i34;
 7114: 
 7115:       // Baroclinic force
 7116:       if constexpr(ibc==0) {
 7117:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7118: 
 7119:          Vector2 Fa = {0.0, 0.0};
 7120:          Vector2 intGradRho = {0.0, 0.0};
 7121:          
 7122:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7123:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7124:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7125: 
 7126:             // \in F [m^2/s/s]
 7127:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7128:          }
 7129: 
 7130:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7131:          const Vector2 F = av_df*Fa; //approx
 7132:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7133: 
 7134:       } // if ibc
 7135: 
 7136: 
 7137: 
 7138:    }
 7139: 
 7140: } // extern "C"
 7141: 
 7142: 
 7143: 
 7144: #ifdef DONTCOMPILE
 7145: __global__ void checkMassConservation(Tracers* sumtr) {
 7146: 
 7147:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7148: 
 7149:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7150: 
 7151:    Element *elem = &(mesh->localElemData[i]);
 7152: 
 7153:    // Skip dry elements
 7154:    if (elem->isDry) return;
 7155: 
 7156:    // Local sum array for this thread
 7157:    double localSum[N_TRACERS] = {0.0};
 7158: 
 7159:    // Sum over vertical levels for this element
 7160:    const int kbe = elem->kbe;
 7161:    const double area = elem->area;
 7162: 
 7163:    for (int k = kbe; k < nvrt; k++) {
 7164:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7165:       
 7166:       // Accumulate tracer mass
 7167:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7168:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7169:       }
 7170:    }
 7171: 
 7172:    //  This function returns per element sums. A reduction must be done on the host side.
 7173: }
 7174: 
 7175: 
 7176: __global__ void transport(void) {
 7177: 
 7178:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7179: 
 7180:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7181: 
 7182:    Element *elem = &(mesh->localElemData[ie]);
 7183: 
 7184:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7185: 
 7186:                for (int m=0; m<ntr; m++) {
 7187:                   for (int k=kbe(ie); k<nvrt; k++) {
 7188:                      // Calculate each polynomial's weight 
 7189:                      wm=0.d0; sum1=0.d0; 
 7190:                      wm1=0.d0; wm2=0.d0; 
 7191:                      for (int i=0; i<elem->nweno2; i++) {
 7192:                   
 7193:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7194:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7195:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7196:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7197:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7198:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7199:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7200:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7201:                      // -----------------Hu and Shu (1999)'s method----------------
 7202:                      b4=b1+b2+b3
 7203: 
 7204: //Error: add PRODUCTION CPP
 7205: #ifdef DEBUG
 7206:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7207:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7208:                     call parallel_abort(errmsg)
 7209:                   }
 7210: #endif
 7211: 
 7212:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7213:                   // !----test-------------- 
 7214:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7215:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7216:                   // !wm(i)=wm1(i)*wm2(i)
 7217:                   // !---------------------- 
 7218:                   sum1=sum1+wm(i)
 7219:                 } // end for i
 7220: 
 7221:                 wm=wm/sum1
 7222: 
 7223:                 for (int j=0; j<elem->i34; j++) {
 7224: 
 7225:                   const Side *side  = elem->sides[j];
 7226:                   const Node *node1 = side->n1;
 7227:                   const Node *node2 = side->n2;
 7228: 
 7229:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7230:                      trsd=0.d0
 7231:                      for (int kk=0; kk<nquad; kk++) {
 7232:                         for (int i=0; i<elem->nweno2; i++) {
 7233:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7234:                         } // end for i   
 7235:                      } // end for kk
 7236:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7237:                   } // outward flux
 7238:                } // end for j=1,i34(ie) ! side
 7239:             }
 7240:          }
 7241:               
 7242: 
 7243: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7244: //             //   calculate each polynomial's weight 
 7245: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7246: //                 wm=0.d0; sum1=0.d0
 7247: //                 do i=1,nweno1(ie) !for each polynomial
 7248: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7249: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7250: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7251: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7252: //                   wm(i)=b2
 7253: //                   sum1=sum1+b2
 7254: //                   !wm(i)=1.d0
 7255: //                   !sum1=sum1+1.d0
 7256: 
 7257: // // Error: PRODUCTION
 7258: // #ifdef DEBUG
 7259: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7260: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7261: //                     call parallel_abort(errmsg)
 7262: //                   endif
 7263: // #endif
 7264: 
 7265: //                 enddo !i
 7266: //                 wm=wm/sum1 !final weight
 7267: 
 7268:                 for (int j=0; j<elem->i34; j++) { // side
 7269:                   const Side *side = elem->sides[j];
 7270:                   const Node *node1 = side->n1;
 7271:                   const Node *node2 = side->n2;
 7272: 
 7273:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7274:                     trsd=0.d0
 7275:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7276:                       for (int i=0; i<elem->nweno1; i++) {
 7277:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7278:                       }
 7279:                     enddo //kk
 7280:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7281:                   } // outward flux
 7282:                 } // end for j=1,i34(ie) ! side
 7283:               } // end for k; ntr 
 7284: 
 7285:             else !simple upwind method
 7286:               do j=1,i34(ie)
 7287:                 jsj=elside(j,ie)
 7288:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7289:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7290:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7291:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7292:                   endif
 7293:                 enddo  !vertical layers
 7294:               enddo !j=1,i34(ie) ! side
 7295:             endif !order of accuracy
 7296: 
 7297:          //  enddo !ie
 7298: // !$OMP     end do
 7299: 
 7300: // !$OMP     master
 7301: //           !message passing
 7302: //           if (nproc>1) then
 7303: //             !make a copy of side concentrations
 7304: //             trsd_tmp0=trsd_tmp 
 7305: 
 7306: //             !this exchange routine swaps interface concentration between two partitions
 7307: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7308: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7309: 
 7310: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7311: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7312: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7313: 
 7314: 
 7315: //             !This obtains final values for interface sides
 7316: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7317: //       :    endif !nproc>1
 7318: //           !message passing end
 7319: // !$OMP     end master
 7320: // !$OMP     barrier
 7321: 
 7322: 
 7323: // !         Do advection; conc @ dry elem will not be changed
 7324: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7325: // !$OMP     do reduction(+: h_mass_in)
 7326: //           do i=1,ne
 7327: //             if(idry_e(i)==1) cycle
 7328: 
 7329: 
 7330: // !           Wet elements with 3 wet nodes
