  523:     double tracer[N_TRACERS];
  524: };
  525: 
  526: 
  527: 
  528: struct Frame {
  529:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  530:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  531:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  532:     double t00, t10;        // col0 (t20=0 implicit)
  533:     double t01, t11, t21;   // col1
  534: 
  535:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  536: 
  537:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  538:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  539: 
  540:       double sin_lon, cos_lon, sin_lat, cos_lat;
  541:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  542:       sincos(lat, &sin_lat, &cos_lat);
  543: 
  544:       t00 = -sin_lon;
  545:       t10 =  cos_lon;
  546:       t01 = -cos_lon*sin_lat;
  547:       t11 = -sin_lon*sin_lat;
  548:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  549: // printf("lat = %f, lon = %f, cos_lat = %f, sin_lat = %f, cos_lon = %f, sin_lon = %f\n", lat, lon, cos_lat, sin_lat, cos_lon, sin_lon);
  550: // printf("t00 = %f, t10 = %f, t01 = %f, t11 = %f, t21 = %f\n", t00, t10, t01, t11, t21);
  551: 
  552:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  553:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  554: 
  555:       const double col1_norm_inv = 1.0/col1_norm;
  556:       t01 = t01*col1_norm_inv;
  557:       t11 = t11*col1_norm_inv;
  558:       t21 = t21*col1_norm_inv;
  559: 
  560:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  561: 
  562: 
  563:    }
  564: 
  565:    __forceinline__ __device__ void print(void) const {
  566:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  567:    }
  568: 
  569:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  570:       // cross(col0, col1), with t20=0 implicitly:
  571:       // |  i       j       k   |
  572:       // | t00     t10      0   |
  573:       // | t01     t11     t21  |
  574:       t02 =  t10*t21;
  575:       t12 = -t00*t21;
  576:       t22 =  t00*t11 - t10*t01;
  577:    }
  578: 
  579: 
  580:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  581:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  582:    // Inputs:
  583:    //        vec0: vel. in this frame;
  584:    //        frameout: Output frame;
  585:    // Output: 
  586:    //        vel. in new frame  
  587:    //
  588:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  589:    // discarding the z-component of the result to keep only the local horizontal
  590:    // plane of frame 2.
  591:    //
  592:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  593:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  594:    // are orthogonal. This product is computed as dot products between columns of
  595:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  596:    // columns of F2.// 
  597: 
  598:       auto const fo = frameout; // Just an alias for the output frame.
  599:       Vector2 res;
  600: 
  601:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  602:       // of t and fo.t are the same.
  603:       const double d00 = t00*fo.t00 + t10*fo.t10;
  604:       const double d10 = t01*fo.t00 + t11*fo.t10;
  605: 
  606:       const double d01 = t00*fo.t01 + t10*fo.t11;
  607:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  608: 
  609:       res.x = vec0.x * d00 + vec0.y * d10;
  610:       res.y = vec0.x * d01 + vec0.y * d11;
  611: 
  612:       return res;
  613:    }
  614: 
  615:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  616:       Vector3 vo;
  617:       double t02, t12, t22;
  618: 
  619:       // Compute the 3rd column of the frame tensor
  620:       getCol2(t02, t12, t22);
  621: 
  622:       vo.x = vi.x*t00 + vi.y*t10;
  623:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  624:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  625: 
  626:       return vo;
  627:    
  628:    }
  629: 
  630:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  631:       Vector3 vo;
  632:       double t02, t12, t22;
  633: 
  634:    // Compute the 3rd column of the frame tensor
  635:       getCol2(t02, t12, t22);
  636: 
  637:       // F * vi (non-transposed, so we use rows of F)
  638:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  639:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  640:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  641: 
  642:       return vo;
  643:    }
  644: 
  645:    // Unit vectors that define the local frame
  646:    __forceinline__ __device__ Vector3 nUp(void) const {
  647:       // Column 2 = cross(column0, column1)
  648:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  649:    }
  650: 
  651:    __forceinline__ __device__ Vector3 nZonal(void) const {
  652:       // Column 0
  653:       return { t00, t10, 0.0 };
  654:    }
  655: 
  656:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  657:       // Column 1
  658:       return { t01, t11, t21 };
  659:    }
  660: 
  661: };
