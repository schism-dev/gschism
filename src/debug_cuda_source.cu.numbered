 3519: 
 3520: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3521:    if constexpr(ics == 1) {
 3522:       return center;
 3523: 
 3524:    } else {
 3525:       const Point2 p0 = n1->outputCoords();
 3526:       const Point2 p1 = n2->outputCoords();
 3527:       return (1.0/2.0)*(p0 + p1);
 3528: 
 3529:    }
 3530: }
 3531: 
 3532: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3533: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3534: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3535: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3536: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3537: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3538: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3539: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3540: // Computes the gradient of the field at the side center.
 3541:    Vector2 grad = {0.0, 0.0};
 3542:    int count = 0;
 3543: 
 3544:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3545:    // as the average of the gradients at each element.
 3546:    // First element
 3547:    if (elems[0] != nullptr && condition(elems[0])) {
 3548:       Vector2 elemGrad = elems[0]->grad2(field);
 3549: 
 3550:       // For ics=2, projects the element gradient from its frame to the side frame
 3551:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3552: 
 3553:       grad += elemGrad;
 3554: 
 3555:       count++;
 3556:    }
 3557: 
 3558:    // Second element
 3559:    if (elems[1] != nullptr && condition(elems[1])) {
 3560: 
 3561:       Vector2 elemGrad = elems[1]->grad2(field);
 3562: 
 3563:       // For ics=2, projects the element gradient from its frame to the side frame
 3564:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3565: 
 3566:       grad += elemGrad;
 3567: 
 3568:       count++;
 3569:    }
 3570: 
 3571:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3572:    if (count > 0) {
 3573:       grad = grad*(1.0/count);
 3574:    }
 3575:    
 3576:    return grad;
 3577: }
 3578: 
 3579: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3580: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3581: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3582: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3583: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3584: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3585: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3586: 
 3587: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3588: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3589: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3590: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3591: 
 3592: 
 3593: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3594: 
 3595: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3596:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3597:    if constexpr(ics == 1) { 
 3598:       return 0.5*(n1->tau + n2->tau);
 3599: 
 3600:    } else {
 3601:       // Project the tau from the node frames to the side frame
 3602:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3603:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3604: 
 3605:       return 0.5*(stau1 + stau2);
 3606:    }
 3607: }
 3608: 
 3609: /**
 3610:  * This method performs backtracking from the side center until a time -dt back in time 
 3611:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3612:  * intermediate point.
 3613:  *
 3614:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3615:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3616:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3617:  * remaining time.
 3618:  * 
 3619:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3620:  * 
 3621:  * @param uuint, vvint, wwint: Velocities at the final point
 3622:  * @param jlev: Level at which the backtracking is performed
 3623:  * @param dt, dtbk: Tracking timesteps
 3624:   */
 3625: __inline__ __device__ void Side::btrack(
 3626:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3627:       double dt,            // Tracking time
 3628:       double dtbk,          // Tracking timestep
 3629:       Vector3 &u_int        // Velocities at the initial point
 3630: ) const {
 3631: 
 3632:    // Start from side center
 3633:    Point3 x0;
 3634: 
 3635:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3636:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3637: 
 3638:  
 3639:    double time_rm = dt; // Remaining time
 3640:    double time_rm_1 = 1e10;
 3641:    double time_rm_2 = 2e10;
 3642:    double time_rm_3 = 3e10;
 3643: 
 3644: 
 3645:    // Initial velocities
 3646:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3647: 
 3648:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3649:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3650: 
 3651:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3652: 
 3653: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3654: 
 3655: 
 3656:    constexpr int MAX_ITERATIONS = 100; 
 3657:    int iter = 0;
 3658:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3659:    while(true) {
 3660: 
 3661:       // Calculate timestep
 3662:       const double dtb = min(dtbk, time_rm);
 3663: 
 3664:       // Next point in the backtracking curve
 3665:       xt = x0 - dtb*u_int;
 3666: 
 3667:       double t, s; // parameters for the line segments p0pt and p1p2
 3668:       Side *lastCrossSide = nullptr;
 3669:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3670: 
 3671: 
 3672:       if (time_rm_3 <= time_rm) {
 3673:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3674:          xt = x0;
 3675:          break;
 3676:       }
 3677: 
 3678: 
 3679:       if (!found) {
 3680:       // This means that the walk reached a boundary or a dry element.
 3681: 
 3682:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3683: 
 3684:          // Finds the point at the boundary where the line segment x0xt intersects.
 3685:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3686:          // due to floating point errors, it does not exactly intersect.
 3687:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3688:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3689:          // To compute the intersection point we start with the parametric equations.
 3690:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3691:          // We cross-prouct by v1 to cancel the s term:
 3692:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3693:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3694: 
 3695:          // Side coordinates in the origSide frame.
 3696:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3697:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3698: 
 3699:          Point2  p0 = {x0.x, x0.y};
 3700:          Point2  pt = {xt.x, xt.y};
 3701: 
 3702:          const Vector2 v1 = pt - p0;
 3703:          const Vector2 v2 = p2 - p1;
 3704: 
 3705: 
 3706: 
 3707:          // We are assuming intersection, so we clamp t to the range [0,1].
 3708:          const double denom = cross(v2, v1);
 3709:          
 3710: 
 3711: 
 3712: 
 3713:          if (abs(denom) < small) {
 3714:             // small denominators are fairly common. They occur when the line segment x0xt 
 3715:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3716:             // boundary, where the backtracking curve startt sliding along the boundary.
 3717:             // In this case, we simply assume that the two lines are very close to each other
 3718:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3719:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3720:             if (t<0.0000000001) t = 0.0;
 3721:             if (t>0.9999999999) t = 1.0;
 3722: 
 3723:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3724:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3725: 
 3726:          }
 3727:          else {
 3728:             
 3729:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3730:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3731:             if (t>0.9999999999) t = 1.0;
 3732:             // From the originaL equation we can solve for s:
 3733:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3734:             // Computing the dot product by v1, we get:
 3735:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3736:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3737:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3738: 
 3739:          }
 3740: 
 3741:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3742: 
 3743: 
 3744:          // We update the new target point to be right at the intersection point,
 3745:          // and the remaining time must include the time we haven't "used".
 3746:          time_rm -= s*dtb;
 3747:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3748: 
 3749: 
 3750:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3751:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3752: 
 3753:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3754:          // but extracting only the component along the tangent vector v2.
 3755:          Vector2 tangent = normalize(v2);
 3756:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3757: 
 3758:          const Vector2 u2D = make_double2(u.x, u.y);
 3759:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3760: 
 3761: 
 3762:       } else {
 3763: 
 3764:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3765: 
 3766:          time_rm -= dtb; 
 3767: 
 3768:          u_int = curElem->interpolateVelocities(xt, this);
 3769: 
 3770:       }
 3771: 
 3772:       if (time_rm <= 0.0) break; 
 3773: 
 3774:       // If the velocity is too small, we stop the backtracking
 3775:       const double vmag2 = norm2(toVector2(u_int));
 3776:       if (vmag2 <= velmin_btrack_sq)  {
 3777:          time_rm = 0.0; 
 3778:          return; 
 3779:       }
 3780: 
 3781:       // The current point becomes the next segment's starting point.
 3782:       x0 = xt;
 3783:  
 3784:       iter++;
 3785: 
 3786: // XXXXXXXXXXXXXXXXX
 3787: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3788:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3789: 
 3790:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3791:       time_rm_3 = time_rm_2;
 3792:       time_rm_2 = time_rm_1;
 3793:       time_rm_1 = time_rm;
 3794:    }
 3795: 
 3796:    assert(curElem != nullptr && "Final element is nullptr");
 3797:    assert(!curElem->isDry && "Final element is dry");
 3798:    
 3799: 
 3800: 
 3801:    // Interpolate the velocities at the final point with respect to the current side frame
 3802:    u_int = curElem->interpolateVelocities(xt, this);
 3803: 
 3804: 
 3805: }
 3806: 
 3807: 
 3808: 
 3809: __device__ __forceinline__ int Node::localIndex() const {
 3810:    // Returns the local index of the node in the partition
 3811:    // Local index is just the offset from the start of the partition's node memory
 3812:    return int(this - mesh->nodes[part]);
 3813: }
 3814: 
 3815: 
 3816: __device__ __forceinline__ int Node::packedIndex() const {
 3817:    // Returns the packed index of the node
 3818:    // Packed index is the index of the partition-block matrices and vectors.
 3819:    return nodeOffsetPerPartition[part] + localIndex();
 3820: }
 3821: 
 3822: 
 3823: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3824: 
 3825: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3826: 
 3827:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3828:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3829: 
 3830:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3831:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3832: 
 3833:    double fun_lat = 0.0;
 3834:    switch (jspc[idxComp]) {
 3835:       case 0:
 3836:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3837:          break;
 3838:       case 1:
 3839:          fun_lat = sin(2.0*lat);
 3840:          break;
 3841:       case 2:
 3842:          fun_lat = pow<2>(cos(lat));
 3843:          break;
 3844:       default:
 3845:          assert(false && "computeETP: invalid jspc");
 3846:    }
 3847:    
 3848:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3849: 
 3850: }
 3851: 
 3852: __device__ void Node::updateKb(void) {
 3853: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3854: 
 3855:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3856: 
 3857: 
 3858:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3859: 
 3860:    if constexpr(ivcor == 2) {  // SZ coordinates
 3861:       
 3862:       // Compute bottom level index
 3863:       if (depth <= mesh->h_s) {
 3864:          kb = izlev;   
 3865:          
 3866:       } else {
 3867:          kb = -1;
 3868:          int L = 0;
 3869:          int R = nzlev; 
 3870:          
 3871:          while (L <= R) {
 3872:             int M = (R + L) / 2;
 3873: 
 3874: 
 3875:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3876:             
 3877:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3878:                R = M;
 3879:             } else {
 3880:                L = M;
 3881:             }
 3882: 
 3883:             if (R - L == 1) {
 3884:                kb = L;
 3885:                break;
 3886:             }
 3887:          }
 3888: 
 3889:          // Checks that the binary search was successful
 3890:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3891:        
 3892:       }
 3893:    } 
 3894: }
