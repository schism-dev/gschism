 1799: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1800:    // Computes the 3D normal vector to the element at level k
 1801:    // Returns the normal vector and the area of the element
 1802: 
 1803:       if (isTri()) {
 1804:          // For triangles...
 1805: 
 1806:          // Gets the normal vector to the element (with a length equal to twice the area)
 1807:          if constexpr(ics==1) {
 1808:             const int kb0 = max(k, nodes[0]->kb);
 1809:             const int kb1 = max(k, nodes[1]->kb);
 1810:             const int kb2 = max(k, nodes[2]->kb);
 1811: 
 1812:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1813:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1814:             
 1815:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1816:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1817:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1818:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1819: 
 1820:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1821:             area3D = 0.5*len;
 1822: 
 1823:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1824: 
 1825:             return {nx/len, ny/len, nz/len};
 1826: 
 1827:            
 1828:          }
 1829:          else {  // lat/lon
 1830:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1831:             return {0.0, 0.0, 0.0};
 1832: 
 1833:          } // if ics
 1834:       }
 1835:       else {
 1836:          // For quads...
 1837: 
 1838:          assert(false && "Element normal vector: quads not yet implemented");
 1839:          return {0.0, 0.0, 0.0};
 1840: 
 1841: 
 1842:       }
 1843:    }
 1844: 
 1845: /**
 1846:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1847:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1848:    If the segment is completely inside the element, then it returns true.
 1849: 
 1850:    This function assumes:
 1851:    - The initial point is on a side of the element. 
 1852:    - Its position is given by parameter t in the range [0,1].
 1853:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1854:       intersects the element (elements are convex).
 1855: 
 1856:    To find the intersection point, this function does the following:
 1857:    - it finds the intersection of the line segment with all the element side lines,
 1858:       except for the one that contains the initial point.
 1859:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1860:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1861:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1862:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1863:       track segment is almost parallel to the element side line.
 1864: 
 1865:    Inputs:
 1866:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1867:    @param x2, y2: other end of the line segment
 1868: 
 1869:    Outputs:
 1870:    @param side:  side that intersects the line segment (input and output)
 1871:    @param nextElement (output): element that contains the intersection point
 1872:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1873:    @param zint (input/output): Vertical coordinate of the intersection point
 1874: 
 1875:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1876:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1877:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1878: 
 1879:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1880:    (Delta) being zero.
 1881: 
 1882:    The intersection2 point happens when:
 1883:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1884:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1885:    
 1886:    Assumption: the 4 points (including those of the side segment) are different.
 1887:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1888:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1889:    If true, (xIntersect,yIntersect) is the intersection.				
 1890:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1891: **/
 1892: 
 1893: 
 1894: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1895:                                               double &t, double& tIntersect) {
 1896:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1897:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1898: 
 1899:    double closest_intersect_t = 1e10;
 1900:    bool found_intersection = false;
 1901: 
 1902:    for (int i = 0; i < i34; i++) {
 1903: 
 1904:       Side *side2 = sides[i];
 1905: 
 1906:       // (x3,y3)-(x4,y4) is the element side line
 1907:       const Point2 x3 = side2->n1->p;
 1908:       const Point2 x4 = side2->n2->p;
 1909: 
 1910:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1911:       const double delta = cross(x2 - x1, x3 - x4);
 1912: 
 1913:       if (abs(delta) > 0) {
 1914: 
 1915:          const double delta1 = cross(x3 - x1, x3 - x4);
 1916:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1917: 
 1918:          // Solves the two linear equations for tt1 and tt2
 1919:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1920:          const double tt2 = delta2/delta;
 1921: 
 1922:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1923:             closest_intersect_t = min(closest_intersect_t, tt1);
 1924:             side = side2;
 1925:             nextElement = side->otherElem(this);
 1926:             t =          clamp(tt2, small, 1.0-small);
 1927:             tIntersect = clamp(tt1, small, 1.0-small);
 1928:             found_intersection = true;
 1929:          }
 1930: 
 1931:       
 1932:       }
 1933:       else {  // parallel segments
 1934: 
 1935:          continue; 
 1936:          assert(false && "Parallel segments should not happen under the new code");
 1937:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1938:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1939: 
 1940:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1941:          const double dist = dot(x1 - x3, side2->n);
 1942:          if (abs(dist) < small*length(x3 - x4)) {
 1943:             const double2 unitarySide = normalize(x4 - x3);
 1944:             const double len = dot(x2 - x1, unitarySide);
 1945:             t = t + len;
 1946:             t = max(0.0, min(t, 1.0));
 1947:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1948: 
 1949: 
 1950:             // tIntersect = max(small, min(tt1, 1.0-small));
 1951:             // t = tt2;
 1952:             found_intersection = true;
 1953:          }
 1954:       }
 1955: 
 1956: 
 1957:    }
 1958: 
 1959: 
 1960:    assert(found_intersection && "No intersection found");
 1961: 
 1962:    // found_intersection should always be true, since we checked all the sides.  
 1963:    return found_intersection;
 1964: }
 1965: 
 1966: 
 1967: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1968:                                              Point3 &xt, double zint, Vector3 &u_int) {
 1969: 
 1970:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1971:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 1972:    // curElement.
 1973: 
 1974:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1975:    // And uses this velocity instead to continue the tracking.
 1976: 
 1977:    // computes the intersection point in cartesian coordinates
 1978:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 1979: 
 1980:    // Nudges the point to the barycenter of the element. 
 1981:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1982:    // next segment intersects the element sides. 
 1983:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 1984: 
 1985: 
 1986:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1987:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1988:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1989:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1990: 
 1991:    // If the side is an open boundary, the tangential velocity is set to zero.
 1992:    if (nextSide->isBnd()) vtan = 0.0;
 1993: 
 1994:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1995:    const double us = vtan*nextSide->t().x;
 1996:    const double vs = vtan*nextSide->t().y;
 1997:    const double ws = nextSide->w2(jlev); 
 1998: 
 1999:    u_int = {us, vs, ws};
 2000: 
 2001:    // The end of this tracking segment is now the intersection point.
 2002:    xt = {intersection.x, intersection.y, zint};
 2003:    
 2004: }
 2005: 
 2006: /**
 2007:  * Tracks a particle through elements and vertical levels in the mesh.
 2008:  * 
 2009:  * @param x0,y0,z0     Starting position coordinates
 2010:  * @param xt,yt,zt     Target position coordinates
 2011:  * @param dtb          Time step for tracking
 2012:  * @param u_int        Initial velocity components
 2013:  * @param nextElem     Starting/resulting element index
 2014:  * 
 2015:  * @return Status code of type trackExitCodes
 2016:  * 
 2017:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2018:  * of the details are different. The idea is that the code requires less branches and is better fit
 2019:  * for GPU execution.
 2020:  * 
 2021:  * The main ideas here are:
 2022:  * - The starting point is expected to be in the starting element.
 2023:  * - since the starting point is inside the element, there are only two cases: 
 2024:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2025:  *     (b) it does not and (xt,yt) is already in the starting element.
 2026:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2027:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2028:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2029:  * - tt1 can be positive or negative. We only consider the positive values.
 2030:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2031:  * - The next intersection will occur at the smallest positive tt1.
 2032:  * - This intersection will be the next (x0,y0) position.
 2033:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2034:  *   of getting stuck in a loop.
 2035:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2036:  *   was found.
 2037:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2038:  */
 2039: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2040:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2041:                                                        const Side *origSide) {
 2042:                                                             
 2043:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2044:    // else to do. This means that the full step occurred within the current element.
 2045:    assert(!isDry && "Starting element is dry");
 2046:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2047: 
 2048:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2049: 
 2050:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2051:       assert(!isDry && "Target point is inside a dry element");
 2052: 
 2053:       interpolateVelocities(xt, u_int);
 2054: 
 2055:       nextElem = this;
 2056: 
 2057: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2058:       return true;
 2059:    }
 2060: 
 2061: 
 2062:    
 2063: 
 2064:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2065:    
 2066:    double t;
 2067:    Side *nextSide = nullptr;
 2068:    double tIntersect = 1e10;
 2069: 
 2070: 
 2071:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2072:    // (x0,y0) is inside the element but the target point is not.
 2073:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2074:    assert(found_intersection && "No intersection found at %d");
 2075: 
 2076:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2077: 
 2078:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2079:    if (nextElem != nullptr && !nextElem->isDry) {
 2080:       assert(nextElem->containsPoint(xtmp) && "Intersection point is not inside the next element");
 2081:       nextElem->nudgeToBarycenter(xtmp);
 2082:    }
 2083: 
 2084:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2085:    xt = {xtmp.x, xtmp.y, zint};
 2086: 
 2087:    // if the tracking segment goes out of water (either dry or edge boundary)
 2088:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2089: 
 2090: 
 2091:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2092: 
 2093:       assert(this->containsPoint(toPoint2(xt)) && "Target point is not inside the current element");
 2094:       // When this happens, the backtracking stops.
 2095:       // dt = time_rm;  LLLLLL KKKK XXXX
 2096:       dt *= tIntersect;
 2097: 
 2098:       // In this case, the next element is again the current element.
 2099:       nextElem = this;
 2100: 
 2101: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2102: 
 2103:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2104:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2105:       return true;    
 2106:    }
 2107: 
 2108: 
 2109:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2110:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2111:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2112: 
 2113:    
 2114:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2115: 
 2116:    nextElem->interpolateVelocities(xt, u_int); 
 2117: 
 2118:    assert(nextElem != this && "Next element is the same as the current element");
 2119: 
 2120:    return true;
 2121: }
 2122: 
 2123: 
 2124: __inline__ __device__ double Element::computeSignedArea(void) const {
 2125:    // Compute the area of the element
 2126: 
 2127:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2128: 
 2129:    // In the quad case we need to add the area of the other triangle.
 2130:    if (isQuad()) {
 2131:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2132:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2133:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2134:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2135: 
 2136:       res += ar1;
 2137:    }
 2138: 
 2139:    return res;
 2140: }
 2141: 
 2142: 
 2143: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2144:                                                                 (nodes[1]->isDry2()) ||
 2145:                                                                 (nodes[2]->isDry2()) ||
 2146:                                                                 (i34==4 && nodes[3]->isDry2());
 2147: }
 2148: 
 2149: __inline__ __device__ double Element::detJ_eta(void) const {
 2150:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2151:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2152: }
 2153: 
 2154: __inline__ __device__ double Element::detJ_xi(void) const {
 2155:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2156:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2157: }
 2158: 
 2159: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2160:    // In boundary sides, the element 1 is nullptr
 2161:    return side->elems[1] == nullptr; 
 2162: }
 2163: 
 2164: 
 2165: 
 2166: /**
 2167:    Compute the shape coordinates of the point (xt,yt) in the element.
 2168:    @param xt (input): x-coordinate of the point
 2169:    @param shpCoords (output): shape coordinates of the point
 2170:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2171:    @return true if the point is inside the element, false otherwise
 2172: **/
 2173: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegshpCoord) const {
 2174: 
 2175:    // Compute the shape coordinates of the point xt in the element.
 2176:    if (i34==3) {
 2177:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2178:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2179:       // and in this case, the pt will be nudged into the element
 2180:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2181:       // from the local frame, so use additional check.
 2182: 
 2183:       Point2 x0, x1, x2;
 2184: 
 2185:       if constexpr(ics==1) {
 2186:          x0 = nodes[0]->p;
 2187:          x1 = nodes[1]->p;
 2188:          x2 = nodes[2]->p;
 2189:       }
 2190:       else // lat/lon
 2191:       {
 2192:          Error("Not implemented yet");
 2193:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2194:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2195:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2196:       }
 2197: 
 2198:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2199:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2200:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2201:       shpCoords[3] = 0.0;
 2202: 
 2203:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2204:       const bool res = (tmpmin >= -small);  
 2205:       
 2206:       // If the point is not inside the element, we do not need to fix the negative shape coordinates.
 2207:       fixNegshpCoord = fixNegshpCoord && res;
 2208: 
 2209:       
 2210:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2211:       // then we fix the negative shape coordinates.
 2212:       if ((tmpmin < 0) && fixNegshpCoord) {
 2213: 
 2214:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2215:          // keeping the sum of the shape coordinates equal to 1.
 2216:          // I have tested and compared the new algorithm with the old one, and they give
 2217:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2218:          // The new algorithm should be faster since it is branchless.
 2219:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2220:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2221:          
 2222:          shpCoords[0] = (shpCoords[0] + a)*b;
 2223:          shpCoords[1] = (shpCoords[1] + a)*b;
 2224:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2225: 
 2226:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2227:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2228:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2229:          }
 2230: 
 2231:          // Update the point coordinates for the new shape coordinates
 2232:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2233:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2234:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2235: 
 2236:       }
 2237: 
 2238:       // Check if the point is inside the element
 2239:       return res;      
 2240:    }
 2241:    else {
 2242:       Error("Not implemented yet");
 2243: #ifdef QUADS
 2244:       // Reproject pt in eframe of nel for ics=2
 2245:       if constexpr(ics==1) {
 2246:          xn2 = xt; 
 2247:          yn2 = yt;
 2248:       }
 2249:       else {
 2250:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2251:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2252:       }
 2253: 
 2254:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2255: #endif
 2256:    }
 2257: 
 2258:    assert(false && "computeShapeCoords: should never reach this point");
 2259:    return false;  // Never reached
 2260: 
 2261: }
 2262: 
 2263: 
 2264: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2265: // Convert shape coordinates to cartesian coordinates
 2266: 
 2267:    if (i34 == 3) {
 2268:       // Triangular element
 2269:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2270:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2271:    }
 2272:    else {
 2273:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2274:    }
 2275: 
 2276: }
 2277: 
 2278: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2279:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2280:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2281:    // The formula for the integral is:
 2282:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2283: 
 2284:    printf("intPhiPhi: TEST\n");
 2285: 
 2286:    const Node *n0 = nodes[0];
 2287:    const Node *n1 = nodes[1];
 2288:    const Node *n2 = nodes[2];
 2289:    const Node *n3 = nodes[3];
 2290: 
 2291:    const Vector2 p0 = n0->p;
 2292:    const Vector2 p1 = n1->p;
 2293:    const Vector2 p2 = n2->p;
 2294:    const Vector2 p3 = n3->p;
 2295: 
 2296:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2297:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2298:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2299:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2300: 
 2301:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2302: }
 2303:    
 2304: 
 2305: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2306:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2307:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2308:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2309:    // The formula is also based on the identity:
 2310:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2311:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2312: 
 2313:    printf("intGradPhiGradPhi: TEST\n");   
 2314: 
 2315:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2316: 
 2317:    const double x0 = nodes[0]->p.x;
 2318:    const double y0 = nodes[0]->p.y;
 2319:    const double x1 = nodes[1]->p.x;
 2320:    const double y1 = nodes[1]->p.y;
 2321:    const double x2 = nodes[2]->p.x;
 2322:    const double y2 = nodes[2]->p.y;
 2323:    const double x3 = nodes[3]->p.x;
 2324:    const double y3 = nodes[3]->p.y;
 2325: 
 2326:    double res = 0.0;
 2327:    
 2328:    // Quadrature points in xi and eta coordinates
 2329:    #pragma unroll
 2330:    for (int i = 0; i < 4; i++) {
 2331:       // For each quadrature point...
 2332: 
 2333:       const Point2 p = GaussPoint(i);
 2334:       const double eta = p.x;
 2335:       const double xi  = p.y;
 2336: 
 2337:       // Jacobian entries at the Gauss point p
 2338:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2339:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2340:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2341:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2342: 
 2343:       const double detJ = jacobianDet(p);
 2344:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2345: 
 2346:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2347:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2348:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2349:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2350:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2351: 
 2352:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2353:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2354:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2355:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2356:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2357: 
 2358:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2359:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2360:    }
 2361: 
 2362:    return res;
 2363: }
 2364: 
 2365: 
 2366: /**  Interpolate velocities at a given point (xt,yt,zt)
 2367: 
 2368:    @param xt, yt, zt: coordinates of the point to interpolate
 2369:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2370: 
 2371:    This is done in four steps:
 2372: 
 2373:    1. Find the shape coordinates for the final position in the element.
 2374:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2375:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2376:       z levels at xt, yt at each step.   
 2377:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2378:       horizontally and vertically.
 2379: **/
 2380: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2381:    // Interpolate the velocities at the point xt. 
 2382:    // This function works the same for triangular and quadrilateral elements.
 2383:    double shpCoord[4];
 2384: 
 2385:    // First step is to compute the shape coordinates of (xt,yt)
 2386:    computeShapeCoords(toVector2(xt), shpCoord, true);
 2387: 
 2388:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2389: 
 2390:    // Second step is to find the level that contains zt
 2391:    // Uses a binary search to find the level
 2392:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2393:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2394:    int R = nvrt - 1;
 2395: 
 2396:    // Get the z coordinates at the nodes of the element at the levels L and R
 2397:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2398:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2399:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2400: 
 2401:    double zL = interpolate(shpCoord, zLAtNodes);
 2402:    double zR = interpolate(shpCoord, zRAtNodes);
 2403:    
 2404:    // Interpolates vertically the velocities
 2405:    double wght1, wght2;
 2406:    if (xt.z<=zL) {
 2407:       wght1 = 1.0;
 2408:       wght2 = 0.0;
 2409:       xt.z = zL;
 2410:    }
 2411:    else if (xt.z>=zR) {
 2412:       wght1 = 0.0;
 2413:       wght2 = 1.0;
 2414:       xt.z = zR;
 2415:    }
 2416:    else {
 2417:       // Perform a binary search to find the levels between L and R that contain xt.z
 2418:       while (R - L > 1) {
 2419:          int M = (L + R) / 2.0;
 2420: 
 2421:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2422:          double zM = interpolate(shpCoord, zMAtNodes);
 2423:          if (zM < xt.z) 
 2424:          {
 2425:             L = M;
 2426:             zL = zM;
 2427:          }
 2428:          else 
 2429:          {
 2430:             R = M;
 2431:             zR = zM;
 2432:          }
 2433:       }
 2434:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2435:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2436: 
 2437:       wght2 = (xt.z - zL)/(zR - zL);
 2438:       wght1 = 1.0 - wght2;
 2439: 
 2440:    }
 2441: 
 2442: 
 2443:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2444:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2445: 
 2446:    // Neither of the interpolated velocities should be NaN
 2447:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2448: 
 2449: }
 2450: 
 2451: 
 2452: 
 2453: 
 2454: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2455: 
 2456:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2457:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2458:    const Node *n1 = side->n1;
 2459:    const Node *n2 = side->n2;
 2460: 
 2461:    bool n1_match = (n1->nodeBnd->segment == segment);
 2462:    bool n2_match = (n2->nodeBnd->segment == segment);
 2463: 
 2464:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2465:    if (n1_match && n2_match) {
 2466:       return 0.5;
 2467:    } else if (n1_match) {
 2468:       return 1.0;
 2469:    } else if (n2_match) {
 2470:       return 0.0;
 2471:    }
 2472: 
 2473:    return 0.0;
 2474: }
 2475: 
 2476: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2477: 
 2478: 
 2479: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2480: 
 2481:    const double w1 = getBoundaryArrayValueWeight();
 2482:    const double w2 = 1.0 - w1;
 2483:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2484:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2485: 
 2486:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2487: }
 2488: 
 2489: 
 2490: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2491:    const double w1 = getBoundaryArrayValueWeight();
 2492:    const double w2 = 1.0 - w1;
 2493:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2494:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2495: 
 2496:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2497: 
 2498: }
 2499: 
 2500: 
 2501: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2502:    // Returns the value of the velocity at the side center
 2503:    const double w1 = getBoundaryArrayValueWeight();
 2504:    const double w2 = 1.0 - w1;
 2505:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2506:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2507: 
 2508:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2509: }
 2510: 
 2511: 
 2512: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2513:    // Returns the value of the normal component of the velocity at the side center
 2514:    const double w1 = getBoundaryArrayValueWeight();
 2515:    const double w2 = 1.0 - w1;
 2516:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2517:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2518: 
 2519:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2520: }
