 2348:    template<typename T>
 2349:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2350: 
 2351:       T values[4];
 2352: 
 2353: 
 2354:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2355:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2356:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2357:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2358:       else          values[3] = T();
 2359: 
 2360:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2361: 
 2362:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2363:    }
