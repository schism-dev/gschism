 2268: 
 2269: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2270: 
 2271:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2272:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2273:    const Node *n1 = side->n1;
 2274:    const Node *n2 = side->n2;
 2275: 
 2276:    bool n1_match = (n1->nodeBnd->segment == segment);
 2277:    bool n2_match = (n2->nodeBnd->segment == segment);
 2278: 
 2279:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2280:    if (n1_match && n2_match) {
 2281:       return 0.5;
 2282:    } else if (n1_match) {
 2283:       return 1.0;
 2284:    } else if (n2_match) {
 2285:       return 0.0;
 2286:    }
 2287:    return 0.0;
 2288: }
 2289: 
 2290: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2291: 
 2292: 
 2293: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2294: 
 2295:    const double w1 = getBoundaryArrayValueWeight();
 2296:    const double w2 = 1.0 - w1;
 2297:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2298:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2299: 
 2300:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2301: }
 2302: 
 2303: 
 2304: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2305:    const double w1 = getBoundaryArrayValueWeight();
 2306:    const double w2 = 1.0 - w1;
 2307:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2308:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2309: 
 2310:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2311: }
 2312: 
 2313: 
 2314: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2315:    // Returns the value of the velocity at the side center
 2316:    const double w1 = getBoundaryArrayValueWeight();
 2317:    const double w2 = 1.0 - w1;
 2318:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2319:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2320: 
 2321:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2322: }
 2323: 
 2324: 
 2325: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2326:    // Returns the value of the normal component of the velocity at the side center
 2327:    const double w1 = getBoundaryArrayValueWeight();
 2328:    const double w2 = 1.0 - w1;
 2329:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2330:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2331: 
 2332:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2333: }
