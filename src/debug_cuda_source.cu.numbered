 4325:    __global__ void computeFlowBcVelocities(double time) {
 4326: 
 4327:       SIDE_BND(sideBnd);
 4328: 
 4329:       const Side *side = sideBnd->side;
 4330:  
 4331:       const bool isDry = side->isDry;
 4332:       const bool isLand = sideBnd->segment->isLand;
 4333: 
 4334:    
 4335:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4336: 
 4337:       if (isDry || isLand) return;
 4338: 
 4339:       // For wet sides in open boundaries...
 4340:       const Vector2 n = side->n;
 4341:       const BoundarySegment *segment = sideBnd->segment;
 4342: 
 4343:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4344: 
 4345:       const int ifltype = segment->ifltype;
 4346: 
 4347:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4348:       const Vector2 r_nuth0 = r_uth0*n;
 4349: 
 4350: 
 4351:       if (ifltype == 1 || ifltype == 2) {
 4352:       
 4353:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4354: 
 4355:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4356:          
 4357:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4358:          
 4359:       } else if (ifltype == -1) { // Flather 1
 4360: 
 4361:          for (int k = 0; k < nvrt; k++) {
 4362: 
 4363:             // uth is the normal vel.; no ramp up
 4364:             const double uth = sideBnd->nuth(k);
 4365:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4366: 
 4367:             sideBnd->ubc[k] += uth*n;
 4368:          }
 4369: 
 4370:       } else if (ifltype == 3 || ifltype == 5) {
 4371:          // vnth0=0 !normal vel.
 4372: 
 4373:          Vector2 r_u1_bar = {0.0, 0.0};
 4374:          // Computes the contribution to the velocity from all tide frequencies
 4375:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4376: 
 4377:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4378:             const Vector2 umo  = sideBnd->umo(jfr); 
 4379: 
 4380:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4381:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4382:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4383:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4384:          }
 4385: 
 4386: 
 4387:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4388: 
 4389:       } // if (ifltype = 3 || ifltype == 5
 4390: 
 4391: 
 4392: 
 4393:    }
 4394: 
 4395:    __global__ void computeElevationBoundaryConditions(double time) {
 4396:       // Compute elevation essential boundary conditions 
 4397: 
 4398:       NODE_BND(nodeBnd); // Each boundary node.
 4399: 
 4400:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4401: 
 4402:       const Node *node = nodeBnd->node;
 4403:       const BoundarySegment *segment = nodeBnd->segment;
 4404:       const int iettype = segment->iettype;
 4405:       
 4406: 
 4407:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4408:       double eic = 0.0;
 4409:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4410:       else                 eic = 0.0;
 4411: 
 4412:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4413:       const double r_eth = ramp*nodeBnd->eth;
 4414:       double r_eta1_bar = 0.0;
 4415: 
 4416: 
 4417:       // Compute tide elevation
 4418:       if (iettype == 3 || iettype == 5) {   
 4419: 
 4420:          if constexpr(iloadtide==1) { // loading tide
 4421:             assert(false && "Loading tide not implemented");
 4422:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4423:          }
 4424:          
 4425:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4426: 
 4427:             const double efa  = nodeBnd->efa[jfr]; 
 4428:             const double emo  = nodeBnd->emo[jfr]; 
 4429: 
 4430:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4431:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4432:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4433: 
 4434:          } // for jfr
 4435: 
 4436:       } // if iettype
 4437: 
 4438:       switch (iettype) {
 4439:          case 1:
 4440:          case 2:
 4441:          case 4:
 4442:             nodeBnd->elbc = r_eic + r_eth;
 4443:             break;
 4444:          case 3:
 4445:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4446:             break;
 4447:          case 5:
 4448:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4449:             break;
 4450:       } // switch
 4451: 
 4452: 
 4453:       //Add inverse barometric effects
 4454:       if (iettype != 0 && inv_atm_bnd == 1) {
 4455:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4456:       }
 4457: 
 4458:    }
 4459: 
 4460: 
 4461:    __global__ void computeHorizontalViscosity(void) { 
 4462: 
 4463:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4464: 
 4465:       SIDE(side);
 4466: 
 4467:       if (side->isDry) return;
 4468: 
 4469:       for (int k = 0; k < nvrt; k++) {
 4470:          side->nuGradU[k] = {0.0, 0.0};
 4471:       }
 4472: 
 4473:       if constexpr(ihorcon == 1) {
 4474:          for (int k = side->kb; k < nvrt - 1; k++) {
 4475:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4476:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4477:             // By Zhang and Baptista.
 4478: 
 4479:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4480:             // This is a standard discretization of the Laplacian operator.
 4481:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4482:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4483:             // Gamma is hvis_coef0 in the code.
 4484:             // The value of gamma needs to be < 0.5.
 4485: 
 4486:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4487:             // side under consideration in each of the two possible elements that share the side.
 4488:             Vector2 sumU = {0.0, 0.0};
 4489:             for (int l = 0; l < 2; l++) {
 4490:                const Element *elem = side->elems[l];
 4491: 
 4492:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4493: 
 4494:                // Find the local index of the side in the element
 4495:                const int idxSide = elem->sideLocalIdx(side);
 4496:                // Find the two sides that are connected to the side under consideration
 4497:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4498:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4499: 
 4500:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4501: 
 4502:             }
 4503: 
 4504:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4505:    
 4506:          }
 4507:       }
 4508:       else if constexpr(ihorcon == 2) {
 4509:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4510:       }
 4511: 
 4512: 
 4513:    }
 4514: 
 4515: 
 4516:    __global__ void setEssentialBC(void) {
 4517:       // Set essential boundary conditions 
 4518:       NODE(node); // Each boundary node
 4519:       NodeBoundary *nodeBnd = node->nodeBnd;
 4520:       
 4521: // nodeBnd->isEssentialBC = true;      
 4522:       // Check if this node has essential BC
 4523:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4524:          // Verify BC value is valid
 4525:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4526: 
 4527:        
 4528:          // Set diagonal to 1 and zero off-diagonals
 4529:          node->coeffDiag = 1.0;
 4530: 
 4531:          for (int j = 0; j < node->numNodes; j++) {
 4532:                node->coeffMatrix[j] = 0.0;
 4533:          }
 4534:          
 4535:          // Set solution and RHS to BC value
 4536:          node->mX  = nodeBnd->elbc;
 4537:          node->qel = nodeBnd->elbc;
 4538: 
 4539:       } else {
 4540:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4541: 
 4542:          for (int j = 0; j < node->numNodes; j++) {
 4543:                Node* nbNode = node->nodes[j];
 4544:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4545:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4546:                   // Verify neighbor's BC value
 4547:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4548: 
 4549:                   // Subtract contribution to RHS
 4550:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4551:                   node->coeffMatrix[j] = 0.0;  
 4552:                }
 4553:          }
 4554:       }
 4555:    }
 4556: 
 4557: 
 4558:    __global__ void updateElevation(void) {
 4559:       NODE(node);
 4560: 
 4561:       node->eta2 = node->mX;
 4562: 
 4563:       node->updateZCoordData();
 4564:    }
