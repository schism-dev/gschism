 2375: 
 2376: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2377:    // Returns the value of the velocity at the side center
 2378:    const double w1 = getBoundaryArrayValueWeight();
 2379:    const double w2 = 1.0 - w1;
 2380:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2381:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2382: 
 2383:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2384: }
 2385: 
 2386: 
 2387: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2388:    // Returns the value of the normal component of the velocity at the side center
 2389:    const double w1 = getBoundaryArrayValueWeight();
 2390:    const double w2 = 1.0 - w1;
 2391:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2392:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2393: 
 2394:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2395: }
