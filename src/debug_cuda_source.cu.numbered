 3354: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3355: 
 3356: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3357:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3358:    if constexpr(ics == 1) { 
 3359:       return 0.5*(n1->tau + n2->tau);
 3360: 
 3361:    } else {
 3362:       // Project the tau from the node frames to the side frame
 3363:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3364:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3365: 
 3366:       return 0.5*(stau1 + stau2);
 3367:    }
 3368: }
 3369: 
 3370: /**
 3371:  * This method performs backtracking from the side center until a time -dt back in time 
 3372:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3373:  * intermediate point.
 3374:  *
 3375:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3376:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3377:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3378:  * remaining time.
 3379:  * 
 3380:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3381:  * 
 3382:  * @param uuint, vvint, wwint: Velocities at the final point
 3383:  * @param jlev: Level at which the backtracking is performed
 3384:  * @param dt, dtbk: Tracking timesteps
 3385:   */
 3386: __inline__ __device__ void Side::btrack(
 3387:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3388:       double dt,            // Tracking time
 3389:       double dtbk,          // Tracking timestep
 3390:       Vector3 &u_int        // Velocities at the initial point
 3391: ) const {
 3392: 
 3393:    // Start from side center
 3394:    Point3 x0;
 3395: 
 3396:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3397:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3398: 
 3399:  
 3400:    double time_rm = dt; // Remaining time
 3401:    double time_rm_1 = 1e10;
 3402:    double time_rm_2 = 2e10;
 3403:    double time_rm_3 = 3e10;
 3404: 
 3405: 
 3406:    // Initial velocities
 3407:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3408: 
 3409:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3410:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3411: 
 3412:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3413: 
 3414: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3415: 
 3416: 
 3417:    constexpr int MAX_ITERATIONS = 100; 
 3418:    int iter = 0;
 3419:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3420:    while(true) {
 3421: 
 3422:       // Calculate timestep
 3423:       const double dtb = min(dtbk, time_rm);
 3424: 
 3425:       // Next point in the backtracking curve
 3426:       xt = x0 - dtb*u_int;
 3427: 
 3428:       double t, s; // parameters for the line segments p0pt and p1p2
 3429:       Side *lastCrossSide = nullptr;
 3430:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3431: 
 3432: 
 3433:       if (time_rm_3 <= time_rm) {
 3434:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3435:          xt = x0;
 3436:          break;
 3437:       }
 3438: 
 3439: 
 3440:       if (!found) {
 3441:       // This means that the walk reached a boundary or a dry element.
 3442: 
 3443:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3444: 
 3445:          // Finds the point at the boundary where the line segment x0xt intersects.
 3446:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3447:          // due to floating point errors, it does not exactly intersect.
 3448:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3449:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3450:          // To compute the intersection point we start with the parametric equations.
 3451:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3452:          // We cross-prouct by v1 to cancel the s term:
 3453:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3454:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3455: 
 3456:          // Side coordinates in the origSide frame.
 3457:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3458:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3459: 
 3460:          Point2  p0 = {x0.x, x0.y};
 3461:          Point2  pt = {xt.x, xt.y};
 3462: 
 3463:          const Vector2 v1 = pt - p0;
 3464:          const Vector2 v2 = p2 - p1;
 3465: 
 3466: 
 3467: 
 3468:          // We are assuming intersection, so we clamp t to the range [0,1].
 3469:          const double denom = cross(v2, v1);
 3470:          
 3471: 
 3472: 
 3473: 
 3474:          if (abs(denom) < small) {
 3475:             // small denominators are fairly common. They occur when the line segment x0xt 
 3476:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3477:             // boundary, where the backtracking curve startt sliding along the boundary.
 3478:             // In this case, we simply assume that the two lines are very close to each other
 3479:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3480:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3481:             if (t<0.0000000001) t = 0.0;
 3482:             if (t>0.9999999999) t = 1.0;
 3483: 
 3484:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3485:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3486: 
 3487:          }
 3488:          else {
 3489:             
 3490:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3491:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3492:             if (t>0.9999999999) t = 1.0;
 3493:             // From the originaL equation we can solve for s:
 3494:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3495:             // Computing the dot product by v1, we get:
 3496:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3497:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3498:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3499: 
 3500:          }
 3501: 
 3502:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3503: 
 3504: 
 3505:          // We update the new target point to be right at the intersection point,
 3506:          // and the remaining time must include the time we haven't "used".
 3507:          time_rm -= s*dtb;
 3508:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3509: 
 3510: 
 3511:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3512:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3513: 
 3514:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3515:          // but extracting only the component along the tangent vector v2.
 3516:          Vector2 tangent = normalize(v2);
 3517:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3518: 
 3519:          const Vector2 u2D = make_double2(u.x, u.y);
 3520:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3521: 
 3522: 
 3523:       } else {
 3524: 
 3525:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3526: 
 3527:          time_rm -= dtb; 
 3528: 
 3529:          u_int = curElem->interpolateVelocities(xt, this);
 3530: 
 3531:       }
 3532: 
 3533:       if (time_rm <= 0.0) break; 
 3534: 
 3535:       // If the velocity is too small, we stop the backtracking
 3536:       const double vmag2 = norm2(toVector2(u_int));
 3537:       if (vmag2 <= velmin_btrack_sq)  {
 3538:          time_rm = 0.0; 
 3539:          return; 
 3540:       }
 3541: 
 3542:       // The current point becomes the next segment's starting point.
 3543:       x0 = xt;
 3544:  
 3545:       iter++;
 3546: 
 3547: // XXXXXXXXXXXXXXXXX
 3548: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3549:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3550: 
 3551:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3552:       time_rm_3 = time_rm_2;
 3553:       time_rm_2 = time_rm_1;
 3554:       time_rm_1 = time_rm;
 3555:    }
 3556: 
 3557:    assert(curElem != nullptr && "Final element is nullptr");
 3558:    assert(!curElem->isDry && "Final element is dry");
 3559:    
 3560: 
 3561: 
 3562:    // Interpolate the velocities at the final point with respect to the current side frame
 3563:    u_int = curElem->interpolateVelocities(xt, this);
 3564: 
 3565: 
 3566: }
 3567: 
