 3888: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3889: 
 3890: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3891: 
 3892:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3893:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3894: 
 3895:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3896:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3897: 
 3898:    double fun_lat = 0.0;
 3899:    switch (jspc[idxComp]) {
 3900:       case 0:
 3901:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3902:          break;
 3903:       case 1:
 3904:          fun_lat = sin(2.0*lat);
 3905:          break;
 3906:       case 2:
 3907:          fun_lat = pow<2>(cos(lat));
 3908:          break;
 3909:       default:
 3910:          assert(false && "computeETP: invalid jspc");
 3911:    }
 3912:    
 3913:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3914: 
 3915: }
 3916: 
 3917: __device__ void Node::updateKb(void) {
 3918: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3919: 
 3920:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3921: 
 3922: 
 3923:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3924: 
 3925:    if constexpr(ivcor == 2) {  // SZ coordinates
 3926:       
 3927:       // Compute bottom level index
 3928:       if (depth <= mesh->h_s) {
 3929:          kb = izlev;   
 3930:          
 3931:       } else {
 3932:          kb = -1;
 3933:          int L = 0;
 3934:          int R = nzlev; 
 3935:          
 3936:          while (L <= R) {
 3937:             int M = (R + L) / 2;
 3938: 
 3939: 
 3940:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3941:             
 3942:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3943:                R = M;
 3944:             } else {
 3945:                L = M;
 3946:             }
 3947: 
 3948:             if (R - L == 1) {
 3949:                kb = L;
 3950:                break;
 3951:             }
 3952:          }
 3953: 
 3954:          // Checks that the binary search was successful
 3955:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3956:        
 3957:       }
 3958:    } 
 3959: }
