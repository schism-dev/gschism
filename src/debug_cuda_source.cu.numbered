 8201: // !===============================================================================
 8202: 
 8203: } // extern "C"
 8204: 
 8205: #ifdef DONTCOMPILE
 8206: __device__ void computeVerticalAdvection(void) {
 8207:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8208: 
 8209:    sdbt(1:2,:,:)=0.d0
 8210: 
 8211:    const Side *side = FROM kernel;
 8212: 
 8213:    if(side->isDry) return;
 8214: 
 8215:    // If side is wet...
 8216: 
 8217: 
 8218:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8219:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8220:    double ws[nvrt] = {} // w @ side
 8221:    int icount = 0;
 8222:    for (int j=0; j<2; j++) {
 8223:       const Element *elem = side->elements[j];
 8224:        
 8225:       if(elem != nullptr) {
 8226:          icount++;
 8227:          for (int k=0; k<nvrt; k++) {
 8228:             ws[k] = ws[k] + elem->w[k];
 8229:          }
 8230:       }
 8231:    }  // for j
 8232: 
 8233:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8234:    ws = ws/icount;
 8235: 
 8236:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8237:    // Splines allow for a smooth transition between vertical levels.
 8238:    // Splines have continuity restrictions at the internal knots, but
 8239:    // we have to provide the 1st derivatives at the endpoints.
 8240:    const int kbs = side->kbs; 
 8241:    
 8242:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8243:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8244:    initCubicSpline(kbs, nvrt, side, ws, up)
 8245: 
 8246:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8247:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8248:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8249: 
 8250:    // Total advection (average onto side)
 8251:    const Node *node1 = side->nodes[0];
 8252:    const Node *node2 = side->nodes[1];
 8253:    for (int k=kbs(i); k<nvrt; k++) {
 8254: 
 8255:       Vector2 bcc1 = node1->bcc[k];
 8256:       Vector2 bcc2 = node2->bcc[k];
 8257:       if constexpr(ics == 2) {
 8258:          // Project the velocities from the node frames to the side frame
 8259:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8260:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8261:       }
 8262: 
 8263:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8264:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8265: 
 8266:    }
 8267: }
 8268: #endif
 8269: 
 8270: 
 8271: extern "C" {
 8272:    __global__ void computeElemAverageGhat(void) {
 8273:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8274: 
 8275:       ELEM(elem);
 8276:       
 8277:       elem->ghat1= {0.0, 0.0};  
 8278: 
 8279:       if constexpr(ihydraulics != 0) {
 8280:          if (nhtblocks > 0 && elem->isblock) return;
 8281:       }
 8282: 
 8283:       
 8284:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8285:       // cff1-3: coefficients for 2D/3D
 8286: 
 8287:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8288:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8289:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8290: 
 8291:       if (elem->isDry) return;
 8292: 
 8293:       // Average of the coefficients
 8294:       double av_cff1 = 0.0;  // av. for cff1
 8295:       double av_cff2 = 0.0;  // av. for cff2
 8296:       double av_cff3 = 0.0;  // av. for cff3
 8297:       double av_df = 0.0;  // av. for H^\alpha / H
 8298:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8299:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8300: 
 8301:       const int i34 = elem->i34;
 8302:       const int kb  = elem->kb;
 8303: 
 8304:       for (int j=0; j<i34; j++) {
 8305:          // For each node and side in the element...
 8306: 
 8307:          const Node *node = elem->nodes[j];
 8308:          const Side *side = elem->sides[j];
 8309: 
 8310:          const double chi      = side->chi;
 8311:          const double veg_c2   = side->veg_c2;
 8312:          const double veg_beta = side->veg_beta;
 8313:          const double veg_h    = side->veg_h();
 8314:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8315: 
 8316:          const Vector2 gradPhi = elem->gradPhi[j];
 8317: 
 8318:          // Node - const in elem
 8319:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8320:          elem->gradPr  += node->pr  *gradPhi;
 8321: 
 8322:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8323: 
 8324:         
 8325:          const double htot  = side->htot2();        // Total depth at the side
 8326:          const double zctr2 = side->zTopCanopy();  
 8327: 
 8328:          double cff1; 
 8329:          double cff2; 
 8330:          double cff3;   
 8331:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8332:          // coefficients applied to 2D/3D case 
 8333:             cff1 = side->hhat/htot;
 8334:             cff2 = 0.0;
 8335:             cff3 = 0.0;
 8336:          } else { //3D
 8337:             //Init for no-veg case
 8338:             cff1 = 1.0;
 8339:             cff2 = 1.0;
 8340:             cff3 = 0.0;
 8341: 
 8342:             if constexpr(iveg != 0) {
 8343:                // Computes coefficients used with vegetation terms G1, G2
 8344:                // cff1, cff3 are used for the first two terms in G1, G2:
 8345:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8346:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8347:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8348:                if(veg_h < 0.99*htot) { // submergent vegetation
 8349:                   cff1 = 1.0;
 8350:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8351:                   cff3 = veg_c;
 8352: 
 8353:                } else { // emergent vegetation
 8354:                   cff1 = 1.0/(1.0 + veg_c2);
 8355:                   cff2 = cff1;
 8356:                   cff3 = 0.0;
 8357: 
 8358:                }
 8359:             } // if iveg
 8360:          } //  2D/3D
 8361: 
 8362:          av_cff1 += cff1/i34;
 8363:          av_cff2 += cff2/i34;
 8364:          av_cff3 += cff3/i34;
 8365:          av_cff2_chi += cff2*chi/i34;
 8366:          av_cff3_chi += cff3*chi/i34;
 8367:          av_df += min(htot, veg_h)/(htot*i34);
 8368: 
 8369: 
 8370:          // btrack values: U^\star, U^{\star\alpha}
 8371:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8372:          Vector2 Ustar       = {0.0, 0.0}; 
 8373:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8374: 
 8375:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8376:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8377:          } else { //3D
 8378:             for (int k = side->kb + 1; k < nvrt; k++) {
 8379:             
 8380:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8381:                Ustar += w2;
 8382: 
 8383:                if constexpr(iveg != 0) {
 8384:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8385:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8386:                        Ustar_alpha += zrat*w2; // XXXX
 8387:                    }
 8388:                }  // if iveg
 8389:             }  // for k
 8390:          }  //2D/3D
 8391: 
 8392:          // If needed, project the side velocities to the element frame
 8393:          if constexpr(ics==2) {
 8394:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8395:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8396:          }
 8397:         
 8398: 
 8399:          // Add btrack & surface stress terms to \breve{G} first
 8400:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8401: 
 8402: 
 8403:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8404:          Vector2 tau    = side->tau();  
 8405:          Vector2 ubstar = side->btu[side->kb + 1];  
 8406: 
 8407:          // If needed, project tau and ubstar to the element frame
 8408:          if constexpr(ics==2) {
 8409:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8410:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8411:          }
 8412: 
 8413:          // Term for surface and bottom stress
 8414:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8415: 
 8416: 
 8417:          // All terms in F,F^\alpha,f_b except baroclinic
 8418:          // F, f_b: all explicit terms excluding vegetation 
 8419:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8420:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8421:          const double coriolis = side->coriolis;
 8422:          Vector2 F  =  coriolis*side->U;  // F_x
 8423:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8424:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8425: 
 8426:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8427:             
 8428:             for (int k = side->kb; k < nvrt; k++) {
 8429:                if (zctr2 > side->zc[k-1]) {
 8430:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8431:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8432:                    Fa +=  coriolis*w2*zrat;
 8433:                } // if zctr2
 8434:             } // k
 8435:          } // iveg
 8436: 
 8437:          // Integrate horizontal viscosity force vertically
 8438:          for (int k=side->kb + 1; k<nvrt; k++) {
 8439:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8440: 
 8441:             F += levelHorVisc;
 8442: 
 8443:             // Vegetation term
 8444:             if constexpr(iveg!=0) {
 8445:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8446:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8447:                   Fa += levelHorVisc*zrat;
 8448:                } 
 8449:             } // if iveg
 8450:          } // for k
 8451: 
 8452:          // Get nu*grad(U) at the side's bottom level
 8453:          Vector2 nuGradU = side->nuGradU[side->kb];
 8454: 
 8455:          fb += nuGradU;
 8456: 
 8457:          // If needed, project vectorsF, fb and Fa to the element frame
 8458:          if constexpr(ics==2) {
 8459:             F    = side->frame.projHorVec(F,    elem->frame);
 8460:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8461:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8462:          } // if ics
 8463: 
 8464:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8465:       } // for j (nodes and sides)
 8466: 
 8467:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8468: 
 8469: 
 8470:       // Finish off terms in F, F^\alpha and f_b
 8471:       const double grav3 = elem->mean(&Node::grav2);
 8472:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8473:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8474:       for (int j=0; j<i34; j++) { 
 8475:          // For each side in the element...
 8476:          const Side *side = elem->sides[j];
 8477:          const double chi = side->chi;
 8478: 
 8479:          const double htot = side->htot2();
 8480:          const double veg_h = side->veg_h();
 8481:          const Vector2 F  = htot*fb;
 8482:          const Vector2 Fa = min(htot, veg_h)*fb;
 8483: 
 8484:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8485:       } // for j
 8486: 
 8487:       // tmp is already in elem frame
 8488:       elem->ghat1 += tmp/i34;
 8489: 
 8490:       // Baroclinic force
 8491:       if constexpr(ibc==0) {
 8492:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8493: 
 8494:          Vector2 Fa = {0.0, 0.0};
 8495:          Vector2 intGradRho = {0.0, 0.0};
 8496:          
 8497:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8498:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8499:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8500: 
 8501:             // \in F [m^2/s/s]
 8502:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8503:          }
 8504: 
 8505:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8506:          const Vector2 F = av_df*Fa; //approx
 8507:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8508: 
 8509:       } // if ibc
 8510: 
 8511: 
 8512: 
 8513:    }
 8514: 
 8515: } // extern "C"
 8516: 
 8517: 
 8518: 
 8519: #ifdef DONTCOMPILE
 8520: __global__ void checkMassConservation(Tracers* sumtr) {
 8521: 
 8522:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 8523: 
 8524:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 8525: 
 8526:    Element *elem = &(mesh->localElemData[i]);
 8527: 
 8528:    // Skip dry elements
 8529:    if (elem->isDry) return;
 8530: 
 8531:    // Local sum array for this thread
 8532:    double localSum[N_TRACERS] = {0.0};
 8533: 
 8534:    // Sum over vertical levels for this element
 8535:    const int kbe = elem->kbe;
 8536:    const double area = elem->area;
 8537: 
 8538:    for (int k = kbe; k < nvrt; k++) {
 8539:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 8540:       
 8541:       // Accumulate tracer mass
 8542:       for (int tr = 0; tr < N_TRACERS; tr++) {
 8543:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 8544:       }
 8545:    }
 8546: 
 8547:    //  This function returns per element sums. A reduction must be done on the host side.
 8548: }
 8549: 
 8550: 
 8551: __global__ void transport(void) {
 8552: 
 8553:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 8554: 
 8555:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 8556: 
 8557:    Element *elem = &(mesh->localElemData[ie]);
 8558: 
 8559:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 8560: 
 8561:                for (int m=0; m<ntr; m++) {
 8562:                   for (int k=kbe(ie); k<nvrt; k++) {
 8563:                      // Calculate each polynomial's weight 
 8564:                      wm=0.d0; sum1=0.d0; 
 8565:                      wm1=0.d0; wm2=0.d0; 
 8566:                      for (int i=0; i<elem->nweno2; i++) {
 8567:                   
 8568:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8569:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8570:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8571:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8572:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8573:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 8574:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 8575:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 8576:                      // -----------------Hu and Shu (1999)'s method----------------
 8577:                      b4=b1+b2+b3
 8578: 
 8579: //Error: add PRODUCTION CPP
 8580: #ifdef DEBUG
 8581:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 8582:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 8583:                     call parallel_abort(errmsg)
 8584:                   }
 8585: #endif
 8586: 
 8587:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 8588:                   // !----test-------------- 
 8589:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 8590:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 8591:                   // !wm(i)=wm1(i)*wm2(i)
 8592:                   // !---------------------- 
 8593:                   sum1=sum1+wm(i)
 8594:                 } // end for i
 8595: 
 8596:                 wm=wm/sum1
 8597: 
 8598:                 for (int j=0; j<elem->i34; j++) {
 8599: 
 8600:                   const Side *side  = elem->sides[j];
 8601:                   const Node *node1 = side->n1;
 8602:                   const Node *node2 = side->n2;
 8603: 
 8604:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 8605:                      trsd=0.d0
 8606:                      for (int kk=0; kk<nquad; kk++) {
 8607:                         for (int i=0; i<elem->nweno2; i++) {
 8608:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8609:                         } // end for i   
 8610:                      } // end for kk
 8611:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8612:                   } // outward flux
 8613:                } // end for j=1,i34(ie) ! side
 8614:             }
 8615:          }
 8616:               
 8617: 
 8618: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 8619: //             //   calculate each polynomial's weight 
 8620: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 8621: //                 wm=0.d0; sum1=0.d0
 8622: //                 do i=1,nweno1(ie) !for each polynomial
 8623: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8624: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8625: //                   b1=b1*b1+b2*b2 !smoothness indicator
 8626: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 8627: //                   wm(i)=b2
 8628: //                   sum1=sum1+b2
 8629: //                   !wm(i)=1.d0
 8630: //                   !sum1=sum1+1.d0
 8631: 
 8632: // // Error: PRODUCTION
 8633: // #ifdef DEBUG
 8634: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 8635: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 8636: //                     call parallel_abort(errmsg)
 8637: //                   endif
 8638: // #endif
 8639: 
 8640: //                 enddo !i
 8641: //                 wm=wm/sum1 !final weight
 8642: 
 8643:                 for (int j=0; j<elem->i34; j++) { // side
 8644:                   const Side *side = elem->sides[j];
 8645:                   const Node *node1 = side->n1;
 8646:                   const Node *node2 = side->n2;
 8647: 
 8648:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 8649:                     trsd=0.d0
 8650:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 8651:                       for (int i=0; i<elem->nweno1; i++) {
 8652:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 8653:                       }
 8654:                     enddo //kk
 8655:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8656:                   } // outward flux
 8657:                 } // end for j=1,i34(ie) ! side
 8658:               } // end for k; ntr 
 8659: 
 8660:             else !simple upwind method
 8661:               do j=1,i34(ie)
 8662:                 jsj=elside(j,ie)
 8663:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 8664:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 8665:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 8666:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 8667:                   endif
 8668:                 enddo  !vertical layers
 8669:               enddo !j=1,i34(ie) ! side
 8670:             endif !order of accuracy
 8671: 
 8672:          //  enddo !ie
 8673: // !$OMP     end do
 8674: 
 8675: // !$OMP     master
 8676: //           !message passing
 8677: //           if (nproc>1) then
 8678: //             !make a copy of side concentrations
 8679: //             trsd_tmp0=trsd_tmp 
 8680: 
 8681: //             !this exchange routine swaps interface concentration between two partitions
 8682: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 8683: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 8684: 
 8685: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 8686: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 8687: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 8688: 
 8689: 
 8690: //             !This obtains final values for interface sides
 8691: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 8692: //       :    endif !nproc>1
 8693: //           !message passing end
 8694: // !$OMP     end master
 8695: // !$OMP     barrier
 8696: 
 8697: 
 8698: // !         Do advection; conc @ dry elem will not be changed
 8699: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 8700: // !$OMP     do reduction(+: h_mass_in)
 8701: //           do i=1,ne
 8702: //             if(idry_e(i)==1) cycle
 8703: 
 8704: 
 8705: // !           Wet elements with 3 wet nodes
 8706: //             do k=kbe(i)+1,nvrt
 8707: 
 8708: 
 8709: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 8710: //               dtb_by_bigv = dtb/bigv
 8711:     
 8712: // !             Advective flux
 8713: //               if (ntd_weno==1 .or. itd_weno==1) then
 8714: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 8715: //               else
 8716: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 8717: //               endif
 8718: 
 8719: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 8720: //               do j=1,i34(i)
 8721: //                 jsj=elside(j,i) !side
 8722: //                 iweno=.true. !use weno reconstruction as default
 8723: //                 iel=ic3(j,i) !neighboring elem
 8724: 
 8725: //                 if(iel/=0) then
 8726: //                   if(idry_e(iel)==1) cycle
 8727: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 8728: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 8729: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 8730: //                     iweno=.false.
 8731: //                   endif
 8732: //                 else !land or open bnd side
 8733: //                   !skip land bnd and outflowing open bnd, 
 8734: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 8735: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 8736: //                     !For outflow open bnd side, estimate mass in (open
 8737: //                     !side cannot be interface side)
 8738: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 8739: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 8740: //                     endif
 8741: 
 8742: //                     cycle
 8743: //                   endif
 8744: 
 8745: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 8746: //                   iweno=.false.  !reset to upwind
 8747: //                   ibnd=isbs(jsj) !global bnd #
 8748: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
