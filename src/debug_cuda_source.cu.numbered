 1447:    __device__ Mesh(int partNum,
 1448:                    int npgb, int negb, int nsgb, 
 1449:                    int np, int ne, int ns,
 1450:                    int max_np, int max_ne, int max_ns, int nseg,
 1451:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1452:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1453:                    Node    **localNodeNeighNodesMem,
