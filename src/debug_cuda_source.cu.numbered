 8521: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8522:    Node *nodes = mesh->localNodeData;
 8523: 
 8524:    *addr = nodes;
 8525:    *sizeNode = sizeof(Node);
 8526: 
 8527:    switch (varCode) {
 8528:       case (int)VarCode::depth:
 8529:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8530:          *sizeType = sizeof(double);
 8531:          break;
 8532:       case (int)VarCode::eta:
 8533:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8534:          *sizeType = sizeof(double);
 8535:          break;
 8536:       case (int)VarCode::x:
 8537:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8538:          *sizeType = sizeof(Vector2);
 8539:          break;
 8540:       case (int)VarCode::z:
 8541:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8542:          *sizeType = sizeof(double);
 8543:          break;
 8544:       case (int)VarCode::kb:
 8545:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8546:          *sizeType = sizeof(int);
 8547:          break;
 8548:       case (int)VarCode::isdry:
 8549:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8550:          *sizeType = sizeof(int);
 8551:          break;         
 8552:       case (int)VarCode::w:
 8553:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8554:          *sizeType = sizeof(double);
 8555:          break;
 8556:       case (int)VarCode::u:
 8557:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8558:          *sizeType = sizeof(Vector2);
 8559:          break;  
 8560:       case (int)VarCode::u_air:
 8561:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8562:          *sizeType = sizeof(Vector2);
 8563:          break;
 8564:       default:
 8565:          *offset = -1;    
 8566:    }  
 8567:    
 8568: }
