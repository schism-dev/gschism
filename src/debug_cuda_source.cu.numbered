  920:    __inline__ __device__ bool containsPoint(const ShapeCoords &shpCoords) const
  921:    {
  922:       bool res = shpCoords[0] >= 0.0 && shpCoords[0] <= 1.0 &&
  923:                  shpCoords[1] >= 0.0 && shpCoords[1] <= 1.0 &&
  924:                  shpCoords[2] >= 0.0 && shpCoords[2] <= 1.0;
  925:       if (isQuad()) {
  926:          res = res && shpCoords[3] >= 0.0 && shpCoords[3] <= 1.0;
  927:       }
  928:       return res;
  929:    }
