 9506: __global__ void getStructSizes(int* sizes)  {
 9507:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 9508:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 9509:       sizes[0] = (int)sizeof(Node);
 9510:       sizes[1] = (int)sizeof(Element);
 9511:       sizes[2] = (int)sizeof(Side);
 9512:       sizes[3] = (int)sizeof(NodeBoundary);
 9513:       sizes[4] = (int)sizeof(SideBoundary);
 9514:       sizes[5] = (int)sizeof(BoundarySegment);
 9515: }
