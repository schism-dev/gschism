  269: // Polynomial class
  270: template<int grade>
  271: struct Polynomial {
  272:     // Static assertion to give a clear error message at compile time
  273:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  274: };
  275: 
  276: 
  277: // Explicit specialization for grade 4
  278: template<>
  279: struct Polynomial<4> {
  280:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  281: 
  282:    // Constructor from coefficients
  283:    __device__ __host__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  284: 
  285:    __device__ __host__ __forceinline__ double eval(double x) const {
  286:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  287:    }
  288: };
