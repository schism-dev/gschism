 7175: __global__ void returnMatrix(double *res) {
 7176:    // Debugging: returns the matrix as a CuPy array
 7177: 
 7178:    const int size = mesh->np;
 7179:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7180:       const Node *node = mesh->localNodeData + idx_node;
 7181:       res[idx_node*size + idx_node] = node->coeffDiag;
 7182:       for (int j = 0; j < node->numNodes; j++) {
 7183:          Node* nbNode = node->nodes[j];
 7184:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7185:       }
 7186: 
 7187:    }
 7188:    
 7189: }
