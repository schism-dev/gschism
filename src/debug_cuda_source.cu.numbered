 4465: 
 4466: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4467:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4468:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4469: 
 4470: 
 4471:    NODE(node1);
 4472: 
 4473:    node1->clearMatrixRow();
 4474:    node1->qel = 0.0;
 4475: 
 4476:    // THIS IS FOR STRUCTURES XXX
 4477:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4478: 
 4479:    
 4480:    for (int j=0; j<node1->numElements; j++) {
 4481:       // For each element connected to the node...
 4482: 
 4483:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4484: 
 4485:       Element *elem = node1->elements[j];
 4486: 
 4487:       // Compute the average gravity
 4488:       const double grav3 = elem->mean(&Node::grav2);
 4489: 
 4490:       // Look at the documentation for the description of the terms in the following integrals
 4491: 
 4492:       // Integral I_1 
 4493:       // \bar{\breve{H}} 
 4494:       const double hhatb = elem->mean(&Side::hhat);        
 4495: 
 4496:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4497: 
 4498:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4499:       const double area = elem->area;
 4500: 
 4501:       // Integral I_4
 4502:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4503:       // Where
 4504:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4505: 
 4506:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4507:       // of U over the element.
 4508:       const Vector2 U = elem->mean(&Side::U);
 4509: 
 4510:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4511: 
 4512:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4513:       const double I_4_1 = dot(gradPhi_1, U);
 4514: 
 4515: 
 4516:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4517:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4518: 
 4519:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4520: 
 4521: 
 4522:       // Normal component of the bed velocity
 4523:       double ubedNormalComp = 0.0;
 4524:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4525:          Vector3 ubed = {0.0, 0.0, 0.0};
 4526:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4527:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4528: 
 4529:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4530:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4531:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4532: 
 4533:          // Computes the normal component of the bed velocity
 4534:          ubedNormalComp = dot(ubed, N);
 4535:       } // imm==2
 4536: 
 4537:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4538: 
 4539:       if (elem->isTri()) {
 4540: 
 4541:          // To clarify the notation in this section: 
 4542:          //   In formulas, we use the following notation:
 4543:          //       i stands for the node under consideration (node1)
 4544:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4545:          //   However, in the code, we use the following notation:
 4546:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4547:          const int id2 = elem->nxq(1 + id1);
 4548:          const int id3 = elem->nxq(2 + id1);
 4549:          Node *node2 = elem->nodes[id2];
 4550:          Node *node3 = elem->nodes[id3];
 4551: 
 4552:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4553: 
 4554:          // integral of phi_i*phi_j
 4555:          const double ipp_ii = (1.0/6.0 )*area;
 4556:          const double ipp_ij = (1.0/12.0)*area;
 4557:          const double ipp_ik = (1.0/12.0)*area;
 4558: 
 4559:          // integral of [(grad phi_i) * (grad phi_j)]
 4560:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4561:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4562:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4563: 
 4564:          // Computes the different components of integral I_1 of each node with respect to node i.
 4565:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4566:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4567:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4568: 
 4569:          node1->addToSparseMatrix(node1, I1_ii);
 4570:          node1->addToSparseMatrix(node2, I1_ij); 
 4571:          node1->addToSparseMatrix(node3, I1_ik);
 4572: 
 4573:          #pragma unroll
 4574:          for (int l=0; l<3; l++) {
 4575: 
 4576:             Node *node = elem->nodes[l];
 4577: 
 4578:             // Additional variation in eta due to bed deformation or vertical velocity
 4579:             double extraEta = 0.0;
 4580:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4581:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4582: 
 4583: 
 4584:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4585:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4586: 
 4587:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4588: 
 4589:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4590:            
 4591:          }
 4592: 
 4593: 
 4594:       }
 4595:       else { // Quad
 4596:          // To clarify the notation in this section: 
 4597:          //   In formulas, we use the following notation:
 4598:          //       i stands for the node under consideration (node1)
 4599:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4600:          //   However, in the code, we use the following notation:
 4601:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4602:          const int id2 = elem->nxq(1 + id1);
 4603:          const int id3 = elem->nxq(2 + id1);
 4604:          const int id4 = elem->nxq(3 + id1);
 4605:          Node *node2 = elem->nodes[id2];
 4606:          Node *node3 = elem->nodes[id3];
 4607:          Node *node4 = elem->nodes[id4];   
 4608:          
 4609:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4610: 
 4611:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4612:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4613:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4614:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4615:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4616: 
 4617:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4618:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4619:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4620:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4621:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4622: 
 4623: 
 4624:          // Computes the different components of integral I_1 of each node with respect to node i.
 4625:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4626:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4627:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4628:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4629: 
 4630:          node1->addToSparseMatrix(node1, I1_ii);
 4631:          node1->addToSparseMatrix(node2, I1_ij); 
 4632:          node1->addToSparseMatrix(node3, I1_ik);
 4633:          node1->addToSparseMatrix(node4, I1_il);
 4634:   
 4635:          #pragma unroll
 4636:          for (int l=0; l<4; l++) {
 4637: 
 4638:             const Node *node = elem->nodes[l];
 4639: 
 4640:             // Additional variation in eta due to bed deformation or vertical velocity
 4641:             double extraEta = 0.0;
 4642:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4643:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4644: 
 4645:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4646:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4647:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4648: 
 4649:          }         
 4650:       } 
 4651: 
 4652: 
 4653:      node1->qel += (dt/elem->i34)*elem->vsource;
 4654:       
 4655: 
 4656:    } // for all elements connected to the node
 4657:    
 4658: 
 4659:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4660:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4661:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4662:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 4663:    // If it is an open boundary node...
 4664: 
 4665:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4666: 
 4667:       // At least one open bnd side, maybe two
 4668:       for (int l=0; l<2; l++) { 
 4669: 
 4670:          // Gets each of the sides sharing the node. 
 4671:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4672: 
 4673:     
 4674: 
 4675:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4676:          if (sideBnd != nullptr) {
 4677:             // If the side is on a boundary...
 4678: 
 4679:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4680: 
 4681:             // Get the boundary segment
 4682:             const BoundarySegment *sideSegment = sideBnd->segment;
 4683:             const Side *side = sideBnd->side;
 4684: 
 4685:             // Integral I_3
 4686:             if (sideSegment->ifltype != 0) {
 4687:             // Natural or Flather b.c.
 4688: 
 4689:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4690:                // especially for Flather b.c.
 4691:                double ri3 = 0.0;
 4692:                if (!side->isDry) {
 4693:                   // If the side is not dry
 4694:                   
 4695:                   // Computes the side flux of (uth, vth)
 4696:                   double Vn = 0.0;
 4697:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4698:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4699:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4700: 
 4701:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4702:                   }
 4703: 
 4704:                   ri3 = 0.5*side->len*Vn;
 4705:                }
 4706: 
 4707:                if (sideSegment->ifltype == -1) { // Flather 1
 4708: 
 4709:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4710:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4711: 
 4712:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4713:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4714:                   
 4715:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4716:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4717: 
 4718:                } 
 4719:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4720:                   // Reset ri3
 4721:                   ri3 = 0.0;
 4722: 
 4723:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4724:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4725: 
 4726:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4727: 
 4728:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4729:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4730: 
 4731:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4732:                   node1->addToSparseMatrix(node1, con0*2.0);
 4733:                   node1->addToSparseMatrix(node2, con0);
 4734: 
 4735:                } // if Flather or Discharge
 4736: 
 4737:                node1->qel -= thetai*dt*ri3;  
 4738: 
 4739: 
 4740:             } // I_3
 4741:           
 4742: 
 4743:             // Integral I_5
 4744:             if(!side->isDry) {
 4745: 
 4746:                const double Unbar = dot(side->U, side->n);
 4747:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4748: 
 4749:             } // I_5
 4750: 
 4751:          } // if is boundary side
 4752: 
 4753:       } // for l
 4754: 
 4755:    } // if isbnd
 4756: 
 4757: 
 4758: }
 4759: 
 4760: 
 4761: 
 4762: extern "C" {
 4763:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 4764:                                  int* indices, int* indptr) {
 4765: 
 4766:       NODE(node);
 4767:       
 4768:       const int idx = node->idx;
 4769:       
 4770:       // Computes the index in the nzz array      
 4771:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 4772: 
 4773: 
 4774:       indptr[idx] = nzzIdx;
 4775:       indices[nzzIdx] = idx;
 4776: 
 4777:       data_d[nzzIdx]    = node->coeffDiag;
 4778: 
 4779:       b_d[idx] = node->qel;
 4780: 
 4781:       for (int k = 0; k < node->numNodes; ++k) {
 4782:          const Node* nb = node->nodes[k];
 4783: 
 4784:          const int j = nb->idx;
 4785: 
 4786:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4787: 
 4788:          indices[nzzIdx + k + 1] = j;
 4789:       }
 4790: 
 4791:    }
 4792: 
 4793:    __global__ void setupMultiGPUCGSolver(double* data_d, double* b_d, 
 4794:                                          int *indices, int *indptr) {
 4795:    // Builds all the A_ij matrices and b_i and x_i vectors for the solver.
 4796: 
 4797:       NODE(node);
 4798: 
 4799:       // Global and local indices of the node.
 4800:       // In this function, I stands for the global index of the current node,
 4801:       // and J stands for the global index of the neighbor node under consideration.
 4802:       // i and j are the local indices of the current node and the neighbor node under consideration.
 4803:       // Notice that i and j may be local to different GPUs.
 4804:       // idxPart is the number of the partition of the *neighbor* node. There is
 4805:       // a biunivocal correspondence between the partitions and the GPUs.
 4806:       const int I = node->idx;
 4807:       const int i = idx_node;
 4808:       const int partI = node->part;
 4809:       
 4810:       // // Computes the index in the nzz array      
 4811:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4812: 
 4813: 
 4814:       // indptr[idx] = nzzIdx;
 4815:       // indices[nzzIdx] = idx;
 4816: 
 4817:       // data_d[nzzIdx]    = node->coeffDiag;
 4818: 
 4819:       // b_d[idx] = node->qel;
 4820:       setBValue(partI, i, idxCSR, node->qel);
 4821:       bool diagonalUsed = false;
 4822:       const int numCoeffs = node->numNodes + 1;  // Includes the diagonal element
 4823:       int i1 = -1;
 4824:       for (int k = 0; k < numCoeffs; ++k) {
 4825: 
 4826:          // Get the next node sorted by the global index.
 4827:          // This includes the diagonal element, that is stored as coeffDiag
 4828:          // const Node* nb = node->getNodeSorted(k);
 4829:          const double coeff = node->getCoeffSorted(k);
 4830:  
 4831:          const int J = nb->idx;
 4832:          // const int j = nb - mesh->nodes[nb->part]; // Tricky! The local index is computed as the difference between the pointer to the node and the pointer to the first node stored in the partition.
 4833:          const int partJ = nb->part;
 4834: 
 4835:          const int idxCSR = countPerPartition[partJ];
 4836: 
 4837:          setAValue(partI, partJ, i, idxCSR, coeff);
 4838:          
 4839:          countPerPartition[partJ]++;
 4840: 
 4841: 
 4842:       //    data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4843: 
 4844:       //    indices[nzzIdx + k + 1] = j;
 4845:       // }
 4846:       }
 4847:  
 4848:    }
 4849: }
