 4125:    __global__ void solverCopyResult(double* x) {
 4126:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4127:       NODE(node);
 4128:       const int idx = node->idx;
 4129: 
 4130:       node->mX = x[idx];
