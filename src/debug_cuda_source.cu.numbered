 9522: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 9523:    // Get the value of a variable from an side
 9524:    // varName is the name of the variable to get
 9525:    // var is the array to store the value
 9526:    // k is the vertical level index of the variable to get
 9527:    SIDE_BND(sideBnd);   
 9528: 
 9529:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 9530:    if (sideBnd->segment->isLand) idx = -7;
 9531: 
 9532:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 9533:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 9534: 
 9535: }
