 1380: struct Node {
 1381: 
 1382:    // Geometry information
 1383:    int idx;        // Index of the node
 1384:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1385:    int numNodes;   // Number of nodes neighbors of this node
 1386: 
 1387:    Element **elements; // Array of pointers to the elements that share this node
 1388:    int numElements;    // Number of elements that share this node
 1389: 
 1390:    int numSides;       // Number of sides that are connected to this node
 1391: 
 1392:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1393:    double gz;          // Global vertical coordinate at the node.
 1394:    Vector2 u2[nvrt];
 1395:    double  w2[nvrt];
 1396:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1397:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1398:    double lon, lat;
 1399:    double depth;
 1400: 
 1401:    Frame<ics> frame;
 1402: 
 1403:    LocalSigma<ivcor> localSigma;  
 1404: 
 1405:    int kb;       // Bottom index of the node
 1406: 
 1407:    bool isDry;     // True if the node is dry
 1408: 
 1409:    int iadv;     // Advection flag
 1410: 
 1411:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1412:                           // this is nullptr
 1413: 
 1414:    TempVar tmp; // Temporary variable to store different types of variables
 1415: 
 1416:    // Physical information
 1417:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1418:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1419: 
 1420:    double rho[nvrt];     // Density
 1421:    double dfv[nvrt];     // Vertical viscosity
 1422: 
 1423:    double eta1; // Elevation at nodes at previous timestep
 1424:    double eta2; // Elevation at nodes at current timestep
 1425: 
 1426:    double ETP;  // Earth Tidal Potential
 1427: 
 1428:    double pr;    // Air pressure
 1429:    double grav2; // Gravity 
 1430:    
 1431:    Vector2 dav;  // Depth averaged velocity
 1432: 
 1433:    Vector2 tau; // Wind stress vector
 1434: 
 1435:    // Vegetation parameters
 1436:    double veg_h;
 1437:    double veg_nv;
 1438:    double veg_di;
 1439:    double veg_Cd;
 1440:    double veg_h_unbent;
 1441:    double veg_di_unbent;
 1442:    double veg_nv_unbent;
 1443:    double veg_alpha_vert_mean;
 1444:    double veg_alpha0;
 1445:    double veg_alpha3D[nvrt];
 1446: 
 1447:    // Bottom drag parameters
 1448:    double Cd;       // Bottom drag coefficient   
 1449: 
 1450:    // These three are mutually exclusive
 1451:    union {
 1452:       double rmanning; // Bottom Manning's coefficient
 1453:       double rough;    // Bottom roughness length
 1454:       double drag;     // Bottom drag coefficient
 1455:    };
 1456:    Vector2 tau_bot; // Bottom stress vector
 1457: 
 1458:    // XXXX REMOVE FOR IMM>0???
 1459:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1460:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1461: 
 1462:    double qel; // RHS
 1463:    double coeffDiag; // Diagonal coefficient of the matrix
 1464:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1465: 
 1466:    // This was used by a previous version of the conjugate gradient method
 1467:    // double mP; // Search direction for conjugate gradient method
 1468:    // double mR; // Residual for conjugate gradient method
 1469:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1470: 
 1471:    double mX; // Solution of the FEM system
 1472: 
 1473:    // Meteorological forcing
 1474:    Vector2 u_air;
 1475:    double p_air;  // XXXX is this the same as pr?
 1476:    double t_air;
 1477:    double q_air;
 1478:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1479: 
 1480:    __device__ void setWind(Vector2 &u) {
 1481:    // Sets the wind vector taking into account the mesh angle
 1482:    
 1483:       const double speed = length(u);
 1484: 
 1485:       // Rotate wind vector to the node frame
 1486:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1487: 
 1488:       // Sets the surface stress vector due to wind.
 1489:       if constexpr(nws == 0) {
 1490:          tau = {0.0, 0.0};
 1491: 
 1492:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1493:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1494: 
 1495:       } else {
 1496: 
 1497:          double dragcoef;
 1498: 
 1499:          if constexpr(iwind_form == -1) {
 1500:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1501:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1502: 
 1503:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1504:             tau = cff*u_air;
 1505:  
 1506:          } else if constexpr(iwind_form == 1) {
 1507:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1508:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1509: 
 1510:             dragcoef = max(dragcoef, 4.0e-4);
 1511:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1512:             tau = cff*u_air;
 1513: 
 1514:          } else {
 1515:             tau = {0.0, 0.0};
 1516:          }
 1517:       }
 1518:    }
 1519: 
 1520: 
 1521:    __device__ void setFrame(double lat, double lon) {
 1522:       if constexpr(ics == 1) return;
 1523: 
 1524:       frame.update(lat, lon);        
 1525:     }
 1526: 
 1527:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1528: 
 1529:    __device__ double sigmaTransitionDepth(void) const;
 1530: 
 1531:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1532: 
 1533:    __inline__ __device__ Point2 outputCoords(void) const {
 1534:       if constexpr(ics == 1)  return p;
 1535:       else                    return {rad2deg*lon, rad2deg*lat};
 1536:    }
 1537: 
 1538:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1539:    // If ics == 2, convert the global point to the local frame
 1540:       
 1541:       if constexpr (ics == 1) {
 1542:          return p;
 1543:       } else {
 1544:          const Point3 c = {p.x, p.y, gz};
 1545:          const Point3 local = frame.G2L(p - c);
 1546:          return local;
 1547:       }
 1548:    }
 1549: 
 1550:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1551:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1552:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1553:    
 1554:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1555: 
 1556:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1557: 
 1558:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1559:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1560: 
 1561:    __device__ __forceinline__ void clearMatrixRow(void) {
 1562:       // Clear the matrix row for this node
 1563: 
 1564: 
 1565:       coeffDiag = 0.0;
 1566: 
 1567:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1568: 
 1569:    }
 1570: 
 1571:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1572:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1573:       
 1574:       if (node == this) {
 1575:          coeffDiag += value;
 1576:      
 1577:       } else {
 1578:          // Search (linearly) the index of the node in the array of nodes
 1579:          // XXX: This is not efficient, see if we can improve this
 1580:          int i;
 1581:          for (i = 0; i < numNodes; i++) {
 1582:             if (nodes[i] == node) {
 1583:                break;
 1584:             }
 1585:          }
 1586:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1587:          coeffMatrix[i] += value;
 1588:       }
 1589:    }
 1590: 
 1591: 
 1592:    __device__ __inline__ void updateZCoordData(void);
 1593: 
 1594:    __device__ __forceinline__ double compZCoord(int k) const;
 1595: 
 1596:    __device__ void updateKb(void);
 1597: 
 1598:    __device__ __forceinline__ void computeBottomDragCd(void);
 1599: 
 1600: 
 1601: 
 1602: };
