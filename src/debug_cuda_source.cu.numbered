 6053:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6054: 
 6055:       NODE(node);
 6056: 
 6057:       node->ETP = 0.0;
 6058: 
 6059:       if constexpr(ntip == 0) return;
 6060: 
 6061:       // For all tidal potential components
 6062:       for (int j=0; j<ntip; j++) {
 6063: 
 6064:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6065: 
 6066:          node->ETP += nodeETP;
 6067: 
 6068:          if constexpr(iloadtide==1) { // loading tide
 6069:             assert(false && "Loading tide not implemented");
 6070:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6071:          }
 6072:          
 6073:       }
 6074: 
 6075:      
 6076:    }
