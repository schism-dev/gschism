 2574:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2575:    // Project the vectors from the node frame to the element frame
 2576: 
 2577:  
 2578:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2579:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2580:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2581:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2582:       else          v[3] = Vector2();
 2583:    }
 2584: 
 2585:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2586:    // Project the vectors from the side frame to the element frame
 2587: 
 2588:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2589:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2590:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2591:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2592:       else          v[3] = Vector2();
 2593:    }
