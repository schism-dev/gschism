 2110: 
 2111: /**
 2112:    Compute the shape coordinates of the point (xt,yt) in the element.
 2113:    @param xt (input): x-coordinate of the point
 2114:    @param shpCoords (output): shape coordinates of the point
 2115: **/
 2116: __device__ void Element::computeShapeCoords(Point2 &xt, ShapeCoords &shpCoords) const {
 2117: 
 2118:    // Compute the shape coordinates of the point xt in the element.
 2119:    if (i34==3) {
 2120:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2121:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2122:       // and in this case, the pt will be nudged into the element
 2123:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2124:       // from the local frame, so use additional check.
 2125: 
 2126:       Point2 x0, x1, x2;
 2127: 
 2128:       if constexpr(ics==1) {
 2129:          x0 = nodes[0]->p;
 2130:          x1 = nodes[1]->p;
 2131:          x2 = nodes[2]->p;
 2132:       }
 2133:       else // lat/lon
 2134:       {
 2135:          Error("Not implemented yet");
 2136:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2137:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2138:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2139:       }
 2140: 
 2141:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2142:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2143:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2144:       shpCoords[3] = 0.0;
 2145: 
 2146:    }
 2147:    else {
 2148:       Error("Not implemented yet");
 2149: #ifdef QUADS
 2150:       // Reproject pt in eframe of nel for ics=2
 2151:       if constexpr(ics==1) {
 2152:          xn2 = xt; 
 2153:          yn2 = yt;
 2154:       }
 2155:       else {
 2156:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2157:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2158:       }
 2159: 
 2160:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2161: #endif
 2162:    }
 2163: 
 2164: 
 2165: }
 2166: 
 2167: 
 2168: __device__ void Element::shapeCoordsToXY(ShapeCoords const &shpCoords, Vector2 &xt) const {
 2169: // Convert shape coordinates to cartesian coordinates
 2170: 
 2171:    assert(false && "shapeCoordsToXY: Not implemented, xt is not modified"); 
 2172:    if (i34 == 3) {
 2173:       // Triangular element
 2174:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2175:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2176:    }
 2177:    else {
 2178:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2179:    }
 2180: 
 2181: }
 2182: 
 2183: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2184:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2185:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2186:    // The formula for the integral is:
 2187:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2188: 
 2189:    printf("intPhiPhi: TEST\n");
 2190: 
 2191:    const Node *n0 = nodes[0];
 2192:    const Node *n1 = nodes[1];
 2193:    const Node *n2 = nodes[2];
 2194:    const Node *n3 = nodes[3];
 2195: 
 2196:    const Vector2 p0 = n0->p;
 2197:    const Vector2 p1 = n1->p;
 2198:    const Vector2 p2 = n2->p;
 2199:    const Vector2 p3 = n3->p;
 2200: 
 2201:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2202:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2203:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2204:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2205: 
 2206:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2207: }
 2208:    
 2209: 
 2210: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2211:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2212:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2213:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2214:    // The formula is also based on the identity:
 2215:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2216:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2217: 
 2218:    printf("intGradPhiGradPhi: TEST\n");   
 2219: 
 2220:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2221: 
 2222:    const double x0 = nodes[0]->p.x;
 2223:    const double y0 = nodes[0]->p.y;
 2224:    const double x1 = nodes[1]->p.x;
 2225:    const double y1 = nodes[1]->p.y;
 2226:    const double x2 = nodes[2]->p.x;
 2227:    const double y2 = nodes[2]->p.y;
 2228:    const double x3 = nodes[3]->p.x;
 2229:    const double y3 = nodes[3]->p.y;
 2230: 
 2231:    double res = 0.0;
 2232:    
 2233:    // Quadrature points in xi and eta coordinates
 2234:    #pragma unroll
 2235:    for (int i = 0; i < 4; i++) {
 2236:       // For each quadrature point...
 2237: 
 2238:       const Point2 p = GaussPoint(i);
 2239:       const double eta = p.x;
 2240:       const double xi  = p.y;
 2241: 
 2242:       // Jacobian entries at the Gauss point p
 2243:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2244:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2245:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2246:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2247: 
 2248:       const double detJ = jacobianDet(p);
 2249:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2250: 
 2251:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2252:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2253:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2254:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2255:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2256: 
 2257:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2258:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2259:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2260:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2261:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2262: 
 2263:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2264:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2265:    }
 2266: 
 2267:    return res;
 2268: }
 2269: 
 2270: 
 2271: /**  Interpolate velocities at a given point (xt,yt,zt)
 2272: 
 2273:    @param xt, yt, zt: coordinates of the point to interpolate
 2274:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2275: 
 2276:    This is done in four steps:
 2277: 
 2278:    1. Find the shape coordinates for the final position in the element.
 2279:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2280:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2281:       z levels at xt, yt at each step.   
 2282:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2283:       horizontally and vertically.
 2284: **/
 2285: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2286:    // Interpolate the velocities at the point xt. 
 2287:    // This function works the same for triangular and quadrilateral elements.
 2288:    ShapeCoords shpCoord;
 2289: 
 2290:    // First step is to compute the shape coordinates of (xt,yt)
 2291:    computeShapeCoords(toVector2(xt), shpCoord);
 2292: 
 2293: if ((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) < -small))   {
 2294:    printf("Invalid shape coordinates: shpCoord[0] = %f, shpCoord[1] = %f, shpCoord[2] = %f, shpCoord[3] = %f, xt = %f, yt = %f, zt = %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3], xt.x, xt.y, xt.z);
 2295:    return;
 2296: }
 2297:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2298: 
 2299:    // Second step is to find the level that contains zt
 2300:    // Uses a binary search to find the level
 2301:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2302:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2303:    int R = nvrt - 1;
 2304: 
 2305:    // Get the z coordinates at the nodes of the element at the levels L and R
 2306:    ShapeCoords zLAtNodes, zRAtNodes, zMAtNodes;
 2307:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2308:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2309: 
 2310:    double zL = interpolate(shpCoord, zLAtNodes);
 2311:    double zR = interpolate(shpCoord, zRAtNodes);
 2312:    
 2313:    // Interpolates vertically the velocities
 2314:    double wght1, wght2;
 2315:    if (xt.z<=zL) {
 2316:       wght1 = 1.0;
 2317:       wght2 = 0.0;
 2318:       xt.z = zL;
 2319:    }
 2320:    else if (xt.z>=zR) {
 2321:       wght1 = 0.0;
 2322:       wght2 = 1.0;
 2323:       xt.z = zR;
 2324:    }
 2325:    else {
 2326:       // Perform a binary search to find the levels between L and R that contain xt.z
 2327:       while (R - L > 1) {
 2328:          int M = (L + R) / 2.0;
 2329: 
 2330:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2331:          double zM = interpolate(shpCoord, zMAtNodes);
 2332:          if (zM < xt.z) 
 2333:          {
 2334:             L = M;
 2335:             zL = zM;
 2336:          }
 2337:          else 
 2338:          {
 2339:             R = M;
 2340:             zR = zM;
 2341:          }
 2342:       }
 2343:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2344:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2345: 
 2346:       wght2 = (xt.z - zL)/(zR - zL);
 2347:       wght1 = 1.0 - wght2;
 2348: 
 2349:    }
 2350: 
 2351: 
 2352:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2353:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2354: 
 2355: if (isnan(u_int.x) || isnan(u_int.y) || isnan(u_int.z))  {
 2356: printf("NaN velocities in interpolateVelocities: xt.z = %f, zL = %f, zR = %f, wght1 = %f, wght2 = %f, u_int = %f, %f, %f\n", xt.z, zL, zR, wght1, wght2, u_int.x, u_int.y, u_int.z);
 2357: u_int = {0.0, 0.0, 0.0};
 2358: return;
 2359: }
 2360:    // Neither of the interpolated velocities should be NaN
 2361:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2362: 
 2363: }
 2364: 
 2365: 
