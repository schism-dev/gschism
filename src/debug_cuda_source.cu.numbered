 4048:    __global__ void computeFlowBcVelocities(double time) {
 4049: 
 4050:       SIDE_BND(sideBnd);
 4051: 
 4052:       const Side *side = sideBnd->side;
 4053:  
 4054:       const bool isDry = side->isDry;
 4055: 
 4056:       if (isDry) {
 4057:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4058:          return;
 4059:       }
 4060: 
 4061:       // For wet sides in open boundaries...
 4062:       const Vector2 n = side->n;
 4063:       const BoundarySegment *segment = sideBnd->segment;
 4064: 
 4065:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4066: 
 4067:       const int ifltype = segment->ifltype;
 4068:       const int iettype = segment->iettype;
 4069: 
 4070:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4071:       const Vector2 r_nuth0 = r_uth0*n;
 4072: 
 4073: 
 4074: printf("ZZZ4  idx = %d, ifltype = %d, r_nuth0 = %f, %f\n", sideBnd->side->idx, ifltype, r_nuth0.x, r_nuth0.y);
 4075:       for (int k = 0; k < nvrt; k++) {
 4076:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4077:          Vector2 r_u1_bar = {0.0, 0.0};
 4078:       
 4079:          if (ifltype == 1 || ifltype == 2) {
 4080:          
 4081:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4082: 
 4083:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4084:             
 4085:             r_uth = unth0*n;  // This case has no ramp-up
 4086:             
 4087:          } else if (ifltype == -1) { // Flather 1
 4088: 
 4089:             // uth is the normal vel.; no ramp up
 4090:             const double uth = sideBnd->nuth(k);
 4091:             r_uth = uth*n;
 4092:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4093: 
 4094: 
 4095:          } else if (ifltype == 3 || ifltype == 5) {
 4096:             // vnth0=0 !normal vel.
 4097: 
 4098: printf("ZZZ3  idx = %d, jfr = %d, ifltype = %d, r_uth = %f, %f\n", sideBnd->side->idx, nbfr, ifltype, r_uth.x, r_uth.y);
 4099:             // Computes the contribution to the velocity from all tide frequencies
 4100:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4101: 
 4102:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4103:                const Vector2 umo  = sideBnd->umo(jfr); 
 4104: 
 4105:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4106:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4107:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4108:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4109: printf("ZZZ2  idx = %d, jfr = %d, ncyc = %d, face = %f, argx = %f, argy = %f, umo = %f, %f, ufa = %f, %f, ramp = %f, ff = %f, r_u1_bar = %e, %e\n", sideBnd->side->idx, jfr, ncyc, face[jfr], argx, argy, umo.x, umo.y, ufa.x, ufa.y, ramp, ff[jfr], r_u1_bar.x, r_u1_bar.y);               
 4110:             }
 4111: 
 4112:          } // if (ifltype = 3 || ifltype == 5
 4113: 
 4114: 
 4115:          switch (iettype) {
 4116:             case 1:
 4117:             case 2:
 4118:             case 4:
 4119:                sideBnd->ubc[k] = r_uth;
 4120:                break;
 4121:             case 3:
 4122:                sideBnd->ubc[k] = r_u1_bar;
 4123:                break;
 4124:             case 5:
 4125:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4126:                break;
 4127:          } // switch
 4128: 
 4129: printf("ZZZ  idx = %d, iettype = %d, r_u1_bar = %f, %f, sideBnd->ubc[%d] = %f, %f\n", sideBnd->side->idx, iettype, r_u1_bar.x, r_u1_bar.y, k, sideBnd->ubc[k].x, sideBnd->ubc[k].y);
 4130:       } // for k
 4131:    }
 4132: 
 4133:    __global__ void computeElevationBoundaryConditions(double time) {
 4134:       // Compute elevation essential boundary conditions 
 4135: 
 4136:       NODE_BND(nodeBnd); // Each boundary node.
 4137: 
 4138:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4139: 
 4140:       const Node *node = nodeBnd->node;
 4141:       const BoundarySegment *segment = nodeBnd->segment;
 4142:       const int iettype = segment->iettype;
 4143:       
 4144: 
 4145:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4146:       double eic = 0.0;
 4147:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4148:       else                 eic = 0.0;
 4149: 
 4150:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4151:       const double r_eth = ramp*nodeBnd->eth;
 4152:       double r_eta1_bar = 0.0;
 4153: 
 4154: 
 4155:       // Compute tide elevation
 4156:       if (iettype == 3 || iettype == 5) {   
 4157: 
 4158:          if constexpr(iloadtide==1) { // loading tide
 4159:             assert(false && "Loading tide not implemented");
 4160:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4161:          }
 4162:          
 4163:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4164: 
 4165:             const double efa  = nodeBnd->efa[jfr]; 
 4166:             const double emo  = nodeBnd->emo[jfr]; 
 4167: 
 4168:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4169:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4170:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4171: 
 4172:          } // for jfr
 4173: 
 4174:       } // if iettype
 4175: 
 4176:       switch (iettype) {
 4177:          case 1:
 4178:          case 2:
 4179:          case 4:
 4180:             nodeBnd->elbc = r_eic + r_eth;
 4181:             break;
 4182:          case 3:
 4183:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4184:             break;
 4185:          case 5:
 4186:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4187:             break;
 4188:       } // switch
 4189: 
 4190: 
 4191:       //Add inverse barometric effects
 4192:       if (iettype != 0 && inv_atm_bnd == 1) {
 4193:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4194:       }
 4195: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 4196:    }
 4197: 
 4198: 
 4199:    __global__ void computeHorizontalViscosity(void) { 
 4200: 
 4201:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4202: 
 4203:       SIDE(side);
 4204: 
 4205:       if (side->isDry) return;
 4206: 
 4207:       for (int k = 0; k < nvrt; k++) {
 4208:          side->nuGradU[k] = {0.0, 0.0};
 4209:       }
 4210: 
 4211:       if constexpr(ihorcon == 1) {
 4212:          for (int k = side->kb; k < nvrt - 1; k++) {
 4213:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4214:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4215:             // By Zhang and Baptista.
 4216: 
 4217:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4218:             // This is a standard discretization of the Laplacian operator.
 4219:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4220:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4221:             // Gamma is hvis_coef0 in the code.
 4222:             // The value of gamma needs to be < 0.5.
 4223: 
 4224:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4225:             // side under consideration in each of the two possible elements that share the side.
 4226:             Vector2 sumU = {0.0, 0.0};
 4227:             for (int l = 0; l < 2; l++) {
 4228:                const Element *elem = side->elems[l];
 4229: 
 4230:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4231: 
 4232:                // Find the local index of the side in the element
 4233:                const int idxSide = elem->sideLocalIdx(side);
 4234:                // Find the two sides that are connected to the side under consideration
 4235:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4236:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4237: 
 4238:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4239: 
 4240:             }
 4241: 
 4242:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4243:    printf("+++++ side->nuGradU = %f, %f\n", side->nuGradU[k].x, side->nuGradU[k].y);
 4244: 
 4245:    
 4246:          }
 4247:       }
 4248:       else if constexpr(ihorcon == 2) {
 4249:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4250:       }
 4251: 
 4252: 
 4253:    }
 4254: 
 4255: 
 4256:    __global__ void setEssentialBC(void) {
 4257:       // Set essential boundary conditions 
 4258:       NODE(node); // Each boundary node
 4259:       NodeBoundary *nodeBnd = node->nodeBnd;
 4260: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 4261:       
 4262: // nodeBnd->isEssentialBC = true;      
 4263:       // Check if this node has essential BC
 4264:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4265:          // Verify BC value is valid
 4266:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4267: 
 4268:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 4269:          
 4270:          // Set diagonal to 1 and zero off-diagonals
 4271:          node->coeffDiag = 1.0;
 4272:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 4273: 
 4274:          for (int j = 0; j < node->numNodes; j++) {
 4275:                node->coeffMatrix[j] = 0.0;
 4276:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4277:          }
 4278:          
 4279:          // Set solution and RHS to BC value
 4280:          node->mX  = nodeBnd->elbc;
 4281:          node->qel = nodeBnd->elbc;
 4282: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 4283:       } else {
 4284:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4285: 
 4286:          for (int j = 0; j < node->numNodes; j++) {
 4287:                Node* nbNode = node->nodes[j];
 4288:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4289:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4290:                   // Verify neighbor's BC value
 4291:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4292: 
 4293:                   // Subtract contribution to RHS
 4294:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4295:                   node->coeffMatrix[j] = 0.0;  
 4296:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4297:                }
 4298:          }
 4299:       }
 4300:    }
 4301: 
 4302: 
 4303:    __global__ void updateElevation(void) {
 4304:       NODE(node);
 4305: 
 4306:       node->eta2 = node->mX;
 4307: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 4308:    }
