 3785:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3786:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3787:                 int *isdel, int *isidenode, int *isbnd,
 3788:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3789:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
