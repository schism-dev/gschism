 4034:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4035: 
 4036:       NODE_BND(nodeBnd);
 4037: 
 4038:       Node *node = nodeBnd->node;
 4039: 
 4040:       node->ETP = 0.0;
 4041: 
 4042:       for (int j=0; j<ntip; j++) {
 4043: 
 4044:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4045:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4046:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4047: 
 4048:          if constexpr(iloadtide==1) { // loading tide
 4049:             assert(false && "Loading tide not implemented");
 4050:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4051:          }
 4052:          
 4053:       }
 4054:       
 4055:    }
