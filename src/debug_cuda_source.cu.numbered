 8591:       case (int)VarCode::x:
 8592:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8593:          *sizeType = sizeof(Vector2);
 8594:          break;
 8595:       case (int)VarCode::z:
 8596:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8597:          *sizeType = sizeof(double);
 8598:          break;
 8599:       case (int)VarCode::kb:
 8600:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8601:          *sizeType = sizeof(int);
 8602:          break;
 8603:       case (int)VarCode::isdry:
 8604:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8605:          *sizeType = sizeof(int);
 8606:          break;         
 8607:       case (int)VarCode::w:
 8608:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8609:          *sizeType = sizeof(double);
 8610:          break;
 8611:       case (int)VarCode::u:
 8612:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8613:          *sizeType = sizeof(Vector2);
 8614:          break;  
 8615:       case (int)VarCode::u_air:
 8616:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8617:          *sizeType = sizeof(Vector2);
 8618:          break;
 8619:       default:
 8620:          *offset = -1;    
 8621:    }  
 8622:    
 8623: }
