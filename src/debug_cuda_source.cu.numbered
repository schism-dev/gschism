 2600: 
 2601: /**
 2602:  * This method performs backtracking from the side center until a time -dt back in time 
 2603:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2604:  * intermediate point.
 2605:  *
 2606:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2607:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2608:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2609:  * remaining time.
 2610:  * 
 2611:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2612:  * 
 2613:  * @param uuint, vvint, wwint: Velocities at the final point
 2614:  * @param jlev: Level at which the backtracking is performed
 2615:  * @param dt, dtbk: Tracking timesteps
 2616:  * @return: True if the backtracking was successful, false otherwise
 2617:  */
 2618: __inline__ __device__ bool Side::btrack(
 2619:       int jlev,
 2620:       double dt,            // Tracking time
 2621:       double dtbk,          // Tracking timestep
 2622:       Vector3 &u_int        // Velocities at the initial point
 2623: ) const {
 2624: 
 2625:    // Start from side center
 2626:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2627: 
 2628:  
 2629:    double time_rm = dt; // Remaining time
 2630: 
 2631: 
 2632:    // // Initialize outputs XXX
 2633:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2634:    //    sclr[i] = 0.0;
 2635:    // }
 2636: 
 2637: 
 2638:    // Initial velocities
 2639:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2640: 
 2641:    // Find the element that is in the direction opposite to the velocity
 2642:    Element* curElem = findElementTowards(toVector2(u_int));
 2643: 
 2644: 
 2645:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2646:    if (curElem == nullptr) {
 2647:       // Make velocity parallel to the side
 2648:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2649:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2650:       curElem = otherElem(curElem);
 2651:       
 2652:    }
 2653: 
 2654: // Nudges it towards the circumcenter
 2655: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2656: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2657:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2658: const double eps = 9.013e-3;                 
 2659: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2660: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2661: 
 2662: 
 2663: 
 2664:    const int MAX_ITERATIONS = 1000; 
 2665:    Element* nextElem = curElem;
 2666:    int iter = 0;
 2667:    while(true) {
 2668: 
 2669:       // Calculate timestep
 2670:       double dtb = min(dtbk, time_rm);
 2671: 
 2672:       // Next point in the backtracking curve
 2673:       Point3 xt = x0 - dtb*u_int;
 2674:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2675:       assert(found && "Backtracking failed in btrack");
 2676: 
 2677:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2678: 
 2679:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2680:                       // then time_rm needs to be increased by the unused time.
 2681: 
 2682:       // If the velocity is too small, we stop the backtracking
 2683:       const double vmag = length(toVector2(u_int));
 2684:       if (vmag <= velmin_btrack) break;
 2685: 
 2686:       // The current point becomes the next segment's starting point.
 2687:       x0 = xt;
 2688:  
 2689:       curElem = nextElem;
 2690: 
 2691:       iter++;
 2692:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2693:    }
 2694: 
 2695: 
 2696: }
 2697: 
