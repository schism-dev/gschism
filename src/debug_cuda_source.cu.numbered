 1589:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1590:       // Compute the different time ramps used in the code 
 1591:       // This function is performed by just one thread
 1592: 
 1593:       if constexpr(ibc == 0) {
 1594:          if (drampbc > 0.0) {
 1595:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1596:          } else {
 1597:             rampbc = 1.0;
 1598:          }
 1599: 
 1600:          if (nws != 0 && drampwind > 0.0) {
 1601:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1602:          } else {
 1603:             rampwind = 1.0;
 1604:          }
 1605:       }
 1606: 
 1607:       if (drampwafo > 0.0) {
 1608:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1609:       } else {
 1610:          rampwafo = 1.0;
 1611:       }
 1612: 
 1613:       // For source/sinks
 1614:       if (if_source && dramp_ss > 0.0) {
 1615:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1616:       } else {
 1617:          ramp_ss = 1.0;
 1618:       }
 1619: 
 1620:       if (dramp > 0.0) {
 1621:          ramp = tanh(2.0*time/86400.0/dramp);
 1622:       } else {
 1623:          ramp = 1.0;
 1624:       }
 1625: 
 1626:    }
