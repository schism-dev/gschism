 5079:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5080:       NODE(node);
 5081: 
 5082:       const int idx = node->idx;
 5083:       Vector2 wind = {xWind[idx], yWind[idx]};
 5084: 
 5085:       if constexpr(nws != 0 && iwindoff != 0) {
 5086:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5087:       }
 5088: 
 5089:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5090:       node->setWind(wind);
 5091: 
 5092:       node->pr = pressAir[idx];
 5093:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5094: 
 5095:    }
