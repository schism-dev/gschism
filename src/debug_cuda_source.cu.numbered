 1398: struct BTPoint {
 1399:    Point3 x;
 1400:    // double pad1;
 1401:    Vector3 u;  // Velocity interpolated at the current point. It is not necessarily the one used to compute the next point (because sliding along a side is allowed)
 1402:    // double pad2;
 1403:    double dt;
 1404:    double  t; // Parametric value of the point on the side when type is btSide. This is not a time!!!
 1405: 
 1406:    Element *elem;
 1407:    Side    *side;
 1408:    Node    *node;
 1409: 
 1410:    enum class BTPointType {btElement, btSide, btNode};
 1411:    BTPointType type;
 1412: 
 1413:    __device__ BTPoint() 
 1414:       : x({0.0, 0.0, 0.0}), u({0.0, 0.0, 0.0}), dt(0.0), t(0.0), 
 1415:         elem(nullptr), side(nullptr), node(nullptr), type(BTPointType::btElement) {}
 1416:    
 1417:    __device__ BTPoint(Point3 x_, BTPointType type_, Element *elem_ = nullptr, Side *side_ = nullptr, Node *node_ = nullptr, double t_ = 0.0, double dt_ = 0.0, Vector3 u_ = {0.0, 0.0, 0.0})
 1418:       : x(x_), u(u_), dt(dt_), type(type_), elem(elem_), side(side_), node(node_), t(t_) {}
 1419: };
