 1336: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1337:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1338: }
 1339: 
 1340: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1341:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1342: }   
 1343: 
 1344: __device__ __inline__ double min3(double a, double b, double c) {
 1345:    return min(a, min(b, c));
 1346: }
 1347: 
 1348: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1349:    return min(a, min(b, min(c, d)));
 1350: }
