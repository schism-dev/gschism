 1541:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1542:    // If ics == 2, convert the global point to the local frame of the side
 1543:       
 1544:       if constexpr (ics == 1) {
 1545:          return p;
 1546:       } else {
 1547:          const Point3 c = {center.x, center.y, centerZ()};
 1548:          const Point3 local = frame.G2L(p - c);
 1549:          return local;
 1550:       }
 1551:    }
 1552: 
 1553:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1554:       if constexpr (ics == 1) {
 1555:          return p;
 1556:       } else {
 1557:          const Point3 c = {center.x, center.y, centerZ()};
 1558:          return c + frame.L2G(p);
 1559:       }
 1560:    }
 1561: 
 1562: 
 1563:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1564:       if constexpr(ics == 1) return v;
 1565:       else return v_frame.projHorVec(v, frame);
 1566:    }
 1567: 
 1568:    __inline__ __device__ double centerZ(void)      const;
 1569:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1570:    // k is the upper level of the layer (same convention as Dz).
 1571:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt && k > 0); return zc[k] - zc[k - 1]; }
 1572:    __inline__ __device__ double area(int k)        const { assert(k < nvrt && k > 0); return len*Dz(k); }
 1573:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt && k > 0); return len*(zc[max(k, kb)] - zc[max(k - 1, kb)]); }
 1574: 
 1575:    __inline__ __device__ Side* neigh(int index) const { 
 1576:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1577:       assert(index >= 0 && index < 4); 
 1578:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1579: 
 1580:       const int ielem = index & 1;           // 0 or 1
 1581:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1582: 
 1583:       const Element* elem = elems[ielem];
 1584: 
 1585:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1586: 
 1587:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1588: 
 1589:    }
 1590: 
 1591:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1592: 
 1593:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1594: 
 1595:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1596:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1597:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1598:    __inline__ __device__ int iadv(void) const;
 1599: 
 1600:    __inline__ __device__ double grav3(void) const;
 1601:    
 1602:    __inline__ __device__ double eta2(void) const;
 1603:    __inline__ __device__ double eta1(void) const;
 1604:    __inline__ __device__ double w2(int k) const;
 1605:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1606:    __inline__ __device__ double depth(void) const;
 1607:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1608:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1609: 
 1610:    __inline__ __device__ double dfv(int k) const;
 1611: 
 1612:    __inline__ __device__ double veg_h(void)  const;
 1613:    __inline__ __device__ double veg_nv(void) const;
 1614:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1615:    __inline__ __device__ double veg_alpha3D(int k) const;
 1616:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1617: 
 1618:    __inline__ __device__ double Cd(void) const;
 1619: 
 1620:    __inline__ __device__ Vector2 tau(void) const;
 1621: 
 1622:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1623:    
 1624: 
 1625:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1626:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1627:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1628:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1629:    } 
 1630:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1631:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1632:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1633:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1634: 
 1635:    // Get valid starting element (for backtracking)
 1636:    __inline__ __device__ Element* getStartElement() {
 1637:       return elems[0] ? elems[0] : elems[1];
 1638:    }
 1639: 
 1640:    
 1641:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1642:       // Given an element, returns the other element that shares this side
 1643:       return (elems[0] == elem) ? elems[1] : elems[0];
 1644:    }
 1645: 
 1646:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1647:       // Given a node, returns the other node that shares this side
 1648:       return (n1 == node) ? n2 : n1;
 1649:    }
 1650:  
 1651:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1652: 
 1653: 
 1654: 
 1655: 
 1656: };
 1657: 
 1658: 
 1659: // This struct is used to store the boundary information for a node.
 1660: struct NodeBoundary {   
 1661:    int idx;
 1662:    BoundarySegment *segment;
 1663:    Node *node;
 1664:    
 1665:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1666:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1667: 
 1668:    bool isLand;
 1669: 
 1670:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1671:    double elbc;   // Elevation boundary condition
 1672:    double eth;    // Elevation time history
 1673: 
 1674:    double eta_mean; // Mean elevation at nodes
 1675: 
 1676:    bool isEssentialBC;
 1677: 
 1678:    Vector2 uth[nvrt];  // "Time history" velocity
 1679: 
 1680:    // Arrays for harmonic constituents (if needed)
 1681:    // nbfr ? nbfr : 1 is there to avoid a 0-sized array.
 1682:    double  emo[nbfr ? nbfr : 1];  // Elevation amplitude
 1683:    double  efa[nbfr ? nbfr : 1];  // Elevation phase
 1684: 
 1685: 
 1686:    NodeBoundary(void) {
 1687:       isLand = false;
 1688:    }
 1689:    NodeBoundary(bool _isLand) {
 1690:       isLand = _isLand;
 1691:    }
 1692: 
 1693:    
 1694:    __forceinline__ __device__ int numSidesForAverage() const {
 1695:    // Returns the number of sides that are connected to the node and have the same segment.
 1696:    // This is used to compute the average velocity at the node for open boundary nodes.
 1697:       int res = 0;
 1698:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1699:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1700: 
 1701:       return res;
 1702:    }
 1703: 
 1704: 
 1705:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1706:       assert(index == 0 || index == 1); 
 1707:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1708:    }
 1709: 
 1710:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1711:       if (isLand) return;  // land never uses these links
 1712: 
 1713:       SideBoundary *nullSideBoundary = nullptr;
 1714:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1715: 
 1716:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1717:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1718: 
 1719:       // both slots taken. OK if this side was already linked
 1720:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1721:    }
 1722: 
 1723: 
 1724: };
 1725: 
 1726: struct Node {
 1727: 
 1728:    // Geometry information
 1729:    int idx;            // Global index of the node
 1730:    int16_t part;       // Partition of the node
 1731: 
 1732:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1733:    int16_t numNodes;   // Number of nodes neighbors of this node
 1734: 
 1735:    Element **elements; // Array of pointers to the elements that share this node
 1736:    int16_t numElements;// Number of elements that share this node
 1737: 
 1738:    int16_t numSides;   // Number of sides that are connected to this node
 1739: 
 1740: 
 1741:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1742:    double gz;          // Global vertical coordinate at the node.
 1743:    Vector2 u2[nvrt];
 1744:    double  w2[nvrt];
 1745:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1746:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1747:    double lon, lat;
 1748:    double depth;
 1749: 
 1750:    Frame<ics> frame;
 1751: 
 1752:    LocalSigma<ivcor> localSigma;  
 1753: 
 1754:    int16_t kb;     // Bottom index of the node
 1755: 
 1756:    bool isDry;     // True if the node is dry
 1757: 
 1758:    int16_t iadv;   // Advection flag
 1759: 
 1760:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1761:                           // this is nullptr
 1762: 
 1763:    TempVar tmp; // Temporary variable to store different types of variables
 1764: 
 1765:    // Physical information
 1766:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1767:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1768: 
 1769:    double rho[nvrt];     // Density
 1770:    double dfv[nvrt];     // Vertical viscosity
 1771:    double dfh[nvrt];     // Horizontal viscosity  XXXX (does it need to exist when transport is not enabled?)
 1772: 
 1773:    Turbulence<turbulenceModel> turb;
 1774: 
 1775:    double eta1; // Elevation at nodes at previous timestep
 1776:    double eta2; // Elevation at nodes at current timestep
 1777: 
 1778:    double ETP;  // Earth Tidal Potential
 1779: 
 1780:    double pr;    // Air pressure
 1781:    double grav2; // Gravity 
 1782:    
 1783:    Vector2 dav;  // Depth averaged velocity
 1784: 
 1785:    Vector2 tau; // Wind stress vector
 1786: 
 1787:    // Vegetation parameters
 1788:    double veg_h;
 1789:    double veg_nv;
 1790:    double veg_di;
 1791:    double veg_Cd;
 1792:    double veg_h_unbent;
 1793:    double veg_di_unbent;
 1794:    double veg_nv_unbent;
 1795:    double veg_alpha_vert_mean;
 1796:    double veg_alpha0;
 1797:    double veg_alpha3D[nvrt];
 1798: 
 1799:    // Bottom drag parameters
 1800:    double Cd;       // Bottom drag coefficient   
 1801: 
 1802:    // These three are mutually exclusive
 1803:    union {
 1804:       double rmanning; // Bottom Manning's coefficient
 1805:       double rough;    // Bottom roughness length
 1806:       double drag;     // Bottom drag coefficient
 1807:    };
 1808:    Vector2 tau_bot; // Bottom stress vector
 1809: 
 1810:    // XXXX REMOVE FOR IMM>0???
 1811:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1812:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1813: 
 1814:    
 1815:    double qel; // RHS
 1816:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1817:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1818:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1819:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1820: 
 1821:    double mX; // Solution of the FEM system
 1822: 
 1823:    // Meteorological forcing
 1824:    Vector2 u_air;
 1825:    double p_air;  // XXXX is this the same as pr?
 1826:    double t_air;
 1827:    double q_air;
 1828:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1829: 
 1830: 
 1831: 
 1832:    __device__ __forceinline__ int localIndex() const;
 1833:    __device__ __forceinline__ int packedIndex() const;
 1834: 
 1835: 
 1836:    __device__ void setWind(Vector2 &u) {
 1837:    // Sets the wind vector taking into account the mesh angle
 1838:    
 1839:       const double speed = length(u);
 1840: 
 1841:       // Rotate wind vector to the node frame
 1842:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1843: 
 1844:       // Sets the surface stress vector due to wind.
 1845:       if constexpr(nws == 0) {
 1846:          tau = {0.0, 0.0};
 1847: 
 1848:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1849:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1850: 
 1851:       } else {
 1852: 
 1853:          double dragcoef;
 1854: 
 1855:          if constexpr(iwind_form == -1) {
 1856:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1857:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1858: 
 1859:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1860:             tau = cff*u_air;
 1861:  
 1862:          } else if constexpr(iwind_form == 1) {
 1863:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1864:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1865: 
 1866:             dragcoef = max(dragcoef, 4.0e-4);
 1867:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1868:             tau = cff*u_air;
 1869: 
 1870:          } else {
 1871:             tau = {0.0, 0.0};
 1872:          }
 1873:       }
 1874:    }
 1875: 
 1876: 
 1877:    __device__ void setFrame(double lat, double lon) {
 1878:       if constexpr(ics == 1) return;
 1879: 
 1880:       frame.update(lat, lon);        
 1881:     }
 1882: 
 1883:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1884: 
 1885:    __device__ double sigmaTransitionDepth(void) const;
 1886: 
 1887:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1888: 
 1889:    __inline__ __device__ Point2 outputCoords(void) const {
 1890:       if constexpr(ics == 1)  return p;
 1891:       else                    return {rad2deg*lon, rad2deg*lat};
 1892:    }
 1893: 
 1894:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1895:    // If ics == 2, convert the global point to the local frame
 1896:       
 1897:       if constexpr (ics == 1) {
 1898:          return p;
 1899:       } else {
 1900:          const Point3 c = {p.x, p.y, gz};
 1901:          const Point3 local = frame.G2L(p - c);
 1902:          return local;
 1903:       }
 1904:    }
 1905: 
 1906:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1907:    // If ics == 2, convert the global point to the local frame
 1908:       
 1909:       if constexpr (ics == 1) {
 1910:          return p;
 1911:       } else {
 1912:          const Point3 c = {p.x, p.y, gz};
 1913:          return c + frame.L2G(p);
 1914:       }
 1915:    }
 1916: 
 1917:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1918:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1919:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1920:    
 1921:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1922: 
 1923:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1924:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1925:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }   
 1926: 
 1927:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1928:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1929: 
 1930:    __device__ __forceinline__ void clearMatrixRow(void) {
 1931:       // Clear the matrix row for this node
 1932: 
 1933:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1934: 
 1935:    }
 1936: 
 1937:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1938:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1939:       
 1940:       if (node == this) {
 1941:          *coeffDiag += value;
 1942:          return;
 1943:       }
 1944: 
 1945:       int i;
 1946:       for (i = 0; i < numNodes; i++) {
 1947:          if (nodes[i] == node) break;
 1948:       }
 1949: 
 1950:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1951:       coeffRow[csrSlot[i]] += value;
 1952:    }
 1953: 
 1954: 
 1955:    __device__ __inline__ void updateZCoordData(void);
 1956: 
 1957:    __device__ __forceinline__ double compZCoord(int k) const;
 1958: 
 1959:    __device__ void updateKb(void);
 1960: 
 1961:    __device__ __forceinline__ void computeBottomDragCd(void);
 1962: 
 1963: 
 1964: 
 1965: };
