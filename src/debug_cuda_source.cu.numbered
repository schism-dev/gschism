 2594: /**
 2595:  * This method performs backtracking from the side center until a time -dt back in time 
 2596:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2597:  * intermediate point.
 2598:  *
 2599:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2600:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2601:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2602:  * remaining time.
 2603:  * 
 2604:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2605:  * 
 2606:  * @param uuint, vvint, wwint: Velocities at the final point
 2607:  * @param jlev: Level at which the backtracking is performed
 2608:  * @param dt, dtbk: Tracking timesteps
 2609:  * @return: True if the backtracking was successful, false otherwise
 2610:  */
 2611: __inline__ __device__ bool Side::btrack(
 2612:       int jlev,
 2613:       double dt,            // Tracking time
 2614:       double dtbk,          // Tracking timestep
 2615:       Vector3 &u_int        // Velocities at the initial point
 2616: ) const {
 2617: 
 2618:    // Start from side center
 2619:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2620: double dt0 = dt;
 2621: Point3 x00 = x0;
 2622:  
 2623:    double time_rm = dt; // Remaining time
 2624: 
 2625: 
 2626: 
 2627: 
 2628:    // Initial velocities
 2629:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2630: 
 2631:    // Find the element that is in the direction opposite to the velocity
 2632:    Element* curElem = findElementTowards(toVector2(u_int));
 2633: 
 2634: 
 2635:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2636:    if (curElem == nullptr) {
 2637:       // Make velocity parallel to the side
 2638:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2639:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2640:       curElem = otherElem(curElem);
 2641: 
 2642: 
 2643: // if (curElem == nullptr) { u_int = {0.0, 0.0, 0.0}; return true;}
 2644: // assert(curElem!=nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2645: // printf("@@@@@@@YYYY@@@@@@@@@ curElem = %p, isDry = %d\n", curElem, curElem->isDry);
 2646:       
 2647:    }
 2648: 
 2649:    if (curElem == nullptr || curElem->isDry) { 
 2650:       // This means that the starting side is shared by dry elements (or one dry and one boundary side).
 2651:       u_int = {0.0, 0.0, 0.0}; 
 2652:       return true;
 2653:    }
 2654: 
 2655:    // Nudges it towards the barycenter
 2656:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2657: 
 2658: 
 2659: 
 2660: 
 2661:    const int MAX_ITERATIONS = 1000; 
 2662:    Element* nextElem = nullptr;
 2663:    int iter = 0;
 2664: assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2665:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2666:    while(true) {
 2667: 
 2668:       // Calculate timestep
 2669:       double dtb = min(dtbk, time_rm);
 2670: if (dtb>0.0 && dtb < 1e-5) {
 2671: printf("@@@@@@@@@@@@@@@4 dtbk = %.17g, time_rm = %.17g\n", dtbk, time_rm);
 2672: assert(false && "dtb < 1e-5");
 2673: }
 2674: 
 2675:       // Next point in the backtracking curve
 2676:       xt = x0 - dtb*u_int;
 2677: if (!curElem->containsPoint(toPoint2(x0))) printf("@@@@@@@@@ iter = %d, x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g, dtbk = %.17g, dtb = %.17g, u_int = %.17g, %.17g, %.17g\n", iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, dtbk, dtb, u_int.x, u_int.y, u_int.z);      
 2678: assert(curElem->containsPoint(toPoint2(x0)) && "YYY Starting point is not inside the element");
 2679:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2680:       assert(found && "Backtracking failed in btrack");
 2681: 
 2682:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2683: 
 2684:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2685:                       // then time_rm needs to be increased by the unused time.
 2686: 
 2687:       // If the velocity is too small, we stop the backtracking
 2688:       const double vmag = length(toVector2(u_int));
 2689:       if (vmag <= velmin_btrack) break;
 2690: 
 2691:       // The current point becomes the next segment's starting point.
 2692:       x0 = xt;
 2693:  
 2694:       curElem = nextElem;
 2695: 
 2696:       iter++;
 2697: if (iter>100) {
 2698:    // if (dtb>0.0 && dtb < 1e-5) {
 2699:    //    printf("@@@@@@@@@@@@@@@4 dtbk = %.17g, time_rm = %.17g\n", dtbk, time_rm);
 2700:    //    assert(false && "dtb < 1e-5");
 2701:    //    }
 2702: printf("@@@@@@@@@@@@@@@@ curElem->idx = %d, nextElem->idx = %d, isdry = %d, n1->idx = %d, n2->idx = %d, iter = %d\n", curElem->idx, nextElem->idx, curElem->isDry, n1->idx, n2->idx, iter);
 2703: printf("@@@@@@@@@@@@@@@2 x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g\n", x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 2704: printf("@@@@@@@@@@@@@@@3 dtbk = %.17g, dtb = %.17g, u_int = %.17g, %.17g, %.17g, time_rm = %.17g\n", dtbk, dtb, u_int.x, u_int.y, u_int.z, time_rm);
 2705: }
 2706: if (iter>900) return true;
 2707:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2708:    }
 2709: 
 2710:    // Interpolate the velocities at the final point
 2711:    curElem->interpolateVelocities(xt, u_int);
 2712: 
 2713:    // if (jlev==9) addDebugPlot(x00, x00 + dt0*u_int, 0xFFCF00, 'x');  // yellow
 2714:    if (jlev==1 ) addDebugPlot(x00, x00 + dt0*u_int, 0x00F0FF, '+');  // green
 2715: 
 2716: 
 2717: }
 2718: 
 2719: 
