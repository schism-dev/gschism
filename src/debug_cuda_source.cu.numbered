 2370: __device__ void lock(int *mutex) {
 2371:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2372: }
 2373: 
 2374: __device__ void unlock(int *mutex) {
 2375:     atomicExch(mutex, 0);
 2376: }
