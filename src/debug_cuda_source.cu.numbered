 1583: // Helper functions for computing the local node index at a given offset from another.
 1584: __device__ __inline__ int nxq(int offset, int index, int size) {
 1585:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1586:    // to the index to make it positive
 1587:    assert(index + offset + 16*size >= 0);
 1588:    return (index + offset + 16*size) % size;  
 1589: }
 1590: 
 1591: __device__ __inline__ int nxq(int index, int size) {
 1592:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1593:    // to the index to make it positive
 1594:    assert(index + 16*size >= 0);
 1595:    return (index + 16*size) % size; 
 1596: }
