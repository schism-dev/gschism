 1637: // Helper functions for computing the local node index at a given offset from another.
 1638: __device__ __inline__ int nxq(int offset, int index, int size) {
 1639:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1640:    // to the index to make it positive
 1641:    assert(index + offset + 16*size >= 0);
 1642:    return (index + offset + 16*size) % size;  
 1643: }
 1644: 
 1645: __device__ __inline__ int nxq(int index, int size) {
 1646:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1647:    // to the index to make it positive
 1648:    assert(index + 16*size >= 0);
 1649:    return (index + 16*size) % size; 
 1650: }
