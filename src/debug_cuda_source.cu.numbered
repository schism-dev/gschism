 6333: extern "C" {
 6334:    __global__ void computeElemAverageGhat(void) {
 6335:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6336: 
 6337:       ELEM(elem);
 6338:       
 6339:       elem->ghat1= {0.0, 0.0};  
 6340: 
 6341:       if constexpr(ihydraulics != 0) {
 6342:          if (nhtblocks > 0 && elem->isblock) return;
 6343:       }
 6344: 
 6345: 
 6346: 
 6347:       
 6348:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6349:       // tidal potential, horizontal diffusion, and baroclinic etc
 6350:       // Remember to update both fb and F 
 6351:       // If ics=2, ghat1 are in eframe (ll)
 6352:       // cff1-3: coefficients for 2D/3D
 6353:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6354:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6355:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6356: 
 6357:       if (elem->isDry) return;
 6358: 
 6359:       double av_cff1 = 0.0;  // av. for cff1
 6360:       double av_cff2 = 0.0;  // av. for cff2
 6361:       double av_cff3 = 0.0;  // av. for cff3
 6362:       double av_df = 0.0;  // av. for H^\alpha / H
 6363:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6364:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6365: 
 6366:       const int i34 = elem->i34;
 6367:       const int kb = elem->kb;
 6368: 
 6369:       for (int j=0; j<i34; j++) {
 6370:          // For each node and side in the element...
 6371: 
 6372:          const Node *node = elem->nodes[j];
 6373:          const Side *side = elem->sides[j];
 6374: 
 6375:          const double chi      = side->chi;
 6376:          const double veg_c2   = side->veg_c2;
 6377:          const double veg_beta = side->veg_beta;
 6378:          const double veg_h    = side->veg_h();
 6379:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6380: 
 6381:          // Node - const in elem
 6382:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6383:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6384: 
 6385:          if (elem->depth >= tip_dp) {
 6386:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6387:          }
 6388: 
 6389:          
 6390:          const double htot  = side->htot2();        // Total depth at the side
 6391:          const double zctr2 = side->zTopCanopy();  
 6392: 
 6393:          double cff1; 
 6394:          double cff2; 
 6395:          double cff3;   
 6396:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6397:          // coefficients applied to 2D/3D case 
 6398:             cff1 = side->hhat/htot;
 6399:             cff2 = 0.0;
 6400:             cff3 = 0.0;
 6401:          } else { //3D
 6402:             //Init for no-veg case
 6403:             cff1 = 1.0;
 6404:             cff2 = 1.0;
 6405:             cff3 = 0.0;
 6406: 
 6407:             if constexpr(iveg != 0) {
 6408:                // Computes coefficients used with vegetation terms G1, G2
 6409:                // cff1, cff3 are used for the first two terms in G1, G2:
 6410:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6411:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6412:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6413:                if(veg_h < 0.99*htot) { // submergent vegetation
 6414:                   cff1=1;
 6415:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6416:                   cff3 = veg_c;
 6417: 
 6418:                } else { // emergent vegetation
 6419:                   cff1 = 1.0/(1.0 + veg_c2);
 6420:                   cff2 = cff1;
 6421:                   cff3 = 0.0;
 6422: 
 6423:                }
 6424:             } // if iveg
 6425:          } //  2D/3D
 6426: 
 6427:          av_cff1 += cff1/i34;
 6428:          av_cff2 += cff2/i34;
 6429:          av_cff3 += cff3/i34;
 6430:          av_cff2_chi += cff2*chi/i34;
 6431:          av_cff3_chi += cff3*chi/i34;
 6432:          av_df += min(htot, veg_h)/(htot*i34);
 6433: 
 6434: 
 6435:          // btrack values: U^\star, U^{\star\alpha}
 6436:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6437:          Vector2 Ustar       = {0.0, 0.0}; 
 6438:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6439: 
 6440:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6441:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6442:          } else { //3D
 6443:             for (int k = side->kb + 1; k < nvrt; k++) {
 6444:             
 6445:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6446:                Ustar += w2;
 6447: 
 6448:                if constexpr(iveg != 0) {
 6449:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6450:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6451:                        Ustar_alpha += zrat*w2; // XXXX
 6452:                    }
 6453:                }  // if iveg
 6454:             }  // for k
 6455:          }  //2D/3D
 6456:          
 6457: 
 6458:          // Add btrack & surface stress terms to \breve{G} first
 6459:          if constexpr(ics==1) {
 6460: 
 6461:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6462: 
 6463:          } else {
 6464:             assert(false && "computeElemAverageGhat: Not implemented");
 6465:             // XXX IMPLEMENT THIS
 6466:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6467:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6468:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6469:          }  // if ics
 6470: 
 6471:          // Surface and bottom stress terms
 6472:          if constexpr(ics==1) {
 6473:             const Vector2 tau    = side->tau();
 6474:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6475: 
 6476:             // Term for surface and bottom stress
 6477:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6478: 
 6479:          } else {
 6480:             assert(false && "computeElemAverageGhat: Not implemented");
 6481:             // XXX IMPLEMENT THIS
 6482:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6483:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6484:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6485:             // tau_x=(vn1+tt1)/2.d0
 6486:             // tau_y=(vn2+ss1)/2.d0
 6487:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6488:          }  // if ics
 6489: 
 6490:          
 6491: 
 6492:          // All terms in F,F^\alpha,f_b except baroclinic
 6493:          // F, f_b: all explicit terms excluding vegetation 
 6494:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6495:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6496:          const double coriolis = side->coriolis;
 6497:          Vector2 F  =  coriolis*side->U;  // F_x
 6498:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6499:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6500: 
 6501:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6502:             
 6503:             for (int k = side->kb; k < nvrt; k++) {
 6504:                if (zctr2 > side->zc[k-1]) {
 6505:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6506:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6507:                    Fa +=  coriolis*w2*zrat;
 6508:                } // if zctr2
 6509:             } // k
 6510:          } // iveg
 6511: 
 6512:          // Integrate horizontal viscosity force vertically
 6513:          for (int k=side->kb + 1; k<nvrt; k++) {
 6514:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6515: 
 6516:             F += levelHorVisc;
 6517: 
 6518:             // Vegetation term
 6519:             if constexpr(iveg!=0) {
 6520:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6521:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6522:                   Fa += levelHorVisc*zrat;
 6523:                } 
 6524:             } // if iveg
 6525:          } // for k
 6526: 
 6527:          fb += side->nuGradU[side->kb];
 6528: 
 6529:          // Add to ghat1
 6530:          if constexpr(ics==2) {
 6531:             assert(false && "computeElemAverageGhat: Not implemented");
 6532:             // XXX IMPLEMENT THIS
 6533:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6534:             // bigf1=vn1; bigf2=vn2
 6535:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6536:             // botf1=vn1; botf2=vn2
 6537:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6538:             // bigfa1=vn1; bigfa2=vn2
 6539:          } // if ics
 6540: 
 6541:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6542:       } // for j (nodes and sides)
 6543: 
 6544:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6545:          
 6546:       // Finish off terms in F, F^\alpha and f_b
 6547:       const double grav3 = elem->mean(&Node::grav2);
 6548:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6549: 
 6550: 
 6551:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6552:       for (int j=1; j<i34; j++) { 
 6553:          // For each side in the element...
 6554:          const Side *side = elem->sides[j];
 6555:          const double chi = side->chi;
 6556: 
 6557:          const double htot = side->htot2();
 6558:          const double veg_h = side->veg_h();
 6559:          const Vector2 F  = htot*fb;
 6560:          const Vector2 Fa = min(htot, veg_h)*fb;
 6561: 
 6562:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6563:       } // for j
 6564: 
 6565:       //botf1 etc are already in elem frame
 6566:       elem->ghat1 += tmp/i34;
 6567: 
 6568:       // Baroclinic force
 6569:       if constexpr(ibc==0) {
 6570:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6571: 
 6572:          Vector2 Fa = {0.0, 0.0};
 6573:          Vector2 intGradRho = {0.0, 0.0};
 6574:          
 6575:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6576:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6577:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6578: 
 6579:             // \in F [m^2/s/s]
 6580:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6581:          }
 6582: 
 6583:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6584:          const Vector2 F = av_df*Fa; //approx
 6585:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6586: 
 6587:       } // if ibc
 6588: 
 6589: 
 6590: 
 6591:    }
 6592: 
 6593: } // extern "C"
 6594: 
 6595: 
 6596: 
 6597: #ifdef DONTCOMPILE
 6598: __global__ void checkMassConservation(Tracers* sumtr) {
 6599: 
 6600:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6601: 
 6602:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6603: 
 6604:    Element *elem = &(mesh->localElemData[i]);
 6605: 
 6606:    // Skip dry elements
 6607:    if (elem->isDry) return;
 6608: 
 6609:    // Local sum array for this thread
 6610:    double localSum[N_TRACERS] = {0.0};
 6611: 
 6612:    // Sum over vertical levels for this element
 6613:    const int kbe = elem->kbe;
 6614:    const double area = elem->area;
 6615: 
 6616:    for (int k = kbe; k < nvrt; k++) {
 6617:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6618:       
 6619:       // Accumulate tracer mass
 6620:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6621:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6622:       }
 6623:    }
 6624: 
 6625:    //  This function returns per element sums. A reduction must be done on the host side.
 6626: }
 6627: 
 6628: 
 6629: __global__ void transport(void) {
 6630: 
 6631:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6632: 
 6633:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6634: 
 6635:    Element *elem = &(mesh->localElemData[ie]);
 6636: 
 6637:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6638: 
 6639:                for (int m=0; m<ntr; m++) {
 6640:                   for (int k=kbe(ie); k<nvrt; k++) {
 6641:                      // Calculate each polynomial's weight 
 6642:                      wm=0.d0; sum1=0.d0; 
 6643:                      wm1=0.d0; wm2=0.d0; 
 6644:                      for (int i=0; i<elem->nweno2; i++) {
 6645:                   
 6646:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6647:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6648:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6649:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6650:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6651:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6652:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6653:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6654:                      // -----------------Hu and Shu (1999)'s method----------------
 6655:                      b4=b1+b2+b3
 6656: 
 6657: //Error: add PRODUCTION CPP
 6658: #ifdef DEBUG
 6659:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6660:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6661:                     call parallel_abort(errmsg)
 6662:                   }
 6663: #endif
 6664: 
 6665:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6666:                   // !----test-------------- 
 6667:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6668:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6669:                   // !wm(i)=wm1(i)*wm2(i)
 6670:                   // !---------------------- 
 6671:                   sum1=sum1+wm(i)
 6672:                 } // end for i
 6673: 
 6674:                 wm=wm/sum1
 6675: 
 6676:                 for (int j=0; j<elem->i34; j++) {
 6677: 
 6678:                   const Side *side  = elem->sides[j];
 6679:                   const Node *node1 = side->n1;
 6680:                   const Node *node2 = side->n2;
 6681: 
 6682:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6683:                      trsd=0.d0
 6684:                      for (int kk=0; kk<nquad; kk++) {
 6685:                         for (int i=0; i<elem->nweno2; i++) {
 6686:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6687:                         } // end for i   
 6688:                      } // end for kk
 6689:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6690:                   } // outward flux
 6691:                } // end for j=1,i34(ie) ! side
 6692:             }
 6693:          }
 6694:               
 6695: 
 6696: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6697: //             //   calculate each polynomial's weight 
 6698: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6699: //                 wm=0.d0; sum1=0.d0
 6700: //                 do i=1,nweno1(ie) !for each polynomial
 6701: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6702: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6703: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6704: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6705: //                   wm(i)=b2
 6706: //                   sum1=sum1+b2
 6707: //                   !wm(i)=1.d0
 6708: //                   !sum1=sum1+1.d0
 6709: 
 6710: // // Error: PRODUCTION
 6711: // #ifdef DEBUG
 6712: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6713: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6714: //                     call parallel_abort(errmsg)
 6715: //                   endif
 6716: // #endif
 6717: 
 6718: //                 enddo !i
 6719: //                 wm=wm/sum1 !final weight
 6720: 
 6721:                 for (int j=0; j<elem->i34; j++) { // side
 6722:                   const Side *side = elem->sides[j];
 6723:                   const Node *node1 = side->n1;
 6724:                   const Node *node2 = side->n2;
 6725: 
 6726:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6727:                     trsd=0.d0
 6728:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6729:                       for (int i=0; i<elem->nweno1; i++) {
 6730:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6731:                       }
 6732:                     enddo //kk
 6733:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6734:                   } // outward flux
 6735:                 } // end for j=1,i34(ie) ! side
 6736:               } // end for k; ntr 
 6737: 
 6738:             else !simple upwind method
 6739:               do j=1,i34(ie)
 6740:                 jsj=elside(j,ie)
 6741:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6742:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6743:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6744:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6745:                   endif
 6746:                 enddo  !vertical layers
 6747:               enddo !j=1,i34(ie) ! side
 6748:             endif !order of accuracy
 6749: 
 6750:          //  enddo !ie
 6751: // !$OMP     end do
 6752: 
 6753: // !$OMP     master
 6754: //           !message passing
 6755: //           if (nproc>1) then
 6756: //             !make a copy of side concentrations
 6757: //             trsd_tmp0=trsd_tmp 
 6758: 
 6759: //             !this exchange routine swaps interface concentration between two partitions
 6760: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6761: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6762: 
 6763: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6764: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6765: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6766: 
 6767: 
 6768: //             !This obtains final values for interface sides
 6769: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6770: //       :    endif !nproc>1
 6771: //           !message passing end
 6772: // !$OMP     end master
 6773: // !$OMP     barrier
 6774: 
 6775: 
 6776: // !         Do advection; conc @ dry elem will not be changed
 6777: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 6778: // !$OMP     do reduction(+: h_mass_in)
 6779: //           do i=1,ne
 6780: //             if(idry_e(i)==1) cycle
 6781: 
 6782: 
 6783: // !           Wet elements with 3 wet nodes
 6784: //             do k=kbe(i)+1,nvrt
 6785: 
 6786: 
 6787: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 6788: //               dtb_by_bigv = dtb/bigv
 6789:     
