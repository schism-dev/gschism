 1472: // Helper functions for computing the local node index at a given offset from another.
 1473: __device__ __inline__ int nxq(int offset, int index, int size) {
 1474:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1475:    // to the index to make it positive
 1476:    assert(index + offset + 16*size >= 0);
 1477:    return (index + offset + 16*size) % size;  
 1478: }
 1479: 
 1480: __device__ __inline__ int nxq(int index, int size) {
 1481:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1482:    // to the index to make it positive
 1483:    assert(index + 16*size >= 0);
 1484:    return (index + 16*size) % size; 
 1485: }
