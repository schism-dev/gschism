  179: 
  180: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  181: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  182: // Outputs:
  183: //        x1: first solution
  184: //        x2: second solution
  185: 
  186:    // Degenerate case: A = 0.
  187:    if (A == 0.0) {
  188:       x1 = -C / B;
  189:       x2 = x1;
  190:       return;
  191:    }
  192: 
  193:    const double delta = B*B - 4.0*A*C;
  194:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  195:    const double s = sqrt(delta);
  196: 
  197:    // Numerically stable quadratic roots:
  198:    // q = -0.5*(B + sign(B)*sqrt(delta))
  199:    const double q = -0.5 * (B + copysign(s, B));
  200:    if (q == 0.0) {
  201:       // Double-root / near-degenerate fallback
  202:       x1 = -B / (2.0*A);
  203:       x2 = x1;
  204:    } else {
  205:       x1 = q / A;
  206:       x2 = C / q;
  207:    }
  208: }
