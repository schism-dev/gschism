 2315: 
 2316: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2317: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2318: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2319: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2320:    Vector2 grad = {0.0, 0.0};
 2321:    int count = 0;
 2322: 
 2323:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2324: 
 2325:    // First element
 2326:    if (elems[0] != nullptr && condition(elems[0])) {
 2327:       grad += elems[0]->grad2(field);
 2328:       count++;
 2329:    }
 2330: 
 2331:    // Second element
 2332:    if (elems[1] != nullptr && condition(elems[1])) {
 2333:       grad += elems[1]->grad2(field);
 2334:       count++;
 2335:    }
 2336: 
 2337:    if (count > 0) {
 2338:       grad = grad/count;
 2339:    }
 2340:    
 2341:    return grad;
 2342: }
 2343: 
 2344: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2345: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2346: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2347: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2348: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2349: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2350: 
 2351: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2352: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2353: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2354: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2355: 
 2356: 
 2357: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2358: 
 2359: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2360: 
 2361: /**
 2362:  * This method performs backtracking from the side center until a time -dt back in time 
 2363:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2364:  * intermediate point.
 2365:  *
 2366:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2367:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2368:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2369:  * remaining time.
 2370:  * 
 2371:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2372:  * 
 2373:  * @param uuint, vvint, wwint: Velocities at the final point
 2374:  * @param jlev: Level at which the backtracking is performed
 2375:  * @param dt, dtbk: Tracking timesteps
 2376:  * @return: True if the backtracking was successful, false otherwise
 2377:  */
 2378: __inline__ __device__ bool Side::btrack(
 2379:       int jlev,
 2380:       double dt,            // Tracking time
 2381:       double dtbk,          // Tracking timestep
 2382:       Vector3 &u_int        // Velocities at the initial point
 2383: ) const {
 2384: 
 2385:    // Start from side center
 2386:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2387: 
 2388:  
 2389: 
 2390:    double time_rm = dt; // Remaining time
 2391: 
 2392: 
 2393:    // // Initialize outputs XXX
 2394:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2395:    //    sclr[i] = 0.0;
 2396:    // }
 2397: 
 2398: 
 2399:    // Initial velocities
 2400:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2401: 
 2402:    // Find the element that is in the direction opposite to the velocity
 2403:    Element* curElem = findElementTowards(toVector2(u_int));
 2404: 
 2405: 
 2406: 
 2407:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2408:    if (curElem == nullptr) {
 2409:       // Make velocity parallel to the side
 2410:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2411:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2412:       curElem = otherElem(curElem);
 2413:       
 2414:    }
 2415: 
 2416: // Nudges it towards the circumcenter
 2417: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2418: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2419:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2420: const double eps = 9.013e-3;                 
 2421: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2422: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2423: 
 2424: 
 2425: 
 2426:    const int MAX_ITERATIONS = 1000; 
 2427:    Element* nextElem = curElem;
 2428:    int iter = 0;
 2429:    while(true) {
 2430: 
 2431:       // Calculate timestep
 2432:       double dtb = min(dtbk, time_rm);
 2433: 
 2434:       // Next point in the backtracking curve
 2435:       Point3 xt = x0 - dtb*u_int;
 2436:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2437:       assert(found && "Backtracking failed in btrack");
 2438: 
 2439:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2440: 
 2441:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2442:                       // then time_rm needs to be increased by the unused time.
 2443: 
 2444:       // If the velocity is too small, we stop the backtracking
 2445:       const double vmag = length(toVector2(u_int));
 2446:       if (vmag <= velmin_btrack) break;
 2447: 
 2448:       // The current point becomes the next segment's starting point.
 2449:       x0 = xt;
 2450:  
 2451:       curElem = nextElem;
 2452: 
 2453:       iter++;
 2454:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2455:    }
 2456: 
 2457: 
 2458: }
 2459: 
