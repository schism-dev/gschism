  306: // Polynomial class
  307: template<int grade>
  308: struct Polynomial {
  309:     // Static assertion to give a clear error message at compile time
  310:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  311: };
  312: 
  313: 
  314: // Explicit specialization for grade 4
  315: template<>
  316: struct Polynomial<4> {
  317:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  318: 
  319:    // Constructor from coefficients
  320:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  321: 
  322:    __device__ __forceinline__ double eval(double x) const {
  323:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  324:    }
  325: };
