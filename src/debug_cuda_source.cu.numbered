 5041:    __global__ void computeBottomDragVegetation(void) {
 5042:       // UNFINISHED. CHECK THIS:
 5043:       // How many kernels are needed? Why so many for loops?
 5044:       // Is the loop on sides needed?
 5045: 
 5046:       NODE(node);
 5047: 
 5048: 
 5049:       const int    kb      = node->kb;
 5050:       const double htot    = node->htot2(); 
 5051:       
 5052:       if (node->isDry) {
 5053:          // Default values for dry nodes
 5054:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5055:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5056: 
 5057:          return;
 5058:        
 5059:       }
 5060: 
 5061:       // Computes bottom drag Cd based on the selected nchi
 5062:       node->computeBottomDragCd();
 5063:       
 5064: 
 5065: 
 5066:       //   Bottom stress in m^2/s^2
 5067:       if (node->rho[kb + 1] >= -98.0)
 5068:       {
 5069:          const double mag_u = length(node->u2[kb + 1]);
 5070:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5071: 
 5072:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5073:          // !sediment erosion: this part needs more documentation
 5074:       }
 5075:     
 5076: 
 5077: 
 5078:       // Compute vegetation parameters
 5079:       //--------------------------------
 5080: 
 5081:       // SAV constants
 5082:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5083:       constexpr double veg_cfpsi = 0.16;
 5084: 
 5085:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5086:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5087: 
 5088:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5089:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5090:          int kbin = 0; // bin index
 5091:          for (int k = kb; k < nvrt; k++) {
 5092:             // Computes node height above the bottom level
 5093:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5094:             assert(false && "Vertical variation of vegetation not implemented");
 5095: 
 5096:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5097:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5098:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5099:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5100:             // } else {
 5101:             //    // Find the bin at which the current vertical level is
 5102:             //    while (kbin<nbins_veg_vert) {
 5103:             //       const double zn = node->z[kbin];
 5104:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5105:             //          break;
 5106:             //       } // if
 5107:             //       kbin++;
 5108:             //    } // while
 5109:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5110: 
 5111:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5112:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5113:                
 5114:             //    // Linear interpolation of the vegetation parameters
 5115:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5116:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5117:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5118:             // } // if rl10
 5119: 
 5120:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5121: 
 5122:          } // for k
 5123: 
 5124: 
 5125:       } else { // Ganthy (iveg==2)
 5126:       //  Modify canopy height, diameter, and density
 5127: 
 5128:          // Make sure there is vegetation on this node
 5129:          if (node->veg_h_unbent > 0.0) {
 5130:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5131: 
 5132:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5133:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5134:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5135: 
 5136:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5137:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5138:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5139:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5140:          } // if veg_h_unbent
 5141: 
 5142:          for (int k = 0; k < nvrt; k++) {
 5143:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5144:          } // for k
 5145:       
 5146: 
 5147:       } // if iveg
 5148:      
 5149: 
 5150:       // Compute vertical mean of veg_alpha3D
 5151:       if (iveg != 0) {
 5152:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5153:          double sum1=0.0;
 5154:          double sum2=0.0;
 5155:          // Integrate over each level under the canopy...
 5156:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5157:             const double Dz = node->Dz(k);
 5158: 
 5159:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5160:             sum2 += Dz;
 5161: 
 5162:          } // for k
 5163:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5164:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5165: 
 5166:       } // if iveg
 5167: 
 5168:    }
 5169: 
 5170:    __global__ void computeVegetationAndDragParameters(void) {
 5171:       // Computes the vegetation and drag model parameters:
 5172:       // chi, \tilde\chi, beta, \breve{H}
 5173:       
 5174:       SIDE(side);
 5175: 
 5176:       side->hhat = 0.0;
 5177:       side->chi2 = 0.0;
 5178:       side->chi = 0.0;
 5179:       side->veg_c2 = 0.0;
 5180:       side->veg_beta = 0.0;
 5181: 
 5182:       if (side->isDry) return;
 5183: 
 5184:       const double htot = side->htot2();
 5185:       const int    kb   = side->kb;
 5186: 
 5187:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5188: 
 5189:       const double veg_h     = side->veg_h();
 5190:       const double veg_nv    = side->veg_nv();
 5191:       const double veg_c     = side->veg_c();
 5192:       const double veg_beta  = side->veg_beta;
 5193:       const double veg_alpha = side->veg_alpha_vert_mean();
 5194: 
 5195:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5196:       // Velocity magnitude at the bottom level
 5197:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5198:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5199:       side->chi2 = side->Cd()*vmag1;
 5200:       side->chi  = side->chi2;
 5201:       if constexpr(iveg != 0) {
 5202:          const Node *n1 = side->n1;
 5203:          const Node *n2 = side->n2;
 5204:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5205:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5206:       }
 5207: 
 5208:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5209: 
 5210:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5211:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5212:       double magUa = 0.0;
 5213:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5214:          // 3D wet side with veg...
 5215: 
 5216:          double magUa = 0.0;
 5217:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5218:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5219: 
 5220:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5221:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5222:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5223: 
 5224:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5225:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5226: 
 5227:                // Velocity magnitude at the bottom (l) of the level
 5228:                const double ul = length(side->u2[k]);
 5229: 
 5230:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5231:                magUa += Dz*0.5*(uh + ul);
 5232: 
 5233:             } // if HasVegetation
 5234:          } // for k
 5235:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5236: 
 5237:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5238:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5239:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5240:             const double zCpy = side->zTopCanopy();
 5241:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5242:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5243:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5244:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5245:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5246:          } // if isSubmerged
 5247:       } // if iveg   
 5248: 
 5249:       // Computes the friction modified depth, \breve{H} in notes
 5250:       if (side->is2D()) { // 2D
 5251: 
 5252:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5253:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5254: 
 5255:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5256: 
 5257:          side->hhat = htot*htot/fricH; 
 5258: 
 5259:       } else { // 3D
 5260:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5261: 
 5262:          if constexpr(iveg != 0) {
 5263:             
 5264:             if (side->isSubmerged()) { 
 5265:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5266:                side->hhat -= veg_c*Hhat_alpha;
 5267: 
 5268:             } else { // Emergent
 5269:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5270:             }
 5271:          } // if iveg
 5272: 
 5273:          // Enforce positivity for 3D model
 5274:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5275:       } // if 3D
 5276: 
 5277:    }
 5278: 
 5279: 
 5280: 
 5281:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5282:    // Computes the density gradient between two elements, e1 and e2.
 5283:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5284:    // zero in the direction normal to the side. 
 5285:    // 
 5286:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5287:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5288:    //
 5289:    // Input:
 5290:    //    e1: Element
 5291:    //    e2: Neighbor element (or nullptr if boundary)
 5292:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5293:    //    k: Index of the half-level at which the density is interpolated
 5294:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5295:    // 
 5296:    // Output:
 5297:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5298:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5299: 
 5300:       if (e2 == nullptr || e2->isDry) {
 5301:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5302: 
 5303:          Side *side = e1->sides[j];
 5304:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5305:                  
 5306:          if constexpr(ics == 1) {
 5307:             vec = side->n; // Normal vector to the side
 5308:          } else {
 5309:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5310:             // IMPLEMENT THIS XXXXXX
 5311:             // !replace with xel, yel?
 5312:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5313:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5314:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5315:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5316:          } //ics
 5317:                    
 5318:          diffRho = 0.0;
 5319: 
 5320:       } else { //internal and wet
 5321:          if constexpr(ics==1) {
 5322:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5323: 
 5324:             // Vector from e1 to e2
 5325:             vec = e2->center - e1->center;
 5326: 
 5327:          } else { 
 5328:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5329:             // IMPLEMENT THIS XXXXXX
 5330:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5331:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5332:             //                   alow(j)=xctr2
 5333:             //                   bdia(j)=yctr2
 5334:          } // ics
 5335: 
 5336:          diffRho = rho2 - e1->demeanedDensity(k);
 5337:       }
 5338: 
 5339:    }
 5340: 
 5341:    __global__ void computeDensityCubicSplines(void) {
 5342:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5343: 
 5344:       ELEM(elem);
 5345: 
 5346:       if (elem->isDry) return;
 5347: 
 5348:       const int kb = elem->kb;
 5349: 
 5350:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5351:       if (elem->is2D()) {
 5352:          // In the 2D case, the density is constant at the prism level. 
 5353:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5354:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5355:       } else { //3D
 5356: 
 5357:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5358:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5359:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5360:          ///// XXXX CHECK INDICES!!!!!
 5361:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5362:       } // 2D/3D
 5363: 
 5364:    }
 5365: } // extern "C"
 5366: 
 5367: 
 5368: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5369: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5370: 
 5371:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5372: 
 5373:    const int kb  = elem->kb;
 5374:    const int kb2 = elem2->kb;
 5375: 
 5376:    // z-coordinate of prism of elem
 5377:    const double zp = elem->z_prism(k);
 5378: 
 5379:    double rho = 0.0;
 5380: 
 5381:    if (elem2->is2D()) {
 5382:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5383: 
 5384:    } else {  // 3D
 5385: 
 5386:       // eta_min may be < zmax
 5387:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5388:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5389: 
 5390:       // (Extrapolate density below bottom, we will fix it later)
 5391:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5392:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5393:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5394:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5395:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5396:    } // 2D/3D
 5397:      
 5398: 
 5399:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5400:    // Now we need to fix it.
 5401:    if (elem->z[k] < elem2->z[kb2]) {
 5402:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5403: 
 5404:       // There are two methods to adjust the density at the bottom of the element.
 5405:       // iunder_deep=0: 
 5406:       const double depth1 = abs(elem->z[kb]); // larger depth
 5407: 
 5408:       if (iunder_deep==0) {
 5409: 
 5410:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5411: 
 5412:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5413: 
 5414:       } else { // iunder_deep != 0
 5415: 
 5416:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5417: 
 5418:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5419: 
 5420:          //   Demeaned density at the same z coordinate as
 5421:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5422:          }
 5423: 
 5424:       } // if iunder_deep
 5425:    } // if elem->z[kb] < elem2->z[kb]
 5426: 
 5427:    return rho;
 5428: }
 5429: 
 5430: 
 5431: extern "C" {
 5432:    __global__ void computeDensityGradient(void) {
 5433: 
 5434:       if constexpr(ibc != 0) return;
 5435: 
 5436:          // Compute the horizontal density gradient at each element.
 5437:       // It works in two steps:
 5438:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5439:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5440:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5441:       //             gradRho.r1 = rho1 - rho0
 5442:       //             gradRho.r2 = rho2 - rho0
 5443:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5444:       // 
 5445:       //  NOTE: We use de-meaned densities.
 5446: 
 5447:       ELEM(elem);
 5448: 
 5449:       if (elem->isDry) return;
 5450: 
 5451:       const int kb  = elem->kb;
 5452:       const int i34 = elem->i34;
 5453: 
 5454:       for (int k = kb + 1; k < nvrt; k++) {
 5455:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5456:          //             gradRho.r1 = rho1 - rho0
 5457:          //             gradRho.r2 = rho2 - rho0
 5458:          int icount = 0;
 5459:          double sumRx = 0.0;
 5460:          double sumRy = 0.0;
 5461:          for (int j1=0; j1<i34; j1++) { 
 5462: 
 5463:             const int j2 = elem->nxq(j1 + 1);
 5464: 
 5465:             // Pairs of consecutive neighbor elements of elem
 5466:             const Element *e1 = elem->nghbElems[j1];
 5467:             const Element *e2 = elem->nghbElems[j2];
 5468: 
 5469:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5470:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5471:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5472: 
 5473:             // Compute the density difference and the vector from elem to e1 and e2
 5474:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5475:             double diffRho1, diffRho2;
 5476:             Vector2 vec1, vec2;
 5477:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5478:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5479: 
 5480:             const double rl1 = length(vec1);
 5481:             const double rl2 = length(vec2);
 5482:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5483: 
 5484:             const double delta = cross(vec1, vec2);
 5485:             const double sintheta = abs(delta)/(rl1*rl2);
 5486: 
 5487:             // To avoid problems, avoid elements with small angle between vectors
 5488:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5489:             const bool validEq = (sintheta > sin_one_deg);
 5490: 
 5491:             if (validEq) {
 5492:                // Solve the system of equations to get the density gradient at elem
 5493:                icount++;
 5494:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5495:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5496:                sumRx += Rx;
 5497:                sumRy += Ry;
 5498:             }
 5499:          } // for j1
 5500: 
 5501:          // Compute the average density gradient at elem
 5502:          if (icount==0) {
 5503:            // Bad mesh quality; bail out with 0 b-cc
 5504:            elem->gradRho[k] = {0.0, 0.0};
 5505:          } else {
 5506:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5507:          }
 5508: 
 5509:       } // for k
 5510: 
 5511:    }
 5512: 
 5513:    __global__ void computeBaroclinicTerm(void) {
 5514:    // Computes the baroclinic term at sides (at half levels).
 5515:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5516:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5517: 
 5518:       if (ibc == 1) return;
 5519: 
 5520:       SIDE(side);
 5521: 
 5522:       if (side->isDry) return;
 5523: 
 5524:       const Element *e1 = side->elems[0];
 5525:       const Element *e2 = side->elems[1];      
 5526:       const int kb = side->kb;
 5527:       
 5528:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5529: 
 5530:       // interpolates vertically the density gradient of the two elements at the half level/
 5531: 
 5532:       int k1 = max(kb, nvrt / 2);
 5533:       int k2 = max(kb, nvrt / 2);
 5534: 
 5535:       // Starts the integration at the surface and goes down to the bottom
 5536:       side->bcc[nvrt-1] = {0.0, 0.0};
 5537:       for (int k = nvrt - 2; k >= kb; k--) {
 5538:       // For each prism level (from surface to bottom)...
 5539: 
 5540:          // For both elements, interpolate density gradient at the side's half level.
 5541:          // The gradient at the side is the average of the gradients at the elements.
 5542:          // w1, w2 are used to take into account boundary sides, with just one element.
 5543:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5544:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5545:          const double wsum = w1 + w2;
 5546:          w1 = w1/wsum;
 5547:          w2 = w2/wsum;
 5548:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5549: 
 5550:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5551:          Vector2 gradRho = {0.0, 0.0};
 5552:          if (e1 != nullptr && k > kb) {
 5553:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5554:             
 5555:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5556:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5557:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5558: 
 5559:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5560:          }      
 5561:          if (e2 != nullptr && k > kb) {
 5562:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5563:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5564:             
 5565:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5566:          }
 5567: 
 5568:          if constexpr(ics==2) {
 5569:             assert(false && "Not implemented: ics == 2");
 5570:             // IMPLEMENT THIS XXXXXX
 5571:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5572:             // swild(1)=tmp1
 5573:             // swild(2)=tmp2
 5574:          }
 5575:          
 5576:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5577:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5578:          // CHECK INDICES!!! XXX
 5579:          const double grav3 = side->grav3();
 5580:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5581: 
 5582:       } // for
 5583: 
 5584:    }
 5585: 
 5586: 
 5587: 
 5588:    __global__ void computeHorGradientAtSide(void) {
 5589: 
 5590:       // Compute the horizontal density gradient at each element.
 5591:       // It works in two steps:
 5592:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5593:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5594:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5595:       //             gradRho.r1 = rho1 - rho0
 5596:       //             gradRho.r2 = rho2 - rho0
 5597:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5598:       // 
 5599:       //  NOTE: We use de-meaned densities.
 5600: 
 5601:       SIDE(side);
 5602: 
 5603: 
 5604:       if (side->isDry) return;
 5605: 
 5606:       // Computes the gradient of the variables at the side center.
 5607:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5608:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5609:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5610: 
 5611:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5612:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5613:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5614:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5615: 
 5616:    }
 5617: 
 5618: 
 5619:    __global__ void solveMomentumEquations(double time) {
 5620: 
 5621:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5622:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5623: 
 5624:       SIDE(side);
 5625: 
 5626:       if (side->isDry) 
 5627:       {
 5628:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5629: 
 5630:          return;
 5631:       }
 5632: 
 5633:       const Node *n1 = side->n1;
 5634:       const Node *n2 = side->n2;
 5635: 
 5636:       const int kb = side->kb;
 5637: 
 5638:       const double veg_h = side->veg_h();
 5639:       const double grav3 = side->grav3();
 5640: 
 5641:       if (side->is2D()) {
 5642:          // Remember: Do not use htot2, which is updated.
 5643:          const double htot = side->htot1();
 5644:          const double hhat = side->hhat;
 5645: 
 5646:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5647: 
 5648:          Vector2 tau2 = {0.0, 0.0};
 5649:           
 5650:          if constexpr(ics==1) {
 5651:             tau2 = side->tau();
 5652: 
 5653:          } else {
 5654:             assert(false && "Not implemented: ics == 2");
 5655:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5656:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5657:             // taux2=(vn1+tt1)*0.5d0
 5658:             // tauy2=(vn2+ss1)*0.5d0
 5659:          } // if ics         
 5660: 
 5661:          // hat_gam has units of m/s
 5662: 
 5663:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5664:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5665:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5666: 
 5667:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5668: 
 5669: 
 5670:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5671: 
 5672:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5673: 
 5674:       }
 5675:       else { // 3D
 5676: 
 5677:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5678:          // 
 5679:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5680:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5681:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5682:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5683:          // k+1 and k.
 5684: 
 5685: 
 5686:          const int ndim = nvrt - kb;
 5687:          const double zTopCanopy = side->zTopCanopy();
 5688: 
 5689:          // Initialize the tridiagonal system
 5690:          for (int k = kb + 1; k < nvrt; k++) {
 5691:             
 5692:             const int kin = k - (kb + 1);
 5693: 
 5694:             // Vertical viscosity at the face center
 5695:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5696: 
 5697:  
 5698:             alow[kin] = 0.0;
 5699:             cupp[kin] = 0.0;
 5700:             bdia[kin] = 0.0;
 5701: 
 5702:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5703:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5704: 
 5705:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5706:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5707:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5708: 
 5709:             // First part: layers k, k+1
 5710:             if (k < nvrt - 1) {
 5711:                              
 5712:                if constexpr(iveg != 0) {
 5713: 
 5714:                   // If there is vegetation at this level...
 5715:                   if (zTopCanopy > side->zc[k]) {
 5716:                      // If the canopy is above the k layer...
 5717:                      
 5718:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5719:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5720:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5721:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5722: 
 5723:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5724:                      const double vmag2 = length(ut2);
 5725:                      const double vmag1 = length(side->u2[k]);
 5726:                      const double vmag = 0.5*(vmag1 + vmag2);
 5727:                      
 5728:                      // Computes the vegetation alpha at the face center
 5729:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5730: 
 5731:                      cff1 += veg_alpha_sd*dt*vmag;
 5732: 
 5733:                   } // if (zTopCanopy
 5734:                } // if iveg
 5735: 
 5736:                const double dzz = side->Dz(k + 1);
 5737:                const double tmp = dt*dfz/dzz;
 5738:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5739: 
 5740:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5741:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5742:             }
 5743: 
 5744: 
 5745:             // Second part: layers k-1, k
 5746:             if (k > kb + 1) {
 5747: 
 5748:                double cff1 = 1.0; //init \bar{c^k}
 5749: 
 5750:                if constexpr(iveg != 0) {
 5751:                   // If there is vegetation at this level...
 5752:                   if (zTopCanopy > side->zc[k-1]) {
 5753:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5754:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5755: 
 5756:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5757: 
 5758:                      const double vmag2 = length(ut2);
 5759:                      const double vmag1 = length(side->u2[k-1]);
 5760:                      const double vmag = 0.5*(vmag1 + vmag2);
 5761: 
 5762:                      // Computes the vegetation alpha at the face center
 5763:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5764:                      cff1 += veg_alpha_sd*dt*vmag;
 5765:                   } // if zTopCanopy
 5766: 
 5767:                } // if iveg
 5768: 
 5769:                const double dzz = side->Dz(k);
 5770:                const double tmp = dt*dfz/dzz;
 5771:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5772: 
 5773:                alow[kin] += cff1*dzz/6.0 - tmp;
 5774:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5775: 
 5776:             } else { // Bottom boundary
 5777:                // This occurs at the bottom, where the bottom drag is applied.
 5778: 
 5779:                bdia[kin] += dt*side->chi2; // XXXX
 5780: 
 5781:             } // if (k > kb + 1)
 5782: 
 5783: 
 5784:          } // for (int k
 5785: 
 5786: 
 5787: 
 5788:          // Computes the RHS.
 5789:          // -----------------
 5790: 
 5791:          //	BC to be imposed at the end.
 5792: 
 5793:          const Vector2 gradETP  = side->gradETP;
 5794:          const Vector2 gradPr   = side->gradPr;
 5795:          const Vector2 gradEta1 = side->gradEta1;
 5796:          const Vector2 gradEta2 = side->gradEta2;
 5797: 
 5798:          const Vector2 *btu = side->btu;
 5799:          const Vector2 *u2  = side->u2;
 5800:          const double coriolis = side->coriolis;
 5801:          const Vector2 *nuGradU = side->nuGradU;
 5802: 
 5803: 
 5804:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5805:          for (int k = kb + 1; k < nvrt; k++) {
 5806:             const int kin = k - kb - 1;
 5807: 
 5808:             const double dz_0 = side->Dz(k);
 5809:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5810: 
 5811:             rrhs[kin] = {0.0, 0.0};
 5812:             double dz = 0.0;
 5813: 
 5814:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5815:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5816:             if (k < nvrt  ) dz += dz_1;
 5817:             if (k > kb + 1) dz += dz_0;
 5818: 
 5819:             // Elevation gradient, atmospheric pressure and tidal potential
 5820:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5821: 
 5822:             // Coriolis, advection, wind stress, and horizontal viscosity
 5823:             if (k < nvrt - 1) {
 5824: 
 5825: 
 5826:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5827:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5828:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5829:                                                 
 5830: 
 5831:                //diff stress tensors 1006
 5832:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5833:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5834:                   assert(false && "Not implemented: itur == 5");
 5835:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5836:                }
 5837:                // else assert(false && "itur # Not implemented");
 5838: 
 5839:             } else { // k == nvrt - 1 SURFACE
 5840:                Vector2 tau2 = {0.0, 0.0};
 5841:                if constexpr(ics==1) {
 5842:                   tau2 = side->tau();
 5843:       
 5844:                } else {
 5845:                   assert(false && "Not implemented: ics == 2");
 5846:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5847:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5848:                   // taux2=(vn1+tt1)*0.5d0
 5849:                   // tauy2=(vn2+ss1)*0.5d0
 5850:                } // if ics
 5851: 
 5852:                rrhs[kin] += dt*tau2;
 5853:           
 5854: 
 5855:             } // if k<nvrt
 5856: 
 5857: 
 5858:             if (k > kb + 1) {
 5859:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5860:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5861:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5862: 
 5863:                // diff stress tensors 1006
 5864:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5865:                   assert(false && "Not implemented: itur == 5");
 5866:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5867:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5868:                }
 5869:                // else assert(false && "itur # Not implemented");
 5870: 
 5871: 
 5872:             } // if k>kbs + 1
 5873: 
 5874:             // Baroclinic
 5875:             Vector2 *bcc = side->bcc;
 5876:             if constexpr(ibc == 0) {
 5877:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5878:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5879: 
 5880:             } // if ibc==0
 5881: 
 5882:          } // k=kb + 1,nvrt
 5883: 
 5884: 
 5885:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5886: 
 5887:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5888:             const int kin = k - kb - 1;
 5889:    
 5890:             // Velocity is always clamped to maximum values
 5891:             side->u2[k] = clampVelocity(soln[kin]);
 5892:          } // k
 5893: 
 5894:       } // if side->is2D()
 5895:       
 5896: 
 5897:       // Impose velocity boundary condition at the bottom
 5898:       if constexpr(imm == 2) { // 3D bed deformation model
 5899:          double dep;
 5900:          Vector2 vel;
 5901: 
 5902:          assert(false && "Not implemented: imm == 2");
 5903:          //update_bdef(time, x0, y0, dep, vel);
 5904:          // side->u2[kb] = vel;
 5905: 
 5906:       } else { // imm = 0 or 1
 5907:          if (side->Cd() == 0.0) {
 5908:             side->u2[kb] = side->u2[kb + 1];
 5909: 
 5910:          } else if (side->is3D()) { // 3D no slip bottom   
 5911:             side->u2[kb] = {0.0, 0.0};
 5912: 
 5913:          }
 5914:           
 5915:       } // if imm
 5916: 
 5917:       // The velocities below the bottom level are set to zero
 5918:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5919: 
 5920: 
 5921:    }
 5922: 
 5923: 
 5924:    __global__ void applyMomentumBC(void) {
 5925: 
 5926:       SIDE_BND(sideBnd);
 5927: 
 5928:       Side *side = sideBnd->side;
 5929:       const BoundarySegment *segment = sideBnd->segment;
 5930:       const Node *n1 = side->n1;
 5931:       const Node *n2 = side->n2;
 5932: 
 5933:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5934: 
 5935:       const bool isLand = segment->isLand;
 5936:       const int ifltype = segment->ifltype;
 5937: 
 5938:       const int kb = side->kb;
 5939: 
 5940: 
 5941:       if (!isLand && ifltype != 0) {
 5942:          const Vector2 *ubc = sideBnd->ubc;
 5943:   
 5944:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5945:             
 5946:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5947:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5948: 
 5949:             if (ifltype == -1) {
 5950:                // Flather 1
 5951: 
 5952:                const double depth = side->depth();
 5953: 
 5954:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5955: 
 5956:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5957: 
 5958:                side->u2[k] = vnorm*side->n;
 5959: 
 5960:             } else if (ifltype == -2) { // Discharge
 5961: 
 5962:                const double eta1 = side->eta1();
 5963:                const double eta2 = side->eta2();
 5964:                const double htot = side->htot2();
 5965: 
 5966:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5967:                assert(false && "Not implemented: Discharge bc");
 5968:                // const double dischrg = discharge(eta1);
 5969:                const double dischrg = 0.0; // XXX REMOVE
 5970:                
 5971: 
 5972:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5973: 
 5974:                const double vnorm = dischrg*eta2/htot;
 5975: 
 5976:                side->u2[k] = vnorm*side->n;
 5977: 
 5978:             }
 5979:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5980:                const double vnorm = dot(side->u2[k], side->n);
 5981: 
 5982:                double rat;
 5983:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5984:                else              rat = segment->vobc2; // outgoing
 5985: 
 5986:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5987: 
 5988:             }
 5989:             else { // not Flather or 3D radiation
 5990:                side->u2[k] = ubc[k];
 5991: 
 5992:             } // if (segment->ifltype...
 5993: 
 5994:          }
 5995: 
 5996:       }
 5997:       else if (isLand) { // if it is land boundary side
 5998: 
 5999:          if constexpr(islip == 0) { // free slip
 6000: 
 6001:             for (int k = kb; k < nvrt; k++) {
 6002: 
 6003:                const Vector2 t = side->t();
 6004:                const Vector2 n = side->n;
 6005: 
 6006:                double vnorm = 0.0; // for most cases
 6007:                const double vtan = dot(side->u2[k], t);
 6008:                
 6009:                side->u2[k] = vtan*t - vnorm*n;
 6010: 
 6011:             }
 6012: 
 6013:          } else { // no slip
 6014:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6015: 
 6016:          }
 6017:       } // if (side segment type...
 6018: 
 6019:    
 6020: 
 6021:    }
 6022: 
 6023: 
 6024:    __global__ void shapiroFilter1(void) {
 6025:       // First step of the Shapiro filter (normally used if indvel<=0)
 6026:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6027: 
 6028:       SIDE(side);
 6029: 
 6030:       // Only internal wet sides are processed
 6031:       if (side->isDry || !(side->isInternal())) return;
 6032: 
 6033:       const int kb = side->kb;
 6034: 
 6035:       for (int mm = 0; mm < niter_shap; mm++) {
 6036: 
 6037:          for (int k = kb + 1; k < nvrt; k++) {
 6038:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6039:             Vector2 suru = {0.0, 0.0};
 6040: 
 6041:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6042: 
 6043:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6044: 
 6045:                int kin = k;
 6046:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6047:                
 6048:                if constexpr(ics==1) {
 6049:                   suru += nSide->u2[kin];
 6050: 
 6051:                } else {
 6052:                   assert(false && "Not implemented: ics == 2");
 6053:                   // Vector2 vn1, vn2;
 6054:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 6055:                   // suru=suru+vn1;
 6056:                   // surv=surv+vn2;
 6057:                }
 6058:             }
 6059: 
 6060:             // Reusing bcc as a temporary array to store the suru values.
 6061:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 6062: 
 6063:          }
 6064:       }
 6065:    }
 6066: 
 6067:    __global__ void shapiroFilter2(void) {
 6068:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6069: 
 6070:       SIDE(side);
 6071: 
 6072: 
 6073:       if (side->isDry || !(side->isInternal())) return;
 6074: 
 6075:       const int kb = side->kb;
 6076: 
 6077:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6078: 
 6079:       if (side->is2D()) {
 6080:          side->u2[kb + 1] = side->bcc[kb + 1];
 6081:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6082: 
 6083:       } else {
 6084:          // 3D
 6085:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6086:          
 6087:       }
 6088: 
 6089:    }
 6090: 
 6091: 
 6092:    __global__ void ul0UpdateZCoords(void) {
 6093:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6094:       
 6095:       NODE(node);      
 6096: 
 6097: 
 6098:       if (false) { //node->isDry) { XXXXXXX
 6099: 
 6100:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6101: 
 6102:          if constexpr(ivcor != 1) node->kb = 0;
 6103: 
 6104:       } else {
 6105: 
 6106:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6107:          node->updateKb();
 6108: 
 6109:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6110: 
 6111:       }
 6112: 
 6113:       // We use the temp.b field to store the previous state of isDry.
 6114:       node->tmp.b = node->isDry;
 6115: 
 6116:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6117:       node->isDry = true;
 6118: 
 6119:    }
 6120: 
 6121:    __global__ void ul0ComputeDryElements(void)
 6122:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6123:    {
 6124:       ELEM(elem);
 6125: 
 6126:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6127: 
 6128:       elem->kb = 0;
 6129: 
 6130:       if (elem->isDry) return;
 6131: 
 6132: 
 6133:    //    if(elem->isDry2()) { // XXXX
 6134:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6135:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6136:    //        call parallel_abort(errmsg)
 6137:    //    }
 6138: 
 6139:       const Node *n1 = elem->nodes[0];
 6140:       const Node *n2 = elem->nodes[1];
 6141:       const Node *n3 = elem->nodes[2];  
 6142:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6143: 
 6144:       // Computes element's kb as the minimum of the nodes' kb.
 6145:       const int kb1 = n1->kb;
 6146:       const int kb2 = n2->kb;
 6147:       const int kb3 = n3->kb;
 6148:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6149: 
 6150: 
 6151:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6152: 
 6153: 
 6154:       // Computes the element z as the mean of the nodes z.
 6155:       for (int k = elem->kb; k < nvrt; k++) {
 6156: 
 6157:          // Compute the element z as the mean of the nodes z.
 6158:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6159:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6160:          elem->z[k] /= elem->i34;
 6161: 
 6162:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6163:       }
 6164:                   
 6165:    }
 6166: 
 6167:    __global__ void ul0ComputeDryNodes(void)
 6168:    // Updates node's isDry based on the elements' isDry. 
 6169:    {
 6170:       NODE(node);
 6171: 
 6172:       node->isDry = true;
 6173: 
 6174:       // A node is wet if at least one of the elements sharing it is wet.
 6175:       for (int j = 0; j < node->numElements; j++) {
 6176:          const Element *elem = node->elements[j];
 6177:          if (!elem->isDry) {
 6178:             node->isDry = false;
 6179:             break;
 6180:          }
 6181:       }
 6182: 
 6183:        
 6184:    }
 6185: 
 6186: 
 6187:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6188:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6189:    // node->tmp.b is true if the node was previously dry.
 6190:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6191:    {
 6192:       NODE(node);
 6193:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6194: 
 6195:       // Avoid this the first time step.
 6196:       if (it == iths) return;  
 6197: 
 6198:       const bool wasDry = node->tmp.b;
 6199: 
 6200: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6201: 
 6202:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6203: 
 6204:          for (int k=0; k < nvrt; k++) {
 6205: 
 6206:             Vector3 utmp={0.0, 0.0, 0.0};
 6207: 
 6208:             double ttmp=0.0;
 6209:             double stmp=0.0;
 6210:             int icount=0;
 6211:             for (int j = 0; j < node->numNodes; j++) {
 6212: 
 6213:                const Node *nbrNode = node->nodes[j];
 6214:                
 6215:                const bool wasNbrDry = nbrNode->tmp.b;
 6216: 
 6217:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6218:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6219: 
 6220:                   icount++;
 6221: 
 6222:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6223:                   utmp += nbrNode->uvw2(k);
 6224:                   
 6225:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6226:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6227:                }
 6228:             }
 6229: 
 6230:             if (icount > 0) {
 6231:                const double inv_icount = 1.0/icount;
 6232:                utmp = inv_icount*utmp;
 6233:                node->u2[k]     = toVector2(utmp);
 6234:                node->w2[k]     = utmp.z;
 6235:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6236:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6237:             } else {
 6238:                node->u2[k] = {0.0, 0.0};
 6239:                node->w2[k] = 0.0;
 6240:                // Initialize tracers to 0.0??? XXXXX
 6241:             }
 6242:          }
 6243:       }
 6244:    }
 6245: 
 6246:   
 6247:    
 6248: 
 6249: 
 6250:    __global__ void ul0UpdateSides(int it, int iths) {
 6251:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6252:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6253:    // The dryness of the sides is updated in ul0UpdateSides2.
 6254: 
 6255:       SIDE(side);
 6256: 
 6257:       // A side is wet if and only if at least one of its elements is wet.
 6258:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6259:  
 6260:       const Node *n1 = side->n1;
 6261:       const Node *n2 = side->n2;
 6262:      
 6263:       const int kb1 = n1->kb;
 6264:       const int kb2 = n2->kb;
 6265: 
 6266:       side->kb = 0; // default when dry
 6267: 
 6268:       if (isWet) {
 6269: 
 6270:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6271: 
 6272:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6273: 
 6274:          side->kb = min(kb1, kb2);
 6275: 
 6276:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6277: 
 6278:          for (int k = side->kb; k < nvrt; k++) {
 6279:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6280: 
 6281:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6282: 
 6283:             // Compute velocity for re-wetted sides 
 6284:             if ((it != iths) && (side->isDry && isWet)) {
 6285: 
 6286:                Vector2 utmp={0.0, 0.0};
 6287: 
 6288:                int icount=0;
 6289: 
 6290:                // For all the sides on the two elements that share this side
 6291:                for (int j = 0; j < 2; j++) {
 6292:                   const Element *elem = side->elems[j];
 6293:                   if (elem == nullptr) continue;
 6294: 
 6295:                   for (int jj=0; jj < elem->i34; jj++) {
 6296:                      const Side *nSide = elem->sides[jj];
 6297:                      if (nSide->isDry) continue;
 6298: 
 6299:                      icount++;
 6300:                      utmp += nSide->u2[k];  
 6301:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6302:                   }
 6303:                }
 6304:                   
 6305:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6306:                if (icount > 0)  side->u2[k] = utmp/icount;
 6307:                else             side->u2[k] = {0.0, 0.0};
 6308:                   
 6309:             } // if ((it != iths) && (side->isDry && isWet))
 6310: 
 6311:          } // for k
 6312: 
 6313:       } // if isWet 
 6314:       
 6315: 
 6316: 
 6317:    }
 6318: 
 6319:    __global__ void ul0UpdateSides2(void) {
 6320:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6321:    
 6322:          SIDE(side);
 6323:    
 6324:          const Element *e1 = side->elems[0];
 6325:          const Element *e2 = side->elems[1];
 6326: 
 6327:          // A side is wet if and only if at least one of its elements is wet.
 6328:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6329: 
 6330:          // Update the side's dryness
 6331:          side->isDry = !isWet;
 6332: 
 6333:    }
 6334: 
 6335: 
 6336:    __global__ void zeroNodalVelocities(void) {
 6337:       NODE(node);
 6338: 
 6339:       for (int k = 0; k < nvrt; k++) {
 6340:          node->u2[k]   = {0.0, 0.0};
 6341:          node->w2[k]   = 0.0;
 6342:          node->utmp[k] = {0.0, 0.0};
 6343:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6344:       }
 6345:    }
 6346:  
 6347: 
 6348:    __global__ void computeNodalVerticalVelocities1(void) {
 6349:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6350:    // Adds the element's vertical velocity times the element's area.
 6351:       ELEM(elem);
 6352: 
 6353:       for (int j = 0; j < elem->i34; j++) {
 6354:          Node *node = elem->nodes[j];
 6355: 
 6356:          for (int k = node->kb; k < nvrt; k++) {
 6357:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6358:          }
 6359:          atomicAdd(&(node->tmp.d), elem->area);
 6360:       }
 6361:    }
 6362: 
 6363:    __global__ void computeNodalVerticalVelocities2(void) {
 6364:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6365:    // Divides by the total area of the elements sharing the    node.
 6366:       NODE(node);
 6367: 
 6368:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6369: 
 6370:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6371:    }
 6372: 
 6373: 
 6374:    __global__ void computeNodalHorizontalVelocities1(void) {
 6375: 
 6376:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6377:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6378: 
 6379:       ELEM(elem);
 6380: 
 6381:       if (elem->isDry) return;
 6382: 
 6383:       const int kb = elem->kb;
 6384:       const bool isTri = elem->isTri();
 6385: 
 6386:       if constexpr(indvel <= 0) {
 6387:          // Assuming discontinous hvel.
 6388: 
 6389:          if (isTri) { // For triangles
 6390:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6391:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6392: 
 6393:             for (int j = 0; j < 3; j++) {
 6394:                // For every node of the triangle...
 6395:                Node *node = elem->nodes[j];
 6396: 
 6397:                if (node->isDry) continue;
 6398: 
 6399:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6400:                const Side *s2 = elem->sides[(j + 1) % 3];
 6401:                const Side *s3 = elem->sides[(j + 2) % 3];
 6402: 
 6403:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6404: 
 6405:                atomicAdd(&(node->tmp.i), 1);
 6406: 
 6407:                for (int k = kb; k < nvrt; k++)  {
 6408:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6409:                   u = clampVelocity(u);
 6410:                   atomicAdd(&(node->utmp[k].x), u.x);
 6411:                   atomicAdd(&(node->utmp[k].y), u.y);
 6412: 
 6413:                }
 6414: 
 6415:             }
 6416:          }
 6417:          else { // For quads
 6418:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6419: 
 6420:          }
 6421: 
 6422:       }
 6423:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6424:       
 6425:    }
 6426: 
 6427: 
 6428:    __global__ void computeNodalHorizontalVelocities2(void) {
 6429:       NODE(node);
 6430: 
 6431:       const int nodeCount = node->tmp.i;
 6432: 
 6433:       if (nodeCount == 0) 
 6434:       {
 6435:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6436:          return;
 6437:       }
 6438: 
 6439:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6440:       
 6441:       const int kb = node->kb;
 6442: 
 6443:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6444:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6445:       
 6446:       
 6447:    }   
 6448: 
 6449:  
 6450: 
 6451:    __global__ void resetVelocityOpenBndNodes(void) {
 6452:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6453: 
 6454:       NODE_BND(nodebnd);
 6455: 
 6456:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6457:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6458:       }
 6459: 
 6460:    }
 6461: 
 6462: 
 6463:    __global__ void setVelocityOpenBndNodes(void) {
 6464:    // For open boundary nodes sets their velocity to the imposed values.
 6465: 
 6466:       SIDE_BND(sidebnd);
 6467: 
 6468:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6469:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6470:          // to its segment to the average of the side velocity.
 6471: 
 6472:          for (int k = 0; k < nvrt; k++) {
 6473:             Node *n1 = sidebnd->side->n1;
 6474:             Node *n2 = sidebnd->side->n2;
 6475: 
 6476: 
 6477:             Vector2 n1_u2(n1->u2[k]);
 6478:             Vector2 n2_u2(n2->u2[k]);
 6479: 
 6480:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6481:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6482:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6483:             }
 6484:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6485:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6486:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6487:             }
 6488: 
 6489:          }
 6490: 
 6491:       }
 6492: 
 6493:    }
 6494: 
 6495: 
 6496:    __global__ void computeVerticalVelocity(void) {
 6497:       // Computes the vertical velocity at the (2D) element's centroid.
 6498:       // In this function we will be considering volumetric elements, with side faces and a 
 6499:       // bottom and a top face. We will call them SFs, BF and TF.
 6500:       // It computes the flux coming from BF and the SFs.
 6501:       // If the bed is moving, it takes that into account.
 6502:       // Since water is incompressible, the integral of the velocity times the normal vector
 6503:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6504:       // and the BF is equal to the flux going out from the TF.
 6505:       // TF = - BF - sum(SFs).
 6506:       // It then computes the horizontal velocity at the center of TF.
 6507:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6508:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6509:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6510: 
 6511:       ELEM(elem);
 6512: 
 6513:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6514: 
 6515:       if (elem->isDry) return;
 6516: 
 6517:       const int kb = elem->kb;
 6518:       const bool isTri = elem->isTri();
 6519: 
 6520:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6521: 
 6522:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6523:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6524:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6525: 
 6526:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6527: 
 6528:       double area3D;
 6529: 
 6530:       // Bottom face flux
 6531:       double bottomFlux = 0.0;
 6532:       Vector2 u2meanBottom = {0.0, 0.0};
 6533:       const Vector2 gradh = elem->grad2(&Node::depth);
 6534:       if constexpr(imm==2) {
 6535:          Vector3 ubed;
 6536: 
 6537:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6538:          // updateBDEF(ubed);
 6539:      
 6540:          // const double bflux0 = dot(ubed, elem_n1);
 6541: 
 6542:          // elem->w[kb] += ubed.z;
 6543:       }
 6544:       else {
 6545:          Vector2 umean;
 6546:          if constexpr(ics == 1) {
 6547:             u2meanBottom = elem->mean(kb, &Side::u2);
 6548:          }
 6549:          else {
 6550:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6551:          }
 6552: 
 6553:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6554:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6555: 
 6556:          bottomFlux = - dot(gradh, u2meanBottom);
 6557:       } // if imm
 6558: 
 6559:       // Compute w for kb+1 to nvrt-1
 6560:       for (int l = kb; l < nvrt - 1; l++) {
 6561: 
 6562:          // normal vector to the top face of the "volumetric" element (3D)
 6563:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6564: 
 6565:          // Compute the total flux at the sides
 6566:          double sideFlux = 0.0;
 6567: 
 6568:          for (int j = 0; j < elem->i34; j++) {
 6569:             const Side *side = elem->sides[j];
 6570: 
 6571:             const double sideArea = side->area(l);
 6572:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6573:             const double sign = elem->ssign[j]; 
 6574: 
 6575:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6576:          }
 6577:          
 6578:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6579:          //velocities at the centers of the sides
 6580:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6581: 
 6582:          // The flx at the top ace can be computed from the other flows.
 6583:          const double topFlux = - sideFlux - bottomFlux;
 6584:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6585: 
 6586:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6587: 
 6588:          elem_n1 = elem_n2;
 6589: 
 6590:          bottomFlux = - topFlux;
 6591:       }
 6592:    }  
 6593: 
 6594: 
 6595: 
 6596: 
 6597: 
 6598: 
 6599: 
 6600: // !===============================================================================
 6601: // !===============================================================================
 6602: 
 6603: } // extern "C"
 6604: 
 6605: #ifdef DONTCOMPILE
 6606: __device__ void computeVerticalAdvection(void) {
 6607:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6608: 
 6609:    sdbt(1:2,:,:)=0.d0
 6610: 
 6611:    const Side *side = FROM kernel;
 6612: 
 6613:    if(side->isDry) return;
 6614: 
 6615:    // If side is wet...
 6616: 
 6617: 
 6618:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6619:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6620:    double ws[nvrt] = {} // w @ side
 6621:    int icount = 0;
 6622:    for (int j=0; j<2; j++) {
 6623:       const Element *elem = side->elements[j];
 6624:        
 6625:       if(elem != nullptr) {
 6626:          icount++;
 6627:          for (int k=0; k<nvrt; k++) {
 6628:             ws[k] = ws[k] + elem->w[k];
 6629:          }
 6630:       }
 6631:    }  // for j
 6632: 
 6633:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6634:    ws = ws/icount;
 6635: 
 6636:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6637:    // Splines allow for a smooth transition between vertical levels.
 6638:    // Splines have continuity restrictions at the internal knots, but
 6639:    // we have to provide the 1st derivatives at the endpoints.
 6640:    const int kbs = side->kbs; 
 6641:    
 6642:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6643:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6644:    initCubicSpline(kbs, nvrt, side, ws, up)
 6645: 
 6646:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6647:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6648:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6649: 
 6650:    // Total advection (average onto side)
 6651:    const Node *node1 = side->nodes[0];
 6652:    const Node *node2 = side->nodes[1];
 6653:    for (int k=kbs(i); k<nvrt; k++) {
 6654: 
 6655:       if constexpr(ics==1) {
 6656:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6657:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6658:       } else {
 6659:          // XXX IMPLEMENT THIS
 6660:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6661:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6662:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6663:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6664:       }  // if ics
 6665: 
 6666: 
 6667:    }
 6668: }
 6669: #endif
 6670: 
 6671: 
 6672: extern "C" {
 6673:    __global__ void computeElemAverageGhat(void) {
 6674:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6675: 
 6676:       ELEM(elem);
 6677:       
 6678:       elem->ghat1= {0.0, 0.0};  
 6679: 
 6680:       if constexpr(ihydraulics != 0) {
 6681:          if (nhtblocks > 0 && elem->isblock) return;
 6682:       }
 6683: 
 6684: 
 6685: 
 6686:       
 6687:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6688:       // tidal potential, horizontal diffusion, and baroclinic etc
 6689:       // Remember to update both fb and F 
 6690:       // If ics=2, ghat1 are in eframe (ll)
 6691:       // cff1-3: coefficients for 2D/3D
 6692:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6693:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6694:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6695: 
 6696:       if (elem->isDry) return;
 6697: 
 6698:       double av_cff1 = 0.0;  // av. for cff1
 6699:       double av_cff2 = 0.0;  // av. for cff2
 6700:       double av_cff3 = 0.0;  // av. for cff3
 6701:       double av_df = 0.0;  // av. for H^\alpha / H
 6702:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6703:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6704: 
 6705:       const int i34 = elem->i34;
 6706:       const int kb = elem->kb;
 6707: 
 6708:       for (int j=0; j<i34; j++) {
 6709:          // For each node and side in the element...
 6710: 
 6711:          const Node *node = elem->nodes[j];
 6712:          const Side *side = elem->sides[j];
 6713: 
 6714:          const double chi      = side->chi;
 6715:          const double veg_c2   = side->veg_c2;
 6716:          const double veg_beta = side->veg_beta;
 6717:          const double veg_h    = side->veg_h();
 6718:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6719: 
 6720:          // Node - const in elem
 6721:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6722:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6723: 
 6724:          if (elem->depth >= tip_dp) {
 6725:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6726:          }
 6727: 
 6728:          
 6729:          const double htot  = side->htot2();        // Total depth at the side
 6730:          const double zctr2 = side->zTopCanopy();  
 6731: 
 6732:          double cff1; 
 6733:          double cff2; 
 6734:          double cff3;   
 6735:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6736:          // coefficients applied to 2D/3D case 
 6737:             cff1 = side->hhat/htot;
 6738:             cff2 = 0.0;
 6739:             cff3 = 0.0;
 6740:          } else { //3D
 6741:             //Init for no-veg case
 6742:             cff1 = 1.0;
 6743:             cff2 = 1.0;
 6744:             cff3 = 0.0;
 6745: 
 6746:             if constexpr(iveg != 0) {
 6747:                // Computes coefficients used with vegetation terms G1, G2
 6748:                // cff1, cff3 are used for the first two terms in G1, G2:
 6749:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6750:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6751:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6752:                if(veg_h < 0.99*htot) { // submergent vegetation
 6753:                   cff1=1;
 6754:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6755:                   cff3 = veg_c;
 6756: 
 6757:                } else { // emergent vegetation
 6758:                   cff1 = 1.0/(1.0 + veg_c2);
 6759:                   cff2 = cff1;
 6760:                   cff3 = 0.0;
 6761: 
 6762:                }
 6763:             } // if iveg
 6764:          } //  2D/3D
 6765: 
 6766:          av_cff1 += cff1/i34;
 6767:          av_cff2 += cff2/i34;
 6768:          av_cff3 += cff3/i34;
 6769:          av_cff2_chi += cff2*chi/i34;
 6770:          av_cff3_chi += cff3*chi/i34;
 6771:          av_df += min(htot, veg_h)/(htot*i34);
 6772: 
 6773: 
 6774:          // btrack values: U^\star, U^{\star\alpha}
 6775:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6776:          Vector2 Ustar       = {0.0, 0.0}; 
 6777:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6778: 
 6779:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6780:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6781:          } else { //3D
 6782:             for (int k = side->kb + 1; k < nvrt; k++) {
 6783:             
 6784:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6785:                Ustar += w2;
 6786: 
 6787:                if constexpr(iveg != 0) {
 6788:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6789:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6790:                        Ustar_alpha += zrat*w2; // XXXX
 6791:                    }
 6792:                }  // if iveg
 6793:             }  // for k
 6794:          }  //2D/3D
 6795:          
 6796: 
 6797:          // Add btrack & surface stress terms to \breve{G} first
 6798:          if constexpr(ics==1) {
 6799: 
 6800:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6801: 
 6802:          } else {
 6803:             assert(false && "computeElemAverageGhat: Not implemented");
 6804:             // XXX IMPLEMENT THIS
 6805:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6806:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6807:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6808:          }  // if ics
 6809: 
 6810:          // Surface and bottom stress terms
 6811:          if constexpr(ics==1) {
 6812:             const Vector2 tau    = side->tau();
 6813:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6814: 
 6815:             // Term for surface and bottom stress
 6816:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6817: 
 6818:          } else {
 6819:             assert(false && "computeElemAverageGhat: Not implemented");
 6820:             // XXX IMPLEMENT THIS
 6821:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6822:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6823:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6824:             // tau_x=(vn1+tt1)/2.d0
 6825:             // tau_y=(vn2+ss1)/2.d0
 6826:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6827:          }  // if ics
 6828: 
 6829:          
 6830: 
 6831:          // All terms in F,F^\alpha,f_b except baroclinic
 6832:          // F, f_b: all explicit terms excluding vegetation 
 6833:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6834:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6835:          const double coriolis = side->coriolis;
 6836:          Vector2 F  =  coriolis*side->U;  // F_x
 6837:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6838:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6839: 
 6840:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6841:             
 6842:             for (int k = side->kb; k < nvrt; k++) {
 6843:                if (zctr2 > side->zc[k-1]) {
 6844:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6845:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6846:                    Fa +=  coriolis*w2*zrat;
 6847:                } // if zctr2
 6848:             } // k
 6849:          } // iveg
 6850: 
 6851:          // Integrate horizontal viscosity force vertically
 6852:          for (int k=side->kb + 1; k<nvrt; k++) {
 6853:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6854: 
 6855:             F += levelHorVisc;
 6856: 
 6857:             // Vegetation term
 6858:             if constexpr(iveg!=0) {
 6859:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6860:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6861:                   Fa += levelHorVisc*zrat;
 6862:                } 
 6863:             } // if iveg
 6864:          } // for k
 6865: 
 6866:          fb += side->nuGradU[side->kb];
 6867: 
 6868:          // Add to ghat1
 6869:          if constexpr(ics==2) {
 6870:             assert(false && "computeElemAverageGhat: Not implemented");
 6871:             // XXX IMPLEMENT THIS
 6872:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6873:             // bigf1=vn1; bigf2=vn2
 6874:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6875:             // botf1=vn1; botf2=vn2
 6876:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6877:             // bigfa1=vn1; bigfa2=vn2
 6878:          } // if ics
 6879: 
 6880:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6881:       } // for j (nodes and sides)
 6882: 
 6883:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6884:          
 6885:       // Finish off terms in F, F^\alpha and f_b
 6886:       const double grav3 = elem->mean(&Node::grav2);
 6887:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6888: 
 6889: 
 6890:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6891:       for (int j=1; j<i34; j++) { 
 6892:          // For each side in the element...
 6893:          const Side *side = elem->sides[j];
 6894:          const double chi = side->chi;
 6895: 
 6896:          const double htot = side->htot2();
 6897:          const double veg_h = side->veg_h();
 6898:          const Vector2 F  = htot*fb;
 6899:          const Vector2 Fa = min(htot, veg_h)*fb;
 6900: 
 6901:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6902:       } // for j
 6903: 
 6904:       //botf1 etc are already in elem frame
 6905:       elem->ghat1 += tmp/i34;
 6906: 
 6907:       // Baroclinic force
 6908:       if constexpr(ibc==0) {
 6909:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6910: 
 6911:          Vector2 Fa = {0.0, 0.0};
 6912:          Vector2 intGradRho = {0.0, 0.0};
 6913:          
 6914:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6915:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6916:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6917: 
 6918:             // \in F [m^2/s/s]
 6919:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6920:          }
 6921: 
 6922:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6923:          const Vector2 F = av_df*Fa; //approx
 6924:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6925: 
 6926:       } // if ibc
 6927: 
 6928: 
 6929: 
 6930:    }
 6931: 
 6932: } // extern "C"
 6933: 
 6934: 
 6935: 
 6936: #ifdef DONTCOMPILE
 6937: __global__ void checkMassConservation(Tracers* sumtr) {
 6938: 
 6939:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6940: 
 6941:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6942: 
 6943:    Element *elem = &(mesh->localElemData[i]);
 6944: 
 6945:    // Skip dry elements
 6946:    if (elem->isDry) return;
 6947: 
 6948:    // Local sum array for this thread
 6949:    double localSum[N_TRACERS] = {0.0};
 6950: 
 6951:    // Sum over vertical levels for this element
 6952:    const int kbe = elem->kbe;
 6953:    const double area = elem->area;
 6954: 
 6955:    for (int k = kbe; k < nvrt; k++) {
 6956:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6957:       
 6958:       // Accumulate tracer mass
 6959:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6960:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6961:       }
 6962:    }
 6963: 
 6964:    //  This function returns per element sums. A reduction must be done on the host side.
 6965: }
 6966: 
 6967: 
 6968: __global__ void transport(void) {
 6969: 
 6970:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6971: 
 6972:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6973: 
 6974:    Element *elem = &(mesh->localElemData[ie]);
 6975: 
 6976:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6977: 
 6978:                for (int m=0; m<ntr; m++) {
 6979:                   for (int k=kbe(ie); k<nvrt; k++) {
 6980:                      // Calculate each polynomial's weight 
 6981:                      wm=0.d0; sum1=0.d0; 
 6982:                      wm1=0.d0; wm2=0.d0; 
 6983:                      for (int i=0; i<elem->nweno2; i++) {
 6984:                   
 6985:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6986:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6987:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6988:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6989:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6990:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6991:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6992:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6993:                      // -----------------Hu and Shu (1999)'s method----------------
 6994:                      b4=b1+b2+b3
 6995: 
 6996: //Error: add PRODUCTION CPP
 6997: #ifdef DEBUG
 6998:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6999:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7000:                     call parallel_abort(errmsg)
 7001:                   }
 7002: #endif
 7003: 
 7004:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7005:                   // !----test-------------- 
 7006:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7007:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7008:                   // !wm(i)=wm1(i)*wm2(i)
 7009:                   // !---------------------- 
 7010:                   sum1=sum1+wm(i)
 7011:                 } // end for i
 7012: 
 7013:                 wm=wm/sum1
 7014: 
 7015:                 for (int j=0; j<elem->i34; j++) {
 7016: 
 7017:                   const Side *side  = elem->sides[j];
 7018:                   const Node *node1 = side->n1;
 7019:                   const Node *node2 = side->n2;
 7020: 
 7021:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7022:                      trsd=0.d0
 7023:                      for (int kk=0; kk<nquad; kk++) {
 7024:                         for (int i=0; i<elem->nweno2; i++) {
 7025:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7026:                         } // end for i   
 7027:                      } // end for kk
 7028:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7029:                   } // outward flux
 7030:                } // end for j=1,i34(ie) ! side
 7031:             }
 7032:          }
 7033:               
 7034: 
 7035: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7036: //             //   calculate each polynomial's weight 
 7037: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7038: //                 wm=0.d0; sum1=0.d0
 7039: //                 do i=1,nweno1(ie) !for each polynomial
 7040: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7041: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7042: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7043: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7044: //                   wm(i)=b2
 7045: //                   sum1=sum1+b2
 7046: //                   !wm(i)=1.d0
 7047: //                   !sum1=sum1+1.d0
 7048: 
 7049: // // Error: PRODUCTION
 7050: // #ifdef DEBUG
 7051: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7052: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7053: //                     call parallel_abort(errmsg)
 7054: //                   endif
 7055: // #endif
 7056: 
 7057: //                 enddo !i
 7058: //                 wm=wm/sum1 !final weight
 7059: 
 7060:                 for (int j=0; j<elem->i34; j++) { // side
 7061:                   const Side *side = elem->sides[j];
 7062:                   const Node *node1 = side->n1;
 7063:                   const Node *node2 = side->n2;
 7064: 
 7065:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7066:                     trsd=0.d0
 7067:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7068:                       for (int i=0; i<elem->nweno1; i++) {
 7069:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7070:                       }
 7071:                     enddo //kk
 7072:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7073:                   } // outward flux
 7074:                 } // end for j=1,i34(ie) ! side
 7075:               } // end for k; ntr 
 7076: 
 7077:             else !simple upwind method
 7078:               do j=1,i34(ie)
 7079:                 jsj=elside(j,ie)
 7080:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7081:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7082:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7083:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7084:                   endif
 7085:                 enddo  !vertical layers
 7086:               enddo !j=1,i34(ie) ! side
 7087:             endif !order of accuracy
 7088: 
 7089:          //  enddo !ie
 7090: // !$OMP     end do
