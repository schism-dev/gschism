 1335: // This struct is used to store the boundary information for a node.
 1336: struct NodeBoundary {   
 1337:    int idx;
 1338:    BoundarySegment *segment;
 1339:    Node *node;
 1340:    
 1341:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1342:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1343: 
 1344:    bool isLand;
 1345: 
 1346:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1347:    double elbc;   // Elevation boundary condition
 1348:    double eth;    // Elevation time history
 1349: 
 1350:    double eta_mean; // Mean elevation at nodes
 1351: 
 1352:    bool isEssentialBC;
 1353: 
 1354:    Vector2 uth[nvrt];  // "Time history" velocity
 1355: 
 1356:    // Arrays for harmonic constituents (if needed)
 1357:    double  emo[nbfr];  // Elevation amplitude
 1358:    double  efa[nbfr];  // Elevation phase
 1359:    Vector2 umo[nbfr];  // velocity amplitude
 1360:    Vector2 ufa[nbfr];  // velocity phase
 1361: 
 1362: 
 1363:    NodeBoundary(void) {
 1364:       isLand = false;
 1365:    }
 1366:    NodeBoundary(bool _isLand) {
 1367:       isLand = _isLand;
 1368:    }
 1369: 
 1370:    
 1371:    __forceinline__ __device__ int numSidesForAverage() const {
 1372:    // Returns the number of sides that are connected to the node and have the same segment.
 1373:    // This is used to compute the average velocity at the node for open boundary nodes.
 1374:       int res = 0;
 1375:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1376:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1377: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1378:       return res;
 1379:    }
 1380: 
 1381: 
 1382:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1383:       assert(index == 0 || index == 1); 
 1384:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1385:    }
 1386: 
 1387:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1388:       if (isLand) return;  // land never uses these links
 1389: 
 1390:       SideBoundary *nullSideBoundary = nullptr;
 1391:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1392: 
 1393:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1394:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1395: 
 1396:       // both slots taken. OK if this side was already linked
 1397:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1398:    }
 1399: 
 1400: 
 1401: };
 1402: 
 1403: struct Node {
 1404: 
 1405:    // Geometry information
 1406:    int idx;            // Global index of the node
 1407:    int16_t part;       // Partition of the node
 1408: 
 1409:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1410:    int16_t numNodes;   // Number of nodes neighbors of this node
 1411: 
 1412:    Element **elements; // Array of pointers to the elements that share this node
 1413:    int16_t numElements;// Number of elements that share this node
 1414: 
 1415:    int16_t numSides;   // Number of sides that are connected to this node
 1416: 
 1417: 
 1418:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1419:    double gz;          // Global vertical coordinate at the node.
 1420:    Vector2 u2[nvrt];
 1421:    double  w2[nvrt];
 1422:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1423:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1424:    double lon, lat;
 1425:    double depth;
 1426: 
 1427:    Frame<ics> frame;
 1428: 
 1429:    LocalSigma<ivcor> localSigma;  
 1430: 
 1431:    int16_t kb;     // Bottom index of the node
 1432: 
 1433:    bool isDry;     // True if the node is dry
 1434: 
 1435:    int16_t iadv;   // Advection flag
 1436: 
 1437:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1438:                           // this is nullptr
 1439: 
 1440:    TempVar tmp; // Temporary variable to store different types of variables
 1441: 
 1442:    // Physical information
 1443:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1444:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1445: 
 1446:    double rho[nvrt];     // Density
 1447:    double dfv[nvrt];     // Vertical viscosity
 1448: 
 1449:    double eta1; // Elevation at nodes at previous timestep
 1450:    double eta2; // Elevation at nodes at current timestep
 1451: 
 1452:    double ETP;  // Earth Tidal Potential
 1453: 
 1454:    double pr;    // Air pressure
 1455:    double grav2; // Gravity 
 1456:    
 1457:    Vector2 dav;  // Depth averaged velocity
 1458: 
 1459:    Vector2 tau; // Wind stress vector
 1460: 
 1461:    // Vegetation parameters
 1462:    double veg_h;
 1463:    double veg_nv;
 1464:    double veg_di;
 1465:    double veg_Cd;
 1466:    double veg_h_unbent;
 1467:    double veg_di_unbent;
 1468:    double veg_nv_unbent;
 1469:    double veg_alpha_vert_mean;
 1470:    double veg_alpha0;
 1471:    double veg_alpha3D[nvrt];
 1472: 
 1473:    // Bottom drag parameters
 1474:    double Cd;       // Bottom drag coefficient   
 1475: 
 1476:    // These three are mutually exclusive
 1477:    union {
 1478:       double rmanning; // Bottom Manning's coefficient
 1479:       double rough;    // Bottom roughness length
 1480:       double drag;     // Bottom drag coefficient
 1481:    };
 1482:    Vector2 tau_bot; // Bottom stress vector
 1483: 
 1484:    // XXXX REMOVE FOR IMM>0???
 1485:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1486:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1487: 
 1488:    int16_t *permutationSortedByGlobalIndex;  // Array of indices for the coefficients sorted by the global index. (This is to improve the cache locality when accessing the coefficients.)
 1489:    int16_t diagonalIndex;                    // Index of the element right before the diagonal element in the permutationSortedByGlobalIndex array.
 1490: 
 1491:    double qel; // RHS
 1492:    double coeffDiag; // Diagonal coefficient of the matrix
 1493:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1494: 
 1495:    // This was used by a previous version of the conjugate gradient method
 1496:    // double mP; // Search direction for conjugate gradient method
 1497:    // double mR; // Residual for conjugate gradient method
 1498:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1499: 
 1500:    double mX; // Solution of the FEM system
 1501: 
 1502:    // Meteorological forcing
 1503:    Vector2 u_air;
 1504:    double p_air;  // XXXX is this the same as pr?
 1505:    double t_air;
 1506:    double q_air;
 1507:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1508: 
 1509: 
 1510:    __device__ double getCoeffSorted(int k) const {
 1511:    // Returns the k-th coefficient sorted by the global index. Includes the diagonal element.
 1512: 
 1513:    
 1514:       assert(k >= 0 && k <= numNodes);
 1515:       const int16_t *perm = permutationSortedByGlobalIndex;
 1516: 
 1517:       // Special case, k is the diagonal element.
 1518:       if (k == diagonalIndex) return coeffDiag;
 1519: 
 1520:       if (k < diagonalIndex) return coeffMatrix[perm[k]];
 1521:       else                   return coeffMatrix[perm[k - 1]];
 1522:    }
 1523: 
 1524:    __device__ void setWind(Vector2 &u) {
 1525:    // Sets the wind vector taking into account the mesh angle
 1526:    
 1527:       const double speed = length(u);
 1528: 
 1529:       // Rotate wind vector to the node frame
 1530:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1531: 
 1532:       // Sets the surface stress vector due to wind.
 1533:       if constexpr(nws == 0) {
 1534:          tau = {0.0, 0.0};
 1535: 
 1536:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1537:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1538: 
 1539:       } else {
 1540: 
 1541:          double dragcoef;
 1542: 
 1543:          if constexpr(iwind_form == -1) {
 1544:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1545:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1546: 
 1547:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1548:             tau = cff*u_air;
 1549:  
 1550:          } else if constexpr(iwind_form == 1) {
 1551:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1552:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1553: 
 1554:             dragcoef = max(dragcoef, 4.0e-4);
 1555:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1556:             tau = cff*u_air;
 1557: 
 1558:          } else {
 1559:             tau = {0.0, 0.0};
 1560:          }
 1561:       }
 1562:    }
 1563: 
 1564: 
 1565:    __device__ void setFrame(double lat, double lon) {
 1566:       if constexpr(ics == 1) return;
 1567: 
 1568:       frame.update(lat, lon);        
 1569:     }
 1570: 
 1571:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1572: 
 1573:    __device__ double sigmaTransitionDepth(void) const;
 1574: 
 1575:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1576: 
 1577:    __inline__ __device__ Point2 outputCoords(void) const {
 1578:       if constexpr(ics == 1)  return p;
 1579:       else                    return {rad2deg*lon, rad2deg*lat};
 1580:    }
 1581: 
 1582:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1583:    // If ics == 2, convert the global point to the local frame
 1584:       
 1585:       if constexpr (ics == 1) {
 1586:          return p;
 1587:       } else {
 1588:          const Point3 c = {p.x, p.y, gz};
 1589:          const Point3 local = frame.G2L(p - c);
 1590:          return local;
 1591:       }
 1592:    }
 1593: 
 1594:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1595:    // If ics == 2, convert the global point to the local frame
 1596:       
 1597:       if constexpr (ics == 1) {
 1598:          return p;
 1599:       } else {
 1600:          const Point3 c = {p.x, p.y, gz};
 1601:          return c + frame.L2G(p);
 1602:       }
 1603:    }
 1604: 
 1605:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1606:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1607:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1608:    
 1609:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1610: 
 1611:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1612: 
 1613:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1614:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1615: 
 1616:    __device__ __forceinline__ void clearMatrixRow(void) {
 1617:       // Clear the matrix row for this node
 1618: 
 1619: 
 1620:       coeffDiag = 0.0;
 1621: 
 1622:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1623: 
 1624:    }
 1625: 
 1626:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1627:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1628:       
 1629:       if (node == this) {
 1630:          coeffDiag += value;
 1631:      
 1632:       } else {
 1633:          // Search (linearly) the index of the node in the array of nodes
 1634:          // XXX: This is not efficient, see if we can improve this
 1635:          int i;
 1636:          for (i = 0; i < numNodes; i++) {
 1637:             if (nodes[i] == node) {
 1638:                break;
 1639:             }
 1640:          }
 1641:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1642:          coeffMatrix[i] += value;
 1643:       }
 1644:    }
 1645: 
 1646: 
 1647:    __device__ __inline__ void updateZCoordData(void);
 1648: 
 1649:    __device__ __forceinline__ double compZCoord(int k) const;
 1650: 
 1651:    __device__ void updateKb(void);
 1652: 
 1653:    __device__ __forceinline__ void computeBottomDragCd(void);
 1654: 
 1655: 
 1656: 
 1657: };
