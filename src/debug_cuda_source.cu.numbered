 1222: struct Node {
 1223: 
 1224:    // Geometry information
 1225:    int idx;        // Index of the node
 1226:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1227:    int numNodes;   // Number of nodes neighbors of this node
 1228: 
 1229:    Element **elements; // Array of pointers to the elements that share this node
 1230:    int numElements;    // Number of elements that share this node
 1231: 
 1232:    Side **sides;       // Array of pointers to the sides that are connected to this node.
 1233:    int numSides;       // Number of sides that are connected to this node
 1234: 
 1235: 
 1236:    // XXXXXX I want to keep sides and nodes as separate arrays, for the time being. I have already implemented function nodes2(idx), that should become nodes() eventually.
 1237: 
 1238:    Point2 p;
 1239:    Vector2 u2[nvrt];
 1240:    double  w2[nvrt];
 1241:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1242:    double z[nvrt];
 1243:    double lon, lat;
 1244:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1245:    double depth;
 1246: 
 1247:    int kb;       // Bottom index of the node
 1248: 
 1249:    bool isDry;     // True if the node is dry
 1250: 
 1251:    int iadv;     // Advection flag
 1252: 
 1253:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1254:                           // this is nullptr
 1255: 
 1256:    TempVar tmp; // Temporary variable to store different types of variables
 1257: 
 1258:    // Physical information
 1259:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1260:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1261: 
 1262:    double rho[nvrt];     // Density
 1263:    double dfv[nvrt];     // Vertical viscosity
 1264: 
 1265:    double eta1; // Elevation at nodes at previous timestep
 1266:    double eta2; // Elevation at nodes at current timestep
 1267: 
 1268:    double ETP;  // Earth Tidal Potential
 1269: 
 1270:    double pr;    // Air pressure
 1271:    double grav2; // Gravity 
 1272:    
 1273:    Vector2 dav;  // Depth averaged velocity
 1274: 
 1275:    Vector2 tau; // Wind stress vector
 1276: 
 1277:    // Vegetation parameters
 1278:    double veg_h;
 1279:    double veg_nv;
 1280:    double veg_di;
 1281:    double veg_Cd;
 1282:    double veg_h_unbent;
 1283:    double veg_di_unbent;
 1284:    double veg_nv_unbent;
 1285:    double veg_alpha_vert_mean;
 1286:    double veg_alpha0;
 1287:    double veg_alpha3D[nvrt];
 1288: 
 1289:    // Bottom drag parameters
 1290:    double Cd;       // Bottom drag coefficient   
 1291: 
 1292:    // These three are mutually exclusive
 1293:    union {
 1294:       double rmanning; // Bottom Manning's coefficient
 1295:       double rough;    // Bottom roughness length
 1296:       double drag;     // Bottom drag coefficient
 1297:    };
 1298:    Vector2 tau_bot; // Bottom stress vector
 1299: 
 1300:    double bdef1; // Bottom deformation at previous timestep
 1301:    double bdef2; // Bottom deformation at current timestep
 1302: 
 1303:    double qel; // RHS
 1304:    double coeffDiag; // Diagonal coefficient of the matrix
 1305:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1306: 
 1307:    double mP; // Search direction for conjugate gradient method
 1308:    double mR; // Residual for conjugate gradient method
 1309:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1310:    double mX; // Solution for conjugate gradient method
 1311: 
 1312:    // Meteorological forcing
 1313:    Vector2 u_air;
 1314:    double p_air;
 1315:    double t_air;
 1316:    double q_air;
 1317:    double wind_angle;  // Wind rotation angle
 1318: 
 1319:    __device__ void setWind(Vector2 &u) {
 1320:    // Sets the wind vector taking into account the wind rotation angle
 1321:    
 1322:       const double dir = atan2(-u.x,-u.y);
 1323:       const double speed = length(u);
 1324: 
 1325:       // Calculate new u and v components with added rotation angle
 1326:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1327:    }
 1328: 
 1329: 
 1330:    __inline__ __device__ Node *nodes2(int index) const { index = index % numSides; const Side *side = sides[index]; return side->n1 == this ? side->n2 : side->n1; }
 1331: 
 1332:    __inline__ __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1333: 
 1334:    __device__ double sigmaTransitionDepth(void) const;
 1335: 
 1336:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1337:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1338:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1339:    
 1340:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1341: 
 1342:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1343: 
 1344:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1345:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1346: 
 1347:    __device__ __forceinline__ void clearMatrixRow(void) {
 1348:       // Clear the matrix row for this node
 1349: 
 1350: 
 1351:       coeffDiag = 0.0;
 1352: 
 1353:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1354: 
 1355:    }
 1356: 
 1357:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1358:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1359:       
 1360:       if (node == this) {
 1361:          coeffDiag += value;
 1362:      
 1363:       } else {
 1364:          // Search (linearly)the index of the node in the array of nodes
 1365:          // XXX: This is not efficient, see if we can improve this
 1366:          int i;
 1367:          for (i = 0; i < numNodes; i++) {
 1368:             if (nodes[i] == node) {
 1369:                break;
 1370:             }
 1371:          }
 1372:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1373:          coeffMatrix[i] += value;
 1374:       }
 1375:    }
 1376: 
 1377: 
 1378:    __device__ __inline__ void updateZCoordData(void);
 1379: 
 1380:    __device__ double compZCoord(int k) const;
 1381: 
 1382:    __device__ void updateKb(void);
 1383: 
 1384:    __device__ __forceinline__ void computeBottomDragCd(void);
 1385: 
 1386: 
 1387: 
 1388: };
