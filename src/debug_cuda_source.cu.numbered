 1528:                    BoundarySegment *localSegmentMem,
 1529:                    double h_c, double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1530:                    double *cs, double *dcs
 1531:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1532:                        np(np), ne(ne), ns(ns),
 1533:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1534:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1535:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1536:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1537:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1538:                        localSegmentMem(localSegmentMem),
 1539:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1540:                        cs(cs), dcs(dcs),
 1541:                        coeffMatrixMem(partCoeffMatrixMem),
 1542:                        landBoundarySegment(true),
 1543:                        landBoundaryNode(true)
 1544:    {
 1545:       printf("Mesh constructor for partition %d\n", partNum);
