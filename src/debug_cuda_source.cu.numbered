 2191: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2192: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2193: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2194: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
