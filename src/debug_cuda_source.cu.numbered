 5490:    __global__ void resetBoundaryAreas(void) {
 5491:       // Reset boundary areas and lengths for each segment.
 5492: 
 5493:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5494:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5495:       SIDE_BND(sideBnd);
 5496: 
 5497:       BoundarySegment *segment = sideBnd->segment;
 5498: 
 5499:       segment->carea = 0.0;
 5500:       segment->clen = 0.0;
 5501:  
 5502:    }
 5503: 
 5504:    __global__ void computeBoundaryAreas(void) {
 5505:    // Calculation of cross-section areas and lengths for flow b.c.
 5506: 
 5507:       SIDE_BND(sideBnd);
 5508: 
 5509:       const Side *side = sideBnd->side;
 5510:       BoundarySegment *segment = sideBnd->segment;
 5511: 
 5512:       if (segment->ifltype != 0) {
 5513: 
 5514:          const Node *n1 = side->n1;
 5515:          const Node *n2 = side->n2;
 5516: 
 5517:          const double htot = side->htot2();
 5518: 
 5519:          if (!side->isDry) {
 5520:             atomicAdd(&segment->carea, htot*side->len);
 5521:             atomicAdd(&segment->clen, side->len);
 5522:          }
 5523:       }
 5524: 
 5525:    }
 5526: 
 5527: 
 5528:    __global__ void computeFlowBcVelocities(double time) {
 5529: 
 5530:       SIDE_BND(sideBnd);
 5531: 
 5532:       const Side *side = sideBnd->side;
 5533:  
 5534:       const bool isDry = side->isDry;
 5535:       const bool isLand = sideBnd->segment->isLand;
 5536: 
 5537:    
 5538:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5539: 
 5540:       if (isDry || isLand) return;
 5541: 
 5542:       // For wet sides in open boundaries...
 5543:       const Vector2 n = side->n;
 5544:       const BoundarySegment *segment = sideBnd->segment;
 5545: 
 5546:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5547: 
 5548:       const int ifltype = segment->ifltype;
 5549: 
 5550:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5551:       const Vector2 r_nuth0 = r_uth0*n;
 5552: 
 5553: 
 5554:       if (ifltype == 1 || ifltype == 2) {
 5555:       
 5556:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5557: 
 5558:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5559:          
 5560:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5561:          
 5562:       } else if (ifltype == -1) { // Flather 1
 5563: 
 5564:          for (int k = 0; k < nvrt; k++) {
 5565: 
 5566:             // uth is the normal vel.; no ramp up
 5567:             const double uth = sideBnd->nuth(k);
 5568:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5569: 
 5570:             sideBnd->ubc[k] += uth*n;
 5571:          }
 5572: 
 5573:       } else if (ifltype == 3 || ifltype == 5) {
 5574:          // vnth0=0 !normal vel.
 5575: 
 5576:          Vector2 r_u1_bar = {0.0, 0.0};
 5577:          // Computes the contribution to the velocity from all tide frequencies
 5578:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5579: 
 5580:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5581:             const Vector2 umo  = sideBnd->umo(jfr); 
 5582: 
 5583:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5584:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5585:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5586:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5587: 
 5588:          }
 5589: 
 5590: 
 5591:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5592: 
 5593:       } // if (ifltype = 3 || ifltype == 5
 5594: 
 5595: 
 5596: 
 5597:    }
 5598: 
 5599:    __global__ void computeElevationBoundaryConditions(double time) {
 5600:       // Compute elevation essential boundary conditions 
 5601: 
 5602:       NODE_BND(nodeBnd); // Each boundary node.
 5603: 
 5604:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5605: 
 5606:       const Node *node = nodeBnd->node;
 5607:       const BoundarySegment *segment = nodeBnd->segment;
 5608:       const int iettype = segment->iettype;
 5609:       
 5610: 
 5611:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5612:       double eic = 0.0;
 5613:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5614:       else                 eic = 0.0;
 5615: 
 5616:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5617:       const double r_eth = ramp*nodeBnd->eth;
 5618:       double r_eta1_bar = 0.0;
 5619: 
 5620:       // Compute tide elevation
 5621:       if (iettype == 3 || iettype == 5) {   
 5622: 
 5623:          if constexpr(iloadtide==1) { // loading tide
 5624:             assert(false && "Loading tide not implemented");
 5625:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5626:          }
 5627:          
 5628:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5629: 
 5630:             const double efa  = nodeBnd->efa[jfr]; 
 5631:             const double emo  = nodeBnd->emo[jfr]; 
 5632: 
 5633:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5634:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5635:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5636: 
 5637: 
 5638:          } // for jfr
 5639: 
 5640:       } // if iettype
 5641: 
 5642:       switch (iettype) {
 5643:          case 1:
 5644:          case 2:
 5645:          case 4:
 5646:             nodeBnd->elbc = r_eic + r_eth;
 5647:             break;
 5648:          case 3:
 5649:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5650:             break;
 5651:          case 5:
 5652:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5653:             break;
 5654:       } // switch
 5655: 
 5656: 
 5657:       //Add inverse barometric effects
 5658:       if (iettype != 0 && inv_atm_bnd == 1) {
 5659:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5660:       }
 5661: 
 5662:    }
 5663: 
 5664: 
 5665:    __global__ void computeHorizontalViscosity(void) { 
 5666: 
 5667:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5668: 
 5669:       SIDE(side);
 5670: 
 5671:       if (side->isDry) return;
 5672: 
 5673:       for (int k = 0; k < nvrt; k++) {
 5674:          side->nuGradU[k] = {0.0, 0.0};
 5675:       }
 5676: 
 5677:       if constexpr(ihorcon == 1) {
 5678:          for (int k = side->kb; k < nvrt - 1; k++) {
 5679:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5680:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5681:             // By Zhang and Baptista.
 5682: 
 5683:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5684:             // This is a standard discretization of the Laplacian operator.
 5685:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5686:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5687:             // Gamma is hvis_coef0 in the code.
 5688:             // The value of gamma needs to be < 0.5.
 5689: 
 5690:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5691:             // side under consideration in each of the two possible elements that share the side.
 5692:             Vector2 sumU = {0.0, 0.0};
 5693:             for (int l = 0; l < 2; l++) {
 5694:                const Element *elem = side->elems[l];
 5695: 
 5696:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5697: 
 5698:                // Find the local index of the side in the element
 5699:                const int idxSide = elem->sideLocalIdx(side);
 5700: 
 5701:                // Find the two sides that are connected to the side under consideration
 5702:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5703:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5704: 
 5705:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5706: 
 5707:             }
 5708: 
 5709:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5710: 
 5711:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5712:    
 5713:          }
 5714:       }
 5715:       else if constexpr(ihorcon == 2) {
 5716:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5717:       }
 5718: 
 5719: 
 5720:    }
 5721: 
 5722: 
 5723:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5724: 
 5725:       // Set essential boundary conditions 
 5726:       NODE(node); // Each boundary node
 5727:       NodeBoundary *nodeBnd = node->nodeBnd;
 5728:       
 5729:  
 5730:       // Check if this node has essential BC
 5731:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5732: // printf("setEssentialBC: nodeBnd->isEssentialBC = true");
 5733:          // Verify BC value is valid
 5734:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5735: 
 5736:        
 5737:          // Set diagonal to 1 and zero off-diagonals
 5738:          node->coeffDiag = 1.0;
 5739: 
 5740:          for (int j = 0; j < node->numNodes; j++) {
 5741:                node->coeffMatrix[j] = 0.0;
 5742:          }
 5743: // printf("setEssentialBC: node->coeffMatrix = 0.0\n");         
 5744:          // Set solution and RHS to BC value
 5745:          node->mX  = nodeBnd->elbc;
 5746:          node->qel = nodeBnd->elbc;
 5747: // printf("setEssentialBC: node->qel = nodeBnd->elbc\n");
 5748:       } else {
 5749:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5750: // printf("setEssentialBC: nodeBnd->isEssentialBC = false ****, node = %p\n", node);
 5751:          for (int j = 0; j < node->numNodes; j++) {
 5752:                const Node* nbNode = node->nodes[j];
 5753:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 5754: 
 5755:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5756:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 5757: 
 5758:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5759:                   // Verify neighbor's BC value
 5760:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5761: // printf("setEssentialBC: node = %p\n", node);
 5762:                   // Subtract contribution to RHS
 5763:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5764:                   node->coeffMatrix[j] = 0.0;  
 5765:                }
 5766:          }
 5767: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 5768:       }
 5769:    }
 5770: 
 5771: 
 5772:    __global__ void updateElevation(void) {
 5773:       NODE(node);
 5774: 
 5775: 
 5776:       node->eta2 = node->mX;
 5777: 
 5778:       node->updateZCoordData();
 5779:    }
 5780: 
 5781: 
 5782:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5783: 
 5784:       SIDE(side);
 5785: 
 5786:       side->U = {0.0, 0.0}; 
 5787:          
 5788:       if(side->isDry) return;
 5789: 
 5790:       // Vertically integrated velocity U
 5791:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5792:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5793:          side->U += side->Dz(k + 1)*uc;  
 5794:       }
 5795: 
 5796:    }
 5797: 
 5798:    __global__ void computeBottomDragVegetation(void) {
 5799:       // UNFINISHED. CHECK THIS:
 5800:       // How many kernels are needed? Why so many for loops?
 5801:       // Is the loop on sides needed?
 5802: 
 5803:       NODE(node);
 5804: 
 5805: 
 5806:       const int    kb      = node->kb;
 5807:       const double htot    = node->htot2(); 
 5808:       
 5809:       if (node->isDry) {
 5810:          // Default values for dry nodes
 5811:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5812:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5813: 
 5814:          return;
 5815:        
 5816:       }
 5817: 
 5818:       // Computes bottom drag Cd based on the selected nchi
 5819:       node->computeBottomDragCd();
 5820:       
 5821: 
 5822: 
 5823:       //   Bottom stress in m^2/s^2
 5824:       if (node->rho[kb + 1] >= -98.0)
 5825:       {
 5826:          const double mag_u = length(node->u2[kb + 1]);
 5827:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5828: 
 5829:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5830:          // !sediment erosion: this part needs more documentation
 5831:       }
 5832:     
 5833: 
 5834: 
 5835:       // Compute vegetation parameters
 5836:       //--------------------------------
 5837: 
 5838:       // SAV constants
 5839:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5840:       constexpr double veg_cfpsi = 0.16;
 5841: 
 5842:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5843:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5844: 
 5845:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5846:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5847:          int kbin = 0; // bin index
 5848:          for (int k = kb; k < nvrt; k++) {
 5849:             // Computes node height above the bottom level
 5850:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5851:             assert(false && "Vertical variation of vegetation not implemented");
 5852: 
 5853:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5854:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5855:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5856:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5857:             // } else {
 5858:             //    // Find the bin at which the current vertical level is
 5859:             //    while (kbin<nbins_veg_vert) {
 5860:             //       const double zn = node->z[kbin];
 5861:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5862:             //          break;
 5863:             //       } // if
 5864:             //       kbin++;
 5865:             //    } // while
 5866:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5867: 
 5868:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5869:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5870:                
 5871:             //    // Linear interpolation of the vegetation parameters
 5872:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5873:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5874:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5875:             // } // if rl10
 5876: 
 5877:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5878: 
 5879:          } // for k
 5880: 
 5881: 
 5882:       } else { // Ganthy (iveg==2)
 5883:       //  Modify canopy height, diameter, and density
 5884: 
 5885:          // Make sure there is vegetation on this node
 5886:          if (node->veg_h_unbent > 0.0) {
 5887:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5888: 
 5889:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5890:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5891:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5892: 
 5893:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5894:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5895:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5896:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5897:          } // if veg_h_unbent
 5898: 
 5899:          for (int k = 0; k < nvrt; k++) {
 5900:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5901:          } // for k
 5902:       
 5903: 
 5904:       } // if iveg
 5905:      
 5906: 
 5907:       // Compute vertical mean of veg_alpha3D
 5908:       if (iveg != 0) {
 5909:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5910:          double sum1=0.0;
 5911:          double sum2=0.0;
 5912:          // Integrate over each level under the canopy...
 5913:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5914:             const double Dz = node->Dz(k);
 5915: 
 5916:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5917:             sum2 += Dz;
 5918: 
 5919:          } // for k
 5920:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5921:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5922: 
 5923:       } // if iveg
 5924: 
 5925:    }
 5926: 
 5927:    __global__ void computeVegetationAndDragParameters(void) {
 5928:       // Computes the vegetation and drag model parameters:
 5929:       // chi, \tilde\chi, beta, \breve{H}
 5930:       
 5931:       SIDE(side);
 5932: 
 5933:       side->hhat = 0.0;
 5934:       side->chi2 = 0.0;
 5935:       side->chi = 0.0;
 5936:       side->veg_c2 = 0.0;
 5937:       side->veg_beta = 0.0;
 5938: 
 5939:       if (side->isDry) return;
 5940: 
 5941:       const double htot = side->htot2();
 5942:       const int    kb   = side->kb;
 5943: 
 5944:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5945: 
 5946:       const double veg_h     = side->veg_h();
 5947:       const double veg_nv    = side->veg_nv();
 5948:       const double veg_c     = side->veg_c();
 5949:       const double veg_beta  = side->veg_beta;
 5950:       const double veg_alpha = side->veg_alpha_vert_mean();
 5951: 
 5952:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5953:       // Velocity magnitude at the bottom level
 5954:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5955:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5956:       side->chi2 = side->Cd()*vmag1;
 5957:       side->chi  = side->chi2;
 5958: 
 5959:       if constexpr(iveg != 0) {
 5960:          const Node *n1 = side->n1;
 5961:          const Node *n2 = side->n2;
 5962:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5963:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5964:       }
 5965: 
 5966:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5967: 
 5968:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5969:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5970:       double magUa = 0.0;
 5971:       if constexpr(iveg != 0) {
 5972:          if (side->is3D() && veg_h > 0.0) {
 5973:             // 3D wet side with veg...
 5974: 
 5975:             double magUa = 0.0;
 5976:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5977:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5978: 
 5979:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5980:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5981:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5982: 
 5983:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5984:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5985: 
 5986:                   // Velocity magnitude at the bottom (l) of the level
 5987:                   const double ul = length(side->u2[k]);
 5988: 
 5989:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5990:                   magUa += Dz*0.5*(uh + ul);
 5991: 
 5992:                } // if HasVegetation
 5993:             } // for k
 5994:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5995: 
 5996:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5997:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5998:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5999:                const double zCpy = side->zTopCanopy();
 6000:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6001:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6002:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6003:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6004:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6005:             } // if isSubmerged
 6006:          } // if is3D
 6007:       } // if iveg   
 6008: 
 6009:       // Computes the friction modified depth, \breve{H} in notes
 6010:       if (side->is2D()) { // 2D
 6011: 
 6012:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6013:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6014: 
 6015:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6016: 
 6017:          side->hhat = htot*htot/fricH; 
 6018: 
 6019:       } else { // 3D
 6020:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6021: 
 6022:          if constexpr(iveg != 0) {
 6023:             
 6024:             if (side->isSubmerged()) { 
 6025:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6026:                side->hhat -= veg_c*Hhat_alpha;
 6027: 
 6028:             } else { // Emergent
 6029:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6030:             }
 6031:          } // if iveg
 6032: 
 6033:          // Enforce positivity for 3D model
 6034:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6035:       } // if 3D
 6036: 
 6037:    }
 6038: 
 6039: 
 6040: 
 6041:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6042:    // Computes the density gradient between two elements, e1 and e2.
 6043:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6044:    // zero in the direction normal to the side. 
 6045:    // 
 6046:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6047:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6048:    //
 6049:    // Input:
 6050:    //    e1: Element
 6051:    //    e2: Neighbor element (or nullptr if boundary)
 6052:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6053:    //    k: Index of the half-level at which the density is interpolated
 6054:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6055:    // 
 6056:    // Output:
 6057:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6058:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6059: 
 6060:       if (e2 == nullptr || e2->isDry) {
 6061:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6062: 
 6063:          Side *side = e1->sides[j];
 6064:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6065:                  
 6066:          if constexpr(ics == 1) {
 6067:             vec = side->n; // Normal vector to the side
 6068:          } else {
 6069:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6070:             // IMPLEMENT THIS XXXXXX
 6071:             // !replace with xel, yel?
 6072:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6073:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6074:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6075:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6076:          } //ics
 6077:                    
 6078:          diffRho = 0.0;
 6079: 
 6080:       } else { //internal and wet
 6081:          if constexpr(ics==1) {
 6082:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6083: 
 6084:             // Vector from e1 to e2
 6085:             vec = e2->center - e1->center;
 6086: 
 6087:          } else { 
 6088:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6089:             // Remember that elem->center is in global coordinates
 6090:             // IMPLEMENT THIS XXXXXX
 6091:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6092:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6093:             //                   alow(j)=xctr2
 6094:             //                   bdia(j)=yctr2
 6095:          } // ics
 6096: 
 6097:          diffRho = rho2 - e1->demeanedDensity(k);
 6098:       }
 6099: 
 6100:    }
 6101: 
 6102:    __global__ void computeDensityCubicSplines(void) {
 6103:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6104: 
 6105:       ELEM(elem);
 6106: 
 6107:       if (elem->isDry) return;
 6108: 
 6109:       const int kb = elem->kb;
 6110: 
 6111:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6112:       if (elem->is2D()) {
 6113:          // In the 2D case, the density is constant at the prism level. 
 6114:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6115:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6116:       } else { //3D
 6117: 
 6118:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6119:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6120:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6121:          ///// XXXX CHECK INDICES!!!!!
 6122:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6123:       } // 2D/3D
 6124: 
 6125:    }
 6126: } // extern "C"
 6127: 
 6128: 
 6129: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6130: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6131: 
 6132:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6133: 
 6134:    const int kb  = elem->kb;
 6135:    const int kb2 = elem2->kb;
 6136: 
 6137:    // z-coordinate of prism of elem
 6138:    const double zp = elem->z_prism(k);
 6139: 
 6140:    double rho = 0.0;
 6141: 
 6142:    if (elem2->is2D()) {
 6143:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6144: 
 6145:    } else {  // 3D
 6146: 
 6147:       // eta_min may be < zmax
 6148:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6149:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6150: 
 6151:       // (Extrapolate density below bottom, we will fix it later)
 6152:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6153:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6154:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6155:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6156:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6157:    } // 2D/3D
 6158:      
 6159: 
 6160:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6161:    // Now we need to fix it.
 6162:    if (elem->z[k] < elem2->z[kb2]) {
 6163:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6164: 
 6165:       // There are two methods to adjust the density at the bottom of the element.
 6166:       // iunder_deep=0: 
 6167:       const double depth1 = abs(elem->z[kb]); // larger depth
 6168: 
 6169:       if (iunder_deep==0) {
 6170: 
 6171:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6172: 
 6173:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6174: 
 6175:       } else { // iunder_deep != 0
 6176: 
 6177:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6178: 
 6179:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6180: 
 6181:          //   Demeaned density at the same z coordinate as
 6182:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6183:          }
 6184: 
 6185:       } // if iunder_deep
 6186:    } // if elem->z[kb] < elem2->z[kb]
 6187: 
 6188:    return rho;
 6189: }
 6190: 
 6191: 
 6192: extern "C" {
 6193:    __global__ void computeDensityGradient(void) {
 6194: 
 6195:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6196:       if constexpr(ibc != 0) return;
 6197: 
 6198:          // Compute the horizontal density gradient at each element.
 6199:       // It works in two steps:
 6200:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6201:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6202:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6203:       //             gradRho.r1 = rho1 - rho0
 6204:       //             gradRho.r2 = rho2 - rho0
 6205:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6206:       // 
 6207:       //  NOTE: We use de-meaned densities.
 6208: 
 6209:       ELEM(elem);
 6210: 
 6211:       if (elem->isDry) return;
 6212: 
 6213:       const int kb  = elem->kb;
 6214:       const int i34 = elem->i34;
 6215: 
 6216:       for (int k = kb + 1; k < nvrt; k++) {
 6217:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6218:          //             gradRho.r1 = rho1 - rho0
 6219:          //             gradRho.r2 = rho2 - rho0
 6220:          int icount = 0;
 6221:          double sumRx = 0.0;
 6222:          double sumRy = 0.0;
 6223:          for (int j1=0; j1<i34; j1++) { 
 6224: 
 6225:             const int j2 = elem->nxq(j1 + 1);
 6226: 
 6227:             // Pairs of consecutive neighbor elements of elem
 6228:             const Element *e1 = elem->nghbElems[j1];
 6229:             const Element *e2 = elem->nghbElems[j2];
 6230: 
 6231:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6232:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6233:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6234: 
 6235:             // Compute the density difference and the vector from elem to e1 and e2
 6236:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6237:             double diffRho1, diffRho2;
 6238:             Vector2 vec1, vec2;
 6239:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6240:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6241: 
 6242:             const double rl1 = length(vec1);
 6243:             const double rl2 = length(vec2);
 6244:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6245: 
 6246:             const double delta = cross(vec1, vec2);
 6247:             const double sintheta = abs(delta)/(rl1*rl2);
 6248: 
 6249:             // To avoid problems, avoid elements with small angle between vectors
 6250:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6251:             const bool validEq = (sintheta > sin_one_deg);
 6252: 
 6253:             if (validEq) {
 6254:                // Solve the system of equations to get the density gradient at elem
 6255:                icount++;
 6256:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6257:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6258:                sumRx += Rx;
 6259:                sumRy += Ry;
 6260:             }
 6261:          } // for j1
 6262: 
 6263:          // Compute the average density gradient at elem
 6264:          if (icount==0) {
 6265:            // Bad mesh quality; bail out with 0 b-cc
 6266:            elem->gradRho[k] = {0.0, 0.0};
 6267:          } else {
 6268:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6269:          }
 6270: 
 6271:       } // for k
 6272: 
 6273:    }
 6274: 
 6275:    __global__ void computeBaroclinicTerm(void) {
 6276:    // Computes the baroclinic term at sides (at half levels).
 6277:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6278:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6279: 
 6280:       if (ibc == 1) return;
 6281: 
 6282:       SIDE(side);
 6283: 
 6284:       if (side->isDry) return;
 6285: 
 6286:       const Element *e1 = side->elems[0];
 6287:       const Element *e2 = side->elems[1]; 
 6288:       const int kb = side->kb;
 6289:       
 6290:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6291: 
 6292:       // interpolates vertically the density gradient of the two elements at the half level/
 6293: 
 6294:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6295:       int k2 = max(kb, nvrt / 2);
 6296: 
 6297:       // Starts the integration at the surface and goes down to the bottom
 6298:       side->bcc[nvrt-1] = {0.0, 0.0};
 6299:       for (int k = nvrt - 2; k >= kb; k--) {
 6300:       // For each prism level (from surface to bottom)...
 6301: 
 6302:          // For both elements, interpolate density gradient at the side's half level.
 6303:          // The gradient at the side is the average of the gradients at the elements.
 6304:          // w1, w2 are used to take into account boundary sides, with just one element.
 6305:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6306:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6307:          const double wsum = w1 + w2;
 6308:          w1 = w1/wsum;
 6309:          w2 = w2/wsum;
 6310:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6311: 
 6312:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6313:          Vector2 gradRho = {0.0, 0.0};
 6314:          if (e1 != nullptr && k > kb) {
 6315:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6316:             
 6317:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6318:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6319:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6320: 
 6321:             // Grad(rho) vertically interpolated at the side's half level
 6322:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6323: 
 6324:             // Projects the element density gradient to the side frame if needed.
 6325:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6326: 
 6327:             // Adds the contribution of the density gradient at the side's half level
 6328:             gradRho += gradRho1*w1;
 6329:          }      
 6330:          if (e2 != nullptr && k > kb) {
 6331:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6332:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6333:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6334:             
 6335:             // Grad(rho) vertically interpolated at the side's half level
 6336:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6337: 
 6338:             // Projects the element density gradient to the side frame if needed.
 6339:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6340: 
 6341:             // Adds the contribution of the density gradient at the side's half level
 6342:             gradRho += gradRho2*w2;
 6343:          }
 6344: 
 6345:          
 6346:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6347:          // multiplied by -rampbc*(g/rho0) 
 6348:          const double grav3 = side->grav3();
 6349:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6350: 
 6351:       } // for
 6352: 
 6353:    }
 6354: 
 6355: 
 6356: 
 6357:    __global__ void computeHorGradientAtSide(void) {
 6358: 
 6359:       // Compute the horizontal density gradient at each element.
 6360:       // It works in two steps:
 6361:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6362:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6363:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6364:       //             gradRho.r1 = rho1 - rho0
 6365:       //             gradRho.r2 = rho2 - rho0
 6366:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6367:       // 
 6368:       //  NOTE: We use de-meaned densities.
 6369: 
 6370:       SIDE(side);
 6371: 
 6372: 
 6373:       if (side->isDry) return;
 6374: 
 6375:       // Computes the gradient of the variables at the side center.
 6376:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6377:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6378:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6379: 
 6380:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6381:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6382:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6383:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6384: 
 6385:    }
 6386: 
 6387: 
 6388:    __global__ void solveMomentumEquations(double time) {
 6389: 
 6390:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6391:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6392: 
 6393:       SIDE(side);
 6394: 
 6395:       if (side->isDry) 
 6396:       {
 6397:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6398: 
 6399:          return;
 6400:       }
 6401: 
 6402:       const Node *n1 = side->n1;
 6403:       const Node *n2 = side->n2;
 6404: 
 6405:       const int kb = side->kb;
 6406: 
 6407:       const double veg_h = side->veg_h();
 6408:       const double grav3 = side->grav3();
 6409: 
 6410:       if (side->is2D()) {
 6411:          // Remember: Do not use htot2, which is updated.
 6412:          const double htot = side->htot1();
 6413:          const double hhat = side->hhat;
 6414: 
 6415:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6416: 
 6417:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6418:          const Vector2 tau2 = side->tau();
 6419: 
 6420:          // hat_gam has units of m/s
 6421: 
 6422:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6423:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6424:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6425: 
 6426:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6427: 
 6428: 
 6429:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6430: 
 6431:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6432: 
 6433:       }
 6434:       else { // 3D
 6435: 
 6436:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6437:          // 
 6438:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6439:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6440:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6441:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6442:          // k+1 and k.
 6443: 
 6444: 
 6445:          const int ndim = nvrt - kb;
 6446:          const double zTopCanopy = side->zTopCanopy();
 6447: 
 6448:          // Initialize the tridiagonal system
 6449:          for (int k = kb + 1; k < nvrt; k++) {
 6450:             
 6451:             const int kin = k - (kb + 1);
 6452: 
 6453:             // Vertical viscosity at the face center
 6454:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6455: 
 6456:  
 6457:             alow[kin] = 0.0;
 6458:             cupp[kin] = 0.0;
 6459:             bdia[kin] = 0.0;
 6460: 
 6461:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6462:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6463: 
 6464:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6465:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6466:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6467: 
 6468:             // First part: layers k, k+1
 6469:             if (k < nvrt - 1) {
 6470:                              
 6471:                if constexpr(iveg != 0) {
 6472: 
 6473:                   // If there is vegetation at this level...
 6474:                   if (zTopCanopy > side->zc[k]) {
 6475:                      // If the canopy is above the k layer...
 6476:                      
 6477:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6478:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6479:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6480:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6481: 
 6482:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6483:                      const double vmag2 = length(ut2);
 6484:                      const double vmag1 = length(side->u2[k]);
 6485:                      const double vmag = 0.5*(vmag1 + vmag2);
 6486:                      
 6487:                      // Computes the vegetation alpha at the face center
 6488:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6489: 
 6490:                      cff1 += veg_alpha_sd*dt*vmag;
 6491: 
 6492:                   } // if (zTopCanopy
 6493:                } // if iveg
 6494: 
 6495:                const double dzz = side->Dz(k + 1);
 6496:                const double tmp = dt*dfz/dzz;
 6497:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6498: 
 6499:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6500:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6501:             }
 6502: 
 6503: 
 6504:             // Second part: layers k-1, k
 6505:             if (k > kb + 1) {
 6506: 
 6507:                double cff1 = 1.0; //init \bar{c^k}
 6508: 
 6509:                if constexpr(iveg != 0) {
 6510:                   // If there is vegetation at this level...
 6511:                   if (zTopCanopy > side->zc[k-1]) {
 6512:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6513:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6514: 
 6515:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6516: 
 6517:                      const double vmag2 = length(ut2);
 6518:                      const double vmag1 = length(side->u2[k-1]);
 6519:                      const double vmag = 0.5*(vmag1 + vmag2);
 6520: 
 6521:                      // Computes the vegetation alpha at the face center
 6522:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6523:                      cff1 += veg_alpha_sd*dt*vmag;
 6524:                   } // if zTopCanopy
 6525: 
 6526:                } // if iveg
 6527: 
 6528:                const double dzz = side->Dz(k);
 6529:                const double tmp = dt*dfz/dzz;
 6530:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6531: 
 6532:                alow[kin] += cff1*dzz/6.0 - tmp;
 6533:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6534: 
 6535:             } else { // Bottom boundary
 6536:                // This occurs at the bottom, where the bottom drag is applied.
 6537: 
 6538:                bdia[kin] += dt*side->chi2; // XXXX
 6539: 
 6540:             } // if (k > kb + 1)
 6541: 
 6542: 
 6543:          } // for (int k
 6544: 
 6545: 
 6546: 
 6547:          // Computes the RHS.
 6548:          // -----------------
 6549: 
 6550:          //	BC to be imposed at the end.
 6551: 
 6552:          const Vector2 gradETP  = side->gradETP;
 6553:          const Vector2 gradPr   = side->gradPr;
 6554:          const Vector2 gradEta1 = side->gradEta1;
 6555:          const Vector2 gradEta2 = side->gradEta2;
 6556: 
 6557:          const Vector2 *btu = side->btu;
 6558:          const Vector2 *u2  = side->u2;
 6559:          const double coriolis = side->coriolis;
 6560:          const Vector2 *nuGradU = side->nuGradU;
 6561: 
 6562:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6563:          for (int k = kb + 1; k < nvrt; k++) {
 6564:             const int kin = k - kb - 1;
 6565: 
 6566:             const double dz_0 = side->Dz(k);
 6567:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6568: 
 6569:             rrhs[kin] = {0.0, 0.0};
 6570:             double dz = 0.0;
 6571: 
 6572:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6573:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6574:             if (k < nvrt  ) dz += dz_1;
 6575:             if (k > kb + 1) dz += dz_0;
 6576: 
 6577:             // Elevation gradient, atmospheric pressure and tidal potential
 6578:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6579: 
 6580:             // Coriolis, advection, wind stress, and horizontal viscosity
 6581:             if (k < nvrt - 1) {
 6582: 
 6583: 
 6584:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6585:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6586:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6587:                                                 
 6588: 
 6589:                //diff stress tensors 1006
 6590:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6591:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6592:                   assert(false && "Not implemented: itur == 5");
 6593:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6594:                }
 6595:                // else assert(false && "itur # Not implemented");
 6596: 
 6597:             } else { // k == nvrt - 1 SURFACE
 6598:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6599:                const Vector2 tau2 = side->tau();
 6600: 
 6601:                rrhs[kin] += dt*tau2;          
 6602: 
 6603:             } // if k<nvrt
 6604: 
 6605: 
 6606:             if (k > kb + 1) {
 6607:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6608:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6609:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6610: 
 6611:                // diff stress tensors 1006
 6612:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6613:                   assert(false && "Not implemented: itur == 5");
 6614:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6615:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6616:                }
 6617:                // else assert(false && "itur # Not implemented");
 6618: 
 6619: 
 6620:             } // if k>kbs + 1
 6621: 
 6622:             // Baroclinic
 6623:             Vector2 *bcc = side->bcc;
 6624:             if constexpr(ibc == 0) {
 6625:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6626:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6627: 
 6628:             } // if ibc==0
 6629: 
 6630:          } // k=kb + 1,nvrt
 6631: 
 6632: 
 6633:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6634: 
 6635:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6636:             const int kin = k - kb - 1;
 6637:    
 6638:             // Velocity is always clamped to maximum values
 6639:             side->u2[k] = clampVelocity(soln[kin]);
 6640:          } // k
 6641: 
 6642:       } // if side->is2D()
 6643:       
 6644: 
 6645:       // Impose velocity boundary condition at the bottom
 6646:       if constexpr(imm == 2) { // 3D bed deformation model
 6647:          double dep;
 6648:          Vector2 vel;
 6649: 
 6650:          assert(false && "Not implemented: imm == 2");
 6651:          //update_bdef(time, x0, y0, dep, vel);
 6652:          // side->u2[kb] = vel;
 6653: 
 6654:       } else { // imm = 0 or 1
 6655:          if (side->Cd() == 0.0) {
 6656:             side->u2[kb] = side->u2[kb + 1];
 6657: 
 6658:          } else if (side->is3D()) { // 3D no slip bottom   
 6659:             side->u2[kb] = {0.0, 0.0};
 6660: 
 6661:          }
 6662:           
 6663:       } // if imm
 6664: 
 6665:       // The velocities below the bottom level are set to zero
 6666:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6667: 
 6668: 
 6669:    }
 6670: 
 6671: 
 6672:    __global__ void applyMomentumBC(void) {
 6673: 
 6674:       SIDE_BND(sideBnd);
 6675: 
 6676:       Side *side = sideBnd->side;
 6677:       const BoundarySegment *segment = sideBnd->segment;
 6678:       const Node *n1 = side->n1;
 6679:       const Node *n2 = side->n2;
 6680: 
 6681:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6682: 
 6683:       const bool isLand = segment->isLand;
 6684:       const int ifltype = segment->ifltype;
 6685: 
 6686:       const int kb = side->kb;
 6687: 
 6688: 
 6689:       if (!isLand && ifltype != 0) {
 6690:          const Vector2 *ubc = sideBnd->ubc;
 6691:   
 6692:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6693:             
 6694:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6695:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6696: 
 6697:             if (ifltype == -1) {
 6698:                // Flather 1
 6699: 
 6700:                const double depth = side->depth();
 6701: 
 6702:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6703: 
 6704:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6705: 
 6706:                side->u2[k] = vnorm*side->n;
 6707: 
 6708:             } else if (ifltype == -2) { // Discharge
 6709: 
 6710:                const double eta1 = side->eta1();
 6711:                const double eta2 = side->eta2();
 6712:                const double htot = side->htot2();
 6713: 
 6714:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6715:                assert(false && "Not implemented: Discharge bc");
 6716:                // const double dischrg = discharge(eta1);
 6717:                const double dischrg = 0.0; // XXX REMOVE
 6718:                
 6719: 
 6720:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6721: 
 6722:                const double vnorm = dischrg*eta2/htot;
 6723: 
 6724:                side->u2[k] = vnorm*side->n;
 6725: 
 6726:             }
 6727:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6728:                const double vnorm = dot(side->u2[k], side->n);
 6729: 
 6730:                double rat;
 6731:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6732:                else              rat = segment->vobc2; // outgoing
 6733: 
 6734:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6735: 
 6736:             }
 6737:             else { // not Flather or 3D radiation
 6738:                side->u2[k] = ubc[k];
 6739: 
 6740:             } // if (segment->ifltype...
 6741: 
 6742:          }
 6743: 
 6744:       }
 6745:       else if (isLand) { // if it is land boundary side
 6746: 
 6747:          if constexpr(islip == 0) { // free slip
 6748: 
 6749:             for (int k = kb; k < nvrt; k++) {
 6750: 
 6751:                const Vector2 t = side->t();
 6752:                const Vector2 n = side->n;
 6753: 
 6754:                double vnorm = 0.0; // for most cases
 6755:                const double vtan = dot(side->u2[k], t);
 6756:                
 6757:                side->u2[k] = vtan*t - vnorm*n;
 6758: 
 6759:             }
 6760: 
 6761:          } else { // no slip
 6762:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6763: 
 6764:          }
 6765:       } // if (side segment type...
 6766: 
 6767:    }
 6768: 
 6769: 
 6770:    __global__ void shapiroFilter1(void) {
 6771:       // First step of the Shapiro filter (normally used if indvel<=0)
 6772:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6773: 
 6774:       SIDE(side);
 6775: 
 6776:       // Only internal wet sides are processed
 6777:       if (side->isDry || !(side->isInternal())) return;
 6778: 
 6779:       const int kb = side->kb;
 6780: 
 6781:       for (int mm = 0; mm < niter_shap; mm++) {
 6782: 
 6783:          for (int k = kb + 1; k < nvrt; k++) {
 6784:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6785:             Vector2 suru = {0.0, 0.0};
 6786: 
 6787:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6788: 
 6789:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6790: 
 6791:                int kin = k;
 6792:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6793:                
 6794:                // Get the velocity at the neighbor's side.
 6795:                Vector2 nSideU2 = nSide->u2[kin];
 6796: 
 6797:                // Projects the velocity to the current side frame if needed.
 6798:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6799: 
 6800:                suru += nSideU2;
 6801:             }
 6802: 
 6803:             // Reusing bcc as a temporary array to store the suru values.
 6804:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6805: 
 6806:          }
 6807:       }
 6808:    }
 6809: 
 6810:    __global__ void shapiroFilter2(void) {
 6811:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6812: 
 6813:       SIDE(side);
 6814: 
 6815: 
 6816:       if (side->isDry || !(side->isInternal())) return;
 6817: 
 6818:       const int kb = side->kb;
 6819: 
 6820:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6821: 
 6822:       if (side->is2D()) {
 6823:          side->u2[kb + 1] = side->bcc[kb + 1];
 6824:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6825: 
 6826:       } else {
 6827:          // 3D
 6828:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6829:          
 6830:       }
 6831: 
 6832:    }
 6833: 
 6834: 
 6835:    __global__ void ul0UpdateZCoords(void) {
 6836:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6837:       
 6838:       NODE(node);      
 6839: 
 6840: 
 6841:       if (false) { //node->isDry) { XXXXXXX
 6842: 
 6843:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6844: 
 6845:          if constexpr(ivcor != 1) node->kb = 0;
 6846: 
 6847:       } else {
 6848: 
 6849:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6850:          node->updateKb();
 6851: 
 6852:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6853: 
 6854:       }
 6855: 
 6856:       // We use the temp.b field to store the previous state of isDry.
 6857:       node->tmp.b = node->isDry;
 6858: 
 6859:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6860:       node->isDry = true;
 6861: 
 6862:    }
 6863: 
 6864:    __global__ void ul0ComputeDryElements(void)
 6865:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6866:    {
 6867:       ELEM(elem);
 6868: 
 6869:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6870: 
 6871:       elem->kb = 0;
 6872: 
 6873:       if (elem->isDry) return;
 6874: 
 6875: 
 6876:    //    if(elem->isDry2()) { // XXXX
 6877:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6878:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6879:    //        call parallel_abort(errmsg)
 6880:    //    }
 6881: 
 6882:       const Node *n1 = elem->nodes[0];
 6883:       const Node *n2 = elem->nodes[1];
 6884:       const Node *n3 = elem->nodes[2];  
 6885:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6886: 
 6887:       // Computes element's kb as the minimum of the nodes' kb.
 6888:       const int kb1 = n1->kb;
 6889:       const int kb2 = n2->kb;
 6890:       const int kb3 = n3->kb;
 6891:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6892: 
 6893: 
 6894:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6895: 
 6896: 
 6897:       // Computes the element z as the mean of the nodes z.
 6898:       for (int k = elem->kb; k < nvrt; k++) {
 6899: 
 6900:          // Compute the element z as the mean of the nodes z.
 6901:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6902:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6903:          elem->z[k] /= elem->i34;
 6904: 
 6905:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6906:       }
 6907:                   
 6908:    }
 6909: 
 6910:    __global__ void ul0ComputeDryNodes(void)
 6911:    // Updates node's isDry based on the elements' isDry. 
 6912:    {
 6913:       NODE(node);
 6914: 
 6915:       node->isDry = true;
 6916: 
 6917:       // A node is wet if at least one of the elements sharing it is wet.
 6918:       for (int j = 0; j < node->numElements; j++) {
 6919:          const Element *elem = node->elements[j];
 6920:          if (!elem->isDry) {
 6921:             node->isDry = false;
 6922:             break;
 6923:          }
 6924:       }
 6925: 
 6926:        
 6927:    }
 6928: 
 6929: 
 6930:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6931:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6932:    // node->tmp.b is true if the node was previously dry.
 6933:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6934:    {
 6935:       NODE(node);
 6936:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6937: 
 6938:       // Avoid this the first time step.
 6939:       if (it == iths) return;  
 6940: 
 6941:       const bool wasDry = node->tmp.b;
 6942: 
 6943: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6944: 
 6945:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6946: 
 6947:          for (int k=0; k < nvrt; k++) {
 6948: 
 6949:             Vector3 utmp={0.0, 0.0, 0.0};
 6950: 
 6951:             double ttmp=0.0;
 6952:             double stmp=0.0;
 6953:             int icount=0;
 6954:             for (int j = 0; j < node->numNodes; j++) {
 6955: 
 6956:                const Node *nbrNode = node->nodes[j];
 6957:                
 6958:                const bool wasNbrDry = nbrNode->tmp.b;
 6959: 
 6960:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6961:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6962: 
 6963:                   icount++;
 6964: 
 6965:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6966:                   utmp += nbrNode->uvw2(k);
 6967:                   
 6968:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6969:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6970:                }
 6971:             }
 6972: 
 6973:             if (icount > 0) {
 6974:                const double inv_icount = 1.0/icount;
 6975:                utmp = inv_icount*utmp;
 6976:                node->u2[k]     = {utmp.x, utmp.y};
 6977:                node->w2[k]     = utmp.z;
 6978:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6979:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6980:             } else {
 6981:                node->u2[k] = {0.0, 0.0};
 6982:                node->w2[k] = 0.0;
 6983:                // Initialize tracers to 0.0??? XXXXX
 6984:             }
 6985:          }
 6986:       }
 6987:    }
 6988: 
 6989:   
 6990:    
 6991: 
 6992: 
 6993:    __global__ void ul0UpdateSides(int it, int iths) {
 6994:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6995:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6996:    // The dryness of the sides is updated in ul0UpdateSides2.
 6997: 
 6998:       SIDE(side);
 6999: 
 7000:       // A side is wet if and only if at least one of its elements is wet.
 7001:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7002:  
 7003:       const Node *n1 = side->n1;
 7004:       const Node *n2 = side->n2;
 7005:      
 7006:       const int kb1 = n1->kb;
 7007:       const int kb2 = n2->kb;
 7008: 
 7009:       side->kb = 0; // default when dry
 7010: 
 7011:       if (isWet) {
 7012: 
 7013:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7014: 
 7015:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7016: 
 7017:          side->kb = min(kb1, kb2);
 7018: 
 7019:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7020: 
 7021:          for (int k = side->kb; k < nvrt; k++) {
 7022:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7023: 
 7024:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7025: 
 7026:             // Compute velocity for re-wetted sides 
 7027:             if ((it != iths) && (side->isDry && isWet)) {
 7028: 
 7029:                Vector2 utmp={0.0, 0.0};
 7030: 
 7031:                int icount=0;
 7032: 
 7033:                // For all the sides on the two elements that share this side
 7034:                for (int j = 0; j < 2; j++) {
 7035:                   const Element *elem = side->elems[j];
 7036:                   if (elem == nullptr) continue;
 7037: 
 7038:                   for (int jj=0; jj < elem->i34; jj++) {
 7039:                      const Side *nSide = elem->sides[jj];
 7040:                      if (nSide->isDry) continue;
 7041: 
 7042:                      icount++;
 7043:                      utmp += nSide->u2[k];  
 7044:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7045:                   }
 7046:                }
 7047:                   
 7048:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7049:                if (icount > 0)  side->u2[k] = utmp/icount;
 7050:                else             side->u2[k] = {0.0, 0.0};
 7051:                   
 7052:             } // if ((it != iths) && (side->isDry && isWet))
 7053: 
 7054:          } // for k
 7055: 
 7056:       } // if isWet 
 7057:       
 7058: 
 7059: 
 7060:    }
 7061: 
 7062:    __global__ void ul0UpdateSides2(void) {
 7063:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7064:    
 7065:          SIDE(side);
 7066:    
 7067:          const Element *e1 = side->elems[0];
 7068:          const Element *e2 = side->elems[1];
 7069: 
 7070:          // A side is wet if and only if at least one of its elements is wet.
 7071:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7072: 
 7073:          // Update the side's dryness
 7074:          side->isDry = !isWet;
 7075: 
 7076:    }
 7077: 
 7078: 
 7079:    __global__ void zeroNodalVelocities(void) {
 7080:       NODE(node);
 7081: 
 7082:       for (int k = 0; k < nvrt; k++) {
 7083:          node->u2[k]   = {0.0, 0.0};
 7084:          node->w2[k]   = 0.0;
 7085:          node->utmp[k] = {0.0, 0.0};         
 7086:       }
 7087:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7088:    }
 7089:  
 7090: 
 7091:    __global__ void computeNodalVerticalVelocities1(void) {
 7092:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7093:    // Adds the element's vertical velocity times the element's area.
 7094:       ELEM(elem);
 7095: 
 7096:       for (int j = 0; j < elem->i34; j++) {
 7097:          Node *node = elem->nodes[j];
 7098: 
 7099:          for (int k = node->kb; k < nvrt; k++) {
 7100:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7101:          }
 7102:          atomicAdd(&(node->tmp.d), elem->area);
 7103:       }
 7104:    }
 7105: 
 7106:    __global__ void computeNodalVerticalVelocities2(void) {
 7107:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7108:    // Divides by the total area of the elements sharing the    node.
 7109:       NODE(node);
 7110: 
 7111: 
 7112:       const double invArea = 1.0 / node->tmp.d;
 7113:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7114: 
 7115:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7116:    }
 7117: 
 7118: 
 7119:    __global__ void computeNodalHorizontalVelocities1(void) {
 7120: 
 7121:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7122: 
 7123:       ELEM(elem);
 7124: 
 7125:       if (elem->isDry) return;
 7126: 
 7127:       const int kb = elem->kb;
 7128:       const bool isTri = elem->isTri();
 7129: 
 7130:       if constexpr(indvel <= 0) {
 7131:          // Assuming discontinous hvel.
 7132: 
 7133:          if (isTri) { // For triangles
 7134:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7135:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7136:             #pragma unroll
 7137:             for (int j = 0; j < 3; j++) {
 7138:                // For every node of the triangle...
 7139:                Node *node = elem->nodes[j];
 7140: 
 7141:                if (node->isDry) continue;
 7142: 
 7143:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7144:                const Side *s2 = elem->sides[(j + 1) % 3];
 7145:                const Side *s3 = elem->sides[(j + 2) % 3];
 7146: 
 7147:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7148: 
 7149:                atomicAdd(&(node->tmp.i), 1);
 7150: 
 7151:                for (int k = kb; k < nvrt; k++)  {
 7152:                   Vector2 s1u2 = s1->u2[k];
 7153:                   Vector2 s2u2 = s2->u2[k];
 7154:                   Vector2 s3u2 = s3->u2[k];
 7155: 
 7156:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7157:                   if constexpr(ics == 2) {
 7158:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7159:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7160:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7161:                   }
 7162: 
 7163:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7164:                   u = clampVelocity(u);
 7165:                   atomicAdd(&(node->utmp[k].x), u.x);
 7166:                   atomicAdd(&(node->utmp[k].y), u.y);
 7167: 
 7168:                }
 7169: 
 7170:             }
 7171:          }
 7172:          else { // For quads
 7173: 
 7174: 
 7175:             // Compute the bilinear coordinates of the center of each diagonal.
 7176:             double xi, eta;
 7177:             double shp13[4], shp24[4];
 7178:             Point2 x0, x1, x2, x3;
 7179:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7180:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7181:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7182: 
 7183:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7184:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7185: 
 7186: 
 7187: 
 7188: 
 7189:             for (int k = kb; k < nvrt; k++) {
 7190: 
 7191:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7192:                Vector2 sideU[4];
 7193:                #pragma unroll
 7194:                for (int j = 0; j < 4; j++) {
 7195:                   Vector2 u = elem->sides[j]->u2[k];
 7196:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7197:                   sideU[j] = u;
 7198:                }
 7199: 
 7200:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7201:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7202: 
 7203:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7204:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7205:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7206:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7207:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7208:                #pragma unroll
 7209:                for (int j = 0; j < 4; j++) {
 7210:                   Node *node = elem->nodes[j];
 7211:                   if (node->isDry) continue;
 7212: 
 7213:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7214:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7215:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7216:                }
 7217:             }
 7218: 
 7219:          }
 7220: 
 7221:       }
 7222:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7223:       
 7224:    }
 7225: 
 7226: 
 7227:    __global__ void computeNodalHorizontalVelocities2(void) {
 7228:       NODE(node);
 7229: 
 7230:       const int nodeCount = node->tmp.i;
 7231: 
 7232:       if (nodeCount == 0) 
 7233:       {
 7234:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7235:          return;
 7236:       }
 7237: 
 7238:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7239:       
 7240:       const int kb = node->kb;
 7241: 
 7242:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7243:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7244:       
 7245:       
 7246:    }   
 7247: 
 7248:  
 7249: 
 7250:    __global__ void resetVelocityOpenBndNodes(void) {
 7251:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7252: 
 7253:       NODE_BND(nodebnd);
 7254: printf("DDDDDDDDDD\n");  // XXXXXXX
 7255:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7256:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7257:       }
 7258: 
 7259:    }
