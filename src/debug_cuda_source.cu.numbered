 1785: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1786:    // Computes the 3D normal vector to the element at level k
 1787:    // Returns the normal vector and the area of the element
 1788: 
 1789:       if (isTri()) {
 1790:          // For triangles...
 1791: 
 1792:          // Gets the normal vector to the element (with a length equal to twice the area)
 1793:          if constexpr(ics==1) {
 1794:             const int kb0 = max(k, nodes[0]->kb);
 1795:             const int kb1 = max(k, nodes[1]->kb);
 1796:             const int kb2 = max(k, nodes[2]->kb);
 1797: 
 1798:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1799:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1800:             
 1801:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1802:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1803:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1804:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1805: 
 1806:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1807:             area3D = 0.5*len;
 1808: 
 1809:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1810: 
 1811:             return {nx/len, ny/len, nz/len};
 1812: 
 1813:            
 1814:          }
 1815:          else {  // lat/lon
 1816:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1817:             return {0.0, 0.0, 0.0};
 1818: 
 1819:          } // if ics
 1820:       }
 1821:       else {
 1822:          // For quads...
 1823: 
 1824:          assert(false && "Element normal vector: quads not yet implemented");
 1825:          return {0.0, 0.0, 0.0};
 1826: 
 1827: 
 1828:       }
 1829:    }
 1830: 
 1831: /**
 1832:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1833:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1834:    If the segment is completely inside the element, then it returns true.
 1835: 
 1836:    This function assumes:
 1837:    - The initial point is on a side of the element. 
 1838:    - Its position is given by parameter t in the range [0,1].
 1839:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1840:       intersects the element (elements are convex).
 1841: 
 1842:    To find the intersection point, this function does the following:
 1843:    - it finds the intersection of the line segment with all the element side lines,
 1844:       except for the one that contains the initial point.
 1845:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1846:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1847:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1848:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1849:       track segment is almost parallel to the element side line.
 1850: 
 1851:    Inputs:
 1852:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1853:    @param x2, y2: other end of the line segment
 1854: 
 1855:    Outputs:
 1856:    @param side:  side that intersects the line segment (input and output)
 1857:    @param nextElement (output): element that contains the intersection point
 1858:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1859:    @param zint (input/output): Vertical coordinate of the intersection point
 1860: 
 1861:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1862:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1863:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1864: 
 1865:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1866:    (Delta) being zero.
 1867: 
 1868:    The intersection2 point happens when:
 1869:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1870:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1871:    
 1872:    Assumption: the 4 points (including those of the side segment) are different.
 1873:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1874:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1875:    If true, (xIntersect,yIntersect) is the intersection.				
 1876:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1877: **/
 1878: 
 1879: 
 1880: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1881:                                               double &t, double& tIntersect) {
 1882:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1883:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1884: 
 1885:    double closest_intersect_t = 1e10;
 1886:    bool found_intersection = false;
 1887: 
 1888:    for (int i = 0; i < i34; i++) {
 1889: 
 1890:       Side *side2 = sides[i];
 1891: 
 1892:       // (x3,y3)-(x4,y4) is the element side line
 1893:       const Point2 x3 = side2->n1->p;
 1894:       const Point2 x4 = side2->n2->p;
 1895: 
 1896:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1897:       const double delta = cross(x2 - x1, x3 - x4);
 1898: 
 1899:       if (abs(delta) > 0) {
 1900: 
 1901:          const double delta1 = cross(x3 - x1, x3 - x4);
 1902:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1903: 
 1904:          // Solves the two linear equations for tt1 and tt2
 1905:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1906:          const double tt2 = delta2/delta;
 1907: 
 1908:          if (tt1 >= -small2 && tt2 >= -small2 && tt2 <= 1.0 + small2 && tt1 <= 1.0 + small2) {
 1909:             closest_intersect_t = min(closest_intersect_t, tt1);
 1910:             side = side2;
 1911:             nextElement = side->otherElem(this);
 1912:             t = clamp(tt2, 0.0, 1.0);
 1913:             tIntersect = clamp(tt1, small, 1.0-small);
 1914:             found_intersection = true;
 1915:          }
 1916:       
 1917:       }
 1918:       else {  // parallel segments
 1919: 
 1920: printf("XXXXXXX Parallel segments !!!!!!!!!!!!!!!!!!!!!!\n");
 1921:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1922:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1923: 
 1924:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1925:          const double dist = dot(x1 - x3, side2->n);
 1926:          if (abs(dist) < small*length(x3 - x4)) {
 1927:             const double2 unitarySide = normalize(x4 - x3);
 1928:             const double len = dot(x2 - x1, unitarySide);
 1929:             t = t + len;
 1930:             t = max(0.0, min(t, 1.0));
 1931:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1932: 
 1933: 
 1934:             // tIntersect = max(small, min(tt1, 1.0-small));
 1935:             // t = tt2;
 1936:             found_intersection = true;
 1937:          }
 1938:       }
 1939: 
 1940: 
 1941:    }
 1942: 
 1943: 
 1944:    assert(found_intersection && "No intersection found");
 1945: 
 1946:    // found_intersection should always be true, since we checked all the sides.  
 1947:    return found_intersection;
 1948: }
 1949: 
 1950: 
 1951: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1952:                                              Point3 &xt, double zint, Vector3 &u_int) {
 1953: 
 1954:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1955:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 1956:    // curElement.
 1957: 
 1958:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1959:    // And uses this velocity instead to continue the tracking.
 1960: 
 1961:    // computes the intersection point in cartesian coordinates
 1962:    if (tt<0.0 || tt>1.0) printf("XXXXXXX tt = %.17g\n", tt);
 1963:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 1964: 
 1965:    // Nudges the point to the barycenter of the element. 
 1966:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1967:    // next segment intersects the element sides. 
 1968:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 1969: 
 1970: 
 1971:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1972:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1973:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1974:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1975: 
 1976:    // If the side is an open boundary, the tangential velocity is set to zero.
 1977:    if (nextSide->isBnd()) vtan = 0.0;
 1978: 
 1979:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1980:    const double us = vtan*nextSide->t().x;
 1981:    const double vs = vtan*nextSide->t().y;
 1982:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);  //  XXXX Why not use the side's velocity?
 1983: 
 1984:    
 1985:    // The end of this tracking segment is now the intersection point.
 1986:    xt = {intersection.x, intersection.y, zint};
 1987: 
 1988: 
 1989:    u_int = {us, vs, ws};
 1990:    
 1991: }
 1992: 
 1993: /**
 1994:  * Tracks a particle through elements and vertical levels in the mesh.
 1995:  * 
 1996:  * @param x0,y0,z0     Starting position coordinates
 1997:  * @param xt,yt,zt     Target position coordinates
 1998:  * @param dtb          Time step for tracking
 1999:  * @param u_int        Initial velocity components
 2000:  * @param nextElem     Starting/resulting element index
 2001:  * 
 2002:  * @return Status code of type trackExitCodes
 2003:  * 
 2004:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2005:  * of the details are different. The idea is that the code requires less branches and is better fit
 2006:  * for GPU execution.
 2007:  * 
 2008:  * The main ideas here are:
 2009:  * - The starting point is expected to be in the starting element.
 2010:  * - since the starting point is inside the element, there are only two cases: 
 2011:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2012:  *     (b) it does not and (xt,yt) is already in the starting element.
 2013:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2014:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2015:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2016:  * - tt1 can be positive or negative. We only consider the positive values.
 2017:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2018:  * - The next intersection will occur at the smallest positive tt1.
 2019:  * - This intersection will be the next (x0,y0) position.
 2020:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2021:  *   of getting stuck in a loop.
 2022:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2023:  *   was found.
 2024:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2025:  */
 2026: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2027:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2028:                                                        const Side *origSide) {
 2029:                                                             
 2030:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2031:    // else to do. This means that the full step occurred within the current element.
 2032:    assert(!isDry && "Starting element is dry");
 2033:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2034: 
 2035:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2036:       assert(!isDry && "Target point is inside a dry element");
 2037: 
 2038:       interpolateVelocities(xt, u_int);
 2039: 
 2040:       nextElem = this;
 2041: 
 2042: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2043:       return true;
 2044:    }
 2045: 
 2046: 
 2047:    assert(containsPoint(toPoint2(x0)) && "XXXX Starting point is not inside the element");
 2048: 
 2049:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2050:    
 2051:    // const int MAX_ITERATIONS = 1000;
 2052:    
 2053:    double t;
 2054:    Side *nextSide = nullptr;
 2055:    double tIntersect = 1e10;
 2056: 
 2057: 
 2058:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2059:    // (x0,y0) is inside the element but the target point is not.
 2060:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2061:    assert(found_intersection && "No intersection found at %d");
 2062: 
 2063:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2064:    if (t<0.0 || t>1.0) printf("XXXXXXX t = %.17g\n", t);
 2065:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2066: 
 2067:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2068:    if (nextElem != nullptr && !nextElem->isDry) nextElem->nudgeToBarycenter(xtmp);
 2069:    
 2070: 
 2071:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2072:    xt = {xtmp.x, xtmp.y, zint};
 2073: 
 2074:    // if the tracking segment goes out of water (either dry or edge boundary)
 2075:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2076: 
 2077: 
 2078:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2079: 
 2080: 
 2081:       // When this happens, the backtracking stops.
 2082:       dt = time_rm;
 2083: 
 2084:       // In this cases, the next element is again the current element.
 2085:       nextElem = this;
 2086:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2087:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2088:       return true;    
 2089:    }
 2090: 
 2091: 
 2092:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2093:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2094:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2095: 
 2096:    nextElem->interpolateVelocities(xt, u_int); 
 2097: 
 2098:    assert(nextElem != this && "Next element is the same as the current element");
 2099: 
 2100:    return true;
 2101: }
 2102: 
 2103: 
 2104: __inline__ __device__ double Element::computeSignedArea(void) const {
 2105:    // Compute the area of the element
 2106: 
 2107:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2108: 
 2109:    // In the quad case we need to add the area of the other triangle.
 2110:    if (isQuad()) {
 2111:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2112:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2113:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2114:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2115: 
 2116:       res += ar1;
 2117:    }
 2118: 
 2119:    return res;
 2120: }
 2121: 
 2122: 
 2123: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2124:                                                                 (nodes[1]->isDry2()) ||
 2125:                                                                 (nodes[2]->isDry2()) ||
 2126:                                                                 (i34==4 && nodes[3]->isDry2());
 2127: }
 2128: 
 2129: __inline__ __device__ double Element::detJ_eta(void) const {
 2130:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2131:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2132: }
 2133: 
 2134: __inline__ __device__ double Element::detJ_xi(void) const {
 2135:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2136:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2137: }
 2138: 
 2139: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2140:    // In boundary sides, the element 1 is nullptr
 2141:    return side->elems[1] == nullptr; 
 2142: }
 2143: 
 2144: 
 2145: 
 2146: /**
 2147:    Compute the shape coordinates of the point (xt,yt) in the element.
 2148:    @param xt (input): x-coordinate of the point
 2149:    @param shpCoords (output): shape coordinates of the point
 2150:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2151:    @return true if the point is inside the element, false otherwise
 2152: **/
 2153: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2154:                                             bool fixNegshpCoord) const {
 2155: 
 2156:    // Compute the shape coordinates of the point xt in the element.
 2157:    if (i34==3) {
 2158:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2159:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2160:       // and in this case, the pt will be nudged into the element
 2161:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2162:       // from the local frame, so use additional check.
 2163: 
 2164:       Point2 x0, x1, x2;
 2165: 
 2166:       if constexpr(ics==1) {
 2167:          x0 = nodes[0]->p;
 2168:          x1 = nodes[1]->p;
 2169:          x2 = nodes[2]->p;
 2170:       }
 2171:       else // lat/lon
 2172:       {
 2173:          Error("Not implemented yet");
 2174:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2175:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2176:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2177:       }
 2178: 
 2179:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2180:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2181:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2182:       shpCoords[3] = 0.0;
 2183: 
 2184:       const double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2185:       const bool res = (tmpmin >= -small);     
 2186: 
 2187:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2188:       // then we fix the negative shape coordinates.
 2189:       if ((tmpmin < 1.0e-4) && fixNegshpCoord) {
 2190: 
 2191:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2192:          // keeping the sum of the shape coordinates equal to 1.
 2193:          // I have tested and compared the new algorithm with the old one, and they give
 2194:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2195:          // The new algorithm should be faster since it is branchless.
 2196:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2197:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2198:          
 2199:          shpCoords[0] = (shpCoords[0] + a)*b;
 2200:          shpCoords[1] = (shpCoords[1] + a)*b;
 2201:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2202: 
 2203:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2204:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2205:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2206:          }
 2207: 
 2208:          // Update the point coordinates for the new shape coordinates
 2209:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2210:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2211:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2212: 
 2213:       }
 2214: 
 2215:       // Check if the point is inside the element
 2216:       return res;      
 2217:    }
 2218:    else {
 2219:       Error("Not implemented yet");
 2220: #ifdef QUADS
 2221:       // Reproject pt in eframe of nel for ics=2
 2222:       if constexpr(ics==1) {
 2223:          xn2 = xt; 
 2224:          yn2 = yt;
 2225:       }
 2226:       else {
 2227:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2228:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2229:       }
 2230: 
 2231:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2232: #endif
 2233:    }
 2234: 
 2235:    assert(false && "computeShapeCoords: should never reach this point");
 2236:    return false;  // Never reached
 2237: 
 2238: }
 2239: 
 2240: 
 2241: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2242: // Convert shape coordinates to cartesian coordinates
 2243: 
 2244:    if (i34 == 3) {
 2245:       // Triangular element
 2246:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2247:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2248:    }
 2249:    else {
 2250:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2251:    }
 2252: 
 2253: }
 2254: 
 2255: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2256:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2257:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2258:    // The formula for the integral is:
 2259:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2260: 
 2261:    printf("intPhiPhi: TEST\n");
 2262: 
 2263:    const Node *n0 = nodes[0];
 2264:    const Node *n1 = nodes[1];
 2265:    const Node *n2 = nodes[2];
 2266:    const Node *n3 = nodes[3];
 2267: 
 2268:    const Vector2 p0 = n0->p;
 2269:    const Vector2 p1 = n1->p;
 2270:    const Vector2 p2 = n2->p;
 2271:    const Vector2 p3 = n3->p;
 2272: 
 2273:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2274:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2275:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2276:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2277: 
 2278:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2279: }
 2280:    
 2281: 
 2282: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2283:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2284:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2285:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2286:    // The formula is also based on the identity:
 2287:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2288:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2289: 
 2290:    printf("intGradPhiGradPhi: TEST\n");   
 2291: 
 2292:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2293: 
 2294:    const double x0 = nodes[0]->p.x;
 2295:    const double y0 = nodes[0]->p.y;
 2296:    const double x1 = nodes[1]->p.x;
 2297:    const double y1 = nodes[1]->p.y;
 2298:    const double x2 = nodes[2]->p.x;
 2299:    const double y2 = nodes[2]->p.y;
 2300:    const double x3 = nodes[3]->p.x;
 2301:    const double y3 = nodes[3]->p.y;
 2302: 
 2303:    double res = 0.0;
 2304:    
 2305:    // Quadrature points in xi and eta coordinates
 2306:    #pragma unroll
 2307:    for (int i = 0; i < 4; i++) {
 2308:       // For each quadrature point...
 2309: 
 2310:       const Point2 p = GaussPoint(i);
 2311:       const double eta = p.x;
 2312:       const double xi  = p.y;
 2313: 
 2314:       // Jacobian entries at the Gauss point p
 2315:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2316:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2317:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2318:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2319: 
 2320:       const double detJ = jacobianDet(p);
 2321:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2322: 
 2323:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2324:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2325:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2326:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2327:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2328: 
 2329:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2330:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2331:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2332:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2333:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2334: 
 2335:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2336:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2337:    }
 2338: 
 2339:    return res;
 2340: }
 2341: 
 2342: 
 2343: /**  Interpolate velocities at a given point (xt,yt,zt)
 2344: 
 2345:    @param xt, yt, zt: coordinates of the point to interpolate
 2346:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2347: 
 2348:    This is done in four steps:
 2349: 
 2350:    1. Find the shape coordinates for the final position in the element.
 2351:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2352:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2353:       z levels at xt, yt at each step.   
 2354:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2355:       horizontally and vertically.
 2356: **/
 2357: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2358:    // Interpolate the velocities at the point xt. 
 2359:    // This function works the same for triangular and quadrilateral elements.
 2360:    double shpCoord[4];
 2361: 
 2362:    // First step is to compute the shape coordinates of (xt,yt)
 2363:    computeShapeCoords(toVector2(xt), shpCoord, true);
 2364: 
 2365:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2366: 
 2367:    // Second step is to find the level that contains zt
 2368:    // Uses a binary search to find the level
 2369:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2370:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2371:    int R = nvrt - 1;
 2372: 
 2373:    // Get the z coordinates at the nodes of the element at the levels L and R
 2374:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2375:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2376:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2377: 
 2378:    double zL = interpolate(shpCoord, zLAtNodes);
 2379:    double zR = interpolate(shpCoord, zRAtNodes);
 2380:    
 2381:    // Interpolates vertically the velocities
 2382:    double wght1, wght2;
 2383:    if (xt.z<=zL) {
 2384:       wght1 = 1.0;
 2385:       wght2 = 0.0;
 2386:       xt.z = zL;
 2387:    }
 2388:    else if (xt.z>=zR) {
 2389:       wght1 = 0.0;
 2390:       wght2 = 1.0;
 2391:       xt.z = zR;
 2392:    }
 2393:    else {
 2394:       // Perform a binary search to find the levels between L and R that contain xt.z
 2395:       while (R - L > 1) {
 2396:          int M = (L + R) / 2.0;
 2397: 
 2398:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2399:          double zM = interpolate(shpCoord, zMAtNodes);
 2400:          if (zM < xt.z) 
 2401:          {
 2402:             L = M;
 2403:             zL = zM;
 2404:          }
 2405:          else 
 2406:          {
 2407:             R = M;
 2408:             zR = zM;
 2409:          }
 2410:       }
 2411:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2412:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2413: 
 2414:       wght2 = (xt.z - zL)/(zR - zL);
 2415:       wght1 = 1.0 - wght2;
 2416: 
 2417:    }
 2418: 
 2419: 
 2420:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2421:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2422: 
 2423:    // Neither of the interpolated velocities should be NaN
 2424:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2425: 
 2426: }
 2427: 
 2428: 
 2429: 
 2430: 
 2431: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2432: 
 2433:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2434:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2435:    const Node *n1 = side->n1;
 2436:    const Node *n2 = side->n2;
 2437: 
 2438:    bool n1_match = (n1->nodeBnd->segment == segment);
 2439:    bool n2_match = (n2->nodeBnd->segment == segment);
 2440: 
 2441:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2442:    if (n1_match && n2_match) {
 2443:       return 0.5;
 2444:    } else if (n1_match) {
 2445:       return 1.0;
 2446:    } else if (n2_match) {
 2447:       return 0.0;
 2448:    }
 2449: 
 2450:    return 0.0;
 2451: }
 2452: 
 2453: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2454: 
 2455: 
 2456: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2457: 
 2458:    const double w1 = getBoundaryArrayValueWeight();
 2459:    const double w2 = 1.0 - w1;
 2460:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2461:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2462: 
 2463:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2464: }
 2465: 
 2466: 
 2467: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2468:    const double w1 = getBoundaryArrayValueWeight();
 2469:    const double w2 = 1.0 - w1;
 2470:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2471:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2472: 
 2473:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2474: 
 2475: }
 2476: 
 2477: 
 2478: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2479:    // Returns the value of the velocity at the side center
 2480:    const double w1 = getBoundaryArrayValueWeight();
 2481:    const double w2 = 1.0 - w1;
 2482:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2483:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2484: 
 2485:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2486: }
 2487: 
 2488: 
 2489: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2490:    // Returns the value of the normal component of the velocity at the side center
 2491:    const double w1 = getBoundaryArrayValueWeight();
 2492:    const double w2 = 1.0 - w1;
 2493:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2494:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2495: 
 2496:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2497: }
 2498: 
 2499: 
 2500: 
 2501: __inline__ __device__ double  Side::x(double t)   const { if (t<0.0 || t>1.0) printf("XX t = %.7g\n", t); assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2502: __inline__ __device__ double  Side::y(double t)   const { if (t<0.0 || t>1.0) printf("YY t = %.7g\n", t); assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2503: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2504: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2505: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2506: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2507:    Vector2 grad = {0.0, 0.0};
 2508:    int count = 0;
 2509: 
 2510:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2511: 
 2512:    // First element
 2513:    if (elems[0] != nullptr && condition(elems[0])) {
 2514:       grad += elems[0]->grad2(field);
 2515:       count++;
 2516:    }
 2517: 
 2518:    // Second element
 2519:    if (elems[1] != nullptr && condition(elems[1])) {
 2520:       grad += elems[1]->grad2(field);
 2521:       count++;
 2522:    }
 2523: 
 2524:    if (count > 0) {
 2525:       grad = grad/count;
 2526:    }
 2527:    
 2528:    return grad;
 2529: }
 2530: 
 2531: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2532: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv,     n2->iadv); }   
 2533: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2534: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2535: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2536: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2537: 
 2538: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2539: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2540: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2541: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
