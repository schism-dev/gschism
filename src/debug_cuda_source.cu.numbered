 9632: 
 9633: template<TurbulenceModel M>
 9634: __device__ __forceinline__ double getTKE(const Turbulence<M> &turb, int k) {
 9635:    if constexpr (M == TurbulenceModel::GLS)
 9636:       return turb.tke[k];
 9637:    else
 9638:       return 0.0;
 9639: }
 9640: template<TurbulenceModel M>
 9641: __device__ __forceinline__ double getMXL(const Turbulence<M> &turb, int k) {
 9642:    if constexpr (M == TurbulenceModel::GLS)
 9643:       return turb.mxl[k];
 9644:    else
 9645:       return 0.0;
 9646: }
