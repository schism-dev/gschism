  683: struct Element {
  684: 
  685:    // Geometry information
  686:    int idx;                   // Index of the element
  687:    int i34;                   // Number of sides for the element 
  688:    Side *sides[4];            // Sides of the element
  689:    Node *nodes[4];            // Nodes of the element
  690:    Element *nghbElems[4];     // Neighbors of the element
  691: 
  692:    int kb;                    // Bottom index of the element
  693:    double area;               // Area of the element
  694:    double ssign[4];           // Sign associated with each side of an element
  695:    double radius;             // Element equivalent radii
  696: 
  697:    #ifdef USE_FRAMES
  698:    Frame frame;
  699:    #endif
  700: 
  701:    Vector2 gradPhi[4];        // Derivatives of shape functions
  702:    Vector2 gradEta;           // Gradient of free surface elevation
  703:    Vector2 gradPr;            // Gradient of pressure    
  704:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  705: 
  706:    bool isDry;                // True if the element is dry
  707: 
  708:    Point2 center;            // Element center coordinates (global coordinates)
  709: 
  710:    double depth;              // Depth at element (min of all nodes)
  711:    double z[nvrt];            // z-coord  (local frame - vertical up)
  712: 
  713:    // Physical information
  714:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  715: 
  716:    static const bool isblock = false;              // Always false
  717: 
  718:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  719:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  720: 
  721:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  722:    
  723: 
  724:    double vsource;            // Volumetric source/sink term [m^3/s]
  725: 
  726:    double rho[nvrt];          // Density at each prism center
  727:    double rho_mean[nvrt];     // Mean density at each prism center
  728:    CubicSpline rho_spl;
  729:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  730:    double rho_z[nvrt];        // First derivative of density at each prism center
  731:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  732:    
  733: 
  734:    __inline__ __device__ Point2 outputCoords(void) const;
  735: 
  736:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  737: 
  738:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  739:    // If ics == 2, convert the global point to the local frame of the element
  740:       
  741:       if constexpr (ics == 1) {
  742:          return p;
  743:       } else {
  744:          const Point3 c = {center.x, center.y, centerZ()};
  745:          return frame.G2L(p - c);
  746:       }
  747:    }
  748: 
  749:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  750:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  751: 
  752:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  753:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  754: 
  755:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  756:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  757:       // Find the local index of the node in the element (0,1,2,3)
  758:       int res = __ffs((nodes[0] == node) | 
  759:                      ((nodes[1] == node) << 1) | 
  760:                      ((nodes[2] == node) << 2) | 
  761:                      ((nodes[3] == node) << 3)) - 1;
  762:       
  763:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  764:       return res;  
  765:    }
  766: 
  767:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  768:       // Find the local index of the side in the element (0,1,2,3)
  769:       int res = __ffs((sides[0] == side) | 
  770:                      ((sides[1] == side) << 1) | 
  771:                      ((sides[2] == side) << 2) | 
  772:                      ((sides[3] == side) << 3)) - 1;
  773:       
  774:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  775:       return res;
  776:    }
  777: 
  778:    __inline__ __device__ int findLevel(double z1, int k) const {
  779:       // Starting at index k, find sequentially the level that contains z
  780: 
  781:       // For testing purposes, forgets k and performs a full search.
  782:       for (k = kb; k < nvrt - 1; k++) {
  783:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  784:       }
  785:       return nvrt - 2;
  786: 
  787: 
  788:       // if z is already betweeen z[k] and z[k+1], return k
  789:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  790:       else if (z1 <  z[k]) { 
  791:          // Search for increasing levels
  792:          for (int kk = k; kk < nvrt - 1; kk++) {
  793:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  794:          }
  795:          return nvrt - 1;
  796:       }
  797:       else {
  798:          // Search for decreasing levels
  799:          for (int kk = k; kk >= kb; kk--) {
  800:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  801:          }
  802:          return 0;
  803:       }
  804:    }
  805: 
  806:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  807:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  808: 
  809: 
  810:    __device__ __forceinline__ double centerZ(void) const;
  811: 
  812:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  813:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  814:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  815:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  816:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  817: 
  818: 
  819:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  820:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  821:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  822:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  823:        const double eta = (idxNode & 1) ? +g : -g;
  824:        const double xi  = (idxNode & 2) ? +g : -g;
  825:        return {eta, xi};
  826:    }  
  827: 
  828:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  829:    __device__ __forceinline__ double etaSign(int idxNode) const {
  830:       // bit1: 0 -> -1, 1 -> +1
  831:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  832:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  833:    }
  834: 
  835:    __device__ __forceinline__ double xiSign(int idxNode) const {
  836:       // +1 if (bit0 XOR bit1), else -1
  837:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  838:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  839: 
  840:    }
  841: 
  842:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  843:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  844:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  845:    }
  846: 
  847:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  848:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  849:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  850:    }   
  851: 
  852:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  853:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  854:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  855:    }      
  856:    
  857:    __inline__ __device__ double detJ_eta(void) const;
  858: 
  859:    __inline__ __device__ double detJ_xi(void) const;
  860: 
  861:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  862: 
  863:    // Check if the element is dry using the more up-to-date elevation.
  864:    __inline__ __device__ bool isDry2(void) const;
  865: 
  866:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  867: 
  868:    __device__ bool inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const;
