 6859: //                     swild4(2,1)=swild4(2,1)*rat+sdbt(2+jj,max(k-1,kbs(jsj)),jsj)*(1-rat)
 6860: //                     psumtr(jj)=psumtr(jj)+0.5d0*(swild4(1,1)+swild4(2,1)) 
 6861: //                   enddo !j
 6862: //                 enddo !jj
 6863: //                 tr_el(1:ntr,k,i)=psumtr(:)/dble(i34(i))
 6864: //               enddo !k
 6865: //             endif !ielem_elm(i)/=0
 6866: 
 6867: 
 6868: // !           Extend
 6869: //             do k=1,kbe(i)
 6870: //               tr_el(1:ntr,k,i)=tr_el(1:ntr,kbe(i)+1,i)
 6871: //             enddo !k
 6872: //           enddo !i=1,ne
 6873: // !$OMP     end do 
 6874: 
 6875: // !$OMP     master
 6876: // !         Update ghosts
 6877: // #ifdef INCLUDE_TIMING
 6878: //           cwtmp=mpi_wtime()
 6879: //           timer_ns(1)=timer_ns(1)+cwtmp-cwtmp2
 6880: // #endif
 6881: //           call exchange_e3d_2t_tr(tr_el)
 6882: 
 6883: // #ifdef INCLUDE_TIMING
 6884: //           cwtmp2=mpi_wtime()
 6885: //           wtimer(9,2)=wtimer(9,2)+cwtmp2-cwtmp
 6886: // #endif
 6887: 
 6888: #endif
