 1038: __global__ void setupSolverMatricesAndVectors(
 1039:    double** data_ptrs,
 1040:    int**    indices_ptrs,
 1041:    int**    indptr_ptrs,
 1042:    int*     nrows,
 1043:    int*     ncols,
 1044:    double** x_ptrs,
 1045:    double** b_ptrs);
