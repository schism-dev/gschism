 6481: __global__ void printMatrix(void) {
 6482: 
 6483: 
 6484:    // Let only one thread per block print at a time 
 6485: 
 6486:    if (threadIdx.x == 0) {
 6487:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 6488:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 6489:          if (idx_node >= mesh->np) return;
 6490:          const Node *node = mesh->localNodeData + idx_node;
 6491:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 6492:          for (int j = 0; j < node->numNodes; j++) {
 6493:             Node* nbNode = node->nodes[j];
 6494:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 6495:          }
 6496:          printf("]\n");
 6497: 
 6498:       }
 6499:    }
 6500: 
 6501: 
 6502: 
 6503: }
