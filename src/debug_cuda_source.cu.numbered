 8412: __global__ void returnMatrix(double *res) {
 8413:    // Debugging: returns the matrix as a CuPy array
 8414: 
 8415:    const int size = mesh->np;
 8416:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8417:       const Node *node = mesh->localNodeData + idx_node;
 8418:       res[idx_node*size + idx_node] = *(node->coeffDiag);
 8419:       for (int j = 0; j < node->numNodes; j++) {
 8420:          Node* nbNode = node->nodes[j];
 8421:          if (node->coeffRow[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffRow[csrSlot[j]];
 8422:       }
 8423: 
 8424:    }
 8425:    
 8426: }
 8427: 
