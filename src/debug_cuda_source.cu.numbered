 5187:       const int idx = node->idx;
 5188:       Vector2 wind = {xWind[idx], yWind[idx]};
 5189: 
 5190:       if constexpr(nws != 0 && iwindoff != 0) {
 5191:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5192:       }
 5193: 
 5194:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5195:       node->setWind(wind);
 5196: 
 5197:       node->pr = pressAir[idx];
 5198:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5199: 
 5200:    }
