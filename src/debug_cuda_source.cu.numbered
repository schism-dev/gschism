 1636: // Helper functions for computing the local node index at a given offset from another.
 1637: __device__ __inline__ int nxq(int offset, int index, int size) {
 1638:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1639:    // to the index to make it positive
 1640:    assert(index + offset + 16*size >= 0);
 1641:    return (index + offset + 16*size) % size;  
 1642: }
 1643: 
 1644: __device__ __inline__ int nxq(int index, int size) {
 1645:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1646:    // to the index to make it positive
 1647:    assert(index + 16*size >= 0);
 1648:    return (index + 16*size) % size; 
 1649: }
