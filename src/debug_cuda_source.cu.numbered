  942:    // ------------------------------------------------------------------------------------------------
  943:    // These are functions that work on all nodes/sides of the element.
  944:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  945:    //
  946:    // An example of how to use these functions is:
  947:    //   
  948:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  949:    // 
  950:    // Where L is the level at which the field is to be interpolated. The field can be either
  951:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  952:    // There are different versions of getNodalValues for each of these cases.
  953: 
  954:    template<typename T>
  955:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
