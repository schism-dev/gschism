  178: 
  179: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  180:     return make_double2(a.x + b.x, a.y + b.y);
  181: }
  182: 
  183: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  184:     a.x += b.x;
  185:     a.y += b.y;
  186:     return a;
  187: }
  188: 
  189: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  190:     return make_double2(a.x - b.x, a.y - b.y);
  191: }
  192: 
  193: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  194:     a.x -= b.x;
  195:     a.y -= b.y;
  196:     return a;
  197: }
  198: 
  199: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  200:     return make_double2(v.x * s, v.y * s);
  201: }
  202: 
  203: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  204:     return v * s;  // reuse the previous operator
  205: }
  206: 
  207: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  208:     return make_double2(v.x / s, v.y / s);
  209: }
  210: 
  211: __device__ __forceinline__ double norm2(const double2& v) {
  212:     return v.x*v.x + v.y*v.y;
  213: }
  214: 
  215: __device__ __forceinline__ double length(const double2& v) {
  216:     return sqrt(v.x*v.x + v.y*v.y);
  217: }
  218: 
  219: __device__ __forceinline__ double2 normalize(const double2& v) {
  220:     return v / length(v);
  221: }
  222: 
  223: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  224:     return v.x*w.x + v.y*w.y;
  225: }
  226: 
  227: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  228:     return v.x*w.y - v.y*w.x;
  229: }
  230: 
  231: __device__ __forceinline__ double2 rot90(const double2& a) {
  232:     return make_double2(a.y, -a.x);
  233: }
  234: 
  235: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  236:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  237: }
  238: 
  239: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  240:     a.x += b.x;
  241:     a.y += b.y;
  242:     a.z += b.z;
  243:     return a;
  244: }
  245: 
  246: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  247:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  248: }
  249: 
  250: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  251:     return make_double3(v.x * s, v.y * s, v.z * s);
  252: }
  253: 
  254: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  255:     return v * s;
  256: }
  257: 
  258: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  259:     return make_double3(v.x / s, v.y / s, v.z / s);
  260: }
  261: 
  262: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  263:     return v.x*w.x + v.y*w.y + v.z*w.z;
  264: }
  265: 
  266: __device__ __forceinline__ double norm2(const double3& v) {
  267:     return v.x*v.x + v.y*v.y + v.z*v.z;
  268: }
  269: 
  270: __device__ __forceinline__ Vector2 toVector2(const double3& v) {
