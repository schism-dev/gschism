 2372: __device__ void lock(int *mutex) {
 2373:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2374: }
 2375: 
 2376: __device__ void unlock(int *mutex) {
 2377:     atomicExch(mutex, 0);
 2378: }
