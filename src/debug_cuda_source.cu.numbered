 1491:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1492:       // Compute the different time ramps used in the code 
 1493:       // This function is performed by just one thread
 1494: 
 1495:       if constexpr(ibc == 0) {
 1496:          if (drampbc > 0.0) {
 1497:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1498:          } else {
 1499:             rampbc = 1.0;
 1500:          }
 1501: 
 1502:          if (nws != 0 && drampwind > 0.0) {
 1503:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1504:          } else {
 1505:             rampwind = 1.0;
 1506:          }
 1507:       }
 1508: 
 1509:       if (drampwafo > 0.0) {
 1510:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1511:       } else {
 1512:          rampwafo = 1.0;
 1513:       }
 1514: 
 1515:       // For source/sinks
 1516:       if (if_source && dramp_ss > 0.0) {
 1517:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1518:       } else {
 1519:          ramp_ss = 1.0;
 1520:       }
 1521: 
 1522:       if (dramp > 0.0) {
 1523:          ramp = tanh(2.0*time/86400.0/dramp);
 1524:       } else {
 1525:          ramp = 1.0;
 1526:       }
 1527: 
 1528:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1529:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1530:    }
 1531:       
 1532: 
 1533:    __global__ void computeBedDeformation(void) {
 1534:       printf("NOT IMPLEMENTED: computeBedDeformation\n");
 1535: 
 1536:    }
