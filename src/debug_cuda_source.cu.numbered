 7721: __global__ void printMatrix(bool full) {
 7722:    // Debugging: print the matrix
 7723: 
 7724:    const int size = mesh->np;
 7725:    double sum = 0.0;
 7726:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7727:       const Node *node = mesh->localNodeData + idx_node;
 7728:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7729:       for (int j = 0; j < node->numNodes; j++) {
 7730:          Node* nbNode = node->nodes[j];
 7731:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7732:          sum += node->coeffMatrix[j];
 7733:       }
 7734:       if (full) printf("]\n");
 7735: 
 7736: 
 7737:    }
 7738:    if (!full) printf("sum=%lf\n", sum);
 7739: }
