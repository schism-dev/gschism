 2239: 
 2240: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2241: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2242: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2243: // Only when ics == 2, the origin is at the element center.
 2244: 
 2245:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2246: 
 2247:    const Node *node = nodes[idxNode];
 2248: 
 2249:    if constexpr(ics==1) {
 2250:       return node->p;
 2251: 
 2252:    } else {
 2253:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2254: 
 2255:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2256: 
 2257:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2258:    }
 2259: 
 2260: }
 2261: 
 2262: 
 2263: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2264: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2265: 
 2266:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2267: 
 2268:    const int id1 = idx;
 2269:    const int id2 = nxq(1 + id1);
 2270:    const int id3 = nxq(2 + id1);
 2271: 
 2272:    if constexpr(ics==1) {
 2273:       x0 = nodes[id1]->p;
 2274:       x1 = nodes[id2]->p;
 2275:       x2 = nodes[id3]->p;
 2276: 
 2277:    } else {
 2278:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2279: 
 2280:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2281:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2282:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2283: 
 2284:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2285:       x1 = toVector2(frame.G2L(p1 - c));
 2286:       x2 = toVector2(frame.G2L(p2 - c));
 2287: 
 2288:    }
 2289: 
 2290: }
 2291: 
 2292: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2293: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2294: 
 2295:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2296: 
 2297:    if constexpr(ics==1) {
 2298:       x0 = nodes[0]->p;
 2299:       x1 = nodes[1]->p;
 2300:       x2 = nodes[2]->p;  
 2301:       x3 = nodes[3]->p;
 2302: 
 2303:    } else {
 2304:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2305: 
 2306:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2307:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2308:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2309:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2310: 
 2311:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2312:       x1 = toVector2(frame.G2L(p1 - c));
 2313:       x2 = toVector2(frame.G2L(p2 - c));
 2314:       x3 = toVector2(frame.G2L(p3 - c));
 2315:    }
 2316: 
 2317: }
 2318: 
 2319: 
 2320: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2321: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2322: // Returns the normal vector and the area of the element at this level
 2323: 
 2324:    double nx, ny, nz;
 2325: 
 2326:    if (isTri()) {
 2327:       // For triangles...
 2328: 
 2329:       // Indices of the nodes at level k, taking care of not going below the bed
 2330:       const int k0 = max(k, nodes[0]->kb);
 2331:       const int k1 = max(k, nodes[1]->kb);
 2332:       const int k2 = max(k, nodes[2]->kb);
 2333: 
 2334:       // Gets the element frame coordinates of the nodes at level k
 2335:       Point3 x0, x1, x2;
 2336:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2337:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2338:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2339:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2340: 
 2341:       } else {  // ics == 2
 2342:          Point2 h0, h1, h2;
 2343: 
 2344:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2345: 
 2346:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2347:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2348:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2349:       }
 2350: 
 2351:       const Vector3 n20 = x2 - x0;
 2352:       const Vector3 n10 = x1 - x0; 
 2353: 
 2354:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2355:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2356:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2357:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2358:   
 2359:    }
 2360:    else {
 2361:       // For quads...
 2362:       Point2 h0, h1, h2, h3;
 2363: 
 2364:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2365: 
 2366:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2367:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2368:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2369:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2370: 
 2371:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2372:       nx = n20.y*n31.z - n20.z*n31.y;
 2373:       ny = n20.z*n31.x - n20.x*n31.z;
 2374:       nz = n20.x*n31.y - n20.y*n31.x;
 2375: 
 2376:    }
 2377: 
 2378:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2379:    area3D = 0.5*len;
 2380: 
 2381:    const double inv_len = 1.0/len;
 2382: 
 2383:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2384: 
 2385: }
 2386: 
 2387: /**
 2388:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2389:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2390:    If the segment is completely inside the element, then it returns true.
 2391: 
 2392:    This function assumes:
 2393:    - The initial point is on a side of the element. 
 2394:    - Its position is given by parameter t in the range [0,1].
 2395:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2396:       intersects the element (elements are convex).
 2397: 
 2398:    To find the intersection point, this function does the following:
 2399:    - it finds the intersection of the line segment with all the element side lines,
 2400:       except for the one that contains the initial point.
 2401:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2402:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2403:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2404:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2405:       track segment is almost parallel to the element side line.
 2406: 
 2407:    Inputs:
 2408:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2409:    @param x2, y2: other end of the line segment
 2410: 
 2411:    Outputs:
 2412:    @param side:  side that intersects the line segment (input and output)
 2413:    @param nextElement (output): element that contains the intersection point
 2414:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2415:    @param zint (input/output): Vertical coordinate of the intersection point
 2416: 
 2417:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2418:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2419:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2420: 
 2421:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2422:    (Delta) being zero.
 2423: 
 2424:    The intersection2 point happens when:
 2425:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2426:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2427:    
 2428:    Assumption: the 4 points (including those of the side segment) are different.
 2429:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2430:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2431:    If true, (xIntersect,yIntersect) is the intersection.				
 2432:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2433: **/
 2434: 
 2435: 
 2436: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2437:                                               double &t, double& tIntersect, const Side *origSide) {
 2438:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2439: 
 2440:    assert( containsPoint(x1, origSide) && "Starting point is not inside the element");                                    
 2441:    assert(!containsPoint(x2, origSide) && "Ending point is not outside the element");
 2442: 
 2443:    double closest_intersect_t = 1e10;
 2444:    bool found_intersection = false;
 2445: 
 2446:    for (int i = 0; i < i34; i++) {
 2447: 
 2448:       Side *side2 = sides[i];
 2449: 
 2450:       // (x3,y3)-(x4,y4) is the element side line
 2451:       Point2 x3 = side2->n1->p;
 2452:       Point2 x4 = side2->n2->p;
 2453: 
 2454:       if constexpr(ics==2) {
 2455:          
 2456:          x3 = toPoint2(origSide->toLocalFrame(toPoint3(x3, side2->n1->gz))); // XXXX?????
 2457:          x4 = toPoint2(origSide->toLocalFrame(toPoint3(x4, side2->n2->gz)));  // XXXX?????
 2458: 
 2459:       }
 2460: 
 2461:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2462:       const double delta = cross(x2 - x1, x3 - x4);
 2463: 
 2464:       if (abs(delta) > 0) {
 2465: 
 2466:          const double delta1 = cross(x3 - x1, x3 - x4);
 2467:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2468: 
 2469:          // Solves the two linear equations for tt1 and tt2
 2470:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2471:          const double tt2 = delta2/delta;
 2472: 
 2473:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2474:             closest_intersect_t = min(closest_intersect_t, tt1);
 2475:             side = side2;
 2476:             nextElement = side->otherElem(this);
 2477: 
 2478:             t =          clamp(tt2, small, 1.0-small);
 2479:             tIntersect = clamp(tt1, small, 1.0-small);
 2480:             found_intersection = true;
 2481: 
 2482:          }
 2483: 
 2484:       
 2485:       }
 2486:       else {  // parallel segments
 2487: 
 2488:          // continue; 
 2489:          assert(false && "Parallel segments should not happen under the new code");
 2490:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 2491:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 2492: 
 2493:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2494:          const double dist = dot(x1 - x3, side2->n);
 2495:          if (abs(dist) < small*length(x3 - x4)) {
 2496:             const double2 unitarySide = normalize(x4 - x3);
 2497:             const double len = dot(x2 - x1, unitarySide);
 2498:             t = t + len;
 2499:             t = max(0.0, min(t, 1.0));
 2500: // printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 2501: 
 2502: 
 2503:             // tIntersect = max(small, min(tt1, 1.0-small));
 2504:             // t = tt2;
 2505:             found_intersection = true;
 2506:          }
 2507:       }
 2508: 
 2509: 
 2510:    }
 2511: 
 2512: 
 2513: if (!found_intersection) {
 2514:    atomicAdd(&stopBlock, 1);
 2515:    // printf("idx = %d\n", origSide->idx);
 2516: }
 2517: 
 2518: if (stopBlock > 0)  return false;
 2519: 
 2520:    // if (!found_intersection) {if (idx == 15876) printf("11111: No intersection found\n"); return false;}
 2521:    assert(found_intersection && "No intersection found");
 2522: 
 2523:    // found_intersection should always be true, since we checked all the sides.  
 2524:    return found_intersection;
 2525: }
 2526: 
 2527: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2528:    // Check if the point (xt,yt) is inside the element.
 2529:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2530:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2531: 
 2532:    double shpCoords[4];
 2533:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2534: 
 2535:    return res;
 2536: }
 2537: 
 2538: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2539:    // Check if the point (xt,yt) is inside the element.
 2540:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2541:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2542:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2543: 
 2544:    double shpCoords[4];
 2545:    Vector2 tmp_xt = xt;
 2546:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2547:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2548: 
 2549:    if (fixCoords && res) xt = tmp_xt;
 2550: 
 2551:    return res;
 2552: }
 2553: 
 2554: 
 2555: __device__ void Element::trackGoesOutOfWater(const Side *nextSide, const Side *origSide, Element *curElem, double tt, int jlev,
 2556:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2557: 
 2558:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2559:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2560:    // curElement.
 2561: 
 2562:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2563:    // And uses this velocity instead to continue the tracking.
 2564: 
 2565:    // computes the intersection point in local cartesian coordinates
 2566:    Point3 intersection = origSide->toLocalFrame(nextSide->p3_t(tt));  // XXXX I don't think this is necessary. The intersection is already computed in findNextIntersection.
 2567: 
 2568:    // Nudges the point to the barycenter of the element. 
 2569:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2570:    // next segment intersects the element sides. 
 2571:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2572: 
 2573: 
 2574:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2575:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2576:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2577:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2578: 
 2579:    // If the side is an open boundary, the tangential velocity is set to zero.
 2580:    if (nextSide->isBnd()) vtan = 0.0;
 2581: 
 2582:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2583:    const double us = vtan*nextSide->t().x;
 2584:    const double vs = vtan*nextSide->t().y;
 2585:    const double ws = nextSide->w2(jlev); 
 2586: 
 2587:    u_int = {us, vs, ws};
 2588: 
 2589:    // The end of this tracking segment is now the intersection point.
 2590:    xt = {intersection.x, intersection.y, zint};
 2591: // printf("trackGoesOutOfWater: intersection = (%.17f, %.17f, %.17f), zint = %.17f, u_int = (%.17f, %.17f, %.17f)\n", intersection.x, intersection.y, zint, u_int.x, u_int.y, u_int.z);
 2592:    
 2593: }
 2594: 
 2595: /**
 2596:  * Tracks a particle through elements and vertical levels in the mesh.
 2597:  * 
 2598:  * @param x0,y0,z0     Starting position coordinates
 2599:  * @param xt,yt,zt     Target position coordinates
 2600:  * @param dtb          Time step for tracking
 2601:  * @param u_int        Initial velocity components
 2602:  * @param nextElem     Starting/resulting element index
 2603:  * 
 2604:  * @return Status code of type trackExitCodes
 2605:  * 
 2606:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2607:  * of the details are different. The idea is that the code requires less branches and is better fit
 2608:  * for GPU execution.
 2609:  * 
 2610:  * The main ideas here are:
 2611:  * - The starting point is expected to be in the starting element.
 2612:  * - since the starting point is inside the element, there are only two cases: 
 2613:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2614:  *     (b) it does not and (xt,yt) is already in the starting element.
 2615:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2616:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2617:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2618:  * - tt1 can be positive or negative. We only consider the positive values.
 2619:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2620:  * - The next intersection will occur at the smallest positive tt1.
 2621:  * - This intersection will be the next (x0,y0) position.
 2622:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2623:  *   of getting stuck in a loop.
 2624:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2625:  *   was found.
 2626:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2627:  */
 2628: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2629:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2630:                                                        const Side *origSide) {
 2631:                                                             
 2632:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2633:    // else to do. This means that the full step occurred within the current element.
 2634:    assert(!isDry && "Starting element is dry");
 2635:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2636: 
 2637: Vector3 x0_local = x0;
 2638:    assert(containsPoint(toPoint2(x0), origSide) && "Starting point is not inside the element");
 2639: 
 2640: 
 2641: 
 2642:    if (containsPoint(toPoint2(xt), true, origSide)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2643: 
 2644:       assert(containsPoint(toPoint2(xt), origSide) && "Target point is not inside the element 1");
 2645:       assert(!isDry && "Target point is inside a dry element");
 2646: 
 2647:       u_int = interpolateVelocities(xt, origSide);
 2648: 
 2649:       nextElem = this;
 2650: 
 2651:       return true;
 2652:    }
 2653: 
 2654: 
 2655:    
 2656: 
 2657:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2658:    
 2659:    double t;
 2660:    Side *nextSide = nullptr;
 2661:    double tIntersect = 1e10;
 2662: 
 2663: showPoints(x0_local, xt, jlev, origSide, 0xFFFFFFu, '+', 2, 0);
 2664:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2665:    // (x0,y0) is inside the element but the target point is not.
 2666:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect, origSide);
 2667: 
 2668: 
 2669: showPoints(x0, xt, jlev, origSide, 0x0000FFu, 'o', 1, 5);
 2670: 
 2671: const Node *n1 = nodes[0];
 2672: const Node *n2 = nodes[1];
 2673: const Node *n3 = nodes[2];
 2674: 
 2675: Point3 p1 = toPoint3(n1->p, n1->gz);
 2676: Point3 p2 = toPoint3(n2->p, n2->gz);
 2677: Point3 p3 = toPoint3(n3->p, n3->gz);
 2678: p1 = origSide->toLocalFrame(p1);
 2679: p2 = origSide->toLocalFrame(p2);
 2680: p3 = origSide->toLocalFrame(p3);
 2681: int s1 = sides[0]->idx;
 2682: int s2 = sides[1]->idx;
 2683: int s3 = sides[2]->idx;
 2684: 
 2685: if (!found_intersection) { return false;}
 2686: // if (!found_intersection) {if (idx == 15876) printf("111112: No intersection found\n"); return false;}
 2687:    assert(found_intersection && "No intersection found at %d");
 2688: 
 2689:    Point2 xtmp = toPoint2(origSide->toLocalFrame(nextSide->p3_t(t))); // If needed, moves the target point to the intersection point
 2690: 
 2691:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2692:    if (nextElem != nullptr && !nextElem->isDry) {
 2693:       assert(nextElem->containsPoint(xtmp, origSide) && "Intersection point is not inside the next element");
 2694: Vector3 xtmp_Before = origSide->toLocalFrame(nextSide->p3_t(t));
 2695:       nextElem->nudgeToBarycenter(xtmp, origSide);
 2696: Vector3 xtmp_After = {xtmp.x, xtmp.y, (1 - tIntersect)*x0.z + tIntersect*xt.z};
 2697: showPoints(xtmp_Before, xtmp_After, jlev, origSide, 0x00FFFFu, '+', 2, 10);
 2698:    }
 2699: 
 2700: // printf("x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), tIntersect = %.17f\n", x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, tIntersect);
 2701:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2702:    xt = {xtmp.x, xtmp.y, zint};
 2703: 
 2704:    // if the tracking segment goes out of water (either dry or edge boundary)
 2705:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2706: 
 2707:       
 2708: Vector3 xt_Before = xt;
 2709:       trackGoesOutOfWater(nextSide, origSide, this, t, jlev, xt, zint, u_int);
 2710: showPoints(xt_Before, xt, jlev, origSide, 0x00FF00u, '+', 14, 5);
 2711: 
 2712:       assert(this->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the current element 2");
 2713:       // When this happens, the backtracking stops.
 2714: 
 2715:       dt *= tIntersect;
 2716: 
 2717:       // In this case, the next element is again the current element.
 2718:       nextElem = this;
 2719: 
 2720: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2721: 
 2722:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2723:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2724:       return true;    
 2725:    }
 2726: 
 2727: 
 2728:    assert(nextElem->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the next element 3");
 2729:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2730:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2731: 
 2732:    
 2733:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2734: 
 2735:    u_int = nextElem->interpolateVelocities(xt, origSide); 
 2736: 
 2737:    assert(nextElem != this && "Next element is the same as the current element");
 2738: 
 2739:    return true;
 2740: }
 2741: 
 2742: 
 2743: __inline__ __device__ double Element::computeSignedArea(void) const {
 2744:    // Compute the area of the element
 2745: 
 2746:    Point2 x0, x1, x2, x3;
 2747:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2748: 
 2749:    double res = signedArea(x0, x1, x2);
 2750: 
 2751:    // In the quad case we need to add the area of the other triangle.
 2752:    if (isQuad()) {
 2753:       x3 = getLocalHorizontalNodePosition(3);
 2754:       double ar1 = signedArea(x0, x2, x3);
 2755:       double ar2 = signedArea(x0, x1, x3);
 2756:       double ar3 = signedArea(x1, x2, x3);
 2757:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2758: 
 2759:       res += ar1 + ar2 + ar3;
 2760:    }
 2761: 
 2762:    return res;
 2763: }
 2764: 
 2765: 
 2766: __inline__ __device__ void Element::nudgeToBarycenter(Point2 &p, const Side *origSide) const {
 2767: // Nudges the local-frame point, p, to the barycenter of the element. 
 2768: 
 2769:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2770: 
 2771:    Point3 c = origSide->toLocalFrame(toPoint3(center, centerZ())); // In local frame coordinates if ics == 2
 2772: 
 2773:    p = (1.0 - btrack_nudge)*p + btrack_nudge*toPoint2(c);
 2774: }
 2775: 
 2776: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2777:                                                                 (nodes[1]->isDry2()) ||
 2778:                                                                 (nodes[2]->isDry2()) ||
 2779:                                                                 (isQuad() && nodes[3]->isDry2());
 2780: }
 2781: 
 2782: __inline__ __device__ double Element::detJ_eta(void) const {
 2783:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2784:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2785: }
 2786: 
 2787: __inline__ __device__ double Element::detJ_xi(void) const {
 2788:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2789:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2790: }
 2791: 
 2792: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2793:    // In boundary sides, the element 1 is nullptr
 2794:    return side->elems[1] == nullptr; 
 2795: }
 2796: 
 2797: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2798:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2799:    // For ics == 2, this function uses local frame coordinates.
 2800: 
 2801:    assert(isQuad());
 2802: 
 2803:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2804:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2805:    // where vxi, veta, vb are vectors and c is the center of the element.
 2806: 
 2807:    Point2 p0, p1, p2, p3;
 2808: 
 2809:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2810: 
 2811:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2812:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2813:    // vectors vxi and veta connect the centers of opposite sides
 2814:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2815:    // vb is zero for parallelogram elements.
 2816:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2817: 
 2818:    //  The bilinear mapping is:
 2819:    //      P(s,t) = C + s*U + t*V + s*t*W
 2820:    //
 2821:    //  where:
 2822:    //    C = centroid (average of four vertices)
 2823:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2824:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2825:    //    W = bilinear correction; measures deviation from parallelogram
 2826:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2827:    //        W = 0 for parallelogram elements.
 2828:    //
 2829:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2830:    //
 2831:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2832:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2833:    //
 2834:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2835:    //
 2836:    //  Geometrically, (L) projects everything onto the direction
 2837:    //  perpendicular to W, where the mapping is purely affine.
 2838:    //
 2839:    //  The dot product with nb retains the nonlinear term:
 2840:    //
 2841:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2842:    //
 2843:    //  Geometrically, (Q) projects onto the W direction, where
 2844:    //  the nonlinearity lives.
 2845:    //
 2846:    //  We solve (L) for whichever variable has the larger coefficient
 2847:    //  (better conditioned back-substitution), substitute into (Q),
 2848:    //  and get a scalar quadratic in the other variable.
 2849:    // ================================================================
 2850: 
 2851:    // ---- Basis vectors ----
 2852:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2853:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2854:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2855:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2856:    // W: nonlinear correction. Difference between quad and parallelogram.
 2857:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2858:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2859: 
 2860:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2861:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2862:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2863:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2864:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2865: 
 2866:    // ---- nb: direction parallel to W, L1-normalized ----
 2867:    // We don't need a unit vector -- just a well-scaled direction parallel
 2868:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2869:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2870:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2871:    //
 2872:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2873:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2874:    // and the quadratic solver takes its linear path (a ~ 0).
 2875:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2876:    const double inv_wlen = 1.0 / wlen1;
 2877:    const Vector2 nb = vb * inv_wlen;
 2878: 
 2879:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2880:    // cross(nb, ·) projects onto the direction PERPENDICULAR to W.
 2881:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2882:    // What remains is a pure affine relationship between xi and eta.
 2883:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2884:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2885:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2886: 
 2887:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2888:    // dot(nb, ·) projects onto the W direction, where the nonlinearity lives.
 2889:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2890:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2891:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2892:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2893:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2894: 
 2895:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2896:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2897:    // minimizing round-off amplification.
 2898:    //
 2899:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2900:    // that uses predicated moves.
 2901:    //
 2902:    // if (fabs(Ls) > fabs(Lt)) {
 2903:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2904:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2905:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2906:    //    const double A = -Qw * Lt;
 2907:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2908:    //    const double C =  Qs * Lp - Qp * Ls;
 2909: 
 2910:    //    double eta1, eta2;
 2911:    //    solveQuadratic(A, B, C, eta1, eta2);
 2912: 
 2913:    //    // Pick root with smaller |eta| (domain centered at 0).
 2914:    //    // Ternary-> predicated move, no branch divergence.
 2915:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2916: 
 2917:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2918:    //    xi = (Lp - Lt * eta) / Ls;
 2919: 
 2920:    // } else {
 2921:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2922:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2923:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2924:    //    const double A = -Qw * Ls;
 2925:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2926:    //    const double C =  Qt * Lp - Qp * Lt;
 2927: 
 2928:    //    double xi1, xi2;
 2929:    //    solveQuadratic(A, B, C, xi1, xi2);
 2930: 
 2931:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2932: 
 2933:    //    eta = (Lp - Ls * xi) / Lt;
 2934:    // }
 2935:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2936:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2937:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2938:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2939:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2940: 
 2941:    // Quadratic:  A*r^2 + B*r + C = 0
 2942:    // (same formula for both cases, just with swapped coefficients)
 2943:    const double A = -Qw * Lb;
 2944:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2945:    const double C =  Qa * Lp - Qp * La;
 2946: 
 2947:    double r1, r2;
 2948:    solveQuadratic(A, B, C, r1, r2);
 2949: 
 2950:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2951:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2952: 
 2953:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2954:    const double other = (Lp - Lb * r) / La;
 2955: 
 2956:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2957:    xi  = solve_s ? r     : other;
 2958:    eta = solve_s ? other : r;
 2959: 
 2960: 
 2961:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2962:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2963:    eta = fmin(1.0, fmax(eta, -1.0));
 2964: 
 2965:    // ---- Shape functions ----
 2966:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2967:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2968:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2969:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2970:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2971:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2972:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2973:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2974: 
 2975:    return true;
 2976: }
 2977: 
 2978: /**
 2979:    Compute the shape coordinates of the point (xt,yt) in the element.
 2980:    @param xt (input): x-coordinate of the point
 2981:    @param shpCoords (output): shape coordinates of the point
 2982:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2983:    @return true if the point is inside the element, false otherwise
 2984: **/
 2985: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2986: 
 2987:    // Compute the shape coordinates of the point xt in the element.
 2988:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2989:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2990:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2991:    // from the local frame, so use additional check.
 2992: 
 2993:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2994: 
 2995:    if (isTri()) { // Triangular element
 2996: 
 2997:       // Horizontal local node coordinates. 
 2998:       Point2 x0 = nodes[0]->p;
 2999:       Point2 x1 = nodes[1]->p;
 3000:       Point2 x2 = nodes[2]->p;
 3001: 
 3002:       // If ics == 2, the node coordinates are transformed to local frame.
 3003:       if constexpr(ics==2) {
 3004:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 3005:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 3006:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 3007: 
 3008: 
 3009:          // Convert the node coordinates to the local frame centered at the element center
 3010:          x0 = toPoint2(origSide->toLocalFrame(p0));
 3011:          x1 = toPoint2(origSide->toLocalFrame(p1));
 3012:          x2 = toPoint2(origSide->toLocalFrame(p2));
 3013:       }
 3014: 
 3015:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3016:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3017:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3018:       shpCoords[3] = 0.0;
 3019: 
 3020: 
 3021:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3022:       const bool res = (tmpmin >= -small);  
 3023:       
 3024:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 3025:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3026: 
 3027:       
 3028:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3029:       // then we fix the negative shape coordinates.
 3030:       if ((tmpmin < 0) && fix) {
 3031: 
 3032:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3033:          // keeping the sum of the shape coordinates equal to 1.
 3034:          // I have tested and compared the new algorithm with the old one, and they give
 3035:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3036:          // The new algorithm should be faster since it is branchless.
 3037:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3038:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3039:          
 3040:          shpCoords[0] = (shpCoords[0] + a)*b;
 3041:          shpCoords[1] = (shpCoords[1] + a)*b;
 3042:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3043: 
 3044:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3045:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3046:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3047: 
 3048:          // Update the point coordinates for the new shape coordinates
 3049:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3050:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3051:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3052: 
 3053:       }
 3054: 
 3055:       // Check if the point is inside the element
 3056:       return res;      
 3057:    }
 3058:    else {
 3059:       assert(isQuad() && "computeShapeCoords");
 3060: 
 3061:    //    Point2 p = xt;
 3062: 
 3063:    //    // Reproject p the original side frame for ics=2
 3064:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 3065: 
 3066:    //    bool inside = false;
 3067: 
 3068: 
 3069: 
 3070:    //    if(ifl==0) then
 3071:    //      do i=1,4
 3072:    //        in1=nxq(1,i,i34(ie))
 3073:    //        in2=nxq(2,i,i34(ie))
 3074:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 3075:    //      enddo !i
 3076:    //      tmp=minval(swild2(1:4))/area(ie)
 3077:    //      if(tmp>-small2) then
 3078:    //        inside=1
 3079:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3080:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3081:    //      endif !inside quad
 3082:    //    else !ifl=1 - already inside
 3083:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3084:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3085:    //      !Update pt
 3086:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3087:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3088:    //    endif !ifl
 3089: 
 3090: 
 3091:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3092: 
 3093:    }
 3094: 
 3095:    assert(false && "computeShapeCoords: should never reach this point");
 3096:    return false;  // Never reached
 3097: 
 3098: }
