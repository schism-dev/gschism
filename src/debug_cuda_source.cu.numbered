 1772: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1773:    // Computes the 3D normal vector to the element at level k
 1774:    // Returns the normal vector and the area of the element
 1775: 
 1776:       if (isTri()) {
 1777:          // For triangles...
 1778: 
 1779:          // Gets the normal vector to the element (with a length equal to twice the area)
 1780:          if constexpr(ics==1) {
 1781:             const int kb0 = max(k, nodes[0]->kb);
 1782:             const int kb1 = max(k, nodes[1]->kb);
 1783:             const int kb2 = max(k, nodes[2]->kb);
 1784: 
 1785:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1786:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1787:             
 1788:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1789:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1790:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1791:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1792: 
 1793:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1794:             area3D = 0.5*len;
 1795: 
 1796:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1797: 
 1798:             return {nx/len, ny/len, nz/len};
 1799: 
 1800:            
 1801:          }
 1802:          else {  // lat/lon
 1803:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1804:             return {0.0, 0.0, 0.0};
 1805: 
 1806:          } // if ics
 1807:       }
 1808:       else {
 1809:          // For quads...
 1810: 
 1811:          assert(false && "Element normal vector: quads not yet implemented");
 1812:          return {0.0, 0.0, 0.0};
 1813: 
 1814: 
 1815:       }
 1816:    }
 1817: 
 1818: /**
 1819:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1820:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1821:    If the segment is completely inside the element, then it returns true.
 1822: 
 1823:    This function assumes:
 1824:    - The initial point is on a side of the element. 
 1825:    - Its position is given by parameter t in the range [0,1].
 1826:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1827:       intersects the element (elements are convex).
 1828: 
 1829:    To find the intersection point, this function does the following:
 1830:    - it finds the intersection of the line segment with all the element side lines,
 1831:       except for the one that contains the initial point.
 1832:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1833:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1834:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1835:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1836:       track segment is almost parallel to the element side line.
 1837: 
 1838:    Inputs:
 1839:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1840:    @param x2, y2: other end of the line segment
 1841: 
 1842:    Outputs:
 1843:    @param side:  side that intersects the line segment (input and output)
 1844:    @param nextElement (output): element that contains the intersection point
 1845:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1846:    @param zint (input/output): Vertical coordinate of the intersection point
 1847: 
 1848:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1849:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1850:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1851: 
 1852:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1853:    (Delta) being zero.
 1854: 
 1855:    The intersection2 point happens when:
 1856:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1857:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1858:    
 1859:    Assumption: the 4 points (including those of the side segment) are different.
 1860:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1861:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1862:    If true, (xIntersect,yIntersect) is the intersection.				
 1863:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1864: **/
 1865: 
 1866: 
 1867: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1868:                                               double &t, double& tIntersect) {
 1869:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1870:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1871: 
 1872:    double closest_intersect_t = 1e10;
 1873:    bool found_intersection = false;
 1874: 
 1875:    for (int i = 0; i < i34; i++) {
 1876: 
 1877:       Side *side2 = sides[i];
 1878: 
 1879:       // (x3,y3)-(x4,y4) is the element side line
 1880:       const Point2 x3 = side2->n1->p;
 1881:       const Point2 x4 = side2->n2->p;
 1882: 
 1883:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1884:       const double delta = cross(x2 - x1, x3 - x4);
 1885: 
 1886:       if (abs(delta) > 0) {
 1887: 
 1888:          const double delta1 = cross(x3 - x1, x3 - x4);
 1889:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1890: 
 1891:          // Solves the two linear equations for tt1 and tt2
 1892:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1893:          const double tt2 = delta2/delta;
 1894: 
 1895:          if (tt1 >= -small2 && tt2 >= -small2 && tt2 <= 1.0 + small2 && tt1 <= 1.0 + small2) {
 1896:             closest_intersect_t = min(closest_intersect_t, tt1);
 1897:             side = side2;
 1898:             nextElement = side->otherElem(this);
 1899:             t = tt2;
 1900:             tIntersect = max(small, min(tt1, 1.0-small));
 1901:             found_intersection = true;
 1902:          }
 1903:       
 1904:       }
 1905:       else {  // parallel segments
 1906: 
 1907: printf("XXXXXXX Parallel segments !!!!!!!!!!!!!!!!!!!!!!\n");
 1908:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1909:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1910: 
 1911:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1912:          const double dist = dot(x1 - x3, side2->n);
 1913:          if (abs(dist) < small*length(x3 - x4)) {
 1914:             const double2 unitarySide = normalize(x4 - x3);
 1915:             const double len = dot(x2 - x1, unitarySide);
 1916:             t = t + len;
 1917:             t = max(0.0, min(t, 1.0));
 1918:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1919: 
 1920: 
 1921:             // tIntersect = max(small, min(tt1, 1.0-small));
 1922:             // t = tt2;
 1923:             found_intersection = true;
 1924:          }
 1925:       }
 1926: 
 1927: 
 1928:    }
 1929: 
 1930: if (!found_intersection) 
 1931: {
 1932:    printf("AAAAAAA %i  %i\n", nextElement->containsPoint(x1), nextElement->containsPoint(x2));
 1933:    printf("@@@()()@@@@YYYY@@@@@@@@@ No intersection found closest_intersect_t = %.17g, x1 = (%e,%e), x2 = (%e,%e)\n", closest_intersect_t, x1.x, x1.y, x2.x, x2.y);      
 1934:    
 1935: for (int i = 0; i < i34; i++) {
 1936: 
 1937:    Side *side2 = sides[i];
 1938: 
 1939:    // (x3,y3)-(x4,y4) is the element side line
 1940:    const Point2 x3 = side2->n1->p;
 1941:    const Point2 x4 = side2->n2->p;
 1942: 
 1943:    // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1944:    const double delta = cross(x2 - x1, x3 - x4);
 1945: 
 1946:    if (abs(delta) > 0) {
 1947: 
 1948:       const double delta1 = cross(x3 - x1, x3 - x4);
 1949:       const double delta2 = cross(x2 - x1, x3 - x1); 
 1950: 
 1951:       // Solves the two linear equations for tt1 and tt2
 1952:       const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1953:       const double tt2 = delta2/delta;
 1954: 
 1955: printf("CCCCCC i = %d, delta = %.17g, delta1 = %.17g, delta2 = %.17g, tt1 = %.17g, tt2 = %.17g\n", i, delta, delta1, delta2, tt1, tt2);      
 1956: 
 1957:       if ((tt1 >= -small2) && (tt2 >= -small2) && (tt2 <= 1.0 + small2) && (tt1 <= 1.0 + small2)) {
 1958:          closest_intersect_t = min(closest_intersect_t, tt1);
 1959:          side = side2;
 1960:          nextElement = side->otherElem(this);
 1961:          t = tt2;
 1962:          tIntersect = max(small, min(tt1, 1.0-small));
 1963:          found_intersection = true;
 1964:          printf("DDDDDD found_intersection = true, tt1 = %.17g, tt2 = %.17g\n", tt1, tt2);      
 1965:       }
 1966:    
 1967:    }
 1968: }
 1969: 
 1970: }
 1971:    assert(found_intersection && "No intersection found");
 1972: 
 1973:    // found_intersection should always be true, since we checked all the sides.  
 1974:    return found_intersection;
 1975: }
 1976: 
 1977: 
 1978: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1979:                                              Point3 &xt, double zint, Vector3 &u_int) {
 1980: 
 1981: // printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1982: 
 1983:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1984:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 1985:    // curElement.
 1986: 
 1987:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1988:    // And uses this velocity instead to continue the tracking.
 1989: 
 1990:    // computes the intersection point in cartesian coordinates
 1991:    Point2 intersection = nextSide->p_t(tt);
 1992: 
 1993:    // Nudges the point to the barycenter of the element. 
 1994:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1995:    // next segment intersects the element sides. 
 1996:    curElem->nudgeToBarycenter(intersection);
 1997: 
 1998: // double shpCoords[4];
 1999: // bool res = computeShapeCoords(intersection, shpCoords, false);
 2000: // printf("JJJJJ shpCoords = %.17g, %.17g, %.17g\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2001: 
 2002:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2003:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2004:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2005:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2006: 
 2007:    // If the side is an open boundary, the tangential velocity is set to zero.
 2008:    if (nextSide->isBnd()) vtan = 0.0;
 2009: 
 2010:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2011:    const double us = vtan*nextSide->t().x;
 2012:    const double vs = vtan*nextSide->t().y;
 2013:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);  //  XXXX Why not use the side's velocity?
 2014: 
 2015: 
 2016:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2017:    const double len2 = norm2(intersection - toPoint2(xt));
 2018:    const double vel2 = dot(u_int, u_int);        
 2019:    
 2020:    // The end of this tracking segment is now the intersection point.
 2021:    xt = {intersection.x, intersection.y, zint};
 2022: 
 2023:    u_int = {us, vs, ws};
 2024: // printf("@@@@@@@XXXX@@@@@@@@@ idx = %d, us = %.17g, vs = %.17g, ws = %.17g, dt = %.17g\n", curElem->idx, us, vs, ws, dt);   
 2025:    
 2026: }
 2027: 
 2028: /**
 2029:  * Tracks a particle through elements and vertical levels in the mesh.
 2030:  * 
 2031:  * @param x0,y0,z0     Starting position coordinates
 2032:  * @param xt,yt,zt     Target position coordinates
 2033:  * @param dtb          Time step for tracking
 2034:  * @param uuint,vvint,wwint Initial velocity components
 2035:  * @param nextElem     Starting/resulting element index
 2036:  * 
 2037:  * @return Status code of type trackExitCodes
 2038:  * 
 2039:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2040:  * of the details are different. The idea is that the code requires less branches and is better fit
 2041:  * for GPU execution.
 2042:  * 
 2043:  * The main ideas here are:
 2044:  * - The starting point is expected to be in the starting element.
 2045:  * - since the starting point is inside the element, there are only two cases: 
 2046:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2047:  *     (b) it does not and (xt,yt) is already in the starting element.
 2048:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2049:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2050:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2051:  * - tt1 can be positive or negative. We only consider the positive values.
 2052:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2053:  * - The next intersection will occur at the smallest positive tt1.
 2054:  * - This intersection will be the next (x0,y0) position.
 2055:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2056:  *   of getting stuck in a loop.
 2057:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2058:  *   was found.
 2059:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2060:  */
 2061: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2062:                                                        Element *&nextElem, int &jlev, double &dt,
 2063:                                                        const Side *origSide) {
 2064:                                                             
 2065:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2066:    // else to do. This means that the full step occurred within the current element.
 2067:    assert(!isDry && "Starting element is dry");
 2068:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2069: 
 2070:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2071:       assert(!isDry && "Target point is inside a dry element");
 2072: 
 2073:       interpolateVelocities(xt, u_int);
 2074: 
 2075:       nextElem = this;
 2076: 
 2077: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2078:       return true;
 2079:    }
 2080: 
 2081: if (!containsPoint(toPoint2(x0)))   
 2082: {
 2083:    double shpCoords[4];
 2084:    printf("XXXXXXXXXXXXXXXXXXXXXXXX Starting point is not inside the element x0 = %.17g, %.17g, %.17g\n", x0.x, x0.y, x0.z);
 2085:    computeShapeCoords(toPoint2(x0), shpCoords, false);
 2086:    printf("XXXXXXXXXXXXXXXXXXXXXXXX shpCoords = %.17g, %.17g, %.17g, %.17g\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2087:    computeShapeCoords(toPoint2(xt), shpCoords, true);
 2088:    printf("XXXXXXXXXXXXXXXXXXXXXXXX shpCoords = %.17g, %.17g, %.17g, %.17g\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2089:    // if (jlev==0)addDebugPlot(x0, xt, 0xFFAF00, 'x');  // yellow
 2090:    // if (jlev==10)addDebugPlot(x0, xt, 0xFFCF00, 'x');  // yellow
 2091:    return true;
 2092: }
 2093:    assert(containsPoint(toPoint2(x0)) && "XXXX Starting point is not inside the element");
 2094: 
 2095: 
 2096:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2097:    assert(len2 > 0.0 && "Zero length track"); 
 2098:    
 2099:    // const int MAX_ITERATIONS = 1000;
 2100:    
 2101:    double t;
 2102:    Side *nextSide = nullptr;
 2103:    double tIntersect = 1e10;
 2104:    double zint = x0.z;
 2105: 
 2106: 
 2107:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2108:    // (x0,y0) is inside the element but the target point is not.
 2109:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2110: 
 2111:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2112:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2113: 
 2114:    if (nextElem != nullptr) nextElem->nudgeToBarycenter(xtmp);
 2115:    
 2116: 
 2117:    assert(found_intersection && "No intersection found at %d");
 2118: 
 2119:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2120:    xt = {xtmp.x, xtmp.y, zint};
 2121: 
 2122:    // if the tracking segment goes out of water (either dry or edge boundary)
 2123:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2124: 
 2125: 
 2126:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2127: // if (jlev==10)addDebugPlot(x0, xt, 0x0000DF, '+');  // dark blue
 2128: 
 2129:       nextElem = this;
 2130:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2131:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2132:       return true;    
 2133:    }
 2134: 
 2135: 
 2136: if (!nextElem->containsPoint(toPoint2(xt))) 
 2137: {
 2138:    printf("XXXXXXXXXXXXXXXXXXXXXXXX Target point is not inside the next element jlev = %d, x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g\n", jlev, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 2139: // if (jlev==10)addDebugPlot(x0, xt, 0xFFAF00, 'x');  // yellow
 2140:    return true;
 2141: }
 2142:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2143:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2144:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2145: 
 2146:    nextElem->interpolateVelocities(xt, u_int); 
 2147: // if (jlev==10)addDebugPlot(x0, xt, 0xFF0000, 'x');  // red  
 2148: 
 2149:    assert(nextElem != this && "Next element is the same as the current element");
 2150: 
 2151:    return true;
 2152: }
 2153: 
 2154: 
 2155: __inline__ __device__ double Element::computeSignedArea(void) const {
 2156:    // Compute the area of the element
 2157: 
 2158:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2159: 
 2160:    // In the quad case we need to add the area of the other triangle.
 2161:    if (isQuad()) {
 2162:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2163:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2164:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2165:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2166: 
 2167:       res += ar1;
 2168:    }
 2169: 
 2170:    return res;
 2171: }
 2172: 
 2173: 
 2174: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2175:                                                                 (nodes[1]->isDry2()) ||
 2176:                                                                 (nodes[2]->isDry2()) ||
 2177:                                                                 (i34==4 && nodes[3]->isDry2());
 2178: }
 2179: 
 2180: __inline__ __device__ double Element::detJ_eta(void) const {
 2181:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2182:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2183: }
 2184: 
 2185: __inline__ __device__ double Element::detJ_xi(void) const {
 2186:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2187:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2188: }
 2189: 
 2190: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2191:    // In boundary sides, the element 1 is nullptr
 2192:    return side->elems[1] == nullptr; 
 2193: }
 2194: 
 2195: 
 2196: 
 2197: /**
 2198:    Compute the shape coordinates of the point (xt,yt) in the element.
 2199:    @param xt (input): x-coordinate of the point
 2200:    @param shpCoords (output): shape coordinates of the point
 2201:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2202:    @return true if the point is inside the element, false otherwise
 2203: **/
 2204: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2205:                                             bool fixNegshpCoord) const {
 2206: 
 2207:    // Compute the shape coordinates of the point xt in the element.
 2208:    if (i34==3) {
 2209:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2210:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2211:       // and in this case, the pt will be nudged into the element
 2212:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2213:       // from the local frame, so use additional check.
 2214: 
 2215:       Point2 x0, x1, x2;
 2216: 
 2217:       if constexpr(ics==1) {
 2218:          x0 = nodes[0]->p;
 2219:          x1 = nodes[1]->p;
 2220:          x2 = nodes[2]->p;
 2221:       }
 2222:       else // lat/lon
 2223:       {
 2224:          Error("Not implemented yet");
 2225:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2226:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2227:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2228:       }
 2229: 
 2230:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2231:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2232:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2233:       shpCoords[3] = 0.0;
 2234: 
 2235:       const double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2236:       const bool res = (tmpmin >= -small);     
 2237: 
 2238:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2239:       // then we fix the negative shape coordinates.
 2240:       if ((tmpmin < 1.0e-4) && fixNegshpCoord) {
 2241: 
 2242:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2243:          // keeping the sum of the shape coordinates equal to 1.
 2244:          // I have tested and compared the new algorithm with the old one, and they give
 2245:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2246:          // The new algorithm should be faster since it is branchless.
 2247:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2248:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2249:          
 2250:          shpCoords[0] = (shpCoords[0] + a)*b;
 2251:          shpCoords[1] = (shpCoords[1] + a)*b;
 2252:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2253: 
 2254:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2255:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2256:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2257:          }
 2258: 
 2259:          // Update the point coordinates for the new shape coordinates
 2260:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2261:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2262:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2263: 
 2264:       }
 2265: 
 2266:       // Check if the point is inside the element
 2267:       return res;      
 2268:    }
 2269:    else {
 2270:       Error("Not implemented yet");
 2271: #ifdef QUADS
 2272:       // Reproject pt in eframe of nel for ics=2
 2273:       if constexpr(ics==1) {
 2274:          xn2 = xt; 
 2275:          yn2 = yt;
 2276:       }
 2277:       else {
 2278:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2279:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2280:       }
 2281: 
 2282:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2283: #endif
 2284:    }
 2285: 
 2286:    assert(false && "computeShapeCoords: should never reach this point");
 2287:    return false;  // Never reached
 2288: 
 2289: }
 2290: 
 2291: 
 2292: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2293: // Convert shape coordinates to cartesian coordinates
 2294: 
 2295:    if (i34 == 3) {
 2296:       // Triangular element
 2297:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2298:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2299:    }
 2300:    else {
 2301:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2302:    }
 2303: 
 2304: }
 2305: 
 2306: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2307:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2308:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2309:    // The formula for the integral is:
 2310:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2311: 
 2312:    printf("intPhiPhi: TEST\n");
 2313: 
 2314:    const Node *n0 = nodes[0];
 2315:    const Node *n1 = nodes[1];
 2316:    const Node *n2 = nodes[2];
 2317:    const Node *n3 = nodes[3];
 2318: 
 2319:    const Vector2 p0 = n0->p;
 2320:    const Vector2 p1 = n1->p;
 2321:    const Vector2 p2 = n2->p;
 2322:    const Vector2 p3 = n3->p;
 2323: 
 2324:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2325:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2326:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2327:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2328: 
 2329:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2330: }
 2331:    
 2332: 
 2333: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2334:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2335:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2336:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2337:    // The formula is also based on the identity:
 2338:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2339:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2340: 
 2341:    printf("intGradPhiGradPhi: TEST\n");   
 2342: 
 2343:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2344: 
 2345:    const double x0 = nodes[0]->p.x;
 2346:    const double y0 = nodes[0]->p.y;
 2347:    const double x1 = nodes[1]->p.x;
 2348:    const double y1 = nodes[1]->p.y;
 2349:    const double x2 = nodes[2]->p.x;
 2350:    const double y2 = nodes[2]->p.y;
 2351:    const double x3 = nodes[3]->p.x;
 2352:    const double y3 = nodes[3]->p.y;
 2353: 
 2354:    double res = 0.0;
 2355:    
 2356:    // Quadrature points in xi and eta coordinates
 2357:    #pragma unroll
 2358:    for (int i = 0; i < 4; i++) {
 2359:       // For each quadrature point...
 2360: 
 2361:       const Point2 p = GaussPoint(i);
 2362:       const double eta = p.x;
 2363:       const double xi  = p.y;
 2364: 
 2365:       // Jacobian entries at the Gauss point p
 2366:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2367:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2368:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2369:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2370: 
 2371:       const double detJ = jacobianDet(p);
 2372:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2373: 
 2374:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2375:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2376:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2377:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2378:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2379: 
 2380:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2381:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2382:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2383:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2384:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2385: 
 2386:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2387:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2388:    }
 2389: 
 2390:    return res;
 2391: }
 2392: 
 2393: 
 2394: /**  Interpolate velocities at a given point (xt,yt,zt)
 2395: 
 2396:    @param xt, yt, zt: coordinates of the point to interpolate
 2397:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2398: 
 2399:    This is done in four steps:
 2400: 
 2401:    1. Find the shape coordinates for the final position in the element.
 2402:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2403:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2404:       z levels at xt, yt at each step.   
 2405:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2406:       horizontally and vertically.
 2407: **/
 2408: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2409:    // Interpolate the velocities at the point xt. 
 2410:    // This function works the same for triangular and quadrilateral elements.
 2411:    double shpCoord[4];
 2412: 
 2413:    // First step is to compute the shape coordinates of (xt,yt)
 2414:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2415: if ((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) < -small)) printf("XXXXXX shpCoord = %.17g, %.17g, %.17g, %.17g\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);   
 2416:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2417: 
 2418:    // Second step is to find the level that contains zt
 2419:    // Uses a binary search to find the level
 2420:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2421:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2422:    int R = nvrt - 1;
 2423: 
 2424:    // Get the z coordinates at the nodes of the element at the levels L and R
 2425:    double zLAtNodes[4], zRAtNodes[4];
 2426:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2427:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2428: 
 2429:    double zL = interpolate(shpCoord, zLAtNodes);
 2430:    double zR = interpolate(shpCoord, zRAtNodes);
 2431:    
 2432:    // Interpolates vertically the velocities
 2433:    double wght1, wght2;
 2434:    if (xt.z<=zL) {
 2435:       wght1 = 1.0;
 2436:       wght2 = 0.0;
 2437:    }
 2438:    else if (xt.z>=zR) {
 2439:       wght1 = 0.0;
 2440:       wght2 = 1.0;
 2441:    }
 2442:    else {
 2443:       // Perform a binary search to find the levels between L and R that contain xt.z
 2444:       while (R - L > 1) {
 2445:          int M = (L + R) / 2;
 2446: 
 2447:          double zMAtNodes[4];
 2448:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2449:          double zM = interpolate(shpCoord, zMAtNodes);
 2450:          if (zM < xt.z) 
 2451:          {
 2452:             L = M;
 2453:             zL = zM;
 2454:          }
 2455:          else 
 2456:          {
 2457:             R = M;
 2458:             zR = zM;
 2459:          }
 2460:       }
 2461:       assert(L == R-1);
 2462:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2463: 
 2464:       wght2 = (xt.z - zL)/(zR - zL);
 2465:       wght1 = 1.0 - wght2;
 2466:    }
 2467: 
 2468:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2469:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2470: 
 2471:    // Neither of the interpolated velocities should be NaN
 2472:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2473: 
 2474: }
 2475: 
 2476: 
 2477: 
 2478: 
 2479: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2480: 
 2481:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2482:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2483:    const Node *n1 = side->n1;
 2484:    const Node *n2 = side->n2;
 2485: 
 2486:    bool n1_match = (n1->nodeBnd->segment == segment);
 2487:    bool n2_match = (n2->nodeBnd->segment == segment);
 2488: 
 2489:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2490:    if (n1_match && n2_match) {
 2491:       return 0.5;
 2492:    } else if (n1_match) {
 2493:       return 1.0;
 2494:    } else if (n2_match) {
 2495:       return 0.0;
 2496:    }
 2497: 
 2498:    return 0.0;
 2499: }
 2500: 
 2501: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2502: 
 2503: 
 2504: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2505: 
 2506:    const double w1 = getBoundaryArrayValueWeight();
 2507:    const double w2 = 1.0 - w1;
 2508:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2509:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2510: 
 2511:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2512: }
 2513: 
 2514: 
 2515: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2516:    const double w1 = getBoundaryArrayValueWeight();
 2517:    const double w2 = 1.0 - w1;
 2518:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2519:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2520: 
 2521:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2522: 
 2523: }
