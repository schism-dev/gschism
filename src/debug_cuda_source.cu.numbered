 5004:    __global__ void computeFlowBcVelocities(double time) {
 5005: 
 5006:       SIDE_BND(sideBnd);
 5007: 
 5008:       const Side *side = sideBnd->side;
 5009:  
 5010:       const bool isDry = side->isDry;
 5011:       const bool isLand = sideBnd->segment->isLand;
 5012: 
 5013:    
 5014:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5015: 
 5016:       if (isDry || isLand) return;
 5017: 
 5018:       // For wet sides in open boundaries...
 5019:       const Vector2 n = side->n;
 5020:       const BoundarySegment *segment = sideBnd->segment;
 5021: 
 5022:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5023: 
 5024:       const int ifltype = segment->ifltype;
 5025: 
 5026:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5027:       const Vector2 r_nuth0 = r_uth0*n;
 5028: 
 5029: 
 5030:       if (ifltype == 1 || ifltype == 2) {
 5031:       
 5032:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5033: 
 5034:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5035:          
 5036:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5037:          
 5038:       } else if (ifltype == -1) { // Flather 1
 5039: 
 5040:          for (int k = 0; k < nvrt; k++) {
 5041: 
 5042:             // uth is the normal vel.; no ramp up
 5043:             const double uth = sideBnd->nuth(k);
 5044:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5045: 
 5046:             sideBnd->ubc[k] += uth*n;
 5047:          }
 5048: 
 5049:       } else if (ifltype == 3 || ifltype == 5) {
 5050:          // vnth0=0 !normal vel.
 5051: 
 5052:          Vector2 r_u1_bar = {0.0, 0.0};
 5053:          // Computes the contribution to the velocity from all tide frequencies
 5054:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5055: 
 5056:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5057:             const Vector2 umo  = sideBnd->umo(jfr); 
 5058: 
 5059:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5060:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5061:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5062:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5063: 
 5064:          }
 5065: 
 5066: 
 5067:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5068: 
 5069:       } // if (ifltype = 3 || ifltype == 5
 5070: 
 5071: 
 5072: 
 5073:    }
 5074: 
 5075:    __global__ void computeElevationBoundaryConditions(double time) {
 5076:       // Compute elevation essential boundary conditions 
 5077: 
 5078:       NODE_BND(nodeBnd); // Each boundary node.
 5079: 
 5080:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5081: 
 5082:       const Node *node = nodeBnd->node;
 5083:       const BoundarySegment *segment = nodeBnd->segment;
 5084:       const int iettype = segment->iettype;
 5085:       
 5086: 
 5087:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5088:       double eic = 0.0;
 5089:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 5090:       else                 eic = 0.0;
 5091: 
 5092:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5093:       const double r_eth = ramp*nodeBnd->eth;
 5094:       double r_eta1_bar = 0.0;
 5095: 
 5096: 
 5097:       // Compute tide elevation
 5098:       if (iettype == 3 || iettype == 5) {   
 5099: 
 5100:          if constexpr(iloadtide==1) { // loading tide
 5101:             assert(false && "Loading tide not implemented");
 5102:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5103:          }
 5104:          
 5105:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5106: 
 5107:             const double efa  = nodeBnd->efa[jfr]; 
 5108:             const double emo  = nodeBnd->emo[jfr]; 
 5109: 
 5110:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5111:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5112:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5113: 
 5114:          } // for jfr
 5115: 
 5116:       } // if iettype
 5117: 
 5118:       switch (iettype) {
 5119:          case 1:
 5120:          case 2:
 5121:          case 4:
 5122:             nodeBnd->elbc = r_eic + r_eth;
 5123:             break;
 5124:          case 3:
 5125:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5126:             break;
 5127:          case 5:
 5128:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5129:             break;
 5130:       } // switch
 5131: 
 5132: 
 5133:       //Add inverse barometric effects
 5134:       if (iettype != 0 && inv_atm_bnd == 1) {
 5135:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5136:       }
 5137: 
 5138:    }
 5139: 
 5140: 
 5141:    __global__ void computeHorizontalViscosity(void) { 
 5142: 
 5143:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5144: 
 5145:       SIDE(side);
 5146: 
 5147:       if (side->isDry) return;
 5148: 
 5149:       for (int k = 0; k < nvrt; k++) {
 5150:          side->nuGradU[k] = {0.0, 0.0};
 5151:       }
 5152: 
 5153:       if constexpr(ihorcon == 1) {
 5154:          for (int k = side->kb; k < nvrt - 1; k++) {
 5155:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5156:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5157:             // By Zhang and Baptista.
 5158: 
 5159:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5160:             // This is a standard discretization of the Laplacian operator.
 5161:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5162:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5163:             // Gamma is hvis_coef0 in the code.
 5164:             // The value of gamma needs to be < 0.5.
 5165: 
 5166:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5167:             // side under consideration in each of the two possible elements that share the side.
 5168:             Vector2 sumU = {0.0, 0.0};
 5169:             for (int l = 0; l < 2; l++) {
 5170:                const Element *elem = side->elems[l];
 5171: 
 5172:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5173: 
 5174:                // Find the local index of the side in the element
 5175:                const int idxSide = elem->sideLocalIdx(side);
 5176: 
 5177:                // Find the two sides that are connected to the side under consideration
 5178:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5179:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5180: 
 5181:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5182: 
 5183:             }
 5184: 
 5185:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5186: 
 5187:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5188:    
 5189:          }
 5190:       }
 5191:       else if constexpr(ihorcon == 2) {
 5192:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5193:       }
 5194: 
 5195: 
 5196:    }
 5197: 
 5198: 
 5199:    __global__ void setEssentialBC(void) {
 5200:       // Set essential boundary conditions 
 5201:       NODE(node); // Each boundary node
 5202:       NodeBoundary *nodeBnd = node->nodeBnd;
 5203:       
 5204:  
 5205:       // Check if this node has essential BC
 5206:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5207:          // Verify BC value is valid
 5208:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5209: 
 5210:        
 5211:          // Set diagonal to 1 and zero off-diagonals
 5212:          node->coeffDiag = 1.0;
 5213: 
 5214:          for (int j = 0; j < node->numNodes; j++) {
 5215:                node->coeffMatrix[j] = 0.0;
 5216:          }
 5217:          
 5218:          // Set solution and RHS to BC value
 5219:          node->mX  = nodeBnd->elbc;
 5220:          node->qel = nodeBnd->elbc;
 5221: 
 5222:       } else {
 5223:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5224: 
 5225:          for (int j = 0; j < node->numNodes; j++) {
 5226:                Node* nbNode = node->nodes[j];
 5227:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5228:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5229:                   // Verify neighbor's BC value
 5230:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5231: 
 5232:                   // Subtract contribution to RHS
 5233:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5234:                   node->coeffMatrix[j] = 0.0;  
 5235:                }
 5236:          }
 5237:       }
 5238:    }
 5239: 
 5240: 
 5241:    __global__ void updateElevation(void) {
 5242:       NODE(node);
 5243: 
 5244: 
 5245:       node->eta2 = node->mX;
 5246: 
 5247:       node->updateZCoordData();
 5248:    }
 5249: 
 5250: 
 5251:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5252: 
 5253:       SIDE(side);
 5254: 
 5255:       side->U = {0.0, 0.0}; 
 5256:          
 5257:       if(side->isDry) return;
 5258: 
 5259:       // Vertically integrated velocity U
 5260:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5261:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5262:          side->U += side->Dz(k + 1)*uc;  
 5263:       }
 5264: 
 5265:    }
 5266: 
 5267:    __global__ void computeBottomDragVegetation(void) {
 5268:       // UNFINISHED. CHECK THIS:
 5269:       // How many kernels are needed? Why so many for loops?
 5270:       // Is the loop on sides needed?
 5271: 
 5272:       NODE(node);
 5273: 
 5274: 
 5275:       const int    kb      = node->kb;
 5276:       const double htot    = node->htot2(); 
 5277:       
 5278:       if (node->isDry) {
 5279:          // Default values for dry nodes
 5280:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5281:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5282: 
 5283:          return;
 5284:        
 5285:       }
 5286: 
 5287:       // Computes bottom drag Cd based on the selected nchi
 5288:       node->computeBottomDragCd();
 5289:       
 5290: 
 5291: 
 5292:       //   Bottom stress in m^2/s^2
 5293:       if (node->rho[kb + 1] >= -98.0)
 5294:       {
 5295:          const double mag_u = length(node->u2[kb + 1]);
 5296:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5297: 
 5298:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5299:          // !sediment erosion: this part needs more documentation
 5300:       }
 5301:     
 5302: 
 5303: 
 5304:       // Compute vegetation parameters
 5305:       //--------------------------------
 5306: 
 5307:       // SAV constants
 5308:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5309:       constexpr double veg_cfpsi = 0.16;
 5310: 
 5311:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5312:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5313: 
 5314:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5315:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5316:          int kbin = 0; // bin index
 5317:          for (int k = kb; k < nvrt; k++) {
 5318:             // Computes node height above the bottom level
 5319:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5320:             assert(false && "Vertical variation of vegetation not implemented");
 5321: 
 5322:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5323:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5324:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5325:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5326:             // } else {
 5327:             //    // Find the bin at which the current vertical level is
 5328:             //    while (kbin<nbins_veg_vert) {
 5329:             //       const double zn = node->z[kbin];
 5330:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5331:             //          break;
 5332:             //       } // if
 5333:             //       kbin++;
 5334:             //    } // while
 5335:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5336: 
 5337:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5338:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5339:                
 5340:             //    // Linear interpolation of the vegetation parameters
 5341:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5342:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5343:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5344:             // } // if rl10
 5345: 
 5346:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5347: 
 5348:          } // for k
 5349: 
 5350: 
 5351:       } else { // Ganthy (iveg==2)
 5352:       //  Modify canopy height, diameter, and density
 5353: 
 5354:          // Make sure there is vegetation on this node
 5355:          if (node->veg_h_unbent > 0.0) {
 5356:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5357: 
 5358:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5359:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5360:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5361: 
 5362:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5363:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5364:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5365:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5366:          } // if veg_h_unbent
 5367: 
 5368:          for (int k = 0; k < nvrt; k++) {
 5369:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5370:          } // for k
 5371:       
 5372: 
 5373:       } // if iveg
 5374:      
 5375: 
 5376:       // Compute vertical mean of veg_alpha3D
 5377:       if (iveg != 0) {
 5378:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5379:          double sum1=0.0;
 5380:          double sum2=0.0;
 5381:          // Integrate over each level under the canopy...
 5382:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5383:             const double Dz = node->Dz(k);
 5384: 
 5385:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5386:             sum2 += Dz;
 5387: 
 5388:          } // for k
 5389:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5390:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5391: 
 5392:       } // if iveg
 5393: 
 5394:    }
 5395: 
 5396:    __global__ void computeVegetationAndDragParameters(void) {
 5397:       // Computes the vegetation and drag model parameters:
 5398:       // chi, \tilde\chi, beta, \breve{H}
 5399:       
 5400:       SIDE(side);
 5401: 
 5402:       side->hhat = 0.0;
 5403:       side->chi2 = 0.0;
 5404:       side->chi = 0.0;
 5405:       side->veg_c2 = 0.0;
 5406:       side->veg_beta = 0.0;
 5407: 
 5408:       if (side->isDry) return;
 5409: 
 5410:       const double htot = side->htot2();
 5411:       const int    kb   = side->kb;
 5412: 
 5413:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5414: 
 5415:       const double veg_h     = side->veg_h();
 5416:       const double veg_nv    = side->veg_nv();
 5417:       const double veg_c     = side->veg_c();
 5418:       const double veg_beta  = side->veg_beta;
 5419:       const double veg_alpha = side->veg_alpha_vert_mean();
 5420: 
 5421:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5422:       // Velocity magnitude at the bottom level
 5423:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5424:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5425:       side->chi2 = side->Cd()*vmag1;
 5426:       side->chi  = side->chi2;
 5427:       if constexpr(iveg != 0) {
 5428:          const Node *n1 = side->n1;
 5429:          const Node *n2 = side->n2;
 5430:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5431:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5432:       }
 5433: 
 5434:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5435: 
 5436:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5437:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5438:       double magUa = 0.0;
 5439:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5440:          // 3D wet side with veg...
 5441: 
 5442:          double magUa = 0.0;
 5443:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5444:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5445: 
 5446:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5447:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5448:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5449: 
 5450:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5451:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5452: 
 5453:                // Velocity magnitude at the bottom (l) of the level
 5454:                const double ul = length(side->u2[k]);
 5455: 
 5456:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5457:                magUa += Dz*0.5*(uh + ul);
 5458: 
 5459:             } // if HasVegetation
 5460:          } // for k
 5461:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5462: 
 5463:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5464:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5465:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5466:             const double zCpy = side->zTopCanopy();
 5467:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5468:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5469:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5470:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5471:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5472:          } // if isSubmerged
 5473:       } // if iveg   
 5474: 
 5475:       // Computes the friction modified depth, \breve{H} in notes
 5476:       if (side->is2D()) { // 2D
 5477: 
 5478:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5479:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5480: 
 5481:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5482: 
 5483:          side->hhat = htot*htot/fricH; 
 5484: 
 5485:       } else { // 3D
 5486:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5487: 
 5488:          if constexpr(iveg != 0) {
 5489:             
 5490:             if (side->isSubmerged()) { 
 5491:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5492:                side->hhat -= veg_c*Hhat_alpha;
 5493: 
 5494:             } else { // Emergent
 5495:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5496:             }
 5497:          } // if iveg
 5498: 
 5499:          // Enforce positivity for 3D model
 5500:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5501:       } // if 3D
 5502: 
 5503:    }
 5504: 
 5505: 
 5506: 
 5507:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5508:    // Computes the density gradient between two elements, e1 and e2.
 5509:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5510:    // zero in the direction normal to the side. 
 5511:    // 
 5512:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5513:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5514:    //
 5515:    // Input:
 5516:    //    e1: Element
 5517:    //    e2: Neighbor element (or nullptr if boundary)
 5518:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5519:    //    k: Index of the half-level at which the density is interpolated
 5520:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5521:    // 
 5522:    // Output:
 5523:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5524:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5525: 
 5526:       if (e2 == nullptr || e2->isDry) {
 5527:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5528: 
 5529:          Side *side = e1->sides[j];
 5530:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5531:                  
 5532:          if constexpr(ics == 1) {
 5533:             vec = side->n; // Normal vector to the side
 5534:          } else {
 5535:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5536:             // IMPLEMENT THIS XXXXXX
 5537:             // !replace with xel, yel?
 5538:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5539:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5540:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5541:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5542:          } //ics
 5543:                    
 5544:          diffRho = 0.0;
 5545: 
 5546:       } else { //internal and wet
 5547:          if constexpr(ics==1) {
 5548:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5549: 
 5550:             // Vector from e1 to e2
 5551:             vec = e2->center - e1->center;
 5552: 
 5553:          } else { 
 5554:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5555:             // IMPLEMENT THIS XXXXXX
 5556:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5557:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5558:             //                   alow(j)=xctr2
 5559:             //                   bdia(j)=yctr2
 5560:          } // ics
 5561: 
 5562:          diffRho = rho2 - e1->demeanedDensity(k);
 5563:       }
 5564: 
 5565:    }
 5566: 
 5567:    __global__ void computeDensityCubicSplines(void) {
 5568:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5569: 
 5570:       ELEM(elem);
 5571: 
 5572:       if (elem->isDry) return;
 5573: 
 5574:       const int kb = elem->kb;
 5575: 
 5576:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5577:       if (elem->is2D()) {
 5578:          // In the 2D case, the density is constant at the prism level. 
 5579:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5580:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5581:       } else { //3D
 5582: 
 5583:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5584:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5585:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5586:          ///// XXXX CHECK INDICES!!!!!
 5587:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5588:       } // 2D/3D
 5589: 
 5590:    }
 5591: } // extern "C"
 5592: 
 5593: 
 5594: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5595: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5596: 
 5597:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5598: 
 5599:    const int kb  = elem->kb;
 5600:    const int kb2 = elem2->kb;
 5601: 
 5602:    // z-coordinate of prism of elem
 5603:    const double zp = elem->z_prism(k);
 5604: 
 5605:    double rho = 0.0;
 5606: 
 5607:    if (elem2->is2D()) {
 5608:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5609: 
 5610:    } else {  // 3D
 5611: 
 5612:       // eta_min may be < zmax
 5613:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5614:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5615: 
 5616:       // (Extrapolate density below bottom, we will fix it later)
 5617:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5618:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5619:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5620:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5621:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5622:    } // 2D/3D
 5623:      
 5624: 
 5625:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5626:    // Now we need to fix it.
 5627:    if (elem->z[k] < elem2->z[kb2]) {
 5628:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5629: 
 5630:       // There are two methods to adjust the density at the bottom of the element.
 5631:       // iunder_deep=0: 
 5632:       const double depth1 = abs(elem->z[kb]); // larger depth
 5633: 
 5634:       if (iunder_deep==0) {
 5635: 
 5636:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5637: 
 5638:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5639: 
 5640:       } else { // iunder_deep != 0
 5641: 
 5642:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5643: 
 5644:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5645: 
 5646:          //   Demeaned density at the same z coordinate as
 5647:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5648:          }
 5649: 
 5650:       } // if iunder_deep
 5651:    } // if elem->z[kb] < elem2->z[kb]
 5652: 
 5653:    return rho;
 5654: }
 5655: 
 5656: 
 5657: extern "C" {
 5658:    __global__ void computeDensityGradient(void) {
 5659: 
 5660:       if constexpr(ibc != 0) return;
 5661: 
 5662:          // Compute the horizontal density gradient at each element.
 5663:       // It works in two steps:
 5664:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5665:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5666:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5667:       //             gradRho.r1 = rho1 - rho0
 5668:       //             gradRho.r2 = rho2 - rho0
 5669:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5670:       // 
 5671:       //  NOTE: We use de-meaned densities.
 5672: 
 5673:       ELEM(elem);
 5674: 
 5675:       if (elem->isDry) return;
 5676: 
 5677:       const int kb  = elem->kb;
 5678:       const int i34 = elem->i34;
 5679: 
 5680:       for (int k = kb + 1; k < nvrt; k++) {
 5681:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5682:          //             gradRho.r1 = rho1 - rho0
 5683:          //             gradRho.r2 = rho2 - rho0
 5684:          int icount = 0;
 5685:          double sumRx = 0.0;
 5686:          double sumRy = 0.0;
 5687:          for (int j1=0; j1<i34; j1++) { 
 5688: 
 5689:             const int j2 = elem->nxq(j1 + 1);
 5690: 
 5691:             // Pairs of consecutive neighbor elements of elem
 5692:             const Element *e1 = elem->nghbElems[j1];
 5693:             const Element *e2 = elem->nghbElems[j2];
 5694: 
 5695:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5696:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5697:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5698: 
 5699:             // Compute the density difference and the vector from elem to e1 and e2
 5700:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5701:             double diffRho1, diffRho2;
 5702:             Vector2 vec1, vec2;
 5703:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5704:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5705: 
 5706:             const double rl1 = length(vec1);
 5707:             const double rl2 = length(vec2);
 5708:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5709: 
 5710:             const double delta = cross(vec1, vec2);
 5711:             const double sintheta = abs(delta)/(rl1*rl2);
 5712: 
 5713:             // To avoid problems, avoid elements with small angle between vectors
 5714:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5715:             const bool validEq = (sintheta > sin_one_deg);
 5716: 
 5717:             if (validEq) {
 5718:                // Solve the system of equations to get the density gradient at elem
 5719:                icount++;
 5720:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5721:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5722:                sumRx += Rx;
 5723:                sumRy += Ry;
 5724:             }
 5725:          } // for j1
 5726: 
 5727:          // Compute the average density gradient at elem
 5728:          if (icount==0) {
 5729:            // Bad mesh quality; bail out with 0 b-cc
 5730:            elem->gradRho[k] = {0.0, 0.0};
 5731:          } else {
 5732:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5733:          }
 5734: 
 5735:       } // for k
 5736: 
 5737:    }
 5738: 
 5739:    __global__ void computeBaroclinicTerm(void) {
 5740:    // Computes the baroclinic term at sides (at half levels).
 5741:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5742:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5743: 
 5744:       if (ibc == 1) return;
 5745: 
 5746:       SIDE(side);
 5747: 
 5748:       if (side->isDry) return;
 5749: 
 5750:       const Element *e1 = side->elems[0];
 5751:       const Element *e2 = side->elems[1]; 
 5752:       const int kb = side->kb;
 5753:       
 5754:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5755: 
 5756:       // interpolates vertically the density gradient of the two elements at the half level/
 5757: 
 5758:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 5759:       int k2 = max(kb, nvrt / 2);
 5760: 
 5761:       // Starts the integration at the surface and goes down to the bottom
 5762:       side->bcc[nvrt-1] = {0.0, 0.0};
 5763:       for (int k = nvrt - 2; k >= kb; k--) {
 5764:       // For each prism level (from surface to bottom)...
 5765: 
 5766:          // For both elements, interpolate density gradient at the side's half level.
 5767:          // The gradient at the side is the average of the gradients at the elements.
 5768:          // w1, w2 are used to take into account boundary sides, with just one element.
 5769:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5770:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5771:          const double wsum = w1 + w2;
 5772:          w1 = w1/wsum;
 5773:          w2 = w2/wsum;
 5774:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5775: 
 5776:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5777:          Vector2 gradRho = {0.0, 0.0};
 5778:          if (e1 != nullptr && k > kb) {
 5779:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5780:             
 5781:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5782:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5783:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5784: 
 5785:             // Grad(rho) vertically interpolated at the side's half level
 5786:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 5787: 
 5788:             // Projects the element density gradient to the side frame if needed.
 5789:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 5790: 
 5791:             // Adds the contribution of the density gradient at the side's half level
 5792:             gradRho += gradRho1*w1;
 5793:          }      
 5794:          if (e2 != nullptr && k > kb) {
 5795:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5796:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5797:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5798:             
 5799:             // Grad(rho) vertically interpolated at the side's half level
 5800:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 5801: 
 5802:             // Projects the element density gradient to the side frame if needed.
 5803:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 5804: 
 5805:             // Adds the contribution of the density gradient at the side's half level
 5806:             gradRho += gradRho2*w2;
 5807:          }
 5808: 
 5809:          
 5810:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5811:          // multiplied by -rampbc*(g/rho0) 
 5812:          const double grav3 = side->grav3();
 5813:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 5814: 
 5815:       } // for
 5816: 
 5817:    }
 5818: 
 5819: 
 5820: 
 5821:    __global__ void computeHorGradientAtSide(void) {
 5822: 
 5823:       // Compute the horizontal density gradient at each element.
 5824:       // It works in two steps:
 5825:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5826:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5827:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5828:       //             gradRho.r1 = rho1 - rho0
 5829:       //             gradRho.r2 = rho2 - rho0
 5830:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5831:       // 
 5832:       //  NOTE: We use de-meaned densities.
 5833: 
 5834:       SIDE(side);
 5835: 
 5836: 
 5837:       if (side->isDry) return;
 5838: 
 5839:       // Computes the gradient of the variables at the side center.
 5840:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5841:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5842:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5843: 
 5844:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5845:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5846:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5847:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5848: 
 5849:    }
 5850: 
 5851: 
 5852:    __global__ void solveMomentumEquations(double time) {
 5853: 
 5854:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5855:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5856: 
 5857:       SIDE(side);
 5858: 
 5859:       if (side->isDry) 
 5860:       {
 5861:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5862: 
 5863:          return;
 5864:       }
 5865: 
 5866:       const Node *n1 = side->n1;
 5867:       const Node *n2 = side->n2;
 5868: 
 5869:       const int kb = side->kb;
 5870: 
 5871:       const double veg_h = side->veg_h();
 5872:       const double grav3 = side->grav3();
 5873: 
 5874:       if (side->is2D()) {
 5875:          // Remember: Do not use htot2, which is updated.
 5876:          const double htot = side->htot1();
 5877:          const double hhat = side->hhat;
 5878: 
 5879:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5880: 
 5881:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 5882:          const Vector2 tau2 = side->tau();
 5883: 
 5884:          // hat_gam has units of m/s
 5885: 
 5886:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5887:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5888:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5889: 
 5890:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5891: 
 5892: 
 5893:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5894: 
 5895:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5896: 
 5897:       }
 5898:       else { // 3D
 5899: 
 5900:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5901:          // 
 5902:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5903:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5904:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5905:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5906:          // k+1 and k.
 5907: 
 5908: 
 5909:          const int ndim = nvrt - kb;
 5910:          const double zTopCanopy = side->zTopCanopy();
 5911: 
 5912:          // Initialize the tridiagonal system
 5913:          for (int k = kb + 1; k < nvrt; k++) {
 5914:             
 5915:             const int kin = k - (kb + 1);
 5916: 
 5917:             // Vertical viscosity at the face center
 5918:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5919: 
 5920:  
 5921:             alow[kin] = 0.0;
 5922:             cupp[kin] = 0.0;
 5923:             bdia[kin] = 0.0;
 5924: 
 5925:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5926:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5927: 
 5928:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5929:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5930:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5931: 
 5932:             // First part: layers k, k+1
 5933:             if (k < nvrt - 1) {
 5934:                              
 5935:                if constexpr(iveg != 0) {
 5936: 
 5937:                   // If there is vegetation at this level...
 5938:                   if (zTopCanopy > side->zc[k]) {
 5939:                      // If the canopy is above the k layer...
 5940:                      
 5941:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5942:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5943:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5944:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5945: 
 5946:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5947:                      const double vmag2 = length(ut2);
 5948:                      const double vmag1 = length(side->u2[k]);
 5949:                      const double vmag = 0.5*(vmag1 + vmag2);
 5950:                      
 5951:                      // Computes the vegetation alpha at the face center
 5952:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5953: 
 5954:                      cff1 += veg_alpha_sd*dt*vmag;
 5955: 
 5956:                   } // if (zTopCanopy
 5957:                } // if iveg
 5958: 
 5959:                const double dzz = side->Dz(k + 1);
 5960:                const double tmp = dt*dfz/dzz;
 5961:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5962: 
 5963:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5964:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5965:             }
 5966: 
 5967: 
 5968:             // Second part: layers k-1, k
 5969:             if (k > kb + 1) {
 5970: 
 5971:                double cff1 = 1.0; //init \bar{c^k}
 5972: 
 5973:                if constexpr(iveg != 0) {
 5974:                   // If there is vegetation at this level...
 5975:                   if (zTopCanopy > side->zc[k-1]) {
 5976:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5977:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5978: 
 5979:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5980: 
 5981:                      const double vmag2 = length(ut2);
 5982:                      const double vmag1 = length(side->u2[k-1]);
 5983:                      const double vmag = 0.5*(vmag1 + vmag2);
 5984: 
 5985:                      // Computes the vegetation alpha at the face center
 5986:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5987:                      cff1 += veg_alpha_sd*dt*vmag;
 5988:                   } // if zTopCanopy
 5989: 
 5990:                } // if iveg
 5991: 
 5992:                const double dzz = side->Dz(k);
 5993:                const double tmp = dt*dfz/dzz;
 5994:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5995: 
 5996:                alow[kin] += cff1*dzz/6.0 - tmp;
 5997:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5998: 
 5999:             } else { // Bottom boundary
 6000:                // This occurs at the bottom, where the bottom drag is applied.
 6001: 
 6002:                bdia[kin] += dt*side->chi2; // XXXX
 6003: 
 6004:             } // if (k > kb + 1)
 6005: 
 6006: 
 6007:          } // for (int k
 6008: 
 6009: 
 6010: 
 6011:          // Computes the RHS.
 6012:          // -----------------
 6013: 
 6014:          //	BC to be imposed at the end.
 6015: 
 6016:          const Vector2 gradETP  = side->gradETP;
 6017:          const Vector2 gradPr   = side->gradPr;
 6018:          const Vector2 gradEta1 = side->gradEta1;
 6019:          const Vector2 gradEta2 = side->gradEta2;
 6020: 
 6021:          const Vector2 *btu = side->btu;
 6022:          const Vector2 *u2  = side->u2;
 6023:          const double coriolis = side->coriolis;
 6024:          const Vector2 *nuGradU = side->nuGradU;
 6025: 
 6026: 
 6027:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6028:          for (int k = kb + 1; k < nvrt; k++) {
 6029:             const int kin = k - kb - 1;
 6030: 
 6031:             const double dz_0 = side->Dz(k);
 6032:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6033: 
 6034:             rrhs[kin] = {0.0, 0.0};
 6035:             double dz = 0.0;
 6036: 
 6037:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6038:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6039:             if (k < nvrt  ) dz += dz_1;
 6040:             if (k > kb + 1) dz += dz_0;
 6041: 
 6042:             // Elevation gradient, atmospheric pressure and tidal potential
 6043:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 6044: 
 6045:             // Coriolis, advection, wind stress, and horizontal viscosity
 6046:             if (k < nvrt - 1) {
 6047: 
 6048: 
 6049:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6050:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6051:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6052:                                                 
 6053: 
 6054:                //diff stress tensors 1006
 6055:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6056:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6057:                   assert(false && "Not implemented: itur == 5");
 6058:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6059:                }
 6060:                // else assert(false && "itur # Not implemented");
 6061: 
 6062:             } else { // k == nvrt - 1 SURFACE
 6063:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6064:                const Vector2 tau2 = side->tau();
 6065: 
 6066:                rrhs[kin] += dt*tau2;          
 6067: 
 6068:             } // if k<nvrt
 6069: 
 6070: 
 6071:             if (k > kb + 1) {
 6072:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6073:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6074:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6075: 
 6076:                // diff stress tensors 1006
 6077:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6078:                   assert(false && "Not implemented: itur == 5");
 6079:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6080:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6081:                }
 6082:                // else assert(false && "itur # Not implemented");
 6083: 
 6084: 
 6085:             } // if k>kbs + 1
 6086: 
 6087:             // Baroclinic
 6088:             Vector2 *bcc = side->bcc;
 6089:             if constexpr(ibc == 0) {
 6090:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6091:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6092: 
 6093:             } // if ibc==0
 6094: 
 6095:          } // k=kb + 1,nvrt
 6096: 
 6097: 
 6098:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6099: 
 6100:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6101:             const int kin = k - kb - 1;
 6102:    
 6103:             // Velocity is always clamped to maximum values
 6104:             side->u2[k] = clampVelocity(soln[kin]);
 6105:          } // k
 6106: 
 6107:       } // if side->is2D()
 6108:       
 6109: 
 6110:       // Impose velocity boundary condition at the bottom
 6111:       if constexpr(imm == 2) { // 3D bed deformation model
 6112:          double dep;
 6113:          Vector2 vel;
 6114: 
 6115:          assert(false && "Not implemented: imm == 2");
 6116:          //update_bdef(time, x0, y0, dep, vel);
 6117:          // side->u2[kb] = vel;
 6118: 
 6119:       } else { // imm = 0 or 1
 6120:          if (side->Cd() == 0.0) {
 6121:             side->u2[kb] = side->u2[kb + 1];
 6122: 
 6123:          } else if (side->is3D()) { // 3D no slip bottom   
 6124:             side->u2[kb] = {0.0, 0.0};
 6125: 
 6126:          }
 6127:           
 6128:       } // if imm
 6129: 
 6130:       // The velocities below the bottom level are set to zero
 6131:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6132: 
 6133: 
 6134:    }
 6135: 
 6136: 
 6137:    __global__ void applyMomentumBC(void) {
 6138: 
 6139:       SIDE_BND(sideBnd);
 6140: 
 6141:       Side *side = sideBnd->side;
 6142:       const BoundarySegment *segment = sideBnd->segment;
 6143:       const Node *n1 = side->n1;
 6144:       const Node *n2 = side->n2;
 6145: 
 6146:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6147: 
 6148:       const bool isLand = segment->isLand;
 6149:       const int ifltype = segment->ifltype;
 6150: 
 6151:       const int kb = side->kb;
 6152: 
 6153: 
 6154:       if (!isLand && ifltype != 0) {
 6155:          const Vector2 *ubc = sideBnd->ubc;
 6156:   
 6157:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 6158:             
 6159:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6160:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6161: 
 6162:             if (ifltype == -1) {
 6163:                // Flather 1
 6164: 
 6165:                const double depth = side->depth();
 6166: 
 6167:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6168: 
 6169:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6170: 
 6171:                side->u2[k] = vnorm*side->n;
 6172: 
 6173:             } else if (ifltype == -2) { // Discharge
 6174: 
 6175:                const double eta1 = side->eta1();
 6176:                const double eta2 = side->eta2();
 6177:                const double htot = side->htot2();
 6178: 
 6179:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6180:                assert(false && "Not implemented: Discharge bc");
 6181:                // const double dischrg = discharge(eta1);
 6182:                const double dischrg = 0.0; // XXX REMOVE
 6183:                
 6184: 
 6185:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6186: 
 6187:                const double vnorm = dischrg*eta2/htot;
 6188: 
 6189:                side->u2[k] = vnorm*side->n;
 6190: 
 6191:             }
 6192:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6193:                const double vnorm = dot(side->u2[k], side->n);
 6194: 
 6195:                double rat;
 6196:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6197:                else              rat = segment->vobc2; // outgoing
 6198: 
 6199:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6200: 
 6201:             }
 6202:             else { // not Flather or 3D radiation
 6203:                side->u2[k] = ubc[k];
 6204: 
 6205:             } // if (segment->ifltype...
 6206: 
 6207:          }
 6208: 
 6209:       }
 6210:       else if (isLand) { // if it is land boundary side
 6211: 
 6212:          if constexpr(islip == 0) { // free slip
 6213: 
 6214:             for (int k = kb; k < nvrt; k++) {
 6215: 
 6216:                const Vector2 t = side->t();
 6217:                const Vector2 n = side->n;
 6218: 
 6219:                double vnorm = 0.0; // for most cases
 6220:                const double vtan = dot(side->u2[k], t);
 6221:                
 6222:                side->u2[k] = vtan*t - vnorm*n;
 6223: 
 6224:             }
 6225: 
 6226:          } else { // no slip
 6227:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6228: 
 6229:          }
 6230:       } // if (side segment type...
 6231: 
 6232:    
 6233: 
 6234:    }
 6235: 
 6236: 
 6237:    __global__ void shapiroFilter1(void) {
 6238:       // First step of the Shapiro filter (normally used if indvel<=0)
 6239:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6240: 
 6241:       SIDE(side);
 6242: 
 6243:       // Only internal wet sides are processed
 6244:       if (side->isDry || !(side->isInternal())) return;
 6245: 
 6246:       const int kb = side->kb;
 6247: 
 6248:       for (int mm = 0; mm < niter_shap; mm++) {
 6249: 
 6250:          for (int k = kb + 1; k < nvrt; k++) {
 6251:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6252:             Vector2 suru = {0.0, 0.0};
 6253: 
 6254:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6255: 
 6256:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6257: 
 6258:                int kin = k;
 6259:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6260:                
 6261:                // Get the velocity at the neighbor's side.
 6262:                Vector2 nSideU2 = nSide->u2[kin];
 6263: 
 6264:                // Projects the velocity to the current side frame if needed.
 6265:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6266: 
 6267:                suru += nSideU2;
 6268:             }
 6269: 
 6270:             // Reusing bcc as a temporary array to store the suru values.
 6271:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6272: 
 6273:          }
 6274:       }
 6275:    }
 6276: 
 6277:    __global__ void shapiroFilter2(void) {
 6278:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6279: 
 6280:       SIDE(side);
 6281: 
 6282: 
 6283:       if (side->isDry || !(side->isInternal())) return;
 6284: 
 6285:       const int kb = side->kb;
 6286: 
 6287:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6288: 
 6289:       if (side->is2D()) {
 6290:          side->u2[kb + 1] = side->bcc[kb + 1];
 6291:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6292: 
 6293:       } else {
 6294:          // 3D
 6295:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6296:          
 6297:       }
 6298: 
 6299:    }
 6300: 
 6301: 
 6302:    __global__ void ul0UpdateZCoords(void) {
 6303:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6304:       
 6305:       NODE(node);      
 6306: 
 6307: 
 6308:       if (false) { //node->isDry) { XXXXXXX
 6309: 
 6310:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6311: 
 6312:          if constexpr(ivcor != 1) node->kb = 0;
 6313: 
 6314:       } else {
 6315: 
 6316:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6317:          node->updateKb();
 6318: 
 6319:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6320: 
 6321:       }
 6322: 
 6323:       // We use the temp.b field to store the previous state of isDry.
 6324:       node->tmp.b = node->isDry;
 6325: 
 6326:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6327:       node->isDry = true;
 6328: 
 6329:    }
 6330: 
 6331:    __global__ void ul0ComputeDryElements(void)
 6332:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6333:    {
 6334:       ELEM(elem);
 6335: 
 6336:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6337: 
 6338:       elem->kb = 0;
 6339: 
 6340:       if (elem->isDry) return;
 6341: 
 6342: 
 6343:    //    if(elem->isDry2()) { // XXXX
 6344:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6345:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6346:    //        call parallel_abort(errmsg)
 6347:    //    }
 6348: 
 6349:       const Node *n1 = elem->nodes[0];
 6350:       const Node *n2 = elem->nodes[1];
 6351:       const Node *n3 = elem->nodes[2];  
 6352:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6353: 
 6354:       // Computes element's kb as the minimum of the nodes' kb.
 6355:       const int kb1 = n1->kb;
 6356:       const int kb2 = n2->kb;
 6357:       const int kb3 = n3->kb;
 6358:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6359: 
 6360: 
 6361:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6362: 
 6363: 
 6364:       // Computes the element z as the mean of the nodes z.
 6365:       for (int k = elem->kb; k < nvrt; k++) {
 6366: 
 6367:          // Compute the element z as the mean of the nodes z.
 6368:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6369:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6370:          elem->z[k] /= elem->i34;
 6371: 
 6372: if (k>elem->kb && elem->z[k] <= elem->z[k-1]) printf("EEEE elem->isDry = %d, idx1 = %d, idx2 = %d, idx3 = %d, z1[k] = %f, z2[k] = %f, z3[k] = %f, z1[k-1] = %f, z2[k-1] = %f, z3[k-1] = %f, k = %d, kb = %d, kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d, z[k] = %f, z[k-1] = %f\n", elem->isDry, n1->idx, n2->idx, n3->idx, n1->z[max(k, kb1)], n2->z[max(k, kb2)], n3->z[max(k, kb3)], n1->z[max(k-1, kb1)], n2->z[max(k-1, kb2)], n3->z[max(k-1, kb3)],  k, elem->kb, kb1, kb2, kb3, kb4, elem->z[k], elem->z[k-1]);
 6373:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6374:       }
 6375:                   
 6376:    }
 6377: 
 6378:    __global__ void ul0ComputeDryNodes(void)
 6379:    // Updates node's isDry based on the elements' isDry. 
 6380:    {
 6381:       NODE(node);
 6382: 
 6383:       node->isDry = true;
 6384: 
 6385:       // A node is wet if at least one of the elements sharing it is wet.
 6386:       for (int j = 0; j < node->numElements; j++) {
 6387:          const Element *elem = node->elements[j];
 6388:          if (!elem->isDry) {
 6389:             node->isDry = false;
 6390:             break;
 6391:          }
 6392:       }
 6393: 
 6394:        
 6395:    }
 6396: 
 6397: 
 6398:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6399:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6400:    // node->tmp.b is true if the node was previously dry.
 6401:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6402:    {
 6403:       NODE(node);
 6404:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6405: 
 6406:       // Avoid this the first time step.
 6407:       if (it == iths) return;  
 6408: 
 6409:       const bool wasDry = node->tmp.b;
 6410: 
 6411: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6412: 
 6413:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6414: 
 6415:          for (int k=0; k < nvrt; k++) {
 6416: 
 6417:             Vector3 utmp={0.0, 0.0, 0.0};
 6418: 
 6419:             double ttmp=0.0;
 6420:             double stmp=0.0;
 6421:             int icount=0;
 6422:             for (int j = 0; j < node->numNodes; j++) {
 6423: 
 6424:                const Node *nbrNode = node->nodes[j];
 6425:                
 6426:                const bool wasNbrDry = nbrNode->tmp.b;
 6427: 
 6428:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6429:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6430: 
 6431:                   icount++;
 6432: 
 6433:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6434:                   utmp += nbrNode->uvw2(k);
 6435:                   
 6436:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6437:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6438:                }
 6439:             }
 6440: 
 6441:             if (icount > 0) {
 6442:                const double inv_icount = 1.0/icount;
 6443:                utmp = inv_icount*utmp;
 6444:                node->u2[k]     = toVector2(utmp);
 6445:                node->w2[k]     = utmp.z;
 6446:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6447:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6448:             } else {
 6449:                node->u2[k] = {0.0, 0.0};
 6450:                node->w2[k] = 0.0;
 6451:                // Initialize tracers to 0.0??? XXXXX
 6452:             }
 6453:          }
 6454:       }
 6455:    }
 6456: 
 6457:   
 6458:    
 6459: 
 6460: 
 6461:    __global__ void ul0UpdateSides(int it, int iths) {
 6462:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6463:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6464:    // The dryness of the sides is updated in ul0UpdateSides2.
 6465: 
 6466:       SIDE(side);
 6467: 
 6468:       // A side is wet if and only if at least one of its elements is wet.
 6469:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6470:  
 6471:       const Node *n1 = side->n1;
 6472:       const Node *n2 = side->n2;
 6473:      
 6474:       const int kb1 = n1->kb;
 6475:       const int kb2 = n2->kb;
 6476: 
 6477:       side->kb = 0; // default when dry
 6478: 
 6479:       if (isWet) {
 6480: 
 6481:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6482: 
 6483:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6484: 
 6485:          side->kb = min(kb1, kb2);
 6486: 
 6487:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6488: 
 6489:          for (int k = side->kb; k < nvrt; k++) {
 6490:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6491: 
 6492:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6493: 
 6494:             // Compute velocity for re-wetted sides 
 6495:             if ((it != iths) && (side->isDry && isWet)) {
 6496: 
 6497:                Vector2 utmp={0.0, 0.0};
 6498: 
 6499:                int icount=0;
 6500: 
 6501:                // For all the sides on the two elements that share this side
 6502:                for (int j = 0; j < 2; j++) {
 6503:                   const Element *elem = side->elems[j];
 6504:                   if (elem == nullptr) continue;
 6505: 
 6506:                   for (int jj=0; jj < elem->i34; jj++) {
 6507:                      const Side *nSide = elem->sides[jj];
 6508:                      if (nSide->isDry) continue;
 6509: 
 6510:                      icount++;
 6511:                      utmp += nSide->u2[k];  
 6512:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6513:                   }
 6514:                }
 6515:                   
 6516:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6517:                if (icount > 0)  side->u2[k] = utmp/icount;
 6518:                else             side->u2[k] = {0.0, 0.0};
 6519:                   
 6520:             } // if ((it != iths) && (side->isDry && isWet))
 6521: 
 6522:          } // for k
 6523: 
 6524:       } // if isWet 
 6525:       
 6526: 
 6527: 
 6528:    }
 6529: 
 6530:    __global__ void ul0UpdateSides2(void) {
 6531:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6532:    
 6533:          SIDE(side);
 6534:    
 6535:          const Element *e1 = side->elems[0];
 6536:          const Element *e2 = side->elems[1];
 6537: 
 6538:          // A side is wet if and only if at least one of its elements is wet.
 6539:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6540: 
 6541:          // Update the side's dryness
 6542:          side->isDry = !isWet;
 6543: 
 6544:    }
 6545: 
 6546: 
 6547:    __global__ void zeroNodalVelocities(void) {
 6548:       NODE(node);
 6549: 
 6550:       for (int k = 0; k < nvrt; k++) {
 6551:          node->u2[k]   = {0.0, 0.0};
 6552:          node->w2[k]   = 0.0;
 6553:          node->utmp[k] = {0.0, 0.0};
 6554:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6555:       }
 6556:    }
 6557:  
 6558: 
 6559:    __global__ void computeNodalVerticalVelocities1(void) {
 6560:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6561:    // Adds the element's vertical velocity times the element's area.
 6562:       ELEM(elem);
 6563: 
 6564:       for (int j = 0; j < elem->i34; j++) {
 6565:          Node *node = elem->nodes[j];
 6566: 
 6567:          for (int k = node->kb; k < nvrt; k++) {
 6568:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6569:          }
 6570:          atomicAdd(&(node->tmp.d), elem->area);
 6571:       }
 6572:    }
 6573: 
 6574:    __global__ void computeNodalVerticalVelocities2(void) {
 6575:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6576:    // Divides by the total area of the elements sharing the    node.
 6577:       NODE(node);
 6578: 
 6579:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6580: 
 6581:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6582:    }
 6583: 
 6584: 
 6585:    __global__ void computeNodalHorizontalVelocities1(void) {
 6586: 
 6587:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6588: 
 6589:       ELEM(elem);
 6590: 
 6591:       if (elem->isDry) return;
 6592: 
 6593:       const int kb = elem->kb;
 6594:       const bool isTri = elem->isTri();
 6595: 
 6596:       if constexpr(indvel <= 0) {
 6597:          // Assuming discontinous hvel.
 6598: 
 6599:          if (isTri) { // For triangles
 6600:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6601:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6602: 
 6603:             for (int j = 0; j < 3; j++) {
 6604:                // For every node of the triangle...
 6605:                Node *node = elem->nodes[j];
 6606: 
 6607:                if (node->isDry) continue;
 6608: 
 6609:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6610:                const Side *s2 = elem->sides[(j + 1) % 3];
 6611:                const Side *s3 = elem->sides[(j + 2) % 3];
 6612: 
 6613:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6614: 
 6615:                atomicAdd(&(node->tmp.i), 1);
 6616: 
 6617:                for (int k = kb; k < nvrt; k++)  {
 6618:                   Vector2 s1u2 = s1->u2[k];
 6619:                   Vector2 s2u2 = s2->u2[k];
 6620:                   Vector2 s3u2 = s3->u2[k];
 6621: 
 6622:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6623:                   if constexpr(ics == 2) {
 6624:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6625:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6626:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6627:                   }
 6628: 
 6629:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 6630:                   u = clampVelocity(u);
 6631:                   atomicAdd(&(node->utmp[k].x), u.x);
 6632:                   atomicAdd(&(node->utmp[k].y), u.y);
 6633: 
 6634:                }
 6635: 
 6636:             }
 6637:          }
 6638:          else { // For quads
 6639:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6640: 
 6641:          }
 6642: 
 6643:       }
 6644:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6645:       
 6646:    }
 6647: 
 6648: 
 6649:    __global__ void computeNodalHorizontalVelocities2(void) {
 6650:       NODE(node);
 6651: 
 6652:       const int nodeCount = node->tmp.i;
 6653: 
 6654:       if (nodeCount == 0) 
 6655:       {
 6656:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6657:          return;
 6658:       }
 6659: 
 6660:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6661:       
 6662:       const int kb = node->kb;
 6663: 
 6664:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6665:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6666:       
 6667:       
 6668:    }   
 6669: 
 6670:  
 6671: 
 6672:    __global__ void resetVelocityOpenBndNodes(void) {
 6673:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6674: 
 6675:       NODE_BND(nodebnd);
 6676: 
 6677:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6678:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6679:       }
 6680: 
 6681:    }
 6682: 
 6683: 
 6684:    __global__ void setVelocityOpenBndNodes(void) {
 6685:    // For open boundary nodes sets their velocity to the imposed values.
 6686: 
 6687:       SIDE_BND(sidebnd);
 6688: 
 6689:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6690:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6691:          // to its segment to the average of the side velocity.
 6692: 
 6693:          for (int k = 0; k < nvrt; k++) {
 6694:             Node *n1 = sidebnd->side->n1;
 6695:             Node *n2 = sidebnd->side->n2;
 6696: 
 6697: 
 6698:             Vector2 n1_u2(n1->u2[k]);
 6699:             Vector2 n2_u2(n2->u2[k]);
 6700: 
 6701:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6702:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6703:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6704:             }
 6705:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6706:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6707:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6708:             }
 6709: 
 6710:          }
 6711: 
 6712:       }
 6713: 
 6714:    }
 6715: 
 6716: 
 6717:    __global__ void computeVerticalVelocity(void) {
 6718:       // Computes the vertical velocity at the (2D) element's centroid.
 6719:       // In this function we will be considering volumetric elements, with side faces and a 
 6720:       // bottom and a top face. We will call them SFs, BF and TF.
 6721:       // It computes the flux coming from BF and the SFs.
 6722:       // If the bed is moving, it takes that into account.
 6723:       // Since water is incompressible, the integral of the velocity times the normal vector
 6724:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6725:       // and the BF is equal to the flux going out from the TF.
 6726:       // TF = - BF - sum(SFs).
 6727:       // It then computes the horizontal velocity at the center of TF.
 6728:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6729:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6730:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6731: 
 6732:       ELEM(elem);
 6733: 
 6734:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6735: 
 6736:       if (elem->isDry) return;
 6737: 
 6738:       const int kb = elem->kb;
 6739:       const bool isTri = elem->isTri();
 6740: 
 6741:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6742: 
 6743:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6744:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6745:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6746: 
 6747:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6748: 
 6749:       double area3D;
 6750: 
 6751:       // Bottom face flux
 6752:       double bottomFlux = 0.0;
 6753:       Vector2 u2meanBottom = {0.0, 0.0};
 6754:       const Vector2 gradh = elem->grad2(&Node::depth);
 6755:       if constexpr(imm==2) {
 6756:          Vector3 ubed;
 6757: 
 6758:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6759:          // updateBDEF(ubed);
 6760:      
 6761:          // const double bflux0 = dot(ubed, elem_n1);
 6762: 
 6763:          // elem->w[kb] += ubed.z;
 6764:       }
 6765:       else {
 6766:          u2meanBottom = elem->mean(kb, &Side::u2);  // The mean computation includes the projection to the element frame if ics=2
 6767:   
 6768:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6769:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6770: 
 6771:          bottomFlux = - dot(gradh, u2meanBottom);
 6772:       } // if imm
 6773: 
 6774:       // Compute w for kb+1 to nvrt-1
 6775:       for (int l = kb; l < nvrt - 1; l++) {
 6776: 
 6777:          // normal vector to the top face of the "volumetric" element (3D)
 6778:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6779: 
 6780:          // Compute the total flux at the sides
 6781:          double sideFlux = 0.0;
 6782: 
 6783:          for (int j = 0; j < elem->i34; j++) {
 6784:             const Side *side = elem->sides[j];
 6785: 
 6786:             const double sideArea = side->area(l);
 6787:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6788:             const double sign = elem->ssign[j]; 
 6789: 
 6790:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6791:          }
 6792:          
 6793:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6794:          //velocities at the centers of the sides
 6795:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6796: 
 6797:          // The flx at the top ace can be computed from the other flows.
 6798:          const double topFlux = - sideFlux - bottomFlux;
 6799:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6800: 
 6801:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6802: 
 6803:          elem_n1 = elem_n2;
 6804: 
 6805:          bottomFlux = - topFlux;
 6806:       }
 6807:    }  
 6808: 
 6809: 
 6810: 
 6811: 
 6812: 
 6813: 
 6814: 
 6815: // !===============================================================================
 6816: // !===============================================================================
 6817: 
 6818: } // extern "C"
 6819: 
 6820: #ifdef DONTCOMPILE
 6821: __device__ void computeVerticalAdvection(void) {
 6822:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6823: 
 6824:    sdbt(1:2,:,:)=0.d0
 6825: 
 6826:    const Side *side = FROM kernel;
 6827: 
 6828:    if(side->isDry) return;
 6829: 
 6830:    // If side is wet...
 6831: 
 6832: 
 6833:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6834:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6835:    double ws[nvrt] = {} // w @ side
 6836:    int icount = 0;
 6837:    for (int j=0; j<2; j++) {
 6838:       const Element *elem = side->elements[j];
 6839:        
 6840:       if(elem != nullptr) {
 6841:          icount++;
 6842:          for (int k=0; k<nvrt; k++) {
 6843:             ws[k] = ws[k] + elem->w[k];
 6844:          }
 6845:       }
 6846:    }  // for j
 6847: 
 6848:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6849:    ws = ws/icount;
 6850: 
 6851:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6852:    // Splines allow for a smooth transition between vertical levels.
 6853:    // Splines have continuity restrictions at the internal knots, but
 6854:    // we have to provide the 1st derivatives at the endpoints.
 6855:    const int kbs = side->kbs; 
 6856:    
 6857:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6858:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6859:    initCubicSpline(kbs, nvrt, side, ws, up)
 6860: 
 6861:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6862:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6863:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6864: 
 6865:    // Total advection (average onto side)
 6866:    const Node *node1 = side->nodes[0];
 6867:    const Node *node2 = side->nodes[1];
 6868:    for (int k=kbs(i); k<nvrt; k++) {
 6869: 
 6870:       Vector2 bcc1 = node1->bcc[k];
 6871:       Vector2 bcc2 = node2->bcc[k];
 6872:       if constexpr(ics == 2) {
 6873:          // Project the velocities from the node frames to the side frame
 6874:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 6875:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 6876:       }
 6877: 
 6878:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 6879:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 6880: 
 6881:    }
 6882: }
 6883: #endif
 6884: 
 6885: 
 6886: extern "C" {
 6887:    __global__ void computeElemAverageGhat(void) {
 6888:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6889: 
 6890:       ELEM(elem);
 6891:       
 6892:       elem->ghat1= {0.0, 0.0};  
 6893: 
 6894:       if constexpr(ihydraulics != 0) {
 6895:          if (nhtblocks > 0 && elem->isblock) return;
 6896:       }
 6897: 
 6898:       
 6899:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 6900:       // cff1-3: coefficients for 2D/3D
 6901: 
 6902:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6903:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6904:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 6905: 
 6906:       if (elem->isDry) return;
 6907: 
 6908:       // Average of the coefficients
 6909:       double av_cff1 = 0.0;  // av. for cff1
 6910:       double av_cff2 = 0.0;  // av. for cff2
 6911:       double av_cff3 = 0.0;  // av. for cff3
 6912:       double av_df = 0.0;  // av. for H^\alpha / H
 6913:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6914:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6915: 
 6916:       const int i34 = elem->i34;
 6917:       const int kb  = elem->kb;
 6918: 
 6919:       for (int j=0; j<i34; j++) {
 6920:          // For each node and side in the element...
 6921: 
 6922:          const Node *node = elem->nodes[j];
 6923:          const Side *side = elem->sides[j];
 6924: 
 6925:          const double chi      = side->chi;
 6926:          const double veg_c2   = side->veg_c2;
 6927:          const double veg_beta = side->veg_beta;
 6928:          const double veg_h    = side->veg_h();
 6929:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6930: 
 6931:          // Node - const in elem
 6932:          elem->gradEta += node->eta2*elem->gradPhi[j];  // gradPhi is always in the element frame
 6933:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6934: 
 6935:          if (elem->depth >= tip_dp) {
 6936:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6937:          }
 6938: 
 6939:          
 6940:          const double htot  = side->htot2();        // Total depth at the side
 6941:          const double zctr2 = side->zTopCanopy();  
 6942: 
 6943:          double cff1; 
 6944:          double cff2; 
 6945:          double cff3;   
 6946:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6947:          // coefficients applied to 2D/3D case 
 6948:             cff1 = side->hhat/htot;
 6949:             cff2 = 0.0;
 6950:             cff3 = 0.0;
 6951:          } else { //3D
 6952:             //Init for no-veg case
 6953:             cff1 = 1.0;
 6954:             cff2 = 1.0;
 6955:             cff3 = 0.0;
 6956: 
 6957:             if constexpr(iveg != 0) {
 6958:                // Computes coefficients used with vegetation terms G1, G2
 6959:                // cff1, cff3 are used for the first two terms in G1, G2:
 6960:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6961:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6962:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6963:                if(veg_h < 0.99*htot) { // submergent vegetation
 6964:                   cff1=1;
 6965:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6966:                   cff3 = veg_c;
 6967: 
 6968:                } else { // emergent vegetation
 6969:                   cff1 = 1.0/(1.0 + veg_c2);
 6970:                   cff2 = cff1;
 6971:                   cff3 = 0.0;
 6972: 
 6973:                }
 6974:             } // if iveg
 6975:          } //  2D/3D
 6976: 
 6977:          av_cff1 += cff1/i34;
 6978:          av_cff2 += cff2/i34;
 6979:          av_cff3 += cff3/i34;
 6980:          av_cff2_chi += cff2*chi/i34;
 6981:          av_cff3_chi += cff3*chi/i34;
 6982:          av_df += min(htot, veg_h)/(htot*i34);
 6983: 
 6984: 
 6985:          // btrack values: U^\star, U^{\star\alpha}
 6986:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6987:          Vector2 Ustar       = {0.0, 0.0}; 
 6988:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6989: 
 6990:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6991:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6992:          } else { //3D
 6993:             for (int k = side->kb + 1; k < nvrt; k++) {
 6994:             
 6995:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6996:                Ustar += w2;
 6997: 
 6998:                if constexpr(iveg != 0) {
 6999:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7000:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7001:                        Ustar_alpha += zrat*w2; // XXXX
 7002:                    }
 7003:                }  // if iveg
 7004:             }  // for k
 7005:          }  //2D/3D
 7006: 
 7007:          // If needed, project the side velocities to the element frame
 7008:          if constexpr(ics==2) {
 7009:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7010:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7011:          }
 7012:         
 7013: 
 7014:          // Add btrack & surface stress terms to \breve{G} first
 7015:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7016: 
 7017: 
 7018:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7019:          Vector2 tau    = side->tau();  
 7020:          Vector2 ubstar = side->btu[side->kb + 1];  
 7021: 
 7022:          // If needed, project tau and ubstar to the element frame
 7023:          if constexpr(ics==2) {
 7024:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7025:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7026:          }
 7027: 
 7028:          // Term for surface and bottom stress
 7029:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7030: 
 7031: 
 7032:          // All terms in F,F^\alpha,f_b except baroclinic
 7033:          // F, f_b: all explicit terms excluding vegetation 
 7034:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7035:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7036:          const double coriolis = side->coriolis;
 7037:          Vector2 F  =  coriolis*side->U;  // F_x
 7038:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7039:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7040: 
 7041:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7042:             
 7043:             for (int k = side->kb; k < nvrt; k++) {
 7044:                if (zctr2 > side->zc[k-1]) {
 7045:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7046:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7047:                    Fa +=  coriolis*w2*zrat;
 7048:                } // if zctr2
 7049:             } // k
 7050:          } // iveg
 7051: 
 7052:          // Integrate horizontal viscosity force vertically
 7053:          for (int k=side->kb + 1; k<nvrt; k++) {
 7054:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7055: 
 7056:             F += levelHorVisc;
 7057: 
 7058:             // Vegetation term
 7059:             if constexpr(iveg!=0) {
 7060:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7061:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7062:                   Fa += levelHorVisc*zrat;
 7063:                } 
 7064:             } // if iveg
 7065:          } // for k
 7066: 
 7067:          // Get nu*grad(U) at the side's bottom level
 7068:          Vector2 nuGradU = side->nuGradU[side->kb];
 7069: 
 7070:          fb += nuGradU;
 7071: 
 7072:          // If needed, project vectorsF, fb and Fa to the element frame
 7073:          if constexpr(ics==2) {
 7074:             F    = side->frame.projHorVec(F,    elem->frame);
 7075:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7076:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7077:          } // if ics
 7078: 
 7079:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7080:       } // for j (nodes and sides)
 7081: 
 7082:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7083:          
 7084:       // Finish off terms in F, F^\alpha and f_b
 7085:       const double grav3 = elem->mean(&Node::grav2);
 7086:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7087: 
 7088: 
 7089:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7090:       for (int j=1; j<i34; j++) { 
 7091:          // For each side in the element...
 7092:          const Side *side = elem->sides[j];
 7093:          const double chi = side->chi;
 7094: 
 7095:          const double htot = side->htot2();
 7096:          const double veg_h = side->veg_h();
 7097:          const Vector2 F  = htot*fb;
 7098:          const Vector2 Fa = min(htot, veg_h)*fb;
 7099: 
 7100:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7101:       } // for j
 7102: 
 7103:       //botf1 etc are already in elem frame
 7104:       elem->ghat1 += tmp/i34;
 7105: 
 7106:       // Baroclinic force
 7107:       if constexpr(ibc==0) {
 7108:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7109: 
 7110:          Vector2 Fa = {0.0, 0.0};
 7111:          Vector2 intGradRho = {0.0, 0.0};
 7112:          
 7113:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7114:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7115:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7116: 
 7117:             // \in F [m^2/s/s]
 7118:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7119:          }
 7120: 
 7121:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7122:          const Vector2 F = av_df*Fa; //approx
 7123:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7124: 
 7125:       } // if ibc
 7126: 
 7127: 
 7128: 
 7129:    }
 7130: 
 7131: } // extern "C"
 7132: 
 7133: 
 7134: 
 7135: #ifdef DONTCOMPILE
 7136: __global__ void checkMassConservation(Tracers* sumtr) {
 7137: 
 7138:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7139: 
 7140:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7141: 
 7142:    Element *elem = &(mesh->localElemData[i]);
 7143: 
 7144:    // Skip dry elements
 7145:    if (elem->isDry) return;
 7146: 
 7147:    // Local sum array for this thread
 7148:    double localSum[N_TRACERS] = {0.0};
 7149: 
 7150:    // Sum over vertical levels for this element
 7151:    const int kbe = elem->kbe;
 7152:    const double area = elem->area;
 7153: 
 7154:    for (int k = kbe; k < nvrt; k++) {
 7155:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7156:       
 7157:       // Accumulate tracer mass
 7158:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7159:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7160:       }
 7161:    }
 7162: 
 7163:    //  This function returns per element sums. A reduction must be done on the host side.
 7164: }
 7165: 
 7166: 
 7167: __global__ void transport(void) {
 7168: 
 7169:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7170: 
 7171:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7172: 
 7173:    Element *elem = &(mesh->localElemData[ie]);
 7174: 
 7175:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7176: 
 7177:                for (int m=0; m<ntr; m++) {
 7178:                   for (int k=kbe(ie); k<nvrt; k++) {
 7179:                      // Calculate each polynomial's weight 
 7180:                      wm=0.d0; sum1=0.d0; 
 7181:                      wm1=0.d0; wm2=0.d0; 
 7182:                      for (int i=0; i<elem->nweno2; i++) {
 7183:                   
 7184:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7185:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7186:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7187:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7188:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7189:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7190:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7191:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7192:                      // -----------------Hu and Shu (1999)'s method----------------
 7193:                      b4=b1+b2+b3
 7194: 
 7195: //Error: add PRODUCTION CPP
 7196: #ifdef DEBUG
 7197:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7198:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7199:                     call parallel_abort(errmsg)
 7200:                   }
 7201: #endif
 7202: 
 7203:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7204:                   // !----test-------------- 
 7205:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7206:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7207:                   // !wm(i)=wm1(i)*wm2(i)
 7208:                   // !---------------------- 
 7209:                   sum1=sum1+wm(i)
 7210:                 } // end for i
 7211: 
 7212:                 wm=wm/sum1
 7213: 
 7214:                 for (int j=0; j<elem->i34; j++) {
 7215: 
 7216:                   const Side *side  = elem->sides[j];
 7217:                   const Node *node1 = side->n1;
 7218:                   const Node *node2 = side->n2;
 7219: 
 7220:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7221:                      trsd=0.d0
 7222:                      for (int kk=0; kk<nquad; kk++) {
 7223:                         for (int i=0; i<elem->nweno2; i++) {
 7224:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7225:                         } // end for i   
 7226:                      } // end for kk
 7227:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7228:                   } // outward flux
 7229:                } // end for j=1,i34(ie) ! side
 7230:             }
 7231:          }
 7232:               
 7233: 
 7234: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7235: //             //   calculate each polynomial's weight 
 7236: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7237: //                 wm=0.d0; sum1=0.d0
 7238: //                 do i=1,nweno1(ie) !for each polynomial
 7239: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7240: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7241: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7242: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7243: //                   wm(i)=b2
 7244: //                   sum1=sum1+b2
 7245: //                   !wm(i)=1.d0
 7246: //                   !sum1=sum1+1.d0
 7247: 
 7248: // // Error: PRODUCTION
 7249: // #ifdef DEBUG
 7250: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7251: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7252: //                     call parallel_abort(errmsg)
 7253: //                   endif
 7254: // #endif
 7255: 
 7256: //                 enddo !i
 7257: //                 wm=wm/sum1 !final weight
 7258: 
 7259:                 for (int j=0; j<elem->i34; j++) { // side
 7260:                   const Side *side = elem->sides[j];
 7261:                   const Node *node1 = side->n1;
 7262:                   const Node *node2 = side->n2;
 7263: 
 7264:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7265:                     trsd=0.d0
 7266:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7267:                       for (int i=0; i<elem->nweno1; i++) {
 7268:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7269:                       }
 7270:                     enddo //kk
 7271:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7272:                   } // outward flux
 7273:                 } // end for j=1,i34(ie) ! side
 7274:               } // end for k; ntr 
 7275: 
 7276:             else !simple upwind method
 7277:               do j=1,i34(ie)
 7278:                 jsj=elside(j,ie)
 7279:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7280:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7281:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7282:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7283:                   endif
 7284:                 enddo  !vertical layers
 7285:               enddo !j=1,i34(ie) ! side
 7286:             endif !order of accuracy
 7287: 
 7288:          //  enddo !ie
 7289: // !$OMP     end do
 7290: 
 7291: // !$OMP     master
 7292: //           !message passing
 7293: //           if (nproc>1) then
 7294: //             !make a copy of side concentrations
 7295: //             trsd_tmp0=trsd_tmp 
 7296: 
 7297: //             !this exchange routine swaps interface concentration between two partitions
 7298: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7299: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7300: 
 7301: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7302: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7303: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7304: 
 7305: 
 7306: //             !This obtains final values for interface sides
 7307: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7308: //       :    endif !nproc>1
 7309: //           !message passing end
 7310: // !$OMP     end master
 7311: // !$OMP     barrier
 7312: 
 7313: 
 7314: // !         Do advection; conc @ dry elem will not be changed
 7315: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7316: // !$OMP     do reduction(+: h_mass_in)
 7317: //           do i=1,ne
 7318: //             if(idry_e(i)==1) cycle
 7319: 
 7320: 
 7321: // !           Wet elements with 3 wet nodes
 7322: //             do k=kbe(i)+1,nvrt
 7323: 
 7324: 
 7325: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7326: //               dtb_by_bigv = dtb/bigv
 7327:     
 7328: // !             Advective flux
 7329: //               if (ntd_weno==1 .or. itd_weno==1) then
 7330: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7331: //               else
 7332: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7333: //               endif
 7334: 
 7335: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7336: //               do j=1,i34(i)
 7337: //                 jsj=elside(j,i) !side
 7338: //                 iweno=.true. !use weno reconstruction as default
 7339: //                 iel=ic3(j,i) !neighboring elem
 7340: 
 7341: //                 if(iel/=0) then
 7342: //                   if(idry_e(iel)==1) cycle
 7343: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7344: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7345: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7346: //                     iweno=.false.
 7347: //                   endif
 7348: //                 else !land or open bnd side
 7349: //                   !skip land bnd and outflowing open bnd, 
 7350: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7351: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7352: //                     !For outflow open bnd side, estimate mass in (open
 7353: //                     !side cannot be interface side)
 7354: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7355: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7356: //                     endif
 7357: 
 7358: //                     cycle
 7359: //                   endif
 7360: 
 7361: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7362: //                   iweno=.false.  !reset to upwind
 7363: //                   ibnd=isbs(jsj) !global bnd #
 7364: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7365: //                   nwild(1:2)=0
 7366: //                   do ll=1,2 !nodes
 7367: //                     ndo=isidenode(ll,jsj)
 7368: //                     do lll=1,2 !2 possible bnds
 7369: //                       if(isbnd(lll,ndo)==ibnd) then
 7370: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7371: //                         exit
 7372: //                       endif
 7373: //                     enddo !lll
 7374: //                   enddo !ll
 7375: //                   ind1=nwild(1); ind2=nwild(2);
 7376: 
 7377: //                   do jj=1,natrm
 7378: //                     if(ntrs(jj)<=0) cycle
 7379: 
 7380: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7381: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7382: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7383: //                       enddo !ll
 7384: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7385: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7386: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7387: //                       enddo !ll
 7388: //                     else if(itrtype(jj,ibnd)==3) then
 7389: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7390: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7391: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7392: //                       enddo !ll
 7393: //                     else if(itrtype(jj,ibnd)==4) then
 7394: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7395: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7396: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7397: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7398: //                       enddo !ll
 7399: //                     else
 7400: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7401: //   !'
 7402: //                       call parallel_abort(errmsg)
 7403: //                     endif !itrtype
 7404: 
 7405: //                   enddo !jj
 7406: 
 7407: //                   !Tally horizontal mass in for inflow case
 7408: //                   if(max_iadjust_mass_consv>0) h_mass_in(:)=h_mass_in(:)-trel_tmp_outside(1:ntr)*flux_adv_hface(k,jsj)*dtb
 7409: //                 endif !iel
