 7238: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7239: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7240: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7241: 
