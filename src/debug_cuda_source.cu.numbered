 5149:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5150:       }
 5151: 
 5152:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5153:       node->setWind(wind);
 5154: 
 5155:       node->pr = pressAir[idx];
 5156:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5157: 
