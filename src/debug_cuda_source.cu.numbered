 7278: __global__ void getStructSizes(int* sizes)  {
 7279:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7280:       sizes[0] = (int)sizeof(Node);
 7281:       sizes[1] = (int)sizeof(Element);
 7282:       sizes[2] = (int)sizeof(Side);
 7283:       sizes[3] = (int)sizeof(NodeBoundary);
 7284:       sizes[4] = (int)sizeof(SideBoundary);
 7285:       sizes[5] = (int)sizeof(BoundarySegment);
 7286: }
