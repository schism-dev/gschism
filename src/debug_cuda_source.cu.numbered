 2500:    template<typename T>
 2501:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2502:       // Get the values of the field at the nodes of the element
 2503:       res[0] = nodes[0]->*field;
 2504:       res[1] = nodes[1]->*field;
 2505:       res[2] = nodes[2]->*field;
 2506:       if (isQuad()) res[3] = nodes[3]->*field;
 2507:       else          res[3] = T();
 2508:    }
 2509: 
 2510:    template<typename T>
 2511:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2512: 
 2513:       assert(level < nvrt && "Level is out of range");
 2514:       // Get the values of the field at the nodes of the element
 2515:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2516:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2517:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2518:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2519:       else          res[3] = T();
 2520:    }    
 2521: 
 2522:    template<typename T>
 2523:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2524: 
 2525:       assert(level < nvrt && "Level is out of range");
 2526: 
 2527:       // Get the values of the func at the nodes of the element
 2528:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2529:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2530:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2531:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2532:       else          res[3] = T();  // This is 0.0 or a zero vector
 2533: 
 2534:    }      
 2535: 
 2536:    template<typename T>
 2537:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2538:       // Get the values of the field at the nodes of the element
 2539:       res[0] = sides[0]->*field;
 2540:       res[1] = sides[1]->*field;
 2541:       res[2] = sides[2]->*field;
 2542:       if (isQuad()) res[3] = sides[3]->*field;
 2543:       else          res[3] = T();
 2544:    }
 2545: 
 2546:    template<typename T>
 2547:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2548: 
 2549:       assert(level < nvrt && "Level is out of range");
 2550: 
 2551:       // Get the values of the field at the nodes of the element
 2552:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2553:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2554:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2555:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2556:       else          res[3] = T();
 2557:    }    
 2558: 
 2559:    template<typename T>
 2560:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2561: 
 2562:       assert(level < nvrt && "Level is out of range");
 2563: 
 2564:       // Get the values of the func at the nodes of the element
 2565:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2566:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2567:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2568:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2569:       else          res[3] = T();  // This is 0.0 or a zero vector
 2570: 
 2571:    }      
 2572: 
