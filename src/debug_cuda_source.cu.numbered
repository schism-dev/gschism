 1132: struct Side {
 1133: 
 1134:    // Geometry information
 1135:    int idx;               // Index of the side
 1136:    Node *n1, *n2;
 1137:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1138: 
 1139:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1140:    Vector2 center;        // Location of side center. 
 1141:    double zc[nvrt];       // Side center z-coord at each vertical level
 1142: 
 1143:    Frame<ics> frame;
 1144:    
 1145:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1146:                           // this is nullptr
 1147:    
 1148:    int kb;                // Bottom index of the side
 1149:    bool isDry;            // True if the side is dry
 1150:  
 1151:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1152: 
 1153:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1154: 
 1155:    // Physical information
 1156:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1157:    Vector2 btu[nvrt];           // Back-tracked velocity
 1158:    Vector2 U;                   // Vertically averaged velocity vector  
 1159: 
 1160:    Vector2 nuGradU[nvrt];          // nu*grad u
 1161: 
 1162:    Vector2 bcc[nvrt];           // Baroclinic term
 1163:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1164: 
 1165:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1166:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1167:    Vector2 gradPr;               // Gradient of pressure
 1168:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1169: 
 1170: 
 1171:    double hhat;                 // \breve{H} in notes
 1172: 
 1173:    double shapiro;
 1174: 
 1175:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1176: 
 1177:    double coriolis;             // Coriolis parameter
 1178: 
 1179:    // Vegetation parameters
 1180:    double veg_c2;
 1181:    double veg_beta;
 1182: 
 1183:    // Bottom drag parameters.
 1184:    double chi;
 1185:    double chi2;
 1186: 
 1187:    __inline__ __device__ Point2 outputCoords(void) const;
 1188: 
 1189:    __inline__ __device__ double x(double t) const;
 1190:    __inline__ __device__ double y(double t) const;
 1191:    __inline__ __device__ double z(double t) const;
 1192:    __inline__ __device__ double lon(void) const;
 1193:    __inline__ __device__ double lat(void) const;
 1194:    __inline__ __device__ Point2 p2_t(double t) const;
 1195: 
 1196:    __device__ void setFrame(void) {
 1197:       if constexpr(ics == 1) return;
 1198: 
 1199:       double lat, lon;
 1200:       const Point3 p = toPoint3(center, centerZ());
 1201: 
 1202:       // Compute the latitude and longitude of the element center
 1203:       computeLatLon(p, lat, lon);
 1204: 
 1205:       frame.update(lat, lon);        
 1206:    }
 1207:    
 1208: 
 1209:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1210:    // If ics == 2, convert the global point to the local frame of the side
 1211:       
 1212:       if constexpr (ics == 1) {
 1213:          return p;
 1214:       } else {
 1215:          const Point3 c = {center.x, center.y, centerZ()};
 1216:          const Point3 local = frame.G2L(p - c);
 1217:          return local;
 1218:       }
 1219:    }
 1220: 
 1221: 
 1222:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1223:       if constexpr(ics == 1) return v;
 1224:       else return v_frame.projHorVec(v, frame);
 1225:    }
 1226: 
 1227:    __inline__ __device__ double centerZ(void)      const;
 1228:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1229:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1230:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1231:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1232: 
 1233:    __inline__ __device__ Side* neigh(int index) const { 
 1234:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1235:       assert(index >= 0 && index < 4); 
 1236:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1237: 
 1238:       const int ielem = index & 1;           // 0 or 1
 1239:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1240: 
 1241:       const Element* elem = elems[ielem];
 1242: 
 1243:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1244: 
 1245:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1246: 
 1247:    }
 1248: 
 1249:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1250: 
 1251:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1252: 
 1253:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1254:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1255:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1256:    __inline__ __device__ int iadv(void) const;
 1257: 
 1258:    __inline__ __device__ double grav3(void) const;
 1259:    
 1260:    __inline__ __device__ double eta2(void) const;
 1261:    __inline__ __device__ double eta1(void) const;
 1262:    __inline__ __device__ double w2(int k) const;
 1263:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1264:    __inline__ __device__ double depth(void) const;
 1265:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1266:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1267: 
 1268:    __inline__ __device__ double dfv(int k) const;
 1269: 
 1270:    __inline__ __device__ double veg_h(void)  const;
 1271:    __inline__ __device__ double veg_nv(void) const;
 1272:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1273:    __inline__ __device__ double veg_alpha3D(int k) const;
 1274:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1275: 
 1276:    __inline__ __device__ double Cd(void) const;
 1277: 
 1278:    __inline__ __device__ Vector2 tau(void) const;
 1279: 
 1280:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1281:    
 1282: 
 1283:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1284:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1285:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1286:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1287:    } 
 1288:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1289:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1290:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1291:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1292: 
 1293:    // Get valid starting element (for backtracking)
 1294:    __inline__ __device__ Element* getStartElement() {
 1295:       return elems[0] ? elems[0] : elems[1];
 1296:    }
 1297: 
 1298:    
 1299:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1300:       // Given an element, returns the other element that shares this side
 1301:       return (elems[0] == elem) ? elems[1] : elems[0];
 1302:    }
 1303: 
 1304:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1305:       // Given a node, returns the other node that shares this side
 1306:       return (n1 == node) ? n2 : n1;
 1307:    }
 1308:  
 1309:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1310: 
 1311: 
 1312: 
 1313: 
 1314: };
