 2774: 
 2775: __device__ void Node::updateKb(void) {
 2776: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2777: 
 2778:    if constexpr(ivcor == 1) return;
 2779: 
 2780: 
 2781:    if (isDry2()) return;
 2782: 
 2783:    if constexpr(ivcor == 2) {  // SZ coordinates
 2784:       
 2785:       // Compute bottom level index
 2786:       if (depth <= mesh->h_s) {
 2787:          kb = izlev;
 2788:          
 2789:       } else {
 2790:          kb = -1;
 2791:          int L = 0;
 2792:          int R = nzlev; 
 2793:          
 2794:          while (L <= R) {
 2795:             int M = (R + L) / 2;
 2796: 
 2797: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2798:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2799:             
 2800:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2801:                R = M;
 2802:             } else {
 2803:                L = M;
 2804:             }
 2805: 
 2806:             if (R - L == 1) {
 2807:                kb = L;
 2808:                break;
 2809:             }
 2810:          }
 2811:       }
 2812:    } 
 2813: }
 2814: 
 2815: 
 2816: __device__ __inline__ void Node::updateZCoordData(void) {
 2817: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2818: 
 2819:    if (isDry2()) {
 2820:       kb = -1;
 2821:       return;
 2822:    }
 2823: 
 2824:    if constexpr(ivcor == 2) {  // SZ coordinates
 2825:       
 2826:       // Compute bottom level index
 2827:       if (depth <= mesh->h_s) {
 2828:             kb = izlev;
 2829: 
 2830:       } else {
 2831:          kb = -1;
 2832:          for (int i = 0; i < nzlev; i++) {
 2833:             // XXX Use binary search
 2834:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2835:                kb = i;
 2836:                break;
 2837:             }
 2838:          }
 2839:       }
 2840:    } 
 2841:    else if (ivcor == 1) {  // Localized sigma
 2842:       // Do nothing
 2843:    }
 2844: 
 2845: }
 2846: 
 2847: __device__ double Node::compZCoord(int k) const {
 2848:    // Computes the z coordinate at level k.
 2849:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2850:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2851:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2852:    // used 
 2853:    
 2854:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2855: 
 2856:    if (isDry2()) return 0.0;
 2857: // if (htot2() <= h0) printf("idx = %d, htot2() = %f, h0 = %f\n", idx, htot2(), h0); XXX
 2858: // if (htot2() <= h0) return 0.0; // XXX
 2859:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2860: 
 2861:    if constexpr(ivcor == 2) {
 2862: 
 2863:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2864:       const double h_c = mesh->h_c;
 2865:       const double theta_f = mesh->theta_f;
 2866:       const double sinh_theta_f = mesh->sinh_theta_f;
 2867: 
 2868:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2869:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2870:       // once per time step/node.
 2871:       // CHECK: updateZCoordData
 2872: 
 2873:       //  To simplify comparisons, I define index versions of count variables.
 2874:       if      (k == ivrt)           return eta2; 
 2875:       else if (k == izlev)          return -hmod2;
 2876:       else if (k == kb)             return -depth;
 2877:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2878:       else if (k > izlev) {
 2879:          const int ksig = k - izlev;
 2880: 
 2881:          if (hmod2 <= h_c) {
 2882: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2883:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2884:          } 
 2885:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2886:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2887:             assert(false && "ZCOOR: invalid h_c\n");
 2888:          } 
 2889:          else {
 2890: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2891:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2892:                          h_c * mesh->sigma[ksig] + 
 2893:                          (hmod2 - h_c) * mesh->cs[ksig];
 2894:          }
 2895:       } else { 
 2896:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2897:       }
 2898: 
 2899:    }
 2900:    else if constexpr(ivcor == 1) {
 2901:       if (k == kb) return -depth;
 2902:       else if (k == nvrt-1) return eta2;
 2903:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2904:    }
 2905:    
 2906:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2907:    return 0.0;
 2908: }
 2909: 
 2910: 
 2911: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2912:    // Checks if a side in on the boundary
 2913:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2914: 
 2915:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2916:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2917: 
 2918:    // Indices of the nodes that form the side
 2919:    const int n1 = side.n1->idx;
 2920:    const int n2 = side.n2->idx;
 2921:    isLand = false;
 2922:    
 2923: 
 2924:    // Check if the side is on a land boundary
 2925:    for (int i = 0; i < nland; i++) {
 2926:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2927:          // Consecutive nodes in the land boundary segment
 2928:          const int b1 = ilnd[i + j*nland];
 2929:          const int b2 = ilnd[i + (j + 1)*nland];
 2930: 
 2931:          assert(b1 != -1 && b2 != -1);
 2932: 
 2933:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2934:             
 2935:             isLand = true;
 2936:             return i;
 2937:          }
 2938:       }
 2939:    }
 2940: 
 2941:    // Check if the side is on an open boundary
 2942:    for (int i = 0; i < nope; i++) {
 2943:       for (int j = 0; j < nond[i] - 1; j++) {
 2944:          // Consecutive nodes in the open boundary segment
 2945:          const int b1 = iond[i + j*nope];
 2946:          const int b2 = iond[i + (j + 1)*nope];
 2947: 
 2948:          assert(b1 != -1 && b2 != -1);
 2949: 
 2950:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2951:             isLand = false;
 2952:             return i;
 2953:          }
 2954:       }
 2955:    }
 2956: // printf("side.idx = %d, n1 = %d, n2 = %d\n", side.idx, n1, n2);             
 2957:    return -1;
 2958: }
 2959: 
 2960: 
 2961: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2962:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2963:                                     double *wind_rotate_angle, 
 2964:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2965:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2966:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2967:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2968:                                     double *drag, double *roughness) {
 2969: 
 2970:    NODE(pnode);  
 2971:    const int i = idx_node;
 2972:    Node &node(*pnode);
 2973: 
 2974:    node.idx = i;
 2975: 
 2976:    const int idxNodeStart = nodeNeighNodesStart[i];
 2977:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2978:    node.numNodes = idxNodeEnd - idxNodeStart;
 2979:    node.nodes = nodeNeighNodes + idxNodeStart;
 2980:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2981: 
 2982: 
 2983: 
 2984:    const int idxElemStart = nodeNeighElemsStart[i];
 2985:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2986:    node.numElements = idxElemEnd - idxElemStart;
 2987:    node.elements = nodeNeighElems + idxElemStart;
 2988: 
 2989: 
 2990:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2991:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2992:       const int partNode = localNodePart[idxNodeGlobal]; 
 2993:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2994: 
 2995:       Node *node_ptr = nodes[partNode] + idxNode;
 2996:       
 2997:       nodeNeighNodes[idx] = node_ptr;
 2998:    }
 2999: 
 3000: 
 3001:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3002:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3003:       const int partElem = localElemPart[idxElemGlobal];
 3004:       const int idxElem  = localElemIndices[idxElemGlobal];
 3005: 
 3006:       Element *elem_ptr = elems[partElem] + idxElem;
 3007: 
 3008:       nodeNeighElems[idx] = elem_ptr;
 3009:    }      
 3010: 
 3011: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 3012: 
 3013:    node.wind_angle = wind_rotate_angle[i];
 3014: 
 3015: 
 3016:    node.p.x   = node_coords[i * 3];
 3017:    node.p.y   = node_coords[i * 3 + 1];
 3018:    node.depth = node_coords[i * 3 + 2];
 3019: 
 3020:    if (use_ll) {
 3021:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3022:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3023:    }
 3024: 
 3025: 
 3026:    node.numSides = 0;
 3027: 
 3028:    node.Cd = drag[i];
 3029:    node.rough = roughness[i];
 3030:    
 3031:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3032: 
 3033:    
 3034:    // Links the node to the boundary information
 3035:    if (isbnd[i] >= 0) {
 3036: 
 3037:      
 3038:       // Get the index of the node boundary
 3039:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3040: 
 3041:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3042:       node.nodeBnd->node = &node;
 3043: 
 3044:       node.nodeBnd->sideBnd1 = nullptr;
 3045:       node.nodeBnd->sideBnd2 = nullptr;
 3046: 
 3047:       if (isbnd[i]>=0) {
 3048: 
 3049:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3050:          
 3051:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3052:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3053: 
 3054:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3055:          node.nodeBnd->segment->clen  = nan("1");
 3056:          node.nodeBnd->segment->carea = nan("1");
 3057: 
 3058:       }
 3059: //          else {  XXXXXX
 3060: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3061: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3062: //          }
 3063:       
 3064: 
 3065:    }
 3066:    else {
 3067: 
 3068:       node.nodeBnd = nullptr; // For internal nodes
 3069: 
 3070:       if (isbnd[i] == landSegment) {
 3071:          node.nodeBnd = &landBoundaryNode;
 3072:          node.nodeBnd->segment = &landBoundarySegment;
 3073:       }
 3074:       // node.nodeBnd->node = &node;
 3075:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3076:       // // node.nodeBnd = nullptr;
 3077:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3078:       
 3079:    }
 3080:    
 3081:    // XXXX GAUSSIAN HILL VELOCITIES
 3082: #ifdef GAUSSIAN_HILL_VELOCITIES
 3083:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3084:       constexpr double rot_per = 3000.0;
 3085:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3086:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3087:    // XXXXX
 3088: #endif
 3089: 
 3090: }
 3091: 
 3092: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3093:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3094:                                     double *wind_rotate_angle,   
 3095:                                     int *isdel, int *isidenode, int *isbnd,
 3096:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3097:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3098:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3099:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3100:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3101:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3102:                                     double *drag, double *roughness) {
 3103: 
 3104: 
 3105:    SIDE(pside);
 3106:    Side &side(*pside);
 3107:    const int i = idx_side;
 3108: 
 3109:    side.idx = i;  
 3110:    
 3111:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3112:    const double fc   = 2.0*omega_e*sin(sfea0);
 3113:    const double beta = 2.0*omega_e*cos(sfea0);
 3114: 
 3115:    // finding the pointer to the nodes that form the side
 3116:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3117:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3118: 
 3119:    const int locidx_n1 = localNodeIndices[idx_n1];
 3120:    const int locidx_n2 = localNodeIndices[idx_n2];
 3121:    const int part_n1 =   localNodePart[idx_n1];
 3122:    const int part_n2 =   localNodePart[idx_n2];
 3123: 
 3124:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3125:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3126: 
 3127:    // Counts the number of sides connected to each node
 3128:    side.n1->numSides++;
 3129:    side.n2->numSides++;
 3130: 
 3131:    // Normal, unitary vector to the side
 3132:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3133:    side.n = normalize(side.n);
 3134: 
 3135:    // Side boundary type
 3136:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3137:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3138: 
 3139:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3140:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3141:    {
 3142:       bool isLand = false;
 3143:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3144:       
 3145:       if (isbs > -1) {
 3146:          // assert(isLand || isbs>=0);
 3147:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3148: 
 3149:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3150: 
 3151:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3152:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3153: 
 3154:          assert (isLand == side.sideBnd->segment->isLand);
 3155: 
 3156:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3157:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3158:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3159: 
 3160:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3161:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3162:          
 3163:          side.sideBnd->side = &side;
 3164: 
 3165:       }
 3166:       else {
 3167:          side.sideBnd = nullptr;
 3168:       }
 3169:    }
 3170:    else 
 3171:    {
 3172:       side.sideBnd = nullptr;
 3173:    }
 3174: 
 3175: 
 3176:    // finding the pointer to the elements that share the side
 3177:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3178:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3179: 
 3180:    if (idx_e1 > -1) {
 3181:       const int locidx_e1 = localElemIndices[idx_e1];
 3182:       const int part_e1 =  localElemPart[idx_e1];
 3183:       side.elems[0] = elems[part_e1] + locidx_e1;
 3184: 
 3185:    }
 3186:    else {
 3187:       side.elems[0] = nullptr;
 3188:    }
 3189: 
 3190:    if (idx_e2 > -1) {
 3191:       const int locidx_e2 = localElemIndices[idx_e2];
 3192:       const int part_e2 =  localElemPart[idx_e2];
 3193:       side.elems[1] = elems[part_e2] + locidx_e2;
 3194:    }
 3195:    else {
 3196:       side.elems[1] = nullptr;
 3197:    }
 3198: 
 3199:    // Compute the center of the side
 3200:    side.center = 0.5*(side.n1->p + side.n2->p);
 3201: 
 3202:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3203:    side.shapiro = shapiro0;
 3204: 
 3205: #ifdef GAUSSIAN_HILL_VELOCITIES
 3206: // XXXX
 3207: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3208: constexpr double rot_per=3000.0;
 3209: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3210: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3211: // XXXXX      
 3212: #endif
 3213:    // Compute the z level at the center of the side
 3214:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3215:    
 3216:    // Compute the length of the side
 3217:    const Vector2 vLen = side.n2->p - side.n1->p;
 3218:    side.len = sqrt(dot(vLen, vLen));
 3219: 
 3220: 
 3221:    // Compute the Coriolis coefficient
 3222: 
 3223:    if constexpr(ncor == -1 || ncor == 0) {
 3224:       side.coriolis = coricoef;
 3225:    }
 3226:    else {
 3227:       const double sphi = side.lat();  // Latitude at the center of the side
 3228: 
 3229: // XXXXXX ERROR WHEN use_ll is false??????
 3230:       if constexpr(ics == 1) {
 3231:          // XXXXXXX
 3232:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3233:       }
 3234:       else {
 3235:          side.coriolis = 2.0*omega_e*sin(sphi);
 3236:       }
 3237: 
 3238:    }
 3239: }
 3240: 
 3241: 
 3242: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3243:    double *node_coords, double *node_coords_ll, bool use_ll,
 3244:    double *wind_rotate_angle,   
 3245:    int *isdel, int *isidenode, int *isbnd,
 3246:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3247:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3248:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3249:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3250:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3251:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3252:    double *drag, double *roughness) {
 3253: 
 3254:    ELEM(pelem);
 3255:    Element &elem(*pelem);
 3256:    const int i = idx_elem;
 3257: 
 3258:    elem.idx = i;
 3259: 
 3260:    for (int j = 0; j < i34[i]; j++) {
 3261:       const int idxNode = elnode[i*4 + j];  
 3262:       const int idxSide = elside[i*4 + j];
 3263:       
 3264:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3265:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3266: 
 3267:       // Find the neighboring element  
 3268:       if (elem.sides[j]->elems[0] == &elem) {
 3269:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3270:       }
 3271:       else {
 3272:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3273:       }
 3274:       
 3275:    }
 3276: 
 3277:    elem.i34 = i34[i];
 3278: 
 3279:    // Compute the centroid of the element and its depth
 3280:    Vector2 center = {0.0, 0.0};
 3281:    elem.depth = 0.0;
 3282:    for (int j = 0; j < i34[i]; j++) {
 3283: 
 3284: // printf("WWW i = %d, node = %p, elem.i34 = %d\n", i, elem.nodes[j], elem.i34);    
 3285: 
 3286: 
 3287:       center += elem.nodes[j]->p/i34[i];
 3288:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3289:    }
 3290:    elem.center = center;
 3291: 
 3292:    
 3293:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3294:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3295: 
 3296:    elem.area = elem.computeSignedArea(); 
 3297:    elem.radius = sqrt(elem.area)/pi; 
 3298:    
 3299:    // Determines which way the normal vector to each side is oriented.
 3300:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3301:    for (int j = 0; j < i34[i]; j++)  
 3302:    {
 3303:       if (elem.sides[j]->elems[0] == &elem) {
 3304:          elem.ssign[j] =  1.0;
 3305:       }
 3306:       else {
 3307:          elem.ssign[j] = -1.0;
 3308:       }
 3309: 
 3310:    }
 3311: 
 3312:    // Derivatives of shape functions
 3313:    //  For ics=2, this is done inside element/ll frame XXX
 3314:    //  For quads, the derivative is evaluated at centroid
 3315:    for (int j = 0; j < elem.i34; j++) {
 3316:       const double area = elem.area;
 3317:       const int id2 = elem.nxq(1 + j);
 3318:       const int id3 = elem.nxq(2 + j);
 3319:       const int id4 = elem.nxq(3 + j);
 3320:       if (elem.isTri()) {
 3321:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3322:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3323:          // da1/dx = (y1 - y2)/(2*area)
 3324:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3325:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3326:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3327:       }
 3328:       else  { // Quad; evaluate at centroid
 3329:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3330:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3331:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3332:       } // if Tri
 3333: 
 3334:    } // for j   
 3335:    
 3336:    
 3337: 
 3338: }
 3339: 
 3340: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3341:                                             double *emo, double *efa, 
 3342:                                             double *umo, double *ufa, 
 3343:                                             double *vmo, double *vfa) {
 3344: 
 3345: 
 3346:    NODE_BND(nodeBnd);
 3347:    const int idx = idx_node_bnd;    
 3348: 
 3349:    nodeBnd->idx = idx;
 3350: 
 3351:    // Need to find the segment index and the index of the node on the segment
 3352:    int idxNode = -1;
 3353:    int iseg, i;
 3354:    for (iseg = 0; iseg < nope; iseg++) {
 3355:       // for each segment...
 3356:       for (i = 0; i < nond[iseg]; i++) {
 3357:          idxNode = iond[iseg + i*nope];
 3358:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3359:          
 3360:       }
 3361:    }
 3362: 
 3363:    assert(iseg < nope && "iseg is out of bounds");
 3364: 
 3365: found: // Jumped here when the node was found
 3366: 
 3367:    nodeBnd->isEssentialBC = true;
 3368:    nodeBnd->elbc = 0.0;
 3369: 
 3370:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3371: 
 3372:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3373:       nodeBnd->efa[jfr] = efa[idx2];
 3374:       nodeBnd->emo[jfr] = emo[idx2];
 3375:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3376:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3377: 
 3378:    }
 3379:         
 3380: 
 3381: }
