 7600: __global__ void printMatrix(bool full) {
 7601:    // Debugging: print the matrix
 7602: 
 7603:    const int size = mesh->np;
 7604:    double sum = 0.0;
 7605:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7606:       const Node *node = mesh->localNodeData + idx_node;
 7607:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7608:       for (int j = 0; j < node->numNodes; j++) {
 7609:          Node* nbNode = node->nodes[j];
 7610:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7611:          sum += node->coeffMatrix[j];
 7612:       }
 7613:       if (full) printf("]\n");
 7614: 
 7615: 
 7616:    }
 7617:    if (!full) printf("sum=%lf\n", sum);
 7618: }
