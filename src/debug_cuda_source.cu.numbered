 2584: //       const double y4 = nodes[nxq(i+1)]->y;
 2585: 
 2586: //       const Side& side = sides[i];
 2587: 
 2588: //       xIntersect=-1.e25;
 2589: //       yIntersect=-1.e25;
 2590: 
 2591: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2592: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2593: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2594: 
 2595: //       if (delta != 0.0) {
 2596: //          // Solves the two linear equations for tt1 and tt2
 2597: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2598: //          const double tt2 = delta2/delta;
 2599: 
 2600: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2601: //          // Similarly, we use tt2 to compute the intersection point.
 2602: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2603: //             xIntersect = x3 + (x4 - x3)*tt2;
 2604: //             yIntersect = y3 + (y4 - y3)*tt2;
 2605: 
 2606: //             intersectingSide = side;
 2607: //             nextElement = nghbElems[i];
 2608: 
 2609: //             return true;
 2610: //          }
 2611:       
 2612: //       }
