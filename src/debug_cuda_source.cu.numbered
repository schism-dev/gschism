 3811: extern "C" {
 3812: 
 3813:    __global__ void scaleGravity(double loadtide_coef) {
 3814: 
 3815: 
 3816:       NODE(node);
 3817: 
 3818:       // SAL option: scale gravity
 3819:       if constexpr(iloadtide==2) {  // simple const
 3820:          node->grav2 = grav*(1.0 - loadtide_coef);
 3821: 
 3822:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3823:         
 3824:           const double depth = max(node->depth, 0.0);
 3825:           const double tmp1 = sqrt(depth);
 3826:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3827:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3828:                              2.6969e-13*depth*depth*depth*tmp1;
 3829:           
 3830:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3831:           
 3832: 
 3833: 
 3834:           node->grav2 = grav*(1.0 - beta_bar);
 3835: 
 3836:       } else {  // iloadtide=0,1
 3837:         node->grav2=grav;
 3838: 
 3839:       }
 3840: 
 3841:    }
 3842: 
 3843: 
 3844:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3845: 
 3846:       NODE_BND(nodeBnd);
 3847: 
 3848:       Node *node = nodeBnd->node;
 3849: 
 3850:       node->ETP = 0.0;
 3851: 
 3852:       for (int j=0; j<ntip; j++) {
 3853: 
 3854:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3855:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3856:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3857: 
 3858:          if constexpr(iloadtide==1) { // loading tide
 3859:             assert(false && "Loading tide not implemented");
 3860:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3861:          }
 3862:          
 3863:       }
 3864:       
 3865:    }
