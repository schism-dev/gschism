 5238: extern "C" {
 5239: 
 5240:    __global__ void scaleGravity(double loadtide_coef) {
 5241: 
 5242: 
 5243:       NODE(node);
 5244: 
 5245:       // SAL option: scale gravity
 5246:       if constexpr(iloadtide==2) {  // simple const
 5247:          node->grav2 = grav*(1.0 - loadtide_coef);
 5248: 
 5249:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5250:         
 5251:           const double depth = max(node->depth, 0.0);
 5252:           const double tmp1 = sqrt(depth);
 5253:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5254:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5255:                              2.6969e-13*depth*depth*depth*tmp1;
 5256:           
 5257:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5258:           
 5259: 
 5260: 
 5261:           node->grav2 = grav*(1.0 - beta_bar);
 5262: 
 5263:       } else {  // iloadtide=0,1
 5264:           node->grav2 = grav;
 5265: 
 5266:       }
 5267: 
 5268:    }
 5269: 
