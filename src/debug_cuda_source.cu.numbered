 1550: //     
 1551: //===============================================================================
 1552: __device__ __forceinline__ void update_bdef(double time, double x0, double y0, double &dep, Vector3 &vel) {
 1553:    // For imm=2, user needs to update bottom depth and velocity
 1554: 
 1555:    dep = min(1.0, 7.0 - (x0 + time));
 1556:    vel = { -1.0, 0.0, 0.0 };
 1557: 
 1558: }
 1559: 
 1560: 
 1561: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1562:    // Computes the 3D normal vector to the element at level k
 1563:    // Returns the normal vector and the area of the element
 1564: 
 1565:       if (isTri()) {
 1566:          // For triangles...
 1567: 
 1568:          // Gets the normal vector to the element (with a length equal to twice the area)
 1569:          if constexpr(ics==1) {
 1570:             const int kb0 = max(k, nodes[0]->kb);
 1571:             const int kb1 = max(k, nodes[1]->kb);
 1572:             const int kb2 = max(k, nodes[2]->kb);
 1573: 
 1574:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1575:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1576:             
 1577:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1578:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1579:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1580:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1581: 
 1582:             area3D = sqrt(nx*nx + ny*ny + nz*nz);
 1583: 
 1584:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1585: 
 1586:             return {nx/area3D, ny/area3D, nz/area3D};
 1587: 
 1588:            
 1589:          }
 1590:          else {  // lat/lon
 1591:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1592: 
 1593:          } // if ics
 1594:       }
 1595:       else {
 1596:          // For quads...
 1597: 
 1598:          assert(false && "Element normal vector: quads not yet implemented");
 1599: 
 1600: 
 1601:       }
 1602:    }
 1603: 
 1604: /**
 1605:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1606:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1607:    If the segment is completely inside the element, then it returns true.
 1608: 
 1609:    This function assumes:
 1610:    - The initial point is on a side of the element. 
 1611:    - Its position is given by parameter t in the range [0,1].
 1612:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1613:       intersects the element (elements are convex).
 1614: 
 1615:    To find the intersection point, this function does the following:
 1616:    - it finds the intersection of the line segment with all the element side lines,
 1617:       except for the one that contains the initial point.
 1618:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1619:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1620:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1621:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1622:       track segment is almost parallel to the element side line.
 1623: 
 1624:    Inputs:
 1625:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1626:    @param x2, y2: other end of the line segment
 1627: 
 1628:    Outputs:
 1629:    @param side:  side that intersects the line segment (input and output)
 1630:    @param nextElement (output): element that contains the intersection point
 1631:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1632:    @param zint (input/output): Vertical coordinate of the intersection point
 1633: 
 1634:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1635:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1636:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1637: 
 1638:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1639:    (Delta) being zero.
 1640: 
 1641:    The intersection2 point happens when:
 1642:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1643:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1644:    
 1645:    Assumption: the 4 points (including those of the side segment) are different.
 1646:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1647:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1648:    If true, (xIntersect,yIntersect) is the intersection.				
 1649:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1650: **/
 1651: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1652:                                               double &t, double& tIntersect) {
 1653: 
 1654:    double closest_intersect_t = 1e10;
 1655:    bool found_intersection = false;
 1656: 
 1657:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1658:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1659:    const Point2 x1 = side->point(t);
 1660:    
 1661: 
 1662:    Side *nextSide = nullptr;
 1663:    for (int i = 0; i < i34; i++) {
 1664: 
 1665:       // Element's i-th side 
 1666:       Side *side2 = sides[i];
 1667: 
 1668:       // Skip the side that contains the initial point
 1669:       if (side2 == side) continue;
 1670: 
 1671:       // (x3,y3)-(x4,y4) is the element side line
 1672:       const Point2 x3 = side2->n1->p2();
 1673:       const Point2 x4 = side2->n2->p2();
 1674: 
 1675:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1676:       const double delta = cross(x2 - x1, x3 - x4);
 1677: 
 1678:       if (delta != 0.0) {
 1679: 
 1680:          const double delta1 = cross(x3 - x1, x3 - x4);
 1681:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1682: 
 1683:          // Solves the two linear equations for tt1 and tt2
 1684:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1685:          const double tt2 = delta2/delta;
 1686: 
 1687:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1688:             closest_intersect_t = min(closest_intersect_t, tt1);
 1689:             nextSide = side2;
 1690: 
 1691:             nextElement = nextSide->otherElem(this);
 1692:             tIntersect = max(small, min(tt1, 1.0-small));
 1693:             t = tt2;
 1694: 
 1695:             found_intersection = true;
 1696:          }
 1697:       
 1698:       }
 1699: 
 1700:    }
 1701:    
 1702: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1703: 
 1704: 
 1705:    // found_intersection should always be true, since we checked all the sides.  
 1706:    side = nextSide;
 1707: // if (found_intersection) {
 1708: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1709: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1710: // }   
 1711:    // if (!found_intersection) {
 1712:    //    // Check if the segment is parallel to the initial side
 1713:    //    printf("XXX segment: side = %p\n", side);
 1714:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1715:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1716:    //       assert(false && "Segment is parallel to the initial side");
 1717:    //       found_intersection = true;
 1718:    //       nextElement = side->otherElem(this);
 1719:    //       tIntersect = t;
 1720:    //       t = 0.0;
 1721:    //       found_intersection = true;
 1722:    //    }
 1723:    // }
 1724:    return found_intersection;
 1725: }
 1726: 
 1727: 
 1728: 
 1729: 
 1730: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1731:                                               double &t, double& tIntersect) {
 1732: 
 1733:    double closest_intersect_t = 1e10;
 1734:    bool found_intersection = false;
 1735: 
 1736: double minDelta = 1e10; 
 1737: double btt1 = 1e10, btt2;
 1738:    for (int i = 0; i < i34; i++) {
 1739: 
 1740:       Side *side2 = sides[i];
 1741: 
 1742:       // (x3,y3)-(x4,y4) is the element side line
 1743:       const Point2 x3 = side2->n1->p2();
 1744:       const Point2 x4 = side2->n2->p2();
 1745: 
 1746:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1747:       const double delta = cross(x2 - x1, x3 - x4);
 1748: 
 1749:       if (abs(delta) > 0) {
 1750: 
 1751:          const double delta1 = cross(x3 - x1, x3 - x4);
 1752:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1753: 
 1754:          // Solves the two linear equations for tt1 and tt2
 1755:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1756:          const double tt2 = delta2/delta;
 1757: 
 1758: if (abs(tt1) < abs(btt1)) {
 1759:    minDelta = abs(delta);
 1760:    btt1 = tt1;
 1761:    btt2 = tt2;
 1762: }
 1763: 
 1764: if (idx == 0) printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1765:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1766:             closest_intersect_t = min(closest_intersect_t, tt1);
 1767:             side = side2;
 1768:             nextElement = side->otherElem(this);
 1769:             t = tt2;
 1770:             tIntersect = max(small, min(tt1, 1.0-small));
 1771:             found_intersection = true;
 1772:          }
 1773:       
 1774:       }
 1775:       else {  // parallel segments
 1776:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1777:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1778: 
 1779:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1780: 
 1781:          // const double dist = dot(x1 - x3, side2->n);
 1782:          // if (abs(dist) < small*length(x3 - x4)) {
 1783:          //    const double2 unitarySide = normalize(x4 - x3);
 1784:          //    const double len = dot(x2 - x1, unitarySide);
 1785:          //    t = t + len;
 1786:          //    t = max(0.0, min(t, 1.0));
 1787:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1788: 
 1789: 
 1790:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1791:          //    // t = tt2;
 1792:          //    found_intersection = true;
 1793:          // }
 1794:       }
 1795: 
 1796: 
 1797:    }
 1798: 
 1799:    if (!found_intersection) {
 1800:       
 1801: if (idx == 0) printf("ZZ No intersection found:\n"
 1802:            "Element %d\n"
 1803:            "in = %d\n"
 1804:            "minDelta = %e\n"
 1805:            "tt1 = %e, tt2 = %e\n"
 1806:            "segment: (%f, %f)-(%f, %f)\n"
 1807:            "Vertices:\n"
 1808:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1809:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1810:            IDX(nextElement),
 1811:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1812:            minDelta,
 1813:            btt1, btt2,
 1814:            x1.x, x1.y,
 1815:            x2.x, x2.y,
 1816:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1817:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1818:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1819:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1820:            nodes[0]->p.x, nodes[0]->p.y,
 1821:            nodes[1]->p.x, nodes[1]->p.y,
 1822:            nodes[2]->p.x, nodes[2]->p.y,
 1823:            nodes[0]->p.x, nodes[0]->p.y);
 1824: 
 1825:    }
 1826: 
 1827:    // assert(found_intersection && "No intersection found");
 1828: 
 1829:    // found_intersection should always be true, since we checked all the sides.  
 1830:    return found_intersection;
 1831: }
