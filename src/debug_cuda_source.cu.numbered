 3913: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3914:                                             double *emo, double *efa, 
 3915:                                             double *umo, double *ufa, 
 3916:                                             double *vmo, double *vfa) {
 3917: 
 3918: 
 3919:    NODE_BND(nodeBnd);
 3920:    const int idx = idx_node_bnd;    
 3921: 
 3922:    nodeBnd->idx = idx;
 3923: 
 3924:    // Need to find the segment index and the index of the node on the segment
 3925:    int idxNode = -1;
 3926:    int iseg, i;
 3927:    for (iseg = 0; iseg < nope; iseg++) {
 3928:       // for each segment...
 3929:       for (i = 0; i < nond[iseg]; i++) {
 3930:          idxNode = iond[iseg + i*nope];
 3931:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3932:          
 3933:       }
 3934:    }
 3935: 
 3936:    assert(iseg < nope && "iseg is out of bounds");
 3937: 
 3938: found: // Jumped here when the node was found
 3939: 
 3940:    nodeBnd->isEssentialBC = true;
 3941:    nodeBnd->elbc = 0.0;
 3942: 
 3943:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3944: 
 3945:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3946:       nodeBnd->efa[jfr] = efa[idx2];
 3947:       nodeBnd->emo[jfr] = emo[idx2];
 3948:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3949:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3950: 
 3951:    }
 3952:         
 3953: 
 3954: }
