 8006: __global__ void returnMatrix(double *res) {
 8007:    // Debugging: returns the matrix as a CuPy array
 8008: 
 8009:    const int size = mesh->np;
 8010:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8011:       const Node *node = mesh->localNodeData + idx_node;
 8012:       res[idx_node*size + idx_node] = node->coeffDiag;
 8013:       for (int j = 0; j < node->numNodes; j++) {
 8014:          Node* nbNode = node->nodes[j];
 8015:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8016:       }
 8017: 
 8018:    }
 8019:    
 8020: }
