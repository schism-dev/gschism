 6391:    __global__ void resetBoundaryAreas(void) {
 6392:       // Reset boundary areas and lengths for each segment.
 6393: 
 6394:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6395:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6396:       SIDE_BND(sideBnd);
 6397: 
 6398:       BoundarySegment *segment = sideBnd->segment;
 6399: 
 6400:       segment->carea = 0.0;
 6401:       segment->clen = 0.0;
 6402:  
 6403:    }
 6404: 
 6405:    __global__ void computeBoundaryAreas(void) {
 6406:    // Calculation of cross-section areas and lengths for flow b.c.
 6407: 
 6408:       SIDE_BND(sideBnd);
 6409: 
 6410:       const Side *side = sideBnd->side;
 6411:       BoundarySegment *segment = sideBnd->segment;
 6412: 
 6413:       if (segment->ifltype != 0) {
 6414: 
 6415:          const Node *n1 = side->n1;
 6416:          const Node *n2 = side->n2;
 6417: 
 6418:          const double htot = side->htot2();
 6419: 
 6420:          if (!side->isDry) {
 6421:             atomicAdd(&segment->carea, htot*side->len);
 6422:             atomicAdd(&segment->clen, side->len);
 6423:          }
 6424:       }
 6425: 
 6426:    }
 6427: 
 6428: 
 6429:    __global__ void computeFlowBcVelocities(double time) {
 6430: 
 6431:       SIDE_BND(sideBnd);
 6432: 
 6433:       const Side *side = sideBnd->side;
 6434:  
 6435:       const bool isDry = side->isDry;
 6436:       const bool isLand = sideBnd->segment->isLand;
 6437: 
 6438:    
 6439:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6440: 
 6441:       if (isDry || isLand) return;
 6442: 
 6443:       // For wet sides in open boundaries...
 6444:       const Vector2 n = side->n;
 6445:       const BoundarySegment *segment = sideBnd->segment;
 6446: 
 6447:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6448: 
 6449:       const int ifltype = segment->ifltype;
 6450: 
 6451:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6452:       const Vector2 r_nuth0 = r_uth0*n;
 6453: 
 6454: 
 6455:       if (ifltype == 1 || ifltype == 2) {
 6456:       
 6457:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6458: 
 6459:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6460: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6461:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6462:          
 6463:       } else if (ifltype == -1) { // Flather 1
 6464: 
 6465:          for (int k = 0; k < nvrt; k++) {
 6466: 
 6467:             // uth is the normal vel.; no ramp up
 6468:             const double uth = sideBnd->nuth(k);
 6469:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6470: 
 6471:             sideBnd->ubc[k] += uth*n;
 6472:          }
 6473: 
 6474:       } else if (ifltype == 3 || ifltype == 5) {
 6475:          // vnth0=0 !normal vel.
 6476: 
 6477:          Vector2 r_u1_bar = {0.0, 0.0};
 6478:          // Computes the contribution to the velocity from all tide frequencies
 6479:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6480: 
 6481:             const Vector2 ufa  = sideBnd->ufa[jfr]; 
 6482:             const Vector2 umo  = sideBnd->umo[jfr]; 
 6483: 
 6484:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6485:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6486:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6487:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6488: 
 6489:          }
 6490: 
 6491: 
 6492:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6493: 
 6494:       } // if (ifltype = 3 || ifltype == 5
 6495: 
 6496: 
 6497: 
 6498:    }
 6499: 
 6500:    __global__ void computeElevationBoundaryConditions(double time) {
 6501:       // Compute elevation essential boundary conditions 
 6502: 
 6503:       NODE_BND(nodeBnd); // Each boundary node.
 6504: 
 6505:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6506: 
 6507:       const Node *node = nodeBnd->node;
 6508:       const BoundarySegment *segment = nodeBnd->segment;
 6509:       const int iettype = segment->iettype;
 6510:       
 6511: 
 6512:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6513:       double eic = 0.0;
 6514:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6515:       else                 eic = 0.0;
 6516: 
 6517:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6518:       const double r_eth = ramp*nodeBnd->eth;
 6519:       double r_eta1_bar = 0.0;
 6520: 
 6521:       // Compute tide elevation
 6522:       if (iettype == 3 || iettype == 5) {   
 6523: 
 6524:          if constexpr(iloadtide==1) { // loading tide
 6525:             assert(false && "Loading tide not implemented");
 6526:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6527:          }
 6528:          
 6529:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6530: 
 6531:             const double efa  = nodeBnd->efa[jfr]; 
 6532:             const double emo  = nodeBnd->emo[jfr]; 
 6533: 
 6534:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6535:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6536:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6537: 
 6538: 
 6539:          } // for jfr
 6540: 
 6541:       } // if iettype
 6542: 
 6543:       switch (iettype) {
 6544:          case 1:
 6545:          case 2:
 6546:          case 4:
 6547:             nodeBnd->elbc = r_eic + r_eth;
 6548:             break;
 6549:          case 3:
 6550:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6551:             break;
 6552:          case 5:
 6553:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6554:             break;
 6555:       } // switch
 6556: 
 6557: 
 6558:       //Add inverse barometric effects
 6559:       if (iettype != 0 && inv_atm_bnd == 1) {
 6560:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6561:       }
 6562: 
 6563:    }
 6564: 
 6565: 
 6566:    __global__ void computeHorizontalViscosity(void) { 
 6567: 
 6568:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6569: 
 6570:       SIDE(side);
 6571: 
 6572:       if (side->isDry) return;
 6573: 
 6574:       for (int k = 0; k < nvrt; k++) {
 6575:          side->nuGradU[k] = {0.0, 0.0};
 6576:       }
 6577: 
 6578:       if constexpr(ihorcon == 1) {
 6579:          for (int k = side->kb; k < nvrt - 1; k++) {
 6580:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6581:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6582:             // By Zhang and Baptista.
 6583: 
 6584:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6585:             // This is a standard discretization of the Laplacian operator.
 6586:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6587:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6588:             // Gamma is hvis_coef0 in the code.
 6589:             // The value of gamma needs to be < 0.5.
 6590: 
 6591:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6592:             // side under consideration in each of the two possible elements that share the side.
 6593:             Vector2 sumU = {0.0, 0.0};
 6594:             for (int l = 0; l < 2; l++) {
 6595:                const Element *elem = side->elems[l];
 6596: 
 6597:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6598: 
 6599:                // Find the local index of the side in the element
 6600:                const int idxSide = elem->sideLocalIdx(side);
 6601: 
 6602:                // Find the two sides that are connected to the side under consideration
 6603:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6604:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6605: 
 6606:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6607: 
 6608:             }
 6609: 
 6610:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6611: 
 6612:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6613:    
 6614:          }
 6615:       }
 6616:       else if constexpr(ihorcon == 2) {
 6617:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6618:       }
 6619: 
 6620: 
 6621:    }
 6622: 
 6623: 
 6624:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6625: 
 6626:       // Set essential boundary conditions 
 6627:       NODE(node); // Each boundary node
 6628:       NodeBoundary *nodeBnd = node->nodeBnd;
 6629:       
 6630:  
 6631:       // Check if this node has essential BC
 6632:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6633: 
 6634:          // Verify BC value is valid
 6635:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6636: 
 6637:        
 6638:          // Set diagonal to 1 and zero off-diagonals
 6639:          for (int j = 0; j <= node->numNodes; j++) {
 6640:                node->coeffRow[j] = 0.0;
 6641:          }
 6642: 
 6643:          *(node->coeffDiag) = 1.0;
 6644: 
 6645: 
 6646:          // Set solution and RHS to BC value
 6647:          node->mX  = nodeBnd->elbc;
 6648:          node->qel = nodeBnd->elbc;
 6649: 
 6650:       } else {
 6651:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6652: 
 6653:          for (int j = 0; j < node->numNodes; j++) {
 6654:                const Node* nbNode = node->nodes[j];
 6655:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6656: 
 6657:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6658: 
 6659:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6660:                   // Verify neighbor's BC value
 6661:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6662: 
 6663:                   // Subtract contribution to RHS
 6664:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6665:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6666:                }
 6667:          }
 6668: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6669:       }
 6670:    }
 6671: 
 6672: 
 6673:    __global__ void updateElevation(void) {
 6674:       NODE(node);
 6675: 
 6676: 
 6677:       node->eta2 = node->mX;
 6678: 
 6679:       node->updateZCoordData();
 6680:    }
