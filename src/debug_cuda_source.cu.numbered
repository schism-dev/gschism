 2735: 
 2736: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2737: //          // Similarly, we use tt2 to compute the intersection point.
 2738: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2739: //             xIntersect = x3 + (x4 - x3)*tt2;
