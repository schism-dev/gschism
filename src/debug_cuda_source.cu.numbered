 3668:    __global__ void computeElevationBoundaryConditions(double time) {
 3669:       // Compute elevation essential boundary conditions 
 3670: 
 3671:       NODE_BND(nodeBnd); // Each boundary node.
 3672: 
 3673:       const Node *node = nodeBnd->node;
 3674:       const int iettype = nodeBnd->iettype;
 3675: 
 3676:       double eic = 0.0;
 3677:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3678:       else               eic = 0.0;
 3679: 
 3680:       const double r_eic = (1.0 - ramp)*eic; 
 3681:       const double r_eth = ramp*nodeBnd->eth;
 3682:       double eta1_bar = r_eic;
 3683: 
 3684: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3685:       // Compute tide elevation
 3686:       if (iettype == 3 || iettype == 5) {   
 3687: 
 3688:          if constexpr(iloadtide==1) { // loading tide
 3689:             assert(false && "Loading tide not implemented");
 3690:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3691:          }
 3692:          
 3693:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3694: 
 3695:             const double efa  = nodeBnd->efa[jfr]; 
 3696:             const double emo  = nodeBnd->emo[jfr]; 
 3697: 
 3698:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3699:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3700:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3701: 
 3702:  printf("++++>> jfr = %d, time = %f, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, time, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3703:          } // for jfr
 3704: 
 3705:       } // if iettype
 3706: 
 3707:       switch (iettype) {
 3708:          case 1:
 3709:          case 2:
 3710:             nodeBnd->elbc = r_eth + r_eic;
 3711:             break;
 3712:          case 3:
 3713:             nodeBnd->elbc = eta1_bar + r_eic;
 3714:             break;
 3715:          case 4:
 3716:             nodeBnd->elbc = r_eth + r_eic;
 3717:             break;
 3718:          case 5:
 3719:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3720:             break;
 3721:       } // switch
 3722: 
 3723: 
 3724:       //Add inverse barometric effects
 3725:       if (iettype != 0 && inv_atm_bnd == 1) {
 3726:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3727:       }
 3728: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3729:    }
 3730: 
 3731: 
 3732:    __global__ void setEssentialBC(void) {
 3733:       // Set essential boundary conditions 
 3734:       NODE(node); // Each boundary node
 3735:       NodeBoundary *nodeBnd = node->nodeBnd;
 3736: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3737:       
 3738: // nodeBnd->isEssentialBC = true;      
 3739:       // Check if this node has essential BC
 3740:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3741:          // Verify BC value is valid
 3742:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3743: 
 3744:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3745:          
 3746:          // Set diagonal to 1 and zero off-diagonals
 3747:          node->coeffDiag = 1.0;
 3748:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3749: 
 3750:          for (int j = 0; j < node->numNodes; j++) {
 3751:                node->coeffMatrix[j] = 0.0;
 3752:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3753:          }
 3754:          
 3755:          // Set solution and RHS to BC value
 3756:          node->mX  = nodeBnd->elbc;
 3757:          node->qel = nodeBnd->elbc;
 3758: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3759:       } else {
 3760:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3761: 
 3762:          for (int j = 0; j < node->numNodes; j++) {
 3763:                Node* nbNode = node->nodes[j];
 3764:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3765:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3766:                   // Verify neighbor's BC value
 3767:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3768: 
 3769:                   // Subtract contribution to RHS
 3770:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3771:                   node->coeffMatrix[j] = 0.0;  
 3772:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3773:                }
 3774:          }
 3775:       }
 3776:    }
 3777: 
 3778: 
 3779:    __global__ void updateElevation(void) {
 3780:       NODE(node);
 3781: 
 3782:       node->eta2 = node->mX;
 3783: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 3784:    }
