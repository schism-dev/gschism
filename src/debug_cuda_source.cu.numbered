 2727: 
 2728: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2729: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2730: // Returns the normal vector and the area of the element at this level
 2731:    
 2732:    double nx, ny, nz;
 2733: 
 2734:    if (isTri()) {
 2735:       // For triangles...
 2736: 
 2737:       // Indices of the nodes at level k, taking care of not going below the bed
 2738:       const int k0 = max(k, nodes[0]->kb);
 2739:       const int k1 = max(k, nodes[1]->kb);
 2740:       const int k2 = max(k, nodes[2]->kb);
 2741: 
 2742:       // Gets the element frame coordinates of the nodes at level k
 2743:       Point3 x0, x1, x2;
 2744:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2745:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2746:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2747:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2748: 
 2749:       } else {  // ics == 2
 2750:          Point2 h0, h1, h2;
 2751: 
 2752:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2753: 
 2754:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2755:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2756:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2757:       }
 2758: 
 2759:       const Vector3 n20 = x2 - x0;
 2760:       const Vector3 n10 = x1 - x0; 
 2761: 
 2762:       // Computes the cross product of vectors n20 and n10. 
 2763:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2764:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2765:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2766: 
 2767:   
 2768:    }
 2769:    else {
 2770:       // For quads...
 2771:       Point2 h0, h1, h2, h3;
 2772: 
 2773:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2774: 
 2775:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2776:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2777:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2778:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2779: 
 2780:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2781:       nx = n20.y*n31.z - n20.z*n31.y;
 2782:       ny = n20.z*n31.x - n20.x*n31.z;
 2783:       nz = n20.x*n31.y - n20.y*n31.x;
 2784: 
 2785:    }
 2786: 
 2787:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2788:    area3D = 0.5*len;
 2789: 
 2790:    const double inv_len = 1.0/len;
 2791: 
 2792:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2793: 
 2794: }
 2795: 
 2796: 
 2797: // Helper functions to get the 2D local node position for the Celestial walk
 2798: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2799:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2800:    const Node *node = getNodeInOrder(idx2);
 2801: 
 2802:    double z = 0.0;
 2803:    if constexpr(ics == 2) z = node->gz;
 2804:    
 2805:    Point3 p = toPoint3(node->p, z);
 2806: 
 2807:    return toPoint2(origSide->toLocalFrame(p));
 2808: }
 2809: 
 2810: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2811:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2812: }
 2813: 
 2814: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2815:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2816: // Computes the three per-side predicates needed for the celestial walk
 2817: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2818: //
 2819: // xt is in local frame coordinates for origSide if ics == 2.
 2820: //
 2821: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2822: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2823: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2824: // meaningless on triangles are masked to a safe value (see comments below).
 2825: {
 2826:    // Project all 4 corner positions once into the local 2D frame.
 2827:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2828:    // getLocalNodePosition only transforms/projects if ics == 2.
 2829:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2830:                         getLocalNodePosition(1, origSide), 
 2831:                         getLocalNodePosition(2, origSide), 
 2832:                         getLocalNodePosition(3, origSide)};
 2833: 
 2834:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2835:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2836:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2837:    // But still farther towards the target point from the current point.
 2838:    const Vector2 vt0 = xt - x0;
 2839:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2840:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2841:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2842: 
 2843:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2844:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2845: 
 2846: 
 2847: // if (origSide->idx == 2860848 && jlev == 46) {
 2848: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2849: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2850: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2851: // }
 2852:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2853:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2854:    //  here the orientation is baked into the corners array.)
 2855:    const int i3 = nxq(3);
 2856:    const Vector2 s0 = C[ 1] - C[ 0];
 2857:    const Vector2 s1 = C[ 2] - C[ 1];
 2858:    const Vector2 s2 = C[i3] - C[ 2];
 2859:    const Vector2 s3 = C[ 0] - C[i3];
 2860:    
 2861:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2862:    // The corners array is built from getNode in CCW order, so the orientation
 2863:    // is already correct and no ssign factor is needed in the formulas below.
 2864:    //
 2865:    // i3 = nxq(3): the index of the corner after side 2.
 2866:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2867:    //   Quad:     i3 == 3.
 2868:    //
 2869:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2870:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2871:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2872:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2873:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2874:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2875: 
 2876: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2877: 
 2878:    // For triangles, the corner after side 2 is the closing corner where
 2879:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2880:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2881:    // s0 for triangles, s3 for quads.
 2882:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2883: 
 2884:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2885:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2886:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2887:    //
 2888:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2889:    // result is false naturally. No sentinel needed.
 2890:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2891:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2892:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2893:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2894: 
 2895:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2896:    // on the "exit through side I" half of the corner cone, separated by the
 2897:    // approximate angular bisector of the celestial walk. The bisector is
 2898:    // perpendicular to the chord across the corner; the test is the sign of
 2899:    // (xt - corner_vertex) projected onto that chord.
 2900:    //
 2901:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2902:    // (the validity rule sets valid_3 = false), so its computed value for
 2903:    // triangles doesn't matter. No sentinel needed.
 2904:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2905:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2906:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2907:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2908: 
 2909: }
 2910: 
 2911: 
 2912: __inline__ __device__ double Element::computeSignedArea(void) const {
 2913:    // Compute the area of the element
 2914: 
 2915:    Point2 x0, x1, x2, x3;
 2916:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2917: 
 2918: 
 2919:    double res = signedArea(x0, x1, x2);
 2920: 
 2921:    // In the quad case we need to add the area of the other triangle.
 2922:    if (isQuad()) {
 2923:       x3 = getLocalHorizontalNodePosition(3);
 2924:       double ar1 = signedArea(x0, x2, x3);
 2925:       double ar2 = signedArea(x0, x1, x3);
 2926:       double ar3 = signedArea(x1, x2, x3);
 2927:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2928: 
 2929:       res += ar1;
 2930: 
 2931:    }
 2932: 
 2933:    return res;
 2934: }
 2935: 
 2936: 
 2937: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2938:                                                                 (nodes[1]->isDry2()) ||
 2939:                                                                 (nodes[2]->isDry2()) ||
 2940:                                                                 (isQuad() && nodes[3]->isDry2());
 2941: }
 2942: 
 2943: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2944:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2945: }
 2946: 
 2947: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2948:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2949: }
 2950: 
 2951: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2952:    // In boundary sides, the element 1 is nullptr
 2953:    return side->elems[1] == nullptr; 
 2954: }
 2955: 
 2956: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2957:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2958:    // For ics == 2, this function uses local frame coordinates.
 2959: 
 2960:    assert(isQuad());
 2961: 
 2962:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2963:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2964:    // where vxi, veta, vb are vectors and c is the center of the element.
 2965: 
 2966:    Point2 p0, p1, p2, p3;
 2967: 
 2968:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2969: 
 2970:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2971:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2972:    // vectors vxi and veta connect the centers of opposite sides
 2973:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2974:    // vb is zero for parallelogram elements.
 2975:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2976: 
 2977:    //  The bilinear mapping is:
 2978:    //      P(s,t) = C + s*U + t*V + s*t*W
 2979:    //
 2980:    //  where:
 2981:    //    C = centroid (average of four vertices)
 2982:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2983:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2984:    //    W = bilinear correction; measures deviation from parallelogram
 2985:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2986:    //        W = 0 for parallelogram elements.
 2987:    //
 2988:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2989:    //
 2990:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2991:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2992:    //
 2993:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2994:    //
 2995:    //  Geometrically, (L) projects everything onto the direction
 2996:    //  perpendicular to W, where the mapping is purely affine.
 2997:    //
 2998:    //  The dot product with nb retains the nonlinear term:
 2999:    //
 3000:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 3001:    //
 3002:    //  Geometrically, (Q) projects onto the W direction, where
 3003:    //  the nonlinearity lives.
 3004:    //
 3005:    //  We solve (L) for whichever variable has the larger coefficient
 3006:    //  (better conditioned back-substitution), substitute into (Q),
 3007:    //  and get a scalar quadratic in the other variable.
 3008:    // ================================================================
 3009: 
 3010:    // ---- Basis vectors ----
 3011:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3012:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3013:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3014:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3015:    // W: nonlinear correction. Difference between quad and parallelogram.
 3016:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3017:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3018: 
 3019:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3020:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3021:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3022:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3023:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3024: 
 3025:    // ---- nb: direction parallel to W, L1-normalized ----
 3026:    // We don't need a unit vector -- just a well-scaled direction parallel
 3027:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3028:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3029:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3030:    //
 3031:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3032:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3033:    // and the quadratic solver takes its linear path (a ~ 0).
 3034:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 3035:    const double inv_wlen = 1.0 / wlen1;
 3036:    const Vector2 nb = vb * inv_wlen;
 3037: 
 3038:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3039:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3040:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3041:    // What remains is a pure affine relationship between xi and eta.
 3042:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3043:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3044:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3045: 
 3046:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3047:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3048:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3049:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3050:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3051:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3052:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3053: 
 3054:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3055:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3056:    // minimizing round-off amplification.
 3057:    //
 3058:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3059:    // that uses predicated moves.
 3060:    //
 3061:    // if (fabs(Ls) > fabs(Lt)) {
 3062:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3063:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3064:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3065:    //    const double A = -Qw * Lt;
 3066:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3067:    //    const double C =  Qs * Lp - Qp * Ls;
 3068: 
 3069:    //    double eta1, eta2;
 3070:    //    solveQuadratic(A, B, C, eta1, eta2);
 3071: 
 3072:    //    // Pick root with smaller |eta| (domain centered at 0).
 3073:    //    // Ternary-> predicated move, no branch divergence.
 3074:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3075: 
 3076:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3077:    //    xi = (Lp - Lt * eta) / Ls;
 3078: 
 3079:    // } else {
 3080:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3081:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3082:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3083:    //    const double A = -Qw * Ls;
 3084:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3085:    //    const double C =  Qt * Lp - Qp * Lt;
 3086: 
 3087:    //    double xi1, xi2;
 3088:    //    solveQuadratic(A, B, C, xi1, xi2);
 3089: 
 3090:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3091: 
 3092:    //    eta = (Lp - Ls * xi) / Lt;
 3093:    // }
 3094:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3095:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3096:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3097:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3098:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3099: 
 3100:    // Quadratic:  A*r^2 + B*r + C = 0
 3101:    // (same formula for both cases, just with swapped coefficients)
 3102:    const double A = -Qw * Lb;
 3103:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3104:    const double C =  Qa * Lp - Qp * La;
 3105: 
 3106:    double r1, r2;
 3107:    solveQuadratic(A, B, C, r1, r2);
 3108: 
 3109:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3110:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3111: 
 3112:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3113:    const double other = (Lp - Lb * r) / La;
 3114: 
 3115:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3116:    xi  = solve_s ? r     : other;
 3117:    eta = solve_s ? other : r;
 3118: 
 3119: 
 3120:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3121:    xi  = clamp(xi,  -1.0, 1.0);
 3122:    eta = clamp(eta, -1.0, 1.0);
 3123: 
 3124:    // ---- Shape functions ----
 3125:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3126:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3127:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3128:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3129:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3130:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3131:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3132:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3133: 
 3134:    return true;
 3135: }
 3136: 
 3137: /**
 3138:    Compute the shape coordinates of the point (xt,yt) in the element.
 3139:    @param xt (input): x-coordinate of the point
 3140:    @param shpCoords (output): shape coordinates of the point
 3141:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3142:    @return true if the point is inside the element, false otherwise
 3143: **/
 3144: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3145: 
 3146:    // Compute the shape coordinates of the point xt in the element.
 3147:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3148:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3149:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3150:    // from the local frame, so use additional check.
 3151: 
 3152: 
 3153:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3154: 
 3155:    if (isTri()) { // Triangular element
 3156: 
 3157:       // Horizontal local node coordinates. 
 3158:       Point2 x0, x1, x2;
 3159:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3160: 
 3161:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3162:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3163:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3164:       shpCoords[3] = 0.0;
 3165: 
 3166:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3167:       const bool res = (tmpmin >= -small);  
 3168:       
 3169:       // When to fix the negative shape coordinates?
 3170:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3171: 
 3172:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3173:       // then we fix the negative shape coordinates.
 3174:       if ((tmpmin < 0) && fix) {
 3175: 
 3176:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3177:          // keeping the sum of the shape coordinates equal to 1.
 3178:          // I have tested and compared the new algorithm with the old one, and they give
 3179:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3180:          // The new algorithm should be faster since it is branchless.
 3181:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3182:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3183: 
 3184:          shpCoords[0] = (shpCoords[0] + a)*b;
 3185:          shpCoords[1] = (shpCoords[1] + a)*b;
 3186:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3187: 
 3188:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3189:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3190:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3191: 
 3192:          // Update the point coordinates for the new shape coordinates
 3193:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3194:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3195: 
 3196:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3197: 
 3198:       }
 3199: 
 3200:       // Return true if the point is inside the element
 3201:       return res;      
 3202:    }
 3203:    else {
 3204:       assert(isQuad() && "computeShapeCoords");
 3205: 
 3206:       // Horizontal local node coordinates with respect to the original side.
 3207:       Point2 x0, x1, x2, x3;
 3208:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3209: 
 3210:       const double a0 = signedArea(x0, x1, xt);
 3211:       const double a1 = signedArea(x1, x2, xt);
 3212:       const double a2 = signedArea(x2, x3, xt);
 3213:       const double a3 = signedArea(x3, x0, xt);
 3214: 
 3215:       const double minArea = min4(a0, a1, a2, a3);
 3216:       
 3217:       const bool res = (minArea > -small*area);
 3218: 
 3219:       // When to fix the negative shape coordinates?
 3220:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3221: 
 3222:       double xi, eta;    
 3223: 
 3224:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3225:       // Does nothing if ics == 1.
 3226:       assert(origSide != nullptr);
 3227:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3228: 
 3229:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3230: 
 3231:       if (fix) {
 3232:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3233:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3234:          xt.x = interpolate(shpCoords, xn);
 3235:          xt.y = interpolate(shpCoords, yn);
 3236:       }
 3237: 
 3238:       return res;
 3239:    }
 3240: 
 3241: 
 3242:    assert(false && "computeShapeCoords: should never reach this point");
 3243:    return false;  // Never reached
 3244: 
 3245: }
 3246: 
 3247: 
 3248: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3249: // Convert shape coordinates to cartesian coordinates
 3250: 
 3251:    if (isTri()) {
 3252:       // Triangular element
 3253: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3254:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3255:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3256:    }
 3257:    else {
 3258:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3259:    }
 3260: 
 3261: }
 3262: 
 3263: 
 3264: 
 3265: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3266:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3267:    
 3268:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3269: }
 3270: 
 3271: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3272:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3273:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3274:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3275:    return area * dot(gradPhi[i], gradPhi[j]);
 3276: }
 3277: 
 3278: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3279:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3280:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3281:    // The formula for the integral is:
 3282:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3283:    
 3284:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3285:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3286:    const double eta_sum  = eta_n(i) + eta_n(j);
 3287:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3288: 
 3289:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3290:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3291: 
 3292: 
 3293:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3294: }
 3295:    
 3296: 
 3297: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3298:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3299:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3300:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3301:    // The formula is also based on the identity:
 3302:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3303:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3304: 
 3305:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3306: 
 3307: 
 3308: 
 3309:    double res = 0.0;
 3310:    
 3311:    // Quadrature points in xi and eta coordinates
 3312:    #pragma unroll
 3313:    for (int i = 0; i < 4; i++) {
 3314:       // For each quadrature point...
 3315: 
 3316:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3317:       const double eta = p.x;
 3318:       const double xi  = p.y;
 3319: 
 3320:       // Jacobian entries at the Gauss point p
 3321:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3322:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3323:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3324:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3325: 
 3326:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3327:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3328: 
 3329:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3330:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3331:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3332:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3333:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3334: 
 3335:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3336:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3337:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3338:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3339:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3340: 
 3341:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3342:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3343:    }
 3344: 
 3345:    return res;
 3346: }
 3347: 
 3348: 
 3349: /**  Interpolate velocities at a given point (xt,yt,zt)
 3350: 
 3351:    @param xt, yt, zt: coordinates of the point to interpolate
 3352:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3353: 
 3354:    This is done in four steps:
 3355: 
 3356:    1. Find the shape coordinates for the final position in the element.
 3357:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3358:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3359:       z levels at xt, yt at each step.   
 3360:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3361:       horizontally and vertically.
 3362: **/
 3363: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3364:    // Interpolate the velocities at the point xt. 
 3365:    // This function works the same for triangular and quadrilateral elements.
 3366:    double shpCoord[4];
 3367:    Vector3 u_int;
 3368: 
 3369: 
 3370:    // First step is to compute the shape coordinates of (xt,yt)
 3371: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3372:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3373: 
 3374:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3375: 
 3376:    // Second step is to find the level that contains zt
 3377:    // Uses a binary search to find the level
 3378:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3379:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3380:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3381:    int R = nvrt - 1;
 3382: 
 3383:    // Get the z coordinates at the nodes of the element at the levels L and R
 3384:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3385:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3386:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3387: 
 3388: 
 3389:    double zL = interpolate(shpCoord, zLAtNodes);
 3390:    double zR = interpolate(shpCoord, zRAtNodes);
 3391: 
 3392:    // Interpolates vertically the velocities
 3393:    double wght1, wght2;
 3394:    if (xt.z <= zL) {
 3395:       wght1 = 1.0;
 3396:       wght2 = 0.0;
 3397:       xt.z = zL;
 3398:    }
 3399:    else if (xt.z >= zR) {
 3400:       wght1 = 0.0;
 3401:       wght2 = 1.0;
 3402:       xt.z = zR;
 3403:    }
 3404:    else {
 3405:       // Perform a binary search to find the levels between L and R that contain xt.z
 3406:       while (R - L > 1) {
 3407:          int M = (L + R) / 2.0;
 3408: 
 3409:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3410:          double zM = interpolate(shpCoord, zMAtNodes);
 3411:          if (zM < xt.z) 
 3412:          {
 3413:             L = M;
 3414:             zL = zM;
 3415:          }
 3416:          else 
 3417:          {
 3418:             R = M;
 3419:             zR = zM;
 3420:          }
 3421:       }
 3422:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3423:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3424: 
 3425:       wght2 = (xt.z - zL)/(zR - zL);
 3426:       wght1 = 1.0 - wght2;
 3427: 
 3428:    }
 3429: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3430: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3431:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3432:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3433:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3434:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3435: 
 3436:    // Project the velocity from the local frame to the origSide frame
 3437:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3438:    u_int = {uv.x, uv.y, w};
 3439: 
 3440:    // Neither of the interpolated velocities should be NaN
 3441:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3442: 
 3443:    return u_int;
 3444: 
 3445: }
 3446: 
 3447: 
 3448: 
 3449: 
 3450: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3451: 
 3452:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3453:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3454:    const Node *n1 = side->n1;
 3455:    const Node *n2 = side->n2;
 3456: 
 3457:    bool n1_match = (n1->nodeBnd->segment == segment);
 3458:    bool n2_match = (n2->nodeBnd->segment == segment);
 3459: 
 3460:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3461:    if (n1_match && n2_match) {
 3462:       return 0.5;
 3463:    } else if (n1_match) {
 3464:       return 1.0;
 3465:    } else if (n2_match) {
 3466:       return 0.0;
 3467:    }
 3468: 
 3469:    return 0.0;
 3470: }
 3471: 
 3472: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3473: 
 3474: 
 3475: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3476: 
 3477:    const double w1 = getBoundaryArrayValueWeight();
 3478:    const double w2 = 1.0 - w1;
 3479:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3480:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3481: 
 3482:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3483: }
 3484: 
 3485: 
 3486: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3487:    const double w1 = getBoundaryArrayValueWeight();
 3488:    const double w2 = 1.0 - w1;
 3489:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3490:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3491: 
 3492:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3493: 
 3494: }
 3495: 
 3496: 
 3497: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3498:    // Returns the value of the velocity at the side center
 3499:    const double w1 = getBoundaryArrayValueWeight();
 3500:    const double w2 = 1.0 - w1;
 3501:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3502:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3503: 
 3504:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3505: }
 3506: 
 3507: 
 3508: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3509:    // Returns the value of the normal component of the velocity at the side center
 3510:    const double w1 = getBoundaryArrayValueWeight();
 3511:    const double w2 = 1.0 - w1;
 3512:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3513:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3514: 
 3515:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3516: }
 3517: 
 3518: 
 3519: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3520:    if constexpr(ics == 1) {
 3521:       return center;
 3522: 
 3523:    } else {
 3524:       const Point2 p0 = n1->outputCoords();
 3525:       const Point2 p1 = n2->outputCoords();
 3526:       return (1.0/2.0)*(p0 + p1);
 3527: 
 3528:    }
 3529: }
 3530: 
 3531: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3532: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3533: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3534: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3535: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3536: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3537: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3538: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3539: // Computes the gradient of the field at the side center.
 3540:    Vector2 grad = {0.0, 0.0};
 3541:    int count = 0;
 3542: 
 3543:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3544:    // as the average of the gradients at each element.
 3545:    // First element
 3546:    if (elems[0] != nullptr && condition(elems[0])) {
 3547:       Vector2 elemGrad = elems[0]->grad2(field);
 3548: 
 3549:       // For ics=2, projects the element gradient from its frame to the side frame
 3550:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3551: 
 3552:       grad += elemGrad;
 3553: 
 3554:       count++;
 3555:    }
 3556: 
 3557:    // Second element
 3558:    if (elems[1] != nullptr && condition(elems[1])) {
 3559: 
 3560:       Vector2 elemGrad = elems[1]->grad2(field);
 3561: 
 3562:       // For ics=2, projects the element gradient from its frame to the side frame
 3563:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3564: 
 3565:       grad += elemGrad;
 3566: 
 3567:       count++;
 3568:    }
 3569: 
 3570:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3571:    if (count > 0) {
 3572:       grad = grad*(1.0/count);
 3573:    }
 3574:    
 3575:    return grad;
 3576: }
 3577: 
 3578: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3579: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3580: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3581: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3582: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3583: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3584: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3585: 
 3586: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3587: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3588: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3589: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3590: 
 3591: 
 3592: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3593: 
 3594: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3595:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3596:    if constexpr(ics == 1) { 
 3597:       return 0.5*(n1->tau + n2->tau);
 3598: 
 3599:    } else {
 3600:       // Project the tau from the node frames to the side frame
 3601:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3602:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3603: 
 3604:       return 0.5*(stau1 + stau2);
 3605:    }
 3606: }
 3607: 
 3608: /**
 3609:  * This method performs backtracking from the side center until a time -dt back in time 
 3610:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3611:  * intermediate point.
 3612:  *
 3613:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3614:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3615:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3616:  * remaining time.
 3617:  * 
 3618:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3619:  * 
 3620:  * @param uuint, vvint, wwint: Velocities at the final point
 3621:  * @param jlev: Level at which the backtracking is performed
 3622:  * @param dt, dtbk: Tracking timesteps
 3623:   */
 3624: __inline__ __device__ void Side::btrack(
 3625:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3626:       double dt,            // Tracking time
 3627:       double dtbk,          // Tracking timestep
 3628:       Vector3 &u_int        // Velocities at the initial point
 3629: ) const {
 3630: 
 3631:    // Start from side center
 3632:    Point3 x0;
 3633: 
 3634:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3635:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3636: 
 3637:  
 3638:    double time_rm = dt; // Remaining time
 3639:    double time_rm_1 = 1e10;
 3640:    double time_rm_2 = 2e10;
 3641:    double time_rm_3 = 3e10;
 3642: 
 3643: 
 3644:    // Initial velocities
 3645:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3646: 
 3647:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3648:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3649: 
 3650:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3651: 
 3652: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3653: 
 3654: 
 3655:    constexpr int MAX_ITERATIONS = 100; 
 3656:    int iter = 0;
 3657:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3658:    while(true) {
 3659: 
 3660:       // Calculate timestep
 3661:       const double dtb = min(dtbk, time_rm);
 3662: 
 3663:       // Next point in the backtracking curve
 3664:       xt = x0 - dtb*u_int;
 3665: 
 3666:       double t, s; // parameters for the line segments p0pt and p1p2
 3667:       Side *lastCrossSide = nullptr;
 3668:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3669: 
 3670: 
 3671:       if (time_rm_3 <= time_rm) {
 3672:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3673:          xt = x0;
 3674:          break;
 3675:       }
 3676: 
 3677: 
 3678:       if (!found) {
 3679:       // This means that the walk reached a boundary or a dry element.
 3680: 
 3681:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3682: 
 3683:          // Finds the point at the boundary where the line segment x0xt intersects.
 3684:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3685:          // due to floating point errors, it does not exactly intersect.
 3686:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3687:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3688:          // To compute the intersection point we start with the parametric equations.
 3689:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3690:          // We cross-prouct by v1 to cancel the s term:
 3691:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3692:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3693: 
 3694:          // Side coordinates in the origSide frame.
 3695:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3696:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3697: 
 3698:          Point2  p0 = {x0.x, x0.y};
 3699:          Point2  pt = {xt.x, xt.y};
 3700: 
 3701:          const Vector2 v1 = pt - p0;
 3702:          const Vector2 v2 = p2 - p1;
 3703: 
 3704: 
 3705: 
 3706:          // We are assuming intersection, so we clamp t to the range [0,1].
 3707:          const double denom = cross(v2, v1);
 3708:          
 3709: 
 3710: 
 3711: 
 3712:          if (abs(denom) < small) {
 3713:             // small denominators are fairly common. They occur when the line segment x0xt 
 3714:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3715:             // boundary, where the backtracking curve startt sliding along the boundary.
 3716:             // In this case, we simply assume that the two lines are very close to each other
 3717:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3718:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3719:             if (t<0.0000000001) t = 0.0;
 3720:             if (t>0.9999999999) t = 1.0;
 3721: 
 3722:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3723:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3724: 
 3725:          }
 3726:          else {
 3727:             
 3728:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3729:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3730:             if (t>0.9999999999) t = 1.0;
 3731:             // From the originaL equation we can solve for s:
 3732:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3733:             // Computing the dot product by v1, we get:
 3734:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3735:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3736:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3737: 
 3738:          }
 3739: 
 3740:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3741: 
 3742: 
 3743:          // We update the new target point to be right at the intersection point,
 3744:          // and the remaining time must include the time we haven't "used".
 3745:          time_rm -= s*dtb;
 3746:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3747: 
 3748: 
 3749:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3750:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3751: 
 3752:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3753:          // but extracting only the component along the tangent vector v2.
 3754:          Vector2 tangent = normalize(v2);
 3755:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3756: 
 3757:          const Vector2 u2D = make_double2(u.x, u.y);
 3758:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3759: 
 3760: 
 3761:       } else {
 3762: 
 3763:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3764: 
 3765:          time_rm -= dtb; 
 3766: 
 3767:          u_int = curElem->interpolateVelocities(xt, this);
 3768: 
 3769:       }
 3770: 
 3771:       if (time_rm <= 0.0) break; 
 3772: 
 3773:       // If the velocity is too small, we stop the backtracking
 3774:       const double vmag2 = norm2(toVector2(u_int));
 3775:       if (vmag2 <= velmin_btrack_sq)  {
 3776:          time_rm = 0.0; 
 3777:          return; 
 3778:       }
 3779: 
 3780:       // The current point becomes the next segment's starting point.
 3781:       x0 = xt;
 3782:  
 3783:       iter++;
 3784: 
 3785: // XXXXXXXXXXXXXXXXX
 3786: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3787:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3788: 
 3789:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3790:       time_rm_3 = time_rm_2;
 3791:       time_rm_2 = time_rm_1;
 3792:       time_rm_1 = time_rm;
 3793:    }
 3794: 
 3795:    assert(curElem != nullptr && "Final element is nullptr");
 3796:    assert(!curElem->isDry && "Final element is dry");
 3797:    
 3798: 
 3799: 
 3800:    // Interpolate the velocities at the final point with respect to the current side frame
 3801:    u_int = curElem->interpolateVelocities(xt, this);
 3802: 
 3803: 
 3804: }
 3805: 
 3806: 
 3807: 
 3808: __device__ __forceinline__ int Node::localIndex() const {
 3809:    // Returns the local index of the node in the partition
 3810:    // Local index is just the offset from the start of the partition's node memory
 3811:    return int(this - mesh->nodes[part]);
 3812: }
 3813: 
 3814: 
 3815: __device__ __forceinline__ int Node::packedIndex() const {
 3816:    // Returns the packed index of the node
 3817:    // Packed index is the index of the partition-block matrices and vectors.
 3818:    return nodeOffsetPerPartition[part] + localIndex();
 3819: }
 3820: 
 3821: 
 3822: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3823: 
 3824: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3825: 
 3826:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3827:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3828: 
 3829:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3830:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3831: 
 3832:    double fun_lat = 0.0;
 3833:    switch (jspc[idxComp]) {
 3834:       case 0:
 3835:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3836:          break;
 3837:       case 1:
 3838:          fun_lat = sin(2.0*lat);
 3839:          break;
 3840:       case 2:
 3841:          fun_lat = pow<2>(cos(lat));
 3842:          break;
 3843:       default:
 3844:          assert(false && "computeETP: invalid jspc");
 3845:    }
 3846:    
 3847:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3848: 
 3849: }
 3850: 
 3851: __device__ void Node::updateKb(void) {
 3852: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3853: 
 3854:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3855: 
 3856: 
 3857:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3858: 
 3859:    if constexpr(ivcor == 2) {  // SZ coordinates
 3860:       
 3861:       // Compute bottom level index
 3862:       if (depth <= mesh->h_s) {
 3863:          kb = izlev;   
 3864:          
 3865:       } else {
 3866:          kb = -1;
 3867:          int L = 0;
 3868:          int R = nzlev; 
 3869:          
 3870:          while (L <= R) {
 3871:             int M = (R + L) / 2;
 3872: 
 3873: 
 3874:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3875:             
 3876:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3877:                R = M;
 3878:             } else {
 3879:                L = M;
 3880:             }
 3881: 
 3882:             if (R - L == 1) {
 3883:                kb = L;
 3884:                break;
 3885:             }
 3886:          }
 3887: 
 3888:          // Checks that the binary search was successful
 3889:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3890:        
 3891:       }
 3892:    } 
 3893: }
 3894: 
