 5350: 
 5351:       if constexpr(nws != 0 && iwindoff != 0) {
 5352:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5353:       }
 5354: 
 5355:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5356:       node->setWind(wind);
 5357: 
 5358:       node->pr = pressAir[idx];
 5359:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5360: 
 5361:    }
