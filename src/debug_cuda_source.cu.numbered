 8432: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8433:    Element *elems = mesh->localElemData;
 8434: 
 8435:    *addr = elems;
 8436:    *sizeElement = sizeof(Element);
 8437:    switch (varCode) {
 8438:       case (int)VarCode::z:
 8439:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8440:          *sizeType = sizeof(double);
 8441:          break;
 8442:       case (int)VarCode::x:
 8443:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8444:          *sizeType = sizeof(Vector2);
 8445:          break;
 8446:       case (int)VarCode::gradETP:
 8447:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8448:          *sizeType = sizeof(Vector2);
 8449:          break;
 8450:       case (int)VarCode::area:
 8451:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8452:          *sizeType = sizeof(double);
 8453:          break;
 8454:       case (int)VarCode::depth:
 8455:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8456:          *sizeType = sizeof(double);
 8457:          break;
 8458:       case (int)VarCode::radius:
 8459:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8460:          *sizeType = sizeof(double);
 8461:          break;
 8462:       case (int)VarCode::ghat:
 8463:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8464:          *sizeType = sizeof(Vector2);
 8465:          break;
 8466:       case (int)VarCode::kb:
 8467:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8468:          *sizeType = sizeof(int);
 8469:          break;
 8470:       case (int)VarCode::isdry:
 8471:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8472:          *sizeType = sizeof(int);
 8473:          break;            
 8474:       case (int)VarCode::w:
 8475:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8476:          *sizeType = sizeof(double);
 8477:          break;
 8478:       case (int)VarCode::FaceIndices:
 8479:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8480:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8481:          *sizeType = sizeof(Node);
 8482:          break;
 8483:       default:
 8484:          *offset = -1;
 8485:    }
 8486: }
