 2297:    template<typename T>
 2298:    __device__ __forceinline__ T Element::mean(int level, T (Node::* field)[nvrt]) const {
 2299:       T values[4];
 2300:       getNodalValues(level, field, values);
 2301: 
 2302:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2303:       if constexpr (IsVector2<T>::value && ics == 2) {
 2304: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2305:          projectNodeVectorsToElementFrame(values);
 2306: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2307:       }
 2308: 
 2309:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2310:    }
