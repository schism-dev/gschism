  189: // eta coordinates of the nodes (idxNode = 0,1,2,3)
  190: __device__ __forceinline__ double eta_n(int idxNode) {
  191:    // bit1: 0 -> -1, 1 -> +1
  192:    assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  193:    return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  194: }
  195: 
  196: // xi coordinates of the nodes (idxNode = 0,1,2,3)
  197: __device__ __forceinline__ double xi_n(int idxNode) {
  198:    // +1 if (bit0 XOR bit1), else -1
  199:    assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  200:    return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  201: 
  202: }
