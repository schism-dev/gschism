  256: __device__ __forceinline__ double length(const double2& v) {
  257:     return sqrt(v.x*v.x + v.y*v.y);
  258: }
  259: 
  260: __device__ __forceinline__ double2 normalize(const double2& v) {
  261:     return v / length(v);
  262: }
