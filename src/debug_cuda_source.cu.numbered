 8614:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8615:          *sizeType = sizeof(double);
 8616:          break;
 8617:       case (int)VarCode::x:
 8618:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8619:          *sizeType = sizeof(Vector2);
 8620:          break;
 8621:       case (int)VarCode::z:
 8622:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8623:          *sizeType = sizeof(double);
 8624:          break;
 8625:       case (int)VarCode::kb:
 8626:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8627:          *sizeType = sizeof(int);
 8628:          break;
 8629:       case (int)VarCode::isdry:
 8630:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8631:          *sizeType = sizeof(int);
 8632:          break;         
 8633:       case (int)VarCode::w:
 8634:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8635:          *sizeType = sizeof(double);
 8636:          break;
 8637:       case (int)VarCode::u:
 8638:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8639:          *sizeType = sizeof(Vector2);
 8640:          break;  
 8641:       case (int)VarCode::u_air:
 8642:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8643:          *sizeType = sizeof(Vector2);
 8644:          break;
 8645:       default:
 8646:          *offset = -1;    
 8647:    }  
 8648:    
 8649: }
