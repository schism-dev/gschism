 8588: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8589:    // Get the value of a variable from an side
 8590:    // varName is the name of the variable to get
 8591:    // var is the array to store the value
 8592:    // k is the vertical level index of the variable to get
 8593:    SIDE_BND(sideBnd);   
 8594: 
 8595:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8596:    if (sideBnd->segment->isLand) idx = -7;
 8597: 
 8598:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8599:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8600: 
 8601: }
