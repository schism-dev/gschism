 4041: 
 4042:    __global__ void computeFlowBcVelocities(double time) {
 4043: 
 4044:       SIDE_BND(sideBnd);
 4045: 
 4046:       const Side *side = sideBnd->side;
 4047:  
 4048:       const bool isDry = side->isDry;
 4049: 
 4050:       if (isDry) {
 4051:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4052:          return;
 4053:       }
 4054: 
 4055:       // For wet sides in open boundaries...
 4056:       const Vector2 n = side->n;
 4057:       const BoundarySegment *segment = sideBnd->segment;
 4058: 
 4059:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4060: 
 4061:       const int ifltype = segment->ifltype;
 4062:       const int iettype = segment->iettype;
 4063: 
 4064:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4065:       const Vector2 r_nuth0 = r_uth0*n;
 4066: 
 4067:       Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4068:       Vector2 r_u1_bar = {0.0, 0.0};
 4069: printf("ZZZ4  idx = %d, ifltype = %d, r_nuth0 = %f, %f\n", sideBnd->side->idx, ifltype, r_nuth0.x, r_nuth0.y);
 4070:       for (int k = 0; k < nvrt; k++) {
 4071:          if (ifltype == 1 || ifltype == 2) {
 4072:          
 4073:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4074: 
 4075:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4076:             
 4077:             r_uth = unth0*n;  // This case has no ramp-up
 4078:             
 4079:          } else if (ifltype == -1) { // Flather 1
 4080: 
 4081:             // uth is the normal vel.; no ramp up
 4082:             const double uth = sideBnd->nuth(k);
 4083:             r_uth = uth*n;
 4084:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4085: 
 4086: 
 4087:          } else if (ifltype == 3 || ifltype == 5) {
 4088:             // vnth0=0 !normal vel.
 4089: 
 4090: printf("ZZZ3  idx = %d, jfr = %d, ifltype = %d, r_uth = %f, %f\n", sideBnd->side->idx, nbfr, ifltype, r_uth.x, r_uth.y);
 4091:             // Computes the contribution to the velocity from all tide frequencies
 4092:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4093: 
 4094:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4095:                const Vector2 umo  = sideBnd->umo(jfr); 
 4096: 
 4097:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4098:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4099:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4100:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4101: printf("ZZZ2  idx = %d, jfr = %d, argx = %f, argy = %f, umo = %f, %f, ufa = %f, %f, ramp = %f, ff = %f\n", sideBnd->side->idx, jfr, argx, argy, umo.x, umo.y, ufa.x, ufa.y, ramp, ff[jfr]);               
 4102:             }
 4103: 
 4104:          } // if (ifltype = 3 || ifltype == 5
 4105: 
 4106: 
 4107:          switch (iettype) {
 4108:             case 1:
 4109:             case 2:
 4110:             case 4:
 4111:                sideBnd->ubc[k] = r_uth;
 4112:                break;
 4113:             case 3:
 4114:                sideBnd->ubc[k] = r_u1_bar;
 4115:                break;
 4116:             case 5:
 4117:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4118:                break;
 4119:          } // switch
 4120: 
 4121: printf("ZZZ  idx = %d, iettype = %d, r_u1_bar = %f, %f, sideBnd->ubc[%d] = %f, %f\n", sideBnd->side->idx, iettype, r_u1_bar.x, r_u1_bar.y, k, sideBnd->ubc[k].x, sideBnd->ubc[k].y);
 4122:       } // for k
 4123:    }
 4124: 
 4125:    __global__ void computeElevationBoundaryConditions(double time) {
 4126:       // Compute elevation essential boundary conditions 
 4127: 
 4128:       NODE_BND(nodeBnd); // Each boundary node.
 4129: 
 4130:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4131: 
 4132:       const Node *node = nodeBnd->node;
 4133:       const BoundarySegment *segment = nodeBnd->segment;
 4134:       const int iettype = segment->iettype;
 4135:       
 4136: 
 4137:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4138:       double eic = 0.0;
 4139:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4140:       else                 eic = 0.0;
 4141: 
 4142:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4143:       const double r_eth = ramp*nodeBnd->eth;
 4144:       double r_eta1_bar = 0.0;
 4145: 
 4146: 
 4147:       // Compute tide elevation
 4148:       if (iettype == 3 || iettype == 5) {   
 4149: 
 4150:          if constexpr(iloadtide==1) { // loading tide
 4151:             assert(false && "Loading tide not implemented");
 4152:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4153:          }
 4154:          
 4155:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4156: 
 4157:             const double efa  = nodeBnd->efa[jfr]; 
 4158:             const double emo  = nodeBnd->emo[jfr]; 
 4159: 
 4160:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4161:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4162:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4163: 
 4164:          } // for jfr
 4165: 
 4166:       } // if iettype
 4167: 
 4168:       switch (iettype) {
 4169:          case 1:
 4170:          case 2:
 4171:          case 4:
 4172:             nodeBnd->elbc = r_eic + r_eth;
 4173:             break;
 4174:          case 3:
 4175:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4176:             break;
 4177:          case 5:
 4178:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4179:             break;
 4180:       } // switch
 4181: 
 4182: 
 4183:       //Add inverse barometric effects
 4184:       if (iettype != 0 && inv_atm_bnd == 1) {
 4185:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4186:       }
 4187: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 4188:    }
 4189: 
 4190: 
 4191:    __global__ void setEssentialBC(void) {
 4192:       // Set essential boundary conditions 
 4193:       NODE(node); // Each boundary node
 4194:       NodeBoundary *nodeBnd = node->nodeBnd;
 4195: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 4196:       
 4197: // nodeBnd->isEssentialBC = true;      
 4198:       // Check if this node has essential BC
 4199:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4200:          // Verify BC value is valid
 4201:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4202: 
 4203:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 4204:          
 4205:          // Set diagonal to 1 and zero off-diagonals
 4206:          node->coeffDiag = 1.0;
 4207:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 4208: 
 4209:          for (int j = 0; j < node->numNodes; j++) {
 4210:                node->coeffMatrix[j] = 0.0;
 4211:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4212:          }
 4213:          
 4214:          // Set solution and RHS to BC value
 4215:          node->mX  = nodeBnd->elbc;
 4216:          node->qel = nodeBnd->elbc;
 4217: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 4218:       } else {
 4219:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4220: 
 4221:          for (int j = 0; j < node->numNodes; j++) {
 4222:                Node* nbNode = node->nodes[j];
 4223:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4224:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4225:                   // Verify neighbor's BC value
 4226:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4227: 
 4228:                   // Subtract contribution to RHS
 4229:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4230:                   node->coeffMatrix[j] = 0.0;  
 4231:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4232:                }
 4233:          }
 4234:       }
 4235:    }
 4236: 
 4237: 
 4238:    __global__ void updateElevation(void) {
 4239:       NODE(node);
 4240: 
 4241:       node->eta2 = node->mX;
 4242: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 4243:    }
