 3787:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3788: 
 3789:       SIDE(side);
 3790: 
 3791: 
 3792:       side->U = {0.0, 0.0}; 
 3793:          
 3794:       if(side->isDry) return;
 3795: 
 3796:       const Node *node1 = side->n1;
 3797:       const Node *node2 = side->n2;
 3798: 
 3799:       // Vertically integrated velocity U (in ll if ics=2)
 3800:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3801:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3802:       }
 3803: 
 3804:    }
 3805: 
 3806:    __global__ void computeBottomDragVegetation(void) {
 3807:       // UNFINISHED. CHECK THIS:
 3808:       // How many kernels are needed? Why so many for loops?
 3809:       // Is the loop on sides needed?
 3810: 
 3811:       NODE(node);
 3812: 
 3813:       const int    kb      = node->kb;
 3814:       const double htot    = node->htot2();
 3815:       const double rough   = node->rough;
 3816: 
 3817: 
 3818:       if (node->isDry) {
 3819:          // Default values for dry nodes
 3820:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3821:          /// XXX CHECK INDICES
 3822:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3823:       }
 3824: 
 3825:       // Compute bottom drag Cd
 3826:       //--------------------------------
 3827: 
 3828:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3829:       if (nchi==1) {
 3830: 
 3831:          bool ltmp = false; // for WBL iteration
 3832: 
 3833:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3834:          // Drag at nodes
 3835:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3836:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3837:         
 3838:          const double rough = node->rough;
 3839:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3840:          if (node->rough == 0.0) {
 3841:             node->Cd = 0.0;
 3842: 
 3843:          } else { //roughness >0 
 3844:             
 3845:             const double bthick_ori = node->znl[kb + 1] - node->znl[kb];  // thickness of bottom bnd layer
 3846:             const double bthick = max(dzb_min, bthick_ori);
 3847: 
 3848:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3849: 
 3850:             double tmp = 1.0/(2.5*log(bthick/rough));
 3851:             node->Cd = tmp*tmp;
 3852: 
 3853:          } // if rough
 3854: 
 3855: 
 3856:          // RECOVER THIS: XXX
 3857:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3858:          // Output warning for WBL if iteration didn't converge
 3859: 
 3860: 
 3861:       } // nchi==1
 3862: 
 3863:       //   Bottom stress in m^2/s^2
 3864:       if (node->rho[kb + 1] >= -98.0)
 3865:       {
 3866:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3867:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3868:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3869:          // !sediment erosion: this part needs more documentation
 3870:       }
 3871: 
 3872:     
 3873:       // Compute vegetation parameters
 3874:       //--------------------------------
 3875: 
 3876:       // SAV constants
 3877:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3878:       constexpr double veg_cfpsi = 0.16;
 3879: 
 3880:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3881:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3882: 
 3883:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3884:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3885:          int kbin = 0; // bin index
 3886:          for (int k = kb; k < nvrt; k++) {
 3887:             // Computes node height above the bottom level
 3888:             const double tmp_h = node->znl[k] - node->znl[kb]; // >=0
 3889:             assert(false && "Vertical variation of vegetation not implemented");
 3890: 
 3891:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3892:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3893:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3894:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3895:             // } else {
 3896:             //    // Find the bin at which the current vertical level is
 3897:             //    while (kbin<nbins_veg_vert) {
 3898:             //       const double zn = node->znl[kbin];
 3899:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3900:             //          break;
 3901:             //       } // if
 3902:             //       kbin++;
 3903:             //    } // while
 3904:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3905: 
 3906:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3907:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3908:                
 3909:             //    // Linear interpolation of the vegetation parameters
 3910:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3911:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3912:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3913:             // } // if rl10
 3914: 
 3915:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3916: 
 3917:          } // for k
 3918: 
 3919: 
 3920:       } else { // Ganthy (iveg=2)
 3921:       //  Modify canopy height, diameter, and density
 3922: 
 3923:          // Make sure there is vegetation on this node
 3924:          if (node->veg_h_unbent > 0.0) {
 3925:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3926: 
 3927:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3928:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3929:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3930: 
 3931:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3932:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3933:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3934:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3935:          } // if veg_h_unbent
 3936: 
 3937:          for (int k = 0; k < nvrt; k++) {
 3938:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3939:          } // for k
 3940:       
 3941: 
 3942:       } // if iveg
 3943:      
 3944:          
 3945: 
 3946:       // Compute vertical mean of veg_alpha3D
 3947:       if (iveg != 0) {
 3948:          const double ztop = node->zTopCanopy(); // Top of the canopy
 3949:          double sum1=0.0;
 3950:          double sum2=0.0;
 3951:          // Integrate over each level under the canopy...
 3952:          for (int k=kb; k<nvrt-1 && node->znl[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 3953:             const double Dz = node->Dz(k);
 3954: 
 3955:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 3956:             sum2 += Dz;
 3957: 
 3958:          } // for k
 3959: 
 3960:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 3961:          else             node->veg_alpha_vert_mean = sum1/sum2;
 3962: 
 3963:       } // if iveg
 3964: 
 3965:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 3966: 
 3967:    }
 3968: 
 3969:    __global__ void computeVegetationAndDragParameters(void) {
 3970:       // Computes the vegetation and drag model parameters:
 3971:       // chi, \tilde\chi, beta, \breve{H}
 3972:       
 3973:       SIDE(side);
 3974: 
 3975:       const double htot = side->htot2();
 3976:       const int    kb   = side->kb;
 3977: 
 3978:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 3979: 
 3980:       const double veg_h     = side->veg_h();
 3981:       const double veg_nv    = side->veg_nv();
 3982:       const double veg_c     = side->veg_c();
 3983:       const double veg_beta  = side->veg_beta;
 3984:       const double veg_alpha = side->veg_alpha_vert_mean();
 3985: 
 3986:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 3987:       // Velocity magnitude at the bottom level
 3988:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 3989:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 3990:       side->chi2 = side->Cd()*vmag1;
 3991:       side->chi  = side->chi2;
 3992:       if constexpr(iveg != 0) {
 3993:          const Node *n1 = side->n1;
 3994:          const Node *n2 = side->n2;
 3995:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 3996:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 3997:       }
 3998: 
 3999:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4000: 
 4001:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4002:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4003:       double magUa = 0.0;
 4004:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4005:          // 3D wet side with veg...
 4006: 
 4007:          double magUa = 0.0;
 4008:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4009:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4010: 
 4011:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4012:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4013:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4014: 
 4015:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4016:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4017: 
 4018:                // Velocity magnitude at the bottom (l) of the level
 4019:                const double ul = length(side->u2[k]);
 4020: 
 4021:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4022:                magUa += Dz*0.5*(uh + ul);
 4023: 
 4024:             } // if HasVegetation
 4025:          } // for k
 4026:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4027: 
 4028:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4029:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4030:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4031:             const double zCpy = side->zTopCanopy();
 4032:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4033:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4034:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4035:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4036:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4037:          } // if isSubmerged
 4038:       } // if iveg   
 4039: 
 4040:       // Computes the friction modified depth, \breve{H} in notes
 4041:       if (side->is2D()) { // 2D
 4042: 
 4043:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4044:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4045: 
 4046:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4047: 
 4048:          side->hhat = htot*htot/fricH; 
 4049: 
 4050:       } else { // 3D
 4051:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4052: 
 4053:          if constexpr(iveg != 0) {
 4054:             
 4055:             if (side->isSubmerged()) { 
 4056:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4057:                side->hhat -= veg_c*Hhat_alpha;
 4058: 
 4059:             } else { // Emergent
 4060:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4061:             }
 4062:          } // if iveg
 4063: 
 4064:          // Enforce positivity for 3D model
 4065:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4066:       } // if 3D
 4067: 
 4068:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4069: 
 4070:         
 4071:    }
 4072: 
 4073: 
 4074: 
 4075:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4076:    // Computes the density gradient between two elements, e1 and e2.
 4077:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4078:    // zero in the direction normal to the side. 
 4079:    // 
 4080:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4081:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4082:    //
 4083:    // Input:
 4084:    //    e1: Element
 4085:    //    e2: Neighbor element (or nullptr if boundary)
 4086:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4087:    //    k: Index of the half-level at which the density is interpolated
 4088:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4089:    // 
 4090:    // Output:
 4091:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4092:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4093: 
 4094:       if (e2 == nullptr || e2->isDry) {
 4095:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4096: 
 4097:          Side *side = e1->sides[j];
 4098:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4099:                  
 4100:          if constexpr(ics == 1) {
 4101:             vec = side->n; // Normal vector to the side
 4102:          } else {
 4103:             // IMPLEMENT THIS XXXXXX
 4104:             // !replace with xel, yel?
 4105:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4106:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4107:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4108:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4109:          } //ics
 4110:                    
 4111:          diffRho = 0.0;
 4112: 
 4113:       } else { //internal and wet
 4114:          if constexpr(ics==1) {
 4115:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4116: 
 4117:             // Vector from e1 to e2
 4118:             vec = toVector2(e2->center - e1->center);
 4119: 
 4120:          } else { 
 4121:             // IMPLEMENT THIS XXXXXX
 4122:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4123:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4124:             //                   alow(j)=xctr2
 4125:             //                   bdia(j)=yctr2
 4126:          } // ics
 4127: 
 4128:          diffRho = rho2 - e1->demeanedDensity(k);
 4129:       }
 4130: 
 4131:    }
 4132: 
 4133:    __global__ void computeDensityCubicSplines(void) {
 4134:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4135: 
 4136:       ELEM(elem);
 4137: 
 4138:       if (elem->isDry) return;
 4139: 
 4140:       const int kb = elem->kb;
 4141: 
 4142:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4143:       if (elem->is2D()) {
 4144:          // In the 2D case, the density is constant at the prism level. 
 4145:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4146:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4147:       } else { //3D
 4148: 
 4149:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4150:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4151:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4152:          ///// XXXX CHECK INDICES!!!!!
 4153:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4154:       } // 2D/3D
 4155: 
 4156:    }
 4157: } // extern "C"
 4158: 
 4159: 
 4160: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4161: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4162: 
 4163:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4164: 
 4165:    const int kb  = elem->kb;
 4166:    const int kb2 = elem2->kb;
 4167: 
 4168:    // z-coordinate of prism of elem
 4169:    const double zp = elem->z_prism(k);
 4170: 
 4171:    double rho = 0.0;
 4172: 
 4173:    if (elem2->is2D()) {
 4174:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4175: 
 4176:    } else {  // 3D
 4177: 
 4178:       // eta_min may be < zmax
 4179:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4180:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4181: 
 4182:       // (Extrapolate density below bottom, we will fix it later)
 4183:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4184:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4185:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4186:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4187:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4188:    } // 2D/3D
 4189:      
 4190: 
 4191:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4192:    // Now we need to fix it.
 4193:    if (elem->z[k] < elem2->z[kb2]) {
 4194:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4195: 
 4196:       // There are two methods to adjust the density at the bottom of the element.
 4197:       // iunder_deep=0: 
 4198:       const double depth1 = abs(elem->z[kb]); // larger depth
 4199: 
 4200:       if (iunder_deep==0) {
 4201: 
 4202:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4203: 
 4204:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4205: 
 4206:       } else { // iunder_deep != 0
 4207: 
 4208:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4209: 
 4210:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4211: 
 4212:          //   Demeaned density at the same z coordinate as
 4213:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4214:          }
 4215: 
 4216:       } // if iunder_deep
 4217:    } // if elem->z[kb] < elem2->z[kb]
 4218: 
 4219:    return rho;
 4220: }
 4221: 
 4222: 
 4223: extern "C" {
 4224:    __global__ void computeDensityGradient(void) {
 4225: 
 4226:          // Compute the horizontal density gradient at each element.
 4227:       // It works in two steps:
 4228:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4229:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4230:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4231:       //             gradRho.r1 = rho1 - rho0
 4232:       //             gradRho.r2 = rho2 - rho0
 4233:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4234:       // 
 4235:       //  NOTE: We use de-meaned densities.
 4236: 
 4237:       ELEM(elem);
 4238: 
 4239:       if (elem->isDry) return;
 4240: 
 4241:       const int kb  = elem->kb;
 4242:       const int i34 = elem->i34;
 4243: 
 4244:       for (int k = kb + 1; k < nvrt; k++) {
 4245:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4246:          //             gradRho.r1 = rho1 - rho0
 4247:          //             gradRho.r2 = rho2 - rho0
 4248:          int icount = 0;
 4249:          double sumRx = 0.0;
 4250:          double sumRy = 0.0;
 4251:          for (int j1=0; j1<i34; j1++) { 
 4252: 
 4253:             const int j2 = elem->nxq(j1 + 1);
 4254: 
 4255:             // Pairs of consecutive neighbor elements of elem
 4256:             const Element *e1 = elem->nghbElems[j1];
 4257:             const Element *e2 = elem->nghbElems[j2];
 4258: 
 4259:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4260:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4261:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4262: 
 4263:             // Compute the density difference and the vector from elem to e1 and e2
 4264:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4265:             double diffRho1, diffRho2;
 4266:             Vector2 vec1, vec2;
 4267:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4268:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4269: 
 4270:             const double rl1 = length(vec1);
 4271:             const double rl2 = length(vec2);
 4272:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4273: 
 4274:             const double delta = cross(vec1, vec2);
 4275:             const double sintheta = abs(delta)/(rl1*rl2);
 4276: 
 4277:             // To avoid problems, avoid elements with small angle between vectors
 4278:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4279:             const bool validEq = (sintheta > sin_one_deg);
 4280: 
 4281:             if (validEq) {
 4282:                // Solve the system of equations to get the density gradient at elem
 4283:                icount++;
 4284:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4285:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4286:                sumRx += Rx;
 4287:                sumRy += Ry;
 4288:             }
 4289:          } // for j1
 4290: 
 4291:          // Compute the average density gradient at elem
 4292:          if (icount==0) {
 4293:            // Bad mesh quality; bail out with 0 b-cc
 4294:            elem->gradRho[k] = {0.0, 0.0};
 4295:          } else {
 4296:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4297:          }
 4298: 
 4299:       } // for k
 4300: 
 4301:    }
 4302: 
 4303:    __global__ void computeBaroclinicTerm(void) {
 4304:    // Computes the baroclinic term at sides (at half levels).
 4305:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4306:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4307: 
 4308:       SIDE(side);
 4309: 
 4310:       if (side->isDry) return;
 4311: 
 4312:       const Element *e1 = side->elems[0];
 4313:       const Element *e2 = side->elems[1];      
 4314:       const int kb = side->kb;
 4315:       
 4316:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4317: 
 4318:       // interpolates vertically the density gradient of the two elements at the half level/
 4319: 
 4320:       // Starts the integration at the surface and goes down to the bottom
 4321:       int k1 = nvrt - 1;
 4322:       int k2 = nvrt - 1;
 4323: 
 4324:       side->bcc[nvrt-1] = {0.0, 0.0};
 4325:       for (int k = nvrt-1; k >= kb; k--) {
 4326:       // For each prism level (from surface to bottom)...
 4327: 
 4328:          // For both elements, interpolate density gradient at the side's half level.
 4329:          // The gradient at the side is the average of the gradients at the elements.
 4330:          // w1, w2 are used to take into account boundary sides, with just one element.
 4331:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4332:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4333:          const double wsum = w1 + w2;
 4334:          w1 = w1/wsum;
 4335:          w2 = w2/wsum;
 4336:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4337: 
 4338:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4339:          Vector2 gradRho = {0.0, 0.0};
 4340:          if (e1 != nullptr && k > kb) {
 4341:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4342:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4343:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4344:             
 4345:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4346:          }      
 4347:          if (e2 != nullptr && k > kb) {
 4348:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4349:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4350:             
 4351:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4352:          }
 4353: 
 4354:          if constexpr(ics==2) {
 4355:             // IMPLEMENT THIS XXXXXX
 4356:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4357:             // swild(1)=tmp1
 4358:             // swild(2)=tmp2
 4359:          }
 4360:          
 4361:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4362:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4363:          // CHECK INDICES!!! XXX
 4364:          const double grav3 = side->grav3();
 4365:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4366:       } // for
 4367: 
 4368:    }
 4369: 
 4370: 
 4371: 
 4372:    __global__ void computeHorGradientAtSide(void) {
 4373: 
 4374:       // Compute the horizontal density gradient at each element.
 4375:       // It works in two steps:
 4376:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4377:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4378:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4379:       //             gradRho.r1 = rho1 - rho0
 4380:       //             gradRho.r2 = rho2 - rho0
 4381:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4382:       // 
 4383:       //  NOTE: We use de-meaned densities.
 4384: 
 4385:       SIDE(side);
 4386: 
 4387:       if (side->isDry) return;
 4388: 
 4389:       // Computes the gradient of the variables at the side center.
 4390:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4391:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4392:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4393: 
 4394:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4395:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4396:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4397:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4398: 
 4399: 
 4400:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4401:          side->gradEta1.x, side->gradEta1.y, 
 4402:          side->gradEta2.x, side->gradEta2.y, 
 4403:          side->gradETP.x, side->gradETP.y, 
 4404:          side->gradPr.x, side->gradPr.y);
 4405: 
 4406: 
 4407:    }
 4408: 
 4409: 
 4410:    __global__ void solveMomentumEquations(void) {
 4411: 
 4412:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4413:       Vector2 rrhs[nvrt];
 4414: 
 4415:       SIDE(side);
 4416: 
 4417:       if (side->isDry) 
 4418:       {
 4419:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4420: 
 4421:          return;
 4422:       }
 4423: 
 4424:       const Node *n1 = side->n1;
 4425:       const Node *n2 = side->n2;
 4426: 
 4427:       const int kb = side->kb;
 4428: 
 4429:       const double veg_h = side->veg_h();
 4430:       const double grav3 = side->grav3();
 4431: 
 4432:       if (side->is2D()) {
 4433:          // Warning: Do not use htot2, which is updated.
 4434:          const double htot = side->htot1();
 4435:          const double hhat = side->hhat;
 4436: 
 4437:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4438: 
 4439:          Vector2 tau2 = {0.0, 0.0};
 4440:           
 4441:          if constexpr(ics==1) {
 4442:             tau2 = side->tau();
 4443: 
 4444:          } else {
 4445:             assert(false && "Not implemented: ics == 2");
 4446:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4447:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4448:             // taux2=(vn1+tt1)*0.5d0
 4449:             // tauy2=(vn2+ss1)*0.5d0
 4450:          } // if ics         
 4451: 
 4452:          // hat_gam has units of m/s
 4453: 
 4454:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4455: 
 4456:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4457:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4458: 
 4459:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4460: 
 4461:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4462:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4463: 
 4464:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4465: 
 4466:       }
 4467:       else { // 3D
 4468: 
 4469:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4470:          // 
 4471:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4472:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4473:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4474:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4475:          // k+1 and k.
 4476: 
 4477: 
 4478:          // // Define layer thickness & viscosity
 4479:          // for (int k=kb + 1; k<nvrt; k++) {
 4480:          //    const double dzz = side->Dz(k - 1);
 4481: 
 4482:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4483: 
 4484:          //    // Vertical viscosity at the face center
 4485:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4486:         
 4487:          // }
 4488: 
 4489: 
 4490:          const int ndim = nvrt - kb;
 4491:          const double zTopCanopy = side->zTopCanopy();
 4492: 
 4493:          // Initialize the tridiagonal system
 4494:          for (int k=kb+1; k<nvrt; k++) {
 4495:             
 4496:             const int kin = k - kb;
 4497: 
 4498:             // Vertical viscosity at the face center
 4499:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4500:             const double dzz = side->Dz(k);
 4501: 
 4502:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4503: 
 4504:             alow[kin] = 0.0;
 4505:             cupp[kin] = 0.0;
 4506:             bdia[kin] = 0.0;
 4507: 
 4508:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4509:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4510:             if constexpr(iveg != 0) {	
 4511: 
 4512:                // We divide the code into two parts, one that deals with layers k, k+1, and another that deals with k-1, k.
 4513:                // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4514:                // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4515: 
 4516:                // First part: layers k, k+1
 4517:                if (k < nvrt - 1) {
 4518:                              
 4519:  
 4520:                   // If there is vegetation at this level...
 4521:                   if (zTopCanopy > side->zc[k]) {
 4522:                      // If the canopy is above the k layer...
 4523:                      
 4524:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4525:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4526:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4527:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4528: 
 4529:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4530:                      const double vmag2 = length(ut2);
 4531:                      const double vmag1 = length(side->u2[k]);
 4532:                      const double vmag = 0.5*(vmag1 + vmag2);
 4533:                      
 4534:                      // Computes the vegetation alpha at the face center
 4535:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4536: 
 4537:                      cff1 += veg_alpha_sd*dt*vmag;
 4538:                   } // if iveg
 4539: 
 4540:                   const double tmp = dt*dfz/dzz;
 4541:                   cupp[kin] += cff1*dzz/6.0 - tmp;
 4542:                   bdia[kin] += cff1*dzz/3.0 + tmp;
 4543:                
 4544:                }
 4545: 
 4546: 
 4547:                // Second part: layers k-1, k
 4548:                if (k > kb + 1) {
 4549: 
 4550:                   double cff1 = 1.0; //init \bar{c^k}
 4551: 
 4552:                   // If there is vegetation at this level...
 4553:                   if (zTopCanopy > side->zc[k-1]) {
 4554:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4555:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4556: 
 4557:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4558: 
 4559:                      const double vmag2 = length(ut2);
 4560:                      const double vmag1 = length(side->u2[k-1]);
 4561:                      const double vmag = 0.5*(vmag1 + vmag2);
 4562: 
 4563:                      // Computes the vegetation alpha at the face center
 4564:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4565:                      cff1 += veg_alpha_sd*dt*vmag;
 4566:                   } // if zTopCanopy
 4567: 
 4568:                   const double tmp = dt*dfz/dzz;
 4569:                   alow[kin] += cff1*dzz/6.0 - tmp;
 4570:                   bdia[kin] += cff1*dzz/3.0 + tmp;
 4571: 
 4572:                } else { // Bottom boundary
 4573:                   // This occurs at the bottom, where the bottom drag is applied.
 4574: 
 4575:                   bdia[kin] += dt*side->chi2;
 4576: 
 4577:                } // if (k > kb + 1)
 4578: 
 4579: 
 4580: 
 4581:             }
 4582:          }
 4583: 
 4584: 
 4585:          // Computes the RHS.
 4586:          // -----------------
 4587: 
 4588:          //	BC to be imposed at the end.
 4589: 
 4590:          const Vector2 gradETP  = side->gradETP;
 4591:          const Vector2 gradPr   = side->gradPr;
 4592:          const Vector2 gradEta1 = side->gradEta1;
 4593:          const Vector2 gradEta2 = side->gradEta2;
 4594: 
 4595:          const Vector2 *btu = side->btu;
 4596:          const Vector2 *u2  = side->u2;
 4597:          const double coriolis = side->coriolis;
 4598:          const Vector2 *d2uv = side->d2uv;
 4599: 
 4600: 
 4601:          for (int k = kb + 1; k<nvrt; k++) {
 4602:             const int kin = k - kb;
 4603: 
 4604:             const double dz_0 = side->Dz(k);
 4605:             const double dz_1 = side->Dz(k+1);  
 4606: 
 4607:             rrhs[kin] = {0.0, 0.0};
 4608:             double dz = 0.0;
 4609: 
 4610:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 4611:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 4612:             if (k < nvrt  ) dz += 0.5*dz_1;
 4613:             if (k > kb + 1) dz += 0.5*dz_0;
 4614: 
 4615:             // Elevation gradient, atmospheric pressure and tidal potential
 4616:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 4617: 
 4618:             // Coriolis, advection, wind stress, and horizontal viscosity
 4619:             if (k<nvrt) {
 4620: 
 4621: 
 4622:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 4623:                                         (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 4624:                                         dt*(2.0*d2uv[k] + d2uv[k + 1]));
 4625: 
 4626:                //diff stress tensors 1006
 4627:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 4628:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 4629:                   assert(false && "Not implemented: itur == 5");
 4630:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 4631:                }
 4632: 
 4633:             } else { // k=nvrt
 4634:                Vector2 tau2 = {0.0, 0.0};
 4635:                if constexpr(ics==1) {
 4636:                   tau2 = side->tau();
 4637:                } else {
 4638:                   assert(false && "Not implemented: ics == 2");
 4639:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4640:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4641:                   // taux2=(vn1+tt1)*0.5d0
 4642:                   // tauy2=(vn2+ss1)*0.5d0
 4643:                } // if ics
 4644: 
 4645:                rrhs[kin] += dt*tau2;
 4646: 
 4647:             } // if k<nvrt
 4648: 
 4649:             if (k > kb + 1) {
 4650:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k - 1] + 
 4651:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 4652:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 4653: 
 4654: 
 4655:                // diff stress tensors 1006
 4656:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 4657:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 4658:                   rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 4659:                }
 4660: 
 4661:             } // if k>kbs + 1
 4662: 
 4663:             // Baroclinic
 4664:             Vector2 *bcc = side->bcc;
 4665:             if constexpr(ibc == 0) {
 4666:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 4667:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 4668: 
 4669:             } // if ibc==0
 4670: 
 4671: 
 4672:          } // k=kb + 1,nvrt
 4673: 
 4674:          tridag_sch(nvrt,2,ndim,2,alow,bdia,cupp,rrhs,soln,gam);
 4675: 
 4676:          for (int k=kbs+1; k<nvrt; k++) {
 4677:             const int kin = k - kb;
 4678: 
 4679:             // Velocity is always clamped to maximum values
 4680:             side->u2[k] = {clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2)};
 4681:          } // k
 4682:       }
 4683: 
 4684:       // Impose velocity boundary conditions at the bottom
 4685:       if constexpr(imm == 2) { //no slip
 4686:          double dep;
 4687:          Vector2 vel;
 4688: 
 4689:          update_bdef(time, x0, y0, dep, vel);
 4690:          side->u2[kb] = vel;
 4691: 
 4692:       } else {
 4693:          if (Cd(j)==0.0) {
 4694:             side->u2[kb] = side->u2[kb+1];
 4695:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 4696:             side->u2[kb] = {0.0, 0.0};
 4697:          }
 4698:           
 4699:       } // if imm
 4700: 
 4701:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4702:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 4703:       
 4704: 
 4705:    }
 4706: 
 4707: 
 4708:    __device__ void applyMomentumBC(void) {
 4709: 
 4710:       SIDE_BND(side_bnd);
 4711: 
 4712:       Side *side = side_bnd->side;
 4713:       const BoundarySegment *segment = side_bnd->segment;
 4714:       const Node *n1 = side->n1;
 4715:       const Node *n2 = side->n2;
 4716: 
 4717:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 4718:       const bool isLand     = ((int)segment == landSegment);
 4719:       const bool isInternal = ((int)segment == internalSegment);
 4720: 
 4721:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 4722:       const int kb = side->kb;
 4723: 
 4724:       if (!isLand && segment->ifltype != 0) {
 4725:          const Vector2 *uth = side->uth;
 4726: 
 4727:          for (int k=kb; k < nvrt; k++) {
 4728:             assert(segment->ifltype == -2 || (uth[k].x >= -98 && uth[k].y >= -98) && "Momentum BC: Side has no velocity boundary conditions");
 4729: 
 4730:             Vector2 uth = side->uth[k];
 4731: 
 4732:             if (segment->ifltype == -1) {
 4733:                // Flather 1
 4734: 
 4735:                const double depth = side->depth();
 4736: 
 4737:                assert(n1->eta_mean >= -98 && n2->eta_mean >= -98 && "Flather bnd elevation not assigned");
 4738:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 4739: 
 4740:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->eta_mean()) + dot(uth, side->n);
 4741: 
 4742:                side->u2[k] = vnorm*side->n;
 4743: 
 4744:             } else if (segment->ifltype == -2) { // Discharge
 4745: 
 4746: 
 4747:                const double eta1 = side->eta1();
 4748:                const double eta2 = side->eta2();
 4749:                const double htot = side->htot2();
 4750: 
 4751:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 4752:                const double dischrg = discharge(eta1);
 4753:                
 4754: 
 4755:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 4756: 
 4757:                const double vnorm = dischrg*eta2/htot;
 4758: 
 4759:                side->u2[k] = vnorm*side->n;
 4760: 
 4761: 
 4762:             }
 4763:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 4764:                const double vnorm = dot(side->u2[k], side->n);
 4765: 
 4766:                double rat;
 4767:                if (vnorm <= 0.0) rat = vobc1(isbs(j)); // incoming
 4768:                else              rat = vobc2(isbs(j)); // outgoing
 4769: 
 4770:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*uths;
 4771:             }
 4772:             else { // not Flather or 3D radiation
 4773:                side->u2[k] = uths;
 4774: 
 4775:             } // if (segment->ifltype...
 4776: 
 4777:          }
 4778: 
 4779:       }
 4780:       else if (isLand) { // land bnd
 4781:          if constexpr(islip == 0) { // free slip
 4782:             for (int k=kb; k < nvrt; k++) {
 4783:                double vnorm = 0.0; // for most cases
 4784:                const double vtan = dot(side->u2[k], side->t());
 4785:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 4786:             }
 4787: 
 4788:          } else { // no slip
 4789:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 4790: 
 4791:          }
 4792:       } // if (side segment type...
 4793: 
 4794:       
 4795: 
 4796: 
 4797: 
 4798:    }
 4799: 
 4800: 
 4801:    __device__ void shapiroFilter1(void) {
 4802:       // First step of the Shapiro filter (normally used if indvel<=0)
 4803:       // Computes the filtered values and stores them in bcc (as a temporary array).
 4804: 
 4805:       if constexpr(ishapiro == 0) return;
 4806: 
 4807:       SIDE(side);
 4808: 
 4809:       const bool isInternal = ((int)side->sideBnd->segment == internalSegment);
 4810: 
 4811:       if (side->isDry || isInternal ) return;
 4812: 
 4813:       const int kb = side->kb;
 4814: 
 4815:       for (int mm = 1; mm <= niter_shap; mm++) {
 4816: 
 4817: 
 4818:          // Internal wet sides
 4819:          for (int k = kb + 1; k < nvrt; k++) {
 4820:             // WARNING: reusing bcc as a temporary array to store the suru values.
 4821:             side->bcc[k] = {0.0, 0.0};
 4822:             Vector2 suru = {0.0, 0.0};
 4823: 
 4824:             for (int j=0; j<4; j++) {
 4825: 
 4826:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 4827:                
 4828:                int kin = k;
 4829:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 4830:                
 4831:                if constexpr(ics==1) {
 4832:                   suru += side->u2[kin];
 4833:                } else {
 4834:                   assert(false && "Not implemented: ics == 2");
 4835:                   // Vector2 vn1, vn2;
 4836:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 4837:                   // suru=suru+vn1;
 4838:                   // surv=surv+vn2;
 4839:                }
 4840:             }
 4841: 
 4842:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 4843: 
 4844:          }
 4845:       }
 4846:    }
 4847: 
 4848:    __device__ void shapiroFilter2(void) {
 4849:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 4850: 
 4851:       if constexpr(ishapiro == 0) return;
 4852: 
 4853:       SIDE(side);
 4854: 
 4855:       const bool isInternal = ((int)side->sideBnd->segment == internalSegment);
 4856: 
 4857:       if (side->isDry || isInternal ) return;
 4858: 
 4859:       const int kb = side->kb;
 4860: 
 4861:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 4862: 
 4863:       if (side->is2D()) {
 4864:          side->u2[kb] = side->u2[nvrt - 1];
 4865:          
 4866:       } else {
 4867:          // 3D
 4868:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 4869:          
 4870:       }
 4871: 
 4872:    }
 4873: 
 4874: 
 4875:    __device__ void ul0UpdateZCoords(void) {
 4876:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 4877:       
 4878:       NODE(node);      
 4879: 
 4880:       if (node->isDry2()) { 
 4881: 
 4882:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 4883: 
 4884:          if constexpr(ivcor != 1) node->kb = 0;
 4885: 
 4886:       } else {
 4887: 
 4888:          node->updateKb();
 4889:          for (int k = node->kb; k < nvrt; k++) node->znl[k] = node->compZCoord(k); 
 4890: 
 4891:       } // if wet or dry
 4892: 
 4893:       // We use the temp.b field to store the previous state of isDry.
 4894:       node->tmp.b = node->isDry;
 4895: 
 4896:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 4897:       node->isDry = true;
 4898: 
 4899:    }
 4900: 
 4901:    __device__ void ul0ComputeDryElementsAndNodes(void)
 4902:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 4903:    {
 4904:       ELEM(elem);
 4905: 
 4906:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 4907: 
 4908:       // All the nodes of a wet element are wet.
 4909:       if (!elem->isDry) {
 4910:          elem->nodes[0]->isDry = false;
 4911:          elem->nodes[1]->isDry = false;
 4912:          elem->nodes[2]->isDry = false;
 4913:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 4914: 
 4915:       }
 4916: 
 4917: 
 4918:       elem->kb = 0;
 4919: 
 4920:       if (elem->isDry) return;
 4921: 
 4922:       // Wet
 4923:       const Node *n1 = elem->nodes[0];
 4924:       const Node *n2 = elem->nodes[1];
 4925:       const Node *n3 = elem->nodes[2];  
 4926:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 4927: 
 4928:    //    if(elem->isDry2()) {
 4929:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 4930:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 4931:    //        call parallel_abort(errmsg)
 4932:    //    }
 4933: 
 4934: 
 4935:       // Computes element's kb as the minimum of the nodes' kb.
 4936:       const int kb1 = n1->kb;
 4937:       const int kb2 = n2->kb;
 4938:       const int kb3 = n3->kb;
 4939:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 4940: 
 4941:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 4942: 
 4943: 
 4944:       // Computes the element z as the mean of the nodes z.
 4945:       for (int k = elem->kb; k < nvrt; k++) {
 4946: 
 4947:          // Compute the element z as the mean of the nodes z.
 4948:          elem->z[k] = (n1->znl[max(k, kb1)] + n2->znl[max(k, kb2)] + n3->znl[max(k, kb3)]);
 4949:          if (elem->isQuad()) elem->z[k] += n4->znl[max(k, kb4)];          
 4950:          elem->z[k] /= elem->i34;
 4951: 
 4952: 
 4953:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 4954:       }
 4955:                   
 4956:    }
 4957: 
 4958:    __device__ void ul0UpdateRewettedNodes(void)
 4959:    {
 4960:       NODE(node);
 4961:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 4962: 
 4963:       if (it == iths) return;
 4964: 
 4965: 
 4966:       if(!node->isDry && node->tmp.b) { // rewetted
 4967:          for (int k=0; k < nvrt; k++) {
 4968: 
 4969:             Vector2 utmp={0.0, 0.0};
 4970: 
 4971:             double ttmp=0.0;
 4972:             double dstmp=0.0;
 4973:             int icount=0;
 4974:             for (int j = 0; j < node->numNodes; j++) {
 4975: 
 4976: 
 4977:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 4978:                if (!node->isDry) { // all indices extended
 4979:                   icount++;
 4980: 
 4981:                   // Assume small element size in wet/dry zone so pframes are close to each other
 4982:                   utmp += node->u2[k];
 4983:                   
 4984:                   ttmp += node->tr[0,k]; // tnd(k,nd)
 4985:                   stmp += node->tr[1,k]; // snd(k,nd)
 4986:                }
 4987:             }
 4988: 
 4989:             if(icount > 0) {
 4990:                const double inv_icount = 1.0/icount;
 4991:                node->u2[k]     = inv_icount*utmp;
 4992:                node->tr[0,k]   = inv_icount*ttmp;
 4993:                node->tr[1,k]   = inv_icount*stmp;
 4994:             }
 4995:          }
 4996:       }
 4997:    }
 4998: 
 4999: 
 5000:    __device__ void ul0UpdateSides(void) {
 5001: 
 5002:       SIDE(side);
 5003: 
 5004:       // A side is wet if and only if at least one of its elements is wet.
 5005:       const bool isWet = !side->elem[0]->isDry || (!side->isBnd2() && !side->elem[1]->isDry);
 5006: 
 5007:       const Node *n1 = side->n1;
 5008:       const Node *n2 = side->n2;
 5009:       const int kb1 = n1->kb;
 5010:       const int kb2 = n2->kb;
 5011: 
 5012:       side->kb = 0; // dry
 5013: 
 5014:       if (isWet) 
 5015: 
 5016:          assert((n1->idry || n2->idry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5017: 
 5018:          assert(side->htot2() <= h0 && "Weird side. Total depth is smaller than h0.");
 5019: 
 5020:          side->kb = min(kb1, kb2);
 5021: 
 5022:          for (int k = side->kb; k < nvrt; k++) {
 5023:             side->zc[k] = 0.5*(n1->znl[max(k, kb1)] + n2->znl[max(k, kb2)]);
 5024: 
 5025:          
 5026:             if ((k >= side->kb + 1) && (side->zc[k] - side->zc[k-1] <= 0.0)) {
 5027:                write(errmsg,*)'Weird side (3):',k,iplg(n1),iplg(n2),znl(max(k,kbp(n1)),n1), &
 5028:                   &znl(max(k,kbp(n2)),n2),znl(max(k-1,kbp(n1)),n1),znl(max(k-1,kbp(n2)),n2)
 5029:                call parallel_abort(errmsg)
 5030:             }
 5031: 
 5032: 
 5033:             // Compute velocity, S and T for re-wetted sides 
 5034:             if ((it != iths) && (side->isDry && isWet)) {
 5035:             
 5036:                Vector2 utmp={0.0, 0.0};
 5037:                double ttmp=0.0;
 5038:                double stmp=0.0;
 5039:                int icount=0;
 5040: 
 5041:                // For all the sides on the two elements that share this side
 5042:                for (int j=0; j < 2; j++) {
 5043:                   const Element *elem = side->elems[j];
 5044:                   if (elem == nullptr) continue;
 5045: 
 5046:                   for (int jj=0; jj < elem->i34; jj++) {
 5047:                      const Side *nSide = elem->sides(jj);
 5048:                      if (nSide->isDry) continue;
 5049: 
 5050:                      icount++;
 5051:                      utmp += nSide->u2[k];
 5052:                      ttmp += nSide->tr[0,k];
 5053:                      stmp += nSide->tr[1,k];
 5054:                      
 5055:                   }
 5056:                }
 5057:                   
 5058:                assert(icount > 0 && "No wet sides around this side");
 5059:                if (icount > 0) {
 5060:                   side->u2[k] = utmp/icount;
 5061:                   side->tr[0,k] = ttmp/icount;
 5062:                   side->tr[1,k] = stmp/icount;
 5063:                } // if icount > 0
 5064: 
 5065:             } // if ((it != iths) && (side->isDry && isWet))
 5066: 
 5067:          } // for k
 5068: 
 5069:       } // if isWet
 5070:    
 5071:       side->isDry = !isWet;
 5072: 
 5073:    }
 5074: 
 5075:  
 5076:   
