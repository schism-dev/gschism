 1863: // Convenience macros for accessing the objects in kernels.
 1864: 
 1865: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1866:                    Side *side = &(mesh->localSideData[idx_side]); \
 1867:                    if (idx_side >= mesh->ns) return;
 1868: 
 1869: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1870:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1871:                    if (idx_elem >= mesh->ne) return;
 1872: 
 1873: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1874:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1875:                    if (idx_node >= mesh->np) return;
 1876: 
 1877: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1878:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1879:                               const bool valid = (idx_node < mesh->np);                   
 1880: 
 1881: 
 1882: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1883:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1884:                            if (idx_node_bnd >= mesh->nbp) return;
 1885: 
 1886: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1887:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1888:                            if (idx_side_bnd >= mesh->nbs) return;                           
