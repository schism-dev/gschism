 5660: 
 5661:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5662: 
 5663:       SIDE(side);
 5664: 
 5665:       side->U = {0.0, 0.0}; 
 5666:          
 5667:       if(side->isDry) return;
 5668: 
 5669:       // Vertically integrated velocity U
 5670:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5671:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5672:          side->U += side->Dz(k + 1)*uc;  
 5673:       }
 5674: 
 5675:    }
 5676: 
 5677:    __global__ void computeBottomDragVegetation(void) {
 5678:       // UNFINISHED. CHECK THIS:
 5679:       // How many kernels are needed? Why so many for loops?
 5680:       // Is the loop on sides needed?
 5681: 
 5682:       NODE(node);
 5683: 
 5684: 
 5685:       const int    kb      = node->kb;
 5686:       const double htot    = node->htot2(); 
 5687:       
 5688:       if (node->isDry) {
 5689:          // Default values for dry nodes
 5690:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5691:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5692: 
 5693:          return;
 5694:        
 5695:       }
 5696: 
 5697:       // Computes bottom drag Cd based on the selected nchi
 5698:       node->computeBottomDragCd();
 5699:       
 5700: 
 5701: 
 5702:       //   Bottom stress in m^2/s^2
 5703:       if (node->rho[kb + 1] >= -98.0)
 5704:       {
 5705:          const double mag_u = length(node->u2[kb + 1]);
 5706:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5707: 
 5708:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5709:          // !sediment erosion: this part needs more documentation
 5710:       }
 5711:     
 5712: 
 5713: 
 5714:       // Compute vegetation parameters
 5715:       //--------------------------------
 5716: 
 5717:       // SAV constants
 5718:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5719:       constexpr double veg_cfpsi = 0.16;
 5720: 
 5721:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5722:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5723: 
 5724:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5725:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5726:          int kbin = 0; // bin index
 5727:          for (int k = kb; k < nvrt; k++) {
 5728:             // Computes node height above the bottom level
 5729:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5730:             assert(false && "Vertical variation of vegetation not implemented");
 5731: 
 5732:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5733:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5734:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5735:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5736:             // } else {
 5737:             //    // Find the bin at which the current vertical level is
 5738:             //    while (kbin<nbins_veg_vert) {
 5739:             //       const double zn = node->z[kbin];
 5740:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5741:             //          break;
 5742:             //       } // if
 5743:             //       kbin++;
 5744:             //    } // while
 5745:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5746: 
 5747:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5748:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5749:                
 5750:             //    // Linear interpolation of the vegetation parameters
 5751:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5752:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5753:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5754:             // } // if rl10
 5755: 
 5756:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5757: 
 5758:          } // for k
 5759: 
 5760: 
 5761:       } else { // Ganthy (iveg==2)
 5762:       //  Modify canopy height, diameter, and density
 5763: 
 5764:          // Make sure there is vegetation on this node
 5765:          if (node->veg_h_unbent > 0.0) {
 5766:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5767: 
 5768:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5769:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5770:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5771: 
 5772:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5773:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5774:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5775:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5776:          } // if veg_h_unbent
 5777: 
 5778:          for (int k = 0; k < nvrt; k++) {
 5779:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5780:          } // for k
 5781:       
 5782: 
 5783:       } // if iveg
 5784:      
 5785: 
 5786:       // Compute vertical mean of veg_alpha3D
 5787:       if (iveg != 0) {
 5788:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5789:          double sum1=0.0;
 5790:          double sum2=0.0;
 5791:          // Integrate over each level under the canopy...
 5792:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5793:             const double Dz = node->Dz(k);
 5794: 
 5795:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5796:             sum2 += Dz;
 5797: 
 5798:          } // for k
 5799:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5800:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5801: 
 5802:       } // if iveg
 5803: 
 5804:    }
 5805: 
 5806:    __global__ void computeVegetationAndDragParameters(void) {
 5807:       // Computes the vegetation and drag model parameters:
 5808:       // chi, \tilde\chi, beta, \breve{H}
 5809:       
 5810:       SIDE(side);
 5811: 
 5812:       side->hhat = 0.0;
 5813:       side->chi2 = 0.0;
 5814:       side->chi = 0.0;
 5815:       side->veg_c2 = 0.0;
 5816:       side->veg_beta = 0.0;
 5817: 
 5818:       if (side->isDry) return;
 5819: 
 5820:       const double htot = side->htot2();
 5821:       const int    kb   = side->kb;
 5822: 
 5823:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5824: 
 5825:       const double veg_h     = side->veg_h();
 5826:       const double veg_nv    = side->veg_nv();
 5827:       const double veg_c     = side->veg_c();
 5828:       const double veg_beta  = side->veg_beta;
 5829:       const double veg_alpha = side->veg_alpha_vert_mean();
 5830: 
 5831:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5832:       // Velocity magnitude at the bottom level
 5833:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5834:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5835:       side->chi2 = side->Cd()*vmag1;
 5836:       side->chi  = side->chi2;
 5837:       if constexpr(iveg != 0) {
 5838:          const Node *n1 = side->n1;
 5839:          const Node *n2 = side->n2;
 5840:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5841:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5842:       }
 5843: 
 5844:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5845: 
 5846:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5847:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5848:       double magUa = 0.0;
 5849:       if constexpr(iveg != 0) {
 5850:          if (side->is3D() && veg_h > 0.0) {
 5851:             // 3D wet side with veg...
 5852: 
 5853:             double magUa = 0.0;
 5854:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5855:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5856: 
 5857:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5858:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5859:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5860: 
 5861:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5862:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5863: 
 5864:                   // Velocity magnitude at the bottom (l) of the level
 5865:                   const double ul = length(side->u2[k]);
 5866: 
 5867:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5868:                   magUa += Dz*0.5*(uh + ul);
 5869: 
 5870:                } // if HasVegetation
 5871:             } // for k
 5872:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5873: 
 5874:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5875:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5876:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5877:                const double zCpy = side->zTopCanopy();
 5878:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5879:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5880:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5881:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5882:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5883:             } // if isSubmerged
 5884:          } // if is3D
 5885:       } // if iveg   
 5886: 
 5887:       // Computes the friction modified depth, \breve{H} in notes
 5888:       if (side->is2D()) { // 2D
 5889: 
 5890:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5891:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5892: 
 5893:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5894: 
 5895:          side->hhat = htot*htot/fricH; 
 5896: 
 5897:       } else { // 3D
 5898:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5899: 
 5900:          if constexpr(iveg != 0) {
 5901:             
 5902:             if (side->isSubmerged()) { 
 5903:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5904:                side->hhat -= veg_c*Hhat_alpha;
 5905: 
 5906:             } else { // Emergent
 5907:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5908:             }
 5909:          } // if iveg
 5910: 
 5911:          // Enforce positivity for 3D model
 5912:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5913:       } // if 3D
 5914: 
 5915:    }
 5916: 
 5917: 
 5918: 
 5919:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5920:    // Computes the density gradient between two elements, e1 and e2.
 5921:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5922:    // zero in the direction normal to the side. 
 5923:    // 
 5924:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5925:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5926:    //
 5927:    // Input:
 5928:    //    e1: Element
 5929:    //    e2: Neighbor element (or nullptr if boundary)
 5930:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5931:    //    k: Index of the half-level at which the density is interpolated
 5932:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5933:    // 
 5934:    // Output:
 5935:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5936:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5937: 
 5938:       if (e2 == nullptr || e2->isDry) {
 5939:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5940: 
 5941:          Side *side = e1->sides[j];
 5942:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5943:                  
 5944:          if constexpr(ics == 1) {
 5945:             vec = side->n; // Normal vector to the side
 5946:          } else {
 5947:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5948:             // IMPLEMENT THIS XXXXXX
 5949:             // !replace with xel, yel?
 5950:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5951:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5952:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5953:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5954:          } //ics
 5955:                    
 5956:          diffRho = 0.0;
 5957: 
 5958:       } else { //internal and wet
 5959:          if constexpr(ics==1) {
 5960:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5961: 
 5962:             // Vector from e1 to e2
 5963:             vec = e2->center - e1->center;
 5964: 
 5965:          } else { 
 5966:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5967:             // Remember that elem->center is in global coordinates
 5968:             // IMPLEMENT THIS XXXXXX
 5969:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5970:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5971:             //                   alow(j)=xctr2
 5972:             //                   bdia(j)=yctr2
 5973:          } // ics
 5974: 
 5975:          diffRho = rho2 - e1->demeanedDensity(k);
 5976:       }
 5977: 
 5978:    }
 5979: 
 5980:    __global__ void computeDensityCubicSplines(void) {
 5981:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5982: 
 5983:       ELEM(elem);
 5984: 
 5985:       if (elem->isDry) return;
 5986: 
 5987:       const int kb = elem->kb;
 5988: 
 5989:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5990:       if (elem->is2D()) {
 5991:          // In the 2D case, the density is constant at the prism level. 
 5992:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5993:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5994:       } else { //3D
 5995: 
 5996:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5997:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5998:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5999:          ///// XXXX CHECK INDICES!!!!!
 6000:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6001:       } // 2D/3D
 6002: 
 6003:    }
 6004: } // extern "C"
 6005: 
 6006: 
 6007: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6008: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6009: 
 6010:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6011: 
 6012:    const int kb  = elem->kb;
 6013:    const int kb2 = elem2->kb;
 6014: 
 6015:    // z-coordinate of prism of elem
 6016:    const double zp = elem->z_prism(k);
 6017: 
 6018:    double rho = 0.0;
 6019: 
 6020:    if (elem2->is2D()) {
 6021:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6022: 
 6023:    } else {  // 3D
 6024: 
 6025:       // eta_min may be < zmax
 6026:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6027:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6028: 
 6029:       // (Extrapolate density below bottom, we will fix it later)
 6030:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6031:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6032:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6033:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6034:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6035:    } // 2D/3D
 6036:      
 6037: 
 6038:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6039:    // Now we need to fix it.
 6040:    if (elem->z[k] < elem2->z[kb2]) {
 6041:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6042: 
 6043:       // There are two methods to adjust the density at the bottom of the element.
 6044:       // iunder_deep=0: 
 6045:       const double depth1 = abs(elem->z[kb]); // larger depth
 6046: 
 6047:       if (iunder_deep==0) {
 6048: 
 6049:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6050: 
 6051:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6052: 
 6053:       } else { // iunder_deep != 0
 6054: 
 6055:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6056: 
 6057:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6058: 
 6059:          //   Demeaned density at the same z coordinate as
 6060:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6061:          }
 6062: 
 6063:       } // if iunder_deep
 6064:    } // if elem->z[kb] < elem2->z[kb]
 6065: 
 6066:    return rho;
 6067: }
 6068: 
 6069: 
 6070: extern "C" {
 6071:    __global__ void computeDensityGradient(void) {
 6072: 
 6073:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6074:       if constexpr(ibc != 0) return;
 6075: 
 6076:          // Compute the horizontal density gradient at each element.
 6077:       // It works in two steps:
 6078:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6079:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6080:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6081:       //             gradRho.r1 = rho1 - rho0
 6082:       //             gradRho.r2 = rho2 - rho0
 6083:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6084:       // 
 6085:       //  NOTE: We use de-meaned densities.
 6086: 
 6087:       ELEM(elem);
 6088: 
 6089:       if (elem->isDry) return;
 6090: 
 6091:       const int kb  = elem->kb;
 6092:       const int i34 = elem->i34;
 6093: 
 6094:       for (int k = kb + 1; k < nvrt; k++) {
 6095:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6096:          //             gradRho.r1 = rho1 - rho0
 6097:          //             gradRho.r2 = rho2 - rho0
 6098:          int icount = 0;
 6099:          double sumRx = 0.0;
 6100:          double sumRy = 0.0;
 6101:          for (int j1=0; j1<i34; j1++) { 
 6102: 
 6103:             const int j2 = elem->nxq(j1 + 1);
 6104: 
 6105:             // Pairs of consecutive neighbor elements of elem
 6106:             const Element *e1 = elem->nghbElems[j1];
 6107:             const Element *e2 = elem->nghbElems[j2];
 6108: 
 6109:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6110:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6111:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6112: 
 6113:             // Compute the density difference and the vector from elem to e1 and e2
 6114:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6115:             double diffRho1, diffRho2;
 6116:             Vector2 vec1, vec2;
 6117:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6118:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6119: 
 6120:             const double rl1 = length(vec1);
 6121:             const double rl2 = length(vec2);
 6122:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6123: 
 6124:             const double delta = cross(vec1, vec2);
 6125:             const double sintheta = abs(delta)/(rl1*rl2);
 6126: 
 6127:             // To avoid problems, avoid elements with small angle between vectors
 6128:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6129:             const bool validEq = (sintheta > sin_one_deg);
 6130: 
 6131:             if (validEq) {
 6132:                // Solve the system of equations to get the density gradient at elem
 6133:                icount++;
 6134:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6135:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6136:                sumRx += Rx;
 6137:                sumRy += Ry;
 6138:             }
 6139:          } // for j1
 6140: 
 6141:          // Compute the average density gradient at elem
 6142:          if (icount==0) {
 6143:            // Bad mesh quality; bail out with 0 b-cc
 6144:            elem->gradRho[k] = {0.0, 0.0};
 6145:          } else {
 6146:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6147:          }
 6148: 
 6149:       } // for k
 6150: 
 6151:    }
 6152: 
 6153:    __global__ void computeBaroclinicTerm(void) {
 6154:    // Computes the baroclinic term at sides (at half levels).
 6155:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6156:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6157: 
 6158:       if (ibc == 1) return;
 6159: 
 6160:       SIDE(side);
 6161: 
 6162:       if (side->isDry) return;
 6163: 
 6164:       const Element *e1 = side->elems[0];
 6165:       const Element *e2 = side->elems[1]; 
 6166:       const int kb = side->kb;
 6167:       
 6168:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6169: 
 6170:       // interpolates vertically the density gradient of the two elements at the half level/
 6171: 
 6172:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6173:       int k2 = max(kb, nvrt / 2);
 6174: 
 6175:       // Starts the integration at the surface and goes down to the bottom
 6176:       side->bcc[nvrt-1] = {0.0, 0.0};
 6177:       for (int k = nvrt - 2; k >= kb; k--) {
 6178:       // For each prism level (from surface to bottom)...
 6179: 
 6180:          // For both elements, interpolate density gradient at the side's half level.
 6181:          // The gradient at the side is the average of the gradients at the elements.
 6182:          // w1, w2 are used to take into account boundary sides, with just one element.
 6183:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6184:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6185:          const double wsum = w1 + w2;
 6186:          w1 = w1/wsum;
 6187:          w2 = w2/wsum;
 6188:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6189: 
 6190:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6191:          Vector2 gradRho = {0.0, 0.0};
 6192:          if (e1 != nullptr && k > kb) {
 6193:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6194:             
 6195:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6196:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6197:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6198: 
 6199:             // Grad(rho) vertically interpolated at the side's half level
 6200:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6201: 
 6202:             // Projects the element density gradient to the side frame if needed.
 6203:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6204: 
 6205:             // Adds the contribution of the density gradient at the side's half level
 6206:             gradRho += gradRho1*w1;
 6207:          }      
 6208:          if (e2 != nullptr && k > kb) {
 6209:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6210:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6211:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6212:             
 6213:             // Grad(rho) vertically interpolated at the side's half level
 6214:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6215: 
 6216:             // Projects the element density gradient to the side frame if needed.
 6217:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6218: 
 6219:             // Adds the contribution of the density gradient at the side's half level
 6220:             gradRho += gradRho2*w2;
 6221:          }
 6222: 
 6223:          
 6224:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6225:          // multiplied by -rampbc*(g/rho0) 
 6226:          const double grav3 = side->grav3();
 6227:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6228: 
 6229:       } // for
 6230: 
 6231:    }
 6232: 
 6233: 
 6234: 
 6235:    __global__ void computeHorGradientAtSide(void) {
 6236: 
 6237:       // Compute the horizontal density gradient at each element.
 6238:       // It works in two steps:
 6239:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6240:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6241:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6242:       //             gradRho.r1 = rho1 - rho0
 6243:       //             gradRho.r2 = rho2 - rho0
 6244:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6245:       // 
 6246:       //  NOTE: We use de-meaned densities.
 6247: 
 6248:       SIDE(side);
 6249: 
 6250: 
 6251:       if (side->isDry) return;
 6252: 
 6253:       // Computes the gradient of the variables at the side center.
 6254:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6255:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6256:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6257: 
 6258:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6259:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6260:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6261:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6262: 
 6263:    }
 6264: 
 6265: 
 6266:    __global__ void solveMomentumEquations(double time) {
 6267: 
 6268:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6269:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6270: 
 6271:       SIDE(side);
 6272: 
 6273:       if (side->isDry) 
 6274:       {
 6275:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6276: 
 6277:          return;
 6278:       }
 6279: 
 6280:       const Node *n1 = side->n1;
 6281:       const Node *n2 = side->n2;
 6282: 
 6283:       const int kb = side->kb;
 6284: 
 6285:       const double veg_h = side->veg_h();
 6286:       const double grav3 = side->grav3();
 6287: 
 6288:       if (side->is2D()) {
 6289:          // Remember: Do not use htot2, which is updated.
 6290:          const double htot = side->htot1();
 6291:          const double hhat = side->hhat;
 6292: 
 6293:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6294: 
 6295:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6296:          const Vector2 tau2 = side->tau();
 6297: 
 6298:          // hat_gam has units of m/s
 6299: 
 6300:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6301:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6302:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6303: 
 6304:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6305: 
 6306: 
 6307:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6308: 
 6309:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6310: 
 6311:       }
 6312:       else { // 3D
 6313: 
 6314:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6315:          // 
 6316:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6317:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6318:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6319:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6320:          // k+1 and k.
 6321: 
 6322: 
 6323:          const int ndim = nvrt - kb;
 6324:          const double zTopCanopy = side->zTopCanopy();
 6325: 
 6326:          // Initialize the tridiagonal system
 6327:          for (int k = kb + 1; k < nvrt; k++) {
 6328:             
 6329:             const int kin = k - (kb + 1);
 6330: 
 6331:             // Vertical viscosity at the face center
 6332:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6333: 
 6334:  
 6335:             alow[kin] = 0.0;
 6336:             cupp[kin] = 0.0;
 6337:             bdia[kin] = 0.0;
 6338: 
 6339:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6340:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6341: 
 6342:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6343:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6344:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6345: 
 6346:             // First part: layers k, k+1
 6347:             if (k < nvrt - 1) {
 6348:                              
 6349:                if constexpr(iveg != 0) {
 6350: 
 6351:                   // If there is vegetation at this level...
 6352:                   if (zTopCanopy > side->zc[k]) {
 6353:                      // If the canopy is above the k layer...
 6354:                      
 6355:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6356:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6357:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6358:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6359: 
 6360:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6361:                      const double vmag2 = length(ut2);
 6362:                      const double vmag1 = length(side->u2[k]);
 6363:                      const double vmag = 0.5*(vmag1 + vmag2);
 6364:                      
 6365:                      // Computes the vegetation alpha at the face center
 6366:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6367: 
 6368:                      cff1 += veg_alpha_sd*dt*vmag;
 6369: 
 6370:                   } // if (zTopCanopy
 6371:                } // if iveg
 6372: 
 6373:                const double dzz = side->Dz(k + 1);
 6374:                const double tmp = dt*dfz/dzz;
 6375:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6376: 
 6377:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6378:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6379:             }
 6380: 
 6381: 
 6382:             // Second part: layers k-1, k
 6383:             if (k > kb + 1) {
 6384: 
 6385:                double cff1 = 1.0; //init \bar{c^k}
 6386: 
 6387:                if constexpr(iveg != 0) {
 6388:                   // If there is vegetation at this level...
 6389:                   if (zTopCanopy > side->zc[k-1]) {
 6390:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6391:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6392: 
 6393:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6394: 
 6395:                      const double vmag2 = length(ut2);
 6396:                      const double vmag1 = length(side->u2[k-1]);
 6397:                      const double vmag = 0.5*(vmag1 + vmag2);
 6398: 
 6399:                      // Computes the vegetation alpha at the face center
 6400:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6401:                      cff1 += veg_alpha_sd*dt*vmag;
 6402:                   } // if zTopCanopy
 6403: 
 6404:                } // if iveg
 6405: 
 6406:                const double dzz = side->Dz(k);
 6407:                const double tmp = dt*dfz/dzz;
 6408:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6409: 
 6410:                alow[kin] += cff1*dzz/6.0 - tmp;
 6411:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6412: 
 6413:             } else { // Bottom boundary
 6414:                // This occurs at the bottom, where the bottom drag is applied.
 6415: 
 6416:                bdia[kin] += dt*side->chi2; // XXXX
 6417: 
 6418:             } // if (k > kb + 1)
 6419: 
 6420: 
 6421:          } // for (int k
 6422: 
 6423: 
 6424: 
 6425:          // Computes the RHS.
 6426:          // -----------------
 6427: 
 6428:          //	BC to be imposed at the end.
 6429: 
 6430:          const Vector2 gradETP  = side->gradETP;
 6431:          const Vector2 gradPr   = side->gradPr;
 6432:          const Vector2 gradEta1 = side->gradEta1;
 6433:          const Vector2 gradEta2 = side->gradEta2;
 6434: 
 6435:          const Vector2 *btu = side->btu;
 6436:          const Vector2 *u2  = side->u2;
 6437:          const double coriolis = side->coriolis;
 6438:          const Vector2 *nuGradU = side->nuGradU;
 6439: 
 6440:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6441:          for (int k = kb + 1; k < nvrt; k++) {
 6442:             const int kin = k - kb - 1;
 6443: 
 6444:             const double dz_0 = side->Dz(k);
 6445:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6446: 
 6447:             rrhs[kin] = {0.0, 0.0};
 6448:             double dz = 0.0;
 6449: 
 6450:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6451:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6452:             if (k < nvrt  ) dz += dz_1;
 6453:             if (k > kb + 1) dz += dz_0;
 6454: 
 6455:             // Elevation gradient, atmospheric pressure and tidal potential
 6456:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6457: 
 6458:             // Coriolis, advection, wind stress, and horizontal viscosity
 6459:             if (k < nvrt - 1) {
 6460: 
 6461: 
 6462:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6463:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6464:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6465:                                                 
 6466: 
 6467:                //diff stress tensors 1006
 6468:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6469:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6470:                   assert(false && "Not implemented: itur == 5");
 6471:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6472:                }
 6473:                // else assert(false && "itur # Not implemented");
 6474: 
 6475:             } else { // k == nvrt - 1 SURFACE
 6476:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6477:                const Vector2 tau2 = side->tau();
 6478: 
 6479:                rrhs[kin] += dt*tau2;          
 6480: 
 6481:             } // if k<nvrt
 6482: 
 6483: 
 6484:             if (k > kb + 1) {
 6485:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6486:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6487:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6488: 
 6489:                // diff stress tensors 1006
 6490:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6491:                   assert(false && "Not implemented: itur == 5");
 6492:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6493:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6494:                }
 6495:                // else assert(false && "itur # Not implemented");
 6496: 
 6497: 
 6498:             } // if k>kbs + 1
 6499: 
 6500:             // Baroclinic
 6501:             Vector2 *bcc = side->bcc;
 6502:             if constexpr(ibc == 0) {
 6503:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6504:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6505: 
 6506:             } // if ibc==0
 6507: 
 6508:          } // k=kb + 1,nvrt
 6509: 
 6510: 
 6511:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6512: 
 6513:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6514:             const int kin = k - kb - 1;
 6515:    
 6516:             // Velocity is always clamped to maximum values
 6517:             side->u2[k] = clampVelocity(soln[kin]);
 6518:          } // k
 6519: 
 6520:       } // if side->is2D()
 6521:       
 6522: 
 6523:       // Impose velocity boundary condition at the bottom
 6524:       if constexpr(imm == 2) { // 3D bed deformation model
 6525:          double dep;
 6526:          Vector2 vel;
 6527: 
 6528:          assert(false && "Not implemented: imm == 2");
 6529:          //update_bdef(time, x0, y0, dep, vel);
 6530:          // side->u2[kb] = vel;
 6531: 
 6532:       } else { // imm = 0 or 1
 6533:          if (side->Cd() == 0.0) {
 6534:             side->u2[kb] = side->u2[kb + 1];
 6535: 
 6536:          } else if (side->is3D()) { // 3D no slip bottom   
 6537:             side->u2[kb] = {0.0, 0.0};
 6538: 
 6539:          }
 6540:           
 6541:       } // if imm
 6542: 
 6543:       // The velocities below the bottom level are set to zero
 6544:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6545: 
 6546: 
 6547:    }
 6548: 
 6549: 
 6550:    __global__ void applyMomentumBC(void) {
 6551: 
 6552:       SIDE_BND(sideBnd);
 6553: 
 6554:       Side *side = sideBnd->side;
 6555:       const BoundarySegment *segment = sideBnd->segment;
 6556:       const Node *n1 = side->n1;
 6557:       const Node *n2 = side->n2;
 6558: 
 6559:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6560: 
 6561:       const bool isLand = segment->isLand;
 6562:       const int ifltype = segment->ifltype;
 6563: 
 6564:       const int kb = side->kb;
 6565: 
 6566: 
 6567:       if (!isLand && ifltype != 0) {
 6568:          const Vector2 *ubc = sideBnd->ubc;
 6569:   
 6570:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6571:             
 6572:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6573:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6574: 
 6575:             if (ifltype == -1) {
 6576:                // Flather 1
 6577: 
 6578:                const double depth = side->depth();
 6579: 
 6580:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6581: 
 6582:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6583: 
 6584:                side->u2[k] = vnorm*side->n;
 6585: 
 6586:             } else if (ifltype == -2) { // Discharge
 6587: 
 6588:                const double eta1 = side->eta1();
 6589:                const double eta2 = side->eta2();
 6590:                const double htot = side->htot2();
 6591: 
 6592:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6593:                assert(false && "Not implemented: Discharge bc");
 6594:                // const double dischrg = discharge(eta1);
 6595:                const double dischrg = 0.0; // XXX REMOVE
 6596:                
 6597: 
 6598:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6599: 
 6600:                const double vnorm = dischrg*eta2/htot;
 6601: 
 6602:                side->u2[k] = vnorm*side->n;
 6603: 
 6604:             }
 6605:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6606:                const double vnorm = dot(side->u2[k], side->n);
 6607: 
 6608:                double rat;
 6609:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6610:                else              rat = segment->vobc2; // outgoing
 6611: 
 6612:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6613: 
 6614:             }
 6615:             else { // not Flather or 3D radiation
 6616:                side->u2[k] = ubc[k];
 6617: 
 6618:             } // if (segment->ifltype...
 6619: 
 6620:          }
 6621: 
 6622:       }
 6623:       else if (isLand) { // if it is land boundary side
 6624: 
 6625:          if constexpr(islip == 0) { // free slip
 6626: 
 6627:             for (int k = kb; k < nvrt; k++) {
 6628: 
 6629:                const Vector2 t = side->t();
 6630:                const Vector2 n = side->n;
 6631: 
 6632:                double vnorm = 0.0; // for most cases
 6633:                const double vtan = dot(side->u2[k], t);
 6634:                
 6635:                side->u2[k] = vtan*t - vnorm*n;
 6636: 
 6637:             }
 6638: 
 6639:          } else { // no slip
 6640:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6641: 
 6642:          }
 6643:       } // if (side segment type...
 6644: 
 6645:    }
 6646: 
 6647: 
 6648:    __global__ void shapiroFilter1(void) {
 6649:       // First step of the Shapiro filter (normally used if indvel<=0)
 6650:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6651: 
 6652:       SIDE(side);
 6653: 
 6654:       // Only internal wet sides are processed
 6655:       if (side->isDry || !(side->isInternal())) return;
 6656: 
 6657:       const int kb = side->kb;
 6658: 
 6659:       for (int mm = 0; mm < niter_shap; mm++) {
 6660: 
 6661:          for (int k = kb + 1; k < nvrt; k++) {
 6662:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6663:             Vector2 suru = {0.0, 0.0};
 6664: 
 6665:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6666: 
 6667:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6668: 
 6669:                int kin = k;
 6670:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6671:                
 6672:                // Get the velocity at the neighbor's side.
 6673:                Vector2 nSideU2 = nSide->u2[kin];
 6674: 
 6675:                // Projects the velocity to the current side frame if needed.
 6676:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6677: 
 6678:                suru += nSideU2;
 6679:             }
 6680: 
 6681:             // Reusing bcc as a temporary array to store the suru values.
 6682:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6683: 
 6684:          }
 6685:       }
 6686:    }
 6687: 
 6688:    __global__ void shapiroFilter2(void) {
 6689:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6690: 
 6691:       SIDE(side);
 6692: 
 6693: 
 6694:       if (side->isDry || !(side->isInternal())) return;
 6695: 
 6696:       const int kb = side->kb;
 6697: 
 6698:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6699: 
 6700:       if (side->is2D()) {
 6701:          side->u2[kb + 1] = side->bcc[kb + 1];
 6702:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6703: 
 6704:       } else {
 6705:          // 3D
 6706:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6707:          
 6708:       }
 6709: 
 6710:    }
 6711: 
 6712: 
 6713:    __global__ void ul0UpdateZCoords(void) {
 6714:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6715:       
 6716:       NODE(node);      
 6717: 
 6718: 
 6719:       if (false) { //node->isDry) { XXXXXXX
 6720: 
 6721:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6722: 
 6723:          if constexpr(ivcor != 1) node->kb = 0;
 6724: 
 6725:       } else {
 6726: 
 6727:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6728:          node->updateKb();
 6729: 
 6730:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6731: 
 6732:       }
 6733: 
 6734:       // We use the temp.b field to store the previous state of isDry.
 6735:       node->tmp.b = node->isDry;
 6736: 
 6737:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6738:       node->isDry = true;
 6739: 
 6740:    }
 6741: 
 6742:    __global__ void ul0ComputeDryElements(void)
 6743:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6744:    {
 6745:       ELEM(elem);
 6746: 
 6747:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6748: 
 6749:       elem->kb = 0;
 6750: 
 6751:       if (elem->isDry) return;
 6752: 
 6753: 
 6754:    //    if(elem->isDry2()) { // XXXX
 6755:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6756:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6757:    //        call parallel_abort(errmsg)
 6758:    //    }
 6759: 
 6760:       const Node *n1 = elem->nodes[0];
 6761:       const Node *n2 = elem->nodes[1];
 6762:       const Node *n3 = elem->nodes[2];  
 6763:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6764: 
 6765:       // Computes element's kb as the minimum of the nodes' kb.
 6766:       const int kb1 = n1->kb;
 6767:       const int kb2 = n2->kb;
 6768:       const int kb3 = n3->kb;
 6769:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6770: 
 6771: 
 6772:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6773: 
 6774: 
 6775:       // Computes the element z as the mean of the nodes z.
 6776:       for (int k = elem->kb; k < nvrt; k++) {
 6777: 
 6778:          // Compute the element z as the mean of the nodes z.
 6779:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6780:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6781:          elem->z[k] /= elem->i34;
 6782: 
 6783:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6784:       }
 6785:                   
 6786:    }
 6787: 
 6788:    __global__ void ul0ComputeDryNodes(void)
 6789:    // Updates node's isDry based on the elements' isDry. 
 6790:    {
 6791:       NODE(node);
 6792: 
 6793:       node->isDry = true;
 6794: 
 6795:       // A node is wet if at least one of the elements sharing it is wet.
 6796:       for (int j = 0; j < node->numElements; j++) {
 6797:          const Element *elem = node->elements[j];
 6798:          if (!elem->isDry) {
 6799:             node->isDry = false;
 6800:             break;
 6801:          }
 6802:       }
 6803: 
 6804:        
 6805:    }
 6806: 
 6807: 
 6808:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6809:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6810:    // node->tmp.b is true if the node was previously dry.
 6811:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6812:    {
 6813:       NODE(node);
 6814:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6815: 
 6816:       // Avoid this the first time step.
 6817:       if (it == iths) return;  
 6818: 
 6819:       const bool wasDry = node->tmp.b;
 6820: 
 6821: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6822: 
 6823:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6824: 
 6825:          for (int k=0; k < nvrt; k++) {
 6826: 
 6827:             Vector3 utmp={0.0, 0.0, 0.0};
 6828: 
 6829:             double ttmp=0.0;
 6830:             double stmp=0.0;
 6831:             int icount=0;
 6832:             for (int j = 0; j < node->numNodes; j++) {
 6833: 
 6834:                const Node *nbrNode = node->nodes[j];
 6835:                
 6836:                const bool wasNbrDry = nbrNode->tmp.b;
 6837: 
 6838:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6839:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6840: 
 6841:                   icount++;
 6842: 
 6843:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6844:                   utmp += nbrNode->uvw2(k);
 6845:                   
 6846:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6847:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6848:                }
 6849:             }
 6850: 
 6851:             if (icount > 0) {
 6852:                const double inv_icount = 1.0/icount;
 6853:                utmp = inv_icount*utmp;
 6854:                node->u2[k]     = {utmp.x, utmp.y};
 6855:                node->w2[k]     = utmp.z;
 6856:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6857:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6858:             } else {
 6859:                node->u2[k] = {0.0, 0.0};
 6860:                node->w2[k] = 0.0;
 6861:                // Initialize tracers to 0.0??? XXXXX
 6862:             }
 6863:          }
 6864:       }
 6865:    }
 6866: 
 6867:   
 6868:    
 6869: 
 6870: 
 6871:    __global__ void ul0UpdateSides(int it, int iths) {
 6872:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6873:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6874:    // The dryness of the sides is updated in ul0UpdateSides2.
 6875: 
 6876:       SIDE(side);
 6877: 
 6878:       // A side is wet if and only if at least one of its elements is wet.
 6879:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6880:  
 6881:       const Node *n1 = side->n1;
 6882:       const Node *n2 = side->n2;
 6883:      
 6884:       const int kb1 = n1->kb;
 6885:       const int kb2 = n2->kb;
 6886: 
 6887:       side->kb = 0; // default when dry
 6888: 
 6889:       if (isWet) {
 6890: 
 6891:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6892: 
 6893:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6894: 
 6895:          side->kb = min(kb1, kb2);
 6896: 
 6897:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6898: 
 6899:          for (int k = side->kb; k < nvrt; k++) {
 6900:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6901: 
 6902:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6903: 
 6904:             // Compute velocity for re-wetted sides 
 6905:             if ((it != iths) && (side->isDry && isWet)) {
 6906: 
 6907:                Vector2 utmp={0.0, 0.0};
 6908: 
 6909:                int icount=0;
 6910: 
 6911:                // For all the sides on the two elements that share this side
 6912:                for (int j = 0; j < 2; j++) {
 6913:                   const Element *elem = side->elems[j];
 6914:                   if (elem == nullptr) continue;
 6915: 
 6916:                   for (int jj=0; jj < elem->i34; jj++) {
 6917:                      const Side *nSide = elem->sides[jj];
 6918:                      if (nSide->isDry) continue;
 6919: 
 6920:                      icount++;
 6921:                      utmp += nSide->u2[k];  
 6922:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6923:                   }
 6924:                }
 6925:                   
 6926:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6927:                if (icount > 0)  side->u2[k] = utmp/icount;
 6928:                else             side->u2[k] = {0.0, 0.0};
 6929:                   
 6930:             } // if ((it != iths) && (side->isDry && isWet))
 6931: 
 6932:          } // for k
 6933: 
 6934:       } // if isWet 
 6935:       
 6936: 
 6937: 
 6938:    }
 6939: 
 6940:    __global__ void ul0UpdateSides2(void) {
 6941:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6942:    
 6943:          SIDE(side);
 6944:    
 6945:          const Element *e1 = side->elems[0];
 6946:          const Element *e2 = side->elems[1];
 6947: 
 6948:          // A side is wet if and only if at least one of its elements is wet.
 6949:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6950: 
 6951:          // Update the side's dryness
 6952:          side->isDry = !isWet;
 6953: 
 6954:    }
 6955: 
 6956: 
 6957:    __global__ void zeroNodalVelocities(void) {
 6958:       NODE(node);
 6959: 
 6960:       for (int k = 0; k < nvrt; k++) {
 6961:          node->u2[k]   = {0.0, 0.0};
 6962:          node->w2[k]   = 0.0;
 6963:          node->utmp[k] = {0.0, 0.0};         
 6964:       }
 6965:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6966:    }
 6967:  
 6968: 
 6969:    __global__ void computeNodalVerticalVelocities1(void) {
 6970:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6971:    // Adds the element's vertical velocity times the element's area.
 6972:       ELEM(elem);
 6973: 
 6974:       for (int j = 0; j < elem->i34; j++) {
 6975:          Node *node = elem->nodes[j];
 6976: 
 6977:          for (int k = node->kb; k < nvrt; k++) {
 6978:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6979:          }
 6980:          atomicAdd(&(node->tmp.d), elem->area);
 6981:       }
 6982:    }
 6983: 
 6984:    __global__ void computeNodalVerticalVelocities2(void) {
 6985:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6986:    // Divides by the total area of the elements sharing the    node.
 6987:       NODE(node);
 6988: 
 6989: 
 6990:       const double invArea = 1.0 / node->tmp.d;
 6991:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6992: 
 6993:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6994:    }
 6995: 
 6996: 
 6997:    __global__ void computeNodalHorizontalVelocities1(void) {
 6998: 
 6999:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7000: 
 7001:       ELEM(elem);
 7002: 
 7003:       if (elem->isDry) return;
 7004: 
 7005:       const int kb = elem->kb;
 7006:       const bool isTri = elem->isTri();
 7007: 
 7008:       if constexpr(indvel <= 0) {
 7009:          // Assuming discontinous hvel.
 7010: 
 7011:          if (isTri) { // For triangles
 7012:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7013:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7014:             #pragma unroll
 7015:             for (int j = 0; j < 3; j++) {
 7016:                // For every node of the triangle...
 7017:                Node *node = elem->nodes[j];
 7018: 
 7019:                if (node->isDry) continue;
 7020: 
 7021:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7022:                const Side *s2 = elem->sides[(j + 1) % 3];
 7023:                const Side *s3 = elem->sides[(j + 2) % 3];
 7024: 
 7025:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7026: 
 7027:                atomicAdd(&(node->tmp.i), 1);
 7028: 
 7029:                for (int k = kb; k < nvrt; k++)  {
 7030:                   Vector2 s1u2 = s1->u2[k];
 7031:                   Vector2 s2u2 = s2->u2[k];
 7032:                   Vector2 s3u2 = s3->u2[k];
 7033: 
 7034:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7035:                   if constexpr(ics == 2) {
 7036:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7037:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7038:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7039:                   }
 7040: 
 7041:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7042:                   u = clampVelocity(u);
 7043:                   atomicAdd(&(node->utmp[k].x), u.x);
 7044:                   atomicAdd(&(node->utmp[k].y), u.y);
 7045: 
 7046:                }
 7047: 
 7048:             }
 7049:          }
 7050:          else { // For quads
 7051: 
 7052: 
 7053:             // Compute the bilinear coordinates of the center of each diagonal.
 7054:             double xi, eta;
 7055:             double shp13[4], shp24[4];
 7056:             Point2 x0, x1, x2, x3;
 7057:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7058:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7059:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7060:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7061:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7062: 
 7063:             
 7064:             for (int k = kb; k < nvrt; k++) {
 7065: 
 7066:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7067:                Vector2 sideU[4];
 7068:                #pragma unroll
 7069:                for (int j = 0; j < 4; j++) {
 7070:                   Vector2 u = elem->sides[j]->u2[k];
 7071:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7072:                   sideU[j] = u;
 7073:                }
 7074: 
 7075:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7076:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7077: 
 7078:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7079:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7080:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7081:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7082:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7083:                #pragma unroll
 7084:                for (int j = 0; j < 4; j++) {
 7085:                   Node *node = elem->nodes[j];
 7086:                   if (node->isDry) continue;
 7087: 
 7088:                   atomicAdd(&(node->tmp.i), 1);
 7089:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7090:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7091:                }
 7092:             }
 7093: 
 7094:          }
 7095: 
 7096:       }
 7097:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7098:       
 7099:    }
 7100: 
 7101: 
 7102:    __global__ void computeNodalHorizontalVelocities2(void) {
 7103:       NODE(node);
 7104: 
 7105:       const int nodeCount = node->tmp.i;
 7106: 
 7107:       if (nodeCount == 0) 
 7108:       {
 7109:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7110:          return;
 7111:       }
 7112: 
 7113:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7114:       
 7115:       const int kb = node->kb;
 7116: 
 7117:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7118:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7119:       
 7120:       
 7121:    }   
 7122: 
 7123:  
 7124: 
 7125:    __global__ void resetVelocityOpenBndNodes(void) {
 7126:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7127: 
 7128:       NODE_BND(nodebnd);
 7129: printf("DDDDDDDDDD\n");
 7130:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7131:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7132:       }
 7133: 
 7134:    }
 7135: 
 7136: 
 7137:    __global__ void setVelocityOpenBndNodes(void) {
 7138:    // For open boundary nodes sets their velocity to the imposed values.
 7139: 
 7140:       SIDE_BND(sidebnd);
 7141: 
 7142:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7143:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7144:          // to its segment to the average of the side velocity.
 7145: 
 7146:          for (int k = 0; k < nvrt; k++) {
 7147:             Node *n1 = sidebnd->side->n1;
 7148:             Node *n2 = sidebnd->side->n2;
 7149: 
 7150: 
 7151:             Vector2 n1_u2(n1->u2[k]);
 7152:             Vector2 n2_u2(n2->u2[k]);
 7153: 
 7154:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7155:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7156:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7157:             }
 7158:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7159:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7160:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7161:             }
 7162: 
 7163:          }
 7164: 
 7165:       }
 7166: 
 7167:    }
 7168: 
 7169: 
 7170:    __global__ void computeVerticalVelocity(void) {
 7171:       // Computes the vertical velocity at the (2D) element's centroid.
 7172:       // In this function we will be considering volumetric elements, with side faces and a 
 7173:       // bottom and a top face. We will call them SFs, BF and TF.
 7174:       // It computes the flux coming from BF and the SFs.
 7175:       // If the bed is moving, it takes that into account.
 7176:       // Since water is incompressible, the integral of the velocity times the normal vector
 7177:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7178:       // and the BF is equal to the flux going out from the TF.
 7179:       // TF = - BF - sum(SFs).
 7180:       // It then computes the horizontal velocity at the center of TF.
 7181:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7182:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7183:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7184: 
 7185:       ELEM(elem);
 7186: 
 7187:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7188: 
 7189:       if (elem->isDry) return;
 7190: 
 7191:       const int kb = elem->kb;
 7192:       const bool isTri = elem->isTri();
 7193: 
 7194:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7195: 
 7196:       // Compute the bottom velocity
 7197:       if constexpr(imm != 0) {
 7198:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7199:       }
 7200: 
 7201: 
 7202:       double bottomArea3D;
 7203:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7204: 
 7205:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7206: 
 7207:       double topArea3D;
 7208: 
 7209:       // Bottom face flux
 7210:       double bottomFlux = 0.0;
 7211:       Vector2 u2meanBottom = {0.0, 0.0};
 7212:       const Vector2 gradh = elem->grad2(&Node::depth);
 7213:       if constexpr(imm==2) {
 7214:          Vector3 ubed;
 7215: 
 7216:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7217:          // updateBDEF(ubed);
 7218:      
 7219:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7220: 
 7221:          // elem->w[kb] += ubed.z;
 7222:       }
 7223:       else {
 7224: 
 7225:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7226:   
 7227:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7228:          // in the direction of motion.
 7229:          const double bottomW = - dot(gradh, u2meanBottom);  
 7230:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7231: 
 7232:          // VElocity associated to the bed deformation
 7233:          double bedVelocity = 0.0;
 7234:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7235: 
 7236:          elem->w[kb] = bedVelocity + bottomW; 
 7237: 
 7238:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7239:          
 7240:       } // if imm
 7241: 
 7242:       // Compute w for kb+1 to nvrt-1
 7243:       for (int l = kb; l < nvrt - 1; l++) {
 7244: 
 7245:          // normal vector to the top face of the "volumetric" element (3D)
 7246:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7247: 
 7248:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7249:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7250: 
 7251:          // Compute the total flux at the sides
 7252:          double sideFlux = 0.0;
 7253: 
 7254:          for (int j = 0; j < elem->i34; j++) {
 7255:             const Side *side = elem->sides[j];
 7256:             const int kbs = side->kb;
 7257:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7258:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7259:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7260: 
 7261:             // The area is "clamped" meaning that it takes kb into account.
 7262:             const double sideArea = side->areaClamped(l);
 7263: 
 7264:             const double sign = elem->ssign[j]; 
 7265: 
 7266:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7267:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7268:          }
 7269:          
 7270:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7271:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7272:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7273: 
 7274:          // The flux at the top ace can be computed from the other flows.
 7275:          // All fluxes are in directions into the prism.
 7276:          const double topFlux = - sideFlux - bottomFlux;
 7277: 
 7278:          // Flux at the top face due to the horizontal velocities only
 7279:          // topFlux = topHorizontalFlux + topVerticalFlux
 7280:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7281: 
 7282:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7283:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7284: 
 7285:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7286: 
 7287:          bottomFlux = -topFlux;
 7288:          
 7289:       }
 7290: 
 7291:    }  
 7292: 
 7293: 
 7294: 
 7295: 
 7296: 
 7297: 
 7298: 
 7299: // !===============================================================================
 7300: // !===============================================================================
 7301: 
 7302: } // extern "C"
 7303: 
 7304: #ifdef DONTCOMPILE
 7305: __device__ void computeVerticalAdvection(void) {
 7306:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7307: 
 7308:    sdbt(1:2,:,:)=0.d0
 7309: 
 7310:    const Side *side = FROM kernel;
 7311: 
 7312:    if(side->isDry) return;
 7313: 
 7314:    // If side is wet...
 7315: 
 7316: 
 7317:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7318:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7319:    double ws[nvrt] = {} // w @ side
 7320:    int icount = 0;
 7321:    for (int j=0; j<2; j++) {
 7322:       const Element *elem = side->elements[j];
 7323:        
 7324:       if(elem != nullptr) {
 7325:          icount++;
 7326:          for (int k=0; k<nvrt; k++) {
 7327:             ws[k] = ws[k] + elem->w[k];
 7328:          }
 7329:       }
 7330:    }  // for j
 7331: 
 7332:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7333:    ws = ws/icount;
 7334: 
 7335:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7336:    // Splines allow for a smooth transition between vertical levels.
 7337:    // Splines have continuity restrictions at the internal knots, but
 7338:    // we have to provide the 1st derivatives at the endpoints.
 7339:    const int kbs = side->kbs; 
 7340:    
 7341:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7342:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7343:    initCubicSpline(kbs, nvrt, side, ws, up)
 7344: 
 7345:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7346:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7347:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7348: 
 7349:    // Total advection (average onto side)
 7350:    const Node *node1 = side->nodes[0];
 7351:    const Node *node2 = side->nodes[1];
 7352:    for (int k=kbs(i); k<nvrt; k++) {
 7353: 
 7354:       Vector2 bcc1 = node1->bcc[k];
 7355:       Vector2 bcc2 = node2->bcc[k];
 7356:       if constexpr(ics == 2) {
 7357:          // Project the velocities from the node frames to the side frame
 7358:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7359:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7360:       }
 7361: 
 7362:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7363:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7364: 
 7365:    }
 7366: }
 7367: #endif
 7368: 
 7369: 
 7370: extern "C" {
 7371:    __global__ void computeElemAverageGhat(void) {
 7372:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7373: 
 7374:       ELEM(elem);
 7375:       
 7376:       elem->ghat1= {0.0, 0.0};  
 7377: 
 7378:       if constexpr(ihydraulics != 0) {
 7379:          if (nhtblocks > 0 && elem->isblock) return;
 7380:       }
 7381: 
 7382:       
 7383:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7384:       // cff1-3: coefficients for 2D/3D
 7385: 
 7386:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7387:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7388:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7389: 
 7390:       if (elem->isDry) return;
 7391: 
 7392:       // Average of the coefficients
 7393:       double av_cff1 = 0.0;  // av. for cff1
 7394:       double av_cff2 = 0.0;  // av. for cff2
 7395:       double av_cff3 = 0.0;  // av. for cff3
 7396:       double av_df = 0.0;  // av. for H^\alpha / H
 7397:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7398:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7399: 
 7400:       const int i34 = elem->i34;
 7401:       const int kb  = elem->kb;
 7402: 
 7403:       for (int j=0; j<i34; j++) {
 7404:          // For each node and side in the element...
 7405: 
 7406:          const Node *node = elem->nodes[j];
 7407:          const Side *side = elem->sides[j];
 7408: 
 7409:          const double chi      = side->chi;
 7410:          const double veg_c2   = side->veg_c2;
 7411:          const double veg_beta = side->veg_beta;
 7412:          const double veg_h    = side->veg_h();
 7413:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7414: 
 7415:          const Vector2 gradPhi = elem->gradPhi[j];
 7416: 
 7417:          // Node - const in elem
 7418:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7419:          elem->gradPr  += node->pr  *gradPhi;
 7420: 
 7421:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7422: 
 7423:         
 7424:          const double htot  = side->htot2();        // Total depth at the side
 7425:          const double zctr2 = side->zTopCanopy();  
 7426: 
 7427:          double cff1; 
 7428:          double cff2; 
 7429:          double cff3;   
 7430:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7431:          // coefficients applied to 2D/3D case 
 7432:             cff1 = side->hhat/htot;
 7433:             cff2 = 0.0;
 7434:             cff3 = 0.0;
 7435:          } else { //3D
 7436:             //Init for no-veg case
 7437:             cff1 = 1.0;
 7438:             cff2 = 1.0;
 7439:             cff3 = 0.0;
 7440: 
 7441:             if constexpr(iveg != 0) {
 7442:                // Computes coefficients used with vegetation terms G1, G2
 7443:                // cff1, cff3 are used for the first two terms in G1, G2:
 7444:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7445:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7446:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7447:                if(veg_h < 0.99*htot) { // submergent vegetation
 7448:                   cff1 = 1.0;
 7449:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7450:                   cff3 = veg_c;
 7451: 
 7452:                } else { // emergent vegetation
 7453:                   cff1 = 1.0/(1.0 + veg_c2);
 7454:                   cff2 = cff1;
 7455:                   cff3 = 0.0;
 7456: 
 7457:                }
 7458:             } // if iveg
 7459:          } //  2D/3D
 7460: 
 7461:          av_cff1 += cff1/i34;
 7462:          av_cff2 += cff2/i34;
 7463:          av_cff3 += cff3/i34;
 7464:          av_cff2_chi += cff2*chi/i34;
 7465:          av_cff3_chi += cff3*chi/i34;
 7466:          av_df += min(htot, veg_h)/(htot*i34);
 7467: 
 7468: 
 7469:          // btrack values: U^\star, U^{\star\alpha}
 7470:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7471:          Vector2 Ustar       = {0.0, 0.0}; 
 7472:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7473: 
 7474:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7475:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7476:          } else { //3D
 7477:             for (int k = side->kb + 1; k < nvrt; k++) {
 7478:             
 7479:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7480:                Ustar += w2;
 7481: 
 7482:                if constexpr(iveg != 0) {
 7483:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7484:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7485:                        Ustar_alpha += zrat*w2; // XXXX
 7486:                    }
 7487:                }  // if iveg
 7488:             }  // for k
 7489:          }  //2D/3D
 7490: 
 7491:          // If needed, project the side velocities to the element frame
 7492:          if constexpr(ics==2) {
 7493:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7494:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7495:          }
 7496:         
 7497: 
 7498:          // Add btrack & surface stress terms to \breve{G} first
 7499:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7500: 
 7501: 
 7502:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7503:          Vector2 tau    = side->tau();  
 7504:          Vector2 ubstar = side->btu[side->kb + 1];  
 7505: 
 7506:          // If needed, project tau and ubstar to the element frame
 7507:          if constexpr(ics==2) {
 7508:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7509:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7510:          }
 7511: 
 7512:          // Term for surface and bottom stress
 7513:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7514: 
 7515: 
 7516:          // All terms in F,F^\alpha,f_b except baroclinic
 7517:          // F, f_b: all explicit terms excluding vegetation 
 7518:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7519:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7520:          const double coriolis = side->coriolis;
 7521:          Vector2 F  =  coriolis*side->U;  // F_x
 7522:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7523:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7524: 
 7525:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7526:             
 7527:             for (int k = side->kb; k < nvrt; k++) {
 7528:                if (zctr2 > side->zc[k-1]) {
 7529:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7530:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7531:                    Fa +=  coriolis*w2*zrat;
 7532:                } // if zctr2
 7533:             } // k
 7534:          } // iveg
 7535: 
 7536:          // Integrate horizontal viscosity force vertically
 7537:          for (int k=side->kb + 1; k<nvrt; k++) {
 7538:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7539: 
 7540:             F += levelHorVisc;
 7541: 
 7542:             // Vegetation term
 7543:             if constexpr(iveg!=0) {
 7544:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7545:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7546:                   Fa += levelHorVisc*zrat;
 7547:                } 
 7548:             } // if iveg
 7549:          } // for k
 7550: 
 7551:          // Get nu*grad(U) at the side's bottom level
 7552:          Vector2 nuGradU = side->nuGradU[side->kb];
 7553: 
 7554:          fb += nuGradU;
 7555: 
 7556:          // If needed, project vectorsF, fb and Fa to the element frame
 7557:          if constexpr(ics==2) {
 7558:             F    = side->frame.projHorVec(F,    elem->frame);
 7559:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7560:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7561:          } // if ics
 7562: 
 7563:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7564:       } // for j (nodes and sides)
 7565: 
 7566:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7567: 
 7568: 
 7569:       // Finish off terms in F, F^\alpha and f_b
 7570:       const double grav3 = elem->mean(&Node::grav2);
 7571:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7572:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7573:       for (int j=0; j<i34; j++) { 
 7574:          // For each side in the element...
 7575:          const Side *side = elem->sides[j];
 7576:          const double chi = side->chi;
 7577: 
 7578:          const double htot = side->htot2();
 7579:          const double veg_h = side->veg_h();
 7580:          const Vector2 F  = htot*fb;
 7581:          const Vector2 Fa = min(htot, veg_h)*fb;
 7582: 
 7583:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7584:       } // for j
 7585: 
 7586:       // tmp is already in elem frame
 7587:       elem->ghat1 += tmp/i34;
 7588: 
 7589:       // Baroclinic force
 7590:       if constexpr(ibc==0) {
 7591:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7592: 
 7593:          Vector2 Fa = {0.0, 0.0};
 7594:          Vector2 intGradRho = {0.0, 0.0};
 7595:          
 7596:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7597:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7598:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7599: 
 7600:             // \in F [m^2/s/s]
 7601:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7602:          }
 7603: 
 7604:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7605:          const Vector2 F = av_df*Fa; //approx
 7606:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7607: 
 7608:       } // if ibc
 7609: 
 7610: 
 7611: 
 7612:    }
 7613: 
 7614: } // extern "C"
 7615: 
 7616: 
 7617: 
 7618: #ifdef DONTCOMPILE
 7619: __global__ void checkMassConservation(Tracers* sumtr) {
 7620: 
 7621:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7622: 
 7623:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7624: 
 7625:    Element *elem = &(mesh->localElemData[i]);
 7626: 
 7627:    // Skip dry elements
 7628:    if (elem->isDry) return;
 7629: 
 7630:    // Local sum array for this thread
 7631:    double localSum[N_TRACERS] = {0.0};
 7632: 
 7633:    // Sum over vertical levels for this element
 7634:    const int kbe = elem->kbe;
 7635:    const double area = elem->area;
 7636: 
 7637:    for (int k = kbe; k < nvrt; k++) {
 7638:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7639:       
 7640:       // Accumulate tracer mass
 7641:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7642:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7643:       }
 7644:    }
 7645: 
 7646:    //  This function returns per element sums. A reduction must be done on the host side.
 7647: }
 7648: 
 7649: 
 7650: __global__ void transport(void) {
 7651: 
 7652:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7653: 
 7654:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7655: 
 7656:    Element *elem = &(mesh->localElemData[ie]);
 7657: 
 7658:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7659: 
 7660:                for (int m=0; m<ntr; m++) {
 7661:                   for (int k=kbe(ie); k<nvrt; k++) {
 7662:                      // Calculate each polynomial's weight 
 7663:                      wm=0.d0; sum1=0.d0; 
 7664:                      wm1=0.d0; wm2=0.d0; 
 7665:                      for (int i=0; i<elem->nweno2; i++) {
 7666:                   
 7667:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7668:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7669:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7670:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7671:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7672:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7673:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7674:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7675:                      // -----------------Hu and Shu (1999)'s method----------------
 7676:                      b4=b1+b2+b3
 7677: 
 7678: //Error: add PRODUCTION CPP
 7679: #ifdef DEBUG
 7680:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7681:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7682:                     call parallel_abort(errmsg)
 7683:                   }
 7684: #endif
 7685: 
 7686:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7687:                   // !----test-------------- 
 7688:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7689:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7690:                   // !wm(i)=wm1(i)*wm2(i)
 7691:                   // !---------------------- 
 7692:                   sum1=sum1+wm(i)
 7693:                 } // end for i
 7694: 
 7695:                 wm=wm/sum1
 7696: 
 7697:                 for (int j=0; j<elem->i34; j++) {
 7698: 
 7699:                   const Side *side  = elem->sides[j];
 7700:                   const Node *node1 = side->n1;
 7701:                   const Node *node2 = side->n2;
 7702: 
 7703:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7704:                      trsd=0.d0
 7705:                      for (int kk=0; kk<nquad; kk++) {
 7706:                         for (int i=0; i<elem->nweno2; i++) {
 7707:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7708:                         } // end for i   
 7709:                      } // end for kk
 7710:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7711:                   } // outward flux
 7712:                } // end for j=1,i34(ie) ! side
 7713:             }
 7714:          }
