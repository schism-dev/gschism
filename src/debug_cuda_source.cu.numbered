 3777: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3778:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3779:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3780:    // 
 3781:    // This kernel is called for all nodes.
 3782: 
 3783: 
 3784:    NODE(node1);
 3785: 
 3786: 
 3787:    node1->clearMatrixRow();
 3788:    node1->qel = 0.0;
 3789: 
 3790:    // THIS IS FOR STRUCTURES XXX
 3791:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3792: 
 3793:    
 3794:    for (int j=0; j<node1->numElements; j++) {
 3795:       // For each element connected to the node...
 3796: 
 3797:       Element *elem = node1->elements[j];
 3798: 
 3799:       // Compute the average gravity
 3800:       const double grav3 = elem->mean(&Node::grav2);
 3801: 
 3802:       // Look at the documentation for the description of the terms in the following integrals
 3803: 
 3804:       // Integral I_1 
 3805:       // \bar{\breve{H}} 
 3806:       const double hhatb = elem->mean(&Side::hhat);        
 3807: 
 3808:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3809: 
 3810:       const int id1 = elem->nodeLocalIdx(node1); 
 3811:       const double area = elem->area;
 3812: 
 3813:       if (elem->isTri()) {
 3814: 
 3815:          // To clarify the notation in this section: 
 3816:          //   i stands for the node under consideration (node1)
 3817:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3818:          const int id2 = elem->nxq(1 + id1);
 3819:          const int id3 = elem->nxq(2 + id1);
 3820:          Node *node2 = elem->nodes[id2];
 3821:          Node *node3 = elem->nodes[id3];
 3822: 
 3823:          const Point2 x1 = node1->p2();
 3824:          const Point2 x2 = node2->p2();
 3825:          const Point2 x3 = node3->p2();
 3826: 
 3827:          // integral of phi_i*phi_j
 3828:          const double ipp_ii = (1.0/6.0 )*area;
 3829:          const double ipp_ij = (1.0/12.0)*area;
 3830:          const double ipp_ik = (1.0/12.0)*area;
 3831: 
 3832:          // integral of [(grad phi_i) * (grad phi_j)]
 3833:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3834:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3835:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3836: 
 3837:          // Computes the different components of integral I_1 of each node with respect to node i.
 3838:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3839:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3840:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3841: 
 3842:          node1->addToSparseMatrix(node1, I1_ii);
 3843:          node1->addToSparseMatrix(node2, I1_ij); 
 3844:          node1->addToSparseMatrix(node3, I1_ik);
 3845: 
 3846:       }
 3847:       else { // Quad
 3848:          // XXX IMPLEMENT THIS
 3849:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3850: 
 3851:          // To clarify the notation in this section: 
 3852:          //   i stands for the node under consideration (node1)
 3853:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3854:          const int id2 = elem->nxq(1 + id1);
 3855:          const int id3 = elem->nxq(2 + id1);
 3856:          const int id4 = elem->nxq(3 + id1);
 3857:          Node *node2 = elem->nodes[id2];
 3858:          Node *node3 = elem->nodes[id3];
 3859:          Node *node4 = elem->nodes[id4];         
 3860: 
 3861:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3862:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3863:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3864:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3865:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3866: 
 3867:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3868:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3869:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3870:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3871:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3872: 
 3873:          // Computes the different components of integral I_1 of each node with respect to node i.
 3874:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3875:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3876:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3877:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3878: 
 3879:          node1->addToSparseMatrix(node1, I1_ii);
 3880:          node1->addToSparseMatrix(node2, I1_ij); 
 3881:          node1->addToSparseMatrix(node3, I1_ik);
 3882:          node1->addToSparseMatrix(node4, I1_il);
 3883:   
 3884: 
 3885: 
 3886:       
 3887:       } 
 3888: 
 3889:  
 3890:       // Integral I_4
 3891:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3892:       // Where
 3893:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3894: 
 3895:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3896:       // of U over the element.
 3897:       Vector2 Umean = {0.0, 0.0};
 3898:       for (int m=0; m<elem->i34; m++) {      
 3899:          const Side *side = elem->sides[m];
 3900: 
 3901:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3902:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3903:       }
 3904:       Umean = Umean/elem->i34;
 3905: 
 3906:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3907: 
 3908:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3909:       const double I_4_1 = dot(gradPhi_1, Umean);
 3910: 
 3911:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3912:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3913:      
 3914:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3915: 
 3916:       // Additional terms 
 3917:       double vnorm = 0.0;
 3918:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3919:          Vector3 ubed;
 3920:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3921: 
 3922:          Vector3 gradP = {0.0, 0.0, 1.0};
 3923:          for (int m=0; m < elem->i34; m++) {
 3924:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3925:            gradP += toVector3(gradP_2D, 0.0);
 3926:          }   
 3927:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3928:       } // imm==2
 3929: 
 3930:       if (elem->isTri()) {
 3931:          for (int l=0; l<3; l++) {
 3932:             double fac;
 3933: 
 3934:             Node *node = elem->nodes[l];
 3935: 
 3936:             fac = (node == node1) ? 2.0 : 1.0;
 3937:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3938:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3939: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3940:            
 3941:          }
 3942: 
 3943: 
 3944:          if (!elem->isDry) {
 3945:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3946: 
 3947:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3948: 
 3949:          }
 3950: 
 3951:       } // isTri
 3952:       else { // isQuad
 3953:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3954:          // for (int l=0; l<4; l++) {
 3955:          //   const Node *node = elem->nodes[l];
 3956: 
 3957:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3958:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3959: 
 3960:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3961:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3962:          // }
 3963: 
 3964:       } // isQuad
 3965: 
 3966: 
 3967:      node1->qel += (dt/elem->i34)*elem->vsource;
 3968:       
 3969: 
 3970:    } // for all elements connected to the node
 3971:    
 3972: 
 3973:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3974:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3975:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3976:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3977:       // If it is an open boundary node...
 3978: 
 3979:       // At least one open bnd side, maybe two
 3980:       for (int l=0; l<2; l++) { 
 3981: 
 3982:          // Gets each of the sides sharing the node. 
 3983:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3984: 
 3985:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3986:          
 3987: 
 3988:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3989:          if (sideBnd != nullptr) {
 3990:             // If the side is on a boundary...
 3991: 
 3992:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3993: 
 3994:             // Get the boundary segment
 3995:             const BoundarySegment *sideSegment = sideBnd->segment;
 3996:             const Side *side = sideBnd->side;
 3997: 
 3998:             // Integral I_3
 3999:             if (sideSegment->ifltype != 0) {
 4000:             // Natural or Flather b.c.
 4001: 
 4002:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4003:                // especially for Flather b.c.
 4004:                double ri3 = 0.0;
 4005:                if (!side->isDry) {
 4006:                   // If the side is not dry
 4007:                   
 4008:                   // Computes the side flux of (uth, vth)
 4009:                   double Vn = 0.0;
 4010:                   for (int k = side->kb; k<nvrt-1; k++) {
 4011:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4012:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4013: 
 4014:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 4015:                   }
 4016: 
 4017:                   ri3 = 0.5*side->len*Vn;
 4018:                }
 4019: 
 4020:                if (sideSegment->ifltype == -1) { // Flather 1
 4021: 
 4022:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4023:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4024: 
 4025:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4026:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4027:                   
 4028:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4029:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4030: 
 4031:                } 
 4032:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4033:                   // Reset ri3
 4034:                   ri3 = 0.0;
 4035: 
 4036:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4037: 
 4038:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4039: 
 4040:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4041:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4042: 
 4043:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4044:                   node1->addToSparseMatrix(node1, con0*2.0);
 4045:                   node1->addToSparseMatrix(node2, con0);
 4046: 
 4047:                } // if Flather or Discharge
 4048: 
 4049: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 4050:                node1->qel -= thetai*dt*ri3;
 4051: 
 4052: 
 4053:             } // I_3
 4054:           
 4055: 
 4056:             // Integral I_5
 4057:             if(!side->isDry) {
 4058: 
 4059:                const double Unbar = dot(side->U, side->n);
 4060:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4061: 
 4062:             } // I_5
 4063: 
 4064:          } // if is boundary side
 4065: 
 4066:       } // for l
 4067: 
 4068:    } // if isbnd
 4069: 
 4070: 
 4071: }
 4072: 
 4073: 
 4074: 
 4075: extern "C" {
 4076:    __global__ void rollUpElevation(void) {
 4077: 
 4078:       NODE(node);
 4079: 
 4080:       node->eta1 = node->eta2;
 4081: 
 4082:    }
 4083: 
 4084: 
 4085:    __global__ void backtrackAllNodes(void) {
 4086: 
 4087:       // max/min # of sub-divisions
 4088:       const int ndelt_max = max(1.0, dt/dtb_min);
 4089:       const int ndelt_min = max(1.0, dt/dtb_max); 
 4090: 
 4091:       // Removed all references to swild98 XXX
 4092:       // swild98=0.d0 !init
 4093: 
 4094: 
 4095:       SIDE(side);
 4096: 
 4097:       const int kb = side->kb;
 4098: 
 4099: 
 4100:       // Initialize btrack velocities to the actual velocities at the side 
 4101:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4102: 
 4103:       if (side->isDry) return;
 4104: 
 4105: 
 4106:       // Checks that at least one element is not dry
 4107:       const Element *elem1 = side->elems[0];
 4108:       const Element *elem2 = side->elems[1];
 4109: 
 4110: 
 4111:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4112:       
 4113:       // XXXXXX
 4114:       // !swild_tmp to store global coord. of the starting side
 4115:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4116:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4117:       // !Use sframe2 
 4118:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4119: 
 4120: 
 4121:       for (int k = kb; k < nvrt; k++) {
 4122:       //  Initialize (xt,yt,zt), nnel and vel.
 4123:       //  For ics=2, the coordinates are in local frames
 4124:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4125: 
 4126: 
 4127:          const int iadvf = side->iadv();  // Advection flag
 4128: 
 4129:          Point3 xt;
 4130:          if constexpr(ics==1) {
 4131:             xt = side->center3D(k); 
 4132:          }
 4133:          else // lat/lon; in side lat/lon frame
 4134:          {
 4135:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4136:          // XXX IMPLEMENT THIS
 4137:       //          xt=0.d0
 4138:       //          yt=0.d0
 4139:       //          !centroid coord. for nudging
 4140:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4141:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4142:          }  // ics
 4143: 
 4144: 
 4145: 
 4146:          // If on land or open boundary...
 4147:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4148:          
 4149:          const double vmag = length(side->u2[k]);
 4150: 
 4151:          if (vmag <= velmin_btrack) {
 4152:             // No activity 
 4153: 
 4154:             side->btu[k] = side->u2[k];
 4155:             
 4156:          } else {  // do btrack
 4157: 
 4158:             // Compute number of sub-divisions based on local gradients 
 4159:             // XXX IS THIS NECESSARY?
 4160:             double suma = 0.0;
 4161:             int icount = 0;
 4162:             for (int ii=0; ii<2; ii++) {
 4163: 
 4164:                const Element *elem = side->elems[ii];
 4165:                  
 4166:                if (elem == nullptr) continue;
 4167: 
 4168:                icount++;
 4169: 
 4170:                // Not strictly along z; in ll frame for ics=2
 4171: 
 4172:                double utmp[4];
 4173:                double vtmp[4];
 4174:                for (int jj = 0; jj < elem->i34; jj++) {
 4175: 
 4176:                   const Node *node = elem->nodes[jj];
 4177: 
 4178:                   if constexpr(ics==1) {
 4179:                      utmp[jj] = node->u2[k].x;
 4180:                      vtmp[jj] = node->u2[k].y;  
 4181:                   } else {
 4182:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4183:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 4184:                   }
 4185:                } // for jj
 4186: 
 4187:                const Vector2 grad_u = elem->grad2(utmp); 
 4188:                const Vector2 grad_v = elem->grad2(vtmp);
 4189: 
 4190:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4191:             } // for ii
 4192: 
 4193:             assert(icount > 0 && "Impossible 77");
 4194: 
 4195:             // '4' is somewhat arbitrary
 4196:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4197: 
 4198:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4199:          
 4200: 
 4201:             Vector3 u_int = {0.0, 0.0, 0.0};
 4202: 
 4203:             side->btrack(k, dt, dtbk, u_int);
 4204:             side->btu[k] = toVector2(u_int);
 4205:                
 4206:          } // if vmag (do backtrack)
 4207: 
 4208:       } // for k=kb,nvrt-1
 4209: 
 4210:    }
 4211: 
 4212: } // extern "C"
 4213: 
 4214: template<int nc>
 4215: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4216: 
 4217: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4218: //
 4219: // a,b,c,rhs: input vectors and are not modified by this program.
 4220: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4221: // rhs is the r.h.s.
 4222: // n: actual rank of the system.
 4223: // rows in u() and rhs();
 4224: // u: output with nc columns (transposed to rows)
 4225: // gam: a working array.
 4226: //
 4227: // NOTES:
 4228: // This is a template function that allows for different numbers of columns in the rhs vector.
 4229: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4230: 
 4231:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4232:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4233: 
 4234:    double bet = b[0];
 4235:    if constexpr (nc == 1) {
 4236:       u[0] = rhs[0]/bet;
 4237:    } else {
 4238:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4239:    }
 4240: 
 4241:    for (int j = 1; j < n; j++) {
 4242:       gam[j] = c[j - 1]/bet;
 4243:       bet = b[j] - a[j]*gam[j];
 4244: 
 4245:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4246: 
 4247:       if constexpr (nc == 1) {
 4248:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4249:       } else {
 4250:          for (int l = 0; l < nc; l++) {
 4251:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4252:          }
 4253:       }
 4254:    }
 4255: 
 4256:    // Back-substitution
 4257:    for (int j = n - 2; j >= 0; j--) {
 4258:       if constexpr (nc == 1) {
 4259:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4260:       } else {
 4261:          for (int l = 0; l < nc; l++) {
 4262:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4263:          }
 4264:       }
 4265:    }
 4266: }
 4267: 
 4268: 
 4269: 
 4270: // Helper function that contains the core algorithm
 4271: template<typename XAccessor, typename YAccessor>
 4272: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4273:                                     double  yp_top, double  yp_bot, 
 4274:                                     CubicSpline &spline) {
 4275:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4276:    // 
 4277:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4278:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4279:    //
 4280:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4281:    // 
 4282:    // Inputs: 
 4283:    //            n: dimension for x etc; # of data pts (>=2);
 4284:    //            getX, getY: functions to access x,y coordinates
 4285:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4286:    //     Output: 
 4287:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4288: 
 4289:    const int n = k2 - k1 + 1;
 4290:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4291: 
 4292:    // Allocate memory for the splines
 4293:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4294:    spline.x   = new double[n];
 4295:    spline.y   = new double[n];
 4296:    spline.yp  = new double[n];
 4297:    spline.ypp = new double[n];
 4298: 
 4299:    for (int k=k1; k<=k2; k++) {
 4300:       spline.x[k] = getX(k);
 4301:       spline.y[k] = getY(k);
 4302:    }
 4303: 
 4304:    // This is to simplify expressions later
 4305:    double *x = spline.x;
 4306:    double *y = spline.y;
 4307: 
 4308:    double *a = nullptr;
 4309:    double *b = nullptr;
 4310:    double *c = nullptr;
 4311:    double *gam = nullptr;
 4312:    double *rhs = nullptr;
 4313:    
 4314: 
 4315:       a = new double[n];   // Lower diagonal
 4316:       b = new double[n];   // Diagonal
 4317:       c = new double[n];   // Upper diagonal
 4318:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4319:       rhs = new double[n]; // Right-hand side
 4320: 
 4321:    for (int k=k1; k<=k2; k++) {
 4322:       if (k == k1) {
 4323:          // Bottom level
 4324:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4325:          b[k] = (x[k+1] - x[k])/3.0;
 4326:          c[k] = b[k]/2.0;
 4327:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4328:       } else if (k == n - 1) {
 4329:          // Top level (surface)
 4330:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4331:          b[k] = (x[k] - x[k-1])/3.0;
 4332:          a[k] = b[k]/2.0;
 4333:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4334:       } else {
 4335:          // Intermediate levels
 4336:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4337:          b[k] = (x[k+1] - x[k-1])/3.0;
 4338:          a[k] = (x[k  ] - x[k-1])/6.0;
 4339:          c[k] = (x[k+1] - x[k  ])/6.0;
 4340:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4341:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4342:       }
 4343:    }
 4344: 
 4345:    // Solve the tridiagonal system
 4346:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4347:    
 4348:    spline.yp[k1] = yp_bot;
 4349:    spline.yp[k2] = yp_top;
 4350: 
 4351:    // Compute rest of 1st derivatives using the splines
 4352:    for (int k=k1+1; k<k2; k++) {
 4353:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4354:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4355:    }
 4356:    
 4357:    delete[] a;
 4358:    delete[] b;
 4359:    delete[] c;
 4360:    delete[] gam;
 4361:    delete[] rhs;
 4362: 
 4363: }
 4364: 
 4365: // Array version
 4366: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4367:                                 double y_top, double y_bot, 
 4368:                                 CubicSpline &spline) {
 4369:    auto getX = [x] (int k) { return x[k]; };
 4370:    auto getY = [y] (int k) { return y[k]; };
 4371:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4372: }
 4373: 
 4374: // Lambda version - allows custom access patterns
 4375: template<typename XFunc, typename YFunc>
 4376: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4377:                                 double y_top, double y_bot,
 4378:                                 CubicSpline &spline) {
 4379:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4380: }
 4381: 
 4382: 
 4383: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4384: {
 4385:    assert("Not implemented");
 4386: 
 4387:    return 0.0;
 4388: }
 4389: 
 4390: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 4391: // //     Routine to do vertical linear interpolation in z
 4392: // //     Inputs:
 4393: // //
 4394: // //       nc: actual # of variables 
 4395: // //       k1,k2: lower and upper limits for za, s_in 
 4396: // //       zt: desired interpolation level
 4397: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 4398: // //       s_in[0:nc-1,0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 4399: 
 4400: // //     Outputs:
 4401: // //       s_out[0:nc-1]: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 4402: // //                   is used below bottom or above surface.
 4403: // //       ibelow: flag indicating if zt is below za(k1)
 4404: // //
 4405: 
 4406: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 4407: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 4408:    
 4409: //    ibelow = 0;
 4410: 
 4411: //    if (zt < za[k1]) {
 4412: //       // Below bottom
 4413: //       ibelow = 1;
 4414: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k1*nc];
 4415: 
 4416: //    } else if(zt>=za[k2]) {
 4417: //       // Above surface
 4418: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k2*nc];
 4419: 
 4420: //    } else {
 4421: //       // Normal case (between bottom and surface)
 4422:       
