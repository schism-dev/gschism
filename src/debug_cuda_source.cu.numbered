 8582:          break;
 8583:       case (int)VarCode::eta:
 8584:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8585:          *sizeType = sizeof(double);
 8586:          break;
 8587:       case (int)VarCode::x:
 8588:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8589:          *sizeType = sizeof(Vector2);
 8590:          break;
 8591:       case (int)VarCode::z:
 8592:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8593:          *sizeType = sizeof(double);
 8594:          break;
 8595:       case (int)VarCode::kb:
 8596:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8597:          *sizeType = sizeof(int);
 8598:          break;
 8599:       case (int)VarCode::isdry:
 8600:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8601:          *sizeType = sizeof(int);
 8602:          break;         
 8603:       case (int)VarCode::w:
 8604:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8605:          *sizeType = sizeof(double);
 8606:          break;
 8607:       case (int)VarCode::u:
 8608:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8609:          *sizeType = sizeof(Vector2);
 8610:          break;  
 8611:       case (int)VarCode::u_air:
 8612:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8613:          *sizeType = sizeof(Vector2);
 8614:          break;
 8615:       default:
 8616:          *offset = -1;    
 8617:    }  
 8618:    
 8619: }
