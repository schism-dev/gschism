  393: 
  394: 
  395: struct Frame {
  396:    double _t[9]; // t stands for tensor.
  397: 
  398:    // Access the tensor in Fortran order
  399:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  400: 
  401:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  402: 
  403:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  404: 
  405:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  406:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  407:       sincos(ar2, &sin_ar2, &cos_ar2);
  408: 
  409:       t(0,0) = -sin_ar1;
  410:       t(1,0) =  cos_ar1;
  411:       t(2,0) =  0.0;
  412:       t(0,1) = -cos_ar1*sin_ar2;
  413:       t(1,1) = -sin_ar1*sin_ar2;
  414: 
  415:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  416: 
  417:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  418:       assert (ar4!=0.0 && "GRID: ar4=0");
  419: 
  420:       const double ar4_inv = 1.0/ar4;
  421:       t(0,1) = t(0,1)*ar4_inv;
  422:       t(1,1) = t(1,1)*ar4_inv;
  423:       t(2,1) = t(2,1)*ar4_inv;
  424: 
  425:       // The third vector is the cross product of the first two
  426:       crossProduct(t(0,0), t(1,0), t(2,0), 
  427:                    t(0,1), t(1,1), t(2,1), 
  428:                    t(0,2), t(1,2), t(2,2));
  429:    }
  430: 
  431: 
  432:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  433:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  434:    // Inputs:
  435:    //        vec0: vel. in this frame;
  436:    //        frameout: Output frame;
  437:    // Output: 
  438:    //        vec1: vel. in new frame  
  439: 
  440:       auto const fo = frameout;
  441:       Vector2 vec1;
  442: 
  443:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  444:       // of t and fo.t are the same.
  445:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  446:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  447: 
  448:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  449:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  450: 
  451:       return vec1;
  452:    }
  453: 
  454:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  455:       // Transform a vector from global to local frame
  456:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  457:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  458:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  459:    }
  460: 
  461:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  462:       // Transform a vector from local to global frame
  463:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  464:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  465:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  466:    }   
  467: 
  468:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  469:    // Tranforms a point from global to local frame     
  470:       G2L(pi - origin0, po);
  471:    }
  472: 
  473:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  474:    // Transforms a point from local to global frame      
  475:       L2G(pi, po);
  476:       po = po + origin0;
  477:    }
  478: 
  479: };
