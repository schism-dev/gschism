 2358: 
 2359: __device__ void Node::updateKb(void) {
 2360: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2361: 
 2362:    if constexpr(ivcor == 1) return;
 2363: 
 2364: 
 2365:    // Check if node is wet
 2366:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2367: 
 2368:    if (isDry) return;
 2369: 
 2370:    if constexpr(ivcor == 2) {  // SZ coordinates
 2371:       
 2372:       // Compute bottom level index
 2373:       if (depth <= mesh->h_s) {
 2374:          kb = mesh->kz - 1;
 2375:       } else {
 2376:          kb = -1;
 2377:          int L = 0;
 2378:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2379:          
 2380:          while (L <= R) {
 2381:             int M = (R + L) / 2;
 2382: 
 2383:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2384:             
 2385:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2386:                R = M;
 2387:             } else {
 2388:                L = M;
 2389:             }
 2390: 
 2391:             if (R - L == 1) {
 2392:                kb = L;
 2393:                break;
 2394:             }
 2395:          }
 2396:       }
 2397:    } 
 2398: }
 2399: 
 2400: 
 2401: __device__ double Node::compZCoord(int k) const {
 2402:    // Computes the z coordinate at level k.
 2403:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2404:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2405:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2406:    // used 
 2407:    
 2408:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2409:       
 2410:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2411: 
 2412:    if constexpr(ivcor == 2) {
 2413: 
 2414:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2415:       const int kz = mesh->kz;
 2416:       const double h_c = mesh->h_c;
 2417:       const double theta_f = mesh->theta_f;
 2418:       const double sinh_theta_f = mesh->sinh_theta_f;
 2419: 
 2420:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2421:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2422:       // once per time step/node.
 2423:       // CHECK: updateZCoordData
 2424: 
 2425:       if (k == kz)               return -hmod2;
 2426:       else if (k == nvrt-1)      return eta2;
 2427:       else if (k == kb)          return -depth;
 2428:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2429:       else if (k > kz) {
 2430:          const int ksig = k - kz + 1;
 2431: 
 2432:          if (hmod2 <= h_c) {
 2433:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2434:          } 
 2435:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2436:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2437:             assert(false && "ZCOOR: invalid h_c\n");
 2438:          } 
 2439:          else {
 2440:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2441:                          h_c * mesh->sigma[ksig] + 
 2442:                          (hmod2 - h_c) * mesh->cs[ksig];
 2443:          }
 2444:       } else { 
 2445:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2446:       }
 2447: 
 2448:    }
 2449:    else if constexpr(ivcor == 1) {
 2450:       if (k == kb) return -depth;
 2451:       else if (k == nvrt-1) return eta2;
 2452:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2453:    }
 2454:    
 2455:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2456:    return 0.0;
 2457: }
 2458: 
 2459: 
 2460: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2461:                 double *node_coords, double *wind_rotate_angle, 
 2462:                 int *isdel, int *isidenode, int *isbnd,
 2463:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2464:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2465:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2466:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2467:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2468:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2469:                 double *emo, double *efa, 
 2470:                 double *umo, double *ufa, 
 2471:                 double *vmo, double *vfa) {
 2472: 
 2473:    printf("Populating mesh for partition %d\n", partNum);
 2474: 
 2475:    // Horizontal grid
 2476:    printf("Processing %d nodes\n", np);    
 2477: 
 2478: 
 2479:    int idxNodeBoundary = 0;  
 2480:    for (int i = 0; i < np; i++)
 2481:    {
 2482:       Node &node = localNodeData[i];
 2483: 
 2484:       node.idx = i;
 2485: 
 2486:       const int idxNodeStart = nodeNeighNodesStart[i];
 2487:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2488:       node.numNodes = idxNodeEnd - idxNodeStart;
 2489:       node.nodes = nodeNeighNodes + idxNodeStart;
 2490:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2491: 
 2492: 
 2493: 
 2494:       const int idxElemStart = nodeNeighElemsStart[i];
 2495:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2496:       node.numElements = idxElemEnd - idxElemStart;
 2497:       node.elements = nodeNeighElems + idxElemStart;
 2498: 
 2499: 
 2500:       
 2501:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2502:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2503:          const int partNode = localNodePart[idxNodeGlobal]; 
 2504:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2505: 
 2506: 
 2507:          Node *node_ptr = nodes[partNode] + idxNode;
 2508:          
 2509:          nodeNeighNodes[idx] = node_ptr;
 2510:       }
 2511: 
 2512:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2513:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2514:          const int partElem = localElemPart[idxElemGlobal];
 2515:          const int idxElem  = localElemIndices[idxElemGlobal];
 2516: 
 2517:          Element *elem_ptr = elems[partElem] + idxElem;
 2518: 
 2519:          nodeNeighElems[idx] = elem_ptr;
 2520:       }      
 2521: 
 2522: 
 2523:       node.wind_angle = wind_rotate_angle[i];
 2524: 
 2525:       // Element **elements; // pointer to the elements connected to this node
 2526:       // int numElements;   // number of elements shared by this node
 2527: 
 2528:       node.p.x   = node_coords[i * 3];
 2529:       node.p.y   = node_coords[i * 3 + 1];
 2530:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2531:       node.depth = node_coords[i * 3 + 2];
 2532: 
 2533: 
 2534: 
 2535:       // Links the node to the boundary information
 2536:       if (isbnd[i] >= 0) {
 2537:        
 2538:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2539:          node.nodeBnd->node = &node;
 2540: 
 2541:          if (isbnd[i]>0) {
 2542: 
 2543:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2544:             node.nodeBnd->segment->ifltype = isbnd[i];
 2545: 
 2546:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2547:             node.nodeBnd->segment->clen  = nan("1");
 2548:             node.nodeBnd->segment->carea = nan("1");
 2549: 
 2550:          }
 2551:          else {
 2552:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2553:          }
 2554:          
 2555:          idxNodeBoundary++;
 2556:       }
 2557:       else {
 2558:          node.nodeBnd = nullptr;
 2559:       }
 2560: 
 2561: // XXXX
 2562: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2563: constexpr double rot_per = 3000.0;
 2564: constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2565: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2566: // XXXXX
 2567:    }
 2568: 
 2569:    nbp = idxNodeBoundary;
 2570: 
 2571:    printf("Processing %d sides\n", ns);
 2572:    int idxSideBoundary = 0;
 2573:    for (int i = 0; i < ns; i++)
 2574:    {
 2575:       Side &side = localSideData[i];
 2576:       side.idx = i;
 2577:       // finding the pointer to the nodes that form the side
 2578:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2579:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2580: 
 2581:       const int locidx_n1 = localNodeIndices[idx_n1];
 2582:       const int locidx_n2 = localNodeIndices[idx_n2];
 2583:       const int part_n1 =   localNodePart[idx_n1];
 2584:       const int part_n2 =   localNodePart[idx_n2];
 2585: 
 2586:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2587:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2588: 
 2589:       // Normal vector to the side
 2590:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2591:       const double norm = sqrt(dot(side.n, side.n));
 2592:       side.n = side.n/norm;
 2593: 
 2594:       // Side boundary type
 2595:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2596:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2597:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2598:       
 2599:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2600:       {
 2601:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2602:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2603:          else                  side.sideBnd->segment = n2bnd->segment;
 2604:          side.sideBnd->side = &side;
 2605:          idxSideBoundary++;
 2606:       }
 2607:       else side.sideBnd = nullptr;
 2608: 
 2609:       nbs = idxSideBoundary;
 2610: 
 2611:       // finding the pointer to the elements that share the side
 2612:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2613:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2614: 
 2615:       if (idx_e1 > -1) {
 2616:          const int locidx_e1 = localElemIndices[idx_e1];
 2617:          const int part_e1 =  localElemPart[idx_e1];
 2618:          side.elems[0] = elems[part_e1] + locidx_e1;
 2619:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2620:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2621:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2622:       }
 2623:       else {
 2624:          side.elems[0] = nullptr;
 2625:       }
 2626: 
 2627:       if (idx_e2 > -1) {
 2628:          const int locidx_e2 = localElemIndices[idx_e2];
 2629:          const int part_e2 =  localElemPart[idx_e2];
 2630:          side.elems[1] = elems[part_e2] + locidx_e2;
 2631:       }
 2632:       else {
 2633:          side.elems[1] = nullptr;
 2634:       }
 2635: 
 2636: 
 2637: 
 2638:       // Compute the center of the side
 2639:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2640: 
 2641: // XXXX
 2642: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2643: constexpr double rot_per=3000.0;
 2644: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2645: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2646: // XXXXX      
 2647: 
 2648:       // Compute the z level at the center of the side
 2649:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->znl[k] + side.n2->znl[k]);
 2650: 
 2651:       // Compute the length of the side
 2652:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2653:       side.length = sqrt(dot(vLen, vLen));
 2654: 
 2655:    }
 2656: 
 2657:    printf("Processing %d elements\n", ne);
 2658:    for (int i = 0; i < ne; i++)
 2659:    {
 2660:       Element &elem = localElemData[i];
 2661:       elem.idx = i;
 2662:       for (int j = 0; j < i34[i]; j++) {
 2663:          const int idxNode = elnode[i*4 + j];  
 2664:          const int idxSide = elside[i*4 + j];
 2665:          
 2666:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2667:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2668: 
 2669: 
 2670: 
 2671:          // Find the neighboring element  
 2672:          if (elem.sides[j]->elems[0] == &elem) {
 2673:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2674:          }
 2675:          else {
 2676:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2677:          }
 2678:          
 2679:       }
 2680: 
 2681:       elem.i34 = i34[i];
 2682: 
 2683: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2684: 
 2685:       // Compute the centroid of the element and its depth
 2686:       Vector2 center = {0.0, 0.0};
 2687:       elem.depth = 0.0;
 2688:       for (int j = 0; j < i34[i]; j++) {
 2689:          center += elem.nodes[j]->p2()/i34[i];
 2690:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2691:       }
 2692:       elem.center.x = center.x;
 2693:       elem.center.y = center.y;
 2694: 
 2695:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2696:       
 2697:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2698:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2699: 
 2700:       elem.area = elem.computeSignedArea(); 
 2701:       elem.radius = sqrt(elem.area)/pi; 
 2702:       
 2703:       // Determines which way the normal vector to each side is oriented.
 2704:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2705:       for (int j = 0; j < i34[i]; j++)  
 2706:       {
 2707:          if (elem.sides[j]->elems[0] == &elem) {
 2708:             elem.ssign[j] =  1.0;
 2709:          }
 2710:          else {
 2711:             elem.ssign[j] = -1.0;
 2712:          }
 2713: 
 2714:       }
 2715: 
 2716:       // Derivatives of shape functions
 2717:       //  For ics=2, this is done inside element/ll frame XXX
 2718:       //  For quads, the derivative is evaluated at centroid
 2719:       const int i34 = elem.i34;
 2720:       for (int j = 0; j < i34; j++) {
 2721:          const double area = elem.area;
 2722:          const int id2 = elem.nxq(1 + j);
 2723:          const int id3 = elem.nxq(2 + j);
 2724:          const int id4 = elem.nxq(3 + j);
 2725:          if (elem.isTri()) {
 2726:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2727:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2728:             // da1/dx = (y1 - y2)/(2*area)
 2729:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2730:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2731:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2732:          }
 2733:          else  { // Quad; evaluate at centroid
 2734:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2735:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2736:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2737:          } // if Tri
 2738: 
 2739:       } // for j
 2740: 
 2741:    }
 2742: 
 2743: 
 2744:    // Processing the boundary nodes
 2745:    int idx = 0;
 2746:    for (int iseg = 0; iseg < nope; iseg++) {
 2747:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2748: 
 2749:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2750: 
 2751:          nodeBnd->isEssentialBC = true;
 2752: nodeBnd->iettype = 3;
 2753:          nodeBnd->elbc = 0.0;
 2754: 
 2755:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2756:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2757:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2758:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2759:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2760:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2761:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2762: printf("nodeBnd->efa[%d] = %f, nodeBnd->emo[%d] = %f, nodeBnd->umo[%d] = %f, nodeBnd->ufa[%d] = %f, nodeBnd->vmo[%d] = %f, nodeBnd->vfa[%d] = %f\n", jfr, nodeBnd->efa[jfr], jfr, nodeBnd->emo[jfr], jfr, nodeBnd->umo[jfr], jfr, nodeBnd->ufa[jfr], jfr, nodeBnd->vmo[jfr], jfr, nodeBnd->vfa[jfr]);
 2763:          }
 2764: 
 2765:          idx++;
 2766:       }
 2767: 
 2768:    }
 2769: 
 2770: }
 2771: 
 2772: 
 2773: 
 2774: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2775:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2776:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2777:    // 
 2778:    // This kernel is called for all nodes.
 2779: 
 2780: 
 2781:    NODE(node1);
 2782: 
 2783: 
 2784:    node1->clearMatrixRow();
 2785:    node1->qel = 0.0;
 2786: 
 2787:    // THIS IS FOR STRUCTURES XXX
 2788:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2789: 
 2790:    
 2791:    for (int j=0; j<node1->numElements; j++) {
 2792:       // For each element connected to the node...
 2793: 
 2794:       Element *elem = node1->elements[j];
 2795: 
 2796:       // Compute the average gravity
 2797:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2798:       const double grav3 = elem->mean(&Node::grav2);
 2799: 
 2800:       // Look at the documentation for the description of the terms in the following integrals
 2801: 
 2802:       // Integral I_1 
 2803:       // \bar{\breve{H}} 
 2804:       const double hhatb = elem->mean(&Side::hhat);        
 2805: 
 2806: 
 2807:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2808: 
 2809:       const int id1 = elem->nodeLocalIdx(node1); 
 2810:       const double area = elem->area;
 2811: 
 2812:       if (elem->isTri()) {
 2813: 
 2814:          // To clarify the notation in this section: 
 2815:          //   i stands for the node under consideration (node1)
 2816:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2817:          const int id2 = elem->nxq(1 + id1);
 2818:          const int id3 = elem->nxq(2 + id1);
 2819:          Node *node2 = elem->nodes[id2];
 2820:          Node *node3 = elem->nodes[id3];
 2821: 
 2822:          const Point2 x1 = node1->p2();
 2823:          const Point2 x2 = node2->p2();
 2824:          const Point2 x3 = node3->p2();
 2825: 
 2826:          // integral of phi_i*phi_j
 2827:          const double ipp_ii = (1.0/6.0 )*area;
 2828:          const double ipp_ij = (1.0/12.0)*area;
 2829:          const double ipp_ik = (1.0/12.0)*area;
 2830: 
 2831:          // integral of [(grad phi_i) * (grad phi_j)]
 2832:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2833:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2834:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2835: 
 2836:          // Computes the different components of integral I_1 of each node with respect to node i.
 2837:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2838:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2839:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2840: 
 2841: if (j==node1->numElements-1) {
 2842: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2843: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2844: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2845: }
 2846: 
 2847:          node1->addToSparseMatrix(node1, I1_ii);
 2848:          node1->addToSparseMatrix(node2, I1_ij); 
 2849:          node1->addToSparseMatrix(node3, I1_ik);
 2850: 
 2851: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2852:      
 2853:       }
 2854:       else { // Quad
 2855:          // XXX IMPLEMENT THIS
 2856:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2857:       } 
 2858: 
 2859:  
 2860:       // Integral I_4
 2861:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2862:       // Where
 2863:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2864: 
 2865:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2866:       // of U over the element.
 2867:       Vector2 Umean = {0.0, 0.0};
 2868:       for (int m=0; m<elem->i34; m++) {      
 2869:          const Side *side = elem->sides[m];
 2870: 
 2871:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2872:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2873:       }
 2874:       Umean = Umean/elem->i34;
 2875: 
 2876:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2877: 
 2878:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2879:       const double I_4_1 = dot(gradPhi_1, Umean);
 2880: 
 2881:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2882:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2883:      
 2884:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2885: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2886: 
 2887:       // Additional terms 
 2888:       double vnorm = 0.0;
 2889:       if (imm == 2)  { // Pre-compute vnorm on the element
 2890:          Vector3 ubed;
 2891:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2892: 
 2893:          Vector3 gradP = {0.0, 0.0, 1.0};
 2894:          for (int m=0; m < elem->i34; m++) {
 2895:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2896:            gradP += toVector3(gradP_2D, 0.0);
 2897:          }   
 2898:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2899:       } // imm==2
 2900: 
 2901:       if (elem->isTri()) {
 2902:          for (int l=0; l<3; l++) {
 2903:            double fac;
 2904: 
 2905:            Node *node = elem->nodes[l];
 2906: 
 2907:            (node == node1)? fac=2.0 : fac=1.0;
 2908: 
 2909:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2910:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2911:            
 2912:          }
 2913: 
 2914: 
 2915:          if (!elem->isDry) {
 2916:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2917:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2918:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2919: 
 2920:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2921:          }
 2922: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2923: 
 2924:       } // isTri
 2925:       else { // isQuad
 2926:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2927:          // for (int l=0; l<4; l++) {
 2928:          //   const Node *node = elem->nodes[l];
 2929: 
 2930:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2931:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2932: 
 2933:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2934:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2935:          // }
 2936: 
 2937:       } // isQuad
 2938: 
 2939: 
 2940:       node1->qel += (dt/elem->i34)*elem->vsource;
 2941:       
 2942: 
 2943:    } // for all elements connected to the node
 2944:    
 2945: 
 2946: 
 2947:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2948:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2949:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2950:    if (nodeBnd != nullptr)  { 
 2951:       // If it is an open boundary node...
 2952: 
 2953:       // At least one open bnd side, maybe two
 2954:       for (int l=0; l<2; l++) { 
 2955: 
 2956:          // Gets each of the sides sharing the node. 
 2957:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2958: 
 2959:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2960: 
 2961:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2962: 
 2963: 
 2964:          if (sideBnd != nullptr) {
 2965:             // If the side is on a boundary...
 2966: 
 2967:             // Get the boundary segment
 2968:             const BoundarySegment *sideSegment = sideBnd->segment;
 2969:             const Side *side = sideBnd->side;
 2970: 
 2971:             // Integral I_3
 2972:             if (sideSegment->ifltype != 0) {
 2973:             // Natural or Flather b.c.
 2974: 
 2975:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 2976:                // especially for Flather b.c.
 2977:                double ri3 = 0.0;
 2978:                if (!side->isDry) {
 2979:                   // If the side is not dry
 2980:                   
 2981:                   // Computes the side flux of (uth, vth)
 2982:                   double Vn = 0.0;
 2983:                   for (int k = side->kb; k<nvrt-1; k++) {
 2984:                      // uth, vth in lat/lon frame if ics=2
 2985:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 2986:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 2987:                      const double vn2 = dot(side->uth[k+1], side->n);
 2988: 
 2989:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 2990:                   }
 2991: 
 2992:                   ri3 = 0.5*side->length*Vn;
 2993:                }
 2994: 
 2995:                if (sideSegment->ifltype == -1) { // Flather 1
 2996: 
 2997:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 2998:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 2999: 
 3000:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 3001:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3002:                   
 3003:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3004:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3005: 
 3006:                } 
 3007:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3008:                   // Reset ri3
 3009:                   ri3 = 0.0;
 3010: 
 3011:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3012: 
 3013:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3014: 
 3015:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3016:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3017: 
 3018:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 3019:                   node1->addToSparseMatrix(node1, con0*2.0);
 3020:                   node1->addToSparseMatrix(node2, con0);
 3021: 
 3022:                } // if Flather or Discharge
 3023: 
 3024:                node1->qel -= thetai*dt*ri3;
 3025: 
 3026:             } // I_3
 3027:           
 3028: 
 3029:             // Integral I_5
 3030:             if(!side->isDry) {
 3031: 
 3032:                const double Unbar = dot(side->U, side->n);
 3033: 
 3034:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 3035:                
 3036:             } // I_5
 3037: 
 3038:          } // if is boundary side
 3039: 
 3040:       } // for l
 3041: 
 3042:    } // if isbnd
 3043: 
 3044: 
 3045:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3046: 
 3047: }
 3048: 
 3049: 
 3050: extern "C" {
 3051:    __global__ void backtrackAllNodes(void) {
 3052: 
 3053:       // max/min # of sub-divisions
 3054:       const int ndelt_max = max(1.0, dt/dtb_min);
 3055:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3056: 
 3057:       // Removed all references to swild98 XXX
 3058:       // swild98=0.d0 !init
 3059: 
 3060: 
 3061:       SIDE(side);
 3062: 
 3063:       const int kb = side->kb;
 3064: 
 3065:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 3066: 
 3067:       // Initialize btrack velocities to the actual velocities at the side 
 3068:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3069: 
 3070: 
 3071:       if (side->isDry) return;
 3072: 
 3073: 
 3074:       // Checks that at least one element is not dry
 3075:       const Element *elem1 = side->elems[0];
 3076:       const Element *elem2 = side->elems[1];
 3077: 
 3078: 
 3079:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3080:       
 3081:       // XXXXXX
 3082:       // !swild_tmp to store global coord. of the starting side
 3083:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3084:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3085:       // !Use sframe2 
 3086:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3087: 
 3088: 
 3089:       for (int k = kb; k < nvrt; k++) {
 3090:       //  Initialize (xt,yt,zt), nnel and vel.
 3091:       //  For ics=2, the coordinates are in local frames
 3092:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3093: 
 3094: 
 3095:          const int iadvf = side->iadv();  // Advection flag
 3096: 
 3097:          Point3 xt;
 3098:          if constexpr(ics==1) {
 3099:             xt = side->center3D(k); 
 3100:          }
 3101:          else // lat/lon; in side lat/lon frame
 3102:          {
 3103:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3104:          // XXX IMPLEMENT THIS
 3105:       //          xt=0.d0
 3106:       //          yt=0.d0
 3107:       //          !centroid coord. for nudging
 3108:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3109:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3110:          }  // ics
 3111: 
 3112: 
 3113:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3114:          // XXX IS THIS NECESSARY?
 3115:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3116: 
 3117:          // If on land or open boundary...
 3118:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3119:          
 3120:          const double vmag = length(toVector2(u_int));
 3121: 
 3122:          if (vmag <= velmin_btrack) {
 3123:             // No activity 
 3124: 
 3125:             side->btu[k] = side->u2[k];
 3126: 
 3127:             
 3128:          } else {  // do btrack
 3129: 
 3130:           
 3131:             // Compute number of sub-divisions based on local gradients 
 3132:             // XXX IS THIS NECESSARY?
 3133:             double suma = 0.0;
 3134:             int icount = 0;
 3135:             for (int ii=0; ii<2; ii++) {
 3136: 
 3137:                const Element *elem = side->elems[ii];
 3138:                  
 3139:                if (elem == nullptr) continue;
 3140: 
 3141:                icount++;
 3142: 
 3143:                // Not strictly along z; in ll frame for ics=2
 3144: 
 3145:                double utmp[4];
 3146:                double vtmp[4];
 3147:                for (int jj = 0; jj < elem->i34; jj++) {
 3148: 
 3149:                   const Node *node = elem->nodes[jj];
 3150: 
 3151:                   if constexpr(ics==1) {
 3152:                      utmp[jj] = node->u2[k].x;
 3153:                      vtmp[jj] = node->u2[k].y;  
 3154:                   } else {
 3155:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3156:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3157:                   }
 3158:                } // for jj
 3159: 
 3160:                const Vector2 grad_u = elem->grad2(utmp); 
 3161:                const Vector2 grad_v = elem->grad2(vtmp);
 3162: 
 3163:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3164:             } // for ii
 3165: 
 3166:             assert(icount > 0 && "Impossible 77");
 3167: 
 3168:             // '4' is somewhat arbitrary
 3169:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3170: 
 3171:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3172:          
 3173: 
 3174:             Vector3 u_int = {0.0, 0.0, 0.0};
 3175: 
 3176:             side->btrack(k, dt, dtbk, u_int);
 3177: 
 3178:                
 3179:          } // if vmag (do backtrack)
 3180: 
 3181:       } // for j=jmin,nvrt-1
 3182: 
 3183:    }
 3184: } // extern "C"
