 4457: 
 4458: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4459:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4460:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4461: 
 4462: 
 4463:    NODE(node1);
 4464: 
 4465:    node1->clearMatrixRow();
 4466:    node1->qel = 0.0;
 4467: 
 4468:    // THIS IS FOR STRUCTURES XXX
 4469:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4470: 
 4471:    
 4472:    for (int j=0; j<node1->numElements; j++) {
 4473:       // For each element connected to the node...
 4474: 
 4475:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4476: 
 4477:       Element *elem = node1->elements[j];
 4478: 
 4479:       // Compute the average gravity
 4480:       const double grav3 = elem->mean(&Node::grav2);
 4481: 
 4482:       // Look at the documentation for the description of the terms in the following integrals
 4483: 
 4484:       // Integral I_1 
 4485:       // \bar{\breve{H}} 
 4486:       const double hhatb = elem->mean(&Side::hhat);        
 4487: 
 4488:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4489: 
 4490:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4491:       const double area = elem->area;
 4492: 
 4493:       // Integral I_4
 4494:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4495:       // Where
 4496:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4497: 
 4498:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4499:       // of U over the element.
 4500:       const Vector2 U = elem->mean(&Side::U);
 4501: 
 4502:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4503: 
 4504:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4505:       const double I_4_1 = dot(gradPhi_1, U);
 4506: 
 4507: 
 4508:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4509:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4510: 
 4511:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4512: 
 4513: 
 4514:       // Normal component of the bed velocity
 4515:       double ubedNormalComp = 0.0;
 4516:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4517:          Vector3 ubed = {0.0, 0.0, 0.0};
 4518:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4519:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4520: 
 4521:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4522:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4523:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4524: 
 4525:          // Computes the normal component of the bed velocity
 4526:          ubedNormalComp = dot(ubed, N);
 4527:       } // imm==2
 4528: 
 4529:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4530: 
 4531:       if (elem->isTri()) {
 4532: 
 4533:          // To clarify the notation in this section: 
 4534:          //   In formulas, we use the following notation:
 4535:          //       i stands for the node under consideration (node1)
 4536:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4537:          //   However, in the code, we use the following notation:
 4538:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4539:          const int id2 = elem->nxq(1 + id1);
 4540:          const int id3 = elem->nxq(2 + id1);
 4541:          Node *node2 = elem->nodes[id2];
 4542:          Node *node3 = elem->nodes[id3];
 4543: 
 4544:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4545: 
 4546:          // integral of phi_i*phi_j
 4547:          const double ipp_ii = (1.0/6.0 )*area;
 4548:          const double ipp_ij = (1.0/12.0)*area;
 4549:          const double ipp_ik = (1.0/12.0)*area;
 4550: 
 4551:          // integral of [(grad phi_i) * (grad phi_j)]
 4552:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4553:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4554:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4555: 
 4556:          // Computes the different components of integral I_1 of each node with respect to node i.
 4557:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4558:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4559:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4560: 
 4561:          node1->addToSparseMatrix(node1, I1_ii);
 4562:          node1->addToSparseMatrix(node2, I1_ij); 
 4563:          node1->addToSparseMatrix(node3, I1_ik);
 4564: 
 4565:          #pragma unroll
 4566:          for (int l=0; l<3; l++) {
 4567: 
 4568:             Node *node = elem->nodes[l];
 4569: 
 4570:             // Additional variation in eta due to bed deformation or vertical velocity
 4571:             double extraEta = 0.0;
 4572:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4573:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4574: 
 4575: 
 4576:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4577:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4578: 
 4579:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4580: 
 4581:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4582:            
 4583:          }
 4584: 
 4585: 
 4586:       }
 4587:       else { // Quad
 4588:          // To clarify the notation in this section: 
 4589:          //   In formulas, we use the following notation:
 4590:          //       i stands for the node under consideration (node1)
 4591:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4592:          //   However, in the code, we use the following notation:
 4593:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4594:          const int id2 = elem->nxq(1 + id1);
 4595:          const int id3 = elem->nxq(2 + id1);
 4596:          const int id4 = elem->nxq(3 + id1);
 4597:          Node *node2 = elem->nodes[id2];
 4598:          Node *node3 = elem->nodes[id3];
 4599:          Node *node4 = elem->nodes[id4];   
 4600:          
 4601:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4602: 
 4603:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4604:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4605:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4606:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4607:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4608: 
 4609:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4610:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4611:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4612:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4613:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4614: 
 4615: 
 4616:          // Computes the different components of integral I_1 of each node with respect to node i.
 4617:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4618:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4619:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4620:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4621: 
 4622:          node1->addToSparseMatrix(node1, I1_ii);
 4623:          node1->addToSparseMatrix(node2, I1_ij); 
 4624:          node1->addToSparseMatrix(node3, I1_ik);
 4625:          node1->addToSparseMatrix(node4, I1_il);
 4626:   
 4627:          #pragma unroll
 4628:          for (int l=0; l<4; l++) {
 4629: 
 4630:             const Node *node = elem->nodes[l];
 4631: 
 4632:             // Additional variation in eta due to bed deformation or vertical velocity
 4633:             double extraEta = 0.0;
 4634:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4635:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4636: 
 4637:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4638:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4639:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4640: 
 4641:          }         
 4642:       } 
 4643: 
 4644: 
 4645:      node1->qel += (dt/elem->i34)*elem->vsource;
 4646:       
 4647: 
 4648:    } // for all elements connected to the node
 4649:    
 4650: 
 4651:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4652:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4653:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4654:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 4655:    // If it is an open boundary node...
 4656: 
 4657:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4658: 
 4659:       // At least one open bnd side, maybe two
 4660:       for (int l=0; l<2; l++) { 
 4661: 
 4662:          // Gets each of the sides sharing the node. 
 4663:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4664: 
 4665:     
 4666: 
 4667:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4668:          if (sideBnd != nullptr) {
 4669:             // If the side is on a boundary...
 4670: 
 4671:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4672: 
 4673:             // Get the boundary segment
 4674:             const BoundarySegment *sideSegment = sideBnd->segment;
 4675:             const Side *side = sideBnd->side;
 4676: 
 4677:             // Integral I_3
 4678:             if (sideSegment->ifltype != 0) {
 4679:             // Natural or Flather b.c.
 4680: 
 4681:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4682:                // especially for Flather b.c.
 4683:                double ri3 = 0.0;
 4684:                if (!side->isDry) {
 4685:                   // If the side is not dry
 4686:                   
 4687:                   // Computes the side flux of (uth, vth)
 4688:                   double Vn = 0.0;
 4689:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4690:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4691:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4692: 
 4693:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4694:                   }
 4695: 
 4696:                   ri3 = 0.5*side->len*Vn;
 4697:                }
 4698: 
 4699:                if (sideSegment->ifltype == -1) { // Flather 1
 4700: 
 4701:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4702:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4703: 
 4704:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4705:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4706:                   
 4707:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4708:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4709: 
 4710:                } 
 4711:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4712:                   // Reset ri3
 4713:                   ri3 = 0.0;
 4714: 
 4715:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4716:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4717: 
 4718:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4719: 
 4720:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4721:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4722: 
 4723:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4724:                   node1->addToSparseMatrix(node1, con0*2.0);
 4725:                   node1->addToSparseMatrix(node2, con0);
 4726: 
 4727:                } // if Flather or Discharge
 4728: 
 4729:                node1->qel -= thetai*dt*ri3;  
 4730: 
 4731: 
 4732:             } // I_3
 4733:           
 4734: 
 4735:             // Integral I_5
 4736:             if(!side->isDry) {
 4737: 
 4738:                const double Unbar = dot(side->U, side->n);
 4739:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4740: 
 4741:             } // I_5
 4742: 
 4743:          } // if is boundary side
 4744: 
 4745:       } // for l
 4746: 
 4747:    } // if isbnd
 4748: 
 4749: 
 4750: }
 4751: 
 4752: 
 4753: 
 4754: extern "C" {
 4755: 
 4756:    __global__ void gatherBFromMesh(double* b) {
 4757:       // b[local] <- qel  (local = idx_node on this device)
 4758:       NODE(node);
 4759:       b[idx_node] = node->qel;
 4760:    }
