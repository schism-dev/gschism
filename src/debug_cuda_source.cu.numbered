  474: 
  475: 
  476: struct Frame {
  477:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  478:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  479:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  480:     double t00, t10;        // col0 (t20=0 implicit)
  481:     double t01, t11, t21;   // col1
  482: 
  483:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  484: 
  485:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  486:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  487: 
  488:       double sin_lon, cos_lon, sin_lat, cos_lat;
  489:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  490:       sincos(lat, &sin_lat, &cos_lat);
  491: 
  492:       t00 = -sin_lon;
  493:       t10 =  cos_lon;
  494:       t01 = -cos_lon*sin_lat;
  495:       t11 = -sin_lon*sin_lat;
  496:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  497: // printf("lat = %f, lon = %f, cos_lat = %f, sin_lat = %f, cos_lon = %f, sin_lon = %f\n", lat, lon, cos_lat, sin_lat, cos_lon, sin_lon);
  498: // printf("t00 = %f, t10 = %f, t01 = %f, t11 = %f, t21 = %f\n", t00, t10, t01, t11, t21);
  499: 
  500:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  501:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  502: 
  503:       const double col1_norm_inv = 1.0/col1_norm;
  504:       t01 = t01*col1_norm_inv;
  505:       t11 = t11*col1_norm_inv;
  506:       t21 = t21*col1_norm_inv;
  507: 
  508:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  509: 
  510:    }
  511: 
  512:    __forceinline__ __device__ void print(void) const {
  513:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  514:    }
  515: 
  516:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  517:       // cross(col0, col1), with t20=0 implicitly:
  518:       // |  i       j       k   |
  519:       // | t00     t10      0   |
  520:       // | t01     t11     t21  |
  521:       t02 =  t10*t21;
  522:       t12 = -t00*t21;
  523:       t22 =  t00*t11 - t10*t01;
  524:    }
  525: 
  526: 
  527:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  528:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  529:    // Inputs:
  530:    //        vec0: vel. in this frame;
  531:    //        frameout: Output frame;
  532:    // Output: 
  533:    //        vel. in new frame  
  534:    //
  535:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  536:    // discarding the z-component of the result to keep only the local horizontal
  537:    // plane of frame 2.
  538:    //
  539:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  540:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  541:    // are orthogonal. This product is computed as dot products between columns of
  542:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  543:    // columns of F2.// 
  544: 
  545:       auto const fo = frameout; // Just an alias for the output frame.
  546:       Vector2 res;
  547: 
  548:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  549:       // of t and fo.t are the same.
  550:       const double d00 = t00*fo.t00 + t10*fo.t10;
  551:       const double d10 = t01*fo.t00 + t11*fo.t10;
  552: 
  553:       const double d01 = t00*fo.t01 + t10*fo.t11;
  554:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  555: 
  556:       res.x = vec0.x * d00 + vec0.y * d10;
  557:       res.y = vec0.x * d01 + vec0.y * d11;
  558: 
  559:       return res;
  560:    }
  561: 
  562:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  563:       Vector3 vo;
  564:       double t02, t12, t22;
  565: 
  566:       // Compute the 3rd column of the frame tensor
  567:       getCol2(t02, t12, t22);
  568: 
  569:       vo.x = vi.x*t00 + vi.y*t10;
  570:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  571:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  572: 
  573:       return vo;
  574:    
  575:    }
  576: 
  577:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  578:       Vector3 vo;
  579:       double t02, t12, t22;
  580: 
  581:    // Compute the 3rd column of the frame tensor
  582:       getCol2(t02, t12, t22);
  583: 
  584:       // F * vi (non-transposed, so we use rows of F)
  585:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  586:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  587:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  588: 
  589:       return vo;
  590:    }
  591: 
  592: 
  593: 
  594: };
