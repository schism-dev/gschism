 2111:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2112:       // Compute the different time ramps used in the code 
 2113:       // This function is performed by just one thread
 2114: 
 2115:       rampbc = 1.0;
 2116:       if constexpr(ibc == 0) {
 2117:          if (drampbc > 0.0) {
 2118:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2119:          } else {
 2120:             rampbc = 1.0;
 2121:          }
 2122:       }
 2123: 
 2124:       if (nws != 0) {
 2125:          if (drampwind > 0.0) {
 2126:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2127:          } else {
 2128:             rampwind = 1.0;
 2129:          }
 2130:       }
 2131: 
 2132:       if (drampwafo > 0.0) {
 2133:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2134:       } else {
 2135:          rampwafo = 1.0;
 2136:       }
 2137: 
 2138:       // For source/sinks
 2139:       if (if_source && dramp_ss > 0.0) {
 2140:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2141:       } else {
 2142:          ramp_ss = 1.0;
 2143:       }
 2144: 
 2145:       if (dramp > 0.0) {
 2146:          ramp = tanh(2.0*time/86400.0/dramp);
 2147:       } else {
 2148:          ramp = 1.0;
 2149:       }
 2150: 
 2151: 
 2152:    }
