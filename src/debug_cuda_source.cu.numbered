 8267: __global__ void getStructSizes(int* sizes)  {
 8268:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8269:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 8270:       sizes[0] = (int)sizeof(Node);
 8271:       sizes[1] = (int)sizeof(Element);
 8272:       sizes[2] = (int)sizeof(Side);
 8273:       sizes[3] = (int)sizeof(NodeBoundary);
 8274:       sizes[4] = (int)sizeof(SideBoundary);
 8275:       sizes[5] = (int)sizeof(BoundarySegment);
