  474: 
  475:    int kb;                    // Bottom index of the element
  476:    double area;               // Area of the element
  477:    double ssign[4];           // Sign associated with each side of an element
  478:    double radius;             // Element equivalent radii
  479: 
  480:    Frame frame;
  481: 
  482:    Vector2 gradPhi[4];       // Derivatives of shape functions
  483:    Vector2 gradEta;          // Gradient of free surface elevation
  484:    Vector2 gradPr;           // Gradient of pressure    
  485:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  486: 
  487:    bool isDry;                // True if the element is dry
  488: 
  489:    Vector3 center;            // Element center coordinates
  490:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  491:    double depth;              // Depth at element (min of all nodes)
  492:    double z[nvrt];            // z-coord  (local frame - vertical up)
  493: 
  494:    // Physical information
  495:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  496: 
  497:    static const bool isblock = false;              // Always false
  498: 
  499:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  500:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  501: 
  502:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  503: 
  504:    
  505: 
  506:    double vsource;            // Volumetric source/sink term [m^3/s]
  507: 
  508:    double rho[nvrt];          // Density at each prism center
  509:    double rho_mean[nvrt];     // Mean density at each prism center
  510:    CubicSpline rho_spl;
  511:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  512:    double rho_z[nvrt];        // First derivative of density at each prism center
  513:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  514: 
  515:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  516: 
  517:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  518:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  519: 
  520:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  521:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  522: 
  523:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  524:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  525:       // Find the local index of the node in the element (0,1,2,3)
  526:       int res = __ffs((nodes[0] == node) | 
  527:                      ((nodes[1] == node) << 1) | 
  528:                      ((nodes[2] == node) << 2) | 
  529:                      ((nodes[3] == node) << 3)) - 1;
  530:       
  531:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  532:       return res;
  533:    }
  534: 
  535:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  536:       // Find the local index of the side in the element (0,1,2,3)
  537:       int res = __ffs((sides[0] == side) | 
  538:                      ((sides[1] == side) << 1) | 
  539:                      ((sides[2] == side) << 2) | 
  540:                      ((sides[3] == side) << 3)) - 1;
  541:       
  542:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  543:       return res;
  544:    }
  545: 
  546: 
  547:    __inline__ __device__ int findLevel(double z1, int k) const {
  548:       // Starting at index k, find sequentially the level that contains z
  549: 
  550:       // if z is already betweeen z[k] and z[k+1], return k
  551:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  552:       else if (z1 < z[k]) { 
  553:          // Search for increasing levels
  554:          for (int kk = k; kk < nvrt - 1; kk++) {
  555:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  556:          }
  557:          return nvrt - 1;
  558:       }
  559:       else {
  560:          // Search for decreasing levels
  561:          for (int kk = k; kk > 0; kk--) {
  562:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  563:          }
  564:          return 0;
  565:       }
  566:    }
  567: 
  568:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  569:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  570: 
  571:    // Check if the element is dry using the more up-to-date elevation.
  572:    __inline__ __device__ bool isDry2(void) const;
  573: 
  574:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  575: 
  576:    __inline__ __device__ double computeSignedArea(void) const;
  577: 
  578:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  579:       // Nudges the point (x,y) to the barycenter of the element
  580:       p = (1-eps)*p + eps*toVector2(center);
  581:    }
  582: 
  583:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  584:    
  585:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  586: 
  587:    __device__ Vector2 grad2(double *a) const
  588:    {
  589:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  590:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  591:       if (isQuad()) {
  592:          gx += a[3]*gradPhi[3].x;
  593:          gy += a[3]*gradPhi[3].y;
  594:       }
  595:       return {gx, gy};
  596:    }
  597: 
  598:    __device__ Vector2 grad2(double Node::* field) const
  599:    {
  600:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  601:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  602:       if (isQuad()) {
  603:          gx += (nodes[3]->*field)*gradPhi[3].x;
  604:          gy += (nodes[3]->*field)*gradPhi[3].y;
  605:       }
  606:       return {gx, gy};
  607:    }
  608: 
  609:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  610:    __device__ __forceinline__ Vector3 n(int k) const {
  611:       double area3D;
  612:       return n(k, area3D);
  613:     }
