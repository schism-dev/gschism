 2397: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2398: // return;   
 2399:    // Lock the mutex
 2400:    lock(&debugPlotMutex);
 2401:  
 2402:    bool ok = true;
 2403:    if (debugPlotIdx == nullptr) ok = false;
 2404:    if (*debugPlotIdx >= 1000000) ok = false;
 2405:    if (ok) {
 2406:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2407:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2408:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2409:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2410:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2411:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2412:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2413:       (*debugPlotIdx)++;
 2414:    }
 2415: 
 2416:    __threadfence();               // ensure all above writes are visible
 2417:    // Unlock the mutex
 2418:    unlock(&debugPlotMutex);
 2419: 
 2420: }
 2421: 
 2422: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2423:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 2424: }
