 7067: 
 7068:    __global__ void computeVerticalVelocity(void) {
 7069:       // Computes the vertical velocity at the (2D) element's centroid.
 7070:       // In this function we will be considering volumetric elements, with side faces and a 
 7071:       // bottom and a top face. We will call them SFs, BF and TF.
 7072:       // It computes the flux coming from BF and the SFs.
 7073:       // If the bed is moving, it takes that into account.
 7074:       // Since water is incompressible, the integral of the velocity times the normal vector
 7075:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7076:       // and the BF is equal to the flux going out from the TF.
 7077:       // TF = - BF - sum(SFs).
 7078:       // It then computes the horizontal velocity at the center of TF.
 7079:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7080:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7081:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7082: 
 7083:       ELEM(elem);
 7084: 
 7085:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7086: 
 7087:       if (elem->isDry) return;
 7088: 
 7089:       const int kb = elem->kb;
 7090:       const bool isTri = elem->isTri();
 7091: 
 7092:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7093: 
 7094:       // Compute the bottom velocity
 7095:       if constexpr(imm != 0) {
 7096:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7097:       }
 7098: 
 7099: 
 7100:       double bottomArea3D;
 7101:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7102: 
 7103:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7104: 
 7105:       double topArea3D;
 7106: 
 7107:       // Bottom face flux
 7108:       double bottomFlux = 0.0;
 7109:       Vector2 u2meanBottom = {0.0, 0.0};
 7110:       const Vector2 gradh = elem->grad2(&Node::depth);
 7111:       if constexpr(imm==2) {
 7112:          Vector3 ubed;
 7113: 
 7114:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7115:          // updateBDEF(ubed);
 7116:      
 7117:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7118: 
 7119:          // elem->w[kb] += ubed.z;
 7120:       }
 7121:       else {
 7122: 
 7123:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7124:   
 7125:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7126:          // in the direction of motion.
 7127:          const double bottomW = - dot(gradh, u2meanBottom);  
 7128:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7129: 
 7130:          // VElocity associated to the bed deformation
 7131:          double bedVelocity = 0.0;
 7132:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7133: 
 7134:          elem->w[kb] = bedVelocity + bottomW; 
 7135: 
 7136:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7137:          
 7138:       } // if imm
 7139: 
 7140:       // Compute w for kb+1 to nvrt-1
 7141:       for (int l = kb; l < nvrt - 1; l++) {
 7142: 
 7143:          // normal vector to the top face of the "volumetric" element (3D)
 7144:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7145: 
 7146:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7147:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7148: 
 7149:          // Compute the total flux at the sides
 7150:          double sideFlux = 0.0;
 7151: 
 7152:          for (int j = 0; j < elem->i34; j++) {
 7153:             const Side *side = elem->sides[j];
 7154:             const int kbs = side->kb;
 7155:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7156:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7157:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7158: 
 7159:             // The area is "clamped" meaning that it takes kb into account.
 7160:             const double sideArea = side->areaClamped(l);
 7161: 
 7162:             const double sign = elem->ssign[j]; 
 7163: 
 7164:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7165:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7166:          }
 7167:          
 7168:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7169:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7170:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7171: 
 7172:          // The flux at the top ace can be computed from the other flows.
 7173:          // All fluxes are in directions into the prism.
 7174:          const double topFlux = - sideFlux - bottomFlux;
 7175: 
 7176:          // Flux at the top face due to the horizontal velocities only
 7177:          // topFlux = topHorizontalFlux + topVerticalFlux
 7178:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7179: 
 7180:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7181:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7182: 
 7183:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7184: 
 7185:          bottomFlux = -topFlux;
 7186:          
 7187:       }
 7188: 
 7189:    }  
 7190: 
 7191: 
 7192: 
 7193: 
 7194: 
 7195: 
 7196: 
