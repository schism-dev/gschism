 4809:    __global__ void solverCopyResult(double* x) {
 4810:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4811:       NODE(node);
 4812:       const int idx = node->idx;
 4813: 
 4814:       node->mX = x[idx];
 4815:    }
