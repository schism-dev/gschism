 7232: __global__ void printMatrix(void) {
 7233:    // Debugging: print the matrix
 7234: 
 7235:    const int size = mesh->np;
 7236:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7237:       const Node *node = mesh->localNodeData + idx_node;
 7238:       printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7239:       for (int j = 0; j < node->numNodes; j++) {
 7240:          Node* nbNode = node->nodes[j];
 7241:          if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7242:       }
 7243:       printf("]\n");
 7244: 
 7245:    }
 7246: 
 7247: }
