 8212: __global__ void returnMatrix(double *res) {
 8213:    // Debugging: returns the matrix as a CuPy array
 8214: 
 8215:    const int size = mesh->np;
 8216:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8217:       const Node *node = mesh->localNodeData + idx_node;
 8218:       res[idx_node*size + idx_node] = node->coeffDiag;
 8219:       for (int j = 0; j < node->numNodes; j++) {
 8220:          Node* nbNode = node->nodes[j];
 8221:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8222:       }
 8223: 
 8224:    }
 8225:    
 8226: }
