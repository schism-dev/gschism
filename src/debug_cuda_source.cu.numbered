 8013:                                  
 8014:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 8015:                    double *node_coords, double *node_coords_ll, bool use_ll,
 8016:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 8017:                    int *isdel, int *isidenode, int *isbnd,
 8018:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 8019:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8020:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8021:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8022:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 8023:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 8024:                    double *drag, double *roughness,
 8025:                    double *emo, double *efa, 
 8026:                    double *umo, double *ufa, 
 8027:                    double *vmo, double *vfa) {
 8028: 
 8029:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8030:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 8031:                        isdel, isidenode, isbnd,
 8032:                        nond, nlnd, iond, ilnd, 
 8033:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8034:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8035:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 8036:                        localNodeIndices, localElemIndices, localSideIndices,
 8037:                        localNodePart, localElemPart, localSidePart,
 8038:                        drag, roughness,
 8039:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 8040:   }
