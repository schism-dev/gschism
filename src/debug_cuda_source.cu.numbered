 2625: 
 2626: 
 2627: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2628: 
 2629: 
 2630: __device__ void Node::updateKb(void) {
 2631: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2632: 
 2633:    if constexpr(ivcor == 1) return;
 2634: 
 2635: 
 2636:    // Check if node is wet
 2637:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2638: 
 2639:    if (isDry) return;
 2640: 
 2641:    if constexpr(ivcor == 2) {  // SZ coordinates
 2642:       
 2643:       // Compute bottom level index
 2644:       if (depth <= mesh->h_s) {
 2645:          kb = mesh->kz - 1;
 2646:       } else {
 2647:          kb = -1;
 2648:          int L = 0;
 2649:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2650:          
 2651:          while (L <= R) {
 2652:             int M = (R + L) / 2;
 2653: 
 2654:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2655:             
 2656:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2657:                R = M;
 2658:             } else {
 2659:                L = M;
 2660:             }
 2661: 
 2662:             if (R - L == 1) {
 2663:                kb = L;
 2664:                break;
 2665:             }
 2666:          }
 2667:       }
 2668:    } 
 2669: }
 2670: 
 2671: 
 2672: __device__ double Node::compZCoord(int k) const {
 2673:    // Computes the z coordinate at level k.
 2674:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2675:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2676:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2677:    // used 
 2678:    
 2679:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2680:       
 2681:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2682: 
 2683:    if constexpr(ivcor == 2) {
 2684: 
 2685:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2686:       const int kz = mesh->kz;
 2687:       const double h_c = mesh->h_c;
 2688:       const double theta_f = mesh->theta_f;
 2689:       const double sinh_theta_f = mesh->sinh_theta_f;
 2690: 
 2691:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2692:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2693:       // once per time step/node.
 2694:       // CHECK: updateZCoordData
 2695: 
 2696:       if      (k == nvrt-1)      { return eta2; }
 2697:       else if (k == kz)          return -hmod2;
 2698:       else if (k == kb)          return -depth;
 2699:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2700:       else if (k > kz) {
 2701:          const int ksig = k - kz + 1;
 2702: 
 2703:          if (hmod2 <= h_c) {
 2704:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2705:          } 
 2706:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2707:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2708:             assert(false && "ZCOOR: invalid h_c\n");
 2709:          } 
 2710:          else {
 2711:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2712:                          h_c * mesh->sigma[ksig] + 
 2713:                          (hmod2 - h_c) * mesh->cs[ksig];
 2714:          }
 2715:       } else { 
 2716:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2717:       }
 2718: 
 2719:    }
 2720:    else if constexpr(ivcor == 1) {
 2721:       if (k == kb) return -depth;
 2722:       else if (k == nvrt-1) return eta2;
 2723:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2724:    }
 2725:    
 2726:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2727:    return 0.0;
 2728: }
 2729: 
 2730: 
 2731: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2732:    // Checks if a side in on the boundary
 2733:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2734: 
 2735:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2736:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2737: 
 2738:    // Indices of the nodes that form the side
 2739:    const int n1 = side.n1->idx;
 2740:    const int n2 = side.n2->idx;
 2741: 
 2742:    // Check if the side is on a land boundary
 2743:    for (int i = 0; i < nland; i++) {
 2744:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2745:          // Consecutive nodes in the land boundary segment
 2746:          const int b1 = ilnd[i*mnlnd + j];
 2747:          const int b2 = ilnd[i*mnlnd + j + 1];
 2748: 
 2749:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2750:             isLand = true;
 2751:             return i;
 2752:          }
 2753:       }
 2754:    }
 2755: 
 2756:    // Check if the side is on an open boundary
 2757:    for (int i = 0; i < nope; i++) {
 2758:       for (int j = 0; j < nond[i] - 1; j++) {
 2759:          // Consecutive nodes in the open boundary segment
 2760:          const int b1 = iond[i*mnond + j];
 2761:          const int b2 = iond[i*mnond + j + 1];
 2762: 
 2763:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2764:             isLand = false;
 2765:             return i;
 2766:          }
 2767:       }
 2768:    }
 2769:    return -1;
 2770: }
