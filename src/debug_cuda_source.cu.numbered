 3813: 
 3814:    nbs = *sharedIdxSideBoundary + 1;
 3815:    nbp = *sharedIdxNodeBoundary + 1;
 3816: 
 3817:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3818: 
 3819: }
