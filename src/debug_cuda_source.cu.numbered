 7863: //                 !    enddo
 7864: //                 !  endif !inflow or outflow
 7865: //                 !endif !if use weno
 7866: 
 7867: //                 !alternative formulation
 7868: //                 if (k>=kbs(jsj)+1) then
 7869: //                   if (iweno) then !weno
 7870: //                     do jj=1,ntr
 7871: //                       tmp=rk_coef(itd_weno)*dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 7872: //                       adv_tr(jj)=adv_tr(jj)+tmp
 7873: //                       if (adv_tr(jj)<tr_min_max(1,jj) .or. adv_tr(jj)>tr_min_max(2,jj) ) then !reset to upwind
 7874: //                         adv_tr(jj)=adv_tr(jj)-tmp !reset to previous value
 7875: //                         if(ssign(j,i)*flux_adv_hface(k,jsj)<0.d0) then  !inflow 
 7876: //                           adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7877: //                         endif
 7878: //                       endif
 7879: //                       !when ntd_weno=1, reduces to: adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 7880: //                     enddo
 7881: //                   else !upwind
 7882: //                     if(ssign(j,i)*flux_adv_hface(k,jsj)<0) then  !inflow 
 7883: //                       do jj=1,ntr
 7884: //                         adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7885: //                       enddo
 7886: //                     endif
 7887: //                   endif !weno or upwind
 7888: //                 endif
 7889: 
 7890: //               enddo !j
 7891: 
 7892: //               tr_el(1:ntr,k,i)=adv_tr(1:ntr) 
 7893: //             enddo !k=kbe(i)+1,nvrt
