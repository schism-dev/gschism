 8014: extern "C" __global__ void populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 8015:    double *node_coords, double *node_coords_ll, bool use_ll, double *wind_rotate_angle, 
 8016:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8017:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8018:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 8019:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 8020:    double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 8021: 
 8022:    mesh->populateNodes(i34, isbnd, sharedIdxNodeBoundary, 
 8023:                        node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8024:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8025:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8026:                        localNodeIndices, localElemIndices, localSideIndices,
 8027:                        localNodePart, localElemPart, localSidePart,
 8028:                        drag, roughness, rmanning, kb, localSigma);
 8029: }  
