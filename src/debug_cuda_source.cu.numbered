 1746: // Helper functions for computing the local node index at a given offset from another.
 1747: __device__ __inline__ int nxq(int offset, int index, int size) {
 1748:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1749:    // to the index to make it positive
 1750:    assert(index + offset + 16*size >= 0);
 1751:    return (index + offset + 16*size) % size;  
 1752: }
 1753: 
 1754: __device__ __inline__ int nxq(int index, int size) {
 1755:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1756:    // to the index to make it positive
 1757:    assert(index + 16*size >= 0);
 1758:    return (index + 16*size) % size; 
 1759: }
