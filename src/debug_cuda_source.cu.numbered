 2729: 
 2730: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2731: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2732: // Returns the normal vector and the area of the element at this level
 2733:    
 2734:    double nx, ny, nz;
 2735: 
 2736:    if (isTri()) {
 2737:       // For triangles...
 2738: 
 2739:       // Indices of the nodes at level k, taking care of not going below the bed
 2740:       const int k0 = max(k, nodes[0]->kb);
 2741:       const int k1 = max(k, nodes[1]->kb);
 2742:       const int k2 = max(k, nodes[2]->kb);
 2743: 
 2744:       // Gets the element frame coordinates of the nodes at level k
 2745:       Point3 x0, x1, x2;
 2746:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2747:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2748:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2749:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2750: 
 2751:       } else {  // ics == 2
 2752:          Point2 h0, h1, h2;
 2753: 
 2754:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2755: 
 2756:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2757:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2758:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2759:       }
 2760: 
 2761:       const Vector3 n20 = x2 - x0;
 2762:       const Vector3 n10 = x1 - x0; 
 2763: 
 2764:       // Computes the cross product of vectors n20 and n10. 
 2765:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2766:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2767:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2768: 
 2769:   
 2770:    }
 2771:    else {
 2772:       // For quads...
 2773:       Point2 h0, h1, h2, h3;
 2774: 
 2775:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2776: 
 2777:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2778:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2779:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2780:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2781: 
 2782:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2783:       nx = n20.y*n31.z - n20.z*n31.y;
 2784:       ny = n20.z*n31.x - n20.x*n31.z;
 2785:       nz = n20.x*n31.y - n20.y*n31.x;
 2786: 
 2787:    }
 2788: 
 2789:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2790:    area3D = 0.5*len;
 2791: 
 2792:    const double inv_len = 1.0/len;
 2793: 
 2794:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2795: 
 2796: }
 2797: 
 2798: 
 2799: // Helper functions to get the 2D local node position for the Celestial walk
 2800: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2801:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2802:    const Node *node = getNodeInOrder(idx2);
 2803: 
 2804:    double z = 0.0;
 2805:    if constexpr(ics == 2) z = node->gz;
 2806:    
 2807:    Point3 p = toPoint3(node->p, z);
 2808: 
 2809:    return toPoint2(origSide->toLocalFrame(p));
 2810: }
 2811: 
 2812: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2813:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2814: }
 2815: 
 2816: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2817:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2818: // Computes the three per-side predicates needed for the celestial walk
 2819: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2820: //
 2821: // xt is in local frame coordinates for origSide if ics == 2.
 2822: //
 2823: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2824: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2825: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2826: // meaningless on triangles are masked to a safe value (see comments below).
 2827: {
 2828:    // Project all 4 corner positions once into the local 2D frame.
 2829:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2830:    // getLocalNodePosition only transforms/projects if ics == 2.
 2831:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2832:                         getLocalNodePosition(1, origSide), 
 2833:                         getLocalNodePosition(2, origSide), 
 2834:                         getLocalNodePosition(3, origSide)};
 2835: 
 2836:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2837:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2838:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2839:    // But still farther towards the target point from the current point.
 2840:    const Vector2 vt0 = xt - x0;
 2841:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2842:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2843:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2844: 
 2845:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2846:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2847: 
 2848: 
 2849: // if (origSide->idx == 2860848 && jlev == 46) {
 2850: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2851: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2852: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2853: // }
 2854:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2855:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2856:    //  here the orientation is baked into the corners array.)
 2857:    const int i3 = nxq(3);
 2858:    const Vector2 s0 = C[ 1] - C[ 0];
 2859:    const Vector2 s1 = C[ 2] - C[ 1];
 2860:    const Vector2 s2 = C[i3] - C[ 2];
 2861:    const Vector2 s3 = C[ 0] - C[i3];
 2862:    
 2863:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2864:    // The corners array is built from getNode in CCW order, so the orientation
 2865:    // is already correct and no ssign factor is needed in the formulas below.
 2866:    //
 2867:    // i3 = nxq(3): the index of the corner after side 2.
 2868:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2869:    //   Quad:     i3 == 3.
 2870:    //
 2871:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2872:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2873:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2874:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2875:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2876:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2877: 
 2878: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2879: 
 2880:    // For triangles, the corner after side 2 is the closing corner where
 2881:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2882:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2883:    // s0 for triangles, s3 for quads.
 2884:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2885: 
 2886:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2887:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2888:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2889:    //
 2890:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2891:    // result is false naturally. No sentinel needed.
 2892:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2893:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2894:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2895:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2896: 
 2897:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2898:    // on the "exit through side I" half of the corner cone, separated by the
 2899:    // approximate angular bisector of the celestial walk. The bisector is
 2900:    // perpendicular to the chord across the corner; the test is the sign of
 2901:    // (xt - corner_vertex) projected onto that chord.
 2902:    //
 2903:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2904:    // (the validity rule sets valid_3 = false), so its computed value for
 2905:    // triangles doesn't matter. No sentinel needed.
 2906:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2907:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2908:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2909:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2910: 
 2911: }
 2912: 
 2913: 
 2914: __inline__ __device__ double Element::computeSignedArea(void) const {
 2915:    // Compute the area of the element
 2916: 
 2917:    Point2 x0, x1, x2, x3;
 2918:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2919: 
 2920: 
 2921:    double res = signedArea(x0, x1, x2);
 2922: 
 2923:    // In the quad case we need to add the area of the other triangle.
 2924:    if (isQuad()) {
 2925:       x3 = getLocalHorizontalNodePosition(3);
 2926:       double ar1 = signedArea(x0, x2, x3);
 2927:       double ar2 = signedArea(x0, x1, x3);
 2928:       double ar3 = signedArea(x1, x2, x3);
 2929:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2930: 
 2931:       res += ar1;
 2932: 
 2933:    }
 2934: 
 2935:    return res;
 2936: }
 2937: 
 2938: 
 2939: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2940:                                                                 (nodes[1]->isDry2()) ||
 2941:                                                                 (nodes[2]->isDry2()) ||
 2942:                                                                 (isQuad() && nodes[3]->isDry2());
 2943: }
 2944: 
 2945: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2946:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2947: }
 2948: 
 2949: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2950:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2951: }
 2952: 
 2953: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2954:    // In boundary sides, the element 1 is nullptr
 2955:    return side->elems[1] == nullptr; 
 2956: }
 2957: 
 2958: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2959:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2960:    // For ics == 2, this function uses local frame coordinates.
 2961: 
 2962:    assert(isQuad());
 2963: 
 2964:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2965:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2966:    // where vxi, veta, vb are vectors and c is the center of the element.
 2967: 
 2968:    Point2 p0, p1, p2, p3;
 2969: 
 2970:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2971: 
 2972:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2973:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2974:    // vectors vxi and veta connect the centers of opposite sides
 2975:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2976:    // vb is zero for parallelogram elements.
 2977:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2978: 
 2979:    //  The bilinear mapping is:
 2980:    //      P(s,t) = C + s*U + t*V + s*t*W
 2981:    //
 2982:    //  where:
 2983:    //    C = centroid (average of four vertices)
 2984:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2985:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2986:    //    W = bilinear correction; measures deviation from parallelogram
 2987:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2988:    //        W = 0 for parallelogram elements.
 2989:    //
 2990:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2991:    //
 2992:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2993:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2994:    //
 2995:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2996:    //
 2997:    //  Geometrically, (L) projects everything onto the direction
 2998:    //  perpendicular to W, where the mapping is purely affine.
 2999:    //
 3000:    //  The dot product with nb retains the nonlinear term:
 3001:    //
 3002:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 3003:    //
 3004:    //  Geometrically, (Q) projects onto the W direction, where
 3005:    //  the nonlinearity lives.
 3006:    //
 3007:    //  We solve (L) for whichever variable has the larger coefficient
 3008:    //  (better conditioned back-substitution), substitute into (Q),
 3009:    //  and get a scalar quadratic in the other variable.
 3010:    // ================================================================
 3011: 
 3012:    // ---- Basis vectors ----
 3013:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3014:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3015:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3016:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3017:    // W: nonlinear correction. Difference between quad and parallelogram.
 3018:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3019:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3020: 
 3021:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3022:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3023:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3024:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3025:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3026: 
 3027:    // ---- nb: direction parallel to W, L1-normalized ----
 3028:    // We don't need a unit vector -- just a well-scaled direction parallel
 3029:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3030:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3031:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3032:    //
 3033:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3034:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3035:    // and the quadratic solver takes its linear path (a ~ 0).
 3036:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 3037:    const double inv_wlen = 1.0 / wlen1;
 3038:    const Vector2 nb = vb * inv_wlen;
 3039: 
 3040:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3041:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3042:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3043:    // What remains is a pure affine relationship between xi and eta.
 3044:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3045:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3046:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3047: 
 3048:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3049:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3050:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3051:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3052:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3053:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3054:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3055: 
 3056:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3057:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3058:    // minimizing round-off amplification.
 3059:    //
 3060:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3061:    // that uses predicated moves.
 3062:    //
 3063:    // if (fabs(Ls) > fabs(Lt)) {
 3064:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3065:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3066:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3067:    //    const double A = -Qw * Lt;
 3068:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3069:    //    const double C =  Qs * Lp - Qp * Ls;
 3070: 
 3071:    //    double eta1, eta2;
 3072:    //    solveQuadratic(A, B, C, eta1, eta2);
 3073: 
 3074:    //    // Pick root with smaller |eta| (domain centered at 0).
 3075:    //    // Ternary-> predicated move, no branch divergence.
 3076:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3077: 
 3078:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3079:    //    xi = (Lp - Lt * eta) / Ls;
 3080: 
 3081:    // } else {
 3082:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3083:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3084:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3085:    //    const double A = -Qw * Ls;
 3086:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3087:    //    const double C =  Qt * Lp - Qp * Lt;
 3088: 
 3089:    //    double xi1, xi2;
 3090:    //    solveQuadratic(A, B, C, xi1, xi2);
 3091: 
 3092:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3093: 
 3094:    //    eta = (Lp - Ls * xi) / Lt;
 3095:    // }
 3096:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3097:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3098:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3099:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3100:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3101: 
 3102:    // Quadratic:  A*r^2 + B*r + C = 0
 3103:    // (same formula for both cases, just with swapped coefficients)
 3104:    const double A = -Qw * Lb;
 3105:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3106:    const double C =  Qa * Lp - Qp * La;
 3107: 
 3108:    double r1, r2;
 3109:    solveQuadratic(A, B, C, r1, r2);
 3110: 
 3111:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3112:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3113: 
 3114:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3115:    const double other = (Lp - Lb * r) / La;
 3116: 
 3117:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3118:    xi  = solve_s ? r     : other;
 3119:    eta = solve_s ? other : r;
 3120: 
 3121: 
 3122:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3123:    xi  = clamp(xi,  -1.0, 1.0);
 3124:    eta = clamp(eta, -1.0, 1.0);
 3125: 
 3126:    // ---- Shape functions ----
 3127:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3128:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3129:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3130:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3131:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3132:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3133:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3134:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3135: 
 3136:    return true;
 3137: }
 3138: 
 3139: /**
 3140:    Compute the shape coordinates of the point (xt,yt) in the element.
 3141:    @param xt (input): x-coordinate of the point
 3142:    @param shpCoords (output): shape coordinates of the point
 3143:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3144:    @return true if the point is inside the element, false otherwise
 3145: **/
 3146: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3147: 
 3148:    // Compute the shape coordinates of the point xt in the element.
 3149:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3150:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3151:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3152:    // from the local frame, so use additional check.
 3153: 
 3154: 
 3155:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3156: 
 3157:    if (isTri()) { // Triangular element
 3158: 
 3159:       // Horizontal local node coordinates. 
 3160:       Point2 x0, x1, x2;
 3161:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3162: 
 3163:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3164:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3165:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3166:       shpCoords[3] = 0.0;
 3167: 
 3168:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3169:       const bool res = (tmpmin >= -small);  
 3170:       
 3171:       // When to fix the negative shape coordinates?
 3172:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3173: 
 3174:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3175:       // then we fix the negative shape coordinates.
 3176:       if ((tmpmin < 0) && fix) {
 3177: 
 3178:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3179:          // keeping the sum of the shape coordinates equal to 1.
 3180:          // I have tested and compared the new algorithm with the old one, and they give
 3181:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3182:          // The new algorithm should be faster since it is branchless.
 3183:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3184:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3185: 
 3186:          shpCoords[0] = (shpCoords[0] + a)*b;
 3187:          shpCoords[1] = (shpCoords[1] + a)*b;
 3188:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3189: 
 3190:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3191:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3192:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3193: 
 3194:          // Update the point coordinates for the new shape coordinates
 3195:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3196:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3197: 
 3198:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3199: 
 3200:       }
 3201: 
 3202:       // Return true if the point is inside the element
 3203:       return res;      
 3204:    }
 3205:    else {
 3206:       assert(isQuad() && "computeShapeCoords");
 3207: 
 3208:       // Horizontal local node coordinates with respect to the original side.
 3209:       Point2 x0, x1, x2, x3;
 3210:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3211: 
 3212:       const double a0 = signedArea(x0, x1, xt);
 3213:       const double a1 = signedArea(x1, x2, xt);
 3214:       const double a2 = signedArea(x2, x3, xt);
 3215:       const double a3 = signedArea(x3, x0, xt);
 3216: 
 3217:       const double minArea = min4(a0, a1, a2, a3);
 3218:       
 3219:       const bool res = (minArea > -small*area);
 3220: 
 3221:       // When to fix the negative shape coordinates?
 3222:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3223: 
 3224:       double xi, eta;    
 3225: 
 3226:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3227:       // Does nothing if ics == 1.
 3228:       assert(origSide != nullptr);
 3229:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3230: 
 3231:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3232: 
 3233:       if (fix) {
 3234:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3235:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3236:          xt.x = interpolate(shpCoords, xn);
 3237:          xt.y = interpolate(shpCoords, yn);
 3238:       }
 3239: 
 3240:       return res;
 3241:    }
 3242: 
 3243: 
 3244:    assert(false && "computeShapeCoords: should never reach this point");
 3245:    return false;  // Never reached
 3246: 
 3247: }
 3248: 
 3249: 
 3250: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3251: // Convert shape coordinates to cartesian coordinates
 3252: 
 3253:    if (isTri()) {
 3254:       // Triangular element
 3255: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3256:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3257:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3258:    }
 3259:    else {
 3260:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3261:    }
 3262: 
 3263: }
 3264: 
 3265: 
 3266: 
 3267: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3268:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3269:    
 3270:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3271: }
 3272: 
 3273: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3274:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3275:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3276:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3277:    return area * dot(gradPhi[i], gradPhi[j]);
 3278: }
 3279: 
 3280: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3281:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3282:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3283:    // The formula for the integral is:
 3284:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3285:    
 3286:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3287:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3288:    const double eta_sum  = eta_n(i) + eta_n(j);
 3289:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3290: 
 3291:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3292:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3293: 
 3294: 
 3295:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3296: }
 3297:    
 3298: 
 3299: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3300:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3301:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3302:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3303:    // The formula is also based on the identity:
 3304:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3305:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3306: 
 3307:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3308: 
 3309: 
 3310: 
 3311:    double res = 0.0;
 3312:    
 3313:    // Quadrature points in xi and eta coordinates
 3314:    #pragma unroll
 3315:    for (int i = 0; i < 4; i++) {
 3316:       // For each quadrature point...
 3317: 
 3318:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3319:       const double eta = p.x;
 3320:       const double xi  = p.y;
 3321: 
 3322:       // Jacobian entries at the Gauss point p
 3323:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3324:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3325:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3326:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3327: 
 3328:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3329:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3330: 
 3331:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3332:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3333:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3334:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3335:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3336: 
 3337:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3338:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3339:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3340:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3341:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3342: 
 3343:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3344:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3345:    }
 3346: 
 3347:    return res;
 3348: }
 3349: 
 3350: 
 3351: /**  Interpolate velocities at a given point (xt,yt,zt)
 3352: 
 3353:    @param xt, yt, zt: coordinates of the point to interpolate
 3354:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3355: 
 3356:    This is done in four steps:
 3357: 
 3358:    1. Find the shape coordinates for the final position in the element.
 3359:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3360:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3361:       z levels at xt, yt at each step.   
 3362:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3363:       horizontally and vertically.
 3364: **/
 3365: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3366:    // Interpolate the velocities at the point xt. 
 3367:    // This function works the same for triangular and quadrilateral elements.
 3368:    double shpCoord[4];
 3369:    Vector3 u_int;
 3370: 
 3371: 
 3372:    // First step is to compute the shape coordinates of (xt,yt)
 3373: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3374:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3375: 
 3376:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3377: 
 3378:    // Second step is to find the level that contains zt
 3379:    // Uses a binary search to find the level
 3380:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3381:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3382:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3383:    int R = nvrt - 1;
 3384: 
 3385:    // Get the z coordinates at the nodes of the element at the levels L and R
 3386:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3387:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3388:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3389: 
 3390: 
 3391:    double zL = interpolate(shpCoord, zLAtNodes);
 3392:    double zR = interpolate(shpCoord, zRAtNodes);
 3393: 
 3394:    // Interpolates vertically the velocities
 3395:    double wght1, wght2;
 3396:    if (xt.z <= zL) {
 3397:       wght1 = 1.0;
 3398:       wght2 = 0.0;
 3399:       xt.z = zL;
 3400:    }
 3401:    else if (xt.z >= zR) {
 3402:       wght1 = 0.0;
 3403:       wght2 = 1.0;
 3404:       xt.z = zR;
 3405:    }
 3406:    else {
 3407:       // Perform a binary search to find the levels between L and R that contain xt.z
 3408:       while (R - L > 1) {
 3409:          int M = (L + R) / 2.0;
 3410: 
 3411:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3412:          double zM = interpolate(shpCoord, zMAtNodes);
 3413:          if (zM < xt.z) 
 3414:          {
 3415:             L = M;
 3416:             zL = zM;
 3417:          }
 3418:          else 
 3419:          {
 3420:             R = M;
 3421:             zR = zM;
 3422:          }
 3423:       }
 3424:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3425:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3426: 
 3427:       wght2 = (xt.z - zL)/(zR - zL);
 3428:       wght1 = 1.0 - wght2;
 3429: 
 3430:    }
 3431: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3432: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3433:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3434:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3435:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3436:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3437: 
 3438:    // Project the velocity from the local frame to the origSide frame
 3439:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3440:    u_int = {uv.x, uv.y, w};
 3441: 
 3442:    // Neither of the interpolated velocities should be NaN
 3443:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3444: 
 3445:    return u_int;
 3446: 
 3447: }
 3448: 
 3449: 
