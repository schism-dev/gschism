10202: __global__ void printMatrix(bool full) {
10203:    // Debugging: print the FEM matrix row for each local node
10204: 
10205:    const int size = mesh->np;
10206:    double sum = 0.0;
10207: 
10208:    for (int idx_node = 0; idx_node < size; idx_node++) {
10209:       const Node *node = mesh->localNodeData + idx_node;
10210: 
10211:       if (full)
10212:          printf("idx_node = %d [%d] diag=%lf, [",
10213:                 idx_node, node->numNodes, *(node->coeffDiag));
10214: 
10215:       // Full CSR row length = numNodes + 1 (includes diagonal)
10216:       for (int k = 0; k < node->numNodes + 1; k++)
10217:          sum += node->coeffRow[k];
10218: 
10219:       for (int j = 0; j < node->numNodes; j++) {
10220:          const Node *nbNode = node->nodes[j];
10221:          const double aij = node->coeffRow[node->csrSlot[j]];
10222:          if (full && aij != 0.0)
10223:             printf("%d:%f,  ", nbNode->idx, aij);
10224:       }
10225: 
10226:       if (full) printf("]\n");
10227:    }
10228: 
10229:    if (!full) printf("sum=%lf\n", sum);
10230: }
