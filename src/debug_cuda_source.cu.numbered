 8051: __global__ void getStructSizes(int* sizes)  {
 8052:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8053:       sizes[0] = (int)sizeof(Node);
 8054:       sizes[1] = (int)sizeof(Element);
 8055:       sizes[2] = (int)sizeof(Side);
 8056:       sizes[3] = (int)sizeof(NodeBoundary);
 8057:       sizes[4] = (int)sizeof(SideBoundary);
 8058:       sizes[5] = (int)sizeof(BoundarySegment);
 8059: }
