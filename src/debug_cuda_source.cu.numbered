 3666: 
 3667: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3668:    // Computes the z coordinate at level k.
 3669:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3670:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3671:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3672:    // used 
 3673: 
 3674:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3675:    
 3676:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3677: 
 3678:    if (isDry2()) return 0.0;  
 3679: 
 3680:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3681: 
 3682:    if constexpr(ivcor == 2) {
 3683: 
 3684:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3685:       const double h_c = mesh->h_c;
 3686:       const double theta_f = mesh->theta_f;
 3687:       const double sinh_theta_f = mesh->sinh_theta_f;
 3688: 
 3689: 
 3690:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3691:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3692:       // once per time step/node. XXXX
 3693:       // CHECK: updateZCoordData
 3694: 
 3695:       //  To simplify comparisons, I define index versions of count variables.
 3696:       if      (k == ivrt)     return eta2; 
 3697:       else if (k == izlev)    return -hmod2;
 3698:       else if (k == kb)       return -depth;
 3699:       else if (k < izlev)     return mesh->ztot[k];
 3700:       else if (k > izlev) {
 3701:          const int ksig = k - izlev;
 3702: 
 3703:          if (hmod2 <= h_c) {
 3704:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3705: 
 3706:          } 
 3707:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3708:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3709:             assert(false && "compZCoord: invalid h_c\n");
 3710:          } 
 3711:          else {
 3712:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3713:                    h_c * mesh->sigma[ksig] + 
 3714:                    (hmod2 - h_c) * mesh->cs[ksig];
 3715:          }
 3716:       } else { 
 3717:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3718:       }
 3719: 
 3720:    }
 3721:    else {  // if constexpr(ivcor == 1)
 3722:       if (k <= kb)        return -depth; 
 3723:       else if (k == ivrt) return eta2;
 3724:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3725: 
 3726:    }
 3727:    
 3728:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3729:    return 0.0;
 3730: }
 3731: 
 3732: 
 3733: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3734:    // Computes the bottom drag Cd based on the selected nchi
 3735: 
 3736:    if constexpr(nchi == 0) {
 3737:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3738:       Cd = drag;  // Read from drag file
 3739: 
 3740:    } else if constexpr(nchi == 1) {
 3741:       // 
 3742: 
 3743:       bool ltmp = false; // for WBL iteration
 3744: 
 3745:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3746:       if (isDry || (rough == 0.0)) {
 3747:          Cd = 0.0;
 3748: 
 3749:       } else { //roughness >0 
 3750:          
 3751:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3752: 
 3753:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3754: 
 3755:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3756: 
 3757:       } // if rough
 3758: 
 3759:    } else if constexpr(nchi == -1) {
 3760:    // Manning 
 3761:  
 3762:       const double htot = max(hmin_man, htot2()); 
 3763:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3764: 
 3765:    } else {
 3766:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3767:       
 3768:    } // if nchi
 3769: 
 3770: }
 3771: 
 3772: 
 3773: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3774:    // Checks if a side in on the boundary
 3775:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3776: 
 3777:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3778:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3779: 
 3780:    // Indices of the nodes that form the side
 3781:    //
 3782:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3783:    const int n1 = side.n1->idx;
 3784:    const int n2 = side.n2->idx;
 3785:    isLand = false;
 3786:    
 3787: 
 3788:    // Check if the side is on a land boundary
 3789:    for (int i = 0; i < nland; i++) {
 3790:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3791:          // Consecutive nodes in the land boundary segment
 3792:          const int b1 = ilnd[i + j*nland];
 3793:          const int b2 = ilnd[i + (j + 1)*nland];
 3794: 
 3795:          assert(b1 != -1 && b2 != -1);
 3796: 
 3797:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3798:             
 3799:             isLand = true;
 3800:             return i;
 3801:          }
 3802:       }
 3803:    }
 3804: 
 3805:    // Check if the side is on an open boundary
 3806:    for (int i = 0; i < nope; i++) {
 3807:       for (int j = 0; j < nond[i] - 1; j++) {
 3808:          // Consecutive nodes in the open boundary segment
 3809:          const int b1 = iond[i + j*nope];
 3810:          const int b2 = iond[i + (j + 1)*nope];
 3811: 
 3812:          assert(b1 != -1 && b2 != -1);
 3813: 
 3814:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3815:             isLand = false;
 3816:             return i;
 3817:          }
 3818:       }
 3819:    }
 3820: 
 3821:    return -1;
 3822: }
 3823: 
 3824: 
 3825: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3826:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3827:                                     double *wind_rotate_angle, 
 3828:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3829:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3830:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3831:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3832:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3833: 
 3834:    NODE(pnode);  
 3835:    const int i = idx_node;
 3836:    Node &node(*pnode);
 3837: 
 3838:    node.idx = i;
 3839: 
 3840:    const int idxNodeStart = nodeNeighNodesStart[i];
 3841:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3842:    node.numNodes = idxNodeEnd - idxNodeStart;
 3843:    node.nodes = nodeNeighNodes + idxNodeStart;
 3844:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3845: 
 3846: 
 3847: 
 3848:    const int idxElemStart = nodeNeighElemsStart[i];
 3849:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3850:    node.numElements = idxElemEnd - idxElemStart;
 3851:    node.elements = nodeNeighElems + idxElemStart;
 3852: 
 3853: 
 3854:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3855:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3856:       const int partNode = localNodePart[idxNodeGlobal]; 
 3857:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3858: 
 3859:       Node *node_ptr = nodes[partNode] + idxNode;
 3860:       
 3861:       nodeNeighNodes[idx] = node_ptr;
 3862:    }
 3863: 
 3864: 
 3865:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3866:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3867:       const int partElem = localElemPart[idxElemGlobal];
 3868:       const int idxElem  = localElemIndices[idxElemGlobal];
 3869: 
 3870:       Element *elem_ptr = elems[partElem] + idxElem;
 3871: 
 3872:       nodeNeighElems[idx] = elem_ptr;
 3873:    }      
 3874: 
 3875:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3876:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3877: 
 3878:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3879: 
 3880:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3881:    if constexpr(ics == 1) {
 3882:       node.p.x   = node_coords[i * 3];
 3883:       node.p.y   = node_coords[i * 3 + 1];
 3884:       node.gz = 0.0;
 3885: 
 3886:       if (use_ll) {                                    // <-- add
 3887:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3888:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3889:       }  
 3890: 
 3891:    } else {
 3892:       const double lon = deg2rad*node_coords[i * 3];
 3893:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3894: 
 3895:       Point3 p = computeXYZfromLatLon(lat, lon);
 3896:       node.p = toVector2(p);
 3897:       node.gz = p.z;
 3898:       node.lon = lon;
 3899:       node.lat = lat;
 3900: 
 3901:       #ifdef USE_FRAMES
 3902:       node.setFrame(lat, lon);
 3903:       #endif
 3904: 
 3905: 
 3906:    }
 3907: 
 3908:    node.depth = node_coords[i * 3 + 2];
 3909: 
 3910:    node.numSides = 0;
 3911: 
 3912:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3913:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3914:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3915:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3916:    else assert(false && "populateNodes: selected nchi not implemented.");
 3917:    
 3918:    if constexpr(ivcor == 1) 
 3919:    {  
 3920:       node.kb = kb[i];
 3921:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3922:    }
 3923: 
 3924:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3925:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3926:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3927: 
 3928:    
 3929:    // Links the node to the boundary information
 3930:    if (isbnd[i] >= 0) {
 3931:      
 3932:       // Get the index of the node boundary
 3933:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3934: 
 3935:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3936:       node.nodeBnd->node = &node;
 3937: 
 3938:       node.nodeBnd->sideBnd1 = nullptr;
 3939:       node.nodeBnd->sideBnd2 = nullptr;
 3940: 
 3941:       if (isbnd[i]>=0) {
 3942: 
 3943:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3944:          
 3945:          node.nodeBnd->segment->ifltype = 7777 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3946:          node.nodeBnd->segment->iettype = 7777; // XXXXXXXXX
 3947: 
 3948:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3949:          node.nodeBnd->segment->clen  = nan("1");
 3950:          node.nodeBnd->segment->carea = nan("1");
 3951: 
 3952:       }
 3953:    } else {
 3954: 
 3955:       node.nodeBnd = nullptr; // For internal nodes
 3956: 
 3957:       if (isbnd[i] == landSegment) {
 3958:          node.nodeBnd = &landBoundaryNode;
 3959:          node.nodeBnd->segment = &landBoundarySegment;
 3960:       }
 3961:       
 3962:    }
 3963:    
 3964:    // XXXX GAUSSIAN HILL VELOCITIES
 3965:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3966:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3967:          constexpr double rot_per = 3000.0;
 3968:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3969:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3970:       // XXXXX
 3971:    #endif
 3972: 
 3973: }
 3974: 
 3975: 
 3976: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3977:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3978:                                     double *wind_rotate_angle,   
 3979:                                     int *isdel, int *isidenode, int *isbnd,
 3980:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3981:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3982:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3983:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3984:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3985:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3986:                                     double *drag, double *roughness) {
 3987: 
 3988: 
 3989:    SIDE(pside);
 3990:    Side &side(*pside);
 3991:    const int i = idx_side;
 3992: 
 3993:    side.idx = i;  
 3994:    
 3995:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3996:    const double fc   = 2.0*omega_e*sin(sfea0);
 3997:    const double beta = 2.0*omega_e*cos(sfea0);
 3998: 
 3999:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4000: 
 4001:    // finding the pointer to the nodes that form the side
 4002:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4003:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4004: 
 4005:    const int locidx_n1 = localNodeIndices[idx_n1];
 4006:    const int locidx_n2 = localNodeIndices[idx_n2];
 4007:    const int part_n1 =   localNodePart[idx_n1];
 4008:    const int part_n2 =   localNodePart[idx_n2];
 4009: 
 4010:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4011:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4012: 
 4013: 
 4014:    // Counts the number of sides connected to each node
 4015:    side.n1->numSides++;
 4016:    side.n2->numSides++;
 4017: 
 4018:    // Side boundary type
 4019:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4020:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4021: 
 4022:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4023:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4024:    {
 4025:       bool isLand = false;
 4026:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4027:       
 4028:       if (isbs > -1) {
 4029:          // assert(isLand || isbs>=0);
 4030:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4031: 
 4032:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4033: 
 4034:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4035:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4036: 
 4037:          assert (isLand == side.sideBnd->segment->isLand);
 4038: 
 4039:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4040:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4041:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4042: 
 4043:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4044:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4045:          
 4046:          side.sideBnd->side = &side;
 4047: 
 4048:       }
 4049:       else {
 4050:          side.sideBnd = nullptr;
 4051:       }
 4052:    }
 4053:    else 
 4054:    {
 4055:       side.sideBnd = nullptr;
 4056:    }
 4057: 
 4058: 
 4059:    // finding the pointer to the elements that share the side
 4060:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4061:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4062: 
 4063:    if (idx_e1 > -1) {
 4064:       const int locidx_e1 = localElemIndices[idx_e1];
 4065:       const int part_e1 =  localElemPart[idx_e1];
 4066:       side.elems[0] = elems[part_e1] + locidx_e1;
 4067: 
 4068:    }
 4069:    else {
 4070:       side.elems[0] = nullptr;
 4071:    }
 4072: 
 4073:    if (idx_e2 > -1) {
 4074:       const int locidx_e2 = localElemIndices[idx_e2];
 4075:       const int part_e2 =  localElemPart[idx_e2];
 4076:       side.elems[1] = elems[part_e2] + locidx_e2;
 4077:    }
 4078:    else {
 4079:       side.elems[1] = nullptr;
 4080:    }
 4081:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4082:       
 4083:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4084:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4085:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4086:          
 4087:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4088:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4089:       // printf("sideBnd: %p\n", side.sideBnd);
 4090:       // assert(false && "Side has no elements and no boundary");
 4091:    }
 4092:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4093: 
 4094:    // Compute the center of the side
 4095:    side.center = 0.5*(side.n1->p + side.n2->p);
 4096: 
 4097:    #ifdef USE_FRAMES
 4098:    side.setFrame();
 4099:    #endif
 4100: 
 4101:    // Normal, unitary vector to the side
 4102:    if constexpr(ics == 1) {
 4103:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4104:       side.n = normalize(side.n);
 4105:    }
 4106:    else {
 4107:       // Unit side vector in 3D cartesian coordinates
 4108:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4109: 
 4110:       nSide = normalize(nSide);
 4111: 
 4112:       // Its cross product with the unit local z-axis vector (nUp) is the
 4113:       // normal vector we are looking for.
 4114:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4115: 
 4116:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4117:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4118:       side.n = -normalize(n2D); 
 4119: 
 4120:    }
 4121: 
 4122:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4123:    side.shapiro = shapiro0;
 4124: 
 4125:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4126:    // XXXX
 4127:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4128:    constexpr double rot_per=3000.0;
 4129:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4130:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4131:    // XXXXX      
 4132:    #endif
 4133:    // Compute the z level at the center of the side
 4134:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4135:    
 4136:    // Compute the length of the side
 4137:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4138: 
 4139: 
 4140:    // Compute the Coriolis coefficient
 4141: 
 4142:    if constexpr(ncor == -1 || ncor == 0) {
 4143:       side.coriolis = coricoef;
 4144:    }
 4145:    else {
 4146:       const double sphi = side.lat();  // Latitude at the center of the side
 4147: 
 4148:       assert(use_ll && "use_ll must be true when ncor > 0");
 4149: 
 4150:       if constexpr(ics == 1) {
 4151:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4152:       }
 4153:       else { // ics == 2
 4154:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4155:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4156:       }
 4157: 
 4158:    }
 4159: 
 4160: }
 4161: 
 4162: 
 4163: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4164:    double *node_coords, double *node_coords_ll, bool use_ll,
 4165:    double *wind_rotate_angle,   
 4166:    int *isdel, int *isidenode, int *isbnd,
 4167:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4168:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4169:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4170:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4171:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4172:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4173:    double *drag, double *roughness) {
 4174: 
 4175:    ELEM(pelem);
 4176:    Element &elem(*pelem);
 4177:    const int i = idx_elem;
 4178: 
 4179:    elem.idx = i;
 4180: 
 4181:    for (int j = 0; j < i34[i]; j++) {
 4182:       const int idxNode = elnode[i*4 + j];  
 4183:       const int idxSide = elside[i*4 + j];
 4184:       
 4185:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4186:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4187: 
 4188:       // Find the neighboring element  
 4189:       if (elem.sides[j]->elems[0] == &elem) {
 4190:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4191:       }
 4192:       else {
 4193:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4194:       }
 4195:       
 4196:    }
 4197: 
 4198:    elem.i34 = i34[i];
 4199: 
 4200:    // Compute the barycenter of the element and its depth
 4201:    elem.center = {0.0, 0.0};
 4202:    elem.depth = 1e10;
 4203:    for (int j = 0; j < i34[i]; j++) {
 4204: 
 4205:       elem.center += elem.nodes[j]->p/i34[i];
 4206:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4207:    }
 4208: 
 4209:    #ifdef USE_FRAMES
 4210:    elem.setFrame();
 4211:    #endif
 4212: 
 4213:    elem.area = elem.computeSignedArea(); 
 4214:    elem.radius = sqrt(elem.area)/pi; 
 4215:    
 4216:    // Determines which way the normal vector to each side is oriented.
 4217:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4218:    for (int j = 0; j < i34[i]; j++)  
 4219:    {
 4220:       if (elem.sides[j]->elems[0] == &elem) {
 4221:          elem.ssign[j] =  1.0;
 4222:       }
 4223:       else {
 4224:          elem.ssign[j] = -1.0;
 4225:       }
 4226: 
 4227:    }
 4228: 
 4229:   
 4230: 
 4231:    // Derivatives of shape functions
 4232:    //  For ics=2, this is done in the element frame
 4233:    //  For quads, the derivative is evaluated at centroid
 4234:    for (int j = 0; j < elem.i34; j++) {
 4235:       const double area = elem.area;
 4236:       const int id2 = elem.nxq(1 + j);
 4237:       const int id3 = elem.nxq(2 + j);
 4238:       const int id4 = elem.nxq(3 + j);
 4239:       if (elem.isTri()) {
 4240:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4241:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4242:          // da1/dx = (y1 - y2)/(2*area)
 4243: 
 4244:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4245:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4246:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4247: 
 4248:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4249:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4250: 
 4251:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4252: 
 4253:       }
 4254:       else  { // Quad; evaluate at centroid
 4255: 
 4256:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4257:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4258:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4259: 
 4260:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4261:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4262: 
 4263:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4264:       } // if Tri
 4265: 
 4266:    } // for j   
 4267:    
 4268:    
 4269: 
 4270: }
 4271: 
 4272: 
 4273: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4274:                                             double *emo, double *efa, 
 4275:                                             double *umo, double *ufa, 
 4276:                                             double *vmo, double *vfa,
 4277:                                             int *ifltype, int *iettype) {
 4278: 
 4279:    NODE_BND(nodeBnd);
 4280:    const int idx = idx_node_bnd;    
 4281: 
 4282:    nodeBnd->idx = idx;
 4283: 
 4284:    // Need to find the segment index and the index of the node on the segment
 4285:    int idxNode = -1;
 4286:    int iseg, i;
 4287:    for (iseg = 0; iseg < nope; iseg++) {
 4288:       // for each segment...
 4289:       for (i = 0; i < nond[iseg]; i++) {
 4290:          idxNode = iond[iseg + i*nope];
 4291:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4292:          
 4293:       }
 4294:    }
 4295: 
 4296:    assert(iseg < nope && "iseg is out of bounds");
 4297: 
 4298: found: // Jumped here when the node was found
 4299: 
 4300:    nodeBnd->isEssentialBC = true;
 4301:    nodeBnd->elbc = 0.0;
 4302: 
 4303:    nodeBnd->segment->ifltype = ifltype[iseg];
 4304:    nodeBnd->segment->iettype = iettype[iseg];
 4305: 
 4306:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4307: 
 4308:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4309: 
 4310:       nodeBnd->efa[jfr] = efa[idx2];
 4311:       nodeBnd->emo[jfr] = emo[idx2];
 4312:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4313:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4314: 
 4315:    }
 4316:         
 4317: 
 4318: }
 4319: 
 4320: __device__ void Mesh::populateBoundarySideLinks(void) {
 4321: 
 4322:    SIDE_BND(sideBnd);
 4323: 
 4324:    const Side *side = sideBnd->side;
 4325: 
 4326:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4327:    // and the rightSide is the side s that has s->n1 == side->n2
 4328:    for (int i = 0; i < mesh->nbs; i++) {
 4329: 
 4330:       Side *s = &mesh->localSideData[i];
 4331: 
 4332:       if (s == side) continue;  // Do not link the side to itself
 4333:    
 4334:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4335:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4336:    }
 4337:    
 4338: }
