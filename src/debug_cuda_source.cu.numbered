  568: struct Element {
  569: 
  570:    // Geometry information
  571:    int idx;                   // Index of the element
  572:    int i34;                   // Number of sides for the element 
  573:    Side *sides[4];            // Sides of the element
  574:    Node *nodes[4];            // Nodes of the element
  575:    Element *nghbElems[4];     // Neighbors of the element
  576: 
  577:    int kb;                    // Bottom index of the element
  578:    double area;               // Area of the element
  579:    double ssign[4];           // Sign associated with each side of an element
  580:    double radius;             // Element equivalent radii
  581: 
  582:    #ifdef USE_FRAMES
  583:    Frame frame;
  584:    #endif
  585: 
  586:    Vector2 gradPhi[4];        // Derivatives of shape functions
  587:    Vector2 gradEta;           // Gradient of free surface elevation
  588:    Vector2 gradPr;            // Gradient of pressure    
  589:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  590: 
  591:    bool isDry;                // True if the element is dry
  592: 
  593:    Vector2 center;            // Element center coordinates
  594: 
  595:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  596:    double depth;              // Depth at element (min of all nodes)
  597:    double z[nvrt];            // z-coord  (local frame - vertical up)
  598: 
  599:    // Physical information
  600:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  601: 
  602:    static const bool isblock = false;              // Always false
  603: 
  604:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  605:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  606: 
  607:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  608:    
  609: 
  610:    double vsource;            // Volumetric source/sink term [m^3/s]
  611: 
  612:    double rho[nvrt];          // Density at each prism center
  613:    double rho_mean[nvrt];     // Mean density at each prism center
  614:    CubicSpline rho_spl;
  615:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  616:    double rho_z[nvrt];        // First derivative of density at each prism center
  617:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  618:    
  619: 
  620:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  621: 
  622:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  623:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  624: 
  625:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  626:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  627: 
  628:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  629:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  630:       // Find the local index of the node in the element (0,1,2,3)
  631:       int res = __ffs((nodes[0] == node) | 
  632:                      ((nodes[1] == node) << 1) | 
  633:                      ((nodes[2] == node) << 2) | 
  634:                      ((nodes[3] == node) << 3)) - 1;
  635:       
  636:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  637:       return res;  
  638:    }
  639: 
  640:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  641:       // Find the local index of the side in the element (0,1,2,3)
  642:       int res = __ffs((sides[0] == side) | 
  643:                      ((sides[1] == side) << 1) | 
  644:                      ((sides[2] == side) << 2) | 
  645:                      ((sides[3] == side) << 3)) - 1;
  646:       
  647:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  648:       return res;
  649:    }
  650: 
  651: 
  652:    __inline__ __device__ int findLevel(double z1, int k) const {
  653:       // Starting at index k, find sequentially the level that contains z
  654: 
  655:       // For testing purposes, forgets k and performs a full search.
  656:       for (k = kb; k < nvrt - 1; k++) {
  657:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  658:       }
  659:       return nvrt - 2;
  660: 
  661: 
  662:       // if z is already betweeen z[k] and z[k+1], return k
  663:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  664:       else if (z1 <  z[k]) { 
  665:          // Search for increasing levels
  666:          for (int kk = k; kk < nvrt - 1; kk++) {
  667:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  668:          }
  669:          return nvrt - 1;
  670:       }
  671:       else {
  672:          // Search for decreasing levels
  673:          for (int kk = k; kk >= kb; kk--) {
  674:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  675:          }
  676:          return 0;
  677:       }
  678:    }
  679: 
  680:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  681:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  682: 
  683: 
  684:    __device__ __forceinline__ double centerZ(void) const;
  685: 
  686:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  687:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  688:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  689:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2) const;
  690:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  691: 
  692: 
  693:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  694:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  695:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  696:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  697:        const double eta = (idxNode & 1) ? +g : -g;
  698:        const double xi  = (idxNode & 2) ? +g : -g;
  699:        return {eta, xi};
  700:    }  
  701: 
  702:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  703:    __device__ __forceinline__ double etaSign(int idxNode) const {
  704:       // bit1: 0 -> -1, 1 -> +1
  705:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  706:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  707:    }
  708: 
  709:    __device__ __forceinline__ double xiSign(int idxNode) const {
  710:       // +1 if (bit0 XOR bit1), else -1
  711:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  712:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  713: 
  714:    }
  715: 
  716:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  717:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  718:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  719:    }
  720: 
  721:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  722:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  723:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  724:    }   
  725: 
  726:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  727:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  728:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  729:    }      
  730:    
  731:    __inline__ __device__ double detJ_eta(void) const;
  732: 
  733:    __inline__ __device__ double detJ_xi(void) const;
  734: 
  735:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  736: 
  737:    // Check if the element is dry using the more up-to-date elevation.
  738:    __inline__ __device__ bool isDry2(void) const;
  739: 
  740:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  741: 
  742:    __inline__ __device__ double computeSignedArea(void) const;
  743: 
  744:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  745:       // Nudges the point (x,y) to the barycenter of the element
  746: 
  747:       p = (1.0 - btrack_nudge)*p + btrack_nudge*center;
  748:    }
