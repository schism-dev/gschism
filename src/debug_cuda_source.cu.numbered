 2528: 
 2529: __device__ void Node::updateKb(void) {
 2530: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2531: 
 2532:    if constexpr(ivcor == 1) return;
 2533: 
 2534: 
 2535:    // Check if node is wet
 2536:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2537: 
 2538:    if (isDry) return;
 2539: 
 2540:    if constexpr(ivcor == 2) {  // SZ coordinates
 2541:       
 2542:       // Compute bottom level index
 2543:       if (depth <= mesh->h_s) {
 2544:          kb = mesh->kz - 1;
 2545:       } else {
 2546:          kb = -1;
 2547:          int L = 0;
 2548:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2549:          
 2550:          while (L <= R) {
 2551:             int M = (R + L) / 2;
 2552: 
 2553:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2554:             
 2555:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2556:                R = M;
 2557:             } else {
 2558:                L = M;
 2559:             }
 2560: 
 2561:             if (R - L == 1) {
 2562:                kb = L;
 2563:                break;
 2564:             }
 2565:          }
 2566:       }
 2567:    } 
 2568: }
 2569: 
 2570: 
 2571: __device__ __inline__ void Node::updateZCoordData(void) {
 2572: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2573: 
 2574:    if (isDry2()) return;
 2575: 
 2576:    if constexpr(ivcor == 2) {  // SZ coordinates
 2577:       
 2578:       // Compute bottom level index
 2579:       if (depth <= mesh->h_s) {
 2580:             kb = mesh->kz;
 2581:       } else {
 2582:          kb = -1;
 2583:          for (int i = 0; i < mesh->kz; i++) {
 2584:             // XXX Use binary search
 2585:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2586:                kb = i;
 2587:                break;
 2588:             }
 2589:          }
 2590:       }
 2591:    } 
 2592:    else if (ivcor == 1) {  // Localized sigma
 2593:       // Do nothing
 2594:    }
 2595: 
 2596: }
 2597: 
 2598: __device__ double Node::compZCoord(int k) const {
 2599:    // Computes the z coordinate at level k.
 2600:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2601:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2602:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2603:    // used 
 2604:    
 2605:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2606: 
 2607:   
 2608:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2609: 
 2610:    if constexpr(ivcor == 2) {
 2611: 
 2612:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2613:       const int kz = mesh->kz;
 2614:       const double h_c = mesh->h_c;
 2615:       const double theta_f = mesh->theta_f;
 2616:       const double sinh_theta_f = mesh->sinh_theta_f;
 2617: 
 2618:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2619:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2620:       // once per time step/node.
 2621:       // CHECK: updateZCoordData
 2622: 
 2623:       if      (k == nvrt-1)      return eta2; 
 2624:       else if (k == kz)          return -hmod2;
 2625:       else if (k == kb)          return -depth;
 2626:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2627:       else if (k > kz) {
 2628:          const int ksig = k - kz + 1;
 2629: 
 2630:          if (hmod2 <= h_c) {
 2631: printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2632:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2633:          } 
 2634:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2635:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2636:             assert(false && "ZCOOR: invalid h_c\n");
 2637:          } 
 2638:          else {
 2639: printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2640:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2641:                          h_c * mesh->sigma[ksig] + 
 2642:                          (hmod2 - h_c) * mesh->cs[ksig];
 2643:          }
 2644:       } else { 
 2645:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2646:       }
 2647: 
 2648:    }
 2649:    else if constexpr(ivcor == 1) {
 2650:       if (k == kb) return -depth;
 2651:       else if (k == nvrt-1) return eta2;
 2652:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2653:    }
 2654:    
 2655:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2656:    return 0.0;
 2657: }
 2658: 
 2659: 
 2660: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2661:    // Checks if a side in on the boundary
 2662:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2663: 
 2664:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2665:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2666: 
 2667:    // Indices of the nodes that form the side
 2668:    const int n1 = side.n1->idx;
 2669:    const int n2 = side.n2->idx;
 2670: 
 2671:    // Check if the side is on a land boundary
 2672:    for (int i = 0; i < nland; i++) {
 2673:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2674:          // Consecutive nodes in the land boundary segment
 2675:          const int b1 = ilnd[i*mnlnd + j];
 2676:          const int b2 = ilnd[i*mnlnd + j + 1];
 2677: 
 2678:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2679:             isLand = true;
 2680:             return i;
 2681:          }
 2682:       }
 2683:    }
 2684: 
 2685:    // Check if the side is on an open boundary
 2686:    for (int i = 0; i < nope; i++) {
 2687:       for (int j = 0; j < nond[i] - 1; j++) {
 2688:          // Consecutive nodes in the open boundary segment
 2689:          const int b1 = iond[i*mnond + j];
 2690:          const int b2 = iond[i*mnond + j + 1];
 2691: 
 2692:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2693:             isLand = false;
 2694:             return i;
 2695:          }
 2696:       }
 2697:    }
 2698:    return -1;
 2699: }
 2700: 
 2701: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2702:                 double *node_coords, double *wind_rotate_angle, 
 2703:                 int *isdel, int *isidenode, int *isbnd,
 2704:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2705:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2706:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2707:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2708:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2709:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2710:                 double *emo, double *efa, 
 2711:                 double *umo, double *ufa, 
 2712:                 double *vmo, double *vfa) {
 2713: 
 2714:    printf("Populating mesh for partition %d\n", partNum);
 2715: 
 2716:    // Horizontal grid
 2717:    printf("Processing %d nodes\n", np);    
 2718: 
 2719: 
 2720:    int idxNodeBoundary = 0;  
 2721:    for (int i = 0; i < np; i++)
 2722:    {
 2723:       Node &node = localNodeData[i];
 2724: 
 2725:       node.idx = i;
 2726: 
 2727:       const int idxNodeStart = nodeNeighNodesStart[i];
 2728:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2729:       node.numNodes = idxNodeEnd - idxNodeStart;
 2730:       node.nodes = nodeNeighNodes + idxNodeStart;
 2731:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2732: 
 2733: 
 2734: 
 2735:       const int idxElemStart = nodeNeighElemsStart[i];
 2736:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2737:       node.numElements = idxElemEnd - idxElemStart;
 2738:       node.elements = nodeNeighElems + idxElemStart;
 2739: 
 2740: 
 2741:       
 2742:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2743:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2744:          const int partNode = localNodePart[idxNodeGlobal]; 
 2745:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2746: 
 2747: 
 2748:          Node *node_ptr = nodes[partNode] + idxNode;
 2749:          
 2750:          nodeNeighNodes[idx] = node_ptr;
 2751:       }
 2752: 
 2753:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2754:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2755:          const int partElem = localElemPart[idxElemGlobal];
 2756:          const int idxElem  = localElemIndices[idxElemGlobal];
 2757: 
 2758:          Element *elem_ptr = elems[partElem] + idxElem;
 2759: 
 2760:          nodeNeighElems[idx] = elem_ptr;
 2761:       }      
 2762: 
 2763: 
 2764:       node.wind_angle = wind_rotate_angle[i];
 2765: 
 2766:       // Element **elements; // pointer to the elements connected to this node
 2767:       // int numElements;   // number of elements shared by this node
 2768: 
 2769:       node.p.x   = node_coords[i * 3];
 2770:       node.p.y   = node_coords[i * 3 + 1];
 2771:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2772:       node.depth = node_coords[i * 3 + 2];
 2773: 
 2774:       node.numSides = 0;
 2775: 
 2776: 
 2777:       // Links the node to the boundary information
 2778:       if (isbnd[i] >= 0) {
 2779:        
 2780:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2781:          node.nodeBnd->node = &node;
 2782: 
 2783:          node.nodeBnd->sideBnd1 = nullptr;
 2784:          node.nodeBnd->sideBnd2 = nullptr;
 2785: 
 2786:          if (isbnd[i]>=0) {
 2787: 
 2788:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2789:             
 2790:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2791:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2792: 
 2793:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2794:             node.nodeBnd->segment->clen  = nan("1");
 2795:             node.nodeBnd->segment->carea = nan("1");
 2796: 
 2797:          }
 2798: //          else {
 2799: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2800: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2801: //          }
 2802:          
 2803:          idxNodeBoundary++;
 2804:       }
 2805:       else {
 2806:          node.nodeBnd = nullptr; // For internal nodes
 2807: 
 2808:          if (isbnd[i] == landSegment) {
 2809:             node.nodeBnd = &landBoundaryNode;
 2810:             node.nodeBnd->segment = &landBoundarySegment;
 2811:          }
 2812:          // node.nodeBnd->node = &node;
 2813:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2814:          // // node.nodeBnd = nullptr;
 2815:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2816:         
 2817:       }
 2818: 
 2819:       // XXXX GAUSSIAN HILL VELOCITIES
 2820: #ifdef GAUSSIAN_HILL_VELOCITIES
 2821:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2822:          constexpr double rot_per = 3000.0;
 2823:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2824:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2825:       // XXXXX
 2826: #endif
 2827:    }
 2828: 
 2829:    nbp = idxNodeBoundary;
 2830: 
 2831:    printf("Processing %d sides\n", ns);
 2832:    int idxSideBoundary = 0;
 2833:    for (int i = 0; i < ns; i++)
 2834:    {
 2835:       Side &side = localSideData[i];
 2836:       side.idx = i;
 2837:       // finding the pointer to the nodes that form the side
 2838:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2839:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2840: 
 2841:       const int locidx_n1 = localNodeIndices[idx_n1];
 2842:       const int locidx_n2 = localNodeIndices[idx_n2];
 2843:       const int part_n1 =   localNodePart[idx_n1];
 2844:       const int part_n2 =   localNodePart[idx_n2];
 2845: 
 2846:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2847:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2848: 
 2849:       // Counts the number of sides connected to each node
 2850:       side.n1->numSides++;
 2851:       side.n2->numSides++;
 2852: 
 2853:       // Normal, unitary vector to the side
 2854:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2855:       side.n = normalize(side.n);
 2856: 
 2857:       // Side boundary type
 2858:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2859:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2860: 
 2861:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2862:       // If both nodes are on the boundary, then the side may be on the boundary
 2863:       {
 2864:          bool isLand = false;
 2865:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2866: 
 2867:          if (isbs > -1) {
 2868:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2869:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2870:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2871: 
 2872:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2873:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2874:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2875: 
 2876:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2877:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2878:           
 2879:             side.sideBnd->side = &side;
 2880:             idxSideBoundary++;
 2881: 
 2882:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2883:          }
 2884:          
 2885: 
 2886:       // }
 2887:       // 
 2888: 
 2889: 
 2890: 
 2891: 
 2892: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2893: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2894: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2895: //       {
 2896: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2897: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2898: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2899: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2900: // if (side.sideBnd->segment == nullptr) continue;
 2901: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2902: //          else                  side.sideBnd->segment = n2bnd->segment;
 2903: //          side.sideBnd->side = &side;
 2904: //          idxSideBoundary++;
 2905: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2906:       }
 2907:       else side.sideBnd = nullptr;
 2908: 
 2909:       nbs = idxSideBoundary;
 2910: 
 2911:       // finding the pointer to the elements that share the side
 2912:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2913:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2914: 
 2915:       if (idx_e1 > -1) {
 2916:          const int locidx_e1 = localElemIndices[idx_e1];
 2917:          const int part_e1 =  localElemPart[idx_e1];
 2918:          side.elems[0] = elems[part_e1] + locidx_e1;
 2919: 
 2920:       }
 2921:       else {
 2922:          side.elems[0] = nullptr;
 2923:       }
 2924: 
 2925:       if (idx_e2 > -1) {
 2926:          const int locidx_e2 = localElemIndices[idx_e2];
 2927:          const int part_e2 =  localElemPart[idx_e2];
 2928:          side.elems[1] = elems[part_e2] + locidx_e2;
 2929:       }
 2930:       else {
 2931:          side.elems[1] = nullptr;
 2932:       }
 2933: 
 2934:       // Compute the center of the side
 2935:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2936: 
 2937:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 2938:       side.shapiro = shapiro0;
 2939: 
 2940: #ifdef GAUSSIAN_HILL_VELOCITIES
 2941: // XXXX
 2942: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2943: constexpr double rot_per=3000.0;
 2944: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2945: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2946: // XXXXX      
 2947: #endif
 2948:       // Compute the z level at the center of the side
 2949:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2950: 
 2951:       // Compute the length of the side
 2952:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2953:       side.len = sqrt(dot(vLen, vLen));
 2954: 
 2955:    }
 2956: 
 2957:    printf("Processing %d elements\n", ne);
 2958:    for (int i = 0; i < ne; i++)
 2959:    {
 2960:       Element &elem = localElemData[i];
 2961:       elem.idx = i;
 2962:       for (int j = 0; j < i34[i]; j++) {
 2963:          const int idxNode = elnode[i*4 + j];  
 2964:          const int idxSide = elside[i*4 + j];
 2965:          
 2966:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2967:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2968: 
 2969: 
 2970: 
 2971:          // Find the neighboring element  
 2972:          if (elem.sides[j]->elems[0] == &elem) {
 2973:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2974:          }
 2975:          else {
 2976:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2977:          }
 2978:          
 2979:       }
 2980: 
 2981:       elem.i34 = i34[i];
 2982: 
 2983:       // Compute the centroid of the element and its depth
 2984:       Vector2 center = {0.0, 0.0};
 2985:       elem.depth = 0.0;
 2986:       for (int j = 0; j < i34[i]; j++) {
 2987:          center += elem.nodes[j]->p2()/i34[i];
 2988:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2989:       }
 2990:       elem.center.x = center.x;
 2991:       elem.center.y = center.y;
 2992: 
 2993: 
 2994:       
 2995:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2996:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2997: 
 2998:       elem.area = elem.computeSignedArea(); 
 2999:       elem.radius = sqrt(elem.area)/pi; 
 3000:       
 3001:       // Determines which way the normal vector to each side is oriented.
 3002:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3003:       for (int j = 0; j < i34[i]; j++)  
 3004:       {
 3005:          if (elem.sides[j]->elems[0] == &elem) {
 3006:             elem.ssign[j] =  1.0;
 3007:          }
 3008:          else {
 3009:             elem.ssign[j] = -1.0;
 3010:          }
 3011: 
 3012:       }
 3013: 
 3014:       // Derivatives of shape functions
 3015:       //  For ics=2, this is done inside element/ll frame XXX
 3016:       //  For quads, the derivative is evaluated at centroid
 3017:       const int i34 = elem.i34;
 3018:       for (int j = 0; j < i34; j++) {
 3019:          const double area = elem.area;
 3020:          const int id2 = elem.nxq(1 + j);
 3021:          const int id3 = elem.nxq(2 + j);
 3022:          const int id4 = elem.nxq(3 + j);
 3023:          if (elem.isTri()) {
 3024:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3025:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3026:             // da1/dx = (y1 - y2)/(2*area)
 3027:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3028:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3029:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3030:          }
 3031:          else  { // Quad; evaluate at centroid
 3032:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3033:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3034:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3035:          } // if Tri
 3036: 
 3037:       } // for j
 3038: 
 3039:    }
 3040: 
 3041: 
 3042:    // Processing the boundary nodes
 3043:    int idx = 0;
 3044:    for (int iseg = 0; iseg < nope; iseg++) {
 3045:       // for each segment...
 3046:       
 3047:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3048:          // for each node on the segment...
 3049: 
 3050:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3051: 
 3052:          nodeBnd->isEssentialBC = true;
 3053: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3054:          nodeBnd->elbc = 0.0;
 3055: 
 3056:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3057: 
 3058:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3059:             nodeBnd->efa[jfr] = efa[idx];
 3060:             nodeBnd->emo[jfr] = emo[idx];
 3061:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3062:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3063: 
 3064:          }
 3065: 
 3066:          idx++;
 3067:       }
 3068: 
 3069:    }
 3070: 
 3071: }
 3072: 
 3073: 
 3074: 
 3075: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3076:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3077:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3078:    // 
 3079:    // This kernel is called for all nodes.
 3080: 
 3081: 
 3082:    NODE(node1);
 3083: 
 3084: 
 3085:    node1->clearMatrixRow();
 3086:    node1->qel = 0.0;
 3087: 
 3088:    // THIS IS FOR STRUCTURES XXX
 3089:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3090: 
 3091:    
 3092:    for (int j=0; j<node1->numElements; j++) {
 3093:       // For each element connected to the node...
 3094: 
 3095:       Element *elem = node1->elements[j];
 3096: 
 3097:       // Compute the average gravity
 3098:       const double grav3 = elem->mean(&Node::grav2);
 3099: 
 3100:       // Look at the documentation for the description of the terms in the following integrals
 3101: 
 3102:       // Integral I_1 
 3103:       // \bar{\breve{H}} 
 3104:       const double hhatb = elem->mean(&Side::hhat);        
 3105: 
 3106: 
 3107:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3108: 
 3109:       const int id1 = elem->nodeLocalIdx(node1); 
 3110:       const double area = elem->area;
 3111: 
 3112:       if (elem->isTri()) {
 3113: 
 3114:          // To clarify the notation in this section: 
 3115:          //   i stands for the node under consideration (node1)
 3116:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3117:          const int id2 = elem->nxq(1 + id1);
 3118:          const int id3 = elem->nxq(2 + id1);
 3119:          Node *node2 = elem->nodes[id2];
 3120:          Node *node3 = elem->nodes[id3];
 3121: 
 3122:          const Point2 x1 = node1->p2();
 3123:          const Point2 x2 = node2->p2();
 3124:          const Point2 x3 = node3->p2();
 3125: 
 3126:          // integral of phi_i*phi_j
 3127:          const double ipp_ii = (1.0/6.0 )*area;
 3128:          const double ipp_ij = (1.0/12.0)*area;
 3129:          const double ipp_ik = (1.0/12.0)*area;
 3130: 
 3131:          // integral of [(grad phi_i) * (grad phi_j)]
 3132:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3133:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3134:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3135: 
 3136:          // Computes the different components of integral I_1 of each node with respect to node i.
 3137:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3138:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3139:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3140: 
 3141:          node1->addToSparseMatrix(node1, I1_ii);
 3142:          node1->addToSparseMatrix(node2, I1_ij); 
 3143:          node1->addToSparseMatrix(node3, I1_ik);
 3144: 
 3145:       }
 3146:       else { // Quad
 3147:          // XXX IMPLEMENT THIS
 3148:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3149:       } 
 3150: 
 3151:  
 3152:       // Integral I_4
 3153:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3154:       // Where
 3155:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3156: 
 3157:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3158:       // of U over the element.
 3159:       Vector2 Umean = {0.0, 0.0};
 3160:       for (int m=0; m<elem->i34; m++) {      
 3161:          const Side *side = elem->sides[m];
 3162: 
 3163:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3164:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3165:       }
 3166:       Umean = Umean/elem->i34;
 3167: 
 3168:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3169: 
 3170:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3171:       const double I_4_1 = dot(gradPhi_1, Umean);
 3172: 
 3173:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3174:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3175:      
 3176:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3177: 
 3178:       // Additional terms 
 3179:       double vnorm = 0.0;
 3180:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3181:          Vector3 ubed;
 3182:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3183: 
 3184:          Vector3 gradP = {0.0, 0.0, 1.0};
 3185:          for (int m=0; m < elem->i34; m++) {
 3186:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3187:            gradP += toVector3(gradP_2D, 0.0);
 3188:          }   
 3189:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3190:       } // imm==2
 3191: 
 3192:       if (elem->isTri()) {
 3193:          for (int l=0; l<3; l++) {
 3194:             double fac;
 3195: 
 3196:             Node *node = elem->nodes[l];
 3197: 
 3198:             fac = (node == node1) ? 2.0 : 1.0;
 3199:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3200:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3201:            
 3202:          }
 3203: 
 3204: 
 3205:          if (!elem->isDry) {
 3206:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3207: 
 3208:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3209:          }
 3210: 
 3211:       } // isTri
 3212:       else { // isQuad
 3213:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3214:          // for (int l=0; l<4; l++) {
 3215:          //   const Node *node = elem->nodes[l];
 3216: 
 3217:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3218:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3219: 
 3220:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3221:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3222:          // }
 3223: 
 3224:       } // isQuad
 3225: 
 3226: 
 3227:       node1->qel += (dt/elem->i34)*elem->vsource;
 3228:       
 3229: 
 3230:    } // for all elements connected to the node
 3231:    
 3232: 
 3233: 
 3234:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3235:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3236:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3237:    if (nodeBnd != nullptr)  { 
 3238:       // If it is an open boundary node...
 3239: 
 3240:       // At least one open bnd side, maybe two
 3241:       for (int l=0; l<2; l++) { 
 3242: 
 3243:          // Gets each of the sides sharing the node. 
 3244:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3245: 
 3246:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3247: 
 3248:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3249: 
 3250:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3251:          if (sideBnd != nullptr) {
 3252:             // If the side is on a boundary...
 3253: 
 3254:             // Get the boundary segment
 3255:             const BoundarySegment *sideSegment = sideBnd->segment;
 3256:             const Side *side = sideBnd->side;
 3257: 
 3258:             // Integral I_3
 3259:             if (sideSegment->ifltype != 0) {
 3260:             // Natural or Flather b.c.
 3261: 
 3262:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3263:                // especially for Flather b.c.
 3264:                double ri3 = 0.0;
 3265:                if (!side->isDry) {
 3266:                   // If the side is not dry
 3267:                   
 3268:                   // Computes the side flux of (uth, vth)
 3269:                   double Vn = 0.0;
 3270:                   for (int k = side->kb; k<nvrt-1; k++) {
 3271:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3272:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3273: 
 3274:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3275:                   }
 3276: 
 3277:                   ri3 = 0.5*side->len*Vn;
 3278:                }
 3279: 
 3280:                if (sideSegment->ifltype == -1) { // Flather 1
 3281: 
 3282:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3283:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3284: 
 3285:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3286:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3287:                   
 3288:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3289:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3290: 
 3291:                } 
 3292:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3293:                   // Reset ri3
 3294:                   ri3 = 0.0;
 3295: 
 3296:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3297: 
 3298:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3299: 
 3300:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3301:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3302: 
 3303:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3304:                   node1->addToSparseMatrix(node1, con0*2.0);
 3305:                   node1->addToSparseMatrix(node2, con0);
 3306: 
 3307:                } // if Flather or Discharge
 3308: 
 3309:                node1->qel -= thetai*dt*ri3;
 3310: 
 3311:             } // I_3
 3312:           
 3313: 
 3314:             // Integral I_5
 3315:             if(!side->isDry) {
 3316: 
 3317:                const double Unbar = dot(side->U, side->n);
 3318:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3319: 
 3320:             } // I_5
 3321: 
 3322:          } // if is boundary side
 3323: 
 3324:       } // for l
 3325: 
 3326:    } // if isbnd
 3327: 
 3328: 
 3329: }
 3330: 
 3331: 
 3332: 
 3333: extern "C" {
 3334:    __global__ void rollUpElevation(void) {
 3335: 
 3336:       NODE(node);
 3337: 
 3338:       node->eta2 += node->eta1;
 3339: 
 3340:    }
 3341: 
 3342: 
 3343:    __global__ void backtrackAllNodes(void) {
 3344: 
 3345:       // max/min # of sub-divisions
 3346:       const int ndelt_max = max(1.0, dt/dtb_min);
 3347:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3348: 
 3349:       // Removed all references to swild98 XXX
 3350:       // swild98=0.d0 !init
 3351: 
 3352: 
 3353:       SIDE(side);
 3354: 
 3355:       const int kb = side->kb;
 3356: 
 3357: 
 3358: 
 3359:       // Initialize btrack velocities to the actual velocities at the side 
 3360:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3361: 
 3362:       if (side->isDry) return;
 3363: 
 3364: 
 3365:       // Checks that at least one element is not dry
 3366:       const Element *elem1 = side->elems[0];
 3367:       const Element *elem2 = side->elems[1];
 3368: 
 3369: 
 3370:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3371:       
 3372:       // XXXXXX
 3373:       // !swild_tmp to store global coord. of the starting side
 3374:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3375:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3376:       // !Use sframe2 
 3377:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3378: 
 3379: 
 3380:       for (int k = kb; k < nvrt; k++) {
 3381:       //  Initialize (xt,yt,zt), nnel and vel.
 3382:       //  For ics=2, the coordinates are in local frames
 3383:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3384: 
 3385: 
 3386:          const int iadvf = side->iadv();  // Advection flag
 3387: 
 3388:          Point3 xt;
 3389:          if constexpr(ics==1) {
 3390:             xt = side->center3D(k); 
 3391:          }
 3392:          else // lat/lon; in side lat/lon frame
 3393:          {
 3394:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3395:          // XXX IMPLEMENT THIS
 3396:       //          xt=0.d0
 3397:       //          yt=0.d0
 3398:       //          !centroid coord. for nudging
 3399:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3400:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3401:          }  // ics
 3402: 
 3403: 
 3404: 
 3405:          // If on land or open boundary...
 3406:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3407:          
 3408:          const double vmag = length(side->u2[k]);
 3409: 
 3410:          if (vmag <= velmin_btrack) {
 3411:             // No activity 
 3412: 
 3413: 
 3414:             side->btu[k] = side->u2[k];
 3415:             
 3416:          } else {  // do btrack
 3417: 
 3418:             // Compute number of sub-divisions based on local gradients 
 3419:             // XXX IS THIS NECESSARY?
 3420:             double suma = 0.0;
 3421:             int icount = 0;
 3422:             for (int ii=0; ii<2; ii++) {
 3423: 
 3424:                const Element *elem = side->elems[ii];
 3425:                  
 3426:                if (elem == nullptr) continue;
 3427: 
 3428:                icount++;
 3429: 
 3430:                // Not strictly along z; in ll frame for ics=2
 3431: 
 3432:                double utmp[4];
 3433:                double vtmp[4];
 3434:                for (int jj = 0; jj < elem->i34; jj++) {
 3435: 
 3436:                   const Node *node = elem->nodes[jj];
 3437: 
 3438:                   if constexpr(ics==1) {
 3439:                      utmp[jj] = node->u2[k].x;
 3440:                      vtmp[jj] = node->u2[k].y;  
 3441:                   } else {
 3442:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3443:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3444:                   }
 3445:                } // for jj
 3446: 
 3447:                const Vector2 grad_u = elem->grad2(utmp); 
 3448:                const Vector2 grad_v = elem->grad2(vtmp);
 3449: 
 3450:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3451:             } // for ii
 3452: 
 3453:             assert(icount > 0 && "Impossible 77");
 3454: 
 3455:             // '4' is somewhat arbitrary
 3456:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3457: 
 3458:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3459:          
 3460: 
 3461:             Vector3 u_int = {0.0, 0.0, 0.0};
 3462: 
 3463:             side->btrack(k, dt, dtbk, u_int);
 3464:             side->btu[k] = toVector2(u_int);
 3465:                
 3466:          } // if vmag (do backtrack)
 3467: 
 3468:       } // for j=jmin,nvrt-1
 3469: 
 3470:    }
 3471: } // extern "C"
 3472: 
 3473: template<int nc>
 3474: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3475: 
 3476: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3477: //
 3478: // a,b,c,rhs: input vectors and are not modified by this program.
 3479: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3480: // rhs is the r.h.s.
 3481: // n: actual rank of the system.
 3482: // rows in u() and rhs();
 3483: // u: output with nc columns (transposed to rows)
 3484: // gam: a working array.
 3485: //
 3486: // NOTES:
 3487: // This is a template function that allows for different numbers of columns in the rhs vector.
 3488: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3489: 
 3490:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3491:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3492: 
 3493:    double bet = b[0];
 3494:    if constexpr (nc == 1) {
 3495:       u[0] = rhs[0]/bet;
 3496:    } else {
 3497:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3498:    }
 3499: 
 3500:    for (int j = 1; j < n; j++) {
 3501:       gam[j] = c[j-1]/bet;
 3502:       bet = b[j] - a[j]*gam[j];
 3503: 
 3504:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3505: 
 3506:       if constexpr (nc == 1) {
 3507:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3508:       } else {
 3509:          for (int k = 0; k < nc; k++) {
 3510:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3511:          }
 3512:       }
 3513:    }
 3514: 
 3515:    // Back-substitution
 3516:    for (int j=n-1; j>=1; j--) {
 3517:       if constexpr (nc == 1) {
 3518:          u[j] = u[j] - gam[j+1]*u[j-1];
 3519:       } else {
 3520:          for (int k = 0; k < nc; k++) {
 3521:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3522:          }
 3523:       }
 3524:    }
 3525: }
 3526: 
 3527: 
 3528: 
 3529: // Helper function that contains the core algorithm
 3530: template<typename XAccessor, typename YAccessor>
 3531: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3532:                                     double  yp_top, double  yp_bot, 
 3533:                                     CubicSpline &spline) {
 3534:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3535:    // 
 3536:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3537:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3538:    //
 3539:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3540:    // 
 3541:    // Inputs: 
 3542:    //            n: dimension for x etc; # of data pts (>=2);
 3543:    //            getX, getY: functions to access x,y coordinates
 3544:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3545:    //     Output: 
 3546:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3547: 
 3548:    const int n = k2 - k1 + 1;
 3549:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3550: 
 3551:    // Allocate memory for the splines
 3552:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3553:    spline.x   = new double[n];
 3554:    spline.y   = new double[n];
 3555:    spline.yp  = new double[n];
 3556:    spline.ypp = new double[n];
 3557: 
 3558:    for (int k=k1; k<=k2; k++) {
 3559:       spline.x[k] = getX(k);
 3560:       spline.y[k] = getY(k);
 3561:    }
 3562: 
 3563:    // This is to simplify expressions later
 3564:    double *x = spline.x;
 3565:    double *y = spline.y;
 3566: 
 3567:    double *a = nullptr;
 3568:    double *b = nullptr;
 3569:    double *c = nullptr;
 3570:    double *gam = nullptr;
 3571:    double *rhs = nullptr;
 3572:    
 3573: 
 3574:       a = new double[n];   // Lower diagonal
 3575:       b = new double[n];   // Diagonal
 3576:       c = new double[n];   // Upper diagonal
 3577:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3578:       rhs = new double[n]; // Right-hand side
 3579: 
 3580:    for (int k=k1; k<=k2; k++) {
 3581:       if (k == k1) {
 3582:          // Bottom level
 3583:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3584:          b[k] = (x[k+1] - x[k])/3.0;
 3585:          c[k] = b[k]/2.0;
 3586:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3587:       } else if (k == n - 1) {
 3588:          // Top level (surface)
 3589:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3590:          b[k] = (x[k] - x[k-1])/3.0;
 3591:          a[k] = b[k]/2.0;
 3592:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3593:       } else {
 3594:          // Intermediate levels
 3595:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3596:          b[k] = (x[k+1] - x[k-1])/3.0;
 3597:          a[k] = (x[k  ] - x[k-1])/6.0;
 3598:          c[k] = (x[k+1] - x[k  ])/6.0;
 3599:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3600:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3601:       }
 3602:    }
 3603: 
 3604:    // Solve the tridiagonal system
 3605:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3606:    
 3607:    spline.yp[k1] = yp_bot;
 3608:    spline.yp[k2] = yp_top;
 3609: 
 3610:    // Compute rest of 1st derivatives using the splines
 3611:    for (int k=k1+1; k<k2; k++) {
 3612:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3613:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3614:    }
 3615:    
 3616:    delete[] a;
 3617:    delete[] b;
 3618:    delete[] c;
 3619:    delete[] gam;
 3620:    delete[] rhs;
 3621: 
 3622: }
 3623: 
 3624: // Array version
 3625: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3626:                                 double y_top, double y_bot, 
 3627:                                 CubicSpline &spline) {
 3628:    auto getX = [x] (int k) { return x[k]; };
 3629:    auto getY = [y] (int k) { return y[k]; };
 3630:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3631: }
 3632: 
 3633: // Lambda version - allows custom access patterns
 3634: template<typename XFunc, typename YFunc>
 3635: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3636:                                 double y_top, double y_bot,
 3637:                                 CubicSpline &spline) {
 3638:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3639: }
 3640: 
 3641: 
 3642: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3643: {
 3644:    assert("Not implemented");
 3645: 
 3646:    return 0.0;
 3647: }
