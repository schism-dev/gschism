 3783:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3784: 
 3785:       NODE_BND(nodeBnd);
 3786: 
 3787:       Node *node = nodeBnd->node;
 3788: 
 3789:       node->ETP = 0.0;
 3790: 
 3791:       for (int j=0; j<ntip; j++) {
 3792: 
 3793:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3794:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3795:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3796: 
 3797:          if constexpr(iloadtide==1) { // loading tide
 3798:             assert(false && "Loading tide not implemented");
 3799:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3800:          }
 3801:          
 3802:       }
 3803:       
 3804:    }
