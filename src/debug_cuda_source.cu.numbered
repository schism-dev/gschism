 6550:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6551: 
 6552:       SIDE(side);
 6553: 
 6554:       side->U = {0.0, 0.0}; 
 6555:          
 6556:       if(side->isDry) return;
 6557: 
 6558:       // Vertically integrated velocity U
 6559:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6560:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6561:          side->U += side->Dz(k + 1)*uc;  
 6562:       }
 6563: 
 6564:    }
 6565: 
 6566:    __global__ void computeBottomDragVegetation(void) {
 6567:       // UNFINISHED. CHECK THIS: XXXXX
 6568:       // How many kernels are needed? Why so many for loops?
 6569:       // Is the loop on sides needed?
 6570: 
 6571:       NODE(node);
 6572: 
 6573:       const int    kb      = node->kb;
 6574:       const double htot    = node->htot2(); 
 6575:       
 6576:       if (node->isDry) {
 6577:          // Default values for dry nodes
 6578:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6579:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6580: 
 6581:          return;
 6582:        
 6583:       }
 6584: 
 6585:       // Computes bottom drag Cd based on the selected nchi
 6586:       node->computeBottomDragCd();
 6587:       
 6588: 
 6589: 
 6590:       //   Bottom stress in m^2/s^2
 6591:       if (node->rho[kb + 1] >= -98.0)
 6592:       {
 6593:          const double mag_u = length(node->u2[kb + 1]);
 6594:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6595: 
 6596:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6597:          // !sediment erosion: this part needs more documentation
 6598:       }
 6599:     
 6600: 
 6601: 
 6602:       // Compute vegetation parameters
 6603:       //--------------------------------
 6604: 
 6605: 
 6606:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6607:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6608: 
 6609:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6610:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6611:          int kbin = 0; // bin index
 6612:          for (int k = kb; k < nvrt; k++) {
 6613:             // Computes node height above the bottom level
 6614:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6615:             assert(false && "Vertical variation of vegetation not implemented");
 6616: 
 6617:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6618:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6619:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6620:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6621:             // } else {
 6622:             //    // Find the bin at which the current vertical level is
 6623:             //    while (kbin<nbins_veg_vert) {
 6624:             //       const double zn = node->z[kbin];
 6625:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6626:             //          break;
 6627:             //       } // if
 6628:             //       kbin++;
 6629:             //    } // while
 6630:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6631: 
 6632:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6633:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6634:                
 6635:             //    // Linear interpolation of the vegetation parameters
 6636:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6637:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6638:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6639:             // } // if rl10
 6640: 
 6641:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6642: 
 6643:          } // for k
 6644: 
 6645: 
 6646:       } else { // Ganthy (iveg==2)
 6647:       //  Modify canopy height, diameter, and density
 6648: 
 6649:          // Make sure there is vegetation on this node
 6650:          if (node->veg_h_unbent > 0.0) {
 6651:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6652: 
 6653:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6654:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6655:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6656: 
 6657:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6658:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6659:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6660:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6661:          } // if veg_h_unbent
 6662: 
 6663:          for (int k = 0; k < nvrt; k++) {
 6664:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6665:          } // for k
 6666:       
 6667: 
 6668:       } // if iveg
 6669:      
 6670: 
 6671:       // Compute vertical mean of veg_alpha3D
 6672:       if (iveg != 0) {
 6673:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6674:          double sum1=0.0;
 6675:          double sum2=0.0;
 6676:          // Integrate over each level under the canopy...
 6677:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6678:             const double Dz = node->Dz(k);
 6679: 
 6680:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6681:             sum2 += Dz;
 6682: 
 6683:          } // for k
 6684:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6685:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6686: 
 6687:       } // if iveg
 6688: 
 6689:    }
