 3311: 
 3312: 
 3313: 
 3314: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3315: 
 3316:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3317:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3318:    const Node *n1 = side->n1;
 3319:    const Node *n2 = side->n2;
 3320: 
 3321:    bool n1_match = (n1->nodeBnd->segment == segment);
 3322:    bool n2_match = (n2->nodeBnd->segment == segment);
 3323: 
 3324:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3325:    if (n1_match && n2_match) {
 3326:       return 0.5;
 3327:    } else if (n1_match) {
 3328:       return 1.0;
 3329:    } else if (n2_match) {
 3330:       return 0.0;
 3331:    }
 3332: 
 3333:    return 0.0;
 3334: }
 3335: 
 3336: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3337: 
 3338: 
 3339: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3340: 
 3341:    const double w1 = getBoundaryArrayValueWeight();
 3342:    const double w2 = 1.0 - w1;
 3343:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3344:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3345: 
 3346:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3347: }
 3348: 
 3349: 
 3350: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3351:    const double w1 = getBoundaryArrayValueWeight();
 3352:    const double w2 = 1.0 - w1;
 3353:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3354:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3355: 
 3356:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3357: 
 3358: }
