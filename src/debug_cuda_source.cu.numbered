 1439: struct Mesh {
 1440:    public:  
 1441: 
 1442:    int partNum; // Partition number for this mesh.
 1443: 
 1444:    // Pointers to each GPU's local memory (size is the number of partitions).
 1445:    Node**    nodes;  
 1446:    Element** elems;  
 1447:    Side**    sides;  
 1448:    
 1449:    // Local memory
 1450:    Node*    localNodeData; 
