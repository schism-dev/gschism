 6828: #ifdef DONTCOMPILE
 6829: __device__ void computeVerticalAdvection(void) {
 6830:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6831: 
 6832:    sdbt(1:2,:,:)=0.d0
 6833: 
 6834:    const Side *side = FROM kernel;
 6835: 
 6836:    if(side->isDry) return;
 6837: 
 6838:    // If side is wet...
 6839: 
 6840: 
 6841:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6842:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6843:    double ws[nvrt] = {} // w @ side
 6844:    int icount = 0;
 6845:    for (int j=0; j<2; j++) {
 6846:       const Element *elem = side->elements[j];
 6847:        
 6848:       if(elem != nullptr) {
 6849:          icount++;
 6850:          for (int k=0; k<nvrt; k++) {
 6851:             ws[k] = ws[k] + elem->w[k];
 6852:          }
 6853:       }
 6854:    }  // for j
 6855: 
 6856:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6857:    ws = ws/icount;
 6858: 
 6859:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6860:    // Splines allow for a smooth transition between vertical levels.
 6861:    // Splines have continuity restrictions at the internal knots, but
 6862:    // we have to provide the 1st derivatives at the endpoints.
 6863:    const int kbs = side->kbs; 
 6864:    
 6865:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6866:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6867:    initCubicSpline(kbs, nvrt, side, ws, up)
 6868: 
 6869:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6870:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6871:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6872: 
 6873:    // Total advection (average onto side)
 6874:    const Node *node1 = side->nodes[0];
 6875:    const Node *node2 = side->nodes[1];
 6876:    for (int k=kbs(i); k<nvrt; k++) {
 6877: 
 6878:       if constexpr(ics==1) {
 6879:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6880:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6881:       } else {
 6882:          // XXX IMPLEMENT THIS
 6883:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6884:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6885:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6886:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6887:       }  // if ics
 6888: 
 6889: 
 6890:    }
 6891: }
 6892: #endif
 6893: 
 6894: 
 6895: extern "C" {
 6896:    __global__ void computeElemAverageGhat(void) {
 6897:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6898: 
 6899:       ELEM(elem);
 6900:       
 6901:       elem->ghat1= {0.0, 0.0};  
 6902: 
 6903:       if constexpr(ihydraulics != 0) {
 6904:          if (nhtblocks > 0 && elem->isblock) return;
 6905:       }
 6906: 
 6907:       if (elem->isDry) return;
 6908: 
 6909:       // Wet elements.
 6910:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6911:       // tidal potential, horizontal diffusion, and baroclinic etc
 6912:       // Remember to update both fb and F 
 6913:       // If ics=2, ghat1 are in eframe (ll)
 6914:       // cff1-3: coefficients for 2D/3D
 6915:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6916:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6917:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6918: 
 6919:       double av_cff1 = 0.0;  // av. for cff1
 6920:       double av_cff2 = 0.0;  // av. for cff2
 6921:       double av_cff3 = 0.0;  // av. for cff3
 6922:       double av_df = 0.0;  // av. for H^\alpha / H
 6923:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6924:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6925: 
 6926:       const int i34 = elem->i34;
 6927:       const int kb = elem->kb;
 6928: 
 6929:       for (int j=0; j<i34; j++) {
 6930:          // For each node and side in the element...
 6931: 
 6932:          const Node *node = elem->nodes[j];
 6933:          const Side *side = elem->sides[j];
 6934: 
 6935:          const double chi      = side->chi;
 6936:          const double veg_c2   = side->veg_c2;
 6937:          const double veg_beta = side->veg_beta;
 6938:          const double veg_h    = side->veg_h();
 6939:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6940: 
 6941:          // Node - const in elem
 6942:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6943:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6944: 
 6945:          if (elem->depth >= tip_dp) {
 6946:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6947:          }
 6948: 
 6949:          
 6950:          const double htot  = side->htot2();        // Total depth at the side
 6951:          const double zctr2 = side->zTopCanopy();  
 6952: 
 6953:          double cff1; 
 6954:          double cff2; 
 6955:          double cff3;   
 6956:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6957:          // coefficients applied to 2D/3D case 
 6958:             cff1 = side->hhat/htot;
 6959:             cff2 = 0.0;
 6960:             cff3 = 0.0;
 6961:          } else { //3D
 6962:             //Init for no-veg case
 6963:             cff1 = 1.0;
 6964:             cff2 = 1.0;
 6965:             cff3 = 0.0;
 6966: 
 6967:             if constexpr(iveg != 0) {
 6968:                // Computes coefficients used with vegetation terms G1, G2
 6969:                // cff1, cff3 are used for the first two terms in G1, G2:
 6970:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6971:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6972:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6973:                if(veg_h < 0.99*htot) { // submergent vegetation
 6974:                   cff1=1;
 6975:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6976:                   cff3 = veg_c;
 6977: 
 6978:                } else { // emergent vegetation
 6979:                   cff1 = 1.0/(1.0 + veg_c2);
 6980:                   cff2 = cff1;
 6981:                   cff3 = 0.0;
 6982: 
 6983:                }
 6984:             } // if iveg
 6985:          } //  2D/3D
 6986: 
 6987:          av_cff1 += cff1/i34;
 6988:          av_cff2 += cff2/i34;
 6989:          av_cff3 += cff3/i34;
 6990:          av_cff2_chi += cff2*chi/i34;
 6991:          av_cff3_chi += cff3*chi/i34;
 6992:          av_df += min(htot, veg_h)/(htot*i34);
 6993: 
 6994: 
 6995:          // btrack values: U^\star, U^{\star\alpha}
 6996:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6997:          Vector2 Ustar       = {0.0, 0.0}; 
 6998:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6999: 
 7000:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7001:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7002:          } else { //3D
 7003:             for (int k = side->kb; k < nvrt; k++) {
 7004:             
 7005:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7006:                Ustar += w2;
 7007: 
 7008:                if constexpr(iveg != 0) {
 7009:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7010:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7011:                        Ustar_alpha += zrat*w2; // XXXX
 7012:                    }
 7013:                }  // if iveg
 7014:             }  // for k
 7015:          }  //2D/3D
 7016:          
 7017: 
 7018:          // Add btrack & surface stress terms to \breve{G} first
 7019:          if constexpr(ics==1) {
 7020: 
 7021:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7022: 
 7023:          } else {
 7024:             // XXX IMPLEMENT THIS
 7025:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7026:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7027:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7028:          }  // if ics
 7029: 
 7030:          // Surface and bottom stress terms
 7031:          if constexpr(ics==1) {
 7032:             const Vector2 tau    = side->tau();
 7033:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7034: 
 7035:             // Term for surface and bottom stress
 7036:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7037: 
 7038:          } else {
 7039:             assert(false && "computeElemAverageGhat: Not implemented");
 7040:             // XXX IMPLEMENT THIS
 7041:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7042:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7043:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7044:             // tau_x=(vn1+tt1)/2.d0
 7045:             // tau_y=(vn2+ss1)/2.d0
 7046:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7047:          }  // if ics
 7048: 
 7049:          
 7050: 
 7051:          // All terms in F,F^\alpha,f_b except baroclinic
 7052:          // F, f_b: all explicit terms excluding vegetation 
 7053:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7054:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7055:          const double coriolis = side->coriolis;
 7056:          Vector2 F  =  coriolis*side->U;  // F_x
 7057:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7058:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7059: 
 7060:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7061:             
 7062:             for (int k = side->kb; k < nvrt; k++) {
 7063:                if (zctr2 > side->zc[k-1]) {
 7064:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7065:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7066:                    Fa +=  coriolis*w2*zrat;
 7067:                } // if zctr2
 7068:             } // k
 7069:          } // iveg
 7070: 
 7071:          // Integrate horizontal viscosity force vertically
 7072:          for (int k=side->kb + 1; k<nvrt; k++) {
 7073:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7074: 
 7075:             F += levelHorVisc;
 7076: 
 7077:             // Vegetation term
 7078:             if constexpr(iveg!=0) {
 7079:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7080:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7081:                   Fa += levelHorVisc*zrat;
 7082:                } 
 7083:             } // if iveg
 7084:          } // for k
 7085: 
 7086:          fb += side->nuGradU[side->kb];
 7087: 
 7088:          // Add to ghat1
 7089:          if constexpr(ics==2) {
 7090:             // XXX IMPLEMENT THIS
 7091:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7092:             // bigf1=vn1; bigf2=vn2
 7093:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7094:             // botf1=vn1; botf2=vn2
 7095:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7096:             // bigfa1=vn1; bigfa2=vn2
 7097:          } // if ics
 7098: 
 7099:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7100:       } // for j (nodes and sides)
 7101: 
 7102:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7103:          
 7104:       // Finish off terms in F, F^\alpha and f_b
 7105:       const double grav3 = elem->mean(&Node::grav2);
 7106:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7107: 
 7108: 
 7109:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7110:       for (int j=1; j<i34; j++) { 
 7111:          // For each side in the element...
 7112:          const Side *side = elem->sides[j];
 7113:          const double chi = side->chi;
 7114: 
 7115:          const double htot = side->htot2();
 7116:          const double veg_h = side->veg_h();
 7117:          const Vector2 F  = htot*fb;
 7118:          const Vector2 Fa = min(htot, veg_h)*fb;
 7119: 
 7120:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7121:       } // for j
 7122: 
 7123:       //botf1 etc are already in elem frame
 7124:       elem->ghat1 += tmp/i34;
 7125: 
 7126:       // Baroclinic force
 7127:       if constexpr(ibc==0) {
 7128:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7129: 
 7130:          Vector2 Fa = {0.0, 0.0};
 7131:          Vector2 intGradRho = {0.0, 0.0};
 7132:          
 7133:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7134:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7135:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7136: 
 7137:             // \in F [m^2/s/s]
 7138:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7139:          }
 7140: 
 7141:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7142:          const Vector2 F = av_df*Fa; //approx
 7143:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7144: 
 7145:       } // if ibc
 7146: 
 7147: 
 7148: 
 7149:    }
 7150: 
 7151: } // extern "C"
 7152: 
 7153: 
 7154: 
 7155: #ifdef DONTCOMPILE
 7156: __global__ void checkMassConservation(Tracers* sumtr) {
 7157: 
 7158:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7159: 
 7160:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7161: 
 7162:    Element *elem = &(mesh->localElemData[i]);
 7163: 
 7164:    // Skip dry elements
 7165:    if (elem->isDry) return;
 7166: 
 7167:    // Local sum array for this thread
 7168:    double localSum[N_TRACERS] = {0.0};
 7169: 
 7170:    // Sum over vertical levels for this element
 7171:    const int kbe = elem->kbe;
 7172:    const double area = elem->area;
 7173: 
 7174:    for (int k = kbe; k < nvrt; k++) {
 7175:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7176:       
 7177:       // Accumulate tracer mass
 7178:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7179:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7180:       }
 7181:    }
 7182: 
 7183:    //  This function returns per element sums. A reduction must be done on the host side.
 7184: }
 7185: 
 7186: 
 7187: __global__ void transport(void) {
 7188: 
 7189:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7190: 
 7191:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7192: 
 7193:    Element *elem = &(mesh->localElemData[ie]);
 7194: 
 7195:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7196: 
 7197:                for (int m=0; m<ntr; m++) {
 7198:                   for (int k=kbe(ie); k<nvrt; k++) {
 7199:                      // Calculate each polynomial's weight 
 7200:                      wm=0.d0; sum1=0.d0; 
 7201:                      wm1=0.d0; wm2=0.d0; 
 7202:                      for (int i=0; i<elem->nweno2; i++) {
 7203:                   
 7204:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7205:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7206:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7207:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7208:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7209:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7210:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7211:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7212:                      // -----------------Hu and Shu (1999)'s method----------------
 7213:                      b4=b1+b2+b3
 7214: 
 7215: //Error: add PRODUCTION CPP
 7216: #ifdef DEBUG
 7217:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7218:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7219:                     call parallel_abort(errmsg)
 7220:                   }
 7221: #endif
 7222: 
 7223:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7224:                   // !----test-------------- 
 7225:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7226:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7227:                   // !wm(i)=wm1(i)*wm2(i)
 7228:                   // !---------------------- 
 7229:                   sum1=sum1+wm(i)
 7230:                 } // end for i
 7231: 
 7232:                 wm=wm/sum1
 7233: 
 7234:                 for (int j=0; j<elem->i34; j++) {
 7235: 
 7236:                   const Side *side  = elem->sides[j];
 7237:                   const Node *node1 = side->n1;
 7238:                   const Node *node2 = side->n2;
 7239: 
 7240:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7241:                      trsd=0.d0
 7242:                      for (int kk=0; kk<nquad; kk++) {
 7243:                         for (int i=0; i<elem->nweno2; i++) {
 7244:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7245:                         } // end for i   
 7246:                      } // end for kk
 7247:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7248:                   } // outward flux
 7249:                } // end for j=1,i34(ie) ! side
 7250:             }
 7251:          }
 7252:               
 7253: 
 7254: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7255: //             //   calculate each polynomial's weight 
 7256: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7257: //                 wm=0.d0; sum1=0.d0
 7258: //                 do i=1,nweno1(ie) !for each polynomial
 7259: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7260: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7261: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7262: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7263: //                   wm(i)=b2
 7264: //                   sum1=sum1+b2
 7265: //                   !wm(i)=1.d0
 7266: //                   !sum1=sum1+1.d0
 7267: 
 7268: // // Error: PRODUCTION
 7269: // #ifdef DEBUG
 7270: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7271: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7272: //                     call parallel_abort(errmsg)
 7273: //                   endif
 7274: // #endif
 7275: 
 7276: //                 enddo !i
 7277: //                 wm=wm/sum1 !final weight
 7278: 
 7279:                 for (int j=0; j<elem->i34; j++) { // side
 7280:                   const Side *side = elem->sides[j];
 7281:                   const Node *node1 = side->n1;
 7282:                   const Node *node2 = side->n2;
 7283: 
 7284:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7285:                     trsd=0.d0
 7286:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7287:                       for (int i=0; i<elem->nweno1; i++) {
 7288:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7289:                       }
 7290:                     enddo //kk
 7291:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7292:                   } // outward flux
 7293:                 } // end for j=1,i34(ie) ! side
 7294:               } // end for k; ntr 
 7295: 
 7296:             else !simple upwind method
 7297:               do j=1,i34(ie)
 7298:                 jsj=elside(j,ie)
 7299:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7300:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7301:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7302:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7303:                   endif
 7304:                 enddo  !vertical layers
 7305:               enddo !j=1,i34(ie) ! side
 7306:             endif !order of accuracy
 7307: 
 7308:          //  enddo !ie
 7309: // !$OMP     end do
 7310: 
 7311: // !$OMP     master
 7312: //           !message passing
 7313: //           if (nproc>1) then
 7314: //             !make a copy of side concentrations
 7315: //             trsd_tmp0=trsd_tmp 
 7316: 
 7317: //             !this exchange routine swaps interface concentration between two partitions
 7318: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7319: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7320: 
 7321: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7322: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7323: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7324: 
 7325: 
 7326: //             !This obtains final values for interface sides
 7327: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7328: //       :    endif !nproc>1
 7329: //           !message passing end
