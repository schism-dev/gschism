 8389: __global__ void printMatrix(bool full) {
 8390:    // Debugging: print the matrix
 8391: 
 8392:    const int size = mesh->np;
 8393:    double sum = 0.0;
 8394:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8395:       const Node *node = mesh->localNodeData + idx_node;
 8396:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8397:       for (int j = 0; j < node->numNodes; j++) {
 8398:          Node* nbNode = node->nodes[j];
 8399:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8400:          sum += node->coeffMatrix[j];
 8401:       }
 8402:       if (full) printf("]\n");
 8403: 
 8404: 
 8405:    }
 8406:    if (!full) printf("sum=%lf\n", sum);
 8407: }
