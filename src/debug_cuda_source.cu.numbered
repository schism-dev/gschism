 8349: 
 8350:    SIDE(side);
 8351: 
 8352:    switch (varCode) {
 8353:       case (int)VarCode::outputCoords:
 8354:          const Point2 coords = side->outputCoords();
 8355:          res[side->idx*2    ] = coords.x;
 8356:          res[side->idx*2 + 1] = coords.y;
 8357:          break;
 8358:    }
 8359: }
