  383: 
  384: struct Frame {
  385:    double _t[9]; // t stands for tensor.
  386: 
  387:    // Access the tensor in Fortran order
  388:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  389: 
  390:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  391: 
  392:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  393: 
  394:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  395:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  396:       sincos(ar2, &sin_ar2, &cos_ar2);
  397: 
  398:       t(0,0) = -sin_ar1;
  399:       t(1,0) =  cos_ar1;
  400:       t(2,0) =  0.0;
  401:       t(0,1) = -cos_ar1*sin_ar2;
  402:       t(1,1) = -sin_ar1*sin_ar2;
  403: 
  404:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  405: 
  406:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  407:       assert (ar4!=0.0 && "GRID: ar4=0");
  408: 
  409:       const double ar4_inv = 1.0/ar4;
  410:       t(0,1) = t(0,1)*ar4_inv;
  411:       t(1,1) = t(1,1)*ar4_inv;
  412:       t(2,1) = t(2,1)*ar4_inv;
  413: 
  414:       // The third vector is the cross product of the first two
  415:       crossProduct(t(0,0), t(1,0), t(2,0), 
  416:                    t(0,1), t(1,1), t(2,1), 
  417:                    t(0,2), t(1,2), t(2,2));
  418:    }
  419: 
  420: 
  421:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  422:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  423:    // Inputs:
  424:    //        vec0: vel. in this frame;
  425:    //        frameout: Output frame;
  426:    // Output: 
  427:    //        vec1: vel. in new frame  
  428: 
  429:       auto const fo = frameout;
  430:       Vector2 vec1;
  431: 
  432:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  433:       // of t and fo.t are the same.
  434:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  435:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  436: 
  437:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  438:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  439: 
  440:       return vec1;
  441:    }
  442: 
  443:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  444:       // Transform a vector from global to local frame
  445:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  446:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  447:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  448:    }
  449: 
  450:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  451:       // Transform a vector from local to global frame
  452:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  453:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  454:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  455:    }   
  456: 
  457:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  458:    // Tranforms a point from global to local frame     
  459:       G2L(pi - origin0, po);
  460:    }
  461: 
  462:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  463:    // Transforms a point from local to global frame      
  464:       L2G(pi, po);
  465:       po = po + origin0;
  466:    }
  467: 
  468: };
