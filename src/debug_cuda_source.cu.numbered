 4190:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4191: 
 4192:       NODE_BND(nodeBnd);
 4193: 
 4194:       Node *node = nodeBnd->node;
 4195: 
 4196:       node->ETP = 0.0;
 4197: 
 4198:       for (int j=0; j<ntip; j++) {
 4199: 
 4200:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4201:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4202:    
 4203:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4204: 
 4205:          if constexpr(iloadtide==1) { // loading tide
 4206:             assert(false && "Loading tide not implemented");
 4207:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4208:          }
 4209:          
 4210:       }
 4211:       
 4212:    }
