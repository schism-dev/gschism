 2389: 
 2390: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2391:    if constexpr(ics == 1)  {
 2392:       return center;
 2393: 
 2394:    } else {
 2395:       const Point2 p0 = nodes[0]->outputCoords();
 2396:       const Point2 p1 = nodes[1]->outputCoords();
 2397:       const Point2 p2 = nodes[2]->outputCoords();
 2398: 
 2399:       if (isTri()) {
 2400:          return (1.0/3.0)*(p0 + p1 + p2);
 2401: 
 2402:       } else {
 2403:          const Point2 p3 = nodes[3]->outputCoords();
 2404:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2405:       }
 2406: 
 2407:    }
 2408: }
 2409: 
 2410: 
 2411: __device__ __forceinline__ double Element::centerZ(void) const { 
 2412: // Z coordinate of the element center in the global cartesian coordinates.
 2413: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2414: 
 2415:    if constexpr(ics==1) { 
 2416:       return 0.0; 
 2417: 
 2418:    } else { 
 2419: 
 2420:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2421:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2422:    } 
 2423: }
