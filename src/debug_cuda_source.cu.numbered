 6471: __global__ void getStructSizes(int* sizes)  {
 6472:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 6473:       sizes[0] = (int)sizeof(Node);
 6474:       sizes[1] = (int)sizeof(Element);
 6475:       sizes[2] = (int)sizeof(Side);
 6476:       sizes[3] = (int)sizeof(NodeBoundary);
 6477:       sizes[4] = (int)sizeof(SideBoundary);
 6478:       sizes[5] = (int)sizeof(BoundarySegment);
 6479: }
