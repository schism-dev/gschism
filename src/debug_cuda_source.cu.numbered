 8175: #ifdef DONTCOMPILE
 8176: __device__ void computeVerticalAdvection(void) {
 8177:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8178: 
 8179:    sdbt(1:2,:,:)=0.d0
 8180: 
 8181:    const Side *side = FROM kernel;
 8182: 
 8183:    if(side->isDry) return;
 8184: 
 8185:    // If side is wet...
 8186: 
 8187: 
 8188:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8189:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8190:    double ws[nvrt] = {} // w @ side
 8191:    int icount = 0;
 8192:    for (int j=0; j<2; j++) {
 8193:       const Element *elem = side->elements[j];
 8194:        
 8195:       if(elem != nullptr) {
 8196:          icount++;
 8197:          for (int k=0; k<nvrt; k++) {
 8198:             ws[k] = ws[k] + elem->w[k];
 8199:          }
 8200:       }
 8201:    }  // for j
 8202: 
 8203:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8204:    ws = ws/icount;
 8205: 
 8206:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8207:    // Splines allow for a smooth transition between vertical levels.
 8208:    // Splines have continuity restrictions at the internal knots, but
 8209:    // we have to provide the 1st derivatives at the endpoints.
 8210:    const int kbs = side->kbs; 
 8211:    
 8212:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8213:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8214:    initCubicSpline(kbs, nvrt, side, ws, up)
 8215: 
 8216:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8217:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8218:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8219: 
 8220:    // Total advection (average onto side)
 8221:    const Node *node1 = side->nodes[0];
 8222:    const Node *node2 = side->nodes[1];
 8223:    for (int k=kbs(i); k<nvrt; k++) {
 8224: 
 8225:       Vector2 bcc1 = node1->bcc[k];
 8226:       Vector2 bcc2 = node2->bcc[k];
 8227:       if constexpr(ics == 2) {
 8228:          // Project the velocities from the node frames to the side frame
 8229:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8230:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8231:       }
 8232: 
 8233:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8234:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8235: 
 8236:    }
 8237: }
 8238: #endif
 8239: 
 8240: 
 8241: extern "C" {
 8242:    __global__ void computeElemAverageGhat(void) {
 8243:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8244: 
 8245:       ELEM(elem);
 8246:       
 8247:       elem->ghat1= {0.0, 0.0};  
 8248: 
 8249:       if constexpr(ihydraulics != 0) {
 8250:          if (nhtblocks > 0 && elem->isblock) return;
 8251:       }
 8252: 
 8253:       
 8254:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8255:       // cff1-3: coefficients for 2D/3D
 8256: 
 8257:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8258:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8259:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8260: 
 8261:       if (elem->isDry) return;
 8262: 
 8263:       // Average of the coefficients
 8264:       double av_cff1 = 0.0;  // av. for cff1
 8265:       double av_cff2 = 0.0;  // av. for cff2
 8266:       double av_cff3 = 0.0;  // av. for cff3
 8267:       double av_df = 0.0;  // av. for H^\alpha / H
 8268:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8269:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8270: 
 8271:       const int i34 = elem->i34;
 8272:       const int kb  = elem->kb;
 8273: 
 8274:       for (int j=0; j<i34; j++) {
 8275:          // For each node and side in the element...
 8276: 
 8277:          const Node *node = elem->nodes[j];
 8278:          const Side *side = elem->sides[j];
 8279: 
 8280:          const double chi      = side->chi;
 8281:          const double veg_c2   = side->veg_c2;
 8282:          const double veg_beta = side->veg_beta;
 8283:          const double veg_h    = side->veg_h();
 8284:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8285: 
 8286:          const Vector2 gradPhi = elem->gradPhi[j];
 8287: 
 8288:          // Node - const in elem
 8289:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8290:          elem->gradPr  += node->pr  *gradPhi;
 8291: 
 8292:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8293: 
 8294:         
 8295:          const double htot  = side->htot2();        // Total depth at the side
 8296:          const double zctr2 = side->zTopCanopy();  
 8297: 
 8298:          double cff1; 
 8299:          double cff2; 
 8300:          double cff3;   
 8301:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8302:          // coefficients applied to 2D/3D case 
 8303:             cff1 = side->hhat/htot;
 8304:             cff2 = 0.0;
 8305:             cff3 = 0.0;
 8306:          } else { //3D
 8307:             //Init for no-veg case
 8308:             cff1 = 1.0;
 8309:             cff2 = 1.0;
 8310:             cff3 = 0.0;
 8311: 
 8312:             if constexpr(iveg != 0) {
 8313:                // Computes coefficients used with vegetation terms G1, G2
 8314:                // cff1, cff3 are used for the first two terms in G1, G2:
 8315:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8316:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8317:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8318:                if(veg_h < 0.99*htot) { // submergent vegetation
 8319:                   cff1 = 1.0;
 8320:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8321:                   cff3 = veg_c;
 8322: 
 8323:                } else { // emergent vegetation
 8324:                   cff1 = 1.0/(1.0 + veg_c2);
 8325:                   cff2 = cff1;
 8326:                   cff3 = 0.0;
 8327: 
 8328:                }
 8329:             } // if iveg
 8330:          } //  2D/3D
 8331: 
 8332:          av_cff1 += cff1/i34;
 8333:          av_cff2 += cff2/i34;
 8334:          av_cff3 += cff3/i34;
 8335:          av_cff2_chi += cff2*chi/i34;
 8336:          av_cff3_chi += cff3*chi/i34;
 8337:          av_df += min(htot, veg_h)/(htot*i34);
 8338: 
 8339: 
 8340:          // btrack values: U^\star, U^{\star\alpha}
 8341:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8342:          Vector2 Ustar       = {0.0, 0.0}; 
 8343:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8344: 
 8345:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8346:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8347:          } else { //3D
 8348:             for (int k = side->kb + 1; k < nvrt; k++) {
 8349:             
 8350:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8351:                Ustar += w2;
 8352: 
 8353:                if constexpr(iveg != 0) {
 8354:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8355:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8356:                        Ustar_alpha += zrat*w2; // XXXX
 8357:                    }
 8358:                }  // if iveg
 8359:             }  // for k
 8360:          }  //2D/3D
 8361: 
 8362:          // If needed, project the side velocities to the element frame
 8363:          if constexpr(ics==2) {
 8364:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8365:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8366:          }
 8367:         
 8368: 
 8369:          // Add btrack & surface stress terms to \breve{G} first
 8370:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8371: 
 8372: 
 8373:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8374:          Vector2 tau    = side->tau();  
 8375:          Vector2 ubstar = side->btu[side->kb + 1];  
 8376: 
 8377:          // If needed, project tau and ubstar to the element frame
 8378:          if constexpr(ics==2) {
 8379:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8380:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8381:          }
 8382: 
 8383:          // Term for surface and bottom stress
 8384:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8385: 
 8386: 
 8387:          // All terms in F,F^\alpha,f_b except baroclinic
 8388:          // F, f_b: all explicit terms excluding vegetation 
 8389:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8390:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8391:          const double coriolis = side->coriolis;
 8392:          Vector2 F  =  coriolis*side->U;  // F_x
 8393:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8394:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8395: 
 8396:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8397:             
 8398:             for (int k = side->kb; k < nvrt; k++) {
 8399:                if (zctr2 > side->zc[k-1]) {
 8400:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8401:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8402:                    Fa +=  coriolis*w2*zrat;
 8403:                } // if zctr2
 8404:             } // k
 8405:          } // iveg
 8406: 
 8407:          // Integrate horizontal viscosity force vertically
 8408:          for (int k=side->kb + 1; k<nvrt; k++) {
 8409:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8410: 
 8411:             F += levelHorVisc;
 8412: 
 8413:             // Vegetation term
 8414:             if constexpr(iveg!=0) {
 8415:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8416:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8417:                   Fa += levelHorVisc*zrat;
 8418:                } 
 8419:             } // if iveg
 8420:          } // for k
 8421: 
 8422:          // Get nu*grad(U) at the side's bottom level
 8423:          Vector2 nuGradU = side->nuGradU[side->kb];
 8424: 
 8425:          fb += nuGradU;
 8426: 
 8427:          // If needed, project vectorsF, fb and Fa to the element frame
 8428:          if constexpr(ics==2) {
 8429:             F    = side->frame.projHorVec(F,    elem->frame);
 8430:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8431:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8432:          } // if ics
 8433: 
 8434:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8435:       } // for j (nodes and sides)
 8436: 
 8437:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8438: 
 8439: 
 8440:       // Finish off terms in F, F^\alpha and f_b
 8441:       const double grav3 = elem->mean(&Node::grav2);
 8442:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8443:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8444:       for (int j=0; j<i34; j++) { 
 8445:          // For each side in the element...
 8446:          const Side *side = elem->sides[j];
 8447:          const double chi = side->chi;
 8448: 
 8449:          const double htot = side->htot2();
 8450:          const double veg_h = side->veg_h();
 8451:          const Vector2 F  = htot*fb;
 8452:          const Vector2 Fa = min(htot, veg_h)*fb;
 8453: 
 8454:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8455:       } // for j
 8456: 
 8457:       // tmp is already in elem frame
 8458:       elem->ghat1 += tmp/i34;
 8459: 
 8460:       // Baroclinic force
 8461:       if constexpr(ibc==0) {
 8462:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8463: 
 8464:          Vector2 Fa = {0.0, 0.0};
 8465:          Vector2 intGradRho = {0.0, 0.0};
 8466:          
 8467:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8468:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8469:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8470: 
 8471:             // \in F [m^2/s/s]
 8472:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8473:          }
 8474: 
 8475:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8476:          const Vector2 F = av_df*Fa; //approx
 8477:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8478: 
 8479:       } // if ibc
 8480: 
 8481: 
 8482: 
 8483:    }
 8484: 
 8485: } // extern "C"
 8486: 
 8487: 
 8488: 
 8489: #ifdef DONTCOMPILE
 8490: __global__ void checkMassConservation(Tracers* sumtr) {
 8491: 
 8492:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 8493: 
 8494:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 8495: 
 8496:    Element *elem = &(mesh->localElemData[i]);
 8497: 
 8498:    // Skip dry elements
 8499:    if (elem->isDry) return;
 8500: 
 8501:    // Local sum array for this thread
 8502:    double localSum[N_TRACERS] = {0.0};
 8503: 
 8504:    // Sum over vertical levels for this element
 8505:    const int kbe = elem->kbe;
 8506:    const double area = elem->area;
 8507: 
 8508:    for (int k = kbe; k < nvrt; k++) {
 8509:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 8510:       
 8511:       // Accumulate tracer mass
 8512:       for (int tr = 0; tr < N_TRACERS; tr++) {
 8513:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 8514:       }
 8515:    }
 8516: 
 8517:    //  This function returns per element sums. A reduction must be done on the host side.
 8518: }
 8519: 
 8520: 
 8521: __global__ void transport(void) {
 8522: 
 8523:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 8524: 
 8525:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 8526: 
 8527:    Element *elem = &(mesh->localElemData[ie]);
 8528: 
 8529:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 8530: 
 8531:                for (int m=0; m<ntr; m++) {
 8532:                   for (int k=kbe(ie); k<nvrt; k++) {
 8533:                      // Calculate each polynomial's weight 
 8534:                      wm=0.d0; sum1=0.d0; 
 8535:                      wm1=0.d0; wm2=0.d0; 
 8536:                      for (int i=0; i<elem->nweno2; i++) {
 8537:                   
 8538:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8539:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8540:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8541:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8542:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8543:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 8544:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 8545:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 8546:                      // -----------------Hu and Shu (1999)'s method----------------
 8547:                      b4=b1+b2+b3
 8548: 
 8549: //Error: add PRODUCTION CPP
 8550: #ifdef DEBUG
 8551:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 8552:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 8553:                     call parallel_abort(errmsg)
 8554:                   }
 8555: #endif
 8556: 
 8557:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 8558:                   // !----test-------------- 
 8559:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 8560:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 8561:                   // !wm(i)=wm1(i)*wm2(i)
 8562:                   // !---------------------- 
 8563:                   sum1=sum1+wm(i)
 8564:                 } // end for i
 8565: 
 8566:                 wm=wm/sum1
 8567: 
 8568:                 for (int j=0; j<elem->i34; j++) {
 8569: 
 8570:                   const Side *side  = elem->sides[j];
 8571:                   const Node *node1 = side->n1;
 8572:                   const Node *node2 = side->n2;
 8573: 
 8574:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 8575:                      trsd=0.d0
 8576:                      for (int kk=0; kk<nquad; kk++) {
 8577:                         for (int i=0; i<elem->nweno2; i++) {
 8578:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8579:                         } // end for i   
 8580:                      } // end for kk
 8581:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8582:                   } // outward flux
 8583:                } // end for j=1,i34(ie) ! side
 8584:             }
 8585:          }
 8586:               
 8587: 
 8588: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 8589: //             //   calculate each polynomial's weight 
 8590: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 8591: //                 wm=0.d0; sum1=0.d0
 8592: //                 do i=1,nweno1(ie) !for each polynomial
 8593: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8594: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8595: //                   b1=b1*b1+b2*b2 !smoothness indicator
 8596: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 8597: //                   wm(i)=b2
 8598: //                   sum1=sum1+b2
 8599: //                   !wm(i)=1.d0
 8600: //                   !sum1=sum1+1.d0
 8601: 
 8602: // // Error: PRODUCTION
 8603: // #ifdef DEBUG
 8604: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 8605: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 8606: //                     call parallel_abort(errmsg)
 8607: //                   endif
 8608: // #endif
 8609: 
 8610: //                 enddo !i
 8611: //                 wm=wm/sum1 !final weight
 8612: 
 8613:                 for (int j=0; j<elem->i34; j++) { // side
 8614:                   const Side *side = elem->sides[j];
 8615:                   const Node *node1 = side->n1;
 8616:                   const Node *node2 = side->n2;
 8617: 
 8618:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 8619:                     trsd=0.d0
 8620:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 8621:                       for (int i=0; i<elem->nweno1; i++) {
 8622:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 8623:                       }
 8624:                     enddo //kk
 8625:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8626:                   } // outward flux
 8627:                 } // end for j=1,i34(ie) ! side
 8628:               } // end for k; ntr 
 8629: 
 8630:             else !simple upwind method
 8631:               do j=1,i34(ie)
 8632:                 jsj=elside(j,ie)
 8633:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 8634:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 8635:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 8636:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 8637:                   endif
 8638:                 enddo  !vertical layers
 8639:               enddo !j=1,i34(ie) ! side
 8640:             endif !order of accuracy
 8641: 
 8642:          //  enddo !ie
 8643: // !$OMP     end do
 8644: 
 8645: // !$OMP     master
 8646: //           !message passing
 8647: //           if (nproc>1) then
 8648: //             !make a copy of side concentrations
 8649: //             trsd_tmp0=trsd_tmp 
 8650: 
 8651: //             !this exchange routine swaps interface concentration between two partitions
 8652: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 8653: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 8654: 
 8655: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 8656: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 8657: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 8658: 
 8659: 
 8660: //             !This obtains final values for interface sides
 8661: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 8662: //       :    endif !nproc>1
