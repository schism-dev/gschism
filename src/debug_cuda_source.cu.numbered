 8075: __global__ void getStructSizes(int* sizes)  {
 8076:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8077:       sizes[0] = (int)sizeof(Node);
 8078:       sizes[1] = (int)sizeof(Element);
 8079:       sizes[2] = (int)sizeof(Side);
 8080:       sizes[3] = (int)sizeof(NodeBoundary);
 8081:       sizes[4] = (int)sizeof(SideBoundary);
 8082:       sizes[5] = (int)sizeof(BoundarySegment);
 8083: }
