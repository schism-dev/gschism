 9823: 
 9824: __global__ void returnMatrix(double *res) {
 9825:    // Debugging: dense local matrix, row-major, size = mesh->np
 9826:    // Assumes single-partition / local indexing (see note below).
 9827: 
 9828:    const int size = mesh->np;
 9829: 
 9830:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9831:       const Node *node = mesh->localNodeData + idx_node;
 9832: 
 9833:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9834: 
 9835:       for (int j = 0; j < node->numNodes; j++) {
 9836:          const Node *nbNode = node->nodes[j];
 9837:          // Only dump neighbors that live on this partition
 9838:          if (nbNode->part != mesh->partNum) continue;
 9839: 
 9840:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9841:          const double aij = node->coeffRow[node->csrSlot[j]];
 9842:          if (aij != 0.0)
 9843:             res[jlocal * size + idx_node] = aij;
 9844:       }
 9845:    }
 9846: }
 9847: 
 9848: 
 9849: __global__ void returnX(double *res) {
 9850:    // Debugging: returns the matrix as a CuPy array
 9851: 
 9852:    const int size = mesh->np;
 9853:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9854:       const Node *node = mesh->localNodeData + idx_node;
 9855: 
 9856:       res[idx_node] = node->mX;
 9857: 
 9858:    }
 9859:    
 9860: }
