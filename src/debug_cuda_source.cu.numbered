 1431: 
 1432:    // Tidal velocity boundary conditions. They are computed from the nodal tidal velocity amplitudes and phases in populateBoundarySides().
 1433:    // nbfr ? nbfr : 1 is there to avoid a 0-sized array.
 1434:    Vector2 umo[nbfr ? nbfr : 1];  // tidal velocity amplitude 
 1435:    Vector2 ufa[nbfr ? nbfr : 1];  // tidal velocity phase
 1436:    
 1437:    __inline__ __device__ double getBoundaryArrayValueWeight(void) const;
