 1858: // Helper functions for computing the local node index at a given offset from another.
 1859: __device__ __inline__ int nxq(int offset, int index, int size) {
 1860:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1861:    // to the index to make it positive
 1862:    assert(index + offset + 16*size >= 0);
 1863:    return (index + offset + 16*size) % size;  
 1864: }
 1865: 
 1866: __device__ __inline__ int nxq(int index, int size) {
 1867:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1868:    // to the index to make it positive
 1869:    assert(index + 16*size >= 0);
 1870:    return (index + 16*size) % size; 
 1871: }
