 1767: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1768:    // Computes the 3D normal vector to the element at level k
 1769:    // Returns the normal vector and the area of the element
 1770: 
 1771:       if (isTri()) {
 1772:          // For triangles...
 1773: 
 1774:          // Gets the normal vector to the element (with a length equal to twice the area)
 1775:          if constexpr(ics==1) {
 1776:             const int kb0 = max(k, nodes[0]->kb);
 1777:             const int kb1 = max(k, nodes[1]->kb);
 1778:             const int kb2 = max(k, nodes[2]->kb);
 1779: 
 1780:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1781:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1782:             
 1783:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1784:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1785:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1786:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1787: 
 1788:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1789:             area3D = 0.5*len;
 1790: 
 1791:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1792: 
 1793:             return {nx/len, ny/len, nz/len};
 1794: 
 1795:            
 1796:          }
 1797:          else {  // lat/lon
 1798:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1799: 
 1800:          } // if ics
 1801:       }
 1802:       else {
 1803:          // For quads...
 1804: 
 1805:          assert(false && "Element normal vector: quads not yet implemented");
 1806: 
 1807: 
 1808:       }
 1809:    }
 1810: 
 1811: /**
 1812:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1813:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1814:    If the segment is completely inside the element, then it returns true.
 1815: 
 1816:    This function assumes:
 1817:    - The initial point is on a side of the element. 
 1818:    - Its position is given by parameter t in the range [0,1].
 1819:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1820:       intersects the element (elements are convex).
 1821: 
 1822:    To find the intersection point, this function does the following:
 1823:    - it finds the intersection of the line segment with all the element side lines,
 1824:       except for the one that contains the initial point.
 1825:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1826:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1827:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1828:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1829:       track segment is almost parallel to the element side line.
 1830: 
 1831:    Inputs:
 1832:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1833:    @param x2, y2: other end of the line segment
 1834: 
 1835:    Outputs:
 1836:    @param side:  side that intersects the line segment (input and output)
 1837:    @param nextElement (output): element that contains the intersection point
 1838:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1839:    @param zint (input/output): Vertical coordinate of the intersection point
 1840: 
 1841:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1842:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1843:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1844: 
 1845:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1846:    (Delta) being zero.
 1847: 
 1848:    The intersection2 point happens when:
 1849:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1850:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1851:    
 1852:    Assumption: the 4 points (including those of the side segment) are different.
 1853:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1854:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1855:    If true, (xIntersect,yIntersect) is the intersection.				
 1856:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1857: **/
 1858: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1859:                                               double &t, double& tIntersect) {
 1860: 
 1861:    double closest_intersect_t = 1e10;
 1862:    bool found_intersection = false;
 1863: 
 1864:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1865:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1866:    const Point2 x1 = side->point(t);
 1867:    
 1868: 
 1869:    Side *nextSide = nullptr;
 1870:    for (int i = 0; i < i34; i++) {
 1871: 
 1872:       // Element's i-th side 
 1873:       Side *side2 = sides[i];
 1874: 
 1875:       // Skip the side that contains the initial point
 1876:       if (side2 == side) continue;
 1877: 
 1878:       // (x3,y3)-(x4,y4) is the element side line
 1879:       const Point2 x3 = side2->n1->p;
 1880:       const Point2 x4 = side2->n2->p;
 1881: 
 1882:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1883:       const double delta = cross(x2 - x1, x3 - x4);
 1884: 
 1885:       if (delta != 0.0) {
 1886: 
 1887:          const double delta1 = cross(x3 - x1, x3 - x4);
 1888:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1889: 
 1890:          // Solves the two linear equations for tt1 and tt2
 1891:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1892:          const double tt2 = delta2/delta;
 1893: 
 1894:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1895:             closest_intersect_t = min(closest_intersect_t, tt1);
 1896:             nextSide = side2;
 1897: 
 1898:             nextElement = nextSide->otherElem(this);
 1899:             tIntersect = max(small, min(tt1, 1.0-small));
 1900:             t = tt2;
 1901: 
 1902:             found_intersection = true;
 1903:          }
 1904:       
 1905:       }
 1906: 
 1907:    }
 1908: 
 1909:    // found_intersection should always be true, since we checked all the sides.  
 1910:    side = nextSide;
 1911: 
 1912:    return found_intersection;
 1913: }
 1914: 
 1915: 
 1916: 
 1917: 
 1918: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1919:                                               double &t, double& tIntersect) {
 1920: 
 1921:    double closest_intersect_t = 1e10;
 1922:    bool found_intersection = false;
 1923: 
 1924:    for (int i = 0; i < i34; i++) {
 1925: 
 1926:       Side *side2 = sides[i];
 1927: 
 1928:       // (x3,y3)-(x4,y4) is the element side line
 1929:       const Point2 x3 = side2->n1->p;
 1930:       const Point2 x4 = side2->n2->p;
 1931: 
 1932:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1933:       const double delta = cross(x2 - x1, x3 - x4);
 1934: 
 1935:       if (abs(delta) > 0) {
 1936: 
 1937:          const double delta1 = cross(x3 - x1, x3 - x4);
 1938:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1939: 
 1940:          // Solves the two linear equations for tt1 and tt2
 1941:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1942:          const double tt2 = delta2/delta;
 1943: 
 1944:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1945:             closest_intersect_t = min(closest_intersect_t, tt1);
 1946:             side = side2;
 1947:             nextElement = side->otherElem(this);
 1948:             t = tt2;
 1949:             tIntersect = max(small, min(tt1, 1.0-small));
 1950:             found_intersection = true;
 1951:          }
 1952:       
 1953:       }
 1954:       else {  // parallel segments
 1955:          assert(false && "Parallel segments");
 1956:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1957:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1958: 
 1959:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1960: 
 1961:          // const double dist = dot(x1 - x3, side2->n);
 1962:          // if (abs(dist) < small*length(x3 - x4)) {
 1963:          //    const double2 unitarySide = normalize(x4 - x3);
 1964:          //    const double len = dot(x2 - x1, unitarySide);
 1965:          //    t = t + len;
 1966:          //    t = max(0.0, min(t, 1.0));
 1967:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1968: 
 1969: 
 1970:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1971:          //    // t = tt2;
 1972:          //    found_intersection = true;
 1973:          // }
 1974:       }
 1975: 
 1976: 
 1977:    }
 1978: 
 1979:       
 1980:    assert(found_intersection && "No intersection found");
 1981: 
 1982:    // found_intersection should always be true, since we checked all the sides.  
 1983:    return found_intersection;
 1984: }
 1985: 
 1986: 
 1987: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1988:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1989: 
 1990:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1991: 
 1992:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1993:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1994:    // curElement.
 1995: 
 1996:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1997:    // And uses this velocity instead to continue the tracking.
 1998: 
 1999:    // computes the intersection point in cartesian coordinates
 2000:    Point2 intersection = nextSide->p_t(tt);
 2001: 
 2002:    // Nudges the point to the barycenter of the element. 
 2003:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2004:    // next segment intersects the element sides.  
 2005:    curElem->nudgeToBarycenter(intersection);
 2006: 
 2007:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2008:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2009:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2010:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2011: 
 2012:    // If the side is an open boundary, the tangential velocity is zero.
 2013:    if (nextSide->isBnd()) vtan = 0.0;
 2014: 
 2015:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2016:    const double us = vtan*nextSide->t().x;
 2017:    const double vs = vtan*nextSide->t().y;
 2018:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 2019: 
 2020:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2021:    const double len2 = norm2(intersection - toPoint2(xt));
 2022:    const double vel2 = dot(u_int, u_int);        
 2023:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 2024:    else            dt = 0.0;
 2025: 
 2026:    // The end of this tracking segment is now the intersection point.
 2027:    xt = {intersection.x, intersection.y, zint};
 2028: 
 2029:    u_int = {us, vs, ws};
 2030:    
 2031: }
 2032: 
 2033: /**
 2034:  * Tracks a particle through elements and vertical levels in the mesh.
 2035:  * 
 2036:  * @param x0,y0,z0     Starting position coordinates
 2037:  * @param xt,yt,zt     Target position coordinates
 2038:  * @param dtb          Time step for tracking
 2039:  * @param uuint,vvint,wwint Initial velocity components
 2040:  * @param nextElem     Starting/resulting element index
 2041:  * 
 2042:  * @return Status code of type trackExitCodes
 2043:  * 
 2044:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2045:  * of the details are different. The idea is that the code requires less branches and is better fit
 2046:  * for GPU execution.
 2047:  * 
 2048:  * The main ideas here are:
 2049:  * - The starting point is expected to be in the starting element.
 2050:  * - The end point is guaranteed to be inside an element.
 2051:  * - since the starting point is inside the element, there are only two cases: 
 2052:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2053:  *     (b) it does not and (xt,yt) is already in the starting element.
 2054:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2055:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2056:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2057:  * - tt1 can be positive or negative. We only consider the positive values.
 2058:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2059:  * - The next intersection will occur at the smallest positive tt1.
 2060:  * - This intersection will be the next (x0,y0) position.
 2061:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2062:  *   of getting stuck in a loop.
 2063:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2064:  *   was found.
 2065:  */
 2066: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2067:                                                        Element *&nextElem, int &jlev, double &dt,
 2068:                                                        const Side *origSide) {
 2069: 
 2070: 
 2071: 
 2072:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2073:    // else to do.
 2074:    // If it is, nudges the point to be inside the element.
 2075:    const Element *curElem = nextElem;
 2076:    if (containsPoint(toPoint2(xt), true)) {
 2077: 
 2078:       curElem->interpolateVelocities(xt, u_int);
 2079: 
 2080: addDebugPlot(x0, xt);
 2081:       return true;
 2082:    }
 2083: 
 2084:    Side *side = nullptr;
 2085: 
 2086:    // 1. Initial checks
 2087:    // Verify starting element is valid (wet)
 2088:    assert(!curElem->isDry && "Starting element is dry");
 2089: 
 2090:    // Checks if track has a zero length.
 2091:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2092:    // assert(len2 > 0.0 && "Zero length track"); 
 2093:    
 2094:    const int MAX_ITERATIONS = 1000;
 2095:    
 2096:    double t;
 2097:    Side *nextSide = nullptr;
 2098:    double tIntersect = 1e10;
 2099:    double zint = x0.z;
 2100: 
 2101:    // Horizontal tracking loop
 2102:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2103:    // (x0,y0) is inside the element but the target point is not.
 2104: 
 2105:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2106: 
 2107:    assert(found_intersection && "No intersection found at %d");
 2108: 
 2109:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2110: 
 2111:    // if the tracking segment goes out of water (either dry or edge boundary)
 2112:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2113: 
 2114: addDebugPlot(x0, xt, 0x00A0FF);
 2115:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2116: addDebugPlot(x0, xt, 0x00A0FF);      
 2117: 
 2118:       nextElem = this;
 2119:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2120:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2121:       return true;    
 2122:    }
 2123: 
 2124: 
 2125:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2126:    int iterations = 0;
 2127:    while (iterations < MAX_ITERATIONS) {
 2128:       iterations++;
 2129:       
 2130:       Element *curElem = nextElem;
 2131: 
 2132:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2133: addDebugPlot(x0, xt);
 2134:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2135: 
 2136:       // If we are already in the target element, we are done.
 2137:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2138:       if (!found_intersection) break;
 2139: 
 2140: 
 2141: 
 2142:       // if the tracking segment goes out of water (either dry or edge boundary).
 2143:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2144: addDebugPlot(x0, xt, 0x00A0FF);
 2145:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2146: addDebugPlot(x0, xt, 0x00A0FF);   
 2147:          nextElem = curElem;
 2148: 
 2149:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2150:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2151:          return true;
 2152:       }
 2153:       
 2154:       // Update position and element for next iteration
 2155:       side = nextSide;
 2156: 
 2157:    }
 2158: 
 2159:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2160: 
 2161:  
 2162:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2163:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2164: addDebugPlot(x0, xt);   
 2165:    nextElem->interpolateVelocities(xt, u_int); 
 2166: 
 2167:    return true;
 2168: }
 2169: 
 2170: 
 2171: __inline__ __device__ double Element::computeSignedArea(void) const {
 2172:    // Compute the area of the element
 2173: 
 2174:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2175: 
 2176:    // In the quad case we need to add the area of the other triangle.
 2177:    if (isQuad()) {
 2178:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2179:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2180:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2181:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2182: 
 2183:       res += ar1;
 2184:    }
 2185: 
 2186:    return res;
 2187: }
 2188: 
 2189: 
 2190: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2191:                                                                 (nodes[1]->isDry2()) ||
 2192:                                                                 (nodes[2]->isDry2()) ||
 2193:                                                                 (i34==4 && nodes[3]->isDry2());
 2194: }
 2195: 
 2196: __inline__ __device__ double Element::detJ_eta(void) const {
 2197:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2198:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2199: }
 2200: 
 2201: __inline__ __device__ double Element::detJ_xi(void) const {
 2202:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2203:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2204: }
 2205: 
 2206: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2207:    // In boundary sides, the element 1 is nullptr
 2208:    return side->elems[1] == nullptr; 
 2209: }
 2210: 
 2211: 
 2212: 
 2213: /**
 2214:    Compute the shape coordinates of the point (xt,yt) in the element.
 2215:    @param xt (input): x-coordinate of the point
 2216:    @param shpCoords (output): shape coordinates of the point
 2217:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2218:    @return true if the point is inside the element, false otherwise
 2219: **/
 2220: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2221:                                             bool fixNegshpCoord) const {
 2222: 
 2223:    // Compute the shape coordinates of the point xt in the element.
 2224:    if (i34==3) {
 2225:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2226:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2227:       // and in this case, the pt will be nudged into the element
 2228:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2229:       // from the local frame, so use additional check.
 2230: 
 2231:       Point2 x0, x1, x2;
 2232: 
 2233:       if constexpr(ics==1) {
 2234:          x0 = nodes[0]->p;
 2235:          x1 = nodes[1]->p;
 2236:          x2 = nodes[2]->p;
 2237:       }
 2238:       else // lat/lon
 2239:       {
 2240:          Error("Not implemented yet");
 2241: #ifdef ICS2
 2242:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2243:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2244:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2245: #endif
 2246:       }
 2247: 
 2248:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2249:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2250:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2251:       shpCoords[3] = 0.0;
 2252:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2253: 
 2254:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2255:       // then we fix the negative shape coordinates.
 2256:       if (fixNegshpCoord && tmpmin<=0.0) {
 2257: 
 2258:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2259:          // keeping the sum of the shape coordinates equal to 1.
 2260:          // I have tested and compared the new algorithm with the old one, and they give
 2261:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2262:          // The new algorithm should be faster since it is branchless.
 2263:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2264:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2265:          
 2266:          shpCoords[0] = (shpCoords[0] + a)*b;
 2267:          shpCoords[1] = (shpCoords[1] + a)*b;
 2268:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2269: 
 2270:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2271:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2272:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2273:          }
 2274: 
 2275:          // Update the point coordinates for the new shape coordinates
 2276:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2277:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2278:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2279: 
 2280:       }
 2281: 
 2282:       // Check if the point is inside the element
 2283:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2284:    }
 2285:    else {
 2286:       Error("Not implemented yet");
 2287: #ifdef QUADS
 2288:       // Reproject pt in eframe of nel for ics=2
 2289:       if constexpr(ics==1) {
 2290:          xn2 = xt; 
 2291:          yn2 = yt;
 2292:       }
 2293:       else {
 2294:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2295:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2296:       }
 2297: 
 2298:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2299: #endif
 2300:    }
 2301: 
 2302:    return false;  // Never reached
 2303: 
 2304: }
 2305: 
 2306: 
 2307: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2308: // Convert shape coordinates to cartesian coordinates
 2309: 
 2310:    if (i34 == 3) {
 2311:       // Triangular element
 2312:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2313:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2314:    }
 2315:    else {
 2316:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2317:    }
 2318: 
 2319: }
 2320: 
 2321: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2322:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2323:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2324:    // The formula for the integral is:
 2325:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2326: 
 2327:    printf("intPhiPhi: TEST\n");
 2328: 
 2329:    const Node *n0 = nodes[0];
 2330:    const Node *n1 = nodes[1];
 2331:    const Node *n2 = nodes[2];
 2332:    const Node *n3 = nodes[3];
 2333: 
 2334:    const Vector2 p0 = n0->p;
 2335:    const Vector2 p1 = n1->p;
 2336:    const Vector2 p2 = n2->p;
 2337:    const Vector2 p3 = n3->p;
 2338: 
 2339:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2340:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2341:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2342:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2343: 
 2344:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2345: }
 2346:    
 2347: 
 2348: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2349:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2350:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2351:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2352:    // The formula is also based on the identity:
 2353:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2354:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2355: 
 2356:    printf("intGradPhiGradPhi: TEST\n");   
 2357: 
 2358:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2359: 
 2360:    const double x0 = nodes[0]->p.x;
 2361:    const double y0 = nodes[0]->p.y;
 2362:    const double x1 = nodes[1]->p.x;
 2363:    const double y1 = nodes[1]->p.y;
 2364:    const double x2 = nodes[2]->p.x;
 2365:    const double y2 = nodes[2]->p.y;
 2366:    const double x3 = nodes[3]->p.x;
 2367:    const double y3 = nodes[3]->p.y;
 2368: 
 2369:    double res = 0.0;
 2370:    
 2371:    // Quadrature points in xi and eta coordinates
 2372:    #pragma unroll
 2373:    for (int i = 0; i < 4; i++) {
 2374:       // For each quadrature point...
 2375: 
 2376:       const Point2 p = GaussPoint(i);
 2377:       const double eta = p.x;
 2378:       const double xi  = p.y;
 2379: 
 2380:       // Jacobian entries at the Gauss point p
 2381:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2382:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2383:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2384:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2385: 
 2386:       const double detJ = jacobianDet(p);
 2387:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2388: 
 2389:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2390:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2391:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2392:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2393:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2394: 
 2395:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2396:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2397:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2398:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2399:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2400: 
 2401:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2402:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2403:    }
 2404: 
 2405:    return res;
 2406: }
 2407: 
 2408: 
 2409: /**  Interpolate velocities at a given point (xt,yt,zt)
 2410: 
 2411:    @param xt, yt, zt: coordinates of the point to interpolate
 2412:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2413: 
 2414:    This is done in four steps:
 2415: 
 2416:    1. Find the shape coordinates for the final position in the element.
 2417:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2418:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2419:       z levels at xt, yt at each step.   
 2420:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2421:       horizontally and vertically.
 2422: **/
 2423: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2424:    // Interpolate the velocities at the point xt. 
 2425:    // This function works the same for triangular and quadrilateral elements.
 2426:    double shpCoord[4];
 2427: 
 2428:    // First step is to compute the shape coordinates of (xt,yt)
 2429:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2430:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2431: 
 2432:    // Second step is to find the level that contains zt
 2433:    // Uses a binary search to find the level
 2434:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2435:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2436:    int R = nvrt - 1;
 2437: 
 2438:    // Get the z coordinates at the nodes of the element at the levels L and R
 2439:    double zLAtNodes[4], zRAtNodes[4];
 2440:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2441:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2442: 
 2443:    double zL = interpolate(shpCoord, zLAtNodes);
 2444:    double zR = interpolate(shpCoord, zRAtNodes);
 2445:    
 2446:    // Interpolates vertically the velocities
 2447:    double wght1, wght2;
 2448:    if (xt.z<=zL) {
 2449:       wght1 = 1.0;
 2450:       wght2 = 0.0;
 2451:    }
 2452:    else if (xt.z>=zR) {
 2453:       wght1 = 0.0;
 2454:       wght2 = 1.0;
 2455:    }
 2456:    else {
 2457:       // Perform a binary search to find the levels between L and R that contain xt.z
 2458:       while (R - L > 1) {
 2459:          int M = (L + R) / 2;
 2460: 
 2461:          double zMAtNodes[4];
 2462:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2463:          double zM = interpolate(shpCoord, zMAtNodes);
 2464:          if (zM < xt.z) 
 2465:          {
 2466:             L = M;
 2467:             zL = zM;
 2468:          }
 2469:          else 
 2470:          {
 2471:             R = M;
 2472:             zR = zM;
 2473:          }
 2474:       }
 2475:       assert(L == R-1);
 2476:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2477: 
 2478:       wght2 = (xt.z - zL)/(zR - zL);
 2479:       wght1 = 1.0 - wght2;
 2480:    }
 2481: 
 2482:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2483:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2484: 
 2485:    // Neither of the interpolated velocities should be NaN
 2486:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2487: 
 2488: }
 2489: 
 2490: 
 2491: 
 2492: 
 2493: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2494: 
 2495:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2496:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2497:    const Node *n1 = side->n1;
 2498:    const Node *n2 = side->n2;
 2499: 
 2500:    bool n1_match = (n1->nodeBnd->segment == segment);
 2501:    bool n2_match = (n2->nodeBnd->segment == segment);
 2502: 
 2503:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2504:    if (n1_match && n2_match) {
 2505:       return 0.5;
 2506:    } else if (n1_match) {
 2507:       return 1.0;
 2508:    } else if (n2_match) {
 2509:       return 0.0;
 2510:    }
 2511: 
 2512:    return 0.0;
 2513: }
