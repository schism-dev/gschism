 2068: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2069: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2070: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2071: // Only when ics == 2, the origin is at the element center.
 2072: 
 2073:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2074: 
 2075:    if constexpr(ics==1) {
 2076:       return nodes[idxNode]->p;
 2077: 
 2078:    } else {
 2079:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2080: 
 2081:       const Point3 p = toPoint3(nodes[idxNode]->p, nodes[idxNode]->gz); // XXXXX use p3D or similar?
 2082: 
 2083:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2084:    }
 2085: 
 2086: }
 2087: 
 2088: 
 2089: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2) const {
 2090: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2091: 
 2092:    assert(!isQuad() && "getLocalHorizontalNodePositions only works for triangles");
 2093: 
 2094:    if constexpr(ics==1) {
 2095:       x0 = nodes[0]->p;
 2096:       x1 = nodes[1]->p;
 2097:       x2 = nodes[2]->p;
 2098: 
 2099:    } else {
 2100:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2101: 
 2102:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2103:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2104:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2105: 
 2106:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2107:       x1 = toVector2(frame.G2L(p1 - c));
 2108:       x2 = toVector2(frame.G2L(p2 - c));
 2109:    }
 2110: 
 2111: }
 2112: 
 2113: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2114: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2115: 
 2116:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2117: 
 2118:    if constexpr(ics==1) {
 2119:       x0 = nodes[0]->p;
 2120:       x1 = nodes[1]->p;
 2121:       x2 = nodes[2]->p;  
 2122:       x3 = nodes[3]->p;
 2123: 
 2124:    } else {
 2125:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2126: 
 2127:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2128:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2129:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2130:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2131: 
 2132:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2133:       x1 = toVector2(frame.G2L(p1 - c));
 2134:       x2 = toVector2(frame.G2L(p2 - c));
 2135:       x3 = toVector2(frame.G2L(p3 - c));
 2136:    }
 2137: 
 2138: }
 2139: 
 2140: 
 2141: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2142: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2143: // Returns the normal vector and the area of the element at this level
 2144: 
 2145:    if (isTri()) {
 2146:       // For triangles...
 2147: 
 2148:       // Indices of the nodes at level k, taking care of not going below the bed
 2149:       const int k0 = max(k, nodes[0]->kb);
 2150:       const int k1 = max(k, nodes[1]->kb);
 2151:       const int k2 = max(k, nodes[2]->kb);
 2152: 
 2153:       // Gets the element frame coordinates of the nodes at level k
 2154:       Point3 x0, x1, x2;
 2155:       if constexpr(ics==1) {
 2156:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2157:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2158:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2159: 
 2160:       } else {  // ics == 2
 2161:          Vector2 h0, h1, h2;
 2162: 
 2163:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2164: 
 2165:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2166:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2167:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2168:       }
 2169: 
 2170:       const Vector3 n20 = x2 - x0;
 2171:       const Vector3 n10 = x1 - x0; 
 2172: 
 2173:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2174:       const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2175:       const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2176:       const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2177: 
 2178:       const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2179:       area3D = 0.5*len;
 2180: 
 2181:       const double inv_len = 1.0/len;
 2182:       return {nx*inv_len, ny*inv_len, nz*inv_len};
 2183:    
 2184:    }
 2185:    else {
 2186:       // For quads...
 2187: 
 2188:       assert(false && "Element normal vector: quads not yet implemented");
 2189:       return {0.0, 0.0, 0.0};
 2190: 
 2191: 
 2192:    }
 2193: }
 2194: 
 2195: /**
 2196:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2197:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2198:    If the segment is completely inside the element, then it returns true.
 2199: 
 2200:    This function assumes:
 2201:    - The initial point is on a side of the element. 
 2202:    - Its position is given by parameter t in the range [0,1].
 2203:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2204:       intersects the element (elements are convex).
 2205: 
 2206:    To find the intersection point, this function does the following:
 2207:    - it finds the intersection of the line segment with all the element side lines,
 2208:       except for the one that contains the initial point.
 2209:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2210:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2211:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2212:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2213:       track segment is almost parallel to the element side line.
 2214: 
 2215:    Inputs:
 2216:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2217:    @param x2, y2: other end of the line segment
 2218: 
 2219:    Outputs:
 2220:    @param side:  side that intersects the line segment (input and output)
 2221:    @param nextElement (output): element that contains the intersection point
 2222:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2223:    @param zint (input/output): Vertical coordinate of the intersection point
 2224: 
 2225:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2226:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2227:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2228: 
 2229:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2230:    (Delta) being zero.
 2231: 
 2232:    The intersection2 point happens when:
 2233:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2234:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2235:    
 2236:    Assumption: the 4 points (including those of the side segment) are different.
 2237:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2238:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2239:    If true, (xIntersect,yIntersect) is the intersection.				
 2240:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2241: **/
 2242: 
 2243: 
 2244: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2245:                                               double &t, double& tIntersect) {
 2246:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 2247:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 2248: 
 2249:    double closest_intersect_t = 1e10;
 2250:    bool found_intersection = false;
 2251: 
 2252:    for (int i = 0; i < i34; i++) {
 2253: 
 2254:       Side *side2 = sides[i];
 2255: 
 2256:       // (x3,y3)-(x4,y4) is the element side line
 2257:       const Point2 x3 = side2->n1->p;
 2258:       const Point2 x4 = side2->n2->p;
 2259: 
 2260:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2261:       const double delta = cross(x2 - x1, x3 - x4);
 2262: 
 2263:       if (abs(delta) > 0) {
 2264: 
 2265:          const double delta1 = cross(x3 - x1, x3 - x4);
 2266:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2267: 
 2268:          // Solves the two linear equations for tt1 and tt2
 2269:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2270:          const double tt2 = delta2/delta;
 2271: 
 2272:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2273:             closest_intersect_t = min(closest_intersect_t, tt1);
 2274:             side = side2;
 2275:             nextElement = side->otherElem(this);
 2276:             t =          clamp(tt2, small, 1.0-small);
 2277:             tIntersect = clamp(tt1, small, 1.0-small);
 2278:             found_intersection = true;
 2279:          }
 2280: 
 2281:       
 2282:       }
 2283:       else {  // parallel segments
 2284: 
 2285:          continue; 
 2286:          assert(false && "Parallel segments should not happen under the new code");
 2287:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 2288:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 2289: 
 2290:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2291:          const double dist = dot(x1 - x3, side2->n);
 2292:          if (abs(dist) < small*length(x3 - x4)) {
 2293:             const double2 unitarySide = normalize(x4 - x3);
 2294:             const double len = dot(x2 - x1, unitarySide);
 2295:             t = t + len;
 2296:             t = max(0.0, min(t, 1.0));
 2297:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 2298: 
 2299: 
 2300:             // tIntersect = max(small, min(tt1, 1.0-small));
 2301:             // t = tt2;
 2302:             found_intersection = true;
 2303:          }
 2304:       }
 2305: 
 2306: 
 2307:    }
 2308: 
 2309: 
 2310:    assert(found_intersection && "No intersection found");
 2311: 
 2312:    // found_intersection should always be true, since we checked all the sides.  
 2313:    return found_intersection;
 2314: }
 2315: 
 2316: 
 2317: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2318:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2319: 
 2320:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2321:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2322:    // curElement.
 2323: 
 2324:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2325:    // And uses this velocity instead to continue the tracking.
 2326: 
 2327:    // computes the intersection point in cartesian coordinates
 2328:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2329: 
 2330:    // Nudges the point to the barycenter of the element. 
 2331:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2332:    // next segment intersects the element sides. 
 2333:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2334: 
 2335: 
 2336:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2337:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2338:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2339:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2340: 
 2341:    // If the side is an open boundary, the tangential velocity is set to zero.
 2342:    if (nextSide->isBnd()) vtan = 0.0;
 2343: 
 2344:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2345:    const double us = vtan*nextSide->t().x;
 2346:    const double vs = vtan*nextSide->t().y;
 2347:    const double ws = nextSide->w2(jlev); 
 2348: 
 2349:    u_int = {us, vs, ws};
 2350: 
 2351:    // The end of this tracking segment is now the intersection point.
 2352:    xt = {intersection.x, intersection.y, zint};
 2353:    
 2354: }
 2355: 
 2356: /**
 2357:  * Tracks a particle through elements and vertical levels in the mesh.
 2358:  * 
 2359:  * @param x0,y0,z0     Starting position coordinates
 2360:  * @param xt,yt,zt     Target position coordinates
 2361:  * @param dtb          Time step for tracking
 2362:  * @param u_int        Initial velocity components
 2363:  * @param nextElem     Starting/resulting element index
 2364:  * 
 2365:  * @return Status code of type trackExitCodes
 2366:  * 
 2367:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2368:  * of the details are different. The idea is that the code requires less branches and is better fit
 2369:  * for GPU execution.
 2370:  * 
 2371:  * The main ideas here are:
 2372:  * - The starting point is expected to be in the starting element.
 2373:  * - since the starting point is inside the element, there are only two cases: 
 2374:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2375:  *     (b) it does not and (xt,yt) is already in the starting element.
 2376:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2377:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2378:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2379:  * - tt1 can be positive or negative. We only consider the positive values.
 2380:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2381:  * - The next intersection will occur at the smallest positive tt1.
 2382:  * - This intersection will be the next (x0,y0) position.
 2383:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2384:  *   of getting stuck in a loop.
 2385:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2386:  *   was found.
 2387:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2388:  */
 2389: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2390:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2391:                                                        const Side *origSide) {
 2392:                                                             
 2393:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2394:    // else to do. This means that the full step occurred within the current element.
 2395:    assert(!isDry && "Starting element is dry");
 2396:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2397: 
 2398:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2399: 
 2400:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2401:       assert(!isDry && "Target point is inside a dry element");
 2402: 
 2403:       u_int = interpolateVelocities(xt);
 2404: 
 2405:       nextElem = this;
 2406: 
 2407: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2408:       return true;
 2409:    }
 2410: 
 2411: 
 2412:    
 2413: 
 2414:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2415:    
 2416:    double t;
 2417:    Side *nextSide = nullptr;
 2418:    double tIntersect = 1e10;
 2419: 
 2420: 
 2421:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2422:    // (x0,y0) is inside the element but the target point is not.
 2423:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2424:    assert(found_intersection && "No intersection found at %d");
 2425: 
 2426:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2427: 
 2428:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2429:    if (nextElem != nullptr && !nextElem->isDry) {
 2430:       assert(nextElem->containsPoint(xtmp) && "Intersection point is not inside the next element");
 2431:       nextElem->nudgeToBarycenter(xtmp);
 2432:    }
 2433: 
 2434:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2435:    xt = {xtmp.x, xtmp.y, zint};
 2436: 
 2437:    // if the tracking segment goes out of water (either dry or edge boundary)
 2438:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2439: 
 2440: 
 2441:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2442: 
 2443:       assert(this->containsPoint(toPoint2(xt)) && "Target point is not inside the current element");
 2444:       // When this happens, the backtracking stops.
 2445:       // dt = time_rm;  LLLLLL KKKK XXXX
 2446:       dt *= tIntersect;
 2447: 
 2448:       // In this case, the next element is again the current element.
 2449:       nextElem = this;
 2450: 
 2451: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2452: 
 2453:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2454:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2455:       return true;    
 2456:    }
 2457: 
 2458: 
 2459:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2460:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2461:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2462: 
 2463:    
 2464:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2465: 
 2466:    u_int = nextElem->interpolateVelocities(xt); 
 2467: 
 2468:    assert(nextElem != this && "Next element is the same as the current element");
 2469: 
 2470:    return true;
 2471: }
 2472: 
 2473: 
 2474: __inline__ __device__ double Element::computeSignedArea(void) const {
 2475:    // Compute the area of the element
 2476: 
 2477:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2478: 
 2479:    // In the quad case we need to add the area of the other triangle.
 2480:    if (isQuad()) {
 2481:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2482:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2483:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2484:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2485: 
 2486:       res += ar1;
 2487:    }
 2488: 
 2489:    return res;
 2490: }
 2491: 
 2492: 
 2493: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2494:                                                                 (nodes[1]->isDry2()) ||
 2495:                                                                 (nodes[2]->isDry2()) ||
 2496:                                                                 (i34==4 && nodes[3]->isDry2());
 2497: }
 2498: 
 2499: __inline__ __device__ double Element::detJ_eta(void) const {
 2500:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2501:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2502: }
 2503: 
 2504: __inline__ __device__ double Element::detJ_xi(void) const {
 2505:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2506:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2507: }
 2508: 
 2509: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2510:    // In boundary sides, the element 1 is nullptr
 2511:    return side->elems[1] == nullptr; 
 2512: }
 2513: 
 2514: 
 2515: 
 2516: /**
 2517:    Compute the shape coordinates of the point (xt,yt) in the element.
 2518:    @param xt (input): x-coordinate of the point
 2519:    @param shpCoords (output): shape coordinates of the point
 2520:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2521:    @return true if the point is inside the element, false otherwise
 2522: **/
 2523: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord) const {
 2524: 
 2525:    // Compute the shape coordinates of the point xt in the element.
 2526:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2527:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2528:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2529:    // from the local frame, so use additional check.
 2530: 
 2531:    if (i34==3) { // Triangular element
 2532: 
 2533:       Point2 x0, x1, x2;
 2534: 
 2535:       // Horizontal local node coordinates. If ics == 2, the node coordinates are transformed to local frame.
 2536:       getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2537: 
 2538:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2539:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2540:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2541:       shpCoords[3] = 0.0;
 2542: 
 2543:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2544:       const bool res = (tmpmin >= -small);  
 2545:       
 2546:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2547:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2548: 
 2549:       
 2550:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2551:       // then we fix the negative shape coordinates.
 2552:       if ((tmpmin < 0) && fix) {
 2553: 
 2554:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2555:          // keeping the sum of the shape coordinates equal to 1.
 2556:          // I have tested and compared the new algorithm with the old one, and they give
 2557:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2558:          // The new algorithm should be faster since it is branchless.
 2559:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2560:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2561:          
 2562:          shpCoords[0] = (shpCoords[0] + a)*b;
 2563:          shpCoords[1] = (shpCoords[1] + a)*b;
 2564:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2565: 
 2566:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2567:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2568:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2569: 
 2570:          // Update the point coordinates for the new shape coordinates
 2571:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2572:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2573:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2574: 
 2575:       }
 2576: 
 2577:       // Check if the point is inside the element
 2578:       return res;      
 2579:    }
 2580:    else {
 2581:       Error("Not implemented yet");
 2582: #ifdef QUADS
 2583:       // Reproject pt in eframe of nel for ics=2
 2584:       if constexpr(ics==1) {
 2585:          xn2 = xt; 
 2586:          yn2 = yt;
 2587:       }
 2588:       else {
 2589:          // Transform the point coordinates to the local frame
 2590:          frame.G2L(xt, xn2);
 2591:          frame.G2L(yt, yn2);
 2592:       }
 2593: 
 2594:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2595: #endif
 2596:    }
 2597: 
 2598:    assert(false && "computeShapeCoords: should never reach this point");
 2599:    return false;  // Never reached
 2600: 
 2601: }
 2602: 
 2603: 
 2604: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2605: // Convert shape coordinates to cartesian coordinates
 2606: 
 2607:    if (i34 == 3) {
 2608:       // Triangular element
 2609:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2610:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2611:    }
 2612:    else {
 2613:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2614:    }
 2615: 
 2616: }
 2617: 
 2618: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2619:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2620:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2621:    // The formula for the integral is:
 2622:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2623: 
 2624:    printf("intPhiPhi: TEST\n");
 2625: 
 2626:    const Node *n0 = nodes[0];
 2627:    const Node *n1 = nodes[1];
 2628:    const Node *n2 = nodes[2];
 2629:    const Node *n3 = nodes[3];
 2630: 
 2631:    const Vector2 p0 = n0->p;
 2632:    const Vector2 p1 = n1->p;
 2633:    const Vector2 p2 = n2->p;
 2634:    const Vector2 p3 = n3->p;
 2635: 
 2636:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2637:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2638:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2639:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2640: 
 2641:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2642: }
 2643:    
 2644: 
 2645: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2646:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2647:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2648:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2649:    // The formula is also based on the identity:
 2650:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2651:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2652: 
 2653:    printf("intGradPhiGradPhi: TEST\n");   
 2654: 
 2655:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2656: 
 2657:    const double x0 = nodes[0]->p.x;
 2658:    const double y0 = nodes[0]->p.y;
 2659:    const double x1 = nodes[1]->p.x;
 2660:    const double y1 = nodes[1]->p.y;
 2661:    const double x2 = nodes[2]->p.x;
 2662:    const double y2 = nodes[2]->p.y;
 2663:    const double x3 = nodes[3]->p.x;
 2664:    const double y3 = nodes[3]->p.y;
 2665: 
 2666:    double res = 0.0;
 2667:    
 2668:    // Quadrature points in xi and eta coordinates
 2669:    #pragma unroll
 2670:    for (int i = 0; i < 4; i++) {
 2671:       // For each quadrature point...
 2672: 
 2673:       const Point2 p = GaussPoint(i);
 2674:       const double eta = p.x;
 2675:       const double xi  = p.y;
 2676: 
 2677:       // Jacobian entries at the Gauss point p
 2678:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2679:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2680:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2681:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2682: 
 2683:       const double detJ = jacobianDet(p);
 2684:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2685: 
 2686:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2687:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2688:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2689:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2690:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2691: 
 2692:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2693:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2694:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2695:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2696:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2697: 
 2698:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2699:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2700:    }
 2701: 
 2702:    return res;
 2703: }
 2704: 
 2705: 
 2706: /**  Interpolate velocities at a given point (xt,yt,zt)
 2707: 
 2708:    @param xt, yt, zt: coordinates of the point to interpolate
 2709:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2710: 
 2711:    This is done in four steps:
 2712: 
 2713:    1. Find the shape coordinates for the final position in the element.
 2714:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2715:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2716:       z levels at xt, yt at each step.   
 2717:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2718:       horizontally and vertically.
 2719: **/
 2720: __device__ Vector3 Element::interpolateVelocities(Point3 xt) const {
 2721:    // Interpolate the velocities at the point xt. 
 2722:    // This function works the same for triangular and quadrilateral elements.
 2723:    double shpCoord[4];
 2724:    Vector3 u_int;
 2725: 
 2726:    // First step is to compute the shape coordinates of (xt,yt)
 2727:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside);
 2728: 
 2729:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2730: 
 2731:    // Second step is to find the level that contains zt
 2732:    // Uses a binary search to find the level
 2733:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2734:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2735:    int R = nvrt - 1;
 2736: 
 2737:    // Get the z coordinates at the nodes of the element at the levels L and R
 2738:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2739:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2740:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2741: 
 2742:    double zL = interpolate(shpCoord, zLAtNodes);
 2743:    double zR = interpolate(shpCoord, zRAtNodes);
 2744:    
 2745:    // Interpolates vertically the velocities
 2746:    double wght1, wght2;
 2747:    if (xt.z<=zL) {
 2748:       wght1 = 1.0;
 2749:       wght2 = 0.0;
 2750:       xt.z = zL;
 2751:    }
 2752:    else if (xt.z>=zR) {
 2753:       wght1 = 0.0;
 2754:       wght2 = 1.0;
 2755:       xt.z = zR;
 2756:    }
 2757:    else {
 2758:       // Perform a binary search to find the levels between L and R that contain xt.z
 2759:       while (R - L > 1) {
 2760:          int M = (L + R) / 2.0;
 2761: 
 2762:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2763:          double zM = interpolate(shpCoord, zMAtNodes);
 2764:          if (zM < xt.z) 
 2765:          {
 2766:             L = M;
 2767:             zL = zM;
 2768:          }
 2769:          else 
 2770:          {
 2771:             R = M;
 2772:             zR = zM;
 2773:          }
 2774:       }
 2775:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2776:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2777: 
 2778:       wght2 = (xt.z - zL)/(zR - zL);
 2779:       wght1 = 1.0 - wght2;
 2780: 
 2781:    }
 2782: 
 2783: 
 2784:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2785:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 2786:    toVector2(u_int) = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2787:    u_int.z          = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 2788: 
 2789:    // Neither of the interpolated velocities should be NaN
 2790:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2791: 
 2792:    return u_int;
 2793: 
 2794: }
 2795: 
 2796: 
 2797: 
