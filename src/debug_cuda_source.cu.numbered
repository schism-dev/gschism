 2409:    template<typename T>
 2410:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2411:       // Get the values of the field at the nodes of the element
 2412:       res[0] = nodes[0]->*field;
 2413:       res[1] = nodes[1]->*field;
 2414:       res[2] = nodes[2]->*field;
 2415:       if (isQuad()) res[3] = nodes[3]->*field;
 2416:       else          res[3] = T();
 2417:    }
 2418: 
 2419:    template<typename T>
 2420:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2421: 
 2422:       assert(level < nvrt && "Level is out of range");
 2423:       // Get the values of the field at the nodes of the element
 2424:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2425:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2426:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2427:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2428:       else          res[3] = T();
 2429:    }    
 2430: 
 2431:    template<typename T>
 2432:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2433: 
 2434:       assert(level < nvrt && "Level is out of range");
 2435: 
 2436:       // Get the values of the func at the nodes of the element
 2437:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2438:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2439:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2440:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2441:       else          res[3] = T();  // This is 0.0 or a zero vector
 2442: 
 2443:    }      
 2444: 
 2445:    template<typename T>
 2446:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2447:       // Get the values of the field at the nodes of the element
 2448:       res[0] = sides[0]->*field;
 2449:       res[1] = sides[1]->*field;
 2450:       res[2] = sides[2]->*field;
 2451:       if (isQuad()) res[3] = sides[3]->*field;
 2452:       else          res[3] = T();
 2453:    }
 2454: 
 2455:    template<typename T>
 2456:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2457: 
 2458:       assert(level < nvrt && "Level is out of range");
 2459: 
 2460:       // Get the values of the field at the nodes of the element
 2461:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2462:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2463:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2464:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2465:       else          res[3] = T();
 2466:    }    
 2467: 
 2468:    template<typename T>
 2469:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2470: 
 2471:       assert(level < nvrt && "Level is out of range");
 2472: 
 2473:       // Get the values of the func at the nodes of the element
 2474:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2475:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2476:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2477:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2478:       else          res[3] = T();  // This is 0.0 or a zero vector
 2479: 
 2480:    }      
