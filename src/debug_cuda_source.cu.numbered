 2509: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2510: 
 2511:    const double w1 = getBoundaryArrayValueWeight();
 2512:    const double w2 = 1.0 - w1;
 2513:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2514:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2515: 
 2516:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2517: }
