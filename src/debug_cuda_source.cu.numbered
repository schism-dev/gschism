  616: // Calculates the transport model based on the number of tracers and the chosen transport method
  617: constexpr TransportModel transportModel =
  618:    (ntracers == 0 || itr_met == 0)
  619:       ? TransportModel::None
  620:       : static_cast<TransportModel>(itr_met);
