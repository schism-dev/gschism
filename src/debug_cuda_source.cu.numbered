 7473: __global__ void returnMatrix(double *res) {
 7474:    // Debugging: returns the matrix as a CuPy array
 7475: 
 7476:    const int size = mesh->np;
 7477:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7478:       const Node *node = mesh->localNodeData + idx_node;
 7479:       res[idx_node*size + idx_node] = node->coeffDiag;
 7480:       for (int j = 0; j < node->numNodes; j++) {
 7481:          Node* nbNode = node->nodes[j];
 7482:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7483:       }
 7484: 
 7485:    }
 7486:    
 7487: }
