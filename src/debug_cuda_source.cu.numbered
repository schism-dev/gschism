 1154: struct Side {
 1155: 
 1156:    // Geometry information
 1157:    int idx;               // Index of the side
 1158:    Node *n1, *n2;
 1159:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1160: 
 1161:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1162:    Vector2 center;        // Location of side center. 
 1163:    double zc[nvrt];       // Side center z-coord at each vertical level
 1164: 
 1165:    Frame<ics> frame;
 1166:    
 1167:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1168:                           // this is nullptr
 1169:    
 1170:    int16_t kb;            // Bottom index of the side
 1171:    bool isDry;            // True if the side is dry
 1172:  
 1173:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1174: 
 1175:    Tracers tracers[nvrt]; // Tracer concentrations at nodes
 1176: 
 1177:    // Physical information
 1178:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1179:    Vector2 btu[nvrt];           // Back-tracked velocity
 1180:    Vector2 U;                   // Vertically averaged velocity vector  
 1181: 
 1182:    Vector2 nuGradU[nvrt];          // nu*grad u
 1183: 
 1184:    Vector2 bcc[nvrt];           // Baroclinic term
 1185:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1186: 
 1187:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1188:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1189:    Vector2 gradPr;               // Gradient of pressure
 1190:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1191: 
 1192: 
 1193:    double hhat;                 // \breve{H} in notes
 1194: 
 1195:    double shapiro;
 1196: 
 1197:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1198: 
 1199:    double coriolis;             // Coriolis parameter
 1200: 
 1201:    // Vegetation parameters
 1202:    double veg_c2;
 1203:    double veg_beta;
 1204: 
 1205:    // Bottom drag parameters.
 1206:    double chi;
 1207:    double chi2;
 1208: 
 1209:    __inline__ __device__ Point2 outputCoords(void) const;
 1210: 
 1211:    __inline__ __device__ double x(double t) const;
 1212:    __inline__ __device__ double y(double t) const;
 1213:    __inline__ __device__ double z(double t) const;
 1214:    __inline__ __device__ double lon(void) const;
 1215:    __inline__ __device__ double lat(void) const;
 1216:    __inline__ __device__ Point2 p2_t(double t) const;
 1217: 
 1218:    __device__ void setFrame(void) {
 1219:       if constexpr(ics == 1) return;
 1220: 
 1221:       double lat, lon;
 1222:       const Point3 p = toPoint3(center, centerZ());
 1223: 
 1224:       // Compute the latitude and longitude of the element center
 1225:       computeLatLon(p, lat, lon);
 1226: 
 1227:       frame.update(lat, lon);        
 1228:    }
 1229:    
 1230: 
 1231:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1232:    // If ics == 2, convert the global point to the local frame of the side
 1233:       
 1234:       if constexpr (ics == 1) {
 1235:          return p;
 1236:       } else {
 1237:          const Point3 c = {center.x, center.y, centerZ()};
 1238:          const Point3 local = frame.G2L(p - c);
 1239:          return local;
 1240:       }
 1241:    }
 1242: 
 1243:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1244:       if constexpr (ics == 1) {
 1245:          return p;
 1246:       } else {
 1247:          const Point3 c = {center.x, center.y, centerZ()};
 1248:          return c + frame.L2G(p);
 1249:       }
 1250:    }
 1251: 
 1252: 
 1253:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1254:       if constexpr(ics == 1) return v;
 1255:       else return v_frame.projHorVec(v, frame);
 1256:    }
 1257: 
 1258:    __inline__ __device__ double centerZ(void)      const;
 1259:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1260:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1261:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1262:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1263: 
 1264:    __inline__ __device__ Side* neigh(int index) const { 
 1265:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1266:       assert(index >= 0 && index < 4); 
 1267:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1268: 
 1269:       const int ielem = index & 1;           // 0 or 1
 1270:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1271: 
 1272:       const Element* elem = elems[ielem];
 1273: 
 1274:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1275: 
 1276:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1277: 
 1278:    }
 1279: 
 1280:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1281: 
 1282:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1283: 
 1284:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1285:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1286:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1287:    __inline__ __device__ int iadv(void) const;
 1288: 
 1289:    __inline__ __device__ double grav3(void) const;
 1290:    
 1291:    __inline__ __device__ double eta2(void) const;
 1292:    __inline__ __device__ double eta1(void) const;
 1293:    __inline__ __device__ double w2(int k) const;
 1294:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1295:    __inline__ __device__ double depth(void) const;
 1296:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1297:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1298: 
 1299:    __inline__ __device__ double dfv(int k) const;
 1300: 
 1301:    __inline__ __device__ double veg_h(void)  const;
 1302:    __inline__ __device__ double veg_nv(void) const;
 1303:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1304:    __inline__ __device__ double veg_alpha3D(int k) const;
 1305:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1306: 
 1307:    __inline__ __device__ double Cd(void) const;
 1308: 
 1309:    __inline__ __device__ Vector2 tau(void) const;
 1310: 
 1311:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1312:    
 1313: 
 1314:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1315:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1316:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1317:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1318:    } 
 1319:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1320:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1321:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1322:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1323: 
 1324:    // Get valid starting element (for backtracking)
 1325:    __inline__ __device__ Element* getStartElement() {
 1326:       return elems[0] ? elems[0] : elems[1];
 1327:    }
 1328: 
 1329:    
 1330:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1331:       // Given an element, returns the other element that shares this side
 1332:       return (elems[0] == elem) ? elems[1] : elems[0];
 1333:    }
 1334: 
 1335:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1336:       // Given a node, returns the other node that shares this side
 1337:       return (n1 == node) ? n2 : n1;
 1338:    }
 1339:  
 1340:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1341: 
 1342: 
 1343: 
 1344: 
 1345: };
