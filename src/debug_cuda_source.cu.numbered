 1863: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1864:                    Side *side = &(mesh->localSideData[idx_side]); \
 1865:                    if (idx_side >= mesh->ns) return;
 1866: 
 1867: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1868:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1869:                    if (idx_elem >= mesh->ne) return;
 1870: 
 1871: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1872:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1873:                    if (idx_node >= mesh->np) return;
 1874: 
 1875: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1876:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1877:                               const bool valid = (idx_node < mesh->np);                   
 1878: 
 1879: 
 1880: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1881:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1882:                            if (idx_node_bnd >= mesh->nbp) return;
 1883: 
 1884: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1885:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1886:                            if (idx_side_bnd >= mesh->nbs) return;                           
