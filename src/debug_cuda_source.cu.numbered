 8761: //                   do jj=1,natrm
 8762: //                     if(ntrs(jj)<=0) cycle
 8763: 
 8764: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 8765: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 8766: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 8767: //                       enddo !ll
