 1931: 
 1932: 
 1933: /**
 1934:  * Find the element that contains the target point.
 1935:  * 
 1936:  * @param x0,y0,z0     Starting position coordinates
 1937:  * @param xt,yt,zt     Target position coordinates
 1938:  * @param dtb          Time step for tracking
 1939:  * @param u_int        Initial velocity components
 1940:  * @param nextElem     Starting/resulting element index
 1941:  * 
 1942:  * @return Status code of type trackExitCodes
 1943:  * 
 1944:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1945:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1946:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1947:  * as close the the segment AB as possible, the next point at each iteration is computed
 1948:  * along segment AB, but just after the current element.
 1949:  */
 1950: 
 1951: 
 1952: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1953: 
 1954:    constexpr int MAX_ITERATIONS = 40;
 1955: 
 1956:    int iter = 0;
 1957:    double fac = 0.00001;
 1958:    while (iter < MAX_ITERATIONS) {
 1959:       iter++;
 1960: 
 1961:       Bool4 isLeft, isObtuse, isBisector;
 1962:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 1963: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 1964:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 1965: 
 1966: 
 1967:       if (isValid.none()) 
 1968:       // Inside the element if none of the edges is a valid continuation
 1969:       {
 1970:          // Just returns true and the element (curElem) is unchanged).
 1971:          // This means that the algorithm has found the element that contains the target point.
 1972:          return true;
 1973:       }
 1974:       else { // Outside the element
 1975: 
 1976:          // Outside this element. Pick the first valid exit side and cross.
 1977:          lastCrossSide = curElem->sides[isValid.firstOne()];
 1978:          Element *prevElem = curElem;
 1979:          curElem = lastCrossSide->otherElem(curElem);
 1980: 
 1981:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 1982:          // along the boundary.
 1983:          if (curElem == nullptr || curElem->isDry) {
 1984:          
 1985:             curElem = prevElem;
 1986:             return false;
 1987:          }
 1988:          
 1989:       }
 1990: 
 1991:    }
 1992: 
 1993:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 1994: }
