 3459: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3460: 
 3461: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3462:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3463:    if constexpr(ics == 1) { 
 3464:       return 0.5*(n1->tau + n2->tau);
 3465: 
 3466:    } else {
 3467:       // Project the tau from the node frames to the side frame
 3468:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3469:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3470: 
 3471:       return 0.5*(stau1 + stau2);
 3472:    }
 3473: }
 3474: 
 3475: /**
 3476:  * This method performs backtracking from the side center until a time -dt back in time 
 3477:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3478:  * intermediate point.
 3479:  *
 3480:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3481:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3482:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3483:  * remaining time.
 3484:  * 
 3485:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3486:  * 
 3487:  * @param uuint, vvint, wwint: Velocities at the final point
 3488:  * @param jlev: Level at which the backtracking is performed
 3489:  * @param dt, dtbk: Tracking timesteps
 3490:   */
 3491: __inline__ __device__ void Side::btrack(
 3492:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3493:       double dt,            // Tracking time
 3494:       double dtbk,          // Tracking timestep
 3495:       Vector3 &u_int        // Velocities at the initial point
 3496: ) const {
 3497: 
 3498:    // Start from side center
 3499:    Point3 x0;
 3500: 
 3501:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3502:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3503: 
 3504:  
 3505:    double time_rm = dt; // Remaining time
 3506:    double time_rm_1 = 1e10;
 3507:    double time_rm_2 = 2e10;
 3508:    double time_rm_3 = 3e10;
 3509: 
 3510: 
 3511:    // Initial velocities
 3512:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3513: 
 3514:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3515:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3516: 
 3517:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3518: 
 3519: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3520: 
 3521: 
 3522:    constexpr int MAX_ITERATIONS = 100; 
 3523:    int iter = 0;
 3524:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3525:    while(true) {
 3526: 
 3527:       // Calculate timestep
 3528:       const double dtb = min(dtbk, time_rm);
 3529: 
 3530:       // Next point in the backtracking curve
 3531:       xt = x0 - dtb*u_int;
 3532: 
 3533:       double t, s; // parameters for the line segments p0pt and p1p2
 3534:       Side *lastCrossSide = nullptr;
 3535:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3536: 
 3537: 
 3538:       if (time_rm_3 <= time_rm) {
 3539:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3540:          xt = x0;
 3541:          break;
 3542:       }
 3543: 
 3544: 
 3545:       if (!found) {
 3546:       // This means that the walk reached a boundary or a dry element.
 3547: 
 3548:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3549: 
 3550:          // Finds the point at the boundary where the line segment x0xt intersects.
 3551:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3552:          // due to floating point errors, it does not exactly intersect.
 3553:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3554:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3555:          // To compute the intersection point we start with the parametric equations.
 3556:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3557:          // We cross-prouct by v1 to cancel the s term:
 3558:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3559:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3560: 
 3561:          // Side coordinates in the origSide frame.
 3562:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3563:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3564: 
 3565:          Point2  p0 = {x0.x, x0.y};
 3566:          Point2  pt = {xt.x, xt.y};
 3567: 
 3568:          const Vector2 v1 = pt - p0;
 3569:          const Vector2 v2 = p2 - p1;
 3570: 
 3571: 
 3572: 
 3573:          // We are assuming intersection, so we clamp t to the range [0,1].
 3574:          const double denom = cross(v2, v1);
 3575:          
 3576: 
 3577: 
 3578: 
 3579:          if (abs(denom) < small) {
 3580:             // small denominators are fairly common. They occur when the line segment x0xt 
 3581:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3582:             // boundary, where the backtracking curve startt sliding along the boundary.
 3583:             // In this case, we simply assume that the two lines are very close to each other
 3584:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3585:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3586:             if (t<0.0000000001) t = 0.0;
 3587:             if (t>0.9999999999) t = 1.0;
 3588: 
 3589:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3590:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3591: 
 3592:          }
 3593:          else {
 3594:             
 3595:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3596:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3597:             if (t>0.9999999999) t = 1.0;
 3598:             // From the originaL equation we can solve for s:
 3599:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3600:             // Computing the dot product by v1, we get:
 3601:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3602:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3603:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3604: 
 3605:          }
 3606: 
 3607:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3608: 
 3609: 
 3610:          // We update the new target point to be right at the intersection point,
 3611:          // and the remaining time must include the time we haven't "used".
 3612:          time_rm -= s*dtb;
 3613:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3614: 
 3615: 
 3616:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3617:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3618: 
 3619:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3620:          // but extracting only the component along the tangent vector v2.
 3621:          Vector2 tangent = normalize(v2);
 3622:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3623: 
 3624:          const Vector2 u2D = make_double2(u.x, u.y);
 3625:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3626: 
 3627: 
 3628:       } else {
 3629: 
 3630:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3631: 
 3632:          time_rm -= dtb; 
 3633: 
 3634:          u_int = curElem->interpolateVelocities(xt, this);
 3635: 
 3636:       }
 3637: 
 3638:       if (time_rm <= 0.0) break; 
 3639: 
 3640:       // If the velocity is too small, we stop the backtracking
 3641:       const double vmag2 = norm2(toVector2(u_int));
 3642:       if (vmag2 <= velmin_btrack_sq)  {
 3643:          time_rm = 0.0; 
 3644:          return; 
 3645:       }
 3646: 
 3647:       // The current point becomes the next segment's starting point.
 3648:       x0 = xt;
 3649:  
 3650:       iter++;
 3651: 
 3652: // XXXXXXXXXXXXXXXXX
 3653: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3654:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3655: 
 3656:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3657:       time_rm_3 = time_rm_2;
 3658:       time_rm_2 = time_rm_1;
 3659:       time_rm_1 = time_rm;
 3660:    }
 3661: 
 3662:    assert(curElem != nullptr && "Final element is nullptr");
 3663:    assert(!curElem->isDry && "Final element is dry");
 3664:    
 3665: 
 3666: 
 3667:    // Interpolate the velocities at the final point with respect to the current side frame
 3668:    u_int = curElem->interpolateVelocities(xt, this);
 3669: 
 3670: 
 3671: }
 3672: 
 3673: 
 3674: 
 3675: 
 3676: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3677: 
 3678: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3679: 
 3680:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3681:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3682: 
 3683:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3684:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3685: 
 3686:    double fun_lat = 0.0;
 3687:    switch (jspc[idxComp]) {
 3688:       case 0:
 3689:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3690:          break;
 3691:       case 1:
 3692:          fun_lat = sin(2.0*lat);
 3693:          break;
 3694:       case 2:
 3695:          fun_lat = pow<2>(cos(lat));
 3696:          break;
 3697:       default:
 3698:          assert(false && "computeETP: invalid jspc");
 3699:    }
 3700:    
 3701:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3702: 
 3703: }
 3704: 
 3705: __device__ void Node::updateKb(void) {
 3706: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3707: 
 3708:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3709: 
 3710: 
 3711:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3712: 
 3713:    if constexpr(ivcor == 2) {  // SZ coordinates
 3714:       
 3715:       // Compute bottom level index
 3716:       if (depth <= mesh->h_s) {
 3717:          kb = izlev;   
 3718:          
 3719:       } else {
 3720:          kb = -1;
 3721:          int L = 0;
 3722:          int R = nzlev; 
 3723:          
 3724:          while (L <= R) {
 3725:             int M = (R + L) / 2;
 3726: 
 3727: 
 3728:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3729:             
 3730:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3731:                R = M;
 3732:             } else {
 3733:                L = M;
 3734:             }
 3735: 
 3736:             if (R - L == 1) {
 3737:                kb = L;
 3738:                break;
 3739:             }
 3740:          }
 3741: 
 3742:          // Checks that the binary search was successful
 3743:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3744:        
 3745:       }
 3746:    } 
 3747: }
 3748: 
 3749: 
 3750: __device__ __inline__ void Node::updateZCoordData(void) {
 3751: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3752: 
 3753:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3754:    // if (isDry2()) {
 3755:    //    kb = -1;  // XXXXXXXX KKKKK
 3756:    //    return;
 3757:    // }
 3758: 
 3759: 
 3760:    if constexpr(ivcor == 2) {  // SZ coordinates
 3761:       
 3762:       // Compute bottom level index
 3763:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3764:    } 
 3765:    else {  // if (ivcor == 1) Localized sigma
 3766:       // Do nothing
 3767:    }
 3768: 
 3769: 
 3770: }
