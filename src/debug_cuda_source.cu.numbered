 5151: extern "C" {
 5152: 
 5153:    __global__ void scaleGravity(double loadtide_coef) {
 5154: 
 5155: 
 5156:       NODE(node);
 5157: 
 5158:       // SAL option: scale gravity
 5159:       if constexpr(iloadtide==2) {  // simple const
 5160:          node->grav2 = grav*(1.0 - loadtide_coef);
 5161: 
 5162:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5163:         
 5164:           const double depth = max(node->depth, 0.0);
 5165:           const double tmp1 = sqrt(depth);
 5166:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5167:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5168:                              2.6969e-13*depth*depth*depth*tmp1;
 5169:           
 5170:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5171:           
 5172: 
 5173: 
 5174:           node->grav2 = grav*(1.0 - beta_bar);
 5175: 
 5176:       } else {  // iloadtide=0,1
 5177:           node->grav2 = grav;
 5178: 
 5179:       }
 5180: 
 5181:    }
 5182: 
