  364: 
  365: struct Frame {
  366:    double _t[9]; // t stands for tensor.
  367: 
  368:    // Access the tensor in Fortran order
  369:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  370: 
  371:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  372: 
  373:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  374: 
  375:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  376:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  377:       sincos(ar2, &sin_ar2, &cos_ar2);
  378: 
  379:       t(0,0) = -sin_ar1;
  380:       t(1,0) =  cos_ar1;
  381:       t(2,0) =  0.0;
  382:       t(0,1) = -cos_ar1*sin_ar2;
  383:       t(1,1) = -sin_ar1*sin_ar2;
  384: 
  385:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  386: 
  387:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  388:       assert (ar4!=0.0 && "GRID: ar4=0");
  389: 
  390:       const double ar4_inv = 1.0/ar4;
  391:       t(0,1) = t(0,1)*ar4_inv;
  392:       t(1,1) = t(1,1)*ar4_inv;
  393:       t(2,1) = t(2,1)*ar4_inv;
  394: 
  395:       // The third vector is the cross product of the first two
  396:       crossProduct(t(0,0), t(1,0), t(2,0), 
  397:                    t(0,1), t(1,1), t(2,1), 
  398:                    t(0,2), t(1,2), t(2,2));
  399:    }
  400: 
  401: 
  402:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  403:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  404:    // Inputs:
  405:    //        vec0: vel. in this frame;
  406:    //        frameout: Output frame;
  407:    // Output: 
  408:    //        vec1: vel. in new frame  
  409: 
  410:       auto const fo = frameout;
  411:       Vector2 vec1;
  412: 
  413:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  414:       // of t and fo.t are the same.
  415:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  416:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  417: 
  418:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  419:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  420: 
  421:       return vec1;
  422:    }
  423: 
  424:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  425:       // Transform a vector from global to local frame
  426:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  427:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  428:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  429:    }
  430: 
  431:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  432:       // Transform a vector from local to global frame
  433:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  434:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  435:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  436:    }   
  437: 
  438:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  439:    // Tranforms a point from global to local frame     
  440:       G2L(pi - origin0, po);
  441:    }
  442: 
  443:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  444:    // Transforms a point from local to global frame      
  445:       L2G(pi, po);
  446:       po = po + origin0;
  447:    }
  448: 
  449: };
