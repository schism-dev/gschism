 8162: __global__ void printMatrix(bool full) {
 8163:    // Debugging: print the matrix
 8164: 
 8165:    const int size = mesh->np;
 8166:    double sum = 0.0;
 8167:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8168:       const Node *node = mesh->localNodeData + idx_node;
 8169:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8170:       for (int j = 0; j < node->numNodes; j++) {
 8171:          Node* nbNode = node->nodes[j];
 8172:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8173:          sum += node->coeffMatrix[j];
 8174:       }
 8175:       if (full) printf("]\n");
 8176: 
 8177: 
 8178:    }
 8179:    if (!full) printf("sum=%lf\n", sum);
 8180: }
