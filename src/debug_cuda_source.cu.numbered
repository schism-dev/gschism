 3001: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3002:    if constexpr(ics == 1) {
 3003:       return center;
 3004: 
 3005:    } else {
 3006:       const Point2 p0 = n1->outputCoords();
 3007:       const Point2 p1 = n2->outputCoords();
 3008:       return (1.0/2.0)*(p0 + p1);
 3009: 
 3010:    }
 3011: }
 3012: 
 3013: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3014: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3015: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3016: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3017: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3018: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3019: __inline__ __device__ Point3  Side::p3_t(double t) const { return {x(t), y(t), z(t)}; }
 3020: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3021: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3022: // Computes the gradient of the field at the side center.
 3023:    Vector2 grad = {0.0, 0.0};
 3024:    int count = 0;
 3025: 
 3026:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3027:    // as the average of the gradients at each element.
 3028:    // First element
 3029:    if (elems[0] != nullptr && condition(elems[0])) {
 3030:       Vector2 elemGrad = elems[0]->grad2(field);
 3031: 
 3032:       // For ics=2, projects the element gradient from its frame to the side frame
 3033:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3034: 
 3035: 
 3036:       grad += elemGrad;
 3037: 
 3038:       count++;
 3039:    }
 3040: 
 3041:    // Second element
 3042:    if (elems[1] != nullptr && condition(elems[1])) {
 3043: 
 3044:       Vector2 elemGrad = elems[1]->grad2(field);
 3045: 
 3046:       // For ics=2, projects the element gradient from its frame to the side frame
 3047:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3048: 
 3049:       grad += elemGrad;
 3050: 
 3051:       count++;
 3052:    }
 3053: 
 3054:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3055:    if (count > 0) {
 3056:       grad = grad*(1.0/count);
 3057:    }
 3058:    
 3059:    return grad;
 3060: }
 3061: 
 3062: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3063: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3064: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3065: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3066: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3067: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3068: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3069: 
 3070: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3071: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3072: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3073: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3074: 
 3075: 
 3076: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3077: 
 3078: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3079:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3080:    if constexpr(ics == 1) { 
 3081:       return 0.5*(n1->tau + n2->tau);
 3082: 
 3083:    } else {
 3084:       // Project the tau from the node frames to the side frame
 3085:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3086:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3087: 
 3088:       return 0.5*(stau1 + stau2);
 3089: printf("tau = (%f, %f)\n", stau1.x, stau1.y);
 3090:    }
 3091: }
 3092: 
 3093: /**
 3094:  * This method performs backtracking from the side center until a time -dt back in time 
 3095:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3096:  * intermediate point.
 3097:  *
 3098:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3099:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3100:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3101:  * remaining time.
 3102:  * 
 3103:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3104:  * 
 3105:  * @param uuint, vvint, wwint: Velocities at the final point
 3106:  * @param jlev: Level at which the backtracking is performed
 3107:  * @param dt, dtbk: Tracking timesteps
 3108:  * @return: True if the backtracking was successful, false otherwise
 3109:  */
 3110: __inline__ __device__ bool Side::btrack(
 3111:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3112:       double dt,            // Tracking time
 3113:       double dtbk,          // Tracking timestep
 3114:       Vector3 &u_int        // Velocities at the initial point
 3115: ) const {
 3116: 
 3117:    // Start from side center
 3118:    Point3 x0;
 3119: 
 3120:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3121:    else                   x0 = {0.0, 0.0, zc[jlev]};
 3122: 
 3123:  
 3124:    double time_rm = dt; // Remaining time
 3125: 
 3126: 
 3127:    // Initial velocities
 3128:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3129: 
 3130:    // Find the element that is in the direction opposite to the velocity
 3131:    Element* curElem = findElementTowards(toVector2(u_int));
 3132:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3133: if (idx == 15876) printf("curElem->idx = %d\n", curElem->idx);
 3134:    // If debugging backtracking, add the starting point to the debug plot and the elements for
 3135:    // idx == 15876
 3136:    if (idx == 15876) {
 3137:       printf("PPP u_int = (%f, %f, %f)\n", u_int.x, u_int.y, u_int.z);
 3138:       const Point3 orig = toPoint3(center, centerZ());
 3139:       auto vertexInOriginalFrame = [this, orig, jlev](const Node *node) -> Point3 {
 3140:          if constexpr(ics == 1) {
 3141:             return toPoint3(node->p, 0.0);
 3142:          } else {
 3143:             const Point3 p_glob = toPoint3(node->p, node->gz);
 3144:             const Vector3 loc = frame.G2L(p_glob - orig);
 3145:             return Point3(loc.x, loc.y, 0.0);
 3146:          }
 3147:       };
 3148:       auto elementInOriginalFrame = [this, orig, jlev](const Element *elem) -> Point3 { 
 3149:          if constexpr(ics == 1) {
 3150:             return toPoint3(elem->center, elem->centerZ());
 3151:          } else {
 3152:             const Point3 center_glob = toPoint3(elem->center, elem->centerZ());
 3153:             const Vector3 loc = frame.G2L(center_glob - orig);
 3154:             return Point3(loc.x, loc.y, loc.z);
 3155:          }
 3156:       };
 3157:       auto plotTriangle = [&vertexInOriginalFrame, &elementInOriginalFrame](const Element *elem, unsigned int color) {
 3158:          if (elem == nullptr || !elem->isTri()) return;
 3159:          const Point3 v0 = vertexInOriginalFrame(elem->nodes[0]);
 3160:          const Point3 v1 = vertexInOriginalFrame(elem->nodes[1]);
 3161:          const Point3 v2 = vertexInOriginalFrame(elem->nodes[2]);
 3162:          const Point3 center = elementInOriginalFrame(elem);
 3163:          addDebugPlot(v0, v1, color, 'o', elem->nodes[0]->idx);
 3164:          addDebugPlot(v1, v2, color, 'o', elem->nodes[1]->idx);
 3165:          addDebugPlot(v2, v0, color, 'o', elem->nodes[2]->idx);
 3166:          addDebugPlot(center, center, color, 'o', elem->idx);
 3167:       };
 3168:       plotTriangle(curElem, 0xFF0000u);  // current element in red
 3169:       plotTriangle(curElem->nghbElems[0], 0x00A000u);
 3170:       plotTriangle(curElem->nghbElems[1], 0x00A000u);
 3171:       plotTriangle(curElem->nghbElems[2], 0x00A000u);
 3172: 
 3173:       // Add the initial point (0,0) to the debug plot
 3174:       addDebugPlot(Point3(0.0, 0.0, 0.0), Point3(0.0, 0.0, 0.0), 0x0000FFu, '+');
 3175:    }
 3176: 
 3177:    // Nudges it towards the barycenter
 3178:    curElem->nudgeToBarycenter(toPoint2(x0), this); // XXXX Necessary?
 3179: if (idx == 15876) addDebugPlot(Point3(0.0, 0.0, 0.0), x0, 0xFF00FFu, 'o');
 3180: 
 3181: 
 3182:    const int MAX_ITERATIONS = 100; 
 3183:    Element* nextElem = nullptr;
 3184:    int iter = 0;
 3185:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3186:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3187:    while(true) {
 3188: 
 3189:       // Calculate timestep
 3190:       double dtb = min(dtbk, time_rm);
 3191: 
 3192: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 3193: 
 3194:       // Next point in the backtracking curve
 3195: // if (iter >= MAX_ITERATIONS - 50)  {
 3196: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 3197: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 3198: // }
 3199:         
 3200:       xt = x0 - dtb*u_int;
 3201: // printf("curElem->idx = %d, x0 = (%f, %f, %f), xt = (%f, %f, %f)\n", curElem->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3202:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 3203: if (idx == 15876) addDebugPlot(x0, xt, 0xFF00FFu, '+');
 3204: if (!found) {if (idx == 15876) printf("1111\n"); return true;}
 3205:       assert(found && "Backtracking failed in btrack");
 3206: 
 3207: 
 3208:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 3209:                       // then time_rm needs to be increased by the unused time.
 3210: 
 3211:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 3212: 
 3213:       // If the velocity is too small, we stop the backtracking
 3214:       const double vmag = length(toVector2(u_int));
 3215:       if (vmag <= velmin_btrack) break;
 3216: 
 3217:       // The current point becomes the next segment's starting point.
 3218:       x0 = xt;
 3219:  
 3220:       curElem = nextElem;
 3221: 
 3222:       iter++;
 3223: 
 3224:       if (iter >= MAX_ITERATIONS) break;
 3225: 
 3226:       // if (iter >= MAX_ITERATIONS - 50) {
 3227:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 3228:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 3229:       //    }
 3230:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3231:    }
 3232: 
 3233:    assert(!curElem->isDry && "Final element is dry");
 3234:    assert(curElem->containsPoint(toPoint2(xt), this) && "Target point is not inside the final element"); 
 3235: 
 3236:    // Interpolate the velocities at the final point
 3237:    u_int = curElem->interpolateVelocities(xt, this);
 3238: 
 3239:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 3240: 
 3241: 
 3242: }
 3243: 
