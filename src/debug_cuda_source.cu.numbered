 8375: 
 8376:    switch (varCode) {
 8377:       case (int)VarCode::outputCoords:
 8378:          const Point2 coords = side->outputCoords();
 8379:          res[side->idx*2    ] = coords.x;
 8380:          res[side->idx*2 + 1] = coords.y;
 8381:          break;
 8382:    }
 8383: }
