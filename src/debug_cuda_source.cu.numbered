 2549: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2550: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2551: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2552: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2553: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2554: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2555:    Vector2 grad = {0.0, 0.0};
 2556:    int count = 0;
 2557: 
 2558:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2559: 
 2560:    // First element
 2561:    if (elems[0] != nullptr && condition(elems[0])) {
 2562:       grad += elems[0]->grad2(field);
 2563:       count++;
 2564:    }
 2565: 
 2566:    // Second element
 2567:    if (elems[1] != nullptr && condition(elems[1])) {
 2568:       grad += elems[1]->grad2(field);
 2569:       count++;
 2570:    }
 2571: 
 2572:    if (count > 0) {
 2573:       grad = grad/count;
 2574:    }
 2575:    
 2576:    return grad;
 2577: }
