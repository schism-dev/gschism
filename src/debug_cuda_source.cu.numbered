 7509:          break;
 7510:       case (int)VarCode::isdry:
 7511:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7512:          *sizeType = sizeof(int);
 7513:          break;            
 7514:       // case (int)VarCode::w:
 7515:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7516:       //    *sizeType = sizeof(double);
 7517:       //    break;
 7518:       case (int)VarCode::u:
 7519:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7520:          *sizeType = sizeof(Vector2);
 7521:          break;   
 7522:       case (int)VarCode::btu:
 7523:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 7524:          *sizeType = sizeof(Vector2);
 7525:          break;          
 7526:       case (int)VarCode::U:
 7527:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7528:          *sizeType = sizeof(Vector2);
 7529:          break;
 7530:       // case (int)VarCode::ghat:
 7531:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 7532:       //    *sizeType = sizeof(Vector2);
 7533:       //    break;   
 7534:       case (int)VarCode::hhat:
 7535:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 7536:          *sizeType = sizeof(Vector2);
 7537:          break;      
 7538:       case (int)VarCode::chi:
 7539:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 7540:          *sizeType = sizeof(double);
 7541:          break;
 7542:       case (int)VarCode::n1:
 7543:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7544:          *sizeType = sizeof(Node);
 7545:          break;
 7546:       case (int)VarCode::n2:
 7547:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7548:          *sizeType = sizeof(Node);
 7549:          break;                   
 7550:       default:
 7551:          *offset = -1;
 7552:    }
 7553: }
