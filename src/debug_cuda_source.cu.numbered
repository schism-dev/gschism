 4273: extern "C" {
 4274: 
 4275:    __global__ void scaleGravity(double loadtide_coef) {
 4276: 
 4277: 
 4278:       NODE(node);
 4279: 
 4280:       // SAL option: scale gravity
 4281:       if constexpr(iloadtide==2) {  // simple const
 4282:          node->grav2 = grav*(1.0 - loadtide_coef);
 4283: 
 4284:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4285:         
 4286:           const double depth = max(node->depth, 0.0);
 4287:           const double tmp1 = sqrt(depth);
 4288:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4289:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4290:                              2.6969e-13*depth*depth*depth*tmp1;
 4291:           
 4292:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4293:           
 4294: 
 4295: 
 4296:           node->grav2 = grav*(1.0 - beta_bar);
 4297: 
 4298:       } else {  // iloadtide=0,1
 4299:         node->grav2=grav;
 4300: 
 4301:       }
 4302: 
 4303:    }
 4304: 
