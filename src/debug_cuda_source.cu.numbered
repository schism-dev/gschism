 8751: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8752:    Node *nodes = mesh->localNodeData;
 8753: 
 8754:    *addr = nodes;
 8755:    *sizeNode = sizeof(Node);
 8756: 
 8757:    switch (varCode) {
 8758:       case (int)VarCode::depth:
 8759:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8760:          *sizeType = sizeof(double);
 8761:          break;
 8762:       case (int)VarCode::eta:
 8763:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8764:          *sizeType = sizeof(double);
 8765:          break;
 8766:       case (int)VarCode::x:
 8767:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8768:          *sizeType = sizeof(Vector2);
 8769:          break;
 8770:       case (int)VarCode::z:
 8771:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8772:          *sizeType = sizeof(double);
 8773:          break;
 8774:       case (int)VarCode::kb:
 8775:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8776:          *sizeType = sizeof(int);
 8777:          break;
 8778:       case (int)VarCode::isdry:
 8779:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8780:          *sizeType = sizeof(int);
 8781:          break;         
 8782:       case (int)VarCode::w:
 8783:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8784:          *sizeType = sizeof(double);
 8785:          break;
 8786:       case (int)VarCode::u:
 8787:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8788:          *sizeType = sizeof(Vector2);
 8789:          break;  
 8790:       case (int)VarCode::u_air:
 8791:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8792:          *sizeType = sizeof(Vector2);
 8793:          break;
 8794:       default:
 8795:          *offset = -1;    
 8796:    }  
 8797:    
 8798: }
