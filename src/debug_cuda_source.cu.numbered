 7182: __global__ void getStructSizes(int* sizes)  {
 7183:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7184:       sizes[0] = (int)sizeof(Node);
 7185:       sizes[1] = (int)sizeof(Element);
 7186:       sizes[2] = (int)sizeof(Side);
 7187:       sizes[3] = (int)sizeof(NodeBoundary);
 7188:       sizes[4] = (int)sizeof(SideBoundary);
 7189:       sizes[5] = (int)sizeof(BoundarySegment);
 7190: }
