 4483: 
 4484:    __global__ void scaleGravity(double loadtide_coef) {
 4485: 
 4486: 
 4487:       NODE(node);
 4488: 
 4489:       // SAL option: scale gravity
 4490:       if constexpr(iloadtide==2) {  // simple const
 4491:          node->grav2 = grav*(1.0 - loadtide_coef);
 4492: 
 4493:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4494:         
 4495:           const double depth = max(node->depth, 0.0);
 4496:           const double tmp1 = sqrt(depth);
 4497:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4498:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4499:                              2.6969e-13*depth*depth*depth*tmp1;
 4500:           
 4501:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4502:           
 4503: 
 4504: 
 4505:           node->grav2 = grav*(1.0 - beta_bar);
 4506: 
 4507:       } else {  // iloadtide=0,1
 4508:         node->grav2=grav;
 4509: 
 4510:       }
 4511: 
 4512:    }
 4513: 
