 2322: 
 2323: /**
 2324:  * Find the element that contains the target point.
 2325:  * 
 2326:  * @param x0,y0,z0     Starting position coordinates
 2327:  * @param xt,yt,zt     Target position coordinates
 2328:  * @param dtb          Time step for tracking
 2329:  * @param u_int        Initial velocity components
 2330:  * @param nextElem     Starting/resulting element index
 2331:  * 
 2332:  * @return Status code of type trackExitCodes
 2333:  * 
 2334:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2335:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2336:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2337:  * as close the the segment AB as possible, the next point at each iteration is computed
 2338:  * along segment AB, but just after the current element.
 2339:  */
 2340: 
 2341: 
 2342: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2343: 
 2344:    constexpr int MAX_ITERATIONS = 40;
 2345: 
 2346:    int iter = 0;
 2347:    double fac = 0.00001;
 2348:    while (iter < MAX_ITERATIONS) {
 2349:       iter++;
 2350: 
 2351:       Bool4 isLeft, isObtuse, isBisector;
 2352:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2353: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2354:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2355: 
 2356: 
 2357:       if (isValid.none()) 
 2358:       // Inside the element if none of the edges is a valid continuation
 2359:       {
 2360:          // Just returns true and the element (curElem) is unchanged).
 2361:          // This means that the algorithm has found the element that contains the target point.
 2362:          return true;
 2363:       }
 2364:       else { // Outside the element
 2365: 
 2366:          // Outside this element. Pick the first valid exit side and cross.
 2367:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2368:          Element *prevElem = curElem;
 2369:          curElem = lastCrossSide->otherElem(curElem);
 2370: 
 2371:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2372:          // along the boundary.
 2373:          if (curElem == nullptr || curElem->isDry) {
 2374:          
 2375:             curElem = prevElem;
 2376:             return false;
 2377:          }
 2378:          
 2379:       }
 2380: 
 2381:    }
 2382: 
 2383:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2384: }
 2385: 
