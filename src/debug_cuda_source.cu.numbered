 8440: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8441:    Element *elems = mesh->localElemData;
 8442: 
 8443:    *addr = elems;
 8444:    *sizeElement = sizeof(Element);
 8445:    switch (varCode) {
 8446:       case (int)VarCode::z:
 8447:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8448:          *sizeType = sizeof(double);
 8449:          break;
 8450:       case (int)VarCode::x:
 8451:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8452:          *sizeType = sizeof(Vector2);
 8453:          break;
 8454:       case (int)VarCode::gradETP:
 8455:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8456:          *sizeType = sizeof(Vector2);
 8457:          break;
 8458:       case (int)VarCode::area:
 8459:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8460:          *sizeType = sizeof(double);
 8461:          break;
 8462:       case (int)VarCode::depth:
 8463:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8464:          *sizeType = sizeof(double);
 8465:          break;
 8466:       case (int)VarCode::radius:
 8467:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8468:          *sizeType = sizeof(double);
 8469:          break;
 8470:       case (int)VarCode::ghat:
 8471:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8472:          *sizeType = sizeof(Vector2);
 8473:          break;
 8474:       case (int)VarCode::kb:
 8475:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8476:          *sizeType = sizeof(int);
 8477:          break;
 8478:       case (int)VarCode::isdry:
 8479:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8480:          *sizeType = sizeof(int);
 8481:          break;            
 8482:       case (int)VarCode::w:
 8483:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8484:          *sizeType = sizeof(double);
 8485:          break;
 8486:       case (int)VarCode::FaceIndices:
 8487:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8488:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8489:          *sizeType = sizeof(Node);
 8490:          break;
 8491:       default:
 8492:          *offset = -1;
 8493:    }
 8494: }
