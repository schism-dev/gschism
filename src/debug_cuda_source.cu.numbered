 3379: 
 3380: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3381:    // Returns the value of the normal component of the velocity at the side center
 3382:    const double w1 = getBoundaryArrayValueWeight();
 3383:    const double w2 = 1.0 - w1;
 3384:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3385:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3386: 
 3387:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3388: }
