 2926: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2927: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2928: 
 2929: //       if (delta != 0.0) {
 2930: //          // Solves the two linear equations for tt1 and tt2
 2931: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2932: //          const double tt2 = delta2/delta;
 2933: 
 2934: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2935: //          // Similarly, we use tt2 to compute the intersection point.
 2936: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2937: //             xIntersect = x3 + (x4 - x3)*tt2;
 2938: //             yIntersect = y3 + (y4 - y3)*tt2;
 2939: 
 2940: //             intersectingSide = side;
 2941: //             nextElement = nghbElems[i];
 2942: 
 2943: //             return true;
 2944: //          }
 2945:       
 2946: //       }
