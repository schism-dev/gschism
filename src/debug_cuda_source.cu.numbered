 6815: __global__ void getStructSizes(int* sizes)  {
 6816:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 6817:       sizes[0] = (int)sizeof(Node);
 6818:       sizes[1] = (int)sizeof(Element);
 6819:       sizes[2] = (int)sizeof(Side);
 6820:       sizes[3] = (int)sizeof(NodeBoundary);
 6821:       sizes[4] = (int)sizeof(SideBoundary);
 6822:       sizes[5] = (int)sizeof(BoundarySegment);
