 1866: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1867:    // Computes the 3D normal vector to the element at level k
 1868:    // Returns the normal vector and the area of the element
 1869: 
 1870:    if (isTri()) {
 1871:       // For triangles...
 1872: 
 1873:       // Gets the normal vector to the element (with a length equal to twice the area)
 1874:       if constexpr(ics==1) {
 1875:          const int kb0 = max(k, nodes[0]->kb);
 1876:          const int kb1 = max(k, nodes[1]->kb);
 1877:          const int kb2 = max(k, nodes[2]->kb);
 1878: 
 1879:          const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1880:          const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1881:          
 1882:          // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1883:          const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1884:          const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1885:          const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1886: 
 1887:          const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1888:          area3D = 0.5*len;
 1889: 
 1890:          assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1891: 
 1892:          return {nx/len, ny/len, nz/len};
 1893: 
 1894:          
 1895:       }
 1896:       else {  // lat/lon
 1897:          assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1898:          return {0.0, 0.0, 0.0};
 1899: 
 1900:       } // if ics
 1901:    }
 1902:    else {
 1903:       // For quads...
 1904: 
 1905:       assert(false && "Element normal vector: quads not yet implemented");
 1906:       return {0.0, 0.0, 0.0};
 1907: 
 1908: 
 1909:    }
 1910: }
