 2516: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2517:    // Returns the value of the velocity at the side center
 2518:    const double w1 = getBoundaryArrayValueWeight();
 2519:    const double w2 = 1.0 - w1;
 2520:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2521:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2522: 
 2523:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2524: }
