 1061: struct BoundarySegment {
 1062: 
 1063:    bool isLand;
 1064: 
 1065:    double clen;  // Length of the boundary segment
 1066:    double carea; // Area of the boundary segment
 1067: 
 1068:    int ifltype;  // Type of flow boundary condition
 1069:    
 1070:    // Elevation boundary condition
 1071:    int iettype;  // Type of elevation boundary condition
 1072:    double eth;   // Elevation time history
 1073: 
 1074:    // Flow boundary condition
 1075:    double qthcon;  // Flow time history constant
 1076:    double vobc1;   // Velocity coefficient 1
 1077:    double vobc2;   // Velocity coefficient 2
 1078: 
 1079:    // Tracer boundary conditions
 1080:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1081:    // int  itrtype[natrm];    // Tracer boundary condition type
 1082: 
 1083:    BoundarySegment(bool _isLand) {
 1084:       isLand = _isLand;
 1085:       clen = 0.0;
 1086:       carea = 0.0;
 1087:       ifltype = 0;
 1088:       iettype = 0;
 1089:       eth = 0.0;
 1090:    }
 1091: 
 1092:    BoundarySegment(void) {
 1093:       isLand = false;
 1094:       clen = 0.0; 
 1095:       carea = 0.0;
 1096:       ifltype = 0;
 1097:       iettype = 0;
 1098:       eth = 0.0;
 1099:    }
 1100: 
 1101:    
