 9167: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9168:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9169:    NODE(node);
 9170: 
 9171:    switch (varCode) {
 9172:       case (int)VarCode::outputCoords: {
 9173:          const Point2 coords = node->outputCoords();
 9174:          double *out = (double *)((char *)res + idx_node * 16);
 9175:          out[0] = coords.x;
 9176:          out[1] = coords.y;
 9177:          break;
 9178:       }
 9179:       case (int)VarCode::depth:
 9180:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9181:          break;
 9182:       case (int)VarCode::kb:
 9183:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9184:          break;
 9185:       case (int)VarCode::eta:
 9186:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9187:          break;
 9188:       case (int)VarCode::u_air: {
 9189:          double *out = (double *)((char *)res + idx_node * 16);
 9190:          out[0] = node->u_air.x;
 9191:          out[1] = node->u_air.y;
 9192:          break;
 9193:       }
 9194:       case (int)VarCode::isdry:
 9195:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9196:          break;
 9197:       case (int)VarCode::u: {
 9198:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9199:          if (k >= 0) {
 9200:             out[0] = node->u2[k].x;
 9201:             out[1] = node->u2[k].y;
 9202:          } else {
 9203:             for (int lev = 0; lev < nvrt; lev++) {
 9204:                out[lev*2    ] = node->u2[lev].x;
 9205:                out[lev*2 + 1] = node->u2[lev].y;
 9206:             }
 9207:          }
 9208:          break;
 9209:       }
 9210:       case (int)VarCode::z: {
 9211:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9212:          if (k >= 0)
 9213:             out[0] = node->z[k];
 9214:          else
 9215:             for (int lev = 0; lev < nvrt; lev++)
 9216:                out[lev] = node->z[lev];
 9217:          break;
 9218:       }
 9219:       case (int)VarCode::w: {
 9220:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9221:          if (k >= 0)
 9222:             out[0] = node->w2[k];
 9223:          else
 9224:             for (int lev = 0; lev < nvrt; lev++)
 9225:                out[lev] = node->w2[lev];
 9226:          break;
 9227:       }
 9228:       case (int)VarCode::dfh: {
 9229:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9230:          if (k >= 0)
 9231:             out[0] = node->dfh[k];
 9232:          else
 9233:             for (int lev = 0; lev < nvrt; lev++)
 9234:                out[lev] = node->dfh[lev];
 9235:          break;
 9236:       }
 9237:       case (int)VarCode::dfv: {
 9238:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9239:          if (k >= 0)
 9240:             out[0] = node->dfv[k];
 9241:          else
 9242:             for (int lev = 0; lev < nvrt; lev++)
 9243:                out[lev] = node->dfv[lev];
 9244:          break;
 9245:       }
 9246:    }
 9247: }
 9248: 
