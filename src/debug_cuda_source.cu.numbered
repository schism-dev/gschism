  334: // Polynomial class
  335: template<int grade>
  336: struct Polynomial {
  337:     // Static assertion to give a clear error message at compile time
  338:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  339: };
  340: 
  341: 
  342: // Explicit specialization for grade 4
  343: template<>
  344: struct Polynomial<4> {
  345:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  346: 
  347:    // Constructor from coefficients
  348:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  349: 
  350:    __device__ __forceinline__ double eval(double x) const {
  351:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  352:    }
  353: };
