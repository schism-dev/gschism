 2176: 
 2177: /**  Interpolate velocities at a given point (xt,yt,zt)
 2178: 
 2179:    @param xt, yt, zt: coordinates of the point to interpolate
 2180:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2181: 
 2182:    This is done in four steps:
 2183: 
 2184:    1. Find the shape coordinates for the final position in the element.
 2185:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2186:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2187:       z levels at xt, yt at each step.   
 2188:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2189:       horizontally and vertically.
 2190: **/
 2191: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2192:    // Interpolate the velocities at the point xt. 
 2193:    // This function works the same for triangular and quadrilateral elements.
 2194:    double shpCoord[4];
 2195: 
 2196:    // First step is to compute the shape coordinates of (xt,yt)
 2197:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2198:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2199: 
 2200:    // Second step is to find the level that contains zt
 2201:    // Uses a binary search to find the level
 2202:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2203:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2204:    int R = nvrt - 1;
 2205: 
 2206:    // Get the z coordinates at the nodes of the element at the levels L and R
 2207:    double zLAtNodes[4], zRAtNodes[4];
 2208:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2209:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2210: 
 2211:    double zL = interpolate(shpCoord, zLAtNodes);
 2212:    double zR = interpolate(shpCoord, zRAtNodes);
 2213:    
 2214:    // Interpolates vertically the velocities
 2215:    double wght1, wght2;
 2216:    if (xt.z<=zL) {
 2217:       wght1 = 1.0;
 2218:       wght2 = 0.0;
 2219:    }
 2220:    else if (xt.z>=zR) {
 2221:       wght1 = 0.0;
 2222:       wght2 = 1.0;
 2223:    }
 2224:    else {
 2225:       // Perform a binary search to find the levels between L and R that contain xt.z
 2226:       while (R - L > 1) {
 2227:          int M = (L + R) / 2;
 2228: 
 2229:          double zMAtNodes[4];
 2230:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2231:          double zM = interpolate(shpCoord, zMAtNodes);
 2232:          if (zM < xt.z) 
 2233:          {
 2234:             L = M;
 2235:             zL = zM;
 2236:          }
 2237:          else 
 2238:          {
 2239:             R = M;
 2240:             zR = zM;
 2241:          }
 2242:       }
 2243:       assert(L == R-1);
 2244:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2245: 
 2246:       wght2 = (xt.z - zL)/(zR - zL);
 2247:       wght1 = 1.0 - wght2;
 2248:    }
 2249: 
 2250:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2251:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2252: 
 2253:    // Neither of the interpolated velocities should be NaN
 2254:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2255: 
 2256: }
 2257: 
