 5295:    __global__ void resetBoundaryAreas(void) {
 5296:       // Reset boundary areas and lengths for each segment.
 5297: 
 5298:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5299:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5300:       SIDE_BND(sideBnd);
 5301: 
 5302:       BoundarySegment *segment = sideBnd->segment;
 5303: 
 5304:       segment->carea = 0.0;
 5305:       segment->clen = 0.0;
 5306:  
 5307:    }
 5308: 
 5309:    __global__ void computeBoundaryAreas(void) {
 5310:    // Calculation of cross-section areas and lengths for flow b.c.
 5311: 
 5312:       SIDE_BND(sideBnd);
 5313: 
 5314:       const Side *side = sideBnd->side;
 5315:       BoundarySegment *segment = sideBnd->segment;
 5316: 
 5317:       if (segment->ifltype != 0) {
 5318: 
 5319:          const Node *n1 = side->n1;
 5320:          const Node *n2 = side->n2;
 5321: 
 5322:          const double htot = side->htot2();
 5323: 
 5324:          if (!side->isDry) {
 5325:             atomicAdd(&segment->carea, htot*side->len);
 5326:             atomicAdd(&segment->clen, side->len);
 5327:          }
 5328:       }
 5329: 
 5330:    }
 5331: 
 5332: 
 5333:    __global__ void computeFlowBcVelocities(double time) {
 5334: 
 5335:       SIDE_BND(sideBnd);
 5336: 
 5337:       const Side *side = sideBnd->side;
 5338:  
 5339:       const bool isDry = side->isDry;
 5340:       const bool isLand = sideBnd->segment->isLand;
 5341: 
 5342:    
 5343:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5344: 
 5345:       if (isDry || isLand) return;
 5346: 
 5347:       // For wet sides in open boundaries...
 5348:       const Vector2 n = side->n;
 5349:       const BoundarySegment *segment = sideBnd->segment;
 5350: 
 5351:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5352: 
 5353:       const int ifltype = segment->ifltype;
 5354: 
 5355:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5356:       const Vector2 r_nuth0 = r_uth0*n;
 5357: 
 5358: 
 5359:       if (ifltype == 1 || ifltype == 2) {
 5360:       
 5361:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5362: 
 5363:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5364:          
 5365:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5366:          
 5367:       } else if (ifltype == -1) { // Flather 1
 5368: 
 5369:          for (int k = 0; k < nvrt; k++) {
 5370: 
 5371:             // uth is the normal vel.; no ramp up
 5372:             const double uth = sideBnd->nuth(k);
 5373:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5374: 
 5375:             sideBnd->ubc[k] += uth*n;
 5376:          }
 5377: 
 5378:       } else if (ifltype == 3 || ifltype == 5) {
 5379:          // vnth0=0 !normal vel.
 5380: 
 5381:          Vector2 r_u1_bar = {0.0, 0.0};
 5382:          // Computes the contribution to the velocity from all tide frequencies
 5383:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5384: 
 5385:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5386:             const Vector2 umo  = sideBnd->umo(jfr); 
 5387: 
 5388:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5389:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5390:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5391:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5392: 
 5393:          }
 5394: 
 5395: 
 5396:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5397: 
 5398:       } // if (ifltype = 3 || ifltype == 5
 5399: 
 5400: 
 5401: 
 5402:    }
 5403: 
 5404:    __global__ void computeElevationBoundaryConditions(double time) {
 5405:       // Compute elevation essential boundary conditions 
 5406: 
 5407:       NODE_BND(nodeBnd); // Each boundary node.
 5408: 
 5409:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5410: 
 5411:       const Node *node = nodeBnd->node;
 5412:       const BoundarySegment *segment = nodeBnd->segment;
 5413:       const int iettype = segment->iettype;
 5414:       
 5415: 
 5416:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5417:       double eic = 0.0;
 5418:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5419:       else                 eic = 0.0;
 5420: 
 5421:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5422:       const double r_eth = ramp*nodeBnd->eth;
 5423:       double r_eta1_bar = 0.0;
 5424: 
 5425:       // Compute tide elevation
 5426:       if (iettype == 3 || iettype == 5) {   
 5427: 
 5428:          if constexpr(iloadtide==1) { // loading tide
 5429:             assert(false && "Loading tide not implemented");
 5430:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5431:          }
 5432:          
 5433:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5434: 
 5435:             const double efa  = nodeBnd->efa[jfr]; 
 5436:             const double emo  = nodeBnd->emo[jfr]; 
 5437: 
 5438:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5439:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5440:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5441: 
 5442: 
 5443:          } // for jfr
 5444: 
 5445:       } // if iettype
 5446: 
 5447:       switch (iettype) {
 5448:          case 1:
 5449:          case 2:
 5450:          case 4:
 5451:             nodeBnd->elbc = r_eic + r_eth;
 5452:             break;
 5453:          case 3:
 5454:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5455:             break;
 5456:          case 5:
 5457:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5458:             break;
 5459:       } // switch
 5460: 
 5461: 
 5462:       //Add inverse barometric effects
 5463:       if (iettype != 0 && inv_atm_bnd == 1) {
 5464:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5465:       }
 5466: 
 5467:    }
 5468: 
 5469: 
 5470:    __global__ void computeHorizontalViscosity(void) { 
 5471: 
 5472:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5473: 
 5474:       SIDE(side);
 5475: 
 5476:       if (side->isDry) return;
 5477: 
 5478:       for (int k = 0; k < nvrt; k++) {
 5479:          side->nuGradU[k] = {0.0, 0.0};
 5480:       }
 5481: 
 5482:       if constexpr(ihorcon == 1) {
 5483:          for (int k = side->kb; k < nvrt - 1; k++) {
 5484:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5485:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5486:             // By Zhang and Baptista.
 5487: 
 5488:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5489:             // This is a standard discretization of the Laplacian operator.
 5490:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5491:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5492:             // Gamma is hvis_coef0 in the code.
 5493:             // The value of gamma needs to be < 0.5.
 5494: 
 5495:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5496:             // side under consideration in each of the two possible elements that share the side.
 5497:             Vector2 sumU = {0.0, 0.0};
 5498:             for (int l = 0; l < 2; l++) {
 5499:                const Element *elem = side->elems[l];
 5500: 
 5501:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5502: 
 5503:                // Find the local index of the side in the element
 5504:                const int idxSide = elem->sideLocalIdx(side);
 5505: 
 5506:                // Find the two sides that are connected to the side under consideration
 5507:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5508:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5509: 
 5510:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5511: 
 5512:             }
 5513: 
 5514:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5515: 
 5516:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5517:    
 5518:          }
 5519:       }
 5520:       else if constexpr(ihorcon == 2) {
 5521:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5522:       }
 5523: 
 5524: 
 5525:    }
 5526: 
 5527: 
 5528:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5529: 
 5530:       // Set essential boundary conditions 
 5531:       NODE(node); // Each boundary node
 5532:       NodeBoundary *nodeBnd = node->nodeBnd;
 5533:       
 5534:  
 5535:       // Check if this node has essential BC
 5536:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5537:          // Verify BC value is valid
 5538:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5539: 
 5540:        
 5541:          // Set diagonal to 1 and zero off-diagonals
 5542:          node->coeffDiag = 1.0;
 5543: 
 5544:          for (int j = 0; j < node->numNodes; j++) {
 5545:                node->coeffMatrix[j] = 0.0;
 5546:          }
 5547:          
 5548:          // Set solution and RHS to BC value
 5549:          node->mX  = nodeBnd->elbc;
 5550:          node->qel = nodeBnd->elbc;
 5551: 
 5552:       } else {
 5553:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5554: 
 5555:          for (int j = 0; j < node->numNodes; j++) {
 5556:                Node* nbNode = node->nodes[j];
 5557:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5558:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5559:                   // Verify neighbor's BC value
 5560:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5561: 
 5562:                   // Subtract contribution to RHS
 5563:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5564:                   node->coeffMatrix[j] = 0.0;  
 5565:                }
 5566:          }
 5567:       }
 5568:    }
 5569: 
 5570: 
 5571:    __global__ void updateElevation(void) {
 5572:       NODE(node);
 5573: 
 5574: 
 5575:       node->eta2 = node->mX;
 5576: 
 5577:       node->updateZCoordData();
 5578:    }
