 3383:    nbs = *sharedIdxSideBoundary + 1;
 3384:    nbp = *sharedIdxNodeBoundary + 1;
 3385: 
 3386:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3387: 
 3388: }
