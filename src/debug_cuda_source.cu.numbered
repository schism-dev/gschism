 2201: /**
 2202:  * This method performs backtracking from the side center until a time -dt back in time 
 2203:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2204:  * intermediate point.
 2205:  *
 2206:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2207:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2208:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2209:  * remaining time.
 2210:  * 
 2211:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2212:  * 
 2213:  * @param uuint, vvint, wwint: Velocities at the final point
 2214:  * @param jlev: Level at which the backtracking is performed
 2215:  * @param dt, dtbk: Tracking timesteps
 2216:  * @return: True if the backtracking was successful, false otherwise
 2217:  */
 2218: __inline__ __device__ bool Side::btrack(
 2219:       int jlev,
 2220:       double dt,            // Tracking time
 2221:       double dtbk,          // Tracking timestep
 2222:       Vector3 &u_int        // Velocities at the initial point
 2223: ) const {
 2224: 
 2225:    // Start from side center
 2226:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2227:  
 2228: 
 2229:    double time_rm = dt; // Remaining time
 2230: 
 2231: 
 2232:    // // Initialize outputs XXX
 2233:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2234:    //    sclr[i] = 0.0;
 2235:    // }
 2236: 
 2237: 
 2238:    // Initial velocities
 2239:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2240: 
 2241:    // Find the element that is in the direction opposite to the velocity
 2242:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2243: 
 2244:    const int MAX_ITERATIONS = 2; // XXXXXXXXXXXX 1000!!!!
 2245:    Element* nextElem = curElem;
 2246:    int iter = 0;
 2247:    while(true) {
 2248: 
 2249:       // Calculate timestep
 2250:       double dtb = min(dtbk, time_rm);
 2251: 
 2252:       // Next point in the backtracking curve
 2253:       Point3 xt = x0 - dtb*u_int;
 2254: 
 2255: printf(" ________#iter11 = %d, jlev = %d, side.idx = %d, u_int = %.17g,%.17g,%.17g, x0 = %.17g,%.17g,%.17g, xt = %.17g,%.17g,%.17g\n", iter, jlev, idx, u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);      
 2256: 
 2257:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2258: printf(" ________#iter22 = %d, jlev = %d, side.idx = %d, u_int = %.17g,%.17g,%.17g, x0 = %.17g,%.17g,%.17g, xt = %.17g,%.17g,%.17g\n", iter, jlev, idx, u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);      
 2259:       assert(found && "Backtracking failed in btrack");
 2260: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2261:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2262:                       // then time_rm needs to be increased by the unused time.
 2263:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2264: 
 2265:       // The current point becomes the next segment's starting point.
 2266:       x0 = xt;
 2267:  
 2268:       curElem = nextElem;
 2269: 
 2270:       iter++;
 2271:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2272:    }
 2273: 
 2274: 
 2275: }
