 2028:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2029:       T values[4];
 2030:       getSideValues(field, values);
 2031:       
 2032:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2033:       if constexpr (IsVector2<T>::value && ics == 2) {
 2034:          projectSideVectorsToElementFrame(values);
 2035:       }
 2036: 
 2037:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2038:    }   
