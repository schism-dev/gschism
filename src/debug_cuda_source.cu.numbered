 7120: #ifdef DONTCOMPILE
 7121: __device__ void computeVerticalAdvection(void) {
 7122:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7123: 
 7124:    sdbt(1:2,:,:)=0.d0
 7125: 
 7126:    const Side *side = FROM kernel;
 7127: 
 7128:    if(side->isDry) return;
 7129: 
 7130:    // If side is wet...
 7131: 
 7132: 
 7133:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7134:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7135:    double ws[nvrt] = {} // w @ side
 7136:    int icount = 0;
 7137:    for (int j=0; j<2; j++) {
 7138:       const Element *elem = side->elements[j];
 7139:        
 7140:       if(elem != nullptr) {
 7141:          icount++;
 7142:          for (int k=0; k<nvrt; k++) {
 7143:             ws[k] = ws[k] + elem->w[k];
 7144:          }
 7145:       }
 7146:    }  // for j
 7147: 
 7148:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7149:    ws = ws/icount;
 7150: 
 7151:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7152:    // Splines allow for a smooth transition between vertical levels.
 7153:    // Splines have continuity restrictions at the internal knots, but
 7154:    // we have to provide the 1st derivatives at the endpoints.
 7155:    const int kbs = side->kbs; 
 7156:    
 7157:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7158:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7159:    initCubicSpline(kbs, nvrt, side, ws, up)
 7160: 
 7161:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7162:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7163:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7164: 
 7165:    // Total advection (average onto side)
 7166:    const Node *node1 = side->nodes[0];
 7167:    const Node *node2 = side->nodes[1];
 7168:    for (int k=kbs(i); k<nvrt; k++) {
 7169: 
 7170:       if constexpr(ics==1) {
 7171:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 7172:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 7173:       } else {
 7174:          // XXX IMPLEMENT THIS
 7175:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 7176:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 7177:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 7178:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 7179:       }  // if ics
 7180: 
 7181: 
 7182:    }
 7183: }
 7184: #endif
 7185: 
 7186: 
 7187: extern "C" {
 7188:    __global__ void computeElemAverageGhat(void) {
 7189:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7190: 
 7191:       ELEM(elem);
 7192:       
 7193:       elem->ghat1= {0.0, 0.0};  
 7194: 
 7195:       if constexpr(ihydraulics != 0) {
 7196:          if (nhtblocks > 0 && elem->isblock) return;
 7197:       }
 7198: 
 7199:       if (elem->isDry) return;
 7200: 
 7201:       // Wet elements.
 7202:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 7203:       // tidal potential, horizontal diffusion, and baroclinic etc
 7204:       // Remember to update both fb and F 
 7205:       // If ics=2, ghat1 are in eframe (ll)
 7206:       // cff1-3: coefficients for 2D/3D
 7207:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7208:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7209:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 7210: 
 7211:       double av_cff1 = 0.0;  // av. for cff1
 7212:       double av_cff2 = 0.0;  // av. for cff2
 7213:       double av_cff3 = 0.0;  // av. for cff3
 7214:       double av_df = 0.0;  // av. for H^\alpha / H
 7215:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7216:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7217: 
 7218:       const int i34 = elem->i34;
 7219:       const int kb = elem->kb;
 7220: 
 7221:       for (int j=0; j<i34; j++) {
 7222:          // For each node and side in the element...
 7223: 
 7224:          const Node *node = elem->nodes[j];
 7225:          const Side *side = elem->sides[j];
 7226: 
 7227:          const double chi      = side->chi;
 7228:          const double veg_c2   = side->veg_c2;
 7229:          const double veg_beta = side->veg_beta;
 7230:          const double veg_h    = side->veg_h();
 7231:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7232: 
 7233:          // Node - const in elem
 7234:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 7235:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 7236: 
 7237:          if (elem->depth >= tip_dp) {
 7238:            elem->gradETP += node->ETP*elem->gradPhi[j];
 7239:          }
 7240: 
 7241:          
 7242:          const double htot  = side->htot2();        // Total depth at the side
 7243:          const double zctr2 = side->zTopCanopy();  
 7244: 
 7245:          double cff1; 
 7246:          double cff2; 
 7247:          double cff3;   
 7248:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7249:          // coefficients applied to 2D/3D case 
 7250:             cff1 = side->hhat/htot;
 7251:             cff2 = 0.0;
 7252:             cff3 = 0.0;
 7253:          } else { //3D
 7254:             //Init for no-veg case
 7255:             cff1 = 1.0;
 7256:             cff2 = 1.0;
 7257:             cff3 = 0.0;
 7258: 
 7259:             if constexpr(iveg != 0) {
 7260:                // Computes coefficients used with vegetation terms G1, G2
 7261:                // cff1, cff3 are used for the first two terms in G1, G2:
 7262:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7263:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7264:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7265:                if(veg_h < 0.99*htot) { // submergent vegetation
 7266:                   cff1=1;
 7267:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7268:                   cff3 = veg_c;
 7269: 
 7270:                } else { // emergent vegetation
 7271:                   cff1 = 1.0/(1.0 + veg_c2);
 7272:                   cff2 = cff1;
 7273:                   cff3 = 0.0;
 7274: 
 7275:                }
 7276:             } // if iveg
 7277:          } //  2D/3D
 7278: 
 7279:          av_cff1 += cff1/i34;
 7280:          av_cff2 += cff2/i34;
 7281:          av_cff3 += cff3/i34;
 7282:          av_cff2_chi += cff2*chi/i34;
 7283:          av_cff3_chi += cff3*chi/i34;
 7284:          av_df += min(htot, veg_h)/(htot*i34);
 7285: 
 7286: 
 7287:          // btrack values: U^\star, U^{\star\alpha}
 7288:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7289:          Vector2 Ustar       = {0.0, 0.0}; 
 7290:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7291: 
 7292:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7293:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7294:          } else { //3D
 7295:             for (int k = side->kb; k < nvrt; k++) {
 7296:             
 7297:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7298:                Ustar += w2;
 7299: 
 7300:                if constexpr(iveg != 0) {
 7301:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7302:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7303:                        Ustar_alpha += zrat*w2; // XXXX
 7304:                    }
 7305:                }  // if iveg
 7306:             }  // for k
 7307:          }  //2D/3D
 7308:          
 7309: 
 7310:          // Add btrack & surface stress terms to \breve{G} first
 7311:          if constexpr(ics==1) {
 7312: 
 7313:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7314: 
 7315:          } else {
 7316:             // XXX IMPLEMENT THIS
 7317:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7318:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7319:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7320:          }  // if ics
 7321: 
 7322:          // Surface and bottom stress terms
 7323:          if constexpr(ics==1) {
 7324:             const Vector2 tau    = side->tau();
 7325:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7326: 
 7327:             // Term for surface and bottom stress
 7328:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7329: 
 7330:          } else {
 7331:             assert(false && "computeElemAverageGhat: Not implemented");
 7332:             // XXX IMPLEMENT THIS
 7333:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7334:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7335:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7336:             // tau_x=(vn1+tt1)/2.d0
 7337:             // tau_y=(vn2+ss1)/2.d0
 7338:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7339:          }  // if ics
 7340: 
 7341:          
 7342: 
 7343:          // All terms in F,F^\alpha,f_b except baroclinic
 7344:          // F, f_b: all explicit terms excluding vegetation 
 7345:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7346:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7347:          const double coriolis = side->coriolis;
 7348:          Vector2 F  =  coriolis*side->U;  // F_x
 7349:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7350:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7351: 
 7352:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7353:             
 7354:             for (int k = side->kb; k < nvrt; k++) {
 7355:                if (zctr2 > side->zc[k-1]) {
 7356:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7357:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7358:                    Fa +=  coriolis*w2*zrat;
 7359:                } // if zctr2
 7360:             } // k
 7361:          } // iveg
 7362: 
 7363:          // Integrate horizontal viscosity force vertically
 7364:          for (int k=side->kb + 1; k<nvrt; k++) {
 7365:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7366: 
 7367:             F += levelHorVisc;
 7368: 
 7369:             // Vegetation term
 7370:             if constexpr(iveg!=0) {
 7371:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7372:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7373:                   Fa += levelHorVisc*zrat;
 7374:                } 
 7375:             } // if iveg
 7376:          } // for k
 7377: 
 7378:          fb += side->nuGradU[side->kb];
 7379: 
 7380:          // Add to ghat1
 7381:          if constexpr(ics==2) {
 7382:             // XXX IMPLEMENT THIS
 7383:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7384:             // bigf1=vn1; bigf2=vn2
 7385:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7386:             // botf1=vn1; botf2=vn2
 7387:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7388:             // bigfa1=vn1; bigfa2=vn2
 7389:          } // if ics
 7390: 
 7391:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7392:       } // for j (nodes and sides)
 7393: 
 7394:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7395:          
 7396:       // Finish off terms in F, F^\alpha and f_b
 7397:       const double grav3 = elem->mean(&Node::grav2);
 7398:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7399: 
 7400: 
 7401:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7402:       for (int j=1; j<i34; j++) { 
 7403:          // For each side in the element...
 7404:          const Side *side = elem->sides[j];
 7405:          const double chi = side->chi;
 7406: 
 7407:          const double htot = side->htot2();
 7408:          const double veg_h = side->veg_h();
 7409:          const Vector2 F  = htot*fb;
 7410:          const Vector2 Fa = min(htot, veg_h)*fb;
 7411: 
 7412:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7413:       } // for j
 7414: 
 7415:       //botf1 etc are already in elem frame
 7416:       elem->ghat1 += tmp/i34;
 7417: 
 7418:       // Baroclinic force
 7419:       if constexpr(ibc==0) {
 7420:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7421: 
 7422:          Vector2 Fa = {0.0, 0.0};
 7423:          Vector2 intGradRho = {0.0, 0.0};
 7424:          
 7425:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7426:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7427:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7428: 
 7429:             // \in F [m^2/s/s]
 7430:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7431:          }
 7432: 
 7433:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7434:          const Vector2 F = av_df*Fa; //approx
 7435:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7436: 
 7437:       } // if ibc
 7438: 
 7439: 
 7440: 
 7441:    }
 7442: 
 7443: } // extern "C"
 7444: 
