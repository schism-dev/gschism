 1078:    int kb;                // Bottom index of the side
 1079:    bool isDry;            // True if the side is dry
 1080:  
 1081:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1082: 
 1083:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1084: 
 1085:    // Physical information
 1086:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1087:    Vector2 btu[nvrt];           // Back-tracked velocity
 1088:    Vector2 U;                   // Vertically averaged velocity vector  
 1089: 
 1090:    Vector2 nuGradU[nvrt];          // nu*grad u
 1091: 
 1092:    Vector2 bcc[nvrt];           // Baroclinic term
 1093:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1094: 
 1095:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1096:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1097:    Vector2 gradPr;               // Gradient of pressure
 1098:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1099: 
 1100: 
 1101:    double hhat;                 // \breve{H} in notes
 1102: 
 1103:    double shapiro;
 1104: 
 1105:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1106: 
 1107:    double coriolis;             // Coriolis parameter
 1108: 
 1109:    // Vegetation parameters
 1110:    double veg_c2;
 1111:    double veg_beta;
 1112: 
 1113:    // Bottom drag parameters.
 1114:    double chi;
 1115:    double chi2;
 1116: 
 1117:    __inline__ __device__ Point2 outputCoords(void) const;
 1118: 
 1119:    __inline__ __device__ double x(double t) const;
 1120:    __inline__ __device__ double y(double t) const;
 1121:    __inline__ __device__ double z(double t) const;
 1122:    __inline__ __device__ double lon(void) const;
 1123:    __inline__ __device__ double lat(void) const;
 1124:    __inline__ __device__ Point2 p2_t(double t) const;
 1125:    __inline__ __device__ Point3 p3_t(double t) const;
 1126: 
 1127:    #ifdef USE_FRAMES
 1128:    __device__ void setFrame(void) {
 1129:       double lat, lon;
 1130:       const Point3 p = toPoint3(center, centerZ());
 1131: 
 1132:       // Compute the latitude and longitude of the element center
 1133:       computeLatLon(p, lat, lon);
 1134: 
 1135:       frame.update(lat, lon);        
 1136:    }
 1137:    #endif
 1138: 
 1139:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1140:    // If ics == 2, convert the global point to the local frame of the original side
 1141:       
 1142:       if constexpr (ics == 1) {
 1143:          return p;
 1144:       } else {
 1145:          const Point3 c = {center.x, center.y, centerZ()};
 1146:          const Point3 local = frame.G2L(p - c);
 1147:          return local;
 1148:       }
 1149:    }
 1150: 
 1151:    __inline__ __device__ double centerZ(void)      const;
 1152:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1153:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1154:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1155:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1156: 
 1157:    __inline__ __device__ Side* neigh(int index) const { 
 1158:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1159:       assert(index >= 0 && index < 4); 
 1160:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1161: 
 1162:       const int ielem = index & 1;           // 0 or 1
 1163:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1164: 
 1165:       const Element* elem = elems[ielem];
 1166: 
 1167:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1168: 
 1169:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1170: 
 1171:    }
 1172: 
 1173:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1174: 
 1175:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1176: 
 1177:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1178:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1179:    __inline__ __device__ int iadv(void) const;
 1180: 
 1181:    __inline__ __device__ double grav3(void) const;
 1182:    
 1183:    __inline__ __device__ double eta2(void) const;
 1184:    __inline__ __device__ double eta1(void) const;
 1185:    __inline__ __device__ double w2(int k) const;
 1186:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1187:    __inline__ __device__ double depth(void) const;
 1188:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1189:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1190: 
 1191:    __inline__ __device__ double dfv(int k) const;
 1192: 
 1193:    __inline__ __device__ double veg_h(void)  const;
 1194:    __inline__ __device__ double veg_nv(void) const;
 1195:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1196:    __inline__ __device__ double veg_alpha3D(int k) const;
 1197:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1198: 
 1199:    __inline__ __device__ double Cd(void) const;
 1200: 
 1201:    __inline__ __device__ Vector2 tau(void) const;
 1202: 
 1203:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1204:    
 1205: 
 1206:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1207:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1208:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1209:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1210:    } 
 1211:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1212:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1213:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1214:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1215: 
 1216:    // Get valid starting element (for backtracking)
 1217:    __inline__ __device__ Element* getStartElement() {
 1218:       return elems[0] ? elems[0] : elems[1];
 1219:    }
 1220: 
 1221:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1222:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1223:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1224: 
 1225:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1226: 
 1227:       // Dot product of the negative velocity vector with the side normal vector
 1228:       const double dot_prod1 = -dot(u, n);
 1229: 
 1230:       // Vector from side center to element 0 centroid
 1231:       const Vector2 v2 = elems[0]->center - center;
 1232: 
 1233:       // Dot product of the vector with the side normal vector
 1234:       const double dot_prod2 = dot(v2, n);
 1235: 
 1236:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1237:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1238: 
 1239:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1240:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1241: 
 1242:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1243: 
 1244:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1245:       else                           return !isDry1 ? elems[1] : elems[0];
 1246: 
 1247:  
 1248:    }
 1249: 
 1250:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1251:       // Given an element, returns the other element that shares this side
 1252:       return (elems[0] == elem) ? elems[1] : elems[0];
 1253:    }
 1254: 
 1255:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1256:       // Given a node, returns the other node that shares this side
 1257:       return (n1 == node) ? n2 : n1;
 1258:    }
 1259:  
 1260:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1261: 
 1262: 
 1263: 
 1264: 
 1265: };
