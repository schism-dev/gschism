 3537:    __global__ void scaleGravity(double loadtide_coef) {
 3538: 
 3539: 
 3540:       NODE(node);
 3541: 
 3542:       // SAL option: scale gravity
 3543:       if constexpr(iloadtide==2) {  // simple const
 3544:          node->grav2 = grav*(1.0 - loadtide_coef);
 3545: 
 3546:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3547:         
 3548:           const double depth = max(node->depth, 0.0);
 3549:           const double tmp1 = sqrt(depth);
 3550:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3551:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3552:                              2.6969e-13*depth*depth*depth*tmp1;
 3553:           
 3554:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3555:           
 3556: 
 3557: 
 3558:           node->grav2 = grav*(1.0 - beta_bar);
 3559: 
 3560:       } else {  // iloadtide=0,1
 3561:         node->grav2=grav;
 3562: 
 3563:       }
 3564: 
 3565:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3566:    }
 3567: 
