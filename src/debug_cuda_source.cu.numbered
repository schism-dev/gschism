 6335: extern "C" {
 6336:    __global__ void computeElemAverageGhat(void) {
 6337:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6338: 
 6339:       ELEM(elem);
 6340:       
 6341:       elem->ghat1= {0.0, 0.0};  
 6342: 
 6343:       if constexpr(ihydraulics != 0) {
 6344:          if (nhtblocks > 0 && elem->isblock) return;
 6345:       }
 6346: 
 6347: 
 6348: 
 6349:       
 6350:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6351:       // tidal potential, horizontal diffusion, and baroclinic etc
 6352:       // Remember to update both fb and F 
 6353:       // If ics=2, ghat1 are in eframe (ll)
 6354:       // cff1-3: coefficients for 2D/3D
 6355:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6356:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6357:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6358: 
 6359:       if (elem->isDry) return;
 6360: 
 6361:       double av_cff1 = 0.0;  // av. for cff1
 6362:       double av_cff2 = 0.0;  // av. for cff2
 6363:       double av_cff3 = 0.0;  // av. for cff3
 6364:       double av_df = 0.0;  // av. for H^\alpha / H
 6365:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6366:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6367: 
 6368:       const int i34 = elem->i34;
 6369:       const int kb = elem->kb;
 6370: 
 6371:       for (int j=0; j<i34; j++) {
 6372:          // For each node and side in the element...
 6373: 
 6374:          const Node *node = elem->nodes[j];
 6375:          const Side *side = elem->sides[j];
 6376: 
 6377:          const double chi      = side->chi;
 6378:          const double veg_c2   = side->veg_c2;
 6379:          const double veg_beta = side->veg_beta;
 6380:          const double veg_h    = side->veg_h();
 6381:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6382: 
 6383:          // Node - const in elem
 6384:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6385:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6386: 
 6387:          if (elem->depth >= tip_dp) {
 6388:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6389:          }
 6390: 
 6391:          
 6392:          const double htot  = side->htot2();        // Total depth at the side
 6393:          const double zctr2 = side->zTopCanopy();  
 6394: 
 6395:          double cff1; 
 6396:          double cff2; 
 6397:          double cff3;   
 6398:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6399:          // coefficients applied to 2D/3D case 
 6400:             cff1 = side->hhat/htot;
 6401:             cff2 = 0.0;
 6402:             cff3 = 0.0;
 6403:          } else { //3D
 6404:             //Init for no-veg case
 6405:             cff1 = 1.0;
 6406:             cff2 = 1.0;
 6407:             cff3 = 0.0;
 6408: 
 6409:             if constexpr(iveg != 0) {
 6410:                // Computes coefficients used with vegetation terms G1, G2
 6411:                // cff1, cff3 are used for the first two terms in G1, G2:
 6412:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6413:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6414:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6415:                if(veg_h < 0.99*htot) { // submergent vegetation
 6416:                   cff1=1;
 6417:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6418:                   cff3 = veg_c;
 6419: 
 6420:                } else { // emergent vegetation
 6421:                   cff1 = 1.0/(1.0 + veg_c2);
 6422:                   cff2 = cff1;
 6423:                   cff3 = 0.0;
 6424: 
 6425:                }
 6426:             } // if iveg
 6427:          } //  2D/3D
 6428: 
 6429:          av_cff1 += cff1/i34;
 6430:          av_cff2 += cff2/i34;
 6431:          av_cff3 += cff3/i34;
 6432:          av_cff2_chi += cff2*chi/i34;
 6433:          av_cff3_chi += cff3*chi/i34;
 6434:          av_df += min(htot, veg_h)/(htot*i34);
 6435: 
 6436: 
 6437:          // btrack values: U^\star, U^{\star\alpha}
 6438:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6439:          Vector2 Ustar       = {0.0, 0.0}; 
 6440:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6441: 
 6442:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6443:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6444:          } else { //3D
 6445:             for (int k = side->kb + 1; k < nvrt; k++) {
 6446:             
 6447:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6448:                Ustar += w2;
 6449: 
 6450:                if constexpr(iveg != 0) {
 6451:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6452:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6453:                        Ustar_alpha += zrat*w2; // XXXX
 6454:                    }
 6455:                }  // if iveg
 6456:             }  // for k
 6457:          }  //2D/3D
 6458:          
 6459: 
 6460:          // Add btrack & surface stress terms to \breve{G} first
 6461:          if constexpr(ics==1) {
 6462: 
 6463:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6464: 
 6465:          } else {
 6466:             assert(false && "computeElemAverageGhat: Not implemented");
 6467:             // XXX IMPLEMENT THIS
 6468:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6469:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6470:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6471:          }  // if ics
 6472: 
 6473:          // Surface and bottom stress terms
 6474:          if constexpr(ics==1) {
 6475:             const Vector2 tau    = side->tau();
 6476:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6477: 
 6478:             // Term for surface and bottom stress
 6479:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6480: 
 6481:          } else {
 6482:             assert(false && "computeElemAverageGhat: Not implemented");
 6483:             // XXX IMPLEMENT THIS
 6484:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6485:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6486:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6487:             // tau_x=(vn1+tt1)/2.d0
 6488:             // tau_y=(vn2+ss1)/2.d0
 6489:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6490:          }  // if ics
 6491: 
 6492:          
 6493: 
 6494:          // All terms in F,F^\alpha,f_b except baroclinic
 6495:          // F, f_b: all explicit terms excluding vegetation 
 6496:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6497:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6498:          const double coriolis = side->coriolis;
 6499:          Vector2 F  =  coriolis*side->U;  // F_x
 6500:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6501:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6502: 
 6503:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6504:             
 6505:             for (int k = side->kb; k < nvrt; k++) {
 6506:                if (zctr2 > side->zc[k-1]) {
 6507:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6508:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6509:                    Fa +=  coriolis*w2*zrat;
 6510:                } // if zctr2
 6511:             } // k
 6512:          } // iveg
 6513: 
 6514:          // Integrate horizontal viscosity force vertically
 6515:          for (int k=side->kb + 1; k<nvrt; k++) {
 6516:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6517: 
 6518:             F += levelHorVisc;
 6519: 
 6520:             // Vegetation term
 6521:             if constexpr(iveg!=0) {
 6522:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6523:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6524:                   Fa += levelHorVisc*zrat;
 6525:                } 
 6526:             } // if iveg
 6527:          } // for k
 6528: 
 6529:          fb += side->nuGradU[side->kb];
 6530: 
 6531:          // Add to ghat1
 6532:          if constexpr(ics==2) {
 6533:             assert(false && "computeElemAverageGhat: Not implemented");
 6534:             // XXX IMPLEMENT THIS
 6535:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6536:             // bigf1=vn1; bigf2=vn2
 6537:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6538:             // botf1=vn1; botf2=vn2
 6539:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6540:             // bigfa1=vn1; bigfa2=vn2
 6541:          } // if ics
 6542: 
 6543:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6544:       } // for j (nodes and sides)
 6545: 
 6546:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6547:          
 6548:       // Finish off terms in F, F^\alpha and f_b
 6549:       const double grav3 = elem->mean(&Node::grav2);
 6550:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6551: 
 6552: 
 6553:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6554:       for (int j=1; j<i34; j++) { 
 6555:          // For each side in the element...
 6556:          const Side *side = elem->sides[j];
 6557:          const double chi = side->chi;
 6558: 
 6559:          const double htot = side->htot2();
 6560:          const double veg_h = side->veg_h();
 6561:          const Vector2 F  = htot*fb;
 6562:          const Vector2 Fa = min(htot, veg_h)*fb;
 6563: 
 6564:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6565:       } // for j
 6566: 
 6567:       //botf1 etc are already in elem frame
 6568:       elem->ghat1 += tmp/i34;
 6569: 
 6570:       // Baroclinic force
 6571:       if constexpr(ibc==0) {
 6572:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6573: 
 6574:          Vector2 Fa = {0.0, 0.0};
 6575:          Vector2 intGradRho = {0.0, 0.0};
 6576:          
 6577:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6578:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6579:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6580: 
 6581:             // \in F [m^2/s/s]
 6582:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6583:          }
 6584: 
 6585:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6586:          const Vector2 F = av_df*Fa; //approx
 6587:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6588: 
 6589:       } // if ibc
 6590: 
 6591: 
 6592: 
 6593:    }
 6594: 
 6595: } // extern "C"
 6596: 
 6597: 
 6598: 
 6599: #ifdef DONTCOMPILE
 6600: __global__ void checkMassConservation(Tracers* sumtr) {
 6601: 
 6602:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6603: 
 6604:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6605: 
 6606:    Element *elem = &(mesh->localElemData[i]);
 6607: 
 6608:    // Skip dry elements
 6609:    if (elem->isDry) return;
 6610: 
 6611:    // Local sum array for this thread
 6612:    double localSum[N_TRACERS] = {0.0};
 6613: 
 6614:    // Sum over vertical levels for this element
 6615:    const int kbe = elem->kbe;
 6616:    const double area = elem->area;
 6617: 
 6618:    for (int k = kbe; k < nvrt; k++) {
 6619:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6620:       
 6621:       // Accumulate tracer mass
 6622:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6623:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6624:       }
 6625:    }
 6626: 
 6627:    //  This function returns per element sums. A reduction must be done on the host side.
 6628: }
 6629: 
 6630: 
 6631: __global__ void transport(void) {
 6632: 
 6633:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6634: 
 6635:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6636: 
 6637:    Element *elem = &(mesh->localElemData[ie]);
 6638: 
 6639:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6640: 
 6641:                for (int m=0; m<ntr; m++) {
 6642:                   for (int k=kbe(ie); k<nvrt; k++) {
 6643:                      // Calculate each polynomial's weight 
 6644:                      wm=0.d0; sum1=0.d0; 
 6645:                      wm1=0.d0; wm2=0.d0; 
 6646:                      for (int i=0; i<elem->nweno2; i++) {
 6647:                   
 6648:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6649:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6650:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6651:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6652:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6653:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6654:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6655:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6656:                      // -----------------Hu and Shu (1999)'s method----------------
 6657:                      b4=b1+b2+b3
 6658: 
 6659: //Error: add PRODUCTION CPP
 6660: #ifdef DEBUG
 6661:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6662:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6663:                     call parallel_abort(errmsg)
 6664:                   }
 6665: #endif
 6666: 
 6667:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6668:                   // !----test-------------- 
 6669:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6670:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6671:                   // !wm(i)=wm1(i)*wm2(i)
 6672:                   // !---------------------- 
 6673:                   sum1=sum1+wm(i)
 6674:                 } // end for i
 6675: 
 6676:                 wm=wm/sum1
 6677: 
 6678:                 for (int j=0; j<elem->i34; j++) {
 6679: 
 6680:                   const Side *side  = elem->sides[j];
 6681:                   const Node *node1 = side->n1;
 6682:                   const Node *node2 = side->n2;
 6683: 
 6684:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6685:                      trsd=0.d0
 6686:                      for (int kk=0; kk<nquad; kk++) {
 6687:                         for (int i=0; i<elem->nweno2; i++) {
 6688:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6689:                         } // end for i   
 6690:                      } // end for kk
 6691:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6692:                   } // outward flux
 6693:                } // end for j=1,i34(ie) ! side
 6694:             }
 6695:          }
 6696:               
 6697: 
 6698: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6699: //             //   calculate each polynomial's weight 
 6700: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6701: //                 wm=0.d0; sum1=0.d0
 6702: //                 do i=1,nweno1(ie) !for each polynomial
 6703: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6704: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6705: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6706: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6707: //                   wm(i)=b2
 6708: //                   sum1=sum1+b2
 6709: //                   !wm(i)=1.d0
 6710: //                   !sum1=sum1+1.d0
 6711: 
 6712: // // Error: PRODUCTION
 6713: // #ifdef DEBUG
 6714: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6715: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6716: //                     call parallel_abort(errmsg)
 6717: //                   endif
 6718: // #endif
 6719: 
 6720: //                 enddo !i
 6721: //                 wm=wm/sum1 !final weight
 6722: 
 6723:                 for (int j=0; j<elem->i34; j++) { // side
 6724:                   const Side *side = elem->sides[j];
 6725:                   const Node *node1 = side->n1;
 6726:                   const Node *node2 = side->n2;
 6727: 
 6728:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6729:                     trsd=0.d0
 6730:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6731:                       for (int i=0; i<elem->nweno1; i++) {
 6732:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6733:                       }
 6734:                     enddo //kk
 6735:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6736:                   } // outward flux
 6737:                 } // end for j=1,i34(ie) ! side
 6738:               } // end for k; ntr 
 6739: 
 6740:             else !simple upwind method
 6741:               do j=1,i34(ie)
 6742:                 jsj=elside(j,ie)
 6743:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6744:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6745:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6746:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6747:                   endif
 6748:                 enddo  !vertical layers
 6749:               enddo !j=1,i34(ie) ! side
 6750:             endif !order of accuracy
 6751: 
 6752:          //  enddo !ie
 6753: // !$OMP     end do
 6754: 
 6755: // !$OMP     master
 6756: //           !message passing
 6757: //           if (nproc>1) then
 6758: //             !make a copy of side concentrations
 6759: //             trsd_tmp0=trsd_tmp 
 6760: 
 6761: //             !this exchange routine swaps interface concentration between two partitions
 6762: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6763: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6764: 
 6765: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6766: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6767: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6768: 
 6769: 
 6770: //             !This obtains final values for interface sides
 6771: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6772: //       :    endif !nproc>1
 6773: //           !message passing end
 6774: // !$OMP     end master
 6775: // !$OMP     barrier
 6776: 
 6777: 
 6778: // !         Do advection; conc @ dry elem will not be changed
 6779: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 6780: // !$OMP     do reduction(+: h_mass_in)
 6781: //           do i=1,ne
 6782: //             if(idry_e(i)==1) cycle
 6783: 
 6784: 
 6785: // !           Wet elements with 3 wet nodes
 6786: //             do k=kbe(i)+1,nvrt
 6787: 
 6788: 
 6789: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
