 7669:                                  
 7670:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7671:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7672:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7673:                    int *isdel, int *isidenode, int *isbnd,
 7674:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7675:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7676:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7677:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7678:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7679:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7680:                    double *drag, double *roughness,
 7681:                    double *emo, double *efa, 
 7682:                    double *umo, double *ufa, 
 7683:                    double *vmo, double *vfa) {
 7684: 
 7685:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7686:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 7687:                        isdel, isidenode, isbnd,
 7688:                        nond, nlnd, iond, ilnd, 
 7689:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7690:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7691:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7692:                        localNodeIndices, localElemIndices, localSideIndices,
 7693:                        localNodePart, localElemPart, localSidePart,
 7694:                        drag, roughness,
 7695:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 7696:   }
