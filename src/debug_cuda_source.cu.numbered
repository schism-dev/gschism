  915:    // int  itrtype[natrm];    // Tracer boundary condition type
  916: 
  917:    BoundarySegment(bool _isLand) {
  918:       isLand = _isLand;
  919:       clen = 0.0;
  920:       carea = 0.0;
  921:       ifltype = 0;
  922:       iettype = 0;
  923:       eth = 0.0;
