 2377: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2378:    if constexpr(ics == 1)  {
 2379:       return center;
 2380: 
 2381:    } else {
 2382:       const Point2 p0 = nodes[0]->outputCoords();
 2383:       const Point2 p1 = nodes[1]->outputCoords();
 2384:       const Point2 p2 = nodes[2]->outputCoords();
 2385: 
 2386:       if (isTri()) {
 2387:          return (1.0/3.0)*(p0 + p1 + p2);
 2388: 
 2389:       } else {
 2390:          const Point2 p3 = nodes[3]->outputCoords();
 2391:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2392:       }
 2393: 
 2394:    }
 2395: }
