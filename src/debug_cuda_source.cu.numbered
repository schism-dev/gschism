  934:    __device__ __forceinline__ double intPhiPhiTri(int i, int j) const;
  935: 
  936:    __device__ __forceinline__ double intGradPhiGradPhiTri(int i, int j) const;
  937: 
  938:    __device__ __forceinline__ double intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  939: 
  940:    __device__ __forceinline__ double intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  941: 
  942:    __device__ __forceinline__ Vector2 grad2(double *a) const
  943:    {
  944:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  945:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  946:       if (isQuad()) {
  947:          gx += a[3]*gradPhi[3].x;
  948:          gy += a[3]*gradPhi[3].y;
  949:       }
  950:       return {gx, gy};
  951:    }
  952: 
  953:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
  954:    {
  955:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  956:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  957:       if (isQuad()) {
  958:          gx += (nodes[3]->*field)*gradPhi[3].x;
  959:          gy += (nodes[3]->*field)*gradPhi[3].y;
  960:       }
  961:       return {gx, gy};
  962:    }
