 4609:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4610: 
 4611:       SIDE(side);
 4612: 
 4613:       side->U = {0.0, 0.0}; 
 4614:          
 4615:       if(side->isDry) return;
 4616: 
 4617:       // Vertically integrated velocity U (in ll if ics=2)
 4618:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4619:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4620:          side->U += side->Dz(k + 1)*uc;  
 4621:       }
 4622: 
 4623:    }
 4624: 
 4625:    __global__ void computeBottomDragVegetation(void) {
 4626:       // UNFINISHED. CHECK THIS:
 4627:       // How many kernels are needed? Why so many for loops?
 4628:       // Is the loop on sides needed?
 4629: 
 4630:       NODE(node);
 4631: 
 4632: 
 4633:       const int    kb      = node->kb;
 4634:       const double htot    = node->htot2(); 
 4635:       
 4636:       if (node->isDry) {
 4637:          // Default values for dry nodes
 4638:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4639:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4640: 
 4641:          return;
 4642:        
 4643:       }
 4644: 
 4645:       // Computes bottom drag Cd based on the selected nchi
 4646:       node->computeBottomDragCd();
 4647:       
 4648: 
 4649: 
 4650:       //   Bottom stress in m^2/s^2
 4651:       if (node->rho[kb + 1] >= -98.0)
 4652:       {
 4653:          const double mag_u = length(node->u2[kb + 1]);
 4654:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4655: 
 4656:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4657:          // !sediment erosion: this part needs more documentation
 4658:       }
 4659:     
 4660: 
 4661: 
 4662:       // Compute vegetation parameters
 4663:       //--------------------------------
 4664: 
 4665:       // SAV constants
 4666:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4667:       constexpr double veg_cfpsi = 0.16;
 4668: 
 4669:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4670:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4671: 
 4672:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4673:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4674:          int kbin = 0; // bin index
 4675:          for (int k = kb; k < nvrt; k++) {
 4676:             // Computes node height above the bottom level
 4677:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4678:             assert(false && "Vertical variation of vegetation not implemented");
 4679: 
 4680:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4681:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4682:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4683:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4684:             // } else {
 4685:             //    // Find the bin at which the current vertical level is
 4686:             //    while (kbin<nbins_veg_vert) {
 4687:             //       const double zn = node->z[kbin];
 4688:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4689:             //          break;
 4690:             //       } // if
 4691:             //       kbin++;
 4692:             //    } // while
 4693:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4694: 
 4695:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4696:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4697:                
 4698:             //    // Linear interpolation of the vegetation parameters
 4699:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4700:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4701:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4702:             // } // if rl10
 4703: 
 4704:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4705: 
 4706:          } // for k
 4707: 
 4708: 
 4709:       } else { // Ganthy (iveg==2)
 4710:       //  Modify canopy height, diameter, and density
 4711: 
 4712:          // Make sure there is vegetation on this node
 4713:          if (node->veg_h_unbent > 0.0) {
 4714:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4715: 
 4716:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4717:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4718:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4719: 
 4720:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4721:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4722:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4723:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4724:          } // if veg_h_unbent
 4725: 
 4726:          for (int k = 0; k < nvrt; k++) {
 4727:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4728:          } // for k
 4729:       
 4730: 
 4731:       } // if iveg
 4732:      
 4733: 
 4734:       // Compute vertical mean of veg_alpha3D
 4735:       if (iveg != 0) {
 4736:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4737:          double sum1=0.0;
 4738:          double sum2=0.0;
 4739:          // Integrate over each level under the canopy...
 4740:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4741:             const double Dz = node->Dz(k);
 4742: 
 4743:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4744:             sum2 += Dz;
 4745: 
 4746:          } // for k
 4747:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4748:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4749: 
 4750:       } // if iveg
 4751: 
 4752:    }
 4753: 
 4754:    __global__ void computeVegetationAndDragParameters(void) {
 4755:       // Computes the vegetation and drag model parameters:
 4756:       // chi, \tilde\chi, beta, \breve{H}
 4757:       
 4758:       SIDE(side);
 4759: 
 4760:       side->hhat = 0.0;
 4761:       side->chi2 = 0.0;
 4762:       side->chi = 0.0;
 4763:       side->veg_c2 = 0.0;
 4764:       side->veg_beta = 0.0;
 4765: 
 4766:       if (side->isDry) return;
 4767: 
 4768:       const double htot = side->htot2();
 4769:       const int    kb   = side->kb;
 4770: 
 4771:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4772: 
 4773:       const double veg_h     = side->veg_h();
 4774:       const double veg_nv    = side->veg_nv();
 4775:       const double veg_c     = side->veg_c();
 4776:       const double veg_beta  = side->veg_beta;
 4777:       const double veg_alpha = side->veg_alpha_vert_mean();
 4778: 
 4779:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4780:       // Velocity magnitude at the bottom level
 4781:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4782:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4783:       side->chi2 = side->Cd()*vmag1;
 4784:       side->chi  = side->chi2;
 4785:       if constexpr(iveg != 0) {
 4786:          const Node *n1 = side->n1;
 4787:          const Node *n2 = side->n2;
 4788:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4789:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4790:       }
 4791: 
 4792:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4793: 
 4794:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4795:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4796:       double magUa = 0.0;
 4797:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4798:          // 3D wet side with veg...
 4799: 
 4800:          double magUa = 0.0;
 4801:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4802:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4803: 
 4804:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4805:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4806:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4807: 
 4808:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4809:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4810: 
 4811:                // Velocity magnitude at the bottom (l) of the level
 4812:                const double ul = length(side->u2[k]);
 4813: 
 4814:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4815:                magUa += Dz*0.5*(uh + ul);
 4816: 
 4817:             } // if HasVegetation
 4818:          } // for k
 4819:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4820: 
 4821:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4822:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4823:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4824:             const double zCpy = side->zTopCanopy();
 4825:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4826:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4827:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4828:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4829:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4830:          } // if isSubmerged
 4831:       } // if iveg   
 4832: 
 4833:       // Computes the friction modified depth, \breve{H} in notes
 4834:       if (side->is2D()) { // 2D
 4835: 
 4836:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4837:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4838: 
 4839:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4840: 
 4841:          side->hhat = htot*htot/fricH; 
 4842: 
 4843:       } else { // 3D
 4844:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 4845: 
 4846:          if constexpr(iveg != 0) {
 4847:             
 4848:             if (side->isSubmerged()) { 
 4849:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4850:                side->hhat -= veg_c*Hhat_alpha;
 4851: 
 4852:             } else { // Emergent
 4853:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4854:             }
 4855:          } // if iveg
 4856: 
 4857:          // Enforce positivity for 3D model
 4858:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4859:       } // if 3D
 4860: 
 4861:    }
 4862: 
 4863: 
 4864: 
 4865:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4866:    // Computes the density gradient between two elements, e1 and e2.
 4867:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4868:    // zero in the direction normal to the side. 
 4869:    // 
 4870:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4871:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4872:    //
 4873:    // Input:
 4874:    //    e1: Element
 4875:    //    e2: Neighbor element (or nullptr if boundary)
 4876:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4877:    //    k: Index of the half-level at which the density is interpolated
 4878:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4879:    // 
 4880:    // Output:
 4881:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4882:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4883: 
 4884:       if (e2 == nullptr || e2->isDry) {
 4885:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4886: 
 4887:          Side *side = e1->sides[j];
 4888:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4889:                  
 4890:          if constexpr(ics == 1) {
 4891:             vec = side->n; // Normal vector to the side
 4892:          } else {
 4893:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4894:             // IMPLEMENT THIS XXXXXX
 4895:             // !replace with xel, yel?
 4896:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4897:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4898:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4899:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4900:          } //ics
 4901:                    
 4902:          diffRho = 0.0;
 4903: 
 4904:       } else { //internal and wet
 4905:          if constexpr(ics==1) {
 4906:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4907: 
 4908:             // Vector from e1 to e2
 4909:             vec = e2->center - e1->center;
 4910: 
 4911:          } else { 
 4912:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4913:             // IMPLEMENT THIS XXXXXX
 4914:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4915:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4916:             //                   alow(j)=xctr2
 4917:             //                   bdia(j)=yctr2
 4918:          } // ics
 4919: 
 4920:          diffRho = rho2 - e1->demeanedDensity(k);
 4921:       }
 4922: 
 4923:    }
 4924: 
 4925:    __global__ void computeDensityCubicSplines(void) {
 4926:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4927: 
 4928:       ELEM(elem);
 4929: 
 4930:       if (elem->isDry) return;
 4931: 
 4932:       const int kb = elem->kb;
 4933: 
 4934:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4935:       if (elem->is2D()) {
 4936:          // In the 2D case, the density is constant at the prism level. 
 4937:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4938:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4939:       } else { //3D
 4940: 
 4941:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4942:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4943:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4944:          ///// XXXX CHECK INDICES!!!!!
 4945:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4946:       } // 2D/3D
 4947: 
 4948:    }
 4949: } // extern "C"
 4950: 
 4951: 
 4952: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4953: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4954: 
 4955:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4956: 
 4957:    const int kb  = elem->kb;
 4958:    const int kb2 = elem2->kb;
 4959: 
 4960:    // z-coordinate of prism of elem
 4961:    const double zp = elem->z_prism(k);
 4962: 
 4963:    double rho = 0.0;
 4964: 
 4965:    if (elem2->is2D()) {
 4966:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4967: 
 4968:    } else {  // 3D
 4969: 
 4970:       // eta_min may be < zmax
 4971:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4972:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4973: 
 4974:       // (Extrapolate density below bottom, we will fix it later)
 4975:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4976:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4977:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4978:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4979:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4980:    } // 2D/3D
 4981:      
 4982: 
 4983:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4984:    // Now we need to fix it.
 4985:    if (elem->z[k] < elem2->z[kb2]) {
 4986:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4987: 
 4988:       // There are two methods to adjust the density at the bottom of the element.
 4989:       // iunder_deep=0: 
 4990:       const double depth1 = abs(elem->z[kb]); // larger depth
 4991: 
 4992:       if (iunder_deep==0) {
 4993: 
 4994:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4995: 
 4996:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4997: 
 4998:       } else { // iunder_deep != 0
 4999: 
 5000:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5001: 
 5002:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5003: 
 5004:          //   Demeaned density at the same z coordinate as
 5005:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5006:          }
 5007: 
 5008:       } // if iunder_deep
 5009:    } // if elem->z[kb] < elem2->z[kb]
 5010: 
 5011:    return rho;
 5012: }
 5013: 
 5014: 
 5015: extern "C" {
 5016:    __global__ void computeDensityGradient(void) {
 5017: 
 5018:       if constexpr(ibc != 0) return;
 5019: 
 5020:          // Compute the horizontal density gradient at each element.
 5021:       // It works in two steps:
 5022:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5023:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5024:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5025:       //             gradRho.r1 = rho1 - rho0
 5026:       //             gradRho.r2 = rho2 - rho0
 5027:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5028:       // 
 5029:       //  NOTE: We use de-meaned densities.
 5030: 
 5031:       ELEM(elem);
 5032: 
 5033:       if (elem->isDry) return;
 5034: 
 5035:       const int kb  = elem->kb;
 5036:       const int i34 = elem->i34;
 5037: 
 5038:       for (int k = kb + 1; k < nvrt; k++) {
 5039:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5040:          //             gradRho.r1 = rho1 - rho0
 5041:          //             gradRho.r2 = rho2 - rho0
 5042:          int icount = 0;
 5043:          double sumRx = 0.0;
 5044:          double sumRy = 0.0;
 5045:          for (int j1=0; j1<i34; j1++) { 
 5046: 
 5047:             const int j2 = elem->nxq(j1 + 1);
 5048: 
 5049:             // Pairs of consecutive neighbor elements of elem
 5050:             const Element *e1 = elem->nghbElems[j1];
 5051:             const Element *e2 = elem->nghbElems[j2];
 5052: 
 5053:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5054:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5055:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5056: 
 5057:             // Compute the density difference and the vector from elem to e1 and e2
 5058:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5059:             double diffRho1, diffRho2;
 5060:             Vector2 vec1, vec2;
 5061:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5062:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5063: 
 5064:             const double rl1 = length(vec1);
 5065:             const double rl2 = length(vec2);
 5066:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5067: 
 5068:             const double delta = cross(vec1, vec2);
 5069:             const double sintheta = abs(delta)/(rl1*rl2);
 5070: 
 5071:             // To avoid problems, avoid elements with small angle between vectors
 5072:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5073:             const bool validEq = (sintheta > sin_one_deg);
 5074: 
 5075:             if (validEq) {
 5076:                // Solve the system of equations to get the density gradient at elem
 5077:                icount++;
 5078:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5079:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5080:                sumRx += Rx;
 5081:                sumRy += Ry;
 5082:             }
 5083:          } // for j1
 5084: 
 5085:          // Compute the average density gradient at elem
 5086:          if (icount==0) {
 5087:            // Bad mesh quality; bail out with 0 b-cc
 5088:            elem->gradRho[k] = {0.0, 0.0};
 5089:          } else {
 5090:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5091:          }
 5092: 
 5093:       } // for k
 5094: 
 5095:    }
 5096: 
 5097:    __global__ void computeBaroclinicTerm(void) {
 5098:    // Computes the baroclinic term at sides (at half levels).
 5099:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5100:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5101: 
 5102:       if (ibc == 1) return;
 5103: 
 5104:       SIDE(side);
 5105: 
 5106:       if (side->isDry) return;
 5107: 
 5108:       const Element *e1 = side->elems[0];
 5109:       const Element *e2 = side->elems[1];      
 5110:       const int kb = side->kb;
 5111:       
 5112:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5113: 
 5114:       // interpolates vertically the density gradient of the two elements at the half level/
 5115: 
 5116:       int k1 = max(kb, nvrt / 2);
 5117:       int k2 = max(kb, nvrt / 2);
 5118: 
 5119:       // Starts the integration at the surface and goes down to the bottom
 5120:       side->bcc[nvrt-1] = {0.0, 0.0};
 5121:       for (int k = nvrt - 2; k >= kb; k--) {
 5122:       // For each prism level (from surface to bottom)...
 5123: 
 5124:          // For both elements, interpolate density gradient at the side's half level.
 5125:          // The gradient at the side is the average of the gradients at the elements.
 5126:          // w1, w2 are used to take into account boundary sides, with just one element.
 5127:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5128:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5129:          const double wsum = w1 + w2;
 5130:          w1 = w1/wsum;
 5131:          w2 = w2/wsum;
 5132:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5133: 
 5134:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5135:          Vector2 gradRho = {0.0, 0.0};
 5136:          if (e1 != nullptr && k > kb) {
 5137:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5138:             
 5139:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5140:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5141:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5142: 
 5143:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5144:          }      
 5145:          if (e2 != nullptr && k > kb) {
 5146:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5147:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5148:             
 5149:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5150:          }
 5151: 
 5152:          if constexpr(ics==2) {
 5153:             assert(false && "Not implemented: ics == 2");
 5154:             // IMPLEMENT THIS XXXXXX
 5155:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5156:             // swild(1)=tmp1
 5157:             // swild(2)=tmp2
 5158:          }
 5159:          
 5160:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5161:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5162:          // CHECK INDICES!!! XXX
 5163:          const double grav3 = side->grav3();
 5164:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5165: 
 5166:       } // for
 5167: 
 5168:    }
 5169: 
 5170: 
 5171: 
 5172:    __global__ void computeHorGradientAtSide(void) {
 5173: 
 5174:       // Compute the horizontal density gradient at each element.
 5175:       // It works in two steps:
 5176:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5177:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5178:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5179:       //             gradRho.r1 = rho1 - rho0
 5180:       //             gradRho.r2 = rho2 - rho0
 5181:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5182:       // 
 5183:       //  NOTE: We use de-meaned densities.
 5184: 
 5185:       SIDE(side);
 5186: 
 5187: 
 5188:       if (side->isDry) return;
 5189: 
 5190:       // Computes the gradient of the variables at the side center.
 5191:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5192:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5193:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5194: 
 5195:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5196:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5197:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5198:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5199: 
 5200:    }
 5201: 
 5202: 
 5203:    __global__ void solveMomentumEquations(double time) {
 5204: 
 5205:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5206:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5207: 
 5208:       SIDE(side);
 5209: 
 5210:       if (side->isDry) 
 5211:       {
 5212:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5213: 
 5214:          return;
 5215:       }
 5216: 
 5217:       const Node *n1 = side->n1;
 5218:       const Node *n2 = side->n2;
 5219: 
 5220:       const int kb = side->kb;
 5221: 
 5222:       const double veg_h = side->veg_h();
 5223:       const double grav3 = side->grav3();
 5224: 
 5225:       if (side->is2D()) {
 5226:          // Warning: Do not use htot2, which is updated.
 5227:          const double htot = side->htot1();
 5228:          const double hhat = side->hhat;
 5229: 
 5230:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5231: 
 5232:          Vector2 tau2 = {0.0, 0.0};
 5233:           
 5234:          if constexpr(ics==1) {
 5235:             tau2 = side->tau();
 5236: 
 5237:          } else {
 5238:             assert(false && "Not implemented: ics == 2");
 5239:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5240:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5241:             // taux2=(vn1+tt1)*0.5d0
 5242:             // tauy2=(vn2+ss1)*0.5d0
 5243:          } // if ics         
 5244: 
 5245:          // hat_gam has units of m/s
 5246: 
 5247:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5248: 
 5249:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5250:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5251: 
 5252:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5253: 
 5254: 
 5255:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5256: 
 5257:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5258: 
 5259:       }
 5260:       else { // 3D
 5261: 
 5262:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5263:          // 
 5264:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5265:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5266:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5267:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5268:          // k+1 and k.
 5269: 
 5270: 
 5271:          const int ndim = nvrt - kb;
 5272:          const double zTopCanopy = side->zTopCanopy();
 5273: 
 5274:          // Initialize the tridiagonal system
 5275:          for (int k = kb + 1; k < nvrt; k++) {
 5276:             
 5277:             const int kin = k - (kb + 1);
 5278: 
 5279:             // Vertical viscosity at the face center
 5280:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5281: 
 5282:  
 5283:             alow[kin] = 0.0;
 5284:             cupp[kin] = 0.0;
 5285:             bdia[kin] = 0.0;
 5286: 
 5287:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5288:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5289: 
 5290:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5291:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5292:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5293: 
 5294:             // First part: layers k, k+1
 5295:             if (k < nvrt - 1) {
 5296:                              
 5297:                if constexpr(iveg != 0) {
 5298: 
 5299:                   // If there is vegetation at this level...
 5300:                   if (zTopCanopy > side->zc[k]) {
 5301:                      // If the canopy is above the k layer...
 5302:                      
 5303:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5304:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5305:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5306:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5307: 
 5308:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5309:                      const double vmag2 = length(ut2);
 5310:                      const double vmag1 = length(side->u2[k]);
 5311:                      const double vmag = 0.5*(vmag1 + vmag2);
 5312:                      
 5313:                      // Computes the vegetation alpha at the face center
 5314:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5315: 
 5316:                      cff1 += veg_alpha_sd*dt*vmag;
 5317: 
 5318:                   } // if (zTopCanopy
 5319:                } // if iveg
 5320: 
 5321:                const double dzz = side->Dz(k + 1);
 5322:                const double tmp = dt*dfz/dzz;
 5323:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5324: 
 5325:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5326:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5327:             }
 5328: 
 5329: 
 5330:             // Second part: layers k-1, k
 5331:             if (k > kb + 1) {
 5332: 
 5333:                double cff1 = 1.0; //init \bar{c^k}
 5334: 
 5335:                if constexpr(iveg != 0) {
 5336:                   // If there is vegetation at this level...
 5337:                   if (zTopCanopy > side->zc[k-1]) {
 5338:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5339:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5340: 
 5341:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5342: 
 5343:                      const double vmag2 = length(ut2);
 5344:                      const double vmag1 = length(side->u2[k-1]);
 5345:                      const double vmag = 0.5*(vmag1 + vmag2);
 5346: 
 5347:                      // Computes the vegetation alpha at the face center
 5348:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5349:                      cff1 += veg_alpha_sd*dt*vmag;
 5350:                   } // if zTopCanopy
 5351: 
 5352:                } // if iveg
 5353: 
 5354:                const double dzz = side->Dz(k);
 5355:                const double tmp = dt*dfz/dzz;
 5356:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5357: 
 5358:                alow[kin] += cff1*dzz/6.0 - tmp;
 5359:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5360: 
 5361:             } else { // Bottom boundary
 5362:                // This occurs at the bottom, where the bottom drag is applied.
 5363: 
 5364:                bdia[kin] += dt*side->chi2; // XXXX
 5365: 
 5366:             } // if (k > kb + 1)
 5367: 
 5368: 
 5369:          } // for (int k
 5370: 
 5371: 
 5372: 
 5373:          // Computes the RHS.
 5374:          // -----------------
 5375: 
 5376:          //	BC to be imposed at the end.
 5377: 
 5378:          const Vector2 gradETP  = side->gradETP;
 5379:          const Vector2 gradPr   = side->gradPr;
 5380:          const Vector2 gradEta1 = side->gradEta1;
 5381:          const Vector2 gradEta2 = side->gradEta2;
 5382: 
 5383:          const Vector2 *btu = side->btu;
 5384:          const Vector2 *u2  = side->u2;
 5385:          const double coriolis = side->coriolis;
 5386:          const Vector2 *nuGradU = side->nuGradU;
 5387: 
 5388: 
 5389:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5390: 
 5391:          for (int k = kb + 1; k < nvrt; k++) {
 5392:             const int kin = k - kb - 1;
 5393: 
 5394:             const double dz_0 = side->Dz(k);
 5395:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5396: 
 5397:             rrhs[kin] = {0.0, 0.0};
 5398:             double dz = 0.0;
 5399: 
 5400:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5401:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5402:             if (k < nvrt  ) dz += dz_1;
 5403:             if (k > kb + 1) dz += dz_0;
 5404: 
 5405:             // Elevation gradient, atmospheric pressure and tidal potential
 5406:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5407: 
 5408:             // Coriolis, advection, wind stress, and horizontal viscosity
 5409:             if (k < nvrt - 1) {
 5410: 
 5411: 
 5412:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5413:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5414:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5415:                                                 
 5416: 
 5417:                //diff stress tensors 1006
 5418:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5419:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5420:                   assert(false && "Not implemented: itur == 5");
 5421:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5422:                }
 5423:                // else assert(false && "itur # Not implemented");
 5424: 
 5425:             } else { // k == nvrt - 1 SURFACE
 5426:                Vector2 tau2 = {0.0, 0.0};
 5427:                if constexpr(ics==1) {
 5428:                   tau2 = side->tau();
 5429:       
 5430:                } else {
 5431:                   assert(false && "Not implemented: ics == 2");
 5432:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5433:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5434:                   // taux2=(vn1+tt1)*0.5d0
 5435:                   // tauy2=(vn2+ss1)*0.5d0
 5436:                } // if ics
 5437: 
 5438:                rrhs[kin] += dt*tau2;
 5439:           
 5440: 
 5441:             } // if k<nvrt
 5442: 
 5443: 
 5444:             if (k > kb + 1) {
 5445:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5446:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5447:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5448: 
 5449:                // diff stress tensors 1006
 5450:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5451:                   assert(false && "Not implemented: itur == 5");
 5452:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5453:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5454:                }
 5455:                // else assert(false && "itur # Not implemented");
 5456: 
 5457: 
 5458:             } // if k>kbs + 1
 5459: 
 5460:             // Baroclinic
 5461:             Vector2 *bcc = side->bcc;
 5462:             if constexpr(ibc == 0) {
 5463:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5464:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5465: 
 5466:             } // if ibc==0
 5467: 
 5468:          } // k=kb + 1,nvrt
 5469: 
 5470: 
 5471:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5472: 
 5473:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5474:             const int kin = k - kb - 1;
 5475:    
 5476:             // Velocity is always clamped to maximum values
 5477:             side->u2[k] = clampVelocity(soln[kin]);
 5478:          } // k
 5479: 
 5480:       } // if side->is2D()
 5481:       
 5482: 
 5483:       // Impose velocity boundary condition at the bottom
 5484:       if constexpr(imm == 2) { // 3D bed deformation model
 5485:          double dep;
 5486:          Vector2 vel;
 5487: 
 5488:          assert(false && "Not implemented: imm == 2");
 5489:          //update_bdef(time, x0, y0, dep, vel);
 5490:          // side->u2[kb] = vel;
 5491: 
 5492:       } else { // imm = 0 or 1
 5493:          if (side->Cd() == 0.0) {
 5494:             side->u2[kb] = side->u2[kb + 1];
 5495: 
 5496:          } else if (side->is3D()) { // 3D no slip bottom   
 5497:             side->u2[kb] = {0.0, 0.0};
 5498:          }
 5499:           
 5500:       } // if imm
 5501: 
 5502:       // The velocities below the bottom level are set to zero
 5503:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5504: 
 5505: 
 5506:    }
 5507: 
 5508: 
 5509:    __global__ void applyMomentumBC(void) {
 5510: 
 5511:       SIDE_BND(sideBnd);
 5512: 
 5513:       Side *side = sideBnd->side;
 5514:       const BoundarySegment *segment = sideBnd->segment;
 5515:       const Node *n1 = side->n1;
 5516:       const Node *n2 = side->n2;
 5517: 
 5518:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5519: 
 5520:       const bool isLand = segment->isLand;
 5521:       const int ifltype = segment->ifltype;
 5522: 
 5523:       const int kb = side->kb;
 5524: 
 5525: 
 5526:       if (!isLand && ifltype != 0) {
 5527:          const Vector2 *ubc = sideBnd->ubc;
 5528:   
 5529:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5530:             
 5531:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5532:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5533: 
 5534:             if (ifltype == -1) {
 5535:                // Flather 1
 5536: 
 5537:                const double depth = side->depth();
 5538: 
 5539:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5540: 
 5541:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5542: 
 5543:                side->u2[k] = vnorm*side->n;
 5544: 
 5545:             } else if (ifltype == -2) { // Discharge
 5546: 
 5547:                const double eta1 = side->eta1();
 5548:                const double eta2 = side->eta2();
 5549:                const double htot = side->htot2();
 5550: 
 5551:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5552:                assert(false && "Not implemented: Discharge bc");
 5553:                // const double dischrg = discharge(eta1);
 5554:                const double dischrg = 0.0; // XXX REMOVE
 5555:                
 5556: 
 5557:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5558: 
 5559:                const double vnorm = dischrg*eta2/htot;
 5560: 
 5561:                side->u2[k] = vnorm*side->n;
 5562: 
 5563:             }
 5564:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5565:                const double vnorm = dot(side->u2[k], side->n);
 5566: 
 5567:                double rat;
 5568:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5569:                else              rat = segment->vobc2; // outgoing
 5570: 
 5571:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5572: 
 5573:             }
 5574:             else { // not Flather or 3D radiation
 5575:                side->u2[k] = ubc[k];
 5576: 
 5577:             } // if (segment->ifltype...
 5578: 
 5579:          }
 5580: 
 5581:       }
 5582:       else if (isLand) { // if it is land boundary side
 5583: 
 5584:          if constexpr(islip == 0) { // free slip
 5585: 
 5586:             for (int k = kb; k < nvrt; k++) {
 5587: 
 5588:                const Vector2 t = side->t();
 5589:                const Vector2 n = side->n;
 5590: 
 5591:                double vnorm = 0.0; // for most cases
 5592:                const double vtan = dot(side->u2[k], t);
 5593:                
 5594:                side->u2[k] = vtan*t - vnorm*n;
 5595: 
 5596:             }
 5597: 
 5598:          } else { // no slip
 5599:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5600: 
 5601:          }
 5602:       } // if (side segment type...
 5603: 
 5604:    
 5605: 
 5606:    }
 5607: 
 5608: 
 5609:    __global__ void shapiroFilter1(void) {
 5610:       // First step of the Shapiro filter (normally used if indvel<=0)
 5611:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5612: 
 5613:       SIDE(side);
 5614: 
 5615:       // Only internal wet sides are processed
 5616:       if (side->isDry || !(side->isInternal())) return;
 5617: 
 5618:       const int kb = side->kb;
 5619: 
 5620:       for (int mm = 0; mm < niter_shap; mm++) {
 5621: 
 5622:          for (int k = kb + 1; k < nvrt; k++) {
 5623:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5624:             Vector2 suru = {0.0, 0.0};
 5625: 
 5626:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5627: 
 5628:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5629: 
 5630:                int kin = k;
 5631:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5632:                
 5633:                if constexpr(ics==1) {
 5634:                   suru += nSide->u2[kin];
 5635: 
 5636:                } else {
 5637:                   assert(false && "Not implemented: ics == 2");
 5638:                   // Vector2 vn1, vn2;
 5639:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5640:                   // suru=suru+vn1;
 5641:                   // surv=surv+vn2;
 5642:                }
 5643:             }
 5644: 
 5645:             // Reusing bcc as a temporary array to store the suru values.
 5646:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5647: 
 5648:          }
 5649:       }
 5650:    }
 5651: 
 5652:    __global__ void shapiroFilter2(void) {
 5653:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5654: 
 5655:       SIDE(side);
 5656: 
 5657: 
 5658:       if (side->isDry || !(side->isInternal())) return;
 5659: 
 5660:       const int kb = side->kb;
 5661: 
 5662:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5663: 
 5664:       if (side->is2D()) {
 5665:          side->u2[kb + 1] = side->bcc[kb + 1];
 5666:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5667: 
 5668:       } else {
 5669:          // 3D
 5670:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5671:          
 5672:       }
 5673: 
 5674:    }
 5675: 
 5676: 
 5677:    __global__ void ul0UpdateZCoords(void) {
 5678:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5679:       
 5680:       NODE(node);      
 5681: 
 5682: 
 5683:       if (false) {//node->isDry) {  //XXXXXXXXXXXXXXXXX
 5684: 
 5685:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5686: 
 5687:          if constexpr(ivcor != 1) node->kb = 0;
 5688: 
 5689:       } else {
 5690: 
 5691:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5692:          node->updateKb();
 5693: 
 5694:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5695: 
 5696:       }
 5697: 
 5698:       // We use the temp.b field to store the previous state of isDry.
 5699:       node->tmp.b = node->isDry;
 5700: 
 5701:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5702:       node->isDry = true;
 5703: 
 5704:    }
 5705: 
 5706:    __global__ void ul0ComputeDryElements(void)
 5707:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5708:    {
 5709:       ELEM(elem);
 5710: 
 5711:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5712: 
 5713:       elem->kb = 0;
 5714: 
 5715:       if (elem->isDry) return;
 5716: 
 5717: 
 5718:    //    if(elem->isDry2()) { // XXXX
 5719:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5720:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5721:    //        call parallel_abort(errmsg)
 5722:    //    }
 5723: 
 5724:       const Node *n1 = elem->nodes[0];
 5725:       const Node *n2 = elem->nodes[1];
 5726:       const Node *n3 = elem->nodes[2];  
 5727:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5728: 
 5729:       // Computes element's kb as the minimum of the nodes' kb.
 5730:       const int kb1 = n1->kb;
 5731:       const int kb2 = n2->kb;
 5732:       const int kb3 = n3->kb;
 5733:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5734: 
 5735: 
 5736:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5737: 
 5738: 
 5739:       // Computes the element z as the mean of the nodes z.
 5740:       for (int k = elem->kb; k < nvrt; k++) {
 5741: 
 5742:          // Compute the element z as the mean of the nodes z.
 5743:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5744:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5745:          elem->z[k] /= elem->i34;
 5746: 
 5747:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5748:       }
 5749:                   
 5750:    }
 5751: 
 5752:    __global__ void ul0ComputeDryNodes(void)
 5753:    // Updates node's isDry based on the elements' isDry. 
 5754:    {
 5755:       NODE(node);
 5756: 
 5757:       node->isDry = true;
 5758: 
 5759:       // A node is wet if at least one of the elements sharing it is wet.
 5760:       for (int j = 0; j < node->numElements; j++) {
 5761:          const Element *elem = node->elements[j];
 5762:          if (!elem->isDry) {
 5763:             node->isDry = false;
 5764:             break;
 5765:          }
 5766:       }
 5767: 
 5768:        
 5769:    }
 5770: 
 5771: 
 5772:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5773:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5774:    // node->tmp.b is true if the node was previously dry.
 5775:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5776:    {
 5777:       NODE(node);
 5778:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5779: 
 5780:       // Avoid this the first time step.
 5781:       if (it == iths) return;  
 5782: 
 5783:       const bool wasDry = node->tmp.b;
 5784: 
 5785: if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5786: 
 5787:       // assert(node->isDry == node->isDry2() && "These two must be identical at this point"); XXXXX 
 5788:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5789: 
 5790:          for (int k=0; k < nvrt; k++) {
 5791: 
 5792:             Vector3 utmp={0.0, 0.0, 0.0};
 5793: 
 5794:             double ttmp=0.0;
 5795:             double stmp=0.0;
 5796:             int icount=0;
 5797:             for (int j = 0; j < node->numNodes; j++) {
 5798: 
 5799:                const Node *nbrNode = node->nodes[j];
 5800:                
 5801:                const bool wasNbrDry = nbrNode->tmp.b;
 5802: 
 5803:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5804:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5805: 
 5806:                   icount++;
 5807: 
 5808:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5809:                   utmp += nbrNode->uvw2(k);
 5810:                   
 5811:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5812:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5813:                }
 5814:             }
 5815: 
 5816:             if (icount > 0) {
 5817:                const double inv_icount = 1.0/icount;
 5818:                utmp = inv_icount*utmp;
 5819:                node->u2[k]     = toVector2(utmp);
 5820:                node->w2[k]     = utmp.z;
 5821:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5822:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5823:             } else {
 5824:                node->u2[k] = {0.0, 0.0};
 5825:                node->w2[k] = 0.0;
 5826:                // Initialize tracers to 0.0??? XXXXX
 5827:             }
 5828:          }
 5829:       }
 5830:    }
 5831: 
 5832:   
 5833:    
 5834: 
 5835: 
 5836:    __global__ void ul0UpdateSides(int it, int iths) {
 5837:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5838:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5839:    // The dryness of the sides is updated in ul0UpdateSides2.
 5840: 
 5841:       SIDE(side);
 5842: 
 5843:       // A side is wet if and only if at least one of its elements is wet.
 5844:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5845:  
 5846:       const Node *n1 = side->n1;
 5847:       const Node *n2 = side->n2;
 5848:      
 5849:       const int kb1 = n1->kb;
 5850:       const int kb2 = n2->kb;
 5851: 
 5852:       side->kb = 0; // default when dry
 5853: 
 5854:       if (isWet) {
 5855: 
 5856:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5857: 
 5858:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5859: 
 5860:          side->kb = min(kb1, kb2);
 5861: 
 5862:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5863: 
 5864:          for (int k = side->kb; k < nvrt; k++) {
 5865:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5866: 
 5867:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5868: 
 5869:             // Compute velocity for re-wetted sides 
 5870:             if ((it != iths) && (side->isDry && isWet)) {
 5871: 
 5872:                Vector2 utmp={0.0, 0.0};
 5873: 
 5874:                int icount=0;
 5875: 
 5876:                // For all the sides on the two elements that share this side
 5877:                for (int j = 0; j < 2; j++) {
 5878:                   const Element *elem = side->elems[j];
 5879:                   if (elem == nullptr) continue;
 5880: 
 5881:                   for (int jj=0; jj < elem->i34; jj++) {
 5882:                      const Side *nSide = elem->sides[jj];
 5883:                      if (nSide->isDry) continue;
 5884: 
 5885:                      icount++;
 5886:                      utmp += nSide->u2[k];  
 5887:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5888:                   }
 5889:                }
 5890:                   
 5891:                // assert(icount > 0 && "No wet sides around this side");  XXXXX RECOVER??? 
 5892:                if (icount > 0)  side->u2[k] = utmp/icount;
 5893:                else             side->u2[k] = {0.0, 0.0};
 5894:                   
 5895:             } // if ((it != iths) && (side->isDry && isWet))
 5896: 
 5897:          } // for k
 5898: 
 5899:       } // if isWet 
 5900:       
 5901: 
 5902: 
 5903:    }
 5904: 
 5905:    __global__ void ul0UpdateSides2(void) {
 5906:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5907:    
 5908:          SIDE(side);
 5909:    
 5910:          const Element *e1 = side->elems[0];
 5911:          const Element *e2 = side->elems[1];
 5912: 
 5913:          // A side is wet if and only if at least one of its elements is wet.
 5914:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5915: 
 5916:          // Update the side's dryness
 5917:          side->isDry = !isWet;
 5918: 
 5919: // if (side->isDry) {for (int k = 0; k < nvrt; k++) {side->u2[k] = {0.0, 0.0};side->w2[k] = 0.0;}}  // XXXX KKKKKK Not in the original code
 5920: 
 5921:    }
 5922: 
 5923: 
 5924:    __global__ void zeroNodalVelocities(void) {
 5925:       NODE(node);
 5926: 
 5927:       for (int k = 0; k < nvrt; k++) {
 5928:          node->u2[k]   = {0.0, 0.0};
 5929:          node->w2[k]   = 0.0;
 5930:          node->utmp[k] = {0.0, 0.0};
 5931:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5932:       }
 5933:    }
 5934: 
 5935:  
 5936: 
 5937:    __global__ void computeNodalVerticalVelocities1(void) {
 5938:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5939:    // Adds the element's vertical velocity times the element's area.
 5940:       ELEM(elem);
 5941: 
 5942:       for (int j = 0; j < elem->i34; j++) {
 5943:          Node *node = elem->nodes[j];
 5944: 
 5945:          for (int k = node->kb; k < nvrt; k++) {
 5946:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5947:          }
 5948:          atomicAdd(&(node->tmp.d), elem->area);
 5949:       }
 5950:    }
 5951: 
 5952:    __global__ void computeNodalVerticalVelocities2(void) {
 5953:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5954:    // Divides by the total area of the elements sharing the    node.
 5955:       NODE(node);
 5956: 
 5957:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5958: 
 5959:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 5960:    }
 5961: 
 5962: 
 5963:    __global__ void computeNodalHorizontalVelocities1(void) {
 5964: 
 5965:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5966:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5967: 
 5968:       ELEM(elem);
 5969: 
 5970:       if (elem->isDry) return;
 5971: 
 5972:       const int kb = elem->kb;
 5973:       const bool isTri = elem->isTri();
 5974: 
 5975:       if constexpr(indvel <= 0) {
 5976:          // Assuming discontinous hvel.
 5977: 
 5978:          if (isTri) { // For triangles
 5979:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5980:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5981: 
 5982:             for (int j = 0; j < 3; j++) {
 5983:                // For every node of the triangle...
 5984:                Node *node = elem->nodes[j];
 5985: 
 5986:                if (node->isDry) continue;
 5987: 
 5988:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 5989:                const Side *s2 = elem->sides[(j + 1) % 3];
 5990:                const Side *s3 = elem->sides[(j + 2) % 3];
 5991: 
 5992: 
 5993:                atomicAdd(&(node->tmp.i), 1);
 5994: 
 5995:                for (int k = kb; k < nvrt; k++)  {
 5996:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at node j.   XXXX Function for clamping velocities. const vector2 u
 5997:                   u = clampVelocity(u);
 5998:                   atomicAdd(&(node->utmp[k].x), u.x);
 5999:                   atomicAdd(&(node->utmp[k].y), u.y);
 6000: 
 6001:                }
 6002: 
 6003:             }
 6004:          }
 6005:          else { // For quads
 6006:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6007: 
 6008:          }
 6009: 
 6010:       }
 6011:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6012:       
 6013:    }
 6014: 
 6015: 
 6016:    __global__ void computeNodalHorizontalVelocities2(void) {
 6017:       NODE(node);
 6018: 
 6019:       const int nodeCount = node->tmp.i;
 6020: 
 6021:       if (nodeCount == 0) 
 6022:       {
 6023:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6024:          return;
 6025:       }
 6026: 
 6027:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6028:       
 6029:       const int kb = node->kb;
 6030: 
 6031:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6032:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6033:       
 6034:       
 6035:    }   
 6036: 
 6037:  
 6038: 
 6039:    __global__ void resetVelocityOpenBndNodes(void) {
 6040:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6041: 
 6042:       NODE_BND(nodebnd);
 6043: 
 6044:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6045:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6046:       }
 6047: 
 6048:    }
 6049: 
 6050: 
 6051:    __global__ void setVelocityOpenBndNodes(void) {
 6052:    // For open boundary nodes sets their velocity to the imposed values.
 6053: 
 6054:       SIDE_BND(sidebnd);
 6055: 
 6056:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6057:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6058:          // to its segment to the average of the side velocity.
 6059: 
 6060:          for (int k = 0; k < nvrt; k++) {
 6061:             Node *n1 = sidebnd->side->n1;
 6062:             Node *n2 = sidebnd->side->n2;
 6063: 
 6064: 
 6065:             Vector2 n1_u2(n1->u2[k]);
 6066:             Vector2 n2_u2(n2->u2[k]);
 6067: 
 6068:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6069:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6070:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6071:             }
 6072:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6073:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6074:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6075:             }
 6076: 
 6077:          }
 6078: 
 6079:       }
 6080: 
 6081:    }
 6082: 
 6083: 
 6084:    __global__ void computeVerticalVelocity(void) {
 6085:       // Computes the vertical velocity at the (2D) element's centroid.
 6086:       // In this function we will be considering volumetric elements, with side faces and a 
 6087:       // bottom and a top face. We will call them SFs, BF and TF.
 6088:       // It computes the flux coming from BF and the SFs.
 6089:       // If the bed is moving, it takes that into account.
 6090:       // Since water is incompressible, the integral of the velocity times the normal vector
 6091:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6092:       // and the BF is equal to the flux going out from the TF.
 6093:       // TF = - BF - sum(SFs).
 6094:       // It then computes the horizontal velocity at the center of TF.
 6095:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6096:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6097:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6098: 
 6099:       ELEM(elem);
 6100: 
 6101:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6102: 
 6103:       if (elem->isDry) return;
 6104: 
 6105:       const int kb = elem->kb;
 6106:       const bool isTri = elem->isTri();
 6107: 
 6108:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6109: 
 6110:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6111:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6112:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6113: 
 6114:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6115: 
 6116:       double area3D;
 6117: 
 6118:       // Bottom face flux
 6119:       double bottomFlux = 0.0;
 6120:       Vector2 u2meanBottom = {0.0, 0.0};
 6121:       const Vector2 gradh = elem->grad2(&Node::depth);
 6122:       if constexpr(imm==2) {
 6123:          Vector3 ubed;
 6124: 
 6125:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6126:          // updateBDEF(ubed);
 6127:      
 6128:          // const double bflux0 = dot(ubed, elem_n1);
 6129: 
 6130:          // elem->w[kb] += ubed.z;
 6131:       }
 6132:       else {
 6133:          Vector2 umean;
 6134:          if constexpr(ics == 1) {
 6135:             u2meanBottom = elem->mean(kb, &Side::u2);
 6136:          }
 6137:          else {
 6138:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6139:          }
 6140: 
 6141:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6142:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6143: 
 6144:          bottomFlux = - dot(gradh, u2meanBottom);
 6145:       } // if imm
 6146: 
 6147:       // Compute w for kb+1 to nvrt-1
 6148:       for (int l = kb; l < nvrt - 1; l++) {
 6149: 
 6150:          // normal vector to the top face of the "volumetric" element (3D)
 6151:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6152: 
 6153:          // Compute the total flux at the sides
 6154:          double sideFlux = 0.0;
 6155: 
 6156:          for (int j = 0; j < elem->i34; j++) {
 6157:             const Side *side = elem->sides[j];
 6158: 
 6159:             const double sideArea = side->area(l);
 6160:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6161:             const double sign = elem->ssign[j]; 
 6162: 
 6163:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6164:          }
 6165:          
 6166:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6167:          //velocities at the centers of the sides
 6168:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6169: 
 6170:          // The flx at the top ace can be computed from the other flows.
 6171:          const double topFlux = - sideFlux - bottomFlux;
 6172:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6173: 
 6174:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6175: 
 6176:          elem_n1 = elem_n2;
 6177: 
 6178:          bottomFlux = - topFlux;
 6179:       }
 6180:    }  
 6181: 
 6182: 
 6183: 
 6184: 
 6185: 
 6186: 
 6187: 
 6188: // !===============================================================================
 6189: // !===============================================================================
 6190: 
 6191: } // extern "C"
 6192: 
 6193: #ifdef DONTCOMPILE
 6194: __device__ void computeVerticalAdvection(void) {
 6195:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6196: 
 6197:    sdbt(1:2,:,:)=0.d0
 6198: 
 6199:    const Side *side = FROM kernel;
 6200: 
 6201:    if(side->isDry) return;
 6202: 
 6203:    // If side is wet...
 6204: 
 6205: 
 6206:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6207:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6208:    double ws[nvrt] = {} // w @ side
 6209:    int icount = 0;
 6210:    for (int j=0; j<2; j++) {
 6211:       const Element *elem = side->elements[j];
 6212:        
 6213:       if(elem != nullptr) {
 6214:          icount++;
 6215:          for (int k=0; k<nvrt; k++) {
 6216:             ws[k] = ws[k] + elem->w[k];
 6217:          }
 6218:       }
 6219:    }  // for j
 6220: 
 6221:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6222:    ws = ws/icount;
 6223: 
 6224:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6225:    // Splines allow for a smooth transition between vertical levels.
 6226:    // Splines have continuity restrictions at the internal knots, but
 6227:    // we have to provide the 1st derivatives at the endpoints.
 6228:    const int kbs = side->kbs; 
 6229:    
 6230:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6231:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6232:    initCubicSpline(kbs, nvrt, side, ws, up)
 6233: 
 6234:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6235:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6236:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6237: 
 6238:    // Total advection (average onto side)
 6239:    const Node *node1 = side->nodes[0];
 6240:    const Node *node2 = side->nodes[1];
 6241:    for (int k=kbs(i); k<nvrt; k++) {
 6242: 
 6243:       if constexpr(ics==1) {
 6244:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6245:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6246:       } else {
 6247:          // XXX IMPLEMENT THIS
 6248:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6249:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6250:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6251:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6252:       }  // if ics
 6253: 
 6254: 
 6255:    }
 6256: }
 6257: #endif
 6258: 
 6259: 
 6260: extern "C" {
 6261:    __global__ void computeElemAverageGhat(void) {
 6262:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6263: 
 6264:       ELEM(elem);
 6265:       
 6266:       elem->ghat1= {0.0, 0.0};  
 6267: 
 6268:       if constexpr(ihydraulics != 0) {
 6269:          if (nhtblocks > 0 && elem->isblock) return;
 6270:       }
 6271: 
 6272: 
 6273: 
 6274:       
 6275:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6276:       // tidal potential, horizontal diffusion, and baroclinic etc
 6277:       // Remember to update both fb and F 
 6278:       // If ics=2, ghat1 are in eframe (ll)
 6279:       // cff1-3: coefficients for 2D/3D
 6280:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6281:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6282:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6283: 
 6284:       if (elem->isDry) return;
 6285: 
 6286:       double av_cff1 = 0.0;  // av. for cff1
 6287:       double av_cff2 = 0.0;  // av. for cff2
 6288:       double av_cff3 = 0.0;  // av. for cff3
 6289:       double av_df = 0.0;  // av. for H^\alpha / H
 6290:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6291:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6292: 
 6293:       const int i34 = elem->i34;
 6294:       const int kb = elem->kb;
 6295: 
 6296:       for (int j=0; j<i34; j++) {
 6297:          // For each node and side in the element...
 6298: 
 6299:          const Node *node = elem->nodes[j];
 6300:          const Side *side = elem->sides[j];
 6301: 
 6302:          const double chi      = side->chi;
 6303:          const double veg_c2   = side->veg_c2;
 6304:          const double veg_beta = side->veg_beta;
 6305:          const double veg_h    = side->veg_h();
 6306:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6307: 
 6308:          // Node - const in elem
 6309:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6310:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6311: 
 6312:          if (elem->depth >= tip_dp) {
 6313:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6314:          }
 6315: 
 6316:          
 6317:          const double htot  = side->htot2();        // Total depth at the side
 6318:          const double zctr2 = side->zTopCanopy();  
 6319: 
 6320:          double cff1; 
 6321:          double cff2; 
 6322:          double cff3;   
 6323:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6324:          // coefficients applied to 2D/3D case 
 6325:             cff1 = side->hhat/htot;
 6326:             cff2 = 0.0;
 6327:             cff3 = 0.0;
 6328:          } else { //3D
 6329:             //Init for no-veg case
 6330:             cff1 = 1.0;
 6331:             cff2 = 1.0;
 6332:             cff3 = 0.0;
 6333: 
 6334:             if constexpr(iveg != 0) {
 6335:                // Computes coefficients used with vegetation terms G1, G2
 6336:                // cff1, cff3 are used for the first two terms in G1, G2:
 6337:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6338:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6339:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6340:                if(veg_h < 0.99*htot) { // submergent vegetation
 6341:                   cff1=1;
 6342:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6343:                   cff3 = veg_c;
 6344: 
 6345:                } else { // emergent vegetation
 6346:                   cff1 = 1.0/(1.0 + veg_c2);
 6347:                   cff2 = cff1;
 6348:                   cff3 = 0.0;
 6349: 
 6350:                }
 6351:             } // if iveg
 6352:          } //  2D/3D
 6353: 
 6354:          av_cff1 += cff1/i34;
 6355:          av_cff2 += cff2/i34;
 6356:          av_cff3 += cff3/i34;
 6357:          av_cff2_chi += cff2*chi/i34;
 6358:          av_cff3_chi += cff3*chi/i34;
 6359:          av_df += min(htot, veg_h)/(htot*i34);
 6360: 
 6361: 
 6362:          // btrack values: U^\star, U^{\star\alpha}
 6363:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6364:          Vector2 Ustar       = {0.0, 0.0}; 
 6365:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6366: 
 6367:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6368:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6369:          } else { //3D
 6370:             for (int k = side->kb + 1; k < nvrt; k++) {
 6371:             
 6372:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6373:                Ustar += w2;
 6374: 
 6375:                if constexpr(iveg != 0) {
 6376:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6377:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6378:                        Ustar_alpha += zrat*w2; // XXXX
 6379:                    }
 6380:                }  // if iveg
 6381:             }  // for k
 6382:          }  //2D/3D
 6383:          
 6384: 
 6385:          // Add btrack & surface stress terms to \breve{G} first
 6386:          if constexpr(ics==1) {
 6387: 
 6388:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6389: 
 6390:          } else {
 6391:             assert(false && "computeElemAverageGhat: Not implemented");
 6392:             // XXX IMPLEMENT THIS
 6393:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6394:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6395:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6396:          }  // if ics
 6397: 
 6398:          // Surface and bottom stress terms
 6399:          if constexpr(ics==1) {
 6400:             const Vector2 tau    = side->tau();
 6401:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6402: 
 6403:             // Term for surface and bottom stress
 6404:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6405: 
 6406:          } else {
 6407:             assert(false && "computeElemAverageGhat: Not implemented");
 6408:             // XXX IMPLEMENT THIS
 6409:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6410:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6411:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6412:             // tau_x=(vn1+tt1)/2.d0
 6413:             // tau_y=(vn2+ss1)/2.d0
 6414:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6415:          }  // if ics
 6416: 
 6417:          
 6418: 
 6419:          // All terms in F,F^\alpha,f_b except baroclinic
 6420:          // F, f_b: all explicit terms excluding vegetation 
 6421:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6422:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6423:          const double coriolis = side->coriolis;
 6424:          Vector2 F  =  coriolis*side->U;  // F_x
 6425:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6426:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6427: 
 6428:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6429:             
 6430:             for (int k = side->kb; k < nvrt; k++) {
 6431:                if (zctr2 > side->zc[k-1]) {
 6432:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6433:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6434:                    Fa +=  coriolis*w2*zrat;
 6435:                } // if zctr2
 6436:             } // k
 6437:          } // iveg
 6438: 
 6439:          // Integrate horizontal viscosity force vertically
 6440:          for (int k=side->kb + 1; k<nvrt; k++) {
 6441:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6442: 
 6443:             F += levelHorVisc;
 6444: 
 6445:             // Vegetation term
 6446:             if constexpr(iveg!=0) {
 6447:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6448:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6449:                   Fa += levelHorVisc*zrat;
 6450:                } 
 6451:             } // if iveg
 6452:          } // for k
 6453: 
 6454:          fb += side->nuGradU[side->kb];
 6455: 
 6456:          // Add to ghat1
 6457:          if constexpr(ics==2) {
 6458:             assert(false && "computeElemAverageGhat: Not implemented");
 6459:             // XXX IMPLEMENT THIS
 6460:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6461:             // bigf1=vn1; bigf2=vn2
 6462:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6463:             // botf1=vn1; botf2=vn2
 6464:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6465:             // bigfa1=vn1; bigfa2=vn2
 6466:          } // if ics
 6467: 
 6468:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6469:       } // for j (nodes and sides)
 6470: 
 6471:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6472:          
 6473:       // Finish off terms in F, F^\alpha and f_b
 6474:       const double grav3 = elem->mean(&Node::grav2);
 6475:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6476: 
 6477: 
 6478:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6479:       for (int j=1; j<i34; j++) { 
 6480:          // For each side in the element...
 6481:          const Side *side = elem->sides[j];
 6482:          const double chi = side->chi;
 6483: 
 6484:          const double htot = side->htot2();
 6485:          const double veg_h = side->veg_h();
 6486:          const Vector2 F  = htot*fb;
 6487:          const Vector2 Fa = min(htot, veg_h)*fb;
 6488: 
 6489:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6490:       } // for j
 6491: 
 6492:       //botf1 etc are already in elem frame
 6493:       elem->ghat1 += tmp/i34;
 6494: 
 6495:       // Baroclinic force
 6496:       if constexpr(ibc==0) {
 6497:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6498: 
 6499:          Vector2 Fa = {0.0, 0.0};
 6500:          Vector2 intGradRho = {0.0, 0.0};
 6501:          
 6502:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6503:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6504:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6505: 
 6506:             // \in F [m^2/s/s]
 6507:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6508:          }
 6509: 
 6510:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6511:          const Vector2 F = av_df*Fa; //approx
 6512:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6513: 
 6514:       } // if ibc
 6515: 
 6516: 
 6517: 
 6518:    }
 6519: 
 6520: } // extern "C"
 6521: 
 6522: 
 6523: 
 6524: #ifdef DONTCOMPILE
 6525: __global__ void checkMassConservation(Tracers* sumtr) {
 6526: 
 6527:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6528: 
 6529:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6530: 
 6531:    Element *elem = &(mesh->localElemData[i]);
 6532: 
 6533:    // Skip dry elements
 6534:    if (elem->isDry) return;
 6535: 
 6536:    // Local sum array for this thread
 6537:    double localSum[N_TRACERS] = {0.0};
 6538: 
 6539:    // Sum over vertical levels for this element
 6540:    const int kbe = elem->kbe;
 6541:    const double area = elem->area;
 6542: 
 6543:    for (int k = kbe; k < nvrt; k++) {
 6544:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6545:       
 6546:       // Accumulate tracer mass
 6547:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6548:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6549:       }
 6550:    }
 6551: 
 6552:    //  This function returns per element sums. A reduction must be done on the host side.
 6553: }
 6554: 
 6555: 
 6556: __global__ void transport(void) {
 6557: 
 6558:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6559: 
 6560:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6561: 
 6562:    Element *elem = &(mesh->localElemData[ie]);
 6563: 
 6564:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6565: 
 6566:                for (int m=0; m<ntr; m++) {
 6567:                   for (int k=kbe(ie); k<nvrt; k++) {
 6568:                      // Calculate each polynomial's weight 
 6569:                      wm=0.d0; sum1=0.d0; 
 6570:                      wm1=0.d0; wm2=0.d0; 
 6571:                      for (int i=0; i<elem->nweno2; i++) {
 6572:                   
 6573:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6574:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6575:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6576:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6577:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6578:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6579:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6580:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6581:                      // -----------------Hu and Shu (1999)'s method----------------
 6582:                      b4=b1+b2+b3
 6583: 
 6584: //Error: add PRODUCTION CPP
 6585: #ifdef DEBUG
 6586:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6587:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6588:                     call parallel_abort(errmsg)
 6589:                   }
 6590: #endif
 6591: 
 6592:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6593:                   // !----test-------------- 
 6594:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6595:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6596:                   // !wm(i)=wm1(i)*wm2(i)
 6597:                   // !---------------------- 
 6598:                   sum1=sum1+wm(i)
 6599:                 } // end for i
 6600: 
 6601:                 wm=wm/sum1
 6602: 
 6603:                 for (int j=0; j<elem->i34; j++) {
 6604: 
 6605:                   const Side *side  = elem->sides[j];
 6606:                   const Node *node1 = side->n1;
 6607:                   const Node *node2 = side->n2;
 6608: 
 6609:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6610:                      trsd=0.d0
 6611:                      for (int kk=0; kk<nquad; kk++) {
 6612:                         for (int i=0; i<elem->nweno2; i++) {
 6613:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6614:                         } // end for i   
 6615:                      } // end for kk
 6616:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6617:                   } // outward flux
 6618:                } // end for j=1,i34(ie) ! side
 6619:             }
 6620:          }
 6621:               
 6622: 
 6623: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6624: //             //   calculate each polynomial's weight 
 6625: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6626: //                 wm=0.d0; sum1=0.d0
 6627: //                 do i=1,nweno1(ie) !for each polynomial
 6628: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6629: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6630: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6631: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6632: //                   wm(i)=b2
 6633: //                   sum1=sum1+b2
 6634: //                   !wm(i)=1.d0
 6635: //                   !sum1=sum1+1.d0
 6636: 
 6637: // // Error: PRODUCTION
 6638: // #ifdef DEBUG
 6639: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6640: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6641: //                     call parallel_abort(errmsg)
 6642: //                   endif
 6643: // #endif
 6644: 
 6645: //                 enddo !i
 6646: //                 wm=wm/sum1 !final weight
 6647: 
 6648:                 for (int j=0; j<elem->i34; j++) { // side
 6649:                   const Side *side = elem->sides[j];
 6650:                   const Node *node1 = side->n1;
 6651:                   const Node *node2 = side->n2;
 6652: 
 6653:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6654:                     trsd=0.d0
 6655:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6656:                       for (int i=0; i<elem->nweno1; i++) {
 6657:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6658:                       }
 6659:                     enddo //kk
 6660:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6661:                   } // outward flux
 6662:                 } // end for j=1,i34(ie) ! side
 6663:               } // end for k; ntr 
 6664: 
 6665:             else !simple upwind method
 6666:               do j=1,i34(ie)
 6667:                 jsj=elside(j,ie)
 6668:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6669:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6670:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6671:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6672:                   endif
 6673:                 enddo  !vertical layers
 6674:               enddo !j=1,i34(ie) ! side
 6675:             endif !order of accuracy
 6676: 
 6677:          //  enddo !ie
 6678: // !$OMP     end do
