 1907: 
 1908: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1909:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1910: 
 1911:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1912: 
 1913:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1914:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1915:    // curElement.
 1916: 
 1917:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1918:    // And uses this velocity instead to continue the tracking.
 1919: 
 1920:    // computes the intersection point in cartesian coordinates
 1921:    Point2 intersection = nextSide->p_t(tt);
 1922: 
 1923:    // Nudges the point to the barycenter of the element. 
 1924:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1925:    // next segment intersects the element sides.  
 1926:    curElem->nudgeToBarycenter(intersection);
 1927: 
 1928:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1929:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1930:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1931:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1932: 
 1933:    // If the side is an open boundary, the tangential velocity is zero.
 1934:    if (nextSide->isBnd()) vtan = 0.0;
 1935: 
 1936:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1937:    const double us = vtan*nextSide->t().x;
 1938:    const double vs = vtan*nextSide->t().y;
 1939:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1940: 
 1941:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1942:    const double len2 = norm2(intersection - toPoint2(xt));
 1943:    const double vel2 = dot(u_int, u_int);        
 1944:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1945:    else            dt = 0.0;
 1946: 
 1947:    // The end of this tracking segment is now the intersection point.
 1948:    xt = {intersection.x, intersection.y, zint};
 1949: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1950:    u_int = {us, vs, ws};
 1951:    
 1952: }
 1953: 
 1954: /**
 1955:  * Tracks a particle through elements and vertical levels in the mesh.
 1956:  * 
 1957:  * @param x0,y0,z0     Starting position coordinates
 1958:  * @param xt,yt,zt     Target position coordinates
 1959:  * @param dtb          Time step for tracking
 1960:  * @param uuint,vvint,wwint Initial velocity components
 1961:  * @param nextElem     Starting/resulting element index
 1962:  * 
 1963:  * @return Status code of type trackExitCodes
 1964:  * 
 1965:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1966:  * of the details are different. The idea is that the code requires less branches and is better fit
 1967:  * for GPU execution.
 1968:  * 
 1969:  * The main ideas here are:
 1970:  * - The starting point is expected to be in the starting element.
 1971:  * - The end point is guaranteed to be inside an element.
 1972:  * - since the starting point is inside the element, there are only two cases: 
 1973:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1974:  *     (b) it does not and (xt,yt) is already in the starting element.
 1975:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1976:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1977:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1978:  * - tt1 can be positive or negative. We only consider the positive values.
 1979:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1980:  * - The next intersection will occur at the smallest positive tt1.
 1981:  * - This intersection will be the next (x0,y0) position.
 1982:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1983:  *   of getting stuck in a loop.
 1984:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1985:  *   was found.
 1986:  */
 1987: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1988:                                                        Element *&nextElem, int &jlev, double &dt,
 1989:                                                        const Side *origSide) {
 1990: 
 1991: 
 1992:    if (origSide->idx == 7) {
 1993:       printf("AAAA&&&& origSide->idx = %d, u_int = %f,%f,%f, x0 = %f,%f,%f, xt = %f,%f,%f\n", origSide->idx, u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 1994:    }
 1995:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1996:    // else to do.
 1997:    // If it is, nudges the point to be inside the element.
 1998:    const Element *curElem = nextElem;
 1999:    if (containsPoint(toPoint2(xt), true)) {
 2000: 
 2001:       curElem->interpolateVelocities(xt, u_int);
 2002: addDebugPlot(x0, xt);
 2003:       return true;
 2004:    }
 2005: 
 2006:    Side *side = nullptr;
 2007: 
 2008:    // 1. Initial checks
 2009:    // Verify starting element is valid (wet)
 2010:    assert(!curElem->isDry && "Starting element is dry");
 2011: 
 2012:    // Checks if track has a zero length.
 2013:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2014:    // assert(len2 > 0.0 && "Zero length track"); 
 2015:    
 2016:    const int MAX_ITERATIONS = 1000;
 2017:    
 2018:    double t;
 2019:    Side *nextSide = nullptr;
 2020:    double tIntersect = 1e10;
 2021:    double zint = x0.z;
 2022: 
 2023:    // Horizontal tracking loop
 2024:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2025:    // (x0,y0) is inside the element but the target point is not.
 2026: 
 2027:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2028: 
 2029:    assert(found_intersection && "No intersection found at %d");
 2030: 
 2031:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2032: 
 2033:    // if the tracking segment goes out of water (either dry or edge boundary)
 2034:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2035: 
 2036: addDebugPlot(x0, xt, 0x00A0FF);
 2037: printf("BBBXXXX going out of water\n");
 2038:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2039: addDebugPlot(x0, xt, 0x00A0FF);      
 2040: 
 2041:       nextElem = this;
 2042:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2043:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2044:       return true;    
 2045:    }
 2046: 
 2047: 
 2048:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2049:    int iterations = 0;
 2050:    while (iterations < MAX_ITERATIONS) {
 2051:       iterations++;
 2052: printf("BBBXXXX iterations = %d\n", iterations);      
 2053:       
 2054:       Element *curElem = nextElem;
 2055: 
 2056:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2057: addDebugPlot(x0, xt);
 2058:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2059: 
 2060:       // If we are already in the target element, we are done.
 2061:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2062:       if (!found_intersection) break;
 2063: 
 2064: 
 2065: 
 2066:       // if the tracking segment goes out of water (either dry or edge boundary).
 2067:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2068: addDebugPlot(x0, xt, 0x00A0FF);
 2069: printf("BBBXXXX going out of water\n");
 2070:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2071: addDebugPlot(x0, xt, 0x00A0FF);   
 2072:          nextElem = curElem;
 2073: 
 2074:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2075:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2076:          return true;
 2077:       }
 2078:       
 2079:       // Update position and element for next iteration
 2080:       side = nextSide;
 2081: 
 2082:    }
 2083: 
 2084:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2085: 
 2086:  
 2087:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2088:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2089: addDebugPlot(x0, xt);   
 2090: printf("MMMMMM nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2091:    nextElem->interpolateVelocities(xt, u_int); 
 2092: printf("MMMMMM2 nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2093: 
 2094:    return true;
 2095: }
 2096: 
 2097: 
 2098: __inline__ __device__ double Element::computeSignedArea(void) const {
 2099:    // Compute the area of the element
 2100: 
 2101:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2102: 
 2103:    // In the quad case we need to add the area of the other triangle.
 2104:    if (isQuad()) {
 2105:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2106:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2107:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2108:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2109:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2110:          Error("Negative area found in quad element");
 2111:       }
 2112:       res += ar1;
 2113:    }
 2114: 
 2115:    return res;
 2116: }
 2117: 
 2118: 
 2119: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2120:                                                                 (nodes[1]->isDry2()) ||
 2121:                                                                 (nodes[2]->isDry2()) ||
 2122:                                                                 (i34==4 && nodes[3]->isDry2());
 2123: }
 2124: 
 2125: 
 2126: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2127:    // In boundary sides, the element 1 is nullptr
 2128:    return side->elems[1] == nullptr; 
 2129: }
