 7106: #ifdef DONTCOMPILE
 7107: __device__ void computeVerticalAdvection(void) {
 7108:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7109: 
 7110:    sdbt(1:2,:,:)=0.d0
 7111: 
 7112:    const Side *side = FROM kernel;
 7113: 
 7114:    if(side->isDry) return;
 7115: 
 7116:    // If side is wet...
 7117: 
 7118: 
 7119:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7120:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7121:    double ws[nvrt] = {} // w @ side
 7122:    int icount = 0;
 7123:    for (int j=0; j<2; j++) {
 7124:       const Element *elem = side->elements[j];
 7125:        
 7126:       if(elem != nullptr) {
 7127:          icount++;
 7128:          for (int k=0; k<nvrt; k++) {
 7129:             ws[k] = ws[k] + elem->w[k];
 7130:          }
 7131:       }
 7132:    }  // for j
 7133: 
 7134:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7135:    ws = ws/icount;
 7136: 
 7137:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7138:    // Splines allow for a smooth transition between vertical levels.
 7139:    // Splines have continuity restrictions at the internal knots, but
 7140:    // we have to provide the 1st derivatives at the endpoints.
 7141:    const int kbs = side->kbs; 
 7142:    
 7143:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7144:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7145:    initCubicSpline(kbs, nvrt, side, ws, up)
 7146: 
 7147:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7148:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7149:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7150: 
 7151:    // Total advection (average onto side)
 7152:    const Node *node1 = side->nodes[0];
 7153:    const Node *node2 = side->nodes[1];
 7154:    for (int k=kbs(i); k<nvrt; k++) {
 7155: 
 7156:       if constexpr(ics==1) {
 7157:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 7158:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 7159:       } else {
 7160:          // XXX IMPLEMENT THIS
 7161:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 7162:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 7163:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 7164:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 7165:       }  // if ics
 7166: 
 7167: 
 7168:    }
 7169: }
 7170: #endif
 7171: 
 7172: 
 7173: extern "C" {
 7174:    __global__ void computeElemAverageGhat(void) {
 7175:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7176: 
 7177:       ELEM(elem);
 7178:       
 7179:       elem->ghat1= {0.0, 0.0};  
 7180: 
 7181:       if constexpr(ihydraulics != 0) {
 7182:          if (nhtblocks > 0 && elem->isblock) return;
 7183:       }
 7184: 
 7185:       if (elem->isDry) return;
 7186: 
 7187:       // Wet elements.
 7188:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 7189:       // tidal potential, horizontal diffusion, and baroclinic etc
 7190:       // Remember to update both fb and F 
 7191:       // If ics=2, ghat1 are in eframe (ll)
 7192:       // cff1-3: coefficients for 2D/3D
 7193:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7194:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7195:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 7196: 
 7197:       double av_cff1 = 0.0;  // av. for cff1
 7198:       double av_cff2 = 0.0;  // av. for cff2
 7199:       double av_cff3 = 0.0;  // av. for cff3
 7200:       double av_df = 0.0;  // av. for H^\alpha / H
 7201:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7202:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7203: 
 7204:       const int i34 = elem->i34;
 7205:       const int kb = elem->kb;
 7206: 
 7207:       for (int j=0; j<i34; j++) {
 7208:          // For each node and side in the element...
 7209: 
 7210:          const Node *node = elem->nodes[j];
 7211:          const Side *side = elem->sides[j];
 7212: 
 7213:          const double chi      = side->chi;
 7214:          const double veg_c2   = side->veg_c2;
 7215:          const double veg_beta = side->veg_beta;
 7216:          const double veg_h    = side->veg_h();
 7217:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7218: 
 7219:          // Node - const in elem
 7220:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 7221:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 7222: 
 7223:          if (elem->depth >= tip_dp) {
 7224:            elem->gradETP += node->ETP*elem->gradPhi[j];
 7225:          }
 7226: 
 7227:          
 7228:          const double htot  = side->htot2();        // Total depth at the side
 7229:          const double zctr2 = side->zTopCanopy();  
 7230: 
 7231:          double cff1; 
 7232:          double cff2; 
 7233:          double cff3;   
 7234:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7235:          // coefficients applied to 2D/3D case 
 7236:             cff1 = side->hhat/htot;
 7237:             cff2 = 0.0;
 7238:             cff3 = 0.0;
 7239:          } else { //3D
 7240:             //Init for no-veg case
 7241:             cff1 = 1.0;
 7242:             cff2 = 1.0;
 7243:             cff3 = 0.0;
 7244: 
 7245:             if constexpr(iveg != 0) {
 7246:                // Computes coefficients used with vegetation terms G1, G2
 7247:                // cff1, cff3 are used for the first two terms in G1, G2:
 7248:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7249:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7250:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7251:                if(veg_h < 0.99*htot) { // submergent vegetation
 7252:                   cff1=1;
 7253:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7254:                   cff3 = veg_c;
 7255: 
 7256:                } else { // emergent vegetation
 7257:                   cff1 = 1.0/(1.0 + veg_c2);
 7258:                   cff2 = cff1;
 7259:                   cff3 = 0.0;
 7260: 
 7261:                }
 7262:             } // if iveg
 7263:          } //  2D/3D
 7264: 
 7265:          av_cff1 += cff1/i34;
 7266:          av_cff2 += cff2/i34;
 7267:          av_cff3 += cff3/i34;
 7268:          av_cff2_chi += cff2*chi/i34;
 7269:          av_cff3_chi += cff3*chi/i34;
 7270:          av_df += min(htot, veg_h)/(htot*i34);
 7271: 
 7272: 
 7273:          // btrack values: U^\star, U^{\star\alpha}
 7274:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7275:          Vector2 Ustar       = {0.0, 0.0}; 
 7276:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7277: 
 7278:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7279:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7280:          } else { //3D
 7281:             for (int k = side->kb; k < nvrt; k++) {
 7282:             
 7283:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7284:                Ustar += w2;
 7285: 
 7286:                if constexpr(iveg != 0) {
 7287:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7288:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7289:                        Ustar_alpha += zrat*w2; // XXXX
 7290:                    }
 7291:                }  // if iveg
 7292:             }  // for k
 7293:          }  //2D/3D
 7294:          
 7295: 
 7296:          // Add btrack & surface stress terms to \breve{G} first
 7297:          if constexpr(ics==1) {
 7298: 
 7299:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7300: 
 7301:          } else {
 7302:             // XXX IMPLEMENT THIS
 7303:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7304:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7305:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7306:          }  // if ics
 7307: 
 7308:          // Surface and bottom stress terms
 7309:          if constexpr(ics==1) {
 7310:             const Vector2 tau    = side->tau();
 7311:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7312: 
 7313:             // Term for surface and bottom stress
 7314:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7315: 
 7316:          } else {
 7317:             assert(false && "computeElemAverageGhat: Not implemented");
 7318:             // XXX IMPLEMENT THIS
 7319:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7320:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7321:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7322:             // tau_x=(vn1+tt1)/2.d0
 7323:             // tau_y=(vn2+ss1)/2.d0
 7324:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7325:          }  // if ics
 7326: 
 7327:          
 7328: 
 7329:          // All terms in F,F^\alpha,f_b except baroclinic
 7330:          // F, f_b: all explicit terms excluding vegetation 
 7331:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7332:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7333:          const double coriolis = side->coriolis;
 7334:          Vector2 F  =  coriolis*side->U;  // F_x
 7335:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7336:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7337: 
 7338:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7339:             
 7340:             for (int k = side->kb; k < nvrt; k++) {
 7341:                if (zctr2 > side->zc[k-1]) {
 7342:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7343:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7344:                    Fa +=  coriolis*w2*zrat;
 7345:                } // if zctr2
 7346:             } // k
 7347:          } // iveg
 7348: 
 7349:          // Integrate horizontal viscosity force vertically
 7350:          for (int k=side->kb + 1; k<nvrt; k++) {
 7351:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7352: 
 7353:             F += levelHorVisc;
 7354: 
 7355:             // Vegetation term
 7356:             if constexpr(iveg!=0) {
 7357:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7358:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7359:                   Fa += levelHorVisc*zrat;
 7360:                } 
 7361:             } // if iveg
 7362:          } // for k
 7363: 
 7364:          fb += side->nuGradU[side->kb];
 7365: 
 7366:          // Add to ghat1
 7367:          if constexpr(ics==2) {
 7368:             // XXX IMPLEMENT THIS
 7369:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7370:             // bigf1=vn1; bigf2=vn2
 7371:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7372:             // botf1=vn1; botf2=vn2
 7373:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7374:             // bigfa1=vn1; bigfa2=vn2
 7375:          } // if ics
 7376: 
 7377:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7378:       } // for j (nodes and sides)
 7379: 
 7380:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7381:          
 7382:       // Finish off terms in F, F^\alpha and f_b
 7383:       const double grav3 = elem->mean(&Node::grav2);
 7384:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7385: 
 7386: 
 7387:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7388:       for (int j=1; j<i34; j++) { 
 7389:          // For each side in the element...
 7390:          const Side *side = elem->sides[j];
 7391:          const double chi = side->chi;
 7392: 
 7393:          const double htot = side->htot2();
 7394:          const double veg_h = side->veg_h();
 7395:          const Vector2 F  = htot*fb;
 7396:          const Vector2 Fa = min(htot, veg_h)*fb;
 7397: 
 7398:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7399:       } // for j
 7400: 
 7401:       //botf1 etc are already in elem frame
 7402:       elem->ghat1 += tmp/i34;
 7403: 
 7404:       // Baroclinic force
 7405:       if constexpr(ibc==0) {
 7406:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7407: 
 7408:          Vector2 Fa = {0.0, 0.0};
 7409:          Vector2 intGradRho = {0.0, 0.0};
 7410:          
 7411:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7412:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7413:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7414: 
 7415:             // \in F [m^2/s/s]
 7416:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7417:          }
 7418: 
 7419:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7420:          const Vector2 F = av_df*Fa; //approx
 7421:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7422: 
 7423:       } // if ibc
 7424: 
 7425: 
 7426: 
 7427:    }
 7428: 
 7429: } // extern "C"
 7430: 
 7431: 
