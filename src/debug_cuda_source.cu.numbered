 7108: 
 7109:    __global__ void computeVerticalVelocity(void) {
 7110:       // Computes the vertical velocity at the (2D) element's centroid.
 7111:       // In this function we will be considering volumetric elements, with side faces and a 
 7112:       // bottom and a top face. We will call them SFs, BF and TF.
 7113:       // It computes the flux coming from BF and the SFs.
 7114:       // If the bed is moving, it takes that into account.
 7115:       // Since water is incompressible, the integral of the velocity times the normal vector
 7116:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7117:       // and the BF is equal to the flux going out from the TF.
 7118:       // TF = - BF - sum(SFs).
 7119:       // It then computes the horizontal velocity at the center of TF.
 7120:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7121:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7122:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7123: 
 7124:       ELEM(elem);
 7125: 
 7126:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7127: 
 7128:       if (elem->isDry) return;
 7129: 
 7130:       const int kb = elem->kb;
 7131:       const bool isTri = elem->isTri();
 7132: 
 7133:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7134: 
 7135:       // Compute the bottom velocity
 7136:       if constexpr(imm != 0) {
 7137:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7138:       }
 7139: 
 7140: 
 7141:       double bottomArea3D;
 7142:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7143: 
 7144:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7145: 
 7146:       double topArea3D;
 7147: 
 7148:       // Bottom face flux
 7149:       double bottomFlux = 0.0;
 7150:       Vector2 u2meanBottom = {0.0, 0.0};
 7151:       const Vector2 gradh = elem->grad2(&Node::depth);
 7152:       if constexpr(imm==2) {
 7153:          Vector3 ubed;
 7154: 
 7155:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7156:          // updateBDEF(ubed);
 7157:      
 7158:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7159: 
 7160:          // elem->w[kb] += ubed.z;
 7161:       }
 7162:       else {
 7163: 
 7164: 
 7165:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7166:   
 7167:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7168:          // in the direction of motion.
 7169:          const double bottomW = - dot(gradh, u2meanBottom);  
 7170:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7171: 
 7172:          // VElocity associated to the bed deformation
 7173:          double bedVelocity = 0.0;
 7174:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7175: 
 7176:          elem->w[kb] = bedVelocity + bottomW; 
 7177: 
 7178:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7179:          
 7180:       } // if imm
 7181: 
 7182:       // Compute w for kb+1 to nvrt-1
 7183:       for (int l = kb; l < nvrt - 1; l++) {
 7184: 
 7185:          // normal vector to the top face of the "volumetric" element (3D)
 7186:          Vector3 elem_top_n = -elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7187: 
 7188:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7189:          assert(elem_top_n.z < 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7190: 
 7191:          // Compute the total flux at the sides
 7192:          double sideFlux = 0.0;
 7193: 
 7194:          for (int j = 0; j < elem->i34; j++) {
 7195:             const Side *side = elem->sides[j];
 7196:             const int kbs = side->kb;
 7197:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7198:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7199:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7200: 
 7201:             // The area is "clamped" meaning that it takes kb into account.
 7202:             const double sideArea = side->areaClamped(l);
 7203: 
 7204:             const double sign = elem->ssign[j]; 
 7205: 
 7206:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7207:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7208:          }
 7209:          
 7210:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7211:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7212:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7213: 
 7214:          // The flux at the top ace can be computed from the other flows.
 7215:          // All fluxes are in directions into the prism.
 7216:          const double topFlux = - sideFlux - bottomFlux;
 7217: 
 7218:          // Flux at the top face due to the horizontal velocities only
 7219:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7220: 
 7221:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + bottomFlux = 0, so:
 7222:          const double topVerticalFlux = -sideFlux - topHorizontalFlux - bottomFlux;  
 7223: 
 7224:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7225: 
 7226:          bottomFlux = -topFlux;
 7227:       }
 7228:    }  
 7229: 
 7230: 
 7231: 
 7232: 
 7233: 
 7234: 
