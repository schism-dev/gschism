 3648: 
 3649: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3650:    // Computes the z coordinate at level k.
 3651:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3652:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3653:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3654:    // used 
 3655: 
 3656:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3657:    
 3658:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3659: 
 3660:    if (isDry2()) return 0.0;  
 3661: 
 3662:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3663: 
 3664:    if constexpr(ivcor == 2) {
 3665: 
 3666:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3667:       const double h_c = mesh->h_c;
 3668:       const double theta_f = mesh->theta_f;
 3669:       const double sinh_theta_f = mesh->sinh_theta_f;
 3670: 
 3671: 
 3672:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3673:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3674:       // once per time step/node. XXXX
 3675:       // CHECK: updateZCoordData
 3676: 
 3677:       //  To simplify comparisons, I define index versions of count variables.
 3678:       if      (k == ivrt)     return eta2; 
 3679:       else if (k == izlev)    return -hmod2;
 3680:       else if (k == kb)       return -depth;
 3681:       else if (k < izlev)     return mesh->ztot[k];
 3682:       else if (k > izlev) {
 3683:          const int ksig = k - izlev;
 3684: 
 3685:          if (hmod2 <= h_c) {
 3686:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3687: 
 3688:          } 
 3689:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3690:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3691:             assert(false && "compZCoord: invalid h_c\n");
 3692:          } 
 3693:          else {
 3694:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3695:                    h_c * mesh->sigma[ksig] + 
 3696:                    (hmod2 - h_c) * mesh->cs[ksig];
 3697:          }
 3698:       } else { 
 3699:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3700:       }
 3701: 
 3702:    }
 3703:    else {  // if constexpr(ivcor == 1)
 3704:       if (k <= kb)        return -depth; 
 3705:       else if (k == ivrt) return eta2;
 3706:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3707: 
 3708:    }
 3709:    
 3710:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3711:    return 0.0;
 3712: }
 3713: 
 3714: 
 3715: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3716:    // Computes the bottom drag Cd based on the selected nchi
 3717: 
 3718:    if constexpr(nchi == 0) {
 3719:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3720:       Cd = drag;  // Read from drag file
 3721: 
 3722:    } else if constexpr(nchi == 1) {
 3723:       // 
 3724: 
 3725:       bool ltmp = false; // for WBL iteration
 3726: 
 3727:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3728:       if (isDry || (rough == 0.0)) {
 3729:          Cd = 0.0;
 3730: 
 3731:       } else { //roughness >0 
 3732:          
 3733:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3734: 
 3735:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3736: 
 3737:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3738: 
 3739:       } // if rough
 3740: 
 3741:    } else if constexpr(nchi == -1) {
 3742:    // Manning 
 3743:  
 3744:       const double htot = max(hmin_man, htot2()); 
 3745:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3746: 
 3747:    } else {
 3748:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3749:       
 3750:    } // if nchi
 3751: 
 3752: }
 3753: 
 3754: 
 3755: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3756:    // Checks if a side in on the boundary
 3757:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3758: 
 3759:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3760:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3761: 
 3762:    // Indices of the nodes that form the side
 3763:    //
 3764:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3765:    const int n1 = side.n1->idx;
 3766:    const int n2 = side.n2->idx;
 3767:    isLand = false;
 3768:    
 3769: 
 3770:    // Check if the side is on a land boundary
 3771:    for (int i = 0; i < nland; i++) {
 3772:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3773:          // Consecutive nodes in the land boundary segment
 3774:          const int b1 = ilnd[i + j*nland];
 3775:          const int b2 = ilnd[i + (j + 1)*nland];
 3776: 
 3777:          assert(b1 != -1 && b2 != -1);
 3778: 
 3779:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3780:             
 3781:             isLand = true;
 3782:             return i;
 3783:          }
 3784:       }
 3785:    }
 3786: 
 3787:    // Check if the side is on an open boundary
 3788:    for (int i = 0; i < nope; i++) {
 3789:       for (int j = 0; j < nond[i] - 1; j++) {
 3790:          // Consecutive nodes in the open boundary segment
 3791:          const int b1 = iond[i + j*nope];
 3792:          const int b2 = iond[i + (j + 1)*nope];
 3793: 
 3794:          assert(b1 != -1 && b2 != -1);
 3795: 
 3796:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3797:             isLand = false;
 3798:             return i;
 3799:          }
 3800:       }
 3801:    }
 3802: 
 3803:    return -1;
 3804: }
 3805: 
 3806: 
 3807: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3808:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3809:                                     double *wind_rotate_angle, 
 3810:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3811:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3812:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3813:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3814:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3815: 
 3816:    NODE(pnode);  
 3817:    const int i = idx_node;
 3818:    Node &node(*pnode);
 3819: 
 3820:    node.idx = i;
 3821: 
 3822:    const int idxNodeStart = nodeNeighNodesStart[i];
 3823:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3824:    node.numNodes = idxNodeEnd - idxNodeStart;
 3825:    node.nodes = nodeNeighNodes + idxNodeStart;
 3826:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3827: 
 3828: 
 3829: 
 3830:    const int idxElemStart = nodeNeighElemsStart[i];
 3831:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3832:    node.numElements = idxElemEnd - idxElemStart;
 3833:    node.elements = nodeNeighElems + idxElemStart;
 3834: 
 3835: 
 3836:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3837:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3838:       const int partNode = localNodePart[idxNodeGlobal]; 
 3839:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3840: 
 3841:       Node *node_ptr = nodes[partNode] + idxNode;
 3842:       
 3843:       nodeNeighNodes[idx] = node_ptr;
 3844:    }
 3845: 
 3846: 
 3847:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3848:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3849:       const int partElem = localElemPart[idxElemGlobal];
 3850:       const int idxElem  = localElemIndices[idxElemGlobal];
 3851: 
 3852:       Element *elem_ptr = elems[partElem] + idxElem;
 3853: 
 3854:       nodeNeighElems[idx] = elem_ptr;
 3855:    }      
 3856: 
 3857:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3858:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3859: 
 3860:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3861: 
 3862:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3863:    if constexpr(ics == 1) {
 3864:       node.p.x   = node_coords[i * 3];
 3865:       node.p.y   = node_coords[i * 3 + 1];
 3866:       node.gz = 0.0;
 3867: 
 3868:       if (use_ll) {                                    // <-- add
 3869:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3870:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3871:       }  
 3872: 
 3873:    } else {
 3874:       const double lon = deg2rad*node_coords[i * 3];
 3875:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3876: 
 3877:       Point3 p = computeXYZfromLatLon(lat, lon);
 3878:       node.p = toVector2(p);
 3879:       node.gz = p.z;
 3880:       node.lon = lon;
 3881:       node.lat = lat;
 3882: 
 3883:       #ifdef USE_FRAMES
 3884:       node.setFrame(lat, lon);
 3885:       #endif
 3886: 
 3887: 
 3888:    }
 3889: 
 3890:    node.depth = node_coords[i * 3 + 2];
 3891: 
 3892:    node.numSides = 0;
 3893: 
 3894:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3895:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3896:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3897:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3898:    else assert(false && "populateNodes: selected nchi not implemented.");
 3899: 
 3900:    if constexpr(ivcor == 1) 
 3901:    {  
 3902:       node.kb = kb[i];
 3903: 
 3904:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3905:    }
 3906: 
 3907:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3908:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3909:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3910: 
 3911:    
 3912:    // Links the node to the boundary information
 3913:    if (isbnd[i] >= 0) {
 3914:      
 3915:       // Get the index of the node boundary
 3916:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3917: 
 3918:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3919:       node.nodeBnd->node = &node;
 3920: 
 3921:       node.nodeBnd->sideBnd1 = nullptr;
 3922:       node.nodeBnd->sideBnd2 = nullptr;
 3923: 
 3924:       if (isbnd[i]>=0) {
 3925: 
 3926:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3927:          
 3928:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3929:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3930: 
 3931:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3932:          node.nodeBnd->segment->clen  = nan("1");
 3933:          node.nodeBnd->segment->carea = nan("1");
 3934: 
 3935:       }
 3936:    } else {
 3937: 
 3938:       node.nodeBnd = nullptr; // For internal nodes
 3939: 
 3940:       if (isbnd[i] == landSegment) {
 3941:          node.nodeBnd = &landBoundaryNode;
 3942:          node.nodeBnd->segment = &landBoundarySegment;
 3943:       }
 3944:       
 3945:    }
 3946:    
 3947:    // XXXX GAUSSIAN HILL VELOCITIES
 3948:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3949:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3950:          constexpr double rot_per = 3000.0;
 3951:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3952:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3953:       // XXXXX
 3954:    #endif
 3955: 
 3956: }
 3957: 
 3958: 
 3959: 
 3960: 
 3961: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3962:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3963:                                     double *wind_rotate_angle,   
 3964:                                     int *isdel, int *isidenode, int *isbnd,
 3965:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3966:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3967:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3968:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3969:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3970:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3971:                                     double *drag, double *roughness) {
 3972: 
 3973: 
 3974:    SIDE(pside);
 3975:    Side &side(*pside);
 3976:    const int i = idx_side;
 3977: 
 3978:    side.idx = i;  
 3979:    
 3980:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3981:    const double fc   = 2.0*omega_e*sin(sfea0);
 3982:    const double beta = 2.0*omega_e*cos(sfea0);
 3983: 
 3984:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3985: 
 3986:    // finding the pointer to the nodes that form the side
 3987:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3988:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3989: 
 3990:    const int locidx_n1 = localNodeIndices[idx_n1];
 3991:    const int locidx_n2 = localNodeIndices[idx_n2];
 3992:    const int part_n1 =   localNodePart[idx_n1];
 3993:    const int part_n2 =   localNodePart[idx_n2];
 3994: 
 3995:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3996:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3997: 
 3998: 
 3999:    // Counts the number of sides connected to each node
 4000:    atomicAdd(&side.n1->numSides, 1);
 4001:    atomicAdd(&side.n2->numSides, 1);
 4002: 
 4003:    // Side boundary type
 4004:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4005:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4006: 
 4007:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4008:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4009:    {
 4010:       bool isLand = false;
 4011:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4012:       
 4013:       if (isbs > -1) {
 4014:          // assert(isLand || isbs>=0);
 4015:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4016: 
 4017:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4018: 
 4019:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4020:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4021: 
 4022:          assert (isLand == side.sideBnd->segment->isLand);
 4023:          
 4024:          side.sideBnd->side = &side;
 4025: 
 4026:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4027:          n1bnd->linkSideBoundary(side.sideBnd);
 4028:          n2bnd->linkSideBoundary(side.sideBnd);
 4029: 
 4030:       }
 4031:       else {
 4032:          side.sideBnd = nullptr;
 4033:       }
 4034:    }
 4035:    else 
 4036:    {
 4037:       side.sideBnd = nullptr;
 4038:    }
 4039: 
 4040: 
 4041:    // finding the pointer to the elements that share the side
 4042:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4043:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4044: 
 4045:    if (idx_e1 > -1) {
 4046:       const int locidx_e1 = localElemIndices[idx_e1];
 4047:       const int part_e1 =  localElemPart[idx_e1];
 4048:       side.elems[0] = elems[part_e1] + locidx_e1;
 4049: 
 4050:    }
 4051:    else {
 4052:       side.elems[0] = nullptr;
 4053:    }
 4054: 
 4055:    if (idx_e2 > -1) {
 4056:       const int locidx_e2 = localElemIndices[idx_e2];
 4057:       const int part_e2 =  localElemPart[idx_e2];
 4058:       side.elems[1] = elems[part_e2] + locidx_e2;
 4059:    }
 4060:    else {
 4061:       side.elems[1] = nullptr;
 4062:    }
 4063:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4064:       
 4065:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4066:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4067:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4068:          
 4069:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4070:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4071:       // printf("sideBnd: %p\n", side.sideBnd);
 4072:       // assert(false && "Side has no elements and no boundary");
 4073:    }
 4074:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4075: 
 4076:    // Compute the center of the side
 4077:    side.center = 0.5*(side.n1->p + side.n2->p);
 4078: 
 4079:    #ifdef USE_FRAMES
 4080:    side.setFrame();
 4081:    #endif
 4082: 
 4083:    // Normal, unitary vector to the side
 4084:    if constexpr(ics == 1) {
 4085:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4086:       side.n = normalize(side.n);
 4087:    }
 4088:    else {
 4089:       // Unit side vector in 3D cartesian coordinates
 4090:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4091: 
 4092:       nSide = normalize(nSide);
 4093: 
 4094:       // Its cross product with the unit local z-axis vector (nUp) is the
 4095:       // normal vector we are looking for.
 4096:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4097: 
 4098:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4099:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4100:       side.n = -normalize(n2D); 
 4101: 
 4102:    }
 4103: 
 4104:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4105:    side.shapiro = shapiro0;
 4106: 
 4107:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4108:    // XXXX
 4109:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4110:    constexpr double rot_per=3000.0;
 4111:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4112:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4113:    // XXXXX      
 4114:    #endif
 4115:    // Compute the z level at the center of the side
 4116:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4117:    
 4118:    // Compute the length of the side
 4119:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4120: 
 4121: 
 4122:    // Compute the Coriolis coefficient
 4123: 
 4124:    if constexpr(ncor == -1 || ncor == 0) {
 4125:       side.coriolis = coricoef;
 4126:    }
 4127:    else {
 4128:       const double sphi = side.lat();  // Latitude at the center of the side
 4129: 
 4130:       assert(use_ll && "use_ll must be true when ncor > 0");
 4131: 
 4132:       if constexpr(ics == 1) {
 4133:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4134:       }
 4135:       else { // ics == 2
 4136:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4137:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4138:       }
 4139: 
 4140:    }
 4141: 
 4142: }
 4143: 
 4144: 
 4145: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4146:    double *node_coords, double *node_coords_ll, bool use_ll,
 4147:    double *wind_rotate_angle,   
 4148:    int *isdel, int *isidenode, int *isbnd,
 4149:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4150:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4151:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4152:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4153:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4154:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4155:    double *drag, double *roughness) {
 4156: 
 4157:    ELEM(pelem);
 4158:    Element &elem(*pelem);
 4159:    const int i = idx_elem;
 4160: 
 4161:    elem.idx = i;
 4162: 
 4163:    for (int j = 0; j < i34[i]; j++) {
 4164:       const int idxNode = elnode[i*4 + j];  
 4165:       const int idxSide = elside[i*4 + j];
 4166:       
 4167:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4168:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4169: 
 4170:       // Find the neighboring element  
 4171:       if (elem.sides[j]->elems[0] == &elem) {
 4172:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4173:       }
 4174:       else {
 4175:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4176:       }
 4177:       
 4178:    }
 4179: 
 4180:    elem.i34 = i34[i];
 4181: 
 4182:    // Compute the barycenter of the element and its depth
 4183:    elem.center = {0.0, 0.0};
 4184:    elem.depth = 1e10;
 4185:    for (int j = 0; j < i34[i]; j++) {
 4186: 
 4187:       elem.center += elem.nodes[j]->p/i34[i];
 4188:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4189:    }
 4190: 
 4191:    #ifdef USE_FRAMES
 4192:    elem.setFrame();
 4193:    #endif
 4194: 
 4195:    elem.area = elem.computeSignedArea(); 
 4196:    elem.radius = sqrt(elem.area)/pi; 
 4197:    
 4198:    // Determines which way the normal vector to each side is oriented.
 4199:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4200:    for (int j = 0; j < i34[i]; j++)  
 4201:    {
 4202:       if (elem.sides[j]->elems[0] == &elem) {
 4203:          elem.ssign[j] =  1.0;
 4204:       }
 4205:       else {
 4206:          elem.ssign[j] = -1.0;
 4207:       }
 4208: 
 4209:    }
 4210: 
 4211:   
 4212: 
 4213:    // Derivatives of shape functions
 4214:    //  For ics=2, this is done in the element frame
 4215:    //  For quads, the derivative is evaluated at centroid
 4216:    for (int j = 0; j < elem.i34; j++) {
 4217:       const double area = elem.area;
 4218:       const int id2 = elem.nxq(1 + j);
 4219:       const int id3 = elem.nxq(2 + j);
 4220:       const int id4 = elem.nxq(3 + j);
 4221:       if (elem.isTri()) {
 4222:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4223:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4224:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4225:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4226:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4227:          // And so on for the other shape functions.
 4228: 
 4229:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4230:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4231:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4232: 
 4233:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4234:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4235: 
 4236:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4237: 
 4238:       }
 4239:       else  { // Quad, the derivatives are evaluated at the centroid
 4240: 
 4241:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4242:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4243:          // ...
 4244:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4245: 
 4246:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4247:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4248:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4249: 
 4250:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4251:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4252: 
 4253:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4254: 
 4255:       } // if Tri/Quad
 4256: 
 4257:    } // for j   
 4258:    
 4259:    
 4260: 
 4261: }
 4262: 
 4263: 
 4264: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4265:                                             double *emo, double *efa, 
 4266:                                             double *umo, double *ufa, 
 4267:                                             double *vmo, double *vfa,
 4268:                                             int *ifltype, int *iettype) {
 4269: 
 4270:    NODE_BND(nodeBnd);
 4271:    const int idx = idx_node_bnd;    
 4272: 
 4273:    nodeBnd->idx = idx;
 4274: 
 4275:    // Need to find the segment index and the index of the node on the segment
 4276:    int idxNode = -1;
 4277:    int iseg, i;
 4278:    for (iseg = 0; iseg < nope; iseg++) {
 4279:       // for each segment...
 4280:       for (i = 0; i < nond[iseg]; i++) {
 4281:          idxNode = iond[iseg + i*nope];
 4282:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4283:          
 4284:       }
 4285:    }
 4286: 
 4287:    assert(iseg < nope && "iseg is out of bounds");
 4288: 
 4289: found: // Jumped here when the node was found
 4290: 
 4291:    nodeBnd->isEssentialBC = true;
 4292:    nodeBnd->elbc = 0.0;
 4293: 
 4294:    nodeBnd->segment->ifltype = ifltype[iseg];
 4295:    nodeBnd->segment->iettype = iettype[iseg];
 4296: 
 4297:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4298: 
 4299:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4300: 
 4301:       nodeBnd->efa[jfr] = efa[idx2];
 4302:       nodeBnd->emo[jfr] = emo[idx2];
 4303:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4304:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4305: 
 4306:    }
 4307:         
 4308: 
 4309: }
 4310: 
 4311: __device__ void Mesh::populateBoundarySideLinks(void) {
 4312: 
 4313:    SIDE_BND(sideBnd);
 4314: 
 4315:    const Side *side = sideBnd->side;
 4316: 
 4317:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4318:    // and the rightSide is the side s that has s->n1 == side->n2
 4319:    for (int i = 0; i < mesh->nbs; i++) {
 4320: 
 4321:       Side *s = &mesh->localSideData[i];
 4322: 
 4323:       if (s == side) continue;  // Do not link the side to itself
 4324:    
 4325:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4326:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4327:    }
 4328:    
 4329: }
 4330: 
 4331: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4332:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4333:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4334:                 int *isdel, int *isidenode, int *isbnd,
 4335:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4336:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4337:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4338:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4339:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4340:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4341:                 double *drag, double *roughness,
 4342:                 double *emo, double *efa, 
 4343:                 double *umo, double *ufa, 
 4344:                 double *vmo, double *vfa) {
 4345: 
 4346:    printf("Populating mesh for partition %d\n", partNum);
 4347: 
 4348:    // XXXXXX THIS function does almost nothing. 
 4349: 
 4350:    nbs = *sharedIdxSideBoundary + 1;
 4351:    nbp = *sharedIdxNodeBoundary + 1;
 4352: 
 4353:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4354: 
 4355: }
