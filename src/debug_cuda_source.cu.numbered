 7205: 
 7206: __global__ void computeMatrixProductAndDotProducts() {
 7207:    // Computes A*p, r'Mr and p'Ap
 7208: 
 7209:    // 1) shared buffer: first half for rMr, second for pAp
 7210:    __shared__ double sdata[2*BLOCK_SIZE];
 7211:    double* s_rMr = sdata;
 7212:    double* s_pAp = sdata + BLOCK_SIZE;
 7213: 
 7214:    const int tid = threadIdx.x;
 7215: 
 7216:    double l_pAp = 0.0;
 7217: 
 7218:    s_rMr[tid] = 0.0;
 7219:    s_pAp[tid] = 0.0;
 7220: 
 7221:    // 2) get your node pointer
 7222:    // NODE(node);   
 7223:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7224:    Node *node = &(mesh->localNodeData[idx_node]); 
 7225:       if (idx_node < mesh->np) {
 7226: 
 7227:       const double diag = node->coeffDiag;
 7228:       const double r    = node->mR;
 7229:       const double p    = node->mP;  
 7230: 
 7231:       // apply preconditioner on the fly:
 7232:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7233: 
 7234:       // 4) compute Ap = A.p
 7235:       double Ap = node->coeffDiag * node->mP;
 7236:       for (int j = 0; j < node->numNodes; ++j) {
 7237:          const Node *nbNode = node->nodes[j];
 7238:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7239: 
 7240:       }
 7241: 
 7242:       node->mAp = Ap;
 7243:       
 7244: 
 7245:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7246:       // const double l_rMr = r*Mr;  // r'Mr
 7247:       l_pAp = p*Ap;  // p'Ap
 7248: 
 7249: 
 7250:    }
 7251: 
 7252:    // 6) write into shared mem
 7253:    // s_rMr[tid] = l_rMr;
 7254:    s_pAp[tid] = l_pAp;
 7255: 
 7256:    __syncthreads();
 7257: 
 7258:    // 7) block-wide tree reduction
 7259:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7260:       if (tid < stride)  {
 7261:          s_pAp[tid] += s_pAp[tid + stride];
 7262:       }
 7263:       __syncthreads();
 7264:    }
 7265: 
 7266:    // 8) thread 0 atomically accumulates into the globals
 7267:    // XXX: This is slower than it needs to be, but it is simple and works
 7268:    if (tid == 0) {
 7269:       atomicAdd(pAp, s_pAp[0]);
 7270:    }
 7271: 
 7272: 
 7273: }
 7274: 
 7275: 
 7276: __global__ void updateSolutionAndDotProducts(void) {
 7277:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7278: 
 7279:    const int tid = threadIdx.x;
 7280: 
 7281:    s_rMr[tid] = 0.0;
 7282: 
 7283:    // get node & bounds-check:
 7284:    NODE(node);
 7285: 
 7286:    
 7287:    // Compute alpha
 7288:    const double alpha = (*rMr_old)/(*pAp); 
 7289: 
 7290: 
 7291:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7292: 
 7293: 
 7294:    // load scalars
 7295:    const double diag = node->coeffDiag;
 7296:    const double p    = node->mP;
 7297:    const double Ap   = node->mAp;
 7298:    const double x    = node->mX;
 7299:    const double r    = node->mR;
 7300:    
 7301:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7302: 
 7303:    // 1) update solution & residual
 7304:    const double x_new = x + alpha*p;
 7305:    const double r_new = r - alpha*Ap;
 7306:    node->mX = x_new;
 7307:    node->mR = r_new;
 7308: 
 7309:    // 2) apply Jacobi preconditioner on the fly
 7310:    const double Mr_new = r_new/diag;
 7311: 
 7312: 
 7313:    // 3) local contributions for the two dot-products
 7314:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7315: 
 7316:    // 4) write into shared-mem
 7317:    s_rMr[tid] = l_rMr;
 7318: 
 7319:    __syncthreads();
 7320: 
 7321: 
 7322:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7323:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7324:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7325:       __syncthreads();
 7326:    }
 7327: 
 7328:    // 6) thread 0 atomically folds into the global accumulators
 7329:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7330: 
 7331: 
 7332: }
 7333: 
 7334: 
 7335: __global__ void updateSearchDirection() {
 7336: 
 7337:     NODE(node);
 7338: 
 7339:     // recompute z on-the-fly
 7340:     const double z = node->mR / node->coeffDiag;
 7341:     const double p = node->mP;
 7342: 
 7343:     const double beta = (*rMr_new)/(*rMr_old);
 7344: 
 7345: 
 7346:     // p =z + beta*p
 7347:     node->mP = z + beta*p;
 7348: 
 7349: }
 7350: 
 7351: __global__ void initializeScalars(double *scalars) {
 7352: 
 7353:    // These point to a cupy array in the host code
 7354:    rMr_old = scalars + 0;
 7355:    rMr_new = scalars + 1;
 7356:    pAp     = scalars + 2;
 7357: }
 7358: 
 7359: __global__ void initializePreconditionedResidual(void) {
 7360: 
 7361:     __shared__ double s_rMr[BLOCK_SIZE];  
 7362: 
 7363:     s_rMr[threadIdx.x] = 0.0;
 7364: 
 7365:     NODE_ALL(node, valid);
 7366:     const int tid = threadIdx.x;
 7367:     // For the first iteration:
 7368:     // 1. Initial solution x = 0 (already set)
 7369:     // 2. Initial residual r = b (stored in qel)
 7370:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7371: 
 7372: // XXX we should use the guess solution here    
 7373: 
 7374:     double l_rMr = 0.0;
 7375:     if (valid) {
 7376:       // Set initial residual r = b (from qel)
 7377:       node->mR = node->qel;
 7378: 
 7379:       // Compute z = M^-1 * r (preconditioned residual)
 7380:       const double z = node->mR / node->coeffDiag;
 7381: 
 7382:       // Set initial search direction p = z
 7383:       node->mP = z;
 7384: 
 7385:       // Initialize other variables needed for CG
 7386:       node->mX = 0.0;  // Initial solution
 7387:       node->mAp = 0.0; // Will be computed in first iteration
 7388: 
 7389: 
 7390:       // Computes the first r'Mr (reduction)
 7391:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7392:     }
 7393:     // 4) write into shared-mem
 7394:     s_rMr[tid] = l_rMr;
 7395: 
 7396:     __syncthreads();
 7397: 
 7398: 
 7399:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7400:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7401:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7402:         __syncthreads();
 7403:     }
 7404: 
 7405:     // 6) thread 0 atomically folds into the global accumulators
 7406:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7407: 
 7408:     *rMr_old = 0.0;
 7409:     *pAp = 0.0;
 7410: }
 7411: 
 7412: 
 7413: 
 7414: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7415:    Element *elems = mesh->localElemData;
 7416: 
 7417:    *addr = elems;
 7418:    *sizeElement = sizeof(Element);
 7419:    switch (varCode) {
 7420:       case (int)VarCode::z:
 7421:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7422:          *sizeType = sizeof(double);
 7423:          break;
 7424:       case (int)VarCode::x:
 7425:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7426:          *sizeType = sizeof(Vector2);
 7427:          break;
 7428:       case (int)VarCode::area:
 7429:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7430:          *sizeType = sizeof(double);
 7431:          break;
 7432:       case (int)VarCode::depth:
 7433:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7434:          *sizeType = sizeof(double);
 7435:          break;
 7436:       case (int)VarCode::radius:
 7437:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7438:          *sizeType = sizeof(double);
 7439:          break;
 7440:       case (int)VarCode::lonlat:
 7441:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7442:          *sizeType = sizeof(double);
 7443:          break;
 7444:       case (int)VarCode::ghat:
 7445:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7446:          *sizeType = sizeof(Vector2);
 7447:          break;
 7448:       case (int)VarCode::kb:
 7449:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7450:          *sizeType = sizeof(int);
 7451:          break;
 7452:       case (int)VarCode::isdry:
 7453:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7454:          *sizeType = sizeof(int);
 7455:          break;            
 7456:       case (int)VarCode::w:
 7457:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7458:          *sizeType = sizeof(double);
 7459:          break;
 7460:       case (int)VarCode::FaceIndices:
 7461:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7462:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7463:          *sizeType = sizeof(Node);
 7464:          break;
 7465:       default:
 7466:          *offset = -1;
 7467:    }
 7468: }
