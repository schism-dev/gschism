 7620: 
 7621: __global__ void returnMatrix(double *res) {
 7622:    // Debugging: returns the matrix as a CuPy array
 7623: 
 7624:    const int size = mesh->np;
 7625:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7626:       const Node *node = mesh->localNodeData + idx_node;
 7627:       res[idx_node*size + idx_node] = node->coeffDiag;
 7628:       for (int j = 0; j < node->numNodes; j++) {
 7629:          Node* nbNode = node->nodes[j];
 7630:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7631:       }
 7632: 
 7633:    }
 7634:    
 7635: }
 7636: 
 7637: 
 7638: __global__ void computeMatrixProductAndDotProducts() {
 7639:    // Computes A*p, r'Mr and p'Ap
 7640: 
 7641:    // 1) shared buffer: first half for rMr, second for pAp
 7642:    __shared__ double sdata[2*BLOCK_SIZE];
 7643:    double* s_rMr = sdata;
 7644:    double* s_pAp = sdata + BLOCK_SIZE;
 7645: 
 7646:    const int tid = threadIdx.x;
 7647: 
 7648:    double l_pAp = 0.0;
 7649: 
 7650:    s_rMr[tid] = 0.0;
 7651:    s_pAp[tid] = 0.0;
 7652: 
 7653:    // 2) get your node pointer
 7654:    // NODE(node);   
 7655:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7656:    Node *node = &(mesh->localNodeData[idx_node]); 
 7657:       if (idx_node < mesh->np) {
 7658: 
 7659:       const double diag = node->coeffDiag;
 7660:       const double r    = node->mR;
 7661:       const double p    = node->mP;  
 7662: 
 7663:       // apply preconditioner on the fly:
 7664:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7665: 
 7666:       // 4) compute Ap = A.p
 7667:       double Ap = node->coeffDiag * node->mP;
 7668:       for (int j = 0; j < node->numNodes; ++j) {
 7669:          const Node *nbNode = node->nodes[j];
 7670:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7671: 
 7672:       }
 7673: 
 7674:       node->mAp = Ap;
 7675:       
 7676: 
 7677:       // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7678:       // const double l_rMr = r*Mr;  // r'Mr
 7679:       l_pAp = p*Ap;  // p'Ap
 7680: 
 7681: 
 7682:    }
 7683: 
 7684:    // 6) write into shared mem
 7685:    // s_rMr[tid] = l_rMr;
 7686:    s_pAp[tid] = l_pAp;
 7687: 
 7688:    __syncthreads();
 7689: 
 7690:    // 7) block-wide tree reduction
 7691:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7692:       if (tid < stride)  {
 7693:          s_pAp[tid] += s_pAp[tid + stride];
 7694:       }
 7695:       __syncthreads();
 7696:    }
 7697: 
 7698:    // 8) thread 0 atomically accumulates into the globals
 7699:    // XXX: This is slower than it needs to be, but it is simple and works
 7700:    if (tid == 0) {
 7701:       atomicAdd(pAp, s_pAp[0]);
 7702:    }
 7703: 
 7704: 
 7705: }
 7706: 
 7707: 
 7708: __global__ void updateSolutionAndDotProducts(void) {
 7709:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7710: 
 7711:    const int tid = threadIdx.x;
 7712: 
 7713:    s_rMr[tid] = 0.0;
 7714: 
 7715:    // get node & bounds-check:
 7716:    NODE(node);
 7717: 
 7718:    
 7719:    // Compute alpha
 7720:    const double alpha = (*rMr_old)/(*pAp);
 7721: 
 7722:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7723: 
 7724: 
 7725:    // load scalars
 7726:    const double diag = node->coeffDiag;
 7727:    const double p    = node->mP;
 7728:    const double Ap   = node->mAp;
 7729:    const double x    = node->mX;
 7730:    const double r    = node->mR;
 7731:    
 7732:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7733: 
 7734:    // 1) update solution & residual
 7735:    const double x_new = x + alpha*p;
 7736:    const double r_new = r - alpha*Ap;
 7737:    node->mX = x_new;
 7738:    node->mR = r_new;
 7739: 
 7740:    // 2) apply Jacobi preconditioner on the fly
 7741:    const double Mr_new = r_new/diag;
 7742: 
 7743: 
 7744:    // 3) local contributions for the two dot-products
 7745:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7746: 
 7747:    // 4) write into shared-mem
 7748:    s_rMr[tid] = l_rMr;
 7749: 
 7750:    __syncthreads();
 7751: 
 7752: 
 7753:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7754:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7755:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7756:       __syncthreads();
 7757:    }
 7758: 
 7759:    // 6) thread 0 atomically folds into the global accumulators
 7760:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7761: 
 7762: 
 7763: }
 7764: 
 7765: 
 7766: __global__ void updateSearchDirection() {
 7767: 
 7768:     NODE(node);
 7769: 
 7770:     // recompute z on-the-fly
 7771:     const double z = node->mR / node->coeffDiag;
 7772:     const double p = node->mP;
 7773: 
 7774:     const double beta = (*rMr_new)/(*rMr_old);
 7775: 
 7776: 
 7777:     // p =z + beta*p
 7778:     node->mP = z + beta*p;
 7779: 
 7780: }
 7781: 
 7782: __global__ void initializeScalars(double *scalars) {
 7783: 
 7784:    // These point to a cupy array in the host code
 7785:    rMr_old = scalars + 0;
 7786:    rMr_new = scalars + 1;
 7787:    pAp     = scalars + 2;
 7788: }
 7789: 
 7790: __global__ void initializePreconditionedResidual(void) {
 7791: 
 7792:     __shared__ double s_rMr[BLOCK_SIZE];  
 7793: 
 7794:     s_rMr[threadIdx.x] = 0.0;
 7795: 
 7796:     NODE_ALL(node, valid);
 7797:     const int tid = threadIdx.x;
 7798:     // For the first iteration:
 7799:     // 1. Initial solution x = 0 (already set)
 7800:     // 2. Initial residual r = b (stored in qel)
 7801:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7802: 
 7803: // XXX we should use the guess solution here    
 7804: 
 7805:     double l_rMr = 0.0;
 7806:     if (valid) {
 7807:       // Set initial residual r = b (from qel)
 7808:       node->mR = node->qel;
 7809: 
 7810:       // Compute z = M^-1 * r (preconditioned residual)
 7811:       const double z = node->mR / node->coeffDiag;
 7812: 
 7813:       // Set initial search direction p = z
 7814:       node->mP = z;
 7815: 
 7816:       // Initialize other variables needed for CG
 7817:       node->mX = 0.0;  // Initial solution
 7818:       node->mAp = 0.0; // Will be computed in first iteration
 7819: 
 7820: 
 7821:       // Computes the first r'Mr (reduction)
 7822:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7823:     }
 7824:     // 4) write into shared-mem
 7825:     s_rMr[tid] = l_rMr;
 7826: 
 7827:     __syncthreads();
 7828: 
 7829: 
 7830:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7831:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7832:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7833:         __syncthreads();
 7834:     }
 7835: 
 7836:     // 6) thread 0 atomically folds into the global accumulators
 7837:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7838: 
 7839:     *rMr_old = 0.0;
 7840:     *pAp = 0.0;
 7841: }
 7842: 
 7843: 
 7844: 
 7845: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7846:    Element *elems = mesh->localElemData;
 7847: 
 7848:    *addr = elems;
 7849:    *sizeElement = sizeof(Element);
 7850:    switch (varCode) {
 7851:       case (int)VarCode::z:
 7852:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7853:          *sizeType = sizeof(double);
 7854:          break;
 7855:       case (int)VarCode::x:
 7856:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7857:          *sizeType = sizeof(Vector2);
 7858:          break;
 7859:       case (int)VarCode::area:
 7860:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7861:          *sizeType = sizeof(double);
 7862:          break;
 7863:       case (int)VarCode::depth:
 7864:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7865:          *sizeType = sizeof(double);
 7866:          break;
 7867:       case (int)VarCode::radius:
 7868:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7869:          *sizeType = sizeof(double);
 7870:          break;
 7871:       case (int)VarCode::lonlat:
 7872:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7873:          *sizeType = sizeof(double);
 7874:          break;
 7875:       case (int)VarCode::ghat:
 7876:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7877:          *sizeType = sizeof(Vector2);
 7878:          break;
 7879:       case (int)VarCode::kb:
 7880:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7881:          *sizeType = sizeof(int);
 7882:          break;
 7883:       case (int)VarCode::isdry:
 7884:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7885:          *sizeType = sizeof(int);
 7886:          break;            
 7887:       case (int)VarCode::w:
 7888:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7889:          *sizeType = sizeof(double);
 7890:          break;
 7891:       case (int)VarCode::FaceIndices:
 7892:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7893:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7894:          *sizeType = sizeof(Node);
 7895:          break;
 7896:       default:
 7897:          *offset = -1;
 7898:    }
 7899: }
