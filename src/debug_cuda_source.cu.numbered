 7091:    __global__ void setVelocityOpenBndNodes(void) {
 7092:    // For open boundary nodes sets their velocity to the imposed values.
 7093: 
 7094:       SIDE_BND(sidebnd);
 7095: 
 7096:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7097:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7098:          // to its segment to the average of the side velocity.
 7099: 
 7100:          for (int k = 0; k < nvrt; k++) {
 7101:             Node *n1 = sidebnd->side->n1;
 7102:             Node *n2 = sidebnd->side->n2;
 7103: 
 7104: 
 7105:             Vector2 n1_u2(n1->u2[k]);
 7106:             Vector2 n2_u2(n2->u2[k]);
 7107: 
 7108:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7109:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7110:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7111:             }
 7112:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7113:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7114:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7115:             }
 7116: 
 7117:          }
 7118: 
 7119:       }
 7120: 
 7121:    }
