 2294:    template<typename T>
 2295:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2296:       T values[4];
 2297:       getNodalValues(level, func, values);
 2298: 
 2299:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2300:       if constexpr (IsVector2<T>::value && ics == 2) {
 2301: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2302:          projectNodeVectorsToElementFrame(values);
 2303: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2304:       }
 2305: 
 2306:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2307:    }
 2308: 
 2309:    template<typename T>
 2310:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2311:       T values[4];
 2312:       getNodalValues(field, values);
 2313: 
 2314:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2315:       if constexpr (IsVector2<T>::value && ics == 2) {
 2316: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2317:          projectNodeVectorsToElementFrame(values);
 2318: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2319:       }
 2320:       
 2321:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2322:    }
 2323: 
 2324: 
 2325:    template<typename T>
 2326:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2327:       T values[4];
 2328:       getNodalValues(level, field, values);
 2329:       
 2330: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2331:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2332:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2333:       if constexpr (IsVector2<T>::value && ics == 2) {
 2334: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2335:          projectNodeVectorsToElementFrame(values);
 2336: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2337:       }
 2338: 
 2339:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2340:    }
 2341: 
 2342:    template<typename T>
 2343:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2344:       T values[4];
 2345:       getNodalValues(field, values);
 2346: 
 2347:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2348:       if constexpr (IsVector2<T>::value && ics == 2) {
 2349: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2350:          projectNodeVectorsToElementFrame(values);
 2351: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2352:       }
 2353: 
 2354:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2355:    }
 2356: 
 2357:    template<typename T>
 2358:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2359:       T values[4];
 2360:       getSideValues(field, values);
 2361:       
 2362:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2363:       if constexpr (IsVector2<T>::value && ics == 2) {
 2364: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2365:          projectSideVectorsToElementFrame(values);
 2366: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2367:       }
 2368: 
 2369:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2370:    }   
 2371: 
 2372:    template<typename T>
 2373:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2374: 
 2375:       T values[4];
 2376: 
 2377: 
 2378:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2379:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2380:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2381:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2382:       else          values[3] = T();
 2383: 
 2384:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2385: 
 2386:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2387:    }
