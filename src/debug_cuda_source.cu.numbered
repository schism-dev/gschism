 8750: //                   do ll=1,2 !nodes
 8751: //                     ndo=isidenode(ll,jsj)
 8752: //                     do lll=1,2 !2 possible bnds
 8753: //                       if(isbnd(lll,ndo)==ibnd) then
 8754: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 8755: //                         exit
 8756: //                       endif
 8757: //                     enddo !lll
 8758: //                   enddo !ll
