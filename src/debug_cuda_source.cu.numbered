 2203:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2204:       // Compute the different time ramps used in the code 
 2205:       // This function is performed by just one thread
 2206: 
 2207:       rampbc = 1.0;
 2208:       if constexpr(ibc == 0) {
 2209:          if (drampbc > 0.0) {
 2210:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2211:          } else {
 2212:             rampbc = 1.0;
 2213:          }
 2214:       }
 2215: 
 2216:       if (nws != 0) {
 2217:          if (drampwind > 0.0) {
 2218:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2219:          } else {
 2220:             rampwind = 1.0;
 2221:          }
 2222:       }
 2223: 
 2224:       if (drampwafo > 0.0) {
 2225:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2226:       } else {
 2227:          rampwafo = 1.0;
 2228:       }
 2229: 
 2230:       // For source/sinks
 2231:       if (if_source && dramp_ss > 0.0) {
 2232:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2233:       } else {
 2234:          ramp_ss = 1.0;
 2235:       }
 2236: 
 2237:       if (dramp > 0.0) {
 2238:          ramp = tanh(2.0*time/86400.0/dramp);
 2239:       } else {
 2240:          ramp = 1.0;
 2241:       }
 2242: 
 2243: 
 2244:    }
