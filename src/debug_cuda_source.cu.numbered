 7994: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7995:    // Get the value of a variable from an element
 7996:    // varName is the name of the variable to get
 7997:    // var is the array to store the value
 7998:    // k is the vertical level index of the variable to get
 7999: 
 8000:    ELEM(elem);
 8001:    
 8002:    int idx = elem->idx;
 8003:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8004: 
 8005:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8006:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8007:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8008:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8009:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8010:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8011:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8012:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8013:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8014:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8015:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8016:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8017:       
 8018:    
 8019: }
 8020: 
 8021: 
 8022: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8023:    // Get the value of a variable from an node
 8024:    // varName is the name of the variable to get
 8025:    // var is the array to store the value
 8026:    // k is the vertical level index of the variable to get
 8027: 
 8028:    NODE(node);
 8029:    
 8030:    int idx = node->idx;
 8031:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8032: 
 8033:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8034:    
 8035:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8036:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8037:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8038:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8039:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8040:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8041:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8042:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8043:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8044:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8045:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8046:    
 8047:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8048:       
 8049:    
 8050: }
 8051: 
 8052: 
 8053: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8054:    // Get the value of a variable from an side
 8055:    // varName is the name of the variable to get
 8056:    // var is the array to store the value
 8057:    // k is the vertical level index of the variable to get
 8058:    SIDE(side);
 8059:    
 8060:    int idx = side->idx;
 8061:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8062: 
 8063:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8064:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8065:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8066:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8067:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8068:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8069:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8070:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8071:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8072:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8073:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8074:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8075:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8076:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8077:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8078:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8079:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8080:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8081:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8082:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8083:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8084:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8085:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8086:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8087:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8088:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8089:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8090:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8091:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8092:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8093:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8094:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8095:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8096:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8097:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8098:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8099: }
 8100: 
 8101: 
 8102: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8103:    // Get the value of a variable from an side
 8104:    // varName is the name of the variable to get
 8105:    // var is the array to store the value
 8106:    // k is the vertical level index of the variable to get
 8107:    SIDE_BND(sideBnd);   
 8108: 
 8109:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8110:    if (sideBnd->segment->isLand) idx = -7;
 8111: 
 8112:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8113:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8114: 
 8115: }
