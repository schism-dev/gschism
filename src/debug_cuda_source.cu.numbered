 2167:    template<typename T>
 2168:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2169: 
 2170:       T values[4];
 2171: 
 2172: 
 2173:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2174:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2175:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2176:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2177:       else          values[3] = T();
 2178: 
 2179:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2180: 
 2181:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2182:    }
