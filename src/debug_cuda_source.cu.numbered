 3187: 
 3188: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3189: 
 3190:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3191:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3192:    const Node *n1 = side->n1;
 3193:    const Node *n2 = side->n2;
 3194: 
 3195:    bool n1_match = (n1->nodeBnd->segment == segment);
 3196:    bool n2_match = (n2->nodeBnd->segment == segment);
 3197: 
 3198:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3199:    if (n1_match && n2_match) {
 3200:       return 0.5;
 3201:    } else if (n1_match) {
 3202:       return 1.0;
 3203:    } else if (n2_match) {
 3204:       return 0.0;
 3205:    }
 3206: 
 3207:    return 0.0;
 3208: }
 3209: 
 3210: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3211: 
 3212: 
 3213: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3214: 
 3215:    const double w1 = getBoundaryArrayValueWeight();
 3216:    const double w2 = 1.0 - w1;
 3217:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3218:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3219: 
 3220:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3221: }
 3222: 
 3223: 
 3224: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3225:    const double w1 = getBoundaryArrayValueWeight();
 3226:    const double w2 = 1.0 - w1;
 3227:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3228:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3229: 
 3230:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3231: 
 3232: }
 3233: 
 3234: 
 3235: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3236:    // Returns the value of the velocity at the side center
 3237:    const double w1 = getBoundaryArrayValueWeight();
 3238:    const double w2 = 1.0 - w1;
 3239:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3240:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3241: 
 3242:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3243: }
 3244: 
 3245: 
 3246: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3247:    // Returns the value of the normal component of the velocity at the side center
 3248:    const double w1 = getBoundaryArrayValueWeight();
 3249:    const double w2 = 1.0 - w1;
 3250:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3251:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3252: 
 3253:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3254: }
