 4431: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4432:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4433:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4434:                 int *isdel, int *isidenode, int *isbnd,
 4435:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4436:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4437:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4438:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4439:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4440:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4441:                 double *drag, double *roughness,
 4442:                 double *emo, double *efa, 
 4443:                 double *umo, double *ufa, 
 4444:                 double *vmo, double *vfa) {
 4445: 
 4446:    printf("Populating mesh for partition %d\n", partNum);
 4447: 
 4448:    // XXXXXX THIS function does almost nothing. 
 4449: 
 4450:    nbs = *sharedIdxSideBoundary + 1;
 4451:    nbp = *sharedIdxNodeBoundary + 1;
 4452: 
 4453:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4454: 
 4455: }
