 7395: //                       endif
 7396: //                     enddo !lll
 7397: //                   enddo !ll
 7398: //                   ind1=nwild(1); ind2=nwild(2);
 7399: 
 7400: //                   do jj=1,natrm
 7401: //                     if(ntrs(jj)<=0) cycle
 7402: 
 7403: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7404: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7405: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7406: //                       enddo !ll
 7407: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
