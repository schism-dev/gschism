 3538:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3539: 
 3540:       NODE_BND(nodeBnd);
 3541: 
 3542:       Node *node = nodeBnd->node;
 3543: 
 3544:       node->ETP = 0.0;
 3545: 
 3546:       for (int j=0; j<ntip; j++) {
 3547: 
 3548:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3549:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3550:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3551: 
 3552:          if constexpr(iloadtide==1) { // loading tide
 3553:             assert(false && "Loading tide not implemented");
 3554:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3555:          }
 3556:          
 3557:       }
 3558:       
 3559:    }
