 7830: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7831: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7832: //                       enddo !ll
 7833: //                     else if(itrtype(jj,ibnd)==4) then
 7834: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7835: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7836: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7837: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7838: //                       enddo !ll
 7839: //                     else
 7840: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7841: //   !'
 7842: //                       call parallel_abort(errmsg)
 7843: //                     endif !itrtype
 7844: 
 7845: //                   enddo !jj
