 6521:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6522: 
 6523:       SIDE(side);
 6524: 
 6525:       side->U = {0.0, 0.0}; 
 6526:          
 6527:       if(side->isDry) return;
 6528: 
 6529:       // Vertically integrated velocity U
 6530:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6531:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6532:          side->U += side->Dz(k + 1)*uc;  
 6533:       }
 6534: 
 6535:    }
