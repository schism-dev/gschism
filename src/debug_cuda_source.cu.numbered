 2586: /**
 2587:  * This method performs backtracking from the side center until a time -dt back in time 
 2588:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2589:  * intermediate point.
 2590:  *
 2591:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2592:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2593:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2594:  * remaining time.
 2595:  * 
 2596:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2597:  * 
 2598:  * @param uuint, vvint, wwint: Velocities at the final point
 2599:  * @param jlev: Level at which the backtracking is performed
 2600:  * @param dt, dtbk: Tracking timesteps
 2601:  * @return: True if the backtracking was successful, false otherwise
 2602:  */
 2603: __inline__ __device__ bool Side::btrack(
 2604:       int jlev,
 2605:       double dt,            // Tracking time
 2606:       double dtbk,          // Tracking timestep
 2607:       Vector3 &u_int        // Velocities at the initial point
 2608: ) const {
 2609: 
 2610:    // Start from side center
 2611:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2612: 
 2613:  
 2614:    double time_rm = dt; // Remaining time
 2615: 
 2616: 
 2617:    // // Initialize outputs XXX
 2618:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2619:    //    sclr[i] = 0.0;
 2620:    // }
 2621: 
 2622: 
 2623:    // Initial velocities
 2624:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2625: 
 2626:    // Find the element that is in the direction opposite to the velocity
 2627:    Element* curElem = findElementTowards(toVector2(u_int));
 2628: 
 2629: 
 2630:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2631:    if (curElem == nullptr) {
 2632:       // Make velocity parallel to the side
 2633:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2634:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2635:       curElem = otherElem(curElem);
 2636:       
 2637:    }
 2638: 
 2639: // Nudges it towards the circumcenter
 2640: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2641: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2642:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2643: const double eps = 9.013e-3;                 
 2644: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2645: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2646: 
 2647: 
 2648: 
 2649:    const int MAX_ITERATIONS = 1000; 
 2650:    Element* nextElem = curElem;
 2651:    int iter = 0;
 2652:    while(true) {
 2653: 
 2654:       // Calculate timestep
 2655:       double dtb = min(dtbk, time_rm);
 2656: 
 2657:       // Next point in the backtracking curve
 2658:       Point3 xt = x0 - dtb*u_int;
 2659:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2660:       assert(found && "Backtracking failed in btrack");
 2661: 
 2662:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2663: 
 2664:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2665:                       // then time_rm needs to be increased by the unused time.
 2666: 
 2667:       // If the velocity is too small, we stop the backtracking
 2668:       const double vmag = length(toVector2(u_int));
 2669:       if (vmag <= velmin_btrack) break;
 2670: 
 2671:       // The current point becomes the next segment's starting point.
 2672:       x0 = xt;
 2673:  
 2674:       curElem = nextElem;
 2675: 
 2676:       iter++;
 2677:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2678:    }
 2679: 
 2680: 
 2681: }
 2682: 
 2683: 
