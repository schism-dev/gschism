 7935: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7936:    Element *elems = mesh->localElemData;
 7937: 
 7938:    *addr = elems;
 7939:    *sizeElement = sizeof(Element);
 7940:    switch (varCode) {
 7941:       case (int)VarCode::z:
 7942:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7943:          *sizeType = sizeof(double);
 7944:          break;
 7945:       case (int)VarCode::x:
 7946:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7947:          *sizeType = sizeof(Vector2);
 7948:          break;
 7949:       case (int)VarCode::area:
 7950:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7951:          *sizeType = sizeof(double);
 7952:          break;
 7953:       case (int)VarCode::depth:
 7954:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7955:          *sizeType = sizeof(double);
 7956:          break;
 7957:       case (int)VarCode::radius:
 7958:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7959:          *sizeType = sizeof(double);
 7960:          break;
 7961:       case (int)VarCode::lonlat:
 7962:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7963:          *sizeType = sizeof(double);
 7964:          break;
 7965:       case (int)VarCode::ghat:
 7966:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7967:          *sizeType = sizeof(Vector2);
 7968:          break;
 7969:       case (int)VarCode::kb:
 7970:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7971:          *sizeType = sizeof(int);
 7972:          break;
 7973:       case (int)VarCode::isdry:
 7974:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7975:          *sizeType = sizeof(int);
 7976:          break;            
 7977:       case (int)VarCode::w:
 7978:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7979:          *sizeType = sizeof(double);
 7980:          break;
 7981:       case (int)VarCode::FaceIndices:
 7982:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7983:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7984:          *sizeType = sizeof(Node);
 7985:          break;
 7986:       default:
 7987:          *offset = -1;
 7988:    }
 7989: }
