 2539: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2540: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2541: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2542: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2543: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2544: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2545:    Vector2 grad = {0.0, 0.0};
 2546:    int count = 0;
 2547: 
 2548:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2549: 
 2550:    // First element
 2551:    if (elems[0] != nullptr && condition(elems[0])) {
 2552:       grad += elems[0]->grad2(field);
 2553:       count++;
 2554:    }
 2555: 
 2556:    // Second element
 2557:    if (elems[1] != nullptr && condition(elems[1])) {
 2558:       grad += elems[1]->grad2(field);
 2559:       count++;
 2560:    }
 2561: 
 2562:    if (count > 0) {
 2563:       grad = grad/count;
 2564:    }
 2565:    
 2566:    return grad;
 2567: }
