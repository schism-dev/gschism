 2772: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2773:                 double *node_coords, double *wind_rotate_angle, 
 2774:                 int *isdel, int *isidenode, int *isbnd,
 2775:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2776:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2777:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2778:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2779:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2780:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2781:                 double *emo, double *efa, 
 2782:                 double *umo, double *ufa, 
 2783:                 double *vmo, double *vfa) {
 2784: 
 2785:    printf("Populating mesh for partition %d\n", partNum);
 2786: 
 2787:    // Horizontal grid
 2788:    printf("Processing %d nodes\n", np);    
 2789: 
 2790: 
 2791:    int idxNodeBoundary = 0;  
 2792:    for (int i = 0; i < np; i++)
 2793:    {
 2794:       Node &node = localNodeData[i];
 2795: 
 2796:       node.idx = i;
 2797: 
 2798:       const int idxNodeStart = nodeNeighNodesStart[i];
 2799:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2800:       node.numNodes = idxNodeEnd - idxNodeStart;
 2801:       node.nodes = nodeNeighNodes + idxNodeStart;
 2802:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2803: 
 2804: 
 2805: 
 2806:       const int idxElemStart = nodeNeighElemsStart[i];
 2807:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2808:       node.numElements = idxElemEnd - idxElemStart;
 2809:       node.elements = nodeNeighElems + idxElemStart;
 2810: 
 2811: 
 2812:       
 2813:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2814:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2815:          const int partNode = localNodePart[idxNodeGlobal]; 
 2816:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2817: 
 2818: 
 2819:          Node *node_ptr = nodes[partNode] + idxNode;
 2820:          
 2821:          nodeNeighNodes[idx] = node_ptr;
 2822:       }
 2823: 
 2824:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2825:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2826:          const int partElem = localElemPart[idxElemGlobal];
 2827:          const int idxElem  = localElemIndices[idxElemGlobal];
 2828: 
 2829:          Element *elem_ptr = elems[partElem] + idxElem;
 2830: 
 2831:          nodeNeighElems[idx] = elem_ptr;
 2832:       }      
 2833: 
 2834: 
 2835:       node.wind_angle = wind_rotate_angle[i];
 2836: 
 2837:       // Element **elements; // pointer to the elements connected to this node
 2838:       // int numElements;   // number of elements shared by this node
 2839: 
 2840:       node.p.x   = node_coords[i * 3];
 2841:       node.p.y   = node_coords[i * 3 + 1];
 2842:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2843:       node.depth = node_coords[i * 3 + 2];
 2844: 
 2845:       node.numSides = 0;
 2846: 
 2847: printf("EEEEEE idx = %d, isbnd[i] = %d, node.nodeBnd = %p\n", i, isbnd[i], node.nodeBnd);
 2848:       // Links the node to the boundary information
 2849:       if (isbnd[i] >= 0) {
 2850:        
 2851:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2852:          node.nodeBnd->node = &node;
 2853: 
 2854:          node.nodeBnd->sideBnd1 = nullptr;
 2855:          node.nodeBnd->sideBnd2 = nullptr;
 2856: 
 2857:          if (isbnd[i]>=0) {
 2858: 
 2859:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2860:             
 2861:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2862:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2863: 
 2864:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2865:             node.nodeBnd->segment->clen  = nan("1");
 2866:             node.nodeBnd->segment->carea = nan("1");
 2867: 
 2868:          }
 2869: //          else {
 2870: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2871: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2872: //          }
 2873:          
 2874:          idxNodeBoundary++;
 2875: printf("EEEEEEhhhh idx = %d, isbnd[i] = %d, idxNodeBoundary = %d\n", i, isbnd[i], idxNodeBoundary);         
 2876:       }
 2877:       else {
 2878:          node.nodeBnd = nullptr; // For internal nodes
 2879: printf("EEEEEQQ isbnd[i] = %d, node.nodeBnd = %p\n", isbnd[i], node.nodeBnd); 
 2880:          if (isbnd[i] == landSegment) {
 2881:             node.nodeBnd = &landBoundaryNode;
 2882:             node.nodeBnd->segment = &landBoundarySegment;
 2883:          }
 2884:          // node.nodeBnd->node = &node;
 2885:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2886:          // // node.nodeBnd = nullptr;
 2887:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2888:         
 2889:       }
 2890: 
 2891:       // XXXX GAUSSIAN HILL VELOCITIES
 2892: #ifdef GAUSSIAN_HILL_VELOCITIES
 2893:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2894:          constexpr double rot_per = 3000.0;
 2895:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2896:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2897:       // XXXXX
 2898: #endif
 2899:    }
 2900: 
 2901:    nbp = idxNodeBoundary;
 2902: 
 2903:    printf("Processing %d sides\n", ns);
 2904:    int idxSideBoundary = 0;
 2905:    for (int i = 0; i < ns; i++)
 2906:    {
 2907:       Side &side = localSideData[i];
 2908:       side.idx = i;
 2909:       // finding the pointer to the nodes that form the side
 2910:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2911:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2912: 
 2913:       const int locidx_n1 = localNodeIndices[idx_n1];
 2914:       const int locidx_n2 = localNodeIndices[idx_n2];
 2915:       const int part_n1 =   localNodePart[idx_n1];
 2916:       const int part_n2 =   localNodePart[idx_n2];
 2917: 
 2918:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2919:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2920: 
 2921:       // Counts the number of sides connected to each node
 2922:       side.n1->numSides++;
 2923:       side.n2->numSides++;
 2924: 
 2925:       // Normal, unitary vector to the side
 2926:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2927:       side.n = normalize(side.n);
 2928: 
 2929:       // Side boundary type
 2930:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2931:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2932: 
 2933:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2934:       // If both nodes are on the boundary, then the side may be on the boundary
 2935:       {
 2936:          bool isLand = false;
 2937:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2938: 
 2939:          if (isbs > -1) {
 2940:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2941:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2942:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2943: 
 2944:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2945:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2946:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2947: 
 2948:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2949:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2950:           
 2951:             side.sideBnd->side = &side;
 2952:             idxSideBoundary++;
 2953: 
 2954:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2955:          }
 2956:          
 2957: 
 2958:       // }
 2959:       // 
 2960: 
 2961: 
 2962: 
 2963: 
 2964: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2965: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2966: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2967: //       {
 2968: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2969: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2970: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2971: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2972: // if (side.sideBnd->segment == nullptr) continue;
 2973: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2974: //          else                  side.sideBnd->segment = n2bnd->segment;
 2975: //          side.sideBnd->side = &side;
 2976: //          idxSideBoundary++;
 2977: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2978:       }
 2979:       else side.sideBnd = nullptr;
 2980: 
 2981:       nbs = idxSideBoundary;
 2982: // printf("Here3: %d", i);
 2983:       // finding the pointer to the elements that share the side
 2984:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2985:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2986: 
 2987:       if (idx_e1 > -1) {
 2988:          const int locidx_e1 = localElemIndices[idx_e1];
 2989:          const int part_e1 =  localElemPart[idx_e1];
 2990:          side.elems[0] = elems[part_e1] + locidx_e1;
 2991: 
 2992:       }
 2993:       else {
 2994:          side.elems[0] = nullptr;
 2995:       }
 2996: // printf("Here4: %d", i);
 2997:       if (idx_e2 > -1) {
 2998:          const int locidx_e2 = localElemIndices[idx_e2];
 2999:          const int part_e2 =  localElemPart[idx_e2];
 3000:          side.elems[1] = elems[part_e2] + locidx_e2;
 3001:       }
 3002:       else {
 3003:          side.elems[1] = nullptr;
 3004:       }
 3005: // printf("Here5: %d", i);
 3006: 
 3007: 
 3008:       // Compute the center of the side
 3009:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3010: 
 3011: #ifdef GAUSSIAN_HILL_VELOCITIES
 3012: // XXXX
 3013: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3014: constexpr double rot_per=3000.0;
 3015: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3016: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3017: // XXXXX      
 3018: #endif
 3019:       // Compute the z level at the center of the side
 3020:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3021: 
 3022:       // Compute the length of the side
 3023:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3024:       side.len = sqrt(dot(vLen, vLen));
 3025: 
 3026:    }
 3027: 
 3028:    printf("Processing %d elements\n", ne);
 3029:    for (int i = 0; i < ne; i++)
 3030:    {
 3031:       Element &elem = localElemData[i];
 3032:       elem.idx = i;
 3033:       for (int j = 0; j < i34[i]; j++) {
 3034:          const int idxNode = elnode[i*4 + j];  
 3035:          const int idxSide = elside[i*4 + j];
 3036:          
 3037:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3038:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3039: 
 3040: 
 3041: 
 3042:          // Find the neighboring element  
 3043:          if (elem.sides[j]->elems[0] == &elem) {
 3044:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3045:          }
 3046:          else {
 3047:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3048:          }
 3049:          
 3050:       }
 3051: 
 3052:       elem.i34 = i34[i];
 3053: 
 3054: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 3055: 
 3056:       // Compute the centroid of the element and its depth
 3057:       Vector2 center = {0.0, 0.0};
 3058:       elem.depth = 0.0;
 3059:       for (int j = 0; j < i34[i]; j++) {
 3060:          center += elem.nodes[j]->p2()/i34[i];
 3061:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3062:       }
 3063:       elem.center.x = center.x;
 3064:       elem.center.y = center.y;
 3065: 
 3066:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 3067:       
 3068:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3069:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3070: 
 3071:       elem.area = elem.computeSignedArea(); 
 3072:       elem.radius = sqrt(elem.area)/pi; 
 3073:       
 3074:       // Determines which way the normal vector to each side is oriented.
 3075:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3076:       for (int j = 0; j < i34[i]; j++)  
 3077:       {
 3078:          if (elem.sides[j]->elems[0] == &elem) {
 3079:             elem.ssign[j] =  1.0;
 3080:          }
 3081:          else {
 3082:             elem.ssign[j] = -1.0;
 3083:          }
 3084: 
 3085:       }
 3086: 
 3087:       // Derivatives of shape functions
 3088:       //  For ics=2, this is done inside element/ll frame XXX
 3089:       //  For quads, the derivative is evaluated at centroid
 3090:       const int i34 = elem.i34;
 3091:       for (int j = 0; j < i34; j++) {
 3092:          const double area = elem.area;
 3093:          const int id2 = elem.nxq(1 + j);
 3094:          const int id3 = elem.nxq(2 + j);
 3095:          const int id4 = elem.nxq(3 + j);
 3096:          if (elem.isTri()) {
 3097:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3098:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3099:             // da1/dx = (y1 - y2)/(2*area)
 3100:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3101:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3102:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3103:          }
 3104:          else  { // Quad; evaluate at centroid
 3105:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3106:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3107:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3108:          } // if Tri
 3109: 
 3110:       } // for j
 3111: 
 3112:    }
 3113: 
 3114: 
 3115:    // Processing the boundary nodes
 3116:    int idx = 0;
 3117:    for (int iseg = 0; iseg < nope; iseg++) {
 3118:       
 3119:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 3120: 
 3121:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3122: 
 3123:          nodeBnd->isEssentialBC = true;
 3124: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3125:          nodeBnd->elbc = 0.0;
 3126: 
 3127:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3128:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 3129:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 3130:             nodeBnd->umo[jfr] = {umo[jfr + iseg*nbfr], vmo[jfr + iseg*nbfr]};
 3131:             nodeBnd->ufa[jfr] = {ufa[jfr + iseg*nbfr], vfa[jfr + iseg*nbfr]};
 3132: 
 3133:          }
 3134: 
 3135:          idx++;
 3136:       }
 3137: 
 3138:    }
 3139: 
 3140: }
