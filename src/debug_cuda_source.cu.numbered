 4061: 
 4062: __device__ __forceinline__ double Node::compZCoord(int k) const {
 4063:    // Computes the z coordinate at level k.
 4064:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 4065:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 4066:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 4067:    // used 
 4068: 
 4069:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 4070:    
 4071:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 4072: 
 4073:    if (isDry2()) return 0.0;  
 4074: 
 4075:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 4076: 
 4077:    if constexpr(ivcor == 2) {
 4078: 
 4079:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 4080:       const double h_c = mesh->h_c;
 4081:       const double theta_f = mesh->theta_f;
 4082:       const double sinh_theta_f = mesh->sinh_theta_f;
 4083: 
 4084: 
 4085:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 4086:       // The FORTAN code computes it every time this function is called, but it should be done only 
 4087:       // once per time step/node. XXXX
 4088:       // CHECK: updateZCoordData
 4089: 
 4090:       //  To simplify comparisons, I define index versions of count variables.
 4091:       if      (k == ivrt)     return eta2; 
 4092:       else if (k == izlev)    return -hmod2;
 4093:       else if (k == kb)       return -depth;
 4094:       else if (k < izlev)     return mesh->ztot[k];
 4095:       else if (k > izlev) {
 4096:          const int ksig = k - izlev;
 4097: 
 4098:          if (hmod2 <= h_c) {
 4099:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 4100: 
 4101:          } 
 4102:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 4103:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 4104:             assert(false && "compZCoord: invalid h_c\n");
 4105:          } 
 4106:          else {
 4107:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 4108:                    h_c * mesh->sigma[ksig] + 
 4109:                    (hmod2 - h_c) * mesh->cs[ksig];
 4110:          }
 4111:       } else { 
 4112:          assert(false && "compZCoord: invalid level or coordinate system\n");
 4113:       }
 4114: 
 4115:    }
 4116:    else {  // if constexpr(ivcor == 1)
 4117:       if (k <= kb)        return -depth; 
 4118:       else if (k == ivrt) return eta2;
 4119:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 4120: 
 4121:    }
 4122:    
 4123:    assert(false && "compZCoord: invalid level or coordinate system\n");
 4124:    return 0.0;
 4125: }
 4126: 
 4127: 
 4128: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 4129:    // Computes the bottom drag Cd based on the selected nchi
 4130: 
 4131:    if constexpr(nchi == 0) {
 4132:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 4133:       Cd = drag;  // Read from drag file
 4134: 
 4135:    } else if constexpr(nchi == 1) {
 4136:       // 
 4137: 
 4138:       bool ltmp = false; // for WBL iteration
 4139: 
 4140:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4141:       if (isDry || (rough == 0.0)) {
 4142:          Cd = 0.0;
 4143: 
 4144:       } else { //roughness >0 
 4145:          
 4146:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4147: 
 4148:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4149: 
 4150:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4151: 
 4152:       } // if rough
 4153: 
 4154:    } else if constexpr(nchi == -1) {
 4155:    // Manning 
 4156:  
 4157:       const double htot = max(hmin_man, htot2()); 
 4158:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4159: 
 4160:    } else {
 4161:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4162:       
 4163:    } // if nchi
 4164: 
 4165: }
 4166: 
 4167: 
 4168: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4169:    // Checks if a side in on the boundary
 4170:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4171: 
 4172:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4173:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4174: 
 4175:    // Indices of the nodes that form the side
 4176:    //
 4177:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4178:    const int n1 = side.n1->idx;
 4179:    const int n2 = side.n2->idx;
 4180:    isLand = false;
 4181:    
 4182: 
 4183:    // Check if the side is on a land boundary
 4184:    for (int i = 0; i < nland; i++) {
 4185:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4186:          // Consecutive nodes in the land boundary segment
 4187:          const int b1 = ilnd[i + j*nland];
 4188:          const int b2 = ilnd[i + (j + 1)*nland];
 4189: 
 4190:          assert(b1 != -1 && b2 != -1);
 4191: 
 4192:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4193:             
 4194:             isLand = true;
 4195:             return i;
 4196:          }
 4197:       }
 4198:    }
 4199: 
 4200:    // Check if the side is on an open boundary
 4201:    for (int i = 0; i < nope; i++) {
 4202:       for (int j = 0; j < nond[i] - 1; j++) {
 4203:          // Consecutive nodes in the open boundary segment
 4204:          const int b1 = iond[i + j*nope];
 4205:          const int b2 = iond[i + (j + 1)*nope];
 4206: 
 4207:          assert(b1 != -1 && b2 != -1);
 4208: 
 4209:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4210:             isLand = false;
 4211:             return i;
 4212:          }
 4213:       }
 4214:    }
 4215: 
 4216: 
 4217:    return -1;
 4218: }
 4219: 
 4220: 
 4221: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4222:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4223:                                     double *wind_rotate_angle, 
 4224:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4225:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4226:                                     int16_t *nodePermutationSort, double *crs_data,
 4227:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4228:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4229:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4230:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4231:                                     double *drag, double *roughness, double *rmanning, 
 4232:                                     double *diffmin, double *diffmax,
 4233:                                     double *temp, double *salt,
 4234:                                     int *kb, double *localSigma) {
 4235: 
 4236:    NODE(pnode);  
 4237:    const int i = idx_node;
 4238:    const int iglobal = globalNodeIndices[i];
 4239:    Node &node(*pnode);
 4240: 
 4241:    node.idx = iglobal;
 4242:    node.part = localNodePart[iglobal];
 4243: 
 4244:    // It is important to differentiate between the global and local "start" indices because they
 4245:    // play different, but related, roles in this code. The global "start" indices are used
 4246:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4247:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4248:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4249:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4250:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4251:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4252:    node.numNodes = idxNodeEnd - idxNodeStart;
 4253:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4254: 
 4255:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4256:    node.coeffRow = crs_data + rowStart; 
 4257: 
 4258:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4259: 
 4260: 
 4261: 
 4262:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4263:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4264:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4265:    node.numElements = idxElemEnd - idxElemStart;
 4266:    node.elements = nodeNeighElems + idxElemLocalStart;
 4267: 
 4268: 
 4269:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4270:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4271:       const int partNode = localNodePart[idxNodeGlobal]; 
 4272:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4273: 
 4274:       Node *node_ptr = nodes[partNode] + idxNode;
 4275:       
 4276:       nodeNeighNodes[idxLocal] = node_ptr;
 4277:    }
 4278: 
 4279: 
 4280:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4281:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4282:       const int partElem = localElemPart[idxElemGlobal];
 4283:       const int idxElem  = localElemIndices[idxElemGlobal];
 4284: 
 4285:       Element *elem_ptr = elems[partElem] + idxElem;
 4286: 
 4287:       nodeNeighElems[idxLocal] = elem_ptr;
 4288:    }      
 4289: 
 4290:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4291:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4292: 
 4293:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4294: 
 4295:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4296:    if constexpr(ics == 1) {
 4297:       node.p.x   = node_coords[i * 3];
 4298:       node.p.y   = node_coords[i * 3 + 1];
 4299:       node.gz = 0.0;
 4300: 
 4301:       if (use_ll) {                                    // <-- add
 4302:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4303:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4304:       }  
 4305: 
 4306:    } else {
 4307:       const double lon = deg2rad*node_coords[i * 3];
 4308:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4309: 
 4310:       Point3 p = computeXYZfromLatLon(lat, lon);
 4311:       node.p = toVector2(p);
 4312:       node.gz = p.z;
 4313:       node.lon = lon;
 4314:       node.lat = lat;
 4315: 
 4316:       #ifdef USE_FRAMES
 4317:       node.setFrame(lat, lon);
 4318:       #endif
 4319: 
 4320: 
 4321:    }
 4322: 
 4323:    node.depth = node_coords[i * 3 + 2];
 4324: 
 4325:    node.numSides = 0;
 4326: 
 4327:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4328:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4329:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4330:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4331:    else assert(false && "populateNodes: selected nchi not implemented.");
 4332: 
 4333:    // Populate the diffmin and diffmax values read from the files.
 4334:    // (Only used for GLS, GOTM, and SedimentMix.)
 4335:    node.turb.setDiffLimits(diffmin[iglobal], diffmax[iglobal]);
 4336: 
 4337:    // Cold-start T,S: vertically homogeneous nodal I.C. (temp.ic/salt.ic or barotropic constants).
 4338:    // tr0 keeps the initial field (e.g. type-3 open BC); tracers is the working nodal state.
 4339:    {
 4340:       const double t0 = temp[iglobal];
 4341:       const double s0 = salt[iglobal];
 4342:       for (int k = 0; k < nvrt; k++) {
 4343:          node.tr0[k].tracer[0]     = t0;
 4344:          node.tr0[k].tracer[1]     = s0;
 4345:          node.tracers[k].tracer[0] = t0;
 4346:          node.tracers[k].tracer[1] = s0;
 4347:       }
 4348:    }
 4349: 
 4350:    if constexpr(ivcor == 1) 
 4351:    {  
 4352:       node.kb = kb[iglobal];
 4353: 
 4354:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4355:    }
 4356: 
 4357:    for (int k = 0; k < nvrt; k++) {
 4358:       node.rho[k] = rho0;
 4359:       node.z[k] = -1e20;
 4360:    }
 4361: 
 4362:    // Initialize the turbulence model including the vertical viscosity/diffusivity
 4363:    node.turb.init(&node);
 4364: 
 4365:    
 4366:    // Links the node to the boundary information
 4367:    if (isbnd[iglobal] >= 0) {
 4368:      
 4369:       // Get the index of the node boundary
 4370:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4371: 
 4372:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4373:       node.nodeBnd->node = &node;
 4374: 
 4375:       node.nodeBnd->sideBnd1 = nullptr;
 4376:       node.nodeBnd->sideBnd2 = nullptr;
 4377: 
 4378:       if (isbnd[iglobal]>=0) {
 4379: 
 4380:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4381:          
 4382:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4383:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4384: 
 4385:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4386:          node.nodeBnd->segment->clen  = nan("1");
 4387:          node.nodeBnd->segment->carea = nan("1");
 4388: 
 4389:       }
 4390:    } else {
 4391: 
 4392:       node.nodeBnd = nullptr; // For internal nodes
 4393: 
 4394:       if (isbnd[iglobal] == landSegment) {
 4395:          node.nodeBnd = landBoundaryNode;
 4396:          node.nodeBnd->segment = landBoundarySegment;
 4397:       }
 4398:       
 4399:    }
 4400:    
 4401:    // XXXX GAUSSIAN HILL VELOCITIES
 4402:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4403:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4404:          constexpr double rot_per = 3000.0;
 4405:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4406:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4407:       // XXXXX
 4408:    #endif
 4409: 
 4410: }
 4411: 
 4412: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4413:    
 4414:    NODE(node);
 4415:    const int localIdx = idx_node;
 4416: 
 4417: 
 4418:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4419:    int16_t *csrSlot = node->csrSlot;  
 4420: 
 4421:    // Simply count the number of nodes with a smaller global index than the current node.
 4422:    // It accounts for the diagonal element.
 4423:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4424:    // local index, but taking into account all the partitions (in order).
 4425:    for (int i = 0; i < node->numNodes; ++i) {
 4426:       const int col = node->nodes[i]->packedIndex();
 4427:       int16_t idx = 0;
 4428: 
 4429:       //Takes care of the diagonal element.
 4430:       if (node->packedIndex() < col) ++idx;          
 4431: 
 4432:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4433:       csrSlot[i] = idx;
 4434:    }
 4435: 
 4436:    // Find the diagonal element in the CRS matrix.
 4437:    int16_t idxDiag = 0;
 4438:    for (int j = 0; j < node->numNodes; ++j)
 4439:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4440: 
 4441:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4442: 
 4443:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4444:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4445: 
 4446:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4447:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4448:    crs_indptr[localIdx] = rowStart;
 4449: 
 4450:    // Fills crs_indices array using the per-partition indexing.
 4451:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4452:    crs_indices[rowStart + d] = node->packedIndex();  
 4453:    for (int j = 0; j < node->numNodes; ++j) {
 4454:       Node *nb = node->nodes[j];
 4455:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4456:    }
 4457: 
 4458: 
 4459: }
 4460: 
 4461: 
 4462: 
 4463: 
 4464: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4465:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4466:                                     double *wind_rotate_angle,   
 4467:                                     int *isdel, int *isidenode, int *isbnd,
 4468:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4469:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4470:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4471:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4472:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4473:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4474:                                     double *drag, double *roughness) {
 4475: 
 4476: 
 4477:    SIDE(pside);
 4478:    Side &side(*pside);
 4479:    const int i = idx_side;
 4480:    const int iglobal = globalSideIndices[i];
 4481:    side.idx = iglobal;  
 4482:    
 4483:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4484:    const double fc   = 2.0*omega_e*sin(sfea0);
 4485:    const double beta = 2.0*omega_e*cos(sfea0);
 4486: 
 4487:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4488: 
 4489:    // finding the pointer to the nodes that form the side
 4490:    const int idx_n1 = isidenode[iglobal*2];
 4491:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4492: 
 4493: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4494: 
 4495:    const int locidx_n1 = localNodeIndices[idx_n1];
 4496:    const int locidx_n2 = localNodeIndices[idx_n2];
 4497:    const int part_n1 =   localNodePart[idx_n1];
 4498:    const int part_n2 =   localNodePart[idx_n2];
 4499: 
 4500: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4501: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4502: 
 4503:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4504:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4505: 
 4506: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4507: 
 4508:    // Counts the number of sides connected to each node
 4509:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4510:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4511: 
 4512:    // Side boundary type
 4513:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4514:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4515: // if (i == 0) printf("populateSides: 2\n");
 4516: 
 4517:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4518:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4519:    {
 4520:       bool isLand = false;
 4521:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4522:       
 4523:       if (isbs > -1) {
 4524:          // assert(isLand || isbs>=0);
 4525:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4526: 
 4527:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4528: 
 4529:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4530:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4531: 
 4532:          assert (isLand == side.sideBnd->segment->isLand);
 4533:          
 4534:          side.sideBnd->side = &side;
 4535: 
 4536:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4537:          n1bnd->linkSideBoundary(side.sideBnd);
 4538:          n2bnd->linkSideBoundary(side.sideBnd);
 4539: 
 4540:       }
 4541:       else {
 4542:          side.sideBnd = nullptr;
 4543:       }
 4544:    }
 4545:    else 
 4546:    {
 4547:       side.sideBnd = nullptr;
 4548:    }
 4549: 
 4550: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4551: 
 4552:    // finding the pointer to the elements that share the side
 4553:    const int idx_e1 = isdel[iglobal*2];
 4554:    const int idx_e2 = isdel[iglobal*2 + 1];
 4555: 
 4556:    if (idx_e1 > -1) {
 4557:       const int locidx_e1 = localElemIndices[idx_e1];
 4558:       const int part_e1 =  localElemPart[idx_e1];
 4559:       side.elems[0] = elems[part_e1] + locidx_e1;
 4560: 
 4561:    }
 4562:    else {
 4563:       side.elems[0] = nullptr;
 4564:    }
 4565: 
 4566: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4567: 
 4568:    if (idx_e2 > -1) {
 4569:       const int locidx_e2 = localElemIndices[idx_e2];
 4570:       const int part_e2 =  localElemPart[idx_e2];
 4571:       side.elems[1] = elems[part_e2] + locidx_e2;
 4572:    }
 4573:    else {
 4574:       side.elems[1] = nullptr;
 4575:    }
 4576: 
 4577: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4578: 
 4579:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4580:       
 4581:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4582:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4583:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4584:          
 4585:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4586:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4587:       // printf("sideBnd: %p\n", side.sideBnd);
 4588:       // assert(false && "Side has no elements and no boundary");
 4589:    }
 4590:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4591: 
 4592:    // Compute the center of the side
 4593:    side.center = 0.5*(side.n1->p + side.n2->p);
 4594: 
 4595:    #ifdef USE_FRAMES
 4596:    side.setFrame();
 4597:    #endif
 4598: 
 4599: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4600: 
 4601:    // Normal, unitary vector to the side
 4602:    if constexpr(ics == 1) {
 4603:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4604:       side.n = normalize(side.n);
 4605:    }
 4606:    else {
 4607:       // Unit side vector in 3D cartesian coordinates
 4608:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4609: 
 4610:       nSide = normalize(nSide);
 4611: 
 4612:       // Its cross product with the unit local z-axis vector (nUp) is the
 4613:       // normal vector we are looking for.
 4614:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4615: 
 4616:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4617:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4618:       side.n = -normalize(n2D); 
 4619: 
 4620:    }
 4621: 
 4622: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4623: 
 4624:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4625:    side.shapiro = shapiro0;
 4626: 
 4627:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4628:    // XXXX
 4629:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4630:    constexpr double rot_per=3000.0;
 4631:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4632:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4633:    // XXXXX      
 4634:    #endif
 4635:    // Compute the z level at the center of the side
 4636:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4637:    
 4638:    // Compute the length of the side
 4639:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4640: 
 4641: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4642: 
 4643:    // Compute the Coriolis coefficient
 4644: 
 4645:    if constexpr(ncor == -1 || ncor == 0) {
 4646:       side.coriolis = coricoef;
 4647:    }
 4648:    else {
 4649:       const double sphi = side.lat();  // Latitude at the center of the side
 4650: 
 4651:       assert(use_ll && "use_ll must be true when ncor > 0");
 4652: 
 4653:       if constexpr(ics == 1) {
 4654:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4655:       }
 4656:       else { // ics == 2
 4657:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4658:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4659:       }
 4660: 
 4661:    }
 4662: 
 4663: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4664: 
 4665: }
 4666: 
 4667: 
 4668: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4669:    double *node_coords, double *node_coords_ll, bool use_ll,
 4670:    double *wind_rotate_angle,   
 4671:    int *isdel, int *isidenode, int *isbnd,
 4672:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4673:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4674:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4675:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4676:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4677:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4678:    double *drag, double *roughness) {
 4679: 
 4680:    ELEM(pelem);
 4681:    Element &elem(*pelem);
 4682:    const int i = idx_elem;
 4683: 
 4684:    elem.idx = i;
 4685: 
 4686:    for (int j = 0; j < i34[i]; j++) {
 4687:       const int idxNode = elnode[i*4 + j];  
 4688:       const int idxSide = elside[i*4 + j];
 4689:       
 4690:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4691:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4692: 
 4693:       // Find the neighboring element  
 4694:       if (elem.sides[j]->elems[0] == &elem) {
 4695:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4696:       }
 4697:       else {
 4698:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4699:       }
 4700:       
 4701:    }
 4702: 
 4703:    elem.i34 = i34[i];
 4704: 
 4705:    // Compute the barycenter of the element and its depth
 4706:    elem.center = {0.0, 0.0};
 4707:    elem.depth = 1e10;
 4708:    for (int j = 0; j < i34[i]; j++) {
 4709: 
 4710:       elem.center += elem.nodes[j]->p/i34[i];
 4711:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4712:    }
 4713: 
 4714:    #ifdef USE_FRAMES
 4715:    elem.setFrame();
 4716:    #endif
 4717: 
 4718:    elem.area = elem.computeSignedArea(); 
 4719:    elem.radius = sqrt(elem.area)/pi; 
 4720:    
 4721:    // Determines which way the normal vector to each side is oriented.
 4722:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4723:    for (int j = 0; j < i34[i]; j++)  
 4724:    {
 4725:       if (elem.sides[j]->elems[0] == &elem) {
 4726:          elem.ssign[j] =  1.0;
 4727:       }
 4728:       else {
 4729:          elem.ssign[j] = -1.0;
 4730:       }
 4731: 
 4732:    }
 4733: 
 4734:   
 4735: 
 4736:    // Derivatives of shape functions
 4737:    //  For ics=2, this is done in the element frame
 4738:    //  For quads, the derivative is evaluated at centroid
 4739:    for (int j = 0; j < elem.i34; j++) {
 4740:       const double area = elem.area;
 4741:       const int id2 = elem.nxq(1 + j);
 4742:       const int id3 = elem.nxq(2 + j);
 4743:       const int id4 = elem.nxq(3 + j);
 4744:       if (elem.isTri()) {
 4745:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4746:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4747:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4748:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4749:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4750:          // And so on for the other shape functions.
 4751: 
 4752:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4753:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4754:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4755: 
 4756:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4757:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4758: 
 4759:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4760: 
 4761:       }
 4762:       else  { // Quad, the derivatives are evaluated at the centroid
 4763: 
 4764:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4765:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4766:          // ...
 4767:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4768: 
 4769:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4770:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4771:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4772: 
 4773:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4774:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4775: 
 4776:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4777: 
 4778:       } // if Tri/Quad
 4779: 
 4780:    } // for j   
 4781: 
 4782:    // Initial element tracers: average surrounding nodal I.C. (levels k and k-1)
 4783:    // For level k: average of node values at k and k-1 over the element nodes.
 4784:    // Level 0 copies level 1 (Fortran tr_el(:,1)=tr_el(:,2)).
 4785:    const double inv = 1.0 / (2.0 * elem.i34);
 4786:    for (int k = 1; k < nvrt; k++) {
 4787:       Tracers sum = {};
 4788:       for (int j = 0; j < elem.i34; j++) {
 4789:          const Node *nd = elem.nodes[j];
 4790:          for (int itr = 0; itr < ntracers; itr++)
 4791:             sum.tracer[itr] += nd->tr0[k].tracer[itr] + nd->tr0[k - 1].tracer[itr];
 4792:       }
 4793:       for (int itr = 0; itr < ntracers; itr++)
 4794:          elem.tracers[k].tracer[itr] = inv * sum.tracer[itr];
 4795:    }
 4796:    elem.tracers[0] = elem.tracers[1];
 4797: 
 4798: }
 4799: 
 4800: 
 4801: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4802:                                             double *emo, double *efa, 
 4803:                                             double *umo, double *ufa, 
 4804:                                             double *vmo, double *vfa,
 4805:                                             int *ifltype, int *iettype, 
 4806:                                             double *qthcon, double *eth) {
 4807: 
 4808:    NODE_BND(nodeBnd);
 4809:    const int idx = idx_node_bnd;    
 4810: 
 4811:    nodeBnd->idx = idx;
 4812: 
 4813:    // Need to find the segment index and the index of the node on the segment
 4814:    int idxNode = -1;
 4815:    int iseg, i;
 4816:    for (iseg = 0; iseg < nope; iseg++) {
 4817:       // for each segment...
 4818:       for (i = 0; i < nond[iseg]; i++) {
 4819:          idxNode = iond[iseg + i*nope];
 4820:          if (idxNode == nodeBnd->node->idx) 
 4821:          {
 4822:             // This is done for every segment that the node is part of, overwriting the previous values.
 4823:             // The result is that the segment with the highest index is the one that is used.
 4824:             nodeBnd->isEssentialBC = (iettype[iseg] != 0);
 4825:             nodeBnd->elbc = 0.0;
 4826: 
 4827:             // XXXXXX This may make more sense in populateBoundarySides.
 4828:             nodeBnd->segment->ifltype = ifltype[iseg];
 4829:             nodeBnd->segment->iettype = iettype[iseg];
 4830:             nodeBnd->segment->qthcon  = qthcon[iseg];
 4831:             nodeBnd->segment->eth     = eth[iseg];
 4832:             nodeBnd->eth     = eth[iseg]; // XXXXXXX Is this always needed? ot only for certain ietype?
 4833:             nodeBnd->segment->idx = iseg;
 4834: 
 4835:             for (int jfr = 0; jfr < nbfr; jfr++) {
 4836: 
 4837:                const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4838: 
 4839:                nodeBnd->efa[jfr] = efa[idx2];
 4840:                nodeBnd->emo[jfr] = emo[idx2];
 4841: 
 4842:             }
 4843:          }         
 4844:       }
 4845:    }
 4846: 
 4847: 
 4848:    assert(iseg <= nope && "iseg is out of bounds");
 4849: 
 4850: 
 4851: 
 4852: 
 4853:         
 4854: 
 4855: }
 4856: 
 4857: __device__ void Mesh::populateBoundarySides(int *nond, int *iond,
 4858:                                             double *emo, double *efa, 
 4859:                                             double *umo, double *ufa, 
 4860:                                             double *vmo, double *vfa,
 4861:                                             int *ifltype, int *iettype, double *qthcon) {
 4862: 
 4863:    SIDE_BND(sideBnd);
 4864: 
 4865:    const Side *side = sideBnd->side;
 4866: 
 4867: 
 4868:    // Indices of the nodes on the side 
 4869:    const int n1 = side->n1->idx;
 4870:    const int n2 = side->n2->idx;
 4871: 
 4872:    const int iseg = sideBnd->segment->idx;
 4873: 
 4874:    // Find the index of the side in the segment data array.
 4875:    for (int i = 0; i < nond[iseg] - 1; i++) {
 4876: 
 4877:       // Indices of the nodes at both ends of the side (obtained from the boundary node list)
 4878:       const int b1 = iond[iseg + i*nope];
 4879:       const int b2 = iond[iseg + (i + 1)*nope];
 4880: 
 4881:       // Find the side that connects the two nodes by comparing the indices of the nodes at both ends of the side (computed from 
 4882:       // the boundary node list) with the indices of the nodes at the ends of the side (obtained from the side structure).
 4883:       if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4884: 
 4885:          for (int jfr = 0; jfr < nbfr; jfr++) {
 4886:          // For each tidal component...
 4887: 
 4888:             const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4889: 
 4890:             // velocity magnitude at both ends of the side (1,2)            
 4891:             const double umo1 = umo[idx2];
 4892:             const double vmo1 = vmo[idx2];
 4893:             const double umo2 = umo[idx2 + nope];
 4894:             const double vmo2 = vmo[idx2 + nope];
 4895: 
 4896:             // velocity phases at both ends of the side (1,2)
 4897:             const double ufa1 = ufa[idx2];
 4898:             const double vfa1 = vfa[idx2];
 4899:             const double ufa2 = ufa[idx2 + nope];
 4900:             const double vfa2 = vfa[idx2 + nope];
 4901: 
 4902:             // These expressions compute the amplitude and phase of the velocity components at the center of the side.
 4903:             // The expressions replicate SCHISM by computing equivalent amplitude and phase for the velocity components at the center of the side.
 4904:             // Equivalent to SCHISM: average of the two reconstructed node tides
 4905:             //   0.5 * (a1*cos(theta - phi1) + a2*cos(theta - phi2))
 4906:             // with theta = amig*t + face. Folded here into one (umo, ufa) per
 4907:             // frequency so the step only does ramp*ff*umo*cos(theta - ufa).
 4908:             // Fortran keeps both (a, phi) on the nodes and averages after the
 4909:             // cosines; the result is the same.
 4910:             sideBnd->umo[jfr] = {0.5*sqrt(pow<2>(umo1) + pow<2>(umo2) + 2*umo1*umo2*cos(ufa1 - ufa2)), 0.5*sqrt(pow<2>(vmo1) + pow<2>(vmo2) + 2*vmo1*vmo2*cos(vfa1 - vfa2))};
 4911:             sideBnd->ufa[jfr] = {atan2(umo1*sin(ufa1) + umo2*sin(ufa2), umo1*cos(ufa1) + umo2*cos(ufa2)), atan2(vmo1*sin(vfa1) + vmo2*sin(vfa2), vmo1*cos(vfa1) + vmo2*cos(vfa2))};
 4912: 
 4913:          } // for jfr
 4914: 
 4915:       }
 4916:    }
 4917: 
 4918: 
 4919: }
 4920: 
 4921: __device__ void Mesh::populateBoundarySideLinks(void) {
 4922: 
 4923:    SIDE_BND(sideBnd);
 4924: 
 4925:    const Side *side = sideBnd->side;
 4926: 
 4927:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4928:    // and the rightSide is the side s that has s->n1 == side->n2
 4929:    for (int i = 0; i < mesh->nbs; i++) {
 4930: 
 4931:       Side *s = &mesh->localSideData[i];
 4932: 
 4933:       if (s == side) continue;  // Do not link the side to itself
 4934:    
 4935:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4936:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4937:    }
 4938: 
 4939:   
 4940: }
