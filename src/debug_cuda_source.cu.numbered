 1185: struct Node {
 1186: 
 1187:    // Geometry information
 1188:    int idx;        // Index of the node
 1189:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1190:    int numNodes;   // Number of nodes neighbors of this node
 1191: 
 1192:    Element **elements; // Array of pointers to the elements that share this node
 1193:    int numElements;    // Number of elements that share this node
 1194: 
 1195:    int numSides;       // Number of sides that are connected to this node
 1196: 
 1197:    Point2 p;
 1198:    Vector2 u2[nvrt];
 1199:    double  w2[nvrt];
 1200:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1201:    double z[nvrt];
 1202:    double lon, lat;
 1203:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1204:    double depth;
 1205: 
 1206:    int kb;       // Bottom index of the node
 1207: 
 1208:    bool isDry;     // True if the node is dry
 1209: 
 1210:    int iadv;     // Advection flag
 1211: 
 1212:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1213:                           // this is nullptr
 1214: 
 1215:    TempVar tmp; // Temporary variable to store different types of variables
 1216: 
 1217:    // Physical information
 1218:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1219:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1220: 
 1221:    double rho[nvrt];     // Density
 1222:    double dfv[nvrt];     // Vertical viscosity
 1223: 
 1224:    double eta1; // Elevation at nodes at previous timestep
 1225:    double eta2; // Elevation at nodes at current timestep
 1226: 
 1227:    double ETP;  // Earth Tidal Potential
 1228: 
 1229:    double pr;    // Air pressure
 1230:    double grav2; // Gravity 
 1231:    
 1232:    Vector2 dav;  // Depth averaged velocity
 1233: 
 1234:    Vector2 tau; // Wind stress vector
 1235: 
 1236:    // Vegetation parameters
 1237:    double veg_h;
 1238:    double veg_nv;
 1239:    double veg_di;
 1240:    double veg_Cd;
 1241:    double veg_h_unbent;
 1242:    double veg_di_unbent;
 1243:    double veg_nv_unbent;
 1244:    double veg_alpha_vert_mean;
 1245:    double veg_alpha0;
 1246:    double veg_alpha3D[nvrt];
 1247: 
 1248:    // Bottom drag parameters
 1249:    double Cd;       // Bottom drag coefficient   
 1250: 
 1251:    // These three are mutually exclusive
 1252:    union {
 1253:       double rmanning; // Bottom Manning's coefficient
 1254:       double rough;    // Bottom roughness length
 1255:       double drag;     // Bottom drag coefficient
 1256:    };
 1257:    Vector2 tau_bot; // Bottom stress vector
 1258: 
 1259:    double bdef1; // Bottom deformation at previous timestep
 1260:    double bdef2; // Bottom deformation at current timestep
 1261: 
 1262:    double qel; // RHS
 1263:    double coeffDiag; // Diagonal coefficient of the matrix
 1264:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1265: 
 1266:    double mP; // Search direction for conjugate gradient method
 1267:    double mR; // Residual for conjugate gradient method
 1268:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1269:    double mX; // Solution for conjugate gradient method
 1270: 
 1271:    // Meteorological forcing
 1272:    Vector2 u_air;
 1273:    double p_air;
 1274:    double t_air;
 1275:    double q_air;
 1276:    double wind_angle;  // Wind rotation angle
 1277: 
 1278:    __device__ void setWind(Vector2 &u) {
 1279:    // Sets the wind vector taking into account the wind rotation angle
 1280:    
 1281:       const double dir = atan2(-u.x,-u.y);
 1282:       const double speed = length(u);
 1283: 
 1284:       // Calculate new u and v components with added rotation angle
 1285:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1286:    }
 1287: 
 1288: 
 1289:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1290: 
 1291:    __device__ double sigmaTransitionDepth(void) const;
 1292: 
 1293:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1294:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1295:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1296:    
 1297:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1298: 
 1299:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1300: 
 1301:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1302:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1303: 
 1304:    __device__ __forceinline__ void clearMatrixRow(void) {
 1305:       // Clear the matrix row for this node
 1306: 
 1307: 
 1308:       coeffDiag = 0.0;
 1309: 
 1310:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1311: 
 1312:    }
 1313: 
 1314:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1315:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1316:       
 1317:       if (node == this) {
 1318:          coeffDiag += value;
 1319:      
 1320:       } else {
 1321:          // Search (linearly)the index of the node in the array of nodes
 1322:          // XXX: This is not efficient, see if we can improve this
 1323:          int i;
 1324:          for (i = 0; i < numNodes; i++) {
 1325:             if (nodes[i] == node) {
 1326:                break;
 1327:             }
 1328:          }
 1329:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1330:          coeffMatrix[i] += value;
 1331:       }
 1332:    }
 1333: 
 1334: 
 1335:    __device__ __inline__ void updateZCoordData(void);
 1336: 
 1337:    __device__ double compZCoord(int k) const;
 1338: 
 1339:    __device__ void updateKb(void);
 1340: 
 1341:    __device__ __forceinline__ void computeBottomDragCd(void);
 1342: 
 1343: 
 1344: 
 1345: };
