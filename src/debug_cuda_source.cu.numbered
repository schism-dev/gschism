 3565: 
 3566: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3567:    if constexpr(ics == 1) {
 3568:       return center;
 3569: 
 3570:    } else {
 3571:       const Point2 p0 = n1->outputCoords();
 3572:       const Point2 p1 = n2->outputCoords();
 3573:       return (1.0/2.0)*(p0 + p1);
 3574: 
 3575:    }
 3576: }
 3577: 
 3578: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3579: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3580: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3581: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3582: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3583: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3584: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3585: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3586: // Computes the gradient of the field at the side center.
 3587:    Vector2 grad = {0.0, 0.0};
 3588:    int count = 0;
 3589: 
 3590:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3591:    // as the average of the gradients at each element.
 3592:    // First element
 3593:    if (elems[0] != nullptr && condition(elems[0])) {
 3594:       Vector2 elemGrad = elems[0]->grad2(field);
 3595: 
 3596:       // For ics=2, projects the element gradient from its frame to the side frame
 3597:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3598: 
 3599:       grad += elemGrad;
 3600: 
 3601:       count++;
 3602:    }
 3603: 
 3604:    // Second element
 3605:    if (elems[1] != nullptr && condition(elems[1])) {
 3606: 
 3607:       Vector2 elemGrad = elems[1]->grad2(field);
 3608: 
 3609:       // For ics=2, projects the element gradient from its frame to the side frame
 3610:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3611: 
 3612:       grad += elemGrad;
 3613: 
 3614:       count++;
 3615:    }
 3616: 
 3617:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3618:    if (count > 0) {
 3619:       grad = grad*(1.0/count);
 3620:    }
 3621:    
 3622:    return grad;
 3623: }
 3624: 
 3625: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3626: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3627: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3628: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3629: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3630: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3631: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3632: 
 3633: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3634: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3635: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3636: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3637: 
 3638: 
 3639: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3640: 
 3641: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3642:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3643:    if constexpr(ics == 1) { 
 3644:       return 0.5*(n1->tau + n2->tau);
 3645: 
 3646:    } else {
 3647:       // Project the tau from the node frames to the side frame
 3648:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3649:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3650: 
 3651:       return 0.5*(stau1 + stau2);
 3652:    }
 3653: }
 3654: 
 3655: /**
 3656:  * This method performs backtracking from the side center until a time -dt back in time 
 3657:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3658:  * intermediate point.
 3659:  *
 3660:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3661:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3662:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3663:  * remaining time.
 3664:  * 
 3665:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3666:  * 
 3667:  * @param uuint, vvint, wwint: Velocities at the final point
 3668:  * @param jlev: Level at which the backtracking is performed
 3669:  * @param dt, dtbk: Tracking timesteps
 3670:   */
 3671: __inline__ __device__ void Side::btrack(
 3672:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3673:       double dt,            // Tracking time
 3674:       double dtbk,          // Tracking timestep
 3675:       Vector3 &u_int        // Velocities at the initial point
 3676: ) const {
 3677: 
 3678:    // Start from side center
 3679:    Point3 x0;
 3680: 
 3681:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3682:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3683: 
 3684:  
 3685:    double time_rm = dt; // Remaining time
 3686:    double time_rm_1 = 1e10;
 3687:    double time_rm_2 = 2e10;
 3688:    double time_rm_3 = 3e10;
 3689: 
 3690: 
 3691:    // Initial velocities
 3692:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3693: 
 3694:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3695:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3696: 
 3697:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3698: 
 3699: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3700: 
 3701: 
 3702:    constexpr int MAX_ITERATIONS = 100; 
 3703:    int iter = 0;
 3704:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3705:    while(true) {
 3706: 
 3707:       // Calculate timestep
 3708:       const double dtb = min(dtbk, time_rm);
 3709: 
 3710:       // Next point in the backtracking curve
 3711:       xt = x0 - dtb*u_int;
 3712: 
 3713:       double t, s; // parameters for the line segments p0pt and p1p2
 3714:       Side *lastCrossSide = nullptr;
 3715:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3716: 
 3717: 
 3718:       if (time_rm_3 <= time_rm) {
 3719:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3720:          xt = x0;
 3721:          break;
 3722:       }
 3723: 
 3724: 
 3725:       if (!found) {
 3726:       // This means that the walk reached a boundary or a dry element.
 3727: 
 3728:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3729: 
 3730:          // Finds the point at the boundary where the line segment x0xt intersects.
 3731:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3732:          // due to floating point errors, it does not exactly intersect.
 3733:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3734:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3735:          // To compute the intersection point we start with the parametric equations.
 3736:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3737:          // We cross-prouct by v1 to cancel the s term:
 3738:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3739:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3740: 
 3741:          // Side coordinates in the origSide frame.
 3742:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3743:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3744: 
 3745:          Point2  p0 = {x0.x, x0.y};
 3746:          Point2  pt = {xt.x, xt.y};
 3747: 
 3748:          const Vector2 v1 = pt - p0;
 3749:          const Vector2 v2 = p2 - p1;
 3750: 
 3751: 
 3752: 
 3753:          // We are assuming intersection, so we clamp t to the range [0,1].
 3754:          const double denom = cross(v2, v1);
 3755:          
 3756: 
 3757: 
 3758: 
 3759:          if (abs(denom) < small) {
 3760:             // small denominators are fairly common. They occur when the line segment x0xt 
 3761:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3762:             // boundary, where the backtracking curve startt sliding along the boundary.
 3763:             // In this case, we simply assume that the two lines are very close to each other
 3764:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3765:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3766:             if (t<0.0000000001) t = 0.0;
 3767:             if (t>0.9999999999) t = 1.0;
 3768: 
 3769:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3770:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3771: 
 3772:          }
 3773:          else {
 3774:             
 3775:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3776:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3777:             if (t>0.9999999999) t = 1.0;
 3778:             // From the originaL equation we can solve for s:
 3779:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3780:             // Computing the dot product by v1, we get:
 3781:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3782:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3783:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3784: 
 3785:          }
 3786: 
 3787:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3788: 
 3789: 
 3790:          // We update the new target point to be right at the intersection point,
 3791:          // and the remaining time must include the time we haven't "used".
 3792:          time_rm -= s*dtb;
 3793:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3794: 
 3795: 
 3796:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3797:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3798: 
 3799:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3800:          // but extracting only the component along the tangent vector v2.
 3801:          Vector2 tangent = normalize(v2);
 3802:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3803: 
 3804:          const Vector2 u2D = make_double2(u.x, u.y);
 3805:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3806: 
 3807: 
 3808:       } else {
 3809: 
 3810:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3811: 
 3812:          time_rm -= dtb; 
 3813: 
 3814:          u_int = curElem->interpolateVelocities(xt, this);
 3815: 
 3816:       }
 3817: 
 3818:       if (time_rm <= 0.0) break; 
 3819: 
 3820:       // If the velocity is too small, we stop the backtracking
 3821:       const double vmag2 = norm2(toVector2(u_int));
 3822:       if (vmag2 <= velmin_btrack_sq)  {
 3823:          time_rm = 0.0; 
 3824:          return; 
 3825:       }
 3826: 
 3827:       // The current point becomes the next segment's starting point.
 3828:       x0 = xt;
 3829:  
 3830:       iter++;
 3831: 
 3832: // XXXXXXXXXXXXXXXXX
 3833: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3834:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3835: 
 3836:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3837:       time_rm_3 = time_rm_2;
 3838:       time_rm_2 = time_rm_1;
 3839:       time_rm_1 = time_rm;
 3840:    }
 3841: 
 3842:    assert(curElem != nullptr && "Final element is nullptr");
 3843:    assert(!curElem->isDry && "Final element is dry");
 3844:    
 3845: 
 3846: 
 3847:    // Interpolate the velocities at the final point with respect to the current side frame
 3848:    u_int = curElem->interpolateVelocities(xt, this);
 3849: 
 3850: 
 3851: }
 3852: 
 3853: 
 3854: 
 3855: __device__ __forceinline__ int Node::localIndex() const {
 3856:    // Returns the local index of the node in the partition
 3857:    // Local index is just the offset from the start of the partition's node memory
 3858:    return int(this - mesh->nodes[part]);
 3859: }
 3860: 
 3861: 
 3862: __device__ __forceinline__ int Node::packedIndex() const {
 3863:    // Returns the packed index of the node
 3864:    // Packed index is the index of the partition-block matrices and vectors.
 3865:    return nodeOffsetPerPartition[part] + localIndex();
 3866: }
