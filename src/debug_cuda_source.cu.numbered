 3148: 
 3149: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3150:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3151:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3152:    // 
 3153:    // This kernel is called for all nodes.
 3154: 
 3155: 
 3156:    NODE(node1);
 3157: 
 3158: 
 3159:    node1->clearMatrixRow();
 3160:    node1->qel = 0.0;
 3161: 
 3162:    // THIS IS FOR STRUCTURES XXX
 3163:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3164: 
 3165:    
 3166:    for (int j=0; j<node1->numElements; j++) {
 3167:       // For each element connected to the node...
 3168: 
 3169:       Element *elem = node1->elements[j];
 3170: 
 3171:       // Compute the average gravity
 3172:       const double grav3 = elem->mean(&Node::grav2);
 3173: 
 3174:       // Look at the documentation for the description of the terms in the following integrals
 3175: 
 3176:       // Integral I_1 
 3177:       // \bar{\breve{H}} 
 3178:       const double hhatb = elem->mean(&Side::hhat);        
 3179: 
 3180: 
 3181:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3182: 
 3183:       const int id1 = elem->nodeLocalIdx(node1); 
 3184:       const double area = elem->area;
 3185: 
 3186:       if (elem->isTri()) {
 3187: 
 3188:          // To clarify the notation in this section: 
 3189:          //   i stands for the node under consideration (node1)
 3190:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3191:          const int id2 = elem->nxq(1 + id1);
 3192:          const int id3 = elem->nxq(2 + id1);
 3193:          Node *node2 = elem->nodes[id2];
 3194:          Node *node3 = elem->nodes[id3];
 3195: 
 3196:          const Point2 x1 = node1->p2();
 3197:          const Point2 x2 = node2->p2();
 3198:          const Point2 x3 = node3->p2();
 3199: 
 3200:          // integral of phi_i*phi_j
 3201:          const double ipp_ii = (1.0/6.0 )*area;
 3202:          const double ipp_ij = (1.0/12.0)*area;
 3203:          const double ipp_ik = (1.0/12.0)*area;
 3204: 
 3205:          // integral of [(grad phi_i) * (grad phi_j)]
 3206:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3207:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3208:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3209: 
 3210:          // Computes the different components of integral I_1 of each node with respect to node i.
 3211:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3212:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3213:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3214: 
 3215: if (j==node1->numElements-1) {
 3216: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 3217: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 3218: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3219: }
 3220: 
 3221:          node1->addToSparseMatrix(node1, I1_ii);
 3222:          node1->addToSparseMatrix(node2, I1_ij); 
 3223:          node1->addToSparseMatrix(node3, I1_ik);
 3224: 
 3225: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3226:      
 3227:       }
 3228:       else { // Quad
 3229:          // XXX IMPLEMENT THIS
 3230:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3231:       } 
 3232: 
 3233:  
 3234:       // Integral I_4
 3235:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3236:       // Where
 3237:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3238: 
 3239:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3240:       // of U over the element.
 3241:       Vector2 Umean = {0.0, 0.0};
 3242:       for (int m=0; m<elem->i34; m++) {      
 3243:          const Side *side = elem->sides[m];
 3244: 
 3245:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3246:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3247:       }
 3248:       Umean = Umean/elem->i34;
 3249: 
 3250:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3251: 
 3252:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3253:       const double I_4_1 = dot(gradPhi_1, Umean);
 3254: 
 3255:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3256:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3257:      
 3258:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3259: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 3260: 
 3261:       // Additional terms 
 3262:       double vnorm = 0.0;
 3263:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3264:          Vector3 ubed;
 3265:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3266: 
 3267:          Vector3 gradP = {0.0, 0.0, 1.0};
 3268:          for (int m=0; m < elem->i34; m++) {
 3269:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3270:            gradP += toVector3(gradP_2D, 0.0);
 3271:          }   
 3272:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3273:       } // imm==2
 3274: 
 3275:       if (elem->isTri()) {
 3276:          for (int l=0; l<3; l++) {
 3277:            double fac;
 3278: 
 3279:            Node *node = elem->nodes[l];
 3280: 
 3281:            (node == node1)? fac=2.0 : fac=1.0;
 3282: 
 3283:            if constexpr(imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3284:            else                 node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3285:            
 3286:          }
 3287: 
 3288: 
 3289:          if (!elem->isDry) {
 3290:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3291: 
 3292:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3293:          }
 3294: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 3295: 
 3296:       } // isTri
 3297:       else { // isQuad
 3298:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3299:          // for (int l=0; l<4; l++) {
 3300:          //   const Node *node = elem->nodes[l];
 3301: 
 3302:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3303:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3304: 
 3305:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3306:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3307:          // }
 3308: 
 3309:       } // isQuad
 3310: 
 3311: 
 3312:       node1->qel += (dt/elem->i34)*elem->vsource;
 3313:       
 3314: 
 3315:    } // for all elements connected to the node
 3316:    
 3317: 
 3318: 
 3319:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3320:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3321:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3322:    if (nodeBnd != nullptr)  { 
 3323:       // If it is an open boundary node...
 3324: 
 3325:       // At least one open bnd side, maybe two
 3326:       for (int l=0; l<2; l++) { 
 3327: 
 3328:          // Gets each of the sides sharing the node. 
 3329:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3330: 
 3331:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3332: 
 3333:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3334: 
 3335:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3336:          if (sideBnd != nullptr) {
 3337:             // If the side is on a boundary...
 3338: 
 3339:             // Get the boundary segment
 3340:             const BoundarySegment *sideSegment = sideBnd->segment;
 3341:             const Side *side = sideBnd->side;
 3342: 
 3343:             // Integral I_3
 3344:             if (sideSegment->ifltype != 0) {
 3345:             // Natural or Flather b.c.
 3346: 
 3347:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3348:                // especially for Flather b.c.
 3349:                double ri3 = 0.0;
 3350:                if (!side->isDry) {
 3351:                   // If the side is not dry
 3352:                   
 3353:                   // Computes the side flux of (uth, vth)
 3354:                   double Vn = 0.0;
 3355:                   for (int k = side->kb; k<nvrt-1; k++) {
 3356:                      // uth, vth in lat/lon frame if ics=2
 3357:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3358:                      const double vn1 = dot(sideBnd->uth(k  ), side->n); // outer normal
 3359:                      const double vn2 = dot(sideBnd->uth(k+1), side->n);
 3360: 
 3361:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3362:                   }
 3363: 
 3364:                   ri3 = 0.5*side->len*Vn;
 3365:                }
 3366: 
 3367:                if (sideSegment->ifltype == -1) { // Flather 1
 3368: 
 3369:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3370:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3371: 
 3372:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3373:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3374:                   
 3375:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3376:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3377: 
 3378:                } 
 3379:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3380:                   // Reset ri3
 3381:                   ri3 = 0.0;
 3382: 
 3383:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3384: 
 3385:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3386: 
 3387:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3388:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3389: 
 3390:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3391:                   node1->addToSparseMatrix(node1, con0*2.0);
 3392:                   node1->addToSparseMatrix(node2, con0);
 3393: 
 3394:                } // if Flather or Discharge
 3395: 
 3396:                node1->qel -= thetai*dt*ri3;
 3397: 
 3398:             } // I_3
 3399:           
 3400: 
 3401:             // Integral I_5
 3402:             if(!side->isDry) {
 3403: 
 3404:                const double Unbar = dot(side->U, side->n);
 3405: 
 3406:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3407:                
 3408:             } // I_5
 3409: 
 3410:          } // if is boundary side
 3411: 
 3412:       } // for l
 3413: 
 3414:    } // if isbnd
 3415: 
 3416: 
 3417:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3418: 
 3419: }
 3420: 
 3421: 
 3422: 
 3423: extern "C" {
 3424:    __global__ void rollUpElevation(void) {
 3425: 
 3426:       NODE(node);
 3427: 
 3428:       node->eta2 += node->eta1;
 3429: 
 3430:    }
 3431: 
 3432: 
 3433:    __global__ void backtrackAllNodes(void) {
 3434: 
 3435:       // max/min # of sub-divisions
 3436:       const int ndelt_max = max(1.0, dt/dtb_min);
 3437:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3438: 
 3439:       // Removed all references to swild98 XXX
 3440:       // swild98=0.d0 !init
 3441: 
 3442: 
 3443:       SIDE(side);
 3444: 
 3445:       const int kb = side->kb;
 3446: 
 3447: 
 3448: 
 3449:       // Initialize btrack velocities to the actual velocities at the side 
 3450:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3451: 
 3452: 
 3453:       if (side->isDry) return;
 3454: 
 3455: 
 3456:       // Checks that at least one element is not dry
 3457:       const Element *elem1 = side->elems[0];
 3458:       const Element *elem2 = side->elems[1];
 3459: 
 3460: 
 3461:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3462:       
 3463:       // XXXXXX
 3464:       // !swild_tmp to store global coord. of the starting side
 3465:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3466:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3467:       // !Use sframe2 
 3468:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3469: 
 3470: 
 3471:       for (int k = kb; k < nvrt; k++) {
 3472:       //  Initialize (xt,yt,zt), nnel and vel.
 3473:       //  For ics=2, the coordinates are in local frames
 3474:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3475: 
 3476: 
 3477:          const int iadvf = side->iadv();  // Advection flag
 3478: 
 3479:          Point3 xt;
 3480:          if constexpr(ics==1) {
 3481:             xt = side->center3D(k); 
 3482:          }
 3483:          else // lat/lon; in side lat/lon frame
 3484:          {
 3485:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3486:          // XXX IMPLEMENT THIS
 3487:       //          xt=0.d0
 3488:       //          yt=0.d0
 3489:       //          !centroid coord. for nudging
 3490:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3491:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3492:          }  // ics
 3493: 
 3494: 
 3495:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3496:          // XXX IS THIS NECESSARY?
 3497:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3498: 
 3499:          // If on land or open boundary...
 3500:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3501:          
 3502:          const double vmag = length(toVector2(u_int));
 3503: 
 3504:          if (vmag <= velmin_btrack) {
 3505:             // No activity 
 3506: addDebugPlot(side->center, side->center, 0x00FF00);
 3507:             side->btu[k] = side->u2[k];
 3508:             
 3509:          } else {  // do btrack
 3510: 
 3511:             // Compute number of sub-divisions based on local gradients 
 3512:             // XXX IS THIS NECESSARY?
 3513:             double suma = 0.0;
 3514:             int icount = 0;
 3515:             for (int ii=0; ii<2; ii++) {
 3516: 
 3517:                const Element *elem = side->elems[ii];
 3518:                  
 3519:                if (elem == nullptr) continue;
 3520: 
 3521:                icount++;
 3522: 
 3523:                // Not strictly along z; in ll frame for ics=2
 3524: 
 3525:                double utmp[4];
 3526:                double vtmp[4];
 3527:                for (int jj = 0; jj < elem->i34; jj++) {
 3528: 
 3529:                   const Node *node = elem->nodes[jj];
 3530: 
 3531:                   if constexpr(ics==1) {
 3532:                      utmp[jj] = node->u2[k].x;
 3533:                      vtmp[jj] = node->u2[k].y;  
 3534:                   } else {
 3535:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3536:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3537:                   }
 3538:                } // for jj
 3539: 
 3540:                const Vector2 grad_u = elem->grad2(utmp); 
 3541:                const Vector2 grad_v = elem->grad2(vtmp);
 3542: 
 3543:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3544:             } // for ii
 3545: 
 3546:             assert(icount > 0 && "Impossible 77");
 3547: 
 3548:             // '4' is somewhat arbitrary
 3549:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3550: 
 3551:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3552:          
 3553: 
 3554:             Vector3 u_int = {0.0, 0.0, 0.0};
 3555: 
 3556:             side->btrack(k, dt, dtbk, u_int);
 3557:                
 3558:          } // if vmag (do backtrack)
 3559: 
 3560:       } // for j=jmin,nvrt-1
 3561: 
 3562:    }
 3563: } // extern "C"
 3564: 
 3565: template<int nc>
 3566: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3567: 
 3568: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3569: //
 3570: // a,b,c,rhs: input vectors and are not modified by this program.
 3571: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3572: // rhs is the r.h.s.
 3573: // n: actual rank of the system.
 3574: // rows in u() and rhs();
 3575: // u: output with nc columns (transposed to rows)
 3576: // gam: a working array.
 3577: //
 3578: // NOTES:
 3579: // This is a template function that allows for different numbers of columns in the rhs vector.
 3580: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3581: 
 3582:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3583:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3584: 
 3585:    double bet = b[0];
 3586:    if constexpr (nc == 1) {
 3587:       u[0] = rhs[0]/bet;
 3588:    } else {
 3589:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3590:    }
 3591: 
 3592:    for (int j = 1; j < n; j++) {
 3593:       gam[j] = c[j-1]/bet;
 3594:       bet = b[j] - a[j]*gam[j];
 3595: 
 3596:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3597: 
 3598:       if constexpr (nc == 1) {
 3599:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3600:       } else {
 3601:          for (int k = 0; k < nc; k++) {
 3602:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3603:          }
 3604:       }
 3605:    }
 3606: 
 3607:    // Back-substitution
 3608:    for (int j=n-1; j>=1; j--) {
 3609:       if constexpr (nc == 1) {
 3610:          u[j] = u[j] - gam[j+1]*u[j-1];
 3611:       } else {
 3612:          for (int k = 0; k < nc; k++) {
 3613:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3614:          }
 3615:       }
 3616:    }
 3617: }
 3618: 
 3619: 
 3620: 
 3621: // Helper function that contains the core algorithm
 3622: template<typename XAccessor, typename YAccessor>
 3623: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3624:                                     double  yp_top, double  yp_bot, 
 3625:                                     CubicSpline &spline) {
 3626:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3627:    // 
 3628:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3629:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3630:    //
 3631:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3632:    // 
 3633:    // Inputs: 
 3634:    //            n: dimension for x etc; # of data pts (>=2);
 3635:    //            getX, getY: functions to access x,y coordinates
 3636:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3637:    //     Output: 
 3638:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3639: 
 3640:    const int n = k2 - k1 + 1;
 3641:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3642: 
 3643:    // Allocate memory for the splines
 3644:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3645:    spline.x   = new double[n];
 3646:    spline.y   = new double[n];
 3647:    spline.yp  = new double[n];
 3648:    spline.ypp = new double[n];
 3649: 
 3650:    for (int k=k1; k<=k2; k++) {
 3651:       spline.x[k] = getX(k);
 3652:       spline.y[k] = getY(k);
 3653:    }
 3654: 
 3655:    // This is to simplify expressions later
 3656:    double *x = spline.x;
 3657:    double *y = spline.y;
 3658: 
 3659:    double *a = nullptr;
 3660:    double *b = nullptr;
 3661:    double *c = nullptr;
 3662:    double *gam = nullptr;
 3663:    double *rhs = nullptr;
 3664:    
 3665: 
 3666:       a = new double[n];   // Lower diagonal
 3667:       b = new double[n];   // Diagonal
 3668:       c = new double[n];   // Upper diagonal
 3669:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3670:       rhs = new double[n]; // Right-hand side
 3671: 
 3672:    for (int k=k1; k<=k2; k++) {
 3673:       if (k == k1) {
 3674:          // Bottom level
 3675:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3676:          b[k] = (x[k+1] - x[k])/3.0;
 3677:          c[k] = b[k]/2.0;
 3678:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3679:       } else if (k == n - 1) {
 3680:          // Top level (surface)
 3681:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3682:          b[k] = (x[k] - x[k-1])/3.0;
 3683:          a[k] = b[k]/2.0;
 3684:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3685:       } else {
 3686:          // Intermediate levels
 3687:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3688:          b[k] = (x[k+1] - x[k-1])/3.0;
 3689:          a[k] = (x[k  ] - x[k-1])/6.0;
 3690:          c[k] = (x[k+1] - x[k  ])/6.0;
 3691:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3692:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3693:       }
 3694:    }
 3695: 
 3696:    // Solve the tridiagonal system
 3697:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3698:    
 3699:    spline.yp[k1] = yp_bot;
 3700:    spline.yp[k2] = yp_top;
 3701: 
 3702:    // Compute rest of 1st derivatives using the splines
 3703:    for (int k=k1+1; k<k2; k++) {
 3704:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3705:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3706:    }
 3707:    
 3708:    delete[] a;
 3709:    delete[] b;
 3710:    delete[] c;
 3711:    delete[] gam;
 3712:    delete[] rhs;
 3713: 
 3714: }
 3715: 
 3716: // Array version
 3717: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3718:                                 double y_top, double y_bot, 
 3719:                                 CubicSpline &spline) {
 3720:    auto getX = [x] (int k) { return x[k]; };
 3721:    auto getY = [y] (int k) { return y[k]; };
 3722:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3723: }
 3724: 
 3725: // Lambda version - allows custom access patterns
 3726: template<typename XFunc, typename YFunc>
 3727: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3728:                                 double y_top, double y_bot,
 3729:                                 CubicSpline &spline) {
 3730:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3731: }
