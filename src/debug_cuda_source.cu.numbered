 4566: 
 4567:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4568: 
 4569:       SIDE(side);
 4570: 
 4571: 
 4572:       side->U = {0.0, 0.0}; 
 4573:          
 4574:       if(side->isDry) return;
 4575: 
 4576:       const Node *node1 = side->n1;
 4577:       const Node *node2 = side->n2;
 4578: 
 4579:       // Vertically integrated velocity U (in ll if ics=2)
 4580:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4581:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4582:       }
 4583: 
 4584:    }
 4585: 
 4586:    __global__ void computeBottomDragVegetation(void) {
 4587:       // UNFINISHED. CHECK THIS:
 4588:       // How many kernels are needed? Why so many for loops?
 4589:       // Is the loop on sides needed?
 4590: 
 4591:       NODE(node);
 4592: 
 4593: 
 4594:       const int    kb      = node->kb;
 4595:       const double htot    = node->htot2(); 
 4596:       const double rough   = node->rough;
 4597: 
 4598:       
 4599:       if (node->isDry) {
 4600:          // Default values for dry nodes
 4601:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4602:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4603: 
 4604:          return;
 4605:        
 4606:       }
 4607: 
 4608:       // Compute bottom drag Cd
 4609:       //--------------------------------
 4610: 
 4611:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4612:       if constexpr(nchi == 1) {
 4613: 
 4614:          bool ltmp = false; // for WBL iteration
 4615: 
 4616:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4617:          // Drag at nodes
 4618:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4619:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4620:         
 4621:          const double rough = node->rough;
 4622:         
 4623:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4624:          if (node->rough == 0.0) {
 4625:             node->Cd = 0.0;
 4626: 
 4627:          } else { //roughness >0 
 4628:           
 4629:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4630:             const double bthick = max(dzb_min, bthick_ori);
 4631: 
 4632:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4633: 
 4634:             double tmp = 1.0/(2.5*log(bthick/rough));
 4635:             node->Cd = tmp*tmp;
 4636: 
 4637:          } // if rough
 4638: 
 4639: 
 4640:          // RECOVER THIS: XXX
 4641:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4642:          // Output warning for WBL if iteration didn't converge
 4643: 
 4644: 
 4645:       } // nchi==1
 4646: 
 4647: 
 4648:       //   Bottom stress in m^2/s^2
 4649:       if (node->rho[kb + 1] >= -98.0)
 4650:       {
 4651:          const double mag_u = length(node->u2[kb + 1]);
 4652:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4653: 
 4654:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4655:          // !sediment erosion: this part needs more documentation
 4656:       }
 4657:     
 4658: 
 4659: 
 4660:       // Compute vegetation parameters
 4661:       //--------------------------------
 4662: 
 4663:       // SAV constants
 4664:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4665:       constexpr double veg_cfpsi = 0.16;
 4666: 
 4667:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4668:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4669: 
 4670:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4671:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4672:          int kbin = 0; // bin index
 4673:          for (int k = kb; k < nvrt; k++) {
 4674:             // Computes node height above the bottom level
 4675:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4676:             assert(false && "Vertical variation of vegetation not implemented");
 4677: 
 4678:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4679:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4680:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4681:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4682:             // } else {
 4683:             //    // Find the bin at which the current vertical level is
 4684:             //    while (kbin<nbins_veg_vert) {
 4685:             //       const double zn = node->z[kbin];
 4686:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4687:             //          break;
 4688:             //       } // if
 4689:             //       kbin++;
 4690:             //    } // while
 4691:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4692: 
 4693:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4694:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4695:                
 4696:             //    // Linear interpolation of the vegetation parameters
 4697:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4698:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4699:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4700:             // } // if rl10
 4701: 
 4702:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4703: 
 4704:          } // for k
 4705: 
 4706: 
 4707:       } else { // Ganthy (iveg==2)
 4708:       //  Modify canopy height, diameter, and density
 4709: 
 4710:          // Make sure there is vegetation on this node
 4711:          if (node->veg_h_unbent > 0.0) {
 4712:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4713: 
 4714:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4715:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4716:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4717: 
 4718:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4719:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4720:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4721:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4722:          } // if veg_h_unbent
 4723: 
 4724:          for (int k = 0; k < nvrt; k++) {
 4725:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4726:          } // for k
 4727:       
 4728: 
 4729:       } // if iveg
 4730:      
 4731: 
 4732:       // Compute vertical mean of veg_alpha3D
 4733:       if (iveg != 0) {
 4734:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4735:          double sum1=0.0;
 4736:          double sum2=0.0;
 4737:          // Integrate over each level under the canopy...
 4738:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4739:             const double Dz = node->Dz(k);
 4740: 
 4741:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4742:             sum2 += Dz;
 4743: 
 4744:          } // for k
 4745:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4746:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4747: 
 4748:       } // if iveg
 4749: 
 4750:    }
 4751: 
 4752:    __global__ void computeVegetationAndDragParameters(void) {
 4753:       // Computes the vegetation and drag model parameters:
 4754:       // chi, \tilde\chi, beta, \breve{H}
 4755:       
 4756:       SIDE(side);
 4757: 
 4758:       if (side->isDry) return;
 4759: 
 4760:       const double htot = side->htot2();
 4761:       const int    kb   = side->kb;
 4762: 
 4763:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4764: 
 4765:       const double veg_h     = side->veg_h();
 4766:       const double veg_nv    = side->veg_nv();
 4767:       const double veg_c     = side->veg_c();
 4768:       const double veg_beta  = side->veg_beta;
 4769:       const double veg_alpha = side->veg_alpha_vert_mean();
 4770: 
 4771:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4772:       // Velocity magnitude at the bottom level
 4773:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4774:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4775:       side->chi2 = side->Cd()*vmag1;
 4776:       side->chi  = side->chi2;
 4777:       if constexpr(iveg != 0) {
 4778:          const Node *n1 = side->n1;
 4779:          const Node *n2 = side->n2;
 4780:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4781:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4782:       }
 4783: 
 4784:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4785: 
 4786:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4787:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4788:       double magUa = 0.0;
 4789:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4790:          // 3D wet side with veg...
 4791: 
 4792:          double magUa = 0.0;
 4793:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4794:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4795: 
 4796:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4797:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4798:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4799: 
 4800:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4801:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4802: 
 4803:                // Velocity magnitude at the bottom (l) of the level
 4804:                const double ul = length(side->u2[k]);
 4805: 
 4806:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4807:                magUa += Dz*0.5*(uh + ul);
 4808: 
 4809:             } // if HasVegetation
 4810:          } // for k
 4811:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4812: 
 4813:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4814:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4815:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4816:             const double zCpy = side->zTopCanopy();
 4817:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4818:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4819:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4820:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4821:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4822:          } // if isSubmerged
 4823:       } // if iveg   
 4824: 
 4825:       // Computes the friction modified depth, \breve{H} in notes
 4826:       if (side->is2D()) { // 2D
 4827: 
 4828:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4829:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4830: 
 4831:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4832: 
 4833:          side->hhat = htot*htot/fricH; 
 4834: 
 4835:       } else { // 3D
 4836:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4837: 
 4838:          if constexpr(iveg != 0) {
 4839:             
 4840:             if (side->isSubmerged()) { 
 4841:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4842:                side->hhat -= veg_c*Hhat_alpha;
 4843: 
 4844:             } else { // Emergent
 4845:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4846:             }
 4847:          } // if iveg
 4848: 
 4849:          // Enforce positivity for 3D model
 4850:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4851:       } // if 3D
 4852: 
 4853:    }
 4854: 
 4855: 
 4856: 
 4857:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4858:    // Computes the density gradient between two elements, e1 and e2.
 4859:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4860:    // zero in the direction normal to the side. 
 4861:    // 
 4862:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4863:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4864:    //
 4865:    // Input:
 4866:    //    e1: Element
 4867:    //    e2: Neighbor element (or nullptr if boundary)
 4868:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4869:    //    k: Index of the half-level at which the density is interpolated
 4870:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4871:    // 
 4872:    // Output:
 4873:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4874:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4875: 
 4876:       if (e2 == nullptr || e2->isDry) {
 4877:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4878: 
 4879:          Side *side = e1->sides[j];
 4880:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4881:                  
 4882:          if constexpr(ics == 1) {
 4883:             vec = side->n; // Normal vector to the side
 4884:          } else {
 4885:             // IMPLEMENT THIS XXXXXX
 4886:             // !replace with xel, yel?
 4887:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4888:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4889:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4890:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4891:          } //ics
 4892:                    
 4893:          diffRho = 0.0;
 4894: 
 4895:       } else { //internal and wet
 4896:          if constexpr(ics==1) {
 4897:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4898: 
 4899:             // Vector from e1 to e2
 4900:             vec = e2->center - e1->center;
 4901: 
 4902:          } else { 
 4903:             // IMPLEMENT THIS XXXXXX
 4904:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4905:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4906:             //                   alow(j)=xctr2
 4907:             //                   bdia(j)=yctr2
 4908:          } // ics
 4909: 
 4910:          diffRho = rho2 - e1->demeanedDensity(k);
 4911:       }
 4912: 
 4913:    }
 4914: 
 4915:    __global__ void computeDensityCubicSplines(void) {
 4916:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4917: 
 4918:       ELEM(elem);
 4919: 
 4920:       if (elem->isDry) return;
 4921: 
 4922:       const int kb = elem->kb;
 4923: 
 4924:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4925:       if (elem->is2D()) {
 4926:          // In the 2D case, the density is constant at the prism level. 
 4927:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4928:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4929:       } else { //3D
 4930: 
 4931:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4932:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4933:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4934:          ///// XXXX CHECK INDICES!!!!!
 4935:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4936:       } // 2D/3D
 4937: 
 4938:    }
 4939: } // extern "C"
 4940: 
 4941: 
 4942: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4943: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4944: 
 4945:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4946: 
 4947:    const int kb  = elem->kb;
 4948:    const int kb2 = elem2->kb;
 4949: 
 4950:    // z-coordinate of prism of elem
 4951:    const double zp = elem->z_prism(k);
 4952: 
 4953:    double rho = 0.0;
 4954: 
 4955:    if (elem2->is2D()) {
 4956:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4957: 
 4958:    } else {  // 3D
 4959: 
 4960:       // eta_min may be < zmax
 4961:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4962:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4963: 
 4964:       // (Extrapolate density below bottom, we will fix it later)
 4965:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4966:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4967:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4968:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4969:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4970:    } // 2D/3D
 4971:      
 4972: 
 4973:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4974:    // Now we need to fix it.
 4975:    if (elem->z[k] < elem2->z[kb2]) {
 4976:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4977: 
 4978:       // There are two methods to adjust the density at the bottom of the element.
 4979:       // iunder_deep=0: 
 4980:       const double depth1 = abs(elem->z[kb]); // larger depth
 4981: 
 4982:       if (iunder_deep==0) {
 4983: 
 4984:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4985: 
 4986:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4987: 
 4988:       } else { // iunder_deep != 0
 4989: 
 4990:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4991: 
 4992:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4993: 
 4994:          //   Demeaned density at the same z coordinate as
 4995:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4996:          }
 4997: 
 4998:       } // if iunder_deep
 4999:    } // if elem->z[kb] < elem2->z[kb]
 5000: 
 5001:    return rho;
 5002: }
 5003: 
 5004: 
 5005: extern "C" {
 5006:    __global__ void computeDensityGradient(void) {
 5007: 
 5008:       if constexpr(ibc != 0) return;
 5009: 
 5010:          // Compute the horizontal density gradient at each element.
 5011:       // It works in two steps:
 5012:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5013:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5014:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5015:       //             gradRho.r1 = rho1 - rho0
 5016:       //             gradRho.r2 = rho2 - rho0
 5017:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5018:       // 
 5019:       //  NOTE: We use de-meaned densities.
 5020: 
 5021:       ELEM(elem);
 5022: 
 5023:       if (elem->isDry) return;
 5024: 
 5025:       const int kb  = elem->kb;
 5026:       const int i34 = elem->i34;
 5027: 
 5028:       for (int k = kb + 1; k < nvrt; k++) {
 5029:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5030:          //             gradRho.r1 = rho1 - rho0
 5031:          //             gradRho.r2 = rho2 - rho0
 5032:          int icount = 0;
 5033:          double sumRx = 0.0;
 5034:          double sumRy = 0.0;
 5035:          for (int j1=0; j1<i34; j1++) { 
 5036: 
 5037:             const int j2 = elem->nxq(j1 + 1);
 5038: 
 5039:             // Pairs of consecutive neighbor elements of elem
 5040:             const Element *e1 = elem->nghbElems[j1];
 5041:             const Element *e2 = elem->nghbElems[j2];
 5042: 
 5043:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5044:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5045:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5046: 
 5047:             // Compute the density difference and the vector from elem to e1 and e2
 5048:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5049:             double diffRho1, diffRho2;
 5050:             Vector2 vec1, vec2;
 5051:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5052:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5053: 
 5054:             const double rl1 = length(vec1);
 5055:             const double rl2 = length(vec2);
 5056:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5057: 
 5058:             const double delta = cross(vec1, vec2);
 5059:             const double sintheta = abs(delta)/(rl1*rl2);
 5060: 
 5061:             // To avoid problems, avoid elements with small angle between vectors
 5062:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5063:             const bool validEq = (sintheta > sin_one_deg);
 5064: 
 5065:             if (validEq) {
 5066:                // Solve the system of equations to get the density gradient at elem
 5067:                icount++;
 5068:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5069:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5070:                sumRx += Rx;
 5071:                sumRy += Ry;
 5072:             }
 5073:          } // for j1
 5074: 
 5075:          // Compute the average density gradient at elem
 5076:          if (icount==0) {
 5077:            // Bad mesh quality; bail out with 0 b-cc
 5078:            elem->gradRho[k] = {0.0, 0.0};
 5079:          } else {
 5080:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5081:          }
 5082: 
 5083:       } // for k
 5084: 
 5085:    }
 5086: 
 5087:    __global__ void computeBaroclinicTerm(void) {
 5088:    // Computes the baroclinic term at sides (at half levels).
 5089:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5090:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5091: 
 5092:       if (ibc == 1) return;
 5093: 
 5094:       SIDE(side);
 5095: 
 5096:       if (side->isDry) return;
 5097: 
 5098:       const Element *e1 = side->elems[0];
 5099:       const Element *e2 = side->elems[1];      
 5100:       const int kb = side->kb;
 5101:       
 5102:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5103: 
 5104:       // interpolates vertically the density gradient of the two elements at the half level/
 5105: 
 5106:       int k1 = max(kb, nvrt / 2);
 5107:       int k2 = max(kb, nvrt / 2);
 5108: 
 5109:       // Starts the integration at the surface and goes down to the bottom
 5110:       side->bcc[nvrt-1] = {0.0, 0.0};
 5111:       for (int k = nvrt - 2; k >= kb; k--) {
 5112:       // For each prism level (from surface to bottom)...
 5113: 
 5114:          // For both elements, interpolate density gradient at the side's half level.
 5115:          // The gradient at the side is the average of the gradients at the elements.
 5116:          // w1, w2 are used to take into account boundary sides, with just one element.
 5117:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5118:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5119:          const double wsum = w1 + w2;
 5120:          w1 = w1/wsum;
 5121:          w2 = w2/wsum;
 5122:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5123: 
 5124:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5125:          Vector2 gradRho = {0.0, 0.0};
 5126:          if (e1 != nullptr && k > kb) {
 5127:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5128:             
 5129:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5130:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5131:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5132: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5133:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5134:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5135:          }      
 5136:          if (e2 != nullptr && k > kb) {
 5137:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5138:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5139:             
 5140:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5141:          }
 5142: 
 5143:          if constexpr(ics==2) {
 5144:             assert(false && "Not implemented: ics == 2");
 5145:             // IMPLEMENT THIS XXXXXX
 5146:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5147:             // swild(1)=tmp1
 5148:             // swild(2)=tmp2
 5149:          }
 5150:          
 5151:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5152:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5153:          // CHECK INDICES!!! XXX
 5154:          const double grav3 = side->grav3();
 5155:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5156: 
 5157:       } // for
 5158: 
 5159:    }
 5160: 
 5161: 
 5162: 
 5163:    __global__ void computeHorGradientAtSide(void) {
 5164: 
 5165:       // Compute the horizontal density gradient at each element.
 5166:       // It works in two steps:
 5167:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5168:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5169:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5170:       //             gradRho.r1 = rho1 - rho0
 5171:       //             gradRho.r2 = rho2 - rho0
 5172:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5173:       // 
 5174:       //  NOTE: We use de-meaned densities.
 5175: 
 5176:       SIDE(side);
 5177: 
 5178: // printf("side->isDry: %d\n", side->isDry);
 5179:       if (side->isDry) return;
 5180: 
 5181:       // Computes the gradient of the variables at the side center.
 5182:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5183:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5184:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5185: 
 5186:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5187:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5188:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5189:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5190: 
 5191: 
 5192:    }
 5193: 
 5194: 
 5195:    __global__ void solveMomentumEquations(double time) {
 5196: 
 5197:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5198:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5199: 
 5200:       SIDE(side);
 5201: 
 5202:       if (side->isDry) 
 5203:       {
 5204:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5205: 
 5206:          return;
 5207:       }
 5208: 
 5209:       const Node *n1 = side->n1;
 5210:       const Node *n2 = side->n2;
 5211: 
 5212:       const int kb = side->kb;
 5213: 
 5214:       const double veg_h = side->veg_h();
 5215:       const double grav3 = side->grav3();
 5216: 
 5217:       if (side->is2D()) {
 5218:          // Warning: Do not use htot2, which is updated.
 5219:          const double htot = side->htot1();
 5220:          const double hhat = side->hhat;
 5221: 
 5222:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5223: 
 5224:          Vector2 tau2 = {0.0, 0.0};
 5225:           
 5226:          if constexpr(ics==1) {
 5227:             tau2 = side->tau();
 5228: 
 5229:          } else {
 5230:             assert(false && "Not implemented: ics == 2");
 5231:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5232:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5233:             // taux2=(vn1+tt1)*0.5d0
 5234:             // tauy2=(vn2+ss1)*0.5d0
 5235:          } // if ics         
 5236: 
 5237:          // hat_gam has units of m/s
 5238: 
 5239:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5240: 
 5241:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5242:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5243: 
 5244:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5245: 
 5246: 
 5247:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5248:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5249: 
 5250:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5251: 
 5252:       }
 5253:       else { // 3D
 5254: 
 5255:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5256:          // 
 5257:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5258:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5259:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5260:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5261:          // k+1 and k.
 5262: 
 5263: 
 5264:          const int ndim = nvrt - kb;
 5265:          const double zTopCanopy = side->zTopCanopy();
 5266: 
 5267:          // Initialize the tridiagonal system
 5268:          for (int k = kb + 1; k < nvrt; k++) {
 5269:             
 5270:             const int kin = k - (kb + 1);
 5271: 
 5272:             // Vertical viscosity at the face center
 5273:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); ///XXXXX
 5274:  
 5275:             alow[kin] = 0.0;
 5276:             cupp[kin] = 0.0;
 5277:             bdia[kin] = 0.0;
 5278: 
 5279:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5280:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5281: 
 5282:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5283:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5284:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5285: 
 5286:             // First part: layers k, k+1
 5287:             if (k < nvrt - 1) {
 5288:                              
 5289:                if constexpr(iveg != 0) {
 5290: 
 5291:                   // If there is vegetation at this level...
 5292:                   if (zTopCanopy > side->zc[k]) {
 5293:                      // If the canopy is above the k layer...
 5294:                      
 5295:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5296:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5297:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5298:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5299: 
 5300:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5301:                      const double vmag2 = length(ut2);
 5302:                      const double vmag1 = length(side->u2[k]);
 5303:                      const double vmag = 0.5*(vmag1 + vmag2);
 5304:                      
 5305:                      // Computes the vegetation alpha at the face center
 5306:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5307: 
 5308:                      cff1 += veg_alpha_sd*dt*vmag;
 5309: 
 5310:                   } // if (zTopCanopy
 5311:                } // if iveg
 5312: 
 5313:                const double dzz = side->Dz(k + 1);
 5314:                const double tmp = dt*dfz/dzz;
 5315:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5316: 
 5317:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5318:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5319:             }
 5320: 
 5321: 
 5322:             // Second part: layers k-1, k
 5323:             if (k > kb + 1) {
 5324: 
 5325:                double cff1 = 1.0; //init \bar{c^k}
 5326: 
 5327:                if constexpr(iveg != 0) {
 5328:                   // If there is vegetation at this level...
 5329:                   if (zTopCanopy > side->zc[k-1]) {
 5330:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5331:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5332: 
 5333:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5334: 
 5335:                      const double vmag2 = length(ut2);
 5336:                      const double vmag1 = length(side->u2[k-1]);
 5337:                      const double vmag = 0.5*(vmag1 + vmag2);
 5338: 
 5339:                      // Computes the vegetation alpha at the face center
 5340:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5341:                      cff1 += veg_alpha_sd*dt*vmag;
 5342:                   } // if zTopCanopy
 5343: 
 5344:                } // if iveg
 5345: 
 5346:                const double dzz = side->Dz(k);
 5347:                const double tmp = dt*dfz/dzz;
 5348:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5349: 
 5350:                alow[kin] += cff1*dzz/6.0 - tmp;
 5351:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5352: 
 5353:             } else { // Bottom boundary
 5354:                // This occurs at the bottom, where the bottom drag is applied.
 5355: 
 5356:                bdia[kin] += dt*side->chi2; // XXXX
 5357: 
 5358:             } // if (k > kb + 1)
 5359: 
 5360: 
 5361:          } // for (int k
 5362: 
 5363: 
 5364: 
 5365:          // Computes the RHS.
 5366:          // -----------------
 5367: 
 5368:          //	BC to be imposed at the end.
 5369: 
 5370:          const Vector2 gradETP  = side->gradETP;
 5371:          const Vector2 gradPr   = side->gradPr;
 5372:          const Vector2 gradEta1 = side->gradEta1;
 5373:          const Vector2 gradEta2 = side->gradEta2;
 5374: 
 5375:          const Vector2 *btu = side->btu;
 5376:          const Vector2 *u2  = side->u2;
 5377:          const double coriolis = side->coriolis;
 5378:          const Vector2 *nuGradU = side->nuGradU;
 5379: 
 5380: 
 5381:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5382: 
 5383:          for (int k = kb + 1; k < nvrt; k++) {
 5384:             const int kin = k - kb - 1;
 5385: 
 5386:             const double dz_0 = side->Dz(k);
 5387:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5388: 
 5389:             rrhs[kin] = {0.0, 0.0};
 5390:             double dz = 0.0;
 5391: 
 5392:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5393:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5394:             if (k < nvrt  ) dz += dz_1;
 5395:             if (k > kb + 1) dz += dz_0;
 5396: 
 5397:             // Elevation gradient, atmospheric pressure and tidal potential
 5398:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5399: 
 5400:             // Coriolis, advection, wind stress, and horizontal viscosity
 5401:             if (k < nvrt - 1) {
 5402: 
 5403: 
 5404:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5405:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5406:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5407:                                                 
 5408: 
 5409:                //diff stress tensors 1006
 5410:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5411:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5412:                   assert(false && "Not implemented: itur == 5");
 5413:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5414:                }
 5415: 
 5416:             } else { // k == nvrt - 1 SURFACE
 5417:                Vector2 tau2 = {0.0, 0.0};
 5418:                if constexpr(ics==1) {
 5419:                   tau2 = side->tau();
 5420:       
 5421:                } else {
 5422:                   assert(false && "Not implemented: ics == 2");
 5423:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5424:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5425:                   // taux2=(vn1+tt1)*0.5d0
 5426:                   // tauy2=(vn2+ss1)*0.5d0
 5427:                } // if ics
 5428: 
 5429:                rrhs[kin] += dt*tau2;
 5430: 
 5431:             } // if k<nvrt
 5432: 
 5433:             if (k > kb + 1) {
 5434:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5435:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5436:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5437: 
 5438:                // diff stress tensors 1006
 5439:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5440:                   assert(false && "Not implemented: itur == 5");
 5441:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5442:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5443:                }
 5444: 
 5445:             } // if k>kbs + 1
 5446: 
 5447:             // Baroclinic
 5448:             Vector2 *bcc = side->bcc;
 5449:             if constexpr(ibc == 0) {
 5450:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5451:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5452: 
 5453:             } // if ibc==0
 5454: 
 5455:          } // k=kb + 1,nvrt
 5456: 
 5457: 
 5458:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5459: 
 5460:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5461:             const int kin = k - kb - 1;
 5462: 
 5463:             // Velocity is always clamped to maximum values
 5464:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5465:          } // k
 5466: 
 5467:       } // if side->is2D()
 5468:       
 5469: 
 5470:       // Impose velocity boundary condition at the bottom
 5471:       if constexpr(imm == 2) { // 3D bed deformation model
 5472:          double dep;
 5473:          Vector2 vel;
 5474: 
 5475:          assert(false && "Not implemented: imm == 2");
 5476:          //update_bdef(time, x0, y0, dep, vel);
 5477:          // side->u2[kb] = vel;
 5478: 
 5479:       } else { // imm = 0 or 1
 5480:          if (side->Cd() == 0.0) {
 5481:             side->u2[kb] = side->u2[kb + 1];
 5482: 
 5483:          } else if (side->is3D()) { // 3D no slip bottom   
 5484:             side->u2[kb] = {0.0, 0.0};
 5485:          }
 5486:           
 5487:       } // if imm
 5488: 
 5489:       // The velocities below the bottom level are set to zero
 5490:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5491: 
 5492: 
 5493:    }
 5494: 
 5495: 
 5496:    __global__ void applyMomentumBC(void) {
 5497: 
 5498:       SIDE_BND(sideBnd);
 5499: 
 5500:       Side *side = sideBnd->side;
 5501:       const BoundarySegment *segment = sideBnd->segment;
 5502:       const Node *n1 = side->n1;
 5503:       const Node *n2 = side->n2;
 5504: 
 5505:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5506: 
 5507:       const bool isLand = segment->isLand;
 5508:       const int ifltype = segment->ifltype;
 5509: 
 5510:       const int kb = side->kb;
 5511: 
 5512:       if (!isLand && ifltype != 0) {
 5513:          const Vector2 *ubc = sideBnd->ubc;
 5514:   
 5515:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5516:             
 5517:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5518:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5519: 
 5520:             if (ifltype == -1) {
 5521:                // Flather 1
 5522: 
 5523:                const double depth = side->depth();
 5524: 
 5525:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5526: 
 5527:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5528: 
 5529:                side->u2[k] = vnorm*side->n;
 5530: 
 5531:             } else if (ifltype == -2) { // Discharge
 5532: 
 5533:                const double eta1 = side->eta1();
 5534:                const double eta2 = side->eta2();
 5535:                const double htot = side->htot2();
 5536: 
 5537:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5538:                assert(false && "Not implemented: Discharge bc");
 5539:                // const double dischrg = discharge(eta1);
 5540:                const double dischrg = 0.0; // XXX REMOVE
 5541:                
 5542: 
 5543:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5544: 
 5545:                const double vnorm = dischrg*eta2/htot;
 5546: 
 5547:                side->u2[k] = vnorm*side->n;
 5548: 
 5549:             }
 5550:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5551:                const double vnorm = dot(side->u2[k], side->n);
 5552: 
 5553:                double rat;
 5554:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5555:                else              rat = segment->vobc2; // outgoing
 5556: 
 5557:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5558: 
 5559:             }
 5560:             else { // not Flather or 3D radiation
 5561:                side->u2[k] = ubc[k];
 5562: 
 5563:             } // if (segment->ifltype...
 5564: 
 5565:          }
 5566: 
 5567:       }
 5568:       else if (isLand) { // if it is land boundary side
 5569: 
 5570:          if constexpr(islip == 0) { // free slip
 5571: 
 5572:             for (int k = kb; k < nvrt; k++) {
 5573: 
 5574:                const Vector2 t = side->t();
 5575:                const Vector2 n = side->n;
 5576: 
 5577:                double vnorm = 0.0; // for most cases
 5578:                const double vtan = dot(side->u2[k], t);
 5579:                
 5580:                side->u2[k] = vtan*t - vnorm*n;
 5581: 
 5582:             }
 5583: 
 5584:          } else { // no slip
 5585:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5586: 
 5587:          }
 5588:       } // if (side segment type...
 5589: 
 5590:    
 5591: 
 5592:    }
 5593: 
 5594: 
 5595:    __global__ void shapiroFilter1(void) {
 5596:       // First step of the Shapiro filter (normally used if indvel<=0)
 5597:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5598: 
 5599:       SIDE(side);
 5600: 
 5601:       // Only internal wet sides are processed
 5602:       if (side->isDry || !(side->isInternal())) return;
 5603: 
 5604:       const int kb = side->kb;
 5605: 
 5606:       for (int mm = 0; mm < niter_shap; mm++) {
 5607: 
 5608:          for (int k = kb + 1; k < nvrt; k++) {
 5609:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5610:             Vector2 suru = {0.0, 0.0};
 5611: 
 5612:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5613: 
 5614:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5615: 
 5616:                int kin = k;
 5617:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5618:                
 5619:                if constexpr(ics==1) {
 5620:                   suru += nSide->u2[kin];
 5621: 
 5622:                } else {
 5623:                   assert(false && "Not implemented: ics == 2");
 5624:                   // Vector2 vn1, vn2;
 5625:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5626:                   // suru=suru+vn1;
 5627:                   // surv=surv+vn2;
 5628:                }
 5629:             }
 5630: 
 5631: 
 5632:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5633: 
 5634:          }
 5635:       }
 5636:    }
 5637: 
 5638:    __global__ void shapiroFilter2(void) {
 5639:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5640: 
 5641:       SIDE(side);
 5642: 
 5643:       if (side->isDry || !(side->isInternal())) return;
 5644: 
 5645:       const int kb = side->kb;
 5646: 
 5647:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5648: 
 5649:       if (side->is2D()) {
 5650:          side->u2[kb + 1] = side->bcc[kb + 1];
 5651:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5652: 
 5653:       } else {
 5654:          // 3D
 5655:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5656:          
 5657:       }
 5658: 
 5659:    }
 5660: 
 5661: 
 5662:    __global__ void ul0UpdateZCoords(void) {
 5663:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5664:       
 5665:       NODE(node);      
 5666: 
 5667: 
 5668:       if (node->isDry2()) { 
 5669: 
 5670:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5671: 
 5672:          if constexpr(ivcor != 1) node->kb = 0;
 5673: 
 5674:       } else {
 5675: 
 5676:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5677:          node->updateKb();
 5678: 
 5679:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5680: 
 5681:       }
 5682: 
 5683:       // We use the temp.b field to store the previous state of isDry.
 5684:       node->tmp.b = node->isDry;
 5685: 
 5686:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5687:       node->isDry = true;
 5688: 
 5689:    }
 5690: 
 5691:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5692:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5693:    {
 5694:       ELEM(elem);
 5695: 
 5696:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5697: 
 5698:       // All the nodes of a wet element are wet.
 5699:       if (!elem->isDry) {
 5700:          elem->nodes[0]->isDry = false;
 5701:          elem->nodes[1]->isDry = false;
 5702:          elem->nodes[2]->isDry = false;
 5703:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5704: 
 5705:       }
 5706: 
 5707: 
 5708:       elem->kb = 0;
 5709: 
 5710:       if (elem->isDry) return;
 5711: 
 5712:       // Wet
 5713:       const Node *n1 = elem->nodes[0];
 5714:       const Node *n2 = elem->nodes[1];
 5715:       const Node *n3 = elem->nodes[2];  
 5716:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5717: 
 5718:    //    if(elem->isDry2()) { // XXXX
 5719:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5720:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5721:    //        call parallel_abort(errmsg)
 5722:    //    }
 5723: 
 5724: 
 5725:       // Computes element's kb as the minimum of the nodes' kb.
 5726:       const int kb1 = n1->kb;
 5727:       const int kb2 = n2->kb;
 5728:       const int kb3 = n3->kb;
 5729:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5730: 
 5731: 
 5732:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5733: 
 5734: 
 5735:       // Computes the element z as the mean of the nodes z.
 5736:       for (int k = elem->kb; k < nvrt; k++) {
 5737: 
 5738:          // Compute the element z as the mean of the nodes z.
 5739:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5740:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5741:          elem->z[k] /= elem->i34;
 5742: 
 5743:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5744:       }
 5745:                   
 5746:    }
 5747: 
 5748:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5749:    {
 5750:       NODE(node);
 5751:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5752: 
 5753:       if (it == iths) return;
 5754: 
 5755: 
 5756:       if(!node->isDry && node->tmp.b) { // rewetted
 5757:          for (int k=0; k < nvrt; k++) {
 5758: 
 5759:             Vector3 utmp={0.0, 0.0, 0.0};
 5760: 
 5761:             double ttmp=0.0;
 5762:             double stmp=0.0;
 5763:             int icount=0;
 5764:             for (int j = 0; j < node->numNodes; j++) {
 5765: 
 5766: 
 5767:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5768:                if (!node->isDry) { // all indices extended
 5769:                   icount++;
 5770: 
 5771:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5772:                   utmp += node->uvw2(k);
 5773:                   
 5774:                   ttmp += node->tracers[k].tracer[0]; 
 5775:                   stmp += node->tracers[k].tracer[1]; 
 5776:                }
 5777:             }
 5778: 
 5779:             if(icount > 0) {
 5780:                const double inv_icount = 1.0/icount;
 5781:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5782:                node->w2[k]     = inv_icount*utmp.z;
 5783:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5784:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5785:             }
 5786:          }
 5787:       }
 5788:    }
 5789: 
 5790: 
 5791:    __global__ void ul0UpdateSides(int it, int iths) {
 5792: 
 5793:       SIDE(side);
 5794: 
 5795:       // A side is wet if and only if at least one of its elements is wet.
 5796:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5797:  
 5798:       const Node *n1 = side->n1;
 5799:       const Node *n2 = side->n2;
 5800:      
 5801:       const int kb1 = n1->kb;
 5802:       const int kb2 = n2->kb;
 5803: 
 5804:       side->kb = 0; // dry
 5805: 
 5806:       if (isWet) {
 5807: 
 5808:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5809: 
 5810:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5811: 
 5812:          side->kb = min(kb1, kb2);
 5813: 
 5814:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5815: 
 5816:          for (int k = side->kb; k < nvrt; k++) {
 5817:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5818: 
 5819:          
 5820:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5821: 
 5822:             // Compute velocity for re-wetted sides 
 5823:             if ((it != iths) && (side->isDry && isWet)) {
 5824:             
 5825:                Vector2 utmp={0.0, 0.0};
 5826: 
 5827:                int icount=0;
 5828: 
 5829:                // For all the sides on the two elements that share this side
 5830:                for (int j=0; j < 2; j++) {
 5831:                   const Element *elem = side->elems[j];
 5832:                   if (elem == nullptr) continue;
 5833: 
 5834:                   for (int jj=0; jj < elem->i34; jj++) {
 5835:                      const Side *nSide = elem->sides[jj];
 5836:                      if (nSide->isDry) continue;
 5837: 
 5838:                      icount++;
 5839:                      utmp += nSide->u2[k];                     
 5840:                   }
 5841:                }
 5842:                   
 5843:                assert(icount > 0 && "No wet sides around this side");
 5844:                if (icount > 0)  side->u2[k] = utmp/icount;
 5845:                   
 5846:             } // if ((it != iths) && (side->isDry && isWet))
 5847: 
 5848:          } // for k
 5849: 
 5850:       } // if isWet
 5851:    
 5852:       side->isDry = !isWet;
 5853: 
 5854:    }
 5855: 
 5856: 
 5857:    __global__ void zeroNodalVelocities(void) {
 5858:       NODE(node);
 5859: 
 5860:       for (int k = 0; k < nvrt; k++) {
 5861:          node->u2[k]   = {0.0, 0.0};
 5862:          node->w2[k]   = 0.0;
 5863:          node->utmp[k] = {0.0, 0.0};
 5864:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5865:       }
 5866:    }
 5867: 
 5868:  
 5869: 
 5870:    __global__ void computeNodalVerticalVelocities1(void) {
 5871:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5872:    // Adds the element's vertical velocity times the element's area.
 5873:       ELEM(elem);
 5874: 
 5875:       for (int j = 0; j < elem->i34; j++) {
 5876:          Node *node = elem->nodes[j];
 5877: 
 5878:          for (int k = node->kb; k < nvrt; k++) {
 5879:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5880:          }
 5881:          atomicAdd(&(node->tmp.d), elem->area);
 5882:       }
 5883:    }
 5884: 
 5885:    __global__ void computeNodalVerticalVelocities2(void) {
 5886:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5887:    // Divides by the total area of the elements sharing the    node.
 5888:       NODE(node);
 5889: 
 5890:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5891:    }
 5892: 
 5893: 
 5894:    __global__ void computeNodalHorizontalVelocities1(void) {
 5895:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5896:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5897: 
 5898:       ELEM(elem);
 5899: 
 5900:       const int kb = elem->kb;
 5901:       const bool isTri = elem->isTri();
 5902: 
 5903:       if constexpr(indvel <= 0) {
 5904:          // Assuming discontinoius hvel.
 5905: 
 5906: 
 5907:          if (isTri) { // For triangles
 5908:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5909:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5910: 
 5911:             for (int j = 0; j < 3; j++) {
 5912:                // For every node of the triangle...
 5913:                Node *node = elem->nodes[j];
 5914: 
 5915:                const Side *s1 = elem->sides[j];
 5916:                const Side *s2 = elem->sides[(j + 1) % 3];
 5917:                const Side *s3 = elem->sides[(j + 2) % 3];
 5918: 
 5919:                const int numElements = node->numElements;
 5920:                const double inv_numElements = 1.0/numElements;
 5921: 
 5922:                for (int k = kb; k < nvrt; k++)  {
 5923:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 5924:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5925:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5926:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5927:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 5928:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 5929: 
 5930:                }
 5931: 
 5932:             }
 5933:          }
 5934:          else { // For quads
 5935:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 5936: 
 5937:          }
 5938: 
 5939:       }
 5940:       
 5941:    }
 5942: 
 5943: 
 5944:    __global__ void computeNodalHorizontalVelocities2(void) {
 5945:       NODE(node);
 5946: 
 5947:       for (int k = 0; k < nvrt; k++) {
 5948:          node->u2[k] = node->utmp[k];
 5949:          node->w2[k] = node->w2[k];
 5950:       }
 5951:       
 5952:    }   
 5953: 
 5954:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5955:    // XXXX I'm not sure where I got this function from. 
 5956:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5957:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5958:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5959:    // It uses the utmp array as a temporary array to store the velocities.
 5960: 
 5961:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5962: 
 5963:       SIDE(side);
 5964: 
 5965:       const int kb = side->kb;
 5966: 
 5967:       Node *n1 = side->n1;
 5968:       Node *n2 = side->n2;
 5969: 
 5970:       for (int k = kb; k < nvrt; k++) {
 5971: 
 5972:          // Cast the u2 vector into a Vector2 
 5973:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5974:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5975: 
 5976:          n1_u2 = side->u2[k]/n1->numSides;
 5977:          n2_u2 = side->u2[k]/n2->numSides;
 5978: 
 5979:       }
 5980: 
 5981: 
 5982:    }
 5983: 
 5984:    __global__ void resetVelocityOpenBndNodes(void) {
 5985:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5986: 
 5987:       NODE_BND(nodebnd);
 5988: 
 5989:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5990:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 5991:       }
 5992: 
 5993:    }
 5994: 
 5995: 
 5996:    __global__ void setVelocityOpenBndNodes(void) {
 5997:    // For open boundary nodes sets their velocity to the imposed values.
 5998: 
 5999:       SIDE_BND(sidebnd);
 6000: 
 6001:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6002:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6003:          // to its segment to the average of the side velocity.
 6004: 
 6005:          for (int k = 0; k < nvrt; k++) {
 6006:             Node *n1 = sidebnd->side->n1;
 6007:             Node *n2 = sidebnd->side->n2;
 6008: 
 6009: 
 6010:             Vector2 n1_u2(n1->u2[k]);
 6011:             Vector2 n2_u2(n2->u2[k]);
 6012: 
 6013:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6014:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6015:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6016:             }
 6017:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6018:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6019:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6020:             }
 6021: 
 6022:          }
 6023: 
 6024:       }
 6025: 
 6026:    }
 6027: 
 6028: 
 6029:    __global__ void computeVerticalVelocity(void) {
 6030:       // Computes the vertical velocity at the (2D) element's centroid.
 6031:       // In this function we will be considering volumetric elements, with side faces and a 
 6032:       // bottom and a top face. We will call them SFs, BF and TF.
 6033:       // It computes the flux coming from BF and the SFs.
 6034:       // If the bed is moving, it takes that into account.
 6035:       // Since water is incompressible, the integral of the velocity times the normal vector
 6036:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6037:       // and the BF is equal to the flux going out from the TF.
 6038:       // TF = - BF - sum(SFs).
 6039:       // It then computes the horizontal velocity at the center of TF.
 6040:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6041:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6042:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6043: 
 6044:       ELEM(elem);
 6045: 
 6046:       if (elem->isDry) return;
 6047: 
 6048:       const int kb = elem->kb;
 6049:       const bool isTri = elem->isTri();
 6050: 
 6051:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6052: 
 6053:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6054:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6055:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6056: 
 6057:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6058: 
 6059:       double area3D;
 6060: 
 6061:       // Bottom face flux
 6062:       double bottomFlux = 0.0;
 6063:       Vector2 u2meanBottom = {0.0, 0.0};
 6064:       const Vector2 gradh = elem->grad2(&Node::depth);
 6065:       if constexpr(imm==2) {
 6066:          Vector3 ubed;
 6067: 
 6068:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6069:          // updateBDEF(ubed);
 6070:      
 6071:          // const double bflux0 = dot(ubed, elem_n1);
 6072: 
 6073:          // elem->w[kb] += ubed.z;
 6074:       }
 6075:       else {
 6076:          Vector2 umean;
 6077:          if constexpr(ics == 1) {
 6078:             u2meanBottom = elem->mean(kb, &Side::u2);
 6079:          }
 6080:          else {
 6081:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6082:          }
 6083: 
 6084:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6085:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6086: 
 6087:          bottomFlux = - dot(gradh, u2meanBottom);
 6088:       } // if imm
 6089: 
 6090:       // Compute w for kb+1 to nvrt-1
 6091:       for (int l = kb; l < nvrt - 1; l++) {
 6092: 
 6093:          // normal vector to the top face of the "volumetric" element (3D)
 6094:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6095: 
 6096:          // Compute the total flux at the sides
 6097:          double sideFlux = 0.0;
 6098:          Vector2 u2top = {0.0, 0.0};
 6099:          for (int j = 0; j < elem->i34; j++) {
 6100:             const Side *side = elem->sides[j];
 6101: 
 6102:             const double sideArea = side->area(l);
 6103:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6104:             const double sign = elem->ssign[j]; 
 6105: 
 6106:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6107:          }
 6108:          
 6109:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6110:          //velocities at the centers of the sides
 6111:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6112: 
 6113:          // The flx at the top ace can be computed from the other flows.
 6114:          const double topFlux = - sideFlux - bottomFlux;
 6115:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6116: 
 6117:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6118: 
 6119:          elem_n1 = elem_n2;
 6120: 
 6121:          bottomFlux = - topFlux;
 6122:       }
 6123:    }  
 6124: 
 6125: 
 6126: 
 6127: 
 6128: 
