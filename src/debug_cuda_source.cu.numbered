 2220: //        if(rjac<=0._rkind) call parallel_abort('quad_int: Jac<=0')
 2221: //        x_xi=0.25_rkind*(wild(1)+pt(i)*wild(3)) !dx/d\xi
 2222: //        x_et=0.25_rkind*(wild(5)+pt(j)*wild(3))
 2223: //        y_xi=0.25_rkind*(wild(2)+pt(i)*wild(4))
 2224: //        y_et=0.25_rkind*(wild(6)+pt(j)*wild(4))
