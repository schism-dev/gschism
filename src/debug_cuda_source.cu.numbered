 1793: // Helper functions for computing the local node index at a given offset from another.
 1794: __device__ __inline__ int nxq(int offset, int index, int size) {
 1795:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1796:    // to the index to make it positive
 1797:    assert(index + offset + 16*size >= 0);
 1798:    return (index + offset + 16*size) % size;  
 1799: }
 1800: 
 1801: __device__ __inline__ int nxq(int index, int size) {
 1802:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1803:    // to the index to make it positive
 1804:    assert(index + 16*size >= 0);
 1805:    return (index + 16*size) % size; 
 1806: }
