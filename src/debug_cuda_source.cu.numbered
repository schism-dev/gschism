 5904:    
 5905: 
 5906: 
 5907:    __global__ void ul0UpdateSides(int it, int iths) {
 5908:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5909:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5910:    // The dryness of the sides is updated in ul0UpdateSides2.
 5911: 
 5912:       SIDE(side);
 5913: 
 5914:       // A side is wet if and only if at least one of its elements is wet.
 5915:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5916:  
 5917:       const Node *n1 = side->n1;
 5918:       const Node *n2 = side->n2;
 5919:      
 5920:       const int kb1 = n1->kb;
 5921:       const int kb2 = n2->kb;
 5922: 
 5923:       side->kb = 0; // default when dry
 5924: 
 5925:       if (isWet) {
 5926: 
 5927:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5928: 
 5929:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5930: 
 5931:          side->kb = min(kb1, kb2);
 5932: 
 5933:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5934: 
 5935:          for (int k = side->kb; k < nvrt; k++) {
 5936:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5937: 
 5938:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5939: 
 5940:             // Compute velocity for re-wetted sides 
 5941:             if ((it != iths) && (side->isDry && isWet)) {
 5942: 
 5943:                Vector2 utmp={0.0, 0.0};
 5944: 
 5945:                int icount=0;
 5946: 
 5947:                // For all the sides on the two elements that share this side
 5948:                for (int j = 0; j < 2; j++) {
 5949:                   const Element *elem = side->elems[j];
 5950:                   if (elem == nullptr) continue;
 5951: 
 5952:                   for (int jj=0; jj < elem->i34; jj++) {
 5953:                      const Side *nSide = elem->sides[jj];
 5954:                      if (nSide->isDry) continue;
 5955: 
 5956:                      icount++;
 5957:                      utmp += nSide->u2[k];  
 5958:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5959:                   }
 5960:                }
 5961:                   
 5962:                // assert(icount > 0 && "No wet sides around this side");  XXXXX RECOVER??? 
 5963:                if (icount > 0)  side->u2[k] = utmp/icount;
 5964:                else             side->u2[k] = {0.0, 0.0};
 5965:                   
 5966:             } // if ((it != iths) && (side->isDry && isWet))
 5967: 
 5968:          } // for k
 5969: 
 5970:       } // if isWet 
 5971:       
 5972: 
 5973: 
 5974:    }
 5975: 
 5976:    __global__ void ul0UpdateSides2(void) {
 5977:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5978:    
 5979:          SIDE(side);
 5980:    
 5981:          const Element *e1 = side->elems[0];
 5982:          const Element *e2 = side->elems[1];
 5983: 
 5984:          // A side is wet if and only if at least one of its elements is wet.
 5985:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5986: 
 5987:          // Update the side's dryness
 5988:          side->isDry = !isWet;
 5989: 
 5990: if (side->isDry) {for (int k = 0; k < nvrt; k++) {side->u2[k] = {0.0, 0.0};side->w2[k] = 0.0;}}  // XXXX KKKKKK Not in the original code
 5991: 
 5992:    }
 5993: 
