 1152: // This struct is used to store the boundary information for a node.
 1153: struct NodeBoundary {   
 1154:    int idx;
 1155:    BoundarySegment *segment;
 1156:    Node *node;
 1157:    
 1158:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1159:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1160: 
 1161:    bool isLand;
 1162: 
 1163:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1164:    double elbc;   // Elevation boundary condition
 1165:    double eth;    // Elevation time history
 1166: 
 1167:    double eta_mean; // Mean elevation at nodes
 1168: 
 1169:    bool isEssentialBC;
 1170: 
 1171:    Vector2 uth[nvrt];  // "Time history" velocity
 1172: 
 1173:    // Arrays for harmonic constituents (if needed)
 1174:    double  emo[nbfr];  // Elevation amplitude
 1175:    double  efa[nbfr];  // Elevation phase
 1176:    Vector2 umo[nbfr];  // velocity amplitude
 1177:    Vector2 ufa[nbfr];  // velocity phase
 1178: 
 1179: 
 1180:    NodeBoundary(void) {
 1181:       isLand = false;
 1182:    }
 1183:    NodeBoundary(bool _isLand) {
 1184:       isLand = _isLand;
 1185:    }
 1186: 
 1187:    
 1188:    __forceinline__ __device__ int numSidesForAverage() const {
 1189:    // Returns the number of sides that are connected to the node and have the same segment.
 1190:    // This is used to compute the average velocity at the node for open boundary nodes.
 1191:       int res = 0;
 1192:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1193:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1194: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1195:       return res;
 1196:    }
 1197: 
 1198: 
 1199:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1200:       assert(index == 0 || index == 1); 
 1201:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1202:    }
 1203: 
 1204: 
 1205: };
