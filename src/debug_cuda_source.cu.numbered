  733: 
  734: // ------------------------------------------------------------
  735: // Data structures for the system matrix and vector
  736: // ------------------------------------------------------------
  737: 
  738: // Since every device owns a partition, we can divide a matrix A into row blocks A_p, where p is the device/partition index.
  739: // Here we are abusing notation assuming that the global indices are consecutive per partition.
  740: // In general, partition p will contain indices that are not consecutive in the global index space.
  741: 
  742: __device__ __forceinline__ int localIdx(Node* node);
  743: 
  744: // Wrapper of CuPyx CSR matrix. Used to store individual A_p rowblocks of the matrix.
  745: struct CsrBlockMatrix {
  746:    double* data;
  747:    int*    indices;
  748:    int*    indptr;
  749:    int nrows;
  750:    int ncols;
  751: 
  752:    __device__ CsrBlockMatrix(double* data, int* indices, int* indptr, int nrows, int ncols) : data(data), indices(indices), indptr(indptr), nrows(nrows), ncols(ncols) {}
  753: 
  754:    __device__ __forceinline__ void clearRow(Node* node) { 
  755:       const int i = localIdx(node);
  756:       for (int k = indptr[i]; k < indptr[i + 1]; ++k) data[k] = 0.0;
  757:     }
  758: 
  759:    __device__ __forceinline__ void add(int i, int j, double val) {
  760:       const int start = indptr[i];
  761:       const int end   = indptr[i + 1];
  762:       for (int k = start; k < end; ++k) {
  763:          if (indices[k] == j) {
  764:             data[k] += val;
  765:             return;
  766:          }
  767:       }
  768:       assert(false && "CSR entry (i,j) missing");
  769:    };
  770: };
  771: 
  772: 
  773: // A block row matrix. All coefficients stored in a single device.
  774: struct RowBlockMatrix {
  775:    CsrBlockMatrix Ap[nPartitions];
  776: 
  777:    __device__ __forceinline__ RowBlockMatrix(CsrBlockMatrix const* src) {
  778:       for (int q = 0; q < nPartitions; ++q)
  779:          this->Ap[q] = src[q];
  780:    }
  781: 
  782:    __device__ __forceinline__ void clearRow(Node* n) {
  783:       for (int q = 0; q < nPartitions; ++q)
  784:          Ap[q].clearRow(n);
  785:    }
  786: 
  787:    __device__ __forceinline__ void add(Node* row, Node* col, double val)
  788:    {
  789:          assert(row->part == mesh->partNum);
  790: 
  791:          const int i = localIdx(row);
  792:          const int j = localIdx(col);
  793:          const int p = row->part; // Unused. Included for symmetry. Doesn't generate any code.
  794:          const int q = col->part;
  795: 
  796:          Ap[q].add(i, j, val);
  797: 
  798:    }
  799: 
  800: };
  801: 
  802: 
  803: // A full vector. Coefficients can be stored in different devices.
  804: struct FullVector {
  805:    double* data[nPartitions];   // Pointer to vectors in different devices
  806: 
  807:    __device__ FullVector(double* const src[nPartitions]) {
  808:       for (int p = 0; p < nPartitions; ++p)
  809:          data[p] = src[p];
  810:    }
  811: 
  812:    __device__ __forceinline__ double& operator()(Node* node) {
  813:       const int part = node->part;
  814:       const int locIdx = localIdx(node); // Local index of the node in the partition
  815:       return data[part][locIdx];
  816:    }
  817: 
  818:    __device__ __forceinline__ double  operator()(Node* node) const {
  819:       const int part = node->part;
  820:       const int localIdx = node - mesh->nodes[part]; // Local index of the node in the partition
  821:       return data[part][localIdx];
  822:    }
  823: };
  824: 
