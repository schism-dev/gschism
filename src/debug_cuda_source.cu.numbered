 7151: __global__ void printMatrix(bool full) {
 7152:    // Debugging: print the matrix
 7153: 
 7154:    const int size = mesh->np;
 7155:    double sum = 0.0;
 7156:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7157:       const Node *node = mesh->localNodeData + idx_node;
 7158:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7159:       for (int j = 0; j < node->numNodes; j++) {
 7160:          Node* nbNode = node->nodes[j];
 7161:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7162:          sum += node->coeffMatrix[j];
 7163:       }
 7164:       if (full) printf("]\n");
 7165: 
 7166: 
 7167:    }
 7168:    if (!full) printf("sum=%lf\n", sum);
 7169: }
