 1993: __device__ void lock(int *mutex) {
 1994:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1995: }
 1996: 
 1997: __device__ void unlock(int *mutex) {
 1998:     atomicExch(mutex, 0);
 1999: }
