 3837:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3838: 
 3839:       NODE_BND(nodeBnd);
 3840: 
 3841:       Node *node = nodeBnd->node;
 3842: 
 3843:       node->ETP = 0.0;
 3844: 
 3845:       for (int j=0; j<ntip; j++) {
 3846: 
 3847:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3848:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3849:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3850: 
 3851:          if constexpr(iloadtide==1) { // loading tide
 3852:             assert(false && "Loading tide not implemented");
 3853:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3854:          }
 3855:          
 3856:       }
 3857:       
 3858:    }
