 1828: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1829:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1830: }
 1831: 
 1832: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1833:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1834: }   
 1835: 
 1836: __device__ __inline__ double min3(double a, double b, double c) {
 1837:    return min(a, min(b, c));
 1838: }
 1839: 
 1840: __device__ __inline__ double max3(double a, double b, double c) {
 1841:    return max(a, max(b, c));
 1842: }
 1843: 
 1844: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1845:    return min(a, min(b, min(c, d)));
 1846: }
