 5314:    __global__ void scaleGravity(double loadtide_coef) {
 5315: 
 5316: 
 5317:       NODE(node);
 5318: 
 5319:       // SAL option: scale gravity
 5320:       if constexpr(iloadtide==2) {  // simple const
 5321:          node->grav2 = grav*(1.0 - loadtide_coef);
 5322: 
 5323:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5324:         
 5325:           const double depth = max(node->depth, 0.0);
 5326:           const double tmp1 = sqrt(depth);
 5327:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5328:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5329:                              2.6969e-13*depth*depth*depth*tmp1;
 5330:           
 5331:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5332:           
 5333: 
 5334: 
 5335:           node->grav2 = grav*(1.0 - beta_bar);
 5336: 
 5337:       } else {  // iloadtide=0,1
 5338:           node->grav2 = grav;
 5339: 
 5340:       }
 5341: 
 5342:    }
