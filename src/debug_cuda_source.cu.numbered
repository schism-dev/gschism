  264: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  265:     return v.x*w.x + v.y*w.y;
  266: }
  267: 
  268: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  269:     return v.x*w.y - v.y*w.x;
  270: }
