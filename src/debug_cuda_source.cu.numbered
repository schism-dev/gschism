 3945: __device__ __inline__ void Node::updateZCoordData(void) {
 3946: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3947: 
 3948:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3949:    // if (isDry2()) {
 3950:    //    kb = -1;  // XXXXXXXX KKKKK
 3951:    //    return;
 3952:    // }
 3953: 
 3954: 
 3955:    if constexpr(ivcor == 2) {  // SZ coordinates
 3956:       
 3957:       // Compute bottom level index
 3958:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3959:    } 
 3960:    else {  // if (ivcor == 1) Localized sigma
 3961:       // Do nothing
 3962:    }
 3963: 
 3964: 
 3965: }
