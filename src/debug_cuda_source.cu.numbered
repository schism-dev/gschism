 5266: extern "C" {
 5267: 
 5268:    __global__ void scaleGravity(double loadtide_coef) {
 5269: 
 5270: 
 5271:       NODE(node);
 5272: 
 5273:       // SAL option: scale gravity
 5274:       if constexpr(iloadtide==2) {  // simple const
 5275:          node->grav2 = grav*(1.0 - loadtide_coef);
 5276: 
 5277:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5278:         
 5279:           const double depth = max(node->depth, 0.0);
 5280:           const double tmp1 = sqrt(depth);
 5281:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5282:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5283:                              2.6969e-13*depth*depth*depth*tmp1;
 5284:           
 5285:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5286:           
 5287: 
 5288: 
 5289:           node->grav2 = grav*(1.0 - beta_bar);
 5290: 
 5291:       } else {  // iloadtide=0,1
 5292:           node->grav2 = grav;
 5293: 
 5294:       }
 5295: 
 5296:    }
 5297: 
 5298: 
 5299:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5300:       NODE(node);
 5301: 
 5302:       const int idx = node->idx;
 5303:       Vector2 wind = {xWind[idx], yWind[idx]};
 5304: 
 5305:       if constexpr(nws != 0 && iwindoff != 0) {
 5306:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5307:       }
 5308: 
 5309:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5310:       node->setWind(wind);
 5311: 
 5312:       node->pr = pressAir[idx];
 5313:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5314: 
 5315:    }
