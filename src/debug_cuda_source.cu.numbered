 7406: __global__ void printMatrix(bool full) {
 7407:    // Debugging: print the matrix
 7408: 
 7409:    const int size = mesh->np;
 7410:    double sum = 0.0;
 7411:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7412:       const Node *node = mesh->localNodeData + idx_node;
 7413:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7414:       for (int j = 0; j < node->numNodes; j++) {
 7415:          Node* nbNode = node->nodes[j];
 7416:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7417:          sum += node->coeffMatrix[j];
 7418:       }
 7419:       if (full) printf("]\n");
 7420: 
 7421: 
 7422:    }
 7423:    if (!full) printf("sum=%lf\n", sum);
 7424: }
