 2318:    template<typename T>
 2319:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2320:       T values[4];
 2321:       getNodalValues(field, values);
 2322: 
 2323:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2324:       if constexpr (IsVector2<T>::value && ics == 2) {
 2325: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2326:          projectNodeVectorsToElementFrame(values);
 2327: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2328:       }
 2329: 
 2330:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2331:    }
