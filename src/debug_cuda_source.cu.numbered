 2037: 
 2038: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2039:    if constexpr(ics == 1)  {
 2040:       return center;
 2041: 
 2042:    } else {
 2043:       const Point2 p0 = nodes[0]->outputCoords();
 2044:       const Point2 p1 = nodes[1]->outputCoords();
 2045:       const Point2 p2 = nodes[2]->outputCoords();
 2046: 
 2047:       if (isTri()) {
 2048:          return (1.0/3.0)*(p0 + p1 + p2);
 2049: 
 2050:       } else {
 2051:          const Point2 p3 = nodes[3]->outputCoords();
 2052:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2053:       }
 2054: 
 2055:    }
 2056: }
 2057: 
 2058: 
 2059: __device__ __forceinline__ double Element::centerZ(void) const { 
 2060: // Z coordinate of the element center in the global cartesian coordinates.
 2061: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2062: 
 2063:    if constexpr(ics==1) { 
 2064:       return 0.0; 
 2065: 
 2066:    } else { 
 2067: 
 2068:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2069:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2070:    } 
 2071: }
