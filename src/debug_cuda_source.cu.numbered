 7092:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7093:       const Node *node = mesh->localNodeData + idx_node;
 7094:       res[idx_node*size + idx_node] = node->coeffDiag;
 7095:       for (int j = 0; j < node->numNodes; j++) {
 7096:          Node* nbNode = node->nodes[j];
 7097:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7098:       }
 7099: 
 7100:    }
 7101:    
 7102: }
