 5613: 
 5614: 
 5615:    __global__ void backtrackAllNodes(void) {
 5616: 
 5617:       // max/min # of sub-divisions
 5618:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5619:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5620: 
 5621:       SIDE(side);
 5622: 
 5623:       const int kb = side->kb;
 5624: 
 5625: 
 5626:       // Initialize btrack velocities to the actual velocities at the side 
 5627:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5628:   
 5629:       if (side->isDry) return;
 5630:      
 5631: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5632: 
 5633:       // Checks that at least one element is not dry
 5634:       const Element *elem1 = side->elems[0];
 5635:       const Element *elem2 = side->elems[1];
 5636: 
 5637: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5638: 
 5639:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5640:       
 5641:       // XXXXXX
 5642:       // !swild_tmp to store global coord. of the starting side
 5643:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5644:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5645:       // !Use sframe2 
 5646:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5647: 
 5648: 
 5649:       for (int k = kb; k < nvrt; k++) {
 5650:       //  For ics=2, the coordinates are all in the side's local frame
 5651: 
 5652:          const int iadvf = side->iadv();  // Advection flag   
 5653:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5654: 
 5655:          const double vmag2 = norm2(side->u2[k]);
 5656: 
 5657:          if (vmag2 <= velmin_btrack_sq) {  
 5658:             // No activity 
 5659: 
 5660:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5661:             
 5662:          } else {  // do btrack
 5663: 
 5664:             // Compute number of sub-divisions based on local gradients of the velocity field
 5665: 
 5666:             // XXX IS THIS NECESSARY?
 5667:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5668:             double suma = 0.0;
 5669:             int icount = 0;
 5670:             #pragma unroll
 5671:             for (int l=0; l<2; l++) {
 5672:             // For each element sharing the side...
 5673: 
 5674:                const Element *elem = side->elems[l];
 5675:                  
 5676:                if (elem == nullptr) continue;
 5677: 
 5678:                icount++;
 5679: 
 5680:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5681:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5682:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5683: 
 5684:                double utmp[4];
 5685:                double vtmp[4];
 5686:                #pragma unroll
 5687:                for (int j = 0; j < elem->i34; j++) {
 5688: 
 5689:                   const Node *node = elem->nodes[j];
 5690: 
 5691:                   if constexpr(ics==1) {
 5692:                      utmp[j] = node->u2[k].x;
 5693:                      vtmp[j] = node->u2[k].y;  
 5694: 
 5695:                   } else {
 5696:                      // 'Project' the velocity from the node frame to the element frame
 5697:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5698:                      utmp[j] = tmp_u2.x;
 5699:                      vtmp[j] = tmp_u2.y;
 5700: 
 5701:                   }
 5702:                } // for j
 5703: 
 5704:                const Vector2 grad_u = elem->grad2(utmp); 
 5705:                const Vector2 grad_v = elem->grad2(vtmp);
 5706:    
 5707:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5708:             } // for l
 5709: 
 5710:             assert(icount > 0 && "Impossible 77");
 5711: 
 5712:             // '4' is somewhat arbitrary
 5713:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5714: 
 5715:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5716:             Vector3 u_int = {0.0, 0.0, 0.0};
 5717: 
 5718:             side->btrack(k, dt, dtbk, u_int);
 5719: 
 5720: 
 5721:             side->btu[k] = {u_int.x, u_int.y};
 5722:                
 5723:          } // if vmag (do backtrack)
 5724: 
 5725: 
 5726:       } // for k=kb,nvrt-1
 5727: 
 5728:    }
 5729: 
 5730: } // extern "C"
 5731: 
 5732: template<int nc>
 5733: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5734: 
 5735: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5736: //
 5737: // Although this is a general function, it is used only for equations on vertical levels.
 5738: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5739: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5740: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5741: //
 5742: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5743: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5744: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5745: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5746: 
 5747:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5748:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5749: 
 5750:    double bet = b[0];
 5751:    if constexpr (nc == 1) {
 5752:       u[0] = rhs[0]/bet;
 5753:    } else {
 5754:       #pragma unroll
 5755:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5756:    }
 5757: 
 5758:    for (int j = 1; j < n; j++) {
 5759:       gam[j] = c[j - 1]/bet;
 5760:       bet = b[j] - a[j]*gam[j];
 5761: 
 5762:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5763: 
 5764:       if constexpr (nc == 1) {
 5765:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5766:       } else {
 5767:          #pragma unroll
 5768:          for (int l = 0; l < nc; l++) {
 5769:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5770:          }
 5771:       }
 5772:    }
 5773: 
 5774:    // Back-substitution
 5775:    for (int j = n - 2; j >= 0; j--) {
 5776:       if constexpr (nc == 1) {
 5777:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5778:       } else {
 5779:          for (int l = 0; l < nc; l++) {
 5780:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5781:          }
 5782:       }
 5783:    }
 5784: }
 5785: 
 5786: 
 5787: 
 5788: // Helper function that contains the core algorithm
 5789: template<typename XAccessor, typename YAccessor>
 5790: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5791:                                     double  yp_top, double  yp_bot, 
 5792:                                     CubicSpline &spline) {
 5793:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5794:    // 
 5795:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5796:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5797:    //
 5798:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5799:    // 
 5800:    // Inputs: 
 5801:    //            n: dimension for x etc; # of data pts (>=2);
 5802:    //            getX, getY: functions to access x,y coordinates
 5803:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5804:    //     Output: 
 5805:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5806: 
 5807:    const int n = k2 - k1 + 1;
 5808:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5809: 
 5810:    // Allocate memory for the splines
 5811:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5812:    spline.x   = new double[n];
 5813:    spline.y   = new double[n];
 5814:    spline.yp  = new double[n];
 5815:    spline.ypp = new double[n];
 5816: 
 5817:    for (int k=k1; k<=k2; k++) {
 5818:       spline.x[k] = getX(k);
 5819:       spline.y[k] = getY(k);
 5820:    }
 5821: 
 5822:    // This is to simplify expressions later
 5823:    double *x = spline.x;
 5824:    double *y = spline.y;
 5825: 
 5826:    double *a = nullptr;
 5827:    double *b = nullptr;
 5828:    double *c = nullptr;
 5829:    double *gam = nullptr;
 5830:    double *rhs = nullptr;
 5831:    
 5832: 
 5833:       a = new double[n];   // Lower diagonal
 5834:       b = new double[n];   // Diagonal
 5835:       c = new double[n];   // Upper diagonal
 5836:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5837:       rhs = new double[n]; // Right-hand side
 5838: 
 5839:    for (int k=k1; k<=k2; k++) {
 5840:       if (k == k1) {
 5841:          // Bottom level
 5842:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5843:          b[k] = (x[k+1] - x[k])/3.0;
 5844:          c[k] = b[k]/2.0;
 5845:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5846:       } else if (k == n - 1) {
 5847:          // Top level (surface)
 5848:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5849:          b[k] = (x[k] - x[k-1])/3.0;
 5850:          a[k] = b[k]/2.0;
 5851:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5852:       } else {
 5853:          // Intermediate levels
 5854:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5855:          b[k] = (x[k+1] - x[k-1])/3.0;
 5856:          a[k] = (x[k  ] - x[k-1])/6.0;
 5857:          c[k] = (x[k+1] - x[k  ])/6.0;
 5858:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5859:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5860:       }
 5861:    }
 5862: 
 5863:    // Solve the tridiagonal system
 5864:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5865:    
 5866:    spline.yp[k1] = yp_bot;
 5867:    spline.yp[k2] = yp_top;
 5868: 
 5869:    // Compute rest of 1st derivatives using the splines
 5870:    for (int k=k1+1; k<k2; k++) {
 5871:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5872:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5873:    }
 5874:    
 5875:    delete[] a;
 5876:    delete[] b;
 5877:    delete[] c;
 5878:    delete[] gam;
 5879:    delete[] rhs;
 5880: 
 5881: }
 5882: 
 5883: // Array version
 5884: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5885:                                 double y_top, double y_bot, 
 5886:                                 CubicSpline &spline) {
 5887:    auto getX = [x] (int k) { return x[k]; };
 5888:    auto getY = [y] (int k) { return y[k]; };
 5889:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5890: }
 5891: 
 5892: // Lambda version - allows custom access patterns
 5893: template<typename XFunc, typename YFunc>
 5894: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5895:                                 double y_top, double y_bot,
 5896:                                 CubicSpline &spline) {
 5897:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5898: }
