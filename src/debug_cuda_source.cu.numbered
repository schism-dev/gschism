  735: struct Element {
  736: 
  737:    // Geometry information
  738:    int idx;                   // Index of the element
  739:    int16_t i34;               // Number of sides for the element 
  740:    Side *sides[4];            // Sides of the element
  741:    Node *nodes[4];            // Nodes of the element
  742:    Element *nghbElems[4];     // Neighbors of the element
  743: 
  744:    int16_t kb;                // Bottom index of the element
  745:    double area;               // Area of the element
  746:    double ssign[4];           // Sign associated with each side of an element
  747:    double radius;             // Element equivalent radii
  748: 
  749:    Frame<ics> frame;
  750: 
  751:    Vector2 gradPhi[4];        // Derivatives of shape functions
  752:    Vector2 gradEta;           // Gradient of free surface elevation
  753:    Vector2 gradPr;            // Gradient of pressure    
  754:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  755: 
  756:    bool isDry;                // True if the element is dry
  757: 
  758:    Point2 center;            // Element center coordinates (global coordinates)
  759: 
  760:    double depth;              // Depth at element (min of all nodes)
  761:    double z[nvrt];            // z-coord  (local frame - vertical up)
  762: 
  763:    // Physical information
  764:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  765: 
  766:    static const bool isblock = false;              // Always false
  767: 
  768:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  769:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  770: 
  771:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  772:    
  773: 
  774:    double vsource;            // Volumetric source/sink term [m^3/s]
  775: 
  776:    double rho[nvrt];          // Density at each prism center
  777:    double rho_mean[nvrt];     // Mean density at each prism center
  778:    CubicSpline rho_spl;
  779:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  780:    double rho_z[nvrt];        // First derivative of density at each prism center
  781:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  782:    
  783: 
  784:    __inline__ __device__ Point2 outputCoords(void) const;
  785: 
  786:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  787: 
  788:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  789:    // If ics == 2, convert the global point to the local frame of the element
  790:       
  791:       if constexpr (ics == 1) {
  792:          return p;
  793:       } else {
  794:          const Point3 c = {center.x, center.y, centerZ()};
  795:          return frame.G2L(p - c);
  796:       }
  797:    }
  798: 
  799:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
  800:    // If ics == 2, convert the local point to a global point
  801:       
  802:       if constexpr (ics == 1) {
  803:          return p;
  804:       } else {
  805:          const Point3 c = {center.x, center.y, centerZ()};
  806:          return c + frame.L2G(p);
  807:       }
  808:    }
  809: 
  810:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  811:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  812: 
  813:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  814:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  815: 
  816:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  817:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  818:       // Find the local index of the node in the element (0,1,2,3)
  819:       int res = __ffs((nodes[0] == node) | 
  820:                      ((nodes[1] == node) << 1) | 
  821:                      ((nodes[2] == node) << 2) | 
  822:                      ((nodes[3] == node) << 3)) - 1;
  823:       
  824:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  825:       return res;  
  826:    }
  827: 
  828:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  829:       // Find the local index of the side in the element (0,1,2,3)
  830:       int res = __ffs((sides[0] == side) | 
  831:                      ((sides[1] == side) << 1) | 
  832:                      ((sides[2] == side) << 2) | 
  833:                      ((sides[3] == side) << 3)) - 1;
  834:       
  835:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  836:       return res;
  837:    }
  838: 
  839:    __inline__ __device__ int findLevel(double z1, int k) const {
  840:       // Starting at index k, find sequentially the level that contains z
  841: 
  842:       // For testing purposes, forgets k and performs a full search.
  843:       for (k = kb; k < nvrt - 1; k++) {
  844:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  845:       }
  846:       return nvrt - 2;
  847: 
  848: 
  849:       // if z is already betweeen z[k] and z[k+1], return k
  850:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  851:       else if (z1 <  z[k]) { 
  852:          // Search for increasing levels
  853:          for (int kk = k; kk < nvrt - 1; kk++) {
  854:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  855:          }
  856:          return nvrt - 1;
  857:       }
  858:       else {
  859:          // Search for decreasing levels
  860:          for (int kk = k; kk >= kb; kk--) {
  861:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  862:          }
  863:          return 0;
  864:       }
  865:    }
  866: 
  867:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  868:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  869: 
  870: 
  871:    __device__ __forceinline__ double centerZ(void) const;
  872: 
  873:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  874:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  875:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  876:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
  877:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
  878:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  879:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
  880:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
  881:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  882: 
  883: 
  884:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  885:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  886:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  887:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  888:        const double eta = (idxNode & 1) ? +g : -g;
  889:        const double xi  = (idxNode & 2) ? +g : -g;
  890:        return {eta, xi};
  891:    }  
  892: 
  893: 
  894: 
  895:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  896:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
  897:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
  898:    }
  899: 
  900:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  901:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
  902:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
  903:    }   
  904: 
  905:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  906:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
  907:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
  908:    }      
  909:    
  910:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  911: 
  912:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  913: 
  914:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
  915:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
  916: 
  917:    // Check if the element is dry using the more up-to-date elevation.
  918:    __inline__ __device__ bool isDry2(void) const;
  919: 
  920:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  921: 
  922:    __forceinline__ __device__ bool inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const;
  923: 
  924:    __inline__ __device__ double computeSignedArea(void) const;
