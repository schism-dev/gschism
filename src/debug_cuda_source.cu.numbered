 4473:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4474:                 double *drag, double *roughness,
 4475:                 double *emo, double *efa, 
 4476:                 double *umo, double *ufa, 
 4477:                 double *vmo, double *vfa) {
 4478: 
 4479:    printf("Populating mesh for partition %d\n", partNum);
 4480: 
 4481:    // XXXXXX THIS function does almost nothing. 
 4482: 
 4483:    nbs = *sharedIdxSideBoundary + 1;
 4484:    nbp = *sharedIdxNodeBoundary + 1;
 4485: 
 4486:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4487: 
 4488: }
