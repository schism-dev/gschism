  716:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  717:                                         double& tIntersect);
  718: 
  719:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  720:       // Check if the point (xt,yt) is inside the element
  721:       double shpCoords[4];
  722: 
  723:       bool res = computeShapeCoords(xt, shpCoords, fiNo);
  724: 
  725:       return res;
  726:    }
  727: 
  728:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  729:       // Check if the point (xt,yt) is inside the element.
  730:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  731:       double shpCoords[4];
  732: 
  733:       Vector2 tmp_xt = xt;
  734:       const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
  735:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords);
  736: 
  737:       if (fixCoords && res) xt = tmp_xt;
  738: 
  739:       return res;
  740:    }
  741: 
  742:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  743:    {
  744:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  745:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  746:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  747:       
  748:    }
  749: 
  750:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  751: 
  752:    // ------------------------------------------------------------------------------------------------
  753:    // These are functions that work on all nodes of the element.
  754:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  755:    //
  756:    // An example of how to use these functions is:
  757:    //   
  758:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  759:    // 
  760:    // Where L is the level at which the field is to be interpolated. The field can be either
  761:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  762:    // There are different versions of getNodalValues for each of these cases.
  763: 
  764:    template<typename T>
  765:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  766:       // Get the values of the field at the nodes of the element
  767:       res[0] = nodes[0]->*field;
  768:       res[1] = nodes[1]->*field;
  769:       res[2] = nodes[2]->*field;
  770:       if (isQuad()) res[3] = nodes[3]->*field;
  771:       else          res[3] = T();
  772:    }
  773: 
  774:    template<typename T>
  775:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  776:       // Get the values of the field at the nodes of the element
  777:       res[0] = (nodes[0]->*field)[level];
  778:       res[1] = (nodes[1]->*field)[level];
  779:       res[2] = (nodes[2]->*field)[level];
  780:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  781:       else          res[3] = T();
  782:    }    
  783: 
  784:    template<typename T>
  785:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  786:       // Get the values of the func at the nodes of the element
  787:       res[0] = (nodes[0]->*func)(level);
  788:       res[1] = (nodes[1]->*func)(level);
  789:       res[2] = (nodes[2]->*func)(level);
  790:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  791:       else          res[3] = T();  // This is 0.0 or a zero vector
  792: 
  793:    }      
  794: 
  795:    template<typename T>
  796:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  797:       // Get the values of the field at the nodes of the element
  798:       res[0] = sides[0]->*field;
  799:       res[1] = sides[1]->*field;
  800:       res[2] = sides[2]->*field;
  801:       if (isQuad()) res[3] = sides[3]->*field;
  802:       else          res[3] = T();
  803:    }
  804: 
  805:    template<typename T>
  806:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  807:       // Get the values of the field at the nodes of the element
  808:       res[0] = (sides[0]->*field)[level];
  809:       res[1] = (sides[1]->*field)[level];
  810:       res[2] = (sides[2]->*field)[level];
  811:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  812:       else          res[3] = T();
  813:    }    
  814: 
  815:    template<typename T>
  816:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  817:       // Get the values of the func at the nodes of the element
  818:       res[0] = (sides[0]->*func)(level);
  819:       res[1] = (sides[1]->*func)(level);
  820:       res[2] = (sides[2]->*func)(level);
  821:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  822:       else          res[3] = T();  // This is 0.0 or a zero vector
  823: 
  824:    }      
  825: 
  826:    template<typename T>
  827:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  828:       T values[4];
  829:       getNodalValues(level, func, values);
  830: 
  831:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  832:    }
  833: 
  834:    template<typename T>
  835:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  836:       T values[4];
  837:       getNodalValues(field, values);
  838:       
  839:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  840:    }
  841: 
  842: 
  843:    template<typename T>
  844:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  845:       T values[4];
  846:       getNodalValues(level, field, values);
  847: 
  848:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  849:    }
  850: 
  851:    template<typename T>
  852:    __device__ T mean(T Node::* field) const {
  853:       T values[4];
  854:       getNodalValues(field, values);
  855: 
  856:       assert(i34 == 4 || values[3] == T() && "mean: values[3] is not zero with i34 == 4");
  857: 
  858:       return (values[0] + values[1] + values[2] + values[3])/i34;
  859:    }
  860: 
  861:    template<typename T>
  862:    __device__ T mean(T Side::* field) const {
  863:       T values[4];
  864:       getSideValues(field, values);
  865:       
  866:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  867: 
  868:       return (values[0] + values[1] + values[2] + values[3])/i34;
  869:    }   
  870: 
  871:    template<typename T>
  872:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  873:       T values[4];
  874:       getNodalValues(level, field, values);
  875: 
  876:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  877: 
  878:       return (values[0] + values[1] + values[2] + values[3])/i34;
  879:    }
  880: 
  881:    template<typename T>
  882:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  883:       T values[4];
  884:       getSideValues(level, field, values);
  885:       
  886:       // assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  887: 
  888:       return (values[0] + values[1] + values[2] + values[3])/i34;
  889:    }   
  890: 
  891:    // __device__ double mean(double (Node::*func)(int) const) const {
  892:    //    double values[4];
  893:    //    getNodalValues(level, func, values);
  894:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  895:    // }
