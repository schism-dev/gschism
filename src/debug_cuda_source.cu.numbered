 1680:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1681:       // Compute the different time ramps used in the code 
 1682:       // This function is performed by just one thread
 1683: 
 1684:       rampbc = 1.0;
 1685:       if constexpr(ibc == 0) {
 1686:          if (drampbc > 0.0) {
 1687:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1688:          } else {
 1689:             rampbc = 1.0;
 1690:          }
 1691:       }
 1692: 
 1693:       if (nws != 0) {
 1694:          if (drampwind > 0.0) {
 1695:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1696:          } else {
 1697:             rampwind = 1.0;
 1698:          }
 1699:       }
 1700: 
 1701:       if (drampwafo > 0.0) {
 1702:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1703:       } else {
 1704:          rampwafo = 1.0;
 1705:       }
 1706: 
 1707:       // For source/sinks
 1708:       if (if_source && dramp_ss > 0.0) {
 1709:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1710:       } else {
 1711:          ramp_ss = 1.0;
 1712:       }
 1713: 
 1714:       if (dramp > 0.0) {
 1715:          ramp = tanh(2.0*time/86400.0/dramp);
 1716:       } else {
 1717:          ramp = 1.0;
 1718:       }
 1719: 
 1720: 
 1721:    }
