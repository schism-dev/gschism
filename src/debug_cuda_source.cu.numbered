 7079:    __global__ void resetVelocityOpenBndNodes(void) {
 7080:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7081: 
 7082:       NODE_BND(nodebnd);
 7083: printf("DDDDDDDDDD\n");
 7084:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7085:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7086:       }
 7087: 
 7088:    }
