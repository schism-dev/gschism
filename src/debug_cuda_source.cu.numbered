 5580: 
 5581:    __global__ void solverCopyResult(double* x) {
 5582:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 5583:       NODE(node);
 5584:       const int idx = node->idx;
 5585: 
