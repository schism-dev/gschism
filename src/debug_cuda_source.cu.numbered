 6036: #ifdef DONTCOMPILE
 6037: __device__ void computeVerticalAdvection(void) {
 6038:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6039: 
 6040:    sdbt(1:2,:,:)=0.d0
 6041: 
 6042:    const Side *side = FROM kernel;
 6043: 
 6044:    if(side->isDry) return;
 6045: 
 6046:    // If side is wet...
 6047: 
 6048: 
 6049:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6050:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6051:    double ws[nvrt] = {} // w @ side
 6052:    int icount = 0;
 6053:    for (int j=0; j<2; j++) {
 6054:       const Element *elem = side->elements[j];
 6055:        
 6056:       if(elem != nullptr) {
 6057:          icount++;
 6058:          for (int k=0; k<nvrt; k++) {
 6059:             ws[k] = ws[k] + elem->w[k];
 6060:          }
 6061:       }
 6062:    }  // for j
 6063: 
 6064:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6065:    ws = ws/icount;
 6066: 
 6067:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6068:    // Splines allow for a smooth transition between vertical levels.
 6069:    // Splines have continuity restrictions at the internal knots, but
 6070:    // we have to provide the 1st derivatives at the endpoints.
 6071:    const int kbs = side->kbs; 
 6072:    
 6073:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6074:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6075:    initCubicSpline(kbs, nvrt, side, ws, up)
 6076: 
 6077:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6078:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6079:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6080: 
 6081:    // Total advection (average onto side)
 6082:    const Node *node1 = side->nodes[0];
 6083:    const Node *node2 = side->nodes[1];
 6084:    for (int k=kbs(i); k<nvrt; k++) {
 6085: 
 6086:       if constexpr(ics==1) {
 6087:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6088:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6089:       } else {
 6090:          // XXX IMPLEMENT THIS
 6091:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6092:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6093:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6094:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6095:       }  // if ics
 6096: 
 6097: 
 6098:    }
 6099: }
 6100: #endif
 6101: 
 6102: 
 6103: extern "C" {
 6104:    __global__ void computeElemAverageGhat(void) {
 6105:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6106: 
 6107:       ELEM(elem);
 6108:       
 6109:       elem->ghat1= {0.0, 0.0};  
 6110: 
 6111:       if constexpr(ihydraulics != 0) {
 6112:          if (nhtblocks > 0 && elem->isblock) return;
 6113:       }
 6114: 
 6115:       if (elem->isDry) return;
 6116: 
 6117:       // Wet elements.
 6118:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6119:       // tidal potential, horizontal diffusion, and baroclinic etc
 6120:       // Remember to update both fb and F 
 6121:       // If ics=2, ghat1 are in eframe (ll)
 6122:       // cff1-3: coefficients for 2D/3D
 6123:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6124:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6125:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6126: 
 6127:       double av_cff1 = 0.0;  // av. for cff1
 6128:       double av_cff2 = 0.0;  // av. for cff2
 6129:       double av_cff3 = 0.0;  // av. for cff3
 6130:       double av_df = 0.0;  // av. for H^\alpha / H
 6131:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6132:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6133: 
 6134:       const int i34 = elem->i34;
 6135:       const int kb = elem->kb;
 6136: 
 6137:       for (int j=1; j<i34; j++) {
 6138:          // For each node and side in the element...
 6139: 
 6140:          const Node *node = elem->nodes[j];
 6141:          const Side *side = elem->sides[j];
 6142: 
 6143:          const double chi      = side->chi;
 6144:          const double veg_c2   = side->veg_c2;
 6145:          const double veg_beta = side->veg_beta;
 6146:          const double veg_h    = side->veg_h();
 6147:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6148: 
 6149:          // Node - const in elem
 6150:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6151:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6152: 
 6153:          if (elem->depth >= tip_dp) {
 6154:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6155:          }
 6156: 
 6157:          
 6158:          const double htot  = side->htot2();        // Total depth at the side
 6159:          const double zctr2 = side->zTopCanopy();  
 6160: 
 6161:          double cff1; 
 6162:          double cff2; 
 6163:          double cff3;   
 6164:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6165:          // coefficients applied to 2D/3D case 
 6166:             cff1 = side->hhat/htot;
 6167:             cff2 = 0.0;
 6168:             cff3 = 0.0;
 6169:          } else { //3D
 6170:             //Init for no-veg case
 6171:             cff1 = 1.0;
 6172:             cff2 = 1.0;
 6173:             cff3 = 0.0;
 6174: 
 6175:             if constexpr(iveg != 0) {
 6176:                // Computes coefficients used with vegetation terms G1, G2
 6177:                // cff1, cff3 are used for the first two terms in G1, G2:
 6178:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6179:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6180:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6181:                if(veg_h < 0.99*htot) { // submergent vegetation
 6182:                   cff1=1;
 6183:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6184:                   cff3 = veg_c;
 6185: 
 6186:                } else { // emergent vegetation
 6187:                   cff1 = 1.0/(1.0 + veg_c2);
 6188:                   cff2 = cff1;
 6189:                   cff3 = 0.0;
 6190: 
 6191:                }
 6192:             } // if iveg
 6193:          } //  2D/3D
 6194: 
 6195:          av_cff1 += cff1/i34;
 6196:          av_cff2 += cff2/i34;
 6197:          av_cff3 += cff3/i34;
 6198:          av_cff2_chi += cff2*chi/i34;
 6199:          av_cff3_chi += cff3*chi/i34;
 6200:          av_df += min(htot, veg_h)/(htot*i34);
 6201: 
 6202: 
 6203:          // btrack values: U^\star, U^{\star\alpha}
 6204:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6205:          Vector2 Ustar       = {0.0, 0.0}; 
 6206:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6207: 
 6208:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6209:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6210:          } else { //3D
 6211:             for (int k = side->kb; k < nvrt; k++) {
 6212:             
 6213:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6214:                Ustar += w2;
 6215: 
 6216:                if constexpr(iveg != 0) {
 6217:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6218:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6219:                        Ustar_alpha += zrat*w2; // XXXX
 6220:                    }
 6221:                }  // if iveg
 6222:             }  // for k
 6223:          }  //2D/3D
 6224:          
 6225: 
 6226:          // Add btrack & surface stress terms to \breve{G} first
 6227:          if constexpr(ics==1) {
 6228:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6229:          } else {
 6230:             // XXX IMPLEMENT THIS
 6231:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6232:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6233:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6234:          }  // if ics
 6235: 
 6236:          // Surface and bottom stress terms
 6237:          if constexpr(ics==1) {
 6238:             const Vector2 tau    = side->tau();
 6239:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6240: 
 6241:             // Term for surface and bottom stress
 6242:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6243:          } else {
 6244:             // XXX IMPLEMENT THIS
 6245:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6246:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6247:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6248:             // tau_x=(vn1+tt1)/2.d0
 6249:             // tau_y=(vn2+ss1)/2.d0
 6250:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6251:          }  // if ics
 6252: 
 6253:          
 6254: 
 6255:          // All terms in F,F^\alpha,f_b except baroclinic
 6256:          // F, f_b: all explicit terms excluding vegetation 
 6257:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6258:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6259:          const double coriolis = side->coriolis;
 6260:          Vector2 F  =  coriolis*side->U;  // F_x
 6261:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6262:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6263: 
 6264:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6265:             
 6266:             for (int k = side->kb; k < nvrt; k++) {
 6267:                if (zctr2 > side->zc[k-1]) {
 6268:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6269:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6270:                    Fa +=  coriolis*w2*zrat;
 6271:                } // if zctr2
 6272:             } // k
 6273:          } // iveg
 6274: 
 6275:          // Integrate horizontal viscosity force vertically
 6276:          for (int k=side->kb + 1; k<nvrt; k++) {
 6277:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 6278: 
 6279:             F += levelHorVisc;
 6280: 
 6281:             // Vegetation term
 6282:             if constexpr(iveg!=0) {
 6283:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6284:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6285:                   Fa += levelHorVisc*zrat;
 6286:                } 
 6287:             } // if iveg
 6288:          } // for k
 6289: 
 6290:          fb += side->d2uv[side->kb];
 6291: 
 6292: 
 6293:          // Add to ghat1
 6294:          if constexpr(ics==2) {
 6295:             // XXX IMPLEMENT THIS
 6296:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6297:             // bigf1=vn1; bigf2=vn2
 6298:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6299:             // botf1=vn1; botf2=vn2
 6300:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6301:             // bigfa1=vn1; bigfa2=vn2
 6302:          } // if ics
 6303: 
 6304:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6305:       } // for j (nodes and sides)
 6306: 
 6307:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6308:          
 6309:       // Finish off terms in F, F^\alpha and f_b
 6310:       const double grav3 = elem->mean(&Node::grav2);
 6311:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6312: 
 6313: 
 6314:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6315:       for (int j=1; j<i34; j++) { 
 6316:          // For each side in the element...
 6317:          const Side *side = elem->sides[j];
 6318:          const double chi = side->chi;
 6319: 
 6320:          const double htot = side->htot2();
 6321:          const double veg_h = side->veg_h();
 6322:          const Vector2 F  = htot*fb;
 6323:          const Vector2 Fa = min(htot, veg_h)*fb;
 6324: 
 6325:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6326:       } // for j
 6327: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6328:       //botf1 etc are already in elem frame
 6329:       elem->ghat1 += tmp/i34;
 6330: 
 6331:       // Baroclinic force
 6332:       if constexpr(ibc==0) {
 6333:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6334: 
 6335:          Vector2 Fa = {0.0, 0.0};
 6336:          Vector2 intGradRho = {0.0, 0.0};
 6337:          
 6338:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6339:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6340:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6341: 
 6342:             // \in F [m^2/s/s]
 6343:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6344:          }
 6345: 
 6346:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6347:          const Vector2 F = av_df*Fa; //approx
 6348:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6349: 
 6350:       } // if ibc
 6351: 
 6352: 
 6353: 
 6354:    }
 6355: 
 6356: } // extern "C"
 6357: 
 6358: 
 6359: 
 6360: #ifdef DONTCOMPILE
 6361: __global__ void checkMassConservation(Tracers* sumtr) {
 6362: 
 6363:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6364: 
 6365:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6366: 
 6367:    Element *elem = &(mesh->localElemData[i]);
 6368: 
 6369:    // Skip dry elements
 6370:    if (elem->isDry) return;
 6371: 
 6372:    // Local sum array for this thread
 6373:    double localSum[N_TRACERS] = {0.0};
 6374: 
 6375:    // Sum over vertical levels for this element
 6376:    const int kbe = elem->kbe;
 6377:    const double area = elem->area;
 6378: 
 6379:    for (int k = kbe; k < nvrt; k++) {
 6380:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6381:       
 6382:       // Accumulate tracer mass
 6383:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6384:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6385:       }
 6386:    }
 6387: 
 6388:    
 6389: 
 6390:    //  This function returns per element sums. A reduction must be done on the host side.
 6391: }
 6392: 
 6393: 
 6394: __global__ void transport(void) {
 6395: 
 6396:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6397: 
 6398:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6399: 
 6400:    Element *elem = &(mesh->localElemData[ie]);
 6401: 
 6402:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6403: 
 6404:                for (int m=0; m<ntr; m++) {
 6405:                   for (int k=kbe(ie); k<nvrt; k++) {
 6406:                      // Calculate each polynomial's weight 
 6407:                      wm=0.d0; sum1=0.d0; 
 6408:                      wm1=0.d0; wm2=0.d0; 
 6409:                      for (int i=0; i<elem->nweno2; i++) {
 6410:                   
 6411:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6412:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6413:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6414:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6415:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6416:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6417:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6418:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6419:                      // -----------------Hu and Shu (1999)'s method----------------
 6420:                      b4=b1+b2+b3
 6421: 
 6422: //Error: add PRODUCTION CPP
 6423: #ifdef DEBUG
 6424:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6425:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6426:                     call parallel_abort(errmsg)
 6427:                   }
 6428: #endif
 6429: 
 6430:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6431:                   // !----test-------------- 
 6432:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6433:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6434:                   // !wm(i)=wm1(i)*wm2(i)
 6435:                   // !---------------------- 
 6436:                   sum1=sum1+wm(i)
 6437:                 } // end for i
 6438: 
 6439:                 wm=wm/sum1
 6440: 
 6441:                 for (int j=0; j<elem->i34; j++) {
 6442: 
 6443:                   const Side *side  = elem->sides[j];
 6444:                   const Node *node1 = side->n1;
 6445:                   const Node *node2 = side->n2;
 6446: 
 6447:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6448:                      trsd=0.d0
 6449:                      for (int kk=0; kk<nquad; kk++) {
 6450:                         for (int i=0; i<elem->nweno2; i++) {
 6451:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6452:                         } // end for i   
 6453:                      } // end for kk
 6454:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6455:                   } // outward flux
 6456:                } // end for j=1,i34(ie) ! side
 6457:             }
 6458:          }
 6459:               
 6460: 
 6461: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6462: //             //   calculate each polynomial's weight 
 6463: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6464: //                 wm=0.d0; sum1=0.d0
 6465: //                 do i=1,nweno1(ie) !for each polynomial
 6466: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6467: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6468: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6469: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6470: //                   wm(i)=b2
 6471: //                   sum1=sum1+b2
 6472: //                   !wm(i)=1.d0
 6473: //                   !sum1=sum1+1.d0
 6474: 
 6475: // // Error: PRODUCTION
 6476: // #ifdef DEBUG
 6477: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6478: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6479: //                     call parallel_abort(errmsg)
 6480: //                   endif
 6481: // #endif
 6482: 
 6483: //                 enddo !i
 6484: //                 wm=wm/sum1 !final weight
 6485: 
 6486:                 for (int j=0; j<elem->i34; j++) { // side
 6487:                   const Side *side = elem->sides[j];
 6488:                   const Node *node1 = side->n1;
 6489:                   const Node *node2 = side->n2;
 6490: 
 6491:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6492:                     trsd=0.d0
 6493:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6494:                       for (int i=0; i<elem->nweno1; i++) {
 6495:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6496:                       }
 6497:                     enddo //kk
 6498:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6499:                   } // outward flux
 6500:                 } // end for j=1,i34(ie) ! side
 6501:               } // end for k; ntr 
 6502: 
 6503:             else !simple upwind method
 6504:               do j=1,i34(ie)
 6505:                 jsj=elside(j,ie)
 6506:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6507:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6508:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6509:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6510:                   endif
 6511:                 enddo  !vertical layers
 6512:               enddo !j=1,i34(ie) ! side
 6513:             endif !order of accuracy
 6514: 
 6515:          //  enddo !ie
 6516: // !$OMP     end do
 6517: 
