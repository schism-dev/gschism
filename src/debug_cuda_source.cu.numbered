 1273:    __device__ void setFrame(void) {
 1274:       if constexpr(ics == 1) return;
 1275: 
 1276:       double lat, lon;
 1277:       const Point3 p = toPoint3(center, centerZ());
 1278: 
 1279:       // Compute the latitude and longitude of the element center
 1280:       computeLatLon(p, lat, lon);
 1281: 
 1282:       frame.update(lat, lon);        
 1283:    }
