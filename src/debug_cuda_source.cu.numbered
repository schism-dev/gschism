 7090:    __global__ void setVelocityOpenBndNodes(void) {
 7091:    // For open boundary nodes sets their velocity to the imposed values.
 7092: 
 7093:       SIDE_BND(sidebnd);
 7094: 
 7095:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7096:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7097:          // to its segment to the average of the side velocity.
 7098: 
 7099:          for (int k = 0; k < nvrt; k++) {
 7100:             Node *n1 = sidebnd->side->n1;
 7101:             Node *n2 = sidebnd->side->n2;
 7102: 
 7103: 
 7104:             Vector2 n1_u2(n1->u2[k]);
 7105:             Vector2 n2_u2(n2->u2[k]);
 7106: 
 7107:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7108:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7109:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7110:             }
 7111:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7112:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7113:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7114:             }
 7115: 
 7116:          }
 7117: 
 7118:       }
 7119: 
 7120:    }
