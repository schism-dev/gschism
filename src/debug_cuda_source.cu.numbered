 8208: __global__ void printMatrix(bool full) {
 8209:    // Debugging: print the matrix
 8210: 
 8211:    const int size = mesh->np;
 8212:    double sum = 0.0;
 8213:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8214:       const Node *node = mesh->localNodeData + idx_node;
 8215:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8216:       for (int j = 0; j < node->numNodes; j++) {
 8217:          Node* nbNode = node->nodes[j];
 8218:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8219:          sum += node->coeffMatrix[j];
 8220:       }
 8221:       if (full) printf("]\n");
 8222: 
 8223: 
 8224:    }
 8225:    if (!full) printf("sum=%lf\n", sum);
 8226: }
