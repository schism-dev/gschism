 2571: //       const double y3 = nodes[i]->y;
 2572: //       const double x4 = nodes[nxq(i+1)]->x;
 2573: //       const double y4 = nodes[nxq(i+1)]->y;
 2574: 
 2575: //       const Side& side = sides[i];
 2576: 
 2577: //       xIntersect=-1.e25;
 2578: //       yIntersect=-1.e25;
 2579: 
 2580: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2581: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2582: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2583: 
 2584: //       if (delta != 0.0) {
 2585: //          // Solves the two linear equations for tt1 and tt2
 2586: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2587: //          const double tt2 = delta2/delta;
 2588: 
 2589: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2590: //          // Similarly, we use tt2 to compute the intersection point.
 2591: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2592: //             xIntersect = x3 + (x4 - x3)*tt2;
 2593: //             yIntersect = y3 + (y4 - y3)*tt2;
 2594: 
 2595: //             intersectingSide = side;
 2596: //             nextElement = nghbElems[i];
 2597: 
 2598: //             return true;
 2599: //          }
 2600:       
 2601: //       }
 2602: //       else {
 2603: //          // The two segments are parallel
 2604: //          return false;
 2605: //       }
 2606: 
 2607: //    }
 2608: 
