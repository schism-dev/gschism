 1894: /**
 1895:  * Find the element that contains the target point.
 1896:  * 
 1897:  * @param x0,y0,z0     Starting position coordinates
 1898:  * @param xt,yt,zt     Target position coordinates
 1899:  * @param dtb          Time step for tracking
 1900:  * @param u_int        Initial velocity components
 1901:  * @param nextElem     Starting/resulting element index
 1902:  * 
 1903:  * @return Status code of type trackExitCodes
 1904:  * 
 1905:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1906:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1907:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1908:  * as close the the segment AB as possible, the next point at each iteration is computed
 1909:  * along segment AB, but just after the current element.
 1910:  */
 1911: int stackSize = 0;
 1912: 
 1913: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1914: 
 1915:    constexpr int MAX_ITERATIONS = 10;
 1916: 
 1917:    int iter = 0;
 1918:    while (iter < MAX_ITERATIONS) {
 1919:       iter++;
 1920: if (iter > 20) printf("XXX iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 1921:       Bool4 isLeft, isObtuse, isBisector;
 1922:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), origSide, isLeft, isObtuse, isBisector);
 1923: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 1924:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 1925: 
 1926:       if (isValid.none()) 
 1927:       // Inside the element if none of the edges is a valid continuation
 1928:       {
 1929:          // Just returns true and the element (curElem) is unchanged).
 1930:          return true;
 1931:       }
 1932:       else { // Outside the element
 1933: 
 1934:          // Outside this element. Pick the first valid exit side and cross.
 1935:          lastCrossSide = curElem->sides[isValid.firstOne()];
 1936:          Element *prevElem = curElem;
 1937:          curElem = lastCrossSide->otherElem(curElem);
 1938: // const Point3 p1 = origSide->toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz));
 1939: // const Point3 p2 = origSide->toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz));
 1940: // showPoints(p1, p2, jlev, origSide, 0x0000FFu, 'o', 1, 0, 0);         
 1941: 
 1942:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 1943:          // along the boundary.
 1944:          if (curElem == nullptr || curElem->isDry) {
 1945:          
 1946:             curElem = prevElem;
 1947:             return false;
 1948:          }
 1949:          
 1950:       }
 1951: 
 1952:    }
 1953: 
 1954:    assert(false && "Leaded Celestial Walk algorithm did not find the target point in the allowed number of iterations");
 1955: }
