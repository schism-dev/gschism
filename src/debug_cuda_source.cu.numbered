  986: struct Side {
  987: 
  988:    // Geometry information
  989:    int idx;               // Index of the side
  990:    Node *n1, *n2;
  991:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  992: 
  993:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  994:    Vector2 center;        // Location of side center. 
  995:    double zc[nvrt];       // Side center z-coord at each vertical level
  996: 
  997: #ifdef USE_FRAMES
  998:    Frame frame;
  999: #endif
 1000: 
 1001:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1002:                           // this is nullptr
 1003:    
 1004:    int kb;                // Bottom index of the side
 1005:    bool isDry;            // True if the side is dry
 1006:  
 1007:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1008: 
 1009:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1010: 
 1011:    // Physical information
 1012:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1013:    Vector2 btu[nvrt];           // Back-tracked velocity
 1014:    Vector2 U;                   // Vertically averaged velocity vector  
 1015: 
 1016:    Vector2 nuGradU[nvrt];          // nu*grad u
 1017: 
 1018:    Vector2 bcc[nvrt];           // Baroclinic term
 1019:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1020: 
 1021:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1022:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1023:    Vector2 gradPr;               // Gradient of pressure
 1024:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1025: 
 1026: 
 1027:    double hhat;                 // \breve{H} in notes
 1028: 
 1029:    double shapiro;
 1030: 
 1031:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1032: 
 1033:    double coriolis;             // Coriolis parameter
 1034: 
 1035:    // Vegetation parameters
 1036:    double veg_c2;
 1037:    double veg_beta;
 1038: 
 1039:    // Bottom drag parameters.
 1040:    double chi;
 1041:    double chi2;
 1042: 
 1043:    __inline__ __device__ double x(double t) const;
 1044:    __inline__ __device__ double y(double t) const;
 1045:    __inline__ __device__ double lon(void) const;
 1046:    __inline__ __device__ double lat(void) const;
 1047:    __inline__ __device__ Point2 p_t(double t) const;
 1048: 
 1049:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1050:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1051:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1052: 
 1053:    __inline__ __device__ Side* neigh(int index) const { 
 1054:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1055:       assert(index >= 0 && index < 4); 
 1056:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1057: 
 1058:       const int ielem = index & 1;           // 0 or 1
 1059:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1060: 
 1061:       const Element* elem = elems[ielem];
 1062: 
 1063:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1064: 
 1065:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1066: 
 1067:    }
 1068: 
 1069:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1070: 
 1071:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1072: 
 1073:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1074:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1075:    __inline__ __device__ int iadv(void) const;
 1076: 
 1077:    __inline__ __device__ double grav3(void) const;
 1078:    
 1079:    __inline__ __device__ double eta2(void) const;
 1080:    __inline__ __device__ double eta1(void) const;
 1081:    __inline__ __device__ double w2(int k) const;
 1082:    __inline__ __device__ double depth(void) const;
 1083:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1084:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1085: 
 1086:    __inline__ __device__ double dfv(int k) const;
 1087: 
 1088:    __inline__ __device__ double veg_h(void)  const;
 1089:    __inline__ __device__ double veg_nv(void) const;
 1090:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1091:    __inline__ __device__ double veg_alpha3D(int k) const;
 1092:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1093: 
 1094:    __inline__ __device__ double Cd(void) const;
 1095: 
 1096:    __inline__ __device__ Vector2 tau(void) const;
 1097: 
 1098:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1099:    
 1100: 
 1101:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1102:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1103:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1104:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1105:    } 
 1106:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1107:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1108:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1109:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1110: 
 1111:    // Get valid starting element (for backtracking)
 1112:    __inline__ __device__ Element* getStartElement() {
 1113:       return elems[0] ? elems[0] : elems[1];
 1114:    }
 1115: 
 1116:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1117:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1118:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1119: 
 1120:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1121: 
 1122:       // Dot product of the negative velocity vector with the side normal vector
 1123:       const double dot_prod1 = -dot(u, n);
 1124: 
 1125:       // Vector from side center to element 0 centroid
 1126:       const Vector2 v2 = elems[0]->center - center;
 1127: 
 1128:       // Dot product of the vector with the side normal vector
 1129:       const double dot_prod2 = dot(v2, n);
 1130: 
 1131:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1132:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1133: 
 1134:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1135:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1136: 
 1137:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1138: 
 1139:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1140:       else                           return !isDry1 ? elems[1] : elems[0];
 1141: 
 1142:  
 1143:    }
 1144: 
 1145:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1146:       // Given an element, returns the other element that shares this side
 1147:       return (elems[0] == elem) ? elems[1] : elems[0];
 1148:    }
 1149: 
 1150:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1151:       // Given a node, returns the other node that shares this side
 1152:       return (n1 == node) ? n2 : n1;
 1153:    }
 1154:  
 1155:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1156: 
 1157: 
 1158: 
 1159: 
 1160: };
 1161: 
