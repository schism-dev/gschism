 1062: struct BoundarySegment {
 1063: 
 1064:    bool isLand;
 1065: 
 1066:    double clen;  // Length of the boundary segment
 1067:    double carea; // Area of the boundary segment
 1068: 
 1069:    int ifltype;  // Type of flow boundary condition
 1070:    
 1071:    // Elevation boundary condition
 1072:    int iettype;  // Type of elevation boundary condition
 1073:    double eth;   // Elevation time history
 1074: 
 1075:    // Flow boundary condition
 1076:    double qthcon;  // Flow time history constant
 1077:    double vobc1;   // Velocity coefficient 1
 1078:    double vobc2;   // Velocity coefficient 2
 1079: 
 1080:    // Tracer boundary conditions
 1081:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1082:    // int  itrtype[natrm];    // Tracer boundary condition type
 1083: 
 1084:    BoundarySegment(bool _isLand) {
 1085:       isLand = _isLand;
 1086:       clen = 0.0;
 1087:       carea = 0.0;
 1088:       ifltype = 0;
 1089:       iettype = 0;
 1090:       eth = 0.0;
 1091:    }
 1092: 
 1093:    BoundarySegment(void) {
 1094:       isLand = false;
 1095:       clen = 0.0; 
 1096:       carea = 0.0;
 1097:       ifltype = 0;
 1098:       iettype = 0;
 1099:       eth = 0.0;
 1100:    }
 1101: 
 1102:    
 1103: };
