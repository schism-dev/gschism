 7082:    __global__ void resetVelocityOpenBndNodes(void) {
 7083:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7084: 
 7085:       NODE_BND(nodebnd);
 7086: printf("DDDDDDDDDD\n");
 7087:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7088:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7089:       }
 7090: 
 7091:    }
