 4548:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4549: 
 4550:       SIDE(side);
 4551: 
 4552: 
 4553:       side->U = {0.0, 0.0}; 
 4554:          
 4555:       if(side->isDry) return;
 4556: 
 4557:       const Node *node1 = side->n1;
 4558:       const Node *node2 = side->n2;
 4559: 
 4560:       // Vertically integrated velocity U (in ll if ics=2)
 4561:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4562:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4563:       }
 4564: 
 4565:    }
 4566: 
 4567:    __global__ void computeBottomDragVegetation(void) {
 4568:       // UNFINISHED. CHECK THIS:
 4569:       // How many kernels are needed? Why so many for loops?
 4570:       // Is the loop on sides needed?
 4571: 
 4572:       NODE(node);
 4573: 
 4574: 
 4575:       const int    kb      = node->kb;
 4576:       const double htot    = node->htot2(); 
 4577:       const double rough   = node->rough;
 4578: 
 4579:       
 4580:       if (node->isDry) {
 4581:          // Default values for dry nodes
 4582:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4583:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4584: 
 4585:          return;
 4586:        
 4587:       }
 4588: 
 4589:       // Compute bottom drag Cd
 4590:       //--------------------------------
 4591: 
 4592:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4593:       if constexpr(nchi == 1) {
 4594: 
 4595:          bool ltmp = false; // for WBL iteration
 4596: 
 4597:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4598:          // Drag at nodes
 4599:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4600:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4601:         
 4602:          const double rough = node->rough;
 4603:         
 4604:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4605:          if (node->rough == 0.0) {
 4606:             node->Cd = 0.0;
 4607: 
 4608:          } else { //roughness >0 
 4609:           
 4610:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4611:             const double bthick = max(dzb_min, bthick_ori);
 4612: 
 4613:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4614: 
 4615:             double tmp = 1.0/(2.5*log(bthick/rough));
 4616:             node->Cd = tmp*tmp;
 4617: 
 4618:          } // if rough
 4619: 
 4620: 
 4621:          // RECOVER THIS: XXX
 4622:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4623:          // Output warning for WBL if iteration didn't converge
 4624: 
 4625: 
 4626:       } // nchi==1
 4627: 
 4628: 
 4629:       //   Bottom stress in m^2/s^2
 4630:       if (node->rho[kb + 1] >= -98.0)
 4631:       {
 4632:          const double mag_u = length(node->u2[kb + 1]);
 4633:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4634: 
 4635:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4636:          // !sediment erosion: this part needs more documentation
 4637:       }
 4638:     
 4639: 
 4640: 
 4641:       // Compute vegetation parameters
 4642:       //--------------------------------
 4643: 
 4644:       // SAV constants
 4645:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4646:       constexpr double veg_cfpsi = 0.16;
 4647: 
 4648:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4649:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4650: 
 4651:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4652:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4653:          int kbin = 0; // bin index
 4654:          for (int k = kb; k < nvrt; k++) {
 4655:             // Computes node height above the bottom level
 4656:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4657:             assert(false && "Vertical variation of vegetation not implemented");
 4658: 
 4659:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4660:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4661:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4662:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4663:             // } else {
 4664:             //    // Find the bin at which the current vertical level is
 4665:             //    while (kbin<nbins_veg_vert) {
 4666:             //       const double zn = node->z[kbin];
 4667:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4668:             //          break;
 4669:             //       } // if
 4670:             //       kbin++;
 4671:             //    } // while
 4672:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4673: 
 4674:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4675:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4676:                
 4677:             //    // Linear interpolation of the vegetation parameters
 4678:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4679:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4680:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4681:             // } // if rl10
 4682: 
 4683:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4684: 
 4685:          } // for k
 4686: 
 4687: 
 4688:       } else { // Ganthy (iveg==2)
 4689:       //  Modify canopy height, diameter, and density
 4690: 
 4691:          // Make sure there is vegetation on this node
 4692:          if (node->veg_h_unbent > 0.0) {
 4693:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4694: 
 4695:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4696:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4697:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4698: 
 4699:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4700:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4701:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4702:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4703:          } // if veg_h_unbent
 4704: 
 4705:          for (int k = 0; k < nvrt; k++) {
 4706:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4707:          } // for k
 4708:       
 4709: 
 4710:       } // if iveg
 4711:      
 4712: 
 4713:       // Compute vertical mean of veg_alpha3D
 4714:       if (iveg != 0) {
 4715:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4716:          double sum1=0.0;
 4717:          double sum2=0.0;
 4718:          // Integrate over each level under the canopy...
 4719:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4720:             const double Dz = node->Dz(k);
 4721: 
 4722:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4723:             sum2 += Dz;
 4724: 
 4725:          } // for k
 4726:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4727:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4728: 
 4729:       } // if iveg
 4730: 
 4731:    }
 4732: 
 4733:    __global__ void computeVegetationAndDragParameters(void) {
 4734:       // Computes the vegetation and drag model parameters:
 4735:       // chi, \tilde\chi, beta, \breve{H}
 4736:       
 4737:       SIDE(side);
 4738: 
 4739:       if (side->isDry) return;
 4740: 
 4741:       const double htot = side->htot2();
 4742:       const int    kb   = side->kb;
 4743: 
 4744:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4745: 
 4746:       const double veg_h     = side->veg_h();
 4747:       const double veg_nv    = side->veg_nv();
 4748:       const double veg_c     = side->veg_c();
 4749:       const double veg_beta  = side->veg_beta;
 4750:       const double veg_alpha = side->veg_alpha_vert_mean();
 4751: 
 4752:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4753:       // Velocity magnitude at the bottom level
 4754:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4755:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4756:       side->chi2 = side->Cd()*vmag1;
 4757:       side->chi  = side->chi2;
 4758:       if constexpr(iveg != 0) {
 4759:          const Node *n1 = side->n1;
 4760:          const Node *n2 = side->n2;
 4761:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4762:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4763:       }
 4764: 
 4765:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4766: 
 4767:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4768:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4769:       double magUa = 0.0;
 4770:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4771:          // 3D wet side with veg...
 4772: 
 4773:          double magUa = 0.0;
 4774:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4775:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4776: 
 4777:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4778:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4779:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4780: 
 4781:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4782:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4783: 
 4784:                // Velocity magnitude at the bottom (l) of the level
 4785:                const double ul = length(side->u2[k]);
 4786: 
 4787:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4788:                magUa += Dz*0.5*(uh + ul);
 4789: 
 4790:             } // if HasVegetation
 4791:          } // for k
 4792:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4793: 
 4794:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4795:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4796:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4797:             const double zCpy = side->zTopCanopy();
 4798:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4799:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4800:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4801:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4802:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4803:          } // if isSubmerged
 4804:       } // if iveg   
 4805: 
 4806:       // Computes the friction modified depth, \breve{H} in notes
 4807:       if (side->is2D()) { // 2D
 4808: 
 4809:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4810:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4811: 
 4812:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4813: 
 4814:          side->hhat = htot*htot/fricH; 
 4815: 
 4816:       } else { // 3D
 4817:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4818: 
 4819:          if constexpr(iveg != 0) {
 4820:             
 4821:             if (side->isSubmerged()) { 
 4822:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4823:                side->hhat -= veg_c*Hhat_alpha;
 4824: 
 4825:             } else { // Emergent
 4826:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4827:             }
 4828:          } // if iveg
 4829: 
 4830:          // Enforce positivity for 3D model
 4831:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4832:       } // if 3D
 4833: 
 4834:    }
 4835: 
 4836: 
 4837: 
 4838:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4839:    // Computes the density gradient between two elements, e1 and e2.
 4840:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4841:    // zero in the direction normal to the side. 
 4842:    // 
 4843:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4844:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4845:    //
 4846:    // Input:
 4847:    //    e1: Element
 4848:    //    e2: Neighbor element (or nullptr if boundary)
 4849:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4850:    //    k: Index of the half-level at which the density is interpolated
 4851:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4852:    // 
 4853:    // Output:
 4854:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4855:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4856: 
 4857:       if (e2 == nullptr || e2->isDry) {
 4858:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4859: 
 4860:          Side *side = e1->sides[j];
 4861:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4862:                  
 4863:          if constexpr(ics == 1) {
 4864:             vec = side->n; // Normal vector to the side
 4865:          } else {
 4866:             // IMPLEMENT THIS XXXXXX
 4867:             // !replace with xel, yel?
 4868:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4869:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4870:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4871:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4872:          } //ics
 4873:                    
 4874:          diffRho = 0.0;
 4875: 
 4876:       } else { //internal and wet
 4877:          if constexpr(ics==1) {
 4878:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4879: 
 4880:             // Vector from e1 to e2
 4881:             vec = e2->center - e1->center;
 4882: 
 4883:          } else { 
 4884:             // IMPLEMENT THIS XXXXXX
 4885:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4886:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4887:             //                   alow(j)=xctr2
 4888:             //                   bdia(j)=yctr2
 4889:          } // ics
 4890: 
 4891:          diffRho = rho2 - e1->demeanedDensity(k);
 4892:       }
 4893: 
 4894:    }
 4895: 
 4896:    __global__ void computeDensityCubicSplines(void) {
 4897:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4898: 
 4899:       ELEM(elem);
 4900: 
 4901:       if (elem->isDry) return;
 4902: 
 4903:       const int kb = elem->kb;
 4904: 
 4905:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4906:       if (elem->is2D()) {
 4907:          // In the 2D case, the density is constant at the prism level. 
 4908:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4909:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4910:       } else { //3D
 4911: 
 4912:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4913:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4914:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4915:          ///// XXXX CHECK INDICES!!!!!
 4916:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4917:       } // 2D/3D
 4918: 
 4919:    }
 4920: } // extern "C"
 4921: 
 4922: 
 4923: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4924: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4925: 
 4926:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4927: 
 4928:    const int kb  = elem->kb;
 4929:    const int kb2 = elem2->kb;
 4930: 
 4931:    // z-coordinate of prism of elem
 4932:    const double zp = elem->z_prism(k);
 4933: 
 4934:    double rho = 0.0;
 4935: 
 4936:    if (elem2->is2D()) {
 4937:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4938: 
 4939:    } else {  // 3D
 4940: 
 4941:       // eta_min may be < zmax
 4942:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4943:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4944: 
 4945:       // (Extrapolate density below bottom, we will fix it later)
 4946:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4947:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4948:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4949:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4950:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4951:    } // 2D/3D
 4952:      
 4953: 
 4954:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4955:    // Now we need to fix it.
 4956:    if (elem->z[k] < elem2->z[kb2]) {
 4957:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4958: 
 4959:       // There are two methods to adjust the density at the bottom of the element.
 4960:       // iunder_deep=0: 
 4961:       const double depth1 = abs(elem->z[kb]); // larger depth
 4962: 
 4963:       if (iunder_deep==0) {
 4964: 
 4965:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4966: 
 4967:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4968: 
 4969:       } else { // iunder_deep != 0
 4970: 
 4971:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4972: 
 4973:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4974: 
 4975:          //   Demeaned density at the same z coordinate as
 4976:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4977:          }
 4978: 
 4979:       } // if iunder_deep
 4980:    } // if elem->z[kb] < elem2->z[kb]
 4981: 
 4982:    return rho;
 4983: }
 4984: 
 4985: 
 4986: extern "C" {
 4987:    __global__ void computeDensityGradient(void) {
 4988: 
 4989:       if constexpr(ibc != 0) return;
 4990: 
 4991:          // Compute the horizontal density gradient at each element.
 4992:       // It works in two steps:
 4993:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4994:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4995:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4996:       //             gradRho.r1 = rho1 - rho0
 4997:       //             gradRho.r2 = rho2 - rho0
 4998:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4999:       // 
 5000:       //  NOTE: We use de-meaned densities.
 5001: 
 5002:       ELEM(elem);
 5003: 
 5004:       if (elem->isDry) return;
 5005: 
 5006:       const int kb  = elem->kb;
 5007:       const int i34 = elem->i34;
 5008: 
 5009:       for (int k = kb + 1; k < nvrt; k++) {
 5010:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5011:          //             gradRho.r1 = rho1 - rho0
 5012:          //             gradRho.r2 = rho2 - rho0
 5013:          int icount = 0;
 5014:          double sumRx = 0.0;
 5015:          double sumRy = 0.0;
 5016:          for (int j1=0; j1<i34; j1++) { 
 5017: 
 5018:             const int j2 = elem->nxq(j1 + 1);
 5019: 
 5020:             // Pairs of consecutive neighbor elements of elem
 5021:             const Element *e1 = elem->nghbElems[j1];
 5022:             const Element *e2 = elem->nghbElems[j2];
 5023: 
 5024:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5025:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5026:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5027: 
 5028:             // Compute the density difference and the vector from elem to e1 and e2
 5029:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5030:             double diffRho1, diffRho2;
 5031:             Vector2 vec1, vec2;
 5032:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5033:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5034: 
 5035:             const double rl1 = length(vec1);
 5036:             const double rl2 = length(vec2);
 5037:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5038: 
 5039:             const double delta = cross(vec1, vec2);
 5040:             const double sintheta = abs(delta)/(rl1*rl2);
 5041: 
 5042:             // To avoid problems, avoid elements with small angle between vectors
 5043:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5044:             const bool validEq = (sintheta > sin_one_deg);
 5045: 
 5046:             if (validEq) {
 5047:                // Solve the system of equations to get the density gradient at elem
 5048:                icount++;
 5049:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5050:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5051:                sumRx += Rx;
 5052:                sumRy += Ry;
 5053:             }
 5054:          } // for j1
 5055: 
 5056:          // Compute the average density gradient at elem
 5057:          if (icount==0) {
 5058:            // Bad mesh quality; bail out with 0 b-cc
 5059:            elem->gradRho[k] = {0.0, 0.0};
 5060:          } else {
 5061:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5062:          }
 5063: 
 5064:       } // for k
 5065: 
 5066:    }
 5067: 
 5068:    __global__ void computeBaroclinicTerm(void) {
 5069:    // Computes the baroclinic term at sides (at half levels).
 5070:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5071:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5072: 
 5073:       if (ibc == 1) return;
 5074: 
 5075:       SIDE(side);
 5076: 
 5077:       if (side->isDry) return;
 5078: 
 5079:       const Element *e1 = side->elems[0];
 5080:       const Element *e2 = side->elems[1];      
 5081:       const int kb = side->kb;
 5082:       
 5083:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5084: 
 5085:       // interpolates vertically the density gradient of the two elements at the half level/
 5086: 
 5087:       int k1 = max(kb, nvrt / 2);
 5088:       int k2 = max(kb, nvrt / 2);
 5089: 
 5090:       // Starts the integration at the surface and goes down to the bottom
 5091:       side->bcc[nvrt-1] = {0.0, 0.0};
 5092:       for (int k = nvrt - 2; k >= kb; k--) {
 5093:       // For each prism level (from surface to bottom)...
 5094: 
 5095:          // For both elements, interpolate density gradient at the side's half level.
 5096:          // The gradient at the side is the average of the gradients at the elements.
 5097:          // w1, w2 are used to take into account boundary sides, with just one element.
 5098:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5099:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5100:          const double wsum = w1 + w2;
 5101:          w1 = w1/wsum;
 5102:          w2 = w2/wsum;
 5103:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5104: 
 5105:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5106:          Vector2 gradRho = {0.0, 0.0};
 5107:          if (e1 != nullptr && k > kb) {
 5108:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5109:             
 5110:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5111:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5112:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5113: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5114:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5115:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5116:          }      
 5117:          if (e2 != nullptr && k > kb) {
 5118:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5119:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5120:             
 5121:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5122:          }
 5123: 
 5124:          if constexpr(ics==2) {
 5125:             assert(false && "Not implemented: ics == 2");
 5126:             // IMPLEMENT THIS XXXXXX
 5127:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5128:             // swild(1)=tmp1
 5129:             // swild(2)=tmp2
 5130:          }
 5131:          
 5132:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5133:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5134:          // CHECK INDICES!!! XXX
 5135:          const double grav3 = side->grav3();
 5136:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5137: 
 5138:       } // for
 5139: 
 5140:    }
 5141: 
 5142: 
 5143: 
 5144:    __global__ void computeHorGradientAtSide(void) {
 5145: 
 5146:       // Compute the horizontal density gradient at each element.
 5147:       // It works in two steps:
 5148:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5149:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5150:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5151:       //             gradRho.r1 = rho1 - rho0
 5152:       //             gradRho.r2 = rho2 - rho0
 5153:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5154:       // 
 5155:       //  NOTE: We use de-meaned densities.
 5156: 
 5157:       SIDE(side);
 5158: 
 5159: // printf("side->isDry: %d\n", side->isDry);
 5160:       if (side->isDry) return;
 5161: 
 5162:       // Computes the gradient of the variables at the side center.
 5163:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5164:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5165:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5166: 
 5167:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5168:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5169:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5170:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5171: 
 5172: 
 5173:    }
 5174: 
 5175: 
 5176:    __global__ void solveMomentumEquations(double time) {
 5177: 
 5178:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5179:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5180: 
 5181:       SIDE(side);
 5182: 
 5183:       if (side->isDry) 
 5184:       {
 5185:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5186: 
 5187:          return;
 5188:       }
 5189: 
 5190:       const Node *n1 = side->n1;
 5191:       const Node *n2 = side->n2;
 5192: 
 5193:       const int kb = side->kb;
 5194: 
 5195:       const double veg_h = side->veg_h();
 5196:       const double grav3 = side->grav3();
 5197: 
 5198:       if (side->is2D()) {
 5199:          // Warning: Do not use htot2, which is updated.
 5200:          const double htot = side->htot1();
 5201:          const double hhat = side->hhat;
 5202: 
 5203:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5204: 
 5205:          Vector2 tau2 = {0.0, 0.0};
 5206:           
 5207:          if constexpr(ics==1) {
 5208:             tau2 = side->tau();
 5209: 
 5210:          } else {
 5211:             assert(false && "Not implemented: ics == 2");
 5212:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5213:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5214:             // taux2=(vn1+tt1)*0.5d0
 5215:             // tauy2=(vn2+ss1)*0.5d0
 5216:          } // if ics         
 5217: 
 5218:          // hat_gam has units of m/s
 5219: 
 5220:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5221: 
 5222:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5223:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5224: 
 5225:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5226: 
 5227: 
 5228:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5229:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5230: 
 5231:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5232: 
 5233: 
 5234:       }
 5235:       else { // 3D
 5236: 
 5237:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5238:          // 
 5239:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5240:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5241:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5242:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5243:          // k+1 and k.
 5244: 
 5245: 
 5246:    
 5247: 
 5248: 
 5249:          const int ndim = nvrt - kb;
 5250:          const double zTopCanopy = side->zTopCanopy();
 5251: 
 5252:          // Initialize the tridiagonal system
 5253:          for (int k = kb + 1; k < nvrt; k++) {
 5254:             
 5255:             const int kin = k - (kb + 1);
 5256: 
 5257:             // Vertical viscosity at the face center
 5258:             const double dfz = 1e-2; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5259:            
 5260: 
 5261:             alow[kin] = 0.0;
 5262:             cupp[kin] = 0.0;
 5263:             bdia[kin] = 0.0;
 5264: 
 5265:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5266:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5267: 
 5268:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5269:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5270:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5271: 
 5272:             // First part: layers k, k+1
 5273:             if (k < nvrt - 1) {
 5274:                              
 5275:                if constexpr(iveg != 0) {
 5276: 
 5277:                   // If there is vegetation at this level...
 5278:                   if (zTopCanopy > side->zc[k]) {
 5279:                      // If the canopy is above the k layer...
 5280:                      
 5281:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5282:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5283:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5284:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5285: 
 5286:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5287:                      const double vmag2 = length(ut2);
 5288:                      const double vmag1 = length(side->u2[k]);
 5289:                      const double vmag = 0.5*(vmag1 + vmag2);
 5290:                      
 5291:                      // Computes the vegetation alpha at the face center
 5292:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5293: 
 5294:                      cff1 += veg_alpha_sd*dt*vmag;
 5295: 
 5296:                   } // if (zTopCanopy
 5297:                } // if iveg
 5298: 
 5299:                const double dzz = side->Dz(k + 1);
 5300:                const double tmp = dt*dfz/dzz;
 5301:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5302: 
 5303:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5304:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5305:             }
 5306: 
 5307: 
 5308:             // Second part: layers k-1, k
 5309:             if (k > kb + 1) {
 5310: 
 5311:                double cff1 = 1.0; //init \bar{c^k}
 5312: 
 5313:                if constexpr(iveg != 0) {
 5314:                   // If there is vegetation at this level...
 5315:                   if (zTopCanopy > side->zc[k-1]) {
 5316:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5317:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5318: 
 5319:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5320: 
 5321:                      const double vmag2 = length(ut2);
 5322:                      const double vmag1 = length(side->u2[k-1]);
 5323:                      const double vmag = 0.5*(vmag1 + vmag2);
 5324: 
 5325:                      // Computes the vegetation alpha at the face center
 5326:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5327:                      cff1 += veg_alpha_sd*dt*vmag;
 5328:                   } // if zTopCanopy
 5329: 
 5330:                } // if iveg
 5331: 
 5332:                const double dzz = side->Dz(k);
 5333:                const double tmp = dt*dfz/dzz;
 5334:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5335: 
 5336:                alow[kin] += cff1*dzz/6.0 - tmp;
 5337:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5338: 
 5339:             } else { // Bottom boundary
 5340:                // This occurs at the bottom, where the bottom drag is applied.
 5341: 
 5342:                bdia[kin] += dt*side->chi2; // XXXX
 5343: 
 5344: 
 5345:             } // if (k > kb + 1)
 5346: 
 5347: 
 5348: 
 5349:          } // for (int k
 5350: 
 5351: 
 5352: 
 5353:          // Computes the RHS.
 5354:          // -----------------
 5355: 
 5356:          //	BC to be imposed at the end.
 5357: 
 5358:          const Vector2 gradETP  = side->gradETP;
 5359:          const Vector2 gradPr   = side->gradPr;
 5360:          const Vector2 gradEta1 = side->gradEta1;
 5361:          const Vector2 gradEta2 = side->gradEta2;
 5362: 
 5363:          const Vector2 *btu = side->btu;
 5364:          const Vector2 *u2  = side->u2;
 5365:          const double coriolis = side->coriolis;
 5366:          const Vector2 *nuGradU = side->nuGradU;
 5367: 
 5368: 
 5369:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5370: 
 5371:          for (int k = kb + 1; k < nvrt; k++) {
 5372:             const int kin = k - kb - 1;
 5373: 
 5374:             const double dz_0 = side->Dz(k);
 5375:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5376: 
 5377:             rrhs[kin] = {0.0, 0.0};
 5378:             double dz = 0.0;
 5379: 
 5380:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5381:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5382:             if (k < nvrt  ) dz += dz_1;
 5383:             if (k > kb + 1) dz += dz_0;
 5384: 
 5385:             // Elevation gradient, atmospheric pressure and tidal potential
 5386:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5387: 
 5388:             // Coriolis, advection, wind stress, and horizontal viscosity
 5389:             if (k < nvrt - 1) {
 5390: 
 5391: 
 5392:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5393:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5394:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5395:                                                 
 5396: 
 5397:                //diff stress tensors 1006
 5398:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5399:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5400:                   assert(false && "Not implemented: itur == 5");
 5401:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5402:                }
 5403: 
 5404:             } else { // k == nvrt - 1 SURFACE
 5405:                Vector2 tau2 = {0.0, 0.0};
 5406:                if constexpr(ics==1) {
 5407:                   tau2 = side->tau();
 5408:       
 5409:                } else {
 5410:                   assert(false && "Not implemented: ics == 2");
 5411:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5412:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5413:                   // taux2=(vn1+tt1)*0.5d0
 5414:                   // tauy2=(vn2+ss1)*0.5d0
 5415:                } // if ics
 5416: 
 5417:                rrhs[kin] += dt*tau2;
 5418: 
 5419:             } // if k<nvrt
 5420: 
 5421:             if (k > kb + 1) {
 5422:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5423:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5424:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5425: 
 5426:                // diff stress tensors 1006
 5427:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5428:                   assert(false && "Not implemented: itur == 5");
 5429:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5430:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5431:                }
 5432: 
 5433:             } // if k>kbs + 1
 5434: 
 5435:             // Baroclinic
 5436:             Vector2 *bcc = side->bcc;
 5437:             if constexpr(ibc == 0) {
 5438:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5439:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5440: 
 5441:             } // if ibc==0
 5442: 
 5443:          } // k=kb + 1,nvrt
 5444: 
 5445: 
 5446:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5447: 
 5448:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5449:             const int kin = k - kb - 1;
 5450: 
 5451:             // Velocity is always clamped to maximum values
 5452:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5453:          } // k
 5454: 
 5455:       } // if side->is2D()
 5456:       
 5457: 
 5458:       // Impose velocity boundary condition at the bottom
 5459:       if constexpr(imm == 2) { // 3D bed deformation model
 5460:          double dep;
 5461:          Vector2 vel;
 5462: 
 5463:          assert(false && "Not implemented: imm == 2");
 5464:          //update_bdef(time, x0, y0, dep, vel);
 5465:          // side->u2[kb] = vel;
 5466: 
 5467:       } else { // imm = 0 or 1
 5468:          if (side->Cd() == 0.0) {
 5469:             side->u2[kb] = side->u2[kb + 1];
 5470: 
 5471:          } else if (side->is3D()) { // 3D no slip bottom   
 5472:             side->u2[kb] = {0.0, 0.0};
 5473:          }
 5474:           
 5475:       } // if imm
 5476: 
 5477:       // The velocities below the bottom level are set to zero
 5478:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5479: 
 5480: 
 5481:    }
 5482: 
 5483: 
 5484:    __global__ void applyMomentumBC(void) {
 5485: 
 5486:       SIDE_BND(sideBnd);
 5487: 
 5488:       Side *side = sideBnd->side;
 5489:       const BoundarySegment *segment = sideBnd->segment;
 5490:       const Node *n1 = side->n1;
 5491:       const Node *n2 = side->n2;
 5492: 
 5493:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5494: 
 5495:       const bool isLand = segment->isLand;
 5496:       const int ifltype = segment->ifltype;
 5497: 
 5498:       const int kb = side->kb;
 5499: 
 5500:       if (!isLand && ifltype != 0) {
 5501:          const Vector2 *ubc = sideBnd->ubc;
 5502:   
 5503:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5504:             
 5505:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5506:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5507: 
 5508:             if (ifltype == -1) {
 5509:                // Flather 1
 5510: 
 5511:                const double depth = side->depth();
 5512: 
 5513:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5514: 
 5515:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5516: 
 5517:                side->u2[k] = vnorm*side->n;
 5518: 
 5519:             } else if (ifltype == -2) { // Discharge
 5520: 
 5521:                const double eta1 = side->eta1();
 5522:                const double eta2 = side->eta2();
 5523:                const double htot = side->htot2();
 5524: 
 5525:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5526:                assert(false && "Not implemented: Discharge bc");
 5527:                // const double dischrg = discharge(eta1);
 5528:                const double dischrg = 0.0; // XXX REMOVE
 5529:                
 5530: 
 5531:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5532: 
 5533:                const double vnorm = dischrg*eta2/htot;
 5534: 
 5535:                side->u2[k] = vnorm*side->n;
 5536: 
 5537:             }
 5538:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5539:                const double vnorm = dot(side->u2[k], side->n);
 5540: 
 5541:                double rat;
 5542:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5543:                else              rat = segment->vobc2; // outgoing
 5544: 
 5545:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5546: 
 5547:             }
 5548:             else { // not Flather or 3D radiation
 5549:                side->u2[k] = ubc[k];
 5550: 
 5551:             } // if (segment->ifltype...
 5552: 
 5553:          }
 5554: 
 5555:       }
 5556:       else if (isLand) { // if it is land boundary side
 5557: 
 5558:          if constexpr(islip == 0) { // free slip
 5559: 
 5560:             for (int k = kb; k < nvrt; k++) {
 5561: 
 5562:                const Vector2 t = side->t();
 5563:                const Vector2 n = side->n;
 5564: 
 5565:                double vnorm = 0.0; // for most cases
 5566:                const double vtan = dot(side->u2[k], t);
 5567:                
 5568:                side->u2[k] = vtan*t - vnorm*n;
 5569: 
 5570:             }
 5571: 
 5572:          } else { // no slip
 5573:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5574: 
 5575:          }
 5576:       } // if (side segment type...
 5577: 
 5578:    
 5579: 
 5580:    }
 5581: 
 5582: 
 5583:    __global__ void shapiroFilter1(void) {
 5584:       // First step of the Shapiro filter (normally used if indvel<=0)
 5585:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5586: 
 5587:       SIDE(side);
 5588: 
 5589:       // Only internal wet sides are processed
 5590:       if (side->isDry || !(side->isInternal())) return;
 5591: 
 5592:       const int kb = side->kb;
 5593: 
 5594:       for (int mm = 0; mm < niter_shap; mm++) {
 5595: 
 5596:          for (int k = kb + 1; k < nvrt; k++) {
 5597:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5598:             Vector2 suru = {0.0, 0.0};
 5599: 
 5600:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5601: 
 5602:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5603: 
 5604:                int kin = k;
 5605:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5606:                
 5607:                if constexpr(ics==1) {
 5608:                   suru += nSide->u2[kin];
 5609: 
 5610:                } else {
 5611:                   assert(false && "Not implemented: ics == 2");
 5612:                   // Vector2 vn1, vn2;
 5613:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5614:                   // suru=suru+vn1;
 5615:                   // surv=surv+vn2;
 5616:                }
 5617:             }
 5618: 
 5619: 
 5620:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5621: 
 5622:          }
 5623:       }
 5624:    }
 5625: 
 5626:    __global__ void shapiroFilter2(void) {
 5627:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5628: 
 5629:       SIDE(side);
 5630: 
 5631:       if (side->isDry || !(side->isInternal())) return;
 5632: 
 5633:       const int kb = side->kb;
 5634: 
 5635:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5636: 
 5637:       if (side->is2D()) {
 5638:          side->u2[kb + 1] = side->bcc[kb + 1];
 5639:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5640: 
 5641:       } else {
 5642:          // 3D
 5643:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5644:          
 5645:       }
 5646: 
 5647:    }
 5648: 
 5649: 
 5650:    __global__ void ul0UpdateZCoords(void) {
 5651:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5652:       
 5653:       NODE(node);      
 5654: 
 5655: 
 5656:       if (node->isDry2()) { 
 5657: 
 5658:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5659: 
 5660:          if constexpr(ivcor != 1) node->kb = 0;
 5661: 
 5662:       } else {
 5663: 
 5664:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5665:          node->updateKb();
 5666: 
 5667:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5668: 
 5669:       }
 5670: 
 5671:       // We use the temp.b field to store the previous state of isDry.
 5672:       node->tmp.b = node->isDry;
 5673: 
 5674:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5675:       node->isDry = true;
 5676: 
 5677:    }
 5678: 
 5679:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5680:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5681:    {
 5682:       ELEM(elem);
 5683: 
 5684:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5685: 
 5686:       // All the nodes of a wet element are wet.
 5687:       if (!elem->isDry) {
 5688:          elem->nodes[0]->isDry = false;
 5689:          elem->nodes[1]->isDry = false;
 5690:          elem->nodes[2]->isDry = false;
 5691:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5692: 
 5693:       }
 5694: 
 5695: 
 5696:       elem->kb = 0;
 5697: 
 5698:       if (elem->isDry) return;
 5699: 
 5700:       // Wet
 5701:       const Node *n1 = elem->nodes[0];
 5702:       const Node *n2 = elem->nodes[1];
 5703:       const Node *n3 = elem->nodes[2];  
 5704:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5705: 
 5706:    //    if(elem->isDry2()) { // XXXX
 5707:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5708:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5709:    //        call parallel_abort(errmsg)
 5710:    //    }
 5711: 
 5712: 
 5713:       // Computes element's kb as the minimum of the nodes' kb.
 5714:       const int kb1 = n1->kb;
 5715:       const int kb2 = n2->kb;
 5716:       const int kb3 = n3->kb;
 5717:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5718: 
 5719: 
 5720:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5721: 
 5722: 
 5723:       // Computes the element z as the mean of the nodes z.
 5724:       for (int k = elem->kb; k < nvrt; k++) {
 5725: 
 5726:          // Compute the element z as the mean of the nodes z.
 5727:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5728:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5729:          elem->z[k] /= elem->i34;
 5730: 
 5731:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5732:       }
 5733:                   
 5734:    }
 5735: 
 5736:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5737:    {
 5738:       NODE(node);
 5739:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5740: 
 5741:       if (it == iths) return;
 5742: 
 5743: 
 5744:       if(!node->isDry && node->tmp.b) { // rewetted
 5745:          for (int k=0; k < nvrt; k++) {
 5746: 
 5747:             Vector3 utmp={0.0, 0.0, 0.0};
 5748: 
 5749:             double ttmp=0.0;
 5750:             double stmp=0.0;
 5751:             int icount=0;
 5752:             for (int j = 0; j < node->numNodes; j++) {
 5753: 
 5754: 
 5755:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5756:                if (!node->isDry) { // all indices extended
 5757:                   icount++;
 5758: 
 5759:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5760:                   utmp += node->uvw2(k);
 5761:                   
 5762:                   ttmp += node->tracers[k].tracer[0]; 
 5763:                   stmp += node->tracers[k].tracer[1]; 
 5764:                }
 5765:             }
 5766: 
 5767:             if(icount > 0) {
 5768:                const double inv_icount = 1.0/icount;
 5769:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5770:                node->w2[k]     = inv_icount*utmp.z;
 5771:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5772:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5773:             }
 5774:          }
 5775:       }
 5776:    }
 5777: 
 5778: 
 5779:    __global__ void ul0UpdateSides(int it, int iths) {
 5780: 
 5781:       SIDE(side);
 5782: 
 5783:       // A side is wet if and only if at least one of its elements is wet.
 5784:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5785: 
 5786:       const Node *n1 = side->n1;
 5787:       const Node *n2 = side->n2;
 5788:       const int kb1 = n1->kb;
 5789:       const int kb2 = n2->kb;
 5790: 
 5791:       side->kb = 0; // dry
 5792: 
 5793:       if (isWet) {
 5794: 
 5795:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5796: 
 5797:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5798: 
 5799:          side->kb = min(kb1, kb2);
 5800: 
 5801:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5802: 
 5803:          for (int k = side->kb; k < nvrt; k++) {
 5804:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5805: 
 5806:          
 5807:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5808: 
 5809:             // Compute velocity for re-wetted sides 
 5810:             if ((it != iths) && (side->isDry && isWet)) {
 5811:             
 5812:                Vector2 utmp={0.0, 0.0};
 5813: 
 5814:                int icount=0;
 5815: 
 5816:                // For all the sides on the two elements that share this side
 5817:                for (int j=0; j < 2; j++) {
 5818:                   const Element *elem = side->elems[j];
 5819:                   if (elem == nullptr) continue;
 5820: 
 5821:                   for (int jj=0; jj < elem->i34; jj++) {
 5822:                      const Side *nSide = elem->sides[jj];
 5823:                      if (nSide->isDry) continue;
 5824: 
 5825:                      icount++;
 5826:                      utmp += nSide->u2[k];                     
 5827:                   }
 5828:                }
 5829:                   
 5830:                assert(icount > 0 && "No wet sides around this side");
 5831:                if (icount > 0)  side->u2[k] = utmp/icount;
 5832:                   
 5833:             } // if ((it != iths) && (side->isDry && isWet))
 5834: 
 5835:          } // for k
 5836: 
 5837:       } // if isWet
 5838:    
 5839:       side->isDry = !isWet;
 5840: 
 5841:    }
 5842: 
 5843: 
 5844:    __global__ void zeroNodalVelocities(void) {
 5845:       NODE(node);
 5846: 
 5847:       for (int k = 0; k < nvrt; k++) {
 5848:          node->u2[k]   = {0.0, 0.0};
 5849:          node->w2[k]   = 0.0;
 5850:          node->utmp[k] = {0.0, 0.0};
 5851:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5852:       }
 5853:    }
 5854: 
 5855:  
 5856: 
 5857:    __global__ void computeNodalVerticalVelocities1(void) {
 5858:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5859:    // Adds the element's vertical velocity times the element's area.
 5860:       ELEM(elem);
 5861: 
 5862:       for (int j = 0; j < elem->i34; j++) {
 5863:          Node *node = elem->nodes[j];
 5864: 
 5865:          for (int k = node->kb; k < nvrt; k++) {
 5866:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5867:          }
 5868:          atomicAdd(&(node->tmp.d), elem->area);
 5869:       }
 5870:    }
 5871: 
 5872:    __global__ void computeNodalVerticalVelocities2(void) {
 5873:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5874:    // Divides by the total area of the elements sharing the    node.
 5875:       NODE(node);
 5876: 
 5877:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5878:    }
 5879: 
 5880: 
 5881:    __global__ void computeNodalHorizontalVelocities1(void) {
 5882:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5883:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5884: 
 5885:       ELEM(elem);
 5886: 
 5887:       const int kb = elem->kb;
 5888:       const bool isTri = elem->isTri();
 5889: 
 5890:       if constexpr(indvel <= 0) {
 5891:          // Assuming discontinoius hvel.
 5892: 
 5893: 
 5894:          if (isTri) { // For triangles
 5895:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5896:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5897: 
 5898:             for (int j = 0; j < 3; j++) {
 5899:                // For every node of the triangle...
 5900:                Node *node = elem->nodes[j];
 5901: 
 5902:                const Side *s1 = elem->sides[j];
 5903:                const Side *s2 = elem->sides[(j + 1) % 3];
 5904:                const Side *s3 = elem->sides[(j + 2) % 3];
 5905: 
 5906:                const int numElements = node->numElements;
 5907:                const double inv_numElements = 1.0/numElements;
 5908: 
 5909:                for (int k = kb; k < nvrt; k++)  {
 5910:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 5911:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5912:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5913:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5914:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 5915:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 5916: 
 5917:                }
 5918: 
 5919:             }
 5920:          }
 5921:          else { // For quads
 5922:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 5923: 
 5924:          }
 5925: 
 5926:       }
 5927:       
 5928:    }
 5929: 
 5930: 
 5931:    __global__ void computeNodalHorizontalVelocities2(void) {
 5932:       NODE(node);
 5933: 
 5934:       for (int k = 0; k < nvrt; k++) {
 5935:          node->u2[k] = node->utmp[k];
 5936:          node->w2[k] = node->w2[k];
 5937:       }
 5938:       
 5939:    }   
 5940: 
 5941:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5942:    // XXXX I'm not sure where I got this function from. 
 5943:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5944:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5945:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5946:    // It uses the utmp array as a temporary array to store the velocities.
 5947: 
 5948:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5949: 
 5950:       SIDE(side);
 5951: 
 5952:       const int kb = side->kb;
 5953: 
 5954:       Node *n1 = side->n1;
 5955:       Node *n2 = side->n2;
 5956: 
 5957:       for (int k = kb; k < nvrt; k++) {
 5958: 
 5959:          // Cast the u2 vector into a Vector2 
 5960:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5961:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5962: 
 5963:          n1_u2 = side->u2[k]/n1->numSides;
 5964:          n2_u2 = side->u2[k]/n2->numSides;
 5965: 
 5966:       }
 5967: 
 5968: 
 5969:    }
 5970: 
 5971:    __global__ void resetVelocityOpenBndNodes(void) {
 5972:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5973: 
 5974:       NODE_BND(nodebnd);
 5975: 
 5976:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5977:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 5978:       }
 5979: 
 5980:    }
 5981: 
 5982: 
 5983:    __global__ void setVelocityOpenBndNodes(void) {
 5984:    // For open boundary nodes sets their velocity to the imposed values.
 5985: 
 5986:       SIDE_BND(sidebnd);
 5987: 
 5988:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5989:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5990:          // to its segment to the average of the side velocity.
 5991: 
 5992:          for (int k = 0; k < nvrt; k++) {
 5993:             Node *n1 = sidebnd->side->n1;
 5994:             Node *n2 = sidebnd->side->n2;
 5995: 
 5996: 
 5997:             Vector2 n1_u2(n1->u2[k]);
 5998:             Vector2 n2_u2(n2->u2[k]);
 5999: 
 6000:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6001:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6002:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6003:             }
 6004:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6005:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6006:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6007:             }
 6008: 
 6009:          }
 6010: 
 6011:       }
 6012: 
 6013:    }
 6014: 
 6015: 
 6016:    __global__ void computeVerticalVelocity(void) {
 6017:       // Computes the vertical velocity at the (2D) element's centroid.
 6018:       // In this function we will be considering volumetric elements, with side faces and a 
 6019:       // bottom and a top face. We will call them SFs, BF and TF.
 6020:       // It computes the flux coming from BF and the SFs.
 6021:       // If the bed is moving, it takes that into account.
 6022:       // Since water is incompressible, the integral of the velocity times the normal vector
 6023:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6024:       // and the BF is equal to the flux going out from the TF.
 6025:       // TF = - BF - sum(SFs).
 6026:       // It then computes the horizontal velocity at the center of TF.
 6027:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6028:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6029:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6030: 
 6031:       ELEM(elem);
 6032: 
 6033:       if (elem->isDry) return;
 6034: 
 6035:       const int kb = elem->kb;
 6036:       const bool isTri = elem->isTri();
 6037: 
 6038:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6039: 
 6040:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6041:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6042:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6043: 
 6044:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6045: 
 6046:       double area3D;
 6047: 
 6048:       // Bottom face flux
 6049:       double bottomFlux = 0.0;
 6050:       Vector2 u2meanBottom = {0.0, 0.0};
 6051:       const Vector2 gradh = elem->grad2(&Node::depth);
 6052:       if constexpr(imm==2) {
 6053:          Vector3 ubed;
 6054: 
 6055:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6056:          // updateBDEF(ubed);
 6057:      
 6058:          // const double bflux0 = dot(ubed, elem_n1);
 6059: 
 6060:          // elem->w[kb] += ubed.z;
 6061:       }
 6062:       else {
 6063:          Vector2 umean;
 6064:          if constexpr(ics == 1) {
 6065:             u2meanBottom = elem->mean(kb, &Side::u2);
 6066:          }
 6067:          else {
 6068:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6069:          }
 6070: 
 6071:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6072:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6073: 
 6074:          bottomFlux = - dot(gradh, u2meanBottom);
 6075:       } // if imm
 6076: 
 6077:       // Compute w for kb+1 to nvrt-1
 6078:       for (int l = kb; l < nvrt - 1; l++) {
 6079: 
 6080:          // normal vector to the top face of the "volumetric" element (3D)
 6081:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6082: 
 6083:          // Compute the total flux at the sides
 6084:          double sideFlux = 0.0;
 6085:          Vector2 u2top = {0.0, 0.0};
 6086:          for (int j = 0; j < elem->i34; j++) {
 6087:             const Side *side = elem->sides[j];
 6088: 
 6089:             const double sideArea = side->area(l);
 6090:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6091:             const double sign = elem->ssign[j]; 
 6092: 
 6093:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6094:          }
 6095:          
 6096:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6097:          //velocities at the centers of the sides
 6098:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6099: 
 6100:          // The flx at the top ace can be computed from the other flows.
 6101:          const double topFlux = - sideFlux - bottomFlux;
 6102:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6103: 
 6104:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6105: 
 6106:          elem_n1 = elem_n2;
 6107: 
 6108:          bottomFlux = - topFlux;
 6109:       }
 6110:    }  
 6111: 
 6112: 
 6113: 
 6114: 
 6115: 
