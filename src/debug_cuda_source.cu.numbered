 1944: // Convenience macros for accessing the objects in kernels.
 1945: 
 1946: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1947:                    Side *side = &(mesh->localSideData[idx_side]); \
 1948:                    if (idx_side >= mesh->ns) return;
 1949: 
 1950: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1951:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1952:                    if (idx_elem >= mesh->ne) return;
 1953: 
 1954: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1955:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1956:                    if (idx_node >= mesh->np) return;
 1957: 
 1958: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1959:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1960:                               const bool valid = (idx_node < mesh->np);                   
 1961: 
 1962: 
 1963: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1964:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1965:                            if (idx_node_bnd >= mesh->nbp) return;
 1966: 
 1967: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1968:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1969:                            if (idx_side_bnd >= mesh->nbs) return;                           
