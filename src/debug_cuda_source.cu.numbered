 2297: 
 2298: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2299: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2300: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2301: // Only when ics == 2, the origin is at the element center.
 2302: 
 2303:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2304: 
 2305:    const Node *node = nodes[idxNode];
 2306: 
 2307:    if constexpr(ics==1) {
 2308:       return node->p;
 2309: 
 2310:    } else {
 2311:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2312: 
 2313:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2314: 
 2315:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2316:    }
 2317: 
 2318: }
 2319: 
 2320: 
 2321: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2322: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2323: 
 2324:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2325: 
 2326:    const int id1 = idx;
 2327:    const int id2 = nxq(1 + id1);
 2328:    const int id3 = nxq(2 + id1);
 2329: 
 2330:    if constexpr(ics==1) {
 2331:       x0 = nodes[id1]->p;
 2332:       x1 = nodes[id2]->p;
 2333:       x2 = nodes[id3]->p;
 2334: 
 2335:    } else {
 2336:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2337: 
 2338:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2339:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2340:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2341: 
 2342:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2343:       x1 = toVector2(frame.G2L(p1 - c));
 2344:       x2 = toVector2(frame.G2L(p2 - c));
 2345: 
 2346:    }
 2347: 
 2348: }
 2349: 
 2350: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2351: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2352: 
 2353:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2354: 
 2355:    if constexpr(ics==1) {
 2356:       x0 = nodes[0]->p;
 2357:       x1 = nodes[1]->p;
 2358:       x2 = nodes[2]->p;  
 2359:       x3 = nodes[3]->p;
 2360: 
 2361:    } else {
 2362:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2363: 
 2364:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2365:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2366:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2367:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2368: 
 2369:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2370:       x1 = toVector2(frame.G2L(p1 - c));
 2371:       x2 = toVector2(frame.G2L(p2 - c));
 2372:       x3 = toVector2(frame.G2L(p3 - c));
 2373:    }
 2374: 
 2375: }
 2376: 
 2377: 
 2378: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2379: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2380: // Returns the normal vector and the area of the element at this level
 2381:    
 2382:    double nx, ny, nz;
 2383: 
 2384:    if (isTri()) {
 2385:       // For triangles...
 2386: 
 2387:       // Indices of the nodes at level k, taking care of not going below the bed
 2388:       const int k0 = max(k, nodes[0]->kb);
 2389:       const int k1 = max(k, nodes[1]->kb);
 2390:       const int k2 = max(k, nodes[2]->kb);
 2391: 
 2392:       // Gets the element frame coordinates of the nodes at level k
 2393:       Point3 x0, x1, x2;
 2394:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2395:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2396:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2397:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2398: 
 2399:       } else {  // ics == 2
 2400:          Point2 h0, h1, h2;
 2401: 
 2402:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2403: 
 2404:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2405:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2406:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2407:       }
 2408: 
 2409:       const Vector3 n20 = x2 - x0;
 2410:       const Vector3 n10 = x1 - x0; 
 2411: 
 2412:       // Computes the cross product of vectors n20 and n10. 
 2413:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2414:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2415:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2416: 
 2417:   
 2418:    }
 2419:    else {
 2420:       // For quads...
 2421:       Point2 h0, h1, h2, h3;
 2422: 
 2423:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2424: 
 2425:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2426:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2427:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2428:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2429: 
 2430:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2431:       nx = n20.y*n31.z - n20.z*n31.y;
 2432:       ny = n20.z*n31.x - n20.x*n31.z;
 2433:       nz = n20.x*n31.y - n20.y*n31.x;
 2434: 
 2435:    }
 2436: 
 2437:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2438:    area3D = 0.5*len;
 2439: 
 2440:    const double inv_len = 1.0/len;
 2441: 
 2442:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2443: 
 2444: }
 2445: 
 2446: 
 2447: 
 2448: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2449:    // Check if the point (xt,yt) is inside the element.
 2450:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2451:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (2)");
 2452: 
 2453:    double shpCoords[4];
 2454:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2455: 
 2456:    return res;
 2457: }
 2458: 
 2459: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2460:    // Check if the point (xt,yt) is inside the element.
 2461:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2462:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2463:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (3)");
 2464: 
 2465:    double shpCoords[4];
 2466:    Vector2 tmp_xt = xt;
 2467:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2468: printf("HEREEEEEE\n");
 2469:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2470: 
 2471:    if (fixCoords && res) xt = tmp_xt;
 2472: 
 2473:    return res;
 2474: }
 2475: 
 2476: 
 2477: __device__ void Element::trackGoesOutOfWater(const Side *nextSide, const Side *origSide, Element *curElem, double tt, int jlev,
 2478:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2479: 
 2480:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2481:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2482:    // curElement.
 2483: 
 2484:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2485:    // And uses this velocity instead to continue the tracking.
 2486: 
 2487:    // computes the intersection point in local cartesian coordinates
 2488: //    Point3 intersection = origSide->toLocalFrame(nextSide->p3_t(tt));  // XXXX I don't think this is necessary. The intersection is already computed in findNextIntersection.
 2489: 
 2490: //    // Nudges the point to the barycenter of the element. 
 2491: //    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2492: //    // next segment intersects the element sides. 
 2493: //    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2494: 
 2495: 
 2496: //    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2497: //    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2498: //    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2499: //    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2500: 
 2501: //    // If the side is an open boundary, the tangential velocity is set to zero.
 2502: //    if (nextSide->isBnd()) vtan = 0.0;
 2503: 
 2504: //    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2505: //    const double us = vtan*nextSide->t().x;
 2506: //    const double vs = vtan*nextSide->t().y;
 2507: //    const double ws = nextSide->w2(jlev); 
 2508: 
 2509: //    u_int = {us, vs, ws};
 2510: 
 2511: //    // The end of this tracking segment is now the intersection point.
 2512: //    xt = {intersection.x, intersection.y, zint};
 2513: // // printf("trackGoesOutOfWater: intersection = (%.17f, %.17f, %.17f), zint = %.17f, u_int = (%.17f, %.17f, %.17f)\n", intersection.x, intersection.y, zint, u_int.x, u_int.y, u_int.z);
 2514:    
 2515: }
 2516: 
 2517: // Helper functions to get the 2D local node position for the Celestial walk
 2518: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2519:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2520:    const Node *node = getNodeInOrder(idx2);
 2521: 
 2522:    double z = 0.0;
 2523:    if constexpr(ics == 2) z = node->gz;
 2524:    
 2525:    Point3 p = toPoint3(node->p, z);
 2526: 
 2527:    return toPoint2(origSide->toLocalFrame(p));
 2528: }
 2529: 
 2530: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2531:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2532: }
 2533: 
 2534: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2535:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2536: // Computes the three per-side predicates needed for the celestial walk
 2537: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2538: //
 2539: // xt is in local frame coordinates for origSide if ics == 2.
 2540: //
 2541: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2542: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2543: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2544: // meaningless on triangles are masked to a safe value (see comments below).
 2545: {
 2546:    // Project all 4 corner positions once into the local 2D frame.
 2547:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2548:    // getLocalNodePosition only transforms/projects if ics == 2.
 2549:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2550:                         getLocalNodePosition(1, origSide), 
 2551:                         getLocalNodePosition(2, origSide), 
 2552:                         getLocalNodePosition(3, origSide)};
 2553: 
 2554:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2555:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2556:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2557:    // But still farther towards the target point from the current point.
 2558:    const Vector2 vt0 = xt - x0;
 2559:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2560:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2561:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2562: 
 2563:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2564:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2565: 
 2566: 
 2567: // if (origSide->idx == 2860848 && jlev == 46) {
 2568: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2569: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2570: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2571: // }
 2572:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2573:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2574:    //  here the orientation is baked into the corners array.)
 2575:    const int i3 = nxq(3);
 2576:    const Vector2 s0 = C[ 1] - C[ 0];
 2577:    const Vector2 s1 = C[ 2] - C[ 1];
 2578:    const Vector2 s2 = C[i3] - C[ 2];
 2579:    const Vector2 s3 = C[ 0] - C[i3];
 2580:    
 2581:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2582:    // The corners array is built from getNode in CCW order, so the orientation
 2583:    // is already correct and no ssign factor is needed in the formulas below.
 2584:    //
 2585:    // i3 = nxq(3): the index of the corner after side 2.
 2586:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2587:    //   Quad:     i3 == 3.
 2588:    //
 2589:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2590:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2591:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2592:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2593:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2594:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2595: 
 2596: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2597: 
 2598:    // For triangles, the corner after side 2 is the closing corner where
 2599:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2600:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2601:    // s0 for triangles, s3 for quads.
 2602:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2603: 
 2604:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2605:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2606:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2607:    //
 2608:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2609:    // result is false naturally. No sentinel needed.
 2610:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2611:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2612:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2613:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2614: 
 2615:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2616:    // on the "exit through side I" half of the corner cone, separated by the
 2617:    // approximate angular bisector of the celestial walk. The bisector is
 2618:    // perpendicular to the chord across the corner; the test is the sign of
 2619:    // (xt - corner_vertex) projected onto that chord.
 2620:    //
 2621:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2622:    // (the validity rule sets valid_3 = false), so its computed value for
 2623:    // triangles doesn't matter. No sentinel needed.
 2624:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2625:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2626:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2627:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2628: 
 2629: }
 2630: 
 2631: 
 2632: __inline__ __device__ double Element::computeSignedArea(void) const {
 2633:    // Compute the area of the element
 2634: 
 2635:    Point2 x0, x1, x2, x3;
 2636:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2637: 
 2638:    double res = signedArea(x0, x1, x2);
 2639: 
 2640:    // In the quad case we need to add the area of the other triangle.
 2641:    if (isQuad()) {
 2642:       x3 = getLocalHorizontalNodePosition(3);
 2643:       double ar1 = signedArea(x0, x2, x3);
 2644:       double ar2 = signedArea(x0, x1, x3);
 2645:       double ar3 = signedArea(x1, x2, x3);
 2646:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2647: 
 2648:       res += ar1 + ar2 + ar3;
 2649:    }
 2650: 
 2651:    return res;
 2652: }
 2653: 
 2654: 
 2655: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2656:                                                                 (nodes[1]->isDry2()) ||
 2657:                                                                 (nodes[2]->isDry2()) ||
 2658:                                                                 (isQuad() && nodes[3]->isDry2());
 2659: }
 2660: 
 2661: __inline__ __device__ double Element::detJ_eta(void) const {
 2662:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2663:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2664: }
 2665: 
 2666: __inline__ __device__ double Element::detJ_xi(void) const {
 2667:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2668:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2669: }
 2670: 
 2671: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2672:    // In boundary sides, the element 1 is nullptr
 2673:    return side->elems[1] == nullptr; 
 2674: }
 2675: 
 2676: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2677:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2678:    // For ics == 2, this function uses local frame coordinates.
 2679: 
 2680:    assert(isQuad());
 2681: 
 2682:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2683:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2684:    // where vxi, veta, vb are vectors and c is the center of the element.
 2685: 
 2686:    Point2 p0, p1, p2, p3;
 2687: 
 2688:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2689: 
 2690:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2691:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2692:    // vectors vxi and veta connect the centers of opposite sides
 2693:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2694:    // vb is zero for parallelogram elements.
 2695:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2696: 
 2697:    //  The bilinear mapping is:
 2698:    //      P(s,t) = C + s*U + t*V + s*t*W
 2699:    //
 2700:    //  where:
 2701:    //    C = centroid (average of four vertices)
 2702:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2703:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2704:    //    W = bilinear correction; measures deviation from parallelogram
 2705:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2706:    //        W = 0 for parallelogram elements.
 2707:    //
 2708:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2709:    //
 2710:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2711:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2712:    //
 2713:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2714:    //
 2715:    //  Geometrically, (L) projects everything onto the direction
 2716:    //  perpendicular to W, where the mapping is purely affine.
 2717:    //
 2718:    //  The dot product with nb retains the nonlinear term:
 2719:    //
 2720:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2721:    //
 2722:    //  Geometrically, (Q) projects onto the W direction, where
 2723:    //  the nonlinearity lives.
 2724:    //
 2725:    //  We solve (L) for whichever variable has the larger coefficient
 2726:    //  (better conditioned back-substitution), substitute into (Q),
 2727:    //  and get a scalar quadratic in the other variable.
 2728:    // ================================================================
 2729: 
 2730:    // ---- Basis vectors ----
 2731:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2732:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2733:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2734:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2735:    // W: nonlinear correction. Difference between quad and parallelogram.
 2736:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2737:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2738: 
 2739:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2740:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2741:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2742:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2743:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2744: 
 2745:    // ---- nb: direction parallel to W, L1-normalized ----
 2746:    // We don't need a unit vector -- just a well-scaled direction parallel
 2747:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2748:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2749:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2750:    //
 2751:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2752:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2753:    // and the quadratic solver takes its linear path (a ~ 0).
 2754:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2755:    const double inv_wlen = 1.0 / wlen1;
 2756:    const Vector2 nb = vb * inv_wlen;
 2757: 
 2758:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2759:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2760:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2761:    // What remains is a pure affine relationship between xi and eta.
 2762:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2763:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2764:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2765: 
 2766:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2767:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2768:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2769:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2770:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2771:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2772:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2773: 
 2774:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2775:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2776:    // minimizing round-off amplification.
 2777:    //
 2778:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2779:    // that uses predicated moves.
 2780:    //
 2781:    // if (fabs(Ls) > fabs(Lt)) {
 2782:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2783:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2784:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2785:    //    const double A = -Qw * Lt;
 2786:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2787:    //    const double C =  Qs * Lp - Qp * Ls;
 2788: 
 2789:    //    double eta1, eta2;
 2790:    //    solveQuadratic(A, B, C, eta1, eta2);
 2791: 
 2792:    //    // Pick root with smaller |eta| (domain centered at 0).
 2793:    //    // Ternary-> predicated move, no branch divergence.
 2794:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2795: 
 2796:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2797:    //    xi = (Lp - Lt * eta) / Ls;
 2798: 
 2799:    // } else {
 2800:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2801:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2802:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2803:    //    const double A = -Qw * Ls;
 2804:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2805:    //    const double C =  Qt * Lp - Qp * Lt;
 2806: 
 2807:    //    double xi1, xi2;
 2808:    //    solveQuadratic(A, B, C, xi1, xi2);
 2809: 
 2810:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2811: 
 2812:    //    eta = (Lp - Ls * xi) / Lt;
 2813:    // }
 2814:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2815:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2816:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2817:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2818:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2819: 
 2820:    // Quadratic:  A*r^2 + B*r + C = 0
 2821:    // (same formula for both cases, just with swapped coefficients)
 2822:    const double A = -Qw * Lb;
 2823:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2824:    const double C =  Qa * Lp - Qp * La;
 2825: 
 2826:    double r1, r2;
 2827:    solveQuadratic(A, B, C, r1, r2);
 2828: 
 2829:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2830:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2831: 
 2832:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2833:    const double other = (Lp - Lb * r) / La;
 2834: 
 2835:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2836:    xi  = solve_s ? r     : other;
 2837:    eta = solve_s ? other : r;
 2838: 
 2839: 
 2840:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2841:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2842:    eta = fmin(1.0, fmax(eta, -1.0));
 2843: 
 2844:    // ---- Shape functions ----
 2845:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2846:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2847:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2848:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2849:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2850:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2851:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2852:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2853: 
 2854:    return true;
 2855: }
 2856: 
 2857: /**
 2858:    Compute the shape coordinates of the point (xt,yt) in the element.
 2859:    @param xt (input): x-coordinate of the point
 2860:    @param shpCoords (output): shape coordinates of the point
 2861:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2862:    @return true if the point is inside the element, false otherwise
 2863: **/
 2864: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2865: 
 2866:    // Compute the shape coordinates of the point xt in the element.
 2867:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2868:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2869:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2870:    // from the local frame, so use additional check.
 2871: 
 2872: 
 2873:    if (isTri()) { // Triangular element
 2874: 
 2875:       // Horizontal local node coordinates. 
 2876:       Point2 x0 = nodes[0]->p;
 2877:       Point2 x1 = nodes[1]->p;
 2878:       Point2 x2 = nodes[2]->p;
 2879: 
 2880:       // If ics == 2, the node coordinates are transformed to local frame.
 2881:       if constexpr(ics==2) {
 2882:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2883:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2884:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2885: 
 2886: 
 2887:          // Convert the node coordinates to the local frame centered at the element center
 2888:          x0 = toPoint2(origSide->toLocalFrame(p0));
 2889:          x1 = toPoint2(origSide->toLocalFrame(p1));
 2890:          x2 = toPoint2(origSide->toLocalFrame(p2));
 2891:       }
 2892: 
 2893:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2894:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2895:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2896:       shpCoords[3] = 0.0;
 2897: 
 2898: 
 2899:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2900:       const bool res = (tmpmin >= -small);  
 2901:       
 2902:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2903:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2904: 
 2905: double tmpmax = max3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2906: if (tmpmin < -0.01) printf("XXX element %d, tmpmin = %.17f\n", idx, tmpmin);
 2907: if (tmpmax > 1.01) printf("XXX element %d, tmpmax = %.17f\n", idx, tmpmax);
 2908:       
 2909:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2910:       // then we fix the negative shape coordinates.
 2911:       if ((tmpmin < 0) && fix) {
 2912: 
 2913:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2914:          // keeping the sum of the shape coordinates equal to 1.
 2915:          // I have tested and compared the new algorithm with the old one, and they give
 2916:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2917:          // The new algorithm should be faster since it is branchless.
 2918:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2919:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2920: 
 2921:          shpCoords[0] = (shpCoords[0] + a)*b;
 2922:          shpCoords[1] = (shpCoords[1] + a)*b;
 2923:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2924: 
 2925:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2926:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2927:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2928: 
 2929:          // Update the point coordinates for the new shape coordinates
 2930:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2931:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2932: 
 2933:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2934: 
 2935:       }
 2936: 
 2937:       // Check if the point is inside the element
 2938:       return res;      
 2939:    }
 2940:    else {
 2941:       assert(isQuad() && "computeShapeCoords");
 2942: 
 2943:    //    Point2 p = xt;
 2944: 
 2945:    //    // Reproject p the original side frame for ics=2
 2946:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 2947: 
 2948:    //    bool inside = false;
 2949: 
 2950: 
 2951: 
 2952:    //    if(ifl==0) then
 2953:    //      do i=1,4
 2954:    //        in1=nxq(1,i,i34(ie))
 2955:    //        in2=nxq(2,i,i34(ie))
 2956:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 2957:    //      enddo !i
 2958:    //      tmp=minval(swild2(1:4))/area(ie)
 2959:    //      if(tmp>-small2) then
 2960:    //        inside=1
 2961:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 2962:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 2963:    //      endif !inside quad
 2964:    //    else !ifl=1 - already inside
 2965:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 2966:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 2967:    //      !Update pt
 2968:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 2969:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 2970:    //    endif !ifl
 2971: 
 2972: 
 2973:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2974: 
 2975:    }
 2976: 
 2977:    assert(false && "computeShapeCoords: should never reach this point");
 2978:    return false;  // Never reached
 2979: 
 2980: }
