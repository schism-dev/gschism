  734: struct Element {
  735: 
  736:    // Geometry information
  737:    int idx;                   // Index of the element
  738:    int i34;                   // Number of sides for the element 
  739:    Side *sides[4];            // Sides of the element
  740:    Node *nodes[4];            // Nodes of the element
  741:    Element *nghbElems[4];     // Neighbors of the element
  742: 
  743:    int kb;                    // Bottom index of the element
  744:    double area;               // Area of the element
  745:    double ssign[4];           // Sign associated with each side of an element
  746:    double radius;             // Element equivalent radii
  747: 
  748:    Frame<ics> frame;
  749: 
  750:    Vector2 gradPhi[4];        // Derivatives of shape functions
  751:    Vector2 gradEta;           // Gradient of free surface elevation
  752:    Vector2 gradPr;            // Gradient of pressure    
  753:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  754: 
  755:    bool isDry;                // True if the element is dry
  756: 
  757:    Point2 center;            // Element center coordinates (global coordinates)
  758: 
  759:    double depth;              // Depth at element (min of all nodes)
  760:    double z[nvrt];            // z-coord  (local frame - vertical up)
  761: 
  762:    // Physical information
  763:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  764: 
  765:    static const bool isblock = false;              // Always false
  766: 
  767:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  768:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  769: 
  770:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  771:    
  772: 
  773:    double vsource;            // Volumetric source/sink term [m^3/s]
  774: 
  775:    double rho[nvrt];          // Density at each prism center
  776:    double rho_mean[nvrt];     // Mean density at each prism center
  777:    CubicSpline rho_spl;
  778:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  779:    double rho_z[nvrt];        // First derivative of density at each prism center
  780:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  781:    
  782: 
  783:    __inline__ __device__ Point2 outputCoords(void) const;
  784: 
  785:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  786: 
  787:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  788:    // If ics == 2, convert the global point to the local frame of the element
  789:       
  790:       if constexpr (ics == 1) {
  791:          return p;
  792:       } else {
  793:          const Point3 c = {center.x, center.y, centerZ()};
  794:          return frame.G2L(p - c);
  795:       }
  796:    }
  797: 
  798:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
  799:    // If ics == 2, convert the local point to a global point
  800:       
  801:       if constexpr (ics == 1) {
  802:          return p;
  803:       } else {
  804:          const Point3 c = {center.x, center.y, centerZ()};
  805:          return c + frame.L2G(p);
  806:       }
  807:    }
  808: 
  809:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  810:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  811: 
  812:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  813:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  814: 
  815:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  816:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  817:       // Find the local index of the node in the element (0,1,2,3)
  818:       int res = __ffs((nodes[0] == node) | 
  819:                      ((nodes[1] == node) << 1) | 
  820:                      ((nodes[2] == node) << 2) | 
  821:                      ((nodes[3] == node) << 3)) - 1;
  822:       
  823:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  824:       return res;  
  825:    }
  826: 
  827:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  828:       // Find the local index of the side in the element (0,1,2,3)
  829:       int res = __ffs((sides[0] == side) | 
  830:                      ((sides[1] == side) << 1) | 
  831:                      ((sides[2] == side) << 2) | 
  832:                      ((sides[3] == side) << 3)) - 1;
  833:       
  834:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  835:       return res;
  836:    }
  837: 
  838:    __inline__ __device__ int findLevel(double z1, int k) const {
  839:       // Starting at index k, find sequentially the level that contains z
  840: 
  841:       // For testing purposes, forgets k and performs a full search.
  842:       for (k = kb; k < nvrt - 1; k++) {
  843:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  844:       }
  845:       return nvrt - 2;
  846: 
  847: 
  848:       // if z is already betweeen z[k] and z[k+1], return k
  849:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  850:       else if (z1 <  z[k]) { 
  851:          // Search for increasing levels
  852:          for (int kk = k; kk < nvrt - 1; kk++) {
  853:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  854:          }
  855:          return nvrt - 1;
  856:       }
  857:       else {
  858:          // Search for decreasing levels
  859:          for (int kk = k; kk >= kb; kk--) {
  860:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  861:          }
  862:          return 0;
  863:       }
  864:    }
  865: 
  866:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  867:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  868: 
  869: 
  870:    __device__ __forceinline__ double centerZ(void) const;
  871: 
  872:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  873:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  874:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  875:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
  876:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
  877:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  878:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
  879:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
  880:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  881: 
  882: 
  883:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  884:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  885:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  886:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  887:        const double eta = (idxNode & 1) ? +g : -g;
  888:        const double xi  = (idxNode & 2) ? +g : -g;
  889:        return {eta, xi};
  890:    }  
  891: 
  892: 
  893: 
  894:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  895:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
  896:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
  897:    }
  898: 
  899:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  900:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
  901:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
  902:    }   
  903: 
  904:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  905:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
  906:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
  907:    }      
  908:    
  909:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  910: 
  911:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  912: 
  913:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
  914:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
  915: 
  916:    // Check if the element is dry using the more up-to-date elevation.
  917:    __inline__ __device__ bool isDry2(void) const;
  918: 
  919:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
