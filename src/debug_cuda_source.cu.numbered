  933:    
  934:    // Elevation boundary condition
  935:    int iettype;  // Type of elevation boundary condition
  936:    double eth;   // Elevation time history
  937: 
  938:    // Flow boundary condition
  939:    double qthcon;  // Flow time history constant
  940:    double vobc1;   // Velocity coefficient 1
  941:    double vobc2;   // Velocity coefficient 2
  942: 
  943:    // Tracer boundary conditions
  944:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  945:    // int  itrtype[natrm];    // Tracer boundary condition type
  946: 
  947:    BoundarySegment(bool _isLand) {
  948:       isLand = _isLand;
  949:       clen = 0.0;
  950:       carea = 0.0;
  951:       ifltype = 0;
  952:       iettype = 0;
  953:       eth = 0.0;
  954:    }
  955: 
  956:    BoundarySegment(void) {
  957:       isLand = false;
  958:       clen = 0.0;
  959:       carea = 0.0;
  960:       ifltype = 0;
  961:       iettype = 0;
  962:       eth = 0.0;
  963:    }
  964: 
  965:    
  966: };
