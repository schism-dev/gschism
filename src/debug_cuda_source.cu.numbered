 7313: __global__ void returnMatrix(double *res) {
 7314:    // Debugging: returns the matrix as a CuPy array
 7315: 
 7316:    const int size = mesh->np;
 7317:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7318:       const Node *node = mesh->localNodeData + idx_node;
 7319:       res[idx_node*size + idx_node] = node->coeffDiag;
 7320:       for (int j = 0; j < node->numNodes; j++) {
 7321:          Node* nbNode = node->nodes[j];
 7322:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7323:       }
 7324: 
 7325:    }
 7326:    
 7327: }
 7328: 
 7329: __global__ void returnX(double *res) {
 7330:    // Debugging: returns the matrix as a CuPy array
 7331: 
 7332:    const int size = mesh->np;
 7333:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7334:       const Node *node = mesh->localNodeData + idx_node;
 7335: 
 7336:       res[idx_node] = node->mX;
 7337: 
 7338:    }
 7339:    
 7340: }
 7341: 
 7342: 
 7343: __global__ void returnB(double *res) {
 7344:    // Debugging: returns the matrix as a CuPy array
 7345: 
 7346:    const int size = mesh->np;
 7347:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7348:       const Node *node = mesh->localNodeData + idx_node;
 7349: 
 7350:       res[idx_node] = node->qel;
 7351: 
 7352:    }
 7353:    
 7354: }
 7355: 
 7356: 
 7357: __global__ void computeMatrixProductAndDotProducts() {
 7358:    // Computes A*p, r'Mr and p'Ap
 7359: 
 7360:    // 1) shared buffer: first half for rMr, second for pAp
 7361:    __shared__ double sdata[2*BLOCK_SIZE];
 7362:    double* s_rMr = sdata;
 7363:    double* s_pAp = sdata + BLOCK_SIZE;
 7364: 
 7365:    const int tid = threadIdx.x;
 7366: 
 7367:    double l_pAp = 0.0;
 7368: 
 7369:    s_rMr[tid] = 0.0;
 7370:    s_pAp[tid] = 0.0;
 7371: 
 7372:    // 2) get your node pointer
 7373:    // NODE(node);   
 7374:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7375:    Node *node = &(mesh->localNodeData[idx_node]); 
 7376:       if (idx_node < mesh->np) {
 7377: 
 7378:       const double diag = node->coeffDiag;
 7379:       const double r    = node->mR;
 7380:       const double p    = node->mP;  
 7381: 
 7382:       // apply preconditioner on the fly:
 7383:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7384: 
 7385:       // 4) compute Ap = A.p
 7386:       double Ap = node->coeffDiag * node->mP;
 7387:       for (int j = 0; j < node->numNodes; ++j) {
 7388:          const Node *nbNode = node->nodes[j];
 7389:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7390: 
 7391:       }
 7392: 
 7393:       node->mAp = Ap;
 7394:       
 7395: 
 7396:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7397:       // const double l_rMr = r*Mr;  // r'Mr
 7398:       l_pAp = p*Ap;  // p'Ap
 7399: 
 7400: 
 7401:    }
 7402: 
 7403:    // 6) write into shared mem
 7404:    // s_rMr[tid] = l_rMr;
 7405:    s_pAp[tid] = l_pAp;
 7406: 
 7407:    __syncthreads();
 7408: 
 7409:    // 7) block-wide tree reduction
 7410:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7411:       if (tid < stride)  {
 7412:          s_pAp[tid] += s_pAp[tid + stride];
 7413:       }
 7414:       __syncthreads();
 7415:    }
 7416: 
 7417:    // 8) thread 0 atomically accumulates into the globals
 7418:    // XXX: This is slower than it needs to be, but it is simple and works
 7419:    if (tid == 0) {
 7420:       atomicAdd(pAp, s_pAp[0]);
 7421:    }
 7422: 
 7423: 
 7424: }
 7425: 
 7426: 
 7427: __global__ void updateSolutionAndDotProducts(void) {
 7428:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7429: 
 7430:    const int tid = threadIdx.x;
 7431: 
 7432:    s_rMr[tid] = 0.0;
 7433: 
 7434:    // get node & bounds-check:
 7435:    NODE(node);
 7436: 
 7437:    
 7438:    // Compute alpha
 7439:    const double alpha = (*rMr_old)/(*pAp); 
 7440: 
 7441: 
 7442:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7443: 
 7444: 
 7445:    // load scalars
 7446:    const double diag = node->coeffDiag;
 7447:    const double p    = node->mP;
 7448:    const double Ap   = node->mAp;
 7449:    const double x    = node->mX;
 7450:    const double r    = node->mR;
 7451:    
 7452:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7453: 
 7454:    // 1) update solution & residual
 7455:    const double x_new = x + alpha*p;
 7456:    const double r_new = r - alpha*Ap;
 7457:    node->mX = x_new;
 7458:    node->mR = r_new;
 7459: 
 7460:    // 2) apply Jacobi preconditioner on the fly
 7461:    const double Mr_new = r_new/diag;
 7462: 
 7463: 
 7464:    // 3) local contributions for the two dot-products
 7465:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7466: 
 7467:    // 4) write into shared-mem
 7468:    s_rMr[tid] = l_rMr;
 7469: 
 7470:    __syncthreads();
 7471: 
 7472: 
 7473:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7474:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7475:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7476:       __syncthreads();
 7477:    }
 7478: 
 7479:    // 6) thread 0 atomically folds into the global accumulators
 7480:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7481: 
 7482: 
 7483: }
 7484: 
 7485: 
 7486: __global__ void updateSearchDirection() {
 7487: 
 7488:     NODE(node);
 7489: 
 7490:     // recompute z on-the-fly
 7491:     const double z = node->mR / node->coeffDiag;
 7492:     const double p = node->mP;
 7493: 
 7494:     const double beta = (*rMr_new)/(*rMr_old);
 7495: 
 7496: 
 7497:     // p =z + beta*p
 7498:     node->mP = z + beta*p;
 7499: 
 7500: }
 7501: 
 7502: __global__ void initializeScalars(double *scalars) {
 7503: 
 7504:    // These point to a cupy array in the host code
 7505:    rMr_old = scalars + 0;
 7506:    rMr_new = scalars + 1;
 7507:    pAp     = scalars + 2;
 7508: }
 7509: 
 7510: __global__ void initializePreconditionedResidual(void) {
 7511: 
 7512:     __shared__ double s_rMr[BLOCK_SIZE];  
 7513: 
 7514:     s_rMr[threadIdx.x] = 0.0;
 7515: 
 7516:     NODE_ALL(node, valid);
 7517:     const int tid = threadIdx.x;
 7518:     // For the first iteration:
 7519:     // 1. Initial solution x = 0 (already set)
 7520:     // 2. Initial residual r = b (stored in qel)
 7521:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7522: 
 7523: // XXX we should use the guess solution here    
 7524: 
 7525:     double l_rMr = 0.0;
 7526:     if (valid) {
 7527:       // Set initial residual r = b (from qel)
 7528:       node->mR = node->qel;
 7529: 
 7530:       // Compute z = M^-1 * r (preconditioned residual)
 7531:       const double z = node->mR / node->coeffDiag;
 7532: 
 7533:       // Set initial search direction p = z
 7534:       node->mP = z;
 7535: 
 7536:       // Initialize other variables needed for CG
 7537:       node->mX = 0.0;  // Initial solution
 7538:       node->mAp = 0.0; // Will be computed in first iteration
 7539: 
 7540: 
 7541:       // Computes the first r'Mr (reduction)
 7542:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7543:     }
 7544:     // 4) write into shared-mem
 7545:     s_rMr[tid] = l_rMr;
 7546: 
 7547:     __syncthreads();
 7548: 
 7549: 
 7550:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7551:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7552:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7553:         __syncthreads();
 7554:     }
 7555: 
 7556:     // 6) thread 0 atomically folds into the global accumulators
 7557:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7558: 
 7559:     *rMr_old = 0.0;
 7560:     *pAp = 0.0;
 7561: }
 7562: 
 7563: 
