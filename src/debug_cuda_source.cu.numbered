 3195: 
 3196: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3197:    if constexpr(ics == 1) {
 3198:       return center;
 3199: 
 3200:    } else {
 3201:       const Point2 p0 = n1->outputCoords();
 3202:       const Point2 p1 = n2->outputCoords();
 3203:       return (1.0/2.0)*(p0 + p1);
 3204: 
 3205:    }
 3206: }
 3207: 
 3208: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3209: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3210: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3211: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3212: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3213: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3214: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3215: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3216: // Computes the gradient of the field at the side center.
 3217:    Vector2 grad = {0.0, 0.0};
 3218:    int count = 0;
 3219: 
 3220:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3221:    // as the average of the gradients at each element.
 3222:    // First element
 3223:    if (elems[0] != nullptr && condition(elems[0])) {
 3224:       Vector2 elemGrad = elems[0]->grad2(field);
 3225: 
 3226:       // For ics=2, projects the element gradient from its frame to the side frame
 3227:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3228: 
 3229:       grad += elemGrad;
 3230: 
 3231:       count++;
 3232:    }
 3233: 
 3234:    // Second element
 3235:    if (elems[1] != nullptr && condition(elems[1])) {
 3236: 
 3237:       Vector2 elemGrad = elems[1]->grad2(field);
 3238: 
 3239:       // For ics=2, projects the element gradient from its frame to the side frame
 3240:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3241: 
 3242:       grad += elemGrad;
 3243: 
 3244:       count++;
 3245:    }
 3246: 
 3247:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3248:    if (count > 0) {
 3249:       grad = grad*(1.0/count);
 3250:    }
 3251:    
 3252:    return grad;
 3253: }
 3254: 
 3255: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3256: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3257: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3258: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3259: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3260: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3261: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3262: 
 3263: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3264: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3265: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3266: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3267: 
 3268: 
 3269: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3270: 
 3271: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3272:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3273:    if constexpr(ics == 1) { 
 3274:       return 0.5*(n1->tau + n2->tau);
 3275: 
 3276:    } else {
 3277:       // Project the tau from the node frames to the side frame
 3278:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3279:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3280: 
 3281:       return 0.5*(stau1 + stau2);
 3282:    }
 3283: }
 3284: 
 3285: /**
 3286:  * This method performs backtracking from the side center until a time -dt back in time 
 3287:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3288:  * intermediate point.
 3289:  *
 3290:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3291:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3292:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3293:  * remaining time.
 3294:  * 
 3295:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3296:  * 
 3297:  * @param uuint, vvint, wwint: Velocities at the final point
 3298:  * @param jlev: Level at which the backtracking is performed
 3299:  * @param dt, dtbk: Tracking timesteps
 3300:   */
 3301: __inline__ __device__ void Side::btrack(
 3302:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3303:       double dt,            // Tracking time
 3304:       double dtbk,          // Tracking timestep
 3305:       Vector3 &u_int        // Velocities at the initial point
 3306: ) const {
 3307: 
 3308:    // Start from side center
 3309:    Point3 x0;
 3310: 
 3311:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3312:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3313: 
 3314:  
 3315:    double time_rm = dt; // Remaining time
 3316:    double time_rm_1 = 1e10;
 3317:    double time_rm_2 = 2e10;
 3318:    double time_rm_3 = 3e10;
 3319: 
 3320: 
 3321:    // Initial velocities
 3322:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3323: 
 3324:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3325:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3326: 
 3327:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3328: 
 3329: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3330: 
 3331: 
 3332:    constexpr int MAX_ITERATIONS = 100; 
 3333:    int iter = 0;
 3334:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3335:    while(true) {
 3336: 
 3337:       // Calculate timestep
 3338:       const double dtb = min(dtbk, time_rm);
 3339: 
 3340: // if (iter >= 38) printf("AAAAA iter = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, curElem->idx, x0.x, x0.y, x0.z, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3341: 
 3342:       // Next point in the backtracking curve
 3343:       xt = x0 - dtb*u_int;
 3344: // if (jlev == 48 && idx == 1603507)   showPoints(x0, xt, jlev, this, 0xFFFF00u, 'x', 1, 0, 0);
 3345: // // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3346: // // if ((jlev==45)) printf("jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3347: // if ((jlev==45))
 3348: // {
 3349: // // const Point3 p1 = toLocalFrame(x0);
 3350: // // const Point3 p2 = toLocalFrame(xt);
 3351: // // printf("jlev = %d, iter = %d, p1 = (%.17f, %.17f, %.17f), p2 = (%.17f, %.17f, %.17f)\n", jlev, iter, p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
 3352: // showPoints(x0, xt, jlev, this, 0x0000FFu, 'o', 1, 0, 0); 
 3353:     
 3354: // }
 3355: 
 3356:       double t, s; // parameters for the line segments p0pt and p1p2
 3357:       Side *lastCrossSide = nullptr;
 3358:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3359: 
 3360: 
 3361: // if (iter >= 38) printf("BBBBB idx = %d, jlev = %d, lastCrossSide->idx = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), iter = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", idx, jlev, lastCrossSide->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, iter, curElem->idx, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3362: 
 3363:       if (time_rm_3 <= time_rm) {
 3364:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3365:          xt = x0;
 3366:          break;
 3367:       }
 3368: 
 3369: 
 3370:       if (!found) {
 3371:       // This means that the walk reached a boundary or a dry element.
 3372: 
 3373:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3374: 
 3375:          // Finds the point at the boundary where the line segment x0xt intersects.
 3376:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3377:          // due to floating point errors, it does not exactly intersect.
 3378:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3379:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3380:          // To compute the intersection point we start with the parametric equations.
 3381:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3382:          // We cross-prouct by v1 to cancel the s term:
 3383:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3384:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3385: 
 3386:          // Side coordinates in the origSide frame.
 3387:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3388:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3389: 
 3390:          Point2  p0 = {x0.x, x0.y};
 3391:          Point2  pt = {xt.x, xt.y};
 3392: 
 3393:          const Vector2 v1 = pt - p0;
 3394:          const Vector2 v2 = p2 - p1;
 3395: 
 3396: 
 3397: 
 3398:          // We are assuming intersection, so we clamp t to the range [0,1].
 3399:          const double denom = cross(v2, v1);
 3400:          
 3401: 
 3402: 
 3403: 
 3404:          if (abs(denom) < small) {
 3405:             // small denominators are fairly common. They occur when the line segment x0xt 
 3406:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3407:             // boundary, where the backtracking curve startt sliding along the boundary.
 3408:             // In this case, we simply assume that the two lines are very close to each other
 3409:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3410:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3411:             if (t<0.0000000001) t = 0.0;
 3412:             if (t>0.9999999999) t = 1.0;
 3413: 
 3414:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3415:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3416: 
 3417:          }
 3418:          else {
 3419:             
 3420:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3421:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3422:             if (t>0.9999999999) t = 1.0;
 3423:             // From the originaL equation we can solve for s:
 3424:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3425:             // Computing the dot product by v1, we get:
 3426:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3427:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3428:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3429: 
 3430:          }
 3431: 
 3432:          
 3433:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3434:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3435: 
 3436: 
 3437: 
 3438:          // We update the new target point to be right at the intersection point,
 3439:          // and the remaining time must include the time we haven't "used".
 3440:          time_rm -= s*dtb;
 3441:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3442: 
 3443: // Point3 xct = {curElem->center.x, curElem->center.y, curElem->centerZ()};
 3444: // xct = toLocalFrame(xct);
 3445: // xt = (1-0.00001)*xt + 0.00001*xct;
 3446:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3447:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3448: 
 3449:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3450:          // but extracting only the component along the tangent vector v2.
 3451:          Vector2 tangent = normalize(v2);
 3452:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3453: 
 3454:          const Vector2 u2D = make_double2(u.x, u.y);
 3455:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3456: 
 3457: 
 3458:       } else {
 3459: 
 3460:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3461: 
 3462:          time_rm -= dtb; 
 3463: 
 3464:          u_int = curElem->interpolateVelocities(xt, this);
 3465: 
 3466:       }
 3467: 
 3468:       if (time_rm <= 0.0) break; 
 3469: 
 3470:       // If the velocity is too small, we stop the backtracking
 3471:       const double vmag2 = norm2(toVector2(u_int));
 3472:       if (vmag2 <= velmin_btrack_sq)  {
 3473: 
 3474:          time_rm = 0.0; 
 3475:          return; 
 3476:       }
 3477: 
 3478:       // The current point becomes the next segment's starting point.
 3479:       x0 = xt;
 3480:  
 3481:       iter++;
 3482: 
 3483: 
 3484:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3485: 
 3486:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3487:       time_rm_3 = time_rm_2;
 3488:       time_rm_2 = time_rm_1;
 3489:       time_rm_1 = time_rm;
 3490:    }
 3491: 
 3492:    assert(curElem != nullptr && "Final element is nullptr");
 3493:    assert(!curElem->isDry && "Final element is dry");
 3494:    
 3495: 
 3496: 
 3497:    // Interpolate the velocities at the final point with respect to the current side frame
 3498:    u_int = curElem->interpolateVelocities(xt, this);
 3499: 
 3500: 
 3501: }
 3502: 
 3503: 
 3504: 
 3505: 
 3506: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3507: 
 3508: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3509: 
 3510:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3511:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3512: 
 3513:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3514:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3515: 
 3516:    double fun_lat = 0.0;
 3517:    switch (jspc[idxComp]) {
 3518:       case 0:
 3519:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3520:          break;
 3521:       case 1:
 3522:          fun_lat = sin(2.0*lat);
 3523:          break;
 3524:       case 2:
 3525:          fun_lat = pow<2>(cos(lat));
 3526:          break;
 3527:       default:
 3528:          assert(false && "computeETP: invalid jspc");
 3529:    }
 3530:    
 3531:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3532: 
 3533: }
 3534: 
 3535: 
 3536: __device__ void Node::updateKb(void) {
 3537: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3538: 
 3539:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3540: 
 3541: 
 3542:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3543: 
 3544:    if constexpr(ivcor == 2) {  // SZ coordinates
 3545:       
 3546:       // Compute bottom level index
 3547:       if (depth <= mesh->h_s) {
 3548:          kb = izlev;   
 3549:          
 3550:       } else {
 3551:          kb = -1;
 3552:          int L = 0;
 3553:          int R = nzlev; 
 3554:          
 3555:          while (L <= R) {
 3556:             int M = (R + L) / 2;
 3557: 
 3558: 
 3559:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3560:             
 3561:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3562:                R = M;
 3563:             } else {
 3564:                L = M;
 3565:             }
 3566: 
 3567:             if (R - L == 1) {
 3568:                kb = L;
 3569:                break;
 3570:             }
 3571:          }
 3572: 
 3573:          // Checks that the binary search was successful
 3574:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3575:        
 3576:       }
 3577:    } 
 3578: }
 3579: 
 3580: 
 3581: __device__ __inline__ void Node::updateZCoordData(void) {
 3582: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3583: 
 3584:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3585:    // if (isDry2()) {
 3586:    //    kb = -1;  // XXXXXXXX KKKKK
 3587:    //    return;
 3588:    // }
 3589: 
 3590: 
 3591:    if constexpr(ivcor == 2) {  // SZ coordinates
 3592:       
 3593:       // Compute bottom level index
 3594:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3595:    } 
 3596:    else {  // if (ivcor == 1) Localized sigma
 3597:       // Do nothing
 3598:    }
 3599: 
 3600: 
 3601: }
 3602: 
 3603: 
 3604: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3605:    // Computes the z coordinate at level k.
 3606:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3607:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3608:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3609:    // used 
 3610: 
 3611:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3612:    
 3613:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3614: 
 3615:    if (isDry2()) return 0.0;  
 3616: 
 3617:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3618: 
 3619:    if constexpr(ivcor == 2) {
 3620: 
 3621:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3622:       const double h_c = mesh->h_c;
 3623:       const double theta_f = mesh->theta_f;
 3624:       const double sinh_theta_f = mesh->sinh_theta_f;
 3625: 
 3626: 
 3627:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3628:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3629:       // once per time step/node. XXXX
 3630:       // CHECK: updateZCoordData
 3631: 
 3632:       //  To simplify comparisons, I define index versions of count variables.
 3633:       if      (k == ivrt)     return eta2; 
 3634:       else if (k == izlev)    return -hmod2;
 3635:       else if (k == kb)       return -depth;
 3636:       else if (k < izlev)     return mesh->ztot[k];
 3637:       else if (k > izlev) {
 3638:          const int ksig = k - izlev;
 3639: 
 3640:          if (hmod2 <= h_c) {
 3641:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3642: 
 3643:          } 
 3644:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3645:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3646:             assert(false && "compZCoord: invalid h_c\n");
 3647:          } 
 3648:          else {
 3649:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3650:                    h_c * mesh->sigma[ksig] + 
 3651:                    (hmod2 - h_c) * mesh->cs[ksig];
 3652:          }
 3653:       } else { 
 3654:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3655:       }
 3656: 
 3657:    }
 3658:    else {  // if constexpr(ivcor == 1)
 3659:       if (k <= kb)        return -depth; 
 3660:       else if (k == ivrt) return eta2;
 3661:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3662: 
 3663:    }
 3664:    
 3665:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3666:    return 0.0;
 3667: }
 3668: 
 3669: 
 3670: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3671:    // Computes the bottom drag Cd based on the selected nchi
 3672: 
 3673:    if constexpr(nchi == 0) {
 3674:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3675:       Cd = drag;  // Read from drag file
 3676: 
 3677:    } else if constexpr(nchi == 1) {
 3678:       // 
 3679: 
 3680:       bool ltmp = false; // for WBL iteration
 3681: 
 3682:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3683:       if (isDry || (rough == 0.0)) {
 3684:          Cd = 0.0;
 3685: 
 3686:       } else { //roughness >0 
 3687:          
 3688:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3689: 
 3690:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3691: 
 3692:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3693: 
 3694:       } // if rough
 3695: 
 3696:    } else if constexpr(nchi == -1) {
 3697:    // Manning 
 3698:  
 3699:       const double htot = max(hmin_man, htot2()); 
 3700:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3701: 
 3702:    } else {
 3703:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3704:       
 3705:    } // if nchi
 3706: 
 3707: }
 3708: 
 3709: 
 3710: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3711:    // Checks if a side in on the boundary
 3712:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3713: 
 3714:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3715:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3716: 
 3717:    // Indices of the nodes that form the side
 3718:    //
 3719:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3720:    const int n1 = side.n1->idx;
 3721:    const int n2 = side.n2->idx;
 3722:    isLand = false;
 3723:    
 3724: 
 3725:    // Check if the side is on a land boundary
 3726:    for (int i = 0; i < nland; i++) {
 3727:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3728:          // Consecutive nodes in the land boundary segment
 3729:          const int b1 = ilnd[i + j*nland];
 3730:          const int b2 = ilnd[i + (j + 1)*nland];
 3731: 
 3732:          assert(b1 != -1 && b2 != -1);
 3733: 
 3734:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3735:             
 3736:             isLand = true;
 3737:             return i;
 3738:          }
 3739:       }
 3740:    }
 3741: 
 3742:    // Check if the side is on an open boundary
 3743:    for (int i = 0; i < nope; i++) {
 3744:       for (int j = 0; j < nond[i] - 1; j++) {
 3745:          // Consecutive nodes in the open boundary segment
 3746:          const int b1 = iond[i + j*nope];
 3747:          const int b2 = iond[i + (j + 1)*nope];
 3748: 
 3749:          assert(b1 != -1 && b2 != -1);
 3750: 
 3751:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3752:             isLand = false;
 3753:             return i;
 3754:          }
 3755:       }
 3756:    }
 3757: 
 3758:    return -1;
 3759: }
 3760: 
 3761: 
 3762: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3763:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3764:                                     double *wind_rotate_angle, 
 3765:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3766:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3767:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3768:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3769:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3770: 
 3771:    NODE(pnode);  
 3772:    const int i = idx_node;
 3773:    Node &node(*pnode);
 3774: 
 3775:    node.idx = i;
 3776: 
 3777:    const int idxNodeStart = nodeNeighNodesStart[i];
 3778:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3779:    node.numNodes = idxNodeEnd - idxNodeStart;
 3780:    node.nodes = nodeNeighNodes + idxNodeStart;
 3781:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3782: 
 3783: 
 3784: 
 3785:    const int idxElemStart = nodeNeighElemsStart[i];
 3786:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3787:    node.numElements = idxElemEnd - idxElemStart;
 3788:    node.elements = nodeNeighElems + idxElemStart;
 3789: 
 3790: 
 3791:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3792:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3793:       const int partNode = localNodePart[idxNodeGlobal]; 
 3794:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3795: 
 3796:       Node *node_ptr = nodes[partNode] + idxNode;
 3797:       
 3798:       nodeNeighNodes[idx] = node_ptr;
 3799:    }
 3800: 
 3801: 
 3802:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3803:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3804:       const int partElem = localElemPart[idxElemGlobal];
 3805:       const int idxElem  = localElemIndices[idxElemGlobal];
 3806: 
 3807:       Element *elem_ptr = elems[partElem] + idxElem;
 3808: 
 3809:       nodeNeighElems[idx] = elem_ptr;
 3810:    }      
 3811: 
 3812:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3813:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3814: 
 3815:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3816: 
 3817:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3818:    if constexpr(ics == 1) {
 3819:       node.p.x   = node_coords[i * 3];
 3820:       node.p.y   = node_coords[i * 3 + 1];
 3821:       node.gz = 0.0;
 3822: 
 3823:       if (use_ll) {                                    // <-- add
 3824:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3825:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3826:       }  
 3827: 
 3828:    } else {
 3829:       const double lon = deg2rad*node_coords[i * 3];
 3830:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3831: 
 3832:       Point3 p = computeXYZfromLatLon(lat, lon);
 3833:       node.p = toVector2(p);
 3834:       node.gz = p.z;
 3835:       node.lon = lon;
 3836:       node.lat = lat;
 3837: 
 3838:       #ifdef USE_FRAMES
 3839:       node.setFrame(lat, lon);
 3840:       #endif
 3841: 
 3842: 
 3843:    }
 3844: 
 3845:    node.depth = node_coords[i * 3 + 2];
 3846: 
 3847:    node.numSides = 0;
 3848: 
 3849:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3850:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3851:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3852:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3853:    else assert(false && "populateNodes: selected nchi not implemented.");
 3854:    
 3855:    if constexpr(ivcor == 1) 
 3856:    {  
 3857:       node.kb = kb[i];
 3858: 
 3859:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3860:    }
 3861: 
 3862:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3863:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3864:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3865: 
 3866:    
 3867:    // Links the node to the boundary information
 3868:    if (isbnd[i] >= 0) {
 3869:      
 3870:       // Get the index of the node boundary
 3871:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3872: 
 3873:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3874:       node.nodeBnd->node = &node;
 3875: 
 3876:       node.nodeBnd->sideBnd1 = nullptr;
 3877:       node.nodeBnd->sideBnd2 = nullptr;
 3878: 
 3879:       if (isbnd[i]>=0) {
 3880: 
 3881:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3882:          
 3883:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3884:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3885: 
 3886:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3887:          node.nodeBnd->segment->clen  = nan("1");
 3888:          node.nodeBnd->segment->carea = nan("1");
 3889: 
 3890:       }
 3891:    } else {
 3892: 
 3893:       node.nodeBnd = nullptr; // For internal nodes
 3894: 
 3895:       if (isbnd[i] == landSegment) {
 3896:          node.nodeBnd = &landBoundaryNode;
 3897:          node.nodeBnd->segment = &landBoundarySegment;
 3898:       }
 3899:       
 3900:    }
 3901:    
 3902:    // XXXX GAUSSIAN HILL VELOCITIES
 3903:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3904:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3905:          constexpr double rot_per = 3000.0;
 3906:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3907:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3908:       // XXXXX
 3909:    #endif
 3910: 
 3911: }
 3912: 
 3913: 
 3914: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3915:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3916:                                     double *wind_rotate_angle,   
 3917:                                     int *isdel, int *isidenode, int *isbnd,
 3918:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3919:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3920:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3921:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3922:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3923:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3924:                                     double *drag, double *roughness) {
 3925: 
 3926: 
 3927:    SIDE(pside);
 3928:    Side &side(*pside);
 3929:    const int i = idx_side;
 3930: 
 3931:    side.idx = i;  
 3932:    
 3933:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3934:    const double fc   = 2.0*omega_e*sin(sfea0);
 3935:    const double beta = 2.0*omega_e*cos(sfea0);
 3936: 
 3937:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3938: 
 3939:    // finding the pointer to the nodes that form the side
 3940:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3941:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3942: 
 3943:    const int locidx_n1 = localNodeIndices[idx_n1];
 3944:    const int locidx_n2 = localNodeIndices[idx_n2];
 3945:    const int part_n1 =   localNodePart[idx_n1];
 3946:    const int part_n2 =   localNodePart[idx_n2];
 3947: 
 3948:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3949:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3950: 
 3951: 
 3952:    // Counts the number of sides connected to each node
 3953:    side.n1->numSides++;
 3954:    side.n2->numSides++;
 3955: 
 3956:    // Side boundary type
 3957:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3958:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3959: 
 3960:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3961:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3962:    {
 3963:       bool isLand = false;
 3964:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3965:       
 3966:       if (isbs > -1) {
 3967:          // assert(isLand || isbs>=0);
 3968:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3969: 
 3970:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3971: 
 3972:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3973:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3974: 
 3975:          assert (isLand == side.sideBnd->segment->isLand);
 3976: 
 3977:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3978:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3979:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3980: 
 3981:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3982:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3983:          
 3984:          side.sideBnd->side = &side;
 3985: 
 3986:       }
 3987:       else {
 3988:          side.sideBnd = nullptr;
 3989:       }
 3990:    }
 3991:    else 
 3992:    {
 3993:       side.sideBnd = nullptr;
 3994:    }
 3995: 
 3996: 
 3997:    // finding the pointer to the elements that share the side
 3998:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3999:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4000: 
 4001:    if (idx_e1 > -1) {
 4002:       const int locidx_e1 = localElemIndices[idx_e1];
 4003:       const int part_e1 =  localElemPart[idx_e1];
 4004:       side.elems[0] = elems[part_e1] + locidx_e1;
 4005: 
 4006:    }
 4007:    else {
 4008:       side.elems[0] = nullptr;
 4009:    }
 4010: 
 4011:    if (idx_e2 > -1) {
 4012:       const int locidx_e2 = localElemIndices[idx_e2];
 4013:       const int part_e2 =  localElemPart[idx_e2];
 4014:       side.elems[1] = elems[part_e2] + locidx_e2;
 4015:    }
 4016:    else {
 4017:       side.elems[1] = nullptr;
 4018:    }
 4019:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4020:       
 4021:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4022:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4023:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4024:          
 4025:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4026:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4027:       // printf("sideBnd: %p\n", side.sideBnd);
 4028:       // assert(false && "Side has no elements and no boundary");
 4029:    }
 4030:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4031: 
 4032:    // Compute the center of the side
 4033:    side.center = 0.5*(side.n1->p + side.n2->p);
 4034: 
 4035:    #ifdef USE_FRAMES
 4036:    side.setFrame();
 4037:    #endif
 4038: 
 4039:    // Normal, unitary vector to the side
 4040:    if constexpr(ics == 1) {
 4041:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4042:       side.n = normalize(side.n);
 4043:    }
 4044:    else {
 4045:       // Unit side vector in 3D cartesian coordinates
 4046:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4047: 
 4048:       nSide = normalize(nSide);
 4049: 
 4050:       // Its cross product with the unit local z-axis vector (nUp) is the
 4051:       // normal vector we are looking for.
 4052:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4053: 
 4054:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4055:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4056:       side.n = -normalize(n2D); 
 4057: 
 4058:    }
 4059: 
 4060:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4061:    side.shapiro = shapiro0;
 4062: 
 4063:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4064:    // XXXX
 4065:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4066:    constexpr double rot_per=3000.0;
 4067:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4068:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4069:    // XXXXX      
 4070:    #endif
 4071:    // Compute the z level at the center of the side
 4072:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4073:    
 4074:    // Compute the length of the side
 4075:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4076: 
 4077: 
 4078:    // Compute the Coriolis coefficient
 4079: 
 4080:    if constexpr(ncor == -1 || ncor == 0) {
 4081:       side.coriolis = coricoef;
 4082:    }
 4083:    else {
 4084:       const double sphi = side.lat();  // Latitude at the center of the side
 4085: 
 4086:       assert(use_ll && "use_ll must be true when ncor > 0");
 4087: 
 4088:       if constexpr(ics == 1) {
 4089:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4090:       }
 4091:       else { // ics == 2
 4092:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4093:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4094:       }
 4095: 
 4096:    }
 4097: 
 4098: }
 4099: 
 4100: 
 4101: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4102:    double *node_coords, double *node_coords_ll, bool use_ll,
 4103:    double *wind_rotate_angle,   
 4104:    int *isdel, int *isidenode, int *isbnd,
 4105:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4106:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4107:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4108:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4109:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4110:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4111:    double *drag, double *roughness) {
 4112: 
 4113:    ELEM(pelem);
 4114:    Element &elem(*pelem);
 4115:    const int i = idx_elem;
 4116: 
 4117:    elem.idx = i;
 4118: 
 4119:    for (int j = 0; j < i34[i]; j++) {
 4120:       const int idxNode = elnode[i*4 + j];  
 4121:       const int idxSide = elside[i*4 + j];
 4122:       
 4123:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4124:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4125: 
 4126:       // Find the neighboring element  
 4127:       if (elem.sides[j]->elems[0] == &elem) {
 4128:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4129:       }
 4130:       else {
 4131:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4132:       }
 4133:       
 4134:    }
 4135: 
 4136:    elem.i34 = i34[i];
 4137: 
 4138:    // Compute the barycenter of the element and its depth
 4139:    elem.center = {0.0, 0.0};
 4140:    elem.depth = 1e10;
 4141:    for (int j = 0; j < i34[i]; j++) {
 4142: 
 4143:       elem.center += elem.nodes[j]->p/i34[i];
 4144:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4145:    }
 4146: 
 4147:    #ifdef USE_FRAMES
 4148:    elem.setFrame();
 4149:    #endif
 4150: 
 4151:    elem.area = elem.computeSignedArea(); 
 4152:    elem.radius = sqrt(elem.area)/pi; 
 4153:    
 4154:    // Determines which way the normal vector to each side is oriented.
 4155:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4156:    for (int j = 0; j < i34[i]; j++)  
 4157:    {
 4158:       if (elem.sides[j]->elems[0] == &elem) {
 4159:          elem.ssign[j] =  1.0;
 4160:       }
 4161:       else {
 4162:          elem.ssign[j] = -1.0;
 4163:       }
 4164: 
 4165:    }
 4166: 
 4167:   
 4168: 
 4169:    // Derivatives of shape functions
 4170:    //  For ics=2, this is done in the element frame
 4171:    //  For quads, the derivative is evaluated at centroid
 4172:    for (int j = 0; j < elem.i34; j++) {
 4173:       const double area = elem.area;
 4174:       const int id2 = elem.nxq(1 + j);
 4175:       const int id3 = elem.nxq(2 + j);
 4176:       const int id4 = elem.nxq(3 + j);
 4177:       if (elem.isTri()) {
 4178:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4179:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4180:          // da1/dx = (y1 - y2)/(2*area)
 4181: 
 4182:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4183:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4184:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4185: 
 4186:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4187:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4188: 
 4189:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4190: 
 4191:       }
 4192:       else  { // Quad; evaluate at centroid
 4193: 
 4194:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4195:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4196:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4197: 
 4198:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4199:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4200: 
 4201:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4202:       } // if Tri
 4203: 
 4204:    } // for j   
 4205:    
 4206:    
 4207: 
 4208: }
 4209: 
 4210: 
 4211: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4212:                                             double *emo, double *efa, 
 4213:                                             double *umo, double *ufa, 
 4214:                                             double *vmo, double *vfa,
 4215:                                             int *ifltype, int *iettype) {
 4216: 
 4217:    NODE_BND(nodeBnd);
 4218:    const int idx = idx_node_bnd;    
 4219: 
 4220:    nodeBnd->idx = idx;
 4221: 
 4222:    // Need to find the segment index and the index of the node on the segment
 4223:    int idxNode = -1;
 4224:    int iseg, i;
 4225:    for (iseg = 0; iseg < nope; iseg++) {
 4226:       // for each segment...
 4227:       for (i = 0; i < nond[iseg]; i++) {
 4228:          idxNode = iond[iseg + i*nope];
 4229:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4230:          
 4231:       }
 4232:    }
 4233: 
 4234:    assert(iseg < nope && "iseg is out of bounds");
 4235: 
 4236: found: // Jumped here when the node was found
 4237: 
 4238:    nodeBnd->isEssentialBC = true;
 4239:    nodeBnd->elbc = 0.0;
 4240: 
 4241:    nodeBnd->segment->ifltype = ifltype[iseg];
 4242:    nodeBnd->segment->iettype = iettype[iseg];
 4243: 
 4244:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4245: 
 4246:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4247: 
 4248:       nodeBnd->efa[jfr] = efa[idx2];
 4249:       nodeBnd->emo[jfr] = emo[idx2];
 4250:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4251:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4252: 
 4253:    }
 4254:         
 4255: 
 4256: }
 4257: 
 4258: __device__ void Mesh::populateBoundarySideLinks(void) {
 4259: 
 4260:    SIDE_BND(sideBnd);
 4261: 
 4262:    const Side *side = sideBnd->side;
 4263: 
 4264:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4265:    // and the rightSide is the side s that has s->n1 == side->n2
 4266:    for (int i = 0; i < mesh->nbs; i++) {
 4267: 
 4268:       Side *s = &mesh->localSideData[i];
 4269: 
 4270:       if (s == side) continue;  // Do not link the side to itself
 4271:    
 4272:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4273:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4274:    }
 4275:    
 4276: }
 4277: 
 4278: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4279:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4280:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4281:                 int *isdel, int *isidenode, int *isbnd,
 4282:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4283:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4284:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4285:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4286:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4287:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4288:                 double *drag, double *roughness,
 4289:                 double *emo, double *efa, 
 4290:                 double *umo, double *ufa, 
 4291:                 double *vmo, double *vfa) {
 4292: 
 4293:    printf("Populating mesh for partition %d\n", partNum);
 4294: 
 4295:    // XXXXXX THIS function does almost nothing. 
 4296: 
 4297:    nbs = *sharedIdxSideBoundary + 1;
 4298:    nbp = *sharedIdxNodeBoundary + 1;
 4299: 
 4300:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4301: 
 4302: }
 4303: 
 4304: 
 4305: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4306:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4307:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4308: 
 4309: 
 4310:    NODE(node1);
 4311: 
 4312:    node1->clearMatrixRow();
 4313:    node1->qel = 0.0;
 4314: 
 4315:    // THIS IS FOR STRUCTURES XXX
 4316:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4317: 
 4318:    
 4319:    for (int j=0; j<node1->numElements; j++) {
 4320:       // For each element connected to the node...
 4321: 
 4322:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4323: 
 4324:       Element *elem = node1->elements[j];
 4325: 
 4326:       // Compute the average gravity
 4327:       const double grav3 = elem->mean(&Node::grav2);
 4328: 
 4329:       // Look at the documentation for the description of the terms in the following integrals
 4330: 
 4331:       // Integral I_1 
 4332:       // \bar{\breve{H}} 
 4333:       const double hhatb = elem->mean(&Side::hhat);        
 4334: 
 4335:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4336: 
 4337:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4338:       const double area = elem->area;
 4339: 
 4340:       // Integral I_4
 4341:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4342:       // Where
 4343:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4344: 
 4345:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4346:       // of U over the element.
 4347:       const Vector2 U = elem->mean(&Side::U);
 4348: 
 4349:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4350: 
 4351:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4352:       const double I_4_1 = dot(gradPhi_1, U);
 4353: 
 4354: 
 4355:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4356:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4357: 
 4358:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4359: 
 4360: 
 4361:       // Normal component of the bed velocity
 4362:       double ubedNormalComp = 0.0;
 4363:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4364:          Vector3 ubed = {0.0, 0.0, 0.0};
 4365:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4366:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4367: 
 4368:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4369:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4370:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4371: 
 4372:          // Computes the normal component of the bed velocity
 4373:          ubedNormalComp = dot(ubed, N);
 4374:       } // imm==2
 4375: 
 4376:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4377: 
 4378:       if (elem->isTri()) {
 4379: 
 4380:          // To clarify the notation in this section: 
 4381:          //   In formulas, we use the following notation:
 4382:          //       i stands for the node under consideration (node1)
 4383:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4384:          //   However, in the code, we use the following notation:
 4385:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4386:          const int id2 = elem->nxq(1 + id1);
 4387:          const int id3 = elem->nxq(2 + id1);
 4388:          Node *node2 = elem->nodes[id2];
 4389:          Node *node3 = elem->nodes[id3];
 4390: 
 4391:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4392: 
 4393:          // integral of phi_i*phi_j
 4394:          const double ipp_ii = (1.0/6.0 )*area;
 4395:          const double ipp_ij = (1.0/12.0)*area;
 4396:          const double ipp_ik = (1.0/12.0)*area;
 4397: 
 4398:          // integral of [(grad phi_i) * (grad phi_j)]
 4399:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4400:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4401:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4402: 
 4403:          // Computes the different components of integral I_1 of each node with respect to node i.
 4404:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4405:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4406:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4407: 
 4408:          node1->addToSparseMatrix(node1, I1_ii);
 4409:          node1->addToSparseMatrix(node2, I1_ij); 
 4410:          node1->addToSparseMatrix(node3, I1_ik);
 4411: 
 4412:          #pragma unroll
 4413:          for (int l=0; l<3; l++) {
 4414: 
 4415:             Node *node = elem->nodes[l];
 4416: 
 4417:             // Additional variation in eta due to bed deformation or vertical velocity
 4418:             double extraEta = 0.0;
 4419:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4420:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4421: 
 4422: 
 4423:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4424:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4425: 
 4426:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4427: 
 4428:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4429:            
 4430:          }
 4431: 
 4432: 
 4433:       }
 4434:       else { // Quad
 4435:          // To clarify the notation in this section: 
 4436:          //   In formulas, we use the following notation:
 4437:          //       i stands for the node under consideration (node1)
 4438:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4439:          //   However, in the code, we use the following notation:
 4440:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4441:          const int id2 = elem->nxq(1 + id1);
 4442:          const int id3 = elem->nxq(2 + id1);
 4443:          const int id4 = elem->nxq(3 + id1);
 4444:          Node *node2 = elem->nodes[id2];
 4445:          Node *node3 = elem->nodes[id3];
 4446:          Node *node4 = elem->nodes[id4];   
 4447:          
 4448:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4449: 
 4450:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4451:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4452:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4453:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4454:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4455: 
 4456:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4457:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4458:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4459:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4460:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4461: 
 4462: printf("node1->idx: %d, area: %.16f, ipp_ii: %.16f, ipp_ij: %.16f, ipp_ik: %.16f, ipp_il: %.16f\n igpgp_ii: %.16f, igpgp_ij: %.16f, igpgp_ik: %.16f, igpgp_il: %.16f\n", node1->idx, area, ipp_ii, ipp_ij, ipp_ik, ipp_il, igpgp_ii, igpgp_ij, igpgp_ik, igpgp_il);
 4463:          // Computes the different components of integral I_1 of each node with respect to node i.
 4464:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4465:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4466:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4467:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4468: 
 4469:          node1->addToSparseMatrix(node1, I1_ii);
 4470:          node1->addToSparseMatrix(node2, I1_ij); 
 4471:          node1->addToSparseMatrix(node3, I1_ik);
 4472:          node1->addToSparseMatrix(node4, I1_il);
 4473:   
 4474:          #pragma unroll
 4475:          for (int l=0; l<4; l++) {
 4476: 
 4477:             const Node *node = elem->nodes[l];
 4478: 
 4479:             // Additional variation in eta due to bed deformation or vertical velocity
 4480:             double extraEta = 0.0;
 4481:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4482:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4483: 
 4484:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4485:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4486:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4487: 
 4488:          }         
 4489:       } 
 4490: 
 4491: 
 4492:      node1->qel += (dt/elem->i34)*elem->vsource;
 4493:       
 4494: 
 4495:    } // for all elements connected to the node
 4496:    
 4497: 
 4498:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4499:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4500:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4501:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4502:       // If it is an open boundary node...
 4503: 
 4504:       // At least one open bnd side, maybe two
 4505:       for (int l=0; l<2; l++) { 
 4506: 
 4507:          // Gets each of the sides sharing the node. 
 4508:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4509: 
 4510:        
 4511: 
 4512:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4513:          if (sideBnd != nullptr) {
 4514:             // If the side is on a boundary...
 4515: 
 4516:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4517: 
 4518:             // Get the boundary segment
 4519:             const BoundarySegment *sideSegment = sideBnd->segment;
 4520:             const Side *side = sideBnd->side;
 4521: 
 4522:             // Integral I_3
 4523:             if (sideSegment->ifltype != 0) {
 4524:             // Natural or Flather b.c.
 4525: 
 4526:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4527:                // especially for Flather b.c.
 4528:                double ri3 = 0.0;
 4529:                if (!side->isDry) {
 4530:                   // If the side is not dry
 4531:                   
 4532:                   // Computes the side flux of (uth, vth)
 4533:                   double Vn = 0.0;
 4534:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4535:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4536:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4537: 
 4538:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4539:                   }
 4540: 
 4541:                   ri3 = 0.5*side->len*Vn;
 4542:                }
 4543: 
 4544:                if (sideSegment->ifltype == -1) { // Flather 1
 4545: 
 4546:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4547:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4548: 
 4549:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4550:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4551:                   
 4552:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4553:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4554: 
 4555:                } 
 4556:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4557:                   // Reset ri3
 4558:                   ri3 = 0.0;
 4559: 
 4560:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4561:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4562: 
 4563:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4564: 
 4565:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4566:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4567: 
 4568:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4569:                   node1->addToSparseMatrix(node1, con0*2.0);
 4570:                   node1->addToSparseMatrix(node2, con0);
 4571: 
 4572:                } // if Flather or Discharge
 4573: 
 4574:                node1->qel -= thetai*dt*ri3;  
 4575: 
 4576: 
 4577:             } // I_3
 4578:           
 4579: 
 4580:             // Integral I_5
 4581:             if(!side->isDry) {
 4582: 
 4583:                const double Unbar = dot(side->U, side->n);
 4584:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4585: 
 4586:             } // I_5
 4587: 
 4588:          } // if is boundary side
 4589: 
 4590:       } // for l
 4591: 
 4592:    } // if isbnd
 4593: 
 4594: 
 4595: }
 4596: 
 4597: 
 4598: 
 4599: extern "C" {
 4600:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4601:                                   int* indices, int* indptr) {
 4602: 
 4603:       NODE(node);
 4604:       
 4605:       const int idx = node->idx;
 4606:       
 4607:       // Computes the index in the nzz array      
 4608:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4609: 
 4610: 
 4611:       indptr[idx] = nzzIdx;
 4612:       indices[nzzIdx] = idx;
 4613: 
 4614:       data_d[nzzIdx]    = node->coeffDiag;
 4615: 
 4616:       b_d[idx] = node->qel;
 4617: 
 4618:       for (int k = 0; k < node->numNodes; ++k) {
 4619:          const Node* nb = node->nodes[k];
 4620: 
 4621:          const int j = nb->idx;
 4622: 
 4623:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4624: 
 4625:          indices[nzzIdx + k + 1] = j;
 4626:       }
 4627: 
 4628:  
 4629:    }
 4630: 
 4631: 
 4632: 
 4633:    __global__ void solverCopyResult(double* x) {
 4634:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4635:       NODE(node);
 4636:       const int idx = node->idx;
 4637: 
 4638:       node->mX = x[idx];
 4639:    }
 4640: 
 4641: 
 4642:    __global__ void rollUpElevation(void) {
 4643: 
 4644:       NODE(node);
 4645: 
 4646:       node->eta1 = node->eta2;
 4647: 
 4648:    }
 4649: 
 4650: 
 4651:    __global__ void backtrackAllNodes(void) {
 4652: 
 4653:       // max/min # of sub-divisions
 4654:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4655:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4656: 
 4657:       SIDE(side);
 4658: 
 4659:       const int kb = side->kb;
 4660: 
 4661: 
 4662:       // Initialize btrack velocities to the actual velocities at the side 
 4663:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4664:   
 4665:       if (side->isDry) return;
 4666:      
 4667: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4668: 
 4669:       // Checks that at least one element is not dry
 4670:       const Element *elem1 = side->elems[0];
 4671:       const Element *elem2 = side->elems[1];
 4672: 
 4673: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4674: 
 4675:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4676:       
 4677:       // XXXXXX
 4678:       // !swild_tmp to store global coord. of the starting side
 4679:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4680:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4681:       // !Use sframe2 
 4682:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4683: 
 4684: 
 4685:       for (int k = kb; k < nvrt; k++) {
 4686:       //  Initialize (xt,yt,zt), nnel and vel.
 4687:       //  For ics=2, the coordinates are all in the side's local frame
 4688:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4689: 
 4690:          const int iadvf = side->iadv();  // Advection flag   
 4691:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4692: 
 4693:          const double vmag2 = norm2(side->u2[k]);
 4694: 
 4695:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4696:             // No activity 
 4697: 
 4698:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4699: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4700: 
 4701:             
 4702:          } else {  // do btrack
 4703: 
 4704:             // Compute number of sub-divisions based on local gradients of the velocity field
 4705: 
 4706:             // XXX IS THIS NECESSARY?
 4707:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4708:             double suma = 0.0;
 4709:             int icount = 0;
 4710:             for (int l=0; l<2; l++) {
 4711:             // For each element sharing the side...
 4712: 
 4713:                const Element *elem = side->elems[l];
 4714:                  
 4715:                if (elem == nullptr) continue;
 4716: 
 4717:                icount++;
 4718: 
 4719:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4720:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4721:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4722: 
 4723:                double utmp[4];
 4724:                double vtmp[4];
 4725:                for (int j = 0; j < elem->i34; j++) {
 4726: 
 4727:                   const Node *node = elem->nodes[j];
 4728: 
 4729:                   if constexpr(ics==1) {
 4730:                      utmp[j] = node->u2[k].x;
 4731:                      vtmp[j] = node->u2[k].y;  
 4732: 
 4733:                   } else {
 4734:                      // 'Project' the velocity from the node frame to the element frame
 4735:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4736:                      utmp[j] = tmp_u2.x;
 4737:                      vtmp[j] = tmp_u2.y;
 4738: 
 4739:                   }
 4740:                } // for j
 4741: 
 4742:                const Vector2 grad_u = elem->grad2(utmp); 
 4743:                const Vector2 grad_v = elem->grad2(vtmp);
 4744:    
 4745:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4746:             } // for ii
 4747: 
 4748:             assert(icount > 0 && "Impossible 77");
 4749: 
 4750:             // '4' is somewhat arbitrary
 4751:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4752: 
 4753:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4754:             Vector3 u_int = {0.0, 0.0, 0.0};
 4755: 
 4756:             side->btrack(k, dt, dtbk, u_int);
 4757: 
 4758: 
 4759:             side->btu[k] = {u_int.x, u_int.y};
 4760:                
 4761:          } // if vmag (do backtrack)
 4762: 
 4763: 
 4764:       } // for k=kb,nvrt-1
 4765: 
 4766:    }
 4767: 
 4768: } // extern "C"
 4769: 
 4770: template<int nc>
 4771: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4772: 
 4773: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4774: //
 4775: // a,b,c,rhs: input vectors and are not modified by this program.
 4776: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4777: // rhs is the r.h.s.
 4778: // n: actual rank of the system.
 4779: // rows in u() and rhs();
 4780: // u: output with nc columns (transposed to rows)
 4781: // gam: a working array.
 4782: //
 4783: // NOTES:
 4784: // This is a template function that allows for different numbers of columns in the rhs vector.
 4785: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4786: 
 4787:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4788:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4789: 
 4790:    double bet = b[0];
 4791:    if constexpr (nc == 1) {
 4792:       u[0] = rhs[0]/bet;
 4793:    } else {
 4794:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4795:    }
 4796: 
 4797:    for (int j = 1; j < n; j++) {
 4798:       gam[j] = c[j - 1]/bet;
 4799:       bet = b[j] - a[j]*gam[j];
 4800: 
 4801:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4802: 
 4803:       if constexpr (nc == 1) {
 4804:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4805:       } else {
 4806:          for (int l = 0; l < nc; l++) {
 4807:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4808:          }
 4809:       }
 4810:    }
 4811: 
 4812:    // Back-substitution
 4813:    for (int j = n - 2; j >= 0; j--) {
 4814:       if constexpr (nc == 1) {
 4815:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4816:       } else {
 4817:          for (int l = 0; l < nc; l++) {
 4818:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4819:          }
 4820:       }
 4821:    }
 4822: }
 4823: 
 4824: 
 4825: 
 4826: // Helper function that contains the core algorithm
 4827: template<typename XAccessor, typename YAccessor>
 4828: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4829:                                     double  yp_top, double  yp_bot, 
 4830:                                     CubicSpline &spline) {
 4831:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4832:    // 
 4833:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4834:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4835:    //
 4836:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4837:    // 
 4838:    // Inputs: 
 4839:    //            n: dimension for x etc; # of data pts (>=2);
 4840:    //            getX, getY: functions to access x,y coordinates
 4841:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4842:    //     Output: 
 4843:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4844: 
 4845:    const int n = k2 - k1 + 1;
 4846:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4847: 
 4848:    // Allocate memory for the splines
 4849:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4850:    spline.x   = new double[n];
 4851:    spline.y   = new double[n];
 4852:    spline.yp  = new double[n];
 4853:    spline.ypp = new double[n];
 4854: 
 4855:    for (int k=k1; k<=k2; k++) {
 4856:       spline.x[k] = getX(k);
 4857:       spline.y[k] = getY(k);
 4858:    }
 4859: 
 4860:    // This is to simplify expressions later
 4861:    double *x = spline.x;
 4862:    double *y = spline.y;
 4863: 
 4864:    double *a = nullptr;
 4865:    double *b = nullptr;
 4866:    double *c = nullptr;
 4867:    double *gam = nullptr;
 4868:    double *rhs = nullptr;
 4869:    
 4870: 
 4871:       a = new double[n];   // Lower diagonal
 4872:       b = new double[n];   // Diagonal
 4873:       c = new double[n];   // Upper diagonal
 4874:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4875:       rhs = new double[n]; // Right-hand side
 4876: 
 4877:    for (int k=k1; k<=k2; k++) {
 4878:       if (k == k1) {
 4879:          // Bottom level
 4880:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4881:          b[k] = (x[k+1] - x[k])/3.0;
 4882:          c[k] = b[k]/2.0;
 4883:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4884:       } else if (k == n - 1) {
 4885:          // Top level (surface)
 4886:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4887:          b[k] = (x[k] - x[k-1])/3.0;
 4888:          a[k] = b[k]/2.0;
 4889:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4890:       } else {
 4891:          // Intermediate levels
 4892:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4893:          b[k] = (x[k+1] - x[k-1])/3.0;
 4894:          a[k] = (x[k  ] - x[k-1])/6.0;
 4895:          c[k] = (x[k+1] - x[k  ])/6.0;
 4896:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4897:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4898:       }
 4899:    }
 4900: 
 4901:    // Solve the tridiagonal system
 4902:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4903:    
 4904:    spline.yp[k1] = yp_bot;
 4905:    spline.yp[k2] = yp_top;
 4906: 
 4907:    // Compute rest of 1st derivatives using the splines
 4908:    for (int k=k1+1; k<k2; k++) {
 4909:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4910:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4911:    }
 4912:    
 4913:    delete[] a;
 4914:    delete[] b;
 4915:    delete[] c;
 4916:    delete[] gam;
 4917:    delete[] rhs;
 4918: 
 4919: }
 4920: 
 4921: // Array version
 4922: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4923:                                 double y_top, double y_bot, 
 4924:                                 CubicSpline &spline) {
 4925:    auto getX = [x] (int k) { return x[k]; };
 4926:    auto getY = [y] (int k) { return y[k]; };
 4927:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4928: }
 4929: 
 4930: // Lambda version - allows custom access patterns
 4931: template<typename XFunc, typename YFunc>
 4932: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4933:                                 double y_top, double y_bot,
 4934:                                 CubicSpline &spline) {
 4935:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4936: }
