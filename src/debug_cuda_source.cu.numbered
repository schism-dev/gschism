 1039: struct Element {
 1040: 
 1041:    // Geometry information
 1042:    int idx;                   // Index of the element
 1043:    int16_t i34;               // Number of sides for the element 
 1044:    Side *sides[4];            // Sides of the element
 1045:    Node *nodes[4];            // Nodes of the element
 1046:    Element *nghbElems[4];     // Neighbors of the element
 1047: 
 1048:    int16_t kb;                // Bottom index of the element
 1049:    double area;               // Area of the element
 1050:    double ssign[4];           // Sign associated with each side of an element
 1051:    double radius;             // Element equivalent radii
 1052: 
 1053:    Frame<ics> frame;
 1054: 
 1055:    Vector2 gradPhi[4];        // Derivatives of shape functions
 1056:    Vector2 gradEta;           // Gradient of free surface elevation
 1057:    Vector2 gradPr;            // Gradient of pressure    
 1058:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
 1059: 
 1060:    bool isDry;                // True if the element is dry
 1061: 
 1062:    Point2 center;            // Element center coordinates (global coordinates)
 1063: 
 1064:    double depth;              // Depth at element (min of all nodes)
 1065:    double z[nvrt];            // z-coord  (local frame - vertical up)
 1066: 
 1067:    // Physical information
 1068:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
 1069:    Transport<transportModel> transport; // Transport model 
 1070: 
 1071:    static const bool isblock = false;              // Always false
 1072: 
 1073:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
 1074:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
 1075: 
 1076:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
 1077:    
 1078: 
 1079:    double vsource;            // Volumetric source/sink term [m^3/s]
 1080: 
 1081:    double rho[nvrt];          // Density at each prism center
 1082:    double rho_mean[nvrt];     // Mean density at each prism center
 1083:    CubicSpline rho_spl;
 1084:    double rho_zz[nvrt];       // Second derivative of density at each prism center
 1085:    double rho_z[nvrt];        // First derivative of density at each prism center
 1086:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
 1087:    
 1088: 
 1089:    __inline__ __device__ Point2 outputCoords(void) const;
 1090: 
 1091:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
 1092: 
 1093:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1094:    // If ics == 2, convert the global point to the local frame of the element
 1095:       
 1096:       if constexpr (ics == 1) {
 1097:          return p;
 1098:       } else {
 1099:          const Point3 c = {center.x, center.y, centerZ()};
 1100:          return frame.G2L(p - c);
 1101:       }
 1102:    }
 1103: 
 1104:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1105:    // If ics == 2, convert the local point to a global point
 1106:       
 1107:       if constexpr (ics == 1) {
 1108:          return p;
 1109:       } else {
 1110:          const Point3 c = {center.x, center.y, centerZ()};
 1111:          return c + frame.L2G(p);
 1112:       }
 1113:    }
 1114: 
 1115:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
 1116:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
 1117: 
 1118:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1119:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1120: 
 1121:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
 1122:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
 1123:       // Find the local index of the node in the element (0,1,2,3)
 1124:       int res = __ffs((nodes[0] == node) | 
 1125:                      ((nodes[1] == node) << 1) | 
 1126:                      ((nodes[2] == node) << 2) | 
 1127:                      ((nodes[3] == node) << 3)) - 1;
 1128:       
 1129:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
 1130:       return res;  
 1131:    }
 1132: 
 1133:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
 1134:       // Find the local index of the side in the element (0,1,2,3)
 1135:       int res = __ffs((sides[0] == side) | 
 1136:                      ((sides[1] == side) << 1) | 
 1137:                      ((sides[2] == side) << 2) | 
 1138:                      ((sides[3] == side) << 3)) - 1;
 1139:       
 1140:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
 1141:       return res;
 1142:    }
 1143: 
 1144:    __inline__ __device__ int findLevel(double z1, int k) const {
 1145:       // Starting at index k, find sequentially the level that contains z
 1146: 
 1147:       // For testing purposes, forgets k and performs a full search.
 1148:       for (k = kb; k < nvrt - 1; k++) {
 1149:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1150:       }
 1151:       return nvrt - 2;
 1152: 
 1153: 
 1154:       // if z is already betweeen z[k] and z[k+1], return k
 1155:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1156:       else if (z1 <  z[k]) { 
 1157:          // Search for increasing levels
 1158:          for (int kk = k; kk < nvrt - 1; kk++) {
 1159:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1160:          }
 1161:          return nvrt - 1;
 1162:       }
 1163:       else {
 1164:          // Search for decreasing levels
 1165:          for (int kk = k; kk >= kb; kk--) {
 1166:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1167:          }
 1168:          return 0;
 1169:       }
 1170:    }
 1171: 
 1172:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
 1173:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
 1174: 
 1175: 
 1176:    __device__ __forceinline__ double centerZ(void) const;
 1177: 
 1178:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
 1179:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
 1180:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
 1181:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
 1182:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
 1183:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
 1184:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 1185:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
 1186:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
 1187: 
 1188: 
 1189:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
 1190:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
 1191:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
 1192:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
 1193:        const double eta = (idxNode & 1) ? +g : -g;
 1194:        const double xi  = (idxNode & 2) ? +g : -g;
 1195:        return {eta, xi};
 1196:    }  
 1197: 
 1198: 
 1199: 
 1200:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
 1201:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
 1202:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
 1203:    }
 1204: 
 1205:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
 1206:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
 1207:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
 1208:    }   
 1209: 
 1210:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
 1211:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
 1212:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
 1213:    }      
 1214:    
 1215:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1216: 
 1217:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1218: 
 1219:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
 1220:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
 1221: 
