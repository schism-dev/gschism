 1358: struct Node {
 1359: 
 1360:    // Geometry information
 1361:    int idx;        // Index of the node
 1362:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1363:    int numNodes;   // Number of nodes neighbors of this node
 1364: 
 1365:    Element **elements; // Array of pointers to the elements that share this node
 1366:    int numElements;    // Number of elements that share this node
 1367: 
 1368:    int numSides;       // Number of sides that are connected to this node
 1369: 
 1370:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1371:    double gz;          // Global vertical coordinate at the node.
 1372:    Vector2 u2[nvrt];
 1373:    double  w2[nvrt];
 1374:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1375:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1376:    double lon, lat;
 1377:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1378:    double depth;
 1379: 
 1380:    #ifdef USE_FRAMES
 1381:    Frame frame;
 1382:    #endif
 1383: 
 1384:    #ifdef USE_LOCALIZED_SIGMA   
 1385:    double localSigma[nvrt];
 1386:    #endif
 1387: 
 1388:    int kb;       // Bottom index of the node
 1389: 
 1390:    bool isDry;     // True if the node is dry
 1391: 
 1392:    int iadv;     // Advection flag
 1393: 
 1394:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1395:                           // this is nullptr
 1396: 
 1397:    TempVar tmp; // Temporary variable to store different types of variables
 1398: 
 1399:    // Physical information
 1400:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1401:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1402: 
 1403:    double rho[nvrt];     // Density
 1404:    double dfv[nvrt];     // Vertical viscosity
 1405: 
 1406:    double eta1; // Elevation at nodes at previous timestep
 1407:    double eta2; // Elevation at nodes at current timestep
 1408: 
 1409:    double ETP;  // Earth Tidal Potential
 1410: 
 1411:    double pr;    // Air pressure
 1412:    double grav2; // Gravity 
 1413:    
 1414:    Vector2 dav;  // Depth averaged velocity
 1415: 
 1416:    Vector2 tau; // Wind stress vector
 1417: 
 1418:    // Vegetation parameters
 1419:    double veg_h;
 1420:    double veg_nv;
 1421:    double veg_di;
 1422:    double veg_Cd;
 1423:    double veg_h_unbent;
 1424:    double veg_di_unbent;
 1425:    double veg_nv_unbent;
 1426:    double veg_alpha_vert_mean;
 1427:    double veg_alpha0;
 1428:    double veg_alpha3D[nvrt];
 1429: 
 1430:    // Bottom drag parameters
 1431:    double Cd;       // Bottom drag coefficient   
 1432: 
 1433:    // These three are mutually exclusive
 1434:    union {
 1435:       double rmanning; // Bottom Manning's coefficient
 1436:       double rough;    // Bottom roughness length
 1437:       double drag;     // Bottom drag coefficient
 1438:    };
 1439:    Vector2 tau_bot; // Bottom stress vector
 1440: 
 1441:    // XXXX REMOVE FOR IMM>0???
 1442:    double bdef1; // Bottom deformation at previous timestep
 1443:    double bdef2; // Bottom deformation at current timestep
 1444: 
 1445:    double qel; // RHS
 1446:    double coeffDiag; // Diagonal coefficient of the matrix
 1447:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1448: 
 1449:    // This was used by a previous version of the conjugate gradient method
 1450:    // double mP; // Search direction for conjugate gradient method
 1451:    // double mR; // Residual for conjugate gradient method
 1452:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1453: 
 1454:    double mX; // Solution of the FEM system
 1455: 
 1456:    // Meteorological forcing
 1457:    Vector2 u_air;
 1458:    double p_air;  // XXXX is this the same as pr?
 1459:    double t_air;
 1460:    double q_air;
 1461:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1462: 
 1463:    __device__ void setWind(Vector2 &u) {
 1464:    // Sets the wind vector taking into account the mesh angle
 1465:    
 1466:       const double speed = length(u);
 1467: 
 1468:       // Rotate wind vector to the node frame
 1469:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1470: 
 1471:       // Sets the surface stress vector due to wind.
 1472:       if constexpr(nws == 0) {
 1473:          tau = {0.0, 0.0};
 1474: 
 1475:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1476:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1477: 
 1478:       } else {
 1479: 
 1480:          double dragcoef;
 1481: 
 1482:          if constexpr(iwind_form == -1) {
 1483:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1484:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1485: 
 1486:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1487:             tau = cff*u_air;
 1488:  
 1489:          } else if constexpr(iwind_form == 1) {
 1490:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1491:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1492: 
 1493:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1494:             tau = cff*u_air;
 1495: 
 1496:          } else {
 1497:             tau = {0.0, 0.0};
 1498:          }
 1499:       }
 1500:    }
 1501: 
 1502:    #ifdef USE_FRAMES
 1503:    __device__ void setFrame(double lat, double lon) {
 1504: 
 1505:       frame.update(lat, lon);        
 1506:     }
 1507:    #endif
 1508: 
 1509:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1510: 
 1511:    __device__ double sigmaTransitionDepth(void) const;
 1512: 
 1513:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1514: 
 1515:    __inline__ __device__ Point2 outputCoords(void) const {
 1516:       if constexpr(ics == 1)  return p;
 1517:       else                    return {rad2deg*lon, rad2deg*lat};
 1518:    }
 1519: 
 1520:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1521:    // If ics == 2, convert the global point to the local frame
 1522:       
 1523:       if constexpr (ics == 1) {
 1524:          return p;
 1525:       } else {
 1526: #ifdef USE_FRAMES
 1527:          const Point3 c = {p.x, p.y, gz};
 1528:             const Point3 local = frame.G2L(p - c);
 1529:             return local;
 1530: #else
 1531:          return p;
 1532: #endif
 1533:       }
 1534:    }
 1535: 
 1536:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1537:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1538:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1539:    
 1540:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1541: 
 1542:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1543: 
 1544:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1545:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1546: 
 1547:    __device__ __forceinline__ void clearMatrixRow(void) {
 1548:       // Clear the matrix row for this node
 1549: 
 1550: 
 1551:       coeffDiag = 0.0;
 1552: 
 1553:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1554: 
 1555:    }
 1556: 
 1557:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1558:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1559:       
 1560:       if (node == this) {
 1561:          coeffDiag += value;
 1562:      
 1563:       } else {
 1564:          // Search (linearly)the index of the node in the array of nodes
 1565:          // XXX: This is not efficient, see if we can improve this
 1566:          int i;
 1567:          for (i = 0; i < numNodes; i++) {
 1568:             if (nodes[i] == node) {
 1569:                break;
 1570:             }
 1571:          }
 1572:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1573:          coeffMatrix[i] += value;
 1574:       }
 1575:    }
 1576: 
 1577: 
 1578:    __device__ __inline__ void updateZCoordData(void);
 1579: 
 1580:    __device__ __forceinline__ double compZCoord(int k) const;
 1581: 
 1582:    __device__ void updateKb(void);
 1583: 
 1584:    __device__ __forceinline__ void computeBottomDragCd(void);
 1585: 
 1586: 
 1587: 
 1588: };
