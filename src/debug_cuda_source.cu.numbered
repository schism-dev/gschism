  963: struct Side {
  964: 
  965:    // Geometry information
  966:    int idx;               // Index of the side
  967:    Node *n1, *n2;
  968:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  969: 
  970:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  971:    Vector2 center;        // Location of side center. 
  972:    double zc[nvrt];       // Side center z-coord at each vertical level
  973: 
  974:    #ifdef USE_FRAMES
  975:    Frame frame;
  976:    #endif
  977: 
  978:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  979:                           // this is nullptr
  980:    
  981:    int kb;                // Bottom index of the side
  982:    bool isDry;            // True if the side is dry
  983:  
  984:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  985: 
  986:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  987: 
  988:    // Physical information
  989:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  990:    Vector2 btu[nvrt];           // Back-tracked velocity
  991:    Vector2 U;                   // Vertically averaged velocity vector  
  992: 
  993:    Vector2 nuGradU[nvrt];          // nu*grad u
  994: 
  995:    Vector2 bcc[nvrt];           // Baroclinic term
  996:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  997: 
  998:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  999:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1000:    Vector2 gradPr;               // Gradient of pressure
 1001:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1002: 
 1003: 
 1004:    double hhat;                 // \breve{H} in notes
 1005: 
 1006:    double shapiro;
 1007: 
 1008:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1009: 
 1010:    double coriolis;             // Coriolis parameter
 1011: 
 1012:    // Vegetation parameters
 1013:    double veg_c2;
 1014:    double veg_beta;
 1015: 
 1016:    // Bottom drag parameters.
 1017:    double chi;
 1018:    double chi2;
 1019: 
 1020:    __inline__ __device__ double x(double t) const;
 1021:    __inline__ __device__ double y(double t) const;
 1022:    __inline__ __device__ double z(double t) const;
 1023:    __inline__ __device__ double lon(void) const;
 1024:    __inline__ __device__ double lat(void) const;
 1025:    __inline__ __device__ Point2 p2_t(double t) const;
 1026:    __inline__ __device__ Point3 p3_t(double t) const;
 1027: 
 1028:    #ifdef USE_FRAMES
 1029:    __device__ void setFrame(void) {
 1030:       double lat, lon;
 1031:       const Point3 p = toPoint3(center, centerZ());
 1032: 
 1033:       // Compute the latitude and longitude of the element center
 1034:       computeLatLon(p, lat, lon);
 1035: 
 1036:       frame.update(lat, lon);        
 1037:    }
 1038:    #endif
 1039: 
 1040:    __inline__ __device__ double centerZ(void)   const;
 1041:    __inline__ __device__ Point3 center3D(int k) const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1042:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1043:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1044: 
 1045:    __inline__ __device__ Side* neigh(int index) const { 
 1046:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1047:       assert(index >= 0 && index < 4); 
 1048:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1049: 
 1050:       const int ielem = index & 1;           // 0 or 1
 1051:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1052: 
 1053:       const Element* elem = elems[ielem];
 1054: 
 1055:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1056: 
 1057:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1058: 
 1059:    }
 1060: 
 1061:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1062: 
 1063:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1064: 
 1065:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1066:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1067:    __inline__ __device__ int iadv(void) const;
 1068: 
 1069:    __inline__ __device__ double grav3(void) const;
 1070:    
 1071:    __inline__ __device__ double eta2(void) const;
 1072:    __inline__ __device__ double eta1(void) const;
 1073:    __inline__ __device__ double w2(int k) const;
 1074:    __inline__ __device__ double depth(void) const;
 1075:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1076:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1077: 
 1078:    __inline__ __device__ double dfv(int k) const;
 1079: 
 1080:    __inline__ __device__ double veg_h(void)  const;
 1081:    __inline__ __device__ double veg_nv(void) const;
 1082:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1083:    __inline__ __device__ double veg_alpha3D(int k) const;
 1084:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1085: 
 1086:    __inline__ __device__ double Cd(void) const;
 1087: 
 1088:    __inline__ __device__ Vector2 tau(void) const;
 1089: 
 1090:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1091:    
 1092: 
 1093:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1094:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1095:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1096:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1097:    } 
 1098:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1099:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1100:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1101:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1102: 
 1103:    // Get valid starting element (for backtracking)
 1104:    __inline__ __device__ Element* getStartElement() {
 1105:       return elems[0] ? elems[0] : elems[1];
 1106:    }
 1107: 
 1108:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1109:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1110:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1111: 
 1112:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1113: 
 1114:       // Dot product of the negative velocity vector with the side normal vector
 1115:       const double dot_prod1 = -dot(u, n);
 1116: 
 1117:       // Vector from side center to element 0 centroid
 1118:       const Vector2 v2 = elems[0]->center - center;
 1119: 
 1120:       // Dot product of the vector with the side normal vector
 1121:       const double dot_prod2 = dot(v2, n);
 1122: 
 1123:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1124:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1125: 
 1126:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1127:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1128: 
 1129:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1130: 
 1131:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1132:       else                           return !isDry1 ? elems[1] : elems[0];
 1133: 
 1134:  
 1135:    }
 1136: 
 1137:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1138:       // Given an element, returns the other element that shares this side
 1139:       return (elems[0] == elem) ? elems[1] : elems[0];
 1140:    }
 1141: 
 1142:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1143:       // Given a node, returns the other node that shares this side
 1144:       return (n1 == node) ? n2 : n1;
 1145:    }
 1146:  
 1147:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1148: 
 1149: 
 1150: 
 1151: 
 1152: };
 1153: 
 1154: 
 1155: // This struct is used to store the boundary information for a node.
 1156: struct NodeBoundary {   
 1157:    int idx;
 1158:    BoundarySegment *segment;
 1159:    Node *node;
 1160:    
 1161:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1162:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1163: 
 1164:    bool isLand;
 1165: 
 1166:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1167:    double elbc;   // Elevation boundary condition
 1168:    double eth;    // Elevation time history
 1169: 
 1170:    double eta_mean; // Mean elevation at nodes
 1171: 
 1172:    bool isEssentialBC;
 1173: 
 1174:    Vector2 uth[nvrt];  // "Time history" velocity
 1175: 
 1176:    // Arrays for harmonic constituents (if needed)
 1177:    double  emo[nbfr];  // Elevation amplitude
 1178:    double  efa[nbfr];  // Elevation phase
 1179:    Vector2 umo[nbfr];  // velocity amplitude
 1180:    Vector2 ufa[nbfr];  // velocity phase
 1181: 
 1182: 
 1183:    NodeBoundary(void) {
 1184:       isLand = false;
 1185:    }
 1186:    NodeBoundary(bool _isLand) {
 1187:       isLand = _isLand;
 1188:    }
 1189: 
 1190:    
 1191:    __forceinline__ __device__ int numSidesForAverage() const {
 1192:    // Returns the number of sides that are connected to the node and have the same segment.
 1193:    // This is used to compute the average velocity at the node for open boundary nodes.
 1194:       int res = 0;
 1195:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1196:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1197: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1198:       return res;
 1199:    }
 1200: 
 1201: 
 1202:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1203:       assert(index == 0 || index == 1); 
 1204:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1205:    }
 1206: 
 1207: 
 1208: };
 1209: 
 1210: struct Node {
 1211: 
 1212:    // Geometry information
 1213:    int idx;        // Index of the node
 1214:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1215:    int numNodes;   // Number of nodes neighbors of this node
 1216: 
 1217:    Element **elements; // Array of pointers to the elements that share this node
 1218:    int numElements;    // Number of elements that share this node
 1219: 
 1220:    int numSides;       // Number of sides that are connected to this node
 1221: 
 1222:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1223:    double gz;          // Global vertical coordinate at the node.
 1224:    Vector2 u2[nvrt];
 1225:    double  w2[nvrt];
 1226:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1227:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1228:    double lon, lat;
 1229:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1230:    double depth;
 1231: 
 1232:    #ifdef USE_FRAMES
 1233:    Frame frame;
 1234:    #endif
 1235: 
 1236:    #ifdef USE_LOCALIZED_SIGMA   
 1237:    double localSigma[nvrt];
 1238:    #endif
 1239: 
 1240:    int kb;       // Bottom index of the node
 1241: 
 1242:    bool isDry;     // True if the node is dry
 1243: 
 1244:    int iadv;     // Advection flag
 1245: 
 1246:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1247:                           // this is nullptr
 1248: 
 1249:    TempVar tmp; // Temporary variable to store different types of variables
 1250: 
 1251:    // Physical information
 1252:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1253:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1254: 
 1255:    double rho[nvrt];     // Density
 1256:    double dfv[nvrt];     // Vertical viscosity
 1257: 
 1258:    double eta1; // Elevation at nodes at previous timestep
 1259:    double eta2; // Elevation at nodes at current timestep
 1260: 
 1261:    double ETP;  // Earth Tidal Potential
 1262: 
 1263:    double pr;    // Air pressure
 1264:    double grav2; // Gravity 
 1265:    
 1266:    Vector2 dav;  // Depth averaged velocity
 1267: 
 1268:    Vector2 tau; // Wind stress vector
 1269: 
 1270:    // Vegetation parameters
 1271:    double veg_h;
 1272:    double veg_nv;
 1273:    double veg_di;
 1274:    double veg_Cd;
 1275:    double veg_h_unbent;
 1276:    double veg_di_unbent;
 1277:    double veg_nv_unbent;
 1278:    double veg_alpha_vert_mean;
 1279:    double veg_alpha0;
 1280:    double veg_alpha3D[nvrt];
 1281: 
 1282:    // Bottom drag parameters
 1283:    double Cd;       // Bottom drag coefficient   
 1284: 
 1285:    // These three are mutually exclusive
 1286:    union {
 1287:       double rmanning; // Bottom Manning's coefficient
 1288:       double rough;    // Bottom roughness length
 1289:       double drag;     // Bottom drag coefficient
 1290:    };
 1291:    Vector2 tau_bot; // Bottom stress vector
 1292: 
 1293:    double bdef1; // Bottom deformation at previous timestep
 1294:    double bdef2; // Bottom deformation at current timestep
 1295: 
 1296:    double qel; // RHS
 1297:    double coeffDiag; // Diagonal coefficient of the matrix
 1298:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1299: 
 1300:    double mP; // Search direction for conjugate gradient method
 1301:    double mR; // Residual for conjugate gradient method
 1302:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1303:    double mX; // Solution for conjugate gradient method
 1304: 
 1305:    // Meteorological forcing
 1306:    Vector2 u_air;
 1307:    double p_air;  // XXXX is this the same as pr?
 1308:    double t_air;
 1309:    double q_air;
 1310:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1311: 
 1312:    __device__ void setWind(Vector2 &u) {
 1313:    // Sets the wind vector taking into account the mesh angle
 1314:    
 1315:       const double speed = length(u);
 1316: 
 1317:       // Rotate wind vector to the node frame
 1318:       const Vector2 u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1319: 
 1320:       // Sets the surface stress vector due to wind.
 1321:       if constexpr(nws == 0) {
 1322:          tau = {0.0, 0.0};
 1323: 
 1324:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1325:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1326: 
 1327:       } else {
 1328: 
 1329:          double dragcoef;
 1330: 
 1331:          if constexpr(iwind_form == -1) {
 1332:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1333:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1334: 
 1335:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1336:             tau = cff*u_air;
 1337:  
 1338:          } else if constexpr(iwind_form == 1) {
 1339:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1340:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1341: 
 1342:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1343:             tau = cff*u_air;
 1344: 
 1345:          } else {
 1346:             tau = {0.0, 0.0};
 1347:          }
 1348:       }
 1349:    }
 1350: 
 1351:    #ifdef USE_FRAMES
 1352:    __device__ void setFrame(double lat, double lon) {
 1353: 
 1354:       frame.update(lat, lon);        
 1355:     }
 1356:    #endif
 1357: 
 1358:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1359: 
 1360:    __device__ double sigmaTransitionDepth(void) const;
 1361: 
 1362:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1363:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1364:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1365:    
 1366:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1367: 
 1368:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1369: 
 1370:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1371:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1372: 
 1373:    __device__ __forceinline__ void clearMatrixRow(void) {
 1374:       // Clear the matrix row for this node
 1375: 
 1376: 
 1377:       coeffDiag = 0.0;
 1378: 
 1379:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1380: 
 1381:    }
 1382: 
 1383:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1384:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1385:       
 1386:       if (node == this) {
 1387:          coeffDiag += value;
 1388:      
 1389:       } else {
 1390:          // Search (linearly)the index of the node in the array of nodes
 1391:          // XXX: This is not efficient, see if we can improve this
 1392:          int i;
 1393:          for (i = 0; i < numNodes; i++) {
 1394:             if (nodes[i] == node) {
 1395:                break;
 1396:             }
 1397:          }
 1398:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1399:          coeffMatrix[i] += value;
 1400:       }
 1401:    }
 1402: 
 1403: 
 1404:    __device__ __inline__ void updateZCoordData(void);
 1405: 
 1406:    __device__ __forceinline__ double compZCoord(int k) const;
 1407: 
 1408:    __device__ void updateKb(void);
 1409: 
 1410:    __device__ __forceinline__ void computeBottomDragCd(void);
 1411: 
 1412: 
 1413: 
 1414: };
