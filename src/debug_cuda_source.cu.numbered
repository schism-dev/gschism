 7787: __global__ void getStructSizes(int* sizes)  {
 7788:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7789:       sizes[0] = (int)sizeof(Node);
 7790:       sizes[1] = (int)sizeof(Element);
 7791:       sizes[2] = (int)sizeof(Side);
 7792:       sizes[3] = (int)sizeof(NodeBoundary);
 7793:       sizes[4] = (int)sizeof(SideBoundary);
 7794:       sizes[5] = (int)sizeof(BoundarySegment);
 7795: }
