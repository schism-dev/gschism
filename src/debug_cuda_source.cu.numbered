 7611: __global__ void printMatrix(bool full) {
 7612:    // Debugging: print the matrix
 7613: 
 7614:    const int size = mesh->np;
 7615:    double sum = 0.0;
 7616:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7617:       const Node *node = mesh->localNodeData + idx_node;
 7618:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7619:       for (int j = 0; j < node->numNodes; j++) {
 7620:          Node* nbNode = node->nodes[j];
 7621:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7622:          sum += node->coeffMatrix[j];
 7623:       }
 7624:       if (full) printf("]\n");
 7625: 
 7626: 
 7627:    }
 7628:    if (!full) printf("sum=%lf\n", sum);
 7629: }
