 1751: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1752:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1753: }
 1754: 
 1755: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1756:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1757: }   
 1758: 
 1759: __device__ __inline__ double min3(double a, double b, double c) {
 1760:    return min(a, min(b, c));
 1761: }
 1762: 
 1763: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1764:    return min(a, min(b, min(c, d)));
 1765: }
