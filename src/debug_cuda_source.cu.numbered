 9041: 
 9042: __global__ void printMatrix(bool full) {
 9043:    // Debugging: print the FEM matrix row for each local node
 9044: 
 9045:    const int size = mesh->np;
 9046:    double sum = 0.0;
 9047: 
 9048:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9049:       const Node *node = mesh->localNodeData + idx_node;
 9050: 
 9051:       if (full)
 9052:          printf("idx_node = %d [%d] diag=%lf, [",
 9053:                 idx_node, node->numNodes, *(node->coeffDiag));
 9054: 
 9055:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9056:       for (int k = 0; k < node->numNodes + 1; k++)
 9057:          sum += node->coeffRow[k];
 9058: 
 9059:       for (int j = 0; j < node->numNodes; j++) {
 9060:          const Node *nbNode = node->nodes[j];
 9061:          const double aij = node->coeffRow[node->csrSlot[j]];
 9062:          if (full && aij != 0.0)
 9063:             printf("%d:%f,  ", nbNode->idx, aij);
 9064:       }
 9065: 
 9066:       if (full) printf("]\n");
 9067:    }
 9068: 
 9069:    if (!full) printf("sum=%lf\n", sum);
 9070: }
 9071: 
 9072: 
 9073: 
 9074: 
 9075: __global__ void returnMatrix(double *res) {
 9076:    // Debugging: dense local matrix, row-major, size = mesh->np
 9077:    // Assumes single-partition / local indexing (see note below).
 9078: 
 9079:    const int size = mesh->np;
 9080: 
 9081:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9082:       const Node *node = mesh->localNodeData + idx_node;
 9083: 
 9084:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9085: 
 9086:       for (int j = 0; j < node->numNodes; j++) {
 9087:          const Node *nbNode = node->nodes[j];
 9088:          // Only dump neighbors that live on this partition
 9089:          if (nbNode->part != mesh->partNum) continue;
 9090: 
 9091:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9092:          const double aij = node->coeffRow[node->csrSlot[j]];
 9093:          if (aij != 0.0)
 9094:             res[jlocal * size + idx_node] = aij;
 9095:       }
 9096:    }
 9097: }
 9098: 
 9099: 
 9100: __global__ void returnX(double *res) {
 9101:    // Debugging: returns the matrix as a CuPy array
 9102: 
 9103:    const int size = mesh->np;
 9104:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9105:       const Node *node = mesh->localNodeData + idx_node;
 9106: 
 9107:       res[idx_node] = node->mX;
 9108: 
 9109:    }
 9110:    
 9111: }
