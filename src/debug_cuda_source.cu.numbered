 1519:                    int npgb, int negb, int nsgb, 
 1520:                    int np, int ne, int ns,
 1521:                    int max_np, int max_ne, int max_ns, int nseg,
 1522:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1523:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
