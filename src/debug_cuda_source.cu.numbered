 8573: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8574:    // Get the value of a variable from an side
 8575:    // varName is the name of the variable to get
 8576:    // var is the array to store the value
 8577:    // k is the vertical level index of the variable to get
 8578:    SIDE_BND(sideBnd);   
 8579: 
 8580:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8581:    if (sideBnd->segment->isLand) idx = -7;
 8582: 
 8583:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8584:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8585: 
 8586: }
