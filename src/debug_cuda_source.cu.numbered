 2057: __device__ __forceinline__ void update_bdef(double time, double x0, double y0, double &dep, Vector3 &vel) {
 2058:    // For imm=2, user needs to update bottom depth and velocity
 2059: 
 2060:    dep = min(1.0, 7.0 - (x0 + time));
 2061:    vel = { -1.0, 0.0, 0.0 };
 2062: 
 2063: }
 2064: 
 2065: 
 2066: 
 2067: 
 2068: 
 2069: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2070:    if constexpr(ics == 1)  {
 2071:       return center;
 2072: 
 2073:    } else {
 2074:       const Point2 p0 = nodes[0]->outputCoords();
 2075:       const Point2 p1 = nodes[1]->outputCoords();
 2076:       const Point2 p2 = nodes[2]->outputCoords();
 2077: 
 2078:       if (isTri()) {
 2079:          return (1.0/3.0)*(p0 + p1 + p2);
 2080: 
 2081:       } else {
 2082:          const Point2 p3 = nodes[3]->outputCoords();
 2083:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2084:       }
 2085: 
 2086:    }
 2087: }
 2088: 
 2089: 
 2090: __device__ __forceinline__ double Element::centerZ(void) const { 
 2091: // Z coordinate of the element center in the global cartesian coordinates.
 2092: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2093: 
 2094:    if constexpr(ics==1) { 
 2095:       return 0.0; 
 2096: 
 2097:    } else { 
 2098: 
 2099:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2100:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2101:    } 
 2102: }
