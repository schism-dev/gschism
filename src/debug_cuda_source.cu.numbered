 1747: // Helper functions for computing the local node index at a given offset from another.
 1748: __device__ __inline__ int nxq(int offset, int index, int size) {
 1749:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1750:    // to the index to make it positive
 1751:    assert(index + offset + 16*size >= 0);
 1752:    return (index + offset + 16*size) % size;  
 1753: }
 1754: 
 1755: __device__ __inline__ int nxq(int index, int size) {
 1756:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1757:    // to the index to make it positive
 1758:    assert(index + 16*size >= 0);
 1759:    return (index + 16*size) % size; 
 1760: }
