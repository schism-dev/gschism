 1468: 
 1469: /**
 1470:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1471:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1472:    If the segment is completely inside the element, then it returns true.
 1473: 
 1474:    This function assumes:
 1475:    - The initial point is on a side of the element. 
 1476:    - Its position is given by parameter t in the range [0,1].
 1477:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1478:       intersects the element (elements are convex).
 1479: 
 1480:    To find the intersection point, this function does the following:
 1481:    - it finds the intersection of the line segment with all the element side lines,
 1482:       except for the one that contains the initial point.
 1483:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1484:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1485:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1486:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1487:       track segment is almost parallel to the element side line.
 1488: 
 1489:    Inputs:
 1490:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1491:    @param x2, y2: other end of the line segment
 1492: 
 1493:    Outputs:
 1494:    @param side:  side that intersects the line segment (input and output)
 1495:    @param nextElement (output): element that contains the intersection point
 1496:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1497:    @param zint (input/output): Vertical coordinate of the intersection point
 1498: 
 1499:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1500:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1501:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1502: 
 1503:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1504:    (Delta) being zero.
 1505: 
 1506:    The intersection2 point happens when:
 1507:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1508:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1509:    
 1510:    Assumption: the 4 points (including those of the side segment) are different.
 1511:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1512:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1513:    If true, (xIntersect,yIntersect) is the intersection.				
 1514:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1515: **/
 1516: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1517:                                               double &t, double& tIntersect) {
 1518: 
 1519:    double closest_intersect_t = 1e10;
 1520:    bool found_intersection = false;
 1521: 
 1522:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1523:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1524:    const Point2 x1 = side->point(t);
 1525:    
 1526: 
 1527:    Side *nextSide = nullptr;
 1528:    for (int i = 0; i < i34; i++) {
 1529: 
 1530:       // Element's i-th side 
 1531:       Side *side2 = sides[i];
 1532: 
 1533:       // Skip the side that contains the initial point
 1534:       if (side2 == side) continue;
 1535: 
 1536:       // (x3,y3)-(x4,y4) is the element side line
 1537:       const Point2 x3 = side2->n1->p2();
 1538:       const Point2 x4 = side2->n2->p2();
 1539: 
 1540:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1541:       const double delta = cross(x2 - x1, x3 - x4);
 1542: 
 1543:       if (delta != 0.0) {
 1544: 
 1545:          const double delta1 = cross(x3 - x1, x3 - x4);
 1546:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1547: 
 1548:          // Solves the two linear equations for tt1 and tt2
 1549:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1550:          const double tt2 = delta2/delta;
 1551: 
 1552:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1553:             closest_intersect_t = min(closest_intersect_t, tt1);
 1554:             nextSide = side2;
 1555: 
 1556:             nextElement = nextSide->otherElem(this);
 1557:             tIntersect = max(small, min(tt1, 1.0-small));
 1558:             t = tt2;
 1559: 
 1560:             found_intersection = true;
 1561:          }
 1562:       
 1563:       }
 1564: 
 1565:    }
 1566:    
 1567: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1568: 
 1569: 
 1570:    // found_intersection should always be true, since we checked all the sides.  
 1571:    side = nextSide;
 1572: // if (found_intersection) {
 1573: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1574: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1575: // }   
 1576:    // if (!found_intersection) {
 1577:    //    // Check if the segment is parallel to the initial side
 1578:    //    printf("XXX segment: side = %p\n", side);
 1579:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1580:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1581:    //       assert(false && "Segment is parallel to the initial side");
 1582:    //       found_intersection = true;
 1583:    //       nextElement = side->otherElem(this);
 1584:    //       tIntersect = t;
 1585:    //       t = 0.0;
 1586:    //       found_intersection = true;
 1587:    //    }
 1588:    // }
 1589:    return found_intersection;
 1590: }
