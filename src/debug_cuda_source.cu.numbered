 1828: // Helper functions for computing the local node index at a given offset from another.
 1829: __device__ __inline__ int nxq(int offset, int index, int size) {
 1830:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1831:    // to the index to make it positive
 1832:    assert(index + offset + 16*size >= 0);
 1833:    return (index + offset + 16*size) % size;  
 1834: }
 1835: 
 1836: __device__ __inline__ int nxq(int index, int size) {
 1837:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1838:    // to the index to make it positive
 1839:    assert(index + 16*size >= 0);
 1840:    return (index + 16*size) % size; 
 1841: }
