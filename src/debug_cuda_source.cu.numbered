 7716: 
 7717: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7718: //             //   calculate each polynomial's weight 
 7719: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7720: //                 wm=0.d0; sum1=0.d0
