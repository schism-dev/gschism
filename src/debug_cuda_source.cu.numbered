 1160: // This struct is used to store the boundary information for a node.
 1161: struct NodeBoundary {   
 1162:    int idx;
 1163:    BoundarySegment *segment;
 1164:    Node *node;
 1165:    
 1166:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1167:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1168: 
 1169:    bool isLand;
 1170: 
 1171:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1172:    double elbc;   // Elevation boundary condition
 1173:    double eth;    // Elevation time history
 1174: 
 1175:    double eta_mean; // Mean elevation at nodes
 1176: 
 1177:    bool isEssentialBC;
 1178: 
 1179:    Vector2 uth[nvrt];  // "Time history" velocity
 1180: 
 1181:    // Arrays for harmonic constituents (if needed)
 1182:    double  emo[nbfr];  // Elevation amplitude
 1183:    double  efa[nbfr];  // Elevation phase
 1184:    Vector2 umo[nbfr];  // velocity amplitude
 1185:    Vector2 ufa[nbfr];  // velocity phase
 1186: 
 1187: 
 1188:    NodeBoundary(void) {
 1189:       isLand = false;
 1190:    }
 1191:    NodeBoundary(bool _isLand) {
 1192:       isLand = _isLand;
 1193:    }
 1194: 
 1195:    
 1196:    __forceinline__ __device__ int numSidesForAverage() const {
 1197:    // Returns the number of sides that are connected to the node and have the same segment.
 1198:    // This is used to compute the average velocity at the node for open boundary nodes.
 1199:       int res = 0;
 1200:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1201:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1202: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1203:       return res;
 1204:    }
 1205: 
 1206: 
 1207:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1208:       assert(index == 0 || index == 1); 
 1209:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1210:    }
 1211: 
 1212: 
 1213: };
