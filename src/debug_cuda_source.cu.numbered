 1823:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1824:       // Compute the different time ramps used in the code 
 1825:       // This function is performed by just one thread
 1826: 
 1827:       rampbc = 1.0;
 1828:       if constexpr(ibc == 0) {
 1829:          if (drampbc > 0.0) {
 1830:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1831:          } else {
 1832:             rampbc = 1.0;
 1833:          }
 1834:       }
 1835: 
 1836:       if (nws != 0) {
 1837:          if (drampwind > 0.0) {
 1838:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1839:          } else {
 1840:             rampwind = 1.0;
 1841:          }
 1842:       }
 1843: 
 1844:       if (drampwafo > 0.0) {
 1845:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1846:       } else {
 1847:          rampwafo = 1.0;
 1848:       }
 1849: 
 1850:       // For source/sinks
 1851:       if (if_source && dramp_ss > 0.0) {
 1852:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1853:       } else {
 1854:          ramp_ss = 1.0;
 1855:       }
 1856: 
 1857:       if (dramp > 0.0) {
 1858:          ramp = tanh(2.0*time/86400.0/dramp);
 1859:       } else {
 1860:          ramp = 1.0;
 1861:       }
 1862: 
 1863: 
 1864:    }
