 2387: 
 2388: __device__ void Node::updateKb(void) {
 2389: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2390: 
 2391:    if constexpr(ivcor == 1) return;
 2392: 
 2393: 
 2394:    // Check if node is wet
 2395:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2396: 
 2397:    if (isDry) return;
 2398: 
 2399:    if constexpr(ivcor == 2) {  // SZ coordinates
 2400:       
 2401:       // Compute bottom level index
 2402:       if (depth <= mesh->h_s) {
 2403:          kb = mesh->kz - 1;
 2404:       } else {
 2405:          kb = -1;
 2406:          int L = 0;
 2407:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2408:          
 2409:          while (L <= R) {
 2410:             int M = (R + L) / 2;
 2411: 
 2412:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2413:             
 2414:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2415:                R = M;
 2416:             } else {
 2417:                L = M;
 2418:             }
 2419: 
 2420:             if (R - L == 1) {
 2421:                kb = L;
 2422:                break;
 2423:             }
 2424:          }
 2425:       }
 2426:    } 
 2427: }
 2428: 
 2429: 
 2430: __device__ double Node::compZCoord(int k) const {
 2431:    // Computes the z coordinate at level k.
 2432:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2433:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2434:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2435:    // used 
 2436:    
 2437:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2438:       
 2439:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2440: 
 2441:    if constexpr(ivcor == 2) {
 2442: 
 2443:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2444:       const int kz = mesh->kz;
 2445:       const double h_c = mesh->h_c;
 2446:       const double theta_f = mesh->theta_f;
 2447:       const double sinh_theta_f = mesh->sinh_theta_f;
 2448: 
 2449:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2450:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2451:       // once per time step/node.
 2452:       // CHECK: updateZCoordData
 2453: 
 2454:       if      (k == nvrt-1)      { return eta2; }
 2455:       else if (k == kz)          return -hmod2;
 2456:       else if (k == kb)          return -depth;
 2457:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2458:       else if (k > kz) {
 2459:          const int ksig = k - kz + 1;
 2460: 
 2461:          if (hmod2 <= h_c) {
 2462:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2463:          } 
 2464:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2465:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2466:             assert(false && "ZCOOR: invalid h_c\n");
 2467:          } 
 2468:          else {
 2469:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2470:                          h_c * mesh->sigma[ksig] + 
 2471:                          (hmod2 - h_c) * mesh->cs[ksig];
 2472:          }
 2473:       } else { 
 2474:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2475:       }
 2476: 
 2477:    }
 2478:    else if constexpr(ivcor == 1) {
 2479:       if (k == kb) return -depth;
 2480:       else if (k == nvrt-1) return eta2;
 2481:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2482:    }
 2483:    
 2484:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2485:    return 0.0;
 2486: }
 2487: 
 2488: 
 2489: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2490:                 double *node_coords, double *wind_rotate_angle, 
 2491:                 int *isdel, int *isidenode, int *isbnd,
 2492:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2493:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2494:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2495:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2496:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2497:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2498:                 double *emo, double *efa, 
 2499:                 double *umo, double *ufa, 
 2500:                 double *vmo, double *vfa) {
 2501: 
 2502:    printf("Populating mesh for partition %d\n", partNum);
 2503: 
 2504:    // Horizontal grid
 2505:    printf("Processing %d nodes\n", np);    
 2506: 
 2507: 
 2508:    int idxNodeBoundary = 0;  
 2509:    for (int i = 0; i < np; i++)
 2510:    {
 2511:       Node &node = localNodeData[i];
 2512: 
 2513:       node.idx = i;
 2514: 
 2515:       const int idxNodeStart = nodeNeighNodesStart[i];
 2516:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2517:       node.numNodes = idxNodeEnd - idxNodeStart;
 2518:       node.nodes = nodeNeighNodes + idxNodeStart;
 2519:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2520: 
 2521: 
 2522: 
 2523:       const int idxElemStart = nodeNeighElemsStart[i];
 2524:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2525:       node.numElements = idxElemEnd - idxElemStart;
 2526:       node.elements = nodeNeighElems + idxElemStart;
 2527: 
 2528: 
 2529:       
 2530:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2531:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2532:          const int partNode = localNodePart[idxNodeGlobal]; 
 2533:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2534: 
 2535: 
 2536:          Node *node_ptr = nodes[partNode] + idxNode;
 2537:          
 2538:          nodeNeighNodes[idx] = node_ptr;
 2539:       }
 2540: 
 2541:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2542:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2543:          const int partElem = localElemPart[idxElemGlobal];
 2544:          const int idxElem  = localElemIndices[idxElemGlobal];
 2545: 
 2546:          Element *elem_ptr = elems[partElem] + idxElem;
 2547: 
 2548:          nodeNeighElems[idx] = elem_ptr;
 2549:       }      
 2550: 
 2551: 
 2552:       node.wind_angle = wind_rotate_angle[i];
 2553: 
 2554:       // Element **elements; // pointer to the elements connected to this node
 2555:       // int numElements;   // number of elements shared by this node
 2556: 
 2557:       node.p.x   = node_coords[i * 3];
 2558:       node.p.y   = node_coords[i * 3 + 1];
 2559:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2560:       node.depth = node_coords[i * 3 + 2];
 2561: 
 2562: 
 2563: 
 2564:       // Links the node to the boundary information
 2565:       if (isbnd[i] >= 0) {
 2566:        
 2567:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2568:          node.nodeBnd->node = &node;
 2569: 
 2570:          if (isbnd[i]>0) {
 2571: 
 2572:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2573:             node.nodeBnd->segment->ifltype = isbnd[i];
 2574: 
 2575:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2576:             node.nodeBnd->segment->clen  = nan("1");
 2577:             node.nodeBnd->segment->carea = nan("1");
 2578: 
 2579:          }
 2580:          else {
 2581:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2582:          }
 2583:          
 2584:          idxNodeBoundary++;
 2585:       }
 2586:       else {
 2587:          node.nodeBnd = nullptr;
 2588:       }
 2589: 
 2590: // XXXX
 2591: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2592: constexpr double rot_per = 3000.0;
 2593: constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2594: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2595: // XXXXX
 2596:    }
 2597: 
 2598:    nbp = idxNodeBoundary;
 2599: 
 2600:    printf("Processing %d sides\n", ns);
 2601:    int idxSideBoundary = 0;
 2602:    for (int i = 0; i < ns; i++)
 2603:    {
 2604:       Side &side = localSideData[i];
 2605:       side.idx = i;
 2606:       // finding the pointer to the nodes that form the side
 2607:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2608:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2609: 
 2610:       const int locidx_n1 = localNodeIndices[idx_n1];
 2611:       const int locidx_n2 = localNodeIndices[idx_n2];
 2612:       const int part_n1 =   localNodePart[idx_n1];
 2613:       const int part_n2 =   localNodePart[idx_n2];
 2614: 
 2615:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2616:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2617: 
 2618:       // Normal, unitary vector to the side
 2619:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2620:       side.n = normalize(side.n);
 2621: 
 2622:       // Side boundary type
 2623:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2624:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2625:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2626:       
 2627:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2628:       {
 2629:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2630:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2631:          else                  side.sideBnd->segment = n2bnd->segment;
 2632:          side.sideBnd->side = &side;
 2633:          idxSideBoundary++;
 2634:       }
 2635:       else side.sideBnd = nullptr;
 2636: 
 2637:       nbs = idxSideBoundary;
 2638: 
 2639:       // finding the pointer to the elements that share the side
 2640:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2641:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2642: 
 2643:       if (idx_e1 > -1) {
 2644:          const int locidx_e1 = localElemIndices[idx_e1];
 2645:          const int part_e1 =  localElemPart[idx_e1];
 2646:          side.elems[0] = elems[part_e1] + locidx_e1;
 2647:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2648:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2649:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2650:       }
 2651:       else {
 2652:          side.elems[0] = nullptr;
 2653:       }
 2654: 
 2655:       if (idx_e2 > -1) {
 2656:          const int locidx_e2 = localElemIndices[idx_e2];
 2657:          const int part_e2 =  localElemPart[idx_e2];
 2658:          side.elems[1] = elems[part_e2] + locidx_e2;
 2659:       }
 2660:       else {
 2661:          side.elems[1] = nullptr;
 2662:       }
 2663: 
 2664: 
 2665: 
 2666:       // Compute the center of the side
 2667:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2668: 
 2669: // XXXX
 2670: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2671: constexpr double rot_per=3000.0;
 2672: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2673: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2674: // XXXXX      
 2675: 
 2676:       // Compute the z level at the center of the side
 2677:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2678: 
 2679:       // Compute the length of the side
 2680:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2681:       side.length = sqrt(dot(vLen, vLen));
 2682: 
 2683:    }
 2684: 
 2685:    printf("Processing %d elements\n", ne);
 2686:    for (int i = 0; i < ne; i++)
 2687:    {
 2688:       Element &elem = localElemData[i];
 2689:       elem.idx = i;
 2690:       for (int j = 0; j < i34[i]; j++) {
 2691:          const int idxNode = elnode[i*4 + j];  
 2692:          const int idxSide = elside[i*4 + j];
 2693:          
 2694:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2695:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2696: 
 2697: 
 2698: 
 2699:          // Find the neighboring element  
 2700:          if (elem.sides[j]->elems[0] == &elem) {
 2701:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2702:          }
 2703:          else {
 2704:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2705:          }
 2706:          
 2707:       }
 2708: 
 2709:       elem.i34 = i34[i];
 2710: 
 2711: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2712: 
 2713:       // Compute the centroid of the element and its depth
 2714:       Vector2 center = {0.0, 0.0};
 2715:       elem.depth = 0.0;
 2716:       for (int j = 0; j < i34[i]; j++) {
 2717:          center += elem.nodes[j]->p2()/i34[i];
 2718:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2719:       }
 2720:       elem.center.x = center.x;
 2721:       elem.center.y = center.y;
 2722: 
 2723:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2724:       
 2725:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2726:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2727: 
 2728:       elem.area = elem.computeSignedArea(); 
 2729:       elem.radius = sqrt(elem.area)/pi; 
 2730:       
 2731:       // Determines which way the normal vector to each side is oriented.
 2732:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2733:       for (int j = 0; j < i34[i]; j++)  
 2734:       {
 2735:          if (elem.sides[j]->elems[0] == &elem) {
 2736:             elem.ssign[j] =  1.0;
 2737:          }
 2738:          else {
 2739:             elem.ssign[j] = -1.0;
 2740:          }
 2741: 
 2742:       }
 2743: 
 2744:       // Derivatives of shape functions
 2745:       //  For ics=2, this is done inside element/ll frame XXX
 2746:       //  For quads, the derivative is evaluated at centroid
 2747:       const int i34 = elem.i34;
 2748:       for (int j = 0; j < i34; j++) {
 2749:          const double area = elem.area;
 2750:          const int id2 = elem.nxq(1 + j);
 2751:          const int id3 = elem.nxq(2 + j);
 2752:          const int id4 = elem.nxq(3 + j);
 2753:          if (elem.isTri()) {
 2754:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2755:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2756:             // da1/dx = (y1 - y2)/(2*area)
 2757:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2758:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2759:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2760:          }
 2761:          else  { // Quad; evaluate at centroid
 2762:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2763:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2764:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2765:          } // if Tri
 2766: 
 2767:       } // for j
 2768: 
 2769:    }
 2770: 
 2771: 
 2772:    // Processing the boundary nodes
 2773:    int idx = 0;
 2774:    for (int iseg = 0; iseg < nope; iseg++) {
 2775:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2776: 
 2777:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2778: 
 2779:          nodeBnd->isEssentialBC = true;
 2780: nodeBnd->iettype = 3;
 2781:          nodeBnd->elbc = 0.0;
 2782: 
 2783:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2784:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2785:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2786:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2787:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2788:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2789:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2790: printf("nodeBnd->efa[%d] = %f, nodeBnd->emo[%d] = %f, nodeBnd->umo[%d] = %f, nodeBnd->ufa[%d] = %f, nodeBnd->vmo[%d] = %f, nodeBnd->vfa[%d] = %f\n", jfr, nodeBnd->efa[jfr], jfr, nodeBnd->emo[jfr], jfr, nodeBnd->umo[jfr], jfr, nodeBnd->ufa[jfr], jfr, nodeBnd->vmo[jfr], jfr, nodeBnd->vfa[jfr]);
 2791:          }
 2792: 
 2793:          idx++;
 2794:       }
 2795: 
 2796:    }
 2797: 
 2798: }
 2799: 
 2800: 
 2801: 
 2802: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2803:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2804:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2805:    // 
 2806:    // This kernel is called for all nodes.
 2807: 
 2808: 
 2809:    NODE(node1);
 2810: 
 2811: 
 2812:    node1->clearMatrixRow();
 2813:    node1->qel = 0.0;
 2814: 
 2815:    // THIS IS FOR STRUCTURES XXX
 2816:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2817: 
 2818:    
 2819:    for (int j=0; j<node1->numElements; j++) {
 2820:       // For each element connected to the node...
 2821: 
 2822:       Element *elem = node1->elements[j];
 2823: 
 2824:       // Compute the average gravity
 2825:       printf("UUU Node::grav2 = %f, %f, %f\n", elem->nodes[0]->grav2, elem->nodes[1]->grav2, elem->nodes[2]->grav2);
 2826:       const double grav3 = elem->mean(&Node::grav2);
 2827: 
 2828:       // Look at the documentation for the description of the terms in the following integrals
 2829: 
 2830:       // Integral I_1 
 2831:       // \bar{\breve{H}} 
 2832:       const double hhatb = elem->mean(&Side::hhat);        
 2833: 
 2834: 
 2835:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2836: 
 2837:       const int id1 = elem->nodeLocalIdx(node1); 
 2838:       const double area = elem->area;
 2839: 
 2840:       if (elem->isTri()) {
 2841: 
 2842:          // To clarify the notation in this section: 
 2843:          //   i stands for the node under consideration (node1)
 2844:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2845:          const int id2 = elem->nxq(1 + id1);
 2846:          const int id3 = elem->nxq(2 + id1);
 2847:          Node *node2 = elem->nodes[id2];
 2848:          Node *node3 = elem->nodes[id3];
 2849: 
 2850:          const Point2 x1 = node1->p2();
 2851:          const Point2 x2 = node2->p2();
 2852:          const Point2 x3 = node3->p2();
 2853: 
 2854:          // integral of phi_i*phi_j
 2855:          const double ipp_ii = (1.0/6.0 )*area;
 2856:          const double ipp_ij = (1.0/12.0)*area;
 2857:          const double ipp_ik = (1.0/12.0)*area;
 2858: 
 2859:          // integral of [(grad phi_i) * (grad phi_j)]
 2860:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2861:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2862:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2863: 
 2864:          // Computes the different components of integral I_1 of each node with respect to node i.
 2865:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2866:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2867:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2868: 
 2869: if (j==node1->numElements-1) {
 2870: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2871: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2872: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2873: }
 2874: 
 2875:          node1->addToSparseMatrix(node1, I1_ii);
 2876:          node1->addToSparseMatrix(node2, I1_ij); 
 2877:          node1->addToSparseMatrix(node3, I1_ik);
 2878: 
 2879: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2880:      
 2881:       }
 2882:       else { // Quad
 2883:          // XXX IMPLEMENT THIS
 2884:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2885:       } 
 2886: 
 2887:  
 2888:       // Integral I_4
 2889:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2890:       // Where
 2891:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2892: 
 2893:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2894:       // of U over the element.
 2895:       Vector2 Umean = {0.0, 0.0};
 2896:       for (int m=0; m<elem->i34; m++) {      
 2897:          const Side *side = elem->sides[m];
 2898: 
 2899:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2900:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2901:       }
 2902:       Umean = Umean/elem->i34;
 2903: 
 2904:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2905: 
 2906:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2907:       const double I_4_1 = dot(gradPhi_1, Umean);
 2908: 
 2909:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2910:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2911:      
 2912:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2913: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2914: 
 2915:       // Additional terms 
 2916:       double vnorm = 0.0;
 2917:       if (imm == 2)  { // Pre-compute vnorm on the element
 2918:          Vector3 ubed;
 2919:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2920: 
 2921:          Vector3 gradP = {0.0, 0.0, 1.0};
 2922:          for (int m=0; m < elem->i34; m++) {
 2923:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2924:            gradP += toVector3(gradP_2D, 0.0);
 2925:          }   
 2926:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2927:       } // imm==2
 2928: 
 2929:       if (elem->isTri()) {
 2930:          for (int l=0; l<3; l++) {
 2931:            double fac;
 2932: 
 2933:            Node *node = elem->nodes[l];
 2934: 
 2935:            (node == node1)? fac=2.0 : fac=1.0;
 2936: 
 2937:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2938:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2939:            
 2940:          }
 2941: 
 2942: 
 2943:          if (!elem->isDry) {
 2944:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2945:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2946:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2947: 
 2948:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2949:          }
 2950: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2951: 
 2952:       } // isTri
 2953:       else { // isQuad
 2954:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2955:          // for (int l=0; l<4; l++) {
 2956:          //   const Node *node = elem->nodes[l];
 2957: 
 2958:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2959:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2960: 
 2961:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2962:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2963:          // }
 2964: 
 2965:       } // isQuad
 2966: 
 2967: 
 2968:       node1->qel += (dt/elem->i34)*elem->vsource;
 2969:       
 2970: 
 2971:    } // for all elements connected to the node
 2972:    
 2973: 
 2974: 
 2975:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 2976:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 2977:    NodeBoundary *nodeBnd = node1->nodeBnd;
 2978:    if (nodeBnd != nullptr)  { 
 2979:       // If it is an open boundary node...
 2980: 
 2981:       // At least one open bnd side, maybe two
 2982:       for (int l=0; l<2; l++) { 
 2983: 
 2984:          // Gets each of the sides sharing the node. 
 2985:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 2986: 
 2987:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 2988: 
 2989:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 2990: 
 2991: 
 2992:          if (sideBnd != nullptr) {
 2993:             // If the side is on a boundary...
 2994: 
 2995:             // Get the boundary segment
 2996:             const BoundarySegment *sideSegment = sideBnd->segment;
 2997:             const Side *side = sideBnd->side;
 2998: 
 2999:             // Integral I_3
 3000:             if (sideSegment->ifltype != 0) {
 3001:             // Natural or Flather b.c.
 3002: 
 3003:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3004:                // especially for Flather b.c.
 3005:                double ri3 = 0.0;
 3006:                if (!side->isDry) {
 3007:                   // If the side is not dry
 3008:                   
 3009:                   // Computes the side flux of (uth, vth)
 3010:                   double Vn = 0.0;
 3011:                   for (int k = side->kb; k<nvrt-1; k++) {
 3012:                      // uth, vth in lat/lon frame if ics=2
 3013:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3014:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 3015:                      const double vn2 = dot(side->uth[k+1], side->n);
 3016: 
 3017:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3018:                   }
 3019: 
 3020:                   ri3 = 0.5*side->length*Vn;
 3021:                }
 3022: 
 3023:                if (sideSegment->ifltype == -1) { // Flather 1
 3024: 
 3025:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3026:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3027: 
 3028:                   const double con0 = (1.0/6.0)*side->length*sqrt(grav*side->depth()); // For coefficient matrix
 3029:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3030:                   
 3031:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3032:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3033: 
 3034:                } 
 3035:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3036:                   // Reset ri3
 3037:                   ri3 = 0.0;
 3038: 
 3039:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3040: 
 3041:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3042: 
 3043:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3044:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3045: 
 3046:                   const double con0 = (1.0/6.0)*side->length*tmp*thetai*dt;
 3047:                   node1->addToSparseMatrix(node1, con0*2.0);
 3048:                   node1->addToSparseMatrix(node2, con0);
 3049: 
 3050:                } // if Flather or Discharge
 3051: 
 3052:                node1->qel -= thetai*dt*ri3;
 3053: 
 3054:             } // I_3
 3055:           
 3056: 
 3057:             // Integral I_5
 3058:             if(!side->isDry) {
 3059: 
 3060:                const double Unbar = dot(side->U, side->n);
 3061: 
 3062:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->length*Unbar;
 3063:                
 3064:             } // I_5
 3065: 
 3066:          } // if is boundary side
 3067: 
 3068:       } // for l
 3069: 
 3070:    } // if isbnd
 3071: 
 3072: 
 3073:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3074: 
 3075: }
 3076: 
 3077: 
 3078: 
 3079: extern "C" {
 3080:    __global__ void rollUpElevation(void) {
 3081: 
 3082:       NODE(node);
 3083: 
 3084:       node->eta2 += node->eta1;
 3085: 
 3086:    }
 3087: 
 3088: 
 3089:    __global__ void backtrackAllNodes(void) {
 3090: 
 3091:       // max/min # of sub-divisions
 3092:       const int ndelt_max = max(1.0, dt/dtb_min);
 3093:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3094: 
 3095:       // Removed all references to swild98 XXX
 3096:       // swild98=0.d0 !init
 3097: 
 3098: 
 3099:       SIDE(side);
 3100: 
 3101:       const int kb = side->kb;
 3102: 
 3103:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 3104: 
 3105:       // Initialize btrack velocities to the actual velocities at the side 
 3106:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3107: 
 3108: 
 3109:       if (side->isDry) return;
 3110: 
 3111: 
 3112:       // Checks that at least one element is not dry
 3113:       const Element *elem1 = side->elems[0];
 3114:       const Element *elem2 = side->elems[1];
 3115: 
 3116: 
 3117:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3118:       
 3119:       // XXXXXX
 3120:       // !swild_tmp to store global coord. of the starting side
 3121:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3122:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3123:       // !Use sframe2 
 3124:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3125: 
 3126: 
 3127:       for (int k = kb; k < nvrt; k++) {
 3128:       //  Initialize (xt,yt,zt), nnel and vel.
 3129:       //  For ics=2, the coordinates are in local frames
 3130:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3131: 
 3132: 
 3133:          const int iadvf = side->iadv();  // Advection flag
 3134: 
 3135:          Point3 xt;
 3136:          if constexpr(ics==1) {
 3137:             xt = side->center3D(k); 
 3138:          }
 3139:          else // lat/lon; in side lat/lon frame
 3140:          {
 3141:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3142:          // XXX IMPLEMENT THIS
 3143:       //          xt=0.d0
 3144:       //          yt=0.d0
 3145:       //          !centroid coord. for nudging
 3146:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3147:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3148:          }  // ics
 3149: 
 3150: 
 3151:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3152:          // XXX IS THIS NECESSARY?
 3153:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3154: 
 3155:          // If on land or open boundary...
 3156:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3157:          
 3158:          const double vmag = length(toVector2(u_int));
 3159: 
 3160: printf("XXX backtrackAllNodes: side->idx = %d, vmag = %f\n", side->idx, vmag);
 3161: 
 3162:          if (vmag <= velmin_btrack) {
 3163:             // No activity 
 3164: 
 3165:             side->btu[k] = side->u2[k];
 3166: 
 3167:             
 3168:          } else {  // do btrack
 3169: 
 3170:           
 3171:             // Compute number of sub-divisions based on local gradients 
 3172:             // XXX IS THIS NECESSARY?
 3173:             double suma = 0.0;
 3174:             int icount = 0;
 3175:             for (int ii=0; ii<2; ii++) {
 3176: 
 3177:                const Element *elem = side->elems[ii];
 3178:                  
 3179:                if (elem == nullptr) continue;
 3180: 
 3181:                icount++;
 3182: 
 3183:                // Not strictly along z; in ll frame for ics=2
 3184: 
 3185:                double utmp[4];
 3186:                double vtmp[4];
 3187:                for (int jj = 0; jj < elem->i34; jj++) {
 3188: 
 3189:                   const Node *node = elem->nodes[jj];
 3190: 
 3191:                   if constexpr(ics==1) {
 3192:                      utmp[jj] = node->u2[k].x;
 3193:                      vtmp[jj] = node->u2[k].y;  
 3194:                   } else {
 3195:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3196:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3197:                   }
 3198:                } // for jj
 3199: 
 3200:                const Vector2 grad_u = elem->grad2(utmp); 
 3201:                const Vector2 grad_v = elem->grad2(vtmp);
 3202: 
 3203:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3204:             } // for ii
 3205: 
 3206:             assert(icount > 0 && "Impossible 77");
 3207: 
 3208:             // '4' is somewhat arbitrary
 3209:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3210: 
 3211:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3212:          
 3213: 
 3214:             Vector3 u_int = {0.0, 0.0, 0.0};
 3215: 
 3216:             side->btrack(k, dt, dtbk, u_int);
 3217: 
 3218:                
 3219:          } // if vmag (do backtrack)
 3220: 
 3221:       } // for j=jmin,nvrt-1
 3222: 
 3223:    }
 3224: } // extern "C"
 3225: 
 3226: template<int nc>
 3227: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3228: 
 3229: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3230: //
 3231: // a,b,c,rhs: input vectors and are not modified by this program.
 3232: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3233: // rhs is the r.h.s.
 3234: // n: actual rank of the system.
 3235: // rows in u() and rhs();
 3236: // u: output with nc columns (transposed to rows)
 3237: // gam: a working array.
 3238: //
 3239: // NOTES:
 3240: // This is a template function that allows for different numbers of columns in the rhs vector.
 3241: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3242: 
 3243:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3244:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3245: 
 3246:    double bet = b[0];
 3247:    if constexpr (nc == 1) {
 3248:       u[0] = rhs[0]/bet;
 3249:    } else {
 3250:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3251:    }
 3252: 
 3253:    for (int j = 1; j < n; j++) {
 3254:       gam[j] = c[j-1]/bet;
 3255:       bet = b[j] - a[j]*gam[j];
 3256: 
 3257:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3258: 
 3259:       if constexpr (nc == 1) {
 3260:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3261:       } else {
 3262:          for (int k = 0; k < nc; k++) {
 3263:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3264:          }
 3265:       }
 3266:    }
 3267: 
 3268:    // Back-substitution
 3269:    for (int j=n-1; j>=1; j--) {
 3270:       if constexpr (nc == 1) {
 3271:          u[j] = u[j] - gam[j+1]*u[j-1];
 3272:       } else {
 3273:          for (int k = 0; k < nc; k++) {
 3274:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3275:          }
 3276:       }
 3277:    }
 3278: }
 3279: 
 3280: 
 3281: 
 3282: // Helper function that contains the core algorithm
 3283: template<typename XAccessor, typename YAccessor>
 3284: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3285:                                     double  yp_top, double  yp_bot, 
 3286:                                     CubicSpline &spline) {
 3287:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3288:    // 
 3289:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3290:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3291:    //
 3292:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3293:    // 
 3294:    // Inputs: 
 3295:    //            n: dimension for x etc; # of data pts (>=2);
 3296:    //            getX, getY: functions to access x,y coordinates
 3297:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3298:    //     Output: 
 3299:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3300: 
 3301:    const int n = k2 - k1 + 1;
 3302:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3303: 
 3304:    // Allocate memory for the splines
 3305:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3306:    spline.x   = new double[n];
 3307:    spline.y   = new double[n];
 3308:    spline.yp  = new double[n];
 3309:    spline.ypp = new double[n];
 3310: 
 3311:    for (int k=k1; k<=k2; k++) {
 3312:       spline.x[k] = getX(k);
 3313:       spline.y[k] = getY(k);
 3314:    }
 3315: 
 3316:    // This is to simplify expressions later
 3317:    double *x = spline.x;
 3318:    double *y = spline.y;
 3319: 
 3320:    double *a = nullptr;
 3321:    double *b = nullptr;
 3322:    double *c = nullptr;
 3323:    double *gam = nullptr;
 3324:    double *rhs = nullptr;
 3325:    
 3326: 
 3327:       a = new double[n];   // Lower diagonal
 3328:       b = new double[n];   // Diagonal
 3329:       c = new double[n];   // Upper diagonal
 3330:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3331:       rhs = new double[n]; // Right-hand side
 3332: 
 3333:    for (int k=k1; k<=k2; k++) {
 3334:       if (k == k1) {
 3335:          // Bottom level
 3336:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3337:          b[k] = (x[k+1] - x[k])/3.0;
 3338:          c[k] = b[k]/2.0;
 3339:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3340:       } else if (k == n - 1) {
 3341:          // Top level (surface)
 3342:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3343:          b[k] = (x[k] - x[k-1])/3.0;
 3344:          a[k] = b[k]/2.0;
 3345:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3346:       } else {
 3347:          // Intermediate levels
 3348:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3349:          b[k] = (x[k+1] - x[k-1])/3.0;
 3350:          a[k] = (x[k  ] - x[k-1])/6.0;
 3351:          c[k] = (x[k+1] - x[k  ])/6.0;
 3352:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3353:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3354:       }
 3355:    }
 3356: 
 3357:    // Solve the tridiagonal system
 3358:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3359:    
 3360:    spline.yp[k1] = yp_bot;
 3361:    spline.yp[k2] = yp_top;
 3362: 
 3363:    // Compute rest of 1st derivatives using the splines
 3364:    for (int k=k1+1; k<k2; k++) {
 3365:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3366:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3367:    }
 3368:    
 3369:    delete[] a;
 3370:    delete[] b;
 3371:    delete[] c;
 3372:    delete[] gam;
 3373:    delete[] rhs;
 3374: 
 3375: }
 3376: 
 3377: // Array version
 3378: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3379:                                 double y_top, double y_bot, 
 3380:                                 CubicSpline &spline) {
 3381:    auto getX = [x] (int k) { return x[k]; };
 3382:    auto getY = [y] (int k) { return y[k]; };
 3383:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3384: }
 3385: 
 3386: // Lambda version - allows custom access patterns
 3387: template<typename XFunc, typename YFunc>
 3388: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3389:                                 double y_top, double y_bot,
 3390:                                 CubicSpline &spline) {
 3391:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3392: }
 3393: 
 3394: 
 3395: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3396: {
 3397:    assert("Not implemented");
 3398: 
 3399:    return 0.0;
 3400: }
 3401: 
 3402: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 3403: // //     Routine to do vertical linear interpolation in z
 3404: // //     Inputs:
 3405: // //
 3406: // //       nc: actual # of variables 
 3407: // //       k1,k2: lower and upper limits for za, s_in 
 3408: // //       zt: desired interpolation level
 3409: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 3410: // //       s_in[0:nc-1,0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 3411: 
 3412: // //     Outputs:
 3413: // //       s_out[0:nc-1]: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 3414: // //                   is used below bottom or above surface.
 3415: // //       ibelow: flag indicating if zt is below za(k1)
 3416: // //
 3417: 
 3418: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 3419: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 3420:    
 3421: //    ibelow = 0;
 3422: 
 3423: //    if (zt < za[k1]) {
 3424: //       // Below bottom
 3425: //       ibelow = 1;
 3426: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k1*nc];
 3427: 
 3428: //    } else if(zt>=za[k2]) {
 3429: //       // Above surface
 3430: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k2*nc];
 3431: 
 3432: //    } else {
 3433: //       // Normal case (between bottom and surface)
 3434:       
 3435: //       // Finds the level index using binary search
 3436: //       int l1 = k1;
 3437: //       int l2 = k2;
 3438: //       int k = (l1 + l2)/2;
 3439: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 3440: //           int k = (l1 + l2)/2;
