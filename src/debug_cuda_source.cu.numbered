 3026: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3027:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3028:    if constexpr(ics == 1) { 
 3029:       return 0.5*(n1->tau + n2->tau);
 3030: 
 3031:    } else {
 3032:       // Project the tau from the node frames to the side frame
 3033:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3034:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3035: 
 3036:       return 0.5*(stau1 + stau2);
 3037: printf("tau = (%f, %f)\n", stau1.x, stau1.y);
 3038:    }
 3039: }
 3040: 
 3041: /**
 3042:  * This method performs backtracking from the side center until a time -dt back in time 
 3043:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3044:  * intermediate point.
 3045:  *
 3046:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3047:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3048:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3049:  * remaining time.
 3050:  * 
 3051:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3052:  * 
 3053:  * @param uuint, vvint, wwint: Velocities at the final point
 3054:  * @param jlev: Level at which the backtracking is performed
 3055:  * @param dt, dtbk: Tracking timesteps
 3056:  * @return: True if the backtracking was successful, false otherwise
 3057:  */
 3058: __inline__ __device__ bool Side::btrack(
 3059:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3060:       double dt,            // Tracking time
 3061:       double dtbk,          // Tracking timestep
 3062:       Vector3 &u_int        // Velocities at the initial point
 3063: ) const {
 3064: 
 3065:    // Start from side center
 3066:    Point3 x0;
 3067: 
 3068:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3069:    else                   x0 = {0.0, 0.0, zc[jlev]};
 3070: 
 3071:  
 3072:    double time_rm = dt; // Remaining time
 3073: 
 3074: 
 3075:    // Initial velocities
 3076:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3077: 
 3078:    // Find the element that is in the direction opposite to the velocity
 3079:    Element* curElem = findElementTowards(toVector2(u_int));
 3080:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3081: if (idx == 15876) printf("curElem->idx = %d\n", curElem->idx);
 3082:    // If debugging backtracking, add the starting point to the debug plot and the elements for
 3083:    // idx == 15876
 3084:    if (idx == 15876) {
 3085:       printf("PPP u_int = (%f, %f, %f)\n", u_int.x, u_int.y, u_int.z);
 3086:       const Point3 orig = toPoint3(center, centerZ());
 3087:       auto vertexInOriginalFrame = [this, orig, jlev](const Node *node) -> Point3 {
 3088:          if constexpr(ics == 1) {
 3089:             return toPoint3(node->p, 0.0);
 3090:          } else {
 3091:             const Point3 p_glob = toPoint3(node->p, node->gz);
 3092:             const Vector3 loc = frame.G2L(p_glob - orig);
 3093:             return Point3(loc.x, loc.y, 0.0);
 3094:          }
 3095:       };
 3096:       auto elementInOriginalFrame = [this, orig, jlev](const Element *elem) -> Point3 { 
 3097:          if constexpr(ics == 1) {
 3098:             return toPoint3(elem->center, elem->centerZ());
 3099:          } else {
 3100:             const Point3 center_glob = toPoint3(elem->center, elem->centerZ());
 3101:             const Vector3 loc = frame.G2L(center_glob - orig);
 3102:             return Point3(loc.x, loc.y, loc.z);
 3103:          }
 3104:       };
 3105:       auto plotTriangle = [&vertexInOriginalFrame, &elementInOriginalFrame](const Element *elem, unsigned int color) {
 3106:          if (elem == nullptr || !elem->isTri()) return;
 3107:          const Point3 v0 = vertexInOriginalFrame(elem->nodes[0]);
 3108:          const Point3 v1 = vertexInOriginalFrame(elem->nodes[1]);
 3109:          const Point3 v2 = vertexInOriginalFrame(elem->nodes[2]);
 3110:          const Point3 center = elementInOriginalFrame(elem);
 3111:          addDebugPlot(v0, v1, color, 'o', elem->nodes[0]->idx);
 3112:          addDebugPlot(v1, v2, color, 'o', elem->nodes[1]->idx);
 3113:          addDebugPlot(v2, v0, color, 'o', elem->nodes[2]->idx);
 3114:          addDebugPlot(center, center, color, 'o', elem->idx);
 3115:       };
 3116:       plotTriangle(curElem, 0xFF0000u);  // current element in red
 3117:       plotTriangle(curElem->nghbElems[0], 0x00A000u);
 3118:       plotTriangle(curElem->nghbElems[1], 0x00A000u);
 3119:       plotTriangle(curElem->nghbElems[2], 0x00A000u);
 3120: 
 3121:       // Add the initial point (0,0) to the debug plot
 3122:       addDebugPlot(Point3(0.0, 0.0, 0.0), Point3(0.0, 0.0, 0.0), 0x0000FFu, '+');
 3123:    }
 3124: 
 3125:    // Nudges it towards the barycenter
 3126:    curElem->nudgeToBarycenter(toPoint2(x0), this); // XXXX Necessary?
 3127: if (idx == 15876) addDebugPlot(Point3(0.0, 0.0, 0.0), x0, 0xFF00FFu, 'o');
 3128: 
 3129: 
 3130:    const int MAX_ITERATIONS = 100; 
 3131:    Element* nextElem = nullptr;
 3132:    int iter = 0;
 3133:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3134:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3135:    while(true) {
 3136: 
 3137:       // Calculate timestep
 3138:       double dtb = min(dtbk, time_rm);
 3139: 
 3140: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 3141: 
 3142:       // Next point in the backtracking curve
 3143: // if (iter >= MAX_ITERATIONS - 50)  {
 3144: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 3145: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 3146: // }
 3147:         
 3148:       xt = x0 - dtb*u_int;
 3149: // printf("curElem->idx = %d, x0 = (%f, %f, %f), xt = (%f, %f, %f)\n", curElem->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3150:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 3151: if (idx == 15876) addDebugPlot(x0, xt, 0xFF00FFu, '+');
 3152: if (!found) {if (idx == 15876) printf("1111\n"); return true;}
 3153:       assert(found && "Backtracking failed in btrack");
 3154: 
 3155: 
 3156:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 3157:                       // then time_rm needs to be increased by the unused time.
 3158: 
 3159:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 3160: 
 3161:       // If the velocity is too small, we stop the backtracking
 3162:       const double vmag = length(toVector2(u_int));
 3163:       if (vmag <= velmin_btrack) break;
 3164: 
 3165:       // The current point becomes the next segment's starting point.
 3166:       x0 = xt;
 3167:  
 3168:       curElem = nextElem;
 3169: 
 3170:       iter++;
 3171: 
 3172:       if (iter >= MAX_ITERATIONS) break;
 3173: 
 3174:       // if (iter >= MAX_ITERATIONS - 50) {
 3175:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 3176:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 3177:       //    }
 3178:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3179:    }
 3180: 
 3181:    assert(!curElem->isDry && "Final element is dry");
 3182:    assert(curElem->containsPoint(toPoint2(xt), this) && "Target point is not inside the final element"); 
 3183: 
 3184:    // Interpolate the velocities at the final point
 3185:    u_int = curElem->interpolateVelocities(xt, this);
 3186: 
 3187:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 3188: 
 3189: 
 3190: }
 3191: 
