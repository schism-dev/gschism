 9724: 
 9725: __global__ void returnMatrix(double *res) {
 9726:    // Debugging: dense local matrix, row-major, size = mesh->np
 9727:    // Assumes single-partition / local indexing (see note below).
 9728: 
 9729:    const int size = mesh->np;
 9730: 
 9731:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9732:       const Node *node = mesh->localNodeData + idx_node;
 9733: 
 9734:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9735: 
 9736:       for (int j = 0; j < node->numNodes; j++) {
 9737:          const Node *nbNode = node->nodes[j];
 9738:          // Only dump neighbors that live on this partition
 9739:          if (nbNode->part != mesh->partNum) continue;
 9740: 
 9741:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9742:          const double aij = node->coeffRow[node->csrSlot[j]];
 9743:          if (aij != 0.0)
 9744:             res[jlocal * size + idx_node] = aij;
 9745:       }
 9746:    }
 9747: }
