  185: // eta coordinates of the nodes (idxNode = 0,1,2,3)
  186: __device__ __forceinline__ double eta_n(int idxNode) {
  187:    // bit1: 0 -> -1, 1 -> +1
  188:    assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  189:    return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  190: }
  191: 
  192: // xi coordinates of the nodes (idxNode = 0,1,2,3)
  193: __device__ __forceinline__ double xi_n(int idxNode) {
  194:    // +1 if (bit0 XOR bit1), else -1
  195:    assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  196:    return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  197: 
  198: }
