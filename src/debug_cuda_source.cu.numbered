 2283: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2284: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2285: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2286: // Only when ics == 2, the origin is at the element center.
 2287: 
 2288:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2289: 
 2290:    const Node *node = nodes[idxNode];
 2291: 
 2292:    if constexpr(ics==1) {
 2293:       return node->p;
 2294: 
 2295:    } else {
 2296:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2297: 
 2298:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2299: 
 2300:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2301:    }
 2302: 
 2303: }
 2304: 
 2305: 
 2306: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2307: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2308: 
 2309:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2310: 
 2311:    const int id1 = idx;
 2312:    const int id2 = nxq(1 + id1);
 2313:    const int id3 = nxq(2 + id1);
 2314: 
 2315:    if constexpr(ics==1) {
 2316:       x0 = nodes[id1]->p;
 2317:       x1 = nodes[id2]->p;
 2318:       x2 = nodes[id3]->p;
 2319: 
 2320:    } else {
 2321:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2322: 
 2323:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2324:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2325:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2326: 
 2327:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2328:       x1 = toVector2(frame.G2L(p1 - c));
 2329:       x2 = toVector2(frame.G2L(p2 - c));
 2330: 
 2331:    }
 2332: 
 2333: }
 2334: 
 2335: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2336: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2337: 
 2338:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2339: 
 2340:    if constexpr(ics==1) {
 2341:       x0 = nodes[0]->p;
 2342:       x1 = nodes[1]->p;
 2343:       x2 = nodes[2]->p;  
 2344:       x3 = nodes[3]->p;
 2345: 
 2346:    } else {
 2347:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2348: 
 2349:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2350:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2351:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2352:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2353: 
 2354:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2355:       x1 = toVector2(frame.G2L(p1 - c));
 2356:       x2 = toVector2(frame.G2L(p2 - c));
 2357:       x3 = toVector2(frame.G2L(p3 - c));
 2358:    }
 2359: 
 2360: }
 2361: 
 2362: 
 2363: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2364: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2365: // Returns the normal vector and the area of the element at this level
 2366: 
 2367:    double nx, ny, nz;
 2368: 
 2369:    if (isTri()) {
 2370:       // For triangles...
 2371: 
 2372:       // Indices of the nodes at level k, taking care of not going below the bed
 2373:       const int k0 = max(k, nodes[0]->kb);
 2374:       const int k1 = max(k, nodes[1]->kb);
 2375:       const int k2 = max(k, nodes[2]->kb);
 2376: 
 2377:       // Gets the element frame coordinates of the nodes at level k
 2378:       Point3 x0, x1, x2;
 2379:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2380:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2381:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2382:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2383: 
 2384:       } else {  // ics == 2
 2385:          Point2 h0, h1, h2;
 2386: 
 2387:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2388: 
 2389:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2390:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2391:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2392:       }
 2393: 
 2394:       const Vector3 n20 = x2 - x0;
 2395:       const Vector3 n10 = x1 - x0; 
 2396: 
 2397:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2398:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2399:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2400:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2401:   
 2402:    }
 2403:    else {
 2404:       // For quads...
 2405:       Point2 h0, h1, h2, h3;
 2406: 
 2407:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2408: 
 2409:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2410:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2411:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2412:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2413: 
 2414:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2415:       nx = n20.y*n31.z - n20.z*n31.y;
 2416:       ny = n20.z*n31.x - n20.x*n31.z;
 2417:       nz = n20.x*n31.y - n20.y*n31.x;
 2418: 
 2419:    }
 2420: 
 2421:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2422:    area3D = 0.5*len;
 2423: 
 2424:    const double inv_len = 1.0/len;
 2425: 
 2426:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2427: 
 2428: }
 2429: 
 2430: /**
 2431:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2432:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2433:    If the segment is completely inside the element, then it returns true.
 2434: 
 2435:    This function assumes:
 2436:    - The initial point is on a side of the element. 
 2437:    - Its position is given by parameter t in the range [0,1].
 2438:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2439:       intersects the element (elements are convex).
 2440: 
 2441:    To find the intersection point, this function does the following:
 2442:    - it finds the intersection of the line segment with all the element side lines,
 2443:       except for the one that contains the initial point.
 2444:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2445:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2446:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2447:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2448:       track segment is almost parallel to the element side line.
 2449: 
 2450:    Inputs:
 2451:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2452:    @param x2, y2: other end of the line segment
 2453: 
 2454:    Outputs:
 2455:    @param side:  side that intersects the line segment (input and output)
 2456:    @param nextElement (output): element that contains the intersection point
 2457:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2458:    @param zint (input/output): Vertical coordinate of the intersection point
 2459: 
 2460:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2461:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2462:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2463: 
 2464:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2465:    (Delta) being zero.
 2466: 
 2467:    The intersection2 point happens when:
 2468:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2469:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2470:    
 2471:    Assumption: the 4 points (including those of the side segment) are different.
 2472:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2473:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2474:    If true, (xIntersect,yIntersect) is the intersection.				
 2475:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2476: **/
 2477: 
 2478: 
 2479: __device__ void Element::findNextIntersection(Point2 x1, Point2 x2, 
 2480:                                               ShapeCoords &shpXt, Point2 &xt, const int jlev,
 2481:                                               Side *&side, Element *&nextElement,
 2482:                                               double &t, double& tIntersect, const Side *origSide) {
 2483: 
 2484:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1");
 2485: 
 2486:    assert(isTri() && "findNextIntersection may be only implemented for triangular elements");
 2487: 
 2488:    double closest_intersect_t = 1e10;
 2489:    int idxSide = -1;
 2490: 
 2491:    for (int i = 0; i < i34; i++) {
 2492: 
 2493:       Side *side2 = sides[i];
 2494: 
 2495:       // (x3,y3)-(x4,y4) is the element side line
 2496:       Point2 x3 = side2->n1->p;
 2497:       Point2 x4 = side2->n2->p;
 2498: 
 2499:       if constexpr(ics==2) {
 2500:          
 2501:          x3 = toPoint2(origSide->toLocalFrame(toPoint3(x3, side2->n1->gz))); 
 2502:          x4 = toPoint2(origSide->toLocalFrame(toPoint3(x4, side2->n2->gz))); 
 2503: 
 2504:       }
 2505: 
 2506:       // delta is 0 if the two lines are parallel. In this case, they do not intersect unless they are colinear.
 2507:       const double delta = cross(x2 - x1, x3 - x4);
 2508: 
 2509: 
 2510: const double deltaW = cross(x2 - x1, x3 - x1);
 2511: 
 2512: if (origSide->idx == ORIG_SIDE_IDX && jlev == ORIG_SIDE_JLEV) printf(">> 1.1 findNextIntersection: deltaW = %.17f, delta = %.17f\n", deltaW, delta);
 2513: // const Vector2 v0 = rot90(x2 - x1);
 2514: // const Vector2 v1 = x3 - x1;
 2515: // const Vector2 v2 = x4 - x1;
 2516: // const double dot01 = dot(v0, v1);
 2517: // const double dot02 = dot(v0, v2);
 2518: 
 2519: // if (abs(delta) < 1e-6) printf("XXX >> 1.25 findNextIntersection: idx = %d, jlev = %d, dot01 = %.17f, dot02 = %.17f\n", this->idx, jlev, dot01, dot02);
 2520: 
 2521:       if (abs(delta) > 0) {
 2522: 
 2523:          const double delta1 = cross(x3 - x1, x3 - x4);
 2524:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2525: 
 2526:          // Solves the two linear equations for tt1 and tt2
 2527:          double tt1 = delta1/delta; // delta is not zero, so we can divide
 2528:          double tt2 = delta2/delta;
 2529: if (abs(delta2)<1e-8 && abs(delta)<1e-8) { tt1 = 1.0; tt2 = length(x2 - x3)/length(x4 - x3); }
 2530: if (origSide->idx == ORIG_SIDE_IDX && jlev == ORIG_SIDE_JLEV) 
 2531:    printf(">> 1.2 findNextIntersection: delta = %.17f, delta1 = %.17f, delta2 = %.17f, tt1 = %.17f, tt2 = %.17f, x3 = (%.17f, %.17f), x4 = (%.17f, %.17f), this->idx = %d\n", delta, delta1, delta2, tt1, tt2, x3.x, x3.y, x4.x, x4.y, this->idx);
 2532:          if (tt1 >= -small && tt1 < closest_intersect_t) { //} && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2533:             closest_intersect_t = tt1;
 2534:             side = side2;
 2535:             nextElement = side->otherElem(this);
 2536: 
 2537:             // If the element at the other side is null or dry, we stay in the same element.
 2538:             // The situation will be dealt with in trackGoesOutOfWater.
 2539:             if (nextElement == nullptr || nextElement->isDry) nextElement = this;
 2540: 
 2541:             t =          clamp(tt2, small, 1.0-small);
 2542: 
 2543: // if (tt1>1.0) {
 2544: //    tt1 = 1.0;
 2545: //    t = length(x2 - x3)/length(x4 - x3);
 2546: 
 2547: // printf(">> 1.3 findNextIntersection: idx = %d, jlev = %d, delta = %.17f, t = %.17f, tt1 = %.17f\n", this->idx, jlev, delta, t, tt1);
 2548: // }
 2549:             tIntersect = clamp(tt1, small, 1.0-small);
 2550:             idxSide = i;
 2551:             xt = x3 + t*(x4 - x3);
 2552:          }
 2553: 
 2554:       
 2555:       }
 2556:       else {  // parallel segments
 2557: 
 2558:          // continue; 
 2559:          assert(false && "Parallel segments should not happen under the new code");
 2560:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 2561:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 2562: 
 2563:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2564:          const double dist = dot(x1 - x3, side2->n);
 2565:          if (abs(dist) < small*length(x3 - x4)) {
 2566:             const double2 unitarySide = normalize(x4 - x3);
 2567:             const double len = dot(x2 - x1, unitarySide);
 2568:             t = t + len;
 2569:             t = max(0.0, min(t, 1.0));
 2570:             xt = x1 + t*(x2 - x1);  // REMEMBER!!! 
 2571: 
 2572:          }
 2573:       }
 2574: 
 2575: 
 2576:    }
 2577: if (origSide->idx == ORIG_SIDE_IDX && jlev == ORIG_SIDE_JLEV) printf(">> 1.5 findNextIntersection: t = %.17f, tIntersect = %.17f, shpXt = (%.17f, %.17f, %.17f), x1 = (%.17f, %.17f), x2 = (%.17f, %.17f), origSide->idx = %i\n", t, tIntersect, shpXt[0], shpXt[1], shpXt[2], x1.x, x1.y, x2.x, x2.y, origSide->idx);
 2578: if (idxSide == -1) {
 2579: for (int i = 0; i < i34; i++) {
 2580: 
 2581:       Side *side2 = sides[i];
 2582: 
 2583:       // (x3,y3)-(x4,y4) is the element side line
 2584:       Point2 x3 = side2->n1->p;
 2585:       Point2 x4 = side2->n2->p;
 2586: 
 2587:       if constexpr(ics==2) {
 2588:          
 2589:          x3 = toPoint2(origSide->toLocalFrame(toPoint3(x3, side2->n1->gz))); 
 2590:          x4 = toPoint2(origSide->toLocalFrame(toPoint3(x4, side2->n2->gz))); 
 2591: 
 2592:       }
 2593:       const double delta = cross(x2 - x1, x3 - x4);
 2594:       const double delta1 = cross(x3 - x1, x3 - x4);
 2595:       const double delta2 = cross(x2 - x1, x3 - x1); 
 2596: printf("findNextIntersection: sided %d, tIntersect = %.17f, delta = %.17f, delta1 = %.17f, delta2 = %.17f, shpXt = (%.17f, %.17f, %.17f), x1 = (%.17f, %.17f), x2 = (%.17f, %.17f), x3 = (%.17f, %.17f), x4 = (%.17f, %.17f), origSide->idx = %i\n", i, tIntersect, delta, delta1, delta2, shpXt[0], shpXt[1], shpXt[2], x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y, origSide->idx);
 2597: }
 2598: }
 2599:    assert(idxSide != -1 && "No intersection found");
 2600: 
 2601:    if (isTri()) {
 2602:       // XXXXXX Check if there is a better way to do this.
 2603:       const int n0 = nextElement->nodeLocalIdx(side->n1);
 2604:       const int n1 = nextElement->nodeLocalIdx(side->n2);
 2605:       const int n2 = 3 - n0 - n1;
 2606: 
 2607:       // In this function, since shpXt is always along a side, and sine t was computed from
 2608:       // coordinates in the original side's frame, we can use these simplified formulas.
 2609:       shpXt[n0] = t;
 2610:       shpXt[n1] = 1.0 - t;
 2611:       shpXt[n2] = 0.0;
 2612: 
 2613:    }
 2614:    else {
 2615:       assert(false && "findNextIntersection may be only implemented for triangular elements");
 2616:    }
 2617: 
 2618: }
 2619: 
 2620: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2621:    // Check if the point (xt,yt) is inside the element.
 2622:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2623:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2624: 
 2625:    ShapeCoords shpCoords;
 2626:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2627: 
 2628:    return res;
 2629: }
 2630: 
 2631: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2632:    // Check if the point (xt,yt) is inside the element.
 2633:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2634:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2635:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2636: 
 2637:    ShapeCoords shpCoords;
 2638:    Vector2 tmp_xt = xt;
 2639:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2640:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2641: 
 2642:    if (fixCoords && res) xt = tmp_xt;
 2643: 
 2644:    return res;
 2645: }
 2646: 
 2647: 
 2648: __device__ void Element::trackGoesOutOfWater(const Side *nextSide, const Side *origSide, Element *curElem, double tt, int jlev,
 2649:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2650: 
 2651:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2652:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2653:    // curElement.
 2654: 
 2655:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2656:    // And uses this velocity instead to continue the tracking.
 2657: 
 2658:    // computes the intersection point in local cartesian coordinates
 2659:    Point3 intersection = origSide->toLocalFrame(nextSide->p3_t(tt));  // XXXX I don't think this is necessary. The intersection is already computed in findNextIntersection.
 2660: 
 2661:    // Nudges the point to the barycenter of the element. 
 2662:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2663:    // next segment intersects the element sides. 
 2664:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2665: 
 2666: 
 2667:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2668:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2669:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2670:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2671: 
 2672:    // If the side is an open boundary, the tangential velocity is set to zero.
 2673:    if (nextSide->isBnd()) vtan = 0.0;
 2674: 
 2675:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2676:    const double us = vtan*nextSide->t().x;
 2677:    const double vs = vtan*nextSide->t().y;
 2678:    const double ws = nextSide->w2(jlev); 
 2679: 
 2680:    u_int = {us, vs, ws};
 2681: 
 2682:    // The end of this tracking segment is now the intersection point.
 2683:    xt = {intersection.x, intersection.y, zint};
 2684: // printf("trackGoesOutOfWater: intersection = (%.17f, %.17f, %.17f), zint = %.17f, u_int = (%.17f, %.17f, %.17f)\n", intersection.x, intersection.y, zint, u_int.x, u_int.y, u_int.z);
 2685:    
 2686: }
 2687: 
 2688: /**
 2689:  * Tracks a particle through elements and vertical levels in the mesh.
 2690:  * 
 2691:  * @param x0,y0,z0     Starting position coordinates
 2692:  * @param xt,yt,zt     Target position coordinates
 2693:  * @param dtb          Time step for tracking
 2694:  * @param u_int        Initial velocity components
 2695:  * @param nextElem     Starting/resulting element index
 2696:  * 
 2697:  * @return Status code of type trackExitCodes
 2698:  * 
 2699:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2700:  * of the details are different. The idea is that the code requires less branches and is better fit
 2701:  * for GPU execution.
 2702:  * 
 2703:  * The main ideas here are:
 2704:  * - The starting point is expected to be in the starting element.
 2705:  * - since the starting point is inside the element, there are only two cases: 
 2706:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2707:  *     (b) it does not and (xt,yt) is already in the starting element.
 2708:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2709:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2710:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2711:  * - tt1 can be positive or negative. We only consider the positive values.
 2712:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2713:  * - The next intersection will occur at the smallest positive tt1.
 2714:  * - This intersection will be the next (x0,y0) position.
 2715:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2716:  *   of getting stuck in a loop.
 2717:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2718:  *   was found.
 2719:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2720:  */
 2721: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, 
 2722:                                                        const ShapeCoords &shpX0, ShapeCoords &shpXt, 
 2723:                                                        Vector3 &u_int, 
 2724:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2725:                                                        const Side *origSide) {
 2726:                                                             
 2727:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2728:    // else to do. This means that the full step occurred within the current element.
 2729:    assert(!isDry && "Starting element is dry");
 2730:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2731: 
 2732:    // The assumption in this algorith, is that the shape coordintates are exact in the sense that 
 2733:    // one of them being not in [0,1] means that the point is not inside the element.
 2734:    if (containsPoint(shpXt)) { 
 2735: 
 2736:       assert(!isDry && "Target point is inside a dry element");
 2737: 
 2738:       u_int = interpolateVelocities(shpXt, xt.z);
 2739: 
 2740:       nextElem = this;
 2741: 
 2742:       return true;
 2743:    }
 2744: 
 2745: 
 2746: if(norm2(toVector2(xt - x0)) < 1.0e-10) printf("trackThroughElementsAndLevels: zero length track, idx = %i, jlev = %d, dtb = %.17f, xt = (%.17f, %.17f), x0 = (%.17f, %.17f), shpX0 = (%.17f, %.17f, %.17f), shpXt = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", origSide->idx, jlev, dt, xt.x, xt.y, x0.x, x0.y, shpX0[0], shpX0[1], shpX0[2], shpXt[0], shpXt[1], shpXt[2], u_int.x, u_int.y, u_int.z);
 2747:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2748:    
 2749:    double t;
 2750:    Side *nextSide = nullptr;
 2751:    double tIntersect = 1e10;
 2752:    Point2 xtmp;
 2753: 
 2754:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2755:    // (x0,y0) is inside the element but the target point is not.
 2756: if (origSide->idx == ORIG_SIDE_IDX && jlev == ORIG_SIDE_JLEV) printf(">> 1 trackThroughElementsAndLevels: idx = %i, jlev = %d, dt = %.17f, xt = (%.17f, %.17f), x0 = (%.17f, %.17f), shpX0 = (%.17f, %.17f, %.17f), shpXt = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", origSide->idx, jlev, dt, xt.x, xt.y, x0.x, x0.y, shpX0[0], shpX0[1], shpX0[2], shpXt[0], shpXt[1], shpXt[2], u_int.x, u_int.y, u_int.z);
 2757:    findNextIntersection(toPoint2(x0), toPoint2(xt), shpXt, xtmp, jlev, nextSide, nextElem, t, tIntersect, origSide);
 2758: 
 2759: if (origSide->idx == ORIG_SIDE_IDX && jlev == ORIG_SIDE_JLEV) printf(">> 2 trackThroughElementsAndLevels: idx = %i, jlev = %d, dt = %.17f, xt = (%.17f, %.17f), x0 = (%.17f, %.17f), shpX0 = (%.17f, %.17f, %.17f), shpXt = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", origSide->idx, jlev, dt, xt.x, xt.y, x0.x, x0.y, shpX0[0], shpX0[1], shpX0[2], shpXt[0], shpXt[1], shpXt[2], u_int.x, u_int.y, u_int.z);
 2760: 
 2761:    // At this point, nextElem is the next element and shpXt contains the shape coordinates 
 2762:    // of the intersection point with respect to that element. xt contains the intersection point in cartesian coordinates.
 2763: 
 2764:    // Computes the z-coordinate of the intersection point.
 2765:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2766:    xt = {xtmp.x, xtmp.y, zint};
 2767: 
 2768:    // if the tracking segment goes out of water (either dry or edge boundary).
 2769:    // Since nextElem from findNextIntersection is always a valid element (non-nullptr and 
 2770:    // not dry), otherElem will be null or dry when the tracking segment goes out of water.
 2771:    Element *otherElem = nextSide->otherElem(nextElem);
 2772:    if (isEdgeBoundary(nextSide) || (otherElem == nullptr || otherElem->isDry)) {
 2773:       dt = time_rm;
 2774: 
 2775: if (origSide->idx == ORIG_SIDE_IDX && jlev == ORIG_SIDE_JLEV) printf("trackThroughElementsAndLevels: goes out of water, nextSide = %p, otherElem = %p\n", nextSide, otherElem);      
 2776:       trackGoesOutOfWater(nextSide, origSide, this, t, jlev, xt, zint, u_int);
 2777: return true;
 2778:       assert(this->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the current element 2");
 2779:       // When this happens, the backtracking stops.
 2780: 
 2781:       dt *= tIntersect;
 2782: 
 2783:       // In this case, the next element is again the current element.
 2784:       nextElem = this;
 2785: 
 2786:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2787:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2788:       return true;    
 2789:    }
 2790: 
 2791:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2792:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2793: 
 2794:    
 2795:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2796: 
 2797:    u_int = nextElem->interpolateVelocities(shpXt, xt.z); 
 2798: 
 2799:    assert(nextElem != this && "Next element is the same as the current element");
 2800: 
 2801:    return true;
 2802: }
 2803: 
 2804: 
 2805: __inline__ __device__ double Element::computeSignedArea(void) const {
 2806:    // Compute the area of the element
 2807: 
 2808:    Point2 x0, x1, x2, x3;
 2809:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2810: 
 2811:    double res = signedArea(x0, x1, x2);
 2812: 
 2813:    // In the quad case we need to add the area of the other triangle.
 2814:    if (isQuad()) {
 2815:       x3 = getLocalHorizontalNodePosition(3);
 2816:       double ar1 = signedArea(x0, x2, x3);
 2817:       double ar2 = signedArea(x0, x1, x3);
 2818:       double ar3 = signedArea(x1, x2, x3);
 2819:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2820: 
 2821:       res += ar1 + ar2 + ar3;
 2822:    }
 2823: 
 2824:    return res;
 2825: }
 2826: 
 2827: 
 2828: __inline__ __device__ void Element::nudgeToBarycenter(Point2 &p, const Side *origSide) const {
 2829: // Nudges the local-frame point, p, to the barycenter of the element. 
 2830: 
 2831:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2832: 
 2833:    Point3 c = origSide->toLocalFrame(toPoint3(center, centerZ())); // In local frame coordinates if ics == 2
 2834: 
 2835:    p = (1.0 - btrack_nudge)*p + btrack_nudge*toPoint2(c);
 2836: }
 2837: 
 2838: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2839:                                                                 (nodes[1]->isDry2()) ||
 2840:                                                                 (nodes[2]->isDry2()) ||
 2841:                                                                 (isQuad() && nodes[3]->isDry2());
 2842: }
 2843: 
 2844: __inline__ __device__ double Element::detJ_eta(void) const {
 2845:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2846:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2847: }
 2848: 
 2849: __inline__ __device__ double Element::detJ_xi(void) const {
 2850:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2851:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2852: }
 2853: 
 2854: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2855:    // In boundary sides, the element 1 is nullptr
 2856:    return side->elems[1] == nullptr; 
 2857: }
 2858: 
 2859: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, ShapeCoords &shp) const {
 2860:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp
 2861:    // For ics == 2, this function uses local frame coordinates.
 2862: 
 2863:    assert(isQuad());
 2864: 
 2865:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2866:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2867:    // where vxi, veta, vb are vectors and c is the center of the element.
 2868: 
 2869:    Point2 p0, p1, p2, p3;
 2870: 
 2871:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2872: 
 2873:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2874:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2875:    // vectors vxi and veta connect the centers of opposite sides
 2876:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2877:    // vb is zero for parallelogram elements.
 2878:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2879: 
 2880:    //  The bilinear mapping is:
 2881:    //      P(s,t) = C + s*U + t*V + s*t*W
 2882:    //
 2883:    //  where:
 2884:    //    C = centroid (average of four vertices)
 2885:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2886:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2887:    //    W = bilinear correction; measures deviation from parallelogram
 2888:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2889:    //        W = 0 for parallelogram elements.
 2890:    //
 2891:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2892:    //
 2893:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2894:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2895:    //
 2896:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2897:    //
 2898:    //  Geometrically, (L) projects everything onto the direction
 2899:    //  perpendicular to W, where the mapping is purely affine.
 2900:    //
 2901:    //  The dot product with nb retains the nonlinear term:
 2902:    //
 2903:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2904:    //
 2905:    //  Geometrically, (Q) projects onto the W direction, where
 2906:    //  the nonlinearity lives.
 2907:    //
 2908:    //  We solve (L) for whichever variable has the larger coefficient
 2909:    //  (better conditioned back-substitution), substitute into (Q),
 2910:    //  and get a scalar quadratic in the other variable.
 2911:    // ================================================================
 2912: 
 2913:    // ---- Basis vectors ----
 2914:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2915:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2916:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2917:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2918:    // W: nonlinear correction. Difference between quad and parallelogram.
 2919:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2920:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2921: 
 2922:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2923:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2924:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2925:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2926:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2927: 
 2928:    // ---- nb: direction parallel to W, L1-normalized ----
 2929:    // We don't need a unit vector -- just a well-scaled direction parallel
 2930:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2931:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2932:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2933:    //
 2934:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2935:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2936:    // and the quadratic solver takes its linear path (a ~ 0).
 2937:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2938:    const double inv_wlen = 1.0 / wlen1;
 2939:    const Vector2 nb = vb * inv_wlen;
 2940: 
 2941:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2942:    // cross(nb, ·) projects onto the direction PERPENDICULAR to W.
 2943:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2944:    // What remains is a pure affine relationship between xi and eta.
 2945:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2946:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2947:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2948: 
 2949:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2950:    // dot(nb, ·) projects onto the W direction, where the nonlinearity lives.
 2951:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2952:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2953:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2954:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2955:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2956: 
 2957:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2958:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2959:    // minimizing round-off amplification.
 2960:    //
 2961:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2962:    // that uses predicated moves.
 2963:    //
 2964:    // if (fabs(Ls) > fabs(Lt)) {
 2965:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2966:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2967:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2968:    //    const double A = -Qw * Lt;
 2969:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2970:    //    const double C =  Qs * Lp - Qp * Ls;
 2971: 
 2972:    //    double eta1, eta2;
 2973:    //    solveQuadratic(A, B, C, eta1, eta2);
 2974: 
 2975:    //    // Pick root with smaller |eta| (domain centered at 0).
 2976:    //    // Ternary-> predicated move, no branch divergence.
 2977:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2978: 
 2979:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2980:    //    xi = (Lp - Lt * eta) / Ls;
 2981: 
 2982:    // } else {
 2983:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2984:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2985:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2986:    //    const double A = -Qw * Ls;
 2987:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2988:    //    const double C =  Qt * Lp - Qp * Lt;
 2989: 
 2990:    //    double xi1, xi2;
 2991:    //    solveQuadratic(A, B, C, xi1, xi2);
 2992: 
 2993:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2994: 
 2995:    //    eta = (Lp - Ls * xi) / Lt;
 2996:    // }
 2997:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2998:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2999:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3000:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3001:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3002: 
 3003:    // Quadratic:  A*r^2 + B*r + C = 0
 3004:    // (same formula for both cases, just with swapped coefficients)
 3005:    const double A = -Qw * Lb;
 3006:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3007:    const double C =  Qa * Lp - Qp * La;
 3008: 
 3009:    double r1, r2;
 3010:    solveQuadratic(A, B, C, r1, r2);
 3011: 
 3012:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3013:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3014: 
 3015:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3016:    const double other = (Lp - Lb * r) / La;
 3017: 
 3018:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3019:    xi  = solve_s ? r     : other;
 3020:    eta = solve_s ? other : r;
 3021: 
 3022: 
 3023:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3024:    xi  = fmin(1.0, fmax(xi,  -1.0));
 3025:    eta = fmin(1.0, fmax(eta, -1.0));
 3026: 
 3027:    // ---- Shape functions ----
 3028:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3029:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3030:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3031:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3032:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3033:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3034:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3035:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3036: 
 3037:    return true;
 3038: }
 3039: 
 3040: /**
 3041:    Compute the shape coordinates of the point (xt,yt) in the element.
 3042:    @param xt (input): x-coordinate of the point
 3043:    @param shpCoords (output): shape coordinates of the point
 3044:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3045:    @return true if the point is inside the element, false otherwise
 3046: **/
 3047: __device__ bool Element::computeShapeCoords(Point2 &xt, ShapeCoords &shpCoords, EFixIf fixNegshpCoord, const Side *origSide) const {
 3048: 
 3049:    // Compute the shape coordinates of the point xt in the element.
 3050:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3051:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3052:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3053:    // from the local frame, so use additional check.
 3054: 
 3055:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 3056: 
 3057:    if (isTri()) { // Triangular element
 3058: 
 3059:       // Horizontal local node coordinates. 
 3060:       Point2 x0 = nodes[0]->p;
 3061:       Point2 x1 = nodes[1]->p;
 3062:       Point2 x2 = nodes[2]->p;
 3063: 
 3064:       // If ics == 2, the node coordinates are transformed to local frame.
 3065:       if constexpr(ics==2) {
 3066:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 3067:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 3068:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 3069: 
 3070: 
 3071:          // Convert the node coordinates to the local frame centered at the element center
 3072:          x0 = toPoint2(origSide->toLocalFrame(p0));
 3073:          x1 = toPoint2(origSide->toLocalFrame(p1));
 3074:          x2 = toPoint2(origSide->toLocalFrame(p2));
 3075:       }
 3076: 
 3077:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3078:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3079:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3080:       shpCoords[3] = 0.0;
 3081: 
 3082: 
 3083:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3084:       const bool res = (tmpmin >= -small);  
 3085:       
 3086:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 3087:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3088: 
 3089:       
 3090:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3091:       // then we fix the negative shape coordinates.
 3092:       if ((tmpmin < 0) && fix) {
 3093: 
 3094:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3095:          // keeping the sum of the shape coordinates equal to 1.
 3096:          // I have tested and compared the new algorithm with the old one, and they give
 3097:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3098:          // The new algorithm should be faster since it is branchless.
 3099:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3100:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3101:          
 3102:          shpCoords[0] = (shpCoords[0] + a)*b;
 3103:          shpCoords[1] = (shpCoords[1] + a)*b;
 3104:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3105: 
 3106:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3107:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3108:                 "computeShapeCoords: Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3109: 
 3110:          // Update the point coordinates for the new shape coordinates
 3111:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3112:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3113:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3114: 
 3115:       }
 3116: 
 3117:       // Check if the point is inside the element
 3118:       return res;      
 3119:    }
 3120:    else {
 3121:       assert(isQuad() && "computeShapeCoords");
 3122: 
 3123:    //    Point2 p = xt;
 3124: 
 3125:    //    // Reproject p the original side frame for ics=2
 3126:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 3127: 
 3128:    //    bool inside = false;
 3129: 
 3130: 
 3131: 
 3132:    //    if(ifl==0) then
 3133:    //      do i=1,4
 3134:    //        in1=nxq(1,i,i34(ie))
 3135:    //        in2=nxq(2,i,i34(ie))
 3136:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 3137:    //      enddo !i
 3138:    //      tmp=minval(swild2(1:4))/area(ie)
 3139:    //      if(tmp>-small2) then
 3140:    //        inside=1
 3141:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3142:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3143:    //      endif !inside quad
 3144:    //    else !ifl=1 - already inside
 3145:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3146:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3147:    //      !Update pt
 3148:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3149:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3150:    //    endif !ifl
 3151: 
 3152: 
 3153:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3154: 
 3155:    }
 3156: 
 3157:    assert(false && "computeShapeCoords: should never reach this point");
 3158:    return false;  // Never reached
 3159: 
 3160: }
 3161: 
 3162: 
 3163: __device__ ShapeCoords Element::computeShapeCoordsForSides(Point2 &xt, const Side *origSide) const {
 3164: 
 3165:    // Compute the shape coordinates of the point xt in the element.
 3166:    // Assumes that the point is along a side of the element (including nodes). 
 3167:    // Ensures that the zero shape coordinates are strictly 0.0.
 3168:    //   @param xt : x-coordinate of the point. Is updated to the cartesian coordinates of the returned point (this is like a nudge).
 3169:    //   @param origSide : original side of the element
 3170:    //   @return shpCoords: shape coordinates of the point
 3171: 
 3172:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 3173: 
 3174:    ShapeCoords shpCoords;
 3175: 
 3176:    if (isTri()) { // Triangular element
 3177: 
 3178:       // Horizontal local node coordinates. 
 3179:       Point2 x0 = nodes[0]->p;
 3180:       Point2 x1 = nodes[1]->p;
 3181:       Point2 x2 = nodes[2]->p;
 3182: 
 3183:       // If ics == 2, the node coordinates are transformed to local frame.
 3184:       if constexpr(ics==2) {
 3185:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 3186:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 3187:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 3188: 
 3189:          // Convert the node coordinates to the local frame centered at the element center
 3190:          x0 = toPoint2(origSide->toLocalFrame(p0));
 3191:          x1 = toPoint2(origSide->toLocalFrame(p1));
 3192:          x2 = toPoint2(origSide->toLocalFrame(p2));
 3193:       }
 3194: 
 3195:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3196:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3197:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3198:       shpCoords[3] = 0.0;
 3199: 
 3200:       // Smallest coordinate or "small", whichever is larger.
 3201:       double tmpmin = max(min3(shpCoords[0], shpCoords[1], shpCoords[2]), small);
 3202: 
 3203:       // Ensure that at least one of the shape coordinates is strictly 0.0.
 3204:       if (shpCoords[0] <= tmpmin) shpCoords[0] = 0.0;
 3205:       if (shpCoords[1] <= tmpmin) shpCoords[1] = 0.0;
 3206:       if (shpCoords[2] <= tmpmin) shpCoords[2] = 0.0;
 3207: 
 3208: 
 3209:       // Normalization factor
 3210:       const double norm = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2]);
 3211:  
 3212:       shpCoords[0] = shpCoords[0]*norm;
 3213:       shpCoords[1] = shpCoords[1]*norm;
 3214:       shpCoords[2] = shpCoords[2]*norm;          
 3215: 
 3216: 
 3217:       assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3218:                shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3219:                "computeShapeCoordsForSides: Invalid shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3220: 
 3221:       // Update the point coordinates for the new shape coordinates
 3222:       double xcoords[3] = {x0.x, x1.x, x2.x};
 3223:       double ycoords[3] = {x0.y, x1.y, x2.y};
 3224:       xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3225: 
 3226:    }
 3227:    else {
 3228:       assert(isQuad() && "computeShapeCoords");
 3229: 
 3230:    //    Point2 p = xt;
 3231: 
 3232:    //    // Reproject p the original side frame for ics=2
 3233:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 3234: 
 3235:    //    bool inside = false;
 3236: 
 3237: 
 3238: 
 3239:    //    if(ifl==0) then
 3240:    //      do i=1,4
 3241:    //        in1=nxq(1,i,i34(ie))
 3242:    //        in2=nxq(2,i,i34(ie))
 3243:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 3244:    //      enddo !i
 3245:    //      tmp=minval(swild2(1:4))/area(ie)
 3246:    //      if(tmp>-small2) then
 3247:    //        inside=1
 3248:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3249:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3250:    //      endif !inside quad
 3251:    //    else !ifl=1 - already inside
 3252:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3253:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3254:    //      !Update pt
 3255:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3256:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3257:    //    endif !ifl
 3258: 
 3259: 
 3260:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3261: 
 3262:    }
 3263: 
 3264:    return shpCoords;  // Never reached
 3265: 
 3266: }
