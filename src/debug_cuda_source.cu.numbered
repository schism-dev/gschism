 8515:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 8516:          *sizeType = sizeof(Vector2);
 8517:          break;      
 8518:       case (int)VarCode::chi:
 8519:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 8520:          *sizeType = sizeof(double);
 8521:          break;
