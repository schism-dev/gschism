 3649: 
 3650: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3651:    // Computes the z coordinate at level k.
 3652:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3653:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3654:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3655:    // used 
 3656: 
 3657:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3658:    
 3659:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3660: 
 3661:    if (isDry2()) return 0.0;  
 3662: 
 3663:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3664: 
 3665:    if constexpr(ivcor == 2) {
 3666: 
 3667:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3668:       const double h_c = mesh->h_c;
 3669:       const double theta_f = mesh->theta_f;
 3670:       const double sinh_theta_f = mesh->sinh_theta_f;
 3671: 
 3672: 
 3673:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3674:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3675:       // once per time step/node. XXXX
 3676:       // CHECK: updateZCoordData
 3677: 
 3678:       //  To simplify comparisons, I define index versions of count variables.
 3679:       if      (k == ivrt)     return eta2; 
 3680:       else if (k == izlev)    return -hmod2;
 3681:       else if (k == kb)       return -depth;
 3682:       else if (k < izlev)     return mesh->ztot[k];
 3683:       else if (k > izlev) {
 3684:          const int ksig = k - izlev;
 3685: 
 3686:          if (hmod2 <= h_c) {
 3687:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3688: 
 3689:          } 
 3690:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3691:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3692:             assert(false && "compZCoord: invalid h_c\n");
 3693:          } 
 3694:          else {
 3695:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3696:                    h_c * mesh->sigma[ksig] + 
 3697:                    (hmod2 - h_c) * mesh->cs[ksig];
 3698:          }
 3699:       } else { 
 3700:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3701:       }
 3702: 
 3703:    }
 3704:    else {  // if constexpr(ivcor == 1)
 3705:       if (k <= kb)        return -depth; 
 3706:       else if (k == ivrt) return eta2;
 3707:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3708: 
 3709:    }
 3710:    
 3711:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3712:    return 0.0;
 3713: }
 3714: 
 3715: 
 3716: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3717:    // Computes the bottom drag Cd based on the selected nchi
 3718: 
 3719:    if constexpr(nchi == 0) {
 3720:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3721:       Cd = drag;  // Read from drag file
 3722: 
 3723:    } else if constexpr(nchi == 1) {
 3724:       // 
 3725: 
 3726:       bool ltmp = false; // for WBL iteration
 3727: 
 3728:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3729:       if (isDry || (rough == 0.0)) {
 3730:          Cd = 0.0;
 3731: 
 3732:       } else { //roughness >0 
 3733:          
 3734:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3735: 
 3736:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3737: 
 3738:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3739: 
 3740:       } // if rough
 3741: 
 3742:    } else if constexpr(nchi == -1) {
 3743:    // Manning 
 3744:  
 3745:       const double htot = max(hmin_man, htot2()); 
 3746:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3747: 
 3748:    } else {
 3749:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3750:       
 3751:    } // if nchi
 3752: 
 3753: }
 3754: 
 3755: 
 3756: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3757:    // Checks if a side in on the boundary
 3758:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3759: 
 3760:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3761:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3762: 
 3763:    // Indices of the nodes that form the side
 3764:    //
 3765:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3766:    const int n1 = side.n1->idx;
 3767:    const int n2 = side.n2->idx;
 3768:    isLand = false;
 3769:    
 3770: 
 3771:    // Check if the side is on a land boundary
 3772:    for (int i = 0; i < nland; i++) {
 3773:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3774:          // Consecutive nodes in the land boundary segment
 3775:          const int b1 = ilnd[i + j*nland];
 3776:          const int b2 = ilnd[i + (j + 1)*nland];
 3777: 
 3778:          assert(b1 != -1 && b2 != -1);
 3779: 
 3780:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3781:             
 3782:             isLand = true;
 3783:             return i;
 3784:          }
 3785:       }
 3786:    }
 3787: 
 3788:    // Check if the side is on an open boundary
 3789:    for (int i = 0; i < nope; i++) {
 3790:       for (int j = 0; j < nond[i] - 1; j++) {
 3791:          // Consecutive nodes in the open boundary segment
 3792:          const int b1 = iond[i + j*nope];
 3793:          const int b2 = iond[i + (j + 1)*nope];
 3794: 
 3795:          assert(b1 != -1 && b2 != -1);
 3796: 
 3797:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3798:             isLand = false;
 3799:             return i;
 3800:          }
 3801:       }
 3802:    }
 3803: 
 3804:    return -1;
 3805: }
 3806: 
 3807: 
 3808: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3809:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3810:                                     double *wind_rotate_angle, 
 3811:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3812:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3813:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 3814:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3815:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3816:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3817:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3818: 
 3819:    NODE(pnode);  
 3820:    const int i = idx_node;
 3821:    const int iglobal = globalNodeIndices[i];
 3822:    Node &node(*pnode);
 3823: 
 3824:    node.idx = iglobal;
 3825: 
 3826:    // It is important to differentiate between the global and local "start" indices because they
 3827:    // play different, but related, roles in this code. The global "start" indices are used
 3828:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 3829:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 3830:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 3831:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 3832:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 3833:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 3834:    node.numNodes = idxNodeEnd - idxNodeStart;
 3835:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 3836:    node.coeffMatrix = coeffMatrixMem + idxNodeLocalStart;
 3837: 
 3838:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 3839:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 3840:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 3841:    node.numElements = idxElemEnd - idxElemStart;
 3842:    node.elements = nodeNeighElems + idxElemLocalStart;
 3843: 
 3844: 
 3845:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 3846:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3847:       const int partNode = localNodePart[idxNodeGlobal]; 
 3848:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3849: 
 3850:       Node *node_ptr = nodes[partNode] + idxNode;
 3851:       
 3852:       nodeNeighNodes[idxLocal] = node_ptr;
 3853:    }
 3854: 
 3855: 
 3856:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 3857:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3858:       const int partElem = localElemPart[idxElemGlobal];
 3859:       const int idxElem  = localElemIndices[idxElemGlobal];
 3860: 
 3861:       Element *elem_ptr = elems[partElem] + idxElem;
 3862: 
 3863:       nodeNeighElems[idxLocal] = elem_ptr;
 3864:    }      
 3865: 
 3866:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3867:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3868: 
 3869:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3870: 
 3871:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3872:    if constexpr(ics == 1) {
 3873:       node.p.x   = node_coords[i * 3];
 3874:       node.p.y   = node_coords[i * 3 + 1];
 3875:       node.gz = 0.0;
 3876: 
 3877:       if (use_ll) {                                    // <-- add
 3878:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3879:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3880:       }  
 3881: 
 3882:    } else {
 3883:       const double lon = deg2rad*node_coords[i * 3];
 3884:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3885: 
 3886:       Point3 p = computeXYZfromLatLon(lat, lon);
 3887:       node.p = toVector2(p);
 3888:       node.gz = p.z;
 3889:       node.lon = lon;
 3890:       node.lat = lat;
 3891: 
 3892:       #ifdef USE_FRAMES
 3893:       node.setFrame(lat, lon);
 3894:       #endif
 3895: 
 3896: 
 3897:    }
 3898: 
 3899:    node.depth = node_coords[i * 3 + 2];
 3900: 
 3901:    node.numSides = 0;
 3902: 
 3903:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3904:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 3905:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 3906:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 3907:    else assert(false && "populateNodes: selected nchi not implemented.");
 3908: 
 3909:    if constexpr(ivcor == 1) 
 3910:    {  
 3911:       node.kb = kb[iglobal];
 3912: 
 3913:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 3914:    }
 3915: 
 3916:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3917:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3918:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3919: 
 3920:    
 3921:    // Links the node to the boundary information
 3922:    if (isbnd[iglobal] >= 0) {
 3923:      
 3924:       // Get the index of the node boundary
 3925:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3926: 
 3927:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3928:       node.nodeBnd->node = &node;
 3929: 
 3930:       node.nodeBnd->sideBnd1 = nullptr;
 3931:       node.nodeBnd->sideBnd2 = nullptr;
 3932: 
 3933:       if (isbnd[iglobal]>=0) {
 3934: 
 3935:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 3936:          
 3937:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3938:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3939: 
 3940:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3941:          node.nodeBnd->segment->clen  = nan("1");
 3942:          node.nodeBnd->segment->carea = nan("1");
 3943: 
 3944:       }
 3945:    } else {
 3946: 
 3947:       node.nodeBnd = nullptr; // For internal nodes
 3948: 
 3949:       if (isbnd[iglobal] == landSegment) {
 3950:          node.nodeBnd = &landBoundaryNode;
 3951:          node.nodeBnd->segment = &landBoundarySegment;
 3952:       }
 3953:       
 3954:    }
 3955:    
 3956:    // XXXX GAUSSIAN HILL VELOCITIES
 3957:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3958:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3959:          constexpr double rot_per = 3000.0;
 3960:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3961:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3962:       // XXXXX
 3963:    #endif
 3964: 
 3965: }
 3966: 
 3967: 
 3968: 
 3969: 
 3970: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3971:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3972:                                     double *wind_rotate_angle,   
 3973:                                     int *isdel, int *isidenode, int *isbnd,
 3974:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3975:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3976:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3977:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3978:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3979:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3980:                                     double *drag, double *roughness) {
 3981: 
 3982: 
 3983:    SIDE(pside);
 3984:    Side &side(*pside);
 3985:    const int i = idx_side;
 3986:    const int iglobal = globalSideIndices[i];
 3987:    side.idx = iglobal;  
 3988:    
 3989:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3990:    const double fc   = 2.0*omega_e*sin(sfea0);
 3991:    const double beta = 2.0*omega_e*cos(sfea0);
 3992: 
 3993:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3994: 
 3995:    // finding the pointer to the nodes that form the side
 3996:    const int idx_n1 = isidenode[iglobal*2];
 3997:    const int idx_n2 = isidenode[iglobal*2 + 1];
 3998: 
 3999: printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4000: 
 4001:    const int locidx_n1 = localNodeIndices[idx_n1];
 4002:    const int locidx_n2 = localNodeIndices[idx_n2];
 4003:    const int part_n1 =   localNodePart[idx_n1];
 4004:    const int part_n2 =   localNodePart[idx_n2];
 4005: 
 4006: printf("populateSides: part_n1 = %d, part_n2 = %d\n", part_n1, part_n2);
 4007: 
 4008:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4009:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4010: 
 4011: 
 4012:    // Counts the number of sides connected to each node
 4013:    atomicAdd(&side.n1->numSides, 1);
 4014:    atomicAdd(&side.n2->numSides, 1);
 4015: 
 4016:    // Side boundary type
 4017:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4018:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4019: 
 4020:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4021:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4022:    {
 4023:       bool isLand = false;
 4024:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4025:       
 4026:       if (isbs > -1) {
 4027:          // assert(isLand || isbs>=0);
 4028:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4029: 
 4030:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4031: 
 4032:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4033:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4034: 
 4035:          assert (isLand == side.sideBnd->segment->isLand);
 4036:          
 4037:          side.sideBnd->side = &side;
 4038: 
 4039:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4040:          n1bnd->linkSideBoundary(side.sideBnd);
 4041:          n2bnd->linkSideBoundary(side.sideBnd);
 4042: 
 4043:       }
 4044:       else {
 4045:          side.sideBnd = nullptr;
 4046:       }
 4047:    }
 4048:    else 
 4049:    {
 4050:       side.sideBnd = nullptr;
 4051:    }
 4052: 
 4053: 
 4054:    // finding the pointer to the elements that share the side
 4055:    const int idx_e1 = isdel[iglobal*2];
 4056:    const int idx_e2 = isdel[iglobal*2 + 1];
 4057: 
 4058:    if (idx_e1 > -1) {
 4059:       const int locidx_e1 = localElemIndices[idx_e1];
 4060:       const int part_e1 =  localElemPart[idx_e1];
 4061:       side.elems[0] = elems[part_e1] + locidx_e1;
 4062: 
 4063:    }
 4064:    else {
 4065:       side.elems[0] = nullptr;
 4066:    }
 4067: 
 4068:    if (idx_e2 > -1) {
 4069:       const int locidx_e2 = localElemIndices[idx_e2];
 4070:       const int part_e2 =  localElemPart[idx_e2];
 4071:       side.elems[1] = elems[part_e2] + locidx_e2;
 4072:    }
 4073:    else {
 4074:       side.elems[1] = nullptr;
 4075:    }
 4076: 
 4077:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4078:       
 4079:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4080:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4081:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4082:          
 4083:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4084:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4085:       // printf("sideBnd: %p\n", side.sideBnd);
 4086:       // assert(false && "Side has no elements and no boundary");
 4087:    }
 4088:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4089: 
 4090:    // Compute the center of the side
 4091:    side.center = 0.5*(side.n1->p + side.n2->p);
 4092: 
 4093:    #ifdef USE_FRAMES
 4094:    side.setFrame();
 4095:    #endif
 4096: 
 4097:    // Normal, unitary vector to the side
 4098:    if constexpr(ics == 1) {
 4099:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4100:       side.n = normalize(side.n);
 4101:    }
 4102:    else {
 4103:       // Unit side vector in 3D cartesian coordinates
 4104:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4105: 
 4106:       nSide = normalize(nSide);
 4107: 
 4108:       // Its cross product with the unit local z-axis vector (nUp) is the
 4109:       // normal vector we are looking for.
 4110:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4111: 
 4112:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4113:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4114:       side.n = -normalize(n2D); 
 4115: 
 4116:    }
 4117: 
 4118:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4119:    side.shapiro = shapiro0;
 4120: 
 4121:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4122:    // XXXX
 4123:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4124:    constexpr double rot_per=3000.0;
 4125:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4126:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4127:    // XXXXX      
 4128:    #endif
 4129:    // Compute the z level at the center of the side
 4130:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4131:    
 4132:    // Compute the length of the side
 4133:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4134: 
 4135: 
 4136:    // Compute the Coriolis coefficient
 4137: 
 4138:    if constexpr(ncor == -1 || ncor == 0) {
 4139:       side.coriolis = coricoef;
 4140:    }
 4141:    else {
 4142:       const double sphi = side.lat();  // Latitude at the center of the side
 4143: 
 4144:       assert(use_ll && "use_ll must be true when ncor > 0");
 4145: 
 4146:       if constexpr(ics == 1) {
 4147:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4148:       }
 4149:       else { // ics == 2
 4150:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4151:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4152:       }
 4153: 
 4154:    }
 4155: 
 4156: }
 4157: 
 4158: 
 4159: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4160:    double *node_coords, double *node_coords_ll, bool use_ll,
 4161:    double *wind_rotate_angle,   
 4162:    int *isdel, int *isidenode, int *isbnd,
 4163:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4164:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4165:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4166:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4167:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4168:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4169:    double *drag, double *roughness) {
 4170: 
 4171:    ELEM(pelem);
 4172:    Element &elem(*pelem);
 4173:    const int i = idx_elem;
 4174: 
 4175:    elem.idx = i;
 4176: 
 4177:    for (int j = 0; j < i34[i]; j++) {
 4178:       const int idxNode = elnode[i*4 + j];  
 4179:       const int idxSide = elside[i*4 + j];
 4180:       
 4181:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4182:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4183: 
 4184:       // Find the neighboring element  
 4185:       if (elem.sides[j]->elems[0] == &elem) {
 4186:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4187:       }
 4188:       else {
 4189:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4190:       }
 4191:       
 4192:    }
 4193: 
 4194:    elem.i34 = i34[i];
 4195: 
 4196:    // Compute the barycenter of the element and its depth
 4197:    elem.center = {0.0, 0.0};
 4198:    elem.depth = 1e10;
 4199:    for (int j = 0; j < i34[i]; j++) {
 4200: 
 4201:       elem.center += elem.nodes[j]->p/i34[i];
 4202:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4203:    }
 4204: 
 4205:    #ifdef USE_FRAMES
 4206:    elem.setFrame();
 4207:    #endif
 4208: 
 4209:    elem.area = elem.computeSignedArea(); 
 4210:    elem.radius = sqrt(elem.area)/pi; 
 4211:    
 4212:    // Determines which way the normal vector to each side is oriented.
 4213:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4214:    for (int j = 0; j < i34[i]; j++)  
 4215:    {
 4216:       if (elem.sides[j]->elems[0] == &elem) {
 4217:          elem.ssign[j] =  1.0;
 4218:       }
 4219:       else {
 4220:          elem.ssign[j] = -1.0;
 4221:       }
 4222: 
 4223:    }
 4224: 
 4225:   
 4226: 
 4227:    // Derivatives of shape functions
 4228:    //  For ics=2, this is done in the element frame
 4229:    //  For quads, the derivative is evaluated at centroid
 4230:    for (int j = 0; j < elem.i34; j++) {
 4231:       const double area = elem.area;
 4232:       const int id2 = elem.nxq(1 + j);
 4233:       const int id3 = elem.nxq(2 + j);
 4234:       const int id4 = elem.nxq(3 + j);
 4235:       if (elem.isTri()) {
 4236:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4237:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4238:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4239:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4240:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4241:          // And so on for the other shape functions.
 4242: 
 4243:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4244:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4245:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4246: 
 4247:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4248:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4249: 
 4250:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4251: 
 4252:       }
 4253:       else  { // Quad, the derivatives are evaluated at the centroid
 4254: 
 4255:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4256:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4257:          // ...
 4258:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4259: 
 4260:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4261:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4262:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4263: 
 4264:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4265:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4266: 
 4267:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4268: 
 4269:       } // if Tri/Quad
 4270: 
 4271:    } // for j   
 4272:    
 4273:    
 4274: 
 4275: }
 4276: 
 4277: 
 4278: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4279:                                             double *emo, double *efa, 
 4280:                                             double *umo, double *ufa, 
 4281:                                             double *vmo, double *vfa,
 4282:                                             int *ifltype, int *iettype) {
 4283: 
 4284:    NODE_BND(nodeBnd);
 4285:    const int idx = idx_node_bnd;    
 4286: 
 4287:    nodeBnd->idx = idx;
 4288: 
 4289:    // Need to find the segment index and the index of the node on the segment
 4290:    int idxNode = -1;
 4291:    int iseg, i;
 4292:    for (iseg = 0; iseg < nope; iseg++) {
 4293:       // for each segment...
 4294:       for (i = 0; i < nond[iseg]; i++) {
 4295:          idxNode = iond[iseg + i*nope];
 4296:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4297:          
 4298:       }
 4299:    }
 4300: 
 4301:    assert(iseg < nope && "iseg is out of bounds");
 4302: 
 4303: found: // Jumped here when the node was found
 4304: 
 4305:    nodeBnd->isEssentialBC = true;
 4306:    nodeBnd->elbc = 0.0;
 4307: 
 4308:    nodeBnd->segment->ifltype = ifltype[iseg];
 4309:    nodeBnd->segment->iettype = iettype[iseg];
 4310: 
 4311:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4312: 
 4313:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4314: 
 4315:       nodeBnd->efa[jfr] = efa[idx2];
 4316:       nodeBnd->emo[jfr] = emo[idx2];
 4317:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4318:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4319: 
 4320:    }
 4321:         
 4322: 
 4323: }
 4324: 
 4325: __device__ void Mesh::populateBoundarySideLinks(void) {
 4326: 
 4327:    SIDE_BND(sideBnd);
 4328: 
 4329:    const Side *side = sideBnd->side;
 4330: 
 4331:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4332:    // and the rightSide is the side s that has s->n1 == side->n2
 4333:    for (int i = 0; i < mesh->nbs; i++) {
 4334: 
 4335:       Side *s = &mesh->localSideData[i];
 4336: 
 4337:       if (s == side) continue;  // Do not link the side to itself
 4338:    
 4339:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4340:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4341:    }
 4342:    
 4343: }
