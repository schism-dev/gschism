 2808: 
 2809: __device__ double Node::compZCoord(int k) const {
 2810:    // Computes the z coordinate at level k.
 2811:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2812:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2813:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2814:    // used 
 2815: 
 2816:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 2817:    
 2818:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2819: 
 2820:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 2821: 
 2822:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2823: 
 2824:    if constexpr(ivcor == 2) {
 2825: 
 2826:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2827:       const double h_c = mesh->h_c;
 2828:       const double theta_f = mesh->theta_f;
 2829:       const double sinh_theta_f = mesh->sinh_theta_f;
 2830: 
 2831: 
 2832:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2833:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2834:       // once per time step/node.
 2835:       // CHECK: updateZCoordData
 2836: 
 2837:       //  To simplify comparisons, I define index versions of count variables.
 2838:       if      (k == ivrt)     return eta2; 
 2839:       else if (k == izlev)    return -hmod2;
 2840:       else if (k == kb)       return -depth;
 2841:       else if (k < izlev)     return mesh->ztot[k];
 2842:       else if (k > izlev) {
 2843:          const int ksig = k - izlev;
 2844: 
 2845:          if (hmod2 <= h_c) {
 2846:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2847: 
 2848:          } 
 2849:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 2850:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2851:             assert(false && "ZCOOR: invalid h_c\n");
 2852:          } 
 2853:          else {
 2854:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2855:                    h_c * mesh->sigma[ksig] + 
 2856:                    (hmod2 - h_c) * mesh->cs[ksig];
 2857:          }
 2858:       } else { 
 2859:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2860:       }
 2861: 
 2862:    }
 2863:    else if constexpr(ivcor == 1) {
 2864:       if (k == kb) return -depth;
 2865:       else if (k == nvrt-1) return eta2;
 2866:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2867:    }
 2868:    
 2869:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2870:    return 0.0;
 2871: }
 2872: 
 2873: 
 2874: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2875:    // Computes the bottom drag Cd based on the selected nchi
 2876: 
 2877:    if constexpr(nchi == 0) {
 2878:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2879:       Cd = drag;  // Read from drag file
 2880: 
 2881:    } else if constexpr(nchi == 1) {
 2882:       // 
 2883: 
 2884:       bool ltmp = false; // for WBL iteration
 2885: 
 2886:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2887:       if (isDry || (rough == 0.0)) {
 2888:          Cd = 0.0;
 2889: 
 2890:       } else { //roughness >0 
 2891:          
 2892:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2893: 
 2894:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2895: 
 2896:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2897: 
 2898:       } // if rough
 2899: 
 2900:    } else if constexpr(nchi == -1) {
 2901:    // Manning 
 2902:  
 2903:       const double htot = max(hmin_man, htot2()); 
 2904:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2905: 
 2906:    } else {
 2907:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2908:       
 2909:    } // if nchi
 2910: 
 2911: }
 2912: 
 2913: 
 2914: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2915:    // Checks if a side in on the boundary
 2916:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2917: 
 2918:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2919:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2920: 
 2921:    // Indices of the nodes that form the side
 2922:    const int n1 = side.n1->idx;
 2923:    const int n2 = side.n2->idx;
 2924:    isLand = false;
 2925:    
 2926: 
 2927:    // Check if the side is on a land boundary
 2928:    for (int i = 0; i < nland; i++) {
 2929:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2930:          // Consecutive nodes in the land boundary segment
 2931:          const int b1 = ilnd[i + j*nland];
 2932:          const int b2 = ilnd[i + (j + 1)*nland];
 2933: 
 2934:          assert(b1 != -1 && b2 != -1);
 2935: 
 2936:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2937:             
 2938:             isLand = true;
 2939:             return i;
 2940:          }
 2941:       }
 2942:    }
 2943: 
 2944:    // Check if the side is on an open boundary
 2945:    for (int i = 0; i < nope; i++) {
 2946:       for (int j = 0; j < nond[i] - 1; j++) {
 2947:          // Consecutive nodes in the open boundary segment
 2948:          const int b1 = iond[i + j*nope];
 2949:          const int b2 = iond[i + (j + 1)*nope];
 2950: 
 2951:          assert(b1 != -1 && b2 != -1);
 2952: 
 2953:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2954:             isLand = false;
 2955:             return i;
 2956:          }
 2957:       }
 2958:    }
 2959: 
 2960:    return -1;
 2961: }
 2962: 
 2963: 
 2964: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2965:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2966:                                     double *wind_rotate_angle, 
 2967:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2968:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2969:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2970:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2971:                                     double *drag, double *roughness, double *rmanning) {
 2972: 
 2973:    NODE(pnode);  
 2974:    const int i = idx_node;
 2975:    Node &node(*pnode);
 2976: 
 2977:    node.idx = i;
 2978: 
 2979:    const int idxNodeStart = nodeNeighNodesStart[i];
 2980:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2981:    node.numNodes = idxNodeEnd - idxNodeStart;
 2982:    node.nodes = nodeNeighNodes + idxNodeStart;
 2983:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2984: 
 2985: 
 2986: 
 2987:    const int idxElemStart = nodeNeighElemsStart[i];
 2988:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2989:    node.numElements = idxElemEnd - idxElemStart;
 2990:    node.elements = nodeNeighElems + idxElemStart;
 2991: 
 2992: 
 2993:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2994:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2995:       const int partNode = localNodePart[idxNodeGlobal]; 
 2996:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2997: 
 2998:       Node *node_ptr = nodes[partNode] + idxNode;
 2999:       
 3000:       nodeNeighNodes[idx] = node_ptr;
 3001:    }
 3002: 
 3003: 
 3004:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3005:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3006:       const int partElem = localElemPart[idxElemGlobal];
 3007:       const int idxElem  = localElemIndices[idxElemGlobal];
 3008: 
 3009:       Element *elem_ptr = elems[partElem] + idxElem;
 3010: 
 3011:       nodeNeighElems[idx] = elem_ptr;
 3012:    }      
 3013: 
 3014:    node.wind_angle = wind_rotate_angle[i];
 3015: 
 3016: 
 3017:    node.p.x   = node_coords[i * 3];
 3018:    node.p.y   = node_coords[i * 3 + 1];
 3019:    node.depth = node_coords[i * 3 + 2];
 3020: 
 3021:    if (use_ll) {
 3022:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3023:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3024:    }
 3025: 
 3026: 
 3027:    node.numSides = 0;
 3028: 
 3029:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3030:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3031:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3032:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3033:    else assert(false && "populateNodes: selected nchi not implemented.");
 3034:    
 3035:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3036:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3037:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3038: 
 3039:    
 3040:    // Links the node to the boundary information
 3041:    if (isbnd[i] >= 0) {
 3042:      
 3043:       // Get the index of the node boundary
 3044:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3045: 
 3046:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3047:       node.nodeBnd->node = &node;
 3048: 
 3049:       node.nodeBnd->sideBnd1 = nullptr;
 3050:       node.nodeBnd->sideBnd2 = nullptr;
 3051: 
 3052:       if (isbnd[i]>=0) {
 3053: 
 3054:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3055:          
 3056:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3057:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3058: 
 3059:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3060:          node.nodeBnd->segment->clen  = nan("1");
 3061:          node.nodeBnd->segment->carea = nan("1");
 3062: 
 3063:       }
 3064:    } else {
 3065: 
 3066:       node.nodeBnd = nullptr; // For internal nodes
 3067: 
 3068:       if (isbnd[i] == landSegment) {
 3069:          node.nodeBnd = &landBoundaryNode;
 3070:          node.nodeBnd->segment = &landBoundarySegment;
 3071:       }
 3072:       
 3073:    }
 3074:    
 3075:    // XXXX GAUSSIAN HILL VELOCITIES
 3076: #ifdef GAUSSIAN_HILL_VELOCITIES
 3077:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3078:       constexpr double rot_per = 3000.0;
 3079:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3080:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3081:    // XXXXX
 3082: #endif
 3083: 
 3084: }
 3085: 
 3086: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3087:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3088:                                     double *wind_rotate_angle,   
 3089:                                     int *isdel, int *isidenode, int *isbnd,
 3090:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3091:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3092:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3093:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3094:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3095:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3096:                                     double *drag, double *roughness) {
 3097: 
 3098: 
 3099:    SIDE(pside);
 3100:    Side &side(*pside);
 3101:    const int i = idx_side;
 3102: 
 3103:    side.idx = i;  
 3104:    
 3105:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3106:    const double fc   = 2.0*omega_e*sin(sfea0);
 3107:    const double beta = 2.0*omega_e*cos(sfea0);
 3108: 
 3109:    // finding the pointer to the nodes that form the side
 3110:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3111:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3112: 
 3113:    const int locidx_n1 = localNodeIndices[idx_n1];
 3114:    const int locidx_n2 = localNodeIndices[idx_n2];
 3115:    const int part_n1 =   localNodePart[idx_n1];
 3116:    const int part_n2 =   localNodePart[idx_n2];
 3117: 
 3118:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3119:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3120: 
 3121:    // Counts the number of sides connected to each node
 3122:    side.n1->numSides++;
 3123:    side.n2->numSides++;
 3124: 
 3125:    // Normal, unitary vector to the side
 3126:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3127:    side.n = normalize(side.n);
 3128: 
 3129:    // Side boundary type
 3130:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3131:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3132: 
 3133:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3134:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3135:    {
 3136:       bool isLand = false;
 3137:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3138:       
 3139:       if (isbs > -1) {
 3140:          // assert(isLand || isbs>=0);
 3141:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3142: 
 3143:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3144: 
 3145:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3146:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3147: 
 3148:          assert (isLand == side.sideBnd->segment->isLand);
 3149: 
 3150:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3151:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3152:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3153: 
 3154:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3155:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3156:          
 3157:          side.sideBnd->side = &side;
 3158: 
 3159:       }
 3160:       else {
 3161:          side.sideBnd = nullptr;
 3162:       }
 3163:    }
 3164:    else 
 3165:    {
 3166:       side.sideBnd = nullptr;
 3167:    }
 3168: 
 3169: 
 3170:    // finding the pointer to the elements that share the side
 3171:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3172:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3173: 
 3174:    if (idx_e1 > -1) {
 3175:       const int locidx_e1 = localElemIndices[idx_e1];
 3176:       const int part_e1 =  localElemPart[idx_e1];
 3177:       side.elems[0] = elems[part_e1] + locidx_e1;
 3178: 
 3179:    }
 3180:    else {
 3181:       side.elems[0] = nullptr;
 3182:    }
 3183: 
 3184:    if (idx_e2 > -1) {
 3185:       const int locidx_e2 = localElemIndices[idx_e2];
 3186:       const int part_e2 =  localElemPart[idx_e2];
 3187:       side.elems[1] = elems[part_e2] + locidx_e2;
 3188:    }
 3189:    else {
 3190:       side.elems[1] = nullptr;
 3191:    }
 3192: 
 3193:    // Compute the center of the side
 3194:    side.center = 0.5*(side.n1->p + side.n2->p);
 3195: 
 3196:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3197:    side.shapiro = shapiro0;
 3198: 
 3199: #ifdef GAUSSIAN_HILL_VELOCITIES
 3200: // XXXX
 3201: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3202: constexpr double rot_per=3000.0;
 3203: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3204: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3205: // XXXXX      
 3206: #endif
 3207:    // Compute the z level at the center of the side
 3208:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3209:    
 3210:    // Compute the length of the side
 3211:    const Vector2 vLen = side.n2->p - side.n1->p;
 3212:    side.len = sqrt(dot(vLen, vLen));
 3213: 
 3214: 
 3215:    // Compute the Coriolis coefficient
 3216: 
 3217:    if constexpr(ncor == -1 || ncor == 0) {
 3218:       side.coriolis = coricoef;
 3219:    }
 3220:    else {
 3221:       const double sphi = side.lat();  // Latitude at the center of the side
 3222: 
 3223: // XXXXXX ERROR WHEN use_ll is false??????
 3224:       if constexpr(ics == 1) {
 3225:          // XXXXXXX
 3226:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3227:       }
 3228:       else {
 3229:          side.coriolis = 2.0*omega_e*sin(sphi);
 3230:       }
 3231: 
 3232:    }
 3233: }
 3234: 
 3235: 
 3236: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3237:    double *node_coords, double *node_coords_ll, bool use_ll,
 3238:    double *wind_rotate_angle,   
 3239:    int *isdel, int *isidenode, int *isbnd,
 3240:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3241:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3242:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3243:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3244:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3245:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3246:    double *drag, double *roughness) {
 3247: 
 3248:    ELEM(pelem);
 3249:    Element &elem(*pelem);
 3250:    const int i = idx_elem;
 3251: 
 3252:    elem.idx = i;
 3253: 
 3254:    for (int j = 0; j < i34[i]; j++) {
 3255:       const int idxNode = elnode[i*4 + j];  
 3256:       const int idxSide = elside[i*4 + j];
 3257:       
 3258:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3259:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3260: 
 3261:       // Find the neighboring element  
 3262:       if (elem.sides[j]->elems[0] == &elem) {
 3263:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3264:       }
 3265:       else {
 3266:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3267:       }
 3268:       
 3269:    }
 3270: 
 3271:    elem.i34 = i34[i];
 3272: 
 3273:    // Compute the barycenter of the element and its depth
 3274:    elem.center = {0.0, 0.0};
 3275:    elem.depth = 0.0;
 3276:    for (int j = 0; j < i34[i]; j++) {
 3277: 
 3278:       elem.center += elem.nodes[j]->p/i34[i];
 3279:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3280:    }
 3281: 
 3282: 
 3283:    
 3284:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3285:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3286: 
 3287:    elem.area = elem.computeSignedArea(); 
 3288:    elem.radius = sqrt(elem.area)/pi; 
 3289:    
 3290:    // Determines which way the normal vector to each side is oriented.
 3291:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3292:    for (int j = 0; j < i34[i]; j++)  
 3293:    {
 3294:       if (elem.sides[j]->elems[0] == &elem) {
 3295:          elem.ssign[j] =  1.0;
 3296:       }
 3297:       else {
 3298:          elem.ssign[j] = -1.0;
 3299:       }
 3300: 
 3301:    }
 3302: 
 3303:    // Derivatives of shape functions
 3304:    //  For ics=2, this is done inside element/ll frame XXX
 3305:    //  For quads, the derivative is evaluated at centroid
 3306:    for (int j = 0; j < elem.i34; j++) {
 3307:       const double area = elem.area;
 3308:       const int id2 = elem.nxq(1 + j);
 3309:       const int id3 = elem.nxq(2 + j);
 3310:       const int id4 = elem.nxq(3 + j);
 3311:       if (elem.isTri()) {
 3312:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3313:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3314:          // da1/dx = (y1 - y2)/(2*area)
 3315:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3316:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3317:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3318:       }
 3319:       else  { // Quad; evaluate at centroid
 3320:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3321:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3322:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3323:       } // if Tri
 3324: 
 3325:    } // for j   
 3326:    
 3327:    
 3328: 
 3329: }
 3330: 
 3331: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3332:                                             double *emo, double *efa, 
 3333:                                             double *umo, double *ufa, 
 3334:                                             double *vmo, double *vfa) {
 3335: 
 3336: 
 3337:    NODE_BND(nodeBnd);
 3338:    const int idx = idx_node_bnd;    
 3339: 
 3340:    nodeBnd->idx = idx;
 3341: 
 3342:    // Need to find the segment index and the index of the node on the segment
 3343:    int idxNode = -1;
 3344:    int iseg, i;
 3345:    for (iseg = 0; iseg < nope; iseg++) {
 3346:       // for each segment...
 3347:       for (i = 0; i < nond[iseg]; i++) {
 3348:          idxNode = iond[iseg + i*nope];
 3349:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3350:          
 3351:       }
 3352:    }
 3353: 
 3354:    assert(iseg < nope && "iseg is out of bounds");
 3355: 
 3356: found: // Jumped here when the node was found
 3357: 
 3358:    nodeBnd->isEssentialBC = true;
 3359:    nodeBnd->elbc = 0.0;
 3360: 
 3361:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3362: 
 3363:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3364:       nodeBnd->efa[jfr] = efa[idx2];
 3365:       nodeBnd->emo[jfr] = emo[idx2];
 3366:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3367:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3368: 
 3369:    }
 3370:         
 3371: 
 3372: }
