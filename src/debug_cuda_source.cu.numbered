 7036: 
 7037:    __global__ void setVelocityOpenBndNodes(void) {
 7038:    // For open boundary nodes sets their velocity to the imposed values.
 7039: 
 7040:       SIDE_BND(sidebnd);
 7041: 
 7042:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7043:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7044:          // to its segment to the average of the side velocity.
 7045: 
 7046:          for (int k = 0; k < nvrt; k++) {
 7047:             Node *n1 = sidebnd->side->n1;
 7048:             Node *n2 = sidebnd->side->n2;
 7049: 
 7050: 
 7051:             Vector2 n1_u2(n1->u2[k]);
 7052:             Vector2 n2_u2(n2->u2[k]);
 7053: 
 7054:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7055:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7056:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7057:             }
 7058:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7059:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7060:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7061:             }
 7062: 
 7063:          }
 7064: 
 7065:       }
 7066: 
 7067:    }
