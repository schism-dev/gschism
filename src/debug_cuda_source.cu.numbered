 4677:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4678: 
 4679:       SIDE(side);
 4680: 
 4681: 
 4682:       side->U = {0.0, 0.0}; 
 4683:          
 4684:       if(side->isDry) return;
 4685: 
 4686:       const Node *node1 = side->n1;
 4687:       const Node *node2 = side->n2;
 4688: 
 4689:       // Vertically integrated velocity U (in ll if ics=2)
 4690:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4691:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4692:       }
 4693: 
 4694:    }
 4695: 
 4696:    __global__ void computeBottomDragVegetation(void) {
 4697:       // UNFINISHED. CHECK THIS:
 4698:       // How many kernels are needed? Why so many for loops?
 4699:       // Is the loop on sides needed?
 4700: 
 4701:       NODE(node);
 4702: 
 4703: 
 4704:       const int    kb      = node->kb;
 4705:       const double htot    = node->htot2(); 
 4706:       
 4707:       if (node->isDry) {
 4708:          // Default values for dry nodes
 4709:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4710:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4711: 
 4712:          return;
 4713:        
 4714:       }
 4715: 
 4716:       // Computes bottom drag Cd based on the selected nchi
 4717:       node->computeBottomDragCd();
 4718:       
 4719: 
 4720: 
 4721:       //   Bottom stress in m^2/s^2
 4722:       if (node->rho[kb + 1] >= -98.0)
 4723:       {
 4724:          const double mag_u = length(node->u2[kb + 1]);
 4725:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4726: 
 4727:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4728:          // !sediment erosion: this part needs more documentation
 4729:       }
 4730:     
 4731: 
 4732: 
 4733:       // Compute vegetation parameters
 4734:       //--------------------------------
 4735: 
 4736:       // SAV constants
 4737:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4738:       constexpr double veg_cfpsi = 0.16;
 4739: 
 4740:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4741:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4742: 
 4743:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4744:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4745:          int kbin = 0; // bin index
 4746:          for (int k = kb; k < nvrt; k++) {
 4747:             // Computes node height above the bottom level
 4748:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4749:             assert(false && "Vertical variation of vegetation not implemented");
 4750: 
 4751:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4752:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4753:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4754:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4755:             // } else {
 4756:             //    // Find the bin at which the current vertical level is
 4757:             //    while (kbin<nbins_veg_vert) {
 4758:             //       const double zn = node->z[kbin];
 4759:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4760:             //          break;
 4761:             //       } // if
 4762:             //       kbin++;
 4763:             //    } // while
 4764:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4765: 
 4766:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4767:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4768:                
 4769:             //    // Linear interpolation of the vegetation parameters
 4770:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4771:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4772:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4773:             // } // if rl10
 4774: 
 4775:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4776: 
 4777:          } // for k
 4778: 
 4779: 
 4780:       } else { // Ganthy (iveg==2)
 4781:       //  Modify canopy height, diameter, and density
 4782: 
 4783:          // Make sure there is vegetation on this node
 4784:          if (node->veg_h_unbent > 0.0) {
 4785:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4786: 
 4787:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4788:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4789:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4790: 
 4791:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4792:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4793:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4794:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4795:          } // if veg_h_unbent
 4796: 
 4797:          for (int k = 0; k < nvrt; k++) {
 4798:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4799:          } // for k
 4800:       
 4801: 
 4802:       } // if iveg
 4803:      
 4804: 
 4805:       // Compute vertical mean of veg_alpha3D
 4806:       if (iveg != 0) {
 4807:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4808:          double sum1=0.0;
 4809:          double sum2=0.0;
 4810:          // Integrate over each level under the canopy...
 4811:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4812:             const double Dz = node->Dz(k);
 4813: 
 4814:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4815:             sum2 += Dz;
 4816: 
 4817:          } // for k
 4818:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4819:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4820: 
 4821:       } // if iveg
 4822: 
 4823:    }
 4824: 
 4825:    __global__ void computeVegetationAndDragParameters(void) {
 4826:       // Computes the vegetation and drag model parameters:
 4827:       // chi, \tilde\chi, beta, \breve{H}
 4828:       
 4829:       SIDE(side);
 4830: 
 4831:       if (side->isDry) return;
 4832: 
 4833:       const double htot = side->htot2();
 4834:       const int    kb   = side->kb;
 4835: 
 4836:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4837: 
 4838:       const double veg_h     = side->veg_h();
 4839:       const double veg_nv    = side->veg_nv();
 4840:       const double veg_c     = side->veg_c();
 4841:       const double veg_beta  = side->veg_beta;
 4842:       const double veg_alpha = side->veg_alpha_vert_mean();
 4843: 
 4844:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4845:       // Velocity magnitude at the bottom level
 4846:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4847:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4848:       side->chi2 = side->Cd()*vmag1;
 4849:       side->chi  = side->chi2;
 4850:       if constexpr(iveg != 0) {
 4851:          const Node *n1 = side->n1;
 4852:          const Node *n2 = side->n2;
 4853:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4854:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4855:       }
 4856: 
 4857:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4858: 
 4859:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4860:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4861:       double magUa = 0.0;
 4862:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4863:          // 3D wet side with veg...
 4864: 
 4865:          double magUa = 0.0;
 4866:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4867:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4868: 
 4869:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4870:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4871:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4872: 
 4873:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4874:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4875: 
 4876:                // Velocity magnitude at the bottom (l) of the level
 4877:                const double ul = length(side->u2[k]);
 4878: 
 4879:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4880:                magUa += Dz*0.5*(uh + ul);
 4881: 
 4882:             } // if HasVegetation
 4883:          } // for k
 4884:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4885: 
 4886:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4887:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4888:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4889:             const double zCpy = side->zTopCanopy();
 4890:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4891:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4892:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4893:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4894:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4895:          } // if isSubmerged
 4896:       } // if iveg   
 4897: 
 4898:       // Computes the friction modified depth, \breve{H} in notes
 4899:       if (side->is2D()) { // 2D
 4900: 
 4901:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4902:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4903: 
 4904:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4905: 
 4906:          side->hhat = htot*htot/fricH; 
 4907: 
 4908:       } else { // 3D
 4909:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4910: 
 4911:          if constexpr(iveg != 0) {
 4912:             
 4913:             if (side->isSubmerged()) { 
 4914:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4915:                side->hhat -= veg_c*Hhat_alpha;
 4916: 
 4917:             } else { // Emergent
 4918:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4919:             }
 4920:          } // if iveg
 4921: 
 4922:          // Enforce positivity for 3D model
 4923:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4924:       } // if 3D
 4925: 
 4926:    }
 4927: 
 4928: 
 4929: 
 4930:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4931:    // Computes the density gradient between two elements, e1 and e2.
 4932:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4933:    // zero in the direction normal to the side. 
 4934:    // 
 4935:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4936:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4937:    //
 4938:    // Input:
 4939:    //    e1: Element
 4940:    //    e2: Neighbor element (or nullptr if boundary)
 4941:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4942:    //    k: Index of the half-level at which the density is interpolated
 4943:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4944:    // 
 4945:    // Output:
 4946:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4947:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4948: 
 4949:       if (e2 == nullptr || e2->isDry) {
 4950:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4951: 
 4952:          Side *side = e1->sides[j];
 4953:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4954:                  
 4955:          if constexpr(ics == 1) {
 4956:             vec = side->n; // Normal vector to the side
 4957:          } else {
 4958:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4959:             // IMPLEMENT THIS XXXXXX
 4960:             // !replace with xel, yel?
 4961:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4962:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4963:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4964:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4965:          } //ics
 4966:                    
 4967:          diffRho = 0.0;
 4968: 
 4969:       } else { //internal and wet
 4970:          if constexpr(ics==1) {
 4971:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4972: 
 4973:             // Vector from e1 to e2
 4974:             vec = e2->center - e1->center;
 4975: 
 4976:          } else { 
 4977:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4978:             // IMPLEMENT THIS XXXXXX
 4979:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4980:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4981:             //                   alow(j)=xctr2
 4982:             //                   bdia(j)=yctr2
 4983:          } // ics
 4984: 
 4985:          diffRho = rho2 - e1->demeanedDensity(k);
 4986:       }
 4987: 
 4988:    }
 4989: 
 4990:    __global__ void computeDensityCubicSplines(void) {
 4991:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4992: 
 4993:       ELEM(elem);
 4994: 
 4995:       if (elem->isDry) return;
 4996: 
 4997:       const int kb = elem->kb;
 4998: 
 4999:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5000:       if (elem->is2D()) {
 5001:          // In the 2D case, the density is constant at the prism level. 
 5002:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5003:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5004:       } else { //3D
 5005: 
 5006:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5007:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5008:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5009:          ///// XXXX CHECK INDICES!!!!!
 5010:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5011:       } // 2D/3D
 5012: 
 5013:    }
 5014: } // extern "C"
 5015: 
 5016: 
 5017: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5018: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5019: 
 5020:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5021: 
 5022:    const int kb  = elem->kb;
 5023:    const int kb2 = elem2->kb;
 5024: 
 5025:    // z-coordinate of prism of elem
 5026:    const double zp = elem->z_prism(k);
 5027: 
 5028:    double rho = 0.0;
 5029: 
 5030:    if (elem2->is2D()) {
 5031:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5032: 
 5033:    } else {  // 3D
 5034: 
 5035:       // eta_min may be < zmax
 5036:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5037:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5038: 
 5039:       // (Extrapolate density below bottom, we will fix it later)
 5040:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5041:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5042:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5043:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5044:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5045:    } // 2D/3D
 5046:      
 5047: 
 5048:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5049:    // Now we need to fix it.
 5050:    if (elem->z[k] < elem2->z[kb2]) {
 5051:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5052: 
 5053:       // There are two methods to adjust the density at the bottom of the element.
 5054:       // iunder_deep=0: 
 5055:       const double depth1 = abs(elem->z[kb]); // larger depth
 5056: 
 5057:       if (iunder_deep==0) {
 5058: 
 5059:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5060: 
 5061:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5062: 
 5063:       } else { // iunder_deep != 0
 5064: 
 5065:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5066: 
 5067:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5068: 
 5069:          //   Demeaned density at the same z coordinate as
 5070:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5071:          }
 5072: 
 5073:       } // if iunder_deep
 5074:    } // if elem->z[kb] < elem2->z[kb]
 5075: 
 5076:    return rho;
 5077: }
 5078: 
 5079: 
 5080: extern "C" {
 5081:    __global__ void computeDensityGradient(void) {
 5082: 
 5083:       if constexpr(ibc != 0) return;
 5084: 
 5085:          // Compute the horizontal density gradient at each element.
 5086:       // It works in two steps:
 5087:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5088:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5089:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5090:       //             gradRho.r1 = rho1 - rho0
 5091:       //             gradRho.r2 = rho2 - rho0
 5092:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5093:       // 
 5094:       //  NOTE: We use de-meaned densities.
 5095: 
 5096:       ELEM(elem);
 5097: 
 5098:       if (elem->isDry) return;
 5099: 
 5100:       const int kb  = elem->kb;
 5101:       const int i34 = elem->i34;
 5102: 
 5103:       for (int k = kb + 1; k < nvrt; k++) {
 5104:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5105:          //             gradRho.r1 = rho1 - rho0
 5106:          //             gradRho.r2 = rho2 - rho0
 5107:          int icount = 0;
 5108:          double sumRx = 0.0;
 5109:          double sumRy = 0.0;
 5110:          for (int j1=0; j1<i34; j1++) { 
 5111: 
 5112:             const int j2 = elem->nxq(j1 + 1);
 5113: 
 5114:             // Pairs of consecutive neighbor elements of elem
 5115:             const Element *e1 = elem->nghbElems[j1];
 5116:             const Element *e2 = elem->nghbElems[j2];
 5117: 
 5118:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5119:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5120:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5121: 
 5122:             // Compute the density difference and the vector from elem to e1 and e2
 5123:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5124:             double diffRho1, diffRho2;
 5125:             Vector2 vec1, vec2;
 5126:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5127:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5128: 
 5129:             const double rl1 = length(vec1);
 5130:             const double rl2 = length(vec2);
 5131:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5132: 
 5133:             const double delta = cross(vec1, vec2);
 5134:             const double sintheta = abs(delta)/(rl1*rl2);
 5135: 
 5136:             // To avoid problems, avoid elements with small angle between vectors
 5137:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5138:             const bool validEq = (sintheta > sin_one_deg);
 5139: 
 5140:             if (validEq) {
 5141:                // Solve the system of equations to get the density gradient at elem
 5142:                icount++;
 5143:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5144:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5145:                sumRx += Rx;
 5146:                sumRy += Ry;
 5147:             }
 5148:          } // for j1
 5149: 
 5150:          // Compute the average density gradient at elem
 5151:          if (icount==0) {
 5152:            // Bad mesh quality; bail out with 0 b-cc
 5153:            elem->gradRho[k] = {0.0, 0.0};
 5154:          } else {
 5155:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5156:          }
 5157: 
 5158:       } // for k
 5159: 
 5160:    }
 5161: 
 5162:    __global__ void computeBaroclinicTerm(void) {
 5163:    // Computes the baroclinic term at sides (at half levels).
 5164:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5165:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5166: 
 5167:       if (ibc == 1) return;
 5168: 
 5169:       SIDE(side);
 5170: 
 5171:       if (side->isDry) return;
 5172: 
 5173:       const Element *e1 = side->elems[0];
 5174:       const Element *e2 = side->elems[1];      
 5175:       const int kb = side->kb;
 5176:       
 5177:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5178: 
 5179:       // interpolates vertically the density gradient of the two elements at the half level/
 5180: 
 5181:       int k1 = max(kb, nvrt / 2);
 5182:       int k2 = max(kb, nvrt / 2);
 5183: 
 5184:       // Starts the integration at the surface and goes down to the bottom
 5185:       side->bcc[nvrt-1] = {0.0, 0.0};
 5186:       for (int k = nvrt - 2; k >= kb; k--) {
 5187:       // For each prism level (from surface to bottom)...
 5188: 
 5189:          // For both elements, interpolate density gradient at the side's half level.
 5190:          // The gradient at the side is the average of the gradients at the elements.
 5191:          // w1, w2 are used to take into account boundary sides, with just one element.
 5192:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5193:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5194:          const double wsum = w1 + w2;
 5195:          w1 = w1/wsum;
 5196:          w2 = w2/wsum;
 5197:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5198: 
 5199:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5200:          Vector2 gradRho = {0.0, 0.0};
 5201:          if (e1 != nullptr && k > kb) {
 5202:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5203:             
 5204:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5205:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5206:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5207: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5208:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5209:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5210:          }      
 5211:          if (e2 != nullptr && k > kb) {
 5212:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5213:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5214:             
 5215:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5216:          }
 5217: 
 5218:          if constexpr(ics==2) {
 5219:             assert(false && "Not implemented: ics == 2");
 5220:             // IMPLEMENT THIS XXXXXX
 5221:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5222:             // swild(1)=tmp1
 5223:             // swild(2)=tmp2
 5224:          }
 5225:          
 5226:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5227:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5228:          // CHECK INDICES!!! XXX
 5229:          const double grav3 = side->grav3();
 5230:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5231: 
 5232:       } // for
 5233: 
 5234:    }
 5235: 
 5236: 
 5237: 
 5238:    __global__ void computeHorGradientAtSide(void) {
 5239: 
 5240:       // Compute the horizontal density gradient at each element.
 5241:       // It works in two steps:
 5242:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5243:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5244:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5245:       //             gradRho.r1 = rho1 - rho0
 5246:       //             gradRho.r2 = rho2 - rho0
 5247:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5248:       // 
 5249:       //  NOTE: We use de-meaned densities.
 5250: 
 5251:       SIDE(side);
 5252: 
 5253: // printf("side->isDry: %d\n", side->isDry);
 5254:       if (side->isDry) return;
 5255: 
 5256:       // Computes the gradient of the variables at the side center.
 5257:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5258:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5259:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5260: 
 5261:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5262:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5263:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5264:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5265: 
 5266: 
 5267:    }
 5268: 
 5269: 
 5270:    __global__ void solveMomentumEquations(double time) {
 5271: 
 5272:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5273:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5274: 
 5275:       SIDE(side);
 5276: 
 5277:       if (side->isDry) 
 5278:       {
 5279:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code uses {0,0}  in line ~6462   
 5280: 
 5281:          return;
 5282:       }
 5283: 
 5284:       const Node *n1 = side->n1;
 5285:       const Node *n2 = side->n2;
 5286: 
 5287:       const int kb = side->kb;
 5288: 
 5289:       const double veg_h = side->veg_h();
 5290:       const double grav3 = side->grav3();
 5291: 
 5292:       if (side->is2D()) {
 5293:          // Warning: Do not use htot2, which is updated.
 5294:          const double htot = side->htot1();
 5295:          const double hhat = side->hhat;
 5296: 
 5297:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5298: 
 5299:          Vector2 tau2 = {0.0, 0.0};
 5300:           
 5301:          if constexpr(ics==1) {
 5302:             tau2 = side->tau();
 5303: 
 5304:          } else {
 5305:             assert(false && "Not implemented: ics == 2");
 5306:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5307:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5308:             // taux2=(vn1+tt1)*0.5d0
 5309:             // tauy2=(vn2+ss1)*0.5d0
 5310:          } // if ics         
 5311: 
 5312:          // hat_gam has units of m/s
 5313: 
 5314:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5315: 
 5316:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5317:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5318: 
 5319:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5320: 
 5321: 
 5322:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5323:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5324: 
 5325:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5326: 
 5327:       }
 5328:       else { // 3D
 5329: 
 5330:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5331:          // 
 5332:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5333:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5334:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5335:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5336:          // k+1 and k.
 5337: 
 5338: 
 5339:          const int ndim = nvrt - kb;
 5340:          const double zTopCanopy = side->zTopCanopy();
 5341: 
 5342:          // Initialize the tridiagonal system
 5343:          for (int k = kb + 1; k < nvrt; k++) {
 5344:             
 5345:             const int kin = k - (kb + 1);
 5346: 
 5347:             // Vertical viscosity at the face center
 5348:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5349: 
 5350:  
 5351:             alow[kin] = 0.0;
 5352:             cupp[kin] = 0.0;
 5353:             bdia[kin] = 0.0;
 5354: 
 5355:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5356:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5357: 
 5358:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5359:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5360:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5361: 
 5362:             // First part: layers k, k+1
 5363:             if (k < nvrt - 1) {
 5364:                              
 5365:                if constexpr(iveg != 0) {
 5366: 
 5367:                   // If there is vegetation at this level...
 5368:                   if (zTopCanopy > side->zc[k]) {
 5369:                      // If the canopy is above the k layer...
 5370:                      
 5371:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5372:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5373:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5374:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5375: 
 5376:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5377:                      const double vmag2 = length(ut2);
 5378:                      const double vmag1 = length(side->u2[k]);
 5379:                      const double vmag = 0.5*(vmag1 + vmag2);
 5380:                      
 5381:                      // Computes the vegetation alpha at the face center
 5382:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5383: 
 5384:                      cff1 += veg_alpha_sd*dt*vmag;
 5385: 
 5386:                   } // if (zTopCanopy
 5387:                } // if iveg
 5388: 
 5389:                const double dzz = side->Dz(k + 1);
 5390:                const double tmp = dt*dfz/dzz;
 5391:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5392: 
 5393:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5394:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5395:             }
 5396: 
 5397: 
 5398:             // Second part: layers k-1, k
 5399:             if (k > kb + 1) {
 5400: 
 5401:                double cff1 = 1.0; //init \bar{c^k}
 5402: 
 5403:                if constexpr(iveg != 0) {
 5404:                   // If there is vegetation at this level...
 5405:                   if (zTopCanopy > side->zc[k-1]) {
 5406:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5407:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5408: 
 5409:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5410: 
 5411:                      const double vmag2 = length(ut2);
 5412:                      const double vmag1 = length(side->u2[k-1]);
 5413:                      const double vmag = 0.5*(vmag1 + vmag2);
 5414: 
 5415:                      // Computes the vegetation alpha at the face center
 5416:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5417:                      cff1 += veg_alpha_sd*dt*vmag;
 5418:                   } // if zTopCanopy
 5419: 
 5420:                } // if iveg
 5421: 
 5422:                const double dzz = side->Dz(k);
 5423:                const double tmp = dt*dfz/dzz;
 5424:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5425: 
 5426:                alow[kin] += cff1*dzz/6.0 - tmp;
 5427:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5428: 
 5429:             } else { // Bottom boundary
 5430:                // This occurs at the bottom, where the bottom drag is applied.
 5431: 
 5432:                bdia[kin] += dt*side->chi2; // XXXX
 5433: 
 5434:             } // if (k > kb + 1)
 5435: 
 5436: 
 5437:          } // for (int k
 5438: 
 5439: 
 5440: 
 5441:          // Computes the RHS.
 5442:          // -----------------
 5443: 
 5444:          //	BC to be imposed at the end.
 5445: 
 5446:          const Vector2 gradETP  = side->gradETP;
 5447:          const Vector2 gradPr   = side->gradPr;
 5448:          const Vector2 gradEta1 = side->gradEta1;
 5449:          const Vector2 gradEta2 = side->gradEta2;
 5450: 
 5451:          const Vector2 *btu = side->btu;
 5452:          const Vector2 *u2  = side->u2;
 5453:          const double coriolis = side->coriolis;
 5454:          const Vector2 *nuGradU = side->nuGradU;
 5455: 
 5456: 
 5457:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5458: 
 5459:          for (int k = kb + 1; k < nvrt; k++) {
 5460:             const int kin = k - kb - 1;
 5461: 
 5462:             const double dz_0 = side->Dz(k);
 5463:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5464: 
 5465:             rrhs[kin] = {0.0, 0.0};
 5466:             double dz = 0.0;
 5467: 
 5468:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5469:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5470:             if (k < nvrt  ) dz += dz_1;
 5471:             if (k > kb + 1) dz += dz_0;
 5472: 
 5473:             // Elevation gradient, atmospheric pressure and tidal potential
 5474:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5475: 
 5476:             // Coriolis, advection, wind stress, and horizontal viscosity
 5477:             if (k < nvrt - 1) {
 5478: 
 5479: 
 5480:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5481:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5482:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5483:                                                 
 5484: 
 5485:                //diff stress tensors 1006
 5486:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5487:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5488:                   assert(false && "Not implemented: itur == 5");
 5489:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5490:                }
 5491:                // else assert(false && "itur # Not implemented");
 5492: 
 5493:             } else { // k == nvrt - 1 SURFACE
 5494:                Vector2 tau2 = {0.0, 0.0};
 5495:                if constexpr(ics==1) {
 5496:                   tau2 = side->tau();
 5497:       
 5498:                } else {
 5499:                   assert(false && "Not implemented: ics == 2");
 5500:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5501:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5502:                   // taux2=(vn1+tt1)*0.5d0
 5503:                   // tauy2=(vn2+ss1)*0.5d0
 5504:                } // if ics
 5505: 
 5506:                rrhs[kin] += dt*tau2;
 5507:           
 5508: 
 5509:             } // if k<nvrt
 5510: 
 5511:             if (k > kb + 1) {
 5512:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5513:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5514:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5515: 
 5516:                // diff stress tensors 1006
 5517:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5518:                   assert(false && "Not implemented: itur == 5");
 5519:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5520:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5521:                }
 5522:                // else assert(false && "itur # Not implemented");
 5523: 
 5524: 
 5525:             } // if k>kbs + 1
 5526: 
 5527:             // Baroclinic
 5528:             Vector2 *bcc = side->bcc;
 5529:             if constexpr(ibc == 0) {
 5530:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5531:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5532: 
 5533:             } // if ibc==0
 5534: 
 5535:          } // k=kb + 1,nvrt
 5536: 
 5537: 
 5538:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5539: 
 5540:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5541:             const int kin = k - kb - 1;
 5542:    
 5543:             // Velocity is always clamped to maximum values
 5544:             side->u2[k] = {clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely)};
 5545:          } // k
 5546: 
 5547:       } // if side->is2D()
 5548:       
 5549: 
 5550:       // Impose velocity boundary condition at the bottom
 5551:       if constexpr(imm == 2) { // 3D bed deformation model
 5552:          double dep;
 5553:          Vector2 vel;
 5554: 
 5555:          assert(false && "Not implemented: imm == 2");
 5556:          //update_bdef(time, x0, y0, dep, vel);
 5557:          // side->u2[kb] = vel;
 5558: 
 5559:       } else { // imm = 0 or 1
 5560:          if (side->Cd() == 0.0) {
 5561:             side->u2[kb] = side->u2[kb + 1];
 5562: 
 5563:          } else if (side->is3D()) { // 3D no slip bottom   
 5564:             side->u2[kb] = {0.0, 0.0};
 5565:          }
 5566:           
 5567:       } // if imm
 5568: 
 5569:       // The velocities below the bottom level are set to zero
 5570:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5571: 
 5572: 
 5573:    }
 5574: 
 5575: 
 5576:    __global__ void applyMomentumBC(void) {
 5577: 
 5578:       SIDE_BND(sideBnd);
 5579: 
 5580:       Side *side = sideBnd->side;
 5581:       const BoundarySegment *segment = sideBnd->segment;
 5582:       const Node *n1 = side->n1;
 5583:       const Node *n2 = side->n2;
 5584: 
 5585:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5586: 
 5587:       const bool isLand = segment->isLand;
 5588:       const int ifltype = segment->ifltype;
 5589: 
 5590:       const int kb = side->kb;
 5591: 
 5592: 
 5593:       if (!isLand && ifltype != 0) {
 5594:          const Vector2 *ubc = sideBnd->ubc;
 5595:   
 5596:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5597:             
 5598:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5599:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5600: 
 5601:             if (ifltype == -1) {
 5602:                // Flather 1
 5603: 
 5604:                const double depth = side->depth();
 5605: 
 5606:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5607: 
 5608:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5609: 
 5610:                side->u2[k] = vnorm*side->n;
 5611: 
 5612:             } else if (ifltype == -2) { // Discharge
 5613: 
 5614:                const double eta1 = side->eta1();
 5615:                const double eta2 = side->eta2();
 5616:                const double htot = side->htot2();
 5617: 
 5618:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5619:                assert(false && "Not implemented: Discharge bc");
 5620:                // const double dischrg = discharge(eta1);
 5621:                const double dischrg = 0.0; // XXX REMOVE
 5622:                
 5623: 
 5624:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5625: 
 5626:                const double vnorm = dischrg*eta2/htot;
 5627: 
 5628:                side->u2[k] = vnorm*side->n;
 5629: 
 5630:             }
 5631:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5632:                const double vnorm = dot(side->u2[k], side->n);
 5633: 
 5634:                double rat;
 5635:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5636:                else              rat = segment->vobc2; // outgoing
 5637: 
 5638:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5639: 
 5640:             }
 5641:             else { // not Flather or 3D radiation
 5642:                side->u2[k] = ubc[k];
 5643: 
 5644:             } // if (segment->ifltype...
 5645: 
 5646:          }
 5647: 
 5648:       }
 5649:       else if (isLand) { // if it is land boundary side
 5650: 
 5651:          if constexpr(islip == 0) { // free slip
 5652: 
 5653:             for (int k = kb; k < nvrt; k++) {
 5654: 
 5655:                const Vector2 t = side->t();
 5656:                const Vector2 n = side->n;
 5657: 
 5658:                double vnorm = 0.0; // for most cases
 5659:                const double vtan = dot(side->u2[k], t);
 5660:                
 5661:                side->u2[k] = vtan*t - vnorm*n;
 5662: 
 5663:             }
 5664: 
 5665:          } else { // no slip
 5666:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5667: 
 5668:          }
 5669:       } // if (side segment type...
 5670: 
 5671:    
 5672: 
 5673:    }
 5674: 
 5675: 
 5676:    __global__ void shapiroFilter1(void) {
 5677:       // First step of the Shapiro filter (normally used if indvel<=0)
 5678:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5679: 
 5680:       SIDE(side);
 5681: 
 5682:       // Only internal wet sides are processed
 5683:       if (side->isDry || !(side->isInternal())) return;
 5684: 
 5685:       const int kb = side->kb;
 5686: 
 5687:       for (int mm = 0; mm < niter_shap; mm++) {
 5688: 
 5689:          for (int k = kb + 1; k < nvrt; k++) {
 5690:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5691:             Vector2 suru = {0.0, 0.0};
 5692: 
 5693:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5694: 
 5695:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5696: 
 5697:                int kin = k;
 5698:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5699:                
 5700:                if constexpr(ics==1) {
 5701:                   suru += nSide->u2[kin];
 5702: 
 5703:                } else {
 5704:                   assert(false && "Not implemented: ics == 2");
 5705:                   // Vector2 vn1, vn2;
 5706:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5707:                   // suru=suru+vn1;
 5708:                   // surv=surv+vn2;
 5709:                }
 5710:             }
 5711: 
 5712:             // Reusing bcc as a temporary array to store the suru values.
 5713:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5714: 
 5715:          }
 5716:       }
 5717:    }
 5718: 
 5719:    __global__ void shapiroFilter2(void) {
 5720:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5721: 
 5722:       SIDE(side);
 5723: 
 5724: 
 5725:       if (side->isDry || !(side->isInternal())) return;
 5726: 
 5727:       const int kb = side->kb;
 5728: 
 5729:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5730: 
 5731:       if (side->is2D()) {
 5732:          side->u2[kb + 1] = side->bcc[kb + 1];
 5733:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5734: 
 5735:       } else {
 5736:          // 3D
 5737:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5738:          
 5739:       }
 5740: 
 5741:    }
 5742: 
 5743: 
 5744:    __global__ void ul0UpdateZCoords(void) {
 5745:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5746:       
 5747:       NODE(node);      
 5748: 
 5749: 
 5750:       if (false) {//node->isDry) {  //XXXXXXXXXXXXXXXXX
 5751: 
 5752:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5753: 
 5754:          if constexpr(ivcor != 1) node->kb = 0;
 5755: 
 5756:       } else {
 5757: 
 5758:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5759:          node->updateKb();
 5760: 
 5761:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5762: 
 5763:       }
 5764: 
 5765:       // We use the temp.b field to store the previous state of isDry.
 5766:       node->tmp.b = node->isDry;
 5767: 
 5768:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5769:       node->isDry = true;
 5770: 
 5771:    }
 5772: 
 5773:    __global__ void ul0ComputeDryElements(void)
 5774:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5775:    {
 5776:       ELEM(elem);
 5777: 
 5778:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5779: 
 5780:       elem->kb = 0;
 5781: 
 5782:       if (elem->isDry) return;
 5783: 
 5784: 
 5785:    //    if(elem->isDry2()) { // XXXX
 5786:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5787:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5788:    //        call parallel_abort(errmsg)
 5789:    //    }
 5790: 
 5791:       const Node *n1 = elem->nodes[0];
 5792:       const Node *n2 = elem->nodes[1];
 5793:       const Node *n3 = elem->nodes[2];  
 5794:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5795: 
 5796:       // Computes element's kb as the minimum of the nodes' kb.
 5797:       const int kb1 = n1->kb;
 5798:       const int kb2 = n2->kb;
 5799:       const int kb3 = n3->kb;
 5800:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5801: 
 5802: 
 5803:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5804: 
 5805: 
 5806:       // Computes the element z as the mean of the nodes z.
 5807:       for (int k = elem->kb; k < nvrt; k++) {
 5808: 
 5809:          // Compute the element z as the mean of the nodes z.
 5810:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5811:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5812:          elem->z[k] /= elem->i34;
 5813: 
 5814:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5815:       }
 5816:                   
 5817:    }
 5818: 
 5819:    __global__ void ul0ComputeDryNodes(void)
 5820:    // Updates node's isDry based on the elements' isDry. 
 5821:    {
 5822:       NODE(node);
 5823: 
 5824:       node->isDry = true;
 5825: 
 5826:       // A node is wet if at least one of the elements sharing it is wet.
 5827:       for (int j = 0; j < node->numElements; j++) {
 5828:          const Element *elem = node->elements[j];
 5829:          if (!elem->isDry) {
 5830:             node->isDry = false;
 5831:             break;
 5832:          }
 5833:       }
 5834: 
 5835:        
 5836:    }
 5837: 
 5838: 
 5839:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5840:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5841:    // node->tmp.b is true if the node was previously dry.
 5842:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5843:    {
 5844:       NODE(node);
 5845:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5846: 
 5847:       // Avoid this the first time step.
 5848:       if (it == iths) return;  
 5849: 
 5850:       const bool wasDry = node->tmp.b;
 5851: 
 5852:       // assert(node->isDry == node->isDry2() && "These two must be identical at this point"); XXXXX 
 5853:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5854: 
 5855:          for (int k=0; k < nvrt; k++) {
 5856: 
 5857:             Vector3 utmp={0.0, 0.0, 0.0};
 5858: 
 5859:             double ttmp=0.0;
 5860:             double stmp=0.0;
 5861:             int icount=0;
 5862:             for (int j = 0; j < node->numNodes; j++) {
 5863: 
 5864:                const Node *nbrNode = node->nodes[j];
 5865:                
 5866:                const bool wasNbrDry = nbrNode->tmp.b;
 5867: 
 5868:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5869:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5870: 
 5871:                   icount++;
 5872: 
 5873:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5874:                   utmp += nbrNode->uvw2(k);
 5875:                   
 5876:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5877:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5878:                }
 5879:             }
 5880: 
 5881:             if (icount > 0) {
 5882:                const double inv_icount = 1.0/icount;
 5883:                utmp = inv_icount*utmp;
 5884:                node->u2[k]     = toVector2(utmp);
 5885:                node->w2[k]     = utmp.z;
 5886:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5887:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5888:             } else {
 5889:                node->u2[k] = {0.0, 0.0};
 5890:                node->w2[k] = 0.0;
 5891:                // Initialize tracers to 0.0??? XXXXX
 5892:             }
 5893:          }
 5894:       }
 5895:    }
 5896: 
 5897:   
 5898:    
 5899: 
 5900: 
 5901:    __global__ void ul0UpdateSides(int it, int iths) {
 5902:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5903:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5904:    // The dryness of the sides is updated in ul0UpdateSides2.
 5905: 
 5906:       SIDE(side);
 5907: 
 5908:       // A side is wet if and only if at least one of its elements is wet.
 5909:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5910:  
 5911:       const Node *n1 = side->n1;
 5912:       const Node *n2 = side->n2;
 5913:      
 5914:       const int kb1 = n1->kb;
 5915:       const int kb2 = n2->kb;
 5916: 
 5917:       side->kb = 0; // default when dry
 5918: 
 5919:       if (isWet) {
 5920: 
 5921:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5922: 
 5923:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5924: 
 5925:          side->kb = min(kb1, kb2);
 5926: 
 5927:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5928: 
 5929:          for (int k = side->kb; k < nvrt; k++) {
 5930:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5931: 
 5932:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5933: 
 5934:             // Compute velocity for re-wetted sides 
 5935:             if ((it != iths) && (side->isDry && isWet)) {
 5936: 
 5937:                Vector2 utmp={0.0, 0.0};
 5938: 
 5939:                int icount=0;
 5940: 
 5941:                // For all the sides on the two elements that share this side
 5942:                for (int j = 0; j < 2; j++) {
 5943:                   const Element *elem = side->elems[j];
 5944:                   if (elem == nullptr) continue;
 5945: 
 5946:                   for (int jj=0; jj < elem->i34; jj++) {
 5947:                      const Side *nSide = elem->sides[jj];
 5948:                      if (nSide->isDry) continue;
 5949: 
 5950:                      icount++;
 5951:                      utmp += nSide->u2[k];  
 5952:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5953:                   }
 5954:                }
 5955:                   
 5956:                // assert(icount > 0 && "No wet sides around this side");  XXXXX RECOVER??? 
 5957:                if (icount > 0)  side->u2[k] = utmp/icount;
 5958:                else             side->u2[k] = {0.0, 0.0};
 5959:                   
 5960:             } // if ((it != iths) && (side->isDry && isWet))
 5961: 
 5962:          } // for k
 5963: 
 5964:       } // if isWet 
 5965:       
 5966: 
 5967: 
 5968:    }
 5969: 
 5970:    __global__ void ul0UpdateSides2(void) {
 5971:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5972:    
 5973:          SIDE(side);
 5974:    
 5975:          const Element *e1 = side->elems[0];
 5976:          const Element *e2 = side->elems[1];
 5977: 
 5978:          // A side is wet if and only if at least one of its elements is wet.
 5979:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5980: 
 5981:          // Update the side's dryness
 5982:          side->isDry = !isWet;
 5983: 
 5984:    }
 5985: 
 5986: 
 5987:    __global__ void zeroNodalVelocities(void) {
 5988:       NODE(node);
 5989: 
 5990:       for (int k = 0; k < nvrt; k++) {
 5991:          node->u2[k]   = {0.0, 0.0};
 5992:          node->w2[k]   = 0.0;
 5993:          node->utmp[k] = {0.0, 0.0};
 5994:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5995:       }
 5996:    }
 5997: 
 5998:  
 5999: 
 6000:    __global__ void computeNodalVerticalVelocities1(void) {
 6001:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6002:    // Adds the element's vertical velocity times the element's area.
 6003:       ELEM(elem);
 6004: 
 6005:       for (int j = 0; j < elem->i34; j++) {
 6006:          Node *node = elem->nodes[j];
 6007: 
 6008:          for (int k = node->kb; k < nvrt; k++) {
 6009:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6010:          }
 6011:          atomicAdd(&(node->tmp.d), elem->area);
 6012:       }
 6013:    }
 6014: 
 6015:    __global__ void computeNodalVerticalVelocities2(void) {
 6016:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6017:    // Divides by the total area of the elements sharing the    node.
 6018:       NODE(node);
 6019: 
 6020:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6021: 
 6022:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6023:    }
 6024: 
 6025: 
 6026:    __global__ void computeNodalHorizontalVelocities1(void) {
 6027: 
 6028:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6029:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6030: 
 6031:       ELEM(elem);
 6032: 
 6033:       if (elem->isDry) return;
 6034: 
 6035:       const int kb = elem->kb;
 6036:       const bool isTri = elem->isTri();
 6037: 
 6038:       if constexpr(indvel <= 0) {
 6039:          // Assuming discontinous hvel.
 6040: 
 6041:          if (isTri) { // For triangles
 6042:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6043:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6044: 
 6045:             for (int j = 0; j < 3; j++) {
 6046:                // For every node of the triangle...
 6047:                Node *node = elem->nodes[j];
 6048: 
 6049:                if (node->isDry) continue;
 6050: 
 6051:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6052:                const Side *s2 = elem->sides[(j + 1) % 3];
 6053:                const Side *s3 = elem->sides[(j + 2) % 3];
 6054: 
 6055: 
 6056:                atomicAdd(&(node->tmp.i), 1);
 6057: 
 6058:                for (int k = kb; k < nvrt; k++)  {
 6059:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at node j.   XXXX Function for clamping velocities. const vector2 u
 6060:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6061:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6062:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6063:                   atomicAdd(&(node->utmp[k].x), u.x);
 6064:                   atomicAdd(&(node->utmp[k].y), u.y);
 6065: 
 6066:                }
 6067: 
 6068:             }
 6069:          }
 6070:          else { // For quads
 6071:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6072: 
 6073:          }
 6074: 
 6075:       }
 6076:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6077:       
 6078:    }
 6079: 
 6080: 
 6081:    __global__ void computeNodalHorizontalVelocities2(void) {
 6082:       NODE(node);
 6083: 
 6084:       const int nodeCount = node->tmp.i;
 6085: 
 6086:       if (nodeCount == 0) 
 6087:       {
 6088:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6089:          return;
 6090:       }
 6091: 
 6092:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6093:       
 6094:       const int kb = node->kb;
 6095: 
 6096:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6097:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6098:       
 6099:       
 6100:    }   
 6101: 
 6102:  
 6103: 
 6104:    __global__ void resetVelocityOpenBndNodes(void) {
 6105:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6106: 
 6107:       NODE_BND(nodebnd);
 6108: 
 6109:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6110:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6111:       }
 6112: 
 6113:    }
 6114: 
 6115: 
 6116:    __global__ void setVelocityOpenBndNodes(void) {
 6117:    // For open boundary nodes sets their velocity to the imposed values.
 6118: 
 6119:       SIDE_BND(sidebnd);
 6120: 
 6121:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6122:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6123:          // to its segment to the average of the side velocity.
 6124: 
 6125:          for (int k = 0; k < nvrt; k++) {
 6126:             Node *n1 = sidebnd->side->n1;
 6127:             Node *n2 = sidebnd->side->n2;
 6128: 
 6129: 
 6130:             Vector2 n1_u2(n1->u2[k]);
 6131:             Vector2 n2_u2(n2->u2[k]);
 6132: 
 6133:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6134:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6135:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6136:             }
 6137:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6138:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6139:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6140:             }
 6141: 
 6142:          }
 6143: 
 6144:       }
 6145: 
 6146:    }
 6147: 
 6148: 
 6149:    __global__ void computeVerticalVelocity(void) {
 6150:       // Computes the vertical velocity at the (2D) element's centroid.
 6151:       // In this function we will be considering volumetric elements, with side faces and a 
 6152:       // bottom and a top face. We will call them SFs, BF and TF.
 6153:       // It computes the flux coming from BF and the SFs.
 6154:       // If the bed is moving, it takes that into account.
 6155:       // Since water is incompressible, the integral of the velocity times the normal vector
 6156:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6157:       // and the BF is equal to the flux going out from the TF.
 6158:       // TF = - BF - sum(SFs).
 6159:       // It then computes the horizontal velocity at the center of TF.
 6160:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6161:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6162:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6163: 
 6164:       ELEM(elem);
 6165: 
 6166:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6167: 
 6168:       if (elem->isDry) return;
 6169: 
 6170:       const int kb = elem->kb;
 6171:       const bool isTri = elem->isTri();
 6172: 
 6173:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6174: 
 6175:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6176:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6177:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6178: 
 6179:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6180: 
 6181:       double area3D;
 6182: 
 6183:       // Bottom face flux
 6184:       double bottomFlux = 0.0;
 6185:       Vector2 u2meanBottom = {0.0, 0.0};
 6186:       const Vector2 gradh = elem->grad2(&Node::depth);
 6187:       if constexpr(imm==2) {
 6188:          Vector3 ubed;
 6189: 
 6190:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6191:          // updateBDEF(ubed);
 6192:      
 6193:          // const double bflux0 = dot(ubed, elem_n1);
 6194: 
 6195:          // elem->w[kb] += ubed.z;
 6196:       }
 6197:       else {
 6198:          Vector2 umean;
 6199:          if constexpr(ics == 1) {
 6200:             u2meanBottom = elem->mean(kb, &Side::u2);
 6201:          }
 6202:          else {
 6203:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6204:          }
 6205: 
 6206:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6207:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6208: 
 6209:          bottomFlux = - dot(gradh, u2meanBottom);
 6210:       } // if imm
 6211: 
 6212:       // Compute w for kb+1 to nvrt-1
 6213:       for (int l = kb; l < nvrt - 1; l++) {
 6214: 
 6215:          // normal vector to the top face of the "volumetric" element (3D)
 6216:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6217: 
 6218:          // Compute the total flux at the sides
 6219:          double sideFlux = 0.0;
 6220: 
 6221:          for (int j = 0; j < elem->i34; j++) {
 6222:             const Side *side = elem->sides[j];
 6223: 
 6224:             const double sideArea = side->area(l);
 6225:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6226:             const double sign = elem->ssign[j]; 
 6227: 
 6228:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6229:          }
 6230:          
 6231:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6232:          //velocities at the centers of the sides
 6233:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6234: 
 6235:          // The flx at the top ace can be computed from the other flows.
 6236:          const double topFlux = - sideFlux - bottomFlux;
 6237:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6238: 
 6239:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6240: 
 6241:          elem_n1 = elem_n2;
 6242: 
 6243:          bottomFlux = - topFlux;
 6244:       }
 6245:    }  
 6246: 
 6247: 
 6248: 
 6249: 
 6250: 
 6251: 
 6252: 
 6253: // !===============================================================================
 6254: // !===============================================================================
 6255: 
 6256: } // extern "C"
 6257: 
 6258: #ifdef DONTCOMPILE
 6259: __device__ void computeVerticalAdvection(void) {
 6260:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6261: 
 6262:    sdbt(1:2,:,:)=0.d0
 6263: 
 6264:    const Side *side = FROM kernel;
 6265: 
 6266:    if(side->isDry) return;
 6267: 
 6268:    // If side is wet...
 6269: 
 6270: 
 6271:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6272:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6273:    double ws[nvrt] = {} // w @ side
 6274:    int icount = 0;
 6275:    for (int j=0; j<2; j++) {
 6276:       const Element *elem = side->elements[j];
 6277:        
 6278:       if(elem != nullptr) {
 6279:          icount++;
 6280:          for (int k=0; k<nvrt; k++) {
 6281:             ws[k] = ws[k] + elem->w[k];
 6282:          }
 6283:       }
 6284:    }  // for j
 6285: 
 6286:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6287:    ws = ws/icount;
 6288: 
 6289:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6290:    // Splines allow for a smooth transition between vertical levels.
 6291:    // Splines have continuity restrictions at the internal knots, but
 6292:    // we have to provide the 1st derivatives at the endpoints.
 6293:    const int kbs = side->kbs; 
 6294:    
 6295:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6296:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6297:    initCubicSpline(kbs, nvrt, side, ws, up)
 6298: 
 6299:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6300:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6301:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6302: 
 6303:    // Total advection (average onto side)
 6304:    const Node *node1 = side->nodes[0];
 6305:    const Node *node2 = side->nodes[1];
 6306:    for (int k=kbs(i); k<nvrt; k++) {
 6307: 
 6308:       if constexpr(ics==1) {
 6309:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6310:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6311:       } else {
 6312:          // XXX IMPLEMENT THIS
 6313:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6314:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6315:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6316:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6317:       }  // if ics
 6318: 
 6319: 
 6320:    }
 6321: }
 6322: #endif
 6323: 
 6324: 
 6325: extern "C" {
 6326:    __global__ void computeElemAverageGhat(void) {
 6327:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6328: 
 6329:       ELEM(elem);
 6330:       
 6331:       elem->ghat1= {0.0, 0.0};  
 6332: 
 6333:       if constexpr(ihydraulics != 0) {
 6334:          if (nhtblocks > 0 && elem->isblock) return;
 6335:       }
 6336: 
 6337:       if (elem->isDry) return;
 6338: 
 6339:       // Wet elements.
 6340:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6341:       // tidal potential, horizontal diffusion, and baroclinic etc
 6342:       // Remember to update both fb and F 
 6343:       // If ics=2, ghat1 are in eframe (ll)
 6344:       // cff1-3: coefficients for 2D/3D
 6345:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6346:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6347:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6348: 
 6349:       double av_cff1 = 0.0;  // av. for cff1
 6350:       double av_cff2 = 0.0;  // av. for cff2
 6351:       double av_cff3 = 0.0;  // av. for cff3
 6352:       double av_df = 0.0;  // av. for H^\alpha / H
 6353:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6354:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6355: 
 6356:       const int i34 = elem->i34;
 6357:       const int kb = elem->kb;
 6358: 
 6359:       for (int j=0; j<i34; j++) {
 6360:          // For each node and side in the element...
 6361: 
 6362:          const Node *node = elem->nodes[j];
 6363:          const Side *side = elem->sides[j];
 6364: 
 6365:          const double chi      = side->chi;
 6366:          const double veg_c2   = side->veg_c2;
 6367:          const double veg_beta = side->veg_beta;
 6368:          const double veg_h    = side->veg_h();
 6369:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6370: 
 6371:          // Node - const in elem
 6372:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6373:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6374: 
 6375:          if (elem->depth >= tip_dp) {
 6376:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6377:          }
 6378: 
 6379:          
 6380:          const double htot  = side->htot2();        // Total depth at the side
 6381:          const double zctr2 = side->zTopCanopy();  
 6382: 
 6383:          double cff1; 
 6384:          double cff2; 
 6385:          double cff3;   
 6386:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6387:          // coefficients applied to 2D/3D case 
 6388:             cff1 = side->hhat/htot;
 6389:             cff2 = 0.0;
 6390:             cff3 = 0.0;
 6391:          } else { //3D
 6392:             //Init for no-veg case
 6393:             cff1 = 1.0;
 6394:             cff2 = 1.0;
 6395:             cff3 = 0.0;
 6396: 
 6397:             if constexpr(iveg != 0) {
 6398:                // Computes coefficients used with vegetation terms G1, G2
 6399:                // cff1, cff3 are used for the first two terms in G1, G2:
 6400:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6401:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6402:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6403:                if(veg_h < 0.99*htot) { // submergent vegetation
 6404:                   cff1=1;
 6405:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6406:                   cff3 = veg_c;
 6407: 
 6408:                } else { // emergent vegetation
 6409:                   cff1 = 1.0/(1.0 + veg_c2);
 6410:                   cff2 = cff1;
 6411:                   cff3 = 0.0;
 6412: 
 6413:                }
 6414:             } // if iveg
 6415:          } //  2D/3D
 6416: 
 6417:          av_cff1 += cff1/i34;
 6418:          av_cff2 += cff2/i34;
 6419:          av_cff3 += cff3/i34;
 6420:          av_cff2_chi += cff2*chi/i34;
 6421:          av_cff3_chi += cff3*chi/i34;
 6422:          av_df += min(htot, veg_h)/(htot*i34);
 6423: 
 6424: 
 6425:          // btrack values: U^\star, U^{\star\alpha}
 6426:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6427:          Vector2 Ustar       = {0.0, 0.0}; 
 6428:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6429: 
 6430:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6431:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6432:          } else { //3D
 6433:             for (int k = side->kb; k < nvrt; k++) {
 6434:             
 6435:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6436:                Ustar += w2;
 6437: 
 6438:                if constexpr(iveg != 0) {
 6439:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6440:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6441:                        Ustar_alpha += zrat*w2; // XXXX
 6442:                    }
 6443:                }  // if iveg
 6444:             }  // for k
 6445:          }  //2D/3D
 6446:          
 6447: 
 6448:          // Add btrack & surface stress terms to \breve{G} first
 6449:          if constexpr(ics==1) {
 6450: 
 6451:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6452: 
 6453:          } else {
 6454:             assert(false && "computeElemAverageGhat: Not implemented");
 6455:             // XXX IMPLEMENT THIS
 6456:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6457:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6458:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6459:          }  // if ics
 6460: 
 6461:          // Surface and bottom stress terms
 6462:          if constexpr(ics==1) {
 6463:             const Vector2 tau    = side->tau();
 6464:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6465: 
 6466:             // Term for surface and bottom stress
 6467:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6468: 
 6469:          } else {
 6470:             assert(false && "computeElemAverageGhat: Not implemented");
 6471:             // XXX IMPLEMENT THIS
 6472:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6473:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6474:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6475:             // tau_x=(vn1+tt1)/2.d0
 6476:             // tau_y=(vn2+ss1)/2.d0
 6477:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6478:          }  // if ics
 6479: 
 6480:          
 6481: 
 6482:          // All terms in F,F^\alpha,f_b except baroclinic
 6483:          // F, f_b: all explicit terms excluding vegetation 
 6484:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6485:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6486:          const double coriolis = side->coriolis;
 6487:          Vector2 F  =  coriolis*side->U;  // F_x
 6488:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6489:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6490: 
 6491:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6492:             
 6493:             for (int k = side->kb; k < nvrt; k++) {
 6494:                if (zctr2 > side->zc[k-1]) {
 6495:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6496:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6497:                    Fa +=  coriolis*w2*zrat;
 6498:                } // if zctr2
 6499:             } // k
 6500:          } // iveg
 6501: 
 6502:          // Integrate horizontal viscosity force vertically
 6503:          for (int k=side->kb + 1; k<nvrt; k++) {
 6504:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6505: 
 6506:             F += levelHorVisc;
 6507: 
 6508:             // Vegetation term
 6509:             if constexpr(iveg!=0) {
 6510:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6511:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6512:                   Fa += levelHorVisc*zrat;
 6513:                } 
 6514:             } // if iveg
 6515:          } // for k
 6516: 
 6517:          fb += side->nuGradU[side->kb];
 6518: 
 6519:          // Add to ghat1
 6520:          if constexpr(ics==2) {
 6521:             assert(false && "computeElemAverageGhat: Not implemented");
 6522:             // XXX IMPLEMENT THIS
 6523:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6524:             // bigf1=vn1; bigf2=vn2
 6525:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6526:             // botf1=vn1; botf2=vn2
 6527:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6528:             // bigfa1=vn1; bigfa2=vn2
 6529:          } // if ics
 6530: 
 6531:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6532:       } // for j (nodes and sides)
 6533: 
 6534:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6535:          
 6536:       // Finish off terms in F, F^\alpha and f_b
 6537:       const double grav3 = elem->mean(&Node::grav2);
 6538:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6539: 
 6540: 
 6541:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6542:       for (int j=1; j<i34; j++) { 
 6543:          // For each side in the element...
 6544:          const Side *side = elem->sides[j];
 6545:          const double chi = side->chi;
 6546: 
 6547:          const double htot = side->htot2();
 6548:          const double veg_h = side->veg_h();
 6549:          const Vector2 F  = htot*fb;
 6550:          const Vector2 Fa = min(htot, veg_h)*fb;
 6551: 
 6552:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6553:       } // for j
 6554: 
 6555:       //botf1 etc are already in elem frame
 6556:       elem->ghat1 += tmp/i34;
 6557: 
 6558:       // Baroclinic force
 6559:       if constexpr(ibc==0) {
 6560:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6561: 
 6562:          Vector2 Fa = {0.0, 0.0};
 6563:          Vector2 intGradRho = {0.0, 0.0};
 6564:          
 6565:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6566:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6567:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6568: 
 6569:             // \in F [m^2/s/s]
 6570:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6571:          }
 6572: 
 6573:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6574:          const Vector2 F = av_df*Fa; //approx
 6575:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6576: 
 6577:       } // if ibc
 6578: 
 6579: 
 6580: 
 6581:    }
 6582: 
 6583: } // extern "C"
 6584: 
 6585: 
 6586: 
 6587: #ifdef DONTCOMPILE
 6588: __global__ void checkMassConservation(Tracers* sumtr) {
 6589: 
 6590:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6591: 
 6592:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6593: 
 6594:    Element *elem = &(mesh->localElemData[i]);
 6595: 
 6596:    // Skip dry elements
 6597:    if (elem->isDry) return;
 6598: 
 6599:    // Local sum array for this thread
 6600:    double localSum[N_TRACERS] = {0.0};
 6601: 
 6602:    // Sum over vertical levels for this element
 6603:    const int kbe = elem->kbe;
 6604:    const double area = elem->area;
 6605: 
 6606:    for (int k = kbe; k < nvrt; k++) {
 6607:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6608:       
 6609:       // Accumulate tracer mass
 6610:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6611:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6612:       }
 6613:    }
 6614: 
 6615:    //  This function returns per element sums. A reduction must be done on the host side.
 6616: }
 6617: 
 6618: 
 6619: __global__ void transport(void) {
 6620: 
 6621:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6622: 
 6623:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6624: 
 6625:    Element *elem = &(mesh->localElemData[ie]);
 6626: 
 6627:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6628: 
 6629:                for (int m=0; m<ntr; m++) {
 6630:                   for (int k=kbe(ie); k<nvrt; k++) {
 6631:                      // Calculate each polynomial's weight 
 6632:                      wm=0.d0; sum1=0.d0; 
 6633:                      wm1=0.d0; wm2=0.d0; 
 6634:                      for (int i=0; i<elem->nweno2; i++) {
 6635:                   
 6636:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6637:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6638:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6639:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6640:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6641:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6642:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6643:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6644:                      // -----------------Hu and Shu (1999)'s method----------------
 6645:                      b4=b1+b2+b3
 6646: 
 6647: //Error: add PRODUCTION CPP
 6648: #ifdef DEBUG
 6649:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6650:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6651:                     call parallel_abort(errmsg)
 6652:                   }
 6653: #endif
 6654: 
 6655:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6656:                   // !----test-------------- 
 6657:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6658:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6659:                   // !wm(i)=wm1(i)*wm2(i)
 6660:                   // !---------------------- 
 6661:                   sum1=sum1+wm(i)
 6662:                 } // end for i
 6663: 
 6664:                 wm=wm/sum1
 6665: 
 6666:                 for (int j=0; j<elem->i34; j++) {
 6667: 
 6668:                   const Side *side  = elem->sides[j];
 6669:                   const Node *node1 = side->n1;
 6670:                   const Node *node2 = side->n2;
 6671: 
 6672:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6673:                      trsd=0.d0
 6674:                      for (int kk=0; kk<nquad; kk++) {
 6675:                         for (int i=0; i<elem->nweno2; i++) {
 6676:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6677:                         } // end for i   
 6678:                      } // end for kk
 6679:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6680:                   } // outward flux
 6681:                } // end for j=1,i34(ie) ! side
 6682:             }
 6683:          }
 6684:               
 6685: 
 6686: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6687: //             //   calculate each polynomial's weight 
 6688: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6689: //                 wm=0.d0; sum1=0.d0
 6690: //                 do i=1,nweno1(ie) !for each polynomial
 6691: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6692: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6693: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6694: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6695: //                   wm(i)=b2
 6696: //                   sum1=sum1+b2
 6697: //                   !wm(i)=1.d0
 6698: //                   !sum1=sum1+1.d0
 6699: 
 6700: // // Error: PRODUCTION
 6701: // #ifdef DEBUG
 6702: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6703: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6704: //                     call parallel_abort(errmsg)
 6705: //                   endif
 6706: // #endif
 6707: 
 6708: //                 enddo !i
 6709: //                 wm=wm/sum1 !final weight
 6710: 
 6711:                 for (int j=0; j<elem->i34; j++) { // side
 6712:                   const Side *side = elem->sides[j];
 6713:                   const Node *node1 = side->n1;
 6714:                   const Node *node2 = side->n2;
 6715: 
 6716:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6717:                     trsd=0.d0
 6718:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6719:                       for (int i=0; i<elem->nweno1; i++) {
 6720:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6721:                       }
 6722:                     enddo //kk
 6723:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6724:                   } // outward flux
 6725:                 } // end for j=1,i34(ie) ! side
 6726:               } // end for k; ntr 
 6727: 
 6728:             else !simple upwind method
 6729:               do j=1,i34(ie)
 6730:                 jsj=elside(j,ie)
 6731:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6732:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6733:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6734:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6735:                   endif
 6736:                 enddo  !vertical layers
 6737:               enddo !j=1,i34(ie) ! side
 6738:             endif !order of accuracy
 6739: 
 6740:          //  enddo !ie
 6741: // !$OMP     end do
 6742: 
