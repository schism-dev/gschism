 7615: __global__ void printMatrix(bool full) {
 7616:    // Debugging: print the matrix
 7617: 
 7618:    const int size = mesh->np;
 7619:    double sum = 0.0;
 7620:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7621:       const Node *node = mesh->localNodeData + idx_node;
 7622:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7623:       for (int j = 0; j < node->numNodes; j++) {
 7624:          Node* nbNode = node->nodes[j];
 7625:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7626:          sum += node->coeffMatrix[j];
 7627:       }
 7628:       if (full) printf("]\n");
 7629: 
 7630: 
 7631:    }
 7632:    if (!full) printf("sum=%lf\n", sum);
 7633: }
