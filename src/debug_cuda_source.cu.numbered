 6156: 
 6157:    __global__ void computeVerticalVelocity(void) {
 6158:       // Computes the vertical velocity at the (2D) element's centroid.
 6159:       // In this function we will be considering volumetric elements, with side faces and a 
 6160:       // bottom and a top face. We will call them SFs, BF and TF.
 6161:       // It computes the flux coming from BF and the SFs.
 6162:       // If the bed is moving, it takes that into account.
 6163:       // Since water is incompressible, the integral of the velocity times the normal vector
 6164:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6165:       // and the BF is equal to the flux going out from the TF.
 6166:       // TF = - BF - sum(SFs).
 6167:       // It then computes the horizontal velocity at the center of TF.
 6168:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6169:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6170:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6171: 
 6172:       ELEM(elem);
 6173: 
 6174:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6175: 
 6176:       if (elem->isDry) return;
 6177: 
 6178:       const int kb = elem->kb;
 6179:       const bool isTri = elem->isTri();
 6180: 
 6181:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6182: 
 6183:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6184:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6185:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6186: 
 6187:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6188: 
 6189:       double area3D;
 6190: 
 6191:       // Bottom face flux
 6192:       double bottomFlux = 0.0;
 6193:       Vector2 u2meanBottom = {0.0, 0.0};
 6194:       const Vector2 gradh = elem->grad2(&Node::depth);
 6195:       if constexpr(imm==2) {
 6196:          Vector3 ubed;
 6197: 
 6198:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6199:          // updateBDEF(ubed);
 6200:      
 6201:          // const double bflux0 = dot(ubed, elem_n1);
 6202: 
 6203:          // elem->w[kb] += ubed.z;
 6204:       }
 6205:       else {
 6206:          Vector2 umean;
 6207:          if constexpr(ics == 1) {
 6208:             u2meanBottom = elem->mean(kb, &Side::u2);
 6209:          }
 6210:          else {
 6211:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6212:          }
 6213: 
 6214:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6215:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6216: 
 6217:          bottomFlux = - dot(gradh, u2meanBottom);
 6218:       } // if imm
 6219: 
 6220:       // Compute w for kb+1 to nvrt-1
 6221:       for (int l = kb; l < nvrt - 1; l++) {
 6222: 
 6223:          // normal vector to the top face of the "volumetric" element (3D)
 6224:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6225: 
 6226:          // Compute the total flux at the sides
 6227:          double sideFlux = 0.0;
 6228: 
 6229:          for (int j = 0; j < elem->i34; j++) {
 6230:             const Side *side = elem->sides[j];
 6231: 
 6232:             const double sideArea = side->area(l);
 6233:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6234:             const double sign = elem->ssign[j]; 
 6235: 
 6236:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6237:          }
 6238:          
 6239:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6240:          //velocities at the centers of the sides
 6241:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6242: 
 6243:          // The flx at the top ace can be computed from the other flows.
 6244:          const double topFlux = - sideFlux - bottomFlux;
 6245:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6246: 
 6247:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6248: 
 6249:          elem_n1 = elem_n2;
 6250: 
 6251:          bottomFlux = - topFlux;
 6252:       }
 6253:    }  
 6254: 
 6255: 
 6256: 
 6257: 
 6258: 
 6259: 
 6260: 
 6261: // !===============================================================================
 6262: // !===============================================================================
 6263: 
 6264: } // extern "C"
