 7143: extern "C"
 7144:                                  
 7145:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7146:                    double *node_coords, double *wind_rotate_angle, 
 7147:                    int *isdel, int *isidenode, int *isbnd,
 7148:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7149:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7150:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7151:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7152:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7153:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7154:                    double *emo, double *efa, 
 7155:                    double *umo, double *ufa, 
 7156:                    double *vmo, double *vfa) {
 7157: 
 7158:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 7159:                        isdel, isidenode, isbnd,
 7160:                        nond, nlnd, iond, ilnd, 
 7161:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7162:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7163:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7164:                        localNodeIndices, localElemIndices, localSideIndices,
 7165:                        localNodePart, localElemPart, localSidePart,
 7166:                        emo, efa, umo, ufa, vmo, vfa);
 7167:   }
