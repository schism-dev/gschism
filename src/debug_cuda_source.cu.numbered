 6337: #ifdef DONTCOMPILE
 6338: __device__ void computeVerticalAdvection(void) {
 6339:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6340: 
 6341:    sdbt(1:2,:,:)=0.d0
 6342: 
 6343:    const Side *side = FROM kernel;
 6344: 
 6345:    if(side->isDry) return;
 6346: 
 6347:    // If side is wet...
 6348: 
 6349: 
 6350:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6351:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6352:    double ws[nvrt] = {} // w @ side
 6353:    int icount = 0;
 6354:    for (int j=0; j<2; j++) {
 6355:       const Element *elem = side->elements[j];
 6356:        
 6357:       if(elem != nullptr) {
 6358:          icount++;
 6359:          for (int k=0; k<nvrt; k++) {
 6360:             ws[k] = ws[k] + elem->w[k];
 6361:          }
 6362:       }
 6363:    }  // for j
 6364: 
 6365:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6366:    ws = ws/icount;
 6367: 
 6368:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6369:    // Splines allow for a smooth transition between vertical levels.
 6370:    // Splines have continuity restrictions at the internal knots, but
 6371:    // we have to provide the 1st derivatives at the endpoints.
 6372:    const int kbs = side->kbs; 
 6373:    
 6374:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6375:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6376:    initCubicSpline(kbs, nvrt, side, ws, up)
 6377: 
 6378:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6379:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6380:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6381: 
 6382:    // Total advection (average onto side)
 6383:    const Node *node1 = side->nodes[0];
 6384:    const Node *node2 = side->nodes[1];
 6385:    for (int k=kbs(i); k<nvrt; k++) {
 6386: 
 6387:       if constexpr(ics==1) {
 6388:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6389:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6390:       } else {
 6391:          // XXX IMPLEMENT THIS
 6392:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6393:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6394:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6395:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6396:       }  // if ics
 6397: 
 6398: 
 6399:    }
 6400: }
 6401: #endif
 6402: 
 6403: 
 6404: extern "C" {
 6405:    __global__ void computeElemAverageGhat(void) {
 6406:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6407: 
 6408:       ELEM(elem);
 6409:       
 6410:       elem->ghat1= {0.0, 0.0};  
 6411: 
 6412:       if constexpr(ihydraulics != 0) {
 6413:          if (nhtblocks > 0 && elem->isblock) return;
 6414:       }
 6415: 
 6416:       if (elem->isDry) return;
 6417: 
 6418:       // Wet elements.
 6419:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6420:       // tidal potential, horizontal diffusion, and baroclinic etc
 6421:       // Remember to update both fb and F 
 6422:       // If ics=2, ghat1 are in eframe (ll)
 6423:       // cff1-3: coefficients for 2D/3D
 6424:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6425:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6426:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6427: 
 6428:       double av_cff1 = 0.0;  // av. for cff1
 6429:       double av_cff2 = 0.0;  // av. for cff2
 6430:       double av_cff3 = 0.0;  // av. for cff3
 6431:       double av_df = 0.0;  // av. for H^\alpha / H
 6432:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6433:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6434: 
 6435:       const int i34 = elem->i34;
 6436:       const int kb = elem->kb;
 6437: 
 6438:       for (int j=1; j<i34; j++) {
 6439:          // For each node and side in the element...
 6440: 
 6441:          const Node *node = elem->nodes[j];
 6442:          const Side *side = elem->sides[j];
 6443: 
 6444:          const double chi      = side->chi;
 6445:          const double veg_c2   = side->veg_c2;
 6446:          const double veg_beta = side->veg_beta;
 6447:          const double veg_h    = side->veg_h();
 6448:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6449: 
 6450:          // Node - const in elem
 6451:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6452:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6453: 
 6454:          if (elem->depth >= tip_dp) {
 6455:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6456:          }
 6457: 
 6458:          
 6459:          const double htot  = side->htot2();        // Total depth at the side
 6460:          const double zctr2 = side->zTopCanopy();  
 6461: 
 6462:          double cff1; 
 6463:          double cff2; 
 6464:          double cff3;   
 6465:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6466:          // coefficients applied to 2D/3D case 
 6467:             cff1 = side->hhat/htot;
 6468:             cff2 = 0.0;
 6469:             cff3 = 0.0;
 6470:          } else { //3D
 6471:             //Init for no-veg case
 6472:             cff1 = 1.0;
 6473:             cff2 = 1.0;
 6474:             cff3 = 0.0;
 6475: 
 6476:             if constexpr(iveg != 0) {
 6477:                // Computes coefficients used with vegetation terms G1, G2
 6478:                // cff1, cff3 are used for the first two terms in G1, G2:
 6479:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6480:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6481:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6482:                if(veg_h < 0.99*htot) { // submergent vegetation
 6483:                   cff1=1;
 6484:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6485:                   cff3 = veg_c;
 6486: 
 6487:                } else { // emergent vegetation
 6488:                   cff1 = 1.0/(1.0 + veg_c2);
 6489:                   cff2 = cff1;
 6490:                   cff3 = 0.0;
 6491: 
 6492:                }
 6493:             } // if iveg
 6494:          } //  2D/3D
 6495: 
 6496:          av_cff1 += cff1/i34;
 6497:          av_cff2 += cff2/i34;
 6498:          av_cff3 += cff3/i34;
 6499:          av_cff2_chi += cff2*chi/i34;
 6500:          av_cff3_chi += cff3*chi/i34;
 6501:          av_df += min(htot, veg_h)/(htot*i34);
 6502: 
 6503: 
 6504:          // btrack values: U^\star, U^{\star\alpha}
 6505:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6506:          Vector2 Ustar       = {0.0, 0.0}; 
 6507:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6508: 
 6509:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6510:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6511:          } else { //3D
 6512:             for (int k = side->kb; k < nvrt; k++) {
 6513:             
 6514:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6515:                Ustar += w2;
 6516: 
 6517:                if constexpr(iveg != 0) {
 6518:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6519:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6520:                        Ustar_alpha += zrat*w2; // XXXX
 6521:                    }
 6522:                }  // if iveg
 6523:             }  // for k
 6524:          }  //2D/3D
 6525:          
 6526: 
 6527:          // Add btrack & surface stress terms to \breve{G} first
 6528:          if constexpr(ics==1) {
 6529:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6530:          } else {
 6531:             // XXX IMPLEMENT THIS
 6532:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6533:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6534:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6535:          }  // if ics
 6536: 
 6537:          // Surface and bottom stress terms
 6538:          if constexpr(ics==1) {
 6539:             const Vector2 tau    = side->tau();
 6540:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6541: 
 6542:             // Term for surface and bottom stress
 6543:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6544:          } else {
 6545:             // XXX IMPLEMENT THIS
 6546:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6547:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6548:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6549:             // tau_x=(vn1+tt1)/2.d0
 6550:             // tau_y=(vn2+ss1)/2.d0
 6551:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6552:          }  // if ics
 6553: 
 6554:          
 6555: 
 6556:          // All terms in F,F^\alpha,f_b except baroclinic
 6557:          // F, f_b: all explicit terms excluding vegetation 
 6558:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6559:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6560:          const double coriolis = side->coriolis;
 6561:          Vector2 F  =  coriolis*side->U;  // F_x
 6562:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6563:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6564: 
 6565:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6566:             
 6567:             for (int k = side->kb; k < nvrt; k++) {
 6568:                if (zctr2 > side->zc[k-1]) {
 6569:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6570:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6571:                    Fa +=  coriolis*w2*zrat;
 6572:                } // if zctr2
 6573:             } // k
 6574:          } // iveg
 6575: 
 6576:          // Integrate horizontal viscosity force vertically
 6577:          for (int k=side->kb + 1; k<nvrt; k++) {
 6578:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 6579: 
 6580:             F += levelHorVisc;
 6581: 
 6582:             // Vegetation term
 6583:             if constexpr(iveg!=0) {
 6584:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6585:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6586:                   Fa += levelHorVisc*zrat;
 6587:                } 
 6588:             } // if iveg
 6589:          } // for k
 6590: 
 6591:          fb += side->d2uv[side->kb];
 6592: 
 6593: 
 6594:          // Add to ghat1
 6595:          if constexpr(ics==2) {
 6596:             // XXX IMPLEMENT THIS
 6597:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6598:             // bigf1=vn1; bigf2=vn2
 6599:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6600:             // botf1=vn1; botf2=vn2
 6601:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6602:             // bigfa1=vn1; bigfa2=vn2
 6603:          } // if ics
 6604: 
 6605:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6606:       } // for j (nodes and sides)
 6607: 
 6608:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6609:          
 6610:       // Finish off terms in F, F^\alpha and f_b
 6611:       const double grav3 = elem->mean(&Node::grav2);
 6612:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6613: 
 6614: 
 6615:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6616:       for (int j=1; j<i34; j++) { 
 6617:          // For each side in the element...
 6618:          const Side *side = elem->sides[j];
 6619:          const double chi = side->chi;
 6620: 
 6621:          const double htot = side->htot2();
 6622:          const double veg_h = side->veg_h();
 6623:          const Vector2 F  = htot*fb;
 6624:          const Vector2 Fa = min(htot, veg_h)*fb;
 6625: 
 6626:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6627:       } // for j
 6628: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6629:       //botf1 etc are already in elem frame
 6630:       elem->ghat1 += tmp/i34;
 6631: 
 6632:       // Baroclinic force
 6633:       if constexpr(ibc==0) {
 6634:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6635: 
 6636:          Vector2 Fa = {0.0, 0.0};
 6637:          Vector2 intGradRho = {0.0, 0.0};
 6638:          
 6639:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6640:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6641:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6642: 
 6643:             // \in F [m^2/s/s]
 6644:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6645:          }
 6646: 
 6647:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6648:          const Vector2 F = av_df*Fa; //approx
 6649:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6650: 
 6651:       } // if ibc
 6652: 
 6653: 
 6654: 
 6655:    }
 6656: 
 6657: } // extern "C"
 6658: 
 6659: 
 6660: 
 6661: #ifdef DONTCOMPILE
 6662: __global__ void checkMassConservation(Tracers* sumtr) {
 6663: 
 6664:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6665: 
 6666:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6667: 
 6668:    Element *elem = &(mesh->localElemData[i]);
 6669: 
 6670:    // Skip dry elements
 6671:    if (elem->isDry) return;
 6672: 
 6673:    // Local sum array for this thread
 6674:    double localSum[N_TRACERS] = {0.0};
 6675: 
 6676:    // Sum over vertical levels for this element
 6677:    const int kbe = elem->kbe;
 6678:    const double area = elem->area;
 6679: 
 6680:    for (int k = kbe; k < nvrt; k++) {
 6681:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6682:       
 6683:       // Accumulate tracer mass
 6684:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6685:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6686:       }
 6687:    }
 6688: 
 6689:    
 6690: 
 6691:    //  This function returns per element sums. A reduction must be done on the host side.
 6692: }
 6693: 
 6694: 
 6695: __global__ void transport(void) {
 6696: 
 6697:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6698: 
 6699:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6700: 
 6701:    Element *elem = &(mesh->localElemData[ie]);
 6702: 
 6703:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6704: 
 6705:                for (int m=0; m<ntr; m++) {
 6706:                   for (int k=kbe(ie); k<nvrt; k++) {
 6707:                      // Calculate each polynomial's weight 
 6708:                      wm=0.d0; sum1=0.d0; 
 6709:                      wm1=0.d0; wm2=0.d0; 
 6710:                      for (int i=0; i<elem->nweno2; i++) {
 6711:                   
 6712:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6713:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6714:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6715:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6716:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6717:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6718:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6719:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6720:                      // -----------------Hu and Shu (1999)'s method----------------
 6721:                      b4=b1+b2+b3
 6722: 
 6723: //Error: add PRODUCTION CPP
 6724: #ifdef DEBUG
 6725:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6726:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6727:                     call parallel_abort(errmsg)
 6728:                   }
 6729: #endif
 6730: 
 6731:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6732:                   // !----test-------------- 
 6733:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6734:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6735:                   // !wm(i)=wm1(i)*wm2(i)
 6736:                   // !---------------------- 
 6737:                   sum1=sum1+wm(i)
 6738:                 } // end for i
 6739: 
 6740:                 wm=wm/sum1
 6741: 
 6742:                 for (int j=0; j<elem->i34; j++) {
 6743: 
 6744:                   const Side *side  = elem->sides[j];
 6745:                   const Node *node1 = side->n1;
 6746:                   const Node *node2 = side->n2;
 6747: 
 6748:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6749:                      trsd=0.d0
 6750:                      for (int kk=0; kk<nquad; kk++) {
 6751:                         for (int i=0; i<elem->nweno2; i++) {
 6752:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6753:                         } // end for i   
 6754:                      } // end for kk
 6755:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6756:                   } // outward flux
 6757:                } // end for j=1,i34(ie) ! side
 6758:             }
 6759:          }
 6760:               
 6761: 
 6762: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6763: //             //   calculate each polynomial's weight 
 6764: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6765: //                 wm=0.d0; sum1=0.d0
 6766: //                 do i=1,nweno1(ie) !for each polynomial
 6767: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6768: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6769: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6770: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6771: //                   wm(i)=b2
 6772: //                   sum1=sum1+b2
 6773: //                   !wm(i)=1.d0
 6774: //                   !sum1=sum1+1.d0
 6775: 
 6776: // // Error: PRODUCTION
 6777: // #ifdef DEBUG
 6778: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6779: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6780: //                     call parallel_abort(errmsg)
 6781: //                   endif
 6782: // #endif
 6783: 
 6784: //                 enddo !i
 6785: //                 wm=wm/sum1 !final weight
 6786: 
 6787:                 for (int j=0; j<elem->i34; j++) { // side
 6788:                   const Side *side = elem->sides[j];
 6789:                   const Node *node1 = side->n1;
 6790:                   const Node *node2 = side->n2;
 6791: 
 6792:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6793:                     trsd=0.d0
 6794:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6795:                       for (int i=0; i<elem->nweno1; i++) {
 6796:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6797:                       }
 6798:                     enddo //kk
 6799:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6800:                   } // outward flux
 6801:                 } // end for j=1,i34(ie) ! side
 6802:               } // end for k; ntr 
 6803: 
 6804:             else !simple upwind method
 6805:               do j=1,i34(ie)
 6806:                 jsj=elside(j,ie)
 6807:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6808:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6809:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6810:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6811:                   endif
 6812:                 enddo  !vertical layers
 6813:               enddo !j=1,i34(ie) ! side
 6814:             endif !order of accuracy
 6815: 
 6816:          //  enddo !ie
 6817: // !$OMP     end do
 6818: 
 6819: // !$OMP     master
 6820: //           !message passing
 6821: //           if (nproc>1) then
 6822: //             !make a copy of side concentrations
 6823: //             trsd_tmp0=trsd_tmp 
 6824: 
 6825: //             !this exchange routine swaps interface concentration between two partitions
 6826: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6827: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6828: 
 6829: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6830: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6831: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6832: 
 6833: 
 6834: //             !This obtains final values for interface sides
 6835: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6836: //       :    endif !nproc>1
