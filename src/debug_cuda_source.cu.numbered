 3123: __device__ double Element::intPhiPhiQuad(int i1, int i2) const {
 3124:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3125:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3126:    // The formula for the integral is:
 3127:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3128: 
 3129:    printf("intPhiPhi: TEST\n");
 3130: 
 3131:    const Node *n0 = nodes[0];
 3132:    const Node *n1 = nodes[1];
 3133:    const Node *n2 = nodes[2];
 3134:    const Node *n3 = nodes[3];
 3135: 
 3136:    const Vector2 p0 = n0->p;
 3137:    const Vector2 p1 = n1->p;
 3138:    const Vector2 p2 = n2->p;
 3139:    const Vector2 p3 = n3->p;
 3140: assert(false && "intPhiPhiQuad:CHECK?");
 3141: 
 3142:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 3143:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 3144:    double eta_sum  = iet_n[i1] + iet_n[i2];
 3145:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 3146: 
 3147:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 3148: }
 3149:    
 3150: 
 3151: __device__ double Element::intGradPhiGradPhiQuad(int i1, int i2) const {
 3152:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3153:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3154:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3155:    // The formula is also based on the identity:
 3156:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3157:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3158: 
 3159:    printf("intGradPhiGradPhi: TEST\n");   
 3160: assert(false && "intGradPhiGradPhi:Do ICS==2");
 3161:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 3162: 
 3163:    const double x0 = nodes[0]->p.x;
 3164:    const double y0 = nodes[0]->p.y;
 3165:    const double x1 = nodes[1]->p.x;
 3166:    const double y1 = nodes[1]->p.y;
 3167:    const double x2 = nodes[2]->p.x;
 3168:    const double y2 = nodes[2]->p.y;
 3169:    const double x3 = nodes[3]->p.x;
 3170:    const double y3 = nodes[3]->p.y;
 3171: 
 3172:    double res = 0.0;
 3173:    
 3174:    // Quadrature points in xi and eta coordinates
 3175:    #pragma unroll
 3176:    for (int i = 0; i < 4; i++) {
 3177:       // For each quadrature point...
 3178: 
 3179:       const Point2 p = GaussPoint(i);
 3180:       const double eta = p.x;
 3181:       const double xi  = p.y;
 3182: 
 3183:       // Jacobian entries at the Gauss point p
 3184:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 3185:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 3186:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 3187:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 3188: 
 3189:       const double detJ = jacobianDet(p);
 3190:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3191: 
 3192:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3193:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3194:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3195:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3196:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3197: 
 3198:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3199:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3200:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3201:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3202:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3203: 
 3204:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3205:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3206:    }
 3207: 
 3208:    return res;
 3209: }
 3210: 
 3211: 
 3212: /**  Interpolate velocities at a given point (xt,yt,zt)
 3213: 
 3214:    @param xt, yt, zt: coordinates of the point to interpolate
 3215:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3216: 
 3217:    This is done in four steps:
 3218: 
 3219:    1. Find the shape coordinates for the final position in the element.
 3220:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3221:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3222:       z levels at xt, yt at each step.   
 3223:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3224:       horizontally and vertically.
 3225: **/
 3226: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3227:    // Interpolate the velocities at the point xt. 
 3228:    // This function works the same for triangular and quadrilateral elements.
 3229:    double shpCoord[4];
 3230:    Vector3 u_int;
 3231: 
 3232:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa (6)");
 3233: 
 3234:    // First step is to compute the shape coordinates of (xt,yt)
 3235: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3236:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3237: 
 3238: 
 3239:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3240: 
 3241:    // Second step is to find the level that contains zt
 3242:    // Uses a binary search to find the level
 3243:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3244:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3245:    int R = nvrt - 1;
 3246: 
 3247:    // Get the z coordinates at the nodes of the element at the levels L and R
 3248:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3249:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3250:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3251: 
 3252: 
 3253:    double zL = interpolate(shpCoord, zLAtNodes);
 3254:    double zR = interpolate(shpCoord, zRAtNodes);
 3255: 
 3256:    // Interpolates vertically the velocities
 3257:    double wght1, wght2;
 3258:    if (xt.z<=zL) {
 3259:       wght1 = 1.0;
 3260:       wght2 = 0.0;
 3261:       xt.z = zL;
 3262:    }
 3263:    else if (xt.z>=zR) {
 3264:       wght1 = 0.0;
 3265:       wght2 = 1.0;
 3266:       xt.z = zR;
 3267:    }
 3268:    else {
 3269:       // Perform a binary search to find the levels between L and R that contain xt.z
 3270:       while (R - L > 1) {
 3271:          int M = (L + R) / 2.0;
 3272: 
 3273:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3274:          double zM = interpolate(shpCoord, zMAtNodes);
 3275:          if (zM < xt.z) 
 3276:          {
 3277:             L = M;
 3278:             zL = zM;
 3279:          }
 3280:          else 
 3281:          {
 3282:             R = M;
 3283:             zR = zM;
 3284:          }
 3285:       }
 3286:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3287:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3288: 
 3289:       wght2 = (xt.z - zL)/(zR - zL);
 3290:       wght1 = 1.0 - wght2;
 3291: 
 3292:    }
 3293: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3294: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3295:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3296:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3297:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3298:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3299: 
 3300:    // Project the velocity from the local frame to the origSide frame
 3301:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3302:    u_int = {uv.x, uv.y, w};
 3303: 
 3304:    // Neither of the interpolated velocities should be NaN
 3305:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3306: 
 3307:    return u_int;
 3308: 
 3309: }
