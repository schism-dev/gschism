  646: struct Element {
  647: 
  648:    // Geometry information
  649:    int idx;                   // Index of the element
  650:    int i34;                   // Number of sides for the element 
  651:    Side *sides[4];            // Sides of the element
  652:    Node *nodes[4];            // Nodes of the element
  653:    Element *nghbElems[4];     // Neighbors of the element
  654: 
  655:    int kb;                    // Bottom index of the element
  656:    double area;               // Area of the element
  657:    double ssign[4];           // Sign associated with each side of an element
  658:    double radius;             // Element equivalent radii
  659: 
  660:    #ifdef USE_FRAMES
  661:    Frame frame;
  662:    #endif
  663: 
  664:    Vector2 gradPhi[4];        // Derivatives of shape functions
  665:    Vector2 gradEta;           // Gradient of free surface elevation
  666:    Vector2 gradPr;            // Gradient of pressure    
  667:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  668: 
  669:    bool isDry;                // True if the element is dry
  670: 
  671:    Point2 center;            // Element center coordinates (global coordinates)
  672: 
  673: 
  674:    double depth;              // Depth at element (min of all nodes)
  675:    double z[nvrt];            // z-coord  (local frame - vertical up)
  676: 
  677:    // Physical information
  678:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  679: 
  680:    static const bool isblock = false;              // Always false
  681: 
  682:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  683:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  684: 
  685:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  686:    
  687: 
  688:    double vsource;            // Volumetric source/sink term [m^3/s]
  689: 
  690:    double rho[nvrt];          // Density at each prism center
  691:    double rho_mean[nvrt];     // Mean density at each prism center
  692:    CubicSpline rho_spl;
  693:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  694:    double rho_z[nvrt];        // First derivative of density at each prism center
  695:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  696:    
  697: 
  698:    __inline__ __device__ Point2 outputCoords(void) const;
  699: 
  700:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  701: 
  702:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  703:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  704: 
  705:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  706:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  707: 
  708:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  709:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  710:       // Find the local index of the node in the element (0,1,2,3)
  711:       int res = __ffs((nodes[0] == node) | 
  712:                      ((nodes[1] == node) << 1) | 
  713:                      ((nodes[2] == node) << 2) | 
  714:                      ((nodes[3] == node) << 3)) - 1;
  715:       
  716:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  717:       return res;  
  718:    }
  719: 
  720:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  721:       // Find the local index of the side in the element (0,1,2,3)
  722:       int res = __ffs((sides[0] == side) | 
  723:                      ((sides[1] == side) << 1) | 
  724:                      ((sides[2] == side) << 2) | 
  725:                      ((sides[3] == side) << 3)) - 1;
  726:       
  727:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  728:       return res;
  729:    }
  730: 
  731:    __inline__ __device__ int findLevel(double z1, int k) const {
  732:       // Starting at index k, find sequentially the level that contains z
  733: 
  734:       // For testing purposes, forgets k and performs a full search.
  735:       for (k = kb; k < nvrt - 1; k++) {
  736:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  737:       }
  738:       return nvrt - 2;
  739: 
  740: 
  741:       // if z is already betweeen z[k] and z[k+1], return k
  742:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  743:       else if (z1 <  z[k]) { 
  744:          // Search for increasing levels
  745:          for (int kk = k; kk < nvrt - 1; kk++) {
  746:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  747:          }
  748:          return nvrt - 1;
  749:       }
  750:       else {
  751:          // Search for decreasing levels
  752:          for (int kk = k; kk >= kb; kk--) {
  753:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  754:          }
  755:          return 0;
  756:       }
  757:    }
  758: 
  759:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  760:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  761: 
  762: 
  763:    __device__ __forceinline__ double centerZ(void) const;
  764: 
  765:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  766:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  767:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  768:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  769:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  770: 
  771: 
  772:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  773:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  774:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  775:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  776:        const double eta = (idxNode & 1) ? +g : -g;
  777:        const double xi  = (idxNode & 2) ? +g : -g;
  778:        return {eta, xi};
  779:    }  
  780: 
  781:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  782:    __device__ __forceinline__ double etaSign(int idxNode) const {
  783:       // bit1: 0 -> -1, 1 -> +1
  784:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  785:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  786:    }
  787: 
  788:    __device__ __forceinline__ double xiSign(int idxNode) const {
  789:       // +1 if (bit0 XOR bit1), else -1
  790:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  791:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  792: 
  793:    }
  794: 
  795:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  796:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  797:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  798:    }
  799: 
  800:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  801:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  802:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  803:    }   
  804: 
  805:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  806:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  807:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  808:    }      
  809:    
  810:    __inline__ __device__ double detJ_eta(void) const;
  811: 
  812:    __inline__ __device__ double detJ_xi(void) const;
  813: 
  814:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
