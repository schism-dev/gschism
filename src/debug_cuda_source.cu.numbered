  335: 
  336: 
  337: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  338:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  339:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  340: }
  341: 
  342: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  343:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  344:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  345: }
  346: 
  347: 
  348: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  349:    x3 = y1*z2 - y2*z1;
  350:    y3 = x2*z1 - x1*z2;
  351:    z3 = x1*y2 - x2*y1;
  352: }
  353: 
  354: 
  355: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  356: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  357: 
  358:    const double radius2 = dot(p, p);
  359:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  360:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  361: 
  362:    rlon = atan2(p.y, p.x); // (-pi,pi]
  363: 
  364:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  365:       rlat = asin(p.z/sqrt(radius2));
  366:    } else {
  367:       rlat = asin(p.z/rearth_pole);
  368:    }
  369:   
  370: }
  371: 
  372: __inline__ __device__ void Error(const char* msg) {
  373:    printf("Error: %s\n", msg);
  374:    assert(false);
  375: }
