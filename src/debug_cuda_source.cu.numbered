 4038: extern "C" {
 4039:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4040:                                   int* indices, int* indptr) {
 4041: 
 4042:       NODE(node);
 4043:       
 4044:       const int idx = node->idx;
 4045:       
 4046:       // Computes the index in the nzz array      
 4047:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4048: 
 4049: 
 4050:       indptr[idx] = nzzIdx;
 4051:       indices[nzzIdx] = idx;
 4052: 
 4053:       data_d[nzzIdx]    = node->coeffDiag;
 4054: 
 4055:       b_d[idx] = node->qel;
 4056: 
 4057:       for (int k = 0; k < node->numNodes; ++k) {
 4058:          const Node* nb = node->nodes[k];
 4059: 
 4060:          const int j = nb->idx;
 4061: 
 4062:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4063: 
 4064:          indices[nzzIdx + k + 1] = j;
 4065:       }
 4066: 
 4067:  
 4068:    }
