  331: 
  332: 
  333: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  334:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  335:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  336: }
  337: 
  338: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  339:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  340:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  341: }
  342: 
  343: 
  344: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  345:    x3 = y1*z2 - y2*z1;
  346:    y3 = x2*z1 - x1*z2;
  347:    z3 = x1*y2 - x2*y1;
  348: }
  349: 
  350: 
  351: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  352: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  353: 
  354:    const double radius2 = dot(p, p);
  355:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  356:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  357: 
  358:    rlon = atan2(p.y, p.x); // (-pi,pi]
  359: 
  360:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  361:       rlat = asin(p.z/sqrt(radius2));
  362:    } else {
  363:       rlat = asin(p.z/rearth_pole);
  364:    }
  365:   
  366: }
  367: 
  368: __inline__ __device__ void Error(const char* msg) {
  369:    printf("Error: %s\n", msg);
  370:    assert(false);
  371: }
