 4392: // //                   is used below bottom or above surface.
 4393: // //       ibelow: flag indicating if zt is below za(k1)
 4394: // //
 4395: 
 4396: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 4397: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 4398:    
 4399: //    ibelow = 0;
 4400: 
 4401: //    if (zt < za[k1]) {
 4402: //       // Below bottom
 4403: //       ibelow = 1;
 4404: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k1*nc];
 4405: 
 4406: //    } else if(zt>=za[k2]) {
 4407: //       // Above surface
 4408: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k2*nc];
 4409: 
 4410: //    } else {
 4411: //       // Normal case (between bottom and surface)
 4412:       
 4413: //       // Finds the level index using binary search
 4414: //       int l1 = k1;
 4415: //       int l2 = k2;
 4416: //       int k = (l1 + l2)/2;
 4417: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 4418: //           int k = (l1 + l2)/2;
 4419: //           if (zt >= za[k]) l1 = k;
 4420: //           else             l2 = k;
 4421: //       }
 4422: //       // Now l1 and l2 are adjacent levels and zt is between them
 4423: 
 4424: //       assert(za[l2] - za[l1] > 0.0 && "vertLinearInterp: za[l2] - za[l1] <= 0");
 4425: 
 4426: //       const double zrat = (zt - za[l1])/(za[l2] - za[l1]);
