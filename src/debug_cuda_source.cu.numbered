 5737: #ifdef DONTCOMPILE
 5738: __device__ void computeVerticalAdvection(void) {
 5739:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 5740: 
 5741:    sdbt(1:2,:,:)=0.d0
 5742: 
 5743:    const Side *side = FROM kernel;
 5744: 
 5745:    if(side->isDry) return;
 5746: 
 5747:    // If side is wet...
 5748: 
 5749: 
 5750:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 5751:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 5752:    double ws[nvrt] = {} // w @ side
 5753:    int icount = 0;
 5754:    for (int j=0; j<2; j++) {
 5755:       const Element *elem = side->elements[j];
 5756:        
 5757:       if(elem != nullptr) {
 5758:          icount++;
 5759:          for (int k=0; k<nvrt; k++) {
 5760:             ws[k] = ws[k] + elem->w[k];
 5761:          }
 5762:       }
 5763:    }  // for j
 5764: 
 5765:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 5766:    ws = ws/icount;
 5767: 
 5768:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 5769:    // Splines allow for a smooth transition between vertical levels.
 5770:    // Splines have continuity restrictions at the internal knots, but
 5771:    // we have to provide the 1st derivatives at the endpoints.
 5772:    const int kbs = side->kbs; 
 5773:    
 5774:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5775:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5776:    initCubicSpline(kbs, nvrt, side, ws, up)
 5777: 
 5778:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5779:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5780:    initCubicSpline(kbs, nvrt, side, ws, vp)
 5781: 
 5782:    // Total advection (average onto side)
 5783:    const Node *node1 = side->nodes[0];
 5784:    const Node *node2 = side->nodes[1];
 5785:    for (int k=kbs(i); k<nvrt; k++) {
 5786: 
 5787:       if constexpr(ics==1) {
 5788:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 5789:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 5790:       } else {
 5791:          // XXX IMPLEMENT THIS
 5792:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 5793:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 5794:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 5795:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 5796:       }  // if ics
 5797: 
 5798: 
 5799:    }
 5800: }
 5801: #endif
 5802: 
 5803: 
 5804: extern "C" {
 5805:    __global__ void computeElemAverageGhat(void) {
 5806:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 5807: 
 5808:       ELEM(elem);
 5809:       
 5810:       elem->ghat1= {0.0, 0.0};  
 5811: 
 5812:       if constexpr(ihydraulics != 0) {
 5813:          if (nhtblocks > 0 && elem->isblock) return;
 5814:       }
 5815: 
 5816:       if (elem->isDry) return;
 5817: 
 5818:       // Wet elements.
 5819:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 5820:       // tidal potential, horizontal diffusion, and baroclinic etc
 5821:       // Remember to update both fb and F 
 5822:       // If ics=2, ghat1 are in eframe (ll)
 5823:       // cff1-3: coefficients for 2D/3D
 5824:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 5825:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 5826:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 5827: 
 5828:       double av_cff1 = 0.0;  // av. for cff1
 5829:       double av_cff2 = 0.0;  // av. for cff2
 5830:       double av_cff3 = 0.0;  // av. for cff3
 5831:       double av_df = 0.0;  // av. for H^\alpha / H
 5832:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 5833:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 5834: 
 5835:       const int i34 = elem->i34;
 5836:       const int kb = elem->kb;
 5837: 
 5838:       for (int j=1; j<i34; j++) {
 5839:          // For each node and side in the element...
 5840: 
 5841:          const Node *node = elem->nodes[j];
 5842:          const Side *side = elem->sides[j];
 5843: 
 5844:          const double chi      = side->chi;
 5845:          const double veg_c2   = side->veg_c2;
 5846:          const double veg_beta = side->veg_beta;
 5847:          const double veg_h    = side->veg_h();
 5848:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 5849: 
 5850:          // Node - const in elem
 5851:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 5852:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 5853: 
 5854:          if (elem->depth >= tip_dp) {
 5855:            elem->gradETP += node->ETP*elem->gradPhi[j];
 5856:          }
 5857: 
 5858:          
 5859:          const double htot  = side->htot2();        // Total depth at the side
 5860:          const double zctr2 = side->zTopCanopy();  
 5861: 
 5862:          double cff1; 
 5863:          double cff2; 
 5864:          double cff3;   
 5865:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 5866:          // coefficients applied to 2D/3D case 
 5867:             cff1 = side->hhat/htot;
 5868:             cff2 = 0.0;
 5869:             cff3 = 0.0;
 5870:          } else { //3D
 5871:             //Init for no-veg case
 5872:             cff1 = 1.0;
 5873:             cff2 = 1.0;
 5874:             cff3 = 0.0;
 5875: 
 5876:             if constexpr(iveg != 0) {
 5877:                // Computes coefficients used with vegetation terms G1, G2
 5878:                // cff1, cff3 are used for the first two terms in G1, G2:
 5879:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 5880:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 5881:                // In general, cff1*Ustar - cff3*Ustar_alpha
 5882:                if(veg_h < 0.99*htot) { // submergent vegetation
 5883:                   cff1=1;
 5884:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 5885:                   cff3 = veg_c;
 5886: 
 5887:                } else { // emergent vegetation
 5888:                   cff1 = 1.0/(1.0 + veg_c2);
 5889:                   cff2 = cff1;
 5890:                   cff3 = 0.0;
 5891: 
 5892:                }
 5893:             } // if iveg
 5894:          } //  2D/3D
 5895: 
 5896:          av_cff1 += cff1/i34;
 5897:          av_cff2 += cff2/i34;
 5898:          av_cff3 += cff3/i34;
 5899:          av_cff2_chi += cff2*chi/i34;
 5900:          av_cff3_chi += cff3*chi/i34;
 5901:          av_df += min(htot, veg_h)/(htot*i34);
 5902: 
 5903: 
 5904:          // btrack values: U^\star, U^{\star\alpha}
 5905:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 5906:          Vector2 Ustar       = {0.0, 0.0}; 
 5907:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 5908: 
 5909:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 5910:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 5911:          } else { //3D
 5912:             for (int k = side->kb; k < nvrt; k++) {
 5913:             
 5914:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 5915:                Ustar += w2;
 5916: 
 5917:                if constexpr(iveg != 0) {
 5918:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 5919:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 5920:                        Ustar_alpha += zrat*w2; // XXXX
 5921:                    }
 5922:                }  // if iveg
 5923:             }  // for k
 5924:          }  //2D/3D
 5925:          
 5926: 
 5927:          // Add btrack & surface stress terms to \breve{G} first
 5928:          if constexpr(ics==1) {
 5929:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 5930:          } else {
 5931:             // XXX IMPLEMENT THIS
 5932:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 5933:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 5934:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 5935:          }  // if ics
 5936: 
 5937:          // Surface and bottom stress terms
 5938:          if constexpr(ics==1) {
 5939:             const Vector2 tau    = side->tau();
 5940:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 5941: 
 5942:             // Term for surface and bottom stress
 5943:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 5944:          } else {
 5945:             // XXX IMPLEMENT THIS
 5946:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 5947:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 5948:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 5949:             // tau_x=(vn1+tt1)/2.d0
 5950:             // tau_y=(vn2+ss1)/2.d0
 5951:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 5952:          }  // if ics
 5953: 
 5954:          
 5955: 
 5956:          // All terms in F,F^\alpha,f_b except baroclinic
 5957:          // F, f_b: all explicit terms excluding vegetation 
 5958:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 5959:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 5960:          const double coriolis = side->coriolis;
 5961:          Vector2 F  =  coriolis*side->U;  // F_x
 5962:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 5963:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 5964: 
 5965:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 5966:             
 5967:             for (int k = side->kb; k < nvrt; k++) {
 5968:                if (zctr2 > side->zc[k-1]) {
 5969:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 5970:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 5971:                    Fa +=  coriolis*w2*zrat;
 5972:                } // if zctr2
 5973:             } // k
 5974:          } // iveg
 5975: 
 5976:          // Integrate horizontal viscosity force vertically
 5977:          for (int k=side->kb + 1; k<nvrt; k++) {
 5978:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 5979: 
 5980:             F += levelHorVisc;
 5981: 
 5982:             // Vegetation term
 5983:             if constexpr(iveg!=0) {
 5984:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 5985:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 5986:                   Fa += levelHorVisc*zrat;
 5987:                } 
 5988:             } // if iveg
 5989:          } // for k
 5990: 
 5991:          fb += side->d2uv[side->kb];
 5992: 
 5993: 
 5994:          // Add to ghat1
 5995:          if constexpr(ics==2) {
 5996:             // XXX IMPLEMENT THIS
 5997:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5998:             // bigf1=vn1; bigf2=vn2
 5999:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6000:             // botf1=vn1; botf2=vn2
 6001:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6002:             // bigfa1=vn1; bigfa2=vn2
 6003:          } // if ics
 6004: 
 6005:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6006:       } // for j (nodes and sides)
 6007: 
 6008:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6009:          
 6010:       // Finish off terms in F, F^\alpha and f_b
 6011:       const double grav3 = elem->mean(&Node::grav2);
 6012:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6013: 
 6014: 
 6015:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6016:       for (int j=1; j<i34; j++) { 
 6017:          // For each side in the element...
 6018:          const Side *side = elem->sides[j];
 6019:          const double chi = side->chi;
 6020: 
 6021:          const double htot = side->htot2();
 6022:          const double veg_h = side->veg_h();
 6023:          const Vector2 F  = htot*fb;
 6024:          const Vector2 Fa = min(htot, veg_h)*fb;
 6025: 
 6026:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6027:       } // for j
 6028: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6029:       //botf1 etc are already in elem frame
 6030:       elem->ghat1 += tmp/i34;
 6031: 
 6032:       // Baroclinic force
 6033:       if constexpr(ibc==0) {
 6034:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6035: 
 6036:          Vector2 Fa = {0.0, 0.0};
 6037:          Vector2 intGradRho = {0.0, 0.0};
 6038:          
 6039:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6040:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6041:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6042: 
 6043:             // \in F [m^2/s/s]
 6044:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6045:          }
 6046: 
 6047:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6048:          const Vector2 F = av_df*Fa; //approx
 6049:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6050: 
 6051:       } // if ibc
 6052: 
 6053: 
 6054: 
 6055:    }
 6056: 
 6057: } // extern "C"
 6058: 
 6059: 
 6060: 
 6061: #ifdef DONTCOMPILE
 6062: __global__ void checkMassConservation(Tracers* sumtr) {
 6063: 
 6064:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6065: 
 6066:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6067: 
 6068:    Element *elem = &(mesh->localElemData[i]);
 6069: 
 6070:    // Skip dry elements
 6071:    if (elem->isDry) return;
 6072: 
 6073:    // Local sum array for this thread
 6074:    double localSum[N_TRACERS] = {0.0};
 6075: 
 6076:    // Sum over vertical levels for this element
 6077:    const int kbe = elem->kbe;
 6078:    const double area = elem->area;
 6079: 
 6080:    for (int k = kbe; k < nvrt; k++) {
 6081:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6082:       
 6083:       // Accumulate tracer mass
 6084:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6085:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6086:       }
 6087:    }
 6088: 
 6089:    
 6090: 
 6091:    //  This function returns per element sums. A reduction must be done on the host side.
 6092: }
 6093: 
 6094: 
 6095: __global__ void transport(void) {
 6096: 
 6097:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6098: 
 6099:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6100: 
 6101:    Element *elem = &(mesh->localElemData[ie]);
 6102: 
 6103:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6104: 
 6105:                for (int m=0; m<ntr; m++) {
 6106:                   for (int k=kbe(ie); k<nvrt; k++) {
 6107:                      // Calculate each polynomial's weight 
 6108:                      wm=0.d0; sum1=0.d0; 
 6109:                      wm1=0.d0; wm2=0.d0; 
 6110:                      for (int i=0; i<elem->nweno2; i++) {
 6111:                   
 6112:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6113:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6114:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6115:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6116:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6117:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6118:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6119:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6120:                      // -----------------Hu and Shu (1999)'s method----------------
 6121:                      b4=b1+b2+b3
 6122: 
 6123: //Error: add PRODUCTION CPP
 6124: #ifdef DEBUG
 6125:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6126:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6127:                     call parallel_abort(errmsg)
 6128:                   }
 6129: #endif
 6130: 
 6131:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6132:                   // !----test-------------- 
 6133:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6134:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6135:                   // !wm(i)=wm1(i)*wm2(i)
 6136:                   // !---------------------- 
 6137:                   sum1=sum1+wm(i)
 6138:                 } // end for i
 6139: 
 6140:                 wm=wm/sum1
 6141: 
 6142:                 for (int j=0; j<elem->i34; j++) {
 6143: 
 6144:                   const Side *side  = elem->sides[j];
 6145:                   const Node *node1 = side->n1;
 6146:                   const Node *node2 = side->n2;
 6147: 
 6148:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6149:                      trsd=0.d0
 6150:                      for (int kk=0; kk<nquad; kk++) {
 6151:                         for (int i=0; i<elem->nweno2; i++) {
 6152:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6153:                         } // end for i   
 6154:                      } // end for kk
 6155:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6156:                   } // outward flux
 6157:                } // end for j=1,i34(ie) ! side
 6158:             }
 6159:          }
 6160:               
 6161: 
 6162: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6163: //             //   calculate each polynomial's weight 
 6164: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6165: //                 wm=0.d0; sum1=0.d0
 6166: //                 do i=1,nweno1(ie) !for each polynomial
 6167: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6168: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6169: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6170: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6171: //                   wm(i)=b2
 6172: //                   sum1=sum1+b2
 6173: //                   !wm(i)=1.d0
 6174: //                   !sum1=sum1+1.d0
 6175: 
 6176: // // Error: PRODUCTION
 6177: // #ifdef DEBUG
 6178: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6179: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6180: //                     call parallel_abort(errmsg)
 6181: //                   endif
 6182: // #endif
 6183: 
 6184: //                 enddo !i
 6185: //                 wm=wm/sum1 !final weight
 6186: 
 6187:                 for (int j=0; j<elem->i34; j++) { // side
 6188:                   const Side *side = elem->sides[j];
 6189:                   const Node *node1 = side->n1;
 6190:                   const Node *node2 = side->n2;
 6191: 
 6192:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6193:                     trsd=0.d0
 6194:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6195:                       for (int i=0; i<elem->nweno1; i++) {
 6196:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6197:                       }
 6198:                     enddo //kk
 6199:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6200:                   } // outward flux
 6201:                 } // end for j=1,i34(ie) ! side
 6202:               } // end for k; ntr 
 6203: 
 6204:             else !simple upwind method
 6205:               do j=1,i34(ie)
 6206:                 jsj=elside(j,ie)
 6207:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6208:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6209:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6210:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6211:                   endif
 6212:                 enddo  !vertical layers
 6213:               enddo !j=1,i34(ie) ! side
 6214:             endif !order of accuracy
 6215: 
 6216:          //  enddo !ie
 6217: // !$OMP     end do
 6218: 
 6219: // !$OMP     master
 6220: //           !message passing
 6221: //           if (nproc>1) then
 6222: //             !make a copy of side concentrations
 6223: //             trsd_tmp0=trsd_tmp 
 6224: 
 6225: //             !this exchange routine swaps interface concentration between two partitions
 6226: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6227: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6228: 
 6229: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6230: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6231: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6232: 
 6233: 
 6234: //             !This obtains final values for interface sides
 6235: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6236: //       :    endif !nproc>1
 6237: //           !message passing end
 6238: // !$OMP     end master
 6239: // !$OMP     barrier
 6240: 
 6241: 
 6242: // !         Do advection; conc @ dry elem will not be changed
 6243: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 6244: // !$OMP     do reduction(+: h_mass_in)
 6245: //           do i=1,ne
 6246: //             if(idry_e(i)==1) cycle
 6247: 
 6248: 
 6249: // !           Wet elements with 3 wet nodes
 6250: //             do k=kbe(i)+1,nvrt
 6251: 
 6252: 
 6253: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 6254: //               dtb_by_bigv = dtb/bigv
 6255:     
 6256: // !             Advective flux
 6257: //               if (ntd_weno==1 .or. itd_weno==1) then
 6258: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 6259: //               else
 6260: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 6261: //               endif
 6262: 
