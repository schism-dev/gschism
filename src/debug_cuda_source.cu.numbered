 1564: // Helper functions for computing the local node index at a given offset from another.
 1565: __device__ __inline__ int nxq(int offset, int index, int size) {
 1566:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1567:    // to the index to make it positive
 1568:    assert(index + offset + 16*size >= 0);
 1569:    return (index + offset + 16*size) % size;  
 1570: }
 1571: 
 1572: __device__ __inline__ int nxq(int index, int size) {
 1573:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1574:    // to the index to make it positive
 1575:    assert(index + 16*size >= 0);
 1576:    return (index + 16*size) % size; 
 1577: }
