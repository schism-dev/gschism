 2350: 
 2351: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2352: 
 2353:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2354:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2355:    const Node *n1 = side->n1;
 2356:    const Node *n2 = side->n2;
 2357: 
 2358:    bool n1_match = (n1->nodeBnd->segment == segment);
 2359:    bool n2_match = (n2->nodeBnd->segment == segment);
 2360: 
 2361:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2362:    if (n1_match && n2_match) {
 2363:       return 0.5;
 2364:    } else if (n1_match) {
 2365:       return 1.0;
 2366:    } else if (n2_match) {
 2367:       return 0.0;
 2368:    }
 2369:    return 0.0;
 2370: }
 2371: 
 2372: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2373: 
 2374: 
 2375: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2376: 
 2377:    const double w1 = getBoundaryArrayValueWeight();
 2378:    const double w2 = 1.0 - w1;
 2379:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2380:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2381: 
 2382:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2383: }
 2384: 
 2385: 
 2386: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2387:    const double w1 = getBoundaryArrayValueWeight();
 2388:    const double w2 = 1.0 - w1;
 2389:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2390:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2391: 
 2392:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2393: }
 2394: 
 2395: 
 2396: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2397:    // Returns the value of the velocity at the side center
 2398:    const double w1 = getBoundaryArrayValueWeight();
 2399:    const double w2 = 1.0 - w1;
 2400:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2401:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2402: 
 2403:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2404: }
 2405: 
 2406: 
 2407: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2408:    // Returns the value of the normal component of the velocity at the side center
 2409:    const double w1 = getBoundaryArrayValueWeight();
 2410:    const double w2 = 1.0 - w1;
 2411:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2412:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2413: 
 2414:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2415: }
