  791: 
  792: // ----------------------------- Frames -----------------------------
  793: 
  794: // Frames are used to transform vectors between different coordinate systems.
  795: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  796: template<int ICS>
  797: struct Frame {};
  798: 
  799: template<>
  800: struct Frame<1> {
  801:    __forceinline__ __device__ void update(double, double) {}
  802:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  803:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  804:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  805:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  806:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  807:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  808: };
  809: 
  810: template<>
  811: struct Frame<2> {
  812:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  813:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  814:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  815:     double t00, t10;        // col0 (t20=0 implicit)
  816:     double t01, t11, t21;   // col1
  817: 
  818:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  819: 
  820:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  821:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  822: 
  823:       double sin_lon, cos_lon, sin_lat, cos_lat;
  824:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  825:       sincos(lat, &sin_lat, &cos_lat);
  826: 
  827:       t00 = -sin_lon;
  828:       t10 =  cos_lon;
  829:       t01 = -cos_lon*sin_lat;
  830:       t11 = -sin_lon*sin_lat;
  831:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  832: 
  833:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  834:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  835: 
  836:       const double col1_norm_inv = 1.0/col1_norm;
  837:       t01 = t01*col1_norm_inv;
  838:       t11 = t11*col1_norm_inv;
  839:       t21 = t21*col1_norm_inv;
  840: 
  841:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  842: 
  843: 
  844:    }
  845: 
  846:    __forceinline__ __device__ void print(void) const {
  847:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  848:    }
  849: 
  850:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  851:       // cross(col0, col1), with t20=0 implicitly:
  852:       // |  i       j       k   |
  853:       // | t00     t10      0   |
  854:       // | t01     t11     t21  |
  855:       t02 =  t10*t21;
  856:       t12 = -t00*t21;
  857:       t22 =  t00*t11 - t10*t01;
  858:    }
  859: 
  860: 
  861:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  862:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  863:    // Inputs:
  864:    //        vec0: vel. in this frame;
  865:    //        frameout: Output frame;
  866:    // Output: 
  867:    //        vel. in new frame  
  868:    //
  869:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  870:    // discarding the z-component of the result to keep only the local horizontal
  871:    // plane of frame 2.
  872:    //
  873:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  874:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  875:    // are orthogonal. This product is computed as dot products between columns of
  876:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  877:    // columns of F2.// 
  878: 
  879:       auto const fo = frameout; // Just an alias for the output frame.
  880:       Vector2 res;
  881: 
  882:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  883:       // of t and fo.t are the same.
  884:       const double d00 = t00*fo.t00 + t10*fo.t10;
  885:       const double d10 = t01*fo.t00 + t11*fo.t10;
  886: 
  887:       const double d01 = t00*fo.t01 + t10*fo.t11;
  888:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  889: 
  890:       res.x = vec0.x * d00 + vec0.y * d10;
  891:       res.y = vec0.x * d01 + vec0.y * d11;
  892: 
  893:       return res;
  894:    }
  895: 
  896:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  897:       Vector3 vo;
  898:       double t02, t12, t22;
  899: 
  900:       // Compute the 3rd column of the frame tensor
  901:       getCol2(t02, t12, t22);
  902: 
  903:       vo.x = vi.x*t00 + vi.y*t10;
  904:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  905:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  906: 
  907:       return vo;
  908:    
  909:    }
  910: 
  911:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  912:       Vector3 vo;
  913:       double t02, t12, t22;
  914: 
  915:    // Compute the 3rd column of the frame tensor
  916:       getCol2(t02, t12, t22);
  917: 
  918:       // F * vi (non-transposed, so we use rows of F)
  919:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  920:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  921:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  922: 
  923:       return vo;
  924:    }
  925: 
  926:    // Unit vectors that define the local frame
  927:    __forceinline__ __device__ Vector3 nUp(void) const {
  928:       // Column 2 = cross(column0, column1)
  929:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  930:    }
  931: 
  932:    __forceinline__ __device__ Vector3 nZonal(void) const {
  933:       // Column 0
  934:       return { t00, t10, 0.0 };
  935:    }
  936: 
  937:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  938:       // Column 1
  939:       return { t01, t11, t21 };
  940:    }
  941: 
  942: };
