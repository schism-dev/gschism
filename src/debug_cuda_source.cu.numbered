 7156: __global__ void printMatrix(void) {
 7157:    // Debugging: print the matrix
 7158: 
 7159:    for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7160:       const int idx_node = ithread + blockIdx.x * blockDim.x;
 7161:       if (idx_node >= mesh->np) return;
 7162:       const Node *node = mesh->localNodeData + idx_node;
 7163:       printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7164:       for (int j = 0; j < node->numNodes; j++) {
 7165:          Node* nbNode = node->nodes[j];
 7166:          if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7167:       }
 7168:       printf("]\n");
 7169: 
 7170:    }
 7171: 
 7172: }
