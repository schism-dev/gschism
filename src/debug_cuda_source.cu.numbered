 4759:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 4760:       NODE(node);
 4761: 
 4762:       const int idx = node->idx;
 4763:       Vector2 wind = {xWind[idx], yWind[idx]};
 4764: 
 4765:       if constexpr(nws != 0 && iwindoff != 0) {
 4766:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 4767:       }
 4768: 
 4769:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 4770:       node->setWind(wind);
 4771: 
 4772:       node->pr = pressAir[idx];
 4773:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 4774: 
 4775:    }
 4776: 
 4777:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4778: 
 4779:       NODE_BND(nodeBnd);
 4780: 
 4781:       Node *node = nodeBnd->node;
 4782: 
 4783:       node->ETP = 0.0;
 4784: 
 4785:       for (int j=0; j<ntip; j++) {
 4786: 
 4787:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4788:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4789:    
 4790:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4791: 
 4792:          if constexpr(iloadtide==1) { // loading tide
 4793:             assert(false && "Loading tide not implemented");
 4794:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4795:          }
 4796:          
 4797:       }
 4798:       
 4799:    }
