 1784:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1785:       // Compute the different time ramps used in the code 
 1786:       // This function is performed by just one thread
 1787: 
 1788:       rampbc = 1.0;
 1789:       if constexpr(ibc == 0) {
 1790:          if (drampbc > 0.0) {
 1791:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1792:          } else {
 1793:             rampbc = 1.0;
 1794:          }
 1795:       }
 1796: 
 1797:       if (nws != 0) {
 1798:          if (drampwind > 0.0) {
 1799:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1800:          } else {
 1801:             rampwind = 1.0;
 1802:          }
 1803:       }
 1804: 
 1805:       if (drampwafo > 0.0) {
 1806:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1807:       } else {
 1808:          rampwafo = 1.0;
 1809:       }
 1810: 
 1811:       // For source/sinks
 1812:       if (if_source && dramp_ss > 0.0) {
 1813:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1814:       } else {
 1815:          ramp_ss = 1.0;
 1816:       }
 1817: 
 1818:       if (dramp > 0.0) {
 1819:          ramp = tanh(2.0*time/86400.0/dramp);
 1820:       } else {
 1821:          ramp = 1.0;
 1822:       }
 1823: 
 1824: 
 1825:    }
