 6535:    __global__ void computeBottomDragVegetation(void) {
 6536:       // UNFINISHED. CHECK THIS: XXXXX
 6537:       // How many kernels are needed? Why so many for loops?
 6538:       // Is the loop on sides needed?
 6539: 
 6540:       NODE(node);
 6541: 
 6542:       const int    kb      = node->kb;
 6543:       const double htot    = node->htot2(); 
 6544:       
 6545:       if (node->isDry) {
 6546:          // Default values for dry nodes
 6547:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6548:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6549: 
 6550:          return;
 6551:        
 6552:       }
 6553: 
 6554:       // Computes bottom drag Cd based on the selected nchi
 6555:       node->computeBottomDragCd();
 6556:       
 6557: 
 6558: 
 6559:       //   Bottom stress in m^2/s^2
 6560:       if (node->rho[kb + 1] >= -98.0)
 6561:       {
 6562:          const double mag_u = length(node->u2[kb + 1]);
 6563:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6564: 
 6565:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6566:          // !sediment erosion: this part needs more documentation
 6567:       }
 6568:     
 6569: 
 6570: 
 6571:       // Compute vegetation parameters
 6572:       //--------------------------------
 6573: 
 6574: 
 6575:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6576:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6577: 
 6578:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6579:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6580:          int kbin = 0; // bin index
 6581:          for (int k = kb; k < nvrt; k++) {
 6582:             // Computes node height above the bottom level
 6583:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6584:             assert(false && "Vertical variation of vegetation not implemented");
 6585: 
 6586:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6587:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6588:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6589:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6590:             // } else {
 6591:             //    // Find the bin at which the current vertical level is
 6592:             //    while (kbin<nbins_veg_vert) {
 6593:             //       const double zn = node->z[kbin];
 6594:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6595:             //          break;
 6596:             //       } // if
 6597:             //       kbin++;
 6598:             //    } // while
 6599:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6600: 
 6601:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6602:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6603:                
 6604:             //    // Linear interpolation of the vegetation parameters
 6605:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6606:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6607:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6608:             // } // if rl10
 6609: 
 6610:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6611: 
 6612:          } // for k
 6613: 
 6614: 
 6615:       } else { // Ganthy (iveg==2)
 6616:       //  Modify canopy height, diameter, and density
 6617: 
 6618:          // Make sure there is vegetation on this node
 6619:          if (node->veg_h_unbent > 0.0) {
 6620:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6621: 
 6622:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6623:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6624:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6625: 
 6626:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6627:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6628:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6629:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6630:          } // if veg_h_unbent
 6631: 
 6632:          for (int k = 0; k < nvrt; k++) {
 6633:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6634:          } // for k
 6635:       
 6636: 
 6637:       } // if iveg
 6638:      
 6639: 
 6640:       // Compute vertical mean of veg_alpha3D
 6641:       if (iveg != 0) {
 6642:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6643:          double sum1=0.0;
 6644:          double sum2=0.0;
 6645:          // Integrate over each level under the canopy...
 6646:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6647:             const double Dz = node->Dz(k);
 6648: 
 6649:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6650:             sum2 += Dz;
 6651: 
 6652:          } // for k
 6653:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6654:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6655: 
 6656:       } // if iveg
 6657: 
 6658:    }
