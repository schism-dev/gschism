 2588: /**
 2589:  * This method performs backtracking from the side center until a time -dt back in time 
 2590:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2591:  * intermediate point.
 2592:  *
 2593:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2594:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2595:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2596:  * remaining time.
 2597:  * 
 2598:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2599:  * 
 2600:  * @param uuint, vvint, wwint: Velocities at the final point
 2601:  * @param jlev: Level at which the backtracking is performed
 2602:  * @param dt, dtbk: Tracking timesteps
 2603:  * @return: True if the backtracking was successful, false otherwise
 2604:  */
 2605: __inline__ __device__ bool Side::btrack(
 2606:       int jlev,
 2607:       double dt,            // Tracking time
 2608:       double dtbk,          // Tracking timestep
 2609:       Vector3 &u_int        // Velocities at the initial point
 2610: ) const {
 2611: 
 2612:    // Start from side center
 2613:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2614: 
 2615:  
 2616:    double time_rm = dt; // Remaining time
 2617: 
 2618: 
 2619:    // // Initialize outputs XXX
 2620:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2621:    //    sclr[i] = 0.0;
 2622:    // }
 2623: 
 2624: 
 2625:    // Initial velocities
 2626:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2627: 
 2628:    // Find the element that is in the direction opposite to the velocity
 2629:    Element* curElem = findElementTowards(toVector2(u_int));
 2630: 
 2631: 
 2632:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2633:    if (curElem == nullptr) {
 2634:       // Make velocity parallel to the side
 2635:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2636:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2637:       curElem = otherElem(curElem);
 2638:       
 2639:    }
 2640: 
 2641: // Nudges it towards the circumcenter
 2642: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2643: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2644:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2645: const double eps = 9.013e-3;                 
 2646: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2647: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2648: 
 2649: 
 2650: 
 2651:    const int MAX_ITERATIONS = 1000; 
 2652:    Element* nextElem = curElem;
 2653:    int iter = 0;
 2654:    while(true) {
 2655: 
 2656:       // Calculate timestep
 2657:       double dtb = min(dtbk, time_rm);
 2658: 
 2659:       // Next point in the backtracking curve
 2660:       Point3 xt = x0 - dtb*u_int;
 2661:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2662:       assert(found && "Backtracking failed in btrack");
 2663: 
 2664:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2665: 
 2666:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2667:                       // then time_rm needs to be increased by the unused time.
 2668: 
 2669:       // If the velocity is too small, we stop the backtracking
 2670:       const double vmag = length(toVector2(u_int));
 2671:       if (vmag <= velmin_btrack) break;
 2672: 
 2673:       // The current point becomes the next segment's starting point.
 2674:       x0 = xt;
 2675:  
 2676:       curElem = nextElem;
 2677: 
 2678:       iter++;
 2679:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2680:    }
 2681: 
 2682: 
 2683: }
 2684: 
 2685: 
