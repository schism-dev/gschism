 2158: // Helper functions for computing the local node index at a given offset from another.
 2159: __device__ __inline__ int nxq(int offset, int index, int size) {
 2160:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2161:    // to the index to make it positive
 2162:    assert(index + offset + 16*size >= 0);
 2163:    return (index + offset + 16*size) % size;  
 2164: }
 2165: 
 2166: __device__ __inline__ int nxq(int index, int size) {
 2167:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2168:    // to the index to make it positive
 2169:    assert(index + 16*size >= 0);
 2170:    return (index + 16*size) % size; 
 2171: }
