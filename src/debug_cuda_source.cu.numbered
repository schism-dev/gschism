  448: struct Element {
  449: 
  450:    // Geometry information
  451:    int idx;               // Index of the element
  452:    int i34;               // Number of sides for the element 
  453:    Side *sides[4];        // Sides of the element
  454:    Node *nodes[4];        // Nodes of the element
  455:    Element *nghbElems[4]; // Neighbors of the element
  456: 
  457:    int kb;                    // Bottom index of the element
  458:    double area;               // Area of the element
  459:    double ssign[4];           // Sign associated with each side of an element
  460:    double radius;             // Element equivalent radii
  461: 
  462:    Frame frame;
  463: 
  464:    Vector2 gradPhi[4];       // Derivatives of shape functions
  465:    Vector2 gradEta;          // Gradient of free surface elevation
  466:    Vector2 gradPr;           // Gradient of pressure    
  467:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  468: 
  469:    bool isDry;                  // True if the element is dry
  470:    int kbe;                   // Bottom index of the element
  471: 
  472:    Vector3 center;            // Element center coordinates
  473:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  474:    double depth;              // Depth at element (min of all nodes)
  475:    double z[nvrt];            // z-coord  (local frame - vertical up)
  476: 
  477:    // Physical information
  478:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  479: 
  480:    static const bool isblock = false;              // Always false
  481: 
  482:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  483:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  484: 
  485:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  486: 
  487:    
  488: 
  489:    double vsource;            // Volumetric source/sink term [m^3/s]
  490: 
  491:    double rho[nvrt];          // Density at each prism center
  492:    double rho_mean[nvrt];     // Mean density at each prism center
  493:    CubicSpline rho_spl;
  494:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  495:    double rho_z[nvrt];        // First derivative of density at each prism center
  496:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  497: 
  498:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  499: 
  500:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  501:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  502: 
  503:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  504:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  505: 
  506:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  507:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  508:       // Find the local index of the node in the element (0,1,2,3)
  509:       int res = __ffs((nodes[0] == node) | 
  510:                      ((nodes[1] == node) << 1) | 
  511:                      ((nodes[2] == node) << 2) | 
  512:                      ((nodes[3] == node) << 3)) - 1;
  513:       
  514:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  515:       return res;
  516:    }
  517: 
  518:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  519:       // Find the local index of the side in the element (0,1,2,3)
  520:       int res = __ffs((sides[0] == side) | 
  521:                      ((sides[1] == side) << 1) | 
  522:                      ((sides[2] == side) << 2) | 
  523:                      ((sides[3] == side) << 3)) - 1;
  524:       
  525:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  526:       return res;
  527:    }
  528: 
  529: 
  530:    __inline__ __device__ int findLevel(double z1, int k) const {
  531:       // Starting at index k, find sequentially the level that contains z
  532: 
  533:       // if z is already betweeen z[k] and z[k+1], return k
  534:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  535:       else if (z1 < z[k]) { 
  536:          // Search for increasing levels
  537:          for (int kk = k; kk < nvrt - 1; kk++) {
  538:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  539:          }
  540:          return nvrt - 1;
  541:       }
  542:       else {
  543:          // Search for decreasing levels
  544:          for (int kk = k; kk > 0; kk--) {
  545:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  546:          }
  547:          return 0;
  548:       }
  549:    }
  550: 
  551:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  552:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  553: 
  554:    // Check if the element is dry using the more up-to-date elevation.
  555:    __inline__ __device__ bool isDry2(void) const;
  556: 
  557:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  558: 
  559:    __inline__ __device__ double computeSignedArea(void) const;
  560: 
  561:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  562:       // Nudges the point (x,y) to the barycenter of the element
  563:       p = (1-eps)*p + eps*toVector2(center);
  564:    }
  565: 
  566:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  567: 
  568:    __device__ Vector2 grad2(double *a) const
  569:    {
  570:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  571:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  572:       if (isQuad()) {
  573:          gx += a[3]*gradPhi[3].x;
  574:          gy += a[3]*gradPhi[3].y;
  575:       }
  576:       return {gx, gy};
  577:    }
  578: 
  579:    __device__ Vector2 grad2(double Node::* field) const
  580:    {
  581:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  582:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  583:       if (isQuad()) {
  584:          gx += (nodes[3]->*field)*gradPhi[3].x;
  585:          gy += (nodes[3]->*field)*gradPhi[3].y;
  586:       }
  587:       return {gx, gy};
  588:    }
  589: 
  590:    __device__ void setFrame(void) {
  591: 
  592:       double ar1, ar2;
  593:       computeLonLat(center, ar1, ar2);
  594: 
  595:       frame.update(ar1, ar2);        
  596:     }
  597: 
  598:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  599:                                         double& tIntersect);
  600:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  601:                                         double& tIntersect);
  602: 
  603:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  604:       // Check if the point (xt,yt) is inside the element
  605:       double shpCoords[4];
  606:       bool res = computeShapeCoords(xt, shpCoords, false);
  607:       return res;
  608:    }
  609: 
  610:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  611:    {
  612:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  613:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  614:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  615:       
  616:    }
  617: 
  618:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  619: 
  620:    // ------------------------------------------------------------------------------------------------
  621:    // These are functions that work on all nodes of the element.
  622:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  623:    //
  624:    // An example of how to use these functions is:
  625:    //   
  626:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  627:    // 
  628:    // Where L is the level at which the field is to be interpolated. The field can be either
  629:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  630:    // There are different versions of getNodalValues for each of these cases.
  631: 
  632:    template<typename T>
  633:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  634:       // Get the values of the field at the nodes of the element
  635:       res[0] = nodes[0]->*field;
  636:       res[1] = nodes[1]->*field;
  637:       res[2] = nodes[2]->*field;
  638:       if (isQuad()) res[3] = nodes[3]->*field;
  639:       else          res[3] = T();
  640:    }
  641: 
  642:    template<typename T>
  643:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  644:       // Get the values of the field at the nodes of the element
  645:       res[0] = (nodes[0]->*field)[level];
  646:       res[1] = (nodes[1]->*field)[level];
  647:       res[2] = (nodes[2]->*field)[level];
  648:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  649:       else          res[3] = T();
  650:    }    
  651: 
  652:    template<typename T>
  653:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  654:       // Get the values of the func at the nodes of the element
  655:       res[0] = (nodes[0]->*func)(level);
  656:       res[1] = (nodes[1]->*func)(level);
  657:       res[2] = (nodes[2]->*func)(level);
  658:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  659:       else          res[3] = T();  // This is 0.0 or a zero vector
  660: 
  661:    }      
  662: 
  663:    template<typename T>
  664:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  665:       // Get the values of the field at the nodes of the element
  666:       res[0] = sides[0]->*field;
  667:       res[1] = sides[1]->*field;
  668:       res[2] = sides[2]->*field;
  669:       if (isQuad()) res[3] = sides[3]->*field;
  670:       else          res[3] = T();
  671:    }
  672: 
  673:    template<typename T>
  674:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  675:       // Get the values of the field at the nodes of the element
  676:       res[0] = (sides[0]->*field)[level];
  677:       res[1] = (sides[1]->*field)[level];
  678:       res[2] = (sides[2]->*field)[level];
  679:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  680:       else          res[3] = T();
  681:    }    
  682: 
  683:    template<typename T>
  684:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  685:       // Get the values of the func at the nodes of the element
  686:       res[0] = (sides[0]->*func)(level);
  687:       res[1] = (sides[1]->*func)(level);
  688:       res[2] = (sides[2]->*func)(level);
  689:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  690:       else          res[3] = T();  // This is 0.0 or a zero vector
  691: 
  692:    }      
  693: 
  694: 
  695:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  696:       double values[4];
  697:       getNodalValues(level, func, values);
  698: 
  699:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  700:    }
  701: 
  702:    template<typename T>
  703:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  704:       T values[4];
  705:       getNodalValues(field, values);
  706:       
  707:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  708:    }
  709: 
  710: 
  711:    template<typename T>
  712:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  713:       T values[4];
  714:       getNodalValues(level, field, values);
  715: 
  716:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  717:    }
  718: 
  719:    template<typename T>
  720:    __device__ T mean(T Node::* field) const {
  721:       T values[4];
  722:       getNodalValues(field, values);
  723: 
  724:       return (values[0] + values[1] + values[2] + values[3])/i34;
  725:    }
  726: 
  727:    template<typename T>
  728:    __device__ T mean(T Side::* field) const {
  729:       T values[4];
  730:       getSideValues(field, values);
  731:       
  732:       return (values[0] + values[1] + values[2] + values[3])/i34;
  733:    }   
  734: 
  735:    // __device__ double mean(double (Node::*func)(int) const) const {
  736:    //    double values[4];
  737:    //    getNodalValues(level, func, values);
  738:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  739:    // }
  740:    // ------------------------------------------------------------------------------------------------
  741: 
  742:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  743:       // Convert global coordinates to local coordinates
  744:       printf("NOT IMPLEMENTED: globalToLocal\n");
  745:       return true;
  746:    }
  747: 
  748:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  749:       // Convert local coordinates to global coordinates
  750:       printf("NOT IMPLEMENTED: localToGlobal\n");
  751:       return true;
  752:    }
  753: 
  754:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  755:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  756:     
  757:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  758:                                                  Element *&nextElem, int &jlev, double &dt);
  759: 
  760: };
