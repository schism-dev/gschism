 7698: __global__ void getStructSizes(int* sizes)  {
 7699:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7700:       sizes[0] = (int)sizeof(Node);
 7701:       sizes[1] = (int)sizeof(Element);
 7702:       sizes[2] = (int)sizeof(Side);
 7703:       sizes[3] = (int)sizeof(NodeBoundary);
 7704:       sizes[4] = (int)sizeof(SideBoundary);
 7705:       sizes[5] = (int)sizeof(BoundarySegment);
 7706: }
