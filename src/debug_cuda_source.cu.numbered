 2496: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2497: 
 2498:    const double w1 = getBoundaryArrayValueWeight();
 2499:    const double w2 = 1.0 - w1;
 2500:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2501:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2502: 
 2503:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2504: }
