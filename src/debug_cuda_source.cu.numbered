 8387:    SIDE(side);
 8388: 
 8389:    switch (varCode) {
 8390:       case (int)VarCode::outputCoords:
 8391:          const Point2 coords = side->outputCoords();
 8392:          res[side->idx*2    ] = coords.x;
 8393:          res[side->idx*2 + 1] = coords.y;
 8394:          break;
 8395:    }
 8396: }
