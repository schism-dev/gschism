 8211: extern "C" __global__ void getNodeVarFunc(int varCode, double *res) {
 8212: 
 8213:    NODE(node);
 8214: 
 8215:    switch (varCode) {
 8216:       case (int)VarCode::outputCoords:
 8217:          const Point2 coords = node->outputCoords();
 8218:          res[node->idx*2    ] = coords.x;
 8219:          res[node->idx*2 + 1] = coords.y;
 8220:          break;
 8221:    }
 8222: }
