 3526: 
 3527:    __global__ void scaleGravity(double loadtide_coef) {
 3528: 
 3529: 
 3530:       NODE(node);
 3531: 
 3532:       // SAL option: scale gravity
 3533:       if constexpr(iloadtide==2) {  // simple const
 3534:          node->grav2 = grav*(1.0 - loadtide_coef);
 3535: 
 3536:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3537:         
 3538:           const double depth = max(node->depth, 0.0);
 3539:           const double tmp1 = sqrt(depth);
 3540:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3541:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3542:                              2.6969e-13*depth*depth*depth*tmp1;
 3543:           
 3544:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3545:           
 3546: 
 3547: 
 3548:           node->grav2 = grav*(1.0 - beta_bar);
 3549: 
 3550:       } else {  // iloadtide=0,1
 3551:         node->grav2=grav;
 3552: 
 3553:       }
 3554: 
 3555:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3556:    }
 3557: 
