 3203: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3204:    if constexpr(ics == 1) {
 3205:       return center;
 3206: 
 3207:    } else {
 3208:       const Point2 p0 = n1->outputCoords();
 3209:       const Point2 p1 = n2->outputCoords();
 3210:       return (1.0/2.0)*(p0 + p1);
 3211: 
 3212:    }
 3213: }
 3214: 
 3215: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3216: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3217: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3218: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3219: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3220: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3221: __inline__ __device__ Point3  Side::p3_t(double t) const { return {x(t), y(t), z(t)}; }
 3222: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3223: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3224: // Computes the gradient of the field at the side center.
 3225:    Vector2 grad = {0.0, 0.0};
 3226:    int count = 0;
 3227: 
 3228:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3229:    // as the average of the gradients at each element.
 3230:    // First element
 3231:    if (elems[0] != nullptr && condition(elems[0])) {
 3232:       Vector2 elemGrad = elems[0]->grad2(field);
 3233: 
 3234:       // For ics=2, projects the element gradient from its frame to the side frame
 3235:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3236: 
 3237: 
 3238:       grad += elemGrad;
 3239: 
 3240:       count++;
 3241:    }
 3242: 
 3243:    // Second element
 3244:    if (elems[1] != nullptr && condition(elems[1])) {
 3245: 
 3246:       Vector2 elemGrad = elems[1]->grad2(field);
 3247: 
 3248:       // For ics=2, projects the element gradient from its frame to the side frame
 3249:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3250: 
 3251:       grad += elemGrad;
 3252: 
 3253:       count++;
 3254:    }
 3255: 
 3256:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3257:    if (count > 0) {
 3258:       grad = grad*(1.0/count);
 3259:    }
 3260:    
 3261:    return grad;
 3262: }
 3263: 
 3264: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3265: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3266: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3267: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3268: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3269: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3270: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3271: 
 3272: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3273: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3274: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3275: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3276: 
 3277: 
 3278: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3279: 
 3280: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3281:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3282:    if constexpr(ics == 1) { 
 3283:       return 0.5*(n1->tau + n2->tau);
 3284: 
 3285:    } else {
 3286:       // Project the tau from the node frames to the side frame
 3287:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3288:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3289: 
 3290:       return 0.5*(stau1 + stau2);
 3291: printf("tau = (%f, %f)\n", stau1.x, stau1.y);
 3292:    }
 3293: }
 3294: 
 3295: /**
 3296:  * This method performs backtracking from the side center until a time -dt back in time 
 3297:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3298:  * intermediate point.
 3299:  *
 3300:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3301:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3302:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3303:  * remaining time.
 3304:  * 
 3305:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3306:  * 
 3307:  * @param uuint, vvint, wwint: Velocities at the final point
 3308:  * @param jlev: Level at which the backtracking is performed
 3309:  * @param dt, dtbk: Tracking timesteps
 3310:  * @return: True if the backtracking was successful, false otherwise
 3311:  */
 3312: __inline__ __device__ bool Side::btrack(
 3313:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3314:       double dt,            // Tracking time
 3315:       double dtbk,          // Tracking timestep
 3316:       Vector3 &u_int        // Velocities at the initial point
 3317: ) const {
 3318: 
 3319:    // Start from side center
 3320:    Point3 x0;
 3321: 
 3322:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3323:    else                   x0 = {0.0, 0.0, zc[jlev]};
 3324: 
 3325:  
 3326:    double time_rm = dt; // Remaining time
 3327: 
 3328: 
 3329:    // Initial velocities
 3330:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3331: 
 3332:    // Find the element that is in the direction opposite to the velocity
 3333:    Element* curElem = findElementTowards(toVector2(u_int));
 3334:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3335: 
 3336:    // // If debugging backtracking, add the starting point to the debug plot and the elements for
 3337:    // // idx == 15876
 3338:    // if (idx == 15876) {
 3339:    //    printf("PPP u_int = (%f, %f, %f)\n", u_int.x, u_int.y, u_int.z);
 3340:    //    const Point3 orig = toPoint3(center, centerZ());
 3341:    //    auto vertexInOriginalFrame = [this, orig, jlev](const Node *node) -> Point3 {
 3342:    //       if constexpr(ics == 1) {
 3343:    //          return toPoint3(node->p, 0.0);
 3344:    //       } else {
 3345:    //          const Point3 p_glob = toPoint3(node->p, node->gz);
 3346:    //          const Vector3 loc = frame.G2L(p_glob - orig);
 3347:    //          return Point3(loc.x, loc.y, 0.0);
 3348:    //       }
 3349:    //    };
 3350:    //    auto elementInOriginalFrame = [this, orig, jlev](const Element *elem) -> Point3 { 
 3351:    //       if constexpr(ics == 1) {
 3352:    //          return toPoint3(elem->center, elem->centerZ());
 3353:    //       } else {
 3354:    //          const Point3 center_glob = toPoint3(elem->center, elem->centerZ());
 3355:    //          const Vector3 loc = frame.G2L(center_glob - orig);
 3356:    //          return Point3(loc.x, loc.y, loc.z);
 3357:    //       }
 3358:    //    };
 3359:    //    auto plotTriangle = [&vertexInOriginalFrame, &elementInOriginalFrame](const Element *elem, unsigned int color) {
 3360:    //       if (elem == nullptr || !elem->isTri()) return;
 3361:    //       const Point3 v0 = vertexInOriginalFrame(elem->nodes[0]);
 3362:    //       const Point3 v1 = vertexInOriginalFrame(elem->nodes[1]);
 3363:    //       const Point3 v2 = vertexInOriginalFrame(elem->nodes[2]);
 3364:    //       const Point3 center = elementInOriginalFrame(elem);
 3365:    //       addDebugPlot(v0, v1, color, 'o', elem->nodes[0]->idx);
 3366:    //       addDebugPlot(v1, v2, color, 'o', elem->nodes[1]->idx);
 3367:    //       addDebugPlot(v2, v0, color, 'o', elem->nodes[2]->idx);
 3368:    //       addDebugPlot(center, center, color, 'o', elem->idx);
 3369:    //    };
 3370:    //    plotTriangle(curElem, 0xFF0000u);  // current element in red
 3371:    //    plotTriangle(curElem->nghbElems[0], 0x00A000u);
 3372:    //    plotTriangle(curElem->nghbElems[1], 0x00A000u);
 3373:    //    plotTriangle(curElem->nghbElems[2], 0x00A000u);
 3374: 
 3375:    //    // Add the initial point (0,0) to the debug plot
 3376:    //    addDebugPlot(Point3(0.0, 0.0, 0.0), Point3(0.0, 0.0, 0.0), 0x0000FFu, '+');
 3377:    // }
 3378: 
 3379:    // Nudges it towards the barycenter
 3380:    curElem->nudgeToBarycenter(toPoint2(x0), this); // XXXX Necessary?
 3381: // if (idx == 15876) addDebugPlot(Point3(0.0, 0.0, 0.0), x0, 0xFF00FFu, 'o');
 3382: 
 3383: 
 3384:    const int MAX_ITERATIONS = 100; 
 3385:    Element* nextElem = nullptr;
 3386:    int iter = 0;
 3387:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3388:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3389:    while(true) {
 3390: 
 3391:       // Calculate timestep
 3392:       double dtb = min(dtbk, time_rm);
 3393: 
 3394: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 3395: 
 3396:       // Next point in the backtracking curve
 3397: // if (iter >= MAX_ITERATIONS - 50)  {
 3398: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 3399: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 3400: // }
 3401:         
 3402:       xt = x0 - dtb*u_int;
 3403: 
 3404:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 3405: // if (idx == 15876) addDebugPlot(x0, xt, 0xFF00FFu, '+');
 3406: if (!found) {if (idx == 15876) printf("1111\n"); return true;}
 3407:       assert(found && "Backtracking failed in btrack");
 3408: 
 3409: 
 3410:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 3411:                       // then time_rm needs to be increased by the unused time.
 3412: 
 3413:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 3414: 
 3415:       // If the velocity is too small, we stop the backtracking
 3416:       const double vmag = length(toVector2(u_int));
 3417:       if (vmag <= velmin_btrack) break;
 3418: 
 3419:       // The current point becomes the next segment's starting point.
 3420:       x0 = xt;
 3421:  
 3422:       curElem = nextElem;
 3423: 
 3424:       iter++;
 3425: 
 3426:       if (iter >= MAX_ITERATIONS) break;
 3427: 
 3428:       // if (iter >= MAX_ITERATIONS - 50) {
 3429:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 3430:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 3431:       //    }
 3432:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3433:    }
 3434: 
 3435:    assert(!curElem->isDry && "Final element is dry");
 3436:    assert(curElem->containsPoint(toPoint2(xt), this) && "Target point is not inside the final element"); 
 3437: 
 3438:    // Interpolate the velocities at the final point
 3439:    u_int = curElem->interpolateVelocities(xt, this);
 3440: 
 3441:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 3442: 
 3443: 
 3444: }
