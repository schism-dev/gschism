 2161: 
 2162: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2163:    if constexpr(ics == 1)  {
 2164:       return center;
 2165: 
 2166:    } else {
 2167:       const Point2 p0 = nodes[0]->outputCoords();
 2168:       const Point2 p1 = nodes[1]->outputCoords();
 2169:       const Point2 p2 = nodes[2]->outputCoords();
 2170: 
 2171:       if (isTri()) {
 2172:          return (1.0/3.0)*(p0 + p1 + p2);
 2173: 
 2174:       } else {
 2175:          const Point2 p3 = nodes[3]->outputCoords();
 2176:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2177:       }
 2178: 
 2179:    }
 2180: }
 2181: 
 2182: 
 2183: __device__ __forceinline__ double Element::centerZ(void) const { 
 2184: // Z coordinate of the element center in the global cartesian coordinates.
 2185: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2186: 
 2187:    if constexpr(ics==1) { 
 2188:       return 0.0; 
 2189: 
 2190:    } else { 
 2191: 
 2192:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2193:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2194:    } 
 2195: }
