 1806: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int label = -1) {
 1807: // return;   
 1808:    // Lock the mutex
 1809:    lock(&debugPlotMutex);
 1810:  
 1811:    bool ok = true;
 1812:    if (debugPlotIdx == nullptr) ok = false;
 1813:    if (*debugPlotIdx >= 10000) ok = false;
 1814:    if (ok) {
 1815:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1816:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1817:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1818:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1819:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1820:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1821:       debugPlot[(*debugPlotIdx) + 6*10000] = (double)label;
 1822:       (*debugPlotIdx)++;
 1823:    }
 1824: 
 1825:    __threadfence();               // ensure all above writes are visible
 1826:    // Unlock the mutex
 1827:    unlock(&debugPlotMutex);
 1828: 
 1829: }
