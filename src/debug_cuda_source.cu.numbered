 7168: __global__ void returnMatrix(double *res) {
 7169:    // Debugging: returns the matrix as a CuPy array
 7170: 
 7171:    const int size = mesh->np;
 7172:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7173:       const Node *node = mesh->localNodeData + idx_node;
 7174:       res[idx_node*size + idx_node] = node->coeffDiag;
 7175:       for (int j = 0; j < node->numNodes; j++) {
 7176:          Node* nbNode = node->nodes[j];
 7177:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7178:       }
 7179: 
 7180:    }
 7181:    
 7182: }
