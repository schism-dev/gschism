 1993: //===============================================================================
 1994: 
 1995: 
 1996: /**
 1997:  * Find the element that contains the target point.
 1998:  * 
 1999:  * @param x0,y0,z0     Starting position coordinates
 2000:  * @param xt,yt,zt     Target position coordinates
 2001:  * @param dtb          Time step for tracking
 2002:  * @param u_int        Initial velocity components
 2003:  * @param nextElem     Starting/resulting element index
 2004:  * 
 2005:  * @return Status code of type trackExitCodes
 2006:  * 
 2007:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2008:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2009:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2010:  * as close the the segment AB as possible, the next point at each iteration is computed
 2011:  * along segment AB, but just after the current element.
 2012:  */
 2013: 
 2014: 
 2015: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2016: 
 2017:    constexpr int MAX_ITERATIONS = 40;
 2018: 
 2019:    int iter = 0;
 2020:    double fac = 0.00001;
 2021:    while (iter < MAX_ITERATIONS) {
 2022:       iter++;
 2023: 
 2024:       Bool4 isLeft, isObtuse, isBisector;
 2025:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2026: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2027:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2028: 
 2029: 
 2030:       if (isValid.none()) 
 2031:       // Inside the element if none of the edges is a valid continuation
 2032:       {
 2033:          // Just returns true and the element (curElem) is unchanged).
 2034:          // This means that the algorithm has found the element that contains the target point.
 2035:          return true;
 2036:       }
 2037:       else { // Outside the element
 2038: 
 2039:          // Outside this element. Pick the first valid exit side and cross.
 2040:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2041:          Element *prevElem = curElem;
 2042:          curElem = lastCrossSide->otherElem(curElem);
 2043: 
 2044:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2045:          // along the boundary.
 2046:          if (curElem == nullptr || curElem->isDry) {
 2047:          
 2048:             curElem = prevElem;
 2049:             return false;
 2050:          }
 2051:          
 2052:       }
 2053: 
 2054:    }
 2055: 
 2056:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2057: }
 2058: 
 2059: 
 2060: 
 2061: //===============================================================================
 2062: 
 2063: __device__ void lock(int *mutex) {
 2064:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2065: }
 2066: 
 2067: __device__ void unlock(int *mutex) {
 2068:     atomicExch(mutex, 0);
 2069: }
 2070: 
 2071: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2072: // return;   
 2073:    // Lock the mutex
 2074:    lock(&debugPlotMutex);
 2075:  
 2076:    bool ok = true;
 2077:    if (debugPlotIdx == nullptr) ok = false;
 2078:    if (*debugPlotIdx >= 1000000) ok = false;
 2079:    if (ok) {
 2080:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2081:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2082:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2083:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2084:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2085:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2086:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2087:       (*debugPlotIdx)++;
 2088:    }
 2089: 
 2090:    __threadfence();               // ensure all above writes are visible
 2091:    // Unlock the mutex
 2092:    unlock(&debugPlotMutex);
 2093: 
 2094: }
 2095: 
 2096: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2097:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 2098: }
