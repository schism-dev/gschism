 4797:    __global__ void computeFlowBcVelocities(double time) {
 4798: 
 4799:       SIDE_BND(sideBnd);
 4800: 
 4801:       const Side *side = sideBnd->side;
 4802:  
 4803:       const bool isDry = side->isDry;
 4804:       const bool isLand = sideBnd->segment->isLand;
 4805: 
 4806:    
 4807:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4808: 
 4809:       if (isDry || isLand) return;
 4810: 
 4811:       // For wet sides in open boundaries...
 4812:       const Vector2 n = side->n;
 4813:       const BoundarySegment *segment = sideBnd->segment;
 4814: 
 4815:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4816: 
 4817:       const int ifltype = segment->ifltype;
 4818: 
 4819:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4820:       const Vector2 r_nuth0 = r_uth0*n;
 4821: 
 4822: 
 4823:       if (ifltype == 1 || ifltype == 2) {
 4824:       
 4825:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4826: 
 4827:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4828:          
 4829:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4830:          
 4831:       } else if (ifltype == -1) { // Flather 1
 4832: 
 4833:          for (int k = 0; k < nvrt; k++) {
 4834: 
 4835:             // uth is the normal vel.; no ramp up
 4836:             const double uth = sideBnd->nuth(k);
 4837:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4838: 
 4839:             sideBnd->ubc[k] += uth*n;
 4840:          }
 4841: 
 4842:       } else if (ifltype == 3 || ifltype == 5) {
 4843:          // vnth0=0 !normal vel.
 4844: 
 4845:          Vector2 r_u1_bar = {0.0, 0.0};
 4846:          // Computes the contribution to the velocity from all tide frequencies
 4847:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4848: 
 4849:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4850:             const Vector2 umo  = sideBnd->umo(jfr); 
 4851: 
 4852:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4853:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4854:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4855:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4856: 
 4857:          }
 4858: 
 4859: 
 4860:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4861: 
 4862:       } // if (ifltype = 3 || ifltype == 5
 4863: 
 4864: 
 4865: 
 4866:    }
 4867: 
 4868:    __global__ void computeElevationBoundaryConditions(double time) {
 4869:       // Compute elevation essential boundary conditions 
 4870: 
 4871:       NODE_BND(nodeBnd); // Each boundary node.
 4872: 
 4873:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4874: 
 4875:       const Node *node = nodeBnd->node;
 4876:       const BoundarySegment *segment = nodeBnd->segment;
 4877:       const int iettype = segment->iettype;
 4878:       
 4879: 
 4880:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4881:       double eic = 0.0;
 4882:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4883:       else                 eic = 0.0;
 4884: 
 4885:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4886:       const double r_eth = ramp*nodeBnd->eth;
 4887:       double r_eta1_bar = 0.0;
 4888: 
 4889: 
 4890:       // Compute tide elevation
 4891:       if (iettype == 3 || iettype == 5) {   
 4892: 
 4893:          if constexpr(iloadtide==1) { // loading tide
 4894:             assert(false && "Loading tide not implemented");
 4895:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4896:          }
 4897:          
 4898:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4899: 
 4900:             const double efa  = nodeBnd->efa[jfr]; 
 4901:             const double emo  = nodeBnd->emo[jfr]; 
 4902: 
 4903:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4904:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4905:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4906: 
 4907:          } // for jfr
 4908: 
 4909:       } // if iettype
 4910: 
 4911:       switch (iettype) {
 4912:          case 1:
 4913:          case 2:
 4914:          case 4:
 4915:             nodeBnd->elbc = r_eic + r_eth;
 4916:             break;
 4917:          case 3:
 4918:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4919:             break;
 4920:          case 5:
 4921:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4922:             break;
 4923:       } // switch
 4924: 
 4925: 
 4926:       //Add inverse barometric effects
 4927:       if (iettype != 0 && inv_atm_bnd == 1) {
 4928:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4929:       }
 4930: 
 4931:    }
 4932: 
 4933: 
 4934:    __global__ void computeHorizontalViscosity(void) { 
 4935: 
 4936:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4937: 
 4938:       SIDE(side);
 4939: 
 4940:       if (side->isDry) return;
 4941: 
 4942:       for (int k = 0; k < nvrt; k++) {
 4943:          side->nuGradU[k] = {0.0, 0.0};
 4944:       }
 4945: 
 4946:       if constexpr(ihorcon == 1) {
 4947:          for (int k = side->kb; k < nvrt - 1; k++) {
 4948:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4949:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4950:             // By Zhang and Baptista.
 4951: 
 4952:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4953:             // This is a standard discretization of the Laplacian operator.
 4954:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4955:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4956:             // Gamma is hvis_coef0 in the code.
 4957:             // The value of gamma needs to be < 0.5.
 4958: 
 4959:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4960:             // side under consideration in each of the two possible elements that share the side.
 4961:             Vector2 sumU = {0.0, 0.0};
 4962:             for (int l = 0; l < 2; l++) {
 4963:                const Element *elem = side->elems[l];
 4964: 
 4965:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4966: 
 4967:                // Find the local index of the side in the element
 4968:                const int idxSide = elem->sideLocalIdx(side);
 4969: 
 4970:                // Find the two sides that are connected to the side under consideration
 4971:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4972:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4973: 
 4974:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4975: 
 4976:             }
 4977: 
 4978:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4979: 
 4980:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4981:    
 4982:          }
 4983:       }
 4984:       else if constexpr(ihorcon == 2) {
 4985:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4986:       }
 4987: 
 4988: 
 4989:    }
 4990: 
 4991: 
 4992:    __global__ void setEssentialBC(void) {
 4993:       // Set essential boundary conditions 
 4994:       NODE(node); // Each boundary node
 4995:       NodeBoundary *nodeBnd = node->nodeBnd;
 4996:       
 4997:  
 4998:       // Check if this node has essential BC
 4999:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5000:          // Verify BC value is valid
 5001:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5002: 
 5003:        
 5004:          // Set diagonal to 1 and zero off-diagonals
 5005:          node->coeffDiag = 1.0;
 5006: 
 5007:          for (int j = 0; j < node->numNodes; j++) {
 5008:                node->coeffMatrix[j] = 0.0;
 5009:          }
 5010:          
 5011:          // Set solution and RHS to BC value
 5012:          node->mX  = nodeBnd->elbc;
 5013:          node->qel = nodeBnd->elbc;
 5014: 
 5015:       } else {
 5016:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5017: 
 5018:          for (int j = 0; j < node->numNodes; j++) {
 5019:                Node* nbNode = node->nodes[j];
 5020:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5021:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5022:                   // Verify neighbor's BC value
 5023:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5024: 
 5025:                   // Subtract contribution to RHS
 5026:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5027:                   node->coeffMatrix[j] = 0.0;  
 5028:                }
 5029:          }
 5030:       }
 5031:    }
