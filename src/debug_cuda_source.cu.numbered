 5295:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5296: 
 5297:       NODE_BND(nodeBnd);
 5298: 
 5299:       Node *node = nodeBnd->node;
 5300: 
 5301:       node->ETP = 0.0;
 5302: 
 5303:       // For all tidal potential components
 5304:       for (int j=0; j<ntip; j++) {
 5305: 
 5306:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5307: 
 5308:          node->ETP += nodeETP;
 5309: 
 5310:          if constexpr(iloadtide==1) { // loading tide
 5311:             assert(false && "Loading tide not implemented");
 5312:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5313:          }
 5314:          
 5315:       }
 5316: 
 5317:      
 5318:    }
