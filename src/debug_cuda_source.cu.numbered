 3545: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3546:    if constexpr(ics == 1) {
 3547:       return center;
 3548: 
 3549:    } else {
 3550:       const Point2 p0 = n1->outputCoords();
 3551:       const Point2 p1 = n2->outputCoords();
 3552:       return (1.0/2.0)*(p0 + p1);
 3553: 
 3554:    }
 3555: }
 3556: 
 3557: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3558: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3559: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3560: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3561: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3562: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3563: __inline__ __device__ Point3  Side::p3_t(double t) const { return {x(t), y(t), z(t)}; }
 3564: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3565: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3566: // Computes the gradient of the field at the side center.
 3567:    Vector2 grad = {0.0, 0.0};
 3568:    int count = 0;
 3569: 
 3570:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3571:    // as the average of the gradients at each element.
 3572:    // First element
 3573:    if (elems[0] != nullptr && condition(elems[0])) {
 3574:       Vector2 elemGrad = elems[0]->grad2(field);
 3575: 
 3576:       // For ics=2, projects the element gradient from its frame to the side frame
 3577:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3578: 
 3579:       grad += elemGrad;
 3580: 
 3581:       count++;
 3582:    }
 3583: 
 3584:    // Second element
 3585:    if (elems[1] != nullptr && condition(elems[1])) {
 3586: 
 3587:       Vector2 elemGrad = elems[1]->grad2(field);
 3588: 
 3589:       // For ics=2, projects the element gradient from its frame to the side frame
 3590:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3591: 
 3592:       grad += elemGrad;
 3593: 
 3594:       count++;
 3595:    }
 3596: 
 3597:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3598:    if (count > 0) {
 3599:       grad = grad*(1.0/count);
 3600:    }
 3601:    
 3602:    return grad;
 3603: }
 3604: 
 3605: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3606: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3607: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3608: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3609: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3610: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3611: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3612: 
 3613: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3614: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3615: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3616: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3617: 
 3618: 
 3619: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3620: 
 3621: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3622:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3623:    if constexpr(ics == 1) { 
 3624:       return 0.5*(n1->tau + n2->tau);
 3625: 
 3626:    } else {
 3627:       // Project the tau from the node frames to the side frame
 3628:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3629:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3630: 
 3631:       return 0.5*(stau1 + stau2);
 3632:    }
 3633: }
 3634: 
 3635: /**
 3636:  * This method performs backtracking from the side center until a time -dt back in time 
 3637:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3638:  * intermediate point.
 3639:  *
 3640:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3641:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3642:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3643:  * remaining time.
 3644:  * 
 3645:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3646:  * 
 3647:  * @param uuint, vvint, wwint: Velocities at the final point
 3648:  * @param jlev: Level at which the backtracking is performed
 3649:  * @param dt, dtbk: Tracking timesteps
 3650:  * @return: True if the backtracking was successful, false otherwise
 3651:  */
 3652: __inline__ __device__ bool Side::btrack(
 3653:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3654:       double dt,            // Tracking time
 3655:       double dtbk,          // Tracking timestep
 3656:       Vector3 &u_int        // Velocities at the initial point
 3657: ) const {
 3658: 
 3659:    // Start from side center
 3660:    Point3 x0;
 3661:    ShapeCoords shpX0;  // x0 in shape coordinates of the current element
 3662: 
 3663:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3664:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3665: 
 3666: 
 3667:    double time_rm = dt; // Remaining time
 3668: 
 3669: 
 3670:    // Initial velocity.
 3671:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3672: 
 3673:    // Find the element that is in the direction opposite to the velocity (or the other element if the opposite element is dry)
 3674:    Element* curElem = findElementTowards(toVector2(u_int));
 3675:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or null");
 3676: 
 3677:    // Compute the shape coordinates of the starting point in the current element knowing it is at a side. This ensures that the zero shape coordinates are strictly 0.0.
 3678:    shpX0 = curElem->computeShapeCoordsForSides(toPoint2(x0), this);
 3679: 
 3680:    const int MAX_ITERATIONS = 200; 
 3681:    Element* nextElem = nullptr;
 3682:    int iter = 0;
 3683:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3684: 
 3685: if (idx == ORIG_SIDE_IDX && jlev == ORIG_SIDE_JLEV) {
 3686:    // showPoints(x0, xt, jlev, this);
 3687:    showPoints(x0, x0 - dtbk*u_int, jlev, this, 0x00FF00, 'x');
 3688: }
 3689: 
 3690:    while(true) {
 3691: 
 3692:       // If the velocity is too small, we stop the backtracking
 3693:       const double vmag = length(toVector2(u_int));
 3694:       if (vmag <= velmin_btrack) return true;
 3695: 
 3696:       // Calculate timestep
 3697:       double dtb = min(dtbk, time_rm);
 3698:         
 3699:       xt = x0 - dtb*u_int;
 3700: if (idx == ORIG_SIDE_IDX && jlev == ORIG_SIDE_JLEV) showPoints(x0, xt, jlev, this);
 3701:       ShapeCoords shpXt;
 3702:       curElem->computeShapeCoords(toPoint2(xt), shpXt, Element::EFixIf::fiNo, this);
 3703: 
 3704:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, shpX0, shpXt, u_int, nextElem, jlev, dtb, time_rm, this);
 3705: 
 3706: 
 3707:       time_rm -= dtb; // time_rm needs to be decreased by the time advanced.
 3708: 
 3709:       // Exit if the remaining time is too small.
 3710:       if (time_rm <= 1.0e-3) break;
 3711:       
 3712: if (idx == ORIG_SIDE_IDX && jlev == ORIG_SIDE_JLEV) showPoints(x0, xt, jlev, this);
 3713:       // The current point becomes the next segment's starting point.
 3714:       x0 = xt;
 3715:       shpX0 = shpXt; 
 3716:       curElem = nextElem;
 3717: 
 3718:       iter++;
 3719: 
 3720: if (iter > 100) printf("btrack: idx = %i, jlev = %d, dtb = %.17f, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), shpX0 = (%.17f, %.17f, %.17f), shpXt = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", idx, jlev, dtb, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, shpX0[0], shpX0[1], shpX0[2], shpXt[0], shpXt[1], shpXt[2], u_int.x, u_int.y, u_int.z);
 3721:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3722: if (iter==110) break; //XXXXX
 3723: 
 3724: 
 3725:    }
 3726: 
 3727: 
 3728:    assert(curElem != nullptr && "Final element is nullptr");
 3729:    assert(!curElem->isDry && "Final element is dry");
 3730: 
 3731: 
 3732:    // Interpolate the velocities at the final point
 3733:    u_int = curElem->interpolateVelocities(shpX0, x0.z);
 3734: 
 3735: 
 3736: }
 3737: 
