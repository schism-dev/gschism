 3750: __device__ void Node::updateKb(void) {
 3751: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3752: 
 3753:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3754: 
 3755: 
 3756:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3757: 
 3758:    if constexpr(ivcor == 2) {  // SZ coordinates
 3759:       
 3760:       // Compute bottom level index
 3761:       if (depth <= mesh->h_s) {
 3762:          kb = izlev;   
 3763:          
 3764:       } else {
 3765:          kb = -1;
 3766:          int L = 0;
 3767:          int R = nzlev; 
 3768:          
 3769:          while (L <= R) {
 3770:             int M = (R + L) / 2;
 3771: 
 3772: 
 3773:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3774:             
 3775:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3776:                R = M;
 3777:             } else {
 3778:                L = M;
 3779:             }
 3780: 
 3781:             if (R - L == 1) {
 3782:                kb = L;
 3783:                break;
 3784:             }
 3785:          }
 3786: 
 3787:          // Checks that the binary search was successful
 3788:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3789:        
 3790:       }
 3791:    } 
 3792: }
 3793: 
 3794: 
 3795: __device__ __inline__ void Node::updateZCoordData(void) {
 3796: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3797: 
 3798:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3799:    // if (isDry2()) {
 3800:    //    kb = -1;  // XXXXXXXX KKKKK
 3801:    //    return;
 3802:    // }
 3803: 
 3804: 
 3805:    if constexpr(ivcor == 2) {  // SZ coordinates
 3806:       
 3807:       // Compute bottom level index
 3808:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3809:    } 
 3810:    else {  // if (ivcor == 1) Localized sigma
 3811:       // Do nothing
 3812:    }
 3813: 
 3814: 
 3815: }
 3816: 
 3817: 
 3818: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3819:    // Computes the z coordinate at level k.
 3820:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3821:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3822:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3823:    // used 
 3824: 
 3825:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3826:    
 3827:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3828: 
 3829:    if (isDry2()) return 0.0;  
 3830: 
 3831:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3832: 
 3833:    if constexpr(ivcor == 2) {
 3834: 
 3835:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3836:       const double h_c = mesh->h_c;
 3837:       const double theta_f = mesh->theta_f;
 3838:       const double sinh_theta_f = mesh->sinh_theta_f;
 3839: 
 3840: 
 3841:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3842:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3843:       // once per time step/node. XXXX
 3844:       // CHECK: updateZCoordData
 3845: 
 3846:       //  To simplify comparisons, I define index versions of count variables.
 3847:       if      (k == ivrt)     return eta2; 
 3848:       else if (k == izlev)    return -hmod2;
 3849:       else if (k == kb)       return -depth;
 3850:       else if (k < izlev)     return mesh->ztot[k];
 3851:       else if (k > izlev) {
 3852:          const int ksig = k - izlev;
 3853: 
 3854:          if (hmod2 <= h_c) {
 3855:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3856: 
 3857:          } 
 3858:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3859:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3860:             assert(false && "compZCoord: invalid h_c\n");
 3861:          } 
 3862:          else {
 3863:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3864:                    h_c * mesh->sigma[ksig] + 
 3865:                    (hmod2 - h_c) * mesh->cs[ksig];
 3866:          }
 3867:       } else { 
 3868:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3869:       }
 3870: 
 3871:    }
 3872:    else {  // if constexpr(ivcor == 1)
 3873:       if (k <= kb)        return -depth; 
 3874:       else if (k == ivrt) return eta2;
 3875:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3876: 
 3877:    }
 3878:    
 3879:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3880:    return 0.0;
 3881: }
 3882: 
 3883: 
 3884: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3885:    // Computes the bottom drag Cd based on the selected nchi
 3886: 
 3887:    if constexpr(nchi == 0) {
 3888:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3889:       Cd = drag;  // Read from drag file
 3890: 
 3891:    } else if constexpr(nchi == 1) {
 3892:       // 
 3893: 
 3894:       bool ltmp = false; // for WBL iteration
 3895: 
 3896:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3897:       if (isDry || (rough == 0.0)) {
 3898:          Cd = 0.0;
 3899: 
 3900:       } else { //roughness >0 
 3901:          
 3902:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3903: 
 3904:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3905: 
 3906:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3907: 
 3908:       } // if rough
 3909: 
 3910:    } else if constexpr(nchi == -1) {
 3911:    // Manning 
 3912:  
 3913:       const double htot = max(hmin_man, htot2()); 
 3914:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3915: 
 3916:    } else {
 3917:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3918:       
 3919:    } // if nchi
 3920: 
 3921: }
 3922: 
 3923: 
 3924: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3925:    // Checks if a side in on the boundary
 3926:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3927: 
 3928:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3929:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3930: 
 3931:    // Indices of the nodes that form the side
 3932:    const int n1 = side.n1->idx;
 3933:    const int n2 = side.n2->idx;
 3934:    isLand = false;
 3935:    
 3936: 
 3937:    // Check if the side is on a land boundary
 3938:    for (int i = 0; i < nland; i++) {
 3939:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3940:          // Consecutive nodes in the land boundary segment
 3941:          const int b1 = ilnd[i + j*nland];
 3942:          const int b2 = ilnd[i + (j + 1)*nland];
 3943: 
 3944:          assert(b1 != -1 && b2 != -1);
 3945: 
 3946:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3947:             
 3948:             isLand = true;
 3949:             return i;
 3950:          }
 3951:       }
 3952:    }
 3953: 
 3954:    // Check if the side is on an open boundary
 3955:    for (int i = 0; i < nope; i++) {
 3956:       for (int j = 0; j < nond[i] - 1; j++) {
 3957:          // Consecutive nodes in the open boundary segment
 3958:          const int b1 = iond[i + j*nope];
 3959:          const int b2 = iond[i + (j + 1)*nope];
 3960: 
 3961:          assert(b1 != -1 && b2 != -1);
 3962: 
 3963:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3964:             isLand = false;
 3965:             return i;
 3966:          }
 3967:       }
 3968:    }
 3969: 
 3970:    return -1;
 3971: }
 3972: 
 3973: 
 3974: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3975:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3976:                                     double *wind_rotate_angle, 
 3977:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3978:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3979:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3980:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3981:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3982: 
 3983:    NODE(pnode);  
 3984:    const int i = idx_node;
 3985:    Node &node(*pnode);
 3986: 
 3987:    node.idx = i;
 3988: 
 3989:    const int idxNodeStart = nodeNeighNodesStart[i];
 3990:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3991:    node.numNodes = idxNodeEnd - idxNodeStart;
 3992:    node.nodes = nodeNeighNodes + idxNodeStart;
 3993:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3994: 
 3995: 
 3996: 
 3997:    const int idxElemStart = nodeNeighElemsStart[i];
 3998:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3999:    node.numElements = idxElemEnd - idxElemStart;
 4000:    node.elements = nodeNeighElems + idxElemStart;
 4001: 
 4002: 
 4003:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 4004:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4005:       const int partNode = localNodePart[idxNodeGlobal]; 
 4006:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4007: 
 4008:       Node *node_ptr = nodes[partNode] + idxNode;
 4009:       
 4010:       nodeNeighNodes[idx] = node_ptr;
 4011:    }
 4012: 
 4013: 
 4014:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 4015:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4016:       const int partElem = localElemPart[idxElemGlobal];
 4017:       const int idxElem  = localElemIndices[idxElemGlobal];
 4018: 
 4019:       Element *elem_ptr = elems[partElem] + idxElem;
 4020: 
 4021:       nodeNeighElems[idx] = elem_ptr;
 4022:    }      
 4023: 
 4024:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4025:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4026:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4027: 
 4028:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4029:    if constexpr(ics == 1) {
 4030:       node.p.x   = node_coords[i * 3];
 4031:       node.p.y   = node_coords[i * 3 + 1];
 4032:       node.gz = 0.0;
 4033: 
 4034:    } else {
 4035:       const double lon = deg2rad*node_coords[i * 3];
 4036:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4037: 
 4038:       Point3 p = computeXYZfromLatLon(lat, lon);
 4039:       node.p = toVector2(p);
 4040:       node.gz = p.z;
 4041:       node.lon = lon;
 4042:       node.lat = lat;
 4043: 
 4044:       #ifdef USE_FRAMES
 4045:       node.setFrame(lat, lon);
 4046:       #endif
 4047: 
 4048: 
 4049:    }
 4050: 
 4051:    node.depth = node_coords[i * 3 + 2];
 4052: 
 4053:    node.numSides = 0;
 4054: 
 4055:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4056:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 4057:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 4058:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 4059:    else assert(false && "populateNodes: selected nchi not implemented.");
 4060:    
 4061:    if constexpr(ivcor == 1) 
 4062:    {  
 4063:       node.kb = kb[i];
 4064:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 4065:    }
 4066: 
 4067:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4068:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4069:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4070: 
 4071:    
 4072:    // Links the node to the boundary information
 4073:    if (isbnd[i] >= 0) {
 4074:      
 4075:       // Get the index of the node boundary
 4076:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4077: 
 4078:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4079:       node.nodeBnd->node = &node;
 4080: 
 4081:       node.nodeBnd->sideBnd1 = nullptr;
 4082:       node.nodeBnd->sideBnd2 = nullptr;
 4083: 
 4084:       if (isbnd[i]>=0) {
 4085: 
 4086:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 4087:          
 4088:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4089:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4090: 
 4091:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4092:          node.nodeBnd->segment->clen  = nan("1");
 4093:          node.nodeBnd->segment->carea = nan("1");
 4094: 
 4095:       }
 4096:    } else {
 4097: 
 4098:       node.nodeBnd = nullptr; // For internal nodes
 4099: 
 4100:       if (isbnd[i] == landSegment) {
 4101:          node.nodeBnd = &landBoundaryNode;
 4102:          node.nodeBnd->segment = &landBoundarySegment;
 4103:       }
 4104:       
 4105:    }
 4106:    
 4107:    // XXXX GAUSSIAN HILL VELOCITIES
 4108:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4109:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4110:          constexpr double rot_per = 3000.0;
 4111:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4112:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4113:       // XXXXX
 4114:    #endif
 4115: 
 4116: }
 4117: 
 4118: 
 4119: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4120:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4121:                                     double *wind_rotate_angle,   
 4122:                                     int *isdel, int *isidenode, int *isbnd,
 4123:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4124:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4125:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4126:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4127:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4128:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4129:                                     double *drag, double *roughness) {
 4130: 
 4131: 
 4132:    SIDE(pside);
 4133:    Side &side(*pside);
 4134:    const int i = idx_side;
 4135: 
 4136:    side.idx = i;  
 4137:    
 4138:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4139:    const double fc   = 2.0*omega_e*sin(sfea0);
 4140:    const double beta = 2.0*omega_e*cos(sfea0);
 4141: 
 4142:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4143: 
 4144:    // finding the pointer to the nodes that form the side
 4145:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4146:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4147: 
 4148:    const int locidx_n1 = localNodeIndices[idx_n1];
 4149:    const int locidx_n2 = localNodeIndices[idx_n2];
 4150:    const int part_n1 =   localNodePart[idx_n1];
 4151:    const int part_n2 =   localNodePart[idx_n2];
 4152: 
 4153:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4154:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4155: 
 4156: 
 4157:    // Counts the number of sides connected to each node
 4158:    side.n1->numSides++;
 4159:    side.n2->numSides++;
 4160: 
 4161:    // Side boundary type
 4162:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4163:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4164: 
 4165:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4166:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4167:    {
 4168:       bool isLand = false;
 4169:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4170:       
 4171:       if (isbs > -1) {
 4172:          // assert(isLand || isbs>=0);
 4173:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4174: 
 4175:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4176: 
 4177:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4178:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4179: 
 4180:          assert (isLand == side.sideBnd->segment->isLand);
 4181: 
 4182:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4183:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4184:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4185: 
 4186:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4187:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4188:          
 4189:          side.sideBnd->side = &side;
 4190: 
 4191:       }
 4192:       else {
 4193:          side.sideBnd = nullptr;
 4194:       }
 4195:    }
 4196:    else 
 4197:    {
 4198:       side.sideBnd = nullptr;
 4199:    }
 4200: 
 4201: 
 4202:    // finding the pointer to the elements that share the side
 4203:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4204:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4205: 
 4206:    if (idx_e1 > -1) {
 4207:       const int locidx_e1 = localElemIndices[idx_e1];
 4208:       const int part_e1 =  localElemPart[idx_e1];
 4209:       side.elems[0] = elems[part_e1] + locidx_e1;
 4210: 
 4211:    }
 4212:    else {
 4213:       side.elems[0] = nullptr;
 4214:    }
 4215: 
 4216:    if (idx_e2 > -1) {
 4217:       const int locidx_e2 = localElemIndices[idx_e2];
 4218:       const int part_e2 =  localElemPart[idx_e2];
 4219:       side.elems[1] = elems[part_e2] + locidx_e2;
 4220:    }
 4221:    else {
 4222:       side.elems[1] = nullptr;
 4223:    }
 4224: 
 4225:    // Compute the center of the side
 4226:    side.center = 0.5*(side.n1->p + side.n2->p);
 4227: 
 4228:    #ifdef USE_FRAMES
 4229:    side.setFrame();
 4230:    #endif
 4231: 
 4232:    // Normal, unitary vector to the side
 4233:    if constexpr(ics == 1) {
 4234:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4235:       side.n = normalize(side.n);
 4236:    }
 4237:    else {
 4238:       // Unit side vector in 3D cartesian coordinates
 4239:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4240:       nSide = normalize(nSide);
 4241: 
 4242:       // It cross product with the unit local z-axis vector (nUp) is the
 4243:       // normal vector we are looking for.
 4244:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4245: 
 4246:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4247:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4248:       side.n = normalize(n2D);      
 4249: 
 4250:    }
 4251: 
 4252:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4253:    side.shapiro = shapiro0;
 4254: 
 4255:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4256:    // XXXX
 4257:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4258:    constexpr double rot_per=3000.0;
 4259:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4260:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4261:    // XXXXX      
 4262:    #endif
 4263:    // Compute the z level at the center of the side
 4264:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4265:    
 4266:    // Compute the length of the side
 4267:    const Vector2 vLen = side.n2->p - side.n1->p;
 4268:    side.len = sqrt(dot(vLen, vLen));
 4269: 
 4270: 
 4271:    // Compute the Coriolis coefficient
 4272: 
 4273:    if constexpr(ncor == -1 || ncor == 0) {
 4274:       side.coriolis = coricoef;
 4275:    }
 4276:    else {
 4277:       const double sphi = side.lat();  // Latitude at the center of the side
 4278: 
 4279:       assert(use_ll && "use_ll must be true when ncor > 0");
 4280: 
 4281:       if constexpr(ics == 1) {
 4282:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4283:       }
 4284:       else { // ics == 2
 4285:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4286:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4287:       }
 4288: 
 4289:    }
 4290: 
 4291: }
 4292: 
 4293: 
 4294: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4295:    double *node_coords, double *node_coords_ll, bool use_ll,
 4296:    double *wind_rotate_angle,   
 4297:    int *isdel, int *isidenode, int *isbnd,
 4298:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4299:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4300:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4301:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4302:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4303:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4304:    double *drag, double *roughness) {
 4305: 
 4306:    ELEM(pelem);
 4307:    Element &elem(*pelem);
 4308:    const int i = idx_elem;
 4309: 
 4310:    elem.idx = i;
 4311: 
 4312:    for (int j = 0; j < i34[i]; j++) {
 4313:       const int idxNode = elnode[i*4 + j];  
 4314:       const int idxSide = elside[i*4 + j];
 4315:       
 4316:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4317:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4318: 
 4319:       // Find the neighboring element  
 4320:       if (elem.sides[j]->elems[0] == &elem) {
 4321:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4322:       }
 4323:       else {
 4324:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4325:       }
 4326:       
 4327:    }
 4328: 
 4329:    elem.i34 = i34[i];
 4330: 
 4331:    // Compute the barycenter of the element and its depth
 4332:    elem.center = {0.0, 0.0};
 4333:    elem.depth = 1e10;
 4334:    for (int j = 0; j < i34[i]; j++) {
 4335: 
 4336:       elem.center += elem.nodes[j]->p/i34[i];
 4337:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4338:    }
 4339: 
 4340:    #ifdef USE_FRAMES
 4341:    elem.setFrame();
 4342:    #endif
 4343: 
 4344:    elem.area = elem.computeSignedArea(); 
 4345:    elem.radius = sqrt(elem.area)/pi; 
 4346:    
 4347:    // Determines which way the normal vector to each side is oriented.
 4348:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4349:    for (int j = 0; j < i34[i]; j++)  
 4350:    {
 4351:       if (elem.sides[j]->elems[0] == &elem) {
 4352:          elem.ssign[j] =  1.0;
 4353:       }
 4354:       else {
 4355:          elem.ssign[j] = -1.0;
 4356:       }
 4357: 
 4358:    }
 4359: 
 4360:   
 4361: 
 4362:    // Derivatives of shape functions
 4363:    //  For ics=2, this is done in the element frame
 4364:    //  For quads, the derivative is evaluated at centroid
 4365:    for (int j = 0; j < elem.i34; j++) {
 4366:       const double area = elem.area;
 4367:       const int id2 = elem.nxq(1 + j);
 4368:       const int id3 = elem.nxq(2 + j);
 4369:       const int id4 = elem.nxq(3 + j);
 4370:       if (elem.isTri()) {
 4371:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4372:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4373:          // da1/dx = (y1 - y2)/(2*area)
 4374: 
 4375:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4376:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4377:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4378: 
 4379:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4380:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4381: 
 4382:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4383: 
 4384:       }
 4385:       else  { // Quad; evaluate at centroid
 4386: 
 4387:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4388:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4389:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4390: 
 4391:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4392:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4393: 
 4394:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4395:       } // if Tri
 4396: 
 4397:    } // for j   
 4398:    
 4399:    
 4400: 
 4401: }
 4402: 
 4403: 
 4404: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4405:                                             double *emo, double *efa, 
 4406:                                             double *umo, double *ufa, 
 4407:                                             double *vmo, double *vfa,
 4408:                                             int *ifltype, int *iettype) {
 4409: 
 4410:    NODE_BND(nodeBnd);
 4411:    const int idx = idx_node_bnd;    
 4412: 
 4413:    nodeBnd->idx = idx;
 4414: 
 4415:    // Need to find the segment index and the index of the node on the segment
 4416:    int idxNode = -1;
 4417:    int iseg, i;
 4418:    for (iseg = 0; iseg < nope; iseg++) {
 4419:       // for each segment...
 4420:       for (i = 0; i < nond[iseg]; i++) {
 4421:          idxNode = iond[iseg + i*nope];
 4422:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4423:          
 4424:       }
 4425:    }
 4426: 
 4427:    assert(iseg < nope && "iseg is out of bounds");
 4428: 
 4429: found: // Jumped here when the node was found
 4430: 
 4431:    nodeBnd->isEssentialBC = true;
 4432:    nodeBnd->elbc = 0.0;
 4433: 
 4434:    nodeBnd->segment->ifltype = ifltype[iseg];
 4435:    nodeBnd->segment->iettype = iettype[iseg];
 4436: 
 4437:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4438: 
 4439:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 4440:       nodeBnd->efa[jfr] = efa[idx2];
 4441:       nodeBnd->emo[jfr] = emo[idx2];
 4442:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4443:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4444: 
 4445:    }
 4446:         
 4447: 
 4448: }
