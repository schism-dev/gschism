 1888:    template<typename T>
 1889:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 1890:       // Get the values of the field at the nodes of the element
 1891:       res[0] = nodes[0]->*field;
 1892:       res[1] = nodes[1]->*field;
 1893:       res[2] = nodes[2]->*field;
 1894:       if (isQuad()) res[3] = nodes[3]->*field;
 1895:       else          res[3] = T();
 1896:    }
 1897: 
 1898:    template<typename T>
 1899:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 1900:       // Get the values of the field at the nodes of the element
 1901:       res[0] = (nodes[0]->*field)[level];
 1902:       res[1] = (nodes[1]->*field)[level];
 1903:       res[2] = (nodes[2]->*field)[level];
 1904:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
 1905:       else          res[3] = T();
 1906:    }    
 1907: 
 1908:    template<typename T>
 1909:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 1910:       // Get the values of the func at the nodes of the element
 1911:       res[0] = (nodes[0]->*func)(level);
 1912:       res[1] = (nodes[1]->*func)(level);
 1913:       res[2] = (nodes[2]->*func)(level);
 1914:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
 1915:       else          res[3] = T();  // This is 0.0 or a zero vector
 1916: 
 1917:    }      
