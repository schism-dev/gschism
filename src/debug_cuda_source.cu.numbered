 4058:    __global__ void computeFlowBcVelocities(double time) {
 4059: 
 4060:       SIDE_BND(sideBnd);
 4061: 
 4062:       const Side *side = sideBnd->side;
 4063:  
 4064:       const bool isDry = side->isDry;
 4065: 
 4066:       if (isDry) {
 4067:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4068:          return;
 4069:       }
 4070: 
 4071:       // For wet sides in open boundaries...
 4072:       const Vector2 n = side->n;
 4073:       const BoundarySegment *segment = sideBnd->segment;
 4074: 
 4075:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4076: 
 4077:       const int ifltype = segment->ifltype;
 4078:       const int iettype = segment->iettype;
 4079: 
 4080:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4081:       const Vector2 r_nuth0 = r_uth0*n;
 4082: 
 4083: 
 4084: printf("ZZZ4  idx = %d, ifltype = %d, r_nuth0 = %f, %f\n", sideBnd->side->idx, ifltype, r_nuth0.x, r_nuth0.y);
 4085:       for (int k = 0; k < nvrt; k++) {
 4086:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4087:          Vector2 r_u1_bar = {0.0, 0.0};
 4088:       
 4089:          if (ifltype == 1 || ifltype == 2) {
 4090:          
 4091:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4092: 
 4093:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4094:             
 4095:             r_uth = unth0*n;  // This case has no ramp-up
 4096:             
 4097:          } else if (ifltype == -1) { // Flather 1
 4098: 
 4099:             // uth is the normal vel.; no ramp up
 4100:             const double uth = sideBnd->nuth(k);
 4101:             r_uth = uth*n;
 4102:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4103: 
 4104: 
 4105:          } else if (ifltype == 3 || ifltype == 5) {
 4106:             // vnth0=0 !normal vel.
 4107: 
 4108: printf("ZZZ3  idx = %d, jfr = %d, ifltype = %d, r_uth = %f, %f\n", sideBnd->side->idx, nbfr, ifltype, r_uth.x, r_uth.y);
 4109:             // Computes the contribution to the velocity from all tide frequencies
 4110:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4111: 
 4112:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4113:                const Vector2 umo  = sideBnd->umo(jfr); 
 4114: 
 4115:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4116:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4117:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4118:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4119: printf("ZZZ2  idx = %d, jfr = %d, ncyc = %d, face = %f, argx = %f, argy = %f, umo = %f, %f, ufa = %f, %f, ramp = %f, ff = %f, r_u1_bar = %e, %e\n", sideBnd->side->idx, jfr, ncyc, face[jfr], argx, argy, umo.x, umo.y, ufa.x, ufa.y, ramp, ff[jfr], r_u1_bar.x, r_u1_bar.y);               
 4120:             }
 4121: 
 4122:          } // if (ifltype = 3 || ifltype == 5
 4123: 
 4124: 
 4125:          switch (iettype) {
 4126:             case 1:
 4127:             case 2:
 4128:             case 4:
 4129:                sideBnd->ubc[k] = r_uth;
 4130:                break;
 4131:             case 3:
 4132:                sideBnd->ubc[k] = r_u1_bar;
 4133:                break;
 4134:             case 5:
 4135:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4136:                break;
 4137:          } // switch
 4138: 
 4139: printf("ZZZ  idx = %d, iettype = %d, r_u1_bar = %f, %f, sideBnd->ubc[%d] = %f, %f\n", sideBnd->side->idx, iettype, r_u1_bar.x, r_u1_bar.y, k, sideBnd->ubc[k].x, sideBnd->ubc[k].y);
 4140:       } // for k
 4141:    }
 4142: 
 4143:    __global__ void computeElevationBoundaryConditions(double time) {
 4144:       // Compute elevation essential boundary conditions 
 4145: 
 4146:       NODE_BND(nodeBnd); // Each boundary node.
 4147: 
 4148:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4149: 
 4150:       const Node *node = nodeBnd->node;
 4151:       const BoundarySegment *segment = nodeBnd->segment;
 4152:       const int iettype = segment->iettype;
 4153:       
 4154: 
 4155:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4156:       double eic = 0.0;
 4157:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4158:       else                 eic = 0.0;
 4159: 
 4160:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4161:       const double r_eth = ramp*nodeBnd->eth;
 4162:       double r_eta1_bar = 0.0;
 4163: 
 4164: 
 4165:       // Compute tide elevation
 4166:       if (iettype == 3 || iettype == 5) {   
 4167: 
 4168:          if constexpr(iloadtide==1) { // loading tide
 4169:             assert(false && "Loading tide not implemented");
 4170:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4171:          }
 4172:          
 4173:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4174: 
 4175:             const double efa  = nodeBnd->efa[jfr]; 
 4176:             const double emo  = nodeBnd->emo[jfr]; 
 4177: 
 4178:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4179:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4180:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4181: 
 4182:          } // for jfr
 4183: 
 4184:       } // if iettype
 4185: 
 4186:       switch (iettype) {
 4187:          case 1:
 4188:          case 2:
 4189:          case 4:
 4190:             nodeBnd->elbc = r_eic + r_eth;
 4191:             break;
 4192:          case 3:
 4193:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4194:             break;
 4195:          case 5:
 4196:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4197:             break;
 4198:       } // switch
 4199: 
 4200: 
 4201:       //Add inverse barometric effects
 4202:       if (iettype != 0 && inv_atm_bnd == 1) {
 4203:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4204:       }
 4205: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 4206:    }
 4207: 
 4208: 
 4209:    __global__ void computeHorizontalViscosity(void) { 
 4210: 
 4211:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4212: 
 4213:       SIDE(side);
 4214: 
 4215:       if (side->isDry) return;
 4216: 
 4217:       for (int k = 0; k < nvrt; k++) {
 4218:          side->nuGradU[k] = {0.0, 0.0};
 4219:       }
 4220: 
 4221:       if constexpr(ihorcon == 1) {
 4222:          for (int k = side->kb; k < nvrt - 1; k++) {
 4223:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4224:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4225:             // By Zhang and Baptista.
 4226: 
 4227:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4228:             // This is a standard discretization of the Laplacian operator.
 4229:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4230:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4231:             // Gamma is hvis_coef0 in the code.
 4232:             // The value of gamma needs to be < 0.5.
 4233: 
 4234:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4235:             // side under consideration in each of the two possible elements that share the side.
 4236:             Vector2 sumU = {0.0, 0.0};
 4237:             for (int l = 0; l < 2; l++) {
 4238:                const Element *elem = side->elems[l];
 4239: 
 4240:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4241: 
 4242:                // Find the local index of the side in the element
 4243:                const int idxSide = elem->sideLocalIdx(side);
 4244:                // Find the two sides that are connected to the side under consideration
 4245:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4246:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4247: 
 4248:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4249: 
 4250:             }
 4251: 
 4252:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4253:    printf("+++++ side->nuGradU = %f, %f\n", side->nuGradU[k].x, side->nuGradU[k].y);
 4254: 
 4255:    
 4256:          }
 4257:       }
 4258:       else if constexpr(ihorcon == 2) {
 4259:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4260:       }
 4261: 
 4262: 
 4263:    }
 4264: 
 4265: 
 4266:    __global__ void setEssentialBC(void) {
 4267:       // Set essential boundary conditions 
 4268:       NODE(node); // Each boundary node
 4269:       NodeBoundary *nodeBnd = node->nodeBnd;
 4270: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 4271:       
 4272: // nodeBnd->isEssentialBC = true;      
 4273:       // Check if this node has essential BC
 4274:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4275:          // Verify BC value is valid
 4276:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4277: 
 4278:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 4279:          
 4280:          // Set diagonal to 1 and zero off-diagonals
 4281:          node->coeffDiag = 1.0;
 4282:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 4283: 
 4284:          for (int j = 0; j < node->numNodes; j++) {
 4285:                node->coeffMatrix[j] = 0.0;
 4286:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4287:          }
 4288:          
 4289:          // Set solution and RHS to BC value
 4290:          node->mX  = nodeBnd->elbc;
 4291:          node->qel = nodeBnd->elbc;
 4292: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 4293:       } else {
 4294:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4295: 
 4296:          for (int j = 0; j < node->numNodes; j++) {
 4297:                Node* nbNode = node->nodes[j];
 4298:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4299:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4300:                   // Verify neighbor's BC value
 4301:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4302: 
 4303:                   // Subtract contribution to RHS
 4304:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4305:                   node->coeffMatrix[j] = 0.0;  
 4306:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4307:                }
 4308:          }
 4309:       }
 4310:    }
 4311: 
 4312: 
 4313:    __global__ void updateElevation(void) {
 4314:       NODE(node);
 4315: 
 4316:       node->eta2 = node->mX;
 4317: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 4318:    }
 4319: 
