 7834:          *sizeType = sizeof(int);
 7835:          break;            
 7836:       // case (int)VarCode::w:
 7837:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7838:       //    *sizeType = sizeof(double);
 7839:       //    break;
