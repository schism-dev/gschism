 1963: __device__ void lock(int *mutex) {
 1964:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1965: }
 1966: 
 1967: __device__ void unlock(int *mutex) {
 1968:     atomicExch(mutex, 0);
 1969: }
