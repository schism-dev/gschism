 2531: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2532:    // Returns the value of the velocity at the side center
 2533:    const double w1 = getBoundaryArrayValueWeight();
 2534:    const double w2 = 1.0 - w1;
 2535:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2536:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2537: 
 2538:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2539: }
