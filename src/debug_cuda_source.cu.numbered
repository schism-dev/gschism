  269: 
  270: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  271:     return make_double3(v.x / s, v.y / s, v.z / s);
  272: }
  273: 
  274: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  275:     return v.x*w.x + v.y*w.y + v.z*w.z;
  276: }
  277: 
  278: __device__ __forceinline__ double norm2(const double3& v) {
  279:     return v.x*v.x + v.y*v.y + v.z*v.z;
  280: }
  281: 
  282: __device__ __forceinline__ Vector2 toVector2(const double3& v) {
  283:     return make_double2(v.x, v.y);
  284: }
  285: 
  286: __device__ __forceinline__ double3 toVector3(const double2& v, double w) {
