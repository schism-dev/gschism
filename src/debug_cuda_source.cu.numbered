 5350: extern "C" {
 5351: 
 5352:    __global__ void scaleGravity(double loadtide_coef) {
 5353: 
 5354: 
 5355:       NODE(node);
 5356: 
 5357:       // SAL option: scale gravity
 5358:       if constexpr(iloadtide==2) {  // simple const
 5359:          node->grav2 = grav*(1.0 - loadtide_coef);
 5360: 
 5361:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5362:         
 5363:           const double depth = max(node->depth, 0.0);
 5364:           const double tmp1 = sqrt(depth);
 5365:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5366:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5367:                              2.6969e-13*depth*depth*depth*tmp1;
 5368:           
 5369:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5370:           
 5371: 
 5372: 
 5373:           node->grav2 = grav*(1.0 - beta_bar);
 5374: 
 5375:       } else {  // iloadtide=0,1
 5376:           node->grav2 = grav;
 5377: 
 5378:       }
 5379: 
 5380:    }
 5381: 
