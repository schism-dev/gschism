 8107: __global__ void returnMatrix(double *res) {
 8108:    // Debugging: returns the matrix as a CuPy array
 8109: 
 8110:    const int size = mesh->np;
 8111:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8112:       const Node *node = mesh->localNodeData + idx_node;
 8113:       res[idx_node*size + idx_node] = node->coeffDiag;
 8114:       for (int j = 0; j < node->numNodes; j++) {
 8115:          Node* nbNode = node->nodes[j];
 8116:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8117:       }
 8118: 
 8119:    }
 8120:    
 8121: }
 8122: 
 8123: __global__ void returnX(double *res) {
 8124:    // Debugging: returns the matrix as a CuPy array
 8125: 
