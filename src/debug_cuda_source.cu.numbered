 3132: __device__ double Element::intPhiPhiQuad(int i1, int i2) const {
 3133:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3134:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3135:    // The formula for the integral is:
 3136:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3137: 
 3138:    printf("intPhiPhi: TEST\n");
 3139: 
 3140:    const Node *n0 = nodes[0];
 3141:    const Node *n1 = nodes[1];
 3142:    const Node *n2 = nodes[2];
 3143:    const Node *n3 = nodes[3];
 3144: 
 3145:    const Vector2 p0 = n0->p;
 3146:    const Vector2 p1 = n1->p;
 3147:    const Vector2 p2 = n2->p;
 3148:    const Vector2 p3 = n3->p;
 3149: assert(false && "intPhiPhiQuad:CHECK?");
 3150: 
 3151:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 3152:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 3153:    double eta_sum  = iet_n[i1] + iet_n[i2];
 3154:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 3155: 
 3156:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 3157: }
 3158:    
 3159: 
 3160: __device__ double Element::intGradPhiGradPhiQuad(int i1, int i2) const {
 3161:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3162:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3163:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3164:    // The formula is also based on the identity:
 3165:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3166:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3167: 
 3168:    printf("intGradPhiGradPhi: TEST\n");   
 3169: assert(false && "intGradPhiGradPhi:Do ICS==2");
 3170:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 3171: 
 3172:    const double x0 = nodes[0]->p.x;
 3173:    const double y0 = nodes[0]->p.y;
 3174:    const double x1 = nodes[1]->p.x;
 3175:    const double y1 = nodes[1]->p.y;
 3176:    const double x2 = nodes[2]->p.x;
 3177:    const double y2 = nodes[2]->p.y;
 3178:    const double x3 = nodes[3]->p.x;
 3179:    const double y3 = nodes[3]->p.y;
 3180: 
 3181:    double res = 0.0;
 3182:    
 3183:    // Quadrature points in xi and eta coordinates
 3184:    #pragma unroll
 3185:    for (int i = 0; i < 4; i++) {
 3186:       // For each quadrature point...
 3187: 
 3188:       const Point2 p = GaussPoint(i);
 3189:       const double eta = p.x;
 3190:       const double xi  = p.y;
 3191: 
 3192:       // Jacobian entries at the Gauss point p
 3193:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 3194:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 3195:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 3196:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 3197: 
 3198:       const double detJ = jacobianDet(p);
 3199:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3200: 
 3201:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3202:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3203:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3204:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3205:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3206: 
 3207:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3208:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3209:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3210:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3211:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3212: 
 3213:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3214:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3215:    }
 3216: 
 3217:    return res;
 3218: }
 3219: 
 3220: 
 3221: /**  Interpolate velocities at a given point (xt,yt,zt)
 3222: 
 3223:    @param xt, yt, zt: coordinates of the point to interpolate
 3224:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3225: 
 3226:    This is done in four steps:
 3227: 
 3228:    1. Find the shape coordinates for the final position in the element.
 3229:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3230:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3231:       z levels at xt, yt at each step.   
 3232:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3233:       horizontally and vertically.
 3234: **/
 3235: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3236:    // Interpolate the velocities at the point xt. 
 3237:    // This function works the same for triangular and quadrilateral elements.
 3238:    double shpCoord[4];
 3239:    Vector3 u_int;
 3240: 
 3241:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa (6)");
 3242: 
 3243:    // First step is to compute the shape coordinates of (xt,yt)
 3244: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3245:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3246: 
 3247:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3248: 
 3249:    // Second step is to find the level that contains zt
 3250:    // Uses a binary search to find the level
 3251:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3252:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3253:    int R = nvrt - 1;
 3254: 
 3255:    // Get the z coordinates at the nodes of the element at the levels L and R
 3256:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3257:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3258:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3259: 
 3260: 
 3261:    double zL = interpolate(shpCoord, zLAtNodes);
 3262:    double zR = interpolate(shpCoord, zRAtNodes);
 3263: 
 3264:    // Interpolates vertically the velocities
 3265:    double wght1, wght2;
 3266:    if (xt.z<=zL) {
 3267:       wght1 = 1.0;
 3268:       wght2 = 0.0;
 3269:       xt.z = zL;
 3270:    }
 3271:    else if (xt.z>=zR) {
 3272:       wght1 = 0.0;
 3273:       wght2 = 1.0;
 3274:       xt.z = zR;
 3275:    }
 3276:    else {
 3277:       // Perform a binary search to find the levels between L and R that contain xt.z
 3278:       while (R - L > 1) {
 3279:          int M = (L + R) / 2.0;
 3280: 
 3281:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3282:          double zM = interpolate(shpCoord, zMAtNodes);
 3283:          if (zM < xt.z) 
 3284:          {
 3285:             L = M;
 3286:             zL = zM;
 3287:          }
 3288:          else 
 3289:          {
 3290:             R = M;
 3291:             zR = zM;
 3292:          }
 3293:       }
 3294:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3295:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3296: 
 3297:       wght2 = (xt.z - zL)/(zR - zL);
 3298:       wght1 = 1.0 - wght2;
 3299: 
 3300:    }
 3301: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3302: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3303:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3304:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3305:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3306:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3307: 
 3308:    // Project the velocity from the local frame to the origSide frame
 3309:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3310:    u_int = {uv.x, uv.y, w};
 3311: 
 3312:    // Neither of the interpolated velocities should be NaN
 3313:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3314: 
 3315:    return u_int;
 3316: 
 3317: }
 3318: 
 3319: 
 3320: 
 3321: 
 3322: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3323: 
 3324:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3325:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3326:    const Node *n1 = side->n1;
 3327:    const Node *n2 = side->n2;
 3328: 
 3329:    bool n1_match = (n1->nodeBnd->segment == segment);
 3330:    bool n2_match = (n2->nodeBnd->segment == segment);
 3331: 
 3332:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3333:    if (n1_match && n2_match) {
 3334:       return 0.5;
 3335:    } else if (n1_match) {
 3336:       return 1.0;
 3337:    } else if (n2_match) {
 3338:       return 0.0;
 3339:    }
 3340: 
 3341:    return 0.0;
 3342: }
 3343: 
 3344: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3345: 
 3346: 
 3347: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3348: 
 3349:    const double w1 = getBoundaryArrayValueWeight();
 3350:    const double w2 = 1.0 - w1;
 3351:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3352:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3353: 
 3354:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3355: }
