 3392: 
 3393: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3394:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3395:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3396: 
 3397: 
 3398:    NODE(node1);
 3399: 
 3400:    node1->clearMatrixRow();
 3401:    node1->qel = 0.0;
 3402: 
 3403:    // THIS IS FOR STRUCTURES XXX
 3404:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3405: 
 3406:    
 3407:    for (int j=0; j<node1->numElements; j++) {
 3408:       // For each element connected to the node...
 3409: 
 3410:       Element *elem = node1->elements[j];
 3411: 
 3412: // if (elem->isDry) continue;  /// XXXX KKKKKK NOT IN THE ORIGINAL CODE
 3413: 
 3414: 
 3415:       // Compute the average gravity
 3416:       const double grav3 = elem->mean(&Node::grav2);
 3417: 
 3418:       // Look at the documentation for the description of the terms in the following integrals
 3419: 
 3420:       // Integral I_1 
 3421:       // \bar{\breve{H}} 
 3422:       const double hhatb = elem->mean(&Side::hhat);        
 3423: 
 3424:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3425: 
 3426:       const int id1 = elem->nodeLocalIdx(node1); 
 3427:       const double area = elem->area;
 3428: 
 3429:       if (elem->isTri()) {
 3430: 
 3431:          // To clarify the notation in this section: 
 3432:          //   i stands for the node under consideration (node1)
 3433:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3434:          const int id2 = elem->nxq(1 + id1);
 3435:          const int id3 = elem->nxq(2 + id1);
 3436:          Node *node2 = elem->nodes[id2];
 3437:          Node *node3 = elem->nodes[id3];
 3438: 
 3439:          const Point2 x1 = node1->p;
 3440:          const Point2 x2 = node2->p;
 3441:          const Point2 x3 = node3->p;
 3442: 
 3443:          // integral of phi_i*phi_j
 3444:          const double ipp_ii = (1.0/6.0 )*area;
 3445:          const double ipp_ij = (1.0/12.0)*area;
 3446:          const double ipp_ik = (1.0/12.0)*area;
 3447: 
 3448:          // integral of [(grad phi_i) * (grad phi_j)]
 3449:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3450:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3451:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3452: 
 3453:          // Computes the different components of integral I_1 of each node with respect to node i.
 3454:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3455:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3456:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3457: 
 3458:          node1->addToSparseMatrix(node1, I1_ii);
 3459:          node1->addToSparseMatrix(node2, I1_ij); 
 3460:          node1->addToSparseMatrix(node3, I1_ik);
 3461: 
 3462:       }
 3463:       else { // Quad
 3464:          // XXX IMPLEMENT THIS
 3465:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3466: 
 3467:          // To clarify the notation in this section: 
 3468:          //   i stands for the node under consideration (node1)
 3469:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3470:          const int id2 = elem->nxq(1 + id1);
 3471:          const int id3 = elem->nxq(2 + id1);
 3472:          const int id4 = elem->nxq(3 + id1);
 3473:          Node *node2 = elem->nodes[id2];
 3474:          Node *node3 = elem->nodes[id3];
 3475:          Node *node4 = elem->nodes[id4];         
 3476: 
 3477:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3478:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3479:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3480:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3481:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3482: 
 3483:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3484:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3485:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3486:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3487:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3488: 
 3489:          // Computes the different components of integral I_1 of each node with respect to node i.
 3490:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3491:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3492:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3493:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3494: 
 3495:          node1->addToSparseMatrix(node1, I1_ii);
 3496:          node1->addToSparseMatrix(node2, I1_ij); 
 3497:          node1->addToSparseMatrix(node3, I1_ik);
 3498:          node1->addToSparseMatrix(node4, I1_il);
 3499:   
 3500:       } 
 3501: 
 3502:  
 3503:       // Integral I_4
 3504:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3505:       // Where
 3506:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3507: 
 3508:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3509:       // of U over the element.
 3510:       Vector2 U = {0.0, 0.0};
 3511:       for (int m=0; m < elem->i34; m++) {      
 3512:          const Side *side = elem->sides[m];
 3513: 
 3514:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3515:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3516:       }
 3517:       U = U/elem->i34;
 3518: 
 3519: 
 3520:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3521: 
 3522: 
 3523:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3524:       const double I_4_1 = dot(gradPhi_1, U);
 3525: 
 3526: 
 3527:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3528:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3529: 
 3530:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3531: 
 3532:       // Additional terms 
 3533:       double vnorm = 0.0;
 3534:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3535:          Vector3 ubed = {0.0, 0.0, 0.0};
 3536:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3537: 
 3538:          Vector3 gradP = {0.0, 0.0, 1.0};
 3539:          for (int m=0; m < elem->i34; m++) {
 3540:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3541:            gradP += toVector3(gradP_2D, 0.0);
 3542:          }   
 3543:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3544:       } // imm==2
 3545: 
 3546:       if (elem->isTri()) {
 3547:          for (int l=0; l<3; l++) {
 3548: 
 3549:             Node *node = elem->nodes[l];
 3550: 
 3551:             double fac = (node == node1) ? 2.0 : 1.0;
 3552:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3553:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3554:            
 3555:          }
 3556: 
 3557: 
 3558:          if (!elem->isDry) {
 3559:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3560: 
 3561:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3562: 
 3563:          }
 3564: 
 3565:       } // isTri
 3566:       else { // isQuad
 3567:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3568:          // for (int l=0; l<4; l++) {
 3569:          //   const Node *node = elem->nodes[l];
 3570: 
 3571:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3572:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3573: 
 3574:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3575:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3576:          // }
 3577: 
 3578:       } // isQuad
 3579: 
 3580: 
 3581:      node1->qel += (dt/elem->i34)*elem->vsource;
 3582:       
 3583: 
 3584:    } // for all elements connected to the node
 3585:    
 3586: 
 3587:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3588:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3589:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3590:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3591:       // If it is an open boundary node...
 3592: 
 3593:       // At least one open bnd side, maybe two
 3594:       for (int l=0; l<2; l++) { 
 3595: 
 3596:          // Gets each of the sides sharing the node. 
 3597:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3598: 
 3599:        
 3600: 
 3601:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3602:          if (sideBnd != nullptr) {
 3603:             // If the side is on a boundary...
 3604: 
 3605:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3606: 
 3607:             // Get the boundary segment
 3608:             const BoundarySegment *sideSegment = sideBnd->segment;
 3609:             const Side *side = sideBnd->side;
 3610: 
 3611:             // Integral I_3
 3612:             if (sideSegment->ifltype != 0) {
 3613:             // Natural or Flather b.c.
 3614: 
 3615:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3616:                // especially for Flather b.c.
 3617:                double ri3 = 0.0;
 3618:                if (!side->isDry) {
 3619:                   // If the side is not dry
 3620:                   
 3621:                   // Computes the side flux of (uth, vth)
 3622:                   double Vn = 0.0;
 3623:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3624:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3625:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3626: 
 3627:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3628:                   }
 3629: 
 3630:                   ri3 = 0.5*side->len*Vn;
 3631:                }
 3632: 
 3633:                if (sideSegment->ifltype == -1) { // Flather 1
 3634: 
 3635:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3636:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3637: 
 3638:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3639:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3640:                   
 3641:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3642:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3643: 
 3644:                } 
 3645:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3646:                   // Reset ri3
 3647:                   ri3 = 0.0;
 3648: 
 3649:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3650: 
 3651:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3652: 
 3653:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3654:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3655: 
 3656:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3657:                   node1->addToSparseMatrix(node1, con0*2.0);
 3658:                   node1->addToSparseMatrix(node2, con0);
 3659: 
 3660:                } // if Flather or Discharge
 3661: 
 3662:                node1->qel -= thetai*dt*ri3;
 3663: 
 3664: 
 3665:             } // I_3
 3666:           
 3667: 
 3668:             // Integral I_5
 3669:             if(!side->isDry) {
 3670: 
 3671:                const double Unbar = dot(side->U, side->n);
 3672:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3673: 
 3674:             } // I_5
 3675: 
 3676:          } // if is boundary side
 3677: 
 3678:       } // for l
 3679: 
 3680:    } // if isbnd
 3681: 
 3682: 
 3683: }
 3684: 
 3685: 
 3686: 
 3687: extern "C" {
 3688:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3689:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3690:                                   int* indices, int* indptr) {
 3691: 
 3692:       NODE(node);
 3693:       
 3694:       const int idx = node->idx;
 3695:       
 3696:       // Computes the index in the nzz array      
 3697:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3698: 
 3699: 
 3700:       indptr[idx] = nzzIdx;
 3701:       indices[nzzIdx] = idx;
 3702: 
 3703:       data_d[nzzIdx]    = node->coeffDiag;
 3704:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3705: 
 3706:       diag_d[idx] = 1.0/node->coeffDiag;
 3707:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3708: 
 3709:       b_d[idx] = node->qel;
 3710:       b_f[idx] = (float)node->qel;
 3711: 
 3712:       for (int k = 0; k < node->numNodes; ++k) {
 3713:          const Node* nb = node->nodes[k];
 3714: 
 3715:          const int j = nb->idx;
 3716: 
 3717:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3718:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3719: 
 3720:          indices[nzzIdx + k + 1] = j;
 3721:       }
 3722: 
 3723: 
 3724:    }
