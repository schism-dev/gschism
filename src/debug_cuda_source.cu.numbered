10077:          break;
10078:       case (int)VarCode::isdry:
10079:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
10080:          *sizeType = sizeof(int);
10081:          break;            
10082:       // case (int)VarCode::w:
10083:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
10084:       //    *sizeType = sizeof(double);
10085:       //    break;
10086:       case (int)VarCode::u:
10087:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
10088:          *sizeType = sizeof(Vector2);
10089:          break;   
10090:       case (int)VarCode::btu:
10091:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
10092:          *sizeType = sizeof(Vector2);
10093:          break;          
10094:       case (int)VarCode::U:
10095:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
10096:          *sizeType = sizeof(Vector2);
