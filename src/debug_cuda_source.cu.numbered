 1911: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 1912:    // "Local" here means that the coordinates are in a frame where the element is horizontal.
 1913: 
 1914:    assert(idxNode < i34 && "getLocalHorizontalNodePosition: idxNode out of range");
 1915: 
 1916:    if constexpr(ics==1) {
 1917:       return nodes[idxNode]->p;
 1918:    } else {
 1919:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 1920: 
 1921:       const Point3 p = toPoint3(nodes[idxNode]->p, nodes[idxNode]->gz); // XXXXX use p3D or similar?
 1922: 
 1923:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points at the local frame centered at c
 1924:    }
 1925: 
 1926: }
 1927: 
 1928: 
 1929: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2) const {
 1930: // "Local" here means that the coordinates are in a frame where the element is horizontal.
 1931: 
 1932:    assert(!isQuad() && "getLocalHorizontalNodePositions only works for triangles");
 1933: 
 1934:    if constexpr(ics==1) {
 1935:       x0 = nodes[0]->p;
 1936:       x1 = nodes[1]->p;
 1937:       x2 = nodes[2]->p;
 1938: 
 1939:    } else {
 1940:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 1941: 
 1942:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 1943:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 1944:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 1945: 
 1946:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 1947:       x1 = toVector2(frame.G2L(p1 - c));
 1948:       x2 = toVector2(frame.G2L(p2 - c));
 1949:    }
 1950: 
 1951: }
 1952: 
 1953: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 1954: // "Local" here means that the coordinates are in a frame where the element is horizontal. 
 1955: 
 1956:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 1957: 
 1958:    if constexpr(ics==1) {
 1959:       x0 = nodes[0]->p;
 1960:       x1 = nodes[1]->p;
 1961:       x2 = nodes[2]->p;  
 1962:       x3 = nodes[3]->p;
 1963: 
 1964:    } else {
 1965:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 1966: 
 1967:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 1968:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 1969:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 1970:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 1971: 
 1972:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 1973:       x1 = toVector2(frame.G2L(p1 - c));
 1974:       x2 = toVector2(frame.G2L(p2 - c));
 1975:       x3 = toVector2(frame.G2L(p3 - c));
 1976:    }
 1977: 
 1978: }
