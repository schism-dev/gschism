  195: // eta coordinates of the nodes (idxNode = 0,1,2,3)
  196: __device__ __forceinline__ double eta_n(int idxNode) {
  197:    // bit1: 0 -> -1, 1 -> +1
  198:    assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  199:    return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  200: }
  201: 
  202: // xi coordinates of the nodes (idxNode = 0,1,2,3)
  203: __device__ __forceinline__ double xi_n(int idxNode) {
  204:    // +1 if (bit0 XOR bit1), else -1
  205:    assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  206:    return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  207: 
  208: }
