 9494: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 9495:    Node *nodes = mesh->localNodeData;
 9496: 
 9497:    *addr = nodes;
 9498:    *sizeNode = sizeof(Node);
 9499: 
 9500:    switch (varCode) {
 9501:       case (int)VarCode::depth:
 9502:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 9503:          *sizeType = sizeof(double);
 9504:          break;
 9505:       case (int)VarCode::eta:
 9506:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 9507:          *sizeType = sizeof(double);
 9508:          break;
 9509:       case (int)VarCode::x:
 9510:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 9511:          *sizeType = sizeof(Vector2);
 9512:          break;
 9513:       case (int)VarCode::z:
 9514:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 9515:          *sizeType = sizeof(double);
 9516:          break;
 9517:       case (int)VarCode::kb:
 9518:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 9519:          *sizeType = sizeof(int);
 9520:          break;
 9521:       case (int)VarCode::isdry:
 9522:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 9523:          *sizeType = sizeof(int);
 9524:          break;         
 9525:       case (int)VarCode::w:
 9526:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 9527:          *sizeType = sizeof(double);
 9528:          break;
 9529:       case (int)VarCode::u:
 9530:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 9531:          *sizeType = sizeof(Vector2);
 9532:          break;  
 9533:       case (int)VarCode::u_air:
 9534:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 9535:          *sizeType = sizeof(Vector2);
 9536:          break;
 9537:       default:
 9538:          *offset = -1;    
 9539:    }  
 9540:    
 9541: }
