 2349:    template<typename T>
 2350:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2351: 
 2352:       T values[4];
 2353: 
 2354: 
 2355:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2356:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2357:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
