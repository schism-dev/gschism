 8177: #ifdef DONTCOMPILE
 8178: __device__ void computeVerticalAdvection(void) {
 8179:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8180: 
 8181:    sdbt(1:2,:,:)=0.d0
 8182: 
 8183:    const Side *side = FROM kernel;
 8184: 
 8185:    if(side->isDry) return;
 8186: 
 8187:    // If side is wet...
 8188: 
 8189: 
 8190:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8191:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8192:    double ws[nvrt] = {} // w @ side
 8193:    int icount = 0;
 8194:    for (int j=0; j<2; j++) {
 8195:       const Element *elem = side->elements[j];
 8196:        
 8197:       if(elem != nullptr) {
 8198:          icount++;
 8199:          for (int k=0; k<nvrt; k++) {
 8200:             ws[k] = ws[k] + elem->w[k];
 8201:          }
 8202:       }
 8203:    }  // for j
 8204: 
 8205:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8206:    ws = ws/icount;
 8207: 
 8208:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8209:    // Splines allow for a smooth transition between vertical levels.
 8210:    // Splines have continuity restrictions at the internal knots, but
 8211:    // we have to provide the 1st derivatives at the endpoints.
 8212:    const int kbs = side->kbs; 
 8213:    
 8214:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8215:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8216:    initCubicSpline(kbs, nvrt, side, ws, up)
 8217: 
 8218:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8219:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8220:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8221: 
 8222:    // Total advection (average onto side)
 8223:    const Node *node1 = side->nodes[0];
 8224:    const Node *node2 = side->nodes[1];
 8225:    for (int k=kbs(i); k<nvrt; k++) {
 8226: 
 8227:       Vector2 bcc1 = node1->bcc[k];
 8228:       Vector2 bcc2 = node2->bcc[k];
 8229:       if constexpr(ics == 2) {
 8230:          // Project the velocities from the node frames to the side frame
 8231:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8232:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8233:       }
 8234: 
 8235:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8236:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8237: 
 8238:    }
 8239: }
 8240: #endif
 8241: 
 8242: 
 8243: extern "C" {
 8244:    __global__ void computeElemAverageGhat(void) {
 8245:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8246: 
 8247:       ELEM(elem);
 8248:       
 8249:       elem->ghat1= {0.0, 0.0};  
 8250: 
 8251:       if constexpr(ihydraulics != 0) {
 8252:          if (nhtblocks > 0 && elem->isblock) return;
 8253:       }
 8254: 
 8255:       
 8256:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8257:       // cff1-3: coefficients for 2D/3D
 8258: 
 8259:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8260:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8261:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8262: 
 8263:       if (elem->isDry) return;
 8264: 
 8265:       // Average of the coefficients
 8266:       double av_cff1 = 0.0;  // av. for cff1
 8267:       double av_cff2 = 0.0;  // av. for cff2
 8268:       double av_cff3 = 0.0;  // av. for cff3
 8269:       double av_df = 0.0;  // av. for H^\alpha / H
 8270:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8271:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8272: 
 8273:       const int i34 = elem->i34;
 8274:       const int kb  = elem->kb;
 8275: 
 8276:       for (int j=0; j<i34; j++) {
 8277:          // For each node and side in the element...
 8278: 
 8279:          const Node *node = elem->nodes[j];
 8280:          const Side *side = elem->sides[j];
 8281: 
 8282:          const double chi      = side->chi;
 8283:          const double veg_c2   = side->veg_c2;
 8284:          const double veg_beta = side->veg_beta;
 8285:          const double veg_h    = side->veg_h();
 8286:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8287: 
 8288:          const Vector2 gradPhi = elem->gradPhi[j];
 8289: 
 8290:          // Node - const in elem
 8291:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8292:          elem->gradPr  += node->pr  *gradPhi;
 8293: 
 8294:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8295: 
 8296:         
 8297:          const double htot  = side->htot2();        // Total depth at the side
 8298:          const double zctr2 = side->zTopCanopy();  
 8299: 
 8300:          double cff1; 
 8301:          double cff2; 
 8302:          double cff3;   
 8303:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8304:          // coefficients applied to 2D/3D case 
 8305:             cff1 = side->hhat/htot;
 8306:             cff2 = 0.0;
 8307:             cff3 = 0.0;
 8308:          } else { //3D
 8309:             //Init for no-veg case
 8310:             cff1 = 1.0;
 8311:             cff2 = 1.0;
 8312:             cff3 = 0.0;
 8313: 
 8314:             if constexpr(iveg != 0) {
 8315:                // Computes coefficients used with vegetation terms G1, G2
 8316:                // cff1, cff3 are used for the first two terms in G1, G2:
 8317:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8318:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8319:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8320:                if(veg_h < 0.99*htot) { // submergent vegetation
 8321:                   cff1 = 1.0;
 8322:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8323:                   cff3 = veg_c;
 8324: 
 8325:                } else { // emergent vegetation
 8326:                   cff1 = 1.0/(1.0 + veg_c2);
 8327:                   cff2 = cff1;
 8328:                   cff3 = 0.0;
 8329: 
 8330:                }
 8331:             } // if iveg
 8332:          } //  2D/3D
 8333: 
 8334:          av_cff1 += cff1/i34;
 8335:          av_cff2 += cff2/i34;
 8336:          av_cff3 += cff3/i34;
 8337:          av_cff2_chi += cff2*chi/i34;
 8338:          av_cff3_chi += cff3*chi/i34;
 8339:          av_df += min(htot, veg_h)/(htot*i34);
 8340: 
 8341: 
 8342:          // btrack values: U^\star, U^{\star\alpha}
 8343:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8344:          Vector2 Ustar       = {0.0, 0.0}; 
 8345:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8346: 
 8347:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8348:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8349:          } else { //3D
 8350:             for (int k = side->kb + 1; k < nvrt; k++) {
 8351:             
 8352:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8353:                Ustar += w2;
 8354: 
 8355:                if constexpr(iveg != 0) {
 8356:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8357:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8358:                        Ustar_alpha += zrat*w2; // XXXX
 8359:                    }
 8360:                }  // if iveg
 8361:             }  // for k
 8362:          }  //2D/3D
 8363: 
 8364:          // If needed, project the side velocities to the element frame
 8365:          if constexpr(ics==2) {
 8366:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8367:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8368:          }
 8369:         
 8370: 
 8371:          // Add btrack & surface stress terms to \breve{G} first
 8372:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8373: 
 8374: 
 8375:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8376:          Vector2 tau    = side->tau();  
 8377:          Vector2 ubstar = side->btu[side->kb + 1];  
 8378: 
 8379:          // If needed, project tau and ubstar to the element frame
 8380:          if constexpr(ics==2) {
 8381:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8382:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8383:          }
 8384: 
 8385:          // Term for surface and bottom stress
 8386:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8387: 
 8388: 
 8389:          // All terms in F,F^\alpha,f_b except baroclinic
 8390:          // F, f_b: all explicit terms excluding vegetation 
 8391:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8392:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8393:          const double coriolis = side->coriolis;
 8394:          Vector2 F  =  coriolis*side->U;  // F_x
 8395:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8396:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8397: 
 8398:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8399:             
 8400:             for (int k = side->kb; k < nvrt; k++) {
 8401:                if (zctr2 > side->zc[k-1]) {
 8402:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8403:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8404:                    Fa +=  coriolis*w2*zrat;
 8405:                } // if zctr2
 8406:             } // k
 8407:          } // iveg
 8408: 
 8409:          // Integrate horizontal viscosity force vertically
 8410:          for (int k=side->kb + 1; k<nvrt; k++) {
 8411:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8412: 
 8413:             F += levelHorVisc;
 8414: 
 8415:             // Vegetation term
 8416:             if constexpr(iveg!=0) {
 8417:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8418:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8419:                   Fa += levelHorVisc*zrat;
 8420:                } 
 8421:             } // if iveg
 8422:          } // for k
 8423: 
 8424:          // Get nu*grad(U) at the side's bottom level
 8425:          Vector2 nuGradU = side->nuGradU[side->kb];
 8426: 
 8427:          fb += nuGradU;
 8428: 
 8429:          // If needed, project vectorsF, fb and Fa to the element frame
 8430:          if constexpr(ics==2) {
 8431:             F    = side->frame.projHorVec(F,    elem->frame);
 8432:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8433:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8434:          } // if ics
 8435: 
 8436:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8437:       } // for j (nodes and sides)
 8438: 
 8439:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8440: 
 8441: 
 8442:       // Finish off terms in F, F^\alpha and f_b
 8443:       const double grav3 = elem->mean(&Node::grav2);
 8444:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8445:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8446:       for (int j=0; j<i34; j++) { 
 8447:          // For each side in the element...
 8448:          const Side *side = elem->sides[j];
 8449:          const double chi = side->chi;
 8450: 
 8451:          const double htot = side->htot2();
 8452:          const double veg_h = side->veg_h();
 8453:          const Vector2 F  = htot*fb;
 8454:          const Vector2 Fa = min(htot, veg_h)*fb;
 8455: 
 8456:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8457:       } // for j
 8458: 
 8459:       // tmp is already in elem frame
 8460:       elem->ghat1 += tmp/i34;
 8461: 
 8462:       // Baroclinic force
 8463:       if constexpr(ibc==0) {
 8464:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8465: 
 8466:          Vector2 Fa = {0.0, 0.0};
 8467:          Vector2 intGradRho = {0.0, 0.0};
 8468:          
 8469:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8470:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8471:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8472: 
 8473:             // \in F [m^2/s/s]
 8474:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8475:          }
 8476: 
 8477:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8478:          const Vector2 F = av_df*Fa; //approx
 8479:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8480: 
 8481:       } // if ibc
 8482: 
 8483: 
 8484: 
 8485:    }
 8486: 
 8487: } // extern "C"
 8488: 
 8489: 
 8490: 
 8491: #ifdef DONTCOMPILE
 8492: __global__ void checkMassConservation(Tracers* sumtr) {
 8493: 
 8494:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 8495: 
 8496:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 8497: 
 8498:    Element *elem = &(mesh->localElemData[i]);
 8499: 
 8500:    // Skip dry elements
 8501:    if (elem->isDry) return;
 8502: 
 8503:    // Local sum array for this thread
 8504:    double localSum[N_TRACERS] = {0.0};
 8505: 
 8506:    // Sum over vertical levels for this element
 8507:    const int kbe = elem->kbe;
 8508:    const double area = elem->area;
 8509: 
 8510:    for (int k = kbe; k < nvrt; k++) {
 8511:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 8512:       
 8513:       // Accumulate tracer mass
 8514:       for (int tr = 0; tr < N_TRACERS; tr++) {
 8515:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 8516:       }
 8517:    }
 8518: 
 8519:    //  This function returns per element sums. A reduction must be done on the host side.
 8520: }
 8521: 
 8522: 
 8523: __global__ void transport(void) {
 8524: 
 8525:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 8526: 
 8527:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 8528: 
 8529:    Element *elem = &(mesh->localElemData[ie]);
 8530: 
 8531:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 8532: 
 8533:                for (int m=0; m<ntr; m++) {
 8534:                   for (int k=kbe(ie); k<nvrt; k++) {
 8535:                      // Calculate each polynomial's weight 
 8536:                      wm=0.d0; sum1=0.d0; 
 8537:                      wm1=0.d0; wm2=0.d0; 
 8538:                      for (int i=0; i<elem->nweno2; i++) {
 8539:                   
 8540:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8541:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8542:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8543:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8544:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8545:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 8546:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 8547:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 8548:                      // -----------------Hu and Shu (1999)'s method----------------
 8549:                      b4=b1+b2+b3
 8550: 
 8551: //Error: add PRODUCTION CPP
 8552: #ifdef DEBUG
 8553:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 8554:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 8555:                     call parallel_abort(errmsg)
 8556:                   }
 8557: #endif
 8558: 
 8559:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 8560:                   // !----test-------------- 
 8561:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 8562:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 8563:                   // !wm(i)=wm1(i)*wm2(i)
 8564:                   // !---------------------- 
 8565:                   sum1=sum1+wm(i)
 8566:                 } // end for i
 8567: 
 8568:                 wm=wm/sum1
 8569: 
 8570:                 for (int j=0; j<elem->i34; j++) {
 8571: 
 8572:                   const Side *side  = elem->sides[j];
 8573:                   const Node *node1 = side->n1;
 8574:                   const Node *node2 = side->n2;
 8575: 
 8576:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 8577:                      trsd=0.d0
 8578:                      for (int kk=0; kk<nquad; kk++) {
 8579:                         for (int i=0; i<elem->nweno2; i++) {
 8580:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8581:                         } // end for i   
 8582:                      } // end for kk
 8583:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8584:                   } // outward flux
 8585:                } // end for j=1,i34(ie) ! side
 8586:             }
 8587:          }
 8588:               
 8589: 
 8590: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 8591: //             //   calculate each polynomial's weight 
 8592: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 8593: //                 wm=0.d0; sum1=0.d0
 8594: //                 do i=1,nweno1(ie) !for each polynomial
 8595: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8596: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8597: //                   b1=b1*b1+b2*b2 !smoothness indicator
 8598: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 8599: //                   wm(i)=b2
 8600: //                   sum1=sum1+b2
 8601: //                   !wm(i)=1.d0
 8602: //                   !sum1=sum1+1.d0
 8603: 
 8604: // // Error: PRODUCTION
 8605: // #ifdef DEBUG
 8606: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 8607: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 8608: //                     call parallel_abort(errmsg)
 8609: //                   endif
 8610: // #endif
 8611: 
 8612: //                 enddo !i
 8613: //                 wm=wm/sum1 !final weight
 8614: 
 8615:                 for (int j=0; j<elem->i34; j++) { // side
 8616:                   const Side *side = elem->sides[j];
 8617:                   const Node *node1 = side->n1;
 8618:                   const Node *node2 = side->n2;
 8619: 
 8620:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 8621:                     trsd=0.d0
 8622:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 8623:                       for (int i=0; i<elem->nweno1; i++) {
 8624:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 8625:                       }
 8626:                     enddo //kk
 8627:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8628:                   } // outward flux
 8629:                 } // end for j=1,i34(ie) ! side
 8630:               } // end for k; ntr 
 8631: 
 8632:             else !simple upwind method
 8633:               do j=1,i34(ie)
 8634:                 jsj=elside(j,ie)
 8635:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 8636:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 8637:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 8638:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 8639:                   endif
 8640:                 enddo  !vertical layers
 8641:               enddo !j=1,i34(ie) ! side
 8642:             endif !order of accuracy
 8643: 
 8644:          //  enddo !ie
 8645: // !$OMP     end do
 8646: 
 8647: // !$OMP     master
 8648: //           !message passing
 8649: //           if (nproc>1) then
 8650: //             !make a copy of side concentrations
 8651: //             trsd_tmp0=trsd_tmp 
 8652: 
 8653: //             !this exchange routine swaps interface concentration between two partitions
 8654: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 8655: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 8656: 
 8657: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 8658: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 8659: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 8660: 
 8661: 
 8662: //             !This obtains final values for interface sides
 8663: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 8664: //       :    endif !nproc>1
 8665: //           !message passing end
 8666: // !$OMP     end master
 8667: // !$OMP     barrier
 8668: 
 8669: 
 8670: // !         Do advection; conc @ dry elem will not be changed
 8671: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 8672: // !$OMP     do reduction(+: h_mass_in)
 8673: //           do i=1,ne
 8674: //             if(idry_e(i)==1) cycle
 8675: 
 8676: 
 8677: // !           Wet elements with 3 wet nodes
 8678: //             do k=kbe(i)+1,nvrt
 8679: 
 8680: 
 8681: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 8682: //               dtb_by_bigv = dtb/bigv
 8683:     
 8684: // !             Advective flux
 8685: //               if (ntd_weno==1 .or. itd_weno==1) then
 8686: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 8687: //               else
 8688: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 8689: //               endif
 8690: 
 8691: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 8692: //               do j=1,i34(i)
 8693: //                 jsj=elside(j,i) !side
 8694: //                 iweno=.true. !use weno reconstruction as default
 8695: //                 iel=ic3(j,i) !neighboring elem
 8696: 
 8697: //                 if(iel/=0) then
 8698: //                   if(idry_e(iel)==1) cycle
 8699: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 8700: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 8701: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 8702: //                     iweno=.false.
 8703: //                   endif
 8704: //                 else !land or open bnd side
 8705: //                   !skip land bnd and outflowing open bnd, 
 8706: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 8707: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 8708: //                     !For outflow open bnd side, estimate mass in (open
 8709: //                     !side cannot be interface side)
 8710: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 8711: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 8712: //                     endif
 8713: 
 8714: //                     cycle
 8715: //                   endif
 8716: 
 8717: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 8718: //                   iweno=.false.  !reset to upwind
