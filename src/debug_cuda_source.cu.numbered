 9053: 
 9054: __global__ void printMatrix(bool full) {
 9055:    // Debugging: print the FEM matrix row for each local node
 9056: 
 9057:    const int size = mesh->np;
 9058:    double sum = 0.0;
 9059: 
 9060:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9061:       const Node *node = mesh->localNodeData + idx_node;
 9062: 
 9063:       if (full)
 9064:          printf("idx_node = %d [%d] diag=%lf, [",
 9065:                 idx_node, node->numNodes, *(node->coeffDiag));
 9066: 
 9067:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9068:       for (int k = 0; k < node->numNodes + 1; k++)
 9069:          sum += node->coeffRow[k];
 9070: 
 9071:       for (int j = 0; j < node->numNodes; j++) {
 9072:          const Node *nbNode = node->nodes[j];
 9073:          const double aij = node->coeffRow[node->csrSlot[j]];
 9074:          if (full && aij != 0.0)
 9075:             printf("%d:%f,  ", nbNode->idx, aij);
 9076:       }
 9077: 
 9078:       if (full) printf("]\n");
 9079:    }
 9080: 
 9081:    if (!full) printf("sum=%lf\n", sum);
 9082: }
