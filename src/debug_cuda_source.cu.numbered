  704:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  705:       // Check if the point (xt,yt) is inside the element
  706:       double shpCoords[4];
  707: 
  708:       bool res = computeShapeCoords(xt, shpCoords, false);
  709: 
  710:       return res;
  711:    }
  712: 
  713:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  714:       // Check if the point (xt,yt) is inside the element
  715:       double shpCoords[4];
  716: 
  717:       Vector2 tmp_xt = xt;
  718:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  719: 
  720:       if (fixCoords && res) xt = tmp_xt;
  721: 
  722:       return res;
  723:    }
  724: 
  725:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  726:    {
  727:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  728:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  729:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  730:       
  731:    }
  732: 
  733:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  734: 
  735:    // ------------------------------------------------------------------------------------------------
  736:    // These are functions that work on all nodes of the element.
  737:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  738:    //
  739:    // An example of how to use these functions is:
  740:    //   
  741:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  742:    // 
  743:    // Where L is the level at which the field is to be interpolated. The field can be either
  744:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  745:    // There are different versions of getNodalValues for each of these cases.
  746: 
  747:    template<typename T>
  748:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  749:       // Get the values of the field at the nodes of the element
  750:       res[0] = nodes[0]->*field;
  751:       res[1] = nodes[1]->*field;
  752:       res[2] = nodes[2]->*field;
  753:       if (isQuad()) res[3] = nodes[3]->*field;
  754:       else          res[3] = T();
  755:    }
  756: 
  757:    template<typename T>
  758:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  759:       // Get the values of the field at the nodes of the element
  760:       res[0] = (nodes[0]->*field)[level];
  761:       res[1] = (nodes[1]->*field)[level];
  762:       res[2] = (nodes[2]->*field)[level];
  763:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  764:       else          res[3] = T();
  765:    }    
  766: 
  767:    template<typename T>
  768:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  769:       // Get the values of the func at the nodes of the element
  770:       res[0] = (nodes[0]->*func)(level);
  771:       res[1] = (nodes[1]->*func)(level);
  772:       res[2] = (nodes[2]->*func)(level);
  773:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  774:       else          res[3] = T();  // This is 0.0 or a zero vector
  775: 
  776:    }      
  777: 
  778:    template<typename T>
  779:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  780:       // Get the values of the field at the nodes of the element
  781:       res[0] = sides[0]->*field;
  782:       res[1] = sides[1]->*field;
  783:       res[2] = sides[2]->*field;
  784:       if (isQuad()) res[3] = sides[3]->*field;
  785:       else          res[3] = T();
  786:    }
  787: 
  788:    template<typename T>
  789:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  790:       // Get the values of the field at the nodes of the element
  791:       res[0] = (sides[0]->*field)[level];
  792:       res[1] = (sides[1]->*field)[level];
  793:       res[2] = (sides[2]->*field)[level];
  794:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  795:       else          res[3] = T();
  796:    }    
  797: 
  798:    template<typename T>
  799:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  800:       // Get the values of the func at the nodes of the element
  801:       res[0] = (sides[0]->*func)(level);
  802:       res[1] = (sides[1]->*func)(level);
  803:       res[2] = (sides[2]->*func)(level);
  804:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  805:       else          res[3] = T();  // This is 0.0 or a zero vector
  806: 
  807:    }      
  808: 
  809:    template<typename T>
  810:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  811:       T values[4];
  812:       getNodalValues(level, func, values);
  813: 
  814:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  815:    }
  816: 
  817:    template<typename T>
  818:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  819:       T values[4];
  820:       getNodalValues(field, values);
  821:       
  822:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  823:    }
  824: 
  825: 
  826:    template<typename T>
  827:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  828:       T values[4];
  829:       getNodalValues(level, field, values);
  830: 
  831:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  832:    }
  833: 
  834:    template<typename T>
  835:    __device__ T mean(T Node::* field) const {
  836:       T values[4];
  837:       getNodalValues(field, values);
  838: 
  839:       return (values[0] + values[1] + values[2] + values[3])/i34;
  840:    }
  841: 
  842:    template<typename T>
  843:    __device__ T mean(T Side::* field) const {
  844:       T values[4];
  845:       getSideValues(field, values);
  846:       
  847:       return (values[0] + values[1] + values[2] + values[3])/i34;
  848:    }   
  849: 
  850:    template<typename T>
  851:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  852:       T values[4];
  853:       getNodalValues(level, field, values);
  854: 
  855:       return (values[0] + values[1] + values[2] + values[3])/i34;
  856:    }
  857: 
  858:    template<typename T>
  859:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  860:       T values[4];
  861:       getSideValues(level, field, values);
  862:       
  863:       return (values[0] + values[1] + values[2] + values[3])/i34;
  864:    }   
  865: 
  866:    // __device__ double mean(double (Node::*func)(int) const) const {
  867:    //    double values[4];
  868:    //    getNodalValues(level, func, values);
  869:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  870:    // }
  871:    // ------------------------------------------------------------------------------------------------
