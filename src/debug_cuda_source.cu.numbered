 2649: 
 2650: // Helper functions to get the 2D local node position for the Celestial walk
 2651: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2652:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2653:    const Node *node = getNodeInOrder(idx2);
 2654: 
 2655:    double z = 0.0;
 2656:    if constexpr(ics == 2) z = node->gz;
 2657:    
 2658:    Point3 p = toPoint3(node->p, z);
 2659: 
 2660:    return toPoint2(origSide->toLocalFrame(p));
 2661: }
 2662: 
 2663: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2664:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2665: }
 2666: 
 2667: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2668:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2669: // Computes the three per-side predicates needed for the celestial walk
 2670: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2671: //
 2672: // xt is in local frame coordinates for origSide if ics == 2.
 2673: //
 2674: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2675: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2676: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2677: // meaningless on triangles are masked to a safe value (see comments below).
 2678: {
 2679:    // Project all 4 corner positions once into the local 2D frame.
 2680:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2681:    // getLocalNodePosition only transforms/projects if ics == 2.
 2682:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2683:                         getLocalNodePosition(1, origSide), 
 2684:                         getLocalNodePosition(2, origSide), 
 2685:                         getLocalNodePosition(3, origSide)};
 2686: 
 2687:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2688:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2689:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2690:    // But still farther towards the target point from the current point.
 2691:    const Vector2 vt0 = xt - x0;
 2692:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2693:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2694:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2695: 
 2696:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2697:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2698: 
 2699: 
 2700: // if (origSide->idx == 2860848 && jlev == 46) {
 2701: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2702: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2703: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2704: // }
 2705:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2706:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2707:    //  here — the orientation is baked into the corners array.)
 2708:    const int i3 = nxq(3);
 2709:    const Vector2 s0 = C[ 1] - C[ 0];
 2710:    const Vector2 s1 = C[ 2] - C[ 1];
 2711:    const Vector2 s2 = C[i3] - C[ 2];
 2712:    const Vector2 s3 = C[ 0] - C[i3];
 2713:    
 2714:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2715:    // The corners array is built from getNode in CCW order, so the orientation
 2716:    // is already correct and no ssign factor is needed in the formulas below.
 2717:    //
 2718:    // i3 = nxq(3): the index of the corner after side 2.
 2719:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2720:    //   Quad:     i3 == 3.
 2721:    //
 2722:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2723:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2724:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2725:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2726:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2727:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2728: 
 2729: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2730: 
 2731:    // For triangles, the corner after side 2 is the closing corner where
 2732:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2733:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2734:    // s0 for triangles, s3 for quads.
 2735:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2736: 
 2737:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2738:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2739:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2740:    //
 2741:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2742:    // result is false naturally. No sentinel needed.
 2743:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2744:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2745:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2746:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2747: 
 2748:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2749:    // on the "exit through side I" half of the corner cone, separated by the
 2750:    // approximate angular bisector of the celestial walk. The bisector is
 2751:    // perpendicular to the chord across the corner; the test is the sign of
 2752:    // (xt - corner_vertex) projected onto that chord.
 2753:    //
 2754:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2755:    // (the validity rule sets valid_3 = false), so its computed value for
 2756:    // triangles doesn't matter. No sentinel needed.
 2757:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2758:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2759:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2760:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2761: 
 2762: }
 2763: 
 2764: 
 2765: __inline__ __device__ double Element::computeSignedArea(void) const {
 2766:    // Compute the area of the element
 2767: 
 2768:    Point2 x0, x1, x2, x3;
 2769:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2770: 
 2771:    double res = signedArea(x0, x1, x2);
 2772: 
 2773:    // In the quad case we need to add the area of the other triangle.
 2774:    if (isQuad()) {
 2775:       x3 = getLocalHorizontalNodePosition(3);
 2776:       double ar1 = signedArea(x0, x2, x3);
 2777:       double ar2 = signedArea(x0, x1, x3);
 2778:       double ar3 = signedArea(x1, x2, x3);
 2779:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2780: 
 2781:       res += ar1 + ar2 + ar3;
 2782:    }
 2783: 
 2784:    return res;
 2785: }
 2786: 
 2787: 
 2788: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2789:                                                                 (nodes[1]->isDry2()) ||
 2790:                                                                 (nodes[2]->isDry2()) ||
 2791:                                                                 (isQuad() && nodes[3]->isDry2());
 2792: }
 2793: 
 2794: __inline__ __device__ double Element::detJ_eta(void) const {
 2795:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2796:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2797: }
 2798: 
 2799: __inline__ __device__ double Element::detJ_xi(void) const {
 2800:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2801:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2802: }
 2803: 
 2804: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2805:    // In boundary sides, the element 1 is nullptr
 2806:    return side->elems[1] == nullptr; 
 2807: }
 2808: 
 2809: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2810:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2811:    // For ics == 2, this function uses local frame coordinates.
 2812: 
 2813:    assert(isQuad());
 2814: 
 2815:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2816:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2817:    // where vxi, veta, vb are vectors and c is the center of the element.
 2818: 
 2819:    Point2 p0, p1, p2, p3;
 2820: 
 2821:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2822: 
 2823:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2824:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2825:    // vectors vxi and veta connect the centers of opposite sides
 2826:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2827:    // vb is zero for parallelogram elements.
 2828:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2829: 
 2830:    //  The bilinear mapping is:
 2831:    //      P(s,t) = C + s*U + t*V + s*t*W
 2832:    //
 2833:    //  where:
 2834:    //    C = centroid (average of four vertices)
 2835:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2836:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2837:    //    W = bilinear correction; measures deviation from parallelogram
 2838:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2839:    //        W = 0 for parallelogram elements.
 2840:    //
 2841:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2842:    //
 2843:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2844:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2845:    //
 2846:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2847:    //
 2848:    //  Geometrically, (L) projects everything onto the direction
 2849:    //  perpendicular to W, where the mapping is purely affine.
 2850:    //
 2851:    //  The dot product with nb retains the nonlinear term:
 2852:    //
 2853:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2854:    //
 2855:    //  Geometrically, (Q) projects onto the W direction, where
 2856:    //  the nonlinearity lives.
 2857:    //
 2858:    //  We solve (L) for whichever variable has the larger coefficient
 2859:    //  (better conditioned back-substitution), substitute into (Q),
 2860:    //  and get a scalar quadratic in the other variable.
 2861:    // ================================================================
 2862: 
 2863:    // ---- Basis vectors ----
 2864:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2865:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2866:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2867:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2868:    // W: nonlinear correction. Difference between quad and parallelogram.
 2869:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2870:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2871: 
 2872:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2873:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2874:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2875:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2876:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2877: 
 2878:    // ---- nb: direction parallel to W, L1-normalized ----
 2879:    // We don't need a unit vector -- just a well-scaled direction parallel
 2880:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2881:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2882:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2883:    //
 2884:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2885:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2886:    // and the quadratic solver takes its linear path (a ~ 0).
 2887:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2888:    const double inv_wlen = 1.0 / wlen1;
 2889:    const Vector2 nb = vb * inv_wlen;
 2890: 
 2891:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2892:    // cross(nb, ·) projects onto the direction PERPENDICULAR to W.
 2893:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2894:    // What remains is a pure affine relationship between xi and eta.
 2895:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2896:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2897:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2898: 
 2899:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2900:    // dot(nb, ·) projects onto the W direction, where the nonlinearity lives.
 2901:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2902:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2903:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2904:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2905:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2906: 
 2907:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2908:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2909:    // minimizing round-off amplification.
 2910:    //
 2911:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2912:    // that uses predicated moves.
 2913:    //
 2914:    // if (fabs(Ls) > fabs(Lt)) {
 2915:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2916:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2917:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2918:    //    const double A = -Qw * Lt;
 2919:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2920:    //    const double C =  Qs * Lp - Qp * Ls;
 2921: 
 2922:    //    double eta1, eta2;
 2923:    //    solveQuadratic(A, B, C, eta1, eta2);
 2924: 
 2925:    //    // Pick root with smaller |eta| (domain centered at 0).
 2926:    //    // Ternary-> predicated move, no branch divergence.
 2927:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2928: 
 2929:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2930:    //    xi = (Lp - Lt * eta) / Ls;
 2931: 
 2932:    // } else {
 2933:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2934:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2935:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2936:    //    const double A = -Qw * Ls;
 2937:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2938:    //    const double C =  Qt * Lp - Qp * Lt;
 2939: 
 2940:    //    double xi1, xi2;
 2941:    //    solveQuadratic(A, B, C, xi1, xi2);
 2942: 
 2943:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2944: 
 2945:    //    eta = (Lp - Ls * xi) / Lt;
 2946:    // }
 2947:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2948:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2949:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2950:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2951:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2952: 
 2953:    // Quadratic:  A*r^2 + B*r + C = 0
 2954:    // (same formula for both cases, just with swapped coefficients)
 2955:    const double A = -Qw * Lb;
 2956:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2957:    const double C =  Qa * Lp - Qp * La;
 2958: 
 2959:    double r1, r2;
 2960:    solveQuadratic(A, B, C, r1, r2);
 2961: 
 2962:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2963:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2964: 
 2965:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2966:    const double other = (Lp - Lb * r) / La;
 2967: 
 2968:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2969:    xi  = solve_s ? r     : other;
 2970:    eta = solve_s ? other : r;
 2971: 
 2972: 
 2973:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2974:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2975:    eta = fmin(1.0, fmax(eta, -1.0));
 2976: 
 2977:    // ---- Shape functions ----
 2978:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2979:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2980:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2981:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2982:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2983:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2984:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2985:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2986: 
 2987:    return true;
 2988: }
 2989: 
 2990: /**
 2991:    Compute the shape coordinates of the point (xt,yt) in the element.
 2992:    @param xt (input): x-coordinate of the point
 2993:    @param shpCoords (output): shape coordinates of the point
 2994:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2995:    @return true if the point is inside the element, false otherwise
 2996: **/
 2997: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2998: 
 2999:    // Compute the shape coordinates of the point xt in the element.
 3000:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3001:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3002:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3003:    // from the local frame, so use additional check.
 3004: 
 3005:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa (5)");
 3006: 
 3007:    if (isTri()) { // Triangular element
 3008: 
 3009:       // Horizontal local node coordinates. 
 3010:       Point2 x0 = nodes[0]->p;
 3011:       Point2 x1 = nodes[1]->p;
 3012:       Point2 x2 = nodes[2]->p;
 3013: 
 3014:       // If ics == 2, the node coordinates are transformed to local frame.
 3015:       if constexpr(ics==2) {
 3016:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 3017:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 3018:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 3019: 
 3020: 
 3021:          // Convert the node coordinates to the local frame centered at the element center
 3022:          x0 = toPoint2(origSide->toLocalFrame(p0));
 3023:          x1 = toPoint2(origSide->toLocalFrame(p1));
 3024:          x2 = toPoint2(origSide->toLocalFrame(p2));
 3025:       }
 3026: 
 3027:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3028:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3029:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3030:       shpCoords[3] = 0.0;
 3031: 
 3032: 
 3033:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3034:       const bool res = (tmpmin >= -small);  
 3035:       
 3036:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 3037:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3038: 
 3039: double tmpmax = max3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3040: if (tmpmin < -0.1) printf("XXX element %d, tmpmin = %.17f\n", idx, tmpmin);
 3041: if (tmpmax > 1.1) printf("XXX element %d, tmpmax = %.17f\n", idx, tmpmax);
 3042:       
 3043:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3044:       // then we fix the negative shape coordinates.
 3045:       if ((tmpmin < 0) && fix) {
 3046: 
 3047:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3048:          // keeping the sum of the shape coordinates equal to 1.
 3049:          // I have tested and compared the new algorithm with the old one, and they give
 3050:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3051:          // The new algorithm should be faster since it is branchless.
 3052:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3053:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3054: 
 3055:          shpCoords[0] = (shpCoords[0] + a)*b;
 3056:          shpCoords[1] = (shpCoords[1] + a)*b;
 3057:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3058: 
 3059:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3060:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3061:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3062: 
 3063:          // Update the point coordinates for the new shape coordinates
 3064:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3065:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3066: 
 3067:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3068: 
 3069:       }
 3070: 
 3071:       // Check if the point is inside the element
 3072:       return res;      
 3073:    }
 3074:    else {
 3075:       assert(isQuad() && "computeShapeCoords");
 3076: 
 3077:    //    Point2 p = xt;
 3078: 
 3079:    //    // Reproject p the original side frame for ics=2
 3080:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 3081: 
 3082:    //    bool inside = false;
 3083: 
 3084: 
 3085: 
 3086:    //    if(ifl==0) then
 3087:    //      do i=1,4
 3088:    //        in1=nxq(1,i,i34(ie))
 3089:    //        in2=nxq(2,i,i34(ie))
 3090:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 3091:    //      enddo !i
 3092:    //      tmp=minval(swild2(1:4))/area(ie)
 3093:    //      if(tmp>-small2) then
 3094:    //        inside=1
 3095:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3096:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3097:    //      endif !inside quad
 3098:    //    else !ifl=1 - already inside
 3099:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3100:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3101:    //      !Update pt
 3102:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3103:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3104:    //    endif !ifl
 3105: 
 3106: 
 3107:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3108: 
 3109:    }
 3110: 
 3111:    assert(false && "computeShapeCoords: should never reach this point");
 3112:    return false;  // Never reached
 3113: 
 3114: }
 3115: 
