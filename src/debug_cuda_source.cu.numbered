  982: struct Side {
  983: 
  984:    // Geometry information
  985:    int idx;               // Index of the side
  986:    Node *n1, *n2;
  987:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  988: 
  989:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  990:    Vector2 center;        // Location of side center. 
  991:    double zc[nvrt];       // Side center z-coord at each vertical level
  992: 
  993:    Frame frame;
  994: 
  995:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  996:                           // this is nullptr
  997:    
  998:    int kb;                // Bottom index of the side
  999:    bool isDry;            // True if the side is dry
 1000:  
 1001:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1002: 
 1003:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1004: 
 1005:    // Physical information
 1006:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1007:    Vector2 btu[nvrt];           // Back-tracked velocity
 1008:    Vector2 U;                   // Vertically averaged velocity vector  
 1009: 
 1010:    Vector2 nuGradU[nvrt];          // nu*grad u
 1011: 
 1012:    Vector2 bcc[nvrt];           // Baroclinic term
 1013:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1014: 
 1015:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1016:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1017:    Vector2 gradPr;               // Gradient of pressure
 1018:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1019: 
 1020: 
 1021:    double hhat;                 // \breve{H} in notes
 1022: 
 1023:    double shapiro;
 1024: 
 1025:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1026: 
 1027:    double coriolis;             // Coriolis parameter
 1028: 
 1029:    // Vegetation parameters
 1030:    double veg_c2;
 1031:    double veg_beta;
 1032: 
 1033:    // Bottom drag parameters.
 1034:    double chi;
 1035:    double chi2;
 1036: 
 1037:    __inline__ __device__ double x(double t) const;
 1038:    __inline__ __device__ double y(double t) const;
 1039:    __inline__ __device__ double lon(void) const;
 1040:    __inline__ __device__ double lat(void) const;
 1041:    __inline__ __device__ Point2 p_t(double t) const;
 1042: 
 1043:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1044:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1045:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1046: 
 1047:    __inline__ __device__ Side* neigh(int index) const { 
 1048:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1049:       assert(index >= 0 && index < 4); 
 1050:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1051: 
 1052:       const int ielem = index & 1;           // 0 or 1
 1053:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1054: 
 1055:       const Element* elem = elems[ielem];
 1056: 
 1057:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1058: 
 1059:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1060: 
 1061:    }
 1062: 
 1063:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1064: 
 1065:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1066: 
 1067:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1068:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1069:    __inline__ __device__ int iadv(void) const;
 1070: 
 1071:    __inline__ __device__ double grav3(void) const;
 1072:    
 1073:    __inline__ __device__ double eta2(void) const;
 1074:    __inline__ __device__ double eta1(void) const;
 1075:    __inline__ __device__ double w2(int k) const;
 1076:    __inline__ __device__ double depth(void) const;
 1077:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1078:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1079: 
 1080:    __inline__ __device__ double dfv(int k) const;
 1081: 
 1082:    __inline__ __device__ double veg_h(void)  const;
 1083:    __inline__ __device__ double veg_nv(void) const;
 1084:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1085:    __inline__ __device__ double veg_alpha3D(int k) const;
 1086:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1087: 
 1088:    __inline__ __device__ double Cd(void) const;
 1089: 
 1090:    __inline__ __device__ Vector2 tau(void) const;
 1091: 
 1092:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1093:    
 1094: 
 1095:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1096:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1097:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1098:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1099:    } 
 1100:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1101:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1102:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1103:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1104: 
 1105:    // Get valid starting element (for backtracking)
 1106:    __inline__ __device__ Element* getStartElement() {
 1107:       return elems[0] ? elems[0] : elems[1];
 1108:    }
 1109: 
 1110:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1111:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1112:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1113: 
 1114:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1115: 
 1116:       // Dot product of the negative velocity vector with the side normal vector
 1117:       const double dot_prod1 = -dot(u, n);
 1118: 
 1119:       // Vector from side center to element 0 centroid
 1120:       const Vector2 v2 = elems[0]->center - center;
 1121: 
 1122:       // Dot product of the vector with the side normal vector
 1123:       const double dot_prod2 = dot(v2, n);
 1124: 
 1125:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1126:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1127: 
 1128:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1129:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1130: 
 1131:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1132: 
 1133:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1134:       else                           return !isDry1 ? elems[1] : elems[0];
 1135: 
 1136:  
 1137:    }
 1138: 
 1139:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1140:       // Given an element, returns the other element that shares this side
 1141:       return (elems[0] == elem) ? elems[1] : elems[0];
 1142:    }
 1143: 
 1144:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1145:       // Given a node, returns the other node that shares this side
 1146:       return (n1 == node) ? n2 : n1;
 1147:    }
 1148:  
 1149:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1150: 
 1151: 
 1152: 
 1153: 
 1154: };
 1155: 
 1156: 
 1157: // This struct is used to store the boundary information for a node.
 1158: struct NodeBoundary {   
 1159:    int idx;
 1160:    BoundarySegment *segment;
 1161:    Node *node;
 1162:    
 1163:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1164:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1165: 
 1166:    bool isLand;
 1167: 
 1168:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1169:    double elbc;   // Elevation boundary condition
 1170:    double eth;    // Elevation time history
 1171: 
 1172:    double eta_mean; // Mean elevation at nodes
 1173: 
 1174:    bool isEssentialBC;
 1175: 
 1176:    Vector2 uth[nvrt];  // "Time history" velocity
 1177: 
 1178:    // Arrays for harmonic constituents (if needed)
 1179:    double  emo[nbfr];  // Elevation amplitude
 1180:    double  efa[nbfr];  // Elevation phase
 1181:    Vector2 umo[nbfr];  // velocity amplitude
 1182:    Vector2 ufa[nbfr];  // velocity phase
 1183: 
 1184: 
 1185:    NodeBoundary(void) {
 1186:       isLand = false;
 1187:    }
 1188:    NodeBoundary(bool _isLand) {
 1189:       isLand = _isLand;
 1190:    }
 1191: 
 1192:    
 1193:    __forceinline__ __device__ int numSidesForAverage() const {
 1194:    // Returns the number of sides that are connected to the node and have the same segment.
 1195:    // This is used to compute the average velocity at the node for open boundary nodes.
 1196:       int res = 0;
 1197:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1198:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1199: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1200:       return res;
 1201:    }
 1202: 
 1203: 
 1204:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1205:       assert(index == 0 || index == 1); 
 1206:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1207:    }
 1208: 
 1209: 
 1210: };
