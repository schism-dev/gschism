 2625:    template<typename T>
 2626:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2627:       T values[4];
 2628:       getNodalValues(field, values);
 2629: 
 2630:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2631:       if constexpr (IsVector2<T>::value && ics == 2) {
 2632: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2633:          projectNodeVectorsToElementFrame(values);
 2634: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2635:       }
 2636: 
 2637:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2638:    }
