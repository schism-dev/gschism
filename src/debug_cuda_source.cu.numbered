 6090: extern "C" {
 6091: 
 6092:    __global__ void scaleGravity(double loadtide_coef) {
 6093: 
 6094: 
 6095:       NODE(node);
 6096: 
 6097:       // SAL option: scale gravity
 6098:       if constexpr(iloadtide==2) {  // simple const
 6099:          node->grav2 = grav*(1.0 - loadtide_coef);
 6100: 
 6101:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6102:         
 6103:           const double depth = max(node->depth, 0.0);
 6104:           const double tmp1 = sqrt(depth);
 6105:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6106:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6107:                              2.6969e-13*depth*depth*depth*tmp1;
 6108:           
 6109:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6110:           
 6111: 
 6112: 
 6113:           node->grav2 = grav*(1.0 - beta_bar);
 6114: 
 6115:       } else {  // iloadtide=0,1
 6116:           node->grav2 = grav;
 6117: 
 6118:       }
 6119: 
 6120:    }
