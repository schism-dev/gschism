 2766: //       const double y4 = nodes[nxq(i+1)]->y;
 2767: 
 2768: //       const Side& side = sides[i];
 2769: 
 2770: //       xIntersect=-1.e25;
 2771: //       yIntersect=-1.e25;
 2772: 
 2773: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2774: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2775: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2776: 
 2777: //       if (delta != 0.0) {
 2778: //          // Solves the two linear equations for tt1 and tt2
 2779: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2780: //          const double tt2 = delta2/delta;
 2781: 
 2782: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2783: //          // Similarly, we use tt2 to compute the intersection point.
 2784: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2785: //             xIntersect = x3 + (x4 - x3)*tt2;
