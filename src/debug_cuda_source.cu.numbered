 2535: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2536: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2537: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2538: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2539: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2540: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2541:    Vector2 grad = {0.0, 0.0};
 2542:    int count = 0;
 2543: 
 2544:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2545: 
 2546:    // First element
 2547:    if (elems[0] != nullptr && condition(elems[0])) {
 2548:       grad += elems[0]->grad2(field);
 2549:       count++;
 2550:    }
 2551: 
 2552:    // Second element
 2553:    if (elems[1] != nullptr && condition(elems[1])) {
 2554:       grad += elems[1]->grad2(field);
 2555:       count++;
 2556:    }
 2557: 
 2558:    if (count > 0) {
 2559:       grad = grad/count;
 2560:    }
 2561:    
 2562:    return grad;
 2563: }
