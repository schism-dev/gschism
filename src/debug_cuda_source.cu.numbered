 8620: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8621:    Element *elems = mesh->localElemData;
 8622: 
 8623:    *addr = elems;
 8624:    *sizeElement = sizeof(Element);
 8625:    switch (varCode) {
 8626:       case (int)VarCode::z:
 8627:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8628:          *sizeType = sizeof(double);
 8629:          break;
 8630:       case (int)VarCode::x:
 8631:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8632:          *sizeType = sizeof(Vector2);
 8633:          break;
 8634:       case (int)VarCode::gradETP:
 8635:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8636:          *sizeType = sizeof(Vector2);
 8637:          break;
 8638:       case (int)VarCode::area:
 8639:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8640:          *sizeType = sizeof(double);
 8641:          break;
 8642:       case (int)VarCode::depth:
 8643:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8644:          *sizeType = sizeof(double);
 8645:          break;
 8646:       case (int)VarCode::radius:
 8647:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8648:          *sizeType = sizeof(double);
 8649:          break;
 8650:       case (int)VarCode::ghat:
 8651:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8652:          *sizeType = sizeof(Vector2);
 8653:          break;
 8654:       case (int)VarCode::kb:
 8655:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8656:          *sizeType = sizeof(int);
 8657:          break;
 8658:       case (int)VarCode::isdry:
 8659:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8660:          *sizeType = sizeof(int);
 8661:          break;            
 8662:       case (int)VarCode::w:
 8663:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8664:          *sizeType = sizeof(double);
 8665:          break;
 8666:       case (int)VarCode::FaceIndices:
 8667:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8668:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8669:          *sizeType = sizeof(Node);
 8670:          break;
 8671:       default:
 8672:          *offset = -1;
 8673:    }
 8674: }
 8675: 
