 8124: __global__ void printMatrix(bool full) {
 8125:    // Debugging: print the matrix
 8126: 
 8127:    const int size = mesh->np;
 8128:    double sum = 0.0;
 8129:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8130:       const Node *node = mesh->localNodeData + idx_node;
 8131:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8132:       for (int j = 0; j < node->numNodes; j++) {
 8133:          Node* nbNode = node->nodes[j];
 8134:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8135:          sum += node->coeffMatrix[j];
 8136:       }
 8137:       if (full) printf("]\n");
 8138: 
 8139: 
 8140:    }
 8141:    if (!full) printf("sum=%lf\n", sum);
 8142: }
