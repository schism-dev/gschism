 2306: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2307: // return;   
 2308:    // Lock the mutex
 2309:    lock(&debugPlotMutex);
 2310:  
 2311:    bool ok = true;
 2312:    if (debugPlotIdx == nullptr) ok = false;
 2313:    if (*debugPlotIdx >= 1000000) ok = false;
 2314:    if (ok) {
 2315:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2316:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2317:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2318:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2319:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2320:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2321:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2322:       (*debugPlotIdx)++;
 2323:    }
 2324: 
 2325:    __threadfence();               // ensure all above writes are visible
 2326:    // Unlock the mutex
 2327:    unlock(&debugPlotMutex);
 2328: 
 2329: }
 2330: 
 2331: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2332:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 2333: }
