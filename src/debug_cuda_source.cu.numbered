  883:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  884:     
  885:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  886:                                                  Element *&nextElem, int &jlev, double &dt,
