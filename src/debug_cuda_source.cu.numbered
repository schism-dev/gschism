 2001: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2002: {
 2003:     uintptr_t p = (uintptr_t)address;
 2004:     assert((p & 1) == 0);
 2005: 
 2006:     unsigned int* base = (unsigned int*)(p & ~3);
 2007:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2008:                                   :  (unsigned int)val;
 2009: 
 2010:     atomicAdd(base, addend);
 2011: }
