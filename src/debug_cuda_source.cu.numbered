 2114: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2115: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2116: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2117: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2118:    Vector2 grad = {0.0, 0.0};
 2119:    int count = 0;
 2120: 
 2121:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2122: 
 2123:    // First element
 2124:    if (elems[0] != nullptr && condition(elems[0])) {
 2125:       grad += elems[0]->grad2(field);
 2126:       count++;
 2127:    }
 2128: 
 2129:    // Second element
 2130:    if (elems[1] != nullptr && condition(elems[1])) {
 2131:       grad += elems[1]->grad2(field);
 2132:       count++;
 2133:    }
 2134: 
 2135:    if (count > 0) {
 2136:       grad = grad/count;
 2137:    }
 2138:    
 2139:    return grad;
 2140: }
