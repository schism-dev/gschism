 8202:       case (int)VarCode::outputCoords:
 8203:          const Point2 coords = side->outputCoords();
 8204:          res[side->idx*2    ] = coords.x;
 8205:          res[side->idx*2 + 1] = coords.y;
 8206:          break;
 8207:    }
 8208: }
