 1570: __device__ __inline__ double min3(double a, double b, double c) {
 1571:    return min(a, min(b, c));
 1572: }
 1573: 
 1574: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1575:    return min(a, min(b, min(c, d)));
 1576: }
