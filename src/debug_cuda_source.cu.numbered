 2001: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2002: // return;   
 2003:    // Lock the mutex
 2004:    lock(&debugPlotMutex);
 2005:  
 2006:    bool ok = true;
 2007:    if (debugPlotIdx == nullptr) ok = false;
 2008:    if (*debugPlotIdx >= 1000000) ok = false;
 2009:    if (ok) {
 2010:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2011:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2012:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2013:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2014:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2015:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2016:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2017:       (*debugPlotIdx)++;
 2018:    }
 2019: 
 2020:    __threadfence();               // ensure all above writes are visible
 2021:    // Unlock the mutex
 2022:    unlock(&debugPlotMutex);
 2023: 
 2024: }
