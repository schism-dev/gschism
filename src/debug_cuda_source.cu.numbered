 1076: struct BoundarySegment {
 1077: 
 1078:    bool isLand;
 1079: 
 1080:    double clen;  // Length of the boundary segment
 1081:    double carea; // Area of the boundary segment
 1082: 
 1083:    int ifltype;  // Type of flow boundary condition
 1084:    
 1085:    // Elevation boundary condition
 1086:    int iettype;  // Type of elevation boundary condition
 1087:    double eth;   // Elevation time history
 1088: 
 1089:    // Flow boundary condition
 1090:    double qthcon;  // Flow time history constant
 1091:    double vobc1;   // Velocity coefficient 1
 1092:    double vobc2;   // Velocity coefficient 2
 1093: 
 1094:    // Tracer boundary conditions
 1095:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1096:    // int  itrtype[natrm];    // Tracer boundary condition type
 1097: 
 1098:    BoundarySegment(bool _isLand) {
 1099:       isLand = _isLand;
 1100:       clen = 0.0;
 1101:       carea = 0.0;
 1102:       ifltype = 0;
 1103:       iettype = 0;
 1104:       eth = 0.0;
 1105:    }
 1106: 
 1107:    BoundarySegment(void) {
 1108:       isLand = false;
 1109:       clen = 0.0; 
 1110:       carea = 0.0;
 1111:       ifltype = 0;
 1112:       iettype = 0;
 1113:       eth = 0.0;
 1114:    }
 1115: 
 1116:    
 1117: };
