 3383: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3384:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3385:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3386:                 int *isdel, int *isidenode, int *isbnd,
 3387:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3388:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3389:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3390:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3391:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3392:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3393:                 double *drag, double *roughness,
 3394:                 double *emo, double *efa, 
 3395:                 double *umo, double *ufa, 
 3396:                 double *vmo, double *vfa) {
 3397: 
 3398:    // printf("Populating mesh for partition %d\n", partNum);
 3399: 
 3400:    // XXXXXX THIS function does almost nothing. 
 3401: 
 3402:    nbs = *sharedIdxSideBoundary + 1;
 3403:    nbp = *sharedIdxNodeBoundary + 1;
 3404: 
 3405:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3406: 
 3407: }
