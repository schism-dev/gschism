 1584: // Helper functions for computing the local node index at a given offset from another.
 1585: __device__ __inline__ int nxq(int offset, int index, int size) {
 1586:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1587:    // to the index to make it positive
 1588:    assert(index + offset + 16*size >= 0);
 1589:    return (index + offset + 16*size) % size;  
 1590: }
 1591: 
 1592: __device__ __inline__ int nxq(int index, int size) {
 1593:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1594:    // to the index to make it positive
 1595:    assert(index + 16*size >= 0);
 1596:    return (index + 16*size) % size; 
 1597: }
