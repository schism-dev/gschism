 8150: #ifdef OLD_PCG_SOLVER
 8151: __global__ void computeMatrixProductAndDotProducts() {
 8152:    // Computes A*p, r'Mr and p'Ap
 8153: 
 8154:    // 1) shared buffer: first half for rMr, second for pAp
 8155:    __shared__ double sdata[2*BLOCK_SIZE];
 8156:    double* s_rMr = sdata;
 8157:    double* s_pAp = sdata + BLOCK_SIZE;
 8158: 
 8159:    const int tid = threadIdx.x;
 8160: 
 8161:    double l_pAp = 0.0;
 8162: 
 8163:    s_rMr[tid] = 0.0;
 8164:    s_pAp[tid] = 0.0;
 8165: 
 8166:    // 2) get your node pointer
 8167:    // NODE(node);   
 8168:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8169:    Node *node = &(mesh->localNodeData[idx_node]); 
 8170:       if (idx_node < mesh->np) {
 8171: 
 8172:       const double diag = node->coeffDiag;
 8173:       const double r    = node->mR;
 8174:       const double p    = node->mP;  
 8175: 
 8176:       // apply preconditioner on the fly:
 8177:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8178: 
 8179:       // 4) compute Ap = A.p
 8180:       double Ap = node->coeffDiag * node->mP;
 8181:       for (int j = 0; j < node->numNodes; ++j) {
 8182:          const Node *nbNode = node->nodes[j];
 8183:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8184: 
 8185:       }
 8186: 
 8187:       node->mAp = Ap;
 8188:       
 8189: 
 8190:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8191:       // const double l_rMr = r*Mr;  // r'Mr
 8192:       l_pAp = p*Ap;  // p'Ap
 8193: 
 8194: 
 8195:    }
 8196: 
 8197:    // 6) write into shared mem
 8198:    // s_rMr[tid] = l_rMr;
 8199:    s_pAp[tid] = l_pAp;
 8200: 
 8201:    __syncthreads();
 8202: 
 8203:    // 7) block-wide tree reduction
 8204:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8205:       if (tid < stride)  {
 8206:          s_pAp[tid] += s_pAp[tid + stride];
 8207:       }
 8208:       __syncthreads();
 8209:    }
 8210: 
 8211:    // 8) thread 0 atomically accumulates into the globals
 8212:    // XXX: This is slower than it needs to be, but it is simple and works
 8213:    if (tid == 0) {
 8214:       atomicAdd(pAp, s_pAp[0]);
 8215:    }
 8216: 
 8217: 
 8218: }
 8219: 
 8220: 
 8221: __global__ void updateSolutionAndDotProducts(void) {
 8222:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8223: 
 8224:    const int tid = threadIdx.x;
 8225: 
 8226:    s_rMr[tid] = 0.0;
 8227: 
 8228:    // get node & bounds-check:
 8229:    NODE(node);
 8230: 
 8231:    
 8232:    // Compute alpha
 8233:    const double alpha = (*rMr_old)/(*pAp); 
 8234: 
 8235: 
 8236:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8237: 
 8238: 
 8239:    // load scalars
 8240:    const double diag = node->coeffDiag;
 8241:    const double p    = node->mP;
 8242:    const double Ap   = node->mAp;
 8243:    const double x    = node->mX;
 8244:    const double r    = node->mR;
 8245:    
 8246:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8247: 
 8248:    // 1) update solution & residual
 8249:    const double x_new = x + alpha*p;
 8250:    const double r_new = r - alpha*Ap;
 8251:    node->mX = x_new;
 8252:    node->mR = r_new;
 8253: 
 8254:    // 2) apply Jacobi preconditioner on the fly
 8255:    const double Mr_new = r_new/diag;
 8256: 
 8257: 
 8258:    // 3) local contributions for the two dot-products
 8259:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8260: 
 8261:    // 4) write into shared-mem
 8262:    s_rMr[tid] = l_rMr;
 8263: 
 8264:    __syncthreads();
 8265: 
 8266: 
 8267:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8268:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8269:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8270:       __syncthreads();
 8271:    }
 8272: 
 8273:    // 6) thread 0 atomically folds into the global accumulators
 8274:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8275: 
 8276: 
 8277: }
 8278: 
 8279: 
 8280: __global__ void updateSearchDirection() {
 8281: 
 8282:     NODE(node);
 8283: 
 8284:     // recompute z on-the-fly
 8285:     const double z = node->mR / node->coeffDiag;
 8286:     const double p = node->mP;
 8287: 
 8288:     const double beta = (*rMr_new)/(*rMr_old);
 8289: 
 8290: 
 8291:     // p =z + beta*p
 8292:     node->mP = z + beta*p;
 8293: 
 8294: }
 8295: 
 8296: __global__ void initializeScalars(double *scalars) {
 8297: 
 8298:    // These point to a cupy array in the host code
 8299:    rMr_old = scalars + 0;
 8300:    rMr_new = scalars + 1;
 8301:    pAp     = scalars + 2;
 8302: }
 8303: 
 8304: __global__ void initializePreconditionedResidual(void) {
 8305: 
 8306:     __shared__ double s_rMr[BLOCK_SIZE];  
 8307: 
 8308:     s_rMr[threadIdx.x] = 0.0;
 8309: 
 8310:     NODE_ALL(node, valid);
 8311:     const int tid = threadIdx.x;
 8312:     // For the first iteration:
 8313:     // 1. Initial solution x = 0 (already set)
 8314:     // 2. Initial residual r = b (stored in qel)
 8315:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8316: 
 8317: // XXX we should use the guess solution here    
 8318: 
 8319:     double l_rMr = 0.0;
 8320:     if (valid) {
 8321:       // Set initial residual r = b (from qel)
 8322:       node->mR = node->qel;
 8323: 
 8324:       // Compute z = M^-1 * r (preconditioned residual)
 8325:       const double z = node->mR / node->coeffDiag;
 8326: 
 8327:       // Set initial search direction p = z
 8328:       node->mP = z;
 8329: 
 8330:       // Initialize other variables needed for CG
 8331:       node->mX = 0.0;  // Initial solution
 8332:       node->mAp = 0.0; // Will be computed in first iteration
 8333: 
 8334: 
 8335:       // Computes the first r'Mr (reduction)
 8336:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8337:     }
 8338:     // 4) write into shared-mem
 8339:     s_rMr[tid] = l_rMr;
 8340: 
 8341:     __syncthreads();
 8342: 
 8343: 
 8344:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8345:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8346:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8347:         __syncthreads();
 8348:     }
 8349: 
 8350:     // 6) thread 0 atomically folds into the global accumulators
 8351:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8352: 
 8353:     *rMr_old = 0.0;
 8354:     *pAp = 0.0;
 8355: }
 8356: #endif
 8357: 
 8358: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8359: 
 8360:    ELEM(elem);
 8361: 
 8362:    switch (varCode) {
 8363:       case (int)VarCode::outputCoords:
 8364:          const Point2 coords = elem->outputCoords();
 8365:          res[elem->idx*2    ] = coords.x;
 8366:          res[elem->idx*2 + 1] = coords.y;
 8367:          break;
 8368:    }
 8369: }
