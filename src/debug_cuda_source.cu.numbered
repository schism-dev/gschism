 1465: struct Side {
 1466: 
 1467:    // Geometry information
 1468:    int idx;               // Index of the side
 1469:    Node *n1, *n2;
 1470:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1471: 
 1472:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1473:    Vector2 center;        // Location of side center. 
 1474:    double zc[nvrt];       // Side center z-coord at each vertical level
 1475: 
 1476:    Frame<ics> frame;
 1477:    
 1478:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1479:                           // this is nullptr
 1480:    
 1481:    int16_t kb;            // Bottom index of the side
 1482:    bool isDry;            // True if the side is dry
 1483:  
 1484:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1485: 
 1486:    // Physical information
 1487:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1488:    Vector2 btu[nvrt];           // Back-tracked velocity
 1489:    Vector2 U;                   // Vertically averaged velocity vector  
 1490: 
 1491:    Vector2 nuGradU[nvrt];       // nu*grad u
 1492: 
 1493:    Vector2 bcc[nvrt];           // Baroclinic term
 1494:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1495: 
 1496:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1497:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1498:    Vector2 gradPr;               // Gradient of pressure
 1499:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1500: 
 1501: 
 1502:    double hhat;                 // \breve{H} in notes
 1503: 
 1504:    double shapiro;
 1505: 
 1506:    double coriolis;             // Coriolis parameter
 1507: 
 1508:    // Vegetation parameters
 1509:    double veg_c2;
 1510:    double veg_beta;
 1511: 
 1512:    // Bottom drag parameters.
 1513:    double chi;
 1514:    double chi2;
 1515: 
 1516:    // Transport model
 1517:    TransportSide<transportModel> transport; // Transport model 
 1518: 
 1519:    __inline__ __device__ Point2 outputCoords(void) const;
 1520: 
