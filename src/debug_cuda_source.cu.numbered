 2082: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2083: // return;   
 2084:    // Lock the mutex
 2085:    lock(&debugPlotMutex);
 2086:  
 2087:    bool ok = true;
 2088:    if (debugPlotIdx == nullptr) ok = false;
 2089:    if (*debugPlotIdx >= 10000) ok = false;
 2090:    if (ok) {
 2091:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 2092:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 2093:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 2094:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 2095:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 2096:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2097:       debugPlot[(*debugPlotIdx) + 6*10000] = (double)label;
 2098:       (*debugPlotIdx)++;
 2099:    }
 2100: 
 2101:    __threadfence();               // ensure all above writes are visible
 2102:    // Unlock the mutex
 2103:    unlock(&debugPlotMutex);
 2104: 
 2105: }
