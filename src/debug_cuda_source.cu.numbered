 3882:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3883: 
 3884:       NODE_BND(nodeBnd);
 3885: 
 3886:       Node *node = nodeBnd->node;
 3887: 
 3888:       node->ETP = 0.0;
 3889: 
 3890:       for (int j=0; j<ntip; j++) {
 3891: 
 3892:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3893:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3894:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3895: 
 3896:          if constexpr(iloadtide==1) { // loading tide
 3897:             assert(false && "Loading tide not implemented");
 3898:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3899:          }
 3900:          
 3901:       }
 3902:       
 3903:    }
