 8190: #ifdef OLD_PCG_SOLVER
 8191: __global__ void computeMatrixProductAndDotProducts() {
 8192:    // Computes A*p, r'Mr and p'Ap
 8193: 
 8194:    // 1) shared buffer: first half for rMr, second for pAp
 8195:    __shared__ double sdata[2*BLOCK_SIZE];
 8196:    double* s_rMr = sdata;
 8197:    double* s_pAp = sdata + BLOCK_SIZE;
 8198: 
 8199:    const int tid = threadIdx.x;
 8200: 
 8201:    double l_pAp = 0.0;
 8202: 
 8203:    s_rMr[tid] = 0.0;
 8204:    s_pAp[tid] = 0.0;
 8205: 
 8206:    // 2) get your node pointer
 8207:    // NODE(node);   
 8208:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8209:    Node *node = &(mesh->localNodeData[idx_node]); 
 8210:       if (idx_node < mesh->np) {
 8211: 
 8212:       const double diag = node->coeffDiag;
 8213:       const double r    = node->mR;
 8214:       const double p    = node->mP;  
 8215: 
 8216:       // apply preconditioner on the fly:
 8217:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8218: 
 8219:       // 4) compute Ap = A.p
 8220:       double Ap = node->coeffDiag * node->mP;
 8221:       for (int j = 0; j < node->numNodes; ++j) {
 8222:          const Node *nbNode = node->nodes[j];
 8223:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8224: 
 8225:       }
 8226: 
 8227:       node->mAp = Ap;
 8228:       
 8229: 
 8230:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8231:       // const double l_rMr = r*Mr;  // r'Mr
 8232:       l_pAp = p*Ap;  // p'Ap
 8233: 
 8234: 
 8235:    }
 8236: 
 8237:    // 6) write into shared mem
 8238:    // s_rMr[tid] = l_rMr;
 8239:    s_pAp[tid] = l_pAp;
 8240: 
 8241:    __syncthreads();
 8242: 
 8243:    // 7) block-wide tree reduction
 8244:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8245:       if (tid < stride)  {
 8246:          s_pAp[tid] += s_pAp[tid + stride];
 8247:       }
 8248:       __syncthreads();
 8249:    }
 8250: 
 8251:    // 8) thread 0 atomically accumulates into the globals
 8252:    // XXX: This is slower than it needs to be, but it is simple and works
 8253:    if (tid == 0) {
 8254:       atomicAdd(pAp, s_pAp[0]);
 8255:    }
 8256: 
 8257: 
 8258: }
 8259: 
 8260: 
 8261: __global__ void updateSolutionAndDotProducts(void) {
 8262:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8263: 
 8264:    const int tid = threadIdx.x;
 8265: 
 8266:    s_rMr[tid] = 0.0;
 8267: 
 8268:    // get node & bounds-check:
 8269:    NODE(node);
 8270: 
 8271:    
 8272:    // Compute alpha
 8273:    const double alpha = (*rMr_old)/(*pAp); 
 8274: 
 8275: 
 8276:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8277: 
 8278: 
 8279:    // load scalars
 8280:    const double diag = node->coeffDiag;
 8281:    const double p    = node->mP;
 8282:    const double Ap   = node->mAp;
 8283:    const double x    = node->mX;
 8284:    const double r    = node->mR;
 8285:    
 8286:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8287: 
 8288:    // 1) update solution & residual
 8289:    const double x_new = x + alpha*p;
 8290:    const double r_new = r - alpha*Ap;
 8291:    node->mX = x_new;
 8292:    node->mR = r_new;
 8293: 
 8294:    // 2) apply Jacobi preconditioner on the fly
 8295:    const double Mr_new = r_new/diag;
 8296: 
 8297: 
 8298:    // 3) local contributions for the two dot-products
 8299:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8300: 
 8301:    // 4) write into shared-mem
 8302:    s_rMr[tid] = l_rMr;
 8303: 
 8304:    __syncthreads();
 8305: 
 8306: 
 8307:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8308:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8309:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8310:       __syncthreads();
 8311:    }
 8312: 
 8313:    // 6) thread 0 atomically folds into the global accumulators
 8314:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8315: 
 8316: 
 8317: }
 8318: 
 8319: 
 8320: __global__ void updateSearchDirection() {
 8321: 
 8322:     NODE(node);
 8323: 
 8324:     // recompute z on-the-fly
 8325:     const double z = node->mR / node->coeffDiag;
 8326:     const double p = node->mP;
 8327: 
 8328:     const double beta = (*rMr_new)/(*rMr_old);
 8329: 
 8330: 
 8331:     // p =z + beta*p
 8332:     node->mP = z + beta*p;
 8333: 
 8334: }
 8335: 
 8336: __global__ void initializeScalars(double *scalars) {
 8337: 
 8338:    // These point to a cupy array in the host code
 8339:    rMr_old = scalars + 0;
 8340:    rMr_new = scalars + 1;
 8341:    pAp     = scalars + 2;
 8342: }
 8343: 
 8344: __global__ void initializePreconditionedResidual(void) {
 8345: 
 8346:     __shared__ double s_rMr[BLOCK_SIZE];  
 8347: 
 8348:     s_rMr[threadIdx.x] = 0.0;
 8349: 
 8350:     NODE_ALL(node, valid);
 8351:     const int tid = threadIdx.x;
 8352:     // For the first iteration:
 8353:     // 1. Initial solution x = 0 (already set)
 8354:     // 2. Initial residual r = b (stored in qel)
 8355:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8356: 
 8357: // XXX we should use the guess solution here    
 8358: 
 8359:     double l_rMr = 0.0;
 8360:     if (valid) {
 8361:       // Set initial residual r = b (from qel)
 8362:       node->mR = node->qel;
 8363: 
 8364:       // Compute z = M^-1 * r (preconditioned residual)
 8365:       const double z = node->mR / node->coeffDiag;
 8366: 
 8367:       // Set initial search direction p = z
 8368:       node->mP = z;
 8369: 
 8370:       // Initialize other variables needed for CG
 8371:       node->mX = 0.0;  // Initial solution
 8372:       node->mAp = 0.0; // Will be computed in first iteration
 8373: 
 8374: 
 8375:       // Computes the first r'Mr (reduction)
 8376:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8377:     }
 8378:     // 4) write into shared-mem
 8379:     s_rMr[tid] = l_rMr;
 8380: 
 8381:     __syncthreads();
 8382: 
 8383: 
 8384:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8385:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8386:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8387:         __syncthreads();
 8388:     }
 8389: 
 8390:     // 6) thread 0 atomically folds into the global accumulators
 8391:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8392: 
 8393:     *rMr_old = 0.0;
 8394:     *pAp = 0.0;
 8395: }
 8396: #endif
 8397: 
 8398: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8399: 
