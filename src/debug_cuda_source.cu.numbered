 4040:    __global__ void computeFlowBcVelocities(double time) {
 4041: 
 4042:       SIDE_BND(sideBnd);
 4043: 
 4044:       const Side *side = sideBnd->side;
 4045:  
 4046:       const bool isDry = side->isDry;
 4047: 
 4048:       if (isDry) {
 4049:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4050:          return;
 4051:       }
 4052: 
 4053:       // For wet sides in open boundaries...
 4054:       const Vector2 n = side->n;
 4055:       const BoundarySegment *segment = sideBnd->segment;
 4056: 
 4057:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4058: 
 4059:       const int ifltype = segment->ifltype;
 4060:       const int iettype = segment->iettype;
 4061: 
 4062:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4063:       const Vector2 r_nuth0 = r_uth0*n;
 4064: 
 4065:       Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4066:       Vector2 r_u1_bar = {0.0, 0.0};
 4067: printf("ZZZ4  idx = %d, ifltype = %d, r_nuth0 = %f, %f\n", sideBnd->side->idx, ifltype, r_nuth0.x, r_nuth0.y);
 4068:       for (int k = 0; k < nvrt; k++) {
 4069:          if (ifltype == 1 || ifltype == 2) {
 4070:          
 4071:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4072: 
 4073:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4074:             
 4075:             r_uth = unth0*n;  // This case has no ramp-up
 4076:             
 4077:          } else if (ifltype == -1) { // Flather 1
 4078: 
 4079:             // uth is the normal vel.; no ramp up
 4080:             const double uth = sideBnd->nuth(k);
 4081:             r_uth = uth*n;
 4082:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4083: 
 4084: 
 4085:          } else if (ifltype == 3 || ifltype == 5) {
 4086:             // vnth0=0 !normal vel.
 4087: 
 4088: printf("ZZZ3  idx = %d, jfr = %d, ifltype = %d, r_uth = %f, %f\n", sideBnd->side->idx, nbfr, ifltype, r_uth.x, r_uth.y);
 4089:             // Computes the contribution to the velocity from all tide frequencies
 4090:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4091: 
 4092:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4093:                const Vector2 umo  = sideBnd->umo(jfr); 
 4094: 
 4095:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4096:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4097:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4098:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4099: printf("ZZZ2  idx = %d, jfr = %d, argx = %f, argy = %f, umo = %f, %f, ufa = %f, %f, ramp = %f, ff = %f\n", sideBnd->side->idx, jfr, argx, argy, umo.x, umo.y, ufa.x, ufa.y, ramp, ff[jfr]);               
 4100:             }
 4101: 
 4102:          } // if (ifltype = 3 || ifltype == 5
 4103: 
 4104: 
 4105:          switch (iettype) {
 4106:             case 1:
 4107:             case 2:
 4108:             case 4:
 4109:                sideBnd->ubc[k] = r_uth;
 4110:                break;
 4111:             case 3:
 4112:                sideBnd->ubc[k] = r_u1_bar;
 4113:                break;
 4114:             case 5:
 4115:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4116:                break;
 4117:          } // switch
 4118: 
 4119: printf("ZZZ  idx = %d, iettype = %d, r_u1_bar = %f, %f, sideBnd->ubc[%d] = %f, %f\n", sideBnd->side->idx, iettype, r_u1_bar.x, r_u1_bar.y, k, sideBnd->ubc[k].x, sideBnd->ubc[k].y);
 4120:       } // for k
 4121:    }
 4122: 
 4123:    __global__ void computeElevationBoundaryConditions(double time) {
 4124:       // Compute elevation essential boundary conditions 
 4125: 
 4126:       NODE_BND(nodeBnd); // Each boundary node.
 4127: 
 4128:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4129: 
 4130:       const Node *node = nodeBnd->node;
 4131:       const BoundarySegment *segment = nodeBnd->segment;
 4132:       const int iettype = segment->iettype;
 4133:       
 4134: 
 4135:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4136:       double eic = 0.0;
 4137:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4138:       else                 eic = 0.0;
 4139: 
 4140:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4141:       const double r_eth = ramp*nodeBnd->eth;
 4142:       double r_eta1_bar = 0.0;
 4143: 
 4144: 
 4145:       // Compute tide elevation
 4146:       if (iettype == 3 || iettype == 5) {   
 4147: 
 4148:          if constexpr(iloadtide==1) { // loading tide
 4149:             assert(false && "Loading tide not implemented");
 4150:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4151:          }
 4152:          
 4153:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4154: 
 4155:             const double efa  = nodeBnd->efa[jfr]; 
 4156:             const double emo  = nodeBnd->emo[jfr]; 
 4157: 
 4158:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4159:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4160:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4161: 
 4162:          } // for jfr
 4163: 
 4164:       } // if iettype
 4165: 
 4166:       switch (iettype) {
 4167:          case 1:
 4168:          case 2:
 4169:          case 4:
 4170:             nodeBnd->elbc = r_eic + r_eth;
 4171:             break;
 4172:          case 3:
 4173:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4174:             break;
 4175:          case 5:
 4176:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4177:             break;
 4178:       } // switch
 4179: 
 4180: 
 4181:       //Add inverse barometric effects
 4182:       if (iettype != 0 && inv_atm_bnd == 1) {
 4183:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4184:       }
 4185: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 4186:    }
 4187: 
 4188: 
 4189:    __global__ void computeHorizontalViscosity(void) { 
 4190: 
 4191:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4192: 
 4193:       SIDE(side);
 4194: 
 4195:       if (side->isDry) return;
 4196: 
 4197:       for (int k = 0; k < nvrt; k++) {
 4198:          side->nuGradU[k] = {0.0, 0.0};
 4199:       }
 4200: 
 4201:       if constexpr(ihorcon == 1) {
 4202:          for (int k = side->kb; k < nvrt - 1; k++) {
 4203:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4204:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4205:             // By Zhang and Baptista.
 4206: 
 4207:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4208:             // This is a standard discretization of the Laplacian operator.
 4209:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4210:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4211:             // Gamma is hvis_coef0 in the code.
 4212:             // The value of gamma needs to be < 0.5.
 4213: 
 4214:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4215:             // side under consideration in each of the two possible elements that share the side.
 4216:             Vector2 sumU = {0.0, 0.0};
 4217:             for (int l = 0; l < 2; l++) {
 4218:                const Element *elem = side->elems[l];
 4219: 
 4220:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4221: 
 4222:                // Find the local index of the side in the element
 4223:                const int idxSide = elem->sideLocalIdx(side);
 4224:                // Find the two sides that are connected to the side under consideration
 4225:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4226:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4227: 
 4228:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4229: 
 4230:             }
 4231: 
 4232:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4233:    printf("+++++ side->nuGradU = %f, %f\n", side->nuGradU[k].x, side->nuGradU[k].y);
 4234: 
 4235:    
 4236:          }
 4237:       }
 4238:       else if constexpr(ihorcon == 2) {
 4239:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4240:       }
 4241: 
 4242: 
 4243:    }
 4244: 
 4245: 
 4246:    __global__ void setEssentialBC(void) {
 4247:       // Set essential boundary conditions 
 4248:       NODE(node); // Each boundary node
 4249:       NodeBoundary *nodeBnd = node->nodeBnd;
 4250: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 4251:       
 4252: // nodeBnd->isEssentialBC = true;      
 4253:       // Check if this node has essential BC
 4254:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4255:          // Verify BC value is valid
 4256:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4257: 
 4258:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 4259:          
 4260:          // Set diagonal to 1 and zero off-diagonals
 4261:          node->coeffDiag = 1.0;
 4262:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 4263: 
 4264:          for (int j = 0; j < node->numNodes; j++) {
 4265:                node->coeffMatrix[j] = 0.0;
 4266:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4267:          }
 4268:          
 4269:          // Set solution and RHS to BC value
 4270:          node->mX  = nodeBnd->elbc;
 4271:          node->qel = nodeBnd->elbc;
 4272: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 4273:       } else {
 4274:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4275: 
 4276:          for (int j = 0; j < node->numNodes; j++) {
 4277:                Node* nbNode = node->nodes[j];
 4278:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4279:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4280:                   // Verify neighbor's BC value
 4281:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4282: 
 4283:                   // Subtract contribution to RHS
 4284:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4285:                   node->coeffMatrix[j] = 0.0;  
 4286:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4287:                }
 4288:          }
 4289:       }
 4290:    }
 4291: 
 4292: 
 4293:    __global__ void updateElevation(void) {
 4294:       NODE(node);
 4295: 
 4296:       node->eta2 = node->mX;
 4297: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 4298:    }
 4299: 
