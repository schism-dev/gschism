 8279: __global__ void printMatrix(bool full) {
 8280:    // Debugging: print the matrix
 8281: 
 8282:    const int size = mesh->np;
 8283:    double sum = 0.0;
 8284:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8285:       const Node *node = mesh->localNodeData + idx_node;
 8286:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8287:       for (int j = 0; j < node->numNodes; j++) {
 8288:          Node* nbNode = node->nodes[j];
 8289:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8290:          sum += node->coeffMatrix[j];
 8291:       }
 8292:       if (full) printf("]\n");
 8293: 
 8294: 
 8295:    }
 8296:    if (!full) printf("sum=%lf\n", sum);
 8297: }
