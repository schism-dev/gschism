 4267:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4268: 
 4269:       SIDE(side);
 4270: 
 4271: 
 4272:       side->U = {0.0, 0.0}; 
 4273:          
 4274:       if(side->isDry) return;
 4275: 
 4276:       const Node *node1 = side->n1;
 4277:       const Node *node2 = side->n2;
 4278: 
 4279:       // Vertically integrated velocity U (in ll if ics=2)
 4280:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4281:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4282:       }
 4283: 
 4284:    }
 4285: 
 4286:    __global__ void computeBottomDragVegetation(void) {
 4287:       // UNFINISHED. CHECK THIS:
 4288:       // How many kernels are needed? Why so many for loops?
 4289:       // Is the loop on sides needed?
 4290: 
 4291:       NODE(node);
 4292: 
 4293:       const int    kb      = node->kb;
 4294:       const double htot    = node->htot2();
 4295:       const double rough   = node->rough;
 4296: 
 4297: 
 4298:       if (node->isDry) {
 4299:          // Default values for dry nodes
 4300:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4301:          /// XXX CHECK INDICES
 4302:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4303:       }
 4304: 
 4305:       // Compute bottom drag Cd
 4306:       //--------------------------------
 4307: 
 4308:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4309:       if constexpr(nchi == 1) {
 4310: 
 4311:          bool ltmp = false; // for WBL iteration
 4312: 
 4313:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4314:          // Drag at nodes
 4315:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4316:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4317:         
 4318:          const double rough = node->rough;
 4319:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4320:          if (node->rough == 0.0) {
 4321:             node->Cd = 0.0;
 4322: 
 4323:          } else { //roughness >0 
 4324:             
 4325:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4326:             const double bthick = max(dzb_min, bthick_ori);
 4327: 
 4328:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4329: 
 4330:             double tmp = 1.0/(2.5*log(bthick/rough));
 4331:             node->Cd = tmp*tmp;
 4332: 
 4333:          } // if rough
 4334: 
 4335: 
 4336:          // RECOVER THIS: XXX
 4337:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4338:          // Output warning for WBL if iteration didn't converge
 4339: 
 4340: 
 4341:       } // nchi==1
 4342: 
 4343:       //   Bottom stress in m^2/s^2
 4344:       if (node->rho[kb + 1] >= -98.0)
 4345:       {
 4346:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4347:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4348: 
 4349:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4350:          // !sediment erosion: this part needs more documentation
 4351:       }
 4352: 
 4353:     
 4354:       // Compute vegetation parameters
 4355:       //--------------------------------
 4356: 
 4357:       // SAV constants
 4358:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4359:       constexpr double veg_cfpsi = 0.16;
 4360: 
 4361:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4362:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4363: 
 4364:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4365:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4366:          int kbin = 0; // bin index
 4367:          for (int k = kb; k < nvrt; k++) {
 4368:             // Computes node height above the bottom level
 4369:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4370:             assert(false && "Vertical variation of vegetation not implemented");
 4371: 
 4372:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4373:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4374:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4375:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4376:             // } else {
 4377:             //    // Find the bin at which the current vertical level is
 4378:             //    while (kbin<nbins_veg_vert) {
 4379:             //       const double zn = node->z[kbin];
 4380:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4381:             //          break;
 4382:             //       } // if
 4383:             //       kbin++;
 4384:             //    } // while
 4385:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4386: 
 4387:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4388:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4389:                
 4390:             //    // Linear interpolation of the vegetation parameters
 4391:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4392:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4393:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4394:             // } // if rl10
 4395: 
 4396:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4397: 
 4398:          } // for k
 4399: 
 4400: 
 4401:       } else { // Ganthy (iveg=2)
 4402:       //  Modify canopy height, diameter, and density
 4403: 
 4404:          // Make sure there is vegetation on this node
 4405:          if (node->veg_h_unbent > 0.0) {
 4406:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4407: 
 4408:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4409:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4410:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4411: 
 4412:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4413:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4414:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4415:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4416:          } // if veg_h_unbent
 4417: 
 4418:          for (int k = 0; k < nvrt; k++) {
 4419:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4420:          } // for k
 4421:       
 4422: 
 4423:       } // if iveg
 4424:      
 4425:          
 4426: 
 4427:       // Compute vertical mean of veg_alpha3D
 4428:       if (iveg != 0) {
 4429:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4430:          double sum1=0.0;
 4431:          double sum2=0.0;
 4432:          // Integrate over each level under the canopy...
 4433:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4434:             const double Dz = node->Dz(k);
 4435: 
 4436:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4437:             sum2 += Dz;
 4438: 
 4439:          } // for k
 4440: 
 4441:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4442:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4443: 
 4444:       } // if iveg
 4445: 
 4446:    }
 4447: 
 4448:    __global__ void computeVegetationAndDragParameters(void) {
 4449:       // Computes the vegetation and drag model parameters:
 4450:       // chi, \tilde\chi, beta, \breve{H}
 4451:       
 4452:       SIDE(side);
 4453: 
 4454:       const double htot = side->htot2();
 4455:       const int    kb   = side->kb;
 4456: 
 4457:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4458: 
 4459:       const double veg_h     = side->veg_h();
 4460:       const double veg_nv    = side->veg_nv();
 4461:       const double veg_c     = side->veg_c();
 4462:       const double veg_beta  = side->veg_beta;
 4463:       const double veg_alpha = side->veg_alpha_vert_mean();
 4464: 
 4465:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4466:       // Velocity magnitude at the bottom level
 4467:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4468:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4469:       side->chi2 = side->Cd()*vmag1;
 4470:       side->chi  = side->chi2;
 4471:       if constexpr(iveg != 0) {
 4472:          const Node *n1 = side->n1;
 4473:          const Node *n2 = side->n2;
 4474:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4475:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4476:       }
 4477: 
 4478:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4479: 
 4480:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4481:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4482:       double magUa = 0.0;
 4483:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4484:          // 3D wet side with veg...
 4485: 
 4486:          double magUa = 0.0;
 4487:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4488:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4489: 
 4490:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4491:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4492:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4493: 
 4494:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4495:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4496: 
 4497:                // Velocity magnitude at the bottom (l) of the level
 4498:                const double ul = length(side->u2[k]);
 4499: 
 4500:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4501:                magUa += Dz*0.5*(uh + ul);
 4502: 
 4503:             } // if HasVegetation
 4504:          } // for k
 4505:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4506: 
 4507:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4508:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4509:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4510:             const double zCpy = side->zTopCanopy();
 4511:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4512:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4513:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4514:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4515:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4516:          } // if isSubmerged
 4517:       } // if iveg   
 4518: 
 4519:       // Computes the friction modified depth, \breve{H} in notes
 4520:       if (side->is2D()) { // 2D
 4521: 
 4522:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4523:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4524: 
 4525:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4526: 
 4527:          side->hhat = htot*htot/fricH; 
 4528: 
 4529:       } else { // 3D
 4530:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4531: 
 4532:          if constexpr(iveg != 0) {
 4533:             
 4534:             if (side->isSubmerged()) { 
 4535:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4536:                side->hhat -= veg_c*Hhat_alpha;
 4537: 
 4538:             } else { // Emergent
 4539:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4540:             }
 4541:          } // if iveg
 4542: 
 4543:          // Enforce positivity for 3D model
 4544:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4545:       } // if 3D
 4546: 
 4547:    }
 4548: 
 4549: 
 4550: 
 4551:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4552:    // Computes the density gradient between two elements, e1 and e2.
 4553:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4554:    // zero in the direction normal to the side. 
 4555:    // 
 4556:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4557:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4558:    //
 4559:    // Input:
 4560:    //    e1: Element
 4561:    //    e2: Neighbor element (or nullptr if boundary)
 4562:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4563:    //    k: Index of the half-level at which the density is interpolated
 4564:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4565:    // 
 4566:    // Output:
 4567:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4568:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4569: 
 4570:       if (e2 == nullptr || e2->isDry) {
 4571:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4572: 
 4573:          Side *side = e1->sides[j];
 4574:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4575:                  
 4576:          if constexpr(ics == 1) {
 4577:             vec = side->n; // Normal vector to the side
 4578:          } else {
 4579:             // IMPLEMENT THIS XXXXXX
 4580:             // !replace with xel, yel?
 4581:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4582:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4583:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4584:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4585:          } //ics
 4586:                    
 4587:          diffRho = 0.0;
 4588: 
 4589:       } else { //internal and wet
 4590:          if constexpr(ics==1) {
 4591:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4592: 
 4593:             // Vector from e1 to e2
 4594:             vec = toVector2(e2->center - e1->center);
 4595: 
 4596:          } else { 
 4597:             // IMPLEMENT THIS XXXXXX
 4598:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4599:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4600:             //                   alow(j)=xctr2
 4601:             //                   bdia(j)=yctr2
 4602:          } // ics
 4603: 
 4604:          diffRho = rho2 - e1->demeanedDensity(k);
 4605:       }
 4606: 
 4607:    }
 4608: 
 4609:    __global__ void computeDensityCubicSplines(void) {
 4610:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4611: 
 4612:       ELEM(elem);
 4613: 
 4614:       if (elem->isDry) return;
 4615: 
 4616:       const int kb = elem->kb;
 4617: 
 4618:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4619:       if (elem->is2D()) {
 4620:          // In the 2D case, the density is constant at the prism level. 
 4621:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4622:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4623:       } else { //3D
 4624: 
 4625:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4626:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4627:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4628:          ///// XXXX CHECK INDICES!!!!!
 4629:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4630:       } // 2D/3D
 4631: 
 4632:    }
 4633: } // extern "C"
 4634: 
 4635: 
 4636: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4637: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4638: 
 4639:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4640: 
 4641:    const int kb  = elem->kb;
 4642:    const int kb2 = elem2->kb;
 4643: 
 4644:    // z-coordinate of prism of elem
 4645:    const double zp = elem->z_prism(k);
 4646: 
 4647:    double rho = 0.0;
 4648: 
 4649:    if (elem2->is2D()) {
 4650:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4651: 
 4652:    } else {  // 3D
 4653: 
 4654:       // eta_min may be < zmax
 4655:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4656:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4657: 
 4658:       // (Extrapolate density below bottom, we will fix it later)
 4659:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4660:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4661:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4662:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4663:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4664:    } // 2D/3D
 4665:      
 4666: 
 4667:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4668:    // Now we need to fix it.
 4669:    if (elem->z[k] < elem2->z[kb2]) {
 4670:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4671: 
 4672:       // There are two methods to adjust the density at the bottom of the element.
 4673:       // iunder_deep=0: 
 4674:       const double depth1 = abs(elem->z[kb]); // larger depth
 4675: 
 4676:       if (iunder_deep==0) {
 4677: 
 4678:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4679: 
 4680:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4681: 
 4682:       } else { // iunder_deep != 0
 4683: 
 4684:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4685: 
 4686:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4687: 
 4688:          //   Demeaned density at the same z coordinate as
 4689:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4690:          }
 4691: 
 4692:       } // if iunder_deep
 4693:    } // if elem->z[kb] < elem2->z[kb]
 4694: 
 4695:    return rho;
 4696: }
 4697: 
 4698: 
 4699: extern "C" {
 4700:    __global__ void computeDensityGradient(void) {
 4701: 
 4702:       if constexpr(ibc != 0) return;
 4703: 
 4704:          // Compute the horizontal density gradient at each element.
 4705:       // It works in two steps:
 4706:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4707:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4708:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4709:       //             gradRho.r1 = rho1 - rho0
 4710:       //             gradRho.r2 = rho2 - rho0
 4711:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4712:       // 
 4713:       //  NOTE: We use de-meaned densities.
 4714: 
 4715:       ELEM(elem);
 4716: 
 4717:       if (elem->isDry) return;
 4718: 
 4719:       const int kb  = elem->kb;
 4720:       const int i34 = elem->i34;
 4721: 
 4722:       for (int k = kb + 1; k < nvrt; k++) {
 4723:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4724:          //             gradRho.r1 = rho1 - rho0
 4725:          //             gradRho.r2 = rho2 - rho0
 4726:          int icount = 0;
 4727:          double sumRx = 0.0;
 4728:          double sumRy = 0.0;
 4729:          for (int j1=0; j1<i34; j1++) { 
 4730: 
 4731:             const int j2 = elem->nxq(j1 + 1);
 4732: 
 4733:             // Pairs of consecutive neighbor elements of elem
 4734:             const Element *e1 = elem->nghbElems[j1];
 4735:             const Element *e2 = elem->nghbElems[j2];
 4736: 
 4737:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4738:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4739:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4740: if (elem->idx == 21) printf("$$AAAXXXXXXXA$$$ rho1 = %.16f, rho2 = %.16f\n", rho1, rho2);            
 4741: 
 4742:             // Compute the density difference and the vector from elem to e1 and e2
 4743:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4744:             double diffRho1, diffRho2;
 4745:             Vector2 vec1, vec2;
 4746:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4747:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4748: 
 4749:             const double rl1 = length(vec1);
 4750:             const double rl2 = length(vec2);
 4751:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4752: 
 4753:             const double delta = cross(vec1, vec2);
 4754:             const double sintheta = abs(delta)/(rl1*rl2);
 4755: 
 4756:             // To avoid problems, avoid elements with small angle between vectors
 4757:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4758:             const bool validEq = (sintheta > sin_one_deg);
 4759: 
 4760:             if (validEq) {
 4761:                // Solve the system of equations to get the density gradient at elem
 4762:                icount++;
 4763:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4764:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4765:                sumRx += Rx;
 4766:                sumRy += Ry;
 4767:             }
 4768:          } // for j1
 4769: 
 4770:          // Compute the average density gradient at elem
 4771:          if (icount==0) {
 4772:            // Bad mesh quality; bail out with 0 b-cc
 4773:            elem->gradRho[k] = {0.0, 0.0};
 4774:          } else {
 4775:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4776:          }
 4777: 
 4778:       } // for k
 4779: 
 4780:    }
 4781: 
 4782:    __global__ void computeBaroclinicTerm(void) {
 4783:    // Computes the baroclinic term at sides (at half levels).
 4784:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4785:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4786: 
 4787:       SIDE(side);
 4788: 
 4789:       if (side->isDry) return;
 4790: 
 4791:       const Element *e1 = side->elems[0];
 4792:       const Element *e2 = side->elems[1];      
 4793:       const int kb = side->kb;
 4794:       
 4795:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4796: 
 4797:       // interpolates vertically the density gradient of the two elements at the half level/
 4798: 
 4799:       // Starts the integration at the surface and goes down to the bottom
 4800:       int k1 = nvrt - 1;
 4801:       int k2 = nvrt - 1;
 4802: 
 4803:       side->bcc[nvrt-1] = {0.0, 0.0};
 4804:       for (int k = nvrt-2; k >= kb; k--) {
 4805:       // For each prism level (from surface to bottom)...
 4806: 
 4807:          // For both elements, interpolate density gradient at the side's half level.
 4808:          // The gradient at the side is the average of the gradients at the elements.
 4809:          // w1, w2 are used to take into account boundary sides, with just one element.
 4810:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4811:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4812:          const double wsum = w1 + w2;
 4813:          w1 = w1/wsum;
 4814:          w2 = w2/wsum;
 4815:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4816: 
 4817:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4818:          Vector2 gradRho = {0.0, 0.0};
 4819:          if (e1 != nullptr && k > kb) {
 4820:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4821:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4822:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4823:             
 4824:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4825:          }      
 4826:          if (e2 != nullptr && k > kb) {
 4827:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4828:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4829:             
 4830:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4831:          }
 4832: 
 4833:          if constexpr(ics==2) {
 4834:             // IMPLEMENT THIS XXXXXX
 4835:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4836:             // swild(1)=tmp1
 4837:             // swild(2)=tmp2
 4838:          }
 4839:          
 4840:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4841:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4842:          // CHECK INDICES!!! XXX
 4843:          const double grav3 = side->grav3();
 4844:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4845: 
 4846:       } // for
 4847: 
 4848:    }
 4849: 
 4850: 
 4851: 
 4852:    __global__ void computeHorGradientAtSide(void) {
 4853: 
 4854:       // Compute the horizontal density gradient at each element.
 4855:       // It works in two steps:
 4856:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4857:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4858:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4859:       //             gradRho.r1 = rho1 - rho0
 4860:       //             gradRho.r2 = rho2 - rho0
 4861:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4862:       // 
 4863:       //  NOTE: We use de-meaned densities.
 4864: 
 4865:       SIDE(side);
 4866: 
 4867: // printf("side->isDry: %d\n", side->isDry);
 4868:       if (side->isDry) return;
 4869: 
 4870:       // Computes the gradient of the variables at the side center.
 4871:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4872:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4873:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4874: 
 4875:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4876:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4877:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4878:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4879: 
 4880: 
 4881:    }
 4882: 
 4883: 
 4884:    __global__ void solveMomentumEquations(double time) {
 4885: 
 4886:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4887:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4888: 
 4889:       SIDE(side);
 4890: 
 4891:       if (side->isDry) 
 4892:       {
 4893:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4894: 
 4895:          return;
 4896:       }
 4897: 
 4898:       const Node *n1 = side->n1;
 4899:       const Node *n2 = side->n2;
 4900: 
 4901:       const int kb = side->kb;
 4902: 
 4903:       const double veg_h = side->veg_h();
 4904:       const double grav3 = side->grav3();
 4905: 
 4906:       if (side->is2D()) {
 4907:          // Warning: Do not use htot2, which is updated.
 4908:          const double htot = side->htot1();
 4909:          const double hhat = side->hhat;
 4910: 
 4911:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 4912: 
 4913:          Vector2 tau2 = {0.0, 0.0};
 4914:           
 4915:          if constexpr(ics==1) {
 4916:             tau2 = side->tau();
 4917: 
 4918:          } else {
 4919:             assert(false && "Not implemented: ics == 2");
 4920:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4921:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4922:             // taux2=(vn1+tt1)*0.5d0
 4923:             // tauy2=(vn2+ss1)*0.5d0
 4924:          } // if ics         
 4925: 
 4926:          // hat_gam has units of m/s
 4927: 
 4928:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4929: 
 4930:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4931:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4932: 
 4933:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4934: 
 4935: if (abs(hat_gam.x*hhat/htot) > rmaxvelx) printf("hat_gam.x*hhat/htot = %.16f, hat_gam.x = %.16f, hhat = %.16f, htot = %.16f\n", hat_gam.x*hhat/htot, hat_gam.x, hhat, htot);
 4936:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4937:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4938: 
 4939:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 4940: 
 4941: 
 4942:       }
 4943:       else { // 3D
 4944: 
 4945:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4946:          // 
 4947:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4948:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4949:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4950:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4951:          // k+1 and k.
 4952: 
 4953: 
 4954:    
 4955: 
 4956: 
 4957:          const int ndim = nvrt - kb;
 4958:          const double zTopCanopy = side->zTopCanopy();
 4959: 
 4960:          // Initialize the tridiagonal system
 4961:          for (int k = kb + 1; k < nvrt; k++) {
 4962:             
 4963:             const int kin = k - (kb + 1);
 4964: 
 4965:             // Vertical viscosity at the face center
 4966:             const double dfz = 1e-6; //0.25*(side->dfv(k) + side->dfv(k + 1));
 4967:            
 4968: 
 4969:             alow[kin] = 0.0;
 4970:             cupp[kin] = 0.0;
 4971:             bdia[kin] = 0.0;
 4972: 
 4973:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4974:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4975: 
 4976:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4977:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4978:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4979: 
 4980:             // First part: layers k, k+1
 4981:             if (k < nvrt - 1) {
 4982:                              
 4983:                if constexpr(iveg != 0) {
 4984: 
 4985:                   // If there is vegetation at this level...
 4986:                   if (zTopCanopy > side->zc[k]) {
 4987:                      // If the canopy is above the k layer...
 4988:                      
 4989:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4990:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4991:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4992:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4993: 
 4994:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4995:                      const double vmag2 = length(ut2);
 4996:                      const double vmag1 = length(side->u2[k]);
 4997:                      const double vmag = 0.5*(vmag1 + vmag2);
 4998:                      
 4999:                      // Computes the vegetation alpha at the face center
 5000:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5001: 
 5002:                      cff1 += veg_alpha_sd*dt*vmag;
 5003: 
 5004:                   } // if (zTopCanopy
 5005:                } // if iveg
 5006: 
 5007:                const double dzz = side->Dz(k + 1);
 5008:                const double tmp = dt*dfz/dzz;
 5009:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5010: 
 5011:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5012:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5013:             }
 5014: 
 5015: 
 5016:             // Second part: layers k-1, k
 5017:             if (k > kb + 1) {
 5018: 
 5019:                double cff1 = 1.0; //init \bar{c^k}
 5020: 
 5021:                if constexpr(iveg != 0) {
 5022:                   // If there is vegetation at this level...
 5023:                   if (zTopCanopy > side->zc[k-1]) {
 5024:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5025:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5026: 
 5027:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5028: 
 5029:                      const double vmag2 = length(ut2);
 5030:                      const double vmag1 = length(side->u2[k-1]);
 5031:                      const double vmag = 0.5*(vmag1 + vmag2);
 5032: 
 5033:                      // Computes the vegetation alpha at the face center
 5034:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5035:                      cff1 += veg_alpha_sd*dt*vmag;
 5036:                   } // if zTopCanopy
 5037: 
 5038:                } // if iveg
 5039: 
 5040:                const double dzz = side->Dz(k);
 5041:                const double tmp = dt*dfz/dzz;
 5042:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5043: 
 5044:                alow[kin] += cff1*dzz/6.0 - tmp;
 5045:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5046: 
 5047:             } else { // Bottom boundary
 5048:                // This occurs at the bottom, where the bottom drag is applied.
 5049: 
 5050:                bdia[kin] += dt*side->chi2;
 5051: 
 5052:             } // if (k > kb + 1)
 5053: 
 5054: 
 5055: 
 5056:          } // for (int k
 5057: 
 5058: 
 5059: 
 5060:          // Computes the RHS.
 5061:          // -----------------
 5062: 
 5063:          //	BC to be imposed at the end.
 5064: 
 5065:          const Vector2 gradETP  = side->gradETP;
 5066:          const Vector2 gradPr   = side->gradPr;
 5067:          const Vector2 gradEta1 = side->gradEta1;
 5068:          const Vector2 gradEta2 = side->gradEta2;
 5069: 
 5070:          const Vector2 *btu = side->btu;
 5071:          const Vector2 *u2  = side->u2;
 5072:          const double coriolis = side->coriolis;
 5073:          const Vector2 *nuGradU = side->nuGradU;
 5074: 
 5075: 
 5076:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5077: 
 5078:          for (int k = kb + 1; k < nvrt; k++) {
 5079:             const int kin = k - kb - 1;
 5080: 
 5081:             const double dz_0 = side->Dz(k);
 5082:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5083: 
 5084:             rrhs[kin] = {0.0, 0.0};
 5085:             double dz = 0.0;
 5086: 
 5087:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5088:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5089:             if (k < nvrt  ) dz += dz_1;
 5090:             if (k > kb + 1) dz += dz_0;
 5091: 
 5092:             // Elevation gradient, atmospheric pressure and tidal potential
 5093:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5094: if (side->idx == 21) printf("$$AAAA$$$ rrhs[%d] = %.16f, %.16f, dz = %.16f\n", k, rrhs[kin].x, rrhs[kin].y, dz);            
 5095:       
 5096: 
 5097:             // Coriolis, advection, wind stress, and horizontal viscosity
 5098:             if (k < nvrt - 1) {
 5099: 
 5100: 
 5101:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5102:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5103:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5104:                                                 
 5105: // if (side->idx == 21) printf("$$BBBB$$$ dz_1 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_1, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5106:                //diff stress tensors 1006
 5107:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5108:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5109:                   assert(false && "Not implemented: itur == 5");
 5110:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5111:                }
 5112: 
 5113:             } else { // k == nvrt - 1 SURFACE
 5114:                Vector2 tau2 = {0.0, 0.0};
 5115:                if constexpr(ics==1) {
 5116:                   tau2 = side->tau();
 5117:       
 5118:                } else {
 5119:                   assert(false && "Not implemented: ics == 2");
 5120:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5121:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5122:                   // taux2=(vn1+tt1)*0.5d0
 5123:                   // tauy2=(vn2+ss1)*0.5d0
 5124:                } // if ics
 5125: 
 5126:                rrhs[kin] += dt*tau2;
 5127: 
 5128:             } // if k<nvrt
 5129: 
 5130:             if (k > kb + 1) {
 5131:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5132:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5133:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5134: if (side->idx == 21) printf("$$CCCC$$$ dz_0 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_0, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5135: 
 5136:                // diff stress tensors 1006
 5137:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5138:                   assert(false && "Not implemented: itur == 5");
 5139:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5140:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5141:                }
 5142: 
 5143:             } // if k>kbs + 1
 5144: 
 5145:             // Baroclinic
 5146:             Vector2 *bcc = side->bcc;
 5147:             if constexpr(ibc == 0) {
 5148:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5149:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5150: 
 5151:             } // if ibc==0
 5152: 
 5153:          } // k=kb + 1,nvrt
 5154: 
 5155: 
 5156: if (side->idx == 21) for (int k=0; k<nvrt; k++) printf("AAAAAA kb = %d, alow[%d] = %.16f, bdia[%d] = %.16f, cupp[%d] = %.16f, rrhs[%d] = %.16f, %.16f\n", kb, k, alow[k], k, bdia[k], k, cupp[k], k, rrhs[k].x, rrhs[k].y);   
 5157:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5158: // for (int k=nvrt-kb-1; k < nvrt; k++) { soln[k] = {0.0, 0.0}; side->u2[k] = {0.0, 0.0}; }
 5159: if (side->idx == 21) for (int k=0; k<nvrt; k++) printf("BBBB kb = %d, Dz[%d] = %.16f, soln[%d] = %.16f, %.16f\n", kb, k, side->Dz(k), k, soln[k].x, soln[k].y);   
 5160: 
 5161: // for (int k=0; k<nvrt; k++) soln[k] = u[k];
 5162:          for (int k = kb + 1; k < nvrt; k++) {
 5163:             const int kin = k - kb - 1;
 5164: 
 5165:             // Velocity is always clamped to maximum values
 5166:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5167:          } // k
 5168: if (side->idx == 21) for (int k=0; k<nvrt; k++) printf("BBBBBB soln[%d] = %.16f\n", k, soln[k].x, soln[k].y);   
 5169:       } // if side->is2D()
 5170:       
 5171: 
 5172:       // Impose velocity boundary condition at the bottom
 5173:       if constexpr(imm == 2) { // 3D bed deformation model
 5174:          double dep;
 5175:          Vector2 vel;
 5176: 
 5177:          assert(false && "Not implemented: imm == 2");
 5178:          //update_bdef(time, x0, y0, dep, vel);
 5179:          // side->u2[kb] = vel;
 5180: 
 5181:       } else { // imm = 0 or 1
 5182:          if (side->Cd() == 0.0) {
 5183:             side->u2[kb] = side->u2[kb + 1];
 5184:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom   XXXXX use is3D()?
 5185: // printf("XXXXXXXXX computeFlowBcVelocities: 3D no slip bottom, side idx = %d\n", side->idx);
 5186:             side->u2[kb] = {0.0, 0.0};
 5187:          }
 5188:           
 5189:       } // if imm
 5190: 
 5191:       // The velocities below the bottom level are set to zero
 5192:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5193: 
 5194: 
 5195:    }
 5196: 
 5197: 
 5198:    __global__ void applyMomentumBC(void) {
 5199: 
 5200:       SIDE_BND(sideBnd);
 5201: 
 5202:       Side *side = sideBnd->side;
 5203:       const BoundarySegment *segment = sideBnd->segment;
 5204:       const Node *n1 = side->n1;
 5205:       const Node *n2 = side->n2;
 5206: 
 5207:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5208: 
 5209:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5210:       const bool isLand = segment->isLand;
 5211:       const int ifltype = segment->ifltype;
 5212: 
 5213:       const int kb = side->kb;
 5214: 
 5215:       if (!isLand && ifltype != 0) {
 5216:          const Vector2 *ubc = sideBnd->ubc;
 5217:   
 5218:          for (int k = kb; k < nvrt; k++) {
 5219:             
 5220:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5221:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5222: 
 5223:             if (ifltype == -1) {
 5224:                // Flather 1
 5225: 
 5226:                const double depth = side->depth();
 5227: 
 5228:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5229: 
 5230:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5231: 
 5232:                side->u2[k] = vnorm*side->n;
 5233: 
 5234:             } else if (ifltype == -2) { // Discharge
 5235: 
 5236:                const double eta1 = side->eta1();
 5237:                const double eta2 = side->eta2();
 5238:                const double htot = side->htot2();
 5239: 
 5240:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5241:                assert(false && "Not implemented: Discharge bc");
 5242:                // const double dischrg = discharge(eta1);
 5243:                const double dischrg = 0.0; // XXX REMOVE
 5244:                
 5245: 
 5246:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5247: 
 5248:                const double vnorm = dischrg*eta2/htot;
 5249: 
 5250:                side->u2[k] = vnorm*side->n;
 5251: 
 5252: 
 5253:             }
 5254:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5255:                const double vnorm = dot(side->u2[k], side->n);
 5256: 
 5257:                double rat;
 5258:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5259:                else              rat = segment->vobc2; // outgoing
 5260: 
 5261:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5262:             }
 5263:             else { // not Flather or 3D radiation
 5264:                side->u2[k] = ubc[k];
 5265: 
 5266:             } // if (segment->ifltype...
 5267: 
 5268:          }
 5269: 
 5270:       }
 5271:       else if (isLand) { // if it is land boundary side
 5272: 
 5273:          if constexpr(islip == 0) { // free slip
 5274: 
 5275:             for (int k=kb; k < nvrt; k++) {
 5276: 
 5277:                const Vector2 t = side->t();
 5278:                const Vector2 n = side->n;
 5279: 
 5280:                double vnorm = 0.0; // for most cases
 5281:                const double vtan = dot(side->u2[k], t);
 5282:                
 5283:                side->u2[k] = vtan*t - vnorm*n;
 5284: 
 5285:             }
 5286: 
 5287:          } else { // no slip
 5288:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5289: 
 5290:          }
 5291:       } // if (side segment type...
 5292: 
 5293:    
 5294: 
 5295:    }
 5296: 
 5297: 
 5298:    __global__ void shapiroFilter1(void) {
 5299:       // First step of the Shapiro filter (normally used if indvel<=0)
 5300:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5301: 
 5302:       SIDE(side);
 5303: 
 5304:       // Only internal wet sides are processed
 5305:       if (side->isDry || !(side->isInternal())) return;
 5306: 
 5307:       const int kb = side->kb;
 5308: 
 5309:       for (int mm = 1; mm <= niter_shap; mm++) {
 5310: 
 5311:          for (int k = kb + 1; k < nvrt; k++) {
 5312:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5313:             Vector2 suru = {0.0, 0.0};
 5314: 
 5315:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5316: 
 5317:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5318: 
 5319:                int kin = k;
 5320:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5321:                
 5322:                if constexpr(ics==1) {
 5323:                   suru += nSide->u2[kin];
 5324: 
 5325:                } else {
 5326:                   assert(false && "Not implemented: ics == 2");
 5327:                   // Vector2 vn1, vn2;
 5328:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5329:                   // suru=suru+vn1;
 5330:                   // surv=surv+vn2;
 5331:                }
 5332:             }
 5333: 
 5334: 
 5335:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5336: 
 5337:          }
 5338:       }
 5339:    }
 5340: 
 5341:    __global__ void shapiroFilter2(void) {
 5342:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5343: 
 5344:       SIDE(side);
 5345: 
 5346:       if (side->isDry || !(side->isInternal())) return;
 5347: 
 5348:       const int kb = side->kb;
 5349: 
 5350:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5351: 
 5352:       if (side->is2D()) {
 5353:          // side->u2[kb] = side->u2[nvrt - 1];
 5354:          side->u2[kb + 1] = side->bcc[kb + 1];
 5355:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5356: 
 5357:       } else {
 5358:          // 3D
 5359:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5360:          
 5361:       }
 5362: 
 5363:    }
 5364: 
 5365: 
 5366:    __global__ void ul0UpdateZCoords(void) {
 5367:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5368:       
 5369:       NODE(node);      
 5370: 
 5371: 
 5372:       if (node->isDry2()) { 
 5373: 
 5374:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5375: 
 5376:          if constexpr(ivcor != 1) node->kb = 0;
 5377: 
 5378:       } else {
 5379: 
 5380:          node->updateKb();
 5381:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5382: 
 5383:       }
 5384: 
 5385:       // We use the temp.b field to store the previous state of isDry.
 5386:       node->tmp.b = node->isDry;
 5387: 
 5388:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5389:       node->isDry = true;
 5390: 
 5391:    }
 5392: 
 5393:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5394:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5395:    {
 5396:       ELEM(elem);
 5397: 
 5398:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5399: 
 5400:       // All the nodes of a wet element are wet.
 5401:       if (!elem->isDry) {
 5402:          elem->nodes[0]->isDry = false;
 5403:          elem->nodes[1]->isDry = false;
 5404:          elem->nodes[2]->isDry = false;
 5405:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5406: 
 5407:       }
 5408: 
 5409: 
 5410:       elem->kb = 0;
 5411: 
 5412:       if (elem->isDry) return;
 5413: 
 5414:       // Wet
 5415:       const Node *n1 = elem->nodes[0];
 5416:       const Node *n2 = elem->nodes[1];
 5417:       const Node *n3 = elem->nodes[2];  
 5418:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5419: 
 5420:    //    if(elem->isDry2()) {
 5421:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5422:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5423:    //        call parallel_abort(errmsg)
 5424:    //    }
 5425: 
 5426: 
 5427:       // Computes element's kb as the minimum of the nodes' kb.
 5428:       const int kb1 = n1->kb;
 5429:       const int kb2 = n2->kb;
 5430:       const int kb3 = n3->kb;
 5431:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5432: 
 5433: 
 5434:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5435: 
 5436: 
 5437:       // Computes the element z as the mean of the nodes z.
 5438:       for (int k = elem->kb; k < nvrt; k++) {
 5439: 
 5440:          // Compute the element z as the mean of the nodes z.
 5441:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5442:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5443:          elem->z[k] /= elem->i34;
 5444: 
 5445:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5446:       }
 5447:                   
 5448:    }
 5449: 
 5450:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5451:    {
 5452:       NODE(node);
 5453:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5454: 
 5455:       if (it == iths) return;
 5456: 
 5457: 
 5458:       if(!node->isDry && node->tmp.b) { // rewetted
 5459:          for (int k=0; k < nvrt; k++) {
 5460: 
 5461:             Vector3 utmp={0.0, 0.0, 0.0};
 5462: 
 5463:             double ttmp=0.0;
 5464:             double stmp=0.0;
 5465:             int icount=0;
 5466:             for (int j = 0; j < node->numNodes; j++) {
 5467: 
 5468: 
 5469:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5470:                if (!node->isDry) { // all indices extended
 5471:                   icount++;
 5472: 
 5473:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5474:                   utmp += node->u2[k];
 5475:                   
 5476:                   ttmp += node->tracers[k].tracer[0]; 
 5477:                   stmp += node->tracers[k].tracer[1]; 
 5478:                }
 5479:             }
 5480: 
 5481:             if(icount > 0) {
 5482:                const double inv_icount = 1.0/icount;
 5483:                node->u2[k]     = inv_icount*utmp;
 5484:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5485:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5486:             }
 5487:          }
 5488:       }
 5489:    }
 5490: 
 5491: 
 5492:    __global__ void ul0UpdateSides(int it, int iths) {
 5493: 
 5494:       SIDE(side);
 5495: 
 5496:       // A side is wet if and only if at least one of its elements is wet.
 5497:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5498: 
 5499:       const Node *n1 = side->n1;
 5500:       const Node *n2 = side->n2;
 5501:       const int kb1 = n1->kb;
 5502:       const int kb2 = n2->kb;
 5503: 
 5504:       side->kb = 0; // dry
 5505: 
 5506:       if (isWet) {
 5507: 
 5508:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5509: 
 5510:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5511: 
 5512:          side->kb = min(kb1, kb2);
 5513: 
 5514:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5515: 
 5516:          for (int k = side->kb; k < nvrt; k++) {
 5517:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5518: 
 5519:          
 5520:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5521: 
 5522:             // Compute velocity for re-wetted sides 
 5523:             if ((it != iths) && (side->isDry && isWet)) {
 5524:             
 5525:                Vector2 utmp={0.0, 0.0};
 5526: 
 5527:                int icount=0;
 5528: 
 5529:                // For all the sides on the two elements that share this side
 5530:                for (int j=0; j < 2; j++) {
 5531:                   const Element *elem = side->elems[j];
 5532:                   if (elem == nullptr) continue;
 5533: 
 5534:                   for (int jj=0; jj < elem->i34; jj++) {
 5535:                      const Side *nSide = elem->sides[jj];
 5536:                      if (nSide->isDry) continue;
 5537: 
 5538:                      icount++;
 5539:                      utmp += nSide->u2[k];                     
 5540:                   }
 5541:                }
 5542:                   
 5543:                assert(icount > 0 && "No wet sides around this side");
 5544:                if (icount > 0)  side->u2[k] = utmp/icount;
 5545:                   
 5546:             } // if ((it != iths) && (side->isDry && isWet))
 5547: 
 5548:          } // for k
 5549: 
 5550:       } // if isWet
 5551:    
 5552:       side->isDry = !isWet;
 5553: 
 5554:    }
 5555: 
 5556: 
 5557:    __global__ void zeroNodalVelocities(void) {
 5558:       NODE(node);
 5559: 
 5560:       for (int k = 0; k < nvrt; k++) {
 5561:          node->u2[k]   = {0.0, 0.0, 0.0};
 5562:          node->utmp[k] = {0.0, 0.0};
 5563:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5564:       }
 5565:    }
 5566: 
 5567:    __global__ void computeNodalVerticalVelocities0(void) {
 5568:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5569:    // Divides by the total area of the elements sharing the    node.
 5570:       NODE(node);
 5571: 
 5572:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = 0.0;  // node->tmp.d contains the total area of the elements sharing the node
 5573:    }
 5574: 
 5575:    __global__ void computeNodalVerticalVelocities1(void) {
 5576:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5577:    // Adds the element's vertical velocity times the element's area.
 5578:       ELEM(elem);
 5579: 
 5580:       for (int j = 0; j < elem->i34; j++) {
 5581:          Node *node = elem->nodes[j];
 5582: 
 5583:          for (int k = node->kb; k < nvrt; k++) {
 5584:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5585:          }
 5586:          atomicAdd(&(node->tmp.d), elem->area);
 5587:       }
 5588:    }
 5589: 
 5590:    __global__ void computeNodalVerticalVelocities2(void) {
 5591:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5592:    // Divides by the total area of the elements sharing the    node.
 5593:       NODE(node);
 5594: 
 5595:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5596:    }
 5597: 
 5598: 
 5599:    __global__ void computeNodalHorizontalVelocities1(void) {
 5600:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5601:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5602: 
 5603:       ELEM(elem);
 5604: 
 5605:       const int kb = elem->kb;
 5606:       const bool isTri = elem->isTri();
 5607: 
 5608:       if constexpr(indvel <= 0) {
 5609:          // Assuming discontinoius hvel.
 5610: 
 5611: 
 5612:          if (isTri) { // For triangles
 5613:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5614:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5615: 
 5616:             for (int j = 0; j < 3; j++) {
 5617:                // For every node of the triangle...
 5618:                Node *node = elem->nodes[j];
 5619: 
 5620:                const Side *s1 = elem->sides[j];
 5621:                const Side *s2 = elem->sides[(j + 1) % 3];
 5622:                const Side *s3 = elem->sides[(j + 2) % 3];
 5623: 
 5624:                const int numElements = node->numElements;
 5625:                const double inv_numElements = 1.0/numElements;
 5626: 
 5627:                for (int k = kb; k < nvrt; k++)  {
 5628:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 5629:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5630:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5631:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5632:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 5633:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 5634: 
 5635:                }
 5636: 
 5637:             }
 5638:          }
 5639:          else { // For quads
 5640:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 5641: 
 5642:          }
 5643: 
 5644:       }
 5645:       
 5646:    }
 5647: 
 5648: 
 5649:    __global__ void computeNodalHorizontalVelocities2(void) {
 5650:       NODE(node);
 5651: 
 5652:       for (int k = 0; k < nvrt; k++) {
 5653:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5654:       }
 5655:       
 5656:    }   
 5657: 
 5658:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5659:    // XXXX I'm not sure where I got this function from. 
 5660:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5661:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5662:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5663:    // It uses the utmp array as a temporary array to store the velocities.
 5664: 
 5665:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5666: 
 5667:       SIDE(side);
 5668: 
 5669:       const int kb = side->kb;
 5670: 
 5671:       Node *n1 = side->n1;
 5672:       Node *n2 = side->n2;
 5673: 
 5674:       for (int k = kb; k < nvrt; k++) {
 5675: 
 5676:          // Cast the u2 vector into a Vector2 
 5677:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5678:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5679: 
 5680:          n1_u2 = side->u2[k]/n1->numSides;
 5681:          n2_u2 = side->u2[k]/n2->numSides;
 5682: 
 5683:       }
 5684: 
 5685: 
 5686:    }
 5687: 
 5688:    __global__ void resetVelocityOpenBndNodes(void) {
 5689:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5690: 
 5691:       NODE_BND(nodebnd);
 5692: 
 5693:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5694:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5695:       }
 5696: 
 5697:    }
 5698: 
 5699: 
 5700:    __global__ void setVelocityOpenBndNodes(void) {
 5701:    // For open boundary nodes sets their velocity to the imposed values.
 5702: 
 5703:       SIDE_BND(sidebnd);
 5704: 
 5705:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5706:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5707:          // to its segment to the average of the side velocity.
 5708: 
 5709:          for (int k = 0; k < nvrt; k++) {
 5710:             Node *n1 = sidebnd->side->n1;
 5711:             Node *n2 = sidebnd->side->n2;
 5712: 
 5713:             // Cast the u2 vector into a Vector2 
 5714:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5715:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5716: 
 5717:             if (n1->nodeBnd->segment == sidebnd->segment) {
 5718:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 5719:             }
 5720:             if (n2->nodeBnd->segment == sidebnd->segment) {
 5721:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 5722:             }
 5723: 
 5724:          }
 5725:       }
 5726: 
 5727:    }
 5728: 
 5729: 
 5730:    __global__ void computeVerticalVelocity(void) {
 5731:       // Computes the vertical velocity at the (2D) element's centroid.
 5732:       // In this function we will be considering volumetric elements, with side faces and a 
 5733:       // bottom and a top face. We will call them SFs, BF and TF.
 5734:       // It computes the flux coming from BF and the SFs.
 5735:       // If the bed is moving, it takes that into account.
 5736:       // Since water is incompressible, the integral of the velocity times the normal vector
 5737:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5738:       // and the BF is equal to the flux going out from the TF.
 5739:       // TF = - BF - sum(SFs).
 5740:       // It then computes the horizontal velocity at the center of TF.
 5741:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5742:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5743:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5744: 
 5745:       ELEM(elem);
 5746: 
 5747:       if (elem->isDry) return;
 5748: 
 5749:       const int kb = elem->kb;
 5750:       const bool isTri = elem->isTri();
 5751: 
 5752:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5753: 
 5754:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5755:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5756:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5757: 
 5758:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5759: 
 5760:       double area3D;
 5761: 
 5762:       // Bottom face flux
 5763:       double bottomFlux = 0.0;
 5764:       Vector2 u2meanBottom = {0.0, 0.0};
 5765:       const Vector2 gradh = elem->grad2(&Node::depth);
 5766:       if constexpr(imm==2) {
 5767:          Vector3 ubed;
 5768: 
 5769:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5770:          // updateBDEF(ubed);
 5771:      
 5772:          // const double bflux0 = dot(ubed, elem_n1);
 5773: 
 5774:          // elem->w[kb] += ubed.z;
 5775:       }
 5776:       else {
 5777:          Vector2 umean;
 5778:          if constexpr(ics == 1) {
 5779:             u2meanBottom = elem->mean(kb, &Side::u2);
 5780:          }
 5781:          else {
 5782:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5783:          }
 5784: 
 5785:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5786:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5787: 
 5788:          bottomFlux = - dot(gradh, u2meanBottom);
 5789:       } // if imm
 5790: 
 5791:       // Compute w for kb+1 to nvrt-1
 5792:       for (int l = kb; l < nvrt - 1; l++) {
 5793: 
 5794:          // normal vector to the top face of the "volumetric" element (3D)
 5795:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5796: 
 5797:          // Compute the total flux at the sides
 5798:          double sideFlux = 0.0;
 5799:          Vector2 u2top = {0.0, 0.0};
 5800:          for (int j = 0; j < elem->i34; j++) {
 5801:             const Side *side = elem->sides[j];
 5802: 
 5803:             const double sideArea = side->area(l);
 5804:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5805:             const double sign = elem->ssign[j]; 
 5806: 
 5807:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5808:          }
 5809:          
 5810:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5811:          //velocities at the centers of the sides
 5812:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5813: 
 5814:          // The flx at the top ace can be computed from the other flows.
 5815:          const double topFlux = - sideFlux - bottomFlux;
 5816:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5817: 
 5818:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5819: 
 5820:          elem_n1 = elem_n2;
 5821: 
 5822:          bottomFlux = - topFlux;
 5823:       }
 5824:    }  
 5825: 
