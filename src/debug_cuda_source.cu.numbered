 2655:    template<typename T>
 2656:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2657: 
 2658:       T values[4];
 2659: 
 2660: 
 2661:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2662:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2663:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2664:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2665:       else          values[3] = T();
 2666: 
 2667:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2668: 
 2669:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2670:    }
