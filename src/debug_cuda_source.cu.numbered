 3955:    __global__ void computeFlowBcVelocities(double time) {
 3956: 
 3957:       SIDE_BND(sideBnd);
 3958: 
 3959:       const Side *side = sideBnd->side;
 3960:  
 3961:       const bool isDry = side->isDry;
 3962: 
 3963:       if (isDry) {
 3964:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 3965:          return;
 3966:       }
 3967: 
 3968:       // For wet sides in open boundaries...
 3969:       const Vector2 n = side->n;
 3970:       const BoundarySegment *segment = sideBnd->segment;
 3971: 
 3972:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 3973: 
 3974:       const int ifltype = segment->ifltype;
 3975:       const int iettype = segment->iettype;
 3976: 
 3977:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 3978:       const Vector2 r_nuth0 = r_uth0*n;
 3979: 
 3980:       for (int k = 0; k < nvrt; k++) {
 3981:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 3982:          Vector2 r_u1_bar = {0.0, 0.0};
 3983:       
 3984:          if (ifltype == 1 || ifltype == 2) {
 3985:          
 3986:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 3987: 
 3988:             const double unth0 = segment->qthcon*ramp/segment->carea;
 3989:             
 3990:             r_uth = unth0*n;  // This case has no ramp-up
 3991:             
 3992:          } else if (ifltype == -1) { // Flather 1
 3993: 
 3994:             // uth is the normal vel.; no ramp up
 3995:             const double uth = sideBnd->nuth(k);
 3996:             r_uth = uth*n;
 3997:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 3998: 
 3999: 
 4000:          } else if (ifltype == 3 || ifltype == 5) {
 4001:             // vnth0=0 !normal vel.
 4002: 
 4003:             // Computes the contribution to the velocity from all tide frequencies
 4004:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4005: 
 4006:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4007:                const Vector2 umo  = sideBnd->umo(jfr); 
 4008: 
 4009:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4010:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4011:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4012:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4013:             }
 4014: 
 4015:          } // if (ifltype = 3 || ifltype == 5
 4016: 
 4017: 
 4018:          switch (iettype) {
 4019:             case 1:
 4020:             case 2:
 4021:             case 4:
 4022:                sideBnd->ubc[k] = r_uth;
 4023:                break;
 4024:             case 3:
 4025:                sideBnd->ubc[k] = r_u1_bar;
 4026:                break;
 4027:             case 5:
 4028:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4029:                break;
 4030:          } // switch
 4031: 
 4032:       } // for k
 4033:    }
 4034: 
 4035:    __global__ void computeElevationBoundaryConditions(double time) {
 4036:       // Compute elevation essential boundary conditions 
 4037: 
 4038:       NODE_BND(nodeBnd); // Each boundary node.
 4039: 
 4040:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4041: 
 4042:       const Node *node = nodeBnd->node;
 4043:       const BoundarySegment *segment = nodeBnd->segment;
 4044:       const int iettype = segment->iettype;
 4045:       
 4046: 
 4047:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4048:       double eic = 0.0;
 4049:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4050:       else                 eic = 0.0;
 4051: 
 4052:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4053:       const double r_eth = ramp*nodeBnd->eth;
 4054:       double r_eta1_bar = 0.0;
 4055: 
 4056: 
 4057:       // Compute tide elevation
 4058:       if (iettype == 3 || iettype == 5) {   
 4059: 
 4060:          if constexpr(iloadtide==1) { // loading tide
 4061:             assert(false && "Loading tide not implemented");
 4062:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4063:          }
 4064:          
 4065:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4066: 
 4067:             const double efa  = nodeBnd->efa[jfr]; 
 4068:             const double emo  = nodeBnd->emo[jfr]; 
 4069: 
 4070:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4071:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4072:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4073: 
 4074:          } // for jfr
 4075: 
 4076:       } // if iettype
 4077: 
 4078:       switch (iettype) {
 4079:          case 1:
 4080:          case 2:
 4081:          case 4:
 4082:             nodeBnd->elbc = r_eic + r_eth;
 4083:             break;
 4084:          case 3:
 4085:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4086:             break;
 4087:          case 5:
 4088:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4089:             break;
 4090:       } // switch
 4091: 
 4092: 
 4093:       //Add inverse barometric effects
 4094:       if (iettype != 0 && inv_atm_bnd == 1) {
 4095:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4096:       }
 4097: 
 4098:    }
 4099: 
 4100: 
 4101:    __global__ void computeHorizontalViscosity(void) { 
 4102: 
 4103:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4104: 
 4105:       SIDE(side);
 4106: 
 4107:       if (side->isDry) return;
 4108: 
 4109:       for (int k = 0; k < nvrt; k++) {
 4110:          side->nuGradU[k] = {0.0, 0.0};
 4111:       }
 4112: 
 4113:       if constexpr(ihorcon == 1) {
 4114:          for (int k = side->kb; k < nvrt - 1; k++) {
 4115:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4116:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4117:             // By Zhang and Baptista.
 4118: 
 4119:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4120:             // This is a standard discretization of the Laplacian operator.
 4121:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4122:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4123:             // Gamma is hvis_coef0 in the code.
 4124:             // The value of gamma needs to be < 0.5.
 4125: 
 4126:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4127:             // side under consideration in each of the two possible elements that share the side.
 4128:             Vector2 sumU = {0.0, 0.0};
 4129:             for (int l = 0; l < 2; l++) {
 4130:                const Element *elem = side->elems[l];
 4131: 
 4132:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4133: 
 4134:                // Find the local index of the side in the element
 4135:                const int idxSide = elem->sideLocalIdx(side);
 4136:                // Find the two sides that are connected to the side under consideration
 4137:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4138:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4139: 
 4140:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4141: 
 4142:             }
 4143: 
 4144:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4145:    
 4146:          }
 4147:       }
 4148:       else if constexpr(ihorcon == 2) {
 4149:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4150:       }
 4151: 
 4152: 
 4153:    }
 4154: 
 4155: 
 4156:    __global__ void setEssentialBC(void) {
 4157:       // Set essential boundary conditions 
 4158:       NODE(node); // Each boundary node
 4159:       NodeBoundary *nodeBnd = node->nodeBnd;
 4160:       
 4161: // nodeBnd->isEssentialBC = true;      
 4162:       // Check if this node has essential BC
 4163:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4164:          // Verify BC value is valid
 4165:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4166: 
 4167:        
 4168:          // Set diagonal to 1 and zero off-diagonals
 4169:          node->coeffDiag = 1.0;
 4170: 
 4171:          for (int j = 0; j < node->numNodes; j++) {
 4172:                node->coeffMatrix[j] = 0.0;
 4173:          }
 4174:          
 4175:          // Set solution and RHS to BC value
 4176:          node->mX  = nodeBnd->elbc;
 4177:          node->qel = nodeBnd->elbc;
 4178: 
 4179:       } else {
 4180:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4181: 
 4182:          for (int j = 0; j < node->numNodes; j++) {
 4183:                Node* nbNode = node->nodes[j];
 4184:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4185:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4186:                   // Verify neighbor's BC value
 4187:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4188: 
 4189:                   // Subtract contribution to RHS
 4190:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4191:                   node->coeffMatrix[j] = 0.0;  
 4192:                }
 4193:          }
 4194:       }
 4195:    }
 4196: 
 4197: 
 4198:    __global__ void updateElevation(void) {
 4199:       NODE(node);
 4200: 
 4201:       node->eta2 = node->mX;
 4202:    }
 4203: 
