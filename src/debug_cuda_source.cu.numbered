 1583:                    double *cs, double *dcs
 1584:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1585:                        np(np), ne(ne), ns(ns),
 1586:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1587:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1588:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1589:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1590:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1591:                        localSegmentMem(localSegmentMem),
