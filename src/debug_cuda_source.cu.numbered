 6010: 
 6011:    __global__ void zeroNodalVelocities(void) {
 6012:       NODE(node);
 6013: 
 6014:       for (int k = 0; k < nvrt; k++) {
 6015:          node->u2[k]   = {0.0, 0.0};
 6016:          node->w2[k]   = 0.0;
 6017:          node->utmp[k] = {0.0, 0.0};
 6018:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6019:       }
 6020:    }
 6021:  
 6022: 
 6023:    __global__ void computeNodalVerticalVelocities1(void) {
 6024:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6025:    // Adds the element's vertical velocity times the element's area.
 6026:       ELEM(elem);
 6027: 
 6028:       for (int j = 0; j < elem->i34; j++) {
 6029:          Node *node = elem->nodes[j];
 6030: 
 6031:          for (int k = node->kb; k < nvrt; k++) {
 6032:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6033:          }
 6034:          atomicAdd(&(node->tmp.d), elem->area);
 6035:       }
 6036:    }
 6037: 
 6038:    __global__ void computeNodalVerticalVelocities2(void) {
 6039:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6040:    // Divides by the total area of the elements sharing the    node.
 6041:       NODE(node);
 6042: 
 6043:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6044: 
 6045:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6046:    }
 6047: 
 6048: 
 6049:    __global__ void computeNodalHorizontalVelocities1(void) {
 6050: 
 6051:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6052:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6053: 
 6054:       ELEM(elem);
 6055: 
 6056:       if (elem->isDry) return;
 6057: 
 6058:       const int kb = elem->kb;
 6059:       const bool isTri = elem->isTri();
 6060: 
 6061:       if constexpr(indvel <= 0) {
 6062:          // Assuming discontinous hvel.
 6063: 
 6064:          if (isTri) { // For triangles
 6065:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6066:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6067: 
 6068:             for (int j = 0; j < 3; j++) {
 6069:                // For every node of the triangle...
 6070:                Node *node = elem->nodes[j];
 6071: 
 6072:                if (node->isDry) continue;
 6073: 
 6074:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6075:                const Side *s2 = elem->sides[(j + 1) % 3];
 6076:                const Side *s3 = elem->sides[(j + 2) % 3];
 6077: 
 6078:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6079: 
 6080:                atomicAdd(&(node->tmp.i), 1);
 6081: 
 6082:                for (int k = kb; k < nvrt; k++)  {
 6083:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6084:                   u = clampVelocity(u);
 6085:                   atomicAdd(&(node->utmp[k].x), u.x);
 6086:                   atomicAdd(&(node->utmp[k].y), u.y);
 6087: 
 6088:                }
 6089: 
 6090:             }
 6091:          }
 6092:          else { // For quads
 6093:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6094: 
 6095:          }
 6096: 
 6097:       }
 6098:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6099:       
 6100:    }
 6101: 
 6102: 
 6103:    __global__ void computeNodalHorizontalVelocities2(void) {
 6104:       NODE(node);
 6105: 
 6106:       const int nodeCount = node->tmp.i;
 6107: 
 6108:       if (nodeCount == 0) 
 6109:       {
 6110:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6111:          return;
 6112:       }
 6113: 
 6114:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6115:       
 6116:       const int kb = node->kb;
 6117: 
 6118:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6119:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6120:       
 6121:       
 6122:    }   
 6123: 
 6124:  
 6125: 
 6126:    __global__ void resetVelocityOpenBndNodes(void) {
 6127:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6128: 
 6129:       NODE_BND(nodebnd);
 6130: 
 6131:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6132:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6133:       }
 6134: 
 6135:    }
 6136: 
 6137: 
 6138:    __global__ void setVelocityOpenBndNodes(void) {
 6139:    // For open boundary nodes sets their velocity to the imposed values.
 6140: 
 6141:       SIDE_BND(sidebnd);
 6142: 
 6143:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6144:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6145:          // to its segment to the average of the side velocity.
 6146: 
 6147:          for (int k = 0; k < nvrt; k++) {
 6148:             Node *n1 = sidebnd->side->n1;
 6149:             Node *n2 = sidebnd->side->n2;
 6150: 
 6151: 
 6152:             Vector2 n1_u2(n1->u2[k]);
 6153:             Vector2 n2_u2(n2->u2[k]);
 6154: 
 6155:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6156:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6157:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6158:             }
 6159:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6160:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6161:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6162:             }
 6163: 
 6164:          }
 6165: 
 6166:       }
 6167: 
 6168:    }
 6169: 
 6170: 
 6171:    __global__ void computeVerticalVelocity(void) {
 6172:       // Computes the vertical velocity at the (2D) element's centroid.
 6173:       // In this function we will be considering volumetric elements, with side faces and a 
 6174:       // bottom and a top face. We will call them SFs, BF and TF.
 6175:       // It computes the flux coming from BF and the SFs.
 6176:       // If the bed is moving, it takes that into account.
 6177:       // Since water is incompressible, the integral of the velocity times the normal vector
 6178:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6179:       // and the BF is equal to the flux going out from the TF.
 6180:       // TF = - BF - sum(SFs).
 6181:       // It then computes the horizontal velocity at the center of TF.
 6182:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6183:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6184:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6185: 
 6186:       ELEM(elem);
 6187: 
 6188:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6189: 
 6190:       if (elem->isDry) return;
 6191: 
 6192:       const int kb = elem->kb;
 6193:       const bool isTri = elem->isTri();
 6194: 
 6195:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6196: 
 6197:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6198:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6199:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6200: 
 6201:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6202: 
 6203:       double area3D;
 6204: 
 6205:       // Bottom face flux
 6206:       double bottomFlux = 0.0;
 6207:       Vector2 u2meanBottom = {0.0, 0.0};
 6208:       const Vector2 gradh = elem->grad2(&Node::depth);
 6209:       if constexpr(imm==2) {
 6210:          Vector3 ubed;
 6211: 
 6212:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6213:          // updateBDEF(ubed);
 6214:      
 6215:          // const double bflux0 = dot(ubed, elem_n1);
 6216: 
 6217:          // elem->w[kb] += ubed.z;
 6218:       }
 6219:       else {
 6220:          Vector2 umean;
 6221:          if constexpr(ics == 1) {
 6222:             u2meanBottom = elem->mean(kb, &Side::u2);
 6223:          }
 6224:          else {
 6225:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6226:          }
 6227: 
 6228:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6229:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6230: 
 6231:          bottomFlux = - dot(gradh, u2meanBottom);
 6232:       } // if imm
 6233: 
 6234:       // Compute w for kb+1 to nvrt-1
 6235:       for (int l = kb; l < nvrt - 1; l++) {
 6236: 
 6237:          // normal vector to the top face of the "volumetric" element (3D)
 6238:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6239: 
 6240:          // Compute the total flux at the sides
 6241:          double sideFlux = 0.0;
 6242: 
 6243:          for (int j = 0; j < elem->i34; j++) {
 6244:             const Side *side = elem->sides[j];
 6245: 
 6246:             const double sideArea = side->area(l);
 6247:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6248:             const double sign = elem->ssign[j]; 
 6249: 
 6250:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6251:          }
 6252:          
 6253:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6254:          //velocities at the centers of the sides
 6255:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6256: 
 6257:          // The flx at the top ace can be computed from the other flows.
 6258:          const double topFlux = - sideFlux - bottomFlux;
 6259:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6260: 
 6261:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6262: 
 6263:          elem_n1 = elem_n2;
 6264: 
 6265:          bottomFlux = - topFlux;
 6266:       }
 6267:    }  
 6268: 
 6269: 
 6270: 
 6271: 
 6272: 
 6273: 
 6274: 
