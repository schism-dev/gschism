  488: 
  489:    int kb;                    // Bottom index of the element
  490:    double area;               // Area of the element
  491:    double ssign[4];           // Sign associated with each side of an element
  492:    double radius;             // Element equivalent radii
  493: 
  494:    Frame frame;
  495: 
  496:    Vector2 gradPhi[4];       // Derivatives of shape functions
  497:    Vector2 gradEta;          // Gradient of free surface elevation
  498:    Vector2 gradPr;           // Gradient of pressure    
  499:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  500: 
  501:    bool isDry;                // True if the element is dry
  502: 
  503:    Vector2 center;         // Element center coordinates
  504:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  505:    double depth;              // Depth at element (min of all nodes)
  506:    double z[nvrt];            // z-coord  (local frame - vertical up)
  507: 
  508:    // Physical information
  509:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  510: 
  511:    static const bool isblock = false;              // Always false
  512: 
  513:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  514:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  515: 
  516:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  517: 
  518:    
  519: 
  520:    double vsource;            // Volumetric source/sink term [m^3/s]
  521: 
  522:    double rho[nvrt];          // Density at each prism center
  523:    double rho_mean[nvrt];     // Mean density at each prism center
  524:    CubicSpline rho_spl;
  525:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  526:    double rho_z[nvrt];        // First derivative of density at each prism center
  527:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  528: 
  529:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  530: 
  531:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  532:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  533: 
  534:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  535:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  536: 
  537:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  538:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  539:       // Find the local index of the node in the element (0,1,2,3)
  540:       int res = __ffs((nodes[0] == node) | 
  541:                      ((nodes[1] == node) << 1) | 
  542:                      ((nodes[2] == node) << 2) | 
  543:                      ((nodes[3] == node) << 3)) - 1;
  544:       
  545:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  546:       return res;  
  547:    }
  548: 
  549:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  550:       // Find the local index of the side in the element (0,1,2,3)
  551:       int res = __ffs((sides[0] == side) | 
  552:                      ((sides[1] == side) << 1) | 
  553:                      ((sides[2] == side) << 2) | 
  554:                      ((sides[3] == side) << 3)) - 1;
  555:       
  556:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  557:       return res;
  558:    }
  559: 
  560: 
  561:    __inline__ __device__ int findLevel(double z1, int k) const {
  562:       // Starting at index k, find sequentially the level that contains z
  563: 
  564:       // For testing purposes, forgets k and performs a full search.
  565:       for (k = kb; k < nvrt - 1; k++) {
  566:          if (idx==46) printf("((()))))) kk = %d, z[%d] = %.16f, z[%d] = %.16f\n", k, k, z[k], k + 1, z[k + 1]);            
  567:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  568:       }
  569:       return nvrt - 2;
  570: 
  571: 
  572:       // if z is already betweeen z[k] and z[k+1], return k
  573:       if (idx==46) for (int kkk=0; kkk<nvrt; kkk++) printf("##>>>>  z[%d] = %.16f\n", kkk, z[kkk]);             
  574: if (idx==46) printf("##>>>>#### kk = %d, z1 = %.16f, z[%d] = %.16f, z[%d] = %.16f\n", k, z1, k, z[k], k + 1, z[k + 1]);       
  575:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  576:       else if (z1 <  z[k]) { 
  577:          // Search for increasing levels
  578:          for (int kk = k; kk < nvrt - 1; kk++) {
  579: if (idx==46) printf("##>>#### kk = %d, z[%d] = %.16f, z[%d] = %.16f\n", kk, kk, z[kk], kk + 1, z[kk + 1]);            
  580:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  581:          }
  582:          return nvrt - 1;
  583:       }
  584:       else {
  585:          // Search for decreasing levels
  586:          for (int kk = k; kk >= kb; kk--) {
  587: if (idx==46) printf("###>>### kk = %d, z[%d] = %.16f, z[%d] = %.16f\n", kk, kk, z[kk], kk + 1, z[kk + 1]);             
  588:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  589:          }
  590:          return 0;
  591:       }
  592:    }
  593: 
  594:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  595:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  596: 
  597:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  598:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  599:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  600:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  601:        const double eta = (idx & 1) ? +g : -g;
  602:        const double xi  = (idx & 2) ? +g : -g;
  603:        return {eta, xi};
  604:    }  
  605: 
  606:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  607:    __device__ __forceinline__ double etaSign(int idx) const {
  608:       // bit1: 0 -> -1, 1 -> +1
  609:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  610:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  611:    }
  612: 
  613:    __device__ __forceinline__ double xiSign(int idx) const {
  614:       // +1 if (bit0 XOR bit1), else -1
  615:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  616:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  617: 
  618:    }
  619: 
  620:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  621:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  622:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  623:    }
  624: 
  625:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  626:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  627:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  628:    }   
  629: 
  630:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  631:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  632:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  633:    }      
  634:    
  635:    __inline__ __device__ double detJ_eta(void) const;
  636: 
  637:    __inline__ __device__ double detJ_xi(void) const;
  638: 
  639:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  640: 
  641:    // Check if the element is dry using the more up-to-date elevation.
  642:    __inline__ __device__ bool isDry2(void) const;
  643: 
  644:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  645: 
  646:    __inline__ __device__ double computeSignedArea(void) const;
  647: 
  648:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  649:       // Nudges the point (x,y) to the barycenter of the element
  650:       p = (1-eps)*p + eps*center;
  651:    }
  652: 
  653:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  654:    
  655:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  656: 
  657:    __device__ double intPhiPhi(int i1, int i2) const;
  658: 
  659:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  660: 
  661:    __device__ Vector2 grad2(double *a) const
  662:    {
  663:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  664:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  665:       if (isQuad()) {
  666:          gx += a[3]*gradPhi[3].x;
  667:          gy += a[3]*gradPhi[3].y;
  668:       }
  669:       return {gx, gy};
  670:    }
  671: 
  672:    __device__ Vector2 grad2(double Node::* field) const
  673:    {
  674:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  675:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  676:       if (isQuad()) {
  677:          gx += (nodes[3]->*field)*gradPhi[3].x;
  678:          gy += (nodes[3]->*field)*gradPhi[3].y;
  679:       }
  680:       return {gx, gy};
  681:    }
  682: 
  683:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  684:    __device__ __forceinline__ Vector3 n(int k) const {
  685:       double area3D;
  686:       return n(k, area3D);
  687:     }
