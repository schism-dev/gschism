 8581: 
 8582:    switch (varCode) {
 8583:       case (int)VarCode::outputCoords:
 8584:          const Point2 coords = elem->outputCoords();
 8585:          res[elem->idx*2    ] = coords.x;
 8586:          res[elem->idx*2 + 1] = coords.y;
 8587:          break;
 8588:    }
 8589: }
