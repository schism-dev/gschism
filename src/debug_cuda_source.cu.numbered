 2154: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 2155:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 2156: }
 2157: 
 2158: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 2159:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 2160: }   
