 7296:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7297:                    double *wind_rotate_angle, 
 7298:                    int *isdel, int *isidenode, int *isbnd,
 7299:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7300:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7301:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7302:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7303:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7304:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7305:                    double *drag, double *roughness,
 7306:                    double *emo, double *efa, 
 7307:                    double *umo, double *ufa, 
 7308:                    double *vmo, double *vfa) {
