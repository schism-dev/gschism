 3154: 
 3155: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3156:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3157:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3158:    // 
 3159:    // This kernel is called for all nodes.
 3160: 
 3161: 
 3162:    NODE(node1);
 3163: 
 3164: 
 3165:    node1->clearMatrixRow();
 3166:    node1->qel = 0.0;
 3167: 
 3168:    // THIS IS FOR STRUCTURES XXX
 3169:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3170: 
 3171:    
 3172:    for (int j=0; j<node1->numElements; j++) {
 3173:       // For each element connected to the node...
 3174: 
 3175:       Element *elem = node1->elements[j];
 3176: 
 3177:       // Compute the average gravity
 3178:       const double grav3 = elem->mean(&Node::grav2);
 3179: 
 3180:       // Look at the documentation for the description of the terms in the following integrals
 3181: 
 3182:       // Integral I_1 
 3183:       // \bar{\breve{H}} 
 3184:       const double hhatb = elem->mean(&Side::hhat);        
 3185: 
 3186: 
 3187:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3188: 
 3189:       const int id1 = elem->nodeLocalIdx(node1); 
 3190:       const double area = elem->area;
 3191: 
 3192:       if (elem->isTri()) {
 3193: 
 3194:          // To clarify the notation in this section: 
 3195:          //   i stands for the node under consideration (node1)
 3196:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3197:          const int id2 = elem->nxq(1 + id1);
 3198:          const int id3 = elem->nxq(2 + id1);
 3199:          Node *node2 = elem->nodes[id2];
 3200:          Node *node3 = elem->nodes[id3];
 3201: 
 3202:          const Point2 x1 = node1->p2();
 3203:          const Point2 x2 = node2->p2();
 3204:          const Point2 x3 = node3->p2();
 3205: 
 3206:          // integral of phi_i*phi_j
 3207:          const double ipp_ii = (1.0/6.0 )*area;
 3208:          const double ipp_ij = (1.0/12.0)*area;
 3209:          const double ipp_ik = (1.0/12.0)*area;
 3210: 
 3211:          // integral of [(grad phi_i) * (grad phi_j)]
 3212:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3213:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3214:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3215: 
 3216:          // Computes the different components of integral I_1 of each node with respect to node i.
 3217:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3218:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3219:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3220: 
 3221: if (j==node1->numElements-1) {
 3222: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 3223: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 3224: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3225: }
 3226: 
 3227:          node1->addToSparseMatrix(node1, I1_ii);
 3228:          node1->addToSparseMatrix(node2, I1_ij); 
 3229:          node1->addToSparseMatrix(node3, I1_ik);
 3230: 
 3231: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3232:      
 3233:       }
 3234:       else { // Quad
 3235:          // XXX IMPLEMENT THIS
 3236:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3237:       } 
 3238: 
 3239:  
 3240:       // Integral I_4
 3241:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3242:       // Where
 3243:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3244: 
 3245:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3246:       // of U over the element.
 3247:       Vector2 Umean = {0.0, 0.0};
 3248:       for (int m=0; m<elem->i34; m++) {      
 3249:          const Side *side = elem->sides[m];
 3250: 
 3251:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3252:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3253:       }
 3254:       Umean = Umean/elem->i34;
 3255: 
 3256:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3257: 
 3258:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3259:       const double I_4_1 = dot(gradPhi_1, Umean);
 3260: 
 3261:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3262:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3263:      
 3264:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3265: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 3266: 
 3267:       // Additional terms 
 3268:       double vnorm = 0.0;
 3269:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3270:          Vector3 ubed;
 3271:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3272: 
 3273:          Vector3 gradP = {0.0, 0.0, 1.0};
 3274:          for (int m=0; m < elem->i34; m++) {
 3275:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3276:            gradP += toVector3(gradP_2D, 0.0);
 3277:          }   
 3278:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3279:       } // imm==2
 3280: 
 3281:       if (elem->isTri()) {
 3282:          for (int l=0; l<3; l++) {
 3283:            double fac;
 3284: 
 3285:            Node *node = elem->nodes[l];
 3286: 
 3287:            (node == node1)? fac=2.0 : fac=1.0;
 3288: 
 3289:            if constexpr(imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3290:            else                 node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3291:            
 3292:          }
 3293: 
 3294: 
 3295:          if (!elem->isDry) {
 3296:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3297: 
 3298:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3299:          }
 3300: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 3301: 
 3302:       } // isTri
 3303:       else { // isQuad
 3304:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3305:          // for (int l=0; l<4; l++) {
 3306:          //   const Node *node = elem->nodes[l];
 3307: 
 3308:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3309:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3310: 
 3311:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3312:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3313:          // }
 3314: 
 3315:       } // isQuad
 3316: 
 3317: 
 3318:       node1->qel += (dt/elem->i34)*elem->vsource;
 3319:       
 3320: 
 3321:    } // for all elements connected to the node
 3322:    
 3323: 
 3324: 
 3325:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3326:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3327:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3328:    if (nodeBnd != nullptr)  { 
 3329:       // If it is an open boundary node...
 3330: 
 3331:       // At least one open bnd side, maybe two
 3332:       for (int l=0; l<2; l++) { 
 3333: 
 3334:          // Gets each of the sides sharing the node. 
 3335:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3336: 
 3337:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3338: 
 3339:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3340: 
 3341:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3342:          if (sideBnd != nullptr) {
 3343:             // If the side is on a boundary...
 3344: 
 3345:             // Get the boundary segment
 3346:             const BoundarySegment *sideSegment = sideBnd->segment;
 3347:             const Side *side = sideBnd->side;
 3348: 
 3349:             // Integral I_3
 3350:             if (sideSegment->ifltype != 0) {
 3351:             // Natural or Flather b.c.
 3352: 
 3353:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3354:                // especially for Flather b.c.
 3355:                double ri3 = 0.0;
 3356:                if (!side->isDry) {
 3357:                   // If the side is not dry
 3358:                   
 3359:                   // Computes the side flux of (uth, vth)
 3360:                   double Vn = 0.0;
 3361:                   for (int k = side->kb; k<nvrt-1; k++) {
 3362:                      // uth, vth in lat/lon frame if ics=2
 3363:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3364:                      const double vn1 = dot(sideBnd->uth(k  ), side->n); // outer normal
 3365:                      const double vn2 = dot(sideBnd->uth(k+1), side->n);
 3366: 
 3367:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3368:                   }
 3369: 
 3370:                   ri3 = 0.5*side->len*Vn;
 3371:                }
 3372: 
 3373:                if (sideSegment->ifltype == -1) { // Flather 1
 3374: 
 3375:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3376:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3377: 
 3378:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3379:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3380:                   
 3381:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3382:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3383: 
 3384:                } 
 3385:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3386:                   // Reset ri3
 3387:                   ri3 = 0.0;
 3388: 
 3389:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3390: 
 3391:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3392: 
 3393:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3394:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3395: 
 3396:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3397:                   node1->addToSparseMatrix(node1, con0*2.0);
 3398:                   node1->addToSparseMatrix(node2, con0);
 3399: 
 3400:                } // if Flather or Discharge
 3401: 
 3402:                node1->qel -= thetai*dt*ri3;
 3403: 
 3404:             } // I_3
 3405:           
 3406: 
 3407:             // Integral I_5
 3408:             if(!side->isDry) {
 3409: 
 3410:                const double Unbar = dot(side->U, side->n);
 3411: 
 3412:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3413:                
 3414:             } // I_5
 3415: 
 3416:          } // if is boundary side
 3417: 
 3418:       } // for l
 3419: 
 3420:    } // if isbnd
 3421: 
 3422: 
 3423:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3424: 
 3425: }
 3426: 
 3427: 
 3428: 
 3429: extern "C" {
 3430:    __global__ void rollUpElevation(void) {
 3431: 
 3432:       NODE(node);
 3433: 
 3434:       node->eta2 += node->eta1;
 3435: 
 3436:    }
 3437: 
 3438: 
 3439:    __global__ void backtrackAllNodes(void) {
 3440: 
 3441:       // max/min # of sub-divisions
 3442:       const int ndelt_max = max(1.0, dt/dtb_min);
 3443:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3444: 
 3445:       // Removed all references to swild98 XXX
 3446:       // swild98=0.d0 !init
 3447: 
 3448: 
 3449:       SIDE(side);
 3450: 
 3451:       const int kb = side->kb;
 3452: 
 3453: 
 3454: 
 3455:       // Initialize btrack velocities to the actual velocities at the side 
 3456:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3457: 
 3458: printf("OOXXXOOOOO idx = %d,  side->isDry = %d\n", side->idx, side->isDry);
 3459:       if (side->isDry) return;
 3460: 
 3461: 
 3462:       // Checks that at least one element is not dry
 3463:       const Element *elem1 = side->elems[0];
 3464:       const Element *elem2 = side->elems[1];
 3465: 
 3466: 
 3467:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3468:       
 3469:       // XXXXXX
 3470:       // !swild_tmp to store global coord. of the starting side
 3471:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3472:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3473:       // !Use sframe2 
 3474:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3475: 
 3476: 
 3477:       for (int k = kb; k < nvrt; k++) {
 3478:       //  Initialize (xt,yt,zt), nnel and vel.
 3479:       //  For ics=2, the coordinates are in local frames
 3480:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3481: 
 3482: 
 3483:          const int iadvf = side->iadv();  // Advection flag
 3484: 
 3485:          Point3 xt;
 3486:          if constexpr(ics==1) {
 3487:             xt = side->center3D(k); 
 3488:          }
 3489:          else // lat/lon; in side lat/lon frame
 3490:          {
 3491:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3492:          // XXX IMPLEMENT THIS
 3493:       //          xt=0.d0
 3494:       //          yt=0.d0
 3495:       //          !centroid coord. for nudging
 3496:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3497:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3498:          }  // ics
 3499: 
 3500: 
 3501:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3502:          // XXX IS THIS NECESSARY?
 3503:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3504: 
 3505:          // If on land or open boundary...
 3506:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3507:          
 3508:          const double vmag = length(toVector2(u_int));
 3509: printf("OOOXX___XXOOOO idx = %d, k = %d, vmag = %e\n", side->idx, k, vmag);
 3510: 
 3511:          if (vmag <= velmin_btrack) {
 3512:             // No activity 
 3513: addDebugPlot(side->center, side->center, 0x00FF00);
 3514: printf("OOOXXXXOOOO idx = %d, k = %d, u_int = %e, %e, %e\n", side->idx, k, u_int.x, u_int.y, u_int.z);
 3515:             side->btu[k] = side->u2[k];
 3516:             
 3517:          } else {  // do btrack
 3518: 
 3519:             // Compute number of sub-divisions based on local gradients 
 3520:             // XXX IS THIS NECESSARY?
 3521:             double suma = 0.0;
 3522:             int icount = 0;
 3523:             for (int ii=0; ii<2; ii++) {
 3524: 
 3525:                const Element *elem = side->elems[ii];
 3526:                  
 3527:                if (elem == nullptr) continue;
 3528: 
 3529:                icount++;
 3530: 
 3531:                // Not strictly along z; in ll frame for ics=2
 3532: 
 3533:                double utmp[4];
 3534:                double vtmp[4];
 3535:                for (int jj = 0; jj < elem->i34; jj++) {
 3536: 
 3537:                   const Node *node = elem->nodes[jj];
 3538: 
 3539:                   if constexpr(ics==1) {
 3540:                      utmp[jj] = node->u2[k].x;
 3541:                      vtmp[jj] = node->u2[k].y;  
 3542:                   } else {
 3543:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3544:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3545:                   }
 3546:                } // for jj
 3547: 
 3548:                const Vector2 grad_u = elem->grad2(utmp); 
 3549:                const Vector2 grad_v = elem->grad2(vtmp);
 3550: 
 3551:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3552:             } // for ii
 3553: 
 3554:             assert(icount > 0 && "Impossible 77");
 3555: 
 3556:             // '4' is somewhat arbitrary
 3557:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3558: 
 3559:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3560:          
 3561: 
 3562:             Vector3 u_int = {0.0, 0.0, 0.0};
 3563: 
 3564: printf("AAAAAAA idx = %d, k = %d, u_int = %e, %e\n", side->idx, k, u_int.x, u_int.y);
 3565:             side->btrack(k, dt, dtbk, u_int);
 3566: printf("OOOOOOO idx = %d, k = %d, u_int = %e, %e\n", side->idx, k, u_int.x, u_int.y);
 3567:             side->btu[k] = toVector2(u_int);
 3568:                
 3569:          } // if vmag (do backtrack)
 3570: 
 3571:       } // for j=jmin,nvrt-1
 3572: 
 3573:    }
 3574: } // extern "C"
 3575: 
 3576: template<int nc>
 3577: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3578: 
 3579: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3580: //
 3581: // a,b,c,rhs: input vectors and are not modified by this program.
 3582: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3583: // rhs is the r.h.s.
 3584: // n: actual rank of the system.
 3585: // rows in u() and rhs();
 3586: // u: output with nc columns (transposed to rows)
 3587: // gam: a working array.
 3588: //
 3589: // NOTES:
 3590: // This is a template function that allows for different numbers of columns in the rhs vector.
 3591: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3592: 
 3593:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3594:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3595: 
 3596:    double bet = b[0];
 3597:    if constexpr (nc == 1) {
 3598:       u[0] = rhs[0]/bet;
 3599:    } else {
 3600:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3601:    }
 3602: 
 3603:    for (int j = 1; j < n; j++) {
 3604:       gam[j] = c[j-1]/bet;
 3605:       bet = b[j] - a[j]*gam[j];
 3606: 
 3607:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3608: 
 3609:       if constexpr (nc == 1) {
 3610:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3611:       } else {
 3612:          for (int k = 0; k < nc; k++) {
 3613:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3614:          }
 3615:       }
 3616:    }
 3617: 
 3618:    // Back-substitution
 3619:    for (int j=n-1; j>=1; j--) {
 3620:       if constexpr (nc == 1) {
 3621:          u[j] = u[j] - gam[j+1]*u[j-1];
 3622:       } else {
 3623:          for (int k = 0; k < nc; k++) {
 3624:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3625:          }
 3626:       }
 3627:    }
 3628: }
 3629: 
 3630: 
 3631: 
 3632: // Helper function that contains the core algorithm
 3633: template<typename XAccessor, typename YAccessor>
 3634: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3635:                                     double  yp_top, double  yp_bot, 
 3636:                                     CubicSpline &spline) {
 3637:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3638:    // 
 3639:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3640:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3641:    //
 3642:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3643:    // 
 3644:    // Inputs: 
 3645:    //            n: dimension for x etc; # of data pts (>=2);
 3646:    //            getX, getY: functions to access x,y coordinates
 3647:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3648:    //     Output: 
 3649:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3650: 
 3651:    const int n = k2 - k1 + 1;
 3652:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3653: 
 3654:    // Allocate memory for the splines
 3655:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3656:    spline.x   = new double[n];
 3657:    spline.y   = new double[n];
 3658:    spline.yp  = new double[n];
 3659:    spline.ypp = new double[n];
 3660: 
 3661:    for (int k=k1; k<=k2; k++) {
 3662:       spline.x[k] = getX(k);
 3663:       spline.y[k] = getY(k);
 3664:    }
 3665: 
 3666:    // This is to simplify expressions later
 3667:    double *x = spline.x;
 3668:    double *y = spline.y;
 3669: 
 3670:    double *a = nullptr;
 3671:    double *b = nullptr;
 3672:    double *c = nullptr;
 3673:    double *gam = nullptr;
 3674:    double *rhs = nullptr;
 3675:    
 3676: 
 3677:       a = new double[n];   // Lower diagonal
 3678:       b = new double[n];   // Diagonal
 3679:       c = new double[n];   // Upper diagonal
 3680:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3681:       rhs = new double[n]; // Right-hand side
 3682: 
 3683:    for (int k=k1; k<=k2; k++) {
 3684:       if (k == k1) {
 3685:          // Bottom level
 3686:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3687:          b[k] = (x[k+1] - x[k])/3.0;
 3688:          c[k] = b[k]/2.0;
 3689:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3690:       } else if (k == n - 1) {
 3691:          // Top level (surface)
 3692:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3693:          b[k] = (x[k] - x[k-1])/3.0;
 3694:          a[k] = b[k]/2.0;
 3695:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3696:       } else {
 3697:          // Intermediate levels
 3698:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3699:          b[k] = (x[k+1] - x[k-1])/3.0;
 3700:          a[k] = (x[k  ] - x[k-1])/6.0;
 3701:          c[k] = (x[k+1] - x[k  ])/6.0;
 3702:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3703:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3704:       }
 3705:    }
 3706: 
 3707:    // Solve the tridiagonal system
 3708:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3709:    
 3710:    spline.yp[k1] = yp_bot;
 3711:    spline.yp[k2] = yp_top;
 3712: 
 3713:    // Compute rest of 1st derivatives using the splines
 3714:    for (int k=k1+1; k<k2; k++) {
 3715:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3716:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3717:    }
 3718:    
 3719:    delete[] a;
 3720:    delete[] b;
 3721:    delete[] c;
 3722:    delete[] gam;
 3723:    delete[] rhs;
 3724: 
 3725: }
 3726: 
 3727: // Array version
 3728: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3729:                                 double y_top, double y_bot, 
 3730:                                 CubicSpline &spline) {
 3731:    auto getX = [x] (int k) { return x[k]; };
 3732:    auto getY = [y] (int k) { return y[k]; };
 3733:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3734: }
 3735: 
 3736: // Lambda version - allows custom access patterns
 3737: template<typename XFunc, typename YFunc>
 3738: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3739:                                 double y_top, double y_bot,
 3740:                                 CubicSpline &spline) {
 3741:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3742: }
 3743: 
 3744: 
 3745: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3746: {
 3747:    assert("Not implemented");
 3748: 
 3749:    return 0.0;
 3750: }
