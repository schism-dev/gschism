 1728: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1729:    return;
 1730:    // Lock the mutex
 1731:    lock(&debugPlotMutex);
 1732:  
 1733:    bool ok = true;
 1734:    if (debugPlotIdx == nullptr) ok = false;
 1735:    if (*debugPlotIdx >= 10000) ok = false;
 1736:    if (ok) {
 1737:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1738:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1739:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1740:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1741:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1742:       (*debugPlotIdx)++;
 1743:    }
 1744: 
 1745:    __threadfence();               // ensure all above writes are visible
 1746:    // Unlock the mutex
 1747:    unlock(&debugPlotMutex);
 1748: 
 1749: }
 1750: 
 1751: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1752:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1753: }
