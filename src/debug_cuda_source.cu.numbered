 1650: 
 1651: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1652:                                               double &t, double& tIntersect) {
 1653: 
 1654:    double closest_intersect_t = 1e10;
 1655:    bool found_intersection = false;
 1656: 
 1657: double minDelta = 1e10; 
 1658: double btt1 = 1e10, btt2;
 1659:    for (int i = 0; i < i34; i++) {
 1660: 
 1661:       Side *side2 = sides[i];
 1662: 
 1663:       // (x3,y3)-(x4,y4) is the element side line
 1664:       const Point2 x3 = side2->n1->p2();
 1665:       const Point2 x4 = side2->n2->p2();
 1666: 
 1667:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1668:       const double delta = cross(x2 - x1, x3 - x4);
 1669: 
 1670:       if (abs(delta) > 0) {
 1671: 
 1672:          const double delta1 = cross(x3 - x1, x3 - x4);
 1673:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1674: 
 1675:          // Solves the two linear equations for tt1 and tt2
 1676:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1677:          const double tt2 = delta2/delta;
 1678: 
 1679: if (abs(tt1) < abs(btt1)) {
 1680:    minDelta = abs(delta);
 1681:    btt1 = tt1;
 1682:    btt2 = tt2;
 1683: }
 1684: 
 1685: if (idx == 0) printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1686:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1687:             closest_intersect_t = min(closest_intersect_t, tt1);
 1688:             side = side2;
 1689:             nextElement = side->otherElem(this);
 1690:             t = tt2;
 1691:             tIntersect = max(small, min(tt1, 1.0-small));
 1692:             found_intersection = true;
 1693:          }
 1694:       
 1695:       }
 1696:       else {  // parallel segments
 1697:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1698:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1699: 
 1700:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1701: 
 1702:          // const double dist = dot(x1 - x3, side2->n);
 1703:          // if (abs(dist) < small*length(x3 - x4)) {
 1704:          //    const double2 unitarySide = normalize(x4 - x3);
 1705:          //    const double len = dot(x2 - x1, unitarySide);
 1706:          //    t = t + len;
 1707:          //    t = max(0.0, min(t, 1.0));
 1708:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1709: 
 1710: 
 1711:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1712:          //    // t = tt2;
 1713:          //    found_intersection = true;
 1714:          // }
 1715:       }
 1716: 
 1717: 
 1718:    }
 1719: 
 1720:    if (!found_intersection) {
 1721:       
 1722: if (idx == 0) printf("ZZ No intersection found:\n"
 1723:            "Element %d\n"
 1724:            "in = %d\n"
 1725:            "minDelta = %e\n"
 1726:            "tt1 = %e, tt2 = %e\n"
 1727:            "segment: (%f, %f)-(%f, %f)\n"
 1728:            "Vertices:\n"
 1729:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1730:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1731:            IDX(nextElement),
 1732:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1733:            minDelta,
 1734:            btt1, btt2,
 1735:            x1.x, x1.y,
 1736:            x2.x, x2.y,
 1737:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1738:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1739:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1740:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1741:            nodes[0]->p.x, nodes[0]->p.y,
 1742:            nodes[1]->p.x, nodes[1]->p.y,
 1743:            nodes[2]->p.x, nodes[2]->p.y,
 1744:            nodes[0]->p.x, nodes[0]->p.y);
 1745: 
 1746:    }
 1747: 
 1748:    // assert(found_intersection && "No intersection found");
 1749: 
 1750:    // found_intersection should always be true, since we checked all the sides.  
 1751:    return found_intersection;
 1752: }
