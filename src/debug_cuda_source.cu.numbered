 6795: //               endif
 6796: 
 6797: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 6798: //               do j=1,i34(i)
 6799: //                 jsj=elside(j,i) !side
 6800: //                 iweno=.true. !use weno reconstruction as default
 6801: //                 iel=ic3(j,i) !neighboring elem
 6802: 
