  313: // Polynomial class
  314: template<int grade>
  315: struct Polynomial {
  316:     // Static assertion to give a clear error message at compile time
  317:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  318: };
  319: 
  320: 
  321: // Explicit specialization for grade 4
  322: template<>
  323: struct Polynomial<4> {
  324:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  325: 
  326:    // Constructor from coefficients
  327:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  328: 
  329:    __device__ __forceinline__ double eval(double x) const {
  330:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  331:    }
  332: };
  333: 
  334: // ------------------------------------------------------------------------------------------------
  335: 
  336: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  337:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  338:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  339: }
  340: 
  341: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  342:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  343:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  344: }
  345: 
  346: 
  347: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  348:    x3 = y1*z2 - y2*z1;
  349:    y3 = x2*z1 - x1*z2;
  350:    z3 = x1*y2 - x2*y1;
  351: }
  352: 
  353: 
  354: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  355: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  356: 
  357:    const double radius2 = dot(p, p);
  358:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  359:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  360: 
  361:    rlon = atan2(p.y, p.x); // (-pi,pi]
  362: 
  363:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  364:       rlat = asin(p.z/sqrt(radius2));
  365:    } else {
  366:       rlat = asin(p.z/rearth_pole);
  367:    }
  368:   
  369: }
  370: 
  371: __inline__ __device__ void Error(const char* msg) {
  372:    printf("Error: %s\n", msg);
  373:    assert(false);
  374: }
