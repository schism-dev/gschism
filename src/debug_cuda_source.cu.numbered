 4671:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4672: 
 4673:       SIDE(side);
 4674: 
 4675: 
 4676:       side->U = {0.0, 0.0}; 
 4677:          
 4678:       if(side->isDry) return;
 4679: 
 4680:       const Node *node1 = side->n1;
 4681:       const Node *node2 = side->n2;
 4682: 
 4683:       // Vertically integrated velocity U (in ll if ics=2)
 4684:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4685:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4686:       }
 4687: 
 4688:    }
 4689: 
 4690:    __global__ void computeBottomDragVegetation(void) {
 4691:       // UNFINISHED. CHECK THIS:
 4692:       // How many kernels are needed? Why so many for loops?
 4693:       // Is the loop on sides needed?
 4694: 
 4695:       NODE(node);
 4696: 
 4697: 
 4698:       const int    kb      = node->kb;
 4699:       const double htot    = node->htot2(); 
 4700:       
 4701:       if (node->isDry) {
 4702:          // Default values for dry nodes
 4703:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4704:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4705: 
 4706:          return;
 4707:        
 4708:       }
 4709: 
 4710:       // Computes bottom drag Cd based on the selected nchi
 4711:       node->computeBottomDragCd();
 4712:       
 4713: 
 4714: 
 4715:       //   Bottom stress in m^2/s^2
 4716:       if (node->rho[kb + 1] >= -98.0)
 4717:       {
 4718:          const double mag_u = length(node->u2[kb + 1]);
 4719:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4720: 
 4721:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4722:          // !sediment erosion: this part needs more documentation
 4723:       }
 4724:     
 4725: 
 4726: 
 4727:       // Compute vegetation parameters
 4728:       //--------------------------------
 4729: 
 4730:       // SAV constants
 4731:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4732:       constexpr double veg_cfpsi = 0.16;
 4733: 
 4734:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4735:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4736: 
 4737:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4738:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4739:          int kbin = 0; // bin index
 4740:          for (int k = kb; k < nvrt; k++) {
 4741:             // Computes node height above the bottom level
 4742:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4743:             assert(false && "Vertical variation of vegetation not implemented");
 4744: 
 4745:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4746:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4747:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4748:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4749:             // } else {
 4750:             //    // Find the bin at which the current vertical level is
 4751:             //    while (kbin<nbins_veg_vert) {
 4752:             //       const double zn = node->z[kbin];
 4753:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4754:             //          break;
 4755:             //       } // if
 4756:             //       kbin++;
 4757:             //    } // while
 4758:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4759: 
 4760:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4761:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4762:                
 4763:             //    // Linear interpolation of the vegetation parameters
 4764:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4765:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4766:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4767:             // } // if rl10
 4768: 
 4769:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4770: 
 4771:          } // for k
 4772: 
 4773: 
 4774:       } else { // Ganthy (iveg==2)
 4775:       //  Modify canopy height, diameter, and density
 4776: 
 4777:          // Make sure there is vegetation on this node
 4778:          if (node->veg_h_unbent > 0.0) {
 4779:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4780: 
 4781:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4782:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4783:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4784: 
 4785:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4786:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4787:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4788:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4789:          } // if veg_h_unbent
 4790: 
 4791:          for (int k = 0; k < nvrt; k++) {
 4792:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4793:          } // for k
 4794:       
 4795: 
 4796:       } // if iveg
 4797:      
 4798: 
 4799:       // Compute vertical mean of veg_alpha3D
 4800:       if (iveg != 0) {
 4801:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4802:          double sum1=0.0;
 4803:          double sum2=0.0;
 4804:          // Integrate over each level under the canopy...
 4805:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4806:             const double Dz = node->Dz(k);
 4807: 
 4808:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4809:             sum2 += Dz;
 4810: 
 4811:          } // for k
 4812:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4813:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4814: 
 4815:       } // if iveg
 4816: 
 4817:    }
 4818: 
 4819:    __global__ void computeVegetationAndDragParameters(void) {
 4820:       // Computes the vegetation and drag model parameters:
 4821:       // chi, \tilde\chi, beta, \breve{H}
 4822:       
 4823:       SIDE(side);
 4824: 
 4825:       if (side->isDry) return;
 4826: 
 4827:       const double htot = side->htot2();
 4828:       const int    kb   = side->kb;
 4829: 
 4830:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4831: 
 4832:       const double veg_h     = side->veg_h();
 4833:       const double veg_nv    = side->veg_nv();
 4834:       const double veg_c     = side->veg_c();
 4835:       const double veg_beta  = side->veg_beta;
 4836:       const double veg_alpha = side->veg_alpha_vert_mean();
 4837: 
 4838:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4839:       // Velocity magnitude at the bottom level
 4840:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4841:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4842:       side->chi2 = side->Cd()*vmag1;
 4843:       side->chi  = side->chi2;
 4844:       if constexpr(iveg != 0) {
 4845:          const Node *n1 = side->n1;
 4846:          const Node *n2 = side->n2;
 4847:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4848:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4849:       }
 4850: 
 4851:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4852: 
 4853:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4854:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4855:       double magUa = 0.0;
 4856:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4857:          // 3D wet side with veg...
 4858: 
 4859:          double magUa = 0.0;
 4860:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4861:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4862: 
 4863:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4864:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4865:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4866: 
 4867:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4868:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4869: 
 4870:                // Velocity magnitude at the bottom (l) of the level
 4871:                const double ul = length(side->u2[k]);
 4872: 
 4873:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4874:                magUa += Dz*0.5*(uh + ul);
 4875: 
 4876:             } // if HasVegetation
 4877:          } // for k
 4878:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4879: 
 4880:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4881:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4882:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4883:             const double zCpy = side->zTopCanopy();
 4884:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4885:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4886:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4887:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4888:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4889:          } // if isSubmerged
 4890:       } // if iveg   
 4891: 
 4892:       // Computes the friction modified depth, \breve{H} in notes
 4893:       if (side->is2D()) { // 2D
 4894: 
 4895:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4896:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4897: 
 4898:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4899: 
 4900:          side->hhat = htot*htot/fricH; 
 4901: 
 4902:       } else { // 3D
 4903:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4904: 
 4905:          if constexpr(iveg != 0) {
 4906:             
 4907:             if (side->isSubmerged()) { 
 4908:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4909:                side->hhat -= veg_c*Hhat_alpha;
 4910: 
 4911:             } else { // Emergent
 4912:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4913:             }
 4914:          } // if iveg
 4915: 
 4916:          // Enforce positivity for 3D model
 4917:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4918:       } // if 3D
 4919: 
 4920:    }
 4921: 
 4922: 
 4923: 
 4924:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4925:    // Computes the density gradient between two elements, e1 and e2.
 4926:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4927:    // zero in the direction normal to the side. 
 4928:    // 
 4929:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4930:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4931:    //
 4932:    // Input:
 4933:    //    e1: Element
 4934:    //    e2: Neighbor element (or nullptr if boundary)
 4935:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4936:    //    k: Index of the half-level at which the density is interpolated
 4937:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4938:    // 
 4939:    // Output:
 4940:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4941:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4942: 
 4943:       if (e2 == nullptr || e2->isDry) {
 4944:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4945: 
 4946:          Side *side = e1->sides[j];
 4947:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4948:                  
 4949:          if constexpr(ics == 1) {
 4950:             vec = side->n; // Normal vector to the side
 4951:          } else {
 4952:             // IMPLEMENT THIS XXXXXX
 4953:             // !replace with xel, yel?
 4954:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4955:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4956:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4957:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4958:          } //ics
 4959:                    
 4960:          diffRho = 0.0;
 4961: 
 4962:       } else { //internal and wet
 4963:          if constexpr(ics==1) {
 4964:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4965: 
 4966:             // Vector from e1 to e2
 4967:             vec = e2->center - e1->center;
 4968: 
 4969:          } else { 
 4970:             // IMPLEMENT THIS XXXXXX
 4971:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4972:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4973:             //                   alow(j)=xctr2
 4974:             //                   bdia(j)=yctr2
 4975:          } // ics
 4976: 
 4977:          diffRho = rho2 - e1->demeanedDensity(k);
 4978:       }
 4979: 
 4980:    }
 4981: 
 4982:    __global__ void computeDensityCubicSplines(void) {
 4983:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4984: 
 4985:       ELEM(elem);
 4986: 
 4987:       if (elem->isDry) return;
 4988: 
 4989:       const int kb = elem->kb;
 4990: 
 4991:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4992:       if (elem->is2D()) {
 4993:          // In the 2D case, the density is constant at the prism level. 
 4994:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4995:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4996:       } else { //3D
 4997: 
 4998:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4999:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5000:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5001:          ///// XXXX CHECK INDICES!!!!!
 5002:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5003:       } // 2D/3D
 5004: 
 5005:    }
 5006: } // extern "C"
 5007: 
 5008: 
 5009: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5010: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5011: 
 5012:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5013: 
 5014:    const int kb  = elem->kb;
 5015:    const int kb2 = elem2->kb;
 5016: 
 5017:    // z-coordinate of prism of elem
 5018:    const double zp = elem->z_prism(k);
 5019: 
 5020:    double rho = 0.0;
 5021: 
 5022:    if (elem2->is2D()) {
 5023:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5024: 
 5025:    } else {  // 3D
 5026: 
 5027:       // eta_min may be < zmax
 5028:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5029:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5030: 
 5031:       // (Extrapolate density below bottom, we will fix it later)
 5032:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5033:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5034:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5035:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5036:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5037:    } // 2D/3D
 5038:      
 5039: 
 5040:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5041:    // Now we need to fix it.
 5042:    if (elem->z[k] < elem2->z[kb2]) {
 5043:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5044: 
 5045:       // There are two methods to adjust the density at the bottom of the element.
 5046:       // iunder_deep=0: 
 5047:       const double depth1 = abs(elem->z[kb]); // larger depth
 5048: 
 5049:       if (iunder_deep==0) {
 5050: 
 5051:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5052: 
 5053:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5054: 
 5055:       } else { // iunder_deep != 0
 5056: 
 5057:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5058: 
 5059:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5060: 
 5061:          //   Demeaned density at the same z coordinate as
 5062:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5063:          }
 5064: 
 5065:       } // if iunder_deep
 5066:    } // if elem->z[kb] < elem2->z[kb]
 5067: 
 5068:    return rho;
 5069: }
 5070: 
 5071: 
 5072: extern "C" {
 5073:    __global__ void computeDensityGradient(void) {
 5074: 
 5075:       if constexpr(ibc != 0) return;
 5076: 
 5077:          // Compute the horizontal density gradient at each element.
 5078:       // It works in two steps:
 5079:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5080:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5081:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5082:       //             gradRho.r1 = rho1 - rho0
 5083:       //             gradRho.r2 = rho2 - rho0
 5084:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5085:       // 
 5086:       //  NOTE: We use de-meaned densities.
 5087: 
 5088:       ELEM(elem);
 5089: 
 5090:       if (elem->isDry) return;
 5091: 
 5092:       const int kb  = elem->kb;
 5093:       const int i34 = elem->i34;
 5094: 
 5095:       for (int k = kb + 1; k < nvrt; k++) {
 5096:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5097:          //             gradRho.r1 = rho1 - rho0
 5098:          //             gradRho.r2 = rho2 - rho0
 5099:          int icount = 0;
 5100:          double sumRx = 0.0;
 5101:          double sumRy = 0.0;
 5102:          for (int j1=0; j1<i34; j1++) { 
 5103: 
 5104:             const int j2 = elem->nxq(j1 + 1);
 5105: 
 5106:             // Pairs of consecutive neighbor elements of elem
 5107:             const Element *e1 = elem->nghbElems[j1];
 5108:             const Element *e2 = elem->nghbElems[j2];
 5109: 
 5110:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5111:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5112:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5113: 
 5114:             // Compute the density difference and the vector from elem to e1 and e2
 5115:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5116:             double diffRho1, diffRho2;
 5117:             Vector2 vec1, vec2;
 5118:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5119:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5120: 
 5121:             const double rl1 = length(vec1);
 5122:             const double rl2 = length(vec2);
 5123:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5124: 
 5125:             const double delta = cross(vec1, vec2);
 5126:             const double sintheta = abs(delta)/(rl1*rl2);
 5127: 
 5128:             // To avoid problems, avoid elements with small angle between vectors
 5129:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5130:             const bool validEq = (sintheta > sin_one_deg);
 5131: 
 5132:             if (validEq) {
 5133:                // Solve the system of equations to get the density gradient at elem
 5134:                icount++;
 5135:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5136:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5137:                sumRx += Rx;
 5138:                sumRy += Ry;
 5139:             }
 5140:          } // for j1
 5141: 
 5142:          // Compute the average density gradient at elem
 5143:          if (icount==0) {
 5144:            // Bad mesh quality; bail out with 0 b-cc
 5145:            elem->gradRho[k] = {0.0, 0.0};
 5146:          } else {
 5147:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5148:          }
 5149: 
 5150:       } // for k
 5151: 
 5152:    }
 5153: 
 5154:    __global__ void computeBaroclinicTerm(void) {
 5155:    // Computes the baroclinic term at sides (at half levels).
 5156:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5157:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5158: 
 5159:       if (ibc == 1) return;
 5160: 
 5161:       SIDE(side);
 5162: 
 5163:       if (side->isDry) return;
 5164: 
 5165:       const Element *e1 = side->elems[0];
 5166:       const Element *e2 = side->elems[1];      
 5167:       const int kb = side->kb;
 5168:       
 5169:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5170: 
 5171:       // interpolates vertically the density gradient of the two elements at the half level/
 5172: 
 5173:       int k1 = max(kb, nvrt / 2);
 5174:       int k2 = max(kb, nvrt / 2);
 5175: 
 5176:       // Starts the integration at the surface and goes down to the bottom
 5177:       side->bcc[nvrt-1] = {0.0, 0.0};
 5178:       for (int k = nvrt - 2; k >= kb; k--) {
 5179:       // For each prism level (from surface to bottom)...
 5180: 
 5181:          // For both elements, interpolate density gradient at the side's half level.
 5182:          // The gradient at the side is the average of the gradients at the elements.
 5183:          // w1, w2 are used to take into account boundary sides, with just one element.
 5184:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5185:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5186:          const double wsum = w1 + w2;
 5187:          w1 = w1/wsum;
 5188:          w2 = w2/wsum;
 5189:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5190: 
 5191:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5192:          Vector2 gradRho = {0.0, 0.0};
 5193:          if (e1 != nullptr && k > kb) {
 5194:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5195:             
 5196:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5197:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5198:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5199: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5200:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5201:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5202:          }      
 5203:          if (e2 != nullptr && k > kb) {
 5204:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5205:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5206:             
 5207:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5208:          }
 5209: 
 5210:          if constexpr(ics==2) {
 5211:             assert(false && "Not implemented: ics == 2");
 5212:             // IMPLEMENT THIS XXXXXX
 5213:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5214:             // swild(1)=tmp1
 5215:             // swild(2)=tmp2
 5216:          }
 5217:          
 5218:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5219:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5220:          // CHECK INDICES!!! XXX
 5221:          const double grav3 = side->grav3();
 5222:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5223: 
 5224:       } // for
 5225: 
 5226:    }
 5227: 
 5228: 
 5229: 
 5230:    __global__ void computeHorGradientAtSide(void) {
 5231: 
 5232:       // Compute the horizontal density gradient at each element.
 5233:       // It works in two steps:
 5234:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5235:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5236:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5237:       //             gradRho.r1 = rho1 - rho0
 5238:       //             gradRho.r2 = rho2 - rho0
 5239:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5240:       // 
 5241:       //  NOTE: We use de-meaned densities.
 5242: 
 5243:       SIDE(side);
 5244: 
 5245: // printf("side->isDry: %d\n", side->isDry);
 5246:       if (side->isDry) return;
 5247: 
 5248:       // Computes the gradient of the variables at the side center.
 5249:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5250:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5251:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5252: 
 5253:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5254:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5255:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5256:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5257: 
 5258: 
 5259:    }
 5260: 
 5261: 
 5262:    __global__ void solveMomentumEquations(double time) {
 5263: 
 5264:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5265:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5266: 
 5267:       SIDE(side);
 5268: 
 5269:       if (side->isDry) 
 5270:       {
 5271:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5272: 
 5273:          return;
 5274:       }
 5275: 
 5276:       const Node *n1 = side->n1;
 5277:       const Node *n2 = side->n2;
 5278: 
 5279:       const int kb = side->kb;
 5280: 
 5281:       const double veg_h = side->veg_h();
 5282:       const double grav3 = side->grav3();
 5283: 
 5284:       if (side->is2D()) {
 5285:          // Warning: Do not use htot2, which is updated.
 5286:          const double htot = side->htot1();
 5287:          const double hhat = side->hhat;
 5288: 
 5289:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5290: 
 5291:          Vector2 tau2 = {0.0, 0.0};
 5292:           
 5293:          if constexpr(ics==1) {
 5294:             tau2 = side->tau();
 5295: 
 5296:          } else {
 5297:             assert(false && "Not implemented: ics == 2");
 5298:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5299:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5300:             // taux2=(vn1+tt1)*0.5d0
 5301:             // tauy2=(vn2+ss1)*0.5d0
 5302:          } // if ics         
 5303: 
 5304:          // hat_gam has units of m/s
 5305: 
 5306:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5307: 
 5308:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5309:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5310: 
 5311:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5312: 
 5313: 
 5314:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5315:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5316: 
 5317:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5318: 
 5319:       }
 5320:       else { // 3D
 5321: 
 5322:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5323:          // 
 5324:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5325:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5326:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5327:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5328:          // k+1 and k.
 5329: 
 5330: 
 5331:          const int ndim = nvrt - kb;
 5332:          const double zTopCanopy = side->zTopCanopy();
 5333: 
 5334:          // Initialize the tridiagonal system
 5335:          for (int k = kb + 1; k < nvrt; k++) {
 5336:             
 5337:             const int kin = k - (kb + 1);
 5338: 
 5339:             // Vertical viscosity at the face center
 5340:             const double dfz =  0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5341:  
 5342:             alow[kin] = 0.0;
 5343:             cupp[kin] = 0.0;
 5344:             bdia[kin] = 0.0;
 5345: 
 5346:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5347:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5348: 
 5349:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5350:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5351:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5352: 
 5353:             // First part: layers k, k+1
 5354:             if (k < nvrt - 1) {
 5355:                              
 5356:                if constexpr(iveg != 0) {
 5357: 
 5358:                   // If there is vegetation at this level...
 5359:                   if (zTopCanopy > side->zc[k]) {
 5360:                      // If the canopy is above the k layer...
 5361:                      
 5362:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5363:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5364:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5365:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5366: 
 5367:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5368:                      const double vmag2 = length(ut2);
 5369:                      const double vmag1 = length(side->u2[k]);
 5370:                      const double vmag = 0.5*(vmag1 + vmag2);
 5371:                      
 5372:                      // Computes the vegetation alpha at the face center
 5373:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5374: 
 5375:                      cff1 += veg_alpha_sd*dt*vmag;
 5376: 
 5377:                   } // if (zTopCanopy
 5378:                } // if iveg
 5379: 
 5380:                const double dzz = side->Dz(k + 1);
 5381:                const double tmp = dt*dfz/dzz;
 5382:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5383: 
 5384:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5385:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5386:             }
 5387: 
 5388: 
 5389:             // Second part: layers k-1, k
 5390:             if (k > kb + 1) {
 5391: 
 5392:                double cff1 = 1.0; //init \bar{c^k}
 5393: 
 5394:                if constexpr(iveg != 0) {
 5395:                   // If there is vegetation at this level...
 5396:                   if (zTopCanopy > side->zc[k-1]) {
 5397:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5398:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5399: 
 5400:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5401: 
 5402:                      const double vmag2 = length(ut2);
 5403:                      const double vmag1 = length(side->u2[k-1]);
 5404:                      const double vmag = 0.5*(vmag1 + vmag2);
 5405: 
 5406:                      // Computes the vegetation alpha at the face center
 5407:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5408:                      cff1 += veg_alpha_sd*dt*vmag;
 5409:                   } // if zTopCanopy
 5410: 
 5411:                } // if iveg
 5412: 
 5413:                const double dzz = side->Dz(k);
 5414:                const double tmp = dt*dfz/dzz;
 5415:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5416: 
 5417:                alow[kin] += cff1*dzz/6.0 - tmp;
 5418:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5419: 
 5420:             } else { // Bottom boundary
 5421:                // This occurs at the bottom, where the bottom drag is applied.
 5422: 
 5423:                bdia[kin] += dt*side->chi2; // XXXX
 5424: 
 5425:             } // if (k > kb + 1)
 5426: 
 5427: 
 5428:          } // for (int k
 5429: 
 5430: 
 5431: 
 5432:          // Computes the RHS.
 5433:          // -----------------
 5434: 
 5435:          //	BC to be imposed at the end.
 5436: 
 5437:          const Vector2 gradETP  = side->gradETP;
 5438:          const Vector2 gradPr   = side->gradPr;
 5439:          const Vector2 gradEta1 = side->gradEta1;
 5440:          const Vector2 gradEta2 = side->gradEta2;
 5441: 
 5442:          const Vector2 *btu = side->btu;
 5443:          const Vector2 *u2  = side->u2;
 5444:          const double coriolis = side->coriolis;
 5445:          const Vector2 *nuGradU = side->nuGradU;
 5446: 
 5447: 
 5448:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5449: 
 5450:          for (int k = kb + 1; k < nvrt; k++) {
 5451:             const int kin = k - kb - 1;
 5452: 
 5453:             const double dz_0 = side->Dz(k);
 5454:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5455: 
 5456:             rrhs[kin] = {0.0, 0.0};
 5457:             double dz = 0.0;
 5458: 
 5459:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5460:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5461:             if (k < nvrt  ) dz += dz_1;
 5462:             if (k > kb + 1) dz += dz_0;
 5463: 
 5464:             // Elevation gradient, atmospheric pressure and tidal potential
 5465:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5466: 
 5467:             // Coriolis, advection, wind stress, and horizontal viscosity
 5468:             if (k < nvrt - 1) {
 5469: 
 5470: 
 5471:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5472:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5473:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5474:                                                 
 5475: 
 5476:                //diff stress tensors 1006
 5477:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5478:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5479:                   assert(false && "Not implemented: itur == 5");
 5480:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5481:                }
 5482:                // else assert(false && "itur # Not implemented");
 5483: 
 5484:             } else { // k == nvrt - 1 SURFACE
 5485:                Vector2 tau2 = {0.0, 0.0};
 5486:                if constexpr(ics==1) {
 5487:                   tau2 = side->tau();
 5488:       
 5489:                } else {
 5490:                   assert(false && "Not implemented: ics == 2");
 5491:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5492:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5493:                   // taux2=(vn1+tt1)*0.5d0
 5494:                   // tauy2=(vn2+ss1)*0.5d0
 5495:                } // if ics
 5496: 
 5497:                rrhs[kin] += dt*tau2;
 5498: 
 5499:             } // if k<nvrt
 5500: 
 5501:             if (k > kb + 1) {
 5502:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5503:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5504:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5505: 
 5506:                // diff stress tensors 1006
 5507:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5508:                   assert(false && "Not implemented: itur == 5");
 5509:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5510:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5511:                }
 5512:                // else assert(false && "itur # Not implemented");
 5513: 
 5514: 
 5515:             } // if k>kbs + 1
 5516: 
 5517:             // Baroclinic
 5518:             Vector2 *bcc = side->bcc;
 5519:             if constexpr(ibc == 0) {
 5520:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5521:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5522: 
 5523:             } // if ibc==0
 5524: 
 5525:          } // k=kb + 1,nvrt
 5526: 
 5527: 
 5528:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5529: 
 5530:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5531:             const int kin = k - kb - 1;
 5532:    
 5533:             // Velocity is always clamped to maximum values
 5534:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5535:          } // k
 5536: 
 5537:       } // if side->is2D()
 5538:       
 5539: 
 5540:       // Impose velocity boundary condition at the bottom
 5541:       if constexpr(imm == 2) { // 3D bed deformation model
 5542:          double dep;
 5543:          Vector2 vel;
 5544: 
 5545:          assert(false && "Not implemented: imm == 2");
 5546:          //update_bdef(time, x0, y0, dep, vel);
 5547:          // side->u2[kb] = vel;
 5548: 
 5549:       } else { // imm = 0 or 1
 5550:          if (side->Cd() == 0.0) {
 5551:             side->u2[kb] = side->u2[kb + 1];
 5552: 
 5553:          } else if (side->is3D()) { // 3D no slip bottom   
 5554:             side->u2[kb] = {0.0, 0.0};
 5555:          }
 5556:           
 5557:       } // if imm
 5558: 
 5559:       // The velocities below the bottom level are set to zero
 5560:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5561: 
 5562: 
 5563:    }
 5564: 
 5565: 
 5566:    __global__ void applyMomentumBC(void) {
 5567: 
 5568:       SIDE_BND(sideBnd);
 5569: 
 5570:       Side *side = sideBnd->side;
 5571:       const BoundarySegment *segment = sideBnd->segment;
 5572:       const Node *n1 = side->n1;
 5573:       const Node *n2 = side->n2;
 5574: 
 5575:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5576: 
 5577:       const bool isLand = segment->isLand;
 5578:       const int ifltype = segment->ifltype;
 5579: 
 5580:       const int kb = side->kb;
 5581: 
 5582:       if (!isLand && ifltype != 0) {
 5583:          const Vector2 *ubc = sideBnd->ubc;
 5584:   
 5585:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5586:             
 5587:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5588:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5589: 
 5590:             if (ifltype == -1) {
 5591:                // Flather 1
 5592: 
 5593:                const double depth = side->depth();
 5594: 
 5595:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5596: 
 5597:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5598: 
 5599:                side->u2[k] = vnorm*side->n;
 5600: 
 5601:             } else if (ifltype == -2) { // Discharge
 5602: 
 5603:                const double eta1 = side->eta1();
 5604:                const double eta2 = side->eta2();
 5605:                const double htot = side->htot2();
 5606: 
 5607:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5608:                assert(false && "Not implemented: Discharge bc");
 5609:                // const double dischrg = discharge(eta1);
 5610:                const double dischrg = 0.0; // XXX REMOVE
 5611:                
 5612: 
 5613:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5614: 
 5615:                const double vnorm = dischrg*eta2/htot;
 5616: 
 5617:                side->u2[k] = vnorm*side->n;
 5618: 
 5619:             }
 5620:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5621:                const double vnorm = dot(side->u2[k], side->n);
 5622: 
 5623:                double rat;
 5624:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5625:                else              rat = segment->vobc2; // outgoing
 5626: 
 5627:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5628: 
 5629:             }
 5630:             else { // not Flather or 3D radiation
 5631: printf("ifltype = %d\n", ifltype);
 5632:                side->u2[k] = ubc[k];
 5633: 
 5634:             } // if (segment->ifltype...
 5635: 
 5636:          }
 5637: 
 5638:       }
 5639:       else if (isLand) { // if it is land boundary side
 5640: 
 5641:          if constexpr(islip == 0) { // free slip
 5642: 
 5643:             for (int k = kb; k < nvrt; k++) {
 5644: 
 5645:                const Vector2 t = side->t();
 5646:                const Vector2 n = side->n;
 5647: 
 5648:                double vnorm = 0.0; // for most cases
 5649:                const double vtan = dot(side->u2[k], t);
 5650:                
 5651:                side->u2[k] = vtan*t - vnorm*n;
 5652: 
 5653:             }
 5654: 
 5655:          } else { // no slip
 5656:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5657: 
 5658:          }
 5659:       } // if (side segment type...
 5660: 
 5661:    
 5662: 
 5663:    }
 5664: 
 5665: 
 5666:    __global__ void shapiroFilter1(void) {
 5667:       // First step of the Shapiro filter (normally used if indvel<=0)
 5668:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5669: 
 5670:       SIDE(side);
 5671: 
 5672:       // Only internal wet sides are processed
 5673:       if (side->isDry || !(side->isInternal())) return;
 5674: 
 5675:       const int kb = side->kb;
 5676: 
 5677:       for (int mm = 0; mm < niter_shap; mm++) {
 5678: 
 5679:          for (int k = kb + 1; k < nvrt; k++) {
 5680:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5681:             Vector2 suru = {0.0, 0.0};
 5682: 
 5683:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5684: 
 5685:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5686: 
 5687:                int kin = k;
 5688:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5689:                
 5690:                if constexpr(ics==1) {
 5691:                   suru += nSide->u2[kin];
 5692: 
 5693:                } else {
 5694:                   assert(false && "Not implemented: ics == 2");
 5695:                   // Vector2 vn1, vn2;
 5696:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5697:                   // suru=suru+vn1;
 5698:                   // surv=surv+vn2;
 5699:                }
 5700:             }
 5701: 
 5702:             // Reusing bcc as a temporary array to store the suru values.
 5703:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5704: 
 5705:          }
 5706:       }
 5707:    }
 5708: 
 5709:    __global__ void shapiroFilter2(void) {
 5710:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5711: 
 5712:       SIDE(side);
 5713: 
 5714:       if (side->isDry || !(side->isInternal())) return;
 5715: 
 5716:       const int kb = side->kb;
 5717: 
 5718:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5719: 
 5720:       if (side->is2D()) {
 5721:          side->u2[kb + 1] = side->bcc[kb + 1];
 5722:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5723: 
 5724:       } else {
 5725:          // 3D
 5726:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5727:          
 5728:       }
 5729: 
 5730:    }
 5731: 
 5732: 
 5733:    __global__ void ul0UpdateZCoords(void) {
 5734:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5735:       
 5736:       NODE(node);      
 5737: 
 5738: 
 5739:       if (node->isDry2()) { 
 5740: 
 5741:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5742: 
 5743:          if constexpr(ivcor != 1) node->kb = 0;
 5744: 
 5745:       } else {
 5746: 
 5747:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5748:          node->updateKb();
 5749: 
 5750:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5751: 
 5752:       }
 5753: 
 5754:       // We use the temp.b field to store the previous state of isDry.
 5755:       node->tmp.b = node->isDry;
 5756: 
 5757:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5758:       node->isDry = true;
 5759: 
 5760:    }
 5761: 
 5762:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5763:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5764:    {
 5765:       ELEM(elem);
 5766: 
 5767:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5768: 
 5769:       Node *n1 = elem->nodes[0];
 5770:       Node *n2 = elem->nodes[1];
 5771:       Node *n3 = elem->nodes[2];  
 5772:       Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5773: 
 5774:       // All the nodes of a dry element are wet.
 5775:       if (!elem->isDry) {
 5776:          n1->isDry = false;
 5777:          n2->isDry = false;
 5778:          n3->isDry = false;
 5779:          if (elem->isQuad()) n4->isDry = false;
 5780: 
 5781: 
 5782:       }
 5783: 
 5784:       elem->kb = 0;
 5785: 
 5786:       if (elem->isDry) return;
 5787: 
 5788: 
 5789: 
 5790:    //    if(elem->isDry2()) { // XXXX
 5791:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5792:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5793:    //        call parallel_abort(errmsg)
 5794:    //    }
 5795: 
 5796: 
 5797:       // Computes element's kb as the minimum of the nodes' kb.
 5798:       const int kb1 = n1->kb;
 5799:       const int kb2 = n2->kb;
 5800:       const int kb3 = n3->kb;
 5801:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5802: 
 5803: 
 5804:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5805: 
 5806: 
 5807:       // Computes the element z as the mean of the nodes z.
 5808:       for (int k = elem->kb; k < nvrt; k++) {
 5809: 
 5810:          // Compute the element z as the mean of the nodes z.
 5811:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5812:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5813:          elem->z[k] /= elem->i34;
 5814: 
 5815:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5816:       }
 5817:                   
 5818:    }
 5819: 
 5820:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5821:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5822:    // node->tmp.b is true if the node was previously dry.
 5823:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5824:    {
 5825:       NODE(node);
 5826:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5827: 
 5828:       // Avoid this the first time step.
 5829:       if (it == iths) return;  
 5830: 
 5831:       
 5832:       // assert(node->isDry == node->isDry2() && "These two must be identical at this point"); XXXXX 
 5833:       if ((!node->isDry) && node->tmp.b) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5834: 
 5835:          for (int k=0; k < nvrt; k++) {
 5836: 
 5837:             Vector3 utmp={0.0, 0.0, 0.0};
 5838: 
 5839:             double ttmp=0.0;
 5840:             double stmp=0.0;
 5841:             int icount=0;
 5842:             for (int j = 0; j < node->numNodes; j++) {
 5843: 
 5844:                const Node *nbrNode = node->nodes[j];
 5845: 
 5846:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5847:                if (!nbrNode->tmp.b) { // Previously wet surrounding nodes
 5848: 
 5849:                   icount++;
 5850: 
 5851:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5852:                   utmp += nbrNode->uvw2(k);
 5853:                   
 5854:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5855:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5856:                }
 5857:             }
 5858: 
 5859:             if (icount > 0) {
 5860:                const double inv_icount = 1.0/icount;
 5861:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5862:                node->w2[k]     = inv_icount*utmp.z;
 5863:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5864:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5865:             }
 5866:             else {
 5867:                node->u2[k] = {0.0, 0.0};
 5868:                node->w2[k] = 0.0;
 5869:             }
 5870:          }
 5871:       }
 5872:    }
 5873: 
 5874:   
 5875:    
 5876: 
 5877: 
 5878:    __global__ void ul0UpdateSides(int it, int iths) {
 5879:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5880: 
 5881:       SIDE(side);
 5882: 
 5883:       // A side is wet if and only if at least one of its elements is wet.
 5884:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5885:  
 5886:       const Node *n1 = side->n1;
 5887:       const Node *n2 = side->n2;
 5888:      
 5889:       const int kb1 = n1->kb;
 5890:       const int kb2 = n2->kb;
 5891: 
 5892:       side->kb = 0; // dry
 5893: 
 5894:       if (isWet) {
 5895: 
 5896:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5897: 
 5898:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5899: 
 5900:          side->kb = min(kb1, kb2);
 5901: 
 5902:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5903: 
 5904:          for (int k = side->kb; k < nvrt; k++) {
 5905:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5906: 
 5907:          
 5908:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5909: 
 5910:             // Compute velocity for re-wetted sides 
 5911:             if ((it != iths) && (side->isDry && isWet)) {
 5912: 
 5913:                Vector2 utmp={0.0, 0.0};
 5914: 
 5915:                int icount=0;
 5916: 
 5917:                // For all the sides on the two elements that share this side
 5918:                for (int j = 0; j < 2; j++) {
 5919:                   const Element *elem = side->elems[j];
 5920:                   if (elem == nullptr) continue;
 5921: 
 5922:                   for (int jj=0; jj < elem->i34; jj++) {
 5923:                      const Side *nSide = elem->sides[jj];
 5924:                      if (nSide->isDry) continue;
 5925: 
 5926:                      icount++;
 5927:                      utmp += nSide->u2[k];  
 5928:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5929:                   }
 5930:                }
 5931:                   
 5932:                // assert(icount > 0 && "No wet sides around this side");  XXXXX RECOVER??? 
 5933:                if (icount > 0)  side->u2[k] = utmp/icount;
 5934:                else             side->u2[k] = {0.0, 0.0};
 5935:                   
 5936:             } // if ((it != iths) && (side->isDry && isWet))
 5937: 
 5938:          } // for k
 5939: 
 5940:       } // if isWet
 5941:    
 5942: 
 5943: 
 5944:    }
 5945: 
 5946:    __global__ void ul0UpdateSides2(void) {
 5947:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5948:    
 5949:          SIDE(side);
 5950:    
 5951:          // A side is wet if and only if at least one of its elements is wet.
 5952:          const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5953: 
 5954:          // Update the side's dryness
 5955:          side->isDry = !isWet;
 5956: 
 5957:    }
 5958: 
 5959: 
 5960:    __global__ void zeroNodalVelocities(void) {
 5961:       NODE(node);
 5962: 
 5963:       for (int k = 0; k < nvrt; k++) {
 5964:          node->u2[k]   = {0.0, 0.0};
 5965:          node->w2[k]   = 0.0;
 5966:          node->utmp[k] = {0.0, 0.0};
 5967:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5968:       }
 5969:    }
 5970: 
 5971:  
 5972: 
 5973:    __global__ void computeNodalVerticalVelocities1(void) {
 5974:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5975:    // Adds the element's vertical velocity times the element's area.
 5976:       ELEM(elem);
 5977: 
 5978:       for (int j = 0; j < elem->i34; j++) {
 5979:          Node *node = elem->nodes[j];
 5980: 
 5981:          for (int k = node->kb; k < nvrt; k++) {
 5982:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5983:          }
 5984:          atomicAdd(&(node->tmp.d), elem->area);
 5985:       }
 5986:    }
 5987: 
 5988:    __global__ void computeNodalVerticalVelocities2(void) {
 5989:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5990:    // Divides by the total area of the elements sharing the    node.
 5991:       NODE(node);
 5992: 
 5993:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5994: 
 5995:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 5996:    }
 5997: 
 5998: 
 5999:    __global__ void computeNodalHorizontalVelocities1(void) {
 6000:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6001:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6002: 
 6003:       ELEM(elem);
 6004: 
 6005:       if (elem->isDry) return;
 6006: 
 6007:       const int kb = elem->kb;
 6008:       const bool isTri = elem->isTri();
 6009: 
 6010:       if constexpr(indvel <= 0) {
 6011:          // Assuming discontinous hvel.
 6012: 
 6013:          if (isTri) { // For triangles
 6014:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6015:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6016: 
 6017:             for (int j = 0; j < 3; j++) {
 6018:                // For every node of the triangle...
 6019:                Node *node = elem->nodes[j];
 6020: 
 6021:                if (node->isDry) continue;
 6022: 
 6023:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6024:                const Side *s2 = elem->sides[(j + 1) % 3];
 6025:                const Side *s3 = elem->sides[(j + 2) % 3];
 6026: 
 6027: 
 6028:                atomicAdd(&(node->tmp.i), 1);
 6029: 
 6030:                for (int k = kb; k < nvrt; k++)  {
 6031:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at node j.   XXXX Function for clamping velocities. const vector2 u
 6032:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6033:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6034:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6035:                   atomicAdd(&(node->utmp[k].x), u.x);
 6036:                   atomicAdd(&(node->utmp[k].y), u.y);
 6037: 
 6038:                }
 6039: 
 6040:             }
 6041:          }
 6042:          else { // For quads
 6043:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6044: 
 6045:          }
 6046: 
 6047:       }
 6048:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6049:       
 6050:    }
 6051: 
 6052: 
 6053:    __global__ void computeNodalHorizontalVelocities2(void) {
 6054:       NODE(node);
 6055: 
 6056:       const int nodeCount = node->tmp.i;
 6057: 
 6058:       if (nodeCount == 0) 
 6059:       {
 6060:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6061:          return;
 6062:       }
 6063: 
 6064:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6065:       
 6066:       const int kb = node->kb;
 6067: 
 6068:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6069:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6070:       
 6071:       
 6072:    }   
 6073: 
 6074:  
 6075: 
 6076:    __global__ void resetVelocityOpenBndNodes(void) {
 6077:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6078: 
 6079:       NODE_BND(nodebnd);
 6080: 
 6081:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6082:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6083:       }
 6084: 
 6085:    }
 6086: 
 6087: 
 6088:    __global__ void setVelocityOpenBndNodes(void) {
 6089:    // For open boundary nodes sets their velocity to the imposed values.
 6090: 
 6091:       SIDE_BND(sidebnd);
 6092: 
 6093:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6094:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6095:          // to its segment to the average of the side velocity.
 6096: 
 6097:          for (int k = 0; k < nvrt; k++) {
 6098:             Node *n1 = sidebnd->side->n1;
 6099:             Node *n2 = sidebnd->side->n2;
 6100: 
 6101: 
 6102:             Vector2 n1_u2(n1->u2[k]);
 6103:             Vector2 n2_u2(n2->u2[k]);
 6104: 
 6105:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6106:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6107:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6108:             }
 6109:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6110:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6111:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6112:             }
 6113: 
 6114:          }
 6115: 
 6116:       }
 6117: 
 6118:    }
 6119: 
 6120: 
 6121:    __global__ void computeVerticalVelocity(void) {
 6122:       // Computes the vertical velocity at the (2D) element's centroid.
 6123:       // In this function we will be considering volumetric elements, with side faces and a 
 6124:       // bottom and a top face. We will call them SFs, BF and TF.
 6125:       // It computes the flux coming from BF and the SFs.
 6126:       // If the bed is moving, it takes that into account.
 6127:       // Since water is incompressible, the integral of the velocity times the normal vector
 6128:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6129:       // and the BF is equal to the flux going out from the TF.
 6130:       // TF = - BF - sum(SFs).
 6131:       // It then computes the horizontal velocity at the center of TF.
 6132:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6133:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6134:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6135: 
 6136:       ELEM(elem);
 6137: 
 6138:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6139: 
 6140:       if (elem->isDry) return;
 6141: 
 6142:       const int kb = elem->kb;
 6143:       const bool isTri = elem->isTri();
 6144: 
 6145:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6146: 
 6147:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6148:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6149:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6150: 
 6151:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6152: 
 6153:       double area3D;
 6154: 
 6155:       // Bottom face flux
 6156:       double bottomFlux = 0.0;
 6157:       Vector2 u2meanBottom = {0.0, 0.0};
 6158:       const Vector2 gradh = elem->grad2(&Node::depth);
 6159:       if constexpr(imm==2) {
 6160:          Vector3 ubed;
 6161: 
 6162:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6163:          // updateBDEF(ubed);
 6164:      
 6165:          // const double bflux0 = dot(ubed, elem_n1);
 6166: 
 6167:          // elem->w[kb] += ubed.z;
 6168:       }
 6169:       else {
 6170:          Vector2 umean;
 6171:          if constexpr(ics == 1) {
 6172:             u2meanBottom = elem->mean(kb, &Side::u2);
 6173:          }
 6174:          else {
 6175:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6176:          }
 6177: 
 6178:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6179:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6180: 
 6181:          bottomFlux = - dot(gradh, u2meanBottom);
 6182:       } // if imm
 6183: 
 6184:       // Compute w for kb+1 to nvrt-1
 6185:       for (int l = kb; l < nvrt - 1; l++) {
 6186: 
 6187:          // normal vector to the top face of the "volumetric" element (3D)
 6188:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6189: 
 6190:          // Compute the total flux at the sides
 6191:          double sideFlux = 0.0;
 6192: 
 6193:          for (int j = 0; j < elem->i34; j++) {
 6194:             const Side *side = elem->sides[j];
 6195: 
 6196:             const double sideArea = side->area(l);
 6197:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6198:             const double sign = elem->ssign[j]; 
 6199: 
 6200:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6201:          }
 6202:          
 6203:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6204:          //velocities at the centers of the sides
 6205:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6206: 
 6207:          // The flx at the top ace can be computed from the other flows.
 6208:          const double topFlux = - sideFlux - bottomFlux;
 6209:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6210: 
 6211:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6212: 
 6213:          elem_n1 = elem_n2;
 6214: 
 6215:          bottomFlux = - topFlux;
 6216:       }
 6217:    }  
 6218: 
 6219: 
 6220: 
 6221: 
 6222: 
