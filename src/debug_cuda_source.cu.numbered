 8562:    *sizeNode = sizeof(Node);
 8563: 
 8564:    switch (varCode) {
 8565:       case (int)VarCode::depth:
 8566:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8567:          *sizeType = sizeof(double);
 8568:          break;
 8569:       case (int)VarCode::eta:
 8570:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8571:          *sizeType = sizeof(double);
 8572:          break;
 8573:       case (int)VarCode::x:
 8574:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8575:          *sizeType = sizeof(Vector2);
 8576:          break;
 8577:       case (int)VarCode::z:
 8578:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8579:          *sizeType = sizeof(double);
 8580:          break;
 8581:       case (int)VarCode::kb:
 8582:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8583:          *sizeType = sizeof(int);
 8584:          break;
 8585:       case (int)VarCode::isdry:
 8586:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8587:          *sizeType = sizeof(int);
 8588:          break;         
 8589:       case (int)VarCode::w:
 8590:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8591:          *sizeType = sizeof(double);
 8592:          break;
 8593:       case (int)VarCode::u:
 8594:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8595:          *sizeType = sizeof(Vector2);
 8596:          break;  
 8597:       case (int)VarCode::u_air:
 8598:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8599:          *sizeType = sizeof(Vector2);
 8600:          break;
 8601:       default:
 8602:          *offset = -1;    
 8603:    }  
 8604:    
 8605: }
