 8105: __global__ void getStructSizes(int* sizes)  {
 8106:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8107:       sizes[0] = (int)sizeof(Node);
 8108:       sizes[1] = (int)sizeof(Element);
 8109:       sizes[2] = (int)sizeof(Side);
 8110:       sizes[3] = (int)sizeof(NodeBoundary);
 8111:       sizes[4] = (int)sizeof(SideBoundary);
 8112:       sizes[5] = (int)sizeof(BoundarySegment);
 8113: }
