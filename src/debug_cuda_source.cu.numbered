 5104: extern "C" {
 5105: 
 5106:    __global__ void scaleGravity(double loadtide_coef) {
 5107: 
 5108: 
 5109:       NODE(node);
 5110: 
 5111:       // SAL option: scale gravity
 5112:       if constexpr(iloadtide==2) {  // simple const
 5113:          node->grav2 = grav*(1.0 - loadtide_coef);
 5114: 
 5115:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5116:         
 5117:           const double depth = max(node->depth, 0.0);
 5118:           const double tmp1 = sqrt(depth);
 5119:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5120:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5121:                              2.6969e-13*depth*depth*depth*tmp1;
 5122:           
 5123:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5124:           
 5125: 
 5126: 
 5127:           node->grav2 = grav*(1.0 - beta_bar);
 5128: 
 5129:       } else {  // iloadtide=0,1
 5130:           node->grav2 = grav;
 5131: 
 5132:       }
 5133: 
 5134:    }
