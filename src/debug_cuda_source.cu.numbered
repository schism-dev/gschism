 2638: 
 2639: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2640: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2641: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2642: // Only when ics == 2, the origin is at the element center.
 2643: 
 2644:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2645: 
 2646:    const Node *node = nodes[idxNode];
 2647: 
 2648:    if constexpr(ics==1) {
 2649:       return node->p;
 2650: 
 2651:    } else {
 2652:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2653: 
 2654:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2655: 
 2656:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2657:    }
 2658: 
 2659: }
 2660: 
 2661: 
 2662: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2663:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2664: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2665: 
 2666:    const int id1 = idx;
 2667:    const int id2 = nxq(1 + id1);
 2668:    const int id3 = nxq(2 + id1);
 2669: 
 2670:    if constexpr(ics==1) {
 2671:       x0 = nodes[id1]->p;
 2672:       x1 = nodes[id2]->p;
 2673:       x2 = nodes[id3]->p;
 2674: 
 2675:    } else {
 2676: 
 2677:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2678:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2679:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2680: 
 2681:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2682:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2683:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2684: 
 2685:    }
 2686: 
 2687: }
 2688: 
 2689: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2690:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2691: }
 2692: 
 2693: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2694:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2695:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2696: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2697: 
 2698:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2699: 
 2700: 
 2701: 
 2702:    if constexpr(ics==1) {
 2703:       x0 = nodes[0]->p;
 2704:       x1 = nodes[1]->p;
 2705:       x2 = nodes[2]->p;  
 2706:       x3 = nodes[3]->p;
 2707: 
 2708:    } else {
 2709: 
 2710:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2711:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2712:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2713:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2714: 
 2715:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2716:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2717:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2718:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2719:    }
 2720: 
 2721: }
 2722: 
 2723: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2724:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2725: {
 2726:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2727: }
