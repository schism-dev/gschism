 8518:          break;
 8519:       case (int)VarCode::gradETP:
 8520:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8521:          *sizeType = sizeof(Vector2);
 8522:          break;
 8523:       case (int)VarCode::area:
 8524:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8525:          *sizeType = sizeof(double);
 8526:          break;
 8527:       case (int)VarCode::depth:
 8528:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8529:          *sizeType = sizeof(double);
 8530:          break;
 8531:       case (int)VarCode::radius:
 8532:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8533:          *sizeType = sizeof(double);
 8534:          break;
 8535:       case (int)VarCode::ghat:
 8536:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8537:          *sizeType = sizeof(Vector2);
 8538:          break;
 8539:       case (int)VarCode::kb:
 8540:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8541:          *sizeType = sizeof(int);
 8542:          break;
 8543:       case (int)VarCode::isdry:
 8544:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8545:          *sizeType = sizeof(int);
 8546:          break;            
 8547:       case (int)VarCode::w:
 8548:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8549:          *sizeType = sizeof(double);
 8550:          break;
 8551:       case (int)VarCode::FaceIndices:
 8552:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8553:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8554:          *sizeType = sizeof(Node);
 8555:          break;
 8556:       default:
