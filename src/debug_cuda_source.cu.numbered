 3394: 
 3395: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3396: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3397: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3398: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3399: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3400: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3401: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3402: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3403: // Computes the gradient of the field at the side center.
 3404:    Vector2 grad = {0.0, 0.0};
 3405:    int count = 0;
 3406: 
 3407:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3408:    // as the average of the gradients at each element.
 3409:    // First element
 3410:    if (elems[0] != nullptr && condition(elems[0])) {
 3411:       Vector2 elemGrad = elems[0]->grad2(field);
 3412: 
 3413:       // For ics=2, projects the element gradient from its frame to the side frame
 3414:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3415: 
 3416:       grad += elemGrad;
 3417: 
 3418:       count++;
 3419:    }
 3420: 
 3421:    // Second element
 3422:    if (elems[1] != nullptr && condition(elems[1])) {
 3423: 
 3424:       Vector2 elemGrad = elems[1]->grad2(field);
 3425: 
 3426:       // For ics=2, projects the element gradient from its frame to the side frame
 3427:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3428: 
 3429:       grad += elemGrad;
 3430: 
 3431:       count++;
 3432:    }
 3433: 
 3434:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3435:    if (count > 0) {
 3436:       grad = grad*(1.0/count);
 3437:    }
 3438:    
 3439:    return grad;
 3440: }
