 2249:    template<typename T>
 2250:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2251: 
 2252:       T values[4];
 2253: 
 2254: 
 2255:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2256:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2257:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2258:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2259:       else          values[3] = T();
