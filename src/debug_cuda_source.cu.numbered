 4362: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4363:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4364:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4365:                 int *isdel, int *isidenode, int *isbnd,
 4366:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4367:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4368:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4369:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4370:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4371:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4372:                 double *drag, double *roughness,
 4373:                 double *emo, double *efa, 
 4374:                 double *umo, double *ufa, 
 4375:                 double *vmo, double *vfa) {
 4376: 
 4377:    printf("Populating mesh for partition %d\n", partNum);
 4378: 
 4379:    // XXXXXX THIS function does almost nothing. 
 4380: 
 4381:    nbs = *sharedIdxSideBoundary + 1;
 4382:    nbp = *sharedIdxNodeBoundary + 1;
 4383: 
 4384:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4385: 
 4386: }
