 7659: __global__ void printMatrix(bool full) {
 7660:    // Debugging: print the matrix
 7661: 
 7662:    const int size = mesh->np;
 7663:    double sum = 0.0;
 7664:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7665:       const Node *node = mesh->localNodeData + idx_node;
 7666:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7667:       for (int j = 0; j < node->numNodes; j++) {
 7668:          Node* nbNode = node->nodes[j];
 7669:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7670:          sum += node->coeffMatrix[j];
 7671:       }
 7672:       if (full) printf("]\n");
 7673: 
 7674: 
 7675:    }
 7676:    if (!full) printf("sum=%lf\n", sum);
 7677: }
