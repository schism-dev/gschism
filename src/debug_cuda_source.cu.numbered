 9086: 
 9087: __global__ void returnMatrix(double *res) {
 9088:    // Debugging: dense local matrix, row-major, size = mesh->np
 9089:    // Assumes single-partition / local indexing (see note below).
 9090: 
 9091:    const int size = mesh->np;
 9092: 
 9093:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9094:       const Node *node = mesh->localNodeData + idx_node;
 9095: 
 9096:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9097: 
 9098:       for (int j = 0; j < node->numNodes; j++) {
 9099:          const Node *nbNode = node->nodes[j];
 9100:          // Only dump neighbors that live on this partition
 9101:          if (nbNode->part != mesh->partNum) continue;
 9102: 
 9103:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9104:          const double aij = node->coeffRow[node->csrSlot[j]];
 9105:          if (aij != 0.0)
 9106:             res[jlocal * size + idx_node] = aij;
 9107:       }
 9108:    }
 9109: }
 9110: 
 9111: 
 9112: __global__ void returnX(double *res) {
 9113:    // Debugging: returns the matrix as a CuPy array
 9114: 
 9115:    const int size = mesh->np;
 9116:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9117:       const Node *node = mesh->localNodeData + idx_node;
 9118: 
 9119:       res[idx_node] = node->mX;
 9120: 
 9121:    }
 9122:    
 9123: }
