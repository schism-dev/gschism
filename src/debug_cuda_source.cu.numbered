 2531:    template<typename T>
 2532:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2533:       T values[4];
 2534:       getNodalValues(level, func, values);
 2535: 
 2536:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2537:       if constexpr (IsVector2<T>::value && ics == 2) {
 2538: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2539:          projectNodeVectorsToElementFrame(values);
 2540: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2541:       }
 2542: 
 2543:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2544:    }
 2545: 
 2546:    template<typename T>
 2547:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2548:       T values[4];
 2549:       getNodalValues(field, values);
 2550: 
 2551:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2552:       if constexpr (IsVector2<T>::value && ics == 2) {
 2553: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2554:          projectNodeVectorsToElementFrame(values);
 2555: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2556:       }
 2557:       
 2558:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2559:    }
 2560: 
 2561: 
 2562:    template<typename T>
 2563:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2564:       T values[4];
 2565:       getNodalValues(level, field, values);
 2566:       
 2567: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2568:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2569:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2570:       if constexpr (IsVector2<T>::value && ics == 2) {
 2571: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2572:          projectNodeVectorsToElementFrame(values);
 2573: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2574:       }
 2575: 
 2576:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2577:    }
