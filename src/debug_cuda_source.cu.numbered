 1564: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1565:                    Side *side = &(mesh->localSideData[idx_side]); \
 1566:                    if (idx_side >= mesh->ns) return;
 1567: 
 1568: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1569:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1570:                    if (idx_elem >= mesh->ne) return;
 1571: 
 1572: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1573:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1574:                    if (idx_node >= mesh->np) return;
 1575: 
 1576: 
 1577: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1578:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1579:                            if (idx_node_bnd >= mesh->nbp) return;
 1580: 
 1581: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1582:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1583:                            if (idx_side_bnd >= mesh->nbs) return;                           
 1584: 
 1585: Polynomial<4> *polyDischarge; // XXX read from file
