  291: // Polynomial class
  292: template<int grade>
  293: struct Polynomial {
  294:     // Static assertion to give a clear error message at compile time
  295:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  296: };
  297: 
  298: 
  299: // Explicit specialization for grade 4
  300: template<>
  301: struct Polynomial<4> {
  302:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  303: 
  304:    // Constructor from coefficients
  305:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  306: 
  307:    __device__ __forceinline__ double eval(double x) const {
  308:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  309:    }
  310: };
