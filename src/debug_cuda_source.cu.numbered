  509:    int i34;                   // Number of sides for the element 
  510:    Side *sides[4];            // Sides of the element
  511:    Node *nodes[4];            // Nodes of the element
  512:    Element *nghbElems[4];     // Neighbors of the element
  513: 
  514:    int kb;                    // Bottom index of the element
  515:    double area;               // Area of the element
  516:    double ssign[4];           // Sign associated with each side of an element. Allows to compute the outward normal vector to the side.
  517:    double radius;             // Element equivalent radii
  518: 
  519:    Frame frame;
  520: 
  521:    Vector2 gradPhi[4];        // Derivatives of shape functions
  522:    Vector2 gradEta;           // Gradient of free surface elevation
  523:    Vector2 gradPr;            // Gradient of pressure    
  524:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  525: 
  526:    bool isDry;                // True if the element is dry
  527: 
  528:    Vector2 center;         // Element center coordinates
  529:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  530:    double depth;              // Depth at element (min of all nodes)
  531:    double z[nvrt];            // z-coord  (local frame - vertical up)
  532: 
  533:    // Physical information
  534:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  535: 
  536:    static const bool isblock = false;              // Always false
  537: 
  538:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  539:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  540: 
  541:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  542:    
  543: 
  544:    double vsource;            // Volumetric source/sink term [m^3/s]
  545: 
  546:    double rho[nvrt];          // Density at each prism center
  547:    double rho_mean[nvrt];     // Mean density at each prism center
  548:    CubicSpline rho_spl;
  549:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  550:    double rho_z[nvrt];        // First derivative of density at each prism center
  551:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  552:    
  553: 
  554:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  555: 
  556:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  557:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  558: 
  559:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  560:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  561: 
  562:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }  // The 16* is to avoid negative numbers (within reason) and ensure fast product computation
  563:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  564:       // Find the local index of the node in the element (0,1,2,3)
  565:       int res = __ffs((nodes[0] == node) | 
  566:                      ((nodes[1] == node) << 1) | 
  567:                      ((nodes[2] == node) << 2) | 
  568:                      ((nodes[3] == node) << 3)) - 1;
  569:       
  570:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  571:       return res;  
  572:    }
  573: 
  574:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  575:       // Find the local index of the side in the element (0,1,2,3)
  576:       int res = __ffs((sides[0] == side) | 
  577:                      ((sides[1] == side) << 1) | 
  578:                      ((sides[2] == side) << 2) | 
  579:                      ((sides[3] == side) << 3)) - 1;
  580:       
  581:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  582:       return res;
  583:    }
  584: 
  585:    __inline__ __device__ int nodeLocalIdx(const Node *node) const {
  586:       // Find the local index of the node in the element (0,1,2,3)
  587:       int res = __ffs((nodes[0] == node) | 
  588:                      ((nodes[1] == node) << 1) | 
  589:                      ((nodes[2] == node) << 2) | 
  590:                      ((nodes[3] == node) << 3)) - 1;
  591:       
  592:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  593:       return res;
  594:    }
  595: 
  596: 
  597:    __inline__ __device__ bool containsSide(const Side *side) const {
  598:       return sides[0] == side || sides[1] == side || sides[2] == side || (isQuad() && sides[3] == side);
  599:    }
  600: 
  601:    __inline__ __device__ void getSidesContainingNode(const Node *node, int &idxSide1, int &idxSide2) const;
  602: 
  603: 
  604:    __inline__ __device__ bool containsSegment(const Node *node, const Point2 &xt) const;    
  605:     
  606:     
  607:    __inline__ __device__ int findLevel(double z1, int k) const {
  608:       // Starting at index k, find sequentially the level that contains z
  609: 
  610:       assert(false && "findLevel: Not implemented"); // XXXXXXXXX
  611:       // For testing purposes, forgets k and performs a full search.
  612:       for (k = kb; k < nvrt - 1; k++) {
  613:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  614:       }
  615:       return nvrt - 2;
  616: 
  617: 
  618:       // if z is already betweeen z[k] and z[k+1], return k
  619:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  620:       else if (z1 <  z[k]) { 
  621:          // Search for increasing levels
  622:          for (int kk = k; kk < nvrt - 1; kk++) {
  623:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  624:          }
  625:          return nvrt - 1;
  626:       }
  627:       else {
  628:          // Search for decreasing levels
  629:          for (int kk = k; kk >= kb; kk--) {
  630:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  631:          }
  632:          return 0;
  633:       }
  634:    }
  635: 
  636: 
  637: 
  638:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  639:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  640: 
  641:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  642:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  643:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  644:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  645:        const double eta = (idx & 1) ? +g : -g;
  646:        const double xi  = (idx & 2) ? +g : -g;
  647:        return {eta, xi};
  648:    }  
  649: 
  650:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  651:    __device__ __forceinline__ double etaSign(int idx) const {
  652:       // bit1: 0 -> -1, 1 -> +1
  653:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  654:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  655:    }
  656: 
  657:    __device__ __forceinline__ double xiSign(int idx) const {
  658:       // +1 if (bit0 XOR bit1), else -1
  659:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  660:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  661: 
  662:    }
  663: 
  664:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  665:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  666:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  667:    }
  668: 
  669:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  670:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  671:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  672:    }   
  673: 
  674:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  675:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  676:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  677:    }      
  678:    
  679:    __inline__ __device__ double detJ_eta(void) const;
  680: 
  681:    __inline__ __device__ double detJ_xi(void) const;
  682: 
  683:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  684: 
  685:    // Check if the element is dry using the more up-to-date elevation.
  686:    __inline__ __device__ bool isDry2(void) const;
  687: 
  688:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  689: 
  690:    __inline__ __device__ double computeSignedArea(void) const;
  691: 
  692:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  693:       // Nudges the point (x,y) to the barycenter of the element
  694: 
  695:       p = (1.0 - btrack_nudge)*p + btrack_nudge*center;
  696:    }
  697: 
  698:    __device__ void computeShapeCoords(Point2 &xt, ShapeCoords &shpCoords) const;
  699:    
  700:    __device__ void shapeCoordsToXY(ShapeCoords const &shpCoords, Vector2 &xt) const;
  701: 
  702:    __device__ double intPhiPhi(int i1, int i2) const;
  703: 
  704:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  705: 
  706:    __device__ Vector2 grad2(double *a) const
  707:    {
  708:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  709:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  710:       if (isQuad()) {
  711:          gx += a[3]*gradPhi[3].x;
  712:          gy += a[3]*gradPhi[3].y;
  713:       }
  714:       return {gx, gy};
  715:    }
  716: 
  717:    __device__ Vector2 grad2(double Node::* field) const
  718:    {
  719:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  720:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  721:       if (isQuad()) {
  722:          gx += (nodes[3]->*field)*gradPhi[3].x;
  723:          gy += (nodes[3]->*field)*gradPhi[3].y;
  724:       }
  725:       return {gx, gy};
  726:    }
  727: 
  728:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  729:    __device__ __forceinline__ Vector3 n(int k) const {
  730:       double area3D;
  731:       return n(k, area3D);
  732:     }
