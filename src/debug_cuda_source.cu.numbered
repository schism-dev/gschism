 2741: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2742: //          const double tt2 = delta2/delta;
 2743: 
 2744: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2745: //          // Similarly, we use tt2 to compute the intersection point.
 2746: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2747: //             xIntersect = x3 + (x4 - x3)*tt2;
