 2310: 
 2311: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2312: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2313: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2314: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2315:    Vector2 grad = {0.0, 0.0};
 2316:    int count = 0;
 2317: 
 2318:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2319: 
 2320:    // First element
 2321:    if (elems[0] != nullptr && condition(elems[0])) {
 2322:       grad += elems[0]->grad2(field);
 2323:       count++;
 2324:    }
 2325: 
 2326:    // Second element
 2327:    if (elems[1] != nullptr && condition(elems[1])) {
 2328:       grad += elems[1]->grad2(field);
 2329:       count++;
 2330:    }
 2331: 
 2332:    if (count > 0) {
 2333:       grad = grad/count;
 2334:    }
 2335:    
 2336:    return grad;
 2337: }
