 1981: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1982:    // Computes the *local* (element frame) 3D normal vector to the element at level k
 1983:    // Returns the normal vector and the area of the element
 1984: 
 1985:       if (isTri()) {
 1986:          // For triangles...
 1987: 
 1988:          // Indices of the nodes at level k, taking care of not going below the bed
 1989:          const int k0 = max(k, nodes[0]->kb);
 1990:          const int k1 = max(k, nodes[1]->kb);
 1991:          const int k2 = max(k, nodes[2]->kb);
 1992: 
 1993:          // Gets the element frame coordinates of the nodes at level k
 1994:          Point3 x0, x1, x2;
 1995:          if constexpr(ics==1) {
 1996:             x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 1997:             x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 1998:             x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 1999: 
 2000:          } else {  // ics == 2
 2001:             Vector2 h0, h1, h2;
 2002:             getLocalHorizontalNodePositions(h0, h1, h2);
 2003:             x0 = toPoint3(h0, nodes[0]->z[k0]);
 2004:             x1 = toPoint3(h1, nodes[1]->z[k1]);
 2005:             x2 = toPoint3(h2, nodes[2]->z[k2]);
 2006:          }
 2007:          const Vector3 n20 = x2 - x0;
 2008:          const Vector3 n10 = x1 - x0; 
 2009: 
 2010:          // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2011:          const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2012:          const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2013:          const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2014: 
 2015:          const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2016:          area3D = 0.5*len;
 2017: 
 2018:          assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 2019: 
 2020:          const double inv_len = 1.0/len;
 2021:          return {nx*inv_len, ny*inv_len, nz*inv_len};
 2022:       
 2023:       }
 2024:       else {
 2025:          // For quads...
 2026: 
 2027:          assert(false && "Element normal vector: quads not yet implemented");
 2028:          return {0.0, 0.0, 0.0};
 2029: 
 2030: 
 2031:       }
 2032:    }
 2033: 
 2034: /**
 2035:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2036:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2037:    If the segment is completely inside the element, then it returns true.
 2038: 
 2039:    This function assumes:
 2040:    - The initial point is on a side of the element. 
 2041:    - Its position is given by parameter t in the range [0,1].
 2042:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2043:       intersects the element (elements are convex).
 2044: 
 2045:    To find the intersection point, this function does the following:
 2046:    - it finds the intersection of the line segment with all the element side lines,
 2047:       except for the one that contains the initial point.
 2048:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2049:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2050:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2051:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2052:       track segment is almost parallel to the element side line.
 2053: 
 2054:    Inputs:
 2055:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2056:    @param x2, y2: other end of the line segment
 2057: 
 2058:    Outputs:
 2059:    @param side:  side that intersects the line segment (input and output)
 2060:    @param nextElement (output): element that contains the intersection point
 2061:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2062:    @param zint (input/output): Vertical coordinate of the intersection point
 2063: 
 2064:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2065:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2066:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2067: 
 2068:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2069:    (Delta) being zero.
 2070: 
 2071:    The intersection2 point happens when:
 2072:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2073:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2074:    
 2075:    Assumption: the 4 points (including those of the side segment) are different.
 2076:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2077:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2078:    If true, (xIntersect,yIntersect) is the intersection.				
 2079:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2080: **/
 2081: 
 2082: 
 2083: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2084:                                               double &t, double& tIntersect) {
 2085:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 2086:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 2087: 
 2088:    double closest_intersect_t = 1e10;
 2089:    bool found_intersection = false;
 2090: 
 2091:    for (int i = 0; i < i34; i++) {
 2092: 
 2093:       Side *side2 = sides[i];
 2094: 
 2095:       // (x3,y3)-(x4,y4) is the element side line
 2096:       const Point2 x3 = side2->n1->p;
 2097:       const Point2 x4 = side2->n2->p;
 2098: 
 2099:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2100:       const double delta = cross(x2 - x1, x3 - x4);
 2101: 
 2102:       if (abs(delta) > 0) {
 2103: 
 2104:          const double delta1 = cross(x3 - x1, x3 - x4);
 2105:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2106: 
 2107:          // Solves the two linear equations for tt1 and tt2
 2108:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2109:          const double tt2 = delta2/delta;
 2110: 
 2111:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2112:             closest_intersect_t = min(closest_intersect_t, tt1);
 2113:             side = side2;
 2114:             nextElement = side->otherElem(this);
 2115:             t =          clamp(tt2, small, 1.0-small);
 2116:             tIntersect = clamp(tt1, small, 1.0-small);
 2117:             found_intersection = true;
 2118:          }
 2119: 
 2120:       
 2121:       }
 2122:       else {  // parallel segments
 2123: 
 2124:          continue; 
 2125:          assert(false && "Parallel segments should not happen under the new code");
 2126:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 2127:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 2128: 
 2129:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2130:          const double dist = dot(x1 - x3, side2->n);
 2131:          if (abs(dist) < small*length(x3 - x4)) {
 2132:             const double2 unitarySide = normalize(x4 - x3);
 2133:             const double len = dot(x2 - x1, unitarySide);
 2134:             t = t + len;
 2135:             t = max(0.0, min(t, 1.0));
 2136:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 2137: 
 2138: 
 2139:             // tIntersect = max(small, min(tt1, 1.0-small));
 2140:             // t = tt2;
 2141:             found_intersection = true;
 2142:          }
 2143:       }
 2144: 
 2145: 
 2146:    }
 2147: 
 2148: 
 2149:    assert(found_intersection && "No intersection found");
 2150: 
 2151:    // found_intersection should always be true, since we checked all the sides.  
 2152:    return found_intersection;
 2153: }
 2154: 
 2155: 
 2156: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2157:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2158: 
 2159:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2160:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2161:    // curElement.
 2162: 
 2163:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2164:    // And uses this velocity instead to continue the tracking.
 2165: 
 2166:    // computes the intersection point in cartesian coordinates
 2167:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2168: 
 2169:    // Nudges the point to the barycenter of the element. 
 2170:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2171:    // next segment intersects the element sides. 
 2172:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2173: 
 2174: 
 2175:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2176:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2177:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2178:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2179: 
 2180:    // If the side is an open boundary, the tangential velocity is set to zero.
 2181:    if (nextSide->isBnd()) vtan = 0.0;
 2182: 
 2183:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2184:    const double us = vtan*nextSide->t().x;
 2185:    const double vs = vtan*nextSide->t().y;
 2186:    const double ws = nextSide->w2(jlev); 
 2187: 
 2188:    u_int = {us, vs, ws};
 2189: 
 2190:    // The end of this tracking segment is now the intersection point.
 2191:    xt = {intersection.x, intersection.y, zint};
 2192:    
 2193: }
 2194: 
 2195: /**
 2196:  * Tracks a particle through elements and vertical levels in the mesh.
 2197:  * 
 2198:  * @param x0,y0,z0     Starting position coordinates
 2199:  * @param xt,yt,zt     Target position coordinates
 2200:  * @param dtb          Time step for tracking
 2201:  * @param u_int        Initial velocity components
 2202:  * @param nextElem     Starting/resulting element index
 2203:  * 
 2204:  * @return Status code of type trackExitCodes
 2205:  * 
 2206:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2207:  * of the details are different. The idea is that the code requires less branches and is better fit
 2208:  * for GPU execution.
 2209:  * 
 2210:  * The main ideas here are:
 2211:  * - The starting point is expected to be in the starting element.
 2212:  * - since the starting point is inside the element, there are only two cases: 
 2213:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2214:  *     (b) it does not and (xt,yt) is already in the starting element.
 2215:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2216:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2217:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2218:  * - tt1 can be positive or negative. We only consider the positive values.
 2219:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2220:  * - The next intersection will occur at the smallest positive tt1.
 2221:  * - This intersection will be the next (x0,y0) position.
 2222:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2223:  *   of getting stuck in a loop.
 2224:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2225:  *   was found.
 2226:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2227:  */
 2228: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2229:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2230:                                                        const Side *origSide) {
 2231:                                                             
 2232:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2233:    // else to do. This means that the full step occurred within the current element.
 2234:    assert(!isDry && "Starting element is dry");
 2235:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2236: 
 2237:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2238: 
 2239:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2240:       assert(!isDry && "Target point is inside a dry element");
 2241: 
 2242:       u_int = interpolateVelocities(xt);
 2243: 
 2244:       nextElem = this;
 2245: 
 2246: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2247:       return true;
 2248:    }
 2249: 
 2250: 
 2251:    
 2252: 
 2253:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2254:    
 2255:    double t;
 2256:    Side *nextSide = nullptr;
 2257:    double tIntersect = 1e10;
 2258: 
 2259: 
 2260:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2261:    // (x0,y0) is inside the element but the target point is not.
 2262:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2263:    assert(found_intersection && "No intersection found at %d");
 2264: 
 2265:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2266: 
 2267:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2268:    if (nextElem != nullptr && !nextElem->isDry) {
 2269:       assert(nextElem->containsPoint(xtmp) && "Intersection point is not inside the next element");
 2270:       nextElem->nudgeToBarycenter(xtmp);
 2271:    }
 2272: 
 2273:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2274:    xt = {xtmp.x, xtmp.y, zint};
 2275: 
 2276:    // if the tracking segment goes out of water (either dry or edge boundary)
 2277:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2278: 
 2279: 
 2280:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2281: 
 2282:       assert(this->containsPoint(toPoint2(xt)) && "Target point is not inside the current element");
 2283:       // When this happens, the backtracking stops.
 2284:       // dt = time_rm;  LLLLLL KKKK XXXX
 2285:       dt *= tIntersect;
 2286: 
 2287:       // In this case, the next element is again the current element.
 2288:       nextElem = this;
 2289: 
 2290: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2291: 
 2292:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2293:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2294:       return true;    
 2295:    }
 2296: 
 2297: 
 2298:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2299:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2300:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2301: 
 2302:    
 2303:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2304: 
 2305:    u_int = nextElem->interpolateVelocities(xt); 
 2306: 
 2307:    assert(nextElem != this && "Next element is the same as the current element");
 2308: 
 2309:    return true;
 2310: }
 2311: 
 2312: 
 2313: __inline__ __device__ double Element::computeSignedArea(void) const {
 2314:    // Compute the area of the element
 2315: 
 2316:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2317: 
 2318:    // In the quad case we need to add the area of the other triangle.
 2319:    if (isQuad()) {
 2320:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2321:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2322:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2323:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2324: 
 2325:       res += ar1;
 2326:    }
 2327: 
 2328:    return res;
 2329: }
 2330: 
 2331: 
 2332: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2333:                                                                 (nodes[1]->isDry2()) ||
 2334:                                                                 (nodes[2]->isDry2()) ||
 2335:                                                                 (i34==4 && nodes[3]->isDry2());
 2336: }
 2337: 
 2338: __inline__ __device__ double Element::detJ_eta(void) const {
 2339:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2340:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2341: }
 2342: 
 2343: __inline__ __device__ double Element::detJ_xi(void) const {
 2344:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2345:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2346: }
 2347: 
 2348: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2349:    // In boundary sides, the element 1 is nullptr
 2350:    return side->elems[1] == nullptr; 
 2351: }
 2352: 
 2353: 
 2354: 
 2355: /**
 2356:    Compute the shape coordinates of the point (xt,yt) in the element.
 2357:    @param xt (input): x-coordinate of the point
 2358:    @param shpCoords (output): shape coordinates of the point
 2359:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2360:    @return true if the point is inside the element, false otherwise
 2361: **/
 2362: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord) const {
 2363: 
 2364:    // Compute the shape coordinates of the point xt in the element.
 2365:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2366:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2367:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2368:    // from the local frame, so use additional check.
 2369: 
 2370:    if (i34==3) { // Triangular element
 2371: 
 2372:       Point2 x0, x1, x2;
 2373: 
 2374:       // Horizontal local node coordinates. If ics == 2, the node coordinates are transformed to local frame.
 2375:       getLocalHorizontalNodePositions(x0, x1, x2);
 2376: 
 2377:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2378:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2379:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2380:       shpCoords[3] = 0.0;
 2381: 
 2382:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2383:       const bool res = (tmpmin >= -small);  
 2384:       
 2385:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2386:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2387: 
 2388:       
 2389:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2390:       // then we fix the negative shape coordinates.
 2391:       if ((tmpmin < 0) && fix) {
 2392: 
 2393:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2394:          // keeping the sum of the shape coordinates equal to 1.
 2395:          // I have tested and compared the new algorithm with the old one, and they give
 2396:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2397:          // The new algorithm should be faster since it is branchless.
 2398:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2399:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2400:          
 2401:          shpCoords[0] = (shpCoords[0] + a)*b;
 2402:          shpCoords[1] = (shpCoords[1] + a)*b;
 2403:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2404: 
 2405:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2406:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2407:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2408: 
 2409:          // Update the point coordinates for the new shape coordinates
 2410:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2411:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2412:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2413: 
 2414:       }
 2415: 
 2416:       // Check if the point is inside the element
 2417:       return res;      
 2418:    }
 2419:    else {
 2420:       Error("Not implemented yet");
 2421: #ifdef QUADS
 2422:       // Reproject pt in eframe of nel for ics=2
 2423:       if constexpr(ics==1) {
 2424:          xn2 = xt; 
 2425:          yn2 = yt;
 2426:       }
 2427:       else {
 2428:          // Transform the point coordinates to the local frame
 2429:          frame.G2L(xt, xn2);
 2430:          frame.G2L(yt, yn2);
 2431:       }
 2432: 
 2433:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2434: #endif
 2435:    }
 2436: 
 2437:    assert(false && "computeShapeCoords: should never reach this point");
 2438:    return false;  // Never reached
 2439: 
 2440: }
 2441: 
 2442: 
 2443: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2444: // Convert shape coordinates to cartesian coordinates
 2445: 
 2446:    if (i34 == 3) {
 2447:       // Triangular element
 2448:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2449:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2450:    }
 2451:    else {
 2452:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2453:    }
 2454: 
 2455: }
 2456: 
 2457: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2458:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2459:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2460:    // The formula for the integral is:
 2461:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2462: 
 2463:    printf("intPhiPhi: TEST\n");
 2464: 
 2465:    const Node *n0 = nodes[0];
 2466:    const Node *n1 = nodes[1];
 2467:    const Node *n2 = nodes[2];
 2468:    const Node *n3 = nodes[3];
 2469: 
 2470:    const Vector2 p0 = n0->p;
 2471:    const Vector2 p1 = n1->p;
 2472:    const Vector2 p2 = n2->p;
 2473:    const Vector2 p3 = n3->p;
 2474: 
 2475:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2476:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2477:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2478:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2479: 
 2480:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2481: }
 2482:    
 2483: 
 2484: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2485:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2486:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2487:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2488:    // The formula is also based on the identity:
 2489:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2490:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2491: 
 2492:    printf("intGradPhiGradPhi: TEST\n");   
 2493: 
 2494:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2495: 
 2496:    const double x0 = nodes[0]->p.x;
 2497:    const double y0 = nodes[0]->p.y;
 2498:    const double x1 = nodes[1]->p.x;
 2499:    const double y1 = nodes[1]->p.y;
 2500:    const double x2 = nodes[2]->p.x;
 2501:    const double y2 = nodes[2]->p.y;
 2502:    const double x3 = nodes[3]->p.x;
 2503:    const double y3 = nodes[3]->p.y;
 2504: 
 2505:    double res = 0.0;
 2506:    
 2507:    // Quadrature points in xi and eta coordinates
 2508:    #pragma unroll
 2509:    for (int i = 0; i < 4; i++) {
 2510:       // For each quadrature point...
 2511: 
 2512:       const Point2 p = GaussPoint(i);
 2513:       const double eta = p.x;
 2514:       const double xi  = p.y;
 2515: 
 2516:       // Jacobian entries at the Gauss point p
 2517:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2518:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2519:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2520:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2521: 
 2522:       const double detJ = jacobianDet(p);
 2523:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2524: 
 2525:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2526:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2527:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2528:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2529:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2530: 
 2531:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2532:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2533:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2534:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2535:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2536: 
 2537:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2538:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2539:    }
 2540: 
 2541:    return res;
 2542: }
 2543: 
 2544: 
 2545: /**  Interpolate velocities at a given point (xt,yt,zt)
 2546: 
 2547:    @param xt, yt, zt: coordinates of the point to interpolate
 2548:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2549: 
 2550:    This is done in four steps:
 2551: 
 2552:    1. Find the shape coordinates for the final position in the element.
 2553:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2554:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2555:       z levels at xt, yt at each step.   
 2556:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2557:       horizontally and vertically.
 2558: **/
 2559: __device__ Vector3 Element::interpolateVelocities(Point3 xt) const {
 2560:    // Interpolate the velocities at the point xt. 
 2561:    // This function works the same for triangular and quadrilateral elements.
 2562:    double shpCoord[4];
 2563:    Vector3 u_int;
 2564: 
 2565:    // First step is to compute the shape coordinates of (xt,yt)
 2566:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside);
 2567: 
 2568:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2569: 
 2570:    // Second step is to find the level that contains zt
 2571:    // Uses a binary search to find the level
 2572:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2573:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2574:    int R = nvrt - 1;
 2575: 
 2576:    // Get the z coordinates at the nodes of the element at the levels L and R
 2577:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2578:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2579:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2580: 
 2581:    double zL = interpolate(shpCoord, zLAtNodes);
 2582:    double zR = interpolate(shpCoord, zRAtNodes);
 2583:    
 2584:    // Interpolates vertically the velocities
 2585:    double wght1, wght2;
 2586:    if (xt.z<=zL) {
 2587:       wght1 = 1.0;
 2588:       wght2 = 0.0;
 2589:       xt.z = zL;
 2590:    }
 2591:    else if (xt.z>=zR) {
 2592:       wght1 = 0.0;
 2593:       wght2 = 1.0;
 2594:       xt.z = zR;
 2595:    }
 2596:    else {
 2597:       // Perform a binary search to find the levels between L and R that contain xt.z
 2598:       while (R - L > 1) {
 2599:          int M = (L + R) / 2.0;
 2600: 
 2601:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2602:          double zM = interpolate(shpCoord, zMAtNodes);
 2603:          if (zM < xt.z) 
 2604:          {
 2605:             L = M;
 2606:             zL = zM;
 2607:          }
 2608:          else 
 2609:          {
 2610:             R = M;
 2611:             zR = zM;
 2612:          }
 2613:       }
 2614:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2615:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2616: 
 2617:       wght2 = (xt.z - zL)/(zR - zL);
 2618:       wght1 = 1.0 - wght2;
 2619: 
 2620:    }
 2621: 
 2622: 
 2623:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2624:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2625: 
 2626:    // Neither of the interpolated velocities should be NaN
 2627:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2628: 
 2629:    return u_int;
 2630: 
 2631: }
 2632: 
 2633: 
 2634: 
 2635: 
 2636: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2637: 
 2638:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2639:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2640:    const Node *n1 = side->n1;
 2641:    const Node *n2 = side->n2;
 2642: 
 2643:    bool n1_match = (n1->nodeBnd->segment == segment);
 2644:    bool n2_match = (n2->nodeBnd->segment == segment);
 2645: 
 2646:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2647:    if (n1_match && n2_match) {
 2648:       return 0.5;
 2649:    } else if (n1_match) {
 2650:       return 1.0;
 2651:    } else if (n2_match) {
 2652:       return 0.0;
 2653:    }
 2654: 
 2655:    return 0.0;
 2656: }
 2657: 
 2658: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2659: 
 2660: 
 2661: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2662: 
 2663:    const double w1 = getBoundaryArrayValueWeight();
 2664:    const double w2 = 1.0 - w1;
 2665:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2666:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2667: 
 2668:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2669: }
 2670: 
 2671: 
 2672: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2673:    const double w1 = getBoundaryArrayValueWeight();
 2674:    const double w2 = 1.0 - w1;
 2675:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2676:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2677: 
 2678:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2679: 
 2680: }
 2681: 
 2682: 
 2683: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2684:    // Returns the value of the velocity at the side center
 2685:    const double w1 = getBoundaryArrayValueWeight();
 2686:    const double w2 = 1.0 - w1;
 2687:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2688:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2689: 
 2690:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2691: }
 2692: 
 2693: 
 2694: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2695:    // Returns the value of the normal component of the velocity at the side center
 2696:    const double w1 = getBoundaryArrayValueWeight();
 2697:    const double w2 = 1.0 - w1;
 2698:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2699:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2700: 
 2701:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2702: }
 2703: 
 2704: 
 2705: 
 2706: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2707: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2708: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2709: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2710: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2711: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2712:    Vector2 grad = {0.0, 0.0};
 2713:    int count = 0;
 2714: 
 2715:    // First element
 2716:    if (elems[0] != nullptr && condition(elems[0])) {
 2717:       Vector2 elemGrad = elems[0]->grad2(field);
 2718: 
 2719:       // For ics=2, projects the element gradient to the side frame
 2720:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 2721: 
 2722:       grad += elemGrad;
 2723: 
 2724:       count++;
 2725:    }
 2726: 
 2727:    // Second element
 2728:    if (elems[1] != nullptr && condition(elems[1])) {
 2729: 
 2730:       Vector2 elemGrad = elems[1]->grad2(field);
 2731: 
 2732:       // For ics=2, projects the element gradient to the side frame
 2733:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 2734: 
 2735:       grad += elemGrad;
 2736: 
 2737:       count++;
 2738:    }
 2739: 
 2740:    if (count > 0) {
 2741:       grad = grad*(1.0/count);
 2742:    }
 2743:    
 2744:    return grad;
 2745: }
 2746: 
 2747: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2748: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2749: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2750: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2751: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2752: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2753: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2754: 
 2755: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2756: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2757: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2758: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2759: 
 2760: 
 2761: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2762: 
 2763: __inline__ __device__ Vector2 Side::tau(void)    const { 
 2764:    // Returns the value of the tau at the side center, taking care of the projection to the side frame (ics==1 or ics==2)
 2765:    if constexpr(ics==1) { 
 2766:       return 0.5*(n1->tau + n2->tau);
 2767:    } else {
 2768:       // Project the tau from the node frames to the side frame
 2769:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 2770:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 2771: 
 2772:       return 0.5*(stau1 + stau2);
 2773:    }
 2774: }
 2775: 
 2776: /**
 2777:  * This method performs backtracking from the side center until a time -dt back in time 
 2778:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2779:  * intermediate point.
 2780:  *
 2781:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2782:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2783:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2784:  * remaining time.
 2785:  * 
 2786:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2787:  * 
 2788:  * @param uuint, vvint, wwint: Velocities at the final point
 2789:  * @param jlev: Level at which the backtracking is performed
 2790:  * @param dt, dtbk: Tracking timesteps
 2791:  * @return: True if the backtracking was successful, false otherwise
 2792:  */
 2793: __inline__ __device__ bool Side::btrack(
 2794:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2795:       double dt,            // Tracking time
 2796:       double dtbk,          // Tracking timestep
 2797:       Vector3 &u_int        // Velocities at the initial point
 2798: ) const {
 2799: 
 2800:    // Start from side center
 2801:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2802: 
 2803:  
 2804:    double time_rm = dt; // Remaining time
 2805: 
 2806: 
 2807:    // Initial velocities
 2808:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2809: 
 2810:    // Find the element that is in the direction opposite to the velocity
 2811:    Element* curElem = findElementTowards(toVector2(u_int));
 2812:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2813: 
 2814: 
 2815:    // Nudges it towards the barycenter
 2816:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2817: 
 2818: 
 2819:    const int MAX_ITERATIONS = 100; 
 2820:    Element* nextElem = nullptr;
 2821:    int iter = 0;
 2822:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2823:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2824:    while(true) {
 2825: 
 2826:       // Calculate timestep
 2827:       double dtb = min(dtbk, time_rm);
 2828: 
 2829: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 2830: 
 2831:       // Next point in the backtracking curve
 2832: // if (iter >= MAX_ITERATIONS - 50)  {
 2833: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 2834: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 2835: // }
 2836:         
 2837:       xt = x0 - dtb*u_int;
 2838: 
 2839:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2840:       assert(found && "Backtracking failed in btrack");
 2841: 
 2842: 
 2843:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2844:                       // then time_rm needs to be increased by the unused time.
 2845: 
 2846:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2847: 
 2848:       // If the velocity is too small, we stop the backtracking
 2849:       const double vmag = length(toVector2(u_int));
 2850:       if (vmag <= velmin_btrack) break;
 2851: 
 2852:       // The current point becomes the next segment's starting point.
 2853:       x0 = xt;
 2854:  
 2855:       curElem = nextElem;
 2856: 
 2857:       iter++;
 2858: 
 2859:       if (iter >= MAX_ITERATIONS) break;
 2860: 
 2861:       // if (iter >= MAX_ITERATIONS - 50) {
 2862:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 2863:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 2864:       //    }
 2865:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2866:    }
 2867: 
 2868:    assert(!curElem->isDry && "Final element is dry");
 2869:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element"); 
 2870: 
 2871:    // Interpolate the velocities at the final point
 2872:    u_int = curElem->interpolateVelocities(xt);
 2873: 
 2874:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 2875: 
 2876: 
 2877: }
 2878: 
 2879: 
 2880: 
 2881: // /**
 2882: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2883: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2884: 
 2885: //    Inputs:
 2886: //    @param x1, y1: point inside the element
 2887: //    @param x2, y2: other end of the line segment
 2888: 
 2889: //    Outputs:
 2890: //    @param intersectingSide:  side that intersects the line segment
 2891: //    @param nextElement: element that contains the intersection point
 2892: //    @param xIntersect, yIntersect: intersection point  
 2893: 
 2894: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2895: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2896: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
