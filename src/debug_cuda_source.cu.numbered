 2674:    template<typename T>
 2675:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2676: 
 2677:       T values[4];
 2678: 
 2679: 
 2680:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2681:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2682:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2683:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2684:       else          values[3] = T();
 2685: 
 2686:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2687: 
 2688:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2689:    }
 2690: 
