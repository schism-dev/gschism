 3388: 
 3389: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3390:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3391:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3392: 
 3393: 
 3394:    NODE(node1);
 3395: 
 3396:    node1->clearMatrixRow();
 3397:    node1->qel = 0.0;
 3398: 
 3399:    // THIS IS FOR STRUCTURES XXX
 3400:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3401: 
 3402:    
 3403:    for (int j=0; j<node1->numElements; j++) {
 3404:       // For each element connected to the node...
 3405: 
 3406:       Element *elem = node1->elements[j];
 3407: 
 3408: 
 3409: 
 3410:       // Compute the average gravity
 3411:       const double grav3 = elem->mean(&Node::grav2);
 3412: 
 3413:       // Look at the documentation for the description of the terms in the following integrals
 3414: 
 3415:       // Integral I_1 
 3416:       // \bar{\breve{H}} 
 3417:       const double hhatb = elem->mean(&Side::hhat);        
 3418: 
 3419:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3420: 
 3421:       const int id1 = elem->nodeLocalIdx(node1); 
 3422:       const double area = elem->area;
 3423: 
 3424:       if (elem->isTri()) {
 3425: 
 3426:          // To clarify the notation in this section: 
 3427:          //   i stands for the node under consideration (node1)
 3428:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3429:          const int id2 = elem->nxq(1 + id1);
 3430:          const int id3 = elem->nxq(2 + id1);
 3431:          Node *node2 = elem->nodes[id2];
 3432:          Node *node3 = elem->nodes[id3];
 3433: 
 3434:          const Point2 x1 = node1->p;
 3435:          const Point2 x2 = node2->p;
 3436:          const Point2 x3 = node3->p;
 3437: 
 3438:          // integral of phi_i*phi_j
 3439:          const double ipp_ii = (1.0/6.0 )*area;
 3440:          const double ipp_ij = (1.0/12.0)*area;
 3441:          const double ipp_ik = (1.0/12.0)*area;
 3442: 
 3443:          // integral of [(grad phi_i) * (grad phi_j)]
 3444:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3445:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3446:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3447: 
 3448:          // Computes the different components of integral I_1 of each node with respect to node i.
 3449:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3450:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3451:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3452: 
 3453:          node1->addToSparseMatrix(node1, I1_ii);
 3454:          node1->addToSparseMatrix(node2, I1_ij); 
 3455:          node1->addToSparseMatrix(node3, I1_ik);
 3456: 
 3457:       }
 3458:       else { // Quad
 3459:          // XXX IMPLEMENT THIS
 3460:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3461: 
 3462:          // To clarify the notation in this section: 
 3463:          //   i stands for the node under consideration (node1)
 3464:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3465:          const int id2 = elem->nxq(1 + id1);
 3466:          const int id3 = elem->nxq(2 + id1);
 3467:          const int id4 = elem->nxq(3 + id1);
 3468:          Node *node2 = elem->nodes[id2];
 3469:          Node *node3 = elem->nodes[id3];
 3470:          Node *node4 = elem->nodes[id4];         
 3471: 
 3472:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3473:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3474:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3475:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3476:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3477: 
 3478:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3479:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3480:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3481:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3482:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3483: 
 3484:          // Computes the different components of integral I_1 of each node with respect to node i.
 3485:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3486:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3487:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3488:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3489: 
 3490:          node1->addToSparseMatrix(node1, I1_ii);
 3491:          node1->addToSparseMatrix(node2, I1_ij); 
 3492:          node1->addToSparseMatrix(node3, I1_ik);
 3493:          node1->addToSparseMatrix(node4, I1_il);
 3494:   
 3495:       } 
 3496: 
 3497:  
 3498:       // Integral I_4
 3499:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3500:       // Where
 3501:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3502: 
 3503:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3504:       // of U over the element.
 3505:       Vector2 U = {0.0, 0.0};
 3506:       for (int m=0; m < elem->i34; m++) {      
 3507:          const Side *side = elem->sides[m];
 3508: 
 3509:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3510:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3511:       }
 3512:       U = U/elem->i34;
 3513: 
 3514: 
 3515:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3516: 
 3517: 
 3518:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3519:       const double I_4_1 = dot(gradPhi_1, U);
 3520: 
 3521: 
 3522:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3523:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3524: 
 3525:      
 3526:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3527: 
 3528:       // Additional terms 
 3529:       double vnorm = 0.0;
 3530:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3531:          Vector3 ubed = {0.0, 0.0, 0.0};
 3532:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3533: 
 3534:          Vector3 gradP = {0.0, 0.0, 1.0};
 3535:          for (int m=0; m < elem->i34; m++) {
 3536:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3537:            gradP += toVector3(gradP_2D, 0.0);
 3538:          }   
 3539:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3540:       } // imm==2
 3541: 
 3542:       if (elem->isTri()) {
 3543:          for (int l=0; l<3; l++) {
 3544: 
 3545:             Node *node = elem->nodes[l];
 3546: 
 3547:             double fac = (node == node1) ? 2.0 : 1.0;
 3548:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3549:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3550:            
 3551:          }
 3552: 
 3553: 
 3554:          if (!elem->isDry) {
 3555:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3556: 
 3557:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3558: 
 3559:          }
 3560: 
 3561:       } // isTri
 3562:       else { // isQuad
 3563:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3564:          // for (int l=0; l<4; l++) {
 3565:          //   const Node *node = elem->nodes[l];
 3566: 
 3567:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3568:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3569: 
 3570:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3571:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3572:          // }
 3573: 
 3574:       } // isQuad
 3575: 
 3576: 
 3577:      node1->qel += (dt/elem->i34)*elem->vsource;
 3578:       
 3579: 
 3580:    } // for all elements connected to the node
 3581:    
 3582: 
 3583:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3584:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3585:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3586:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3587:       // If it is an open boundary node...
 3588: 
 3589:       // At least one open bnd side, maybe two
 3590:       for (int l=0; l<2; l++) { 
 3591: 
 3592:          // Gets each of the sides sharing the node. 
 3593:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3594: 
 3595:        
 3596: 
 3597:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3598:          if (sideBnd != nullptr) {
 3599:             // If the side is on a boundary...
 3600: 
 3601:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3602: 
 3603:             // Get the boundary segment
 3604:             const BoundarySegment *sideSegment = sideBnd->segment;
 3605:             const Side *side = sideBnd->side;
 3606: 
 3607:             // Integral I_3
 3608:             if (sideSegment->ifltype != 0) {
 3609:             // Natural or Flather b.c.
 3610: 
 3611:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3612:                // especially for Flather b.c.
 3613:                double ri3 = 0.0;
 3614:                if (!side->isDry) {
 3615:                   // If the side is not dry
 3616:                   
 3617:                   // Computes the side flux of (uth, vth)
 3618:                   double Vn = 0.0;
 3619:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3620:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3621:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3622: 
 3623:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3624:                   }
 3625: 
 3626:                   ri3 = 0.5*side->len*Vn;
 3627:                }
 3628: 
 3629:                if (sideSegment->ifltype == -1) { // Flather 1
 3630: 
 3631:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3632:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3633: 
 3634:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3635:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3636:                   
 3637:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3638:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3639: 
 3640:                } 
 3641:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3642:                   // Reset ri3
 3643:                   ri3 = 0.0;
 3644: 
 3645:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3646: 
 3647:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3648: 
 3649:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3650:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3651: 
 3652:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3653:                   node1->addToSparseMatrix(node1, con0*2.0);
 3654:                   node1->addToSparseMatrix(node2, con0);
 3655: 
 3656:                } // if Flather or Discharge
 3657: 
 3658:                node1->qel -= thetai*dt*ri3;
 3659: 
 3660: 
 3661:             } // I_3
 3662:           
 3663: 
 3664:             // Integral I_5
 3665:             if(!side->isDry) {
 3666: 
 3667:                const double Unbar = dot(side->U, side->n);
 3668:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3669: 
 3670:             } // I_5
 3671: 
 3672:          } // if is boundary side
 3673: 
 3674:       } // for l
 3675: 
 3676:    } // if isbnd
 3677: 
 3678: 
 3679: }
 3680: 
 3681: 
 3682: 
 3683: extern "C" {
 3684:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3685:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3686:                                   int* indices, int* indptr) {
 3687: 
 3688:       NODE(node);
 3689:       
 3690:       const int idx = node->idx;
 3691:       
 3692:       // Computes the index in the nzz array      
 3693:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3694: 
 3695: 
 3696:       indptr[idx] = nzzIdx;
 3697:       indices[nzzIdx] = idx;
 3698: 
 3699:       data_d[nzzIdx]    = node->coeffDiag;
 3700:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3701: 
 3702:       diag_d[idx] = 1.0/node->coeffDiag;
 3703:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3704: 
 3705:       b_d[idx] = node->qel;
 3706:       b_f[idx] = (float)node->qel;
 3707: 
 3708:       for (int k = 0; k < node->numNodes; ++k) {
 3709:          const Node* nb = node->nodes[k];
 3710: 
 3711:          const int j = nb->idx;
 3712: 
 3713:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3714:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3715: 
 3716:          indices[nzzIdx + k + 1] = j;
 3717:       }
 3718: 
 3719:  
 3720:    }
