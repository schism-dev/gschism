 7988:    __global__ void resetVelocityOpenBndNodes(void) {
 7989:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7990: 
 7991:       NODE_BND(nodebnd);
 7992: printf("DDDDDDDDDD\n");  // XXXXXXX
 7993:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7994:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7995:       }
 7996: 
 7997:    }
