 4525:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4526: 
 4527:       NODE_BND(nodeBnd);
 4528: 
 4529:       Node *node = nodeBnd->node;
 4530: 
 4531:       node->ETP = 0.0;
 4532: 
 4533:       for (int j=0; j<ntip; j++) {
 4534: 
 4535:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4536:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4537:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4538: 
 4539:          if constexpr(iloadtide==1) { // loading tide
 4540:             assert(false && "Loading tide not implemented");
 4541:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4542:          }
 4543:          
 4544:       }
 4545:       
 4546:    }
