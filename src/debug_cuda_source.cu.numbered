 1593: __device__ void lock(int *mutex) {
 1594:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1595: }
 1596: 
 1597: __device__ void unlock(int *mutex) {
 1598:     atomicExch(mutex, 0);
