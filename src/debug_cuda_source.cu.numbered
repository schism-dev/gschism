 9520: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 9521:    // Get the value of a variable from an side
 9522:    // varName is the name of the variable to get
 9523:    // var is the array to store the value
 9524:    // k is the vertical level index of the variable to get
 9525:    SIDE_BND(sideBnd);   
 9526: 
 9527:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 9528:    if (sideBnd->segment->isLand) idx = -7;
 9529: 
 9530:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 9531:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 9532: 
 9533: }
