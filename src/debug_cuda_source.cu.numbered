 7424: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1) {
 7425:    // Get the value of a variable from an element
 7426:    // varName is the name of the variable to get
 7427:    // var is the array to store the value
 7428:    // k is the vertical level index of the variable to get
 7429: 
 7430:    ELEM(elem);
 7431:    
 7432:    int idx = elem->idx;
 7433:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7434: 
 7435:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7436:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7437:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7438:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7439:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7440:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7441:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7442:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7443:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7444:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7445:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7446:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7447:       
 7448:    
 7449: }
 7450: 
 7451: 
 7452: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7453:    // Get the value of a variable from an node
 7454:    // varName is the name of the variable to get
 7455:    // var is the array to store the value
 7456:    // k is the vertical level index of the variable to get
 7457: 
 7458:    NODE(node);
 7459:    
 7460:    int idx = node->idx;
 7461:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7462: 
 7463:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7464:    
 7465:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7466:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7467:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7468:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7469:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7470:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7471:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7472:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7473:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7474:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7475:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7476:       
 7477:    
 7478: }
 7479: 
 7480: 
 7481: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7482:    // Get the value of a variable from an side
 7483:    // varName is the name of the variable to get
 7484:    // var is the array to store the value
 7485:    // k is the vertical level index of the variable to get
 7486:    SIDE(side);
 7487:    
 7488:    int idx = side->idx;
 7489:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7490: 
 7491:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7492:    
 7493:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = side->zc[k];
 7494:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = side->center.x;
 7495:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = side->center.y;
 7496:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = side->u2[k].x;
 7497:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = side->u2[k].y;
 7498:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = side->depth();
 7499:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(side->kb);
 7500:    else if (varCode == (int)VarCode::n1 && k == -1)     var[idx] = side->n1->idx;
 7501:    else if (varCode == (int)VarCode::n2 && k == -1)     var[idx] = side->n2->idx;
 7502:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = side->eta2();
 7503:    else if (varCode == (int)VarCode::btu && k >= 0)     var[idx] = side->btu[k].x;
 7504:    else if (varCode == (int)VarCode::btv && k >= 0)     var[idx] = side->btu[k].y;
 7505:    else if (varCode == (int)VarCode::bccx && k >= 0)    var[idx] = side->bcc[k].x;
 7506:    else if (varCode == (int)VarCode::bccy && k >= 0)    var[idx] = side->bcc[k].y;
 7507:    else if (varCode == (int)VarCode::ubc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7508:    else if (varCode == (int)VarCode::vbc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7509:    else if (varCode == (int)VarCode::uth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7510:    else if (varCode == (int)VarCode::vth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7511:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7512: }
