  403: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  404:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  405:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  406: }
  407: 
  408: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  409:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  410:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  411: }
  412: 
  413: 
  414: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  415:    x3 = y1*z2 - y2*z1;
  416:    y3 = x2*z1 - x1*z2;
  417:    z3 = x1*y2 - x2*y1;
  418: }
