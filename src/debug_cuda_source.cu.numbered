 8028:          *sizeType = sizeof(Vector2);
 8029:          break;
 8030:       case (int)VarCode::len:
 8031:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 8032:          *sizeType = sizeof(double);
 8033:          break;
 8034:       case (int)VarCode::kb:
 8035:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 8036:          *sizeType = sizeof(int);
 8037:          break;
 8038:       case (int)VarCode::isdry:
 8039:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8040:          *sizeType = sizeof(int);
 8041:          break;            
 8042:       case (int)VarCode::w:
 8043:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8044:          *sizeType = sizeof(double);
 8045:          break;
 8046:       case (int)VarCode::u:
 8047:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8048:          *sizeType = sizeof(Vector2);
 8049:          break;   
 8050:       case (int)VarCode::n1:
 8051:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8052:          *sizeType = sizeof(Node);
 8053:          break;
 8054:       case (int)VarCode::n2:
 8055:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8056:          *sizeType = sizeof(Node);
 8057:          break;                   
 8058:       default:
 8059:          *offset = -1;
 8060:    }
 8061: }
