 8117: 
 8118:    const int size = mesh->np;
 8119:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8120:       const Node *node = mesh->localNodeData + idx_node;
 8121: 
 8122:       res[idx_node] = node->qel;
 8123: 
 8124:    }
 8125:    
 8126: }
