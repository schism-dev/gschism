 2123: 
 2124: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2125:    if constexpr(ics == 1)  {
 2126:       return center;
 2127: 
 2128:    } else {
 2129:       const Point2 p0 = nodes[0]->outputCoords();
 2130:       const Point2 p1 = nodes[1]->outputCoords();
 2131:       const Point2 p2 = nodes[2]->outputCoords();
 2132: 
 2133:       if (isTri()) {
 2134:          return (1.0/3.0)*(p0 + p1 + p2);
 2135: 
 2136:       } else {
 2137:          const Point2 p3 = nodes[3]->outputCoords();
 2138:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2139:       }
 2140: 
 2141:    }
 2142: }
 2143: 
 2144: 
 2145: __device__ __forceinline__ double Element::centerZ(void) const { 
 2146: // Z coordinate of the element center in the global cartesian coordinates.
 2147: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2148: 
 2149:    if constexpr(ics==1) { 
 2150:       return 0.0; 
 2151: 
 2152:    } else { 
 2153: 
 2154:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2155:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2156:    } 
 2157: }
