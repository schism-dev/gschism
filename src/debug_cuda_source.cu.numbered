 3751: extern "C" {
 3752:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 3753:                                   int* indices, int* indptr) {
 3754: 
 3755:       NODE(node);
 3756:       
 3757:       const int idx = node->idx;
 3758:       
 3759:       // Computes the index in the nzz array      
 3760:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3761: 
 3762: 
 3763:       indptr[idx] = nzzIdx;
 3764:       indices[nzzIdx] = idx;
 3765: 
 3766:       data_d[nzzIdx]    = node->coeffDiag;
 3767: 
 3768:       b_d[idx] = node->qel;
 3769: 
 3770:       for (int k = 0; k < node->numNodes; ++k) {
 3771:          const Node* nb = node->nodes[k];
 3772: 
 3773:          const int j = nb->idx;
 3774: 
 3775:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3776: 
 3777:          indices[nzzIdx + k + 1] = j;
 3778:       }
 3779: 
 3780:  
 3781:    }
 3782: 
 3783: 
 3784: 
 3785:    __global__ void solverCopyResult(double* x) {
 3786:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3787:       NODE(node);
 3788:       const int idx = node->idx;
 3789: 
 3790:       node->mX = x[idx];
 3791:    }
 3792: 
 3793: 
 3794:    __global__ void rollUpElevation(void) {
 3795: 
 3796:       NODE(node);
 3797: 
 3798:       node->eta1 = node->eta2;
 3799: 
 3800:    }
 3801: 
 3802: 
 3803:    __global__ void backtrackAllNodes(void) {
 3804: 
 3805:       // max/min # of sub-divisions
 3806:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 3807:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 3808: 
 3809: 
 3810:       SIDE(side);
 3811: 
 3812:       const int kb = side->kb;
 3813: 
 3814: 
 3815:       // Initialize btrack velocities to the actual velocities at the side 
 3816:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3817: 
 3818:   
 3819: 
 3820:       if (side->isDry) return;
 3821:       
 3822: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3823: 
 3824:       // Checks that at least one element is not dry
 3825:       const Element *elem1 = side->elems[0];
 3826:       const Element *elem2 = side->elems[1];
 3827: 
 3828: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3829: 
 3830:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3831:       
 3832:       // XXXXXX
 3833:       // !swild_tmp to store global coord. of the starting side
 3834:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3835:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3836:       // !Use sframe2 
 3837:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3838: 
 3839: 
 3840:       for (int k = kb; k < nvrt; k++) {
 3841:       //  Initialize (xt,yt,zt), nnel and vel.
 3842:       //  For ics=2, the coordinates are in local frames
 3843:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3844: 
 3845: 
 3846:          const int iadvf = side->iadv();  // Advection flag   
 3847:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3848: 
 3849:          Point3 xt;
 3850:          if constexpr(ics==1) {
 3851:             xt = side->center3D(k); 
 3852:          }
 3853:          else // lat/lon; in side lat/lon frame
 3854:          {
 3855:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3856:          // XXX IMPLEMENT THIS
 3857:       //          xt=0.d0
 3858:       //          yt=0.d0
 3859:       //          !centroid coord. for nudging
 3860:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3861:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3862:          }  // ics
 3863: 
 3864: 
 3865: 
 3866:          // If on land or open boundary...
 3867:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3868:          
 3869:          const double vmag = length(side->u2[k]);
 3870: 
 3871:          if (vmag <= velmin_btrack) {
 3872:             // No activity 
 3873: 
 3874:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3875: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 3876: 
 3877: 
 3878:             
 3879:          } else {  // do btrack
 3880: 
 3881:             // Compute number of sub-divisions based on local gradients of the velocity field
 3882: 
 3883:             // XXX IS THIS NECESSARY?
 3884:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 3885:             double suma = 0.0;
 3886:             int icount = 0;
 3887:             for (int l=0; l<2; l++) {
 3888:             // For each element sharing the side...
 3889: 
 3890:                const Element *elem = side->elems[l];
 3891:                  
 3892:                if (elem == nullptr) continue;
 3893: 
 3894:                icount++;
 3895: 
 3896:                // Not strictly along z; in ll frame for ics=2
 3897: 
 3898:                double utmp[4];
 3899:                double vtmp[4];
 3900:                for (int j = 0; j < elem->i34; j++) {
 3901: 
 3902:                   const Node *node = elem->nodes[j];
 3903: 
 3904:                   if constexpr(ics==1) {
 3905:                      utmp[j] = node->u2[k].x;
 3906:                      vtmp[j] = node->u2[k].y;  
 3907:                   } else {
 3908:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3909:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(j),vtmp0(j))
 3910:                   }
 3911:                } // for j
 3912: 
 3913:                const Vector2 grad_u = elem->grad2(utmp); 
 3914:                const Vector2 grad_v = elem->grad2(vtmp);
 3915: 
 3916:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3917:             } // for ii
 3918: 
 3919:             assert(icount > 0 && "Impossible 77");
 3920: 
 3921:             // '4' is somewhat arbitrary
 3922:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3923: 
 3924:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3925: 
 3926:             Vector3 u_int = {0.0, 0.0, 0.0};
 3927: 
 3928:             bool res =side->btrack(k, dt, dtbk, u_int);
 3929: 
 3930:             side->btu[k] = toVector2(u_int);
 3931:                
 3932:          } // if vmag (do backtrack)
 3933: 
 3934: 
 3935:       } // for k=kb,nvrt-1
 3936: 
 3937:    }
 3938: 
 3939: } // extern "C"
 3940: 
 3941: template<int nc>
 3942: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3943: 
 3944: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3945: //
 3946: // a,b,c,rhs: input vectors and are not modified by this program.
 3947: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3948: // rhs is the r.h.s.
 3949: // n: actual rank of the system.
 3950: // rows in u() and rhs();
 3951: // u: output with nc columns (transposed to rows)
 3952: // gam: a working array.
 3953: //
 3954: // NOTES:
 3955: // This is a template function that allows for different numbers of columns in the rhs vector.
 3956: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3957: 
 3958:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3959:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3960: 
 3961:    double bet = b[0];
 3962:    if constexpr (nc == 1) {
 3963:       u[0] = rhs[0]/bet;
 3964:    } else {
 3965:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3966:    }
 3967: 
 3968:    for (int j = 1; j < n; j++) {
 3969:       gam[j] = c[j - 1]/bet;
 3970:       bet = b[j] - a[j]*gam[j];
 3971: 
 3972:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3973: 
 3974:       if constexpr (nc == 1) {
 3975:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3976:       } else {
 3977:          for (int l = 0; l < nc; l++) {
 3978:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3979:          }
 3980:       }
 3981:    }
 3982: 
 3983:    // Back-substitution
 3984:    for (int j = n - 2; j >= 0; j--) {
 3985:       if constexpr (nc == 1) {
 3986:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3987:       } else {
 3988:          for (int l = 0; l < nc; l++) {
 3989:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3990:          }
 3991:       }
 3992:    }
 3993: }
 3994: 
 3995: 
 3996: 
 3997: // Helper function that contains the core algorithm
 3998: template<typename XAccessor, typename YAccessor>
 3999: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4000:                                     double  yp_top, double  yp_bot, 
 4001:                                     CubicSpline &spline) {
 4002:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4003:    // 
 4004:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4005:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4006:    //
 4007:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4008:    // 
 4009:    // Inputs: 
 4010:    //            n: dimension for x etc; # of data pts (>=2);
 4011:    //            getX, getY: functions to access x,y coordinates
 4012:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4013:    //     Output: 
 4014:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4015: 
 4016:    const int n = k2 - k1 + 1;
 4017:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4018: 
 4019:    // Allocate memory for the splines
 4020:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4021:    spline.x   = new double[n];
 4022:    spline.y   = new double[n];
 4023:    spline.yp  = new double[n];
 4024:    spline.ypp = new double[n];
 4025: 
 4026:    for (int k=k1; k<=k2; k++) {
 4027:       spline.x[k] = getX(k);
 4028:       spline.y[k] = getY(k);
 4029:    }
 4030: 
 4031:    // This is to simplify expressions later
 4032:    double *x = spline.x;
 4033:    double *y = spline.y;
 4034: 
 4035:    double *a = nullptr;
 4036:    double *b = nullptr;
 4037:    double *c = nullptr;
 4038:    double *gam = nullptr;
 4039:    double *rhs = nullptr;
 4040:    
 4041: 
 4042:       a = new double[n];   // Lower diagonal
 4043:       b = new double[n];   // Diagonal
 4044:       c = new double[n];   // Upper diagonal
 4045:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4046:       rhs = new double[n]; // Right-hand side
 4047: 
 4048:    for (int k=k1; k<=k2; k++) {
 4049:       if (k == k1) {
 4050:          // Bottom level
 4051:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4052:          b[k] = (x[k+1] - x[k])/3.0;
 4053:          c[k] = b[k]/2.0;
 4054:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4055:       } else if (k == n - 1) {
 4056:          // Top level (surface)
 4057:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4058:          b[k] = (x[k] - x[k-1])/3.0;
 4059:          a[k] = b[k]/2.0;
 4060:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4061:       } else {
 4062:          // Intermediate levels
 4063:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4064:          b[k] = (x[k+1] - x[k-1])/3.0;
 4065:          a[k] = (x[k  ] - x[k-1])/6.0;
 4066:          c[k] = (x[k+1] - x[k  ])/6.0;
 4067:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4068:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4069:       }
 4070:    }
 4071: 
 4072:    // Solve the tridiagonal system
 4073:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4074:    
 4075:    spline.yp[k1] = yp_bot;
 4076:    spline.yp[k2] = yp_top;
 4077: 
 4078:    // Compute rest of 1st derivatives using the splines
 4079:    for (int k=k1+1; k<k2; k++) {
 4080:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4081:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4082:    }
 4083:    
 4084:    delete[] a;
 4085:    delete[] b;
 4086:    delete[] c;
 4087:    delete[] gam;
 4088:    delete[] rhs;
 4089: 
 4090: }
 4091: 
 4092: // Array version
 4093: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4094:                                 double y_top, double y_bot, 
 4095:                                 CubicSpline &spline) {
 4096:    auto getX = [x] (int k) { return x[k]; };
 4097:    auto getY = [y] (int k) { return y[k]; };
 4098:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4099: }
 4100: 
 4101: // Lambda version - allows custom access patterns
 4102: template<typename XFunc, typename YFunc>
 4103: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4104:                                 double y_top, double y_bot,
 4105:                                 CubicSpline &spline) {
 4106:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4107: }
