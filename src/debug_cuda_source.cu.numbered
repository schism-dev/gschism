 3690: 
 3691: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3692:    // Computes the z coordinate at level k.
 3693:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3694:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3695:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3696:    // used 
 3697: 
 3698:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3699:    
 3700:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3701: 
 3702:    if (isDry2()) return 0.0;  
 3703: 
 3704:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3705: 
 3706:    if constexpr(ivcor == 2) {
 3707: 
 3708:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3709:       const double h_c = mesh->h_c;
 3710:       const double theta_f = mesh->theta_f;
 3711:       const double sinh_theta_f = mesh->sinh_theta_f;
 3712: 
 3713: 
 3714:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3715:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3716:       // once per time step/node. XXXX
 3717:       // CHECK: updateZCoordData
 3718: 
 3719:       //  To simplify comparisons, I define index versions of count variables.
 3720:       if      (k == ivrt)     return eta2; 
 3721:       else if (k == izlev)    return -hmod2;
 3722:       else if (k == kb)       return -depth;
 3723:       else if (k < izlev)     return mesh->ztot[k];
 3724:       else if (k > izlev) {
 3725:          const int ksig = k - izlev;
 3726: 
 3727:          if (hmod2 <= h_c) {
 3728:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3729: 
 3730:          } 
 3731:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3732:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3733:             assert(false && "compZCoord: invalid h_c\n");
 3734:          } 
 3735:          else {
 3736:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3737:                    h_c * mesh->sigma[ksig] + 
 3738:                    (hmod2 - h_c) * mesh->cs[ksig];
 3739:          }
 3740:       } else { 
 3741:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3742:       }
 3743: 
 3744:    }
 3745:    else {  // if constexpr(ivcor == 1)
 3746:       if (k <= kb)        return -depth; 
 3747:       else if (k == ivrt) return eta2;
 3748:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3749: 
 3750:    }
 3751:    
 3752:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3753:    return 0.0;
 3754: }
 3755: 
 3756: 
 3757: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3758:    // Computes the bottom drag Cd based on the selected nchi
 3759: 
 3760:    if constexpr(nchi == 0) {
 3761:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3762:       Cd = drag;  // Read from drag file
 3763: 
 3764:    } else if constexpr(nchi == 1) {
 3765:       // 
 3766: 
 3767:       bool ltmp = false; // for WBL iteration
 3768: 
 3769:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3770:       if (isDry || (rough == 0.0)) {
 3771:          Cd = 0.0;
 3772: 
 3773:       } else { //roughness >0 
 3774:          
 3775:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3776: 
 3777:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3778: 
 3779:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3780: 
 3781:       } // if rough
 3782: 
 3783:    } else if constexpr(nchi == -1) {
 3784:    // Manning 
 3785:  
 3786:       const double htot = max(hmin_man, htot2()); 
 3787:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3788: 
 3789:    } else {
 3790:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3791:       
 3792:    } // if nchi
 3793: 
 3794: }
 3795: 
 3796: 
 3797: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3798:    // Checks if a side in on the boundary
 3799:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3800: 
 3801:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3802:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3803: 
 3804:    // Indices of the nodes that form the side
 3805:    //
 3806:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3807:    const int n1 = side.n1->idx;
 3808:    const int n2 = side.n2->idx;
 3809:    isLand = false;
 3810:    
 3811: 
 3812:    // Check if the side is on a land boundary
 3813:    for (int i = 0; i < nland; i++) {
 3814:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3815:          // Consecutive nodes in the land boundary segment
 3816:          const int b1 = ilnd[i + j*nland];
 3817:          const int b2 = ilnd[i + (j + 1)*nland];
 3818: 
 3819:          assert(b1 != -1 && b2 != -1);
 3820: 
 3821:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3822:             
 3823:             isLand = true;
 3824:             return i;
 3825:          }
 3826:       }
 3827:    }
 3828: 
 3829:    // Check if the side is on an open boundary
 3830:    for (int i = 0; i < nope; i++) {
 3831:       for (int j = 0; j < nond[i] - 1; j++) {
 3832:          // Consecutive nodes in the open boundary segment
 3833:          const int b1 = iond[i + j*nope];
 3834:          const int b2 = iond[i + (j + 1)*nope];
 3835: 
 3836:          assert(b1 != -1 && b2 != -1);
 3837: 
 3838:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3839:             isLand = false;
 3840:             return i;
 3841:          }
 3842:       }
 3843:    }
 3844: 
 3845:    // Check that the nodes are not both on the boundary
 3846:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 3847:         && "side not in ilnd/iond but both nodes are boundary" );
 3848: 
 3849:    return -1;
 3850: }
 3851: 
 3852: 
 3853: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3854:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3855:                                     double *wind_rotate_angle, 
 3856:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3857:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3858:                                     int16_t *nodePermutationSort, 
 3859:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 3860:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3861:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3862:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3863:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3864: 
 3865:    NODE(pnode);  
 3866:    const int i = idx_node;
 3867:    const int iglobal = globalNodeIndices[i];
 3868:    Node &node(*pnode);
 3869: 
 3870:    node.idx = iglobal;
 3871:    node.part = localNodePart[iglobal];
 3872: 
 3873:    // It is important to differentiate between the global and local "start" indices because they
 3874:    // play different, but related, roles in this code. The global "start" indices are used
 3875:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 3876:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 3877:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 3878:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 3879:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 3880:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 3881:    node.numNodes = idxNodeEnd - idxNodeStart;
 3882:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 3883:    node.permutationSortedByGlobalIndex = nodePermutationSort + idxNodeLocalStart;
 3884:    node.coeffMatrix = coeffMatrixMem + idxNodeLocalStart;
 3885: 
 3886:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 3887:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 3888:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 3889:    node.numElements = idxElemEnd - idxElemStart;
 3890:    node.elements = nodeNeighElems + idxElemLocalStart;
 3891: 
 3892: 
 3893:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 3894:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3895:       const int partNode = localNodePart[idxNodeGlobal]; 
 3896:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3897: 
 3898:       Node *node_ptr = nodes[partNode] + idxNode;
 3899:       
 3900:       nodeNeighNodes[idxLocal] = node_ptr;
 3901:    }
 3902: 
 3903: 
 3904:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 3905:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3906:       const int partElem = localElemPart[idxElemGlobal];
 3907:       const int idxElem  = localElemIndices[idxElemGlobal];
 3908: 
 3909:       Element *elem_ptr = elems[partElem] + idxElem;
 3910: 
 3911:       nodeNeighElems[idxLocal] = elem_ptr;
 3912:    }      
 3913: 
 3914:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3915:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3916: 
 3917:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3918: 
 3919:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3920:    if constexpr(ics == 1) {
 3921:       node.p.x   = node_coords[i * 3];
 3922:       node.p.y   = node_coords[i * 3 + 1];
 3923:       node.gz = 0.0;
 3924: 
 3925:       if (use_ll) {                                    // <-- add
 3926:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3927:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3928:       }  
 3929: 
 3930:    } else {
 3931:       const double lon = deg2rad*node_coords[i * 3];
 3932:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3933: 
 3934:       Point3 p = computeXYZfromLatLon(lat, lon);
 3935:       node.p = toVector2(p);
 3936:       node.gz = p.z;
 3937:       node.lon = lon;
 3938:       node.lat = lat;
 3939: 
 3940:       #ifdef USE_FRAMES
 3941:       node.setFrame(lat, lon);
 3942:       #endif
 3943: 
 3944: 
 3945:    }
 3946: 
 3947:    node.depth = node_coords[i * 3 + 2];
 3948: 
 3949:    node.numSides = 0;
 3950: 
 3951:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3952:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 3953:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 3954:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 3955:    else assert(false && "populateNodes: selected nchi not implemented.");
 3956: 
 3957:    if constexpr(ivcor == 1) 
 3958:    {  
 3959:       node.kb = kb[iglobal];
 3960: 
 3961:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 3962:    }
 3963: 
 3964:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3965:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3966:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3967: 
 3968:    
 3969:    // Links the node to the boundary information
 3970:    if (isbnd[iglobal] >= 0) {
 3971:      
 3972:       // Get the index of the node boundary
 3973:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3974: 
 3975:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3976:       node.nodeBnd->node = &node;
 3977: 
 3978:       node.nodeBnd->sideBnd1 = nullptr;
 3979:       node.nodeBnd->sideBnd2 = nullptr;
 3980: 
 3981:       if (isbnd[iglobal]>=0) {
 3982: 
 3983:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 3984:          
 3985:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3986:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3987: 
 3988:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3989:          node.nodeBnd->segment->clen  = nan("1");
 3990:          node.nodeBnd->segment->carea = nan("1");
 3991: 
 3992:       }
 3993:    } else {
 3994: 
 3995:       node.nodeBnd = nullptr; // For internal nodes
 3996: 
 3997:       if (isbnd[iglobal] == landSegment) {
 3998:          node.nodeBnd = landBoundaryNode;
 3999:          node.nodeBnd->segment = landBoundarySegment;
 4000:       }
 4001:       
 4002:    }
 4003:    
 4004:    // XXXX GAUSSIAN HILL VELOCITIES
 4005:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4006:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4007:          constexpr double rot_per = 3000.0;
 4008:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4009:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4010:       // XXXXX
 4011:    #endif
 4012: 
 4013: }
 4014: 
 4015: __device__ void Mesh::populateNodes2(void) {
 4016:    NODE(node);
 4017: 
 4018: 
 4019:    // Computes the permutation of the nodes such that nodes[permutationNodesSortedByGlobalIndex[i]] are the nodes in increasing order of their global index.
 4020:    const int n = node->numNodes;
 4021:    int16_t *perm = node->permutationSortedByGlobalIndex;  
 4022:    for (int k = 0; k < n; ++k) perm[k] = k;
 4023: 
 4024:    // in-place insertion sort by global id (is fine becausen is tiny)
 4025:    for (int a = 1; a < n; ++a) {
 4026:       int16_t key = perm[a];
 4027:       int ka = a - 1;
 4028:       while (ka >= 0 &&
 4029:             node->nodes[perm[ka]]->idx > node->nodes[key]->idx) {
 4030:          perm[ka + 1] = perm[ka];
 4031:          --ka;
 4032:       }
 4033:       perm[ka + 1] = key;
 4034:    }
 4035: 
 4036:    // Finds the index of the diagonal element in the permutationSortedByGlobalIndex array.
 4037:    node->diagonalIndex = n; // n means that the diagonal element is the last one.
 4038:    for (int k = 0; k < n; ++k) {
 4039:       if (node->nodes[perm[k]]->idx > node->idx) {
 4040:          node->diagonalIndex = k - 1; // if k==0, diagonalIndex = -1, meaning that the diagonal element is the first one.
 4041:          break;
 4042:       }
 4043:    }
 4044: }
 4045: 
 4046: 
 4047: 
 4048: 
 4049: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4050:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4051:                                     double *wind_rotate_angle,   
 4052:                                     int *isdel, int *isidenode, int *isbnd,
 4053:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4054:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4055:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4056:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4057:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4058:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4059:                                     double *drag, double *roughness) {
 4060: 
 4061: 
 4062:    SIDE(pside);
 4063:    Side &side(*pside);
 4064:    const int i = idx_side;
 4065:    const int iglobal = globalSideIndices[i];
 4066:    side.idx = iglobal;  
 4067:    
 4068:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4069:    const double fc   = 2.0*omega_e*sin(sfea0);
 4070:    const double beta = 2.0*omega_e*cos(sfea0);
 4071: 
 4072:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4073: 
 4074:    // finding the pointer to the nodes that form the side
 4075:    const int idx_n1 = isidenode[iglobal*2];
 4076:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4077: 
 4078: if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4079: 
 4080:    const int locidx_n1 = localNodeIndices[idx_n1];
 4081:    const int locidx_n2 = localNodeIndices[idx_n2];
 4082:    const int part_n1 =   localNodePart[idx_n1];
 4083:    const int part_n2 =   localNodePart[idx_n2];
 4084: 
 4085: if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4086: if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4087: 
 4088:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4089:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4090: 
 4091: if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4092: 
 4093:    // Counts the number of sides connected to each node
 4094:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4095:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4096: 
 4097:    // Side boundary type
 4098:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4099:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4100: if (i == 0) printf("populateSides: 2\n");
 4101: 
 4102:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4103:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4104:    {
 4105:       bool isLand = false;
 4106:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4107:       
 4108:       if (isbs > -1) {
 4109:          // assert(isLand || isbs>=0);
 4110:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4111: 
 4112:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4113: 
 4114:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4115:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4116: 
 4117:          assert (isLand == side.sideBnd->segment->isLand);
 4118:          
 4119:          side.sideBnd->side = &side;
 4120: 
 4121:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4122:          n1bnd->linkSideBoundary(side.sideBnd);
 4123:          n2bnd->linkSideBoundary(side.sideBnd);
 4124: 
 4125:       }
 4126:       else {
 4127:          side.sideBnd = nullptr;
 4128:       }
 4129:    }
 4130:    else 
 4131:    {
 4132:       side.sideBnd = nullptr;
 4133:    }
 4134: 
 4135: if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4136: 
 4137:    // finding the pointer to the elements that share the side
 4138:    const int idx_e1 = isdel[iglobal*2];
 4139:    const int idx_e2 = isdel[iglobal*2 + 1];
 4140: 
 4141:    if (idx_e1 > -1) {
 4142:       const int locidx_e1 = localElemIndices[idx_e1];
 4143:       const int part_e1 =  localElemPart[idx_e1];
 4144:       side.elems[0] = elems[part_e1] + locidx_e1;
 4145: 
 4146:    }
 4147:    else {
 4148:       side.elems[0] = nullptr;
 4149:    }
 4150: 
 4151: if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4152: 
 4153:    if (idx_e2 > -1) {
 4154:       const int locidx_e2 = localElemIndices[idx_e2];
 4155:       const int part_e2 =  localElemPart[idx_e2];
 4156:       side.elems[1] = elems[part_e2] + locidx_e2;
 4157:    }
 4158:    else {
 4159:       side.elems[1] = nullptr;
 4160:    }
 4161: 
 4162: if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4163: 
 4164:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4165:       
 4166:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4167:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4168:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4169:          
 4170:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4171:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4172:       // printf("sideBnd: %p\n", side.sideBnd);
 4173:       // assert(false && "Side has no elements and no boundary");
 4174:    }
 4175:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4176: 
 4177:    // Compute the center of the side
 4178:    side.center = 0.5*(side.n1->p + side.n2->p);
 4179: 
 4180:    #ifdef USE_FRAMES
 4181:    side.setFrame();
 4182:    #endif
 4183: 
 4184: if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4185: 
 4186:    // Normal, unitary vector to the side
 4187:    if constexpr(ics == 1) {
 4188:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4189:       side.n = normalize(side.n);
 4190:    }
 4191:    else {
 4192:       // Unit side vector in 3D cartesian coordinates
 4193:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4194: 
 4195:       nSide = normalize(nSide);
 4196: 
 4197:       // Its cross product with the unit local z-axis vector (nUp) is the
 4198:       // normal vector we are looking for.
 4199:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4200: 
 4201:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4202:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4203:       side.n = -normalize(n2D); 
 4204: 
 4205:    }
 4206: 
 4207: if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4208: 
 4209:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4210:    side.shapiro = shapiro0;
 4211: 
 4212:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4213:    // XXXX
 4214:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4215:    constexpr double rot_per=3000.0;
 4216:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4217:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4218:    // XXXXX      
 4219:    #endif
 4220:    // Compute the z level at the center of the side
 4221:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4222:    
 4223:    // Compute the length of the side
 4224:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4225: 
 4226: if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4227: 
 4228:    // Compute the Coriolis coefficient
 4229: 
 4230:    if constexpr(ncor == -1 || ncor == 0) {
 4231:       side.coriolis = coricoef;
 4232:    }
 4233:    else {
 4234:       const double sphi = side.lat();  // Latitude at the center of the side
 4235: 
 4236:       assert(use_ll && "use_ll must be true when ncor > 0");
 4237: 
 4238:       if constexpr(ics == 1) {
 4239:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4240:       }
 4241:       else { // ics == 2
 4242:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4243:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4244:       }
 4245: 
 4246:    }
 4247: 
 4248: if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4249: 
 4250: }
 4251: 
 4252: 
 4253: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4254:    double *node_coords, double *node_coords_ll, bool use_ll,
 4255:    double *wind_rotate_angle,   
 4256:    int *isdel, int *isidenode, int *isbnd,
 4257:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4258:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4259:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4260:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4261:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4262:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4263:    double *drag, double *roughness) {
 4264: 
 4265:    ELEM(pelem);
 4266:    Element &elem(*pelem);
 4267:    const int i = idx_elem;
 4268: 
 4269:    elem.idx = i;
 4270: 
 4271:    for (int j = 0; j < i34[i]; j++) {
 4272:       const int idxNode = elnode[i*4 + j];  
 4273:       const int idxSide = elside[i*4 + j];
 4274:       
 4275:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4276:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4277: 
 4278:       // Find the neighboring element  
 4279:       if (elem.sides[j]->elems[0] == &elem) {
 4280:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4281:       }
 4282:       else {
 4283:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4284:       }
 4285:       
 4286:    }
 4287: 
 4288:    elem.i34 = i34[i];
 4289: 
 4290:    // Compute the barycenter of the element and its depth
 4291:    elem.center = {0.0, 0.0};
 4292:    elem.depth = 1e10;
 4293:    for (int j = 0; j < i34[i]; j++) {
 4294: 
 4295:       elem.center += elem.nodes[j]->p/i34[i];
 4296:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4297:    }
 4298: 
 4299:    #ifdef USE_FRAMES
 4300:    elem.setFrame();
 4301:    #endif
 4302: 
 4303:    elem.area = elem.computeSignedArea(); 
 4304:    elem.radius = sqrt(elem.area)/pi; 
 4305:    
 4306:    // Determines which way the normal vector to each side is oriented.
 4307:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4308:    for (int j = 0; j < i34[i]; j++)  
 4309:    {
 4310:       if (elem.sides[j]->elems[0] == &elem) {
 4311:          elem.ssign[j] =  1.0;
 4312:       }
 4313:       else {
 4314:          elem.ssign[j] = -1.0;
 4315:       }
 4316: 
 4317:    }
 4318: 
 4319:   
 4320: 
 4321:    // Derivatives of shape functions
 4322:    //  For ics=2, this is done in the element frame
 4323:    //  For quads, the derivative is evaluated at centroid
 4324:    for (int j = 0; j < elem.i34; j++) {
 4325:       const double area = elem.area;
 4326:       const int id2 = elem.nxq(1 + j);
 4327:       const int id3 = elem.nxq(2 + j);
 4328:       const int id4 = elem.nxq(3 + j);
 4329:       if (elem.isTri()) {
 4330:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4331:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4332:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4333:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4334:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4335:          // And so on for the other shape functions.
 4336: 
 4337:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4338:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4339:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4340: 
 4341:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4342:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4343: 
 4344:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4345: 
 4346:       }
 4347:       else  { // Quad, the derivatives are evaluated at the centroid
 4348: 
 4349:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4350:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4351:          // ...
 4352:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4353: 
 4354:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4355:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4356:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4357: 
 4358:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4359:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4360: 
 4361:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4362: 
 4363:       } // if Tri/Quad
 4364: 
 4365:    } // for j   
 4366:    
 4367:    
 4368: 
 4369: }
 4370: 
 4371: 
 4372: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4373:                                             double *emo, double *efa, 
 4374:                                             double *umo, double *ufa, 
 4375:                                             double *vmo, double *vfa,
 4376:                                             int *ifltype, int *iettype) {
 4377: 
 4378:    NODE_BND(nodeBnd);
 4379:    const int idx = idx_node_bnd;    
 4380: 
 4381:    nodeBnd->idx = idx;
 4382: 
 4383:    // Need to find the segment index and the index of the node on the segment
 4384:    int idxNode = -1;
 4385:    int iseg, i;
 4386:    for (iseg = 0; iseg < nope; iseg++) {
 4387:       // for each segment...
 4388:       for (i = 0; i < nond[iseg]; i++) {
 4389:          idxNode = iond[iseg + i*nope];
 4390:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4391:          
 4392:       }
 4393:    }
 4394: 
 4395:    assert(iseg < nope && "iseg is out of bounds");
 4396: 
 4397: found: // Jumped here when the node was found
 4398: 
 4399:    nodeBnd->isEssentialBC = true;
 4400:    nodeBnd->elbc = 0.0;
 4401: 
 4402:    nodeBnd->segment->ifltype = ifltype[iseg];
 4403:    nodeBnd->segment->iettype = iettype[iseg];
 4404: 
 4405:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4406: 
 4407:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4408: 
 4409:       nodeBnd->efa[jfr] = efa[idx2];
 4410:       nodeBnd->emo[jfr] = emo[idx2];
 4411:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4412:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4413: 
 4414:    }
 4415:         
 4416: 
 4417: }
 4418: 
 4419: __device__ void Mesh::populateBoundarySideLinks(void) {
 4420: 
 4421:    SIDE_BND(sideBnd);
 4422: 
 4423:    const Side *side = sideBnd->side;
 4424: 
 4425:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4426:    // and the rightSide is the side s that has s->n1 == side->n2
 4427:    for (int i = 0; i < mesh->nbs; i++) {
 4428: 
 4429:       Side *s = &mesh->localSideData[i];
 4430: 
 4431:       if (s == side) continue;  // Do not link the side to itself
 4432:    
 4433:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4434:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4435:    }
 4436:    
 4437: }
