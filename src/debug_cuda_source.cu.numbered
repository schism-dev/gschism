 6815: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 6816: //                     !For outflow open bnd side, estimate mass in (open
 6817: //                     !side cannot be interface side)
 6818: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 6819: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 6820: //                     endif
 6821: 
 6822: //                     cycle
 6823: //                   endif
 6824: 
 6825: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 6826: //                   iweno=.false.  !reset to upwind
 6827: //                   ibnd=isbs(jsj) !global bnd #
 6828: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 6829: //                   nwild(1:2)=0
 6830: //                   do ll=1,2 !nodes
