 3847:    __global__ void computeVerticallyIntegratedVelocity(void) {
 3848: 
 3849:       SIDE(side);
 3850: 
 3851: 
 3852:       side->U = {0.0, 0.0}; 
 3853:          
 3854:       if(side->isDry) return;
 3855: 
 3856:       const Node *node1 = side->n1;
 3857:       const Node *node2 = side->n2;
 3858: 
 3859:       // Vertically integrated velocity U (in ll if ics=2)
 3860:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 3861:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 3862:       }
 3863: 
 3864:    }
 3865: 
 3866:    __global__ void computeBottomDragVegetation(void) {
 3867:       // UNFINISHED. CHECK THIS:
 3868:       // How many kernels are needed? Why so many for loops?
 3869:       // Is the loop on sides needed?
 3870: 
 3871:       NODE(node);
 3872: 
 3873:       const int    kb      = node->kb;
 3874:       const double htot    = node->htot2();
 3875:       const double rough   = node->rough;
 3876: 
 3877: 
 3878:       if (node->isDry) {
 3879:          // Default values for dry nodes
 3880:          node->veg_alpha_vert_mean = node->veg_alpha0;
 3881:          /// XXX CHECK INDICES
 3882:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 3883:       }
 3884: 
 3885:       // Compute bottom drag Cd
 3886:       //--------------------------------
 3887: 
 3888:       // nchi = {-1, 0, 1} is the type of bottom drag.
 3889:       if (nchi==1) {
 3890: 
 3891:          bool ltmp = false; // for WBL iteration
 3892: 
 3893:          // Cdmax=-1 !max. Cd at node for this process (info only)
 3894:          // Drag at nodes
 3895:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 3896:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 3897:         
 3898:          const double rough = node->rough;
 3899:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3900:          if (node->rough == 0.0) {
 3901:             node->Cd = 0.0;
 3902: 
 3903:          } else { //roughness >0 
 3904:             
 3905:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 3906:             const double bthick = max(dzb_min, bthick_ori);
 3907: 
 3908:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 3909: 
 3910:             double tmp = 1.0/(2.5*log(bthick/rough));
 3911:             node->Cd = tmp*tmp;
 3912: 
 3913:          } // if rough
 3914: 
 3915: 
 3916:          // RECOVER THIS: XXX
 3917:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 3918:          // Output warning for WBL if iteration didn't converge
 3919: 
 3920: 
 3921:       } // nchi==1
 3922: 
 3923:       //   Bottom stress in m^2/s^2
 3924:       if (node->rho[kb + 1] >= -98.0)
 3925:       {
 3926:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 3927:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 3928:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 3929:          // !sediment erosion: this part needs more documentation
 3930:       }
 3931: 
 3932:     
 3933:       // Compute vegetation parameters
 3934:       //--------------------------------
 3935: 
 3936:       // SAV constants
 3937:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 3938:       constexpr double veg_cfpsi = 0.16;
 3939: 
 3940:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 3941:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 3942: 
 3943:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 3944:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 3945:          int kbin = 0; // bin index
 3946:          for (int k = kb; k < nvrt; k++) {
 3947:             // Computes node height above the bottom level
 3948:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 3949:             assert(false && "Vertical variation of vegetation not implemented");
 3950: 
 3951:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 3952:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 3953:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 3954:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 3955:             // } else {
 3956:             //    // Find the bin at which the current vertical level is
 3957:             //    while (kbin<nbins_veg_vert) {
 3958:             //       const double zn = node->z[kbin];
 3959:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 3960:             //          break;
 3961:             //       } // if
 3962:             //       kbin++;
 3963:             //    } // while
 3964:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 3965: 
 3966:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 3967:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 3968:                
 3969:             //    // Linear interpolation of the vegetation parameters
 3970:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 3971:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 3972:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 3973:             // } // if rl10
 3974: 
 3975:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 3976: 
 3977:          } // for k
 3978: 
 3979: 
 3980:       } else { // Ganthy (iveg=2)
 3981:       //  Modify canopy height, diameter, and density
 3982: 
 3983:          // Make sure there is vegetation on this node
 3984:          if (node->veg_h_unbent > 0.0) {
 3985:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 3986: 
 3987:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 3988:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 3989:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 3990: 
 3991:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 3992:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 3993:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 3994:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 3995:          } // if veg_h_unbent
 3996: 
 3997:          for (int k = 0; k < nvrt; k++) {
 3998:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 3999:          } // for k
 4000:       
 4001: 
 4002:       } // if iveg
 4003:      
 4004:          
 4005: 
 4006:       // Compute vertical mean of veg_alpha3D
 4007:       if (iveg != 0) {
 4008:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4009:          double sum1=0.0;
 4010:          double sum2=0.0;
 4011:          // Integrate over each level under the canopy...
 4012:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4013:             const double Dz = node->Dz(k);
 4014: 
 4015:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4016:             sum2 += Dz;
 4017: 
 4018:          } // for k
 4019: 
 4020:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4021:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4022: 
 4023:       } // if iveg
 4024: 
 4025:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4026: 
 4027:    }
 4028: 
 4029:    __global__ void computeVegetationAndDragParameters(void) {
 4030:       // Computes the vegetation and drag model parameters:
 4031:       // chi, \tilde\chi, beta, \breve{H}
 4032:       
 4033:       SIDE(side);
 4034: 
 4035:       const double htot = side->htot2();
 4036:       const int    kb   = side->kb;
 4037: 
 4038:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4039: 
 4040:       const double veg_h     = side->veg_h();
 4041:       const double veg_nv    = side->veg_nv();
 4042:       const double veg_c     = side->veg_c();
 4043:       const double veg_beta  = side->veg_beta;
 4044:       const double veg_alpha = side->veg_alpha_vert_mean();
 4045: 
 4046:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4047:       // Velocity magnitude at the bottom level
 4048:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4049:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4050:       side->chi2 = side->Cd()*vmag1;
 4051:       side->chi  = side->chi2;
 4052:       if constexpr(iveg != 0) {
 4053:          const Node *n1 = side->n1;
 4054:          const Node *n2 = side->n2;
 4055:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4056:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4057:       }
 4058: 
 4059:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4060: 
 4061:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4062:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4063:       double magUa = 0.0;
 4064:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4065:          // 3D wet side with veg...
 4066: 
 4067:          double magUa = 0.0;
 4068:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4069:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4070: 
 4071:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4072:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4073:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4074: 
 4075:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4076:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4077: 
 4078:                // Velocity magnitude at the bottom (l) of the level
 4079:                const double ul = length(side->u2[k]);
 4080: 
 4081:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4082:                magUa += Dz*0.5*(uh + ul);
 4083: 
 4084:             } // if HasVegetation
 4085:          } // for k
 4086:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4087: 
 4088:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4089:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4090:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4091:             const double zCpy = side->zTopCanopy();
 4092:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4093:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4094:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4095:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4096:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4097:          } // if isSubmerged
 4098:       } // if iveg   
 4099: 
 4100:       // Computes the friction modified depth, \breve{H} in notes
 4101:       if (side->is2D()) { // 2D
 4102: 
 4103:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4104:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4105: 
 4106:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4107: 
 4108:          side->hhat = htot*htot/fricH; 
 4109: 
 4110:       } else { // 3D
 4111:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4112: 
 4113:          if constexpr(iveg != 0) {
 4114:             
 4115:             if (side->isSubmerged()) { 
 4116:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4117:                side->hhat -= veg_c*Hhat_alpha;
 4118: 
 4119:             } else { // Emergent
 4120:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4121:             }
 4122:          } // if iveg
 4123: 
 4124:          // Enforce positivity for 3D model
 4125:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4126:       } // if 3D
 4127: 
 4128:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4129: 
 4130:         
 4131:    }
 4132: 
 4133: 
 4134: 
 4135:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4136:    // Computes the density gradient between two elements, e1 and e2.
 4137:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4138:    // zero in the direction normal to the side. 
 4139:    // 
 4140:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4141:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4142:    //
 4143:    // Input:
 4144:    //    e1: Element
 4145:    //    e2: Neighbor element (or nullptr if boundary)
 4146:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4147:    //    k: Index of the half-level at which the density is interpolated
 4148:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4149:    // 
 4150:    // Output:
 4151:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4152:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4153: 
 4154:       if (e2 == nullptr || e2->isDry) {
 4155:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4156: 
 4157:          Side *side = e1->sides[j];
 4158:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4159:                  
 4160:          if constexpr(ics == 1) {
 4161:             vec = side->n; // Normal vector to the side
 4162:          } else {
 4163:             // IMPLEMENT THIS XXXXXX
 4164:             // !replace with xel, yel?
 4165:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4166:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4167:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4168:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4169:          } //ics
 4170:                    
 4171:          diffRho = 0.0;
 4172: 
 4173:       } else { //internal and wet
 4174:          if constexpr(ics==1) {
 4175:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4176: 
 4177:             // Vector from e1 to e2
 4178:             vec = toVector2(e2->center - e1->center);
 4179: 
 4180:          } else { 
 4181:             // IMPLEMENT THIS XXXXXX
 4182:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4183:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4184:             //                   alow(j)=xctr2
 4185:             //                   bdia(j)=yctr2
 4186:          } // ics
 4187: 
 4188:          diffRho = rho2 - e1->demeanedDensity(k);
 4189:       }
 4190: 
 4191:    }
 4192: 
 4193:    __global__ void computeDensityCubicSplines(void) {
 4194:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4195: 
 4196:       ELEM(elem);
 4197: 
 4198:       if (elem->isDry) return;
 4199: 
 4200:       const int kb = elem->kb;
 4201: 
 4202:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4203:       if (elem->is2D()) {
 4204:          // In the 2D case, the density is constant at the prism level. 
 4205:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4206:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4207:       } else { //3D
 4208: 
 4209:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4210:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4211:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4212:          ///// XXXX CHECK INDICES!!!!!
 4213:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4214:       } // 2D/3D
 4215: 
 4216:    }
 4217: } // extern "C"
 4218: 
 4219: 
 4220: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4221: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4222: 
 4223:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4224: 
 4225:    const int kb  = elem->kb;
 4226:    const int kb2 = elem2->kb;
 4227: 
 4228:    // z-coordinate of prism of elem
 4229:    const double zp = elem->z_prism(k);
 4230: 
 4231:    double rho = 0.0;
 4232: 
 4233:    if (elem2->is2D()) {
 4234:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4235: 
 4236:    } else {  // 3D
 4237: 
 4238:       // eta_min may be < zmax
 4239:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4240:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4241: 
 4242:       // (Extrapolate density below bottom, we will fix it later)
 4243:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4244:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4245:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4246:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4247:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4248:    } // 2D/3D
 4249:      
 4250: 
 4251:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4252:    // Now we need to fix it.
 4253:    if (elem->z[k] < elem2->z[kb2]) {
 4254:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4255: 
 4256:       // There are two methods to adjust the density at the bottom of the element.
 4257:       // iunder_deep=0: 
 4258:       const double depth1 = abs(elem->z[kb]); // larger depth
 4259: 
 4260:       if (iunder_deep==0) {
 4261: 
 4262:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4263: 
 4264:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4265: 
 4266:       } else { // iunder_deep != 0
 4267: 
 4268:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4269: 
 4270:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4271: 
 4272:          //   Demeaned density at the same z coordinate as
 4273:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4274:          }
 4275: 
 4276:       } // if iunder_deep
 4277:    } // if elem->z[kb] < elem2->z[kb]
 4278: 
 4279:    return rho;
 4280: }
 4281: 
 4282: 
 4283: extern "C" {
 4284:    __global__ void computeDensityGradient(void) {
 4285: 
 4286:          // Compute the horizontal density gradient at each element.
 4287:       // It works in two steps:
 4288:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4289:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4290:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4291:       //             gradRho.r1 = rho1 - rho0
 4292:       //             gradRho.r2 = rho2 - rho0
 4293:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4294:       // 
 4295:       //  NOTE: We use de-meaned densities.
 4296: 
 4297:       ELEM(elem);
 4298: 
 4299:       if (elem->isDry) return;
 4300: 
 4301:       const int kb  = elem->kb;
 4302:       const int i34 = elem->i34;
 4303: 
 4304:       for (int k = kb + 1; k < nvrt; k++) {
 4305:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4306:          //             gradRho.r1 = rho1 - rho0
 4307:          //             gradRho.r2 = rho2 - rho0
 4308:          int icount = 0;
 4309:          double sumRx = 0.0;
 4310:          double sumRy = 0.0;
 4311:          for (int j1=0; j1<i34; j1++) { 
 4312: 
 4313:             const int j2 = elem->nxq(j1 + 1);
 4314: 
 4315:             // Pairs of consecutive neighbor elements of elem
 4316:             const Element *e1 = elem->nghbElems[j1];
 4317:             const Element *e2 = elem->nghbElems[j2];
 4318: 
 4319:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4320:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4321:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4322: 
 4323:             // Compute the density difference and the vector from elem to e1 and e2
 4324:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4325:             double diffRho1, diffRho2;
 4326:             Vector2 vec1, vec2;
 4327:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4328:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4329: 
 4330:             const double rl1 = length(vec1);
 4331:             const double rl2 = length(vec2);
 4332:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4333: 
 4334:             const double delta = cross(vec1, vec2);
 4335:             const double sintheta = abs(delta)/(rl1*rl2);
 4336: 
 4337:             // To avoid problems, avoid elements with small angle between vectors
 4338:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4339:             const bool validEq = (sintheta > sin_one_deg);
 4340: 
 4341:             if (validEq) {
 4342:                // Solve the system of equations to get the density gradient at elem
 4343:                icount++;
 4344:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4345:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4346:                sumRx += Rx;
 4347:                sumRy += Ry;
 4348:             }
 4349:          } // for j1
 4350: 
 4351:          // Compute the average density gradient at elem
 4352:          if (icount==0) {
 4353:            // Bad mesh quality; bail out with 0 b-cc
 4354:            elem->gradRho[k] = {0.0, 0.0};
 4355:          } else {
 4356:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4357:          }
 4358: 
 4359:       } // for k
 4360: 
 4361:    }
 4362: 
 4363:    __global__ void computeBaroclinicTerm(void) {
 4364:    // Computes the baroclinic term at sides (at half levels).
 4365:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4366:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4367: 
 4368:       SIDE(side);
 4369: 
 4370:       if (side->isDry) return;
 4371: 
 4372:       const Element *e1 = side->elems[0];
 4373:       const Element *e2 = side->elems[1];      
 4374:       const int kb = side->kb;
 4375:       
 4376:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4377: 
 4378:       // interpolates vertically the density gradient of the two elements at the half level/
 4379: 
 4380:       // Starts the integration at the surface and goes down to the bottom
 4381:       int k1 = nvrt - 1;
 4382:       int k2 = nvrt - 1;
 4383: 
 4384:       side->bcc[nvrt-1] = {0.0, 0.0};
 4385:       for (int k = nvrt-1; k >= kb; k--) {
 4386:       // For each prism level (from surface to bottom)...
 4387: 
 4388:          // For both elements, interpolate density gradient at the side's half level.
 4389:          // The gradient at the side is the average of the gradients at the elements.
 4390:          // w1, w2 are used to take into account boundary sides, with just one element.
 4391:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4392:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4393:          const double wsum = w1 + w2;
 4394:          w1 = w1/wsum;
 4395:          w2 = w2/wsum;
 4396:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4397: 
 4398:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4399:          Vector2 gradRho = {0.0, 0.0};
 4400:          if (e1 != nullptr && k > kb) {
 4401:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4402:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4403:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4404:             
 4405:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4406:          }      
 4407:          if (e2 != nullptr && k > kb) {
 4408:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4409:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4410:             
 4411:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4412:          }
 4413: 
 4414:          if constexpr(ics==2) {
 4415:             // IMPLEMENT THIS XXXXXX
 4416:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4417:             // swild(1)=tmp1
 4418:             // swild(2)=tmp2
 4419:          }
 4420:          
 4421:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4422:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4423:          // CHECK INDICES!!! XXX
 4424:          const double grav3 = side->grav3();
 4425:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4426:       } // for
 4427: 
 4428:    }
 4429: 
 4430: 
 4431: 
 4432:    __global__ void computeHorGradientAtSide(void) {
 4433: 
 4434:       // Compute the horizontal density gradient at each element.
 4435:       // It works in two steps:
 4436:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4437:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4438:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4439:       //             gradRho.r1 = rho1 - rho0
 4440:       //             gradRho.r2 = rho2 - rho0
 4441:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4442:       // 
 4443:       //  NOTE: We use de-meaned densities.
 4444: 
 4445:       SIDE(side);
 4446: 
 4447:       if (side->isDry) return;
 4448: 
 4449:       // Computes the gradient of the variables at the side center.
 4450:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4451:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4452:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4453: 
 4454:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4455:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4456:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4457:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4458: 
 4459: 
 4460:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4461:          side->gradEta1.x, side->gradEta1.y, 
 4462:          side->gradEta2.x, side->gradEta2.y, 
 4463:          side->gradETP.x, side->gradETP.y, 
 4464:          side->gradPr.x, side->gradPr.y);
 4465: 
 4466: 
 4467:    }
 4468: 
 4469: 
 4470:    __global__ void solveMomentumEquations(double time) {
 4471: 
 4472:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4473:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4474: 
 4475:       SIDE(side);
 4476: 
 4477:       if (side->isDry) 
 4478:       {
 4479:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4480: 
 4481:          return;
 4482:       }
 4483: 
 4484:       const Node *n1 = side->n1;
 4485:       const Node *n2 = side->n2;
 4486: 
 4487:       const int kb = side->kb;
 4488: 
 4489:       const double veg_h = side->veg_h();
 4490:       const double grav3 = side->grav3();
 4491: 
 4492: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4493:       if (side->is2D()) {
 4494:          // Warning: Do not use htot2, which is updated.
 4495:          const double htot = side->htot1();
 4496:          const double hhat = side->hhat;
 4497: 
 4498:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4499: 
 4500:          Vector2 tau2 = {0.0, 0.0};
 4501:           
 4502:          if constexpr(ics==1) {
 4503:             tau2 = side->tau();
 4504: 
 4505:          } else {
 4506:             assert(false && "Not implemented: ics == 2");
 4507:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4508:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4509:             // taux2=(vn1+tt1)*0.5d0
 4510:             // tauy2=(vn2+ss1)*0.5d0
 4511:          } // if ics         
 4512: 
 4513:          // hat_gam has units of m/s
 4514: 
 4515:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4516: 
 4517:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4518:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4519: 
 4520:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4521: 
 4522:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4523:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4524: 
 4525:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4526: 
 4527: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y);
 4528: 
 4529:       }
 4530:       else { // 3D
 4531: 
 4532:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4533:          // 
 4534:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4535:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4536:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4537:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4538:          // k+1 and k.
 4539: 
 4540: 
 4541:          // // Define layer thickness & viscosity
 4542:          // for (int k=kb + 1; k<nvrt; k++) {
 4543:          //    const double dzz = side->Dz(k - 1);
 4544: 
 4545:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4546: 
 4547:          //    // Vertical viscosity at the face center
 4548:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4549:         
 4550:          // }
 4551: 
 4552: 
 4553:          const int ndim = nvrt - kb;
 4554:          const double zTopCanopy = side->zTopCanopy();
 4555: 
 4556:          // Initialize the tridiagonal system
 4557:          for (int k = kb + 1; k<nvrt; k++) {
 4558:             
 4559:             const int kin = k - kb;
 4560: 
 4561:             // Vertical viscosity at the face center
 4562:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4563:             const double dzz = side->Dz(k);
 4564: 
 4565:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 4566:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 4567:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4568: 
 4569:             alow[kin] = 0.0;
 4570:             cupp[kin] = 0.0;
 4571:             bdia[kin] = 0.0;
 4572: 
 4573:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4574:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4575: 
 4576:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4577:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4578:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4579: 
 4580:             // First part: layers k, k+1
 4581:             if (k < nvrt - 1) {
 4582:                              
 4583:                if constexpr(iveg != 0) {
 4584: 
 4585:                   // If there is vegetation at this level...
 4586:                   if (zTopCanopy > side->zc[k]) {
 4587:                      // If the canopy is above the k layer...
 4588:                      
 4589:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4590:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4591:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4592:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4593: 
 4594:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4595:                      const double vmag2 = length(ut2);
 4596:                      const double vmag1 = length(side->u2[k]);
 4597:                      const double vmag = 0.5*(vmag1 + vmag2);
 4598:                      
 4599:                      // Computes the vegetation alpha at the face center
 4600:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4601: 
 4602:                      cff1 += veg_alpha_sd*dt*vmag;
 4603: 
 4604:                   } // if (zTopCanopy
 4605:                } // if iveg
 4606: 
 4607:                const double tmp = dt*dfz/dzz;
 4608:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4609:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4610: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 4611:             }
 4612: 
 4613: 
 4614:             // Second part: layers k-1, k
 4615:             if (k > kb + 1) {
 4616: 
 4617:                double cff1 = 1.0; //init \bar{c^k}
 4618: 
 4619:                if constexpr(iveg != 0) {
 4620:                   // If there is vegetation at this level...
 4621:                   if (zTopCanopy > side->zc[k-1]) {
 4622:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4623:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4624: 
 4625:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4626: 
 4627:                      const double vmag2 = length(ut2);
 4628:                      const double vmag1 = length(side->u2[k-1]);
 4629:                      const double vmag = 0.5*(vmag1 + vmag2);
 4630: 
 4631:                      // Computes the vegetation alpha at the face center
 4632:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4633:                      cff1 += veg_alpha_sd*dt*vmag;
 4634:                   } // if zTopCanopy
 4635: 
 4636:                } // if iveg
 4637: 
 4638:                const double tmp = dt*dfz/dzz;
 4639:                alow[kin] += cff1*dzz/6.0 - tmp;
 4640:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4641: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 4642:             } else { // Bottom boundary
 4643:                // This occurs at the bottom, where the bottom drag is applied.
 4644: 
 4645:                bdia[kin] += dt*side->chi2;
 4646: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 4647:             } // if (k > kb + 1)
 4648: 
 4649: 
 4650: 
 4651:          } // for (int k
 4652: 
 4653: 
 4654: 
 4655:          // Computes the RHS.
 4656:          // -----------------
 4657: 
 4658:          //	BC to be imposed at the end.
 4659: 
 4660:          const Vector2 gradETP  = side->gradETP;
 4661:          const Vector2 gradPr   = side->gradPr;
 4662:          const Vector2 gradEta1 = side->gradEta1;
 4663:          const Vector2 gradEta2 = side->gradEta2;
 4664: 
 4665:          const Vector2 *btu = side->btu;
 4666:          const Vector2 *u2  = side->u2;
 4667:          const double coriolis = side->coriolis;
 4668:          const Vector2 *d2uv = side->d2uv;
 4669: 
 4670: 
 4671:          for (int k = kb + 1; k<nvrt; k++) {
 4672:             const int kin = k - kb;
 4673: 
 4674:             const double dz_0 = side->Dz(k);
 4675:             const double dz_1 = side->Dz(k+1);  
 4676: 
 4677:             rrhs[kin] = {0.0, 0.0};
 4678:             double dz = 0.0;
 4679: 
 4680:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 4681:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 4682:             if (k < nvrt  ) dz += 0.5*dz_1;
 4683:             if (k > kb + 1) dz += 0.5*dz_0;
 4684: 
 4685:             // Elevation gradient, atmospheric pressure and tidal potential
 4686:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 4687: 
 4688:             // Coriolis, advection, wind stress, and horizontal viscosity
 4689:             if (k < nvrt - 1) {
 4690: 
 4691: 
 4692:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 4693:                                           (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 4694:                                           dt*(2.0*d2uv[k] + d2uv[k + 1]));
 4695: 
 4696:                //diff stress tensors 1006
 4697:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 4698:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 4699:                   assert(false && "Not implemented: itur == 5");
 4700:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 4701:                }
 4702: 
 4703:             } else { // k=nvrt
 4704:                Vector2 tau2 = {0.0, 0.0};
 4705:                if constexpr(ics==1) {
 4706:                   tau2 = side->tau();
 4707:                } else {
 4708:                   assert(false && "Not implemented: ics == 2");
 4709:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4710:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4711:                   // taux2=(vn1+tt1)*0.5d0
 4712:                   // tauy2=(vn2+ss1)*0.5d0
 4713:                } // if ics
 4714: 
 4715:                rrhs[kin] += dt*tau2;
 4716: 
 4717:             } // if k<nvrt
 4718: 
 4719:             if (k > kb + 1) {
 4720:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k - 1] + 
 4721:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 4722:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 4723: 
 4724: 
 4725:                // diff stress tensors 1006
 4726:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 4727:                   assert(false && "Not implemented: itur == 5");
 4728:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 4729:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 4730:                }
 4731: 
 4732:             } // if k>kbs + 1
 4733: 
 4734:             // Baroclinic
 4735:             Vector2 *bcc = side->bcc;
 4736:             if constexpr(ibc == 0) {
 4737:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 4738:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 4739: 
 4740:             } // if ibc==0
 4741: 
 4742: 
 4743:          } // k=kb + 1,nvrt
 4744: 
 4745:    printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 4746:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4747:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 4748: 
 4749:          for (int k=kb + 1; k<nvrt; k++) {
 4750:             const int kin = k - kb;
 4751: 
 4752:             // Velocity is always clamped to maximum values
 4753:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 4754:          } // k
 4755: 
 4756:       } // if side->is2D()
 4757:       
 4758: 
 4759:       // Impose velocity boundary conditions at the bottom
 4760:       if constexpr(imm == 2) { //no slip
 4761:          double dep;
 4762:          Vector2 vel;
 4763: 
 4764:          assert(false && "Not implemented: imm == 2");
 4765:          //update_bdef(time, x0, y0, dep, vel);
 4766:          // side->u2[kb] = vel;
 4767: 
 4768:       } else {
 4769:          if (side->Cd() == 0.0) {
 4770:             side->u2[kb] = side->u2[kb + 1];
 4771:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 4772:             side->u2[kb] = {0.0, 0.0};
 4773:          }
 4774:           
 4775:       } // if imm
 4776: 
 4777:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4778:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 4779:       
 4780: 
 4781:    }
 4782: 
 4783: 
 4784:    __device__ void applyMomentumBC(void) {
 4785: 
 4786:       SIDE_BND(side_bnd);
 4787: 
 4788:       Side *side = side_bnd->side;
 4789:       const BoundarySegment *segment = side_bnd->segment;
 4790:       const Node *n1 = side->n1;
 4791:       const Node *n2 = side->n2;
 4792: 
 4793:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 4794:       const bool isLand     = (segment == (BoundarySegment *)landSegment);
 4795:       const bool isInternal = (segment == (BoundarySegment *)internalSegment);
 4796: 
 4797:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 4798:       const int kb = side->kb;
 4799: 
 4800:       if (!isLand && segment->ifltype != 0) {
 4801:          const Vector2 *uth = side->uth;
 4802: 
 4803:          for (int k=kb; k < nvrt; k++) {
 4804:             assert(segment->ifltype == -2 || (uth[k].x >= -98 && uth[k].y >= -98) && "Momentum BC: Side has no velocity boundary conditions");
 4805: 
 4806:             Vector2 uth = side->uth[k];
 4807: 
 4808:             if (segment->ifltype == -1) {
 4809:                // Flather 1
 4810: 
 4811:                const double depth = side->depth();
 4812: 
 4813:                assert(n1->nodeBnd->eta_mean >= -98 && n2->nodeBnd->eta_mean >= -98 && "Flather bnd elevation not assigned");
 4814:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 4815: 
 4816:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->etaMeanBnd()) + dot(uth, side->n);
 4817: 
 4818:                side->u2[k] = vnorm*side->n;
 4819: 
 4820:             } else if (segment->ifltype == -2) { // Discharge
 4821: 
 4822: 
 4823:                const double eta1 = side->eta1();
 4824:                const double eta2 = side->eta2();
 4825:                const double htot = side->htot2();
 4826: 
 4827:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 4828:                assert(false && "Not implemented: Discharge bc");
 4829:                // const double dischrg = discharge(eta1);
 4830:                const double dischrg = 0.0; // XXX REMOVE
 4831:                
 4832: 
 4833:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 4834: 
 4835:                const double vnorm = dischrg*eta2/htot;
 4836: 
 4837:                side->u2[k] = vnorm*side->n;
 4838: 
 4839: 
 4840:             }
 4841:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 4842:                const double vnorm = dot(side->u2[k], side->n);
 4843: 
 4844:                double rat;
 4845:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 4846:                else              rat = segment->vobc2; // outgoing
 4847: 
 4848:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*uth;
 4849:             }
 4850:             else { // not Flather or 3D radiation
 4851:                side->u2[k] = uth;
 4852: 
 4853:             } // if (segment->ifltype...
 4854: 
 4855:          }
 4856: 
 4857:       }
 4858:       else if (isLand) { // land bnd
 4859:          if constexpr(islip == 0) { // free slip
 4860:             for (int k=kb; k < nvrt; k++) {
 4861:                double vnorm = 0.0; // for most cases
 4862:                const double vtan = dot(side->u2[k], side->t());
 4863:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 4864:             }
 4865: 
 4866:          } else { // no slip
 4867:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 4868: 
 4869:          }
 4870:       } // if (side segment type...
 4871: 
 4872:       
 4873: 
 4874: 
 4875: 
 4876:    }
 4877: 
 4878: 
 4879:    __device__ void shapiroFilter1(void) {
 4880:       // First step of the Shapiro filter (normally used if indvel<=0)
 4881:       // Computes the filtered values and stores them in bcc (as a temporary array).
 4882: 
 4883:       if constexpr(ishapiro == 0) return;
 4884: 
 4885:       SIDE(side);
 4886: 
 4887:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4888: 
 4889:       if (side->isDry || isInternal ) return;
 4890: 
 4891:       const int kb = side->kb;
 4892: 
 4893:       for (int mm = 1; mm <= niter_shap; mm++) {
 4894: 
 4895: 
 4896:          // Internal wet sides
 4897:          for (int k = kb + 1; k < nvrt; k++) {
 4898:             // WARNING: reusing bcc as a temporary array to store the suru values.
 4899:             side->bcc[k] = {0.0, 0.0};
 4900:             Vector2 suru = {0.0, 0.0};
 4901: 
 4902:             for (int j=0; j<4; j++) {
 4903: 
 4904:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 4905:                
 4906:                int kin = k;
 4907:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 4908:                
 4909:                if constexpr(ics==1) {
 4910:                   suru += side->u2[kin];
 4911:                } else {
 4912:                   assert(false && "Not implemented: ics == 2");
 4913:                   // Vector2 vn1, vn2;
 4914:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 4915:                   // suru=suru+vn1;
 4916:                   // surv=surv+vn2;
 4917:                }
 4918:             }
 4919: 
 4920:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 4921: 
 4922:          }
 4923:       }
 4924:    }
 4925: 
 4926:    __device__ void shapiroFilter2(void) {
 4927:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 4928: 
 4929:       if constexpr(ishapiro == 0) return;
 4930: 
 4931:       SIDE(side);
 4932: 
 4933:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 4934: 
 4935:       if (side->isDry || isInternal ) return;
 4936: 
 4937:       const int kb = side->kb;
 4938: 
 4939:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 4940: 
 4941:       if (side->is2D()) {
 4942:          side->u2[kb] = side->u2[nvrt - 1];
 4943:          
 4944:       } else {
 4945:          // 3D
 4946:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 4947:          
 4948:       }
 4949: 
 4950:    }
 4951: 
 4952: 
 4953:    __global__ void ul0UpdateZCoords(void) {
 4954:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 4955:       
 4956:       NODE(node);      
 4957: 
 4958:       if (node->isDry2()) { 
 4959: 
 4960:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 4961: 
 4962:          if constexpr(ivcor != 1) node->kb = 0;
 4963: 
 4964:       } else {
 4965: 
 4966:          node->updateKb();
 4967:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 4968: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 4969: 
 4970:       } // if wet or dry
 4971: 
 4972:       // We use the temp.b field to store the previous state of isDry.
 4973:       node->tmp.b = node->isDry;
 4974: 
 4975:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 4976:       node->isDry = true;
 4977: 
 4978:    }
 4979: 
 4980:    __global__ void ul0ComputeDryElementsAndNodes(void)
 4981:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 4982:    {
 4983:       ELEM(elem);
 4984: 
 4985:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 4986: 
 4987:       // All the nodes of a wet element are wet.
 4988:       if (!elem->isDry) {
 4989:          elem->nodes[0]->isDry = false;
 4990:          elem->nodes[1]->isDry = false;
 4991:          elem->nodes[2]->isDry = false;
 4992:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 4993: 
 4994:       }
 4995: 
 4996: 
 4997:       elem->kb = 0;
 4998: 
 4999:       if (elem->isDry) return;
 5000: 
 5001:       // Wet
 5002:       const Node *n1 = elem->nodes[0];
 5003:       const Node *n2 = elem->nodes[1];
 5004:       const Node *n3 = elem->nodes[2];  
 5005:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5006: 
 5007:    //    if(elem->isDry2()) {
 5008:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5009:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5010:    //        call parallel_abort(errmsg)
 5011:    //    }
 5012: 
 5013: 
 5014:       // Computes element's kb as the minimum of the nodes' kb.
 5015:       const int kb1 = n1->kb;
 5016:       const int kb2 = n2->kb;
 5017:       const int kb3 = n3->kb;
 5018:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5019: 
 5020: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5021: 
 5022:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5023: 
 5024: 
 5025:       // Computes the element z as the mean of the nodes z.
 5026:       for (int k = elem->kb; k < nvrt; k++) {
 5027: 
 5028:          // Compute the element z as the mean of the nodes z.
 5029:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5030:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5031:          elem->z[k] /= elem->i34;
 5032: 
 5033:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5034:       }
 5035:                   
 5036:    }
 5037: 
 5038:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5039:    {
 5040:       NODE(node);
 5041:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5042: 
 5043:       if (it == iths) return;
 5044: 
 5045: 
 5046:       if(!node->isDry && node->tmp.b) { // rewetted
 5047:          for (int k=0; k < nvrt; k++) {
 5048: 
 5049:             Vector3 utmp={0.0, 0.0, 0.0};
 5050: 
 5051:             double ttmp=0.0;
 5052:             double stmp=0.0;
 5053:             int icount=0;
 5054:             for (int j = 0; j < node->numNodes; j++) {
 5055: 
 5056: 
 5057:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5058:                if (!node->isDry) { // all indices extended
 5059:                   icount++;
 5060: 
 5061:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5062:                   utmp += node->u2[k];
 5063:                   
 5064:                   ttmp += node->tracers[k].tracer[0]; 
 5065:                   stmp += node->tracers[k].tracer[1]; 
 5066:                }
 5067:             }
 5068: 
 5069:             if(icount > 0) {
 5070:                const double inv_icount = 1.0/icount;
 5071:                node->u2[k]     = inv_icount*utmp;
 5072:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5073:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5074:             }
 5075:          }
 5076:       }
 5077:    }
 5078: 
 5079: 
 5080:    __global__ void ul0UpdateSides(int it, int iths) {
 5081: 
 5082:       SIDE(side);
 5083: 
 5084:       // A side is wet if and only if at least one of its elements is wet.
 5085:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5086: 
 5087:       const Node *n1 = side->n1;
 5088:       const Node *n2 = side->n2;
 5089:       const int kb1 = n1->kb;
 5090:       const int kb2 = n2->kb;
 5091: 
 5092:       side->kb = 0; // dry
 5093: 
 5094:       if (isWet) {
 5095: 
 5096:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5097: 
 5098:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5099: 
 5100:          side->kb = min(kb1, kb2);
 5101: 
 5102:          for (int k = side->kb; k < nvrt; k++) {
 5103:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5104: 
 5105:          
 5106:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5107: 
 5108:             // Compute velocity for re-wetted sides 
 5109:             if ((it != iths) && (side->isDry && isWet)) {
 5110:             
 5111:                Vector2 utmp={0.0, 0.0};
 5112: 
 5113:                int icount=0;
 5114: 
 5115:                // For all the sides on the two elements that share this side
 5116:                for (int j=0; j < 2; j++) {
 5117:                   const Element *elem = side->elems[j];
 5118:                   if (elem == nullptr) continue;
 5119: 
 5120:                   for (int jj=0; jj < elem->i34; jj++) {
 5121:                      const Side *nSide = elem->sides[jj];
 5122:                      if (nSide->isDry) continue;
 5123: 
 5124:                      icount++;
 5125:                      utmp += nSide->u2[k];                     
 5126:                   }
 5127:                }
 5128:                   
 5129:                assert(icount > 0 && "No wet sides around this side");
 5130:                if (icount > 0)  side->u2[k] = utmp/icount;
 5131:                   
 5132:             } // if ((it != iths) && (side->isDry && isWet))
 5133: 
 5134:          } // for k
 5135: 
 5136:       } // if isWet
 5137:    
 5138:       side->isDry = !isWet;
 5139: 
 5140:    }
 5141: 
 5142: 
 5143:    __global__ void zeroNodalVelocities(void) {
 5144:       NODE(node);
 5145: 
 5146:       for (int k = 0; k < nvrt; k++) {
 5147:          node->u2[k] = {0.0, 0.0, 0.0};
 5148:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5149:       }
 5150:    }
 5151: 
 5152:    __global__ void computeNodalVerticalVelocities1(void) {
 5153:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5154:    // Adds the element's vertical velocity times the element's area.
 5155:       ELEM(elem);
 5156: 
 5157:       for (int j = 0; j < elem->i34; j++) {
 5158:          Node *node = elem->nodes[j];
 5159: 
 5160:          for (int k = node->kb; k < nvrt; k++) {
 5161:             node->u2[k].z += elem->w[k]*elem->area;
 5162:             node->tmp.d += elem->area;
 5163:          }
 5164:       }
 5165:    }
 5166: 
 5167:    __global__ void computeNodalVerticalVelocities2(void) {
 5168:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5169:    // Divides by the total area of the elements sharing the    node.
 5170:       ELEM(elem);
 5171: 
 5172:       for (int j = 0; j < elem->i34; j++) {
 5173:          Node *node = elem->nodes[j];
 5174: 
 5175:          for (int k = node->kb; k < nvrt; k++) node->u2[k].z /= node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5176:       }
 5177:    }
 5178: 
 5179:    __global__ void computeNodalHorizontalVelocities(void) {
 5180:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5181:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5182:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5183: 
 5184:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5185: 
 5186:       SIDE(side);
 5187: 
 5188:       const int kb = side->kb;
 5189: 
 5190:       Node *n1 = side->n1;
 5191:       Node *n2 = side->n2;
 5192: 
 5193:       for (int k = kb; k < nvrt; k++) {
 5194: 
 5195:          // Cast the u2 vector into a Vector2 
 5196:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5197:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5198: 
 5199:          n1_u2 += side->u2[k]/n1->numSides;
 5200:          n2_u2 += side->u2[k]/n2->numSides;
 5201: 
 5202:       }
 5203: 
 5204: 
 5205:    }
 5206: 
 5207:    __global__ void resetVelocityOpenBndNodes(void) {
 5208:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5209: 
 5210:       NODE_BND(nodebnd);
 5211: 
 5212:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5213:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5214:       }
 5215: 
 5216:    }
 5217: 
 5218: 
 5219:    __global__ void setVelocityOpenBndNodes(void) {
 5220:    // For open boundary nodes sets their velocity to the imposed values.
 5221: 
 5222:       SIDE_BND(sidebnd);
 5223: 
 5224:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5225:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5226:          // to its segment to the average of the side velocity.
 5227: 
 5228:          for (int k = 0; k < nvrt; k++) {
 5229:             Node *n1 = sidebnd->side->n1;
 5230:             Node *n2 = sidebnd->side->n2;
 5231: 
 5232:             // Cast the u2 vector into a Vector2 
 5233:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5234:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5235: 
 5236:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5237:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5238:          }
 5239:       }
 5240: 
 5241:    }
 5242: 
