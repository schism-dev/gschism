 1124: // This struct is used to store the boundary information for a node.
 1125: struct NodeBoundary {   
 1126:    int idx;
 1127:    BoundarySegment *segment;
 1128:    Node *node;
 1129:    
 1130:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1131:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1132: 
 1133:    bool isLand;
 1134: 
 1135:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1136:    double elbc;   // Elevation boundary condition
 1137:    double eth;    // Elevation time history
 1138: 
 1139:    double eta_mean; // Mean elevation at nodes
 1140: 
 1141:    bool isEssentialBC;
 1142: 
 1143:    Vector2 uth[nvrt];  // "Time history" velocity
 1144: 
 1145:    // Arrays for harmonic constituents (if needed)
 1146:    double  emo[nbfr];  // Elevation amplitude
 1147:    double  efa[nbfr];  // Elevation phase
 1148:    Vector2 umo[nbfr];  // velocity amplitude
 1149:    Vector2 ufa[nbfr];  // velocity phase
 1150: 
 1151: 
 1152:    NodeBoundary(void) {
 1153:       isLand = false;
 1154:    }
 1155:    NodeBoundary(bool _isLand) {
 1156:       isLand = _isLand;
 1157:    }
 1158: 
 1159:    
 1160:    __forceinline__ __device__ int numSidesForAverage() const {
 1161:    // Returns the number of sides that are connected to the node and have the same segment.
 1162:    // This is used to compute the average velocity at the node for open boundary nodes.
 1163:       int res = 0;
 1164:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1165:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1166: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1167:       return res;
 1168:    }
 1169: 
 1170: 
 1171:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1172:       assert(index == 0 || index == 1); 
 1173:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1174:    }
 1175: 
 1176: 
 1177: };
 1178: 
 1179: struct Node {
 1180: 
 1181:    // Geometry information
 1182:    int idx;        // Index of the node
 1183:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1184:    int numNodes;   // Number of nodes neighbors of this node
 1185: 
 1186:    Element **elements; // Array of pointers to the elements that share this node
 1187:    int numElements;    // Number of elements that share this node
 1188: 
 1189:    int numSides;       // Number of sides that are connected to this node
 1190: 
 1191:    Point2 p;
 1192:    Vector2 u2[nvrt];
 1193:    double  w2[nvrt];
 1194:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1195:    double z[nvrt];
 1196:    double lon, lat;
 1197:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1198:    double depth;
 1199: 
 1200:    int kb;       // Bottom index of the node
 1201: 
 1202:    bool isDry;     // True if the node is dry
 1203: 
 1204:    int iadv;     // Advection flag
 1205: 
 1206:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1207:                           // this is nullptr
 1208: 
 1209:    TempVar tmp; // Temporary variable to store different types of variables
 1210: 
 1211:    // Physical information
 1212:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1213:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1214: 
 1215:    double rho[nvrt];     // Density
 1216:    double dfv[nvrt];     // Vertical viscosity
 1217: 
 1218:    double eta1; // Elevation at nodes at previous timestep
 1219:    double eta2; // Elevation at nodes at current timestep
 1220: 
 1221:    double ETP;  // Earth Tidal Potential
 1222: 
 1223:    double pr;    // Air pressure
 1224:    double grav2; // Gravity 
 1225:    
 1226:    Vector2 dav;  // Depth averaged velocity
 1227: 
 1228:    Vector2 tau; // Wind stress vector
 1229: 
 1230:    // Vegetation parameters
 1231:    double veg_h;
 1232:    double veg_nv;
 1233:    double veg_di;
 1234:    double veg_Cd;
 1235:    double veg_h_unbent;
 1236:    double veg_di_unbent;
 1237:    double veg_nv_unbent;
 1238:    double veg_alpha_vert_mean;
 1239:    double veg_alpha0;
 1240:    double veg_alpha3D[nvrt];
 1241: 
 1242:    // Bottom drag parameters
 1243:    double Cd;       // Bottom drag coefficient   
 1244: 
 1245:    // These three are mutually exclusive
 1246:    union {
 1247:       double rmanning; // Bottom Manning's coefficient
 1248:       double rough;    // Bottom roughness length
 1249:       double drag;     // Bottom drag coefficient
 1250:    };
 1251:    Vector2 tau_bot; // Bottom stress vector
 1252: 
 1253:    double bdef1; // Bottom deformation at previous timestep
 1254:    double bdef2; // Bottom deformation at current timestep
 1255: 
 1256:    double qel; // RHS
 1257:    double coeffDiag; // Diagonal coefficient of the matrix
 1258:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1259: 
 1260:    double mP; // Search direction for conjugate gradient method
 1261:    double mR; // Residual for conjugate gradient method
 1262:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1263:    double mX; // Solution for conjugate gradient method
 1264: 
 1265:    // Meteorological forcing
 1266:    Vector2 u_air;
 1267:    double p_air;
 1268:    double t_air;
 1269:    double q_air;
 1270:    double wind_angle;  // Wind rotation angle
 1271: 
 1272:    __device__ void setWind(Vector2 &u) {
 1273:    // Sets the wind vector taking into account the wind rotation angle
 1274:    
 1275:       const double dir = atan2(-u.x,-u.y);
 1276:       const double speed = length(u);
 1277: 
 1278:       // Calculate new u and v components with added rotation angle
 1279:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1280:    }
 1281: 
 1282: 
 1283:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1284: 
 1285:    __device__ double sigmaTransitionDepth(void) const;
 1286: 
 1287:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1288:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1289:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1290:    
 1291:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1292: 
 1293:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1294: 
 1295:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1296:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1297: 
 1298:    __device__ void clearMatrixRow(void) {
 1299:       // Clear the matrix row for this node
 1300:       coeffDiag = 0.0;
 1301:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1302: 
 1303:    }
 1304: 
 1305:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1306:       // Add the value to the sparse matrix for this node
 1307:       
 1308:       if (node == this) {
 1309:          coeffDiag += value;
 1310:      
 1311:       } else {
 1312:          // Search (linearly)the index of the node in the array of nodes
 1313:          // XXX: This is not efficient, see if we can improve this
 1314:          int i;
 1315:          for (i = 0; i < numNodes; i++) {
 1316:             if (nodes[i] == node) {
 1317:                break;
 1318:             }
 1319:          }
 1320:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1321:          coeffMatrix[i] += value;
 1322:       }
 1323:    }
 1324: 
 1325: 
 1326:    __device__ __inline__ void updateZCoordData(void);
 1327: 
 1328:    __device__ double compZCoord(int k) const;
 1329: 
 1330:    __device__ void updateKb(void);
 1331: 
 1332:    __device__ __forceinline__ void computeBottomDragCd(void);
 1333: 
 1334: 
 1335: 
 1336: };
