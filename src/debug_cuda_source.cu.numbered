  701:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  702:       // Check if the point (xt,yt) is inside the element
  703:       double shpCoords[4];
  704: 
  705:       bool res = computeShapeCoords(xt, shpCoords, false);
  706: 
  707:       return res;
  708:    }
  709: 
  710:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  711:       // Check if the point (xt,yt) is inside the element
  712:       double shpCoords[4];
  713: 
  714:       Vector2 tmp_xt = xt;
  715:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  716: 
  717:       if (fixCoords && res) xt = tmp_xt;
  718: 
  719:       return res;
  720:    }
  721: 
  722:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  723:    {
  724:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  725:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  726:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  727:       
  728:    }
  729: 
  730:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  731: 
  732:    // ------------------------------------------------------------------------------------------------
  733:    // These are functions that work on all nodes of the element.
  734:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  735:    //
  736:    // An example of how to use these functions is:
  737:    //   
  738:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  739:    // 
  740:    // Where L is the level at which the field is to be interpolated. The field can be either
  741:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  742:    // There are different versions of getNodalValues for each of these cases.
  743: 
  744:    template<typename T>
  745:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  746:       // Get the values of the field at the nodes of the element
  747:       res[0] = nodes[0]->*field;
  748:       res[1] = nodes[1]->*field;
  749:       res[2] = nodes[2]->*field;
  750:       if (isQuad()) res[3] = nodes[3]->*field;
  751:       else          res[3] = T();
  752:    }
  753: 
  754:    template<typename T>
  755:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  756:       // Get the values of the field at the nodes of the element
  757:       res[0] = (nodes[0]->*field)[level];
  758:       res[1] = (nodes[1]->*field)[level];
  759:       res[2] = (nodes[2]->*field)[level];
  760:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  761:       else          res[3] = T();
  762:    }    
  763: 
  764:    template<typename T>
  765:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  766:       // Get the values of the func at the nodes of the element
  767:       res[0] = (nodes[0]->*func)(level);
  768:       res[1] = (nodes[1]->*func)(level);
  769:       res[2] = (nodes[2]->*func)(level);
  770:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  771:       else          res[3] = T();  // This is 0.0 or a zero vector
  772: 
  773:    }      
  774: 
  775:    template<typename T>
  776:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  777:       // Get the values of the field at the nodes of the element
  778:       res[0] = sides[0]->*field;
  779:       res[1] = sides[1]->*field;
  780:       res[2] = sides[2]->*field;
  781:       if (isQuad()) res[3] = sides[3]->*field;
  782:       else          res[3] = T();
  783:    }
  784: 
  785:    template<typename T>
  786:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  787:       // Get the values of the field at the nodes of the element
  788:       res[0] = (sides[0]->*field)[level];
  789:       res[1] = (sides[1]->*field)[level];
  790:       res[2] = (sides[2]->*field)[level];
  791:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  792:       else          res[3] = T();
  793:    }    
  794: 
  795:    template<typename T>
  796:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  797:       // Get the values of the func at the nodes of the element
  798:       res[0] = (sides[0]->*func)(level);
  799:       res[1] = (sides[1]->*func)(level);
  800:       res[2] = (sides[2]->*func)(level);
  801:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  802:       else          res[3] = T();  // This is 0.0 or a zero vector
  803: 
  804:    }      
  805: 
  806:    template<typename T>
  807:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  808:       T values[4];
  809:       getNodalValues(level, func, values);
  810: 
  811:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  812:    }
  813: 
  814:    template<typename T>
  815:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  816:       T values[4];
  817:       getNodalValues(field, values);
  818:       
  819:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  820:    }
  821: 
  822: 
  823:    template<typename T>
  824:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  825:       T values[4];
  826:       getNodalValues(level, field, values);
  827: 
  828:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  829:    }
  830: 
  831:    template<typename T>
  832:    __device__ T mean(T Node::* field) const {
  833:       T values[4];
  834:       getNodalValues(field, values);
  835: 
  836:       return (values[0] + values[1] + values[2] + values[3])/i34;
  837:    }
  838: 
  839:    template<typename T>
  840:    __device__ T mean(T Side::* field) const {
  841:       T values[4];
  842:       getSideValues(field, values);
  843:       
  844:       return (values[0] + values[1] + values[2] + values[3])/i34;
  845:    }   
  846: 
  847:    template<typename T>
  848:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  849:       T values[4];
  850:       getNodalValues(level, field, values);
  851: 
  852:       return (values[0] + values[1] + values[2] + values[3])/i34;
  853:    }
  854: 
  855:    template<typename T>
  856:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  857:       T values[4];
  858:       getSideValues(level, field, values);
  859:       
  860:       return (values[0] + values[1] + values[2] + values[3])/i34;
  861:    }   
  862: 
  863:    // __device__ double mean(double (Node::*func)(int) const) const {
  864:    //    double values[4];
  865:    //    getNodalValues(level, func, values);
  866:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  867:    // }
  868:    // ------------------------------------------------------------------------------------------------
  869: 
  870:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
