 7742: __global__ void returnMatrix(double *res) {
 7743:    // Debugging: returns the matrix as a CuPy array
 7744: 
 7745:    const int size = mesh->np;
 7746:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7747:       const Node *node = mesh->localNodeData + idx_node;
 7748:       res[idx_node*size + idx_node] = node->coeffDiag;
 7749:       for (int j = 0; j < node->numNodes; j++) {
 7750:          Node* nbNode = node->nodes[j];
 7751:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7752:       }
 7753: 
 7754:    }
 7755:    
 7756: }
