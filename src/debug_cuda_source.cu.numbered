 5724: #ifdef DONTCOMPILE
 5725: __device__ void computeVerticalAdvection(void) {
 5726:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 5727: 
 5728:    sdbt(1:2,:,:)=0.d0
 5729: 
 5730:    const Side *side = FROM kernel;
 5731: 
 5732:    if(side->isDry) return;
 5733: 
 5734:    // If side is wet...
 5735: 
 5736: 
 5737:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 5738:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 5739:    double ws[nvrt] = {} // w @ side
 5740:    int icount = 0;
 5741:    for (int j=0; j<2; j++) {
 5742:       const Element *elem = side->elements[j];
 5743:        
 5744:       if(elem != nullptr) {
 5745:          icount++;
 5746:          for (int k=0; k<nvrt; k++) {
 5747:             ws[k] = ws[k] + elem->w[k];
 5748:          }
 5749:       }
 5750:    }  // for j
 5751: 
 5752:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 5753:    ws = ws/icount;
 5754: 
 5755:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 5756:    // Splines allow for a smooth transition between vertical levels.
 5757:    // Splines have continuity restrictions at the internal knots, but
 5758:    // we have to provide the 1st derivatives at the endpoints.
 5759:    const int kbs = side->kbs; 
 5760:    
 5761:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5762:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5763:    initCubicSpline(kbs, nvrt, side, ws, up)
 5764: 
 5765:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5766:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5767:    initCubicSpline(kbs, nvrt, side, ws, vp)
 5768: 
 5769:    // Total advection (average onto side)
 5770:    const Node *node1 = side->nodes[0];
 5771:    const Node *node2 = side->nodes[1];
 5772:    for (int k=kbs(i); k<nvrt; k++) {
 5773: 
 5774:       if constexpr(ics==1) {
 5775:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 5776:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 5777:       } else {
 5778:          // XXX IMPLEMENT THIS
 5779:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 5780:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 5781:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 5782:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 5783:       }  // if ics
 5784: 
 5785: 
 5786:    }
 5787: }
 5788: #endif
 5789: 
 5790: 
 5791: extern "C" {
 5792:    __global__ void computeElemAverageGhat(void) {
 5793:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 5794: 
 5795:       ELEM(elem);
 5796:       
 5797:       elem->ghat1= {0.0, 0.0};  
 5798: 
 5799:       if constexpr(ihydraulics != 0) {
 5800:          if (nhtblocks > 0 && elem->isblock) return;
 5801:       }
 5802: 
 5803:       if (elem->isDry) return;
 5804: 
 5805:       // Wet elements.
 5806:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 5807:       // tidal potential, horizontal diffusion, and baroclinic etc
 5808:       // Remember to update both fb and F 
 5809:       // If ics=2, ghat1 are in eframe (ll)
 5810:       // cff1-3: coefficients for 2D/3D
 5811:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 5812:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 5813:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 5814: 
 5815:       double av_cff1 = 0.0;  // av. for cff1
 5816:       double av_cff2 = 0.0;  // av. for cff2
 5817:       double av_cff3 = 0.0;  // av. for cff3
 5818:       double av_df = 0.0;  // av. for H^\alpha / H
 5819:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 5820:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 5821: 
 5822:       const int i34 = elem->i34;
 5823:       const int kb = elem->kb;
 5824: 
 5825:       for (int j=1; j<i34; j++) {
 5826:          // For each node and side in the element...
 5827: 
 5828:          const Node *node = elem->nodes[j];
 5829:          const Side *side = elem->sides[j];
 5830: 
 5831:          const double chi      = side->chi;
 5832:          const double veg_c2   = side->veg_c2;
 5833:          const double veg_beta = side->veg_beta;
 5834:          const double veg_h    = side->veg_h();
 5835:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 5836: 
 5837:          // Node - const in elem
 5838:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 5839:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 5840: 
 5841:          if (elem->depth >= tip_dp) {
 5842:            elem->gradETP += node->ETP*elem->gradPhi[j];
 5843:          }
 5844: 
 5845:          
 5846:          const double htot  = side->htot2();        // Total depth at the side
 5847:          const double zctr2 = side->zTopCanopy();  
 5848: 
 5849:          double cff1; 
 5850:          double cff2; 
 5851:          double cff3;   
 5852:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 5853:          // coefficients applied to 2D/3D case 
 5854:             cff1 = side->hhat/htot;
 5855:             cff2 = 0.0;
 5856:             cff3 = 0.0;
 5857:          } else { //3D
 5858:             //Init for no-veg case
 5859:             cff1 = 1.0;
 5860:             cff2 = 1.0;
 5861:             cff3 = 0.0;
 5862: 
 5863:             if constexpr(iveg != 0) {
 5864:                // Computes coefficients used with vegetation terms G1, G2
 5865:                // cff1, cff3 are used for the first two terms in G1, G2:
 5866:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 5867:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 5868:                // In general, cff1*Ustar - cff3*Ustar_alpha
 5869:                if(veg_h < 0.99*htot) { // submergent vegetation
 5870:                   cff1=1;
 5871:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 5872:                   cff3 = veg_c;
 5873: 
 5874:                } else { // emergent vegetation
 5875:                   cff1 = 1.0/(1.0 + veg_c2);
 5876:                   cff2 = cff1;
 5877:                   cff3 = 0.0;
 5878: 
 5879:                }
 5880:             } // if iveg
 5881:          } //  2D/3D
 5882: 
 5883:          av_cff1 += cff1/i34;
 5884:          av_cff2 += cff2/i34;
 5885:          av_cff3 += cff3/i34;
 5886:          av_cff2_chi += cff2*chi/i34;
 5887:          av_cff3_chi += cff3*chi/i34;
 5888:          av_df += min(htot, veg_h)/(htot*i34);
 5889: 
 5890: 
 5891:          // btrack values: U^\star, U^{\star\alpha}
 5892:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 5893:          Vector2 Ustar       = {0.0, 0.0}; 
 5894:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 5895: 
 5896:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 5897:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 5898:          } else { //3D
 5899:             for (int k = side->kb; k < nvrt; k++) {
 5900:             
 5901:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 5902:                Ustar += w2;
 5903: 
 5904:                if constexpr(iveg != 0) {
 5905:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 5906:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 5907:                        Ustar_alpha += zrat*w2; // XXXX
 5908:                    }
 5909:                }  // if iveg
 5910:             }  // for k
 5911:          }  //2D/3D
 5912:          
 5913: 
 5914:          // Add btrack & surface stress terms to \breve{G} first
 5915:          if constexpr(ics==1) {
 5916:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 5917:          } else {
 5918:             // XXX IMPLEMENT THIS
 5919:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 5920:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 5921:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 5922:          }  // if ics
 5923: 
 5924:          // Surface and bottom stress terms
 5925:          if constexpr(ics==1) {
 5926:             const Vector2 tau    = side->tau();
 5927:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 5928: 
 5929:             // Term for surface and bottom stress
 5930:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 5931:          } else {
 5932:             // XXX IMPLEMENT THIS
 5933:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 5934:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 5935:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 5936:             // tau_x=(vn1+tt1)/2.d0
 5937:             // tau_y=(vn2+ss1)/2.d0
 5938:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 5939:          }  // if ics
 5940: 
 5941:          
 5942: 
 5943:          // All terms in F,F^\alpha,f_b except baroclinic
 5944:          // F, f_b: all explicit terms excluding vegetation 
 5945:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 5946:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 5947:          const double coriolis = side->coriolis;
 5948:          Vector2 F  =  coriolis*side->U;  // F_x
 5949:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 5950:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 5951: 
 5952:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 5953:             
 5954:             for (int k = side->kb; k < nvrt; k++) {
 5955:                if (zctr2 > side->zc[k-1]) {
 5956:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 5957:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 5958:                    Fa +=  coriolis*w2*zrat;
 5959:                } // if zctr2
 5960:             } // k
 5961:          } // iveg
 5962: 
 5963:          // Integrate horizontal viscosity force vertically
 5964:          for (int k=side->kb + 1; k<nvrt; k++) {
 5965:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 5966: 
 5967:             F += levelHorVisc;
 5968: 
 5969:             // Vegetation term
 5970:             if constexpr(iveg!=0) {
 5971:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 5972:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 5973:                   Fa += levelHorVisc*zrat;
 5974:                } 
 5975:             } // if iveg
 5976:          } // for k
 5977: 
 5978:          fb += side->d2uv[side->kb];
 5979: 
 5980: 
 5981:          // Add to ghat1
 5982:          if constexpr(ics==2) {
 5983:             // XXX IMPLEMENT THIS
 5984:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5985:             // bigf1=vn1; bigf2=vn2
 5986:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5987:             // botf1=vn1; botf2=vn2
 5988:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5989:             // bigfa1=vn1; bigfa2=vn2
 5990:          } // if ics
 5991: 
 5992:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 5993:       } // for j (nodes and sides)
 5994: 
 5995:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 5996:          
 5997:       // Finish off terms in F, F^\alpha and f_b
 5998:       const double grav3 = elem->mean(&Node::grav2);
 5999:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6000: 
 6001: 
 6002:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6003:       for (int j=1; j<i34; j++) { 
 6004:          // For each side in the element...
 6005:          const Side *side = elem->sides[j];
 6006:          const double chi = side->chi;
 6007: 
 6008:          const double htot = side->htot2();
 6009:          const double veg_h = side->veg_h();
 6010:          const Vector2 F  = htot*fb;
 6011:          const Vector2 Fa = min(htot, veg_h)*fb;
 6012: 
 6013:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6014:       } // for j
 6015: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6016:       //botf1 etc are already in elem frame
 6017:       elem->ghat1 += tmp/i34;
 6018: 
 6019:       // Baroclinic force
 6020:       if constexpr(ibc==0) {
 6021:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6022: 
 6023:          Vector2 Fa = {0.0, 0.0};
 6024:          Vector2 intGradRho = {0.0, 0.0};
 6025:          
 6026:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6027:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6028:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6029: 
 6030:             // \in F [m^2/s/s]
 6031:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6032:          }
 6033: 
 6034:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6035:          const Vector2 F = av_df*Fa; //approx
 6036:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6037: 
 6038:       } // if ibc
 6039: 
 6040: 
 6041: 
 6042:    }
 6043: 
 6044: } // extern "C"
 6045: 
 6046: 
 6047: 
 6048: #ifdef DONTCOMPILE
 6049: __global__ void checkMassConservation(Tracers* sumtr) {
 6050: 
 6051:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6052: 
 6053:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6054: 
 6055:    Element *elem = &(mesh->localElemData[i]);
 6056: 
 6057:    // Skip dry elements
 6058:    if (elem->isDry) return;
 6059: 
 6060:    // Local sum array for this thread
 6061:    double localSum[N_TRACERS] = {0.0};
 6062: 
 6063:    // Sum over vertical levels for this element
 6064:    const int kbe = elem->kbe;
 6065:    const double area = elem->area;
 6066: 
 6067:    for (int k = kbe; k < nvrt; k++) {
 6068:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6069:       
 6070:       // Accumulate tracer mass
 6071:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6072:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6073:       }
 6074:    }
 6075: 
 6076:    
 6077: 
 6078:    //  This function returns per element sums. A reduction must be done on the host side.
 6079: }
 6080: 
 6081: 
 6082: __global__ void transport(void) {
 6083: 
 6084:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6085: 
 6086:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6087: 
 6088:    Element *elem = &(mesh->localElemData[ie]);
 6089: 
 6090:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6091: 
 6092:                for (int m=0; m<ntr; m++) {
 6093:                   for (int k=kbe(ie); k<nvrt; k++) {
 6094:                      // Calculate each polynomial's weight 
 6095:                      wm=0.d0; sum1=0.d0; 
 6096:                      wm1=0.d0; wm2=0.d0; 
 6097:                      for (int i=0; i<elem->nweno2; i++) {
 6098:                   
 6099:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6100:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6101:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6102:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6103:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6104:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6105:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6106:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6107:                      // -----------------Hu and Shu (1999)'s method----------------
 6108:                      b4=b1+b2+b3
 6109: 
 6110: //Error: add PRODUCTION CPP
 6111: #ifdef DEBUG
 6112:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6113:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6114:                     call parallel_abort(errmsg)
 6115:                   }
 6116: #endif
 6117: 
 6118:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6119:                   // !----test-------------- 
 6120:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6121:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6122:                   // !wm(i)=wm1(i)*wm2(i)
 6123:                   // !---------------------- 
 6124:                   sum1=sum1+wm(i)
 6125:                 } // end for i
 6126: 
 6127:                 wm=wm/sum1
 6128: 
 6129:                 for (int j=0; j<elem->i34; j++) {
 6130: 
 6131:                   const Side *side  = elem->sides[j];
 6132:                   const Node *node1 = side->n1;
 6133:                   const Node *node2 = side->n2;
 6134: 
 6135:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6136:                      trsd=0.d0
 6137:                      for (int kk=0; kk<nquad; kk++) {
 6138:                         for (int i=0; i<elem->nweno2; i++) {
 6139:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6140:                         } // end for i   
 6141:                      } // end for kk
 6142:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6143:                   } // outward flux
 6144:                } // end for j=1,i34(ie) ! side
 6145:             }
 6146:          }
 6147:               
 6148: 
 6149: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6150: //             //   calculate each polynomial's weight 
 6151: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6152: //                 wm=0.d0; sum1=0.d0
 6153: //                 do i=1,nweno1(ie) !for each polynomial
 6154: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6155: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6156: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6157: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6158: //                   wm(i)=b2
 6159: //                   sum1=sum1+b2
 6160: //                   !wm(i)=1.d0
 6161: //                   !sum1=sum1+1.d0
 6162: 
 6163: // // Error: PRODUCTION
 6164: // #ifdef DEBUG
 6165: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6166: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6167: //                     call parallel_abort(errmsg)
 6168: //                   endif
 6169: // #endif
 6170: 
 6171: //                 enddo !i
 6172: //                 wm=wm/sum1 !final weight
 6173: 
 6174:                 for (int j=0; j<elem->i34; j++) { // side
 6175:                   const Side *side = elem->sides[j];
 6176:                   const Node *node1 = side->n1;
 6177:                   const Node *node2 = side->n2;
 6178: 
 6179:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6180:                     trsd=0.d0
 6181:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6182:                       for (int i=0; i<elem->nweno1; i++) {
 6183:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6184:                       }
 6185:                     enddo //kk
 6186:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6187:                   } // outward flux
 6188:                 } // end for j=1,i34(ie) ! side
 6189:               } // end for k; ntr 
 6190: 
 6191:             else !simple upwind method
 6192:               do j=1,i34(ie)
 6193:                 jsj=elside(j,ie)
 6194:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6195:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6196:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6197:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6198:                   endif
 6199:                 enddo  !vertical layers
 6200:               enddo !j=1,i34(ie) ! side
 6201:             endif !order of accuracy
 6202: 
 6203:          //  enddo !ie
 6204: // !$OMP     end do
 6205: 
 6206: // !$OMP     master
 6207: //           !message passing
 6208: //           if (nproc>1) then
 6209: //             !make a copy of side concentrations
 6210: //             trsd_tmp0=trsd_tmp 
 6211: 
 6212: //             !this exchange routine swaps interface concentration between two partitions
 6213: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6214: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6215: 
 6216: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6217: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6218: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6219: 
 6220: 
 6221: //             !This obtains final values for interface sides
 6222: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6223: //       :    endif !nproc>1
 6224: //           !message passing end
 6225: // !$OMP     end master
