 2185:    template<typename T>
 2186:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2187:       // Get the values of the field at the nodes of the element
 2188:       res[0] = nodes[0]->*field;
 2189:       res[1] = nodes[1]->*field;
 2190:       res[2] = nodes[2]->*field;
 2191:       if (isQuad()) res[3] = nodes[3]->*field;
 2192:       else          res[3] = T();
 2193:    }
 2194: 
 2195:    template<typename T>
 2196:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2197: 
 2198:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2199:       // Get the values of the field at the nodes of the element
 2200:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2201:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2202:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2203:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2204:       else          res[3] = T();
 2205:    }    
 2206: 
 2207:    template<typename T>
 2208:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2209: 
 2210:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2211: 
 2212:       // Get the values of the func at the nodes of the element
 2213:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2214:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2215:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2216:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2217:       else          res[3] = T();  // This is 0.0 or a zero vector
 2218: 
 2219:    }      
