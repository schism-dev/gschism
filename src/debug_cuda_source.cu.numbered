 4606:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 4607:       NODE(node);
 4608: 
 4609:       const int idx = node->idx;
 4610:       Vector2 wind = {xWind[idx], yWind[idx]};
 4611: 
 4612:       if constexpr(nws != 0 && iwindoff != 0) {
 4613:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 4614:       }
 4615: 
 4616:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 4617:       node->setWind(wind);
 4618: 
 4619:       node->pr = pressAir[idx];
 4620:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 4621: 
 4622:    }
