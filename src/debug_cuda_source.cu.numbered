 1863: __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p, const Side* origSide) {
 1864: // If ics == 2, convert the global point to the local frame of the original side
 1865:    
 1866:    if constexpr (ics == 1) {
 1867:       return p;
 1868:    } else {
 1869:       const Point3 c = {origSide->center.x, origSide->center.y, origSide->centerZ()};
 1870:       const Point3 p2 = origSide->frame.G2L(p - c);
 1871:       return p2; // only the horizontal components
 1872:    }
 1873: }
 1874: 
 1875: __device__ __forceinline__ Point2 toLocalFrame(Point2 const& p, const Side* origSide) {
 1876: // If ics == 2, convert the global vector to the local frame of the original side
 1877:    return toPoint2(toLocalFrame(toPoint3(p, 0.0), origSide));
 1878: }
