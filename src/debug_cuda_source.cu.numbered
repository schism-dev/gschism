  145: // eta coordinates of the nodes (idxNode = 0,1,2,3)
  146: __device__ __forceinline__ double eta_n(int idxNode) {
  147:    // bit1: 0 -> -1, 1 -> +1
  148:    assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  149:    return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  150: }
  151: 
  152: // xi coordinates of the nodes (idxNode = 0,1,2,3)
  153: __device__ __forceinline__ double xi_n(int idxNode) {
  154:    // +1 if (bit0 XOR bit1), else -1
  155:    assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  156:    return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  157: 
  158: }
