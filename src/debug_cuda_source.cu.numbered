 2557: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2558: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2559: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2560: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2561: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2562: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2563:    Vector2 grad = {0.0, 0.0};
 2564:    int count = 0;
 2565: 
 2566:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2567: 
 2568:    // First element
 2569:    if (elems[0] != nullptr && condition(elems[0])) {
 2570:       grad += elems[0]->grad2(field);
 2571:       count++;
 2572:    }
 2573: 
 2574:    // Second element
 2575:    if (elems[1] != nullptr && condition(elems[1])) {
 2576:       grad += elems[1]->grad2(field);
 2577:       count++;
 2578:    }
 2579: 
 2580:    if (count > 0) {
 2581:       grad = grad/count;
 2582:    }
 2583:    
 2584:    return grad;
 2585: }
