 4208: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4209:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4210:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4211:                 int *isdel, int *isidenode, int *isbnd,
 4212:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4213:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4214:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4215:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4216:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4217:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4218:                 double *drag, double *roughness,
 4219:                 double *emo, double *efa, 
 4220:                 double *umo, double *ufa, 
 4221:                 double *vmo, double *vfa) {
 4222: 
 4223:    printf("Populating mesh for partition %d\n", partNum);
 4224: 
 4225:    // XXXXXX THIS function does almost nothing. 
 4226: 
 4227:    nbs = *sharedIdxSideBoundary + 1;
 4228:    nbp = *sharedIdxNodeBoundary + 1;
 4229: 
 4230:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4231: 
 4232: }
