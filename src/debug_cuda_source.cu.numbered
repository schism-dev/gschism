 7193: __global__ void printMatrix(void) {
 7194:    // Debugging: print the matrix
 7195: 
 7196:    const int size = mesh->np;
 7197:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7198:       const Node *node = mesh->localNodeData + idx_node;
 7199:       printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7200:       for (int j = 0; j < node->numNodes; j++) {
 7201:          Node* nbNode = node->nodes[j];
 7202:          if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7203:       }
 7204:       printf("]\n");
 7205: 
 7206:    }
 7207: 
 7208: }
