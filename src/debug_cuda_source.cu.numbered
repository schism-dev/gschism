 3749:    __global__ void scaleGravity(double loadtide_coef) {
 3750: 
 3751: 
 3752:       NODE(node);
 3753: 
 3754:       // SAL option: scale gravity
 3755:       if constexpr(iloadtide==2) {  // simple const
 3756:          node->grav2 = grav*(1.0 - loadtide_coef);
 3757: 
 3758:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3759:         
 3760:           const double depth = max(node->depth, 0.0);
 3761:           const double tmp1 = sqrt(depth);
 3762:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3763:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3764:                              2.6969e-13*depth*depth*depth*tmp1;
 3765:           
 3766:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3767:           
 3768: 
 3769: 
 3770:           node->grav2 = grav*(1.0 - beta_bar);
 3771: 
 3772:       } else {  // iloadtide=0,1
 3773:         node->grav2=grav;
 3774: 
 3775:       }
 3776: 
 3777:    }
 3778: 
