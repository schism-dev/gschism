 8009: __global__ void returnMatrix(double *res) {
 8010:    // Debugging: returns the matrix as a CuPy array
 8011: 
 8012:    const int size = mesh->np;
 8013:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8014:       const Node *node = mesh->localNodeData + idx_node;
 8015:       res[idx_node*size + idx_node] = node->coeffDiag;
 8016:       for (int j = 0; j < node->numNodes; j++) {
 8017:          Node* nbNode = node->nodes[j];
 8018:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8019:       }
 8020: 
 8021:    }
 8022:    
 8023: }
