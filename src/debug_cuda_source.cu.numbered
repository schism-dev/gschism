 1761: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1762:    // Computes the 3D normal vector to the element at level k
 1763:    // Returns the normal vector and the area of the element
 1764: 
 1765:       if (isTri()) {
 1766:          // For triangles...
 1767: 
 1768:          // Gets the normal vector to the element (with a length equal to twice the area)
 1769:          if constexpr(ics==1) {
 1770:             const int kb0 = max(k, nodes[0]->kb);
 1771:             const int kb1 = max(k, nodes[1]->kb);
 1772:             const int kb2 = max(k, nodes[2]->kb);
 1773: 
 1774:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1775:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1776:             
 1777:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1778:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1779:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1780:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1781: 
 1782:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1783:             area3D = 0.5*len;
 1784: 
 1785:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1786: 
 1787:             return {nx/len, ny/len, nz/len};
 1788: 
 1789:            
 1790:          }
 1791:          else {  // lat/lon
 1792:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1793: 
 1794:          } // if ics
 1795:       }
 1796:       else {
 1797:          // For quads...
 1798: 
 1799:          assert(false && "Element normal vector: quads not yet implemented");
 1800: 
 1801: 
 1802:       }
 1803:    }
 1804: 
 1805: /**
 1806:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1807:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1808:    If the segment is completely inside the element, then it returns true.
 1809: 
 1810:    This function assumes:
 1811:    - The initial point is on a side of the element. 
 1812:    - Its position is given by parameter t in the range [0,1].
 1813:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1814:       intersects the element (elements are convex).
 1815: 
 1816:    To find the intersection point, this function does the following:
 1817:    - it finds the intersection of the line segment with all the element side lines,
 1818:       except for the one that contains the initial point.
 1819:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1820:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1821:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1822:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1823:       track segment is almost parallel to the element side line.
 1824: 
 1825:    Inputs:
 1826:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1827:    @param x2, y2: other end of the line segment
 1828: 
 1829:    Outputs:
 1830:    @param side:  side that intersects the line segment (input and output)
 1831:    @param nextElement (output): element that contains the intersection point
 1832:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1833:    @param zint (input/output): Vertical coordinate of the intersection point
 1834: 
 1835:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1836:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1837:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1838: 
 1839:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1840:    (Delta) being zero.
 1841: 
 1842:    The intersection2 point happens when:
 1843:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1844:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1845:    
 1846:    Assumption: the 4 points (including those of the side segment) are different.
 1847:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1848:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1849:    If true, (xIntersect,yIntersect) is the intersection.				
 1850:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1851: **/
 1852: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1853:                                               double &t, double& tIntersect) {
 1854: 
 1855:    double closest_intersect_t = 1e10;
 1856:    bool found_intersection = false;
 1857: 
 1858:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1859:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1860:    const Point2 x1 = side->point(t);
 1861:    
 1862: 
 1863:    Side *nextSide = nullptr;
 1864:    for (int i = 0; i < i34; i++) {
 1865: 
 1866:       // Element's i-th side 
 1867:       Side *side2 = sides[i];
 1868: 
 1869:       // Skip the side that contains the initial point
 1870:       if (side2 == side) continue;
 1871: 
 1872:       // (x3,y3)-(x4,y4) is the element side line
 1873:       const Point2 x3 = side2->n1->p;
 1874:       const Point2 x4 = side2->n2->p;
 1875: 
 1876:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1877:       const double delta = cross(x2 - x1, x3 - x4);
 1878: 
 1879:       if (delta != 0.0) {
 1880: 
 1881:          const double delta1 = cross(x3 - x1, x3 - x4);
 1882:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1883: 
 1884:          // Solves the two linear equations for tt1 and tt2
 1885:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1886:          const double tt2 = delta2/delta;
 1887: 
 1888:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1889:             closest_intersect_t = min(closest_intersect_t, tt1);
 1890:             nextSide = side2;
 1891: 
 1892:             nextElement = nextSide->otherElem(this);
 1893:             tIntersect = max(small, min(tt1, 1.0-small));
 1894:             t = tt2;
 1895: 
 1896:             found_intersection = true;
 1897:          }
 1898:       
 1899:       }
 1900: 
 1901:    }
 1902: 
 1903:    // found_intersection should always be true, since we checked all the sides.  
 1904:    side = nextSide;
 1905: 
 1906:    return found_intersection;
 1907: }
 1908: 
 1909: 
 1910: 
 1911: 
 1912: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1913:                                               double &t, double& tIntersect) {
 1914: 
 1915:    double closest_intersect_t = 1e10;
 1916:    bool found_intersection = false;
 1917: 
 1918:    for (int i = 0; i < i34; i++) {
 1919: 
 1920:       Side *side2 = sides[i];
 1921: 
 1922:       // (x3,y3)-(x4,y4) is the element side line
 1923:       const Point2 x3 = side2->n1->p;
 1924:       const Point2 x4 = side2->n2->p;
 1925: 
 1926:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1927:       const double delta = cross(x2 - x1, x3 - x4);
 1928: 
 1929:       if (abs(delta) > 0) {
 1930: 
 1931:          const double delta1 = cross(x3 - x1, x3 - x4);
 1932:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1933: 
 1934:          // Solves the two linear equations for tt1 and tt2
 1935:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1936:          const double tt2 = delta2/delta;
 1937: 
 1938:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1939:             closest_intersect_t = min(closest_intersect_t, tt1);
 1940:             side = side2;
 1941:             nextElement = side->otherElem(this);
 1942:             t = tt2;
 1943:             tIntersect = max(small, min(tt1, 1.0-small));
 1944:             found_intersection = true;
 1945:          }
 1946:       
 1947:       }
 1948:       else {  // parallel segments
 1949:          assert(false && "Parallel segments");
 1950:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1951:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1952: 
 1953:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1954: 
 1955:          // const double dist = dot(x1 - x3, side2->n);
 1956:          // if (abs(dist) < small*length(x3 - x4)) {
 1957:          //    const double2 unitarySide = normalize(x4 - x3);
 1958:          //    const double len = dot(x2 - x1, unitarySide);
 1959:          //    t = t + len;
 1960:          //    t = max(0.0, min(t, 1.0));
 1961:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1962: 
 1963: 
 1964:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1965:          //    // t = tt2;
 1966:          //    found_intersection = true;
 1967:          // }
 1968:       }
 1969: 
 1970: 
 1971:    }
 1972: 
 1973:       
 1974:    assert(found_intersection && "No intersection found");
 1975: 
 1976:    // found_intersection should always be true, since we checked all the sides.  
 1977:    return found_intersection;
 1978: }
 1979: 
 1980: 
 1981: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1982:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1983: 
 1984:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1985: 
 1986:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1987:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1988:    // curElement.
 1989: 
 1990:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1991:    // And uses this velocity instead to continue the tracking.
 1992: 
 1993:    // computes the intersection point in cartesian coordinates
 1994:    Point2 intersection = nextSide->p_t(tt);
 1995: 
 1996:    // Nudges the point to the barycenter of the element. 
 1997:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1998:    // next segment intersects the element sides.  
 1999:    curElem->nudgeToBarycenter(intersection);
 2000: 
 2001:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2002:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2003:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2004:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2005: 
 2006:    // If the side is an open boundary, the tangential velocity is zero.
 2007:    if (nextSide->isBnd()) vtan = 0.0;
 2008: 
 2009:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2010:    const double us = vtan*nextSide->t().x;
 2011:    const double vs = vtan*nextSide->t().y;
 2012:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 2013: 
 2014:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2015:    const double len2 = norm2(intersection - toPoint2(xt));
 2016:    const double vel2 = dot(u_int, u_int);        
 2017:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 2018:    else            dt = 0.0;
 2019: 
 2020:    // The end of this tracking segment is now the intersection point.
 2021:    xt = {intersection.x, intersection.y, zint};
 2022: 
 2023:    u_int = {us, vs, ws};
 2024:    
 2025: }
 2026: 
 2027: /**
 2028:  * Tracks a particle through elements and vertical levels in the mesh.
 2029:  * 
 2030:  * @param x0,y0,z0     Starting position coordinates
 2031:  * @param xt,yt,zt     Target position coordinates
 2032:  * @param dtb          Time step for tracking
 2033:  * @param uuint,vvint,wwint Initial velocity components
 2034:  * @param nextElem     Starting/resulting element index
 2035:  * 
 2036:  * @return Status code of type trackExitCodes
 2037:  * 
 2038:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2039:  * of the details are different. The idea is that the code requires less branches and is better fit
 2040:  * for GPU execution.
 2041:  * 
 2042:  * The main ideas here are:
 2043:  * - The starting point is expected to be in the starting element.
 2044:  * - The end point is guaranteed to be inside an element.
 2045:  * - since the starting point is inside the element, there are only two cases: 
 2046:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2047:  *     (b) it does not and (xt,yt) is already in the starting element.
 2048:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2049:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2050:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2051:  * - tt1 can be positive or negative. We only consider the positive values.
 2052:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2053:  * - The next intersection will occur at the smallest positive tt1.
 2054:  * - This intersection will be the next (x0,y0) position.
 2055:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2056:  *   of getting stuck in a loop.
 2057:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2058:  *   was found.
 2059:  */
 2060: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2061:                                                        Element *&nextElem, int &jlev, double &dt,
 2062:                                                        const Side *origSide) {
 2063: 
 2064: 
 2065: 
 2066:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2067:    // else to do.
 2068:    // If it is, nudges the point to be inside the element.
 2069:    const Element *curElem = nextElem;
 2070:    if (containsPoint(toPoint2(xt), true)) {
 2071: 
 2072:       curElem->interpolateVelocities(xt, u_int);
 2073: 
 2074: addDebugPlot(x0, xt);
 2075:       return true;
 2076:    }
 2077: 
 2078:    Side *side = nullptr;
 2079: 
 2080:    // 1. Initial checks
 2081:    // Verify starting element is valid (wet)
 2082:    assert(!curElem->isDry && "Starting element is dry");
 2083: 
 2084:    // Checks if track has a zero length.
 2085:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2086:    // assert(len2 > 0.0 && "Zero length track"); 
 2087:    
 2088:    const int MAX_ITERATIONS = 1000;
 2089:    
 2090:    double t;
 2091:    Side *nextSide = nullptr;
 2092:    double tIntersect = 1e10;
 2093:    double zint = x0.z;
 2094: 
 2095:    // Horizontal tracking loop
 2096:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2097:    // (x0,y0) is inside the element but the target point is not.
 2098: 
 2099:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2100: 
 2101:    assert(found_intersection && "No intersection found at %d");
 2102: 
 2103:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2104: 
 2105:    // if the tracking segment goes out of water (either dry or edge boundary)
 2106:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2107: 
 2108: addDebugPlot(x0, xt, 0x00A0FF);
 2109:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2110: addDebugPlot(x0, xt, 0x00A0FF);      
 2111: 
 2112:       nextElem = this;
 2113:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2114:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2115:       return true;    
 2116:    }
 2117: 
 2118: 
 2119:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2120:    int iterations = 0;
 2121:    while (iterations < MAX_ITERATIONS) {
 2122:       iterations++;
 2123:       
 2124:       Element *curElem = nextElem;
 2125: 
 2126:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2127: addDebugPlot(x0, xt);
 2128:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2129: 
 2130:       // If we are already in the target element, we are done.
 2131:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2132:       if (!found_intersection) break;
 2133: 
 2134: 
 2135: 
 2136:       // if the tracking segment goes out of water (either dry or edge boundary).
 2137:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2138: addDebugPlot(x0, xt, 0x00A0FF);
 2139:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2140: addDebugPlot(x0, xt, 0x00A0FF);   
 2141:          nextElem = curElem;
 2142: 
 2143:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2144:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2145:          return true;
 2146:       }
 2147:       
 2148:       // Update position and element for next iteration
 2149:       side = nextSide;
 2150: 
 2151:    }
 2152: 
 2153:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2154: 
 2155:  
 2156:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2157:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2158: addDebugPlot(x0, xt);   
 2159:    nextElem->interpolateVelocities(xt, u_int); 
 2160: 
 2161:    return true;
 2162: }
 2163: 
 2164: 
 2165: __inline__ __device__ double Element::computeSignedArea(void) const {
 2166:    // Compute the area of the element
 2167: 
 2168:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2169: 
 2170:    // In the quad case we need to add the area of the other triangle.
 2171:    if (isQuad()) {
 2172:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2173:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2174:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2175:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2176: 
 2177:       res += ar1;
 2178:    }
 2179: 
 2180:    return res;
 2181: }
 2182: 
 2183: 
 2184: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2185:                                                                 (nodes[1]->isDry2()) ||
 2186:                                                                 (nodes[2]->isDry2()) ||
 2187:                                                                 (i34==4 && nodes[3]->isDry2());
 2188: }
 2189: 
 2190: __inline__ __device__ double Element::detJ_eta(void) const {
 2191:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2192:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2193: }
 2194: 
 2195: __inline__ __device__ double Element::detJ_xi(void) const {
 2196:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2197:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2198: }
 2199: 
 2200: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2201:    // In boundary sides, the element 1 is nullptr
 2202:    return side->elems[1] == nullptr; 
 2203: }
 2204: 
 2205: 
 2206: 
 2207: /**
 2208:    Compute the shape coordinates of the point (xt,yt) in the element.
 2209:    @param xt (input): x-coordinate of the point
 2210:    @param shpCoords (output): shape coordinates of the point
 2211:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2212:    @return true if the point is inside the element, false otherwise
 2213: **/
 2214: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2215:                                             bool fixNegshpCoord) const {
 2216: 
 2217:    // Compute the shape coordinates of the point xt in the element.
 2218:    if (i34==3) {
 2219:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2220:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2221:       // and in this case, the pt will be nudged into the element
 2222:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2223:       // from the local frame, so use additional check.
 2224: 
 2225:       Point2 x0, x1, x2;
 2226: 
 2227:       if constexpr(ics==1) {
 2228:          x0 = nodes[0]->p;
 2229:          x1 = nodes[1]->p;
 2230:          x2 = nodes[2]->p;
 2231:       }
 2232:       else // lat/lon
 2233:       {
 2234:          Error("Not implemented yet");
 2235: #ifdef ICS2
 2236:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2237:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2238:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2239: #endif
 2240:       }
 2241: 
 2242:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2243:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2244:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2245:       shpCoords[3] = 0.0;
 2246:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2247: 
 2248:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2249:       // then we fix the negative shape coordinates.
 2250:       if (fixNegshpCoord && tmpmin<=0.0) {
 2251: 
 2252:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2253:          // keeping the sum of the shape coordinates equal to 1.
 2254:          // I have tested and compared the new algorithm with the old one, and they give
 2255:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2256:          // The new algorithm should be faster since it is branchless.
 2257:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2258:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2259:          
 2260:          shpCoords[0] = (shpCoords[0] + a)*b;
 2261:          shpCoords[1] = (shpCoords[1] + a)*b;
 2262:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2263: 
 2264:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2265:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2266:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2267:          }
 2268: 
 2269:          // Update the point coordinates for the new shape coordinates
 2270:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2271:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2272:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2273: 
 2274:       }
 2275: 
 2276:       // Check if the point is inside the element
 2277:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2278:    }
 2279:    else {
 2280:       Error("Not implemented yet");
 2281: #ifdef QUADS
 2282:       // Reproject pt in eframe of nel for ics=2
 2283:       if constexpr(ics==1) {
 2284:          xn2 = xt; 
 2285:          yn2 = yt;
 2286:       }
 2287:       else {
 2288:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2289:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2290:       }
 2291: 
 2292:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2293: #endif
 2294:    }
 2295: 
 2296:    return false;  // Never reached
 2297: 
 2298: }
 2299: 
 2300: 
 2301: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2302: // Convert shape coordinates to cartesian coordinates
 2303: 
 2304:    if (i34 == 3) {
 2305:       // Triangular element
 2306:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2307:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2308:    }
 2309:    else {
 2310:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2311:    }
 2312: 
 2313: }
 2314: 
 2315: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2316:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2317:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2318:    // The formula for the integral is:
 2319:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2320: 
 2321:    printf("intPhiPhi: TEST\n");
 2322: 
 2323:    const Node *n0 = nodes[0];
 2324:    const Node *n1 = nodes[1];
 2325:    const Node *n2 = nodes[2];
 2326:    const Node *n3 = nodes[3];
 2327: 
 2328:    const Vector2 p0 = n0->p;
 2329:    const Vector2 p1 = n1->p;
 2330:    const Vector2 p2 = n2->p;
 2331:    const Vector2 p3 = n3->p;
 2332: 
 2333:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2334:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2335:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2336:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2337: 
 2338:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2339: }
 2340:    
 2341: 
 2342: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2343:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2344:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2345:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2346:    // The formula is also based on the identity:
 2347:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2348:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2349: 
 2350:    printf("intGradPhiGradPhi: TEST\n");   
 2351: 
 2352:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2353: 
 2354:    const double x0 = nodes[0]->p.x;
 2355:    const double y0 = nodes[0]->p.y;
 2356:    const double x1 = nodes[1]->p.x;
 2357:    const double y1 = nodes[1]->p.y;
 2358:    const double x2 = nodes[2]->p.x;
 2359:    const double y2 = nodes[2]->p.y;
 2360:    const double x3 = nodes[3]->p.x;
 2361:    const double y3 = nodes[3]->p.y;
 2362: 
 2363:    double res = 0.0;
 2364:    
 2365:    // Quadrature points in xi and eta coordinates
 2366:    #pragma unroll
 2367:    for (int i = 0; i < 4; i++) {
 2368:       // For each quadrature point...
 2369: 
 2370:       const Point2 p = GaussPoint(i);
 2371:       const double eta = p.x;
 2372:       const double xi  = p.y;
 2373: 
 2374:       // Jacobian entries at the Gauss point p
 2375:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2376:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2377:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2378:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2379: 
 2380:       const double detJ = jacobianDet(p);
 2381:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2382: 
 2383:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2384:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2385:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2386:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2387:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2388: 
 2389:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2390:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2391:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2392:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2393:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2394: 
 2395:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2396:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2397:    }
 2398: 
 2399:    return res;
 2400: }
 2401: 
 2402: 
 2403: /**  Interpolate velocities at a given point (xt,yt,zt)
 2404: 
 2405:    @param xt, yt, zt: coordinates of the point to interpolate
 2406:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2407: 
 2408:    This is done in four steps:
 2409: 
 2410:    1. Find the shape coordinates for the final position in the element.
 2411:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2412:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2413:       z levels at xt, yt at each step.   
 2414:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2415:       horizontally and vertically.
 2416: **/
 2417: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2418:    // Interpolate the velocities at the point xt. 
 2419:    // This function works the same for triangular and quadrilateral elements.
 2420:    double shpCoord[4];
 2421: 
 2422:    // First step is to compute the shape coordinates of (xt,yt)
 2423:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2424:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2425: 
 2426:    // Second step is to find the level that contains zt
 2427:    // Uses a binary search to find the level
 2428:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2429:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2430:    int R = nvrt - 1;
 2431: 
 2432:    // Get the z coordinates at the nodes of the element at the levels L and R
 2433:    double zLAtNodes[4], zRAtNodes[4];
 2434:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2435:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2436: 
 2437:    double zL = interpolate(shpCoord, zLAtNodes);
 2438:    double zR = interpolate(shpCoord, zRAtNodes);
 2439:    
 2440:    // Interpolates vertically the velocities
 2441:    double wght1, wght2;
 2442:    if (xt.z<=zL) {
 2443:       wght1 = 1.0;
 2444:       wght2 = 0.0;
 2445:    }
 2446:    else if (xt.z>=zR) {
 2447:       wght1 = 0.0;
 2448:       wght2 = 1.0;
 2449:    }
 2450:    else {
 2451:       // Perform a binary search to find the levels between L and R that contain xt.z
 2452:       while (R - L > 1) {
 2453:          int M = (L + R) / 2;
 2454: 
 2455:          double zMAtNodes[4];
 2456:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2457:          double zM = interpolate(shpCoord, zMAtNodes);
 2458:          if (zM < xt.z) 
 2459:          {
 2460:             L = M;
 2461:             zL = zM;
 2462:          }
 2463:          else 
 2464:          {
 2465:             R = M;
 2466:             zR = zM;
 2467:          }
 2468:       }
 2469:       assert(L == R-1);
 2470:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2471: 
 2472:       wght2 = (xt.z - zL)/(zR - zL);
 2473:       wght1 = 1.0 - wght2;
 2474:    }
 2475: 
 2476:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2477:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2478: 
 2479:    // Neither of the interpolated velocities should be NaN
 2480:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2481: 
 2482: }
 2483: 
 2484: 
 2485: 
 2486: 
 2487: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2488: 
 2489:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2490:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2491:    const Node *n1 = side->n1;
 2492:    const Node *n2 = side->n2;
 2493: 
 2494:    bool n1_match = (n1->nodeBnd->segment == segment);
 2495:    bool n2_match = (n2->nodeBnd->segment == segment);
 2496: 
 2497:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2498:    if (n1_match && n2_match) {
 2499:       return 0.5;
 2500:    } else if (n1_match) {
 2501:       return 1.0;
 2502:    } else if (n2_match) {
 2503:       return 0.0;
 2504:    }
 2505: 
 2506:    return 0.0;
 2507: }
 2508: 
