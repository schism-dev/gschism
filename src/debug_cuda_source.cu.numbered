 4165: 
 4166:    __global__ void scaleGravity(double loadtide_coef) {
 4167: 
 4168: 
 4169:       NODE(node);
 4170: 
 4171:       // SAL option: scale gravity
 4172:       if constexpr(iloadtide==2) {  // simple const
 4173:          node->grav2 = grav*(1.0 - loadtide_coef);
 4174: 
 4175:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4176:         
 4177:           const double depth = max(node->depth, 0.0);
 4178:           const double tmp1 = sqrt(depth);
 4179:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4180:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4181:                              2.6969e-13*depth*depth*depth*tmp1;
 4182:           
 4183:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4184:           
 4185: 
 4186: 
 4187:           node->grav2 = grav*(1.0 - beta_bar);
 4188: 
 4189:       } else {  // iloadtide=0,1
 4190:           node->grav2 = grav;
 4191: 
 4192:       }
 4193: 
 4194:    }
 4195: 
