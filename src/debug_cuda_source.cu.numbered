 3969:    __global__ void computeFlowBcVelocities(double time) {
 3970: 
 3971:       SIDE_BND(sideBnd);
 3972: 
 3973:       const Side *side = sideBnd->side;
 3974:  
 3975:       const bool isDry = side->isDry;
 3976: 
 3977:       if (isDry) {
 3978:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 3979:          return;
 3980:       }
 3981: 
 3982:       // For wet sides in open boundaries...
 3983:       const Vector2 n = side->n;
 3984:       const BoundarySegment *segment = sideBnd->segment;
 3985: 
 3986:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 3987: 
 3988:       const int ifltype = segment->ifltype;
 3989:       const int iettype = segment->iettype;
 3990: 
 3991:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 3992:       const Vector2 r_nuth0 = r_uth0*n;
 3993: 
 3994:       for (int k = 0; k < nvrt; k++) {
 3995:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 3996:          Vector2 r_u1_bar = {0.0, 0.0};
 3997:       
 3998:          if (ifltype == 1 || ifltype == 2) {
 3999:          
 4000:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4001: 
 4002:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4003:             
 4004:             r_uth = unth0*n;  // This case has no ramp-up
 4005:             
 4006:          } else if (ifltype == -1) { // Flather 1
 4007: 
 4008:             // uth is the normal vel.; no ramp up
 4009:             const double uth = sideBnd->nuth(k);
 4010:             r_uth = uth*n;
 4011:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4012: 
 4013: 
 4014:          } else if (ifltype == 3 || ifltype == 5) {
 4015:             // vnth0=0 !normal vel.
 4016: 
 4017:             // Computes the contribution to the velocity from all tide frequencies
 4018:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4019: 
 4020:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4021:                const Vector2 umo  = sideBnd->umo(jfr); 
 4022: 
 4023:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4024:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4025:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4026:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4027:             }
 4028: 
 4029:          } // if (ifltype = 3 || ifltype == 5
 4030: 
 4031: 
 4032:          switch (iettype) {
 4033:             case 1:
 4034:             case 2:
 4035:             case 4:
 4036:                sideBnd->ubc[k] = r_uth;
 4037:                break;
 4038:             case 3:
 4039:                sideBnd->ubc[k] = r_u1_bar;
 4040:                break;
 4041:             case 5:
 4042:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4043:                break;
 4044:          } // switch
 4045: 
 4046:       } // for k
 4047:    }
 4048: 
 4049:    __global__ void computeElevationBoundaryConditions(double time) {
 4050:       // Compute elevation essential boundary conditions 
 4051: 
 4052:       NODE_BND(nodeBnd); // Each boundary node.
 4053: 
 4054:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4055: 
 4056:       const Node *node = nodeBnd->node;
 4057:       const BoundarySegment *segment = nodeBnd->segment;
 4058:       const int iettype = segment->iettype;
 4059:       
 4060: 
 4061:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4062:       double eic = 0.0;
 4063:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4064:       else                 eic = 0.0;
 4065: 
 4066:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4067:       const double r_eth = ramp*nodeBnd->eth;
 4068:       double r_eta1_bar = 0.0;
 4069: 
 4070: 
 4071:       // Compute tide elevation
 4072:       if (iettype == 3 || iettype == 5) {   
 4073: 
 4074:          if constexpr(iloadtide==1) { // loading tide
 4075:             assert(false && "Loading tide not implemented");
 4076:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4077:          }
 4078:          
 4079:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4080: 
 4081:             const double efa  = nodeBnd->efa[jfr]; 
 4082:             const double emo  = nodeBnd->emo[jfr]; 
 4083: 
 4084:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4085:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4086:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4087: 
 4088:          } // for jfr
 4089: 
 4090:       } // if iettype
 4091: 
 4092:       switch (iettype) {
 4093:          case 1:
 4094:          case 2:
 4095:          case 4:
 4096:             nodeBnd->elbc = r_eic + r_eth;
 4097:             break;
 4098:          case 3:
 4099:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4100:             break;
 4101:          case 5:
 4102:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4103:             break;
 4104:       } // switch
 4105: 
 4106: 
 4107:       //Add inverse barometric effects
 4108:       if (iettype != 0 && inv_atm_bnd == 1) {
 4109:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4110:       }
 4111: 
 4112:    }
 4113: 
 4114: 
 4115:    __global__ void computeHorizontalViscosity(void) { 
 4116: 
 4117:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4118: 
 4119:       SIDE(side);
 4120: 
 4121:       if (side->isDry) return;
 4122: 
 4123:       for (int k = 0; k < nvrt; k++) {
 4124:          side->nuGradU[k] = {0.0, 0.0};
 4125:       }
 4126: 
 4127:       if constexpr(ihorcon == 1) {
 4128:          for (int k = side->kb; k < nvrt - 1; k++) {
 4129:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4130:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4131:             // By Zhang and Baptista.
 4132: 
 4133:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4134:             // This is a standard discretization of the Laplacian operator.
 4135:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4136:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4137:             // Gamma is hvis_coef0 in the code.
 4138:             // The value of gamma needs to be < 0.5.
 4139: 
 4140:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4141:             // side under consideration in each of the two possible elements that share the side.
 4142:             Vector2 sumU = {0.0, 0.0};
 4143:             for (int l = 0; l < 2; l++) {
 4144:                const Element *elem = side->elems[l];
 4145: 
 4146:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4147: 
 4148:                // Find the local index of the side in the element
 4149:                const int idxSide = elem->sideLocalIdx(side);
 4150:                // Find the two sides that are connected to the side under consideration
 4151:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4152:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4153: 
 4154:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4155: 
 4156:             }
 4157: 
 4158:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4159:    
 4160:          }
 4161:       }
 4162:       else if constexpr(ihorcon == 2) {
 4163:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4164:       }
 4165: 
 4166: 
 4167:    }
 4168: 
 4169: 
 4170:    __global__ void setEssentialBC(void) {
 4171:       // Set essential boundary conditions 
 4172:       NODE(node); // Each boundary node
 4173:       NodeBoundary *nodeBnd = node->nodeBnd;
 4174:       
 4175: // nodeBnd->isEssentialBC = true;      
 4176:       // Check if this node has essential BC
 4177:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4178:          // Verify BC value is valid
 4179:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4180: 
 4181:        
 4182:          // Set diagonal to 1 and zero off-diagonals
 4183:          node->coeffDiag = 1.0;
 4184: 
 4185:          for (int j = 0; j < node->numNodes; j++) {
 4186:                node->coeffMatrix[j] = 0.0;
 4187:          }
 4188:          
 4189:          // Set solution and RHS to BC value
 4190:          node->mX  = nodeBnd->elbc;
 4191:          node->qel = nodeBnd->elbc;
 4192: 
 4193:       } else {
 4194:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4195: 
 4196:          for (int j = 0; j < node->numNodes; j++) {
 4197:                Node* nbNode = node->nodes[j];
 4198:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4199:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4200:                   // Verify neighbor's BC value
 4201:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4202: 
 4203:                   // Subtract contribution to RHS
 4204:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4205:                   node->coeffMatrix[j] = 0.0;  
 4206:                }
 4207:          }
 4208:       }
 4209:    }
 4210: 
 4211: 
 4212:    __global__ void updateElevation(void) {
 4213:       NODE(node);
 4214: 
 4215:       node->eta2 = node->mX;
 4216: 
 4217:       node->updateZCoordData();
 4218:    }
 4219: 
