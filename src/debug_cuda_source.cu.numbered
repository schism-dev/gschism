 3339: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3340:                                             double *emo, double *efa, 
 3341:                                             double *umo, double *ufa, 
 3342:                                             double *vmo, double *vfa) {
 3343: 
 3344: 
 3345:    NODE_BND(nodeBnd);
 3346:    const int idx = idx_node_bnd;    
 3347: 
 3348:    nodeBnd->idx = idx;
 3349: 
 3350:    // Need to find the segment index and the index of the node on the segment
 3351:    int idxNode = -1;
 3352:    int iseg, i;
 3353:    for (iseg = 0; iseg < nope; iseg++) {
 3354:       // for each segment...
 3355:       for (i = 0; i < nond[iseg]; i++) {
 3356:          idxNode = iond[iseg + i*nope];
 3357:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3358:          
 3359:       }
 3360:    }
 3361: 
 3362:    assert(iseg < nope && "iseg is out of bounds");
 3363: 
 3364: found: // Jumped here when the node was found
 3365: 
 3366:    nodeBnd->isEssentialBC = true;
 3367:    nodeBnd->elbc = 0.0;
 3368: 
 3369:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3370: 
 3371:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3372:       nodeBnd->efa[jfr] = efa[idx2];
 3373:       nodeBnd->emo[jfr] = emo[idx2];
 3374:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3375:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3376: 
 3377:    }
 3378:         
 3379: 
 3380: }
