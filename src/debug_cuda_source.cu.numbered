  470: 
  471: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  472: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  473: //
  474: 
  475:    const double radius2 = dot(p, p);
  476:    const double radius = sqrt(radius2);
  477:  
  478:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  479:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  480: 
  481:    rlon = atan2(p.y, p.x); // (-pi,pi]
  482: 
  483:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  484:       rlat = asin(p.z/radius);
  485:    } else {
  486:       rlat = asin(p.z/rearth_pole);
  487:    }
  488:   
  489: }
  490: 
  491: 
  492: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  493: // Compute the 3D Cartesian coordinates from the latitude and longitude
  494: // Inputs:
  495: //        lat: latitude in radians
  496: //        lon: longitude in radians
  497: // Output:
  498: //        x, y, z: 3D Cartesian coordinates
  499: 
  500:    double sin_lat, cos_lat, sin_lon, cos_lon;
  501: 
  502:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  503:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  504: 
  505:    sincos(lat, &sin_lat, &cos_lat);
  506:    sincos(lon, &sin_lon, &cos_lon);
  507: 
  508:    const double x = rearth_eq*cos_lat*cos_lon;
  509:    const double y = rearth_eq*cos_lat*sin_lon;
  510:    const double z = rearth_pole*sin_lat;
  511: 
  512:    return make_double3(x, y, z);
  513: }
