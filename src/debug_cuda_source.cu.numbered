 2604: /**
 2605:  * This method performs backtracking from the side center until a time -dt back in time 
 2606:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2607:  * intermediate point.
 2608:  *
 2609:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2610:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2611:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2612:  * remaining time.
 2613:  * 
 2614:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2615:  * 
 2616:  * @param uuint, vvint, wwint: Velocities at the final point
 2617:  * @param jlev: Level at which the backtracking is performed
 2618:  * @param dt, dtbk: Tracking timesteps
 2619:  * @return: True if the backtracking was successful, false otherwise
 2620:  */
 2621: __inline__ __device__ bool Side::btrack(
 2622:       int jlev,
 2623:       double dt,            // Tracking time
 2624:       double dtbk,          // Tracking timestep
 2625:       Vector3 &u_int        // Velocities at the initial point
 2626: ) const {
 2627: 
 2628:    // Start from side center
 2629:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2630: 
 2631:  
 2632:    double time_rm = dt; // Remaining time
 2633: 
 2634: 
 2635:    // // Initialize outputs XXX
 2636:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2637:    //    sclr[i] = 0.0;
 2638:    // }
 2639: 
 2640: 
 2641:    // Initial velocities
 2642:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2643: 
 2644:    // Find the element that is in the direction opposite to the velocity
 2645:    Element* curElem = findElementTowards(toVector2(u_int));
 2646: 
 2647: 
 2648:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2649:    if (curElem == nullptr) {
 2650:       // Make velocity parallel to the side
 2651:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2652:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2653:       curElem = otherElem(curElem);
 2654:       
 2655:    }
 2656: 
 2657: // Nudges it towards the circumcenter
 2658: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2659: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2660:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2661: const double eps = 9.013e-3;                 
 2662: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2663: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2664: 
 2665: 
 2666: 
 2667:    const int MAX_ITERATIONS = 1000; 
 2668:    Element* nextElem = curElem;
 2669:    int iter = 0;
 2670:    while(true) {
 2671: 
 2672:       // Calculate timestep
 2673:       double dtb = min(dtbk, time_rm);
 2674: 
 2675:       // Next point in the backtracking curve
 2676:       Point3 xt = x0 - dtb*u_int;
 2677:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2678:       assert(found && "Backtracking failed in btrack");
 2679: 
 2680:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2681: 
 2682:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2683:                       // then time_rm needs to be increased by the unused time.
 2684: 
 2685:       // If the velocity is too small, we stop the backtracking
 2686:       const double vmag = length(toVector2(u_int));
 2687:       if (vmag <= velmin_btrack) break;
 2688: 
 2689:       // The current point becomes the next segment's starting point.
 2690:       x0 = xt;
 2691:  
 2692:       curElem = nextElem;
 2693: 
 2694:       iter++;
 2695:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2696:    }
 2697: 
 2698: 
 2699: }
 2700: 
 2701: 
