10704: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
10705:    // Get the value of a variable from an side
10706:    // varName is the name of the variable to get
10707:    // var is the array to store the value
10708:    // k is the vertical level index of the variable to get
10709:    SIDE_BND(sideBnd);   
10710: 
10711:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
10712:    if (sideBnd->segment->isLand) idx = -7;
10713: 
10714:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
10715:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
10716: 
10717: }
