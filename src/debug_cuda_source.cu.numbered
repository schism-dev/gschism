 7243: 
 7244: __global__ void computeMatrixProductAndDotProducts() {
 7245:    // Computes A*p, r'Mr and p'Ap
 7246: 
 7247:    // 1) shared buffer: first half for rMr, second for pAp
 7248:    __shared__ double sdata[2*BLOCK_SIZE];
 7249:    double* s_rMr = sdata;
 7250:    double* s_pAp = sdata + BLOCK_SIZE;
 7251: 
 7252:    const int tid = threadIdx.x;
 7253: 
 7254:    double l_pAp = 0.0;
 7255: 
 7256:    s_rMr[tid] = 0.0;
 7257:    s_pAp[tid] = 0.0;
 7258: 
 7259:    // 2) get your node pointer
 7260:    // NODE(node);   
 7261:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7262:    Node *node = &(mesh->localNodeData[idx_node]); 
 7263:       if (idx_node < mesh->np) {
 7264: 
 7265:       const double diag = node->coeffDiag;
 7266:       const double r    = node->mR;
 7267:       const double p    = node->mP;  
 7268: 
 7269:       // apply preconditioner on the fly:
 7270:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7271: 
 7272:       // 4) compute Ap = A.p
 7273:       double Ap = node->coeffDiag * node->mP;
 7274:       for (int j = 0; j < node->numNodes; ++j) {
 7275:          const Node *nbNode = node->nodes[j];
 7276:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7277: 
 7278:       }
 7279: 
 7280:       node->mAp = Ap;
 7281:       
 7282: 
 7283:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7284:       // const double l_rMr = r*Mr;  // r'Mr
 7285:       l_pAp = p*Ap;  // p'Ap
 7286: 
 7287: 
 7288:    }
 7289: 
 7290:    // 6) write into shared mem
 7291:    // s_rMr[tid] = l_rMr;
 7292:    s_pAp[tid] = l_pAp;
 7293: 
 7294:    __syncthreads();
 7295: 
 7296:    // 7) block-wide tree reduction
 7297:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7298:       if (tid < stride)  {
 7299:          s_pAp[tid] += s_pAp[tid + stride];
 7300:       }
 7301:       __syncthreads();
 7302:    }
 7303: 
 7304:    // 8) thread 0 atomically accumulates into the globals
 7305:    // XXX: This is slower than it needs to be, but it is simple and works
 7306:    if (tid == 0) {
 7307:       atomicAdd(pAp, s_pAp[0]);
 7308:    }
 7309: 
 7310: 
 7311: }
 7312: 
 7313: 
 7314: __global__ void updateSolutionAndDotProducts(void) {
 7315:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7316: 
 7317:    const int tid = threadIdx.x;
 7318: 
 7319:    s_rMr[tid] = 0.0;
 7320: 
 7321:    // get node & bounds-check:
 7322:    NODE(node);
 7323: 
 7324:    
 7325:    // Compute alpha
 7326:    const double alpha = (*rMr_old)/(*pAp); 
 7327: 
 7328: 
 7329:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7330: 
 7331: 
 7332:    // load scalars
 7333:    const double diag = node->coeffDiag;
 7334:    const double p    = node->mP;
 7335:    const double Ap   = node->mAp;
 7336:    const double x    = node->mX;
 7337:    const double r    = node->mR;
 7338:    
 7339:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7340: 
 7341:    // 1) update solution & residual
 7342:    const double x_new = x + alpha*p;
 7343:    const double r_new = r - alpha*Ap;
 7344:    node->mX = x_new;
 7345:    node->mR = r_new;
 7346: 
 7347:    // 2) apply Jacobi preconditioner on the fly
 7348:    const double Mr_new = r_new/diag;
 7349: 
 7350: 
 7351:    // 3) local contributions for the two dot-products
 7352:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7353: 
 7354:    // 4) write into shared-mem
 7355:    s_rMr[tid] = l_rMr;
 7356: 
 7357:    __syncthreads();
 7358: 
 7359: 
 7360:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7361:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7362:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7363:       __syncthreads();
 7364:    }
 7365: 
 7366:    // 6) thread 0 atomically folds into the global accumulators
 7367:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7368: 
 7369: 
 7370: }
 7371: 
 7372: 
 7373: __global__ void updateSearchDirection() {
 7374: 
 7375:     NODE(node);
 7376: 
 7377:     // recompute z on-the-fly
 7378:     const double z = node->mR / node->coeffDiag;
 7379:     const double p = node->mP;
 7380: 
 7381:     const double beta = (*rMr_new)/(*rMr_old);
 7382: 
 7383: 
 7384:     // p =z + beta*p
 7385:     node->mP = z + beta*p;
 7386: 
 7387: }
 7388: 
 7389: __global__ void initializeScalars(double *scalars) {
 7390: 
 7391:    // These point to a cupy array in the host code
 7392:    rMr_old = scalars + 0;
 7393:    rMr_new = scalars + 1;
 7394:    pAp     = scalars + 2;
 7395: }
 7396: 
 7397: __global__ void initializePreconditionedResidual(void) {
 7398: 
 7399:     __shared__ double s_rMr[BLOCK_SIZE];  
 7400: 
 7401:     s_rMr[threadIdx.x] = 0.0;
 7402: 
 7403:     NODE_ALL(node, valid);
 7404:     const int tid = threadIdx.x;
 7405:     // For the first iteration:
 7406:     // 1. Initial solution x = 0 (already set)
 7407:     // 2. Initial residual r = b (stored in qel)
 7408:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7409: 
 7410: // XXX we should use the guess solution here    
 7411: 
 7412:     double l_rMr = 0.0;
 7413:     if (valid) {
 7414:       // Set initial residual r = b (from qel)
 7415:       node->mR = node->qel;
 7416: 
 7417:       // Compute z = M^-1 * r (preconditioned residual)
 7418:       const double z = node->mR / node->coeffDiag;
 7419: 
 7420:       // Set initial search direction p = z
 7421:       node->mP = z;
 7422: 
 7423:       // Initialize other variables needed for CG
 7424:       node->mX = 0.0;  // Initial solution
 7425:       node->mAp = 0.0; // Will be computed in first iteration
 7426: 
 7427: 
 7428:       // Computes the first r'Mr (reduction)
 7429:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7430:     }
 7431:     // 4) write into shared-mem
 7432:     s_rMr[tid] = l_rMr;
 7433: 
 7434:     __syncthreads();
 7435: 
 7436: 
 7437:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7438:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7439:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7440:         __syncthreads();
 7441:     }
 7442: 
 7443:     // 6) thread 0 atomically folds into the global accumulators
 7444:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7445: 
 7446:     *rMr_old = 0.0;
 7447:     *pAp = 0.0;
 7448: }
 7449: 
 7450: 
