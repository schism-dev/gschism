 6671: 
 6672:    __global__ void computeVegetationAndDragParameters(void) {
 6673:       // Computes the vegetation and drag model parameters:
 6674:       // chi, \tilde\chi, beta, \breve{H}
 6675:       
 6676:       SIDE(side);
 6677: 
 6678:       side->hhat = 0.0;
 6679:       side->chi2 = 0.0;
 6680:       side->chi = 0.0;
 6681:       side->veg_c2 = 0.0;
 6682:       side->veg_beta = 0.0;
 6683: 
 6684:       if (side->isDry) return;
 6685: 
 6686:       const double htot = side->htot2();
 6687:       const int    kb   = side->kb;
 6688: 
 6689:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6690: 
 6691:       const double veg_h     = side->veg_h();
 6692:       const double veg_nv    = side->veg_nv();
 6693:       const double veg_c     = side->veg_c();
 6694:       const double veg_beta  = side->veg_beta;
 6695:       const double veg_alpha = side->veg_alpha_vert_mean();
 6696: 
 6697:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6698:       // Velocity magnitude at the bottom level
 6699:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6700:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6701:       side->chi2 = side->Cd()*vmag1;
 6702:       side->chi  = side->chi2;
 6703: 
 6704:       if constexpr(iveg != 0) {
 6705:          const Node *n1 = side->n1;
 6706:          const Node *n2 = side->n2;
 6707:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6708:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6709:       }
 6710: 
 6711:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6712: 
 6713:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6714:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6715:       double magUa = 0.0;
 6716:       if constexpr(iveg != 0) {
 6717:          if (side->is3D() && veg_h > 0.0) {
 6718:             // 3D wet side with veg...
 6719: 
 6720:             double magUa = 0.0;
 6721:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6722:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6723: 
 6724:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6725:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6726:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6727: 
 6728:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6729:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6730: 
 6731:                   // Velocity magnitude at the bottom (l) of the level
 6732:                   const double ul = length(side->u2[k]);
 6733: 
 6734:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6735:                   magUa += Dz*0.5*(uh + ul);
 6736: 
 6737:                } // if HasVegetation
 6738:             } // for k
 6739:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6740: 
 6741:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6742:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6743:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6744:                const double zCpy = side->zTopCanopy();
 6745:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6746:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6747:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6748:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6749:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6750:             } // if isSubmerged
 6751:          } // if is3D
 6752:       } // if iveg   
 6753: 
 6754:       // Computes the friction modified depth, \breve{H} in notes
 6755:       if (side->is2D()) { // 2D
 6756: 
 6757:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6758:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6759: 
 6760:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6761: 
 6762:          side->hhat = htot*htot/fricH; 
 6763: 
 6764:       } else { // 3D
 6765:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6766: 
 6767:          if constexpr(iveg != 0) {
 6768:             
 6769:             if (side->isSubmerged()) { 
 6770:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6771:                side->hhat -= veg_c*Hhat_alpha;
 6772: 
 6773:             } else { // Emergent
 6774:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6775:             }
 6776:          } // if iveg
 6777: 
 6778:          // Enforce positivity for 3D model
 6779:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6780:       } // if 3D
 6781: 
 6782:    }
 6783: 
 6784: 
 6785: 
 6786:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6787:    // Computes the density gradient between two elements, e1 and e2.
 6788:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6789:    // zero in the direction normal to the side. 
 6790:    // 
 6791:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6792:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6793:    //
 6794:    // Input:
 6795:    //    e1: Element
 6796:    //    e2: Neighbor element (or nullptr if boundary)
 6797:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6798:    //    k: Index of the half-level at which the density is interpolated
 6799:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6800:    // 
 6801:    // Output:
 6802:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6803:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6804: 
 6805:       if (e2 == nullptr || e2->isDry) {
 6806:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6807: 
 6808:          Side *side = e1->sides[j];
 6809:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6810:                  
 6811:          if constexpr(ics == 1) {
 6812:             vec = side->n; // Normal vector to the side
 6813:          } else {
 6814:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6815:             // IMPLEMENT THIS XXXXXX
 6816:             // !replace with xel, yel?
 6817:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6818:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6819:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6820:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6821:          } //ics
 6822:                    
 6823:          diffRho = 0.0;
 6824: 
 6825:       } else { //internal and wet
 6826:          if constexpr(ics==1) {
 6827:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6828: 
 6829:             // Vector from e1 to e2
 6830:             vec = e2->center - e1->center;
 6831: 
 6832:          } else { 
 6833:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6834:             // Remember that elem->center is in global coordinates
 6835:             // IMPLEMENT THIS XXXXXX
 6836:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6837:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6838:             //                   alow(j)=xctr2
 6839:             //                   bdia(j)=yctr2
 6840:          } // ics
 6841: 
 6842:          diffRho = rho2 - e1->demeanedDensity(k);
 6843:       }
 6844: 
 6845:    }
 6846: 
 6847:    __global__ void computeDensityCubicSplines(void) {
 6848:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6849: 
 6850:       ELEM(elem);
 6851: 
 6852:       if (elem->isDry) return;
 6853: 
 6854:       const int kb = elem->kb;
 6855: 
 6856:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6857:       if (elem->is2D()) {
 6858:          // In the 2D case, the density is constant at the prism level. 
 6859:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6860:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6861:       } else { //3D
 6862: 
 6863:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6864:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6865:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6866:          ///// XXXX CHECK INDICES!!!!!
 6867:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6868:       } // 2D/3D
 6869: 
 6870:    }
 6871: } // extern "C"
 6872: 
 6873: 
 6874: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6875: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6876: 
 6877:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6878: 
 6879:    const int kb  = elem->kb;
 6880:    const int kb2 = elem2->kb;
 6881: 
 6882:    // z-coordinate of prism of elem
 6883:    const double zp = elem->z_prism(k);
 6884: 
 6885:    double rho = 0.0;
 6886: 
 6887:    if (elem2->is2D()) {
 6888:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6889: 
 6890:    } else {  // 3D
 6891: 
 6892:       // eta_min may be < zmax
 6893:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6894:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6895: 
 6896:       // (Extrapolate density below bottom, we will fix it later)
 6897:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6898:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6899:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6900:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6901:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6902:    } // 2D/3D
 6903:      
 6904: 
 6905:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6906:    // Now we need to fix it.
 6907:    if (elem->z[k] < elem2->z[kb2]) {
 6908:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6909: 
 6910:       // There are two methods to adjust the density at the bottom of the element.
 6911:       // iunder_deep=0: 
 6912:       const double depth1 = abs(elem->z[kb]); // larger depth
 6913: 
 6914:       if (iunder_deep==0) {
 6915: 
 6916:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6917: 
 6918:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6919: 
 6920:       } else { // iunder_deep != 0
 6921: 
 6922:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6923: 
 6924:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6925: 
 6926:          //   Demeaned density at the same z coordinate as
 6927:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6928:          }
 6929: 
 6930:       } // if iunder_deep
 6931:    } // if elem->z[kb] < elem2->z[kb]
 6932: 
 6933:    return rho;
 6934: }
 6935: 
 6936: 
 6937: extern "C" {
 6938:    __global__ void computeDensityGradient(void) {
 6939: 
 6940:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6941:       if constexpr(ibc != 0) return;
 6942: 
 6943:          // Compute the horizontal density gradient at each element.
 6944:       // It works in two steps:
 6945:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6946:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6947:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6948:       //             gradRho.r1 = rho1 - rho0
 6949:       //             gradRho.r2 = rho2 - rho0
 6950:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6951:       // 
 6952:       //  NOTE: We use de-meaned densities.
 6953: 
 6954:       ELEM(elem);
 6955: 
 6956:       if (elem->isDry) return;
 6957: 
 6958:       const int kb  = elem->kb;
 6959:       const int i34 = elem->i34;
 6960: 
 6961:       for (int k = kb + 1; k < nvrt; k++) {
 6962:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6963:          //             gradRho.r1 = rho1 - rho0
 6964:          //             gradRho.r2 = rho2 - rho0
 6965:          int icount = 0;
 6966:          double sumRx = 0.0;
 6967:          double sumRy = 0.0;
 6968:          for (int j1=0; j1<i34; j1++) { 
 6969: 
 6970:             const int j2 = elem->nxq(j1 + 1);
 6971: 
 6972:             // Pairs of consecutive neighbor elements of elem
 6973:             const Element *e1 = elem->nghbElems[j1];
 6974:             const Element *e2 = elem->nghbElems[j2];
 6975: 
 6976:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6977:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6978:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6979: 
 6980:             // Compute the density difference and the vector from elem to e1 and e2
 6981:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6982:             double diffRho1, diffRho2;
 6983:             Vector2 vec1, vec2;
 6984:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6985:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6986: 
 6987:             const double rl1 = length(vec1);
 6988:             const double rl2 = length(vec2);
 6989:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6990: 
 6991:             const double delta = cross(vec1, vec2);
 6992:             const double sintheta = abs(delta)/(rl1*rl2);
 6993: 
 6994:             // To avoid problems, avoid elements with small angle between vectors
 6995:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6996:             const bool validEq = (sintheta > sin_one_deg);
 6997: 
 6998:             if (validEq) {
 6999:                // Solve the system of equations to get the density gradient at elem
 7000:                icount++;
 7001:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7002:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7003:                sumRx += Rx;
 7004:                sumRy += Ry;
 7005:             }
 7006:          } // for j1
 7007: 
 7008:          // Compute the average density gradient at elem
 7009:          if (icount==0) {
 7010:            // Bad mesh quality; bail out with 0 b-cc
 7011:            elem->gradRho[k] = {0.0, 0.0};
 7012:          } else {
 7013:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7014:          }
 7015: 
 7016:       } // for k
 7017: 
 7018:    }
 7019: 
 7020:    __global__ void computeBaroclinicTerm(void) {
 7021:    // Computes the baroclinic term at sides (at half levels).
 7022:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7023:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7024: 
 7025:       if (ibc == 1) return;
 7026: 
 7027:       SIDE(side);
 7028: 
 7029:       if (side->isDry) return;
 7030: 
 7031:       const Element *e1 = side->elems[0];
 7032:       const Element *e2 = side->elems[1]; 
 7033:       const int kb = side->kb;
 7034:       
 7035:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7036: 
 7037:       // interpolates vertically the density gradient of the two elements at the half level/
 7038: 
 7039:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7040:       int k2 = max(kb, nvrt / 2);
 7041: 
 7042:       // Starts the integration at the surface and goes down to the bottom
 7043:       side->bcc[nvrt-1] = {0.0, 0.0};
 7044:       for (int k = nvrt - 2; k >= kb; k--) {
 7045:       // For each prism level (from surface to bottom)...
 7046: 
 7047:          // For both elements, interpolate density gradient at the side's half level.
 7048:          // The gradient at the side is the average of the gradients at the elements.
 7049:          // w1, w2 are used to take into account boundary sides, with just one element.
 7050:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7051:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7052:          const double wsum = w1 + w2;
 7053:          w1 = w1/wsum;
 7054:          w2 = w2/wsum;
 7055:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7056: 
 7057:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7058:          Vector2 gradRho = {0.0, 0.0};
 7059:          if (e1 != nullptr && k > kb) {
 7060:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7061:             
 7062:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7063:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7064:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7065: 
 7066:             // Grad(rho) vertically interpolated at the side's half level
 7067:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7068: 
 7069:             // Projects the element density gradient to the side frame if needed.
 7070:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7071: 
 7072:             // Adds the contribution of the density gradient at the side's half level
 7073:             gradRho += gradRho1*w1;
 7074:          }      
 7075:          if (e2 != nullptr && k > kb) {
 7076:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7077:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7078:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7079:             
 7080:             // Grad(rho) vertically interpolated at the side's half level
 7081:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7082: 
 7083:             // Projects the element density gradient to the side frame if needed.
 7084:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7085: 
 7086:             // Adds the contribution of the density gradient at the side's half level
 7087:             gradRho += gradRho2*w2;
 7088:          }
 7089: 
 7090:          
 7091:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7092:          // multiplied by -rampbc*(g/rho0) 
 7093:          const double grav3 = side->grav3();
 7094:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7095: 
 7096:       } // for
 7097: 
 7098:    }
 7099: 
 7100: 
 7101: 
 7102:    __global__ void computeHorGradientAtSide(void) {
 7103: 
 7104:       // Compute the horizontal density gradient at each element.
 7105:       // It works in two steps:
 7106:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7107:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7108:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7109:       //             gradRho.r1 = rho1 - rho0
 7110:       //             gradRho.r2 = rho2 - rho0
 7111:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7112:       // 
 7113:       //  NOTE: We use de-meaned densities.
 7114: 
 7115:       SIDE(side);
 7116: 
 7117: 
 7118:       if (side->isDry) return;
 7119: 
 7120:       // Computes the gradient of the variables at the side center.
 7121:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7122:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7123:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7124: 
 7125:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7126:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7127:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7128:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7129: 
 7130:    }
 7131: 
 7132: 
 7133:    __global__ void solveMomentumEquations(double time) {
 7134: 
 7135:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7136:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7137: 
 7138:       SIDE(side);
 7139: 
 7140:       if (side->isDry) 
 7141:       {
 7142:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7143: 
 7144:          return;
 7145:       }
 7146: 
 7147:       const Node *n1 = side->n1;
 7148:       const Node *n2 = side->n2;
 7149: 
 7150:       const int kb = side->kb;
 7151: 
 7152:       const double veg_h = side->veg_h();
 7153:       const double grav3 = side->grav3();
 7154: 
 7155:       if (side->is2D()) {
 7156:          // Remember: Do not use htot2, which is updated.
 7157:          const double htot = side->htot1();
 7158:          const double hhat = side->hhat;
 7159: 
 7160:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7161: 
 7162:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7163:          const Vector2 tau2 = side->tau();
 7164: 
 7165:          // hat_gam has units of m/s
 7166: 
 7167:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7168:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7169:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7170: 
 7171:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7172: 
 7173: 
 7174:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7175: 
 7176:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7177: 
 7178:       }
 7179:       else { // 3D
 7180: 
 7181:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7182:          // 
 7183:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7184:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7185:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7186:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7187:          // k+1 and k.
 7188: 
 7189: 
 7190:          const int ndim = nvrt - kb;
 7191:          const double zTopCanopy = side->zTopCanopy();
 7192: 
 7193:          // Initialize the tridiagonal system
 7194:          for (int k = kb + 1; k < nvrt; k++) {
 7195:             
 7196:             const int kin = k - (kb + 1);
 7197: 
 7198:             // Vertical viscosity at the face center
 7199:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 7200: 
 7201:  
 7202:             alow[kin] = 0.0;
 7203:             cupp[kin] = 0.0;
 7204:             bdia[kin] = 0.0;
 7205: 
 7206:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7207:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7208: 
 7209:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7210:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7211:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7212: 
 7213:             // First part: layers k, k+1
 7214:             if (k < nvrt - 1) {
 7215:                              
 7216:                if constexpr(iveg != 0) {
 7217: 
 7218:                   // If there is vegetation at this level...
 7219:                   if (zTopCanopy > side->zc[k]) {
 7220:                      // If the canopy is above the k layer...
 7221:                      
 7222:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7223:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7224:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7225:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7226: 
 7227:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7228:                      const double vmag2 = length(ut2);
 7229:                      const double vmag1 = length(side->u2[k]);
 7230:                      const double vmag = 0.5*(vmag1 + vmag2);
 7231:                      
 7232:                      // Computes the vegetation alpha at the face center
 7233:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7234: 
 7235:                      cff1 += veg_alpha_sd*dt*vmag;
 7236: 
 7237:                   } // if (zTopCanopy
 7238:                } // if iveg
 7239: 
 7240:                const double dzz = side->Dz(k + 1);
 7241:                const double tmp = dt*dfz/dzz;
 7242:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7243: 
 7244:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7245:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7246:             }
 7247: 
 7248: 
 7249:             // Second part: layers k-1, k
 7250:             if (k > kb + 1) {
 7251: 
 7252:                double cff1 = 1.0; //init \bar{c^k}
 7253: 
 7254:                if constexpr(iveg != 0) {
 7255:                   // If there is vegetation at this level...
 7256:                   if (zTopCanopy > side->zc[k-1]) {
 7257:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7258:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7259: 
 7260:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7261: 
 7262:                      const double vmag2 = length(ut2);
 7263:                      const double vmag1 = length(side->u2[k-1]);
 7264:                      const double vmag = 0.5*(vmag1 + vmag2);
 7265: 
 7266:                      // Computes the vegetation alpha at the face center
 7267:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7268:                      cff1 += veg_alpha_sd*dt*vmag;
 7269:                   } // if zTopCanopy
 7270: 
 7271:                } // if iveg
 7272: 
 7273:                const double dzz = side->Dz(k);
 7274:                const double tmp = dt*dfz/dzz;
 7275:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7276: 
 7277:                alow[kin] += cff1*dzz/6.0 - tmp;
 7278:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7279: 
 7280:             } else { // Bottom boundary
 7281:                // This occurs at the bottom, where the bottom drag is applied.
 7282: 
 7283:                bdia[kin] += dt*side->chi2; // XXXX
 7284: 
 7285:             } // if (k > kb + 1)
 7286: 
 7287: 
 7288:          } // for (int k
 7289: 
 7290: 
 7291: 
 7292:          // Computes the RHS.
 7293:          // -----------------
 7294: 
 7295:          //	BC to be imposed at the end.
 7296: 
 7297:          const Vector2 gradETP  = side->gradETP;
 7298:          const Vector2 gradPr   = side->gradPr;
 7299:          const Vector2 gradEta1 = side->gradEta1;
 7300:          const Vector2 gradEta2 = side->gradEta2;
 7301: 
 7302:          const Vector2 *btu = side->btu;
 7303:          const Vector2 *u2  = side->u2;
 7304:          const double coriolis = side->coriolis;
 7305:          const Vector2 *nuGradU = side->nuGradU;
 7306: 
 7307:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7308:          for (int k = kb + 1; k < nvrt; k++) {
 7309:             const int kin = k - kb - 1;
 7310: 
 7311:             const double dz_0 = side->Dz(k);
 7312:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7313: 
 7314:             rrhs[kin] = {0.0, 0.0};
 7315:             double dz = 0.0;
 7316: 
 7317:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7318:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7319:             if (k < nvrt  ) dz += dz_1;
 7320:             if (k > kb + 1) dz += dz_0;
 7321: 
 7322:             // Elevation gradient, atmospheric pressure and tidal potential
 7323:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7324: 
 7325:             // Coriolis, advection, wind stress, and horizontal viscosity
 7326:             if (k < nvrt - 1) {
 7327: 
 7328: 
 7329:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7330:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7331:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7332:                                                 
 7333: 
 7334:                //diff stress tensors 1006
 7335:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7336:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7337:                   assert(false && "Not implemented: itur == 5");
 7338:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7339:                }
 7340:                // else assert(false && "itur # Not implemented");
 7341: 
 7342:             } else { // k == nvrt - 1 SURFACE
 7343:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7344:                const Vector2 tau2 = side->tau();
 7345: 
 7346:                rrhs[kin] += dt*tau2;          
 7347: 
 7348:             } // if k<nvrt
 7349: 
 7350: 
 7351:             if (k > kb + 1) {
 7352:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7353:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7354:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7355: 
 7356:                // diff stress tensors 1006
 7357:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7358:                   assert(false && "Not implemented: itur == 5");
 7359:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7360:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7361:                }
 7362:                // else assert(false && "itur # Not implemented");
 7363: 
 7364: 
 7365:             } // if k>kbs + 1
 7366: 
 7367:             // Baroclinic
 7368:             Vector2 *bcc = side->bcc;
 7369:             if constexpr(ibc == 0) {
 7370:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7371:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7372: 
 7373:             } // if ibc==0
 7374: 
 7375:          } // k=kb + 1,nvrt
 7376: 
 7377: 
 7378:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7379: 
 7380:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7381:             const int kin = k - kb - 1;
 7382:    
 7383:             // Velocity is always clamped to maximum values
 7384:             side->u2[k] = clampVelocity(soln[kin]);
 7385:          } // k
 7386: 
 7387:       } // if side->is2D()
 7388:       
 7389: 
 7390:       // Impose velocity boundary condition at the bottom
 7391:       if constexpr(imm == 2) { // 3D bed deformation model
 7392:          double dep;
 7393:          Vector2 vel;
 7394: 
 7395:          assert(false && "Not implemented: imm == 2");
 7396:          //update_bdef(time, x0, y0, dep, vel);
 7397:          // side->u2[kb] = vel;
 7398: 
 7399:       } else { // imm = 0 or 1
 7400:          if (side->Cd() == 0.0) {
 7401:             side->u2[kb] = side->u2[kb + 1];
 7402: 
 7403:          } else if (side->is3D()) { // 3D no slip bottom   
 7404:             side->u2[kb] = {0.0, 0.0};
 7405: 
 7406:          }
 7407:           
 7408:       } // if imm
 7409: 
 7410:       // The velocities below the bottom level are set to zero
 7411:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7412: 
 7413: 
 7414:    }
 7415: 
 7416: 
 7417:    __global__ void applyMomentumBC(void) {
 7418: 
 7419:       SIDE_BND(sideBnd);
 7420: 
 7421:       Side *side = sideBnd->side;
 7422:       const BoundarySegment *segment = sideBnd->segment;
 7423:       const Node *n1 = side->n1;
 7424:       const Node *n2 = side->n2;
 7425: 
 7426:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7427: 
 7428:       const bool isLand = segment->isLand;
 7429:       const int ifltype = segment->ifltype;
 7430: 
 7431:       const int kb = side->kb;
 7432: 
 7433: 
 7434:       if (!isLand && ifltype != 0) {
 7435:          const Vector2 *ubc = sideBnd->ubc;
 7436:   
 7437:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7438:             
 7439:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7440:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7441: 
 7442:             if (ifltype == -1) {
 7443:                // Flather 1
 7444: 
 7445:                const double depth = side->depth();
 7446: 
 7447:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7448: 
 7449:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7450: 
 7451:                side->u2[k] = vnorm*side->n;
 7452: 
 7453:             } else if (ifltype == -2) { // Discharge
 7454: 
 7455:                const double eta1 = side->eta1();
 7456:                const double eta2 = side->eta2();
 7457:                const double htot = side->htot2();
 7458: 
 7459:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7460:                assert(false && "Not implemented: Discharge bc");
 7461:                // const double dischrg = discharge(eta1);
 7462:                const double dischrg = 0.0; // XXX REMOVE
 7463:                
 7464: 
 7465:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7466: 
 7467:                const double vnorm = dischrg*eta2/htot;
 7468: 
 7469:                side->u2[k] = vnorm*side->n;
 7470: 
 7471:             }
 7472:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7473:                const double vnorm = dot(side->u2[k], side->n);
 7474: 
 7475:                double rat;
 7476:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7477:                else              rat = segment->vobc2; // outgoing
 7478: 
 7479:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7480: 
 7481:             }
 7482:             else { // not Flather or 3D radiation
 7483: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7484:                side->u2[k] = ubc[k];
 7485: 
 7486:             } // if (segment->ifltype...
 7487: 
 7488:          }
 7489: 
 7490:       }
 7491:       else if (isLand) { // if it is land boundary side
 7492: 
 7493:          if constexpr(islip == 0) { // free slip
 7494: 
 7495:             for (int k = kb; k < nvrt; k++) {
 7496: 
 7497:                const Vector2 t = side->t();
 7498:                const Vector2 n = side->n;
 7499: 
 7500:                double vnorm = 0.0; // for most cases
 7501:                const double vtan = dot(side->u2[k], t);
 7502:                
 7503:                side->u2[k] = vtan*t - vnorm*n;
 7504: 
 7505:             }
 7506: 
 7507:          } else { // no slip
 7508:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7509: 
 7510:          }
 7511:       } // if (side segment type...
 7512: 
 7513:    }
 7514: 
 7515: 
 7516:    __global__ void shapiroFilter1(void) {
 7517:       // First step of the Shapiro filter (normally used if indvel<=0)
 7518:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7519: 
 7520:       SIDE(side);
 7521: 
 7522:       // Only internal wet sides are processed
 7523:       if (side->isDry || !(side->isInternal())) return;
 7524: 
 7525:       const int kb = side->kb;
 7526: 
 7527:       for (int mm = 0; mm < niter_shap; mm++) {
 7528: 
 7529:          for (int k = kb + 1; k < nvrt; k++) {
 7530:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7531:             Vector2 suru = {0.0, 0.0};
 7532: 
 7533:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7534: 
 7535:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7536: 
 7537:                int kin = k;
 7538:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7539:                
 7540:                // Get the velocity at the neighbor's side.
 7541:                Vector2 nSideU2 = nSide->u2[kin];
 7542: 
 7543:                // Projects the velocity to the current side frame if needed.
 7544:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7545: 
 7546:                suru += nSideU2;
 7547:             }
 7548: 
 7549:             // Reusing bcc as a temporary array to store the suru values.
 7550:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7551: 
 7552:          }
 7553:       }
 7554:    }
 7555: 
 7556:    __global__ void shapiroFilter2(void) {
 7557:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7558: 
 7559:       SIDE(side);
 7560: 
 7561: 
 7562:       if (side->isDry || !(side->isInternal())) return;
 7563: 
 7564:       const int kb = side->kb;
 7565: 
 7566:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7567: 
 7568:       if (side->is2D()) {
 7569:          side->u2[kb + 1] = side->bcc[kb + 1];
 7570:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7571: 
 7572:       } else {
 7573:          // 3D
 7574:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7575:          
 7576:       }
 7577: 
 7578:    }
 7579: 
 7580: 
 7581:    __global__ void ul0UpdateZCoords(void) {
 7582:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7583:       
 7584:       NODE(node);      
 7585: 
 7586: 
 7587:       if (false) { //node->isDry) { XXXXXXX
 7588: 
 7589:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7590: 
 7591:          if constexpr(ivcor != 1) node->kb = 0;
 7592: 
 7593:       } else {
 7594: 
 7595:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7596:          node->updateKb();
 7597: 
 7598:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7599: 
 7600:       }
 7601: 
 7602:       // We use the temp.b field to store the previous state of isDry.
 7603:       node->tmp.b = node->isDry;
 7604: 
 7605:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7606:       node->isDry = true;
 7607: 
 7608:    }
 7609: 
 7610:    __global__ void ul0ComputeDryElements(void)
 7611:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7612:    {
 7613:       ELEM(elem);
 7614: 
 7615:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7616: 
 7617:       elem->kb = 0;
 7618: 
 7619:       if (elem->isDry) return;
 7620: 
 7621: 
 7622:    //    if(elem->isDry2()) { // XXXX
 7623:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7624:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7625:    //        call parallel_abort(errmsg)
 7626:    //    }
 7627: 
 7628:       const Node *n1 = elem->nodes[0];
 7629:       const Node *n2 = elem->nodes[1];
 7630:       const Node *n3 = elem->nodes[2];  
 7631:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7632: 
 7633:       // Computes element's kb as the minimum of the nodes' kb.
 7634:       const int kb1 = n1->kb;
 7635:       const int kb2 = n2->kb;
 7636:       const int kb3 = n3->kb;
 7637:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7638: 
 7639: 
 7640:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7641: 
 7642: 
 7643:       // Computes the element z as the mean of the nodes z.
 7644:       for (int k = elem->kb; k < nvrt; k++) {
 7645: 
 7646:          // Compute the element z as the mean of the nodes z.
 7647:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7648:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7649:          elem->z[k] /= elem->i34;
 7650: 
 7651:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7652:       }
 7653:                   
 7654:    }
 7655: 
 7656:    __global__ void ul0ComputeDryNodes(void)
 7657:    // Updates node's isDry based on the elements' isDry. 
 7658:    {
 7659:       NODE(node);
 7660: 
 7661:       node->isDry = true;
 7662: 
 7663:       // A node is wet if at least one of the elements sharing it is wet.
 7664:       for (int j = 0; j < node->numElements; j++) {
 7665:          const Element *elem = node->elements[j];
 7666:          if (!elem->isDry) {
 7667:             node->isDry = false;
 7668:             break;
 7669:          }
 7670:       }
 7671: 
 7672:        
 7673:    }
 7674: 
 7675: 
 7676:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7677:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7678:    // node->tmp.b is true if the node was previously dry.
 7679:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7680:    {
 7681:       NODE(node);
 7682:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7683: 
 7684:       // Avoid this the first time step.
 7685:       if (it == iths) return;  
 7686: 
 7687:       const bool wasDry = node->tmp.b;
 7688: 
 7689: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7690: 
 7691:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7692: 
 7693:          for (int k=0; k < nvrt; k++) {
 7694: 
 7695:             Vector3 utmp={0.0, 0.0, 0.0};
 7696: 
 7697:             double ttmp=0.0;
 7698:             double stmp=0.0;
 7699:             int icount=0;
 7700:             for (int j = 0; j < node->numNodes; j++) {
 7701: 
 7702:                const Node *nbrNode = node->nodes[j];
 7703:                
 7704:                const bool wasNbrDry = nbrNode->tmp.b;
 7705: 
 7706:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7707:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7708: 
 7709:                   icount++;
 7710: 
 7711:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7712:                   utmp += nbrNode->uvw2(k);
 7713:                   
 7714:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7715:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7716:                }
 7717:             }
 7718: 
 7719:             if (icount > 0) {
 7720:                const double inv_icount = 1.0/icount;
 7721:                utmp = inv_icount*utmp;
 7722:                node->u2[k]     = {utmp.x, utmp.y};
 7723:                node->w2[k]     = utmp.z;
 7724:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7725:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7726:             } else {
 7727:                node->u2[k] = {0.0, 0.0};
 7728:                node->w2[k] = 0.0;
 7729:                // Initialize tracers to 0.0??? XXXXX
 7730:             }
 7731:          }
 7732:       }
 7733:    }
 7734: 
 7735:   
 7736:    
 7737: 
 7738: 
 7739:    __global__ void ul0UpdateSides(int it, int iths) {
 7740:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7741:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7742:    // The dryness of the sides is updated in ul0UpdateSides2.
 7743: 
 7744:       SIDE(side);
 7745: 
 7746:       // A side is wet if and only if at least one of its elements is wet.
 7747:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7748:  
 7749:       const Node *n1 = side->n1;
 7750:       const Node *n2 = side->n2;
 7751:      
 7752:       const int kb1 = n1->kb;
 7753:       const int kb2 = n2->kb;
 7754: 
 7755:       side->kb = 0; // default when dry
 7756: 
 7757:       if (isWet) {
 7758: 
 7759:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7760: 
 7761:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7762: 
 7763:          side->kb = min(kb1, kb2);
 7764: 
 7765:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7766: 
 7767:          for (int k = side->kb; k < nvrt; k++) {
 7768:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7769: 
 7770:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7771: 
 7772:             // Compute velocity for re-wetted sides 
 7773:             if ((it != iths) && (side->isDry && isWet)) {
 7774: 
 7775:                Vector2 utmp={0.0, 0.0};
 7776: 
 7777:                int icount=0;
 7778: 
 7779:                // For all the sides on the two elements that share this side
 7780:                for (int j = 0; j < 2; j++) {
 7781:                   const Element *elem = side->elems[j];
 7782:                   if (elem == nullptr) continue;
 7783: 
 7784:                   for (int jj=0; jj < elem->i34; jj++) {
 7785:                      const Side *nSide = elem->sides[jj];
 7786:                      if (nSide->isDry) continue;
 7787: 
 7788:                      icount++;
 7789:                      utmp += nSide->u2[k];  
 7790:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7791:                   }
 7792:                }
 7793:                   
 7794:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7795:                if (icount > 0)  side->u2[k] = utmp/icount;
 7796:                else             side->u2[k] = {0.0, 0.0};
 7797:                   
 7798:             } // if ((it != iths) && (side->isDry && isWet))
 7799: 
 7800:          } // for k
 7801: 
 7802:       } // if isWet 
 7803:       
 7804: 
 7805: 
 7806:    }
 7807: 
 7808:    __global__ void ul0UpdateSides2(void) {
 7809:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7810:    
 7811:          SIDE(side);
 7812:    
 7813:          const Element *e1 = side->elems[0];
 7814:          const Element *e2 = side->elems[1];
 7815: 
 7816:          // A side is wet if and only if at least one of its elements is wet.
 7817:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7818: 
 7819:          // Update the side's dryness
 7820:          side->isDry = !isWet;
 7821: 
 7822:    }
 7823: 
 7824: 
 7825:    __global__ void zeroNodalVelocities(void) {
 7826:       NODE(node);
 7827: 
 7828:       for (int k = 0; k < nvrt; k++) {
 7829:          node->u2[k]   = {0.0, 0.0};
 7830:          node->w2[k]   = 0.0;
 7831:          node->utmp[k] = {0.0, 0.0};         
 7832:       }
 7833:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7834:    }
 7835:  
 7836: 
 7837:    __global__ void computeNodalVerticalVelocities1(void) {
 7838:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7839:    // Adds the element's vertical velocity times the element's area.
 7840:       ELEM(elem);
 7841: 
 7842:       for (int j = 0; j < elem->i34; j++) {
 7843:          Node *node = elem->nodes[j];
 7844: 
 7845:          for (int k = node->kb; k < nvrt; k++) {
 7846:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7847:          }
 7848:          atomicAdd(&(node->tmp.d), elem->area);
 7849:       }
 7850:    }
 7851: 
 7852:    __global__ void computeNodalVerticalVelocities2(void) {
 7853:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7854:    // Divides by the total area of the elements sharing the    node.
 7855:       NODE(node);
 7856: 
 7857: 
 7858:       const double invArea = 1.0 / node->tmp.d;
 7859:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7860: 
 7861:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7862:    }
 7863: 
 7864: 
 7865:    __global__ void computeNodalHorizontalVelocities1(void) {
 7866: 
 7867:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7868: 
 7869:       ELEM(elem);
 7870: 
 7871:       if (elem->isDry) return;
 7872: 
 7873:       const int kb = elem->kb;
 7874:       const bool isTri = elem->isTri();
 7875: 
 7876:       if constexpr(indvel <= 0) {
 7877:          // Assuming discontinous hvel.
 7878: 
 7879:          if (isTri) { // For triangles
 7880:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7881:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7882:             #pragma unroll
 7883:             for (int j = 0; j < 3; j++) {
 7884:                // For every node of the triangle...
 7885:                Node *node = elem->nodes[j];
 7886: 
 7887:                if (node->isDry) continue;
 7888: 
 7889:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7890:                const Side *s2 = elem->sides[(j + 1) % 3];
 7891:                const Side *s3 = elem->sides[(j + 2) % 3];
 7892: 
 7893:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7894: 
 7895:                atomicAdd(&(node->tmp.i), 1);
 7896: 
 7897:                for (int k = kb; k < nvrt; k++)  {
 7898:                   Vector2 s1u2 = s1->u2[k];
 7899:                   Vector2 s2u2 = s2->u2[k];
 7900:                   Vector2 s3u2 = s3->u2[k];
 7901: 
 7902:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7903:                   if constexpr(ics == 2) {
 7904:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7905:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7906:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7907:                   }
 7908: 
 7909:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7910:                   u = clampVelocity(u);
 7911:                   atomicAdd(&(node->utmp[k].x), u.x);
 7912:                   atomicAdd(&(node->utmp[k].y), u.y);
 7913: 
 7914:                }
 7915: 
 7916:             }
 7917:          }
 7918:          else { // For quads
 7919: 
 7920: 
 7921:             // Compute the bilinear coordinates of the center of each diagonal.
 7922:             double xi, eta;
 7923:             double shp13[4], shp24[4];
 7924:             Point2 x0, x1, x2, x3;
 7925:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7926:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7927:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7928: 
 7929:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7930:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7931: 
 7932: 
 7933: 
 7934: 
 7935:             for (int k = kb; k < nvrt; k++) {
 7936: 
 7937:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7938:                Vector2 sideU[4];
 7939:                #pragma unroll
 7940:                for (int j = 0; j < 4; j++) {
 7941:                   Vector2 u = elem->sides[j]->u2[k];
 7942:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7943:                   sideU[j] = u;
 7944:                }
 7945: 
 7946:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7947:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7948: 
 7949:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7950:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7951:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7952:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7953:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7954:                #pragma unroll
 7955:                for (int j = 0; j < 4; j++) {
 7956:                   Node *node = elem->nodes[j];
 7957:                   if (node->isDry) continue;
 7958: 
 7959:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7960:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7961:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7962:                }
 7963:             }
 7964: 
 7965:          }
 7966: 
 7967:       }
 7968:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7969:       
 7970:    }
 7971: 
 7972: 
 7973:    __global__ void computeNodalHorizontalVelocities2(void) {
 7974:       NODE(node);
 7975: 
 7976:       const int nodeCount = node->tmp.i;
 7977: 
 7978:       if (nodeCount == 0) 
 7979:       {
 7980:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7981:          return;
 7982:       }
 7983: 
 7984:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7985:       
 7986:       const int kb = node->kb;
 7987: 
 7988:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7989:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7990:       
 7991:       
 7992:    }   
 7993: 
 7994:  
 7995: 
 7996:    __global__ void resetVelocityOpenBndNodes(void) {
 7997:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7998: 
 7999:       NODE_BND(nodebnd);
 8000: // printf("DDDDDDDDDD\n");  // XXXXXXX
 8001:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8002:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8003:       }
 8004: 
 8005:    }
 8006: 
 8007: 
 8008:    __global__ void setVelocityOpenBndNodes(void) {
 8009:    // For open boundary nodes sets their velocity to the imposed values.
 8010: 
 8011:       SIDE_BND(sidebnd);
 8012: 
 8013:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8014:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8015:          // to its segment to the average of the side velocity.
 8016: 
 8017:          for (int k = 0; k < nvrt; k++) {
 8018:             Node *n1 = sidebnd->side->n1;
 8019:             Node *n2 = sidebnd->side->n2;
 8020: 
 8021: 
 8022:             Vector2 &n1_u2 = n1->u2[k];
 8023:             Vector2 &n2_u2 = n2->u2[k];
 8024: 
 8025:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8026:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8027:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8028:             }
 8029:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8030:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8031:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8032:             }
 8033: 
 8034:          }
 8035: 
 8036:       }
 8037: 
 8038:    }
