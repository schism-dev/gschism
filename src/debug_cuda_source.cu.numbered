 8274: #ifdef OLD_PCG_SOLVER
 8275: __global__ void computeMatrixProductAndDotProducts() {
 8276:    // Computes A*p, r'Mr and p'Ap
 8277: 
 8278:    // 1) shared buffer: first half for rMr, second for pAp
 8279:    __shared__ double sdata[2*BLOCK_SIZE];
 8280:    double* s_rMr = sdata;
 8281:    double* s_pAp = sdata + BLOCK_SIZE;
 8282: 
 8283:    const int tid = threadIdx.x;
 8284: 
 8285:    double l_pAp = 0.0;
 8286: 
 8287:    s_rMr[tid] = 0.0;
 8288:    s_pAp[tid] = 0.0;
 8289: 
 8290:    // 2) get your node pointer
 8291:    // NODE(node);   
 8292:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8293:    Node *node = &(mesh->localNodeData[idx_node]); 
 8294:       if (idx_node < mesh->np) {
 8295: 
 8296:       const double diag = node->coeffDiag;
 8297:       const double r    = node->mR;
 8298:       const double p    = node->mP;  
 8299: 
 8300:       // apply preconditioner on the fly:
 8301:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8302: 
 8303:       // 4) compute Ap = A.p
 8304:       double Ap = node->coeffDiag * node->mP;
 8305:       for (int j = 0; j < node->numNodes; ++j) {
 8306:          const Node *nbNode = node->nodes[j];
 8307:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8308: 
 8309:       }
 8310: 
 8311:       node->mAp = Ap;
 8312:       
 8313: 
 8314:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8315:       // const double l_rMr = r*Mr;  // r'Mr
 8316:       l_pAp = p*Ap;  // p'Ap
 8317: 
 8318: 
 8319:    }
 8320: 
 8321:    // 6) write into shared mem
 8322:    // s_rMr[tid] = l_rMr;
 8323:    s_pAp[tid] = l_pAp;
 8324: 
 8325:    __syncthreads();
 8326: 
 8327:    // 7) block-wide tree reduction
 8328:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8329:       if (tid < stride)  {
 8330:          s_pAp[tid] += s_pAp[tid + stride];
 8331:       }
 8332:       __syncthreads();
 8333:    }
 8334: 
 8335:    // 8) thread 0 atomically accumulates into the globals
 8336:    // XXX: This is slower than it needs to be, but it is simple and works
 8337:    if (tid == 0) {
 8338:       atomicAdd(pAp, s_pAp[0]);
 8339:    }
 8340: 
 8341: 
 8342: }
 8343: 
 8344: 
 8345: __global__ void updateSolutionAndDotProducts(void) {
 8346:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8347: 
 8348:    const int tid = threadIdx.x;
 8349: 
 8350:    s_rMr[tid] = 0.0;
 8351: 
 8352:    // get node & bounds-check:
 8353:    NODE(node);
 8354: 
 8355:    
 8356:    // Compute alpha
 8357:    const double alpha = (*rMr_old)/(*pAp); 
 8358: 
 8359: 
 8360:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8361: 
 8362: 
 8363:    // load scalars
 8364:    const double diag = node->coeffDiag;
 8365:    const double p    = node->mP;
 8366:    const double Ap   = node->mAp;
 8367:    const double x    = node->mX;
 8368:    const double r    = node->mR;
 8369:    
 8370:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8371: 
 8372:    // 1) update solution & residual
 8373:    const double x_new = x + alpha*p;
 8374:    const double r_new = r - alpha*Ap;
 8375:    node->mX = x_new;
 8376:    node->mR = r_new;
 8377: 
 8378:    // 2) apply Jacobi preconditioner on the fly
 8379:    const double Mr_new = r_new/diag;
 8380: 
 8381: 
 8382:    // 3) local contributions for the two dot-products
 8383:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8384: 
 8385:    // 4) write into shared-mem
 8386:    s_rMr[tid] = l_rMr;
 8387: 
 8388:    __syncthreads();
 8389: 
 8390: 
 8391:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8392:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8393:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8394:       __syncthreads();
 8395:    }
 8396: 
 8397:    // 6) thread 0 atomically folds into the global accumulators
 8398:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8399: 
 8400: 
 8401: }
 8402: 
 8403: 
 8404: __global__ void updateSearchDirection() {
 8405: 
 8406:     NODE(node);
 8407: 
 8408:     // recompute z on-the-fly
 8409:     const double z = node->mR / node->coeffDiag;
 8410:     const double p = node->mP;
 8411: 
 8412:     const double beta = (*rMr_new)/(*rMr_old);
 8413: 
 8414: 
 8415:     // p =z + beta*p
 8416:     node->mP = z + beta*p;
 8417: 
 8418: }
 8419: 
 8420: __global__ void initializeScalars(double *scalars) {
 8421: 
 8422:    // These point to a cupy array in the host code
 8423:    rMr_old = scalars + 0;
 8424:    rMr_new = scalars + 1;
 8425:    pAp     = scalars + 2;
 8426: }
 8427: 
 8428: __global__ void initializePreconditionedResidual(void) {
 8429: 
 8430:     __shared__ double s_rMr[BLOCK_SIZE];  
 8431: 
 8432:     s_rMr[threadIdx.x] = 0.0;
 8433: 
 8434:     NODE_ALL(node, valid);
 8435:     const int tid = threadIdx.x;
 8436:     // For the first iteration:
 8437:     // 1. Initial solution x = 0 (already set)
 8438:     // 2. Initial residual r = b (stored in qel)
 8439:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8440: 
 8441: // XXX we should use the guess solution here    
 8442: 
 8443:     double l_rMr = 0.0;
 8444:     if (valid) {
 8445:       // Set initial residual r = b (from qel)
 8446:       node->mR = node->qel;
 8447: 
 8448:       // Compute z = M^-1 * r (preconditioned residual)
 8449:       const double z = node->mR / node->coeffDiag;
 8450: 
 8451:       // Set initial search direction p = z
 8452:       node->mP = z;
 8453: 
 8454:       // Initialize other variables needed for CG
 8455:       node->mX = 0.0;  // Initial solution
 8456:       node->mAp = 0.0; // Will be computed in first iteration
 8457: 
 8458: 
 8459:       // Computes the first r'Mr (reduction)
 8460:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8461:     }
 8462:     // 4) write into shared-mem
 8463:     s_rMr[tid] = l_rMr;
 8464: 
 8465:     __syncthreads();
 8466: 
 8467: 
 8468:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8469:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8470:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8471:         __syncthreads();
 8472:     }
 8473: 
 8474:     // 6) thread 0 atomically folds into the global accumulators
 8475:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8476: 
 8477:     *rMr_old = 0.0;
 8478:     *pAp = 0.0;
 8479: }
 8480: #endif
 8481: 
 8482: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
