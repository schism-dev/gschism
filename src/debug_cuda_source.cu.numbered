 4370:                 int *isdel, int *isidenode, int *isbnd,
 4371:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4372:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4373:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4374:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4375:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4376:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4377:                 double *drag, double *roughness,
 4378:                 double *emo, double *efa, 
 4379:                 double *umo, double *ufa, 
 4380:                 double *vmo, double *vfa) {
 4381: 
 4382:    printf("Populating mesh for partition %d\n", partNum);
 4383: 
