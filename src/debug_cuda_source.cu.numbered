  927:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  928: 
  929:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo, const Side *origSide = nullptr) const;
  930:    
  931:    __device__ __forceinline__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  932: 
