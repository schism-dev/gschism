10072: extern "C" __global__ void getSideVarAddr(int varCode, void **addr, int *offset, int *sizeSide, int *sizeType) {
10073:    Side *sides = mesh->localSideData;
10074: 
10075:    *addr = sides;
10076:    *sizeSide = sizeof(Side);
10077:    switch (varCode) {
10078:       case (int)VarCode::z:
10079:          *offset = (int)((char*)&sides[0].zc - (char*)sides);
10080:          *sizeType = sizeof(double);
10081:          break;
10082:       // case (int)VarCode::depth:
10083:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
10084:       //    *sizeType = sizeof(double);
10085:       //    break;         
10086:       case (int)VarCode::x:
10087:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
10088:          *sizeType = sizeof(Vector2);
10089:          break;
10090:       case (int)VarCode::len:
10091:          *offset = (int)((char*)&sides[0].len - (char*)sides);
10092:          *sizeType = sizeof(double);
10093:          break;
10094:       case (int)VarCode::kb:
10095:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
10096:          *sizeType = sizeof(int);
10097:          break;
10098:       case (int)VarCode::isdry:
10099:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
10100:          *sizeType = sizeof(int);
10101:          break;            
10102:       // case (int)VarCode::w:
10103:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
10104:       //    *sizeType = sizeof(double);
10105:       //    break;
10106:       case (int)VarCode::u:
10107:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
10108:          *sizeType = sizeof(Vector2);
10109:          break;   
10110:       case (int)VarCode::btu:
10111:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
10112:          *sizeType = sizeof(Vector2);
10113:          break;          
10114:       case (int)VarCode::U:
10115:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
10116:          *sizeType = sizeof(Vector2);
10117:          break;
10118:       case (int)VarCode::gradETP:
10119:          *offset = (int)((char*)&sides[0].gradETP.x - (char*)sides);
10120:          *sizeType = sizeof(Vector2);
10121:          break;
10122:       case (int)VarCode::gradPr:
10123:          *offset = (int)((char*)&sides[0].gradPr.x - (char*)sides);
10124:          *sizeType = sizeof(Vector2);
10125:          break;
10126:       case (int)VarCode::gradEta1:
10127:          *offset = (int)((char*)&sides[0].gradEta1.x - (char*)sides);
10128:          *sizeType = sizeof(Vector2);
10129:          break;
10130:       case (int)VarCode::gradEta2:
10131:          *offset = (int)((char*)&sides[0].gradEta2.x - (char*)sides);
10132:          *sizeType = sizeof(Vector2);
10133:          break;
10134:       // case (int)VarCode::ghat:
10135:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
10136:       //    *sizeType = sizeof(Vector2);
10137:       //    break;   
10138:       case (int)VarCode::hhat:
10139:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
10140:          *sizeType = sizeof(Vector2);
10141:          break;      
10142:       case (int)VarCode::chi:
10143:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
10144:          *sizeType = sizeof(double);
10145:          break;
10146:       case (int)VarCode::n1:
10147:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
10148:          *sizeType = sizeof(Node);
10149:          break;
10150:       case (int)VarCode::n2:
10151:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
10152:          *sizeType = sizeof(Node);
10153:          break;                   
10154:       default:
10155:          *offset = -1;
10156:    }
10157: }
