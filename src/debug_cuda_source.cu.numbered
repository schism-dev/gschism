  902:    
  903:    // Elevation boundary condition
  904:    int iettype;  // Type of elevation boundary condition
  905:    double eth;   // Elevation time history
  906: 
  907:    // Flow boundary condition
  908:    double qthcon;  // Flow time history constant
  909:    double vobc1;   // Velocity coefficient 1
  910:    double vobc2;   // Velocity coefficient 2
  911: 
  912:    // Tracer boundary conditions
  913:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  914:    // int  itrtype[natrm];    // Tracer boundary condition type
  915: 
  916:    BoundarySegment(bool _isLand) {
  917:       isLand = _isLand;
  918:       clen = 0.0;
  919:       carea = 0.0;
  920:       ifltype = 0;
  921:       iettype = 0;
  922:       eth = 0.0;
  923:    }
  924: 
  925:    BoundarySegment(void) {
  926:       isLand = false;
  927:       clen = 0.0;
  928:       carea = 0.0;
  929:       ifltype = 0;
  930:       iettype = 0;
  931:       eth = 0.0;
  932:    }
  933: 
  934:    
