 6394: #ifdef DONTCOMPILE
 6395: __device__ void computeVerticalAdvection(void) {
 6396:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6397: 
 6398:    sdbt(1:2,:,:)=0.d0
 6399: 
 6400:    const Side *side = FROM kernel;
 6401: 
 6402:    if(side->isDry) return;
 6403: 
 6404:    // If side is wet...
 6405: 
 6406: 
 6407:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6408:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6409:    double ws[nvrt] = {} // w @ side
 6410:    int icount = 0;
 6411:    for (int j=0; j<2; j++) {
 6412:       const Element *elem = side->elements[j];
 6413:        
 6414:       if(elem != nullptr) {
 6415:          icount++;
 6416:          for (int k=0; k<nvrt; k++) {
 6417:             ws[k] = ws[k] + elem->w[k];
 6418:          }
 6419:       }
 6420:    }  // for j
 6421: 
 6422:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6423:    ws = ws/icount;
 6424: 
 6425:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6426:    // Splines allow for a smooth transition between vertical levels.
 6427:    // Splines have continuity restrictions at the internal knots, but
 6428:    // we have to provide the 1st derivatives at the endpoints.
 6429:    const int kbs = side->kbs; 
 6430:    
 6431:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6432:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6433:    initCubicSpline(kbs, nvrt, side, ws, up)
 6434: 
 6435:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6436:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6437:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6438: 
 6439:    // Total advection (average onto side)
 6440:    const Node *node1 = side->nodes[0];
 6441:    const Node *node2 = side->nodes[1];
 6442:    for (int k=kbs(i); k<nvrt; k++) {
 6443: 
 6444:       if constexpr(ics==1) {
 6445:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6446:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6447:       } else {
 6448:          // XXX IMPLEMENT THIS
 6449:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6450:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6451:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6452:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6453:       }  // if ics
 6454: 
 6455: 
 6456:    }
 6457: }
 6458: #endif
 6459: 
 6460: 
 6461: extern "C" {
 6462:    __global__ void computeElemAverageGhat(void) {
 6463:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6464: 
 6465:       ELEM(elem);
 6466:       
 6467:       elem->ghat1= {0.0, 0.0};  
 6468: 
 6469:       if constexpr(ihydraulics != 0) {
 6470:          if (nhtblocks > 0 && elem->isblock) return;
 6471:       }
 6472: 
 6473:       if (elem->isDry) return;
 6474: 
 6475:       // Wet elements.
 6476:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6477:       // tidal potential, horizontal diffusion, and baroclinic etc
 6478:       // Remember to update both fb and F 
 6479:       // If ics=2, ghat1 are in eframe (ll)
 6480:       // cff1-3: coefficients for 2D/3D
 6481:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6482:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6483:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6484: 
 6485:       double av_cff1 = 0.0;  // av. for cff1
 6486:       double av_cff2 = 0.0;  // av. for cff2
 6487:       double av_cff3 = 0.0;  // av. for cff3
 6488:       double av_df = 0.0;  // av. for H^\alpha / H
 6489:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6490:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6491: 
 6492:       const int i34 = elem->i34;
 6493:       const int kb = elem->kb;
 6494: 
 6495:       for (int j=0; j<i34; j++) {
 6496:          // For each node and side in the element...
 6497: 
 6498:          const Node *node = elem->nodes[j];
 6499:          const Side *side = elem->sides[j];
 6500: 
 6501:          const double chi      = side->chi;
 6502:          const double veg_c2   = side->veg_c2;
 6503:          const double veg_beta = side->veg_beta;
 6504:          const double veg_h    = side->veg_h();
 6505:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6506: 
 6507:          // Node - const in elem
 6508:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6509:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6510: 
 6511:          if (elem->depth >= tip_dp) {
 6512:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6513:          }
 6514: 
 6515:          
 6516:          const double htot  = side->htot2();        // Total depth at the side
 6517:          const double zctr2 = side->zTopCanopy();  
 6518: 
 6519:          double cff1; 
 6520:          double cff2; 
 6521:          double cff3;   
 6522:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6523:          // coefficients applied to 2D/3D case 
 6524:             cff1 = side->hhat/htot;
 6525:             cff2 = 0.0;
 6526:             cff3 = 0.0;
 6527:          } else { //3D
 6528:             //Init for no-veg case
 6529:             cff1 = 1.0;
 6530:             cff2 = 1.0;
 6531:             cff3 = 0.0;
 6532: 
 6533:             if constexpr(iveg != 0) {
 6534:                // Computes coefficients used with vegetation terms G1, G2
 6535:                // cff1, cff3 are used for the first two terms in G1, G2:
 6536:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6537:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6538:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6539:                if(veg_h < 0.99*htot) { // submergent vegetation
 6540:                   cff1=1;
 6541:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6542:                   cff3 = veg_c;
 6543: 
 6544:                } else { // emergent vegetation
 6545:                   cff1 = 1.0/(1.0 + veg_c2);
 6546:                   cff2 = cff1;
 6547:                   cff3 = 0.0;
 6548: 
 6549:                }
 6550:             } // if iveg
 6551:          } //  2D/3D
 6552: 
 6553:          av_cff1 += cff1/i34;
 6554:          av_cff2 += cff2/i34;
 6555:          av_cff3 += cff3/i34;
 6556:          av_cff2_chi += cff2*chi/i34;
 6557:          av_cff3_chi += cff3*chi/i34;
 6558:          av_df += min(htot, veg_h)/(htot*i34);
 6559: 
 6560: 
 6561:          // btrack values: U^\star, U^{\star\alpha}
 6562:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6563:          Vector2 Ustar       = {0.0, 0.0}; 
 6564:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6565: 
 6566:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6567:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6568:          } else { //3D
 6569:             for (int k = side->kb; k < nvrt; k++) {
 6570:             
 6571:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6572:                Ustar += w2;
 6573: 
 6574:                if constexpr(iveg != 0) {
 6575:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6576:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6577:                        Ustar_alpha += zrat*w2; // XXXX
 6578:                    }
 6579:                }  // if iveg
 6580:             }  // for k
 6581:          }  //2D/3D
 6582:          
 6583: 
 6584:          // Add btrack & surface stress terms to \breve{G} first
 6585:          if constexpr(ics==1) {
 6586: 
 6587:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6588: 
 6589:          } else {
 6590:             // XXX IMPLEMENT THIS
 6591:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6592:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6593:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6594:          }  // if ics
 6595: 
 6596:          // Surface and bottom stress terms
 6597:          if constexpr(ics==1) {
 6598:             const Vector2 tau    = side->tau();
 6599:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6600: 
 6601:             // Term for surface and bottom stress
 6602:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6603: 
 6604:          } else {
 6605:             assert(false && "computeElemAverageGhat: Not implemented");
 6606:             // XXX IMPLEMENT THIS
 6607:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6608:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6609:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6610:             // tau_x=(vn1+tt1)/2.d0
 6611:             // tau_y=(vn2+ss1)/2.d0
 6612:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6613:          }  // if ics
 6614: 
 6615:          
 6616: 
 6617:          // All terms in F,F^\alpha,f_b except baroclinic
 6618:          // F, f_b: all explicit terms excluding vegetation 
 6619:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6620:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6621:          const double coriolis = side->coriolis;
 6622:          Vector2 F  =  coriolis*side->U;  // F_x
 6623:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6624:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6625: 
 6626:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6627:             
 6628:             for (int k = side->kb; k < nvrt; k++) {
 6629:                if (zctr2 > side->zc[k-1]) {
 6630:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6631:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6632:                    Fa +=  coriolis*w2*zrat;
 6633:                } // if zctr2
 6634:             } // k
 6635:          } // iveg
 6636: 
 6637:          // Integrate horizontal viscosity force vertically
 6638:          for (int k=side->kb + 1; k<nvrt; k++) {
 6639:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6640: 
 6641:             F += levelHorVisc;
 6642: 
 6643:             // Vegetation term
 6644:             if constexpr(iveg!=0) {
 6645:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6646:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6647:                   Fa += levelHorVisc*zrat;
 6648:                } 
 6649:             } // if iveg
 6650:          } // for k
 6651: 
 6652:          fb += side->nuGradU[side->kb];
 6653: 
 6654:          // Add to ghat1
 6655:          if constexpr(ics==2) {
 6656:             // XXX IMPLEMENT THIS
 6657:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6658:             // bigf1=vn1; bigf2=vn2
 6659:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6660:             // botf1=vn1; botf2=vn2
 6661:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6662:             // bigfa1=vn1; bigfa2=vn2
 6663:          } // if ics
 6664: 
 6665:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6666:       } // for j (nodes and sides)
 6667: 
 6668:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6669:          
 6670:       // Finish off terms in F, F^\alpha and f_b
 6671:       const double grav3 = elem->mean(&Node::grav2);
 6672:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6673: 
 6674: 
 6675:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6676:       for (int j=1; j<i34; j++) { 
 6677:          // For each side in the element...
 6678:          const Side *side = elem->sides[j];
 6679:          const double chi = side->chi;
 6680: 
 6681:          const double htot = side->htot2();
 6682:          const double veg_h = side->veg_h();
 6683:          const Vector2 F  = htot*fb;
 6684:          const Vector2 Fa = min(htot, veg_h)*fb;
 6685: 
 6686:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6687:       } // for j
 6688: 
 6689:       //botf1 etc are already in elem frame
 6690:       elem->ghat1 += tmp/i34;
 6691: 
 6692:       // Baroclinic force
 6693:       if constexpr(ibc==0) {
 6694:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6695: 
 6696:          Vector2 Fa = {0.0, 0.0};
 6697:          Vector2 intGradRho = {0.0, 0.0};
 6698:          
 6699:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6700:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6701:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6702: 
 6703:             // \in F [m^2/s/s]
 6704:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6705:          }
 6706: 
 6707:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6708:          const Vector2 F = av_df*Fa; //approx
 6709:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6710: 
 6711:       } // if ibc
 6712: 
 6713: 
 6714: 
 6715:    }
 6716: 
 6717: } // extern "C"
 6718: 
 6719: 
 6720: 
 6721: #ifdef DONTCOMPILE
 6722: __global__ void checkMassConservation(Tracers* sumtr) {
 6723: 
 6724:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6725: 
 6726:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6727: 
 6728:    Element *elem = &(mesh->localElemData[i]);
 6729: 
 6730:    // Skip dry elements
 6731:    if (elem->isDry) return;
 6732: 
 6733:    // Local sum array for this thread
 6734:    double localSum[N_TRACERS] = {0.0};
 6735: 
 6736:    // Sum over vertical levels for this element
 6737:    const int kbe = elem->kbe;
 6738:    const double area = elem->area;
 6739: 
 6740:    for (int k = kbe; k < nvrt; k++) {
 6741:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6742:       
 6743:       // Accumulate tracer mass
 6744:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6745:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6746:       }
 6747:    }
 6748: 
 6749:    
 6750: 
 6751:    //  This function returns per element sums. A reduction must be done on the host side.
 6752: }
 6753: 
 6754: 
 6755: __global__ void transport(void) {
 6756: 
 6757:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6758: 
 6759:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6760: 
 6761:    Element *elem = &(mesh->localElemData[ie]);
 6762: 
 6763:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6764: 
 6765:                for (int m=0; m<ntr; m++) {
 6766:                   for (int k=kbe(ie); k<nvrt; k++) {
 6767:                      // Calculate each polynomial's weight 
 6768:                      wm=0.d0; sum1=0.d0; 
 6769:                      wm1=0.d0; wm2=0.d0; 
 6770:                      for (int i=0; i<elem->nweno2; i++) {
 6771:                   
 6772:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6773:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6774:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6775:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6776:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6777:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6778:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6779:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6780:                      // -----------------Hu and Shu (1999)'s method----------------
 6781:                      b4=b1+b2+b3
 6782: 
 6783: //Error: add PRODUCTION CPP
 6784: #ifdef DEBUG
 6785:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6786:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6787:                     call parallel_abort(errmsg)
 6788:                   }
 6789: #endif
 6790: 
 6791:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6792:                   // !----test-------------- 
 6793:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6794:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6795:                   // !wm(i)=wm1(i)*wm2(i)
 6796:                   // !---------------------- 
 6797:                   sum1=sum1+wm(i)
 6798:                 } // end for i
 6799: 
 6800:                 wm=wm/sum1
 6801: 
 6802:                 for (int j=0; j<elem->i34; j++) {
 6803: 
 6804:                   const Side *side  = elem->sides[j];
 6805:                   const Node *node1 = side->n1;
 6806:                   const Node *node2 = side->n2;
 6807: 
 6808:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6809:                      trsd=0.d0
 6810:                      for (int kk=0; kk<nquad; kk++) {
 6811:                         for (int i=0; i<elem->nweno2; i++) {
 6812:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6813:                         } // end for i   
 6814:                      } // end for kk
 6815:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6816:                   } // outward flux
 6817:                } // end for j=1,i34(ie) ! side
 6818:             }
 6819:          }
 6820:               
 6821: 
 6822: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6823: //             //   calculate each polynomial's weight 
 6824: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6825: //                 wm=0.d0; sum1=0.d0
 6826: //                 do i=1,nweno1(ie) !for each polynomial
 6827: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6828: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6829: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6830: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6831: //                   wm(i)=b2
 6832: //                   sum1=sum1+b2
 6833: //                   !wm(i)=1.d0
 6834: //                   !sum1=sum1+1.d0
 6835: 
 6836: // // Error: PRODUCTION
 6837: // #ifdef DEBUG
 6838: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6839: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6840: //                     call parallel_abort(errmsg)
 6841: //                   endif
 6842: // #endif
 6843: 
 6844: //                 enddo !i
 6845: //                 wm=wm/sum1 !final weight
 6846: 
 6847:                 for (int j=0; j<elem->i34; j++) { // side
 6848:                   const Side *side = elem->sides[j];
 6849:                   const Node *node1 = side->n1;
 6850:                   const Node *node2 = side->n2;
 6851: 
 6852:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6853:                     trsd=0.d0
 6854:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6855:                       for (int i=0; i<elem->nweno1; i++) {
 6856:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6857:                       }
 6858:                     enddo //kk
 6859:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6860:                   } // outward flux
 6861:                 } // end for j=1,i34(ie) ! side
 6862:               } // end for k; ntr 
 6863: 
 6864:             else !simple upwind method
 6865:               do j=1,i34(ie)
 6866:                 jsj=elside(j,ie)
 6867:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6868:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6869:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6870:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6871:                   endif
 6872:                 enddo  !vertical layers
 6873:               enddo !j=1,i34(ie) ! side
 6874:             endif !order of accuracy
 6875: 
 6876:          //  enddo !ie
 6877: // !$OMP     end do
 6878: 
 6879: // !$OMP     master
 6880: //           !message passing
 6881: //           if (nproc>1) then
 6882: //             !make a copy of side concentrations
 6883: //             trsd_tmp0=trsd_tmp 
 6884: 
 6885: //             !this exchange routine swaps interface concentration between two partitions
 6886: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6887: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6888: 
 6889: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6890: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6891: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6892: 
 6893: 
 6894: //             !This obtains final values for interface sides
 6895: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6896: //       :    endif !nproc>1
 6897: //           !message passing end
 6898: // !$OMP     end master
 6899: // !$OMP     barrier
 6900: 
 6901: 
 6902: // !         Do advection; conc @ dry elem will not be changed
 6903: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 6904: // !$OMP     do reduction(+: h_mass_in)
 6905: //           do i=1,ne
 6906: //             if(idry_e(i)==1) cycle
 6907: 
 6908: 
 6909: // !           Wet elements with 3 wet nodes
 6910: //             do k=kbe(i)+1,nvrt
 6911: 
 6912: 
 6913: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 6914: //               dtb_by_bigv = dtb/bigv
 6915:     
 6916: // !             Advective flux
 6917: //               if (ntd_weno==1 .or. itd_weno==1) then
 6918: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 6919: //               else
 6920: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 6921: //               endif
 6922: 
 6923: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 6924: //               do j=1,i34(i)
 6925: //                 jsj=elside(j,i) !side
 6926: //                 iweno=.true. !use weno reconstruction as default
 6927: //                 iel=ic3(j,i) !neighboring elem
 6928: 
 6929: //                 if(iel/=0) then
 6930: //                   if(idry_e(iel)==1) cycle
