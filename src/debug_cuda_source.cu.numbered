 1348: // This struct is used to store the boundary information for a node.
 1349: struct NodeBoundary {   
 1350:    int idx;
 1351:    BoundarySegment *segment;
 1352:    Node *node;
 1353:    
 1354:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1355:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1356: 
 1357:    bool isLand;
 1358: 
 1359:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1360:    double elbc;   // Elevation boundary condition
 1361:    double eth;    // Elevation time history
 1362: 
 1363:    double eta_mean; // Mean elevation at nodes
 1364: 
 1365:    bool isEssentialBC;
 1366: 
 1367:    Vector2 uth[nvrt];  // "Time history" velocity
 1368: 
 1369:    // Arrays for harmonic constituents (if needed)
 1370:    double  emo[nbfr];  // Elevation amplitude
 1371:    double  efa[nbfr];  // Elevation phase
 1372:    Vector2 umo[nbfr];  // velocity amplitude
 1373:    Vector2 ufa[nbfr];  // velocity phase
 1374: 
 1375: 
 1376:    NodeBoundary(void) {
 1377:       isLand = false;
 1378:    }
 1379:    NodeBoundary(bool _isLand) {
 1380:       isLand = _isLand;
 1381:    }
 1382: 
 1383:    
 1384:    __forceinline__ __device__ int numSidesForAverage() const {
 1385:    // Returns the number of sides that are connected to the node and have the same segment.
 1386:    // This is used to compute the average velocity at the node for open boundary nodes.
 1387:       int res = 0;
 1388:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1389:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1390: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1391:       return res;
 1392:    }
 1393: 
 1394: 
 1395:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1396:       assert(index == 0 || index == 1); 
 1397:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1398:    }
 1399: 
 1400:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1401:       if (isLand) return;  // land never uses these links
 1402: 
 1403:       SideBoundary *nullSideBoundary = nullptr;
 1404:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1405: 
 1406:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1407:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1408: 
 1409:       // both slots taken. OK if this side was already linked
 1410:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1411:    }
 1412: 
 1413: 
 1414: };
