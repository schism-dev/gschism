 3764: extern "C" {
 3765: 
 3766:    __global__ void scaleGravity(double loadtide_coef) {
 3767: 
 3768: 
 3769:       NODE(node);
 3770: 
 3771:       // SAL option: scale gravity
 3772:       if constexpr(iloadtide==2) {  // simple const
 3773:          node->grav2 = grav*(1.0 - loadtide_coef);
 3774: 
 3775:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3776:         
 3777:           const double depth = max(node->depth, 0.0);
 3778:           const double tmp1 = sqrt(depth);
 3779:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3780:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3781:                              2.6969e-13*depth*depth*depth*tmp1;
 3782:           
 3783:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3784:           
 3785: 
 3786: 
 3787:           node->grav2 = grav*(1.0 - beta_bar);
 3788: 
 3789:       } else {  // iloadtide=0,1
 3790:         node->grav2=grav;
 3791: 
 3792:       }
 3793: 
 3794:    }
 3795: 
