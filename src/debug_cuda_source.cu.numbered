 6964: //               endif
 6965: 
 6966: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 6967: //               do j=1,i34(i)
 6968: //                 jsj=elside(j,i) !side
 6969: //                 iweno=.true. !use weno reconstruction as default
