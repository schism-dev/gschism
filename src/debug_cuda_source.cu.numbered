 2528: 
 2529: __inline__ __device__ double  Side::Cd(void)      const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2530: 
 2531: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2532: 
 2533: /**
 2534:  * This method performs backtracking from the side center until a time -dt back in time 
 2535:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2536:  * intermediate point.
 2537:  *
 2538:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2539:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2540:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2541:  * remaining time.
 2542:  * 
 2543:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2544:  * 
 2545:  * @param uuint, vvint, wwint: Velocities at the final point
 2546:  * @param jlev: Level at which the backtracking is performed
 2547:  * @param dt, dtbk: Tracking timesteps
 2548:  * @return: True if the backtracking was successful, false otherwise
 2549:  */
 2550: __inline__ __device__ bool Side::btrack(
 2551:       int jlev,
 2552:       double dt,            // Tracking time
 2553:       double dtbk,          // Tracking timestep
 2554:       Vector3 &u_int        // Velocities at the initial point
 2555: ) const {
 2556: 
 2557:    // Start from side center
 2558:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2559: 
 2560:  
 2561:    double time_rm = dt; // Remaining time
 2562: 
 2563: 
 2564:    // // Initialize outputs XXX
 2565:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2566:    //    sclr[i] = 0.0;
 2567:    // }
 2568: 
 2569: 
 2570:    // Initial velocities
 2571:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2572: 
 2573:    // Find the element that is in the direction opposite to the velocity
 2574:    Element* curElem = findElementTowards(toVector2(u_int));
 2575: 
 2576: 
 2577:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2578:    if (curElem == nullptr) {
 2579:       // Make velocity parallel to the side
 2580:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2581:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2582:       curElem = otherElem(curElem);
 2583:       
 2584:    }
 2585: 
 2586: // Nudges it towards the circumcenter
 2587: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2588: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2589:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2590: const double eps = 9.013e-3;                 
 2591: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2592: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2593: 
 2594: 
 2595: 
 2596:    const int MAX_ITERATIONS = 1000; 
 2597:    Element* nextElem = curElem;
 2598:    int iter = 0;
 2599:    while(true) {
 2600: 
 2601:       // Calculate timestep
 2602:       double dtb = min(dtbk, time_rm);
 2603: 
 2604:       // Next point in the backtracking curve
 2605:       Point3 xt = x0 - dtb*u_int;
 2606:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2607:       assert(found && "Backtracking failed in btrack");
 2608: 
 2609:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2610: 
 2611:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2612:                       // then time_rm needs to be increased by the unused time.
 2613: 
 2614:       // If the velocity is too small, we stop the backtracking
 2615:       const double vmag = length(toVector2(u_int));
 2616:       if (vmag <= velmin_btrack) break;
 2617: 
 2618:       // The current point becomes the next segment's starting point.
 2619:       x0 = xt;
 2620:  
 2621:       curElem = nextElem;
 2622: 
 2623:       iter++;
 2624:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2625:    }
 2626: 
 2627: 
 2628: }
 2629: 
 2630: 
