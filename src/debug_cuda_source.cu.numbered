 7379: 
 7380:    __global__ void computeVerticalVelocity(void) {
 7381:       // Computes the vertical velocity at the (2D) element's centroid.
 7382:       // In this function we will be considering volumetric elements, with side faces and a 
 7383:       // bottom and a top face. We will call them SFs, BF and TF.
 7384:       // It computes the flux coming from BF and the SFs.
 7385:       // If the bed is moving, it takes that into account.
 7386:       // Since water is incompressible, the integral of the velocity times the normal vector
 7387:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7388:       // and the BF is equal to the flux going out from the TF.
 7389:       // TF = - BF - sum(SFs).
 7390:       // It then computes the horizontal velocity at the center of TF.
 7391:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7392:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7393:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7394: 
 7395:       ELEM(elem);
 7396: 
 7397:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7398: 
 7399:       if (elem->isDry) return;
 7400: 
 7401:       const int kb = elem->kb;
 7402:       const bool isTri = elem->isTri();
 7403: 
 7404:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7405: 
 7406:       // Compute the bottom velocity
 7407:       if constexpr(imm != 0) {
 7408:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7409:       }
 7410: 
 7411: 
 7412:       double bottomArea3D;
 7413:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7414: 
 7415:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7416: 
 7417:       double topArea3D;
 7418: 
 7419:       // Bottom face flux
 7420:       double bottomFlux = 0.0;
 7421:       Vector2 u2meanBottom = {0.0, 0.0};
 7422:       const Vector2 gradh = elem->grad2(&Node::depth);
 7423:       if constexpr(imm==2) {
 7424:          Vector3 ubed;
 7425: 
 7426:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7427:          // updateBDEF(ubed);
 7428:      
 7429:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7430: 
 7431:          // elem->w[kb] += ubed.z;
 7432:       }
 7433:       else {
 7434: 
 7435:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7436:   
 7437:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7438:          // in the direction of motion.
 7439:          const double bottomW = - dot(gradh, u2meanBottom);  
 7440:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7441: 
 7442:          // VElocity associated to the bed deformation
 7443:          double bedVelocity = 0.0;
 7444:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7445: 
 7446:          elem->w[kb] = bedVelocity + bottomW; 
 7447: 
 7448:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7449:          
 7450:       } // if imm
 7451: 
 7452:       // Compute w for kb+1 to nvrt-1
 7453:       for (int l = kb; l < nvrt - 1; l++) {
 7454: 
 7455:          // normal vector to the top face of the "volumetric" element (3D)
 7456:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7457: 
 7458:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7459:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7460: 
 7461:          // Compute the total flux at the sides
 7462:          double sideFlux = 0.0;
 7463: 
 7464:          for (int j = 0; j < elem->i34; j++) {
 7465:             const Side *side = elem->sides[j];
 7466:             const int kbs = side->kb;
 7467:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7468:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7469:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7470: 
 7471:             // The area is "clamped" meaning that it takes kb into account.
 7472:             const double sideArea = side->areaClamped(l);
 7473: 
 7474:             const double sign = elem->ssign[j]; 
 7475: 
 7476:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7477:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7478:          }
 7479:          
 7480:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7481:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7482:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7483: 
 7484:          // The flux at the top ace can be computed from the other flows.
 7485:          // All fluxes are in directions into the prism.
 7486:          const double topFlux = - sideFlux - bottomFlux;
 7487: 
 7488:          // Flux at the top face due to the horizontal velocities only
 7489:          // topFlux = topHorizontalFlux + topVerticalFlux
 7490:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7491: 
 7492:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7493:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7494: 
 7495:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7496: 
 7497:          bottomFlux = -topFlux;
 7498:          
 7499:       }
 7500: 
 7501:    }  
 7502: 
 7503: 
 7504: 
 7505: 
 7506: 
 7507: 
 7508: 
 7509: // !===============================================================================
 7510: // !===============================================================================
 7511: 
 7512: } // extern "C"
 7513: 
 7514: #ifdef DONTCOMPILE
 7515: __device__ void computeVerticalAdvection(void) {
 7516:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7517: 
 7518:    sdbt(1:2,:,:)=0.d0
 7519: 
 7520:    const Side *side = FROM kernel;
 7521: 
 7522:    if(side->isDry) return;
 7523: 
 7524:    // If side is wet...
 7525: 
 7526: 
 7527:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7528:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7529:    double ws[nvrt] = {} // w @ side
 7530:    int icount = 0;
 7531:    for (int j=0; j<2; j++) {
 7532:       const Element *elem = side->elements[j];
 7533:        
 7534:       if(elem != nullptr) {
 7535:          icount++;
 7536:          for (int k=0; k<nvrt; k++) {
 7537:             ws[k] = ws[k] + elem->w[k];
 7538:          }
 7539:       }
 7540:    }  // for j
 7541: 
 7542:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7543:    ws = ws/icount;
 7544: 
 7545:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7546:    // Splines allow for a smooth transition between vertical levels.
 7547:    // Splines have continuity restrictions at the internal knots, but
 7548:    // we have to provide the 1st derivatives at the endpoints.
 7549:    const int kbs = side->kbs; 
 7550:    
 7551:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7552:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7553:    initCubicSpline(kbs, nvrt, side, ws, up)
 7554: 
 7555:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7556:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7557:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7558: 
 7559:    // Total advection (average onto side)
 7560:    const Node *node1 = side->nodes[0];
 7561:    const Node *node2 = side->nodes[1];
 7562:    for (int k=kbs(i); k<nvrt; k++) {
 7563: 
 7564:       Vector2 bcc1 = node1->bcc[k];
 7565:       Vector2 bcc2 = node2->bcc[k];
 7566:       if constexpr(ics == 2) {
 7567:          // Project the velocities from the node frames to the side frame
 7568:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7569:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7570:       }
 7571: 
 7572:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7573:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7574: 
 7575:    }
 7576: }
 7577: #endif
 7578: 
 7579: 
 7580: extern "C" {
 7581:    __global__ void computeElemAverageGhat(void) {
 7582:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7583: 
 7584:       ELEM(elem);
 7585:       
 7586:       elem->ghat1= {0.0, 0.0};  
 7587: 
 7588:       if constexpr(ihydraulics != 0) {
 7589:          if (nhtblocks > 0 && elem->isblock) return;
 7590:       }
 7591: 
 7592:       
 7593:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7594:       // cff1-3: coefficients for 2D/3D
 7595: 
 7596:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7597:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7598:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7599: 
 7600:       if (elem->isDry) return;
 7601: 
 7602:       // Average of the coefficients
 7603:       double av_cff1 = 0.0;  // av. for cff1
 7604:       double av_cff2 = 0.0;  // av. for cff2
 7605:       double av_cff3 = 0.0;  // av. for cff3
 7606:       double av_df = 0.0;  // av. for H^\alpha / H
 7607:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7608:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7609: 
 7610:       const int i34 = elem->i34;
 7611:       const int kb  = elem->kb;
 7612: 
 7613:       for (int j=0; j<i34; j++) {
 7614:          // For each node and side in the element...
 7615: 
 7616:          const Node *node = elem->nodes[j];
 7617:          const Side *side = elem->sides[j];
 7618: 
 7619:          const double chi      = side->chi;
 7620:          const double veg_c2   = side->veg_c2;
 7621:          const double veg_beta = side->veg_beta;
 7622:          const double veg_h    = side->veg_h();
 7623:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7624: 
 7625:          const Vector2 gradPhi = elem->gradPhi[j];
 7626: 
 7627:          // Node - const in elem
 7628:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7629:          elem->gradPr  += node->pr  *gradPhi;
 7630: 
 7631:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7632: 
 7633:         
 7634:          const double htot  = side->htot2();        // Total depth at the side
 7635:          const double zctr2 = side->zTopCanopy();  
 7636: 
 7637:          double cff1; 
 7638:          double cff2; 
 7639:          double cff3;   
 7640:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7641:          // coefficients applied to 2D/3D case 
 7642:             cff1 = side->hhat/htot;
 7643:             cff2 = 0.0;
 7644:             cff3 = 0.0;
 7645:          } else { //3D
 7646:             //Init for no-veg case
 7647:             cff1 = 1.0;
 7648:             cff2 = 1.0;
 7649:             cff3 = 0.0;
 7650: 
 7651:             if constexpr(iveg != 0) {
 7652:                // Computes coefficients used with vegetation terms G1, G2
 7653:                // cff1, cff3 are used for the first two terms in G1, G2:
 7654:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7655:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7656:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7657:                if(veg_h < 0.99*htot) { // submergent vegetation
 7658:                   cff1 = 1.0;
 7659:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7660:                   cff3 = veg_c;
 7661: 
 7662:                } else { // emergent vegetation
 7663:                   cff1 = 1.0/(1.0 + veg_c2);
 7664:                   cff2 = cff1;
 7665:                   cff3 = 0.0;
 7666: 
 7667:                }
 7668:             } // if iveg
 7669:          } //  2D/3D
 7670: 
 7671:          av_cff1 += cff1/i34;
 7672:          av_cff2 += cff2/i34;
 7673:          av_cff3 += cff3/i34;
 7674:          av_cff2_chi += cff2*chi/i34;
 7675:          av_cff3_chi += cff3*chi/i34;
 7676:          av_df += min(htot, veg_h)/(htot*i34);
 7677: 
 7678: 
 7679:          // btrack values: U^\star, U^{\star\alpha}
 7680:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7681:          Vector2 Ustar       = {0.0, 0.0}; 
 7682:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7683: 
 7684:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7685:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7686:          } else { //3D
 7687:             for (int k = side->kb + 1; k < nvrt; k++) {
 7688:             
 7689:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7690:                Ustar += w2;
 7691: 
 7692:                if constexpr(iveg != 0) {
 7693:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7694:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7695:                        Ustar_alpha += zrat*w2; // XXXX
 7696:                    }
 7697:                }  // if iveg
 7698:             }  // for k
 7699:          }  //2D/3D
 7700: 
 7701:          // If needed, project the side velocities to the element frame
 7702:          if constexpr(ics==2) {
 7703:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7704:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7705:          }
 7706:         
 7707: 
 7708:          // Add btrack & surface stress terms to \breve{G} first
 7709:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7710: 
 7711: 
 7712:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7713:          Vector2 tau    = side->tau();  
 7714:          Vector2 ubstar = side->btu[side->kb + 1];  
 7715: 
 7716:          // If needed, project tau and ubstar to the element frame
 7717:          if constexpr(ics==2) {
 7718:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7719:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7720:          }
 7721: 
 7722:          // Term for surface and bottom stress
 7723:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7724: 
 7725: 
 7726:          // All terms in F,F^\alpha,f_b except baroclinic
 7727:          // F, f_b: all explicit terms excluding vegetation 
 7728:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7729:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7730:          const double coriolis = side->coriolis;
 7731:          Vector2 F  =  coriolis*side->U;  // F_x
 7732:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7733:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7734: 
 7735:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7736:             
 7737:             for (int k = side->kb; k < nvrt; k++) {
 7738:                if (zctr2 > side->zc[k-1]) {
 7739:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7740:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7741:                    Fa +=  coriolis*w2*zrat;
 7742:                } // if zctr2
 7743:             } // k
 7744:          } // iveg
 7745: 
 7746:          // Integrate horizontal viscosity force vertically
 7747:          for (int k=side->kb + 1; k<nvrt; k++) {
 7748:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7749: 
 7750:             F += levelHorVisc;
 7751: 
 7752:             // Vegetation term
 7753:             if constexpr(iveg!=0) {
 7754:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7755:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7756:                   Fa += levelHorVisc*zrat;
 7757:                } 
 7758:             } // if iveg
 7759:          } // for k
 7760: 
 7761:          // Get nu*grad(U) at the side's bottom level
 7762:          Vector2 nuGradU = side->nuGradU[side->kb];
 7763: 
 7764:          fb += nuGradU;
 7765: 
 7766:          // If needed, project vectorsF, fb and Fa to the element frame
 7767:          if constexpr(ics==2) {
 7768:             F    = side->frame.projHorVec(F,    elem->frame);
 7769:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7770:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7771:          } // if ics
 7772: 
 7773:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7774:       } // for j (nodes and sides)
 7775: 
 7776:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7777: 
 7778: 
 7779:       // Finish off terms in F, F^\alpha and f_b
 7780:       const double grav3 = elem->mean(&Node::grav2);
 7781:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7782:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7783:       for (int j=0; j<i34; j++) { 
 7784:          // For each side in the element...
 7785:          const Side *side = elem->sides[j];
 7786:          const double chi = side->chi;
 7787: 
 7788:          const double htot = side->htot2();
 7789:          const double veg_h = side->veg_h();
 7790:          const Vector2 F  = htot*fb;
 7791:          const Vector2 Fa = min(htot, veg_h)*fb;
 7792: 
 7793:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7794:       } // for j
 7795: 
 7796:       // tmp is already in elem frame
 7797:       elem->ghat1 += tmp/i34;
 7798: 
 7799:       // Baroclinic force
 7800:       if constexpr(ibc==0) {
 7801:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7802: 
 7803:          Vector2 Fa = {0.0, 0.0};
 7804:          Vector2 intGradRho = {0.0, 0.0};
 7805:          
 7806:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7807:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7808:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7809: 
 7810:             // \in F [m^2/s/s]
 7811:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7812:          }
 7813: 
 7814:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7815:          const Vector2 F = av_df*Fa; //approx
 7816:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7817: 
 7818:       } // if ibc
 7819: 
 7820: 
 7821: 
 7822:    }
 7823: 
 7824: } // extern "C"
 7825: 
 7826: 
 7827: 
 7828: #ifdef DONTCOMPILE
 7829: __global__ void checkMassConservation(Tracers* sumtr) {
 7830: 
 7831:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7832: 
 7833:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7834: 
 7835:    Element *elem = &(mesh->localElemData[i]);
 7836: 
 7837:    // Skip dry elements
 7838:    if (elem->isDry) return;
 7839: 
 7840:    // Local sum array for this thread
 7841:    double localSum[N_TRACERS] = {0.0};
 7842: 
 7843:    // Sum over vertical levels for this element
 7844:    const int kbe = elem->kbe;
 7845:    const double area = elem->area;
 7846: 
 7847:    for (int k = kbe; k < nvrt; k++) {
 7848:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7849:       
 7850:       // Accumulate tracer mass
 7851:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7852:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7853:       }
 7854:    }
 7855: 
 7856:    //  This function returns per element sums. A reduction must be done on the host side.
 7857: }
 7858: 
 7859: 
 7860: __global__ void transport(void) {
 7861: 
 7862:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7863: 
 7864:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7865: 
 7866:    Element *elem = &(mesh->localElemData[ie]);
 7867: 
 7868:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7869: 
 7870:                for (int m=0; m<ntr; m++) {
 7871:                   for (int k=kbe(ie); k<nvrt; k++) {
 7872:                      // Calculate each polynomial's weight 
 7873:                      wm=0.d0; sum1=0.d0; 
 7874:                      wm1=0.d0; wm2=0.d0; 
 7875:                      for (int i=0; i<elem->nweno2; i++) {
 7876:                   
 7877:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7878:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7879:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7880:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7881:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7882:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7883:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7884:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7885:                      // -----------------Hu and Shu (1999)'s method----------------
 7886:                      b4=b1+b2+b3
 7887: 
 7888: //Error: add PRODUCTION CPP
 7889: #ifdef DEBUG
 7890:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7891:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7892:                     call parallel_abort(errmsg)
 7893:                   }
 7894: #endif
 7895: 
 7896:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7897:                   // !----test-------------- 
 7898:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7899:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7900:                   // !wm(i)=wm1(i)*wm2(i)
 7901:                   // !---------------------- 
 7902:                   sum1=sum1+wm(i)
 7903:                 } // end for i
 7904: 
 7905:                 wm=wm/sum1
 7906: 
 7907:                 for (int j=0; j<elem->i34; j++) {
 7908: 
 7909:                   const Side *side  = elem->sides[j];
 7910:                   const Node *node1 = side->n1;
 7911:                   const Node *node2 = side->n2;
 7912: 
 7913:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7914:                      trsd=0.d0
 7915:                      for (int kk=0; kk<nquad; kk++) {
 7916:                         for (int i=0; i<elem->nweno2; i++) {
 7917:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7918:                         } // end for i   
 7919:                      } // end for kk
 7920:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7921:                   } // outward flux
 7922:                } // end for j=1,i34(ie) ! side
 7923:             }
 7924:          }
 7925:               
 7926: 
 7927: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7928: //             //   calculate each polynomial's weight 
 7929: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7930: //                 wm=0.d0; sum1=0.d0
 7931: //                 do i=1,nweno1(ie) !for each polynomial
 7932: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7933: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7934: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7935: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7936: //                   wm(i)=b2
 7937: //                   sum1=sum1+b2
 7938: //                   !wm(i)=1.d0
 7939: //                   !sum1=sum1+1.d0
 7940: 
 7941: // // Error: PRODUCTION
 7942: // #ifdef DEBUG
 7943: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7944: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7945: //                     call parallel_abort(errmsg)
 7946: //                   endif
 7947: // #endif
 7948: 
 7949: //                 enddo !i
 7950: //                 wm=wm/sum1 !final weight
 7951: 
 7952:                 for (int j=0; j<elem->i34; j++) { // side
 7953:                   const Side *side = elem->sides[j];
 7954:                   const Node *node1 = side->n1;
 7955:                   const Node *node2 = side->n2;
 7956: 
 7957:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7958:                     trsd=0.d0
 7959:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7960:                       for (int i=0; i<elem->nweno1; i++) {
 7961:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7962:                       }
 7963:                     enddo //kk
 7964:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7965:                   } // outward flux
 7966:                 } // end for j=1,i34(ie) ! side
 7967:               } // end for k; ntr 
 7968: 
 7969:             else !simple upwind method
 7970:               do j=1,i34(ie)
 7971:                 jsj=elside(j,ie)
 7972:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7973:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7974:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7975:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7976:                   endif
 7977:                 enddo  !vertical layers
 7978:               enddo !j=1,i34(ie) ! side
 7979:             endif !order of accuracy
 7980: 
 7981:          //  enddo !ie
 7982: // !$OMP     end do
