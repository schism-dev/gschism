 2412: 
 2413: 
 2414: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2415: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2416: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2417: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2418:    Vector2 grad = {0.0, 0.0};
 2419:    int count = 0;
 2420: 
 2421:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2422: 
 2423:    // First element
 2424:    if (elems[0] != nullptr && condition(elems[0])) {
 2425:       grad += elems[0]->grad2(field);
 2426:       count++;
 2427:    }
 2428: 
 2429:    // Second element
 2430:    if (elems[1] != nullptr && condition(elems[1])) {
 2431:       grad += elems[1]->grad2(field);
 2432:       count++;
 2433:    }
 2434: 
 2435:    if (count > 0) {
 2436:       grad = grad/count;
 2437:    }
 2438:    
 2439:    return grad;
 2440: }
 2441: 
 2442: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2443: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2444: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2445: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2446: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2447: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2448: 
 2449: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2450: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2451: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2452: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2453: 
 2454: 
 2455: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2456: 
 2457: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2458: 
 2459: /**
 2460:  * This method performs backtracking from the side center until a time -dt back in time 
 2461:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2462:  * intermediate point.
 2463:  *
 2464:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2465:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2466:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2467:  * remaining time.
 2468:  * 
 2469:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2470:  * 
 2471:  * @param uuint, vvint, wwint: Velocities at the final point
 2472:  * @param jlev: Level at which the backtracking is performed
 2473:  * @param dt, dtbk: Tracking timesteps
 2474:  * @return: True if the backtracking was successful, false otherwise
 2475:  */
 2476: __inline__ __device__ bool Side::btrack(
 2477:       int jlev,
 2478:       double dt,            // Tracking time
 2479:       double dtbk,          // Tracking timestep
 2480:       Vector3 &u_int        // Velocities at the initial point
 2481: ) const {
 2482: 
 2483:    // Start from side center
 2484:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2485:  
 2486: 
 2487:    double time_rm = dt; // Remaining time
 2488: 
 2489: 
 2490:    // // Initialize outputs XXX
 2491:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2492:    //    sclr[i] = 0.0;
 2493:    // }
 2494: 
 2495: 
 2496:    // Initial velocities
 2497:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2498: 
 2499:    // Find the element that is in the direction opposite to the velocity
 2500:    Element* curElem = findElementTowards(toVector2(u_int));
 2501: 
 2502:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2503:    if (curElem == nullptr) {
 2504:       // Make velocity parallel to the side
 2505:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2506:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2507:       curElem = otherElem(curElem);
 2508:       
 2509:    }
 2510: 
 2511: 
 2512: 
 2513:    const int MAX_ITERATIONS = 1000; 
 2514:    Element* nextElem = curElem;
 2515:    int iter = 0;
 2516:    while(true) {
 2517: 
 2518:       // Calculate timestep
 2519:       double dtb = min(dtbk, time_rm);
 2520: 
 2521:       // Next point in the backtracking curve
 2522:       Point3 xt = x0 - dtb*u_int;
 2523: 
 2524: 
 2525:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2526:       assert(found && "Backtracking failed in btrack");
 2527: 
 2528:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2529:                       // then time_rm needs to be increased by the unused time.
 2530:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2531: 
 2532:       // The current point becomes the next segment's starting point.
 2533:       x0 = xt;
 2534:  
 2535:       curElem = nextElem;
 2536: 
 2537:       iter++;
 2538:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2539:    }
 2540: 
 2541: 
 2542: }
 2543: 
 2544: 
 2545: 
 2546: // /**
 2547: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2548: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2549: 
 2550: //    Inputs:
 2551: //    @param x1, y1: point inside the element
 2552: //    @param x2, y2: other end of the line segment
 2553: 
 2554: //    Outputs:
 2555: //    @param intersectingSide:  side that intersects the line segment
 2556: //    @param nextElement: element that contains the intersection point
 2557: //    @param xIntersect, yIntersect: intersection point  
 2558: 
 2559: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2560: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2561: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2562: 
 2563: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2564: //    (Delta) being zero.
 2565: 
 2566: //    The intersection point happens when:
 2567: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2568: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2569:    
 2570: //    Assumption: the 4 points (including those of the side segment) are different.
 2571: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2572: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2573: //    If true, (xIntersect,yIntersect) is the intersection.				
 2574: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2575: // **/
