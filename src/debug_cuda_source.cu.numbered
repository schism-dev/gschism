 1566: // Helper functions for computing the local node index at a given offset from another.
 1567: __device__ __inline__ int nxq(int offset, int index, int size) {
 1568:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1569:    // to the index to make it positive
 1570:    assert(index + offset + 16*size >= 0);
 1571:    return (index + offset + 16*size) % size;  
 1572: }
 1573: 
 1574: __device__ __inline__ int nxq(int index, int size) {
 1575:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1576:    // to the index to make it positive
 1577:    assert(index + 16*size >= 0);
 1578:    return (index + 16*size) % size; 
 1579: }
