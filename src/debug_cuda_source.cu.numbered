 1136:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 1137:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
