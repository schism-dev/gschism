 4720: 
 4721: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4722:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4723:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4724:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4725: }
 4726: 
 4727: 
 4728: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4729:    // Brunt-Väisälä frequency at level k.
 4730:    if (k <= node->kb || k >= ivrt) return 0.0;
 4731:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4732: }
 4733: 
 4734: 
 4735: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4736: 
 4737:    
 4738:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4739:    // k is the layer bottom index.
 4740: 
 4741: 
 4742: 
 4743:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4744: 
 4745:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4746:       const double eta2 = node->eta2;
 4747:       const double depth = node->depth;
 4748: 
 4749:       // Distances from the layer midpoint to the surface and bottom
 4750:       const double dist_s = eta2 - z_c;
 4751:       const double dist_b = z_c + depth;
 4752: 
 4753:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4754: 
 4755:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4756: 
 4757: 
 4758:    } else {
 4759:       return 1.0; // Other GLS submodels
 4760: 
 4761:    }
 4762: }
 4763: 
 4764: 
 4765: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4766:    // Minimum mixing length for levels below the surface.
 4767:    // Independent of psimin(); do not invert one to get the other.
 4768:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4769: }
 4770: 
 4771: 
 4772: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4773: 
 4774:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4775: 
 4776:    if constexpr(iveg == 1) {
 4777:       
 4778:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4779:       const double zTopCanopy = node->zTopCanopy();
 4780: 
 4781:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4782: 
 4783:          const double ztop = node->z[k];   // Top of the current layer.
 4784: 
 4785:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4786:          // Where 1 means that the current level is fully within the vegetation layer.
 4787:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4788: 
 4789:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4790:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4791: 
 4792:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4793:          // and at the bottom of the layer.
 4794:          const double vmag_top = length(ub2_top);
 4795:          const double vmag_bot = length(node->u2[k-1]);
 4796: 
 4797:          // Volume-averaged velocity cubed.
 4798:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4799: 
 4800:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4801:          // and at the bottom of the layer.
 4802:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4803:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4804: 
 4805:          // Volume-averaged vegetation alpha cubed.
 4806:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4807: 
 4808:          return veg_alpha3D*vmag3;
 4809:       } 
 4810:       else {
 4811:          // The current level is not within the vegetation layer, so the production is 0.
 4812:          return 0.0;
 4813:       }
 4814:    } else {
 4815: 
 4816:       // If no vegetation, the production is 0.
 4817:       return 0.0;
 4818:    }
 4819: 
 4820: }
 4821: 
 4822: 
 4823: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 4824:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 4825:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 4826: 
 4827:    const int kb = node->kb;
 4828: 
 4829:    for (int k = kb; k < nvrt; k++) {
 4830:       const double tke = this->tke[k];
 4831:       const double mxl = this->mxl[k];
 4832:       const double u = sqrt(tke);  // Characteristic velocity
 4833:       const double lu = mxl*u;     // Characteristic diffusivity 
 4834: 
 4835:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 4836:       double drho_dz = 0.0;
 4837:       if (k > kb && k < ivrt) {
 4838:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4839:       }
 4840: 
 4841:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 4842: 
 4843:       // Tsinghua group       
 4844:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 4845: 
 4846:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 4847:       if constexpr (stabilityModel == Galperin) {
 4848:          sh = 0.49393/(1.0-34.676*Gh);
 4849:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 4850:          cmiu  = sqrt(2.0)*sm;
 4851:          cmiup = sqrt(2.0)*sh;
 4852:          cmiu1 = sqrt(2.0)*0.2;
 4853:          cmiu2 = sqrt(2.0)*0.2;
 4854: 
 4855:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 4856:          // Warner's paper has problem
 4857:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 4858:          const double Ghp = Gh;  /// XXXXX needed?
 4859:          sh = 0.4939/(1.0 - 30.19*Ghp);
 4860:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 4861:          cmiu  = sqrt(2.0)*sm;
 4862:          cmiup = sqrt(2.0)*sh;
 4863:          cmiu1 = cmiu/schk();
 4864:          cmiu2 = cmiu/schpsi();
 4865: 
 4866:       } else {
 4867:          assert(false && "Unknown ASM");
 4868: 
 4869:       }
 4870: 
 4871:       node->dfv[k] = clamp(cmiu  * lu, diffmin(), diffmax());
 4872:       node->dfh[k] = clamp(cmiup * lu, diffmin(), diffmax());
 4873:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin(), diffmax());
 4874:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin(), diffmax());
 4875:    }
 4876: }
 4877: 
 4878: 
 4879: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 4880: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 4881: 
 4882:    const double z = node->z[k];
 4883:    const double eta2 = node->eta2;
 4884:    const double depth = node->depth;
 4885: 
 4886:    // Distances to the surface and bottom
 4887:    const double dist_s = eta2 - z;
 4888:    const double dist_b = z + depth;
 4889: 
 4890:    // Distance to the closest "wall" (either surface or bottom).  
 4891:    // In the top layer, it is the size of the layer.
 4892:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 4893:    assert(min_dist > 0.0 && "Invalid minimum distance");
 4894: 
 4895:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 4896:    return kappa*min_dist;
 4897: }
 4898: 
 4899: 
 4900: 
 4901: template<TurbulenceModel turbulenceModel>
 4902: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 4903: 
 4904: 
 4905: template<>
 4906: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 4907:    // Constant turbulence model
 4908:    // Does nothing since dfv and dfh are already set  in the initialization.
 4909: }
 4910: 
 4911: template<>
 4912: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 4913:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 4914: 
 4915:    // Solves the following PDEs:
 4916:    //
 4917:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 4918:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 4919:    //
 4920:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 4921:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 4922:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 4923:    //
 4924:    // The equations are solved using a linear *vertical* FEM formulation.
 4925:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 4926:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 4927:    
 4928:    
 4929:    // Get the turbulence model
 4930:    // reinterpret_cast is used to avoid stupid compiler errors.
 4931:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 4932:      
 4933:    const int kb = node->kb;
 4934:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 4935: 
 4936:    double alow_tke[nvrt], alow_phi[nvrt];
 4937:    double bdia_tke[nvrt], bdia_phi[nvrt];
 4938:    double cupp_tke[nvrt], cupp_phi[nvrt];
 4939:    double rhs_tke [nvrt], rhs_phi [nvrt];
 4940:    
 4941:    // Initialize the tridiagonal system
 4942:    for (int kin = 0; kin < nqrows; kin++) {
 4943:       alow_tke[kin]=0.0;
 4944:       bdia_tke[kin]=0.0;
 4945:       cupp_tke[kin]=0.0;
 4946:       rhs_tke [kin]=0.0; 
 4947:       alow_phi[kin]=0.0;
 4948:       bdia_phi[kin]=0.0;
 4949:       cupp_phi[kin]=0.0;
 4950:       rhs_phi [kin]=0.0; 
 4951:    }
 4952: 
 4953: 
 4954: 
 4955:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 4956:    if (node->isDry || node->is2D()) {
 4957: 
 4958:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 4959:       const double diffmin = turb.diffmin();
 4960: 
 4961:       for (int k = 0; k < nvrt; k++) {
 4962:          turb.tke[k]    = turb.tkemin();
 4963:          turb.mxl[k]    = turb.mxlmin(node->depth);
 4964:          node->dfv[k]   = diffmin;
 4965:          node->dfh[k]   = diffmin;
 4966:          turb.nu_tke[k] = diffmin;
 4967:          turb.nu_phi[k] = diffmin;
 4968:       }
 4969: 
 4970:       return;
 4971:    }
 4972: 
 4973:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 4974:    
 4975:    // After here we know that the node is wet and has at least 2 layers.
 4976: 
 4977:    double solution[nvrt], gam[nvrt];
 4978:    
 4979:    const double eta2       = node->eta2;
 4980:    const double depth      = node->depth;
 4981:    const double Cd         = node->Cd; // Drag coefficient
 4982: 
 4983:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 4984:    
 4985:    const double sqU2 = norm2(node->u2[kb + 1]);
 4986:    const double modTau = length(node->tau);
 4987: 
 4988:  
 4989: 
 4990:    const double cpsi1 = turb.cpsi1();
 4991:    const double cpsi2 = turb.cpsi2();
 4992:    // cpsi3 is computed later because it depends on k
 4993: 
 4994: 
 4995:    // Assemble the tridiagonal system
 4996:    // -------------------------------
 4997: 
 4998:    // Loop over each vertical layer (interval between two vertical levels)
 4999:    // Each interval is an element of the vertical FEM formulation.
 5000:    // Two shape functions are defined over each interval. In this function we well call them
 5001:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5002:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5003:    //
 5004:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5005:    // Both systems of equations are assembled in the same loop.
 5006:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5007: 
 5008:       // Indices for the *rows* of the tridiagonal system.
 5009:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5010:       const int k2 = k - kb;     // One at k = kb + 1
 5011: 
 5012:       // Get the properties of the current interval.
 5013:       const double z  = node->z[k]; // bottom level of the interval
 5014:       const double dz = node->Dz(k + 1);
 5015:       const double rho_c = 0.5*(node->rho[k] + node->rho[k+1]);
 5016:       
 5017:       const Vector2 du_dz   = (node->u2[k+1] - node->u2[k])/dz;
 5018:       const double drho_dz = (node->rho[k+1] - node->rho[k])/dz;
 5019: 
 5020:       // Turbulence production/dissipation terms (at the center of the interval).
 5021:       
 5022:       const double M2 = norm2(du_dz);              // Shear production term
 5023: 
 5024:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5025: 
 5026:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5027: 
 5028:       const double cpsi3 = turb.cpsi3(N2); 
 5029: 
 5030: 
 5031:       // Turbulence quantities at half levels (cell [c]enter)
 5032:       const double tke_1     = turb.tke[k];
 5033:       const double tke_2     = turb.tke[k+1];
 5034:       const double mxl_1     = turb.mxl[k];
 5035:       const double mxl_2     = turb.mxl[k+1];
 5036:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5037:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5038:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5039:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5040:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5041:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5042:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5043: 
 5044:       // Integral of the shape function products:
 5045:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5046:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5047:       const double p1p1 = dz/3.0;
 5048:       const double p1p2 = dz/6.0;
 5049:       const double d1d1 =  1.0/dz;
 5050:       const double d1d2 = -1.0/dz;
 5051: 
 5052:       // Production/dissipation related terms
 5053:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5054:       const double buoy = dfh_c*N2;
 5055:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5056: 
 5057:       // Equation for tke
 5058:       // ---------------
 5059: 
 5060:       // First row (of the two rows that the interval contributes to)
 5061:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5062:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5063:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5064: 
 5065: 
 5066:       if(prod + buoy >= 0.0) { // Net production
 5067:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5068:       } else { // Net dissipation
 5069:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5070:          bdia_tke[k1] -= 2.0*tmp;
 5071:          cupp_tke[k1] -= tmp;
 5072:       }      
 5073:       
 5074:       bdia_tke[k1] += 2.0*dt*diss;
 5075:       cupp_tke[k1] += dt*diss;
 5076:       
 5077:   
 5078:       // Second row (of the two rows that the interval contributes to)
 5079:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5080:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5081:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5082: 
 5083:       if (prod + buoy >= 0.0) { // Net production
 5084:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5085:       } else { // Net dissipation
 5086:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5087:          bdia_tke[k2] -= 2.0*tmp;
 5088:          alow_tke[k2] -= tmp;
 5089:       }
 5090:       
 5091:       bdia_tke[k2] += 2.0*dt*diss;
 5092:       alow_tke[k2] += dt*diss;
 5093: 
 5094: 
 5095:       // Equation for xl
 5096:       // ---------------
 5097: 
 5098:       const double rpub = turb.rpub();
 5099:       const double rmub = turb.rmub();
 5100:       const double rnub = turb.rnub();
 5101:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5102:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5103:       const double psi_c = 0.5*(psi_1 + psi_2);
 5104: 
 5105:       // Production/dissipation related terms
 5106:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5107:       const double buoy_phi = cpsi3*dfh_c*N2;
 5108:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5109: 
 5110:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5111:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5112:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5113: 
 5114:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5115:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5116:       } else { // Net dissipation
 5117:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5118:          bdia_phi[k1] -= 2.0*tmp;
 5119:          cupp_phi[k1] -= tmp;
 5120:       }
 5121: 
 5122:       // Production/dissipation terms
 5123:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5124:       cupp_phi[k1] += dt*diss_phi;
 5125:  
 5126: 
 5127:       // row k2 (upper)
 5128:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5129:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5130:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5131: 
 5132:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5133:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5134:       } else { // Net dissipation
 5135:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5136:          bdia_phi[k2] -= 2.0*tmp;
 5137:          alow_phi[k2] -= tmp;
 5138:       }
 5139: 
 5140:       // Production/dissipation terms
 5141:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5142:       alow_phi[k2] += dt*diss_phi;
 5143: 
 5144:    }
 5145: 
 5146:    // BC
 5147:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5148:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5149: 
 5150: 
 5151:    // Solves for tke.
 5152:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5153: 
 5154: 
 5155:    // B.C. (computed using values from previous time except wind)
 5156:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5157:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5158: 
 5159: 
 5160:    // Update TKE.
 5161:    turb.tke[kb]     = tkebot;
 5162:    turb.tke[kb + 1] = tkebot;
 5163:    turb.tke[ivrt]   = tkesrf;
 5164:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5165:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5166:    }
 5167: 
 5168: 
 5169: 
 5170:  
 5171:    // Solves for phi.
 5172:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5173: 
 5174: 
 5175:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5176:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5177:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5178: 
 5179:    turb.mxl[kb+1] = mxlbot;
 5180:    turb.mxl[ivrt] = mxlsrf;
 5181:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5182:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5183: 
 5184:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5185: 
 5186:       // Galperin's clipping
 5187:       if (N2 < 0.0) {
 5188:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5189:          turb.mxl[k] = min(turb.mxl[k], upper);
 5190:       }   
 5191: 
 5192: 
 5193: 
 5194:       // Max. mixing length based on dissipation; mxlmin prevails
 5195:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5196: 
 5197:       // Combined max. mixing length including geometric limit
 5198:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5199: 
 5200:       // Clamp the mixing length between the minimum and maximum values
 5201:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5202: 
 5203:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5204: 
 5205: 
 5206:    } // for k
 5207: 
 5208: 
 5209:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5210:    turb.tke[kb] = turb.tke[kb + 1];
 5211:    turb.mxl[kb] = turb.mxl[kb + 1];
 5212: 
 5213: 
 5214:    // Compute vertical diffusivities at new time
 5215:    turb.computeDiffusivities(node);
 5216: 
 5217:    // make all the variables uniform below the bottom level kb
 5218:    for (int k = 0; k < kb; k++) {
 5219:       node->dfv[k] = node->dfv[kb];
 5220:       node->dfh[k] = node->dfh[kb];
 5221:       turb.tke[k] = turb.tke[kb];
 5222:       turb.mxl[k] = turb.mxl[kb];
 5223:       turb.nu_tke[k] = turb.nu_tke[kb];
 5224:       turb.nu_phi[k] = turb.nu_phi[kb];
 5225:    }
 5226: 
 5227:       
 5228: 
 5229: }
 5230: 
 5231: 
 5232: 
 5233: 
 5234: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5235:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5236:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5237: 
 5238: 
 5239:    NODE(node1);
 5240: 
 5241:    node1->clearMatrixRow();
 5242:    node1->qel = 0.0;
 5243: 
 5244:    // THIS IS FOR STRUCTURES XXX
 5245:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5246: 
 5247:    
 5248:    for (int j=0; j<node1->numElements; j++) {
 5249:       // For each element connected to the node...
 5250: 
 5251:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5252: 
 5253:       Element *elem = node1->elements[j];
 5254: 
 5255:       // Compute the average gravity
 5256:       const double grav3 = elem->mean(&Node::grav2);
 5257: 
 5258:       // Look at the documentation for the description of the terms in the following integrals
 5259: 
 5260:       // Integral I_1 
 5261:       // \bar{\breve{H}} 
 5262:       const double hhatb = elem->mean(&Side::hhat);        
 5263: 
 5264:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5265: 
 5266:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5267:       const double area = elem->area;
 5268: 
 5269:       // Integral I_4
 5270:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5271:       // Where
 5272:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5273: 
 5274:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5275:       // of U over the element.
 5276:       const Vector2 U = elem->mean(&Side::U);
 5277: 
 5278:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5279: 
 5280:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5281:       const double I_4_1 = dot(gradPhi_1, U);
 5282: 
 5283: 
 5284:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5285:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5286: 
 5287:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5288: 
 5289: 
 5290:       // Normal component of the bed velocity
 5291:       double ubedNormalComp = 0.0;
 5292:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5293:          Vector3 ubed = {0.0, 0.0, 0.0};
 5294:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5295:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5296: 
 5297:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5298:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5299:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5300: 
 5301:          // Computes the normal component of the bed velocity
 5302:          ubedNormalComp = dot(ubed, N);
 5303:       } // imm==2
 5304: 
 5305:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5306: 
 5307:       if (elem->isTri()) {
 5308: 
 5309:          // To clarify the notation in this section: 
 5310:          //   In formulas, we use the following notation:
 5311:          //       i stands for the node under consideration (node1)
 5312:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5313:          //   However, in the code, we use the following notation:
 5314:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5315:          const int id2 = elem->nxq(1 + id1);
 5316:          const int id3 = elem->nxq(2 + id1);
 5317:          Node *node2 = elem->nodes[id2];
 5318:          Node *node3 = elem->nodes[id3];
 5319: 
 5320:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5321: 
 5322:          // integral of phi_i*phi_j
 5323:          const double ipp_ii = (1.0/6.0 )*area;
 5324:          const double ipp_ij = (1.0/12.0)*area;
 5325:          const double ipp_ik = (1.0/12.0)*area;
 5326: 
 5327:          // integral of [(grad phi_i) * (grad phi_j)]
 5328:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5329:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5330:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5331: 
 5332:          // Computes the different components of integral I_1 of each node with respect to node i.
 5333:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5334:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5335:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5336: 
 5337:          node1->addToSparseMatrix(node1, I1_ii);
 5338:          node1->addToSparseMatrix(node2, I1_ij); 
 5339:          node1->addToSparseMatrix(node3, I1_ik);
 5340: 
 5341:          #pragma unroll
 5342:          for (int l=0; l<3; l++) {
 5343: 
 5344:             Node *node = elem->nodes[l];
 5345: 
 5346:             // Additional variation in eta due to bed deformation or vertical velocity
 5347:             double extraEta = 0.0;
 5348:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5349:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5350: 
 5351: 
 5352:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5353:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5354: 
 5355:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5356: 
 5357:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5358:            
 5359:          }
 5360: 
 5361: 
 5362:       }
 5363:       else { // Quad
 5364:          // To clarify the notation in this section: 
 5365:          //   In formulas, we use the following notation:
 5366:          //       i stands for the node under consideration (node1)
 5367:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5368:          //   However, in the code, we use the following notation:
 5369:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5370:          const int id2 = elem->nxq(1 + id1);
 5371:          const int id3 = elem->nxq(2 + id1);
 5372:          const int id4 = elem->nxq(3 + id1);
 5373:          Node *node2 = elem->nodes[id2];
 5374:          Node *node3 = elem->nodes[id3];
 5375:          Node *node4 = elem->nodes[id4];   
 5376:          
 5377:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5378: 
 5379:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5380:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5381:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5382:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5383:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5384: 
 5385:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5386:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5387:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5388:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5389:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5390: 
 5391: 
 5392:          // Computes the different components of integral I_1 of each node with respect to node i.
 5393:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5394:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5395:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5396:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5397: 
 5398:          node1->addToSparseMatrix(node1, I1_ii);
 5399:          node1->addToSparseMatrix(node2, I1_ij); 
 5400:          node1->addToSparseMatrix(node3, I1_ik);
 5401:          node1->addToSparseMatrix(node4, I1_il);
 5402:   
 5403:          #pragma unroll
 5404:          for (int l=0; l<4; l++) {
 5405: 
 5406:             const Node *node = elem->nodes[l];
 5407: 
 5408:             // Additional variation in eta due to bed deformation or vertical velocity
 5409:             double extraEta = 0.0;
 5410:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5411:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5412: 
 5413:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5414:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5415:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5416: 
 5417:          }         
 5418:       } 
 5419: 
 5420: 
 5421:      node1->qel += (dt/elem->i34)*elem->vsource;
 5422:       
 5423: 
 5424:    } // for all elements connected to the node
 5425:    
 5426: 
 5427:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5428:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5429:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5430:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5431:    // If it is an open boundary node...
 5432: 
 5433:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5434: 
 5435:       // At least one open bnd side, maybe two
 5436:       for (int l=0; l<2; l++) { 
 5437: 
 5438:          // Gets each of the sides sharing the node. 
 5439:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5440: 
 5441:     
 5442: 
 5443:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5444:          if (sideBnd != nullptr) {
 5445:             // If the side is on a boundary...
 5446: 
 5447:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5448: 
 5449:             // Get the boundary segment
 5450:             const BoundarySegment *sideSegment = sideBnd->segment;
 5451:             const Side *side = sideBnd->side;
 5452: 
 5453:             // Integral I_3
 5454:             if (sideSegment->ifltype != 0) {
 5455:             // Natural or Flather b.c.
 5456: 
 5457:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5458:                // especially for Flather b.c.
 5459:                double ri3 = 0.0;
 5460:                if (!side->isDry) {
 5461:                   // If the side is not dry
 5462:                   
 5463:                   // Computes the side flux of (uth, vth)
 5464:                   double Vn = 0.0;
 5465:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5466:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5467:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5468: 
 5469:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5470:                   }
 5471: 
 5472:                   ri3 = 0.5*side->len*Vn;
 5473:                }
 5474: 
 5475:                if (sideSegment->ifltype == -1) { // Flather 1
 5476: 
 5477:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5478:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5479: 
 5480:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5481:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5482:                   
 5483:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5484:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5485: 
 5486:                } 
 5487:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5488:                   // Reset ri3
 5489:                   ri3 = 0.0;
 5490: 
 5491:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5492:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5493: 
 5494:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5495: 
 5496:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5497:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5498: 
 5499:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5500:                   node1->addToSparseMatrix(node1, con0*2.0);
 5501:                   node1->addToSparseMatrix(node2, con0);
 5502: 
 5503:                } // if Flather or Discharge
 5504: 
 5505:                node1->qel -= thetai*dt*ri3;  
 5506: 
 5507: 
 5508:             } // I_3
 5509:           
 5510: 
 5511:             // Integral I_5
 5512:             if(!side->isDry) {
 5513: 
 5514:                const double Unbar = dot(side->U, side->n);
 5515:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5516: 
 5517:             } // I_5
 5518: 
 5519:          } // if is boundary side
 5520: 
 5521:       } // for l
 5522: 
 5523:    } // if isbnd
 5524: 
 5525: 
 5526: }
 5527: 
 5528: 
 5529: 
 5530: extern "C" {
 5531: 
 5532:    __global__ void gatherBFromMesh(double* b) {
 5533:       // b[local] <- qel  (local = idx_node on this device)
 5534:       NODE(node);
 5535:       b[idx_node] = node->qel;
 5536:    }
 5537: 
 5538:    
 5539:    __global__ void scatterXToMesh(double* x) {
 5540:       // mX <- x[local]
 5541:       NODE(node);
 5542:       node->mX = x[idx_node];
 5543:    }
 5544: 
 5545:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 5546:                                  int* indices, int* indptr) {
 5547:       // XXXXXXXXXXXX REMOVE!!!
 5548:       assert(false && "setupCGSolver has beed deprecated");
 5549: 
 5550:       // NODE(node);
 5551:       
 5552:       // const int idx = node->idx;
 5553:       
 5554:       // // Computes the index in the nzz array      
 5555:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 5556: 
 5557: 
 5558:       // indptr[idx] = nzzIdx;
 5559:       // indices[nzzIdx] = idx;
 5560: 
 5561:       // data_d[nzzIdx]    = node->coeffDiag;
 5562: 
 5563:       // b_d[idx] = node->qel;
 5564: 
 5565:       // for (int k = 0; k < node->numNodes; ++k) {
 5566:       //    const Node* nb = node->nodes[k];
 5567: 
 5568:       //    const int j = nb->idx;
 5569: 
