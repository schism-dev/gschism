  819:    // ------------------------------------------------------------------------------------------------
  820:    // These are functions that work on all nodes/sides of the element.
  821:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  822:    //
  823:    // An example of how to use these functions is:
  824:    //   
  825:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
