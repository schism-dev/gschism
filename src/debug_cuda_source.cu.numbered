 7186: extern "C"
 7187:                                  
 7188:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7189:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7190:                    double *wind_rotate_angle, 
 7191:                    int *isdel, int *isidenode, int *isbnd,
 7192:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7193:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7194:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7195:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7196:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7197:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7198:                    double *drag, double *roughness,
 7199:                    double *emo, double *efa, 
 7200:                    double *umo, double *ufa, 
 7201:                    double *vmo, double *vfa) {
 7202: 
 7203:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7204:                        isdel, isidenode, isbnd,
 7205:                        nond, nlnd, iond, ilnd, 
 7206:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7207:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7208:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7209:                        localNodeIndices, localElemIndices, localSideIndices,
 7210:                        localNodePart, localElemPart, localSidePart,
 7211:                        drag, roughness,
 7212:                        emo, efa, umo, ufa, vmo, vfa);
 7213:   }
