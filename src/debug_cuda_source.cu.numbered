 3104: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(BTPoint &curPoint, Point3 &xt) {
 3105: // This function deals with the case where the point is moving outside the side. In other words, the point is in a side and it is moving out of the mesh or into a dry element.
 3106: // This is one of the cases where sliding along a side happens.
 3107: 
 3108:    // Instead of the interpolated velocity, we use the tangent of the velocity *at the side center* as the velocity of the point. 
 3109: 
 3110:    const Side *side = curPoint.side;
 3111: // // Debug: Check assertion conditions
 3112: // const bool isBnd = side->isBnd();
 3113: // Element *otherElem = side->otherElem(curPoint.elem);
 3114: // const bool otherIsDry = (otherElem != nullptr) ? otherElem->isDry : false;
 3115: // const bool curElemIsDry = (curPoint.elem != nullptr) ? curPoint.elem->isDry : true;
 3116:   
 3117: //   printf("DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE: side->idx = %d, side->isBnd() = %d, curPoint.elem = %p, curPoint.elem->isDry = %d, otherElem = %p, otherElem->isDry = %d, assertion = %d\n",
 3118: //          side->idx, isBnd, curPoint.elem, curElemIsDry, otherElem, otherIsDry, (isBnd || otherIsDry));
 3119: 
 3120: //    // We start with a point on the side and it is moving along it. First we check that it is a side in a boundary.
 3121: //    assert(side->isBnd() || side->otherElem(curPoint.elem)->isDry && "Side is not a boundary between wet and dry elements (or boundary side)");
 3122: 
 3123:    const Vector2 tangent = side->t12();
 3124: 
 3125:    // In this case, the particle slides along the side. The next point is calculated using the tangent component of the side velocity.
 3126:    const Vector3 uSide = side->interpolateCenterVelocityVertically(xt);
 3127:    toVector2(curPoint.u) = dot(toVector2(uSide), tangent)*tangent;
 3128:    curPoint.u.z = uSide.z;
 3129: 
 3130:    // Computes the new location of the point sliding along the side. The z-coordinate is not changed because curPoint.u.z is also unchanged.
 3131:    xt = curPoint.x - curPoint.dt*curPoint.u;   
 3132: 
 3133:    // This is a situation we know how to handle. A point that is moving along a side.
 3134:    DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3135: 
 3136: }
 3137: 
 3138: __device__ void DEAL_WITH_POINT_MOVING_ALONG_SIDE(BTPoint &curPoint, Point3 &xt) {
 3139:    // This function deals with the case where the point is moving along a side.
 3140: 
 3141:    Side *side = curPoint.side;
 3142:    const Point3 x0 = curPoint.x;
 3143:    const Vector2 tangent = side->t12();
 3144:    const double len = length(toPoint2(xt) - toPoint2(x0));
 3145: 
 3146:    const double t = dot(toPoint2(xt) - side->n1->p, tangent)/side->len;  // Parameterization of the location of the point on the side (0 at n1, 1 at n2)
 3147: 
 3148:    if (curPoint.elem == nullptr) curPoint.elem = side->elems[0];  // elems[0] is never nullptr. This is done in case the element is not set yet.
 3149: assert(side->elems[0] != nullptr && "side->elems[0] is nullptr");
 3150: // if (side->elems[0] != nullptr) printf("PPPP side->elems[0]->isDry = %d\n", side->elems[0]->isDry);
 3151: // if (side->elems[1] != nullptr) printf("PPPP2 side->elems[1]->isDry = %d\n", side->elems[1]->isDry);
 3152: 
 3153:    if (t < geometricEpsilon) {
 3154:       // The point is at a node.
 3155:       curPoint.type = BTPoint::BTPointType::btNode;
 3156:       curPoint.node = side->n1;
 3157:       curPoint.side = side;
 3158:       curPoint.t = 0.0; // Not really needed.
 3159: 
 3160:       
 3161:    }
 3162:    else if (t > 1.0 - geometricEpsilon) {
 3163:       // The point is at a node.
 3164:       curPoint.type = BTPoint::BTPointType::btNode;
 3165:       curPoint.node = side->n2;
 3166:       curPoint.side = side;
 3167:       curPoint.t = 1.0; 
 3168: 
 3169:    }
 3170:    else {
 3171:       // The point is along the side.
 3172:       curPoint.type = BTPoint::BTPointType::btSide;
 3173:       curPoint.node = nullptr;
 3174:       curPoint.side = side;
 3175:       curPoint.t = t;
 3176:       
 3177:    }
 3178: if (curPoint.t != t) printf("YYY2 curPoint.t=%.17f, t=%.17f\n", curPoint.t, t);
 3179:    toPoint2(curPoint.x) = side->p_t(curPoint.t);
 3180: 
 3181:    // Computes the fraction between the lenth it should have traveled if the side was infinite and
 3182:    // the actual length it has traveled.
 3183:    const double lenOrig  = length(side->p_t(t, false) - toPoint2(x0));
 3184:    const double lenFinal = length(toPoint2(curPoint.x) - toPoint2(x0));
 3185:    const double fractionOfLength = lenFinal/lenOrig;
 3186:   
 3187:    curPoint.x.z = (1.0 - fractionOfLength)*x0.z + fractionOfLength*xt.z;   
 3188:    curPoint.dt = curPoint.dt*fractionOfLength; 
 3189: 
 3190: addDebugPlot(x0, curPoint.x, 0xFF010F, 'x');
 3191: }
 3192: 
 3193: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(BTPoint &curPoint, Point3 &xt) {
 3194: // This function deals with the case where the point is moving outside from a node. In other words, the point is in a node and it is moving out of the mesh or into a dry element.
 3195: 
 3196:    const Element *elem = curPoint.elem;
 3197:    const Node *node    = curPoint.node;
 3198:    const Point3 x0     = curPoint.x;
 3199: 
 3200:    // computes the sides that delimit the contiguous block of wet elements containing elem
 3201: 
 3202:    assert(elem != nullptr && "elem is nullptr");
 3203:    assert(!elem->isDry && "elem is dry");
 3204:    assert(node != nullptr && "node cannot be nullptr");
 3205: 
 3206:    const int numSides = node->numSides;
 3207: 
 3208:    int idxStartWet = 0;      // First wet side index
 3209:    int idxEndWet = numSides; // Last wet side index
 3210: 
 3211: printf("BBBBB numSides = %d\n", numSides);
 3212: 
 3213: 
 3214: 
 3215:    // Finds the first wet side index
 3216:    for (int i = 0; i < numSides; i++) {
 3217:       const int prevIdx = (i + numSides - 1) % numSides;
 3218: if (it>=135) printf("BBBBB i = %d, prevIdx = %d, numSides = %d, node = %p\n", i, prevIdx, numSides, node);
 3219: if (it>=135) printf("BBBBB node->idx = %d, node->sides = %p\n", node->idx, node->sides);
 3220: if (it>=135) printf("BBBBB i = %d, node->sides[prevIdx] = %p, node->sides[i] = %p\n", node->sides[prevIdx], node->sides[i]);
 3221: // if (it>=135 && node != nullptr) printf("BBBBB prevIdx = %d, i = %d, node->sides[prevIdx] = %p, node->sides[i] = %p\n", prevIdx, i, node->sides[prevIdx], node->sides[i]);
 3222:       if (node->sides[prevIdx]->isDry && !node->sides[i]->isDry) idxStartWet = i;
 3223: 
 3224:       if (elem->containsSide(node->sides[i])) break;
 3225:    }
 3226: 
 3227:    // Finds the last wet side index
 3228:    for (int i = numSides - 1; i >= 0; i--) {
 3229:       const int nextIdx = (i + 1) % numSides;
 3230: 
 3231:       if (node->sides[nextIdx]->isDry && !node->sides[i]->isDry) idxEndWet = i;
 3232: 
 3233:       if (elem->containsSide(node->sides[i])) break;
 3234:    }
 3235: 
 3236:    // At this point idxStartWet and idxEndWet are the indices of the first and last wet sides in the contiguous block of wet sides containing elem.
 3237:    // If idxStartWet == 0 and idxEndWet == numSides - 1, all the sides are wet. This is only possible if the node is a boundary node.
 3238: 
 3239:    // These two sides are the ones that delimit the contiguous block of wet sides containing elem.
 3240:    Side *s1 = node->sides[idxStartWet];
 3241:    Side *s2 = node->sides[idxEndWet];
 3242: 
 3243:    assert(idxStartWet != 0 || idxEndWet != numSides - 1 || s1->sideBnd != nullptr || s2->sideBnd != nullptr && "Node is not a boundary node");
 3244: 
 3245:    // Now, there are two possibilities: 
 3246:    // - If any (or both) side velocities point away from the node, the point will slide along the side with the highest velocity component pointing away from the node.
 3247:    // - If both side velocities point towards the node, This is considered a death trap and the algorithm will stop here.
 3248:    const Vector3 uSide1 = s1->interpolateCenterVelocityVertically(xt);
 3249:    const Vector3 uSide2 = s2->interpolateCenterVelocityVertically(xt);
 3250:    const double u1tan = dot(toVector2(uSide1), s1->t(node));  // s1->t(node) is the unitary tangent vector to the side s1 pointing towards 'node'.
 3251:    const double u2tan = dot(toVector2(uSide2), s2->t(node));  // s2->t(node) is the unitary tangent vector to the side s2 pointing towards 'node'.
 3252: 
 3253:    if (u1tan < 0.0 || u2tan < 0.0) {
 3254:       // The point will slide along the side with the highest velocity component pointing away from the node.
 3255:       if (u1tan < u2tan) {
 3256:          // sliding along s1
 3257:          toVector2(curPoint.u) = u1tan * s1->t(node);
 3258:          curPoint.u.z = uSide1.z;
 3259:          xt = x0 - curPoint.dt*curPoint.u;
 3260:          curPoint.side = s1;
 3261: 
 3262:          // Once xt and curPoint.u are updated to slide along s1, we can call the function to deal with the case where the point is moving along a side.
 3263:          DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3264:       }
 3265:       else {
 3266:          // sliding along s2
 3267:          toVector2(curPoint.u) = u2tan * s2->t(node);
 3268:          curPoint.u.z = uSide2.z;
 3269:          xt = x0 - curPoint.dt*curPoint.u;
 3270:          curPoint.side = s2;
 3271: 
 3272:          // Once xt and curPoint.u are updated to slide along s2, we can call the function to deal with the case where the point is moving along a side.
 3273:          DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3274:       }
 3275: 
 3276: 
 3277:       return;
 3278:    }
 3279:    else
 3280:    {
 3281:       // DEATH TRAP: Both side velocities point towards the node. This is considered a death trap and the algorithm will stop here.
 3282:       assert(false && "DEATH TRAP: Both side velocities point towards the node. IMPLEMENT THIS CASE");
 3283:    }
 3284: 
 3285: 
 3286: 
 3287: }
 3288: 
 3289: 
 3290: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3291: 
 3292: 
 3293: __device__ void Node::updateKb(void) {
 3294: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3295: 
 3296:    if constexpr(ivcor == 1) return;
 3297: 
 3298: 
 3299:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3300: 
 3301:    if constexpr(ivcor == 2) {  // SZ coordinates
 3302:       
 3303:       // Compute bottom level index
 3304:       if (depth <= mesh->h_s) {
 3305:          kb = izlev;   
 3306:          
 3307:       } else {
 3308:          kb = -1;
 3309:          int L = 0;
 3310:          int R = nzlev; 
 3311:          
 3312:          while (L <= R) {
 3313:             int M = (R + L) / 2;
 3314: 
 3315: 
 3316:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3317:             
 3318:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3319:                R = M;
 3320:             } else {
 3321:                L = M;
 3322:             }
 3323: 
 3324:             if (R - L == 1) {
 3325:                kb = L;
 3326:                break;
 3327:             }
 3328:          }
 3329: 
 3330:          // Checks that the binary search was successful
 3331:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3332:        
 3333:       }
 3334:    } 
 3335: }
 3336: 
 3337: 
 3338: __device__ __inline__ void Node::updateZCoordData(void) {
 3339: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3340: 
 3341:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3342:    // if (isDry2()) {
 3343:    //    kb = -1;  // XXXXXXXX KKKKK
 3344:    //    return;
 3345:    // }
 3346: 
 3347: 
 3348:    if constexpr(ivcor == 2) {  // SZ coordinates
 3349:       
 3350:       // Compute bottom level index
 3351:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3352:    } 
 3353:    else if (ivcor == 1) {  // Localized sigma
 3354:       // Do nothing
 3355:    }
 3356: 
 3357: 
 3358: }
 3359: 
 3360: 
 3361: __device__ double Node::compZCoord(int k) const {
 3362:    // Computes the z coordinate at level k.
 3363:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3364:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3365:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3366:    // used 
 3367: 
 3368:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 3369:    
 3370:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3371: 
 3372:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 3373: 
 3374:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 3375: 
 3376:    if constexpr(ivcor == 2) {
 3377: 
 3378:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3379:       const double h_c = mesh->h_c;
 3380:       const double theta_f = mesh->theta_f;
 3381:       const double sinh_theta_f = mesh->sinh_theta_f;
 3382: 
 3383: 
 3384:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3385:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3386:       // once per time step/node.
 3387:       // CHECK: updateZCoordData
 3388: 
 3389:       //  To simplify comparisons, I define index versions of count variables.
 3390:       if      (k == ivrt)     return eta2; 
 3391:       else if (k == izlev)    return -hmod2;
 3392:       else if (k == kb)       return -depth;
 3393:       else if (k < izlev)     return mesh->ztot[k];
 3394:       else if (k > izlev) {
 3395:          const int ksig = k - izlev;
 3396: 
 3397:          if (hmod2 <= h_c) {
 3398:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3399: 
 3400:          } 
 3401:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3402:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3403:             assert(false && "ZCOOR: invalid h_c\n");
 3404:          } 
 3405:          else {
 3406:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3407:                    h_c * mesh->sigma[ksig] + 
 3408:                    (hmod2 - h_c) * mesh->cs[ksig];
 3409:          }
 3410:       } else { 
 3411:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 3412:       }
 3413: 
 3414:    }
 3415:    else if constexpr(ivcor == 1) {
 3416:       if (k == kb) return -depth;
 3417:       else if (k == nvrt-1) return eta2;
 3418:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 3419:    }
 3420:    
 3421:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 3422:    return 0.0;
 3423: }
 3424: 
 3425: 
 3426: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3427:    // Computes the bottom drag Cd based on the selected nchi
 3428: 
 3429:    if constexpr(nchi == 0) {
 3430:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3431:       Cd = drag;  // Read from drag file
 3432: 
 3433:    } else if constexpr(nchi == 1) {
 3434:       // 
 3435: 
 3436:       bool ltmp = false; // for WBL iteration
 3437: 
 3438:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3439:       if (isDry || (rough == 0.0)) {
 3440:          Cd = 0.0;
 3441: 
 3442:       } else { //roughness >0 
 3443:          
 3444:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3445: 
 3446:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3447: 
 3448:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3449: 
 3450:       } // if rough
 3451: 
 3452:    } else if constexpr(nchi == -1) {
 3453:    // Manning 
 3454:  
 3455:       const double htot = max(hmin_man, htot2()); 
 3456:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3457: 
 3458:    } else {
 3459:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3460:       
 3461:    } // if nchi
 3462: 
 3463: }
 3464: 
 3465: 
 3466: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3467:    // Checks if a side in on the boundary
 3468:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3469: 
 3470:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3471:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3472: 
 3473:    // Indices of the nodes that form the side
 3474:    const int n1 = side.n1->idx;
 3475:    const int n2 = side.n2->idx;
 3476:    isLand = false;
 3477:    
 3478: 
 3479:    // Check if the side is on a land boundary
 3480:    for (int i = 0; i < nland; i++) {
 3481:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3482:          // Consecutive nodes in the land boundary segment
 3483:          const int b1 = ilnd[i + j*nland];
 3484:          const int b2 = ilnd[i + (j + 1)*nland];
 3485: 
 3486:          assert(b1 != -1 && b2 != -1);
 3487: 
 3488:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3489:             
 3490:             isLand = true;
 3491:             return i;
 3492:          }
 3493:       }
 3494:    }
 3495: 
 3496:    // Check if the side is on an open boundary
 3497:    for (int i = 0; i < nope; i++) {
 3498:       for (int j = 0; j < nond[i] - 1; j++) {
 3499:          // Consecutive nodes in the open boundary segment
 3500:          const int b1 = iond[i + j*nope];
 3501:          const int b2 = iond[i + (j + 1)*nope];
 3502: 
 3503:          assert(b1 != -1 && b2 != -1);
 3504: 
 3505:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3506:             isLand = false;
 3507:             return i;
 3508:          }
 3509:       }
 3510:    }
 3511: 
 3512:    return -1;
 3513: }
 3514: 
 3515: 
 3516: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3517:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3518:                                     double *wind_rotate_angle, 
 3519:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3520:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3521:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3522:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3523:                                     double *drag, double *roughness, double *rmanning) {
 3524: 
 3525:    NODE(pnode);  
 3526:    const int i = idx_node;
 3527:    Node &node(*pnode);
 3528: 
 3529:    node.idx = i;
 3530: 
 3531:    const int idxNodeStart = nodeNeighNodesStart[i];
 3532:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3533:    node.numNodes = idxNodeEnd - idxNodeStart;
 3534:    node.nodes = nodeNeighNodes + idxNodeStart;
 3535:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3536: 
 3537: 
 3538: 
 3539:    const int idxElemStart = nodeNeighElemsStart[i];
 3540:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3541:    node.numElements = idxElemEnd - idxElemStart;
 3542:    node.elements = nodeNeighElems + idxElemStart;
 3543: 
 3544: 
 3545:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3546:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3547:       const int partNode = localNodePart[idxNodeGlobal]; 
 3548:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3549: 
 3550:       Node *node_ptr = nodes[partNode] + idxNode;
 3551:       
 3552:       nodeNeighNodes[idx] = node_ptr;
 3553:    }
 3554: 
 3555: 
 3556:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3557:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3558:       const int partElem = localElemPart[idxElemGlobal];
 3559:       const int idxElem  = localElemIndices[idxElemGlobal];
 3560: 
 3561:       Element *elem_ptr = elems[partElem] + idxElem;
 3562: 
 3563:       nodeNeighElems[idx] = elem_ptr;
 3564:    }      
 3565: 
 3566:    node.wind_angle = wind_rotate_angle[i];
 3567: 
 3568: 
 3569:    node.p.x   = node_coords[i * 3];
 3570:    node.p.y   = node_coords[i * 3 + 1];
 3571:    node.depth = node_coords[i * 3 + 2];
 3572: 
 3573:    if (use_ll) {
 3574:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3575:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3576:    }
 3577: 
 3578: 
 3579:    node.numSides = 0;
 3580: 
 3581:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3582:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3583:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3584:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3585:    else assert(false && "populateNodes: selected nchi not implemented.");
 3586:    
 3587:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3588:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3589:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3590: 
 3591:    
 3592:    // Links the node to the boundary information
 3593:    if (isbnd[i] >= 0) {
 3594:      
 3595:       // Get the index of the node boundary
 3596:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3597: 
 3598:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3599:       node.nodeBnd->node = &node;
 3600: 
 3601:       node.nodeBnd->sideBnd1 = nullptr;
 3602:       node.nodeBnd->sideBnd2 = nullptr;
 3603: 
 3604:       if (isbnd[i]>=0) {
 3605: 
 3606:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3607:          
 3608:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3609:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3610: 
 3611:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3612:          node.nodeBnd->segment->clen  = nan("1");
 3613:          node.nodeBnd->segment->carea = nan("1");
 3614: 
 3615:       }
 3616:    } else {
 3617: 
 3618:       node.nodeBnd = nullptr; // For internal nodes
 3619: 
 3620:       if (isbnd[i] == landSegment) {
 3621:          node.nodeBnd = &landBoundaryNode;
 3622:          node.nodeBnd->segment = &landBoundarySegment;
 3623:       }
 3624:       
 3625:    }
 3626:    
 3627:    // XXXX GAUSSIAN HILL VELOCITIES
 3628: #ifdef GAUSSIAN_HILL_VELOCITIES
 3629:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3630:       constexpr double rot_per = 3000.0;
 3631:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3632:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3633:    // XXXXX
 3634: #endif
 3635: 
 3636: }
 3637: 
 3638: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3639:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3640:                                     double *wind_rotate_angle,   
 3641:                                     int *isdel, int *isidenode, int *isbnd,
 3642:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3643:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3644:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3645:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3646:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3647:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3648:                                     double *drag, double *roughness) {
 3649: 
 3650: 
 3651:    SIDE(pside);
 3652:    Side &side(*pside);
 3653:    const int i = idx_side;
 3654: 
 3655:    side.idx = i;  
 3656:    
 3657:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3658:    const double fc   = 2.0*omega_e*sin(sfea0);
 3659:    const double beta = 2.0*omega_e*cos(sfea0);
 3660: 
 3661:    // finding the pointer to the nodes that form the side
 3662:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3663:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3664: 
 3665:    const int locidx_n1 = localNodeIndices[idx_n1];
 3666:    const int locidx_n2 = localNodeIndices[idx_n2];
 3667:    const int part_n1 =   localNodePart[idx_n1];
 3668:    const int part_n2 =   localNodePart[idx_n2];
 3669: 
 3670:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3671:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3672: 
 3673:    // Counts the number of sides connected to each node
 3674:    side.n1->numSides++;
 3675:    side.n2->numSides++;
 3676: 
 3677:    // Adds the side to the list of sides connected to each node
 3678:    side.n1->sides[side.n1->numSides - 1] = &side;
 3679:    side.n2->sides[side.n2->numSides - 1] = &side;
 3680: 
 3681: 
 3682:    // Normal, unitary vector to the side
 3683:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3684:    side.n = normalize(side.n);
 3685: 
 3686:    // Side boundary type
 3687:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3688:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3689: 
 3690:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3691:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3692:    {
 3693:       bool isLand = false;
 3694:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3695:       
 3696:       if (isbs > -1) {
 3697:          // assert(isLand || isbs>=0);
 3698:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3699: 
 3700:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3701: 
 3702:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3703:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3704: 
 3705:          assert (isLand == side.sideBnd->segment->isLand);
 3706: 
 3707:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3708:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3709:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3710: 
 3711:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3712:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3713:          
 3714:          side.sideBnd->side = &side;
 3715: 
 3716:       }
 3717:       else {
 3718:          side.sideBnd = nullptr;
 3719:       }
 3720:    }
 3721:    else 
 3722:    {
 3723:       side.sideBnd = nullptr;
 3724:    }
 3725: 
 3726: 
 3727:    // finding the pointer to the elements that share the side
 3728:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3729:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3730: 
 3731:    if (idx_e1 > -1) {
 3732:       const int locidx_e1 = localElemIndices[idx_e1];
 3733:       const int part_e1 =  localElemPart[idx_e1];
 3734:       side.elems[0] = elems[part_e1] + locidx_e1;
 3735: 
 3736:    }
 3737:    else {
 3738:       side.elems[0] = nullptr;
 3739:    }
 3740: 
 3741:    if (idx_e2 > -1) {
 3742:       const int locidx_e2 = localElemIndices[idx_e2];
 3743:       const int part_e2 =  localElemPart[idx_e2];
 3744:       side.elems[1] = elems[part_e2] + locidx_e2;
 3745:    }
 3746:    else {
 3747:       side.elems[1] = nullptr;
 3748:    }
 3749: 
 3750:    // Compute the center of the side
 3751:    side.center = 0.5*(side.n1->p + side.n2->p);
 3752: 
 3753:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3754:    side.shapiro = shapiro0;
 3755: 
 3756: #ifdef GAUSSIAN_HILL_VELOCITIES
 3757: // XXXX
 3758: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3759: constexpr double rot_per=3000.0;
 3760: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3761: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3762: // XXXXX      
 3763: #endif
 3764:    // Compute the z level at the center of the side
 3765:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3766:    
 3767:    // Compute the length of the side
 3768:    const Vector2 vLen = side.n2->p - side.n1->p;
 3769:    side.len = sqrt(dot(vLen, vLen));
 3770: 
 3771: 
 3772:    // Compute the Coriolis coefficient
 3773: 
 3774:    if constexpr(ncor == -1 || ncor == 0) {
 3775:       side.coriolis = coricoef;
 3776:    }
 3777:    else {
 3778:       const double sphi = side.lat();  // Latitude at the center of the side
 3779: 
 3780: // XXXXXX ERROR WHEN use_ll is false??????
 3781:       if constexpr(ics == 1) {
 3782:          // XXXXXXX
 3783:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3784:       }
 3785:       else {
 3786:          side.coriolis = 2.0*omega_e*sin(sphi);
 3787:       }
 3788: 
 3789:    }
 3790: }
 3791: 
 3792: 
 3793: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3794:    double *node_coords, double *node_coords_ll, bool use_ll,
 3795:    double *wind_rotate_angle,   
 3796:    int *isdel, int *isidenode, int *isbnd,
 3797:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3798:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3799:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3800:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3801:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3802:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3803:    double *drag, double *roughness) {
 3804: 
 3805:    ELEM(pelem);
 3806:    Element &elem(*pelem);
 3807:    const int i = idx_elem;
 3808: 
 3809:    elem.idx = i;
 3810: 
 3811:    for (int j = 0; j < i34[i]; j++) {
 3812:       const int idxNode = elnode[i*4 + j];  
 3813:       const int idxSide = elside[i*4 + j];
 3814:       
 3815:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3816:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3817: 
 3818:       // Find the neighboring element  
 3819:       if (elem.sides[j]->elems[0] == &elem) {
 3820:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3821:       }
 3822:       else {
 3823:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3824:       }
 3825:       
 3826:    }
 3827: 
 3828:    elem.i34 = i34[i];
 3829: 
 3830:    // Compute the barycenter of the element and its depth
 3831:    elem.center = {0.0, 0.0};
 3832:    elem.depth = 0.0;
 3833:    for (int j = 0; j < i34[i]; j++) {
 3834: 
 3835:       elem.center += elem.nodes[j]->p/i34[i];
 3836:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3837:    }
 3838: 
 3839: 
 3840:    
 3841:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3842:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3843: 
 3844:    elem.area = elem.computeSignedArea(); 
 3845:    elem.radius = sqrt(elem.area)/pi; 
 3846:    
 3847:    // Determines which way the normal vector to each side is oriented.
 3848:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3849:    for (int j = 0; j < i34[i]; j++)  
 3850:    {
 3851:       elem.ssign[j] = (elem.sides[j]->elems[0] == &elem) ? 1.0 : -1.0;
 3852:        
 3853:    }
 3854: 
 3855:    // Derivatives of shape functions
 3856:    //  For ics=2, this is done inside element/ll frame XXX
 3857:    //  For quads, the derivative is evaluated at centroid
 3858:    for (int j = 0; j < elem.i34; j++) {
 3859:       const double area = elem.area;
 3860:       const int id2 = elem.nxq(1 + j);
 3861:       const int id3 = elem.nxq(2 + j);
 3862:       const int id4 = elem.nxq(3 + j);
 3863:       if (elem.isTri()) {
 3864:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3865:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3866:          // da1/dx = (y1 - y2)/(2*area)
 3867:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3868:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3869:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3870:       }
 3871:       else  { // Quad; evaluate at centroid
 3872:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3873:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3874:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3875:       } // if Tri
 3876: 
 3877:    } // for j   
 3878:    
 3879:    
 3880: 
 3881: }
 3882: 
 3883: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3884:                                             double *emo, double *efa, 
 3885:                                             double *umo, double *ufa, 
 3886:                                             double *vmo, double *vfa) {
 3887: 
 3888: 
 3889:    NODE_BND(nodeBnd);
 3890:    const int idx = idx_node_bnd;    
 3891: 
 3892:    nodeBnd->idx = idx;
 3893: 
 3894:    // Need to find the segment index and the index of the node on the segment
 3895:    int idxNode = -1;
 3896:    int iseg, i;
 3897:    for (iseg = 0; iseg < nope; iseg++) {
 3898:       // for each segment...
 3899:       for (i = 0; i < nond[iseg]; i++) {
 3900:          idxNode = iond[iseg + i*nope];
 3901:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3902:          
 3903:       }
 3904:    }
 3905: 
 3906:    assert(iseg < nope && "iseg is out of bounds");
 3907: 
 3908: found: // Jumped here when the node was found
 3909: 
 3910:    nodeBnd->isEssentialBC = true;
 3911:    nodeBnd->elbc = 0.0;
 3912: 
 3913:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3914: 
 3915:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3916:       nodeBnd->efa[jfr] = efa[idx2];
 3917:       nodeBnd->emo[jfr] = emo[idx2];
 3918:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3919:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3920: 
 3921:    }
 3922:         
 3923: 
 3924: }
 3925: 
 3926: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3927:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3928:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3929:                 int *isdel, int *isidenode, int *isbnd,
 3930:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3931:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3932:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3933:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3934:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3935:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3936:                 double *drag, double *roughness,
 3937:                 double *emo, double *efa, 
 3938:                 double *umo, double *ufa, 
 3939:                 double *vmo, double *vfa) {
 3940: 
 3941:    printf("Populating mesh for partition %d\n", partNum);
 3942: 
 3943:    // XXXXXX THIS function does almost nothing. 
 3944: 
 3945:    nbs = *sharedIdxSideBoundary + 1;
 3946:    nbp = *sharedIdxNodeBoundary + 1;
 3947: 
 3948:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3949: 
 3950: }
 3951: 
 3952: 
 3953: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3954:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3955:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3956: 
 3957: 
 3958:    NODE(node1);
 3959: 
 3960:    node1->clearMatrixRow();
 3961:    node1->qel = 0.0;
 3962: 
 3963:    // THIS IS FOR STRUCTURES XXX
 3964:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3965: 
 3966:    
 3967:    for (int j=0; j<node1->numElements; j++) {
 3968:       // For each element connected to the node...
 3969: 
 3970:       Element *elem = node1->elements[j];
 3971: 
 3972: 
 3973: 
 3974:       // Compute the average gravity
 3975:       const double grav3 = elem->mean(&Node::grav2);
 3976: 
 3977:       // Look at the documentation for the description of the terms in the following integrals
 3978: 
 3979:       // Integral I_1 
 3980:       // \bar{\breve{H}} 
 3981:       const double hhatb = elem->mean(&Side::hhat);        
 3982: 
 3983:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3984: 
 3985:       const int id1 = elem->nodeLocalIdx(node1); 
 3986:       const double area = elem->area;
 3987: 
 3988:       if (elem->isTri()) {
 3989: 
 3990:          // To clarify the notation in this section: 
 3991:          //   i stands for the node under consideration (node1)
 3992:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3993:          const int id2 = elem->nxq(1 + id1);
 3994:          const int id3 = elem->nxq(2 + id1);
 3995:          Node *node2 = elem->nodes[id2];
 3996:          Node *node3 = elem->nodes[id3];
 3997: 
 3998:          const Point2 x1 = node1->p;
 3999:          const Point2 x2 = node2->p;
 4000:          const Point2 x3 = node3->p;
 4001: 
 4002:          // integral of phi_i*phi_j
 4003:          const double ipp_ii = (1.0/6.0 )*area;
 4004:          const double ipp_ij = (1.0/12.0)*area;
 4005:          const double ipp_ik = (1.0/12.0)*area;
 4006: 
 4007:          // integral of [(grad phi_i) * (grad phi_j)]
 4008:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4009:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4010:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4011: 
 4012:          // Computes the different components of integral I_1 of each node with respect to node i.
 4013:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4014:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4015:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4016: 
 4017:          node1->addToSparseMatrix(node1, I1_ii);
 4018:          node1->addToSparseMatrix(node2, I1_ij); 
 4019:          node1->addToSparseMatrix(node3, I1_ik);
 4020: 
 4021:       }
 4022:       else { // Quad
 4023:          // XXX IMPLEMENT THIS
 4024:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4025: 
 4026:          // To clarify the notation in this section: 
 4027:          //   i stands for the node under consideration (node1)
 4028:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4029:          const int id2 = elem->nxq(1 + id1);
 4030:          const int id3 = elem->nxq(2 + id1);
 4031:          const int id4 = elem->nxq(3 + id1);
 4032:          Node *node2 = elem->nodes[id2];
 4033:          Node *node3 = elem->nodes[id3];
 4034:          Node *node4 = elem->nodes[id4];         
 4035: 
 4036:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4037:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 4038:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 4039:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 4040:          const double ipp_il = elem->intPhiPhi(id1, id4);
 4041: 
 4042:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4043:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4044:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4045:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4046:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4047: 
 4048:          // Computes the different components of integral I_1 of each node with respect to node i.
 4049:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4050:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4051:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4052:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4053: 
 4054:          node1->addToSparseMatrix(node1, I1_ii);
 4055:          node1->addToSparseMatrix(node2, I1_ij); 
 4056:          node1->addToSparseMatrix(node3, I1_ik);
 4057:          node1->addToSparseMatrix(node4, I1_il);
 4058:   
 4059:       } 
 4060: 
 4061:  
 4062:       // Integral I_4
 4063:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4064:       // Where
 4065:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4066: 
 4067:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4068:       // of U over the element.
 4069:       Vector2 U = {0.0, 0.0};
 4070:       for (int m=0; m < elem->i34; m++) {      
 4071:          const Side *side = elem->sides[m];
 4072: 
 4073:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 4074:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 4075:       }
 4076:       U = U/elem->i34;
 4077: 
 4078: 
 4079:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4080: 
 4081: 
 4082:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4083:       const double I_4_1 = dot(gradPhi_1, U);
 4084: 
 4085: 
 4086:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4087:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4088: 
 4089:      
 4090:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4091: 
 4092:       // Additional terms 
 4093:       double vnorm = 0.0;
 4094:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4095:          Vector3 ubed = {0.0, 0.0, 0.0};
 4096:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4097: 
 4098:          Vector3 gradP = {0.0, 0.0, 1.0};
 4099:          for (int m=0; m < elem->i34; m++) {
 4100:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4101:            gradP += toVector3(gradP_2D, 0.0);
 4102:          }   
 4103:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4104:       } // imm==2
 4105: 
 4106:       if (elem->isTri()) {
 4107:          for (int l=0; l<3; l++) {
 4108: 
 4109:             Node *node = elem->nodes[l];
 4110: 
 4111:             double fac = (node == node1) ? 2.0 : 1.0;
 4112:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4113:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 4114:            
 4115:          }
 4116: 
 4117: 
 4118:          if (!elem->isDry) {
 4119:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4120: 
 4121:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4122: 
 4123:          }
 4124: 
 4125:       } // isTri
 4126:       else { // isQuad
 4127:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4128:          // for (int l=0; l<4; l++) {
 4129:          //   const Node *node = elem->nodes[l];
 4130: 
 4131:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4132:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4133: 
 4134:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4135:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4136:          // }
 4137: 
 4138:       } // isQuad
 4139: 
 4140: 
 4141:      node1->qel += (dt/elem->i34)*elem->vsource;
 4142:       
 4143: 
 4144:    } // for all elements connected to the node
 4145:    
 4146: 
 4147:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4148:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4149:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4150:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4151:       // If it is an open boundary node...
 4152: 
 4153:       // At least one open bnd side, maybe two
 4154:       for (int l=0; l<2; l++) { 
 4155: 
 4156:          // Gets each of the sides sharing the node. 
 4157:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4158: 
 4159:        
 4160: 
 4161:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4162:          if (sideBnd != nullptr) {
 4163:             // If the side is on a boundary...
 4164: 
 4165:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4166: 
 4167:             // Get the boundary segment
 4168:             const BoundarySegment *sideSegment = sideBnd->segment;
 4169:             const Side *side = sideBnd->side;
 4170: 
 4171:             // Integral I_3
 4172:             if (sideSegment->ifltype != 0) {
 4173:             // Natural or Flather b.c.
 4174: 
 4175:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4176:                // especially for Flather b.c.
 4177:                double ri3 = 0.0;
 4178:                if (!side->isDry) {
 4179:                   // If the side is not dry
 4180:                   
 4181:                   // Computes the side flux of (uth, vth)
 4182:                   double Vn = 0.0;
 4183:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4184:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4185:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4186: 
 4187:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4188:                   }
 4189: 
 4190:                   ri3 = 0.5*side->len*Vn;
 4191:                }
 4192: 
 4193:                if (sideSegment->ifltype == -1) { // Flather 1
 4194: 
 4195:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4196:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4197: 
 4198:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4199:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4200:                   
 4201:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4202:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4203: 
 4204:                } 
 4205:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4206:                   // Reset ri3
 4207:                   ri3 = 0.0;
 4208: 
 4209:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4210: 
 4211:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4212: 
 4213:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4214:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4215: 
 4216:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4217:                   node1->addToSparseMatrix(node1, con0*2.0);
 4218:                   node1->addToSparseMatrix(node2, con0);
 4219: 
 4220:                } // if Flather or Discharge
 4221: 
 4222:                node1->qel -= thetai*dt*ri3;
 4223: 
 4224: 
 4225:             } // I_3
 4226:           
 4227: 
 4228:             // Integral I_5
 4229:             if(!side->isDry) {
 4230: 
 4231:                const double Unbar = dot(side->U, side->n);
 4232:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4233: 
 4234:             } // I_5
 4235: 
 4236:          } // if is boundary side
 4237: 
 4238:       } // for l
 4239: 
 4240:    } // if isbnd
 4241: 
 4242: 
 4243: }
 4244: 
 4245: 
 4246: 
 4247: extern "C" {
 4248:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4249:                                   int* indices, int* indptr) {
 4250: 
 4251:       NODE(node);
 4252:       
 4253:       const int idx = node->idx;
 4254:       
 4255:       // Computes the index in the nzz array      
 4256:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4257: 
 4258: 
 4259:       indptr[idx] = nzzIdx;
 4260:       indices[nzzIdx] = idx;
 4261: 
 4262:       data_d[nzzIdx]    = node->coeffDiag;
 4263: 
 4264:       b_d[idx] = node->qel;
 4265: 
 4266:       for (int k = 0; k < node->numNodes; ++k) {
 4267:          const Node* nb = node->nodes[k];
 4268: 
 4269:          const int j = nb->idx;
 4270: 
 4271:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4272: 
 4273:          indices[nzzIdx + k + 1] = j;
 4274:       }
 4275: 
 4276:  
 4277:    }
 4278: 
 4279: 
 4280: 
 4281:    __global__ void solverCopyResult(double* x) {
 4282:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4283:       NODE(node);
 4284:       const int idx = node->idx;
 4285: 
 4286:       node->mX = x[idx];
 4287:    }
 4288: 
 4289: 
 4290:    __global__ void rollUpElevation(void) {
 4291: 
 4292:       NODE(node);
 4293: 
 4294:       node->eta1 = node->eta2;
 4295: 
 4296:    }
 4297: 
 4298: 
 4299:    __global__ void backtrackAllNodes(void) {
 4300: 
 4301:       // max/min # of sub-divisions
 4302:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4303:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4304: 
 4305: 
 4306:       SIDE(side);
 4307: 
 4308:       const int kb = side->kb;
 4309: 
 4310: 
 4311:       // Initialize btrack velocities to the actual velocities at the side 
 4312:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4313: 
 4314:   
 4315: 
 4316:       if (side->isDry) return;
 4317:       
 4318: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4319: 
 4320:       // Checks that at least one element is not dry
 4321:       const Element *elem1 = side->elems[0];
 4322:       const Element *elem2 = side->elems[1];
 4323: 
 4324: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4325: 
 4326:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4327:       
 4328:       // XXXXXX
 4329:       // !swild_tmp to store global coord. of the starting side
 4330:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4331:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4332:       // !Use sframe2 
 4333:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4334: 
 4335: 
 4336:       for (int k = kb; k < nvrt; k++) {
 4337:       //  Initialize (xt,yt,zt), nnel and vel.
 4338:       //  For ics=2, the coordinates are in local frames
 4339:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4340: 
 4341: 
 4342:          const int iadvf = side->iadv();  // Advection flag   
 4343:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4344: 
 4345:          Point3 xt;
 4346:          if constexpr(ics==1) {
 4347:             xt = side->center3D(k); 
 4348:          }
 4349:          else // lat/lon; in side lat/lon frame
 4350:          {
 4351:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4352:          // XXX IMPLEMENT THIS
 4353:       //          xt=0.d0
 4354:       //          yt=0.d0
 4355:       //          !centroid coord. for nudging
 4356:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4357:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4358:          }  // ics
 4359: 
 4360: 
 4361: 
 4362:          // If on land or open boundary...
 4363:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4364:          
 4365:          const double vmag = length(side->u2[k]);
 4366: 
 4367:          if (vmag <= velmin_btrack) {
 4368:             // No activity 
 4369: 
 4370:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4371: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4372: 
 4373: 
 4374:             
 4375:          } else {  // do btrack
 4376: 
 4377:             // Compute number of sub-divisions based on local gradients of the velocity field
 4378: 
 4379:             // XXX IS THIS NECESSARY?
 4380:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4381:             double suma = 0.0;
 4382:             int icount = 0;
 4383:             for (int l=0; l<2; l++) {
 4384:             // For each element sharing the side...
 4385: 
 4386:                const Element *elem = side->elems[l];
 4387:                  
 4388:                if (elem == nullptr) continue;
 4389: 
 4390:                icount++;
 4391: 
 4392:                // Not strictly along z; in ll frame for ics=2
 4393: 
 4394:                ShapeCoords utmp, vtmp;
 4395:                for (int j = 0; j < elem->i34; j++) {
 4396: 
 4397:                   const Node *node = elem->nodes[j];
 4398: 
 4399:                   if constexpr(ics==1) {
 4400:                      utmp[j] = node->u2[k].x;
 4401:                      vtmp[j] = node->u2[k].y;  
 4402:                   } else {
 4403:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4404:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(j),vtmp0(j))
 4405:                   }
 4406:                } // for j
 4407: 
 4408:                const Vector2 grad_u = elem->grad2(utmp); 
 4409:                const Vector2 grad_v = elem->grad2(vtmp);
 4410: 
 4411:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4412:             } // for ii
 4413: 
 4414:             assert(icount > 0 && "Impossible 77");
 4415: 
 4416:             // '4' is somewhat arbitrary
 4417:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4418: 
 4419:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4420: 
 4421:             Vector3 u_int = {0.0, 0.0, 0.0};
 4422: 
 4423:             
 4424:             side->btu[k] = side->btrack(k, dt, dtbk);
 4425: 
 4426:                
 4427:          } // if vmag (do backtrack)
 4428: 
 4429: 
 4430:       } // for k=kb,nvrt-1
 4431: 
 4432:    }
 4433: 
 4434: } // extern "C"
 4435: 
 4436: template<int nc>
 4437: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4438: 
 4439: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4440: //
 4441: // a,b,c,rhs: input vectors and are not modified by this program.
 4442: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4443: // rhs is the r.h.s.
 4444: // n: actual rank of the system.
 4445: // rows in u() and rhs();
 4446: // u: output with nc columns (transposed to rows)
 4447: // gam: a working array.
 4448: //
 4449: // NOTES:
 4450: // This is a template function that allows for different numbers of columns in the rhs vector.
 4451: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4452: 
 4453:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4454:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4455: 
 4456:    double bet = b[0];
 4457:    if constexpr (nc == 1) {
 4458:       u[0] = rhs[0]/bet;
 4459:    } else {
 4460:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4461:    }
 4462: 
 4463:    for (int j = 1; j < n; j++) {
 4464:       gam[j] = c[j - 1]/bet;
 4465:       bet = b[j] - a[j]*gam[j];
 4466: 
 4467:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4468: 
 4469:       if constexpr (nc == 1) {
 4470:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4471:       } else {
 4472:          for (int l = 0; l < nc; l++) {
 4473:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4474:          }
 4475:       }
 4476:    }
 4477: 
 4478:    // Back-substitution
 4479:    for (int j = n - 2; j >= 0; j--) {
 4480:       if constexpr (nc == 1) {
 4481:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4482:       } else {
 4483:          for (int l = 0; l < nc; l++) {
 4484:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4485:          }
 4486:       }
 4487:    }
 4488: }
 4489: 
 4490: 
 4491: 
 4492: // Helper function that contains the core algorithm
 4493: template<typename XAccessor, typename YAccessor>
 4494: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4495:                                     double  yp_top, double  yp_bot, 
 4496:                                     CubicSpline &spline) {
 4497:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4498:    // 
 4499:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4500:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4501:    //
 4502:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4503:    // 
 4504:    // Inputs: 
 4505:    //            n: dimension for x etc; # of data pts (>=2);
 4506:    //            getX, getY: functions to access x,y coordinates
 4507:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4508:    //     Output: 
 4509:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4510: 
 4511:    const int n = k2 - k1 + 1;
 4512:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4513: 
 4514:    // Allocate memory for the splines
 4515:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4516:    spline.x   = new double[n];
 4517:    spline.y   = new double[n];
 4518:    spline.yp  = new double[n];
 4519:    spline.ypp = new double[n];
 4520: 
 4521:    for (int k=k1; k<=k2; k++) {
 4522:       spline.x[k] = getX(k);
 4523:       spline.y[k] = getY(k);
 4524:    }
 4525: 
 4526:    // This is to simplify expressions later
 4527:    double *x = spline.x;
 4528:    double *y = spline.y;
 4529: 
 4530:    double *a = nullptr;
 4531:    double *b = nullptr;
 4532:    double *c = nullptr;
 4533:    double *gam = nullptr;
 4534:    double *rhs = nullptr;
 4535:    
 4536: 
 4537:       a = new double[n];   // Lower diagonal
 4538:       b = new double[n];   // Diagonal
 4539:       c = new double[n];   // Upper diagonal
 4540:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4541:       rhs = new double[n]; // Right-hand side
 4542: 
 4543:    for (int k=k1; k<=k2; k++) {
 4544:       if (k == k1) {
 4545:          // Bottom level
 4546:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4547:          b[k] = (x[k+1] - x[k])/3.0;
 4548:          c[k] = b[k]/2.0;
 4549:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4550:       } else if (k == n - 1) {
 4551:          // Top level (surface)
 4552:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4553:          b[k] = (x[k] - x[k-1])/3.0;
 4554:          a[k] = b[k]/2.0;
 4555:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4556:       } else {
 4557:          // Intermediate levels
 4558:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4559:          b[k] = (x[k+1] - x[k-1])/3.0;
 4560:          a[k] = (x[k  ] - x[k-1])/6.0;
 4561:          c[k] = (x[k+1] - x[k  ])/6.0;
 4562:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4563:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4564:       }
 4565:    }
 4566: 
 4567:    // Solve the tridiagonal system
 4568:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4569:    
 4570:    spline.yp[k1] = yp_bot;
 4571:    spline.yp[k2] = yp_top;
 4572: 
 4573:    // Compute rest of 1st derivatives using the splines
 4574:    for (int k=k1+1; k<k2; k++) {
 4575:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4576:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4577:    }
 4578:    
 4579:    delete[] a;
 4580:    delete[] b;
 4581:    delete[] c;
 4582:    delete[] gam;
 4583:    delete[] rhs;
 4584: 
 4585: }
 4586: 
 4587: // Array version
 4588: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4589:                                 double y_top, double y_bot, 
 4590:                                 CubicSpline &spline) {
 4591:    auto getX = [x] (int k) { return x[k]; };
 4592:    auto getY = [y] (int k) { return y[k]; };
 4593:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4594: }
 4595: 
 4596: // Lambda version - allows custom access patterns
 4597: template<typename XFunc, typename YFunc>
 4598: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4599:                                 double y_top, double y_bot,
 4600:                                 CubicSpline &spline) {
 4601:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4602: }
 4603: 
 4604: 
 4605: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4606: {
 4607:    assert("Not implemented");
 4608: 
 4609:    return 0.0;
 4610: }
