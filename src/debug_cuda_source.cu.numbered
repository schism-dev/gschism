 2838: 
 2839: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2840:    // Returns the value of the normal component of the velocity at the side center
 2841:    const double w1 = getBoundaryArrayValueWeight();
 2842:    const double w2 = 1.0 - w1;
 2843:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2844:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2845: 
 2846:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2847: }
