 8610: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8611:    // Get the value of a variable from an side
 8612:    // varName is the name of the variable to get
 8613:    // var is the array to store the value
 8614:    // k is the vertical level index of the variable to get
 8615:    SIDE_BND(sideBnd);   
 8616: 
 8617:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8618:    if (sideBnd->segment->isLand) idx = -7;
 8619: 
 8620:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8621:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8622: 
 8623: }
