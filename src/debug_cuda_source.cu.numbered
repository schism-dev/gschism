 1379: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1380:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1381: }
 1382: 
 1383: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1384:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1385: }   
 1386: 
 1387: __device__ __inline__ double min3(double a, double b, double c) {
 1388:    return min(a, min(b, c));
 1389: }
 1390: 
 1391: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1392:    return min(a, min(b, min(c, d)));
 1393: }
 1394: 
