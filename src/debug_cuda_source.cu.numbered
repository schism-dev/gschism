 1826: // Convenience macros for accessing the objects in kernels.
 1827: 
 1828: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1829:                    Side *side = &(mesh->localSideData[idx_side]); \
 1830:                    if (idx_side >= mesh->ns) return;
 1831: 
 1832: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1833:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1834:                    if (idx_elem >= mesh->ne) return;
 1835: 
 1836: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1837:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1838:                    if (idx_node >= mesh->np) return;
 1839: 
 1840: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1841:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1842:                               const bool valid = (idx_node < mesh->np);                   
 1843: 
 1844: 
 1845: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1846:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1847:                            if (idx_node_bnd >= mesh->nbp) return;
 1848: 
 1849: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1850:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1851:                            if (idx_side_bnd >= mesh->nbs) return;                           
