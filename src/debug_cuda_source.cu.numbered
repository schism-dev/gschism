 7897: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7898:    Element *elems = mesh->localElemData;
 7899: 
 7900:    *addr = elems;
 7901:    *sizeElement = sizeof(Element);
 7902:    switch (varCode) {
 7903:       case (int)VarCode::z:
 7904:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7905:          *sizeType = sizeof(double);
 7906:          break;
 7907:       case (int)VarCode::x:
 7908:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7909:          *sizeType = sizeof(Vector2);
 7910:          break;
 7911:       case (int)VarCode::area:
 7912:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7913:          *sizeType = sizeof(double);
 7914:          break;
 7915:       case (int)VarCode::depth:
 7916:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7917:          *sizeType = sizeof(double);
 7918:          break;
 7919:       case (int)VarCode::radius:
 7920:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7921:          *sizeType = sizeof(double);
 7922:          break;
 7923:       case (int)VarCode::ghat:
 7924:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7925:          *sizeType = sizeof(Vector2);
 7926:          break;
 7927:       case (int)VarCode::kb:
 7928:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7929:          *sizeType = sizeof(int);
 7930:          break;
 7931:       case (int)VarCode::isdry:
 7932:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7933:          *sizeType = sizeof(int);
 7934:          break;            
 7935:       case (int)VarCode::w:
 7936:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7937:          *sizeType = sizeof(double);
 7938:          break;
 7939:       case (int)VarCode::FaceIndices:
 7940:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7941:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7942:          *sizeType = sizeof(Node);
 7943:          break;
 7944:       default:
 7945:          *offset = -1;
 7946:    }
 7947: }
