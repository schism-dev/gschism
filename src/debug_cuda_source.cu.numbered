  333: struct Tracers {
  334:     double tracer[N_TRACERS];
  335: };
  336: 
  337: 
  338: 
  339: struct Frame {
  340:    double _t[9]; // t stands for tensor.
  341: 
  342:    // Access the tensor in Fortran order
  343:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  344: 
  345:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  346: 
  347:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  348: 
  349:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  350:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  351:       sincos(ar2, &sin_ar2, &cos_ar2);
  352: 
  353:       t(0,0) = -sin_ar1;
  354:       t(1,0) =  cos_ar1;
  355:       t(2,0) =  0.0;
  356:       t(0,1) = -cos_ar1*sin_ar2;
  357:       t(1,1) = -sin_ar1*sin_ar2;
  358: 
  359:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  360: 
  361:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  362:       assert (ar4!=0.0 && "GRID: ar4=0");
  363: 
  364:       const double ar4_inv = 1.0/ar4;
  365:       t(0,1) = t(0,1)*ar4_inv;
  366:       t(1,1) = t(1,1)*ar4_inv;
  367:       t(2,1) = t(2,1)*ar4_inv;
  368: 
  369:       // The third vector is the cross product of the first two
  370:       crossProduct(t(0,0), t(1,0), t(2,0), 
  371:                    t(0,1), t(1,1), t(2,1), 
  372:                    t(0,2), t(1,2), t(2,2));
  373:    }
  374: 
  375: 
  376:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  377:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  378:    // Inputs:
  379:    //        vec0: vel. in this frame;
  380:    //        frameout: Output frame;
  381:    // Output: 
  382:    //        vec1: vel. in new frame  
  383: 
  384:       auto const fo = frameout;
  385:       Vector2 vec1;
  386: 
  387:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  388:       // of t and fo.t are the same.
  389:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  390:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  391: 
  392:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  393:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  394: 
  395:       return vec1;
  396:    }
  397: 
  398:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  399:       // Transform a vector from global to local frame
  400:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  401:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  402:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  403:    }
  404: 
  405:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  406:       // Transform a vector from local to global frame
  407:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  408:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  409:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  410:    }   
  411: 
  412:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  413:    // Tranforms a point from global to local frame     
  414:       G2L(pi - origin0, po);
  415:    }
  416: 
  417:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  418:    // Transforms a point from local to global frame      
  419:       L2G(pi, po);
  420:       po = po + origin0;
  421:    }
  422: 
  423: };
