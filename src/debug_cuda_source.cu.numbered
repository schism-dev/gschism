 4894: 
 4895: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4896:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4897:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4898:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4899: }
 4900: 
 4901: 
 4902: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4903:    // Brunt-Väisälä frequency at level k.
 4904:    if (k <= node->kb || k >= ivrt) return 0.0;
 4905:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4906: }
 4907: 
 4908: 
 4909: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4910: 
 4911:    
 4912:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4913:    // k is the layer bottom index.
 4914: 
 4915: 
 4916: 
 4917:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4918: 
 4919:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4920:       const double eta2 = node->eta2;
 4921:       const double depth = node->depth;
 4922: 
 4923:       // Distances from the layer midpoint to the surface and bottom
 4924:       const double dist_s = eta2 - z_c;
 4925:       const double dist_b = z_c + depth;
 4926: 
 4927:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4928: 
 4929:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4930: 
 4931: 
 4932:    } else {
 4933:       return 1.0; // Other GLS submodels
 4934: 
 4935:    }
 4936: }
 4937: 
 4938: 
 4939: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4940:    // Minimum mixing length for levels below the surface.
 4941:    // Independent of psimin(); do not invert one to get the other.
 4942:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4943: }
 4944: 
 4945: 
 4946: __device__ void Turbulence<TurbulenceModel::GLS>::init(Node *node) {
 4947:    // Whole column, including levels below kb. Matches the Fortran cold start.
 4948:    for (int k = 0; k < nvrt; k++) {
 4949:       tke[k]    = tkemin();
 4950:       mxl[k]    = mxlmin(node->depth);
 4951:       nu_tke[k] = diffmin;
 4952:       nu_phi[k] = diffmin;
 4953: 
 4954:       node->dfv[k] = 0.0;
 4955:       node->dfh[k] = 0.0;
 4956:    }
 4957: }
 4958: 
 4959: 
 4960: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4961: 
 4962:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4963: 
 4964:    if constexpr(iveg == 1) {
 4965:       
 4966:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4967:       const double zTopCanopy = node->zTopCanopy();
 4968: 
 4969:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4970: 
 4971:          const double ztop = node->z[k];   // Top of the current layer.
 4972: 
 4973:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4974:          // Where 1 means that the current level is fully within the vegetation layer.
 4975:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4976: 
 4977:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4978:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4979: 
 4980:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4981:          // and at the bottom of the layer.
 4982:          const double vmag_top = length(ub2_top);
 4983:          const double vmag_bot = length(node->u2[k-1]);
 4984: 
 4985:          // Volume-averaged velocity cubed.
 4986:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4987: 
 4988:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4989:          // and at the bottom of the layer.
 4990:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4991:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4992: 
 4993:          // Volume-averaged vegetation alpha cubed.
 4994:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4995: 
 4996:          return veg_alpha3D*vmag3;
 4997:       } 
 4998:       else {
 4999:          // The current level is not within the vegetation layer, so the production is 0.
 5000:          return 0.0;
 5001:       }
 5002:    } else {
 5003: 
 5004:       // If no vegetation, the production is 0.
 5005:       return 0.0;
 5006:    }
 5007: 
 5008: }
 5009: 
 5010: 
 5011: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 5012:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 5013:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 5014: 
 5015:    const int kb = node->kb;
 5016: 
 5017:    for (int k = kb; k < nvrt; k++) {
 5018:       const double tke = this->tke[k];
 5019:       const double mxl = this->mxl[k];
 5020:       const double u = sqrt(tke);  // Characteristic velocity
 5021:       const double lu = mxl*u;     // Characteristic diffusivity 
 5022: 
 5023:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 5024:       double drho_dz = 0.0;
 5025:       if (k > kb && k < ivrt) {
 5026:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 5027:       }
 5028: 
 5029:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 5030: 
 5031:       // Tsinghua group       
 5032:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 5033: 
 5034:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 5035:       if constexpr (stabilityModel == Galperin) {
 5036:          sh = 0.49393/(1.0-34.676*Gh);
 5037:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 5038:          cmiu  = sqrt(2.0)*sm;
 5039:          cmiup = sqrt(2.0)*sh;
 5040:          cmiu1 = sqrt(2.0)*0.2;
 5041:          cmiu2 = sqrt(2.0)*0.2;
 5042: 
 5043:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 5044:          // Warner's paper has problem
 5045:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 5046:          const double Ghp = Gh;  /// XXXXX needed?
 5047:          sh = 0.4939/(1.0 - 30.19*Ghp);
 5048:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 5049:          cmiu  = sqrt(2.0)*sm;
 5050:          cmiup = sqrt(2.0)*sh;
 5051:          cmiu1 = cmiu/schk();
 5052:          cmiu2 = cmiu/schpsi();
 5053: 
 5054:       } else {
 5055:          assert(false && "Unknown ASM");
 5056: 
 5057:       }
 5058: 
 5059:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 5060:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 5061:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 5062:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 5063:    }
 5064: }
 5065: 
 5066: 
 5067: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 5068: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 5069: 
 5070:    const double z = node->z[k];
 5071:    const double eta2 = node->eta2;
 5072:    const double depth = node->depth;
 5073: 
 5074:    // Distances to the surface and bottom
 5075:    const double dist_s = eta2 - z;
 5076:    const double dist_b = z + depth;
 5077: 
 5078:    // Distance to the closest "wall" (either surface or bottom).  
 5079:    // In the top layer, it is the size of the layer.
 5080:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 5081:    assert(min_dist > 0.0 && "Invalid minimum distance");
 5082: 
 5083:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 5084:    return kappa*min_dist;
 5085: }
 5086: 
 5087: 
 5088: 
 5089: template<TurbulenceModel turbulenceModel>
 5090: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 5091: 
 5092: 
 5093: template<>
 5094: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 5095:    // Constant turbulence model
 5096:    // Does nothing since dfv and dfh are already set  in the initialization.
 5097: }
 5098: 
 5099: template<>
 5100: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 5101:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 5102: 
 5103:    // Solves the following PDEs:
 5104:    //
 5105:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 5106:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 5107:    //
 5108:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 5109:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 5110:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 5111:    //
 5112:    // The equations are solved using a linear *vertical* FEM formulation.
 5113:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 5114:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 5115:    
 5116:    
 5117:    // Get the turbulence model
 5118:    // reinterpret_cast is used to avoid stupid compiler errors.
 5119:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 5120:      
 5121:    const int kb = node->kb;
 5122:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 5123: 
 5124:    double alow_tke[nvrt], alow_phi[nvrt];
 5125:    double bdia_tke[nvrt], bdia_phi[nvrt];
 5126:    double cupp_tke[nvrt], cupp_phi[nvrt];
 5127:    double rhs_tke [nvrt], rhs_phi [nvrt];
 5128:    
 5129:    // Initialize the tridiagonal system
 5130:    for (int kin = 0; kin < nqrows; kin++) {
 5131:       alow_tke[kin]=0.0;
 5132:       bdia_tke[kin]=0.0;
 5133:       cupp_tke[kin]=0.0;
 5134:       rhs_tke [kin]=0.0; 
 5135:       alow_phi[kin]=0.0;
 5136:       bdia_phi[kin]=0.0;
 5137:       cupp_phi[kin]=0.0;
 5138:       rhs_phi [kin]=0.0; 
 5139:    }
 5140: 
 5141: 
 5142: 
 5143:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 5144:    if (node->isDry || node->is2D()) {
 5145: 
 5146:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 5147:       const double diffmin = turb.diffmin;
 5148: 
 5149:       for (int k = 0; k < nvrt; k++) {
 5150:          turb.tke[k]    = turb.tkemin();
 5151:          turb.mxl[k]    = turb.mxlmin(node->depth);
 5152:          node->dfv[k]   = diffmin;
 5153:          node->dfh[k]   = diffmin;
 5154:          turb.nu_tke[k] = diffmin;
 5155:          turb.nu_phi[k] = diffmin;
 5156:       }
 5157: 
 5158:       return;
 5159:    }
 5160: 
 5161:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 5162:    
 5163:    // After here we know that the node is wet and has at least 2 layers.
 5164: 
 5165:    double solution[nvrt], gam[nvrt];
 5166:    
 5167:    const double eta2       = node->eta2;
 5168:    const double depth      = node->depth;
 5169:    const double Cd         = node->Cd; // Drag coefficient
 5170: 
 5171:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 5172:    
 5173:    const double sqU2 = norm2(node->u2[kb + 1]);
 5174:    const double modTau = length(node->tau);
 5175: 
 5176:  
 5177: 
 5178:    const double cpsi1 = turb.cpsi1();
 5179:    const double cpsi2 = turb.cpsi2();
 5180:    // cpsi3 is computed later because it depends on k
 5181: 
 5182: 
 5183:    // Assemble the tridiagonal system
 5184:    // -------------------------------
 5185: 
 5186:    // Loop over each vertical layer (interval between two vertical levels)
 5187:    // Each interval is an element of the vertical FEM formulation.
 5188:    // Two shape functions are defined over each interval. In this function we well call them
 5189:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5190:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5191:    //
 5192:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5193:    // Both systems of equations are assembled in the same loop.
 5194:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5195: 
 5196:       // Indices for the *rows* of the tridiagonal system.
 5197:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5198:       const int k2 = k - kb;     // One at k = kb + 1
 5199: 
 5200:       // Get the properties of the current interval.
 5201:       const double z  = node->z[k]; // bottom level of the interval
 5202:       const double dz = node->Dz(k + 1);
 5203:       
 5204:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5205: 
 5206:       // Turbulence production/dissipation terms (at the center of the interval).
 5207:       
 5208:       const double M2 = norm2(du_dz_c);              // Shear production term
 5209: 
 5210:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5211: 
 5212:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5213: 
 5214:       const double cpsi3 = turb.cpsi3(N2); 
 5215: 
 5216: 
 5217:       // Turbulence quantities at half levels (cell [c]enter)
 5218:       const double tke_1     = turb.tke[k];
 5219:       const double tke_2     = turb.tke[k+1];
 5220:       const double mxl_1     = turb.mxl[k];
 5221:       const double mxl_2     = turb.mxl[k+1];
 5222:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5223:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5224:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5225:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5226:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5227:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5228:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5229: 
 5230:       // Integral of the shape function products:
 5231:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5232:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5233:       const double p1p1 = dz/3.0;
 5234:       const double p1p2 = dz/6.0;
 5235:       const double d1d1 =  1.0/dz;
 5236:       const double d1d2 = -1.0/dz;
 5237: 
 5238:       // Production/dissipation related terms
 5239:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5240:       const double buoy = dfh_c*N2;
 5241:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5242: 
 5243: 
 5244: 
 5245:       // Equation for tke
 5246:       // ---------------
 5247: 
 5248:       // First row (of the two rows that the interval contributes to)
 5249:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5250:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5251:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5252: 
 5253: 
 5254:       if(prod + buoy >= 0.0) { // Net production
 5255:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5256:       } else { // Net dissipation
 5257:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5258:          bdia_tke[k1] -= 2.0*tmp;
 5259:          cupp_tke[k1] -= tmp;
 5260:       }      
 5261:       
 5262:       bdia_tke[k1] += 2.0*dt*diss;
 5263:       cupp_tke[k1] += dt*diss;
 5264:       
 5265:   
 5266:       // Second row (of the two rows that the interval contributes to)
 5267:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5268:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5269:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5270: 
 5271:       if (prod + buoy >= 0.0) { // Net production
 5272:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5273:       } else { // Net dissipation
 5274:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5275:          bdia_tke[k2] -= 2.0*tmp;
 5276:          alow_tke[k2] -= tmp;
 5277:       }
 5278:       
 5279:       bdia_tke[k2] += 2.0*dt*diss;
 5280:       alow_tke[k2] += dt*diss;
 5281: 
 5282: 
 5283:       // Equation for xl
 5284:       // ---------------
 5285: 
 5286:       const double rpub = turb.rpub();
 5287:       const double rmub = turb.rmub();
 5288:       const double rnub = turb.rnub();
 5289:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5290:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5291:       const double psi_c = 0.5*(psi_1 + psi_2);
 5292: 
 5293:       // Production/dissipation related terms
 5294:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5295:       const double buoy_phi = cpsi3*dfh_c*N2;
 5296:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5297: 
 5298:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5299:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5300:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5301: 
 5302:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5303:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5304:       } else { // Net dissipation
 5305:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5306:          bdia_phi[k1] -= 2.0*tmp;
 5307:          cupp_phi[k1] -= tmp;
 5308:       }
 5309: 
 5310:       // Production/dissipation terms
 5311:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5312:       cupp_phi[k1] += dt*diss_phi;
 5313:  
 5314: 
 5315:       // row k2 (upper)
 5316:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5317:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5318:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5319: 
 5320:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5321:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5322:       } else { // Net dissipation
 5323:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5324:          bdia_phi[k2] -= 2.0*tmp;
 5325:          alow_phi[k2] -= tmp;
 5326:       }
 5327: 
 5328:       // Production/dissipation terms
 5329:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5330:       alow_phi[k2] += dt*diss_phi;
 5331: 
 5332:    }
 5333: 
 5334:    // BC
 5335:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5336:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5337: 
 5338: 
 5339:    // Solves for tke.
 5340:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5341: 
 5342: 
 5343:    // B.C. (computed using values from previous time except wind)
 5344:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5345:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5346: 
 5347: 
 5348:    // Update TKE.
 5349:    turb.tke[kb]     = tkebot;
 5350:    turb.tke[kb + 1] = tkebot;
 5351:    turb.tke[ivrt]   = tkesrf;
 5352:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5353:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5354: // printf("tke[%d]: %f, solution[%d]: %f\n", k, turb.tke[k], kin, solution[kin]);   
 5355:    }
 5356: 
 5357: 
 5358: 
 5359:  
 5360:    // Solves for phi.
 5361:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5362: 
 5363: 
 5364:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5365:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5366:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5367: 
 5368:    turb.mxl[kb+1] = mxlbot;
 5369:    turb.mxl[ivrt] = mxlsrf;
 5370:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5371:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5372: 
 5373:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5374: 
 5375:       // Galperin's clipping
 5376:       if (N2 < 0.0) {
 5377:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5378:          turb.mxl[k] = min(turb.mxl[k], upper);
 5379:       }   
 5380: 
 5381: 
 5382: 
 5383:       // Max. mixing length based on dissipation; mxlmin prevails
 5384:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5385: 
 5386:       // Combined max. mixing length including geometric limit
 5387:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5388: 
 5389:       // Clamp the mixing length between the minimum and maximum values
 5390:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5391: 
 5392:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5393: 
 5394: 
 5395:    } // for k
 5396: 
 5397: 
 5398:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5399:    turb.tke[kb] = turb.tke[kb + 1];
 5400:    turb.mxl[kb] = turb.mxl[kb + 1];
 5401: 
 5402: 
 5403:    // Compute vertical diffusivities at new time
 5404:    turb.computeDiffusivities(node);
 5405: 
 5406:    // make all the variables uniform below the bottom level kb
 5407:    for (int k = 0; k < kb; k++) {
 5408:       node->dfv[k] = node->dfv[kb];
 5409:       node->dfh[k] = node->dfh[kb];
 5410:       turb.tke[k] = turb.tke[kb];
 5411:       turb.mxl[k] = turb.mxl[kb];
 5412:       turb.nu_tke[k] = turb.nu_tke[kb];
 5413:       turb.nu_phi[k] = turb.nu_phi[kb];
 5414:    }
 5415: 
 5416:       
 5417: 
 5418: }
 5419: 
 5420: 
 5421: 
 5422: 
 5423: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5424:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5425:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5426: 
 5427: 
 5428:    NODE(node1);
 5429: 
 5430:    node1->clearMatrixRow();
 5431:    node1->qel = 0.0;
 5432: 
 5433:    // THIS IS FOR STRUCTURES XXX
 5434:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5435: 
 5436:    
 5437:    for (int j=0; j<node1->numElements; j++) {
 5438:       // For each element connected to the node...
 5439: 
 5440:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5441: 
 5442:       Element *elem = node1->elements[j];
 5443: 
 5444:       // Compute the average gravity
 5445:       const double grav3 = elem->mean(&Node::grav2);
 5446: 
 5447:       // Look at the documentation for the description of the terms in the following integrals
 5448: 
 5449:       // Integral I_1 
 5450:       // \bar{\breve{H}} 
 5451:       const double hhatb = elem->mean(&Side::hhat);        
 5452: 
 5453:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5454: 
 5455:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5456:       const double area = elem->area;
 5457: 
 5458:       // Integral I_4
 5459:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5460:       // Where
 5461:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5462: 
 5463:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5464:       // of U over the element.
 5465:       const Vector2 U = elem->mean(&Side::U);
 5466: 
 5467:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5468: 
 5469:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5470:       const double I_4_1 = dot(gradPhi_1, U);
 5471: 
 5472: 
 5473:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5474:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5475: 
 5476:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5477: 
 5478: 
 5479:       // Normal component of the bed velocity
 5480:       double ubedNormalComp = 0.0;
 5481:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5482:          Vector3 ubed = {0.0, 0.0, 0.0};
 5483:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5484:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5485: 
 5486:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5487:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5488:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5489: 
 5490:          // Computes the normal component of the bed velocity
 5491:          ubedNormalComp = dot(ubed, N);
 5492:       } // imm==2
 5493: 
 5494:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5495: 
 5496:       if (elem->isTri()) {
 5497: 
 5498:          // To clarify the notation in this section: 
 5499:          //   In formulas, we use the following notation:
 5500:          //       i stands for the node under consideration (node1)
 5501:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5502:          //   However, in the code, we use the following notation:
 5503:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5504:          const int id2 = elem->nxq(1 + id1);
 5505:          const int id3 = elem->nxq(2 + id1);
 5506:          Node *node2 = elem->nodes[id2];
 5507:          Node *node3 = elem->nodes[id3];
 5508: 
 5509:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5510: 
 5511:          // integral of phi_i*phi_j
 5512:          const double ipp_ii = (1.0/6.0 )*area;
 5513:          const double ipp_ij = (1.0/12.0)*area;
 5514:          const double ipp_ik = (1.0/12.0)*area;
 5515: 
 5516:          // integral of [(grad phi_i) * (grad phi_j)]
 5517:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5518:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5519:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5520: 
 5521:          // Computes the different components of integral I_1 of each node with respect to node i.
 5522:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5523:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5524:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5525: 
 5526:          node1->addToSparseMatrix(node1, I1_ii);
 5527:          node1->addToSparseMatrix(node2, I1_ij); 
 5528:          node1->addToSparseMatrix(node3, I1_ik);
 5529: 
 5530:          #pragma unroll
 5531:          for (int l=0; l<3; l++) {
 5532: 
 5533:             Node *node = elem->nodes[l];
 5534: 
 5535:             // Additional variation in eta due to bed deformation or vertical velocity
 5536:             double extraEta = 0.0;
 5537:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5538:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5539: 
 5540: 
 5541:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5542:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5543: 
 5544:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5545: 
 5546:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5547:            
 5548:          }
 5549: 
 5550: 
 5551:       }
 5552:       else { // Quad
 5553:          // To clarify the notation in this section: 
 5554:          //   In formulas, we use the following notation:
 5555:          //       i stands for the node under consideration (node1)
 5556:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5557:          //   However, in the code, we use the following notation:
 5558:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5559:          const int id2 = elem->nxq(1 + id1);
 5560:          const int id3 = elem->nxq(2 + id1);
 5561:          const int id4 = elem->nxq(3 + id1);
 5562:          Node *node2 = elem->nodes[id2];
 5563:          Node *node3 = elem->nodes[id3];
 5564:          Node *node4 = elem->nodes[id4];   
 5565:          
 5566:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5567: 
 5568:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5569:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5570:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5571:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5572:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5573: 
 5574:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5575:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5576:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5577:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5578:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5579: 
 5580: 
 5581:          // Computes the different components of integral I_1 of each node with respect to node i.
 5582:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5583:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5584:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5585:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5586: 
 5587:          node1->addToSparseMatrix(node1, I1_ii);
 5588:          node1->addToSparseMatrix(node2, I1_ij); 
 5589:          node1->addToSparseMatrix(node3, I1_ik);
 5590:          node1->addToSparseMatrix(node4, I1_il);
 5591:   
 5592:          #pragma unroll
 5593:          for (int l=0; l<4; l++) {
 5594: 
 5595:             const Node *node = elem->nodes[l];
 5596: 
 5597:             // Additional variation in eta due to bed deformation or vertical velocity
 5598:             double extraEta = 0.0;
 5599:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5600:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5601: 
 5602:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5603:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5604:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5605: 
 5606:          }         
 5607:       } 
 5608: 
 5609: 
 5610:      node1->qel += (dt/elem->i34)*elem->vsource;
 5611:       
 5612: 
 5613:    } // for all elements connected to the node
 5614:    
 5615: 
 5616:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5617:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5618:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5619:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5620:    // If it is an open boundary node...
 5621: 
 5622:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5623: 
 5624:       // At least one open bnd side, maybe two
 5625:       for (int l=0; l<2; l++) { 
 5626: 
 5627:          // Gets each of the sides sharing the node. 
 5628:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5629: 
 5630:     
 5631: 
 5632:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5633:          if (sideBnd != nullptr) {
 5634:             // If the side is on a boundary...
 5635: 
 5636:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5637: 
 5638:             // Get the boundary segment
 5639:             const BoundarySegment *sideSegment = sideBnd->segment;
 5640:             const Side *side = sideBnd->side;
 5641: 
 5642:             // Integral I_3
 5643:             if (sideSegment->ifltype != 0) {
 5644:             // Natural or Flather b.c.
 5645: 
 5646:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5647:                // especially for Flather b.c.
 5648:                double ri3 = 0.0;
 5649:                if (!side->isDry) {
 5650:                   // If the side is not dry
 5651:                   
 5652:                   // Computes the side flux of (uth, vth)
 5653:                   double Vn = 0.0;
 5654:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5655:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5656:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5657: 
 5658:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5659:                   }
 5660: 
 5661:                   ri3 = 0.5*side->len*Vn;
 5662:                }
 5663: 
 5664:                if (sideSegment->ifltype == -1) { // Flather 1
 5665: 
 5666:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5667:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5668: 
 5669:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5670:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5671:                   
 5672:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5673:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5674: 
 5675:                } 
 5676:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5677:                   // Reset ri3
 5678:                   ri3 = 0.0;
 5679: 
 5680:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5681:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5682: 
 5683:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5684: 
 5685:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5686:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5687: 
 5688:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5689:                   node1->addToSparseMatrix(node1, con0*2.0);
 5690:                   node1->addToSparseMatrix(node2, con0);
 5691: 
 5692:                } // if Flather or Discharge
 5693: 
 5694:                node1->qel -= thetai*dt*ri3;  
 5695: 
 5696: 
 5697:             } // I_3
 5698:           
 5699: 
 5700:             // Integral I_5
 5701:             if(!side->isDry) {
 5702: 
 5703:                const double Unbar = dot(side->U, side->n);
 5704:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5705: 
 5706:             } // I_5
 5707: 
 5708:          } // if is boundary side
 5709: 
 5710:       } // for l
 5711: 
 5712:    } // if isbnd
 5713: 
 5714: 
 5715: }
 5716: 
 5717: 
 5718: 
 5719: extern "C" {
 5720: 
 5721:    __global__ void gatherBFromMesh(double* b) {
 5722:       // b[local] <- qel  (local = idx_node on this device)
 5723:       NODE(node);
 5724:       b[idx_node] = node->qel;
 5725:    }
