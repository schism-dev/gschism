 4235: extern "C" {
 4236: 
 4237:    __global__ void scaleGravity(double loadtide_coef) {
 4238: 
 4239: 
 4240:       NODE(node);
 4241: 
 4242:       // SAL option: scale gravity
 4243:       if constexpr(iloadtide==2) {  // simple const
 4244:          node->grav2 = grav*(1.0 - loadtide_coef);
 4245: 
 4246:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4247:         
 4248:           const double depth = max(node->depth, 0.0);
 4249:           const double tmp1 = sqrt(depth);
 4250:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4251:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4252:                              2.6969e-13*depth*depth*depth*tmp1;
 4253:           
 4254:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4255:           
 4256: 
 4257: 
 4258:           node->grav2 = grav*(1.0 - beta_bar);
 4259: 
 4260:       } else {  // iloadtide=0,1
 4261:         node->grav2=grav;
 4262: 
 4263:       }
 4264: 
 4265:    }
 4266: 
 4267: 
 4268:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4269: 
 4270:       NODE_BND(nodeBnd);
 4271: 
 4272:       Node *node = nodeBnd->node;
 4273: 
 4274:       node->ETP = 0.0;
 4275: 
 4276:       for (int j=0; j<ntip; j++) {
 4277: 
 4278:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4279:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4280:    
 4281:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4282: 
 4283:          if constexpr(iloadtide==1) { // loading tide
 4284:             assert(false && "Loading tide not implemented");
 4285:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4286:          }
 4287:          
 4288:       }
 4289:       
 4290:    }
