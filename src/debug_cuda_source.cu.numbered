 1950: // Convenience macros for accessing the objects in kernels.
 1951: 
 1952: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1953:                    Side *side = &(mesh->localSideData[idx_side]); \
 1954:                    if (idx_side >= mesh->ns) return;
 1955: 
 1956: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1957:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1958:                    if (idx_elem >= mesh->ne) return;
 1959: 
 1960: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1961:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1962:                    if (idx_node >= mesh->np) return;
 1963: 
 1964: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1965:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1966:                               const bool valid = (idx_node < mesh->np);                   
 1967: 
 1968: 
 1969: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1970:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1971:                            if (idx_node_bnd >= mesh->nbp) return;
 1972: 
 1973: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1974:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1975:                            if (idx_side_bnd >= mesh->nbs) return;  
