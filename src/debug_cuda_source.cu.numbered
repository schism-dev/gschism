 3485: // __device__ void vertLinearInterp(double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 3486: // //     Routine to do vertical linear interpolation in z
 3487: // //     Inputs:
 3488: // //
 3489: // //       k1,k2: lower and upper limits for za, s_in 
 3490: // //       zt: desired interpolation level
 3491: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 3492: // //       s_in[0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 3493: // //     Outputs:
