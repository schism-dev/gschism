 4306: 
 4307: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4308:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4309:                                     double *wind_rotate_angle,   
 4310:                                     int *isdel, int *isidenode, int *isbnd,
 4311:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4312:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4313:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4314:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4315:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4316:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4317:                                     double *drag, double *roughness) {
 4318: 
 4319: 
 4320:    SIDE(pside);
 4321:    Side &side(*pside);
 4322:    const int i = idx_side;
 4323:    const int iglobal = globalSideIndices[i];
 4324:    side.idx = iglobal;  
 4325:    
 4326:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4327:    const double fc   = 2.0*omega_e*sin(sfea0);
 4328:    const double beta = 2.0*omega_e*cos(sfea0);
 4329: 
 4330:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4331: 
 4332:    // finding the pointer to the nodes that form the side
 4333:    const int idx_n1 = isidenode[iglobal*2];
 4334:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4335: 
 4336: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4337: 
 4338:    const int locidx_n1 = localNodeIndices[idx_n1];
 4339:    const int locidx_n2 = localNodeIndices[idx_n2];
 4340:    const int part_n1 =   localNodePart[idx_n1];
 4341:    const int part_n2 =   localNodePart[idx_n2];
 4342: 
 4343: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4344: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4345: 
 4346:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4347:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4348: 
 4349: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4350: 
 4351:    // Counts the number of sides connected to each node
 4352:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4353:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4354: 
 4355:    // Side boundary type
 4356:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4357:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4358: // if (i == 0) printf("populateSides: 2\n");
 4359: 
 4360:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4361:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4362:    {
 4363:       bool isLand = false;
 4364:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4365:       
 4366:       if (isbs > -1) {
 4367:          // assert(isLand || isbs>=0);
 4368:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4369: 
 4370:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4371: 
 4372:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4373:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4374: 
 4375:          assert (isLand == side.sideBnd->segment->isLand);
 4376:          
 4377:          side.sideBnd->side = &side;
 4378: 
 4379:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4380:          n1bnd->linkSideBoundary(side.sideBnd);
 4381:          n2bnd->linkSideBoundary(side.sideBnd);
 4382: 
 4383:       }
 4384:       else {
 4385:          side.sideBnd = nullptr;
 4386:       }
 4387:    }
 4388:    else 
 4389:    {
 4390:       side.sideBnd = nullptr;
 4391:    }
 4392: 
 4393: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4394: 
 4395:    // finding the pointer to the elements that share the side
 4396:    const int idx_e1 = isdel[iglobal*2];
 4397:    const int idx_e2 = isdel[iglobal*2 + 1];
 4398: 
 4399:    if (idx_e1 > -1) {
 4400:       const int locidx_e1 = localElemIndices[idx_e1];
 4401:       const int part_e1 =  localElemPart[idx_e1];
 4402:       side.elems[0] = elems[part_e1] + locidx_e1;
 4403: 
 4404:    }
 4405:    else {
 4406:       side.elems[0] = nullptr;
 4407:    }
 4408: 
 4409: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4410: 
 4411:    if (idx_e2 > -1) {
 4412:       const int locidx_e2 = localElemIndices[idx_e2];
 4413:       const int part_e2 =  localElemPart[idx_e2];
 4414:       side.elems[1] = elems[part_e2] + locidx_e2;
 4415:    }
 4416:    else {
 4417:       side.elems[1] = nullptr;
 4418:    }
 4419: 
 4420: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4421: 
 4422:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4423:       
 4424:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4425:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4426:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4427:          
 4428:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4429:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4430:       // printf("sideBnd: %p\n", side.sideBnd);
 4431:       // assert(false && "Side has no elements and no boundary");
 4432:    }
 4433:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4434: 
 4435:    // Compute the center of the side
 4436:    side.center = 0.5*(side.n1->p + side.n2->p);
 4437: 
 4438:    #ifdef USE_FRAMES
 4439:    side.setFrame();
 4440:    #endif
 4441: 
 4442: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4443: 
 4444:    // Normal, unitary vector to the side
 4445:    if constexpr(ics == 1) {
 4446:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4447:       side.n = normalize(side.n);
 4448:    }
 4449:    else {
 4450:       // Unit side vector in 3D cartesian coordinates
 4451:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4452: 
 4453:       nSide = normalize(nSide);
 4454: 
 4455:       // Its cross product with the unit local z-axis vector (nUp) is the
 4456:       // normal vector we are looking for.
 4457:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4458: 
 4459:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4460:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4461:       side.n = -normalize(n2D); 
 4462: 
 4463:    }
 4464: 
 4465: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4466: 
 4467:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4468:    side.shapiro = shapiro0;
 4469: 
 4470:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4471:    // XXXX
 4472:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4473:    constexpr double rot_per=3000.0;
 4474:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4475:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4476:    // XXXXX      
 4477:    #endif
 4478:    // Compute the z level at the center of the side
 4479:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4480:    
 4481:    // Compute the length of the side
 4482:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4483: 
 4484: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4485: 
 4486:    // Compute the Coriolis coefficient
 4487: 
 4488:    if constexpr(ncor == -1 || ncor == 0) {
 4489:       side.coriolis = coricoef;
 4490:    }
 4491:    else {
 4492:       const double sphi = side.lat();  // Latitude at the center of the side
 4493: 
 4494:       assert(use_ll && "use_ll must be true when ncor > 0");
 4495: 
 4496:       if constexpr(ics == 1) {
 4497:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4498:       }
 4499:       else { // ics == 2
 4500:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4501:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4502:       }
 4503: 
 4504:    }
 4505: 
 4506: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4507: 
 4508: }
 4509: 
 4510: 
 4511: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4512:    double *node_coords, double *node_coords_ll, bool use_ll,
 4513:    double *wind_rotate_angle,   
 4514:    int *isdel, int *isidenode, int *isbnd,
 4515:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4516:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4517:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4518:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4519:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4520:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4521:    double *drag, double *roughness) {
 4522: 
 4523:    ELEM(pelem);
 4524:    Element &elem(*pelem);
 4525:    const int i = idx_elem;
 4526: 
 4527:    elem.idx = i;
 4528: 
 4529:    for (int j = 0; j < i34[i]; j++) {
 4530:       const int idxNode = elnode[i*4 + j];  
 4531:       const int idxSide = elside[i*4 + j];
 4532:       
 4533:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4534:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4535: 
 4536:       // Find the neighboring element  
 4537:       if (elem.sides[j]->elems[0] == &elem) {
 4538:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4539:       }
 4540:       else {
 4541:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4542:       }
 4543:       
 4544:    }
 4545: 
 4546:    elem.i34 = i34[i];
 4547: 
 4548:    // Compute the barycenter of the element and its depth
 4549:    elem.center = {0.0, 0.0};
 4550:    elem.depth = 1e10;
 4551:    for (int j = 0; j < i34[i]; j++) {
 4552: 
 4553:       elem.center += elem.nodes[j]->p/i34[i];
 4554:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4555:    }
 4556: 
 4557:    #ifdef USE_FRAMES
 4558:    elem.setFrame();
 4559:    #endif
 4560: 
 4561:    elem.area = elem.computeSignedArea(); 
 4562:    elem.radius = sqrt(elem.area)/pi; 
 4563:    
 4564:    // Determines which way the normal vector to each side is oriented.
 4565:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4566:    for (int j = 0; j < i34[i]; j++)  
 4567:    {
 4568:       if (elem.sides[j]->elems[0] == &elem) {
 4569:          elem.ssign[j] =  1.0;
 4570:       }
 4571:       else {
 4572:          elem.ssign[j] = -1.0;
 4573:       }
 4574: 
 4575:    }
 4576: 
 4577:   
 4578: 
 4579:    // Derivatives of shape functions
 4580:    //  For ics=2, this is done in the element frame
 4581:    //  For quads, the derivative is evaluated at centroid
 4582:    for (int j = 0; j < elem.i34; j++) {
 4583:       const double area = elem.area;
 4584:       const int id2 = elem.nxq(1 + j);
 4585:       const int id3 = elem.nxq(2 + j);
 4586:       const int id4 = elem.nxq(3 + j);
 4587:       if (elem.isTri()) {
 4588:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4589:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4590:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4591:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4592:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4593:          // And so on for the other shape functions.
 4594: 
 4595:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4596:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4597:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4598: 
 4599:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4600:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4601: 
 4602:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4603: 
 4604:       }
 4605:       else  { // Quad, the derivatives are evaluated at the centroid
 4606: 
 4607:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4608:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4609:          // ...
 4610:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4611: 
 4612:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4613:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4614:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4615: 
 4616:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4617:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4618: 
 4619:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4620: 
 4621:       } // if Tri/Quad
 4622: 
 4623:    } // for j   
 4624:    
 4625:    
 4626: 
 4627: }
 4628: 
 4629: 
 4630: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4631:                                             double *emo, double *efa, 
 4632:                                             double *umo, double *ufa, 
 4633:                                             double *vmo, double *vfa,
 4634:                                             int *ifltype, int *iettype, double *qthcon) {
 4635: 
 4636:    NODE_BND(nodeBnd);
 4637:    const int idx = idx_node_bnd;    
 4638: 
 4639:    nodeBnd->idx = idx;
 4640: 
 4641:    // Need to find the segment index and the index of the node on the segment
 4642:    int idxNode = -1;
 4643:    int iseg, i;
 4644:    for (iseg = 0; iseg < nope; iseg++) {
 4645:       // for each segment...
 4646:       for (i = 0; i < nond[iseg]; i++) {
 4647:          idxNode = iond[iseg + i*nope];
 4648:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4649:          
 4650:       }
 4651:    }
 4652: 
 4653:    assert(iseg < nope && "iseg is out of bounds");
 4654: 
 4655: found: // Jumped here when the node was found
 4656: 
 4657:    nodeBnd->isEssentialBC = true;
 4658:    nodeBnd->elbc = 0.0;
 4659: 
 4660:    nodeBnd->segment->ifltype = ifltype[iseg];
 4661:    nodeBnd->segment->iettype = iettype[iseg];
 4662:    nodeBnd->segment->qthcon  = qthcon[iseg];
 4663: 
 4664:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4665: 
 4666:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4667: 
 4668:       nodeBnd->efa[jfr] = efa[idx2];
 4669:       nodeBnd->emo[jfr] = emo[idx2];
 4670:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4671:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4672: 
 4673:    }
 4674:         
 4675: 
 4676: }
 4677: 
 4678: __device__ void Mesh::populateBoundarySideLinks(void) {
 4679: 
 4680:    SIDE_BND(sideBnd);
 4681: 
 4682:    const Side *side = sideBnd->side;
 4683: 
 4684:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4685:    // and the rightSide is the side s that has s->n1 == side->n2
 4686:    for (int i = 0; i < mesh->nbs; i++) {
 4687: 
 4688:       Side *s = &mesh->localSideData[i];
 4689: 
 4690:       if (s == side) continue;  // Do not link the side to itself
 4691:    
 4692:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4693:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4694:    }
 4695:    
 4696: }
 4697: 
 4698: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4699:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4700:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4701:                 int *isdel, int *isidenode, int *isbnd,
 4702:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4703:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4704:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4705:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4706:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4707:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4708:                 double *drag, double *roughness,
 4709:                 double *emo, double *efa, 
 4710:                 double *umo, double *ufa, 
 4711:                 double *vmo, double *vfa) {
 4712: 
 4713:    printf("Populating mesh for partition %d\n", partNum);
 4714: 
 4715:    // XXXXXX THIS function does almost nothing. 
 4716: 
 4717:    nbs = *sharedIdxSideBoundary + 1;
 4718:    nbp = *sharedIdxNodeBoundary + 1;
 4719: 
 4720:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4721: 
 4722: }
