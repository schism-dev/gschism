 1390: 
 1391:    int ifltype;  // Type of flow boundary condition
 1392:    
 1393:    // Elevation boundary condition
 1394:    int iettype;  // Type of elevation boundary condition
 1395:    double eth;   // Elevation time history
 1396: 
 1397:    // Flow boundary condition
 1398:    double qthcon;  // Flow time history constant
 1399:    double vobc1;   // Velocity coefficient 1
 1400:    double vobc2;   // Velocity coefficient 2
 1401: 
 1402:    // Tracer boundary conditions
 1403:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1404:    // int  itrtype[natrm];    // Tracer boundary condition type
 1405: 
 1406:    BoundarySegment(bool _isLand) {
 1407:       isLand = _isLand;
 1408:       clen = 0.0;
 1409:       carea = 0.0;
 1410:       ifltype = 0;
 1411:       iettype = 0;
 1412:       eth = 0.0;
 1413:    }
 1414: 
 1415:    BoundarySegment(void) {
 1416:       isLand = false;
 1417:       clen = 0.0; 
 1418:       carea = 0.0;
 1419:       ifltype = 0;
