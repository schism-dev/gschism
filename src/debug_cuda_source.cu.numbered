  401: 
  402: 
  403: struct Frame {
  404:    double _t[9]; // t stands for tensor.
  405: 
  406:    // Access the tensor in Fortran order
  407:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  408: 
  409:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  410: 
  411:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  412: 
  413:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  414:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  415:       sincos(ar2, &sin_ar2, &cos_ar2);
  416: 
  417:       t(0,0) = -sin_ar1;
  418:       t(1,0) =  cos_ar1;
  419:       t(2,0) =  0.0;
  420:       t(0,1) = -cos_ar1*sin_ar2;
  421:       t(1,1) = -sin_ar1*sin_ar2;
  422: 
  423:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  424: 
  425:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  426:       assert (ar4!=0.0 && "GRID: ar4=0");
  427: 
  428:       const double ar4_inv = 1.0/ar4;
  429:       t(0,1) = t(0,1)*ar4_inv;
  430:       t(1,1) = t(1,1)*ar4_inv;
  431:       t(2,1) = t(2,1)*ar4_inv;
  432: 
  433:       // The third vector is the cross product of the first two
  434:       crossProduct(t(0,0), t(1,0), t(2,0), 
  435:                    t(0,1), t(1,1), t(2,1), 
  436:                    t(0,2), t(1,2), t(2,2));
  437:    }
  438: 
  439: 
  440:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  441:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  442:    // Inputs:
  443:    //        vec0: vel. in this frame;
  444:    //        frameout: Output frame;
  445:    // Output: 
  446:    //        vec1: vel. in new frame  
  447: 
  448:       auto const fo = frameout;
  449:       Vector2 vec1;
  450: 
  451:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  452:       // of t and fo.t are the same.
  453:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  454:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  455: 
  456:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  457:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  458: 
  459:       return vec1;
  460:    }
  461: 
  462:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  463:       // Transform a vector from global to local frame
  464:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  465:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  466:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  467:    }
  468: 
  469:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  470:       // Transform a vector from local to global frame
  471:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  472:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  473:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  474:    }   
  475: 
  476:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  477:    // Tranforms a point from global to local frame     
  478:       G2L(pi - origin0, po);
  479:    }
  480: 
  481:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  482:    // Transforms a point from local to global frame      
  483:       L2G(pi, po);
  484:       po = po + origin0;
  485:    }
  486: 
  487: };
