 1416: struct Node {
 1417: 
 1418:    // Geometry information
 1419:    int idx;            // Global index of the node
 1420:    int16_t part;       // Partition of the node
 1421: 
 1422:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1423:    int16_t numNodes;   // Number of nodes neighbors of this node
 1424: 
 1425:    Element **elements; // Array of pointers to the elements that share this node
 1426:    int16_t numElements;// Number of elements that share this node
 1427: 
 1428:    int16_t numSides;   // Number of sides that are connected to this node
 1429: 
 1430: 
 1431:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1432:    double gz;          // Global vertical coordinate at the node.
 1433:    Vector2 u2[nvrt];
 1434:    double  w2[nvrt];
 1435:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1436:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1437:    double lon, lat;
 1438:    double depth;
 1439: 
 1440:    Frame<ics> frame;
 1441: 
 1442:    LocalSigma<ivcor> localSigma;  
 1443: 
 1444:    int16_t kb;     // Bottom index of the node
 1445: 
 1446:    bool isDry;     // True if the node is dry
 1447: 
 1448:    int16_t iadv;   // Advection flag
 1449: 
 1450:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1451:                           // this is nullptr
 1452: 
 1453:    TempVar tmp; // Temporary variable to store different types of variables
 1454: 
 1455:    // Physical information
 1456:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1457:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1458: 
 1459:    double rho[nvrt];     // Density
 1460:    double dfv[nvrt];     // Vertical viscosity
 1461: 
 1462:    double eta1; // Elevation at nodes at previous timestep
 1463:    double eta2; // Elevation at nodes at current timestep
 1464: 
 1465:    double ETP;  // Earth Tidal Potential
 1466: 
 1467:    double pr;    // Air pressure
 1468:    double grav2; // Gravity 
 1469:    
 1470:    Vector2 dav;  // Depth averaged velocity
 1471: 
 1472:    Vector2 tau; // Wind stress vector
 1473: 
 1474:    // Vegetation parameters
 1475:    double veg_h;
 1476:    double veg_nv;
 1477:    double veg_di;
 1478:    double veg_Cd;
 1479:    double veg_h_unbent;
 1480:    double veg_di_unbent;
 1481:    double veg_nv_unbent;
 1482:    double veg_alpha_vert_mean;
 1483:    double veg_alpha0;
 1484:    double veg_alpha3D[nvrt];
 1485: 
 1486:    // Bottom drag parameters
 1487:    double Cd;       // Bottom drag coefficient   
 1488: 
 1489:    // These three are mutually exclusive
 1490:    union {
 1491:       double rmanning; // Bottom Manning's coefficient
 1492:       double rough;    // Bottom roughness length
 1493:       double drag;     // Bottom drag coefficient
 1494:    };
 1495:    Vector2 tau_bot; // Bottom stress vector
 1496: 
 1497:    // XXXX REMOVE FOR IMM>0???
 1498:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1499:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1500: 
 1501:    
 1502:    double qel; // RHS
 1503:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1504:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1505:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1506:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1507: 
 1508:    double mX; // Solution of the FEM system
 1509: 
 1510:    // Meteorological forcing
 1511:    Vector2 u_air;
 1512:    double p_air;  // XXXX is this the same as pr?
 1513:    double t_air;
 1514:    double q_air;
 1515:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1516: 
 1517: 
 1518: 
 1519: 
 1520:    __device__ void setWind(Vector2 &u) {
 1521:    // Sets the wind vector taking into account the mesh angle
 1522:    
 1523:       const double speed = length(u);
 1524: 
 1525:       // Rotate wind vector to the node frame
 1526:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1527: 
 1528:       // Sets the surface stress vector due to wind.
 1529:       if constexpr(nws == 0) {
 1530:          tau = {0.0, 0.0};
 1531: 
 1532:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1533:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1534: 
 1535:       } else {
 1536: 
 1537:          double dragcoef;
 1538: 
 1539:          if constexpr(iwind_form == -1) {
 1540:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1541:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1542: 
 1543:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1544:             tau = cff*u_air;
 1545:  
 1546:          } else if constexpr(iwind_form == 1) {
 1547:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1548:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1549: 
 1550:             dragcoef = max(dragcoef, 4.0e-4);
 1551:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1552:             tau = cff*u_air;
 1553: 
 1554:          } else {
 1555:             tau = {0.0, 0.0};
 1556:          }
 1557:       }
 1558:    }
 1559: 
 1560: 
 1561:    __device__ void setFrame(double lat, double lon) {
 1562:       if constexpr(ics == 1) return;
 1563: 
 1564:       frame.update(lat, lon);        
 1565:     }
 1566: 
 1567:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1568: 
 1569:    __device__ double sigmaTransitionDepth(void) const;
 1570: 
 1571:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1572: 
 1573:    __inline__ __device__ Point2 outputCoords(void) const {
 1574:       if constexpr(ics == 1)  return p;
 1575:       else                    return {rad2deg*lon, rad2deg*lat};
 1576:    }
 1577: 
 1578:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1579:    // If ics == 2, convert the global point to the local frame
 1580:       
 1581:       if constexpr (ics == 1) {
 1582:          return p;
 1583:       } else {
 1584:          const Point3 c = {p.x, p.y, gz};
 1585:          const Point3 local = frame.G2L(p - c);
 1586:          return local;
 1587:       }
 1588:    }
 1589: 
 1590:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1591:    // If ics == 2, convert the global point to the local frame
 1592:       
 1593:       if constexpr (ics == 1) {
 1594:          return p;
 1595:       } else {
 1596:          const Point3 c = {p.x, p.y, gz};
 1597:          return c + frame.L2G(p);
 1598:       }
 1599:    }
 1600: 
 1601:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1602:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1603:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1604:    
 1605:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1606: 
 1607:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1608: 
 1609:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1610:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1611: 
 1612:    __device__ __forceinline__ void clearMatrixRow(void) {
 1613:       // Clear the matrix row for this node
 1614: 
 1615:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1616: 
 1617:    }
 1618: 
 1619:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1620:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1621:       
 1622:       if (node == this) {
 1623:          *coeffDiag += value;
 1624:          return;
 1625:       }
 1626: 
 1627:       int i;
 1628:       for (i = 0; i < numNodes; i++) {
 1629:          if (nodes[i] == node) break;
 1630:       }
 1631: 
 1632:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1633:       coeffRow[csrSlot[i]] += value;
 1634:    }
 1635: 
 1636: 
 1637:    __device__ __inline__ void updateZCoordData(void);
 1638: 
 1639:    __device__ __forceinline__ double compZCoord(int k) const;
 1640: 
 1641:    __device__ void updateKb(void);
 1642: 
 1643:    __device__ __forceinline__ void computeBottomDragCd(void);
 1644: 
 1645: 
 1646: 
 1647: };
