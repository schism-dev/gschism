 1504:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1505:                            if (idx_node_bnd >= mesh->nbp) return;
 1506: 
 1507: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1508:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1509:                            if (idx_side_bnd >= mesh->nbs) return;                           
 1510: 
