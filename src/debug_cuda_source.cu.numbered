 8629: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8630:    // Get the value of a variable from an side
 8631:    // varName is the name of the variable to get
 8632:    // var is the array to store the value
 8633:    // k is the vertical level index of the variable to get
 8634:    SIDE_BND(sideBnd);   
 8635: 
 8636:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8637:    if (sideBnd->segment->isLand) idx = -7;
 8638: 
 8639:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8640:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8641: 
 8642: }
