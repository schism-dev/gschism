 1396: // Helper functions for computing the local node index at a given offset from another.
 1397: __device__ __inline__ int nxq(int offset, int index, int size) {
 1398:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1399:    // to the index to make it positive
 1400:    assert(index + offset + 16*size >= 0);
 1401:    return (index + offset + 16*size) % size;  
 1402: }
 1403: 
 1404: __device__ __inline__ int nxq(int index, int size) {
 1405:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1406:    // to the index to make it positive
 1407:    assert(index + 16*size >= 0);
 1408:    return (index + 16*size) % size; 
 1409: }
