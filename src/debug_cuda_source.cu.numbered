  502:    Vector2 gradPhi[4];        // Derivatives of shape functions
  503:    Vector2 gradEta;           // Gradient of free surface elevation
  504:    Vector2 gradPr;            // Gradient of pressure    
  505:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
